'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_전체
' 02. 화면설명 : 고객자산평가_상품별잔고_전체
' 03. 작    성 : 2016. 02. 03. 유창재
' 04. 수    정 : 2018. 07. 23. 신미정 v001
'		        2022.05.24 아이티젠 김성수 v002
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
'Dim g_szGroup		'Input Array
'
'g_szGroup = {"ACNO", "ACNT_PRNM", "ABRV_ISNM", "HLDN_ISSU_RMND_QTY", "BYNG_AMT", "VLTN_AMT", "LOAN_BAL", "VLTN_PRLS_AMT",
'			"ERT","MKSC_CLS_NAME", "LOAN_DATE", "MTRT_DATE"}
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_028r", "InBlock1", "ACNO" , 0 , g_szList(Int(g_nAllCount)) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_028r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_028r" )

	end if

	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	grd0.SetClear()
	
	if sEventName == "mbact71050_p2" then			'전체
	
		g_szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_nAcntCount = g_szList(0)		'계좌개수
	
	g_nAllCount = 4 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
	
	if g_szList(1) == "Y" then
		grd0.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_028r", "InBlock1", "ACNO" , 0 , g_szList(3) )		'계좌번호
	'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_028r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_028r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_028r" )
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, szTemp12,
		S_temp, S_temp1, TempCount 
		
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_028r" then
		rowcnt = DATAMANAGER.GetDataCount( 0 , "obacb_balc_028r", "OutBlock2") -1
		
		for i = 0 to rowcnt
			grd0.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "ACNO" , i) 	
					& DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "ASNO" , i)	'계좌번호
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "HLDN_ISSU_RMND_QTY" , i)	'체결잔고
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "BYNG_AMT" , i)	'매수금액
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "LOAN_BAL" , i)	'대출금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "ERT" , i)	'수익률
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "MKSC_CLS_NAME" , i)	'잔고구분명
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "LOAN_DATE" , i)	'대출일자
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "MTRT_DATE" , i)	'만기일자
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "ACNT_PRNM" , i))
			szTemp11 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_028r", "OutBlock2", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			
'			szTemp11 = S_temp(1)
'			if UBOUND(S_temp) < 2 then
'				S_temp1 = Split(S_temp(1), ")")
'				szTemp11 = S_temp1(0)
'			end if

			szTemp12 = left(Trim(szTemp8),6)	'유가증권 구분명
			
			dim tTemp'v002
			tTemp = Split(Trim(szTemp8),"소수점")'v002
			
			'Form.ShowAlert( "알림","알림")
			'Form.ShowAlert( "알림",  T_mksc_cls_code)
			
			'16-04-02 외화,해외일때만 소수점 2째자리로 표기
			if Trim(szTemp8) == "외화" or Trim(szTemp8) == "해외" then
'				grd0.SetCellData("bd_cell2", g_nNextCount , CDbl(szTemp2))
				grd0.SetCellData("bd_cell2", g_nNextCount , FormatNumber(szTemp2,2))'v002
			'v001 천원미만 채권 소숫점표기	
			elseif Trim(szTemp12) == "채권" then
'				grd0.SetCellData("bd_cell2", g_nNextCount , CDbl(szTemp2))
				grd0.SetCellData("bd_cell2", g_nNextCount , FormatNumber(szTemp2,5))'v002
			'v002 해외 소수점 종목일때 6자리 표기
			elseif #tTemp >= 2 then 
				grd0.SetCellData("bd_cell2", g_nNextCount , FormatNumber(szTemp2,6))'v002
			else
'				grd0.SetCellData("bd_cell2", g_nNextCount , CInt(szTemp2))
				grd0.SetCellData("bd_cell2", g_nNextCount , FormatNumber(szTemp2,0))'v002
			end if
			
			grd0.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			grd0.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			
			grd0.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			grd0.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			grd0.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			grd0.SetCellData("bd_cell6", g_nNextCount , szTemp6)
			grd0.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			grd0.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			grd0.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			grd0.SetCellData("bd_cell10", g_nNextCount , szTemp10)
			grd0.SetCellData("bd_cell11", g_nNextCount , szTemp11)
			
			g_nNextCount = g_nNextCount + 1
		next
		
		grd0.rowcount = g_nNextCount
		
		if  DATAMANAGER.IsMoreNextData( "obacb_balc_028r" ) == true then 
			DATAMANAGER.RequestNextData( "obacb_balc_028r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			end if
		end if
	end if
	
End Sub

'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obacb_balc_028r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	grd0.SetClear()
	g_nNextCount = 0
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
End Sub


	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacb_balc_028r" trcode="obacb_balc_028r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="UI_UNIT_CLS" idx="0" defconst="1" />
					<FIELD name="WRAP_ACNT_YN" idx="1" defconst="N" />
					<FIELD name="IQRY_CNT" idx="6" defconst="00000030" />
					<FIELD name="IQRY_CLS_CODE" idx="7" defconst="1" />
				</TRBLOCK>
			</TRAN>
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obacb_balc_028r" title="종합계좌 개별상품 보유 잔고평" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="338" _ulen="264" >

UI_UNIT_CLS^UI 단위 구분^1^0^0^0^0^0^0
WRAP_ACNT_YN^WRAP 계좌 여부^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌 비밀번호^68^0^0^0^0^0^0
STND_DATE^기준 일자^8^0^0^0^0^0^0
IQRY_CNT^조회 수^8^0^7^0^0^0^0
IQRY_CLS_CODE^조회 구분 코드^1^0^0^0^0^0^0

				</TRBLOCK>
