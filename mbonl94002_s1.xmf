	<SCRIPT_INFO _len="5860" _ulen="5568" >
'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 
' 04. 수    정 : 
'
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bSilence
g_bSilence = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_ChangeBtnState() : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Function f_ChangeBtnState()
	if tonumber(rdoIdentiAgree.currentindex) == 0 and tonumber(rdoInfoAgree.currentindex) == 0 then
		g_bSilence = false
		chkAllAgree.checkstate = "1"
	else
		chkAllAgree.checkstate = "0"
	end if
	
	' 210622 JHY : 요약/ 상세 둘 중 하나만 선택해도 다음으로 넘어갈 수 있도록 수정 (권오상 차장님 요청)
	if tonumber(chkAllAgree.checkstate) == 1 and ( tonumber(chkSummary.checkstate) == 1 or tonumber(chkDetail.checkstate) == 1 ) then
		Form.SetSharedData( "mbonl94002_s1_CHECK_SUMMARY" , chkSummary.checkstate)
		Form.SetSharedData( "mbonl94002_s1_CHECK_DETAIL" , chkDetail.checkstate)
		
		Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", true)
		
	else
		Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
	end if
End Function


''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgProcess.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	lblRedCheck.fgcolor = 265
	
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

'	if szTheme == "white" then
'		imgProcess.imgpath = "icon_1stepthird_w"
'	else
'		imgProcess.imgpath = "icon_1stepthird_b"
'	end if
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "PREV_STEP" then
		Dim szChkStaSummary, szChkStaDetail
		
		szChkStaSummary = Form.GetSharedData( "mbonl94002_s1_CHECK_SUMMARY", false)
		szChkStaDetail = Form.GetSharedData( "mbonl94002_s1_CHECK_DETAIL", false)
		
		chkSummary.checkstate = szChkStaSummary == "1" and 1 or 0
		chkDetail.checkstate = szChkStaDetail == "1" and 1 or 0
		
		chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "close_mbonl94002_p4" then
		if sRet == "0" or sRet == "1" then
			chkSummary.checkstate = sRet
		end if
		
		f_ChangeBtnState()
	
	elseif sKeyName == "close_mbonl94002_p5" then
		if sRet == "0" or sRet == "1" then
			chkDetail.checkstate = sRet
		end if
		f_ChangeBtnState()
	end if
End Sub

'============================================================================
' chkAllAgree_OnChange(sCheckState) : 체크시 하단 동의 / 미동의로 모두 체크
'============================================================================
Sub chkAllAgree_OnChange(sCheckState)
	if g_bSilence == false then
		if tonumber(sCheckState) == 0 then
			rdoIdentiAgree.currentindex = "1"
			rdoInfoAgree.currentindex = "1"
			
		else
			rdoIdentiAgree.currentindex = "0"
			rdoInfoAgree.currentindex = "0"
		end if
		
		f_ChangeBtnState() 
	
	else
		g_bSilence = true
	end if
End Sub

'============================================================================
' rdoIdentiAgree_OnClick(nIndex) : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Sub rdoIdentiAgree_OnClick(nIndex)
	f_ChangeBtnState()
End Sub

'============================================================================
' rdoInfoAgree_OnClick(nIndex) : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Sub rdoInfoAgree_OnClick(nIndex)
	f_ChangeBtnState()
End Sub

'============================================================================
' btnDetail_OnClick(): 요약동의서 오픈
'============================================================================
Sub btnSummary_OnClick()
	Form.OpenFramePopup("mbonl94002_p4" , "" , "")
End Sub


'============================================================================
' btnDetail_OnClick(): 상세동의서 오픈
'============================================================================
Sub btnDetail_OnClick()
	Form.OpenFramePopup("mbonl94002_p5" , "" , "")
End Sub

''****************************************************************************
''               		D A T A				M A N A G E R               
''****************************************************************************

	</SCRIPT_INFO>
