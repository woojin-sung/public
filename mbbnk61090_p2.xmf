	<SCRIPT_INFO _len="6378" _ulen="5852" >
'============================================================================
' 작성 : 2021.08.25. 장원혁 v000
'		2021.11.04. 김수진 v001 : 동일인 계좌간 대체출금 개선건 적용  : 외화당사대체 출금은 동인인 계좌에 한해서만 출금 가능
'							 : 상대 계좌 당사 동일명의 계좌일 경우 : 금융사기문진, 보안매체, 전자서명 생략 및 간편이체한도 미적용 
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_WithdrawAcntNo   '출금계좌번호
Dim g_WithdrawAcntName '출금계좌명
Dim g_RcvnAcntNo       '입금계좌번호
Dim g_RcvnAcntName     '입금계좌명
Dim g_Crcd             '통화코드
Dim g_CrcdName         '통화명
Dim g_TrAmt            '금액
Dim g_Pswd             '비밀번호

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

    Form.SetScreenName("외화대체예정내역 확인")
	
    szData = Form.GetOpenLinkData()

    Dim szList
	
    szList = Split(szData, "★")
	
    if UBOUND(szList) < 1 then
        exit sub
    end if
    
    g_WithdrawAcntNo   = szList(0) '출금계좌번호
    g_WithdrawAcntName = szList(1) '출금계좌명
    g_RcvnAcntNo       = szList(2) '입금계좌번호
    g_RcvnAcntName     = szList(3) '입금상품명
    g_Crcd             = szList(4) '통화코드
    g_CrcdName         = szList(5) '통화명
    g_TrAmt            = szList(6) '금액
    g_Pswd             = szList(7) '비밀번호
	
    Table0.SetCellString(0 , 1 , g_WithdrawAcntNo  ) '출금계좌번호
    Table0.SetCellString(1 , 1 , g_WithdrawAcntName) '출금계좌명
    Table1.SetCellString(1 , 1 , g_RcvnAcntNo) '입금계좌번호
    Table1.SetCellString(2 , 1 , g_RcvnAcntName) '입금계좌명
    Table1.SetCellString(3 , 1 , g_Crcd & " " & g_CrcdName) '통화코드 & 통화명
    Table1.SetCellString(4 , 1 , g_TrAmt) '금액
    
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	If sKeyName == "Close" Then
	
		If sRet == "71040" Then
			Form.OpenScreen("71040", "")
		ElseIf sRet == "61010" then
			Form.OpenScreen("61010", "1")
		Else
			Form.SendReturnToParent( "Clear" , sRet)
			Form.CloseForm()
		End If

	End If
	
End Sub

'============================================================================
Sub btnOK_OnClick()
	DATAMANAGER.RequestTranData("obrtd_fcur_004a")	
End Sub

'============================================================================
Sub btnCancel_OnClick()
    Form.CloseForm()
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' v001 : TR_Inquiry() 함수 OnSendTranBefore로 이동
	If szTranID == "obrtd_fcur_004a" Then '외화대체처리
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVCD"        , 0 , "201"                    )    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"        , 0 , Left(g_WithdrawAcntNo,8) )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"        , 0 , Right(g_WithdrawAcntNo,2))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PWD"    , 0 , g_Pswd                   )	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_ACNO"   , 0 , Left(g_RcvnAcntNo,8)     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_ASNO"   , 0 , Right(g_RcvnAcntNo,2)    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CRCD"        , 0 , g_Crcd                   )        
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FRCR_TR_AMT" , 0 , g_TrAmt                  )
    End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obrtd_fcur_004a" then	'외화대체처리
		Form.OpenPopup("mbbnk61090_p4" , "" , "")
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 에러
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	Dim szSubErr
	If szTranID == "obrtd_fcur_004a" Then	'외화대체처리
	
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		If szSubErr = "" Then
		    Form.MsgBox( "알림", szErrMsg                      , "", 0 )
		Else
		    Form.MsgBox( "알림", szErrMsg.." ("..szSubErr..")" , "", 0 )
		End If
		Form.SendReturnToParent( "Clear" , sData)
		Form.CloseForm()	
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnRequestTranTimeout(szTranID) : TR TimeOut 발생시 함수
'============================================================================
Sub DATAMANAGER_OnRequestTranTimeout(szTranID)	
	if szTranID == "obrtd_fcur_004a" then
		Form.ShowAlert( "알림", "외화대체결과를 확인하시기 바랍니다.")
		Form.SendReturnToParent( "Clear" , sRet)
		Form.CloseForm()
	end if
	
End Sub



