'20220425 HWG END

Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName
	
	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'20190207 LES START - 최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 
		
		end if
		

		For i = 0 to szLen
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			
			if szMk <> "T" then
				Form.setItemCode(tList(i))
				exit Function
			end if
		Next

		'20190207 LES END
	else
		Form.setItemCode("008560")
	end if
End Function
'============================================================================
'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
'============================================================================
' Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			if g_szRtnO == "1" then	' 20160316
				g_szRtnO = ""
				
				if g_szChangeInit == "1" then
					edtOrgNo.caption = ""
				end if
			else
				edtOrgNo.caption = ""
			end if
			
			edtModTab.caption = ""
			edtCnlTab.caption = ""
			lblPrc.caption = ""
			
			'20180906 LES START KOTC상품추가
			szMk = Form.GetItemCodeInfo(sReturn1, "market")
			if szMk = "T" then
			else
				Check_ELW(sReturn1)									' ELW종목 여부
			
				nTab = fmTab.currenttab
				if nTab == 0 then
					szType = Form.GetSharedData("STOCK_BUYTYPE", false)
				elseif nTab == 1 then
					szType = Form.GetSharedData("STOCK_SELTYPE", false)
				elseif nTab == 2 then
					szType = Form.GetSharedData("STOCK_MODTYPE", false)
				elseif nTab == 3 then
					szType = Form.GetSharedData("STOCK_CNLTYPE", false)
				end if	
				
				if Trim(szType) == "" or szType == null then
					szType = "0"
				end if
		
				if sReturn1 <> g_szCd then
					Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sReturn1)	' 폼탭화면에 종목코드 던지기
				end if
				
				Change_HOGA_Request(sReturn1, szType)
				
				Form.SetItemCode(sReturn1)
			end if
			'20180906 LES END
		end if
	end if
End Sub


