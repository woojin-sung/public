Dim g_szSlt2
g_szSlt = "HOGA1"
g_szSlt2 = "HOGA"

Dim g_szType
g_szType = ""

Dim g_szRtnO
g_szRtnO = ""


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		' 종목/탭 변경시 초기화
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	g_szBuyPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")		' 주식매수주문가격 자동입력
	g_szSelPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")		' 주식매도주문가격 자동입력
	g_szModPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC")		' 주식정정주문가격 자동입력
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			' 원주문번호 자동입력

	' 주식매수주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 주식매도주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 주식정정주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END	
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
End Function

'============================================================================
' Check_ELW
'============================================================================
Function Check_ELW(szCd)
	Dim szTab
	
	g_szMk = Form.GetItemCodeInfo(szCd, "market")
	szTab  = CStr(fmTab.currenttab)

	if szTab == "0" or szTab == "1" then
		' ELW경우
		if g_szMk == "W" then
			btnELWWarn.visible = true
			'rdoGbn.visible = false
			rdoGbn.currentindex = "0"
		else
			btnELWWarn.visible = false				
			'rdoGbn.visible = true
		end if
	else
		btnELWWarn.visible = false
		'rdoGbn.visible = false
	end if
End Function

'============================================================================
' Click_Hoga
'============================================================================
Function Click_Hoga(szClk)
	if Trim(szClk) <> "" and CInt(szClk) <> 0 then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_HOGA", szClk)
	end if
End Function

'============================================================================
' Change_HOGA_Request
'============================================================================
Function Change_HOGA_Request(szCd, szType)
	if szCd <> g_szCd then
		g_szCd = szCd
		
		Request_Hoga()
		return ""
	end if
	
	if szType == "13" then		' 시간외
		if g_szType <> szType then
			g_szType = szType
			
			Request_Hoga()
			return ""
		end if
	else
		if g_szType <> szType and g_szType == "13" then
			g_szType = szType
			
			Request_Hoga()
			return ""
		end if
	end if
	
	' 변경사항이 전혀 없을때
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "NO_RETURN", "")
End Function

'============================================================================
' Request_Hoga
'============================================================================
Function Request_Hoga()
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_incg") '20220215 HSZ : 시세속도 개선
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_aspr")
	DATAMANAGER.CancelRealData("ohhts_elw_aspr")
	DATAMANAGER.CancelRealData("ohhts_ovtp_cntg")
	DATAMANAGER.CancelRealData("ohhts_ovtp_aspr")
		
	if g_szType == "13" then
		DATAMANAGER.RequestTranData("ohhts_1181_001r")		' 시간외단일가(호가)
'		DATAMANAGER.RequestTranData("ohhts_1181_002r")		' 시간외단일가(시세)
'		DATAMANAGER.RequestTranData("ohhts_1182_002r")		' 시간외단일가(시간별)
	else
'		DATAMANAGER.RequestTranData("ohhts_1001_004r")		' 현재가(시간별)
		DATAMANAGER.RequestTranData("ohhts_1001_005r")		' 현재가(호가&예상체결)
'		DATAMANAGER.RequestTranData("ohhts_1001_001r")		' 현재가(시세&상세내역)
	end if
End Function

'============================================================================
' Return_Change_ItemCode : 다른화면에서 리턴된 종목코드 확인
'============================================================================
Function Return_Change_ItemCode(szCd)
	' 플랫폼에 종목코드변경 요청
	szCutCd = Mid(szCd, 2, Len(szCd))
	szMk = Form.GetItemCodeInfo(szCutCd, "market")
	
	'20180906 LES START KOTC상품추가
	if szMk == "T" then
		Exit Function
	end if
	'20180906 LES END
	
	' 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
	Select Case szMk
		Case "J", "T", "W"
			Form.SetItemCode(szCutCd)
		Case Else
			if Left(szCd, 1, 1) == "A" then
				Form.SetItemCode(szCutCd)
			else
				Form.SetItemCode(szCd)
			end if
	End Select
End Function

'============================================================================
' Return_AutoPrice : 가격 자동연동(화면실행 or 탭변경시)
'============================================================================
Function Return_AutoPrice()
	Dim szTab, szAuto
	
	if g_szChangeInit == "1" then		' 20160324 종목/탭 변경시 초기화 사용시는 가격자동연동 제외
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AUTO_PRICE", "")
		Exit Function
	end if
	
	szTab = CStr(fmTab.currenttab)

	if szTab <> "3" then
		'if szTab == "0" then
		'	szAuto = g_szBuyPrc
		if szTab == "0" then
			szAuto = g_szSelPrc
		elseif szTab == "1" then
			szAuto = g_szModPrc
		end if
	
		Select Case Trim(szAuto)
			Case "1"											' 매도10호가
				szPrc = contHoga.hogaTbl.GetCellString( 0, 0)
			Case "2"											' 매도9호가
				szPrc = contHoga.hogaTbl.GetCellString( 1, 0)
			Case "3"											' 매도8호가
				szPrc = contHoga.hogaTbl.GetCellString( 2, 0)
			Case "4"											' 매도7호가
				szPrc = contHoga.hogaTbl.GetCellString( 3, 0)
			Case "5"											' 매도6호가
				szPrc = contHoga.hogaTbl.GetCellString( 4, 0)
			Case "6"											' 매도5호가
				szPrc = contHoga.hogaTbl.GetCellString( 5, 0)
			Case "7"											' 매도4호가
				szPrc = contHoga.hogaTbl.GetCellString( 6, 0)
			Case "8"											' 매도3호가
				szPrc = contHoga.hogaTbl.GetCellString( 7, 0)
			Case "9"											' 매도2호가
				szPrc = contHoga.hogaTbl.GetCellString( 8, 0)
			Case "10"										' 매도1호가
				szPrc = contHoga.hogaTbl.GetCellString( 9, 0)
			Case "11"										' 현재가
				szPrc = lblHyun.caption					
			Case "12"										' 매수1호가
				szPrc = contHoga.hogaTbl.GetCellString(10, 0)
			Case "13"										' 매수2호가
				szPrc = contHoga.hogaTbl.GetCellString(11, 0)
			Case "14"										' 매수3호가
				szPrc = contHoga.hogaTbl.GetCellString(12, 0)
			Case "15"										' 매수4호가
				szPrc = contHoga.hogaTbl.GetCellString(13, 0)
			Case "16"										' 매수5호가
				szPrc = contHoga.hogaTbl.GetCellString(14, 0)
			Case "17"										' 매수6호가
				szPrc = contHoga.hogaTbl.GetCellString(15, 0)
			Case "18"										' 매수7호가
				szPrc = contHoga.hogaTbl.GetCellString(16, 0)
			Case "19"										' 매수8호가
				szPrc = contHoga.hogaTbl.GetCellString(17, 0)
			Case "20"										' 매수9호가
				szPrc = contHoga.hogaTbl.GetCellString(18, 0)
			Case "21"										' 매수10호가
				szPrc = contHoga.hogaTbl.GetCellString(19, 0)
			Case "22"										' 상한가
				szPrc = lblHigh.caption
			Case "23"										' 하한가
				szPrc = lblLow.caption
			Case Else										' 미적용 및 기타에러
				szPrc = ""
		End Select		
		
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AUTO_PRICE", szPrc)
	end if
End Function

'============================================================================
' Change_ItemCode
'============================================================================
Function Change_ItemCode()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")
	
	'20180906 LES START KOTC상품추가
	if szMk = "T" then
		Exit Function
	end if
	'20180906 LES END

	if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
		return g_szCd
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & g_szCd
	elseif szMk = "W" then	'ELW
		return "J" & g_szCd
	else
		return g_szCd
	end if 
End Function

'============================================================================
' Change_LinkForm
'============================================================================
Function Change_LinkForm()
	szStyle	= Form.LoadConfigData("mhprc11000", "Style")	'현재가 스타일

	If szStyle = "0" Then
		linkfm.linkfile = "mhprc11000_s1"
	ElseIf szStyle = "1" Then
		linkfm.linkfile = "mhprc11000_s2"
	ElseIf szStyle = "2" Then
		linkfm.linkfile = "mhprc11000_s3"
	Else
		linkfm.linkfile = "mhprc11000_s1"
	End If
End Function

'============================================================================
' Save_Chk : ' 20160318 가로 <-> 세로 연동관련
'============================================================================
Function Save_Chk()
	Dim szTemp, szTemp1, szTemp2, szCnt
	szTemp, szTemp1, szTemp2, szCnt = "", "", "", ""
	
	if g_szSavePwd == "0" then
	
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			szTemp = edtPwd.caption
		'MTS메모리평문제거 미적용상태일 때
		else
			szTemp = edtPwd.encdata & "★S★0★8★8"
			szTemp1 = edtPwd.caption
			szCnt = Len(edtPwd.caption)
		
			For i = 0 to szCnt - 1
				szTemp2 = Mid(szTemp1, i+1, 1)
				szTemp  = szTemp & "★" & szTemp2
			Next
		end if
		'20200910 SWJ END
			Form.SetSharedData("STOCK_SAVE", szTemp)
	end if
End Function

'============================================================================
' Load_Chk : ' 20160318 가로 <-> 세로 연동관련
'============================================================================
Function Load_Chk()
	Dim tTemp
	Dim szTemp, szTemp1
	szTemp, szTemp1 = "", ""
	
	'if g_szSavePwd == "0" then
		szTemp = Form.GetSharedData("STOCK_SAVE", true)
		Form.SetSharedData("STOCK_SAVE", "")
		
		'20200910 SWJ START
		'MTS메모리평문제거 미적용상태일 때
		if plain_rm == "1" then
			edtPwd.caption = szTemp
		else
			if Trim(szTemp) <> "" then
				szTemp1 = ""
				tTemp = Split(szTemp, "★")
				
				if tTemp[5] <> "" then
					For i = 0 to #tTemp-1
						if i > 4 then
							szTemp1 = szTemp1 & tTemp[i]
						end if
					Next
					
					edtPwd.caption = szTemp1
				else
					edtPwd.caption = ""
				end if
			end if
		end if
		'20200910 SWJ END
	'end if
End Function

