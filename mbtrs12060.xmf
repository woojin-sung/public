'============================================================================
' tblSelect_OnClick
'============================================================================
Sub tblSelect_OnClick(lRow , lColumn)

	'-----------------------------------------------------------------------
	' 20170202 LES STAR - 테이블 유형 변경 
	'-----------------------------------------------------------------------

	if lColumn == 1 then
		if g_szSlt == "HOGA1" then
			g_szSlt = "HOGA2"
			Form.SetSharedData("g_szSlt" ,"HOGA2")
			contDebi.scroll_pos = contHoga.scroll_pos()
			
			contDebi.left = 0
			contDebi.visible = true
			contHoga.left = 700
		
		elseif g_szSlt == "HOGA2" then
			g_szSlt = "HOGA1"
			Form.SetSharedData("g_szSlt" ,"HOGA1")
			
			contHoga.scroll_pos = contDebi.scroll_pos()
			contDebi.left = 600
			contDebi.visible = true
			
			
			contHoga.left = 0
				
		end if
	
	elseif lColumn == 0 then
		if g_szSlt2 == "HOGA" then
			g_szSlt2 = "SISE"
			Form.SetSharedData("g_szSlt" ,"SISE")
			tblSelect.SetCellString(0, 1, "시간별")
			grdList.left = 0
			grdList.visible = true
			'20220211 HSZ START : 시세속도 개선
			g_szGrd = "true"
			DATAMANAGER.RequestTranData("ohhts_1001_004r")		' 현재가(시간별)
			'20220211 HSZ END
			lblTime.left = 9
			lblTime.visible = true
			
			imgToggle.visible = false
			
		elseif g_szSlt2 =="SISE" then
			g_szSlt2 = "HOGA"
			Form.SetSharedData("g_szSlt" ,"HOGA")
			tblSelect.SetCellString(0, 1, "호가")
			grdList.left = 700
			'20220211 HSZ START : 시세속도 개선
'			grdList.visible = false
			grdList.visible = true
			g_szGrd = "false"
			DATAMANAGER.CancelRealData("ohhts_stck_cntg")
			'20220211 HSZ END
			lblTime.left = 701
			lblTime.visible = false
			
			imgToggle.visible = true
			
		end if
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_1001_004r" then	    
		DATAMANAGER.ClearInputData(0, "ohhts_1001_004r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	' ----------------------------------------------------------------------
	' 현재가(호가&예상체결)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_1001_005r" then
		'Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_HOGA", "")
			
		DATAMANAGER.ClearInputData(0, "ohhts_1001_005r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_1001_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1001_001r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(호가)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1181_001r" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_HOGA", "")
		
		DATAMANAGER.ClearInputData(0, "ohhts_1181_001r")

		DATAMANAGER.SetDataValue(0,"ohhts_1181_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0,"ohhts_1181_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(시세)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1181_002r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1181_002r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)		
	' ----------------------------------------------------------------------
	' 시간외단일가시세추이(시간별)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1182_002r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1182_002r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "J")
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_HOUR_CLS_CODE"     , 0, "1")
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "N")		
	' ----------------------------------------------------------------------
	' 고객정보
	' ----------------------------------------------------------------------	
	elseif szTranID = "obcsb_acif_000r" then
		DATAMANAGER.ClearInputData(0, "obcsb_acif_000r")

		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "PROS_CLS_CODE"	, 0, "1")			' 처리구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNO"			, 0, acnt.total)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD"		, 0, "")				' 계좌비밀번호	
	' ----------------------------------------------------------------------
	' 약정내역조회
	' ----------------------------------------------------------------------	
	elseif szTranID = "obpds_srvc_069r" then
		edtState.caption = ""
		DATAMANAGER.ClearInputData(0, "obpds_srvc_069r")

		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "CSNO"				, 0, edtCSNO.caption)	' 고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "SVCD"				, 0, "021")			' 서비스코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "ACNO"				, 0, acnt.total)		' 계좌번호(8)		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE"		, 0, "0" )			' 처리구분코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "STPL_STAT_CLS_CODE"	, 0, "98")			' 약정상태 구분코드
	' ----------------------------------------------------------------------
	' 상품_ELW교육 이수 확인내역
	' ----------------------------------------------------------------------	
	elseif szTranID = "obpds_srvc_243r" then
		edtEdu.caption = ""
		DATAMANAGER.ClearInputData(0, "obpds_srvc_243r")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_243r", "InBlock1", "ACNO", 0, acnt.total)	' 계좌번호(8)
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
    if szTranID = "ohhts_1001_001r" then
		Return_AutoPrice()
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
    elseif szTranID = "ohhts_1001_004r" then
		if g_szMk = "W" then
			DATAMANAGER.RequestRealData("ohhts_elw_cntg")
		else
			'20220211 HSZ START : 시세속도 개선
			DATAMANAGER.RequestRealData("ohhts_stck_incg")
			if g_szGrd = "true" then
				DATAMANAGER.RequestRealData("ohhts_stck_cntg")
			end if
			'20220211 HSZ END	
		end if
	' ----------------------------------------------------------------------
	' 현재가(호가&예상체결)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_1001_005r" then			
		DATAMANAGER.RequestTranData("ohhts_1001_004r")		' 현재가(시간별)
		DATAMANAGER.RequestTranData("ohhts_1001_001r")		' 현재가(시세&상세내역)
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		contDebi.scroll_pos = "vcenter"
		
		if g_szMk = "W" then		
			DATAMANAGER.RequestRealData("ohhts_elw_aspr")
		else
			DATAMANAGER.RequestRealData("ohhts_stck_aspr")
		end if
	' ----------------------------------------------------------------------
	' 시간외단일가시세추이(시간별)
	' ----------------------------------------------------------------------	
    elseif szTranID = "ohhts_1182_002r" then
	    Return_AutoPrice()
	    
		if g_szMk = "W" then
			'DATAMANAGER.RequestRealData("")
		else
			
			DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")
		end if
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(호가)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_1181_001r" then	
		DATAMANAGER.RequestTranData("ohhts_1181_002r")		' 시간외단일가(시세)
		DATAMANAGER.RequestTranData("ohhts_1182_002r")		' 시간외단일가(시간별)
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		contDebi.scroll_pos = "vcenter"
		
		if g_szMk = "W" then		
			'DATAMANAGER.RequestRealData("")
		else
			
			DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")
		end if
	' ----------------------------------------------------------------------
	' 고객정보
	' ----------------------------------------------------------------------		
	elseif szTranID = "obcsb_acif_000r" then	
		edtCSNO.caption = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CSNO", 0)	' 고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_069r")
	' ----------------------------------------------------------------------
	' 약정내역조회
	' ----------------------------------------------------------------------	
	elseif szTranID = "obpds_srvc_069r" then
		edtState.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "STPL_STAT_CLS_CODE", 0)	' 약정상태 구분코드
		
		DATAMANAGER.RequestTranData("obpds_srvc_243r")
	' ----------------------------------------------------------------------
	' 상품_ELW교육 이수 확인내역
	' ----------------------------------------------------------------------	
	elseif szTranID = "obpds_srvc_243r" then	
		if edtState.caption == "01" then
			edtEdu.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_243r", "OutBlock1", "ELW_EDCT_CMCO_YN", 0)			' ELW교육 이수여부
	
			if edtEdu.caption == "N" then
				Form.OpenPopup("mbtrs12000_pd", "N", "")
			end if
		else
			Form.OpenPopup("mbtrs12000_pd", "Y", "")
		end if
    end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 주식체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_stck_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주식체결 자동갱신 '20220215 HSZ : 시세속도 개선
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_stck_incg" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주식호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_stck_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_elw_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 시간외단일가체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_ovtp_cntg" then
		'20170622 LES START - 실시간 서비스 인풋값 설정 수정
		'DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 시간외단일가호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_ovtp_aspr" then
		'20170622 LES START - 실시간 서비스 인풋값 설정 수정
		'DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)	
		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	end if
End Sub

