'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	Dim szCd, szChk
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	Form.SetRealBundle("1")	'20230912 SWJ START : 시세 묶음 처리
	
	Change_LinkForm()
	Load_OrderSet()
	'10호가창 중간위치
	contHoga.scroll_pos = "vcenter"
	contDebi.scroll_pos = "vcenter"
	
	' 종목컨트롤
	'Form.SetSearchType ("1:2:3:5:6")
	Form.SetSearchType ("29:1:5:6:3")		'20220922 SWJ START : 최근조회 탭 추가
	
	szOpen = Form.GetOpenLinkData()
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	' ----------------------------------------------------------------------
	' 다른화면에서 화면오픈시
	' ----------------------------------------------------------------------	
	if szOpen <> "" then
		'- 잔고	
		' 전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		' szData = "잔고" & "★" & szTab & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr
			
		'- 미체결	
		' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
		' szData = "미체결" & "★" & szTab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd

		'- 현재가화면 : 20160321 현재가에서 주문화면 오픈 추가
		' 전달내용/탭위치/종목코드/전달가격
		' szData = "현재가" & "★" & szTab & "★" & szCd & "★" & szPrc

		'- 기타화면
		' 전달내용/탭위치/종목코드
		' szData = "기타" & "★" & szTab & "★" & szCd
		tData = Split(szOpen, "★")

		' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
		if g_szCd == tData(2) then
			szChk = "0"
		else
			szChk = "1" 
		end if
		
		'20180906 LES START KOTC상품추가
		szMk = Form.GetItemCodeInfo(tData(2), "market")
		if szMk = "T" then
			Exit Sub
		end if
		'20180906 LES END

		' 폼탭변경(0:매수, 1:매도, 2:정정, 3:취소)
		if Trim(tData(1)) == "" then
			fmTab.currenttab = "0"
		else
			fmTab.currenttab = tData(1)
		end if
		
		Check_ELW(tData(2))									' ELW종목 여부
		Return_Change_ItemCode(tData(2))

		' ELW경우
'		if g_szMk == "W" then
'			DATAMANAGER.RequestTranData("obcsb_acif_000r")
'		end if


		
		if tData(0) == "잔고" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_BALANCE_RETURN", tData(3))	
		elseif tData(0) == "미체결" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_CONTRACT_RETURN", tData(3) & "♥" & szChk)	
		elseif tData(0) == "현재가" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_HYUN_RETURN", tData(3))
		end if
	' ----------------------------------------------------------------------
	' 최근조회종목
	' ----------------------------------------------------------------------			
	else		
		szCd = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
		
		'20180906 LES START KOTC상품추가
		szMk = Form.GetItemCodeInfo(szCd, "market")
		if szMk = "T" then
			Exit Sub
		end if
		'20180906 LES END
		Form.SetItemCode(szCd)						' 최초 화면진입시 종목코드 설정
		
		Check_ELW(szCd)									' ELW종목 여부
		
		' 현금/신용구분
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "ORDER_GBN", rdoGbn.currentindex)
		
		' ELW경우
		if g_szMk == "W" then
			DATAMANAGER.RequestTranData("obcsb_acif_000r")
		end if		
	end if
	
	
	'------------------------------------------------------------------------
	' 20170203 LES START - 마지막 그리드 유형 저장
	'------------------------------------------------------------------------
	
	if Form.GetSharedData("g_szSlt", false) == "HOGA1" then
		g_szSlt = "HOGA2"
		Call tblSelect_OnClick(0 ,1)
		
	
	elseif Form.GetSharedData("g_szSlt", false) =="HOGA2" then
		g_szSlt = "HOGA1"
		Call tblSelect_OnClick(0 ,1)
	
	elseif Form.GetSharedData("g_szSlt", false) =="HOGA" then
		g_szSlt2 = "SISE"
		Call tblSelect_OnClick(0 ,0)
	
	elseif Form.GetSharedData("g_szSlt", false) == "SISE" then
		g_szSlt2 = "HOGA"
		Call tblSelect_OnClick(0 ,0)
		
	
	end if
	
	
	
	
	
End Sub

'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	Clear_SharedData()
	
	if sKey = "ITEMCODE" then
		if g_szRtnO == "1" then	' 20160316
			g_szRtnO = ""
			
			if g_szChangeInit == "1" then
				edtOrgNo.caption = ""
			end if
		else
			edtOrgNo.caption = ""
		end if
		
		edtModTab.caption = ""
		edtCnlTab.caption = ""
		lblPrc.caption = ""
		
		'20221005_01 HWG START : 거래소 차세대 대응
'		szOsType = Form.GetSharedData("&OS_TYPE", false)
'		
'		if szOsType = "1" then
'			'20180906 LES START KOTC상품추가
'			szMk = Form.GetItemCodeInfo(sValue, "market")
'			if szMk = "T" then
'				szRecent = Form.GetRecentHistory("1")
'				Load_RecentList(szRecent)
'				
'				Exit Sub
'			end if
'			'20180906 LES END
'		end if
		'20221005_01 HWG END
		
		Check_ELW(sValue)									' ELW종목 여부
		
		nTab = fmTab.currenttab
		if nTab == 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif nTab == 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif nTab == 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif nTab == 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
		if Trim(szType) == "" or szType == null then
			szType = "0"
		end if

		if sValue <> g_szCd then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		end if
		
		Change_HOGA_Request(sValue, szType)

'		if sValue <> g_szCd then
'			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
'		end if
	elseif sKey = "&ACR_ITEM" then
		Form.SetItemCode(sValue)

		edtOrgNo.caption = ""
		edtModTab.caption = ""
		edtCnlTab.caption = ""
		lblPrc.caption = ""
		
		Check_ELW(sValue)									' ELW종목 여부
		
		nTab = fmTab.currenttab
		if nTab == 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif nTab == 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif nTab == 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif nTab == 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
		if Trim(szType) == "" or szType == null then
			szType = "0"
		end if

		if sValue <> g_szCd then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		end if
		
		Change_HOGA_Request(sValue, szType)

'		if sValue <> g_szCd then
'			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
'		end if
	end	if	
End Sub

