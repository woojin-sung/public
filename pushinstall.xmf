<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="PUSH_설치" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,309,287,1" />
	<CONTROL_INFO>
		<IMAGE name="imgTitle" imgpath="pop_header.9" ly_vert="0,0,309,55,1" />
		<BUTTON name="ButtonCancel" caption="아니오" fgcolor="018:102102102" btnimage="btn_02.9" ly_vert="19,236,125,39,1" />
		<BUTTON name="ButtonOK" caption="예" btnimage="btn_01.9" ly_vert="153,236,123,39,1" />
		<LABEL name="Label0" caption="메리츠 알리미 앱을 설치하면 중요 공지, Watching, 주문체결통보 등 유용한 정보를 수신 받을 수 있습니다.

설치를 진행하시겠습니까?" multiline="1" ly_vert="6,63,294,112,1" />
		<CHKBUTTON name="ChkButton0" chkcaption="다시 보지 않기" unchkcaption="다시 보지 않기" ly_vert="20,185,284,34,1" />
		<IMAGE name="imgClose" autosize="1" imgpath="ic_pop_close.png" ly_vert="265,15,24,24,1" />
		<LABEL name="LabelTitle" fontsize="2" caption="메리츠 알리미 앱 설치" bgcolor="064:188030030" halign="1" autofontsize="1" ly_vert="0,0,309,55,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="912" _ulen="912" >
'============================================================================


'============================================================================
Sub ButtonCancel_OnClick()
	szInstall = ChkButton0.checkstate
	Form.SetEnvData(1, "alarm.push_install", szInstall)
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	szInstall = ChkButton0.checkstate
	Form.SetEnvData(1, "alarm.push_install", szInstall)
	Form.SendMessageToMain("PUSH_INSTALL", "", "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	szInstall = Form.GetEnvData("alarm.push_install")
	ChkButton0.checkstate = szInstall
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>