<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="88029" scrname="대차중개약정 안내_P" version="2" writer="이학록" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBg" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imbPopUp" imgpath="popup_bg.9" ly_vert="0,215,375,432,1" />
		<LABEL name="lblText0" fgcolor="095:000000000" fontsize="2" fontstyle="01" caption="알려드려요!" halign="1" ly_vert="0,223,375,32,1" />
		<LABEL name="lblText2" fontsize="-2" fontstyle="01" caption="대차거래란?" ly_vert="22,360,120,15,1" />
		<LABEL name="lblText3" fontsize="-3" caption="고객(대여자)이 보유한 주식/채권을 필요로 하는 기관" ly_vert="23,380,310,15,1" />
		<LABEL name="lblText4" fontsize="-3" caption="투자자(차입자)에게 대여하여 대여주식/채권으로 부터" ly_vert="23,396,310,15,1" />
		<LABEL name="lblText5" fontsize="-3" caption="발생된 대여 수수료를 받아 추가 수익을 낼수 있는 거래" ly_vert="23,414,310,15,1" />
		<LABEL name="lblText6" fontsize="-3" caption="입니다." ly_vert="23,427,310,15,1" />
		<LABEL name="lblText7" fontsize="-3" caption="대여된 주식/채권은 언제든지 반환요청(상환) 하실 수" ly_vert="23,450,340,15,1" />
		<LABEL name="lblText8" fontsize="-3" caption="있어요." ly_vert="23,463,340,15,1" />
		<LABEL name="lblText9" fontsize="-3" caption="대여주식은 대여주문화면에서 언제든지 매도가" ly_vert="23,485,340,15,1" />
		<LABEL name="lblText10" fontsize="-3" caption="가능하며, 대여채권은 고객(대여자)의 반환요청을 통해" ly_vert="23,497,340,15,1" />
		<LABEL name="lblText11" fontsize="-3" caption="상환 들어온 채권에 대해서만 매도하실 수 있어요." ly_vert="23,515,340,15,1" />
		<LABEL name="lblText12" fontsize="-3" caption="※ 투자 전 설명 청취 및 상품설명서ㆍ약관 필독" ly_vert="21,544,310,15,1" />
		<LABEL name="lblText13" fontsize="-3" caption="※ 예금자보호법상 보호상품 아님" ly_vert="21,559,310,15,1" />
		<LABEL name="lblText14" fontsize="-3" caption="※ 원금손실 발생가능 및 투자자 귀속" ly_vert="21,574,310,15,1" />
		<IMAGE name="imgOK" ly_vert="0,597,188,50,1" />
		<LABEL name="lblOK" fgcolor="062:255255255" fontsize="1" fontstyle="01" caption="확인" halign="1" click="1" ly_vert="7,605,175,36,1" />
		<IMAGE name="imgLndnStpl" ly_vert="188,597,187,50,1" />
		<LABEL name="lblLndnStpl" fgcolor="062:255255255" fontsize="1" fontstyle="01" caption="대차중개 신청하기" halign="1" click="1" ly_vert="194,605,176,36,1" />
		<LABEL name=" LblLine0" bgcolor="075:244244244" transmode="0" ly_vert="0,260,375,1,1" />
		<LABEL name=" LblLine1" bgcolor="075:244244244" transmode="0" ly_vert="35,535,305,1,1" />
		<LABEL name="Label0" fontsize="2" fontstyle="01" caption="국내주식, 채권을 보유한 고객이라면" halign="1" ly_vert="0,280,375,20,1" />
		<LABEL name="Label1" fontsize="2" fontstyle="01" caption="대여수익" ly_vert="85,300,75,20,1" />
		<LABEL name="Label2" fontsize="2" fontstyle="01" caption="도 얻을 수 있어요." ly_vert="152,300,140,20,1" />
		<LABEL name="Label3" fgcolor="127:162162162" fontsize="-1" fontstyle="01" caption="(채권대차서비스 오픈 준비 중)" halign="1" ly_vert="0,320,375,20,1" />
		<IMAGE name="Image0" autosize="1" imgpath="icon_check.png" ly_vert="15,357,15,15,1" />
		<IMAGE name="ImageInfo3" autosize="1" imgpath="icon_dot.png" ly_vert="21,382,10,10,1" />
		<IMAGE name="ImageInfo0" autosize="1" imgpath="icon_dot.png" ly_vert="21,450,10,10,1" />
		<IMAGE name="ImageInfo1" autosize="1" imgpath="icon_dot.png" ly_vert="21,485,10,10,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2395" _ulen="2165" >

'============================================================================
Sub Form_OnFormInit()
'	Form.SetCtlProp("lblText1", "fgcolor", "291")
	'Form.SetCtlProp("lblText1", "fgcolor", "127") '메뉴비활성화
	'Form.SetCtlProp("lblText1", "fgcolor", "267") '기본글자
	
	Label1.setHighlight(332)
	
	for i = 12 to 14
		Form.SetCtlProp("lblText"&i, "fgcolor", "127")
	next
	
	nStartOffset = lblText5.getLen("발생된 ")
	nLength = lblText5.getLen("대여 수수료를 받아 추가 수익을 낼수 있는 거래")
	lblText5.changeTextAttr(nStartOffset, nLength, 291, -3, false)
	
	nStartOffset = lblText7.getLen("대여된 주식/채권은 ")
	nLength = lblText7.getLen("언제든지 반환요청")
	lblText7.changeTextAttr(nStartOffset, nLength, 291, -3, false)
	
	nStartOffset = lblText9.getLen("대여주식은 대여주문화면에서 ")
	nLength = lblText9.getLen("언제든지 매도")
	lblText9.changeTextAttr(nStartOffset, nLength, 291, -3, false)
	
	nStartOffset = 0
	nLength = lblText11.getLen("상환 들어온 채권에 대해서만 매도")
	lblText11.changeTextAttr(nStartOffset, nLength, 291, -3, false)
	
	imgLndnStpl.imgpath = "btn_20_n.9.png"
	imgOK.imgpath = "btn_27_o.9.png"
End Sub

'============================================================================
' 대차중개 신청하기
'============================================================================
Sub lblLndnStpl_OnClick()
	Form.OpenScreen(88022 , "")
End Sub

'============================================================================
' 대차중개 신청하기
'============================================================================
Sub imgLndnStpl_OnClick()
	lblLndnStpl_OnClick()
End Sub

'============================================================================
' 확인
'============================================================================
Sub lblOK_OnClick()
	Form.SaveConfigData("NoticeSetting", "mbonl88029_p5", "1") 	'1일 때 오픈하지 않고 닫기
	Form.CloseForm()
End Sub

'============================================================================
' 다시보지 않음
'============================================================================
Sub imgOK_OnClick()
	lblOK_OnClick()	
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
