Dim g_sRetData
Dim g_sPopupFileName

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "cancel"
	g_sPopupFileName = "mhetc90020_p5"
	Form.SetScreenName("ID등록")
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if Form.GetSharedData("&OS_TYPE", false) == "1" then	'Android("1") iOS("2")
		Container0.setScrollBarVisible("2")
	end if
	
	Dim URLheader, ServerMode
	ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If ServerMode == "1" Then	'개발기
		URLheader = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/"
	Else
		URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	End If
	
	Container0.web0.urlpath = URLheader &  "meritz_yk_13.html"	'20191007 HWG : 온라인서비스 이용약관 변경 (홈페이지연동)
End Sub

'============================================================================
