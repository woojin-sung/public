Sub btnOK_OnClick()
'	if chkAgree0.chksilence == "0" then
'		Form.MsgBox( "알림", "이용약관 동의를 확인하시기 바랍니다.", "", 6 )
'		Exit Sub
'	end if
	
	'20160610 NOHES START 문구수정
	'은행개설계좌ID등록_개인정보필수동의와 갯수 맞추기 위해
	Form.OpenFramePopup( g_sPopupFileName , "지점/모바일 ★★★★★★★" , sPosInfo)
	'20160610 NOHES END
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mhetc90020_p8" , g_sRetData)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == g_sPopupFileName then
	
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
		
	end if

End Sub

