' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_bBtnMkClk
g_bBtnMkClk = false

Dim g_szAble
g_szAble = "0"

Dim g_szTitle
g_szTitle = "알림"

Dim g_bRtnData
g_bRtnData = false


