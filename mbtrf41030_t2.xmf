	'20170413 HAMWG START : 주문유형 콤보 변경시 KEY값을 파라미터로 전달
	kIndex = cmbType.cbkeydata
	Visible_Control(kIndex)
	'20170413 HAMWG END
End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	Dim szPrice, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if

	
	'20170420 HAMWG START : obtrf_cntg_335r 매매시장구분코드
	if g_szMk == "O" or g_szMk = "MO" then
		szInrMk = "05"
	else
		szInrMk = "04"
	end if
	
	if Trim(edtPrc.caption) == "" then
		szPrice = "0.00"
	else
		szPrice = edtPrc.caption
	end if
		
	' 계좌번호|계좌일련번호|선옵구분|매매유형(1매도, 2매도)|주문수량|주문단가|종목코드
	szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "1" & "★" & edtQty.caption & "★" & szPrice & "★K" & g_szCd 
    
    Form.OpenPopup("mbtrf41030_pe" , szData , "")
End Sub

