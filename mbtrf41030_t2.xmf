'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtPrc.caption = ""
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szBtnMkt     = Form.LoadConfigData("SET_ORDER", "BTN_MARKET")				' 시장가 주문버튼
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
		
	g_szSelQty     = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_SELQTY")		' 매도수량 자동입력
	g_szSelQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 시장가 주문버튼(기본값 : 미사용)
	if Trim(g_szBtnMkt) = "1" then
		btnMkSel.visible = true
	else
		btnMkSel.visible = false
	end if	
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170511 HAMWG START : 기본값 사용으로 변경
	' 종목/탭 변경시 초기화(기본값 : 미사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"		
	end if
	'20170511 HAMWG END 

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
		
	' 매도수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelQty) = "" then
		g_szSelQty = "0"		
	end if	
End Function

'============================================================================
' Visible_Control : nGbn(유형)
'============================================================================
Function Visible_Control(nGbn)
	'20170413 HAMWG START : 주문유형 콤보 인덱스가아닌 KEY값을 파라미터로 받도록 수정
	Select case nGbn
		case "10"
			edtPrc.caption = ""
			edtPrc_OnEditComplete()
			
			edtPrc.enable = false	
			btnPrc.enable = false
			btnPPlus.enable = false
			btnPMinus.enable = false
			
		case else
			edtPrc.enable = true
			btnPrc.enable = true
			btnPPlus.enable = true
			btnPMinus.enable = true
	End Select
	'20170413 HAMWG END
End Function

'============================================================================
' Check_OrdType : 호가유형코드 확인
'============================================================================
Function Check_OrdType()
	Dim szIdx
	
	if g_bBtnMkClk == true Then					'시장가 주문
		return "1"	
	else '일반주문
		'20170413 HAMWG START : 야간선옵 종목별 주문유형 리스트변경에 대응
		szKeyIdx= cmbType.cbkeydata
		szOrdType = mid(szKeyIdx,1,1)
		return szOrdType
		'20170413 HAMWG END				
    End If
End Function

'============================================================================
' Check_CondCode : 주문조건 구분 확인
'============================================================================
Function Check_CondCode()
	Dim szIdx
	
	if g_bBtnMkClk == true Then					'시장가 주문
		return "0"
	else '일반주문
		'20170413 HAMWG START : 야간선옵 종목별 주문유형 리스트변경에 대응
		szKeyIdx= cmbType.cbkeydata
		szOrdType = mid(szKeyIdx,2,1)
		return szOrdType
		'20170413 HAMWG END				
    End If
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn <> 1 then
		szType = Check_OrdType()
		
		if szType == "2" or szType = "I" then	' 지정, 조건부
			if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if	
		end if
	end if	
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	
	szData = "81"											' 매매구분
'	szData = szData & "|" & g_szMk								' 시장구분 (사용X)
	szData = szData & "|" & Form.GetCtlProp("#acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname")		' 계좌명
	szData = szData & "|" & g_szCd								' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name_night")		' 종목명
	szData = szData & "|" & cmbType.caption						' 주문구분
	szData = szData & "|" & edtPrc.caption						' 주문가격	
	szData = szData & "|" & edtQty.caption						' 주문수량
	szData = szData & "|" & ""									' 원주문번호
'	szData = szData & "|" & ""									' 전량전부
	
	if Trim(szWarn) <> "" then
		szData = szData & "|" & szWarn					' 경고메세지
		
		Form.OpenPopup("mbtrf31050_p6", szData , "")		' 경고팝업 오픈
	else
		Form.OpenPopup("mbtrf31050_p3", szData , "")		' 주문확인팝업 오픈
	end if
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order(nGbn)
	if nGbn == 1 then
		g_szWarnFlag = "Y"
	else
		g_szWarnFlag = "N"
	end if
	
	'20170420 HAMWG START : 야간선옵 주문서비스 변경
	DATAMANAGER.RequestTranData("obtrf_oder_801c")	
	'20170420 HAMWG END
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' ReSet_Prc : 20160324 추가
'============================================================================
'20170420 HAMWG START : 틱가격 단위 수정
Function ReSet_Prc(szData, nGbn)
		if g_szMk == "EO" or g_szMk == "EW" then			' 옵션 '20220311 HSZ 위클리옵션 추가
			if nGbn == 0 then
				if CDbl(szData) >= 10.00 then 
					nResult = Round(CDbl(szData) Mod 0.05, 2)
					 
					if nResult <> 0 and nResult <> 0.05 then
						return CDbl(szData) - nResult
					else
						return szData
					end if
				else
					return szData
				end if
			else
				if CDbl(szData) > 10.00 then 
					nResult = Round(CDbl(szData) Mod 0.05, 2)
					
					if nResult <> 0 and nResult <> 0.05 then
						return CDbl(szData) + (0.05 - nResult)
					else
						return szData
					end if
				else
					return szData
				end if
			end if		
'		elseif g_szMk == "MO" then		' 미니옵션
'			if nGbn == 0 then
'				if CDbl(szData) >= 10.00 then 
'					nResult = Round(CDbl(szData) Mod 0.05, 2)
'					 
'					if nResult <> 0 and nResult <> 0.05 then
'						return CDbl(szData) - nResult
'					else
'						return szData
'					end if
'				elseif CDbl(szData) < 10.00 and CDbl(szData) >= 3.00 then
'					nResult = Round(CDbl(szData) Mod 0.02, 2)
'					
'					if nResult <> 0 and nResult <> 0.02 then
'						return CDbl(szData) - nResult
'					else
'						return szData
'					end if
'				else
'					return szData
'				end if
'			else
'				if CDbl(szData) > 10.00 then 
'					nResult = Round(CDbl(szData) Mod 0.05, 2)
'
'					if nResult <> 0 and nResult <> 0.05 then
'						return CDbl(szData) + (0.05 - nResult)
'					else
'						return szData
'					end if
'				elseif CDbl(szData) <= 10.00 and CDbl(szData) > 3.00 then
'					nResult = Round(CDbl(szData) Mod 0.02, 2)
'					
'					if nResult <> 0 and nResult <> 0.02 then
'						return CDbl(szData) + (0.02 - nResult)
'					else
'						return szData
'					end if
'				else
'					return szData
'				end if
'			end if			
		elseif g_szMk == "EM" then		' 미니선물
			if nGbn == 0 then
				nResult = Round(CDbl(szData) Mod 0.02, 2)
				
				if nResult <> 0 and nResult <> 0.02 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				nResult = Round(CDbl(szData) Mod 0.02, 2)
				
				if nResult <> 0 then
					return CDbl(szData) + (0.02 - nResult)
				else
					return szData
				end if
			end if
		elseif g_szMk == "CD" then		' 미국달러선물
			if nGbn == 0 then
				nResult = Round(CDbl(szData) Mod 0.1, 2)
				
				if nResult <> 0 and nResult <> 0.1 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				nResult = Round(CDbl(szData) Mod 0.1, 2)
				
				if nResult <> 0 then
					return CDbl(szData) + (0.1 - nResult)
				else
					return szData
				end if
			end if	
		else							' 선물, 그외?
			if nGbn == 0 then
				nResult = Round(CDbl(szData) Mod 0.05, 2)

				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				nResult = Round(CDbl(szData) Mod 0.05, 2)
	
				if nResult <> 0 then
					return CDbl(szData) + (0.05 - nResult)
				else
					return szData
				end if
			end if
		end if		
End Function
'20170420 HAMWG END
'============================================================================
' Init_Unit : 2016.03.24 분리
'============================================================================
'20170420 HAMWG START : 틱가격 단위 수정
Function Init_Unit(szPrc, nGbn)
	if g_szMk == "EO" or g_szMk == "EW" then			' 옵션 '20220311 HSZ 위클리옵션 추가
		if nGbn == 0 then
			if CDbl(szPrc) >= 10.00 then 
				return "0.05"
			else
				return "0.01"
			end if
		else
			if CDbl(szPrc) > 10.00 then 
				return "0.05"
			else
				return "0.01"
			end if
		end if		
'	elseif g_szMk == "MO" then		' 미니옵션
'		if nGbn == 0 then
'			if CDbl(szPrc) >= 10.00 then 
'				return "0.05"
'			elseif CDbl(szPrc) < 3.00 then
'				return "0.01"
'			else
'				return "0.02"
'			end if
'		else
'			if CDbl(szPrc) > 10.00 then 
'				return "0.05"
'			elseif CDbl(szPrc) <= 3.00 then
'				return "0.01"
'			else
'				return "0.02"
'			end if
'		end if			
	elseif g_szMk == "EM" then		' 미니선물
		return "0.02"
	elseif g_szMk == "CD" then		' 미국달러선물
		return "0.1"
	else							' 선물, 그외?
		return "0.05"
	end if
End Function
'20170420 HAMWG END
'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, szOld, szRight
	
	szPrc  = edtPrc.caption
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	szHyun = Form.GetCtlProp("#lblHyun", "caption")
	szOld  = szPrc
	
	if Trim(szPrc) == "" then
		szPrc = CDbl(szHyun)
	else
		szUnit = Init_Unit(szPrc, nGbn)
		szPrc = ReSet_Prc(szPrc, nGbn)
		szPrc = Set_Unit(szPrc)

		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				szPrc = szHigh
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
				szPrc = szLow
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				szPrc = szHigh		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				szPrc = szLow
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if

	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData)
	Dim szChk
	
	szChk = InStr(CStr(szData), ".")
	
	if CStr(szChk) == "0" then
		return szData & ".00"
	else
		szCha = CInt(Len(szData) - szChk)
		
		if CStr(szCha) == "1" then 
			return szData & "0"
		end if
	end if
	
	return szData
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CInt(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CInt(szQty) + nUnit
		elseif nGbn == 1 then
			if CInt(szQty) == 0 then
				Exit Function
			else
				szQty = CInt(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
End Function

'============================================================================
' Request_Able
'============================================================================
Function Request_Able(nGbn)
'	if Check_Account(1) == false then
'		Exit Function
'	end if
	
	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Function
	end if

	if nGbn == 1 or nGbn == 3 then		' 20160318 신규/총버튼 클릭시 조건적용
		szType = Check_OrdType()
		
		if szType == "2" then	' 지정
			if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if	
		end if
	end if
		
	g_bBtnMkClk = false
	g_szWarnFlag = "N"
	
	if nGbn == 1 then		' 신규
		g_szAble = "1"
	elseif nGbn == 2 then	' 청산
		g_szAble = "2"
	elseif nGbn == 3 then	' 총
		g_szAble = "3"
	end if
	
	DATAMANAGER.RequestTranData("obtrf_cntg_811r")
End Function

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szSelQty == "1" then			' 신규가능수량
		Request_Able(1)
	elseif g_szSelQty == "2" then		' 청산가능수량
		Request_Able(2)
	elseif g_szSelQty == "3" then		' 수랑입력
		edtQty.caption = g_szSelQtyCnt
	end if
End Function
'============================================================================
'20170413 HAMWG START : 종목코드 대응 주문유형 리스트 변경
'============================================================================
Function Change_CmbList()
	cmbType.cbinputdatatext = "20`보통\r\n23`보통(IOC)\r\n24`보통(FOK)"
	
'	if g_szMk = "CD" or g_szMk = "CM" then
'		cmbType.clear = true
'		cmbType.cbinputdatatext = "20`보통\r\n10`시장가\r\n23`보통(IOC)\r\n24`보통(FOK)"
'	elseif g_szMk = "EM" or g_szMk = "EO" then
'		cmbType.clear = true
'		cmbType.cbinputdatatext = "20`보통\r\n10`시장가\r\n23`보통(IOC)"
'	else
'		cmbType.clear = true
'		cmbType.cbinputdatatext = "20`보통\r\n23`보통(IOC)\r\n24`보통(FOK)"
'	end if
	
	btnPrc.enable = true
	edtPrc.enable = true
	btnPPlus.enable = true
	btnPMinus.enable = true
End Function

