Dim g_szBtnMkt

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szSelQty, g_szSelQtyCnt

' 주문후 
Dim g_szAfterOrg

'20170529 HAMWG : 수량 연동위한 잔고팝업 리턴여부 플래그
Dim g_szBalQty
