'ios 에서 푸시알림을 허용했는지 여부 확인 후, 허용 안함 이면 안내 팝업+다음 진행 불가(죽는 현상 예방)
'============================================================================
Function ChkPush()
	If g_OSTYPE == "2" Then
		if Form.isValidPushNotification() == False or  Form.isValidPushNotification() == "0" or  Form.isValidPushNotification() == 0 Then		
			ShowAlert "알림", "고객님 단말기의 PUSH 알림이 허용되지 않았습니다.\n"&
				"단말기의 “설정→알림→메리츠 SMART” 알림을 허용하신 후, 간편인증 서비스를 이용해주시기 바랍니다."
			return False	
		End if
	End if
	return True
End Function


