'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 간편인증 서비스
' 02. 화면설명 : 간편인증 서비스 메인
' 03. 작    성 : 2016.08.05  NOHES
'-------------------------------------------------------------------------------------------
'20201116 SWJ START 실명확인번호 암호화 (rcno_plain_rm = 0 미적용 / rcno_plain_rm = 1 적용)
'20201126 SWJ START 공인인증서 '공인'글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim G_GUIDEPOPUP		'간편인증 서비스 이용안내
Dim G_ADDPOPUP		'간편인증 서비스 추가인증
Dim G_OCSP			'간편인증 서비스 인증서비밀번호 검증

Dim	g_Service

Dim g_spad_sID		'사용자 ID
Dim g_spad_sCertSerialNo	'인증서 시리얼번호
Dim g_spad_sCusNo		'고객번호
Dim g_spad_sCertPswd	'인증서 비밀번호
Dim g_spad_sAuthToken	'spinpad 인증토큰값
Dim g_spad_sSpEncKey	'spinpad 암호키

g_nChange = 0 
Dim g_bCheck			'reqCheckJoin 가입여부
Dim	g_bAdd
Dim	g_spad_AddsID		'추가 등록 ID
Dim 	g_OSTYPE

'보안매체 구분 팝업
Dim G_CERT_SECURITY_FILE	'보안카드
Dim G_CERT_QUESTION_FILE	'부가인증
Dim G_CERT_OTP_FILE		'OTP

Dim g_bCancelLogout		'20170922 HAMWG : 간편인증 해지 후 로그아웃 여부

' 20201116 SWJ START : 실명확인번호 암호화 적용구분값
Dim rcno_plain_rm
rcno_plain_rm =""

Dim g_MediaType
g_MediaType =""

'20210216 SWJ START : 모바일OTP 매체구분자
Dim UI_SMRT_OTP_YN
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************



'============================================================================
Sub Form_OnFormInit()
	G_GUIDEPOPUP = "mhetc90070_p1"		'간편인증 서비스 이용 안내
	G_ADDPOPUP = "mhetc90060_p8"		'추가인증
	G_OCSP = "mhetc90060_p5"			'인증서 비밀번호 검증
	
	G_CERT_SECURITY_FILE = "mhetc90060_p9"
	G_CERT_QUESTION_FILE = "mhetc90060_pa"
	G_CERT_OTP_FILE = "mhetc90060_pb"
	
	'20210216 SWJ START : 모바일OTP 인증매체 추가
	G_CERT_MOTP_FILE = "mhetc90060_motp"
	'20210216 SWJ END	
		
	g_OSTYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	
	g_bCancelLogout = False			'20170922 HAMWG : 간편인증 해지 후 로그아웃 여부
	
	g_Service = ""
	g_bAdd = False					'추가ID 등록 여부
	
	g_spad_sID = Form.GetSharedData( "&USER_ID", 0 )	'고객ID
	If Trim(g_spad_sID) == "" Then
		Form.MsgBox("알림", "로그인 상태를 확인하시기 바랍니다.", "", 0)
		Exit Sub
	End If
	
	'20201116 SWJ START : 실명확인번호 암호화(예외처리 해제)
	'rcno_plain_rm = ( 0 : 미적용/ 1 : 적용)
	rcno_plain_rm = Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	'20201116 SWJ END
	
	'20161108 NOHES START : BIO인증 시 ID로그인 유도
	sType = Form.GetSharedData("&CERT_USE_TYPE", 0 )'(0.일반인증서 1.간편인증인증서 2.KOSCOM지문인식용인증서 3.FIDO인증서)
	If Cint(sType) >= 3 Then					'20230718 SWJ START : 5. 메리츠 간편인증 반영
		Form.MsgBox("알림", "간편인증 서비스를 이용하기 위해서, ID인증 또는 인증 로그인이 필요합니다.\n로그인하시겠습니까?", "FIDO_RETURN", 1)
		Exit Sub
	end if
	
	
	'20180530 HAMWG START : 인증 로그인 권한상승(전업무)
	If Form.GetSharedData( "&LOGIN_TYPE", 0 ) <> "3" and Form.GetSharedData( "&LOGIN_TYPE", 0 ) <> "2" Then
		Form.MsgBox("알림", "ID인증 또는 인증 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "FIDO_RETURN", 1)
		Exit Sub
	End If
	'20180530 HAMWG END
	
	'20161108 NOHES END
	DATAMANAGER.SetDataValue(0, "obcsb_info_004r", "InBlock1", "ELFN_ID", 0, g_spad_sID)	'고객번호 요청
	DATAMANAGER.RequestTranData( "obcsb_info_004r" )
	
	DATAMANAGER.SetDataValue(0, "obacp_comm_004r", "InBlock1", "ELFN_ID", 0, g_spad_sID)
	DATAMANAGER.RequestTranData( "obacp_comm_004r" )
	
End Sub


'============================================================================
Sub Table0_OnClick(lRow , lColumn)

	if lRow == 0 or lRow == 1 or lRow == 2 or lRow == 3 or lRow == 4 then '간편인증 서비스 이용안내
		Image2_OnClick()'간편인증 서비스 신청
		
	elseif lRow == 5 or lRow == 6 or lRow == 7 or lRow == 8 or lRow ==9 then  '간편인증 서비스 신청
		Image4_OnClick()'간편인증 서비스 비밀번호 변경	
		
	elseif lRow == 10 or lRow ==11 or lRow == 12  or lRow == 13 or lRow == 14 then  '간편인증 서비스 비밀번호 변경
		Image5_OnClick()'간편인증 서비스 해지	
	end if	
End Sub

'간편인증 로그인 신청
'============================================================================
Sub Image2_OnClick()
	
	'20240604 SWJ START
	'Form.MsgBox("안내", "2024년 7월 4일 서비스 종료 예정으로\n서비스 신청 및 재등록이 불가합니다.", "ProcessEnd", 0)
	
	if ChkPush() == False or  ChkPush() == "0" or  ChkPush() == 0 Then
		exit Sub
	end if
	
	g_Service = "JOIN"
		
'	간편인증 로그인 신청 시.	
	If Form.GetSharedData("&CERT_USE_TYPE", 0) == "1" Then
		If g_bCheck == True or g_bCheck == "1" Then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_312r" , "InBlock1" , "CSNO" , 0 , g_spad_sCusNo)
			DATAMANAGER.RequestTranData( "obpds_srvc_312r" )
		Else
			Form.OpenFramePopup( G_OCSP , "" , "" )
		End If
	Else
		Form.OpenFramePopup( G_OCSP , "" , "" )	
	End If
	'20240604 SWJ END
	
End Sub

'간편인증 비밀번호 변경
'============================================================================
Sub Image4_OnClick()
	if ChkPush() == False or  ChkPush() == "0" or  ChkPush() == 0 Then
		exit Sub
	end if

	g_Service = "Change"
	sParam = g_spad_sID
	Form.requestOneShotPad("reqCheckJoin", sParam, "")				
	
End Sub

'간편인증 해지
'============================================================================
Sub Image5_OnClick()
	if ChkPush() == False or  ChkPush() == "0" or  ChkPush() == 0 Then
		exit Sub
	end if

	g_Service = "Cancel"

	sParam = g_spad_sID
	Form.requestOneShotPad("reqCheckJoin", sParam, "")				
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'이용안내를 통한 간편인증 서비스 신청
	If sKeyName == "JOIN" Then
		g_Service = "JOIN"
		Call Image2_OnClick()
	End If
	
	'인증서 검증(OCSP)
	If sKeyName == "mhetc90060_p5" Then	
		If Left(Trim(sRet), 2) == "ok" Then
			'20161101 NOHES START ">"빠짐 대응
			sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1 )
			if sCertPass <> null and sCertPass <> "" then
				g_spad_sCertPswd = sCertPass
			else	
				g_spad_sCertPswd = Mid(Trim(sRet), 4, Len(Trim(sRet))-1)
			end if
			'20161101 NOHES END
			Form.OpenFramePopup(G_ADDPOPUP ,  "spinpad_enroll★"&g_Service , "")
		End If 
	End If
	
	'추가인증
	If sKeyName == "mhetc90060_p8" Then
		If Left(Trim(sRet), 2) == "ok" Then
			If g_Service == "JOIN" Then
				DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r" , "InBlock1" , "INPUT_CLS" , 0 , "1")
				DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r" , "InBlock1" , "ELFN_ID" , 0 , g_spad_sID)
				DATAMANAGER.RequestTranData( "obcsb_oimf_520r" )
			ElseIf g_Service == "AddID" Then
				DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r" , "InBlock1" , "INPUT_CLS" , 0 , "1")
				DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r" , "InBlock1" , "ELFN_ID" , 0 , g_spad_AddsID)
				DATAMANAGER.RequestTranData( "obcsb_oimf_520r" )
			Else
				Call OneShotApi(g_Service)
			End If
		End If
	End If
	
	'추가ID 등록
	If sKeyName == "mhetc90070_p2" Then
		g_Service = "JOIN"
		
		sData = Split(sRet, "★")
		if #sData > 1 then
			sID = sData[0]
			sEvent = sData[1]	
		end if

		'기존ID 서비스 재설정
		If sEvent = "재등록" Then
			g_bAdd = False	
			Form.OpenFramePopup( G_OCSP , "" , "" )
			
		'추가ID 서비스 신청
		ElseIf sEvent = "추가신청" Then
			g_Service = "AddID"		
			g_bAdd = True	
			g_spad_AddsID = sID
			Form.OpenFramePopup( G_OCSP , "" , "" )
		End If
	End If
	
	'ID 비밀번호 등록
	If sKeyName == "90070_p3" Then
		Form.OpenFramePopup(G_ADDPOPUP ,  "spinpad_enroll★"&g_Service , "")	
	End If
	
	'보안매체 검증
	If sKeyName == G_CERT_SECURITY_FILE or sKeyName == G_CERT_QUESTION_FILE or 
			sKeyName == G_CERT_OTP_FILE or sKeyName == G_CERT_MOTP_FILE then  '20210216 SWJ START : 모바일OTP 인증매체 추가
		if sRet == "ok" then
			Call OneShotApi(g_Service)
		end if
	End If
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
	
End Sub


'SPinpad api 요청
'============================================================================
Function OneShotApi(s_Service)

	Select Case s_Service

	'간편인증 서비스 등록
	Case "JOIN"
		'SPinpad 인증토큰 
		DATAMANAGER.SetDataValue( 0, "obcpp_spin_001a", "InBlock1", "CSNO", 0 , g_spad_sCusNo )
		DATAMANAGER.SetDataValue( 0, "obcpp_spin_001a", "InBlock1", "ELFN_ID", 0 , g_spad_sID ) 
		DATAMANAGER.SetDataValue( 0, "obcpp_spin_001a", "InBlock1", "APP_TYPE_NO", 0, "1") '1.MTS
		DATAMANAGER.RequestTranData("obcpp_spin_001a")	

'##################### test용으로 인증토큰 가져온 함수 ############################
		'[요청타입]`[고객번호]
'		sParam = "1" & "★" & g_spad_sCusNo '가입 시 요청타입 -> 1		
'		Form.requestOneShotPad("reqSpEncKey", sParam, "")
'##################################################################################

	'간편인증 비밀번호변경요청(ID+인증서로그인 후가능)	
	Case "Change"
		'[요청타입]★[고객ID]★[인증서시리얼번호]★[고객번호]
		'요청타입 => 2.로그인 3.이체 4.비밀번호변경 5.해지
		sParam = "4" & "★" & g_spad_sID & "★" & g_spad_sCertSerialNo& "★" & g_spad_sCusNo
		Form.requestOneShotPad("reqPush", sParam, "")	
		
	'간편인증 서비스 해지
	Case "Cancel"
		sParam = "5" & "★" & g_spad_sID & "★" & g_spad_sCertSerialNo& "★" & g_spad_sCusNo
		
		Form.requestOneShotPad("reqPush", sParam, "")		
		
	'추가ID 등록	
	Case "AddID"
		'[요청타입]★[고객ID]★[인증서시리얼번호]★[추가ID]
		sParam = "7" & "★" & g_spad_sID & "★" & g_spad_sCertSerialNo& "★" &g_spad_AddsID
		Form.requestOneShotPad("reqPush", sParam, "")	
	
	End Select

End Function

'============================================================================
' 간편인증 응답용 TriggerEventSpin (IOS_임시)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'20240604 SWJ START
	if sEventName == "mhetc90021_p8" then
		if sParam == "register" then
			Form.OpenNextPopup("mhetc90190_s1","","")
		end if
	end if
	'20240604 SWJ END
	
	'20161213 NOHES START : IOS 임시
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	
	if s_OSTYPE == "2" Then
		if Left(sEventName,4) == "Bio_" Then
			return
		end if
	end if
	
	Call Form_OnTriggerEventSpin(sEventName, sParam)
	return
	'20161213 NOHES END
End Sub


'============================================================================
' 간편인증 응답용 TriggerEventSpin
'============================================================================
Sub Form_OnTriggerEventSpin(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	if #sRet > 1 then
		sErrorCode = sRet[0]
		sErrorMsg = sRet[1]	
	end if
	
	if g_OSTYPE == "2" And sErrorCode == "1300" Then
		ShowAlert "알림", "고객님 단말기의 PUSH 알림이 허용되지 않았습니다.\n"&
				"단말기의 “설정→알림→메리츠 SMART” 알림을 허용하신 후, 간편인증 서비스를 이용해주시기 바랍니다."
		return 		
	end if
	
'##################### test용으로 인증토큰 가져온 함수 ############################
	'인증토큰,암호키 획득 : 추후 기간계서비스call로 변경되는 부분
'	if sEventName == "reqSpEncKey" then
'		if #sRet > 3 then
'			g_spad_sAuthToken = sRet[2]
'			g_spad_sSpEncKey = sRet[3]	
'		end if
'		
'		Call ReqOneShotPad()
'	end if
'##################################################################################
	
	Dim sOutput
	
	Select Case sEventName 
	'spinpad 가입여부 확인
	Case "reqCheckJoin"	
		if g_nChange == 1 Then
			g_nChange = 0
			Form.MsgBox( "알림", sErrorMsg, "", 0)
		End if
		
		If sErrorCode == "3001" or 	 sErrorCode == "3000" 	Then		'가입된 사용자
			Container0.Table2.SetCellString(0,1, "사용 중")
			g_bCheck = True
			
			if g_Service == "Change" Then
				Form.OpenFramePopup( G_OCSP , "" , "")
			'	Form.OpenFramePopup(G_ADDPOPUP , "spinpad_enroll★"&g_Service , "")
			elseif g_Service == "Cancel" Then
				Call OneShotApi(g_Service)
			end if

		else
			if g_bCheck == False then
				if g_Service == "Cancel" or g_Service == "Change" Then
					Form.MsgBox( "알림", sErrorMsg, "", 0)
				end if
			end if
			Container0.Table2.SetCellString(0,1, "미사용")
			
			g_bCheck = False
			
		End If
	
	'spinpad 서비스 신청
	Case "reqJoin" 
		If sErrorCode == "0000" Then
			sParam = g_spad_sID
			DrawOutput("ok")
			Form.requestOneShotPad("reqCheckJoin", sParam, "")	
			DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "INPUT_CLS"	 , 0 , "1")
			DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "ELFN_ID"	 , 0 , g_spad_sID)
			DATAMANAGER.RequestTranData("obcsb_spin_001a")
			
		Else	
			Form.MsgBox( "알림", sErrorMsg, "", 0)
		End If
		
	
	'spinpad 인증용 푸쉬 요청
	Case "reqPush"
		If sErrorCode <> "0000" Then
			Form.MsgBox( "알림", sErrorMsg, "", 0)
		End If
		
	'비밀번호 인증 요청	
	Case "reqAuthPinPad"
		If  sErrorCode == "0000" Then			
			If g_Service == "Cancel" Then
				sParam = g_spad_sID
				DrawOutput("ok")
				Form.requestOneShotPad("reqCheckJoin", sParam, "")
				DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "INPUT_CLS"	 , 0 , "2")
				DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "ELFN_ID"	 , 0 , g_spad_sID)
				DATAMANAGER.RequestTranData("obcsb_spin_001a")
				
			End If
			If g_Service == "AddID" Then
				DrawOutput("ok")
				DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "INPUT_CLS"	 , 0 , "4")
				DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "ELFN_ID"	 , 0 , g_spad_AddsID)
				DATAMANAGER.RequestTranData("obcsb_spin_001a")
				
			End If
			
		Else
			If sErrorCode == "2005" Then	'비밀번호 오류
				If #sRet> 2 Then
					sPassFailCnt = sRet[2]
					if CInt(sPassFailCnt) >= 5 Then
						ShowAlert "알림", "간편인증 비밀번호 " &sPassFailCnt&"회 오류입니다.\n\n연속 5회 오류 시 간편인증 접속이 제한됩니다."	
					
						DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "INPUT_CLS"	 , 0 , "3")
						DATAMANAGER.SetDataValue(0, "obcsb_spin_001a" , "InBlock1" , "ELFN_ID"	 , 0 , g_spad_sID)
						DATAMANAGER.RequestTranData("obcsb_spin_001a")
					else
						Form.MsgBox "알림", "간편인증 비밀번호 " &sPassFailCnt&"회 오류입니다.\n\n연속 5회 오류 시 간편인증 접속이 제한됩니다." , "Fault", 	0
					End If
				End If
				
			End If
			
		End If
	
	'비밀번호 변경 요청
	Case "reqChangePwd"
		If  sErrorCode == "0000" Then
			DrawOutput("ok")	
		else
			DrawOutput("err")
		end if
			
	End Select

End Sub


'============================================================================
Sub DrawOutput(sOutput)
	If sOutput <> "ok" Then
		if g_Service == "AddID" Then
			ShowAlert "알림", "추가ID를 신청할 수 없습니다."
			Exit Sub
		End if
	End If
	
	Dim sMsg, sSubMsg
	Select Case g_Service
	Case "JOIN"
		 sMsg = "간편인증 서비스 신청이 완료되었습니다.\n"
		 sSubMsg = "(신청하신 서비스는 재로그인시부터 적용됩니다.)"
		 ShowAlert "알림", sMsg&sSubMsg
	Case "Change"
		sMsg = "간편인증 비밀번호가 변경되었습니다."
		ShowAlert "알림", sMsg
	Case "Cancel"
		sMsg = "간편인증 서비스가 해지되었습니다."
			
		Dim sLOGIN_TYPE  '
		sLOGIN_TYPE = Form.GetSharedData("&CERT_USE_TYPE",  false )
		if sLOGIN_TYPE == "1" then '로그인상태
			Dim sText
			sText = "\n간편인증 서비스 해지 후, 재로그인하셔야 합니다. 로그아웃을 진행합니다."	
			Form.MsgBox( "로그인 안내", sMsg&sText, "LOGOUT_MSG", 0 )
		else
			ShowAlert "알림", sMsg
		end if	
	Case "AddID"
		sMsg = "추가 ID 신청을 완료하였습니다.\n"
		sSubMsg =  "해당 기기에서 ["& g_spad_AddsID & "]로도 간편인증 서비스를 이용하실 수 있습니다."
		ShowAlert "알림", sMsg&sSubMsg
	End Select

End Sub
'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'sPinPad 인증토큰 정보 제공
	If szTranID == "obcpp_spin_001a" Then
		g_spad_sAuthToken	= DATAMANAGER.GetDataValue(0, "obcpp_spin_001a" , "OutBlock1" , "ATHN_TOKEN" , 0)
		g_spad_sSpEncKey	= DATAMANAGER.GetDataValue(0, "obcpp_spin_001a" , "OutBlock1", "SP_CPHR_KEY" , 0)
		
		Call ReqOneShotPad()
	
	'고객번호 조회
	ElseIf szTranID == "obcsb_info_004r" Then
		g_spad_sCusNo = DATAMANAGER.GetDataValue( 0, "obcsb_info_004r", "OutBlock1", "CSNO", 0)
		DATAMANAGER.SetDataValue(0, "obcsb_padc_004r" , "InBlock1" , "ELFN_ID" , 0 , g_spad_sID)
		DATAMANAGER.RequestTranData( "obcsb_padc_004r" )
	
	'인증서 시리얼키값 제공
	ElseIf szTranID == "obcsb_padc_004r" Then
		g_spad_sCertSerialNo = DATAMANAGER.GetDataValue(0, "obcsb_padc_004r" , "OutBlock1" , "NTAT_SRNO" , 0)
		
		'spinpad 상태 체크	
		sParam = g_spad_sID
		Form.requestOneShotPad("reqCheckJoin", sParam, "")
		
	'전자금융 ID 조회(추가ID 등록 여부)
	ElseIf szTranID == "obpds_srvc_312r" Then
		If DATAMANAGER.GetDataCount(0, "obpds_srvc_312r" ,"OutBlock1" ) > 1 Then
			g_spad_AddsID = ""
			Form.OpenPopup("mhetc90070_p2" , g_spad_sCusNo& "★" & g_spad_sID , "")
		Else
			Form.OpenFramePopup( G_OCSP , "" , "" )
		End If
	ElseIf szTranID == "obacp_comm_004r" Then
		
		'20201116 SWJ START : 실명확인번호 암호화(RCNO > RCNO_PIP 로 변경)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then '고유MTS 미적용	
			sRCNO = DATAMANAGER.GetDataValue(0, "obacp_comm_004r" , "OutBlock1" , "RCNO" , 0)
		else		
			sRCNO = DATAMANAGER.GetDataValue(0, "obacp_comm_004r" , "OutBlock1" , "RCNO_PIP" , 0)
		end if
		'20201116 SWJ END
		
		sTELNO = DATAMANAGER.GetDataValue(0, "obacp_comm_004r" , "OutBlock1" , "OWHS_TELNO" , 0)
		sWRPLNO = DATAMANAGER.GetDataValue(0, "obacp_comm_004r" , "OutBlock1" , "WRPL_WHOL_TELNO" , 0)
		sCLPHNO = DATAMANAGER.GetDataValue(0, "obacp_comm_004r" , "OutBlock1" , "CLPH_TELNO" , 0)
		
		sParam = sRCNO & "★" & sTELNO & "★" & sWRPLNO & "★" & sCLPHNO
		
		Form.requestOneShotPad("setPswdRule", sParam, "")
	'보안매체종류 조회
	ElseIf szTranID == "obcsb_oimf_520r" then	
		Dim sResult
		'0: 보안카드 / 1: 부가정보 / 2: otp,보안카드,부가정보 없음 / 3: otp / 9: 기타오류
		sResult = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0)
		
		'20210216 SWJ START : 모바일OTP 매체 구분값 수신
		UI_SMRT_OTP_YN = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0)
		'20210216 SWJ END
		
		'보안카드, 부가정보, OTP
		if sResult == "0" or sResult == "1" or sResult == "3" then
			Call MoveNextPage(sResult)		'다음 페이지로
		elseif sResult == "2" then 
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
		else 
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if		
	End If
End Sub

'============================================================================
Sub MoveNextPage(sGubn)
	Dim g_sPopupFileName
	if sGubn == "0" then			'보안카드
		Form.OpenFramePopup( G_CERT_SECURITY_FILE , "" , "")
	elseif sGubn == "1" then		'부가정보
		Form.OpenFramePopup( G_CERT_QUESTION_FILE , "" , "")
	elseif sGubn == "3" then
		
		'20210216 SWJ START : 모바일 OTP 인증매체 추가
		if UI_SMRT_OTP_YN == "M" then
			Form.OpenPopup( G_CERT_MOTP_FILE , "motp_success" , "")	'MOTP
		else
			Form.OpenFramePopup( G_CERT_OTP_FILE , "" , "")	'OTP
		end if
		'20210216 SWJ END
		
	elseif sGubn == "2" then '없을경우
		'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
		RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
	else '에러
		Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
	end if
		
End Sub


'============================================================================
Sub ReqOneShotPad()
	if g_spad_sAuthToken == "" or g_spad_sAuthToken == null then
		Form.MsgBox( "알림", "인증토큰값이 필요합니다.", "", 0 )
		Exit Sub
	end if

	if g_spad_sSpEncKey == "" or g_spad_sSpEncKey == null then
		Form.MsgBox( "알림", "SP암호화키가 필요합니다.", "", 0 )
		Exit Sub
	end if
	'[고객ID]★[고객번호]★[인증서시리얼번호]★[인증서비밀번호]
	sParam = g_spad_sID & "★" & g_spad_sCusNo & "★" & g_spad_sCertSerialNo & "★" & g_spad_sCertPswd
	
	'[인증토큰]★[SP암호키]
	sParam2 = g_spad_sAuthToken & "★" & g_spad_sSpEncKey
	Form.requestOneShotPad("reqJoin", sParam, sParam2)
	
	g_spad_sAuthToken = ""
	g_spad_sSpEncKey = ""
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	ShowAlert "알림", szErrMsg & " (TR" & szErrCode & " "& sSubmsg & ")"
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "LOGOUT_MSG" Then
		Form.LogOut(0, 1)
		g_bCancelLogout = True
		Form.CloseForm()
	ElseIf sKeyName == "Fault" Then
		Call OneShotApi(g_Service)
	'20161108 NOHES START : BIO인증 로그인 시 ID 로그인 유도
	ElseIf sKeyName == "FIDO_RETURN" Then
		'20170526 NOHES START : IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_OSTYPE == "2" Then
			if sRet == "ok" then
				Form.CloseForm()
				Form.OpenScreen("41000", "")
				Form.OpenPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()
				Form.OpenScreen("41000", "")
			end if		
		else
			if sRet == "ok" then
				Form.CloseForm()
				Form.openPrevScreen()
				Form.OpenScreen("90020", "90070") '20180911_01 KBC : 바이오인증 인증방식 추가
			else
				Form.CloseForm()
				Form.openPrevScreen()			
			end if
		end if
		'20170526 NOHES END
	End if
	'20161108 NOHES END

End Sub


