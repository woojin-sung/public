	<SCRIPT_INFO _len="1696" _ulen="1616" >
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"


'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" And szOpenData <> null Then
		
		
		arrData = Split(szOpenData, "`")
		
		for i = 0 to 17
			Table0.SetCellString(i, 1, arrData(i))
		next
		
		Table0.setPropTable("fontstyle", 7, 1, "01")
		Table0.setPropTable("fontstyle", 9, 1, "01")
		
		if arrData(11) <> "-" then
			Table0.setPropTable("fontstyle", 11, 1, "01")
		end if
		
		if arrData(13) <> "-" then
			Table0.setPropTable("fontstyle", 13, 1, "01")
		end if
		
		if arrData(14) <> "-" then
			Table0.setPropTable("fontstyle", 14, 1, "01")
			
			if arrData(4) == "외화매도" then
				Table0.SetCellFgColor(14, 1, g_szTxtColor_Blue)
			end if
		end if
		
		if arrData(15) <> "-" then
			Table0.setPropTable("fontstyle", 15, 1, "01")
			
			if arrData(4) == "외화매수" then
				Table0.SetCellFgColor(15, 1, g_szTxtColor_Red)
			end if
		end if
	else
		Exit Sub
	end if
	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

