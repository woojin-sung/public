End Sub
Sub ClearAllData()
	tblState.SetCellString( 0, 1, "" )
	
	RadioGroup0.currentindex = -1
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szTranID == "obacp_opop_066r" then
		Call ClearAllData()
		RadioGroup0.SetRadioCaption(-1)
		
		edtPassword.caption = ""	
		'Form.MsgBox( "알림", szErrMsg, "", 6 )
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
	elseif szTranID == "obpds_srvc_173a" then
		Form.MsgBox("알림", szErrMsg, "", 0)
	end if
	
	if szTranID == "obpds_srvc_173a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
	
End Sub
