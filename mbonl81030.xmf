	<SCRIPT_INFO _len="13664" _ulen="12540" >
'============================================================================
' 01. 화 면 명 : 공인인증서 발급시 온라인신원확인 동의
' 02. 화면설명 : 공인인증서 발급시 온라인신원확인 동의
' 03. 작    성 : 2016.09.13 윤유정
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2020.11.13 : 정민영 : v0002 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obacp_opop_064r IO 변경분 반영
'            : 정민영 : v0003 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserCode	'고객번호
Dim g_szProsClsCode	'불원여부
Dim g_nAccountNumber	'계좌번호
Dim g_nPassword		'계좌비밀번호
Dim g_szChangeState	'변경상태
Dim g_szSkey
Dim g_sNowStat		'조회시 상태
Dim g_sSctStat		'선택한 상태
Dim g_plain_rm  		'v0001 메모리평문적용여부
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	g_szChangeState = "cancel"
	g_nAccountNumber = cmbAccount.total
	'g_nPassword = Form.GetEncData(edtPassword.caption)
	
	Form.SetScreenName("인증서온라인 신원확인 동의")  'v0003 메뉴명강제설정
End Sub

'============================================================================
' edtPassword_OnEditComplete
'============================================================================
Sub edtPassword_OnEditComplete()
	if edtPassword.caption ~= null and edtPassword.caption ~= "" then
		'DATAMANAGER.RequestTranData( "obacp_opop_068r" ) '비밀번호검증
		DATAMANAGER.RequestTranData( "obacp_opop_066r" ) '비밀번호검증
	end if
End Sub

'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_nAccountNumber = cmbAccount.total
	edtPassword.caption = ""
	'g_nPassword = Form.GetEncData(edtPassword.caption)
End Sub

'============================================================================
' btnSearch_OnClick - 조회버튼 obacp_opop_064r tr요청
'============================================================================
Sub btnSearch_OnClick()
	TR_Inquiry("obacp_opop_064r")
End Sub

'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)

	if szTranID == "obacp_opop_064r" then	'종합계좌기준계좌컨트롤조회
		DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obacp_opop_064r")	
	elseif szTranID == "obpds_srvc_173a" then	'서비스약정메인tr
		DATAMANAGER.SetDataValue(0,"obpds_srvc_173a", "InBlock1", "ACNO" , 0 , g_nAccountNumber)	'계좌번호
		'v0001
		if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
			DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)	'계좌비밀번호
		else  'MTS메모리평문 미적용상태일때
			DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(edtPassword.caption))	'계좌비밀번호
		end if		
		DATAMANAGER.RequestTranData("obpds_srvc_173a")
	elseif szTranID == "obpds_srvc_173r" then	'hts/wts용 서비스 내역 조회
		DATAMANAGER.SetDataValue(0, "obpds_srvc_173r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obpds_srvc_173r")
	end if
	
End Function

'**************************************************************************** 
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	Dim sACNT_PWD
	'v0001
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    sACNT_PWD = edtPassword.caption
	else  'MTS메모리평문 미적용상태일때
		sACNT_PWD = Form.GetEncData(edtPassword.caption)
	end if

	if szTranID == "obacp_opop_066r" then
		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ACNO" , 0 , g_nAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obpds_srvc_173a" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "PROS_CLS_CODE" , 0 , g_szProsClsCode)	'처리구분코드, 불원여부
		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "CSNO" , 0 , g_szUserCode)		'고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "SVCD" , 0 , "073")			'서비스 코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "SVC_SRNO", 0 , edtSrno.caption)	'서비스 일련번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_173a", "InBlock1", "SVC_MANG_UNIT_CODE", 0 , "01")	'서비스 관리 단위코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_173a", "InBlock1", "ELFN_ID", 0 , Form.GetSharedData("&USER_ID" , false))		'HTS ID
		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "CONT_CLS_CODE" , 0 , "4")		'접촉 구분코드
		if RadioGroup0.currentindex == "0" then '동의
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "AGRM_YN" , 0 , "Y" )
		elseif RadioGroup0.currentindex == "1" then '미동의
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "AGRM_YN" , 0 , "N" )
		end if
		
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_066r" then
		'SetRequestData()
		btnSearch_OnClick()
	elseif szTranID == "obacp_opop_064r" then
		g_szUserCode = DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		TR_Inquiry("obpds_srvc_173r")
	end if
	
	if szTranID == "obpds_srvc_173r" then
		edtSrno.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_173r", "OutBlock1", "SVC_SRNO" , 0)
		
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_173r", "OutBlock2", "CSNO" , 0) = "" then 
			g_sNowStat = ""
		end if
		
'		if DATAMANAGER.GetDataValue(0, "obpds_srvc_173r", "OutBlock2", "CSNO" , 0) <> "" then 
			if DATAMANAGER.GetDataValue(0, "obpds_srvc_173r", "OutBlock1", "AGRM_YN" , 0) <> "" then 
				g_szProsClsCode = "U"
				Button0.caption = "변경"
				if DATAMANAGER.GetDataValue(0, "obpds_srvc_173r", "OutBlock1", "AGRM_YN" , 0) == "N" then
					tblState.SetCellString( 0, 1, "미동의" )
					RadioGroup0.currentindex = 1
					g_sNowStat = "1"
				elseif DATAMANAGER.GetDataValue(0, "obpds_srvc_173r", "OutBlock1", "AGRM_YN" , 0) == "Y" then
					tblState.SetCellString( 0, 1, "동의" )
					RadioGroup0.currentindex = 0
					g_sNowStat = "0"
				end if	
			 else
				g_szProsClsCode = "I" 
				Button0.caption = "등록"
				tblState.SetCellString( 0, 1, "미선택" )
				RadioGroup0.currentindex = -1
			 end if 
'		else 
'			g_sNowStat = ""
'		end if
	end if
	
	if szTranID == "obpds_srvc_173a" then
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_173a", "OutBlock1", "SVC_SRNO" , 0) then '<> "" AND g_szYoN = "I" then
			if g_szProsClsCode = "I" Then
				Form.MsgBox("알림", "인증서 신원확인 사전동의 처리완료.", "", 0)    
			elseif g_szProsClsCode = "U" Then
				Form.MsgBox("알림", "사전미동의 처리완료.", "", 0)    
			end if
			
		end if
		
		TR_Inquiry("obpds_srvc_173r")

		g_szChangeState = "ok"
	
	end if
	
End Sub

'============================================================================
Sub Button0_OnClick()
	if Trim(g_nPassword <> "" and edtPassword.caption) <> "" then 

		if RadioGroup0.currentindex == "0" or RadioGroup0.currentindex == "1" then
		
			if g_sNowStat = RadioGroup0.currentindex then
				Form.MsgBox("알림", "변경할 내역이 없습니다.", "", 0) 
				Exit Sub
			else
				if g_szProsClsCode = "U" and RadioGroup0.currentindex == "0" then
					Form.MsgBox("알림", "미동의>동의로의 변경은 별도의 절차를 통해서만 가능합니다.\n (미동의>동의 변경절차 안내 참조)", "", 0) 
					TR_Inquiry("obpds_srvc_173r")
					Exit Sub
				elseif RadioGroup0.currentindex == "1" then
					Form.OpenPopup("mbonl81030_p1","","")
				else
					call SendReg()
				end if 
			end if
			
		else
			Form.MsgBox("알림", "동의여부를 선택하세요.", "", 0) 
			Exit Sub
		end if
	else
		Form.MsgBox("알림", "비밀번호를 입력해 주세요.", "", 0)
	end if
		'TR_Inquiry("obpds_srvc_173r") 
End Sub
'============================================================================
' SendReg
'============================================================================
Function SendReg()
	Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)
End Function 

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) : 공인인증 확인후 처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	Dim szTempData
	szTempData = Split(sRet, ";")
	
	if sKeyName = "1" then 				'미동의 선택시 경고
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "PROS_CLS_CODE" , 0 , g_szProsClsCode)	'처리구분코드, 불원여부
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_173a", "InBlock1", "CSNO" , 0 , g_szUserCode)		'고객번호
