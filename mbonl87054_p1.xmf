	<SCRIPT_INFO _len="4396" _ulen="4156" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 위탁증거금 등급 변경
' 02. 화면설명 : 위탁증거금 등급 변경
' 03. 작    성 : 김효준
' 04. 수    정 : 2021.01.18 : 김효준 : v001: 신규 ( [7457]해외주식 거래신청 > 고객 영문명 등록/변경 - mbonl87051_p1 참조)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_Acno
Dim	g_AcntPwd

Dim g_MargGradCode
    g_MargGradCode   = "" '증거금등급코드
    
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_Acno    = Form.GetSharedData("87054_ACNO", false)
	g_Asno    = Form.GetSharedData("87054_ASNO", false)
	g_AcntPwd = Form.GetSharedData("87054_ACNT_PWD", false)
	
	DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ACNO" , 0 , g_Acno)	
	DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ASNO" , 0 , g_Asno)	
	DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ACNT_PWD" , 0 , g_AcntPwd)
	DATAMANAGER.RequestTranData("obacp_comm_008r")
	
End Sub
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("NewGradCode", "Cancle")  
	Form.CloseForm()
End Sub
'============================================================================
Sub btnModify_OnClick()
	If Trim(g_MargGradCode) <> "4" Then
		DATAMANAGER.ClearInputData(0, "obaci_acct_029a")
		
		DATAMANAGER.SetDataValue(0,"obaci_acct_029a", "InBlock1", "CONT_CLS_CODE"  , 0 , "4")	'4.온라인
		DATAMANAGER.SetDataValue(0,"obaci_acct_029a", "InBlock1", "ACNO"           , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obaci_acct_029a", "InBlock1", "ASNO"           , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obaci_acct_029a", "InBlock1", "ACNT_PWD"       , 0 , g_AcntPwd)
		DATAMANAGER.SetDataValue(0,"obaci_acct_029a", "InBlock1", "MARG_GRAD_CODE" , 0 , "4") '4.100%징수(수수료포함)
		
		DATAMANAGER.RequestTranData("obaci_acct_029a")
	Else
		Form.ShowAlert( "알림" , "변경할 등급을 확인해주세요.")
		Exit Sub
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obaci_acct_029a" Then
		Form.SendReturnToParent("NewGradCode", "Ok")  
		Form.CloseForm()
		
	ElseIf szTranID == "obacp_comm_008r" Then 
		g_MargGradCode = DATAMANAGER.GetDataValue(0, "obacp_comm_008r", "OutBlock1", "MARG_GRAD_CODE" , 0)
		
		If Trim(g_MargGradCode) = "4" Then
			btnModify.enable 	= False
		Else
			btnModify.enable 	= True
		End If
		
		If Trim(g_MargGradCode) = "1" Then
			Edit1.caption = "40%징수"
		ElseIf Trim(g_MargGradCode) = "3" Then
			Edit1.caption = "100%징수(수수료미포함)"
		ElseIf Trim(g_MargGradCode) = "4" Then
			Edit1.caption = "100%징수(수수료포함)"
		ElseIf Trim(g_MargGradCode) = "6" Then
			Edit1.caption = "기본(종목별차등)"
		ElseIf Trim(g_MargGradCode) = "6" Then
			Edit1.caption = "특별증거금(우대)"
		End If
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "obaci_acct_029a" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Exit Sub
	End If
End Sub 

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ACNO" , 0 , g_Acno)	
	DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ASNO" , 0 , g_Asno)	
	DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ACNT_PWD" , 0 , g_AcntPwd)
	DATAMANAGER.RequestTranData("obacp_comm_008r")	
End Sub

