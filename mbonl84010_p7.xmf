'============================================================================
Sub Form_OnFormInit()
	'온라인 계좌개설 후 가입신청 화면으로 바로 링크시 계좌재조회
	Form.RequestCommand("RE_ACCT_LIST", "", "")
End Sub

'============================================================================
Sub ImageClose_OnClick()
	Form.SendReturnToParent( "mbonl84010_p7" , "cancel" )
	Form.CloseForm()
End Sub

'============================================================================
'ISA가입신청
Sub btnJoin_OnClick()
	Form.OpenScreen("56060" , "")	
	Form.CloseForm()
End Sub

'============================================================================
'닫기
Sub btnClose_OnClick()
	Form.SendReturnToParent( "mbonl84010_p7" , "ok" )
	Form.CloseForm()
End Sub

