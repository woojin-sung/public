'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
Function User_Chk_Image_Set(trgt, chk)
	'Tel.홍보전화(contSlctPblt.imgTel)
	if trgt == "Tel" then
		if chk == "Y" then
			Container5.imgTel.imgpath = "check_on.png"
		else
			Container5.imgTel.imgpath = "check_off.png"
		end if
	'SMS.홍보문자(contSlctPblt.imgSMS)
	elseif trgt == "SMS" then
		if chk == "Y" then
			Container5.imgSMS.imgpath = "check_on.png"
		else
			Container5.imgSMS.imgpath = "check_off.png"
		end if
	'Email.홍보이메일(contSlctPblt.imgEmail)
	elseif trgt == "Email" then
		if chk == "Y" then
			Container5.imgEmail.imgpath = "check_on.png"
		else
			Container5.imgEmail.imgpath = "check_off.png"
		end if
	'Post.홍보우편(contSlctPblt.imgTel)
	elseif trgt == "Post" then
		if chk == "Y" then
			Container5.imgPost.imgpath = "check_on.png"
		else
			Container5.imgPost.imgpath = "check_off.png"
		end if
	
'v0006	
	'수집이용_고유식별
'	elseif trgt == "11Y" then
'		If g_BDM_Slct_1_1 == "Y" Then
'		    g_BDM_Slct_1_1 = ""
'		    Container1.img1y.imgpath = "check_off.png"
'		    Container1.img1n.imgpath = "check_off.png"
'		ElseIf g_BDM_Slct_1_1 == "N" Then
'		    g_BDM_Slct_1_1 = "Y"
'		    Container1.img1y.imgpath = "check_on.png"
'		    Container1.img1n.imgpath = "check_off.png"
'		Else		
'		    g_BDM_Slct_1_1 = "Y"
'		    Container1.img1y.imgpath = "check_on.png"
'		    Container1.img1n.imgpath = "check_off.png"
'		End If
'	elseif trgt == "11N" then
'		If g_BDM_Slct_1_1 == "Y" Then
'		    g_BDM_Slct_1_1 = "N"
'		    Container1.img1y.imgpath = "check_off.png"
'		    Container1.img1n.imgpath = "check_on.png"
'		ElseIf g_BDM_Slct_1_1 == "N" Then
'		    g_BDM_Slct_1_1 = ""
'		    Container1.img1y.imgpath = "check_off.png"
'		    Container1.img1n.imgpath = "check_off.png"
'		Else		
'		    g_BDM_Slct_1_1 = "N"
'		    Container1.img1y.imgpath = "check_off.png"
'		    Container1.img1n.imgpath = "check_on.png"
'		End If

	'수집이용_개인신용
	elseif trgt == "12Y" then
		If g_BDM_Slct_1_2 == "Y" Then
		    g_BDM_Slct_1_2 = ""
		    Container1.img2y.imgpath = "check_off.png"
		    Container1.img2n.imgpath = "check_off.png"
		ElseIf g_BDM_Slct_1_2 == "N" Then
		    g_BDM_Slct_1_2 = "Y"
		    Container1.img2y.imgpath = "check_on.png"
		    Container1.img2n.imgpath = "check_off.png"
		Else		
		    g_BDM_Slct_1_2 = "Y"
		    Container1.img2y.imgpath = "check_on.png"
		    Container1.img2n.imgpath = "check_off.png"
		End If
	elseif trgt == "12N" then
		If g_BDM_Slct_1_2 == "Y" Then
		    g_BDM_Slct_1_2 = "N"
		    Container1.img2y.imgpath = "check_off.png"
		    Container1.img2n.imgpath = "check_on.png"
		ElseIf g_BDM_Slct_1_2 == "N" Then
		    g_BDM_Slct_1_2 = ""
		    Container1.img2y.imgpath = "check_off.png"
		    Container1.img2n.imgpath = "check_off.png"
		Else		
		    g_BDM_Slct_1_2 = "N"
		    Container1.img2y.imgpath = "check_off.png"
		    Container1.img2n.imgpath = "check_on.png"
		End If
		
	'상품서비스안내
	elseif trgt == "21Y" then
		If g_BDM_Slct_2_1 == "Y" Then
		    g_BDM_Slct_2_1 = ""
		    Container3.img1y.imgpath = "check_off.png"
		    Container3.img1n.imgpath = "check_off.png"
		ElseIf g_BDM_Slct_2_1 == "N" Then
		    g_BDM_Slct_2_1 = "Y"
		    Container3.img1y.imgpath = "check_on.png"
		    Container3.img1n.imgpath = "check_off.png"
		Else		
		    g_BDM_Slct_2_1 = "Y"
		    Container3.img1y.imgpath = "check_on.png"
		    Container3.img1n.imgpath = "check_off.png"
		End If
	elseif trgt == "21N" then
		If g_BDM_Slct_2_1 == "Y" Then
		    g_BDM_Slct_2_1 = "N"
		    Container3.img1y.imgpath = "check_off.png"
		    Container3.img1n.imgpath = "check_on.png"
		ElseIf g_BDM_Slct_2_1 == "N" Then
		    g_BDM_Slct_2_1 = ""
		    Container3.img1y.imgpath = "check_off.png"
		    Container3.img1n.imgpath = "check_off.png"
		Else		
		    g_BDM_Slct_2_1 = "N"
		    Container3.img1y.imgpath = "check_off.png"
		    Container3.img1n.imgpath = "check_on.png"
		End If
	
	end If
End Function 
'============================================================================
Function User_Chk_OK(trgt, chk)
	'Y/N 설정
	if trgt == "Tel" then
		g_BDM_SlctTel		= chk
	elseif trgt == "SMS" then
		g_BDM_SlctSMS		= chk
	elseif trgt == "Email" then
		g_BDM_SlctEmail	= chk
	elseif trgt == "Post" then
		g_BDM_SlctPost	= chk
	end if
	
	'Y/N 설정에 따른 색상표시
	User_Chk_Image_Set(trgt, chk)
	
	If g_BDM_SlctTel = "Y" And g_BDM_SlctSMS = "Y" And g_BDM_SlctEmail = "Y" And g_BDM_SlctPost = "Y" Then
		g_Chan_ALL = "Y"
	    Container4.img1.imgpath = "check_on.png"
	Else
		g_Chan_ALL = ""
	    Container4.img1.imgpath = "check_off.png"
	End If
End Function
