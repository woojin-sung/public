Sub Container1_img2n_OnClick()
	If g_BDM_Slct_1_2 <> "N" Then
		'v0006
		'Form.MsgBox("알림", "[수집·이용][개인신용정보] 미동의시,\n상품·서비스 안내 수신동의 및 동의채널도 미동의 됩니다.\n\n미동의 하시겠습니까?", "Slct_1_2", 6)  '6.close/cancel
		Form.MsgBox("안내", "수집·이용 미동의시,\n상품·서비스 안내 수신동의 및\n동의 채널도 미동의 됩니다.\n\n미동의 하시겠습니까?", "Slct_1_2", 6)  '6.close/cancel
		Exit Sub	
