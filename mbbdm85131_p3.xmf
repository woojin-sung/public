'============================================================================
Function User_Conti_Data_Set()

	'기선택된 정보인 경우 화면표시 처리
'v0006	
'	If g_BDM_Slct_1_1 = "Y" Then  '(선택) 수집이용_고유식별
'	     g_BDM_Slct_1_1 = ""  '재설정(User_Chk_Image_Set에서 처리)을 위해 초기화
'		User_Chk_Image_Set("11Y", "Y")
'	ElseIf g_BDM_Slct_1_1 = "N" Then
'		g_BDM_Slct_1_1 = "" 
'		User_Chk_Image_Set("11N", "Y")
'	End If
	If g_BDM_Slct_1_2 = "Y" Then  '(선택) 수집이용_개인신용
		g_BDM_Slct_1_2 = "" 
		User_Chk_Image_Set("12Y", "Y")
	ElseIf g_BDM_Slct_1_2 = "N" Then
		g_BDM_Slct_1_2 = "" 
		User_Chk_Image_Set("12N", "Y")
	End If
	If g_BDM_Slct_2_1 = "Y" Then  '(선택) 상품서비스안내
		g_BDM_Slct_2_1 = "" 
		User_Chk_Image_Set("21Y", "Y")
	ElseIf g_BDM_Slct_2_1 = "N" Then
		g_BDM_Slct_2_1 = "" 
		User_Chk_Image_Set("21N", "Y")
	End If	

	if g_BDM_SlctSMS == "Y" then
		User_Chk_Image_Set("SMS", "Y")
	end if
	if g_BDM_SlctEmail == "Y" then
		User_Chk_Image_Set("Email", "Y")
	end if
	if g_BDM_SlctTel == "Y" then
		User_Chk_Image_Set("Tel", "Y")
	end if
	if g_BDM_SlctPost == "Y" then
		User_Chk_Image_Set("Post", "Y")
	end if

	If g_BDM_SlctTel = "Y" And g_BDM_SlctSMS = "Y" And g_BDM_SlctEmail = "Y" And g_BDM_SlctPost = "Y" Then
		g_Chan_ALL = "Y"
	    Container4.img1.imgpath = "check_on.png"
	Else
		g_Chan_ALL = ""
	    Container4.img1.imgpath = "check_off.png"
	End If
End Function




'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    'OSType 1.안드로이드 2.IOS
     g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)    
    
	'파일설정
	User_File_Set()

	'공유정보Get
	User_SharedData_Get()
	
	lblCtcnShow.caption = "선택동의서(요약/상세) 보기 >"
	
	'특정단어 글자색 설정
	Container0.Label0.fgcolor = 265	'265(주황색) #ef3b24
	Container2.Label0.fgcolor = 265	'265(주황색) #ef3b24
	
	'특정항목 배경색 설정
	Container5.bgcolor = 272  '272(연연회색) #f6f6f6
	
	'이어하기용 정보 설정
	User_Conti_Data_Set()	
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	'약관
	if sKeyName == G_STEP2_2_P1_FILE then
		if sRet == "ok_Slct" then
			'약관확인 종료시, 모두동의 한 것으로 체크
			g_BDM_Slct_1_1 = ""  '재설정(User_Chk_Image_Set에서 처리)을 위해 초기화
			g_BDM_Slct_1_2 = ""
			g_BDM_Slct_2_1 = ""
			User_Chk_Image_Set("11Y", "Y")			
			User_Chk_Image_Set("12Y", "Y")
			User_Chk_Image_Set("21Y", "Y")
			g_BDM_SlctTel		= "Y"	'홍보수신_전화
			g_BDM_SlctSMS		= "Y"	'홍보수신_문자
			g_BDM_SlctEmail	= "Y"	'홍보수신_이메일
			g_BDM_SlctPost	= "Y"	'홍보수신_우편
			User_Chk_OK("Tel"	, "Y")
			User_Chk_OK("SMS"	, "Y")
			User_Chk_OK("Email", "Y")
			User_Chk_OK("Post", "Y")
		end if
	end if
End Sub


'============================================================================
' 홍보전화
'============================================================================
Sub Container5_lblTel_OnClick()
	Container5_imgTel_OnClick()
End Sub
'============================================================================
Sub Container5_imgTel_OnClick()
	'체크 설정
	if g_BDM_SlctTel == "Y" then
		g_BDM_SlctTel = "N"
	else
		'동의할 경우, 개인신용정보 동의 필수
		If g_BDM_Slct_1_2 <> "Y" Then
			'v0006
			'Form.ShowAlert("알림", "상품·서비스 안내 {전화}수신동의를 위해서는\n[수집·이용][개인신용정보] 동의가 필요합니다.")
			Form.ShowAlert("안내", "채널 수신 동의를 위해서는\n수집·이용 동의가 필요합니다.")
			Exit Sub
		End If

		'동의할 경우, 상품·서비스 안내 수신동의 동의 필수
		If g_BDM_Slct_2_1 <> "Y" Then
			'v0006
			'Form.ShowAlert("알림", "상품·서비스 안내 {전화}수신동의를 위해서는\n[상품·서비스 안내] 수신 동의가 필요합니다.")
			Form.ShowAlert("안내", "채널 수신 동의를 위해서는\n상품·서비스 안내 수신 동의가 필요합니다.")
			Exit Sub
		End If

		g_BDM_SlctTel = "Y"
	end if

	User_Chk_OK("Tel", g_BDM_SlctTel)
End Sub
