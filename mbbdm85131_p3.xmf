'============================================================================
Sub Container4_img1_OnClick()
     If g_Chan_ALL == "Y" Then
	     g_Chan_ALL = ""
	    'User_Chk_Image_Set("ALL", "N")
	     Container4.img1.imgpath = "check_off.png"
	    g_BDM_SlctTel   = "N"
	    g_BDM_SlctSMS   = "N"
	    g_BDM_SlctEmail = "N"
	    g_BDM_SlctPost  = "N"
	    User_Chk_OK("Tel"  , g_BDM_SlctTel  )
	    User_Chk_OK("SMS"  , g_BDM_SlctSMS  )
	    User_Chk_OK("Email", g_BDM_SlctEmail)
	    User_Chk_OK("Post" , g_BDM_SlctPost )
	 Else
		'동의할 경우, 개인신용정보 동의 필수
		If g_BDM_Slct_1_2 <> "Y" Then
			'v0006
			'Form.ShowAlert("알림", "상품·서비스 안내 {채널}수신동의를 위해서는\n[수집·이용][개인신용정보] 동의가 필요합니다.")
			Form.ShowAlert("안내", "채널 수신 동의를 위해서는\n수집·이용 동의가 필요합니다.")
			Exit Sub
		End If

		'동의할 경우, 상품·서비스 안내 수신동의 동의 필수
		If g_BDM_Slct_2_1 <> "Y" Then
			'v0006
			'Form.ShowAlert("알림", "상품·서비스 안내 {채널}수신동의를 위해서는\n[상품·서비스 안내] 수신 동의가 필요합니다.")
			Form.ShowAlert("안내", "채널 수신 동의를 위해서는\n상품·서비스 안내 수신 동의가 필요합니다.")
			Exit Sub
		End If
	
		 g_Chan_ALL = "Y"
	 	'User_Chk_Image_Set("ALL", "Y")
		Container4.img1.imgpath = "check_on.png"
	    g_BDM_SlctTel   = "Y"
	    g_BDM_SlctSMS   = "Y"
	    g_BDM_SlctEmail = "Y"
	    g_BDM_SlctPost  = "Y"
	    User_Chk_OK("Tel"  , g_BDM_SlctTel  )
	    User_Chk_OK("SMS"  , g_BDM_SlctSMS  )
	    User_Chk_OK("Email", g_BDM_SlctEmail)
	    User_Chk_OK("Post" , g_BDM_SlctPost )
	End If
End Sub




