'============================================================================
Sub Form_OnTimerEvent(sTimerID)
    if sTimerID == "9999" or sTimerID == 9999 then
        Form.SetTimerEvent2(sTimerID, 0, 0.1)
        if g_sz_OSType == "1" or g_sz_OSType == 1 then
            Form.CloseForm()
        end if
    end if
End Sub
'============================================================================
' 종료
'============================================================================
'============================================================================
Sub Form_OnFormBackKeyPressed()
    imgExit_OnClick()
End Sub
'============================================================================
Sub imgExit_OnClick()
    g_RetFlag = ""
    if g_sz_OSType == "1" or g_sz_OSType == 1 then
        NextStep()
        Form.SetTimerEvent2("9999", 1, 0.1)
    elseif g_sz_OSType == "2" or g_sz_OSType == 2 then
        Form.CloseForm()
    end if
End Sub
'============================================================================
' 확인종료
'============================================================================
Sub btnOK_OnClick()
    g_RetFlag = "ok"
    if g_sz_OSType == "1" or g_sz_OSType == 1 then
        NextStep()
        Form.SetTimerEvent2("9999", 1, 0.1)
    elseif g_sz_OSType == "2" or g_sz_OSType == 2 then
        Form.CloseForm()
    end if
End Sub
'============================================================================
Function NextStep()
    if g_RetFlag == "ok" then
        '공유정보Set
	    User_SharedData_Set("")
    end if    
    
    '약관목록으로 돌아가고 현재화면 닫기
    Form.SendReturnToParent(G_STEP2_2_P3_FILE, g_RetFlag)
End Function
'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    if g_RetFlag == "ok" then
        '공유정보Set
	    User_SharedData_Set("")
    end if    
    
    '약관목록으로 돌아가고 현재화면 닫기
    Form.SendReturnToParent(G_STEP2_2_P3_FILE, g_RetFlag)
End Sub



'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "Slct_1_2" Then
        'sRet=close/cancel
		If sRet = "close" Then
			User_Chk_Image_Set("12N", "Y")
		
			g_BDM_Slct_2_1 = "" 
			User_Chk_Image_Set("21N", "Y")
			
			g_Chan_ALL = ""
			Container4.img1.imgpath = "check_off.png"
			g_BDM_SlctTel   = "N"
			g_BDM_SlctSMS   = "N"
			g_BDM_SlctEmail = "N"
			g_BDM_SlctPost  = "N"
			User_Chk_OK("Tel"  , g_BDM_SlctTel  )
			User_Chk_OK("SMS"  , g_BDM_SlctSMS  )
			User_Chk_OK("Email", g_BDM_SlctEmail)
			User_Chk_OK("Post" , g_BDM_SlctPost )		    
		End If

	ElseIf sKeyName = "Slct_2_1" Then
        'sRet=close/cancel
		If sRet = "close" Then
			User_Chk_Image_Set("21N", "Y")
			
			g_Chan_ALL = ""
			Container4.img1.imgpath = "check_off.png"
			g_BDM_SlctTel   = "N"
			g_BDM_SlctSMS   = "N"
			g_BDM_SlctEmail = "N"
			g_BDM_SlctPost  = "N"
			User_Chk_OK("Tel"  , g_BDM_SlctTel  )
			User_Chk_OK("SMS"  , g_BDM_SlctSMS  )
			User_Chk_OK("Email", g_BDM_SlctEmail)
			User_Chk_OK("Post" , g_BDM_SlctPost )
		End If
	End If
End Sub

