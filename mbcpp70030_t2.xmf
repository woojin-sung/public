	<SCRIPT_INFO _len="1444" _ulen="1444" >
--===========================================================================
Dim regular_earn_score
Dim regular_earn_value
Dim know_score
Dim know_value
Dim exp_score
Dim exp_value
--===========================================================================



'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	
	if nIndex = 0 then
		regular_earn_score = 2
	elseif nIndex = 1 then
		regular_earn_score = -2
	end if
	
	regular_earn_value = nIndex + 1
	
	Form.SetSharedData("Regular_Earn_Value", regular_earn_value)
	Form.SetSharedData("Regular_Earn_Score", regular_earn_score)

	
End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	if nIndex = 0 then
		know_score = 1
	elseif nIndex = 1 then
		know_score = 2
	elseif nIndex = 2 then
		know_score = 3
	else
		know_score = 4
	end if
	
	know_value = nIndex+1
	
	
	
	Form.SetSharedData("Know_Value", know_value)
	Form.SetSharedData("Know_Score", know_score)
	
End Sub

'============================================================================
Sub RadioGroup2_OnClick(nIndex)
	if nIndex = 0 then
		exp_score = 1
	elseif nIndex = 1 then
		exp_score = 2
	elseif nIndex = 2 then
		exp_score = 3
	else
		exp_score = 4
	end if
	
	exp_value = nIndex+1
	

	
	Form.SetSharedData("Exp_Value",exp_value)
	Form.SetSharedData("Exp_Score",exp_score)
	
End Sub

