	<SCRIPT_INFO _len="623" _ulen="623" >
Dim g_sAgree

'============================================================================
Sub btnOk_OnClick()
	g_sAgree = "Y"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_sAgree = "N"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81010_p22_agree", g_sAgree)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	'Form.CloseForm( )	'
End Sub


