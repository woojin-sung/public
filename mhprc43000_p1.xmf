'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	g_nNextCount_Money = 0
	g_nNextCount_Amount = 0
	
	g_szData = Form.GetOpenLinkData()
		
	g_szList = Split(g_szData , "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	cmb0.currentindex = g_szList(0)			'콤보 선택Index
	g_nSelect = g_szList(0)
	rdo0.currentindex = g_szList(1)			'라디오 선택Index
	g_nRadio = g_szList(1)
	
	if g_szList(2) == "시간별" then
		grd0.SetVisibleCol(0, true)
		grd0.SetVisibleCol(1, false)
	else
		grd0.SetVisibleCol(0, false)
		grd0.SetVisibleCol(1, true)
	end if
	
'	DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )
'
'	DATAMANAGER.RequestRealData( "ohhts_invr_cntg" )
	SetTR(g_nSelect, Int(g_nRadio), g_szList(2))
	
	ChartEx0.SetAccrueName("개인,외국인,기관계")
End Sub
'============================================================================
' grd0_OnHeaderClickUp(lRow, szCellID) : 선택한 헤더 변경을 위한 선택팝업 띄움
'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	
	Form.OpenPopup("mhprc43000_p2" , szCellID , sPosInfo)
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) : 헤더 선택값에 따라 해당 셀들의 값 세팅
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	g_nNextCount_Money = 0
	g_nNextCount_Amount = 0
	
	g_szType = sRet									'투자자 이름
	g_szCellID = sKeyName								'헤더 셀아이디
	grd0.SetCellTopCaption( g_szCellID, g_szType )
	
	SetTR(g_nSelect, Int(g_nRadio), g_szList(2))
	SetGrd(g_nRadio, g_szCellID, g_szType)

End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 완료시 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_invr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_invr_cntg_1" )
	if szTranID == "ohhts_1521_002r" then					'시간별, 금액
		g_nOutCount = DATAMANAGER.GetDataCount( 0 , "ohhts_1521_002r", "OutBlock1")
		for i = 0 to g_nOutCount - 1
			g_nNextCount_Money = g_nNextCount_Money + 1

			SetGrd(Int(g_nRadio), "bd_cell1", grd0.GetCellTopCaption("th_cell1"), i, g_nNextCount_Money - 1)
			SetGrd(Int(g_nRadio), "bd_cell2", grd0.GetCellTopCaption("th_cell2"), i, g_nNextCount_Money - 1)
			SetGrd(Int(g_nRadio), "bd_cell3", grd0.GetCellTopCaption("th_cell3"), i, g_nNextCount_Money - 1)

		next
		
		'16-03-29 정보기술담당 김상복 담당님이 전부 조회하게 만듬 -> 더이상 수정 받아주지 않기로
		if DATAMANAGER.RequestNextData( szTranID ) == true then
			DATAMANAGER.RequestNextData( szTranID )
			Exit Sub
		end if
		
		SetChartData(g_nNextCount_Money, 0)
		DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )

		DATAMANAGER.RequestRealData( "ohhts_invr_cntg" )
	elseif szTranID == "ohhts_1521_002r_1" then					'시간별, 수량
'
		g_nOutCount = DATAMANAGER.GetDataCount( 0 , "ohhts_1521_002r_1", "OutBlock1")
		for i = 0 to g_nOutCount - 1
			g_nNextCount_Amount = g_nNextCount_Amount + 1

			SetGrd(Int(g_nRadio), "bd_cell1", grd0.GetCellTopCaption("th_cell1"), i, g_nNextCount_Amount - 1)
			SetGrd(Int(g_nRadio), "bd_cell2", grd0.GetCellTopCaption("th_cell2"), i, g_nNextCount_Amount - 1)
			SetGrd(Int(g_nRadio), "bd_cell3", grd0.GetCellTopCaption("th_cell3"), i, g_nNextCount_Amount - 1)

		next
		
		if DATAMANAGER.RequestNextData( szTranID ) == true then
			DATAMANAGER.RequestNextData( szTranID )
			Exit Sub
		end if
		
		SetChartData(g_nNextCount_Amount, 0)
		DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg_1", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )
		
		DATAMANAGER.RequestRealData( "ohhts_invr_cntg_1" )
	elseif szTranID == "ohhts_1522_001r" then					'일별, 금액
'
		g_nOutCount = DATAMANAGER.GetDataCount( 0 , "ohhts_1522_001r", "OutBlock1")
		for i = 0 to g_nOutCount - 1
			g_nNextCount_Money = g_nNextCount_Money + 1

			SetDayGrd(Int(g_nRadio), "bd_cell1", grd0.GetCellTopCaption("th_cell1"), i, g_nNextCount_Money - 1)
			SetDayGrd(Int(g_nRadio), "bd_cell2", grd0.GetCellTopCaption("th_cell2"), i, g_nNextCount_Money - 1)
			SetDayGrd(Int(g_nRadio), "bd_cell3", grd0.GetCellTopCaption("th_cell3"), i, g_nNextCount_Money - 1)

		next
		
'		if DATAMANAGER.RequestNextData( szTranID ) == true then
'			DATAMANAGER.RequestNextData( szTranID )
'			Exit Sub
'		end if
		
		SetChartData(g_nNextCount_Money, 1)
'		DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )
'		
'		DATAMANAGER.RequestRealData( "ohhts_invr_cntg" )
	elseif szTranID == "ohhts_1522_001r_1" then					'일별, 수량

		g_nOutCount = DATAMANAGER.GetDataCount( 0 , "ohhts_1522_001r_1", "OutBlock1")
		for i = 0 to g_nOutCount - 1
			g_nNextCount_Amount = g_nNextCount_Amount + 1

			SetDayGrd(Int(g_nRadio), "bd_cell1", grd0.GetCellTopCaption("th_cell1"), i, g_nNextCount_Amount - 1)
			SetDayGrd(Int(g_nRadio), "bd_cell2", grd0.GetCellTopCaption("th_cell2"), i, g_nNextCount_Amount - 1)
			SetDayGrd(Int(g_nRadio), "bd_cell3", grd0.GetCellTopCaption("th_cell3"), i, g_nNextCount_Amount - 1)

		next
		
'		if DATAMANAGER.RequestNextData( szTranID ) == true then
'			DATAMANAGER.RequestNextData( szTranID )
'			Exit Sub
'		end if
		
		SetChartData(g_nNextCount_Amount, 1)
'		DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg_1", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )
'		
'		DATAMANAGER.RequestRealData( "ohhts_invr_cntg_1" )
	end if
	
End Sub
'============================================================================
' cmb0_OnEditComplete(iIndex) : 콤보 선택시 해당 시장에 따른 값들을 세팅
'============================================================================
Sub cmb0_OnEditComplete(iIndex)

	if g_nNextCount_Money == 0 and g_nNextCount_Amount == 0 then
		Exit Sub
	end if
	
'	g_nNextCount = 0
	
	g_nSelect = iIndex
	
	g_nNextCount_Money = 0
	g_nNextCount_Amount = 0
	
	Call SetTR(g_nSelect, Int(g_nRadio), g_szList(2))
	
End Sub
'============================================================================
' rdo0_OnClick(nIndex) : 라디오 선택시 해당 종류에 따른 값들을 세팅
'============================================================================
Sub rdo0_OnClick(nIndex)
	
	if nIndex == 1 then
		if g_nNextCount_Money == 0 then
			Exit Sub
		else
			g_nNextCount_Money = 0
		end if
	else
		if g_nNextCount_Amount == 0 then
			Exit Sub
		else
			g_nNextCount_Amount = 0
		end if
	end if
'	g_nNextCount = 0
	
	g_nRadio = nIndex
	
	Call SetTR(g_nSelect, g_nRadio, g_szList(2))
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	if Int(g_nRadio) == 0 then			'금액
		if g_szList(2) == "시간별" then
			DATAMANAGER.RequestNextData( "ohhts_1521_002r" )
		else				'일별
			DATAMANAGER.RequestNextData( "ohhts_1522_001r" )
		end if
	else								'수량
		if g_szList(2) == "시간별" then
			DATAMANAGER.RequestNextData( "ohhts_1521_002r_1" )
		else				'일별
			DATAMANAGER.RequestNextData( "ohhts_1522_001r_1" )
		end if
	end if
End Sub

