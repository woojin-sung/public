'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim sztime, szdata1, szdata2, szdata3	
	Dim sztime1, szdata4, szdata5, szdata6

	if szTranID == "ohhts_invr_cntg" then					'금액
		g_nNextCount_Money = g_nNextCount_Money + 1
		SetRealGrd(Int(g_nRadio), "bd_cell1", grd0.GetCellTopCaption("th_cell1"), 0, 0)
		szdata1 = g_szRoundValue
		SetRealGrd(Int(g_nRadio), "bd_cell2", grd0.GetCellTopCaption("th_cell2"), 0, 0)
		szdata2 = g_szRoundValue
		SetRealGrd(Int(g_nRadio), "bd_cell3", grd0.GetCellTopCaption("th_cell3"), 0, 0)
		szdata3 = g_szRoundValue
		
		sztime = DATAMANAGER.GetDataValue(1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BSOP_HOUR" , 0)
		
		ChartEx0.setInvestorRealData("개인;외국인;기관계="..sztime..";"..szdata1..";"..szdata2..";"..szdata3)
		
'		SetChartData(g_nNextCount_Money)
	elseif szTranID == "ohhts_invr_cntg_1" then				'수량
		g_nNextCount_Amount = g_nNextCount_Amount + 1
		SetRealGrd(Int(g_nRadio), "bd_cell1", grd0.GetCellTopCaption("th_cell1"), 0, 0)
		szdata4 = g_szVolValue
		SetRealGrd(Int(g_nRadio), "bd_cell2", grd0.GetCellTopCaption("th_cell2"), 0, 0)
		szdata5 = g_szVolValue
		SetRealGrd(Int(g_nRadio), "bd_cell3", grd0.GetCellTopCaption("th_cell3"), 0, 0)
		szdata6 = g_szVolValue
		
		sztime1 = DATAMANAGER.GetDataValue(1, "ohhts_invr_cntg_1", "OutBlock1", "FIDR_BSOP_HOUR" , 0)
		
		ChartEx0.setInvestorRealData("개인;외국인;기관계="..sztime1..";"..szdata4..";"..szdata5..";"..szdata6)
'		SetChartData(g_nNextCount_Amount)
	end if
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub ChartEx0_OnScrollEnd()
	grd0_OnScrollEnd()
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	rdo0_OnClick(g_nRadio)
	
End Sub

