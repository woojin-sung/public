'============================================================================
' 01. 화 면 명 : 투자자동향_누적차트
' 02. 화면설명 : 투자자동향_누적차트
' 03. 작    성 : 2016. 02. 18.	유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tMarket, g_tMarket_Code	'그룹콤보 선택에 따른 시장명, 코드 입력값 테이블
Dim g_nSelect					'콤보 선택상태
Dim g_nRadio					'라디오 선택상태
Dim g_nCls_Code
Dim g_szData					'TR입력값과 라디오,콤보 선택 Index값
Dim g_szList					'
Dim g_szType					'투자자
Dim g_nOutCount				'TR OUT수
Dim g_nNextCount_Money			'누적 TR OUT수
Dim g_nNextCount_Amount		'누적 TR OUT수
Dim g_szCellID				'그리드 헤더CellID
Dim szValue					'그리드 세팅 Value
Dim gTempDate, gTempData1, gTempData2, gTempData3
Dim szHeadName1, szHeadName2, szHeadName3 
Dim g_szVolValue
Dim g_szRoundValue

' 20190809_01 HWG START : 위클리옵션추가
'20190306 LES START 주식선물추가
'orgn
'g_tMarket = {"KSP", "KSQ", "K2I", "K2I", "K2I", "MKI", "MKI", "MKI"}
'g_tMarket_Code = {"0001", "1001", "F001", "OC01", "OP01", "F005", "OC02",  "OP02"}
g_tMarket = {"KSP", "KSQ", "K2I", "K2I", "K2I", "WKM", "WKM", "WKI", "WKI","MKI", "MKI", "MKI", "999"}
g_tMarket_Code = {"KGG01P", "QGG01P", "F001  ", "OC01  ", "OP01  ", "OC05  ", "OP05  ", "OC04  ", "OP04  ", "F005  ", "OC02  ",  "OP02  ", "S001  "}	'22년 차세대 업종코드 하드코딩
'20190306 LES END
' 20190809_01 HWG END


g_nCls_Code = "000"
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTR(CmbIndex, RdoIndex) : 라디오, 콤보 값에 따른, TR 입력 데이터 세팅
'============================================================================
Function SetTR(CmbIndex, RdoIndex, szType)
	
	if RdoIndex == 0 then			'금액
		if szType == "시간별" then
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(CmbIndex)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(CmbIndex)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , 0 , g_nCls_Code )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , 0 , g_nCls_Code )
			
			DATAMANAGER.RequestTranData( "ohhts_1521_002r" )
			Exit Function
		else						'일별
			DATAMANAGER.SetDataValue( 0 , "ohhts_1522_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(CmbIndex)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1522_001r", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(CmbIndex)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1522_001r", "InBlock1", "FID_INPUT_DATE1" , 0 , cld0.caption )
		
			DATAMANAGER.RequestTranData( "ohhts_1522_001r" )
			Exit Function
		end if
	elseif RdoIndex == 1 then			'수량	
		if szType == "시간별" then
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(CmbIndex)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(CmbIndex)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , 0 , g_nCls_Code )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , 0 , g_nCls_Code )
			
			DATAMANAGER.RequestTranData( "ohhts_1521_002r_1" )
			Exit Function
		else						'일별
			DATAMANAGER.SetDataValue( 0 , "ohhts_1522_001r_1", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(g_nSelect)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1522_001r_1", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(g_nSelect)) )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1522_001r_1", "InBlock1", "FID_INPUT_DATE1" , 0 , cld0.caption )
			
			DATAMANAGER.RequestTranData( "ohhts_1522_001r_1" )
			Exit Function
		end if
	end if
	
End Function
'============================================================================
' SetChartData()
'============================================================================
Function SetChartData(nCount, nType)
	
	gTempDate = ""
	gTempData1 = ""
	gTempData2 = ""
	gTempData3 = ""
	
	for i = 0 to nCount - 1
		if nType == 0 then
			gTempDate = grd0.GetCellData( "bd_cell0" , i)&";"&gTempDate
		else
			gTempDate = grd0.GetCellData( "bd_cell4" , i)&";"&gTempDate
		end if
			gTempData1 = grd0.GetCellData( "bd_cell1" , i)&";"&gTempData1
		gTempData2 = grd0.GetCellData( "bd_cell2" , i)&";"&gTempData2
		gTempData3 = grd0.GetCellData( "bd_cell3" , i)&";"&gTempData3
	next

	szHeadName1 = grd0.GetCellTopCaption( "th_cell1" )
	szHeadName2 = grd0.GetCellTopCaption( "th_cell2" )
	szHeadName3 = grd0.GetCellTopCaption( "th_cell3" )
	
	ChartEx0.SetAccrueData("initdata="&gTempDate&"="&gTempDate)
	ChartEx0.SetAccrueData("changetitle="..szHeadName1..";"..szHeadName2..";"..szHeadName3.."=;")
	
	if nType == 0 then
			ChartEx0.SetAccrueData("period=5=HHMMSS")
		else
			
		end if
	ChartEx0.SetAccrueData("자료일자="..gTempDate.."="..gTempDate)
	ChartEx0.SetAccrueData("data1="..gTempData1.."="..gTempData1)
	ChartEx0.SetAccrueData("data2="..gTempData2.."="..gTempData2)
	ChartEx0.SetAccrueData("data3="..gTempData3.."="..gTempData3)
	ChartEx0.SetAccrueData("repaintall");
	
End Function
'============================================================================
' SetGrd(nRdoIndex, szCellID, szCellName, i , nIndex) : 시간별 탭에서 화면을 열었을때 그리드에 값 입력
'============================================================================
Function SetGrd(nRdoIndex, szCellID, szCellName, i , nIndex)
			'라디오 인덱스, cellID, 그리드헤더명, OUTPUTIndex, 그리드 그릴Index
	Dim szValue
	Dim szRoundValue
	
	if nRdoIndex == 0 then			'금액
		if szCellID == "bd_cell1" then
			Select Case szCellName
				Case "개인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "외국인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "기관계"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "금융투자"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "보험"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_INSU_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "투신"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_IVTR_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "기타금융"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_MRBN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "은행"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_BANK_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "연기금"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_FUND_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "사모펀드"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_PE_FUND_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "국가지방"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_ETC_ORGT_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "기타법인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_ETC_CORP_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
			End Select
		elseif szCellID == "bd_cell2" then
			Select Case szCellName
				Case "개인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "외국인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "기관계"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "금융투자"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "보험"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_INSU_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "투신"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_IVTR_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "기타금융"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_MRBN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "은행"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1521_002r", "OutBlock1", "FID_BANK_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "연기금"
