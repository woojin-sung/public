'============================================================================
' SetDayGrd(nRdoIndex, szCellID, szCellName, i , nIndex) : 일별 탭에서 화면을 열었을때 그리드에 값 입력
'============================================================================
Function SetDayGrd(nRdoIndex, szCellID, szCellName, i , nIndex)
	'라디오 인덱스, cellID, 그리드헤더명, OUTPUTIndex, 그리드 그릴Index
	Dim szValue
	Dim szRoundValue
	
	if nRdoIndex == 0 then			'금액
		if szCellID == "bd_cell1" then
			Select Case szCellName
				Case "개인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1522_001r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i)
					szRoundValue = Left( Round(szValue, -2), Len(Round(szValue,-2)) -2)
					grd0.SetCellData( szCellID , nIndex, szRoundValue)
				Case "외국인"
					szValue = DATAMANAGER.GetDataValue( 0, "ohhts_1522_001r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i)
