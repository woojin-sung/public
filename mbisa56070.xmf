'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 해지신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'                2016.06.14 : 신극수 : 신청완료시 비밀번호 초기화  v0001
'                2020.12.07 : 김유경 : 특정상품 해지신청시 안내 문구 팝업 추가 v0002
'                2021.03.16 : 신극수 : [T2102230014] [Wrap/ISA] 특정상품 해지신청 제어로직 변경 요청 v0003
'                2021.06.17 : 신극수 : v0004 : [T2106170005] 특정 Wrap/ISA 상품 해지신청 제어 로직 변경
'                2023.11.27 : 고승연 : v0005 : [T2311160009] obwat_ctad_012r IO 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sFlag		'"I" = 해지신청, "U" = 해지신청취소
Dim g_bCheckProsYn 'v0001


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function Account_Check()
	If acnt0.caption == "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Len(edtPwd.caption) < 4 Then
		Form.ShowAlert("알림", "비밀번호는 필수값입니다.")
		Return False
	End If
	
	If cmbSeq.caption == "" Then
		'Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	'v0002. 특정상품 해지신청시 안내 문구 팝업 추가 sta
	If g_sFlag == "I" Then '해지신청
	     Dim sMsg
	     sMsg = ""
	     'Form.ShowAlert("알림", cmbGubn.cbkeydata)
	     if cmbGubn.cbkeydata == "01" Then 'v0003 현금해지일 경우에만 팝업창으로 제어처리.
			If Trim(EdtWaPrcd.caption) = "WA000107" or Trim(EdtWaPrcd.caption) = "WA000108" Then
			    'v0004
			    IF DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r" , "OutBlock1" , "THCO_FRST_JOIN_DATE" , 0 ) <  "20201001" THEN
					sMsg =   " 해당 상품은 편입자산(키움글로벌얼터너티브) 환매 연기에 따라 당분간 해지 신청이 제한되고 있습니다. (2020.10월 이후 신규 계약 고객은 제외)" & Chr(13) & " 다만, 신청가능금액 범위내에서 출금 신청은 동일하게 가능하므로 출금신청으로 진행해주시기 바랍니다." & Chr(13) & " (업무처리 방법은 관리점 또는 컨택센터로 문의 요망(☎1588-3400))"
					Form.ShowAlert("알림", sMsg)
					Return False	
				END IF 
			End If
		End If
	End If 
	'v0002. fin
	
	Return true
End Function

'============================================================================
'조회
Sub RequestData()
	Call ClearAllData()
	
	If Account_Check() == False then
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData("obwat_ctad_012r")	
	
	'v0001 sta
	if g_bCheckProsYn  = "Y" then
		edtPwd.caption= ""
		g_bCheckProsYn  = "N"
	end if 
	'v0001 fin
End Sub

'============================================================================
Sub ClearAllData()
	For i = 0 to 4
		tbl0.SetCellString( i, 1, "")
	Next

	btnCancel.enable = True
	btnOK.enable = True
End Sub

'============================================================================
'조회 후처리
Sub SetTableData(szTranID)
	'1. 약정출금계좌 Display
	Dim szACNO, szASNO
	
	szACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LNKD_ACNO" , 0 )
	szASNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LNKD_ASNO" , 0 )
	tbl0.SetCellString( 2, 1, szACNO & szASNO )	
	
	'2. 해지 TR INPUT값 셋팅
	Dim sOutput0, sOutput1, sOutput2, sOutput3
	
	sOutput0 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "DRNG_SCDL_DATE" , 0 )
	sOutput1 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RQST_DATE" , 0 )
	sOutput2 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ATMT_CANC_YN" , 0 )
	sOutput3 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "JOIN_TYPE_CODE" , 0 )
	
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_011a", "InBlock1", "DRNG_SCDL_DATE" , 0 , sOutput0)
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_011a", "InBlock1", "RQST_DATE" , 0 , sOutput1)
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_011a", "InBlock1", "ATMT_CANC_YN" , 0 , sOutput2)
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_011a", "InBlock1", "JOIN_TYPE_CODE" , 0 , sOutput3)
	
	'3. 해지신청취소/해지신청 버튼 활성화
	Dim sDate
	sDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RQST_DATE" , 0 )
	
	If sDate <> "" and sDate == cal0.caption then		'취소버튼 활성화
		btnCancel.enable = True
		btnOK.enable = False
		
	ElseIf sDate <> "" and sDate <> cal0.caption then	'취소/신청 버튼 모두 비활성화
		btnCancel.enable = False
		btnOK.enable = False
		Form.ShowAlert("알림", "이미 해지신청된 내역이 존재합니다.")
		Exit Sub
		
	Else											'신청버튼 활성화
		btnCancel.enable = False
		btnOK.enable = True
	End If
End Sub

'============================================================================
'sFlag = "U" : 해지신청취소
'sFlag = "I" : 해지신청
Sub CancelContract()
	If Account_Check() == False then
		Exit Sub
	End If
	
	DATAMANAGER.SetEventFlag( "obwat_ctad_011a", g_sFlag )
	DATAMANAGER.RequestTranData( "obwat_ctad_011a" )	'랩계약출금해지신청 및 취소
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call acnt0_ChangeAccount()
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	ClearAllData()
	cmbSeq.clear = 1								'계약번호 초기화
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
End Sub

'============================================================================
Sub edtPwd_OnEditComplete()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub cmbSeq_OnEditComplete(iIndex)
	If edtPwd.caption <> "" Then
		Call RequestData()	'조회
	End If
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Call RequestData()	'조회
End Sub

'============================================================================
'해지신청
Sub btnOK_OnClick()
	g_sFlag = "I"
	Call CancelContract()	'랩계약출금해지신청 및 취소
End Sub

'============================================================================
'해지신청취소
Sub btnCancel_OnClick()
	g_sFlag = "U"
	Call CancelContract()	'랩계약출금해지신청 및 취소
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctad_012r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_CNRC_NO" , 0 , cmbSeq.caption)
	End If
	
	If szTranID == "obwat_ctad_011a" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_CNRC_NO" , 0 , cmbSeq.caption)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_CANC_CLCD" , 0 , cmbGubn.cbkeydata)
		IF g_sFlag = "I" THEN
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "DRNG_CANC_CLCD" , 0 , "02")
		ELSEIF g_sFlag = "U" THEN
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "DRNG_CANC_CLCD" , 0 , "04")
		END IF 
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계약번호 조회
	If szTranID == "obwat_ctad_011r" then
		Dim i, nCnt	

		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		If nCnt == 0 then
			Form.ShowAlert("알림", "ISA 계약이 존재하지 않습니다.")
			Exit Sub
		End If
		
		For i = 0 To nCnt - 1
			cmbSeq.cbadddatatext = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_NO" , i )		'계약번호
		Next

		cmbSeq.SetCurSel( 0 )	
	End If
	
	'조회
	If szTranID == "obwat_ctad_012r" then
		Call SetTableData(szTranID)
	End If
	
	'해지신청/해지신청취소
	If szTranID == "obwat_ctad_011a" then
		Dim sMsg
		sMsg = ""
		
		If g_sFlag = "I" then
			sMsg = "ISA 해지신청이 완료되었습니다."
		ElseIf g_sFlag = "U" then
			sMsg = "ISA 해지신청취소가 완료되었습니다."
		End If
		
		Form.ShowAlert("알림", sMsg)
		
		g_bCheckProsYn = "Y"
		
		Call RequestData()
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

