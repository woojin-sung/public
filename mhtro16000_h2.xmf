'----------------------------------------------------------------------------
' 01. 화 면 명 : 가로탭_시간별
' 02. 화면설명 : 해외주식현재가 시간별 가로탭화면
' 03. 작    성 : 2021.03.16
'----------------------------------------------------------------------------

Dim g_sCode
Dim g_szExid
Dim g_szCode
Dim g_szRealCode
Dim g_rtChk

'============================================================================
Sub Form_OnFormInit()
	grd0.rowcount = 0
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim sTemp
	If sEventName = "INIT_CODE" then
		f_FormStart(sParam)
	 end if
	 
End Sub

'화면 클리어
'============================================================================
Function f_FormClear()
	g_nMaxCount = 300
	DATAMANAGER.ClearInputData( false, "ohhts_6000_003r" )
	DATAMANAGER.ClearOutputData( false, "ohhts_6000_003r" )
	DATAMANAGER.CancelRealData( "ohhts_exst_cntg" )
	DATAMANAGER.ClearInputData( 1, "ohhts_exst_cntg" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_exst_cntg" )
	grd0.SetClear()
end Function

'============================================================================
'화면 시작
'============================================================================
Function f_FormStart(szItemCode)
	if szItemCode <> "" then
		f_FormClear() '화면 클리어
		
		g_sCode = szItemCode
		sTemp = split(g_sCode, "@")
		g_szExid = sTemp[0] '시장구분
		g_szCode = sTemp[1] '종목코드 
		g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExid, false )
		DATAMANAGER.RequestTranData("ohhts_6000_003r")
	end if
end Function


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID == "ohhts_6000_003r" then
		DATAMANAGER.CancelRealData( "ohhts_exst_cntg" )
		
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) '시장분류 
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode ) '종목코드
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_szExid) '시장구분
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk) '실시간구분코드
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID == "ohhts_6000_003r" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
		
		if tonumber(grd0.rowcount) > g_nMaxCount then
			grd0.rowcount = g_nMaxCount
		end if
	end if
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	if tonumber(grd0.rowcount) < g_nMaxCount then
		if DATAMANAGER.IsMoreNextData( "ohhts_6000_003r" ) then
			DATAMANAGER.RequestNextData( "ohhts_6000_003r" )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		f_FormStart(sValue)
	end if
End Sub

