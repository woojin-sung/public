Sub Form_OnFormInit()

    ACNT_NO   = Form.GetSharedData("ACNT_NO"   , True )
    MNEC_CLCD = Form.GetSharedData("MNEC_CLCD" , True )
    APLT_CRCD = Form.GetSharedData("APLT_CRCD" , True )
    APLT_NO   = Form.GetSharedData("APLT_NO"   , True )
    APLT_AMT  = Form.GetSharedData("APLT_AMT"  , True )
    
    Table0.SetCellString(0 , 1 , ACNT_NO  )
    Table0.SetCellString(1 , 1 , MNEC_CLCD)
    Table0.SetCellString(2 , 1 , APLT_CRCD)
    Table0.SetCellString(3 , 1 , APLT_NO  )
    Table0.SetCellString(4 , 1 , APLT_AMT )

End Sub

