			<CONTROL_INFO>
				<LABEL name="Label0" fontsize="-2" caption="· signkorea를 통한 전용(무료) 인증서를 발급 하실 수 
    있습니다.

· 온라인 증권거래를 하기 위해서 전자인증서를 신규 또는 
    재발급을 받기 위한 신원정보 입력창 입니다.

· 인증서를 폐지하셨거나 분실하셔서 재발급 시 기존 발급 
    받으신 적이 있으신 분은 기존의 인증서를 사용하실 수 
    없습니다.

· 반드시 아래의 신원확인 방법을 선택하신 후 신원확인을 
    받으셔야 발급받으실 수 있습니다.

· 타 증권사에서 인증서를 받으신적이 있으신 분은 
    재발급 받으실 필요 없이 타 증권사에서 받으신 인증서를
    사용하시면 됩니다.

· 은행권 무료 인증서는 사용이 불가합니다.

· 실명확인번호는 주민등록번호, 사업자등록번호, 외국인등
     록번호 등으로 입력 가능합니다." valign="0" multiline="1" ly_vert="0,10,372,340,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<IMAGE name="ImgInfo" autosize="1" imgpath="icon_question.png" ly_vert="133,173,18,18,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="8562" _ulen="7430" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_발급/타기관(본인확인)
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'20201116 SWJ START 실명확인번호 암호화 (rcno_plain_rm = 0 미적용 / rcno_plain_rm = 1 적용)
'20201126 SWJ START 공인인증서 '공인' 글자 삭제
'20231113 LES START 외국인투자자 등록제도 폐지 관련 - 실명확인번호 자리수 확대(13자리->20자리)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

' 20201116 SWJ START : 실명확인번호 암호화 적용구분값
Dim rcno_plain_rm
rcno_plain_rm =""

Dim g_MediaType
g_MediaType =""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()	
	ImgInfo.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Label1.caption	= "ID찾기 >"
	
	Edit0.setApplyLabel("사용자ID", 	0, 268, "left", false)
	Edit1.setApplyLabel("실명확인번호",	0, 268, "left", false)
	
	ImgInfo.bringFront("1")
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if Form.GetSharedData("&OS_TYPE", false) == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	end if	

'20201116 SWJ START : 실명확인번호 암호화
	'rcno_plain_rm = ( 0 : 미적용/ 1 : 적용)
	rcno_plain_rm = Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	if rcno_plain_rm <> "1" then
		'20200910 SWJ START
		if plain_rm == "1" then
			Edit1.SetEncExcept() 		'실명확인번호 : obcsb_efif_251r 서비스와 비교 시 예외처리	
		end if
		'20200910 SWJ END
	end if
'20201116 SWJ END
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		if sParam == "new" then '발급/재발급
			Table1.visible = true
		elseif sParam == "regi" then '타기관등록
			Table2.visible = true
		end if
	elseif sEventName == "NextCheck" then 
		if Edit0.caption == null or Edit0.caption == "" then
			Form.MsgBox( "알림", "사용자 ID를 입력하세요.", "", 6 )
		elseif Edit1.caption == null or Edit1.caption == "" then			
			Form.MsgBox( "알림", "실명확인번호를 입력하세요.", "", 6 )
		else '본인 확인 유효성체크
			DATAMANAGER.RequestTranData( "obcsb_efif_251r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_efif_251r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_251r", "InBlock1", "ELFN_ID" , 0 , Edit0.caption )
	'20230125 HSZ START : 개인정보 노출자 체크 추가
	elseif szTranID == "obcsb_scif_033r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_scif_033r", "InBlock1", "ELFN_ID" , 0 , Edit0.caption )
	'20230125 HSZ END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_efif_251r" then
		Dim sRCNO, sCUST_ABWR_NAME
		
		'20201116 SWJ START : 실명확인번호 암호화 (RCNO > RCNO_PIP로 변경)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then '고유MTS 미적용	
			sRCNO = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "RCNO" , 0 )
		else	
			sRCNO = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "RCNO_PIP" , 0 )
		end if
		'20201116 SWJ END
		
		sCUST_ABWR_NAME = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "CUST_ABWR_NAME" , 0 )
		
		'20170828 LES START - USERID 헤더값 세팅
		DATAMANAGER.SetUserID(Edit0.caption)
		'20170828 LES END
		
		if Edit1.caption == sRCNO then
			
			'20160519_01 KBC START 추가
'			'20160502 KBC START 추가 : 헤더에 USER_ID가 비어있으면 이후 서비스에서 제대로 출력값을 주지 못함
'			sUserID = Form.GetSharedData("&USER_ID" , false) '로그인 (자동접속 포함) 후 셋팅되는 값
'			
'			if sUserID == null or sUserID == "" then
'				'기존 접속중인 ID가 없는 경우 본 화면에서 입력한 ID로 헤더값 셋팅
'				DATAMANAGER.setUserID(Edit0.caption)  '공통헤더 값 채움 (DATAMANAGER.getUserID는 API가 현재 없음)
'				'Form.SetSharedData("&USER_ID" , Edit0.caption)
'				
'			elseif sUserID ~= Edit0.caption then
'				'기존 접속중인 ID가 있고 본 화면에서 입력한 ID와 상이한 경우
'				Form.MsgBox("알림", "입력하신 ID와 현재 접속중인 ID가 다릅니다. \n" 
'				         & "새로운 ID로 로그인(시세조회전용가능) 후 재시도 부탁드립니다.", "", 6)
'				exit sub
'				
'			end if
'			'20160502 KBC END
			'20160519_01 KBC END
			
			Form.SetSharedData("CERT_ID" , Edit0.caption)
			Form.SetSharedData("CERT_RCNO" , Edit1.caption)
			Form.SetSharedData("CERT_USER_NAME" , sCUST_ABWR_NAME)
			
			'20240408 SWJ START: 클라우드 인증
			Form.SetSharedData("CLOUD_CERT_RCNO_PIP" , Edit1.caption)
			Form.SetSharedData("CLOUD_CERT_ID" 		, Edit0.caption)
			Form.SetSharedData("CLOUD_CERT_CUST_NAME" , sCUST_ABWR_NAME)
			'20240408 SWJ END
			
'			20230125 HSZ START : 개인정보 노출자 체크 추가
			szCertNew = Form.GetSharedData("CRET_NEW_REG", false )
			if szCertNew = "Y" then
				DATAMANAGER.RequestTranData("obcsb_scif_033r")
			else
				Form.triggerEvent( "#", "NextStep", "1" )
			end if
'			20230125 HSZ END
		else
			Form.MsgBox( "알림", "고객정보가 일치하지 않습니다. 입력하신 ID의 실명확인번호가 일치하지 않습니다.", "", 6 ) '20160519_01 KBC
		end if
'	20230125 HSZ START : 개인정보 노출자 체크 추가
	elseif szTranID == "obcsb_scif_033r" then
		szInfoChk = DATAMANAGER.GetDataValue( 0, "obcsb_scif_033r", "OutBlock1", "TRGT_YN" , 0 )
		if szInfoChk = "Y" then
			Form.ShowAlert("알림", "개인정보노출자로 등록되어\n인증서 발급 및 바이오인증 등록이 불가합니다.")
			Exit Sub
		else			
			Form.triggerEvent( "#", "NextStep", "1" )
		end if
'	20230125 HSZ END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_efif_251r" or szTranID == "obcsb_scif_033r" then
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
' ID찾기
'============================================================================
Sub Button0_OnClick()
	Form.OpenPopup("mhetc90020_pa", "mhetc90020_pa_ELFN_ID", "")
End Sub

'============================================================================
' 실명확인번호 툴팁
'============================================================================
Sub ImgInfo_OnClick()
	ImgInfo.openToolTip("주민등록번호, 사업자등록번호, 외국인등록번호 중\n해당하는 실명확인번호를 입력해주세요.", 345, 60, 2)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhetc90020_pa" then
		Edit0.caption = sRet
	end if
	
End Sub

	</SCRIPT_INFO>
