				</TRBLOCK>
			</TRAN>
			<TRAN name="obcsb_scif_033r" title="개인정보노출자 여부 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="112" _ulen="88" >

CSNO^고객번호^10^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ELFN_ID^전자금융ID^20^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="42" _ulen="34" >

TRGT_YN^대상여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>