	<SCRIPT_INFO _len="841" _ulen="805" >
Sub Form_OnFormInit()
	Dim szServerMode, szURLheader
	Form.SetScreenName("해외주식 실시간시세정보 이용약관")
	
	szServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
'	If szServerMode == "1" Then       '개발기
'	     szURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/"
'	Else
	     szURLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
'	End If
	
	WebView1.viewtype = 0
	WebView1.urlpath = szURLheader & "meritz_yk_42.html"
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Form.SendReturnToParent( "mbtro16090_p1_RETURN" , "" )
	
	Form.CloseForm()
End Sub

