Sub Form_OnRefresh()

	btnSearch_OnClick()

End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	conn.Image2.SetMaintainingRatio("1")
	conn.Image1.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub conn_pann_OnClick(nIndex, sCellID)
	g_szItemCode = conn.pann.GetCellValue("lblCode",nIndex)
	innermarket = Form.GetItemCodeInfo(g_szItemCode, "innermarket")
	szItemGroup = "B"
	
'	szQty = CInt(conn.pann.GetCellValue("lblQty",nIndex)) * 1000
	szQty = CInt(conn.pann.GetCellValue("lblQty",nIndex))
	szBun = conn.pann.GetCellValue("lblBun",nIndex)	
	sName = Form.GetMetaData( "종합분리과세구분코드", szBun )
	
	Select Case innermarket
		Case "020" szItemGroup = "B"   '장내채권
		Case "019" szItemGroup = "SB"  '소액채권
	end Select
	
	if sCellID == "bntDay" then'매수일별
		szKind = conn.pann.GetCellValue("lblKind",nIndex)
		Form.OpenPopupAnimation("mbfnp54020_p18" , g_nAcNo.."★"..g_nAsNo.."★"..g_szItemCode.."★"..szKind .."★"..szItemGroup.."★"..sName, "","2")		
	elseif sCellID == "bntPrc" then'현재가
		if f_CheckAble(innermarket) then
			Form.OpenScreen("54010", "채권시세표★0★"&g_szItemCode&"★"&szItemGroup)    ' 현재가
		end if
	elseif sCellID == "bntExpect" then'예상수익
		szDate = conn.pann.GetCellValue("lblBuyDateReal",nIndex)	
		
		szPos = conn.pann.GetCellValue("lblPosition",nIndex)	
		if szPos == "Y" then'잔고합산인 경우 매수일이 빠른 날짜를 올림
			g_nSelectIdx = nIndex
			DATAMANAGER.RequestTranData("obtrs_comn_314r_1")
		else
			szPrc = conn.pann.GetCellValue("lblAvgBuyPrc",nIndex)	
			Form.OpenPopup("mhprc54000_p5" , g_szItemCode.."★"..szDate.."★"..szPrc.."★".."PRC", "")
		end if
		
	elseif sCellID == "bntBuy" then'매수
		if f_CheckAble(innermarket) then
			'  "잔고"/탭위치/종목코드/종목구분
			Form.triggerEvent("#", "54020_JANGO_TAB", "잔고★0★"&g_szItemCode&"★"&szItemGroup)
		end if
		
	elseif sCellID == "bntSell" then'매도
		szDate = conn.pann.GetCellValue("lblBuyDateReal",nIndex)	
		
		if f_CheckAble(innermarket) then
'			'  "잔고"/탭위치/종목코드/수량/매수일자/종목구분
'			Form.triggerEvent("#", "54020_JANGO_TAB", "잔고★1★"&g_szItemCode&"★"&szQty&"★"&szDate&"★"&szItemGroup)
			'  "잔고"/탭위치/종목코드/종목구분/수량/매수일자/매수구분
			Form.triggerEvent("#", "54020_JANGO_TAB", "잔고★1★"&g_szItemCode&"★"&szItemGroup&"★"&szQty&"★"&szDate&"★"&sName)
		end if
	else
	
		if CInt(nIndex) == conn.pann.rowcount - 1 then'마지막 로우
			conn.pann.toprow = CInt(conn.pann.rowcount - 1)
		end if
	
		szPos = conn.pann.GetCellValue("lblPosition",nIndex)'합산여부
	
		bFlag = false
		
		if g_nAlreadyOpenIdx <> -1 and g_nAlreadyOpenIdx <> nIndex then '이미 열려있는 판넬이 있다면
			conn.pann.SetCardWHAt(g_nAlreadyOpenIdx, 152)
			bFlag = true
		else
			if g_nAlreadyOpenIdx <> -1 and g_nAlreadyOpenIdx == nIndex then'동일한 인덱스 누름=닫음
				conn.pann.SetCardWHAt(nIndex, 152)
			else
				bFlag = true
			end if
		end if
		
		if bFlag == true then
			conn.pann.SetCardWHAt(nIndex, 222)
			
			if szPos == "Y" then '잔고합산인 경우(매수일별 보기)
				conn.pann.SetCellVisible("bntDay",nIndex,true)
				conn.pann.SetCellVisible("bntSell",nIndex,false)
'				conn.pann.setPropCardCell("left","bntPrc",nIndex,"100")
'				conn.pann.setPropCardCell("left","bntExpect",nIndex,"190")
'				conn.pann.setPropCardCell("left","bntBuy",nIndex,"281")
			else
				conn.pann.SetCellVisible("bntDay",nIndex,false)
				conn.pann.SetCellVisible("bntSell",nIndex,true)
'				conn.pann.setPropCardCell("left","bntPrc",nIndex,"10")
'				conn.pann.setPropCardCell("left","bntExpect",nIndex,"100")
'				conn.pann.setPropCardCell("left","bntBuy",nIndex,"190")
			end if
		end if
		
		if  g_nAlreadyOpenIdx == nIndex then'동일 인덱스 닫음
			g_nAlreadyOpenIdx = -1
		else'다른 idx열림
			g_nAlreadyOpenIdx = nIndex
		end if
	end if
End Sub

'============================================================================
Sub conn_pann_OnScrollEnd()
	szMore = DATAMANAGER.IsMoreNextData( "obtrs_comn_314r" )
	if szMore == true then
		DATAMANAGER.RequestNextData( "obtrs_comn_314r" )
	end if
End Sub

'============================================================================
Sub conn_btnSort_OnClick()
	Combo0.OpenList()
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	conn.Label0.caption = Combo0.caption
	if CInt(iIndex ) == 0 then
		conn.Image2.left = 70
	else
		conn.Image2.left = 120
	end if
	conn.pann.rowcount = 0
	conn.grdList.rowcount = 0
	DATAMANAGER.RequestTranData("obtrs_comn_314r")
End Sub

'============================================================================
Sub conn_imgViewMode_OnClick()
	if g_nViewMode == 0 then
		g_nViewMode = 1'그리드
		conn.pann.SetCardWHAt(g_nAlreadyOpenIdx, 152)
		g_nAlreadyOpenIdx = -1
		conn.grdList.visible = true
		conn.pann.visible = false
		conn.imgViewMode.imgpath = "btn_view_grid"
	else
		g_nViewMode = 0'판넬
		conn.grdList.visible = false
		conn.pann.visible = true
		conn.imgViewMode.imgpath = "btn_view_list"
	end if
	conn.pann.rowcount = 0
	conn.grdList.rowcount = 0
	DATAMANAGER.RequestTranData("obtrs_comn_314r")
'	f_Set_Scroll()
End Sub

Sub f_Set_Scroll()
	if g_nViewMode == 0 then'판넬
		if CInt(conn.pann.rowcount) > 1 then
'			conn.pann.height = CInt(conn.pann.rowcount) * 152 - 181
			conn.pann.height = 400
		else
'			conn.pann.height = CInt(conn.pann.rowcount) * 152 
			conn.pann.height = 219
		end if
	else
		if CInt(conn.grdList.rowcount) > 3 then
			conn.grdList.height = 400
		else
			conn.grdList.height = 219
		end if
	end if
	
	conn.SetScrollAutoSize()
	
end Sub

Sub f_CheckAble(szinnermarket)
	if szinnermarket == "" then
		Form.MsgBox("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.", "", 0)
		return false
	else
		return true
	end if
end Sub

'============================================================================
Sub btnSearch_OnClick()
	
	Call Output_Data_Clear()
	DATAMANAGER.RequestTranData("obtrs_comn_314r")	
	
End Sub
