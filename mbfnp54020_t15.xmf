Sub Form_OnFormInit()
	conn.setScrollBarVisible("0")
	conn.Label0.setNeighborCtlPos("conn.Image2","right", 70,"")
End Sub

'============================================================================
'출력 Data 초기화
Sub Output_Data_Clear()
'	20240307 이준행 START
    '그리드 초기화
'	conn.grdList.ClearAllData( )
'	conn.grdList.DeleteAllRow( )
	conn.grdList.SetClear()
	conn.pann.rowcount = 0
'	20240307 이준행 END
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obtrs_comn_314r" or szTranID == "obtrs_comn_314r_1" then
		g_GrdIndex = 0
		g_nAcNo = Form.GetCtlProp("#acc", "total")
		g_nAsNo = Form.GetCtlProp("#acc", "sequence")
'		g_nAcNo = cmbAcnt.total    'Left( cmbAccount.caption, 8)
'		g_nAsNo = cmbAcnt.sequence 'Right( cmbAccount.caption, 2)

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0 , g_nAsNo)
		
		if szTranID == "obtrs_comn_314r_1" then'판넬 잔고합산 종목 선택 시 매수일 빠른 날짜 조회용
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SORT_CLCD", 0 , "2")
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0 , g_szItemCode)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , "3")
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SORT_CLCD", 0 , Combo0.cbkeydata)
			if g_nViewMode == 1 then'그리드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , "3")
			else
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , "2")
			end if
		end if
	End if
	
End Sub

'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtrs_comn_314r" then
		szVLTN_PRLS_AMT = CDbl(DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock2", "VLTN_PRLS_AMT", 0 ))
		szVLTN_PRLS_ERT = round(DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock2", "VLTN_PRLS_ERT", 0 ) - 0.005, 2)

		conn.Table0.SetCellString(2, 1, FormatNumber(szVLTN_PRLS_AMT,0).."원("..FormatNumber(szVLTN_PRLS_ERT,2).."%)")

		if szVLTN_PRLS_AMT > 0 then
			conn.Table0.SetCellFgColor(2, 1, 6)
		elseif szVLTN_PRLS_AMT < 0 then
			conn.Table0.SetCellFgColor(2, 1, 7)
		end if

		Dim iCnt, sCode, sCodeName, iDataCount
		iDataCount = DATAMANAGER.GetDataCount( 0, "obtrs_comn_314r", "OutBlock1" )
		conn.pann.rowcount = conn.pann.rowcount + CInt(iDataCount)
		conn.grdList.rowcount = conn.grdList.rowcount + CInt(iDataCount)
		
		if CInt(conn.pann.rowcount) == 0 then
			conn.lblNodata.visible = true
			conn.pann.visible = false
			conn.grdList.visible = false
		else
			conn.lblNodata.visible = false
			
			if g_nViewMode == 0 then
				conn.grdList.visible = false
				conn.pann.visible = true
			else
				conn.grdList.visible = true
				conn.pann.visible = false
			end if
		end if
		
		For iCnt = 0 To iDataCount - 1
			
			szPSTN_ADUP_YN = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "PSTN_ADUP_YN", iCnt )'잔고합산 여부= Y일 경우 잔고합산(매수일별보기 추가)
	
			sCode = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "OVRL_SPTX_CLS_CODE", iCnt )			
			sName = Form.GetMetaData( "종합분리과세구분코드", sCode )
			szMTRT_DATE = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "MTRT_DATE", iCnt )'만기일자
			szBYOV_DATE = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "BYOV_DATE", iCnt )'매수일자
			szISCD = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "ISCD", iCnt )'종목코드
			szKOR_ISSU_ABWR_NAME = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "KOR_ISSU_ABWR_NAME", iCnt )'종목명
			szODER_ABLE_QTY = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "ODER_ABLE_QTY", iCnt )'수량(원단위임)
			szBYNG_AMT = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "BYNG_AMT", iCnt )'매입금액
			szBOND_VLTN_AMT = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "BOND_VLTN_AMT", iCnt )'채권평가금액
			szBYOV_ERT = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "BYOV_ERT", iCnt )'매수수익률
			szBYNG_UNPR = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "BYNG_UNPR", iCnt )'매입단가
			szOVRL_SPTX_CLS_CODE = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "OVRL_SPTX_CLS_CODE", iCnt )'종합 분리과세 구분코드
			szBOND_BYOV_ERT = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "BOND_BYOV_ERT", iCnt )'채권매수수익률
			
'			nODER_ABLE_QTY = len(szODER_ABLE_QTY)
'			szODER_ABLE_QTY2 = left(szODER_ABLE_QTY,nODER_ABLE_QTY - 3)
			
			if g_nViewMode == 1 then'그리드
				conn.grdList.SetCellData("bd_cell0", (conn.grdList.rowcount - iDataCount) + iCnt, szKOR_ISSU_ABWR_NAME)
				conn.grdList.SetCellData("bd_cell3", (conn.grdList.rowcount - iDataCount) + iCnt, szBYNG_UNPR)
				conn.grdList.SetCellData("bd_cell5", (conn.grdList.rowcount - iDataCount) + iCnt, szBYNG_AMT)
				conn.grdList.SetCellData("bd_cell2", (conn.grdList.rowcount - iDataCount) + iCnt, szBYOV_ERT)
				conn.grdList.SetCellData("bd_cell7", (conn.grdList.rowcount - iDataCount) + iCnt, sName)
				conn.grdList.SetCellData("bd_cell4", (conn.grdList.rowcount - iDataCount) + iCnt, szISCD)
				
				conn.grdList.SetCellData("bd_cell8", (conn.grdList.rowcount - iDataCount) + iCnt, mid(szBYOV_DATE,3,6))
				conn.grdList.SetCellData("bd_cell9", (conn.grdList.rowcount - iDataCount) + iCnt, mid(szMTRT_DATE,3,6))
'				conn.grdList.SetCellData("bd_cell11", (conn.grdList.rowcount - iDataCount) + iCnt, szODER_ABLE_QTY2)
				conn.grdList.SetCellData("bd_cell11", (conn.grdList.rowcount - iDataCount) + iCnt, szODER_ABLE_QTY)
				conn.grdList.SetCellData("bd_cell13", (conn.grdList.rowcount - iDataCount) + iCnt, szBOND_VLTN_AMT)
				conn.grdList.SetCellData("bd_cell10", (conn.grdList.rowcount - iDataCount) + iCnt, CDbl(szBOND_VLTN_AMT) - CDbl(szBYNG_AMT))
				conn.grdList.SetCellData("bd_cell6", (conn.grdList.rowcount - iDataCount) + iCnt, szBYOV_DATE)
				conn.grdList.SetCellData("bd_cell1", (conn.grdList.rowcount - iDataCount) + iCnt, szOVRL_SPTX_CLS_CODE)
				conn.grdList.SetCellData("bd_cell14", (conn.grdList.rowcount - iDataCount) + iCnt, szBOND_BYOV_ERT)
				
			else
				conn.pann.SetCellValue("lblPosition",conn.pann.rowcount - iDataCount + iCnt,szPSTN_ADUP_YN)
				conn.pann.SetCellValue("lblKind",conn.pann.rowcount - iDataCount + iCnt,sName)
				conn.pann.SetCellValue("lblBuyDateReal",conn.pann.rowcount - iDataCount + iCnt,szBYOV_DATE)
				
				if szPSTN_ADUP_YN == "Y" then'잔고합산
					conn.pann.SetCellValue("lblBuyDate",conn.pann.rowcount - iDataCount + iCnt,"-")
					conn.pann.SetCellVisible("lblPer",conn.pann.rowcount - iDataCount + iCnt,false)
					conn.pann.SetCellVisible("lblNoPer",conn.pann.rowcount - iDataCount + iCnt,true)
				else
					conn.pann.SetCellValue("lblBuyDate",conn.pann.rowcount - iDataCount + iCnt,mid(szBYOV_DATE,3,6))
					conn.pann.SetCellVisible("lblPer",conn.pann.rowcount - iDataCount + iCnt,true)
					conn.pann.SetCellVisible("lblNoPer",conn.pann.rowcount - iDataCount + iCnt,false)
				end if
				
				conn.pann.SetCellValue("lblEndDate",conn.pann.rowcount - iDataCount + iCnt,mid(szMTRT_DATE,3,6))
				conn.pann.SetCellValue("lblName",conn.pann.rowcount - iDataCount + iCnt,szKOR_ISSU_ABWR_NAME)
'				conn.pann.SetCellValue("lblQty",conn.pann.rowcount - iDataCount + iCnt,szODER_ABLE_QTY2)
				conn.pann.SetCellValue("lblQty",conn.pann.rowcount - iDataCount + iCnt,szODER_ABLE_QTY)
				conn.pann.SetCellValue("lblPer",conn.pann.rowcount - iDataCount + iCnt,szBYOV_ERT)
				conn.pann.SetCellValue("lblValAmt",conn.pann.rowcount - iDataCount + iCnt,szBOND_VLTN_AMT)
				conn.pann.SetCellValue("lblValGain",conn.pann.rowcount - iDataCount + iCnt,CDbl(szBOND_VLTN_AMT) - CDbl(szBYNG_AMT))
				conn.pann.SetCellValue("lblBuyAmt",conn.pann.rowcount - iDataCount + iCnt,szBYNG_AMT)
				conn.pann.SetCellValue("lblAvgBuyPrc",conn.pann.rowcount - iDataCount + iCnt,szBYNG_UNPR)
				conn.pann.SetCellValue("lblCode",conn.pann.rowcount - iDataCount + iCnt,szISCD)
				conn.pann.SetCellValue("lblBun",conn.pann.rowcount - iDataCount + iCnt,szOVRL_SPTX_CLS_CODE)		'종합분리과세 구분코드
				conn.pann.SetCellValue("lblBondPer",conn.pann.rowcount - iDataCount + iCnt,szBOND_BYOV_ERT)
			end if
		Next
		
		a = DATAMANAGER.IsMoreNextData( szTranID )
		
		f_Set_Scroll()
		
'		szCode = conn.grdList.GetCellData("bd_cell8", g_GrdIndex)
'	    if szCode <> "" then
'		    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "B")
'		    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCode)
'		    
'		    DATAMANAGER.RequestTranData("ohhts_7052_001r")
'		end if
		
	elseif szTranID = "ohhts_7052_001r" then
		
'		szSrfcMnrt = DATAMANAGER.GetDataValue(0, "ohhts_7052_001r", "OutBlock1", "FID_SRFC_MNRT" , 0 )
'		conn.grdList.SetCellData("bd_cell13", g_GrdIndex, szSrfcMnrt)
'
'		if Cint(g_GrdIndex) < Cint(conn.grdList.rowcount) then
'		    g_GrdIndex = g_GrdIndex + 1
'		    
'		    szCode = conn.grdList.GetCellData("bd_cell8", g_GrdIndex)
'		    if szCode <> "" then
'			    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "B")
'			    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCode)
'			    
'			    DATAMANAGER.RequestTranData("ohhts_7052_001r")
'			end if
'		end if
	elseif szTranID == "obtrs_comn_314r_1" then	
		szDate = DATAMANAGER.GetDataValue(0, "obtrs_comn_314r_1", "OutBlock1", "BYOV_DATE" , 0 )		
		szPrc = DATAMANAGER.GetDataValue(0, "obtrs_comn_314r_1", "OutBlock1", "BYNG_UNPR" , 0 )		
		Form.OpenPopup("mhprc54000_p5" , g_szItemCode.."★"..szDate.."★"..szPrc.."★".."PRC", "")		
	end if
	
End Sub

'============================================================================
Sub conn_cmbAcnt_ChangeAccount()
	
	btnSearch_OnClick()
	
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)  
	if sEventName == "CHANGE_ORIENTATION" then
		Form.OpenPopup("mbfnp54040_h1", "" , "")
	elseif sEventName == "SCREEN_MENU" then
		if sParam == "SHA_SNS" then
			Dim szTmp
			szTmp = ""
			Form.OpenDialog("sharesns1" , "0", "")
		end if
	elseif sEventName == "INIT_CODE" or sEventName == "ACNT_CHANGE" then	
		conn.pann.rowcount = 0
		conn.grdList.rowcount = 0
		DATAMANAGER.RequestTranData("obtrs_comn_314r")
	end if 

End Sub

'============================================================================
Sub conn_grdList_OnClickUp(lRow, szCellID)
	
	listLocation =  Split(conn.grdList.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	g_szItemCode = conn.grdList.GetCellData("bd_cell4", lRow)
	g_GrdIndex = lRow
	Form.OpenPopup("mbfnp54020_p19" , nYPos & "★" & height)
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mbfnp54040_h1" then
		
		if sRet ~= "" then
			conn_cmbAcnt.caption = sRet
			btnSearch_OnClick()
		End if
		
	elseIf sKeyName == "MOVEPOP_RETURN"	then
		
		Dim szListItems
		szListItems = split(sRet,"★")
		
		if 	szListItems(1) == "1"	then			'정정
			
			if g_szData ~= "" then
				Form.OpenScreen("54020" , "채권잔고" & "★" & "1" & "★" & g_szData ) 
			end if
			
		end if
		
		g_szData = ""
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
	elseif sKeyName = "mbfnp54020_p18" Then
		if sRet ~= "" then
			Form.triggerEvent("#", "54020_JANGO_TAB", sRet)
		end if
	elseif sKeyName = "mbfnp54020_p19" Then'그리드 선택
		innermarket = Form.GetItemCodeInfo(g_szItemCode, "innermarket")
		szItemGroup = "B"
		
'		szQty = CInt(conn.grdList.GetCellData("bd_cell11", g_GrdIndex)) * 1000
		szQty = CInt(conn.grdList.GetCellData("bd_cell11", g_GrdIndex))
		szBun = conn.grdList.GetCellData("bd_cell1", g_GrdIndex)
		sName = Form.GetMetaData( "종합분리과세구분코드", szBun )
		
		Select Case innermarket
			Case "020" szItemGroup = "B"   '장내채권
			Case "019" szItemGroup = "SB"  '소액채권
		end Select
		
		if sRet == "PRC" then
			if f_CheckAble(innermarket) then
				Form.OpenScreen("54010", "채권시세표★0★"&g_szItemCode&"★"&szItemGroup)    ' 현재가
			end if
		elseif sRet == "EXPECT" then	
			szData = conn.grdList.GetCellData("bd_cell6", g_GrdIndex)'매수일자
			szPrc = conn.grdList.GetCellData("bd_cell3", g_GrdIndex)'매수단가
			Form.OpenPopup("mhprc54000_p5" , g_szItemCode.."★"..szData.."★"..szPrc.."★".."PRC", "")
		elseif sRet == "BUY" then	
			if f_CheckAble(innermarket) then
				'  "잔고"/탭위치/종목코드/종목구분
				Form.triggerEvent("#", "54020_JANGO_TAB", "잔고★0★"&g_szItemCode&"★"&szItemGroup)
			end if
		elseif sRet == "SELL" then	
			szDate = conn.grdList.GetCellData("bd_cell6", g_GrdIndex)
			if f_CheckAble(innermarket) then
				'  "잔고"/탭위치/종목코드/수량/매수일자/종목구분
'				Form.triggerEvent("#", "54020_JANGO_TAB", "잔고★1★"&g_szItemCode&"★"&szQty&"★"&szDate&"★"&szItemGroup)
				'  "잔고"/탭위치/종목코드/종목구분/수량/매수일자/매수구분
				Form.triggerEvent("#", "54020_JANGO_TAB", "잔고★1★"&g_szItemCode&"★"&szItemGroup&"★"&szQty&"★"&szDate&"★"&sName)
			end if
		end if
	elseif sKeyName = "mhprc54000_p5" Then'가상매매-매수하기
		if sRet ~= "" then
			Form.OpenScreen("54020" , sRet)
		end if
	end if
End Sub


'============================================================================
Sub conn_grdList_OnScrollEnd()
	szMore = DATAMANAGER.IsMoreNextData( "obtrs_comn_314r" )
	if szMore == true then
		DATAMANAGER.RequestNextData( "obtrs_comn_314r" )
	end if
End Sub

