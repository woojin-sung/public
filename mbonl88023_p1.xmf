	<SCRIPT_INFO _len="986" _ulen="984" >

Dim g_szRet

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		Dim tData
		tData = split(szOpenData, "★")
		tblData.SetCellString(0, 1, tData[0])
		tblData.SetCellString(1, 1, tData[1])
	end if
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_szRet = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnAdd_OnClick()
	g_szRet = "continue"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl88023_p1", g_szRet)
End Sub

