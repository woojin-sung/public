	<SCRIPT_INFO _len="1254" _ulen="1224" >
'===========================================================================
Dim g_szAcno
Dim g_szAsno
'===========================================================================
Sub Call_Tran()

	g_szAcno = left(acnt1.caption,8)
	g_szAsno = right(acnt1.caption,2)
	
	
	if Cint(fmtab0.currenttab) = 0 or Cint(fmtab0.currenttab) = 1 then
		Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "TRANCALL", g_szAcno & "||" & g_szAsno)
	else
		Form.ShowAlert("Error", "유효하지않은 탭입니다.")
		exit sub
	end if
End Sub
'============================================================================
Sub Form_OnFormInit()
	Call_Tran()
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	Call_Tran()
End Sub

'============================================================================
Sub acnt1_ChangeAccount()
	'acnt1.caption = ""	
	Call_Tran()
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "LNDN_STPL_YN" then
		if sParam = "Y" then
			Table0.SetCellString(0, 1, "등록")
		else
			Table0.SetCellString(0, 1, "미등록")
		end if
	end if
End Sub

