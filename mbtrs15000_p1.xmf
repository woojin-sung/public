	<SCRIPT_INFO _len="27969" _ulen="26859" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 팝업_기간별 수익률
' 02. 화면설명 : 잔고평가의 기간수익률 팝업
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szACNO, g_szASNO, g_nUI_VLTN_AMT

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

Function Set_FgColor( nRow, nCol, nData)
	If nData > 0 Then
		tbl0.SetCellFgColor( nRow, nCol, "10")
	ElseIf nData < 0 Then
		tbl0.SetCellFgColor( nRow, nCol, "11")
	Else
		tbl0.SetCellFgColor( nRow, nCol, "12")
	End If
End Function

Function Set_Table()

	'폰트색 초기화
	tbl0.SetCellFgColor( 2, 1, "12")
	tbl0.SetCellFgColor( 4, 1, "12")
	tbl0.SetCellFgColor( 6, 1, "12")
	tbl0.SetCellFgColor( 8, 1, "12")
	tbl0.SetCellFgColor(10, 1, "12")
		
	If chkYear.checkstate = "0" Then		'연간수익률 미체크
		
		Dim nMNRC_AMT1_D, nMNRC_AMT2_D, nMNRC_AMT3_D, nMNRC_AMT4_D, nMNRC_AMT5_D		'유입자산		
		Dim nDRNG_AMT1_D, nDRNG_AMT2_D, nDRNG_AMT3_D, nDRNG_AMT4_D, nDRNG_AMT5_D		'유출자산
		
		
		nMNRC_AMT1_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_MNRC_AMT1" 	, 0 ) )	'금일_유입자산
		nMNRC_AMT2_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_MNRC_AMT2" 	, 0 ) )	'1개월_유입자산
		nMNRC_AMT3_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_MNRC_AMT3" 	, 0 ) )	'3개월_유입자산
		nMNRC_AMT4_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_MNRC_AMT4" 	, 0 ) )	'12개월_유입자산
		nMNRC_AMT5_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_MNRC_AMT5" 	, 0 ) )	'누적_유입자산
		nDRNG_AMT1_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_DRNG_AMT1" 	, 0 ) )	'금일_유출자산
		nDRNG_AMT2_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_DRNG_AMT2" 	, 0 ) )	'1개월_유출자산
		nDRNG_AMT3_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_DRNG_AMT3" 	, 0 ) )	'3개월_유출자산
		nDRNG_AMT4_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_DRNG_AMT4" 	, 0 ) )	'12개월_유출자산
		nDRNG_AMT5_D = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_DRNG_AMT5" 	, 0 ) )	'누적_유출자산
		
		'타이틀셋팅
		tbl0.SetCellString( 1, 0, "금일" )
		tbl0.SetCellString( 2, 0, "1개월" )
		tbl0.SetCellString( 3, 0, "3개월" )
		tbl0.SetCellString( 4, 0, "12개월" )
		
		'금일
		tbl0.SetCellString( 1, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT"			, 0 )	)	'금일_손익금액		
		tbl0.SetCellString( 1, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ASET_VLTN_AMT1"	, 0 )	)	'금일_기초자산
		tbl0.SetCellString( 1, 3, nMNRC_AMT1_D - nDRNG_AMT1_D   														)	'금일_유출입
		
		'금일_손익률		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "Y" THEN 
			tbl0.SetCellString( 2, 1, "-" )	
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "A" THEN 
			tbl0.SetCellString( 2, 1, "N/A" )	'금일_손익률
		ELSE 
			Set_FgColor( 2, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "PLRT", 0 ) ) )
			tbl0.SetCellString( 2, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "PLRT", 0 ) ).."%" )
			
		End If
		
		tbl0.SetCellString( 3, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT2" 		, 0 ) 	)	'1개월_손익금액
		tbl0.SetCellString( 2, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ASET_VLTN_AMT2" 	, 0 ) 	)	'1개월_기초자산
		tbl0.SetCellString( 2, 3, nMNRC_AMT2_D - nDRNG_AMT2_D   														)	'1개월_유출입
		
		'1개월_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN1", 0 ) = "Y" THEN 
			tbl0.SetCellString( 4, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN1", 0 ) = "A" THEN 
			tbl0.SetCellString( 4, 1, "N/A" )
		ELSE 
			Set_FgColor( 4, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M1_PLRT", 0 ) ) )
			tbl0.SetCellString( 4, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M1_PLRT", 0 ) ).."%" )
		End If
		
		tbl0.SetCellString( 5, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT3" 		, 0 ) 	)	'3개월_손익금액
		tbl0.SetCellString( 3, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ASET_VLTN_AMT3" 	, 0 ) 	)	'3개월_기초자산
		tbl0.SetCellString( 3, 3, nMNRC_AMT3_D - nDRNG_AMT3_D   														)	'3개월_유출입
		
		'3개월_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN2", 0 ) = "Y" THEN 
			tbl0.SetCellString( 6, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN2", 0 ) = "A" THEN 
			tbl0.SetCellString( 6, 1, "N/A" )
		ELSE 
			Set_FgColor( 6, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M2_PLRT", 0 ) ) )
			tbl0.SetCellString( 6, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M2_PLRT", 0 ) ).."%" )
		End If
		
		
		tbl0.SetCellString( 7, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT4" 		, 0 ) 	)	'12개월_손익금액
		tbl0.SetCellString( 4, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ASET_VLTN_AMT4" 	, 0 ) 	)	'12개월_기초자산
		tbl0.SetCellString( 4, 3, nMNRC_AMT4_D - nDRNG_AMT4_D  														)	'12개월_유출입
		
		'12개월_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN3", 0 ) = "Y" THEN 
			tbl0.SetCellString( 8, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN3", 0 ) = "A" THEN 
			tbl0.SetCellString( 8, 1, "N/A" )
		ELSE 
			Set_FgColor( 8, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M3_PLRT", 0 ) ) )
			tbl0.SetCellString( 8, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M3_PLRT", 0 ) ).."%" )
		    
		End If
		
		tbl0.SetCellString(  9, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT5" 		, 0 ) 	)	'누적_손익금액
		tbl0.SetCellString(  5, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ASET_VLTN_AMT5" 	, 0 ) 	)	'누적_기초자산
		tbl0.SetCellString(  5, 3, nMNRC_AMT5_D - nDRNG_AMT5_D  														)	'누적_유출입
		
		'누적_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "Y" THEN 
			tbl0.SetCellString( 10, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "A" THEN 
			tbl0.SetCellString( 10, 1, "N/A" )
		ELSE 
			Set_FgColor( 10, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M6_PLRT", 0 ) ) )
			tbl0.SetCellString( 10, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M6_PLRT", 0 ) ).."%" )
		End If
		
	Else
		
		Dim nMNRC_AMT1_Y, nMNRC_AMT2_Y, nMNRC_AMT3_Y, nMNRC_AMT4_Y, nMNRC_AMT5_Y		'유입자산		
		Dim nDRNG_AMT1_Y, nDRNG_AMT2_Y, nDRNG_AMT3_Y, nDRNG_AMT4_Y, nDRNG_AMT5_Y		'유출자산
	
		nMNRC_AMT1_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_MNRC_AMT1" 	, 0 ) )	'연간금일_유입자산
		nMNRC_AMT2_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_MNRC_AMT2" 	, 0 ) )	'연간금월_유입자산
		nMNRC_AMT3_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_MNRC_AMT3" 	, 0 ) )	'연간금분기_유입자산
		nMNRC_AMT4_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_MNRC_AMT4" 	, 0 ) )	'연간금년_유입자산
		nMNRC_AMT5_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_MNRC_AMT5" 	, 0 ) )	'연간누적_유입자산
		nDRNG_AMT1_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_DRNG_AMT1" 	, 0 ) )	'연간금일_유입자산
		nDRNG_AMT2_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_DRNG_AMT2" 	, 0 ) )	'연간금월_유입자산
		nDRNG_AMT3_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_DRNG_AMT3" 	, 0 ) )	'연간금분기_유입자산
		nDRNG_AMT4_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_DRNG_AMT4" 	, 0 ) )	'연간금년_유입자산
		nDRNG_AMT5_Y = CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_DRNG_AMT5" 	, 0 ) )	'연간누적_유입자산
	
	
		tbl0.SetCellString( 1, 0, "금일" )
		tbl0.SetCellString( 2, 0, "금월" )
		tbl0.SetCellString( 3, 0, "금분기" )
		tbl0.SetCellString( 4, 0, "금년" )	
	
		tbl0.SetCellString( 1, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_PRLS_AMT" 		, 0 ) 	)	'금일_손익금액
		tbl0.SetCellString( 1, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ASET_VLTN_AMT1" 	, 0 ) 	)	'금일_기초자산
		tbl0.SetCellString( 1, 3, nMNRC_AMT1_Y - nDRNG_AMT1_Y  														)	'금일_유출입
		
		'금일_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN", 0 ) = "Y" THEN 
			tbl0.SetCellString( 2, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN", 0 ) = "A" THEN 
			tbl0.SetCellString( 2, 1, "N/A" )
		ELSE 
			Set_FgColor( 2, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "PLRT", 0 ) ) )
			tbl0.SetCellString( 2, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "PLRT", 0 ) ).."%" )
		End If
		
		tbl0.SetCellString( 3, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_PRLS_AMT2" 		, 0 )  	)	'금월_손익금액
		tbl0.SetCellString( 2, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ASET_VLTN_AMT2" 	, 0 ) 	)	'금월_기초자산
		tbl0.SetCellString( 2, 3, nMNRC_AMT2_Y - nDRNG_AMT2_Y  														)	'금월_유출입
		
		'금월_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN1", 0 ) = "Y" THEN 
			tbl0.SetCellString( 4, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN1", 0 ) = "A" THEN 
			tbl0.SetCellString( 4, 1, "N/A" )
		ELSE 
			Set_FgColor( 4, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M1_PLRT", 0 ) ) )
			tbl0.SetCellString( 4, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M1_PLRT", 0 ) ).."%" )
		End If

		
		tbl0.SetCellString( 5, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_PRLS_AMT3" 		, 0 ) 	)	'금분기_손익금액
		tbl0.SetCellString( 3, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ASET_VLTN_AMT3" 	, 0 ) 	)	'금분기_기초자산
		tbl0.SetCellString( 3, 3, nMNRC_AMT3_Y - nDRNG_AMT3_Y 	 														)	'금분기_유출입
		
		'금분기_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN2", 0 ) = "Y" THEN 
			tbl0.SetCellString( 6, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN2", 0 ) = "A" THEN 
			tbl0.SetCellString( 6, 1, "N/A" )
		ELSE 
			Set_FgColor( 6, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M2_PLRT", 0 ) ) )
			tbl0.SetCellString( 6, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M2_PLRT", 0 ) ).."%" )
		End If
		
		tbl0.SetCellString( 7, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_PRLS_AMT4" 		, 0 ) 	)	'금년_손익금액
		tbl0.SetCellString( 4, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ASET_VLTN_AMT4" 	, 0 ) 	)	'금년_기초자산
		tbl0.SetCellString( 4, 3, nMNRC_AMT4_Y - nDRNG_AMT4_Y  														)	'금년_유출입
		
		'금분기_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN3", 0 ) = "Y" THEN 
			tbl0.SetCellString( 8, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN3", 0 ) = "A" THEN 
			tbl0.SetCellString( 8, 1, "N/A" )
		ELSE 
			Set_FgColor( 8, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M3_PLRT", 0 ) ) )
			tbl0.SetCellString( 8, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M3_PLRT", 0 ) ).."%" )
		End If
		
		tbl0.SetCellString(  9, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_PRLS_AMT5" 		, 0 ) 	)	'누적_손익금액
		tbl0.SetCellString(  5, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ASET_VLTN_AMT5"	, 0 ) 	)	'누적_기초자산
		tbl0.SetCellString(  5, 3, nMNRC_AMT5_Y - nDRNG_AMT5_Y  														)	'누적_유출입		
		
		'누적_손익률
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN4", 0 ) = "Y" THEN 
			tbl0.SetCellString( 10, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "UI_ABLE_YN4", 0 ) = "A" THEN 
			tbl0.SetCellString( 10, 1, "N/A" )
		ELSE 
			Set_FgColor( 10, 1, CDbl( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M6_PLRT", 0 ) ) )
			tbl0.SetCellString( 10, 1, FormatNumber( DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock2", "M6_PLRT", 0 ) ).."%" )
		End If
		
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgRefresh.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	Dim szData, arrData

	szData 	= Form.GetOpenLinkData()
	arrData = Split(szData, "|", -1, 1)
	
	If UBOUND(arrData) < 1 Then 'Data 없을때
		Exit Sub
	End If
	
	g_szACNO		 = arrData(0)
	g_szASNO		 = arrData(1)
	g_nUI_VLTN_AMT = arrData(2)		
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	Form.SetScreenName("기간별 수익률")

'	grd0.SetCellData( "bd_cell0", 0, "기초자산" )
'	grd0.SetCellData( "bd_cell11", 0, "유입자산" )
'	grd0.SetCellData( "bd_cell22", 0, "유출자산" )
'	grd0.SetCellData( "bd_cell33", 0, "손익금액" )
'	grd0.SetCellData( "bd_cell44", 0, "손익률(%)" )
	
'	g_szACNO =  "30062638"
'	g_szASNO = "02"
'	g_nUI_VLTN_AMT = 101440534931

	If Trim(g_szACNO) = "" Or Trim(g_szASNO) = "" Then
		Exit Sub
	End If

	DATAMANAGER.RequestTranData( "ooase_seex_084r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ASNO" 		, 0 , g_szASNO )	
	DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ACNO" 		, 0 , g_szACNO )
	DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "UI_VLTN_AMT", 0 , g_nUI_VLTN_AMT )
	
End Sub

