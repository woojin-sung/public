		g_URL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf"
	'v0004 fin
	'연금저축계좌설정 약관
	ElseIf sRevData == "P131_1" Then
		g_URL = "http://home.imeritz.com/include/resource/comm/ctcn/files/meritz_yk_32.pdf"
	'연금저축계좌설정 핵심설명서
	ElseIf sRevData == "P131_2" Then
		g_URL = "http://home.imeritz.com/include/resource/comm/ctcn/files/meritz_Pnsn_1.pdf"
	End If

	'파일약관인 경우에만 링크
	If g_URL ~= "" Or g_URL ~= null Then
	
		'LES START
		'contWeb.web0.viewtype = 0  '0.웹뷰 1.외부
		If sRevData == "1_3" Then
			contWeb.web0.loadscale = "0.9"  '전자금융약관 (IOS)찌그러짐현상 조치
		end if		
		contWeb.web0.urlpath = g_URL
		'contWeb.web0.SetScrollAutoSize()
		'LES END
	End If

End Function 



'============================================================================
Sub Form_OnFormInit()
	sRevData = Form.GetOpenLinkData()
	If sRevData ~= "" Or sRevData ~= null Then
	    User_Ctcn_Title(sRevData)
        'IOS loaddata 미조회현상으로 나눠서 처리함
        'sEventName -----------------------------------
        '2_1. 목적확인서&불법&카드
        '2_2. 예금자보호확인
        'P100_1. 주식 위탁증거금 안내 및 위험고지
        'P100_3. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
        'P118_4. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
        'MISA1_4 RP 및 CMA(RP)종목대체 동의 및 통지방법 확인(v0006)
        If sRevData == "2_1" Or sRevData == "2_2" Or sRevData == "P100_1" Or sRevData == "P100_3" Or sRevData == "P118_4" Or sRevData == "MISA1_4" Or sRevData == "P200_9" Or sRevData == "P200_10" Then
            User_Set_Ctcn(sRevData)
        Else
            'User_Open_Ctcn(sRevData)
            Form.SetTimerEvent2(1, 1, 0.3)
        End If
	End If
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
    sRevData = sEventName
    User_Ctcn_Title(sRevData)
    'IOS loaddata 미조회현상으로 나눠서 처리함
    'sEventName -----------------------------------
    '2_1. 목적확인서&불법&카드
    '2_2. 예금자보호확인
    'P100_1. 주식 위탁증거금 안내 및 위험고지
    'P100_3. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
    'P118_4. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
    'MISA1_4 RP 및 CMA(RP)종목대체 동의 및 통지방법 확인(v0006)    
    If sRevData == "2_1" Or sRevData == "2_2" Or sRevData == "P100_1" Or sRevData == "P100_3" Or sRevData == "P118_4" Or sRevData == "MISA1_4" Or sRevData == "P200_9" Or sRevData == "P200_10" Then
        User_Set_Ctcn(sRevData)
    Else
        'LES START
        Form.SetTimerEvent2(1, 1, 0.3)
        'User_Open_Ctcn(sRevData)
        'LES END
    End If
End Sub

'============================================================================
'LES START
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0.3)
	User_Open_Ctcn(sRevData)
End Sub
'LES END

'============================================================================
Sub contWeb_web0_OnLoadingFinished()
	contWeb.web0.scrollTop()

End Sub


