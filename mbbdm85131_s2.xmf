Function User_Open_Ctcn(sRevData)
	s_serverMode = Form.GetSharedData("&SERVER_MODE", false)	
	g_URL		= ""
	g_Cntt2_1	= ""		'목적확인서&불법&카드
	g_Cntt2_2	= ""		'예금자보호확인
