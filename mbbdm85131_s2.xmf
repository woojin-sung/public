<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrname="약관 및 이용고지 보기(상세)" version="2" writer="정민영" />
	<FORM_INFO name="Form" ly_vert="0,0,335,489,1" />
	<CONTROL_INFO>
		<CONTAINER name="contWeb" vscroll="1" scroll_pos="0,0" ly_vert="0,50,335,439,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<WEBVIEW name="web0" urlpath="about:blank" ly_vert="20,0,295,438,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<LABEL name="lbl" fontsize="2" fontstyle="01" multiline="1" ly_vert="10,0,300,40,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="31683" _ulen="24300" >
'--===========================================================================
' 01. 화 면 명 : 계좌개설/서비스 기본 약관
' 02. 화면설명 : [비대면계좌개설]계좌개설/서비스 기본 약관
' 03. 작    성 : 2021.01.22 : 정민영
' 04. 수    정 : 
' 2021.05.28 : 정민영: v0001 : T2105070009 : 개인신용정보동의제도 개편안 반영
' 2021.09.24 : 김유경: v0002 : 금소법관련 설명서URL 변경
' 2021.10.20 : 김수진: v0003 : 해외CFD, 중개형 ISA 추가, CFD 고난도 약관 삭제
' 2021.12.24 : 김수진: v0004 : 금융거래 정보제공 동의서 약관 추가
' 2021.03.07 : 김수진: v0005 : 예금자 보호제도 변경 > ISA 상품 개설시 예금자보호확인 안내 하다네 ISA 예금자 보호확인 안내 추가
' 2021.04.08 : 김수진: v0006 : 약관 수정
' 2022.12.15 : 전상일: v0007 : 보이스피싱 약관 추가
' 2023.02.21 : 전상일: v0008 : CFD 거래설명서 변경
'--===========================================================================
' 폼탭(mbbdm85131_p1)으로 들어가는 사이즈에 맞춤
'--===========================================================================
'< 계좌개설/서비스 기본 약관 >
'	- 종합계좌약관
'	- 입출금, 대체 및 이체거래, 증권카드 이용약관
'	- 전자금융거래 이용에 관한 기본약관
'	- 매매거래계좌설정약관		(v0006 삭제 > 종하매매계좌 파트로 이동)
'< 주요안내/위험고지 확인 >
'	- 목적확인서&불법&카드
'	- 예금자보호확인
'	- 매매주문 접수·처리방법 등 이용안내문
'	- 일중매매 위험고지
'	- 고객정보 취급방침
'	- 개인신용정보 제공.이용에 대한 고객 권리 안내(미표시)
'	- 징계내역 열람제도 안내문(미표시) (v0006 표시로변경 > 추가)
'< 개인(신용)정보 필수 동의서 >
'< 개인(신용)정보 선택 동의서 >
'< 종합매매계좌 주요약관/설명서 >
'	- 매매거래계좌설정약관		(v0006 추가)
'	- 주식 위탁증거금 안내 및 위험고지
'	- 대고객환매조건부매매약관	(v0006 삭제 RP매매시 약관교부로 변경)
'	- RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
'	- 수익증권저축약관		(v0006 삭제 펀드 가입시 약관 교부로 기 변경된 부분 반영)
'< CMA계좌 주요약관/설명서 >
'	- 증권형CMA 거래 약관
'	- 메리츠CMA 상품설명서(RP형)
'	- 대고객환매조건부매매약관	
'	- RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
'	- 수익증권저축약관		(v0006 삭제 펀드 가입시 약관 교부로 기 변경된 부분 반영)
'< 선물옵션계좌 주요약관/설명서 >
'	- 파생상품계좌설정약관
'	- 장내파생상품거래설명서
'< 해외파생계좌 주요약관/설명서 >
'	- 해외파생상품시장거래총괄계좌설정약관
'	- 해외파생상품 위험고지 및 거래설명서
'	- 외화증권매매거래설정약관
'< CFD 주요약관/설명서 >
'	- CFD 계좌설정 약관 (전문투자자용)
'	- CFD 거래설명서 (위험고지 포함)
'< 해외 CFD 주요약관/설명서 >
'	- 해외CFD계좌 계좌설정약관
'	- 해외CFD계좌 거래설명서
'< 중개형 ISA 주요약관/설명서 >
'	- 개인종합자산관리계좌(ISA) 중개형 약관
'	- 중개형ISA 설명서 
'	- 대고객환매조건부매매 약관	(v0006 삭제 RP매매시 약관교부로 변경)
'	- RP 및 CMA(RP)종목대체 동의 및 통지방법 확인 (v0006 추가)
'< CFD 주요약관/설명서 (mbbdm85131_p4)>
'	- 장외파생상품거래 기본계약서 (위험고지 포함)
'	- 장외파생상품 담보계약서
'	- 장외파생상품 투자를 위한 전문투자자 대우 확인서
'	- 개인전문투자자에 대한 보호제도 미적용 확인서
'	- 금융거래 정보제공 동의서
'--===========================================================================

Dim	g_URL
Dim	g_Cntt2_1		'목적확인서&불법&카드
Dim	g_Cntt2_2		'예금자보호확인
Dim	g_CnttP100_1		'주식 위탁증거금 안내 및 위험고지
Dim	g_CnttP100_3		'RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
Dim   s_serverMode 
'============================================================================
Function User_Ctcn_Title(sRevData)
	'중타이틀추가
	If sRevData == "1_1" Or sRevData == "1_2" Or sRevData == "1_3" Or sRevData == "1_4" Then
		lbl.caption = "계좌개설 / 서비스 기본약관"
	ElseIf sRevData == "2_1" Or sRevData == "2_2" Or sRevData == "2_3" Or sRevData == "2_4" Or sRevData == "2_5" Or sRevData == "2_6" Or sRevData == "2_7" Then
		lbl.caption = "금융거래필수안내 / 위험고지 확인"
'v0001 Sta
'	ElseIf sRevData == "Mndt" Then
'		lbl.caption = "개인(신용)정보 처리 필수 동의서"
'	ElseIf sRevData == "Slct" Then
'		lbl.caption = "개인(신용)정보 처리 선택 동의서"
'v0001 Fin
	ElseIf sRevData == "Mndt1" Then
		lbl.caption = "개인(신용)정보 처리 필수 동의서(요약)"
	ElseIf sRevData == "Mndt2" Then
		lbl.caption = "개인(신용)정보 처리 필수 동의서(상세)"
	ElseIf sRevData == "Slct1" Then
		lbl.caption = "개인(신용)정보 처리 선택 동의서(요약)"
	ElseIf sRevData == "Slct2" Then
		lbl.caption = "개인(신용)정보 처리 선택 동의서(상세)"
	ElseIf sRevData == "P100_1" Or sRevData == "P100_2" Or sRevData == "P100_3" Or sRevData == "P100_4" Or sRevData == "P100_5" Then 'v0006 P100_5 추가
		lbl.caption = "종합매매계좌 주요약관/설명서"
	ElseIf sRevData == "P200_1" Or sRevData == "P200_2" Or sRevData == "P200_3" Or sRevData == "P200_4" Or sRevData == "P200_5" Or sRevData == "P200_6" Or sRevData == "P200_7" Or sRevData == "P200_8" Or sRevData == "P200_9" Or sRevData == "P200_10" Then
		lbl.caption = "슈퍼365계좌 주요약관/설명서"
	ElseIf sRevData == "P118_1" Or sRevData == "P118_2" Or sRevData == "P118_3" Or sRevData == "P118_4" Or sRevData == "P118_5" Then
		lbl.caption = "CMA계좌 주요약관/설명서"
	ElseIf sRevData == "P101_1" Or sRevData == "P101_2" Then
		lbl.caption = "선물옵션계좌 주요약관/설명서"
	ElseIf sRevData == "P135_1" Or sRevData == "P135_2" Or sRevData == "P135_3" Then
		lbl.caption = "해외파생계좌 주요약관/설명서"
	ElseIf sRevData == "CFD_1" Or sRevData == "CFD_2" Then
		lbl.caption = "CFD계좌 주요약관/설명서"
		
	'v0003 sta
	ElseIf sRevData == "P137_1"Or sRevData == "P137_2" Then
		lbl.caption = "해외CFD계좌 약관/거래설명서"	
		
	ElseIf sRevData == "MISA1_1" Or sRevData == "MISA1_2" Or sRevData == "MISA1_3" Or sRevData == "MISA1_4" Then 'v0006 MISA1_4
		lbl.caption = "중개형 개인종합자산관리(ISA) 주요약관/설명서"		
	'v0003 fin
	
	'mbbdm85131_p4에서	
	ElseIf sRevData == "CFD1" Then
		lbl.caption = "장외파생상품거래 기본계약서\n(위험고지 포함)"		
	ElseIf sRevData == "CFD2" Then
		lbl.caption = "장외파생상품 담보계약서"		
	ElseIf sRevData == "CFD3" Then
		lbl.caption = "장외파생상품 투자를 위한\n전문투자자 대우 확인서"		
	ElseIf sRevData == "CFD4" Then
		lbl.caption = "개인전문투자자에 대한 보호제도\n미적용 확인서"	
	'v0004 sta
	ElseIf sRevData == "CFD5" Then
		lbl.caption = "금융거래 정보제공 동의서"			
	'v0004 fin	
	'연금저축 약관 추가
	ElseIf sRevData == "P131_1" Then
		lbl.caption = "연금저축계좌 주요약관/설명서"
	ElseIf sRevData == "P131_2" Then
		lbl.caption = "연금저축계좌 주요약관/설명서"
	Else
		lbl.caption = " "
	End If
End Function 
'============================================================================
Function User_Set_Ctcn(sRevData)

	g_Cntt2_1 = ""
	g_Cntt2_2 = ""
	g_CnttP100_1 = ""
	g_CnttP100_3 = ""

	'sEventName -----------------------------------
	'2_1. 목적확인서&불법&카드
	'2_2. 예금자보호확인
	'P100_1. 주식 위탁증거금 안내 및 위험고지
	'P100_3. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
	'P118_4. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
	'MISA1_4. RP 및 CMA(RP)종목대체 동의 및 통지방법 확인(v0006)
	
	' 2022.12.15 : 전상일: v0007 : 보이스피싱 약관 추가
	'소타이틀 폰트크리 14 -> 13변경 (1~2포인트(10~20%?) 축소_박정숙Cha)
	'목적확인서&불법&카드
	If Trim(sRevData) == "2_1" Then	
		g_Cntt2_1 = "<html><body>"..
		            "<font style=".."font-size:13pt".."><strong>금융거래목적확인서</strong></font><br><br>"..
		            "<font style=".."font-size:12pt"..">본인은 타인으로부터 통장대여나 개설요청을 받지 않았으며, 개설해주는 대가로 사례금을 받는 계약 및 약속을 하지 않았습니다.</font><br><br><br>"..
                     "<font style=".."font-size:13pt".."><strong>카드/통장 양도금지 설명 확인</strong></font><br><br>"..
                     "<font style=".."font-size:12pt"..">증권카드, 통장을 타인에게 양도, 대여하는 경우 손해배상 책임을 부담할 수 있고, 전자금융거래법에 의해 처벌(3년 이하의 징역 또는 2천만원 이하의 벌금)받을 수 있습니다.</font><br><br><br>"..
                     "<font style=".."font-size:13pt".."><strong>불법차명거래 금지 설명 확인</strong></font><br><br>"..
                     "<font style=".."font-size:12pt"..">「금융실명거래 및 비밀보장에 관한 법률」, 제 3조 3항에 따라 누구든지 불법재산의 은닉, 자금세탁행위, 공중협박자금조달행위 및 강제집행의 면탈, 그 밖의 탈법행위를 목적으로 타인의 실명으로 금융거래를 하여서는 아니되며, 이를 위반시 5년 이하의 징역 또는 5천만원 이하의 벌금에 처해질 수 있습니다.</font><br><br><br>"..
                     "<font style=".."font-size:13pt".."><strong>보이스피싱 예방 서비스 안내</strong></font><br><br>"..
                     "<font style=".."font-size:12pt".."><strong>①단말기 지정 서비스 </strong> : 지정된 단말(PC 및 스마트폰)에서만 공동인증서 발급, 이체(인터넷뱅킹으로 1일 누적 100만원 이상) 등 중요거래가 가능하도록 하는 서비스</font><br>"..
                     "<font style=".."font-size:12pt".."><strong>②입금계좌 지정 서비스</strong> : 온라인에서 타인계좌로 이체 시 미리 지정되지 않은 계좌에 대해서는 별도로 지정한 이체한도(1일 100만원 이내) 내에서만 이체 가능한 서비스</font><br>"..
		     "<font style=".."font-size:12pt".."><strong>③지연이체 서비스</strong>  : 온라인에서 이체 시 이체 요청 이후 일정시간(2시간 30분) 경과 후 입금되는 서비스 </font><br><br>"..
                     "</body></html>"
         contWeb.web0.loaddata = g_Cntt2_1

	'예금자보호확인
	ElseIf Trim(sRevData) == "2_2" Then	
		'v0005 ISA 예금자 보호 확인 추가
		g_Cntt2_2 = "<html><body>"..
		            "<font style=".."font-size:13pt".."><strong>예금자보호확인</strong></font><br><br>"..
		            "<font style=".."font-size:12pt"..">이 금융상품은 예금자보호법에 따라 예금보험공사가 보호하지 않습니다.<br>"..
		            "다만, 예탁금 중 증권의 매수에 사용되지 않고 고객계좌에 현금으로 남아 있는 금액은 예금자보호법에 따라 예금보험공사가 보호하되, 보호한도는 본 금융회사에 있는 귀하의 모든 예금보호대상 금융상품의 원금과 소정의 이자를 합하여 1인당 최고 5천만원이며, 5천만원을 초과하는 나머지 금액은 보호하지 않습니다.(선물·옵션거래예수금 등 예금자보호법에서 보호하지 않는 경우 제외)</font><br><br><br>"..
		            "<font style=".."font-size:13pt".."><strong>ISA 예금자보호확인</strong></font><br><br>"..
		            "<font style=".."font-size:12pt"..">이 개인종합자산관리계좌(ISA)에 편입된 금융상품 중 예금보호 대상으로 운용되는 금융상품에 한하여 예금자보호법에 따라 예금자보험공사가 보호하되, "..
		            "보호 한도는 금융상품을 판매한 금융회사별로 귀하의 모든 금융상품의 원금과 소정의 이자를 합하여 1인당 “최고 5천만원”이며, 5천만원을 초과하는 나머지 금액은 보호하지 않습니다.</font><br><br>".. 	
                     "</body></html>"
         contWeb.web0.loaddata = g_Cntt2_2

	'주식 위탁증거금 안내 및 위험고지
	ElseIf Trim(sRevData) == "P100_1" Or Trim(sRevData) == "P200_9" Then	
		g_CnttP100_1 = "<html><body>"..
		            "<font style=".."font-size:13pt".."><strong>주식 위탁증거금 안내 및 위험고지</strong></font><br><br>"..
		            "<font style=".."font-size:12pt"..">▶100%, 100%(수수료포함) 증거금률을 선택하는 경우 위탁증거금(보유현금) 이내에서만 매매가 가능하며, 이를 초과한 주문은 불가능합니다. 다만 이 경우에도 제비용으로 인한 미수는 발생할 수 있습니다.<br>"..
                     "▶10만원을 초과하는 미수금 발생 시 발생 당일 미수금을 변제하지 못하면 30일간 미수동결로 지정되오니 주의하시기 바라며, 미수동결로 지정되었을 경우 미수동결 정보의 등록/변동/해제 등의 내용이 타 증권사와 공유, 활용됩니다.</font><br><br>"..
                     "</body></html>"
         contWeb.web0.loaddata = g_CnttP100_1

	'RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
	'v0006 MISA1_4 추가
	ElseIf Trim(sRevData) == "P100_3" Or Trim(sRevData) == "P118_4" Or Trim(sRevData) == "MISA1_4" Or Trim(sRevData) == "P200_10" Then					
		g_CnttP100_3 = "<html><body>"..
		            "<font style=".."font-size:13pt".."><strong>RP 및 CMA(RP)종목대체 동의 및 통지방법 확인</strong></font><br><br>"..
		            "<font style=".."font-size:12pt"..">▶RP 및 CMA(RP)종목대체 동의 및 통지방법 확인<br>"..
                     "당사는 ［금융투자업규정］제 5-18조에 의거 RP 매매대상 유가증권을 정부발행 채권과 신용등급 A등급 이상의 우량채권만으로 운용하고 있습니다. [금융투자업규정]제 5-22조에 의거 RP 거래기간동안 고객계좌에 편입된 채권을 종목대체하는 경우, 신용등급의 변경이나 시장가액의 변동을 포함하는 종목대체에 사전 동의한 것으로 합니다.<br><br>"..
		            "▶거래내역 확인 및 통지<br>"..
			       "종목대체 내역 및 세부거래 내역은 영업점, HTS, 당사 인터넷 홈페이지, 유선등을 통하여 확인 및 출력 통지가 상시 가능합니다.</font><br><br>"..
                     "</body></html>"
         contWeb.web0.loaddata = g_CnttP100_3	

	End If
	
	contWeb.web0.SetScrollAutoSize()
	 
End Function
