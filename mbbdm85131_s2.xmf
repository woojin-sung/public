	'< 계좌개설/서비스 기본 약관 > -----------------------------------------
	If sRevData == "1_1" Then
		'종합계좌약관
		g_URL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_21.html"

	ElseIf sRevData == "1_2" Then
