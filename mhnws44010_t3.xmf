'============================================================================
' 01. 화 면 명 : 시황브리핑
' 02. 화면설명 : 시황브리핑
' 03. 작    성 : 2016. 01. 28. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tExchange, g_tExchangeCode	'환율을 표시할 나라 그룹, 코드
Dim g_TabIndex		'라디오 버튼에 따른 테이블 구분Index
Dim g_tRate	'금리 그룹
Dim g_tCode	'시황 코드

g_tExchange = {"원/달러","원/엔","원/위안"}
g_tExchangeCode = {"USDKRWSMBS","JPYKRWCOMP","CNYKRWCOMP"}
g_tRage = {"CD금리(91일)","회사채(3년,AA-)","국고채(3년)"}
g_tCode = {"EX","KI","UI"}
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Function TableClear() : Table Clear
'============================================================================
Function TableClear()

	tbl0.GetCellString( 0, 0)
	tbl0.GetCellString( 0, 1)
	tbl0.GetCellString( 0, 2)
	tbl0.GetCellString( 0, 3)
	tbl0.GetCellString( 0, 4)
	tbl0.GetCellString( 1, 0)
	tbl0.GetCellString( 1, 1)
	tbl0.GetCellString( 1, 2)
	tbl0.GetCellString( 1, 3)
	tbl0.GetCellString( 1, 4)
	tbl0.GetCellString( 2, 0)
	tbl0.GetCellString( 2, 1)
	tbl0.GetCellString( 2, 2)
	tbl0.GetCellString( 2, 3)
	tbl0.GetCellString( 2, 4)

End Function
'============================================================================
' SetTable(nIndex) : 테이블에 값 세팅 하는 함수
'============================================================================
Function SetTable(nIndex)
	
'	for i = 0 to 2
		if nIndex == 0 then
			for i = 0 to 2
				tbl0.SetCellString( i , 0 , g_tExchange(i) )
								
				DATAMANAGER.SetDataValue( 0 , "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "EN" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tExchangeCode(i) )
			next
			
			DATAMANAGER.SetDataValue(0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , g_tCode(0))
			DATAMANAGER.SetDataValue(0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , 1 )
		
			DATAMANAGER.RequestTranData( "ohhts_1684_001r" )
			
		elseif nIndex == 1 then
			
			for i = 0 to 2
				tbl0.SetCellString( i , 0 , g_tRage(i) )
				
				DATAMANAGER.SetDataValue( 0 , "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_CLCD" , 0, "5")
				DATAMANAGER.SetDataValue( 0 , "obfni_rmss_140r_1", "InBlock1", "OVRS_PRMR_NMIX_CLCD" , 0, "4")
				DATAMANAGER.SetDataValue( 0 , "obfni_rmss_140r_2", "InBlock1", "OVRS_PRMR_NMIX_CLCD" , 0, "6")
			next
			
			DATAMANAGER.SetDataValue(0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , g_tCode(1))
			DATAMANAGER.SetDataValue(0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , 1 )
			
			DATAMANAGER.RequestTranData( "obfni_rmss_140r" )		'회사채 2년,AA-
			DATAMANAGER.RequestTranData( "obfni_rmss_140r_1" )	'국고채 3년
			DATAMANAGER.RequestTranData( "obfni_rmss_140r_2" )	'CD금리
	
		elseif nIndex == 2 then
			
			for i = 0 to 2
				tbl0.SetCellString( i , 0 , g_tRage(i) )
			
				DATAMANAGER.SetDataValue( 0 , "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_CLCD" , 0, "5")
				DATAMANAGER.SetDataValue( 0 , "obfni_rmss_140r_1", "InBlock1", "OVRS_PRMR_NMIX_CLCD" , 0, "4")
				DATAMANAGER.SetDataValue( 0 , "obfni_rmss_140r_2", "InBlock1", "OVRS_PRMR_NMIX_CLCD" , 0, "6")
			next
		
			DATAMANAGER.SetDataValue(0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , g_tCode(2))
			DATAMANAGER.SetDataValue(0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , 1 )
			
			DATAMANAGER.RequestTranData( "obfni_rmss_140r" )
			DATAMANAGER.RequestTranData( "obfni_rmss_140r_1" )
			DATAMANAGER.RequestTranData( "obfni_rmss_140r_2" )
			
		end if
'	next
	
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit() : Table의 초기값을 정해준뒤 테이블값 세팅
'============================================================================
Sub Form_OnFormInit()

	g_TabIndex = 0
	
	TableClear()
	
	Call SetTable(g_TabIndex)
End Sub

'============================================================================
' rdo0_OnClick(nIndex) : 라디오 선택값에 따른 Index를 테이블값 세팅 함수에 전달
'============================================================================
Sub rdo0_OnClick(nIndex)

	g_TabIndex = nIndex
	
	TableClear()
	
	Call SetTable(g_TabIndex)
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_1684_001r" then
	
		tbl0.SetCellMaskInfo( 2, 1, "0,0,,,1,,2,1,0")		'마스크처리
		tbl0.SetCellMaskInfo( 2, 3, "0,0,,,1,,2,1,0")
			
		for i = 0 to 2
			if i == 1 then
				if DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i) == "5" then
					tbl0.SetCellString( i , 1 , -DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
				else
					tbl0.SetCellString( i , 1 , DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
				end if
				tbl0.SetCellString( i , 2 , DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i))
				tbl0.SetCellString( i , 3 , DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , i))
				tbl0.SetCellString( i , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_DATE" , i) , 4) )
			else
				if DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i) == "5" then
					tbl0.SetCellString( i , 1 , -DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
				else
					tbl0.SetCellString( i , 1 , DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
				end if
				tbl0.SetCellString( i , 2 , DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i))
				tbl0.SetCellString( i , 3 , DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , i))
				tbl0.SetCellString( i , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "ohhts_1684_001r", "OutBlock1", "FID_CNCN_DATE" , i) , 4) )
			end if
		next
	elseif szTranID == "obfni_rmss_140r" then
	
		tbl0.SetCellMaskInfo( 2, 1, "0,0,,,1,,4,1,0")		'마스킹
		tbl0.SetCellMaskInfo( 2, 3, "0,0,,,1,,4,1,0")
			
		if DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0) == "5" then
			tbl0.SetCellString( 1 , 1 , -DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0))
		else
			tbl0.SetCellString( 1 , 1 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0))
		end if
		tbl0.SetCellString( 1 , 2 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0))
		'TR에서 음수값이여도 - 부호가 나오지 않아서 증감색이 제대로 안나오는 부분을 수정
		if DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0) == "5" then
			tbl0.SetCellString( 1 , 3 , -DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0))
		else
			tbl0.SetCellString( 1 , 3 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0))
		end if
		tbl0.SetCellString( 1 , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , 0) , 4) )
	elseif szTranID == "obfni_rmss_140r_1" then
	
		tbl0.SetCellMaskInfo( 2, 1, "0,0,,,1,,4,1,0")		'마스킹
		tbl0.SetCellMaskInfo( 2, 3, "0,0,,,1,,4,1,0")
			
		if DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0) == "5" then
			tbl0.SetCellString( 2 , 1 , -DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0))
		else
			tbl0.SetCellString( 2 , 1 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0))
		end if
		
		tbl0.SetCellString( 2 , 2 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0))
		'TR에서 음수값이여도 - 부호가 나오지 않아서 증감색이 제대로 안나오는 부분을 수정
		if DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0) == "5" then
			tbl0.SetCellString( 2 , 3 , -DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0))
		else
			tbl0.SetCellString( 2 , 3 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0))
		end if
		tbl0.SetCellString( 2 , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , 0) , 4) )
	elseif szTranID == "obfni_rmss_140r_2" then
		
		tbl0.SetCellMaskInfo( 2, 1, "0,0,,,1,,4,1,0")		'마스킹
		tbl0.SetCellMaskInfo( 2, 3, "0,0,,,1,,4,1,0")
			
		if DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 1) == "5" then
			tbl0.SetCellString( 0 , 1 , -DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 1))
		else
			tbl0.SetCellString( 0 , 1 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 1))
		end if
		
		tbl0.SetCellString( 0 , 2 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 1))
		'TR에서 음수값이여도 - 부호가 나오지 않아서 증감색이 제대로 안나오는 부분을 수정
		if DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 1) == "5" then
			tbl0.SetCellString( 0 , 3 , -DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 1))
		else
			tbl0.SetCellString( 0 , 3 , DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 1))
		end if
		tbl0.SetCellString( 2 , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , 1) , 4) )
	elseif szTranID == "ohhts_news_008r" then
		Dim szText
		Dim szTemp
		
		szText = ""
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_news_008r", "OutBlock1") - 1
			szTemp = DATAMANAGER.GetDataValue( 0, "ohhts_news_008r", "OutBlock1", "FID_NEWS_CNTT" , i)
			szText = szText & szTemp
		next
			web0.loaddata = "<html><body>"&szText&"</body></html>"
	end if
End Sub
'============================================================================
' btn0_OnClick() : 팝업에 보내는 입력값
'============================================================================
Sub btn0_OnClick()
	Dim szData
	
	if g_TabIndex == 0 then
		szData = "EX" & "☆" & "2" & "☆" &"환율"
	elseif g_TabIndex == 1 then
		szData = "KI" & "☆" & "2" & "☆" &"국내금리"
	elseif g_TabIndex == 2 then
		szData = "UI" & "☆" & "2" & "☆" &"국제금리"
	end if
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
End Sub
'============================================================================
' btn1_OnClick() : 팝업에 보내는 입력값
'============================================================================
Sub btn1_OnClick()
	Dim szData
	
	if g_TabIndex == 0 then
		szData = "EX" & "☆" & "3" & "☆" &"환율"
	elseif g_TabIndex == 1 then
		szData = "KI" & "☆" & "3" & "☆" &"국내금리"
	elseif g_TabIndex == 2 then
		szData = "UI" & "☆" & "3" & "☆" &"국제금리"
	end if
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
End Sub
'============================================================================
' tbl0_OnClick(lRow , lColumn)
'============================================================================
Sub tbl0_OnClick(lRow , lColumn)
	Dim szData
	Dim szCode
	Dim szMarket
	Dim szName
	
	szCode = grd0.GetCellData("bd_cell0", lRow)
	szMarket = grd0.GetCellData("bd_cell1", lRow)
	if lRow == 0 then			'달러 환율일때 종목명이 내려오지 않아서 하드코딩
		szName = "한국 원/미국 달러"
	else
		szName = grd0.GetCellData("bd_cell2", lRow)
	end if
	
	if g_TabIndex == 0 then	'환율일때만
		'종목코드, 시장구분, 종목명
		szData = szCode & "★" & szMarket & "★" & szName
		Form.OpenFramePopup("mhidx42040_p1.xmf" , szData , sPosInfo)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1684_001r" )
	DATAMANAGER.ClearTranConnectedCtrl( "obfni_rmss_140r" )
	DATAMANAGER.ClearTranConnectedCtrl( "obfni_rmss_140r_1" )
	DATAMANAGER.ClearTranConnectedCtrl( "obfni_rmss_140r_2" )
	
	DATAMANAGER.ClearOutputData( 0 , "ohhts_1684_001r" )
	DATAMANAGER.ClearOutputData( 0 , "obfni_rmss_140r" )
	DATAMANAGER.ClearOutputData( 0 , "obfni_rmss_140r_1" )
	DATAMANAGER.ClearOutputData( 0 , "obfni_rmss_140r_2" )
End Sub

