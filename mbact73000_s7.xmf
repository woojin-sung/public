'============================================================================
Sub contMain_contMndt_imgCtcnChk_OnClick()
	'체크 설정
	if g_BDM_CtcnChkMndt == "Y" then
		g_BDM_CtcnChkMndt = "N"
	else
		g_BDM_CtcnChkMndt = "Y"
	end if

	'개인(신용)정보처리필수동의 항목 일괄설정
'v0001 Sta
'	If g_BDM_MndtC_N <> "Y" Then
'        g_BDM_MndtC	= g_BDM_CtcnChkMndt	'(공통)고유식별정보처리
'	End If
'	If g_BDM_MndtD_N <> "Y" Then
'	    g_BDM_MndtD	= g_BDM_CtcnChkMndt	'(상품)조회
'	End If
'	If g_BDM_MndtE1_N <> "Y" Then
'	    g_BDM_MndtE1	= g_BDM_CtcnChkMndt	'(상품)신용정보조회및집중
'	End If
'	If g_BDM_MndtE2_N <> "Y" Then
'	    g_BDM_MndtE2	= g_BDM_CtcnChkMndt	'(상품)해외증권/파생
'	End If
'	If g_BDM_CtcnChkMndt = "Y" Then 
'	    g_BDM_MndtE = "Y" 
'	Else
'	    If g_BDM_MndtE1 == "Y" Or g_BDM_MndtE2 == "Y" Then
'	        g_BDM_MndtE = "Y" 
'	    Else
'	        g_BDM_MndtE = "N" 
'	    End If
'	End If
'	If g_BDM_MndtF_N <> "Y" Then
'	    g_BDM_MndtF	= g_BDM_CtcnChkMndt	'(상품)민감정보	
'	End If
'v0001 Fin
	'1.1 수집이용(공통) ------------------------------
    g_BDM_Mndt_1_1_1_1 =  g_BDM_CtcnChkMndt '1.1 수집이용(공통)_고유식별                                 
    g_BDM_Mndt_1_1_1_2 =  g_BDM_CtcnChkMndt '1.1 수집이용(공통)_개인신용
    '1.2 수집이용(상품) ------------------------------
    '종합매매 미수가능/불가는 다음단계에서 선태갛므로 미수가능 유형으로 징구(임시저장)=> 개설완료시점에 개설상품에 따라 이력 생성/미생성함
    If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCDCFD = "Y" Or g_BDM_PRCD200 = "Y" Then   'v0007 다드림추가
        g_BDM_Mndt_1_2_1_1 =  g_BDM_CtcnChkMndt '1.2 수집이용(상품)_신용/미수/파생_고유식별                  
        g_BDM_Mndt_1_2_1_2 =  g_BDM_CtcnChkMndt '1.2 수집이용(상품)_신용/미수/파생_개인신용
    Else
        g_BDM_Mndt_1_2_1_1 = ""
        g_BDM_Mndt_1_2_1_2 = ""
    End If
    If g_BDM_PRCD133 = "Y" Or g_BDM_PRCD131 == "Y" Then	
        g_BDM_Mndt_1_2_2_1 =  g_BDM_CtcnChkMndt '1.2 수집이용(상품)_비과세/ISA/연금저축_고유식별
        '현재 민감정보 받는 상품가입은 없음
        g_BDM_Mndt_1_2_2_3 =  "" 			  '1.2 수집이용(상품)_비과세/ISA/연금저축_민감정보             
        g_BDM_Mndt_1_2_2_2 =  g_BDM_CtcnChkMndt '1.2 수집이용(상품)_비과세/ISA/연금저축_개인신용             
    Else
        g_BDM_Mndt_1_2_2_1 = ""
        g_BDM_Mndt_1_2_2_3 = ""
        g_BDM_Mndt_1_2_2_2 = ""
    End If
    If g_BDM_PRCD135 = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y" Then	'CFD추가 v0002 해외CFD 추가 'v0007 다드림추가
        g_BDM_Mndt_1_2_3_1 =  g_BDM_CtcnChkMndt '1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_고유식별
        g_BDM_Mndt_1_2_3_2 =  g_BDM_CtcnChkMndt '1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
    Else
	    g_BDM_Mndt_1_2_3_1 = ""
	    g_BDM_Mndt_1_2_3_2 = ""
    End If
    '2.1 제공(상품) ----------------------------------
    If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCD135  = "Y" Or g_BDM_PRCDCFD = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y" Then  'CFD추가 v0002 해외CFD 추가 'v0007 다드림추가
        g_BDM_Mndt_2_1_1_1 =  g_BDM_CtcnChkMndt '2.1 제공(상품)_신용/미수/파생/해외파생_고유식별             
        g_BDM_Mndt_2_1_1_2 =  g_BDM_CtcnChkMndt '2.1 제공(상품)_신용/미수/파생/해외파생_개인신용             
    Else
        g_BDM_Mndt_2_1_1_1 = ""
        g_BDM_Mndt_2_1_1_2 = ""
    End If
    If g_BDM_PRCD135  = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y" Then	'CFD추가 v0002 해외CFD 추가 'v0007 다드림추가
        g_BDM_Mndt_2_1_2_1 =  g_BDM_CtcnChkMndt '2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_고유식별    
        g_BDM_Mndt_2_1_2_2 =  g_BDM_CtcnChkMndt '2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
	Else
        g_BDM_Mndt_2_1_2_1 = ""
        g_BDM_Mndt_2_1_2_2 = ""
	End If
	
    '3 조회(상품) ----------------------------------
    If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCD135  = "Y" Or g_BDM_PRCDCFD = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y" Then  'CFD추가 v0002 해외CFD 추가 'v0007 다드림추가
        g_BDM_Mndt_3_1_1_1 =  g_BDM_CtcnChkMndt '3   조회(상품)_신용/미수/파생/해외파생_고유식별             
        g_BDM_Mndt_3_1_1_2 =  g_BDM_CtcnChkMndt '3   조회(상품)_신용/미수/파생/해외파생_개인신용             
    Else
        g_BDM_Mndt_3_1_1_1 = ""
        g_BDM_Mndt_3_1_1_2 = ""
    End If

	User_Chk_All()  '개별체크에 따른 모두동의 체크설정
	User_Chk_Next("Mndt", g_BDM_CtcnChkMndt)
End Sub
