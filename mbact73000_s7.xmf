'============================================================================
Function User_Chk_Image_Set(trgt, chk)

	'A.모두동의(imgCtcnChkAll)
	if trgt == "A" then
		if chk == "Y" then
			contMain.imgCtcnChkAll.imgpath = "check_square_on.png"
		else
			contMain.imgCtcnChkAll.imgpath = "check_square_off.png"
		end if

	'1.계좌개설/서비스기본약관(contMain.contCtcn1.imgCtcnChk)
	elseif trgt == "1" or trgt == 1 then
		if chk == "Y" then
			contMain.contCtcn1.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contCtcn1.imgCtcnChk.imgpath = "check_off.png"
		end if

	'2.금융거래필수안내/위험고지 확인(contMain.contCtcn2.imgCtcnChk)
	elseif trgt == "2" or trgt == 2 then
		if chk == "Y" then
			contMain.contCtcn2.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contCtcn2.imgCtcnChk.imgpath = "check_off.png"
		end if

	'P100.종합매매계좌 주요약관/설명서(contMain.contPrcd100.imgCtcnChk)
	elseif trgt == "P100" then
		if chk == "Y" then
			contMain.contPrcd100.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contPrcd100.imgCtcnChk.imgpath = "check_off.png"
		end if
	
	'P200.슈퍼365계좌 주요약관/설명서(contMain.contPrcd100.imgCtcnChk)
	elseif trgt == "P200" then
		if chk == "Y" then
			contMain.contPrcd200.imgCtcnChk1.imgpath = "check_on.png"
		else
			contMain.contPrcd200.imgCtcnChk1.imgpath = "check_off.png"
		end if

	'P118.CMA계좌 주요약관/설명서(contMain.contPrcd118RP.imgCtcnChk)
	elseif trgt == "P118" then
		if chk == "Y" then
			contMain.contPrcd118RP.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contPrcd118RP.imgCtcnChk.imgpath = "check_off.png"
		end if

	'P101.선물옵션계좌 주요약관/설명서(contMain.contPrcd101.imgCtcnChk)
	elseif trgt == "P101" then
		if chk == "Y" then
			contMain.contPrcd101.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contPrcd101.imgCtcnChk.imgpath = "check_off.png"
		end if

	'P135.선물옵션계좌 주요약관/설명서(contMain.contPrcd135.imgCtcnChk)
	elseif trgt == "P135" then
		if chk == "Y" then
			contMain.contPrcd135.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contPrcd135.imgCtcnChk.imgpath = "check_off.png"
		end if


	'CFD.CFD계좌 주요약관/설명서(contMain.contPrcdCFD.imgCtcnChk)
	elseif trgt == "CFD" then
		if chk == "Y" then
			contMain.contPrcdCFD.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contPrcdCFD.imgCtcnChk.imgpath = "check_off.png"
		end if
		
	'v0002 sta MISA 중개형 ISA 주요약관/설명서(contMain.contPrcdMISA.imgCtcnChk)
	elseif trgt == "MISA1" then
		if chk == "Y" then
			contMain.contPrcdMISA.imgCtcnChk1.imgpath = "check_on.png"
		else
			contMain.contPrcdMISA.imgCtcnChk1.imgpath = "check_off.png"
		end if
	
		
	'v0002 sta 해외CFD 주요약관/설명서(contMain.contPrcd137.imgCtcnChk)
	elseif trgt == "P137" then
		if chk == "Y" then
			contMain.contPrcd137.imgCtcnChk1.imgpath = "check_on.png"
		else
			contMain.contPrcd137.imgCtcnChk1.imgpath = "check_off.png"
		end if
	'v0002 fin

	'연금저축, 랩 추가
	elseif trgt == "P131" then
		if chk == "Y" then
			contMain.contPrcd131.imgCtcnChk1.imgpath = "check_on.png"
		else
			contMain.contPrcd131.imgCtcnChk1.imgpath = "check_off.png"
		end if
	
	'Mndt.개인(신용)정보 처리 필수 동의서(contMain.contMndt.imgCtcnChk)
	elseif trgt == "Mndt" then
		if chk == "Y" then
			contMain.contMndt.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contMndt.imgCtcnChk.imgpath = "check_off.png"
		end if

	'Slct.선물옵션계좌 주요약관/설명서(contMain.contSlct.imgCtcnChk)
	elseif trgt == "Slct" then
		if chk == "Y" then
			contMain.contSlct.imgCtcnChk.imgpath = "check_on.png"
		else
			contMain.contSlct.imgCtcnChk.imgpath = "check_off.png"
		end if
		
	end if
	
	User_Chk_All()
End Function 
'============================================================================
Function User_Chk_Next(trgt, chk)
	'Y/N 설정
	if trgt == "A" then
		g_BDM_CtcnChkAll	= chk	'전체
		g_BDM_CtcnChk1	= chk	'계좌개설/서비스기본약관
		g_BDM_CtcnChk2	= chk	'금융거래필수안내/위험고지 확인
		
		'v0007 : 다드림 추가(개인신용정보 동의 - 종합매매(주식) 와 동일)
		'v0002 Sta : v0001 All chk 오류 수정
	    if g_BDM_PRCD100 == "Y" or g_BDM_PRCD100F == "Y" then		'종합매매,종합매매(금상전용)
			g_BDM_CtcnChk100	= chk	'종합매매계좌 주요약관/설명서
		end if
		if g_BDM_PRCD200 == "Y" then		'슈퍼365
			g_BDM_CtcnChk200	= chk
		end if
		if g_BDM_PRCD118RP == "Y" then		'CMA
			g_BDM_CtcnChk118	= chk	'CMA계좌 주요약관/설명서
		end if
		if g_BDM_PRCDCFD == "Y" then		'CFD
			g_BDM_CtcnChkCFD	= chk	'CFD계좌 주요약관/설명서
		end if
		if g_BDM_PRCD137 == "Y" then		'해외CFD
			g_BDM_137_CtcnChk1 = chk	'해외CFD계좌약관/거래설명서(위험고지)
		end if
		if g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3" then		'중개형 ISA
			g_BDM_MISA_CtcnChk1 = chk	'중개형 ISA 주요약관/설명서
		end if
		if g_BDM_PRCD101 == "Y" then		'선물옵션
			g_BDM_CtcnChk101	= chk	'선물옵션계좌 주요약관/설명서
		end if
		if g_BDM_PRCD135 == "Y" then		'해외파생
			g_BDM_CtcnChk135	= chk	'해외파생계좌 주요약관/설명서
		end if
		if g_BDM_PRCD131 == "Y" then		'연금저축
			g_BDM_131_CtcnChk	= chk	'연금저축계좌설정약관/설명서
		end if 
		'v0002 fin
		
		g_BDM_CtcnChkMndt	= chk	'개인(신용)정보 처리 필수 동의서
		g_BDM_CtcnChkSlct	= chk	'개인(신용)정보 처리 선택 동의서
		'G_STEP2_2_P2_FILE 설정정보 -------------------------------------
'v0001 Sta
'		g_BDM_MndtC		= chk  	'(공통)고유식별정보처리
'		g_BDM_MndtD		= chk  	'(상품)조회
'		g_BDM_MndtE		= chk  	'(상품)제공
'		g_BDM_MndtE1		= chk  	'(상품)신용정보조회및집중
'		g_BDM_MndtE2		= chk  	'(상품)해외증권/파생
'		g_BDM_MndtF		= chk  	'(상품)민감정보
'v0001 Fin
		'v0002 Sta : v0001 All chk 오류 수정
		'1.1 수집이용(공통) ------------------------------
	    g_BDM_Mndt_1_1_1_1 =  chk '1.1 수집이용(공통)_고유식별                                 
	    g_BDM_Mndt_1_1_1_2 =  chk '1.1 수집이용(공통)_개인신용
	    '1.2 수집이용(상품) ------------------------------
	    '종합매매 미수가능/불가는 다음단계에서 선태갛므로 미수가능 유형으로 징구(임시저장)=> 개설완료시점에 개설상품에 따라 이력 생성/미생성함
	    ' v0007 : 다드림 추가(개인신용정보 동의 - 종합매매(주식) 와 동일)
	    If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCDCFD = "Y"  Or g_BDM_PRCD200 = "Y" Then  
			g_BDM_Mndt_1_2_1_1 =  chk '1.2 수집이용(상품)_신용/미수/파생_고유식별                  
			g_BDM_Mndt_1_2_1_2 =  chk '1.2 수집이용(상품)_신용/미수/파생_개인신용
	    Else
			g_BDM_Mndt_1_2_1_1 = ""
			g_BDM_Mndt_1_2_1_2 = ""
	    End If
	    If g_BDM_PRCD133 = "Y" Or g_BDM_PRCD131 == "Y" Then	
			g_BDM_Mndt_1_2_2_1 =  chk '1.2 수집이용(상품)_비과세/ISA/연금저축_고유식별
			'현재 민감정보 받는 상품가입은 없음
			g_BDM_Mndt_1_2_2_3 =  "" 			  '1.2 수집이용(상품)_비과세/ISA/연금저축_민감정보             
			g_BDM_Mndt_1_2_2_2 =  chk '1.2 수집이용(상품)_비과세/ISA/연금저축_개인신용             
	    Else
			g_BDM_Mndt_1_2_2_1 = ""
			g_BDM_Mndt_1_2_2_3 = ""
			g_BDM_Mndt_1_2_2_2 = ""
	    End If
	    If g_BDM_PRCD135 = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y"  Then		'CFD추가 v0002 해외CFD 추가 'v0007 : 다드림 추가
			g_BDM_Mndt_1_2_3_1 =  chk '1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_고유식별
			g_BDM_Mndt_1_2_3_2 =  chk '1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
	    Else
		    g_BDM_Mndt_1_2_3_1 = ""
		    g_BDM_Mndt_1_2_3_2 = ""
	    End If
	    '2.1 제공(상품) ----------------------------------
	    If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCD135  = "Y" Or g_BDM_PRCDCFD = "Y" Or g_BDM_PRCD137 = "Y"  Or g_BDM_PRCD200 = "Y" Then  'CFD추가 v0002 해외CFD 추가 'v0007 : 다드림 추가
			g_BDM_Mndt_2_1_1_1 =  chk '2.1 제공(상품)_신용/미수/파생/해외파생_고유식별             
			g_BDM_Mndt_2_1_1_2 =  chk '2.1 제공(상품)_신용/미수/파생/해외파생_개인신용             
	    Else
			g_BDM_Mndt_2_1_1_1 = ""
			g_BDM_Mndt_2_1_1_2 = ""
	    End If
	    If g_BDM_PRCD135  = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y" Then	'CFD추가 v0002 해외CFD 추가 'v0007 : 다드림 추가
			g_BDM_Mndt_2_1_2_1 =  chk '2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_고유식별    
			g_BDM_Mndt_2_1_2_2 =  chk '2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
		Else
			g_BDM_Mndt_2_1_2_1 = ""
			g_BDM_Mndt_2_1_2_2 = ""
		End If
		
	    '3 조회(상품) ----------------------------------
	    If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCD135  = "Y" Or g_BDM_PRCDCFD = "Y" Or g_BDM_PRCD137 = "Y" Or g_BDM_PRCD200 = "Y" Then  'CFD추가 v0002 해외CFD 추가 ' v0007 : 다드림 추가
			g_BDM_Mndt_3_1_1_1 =  chk '3   조회(상품)_신용/미수/파생/해외파생_고유식별             
			g_BDM_Mndt_3_1_1_2 =  chk '3   조회(상품)_신용/미수/파생/해외파생_개인신용             
	    Else
			g_BDM_Mndt_3_1_1_1 = ""
			g_BDM_Mndt_3_1_1_2 = ""
	    End If
	    'v0002 fin
		'G_STEP2_2_P3_FILE 설정정보 -------------------------------------
'v0001 Sta
'		g_BDM_SlctG		= chk  	'(선택)수집이용
'		g_BDM_SlctH		= chk  	'(선택)고유식별정보처리
'v0001 Fin
		g_BDM_Slct_1_1 	= chk	'수집이용_고유식별
		g_BDM_Slct_1_2	= chk	'수집이용_개인신용
		g_BDM_Slct_2_1	= chk	'상품서비스안내
		g_BDM_SlctTel		= chk  	'홍보수신_전화
		g_BDM_SlctSMS		= chk  	'홍보수신_문자
		g_BDM_SlctEmail	= chk  	'홍보수신_이메일
		g_BDM_SlctPost	= chk  	'홍보수신_우편

	elseif trgt == "1" or trgt == 1 then
		g_BDM_CtcnChk1	= chk
	elseif trgt == "2" or trgt == 2 then
		g_BDM_CtcnChk2	= chk
	elseif trgt == "P100" then
		g_BDM_CtcnChk100 = chk
	elseif trgt == "P200" then
		g_BDM_CtcnChk200 = chk
	elseif trgt == "P118" then
		g_BDM_CtcnChk118 = chk
	elseif trgt == "P101" then
		g_BDM_CtcnChk101 = chk
	elseif trgt == "P135" then
		g_BDM_CtcnChk135 = chk
	
	'연금저축, 랩 추가
	elseif trgt == "P131" then
		g_BDM_131_CtcnChk = chk
		
	elseif trgt == "CFD" then
		g_BDM_CtcnChkCFD = chk
		
	'v0002 sta
	elseif trgt == "MISA1" then
		g_BDM_MISA_CtcnChk1 = chk
		
	elseif trgt == "P137" then		'
		g_BDM_137_CtcnChk1 = chk
	'v0002 fin
	
	elseif trgt == "Mndt" then
		g_BDM_CtcnChkMndt = chk
	elseif trgt == "Slct" then
		g_BDM_CtcnChkSlct = chk
	end if
	
	'Y/N 설정에 따른 색상표시
	User_Chk_Image_Set(trgt, chk)
	if trgt == "A" then
		User_Chk_Image_Set("1", chk)	'계좌개설/서비스기본약관
		User_Chk_Image_Set("2", chk)	'금융거래필수안내/위험고지 확인
		User_Chk_Image_Set("Mndt", chk)	'개인(신용)정보 처리 필수 동의서
		User_Chk_Image_Set("Slct", chk)	'개인(신용)정보 처리 선택 동의서
		if g_BDM_PRCD100 == "Y" or g_BDM_PRCD100F == "Y" then ' v0007 : 다드림 추가
			User_Chk_Image_Set("P100", chk)	'종합매매계좌 주요약관/설명서
		end if
		if g_BDM_PRCD200 == "Y" then
			User_Chk_Image_Set("P200", chk)	'슈퍼365계좌 주요약관/설명서
		end if
		if g_BDM_PRCD118RP == "Y" then
			User_Chk_Image_Set("P118", chk)	'CMA계좌 주요약관/설명서
		end if
		if g_BDM_PRCD101 == "Y" then
			User_Chk_Image_Set("P101", chk)	'선물옵션계좌 주요약관/설명서
		end if
		if g_BDM_PRCD135 == "Y" then
			User_Chk_Image_Set("P135", chk)	'해외파생계좌 주요약관/설명서
		end if
		
		if g_BDM_CtcnChkCFD == "Y" then
			User_Chk_Image_Set("CFD", chk)	'CFD계좌 주요약관/설명서
		end if
		
		'v0002 sta
		if g_BDM_MISA_CtcnChk1 == "Y" then
			User_Chk_Image_Set("MISA1", chk)	'중개형ISA계좌 주요약관/설명서
		end if
		
		if g_BDM_137_CtcnChk1 == "Y" then
			User_Chk_Image_Set("P137", chk)	'해외CFD계좌약관/거래설명서(위험고지)
		end if
		'v0002 fin
		
		if g_BDM_131_CtcnChk == "Y" then
			User_Chk_Image_Set("P131", chk)	'연금저축계좌설정약관/설명서
		end if 
	else
		'개별약관 체크해제시, 전체도 같이 해제
		if chk <> "Y" then
			g_BDM_CtcnChkAll = chk
			User_Chk_Image_Set("A", chk)
		end if
	end if
	
	'다음버튼 활성화/비활성화
	User_Btn_NextStep()
End Function
'============================================================================
Function User_Btn_NextStep()

		'개인(신용)정보 처리 선택동의서제외 모두동의시, 버튼 활성화
		if g_BDM_CtcnChk1 == "Y" and g_BDM_CtcnChk2 == "Y" and g_BDM_CtcnChkMndt == "Y" then
			strYN = "Y"
			
			'개설상품별 약관동의 체크
'			if (g_BDM_PRCD100 == "Y" or g_BDM_PRCD100F == "Y" or g_BDM_PRCD200 == "Y") and g_BDM_CtcnChk100 <> "Y" then ' v0007 : 다드림 추가
			if (g_BDM_PRCD100 == "Y" or g_BDM_PRCD100F == "Y") and g_BDM_CtcnChk100 <> "Y" then ' v0007 : 다드림 추가
				strYN = "N"
			end if
						
			if strYN == "Y" then
				btnNext.enable = true
				btnNext.btnimage = "btn_20.9"
				btnNext.fgcolor = "273"
			else 
				btnNext.enable = false
				If g_szTheme = "black" Then
					btnNext.btnimage = "btn_27.9"
				Else 
					btnNext.btnimage = "btn_21.9"
				End If
				btnNext.fgcolor = "269"
			end if
		else 
			btnNext.enable = false
			If g_szTheme = "black" Then
				btnNext.btnimage = "btn_27.9"
			Else 
				btnNext.btnimage = "btn_21.9"
			End If
			btnNext.fgcolor = "269"
		end if
		
End Function
