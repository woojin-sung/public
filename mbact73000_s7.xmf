			g_BDM_Mndt_1_2_2_3 = Form.GetSharedData("BDM_Mndt_1_2_2_3", False)  '1.2 수집이용(상품)_비과세/ISA/연금저축_민감정보             
			g_BDM_Mndt_1_2_2_2 = Form.GetSharedData("BDM_Mndt_1_2_2_2", False)  '1.2 수집이용(상품)_비과세/ISA/연금저축_개인신용             
			g_BDM_Mndt_1_2_3_1 = Form.GetSharedData("BDM_Mndt_1_2_3_1", False)  '1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_고유식별
			g_BDM_Mndt_1_2_3_2 = Form.GetSharedData("BDM_Mndt_1_2_3_2", False)  '1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
			g_BDM_Mndt_2_1_1_1 = Form.GetSharedData("BDM_Mndt_2_1_1_1", False)  '2.1 제공(상품)_신용/미수/파생/해외파생_고유식별             
			g_BDM_Mndt_2_1_1_2 = Form.GetSharedData("BDM_Mndt_2_1_1_2", False)  '2.1 제공(상품)_신용/미수/파생/해외파생_개인신용             
			g_BDM_Mndt_2_1_2_1 = Form.GetSharedData("BDM_Mndt_2_1_2_1", False)  '2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_고유식별    
			g_BDM_Mndt_2_1_2_2 = Form.GetSharedData("BDM_Mndt_2_1_2_2", False)  '2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_개인신용    
			g_BDM_Mndt_3_1_1_1 = Form.GetSharedData("BDM_Mndt_3_1_1_1", False)  '3   조회(상품)_신용/미수/파생/해외파생_고유식별             
			g_BDM_Mndt_3_1_1_2 = Form.GetSharedData("BDM_Mndt_3_1_1_2", False)  '3   조회(상품)_신용/미수/파생/해외파생_개인신용             

			g_BDM_CtcnChkMndt = "Y"
			User_Chk_Next("Mndt", g_BDM_CtcnChkMndt)			
		end if

	'개인(신용)정보처리선택동의서	
	elseif sKeyName == G_STEP2_2_P3_FILE then
		if sRet == "ok" then
			'v0001
			'g_BDM_SlctG		= Form.GetSharedData("BDM_SlctG"	, false)	'(선택)수집이용
			'g_BDM_SlctH		= Form.GetSharedData("BDM_SlctH"	, false)	'(선택)고유식별정보처리
			g_BDM_Slct_1_1    = Form.GetSharedData("BDM_Slct_1_1"  , False)  '수집이용_고유식별
