	ElseIf szTranID == "obcsb_nice_010r" Then
		If g_nCnt_030 > 1 Then
'			Form.ShowAlert("before_szSdrcSrno", szSdrcSrno)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SDRC_CLS_CODE" 	, 0, "2"	)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "SDRC_SRNO" 	, 0, szSdrcSrno	)
		Else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SDRC_CLS_CODE" 	, 0, "1"	)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "SDRC_SRNO" 	, 0, ""	)
		End If
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_CLS_CODE" 	, 0, "1"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01"	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_TYPE_CODE" 	, 0, "01"	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP" 		, 0, g_BDM_RCNO_PIP)
		Dim szAcno
		szAcno = Form.GetSharedData("BDM_KAKAO_ACNO", false)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"			, 0, szAcno)
    End IF
	'비대면용 설정가능계좌 조회
'	ElseIf szTranID == "obaci_nmet_016r" Then
