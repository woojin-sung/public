'============================================================================
Function User_Chk_All()

'화면에 보이는 약관이 모두 선택된 경우, 상단 모두동의 자동체크

    strYN = "Y"

    if g_BDM_CtcnChk1 <> "Y" Then
        strYN = "N"
    end if

    if g_BDM_CtcnChk2 <> "Y" Then
        strYN = "N"
    end if

    'IOS는 visible 체크가 안돼 변수체크로 변경
    'if contMain.contPrcd100.visible == True and g_BDM_CtcnChk100 <> "Y" Then
'    If (g_BDM_PRCD100 == "Y" Or g_BDM_PRCD100F == "Y" Or g_BDM_PRCD200 == "Y") and g_BDM_CtcnChk100 <> "Y" Then
    If (g_BDM_PRCD100 == "Y" Or g_BDM_PRCD100F == "Y") and g_BDM_CtcnChk100 <> "Y" Then
        strYN = "N"
    end if
    
    If g_BDM_PRCD200 == "Y" and g_BDM_CtcnChk200 <> "Y" Then
        strYN = "N"
    end if

    'IOS는 visible 체크가 안돼 변수체크로 변경
    'if contMain.contPrcd118RP.visible == True and g_BDM_CtcnChk118 <> "Y" Then
    If g_BDM_PRCD118RP == "Y"  and g_BDM_CtcnChk118 <> "Y" Then
        strYN = "N"
    end if

    'IOS는 visible 체크가 안돼 변수체크로 변경
    'if contMain.contPrcd101.visible == True and g_BDM_CtcnChk101 <> "Y" Then
    if g_BDM_PRCD101 == "Y" and g_BDM_CtcnChk101 <> "Y" Then
        strYN = "N"
    end if

    'IOS는 visible 체크가 안돼 변수체크로 변경
    'if contMain.contPrcd135.visible == True and g_BDM_CtcnChk135 <> "Y" Then
    if g_BDM_PRCD135 == "Y" and g_BDM_CtcnChk135 <> "Y" Then
        strYN = "N"
    end if
    
    'IOS는 visible 체크가 안돼 변수체크로 변경
    'if contMain.contPrcdCFD.visible == True and g_BDM_CtcnChkCFD <> "Y" Then
    if g_BDM_PRCDCFD == "Y" and g_BDM_CtcnChkCFD <> "Y" Then
        strYN = "N"
    end if

	'v0002 sta 
	'IOS는 visible 체크가 안돼 변수체크로 변경
	if g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3" and g_BDM_MISA_CtcnChk1 <> "Y" Then
        strYN = "N"
	end if
	
	if g_BDM_PRCD137 == "Y" and g_BDM_137_CtcnChk1 <> "Y" Then
        strYN = "N"
	end if
	'v0002 fin
	
	'연금저축, 랩 추가
	if g_BDM_PRCD131 == "Y" and g_BDM_131_CtcnChk <> "Y" then
		strYN = "N"
	end if
	
    if g_BDM_CtcnChkMndt <> "Y" Then
        strYN = "N"
    end if

    if g_BDM_CtcnChkSlct <> "Y" Then
        strYN = "N"
    end if

    if strYN == "Y" then
        contMain.imgCtcnChkAll.imgpath = "check_square_on.png"
        'contMain.imgCtcnChkAll.imgpath = "check_square_off.png"
    end if

End Function 
