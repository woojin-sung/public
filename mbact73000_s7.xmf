'				g_Send_Data = ""              '인자정보    
'			elseif g_BDM_ACNT_OPNG_CLCD == "2" or g_BDM_ACNT_OPNG_CLCD == 2 then
'				g_Opng_File = G_STEP2_5_FILE  '오픈할화면
'				g_Send_Data = ""              '인자정보    
'			end if	
'			
'			'v0006 중개형 ISA일때만 개설구분값 저장 
'			If g_BDM_ISA_PROD_TYPE == "3" then
'				g_BDM_ISA_ACNT_OPNG_CLCD = "2" '이수개설
'			End If
'		    NextStep()
'	    End if
'    End if
    If sKeyName == "obcsb_nice_010r_complete" Then
	    '"3": MTS에서 직접 로그인한 케이스
	    '계좌정보 입력 > 약관동의 > 고객정보 입력 > 고객확인의무
	    If g_ProcCode == "3" Or g_ProcCode == 3 Then
		    Form.OpenNextPopup("mbact73000_s8", "", "")
	    
	    '그 외 기존 스텝을 따라서 진행
	    Else
		    Form.OpenNextPopup("mbact73000_s8", "", "")
	    End If
    End If
'    ShowAlert(sKeyName, sRet)
    If sKeyName == "obcsb_nice_010r_retry" Then
	    If sRet == "ok" Then
		    g_nCnt_030 = 1
		    DATAMANAGER.RequestTranData("obcsb_nice_010r")
	    Else
		    Form.OpenNextPopup("mbact73000", "", "")
	    End If
    End If
    If sKeyName == "Exit" And sRet == "ok" Then
'	    Form.CloseForm()
	    Form.OpenNextPopup("mbact73000", "", "")
    End If
End Sub

