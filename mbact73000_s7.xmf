Function G_STEP2_2_FILE_Init_Data()  'v0002
	'G_STEP2_2_FILE 설정정보 ----------------------------------------
	Form.SetSharedData("BDM_CtcnChkAll" 			, ""	)	'전체약관
	Form.SetSharedData("BDM_CtcnChk1"   			, ""	)	'계좌개설/서비스기본약관
	Form.SetSharedData("BDM_CtcnChk2"  			, ""	)	'금융거래필수안내/위험고지 확인
	Form.SetSharedData("BDM_CtcnChk100" 			, ""	)	'종합매매계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk200" 			, ""	)	'슈퍼365계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk118" 			, ""	)	'CMA계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk101" 			, ""	)	'선물옵션계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk135" 			, ""	)	'해외파생계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChkMndt"			, "")	'개인(신용)정보 처리 필수 동의서
	Form.SetSharedData("BDM_CtcnChkSlct"			, "")	'개인(신용)정보 처리 선택 동의서
	Form.SetSharedData("BDM_CtcnChkCFD"			, "")	'CFD계좌 주요약관/설명서
	'v0002 
	Form.SetSharedData("BDM_MISA_CtcnChk1"			, "")	'중개형 ISA 주요약관/설명서
	Form.SetSharedData("BDM_ISA_ACNT_OPNG_CLCD" 		, "")	'ISA계좌개설구분코드(1:신규/2:이수)
	
	Form.SetSharedData("BDM_137_CtcnChk1"			, "")	'해외CFD계좌약관/거래설명서(위험고지)
	Form.SetSharedData("BDM_131_CtcnChk"  			, "" )		'연금저축
	
	'v0006
	Form.SetSharedData("BDM_BNK_MNY_OPNG_YN" 		, "")	'단기다수개설여부
End Function 
'============================================================================
Function G_STEP2_2_FILE_Set_Data()  'v0002
'	'G_STEP2_2_FILE 설정정보 ----------------------------------------
	Form.SetSharedData("BDM_CtcnChkAll" , g_BDM_CtcnChkAll	)	'전체약관
	Form.SetSharedData("BDM_CtcnChk1"   , g_BDM_CtcnChk1	)	'계좌개설/서비스기본약관
	Form.SetSharedData("BDM_CtcnChk2"   , g_BDM_CtcnChk2	)	'금융거래필수안내/위험고지 확인
	Form.SetSharedData("BDM_CtcnChk100" , g_BDM_CtcnChk100	)	'종합매매계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk200" , g_BDM_CtcnChk200	)	'슈퍼365계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk118" , g_BDM_CtcnChk118	)	'CMA계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk101" , g_BDM_CtcnChk101	)	'선물옵션계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChk135" , g_BDM_CtcnChk135	)	'해외파생계좌 주요약관/설명서
	Form.SetSharedData("BDM_CtcnChkMndt", g_BDM_CtcnChkMndt)	'개인(신용)정보 처리 필수 동의서
	Form.SetSharedData("BDM_CtcnChkSlct", g_BDM_CtcnChkSlct)	'개인(신용)정보 처리 선택 동의서
	Form.SetSharedData("BDM_CtcnChkCFD" , g_BDM_CtcnChkCFD)	'CFD계좌 주요약관/설명서
	'v0002 
	Form.SetSharedData("BDM_MISA_CtcnChk1" , g_BDM_MISA_CtcnChk1)	'중개형 ISA 주요약관/설명서
	Form.SetSharedData("BDM_ISA_ACNT_OPNG_CLCD" , g_BDM_ISA_ACNT_OPNG_CLCD)	'ISA계좌개설구분코드(1:신규/2:이수)
	
	Form.SetSharedData("BDM_137_CtcnChk1" , g_BDM_137_CtcnChk1 )	'해외CFD계좌약관/거래설명서(위험고지)
	Form.SetSharedData("BDM_131_CtcnChk"  , g_BDM_131_CtcnChk )		'연금저축
	
	'v0006
'	Form.SetSharedData("BDM_BNK_MNY_OPNG_YN" , g_BNK_MNY_OPNG_YN )	'단기다수개설여부
End Function
