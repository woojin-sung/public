			g_BDM_Slct_2_1    = Form.GetSharedData("BDM_Slct_2_1"  , False)  '상품서비스안내
			g_BDM_SlctTel		= Form.GetSharedData("BDM_SlctTel"	, false)	'홍보수신_전화
			g_BDM_SlctSMS		= Form.GetSharedData("BDM_SlctSMS"	, false)	'홍보수신_문자
			g_BDM_SlctEmail	= Form.GetSharedData("BDM_SlctEmail"	, false)	'홍보수신_이메일
			g_BDM_SlctPost	= Form.GetSharedData("BDM_SlctPost"	, false)	'홍보수신_우편
              '선택동의서는 실제 동의건이 있을 경우에만 선택
			'if g_BDM_SlctG == "Y" or g_BDM_SlctH == "Y" or g_BDM_SlctTel == "Y" or g_BDM_SlctSMS == "Y" or g_BDM_SlctEmail == "Y" or g_BDM_SlctPost == "Y" then
			if g_BDM_Slct_1_1 == "Y" or g_BDM_Slct_1_2 == "Y" or g_BDM_Slct_2_1 == "Y" or g_BDM_SlctTel == "Y" or g_BDM_SlctSMS == "Y" or g_BDM_SlctEmail == "Y" or g_BDM_SlctPost == "Y" then
                  g_BDM_CtcnChkSlct = "Y"
                  User_Chk_Next("Slct", g_BDM_CtcnChkSlct)
			'미동의체크도 선택한것으로 체크 v0001
			elseIf g_BDM_Slct_1_1 == "N" or g_BDM_Slct_1_2 == "N" or g_BDM_Slct_2_1 == "N" or g_BDM_SlctTel == "N" or g_BDM_SlctSMS == "N" or g_BDM_SlctEmail == "N" or g_BDM_SlctPost == "N" then
		     else
			    g_BDM_CtcnChkSlct = "N"
                  User_Chk_Next("Slct", g_BDM_CtcnChkSlct)
              end if
		end if
	end if
	'계좌개설방식선택
'	elseif sKeyName == G_STEP2_3_FILE then
'		if (sRet == "1" or sRet == 1) or (sRet == "2" or sRet == 2)  then
'			g_BDM_ACNT_OPNG_CLCD = sRet		'1.종합계좌개설 2.개별추가 
