Function User_File_Set()
    G_STEP2_1_FILE    = "mbbdm85130"      '상품선택
    G_STEP2_2_FILE    = "mbbdm85131"      '약관목록
    G_STEP2_2_P1_FILE = "mbbdm85131_p1"   '약관보기
    G_STEP2_2_P2_FILE = "mbbdm85131_p2"   '개인(신용)정보처리필수동의
    G_STEP2_2_P3_FILE = "mbbdm85131_p3"   '개인(신용)정보처리선택동의
    G_STEP2_3_FILE    = "mbbdm85190"      '개설방식선택
    G_STEP2_4_FILE    = "mbbdm85132"      '종합개설
    G_STEP2_5_FILE    = "mbbdm85133"      '개별추가
    G_STEP2_6_FILE    = "mbbdm85140"      '투자성향공통
    G_STEP2_2_P4_FILE = "mbbdm85131_p4"   'CFD 계약서 등 확인 및 동의
End Function
