'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"            , 0 , g_BDM_RCNO_PIP	)
'    End IF
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    '오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null And Trim(strSubMsg) ~= "" Then
        strMsg = szErrMsg.."("..Trim(strSubMsg)..")"
    Else
        strMsg = szErrMsg
    End If

'	If szTranID == "obcsb_acif_556r" Then
'		'개인(신용)정보 동의여부 조회 오류처리 안함
'		Exit Sub

    '단기다수계좌/대포통장 명의인
'    ElseIf szTranID == "obaci_acct_091r" Or szTranID == "obaci_acct_091r_1" Then
'        Form.ShowAlert("오류", strMsg)

 '   Else
'     If szTranID == "obaci_acct_255a" Then
    If szTranID == "obaci_acct_303a" Then
        Form.ShowAlert("오류", "개인신용정보동의 등록 처리 중 오류")   
	elseIf szTranID == "obaci_acct_256a" Then
		Form.ShowAlert("오류", "개인신용정보동의 등록 처리 중 오류")   
	Else
		Form.ShowAlert("오류", strMsg)
    End If
End Sub
