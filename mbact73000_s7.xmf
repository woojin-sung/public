Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    'OSType 1.안드로이드 2.IOS
'    g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")
	
    '다음버튼 비활성화
    btnNext.enable = false
    If g_szTheme = "black" Then
        btnNext.btnimage = "btn_27.9"
    Else 
        btnNext.btnimage = "btn_21.9"
    End If
    btnNext.fgcolor = "269"
	
    '파일정보 Set
    User_File_Set()

    '공유정보Get
    User_SharedData_Get()
	
	'카카오 후속처리 관련 세팅 
	g_BDM_PRCD100 = "Y"	'종합계좌 기준으로 약관 보여줌
	g_ProcCode = Form.GetSharedData("KAKAO_PROS_CODE"          , false )
	
	'SET USERID
	'DATAMANAGER.SetUserID(g_BDM_HP1&g_BDM_HP2&g_BDM_HP3)	
	
	g_nCnt_030 = 1
	
    '개설선택 상품별 약관 화면표시 -------------------------------------
    nTop = 194	'종합매매계좌약관 최초위치
'    if g_BDM_PRCD100 == "Y" or g_BDM_PRCD100F == "Y" then		'종합매매,종합매매(금상전용) '다드림
        contMain.contPrcd100.visible = true

        nTop = CInt(nTop) + 50
'	else
'	   '상품변경을 고려하여, 체크선택 초기화
'        g_BDM_CtcnChk100 = ""
'	end if
'	if g_BDM_PRCD200 == "Y" then
'		contMain.contPrcd200.top = CInt(nTop)
'		contMain.contPrcd200.visible = true
'		
'		nTop = CInt(nTop) + 50
'	else
'		'상품변경을 고려하여, 체크선택 초기화
'        g_BDM_CtcnChk200 = ""
'	end if
'	if g_BDM_PRCD118RP == "Y" then		'CMA
'		contMain.contPrcd118RP.top = CInt(nTop)
'		contMain.contPrcd118RP.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'        g_BDM_CtcnChk118 = ""
'	end if
'	if g_BDM_PRCDCFD == "Y" then		'CFD
'		contMain.contPrcdCFD.top = CInt(nTop)
'		contMain.contPrcdCFD.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'        g_BDM_CtcnChkCFD = ""
'	end if
	
	'v0002 sta
'	if g_BDM_PRCD137 == "Y" then		'해외CFD
'		contMain.contPrcd137.top = CInt(nTop)
'		contMain.contPrcd137.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'        g_BDM_137_CtcnChk1 = ""
'	end if
	
'	if g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3" then		'중개형 ISA
'		contMain.contPrcdMISA.top = CInt(nTop)
'		contMain.contPrcdMISA.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'        g_BDM_MISA_CtcnChk1 = ""
'	end if
	'v0002 fin
	
'	if g_BDM_PRCD101 == "Y" then		'선물옵션
'		contMain.contPrcd101.top = CInt(nTop)
'		contMain.contPrcd101.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'        g_BDM_CtcnChk101 = ""
'	end if
'	if g_BDM_PRCD135 == "Y" then		'해외파생
'		contMain.contPrcd135.top = CInt(nTop)
'		contMain.contPrcd135.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'        g_BDM_CtcnChk135 = ""
'	end if
'	if g_BDM_PRCD131 == "Y" then		'연금저축
'		contMain.contPrcd131.top = CInt(nTop)
'		contMain.contPrcd131.visible = true
'
'		nTop = CInt(nTop) + 50
'	else
'		g_BDM_131_CtcnChk = ""
'	end if
	
	''개인(신용)정보처리 화면표시(개설선택상품약관 이어서 표시)  -------------------
	'개인(신용)정보처리 필수동의서
	contMain.contMndt.top = CInt(nTop)
	contMain.contMndt.visible = true
	nTop = CInt(nTop) + 50
	'개인(신용)정보처리 선택동의서
	contMain.contSlct.top = CInt(nTop)
	contMain.contSlct.visible = true

	'이어하기용 정보 설정- 계좌정보 단계에서 넘어온 경우에만
'    sRevData = Form.GetOpenLinkData()
'    If sRevData == "StepBack" Then
'	    User_Conti_Data_Set()
'    End If

	'기존고객 기등록정보 조회
	'기등록정보 조회안함(By 박정숙Cha)
	'DATAMANAGER.RequestTranData("obcsb_acif_556r")
	contMain.SetScrollAutoSize()

End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
			
	'파일정보 Set
	User_File_Set()
	
	'약관목록
	if sKeyName == G_STEP2_2_P1_FILE then
		if sRet == "ok_A" then		'전체약관
			g_BDM_CtcnChkAll = "Y"
			User_Chk_Next("A", g_BDM_CtcnChkAll)
		elseif sRet == "ok_1" then	'계좌개설/서비스기본약관
			g_BDM_CtcnChk1 = "Y"
			User_Chk_Next("1", g_BDM_CtcnChk1)
		elseif sRet == "ok_2" then	'금융거래필수안내/위험고지 확인
			g_BDM_CtcnChk2 = "Y"
			User_Chk_Next("2", g_BDM_CtcnChk2)
		elseif sRet == "ok_P100" then	'종합매매계좌 주요약관/설명서
			g_BDM_CtcnChk100 = "Y"
			User_Chk_Next("P100", g_BDM_CtcnChk100)
		elseif sRet == "ok_P200" then	'슈퍼365계좌 주요약관/설명서
			g_BDM_CtcnChk200 = "Y"
			User_Chk_Next("P200", g_BDM_CtcnChk200)
		elseif sRet == "ok_P118" then	'CMA계좌 주요약관/설명서
			g_BDM_CtcnChk118 = "Y"
			User_Chk_Next("P118", g_BDM_CtcnChk118)
		elseif sRet == "ok_P101" then	'선물옵션계좌 주요약관/설명서
			g_BDM_CtcnChk101 = "Y"
			User_Chk_Next("P101", g_BDM_CtcnChk101)
		elseif sRet == "ok_P135" then	'해외파생계좌 주요약관/설명서
			g_BDM_CtcnChk135 = "Y"
			User_Chk_Next("P135", g_BDM_CtcnChk135)
		'연금저축, 랩 추가
		elseif sRet == "ok_P131" Then
			g_BDM_131_CtcnChk = "Y"
			User_Chk_Next("P131", g_BDM_131_CtcnChk)
			
		elseif sRet == "ok_CFD" then	'CFD계좌 주요약관/설명서
			g_BDM_CtcnChkCFD = "Y"
			User_Chk_Next("CFD", g_BDM_CtcnChkCFD)	
			
		'v0002 sta	
		elseif sRet == "ok_MISA1" then	'중개형 ISA 주요약관/설명서
			g_BDM_MISA_CtcnChk1 = "Y"
			User_Chk_Next("MISA1", g_BDM_MISA_CtcnChk1)	
		
		elseif sRet == "ok_P137" then	'해외CFD계좌약관/거래설명서(위험고지)
			g_BDM_137_CtcnChk1 = "Y"
			User_Chk_Next("P137", g_BDM_137_CtcnChk1)	
		'v0002 fin
		
		elseif sRet == "ok_Mndt" then	'개인(신용)정보 처리 필수 동의서
			g_BDM_CtcnChkMndt = "Y"
			User_Chk_Next("Mndt", g_BDM_CtcnChkMndt)
		elseif sRet == "ok_Slct" then	'개인(신용)정보 처리 선택 동의서
			g_BDM_CtcnChkSlct = "Y"
			User_Chk_Next("Slct", g_BDM_CtcnChkSlct)
		end if
	
	'개인(신용)정보처리필수동의서	
	elseif sKeyName == G_STEP2_2_P2_FILE then
		if sRet == "ok" then
             'v0001
			'g_BDM_MndtC	= Form.GetSharedData("BDM_MndtC"	, false)	'(공통)고유식별정보처리
			'g_BDM_MndtD	= Form.GetSharedData("BDM_MndtD"	, false)	'(상품)조회
			'g_BDM_MndtE	= Form.GetSharedData("BDM_MndtE"	, false)	'(상품)제공
			'g_BDM_MndtE1	= Form.GetSharedData("BDM_MndtE1"	, false)	'(상품)신용정보조회및집중
			'g_BDM_MndtE2	= Form.GetSharedData("BDM_MndtE2"	, false)	'(상품)해외증권/파생
