		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock4", "UI_COMN_AGRM_YN2" , 0 , "Y" )	'필수 2. 제공(상품)-신용/미수/파생상품/해외파생-개인신용정보
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock4", "UI_COMN_AGRM_YN3" , 0 , "Y" )	'필수 2. 제공(상품)-해외주식/해외파생/EUREX/외화금융상품-고유식별번호
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock4", "UI_COMN_AGRM_YN4" , 0 , "Y" )	'필수 2. 제공(상품)-해외주식/해외파생/EUREX/외화금융상품-고유식별번호
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock5", "UI_COMN_AGRM_YN1" , 0 , "Y" )	'필수 3. 조회(상품)-신용/미수/파생상품/해외파생-고유식별번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock5", "UI_COMN_AGRM_YN2" , 0 , "Y" )	'필수 3. 조회(상품)-신용/미수/파생상품/해외파생-개인신용정보	
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock6", "UI_COMN_AGRM_YN1" 	, 0 , g_BDM_Slct_1_1 )	'선택_고유식별번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock6", "UI_COMN_AGRM_YN2" 	, 0 , g_BDM_Slct_1_2 )	'선택_개인신용정보
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock6", "UI_COMN_AGRM_YN3" 	, 0 , g_BDM_Slct_2_1 )	'선택_상품서비스안내
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock6", "PBLT_TLPH_RCMS_YN" 	, 0 , g_BDM_SlctTel )	'선택_홍보전화
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock6", "PBLT_SMS_RCMS_YN" 	, 0 , g_BDM_SlctSMS )	'선택_홍보문자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock6", "PBLT_EMAIL_RCMS_YN" , 0 , g_BDM_SlctEmail )	'선택_홍보이메일
