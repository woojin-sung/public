'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_주문_수량자동입력
' 03. 작    성 : 2016.02.16 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sFileName '파일명
Dim g_sKey '수량자동입력키
Dim g_sStockBuyQtyKey '매수수량자동입력-주식키
Dim g_sStockSelQtyKey '매도수량자동입력-주식키
Dim g_sFutOptBuyQtyKey '매수수량자동입력-선물옵션키
Dim g_sFutOptSelQtyKey '매도수량자동입력-선물옵션키
Dim g_sStockBuyQtyCntKey '매수수량자동입력수량-주식키
Dim g_sStockSelQtyCntKey '매도수량자동입력수량-주식키
Dim g_sFutOptBuyQtyCntKey '매수수량자동입력수량-선물옵션키
Dim g_sFutOptSelQtyCntKey '매도수량자동입력수량-선물옵션키

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sFileName, sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.LoadConfigData(sFileName, sKey)

	if sValue == null or Trim(sValue) == "" then
		sValue = "0" '기본값 사용하지않음
	end if
	
	Form.SetCtlProp( sCtlName, sPropName, sValue )
	
	if sValue == "3" then
		if sKey == g_sStockBuyQtyKey then
			EditStock.enable = true
			
			EditStock.caption = Form.LoadConfigData(sFileName, g_sStockBuyQtyCntKey)
		elseif sKey == g_sFutOptBuyQtyKey or sKey == g_sFutOptSelQtyKey then
			EditFutOpt.enable = true
			
			if sKey == g_sFutOptBuyQtyKey then
				EditFutOpt.caption = Form.LoadConfigData( sFileName, g_sFutOptBuyQtyCntKey )
			elseif sKey == g_sFutOptSelQtyKey then
				EditFutOpt.caption = Form.LoadConfigData( sFileName, g_sFutOptSelQtyCntKey )
			end if
		end if
	elseif sValue == "2" then
		if sKey == g_sStockSelQtyKey then
			EditStock.enable = true
			
			EditStock.caption = Form.LoadConfigData(sFileName, g_sStockSelQtyCntKey)
		end if
	end if
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sFileName, sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.GetCtlProp( sCtlName, sPropName )
	
	if sValue == "3" then
		if sKey == g_sStockBuyQtyKey then
			if EditStock.caption == "" or EditStock.caption == "0" then
				Form.MsgBox( "알림", "수량을 입력해주세요.", "", 6 )	
				Exit Function
			end if
			
			Form.SaveConfigData( sFileName, g_sStockBuyQtyCntKey, EditStock.caption )
		elseif sKey == g_sFutOptBuyQtyKey or sKey == g_sFutOptSelQtyKey then
			if EditFutOpt.caption == "" or EditFutOpt.caption == "0" then
				Form.MsgBox( "알림", "수량을 입력해주세요.", "", 6 )	
				Exit Function
			end if
			
			if sKey == g_sFutOptBuyQtyKey then
				Form.SaveConfigData( sFileName, g_sFutOptBuyQtyCntKey, EditFutOpt.caption )
			elseif sKey == g_sFutOptSelQtyKey then
				Form.SaveConfigData( sFileName, g_sFutOptSelQtyCntKey, EditFutOpt.caption )
			end if
		end if
	elseif sValue == "2" then
		if sKey == g_sStockSelQtyKey then
			if EditStock.caption == "" or EditStock.caption == "0" then
				Form.MsgBox( "알림", "수량을 입력해주세요.", "", 6 )	
				Exit Function
			end if
			
			Form.SaveConfigData( sFileName, g_sStockSelQtyCntKey, EditStock.caption )
		end if
	end if
	
	Form.SaveConfigData( sFileName, sKey, sValue )
	
	Form.SendReturnToParent("nhnts91005_p1" , sKey)
	Form.CloseForm()
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData, sText, sText1
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or Trim(sRevData) == "" then
		Exit Sub
	end if
	
	g_sFileName = "SET_ORDER" 
	g_sKey = sRevData
	g_sStockBuyQtyKey = "AUTO_STOCK_BUYQTY" 
	g_sStockSelQtyKey = "AUTO_STOCK_SELQTY" 
	g_sFutOptBuyQtyKey = "AUTO_FUTOPT_BUYQTY" 
	g_sFutOptSelQtyKey = "AUTO_FUTOPT_SELQTY" 
	g_sStockBuyQtyCntKey = "AUTO_STOCK_BUYQTYCNT" 
	g_sStockSelQtyCntKey = "AUTO_STOCK_SELQTYCNT" 
	g_sFutOptBuyQtyCntKey = "AUTO_FUTOPT_BUYQTYCNT" 
	g_sFutOptSelQtyCntKey = "AUTO_FUTOPT_SELQTYCNT" 
	
	if g_sKey == g_sStockBuyQtyKey then
		sText = "매수수량 자동입력"
		sText1 = "매수수량설정"
		
		RadioStockBuy.visible = true
		EditStock.visible = true
		
		GetConfigData(g_sFileName, g_sKey, "RadioStockBuy", "currentindex")
	elseif g_sKey == g_sStockSelQtyKey then
		sText = "매도수량 자동입력"
		sText1 = "매도수량설정"
		
		RadioStockSel.visible = true
		EditStock.top = "174"
		EditStock.visible = true
		
		GetConfigData(g_sFileName, g_sKey, "RadioStockSel", "currentindex")
	elseif g_sKey == g_sFutOptBuyQtyKey then
		sText = "매수수량 자동입력"
		sText1 = "매수수량설정"
		
		RadioFutOpt.visible = true
		EditFutOpt.visible = true
		
		GetConfigData(g_sFileName, g_sKey, "RadioFutOpt", "currentindex")
	elseif g_sKey == g_sFutOptSelQtyKey then
		sText = "매도수량 자동입력"
		sText1 = "매도수량설정"
		
		RadioFutOpt.visible = true
		EditFutOpt.visible = true
		
		GetConfigData(g_sFileName, g_sKey, "RadioFutOpt", "currentindex")
	end if
	
	LabelTitle.caption = sText
	Table0.SetCellString(0, 0, sText1)
End Sub

'============================================================================
'매수수량자동입력-주식
'============================================================================
Sub RadioStockBuy_OnClick(nIndex)
	if nIndex == 3 then
		EditStock.enable = true
	else
		EditStock.enable = false
		EditStock.caption = ""
	end if
End Sub

'============================================================================
'매도수량자동입력-주식
'============================================================================
Sub RadioStockSel_OnClick(nIndex)
	if nIndex == 2 then
		EditStock.enable = true
	else
		EditStock.enable = false
		EditStock.caption = ""
	end if
End Sub

'============================================================================
'매수/매도수량자동입력-선물옵션
'============================================================================
Sub RadioFutOpt_OnClick(nIndex)
	if nIndex == 3 then
		EditFutOpt.enable = true
	else
		EditFutOpt.enable = false
		EditFutOpt.caption = ""
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if g_sKey == g_sStockBuyQtyKey then
		SetConfigData(g_sFileName, g_sKey, "RadioStockBuy", "currentindex")
	elseif g_sKey == g_sStockSelQtyKey then
		SetConfigData(g_sFileName, g_sKey, "RadioStockSel", "currentindex")
	elseif g_sKey == g_sFutOptBuyQtyKey then
		SetConfigData(g_sFileName, g_sKey, "RadioFutOpt", "currentindex")
	elseif g_sKey == g_sFutOptSelQtyKey then
		SetConfigData(g_sFileName, g_sKey, "RadioFutOpt", "currentindex")
	end if
End Sub

'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub




	</SCRIPT_INFO>
</ROOT>