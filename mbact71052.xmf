<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="71052" scrname="고객자산평가" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<CONTAINER name="cont0" vscroll="1" ly_vert="0,0,375,562,1" scroll_ly_vert="0,0,375,562,1" >
			<CONTROL_INFO>
				<FORMTAB name="fmtab0" tabcount="2" tabheadheight="0" usepg="1" pgbarheight="10" ly_vert="0,0,375,200,1" >
					<PAGE name="page007484" caption="총자산" linkfile="mbact71052_t3" />
					<PAGE name="page006818" caption="자산비중" linkfile="mbact71052_t4" />
				</FORMTAB>
				<LABEL name="Label0" transmode="0" ly_vert="0,189,375,12,1" />
				<IMAGE name="Image1" autosize="1" imgpath="pwd_blue" ly_vert="171,167,6,6,1" />
				<IMAGE name="Image2" autosize="1" imgpath="pwd_gray" ly_vert="187,167,6,6,1" />
				<IMAGE name="Image3" visible="0" autosize="1" imgpath="pwd_gray" ly_vert="171,167,6,6,0" />
				<IMAGE name="Image4" visible="0" autosize="1" imgpath="pwd_blue" ly_vert="187,167,6,6,0" />
				<FORMTAB name="fmtab1" tabcount="0" tabheadwidth="165" tabheadheight="27" ly_vert="15,197,345,552,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<IMAGE name="imgRefresh" imgpath="icon_refresh" ly_vert="1000,40,40,40,1" />
