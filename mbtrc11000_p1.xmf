			<CONTROL_INFO>
				<TABLE name="tbl0" insidelinecolor="102:255255255" colcount="2" rowcount="18" designorder="1" ly_vert="0,0,375,950,1" >
					<COL_INFO ly_vert_width="110,265" />
					<ROW_INFO ly_vert_height="60,40,40,40,60,40,60,40,60,40,40,40,40,40,40,60,60,150" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="계좌평가" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" caption="예수금 + 대용평가금액 + 평가손익
- 미결제비용(미수금 포함) 
- (구)계좌평가금액(예탁총액)" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="예수금" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" caption="입금한 금액에서 입출금, 월정산손익, 청산손익
및 거래비용이 반영 된 금액" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="미결제비용" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" caption="수수료 + CFD이자 + 차입이자 합친 비용
- (구)미결제증거금" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="수수료(제세금)" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" caption="매매 시 발생하는 수수료" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="CFD이자" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" caption="매수 포지션을 장종료까지 보유할 경우
매입금액 기준으로 징구하는 이자 
- (구)롤오버이자" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="차입이자" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" caption="매도 포지션 차입 시 발생하는 이자" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="기본증거금" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" caption="매수,매도 포지션을 보유 하기 위한 실필요 금액
(매입단가 또는 정산단가 * 잔고수량 
* 종목증거금률) - (구)위탁증거금(포지션증거금)" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="사용가능증거금" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" caption="신규 주문시 평가손익 및 거래비용이 반영 된
주문 가능 금액 - (구)주문가능금액" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="유지증거금" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,8,1,8" halign="0" caption="기본증거금 * 60%
(-60% 이하로 내려갈 경우 익일 추가증거금 발생)" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="장중 반대매매
