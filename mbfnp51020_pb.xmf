<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="51020" scrname="개인신용정보 처리 상세동의서" version="2" writer="성주혁" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,0,375,524,1" />
		<BUTTON name="BtnCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,561,187,45,1" />
		<BUTTON name="BtnOK" enable="0" caption="동의" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,561,188,45,1" />
		<CHKBUTTON name="ChkButton" chkcaption="상기 내용을 읽었고 그 내용에 동의합니다." unchkcaption="상기 내용을 읽었고 그 내용에 동의합니다." ly_vert="25,526,331,32,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2206" _ulen="2094" >
'============================================================================
' 01.화면명 	: 계좌통합관리 서비스 이용약관
' 02.화면설명	: 계좌통합관리 서비스 이용약관
' 03.작성	: 2020.10.07
' 04.수정	: 
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet	'리턴값
g_szRet	=	"0"

Dim g_URLheader
Dim g_ServerMode

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
		g_URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	Else
		g_URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	End If
	WebView0.viewtype = 0
	WebView0.urlpath = g_URLheader & "crinoferagrm5.pdf"
	
	Form.SetScreenName("개인신용정보 처리 상세동의서")
	
End Sub

'============================================================================
'BtnOK_OnClick
'============================================================================
Sub BtnOK_OnClick()
	g_szRet	=	"ok"
	Form.CloseForm()
End Sub


'============================================================================
'BtnCancel_OnClick
'============================================================================
Sub BtnCancel_OnClick()
	g_szRet	=	"cancel"
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51020_pb" , g_szRet)
End Sub

'============================================================================
Sub ChkButton_OnChange(sCheckState)

	If sCheckState == "1" Then
	    BtnOK.enable = True
	Else
	    BtnOK.enable = False
	End If
	
End Sub

	</SCRIPT_INFO>
</ROOT>