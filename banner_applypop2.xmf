<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="배너" version="2" writer="홍수지" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="Image3" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image0" autosize="1" ly_vert="8,105,361,437,1" />
		<CONTAINER name="Cont" vscroll="1" scroll_pos="0,0" ly_vert="8,103,360,437,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="Label0" transmode="0" ly_vert="0,0,360,1518,1" />
				<IMAGE name="Image1" autosize="1" imgpath="apply_popup4" ly_vert="0,0,360,1518,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<IMAGE name="Image5" imgpath="icon_main_11" ly_vert="330,113,30,28,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="614" _ulen="568" >
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	
	if Trim(szData) == "COMBINE" then
		Cont.visible = false
		Image0.imgpath = "apply_popup3.png"	'해외주식 통합증거금
	elseif Trim(szData) == "ITEMS" then
		Cont.visible = true
		Image0.visible = false	'해외주식 적용대상품목
	else
		Cont.visible = false
		Image0.imgpath = "apply_popup2.png"	'해외주식
	end if
End Sub

'============================================================================
Sub Image5_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>