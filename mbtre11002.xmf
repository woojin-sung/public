'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리
Dim g_szData

'============================================================================
' TR_Inquiry()
'============================================================================
Function TR_Inquiry()
	Dim nAcNo, nAsNo
	nAcNo = Form.GetCtlProp("acnt0", "total")
	nAsNo = Form.GetCtlProp("acnt0", "sequence")
	'Test 계좌
'	nAcNo = "30158194"
'	nAsNo = "02"
	
	Dim DEAL_CLS_CODE, CNTG_CLS_CODE
	
	DEAL_CLS_CODE = "%"
	CNTG_CLS_CODE = "%"
	
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "2"			)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "UI_SORT_CLS_VAL"	, 0 , "2"			)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "IQRY_STA_DATE"	, 0 , cldFrom.caption	)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "IQRY_FIN_DATE"	, 0 , cldTo.caption 	)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "ACNO"			, 0 , nAcNo			)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "ASNO"			, 0 , nAsNo			)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "DEAL_CLS_CODE"	, 0 , DEAL_CLS_CODE 	)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "CNTG_CLS_CODE"	, 0 , CNTG_CLS_CODE 	)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "ODER_NO"			, 0 , "00000000000" 	)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "MANG_BRCD"		, 0 , "%" 			)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "MANG_EMPNO"		, 0 , "%" 			)
	DATAMANAGER.SetDataValue(0, "obtre_cntg_003r", "InBlock1", "CTCD"			, 0 , cmbNation.cbkeydata )
	
	DATAMANAGER.RequestTranData("obtre_cntg_003r")
	
End Function

'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD매매일지" )

	TR_Inquiry()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "RECEIVE" Then
		TR_Inquiry()
		
	ElseIf sEventName == "CHANGE_ACCTNO" Then
		TR_Inquiry()
		
	End If
End Sub

