'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket
'	Form.ShowAlert(szTranID, DATAMANAGER.GetDataMsgText( szTranID ))
	  
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtre_cntg_003r" then	
		For iCnt = grd0.rowcount - 1 To 0 Step -1
			szItem = grd0.GetCellData( "bd_Cd", iCnt)
			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
			'매매구분
			szData = grd0.GetCellData( "bd_TypeCd", iCnt)
			szData2 = grd0.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
			
			If szData = "1" Then
				grd0.SetCellFgColor("bd_Type", iCnt, "11")
			Else
				grd0.SetCellFgColor("bd_Type", iCnt, "10")
			End If
			
		Next
	end if
End Sub

