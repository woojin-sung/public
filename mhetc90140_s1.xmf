	<SCRIPT_INFO _len="3520" _ulen="3356" >
Dim g_orgcode
Dim g_clientId
Dim IF_CI
'============================================================================
Sub Button0_OnClick()
	Form.triggerEvent( "#", "NextStep", "1" )
End Sub
'============================================================================
