'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_myif_002r" then
		CI_RSPN = DATAMANAGER.GetDataValue(0, "obaci_myif_002r", "OutBlock1", "IF_150_DETL_RSPN_MSG",0)
		csno	   = DATAMANAGER.GetDataValue(0, "obaci_myif_002r", "OutBlock1", "IF_CUST_NO",0)
		Form.SetSharedData("&INNER_MYDATA_CSNO" , csno)
		if CI_RSPN = "정상" then
			Button0.enable = True
		else
			Form.MsgBox("알림", CI_RSPN, "", 6)
		end if
	End if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Button0.enable = False 
	Form.SetSharedData("MAP_MYDATA_OFFER_ORG_CODE" , g_orgcode)
	Form.SetSharedData("MAP_MYDATA_CLIENT_ID" , g_clientId)
	Form.SetSharedData("MAP_MYDATA_USER_CI" , IF_CI)
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 1)
'		IF_CI = "gJAX94rsUcNmKcdmIZJ0f+QEx2qwLfht2j4AR\/nYi25z0M05m3OvfyfmJeluPSeOsRhhB1iLpjq5SrIl6bJRDw==" 'TEST
'		Form.SetSharedData("&MYDATA_USER_CI" , IF_CI) 'TEST
		IF_CI = Form.GetSharedData("&MYDATA_USER_CI", false )
'		20211028 HSZ START 쉐어드변수 저장
		g_orgcode = Form.GetSharedData("&MYDATA_OFFER_ORG_CODE", false )
		g_clientId = Form.GetSharedData("&MYDATA_CLIENT_ID", false )
'		20211028 HSZ END
		DATAMANAGER.SetDataValue(0, "obaci_myif_002r", "InBlock1", "IF_CI" , 0 , IF_CI) 
		DATAMANAGER.RequestTranData("obaci_myif_002r")
	end if	
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20221207 HSZ START : 마이데이터 서비스종료
	nDev 		= Form.GetSharedData("&SERVER_MODE", false )
	szOsType		= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	if nDev == "1" then '테스트
		if szOsType = "2" then	
			szUrlschme = "meritzmts://MoeMe?menuNum=41000&itemCd="
		else
			szUrlschme = ""
		end if
	else
		szUrlschme = Form.GetSharedData("&MYDATA_APP_SCHEME", false )
	end if
	
	if sKeyName == "ok" then
		Form.runMyDataApp(szUrlschme, "03")
		Form.triggerEvent( "#", "CloseForm", "1" )
		Form.CloseForm()
	end if
	'20221207 HSZ END
End Sub

