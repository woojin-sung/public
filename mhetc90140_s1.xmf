	Button0.enable = False
	'20221207 HSZ START: 마이데이터 서비스 종료
	Form.MsgBox("알림", "당사는 개별인증을 미제공하오니,\n통합인증을 이용하시기 바랍니다.", "ok", 8, "돌아가기")
