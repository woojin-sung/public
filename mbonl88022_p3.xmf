'============================================================================
' 화 면 명 : 대차중개약정 신청완료
'============================================================================


'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		
		tblData.SetCellString(0, 1, tData[0])	'신청계좌
		tblData.SetCellString(1, 1, tData[1])	'통보방법
		tblData.SetCellString(2, 1, tData[2])	'계약서류제공방식 		
	End If
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl88022_p3" , "")
	Form.CloseForm()
	
'	'메뉴트리로 이동
'	Form.OpenMainMenuWithIndex("3","2","2")
End Sub

