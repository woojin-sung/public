'============================================================================
Sub RdoMnecClcdT1_OnClick(nIndex)
    
    If nIndex = "0" Or nIndex = 0 Then

	   plain_rm = Form.GetSharedData("&PLAIN_RM", False)
	   If plain_rm == "1" Then
	       DATAMANAGER.SetDataValue(0 , "obrtd_fcur_010r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
	   Else
	       DATAMANAGER.SetDataValue(0 , "obrtd_fcur_010r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
	   End If

        DATAMANAGER.SetDataValue(0, "obrtd_fcur_010r" , "InBlock1" , "ACNO"     , 0 , Left(Acnt.caption,8) )
        DATAMANAGER.SetDataValue(0, "obrtd_fcur_010r" , "InBlock1" , "ASNO"     , 0 , Right(Acnt.caption,2))
        DATAMANAGER.SetDataValue(0, "obrtd_fcur_010r" , "InBlock1" , "CRCD" , 0 , "USD"                    )
        DATAMANAGER.RequestTranData("obrtd_fcur_010r") '미결제환전증거금 조회

    ElseIf nIndex = "1" Or nIndex = 1 Then
   
	   plain_rm = Form.GetSharedData("&PLAIN_RM", False)
	   If plain_rm == "1" Then
	       DATAMANAGER.SetDataValue(0 , "obrtd_fcur_010r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
	   Else
	       DATAMANAGER.SetDataValue(0 , "obrtd_fcur_010r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
	   End If
   
        DATAMANAGER.SetDataValue(0, "obrtd_fcur_010r" , "InBlock1" , "ACNO"     , 0 , Left(Acnt.caption,8) )
        DATAMANAGER.SetDataValue(0, "obrtd_fcur_010r" , "InBlock1" , "ASNO"     , 0 , Right(Acnt.caption,2))
        DATAMANAGER.SetDataValue(0, "obrtd_fcur_010r" , "InBlock1" , "CRCD"     , 0 , "VND"                )
        DATAMANAGER.RequestTranData("obrtd_fcur_010r") '미결제환전증거금 조회
	    

    End If
End Sub

