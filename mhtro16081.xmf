Sub EdtPwd_OnClick()
	'TabInit()
End Sub


Sub TabInit()

    'If Len(EdtPwd.Caption) <= 0 Then
    
        RdoMnecClcdT1.currentindex = -1
        EdtAbleAmtT1.caption = 0
        EdtUnpaidT1.caption = 0	
        EdtApltAmtT1.caption = 0
        GridT2.rowcount = 0
        GridT3.rowcount = 0
        BtnCnfrT1.enable = False
        BtnCnclT2.enable = False	   
	
    'Else
    
        'currentIndex = Tab0.currenttab
        'Tab0_OnTabChanged(currentIndex)
	
    'End If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obtsd_fbnk_301a" Then
    
	    ACNT_NO = Left(Acnt.caption,4) & "-" & Mid(Acnt.caption,5,4) & "-" & Right(Acnt.caption,2)
	    
	    If RdoMnecClcdT1.currentindex = 0 Or RdoMnecClcdT1.currentindex = "0" Then
	        MNEC_CLCD = "이종통화매수"
	        SELN_CRCD = "USD 미국 달러"
	        BYOV_CRCD = "VND 베트남 동"
	    ElseIf RdoMnecClcdT1.currentindex = 1 Or RdoMnecClcdT1.currentindex = "1" Then
	        MNEC_CLCD = "이종통화매도"
	        SELN_CRCD = "VND 베트남 동"
	        BYOV_CRCD = "USD 미국 달러"
	    End If
	        
	    APLT_CRCD = "VND 베트남 동"	    
	    APLT_AMT  = FormatNumber(EdtApltAmtT1.caption , 2 ,0 , 0 , -1)
	    APLT_NO   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SRNO" , 0)      
	    
	    Form.SetSharedData("ACNT_NO"   , ACNT_NO  )
	    Form.SetSharedData("MNEC_CLCD" , MNEC_CLCD)
	    Form.SetSharedData("APLT_CRCD" , APLT_CRCD)
	    Form.SetSharedData("APLT_NO"   , APLT_NO  )
	    Form.SetSharedData("SELN_CRCD" , SELN_CRCD)
	    Form.SetSharedData("BYOV_CRCD" , BYOV_CRCD)
	    Form.SetSharedData("APLT_AMT"  , APLT_AMT )	    
	    
	    Form.OpenPopup("mhtro16081_p1" , "" , "")
	    
	    EdtAbleAmtT1.caption = ""
	    EdtUnpaidT1.caption = ""
	    EdtApltAmtT1.caption = ""
	    
    End If
    
    If szTranID = "obtsd_fbnk_301a_1" Then
    
	    ACNT_NO = Left(Acnt.caption,4) & "-" & Mid(Acnt.caption,5,4) & "-" & Right(Acnt.caption,2)
	    
	    For i = 0 To GridT2.rowcount - 1
	        checkstate = GridT2.GetCellData("bd_cell0", i)
	        If checkstate = 1 Or checkstate = "1" Then
	            MNEC_CLCD = GridT2.GetCellData("bd_cell3" , i)
	            APLT_CRCD = "VND 베트남 동"
	            APLT_NO   = GridT2.GetCellData("bd_cell10" , i)
	            APLT_AMT  = GridT2.GetCellData("bd_cell6"  , i)
	            APLT_AMT = FormatNumber(APLT_AMT , 2 ,0 , 0 , -1)
	        End If
	    Next

	    Form.SetSharedData("ACNT_NO"   , ACNT_NO  )
	    Form.SetSharedData("MNEC_CLCD" , MNEC_CLCD)
	    Form.SetSharedData("APLT_CRCD" , APLT_CRCD)
	    Form.SetSharedData("APLT_NO"   , APLT_NO  )
	    Form.SetSharedData("APLT_AMT"  , APLT_AMT )	    
	    
	    Form.OpenPopup("mhtro16081_p2" , "" , "")
	    
	    GridT2.rowcount = 0
	    
	   plain_rm = Form.GetSharedData("&PLAIN_RM", False)
	   If plain_rm == "1" Then
	       DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_302r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
	   Else
	       DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_302r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
	   End If
	    
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "BRNC_CLS_CODE"  , 0 , "1"          )    
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "IQRY_CLS_CODE"  , 0 , "1"          )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "IQRY_STA_DATE"  , 0 , "00010101"   )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "IQRY_FIN_DATE"  , 0 , "99991231"   )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "ACNO"           , 0 , Left(Acnt.caption,8) )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "ASNO"           , 0 , Right(Acnt.caption,2))
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "MNEC_CLCD"      , 0 , "%"          )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "MNEC_TRGT_CRCD" , 0 , "VND"        )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "APLT_YN"        , 0 , "0"          )
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "SNDN_YN"        , 0 , "X"          ) '미발송된내역만 취소가능
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "RSPN_YN"        , 0 , "X"          ) '예탁원 응답이 오지 않은 내역만 취소가능
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "RCMS_YN"        , 0 , "X"          ) '예탁원 환전결과가 오지 않은 내역만 취소가능
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "STLM_YN"        , 0 , "X"          ) '결제가 완료되지 않은 내역만 취소가능
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "CNCL_YN"        , 0 , "X"          ) '취소내역은 또 취소할 수 없음
        DATAMANAGER.RequestTranData("obtsd_fbnk_302r") '취소대상내역 조회

    End If
    
    If szTranID = "obtsd_fbnk_302r" Then
     
        For lRow = 0 To GridT2.rowcount - 1
	
            If GridT2.GetCellData("bd_cell3", lRow) = "4" Then
               GridT2.SetCellData("bd_cell3", lRow, "이종통화매수") 
               GridT2.SetCellFgColor("bd_cell3", lRow, 10)	          
            ElseIf GridT2.GetCellData("bd_cell3", lRow) = "5" Then
               GridT2.SetCellData("bd_cell3", lRow, "이종통화매도") 
               GridT2.SetCellFgColor("bd_cell3", lRow, 7)	       
            End If
	
            If GridT2.GetCellData("bd_cell5", lRow) = "0" Then
               GridT2.SetCellData("bd_cell5", lRow, "신청") 
            ElseIf GridT2.GetCellData("bd_cell5", lRow) = "1" Or GridT2.GetCellData("bd_cell5", lRow) = "2" Then
               GridT2.SetCellData("bd_cell5", lRow, "의뢰") 
            ElseIf GridT2.GetCellData("bd_cell5", lRow) = "3" Then 
               GridT2.SetCellData("bd_cell5", lRow, "신청") 
            ElseIf GridT2.GetCellData("bd_cell5", lRow) = "4" Then
               GridT2.SetCellData("bd_cell5", lRow, "결제") 
            ElseIf GridT2.GetCellData("bd_cell5", lRow) = "9" Then
                GridT2.SetCellData("bd_cell5", lRow, "취소") 
            End If
		
		   If GridT2.GetCellData("bd_cell11", lRow) = "VND" Then
                GridT2.SetCellData("bd_cell11", lRow, "VND 베트남 동")
		   End If
		       
		   If GridT2.GetCellData("bd_cell6", lRow) = "VND" Then
		       GridT2.SetCellData("bd_cell6", lRow, "VND 베트남 동")
		   ElseIf GridT2.GetCellData("bd_cell6", lRow) = "USD" Then
		       GridT2.SetCellData("bd_cell6", lRow, "USD 미국 달러")
		   End If
		       
		   If GridT2.GetCellData("bd_cell14", lRow) = "VND" Then
		       GridT2.SetCellData("bd_cell14", lRow, "VND 베트남 동")
            ElseIf GridT2.GetCellData("bd_cell14", lRow) = "USD" Then
		       GridT2.SetCellData("bd_cell14", lRow, "USD 미국 달러")
		   End If
		       
		   L_SELN_CRCD = GridT2.GetCellData("bd_cell1" , lRow)
		   L_APLT_AMT  = GridT2.GetCellData("bd_cell6" , lRow)
		   L_APLT_AMT_STRING = "(" & L_SELN_CRCD & ") " & FormatNumber(L_APLT_AMT , 2 ,0 , 0 , -1)
		       
		   GridT2.SetCellData("bd_cell12", lRow, L_APLT_AMT_STRING)

        Next	
     
        If DATAMANAGER.IsMoreNextData(szTranID) = True Then
            DATAMANAGER.RequestNextData(szTranID)
        End If
        
    End If
    
    If szTranID = "obtsd_fbnk_302r_1" Then
    
        For lRow = 0 To GridT3.rowcount - 1
	
            If GridT3.GetCellData("bd_cell3", lRow) = "4" Then
               GridT3.SetCellData("bd_cell3", lRow, "이종통화매수") 
               GridT3.SetCellFgColor("bd_cell3", lRow, 10)  
            ElseIf GridT3.GetCellData("bd_cell3", lRow) = "5" Then
               GridT3.SetCellData("bd_cell3", lRow, "이종통화매도") 
               GridT3.SetCellFgColor("bd_cell3", lRow, 7)
            End If
	
            If GridT3.GetCellData("bd_cell5", lRow) = "0" Then
               GridT3.SetCellData("bd_cell5", lRow, "신청") 
            ElseIf GridT3.GetCellData("bd_cell5", lRow) = "1" Or GridT3.GetCellData("bd_cell5", lRow) = "2" Then
               GridT3.SetCellData("bd_cell5", lRow, "의뢰") 
            ElseIf GridT3.GetCellData("bd_cell5", lRow) = "3" Then 
               GridT3.SetCellData("bd_cell5", lRow, "신청") 
            ElseIf GridT3.GetCellData("bd_cell5", lRow) = "4" Then
               GridT3.SetCellData("bd_cell5", lRow, "결제") 
            ElseIf GridT3.GetCellData("bd_cell5", lRow) = "9" Then
                GridT3.SetCellData("bd_cell5", lRow, "취소") 
		   End If
		
		   If GridT3.GetCellData("bd_cell11", lRow) = "VND" Then
		       GridT3.SetCellData("bd_cell11", lRow, "VND 베트남 동")
		   End If
		   
		   If GridT3.GetCellData("bd_cell6", lRow) = "VND" Then
		       GridT3.SetCellData("bd_cell6", lRow, "VND 베트남 동")
		   ElseIf GridT3.GetCellData("bd_cell6", lRow) = "USD" Then
		       GridT3.SetCellData("bd_cell6", lRow, "USD 미국 달러")
		   End If
		       
		   If GridT3.GetCellData("bd_cell14", lRow) = "VND" Then
		       GridT3.SetCellData("bd_cell14", lRow, "VND 베트남 동")
		   ElseIf GridT3.GetCellData("bd_cell14", lRow) = "USD" Then
		       GridT3.SetCellData("bd_cell14", lRow, "USD 미국 달러")
		   End If
		       
		   L_SELN_CRCD = GridT3.GetCellData("bd_cell0" , lRow)
		   L_APLT_AMT  = GridT3.GetCellData("bd_cell1" , lRow)
		   L_APLT_AMT_STRING = "(" & L_SELN_CRCD & ") " & FormatNumber(L_APLT_AMT , 2 ,0 , 0 , -1)
		       
		   GridT3.SetCellData("bd_cell12", lRow, L_APLT_AMT_STRING)
		       
		   L_CHAN_TYPE = GridT3.GetCellData("bd_cell14" , lRow)
		   If LEFT(L_CHAN_TYPE,2) = "01" Then
		       GridT3.SetCellData("bd_cell14" , lRow , "창구")
		   ElseIf LEFT(L_CHAN_TYPE,2) = "15" Then
		       GridT3.SetCellData("bd_cell14" , lRow , "MTS")
		   ElseIf L_CHAN_TYPE = "020" Then
		       GridT3.SetCellData("bd_cell14" , lRow , "HTS")
		   End If

        Next	
    
        If DATAMANAGER.IsMoreNextData(szTranID) Then
            DATAMANAGER.RequestNextData(szTranID)
        End If
	   
    End If
    
    If szTranID = "obrtd_fcur_010r" Then
    
        BtnCnfrT1.enable = True
	
        If RdoMnecClcdT1.currentindex = 0 Or RdoMnecClcdT1.currentindex = "0" Then
            ImgSelnT1.top = 163
            LblSelnCrcd2T1.top = 160
            ImgByovT1.top = 377
            LblByovCrcd2T1.top = 375
        ElseIf RdoMnecClcdT1.currentindex = 1 Or RdoMnecClcdT1.currentindex = "1" Then
            ImgSelnT1.top = 377
            LblSelnCrcd2T1.top = 375
            ImgByovT1.top = 163
            LblByovCrcd2T1.top = 160
        End If

    End If
    
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    If szTranID = "obtsd_fbnk_301a" Then
    
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("신청처리 오류" , szErrMsg , "", 6)	
        Else
            Form.MsgBox("신청처리 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If
	
    End If
    
    If szTranID = "obtsd_fbnk_301a_1" Then
    
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("취소처리 오류" , szErrMsg , "", 6)	
        Else
            Form.MsgBox("취소처리 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If
	
    End If
    
    If szTranID = "obtsd_fbnk_302r" Then
    
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("신청내역 조회 오류" , szErrMsg , "", 6)
        Else
            Form.MsgBox("신청내역 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If

    End If
    
    If szTranID = "obtsd_fbnk_302r_1" Then
    
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("신청내역 조회 오류" , szErrMsg , "", 6)            
        Else
            Form.MsgBox("신청내역 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If
        

    End If
    
    If szTranID = "obrtd_fcur_010r" Then
    
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("잔액 조회 오류" , szErrMsg , "", 6)            
        Else
            Form.MsgBox("잔액 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If
	
	
        RdoMnecClcdT1.currentindex = -1
        ImgSelnT1.top = 170
        LblSelnCrcd2T1.top = 170
        ImgByovT1.top = 372
        LblByovCrcd2T1.top = 372	
	
    End If
    
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)

    ControlDisplay(nCurrentTab)
    
    if nCurrentTab = 0 Or nCurrentTab = "1" Then    
        BtnRefreshT1_OnClick()
    Elseif nCurrentTab = 1 Or nCurrentTab = "1" Then    
        BtnRefreshT2_OnClick()
    ElseIf nCurrentTab = 2 Or nCurrentTab = "2" Then
        BtnRefreshT3_OnClick()    
    End If
    
End Sub


