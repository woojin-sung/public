Dim ORGL_SRNO
Dim ORGL_APLT_AMT
Dim g_szCertUserType '로그인 타입 20220417 아이티젠 김성수 추가
'============================================================================
Sub Form_OnFormInit()
	g_szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입
	
	Dim szScreenNo 
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	
    if szScreenNo == "16083" then '이종통화 환전 내역 조회
        Tab0.currenttab = 2
        Tab0_OnTabChanged(2)
    Else
        Tab0.currenttab = 0
        Tab0_OnTabChanged(0)
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'    If sKeyName = "mhetc90060_p5" Then '공인인증
	'20220418 아이티젠 김성수 수정
    If sKeyName = "mhetc90060_p5" or sKeyName = "mhetc90060_px" Then '공인인증
        Dim szTempData
        szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		'20220418 아이티젠 김성수 추가
'        If szTempData(0) == "ok" Then		'성공
        If szTempData(0) == "ok" or sRet == "ok" Then		'성공
	
            If Tab0.currenttab = 0 Or Tab0.currenttab = "0" Then
	    
                ACNO = Left(Acnt.caption,8)
                ASNO = Right(Acnt.caption,2)	    
                MnecClcd = RdoMnecClcdT1.currentindex
                ApltAmt = EdtApltAmtT1.caption
		
		       plain_rm = Form.GetSharedData("&PLAIN_RM", False)
		       If plain_rm == "1" Then
		           DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
		       Else
		           DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
		       End If
		
                DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "CONT_CLS_CODE"     , 0 , "4"  )   '온라인
                DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "PROS_CLS_CODE"     , 0 , "1"  )   '신청
                DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "ACNO"              , 0 , ACNO )   '계좌번호
                DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "ASNO"              , 0 , ASNO )   '계좌일련번호
                DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_TRGT_CRCD"    , 0 , "VND")   '환전대상통화
                DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "FRCR_SELN_APLT_AMT", 0 , ApltAmt) '환전신청금액

                If MnecClcd = 0 Or MnecClcd = "0" Then '이종통화매수
                    DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_CLCD"      , 0 , "4"  ) '환전구분 : 이종통화매수
                    DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_BYOV_CRCD" , 0 , "VND") '매수통화
                    DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_SELN_CRCD" , 0 , "USD") '매도통화		
                ElseIf MnecClcd = 1 Or MnecClcd = "1" Then '이종통화매도
                    DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_CLCD"      , 0 , "5"  ) '환전구분 : 이종통화매도
                    DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_BYOV_CRCD" , 0 , "USD") '매수통화
                    DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_SELN_CRCD" , 0 , "VND") '매도통화
                Else
                    Form.MsgBox("알림" , "환전구분을 선택해주십시오." , "", 6)
                    Exit Sub
                End If
	    
                DATAMANAGER.RequestTranData("obtsd_fbnk_301a")	    
		
            ElseIf Tab0.currenttab = 1 Or Tab0.currenttab = "1" Then
	    
                For i = 0 To GridT2.rowcount - 1
    
                    checkState = GridT2.GetCellData("bd_cell0" , i)
	
                    If checkState = "1" Or checkState = 1 Then
	
                        ACNO = Left(Acnt.caption,8)
                        ASNO = Right(Acnt.caption,2)	    
                        apltDate = GridT2.GetCellData("bd_cell2"  , i)
                        apltSrno = GridT2.GetCellData("bd_cell10" , i)
			
		               plain_rm = Form.GetSharedData("&PLAIN_RM", False)
		               If plain_rm == "1" Then
		                   DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
		               Else
		                   DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
		               End If

                        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "PROS_CLS_CODE"  , 0 , "2"     ) '취소
                        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "ACNO"           , 0 , ACNO    ) '계좌번호
                        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "ASNO"           , 0 , ASNO    ) '계좌일련번호
                        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "ORGL_ACPT_DATE" , 0 , apltDate) '원신청일자
                        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_301a_1" , "InBlock1" , "ORGL_SRNO"      , 0 , apltSrno) '원신청일련번호
                        DATAMANAGER.RequestTranData("obtsd_fbnk_301a_1")

                    End If
	
                Next
	   
            End If

        Else						
            Exit Sub '실패
        End If
	
    End If
	
End Sub

