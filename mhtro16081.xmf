'============================================================================
Sub GridT2_OnClickUp(lRow, szCellID)

    If szCellID = "bd_cell0" Then
    
        tempCheck = GridT2.GetCellData("bd_cell0", lRow)
        'GridT2.SetAllCheck("bd_cell0" , 0)
	   For i = 0 To GridT2.rowcount - 1
	       GridT2.SetCellData("bd_cell0", i, 0)
	       GridT2.SetCellData("bd_cell0", i, "0")
	   Next
	
        GridT2.SetCellData("bd_cell0", lRow , tempCheck)
	
        If tempCheck = 1 Or tempCheck = "1" Then
            BtnCnclT2.enable = True
        Else
            BtnCnclT2.enable = False
        End If

    End If
    
End Sub

'============================================================================
Sub BtnRefreshT1_OnClick()
	RdoMnecClcdT1_OnClick(RdoMnecClcdT1.currentindex)
End Sub

'============================================================================
Sub BtnRefreshT2_OnClick()

    plain_rm = Form.GetSharedData("&PLAIN_RM", False)
    If plain_rm == "1" Then
        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_302r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
    Else
        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_302r" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
    End If

    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "BRNC_CLS_CODE"  , 0 , "1"          )    
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "IQRY_CLS_CODE"  , 0 , "1"          )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "IQRY_STA_DATE"  , 0 , "00010101"   )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "IQRY_FIN_DATE"  , 0 , "99991231"   )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "ACNO"           , 0 , Left(Acnt.caption,8) )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "ASNO"           , 0 , Right(Acnt.caption,2))
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "MNEC_CLCD"      , 0 , "%"          )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "MNEC_TRGT_CRCD" , 0 , "VND"        )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "APLT_YN"        , 0 , "0"          )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "SNDN_YN"        , 0 , "X"          ) '미발송된내역만 취소가능
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "RSPN_YN"        , 0 , "X"          ) '예탁원 응답이 오지 않은 내역만 취소가능
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "RCMS_YN"        , 0 , "X"          ) '예탁원 환전결과가 오지 않은 내역만 취소가능
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "STLM_YN"        , 0 , "X"          ) '결제가 완료되지 않은 내역만 취소가능
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r" , "InBlock1" , "CNCL_YN"        , 0 , "X"          ) '취소내역은 또 취소할 수 없음
    DATAMANAGER.RequestTranData("obtsd_fbnk_302r") '취소대상내역 조회

End Sub

'============================================================================
Sub BtnRefreshT3_OnClick()

    plain_rm = Form.GetSharedData("&PLAIN_RM", False)
    If plain_rm == "1" Then
        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_302r_1" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "caption"))   '계좌비밀번호
    Else
        DATAMANAGER.SetDataValue(0 , "obtsd_fbnk_302r_1" , "InBlock1" , "ACNT_PWD" , 0 , Form.GetCtlProp("EdtPwd" , "encdata"))   '계좌비밀번호
    End If

    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "BRNC_CLS_CODE"  , 0 , "1"                  )    
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "IQRY_CLS_CODE"  , 0 , "1"                  )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "IQRY_STA_DATE"  , 0 , ClnFromDateT3.caption)
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "IQRY_FIN_DATE"  , 0 , ClnToDateT3.caption  )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "ACNO"           , 0 , Left(Acnt.caption,8) )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "ASNO"           , 0 , Right(Acnt.caption,2))
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "MNEC_CLCD"      , 0 , "%"                  )
    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "MNEC_TRGT_CRCD" , 0 , "VND"                )
    
    '신청여부
    If ChkApltT3.checkstate = "0" Or ChkApltT3.checkstate = 0 Then
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "APLT_YN" , 0 , "X") 
    Else
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "APLT_YN" , 0 , "0") 
    End If

    '예탁원의뢰여부
    If ChkRqstT3.checkstate = "0" Or ChkRqstT3.checkstate = 0 Then
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "SNDN_YN" , 0 , "X") 
    Else
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "SNDN_YN" , 0 , "1") 
    End If
    
    '예탁원 응답수신여부 & 예탁원 환전결과수신여부
    If ChkRcmsT3.checkstate = "0" Or ChkRcmsT3.checkstate = 0 Then
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "RSPN_YN" , 0 , "X")
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "RCMS_YN" , 0 , "X")
    Else
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "RSPN_YN" , 0 , "2") 
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "RCMS_YN" , 0 , "3")
    End If
    
    '결제완료여부
    If ChkCmpT3.checkstate = "0" Or ChkCmpT3.checkstate = 0 Then
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "STLM_YN" , 0 , "X")
    Else
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "STLM_YN" , 0 , "4")
    End If
    
    '취소여부
    If ChkCancT3.checkstate = "0" Or ChkCancT3.checkstate = 0 Then
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "CNCL_YN" , 0 , "X")
    Else
        DATAMANAGER.SetDataValue(0, "obtsd_fbnk_302r_1" , "InBlock1" , "CNCL_YN" , 0 , "9")
    End If
    
    DATAMANAGER.RequestTranData("obtsd_fbnk_302r_1") '신청내역 조회

End Sub

'============================================================================
Sub BtnCnfrT1_OnClick()

    ACNO = Left(Acnt.caption,8)
    ASNO = Right(Acnt.caption,2)	    
    MnecClcd = RdoMnecClcdT1.currentindex
    TrgtCrcd = CmbTrgtCrcdT1.caption
    ApltAmt = EdtApltAmtT1.caption
    PWD = EdtPwd.caption
   
    If TRIM(PWD) = "" Then
        Form.MsgBox("알림" , "비밀번호를 입력해주십시오." , "", 6)
        Exit Sub
    End If
   
    If CDBL(ApltAmt) <= 0 Or Trim(ApltAmt) = "" Then
        Form.MsgBox("알림" , "환전금액을 입력해주십시오." , "", 6)
        Exit Sub
    End If
    
    If CDBL(EdtAbleAmtT1.caption) < CDBL(ApltAmt) Then
        Form.MsgBox("알림" , "환전가능금액을 확인하십시오." , "", 6)
        Exit Sub
    End If
    
    If (MnecClcd = 1 Or MnecClcd = "1") And ApltAmt - CLNG(ApltAmt) > 0 Then
        Form.MsgBox("알림" , "베트남통화 소수점 이하 매도는 불가합니다." , "", 6)
        Exit Sub    
    End If    
    
    If (MnecClcd = 1 Or MnecClcd = "1") And TRIM(TrgtCrcd) = "베트남 동(VND)" And CDBL(ApltAmt) < 1000 Then
       Form.MsgBox("알림" , "현지 환전결과가 USD 0인 경우는 환전신청이 취소될 수 있습니다." , "", 6) 
    End If
    
    '20220419 아이티젠 김성수 추가
	If g_szCertUserType == "1" Or g_szCertUserType == 1 Then '간편인증 v001
	    Form.OpenFramePopup( "mhetc90060_px" , "" , "")'간편인증
	Else
	    Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증
	End If
        
End Sub

'============================================================================
Sub BtnWarnT1_OnClick()
	Form.OpenFramePopup("mhtro16081_p3" , "" , "")
End Sub

'============================================================================
Sub BtnCnclT2_OnClick()

    PWD = EdtPwd.caption
   
    If TRIM(PWD) = "" Then
        Form.MsgBox("알림" , "비밀번호를 입력해주십시오." , "", 6)
        Exit Sub
    End If

    For i = 0 To GridT2.rowcount - 1
    
        checkState = GridT2.GetCellData("bd_cell0" , i)
		
        If checkState = "1" Or checkState = 1 Then
			'20220419 아이티젠 김성수 추가
			If g_szCertUserType == "1" Or g_szCertUserType == 1 Then '간편인증 v001
			    Form.OpenFramePopup( "mhetc90060_px" , "" , "")		'간편인증
			Else
			    Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증
			End If
        End If
	
    Next
    
End Sub


'============================================================================
Sub ClnFromDateT3_OnEditComplete()
	ClnCheck()
	BtnRefreshT3_OnClick()
End Sub

'============================================================================
Sub ClnToDateT3_OnEditComplete()
	ClnCheck()
	BtnRefreshT3_OnClick()
End Sub

Sub ClnCheck()

    If ClnFromDateT3.caption > ClnToDateT3.caption Then
        Form.MsgBox("알림", "종료일자는 시작일자보다 이후여야 합니다" , "", "")
        ClnToDateT3.caption = ClnFromDateT3.caption
    End If
    
End Sub



