	<SCRIPT_INFO _len="8333" _ulen="7747" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_인증서목록
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20201126 SWJ START : 공인인증서 '공인'글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sGubun '인증서업무구분
Dim g_OpenType

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		g_sGubun = sParam

		if g_sGubun == "export" then
			Table0.SetCellString(1, 0, "PC나 스마트폰으로 복사할 인증서를 선택해주세요.") '20200605 SWJ 스마트폰 매체 추가
																				
		elseif g_sGubun == "update" then
			Table0.SetCellString(1, 0, "갱신할 인증서를 선택해 주세요.")				
			
		elseif g_sGubun == "regi" then
			Table2.visible = true
			Table0.top = "29"
			Table0.SetCellString(1, 0, "등록할 인증서를 선택해 주세요.")				
			Grid0.top = "93"
			Grid0.height = "467"
			
		elseif g_sGubun == "management" then
			Grid0.top = "29"
			Grid0.height = "578"
		end if
		
		Dim sCertCnt, sToday, sCalDate 
		sCertCnt = Form.GetCertListSize()
		sToday = Form.GetSharedData("&HOST_DATE",false )
		sCalDate = Form.calcDateTime( 0, 0, 30, 0, 0, 0 )
		sCalDate = Left(sCalDate, 8)
		
		if sCertCnt ~= null and sCertCnt ~= "" then
			if CInt(sCertCnt) > 0 then
				Grid0.rowcount = sCertCnt
				
				Dim sCertInfo, sTemp, sDate
				
				for i = 0 to Grid0.rowcount-1
					sCertInfo = Form.GetCertListDataAt(i)
					sTemp = Split(sCertInfo, ";")
					
					for j = 0 to #sTemp-1
						'sTemp[0] 성명
						'sTemp[1] DN
						'sTemp[2] 종류(범용개인)
						'sTemp[3] 발급기관
						'sTemp[5] 사용가능여부(가능1)
						'sTemp[6] 만기일
						'sTemp[7] 시작일
						
						'NOHES START 20160602 은행개인 타기관 등록 막음.
						If g_sGubun == "regi" Then
							If Trim(sTemp[2]) == "은행개인" Then
								Exit For
							End If
						End If
						'NOHES END
						
						Grid0.SetCellData( "bd_name", i, sTemp[0] )
						'NOHES START 20160609 발급기관정보 추가
						Grid0.SetCellData( "bd_cert", i, sTemp[2].." ("..sTemp[3]..")" )
						'NOHES END 
						sDate = sTemp[7]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						Grid0.SetCellData( "bd_date", i, "20"..sDate )
						
						sDate = sTemp[6]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						Grid0.SetCellData( "bd_Edate", i, "20"..sDate )
						Grid0.SetCellData( "bd_dn", i, sTemp[1] )
						Grid0.SetCellData( "bd_index", i, i )
						
						if tonumber("20"..sDate) > tonumber(sCalDate) then
'PENTA13 START => 2019.01.03
							Grid0.SetCellData( "bd_icon", i, "icon_sub_11.png" )
'PENTA13 ORGSRC
							'Grid0.SetCellData( "bd_icon", i, "icon_sub_05.9.png" )
'PENTA13 END
						else
'PENTA13 START => 2019.01.03
							Grid0.SetCellData( "bd_icon", i, "icon_sub_12.png" )
'PENTA13 ORGSRC
							'Grid0.SetCellData( "bd_icon", i, "icon_sub_06.9.png" )
'PENTA13 END
						end if
					next
				next
				
				for i = Grid0.rowcount-1 to 0 step -1
					sDate = Grid0.GetCellData( "bd_Edate", i )
					
					if CInt(sDate) < CInt(sToday) then
						Grid0.SetDeleteRow( i )
					end if
				next
			end if
		end if
	elseif sEventName == "BeforeCheck" then
		Form.triggerEvent( "#", "BeforeStep", "" )
	end if 
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if g_sGubun == "update" then '갱신인경우 "SignKorea" 인증서가 아닌경우 안내팝업
		Dim sCertSort 
		sCertSort = Grid0.GetCellData( "bd_cert", lRow )
		
		'20170825 HAMWG START : SignKorea 증권/보험용, 범용 사용가능
		if InStr(Trim(sCertSort), "SignKorea") > 0 then
		'NOHES START 20160609 발급기관정보추가
		'if InStr(Trim(sCertSort), "증권/보험용") > 0 or InStr(Trim(sCertSort), "범용") > 0 Then
		'if Trim(sCertSort) == "증권/보험용" then
		'20170825 HAMWG END
			Dim sDN, sIndex
			sDN = Grid0.GetCellData( "bd_dn", lRow )
			sIndex = Grid0.GetCellData( "bd_index", lRow )

			Form.SetSharedData("CERT_DN" , sDN)
			Form.SetSharedData("CERT_INDEX" , sIndex)
			Form.triggerEvent( "#", "NextStep", "1" )
		else
			Form.MsgBox( "알림", sCertSort.."인증서는 해당 발급기관에서 갱신하시기 바랍니다.", "", 6 )
		end if
	else	
		Dim sDN, sIndex
		sDN = Grid0.GetCellData( "bd_dn", lRow )
		sIndex = Grid0.GetCellData( "bd_index", lRow )
		
		Form.SetSharedData("CERT_DN" , sDN)
		Form.SetSharedData("CERT_INDEX" , sIndex)
		Form.triggerEvent( "#", "NextStep", "1" )
	end if
	
	if g_OpenType == "Login_Open" then
		if InStr(Trim(sCertSort), "SignKorea") <= 0 Then
	'	if Trim(sCertSort) == "증권/보험용" then
			Form.ShowAlert( "알림" , "SignKorea 인증서가 아닙니다.")
			Exit sub
		end if
		Form.SendReturnToParent("Login_Close","")
		Form.CloseForm()
	end if
	'NOHES END
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_OpenType = Form.GetOpenLinkData( )
	if g_OpenType == "Login_Open" then
		Form.SetScreenName("인증서 로그인")
		
		Table0.SetCellString(1, 0, "인증서를 선택해 주세요.")
		
		Dim sCertCnt, sToday, sCalDate 
		sCertCnt = Form.GetCertListSize()
		sToday = Form.GetSharedData("&HOST_DATE",false )
		sCalDate = Form.calcDateTime( 0, 0, 30, 0, 0, 0 )
		sCalDate = Left(sCalDate, 8)
		
		if sCertCnt ~= null and sCertCnt ~= "" then
			if CInt(sCertCnt) > 0 then
				Grid0.rowcount = sCertCnt
				
				Dim sCertInfo, sTemp, sDate
				
				for i = 0 to Grid0.rowcount-1
					sCertInfo = Form.GetCertListDataAt(i)
					sTemp = Split(sCertInfo, ";")
					
					for j = 0 to #sTemp-1
						'sTemp[0] 성명
						'sTemp[1] DN
						'sTemp[2] 종류(범용개인)
						'sTemp[3] 발급기관
						'sTemp[5] 사용가능여부(가능1)
						'sTemp[6] 만기일
						'sTemp[7] 시작일
						
						Grid0.SetCellData( "bd_name", i, sTemp[0] )
						'NOHES START 20160609 발급기관정보추가
						Grid0.SetCellData( "bd_cert", i, sTemp[2].." ("..sTemp[3]..")" )
						'NOHES END
						sDate = sTemp[7]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						Grid0.SetCellData( "bd_date", i, "20"..sDate )
						
						sDate = sTemp[6]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						Grid0.SetCellData( "bd_Edate", i, "20"..sDate )
						Grid0.SetCellData( "bd_dn", i, sTemp[1] )
						Grid0.SetCellData( "bd_index", i, i )

						if tonumber("20"..sDate) > tonumber(sCalDate) then
'PENTA13 START => 2019.01.03
							Grid0.SetCellData( "bd_icon", i, "icon_sub_11.png" )
'PENTA13 ORGSRC
							'Grid0.SetCellData( "bd_icon", i, "icon_sub_05.9.png" )
'PENTA13 END
						else
'PENTA13 START => 2019.01.03
							Grid0.SetCellData( "bd_icon", i, "icon_sub_12.png" )
'PENTA13 ORGSRC
							'Grid0.SetCellData( "bd_icon", i, "icon_sub_06.9.png" )
'PENTA13 END
						end if
					next
				next
				
				for i = Grid0.rowcount-1 to 0 step -1
					sDate = Grid0.GetCellData( "bd_Edate", i )
					sCert = Grid0.GetCellData( "bd_cert", i )
					if CInt(sDate) < CInt(sToday) then
						Grid0.SetDeleteRow( i )
					'20170825 HAMWG START : SignKorea 공인인증서 외 인증서 표시안함
					elseif InStr(Trim(sCertSort), "SignKorea") <= 0 then
					'20170825 HAMWG END
						Grid0.SetDeleteRow( i )
					end if
					
				next
			end if
		end if
	end if
	
End Sub

