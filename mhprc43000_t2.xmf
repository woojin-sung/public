	<SCRIPT_INFO _len="9075" _ulen="8585" >
'============================================================================
' 01. 화 면 명 : 탭_시간별
' 02. 화면설명 : 투자자동향 시간별 그리드
' 03. 작    성 : 2016. 02. 18.	유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tMarket, g_tMarket_Code	'그룹콤보 선택에 따른 시장명, 코드 입력값 테이블
Dim g_nSelect
Dim g_nRadio	'라디오 버튼선택
Dim g_nCls_Code
Dim g_szData			'누적차트에 보낼 데이터
Dim g_NextCount		'Next조회시 Index

' 20190809_01 HWG START : 위클리옵션추가
'20190306 LES START 주식선물추가
'orgn
'g_tMarket = {"KSP", "KSQ", "K2I", "K2I", "K2I", "MKI", "MKI", "MKI"}
'g_tMarket_Code = {"0001", "1001", "F001", "OC01", "OP01", "F005", "OC02",  "OP02"}
g_tMarket = {"KSP", "KSQ", "K2I", "K2I", "K2I", "WKM", "WKM", "WKI", "WKI","MKI", "MKI", "MKI", "999"}
g_tMarket_Code = {"KGG01P", "QGG01P", "F001  ", "OC01  ", "OP01  ", "OC05  ", "OP05  ", "OC04  ", "OP04  ", "F005  ", "OC02  ",  "OP02  ", "S001  "}	'22년 차세대 업종코드 하드코딩
'20190306 LES END
' 20190809_01 HWG END

g_nCls_Code = "000"
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
'	Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_nRadio = 0
	g_NextCount = 0
	g_nSelect = cmb0.cbkeydata

	DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD" , nIndex , g_tMarket(0) )
	DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD2" , nIndex , g_tMarket_Code(0) )
	DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , nIndex , g_nCls_Code )
	DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , nIndex , g_nCls_Code )
	
	DATAMANAGER.RequestTranData( "ohhts_1521_002r" )
End Sub

'============================================================================
'	cmb0_OnEditComplete(iIndex) : 콤보 선택시 TR입력
'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	'이전의 TR 연결 해제
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1521_002r" )
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1521_002r_1522" )
	
	g_nSelect = iIndex	'콤보 선택한 index를 n_Select변수에 대입
	g_NextCount = 0
	
'	Form.ShowAlert("확인", g_tMarket(CInt(n_Select)))
	
	'Radio 선택 값에 따른 TR 연결
	if g_nRadio == 1 then
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1522", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1522", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , nIndex , g_nCls_Code )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , nIndex , g_nCls_Code )
		
		DATAMANAGER.RequestTranData( "ohhts_1521_002r_1522" )
	else
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , nIndex , g_nCls_Code )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , nIndex , g_nCls_Code )
	
		DATAMANAGER.RequestTranData( "ohhts_1521_002r" )
	end if
	
End Sub
'============================================================================
'	rdo0_OnClick(nIndex) : 금액/수량 선택 라디오
'============================================================================
Sub rdo0_OnClick(nIndex)
	'이전의 TR 연결 해제
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1521_002r" )
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1521_002r_1522" )
	
	g_NextCount = 0
	g_nRadio = nIndex
	
	'Radio 선택 값에 따른 TR 연결
	if g_nRadio == 0 then
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , nIndex , g_nCls_Code )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , nIndex , g_nCls_Code )
		
		DATAMANAGER.RequestTranData( "ohhts_1521_002r" )
	else
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1522", "InBlock1", "FID_INPUT_ISCD" , 0 , g_tMarket(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r_1522", "InBlock1", "FID_INPUT_ISCD2" , 0 , g_tMarket_Code(CInt(g_nSelect)) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , nIndex , g_nCls_Code )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1521_002r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , nIndex , g_nCls_Code )
		
		DATAMANAGER.RequestTranData( "ohhts_1521_002r_1522" )
	end if
	
End Sub
'============================================================================
'	DATAMANAGER_OnReceiveTranComplete(szTranID) : 실시간 TR 연결
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'실시간 TR 해제
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_invr_cntg" )
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_invr_cntg_1" )
	DATAMANAGER.CancelRealData("ohhts_invr_cntg")
	DATAMANAGER.CancelRealData("ohhts_invr_cntg_1")
	
	'실시간 TR 연결 설정 , 금액 단위 억단위로 맞추는 설정
	if szTranID == "ohhts_1521_002r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_1521_002r", "OutBlock1")-1
			for j = 1 to 12 
				'반올림 한뒤 뒤에 숫자를 잘라내서 그리드에 셋팅
				grd0.SetCellData( "bd_cell"&j, g_NextCount, Left( Round(grd1.GetCellData( "bd_cell"&j , g_NextCount),-2), Len(Round(grd1.GetCellData( "bd_cell"&j , g_NextCount),-2))-2))
'				grd0.SetCellData( "bd_cell1", i, ROUND(DATAMANAGER.GetDataValue( 0 , "ohhts_1521_002r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i), -2))
			next
			g_NextCount = g_NextCount + 1
		next
		DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )
		
		DATAMANAGER.RequestRealData( "ohhts_invr_cntg" )
	else
		DATAMANAGER.SetDataValue( 1 , "ohhts_invr_cntg_1", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_tMarket_Code(CInt(g_nSelect)) & g_tMarket(CInt(g_nSelect)) )
	
		DATAMANAGER.RequestRealData( "ohhts_invr_cntg_1" )
	end if
	
End Sub
'============================================================================
'	grd0_OnScrollEnd() : 스크롤을 내릴때 추가적인 데이터 생성
'============================================================================
Sub grd0_OnScrollEnd()
	'g_nRadio = 0 일때 대금TR, 1일때 수량TR 연결
	if g_nRadio == 0 then
		DATAMANAGER.RequestNextData( "ohhts_1521_002r" )
	else
		DATAMANAGER.RequestNextData( "ohhts_1521_002r_1522" )
	end if
End Sub
'============================================================================
' btn0_OnClick() : 누적차트 팝업 호출 부분
'============================================================================
Sub btn0_OnClick()
	g_szData = g_nSelect & "★" & g_nRadio & "★" & "시간별"'g_tMarket(CInt(g_nSelect)) & "★" & g_tMarket_Code(CInt(g_nSelect)) & "★" & g_nCls_Code & "★" & g_nCls_Code
	Form.OpenPopup("mhprc43000_p1" , g_szData , sPosInfo)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	
	if szTranID == "ohhts_invr_cntg" then
		for j = 1 to 12 
			grd0.SetCellData( "bd_cell"&j, 0, Left( Round(CDbl(grd1.GetCellData( "bd_cell"&j , 0),-2)), Len(Round(CDbl(grd1.GetCellData( "bd_cell"&j , 0),-2)))-2) )
			'grd0.SetCellData( "bd_cell1", i, ROUND(DATAMANAGER.GetDataValue( 0 , "ohhts_1521_002r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i), -2))
		next
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()

	rdo0_OnClick(g_nRadio)
	
End Sub


