'조회
Sub RequestData()
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "RECEIVE", "")
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call acnt0_ChangeAccount()
End Sub

'============================================================================
Sub Form_OnRefresh()
	'Call RequestData()	'조회
	DATAMANAGER.RequestTranData( "obwat_ctcs_043r" )	'선물계좌 조회
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	cmbSeq.clear = 1								'계약번호 초기화
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
End Sub

'============================================================================
Sub cmbSeq_OnEditComplete(iIndex)
	'Call RequestData()	'조회
	DATAMANAGER.RequestTranData( "obwat_ctcs_043r" )	'선물계좌 조회
End Sub

'============================================================================
Sub btnSearch_OnClick()
	'Call RequestData()	'조회
	DATAMANAGER.RequestTranData( "obwat_ctcs_043r" )	'선물계좌 조회
End Sub

'============================================================================
