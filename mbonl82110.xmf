	<SCRIPT_INFO _len="5684" _ulen="5374" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 신용거래약정
' 02. 화면설명 : 신용거래약정
' 03. 작    성 : 2022.09.04 이아영
' 04. 수    정 : 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bContract  '대출구분 (01:신용)
Dim g_szTrData


'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "oblon_basc_811r" ) '신용약정조회
	DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
	g_FinCustomer = "N"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "End" then
		lnkMain.linkfile = ""
		DATAMANAGER.RequestTranData( "oblon_basc_811r" )
		
	elseif sEventName == "Change" then
		if trim(sParam) ~= "" then
			lnkMain.linkfile = "mbonl82110_s1"
			Form.triggerEvent("lnkMain", "InitChange", sParam) '등록여부, 기본형투자형, SMS, Email	
		end if	
	
	elseif sEventName == "ChangeView" then
		if trim(sParam) ~= "" then
			lnkMain.linkfile = "mbonl82110_s1"
			Form.triggerEvent("lnkMain", "ChangeAccount", sParam) '등록여부, 기본형투자형, SMS, Email	
		end if
	elseif sEventName == "FormClose" then
		Form.OpenMainMenuWithindex(2,2,0)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_basc_811r" then
		Dim szID
		szID = Form.GetSharedData("&USER_ID", false )
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , szID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOAN_TYPE_CODE" , 0 , "11")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
	elseif szTranID	= "obsap_acif_999a" then
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_811r" then	
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount(0, "oblon_basc_811r", "OutBlock1"))
		if nCnt > 0 then
			g_bContract = true
		else
			g_bContract = false
		end if 
		
	
		if g_bContract == true then
			lnkMain.linkfile = "mbonl82110_s6"
			Form.triggerEvent("lnkMain", "Init", "") 
		else	
			lnkMain.linkfile = "mbonl82110_s1"
			Form.triggerEvent("lnkMain", "Init", "")'g_szTrData) '등록여부, 기본형투자형, SMS, Email	
		end if
		
'		Dim szRegDate
'		szRegDate = DATAMANAGER.GetDataValue( 0, "oblon_basc_811r", "OutBlock1", "REG_DATE", 0 ) 
'		
'		if trim(szRegDate) == "" or trim(szRegDate) == "N" then
'			btnBottom.caption = "신용거래약정 신청"
'			g_bContract = false
'		else
'			btnBottom.caption = "신청정보 보기"
'			g_bContract = true
'		end if
'		
'		Dim sUI_PROD_OPNG_YN1 
'		Dim sUI_PROD_OPNG_YN2
'		Dim sLoanType
'		Dim szDejuDate
'		Dim szUI_COND
'		
'		sUI_PROD_OPNG_YN1 = DATAMANAGER.GetDataValue( 0, "oblon_basc_811r", "OutBlock2", "UI_PROD_OPNG_YN1" , 0 ) 'SMS		
'		sUI_PROD_OPNG_YN2 = DATAMANAGER.GetDataValue( 0, "oblon_basc_811r", "OutBlock2", "UI_PROD_OPNG_YN2" , 0 ) 'E-mail		
'		sLoanType = DATAMANAGER.GetDataValue( 0, "oblon_basc_811r", "OutBlock1", "MORG_APLY_FORM_CODE" , 0 ) '신용융자/대주코드		
'		szDejuDate = DATAMANAGER.GetDataValue( 0,"oblon_basc_811r", "OutBlock1", "STLN_STUP_DATE", 0 ) '대주일자
'		szUI_COND = DATAMANAGER.GetDataValue( 0, "oblon_basc_811r", "OutBlock1", "UI_COND_RSLT_CLS_VAL", 0 ) '유통융자 담보활용 동의 신청 여부
'		
'		g_szTrData = sLoanType.."★"..sUI_PROD_OPNG_YN1.."★"..sUI_PROD_OPNG_YN2.."★"..szRegDate.."★"..szDejuDate.."★"..szUI_COND
	elseif szTranID	= "obsap_acif_999a" then
		Dim szFnprJoinSrno
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		
		Form.SetSharedData( "FNPR_JOIN_SRNO", szFnprJoinSrno )
		Form.SetSharedData( "LoanYN", "Y" )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg 
	
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.."\n"..sSubMsg
	end if
	
	Form.ShowAlert("알림", szErrMsg)

End Sub


'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then	
			g_FinCustomer = "Y"
				DATAMANAGER.RequestTranData( "oblon_basc_811r" ) '신용약정조회
		elseif sRet == "CANCEL_mbonl81010_p20" then
			g_FinCustomer = "N"
			Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		end if
	end if
End Sub

