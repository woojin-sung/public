'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END

	'20210329 LES START 통합증거금
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 현재가 호가연동
	' ----------------------------------------------------------------------		
	if sEventName == "PRICE" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
	' ----------------------------------------------------------------------
	' 호가테이블 클릭 호가연동
	' ----------------------------------------------------------------------	
	elseif sEventName == "HOGA" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
	' ----------------------------------------------------------------------
	' 메인화면 이벤트처리 (종목변경/탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	elseif sEventName == "16060_InitCode" or sEventName == "16060_ChangeCode" or sEventName == "16060_ChangeTab" then	
		'20211012 HSZ 통합증거금
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
		
		if g_szCd <> sParam then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")	' 거래소벤더코드
			
			'20220524 아이티젠 김성수 해외주식 주문유형 추가
			'미국시장만 주문유형에 추가
			dim szList
			szList = Set_TypeList(g_szNg)
			cmbType.currentindex = "0"					' 0으로 변경해야 die안됨
			Form.SetCtlProp("cmbType", "clear", "")		' 콤보 리스트 클리어
			cmbType.cbinputdatatext = szList
			'20201124 LES END
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "16060_ChangeAcnt" then
		'20211012 HSZ 통합증거금
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
			
	' 20171127 HAMWG END	
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
			
			Return_AutoQty()
		else
			Init_InputControl()
		end if
		'20170919 HAMWG END
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if	
	' 20181022 HWG END
	'20221206_01 KBC START : 해외주식 미국PTP 종목과세관련
	' ----------------------------------------------------------------------
	' PTP경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if		
	'20221206_01 KBC END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		'20160829_01 LKM START
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
		 Form.SetSharedData("B_QTY_TYPE" , "2")
		'20160829_01 LKM END		
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
		
	'----------------------------------------------------------------------
	' 20210329 LES START 통합증거금 - 수량조회팝업 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "16060_p8" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'주문유형에 따른 주문단가
	szPrc = edtPrc.caption
	' HTS에서 가격없고, 가능금액조회시 현재가를 넣어준다.
	if Trim(szPrc) == "" and szTranID == "obtro_comn_025r" then
		if g_szLast == "" or CDbl(g_szLast) == 0 then
			szPrc = 0
		else
			szPrc = g_szLast
		end if
	end if

	' ----------------------------------------------------------------------
	' 해외주식 매수주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_101a" then
		g_szTR = szTranID
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_101a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									' 거래소코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "SELN_BYOV_CLCD"		, 0, "2")									' 매도/매수구분코드
'		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_CLS_CODE"		, 0, "01")									' 주문구분코드
'		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")									' 주문조건구분코드
		'20220524 김성수 추가 START
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_CLS_CODE"		, 0, Check_OrdType())							' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, Check_OrdCond())							' 주문조건구분코드
		'20220524 김성수 추가 End
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODQT"				, 0, edtQty.caption)							' 주문수량
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0, szPrc)									' 주문단가
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)							' 경고확인여부	' 20181022 HWG : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_6000_001r" then
		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
	
	'20171204 HAMWG START : 해외주식_시세조회 서비스 세팅
	elseif szTranID == "getGtsHogaDetail" then
		DATAMANAGER.SetDataValue( 0, "getGtsHogaDetail", "inblock", "code" , 0 , g_szCd )
		
	' ----------------------------------------------------------------------
	' 고시환율 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )
	
	' ----------------------------------------------------------------------
	' 주문가능금액 조회(100%)
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_oder_234r" then
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "ACNO"				, 0 , Form.GetTopCtlProp("acnt", "total"))	' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "ASNO"				, 0 , Form.GetTopCtlProp("acnt", "sequence"))	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm =="1" then
			DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "caption"))' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0 , sCodeData[1])						' 종목코드
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0 , g_szMk)								' 거래소코드
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "OVRS_MRKT_BROK_IDNO"	, 0 , "")
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "ODER_CRNC_PRC"		, 0 , szPrc)								' 주문단가
		DATAMANAGER.SetDataValue( 0, "obtro_oder_234r", "InBlock1", "APLY_RATE"			, 0 , "" )
		
		' ----------------------------------------------------------------------
		' 20210906 HSZ START 통합증거금 주문가능금액 조회(일반/통합)
		' ----------------------------------------------------------------------	
		if g_szCashNT == "N" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "IF_INTG_MARG_IQRY_YN" 	, 0 , "N")
		elseif g_szCashNT == "T" then
			if gTotalYN then
				DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "IF_INTG_MARG_IQRY_YN" 	, 0 , "Y")
			else
				DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "IF_INTG_MARG_IQRY_YN" 	, 0 , "N")
			end if
		end if
		
		' 20210906 HSZ END
		
	'----------------------------------------------------------------------
	' 20210329 LES START 통합증거금 - 약정조회
	'----------------------------------------------------------------------
	elseif szTranID == "obpds_srvc_323r" then
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" 			, 0 , " ")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" 			, 0 , "081")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "RMND_SRNO" 		, 0 , " ")
	
	end if
	'20171204 HAMWG END
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo

	' ----------------------------------------------------------------------
	' 해외주식 매수주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtro_oder_101a"	
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)

			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
			'20221206_01 KBC START : 해외주식 미국PTP 종목과세관련
			elseif szWarnCd = "3" then
				szData = "0" & "|" & szWarnMsg	' 매매구분|메시지
				Form.OpenPopup("mhtro16060_p15", szData , "")	'OnPopupReturn -> "PTP주문경고"
			'20221206_01 KBC END
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
				if Trim(szOrdCd) == "0001" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
					
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						Form.triggerEvent("#", "AfterOrd", szOrgNo)
					end if
					
				end if
			end if
			' 20181022 HWG END

	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
		Case "ohhts_6000_001r"

			g_szLast		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 	, 0 )	' 현재가
			g_szUpLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" 	, 0 )))	' 상한가
			g_szDnLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" 	, 0 )))	' 하한가
'			g_szUnit		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ASPR_UNIT" 	, 0 )	' 호가단위
			g_szOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" , 0 )	' 매매단위
			g_szCur		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 	, 0 )	' 통화
			g_szDecimal 	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
			g_szKorName	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" 	, 0 )	' 한글종목명
			g_szTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_TICK_CLS" 	, 0 )	' 종목 틱타입
'			g_szKofx		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 		, 0 )	' 환율
			
			GetHogaUnit(g_szMk, g_szLast, 0)		'20180710 HAMWG : 호가단위 설정함수 변경
			
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
			edtPrc.mask = sMask
			Table0.SetCellMaskInfo(2, 1, sMask)
			
			Table0.SetCellString(2, 0, g_szCur)
			Table0.SetCellString(0, 1, g_szOrdSize)
			
			DATAMANAGER.RequestTranData("obtro_comn_025r")
		Case "obtro_comn_025r"
			szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
			Table0.SetCellString(1, 1, szAnncExrt)
			
		Case "obtro_oder_234r"
			g_szCashNT = ""	'20210906 HSZ 통합증거금
			szAbleQty = DATAMANAGER.GetDataValue( 0, "obtro_oder_234r", "OutBlock1", "ODER_ABLE_QTY" , 0 )	' 현금가능수량
			edtQty.caption = szAbleQty
			edtQty_OnEditComplete()

		'20210329 LES START 통합증거금 - 약정조회
		Case "obpds_srvc_323r"
			'20211013 HSZ : SVCD 값이 0이면, 통합증거금 미약정 계좌
			szCnt = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVC_SRNO" , 0)
			
			if int(szCnt)<>0 then
				gTotalYN = true
				btnCashT.visible = true
				btnCashN.width = 35
			else
				gTotalYN = false
				btnCashT.visible = false
				btnCashN.width = 75
			end if
	'20171204 HAMWG END
	End Select	
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	
	'계좌번호
	szAcnt   = Form.GetTopCtlProp("acnt", "total")
	szAcntCd = Form.GetTopCtlProp("acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if
	
	szPrice = edtPrc.caption
	    
	if edtPrc.caption = "0" or edtPrc.caption = "" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
		exit Sub
	end if	    
	
	' 계좌번호|계좌일련번호|종목코드|거래소벤더코드|매매구분(1매도, 2매수)|주문수량|주문단가|소숫점자릿수
	szData = szAcnt & "★" & szAcntCd & "★" & g_szCd & "★" & g_szMk & "★" & "2" & "★" & edtQty.caption & "★" & szPrice & "★" & g_szDecimal
	Form.OpenPopup("mhtro16060_pa" , szData , "")
End Sub

