'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szBuyQty == "1" then			' 현금가능수량
		Request_Able()
	elseif g_szBuyQty == "2" then		' 최대가능수량 (해외주식은 미수가 없어 현금가능수량으로 조회)
		Request_Able()
	elseif g_szBuyQty == "3" then		' 수량입력
		edtQty.caption = g_szBuyQtyCnt
		edtQty_OnEditComplete()
	end if
End Function

'============================================================================
' Request_Able
'============================================================================
Function Request_Able()	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
	DATAMANAGER.RequestTranData("obtro_oder_234r")				' 주문가능금액 조회	
End Function

'============================================================================
' Check_OrdType 주문유형코드 20220524 아이티젠 김성수 추가
'============================================================================
Function Check_OrdType()
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	Select Case szIdx
		Case "0"
			return "01" '지정가
		Case "1"
			return "31" 'LOO
		Case "2"
			return "32" 'LOC
		Case "3"
			return "35" 'Limit VWAP
		Case "4"
			return "36" 'Limit TWAP
	End Select
	
End Function
'============================================================================
' Check_OrdCond 주문조건구분코드 20220524 아이티젠 김성수 추가
'============================================================================
Function Check_OrdCond()
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "0" '지정가
		Case "31"      
			return "2" 'LOO
		Case "32"      
			return "7" 'LOC
		Case "35"      
			return "0" 'Limit VWAP
		Case "36"      
			return "0" 'Limit TWAP
	End Select
	
End Function

'============================================================================
' Check_OrdName 주문유형명 20220524 아이티젠 김성수 추가
'============================================================================
Function Check_OrdName()
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "지정가"
		Case "05"
			return "시장가"
		Case "31"
			return "LOO" 
		Case "32"
			return "LOC" 
		Case "33"
			return "MOO" 
		Case "34"
			return "MOC" 
		Case "35"
			return "Limit VWAP" 
		Case "36"
			return "Limit TWAP" 
		Case "37"
			return "VWAP" 
		Case "38"
			return "TWAP" 
	End Select
End Function

'============================================================================
' 시장에 따른 주문유형 20220524 아이티젠 김성수 추가
'============================================================================
Function Set_TypeList(nGbn)
	if nGbn == "USA" then
'		return "00`지정가\r\n01`시장가"
		'20220524 아아티젠 김성수 수정
		return "00`지정가\r\n31`LOO\r\n32`LOC\r\n35`Limit VWAP\r\n36`Limit TWAP"
	else 
		return "00`지정가\r\n"
	end if
End Function
