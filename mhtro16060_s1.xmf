'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
' 20210329 LES START 통합증거금 - 수량조회 
'============================================================================
Function prcDecimalSet(szPrc)
	
	if Trim(edtPrc.caption) == "" then
		szPrc = ""
	else
		szChk = InStr(CStr(edtPrc.caption), ".")
	
		if CStr(szChk) == "0" then
			if g_szDecimal = "1" then
				szPrc = edtPrc.caption & ".0"	
			elseif g_szDecimal = "2" then
				szPrc = edtPrc.caption & ".00"	
			elseif g_szDecimal = "3" then
				szPrc = edtPrc.caption & ".000"	
			elseif g_szDecimal = "4" then
				szPrc = edtPrc.caption & ".0000"	
			end if 
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == "1" then 
				if g_szDecimal == "2" then
					szPrc = edtPrc.caption & "0"	
				elseif g_szDecimal == "3" then
					szPrc = edtPrc.caption & "00"	
				elseif g_szDecimal == "4" then
					szPrc = edtPrc.caption & "000"
				else 
					szPrc = edtPrc.caption
				end if 	
			elseif CStr(szCha) == "2" then 
				if g_szDecimal == "3" then
					szPrc = edtPrc.caption & "0"	
				elseif g_szDecimal == "4" then
					szPrc = edtPrc.caption & "00"
				else
					szPrc = edtPrc.caption
				end if	
			elseif CStr(szCha) == "3" then 
				if g_szDecimal == "4" then
					szPrc = edtPrc.caption & "0"
				else 
					szPrc = edtPrc.caption
				end if	
			else
				szPrc = edtPrc.caption
			end if
		end if
	end if
	
	return szPrc

End Function

'============================================================================
Sub cmbType_OnEditComplete(iIndex) '20220524 김성수 추가
	'20221213_01 KBC START 해외주식주간거래     
	sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
	
	if sDayYN == "Y" and Check_OrdType() <> "01" then
		if g_szMk == "0537" or g_szMk == "0321" or g_szMk == "0066" then
			Form.ShowAlert(g_szTitle, "주간거래는 지정가 주문만 가능합니다.")
		end if
	end if	
	'20221213_01 KBC END
		
	if Check_OrdType() == "35" or Check_OrdType() == "36" then
		bPopYN = Form.GetEnvData("OrdNotice_16060_p12")
		
		if bPopYN == "" or bPopYN == "0" then
			Form.OpenPopup("mhtro16060_p12" , "" , "") 'VWAP, TWAP 유의사항
		end if
	end if	
End Sub

