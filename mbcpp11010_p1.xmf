	<SCRIPT_INFO _len="13232" _ulen="12248" >
'============================================================================
' 01. 화 면 명 : 제안하기_제안내용보기(답변완료)
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

Dim g_PROP_REG_ID
Dim g_ANSR_CNTT

Dim maxLength				' 한 줄 최대 글자수
Dim g_LinHeight_answer		' 한 줄당 추가되는 컨트롤 높이 '20230511 수정
Dim g_LinHeight_response	' 한 줄당 추가되는 컨트롤 높이 '20230511 수정

Dim gURL_Type1
Dim gURL_Type2

Dim gBTN_Link1
Dim gBTN_Link2

Dim gURL_Link1
Dim gURL_Link2

Dim g_szOsType

maxLength					= 23	
g_LinHeight_answer			= 35 '20230511 수정

'20231030 android, ios 별로 답변 높이를 따로 지정
g_LinHeight_response_ios		= 20 
g_LinHeight_response_android	= 20 

g_LinHeight_notice          	= 18

'===========================================================================
' 							FORM 함수
'============================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Title0.fgcolor = "67"	'Q.
	Container0.Title2.fgcolor = "67"	'A.
	Container0.bgcolor = "066"


	g_PROP_REG_ID = Form.GetOpenLinkData()
	g_szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iO
	
	if g_szOsType == "1" then
		Title0.top = 45
		Container0.Title2.top = 17
		g_LinHeight_response = g_LinHeight_response_android
	else
		Title0.top = 42
		Container0.Title2.top = 15
		g_LinHeight_response = g_LinHeight_response_ios
	end if 
		
	if g_PROP_REG_ID <> "" and g_PROP_REG_ID <> null then
		DATAMANAGER.RequestTranData("obcpp_cbbs_021u")
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	if szTranID == "obcpp_cbbs_021u" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 0, g_PROP_REG_ID)
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iTextLength
	Dim stCaption
	
	if szTranID == "obcpp_cbbs_021u" then
	
		Dim szQSTN_TITL_NAME
		szQSTN_TITL_NAME  = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "QSTN_TITL_NAME",	0)
		g_ANSR_CNTT		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "QSTN_ANSR_CNTT",	0)
		
		'20240112 START
		'LabelTitle.caption = szQSTN_TITL_NAME
		'LabelTitle.SetMaxLineCount(5)	'컨트롤 라인 제한 함수	
		if g_szOsType == "1" then 
			
			LabelTitle.caption = szQSTN_TITL_NAME
			lineCntTitle = LabelTitle.linecnt
			LabelTitle.height = lineCntTitle * 15 + 15
		
			nOrgnContTop = Container0.top
			nNewContTop = CInt(Form.calcUnResize(LabelTitle.top, "1")) + CInt(Form.calcUnResize( LabelTitle.height, "1")) + 10
			Container0.top  = nNewContTop
			
			if nNewContTop >= nOrgnContTop then
				nNewContHeight = Container0.height - (nNewContTop - nOrgnContTop)
			else
				nNewContHeight = Container0.height + (nOrgnContTop - nNewContTop)
			end if
			
			Container0.height = nNewContHeight
			
		else
			
			LabelTitle.fontsize = 0
			LabelTitle.paddinginfo = "0,0,0,0"
			LabelTitle.caption = szQSTN_TITL_NAME
			LabelTitle.sizeTextFit()
			
			'오차줄이기
'			'lineCntTitle = Cint(Form.getLen(szQSTN_TITL_NAME) / 20)
'			lineCntTitle = Cint(Form.getLen(szQSTN_TITL_NAME) / 30)
'		ShowAlert("---", lineCntTitle)	
'			LabelTitle.height = LabelTitle.height - lineCntTitle * 5
		
			nOrgnContTop = Container0.top
			Container0.top = LabelTitle.top + LabelTitle.height + 10
			nNewContTop = Container0.top
			
			if nNewContTop >= nOrgnContTop then
				nNewContHeight = Container0.height - (nNewContTop - nOrgnContTop)
			else
				nNewContHeight = Container0.height + (nOrgnContTop - nNewContTop)
			end if
			
			Container0.height = nNewContHeight
			
		end if
		
		'20240112 END
		
		'화면 링크할 게 있는 경우!
		gURL_Type1 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_LNKN_TYPE_CODE1",	0))	'버튼연결유형코드 (M: MTS_화면번호, U: url)
		gURL_Link1 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_URL1",	0))			'버튼URL
		gBTN_Link1 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_CNTT1",	0))			'버튼내용
		
		if Trim(gURL_Type1) <> "" then
			Container0.LabelNotice1.caption = gBTN_Link1
			Container0.LabelNotice1.visible = True
		else
			Container0.LabelNotice1.visible = False
		end if
		
		gURL_Type2 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_LNKN_TYPE_CODE2",	0))	'버튼연결유형코드 (M: MTS_화면번호, U: url)
		gURL_Link2 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_URL2",	0))			'버튼URL
		gBTN_Link2 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_CNTT2",	0))			'버튼내용
		
		if Trim(gURL_Type2) <> "" then
			Container0.LabelNotice2.caption = gBTN_Link2
			Container0.LabelNotice2.visible = True
		else
			Container0.LabelNotice2.visible = False
		end if

		'20240112 START
		'call f_CountLine(1)
		
		if g_szOsType == "1" then 
		
			'Container0.LabelText.fontsize = 0
			'세팅순서 : 본문내용 넣어주기 > 본문내용 몇줄인지 가져오기 > 라벨높이값 조정 > 최대줄수 조정 > 버튼URL있는 경우 높이 조정 > 컨테이너 사이즈조정
			Container0.LabelText.caption = g_ANSR_CNTT
			lineCnt = Container0.LabelText.linecnt
			Container0.LabelText.height = lineCnt * 15
			Container0.LabelText.SetMaxLineCount(600) 	'안드로이드 디폴트 맥스라인 카운트가 100이므로, 늘려준다

			if Trim(gURL_Type1) <> "" or Trim(gURL_Type2) <> "" then
				if Trim(gURL_Type1) == "" then
					Container0.LabelNotice1.height = 0
				end if
				if Trim(gURL_Type2) == "" then
					Container0.LabelNotice2.height = 0
				end if
				Container0.LabelNotice1.top = 25 + CInt(Form.calcUnResize(Container0.LabelText.height, "1")) 'Container0.LabelText.height
				Container0.LabelNotice2.top = 25 + CInt(Form.calcUnResize(Container0.LabelNotice1.height, "1")) + CInt(Form.calcUnResize(Container0.LabelText.height, "1"))'Container0.LabelText.height + Container0.LabelNotice1.height
				Container0.LabelBlank.top = 25 + CInt(Form.calcUnResize(Container0.LabelNotice1.height, "1")) + CInt(Form.calcUnResize(Container0.LabelNotice2.height, "1")) + CInt(Form.calcUnResize(Container0.LabelText.height, "1"))
			end if
			Container0.SetScrollAutoSize()
			
		else
		
			Container0.LabelText.fontsize = 0
			Container0.LabelText.caption = g_ANSR_CNTT
			lineCnt = Cint(Form.getLen(g_ANSR_CNTT)/30)
			Container0.LabelText.sizeTextFit()
			
			'오차줄이기
			if lineCnt >= 10 then
				Container0.LabelText.height = Container0.LabelText.height - lineCnt * 3
			end if
			
			if Trim(gURL_Type1) <> "" or Trim(gURL_Type2) <> "" then
				if Trim(gURL_Type1) == "" then
					Container0.LabelNotice1.height = 0
				end if
				if Trim(gURL_Type2) == "" then
					Container0.LabelNotice2.height = 0
				end if
				Container0.LabelNotice1.top = 25 + Container0.LabelText.height
				Container0.LabelNotice2.top = 25 + Container0.LabelText.height + Container0.LabelNotice1.height
				Container0.LabelBlank.top = 25 + Container0.LabelText.height + Container0.LabelNotice1.height + Container0.LabelNotice2.height
			end if
			Container0.SetScrollAutoSize()
		
		end if
		'20240112 END
		
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubMsg <> null and szSubMsg <> "" then
		Form.ShowAlert( "안내" , szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
	
End Sub

'============================================================================
Sub Container0_LabelNotice1_OnClick()
	'M: 화면번호, U: url
	if gURL_Type1 == "M" then
		Form.OpenScreen(gURL_Link1, "")
	else
		Form.openExternalBrowser(gURL_Link1)
	end if
End Sub

'============================================================================
Sub Container0_LabelNotice2_OnClick()
	'M: 화면번호, U: url
	if gURL_Type2 == "M" then
		Form.OpenScreen(gURL_Link2, "")
	else
		Form.openExternalBrowser(gURL_Link2)
	end if
End Sub


