'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sSTPL_INTRT '약정이자율

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	 Dim szData, arrData
	 
	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"☆")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	'계좌번호 앞8 ^ 계좌번호 뒤2 ^ RP상품유형코드 ^ 종목코드 ^ 신청금액 ^ 매수일자 매수일련번호 만기일자 약정이자율 중도환매이율 만기후적용이율
	
	
	
	Dim szDate
	szDate = Form.GetSharedData("&HOST_DATE", false )

	DATAMANAGER.ClearInputData(0, "obsav_deal_207r")
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "ACNO" , 0 , arrData(0) )	'계좌번호8
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "ASNO" , 0 , arrData(1) )	'계좌번호2
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "RP_PROD_TYPE_CODE" , 0 , arrData(2) )	'종목코드
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "ISCD" , 0 , arrData(3) )	'종목코드
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "STND_DATE" , 0 , szDate )	'기준일자
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "RP_DEAL_CLS_CODE" , 0 , "2" )	'매매구분코드
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock1", "DRNG_FRCR_AMT" , 0 , arrData(4) )	'출금금액
	
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "BYOV_DATE" , 0 , arrData(5) )	'매수일자
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "BYOV_SRNO" , 0 , arrData(6) )	'매수일련번호
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "MTRT_DATE" , 0 , arrData(7) )	'만기일자
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "STPL_INTRT" , 0 , arrData(8) )	'약정이자율
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "HLFW_RPRC_INRT" , 0 , arrData(9) )	'중도환매이율
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "MTRT_AFT_APLY_INRT" , 0 , arrData(10) )	'만기후적용이율
	DATAMANAGER.SetDataValue( 0 , "obsav_deal_207r", "InBlock2", "PRSN_CORP_CLS_CODE" , 0 , "1" )	'개인법인구분코드
	
	DATAMANAGER.RequestTranData( "obsav_deal_207r" )

	'적용이율
	if Cdbl(szDate) == Cdbl(arrData(7)) then '매도일자 = 만기일자 : 만기이율
		g_sSTPL_INTRT = arrData(8)
	elseif Cdbl(szDate) < Cdbl(arrData(7)) then ' 매도일자 < 만기일자 : 중도매도이율
		g_sSTPL_INTRT = arrData(9)
	elseif Cdbl(szDate) > Cdbl(arrData(7)) then ' 매도일자 > 만기일자 : 만기후적용이율
		g_sSTPL_INTRT = arrData(10)
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsav_deal_207r" then
		Dim sData
		sData = DATAMANAGER.GetDataValue( 0, "obsav_deal_207r", "OutBlock1", "EXCL_FRCR_AMT" , 0 )
		
		lblData.caption = sData '정산금액
		tblMaemae.SetCellString( 1, 1, g_sSTPL_INTRT ) '약정이율
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub


