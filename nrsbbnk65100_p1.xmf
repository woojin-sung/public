	<SCRIPT_INFO _len="3331" _ulen="3315" >
'환율조회_통화선택

Dim g_szCRCD
g_szCRCD = ""

Dim g_bFirst
g_bFirst = true

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	if szData <> "" then
		Select Case szData
			Case "USD"		
				RadioGroup0.currentindex = 0
			Case "CNY"				
				RadioGroup0.currentindex = 1
			Case "HKD"				
				RadioGroup0.currentindex = 2
			Case "JPY"		
				RadioGroup0.currentindex = 3
			Case "AUD"		
				RadioGroup0.currentindex = 4
			Case "CAD"
				RadioGroup0.currentindex = 5
			Case "CHF"	
				RadioGroup0.currentindex = 6
			Case "EUR"	
				RadioGroup0.currentindex = 7
			Case "SGD"	
				RadioGroup0.currentindex = 8
		End Select
	end if
	
	g_bFirst = false

End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)

	Select Case nIndex
		Case 0		
			ImgUS_OnClick()
		Case 1				
			ImgCNY_OnClick()
		Case 2				
			ImgHKD_OnClick()
		Case 3		
			ImgJPY_OnClick()
		Case 4		
			ImgAUD_OnClick()
		Case 5	
			ImgCAD_OnClick()
		Case 6		
			ImgCHF_OnClick()
		Case 7	
			ImgEUR_OnClick()
		Case 8	
			ImgSGD_OnClick()
	End Select
	
	if g_bFirst == false then
		btnOK_OnClick()
	end if 
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("CDRD_SET" , g_szCRCD)
	Form.CloseForm()		
End Sub

'============================================================================
Sub ImgUS_OnClick()
	g_szCRCD = "USD"
	RadioGroup0.currentindex = 0
End Sub

'============================================================================
Sub ImgCNY_OnClick()
	g_szCRCD = "CNY"
	RadioGroup0.currentindex = 1
End Sub

'============================================================================
Sub ImgHKD_OnClick()
	g_szCRCD = "HKD"	
	RadioGroup0.currentindex = 2
End Sub

'============================================================================
Sub ImgJPY_OnClick()
	g_szCRCD = "JPY"
	RadioGroup0.currentindex = 3
End Sub

'============================================================================
Sub ImgAUD_OnClick()
	g_szCRCD = "AUD"	
	RadioGroup0.currentindex = 4
End Sub

'============================================================================
Sub ImgCAD_OnClick()
	g_szCRCD = "CAD"	
	RadioGroup0.currentindex = 5
End Sub

'============================================================================
Sub ImgCHF_OnClick()
	g_szCRCD = "CHF"	
	RadioGroup0.currentindex = 6
End Sub

'============================================================================
Sub ImgEUR_OnClick()
	g_szCRCD = "EUR"	
	RadioGroup0.currentindex = 7
End Sub

'============================================================================
Sub ImgSGD_OnClick()
	g_szCRCD = "SGD"	
	RadioGroup0.currentindex = 8
End Sub
