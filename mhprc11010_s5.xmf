'============================================================================
' 화 면 명 : 관심종목_스타일2(업종)
' 화면설명 : 관심종목_스타일2에서 업종 선택시 조회
' 작    성 : 2016.01.05 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd

Dim g_szGwanData
g_szGwanData = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Init_tblInfo
'============================================================================
Function Init_tblInfo()
	tblInfo.SetCellString(0, 0, "")
	tblInfo.SetCellString(1, 0, "")
	
	For i = 3 to tblInfo.rowcount-1
		tblInfo.SetCellString(i, 1, "")
	Next
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 스타일2화면에서 트리거 받음
	if sEventName == "JMCODE" then
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
		DATAMANAGER.CancelRealData("ohhts_up_rsfl")
		
		Init_tblInfo()
	
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")
			tblInfo.SetCellString(0, 0, tData(0))
			tblInfo.SetCellString(1, 0, tData(2))
			
			g_szCd = tData(0)
			
			' 기본 세팅후 조회
			DATAMANAGER.RequestTranData("ohhts_1514_001r")
			DATAMANAGER.RequestTranData("ohhts_5020_001r")
		end if
		
		g_szGwanData = Form.GetSharedData("PRE_GWAN_GRID_POS", true )
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_up_rsfl")	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 업종현재가(시세)
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_1514_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "U")
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock1", "FID_INPUT_ISCD",               0 , g_szCd)
		
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "U")
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock2", "FID_INPUT_COND_SCR_DIV_CODE",  0 , "1514")
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE",      0 , "")
	' ----------------------------------------------------------------------
	' 업종조회(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5020_001r" then		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' ohhts_1514_001r : 업종현재가(시세)
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_1514_001r" then
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
		DATAMANAGER.RequestRealData("ohhts_up_rsfl")
	' ----------------------------------------------------------------------
	' 업종조회(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5020_001r" then		
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	DATAMANAGER.ClearInputData(1, szTranID)
	
	' ----------------------------------------------------------------------
	' 업종지수 체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_nmix_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 업종지수 체결 자동갱신(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_nmix_cntg_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szCd)		
	' ----------------------------------------------------------------------
	' 업종지수 등락 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_up_rsfl" then
		DATAMANAGER.SetDataValue(1, "ohhts_up_rsfl", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szCd)
	end if
End Sub

'============================================================================
' btnHyun_OnClick
'============================================================================
Sub btnHyun_OnClick()
	Form.OpenScreen("42000" , "0★" & g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

'============================================================================
' btnChart_OnClick
'============================================================================
Sub btnChart_OnClick()
	Form.OpenScreen("42030" , g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub


