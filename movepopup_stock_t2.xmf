Dim g_szItemCode,g_szItemMarket,g_szToday

'============================================================================
Sub Form_OnFormInitBefore()

	ChartEx0.SetChartType("simpleline")
	
	ChartEx0.SetPeriodType(1)			'0:틱, 1:분, 2:일자
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'g_szItemCode = "005930"
	'g_szItemMarket = "J"
	
	'Request_002r()
	ChartEx0.setTouchEventType("0")
	
End Sub

'=============================================================================
Sub Request_002r() '주식차트 조회

	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )

	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"0")	
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)		
	
	'sMin = Split("1", "분", -1, 1)
	
	'sTemp = sMin[0] * 60
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, 60)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"N")
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN", 0,"N")
		
	DATAMANAGER.RequestTranData("ohhts_5010_002r")	

End Sub
'============================================================================
Sub Request_003r() '선옵 차트 조회

	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )

	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, 60)  'n분
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")  '
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" , 0,"N")
	
	DATAMANAGER.RequestTranData("ohhts_5030_003r")	
	

	

End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	
	if sEventName == "INIT_CODE" then
		g_szItemCode = sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		if g_szItemMarket == "O" or g_szItemMarket == "F" or g_szItemMarket =="MF" then
		
			ChartEx0.SetDecimal(2)
			Request_003r()
		else	
			
			ChartEx0.SetDataClear("1")
			ChartEx0.SetDecimal(0)
			Request_002r()
			
		end if
	end if
		
		
End Sub

