<ROOT>
	<MAP_INFO scrno="90060" scrname="인증서_관리비밀번호변경풀팝업" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<LINKFORM name="LinkForm0" ly_vert="0,0,375,562,1" />
		<BUTTON name="ButtonOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,562,188,45,1" />
		<BUTTON name="ButtonCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,562,187,45,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2323" _ulen="2229" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_관리비밀번호변경풀팝업
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_CHANGEPW_CERT_FILE '비밀번호변경화면
Dim g_sRetData 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("비밀번호 변경")
	
	G_CHANGEPW_CERT_FILE = "mhetc90060_s4"
	g_sRetData = "cancel"
	
	LinkForm0.linkfile = G_CHANGEPW_CERT_FILE
	Form.triggerEvent( "LinkForm0", "TabChange", "" )	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "NextStep" then
		Dim sNum
		sNum = Form.GetSharedData("CERT_OLDNEW" , false)	
		g_sRetData = "ok;"..sNum
		'20161101 NOHES START ">"빠짐 대응
		Form.SetSharedData("CERT_IMSI_PSWD" , sNum )
		'20161101 NOHES END
		
		Form.CloseForm( )
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Form.triggerEvent( "LinkForm0", "NextCheck", "" )	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("CERT_OLDNEW" , "")	
	Form.SendReturnToParent( "mhetc90060_p6" , g_sRetData )
End Sub






	</SCRIPT_INFO>
</ROOT>