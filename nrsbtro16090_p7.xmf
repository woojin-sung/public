				<CELL cell_ly="0,0,0,0" line="0,0" caption="실시간 시세 신청 가능한 계좌가 없습니다." impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="해외주식거래 신청 후 이용해 주세요.   " impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<BUTTON name="btnQuit" caption="취소" fgcolor="004:000000000" fontsize="1" btnimage="btn_25.9" ly_vert="20,418,160,53,1" />
		<BUTTON name="btnOk" caption="해외주식거래 신청" fontsize="1" btnimage="btn_26.9" ly_vert="175,418,181,53,1" />
		<BUTTON name="btnOk1" caption="확인" fontsize="1" btnimage="btn_22.9" ly_vert="393,443,335,53,1" />
		<TABLE name="tblInfo1" insidelinecolor="102:255255255" colcount="1" rowcount="7" outline="0000" designorder="1" ly_vert="406,282,310,135,1" >
			<COL_INFO ly_vert_width="310" />
			<ROW_INFO ly_vert_height="20,20,20,15,20,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="해외CFD 거래를 위해서 해외시장의 실시간" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="시세신청이 필요하며, 해외CFD를 거래하시는" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="고객님에게는 무료로 제공하고 있습니다." impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" caption="단, 매월 매매내역이 없고 월말잔고 미보유 시" impidxs="" />
				<CELL cell_ly="0,5,0,5" line="0,0" caption="익월 실시간 시세 신청이 해지되며, 무료 제공" impidxs="" />
				<CELL cell_ly="0,6,0,6" line="0,0" caption="은 회사 정책에 따라 변경될 수 있습니다." impidxs="" />
			</CELL_INFO>
		</TABLE>
