		<IMAGE name="imgBg2" imgpath="popup_bg_common.9" ly_vert="751,211,335,270,1" />
		<TABLE name="tblInfo2" insidelinecolor="102:255255255" colcount="1" rowcount="7" outline="0000" designorder="1" ly_vert="764,273,310,140,1" >
			<COL_INFO ly_vert_width="310" />
			<ROW_INFO ly_vert_height="22,22,22,8,22,22,22" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="미국주식 1주 이상 거래하면 익월부터 " impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="무료 시세 혜택을 받을 수 있어요. " impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="(직전 6개월내 거래가 있는 경우 혜택 적용) " impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" caption="‘자동 연장’으로 신청하는 경우 " impidxs="" />
				<CELL cell_ly="0,5,0,5" line="0,0" caption="실시간 시세 무료 지원 자동 적용됩니다. " impidxs="" />
				<CELL cell_ly="0,6,0,6" line="0,0" caption="자동 연장으로 신청 하시겠어요? " impidxs="" />
			</CELL_INFO>
		</TABLE>
		<BUTTON name="btnQuit2" caption="취소" fgcolor="004:000000000" fontsize="1" btnimage="btn_25.9" ly_vert="752,431,175,53,1" />
		<LABEL name="lblTitle2" fontsize="2" fontstyle="01" caption="알림" halign="1" ly_vert="764,229,310,32,1" />
		<BUTTON name="btnOk2" caption="확인" fontsize="1" btnimage="btn_26.9" ly_vert="919,431,167,53,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="7142" _ulen="6186" >
'실시간시세신청 확인창

Dim g_szOKType
g_szOKType = "2"

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
'szData = "12"	 'for TEST

	if szData == "3" then
		tblInfo.SetCellString(0, 0, "실시간 시세 신청을")
		tblInfo.SetCellString(1, 0, "해지하시겠어요?")
		btnOk.caption = "확인"	
		
		'tblInfo.top = 350 '두줄
	elseif szData == "1" then
		tblInfo.SetCellString(1, 0, "Super365 또는 종합매매 계좌개설 후")
		tblInfo.SetCellString(2, 0, "이용해주세요.")
		btnOk.caption = "비대면 계좌개설"
		
		imgBg.height = 208
		btnQuit.top = 436
		btnOk.top = 436
	elseif szData == "4" then '고객정보변경
		tblInfo.SetCellString(0, 0, "고객 정보를 변경하시겠어요?")
		tblInfo.SetCellString(1, 0, "")
		btnOk.caption = "확인"	
		
		tblInfo.top = 360 '한줄
	elseif szData == "5" then '고객정보 변경후 확인
		tblInfo.SetCellString(0, 0, "고객 정보가 변경되었습니다.")
		tblInfo.SetCellString(1, 0, "")
		btnOk.caption = "확인"	
		btnOk.left = 20
		btnOk.width = 335
		btnOk.btnimage = "btn_22.9.png"
		
		btnQuit.left = 500
		btnQuit.enable = false
		
		tblInfo.top = 360 '한줄
	elseif szData == "6" then
		Dim szMartNm		
		szMartNm = Form.GetSharedData("16090_MRKT_NM", true)
		tblInfo.SetCellString(1, 0, "해외CFD("& szMartNm &") 계좌개설 후 이용해 주세요.")
		btnOk.caption = "비대면 계좌개설"
		
		'tblInfo.top = 350 '두줄
	elseif szData == "7" then
		tblInfo.SetCellString(1, 0, "해외CFD 주식거래 신청 후 이용해 주세요.")
		btnOk.caption = "해외주식거래 신청"	
		
		'tblInfo.top = 350 '두줄
	elseif szData == "8" then '해외CFD 신청내역이 없는 고객 팝업
		imgBg.left = 500
		lblTitle.left = 500
		tblInfo.left = 500
		btnOk.left = 500		
		btnQuit.left = 500
		
		imgBg1.left = 20 
		lblTitle1.left = 33
		tblInfo1.left = 33
		btnOk1.left = 20		
	elseif szData == "9" then '미국& 당월 또는 기간선택을 선택하는 경우 자동연장여부를 묻는 팝업
		imgBg.left = 500
		lblTitle.left = 500
		tblInfo.left = 500
		btnOk.left = 500		
		btnQuit.left = 500
		
		imgBg2.left = 20 
		lblTitle2.left = 33
		tblInfo2.left = 33
		btnOk2.left = 190		
		btnQuit2.left = 20	
	elseif szData == "10" then 'CFD 실시간 시세신청한 고객이 해외주식 실시간 시세 신청 화면에서 해지하는 경우
		tblInfo.SetCellString(0, 0, "실시간 시세 신청이 해지되었습니다.")
		tblInfo.SetCellString(1, 0, "신청 내역은 실시간시세신청(CFD용)에서")
		tblInfo.SetCellString(2, 0, "확인이 가능합니다.")
		tblInfo.top = 342
		btnOk.caption = "확인"	
		btnOk.left = 20
		btnOk.width = 335
		btnOk.btnimage = "btn_22.9.png"
		
		btnQuit.left = 500
		btnQuit.enable = false
		
		imgBg.height = 208
		btnQuit.top = 436
		btnOk.top = 436		
		
	elseif szData == "11" then '해외주식 실시간 시세 신청한 고객이 해외CFD 실시간 시세 신청 화면에서 해지하는 경우 
		tblInfo.SetCellString(0, 0, "실시간 시세 신청이 해지되었습니다.")
		tblInfo.SetCellString(1, 0, "신청 내역은 해외주식 실시간시세신청에서")
		tblInfo.SetCellString(2, 0, "확인이 가능합니다.")
		tblInfo.top = 342
		btnOk.caption = "확인"	
		btnOk.left = 20
		btnOk.width = 335
		btnOk.btnimage = "btn_22.9.png"
		
		btnQuit.left = 500
		btnQuit.enable = false
		
		imgBg.height = 208
		btnQuit.top = 436
		btnOk.top = 436		
	elseif szData == "12" then  'CFD계좌 보유 고객이 해외주식 실시간 시세 신청에서 신청하는 경우 
		tblInfo.SetCellString(0, 0, "해외CFD 거래 고객은 미국 실시간 시세를")
		tblInfo.SetCellString(1, 0, "무료로 제공하고 있습니다.")
		tblInfo.SetCellString(2, 0, "해외CFD 메뉴에서 신청해주세요.")
		btnOk.caption = "CFD 실시간 시세 신청"
		
		imgBg.height = 208
		btnQuit.top = 436
		btnOk.top = 436		
		
	elseif szData == "2" then
		tblInfo.SetCellString(1, 0, "해외주식거래 신청 후 이용해 주세요.")
		btnOk.caption = "해외주식거래 신청"	
	end if 

	g_szOKType = szData	
End Sub

'해외주식거래 신청/비대면 계좌개설
'============================================================================
Sub btnOk_OnClick()
	if g_szOKType == "12" then 
		Form.SendReturnToParent("INFO_POPUP12" , "OK")
	elseif g_szOKType == "11" then 
		Form.SendReturnToParent("INFO_POPUP11" , "OK")
	elseif g_szOKType == "10" then 
		Form.SendReturnToParent("INFO_POPUP10" , "OK")
	elseif g_szOKType == "9" then 
		Form.SendReturnToParent("INFO_POPUP9" , "OK")
	elseif g_szOKType == "8" then 
		Form.SendReturnToParent("INFO_POPUP8" , "OK")
	elseif g_szOKType == "7" then 
		Form.SendReturnToParent("INFO_POPUP7" , "OK")
	elseif g_szOKType == "6" then 
		Form.SendReturnToParent("INFO_POPUP6" , "OK")
	elseif g_szOKType == "5" then  '고객정보 변경후 확인
		Form.SendReturnToParent("INFO_POPUP5" , "OK")
	elseif g_szOKType == "4" then '고객정보변경
		Form.SendReturnToParent("INFO_POPUP4" , "OK")
	elseif g_szOKType == "3" then
		Form.SendReturnToParent("INFO_POPUP3" , "OK")
	elseif g_szOKType == "2" then
		Form.SendReturnToParent("INFO_POPUP2" , "OK")
	elseif g_szOKType == "1" then
		Form.SendReturnToParent("INFO_POPUP1" , "OK")
	end if 
	Form.CloseForm()
End Sub

'취소
'============================================================================
Sub btnQuit_OnClick()
	if g_szOKType == "12" then 
		Form.SendReturnToParent("INFO_POPUP12" , "CANCEL")
	elseif g_szOKType == "11" then 
		Form.SendReturnToParent("INFO_POPUP11" , "CANCEL")
	elseif g_szOKType == "10" then 
		Form.SendReturnToParent("INFO_POPUP10" , "CANCEL")
	elseif g_szOKType == "9" then 
		Form.SendReturnToParent("INFO_POPUP9" , "CANCEL")
	elseif g_szOKType == "8" then 
		Form.SendReturnToParent("INFO_POPUP8" , "CANCEL")
	elseif g_szOKType == "7" then 
		Form.SendReturnToParent("INFO_POPUP7" , "CANCEL")
	elseif g_szOKType == "6" then 
		Form.SendReturnToParent("INFO_POPUP6" , "CANCEL")
	elseif g_szOKType == "5" then  '고객정보 변경후 확인
		Form.SendReturnToParent("INFO_POPUP5" , "CANCEL")
	elseif g_szOKType == "4" then '고객정보변경
		Form.SendReturnToParent("INFO_POPUP4" , "CANCEL")
	elseif g_szOKType == "3" then
		Form.SendReturnToParent("INFO_POPUP3" , "CANCEL")
	elseif g_szOKType == "2" then
		Form.SendReturnToParent("INFO_POPUP2" , "CANCEL")
	elseif g_szOKType == "1" then
		Form.SendReturnToParent("INFO_POPUP1" , "CANCEL")
	end if 	
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOk1_OnClick()
	btnOk_OnClick()	
End Sub

'============================================================================
Sub btnOk2_OnClick()
	btnOk_OnClick()	
End Sub

'============================================================================
Sub btnQuit2_OnClick()
	btnQuit_OnClick()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	btnQuit_OnClick()
End Sub
	</SCRIPT_INFO>
</ROOT>