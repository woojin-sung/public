'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG" then
		if sRet == "ok" then
			szAcct = acnt.caption
			Form.OpenScreen("87051" , szAcct)
		end if
	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
		
	'20200827 LES START 애플/테슬라 액면분할 관련 고객유의사항
	if sKeyName == "16060_p9" then
		if sRet == "cancel" then
			szPrevScr = Form.GetSharedData("&PREV_SCREEN_NO", false )
			
			if szPrevScr == "" or szPrevScr == nil or szPrevScr == "16060" then
				szPrevScr = "41000"
			end if
			
			Form.OpenScreen(szPrevScr , "")
		end if
	'20200827 LES END
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			'-----------------------------------------
			'비밀번호 검증 후, 주문확인창 자동 오픈
			'-----------------------------------------
			if g_OpenConfirmNextCheckPwd then
				g_OpenConfirmNextCheckPwd = false
				Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "OPEN_CONFIRM", "")
			end if
			
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			'-----------------------------------------
			'비밀번호 검증 후, 주문확인창 자동 오픈변수 초기화
			'-----------------------------------------
			if g_OpenConfirmNextCheckPwd then
				g_OpenConfirmNextCheckPwd = false
			end if
			
		end if 
	'20220425 HWG END
	
	'--------------------------------
	'20240617 LES START - 해외/국내 종목선택창 통합
	'--------------------------------
	elseif sKeyName == "DLG_SELECT" then
		
		'--------------------------------
		'sRet = OQ@AAPL★애플★OVRS
		'--------------------------------		
		Dim arrRetData, sItemCd, sItemName
		arrRetData = Split(sRet,"★")
		
		if #arrRetData > 2 then
			sItemCd = arrRetData(0)
			
			if CheckMasterFile(sItemCd) then '20240621 
				sItemName = Form.GetItemCodeInfo(sItemCd, "name")
				Form.setOverStockItemCode(sItemCd.."★"..sItemName)
				ItemCode0_OnEditComplete(sItemCd)
			end if
			
		End if
		
	'--------------------------------
	'20240617 LES END
	'--------------------------------
	
	'관심등록 완료 후
	elseif sKeyName = "mhprc11000_save" then
		RequestTranData_Intr()			' 관심그룹 갯수 조회	(관심그룹추가 팝업리턴도 같은 keyname으로 내려옴)
		Form.requestIntrItemList("00")	' 관심종목 목록 조회
	end if
End Sub

