'============================================================================
'20220510 LES START : 마스터파일에 있는 종목인지 체크
'============================================================================
Function Transform_Exid(szExid)

	if szExid = "HKS" then
		Transform_Exid = "HK"
		exit Function
	elseif szExid = "SHS" then
		Transform_Exid = "SH"
		exit Function
	elseif szExid = "SZS" then
		Transform_Exid = "SZ"
		exit Function
	elseif szExid = "NYS" then
		Transform_Exid = "NY"
		exit Function
	elseif szExid = "AMX" then
		Transform_Exid = "AX"
		exit Function
	elseif szExid = "NAS" then
		Transform_Exid = "OQ"
		exit Function
	elseif szExid = "TSE" then
		Transform_Exid = "JP"
		exit Function
	else
		Transform_Exid = szExid
	end if

End Function

'============================================================================
' 마스터파일에 있는 종목인지 체크
'============================================================================
Function CheckMasterFile(szCode)
	
	arrCode = Split(szCode,"@")
	szTransExidCode = Transform_Exid(arrCode(0))
	
	szTransItemCode = szTransExidCode .. "@" .. arrCode(1)

	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	
	if szCheckData = "" or szCheckData = null then
		CheckMasterFile = false
		Exit Function
	end if
	
	CheckMasterFile = true
	
End Function

'============================================================================
' 주문관련 환경설정값(원주문/계좌비밀번호) 적용
' 가격/수량 자동입력 관련 설정값은 각 주문탭에서 각자 적용
'============================================================================
Function Load_OrderSet()
	
	'--------------------------------------------------------------
	' 원주문번호 자동입력
	'--------------------------------------------------------------
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")
	
	'원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'--------------------------------------------------------------
	' 계좌비밀번호 저장여부
	'--------------------------------------------------------------
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")				

	'계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	

	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	
End Function

'============================================================================
Function Tonum(sValue)
	return tonumber( sValue ) or 0
end Function

'============================================================================
Function Request_Hoga(sCode)
	
	g_sCode = sCode
	contHoga.scroll_pos = "vcenter"
	
	DATAMANAGER.CancelRealData( "ohhts_exst_aspr" ) '정규장 실시간 호가
	DATAMANAGER.CancelRealData( "ohhts_exst_cntg" ) '정규장 실시간 체결
	DATAMANAGER.CancelRealData( "ohhts_exst_cnta" ) '애프터마켓 실시간 체결
	DATAMANAGER.CancelRealData( "ohhts_exst_cntd" ) '주간거래 실시간 체결
	
	contHoga.hogaTbl.SetCellClear()

	DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
	DATAMANAGER.RequestTranData( "ohhts_6000_002r" )
	DATAMANAGER.RequestTranData( "ohhts_6000_003r" )
	
	'----------------------------------------------------------
	' 주간장/애프터장이면 주간장/애프터 현재가 조회 서비스 호출
	' 가격자동입력이 현재가로 되어있는 경우, 주간장/애프터 현재가 세팅을 위해
	'----------------------------------------------------------
	sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
	sAfterYN = Form.GetSharedData("OVRS_AFTER_MARKET_ORDER", false )
	
	if sDayYN == "Y"  then
		
		if g_sCode <> "" then
			arrCode = Split(g_sCode,"@")
			
			if #arrCode > 1 then
				
				szMarket = arrCode(0)
				if szMarket == "OQ" or szMarket == "NY" or szMarket == "AX" then
					DATAMANAGER.RequestTranData( "ohhts_6000_017r" )
				end if
				
			end if
			
		end if
		
	elseif sAfterYN == "Y" then
	
		if g_sCode <> "" then
			arrCode = Split(g_sCode,"@")
			
			if #arrCode > 1 then
				
				szMarket = arrCode(0)
				if szMarket == "OQ" or szMarket == "NY" or szMarket == "AX" then
					DATAMANAGER.RequestTranData( "ohhts_6000_020r" )
				end if
				
			end if
			
		end if
		
	end if
	
End Function


'============================================================================
' 시가, 고가, 저가 색상세팅
'============================================================================
Function	Table_Color_Setting()
	
	Dim sOpen
	Dim sHigh
	Dim sLow
	Dim sLast

	sOpen = 0	' 시가
	sHigh = 0	' 고가
	sLow  = 0	' 저가
	sLast = 0	' 전일종가
	
	sOpen = CDbl( contCntg.tblPrice.GetCellString( 0, 1 ) )	' 시가
	sHigh = CDbl( contCntg.tblPrice.GetCellString( 1, 1 ) )	' 고가
	sLow  = CDbl( contCntg.tblPrice.GetCellString( 2, 1 ) )	' 저가
	sLast  = CDbl( contCntg.tblPrice.GetCellString( 3, 1 ) )	' 전일종가
	
	Dim sColor
	sColor = "4"
		
	if sOpen > sLast then
		sColor = "1"
	elseif sOpen < sLast then
		sColor = "2"
	elseif sOpen == sLast then
		sColor = "3"
	end if
	
	contCntg.tblPrice.SetCellFgColor( 0, 1, sColor )
	
	if sHigh > sLast then
		sColor = "1"
	elseif sHigh < sLast then
		sColor = "2"
	elseif sHigh == sLast then
		sColor = "3"
	end if
	
	contCntg.tblPrice.SetCellFgColor( 1, 1, sColor )

	
	if sLow > sLast then
		sColor = "1"
	elseif sLow < sLast then
		sColor = "2"
	elseif sLow == sLast then
		sColor = "3"
	end if
	
	contCntg.tblPrice.SetCellFgColor( 2, 1, sColor )
	
	contCntg.tblPrice.SetCellFgColor( 3, 1, "4" )
	
end Function

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub rdoHoga_OnClick(nIndex)

	if nIndex == 0 then
		
		sHigh = tblHigh.GetCellString(0, 1)
		sLow  = tblLow.GetCellString(0, 1)
		
		if CDbl(sHigh) > 0 and CDbl(sLow) > 0 then
			ChangeContHoga("1")
		else
			ChangeContHoga("2")
		end if
		
		contCntg.visible = false
		
	else
		
		tblHigh.visible = false
		tblLow.visible = false
		
		contHoga.visible = false
		contCntg.visible = true
		
	end if
	
End Sub

'============================================================================
' 상/하한가 데이터 존재 여부에 따라 호가테이블 사이즈/위치 조정
'============================================================================
Function ChangeContHoga(sType)
	
	'sType :1 => 상/하한가 데이터 있음
	if sType == "1" then
		
		rdoHoga.visible = true
		tblHigh.visible = true
		tblLow.visible = true
		lblLine0.visible = true
		
		contHoga.top = 240
		contHoga.height = 294
		contHoga.visible = true
		
	'sType :2 => 상/하한가 데이터 없음
	elseif sType == "2" then
		
		rdoHoga.visible = true
		tblHigh.visible = false
		tblLow.visible = false
		lblLine0.visible = true
		
		contHoga.top = 218
		contHoga.height = 344
		contHoga.visible = true
	
	'sType :3 => 정정/취소(선택종목 없을때)
	elseif sType == "3" then
		
		rdoHoga.visible = false
		tblHigh.visible = false
		tblLow.visible = false
		lblLine0.visible = false
		
		contHoga.top = 355
		contHoga.height = 206
		
		contHoga.visible = false
	
	'sType :4 => 정정/취소(선택종목 있을때)
	elseif sType == "4" then
		
		rdoHoga.visible = false
		tblHigh.visible = false
		tblLow.visible = false
		lblLine0.visible = false
		
		contHoga.top = 355
		contHoga.height = 206
		contHoga.visible = true
		
	end if
	
	'(공통) 호가테이블 중앙이동
	contHoga.scroll_pos = "vcenter"

End Function

'============================================================================
' (공통)호가클릭 연동
'============================================================================
Function Click_Hoga(sPrice)
	if Trim(sPrice) <> "" and CDbl(sPrice) <> 0 then
		Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "CLICK_HOGA", sPrice)
	end if
End Function

'============================================================================
' (호가테이블) 호가 클릭 연동
'============================================================================
Sub contHoga_hogaTbl_OnClick(lRow, lCol)
	
	'--------------------------------------------------
	'호가영역 클릭시에만 연동. 잔량영역 클릭 시 무시
	'--------------------------------------------------
	if lCol == 0 or lCol == "0" then
		
		if lRow % 2 == 0 then
			Dim sPrice
			sPrice = contHoga.hogaTbl.GetCellString(lRow, 0)
			
			if sPrice <> null and sPrice <> ""	then
				Click_Hoga(sPrice)
			end if
		end if
		
	end if
	
End Sub

'============================================================================
' (공통) 종목정보 공유(틱타입/소수점 자리수/매매단위 등...)
'============================================================================
Function SendItemInfo(sCurPrice,sUpLimit,sDnLimit,sOrdSize,sCurrency,sDecimalLen,sKorName,sTickType,sOrdsizeMaedo)
	
	'sInfo = sCurPrice .. "★" .. sUpLimit .. "★" .. sDnLimit .. "★" .. sOrdsize .. "★" .. sCurrency .. "★" .. sDecimalLen .. "★" .. sKorName .. "★" .. sTickType
	g_sItemInfo = sCurPrice .. "★" .. sUpLimit .. "★" .. sDnLimit .. "★" .. sOrdsize .. "★" .. sCurrency .. "★" .. sDecimalLen .. "★" .. sKorName .. "★" .. sTickType .. "★" .. sOrdsizeMaedo
	
	if g_sItemInfo <> null and g_sItemInfo <> "" then
		Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "SEND_ITEM_INFO", g_sItemInfo)
	end if

End Function

'============================================================================
' (매수/매도/정정) 가격 자동연동
'============================================================================
Function Return_AutoPrice(sGubun)

	if sGubun == "BUY" then
		szAuto = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")		' 주식매도주문가격 자동입력
	elseif sGubun == "SELL" then
		szAuto  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")		' 주식매도주문가격 자동입력
	elseif sGubun == "MOD" then
		szAuto  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC")		' 주식정정주문가격 자동입력
	end if
	
	'안드로이드에서 szAuto값에 뭐가 따로 들어가는듯.. trim안해주면 else문으로 빠짐
	szAuto = Trim(szAuto)
	
	if szAuto == "1" then 
		szPrc = contHoga.hogaTbl.GetCellString(0, 0) ' 매도10호가
	elseif szAuto == "2" then
		szPrc = contHoga.hogaTbl.GetCellString(2, 0) ' 매도9호가
	elseif szAuto == "3" then
		szPrc = contHoga.hogaTbl.GetCellString(4, 0) ' 매도8호가
	elseif szAuto == "4" then
		szPrc = contHoga.hogaTbl.GetCellString(6, 0) ' 매도7호가
	elseif szAuto == "5" then
		szPrc = contHoga.hogaTbl.GetCellString(8, 0) ' 매도6호가
	elseif szAuto == "6" then
		szPrc = contHoga.hogaTbl.GetCellString(10, 0) ' 매도5호가
	elseif szAuto == "7" then
		szPrc = contHoga.hogaTbl.GetCellString(12, 0) ' 매도4호가
	elseif szAuto == "8" then
		szPrc = contHoga.hogaTbl.GetCellString(14, 0) ' 매도3호가
	elseif szAuto == "9" then
		szPrc = contHoga.hogaTbl.GetCellString(16, 0) ' 매도2호가
	elseif szAuto == "10" then 
		szPrc = contHoga.hogaTbl.GetCellString(18, 0) ' 매도1호가
	elseif szAuto == "11" then 					   
		szPrc = lblHyun.caption				    ' 현재가
	elseif szAuto == "12" then
		szPrc = contHoga.hogaTbl.GetCellString(20, 0)	' 매수1호가
	elseif szAuto == "13" then
		szPrc = contHoga.hogaTbl.GetCellString(22, 0)  ' 매수2호가
	elseif szAuto == "14" then
		szPrc = contHoga.hogaTbl.GetCellString(24, 0) ' 매수3호가
	elseif szAuto == "15" then
		szPrc = contHoga.hogaTbl.GetCellString(26, 0) ' 매수4호가
	elseif szAuto == "16" then
		szPrc = contHoga.hogaTbl.GetCellString(28, 0) ' 매수5호가
	elseif szAuto == "17" then
		szPrc = contHoga.hogaTbl.GetCellString(30, 0) ' 매수6호가
	elseif szAuto == "18" then
		szPrc = contHoga.hogaTbl.GetCellString(32, 0) ' 매수7호가
	elseif szAuto == "19" then
		szPrc = contHoga.hogaTbl.GetCellString(34, 0) ' 매수8호가
	elseif szAuto == "20" then
		szPrc = contHoga.hogaTbl.GetCellString(36, 0) ' 매수9호가
	elseif szAuto == "21" then
		szPrc = contHoga.hogaTbl.GetCellString(38, 0) ' 매수10호가
	elseif szAuto == "22" then
		szPrc = lblHigh.caption					' 상한가
	elseif szAuto == "23" then 
		szPrc = lblLow.caption						' 하한가
	else
		szPrc = ""  								' 미적용 및 기타에러
	end if
	
	return szPrc
	
End Function

'============================================================================
' 주문환경설정 화면 > 백버튼으로 다시 돌아온 경우 직전 탭으로 세팅
'============================================================================
Sub Form_OnTriggerEventSCREEN(sEventName,sParam)
	
	if sEventName = "PREV" then
	
		nPrevScrNo = Form.GetSharedData("&PREV_SCREEN_NO", false)
		
		'90000 : 환경설정 / 16000 : 해외주식 현재가
		if nPrevScrNo == "90000" or nPrevScrNo == "16000" then
			
			nSetTabIndex = Form.GetSharedData("16061_CURTAB_IDNEX", true)
			
			if nSetTabIndex <> "" then
				
				FormTab0.currenttab = Cint(nSetTabIndex)
				call FormTab0_OnTabChanged(nSetTabIndex)
				
				'---------------------------------------------------------------------
				' 안드로이드에서 주문환경설정에서 백버튼으로 돌아온 경우
				' 탭변경 시, changeCode호출이 안되서 수동으로 호출해준다.
				' 호출해주지 않으면 매도탭에서 현재보고있는 종목코드가 빈값으로 나옴.
				'---------------------------------------------------------------------
				if gOsType == "1" then
					Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeCode", g_sCode)
				end if
			
			end if
			
		end if
		
	else
		
		Form.SetSharedData("16061_CURTAB_IDNEX", "")
	
	end if

End Sub

