'============================================================================
' 하한가 가격연동
'============================================================================
Sub tblLow_OnClick(lRow , lColumn)

	Dim sPrice
	sPrice = tblLow.GetCellString(0, 1)
	
	if sPrice <> null and sPrice <> ""	then
		Click_Hoga(sPrice)
	end if
	
End Sub

'============================================================================
' 체결 > 시/고/저/전일종가 테이블 가격연동
'============================================================================
Sub contCntg_tblPrice_OnClick(lRow , lColumn)

	Dim sPrice
	sPrice = contCntg.tblPrice.GetCellString(lRow, 1)
	
	if sPrice <> null and sPrice <> ""	then
		Click_Hoga(sPrice)
	end if
	
End Sub

'============================================================================
' 체결 > 체결가 그리드 가격연동
'============================================================================
Sub contCntg_grdCNTG_OnClickUp(lRow, szCellID)
	
	Dim sPrice
	sPrice = contCntg.grdCNTG.GetCellData("bd_cell0", lRow)
	
	if sPrice <> null and sPrice <> ""	then
		Click_Hoga(sPrice)
	end if
	
End Sub


'============================================================================
Function RequestTranData_Intr()
	DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
	DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

'============================================================================
Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function


