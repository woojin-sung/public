'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obpds_srvc_323r" then
		szYakCd = DATAMANAGER.GetDataMsgCode(szTranID)
		
		if szYakCd <> "5766" then
			
			nCurrentTab = FormTab0.currenttab
		
			'-------------------------------------------------------------------------
			' 현재 탭이 정정/취소, 주문/체결, 잔고 탭인 경우 조회데이터 클리어
			'-------------------------------------------------------------------------
			if nCurrentTab == 2 or nCurrentTab == "2" or nCurrentTab == 3 or nCurrentTab == "3" or nCurrentTab == 4 or nCurrentTab == "4" then
				Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ClearData", "" )
			
			'-------------------------------------------------------------------------
			' 20240617 LES START 현재탭이 매수/매도 인 경우 가능수량 조회 서비스를 날리기 위해 그냥 ChangeAcnt 날림.
			' 매도탭에서 계좌가 변경되었으면 매수 탭에도 알려줌. 자세한 이유는 아래 적혀있음.
			'-------------------------------------------------------------------------
			else
				
				Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
				
				if nCurrentTab <> 0 and nCurrentTab <> "0" then
					Form.TriggerEvent( "FormTab0.page0", "ChangeAcnt", "" )
				end if
			
			end if
				
			'20240807 매수탭에서만 약정신청 팝업 발생하도록 요건 변경(노민아 과장 요청)
			if nCurrentTab == 0 or nCurrentTab == "0" then
				Form.MsgBox("안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 7, "거래신청하기" , "취소")
			end if
			
		else
			nCurrentTab = FormTab0.currenttab
		
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
			
			'-------------------------------------------------------------------------
			' 매수탭의 경우 현재 계좌의 통합증거금 약정 여부에 따라 주문가능수량을
			' 보여주는 UI가 달라지기 때문에, 계좌변경했을 때 매수탭에 위치해있지 않은 경우
			' 매수탭에도 트리거를 날려 계좌가 변경되었음을 알려줘, 바뀐 계좌의 통합증거금 여부를
			' 다시 조회하도록 한다.
			'-------------------------------------------------------------------------
			if nCurrentTab <> 0 and nCurrentTab <> "0" then
				Form.TriggerEvent( "FormTab0.page0", "ChangeAcnt", "" )
			end if
			
			'-------------------------------------------------------------------------
			' 액면분할/권리선반영 시 사용하는 로직 
			'-------------------------------------------------------------------------
			'szToday = Form.GetSharedData("&HOST_DATE", false )
			'
			'if tonumber(szToday) >= 20240311 and tonumber(szToday) <= 20240318 then
			'	DATAMANAGER.RequestTranData("obtro_acnt_900r")
			'end if
			'-------------------------------------------------------------------------
			
		end if
		
	
	elseif szTranID == "ohhts_6000_001r" then
		
		'----------------------------------------------------
		'[체결] 테이블/그리드 세팅
		'----------------------------------------------------
		nCLPrice = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_PRDY_CLPR" 	, 0))
		nPoint 	= _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_DCPN_CNT" 	, 0))
		
		contCntg.tblPrice.SetCellString(3, 1, Replace( FormatNumber(nCLPrice, nPoint) , "," , "" ) )
		
		Table_Color_Setting()
		
		'-------------------------------------------------------------------------------------------
		' [호가] 상/하한가 데이터 존재 여부에 따라 호가테이블 위치/높이 조정
		' 단, 현재 탭이 매수/매도 일 경우에만 동작. 정정/취소 & 주문/체결 & 잔고일때는 스킵
		'-------------------------------------------------------------------------------------------
		nMaxPrc = CDbl(DATAMANAGER.GetDataValue(0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" , 0))
		nMinPrc = CDbl(DATAMANAGER.GetDataValue(0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" , 0))
		
		nCurrentTab = FormTab0.currenttab
		
		if nCurrentTab == 0 or nCurrentTab == "0" or nCurrentTab == 1 or nCurrentTab == "1" then
			if nMaxPrc > 0 and nMinPrc > 0 then
				ChangeContHoga("1")
			else
				ChangeContHoga("2")
			end if
		end if
		
		'-------------------------------------------------------------------------
		' [종목정보] 선택종목 정보 탭별로 전달(호가단위는 각 주문화면에서 세팅됨)
		'-------------------------------------------------------------------------
		sCurPrice	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 					, 0 )		' 현재가
		sOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" 		, 0 )		' 매매단위(매수)
		sOrdSizeMaedo	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SELN_ODER_QTY_UNIT" 		, 0)			' 매매단위(매도)
		sCurrency	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 				, 0 )		' 통화
		sKorName		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" 				, 0 )		' 한글종목명
		sTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_TICK_CLS" 				, 0 )		' 종목 틱타입
		
		sUpLimit		=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" 		, 0 )))	' 상한가
		sDnLimit		=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" 		, 0 )))	' 하한가
		sDecimalLen 	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
		
		SendItemInfo(sCurPrice,sUpLimit,sDnLimit,sOrdSize,sCurrency,sDecimalLen,sKorName,sTickType,sOrdSizeMaedo)
	
	elseif szTranID == "ohhts_6000_002r" then
		
		'----------------------------------------------
		'호가창 중앙위치
		'----------------------------------------------
		contHoga.scroll_pos = "vcenter"
		
		'----------------------------------------------
		'호가창 시고저 표시
		'----------------------------------------------
		sOprc = DATAMANAGER.GetDataValue(0, "ohhts_6000_002r", "OutBlock1", "FIDX_OPRC" , 0)
		sHprc = DATAMANAGER.GetDataValue(0, "ohhts_6000_002r", "OutBlock1", "FIDX_HPRC" , 0)
		sLprc = DATAMANAGER.GetDataValue(0, "ohhts_6000_002r", "OutBlock1", "FIDX_LPRC" , 0)
		
		contHoga.hogaTbl.startprice = sOprc
		contHoga.hogaTbl.highprice = sHprc
		contHoga.hogaTbl.lowprice = sLprc
		
		'----------------------------------------------
		' 실시간 서비스 호출
		'----------------------------------------------
		DATAMANAGER.RequestRealData( "ohhts_exst_aspr" ) '정규장 실시간 호가
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" ) '정규장 실시간 체결
		DATAMANAGER.RequestRealData( "ohhts_exst_cnta" ) '애프터마켓 실시간 체결
		DATAMANAGER.RequestRealData( "ohhts_exst_cntd" ) '주간거래 실시간 체결
		
		'-------------------------------------------------------------------
		' 호가조회 완료
		' 수량/가격 자동입력 설정이 되어있는 경우, 호가조회가 완료된 이후에
		' 각 주문화면에서 [RequestAutoPrice], [RequestAutoQty] 호출
		'-------------------------------------------------------------------
		Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "HOGA_COMPLETE", "")
		
		
	elseif szTranID == "ohhts_6000_003r" then
		if _tonumber(contCntg.grdCNTG.rowcount) > g_nMaxCount then
			contCntg.grdCNTG.rowcount = g_nMaxCount
		end if
		
	'-------------------------------------------------------------------------
	' 주간장 시세 조회 처리(미국종목 일때만, 주간현재가 조회됨. 나머지는 다 0)
	'-------------------------------------------------------------------------
	elseif szTranID == "ohhts_6000_017r" then
	
		szDayPrc = Cdbl(DATAMANAGER.GetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0))
		
		if szDayPrc <> 0 then
			lblHyun.caption = szDayPrc
			Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "SEND_DAYMARKET_PRC", szDayPrc)
		end if
		
	'-------------------------------------------------------------------------
	' 관심그룹 조회
	'-------------------------------------------------------------------------	
	elseif szTranID == "ohhts_intr_006r" then	'20240710 HSZ
		ResponseTranData_Intr()

	'-------------------------------------------------------------------------
	' 애프터장 시세 조회 처리(미국종목 일때만
	'-------------------------------------------------------------------------
	elseif szTranID == "ohhts_6000_020r" then
	
		szAfterPrc = Cdbl(DATAMANAGER.GetDataValue(0, "ohhts_6000_020r", "OutBlock1", "FIDX_MKT_AFT_PRPR" , 0))
		
		if szAfterPrc <> 0 then
			lblHyun.caption = szAfterPrc
			Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "SEND_AFTERMARKET_PRC", szAfterPrc)
		end if
		
	end if

	'-------------------------------------------------------------------------
	' 액면분할/권리선반영 시 사용하는 로직
	'-------------------------------------------------------------------------
	'elseif szTranID == "obtro_acnt_900r" then
	'
	'	'애플/테슬라 잔고보유 고객한테만 유의사항 팝업 띄어줌.
	'	agreeYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "AGRM_YN" 		, 0)
	'	jangoYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "RMND_EXST_YN" 	, 0)
	'	
	'	if jangoYn = "Y" then
	'		if agreeYn = "N" then
	'			Form.OpenPopup("mhtro16060_p9" , "" , "")
	'		end if
	'		
	'	end if
	'-------------------------------------------------------------------------
		
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID == "obpds_srvc_323r" then
		szYakCd = DATAMANAGER.GetDataMsgCode(szTranID)
		
		if szYakCd <> "5766" then
			'20240807 매수탭에서만 약정신청 팝업 발생하도록 요건 변경(노민아 과장 요청)
			nCurrentTab = FormTab0.currenttab
			if nCurrentTab == 0 or nCurrentTab == "0" then
				Form.MsgBox("안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 7 , "거래신청하기", "취소")
			end if
		
		else
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )	
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	if szTranID == "ohhts_exst_aspr" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	elseif szTranID == "ohhts_exst_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	elseif szTranID == "ohhts_exst_cnta" then '20220404 HSZ 애프터마켓 실시간체결 추가
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	elseif szTranID == "ohhts_exst_cntd" then '20221213_01 KBC 해외주식주간거래
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	
	if szTranID == "ohhts_exst_cntg" then
		
		'----------------------------------------------
		'호가창 시고저 표시
		'----------------------------------------------
		sOprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cntg", "OutBlock1", "FIDXR_OPRC" , 0)
		sHprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cntg", "OutBlock1", "FIDXR_HPRC" , 0)
		sLprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cntg", "OutBlock1", "FIDXR_LPRC" , 0)
		
		contHoga.hogaTbl.startprice = sOprc
		contHoga.hogaTbl.highprice = sHprc
		contHoga.hogaTbl.lowprice = sLprc
	
	elseif szTranID == "ohhts_exst_cnta" then
		
		'----------------------------------------------
		'호가창 시고저 표시
		'----------------------------------------------
		sOprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cnta", "OutBlock1", "FIDXR_OPRC" , 0)
		sHprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cnta", "OutBlock1", "FIDXR_HPRC" , 0)
		sLprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cnta", "OutBlock1", "FIDXR_LPRC" , 0)
		
		contHoga.hogaTbl.startprice = sOprc
		contHoga.hogaTbl.highprice = sHprc
		contHoga.hogaTbl.lowprice = sLprc
	
	elseif szTranID == "ohhts_exst_cntd" then
	
		'----------------------------------------------
		'호가창 시고저 표시
		'----------------------------------------------
		sOprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cntd", "OutBlock1", "FIDXR_OPRC" , 0)
		sHprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cntd", "OutBlock1", "FIDXR_HPRC" , 0)
		sLprc = DATAMANAGER.GetDataValue(1, "ohhts_exst_cntd", "OutBlock1", "FIDXR_LPRC" , 0)
		
		contHoga.hogaTbl.startprice = sOprc
		contHoga.hogaTbl.highprice = sHprc
		contHoga.hogaTbl.lowprice = sLprc
		
	end if
	
End Sub

