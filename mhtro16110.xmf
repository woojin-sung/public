'----------------------------------------------
'주문설정값(주문번호 연동/계좌비밀번호 저장)
'----------------------------------------------
Dim g_szAfterOrg
Dim g_szSavePwd 
g_szSavePwd  = "0"

'-------------------
' 종목정보
'-------------------
Dim g_sCode 		' 종목코드
g_sCode = ""

Dim g_sItemInfo	' 탭변경 시 넘겨줄 종목정보
g_sItemInfo = ""

'----------------------
' 체결그리드 최대행 수
'----------------------
Dim g_nMaxCount
g_nMaxCount = 300

'----------------------
' 비밀번호 검증 후 자동 주문확인창 오픈
'----------------------
Dim g_OpenConfirmNextCheckPwd
g_OpenConfirmNextCheckPwd = false

'----------------------
' 관심종목 그룹 갯수
'----------------------
Dim g_szIntrGrpCnt
g_szIntrGrpCnt = 0

Dim gOsType

'============================================================================
Sub Form_OnFormInit()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	'-----------------------------------------------------------------------------
	' 20240617 LES START - 돋보기버튼 눌렀을때, 메인쪽에서 TITLE_CLICK으로 내려줄수 있도록 서치타입 설정
	'-----------------------------------------------------------------------------
	Form.setSearchTypeClick("1")
	
	'화면상단 세팅
	Form.SetButtonTitle("현재가")
	
	'-----------------------------------------------------------------------------
	' 호가테이블 설정(현재가 테두리 영역 범위 지정 / 등락률 글자색)
	'-----------------------------------------------------------------------------
	contHoga.hogaTbl.SetHogaRect("1")
	contHoga.hogaTbl.setRateColor(69,69,69)
	contHoga.hogaTbl.setTextAutoSize(true)
	contHoga.setScrollBarVisible("0")
	

	'-----------------------------------------------------------------------------
	' 폼탭 이미지 및 글자색상 변경
	'-----------------------------------------------------------------------------
	FormTab0.setTabHeaderFgColorWithIndex(0,290,110)
	FormTab0.setTabHeaderFgColorWithIndex(1,291,110)
	FormTab0.setTabHeaderFgColorWithIndex(2,49,110)
	FormTab0.setTabHeaderFgColorWithIndex(3,49,110)
	
	FormTab0.setTabHeaderImageWithIndex(0,"tab_04_o.9","tab_03_n.9")
	FormTab0.setTabHeaderImageWithIndex(1,"tab_05_o.9","tab_03_n.9")

	'-----------------------------------------------------------------------------
	' (안드로이드 전용) 비밀번호 에디트 클릭 방지, 에디트 위에있는 버튼이 클릭되도록 앞으로 가져옴
	'-----------------------------------------------------------------------------
	btnPwd.bringfront("1")
	
	'-----------------------------------------------------------------------------
	' 비활성화로 기본 세팅 20230722 HSZ
	'-----------------------------------------------------------------------------
	'Form.SetInterestTitle("N")	
	
	'-----------------------------------------------------------------------------
	' 주문설정값(주문번호 연동/계좌비밀번호 저장) 세팅
	'-----------------------------------------------------------------------------
	Load_OrderSet()
	
	'-----------------------------------------------------------------------------
	' 타 화면 연동
	'-----------------------------------------------------------------------------
	if Form.GetOpenLinkData( ) == "0" or Form.GetOpenLinkData( ) == 0	then			'매수
	
		FormTab0.currenttabpageid = "page0"
	
	elseif Form.GetOpenLinkData( ) == "1" or Form.GetOpenLinkData( ) == 1	then		'매도
		
		FormTab0.currenttabpageid = "page1"	
		
	else
		
		szData = Form.GetOpenLinkData()
		arrData = Split(szData, "♥")
		
		if arrData(0) <> "" then
		
			arrLinkCode = Split(arrData(0),"★")
			szLinkCode = arrLinkCode(0)
			if CheckMasterFile(szLinkCode) then
				
			else
				Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
				Exit Sub
			end if
			
			Form.setOverStockItemCode(arrData(0))
			
			if arrData(1) == "0" then
				FormTab0.currenttabpageid = "page0"
			elseif arrData(1) == "1" then
				FormTab0.currenttabpageid = "page1"
				
				'해외주식 매도상환
				'매도매수구분/수량/대출일자/대출상세유형코드/대출일련번호
				Form.SetSharedData("JANGO" , arrData(1).."★"..arrData(2).."★"..arrData(3).."★"..arrData(4).."★"..arrData(6))
				
			end if
		end if
	end if

	'-----------------------------------------------------------------------------
	' 초기종목 세팅
	'-----------------------------------------------------------------------------
	ItemCode0.code = Form.GetSharedData("&ITEM_CODE", false)
	
	if Len(ItemCode0.code) > 0 then
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "InitCode", ItemCode0.code )
		Form.triggerEvent( "LinkFormTop", "RequestData", ItemCode0.code)
	end if
	
	'-----------------------------------------------------------------------------
	' 해외주식 약정체크
	'-----------------------------------------------------------------------------
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
	
	RequestTranData_Intr()			' 관심그룹 갯수 조회
	Form.requestIntrItemList("00")	' 관심종목 목록 조회
	
end Sub

'============================================================================
' 앱 백그라운드 > 포그라운드 전환 시 호출
'============================================================================
Sub Form_OnRefresh()
	ItemCode0_OnEditComplete(ItemCode0.code)
end Sub 

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "SCREEN_REFRESH" then
		ItemCode0_OnEditComplete(ItemCode0.code)
		
	elseif sEventName = "SCREEN_MENU" then							' 연결정보(상단 ...)
		
		if sParam = "REG_INTR" Then									' 관심종목등록
'			Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code , "" )
			szCode = ItemCode0.code
			isIntrItem = Form.isIntrItemList(szCode)
			
			if CInt(g_szIntrGrpCnt) < 1 then
				g_szAction = "GROUP_ADD2"
				'관심그룹&관심종목 동시추가	
				Form.OpenPopup("mhprc11000_pf", g_szAction & "★" & szCode & "★", "")
			else
				'관심그룹 추가
				Form.OpenPopupAnimation("mhprc11000_pd", szCode& "★"& "ADD","", "2")
			end if

		elseif sParam = "SET_SCREEN" Then							' 화면설정
			nCurTabIndex = FormTab0.currenttab
			Form.SetSharedData("16061_CURTAB_IDNEX" , nCurTabIndex)
			
			Form.OpenScreen("90000" , "1")

		end if
	
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	elseif sEventName == "TITLE_CLICK" then
		
		'20240617 LES START - 해외/국내 종목선택창 통합
		'Form.OpenCommonDialog("SEARCH", "19", "MAIN")
		Form.OpenPopup("msearchdialog", "종목검색★50:51:52:53:54:55★INTG_DIVIDE_HISTORY★OVRS★12020", "")
		'20240617 LES END
	
	'------------------------------------------------------------------------
	' (사용) 잔고팝업 선택종목으로 종목변경
	'------------------------------------------------------------------------
	elseif sEventName == "16100_BALANCE" then
		
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
				
		Form.setOverStockItemCode(sParam)
		
	elseif (sEventName == "16060_CONTRACT") then
		
		'20220510 LES START
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		
		Form.setOverStockItemCode(sParam)
		
	'------------------------------------------------------------------------
	' (사용) 자동가격입력 설정 시 자동입력값 리턴
	'------------------------------------------------------------------------
	elseif sEventName == "RequestAutoPrice" then
		
		sPrice = Return_AutoPrice(sParam)
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ReturnAutoPrice", sPrice )
		
	'------------------------------------------------------------------------
	' (사용) 비밀번호 미입력 시, 비밀번호 입력창 오픈
	'------------------------------------------------------------------------
	elseif sEventName == "ShowPasswordKeyPad" then
	
		g_OpenConfirmNextCheckPwd = true
		btnPwd_OnClick()
		
	'----------------------------------------------------------------------------------------
	'(사용) 정정/취소탭 종목선택 개수에 따른 호가영역 위치조정(3:선택종목없음/4:선택종목있음)
	'----------------------------------------------------------------------------------------
	elseif sEventName == "ChangeContHoga" then
		
		ChangeContHoga(sParam)
		
	'----------------------------------------------------------------------------------------
	'(사용) 정정/취소탭에서 단일종목 선택한 경우 종목정보 수신
	'----------------------------------------------------------------------------------------
	elseif sEventName == "SendModCancelItem" or sEventName == "SendChegyulItem" then
		
		'----------------------------------------
		'sParam : OQ@AAPL★애플
		'----------------------------------------
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
				
		Form.setOverStockItemCode(sParam)
	
	'----------------------------------------------------------------------------------------
	'(사용) 주문/체결 탭에서 미체결 종목 선택 시, 정정/취소탭 연동
	'----------------------------------------------------------------------------------------
	elseif sEventName == "SendMiChegyulItem" then
		
		FormTab0.currenttab = "2"
		Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, sEventName, sParam)
	
	'----------------------------------------------------------------------------------------
	'(사용) 잔고탭에서 매수/매도탭 연동
	'----------------------------------------------------------------------------------------
	elseif sEventName == "SendJangoItem" then
	
		'----------------------------------------------------------------------------------------------------
		'sParam : MAESU★szMk@szItemCode★szName★sOrdAbleQty★sJangoGubun★sLoanType★sLoanDate★sLoanSrno
		'----------------------------------------------------------------------------------------------------
		arrLinkItem = Split(sParam,"★")
		
		if #arrLinkItem > 0 then
			
			szLinkCode = arrLinkItem(1)
			szName = arrLinkItem(2)
			
			if CheckMasterFile(szLinkCode) then
			
			else
				Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
				Exit Sub
			end if
		
			Form.setOverStockItemCode(szLinkCode.."★"..szName)
			
			if arrLinkItem(0) == "MAESU" then
				FormTab0.currenttab = "0"
				FormTab0_OnTabChanged(0) 
				
			elseif arrLinkItem(0) == "MAEDO" then
				FormTab0.currenttab = "1"
				FormTab0_OnTabChanged(1)
			
			end if
			
			Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, sEventName, sParam)
		
		end if
	
	'----------------------------------------------------------------------------------------
	' (사용) 화면상단 [현재가] 버튼 클릭 이벤트
	'----------------------------------------------------------------------------------------
	elseif sEventName == "CLICK_BUTTON" then
		
		Form.OpenScreen("16000" , "")
	
	elseif sEventName == "AfterOrd" then
	
		edtOrgNo.caption = sParam
	
	'----------------------------------------------------------------------------------------
	' (사용) 상단시세화면에서 전송. 주문화면에서는 애프터마켓 여부 판단용으로 사용
	'----------------------------------------------------------------------------------------
	elseif sEventName == "CHANGE_MKTOP" then
	
		if sParam == "005" then
		
			'가격/수량 입력키패드(16100_p1)에서 애프터장 여부를 판단하기 위해 사용
			'가능수량 조회 팝업(16100_p11)에서도 애프터장 여부를 판단하기 위해 사용
			Form.SetSharedData("OVRS_AFTER_MARKET_ORDER" , "Y")
			
			if g_sCode <> "" then
				
				arrCode = Split(g_sCode,"@")
			
				if #arrCode > 1 then
					
					szMarket = arrCode(0)
					if szMarket == "OQ" or szMarket == "NY" or szMarket == "AX" then
						DATAMANAGER.RequestTranData( "ohhts_6000_020r" )
					end if
					
				end if
				
			end if
			
		else
		
			Form.SetSharedData("OVRS_AFTER_MARKET_ORDER" , "N")
			
		end if 
	
	elseif sEventName == "AfterOrd" then
	
		edtOrgNo.caption = sParam
	
	end if
	
	
end Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
	'20240617 LES START - 해외/국내 종목선택창 통합
	if "&ITEM_CODE" == sKey then
		
		if CheckMasterFile(sValue) then '20240621 
			edtOrgNo.caption = ""
			ItemCode0_OnEditComplete(sValue)
		end if
		
	end if
	'20240617 LES END
	
End Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)

	'20240715 LES START
	nCurrentTab = Cint(FormTab0.currenttab)
	
	if g_sCode <> sCode then
		ItemCode0.code = sCode
		Request_Hoga(sCode)
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeCode", ItemCode0.code )
	
	else
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "RefreshData", ItemCode0.code )
	end if
	'20240715 LES END
	
	Form.triggerEvent( "LinkFormTop", "RequestData", ItemCode0.code)
	
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	
	'======================================================================
	'종목연동 및 주문설정값 연동
	'======================================================================
	if Len(ItemCode0.code) > 0 then
		
		if nCurrentTab == 2 or nCurrentTab == "2" then
			
			'주문연동시
			if g_szAfterOrg == "1" then		
				if edtOrgNo.caption <> "" then
					Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption) '주문번호 연동
				end if
			end if
			
		end if
		
		'종목코드 넘김
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeTab", ItemCode0.code )	
		
		'종목정보 넘김
		if g_sItemInfo <> null and g_sItemInfo <> "" then
			Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "SEND_ITEM_INFO", g_sItemInfo)
		end if
		
	end if
	
	'======================================================================
	'선택한 탭에따라 호가테이블 영역 조정
	'======================================================================
	
	'-----------------------------------
	'매수/매도 탭
	'-----------------------------------
	if nCurrentTab == 0 or nCurrentTab == "0" or nCurrentTab == 1 or nCurrentTab == "1" then
		
		nMaxPrc = Cdbl(tblHigh.GetCellString(0, 1))
		nMinPrc = Cdbl(tblLow.GetCellString(0, 1))
		
		if nMaxPrc > 0 and nMinPrc > 0 then
			ChangeContHoga("1")
		else
			ChangeContHoga("2")
		end if
	
	'-----------------------------------
	'예약내역/취소 탭, 주문체결 탭
	'-----------------------------------
	elseif nCurrentTab == 2 or nCurrentTab == "2" or nCurrentTab == 3 or nCurrentTab == "3" then
		
		if rdoHoga.currentindex == 1 or rdoHoga.currentindex == "1" then
			rdoHoga.currentindex = 0
			contCntg.visible = false
		end if
		
		ChangeContHoga("3")
	
	end if
	
	
	
End Sub
'============================================================================
