	<SCRIPT_INFO _len="7624" _ulen="6772" >
'============================================================================
' 01.화면명 	: 오픈뱅킹 다른금융기관 계좌등록_등록결과
' 02.화면설명	: 오픈뱅킹 다른금융기관 계좌등록_등록결과
' 03.작성	: 2020.10.26
'               2020.08.10 v002 단말접속기기정보부 추가
'============================================================================
'szData
'전체건수★성공건수★실패건수★금융기관명★계좌구분★예금명★계좌번호★조회동의★출금동의★처리상태
'전체건수★이메일★금융기관코드★금융기관명★계좌번호
'10건. 그리드에는 성공건수만큼 출력
'============================================================================

Dim g_szUserID	'전자금융ID
Dim g_CiKey
Dim grd0_index

Dim pros_csnu '처리건수

'============================================================================
Sub Form_OnFormInit()

	g_szUserID = Form.GetSharedData( "&USER_ID"	, false )	'사용자ID
	grd0_index = -1
	pros_csnu  = 0 		'처리건수 초기화
	Label22.caption = 0
	Label33.caption = 0
	
	Image0.imgpath = "title_3step_cut_03_on.png"
	
	szData     = Form.GetOpenLinkData()
	
	arrData    = Split(szData,"★")
	
	if UBOUND(arrData) < 1 then
		exit sub
	end if

'전체건수★이메일★CiKey★ 반복부(계좌구분★예금명★금융기관코드★금융기관명★계좌번호★예금주명)
	
	Label11.caption = arrData[0] '전체건수
	Email.caption   = arrData[1] '이메일
	g_CiKey	 	  = arrData[2] 'CiKey

	dim count
	count =0
	for i = 0 to CDbl(Label11.caption)-1 
		if i>0 then
			grd0.AddRow()
		end if
		grd0.SetCellData("bd_cell1", i , arrData[3 +cdbl(count)] ) '계좌구분명
		grd0.SetCellData("bd_cell2", i , arrData[4 +cdbl(count)] ) '예금명
		grd0.SetCellData("bd_cell7", i , arrData[5 +cdbl(count)] ) '금융기관코드
		grd0.SetCellData("bd_cell0", i , arrData[6 +cdbl(count)] ) '금융기관명
		grd0.SetCellData("bd_cell3", i , arrData[7 +cdbl(count)] ) '은행계좌번호
		grd0.SetCellData("bd_cell8", i , arrData[8 +cdbl(count)] ) '예금주명
		
		count   = count +6;
	next
	
	Setpass()
	
End Sub

'============================================================================
Function Setpass()
	if cdbl(pros_csnu) < cdbl(grd0.rowcount)  then ' 처리건수와 그리드수 같으면 종료
	
		grd0_index = grd0_index +1
		
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "PROS_CLS_CODE"	 , 0, 1								) '처리구분코드
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "ELFN_ID"  	 	 , 0, g_szUserID 						)
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "BANK_CODE"	 	 , 0, grd0.GetCellData("bd_cell7", pros_csnu)	) '기관코드
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "BANK_ACNO"	 	 , 0, grd0.GetCellData("bd_cell3", pros_csnu)	) '계좌번호
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "EMAIL_ADDR"	 	 , 0, Email.caption					) '이메일주소
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "DRNG_AGRM_YN"	 , 0, "Y"							) '출금동의여부
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "INFO_OFER_AGRM_YN", 0, "Y"							) '정보제공동의여부
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "ACHO_NAME"		 , 0, grd0.GetCellData("bd_cell8", pros_csnu)	) '예금주명
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "CIKEY_NO"		 , 0, g_CiKey							) 'CiKey
		
		'v002 sta =============================================
		Dim l_MediaCode
				
		Dim l_TermUserClsCode
		Dim l_IpAddress
		Dim l_TermId
		Dim l_OsVersion
		
		l_MediaCode = Form.GetSharedData("&MEDIA_CODE", false )
		l_IpAddress = Form.GetSharedData("&IP_ADDRESS", false )
		l_OsVersion = Form.GetSharedData("&OS_VERSION", false )
						
		if l_MediaCode = "156" then 'iOS
			l_TermUserClsCode = "IO"
			l_TermId = Form.GetDeviceID()
			
		elseif l_MediaCode = "157" then '안드로이드
			l_TermUserClsCode = "AD"
			l_TermId = Form.GetAndroidID()
			
		else
			l_TermUserClsCode = ""
			l_TermId = ""
		end if
		
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_USER_CLS_CODE" , 0, l_TermUserClsCode	) '단말사용자구분코드
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "REG_TERM_IPAD"      , 0, l_IpAddress     	) '등록단말IP주소
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_MAC_ADDR"      , 0, ""    			) '단말MAC주소
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_ID"            , 0, l_TermId			) '단말ID
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_OS"            , 0, l_OsVersion		) '단말운영체제
		'v002 fin =============================================
		
		'DATAMANAGER.SetDataValue('bReal, sTranID , sBlockName , sFieldName , nIndex , szValue)
		DATAMANAGER.RequestTranData( "obtss_opnf_004a" )
		pros_csnu = cdbl(pros_csnu) +1
	end if
	
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtss_opnf_004a" then	
		
	
		tmp_iqry_agrm_yn  = DATAMANAGER.GetDataValue (0, "obtss_opnf_004a", "OutBlock1", "UI_ITEM_NAME011"  , 0 ) '조회동의여부
		tmp_drng_agrm_yn  = DATAMANAGER.GetDataValue (0, "obtss_opnf_004a", "OutBlock1", "UI_ITEM_NAME012"   , 0 ) '출금동의여부
		tmp_pros_stat	    = DATAMANAGER.GetDataValue (0, "obtss_opnf_004a", "OutBlock1", "PROS_STAT_NAME" , 0 ) '처리상태
		
		grd0.SetCellData("bd_cell4", grd0_index , tmp_iqry_agrm_yn	) '조회동의
		grd0.SetCellData("bd_cell5", grd0_index , tmp_drng_agrm_yn	) '출금동의
		grd0.SetCellData("bd_cell6", grd0_index , tmp_pros_stat	) '처리상태
		
		if tmp_pros_stat =="확인필요" then
			Label33.caption = cdbl(Label33.caption) +1
			
			DATAMANAGER.GetDataMsgSubText( szTranID )
			grd0.SetCellData("bd_cell9", grd0_index , DATAMANAGER.GetDataMsgSubText( szTranID )	) '서비스정상이턴이나 확인필요인경우 부메시지 출력(박영택 차장님 요청)
		else
			Label22.caption = cdbl(Label22.caption) +1
		end if
		
		Setpass()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtss_opnf_004a" then	
		Label33.caption = cdbl(Label33.caption) +1
		grd0.SetCellData("bd_cell6", grd0_index , "확인필요"	) '처리상태
		grd0.SetCellFgColor( "bd_cell6", grd0_index, "6")
		
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'Form.ShowAlert( "알림", szErrMsg )
		'grd0.SetCellData("bd_cell9", grd0_index , szErrMsg	) '에러메시지 저장
		
		if szSubErr =="" then
			grd0.SetCellData("bd_cell9", grd0_index , szErrMsg	) '에러메시지 저장
		else
			grd0.SetCellData("bd_cell9", grd0_index , szErrMsg.."("..szSubErr..")"	) '에러메시지 저장
		end if
	
		Setpass()
	end if
End Sub
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	if grd0.GetCellData( "bd_cell6", lRow, "" ) =="확인필요" then
		Form.ShowAlert( "알림",  grd0.GetCellData( "bd_cell9", lRow, "" ))
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbnk62005_end" ,  "1" )
End Sub
'============================================================================
Sub btnOK_OnClick()
	'Form.OpenFramePopup("mbbnk62030" , sSendData  , sPosInfo)
	Form.OpenScreen("62030", sz_data)
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtss_opnf_004a" trcode="obtss_opnf_004a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtss_opnf_004a" title="오픈뱅킹_타행계좌이용등록" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="613" _ulen="469" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
ELFN_ID^전자금융ID^20^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
