	<SCRIPT_INFO _len="1760" _ulen="1760" >
Dim szEnv
szEnv = ""

'============================================================================
Sub Form_OnFormInitBefore()
	Image1.setMaintainingRatio("1")
	Image3.setMaintainingRatio("3")
End Sub

'============================================================================
Sub Form_OnFormInit()
	sUserID 	= Form.GetSharedData("&USER_ID" , false)
	if sUserID == "" then
		'Form.SendReturnToParent("prevnotice" , "")
		Form.CloseForm()
	end if
	
	szEnv = Form.GetEnvData("PREV_NOTICE_OPEN")
	
	if szEnv == "" then
		szEnv = "0" 
		Form.SetEnvData("1", "PREV_NOTICE_OPEN", "0")
	end if
	
	if szEnv == "1" then
		'Form.SendReturnToParent("prevnotice" , "")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Image1_OnClick()
	'Form.SendReturnToParent("prevnotice" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	Form.SetEnvData("1", "PREV_NOTICE_OPEN", sCheckState)
	'Form.SendReturnToParent("prevnotice" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Label2_OnClick()
	'Form.SendReturnToParent("prevnotice" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Image3_OnClick()
	
	Form.CloseForm()
End Sub

'============================================================================
Sub Button2_OnClick()
	Form.OpenPopup("notice_p10","InterestInteg","")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("prevnotice" , "")
End Sub

