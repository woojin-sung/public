	<CONTROL_INFO>
		<IMAGE name="imgClose" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image1" imgpath="popup_bg_common.9" ly_vert="20,216,335,158,1" />
		<BUTTON name="btnCancel" caption="확인" btnimage="btn_22.9" ly_vert="20,364,335,50,1" />
		<LABEL name="Label0" fontsize="2" fontstyle="01" caption="알림" halign="1" ly_vert="30,216,315,57,1" />
		<LABEL name="Label1" caption="새롭게 변경된 업무가 있습니다.
고객님의 안전한 서비스 제공을 위해
업데이트 후 이용해주시기 바랍니다." halign="1" multiline="1" ly_vert="31,258,315,96,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="731" _ulen="731" >
'============================================================================
Sub Form_OnFormInit()
    Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
End Sub

'============================================================================
Sub btnCancel_OnClick()

    osType = Form.GetSharedData("&OS_TYPE", false)
		
    if osType == "1" then
        Form.runStoreApp("#", "market://details?id=com.imeritz.smartmeritz")
    elseif osType == "2" then
        Form.openExternalBrowser("https://itunes.apple.com/app/id1104272974?mt=8")
    end if
    
End Sub

	</SCRIPT_INFO>
</ROOT>