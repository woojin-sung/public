'===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szSTPLYN
'===========================================================================
Sub Call_Tran()

	g_szAcno = left(acnt1.caption,8)
	g_szAsno = right(acnt1.caption,2)
	
	
	if Cint(fmtab0.currenttab) = 0 or Cint(fmtab0.currenttab) = 1 then
		Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "TRANCALL", g_szAcno & "||" & g_szAsno & "||" & RadioGroup0.currentindex )
	else
		Form.ShowAlert("Error", "유효하지않은 탭입니다.")
		exit sub
	end if
	
	DATAMANAGER.SetDataValue(0, "oblon_lndn_018r", "InBlock1", "ACNO", 0 	 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "oblon_lndn_018r", "InBlock1", "ASNO", 0 	 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "oblon_lndn_018r", "InBlock1", "ACNT_PWD", 0  , EditPW.caption)
	
	DATAMANAGER.RequestTranData("oblon_lndn_018r")
	
End Sub
'============================================================================
Sub Form_OnFormInit()
	Call_Tran()
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	Call_Tran()
End Sub

'============================================================================
Sub acnt1_ChangeAccount()
	EditPW.caption = ""	
	Call_Tran()
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_lndn_018r" then
		g_szSTPLYN = DATAMANAGER.GetDataValue(0, "oblon_lndn_018r", "OutBlock2", "STPL_YN" , 0)
		
		if g_szSTPLYN = "Y" then
			Table0.SetCellString(0, 1, "등록")
		else
			Table0.SetCellString(0, 1, "미등록")
		end if
	end if
End Sub
'============================================================================

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	Call_Tran()
End Sub

