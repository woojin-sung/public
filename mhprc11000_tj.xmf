'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 CFD
' 03. 작    성 : 2023.08.24 JJH
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function RequestData()
	DATAMANAGER.RequestTranData( "ohhts_cfdt_001r" )
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
		
		RequestData()
	end	if	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Grid_Show()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		 
		RequestData()
		
'	ElseIf sEventName = "SELECT_Rdo" then
'		rdo0.eventindex = sParam
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "ohhts_cfdt_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_cfdt_001r", "InBlock1", "FID_INPUT_ISCD"	, 0 , g_szItemCode )
	end if
End Sub


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function Grid_Show()
	If rdo1.currentindex = "0" then
		grdMesu.SetVisibleCol(  1, 1 )
		grdMesu.SetVisibleCol(  2, 1 )
		grdMesu.SetVisibleCol(  3, 1 )
		grdMesu.SetVisibleCol(  4, 1 )
		
		grdMesu.SetVisibleCol(  5, 0 )
		grdMesu.SetVisibleCol(  6, 0 )
		grdMesu.SetVisibleCol(  7, 0 )
		grdMesu.SetVisibleCol(  8, 0 )
		
		grdMedo.SetVisibleCol(  1, 1 )
		grdMedo.SetVisibleCol(  2, 1 )
		grdMedo.SetVisibleCol(  3, 1 )
		grdMedo.SetVisibleCol(  4, 1 )
		
		grdMedo.SetVisibleCol(  5, 0 )
		grdMedo.SetVisibleCol(  6, 0 )
		grdMedo.SetVisibleCol(  7, 0 )
		grdMedo.SetVisibleCol(  8, 0 )
		
	else
		grdMesu.SetVisibleCol(  1, 0 )
		grdMesu.SetVisibleCol(  2, 0 )
		grdMesu.SetVisibleCol(  3, 0 )
		grdMesu.SetVisibleCol(  4, 0 )
		
		grdMesu.SetVisibleCol(  5, 1 )
		grdMesu.SetVisibleCol(  6, 1 )
		grdMesu.SetVisibleCol(  7, 1 )
		grdMesu.SetVisibleCol(  8, 1 )
		
		grdMedo.SetVisibleCol(  1, 0 )
		grdMedo.SetVisibleCol(  2, 0 )
		grdMedo.SetVisibleCol(  3, 0 )
		grdMedo.SetVisibleCol(  4, 0 )
		
		grdMedo.SetVisibleCol(  5, 1 )
		grdMedo.SetVisibleCol(  6, 1 )
		grdMedo.SetVisibleCol(  7, 1 )
		grdMedo.SetVisibleCol(  8, 1 )
	
	end if
end Function

'============================================================================
Sub rdo0_OnClick(nIndex)
	if rdo0.currentindex == "0" then
		grdMedo.visible = false
		grdMesu.visible = true
	else
		grdMedo.visible = true
		grdMesu.visible = false
	end if
End Sub

'============================================================================
Sub rdo1_OnClick(nIndex)
	Grid_Show()

End Sub

'============================================================================
Sub grdMesu_OnScrollEnd()
	DATAMANAGER.RequestNextData( "ohhts_cfdt_001r" )
End Sub
'============================================================================
Sub grdMedo_OnScrollEnd()
	DATAMANAGER.RequestNextData( "ohhts_cfdt_001r" )
End Sub

