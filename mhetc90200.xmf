<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="90200" scrname="공지사항" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<LABEL name="LabelCSNO" ly_vert="488,91,100,32,1" />
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,0,375,562,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1418" _ulen="1264" >
Dim g_serverMode, g_serverURL
'============================================================================
Sub Form_OnFormInit()
	
	g_serverMode = Form.GetSharedData("&SERVER_MODE", false)
	szScreen = Form.GetSharedData("&SCREEN_NO", false)
	
	If g_serverMode == "1" Then	'개발기
		g_serverURL = "https://testhome.imeritz.com"
	else
		g_serverURL = "https://home.imeritz.com"
	end if
		
	MenuOpen(szScreen)
End Sub
'============================================================================
Function MenuOpen(scrNum)
	Select Case scrNum
	'해외주식 공지사항
	Case "90200"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_fstock.html"
	'해외주식 권리사항
	Case "90201"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_fstock2.html"
	'해외주식 휴장공지
	Case "90202"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_fstock3.html"
	'해외선물 휴장안내
	Case "90203"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_frFuturesHoliday.html"
	'해외선물 공지사항
	Case "90204"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_frfutures.html"
	'국내CFD 공지사항 (메뉴만 분리됐을 뿐, 해외CFD 공지사항과 같은 게시판 공유)
	Case "90205"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_cfdBbs.html"
	'해외CFD 공지사항
	Case "90206"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_cfdBbs.html"
	End Select
End Function


	</SCRIPT_INFO>
</ROOT>