	<SCRIPT_INFO _len="5869" _ulen="5689" >

Dim unPressedImgPath 
Dim PressedImgPath

Dim g_szRet

Dim g_tAnswerCnt
g_tAnswerCnt = Array("2", "2", "2", "2", "2") ' 각 문항 답변 갯수

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("이해여부 확인")
		
	Container.lblQ1.changeTextAttr(18, 19, 128, -1, true)	'color : 6 or 128
	Container.lblQ1.changeTextAttr(45, 17, 128, -1, true)
	Container.lblQ2.changeTextAttr(10, 25, 128, -1, true)
	Container.lblQ3.changeTextAttr(3, 17, 128, -1, true)
	Container.lblQ4.changeTextAttr(3, 13, 128, -1, true)
	Container.lblQ5.changeTextAttr(19, 30, 128, -1, true)

	unPressedImgPath = "btn_line_n.9.png"
	PressedImgPath   = "btn_line_o.9.png"
	
	
    Dim nQNum ' 문항번호
    for i = 0 to 4
  
	    nQNum = (i+1) ' 문항번호
	    
	    for j = 1 to 5
		    Select case nQNum
			    case 1, 2, 3, 4, 5
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
		    End Select
	    next
    next 
        
	btnOK.enable = False
	btnOK.fgcolor = "269"    
	szTheme = Form.GetEnvData("common.theme")
	
	If szTheme == "white" Then
		btnOK.btnimage = "btn_21.9"
	Else
		btnOK.btnimage = "btn_27.9"
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	If sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
			end if
		end if
	End if
End Sub

'============================================================================
Sub Container_ImgQ1A1_OnClick()
	g_Question_1 = "Y"
	SetCheckAnswer("1", "1")
End Sub
'============================================================================
Sub Container_ImgQ1A2_OnClick()
	g_Question_1 = "N"
	SetCheckAnswer("1", "2")
End Sub

'============================================================================
