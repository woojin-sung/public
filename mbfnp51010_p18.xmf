'============================================================================
Sub Container_ImgQ5A2_OnClick()
	g_Question_5 = "N"
	SetCheckAnswer("5", "2")
End Sub

'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum, nTIdx ' 문항번호, 테이블 인덱스
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1

	nAnswerCnt = g_tAnswerCnt[nTIdx]
	
	Select case nQNum
	    ' 버튼형 답변
	    case 1, 2, 3, 4, 5
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next
    End Select
    
	if szAnswerNum == "2" then
		Form.MsgBox("안내", "다시 선택해주세요!\n해당 문항이 이해가 되지 않으시다면,\n투자설명서를 읽고 내용을 확인해주세요.", "", 0)
		Form.SetCtlProp("Container.ImgQ" & nQNum & "A1", "imgpath", unPressedImgPath)
		Form.SetCtlProp("Container.ImgQ" & nQNum & "A2", "imgpath", unPressedImgPath)
			
		Select case nQNum
		    ' 버튼형 답변
		    case 1
			    g_Question_1 = "N"
		    case 2
			    g_Question_2 = "N"
		    case 3
			    g_Question_3 = "N"
		    case 4
			    g_Question_4 = "N"
		    case 5
			    g_Question_5 = "N"
	    End Select		
	end if
	
    User_Btn_OKStep()
    
End Function

'============================================================================
Function User_Btn_OKStep()

	strYN = "Y"

	If g_Question_1 <> "Y"  Then
		strYN = "N"
	End If

	If g_Question_2 <> "Y"  Then
		strYN = "N"
	End If

	If g_Question_3 <> "Y"  Then
		strYN = "N"
	End If

	If g_Question_4 <> "Y"  Then
		strYN = "N"
	End If

	If g_Question_5 <> "Y"  Then
		strYN = "N"
	End If


	If strYN == "Y" Then
		btnOK.enable = true
		btnOK.btnimage = "btn_20.9"
		btnOK.fgcolor = "273"
	Else
		btnOK.enable = false
	    If g_szTheme = "black" Then
			btnOK.btnimage = "btn_27.9"
	    Else 
			btnOK.btnimage = "btn_21.9"
	    End If
		btnOK.fgcolor = "269"
	End If
	
End Function

'============================================================================
Sub btnOK_OnClick()
	g_szRet = "ok"
	Form.CloseForm()	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbfnp51010_p18" , g_szRet )	
End Sub

'============================================================================
Sub imgClose_OnClick()
	g_szRet = "cancel"
	Form.CloseForm()	
End Sub

