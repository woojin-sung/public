'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

Dim g_szVCALL_TRGT_YN

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	tblOthers.visible = false

	g_szVCALL_TRGT_YN = Form.GetSharedData( "mbonl94002_VCALL_TRGT_YN", false)	'영상통화여부
	if g_szVCALL_TRGT_YN = "Y" then
		Label0.caption = "심사 진행을 위해"
		Label1.caption = "당사 직원의 영상 통화 연결이"
		Label1.changeTextAttr(7, 5, 10, 0, false)
		Label1.visible = true
		Label2.caption = "진행될 예정이예요"
		imgBox.visible = true
	else
		Label0.caption = "심사 진행을 위해"
		Label1.caption = "당사 직원의 유선 통화 연결이"
		Label1.changeTextAttr(7, 5, 10, 0, false)
		Label1.visible = true
		Label2.caption = "진행될 예정이예요"
		imgBox.visible = true
	end if
	
	if szOpenData <> "" or szOpenData <> NULL then
		if szOpenData == "switch_professional" then
			lblTitle.caption = "개인 전문투자자로\n분류(전환) 되었습니다."
		
			Label0.caption = ""
			Label1.caption = ""
			Label1.visible = false
			Label2.caption = ""
			imgBox.visible = false
		elseif szOpenData == "switch_normal" then
			lblTitle.caption = "일반투자자로\n분류(전환) 되었습니다."
		
			Label0.caption = ""
			Label1.caption = ""
			Label1.visible = false
			Label2.caption = ""
			imgBox.visible = false
		'21.08.03 JHY START
		elseif szOpenData == "switch_professional_others" then
			lblTitle.caption = "개인 전문투자자로\n분류(전환) 신청 되었습니다."
			tblOthers.visible = true
			
			Label0.caption = ""
			Label1.caption = ""
			Label1.visible = false
			Label2.caption = ""
			imgBox.visible = false
		'21.08.03 JHY END
		end if
	end if
End Sub

'============================================================================
' BtnOk_OnClick() : 화면 닫기
'============================================================================
Sub BtnOk_OnClick()
	Form.SendReturnToParent("close_mbonl94002_p2" , "")
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
