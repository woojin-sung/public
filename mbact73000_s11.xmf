	<SCRIPT_INFO _len="18539" _ulen="16927" >
'--===========================================================================
' 01. 화 면 명 : 카뱅후속-ID등록
' 02. 화면설명 : 카뱅후속-ID등록
' 03. 작    성 : 2023.01.02
'                비대면 ID등록 참고...
'--===========================================================================

'--===========================================================================
Dim	g_Acno
Dim	g_Pwd
Dim	g_WorkNo
Dim	g_ClphNo
Dim	g_HomeNo
Dim	g_HelpMsg
Dim	g_Flag
	g_Flag = 0
Dim	g_HomeYn
	g_HomeYn = "Y"
Dim	g_AcntPwdYn
Dim	g_CtcnYn
Dim	g_IDYn
Dim	g_IDPwdYn

'============================================================================
Function funcCtrSetting()

'	Cntn.CmbAcnt.SetApplyLabel("종합계좌번호", 0, 267, "left", true, 111)
'	AcnoMask = Left(g_Acno, 4) & "-" & Right(g_Acno, 4)
'	Form.SetCtlProp("Cntn.CmbAcnt", "cbadddatatext", AcnoMask)
'	Cntn.CmbAcnt.currentindex = 0
'	Cntn.CmbAcnt.enable = False
'	tempAcc = g_Acno
	
'	Cntn.EdtPwd.SetApplyLabel("종합계좌비밀번호", 0, 267, "left", true)
'	Cntn.EdtPwd.SetUseResultLabel(TRUE, 1)
	
	Cntn.EdtID.SetApplyLabel("사용자 ID", 0, 267, "left", true)
	Cntn.EdtID.SetUseResultLabel(TRUE, 1)
	Cntn.EdtIDPwd.SetApplyLabel("ID비밀번호", 0, 267, "left", true)
	Cntn.EdtIDPwd.SetUseResultLabel(TRUE, 1)
	Cntn.EdtIDPwdCnfr.SetApplyLabel("ID비밀번호 재입력", 0, 267, "left", true)
	Cntn.EdtIDPwdCnfr.SetUseResultLabel(TRUE, 1)
	
	Cntn.cntnGude.setHeightResize(0)
	Cntn.imgGudeO.imgpath	= "icon_caret_down.png"
	Cntn.lblGudeBg.bgcolor	= 271
	For ix = 0 To 26
		For jx = 0 To 4
			Cntn.cntnGude.Table1.SetCellBgColor(ix, jx, 272)
		Next
	Next

	g_AcntPwdYn	= "N"		
	g_CtcnYn		= "N"
	g_IDYn		= "N"
	g_IDPwdYn	= "N"

End Function

'============================================================================
Function funcBtnSet()
	'등록버튼 초기화
	If g_AcntPwdYn == "Y" And g_IDYn == "Y" And g_IDPwdYn == "Y" Then
		bit = True
	Else
		bit = False
	End If

	BtnIDReg.enable		= bit
	
	If bit == False Then
		BtnIDReg.btnimage	= "btn_21.9"
		BtnIDReg.bgcolor	= 271
		BtnIDReg.fgcolor	= 269
	Else
		BtnIDReg.btnimage	= "btn_20.9"
		BtnIDReg.bgcolor	= 265
		BtnIDReg.fgcolor	= 0
	End If
End Function

'============================================================================
'Str_Chk(str) : 입력 비밀번호 유효성 체크
'sGubn = "ID":ID 유효성 체크
'============================================================================
'한글 입력, 기럭지 체크
'리턴 : 영+숫, 기럭지 8 ~ 12 = True
'       한글, 기럭지 꽝 	= False
Function funcStrChk(str, sGubn)	
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크 '20150309_01 KBC
    
	chk_n = 0
	chk_c = 0
	chk_t = 0
    
	Dim nMinLen 
	if sGubn == "PW" then		'8~12자리
		nMinLen = 8
	elseif sGubn == "ID" then	'6~12자리
		nMinLen = 6
	end if
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
	    
		if nAscii < 0 then			'한글 일때
			g_HelpMsg = "한글입력 불가합니다."
			return False			'한글 기럭지 2
		else						'영, 숫, 특 일때    '20130125 lkm 영문+숫자 혼합 규칙 → 영문+숫자(필수), 특수문자(선택) 가능 으로 변경 
		    '48~57 : 0~9
		    '65~90 : A~Z
		    '97~122: a~z
		    '
			If nAscii >=48 and nAscii <=57 Then 
			    chk_n = 1 	
			Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
			    chk_c = 1 
			'20150309_01 KBC START
			'특수문자 확인 부분
			Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
				chk_t = 1 
			'20150309_01 KBC END
		    End if 		    
		end if
	Next
    
	if sGubn == "PW" then
		If ((chk_n + chk_c + chk_t) < 3) Then  '20150309_01 KBC
			return False
		End if
	elseif sGubn == "ID" then	'특수문자사용 불가
		If chk_t == 1 Then
			g_HelpMsg = "특수문자 사용은 불가합니다."
			return False
		End if
	end if
	
	if Len(str) < nMinLen or 12 < Len(str) then
		g_HelpMsg = nMinLen & " ~ 12 자리로 입력 가능합니다."
		return False
	end if
	
	return True
End Function

'============================================================================
Function funcIDPwdAcrd(seq)
	nContResize = 0
	nTop = 0
	
	If seq > 0 Then
		'nContResize = 879 'CInt(Form.calcUnResize(Cntn.lblPos.top, "1")) + 360'180'90
		nContResize = 505-60 'CInt(Form.calcUnResize(Cntn.lblPos.top, "1")) + 360'180'90		
		
		If seq == 1 Then
			nTop = CInt(Form.calcUnResize(Cntn.EdtID.top, "1"))		
		Else
			'nTop = CInt(Form.calcUnResize(Cntn.ChkButton0.top, "1"))
			nTop = CInt(Form.calcUnResize(Cntn.EdtIDPwd.top, "1"))
		End If
	End If
	
	Cntn.lblPos.top = nContResize
	Cntn.SetScrollAutoSize()
	Cntn.scroll_pos = nTop
	
End Function

'============================================================================
'타이머
'============================================================================
Sub Form_OnTimerEvent(sTimerID) 'v0001
	if trim(sTimerID) == "9999" Or sTimerID == 9999 then
		Form.SetTimerEvent("9999", 0, 1)
		Cntn.scroll_pos = 0
		Cntn.SetScrollAutoSize()
	end if
	
	If Trim(sTimerID) == "0" Or sTimerID == 0 Then
		Form.SetTimerEvent("0", 0, 1)
		Cntn.ChkButton0.fgcolor = 267
	End If
	
	If trim(sTimerID) == "8888" Or sTimerID == 8888 then
		Form.SetTimerEvent2("8888", 0, 0.3)
		Cntn.EdtIDPwd.SetShowKeypad(true)
	end if
	
	If trim(sTimerID) == "7777" Or sTimerID == 7777 then
		Form.SetTimerEvent2("7777", 0, 1)
		Cntn.EdtIDPwdCnfr.SetShowKeypad(true)
	end if
End Sub

