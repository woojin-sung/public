Sub Form_OnFormInit()
	'안드로이드 뒤로가기 비활성화
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	g_Acno = Form.GetSharedData( "BDM_KAKAO_ACNO", False )
	g_Pwd = Form.GetSharedData( "BDM_KAKAO_ACNO_PWD", False )
'g_Acno = "30202969"
'g_Pwd = "jCRLNwdHwZMKTglnJUd43btp9qQJ5ivuvl+SGRoJo6E="
	'JMY 앞화면에서 연동된 휴대폰번호로 처리
	'DATAMANAGER.SetUserID("meritz")		'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리

	funcCtrSetting()
	funcBtnSet()'(False)
	
	'JMY 고객연락처조회
	DATAMANAGER.RequestTranData("obacp_comm_004r")
	
	' accordion 기준점 초기화
	Cntn.lblPos.top = 0
	
	'이용약관 비활성화
	Cntn.ChkButton0.enable = False
	Cntn.ChkButton0.checkstate = False
	
	'사용자ID 비활성화
	Cntn.EdtID.enable = False
	Cntn.EdtID.caption = ""
	
	'ID비밀번호 비활성화
	Cntn.EdtIDPwd.enable = False
	Cntn.EdtIDPwd.caption = ""
	
	'ID비밀번호확인 비활성화
	Cntn.EdtIDPwdCnfr.enable = False
	Cntn.EdtIDPwdCnfr.caption = ""
	
	'비밀번호로 포커싱
'	Cntn.EdtPwd.SetShowKeypad(true)

	g_AcntPwdYn = "Y"
	
	'20230113 YHJ추가
	'카뱅은 보안매체발급을 ID발급 후 선택옵션으로 설계되어 보안매체없어도 ID등록되어야 한다고 함(엄태돈부장님 확인)
	'DATAMANAGER.RequestTranData("obcsb_oimf_520r")
	Cntn.EdtID.enable 		= TRUE
	Cntn.EdtIDPwd.enable 		= TRUE
	Cntn.EdtIDPwdCnfr.enable 	= TRUE
	'이용약관 비활성화
	Cntn.ChkButton0.enable 	= TRUE	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	If szTranID == "obcsb_efif_220r" Then 'ID 중복 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "USER_ID"  , 0 , Cntn.EdtID.caption	)  'ID
	
	Elseif szTranID == "obacp_comm_004r" Then '고객연락처 조회
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_Acno )
	
	Elseif szTranID == "obacp_comm_058r" Then 'ID비밀번호 유효성 검사
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"	 , 0 , "4" 		)	'[MTS] HTSID 등록시 ID비밀번호 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    	 , 0 , g_Acno 	)  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" 	 , 0 , Cntn.EdtID.caption)  'JMY 가입할ID로 체크
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , Cntn.EdtIDPwd.caption2 )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , Cntn.EdtIDPwdCnfr.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""			)  '실명확인번호(서비스에서 조회)		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
		
	Elseif szTranID == "obcsb_efif_060a" Then 'ID 등록	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , g_Acno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , g_Pwd )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" 		, 0 , g_szList(8) ) 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" 	, 0 , "1" ) ' 개인
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 		, 0 , Cntn.EdtID.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" 		, 0 , Cntn.EdtIDPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , "2" ) '지점개설
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID == "obacp_comm_004r" Then '고객연락처설정
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
	
	ElseIf szTranID == "obcsb_efif_220r" Then 'ID 중복 체크
		sIDDupChk = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_ABLE_YN" , 0)
		If sIDDupChk == "Y" then
			Cntn.EdtID.SetResultLabel("1", "complete", "사용 가능한 ID입니다.", "Cntn")
			
			'accordion 적용
			funcIDPwdAcrd(1)
			
			g_IDYn = "Y"
			'키패드를 조금 늦게 올린다.
			'Cntn.EdtIDPwd.SetShowKeypad(true)
			Form.SetTimerEvent2("8888", 1, 0.3)
		Else
			g_IDYn = "N"
			szDataMsg 	= DATAMANAGER.GetDataMsgText( szTranID )
			szSubMsg	= DATAMANAGER.GetDataMsgSubText(szTranID)
			If Len(szSubMsg) == 0 Then
				Cntn.EdtID.SetResultLabel("1", "error", szDataMsg, "Cntn")
			Else
				Cntn.EdtID.SetResultLabel("1", "error", szDataMsg & "(" & szSubMsg & ")", "Cntn")
			End If
		End If
	ElseIf szTranID == "obacp_comm_058r" Then
		g_IDPwdYn = "Y"
'		funcBtnSet(True)

	ElseIf szTranID == "obcsb_efif_060a" Then 'ID 등록	
		'Form.SetSharedData("BDM_ELFN_ID"  , Cntn.EdtID.caption)
		Form.SetSharedData("KAKAO_USERID" , Cntn.EdtID.caption)		
		
		'20230308 OpenNextPopup이 현재 화면 닫고 다음화면 호출해주는 api라 닫고 호출할 필요 없이 바로 호출하면 된다함(이은섭대리확인)
		g_HomeYn = "N"
		'Form.CloseForm() 'Form_OnFormClose 이벤트에서 완료 팝업 처리
		
'		rslt_data = "85230" & "☆" & "ID 등록" & "☆" & "Y" & "☆" & "R" & "☆" & Cntn.EdtID.caption & "☆" & "완료"
		Form.OpenNextPopup("mbact73000_p1", Cntn.EdtID.caption, "")		
	End If

	funcBtnSet()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID == "obacp_comm_058r" Then 'OTP비밀번호 유효성
		'Cntn.EdtIDPwdCnfr.SetResultLabel("1", "error", szErrMsg&"["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "cntnInput")
		Cntn.EdtIDPwdCnfr.SetResultLabel("1", "error", szErrMsg&"["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "Cntn")
		g_IDPwdYn = "N"

'		funcBtnSet(False)

	ElseIf szTranID == "obcsb_efif_060a" Then 'ID 등록
		rslt_data = "85230" & "☆" & "ID 등록" & "☆" & "N" & "☆" & "R" & "☆" & szErrMsg & "☆" & DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
	End If

	funcBtnSet()
End Sub

