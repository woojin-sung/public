	If Len(Trim(Cntn.EdtID.caption)) > 0 Then
		Cntn.EdtID.SetResultLabel("0", "complete", "", "Cntn")
	End If
End Sub

'============================================================================
Sub Cntn_EdtID_OnEditComplete()
	If Len(Trim(Cntn.EdtID.Caption)) > 0 Then
		If funcStrChk(Trim(Cntn.EdtID.Caption), "ID") Then
			DATAMANAGER.RequestTranData("obcsb_efif_220r") 'ID 중복 여부 검사
		Else
			Cntn.EdtID.SetResultLabel("1", "error", g_HelpMsg, "Cntn")
			g_IDYn = "N"
		End If
	Else
		Cntn.EdtID.SetResultLabel("1", "error", "ID를 입력하세요.", "Cntn")
		g_IDYn = "N"
	End If
End Sub

