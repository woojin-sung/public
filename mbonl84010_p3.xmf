'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szURL
	
	szURL = "http://dmcmobile.koscom.co.kr/meritz/clause_total_etc.html"
	
	web01.viewtype = 0
	web01.urlpath = szURL
	
	
	Form.SetScreenName("기타동의사항")
End Sub


'============================================================================
'btnOk01_OnClick
'============================================================================
Sub btnOk01_OnClick()
	
	if chkAgree01.checkstate <> "1" then
		Form.ShowAlert("알림", "내용에 동의해주세요")
	else 
		Form.SendReturnToParent("ETCAGREE", sData)
		Form.CloseForm()
	end if 
End Sub

