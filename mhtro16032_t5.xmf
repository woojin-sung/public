Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1682_001r" then
		dim nDataCnt
		nDataCnt = 44
		
		for i = 0 to nDataCnt - 1
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" ,i ,"EN")
