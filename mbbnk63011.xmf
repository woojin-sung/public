<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="63010" scrname="원화이체 분기 화면" version="2" writer="김성준" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LINKFORM name="LinkForm0" ly_vert="0,0,375,647,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="752" _ulen="726" >
--===========================================================================
' 간편모드 브릿지 화면 20251104 KSJ
--===========================================================================

Dim g_szSimpleMode
g_szSimpleMode = "0"

'============================================================================
Sub Form_OnFormInit()
	g_szSimpleMode = Form.GetEnvData("common.simplemode")
	
	If g_szSimpleMode == "1" Then '간편모드
		LinkForm0.linkfile = "mbbnk63010_sm"
	Else
		LinkForm0.linkfile = "mbbnk63010"
	End If

End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "Close_Parent" Then
		Form.CloseForm()
	End If
End Sub
	</SCRIPT_INFO>
</ROOT>