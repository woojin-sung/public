'============================================================================
' 01.화면명 	: 오픈뱅킹 전체 계좌조회
' 02.화면설명	: 오픈뱅킹 전체 계좌조회
' 03.작성	: 2020.10.15
'============================================================================

'============================================================================
Sub Form_OnFormInit()
	sUserID		= Form.GetSharedData( "&USER_ID"		, false )	'사용자ID
	
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE"   	, 0, "2"  	) '2:출금동의계좌 그외 전체
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE"  , 0, "A"  	) 'A :전체
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID"   			, 0, sUserID  ) 
	
	DATAMANAGER.RequestTranData("obtss_opnf_008r") '오픈뱅킹_타행계좌내역조회
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID) '내계좌(메리츠)
	Dim szCd, szAccNo , szAccNm , szBank , szData	
	if lRow > -1 then
	  szCd        = Grid0.GetCellData("bd_cell3",		lRow)
	  szAccNo     = Grid0.GetCellData("bd_cell2" ,	lRow)
	  szBank      = Grid0.GetCellData("bd_cell1" ,	lRow)	
	  szAgree     = Grid0.GetCellData("bd_cell4" ,	lRow)	
	  
	  '  전달내용/은행코드/계좌번호/은행명/출금동의여부
	  szData = "전체계좌" & "★" & szCd & "★" & szAccNo & "★" & szBank & "★" & szAgree
        
	  Form.SendReturnToParent("62020_T2", szData)
	  Form.CloseForm()
	end if  
End Sub

'============================================================================
Sub imgClose_OnClick()
	'임시데이터
	
	Form.SendReturnToParent("62020_T2", szData )
	Form.CloseForm()
End Sub

