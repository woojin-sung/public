'============================================================================
' 01.화면명 	: 미니팝업
' 02.화면설명	: 미니팝업
' 03.작성		: 2016.02.18
' 16.02.18	 KMC	: Onforminit 오류 수정, 5개 버튼 이미지 및 사이즈 세팅
' 16.03.03	 KMC	: 각버튼당 CloseForm 추가
' 16.03.07 	 KMC : 6자 이상일시 폰트사이즈 조절기능추가
' 21.08.26	 LHR : 현재가버튼에 차트 추가
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim IMAGE_NAME
Dim CONTANINER_NAME
Dim TYPE_MAX_COUNT
Dim IMAGE_ARROW_HEIGT

IMAGE_ARROW_HEIGT = 5
IMAGE_NAME = "Image0"
CONTANINER_NAME  = "Container"
TYPE_MAX_COUNT = 5

Dim ISCD
Dim g_sPopupType
Dim g_szGbn
Dim g_szItemCode
Dim g_szItemMarket
Dim g_szIndexName
Dim g_sCd
Dim g_szAble

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()	
	listInfo = Split ( Form.GetOpenLinkData() , "★" , 0 , 0 )
	
	if ( #listInfo == 1 ) then
		exit sub
	end if
	
	nYPos	 	= Int(listInfo[0])
	nHeight	 	= Int(listInfo[1])
'	g_sPopupType	= listInfo[2]
	g_sCd		= listInfo[2]
	g_szGbn  	= listInfo[3]'1:매도/2:매수
	g_szAble		= CInt(listInfo[4])'가능수량

	if g_szGbn == "2" then
		Button5.caption = "추가매수"
		Button5.btnimage = "btn_etc10.9"
	else
		Button5.caption = "추가매도"
		Button5.btnimage = "btn_etc11.9"
	end if

	if nYPos + 64 > 550 then'위로 떠야하는 경우
		imgBg.imgpath = "btn_link_bg2.9"
		Button6.top = nYPos - 64 + 12
		Button5.top = nYPos - 64 + 12
		Button7.top = nYPos - 64 + 12
		imgBg.top = nYPos + 6 - 64 + 2
	else'아래로 떠야하는 경우
		Button6.top = nYPos + 64 - 2
		Button5.top = nYPos + 64 - 2
		Button7.top = nYPos + 64 - 2
		imgBg.top = nYPos - 9 + 64 - 2
	end if
	
End Sub

'============================================================================
'BtnClose_OnClick
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Button5_OnClick()
	'추가매수 추가매도
	'g_szGbn 1:매도/2:매수
	Form.SendReturnToParent("MOVEPOPUP_MORE" , g_szGbn.."★"..g_sCd)
	Form.CloseForm()
End Sub

'============================================================================
Sub Button6_OnClick()
	'현재가
	Form.SendReturnToParent("MOVEPOPUP_HYON" , g_sCd)
	Form.CloseForm()
End Sub

'============================================================================
Sub Button7_OnClick()
	'청산
	Form.SendReturnToParent("MOVEPOPUP_CHUNGSAN" , g_szGbn.."★"..g_sCd.."★"..g_szAble)
	Form.CloseForm()
End Sub

