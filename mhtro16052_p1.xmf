Dim szData
Dim g_szExid
Dim g_szCode
Dim g_rtChk
Dim g_sCode

szData = {}
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnFormInit()
	if Form.GetOpenLinkData( ) <> null and Form.GetOpenLinkData( ) <> ""	then
		szData = split(Form.GetOpenLinkData( ), "^")		
		Dim sTemp
		sTemp = split(szData[0], "@")
		g_szExid = sTemp[0] '시장구분
		g_szCode = sTemp[1] '종목코드 
		g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExid, false )
		g_sCode = sTemp
		
		nContHeight = 197
		if nContHeight + szData[5] + 45 > 647	then
			Container0.Image0.imgpath = "btn_link_bg2.9"
			Container0.top = szData[5] - 170
			Container0.Table0.top = 0
			Container0.Label0.top = 124
			Container0.Label1.top = 163
			Container0.BtnCurrent.top = 124
			Container0.BtnChart.top = 124
			Container0.BtnGuansim.top = 124
			Container0.BtnMaeDo.top = 124
			Container0.BtnMaeSu.top = 124
			Container0.Label2.top = 0
		else
			Container0.top = szData[5] + 33
		end if
			
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
		DATAMANAGER.RequestTranData("ohhts_6000_002r")
		
	end if
End Sub


'============================================================================
Sub Container0_BtnChart_OnClick()
	if szData[0] <> "" then
	
		Form.SetSharedData( "&ITEM_CODE" , szData[0] )
		Form.SetSharedData( "&ITEM_SYMBOL" , szData[1] )
		Form.SetSharedData( "&ITEM_KORNAME" , szData[2] )
		Form.SetSharedData( "&ITEM_ENGNAME" , szData[3] )		
		Form.SetSharedData( "&ITEM_EXID" , szData[4] )
		
		Dim sTemp, sTemp1, sTemp2
		sTemp = split(szData[0], "@")
		if CInt(sTemp[0]) <> null or CInt(sTemp[0]) <> ""	then
			sTemp2 = sTemp[0]
		else
			'sTemp1 = Right(sTemp[0], (Len(sTemp[0]) - 1))
			'sTemp2 = Transform_Code(Trim(sTemp1))
			sTemp2 = Form.GetItemCodeInfo(szData[0], "exchcode3")
		end if
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sTemp2.."@"..sTemp[1].."★"..szData[2].."★".."", "" )		
		Form.OpenScreen("16020", "")
		Form.CloseForm( )
		
	end if
End Sub

'============================================================================
Sub Container0_BtnCurrent_OnClick()
	if szData[0] <> "" then
	
		Form.SetSharedData( "&ITEM_CODE" , szData[0] )
		Form.SetSharedData( "&ITEM_SYMBOL" , szData[1] )
		Form.SetSharedData( "&ITEM_KORNAME" , szData[2] )
		Form.SetSharedData( "&ITEM_ENGNAME" , szData[3] )		
		Form.SetSharedData( "&ITEM_EXID" , szData[4] )

		Dim sTemp, sTemp1, sTemp2
		sTemp = split(szData[0], "@")
		if CInt(sTemp[0]) <> null or CInt(sTemp[0]) <> ""	then
			sTemp2 = sTemp[0]
		else
			'sTemp1 = Right(sTemp[0], (Len(sTemp[0]) - 1))
			'sTemp2 = Transform_Code(Trim(sTemp1))
			sTemp2 = Form.GetItemCodeInfo(szData[0], "exchcode3")
		end if
		
		szName = Form.GetItemCodeInfo(szData[0], "name")
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szData[0].."★"..szName.."★".."", "" )
		Form.OpenScreen("16000", "")
		Form.CloseForm( )
		
	end if
End Sub

