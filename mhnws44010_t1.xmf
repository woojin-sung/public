'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' rdo0_OnClick(nIndex) : 국가별 Index값 설정
'============================================================================
Sub rdo0_OnClick(nIndex)

	g_nNational = nIndex
	
	TableClear()
	
	call SetTable(g_nNational)
	
End Sub
'============================================================================
' Form_OnFormInit() : 국가 초기선택값 설정 및 테이블에 값 세팅
'============================================================================
Sub Form_OnFormInit()

	g_nNational = 0
	
	TableClear()
	
	call SetTable(g_nNational)
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranData(szTranID) : 각 셀에 지수 데이터값 세팅
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	if szTranID == "ohhts_1682_001r" then
		for i = 0 to 2
			if DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i) == "5" then
				tbl0.SetCellString(i,1, -DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
			else
				tbl0.SetCellString(i,1, DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
			end if
			tbl0.SetCellString(i,2, DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i))
			tbl0.SetCellString(i,3, DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , i))
			tbl0.SetCellString(i,4, RIGHT(DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE" , i), 4))
		next
		
		l = 0
		for j = 0 to 2
			for k = 0 to 3
				if g_nNational == 0 then
					DATAMANAGER.SetDataValue( 1 , "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB" , l , g_tUSCode(j) )
				else
					DATAMANAGER.SetDataValue( 1 , "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB" , l , g_tASCode(j) )
				end if
				l = l + 1
			next
		next
	
	elseif szTranID == "ohhts_news_008r" then
	
		Dim szText
		Dim szTemp
		
		szText = ""
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_news_008r", "OutBlock1") - 1
			szTemp = DATAMANAGER.GetDataValue( 0, "ohhts_news_008r", "OutBlock1", "FID_NEWS_CNTT" , i)
			szText = szText & szTemp
		next
			web0.loaddata = "<html><body>"&szText&"</body></html>"
	end if
	
	DATAMANAGER.RequestTranData( "ohhts_ovrs_nmix" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveRealComplete(szTranID) : 실시간 TR 출력 세팅함수에 연결
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szDiv
	
	if szTranID == "ohhts_ovrs_nmix" then
		szDiv = DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_SYMB" , 0)
		
		Call SetBC(szDiv)
	end if
	
End Sub
'============================================================================
' btn0_OnClick() : 상관관계 버튼시 상관관계 관련 정보로 팝업창 띄움
'============================================================================
Sub btn0_OnClick()
	Dim szData
	
	if g_nNational == 0 then
		szData = "US" & "☆" & "2" & "☆" &"미국"
	elseif g_nNational == 1 then
		szData = "CH" & "☆" & "2" & "☆" &"중국"
	elseif g_nNational == 2 then
		szData = "JP" & "☆" & "2" & "☆" &"일본"
	elseif g_nNational == 3 then
		szData = "TW" & "☆" & "2" & "☆" &"대만"
	end if
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
	
End Sub
'============================================================================
' btn1_OnClick() : 특징주 버튼시 상관관계 관련 정보로 팝업창 띄움
'============================================================================
Sub btn1_OnClick()
	Dim szData
	
	if g_nNational == 0 then
		szData = "US" & "☆" & "3" & "☆" &"미국"
	elseif g_nNational == 1 then
		szData = "CH" & "☆" & "3" & "☆" &"중국"
	elseif g_nNational == 2 then
		szData = "JP" & "☆" & "3" & "☆" &"일본"
	elseif g_nNational == 3 then
		szData = "TW" & "☆" & "3" & "☆" &"대만"
	end if

	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
End Sub
'============================================================================
' tbl0_OnClick(lRow , lColumn)
'============================================================================
Sub tbl0_OnClick(lRow , lColumn)
	Dim szData
	Dim szCode
	Dim szMarket
	Dim szName
	
	szCode = grd0.GetCellData("bd_cell0", lRow)
	szMarket = grd0.GetCellData("bd_cell1", lRow)
	szName = grd0.GetCellData("bd_cell2", lRow)
	
	'종목코드, 시장구분, 한글명
	szData = szCode & "★" & szMarket & "★" & szName
	Form.OpenFramePopup("mhidx42040_p1" , szData , sPosInfo)
	'해외지수 화면 호출
	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	Form_OnFormInit()
	
End Sub

