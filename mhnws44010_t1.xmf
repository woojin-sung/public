	<SCRIPT_INFO _len="17038" _ulen="16304" >
'============================================================================
' 01. 화 면 명 : 시황브리핑_해외시장
' 02. 화면설명 : 시황브리핑_해외시장
' 03. 작    성 : 2016. 01. 28. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNational	'국가별 선택 인덱스값
Dim g_tUS, g_tAS	'미국,아시아 지수 명칭
Dim g_tUSCode, g_tASCode	'미국, 아시아 시장 구분 코드

g_tUS = {"DOW","NASDAQ","S&P 500"}
g_tAS = {"상해종합","홍콩항셍H","니케이","대만가권"}
g_tUSCode = {"DJI@DJI","NAS@IXIC", "SPI@SPX"}
g_tASCode = {"SHS@000001","HSI@HSI","NII@NI225","TWS@TI01"}
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Function TableClear() : Table Clear
'============================================================================
Function TableClear()

	tbl0.SetCellString( 0, 0, "")
	tbl0.SetCellString( 0, 1, "")
	tbl0.SetCellString( 0, 2, "")
	tbl0.SetCellString( 0, 3, "")
	tbl0.SetCellString( 0, 4, "")
	tbl0.SetCellString( 1, 0, "")
	tbl0.SetCellString( 1, 1, "")
	tbl0.SetCellString( 1, 2, "")
	tbl0.SetCellString( 1, 3, "")
	tbl0.SetCellString( 1, 4, "")
	tbl0.SetCellString( 2, 0, "")
	tbl0.SetCellString( 2, 1, "")
	tbl0.SetCellString( 2, 2, "")
	tbl0.SetCellString( 2, 3, "")
	tbl0.SetCellString( 2, 4, "")

End Function
'============================================================================
' Function SetTable(nIndex) : radio 버튼 선택 결과에 따른 테이블값 세팅
'============================================================================
Function SetTable(nIndex)
	
	for i = 0 to 2
		Select Case nIndex	'나라별 선택값에 따라 지수, 뉴스 입력
			Case 0
				tbl0.SetCellString( i, 0, g_tUS(i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "US" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
							
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "N" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tUSCode(i) )
				
'				DATAMANAGER.RequestTranData( "ohhts_news_008r" )
			Case 1
				tbl0.SetCellString( i, 0, g_tAS(i))
				
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "CH" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
				
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "N" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tASCode(i) )
				
'				DATAMANAGER.RequestTranData( "ohhts_news_008r" )
			Case 2
				tbl0.SetCellString( i, 0, g_tAS(i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "JP" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
				
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "N" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tASCode(i) )
				
'				DATAMANAGER.RequestTranData( "ohhts_news_008r" )
			Case 3
				if i == 2 then
				tbl0.SetCellString( i, 0, g_tAS(3))
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "TW" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
				
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 2 , "N" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , 2 , g_tASCode(3) )
				else
				tbl0.SetCellString( i, 0, g_tAS(i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "TW" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
				
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "N" )
				DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tASCode(i) )
				end if
'				DATAMANAGER.RequestTranData( "ohhts_news_008r" )
		End Select
	next
	
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
	DATAMANAGER.RequestTranData( "ohhts_1682_001r" )
end Function

'============================================================================
' Function SetBC(szNationCode) : 실시간 TR 연결값 세팅
'============================================================================
Function SetBC(szNationCode)
	'20221228 jipark 반복코드 삭제- 소스 단순화
    nUpdateRow = -1
	Select Case szNationCode
		Case g_tUSCode(0)		'DOW
            nUpdateRow = 0
		Case g_tUSCode(1)		'NASDAQ
            nUpdateRow = 1
		Case g_tUSCode(2)		'S&P 500
            nUpdateRow = 2
		Case g_tASCode(0)		'상해종합
            nUpdateRow = 0
		Case g_tASCode(1)		'홍콩항셍H
            nUpdateRow = 1
		Case g_tASCode(2)		'니케이
            nUpdateRow = 2
		Case g_tASCode(3)		'대만가권
            nUpdateRow = 2
	End Select

    if nUpdateRow = -1 then
        exit Function
    end if

    nCodeIndex = -1
    strCodeName = tbl0.GetCellString(nUpdateRow, 0)
    for i = 0 to UBound(g_tAs)-1
        if strCodeName = g_tAS(i) then	' 니케이 or 대만가권이 같은 row라서 다른곳(나라에 맞게 실시간 등록하게) 수정을 안하고 종목명으로 row찾도록 수정함.
            nCodeIndex = i
            exit for
        end if
    next

    if nCodeIndex < 0 then
	    exit Function
    end if
    
	'증감 기호에 따라 현재가 전일대비 증감색 표시
	if DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
	    tbl0.SetCellString( nUpdateRow , 1, -DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRPR2" , 0))
	else
	    tbl0.SetCellString( nUpdateRow , 1, DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRPR2" , 0))
	end if
	tbl0.SetCellString( nUpdateRow , 2, DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
	tbl0.SetCellString( nUpdateRow , 3, DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
	tbl0.SetCellString( nUpdateRow , 4, RIGHT( DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_DATE" , 0), 4))
    
' 아래는 원본 소스
'	Select Case szNationCode
'		Case g_tUSCode(0)
'			'증감 기호에 따라 현재가 전일대비 증감색 표시
'			if DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
