'============================================================================
' 화 면 명 : 해외CFD_주문_정산금팝업
' 화면설명 : 해외CFD_주문_정산금팝업
' 작    성 : 2021.12
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_tData
Dim g_sCRCD
Dim g_tblArray
g_tblArray = {"tblData", "tblData0", "tblData1", "tblData2","tblData3"}
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' RequestData
'============================================================================
Function RequestData()

	DATAMANAGER.ClearInputData(0, "obtre_cntg_004r")
	
'	tblData.SetCellString(0, 1, "")
'	tblData.SetCellString(1, 1, "")
'	tblData.SetCellString(2, 1, "")
'	tblData.SetCellString(3, 1, "")
'	
'	szDecimal = g_tData(7)
'	sMask = "0,0,,,0,,"..szDecimal..",1,1,2,0"
'	
'	tblData.SetCellMaskInfo(0, 1, sMask)
'	tblData.SetCellMaskInfo(1, 1, sMask)
'	tblData.SetCellMaskInfo(2, 1, sMask)
'	tblData.SetCellMaskInfo(3, 1, sMask)
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "ACNO"           				, 0, g_tData(0))	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "ASNO"           				, 0, g_tData(1))	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "FEE_MDIA_GRP_CODE" 			, 0, szMediaCode)
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"	, 0, g_tData(3))	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "DEAL_CLS_CODE"				, 0, g_tData(5))
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "ODER_OQTY"					, 0, g_tData(6))	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "CFD_ODER_PRC"				, 0, g_tData(7))	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "ISCD"  						, 0, g_tData(2))	
	DATAMANAGER.SetDataValue(0,  "obtre_cntg_004r", "InBlock1", "NEW_CLRN_CLCD"  				, 0, g_tData(8))	
					
	DATAMANAGER.RequestTranData("obtre_cntg_004r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim tData
	Dim szData
	
	szData = Form.GetOpenLinkData()
	
	tData = Split(szData, "★")
	
	'CFD일반/안심계좌 판단
	sAcnoAB = Form.GetSharedData( "CFD_IlbanAnsim", false )		'20230821 SWJ START
	
	if UBound(tData) > 0 then
		g_tData = tData
		
		'lblTitle.caption = "주문 관련 비용 (" .. g_tData(4) .. ")"
		
		if g_tData(8) == "1" then
			if g_tData(5) == "2" then
				'tblData.visible = true	'20230821 SWJ START
				tblData0.visible = false
				tblData1.visible = false
				
				'20230821 SWJ START : 안심계좌일 때 이자 부분 삭제
				if sAcnoAB == "B" then
					tblData.visible = false
					tblData2.visible = true
				else
					tblData.visible = true
					tblData2.visible = false
				end if
				'20230821 SWJ END
				
			elseif g_tData(5) == "1" then
				tblData.visible = false
				'tblData0.visible = true	'20230821 SWJ START
				tblData1.visible = false
				
				'20230821 SWJ START : 안심계좌일 때 이자 부분 삭제
				if sAcnoAB == "B" then
					tblData0.visible = false
					tblData3.visible = true
				else
					tblData0.visible = true
					tblData3.visible = false
				end if
				'20230821 SWJ END
			end if
		elseif g_tData(8) == "2" then
			tblData.visible = false
			tblData0.visible = false
			tblData1.visible = true
		end if
		
		RequestData()
	end if
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
' btnClose2_OnClick : 닫기
'============================================================================
Sub btnClose2_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
' btnReceive_OnClick : 조회
'============================================================================
Sub btnReceive_OnClick()
	RequestData()	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert("알림", szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtre_cntg_004r" then
		szRlov 	 	= DATAMANAGER.GetDataValue(0, "obtre_cntg_004r", "OutBlock1", "CFD_RLOV_INT" , 0)
		szBrngFee 	= DATAMANAGER.GetDataValue(0, "obtre_cntg_004r", "OutBlock1", "CFD_BRNG_FEE" , 0)
		szRlovRnd	= ""
		szBrngFeeRnd	= ""
		
		'이자 데이터 올림처리
		if szRlov ~= "" then
			szRlovRnd = Fix(szRlov) + 1
		end if
		
		if szBrngFee ~= "" then
			szBrngFeeRnd = Fix(szBrngFee) + 1
		end if
		
		DATAMANAGER.SetDataValue(0, "obtre_cntg_004r", "OutBlock1", "CFD_RLOV_INT" , 0, szRlovRnd)
		DATAMANAGER.SetDataValue(0, "obtre_cntg_004r", "OutBlock1", "CFD_BRNG_FEE" , 0, szBrngFeeRnd)
		
		'20230912 SWJ START : 외화 처리 추가
		g_sCRCD = DATAMANAGER.GetDataValue(0, "obtre_cntg_004r", "OutBlock1", "CRCD", 0)
		'20230912 SWJ START
	end if
End Sub

'============================================================================
'20230912 SWJ START : 외화 처리 추가
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_cntg_004r" then
		
		for i = 0 to 4
			if Form.GetCtlProp(g_tblArray(i), "visible") then
				
			   DataSetting(i)
			end if
		next
		
	end if
End Sub
'============================================================================
Function DataSetting(nIndex)
	
	Select Case nIndex
	
	Case 0
		for j = 0 to tblData.rowcount - 1
			szData = tblData.GetCellString(j, 1)
						
			tblData.SetCellString( j, 1, FormatNumber(szData,2).." "..g_sCRCD)
		next
	Case 1
		for j = 0 to tblData0.rowcount - 1
			szData = tblData0.GetCellString(j, 1)
						
			tblData0.SetCellString( j, 1, FormatNumber(szData,2).." "..g_sCRCD)
		next
	Case 2
		for j = 0 to tblData1.rowcount - 1
			szData = tblData1.GetCellString(j, 1)
						
			tblData1.SetCellString( j, 1, FormatNumber(szData,2).." "..g_sCRCD)
		next
	Case 3
		for j = 0 to tblData2.rowcount - 1
			szData = tblData2.GetCellString(j, 1)
						
			tblData2.SetCellString( j, 1, FormatNumber(szData,2).." "..g_sCRCD)
		next
	Case 4
		for j = 0 to tblData3.rowcount - 1
			szData = tblData3.GetCellString(j, 1)
						
			tblData3.SetCellString( j, 1, FormatNumber(szData,2).." "..g_sCRCD)
		next
		
	End Select

End Function
