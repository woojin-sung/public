'============================================================================
' 01. 화 면 명 : 발행어음매매_매도_잔고창
' 02. 화면설명 : 발행어음매매_매도_잔고창
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData				'
Dim g_szList				'
Dim g_szPW				'비밀번호
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	Form.SetScreenName( "발행어음잔고" )
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★") 
	if UBOUND(g_szList) < 1 then
		Exit sub
	End if
	
	g_szPW = Form.GetEncData( g_szList(2) )
	
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_222r", "InBlock1", "ACNO" , 0 , g_szList(0) )		'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_222r", "InBlock1", "ASNO" , 0 , g_szList(1) )		'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_222r", "InBlock1", "PWD" , 0 , g_szPW )				'비밀번호
	
	DATAMANAGER.RequestTranData( "obsan_deal_222r" )
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nFee				'제세금
	
	nFee = 0
	
	if szTranID == "obsan_deal_222r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obsan_deal_222r", "OutBlock1") - 1
			nFee = DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "INTX" , i) + 	'제세금
			DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "RSTX" , i) + 
			DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "SRTX" , i)
		
			grd0.SetCellData( "bd_cell10" , i, nFee)
			
		next
	end if
	
End Sub
'============================================================================
' btnClose_OnClick()
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick()
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID) : 매도 신청시 필요한 값 보냄
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	'종목코드, 종목명, 어음번호, 매수금액, 투자기간, 만기일자, 이자금액, 세금, 출금가능금액, 경과기간
	szData = grd0.GetCellData( "bd_cell7", lRow) & "★" & grd0.GetCellData( "bd_cell0", lRow) & "★" & grd0.GetCellData( "bd_cell11", lRow) & "★" &
	grd0.GetCellData( "bd_cell1", lRow) & "★" &  grd0.GetCellData( "bd_cell8", lRow) & "★" & grd0.GetCellData( "bd_cell12", lRow) & "★" &
	grd0.GetCellData( "bd_cell3", lRow) & "★" & grd0.GetCellData( "bd_cell10", lRow) & "★" & grd0.GetCellData( "bd_cell4", lRow) & "★" &
	grd0.GetCellData( "bd_cell6", lRow)
	
	Form.SendReturnToParent("mbfnp52000_p3" , szData)
	Form.CloseForm()
	
End Sub
'============================================================================
' btnOk_OnClick() : 
'============================================================================
Sub btnOk_OnClick()
	
	'현재 그리드를 누르면 해당 계좌의 정보값이 세팅 되나 확인값을 누르면 가장 위의 항목에 대한 값 세팅으로 해놓음
'	Form.ShowAlert( "Meritz", "종목을 선택해 주세요.")		'추가 문구 필요할 경우 사용
	grd0_OnClickUp( 0 , szCellID)
	
End Sub

