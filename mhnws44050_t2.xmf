	<SCRIPT_INFO _len="11035" _ulen="10537" >
Dim g_sCheckFlag
Dim g_sUserID
Dim g_sSmsMsg

Dim g_sOverFlag   
Dim g_sSmsFlag	'SNS 버튼클릭 플래그
Dim g_sDelFlag	'삭제 버튼클릭 플래그

Dim g_sAllCheckFalg

Dim g_sAppTheme
Dim g_bFirstFlag
'============================================================================
Function setAllCheck() 
	g_sAllCheckFlag = 1
	count = grd01.rowcount
	for i = 0 to count 
		grd01.SetCellData("bd_cell0", i, 1)
	next
End Function
'============================================================================
Function setAllUnCheck() 
	count = grd01.rowcount
	for i = 0 to count 
		grd01.SetCellData("bd_cell0", i, 0)
	next
End Function
'============================================================================
Sub Form_OnFormInit()
	g_sAppTheme = Form.GetEnvData("common.theme")
	if g_sAppTheme = "" or g_sAppTheme = null then
		g_sAppTheme = "white"
	end if
	
	g_sSmsFlag = 0
	g_sDelFlag = 0
	g_sOverFlag = 0
	g_sAllCheckFlag = 0
	
	g_sSmsMsg = "\n----- 뉴스기사 -----\n\n"
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	
	DATAMANAGER.RequestTranData("ohhts_news_005r")
	
	ChkButton0.checkstate = 0
	ChkButton0.visible = false
	
	ButtonOK.visible = false
	
	if g_sAppTheme = "white" then
		ButtonOK.fgcolor = "0"
	elseif g_sAppTheme = "black" then
		ButtonOK.fgcolor = "89"
	end if

	ButtonCancel.visible = false
	Label0.visible = false
	grd01.height = 472
	
	g_bFirstFlag = false
End Sub

'============================================================================
Sub Button1_OnClick()
	if grd01.rowcount = "0" then
		Form.ShowAlert("알림", "MY뉴스가 없습니다.")
		Exit Sub
	end if
	
	grd01.height = 413
	ChkButton0.checkstate = false
	ChkButton0.visible = true

	'삭제 버튼이 클릭된 상태에서 SNS 버튼 클릭 시
	if g_sDelFlag == 1 then
		g_sDelFlag = 0
		g_sOverFlag = 1 '중복 시 체크박스 유지 
		
	    setAllUnCheck()
	    
	    '삭제버튼 포커스 해제
		Image1.imgpath = "ic_delete.9.png"

	end if

	if g_sSmsFlag == 0 then
		g_sSmsFlag = 1
		
		'중복 플래그가 1이면 이미 체크박스 보임상태
		if g_sOverFlag == 0 then
			grd01.SetVisibleCol("bd_cell0", 1)
		end if
		
		'sns버튼 포커스 
		Image2.imgpath = "r_ic_share.9.png"
		
		ButtonOK.visible = true
		ButtonOK.caption = "공유"
		ButtonCancel.visible = true
	end if

End Sub

'============================================================================
Sub Button0_OnClick()
     
	if grd01.rowcount = "0" then
		Form.ShowAlert("알림", "MY뉴스가 없습니다.")
		Exit Sub
	end if
	
	grd01.height = 413
	ChkButton0.checkstate = false
	ChkButton0.visible = true
	
	'sns 버튼이 클릭된 상태에서 삭제버튼 클릭 시
	if g_sSmsFlag == 1 then
		g_sSmsFlag = 0
		g_sOverFlag = 1 '중복 시 체크박스 유지 
		
	    setAllUnCheck()
	    
	    'SNS버튼 포커스 해제
		Image2.imgpath = "ic_share.9.png"
	end if

	if g_sDelFlag == 0 then
		g_sDelFlag = 1
		
		'중복 플래그가 1이면 이미 체크박스 보임상태
		if g_sOverFlag == 0 then
			grd01.SetVisibleCol("bd_cell0", 1)
		end if
		
		'삭제버튼 포커스 
		Image1.imgpath = "r_ic_delete.9.png"
		
		ButtonOK.visible = true
		ButtonOK.caption = "삭제"
		ButtonCancel.visible = true
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "snsshare" Then
		Form.SendSNSLinkage(1, "메리츠 증권", g_sSmsMsg , "")
		g_sSmsMsg = ""
		
		setAllUnCheck()
		grd01.SetVisibleCol("bd_cell0", 0)
		
		g_sOverFlag = 0
		g_sSmsFlag  = 0
		
		Image2.imgpath = "ic_share.9.png"
		
		ChkButton0.checkstate = false
		ChkButton0.visible = false
		
		ButtonOK.visible = false
		ButtonCancel.visible = false
		
		grd01.height = 472
	end if
End Sub


'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
		if g_sSmsFlag = 1 or g_sDelFlag = 1 then
			if g_sAllCheckFlag = 1 then
				g_sAllCheckFlag = 0
				ChkButton0.checkstate = false
			end if
			
			if szCellID <> "bd_cell0" then
				if grd01.GetCellData("bd_cell0", lRow) = "" or grd01.GetCellData("bd_cell0", lRow) = "0"then
					grd01.SetCellData("bd_cell0", lRow, 1)
				elseif grd01.GetCellData("bd_cell0", lRow) == "1" then
					grd01.SetCellData("bd_cell0", lRow, 0)
				end if
			end if
		else
			Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szMsg, szCode, szName

			szTitle			= grd01.GetCellData( "bd_cell7", lRow )	' 제목			-- FID_TITL
			szDate			= grd01.GetCellData( "bd_cell3", lRow )	' 날짜   		-- FID_DATE
			szTime			= grd01.GetCellData( "bd_cell5", lRow )	' 시간    		-- FID_CNTG_HOUR
			szNewCorpName		= grd01.GetCellData( "bd_cell11", lRow )	' 뉴스제공업체명 	-- FID_KOR_ISNM
			szNewKey			= grd01.GetCellData( "bd_cell1", lRow )	' 뉴스키       	-- FID_NEWS_KEY
			szNewsCorpCode	= grd01.GetCellData( "bd_cell2", lRow )	' 뉴스제공업체코드-- FID_NEWS_OFER_ENTP_CODE
			szCode			= grd01.GetCellData( "bd_cell4", lRow )	' 종목코드
			szName			= Form.GetItemCodeInfo(szCode, "name")
	
			szMsg = szTitle & "|" & szDate & "|" & szTime & "|" & szNewCorpName & "|" & szNewKey & "|" & szNewsCorpCode & "|" &  szName
	
			Form.OpenPopup( "mhprc11000_p6" , szMsg, "" )
		end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_news_005r" then
		DATAMANAGER.SetDataValue(0, "ohhts_news_005r", "InBlock1", "FID_USER_ID" , 0 , g_sUserID)
	elseif szTranID == "ohhts_news_004r" then
		bSelect = 0
		for i = 0 to grd01.rowcount-1
			
			if grd01.GetCellData("bd_cell0", i) == "1" then
		
				CellKey = grd01.GetCellData("bd_cell1", i)
				CellDate  = grd01.GetCellData("bd_cell3",i)
				CellHour  = grd01.GetCellData("bd_cell5", i)
			
				DATAMANAGER.SetDataValue(0, "ohhts_news_004r", "InBlock1", "FID_USER_ID", bSelect, g_sUserID)
				DATAMANAGER.SetDataValue(0, "ohhts_news_004r", "InBlock1", "FID_NEWS_KEY", bSelect, CellKey)
				DATAMANAGER.SetDataValue(0, "ohhts_news_004r", "InBlock1", "FID_INPUT_DATE" , bSelect, CellDate)
				DATAMANAGER.SetDataValue(0, "ohhts_news_004r", "InBlock1", "FID_INPUT_HOUR" , bSelect, CellHour)
				DATAMANAGER.SetDataValue(0, "ohhts_news_004r", "InBlock1", "FID_MOD_YN", bSelect, "Y")
				
				bSelect = bSelect + 1
			end if
		next 
	end if
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "DeleteNews" then
		if sRet = "ok" then
			DATAMANAGER.RequestTranData("ohhts_news_004r")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_news_004r" then
		msg = DATAMANAGER.GetDataMsgText(szTranID)
		Form.Toast(0, msg, "") 
		
		setAllUnCheck()
		grd01.SetVisibleCol("bd_cell0", 0)
	    
		g_sOverFlag = 0
		g_sDelFlag = 0
	    
		Image1.imgpath = "ic_delete.9.png"
		ChkButton0.checkstate = false
		ChkButton0.visible = false
		
		ButtonOK.visible = false
		ButtonCancel.visible = false
		
		grd01.height = 472
		
		DATAMANAGER.RequestTranData("ohhts_news_005r")
	elseif szTranID = "ohhts_news_005r" then
		if DATAMANAGER.GetDataCount(0, "ohhts_news_005r","OutBlock1") == 0 then
			grd01.SetClear()
			grd01.visible = false
			Label0.visible = true
		else
			grd01.visible = true
			Label0.visible = false
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "ohhts_news_005r" then
		if DATAMANAGER.GetDataCount(0, "ohhts_news_005r","OutBlock1") == 0 then
			grd01.SetClear()
			grd01.visible = false
			Label0.visible = true
		else
			grd01.visible = true
			Label0.visible = false
		end if
	end if
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	if sCheckState == "1" then
		setAllCheck()
	elseif sCheckState == "0" then
		setAllUnCheck()
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if g_sSmsFlag == 1 then
		count = grd01.rowcount
		bSelect = 0
         g_sSmsMsg = "\n----- 뉴스기사 -----\n\n"
	    for i=0 to count
			if grd01.GetCellData("bd_cell0", i) == "1" then
				bSelect = bSelect + 1
				if bSelect = 1 then
					g_sSmsMsg = g_sSmsMsg & "[" & grd01.GetCellData("bd_cell11", i) & "]\n" & grd01.GetCellData("bd_cell7", i) 
				else
					g_sSmsMsg = g_sSmsMsg & "\n\n[" & grd01.GetCellData("bd_cell11", i) & "]\n" & grd01.GetCellData("bd_cell7", i)
				end if
			end if
		next
     
	     if bSelect == 0 then
			Form.ShowAlert("알림", "선택된 뉴스기사가 없습니다.")
		else
		
			Form.OpenDialog("sharesns2" , "mhnws44050_t2", "")
	     end if
	elseif g_sDelFlag == 1 then
		count = grd01.rowcount
		bSelect = 0
 
	     for i=0 to count
			 if grd01.GetCellData("bd_cell0", i) == "1" then
			     bSelect = bSelect + 1
		     end if
	     next
     
		if bSelect <> 0 then
			Form.MsgBox( "알림" , "선택한 뉴스 " & bSelect & "건을 삭제하시겠습니까?" , "DeleteNews" , 1 )
		else
			Form.ShowAlert( "알림", "선택된 뉴스기사가 없습니다." )
		end if
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()

	grd01.height = 472
	ChkButton0.checkstate = false
	ChkButton0.visible = false
	ButtonOK.visible = false
	ButtonCancel.visible = false
	
	setAllUnCheck()
	grd01.SetVisibleCol("bd_cell0", 0)
	
	g_sOverFlag = 0
	
	if g_sSmsFlag == 1 then
		g_sSmsFlag  = 0
		
		Image2.imgpath = "ic_share.9.png"
	elseif g_sDelFlag == 1 then
		g_sDelFlag  = 0

		Image1.imgpath = "ic_delete.9.png"
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "mhnws44050_p3" then
		if sParam == "Y" then
			DATAMANAGER.RequestTranData("ohhts_news_005r")
			setAllUnCheck() 
			grd01.SetVisibleCol("bd_cell0", 0)
			ChkButton0.checkstate = false
			ChkButton0.visible = false
			
			Image2.imgpath = "ic_share.9.png"
			Image1.imgpath = "ic_delte.9.png"
			ButtonOK.visible = false
			ButtonCancel.visible = false
		
			grd01.height = 472
			g_sSmsFlag = 0
			g_sDelFlag = 0
			g_sOverFlag = 0
		end if
	elseif sEventName == "refresh" then
		'20170529 NOHES START : 초기 팝업 불러오기
		sCheck = Form.LoadConfigData("KeywordNews", "MyPopup")
		
		if sCheck <> "1" And g_bFirstFlag == false then
			g_bFirstFlag = true
			Form.OpenPopup("mhnws44050_p5","2","")
		end if
		'20170529 NOHES END
	end if 
End Sub

'============================================================================
Sub Button2_OnClick()
	ButtonCancel_OnClick()
	Form.OpenPopup("mhnws44050_p5" , "2★Click" , "")
End Sub

