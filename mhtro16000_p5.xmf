Function Process_Tran_ohhts_6000_001r()
	contMain.lblPrc.visible = true
	contMain.lblSign0.visible = true
	contMain.lblDiff0.visible = true
	contMain.lblRate0.visible = true
	contMain.lblConvAmt.visible = true
	contMain.lblVol0.visible = true
	
	sEtfEtn 	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ETF_TYPE_CODE", 0) ' ETF여부
	sLvrg 	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FID_LVRG", 0) ' 레버리지
	
	szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" , 0)
	Change_AttrColor(szAttr)
	
	if sEtfEtn = "001" then
		contMain.lblItemInfo1.caption = "ETF(" & FormatNumber(sLvrg,1) & ")"
	elseif sEtfEtn = "002" then
		contMain.lblItemInfo1.caption = "ETN(" & FormatNumber(sLvrg,1) & ")"
	end if

	szSub = contMain.lblItemInfo1.caption
	if szSub == "" then
		szData = g_sCode & " | " & Transform_Exid(g_sExid3)
	else
		szData = g_sCode & " | " & Transform_Exid(g_sExid3) & " | " & szSub
	end if
	
	
	DisplaySetting_ItemSubInfo(szData, g_isTradingSuspend, g_isSellOnly, g_isPTP)

	
	Request_Real_ohhts_exst_cntg()
End Function

Function Process_Tran_ohhts_6000_001r_1()
	sEtfEtn 	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r_1", "OutBlock1", "FIDX_ETF_TYPE_CODE", 0) ' ETF여부
	sLvrg 	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r_1", "OutBlock1", "FID_LVRG", 0) ' 레버리지
	
	szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR" , 0)
	Change_AttrColor(szAttr)
	
	if sEtfEtn = "001" then
		contMain.lblItemInfo1.caption = "ETF(" & FormatNumber(sLvrg,1) & ")"
	elseif sEtfEtn = "002" then
		contMain.lblItemInfo1.caption = "ETN(" & FormatNumber(sLvrg,1) & ")"
	end if

	szSub = contMain.lblItemInfo1.caption
	if szSub == "" then
		szData = g_sCode & " | " & Transform_Exid(g_sExid3)
	else
		szData = g_sCode & " | " & Transform_Exid(g_sExid3) & " | " & szSub
	end if
	
	DisplaySetting_ItemSubInfo(szData, g_isTradingSuspend, g_isSellOnly, g_isPTP)
End Function

'==============================================
' 해외주식 현재가(주간) 조회
'==============================================
Function Request_Tran_ohhts_6000_017r()
	contMain.lblPrc.visible = false
	contMain.lblSign0.visible = false
	contMain.lblDiff0.visible = false
	contMain.lblRate0.visible = false
	contMain.lblConvAmt.visible = false
	contMain.lblVol0.visible = false
	
