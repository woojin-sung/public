Function Request_Tran_obtre_comm_024r()
	TblCFD.SetCellString(0, 1, "")
	TblCFD.SetCellString(1, 1, "")
	TblCFD.SetCellString(2, 1, "")
	
	TblCFD0.SetCellString(0, 1, "")		
	TblCFD0.SetCellString(1, 1, "")		
	TblCFD0.SetCellString(2, 1, "")
	TblCFD0.SetCellString(3, 1, "")
	
	DATAMANAGER.ClearInputData(false, "obtre_comm_024r")
	
	szToday = Form.GetSharedData("&HOST_DATE", 0 )
	
	DATAMANAGER.SetDataValue( false, "obtre_comm_024r", "InBlock1", "ISNM" , 0 , g_sCode.."."..g_sExid )
	DATAMANAGER.SetDataValue( false, "obtre_comm_024r", "InBlock1", "STND_DATE" , 0 , szToday )
	
	DATAMANAGER.RequestTranData("obtre_comm_024r")
End Function

Function Process_Tran_obtre_comm_024r()
	cfd_buy = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "BYOV_ABLE_ACNT_CLCD" , 0 )	
	cfd_sell = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "SELN_ABLE_ACNT_CLCD" , 0 )	
	cfd_tax = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "TRNF_INCM_TXTN_CLCD" , 0 )
	
	'비과세
	if cfd_tax = "0" or CInt(cfd_tax) = 0 then
		cfd_tax = "비과세"
	'과세 (1일 때이지만, 과세가 기본이라 함)
	else
		cfd_tax = "과세"
	end if
	
	if cfd_sell == "" then
		cfd_sell = "불가"
	end if
	
	if cfd_buy == "" then
		cfd_buy = "불가"
	end if
	

	TblCFD.SetCellString(0, 1, cfd_buy)
	TblCFD.SetCellString(1, 1, cfd_sell)
	TblCFD.SetCellString(2, 1, cfd_tax)		
	
	TblCFD0.SetCellString(0, 1, cfd_buy)		
	TblCFD0.SetCellString(1, 1, cfd_sell)	
	TblCFD0.SetCellString(3, 1, cfd_tax)
	
	'신규매도일 때 증거금율 무조건 100%
	if g_sCurrentTab == 1 or g_sCurrentTab == "1" then
		if g_szRdoGbn == "" or g_szRdoGbn == "0" then
			TblCFD0.SetCellString( 2, 1, "100")
		end if
	end if

End Function

Function Request_Tran_obtre_comm_004r()
	DATAMANAGER.ClearInputData(false, "obtre_comm_004r")
	
	DATAMANAGER.SetDataValue( false, "obtre_comm_004r", "InBlock1", "ACNO" , 0 , g_ACNO )
	DATAMANAGER.SetDataValue( false, "obtre_comm_004r", "InBlock1", "ASNO" , 0 , g_ASNO )
	
	DATAMANAGER.RequestTranData("obtre_comm_004r")
End Function

Function Process_Tran_obtre_comm_004r()
	szAcnoAB = DATAMANAGER.GetDataValue( 0, "obtre_comm_004r", "OutBlock1", "CFD_MARG_GRAD_CODE" , 0 ) 	'A:일반, B:안심
	Form.SetSharedData("CFD_IlbanAnsim" , szAcnoAB)'20230913 htw start 일반 안심 shared 추가
	if szAcnoAB = "A" then
		TblCFD.visible = false
		TblCFD0.visible = true	
		contMain.imgCfdBg.height = 65
	else
		TblCFD.visible = true
		TblCFD0.visible = false
		contMain.imgCfdBg.height = 53
	end if
End Function
