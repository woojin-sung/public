'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID = "ohhts_exst_mko2" then
		szMktCd = DATAMANAGER.GetDataValue(1, "ohhts_exst_mko2", "OutBlock1", "FIDR_OVRS_STCK_MRKT_CLS_CODE" , 0)
		szMKOP = DATAMANAGER.GetDataValue(1,  "ohhts_exst_mko2", "OutBlock1", "FIDR_OVRS_MKOP_CLS_CODE", 0)

		if szMktCd == g_szMktCd then
			g_szMktOpClsCd = szMKOP
			Convert_MktOpInfo(g_szMktOpClsCd)
			
			DisplaySetting_MktOperation(g_szMktOp, g_isMktClosed, g_szSubMktOp, g_szBaseDate, g_isHoliday)
			
			Request_MktOp(g_szMktOpClsCd)
			Form.triggerEvent("#", "CHANGE_MKTOP", g_szMktOpClsCd)
		end if
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	'주간장 
	if  szTranID = "ohhts_5041_007r" then	
'		nCnt = DATAMANAGER.GetDataCount(false, szTranID , "OutBlock2" )
'		msgbox nCnt
		if g_szMktOpClsCd == "001" or g_szMktOpClsCd == "002" then
			sPRPR 			= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRPR" , 0)
			sPRDY_VRSS_SIGN 	= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRDY_VRSS_SIGN" , 0)
			sPRDY_CTRT 		= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRDY_CTRT" , 0)
			sACML_VOL 		= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_ACML_VOL" , 0)
			
			DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRPR"				, 0 , sPRPR)
			DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRDY_VRSS_SIGN"	, 0 , sPRDY_VRSS_SIGN)
			DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRDY_CTRT"		, 0 , sPRDY_CTRT)
			DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_ACML_VOL"			, 0 , sACML_VOL)
		end if
	end if
End Sub


'============================================================================
' 20240610 LES START 거래안내 팝업 로직 추가
'============================================================================
Sub contMain_lblItemInfo2_OnClick()
	if trim(contMain.lblItemInfo2.caption) == "시장안내" then
		Dim sLinkData
		sLinkData = ""
		
		'---------------------------------------
		'뉴욕(0321)/아멕스(0066)/나스닥(0537)
		'---------------------------------------
		if g_sExid == "NY" or  g_sExid == "AX" or g_sExid == "OQ" then
			
			sLinkData = "USA"
		
		'---------------------------------------
		'심천(0214)/상해(0215)
		'---------------------------------------
		elseif g_sExid == "SH" or g_sExid == "SZ" then
		
			sLinkData = "CHINA"
		
		'---------------------------------------
		'홍콩(0104)
		'---------------------------------------
		elseif g_sExid == "HK" then
			
			sLinkData = "HONGKONG"
		
		'---------------------------------------
		'일본(0106)
		'---------------------------------------
		elseif g_sExid == "JP" then
		
			sLinkData = "JAPAN"
		
		end if
		
		if sLinkData <> "" then
			Form.OpenPopupAnimation("mhtro16100_p30", sLinkData, "", "2")
		end if
		
	elseif trim(contMain.lblItemInfo2.caption) == "유의사항" then	'16061: 예약주문
		Form.OpenFramePopup("mhtro16061_p3" , "" , "")
	end if
	
End Sub

