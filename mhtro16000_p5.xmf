Function Request_Tran_ohhts_5041_007r()
	contMain.ChartEx1.SetJisuCode(g_sCode)
	
	DATAMANAGER.ClearInputData(false, "ohhts_5041_007r")
	
	g_szToday = Form.GetSharedData( "&HOST_DATE", 0 )
	
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_sCode )
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_sExid)
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
	
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_OVRS_ISCD" , 0 , g_sCode )
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_COND_MRKT_CLS_CODE" , 0 , g_sExid)
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
	
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, "300" )
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_DATE1" ,0, "g_szToday")	
	DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"N")
	
	if g_szMktOpClsCd == "001" or g_szMktOpClsCd == "002" then
		DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_MKOP_CLS_CODE" , 0,"6")
	else
		DATAMANAGER.SetDataValue( false, "ohhts_5041_007r", "InBlock2", "FID_INPUT_MKOP_CLS_CODE" , 0,"7")
	end if
	
	DATAMANAGER.RequestTranData("ohhts_5041_007r")
End Function

