Sub Form_OnFormInit()
	' 컨트롤 초기설정
	Init_Control()
	
End Sub

'==============================================
' Form_OnFormClose
'==============================================
Sub Form_OnFormClose()
	' 장운영 정보 실시간 해제
	Cancel_Real_MarketOperation()
End Sub

'==============================================
' Form_OnTriggerEvent
'==============================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RequestData"	then
		if sParam == ""  then
			exit Sub
		end if
		
		g_szItemCode = sParam
		arrTemp = split(sParam, "@")
		
		nArrCnt = #arrTemp
		
		'종목코드 정합성 체크
		if Cint(nArrCnt) < 2 then
			exit Sub
		end if 
		
		g_sExid 		= arrTemp[0] '시장구분
		g_sCode 		= arrTemp[1] '종목코드 
		g_sNation 	= Form.GetItemCodeInfo(g_szItemCode, "ovsnation") '국가구분 코드
		g_sExid3 	= Form.GetItemCodeInfo(g_szItemCode, "exchcode3") '거래소 구분코드
		
		g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
		
		contMain.lblItemInfo0.caption = g_sCode & " | " & Transform_Exid(g_sExid3)
		g_szItemInfo = ""
		g_szItemInfo = g_sCode & " | " & Transform_Exid(g_sExid3)

		' 장운영 정보 실시간 취소
		Cancel_Real_MarketOperation()
		
		'실시간 서비스 등록 해제
		Cancel_Real_Total()
		
		'장운영 정보 조회
		Request_Tran_obsim_oscm_331r()
		
		If g_szScreenNo = "16100" or g_szScreenNo = "16200" or g_szScreenNo = "16210" or g_szScreenNo = "16220"  then	
			 Request_Tran_obtre_comm_024r()
		End if
		
	'일반계좌인 경우만 증거금율 표출
	elseif sEventName == "16200_cfdmgrt" then
		
		Dim sTemp
		sTemp = split(sParam, "@")
		
		if Ubound(sTemp) < 2 then
			exit sub
		end if		
		
		g_ACNO = sTemp[0]
		g_ASNO = sTemp[1]
		g_sCurrentTab = sTemp[2]	
		
		if CInt(#sTemp) > 3 then
			g_szRdoGbn = sTemp[3]
		end if
		
		If g_szScreenNo = "16100" or g_szScreenNo = "16200" or g_szScreenNo = "16210" or g_szScreenNo = "16220"  then		
			 Request_Tran_obtre_comm_024r()
		End if

		Request_Tran_obtre_comm_004r()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_comn_010r"	then
		Process_Tran_obtro_comn_010r()
		
	elseif szTranID == "ohhts_6000_001r"	then
		Process_Tran_ohhts_6000_001r()
		
	elseif szTranID == "ohhts_6000_001r_1"	then
		Process_Tran_ohhts_6000_001r_1()
		
	elseif szTranID == "ohhts_6000_001r_2"	then
		Process_Tran_ohhts_6000_001r()
		
	elseif szTranID == "ohhts_6000_017r"	then
		Process_Tran_ohhts_6000_017r()
		
	elseif szTranID == "ohhts_6000_020r"	then
		Process_Tran_ohhts_6000_020r()
		
	elseif szTranID == "obsim_oscm_331r"	then
		Process_Tran_obsim_oscm_331r()
	
	elseif szTranID == "obtre_comm_024r" then
		Process_Tran_obtre_comm_024r()
	
	elseif szTranID == "obtre_comm_004r" then
		Process_Tran_obtre_comm_004r()
	end if
End Sub


