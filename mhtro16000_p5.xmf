Function Init_Control()
	contMain.lblItemInfo0.paddinginfo = "0,0,0,0"
	contMain.lblItemInfo0.maxlinecnt = "1"
	contMain.lblItemInfo0.fgcolor = g_szTxtColor_Grey
	
	contMain.lblMktInfo0.paddinginfo = "0,0,0,0"
	contMain.lblMktInfo0.fgcolor = g_szTxtColor_Normal
	contMain.lblMktInfo0.maxlinecnt = "1"
	
	contMain.lblMktInfo1.paddinginfo = "0,0,0,0"
	contMain.lblMktInfo1.fgcolor = g_szTxtColor_Normal
	contMain.lblMktInfo1.maxlinecnt = "1"

	contMain.lblPrc.paddinginfo = "0,0,0,0"
	contMain.lblPrc.maxlinecnt = "1"
	
	contMain.lblDiff0.paddinginfo = "0,0,0,0"
	contMain.lblDiff0.maxlinecnt = "1"
	
	contMain.lblRate0.paddinginfo = "0,0,0,0"
	contMain.lblRate0.maxlinecnt = "1"
	
	contMain.lblVol0.paddinginfo = "0,0,0,0"
	contMain.lblVol0.fgcolor = g_szTxtColor_Grey
	contMain.lblVol0.maxlinecnt = "1"

	contMain.lblConvAmt.paddinginfo = "0,0,0,0"
'	contMain.lblConvAmt.maxlinecnt = "1"
	
	contMain.lblSubMktInfo.paddinginfo = "0,0,0,0"
	contMain.lblSubMktInfo.fgcolor = g_szTxtColor_Grey
	contMain.lblSubMktInfo.maxlinecnt = "1"
	
	contMain.lblSubPrc.paddinginfo = "0,0,0,0"
	contMain.lblSubPrc.maxlinecnt = "1"
	
	contMain.lblSign1.paddinginfo = "0,0,0,0"
	contMain.lblSign1.maxlinecnt = "1"
	
	contMain.lblDiff1.paddinginfo = "0,0,0,0"
	contMain.lblDiff1.maxlinecnt = "1"
	
	contMain.lblRate1.paddinginfo = "0,0,0,0"
	contMain.lblRate1.maxlinecnt = "1"
	
	contMain.lblItemInfo1.paddinginfo = "0,0,0,0"
	contMain.lblItemInfo1.maxlinecnt = "1"
	contMain.lblItemInfo1.fgcolor = g_szTxtColor_Grey
	
	contMain.lblItemInfo2.paddinginfo = "0,0,0,0"
	contMain.lblItemInfo2.maxlinecnt = "1"
	contMain.lblItemInfo2.fgcolor = g_szTxtColor_Grey
	
End Function

Function DisplaySetting_CFD()
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20211203 HSZ 해외CFD
	If g_szScreenNo = "16100" or g_szScreenNo = "16200" or g_szScreenNo = "16210" or g_szScreenNo = "16220" then	'20230821 주문2 추가
		contMain.ChartEx1.visible = false
		contMain.imgCfdBg.visible = true
		TblCFD.visible = true
		
	else
		contMain.ChartEx1.visible = true
		contMain.imgCfdBg.visible = false
		TblCFD.visible = false
	end if
End Function
Function DisplaySetting_Order()
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )		

	If g_szScreenNo = "16060" or g_szScreenNo = "16061" then	'20230821 주문2 추가
		if g_szScreenNo = "16060" then
			contMain.lblItemInfo2.caption = "시장안내"
		else
			contMain.lblItemInfo2.caption = "유의사항"
		end if
		
		TblCFD0.visible = false
		contMain.ChartEx1.visible = false
		
		contMain.lblDiff1.left  = 400
		contMain.lblItemInfo1.left  = 400
		
		'20240610 LES START
		sOsType = Form.GetSharedData("&OS_TYPE", false)
		
		'-----------------------------------
		' 종목코드|국가|거래소
		'-----------------------------------
'		contMain.lblItemInfo0.top = 8
'		contMain.lblMktInfo0.top = 14
'		contMain.lblMktInfo1.top = 14
		
		'-----------------------------------
		' 현재가
		'-----------------------------------
		contMain.lblPrc.autofontsize = true
		contMain.lblPrc.width = 110
		contMain.lblPrc.top = 28
		
		contMain.Grid0.top = 29
		
		'-----------------------------------
		' 등락부호
		'-----------------------------------
		if sOsType == "2" then
			contMain.lblSign0.top = 43
			contMain.lblSign0.left = 153
		else
			contMain.lblSign0.top = 44
			contMain.lblSign0.left = 155
		end if
		
		'-----------------------------------
		' 전일대비
		'-----------------------------------
		contMain.lblDiff0.autofontsize = true
		contMain.lblDiff0.halign = 0
		contMain.lblDiff0.top = 41
		contMain.lblDiff0.left = 169
		contMain.lblDiff0.width = 60
		
		'-----------------------------------
		' 전일대비 등락률
		'-----------------------------------
		contMain.lblRate0.top = 41
		contMain.lblRate0.left = 229
		contMain.lblRate0.halign = 0
		contMain.lblRate0.width = 50
		
		'-----------------------------------
		' 거래량
		'-----------------------------------
		contMain.lblVol0.autofontsize = true
		contMain.lblVol0.halign = 2
		contMain.lblVol0.width = 81
		contMain.lblVol0.height = 18
		contMain.lblVol0.top = 41
		contMain.lblVol0.left = 279
		
		'-----------------------------------
		' 원화환산금액
		'-----------------------------------
		contMain.lblConvAmt.top = 66
		contMain.lblConvAmt.width = 80
		
		'-----------------------------------
		' 전일종가(텍스트)
		'-----------------------------------
		contMain.lblSubMktInfo.height = 22
		contMain.lblSubMktInfo.left = 100
		contMain.lblSubMktInfo.top = 66
		
		contMain.lblSubMktInfo.fontsize = -2
		
		'-----------------------------------
		' 전일종가
		'-----------------------------------
		contMain.lblSubPrc.top = 66
		contMain.lblSubPrc.left = 160
		
		contMain.lblSubPrc.fontsize = -2
		
'		nWidth = Form.getTextWidth(contMain.lblSubMktInfo.caption, "-2", false, false)
'		msgbox nWidth 
'		contMain.lblSubPrc.left = 100 + nWidth + 5
		
		'-----------------------------------
		' 전일종가 등락부호
		'-----------------------------------
		contMain.lblSign1.left = 233
		contMain.lblSign1.top = 71
		
		contMain.lblSign1.fontsize = -2
		
		'-----------------------------------
		' 전일종가 등락률
		'-----------------------------------
		contMain.lblRate1.left = 245
		contMain.lblRate1.top = 66
		
		contMain.lblRate1.fontsize = -2
		
		'-----------------------------------
		' 시장안내(텍스트)
		'-----------------------------------
		contMain.lblItemInfo2.visible = true
		contMain.lblItemInfo2.top = 65
		contMain.lblItemInfo2.left = 245
		contMain.lblItemInfo2.fontsize = -3
		'-----------------------------------
		' 시장안내(이미지)
		'-----------------------------------
		contMain.imgNoti.top = 70
		contMain.imgNoti.left = 355
		contMain.imgNoti.visible = true
		contMain.imgNoti.maintainratio = "1"
'		contMain.imgNoti.imgpath = "icon_noti"
		contMain.imgNoti.imgpath = "icon_main_info"	'20240627 HSZ
		'20240610 LES END
		
		
		
	end if
End Function

'==============================================
' 거래소코드 -> 거래소명 변환 
'==============================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 104
		return "홍콩"
	elseif sValue == "HSI" then ' 529
		return "항셍 지수"
	elseif sValue == "SHS" then ' 215
		return "중국 상해"
	elseif sValue == "SZS" then ' 214
		return "중국 심천"
	elseif sValue == "NYS" then ' 321
		return "미국 뉴욕"
	elseif sValue == "AMX" then ' 66
		return "미국 아멕스"
	elseif sValue == "NAS" then ' 537
		return "미국 나스닥"
	elseif sValue == "NAO" then ' 130
		return "미국"
	elseif sValue == "SPI" then ' 625
		return "미국 S&P"
	elseif sValue == "DJI" then ' 310
		return "미국 다우존스"
	elseif sValue == "TSE" then ' 106
		return "일본 도쿄"
	elseif sValue == "OSE" then ' 107
		return "일본 오사카"
	elseif sValue == "JSD" then ' 112
		return "일본 자스닥"
	elseif sValue == "NII" then ' 889
		return "일본 니케이"
	elseif sValue == "NAI" then ' 538
		return "미국 나스닥"
	elseif sValue == "HSX" then ' 770
		return "베트남 호치민"
	elseif sValue == "HNX" then ' 771
		return "베트남 하노이"
	else
		return ""
	end if
end Function

'==============================================
' 실시간 서비스 등록 해제 
'==============================================
Function Cancel_Real_Total()
	'해외주식 체결(프리/정규) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	
	'해외주식 체결(주간) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	
	'해외주식 체결(애프터) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")
End Function

Function Request_Real_MarketOperation()

	' 서비스 변경 예정
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_mko2", "InBlock1", "FIDR_OVRS_STCK_MRKT_CLS_CODE" , 0 , "*" )
	DATAMANAGER.RequestRealData( "ohhts_exst_mko2" )
End Function

Function Cancel_Real_MarketOperation()
	' 서비스 변경 예정
	DATAMANAGER.CancelRealData("ohhts_exst_mko2")
End Function
'==============================================
' 해외주식 종목정보 및 장운영 정보 조회 순서 : obsim_oscm_331r -> obtro_comn_010r -> 시세조회(주간/정규)
'==============================================
' 해외주식 종목정보 및 휴장일 조회
'==============================================
Function Request_Tran_obsim_oscm_331r()
	DATAMANAGER.ClearInputData(false, "obsim_oscm_331r")
	
	DATAMANAGER.SetDataValue(false, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , g_sCode.."."..g_sExid)
	
	DATAMANAGER.RequestTranData("obsim_oscm_331r")
End Function

Function Process_Tran_obsim_oscm_331r()
	g_isSellOnly   		= DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN"	, 0) ' 매수불가여부
	g_isTradingSuspend     = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock1", "TRHT_YN"		, 0) ' 거래정지여부
	g_szBaseDate   		= DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "STND_DATE"		, 0) ' 기준일
	g_isHoliday    		= DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "HLDY_YN"		, 0) ' 휴일여부
	g_isPTP      			= DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "PTP_ISSU_YN"	, 0) ' PTP종목여부
	
	Request_Tran_obtro_comn_010r()
End Function

'==============================================
' 장운영정보 조회
'==============================================
Function Request_Tran_obtro_comn_010r()
	DATAMANAGER.ClearInputData(false, "obtro_comn_010r")

	szGbn = ""
	if g_sExid == "AX" or g_sExid == "NY" or g_sExid == "OQ" then
		szGbn = "01"
	elseif g_sExid == "HK" then
		szGbn = "02"
	elseif g_sExid == "SH" then
		szGbn = "03"
	elseif g_sExid == "SZ" then
		szGbn = "04"
	elseif g_sExid == "JP" then
		szGbn = "05"
	end if
	
	DATAMANAGER.SetDataValue( false, "obtro_comn_010r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"	, 0 , szGbn )	
	
	DATAMANAGER.RequestTranData("obtro_comn_010r")
End Function

Function Process_Tran_obtro_comn_010r()
	szData0 = DATAMANAGER.GetDataValue(false, "obtro_comn_010r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0)
	szData1 = DATAMANAGER.GetDataValue(false, "obtro_comn_010r", "OutBlock1", "OVRS_MKOP_CLS_CODE" , 0)

	g_szMktCd = szData0
	g_szMktOpClsCd = szData1
	
	Convert_MktOpInfo(g_szMktOpClsCd)
	
	DisplaySetting_MktOperation(g_szMktOp, g_isMktClosed, g_szSubMktOp, g_szBaseDate, g_isHoliday)
	
	Form.triggerEvent("#", "CHANGE_MKTOP", g_szMktOpClsCd)
	Request_MktOp(g_szMktOpClsCd)
	
	' 장운영 정보 실시간 등록
	Request_Real_MarketOperation()
End Function

'==============================================
' 해외주식 장운영 정보(주간/휴장) 및 종목정보 컨트롤 표시
'==============================================
'==============================================
' 장운영 정보 코드 변환
'==============================================
Function Convert_MktOpInfo(szMkOpClsCd)
	Select Case szMkOpClsCd
		Case "001"
			g_szMktOp = "주간"
			g_isMktClosed = "N"
			g_szSubMktOp = "전일종가"
		Case "002"
			g_szMktOp = "주간"
			g_isMktClosed = "Y"
			g_szSubMktOp = "주간종가"
		Case "003"
			g_szMktOp = "Pre"
			g_isMktClosed = "N"
			g_szSubMktOp = "주간종가"
		Case "004"
			g_szMktOp = "정규장"
			g_isMktClosed = "N"
			g_szSubMktOp = "주간종가"
		Case "005"
			g_szMktOp = "After"
			g_isMktClosed = "N"
			g_szSubMktOp = "After"
		Case "006"
			g_szMktOp = "After"
			g_isMktClosed = "Y"
			g_szSubMktOp = "After"
		Case "011" 
			g_szMktOp = "정규장"
			g_isMktClosed = "N"
			g_szSubMktOp = ""
		Case "012" 
			g_szMktOp = "정규장"
			g_isMktClosed = "Y"
			g_szSubMktOp = ""
		Case "013" 
			g_szMktOp = "정규장"
			g_isMktClosed = "Y"
			g_szSubMktOp = "After"
			
		Case Else
			g_szMktOp = "정규장"
			g_isMktClosed = "Y"
			g_szSubMktOp = "주간종가"
	End Select
End Function

'==============================================
' 장운영 정보 기반 시세서비스 호출
'==============================================
Function Request_MktOp(szMkOpClsCd)
	Cancel_Real_Total()

	Select Case szMkOpClsCd
		Case "001"	'주간장 개시
			Request_Tran_ohhts_6000_017r()
			
			Request_Tran_ohhts_6000_001r_1()
	
		Case "002"	'주간장 종료
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_017r_1()

		Case "003"	'프리장 개시
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_017r_1()
			
		Case "004"	'정규장 개시
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_017r_1()

		Case "005"	'애프터장 개시
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_020r()

		Case "006"	'애프터장 종료
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_020r()
			
		Case "011", "012" 
			Request_Tran_ohhts_6000_001r()
			
		Case "013"
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_020r()
			
		Case Else
			Request_Tran_ohhts_6000_001r()
			
			Request_Tran_ohhts_6000_020r()

	End Select
	
	Request_Tran_ohhts_5041_007r()
End Function

'==============================================
' 장운영 정보 (주간/휴장 포함) 체크
'==============================================
Function DisplaySetting_MktOperation(szMktOp, isClosed, szSubMktOp, szBaseDate, isHoliday)
	'sWeekDate = WeekDay( CDate( Left( szBaseDate, 4 ) & "-" & Mid( szBaseDate, 5, 2 ) & "-" & Right( szBaseDate, 2 ) ) )
	
	' 휴장여부 체크
	'if Trim( isHoliday ) = "Y" And Trim( sWeekDate ) <> "1" And Trim( sWeekDate ) <> "7" Then		
	
	if g_szMktOpClsCd == "000" then
		' 장운영 서브정보 미표시 
		DisplaySetting_SubMktInfo(false)
		
		contMain.lblMktInfo0.visible = false
		contMain.lblMktInfo1.visible = true
		
		contMain.lblMktInfo1.caption = "휴장"
		contMain.lblMktInfo1.imagefilepth = g_szBadgeBg_Line
		
	else
		
		contMain.lblMktInfo1.visible = true
			
		if g_sNation = "USA" then	
			contMain.lblMktInfo0.visible = true
			' 미국
			' 장운영 서브정보 표시 
			DisplaySetting_SubMktInfo(true)
			
			contMain.lblMktInfo0.caption = szMktOp
			contMain.lblSubMktInfo.caption = szSubMktOp
			
			nWidth = 0
			If g_szScreenNo = "16060" or g_szScreenNo = "16061" then
				nWidth =  Cint(Form.getTextWidth(szSubMktOp, "-2", false, false))
				contMain.lblSubPrc.left = 100 + nWidth + 5
			else
				nWidth =  Cint(Form.getTextWidth(szSubMktOp, "-4", false, false))
				contMain.lblSubPrc.left = 20 + nWidth + 5
			end if
			
			contMain.lblMktInfo0.imagefilepth = g_szBadgeBg_Red
			
			if isClosed = "Y" then
				contMain.lblMktInfo0.visible = false
				contMain.lblMktInfo1.caption = "장종료"
				contMain.lblMktInfo1.imagefilepth = g_szBadgeBg_Grey
			else
				contMain.lblMktInfo1.imagefilepth = g_szBadgeBg_Blue
				if g_rtChk == "0" or szMktOp == "주간" then
					contMain.lblMktInfo1.caption = "실시간"
				else
					contMain.lblMktInfo1.caption = "15분지연"
				
					sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
					if sDayYN == "Y" then
						if g_sExid == "NY" or g_sExid == "AX" or g_sExid == "OQ" then
							contMain.lblMktInfo1.caption = "실시간"
						end if
					end if
				end if 	
				
			end if
			
		else
			contMain.lblMktInfo0.visible = false
			' 중국/홍콩/일본
			' 장운영 서브정보 미표시 
			DisplaySetting_SubMktInfo(false)
			
			contMain.lblMktInfo0.caption = szMktOp
			contMain.lblSubMktInfo.caption = ""
			
			contMain.lblMktInfo0.imagefilepth = g_szBadgeBg_Red
			
			if isClosed = "Y" then
				contMain.lblMktInfo0.visible = false
				contMain.lblMktInfo1.caption = "장종료"
				contMain.lblMktInfo1.imagefilepth = g_szBadgeBg_Grey
			else
				contMain.lblMktInfo1.imagefilepth = g_szBadgeBg_Blue
				if g_rtChk == "0" then
					contMain.lblMktInfo1.caption = "실시간"
				else
					if g_sExid == "JP" then
						contMain.lblMktInfo1.caption = "20분지연"
					else
						contMain.lblMktInfo1.caption = "15분지연"
					end if
				end if 	
			end if
			
		end if
	end if
End Function


'==============================================
' 시세 서브정보 표시 여부
'==============================================
Function DisplaySetting_SubMktInfo(isValue)	
	contMain.lblSubMktInfo.visible 	= isValue
	contMain.lblSubPrc.visible 		= isValue
	contMain.lblSign1.visible 		= isValue
	contMain.lblDiff1.visible 		= isValue
	contMain.lblRate1.visible 		= isValue
End Function

'==============================================
' 종목 서브정보 표시 
'==============================================
Function DisplaySetting_ItemSubInfo(szPreText, isTradingSuspend, isSellOnly, isPTP)
	nPreLen = Form.getLen(szPreText & " | ")
	nPostLen = 0
	'거래정지 여부
	if isTradingSuspend == "Y" then
		szData = szPreText & " | 거래정지"
		nPostLen = 4
	end if
	
	'매도만 가능 여부
	if isSellOnly == "Y" then
		szData = szPreText & " | 매도만가능"
		nPostLen = 5
	end if
	
	'PTP종목 여부
	if isPTP == "Y" then
		szData = szPreText & " | PTP종목"
		nPostLen = 3
	end if
	
'	g_szItemInfo = szData
	contMain.lblItemInfo0.caption = szData
	szFontSize = contMain.lblItemInfo0.fontsize
'	msgbox szFontSize
'	contMain.lblItemInfo0.changeTextAttr(nPreLen, nPostLen, "130", "-4", false)
	

End Function

