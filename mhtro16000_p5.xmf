Sub Form_OnFormInitBefore()
	contMain.ChartEx1.SetChartType("line")
	contMain.ChartEx1.SetPeriodType("1")
	contMain.ChartEx1.SetPeriodTime("5")
	
	DisplaySetting_CFD()
	DisplaySetting_Order()
End Sub

