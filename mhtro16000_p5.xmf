	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r_2", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r_2", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r_2", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )	'종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r_2", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	'실시간 여부
	
