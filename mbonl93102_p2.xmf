Dim g_szReturn

'============================================================================
Sub btnOk_OnClick()
	g_szReturn = "Agree"
	Form.CloseForm()
End Sub

'============================================================================
Sub imgNext_OnClick()
	Dim szIndex
	szIndex = FormTab0.currenttab
	If szIndex == "0" or szIndex == 0 Then
		FormTab0.currenttab = "1"
	End If
End Sub

'============================================================================
Sub imgPrev_OnClick()
	Dim szIndex
	szIndex = FormTab0.currenttab
	If szIndex == "1" or szIndex == 1 Then
		FormTab0.currenttab = "0"
	End If
End Sub

