	<SCRIPT_INFO _len="2163" _ulen="2035" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_내보내기(인증번호)
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20201126 SWJ START : 공인인증서 공인 글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "NextCheck" then
		if (Edit0.caption == null or Edit0.caption == "") or
			(Edit1.caption == null or Edit1.caption == "") or
			(Edit2.caption == null or Edit2.caption == "") then
			Form.MsgBox( "알림", "인증서 인증번호를 입력하세요.", "", 6 )
		else '인증서 비밀번호 유효성체크
			Dim sNum 
			sNum = Edit0.caption..Edit1.caption..Edit2.caption
			Form.SetSharedData("CERT_EXPORT_NUM" , sNum)
			Form.triggerEvent( "#", "NextStep", "3" )
		end if
	elseif sEventName == "BeforeCheck" then	
		Form.triggerEvent( "#", "BeforeStep", "1" )	
	end if
End Sub

'============================================================================
Sub Edit0_OnEditChar(CharCode)
	if #CharCode == 4 then
		Edit1.SetShowKeypad( true )
	end if
End Sub

'============================================================================
Sub Edit1_OnEditChar(CharCode)
	if #CharCode == 4 then
		Edit2.SetShowKeypad( true )
	end if
End Sub


	</SCRIPT_INFO>
</ROOT>