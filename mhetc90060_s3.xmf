			<PAGE name="page002106" caption="스마트폰 → 스마트폰" linkfile="mhetc90060_crt4" loadingtype="1" />
		</FORMTAB>
		<EDIT name="Edit2" halign="1" imetype="1" maxlength="4" ly_vert="274,240,90,40,1" />
		<EDIT name="Edit1" halign="1" imetype="1" maxlength="4" ly_vert="178,240,90,40,1" />
		<EDIT name="Edit0" halign="1" imetype="1" maxlength="4" ly_vert="82,240,90,40,1" />
