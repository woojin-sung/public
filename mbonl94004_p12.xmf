'--===========================================================================
' 01. 화 면 명 : 타사투자경험잔고증명서제출
' 02. 화면설명 : 타사투자경험잔고증명서제출
' 03. 작    성 : 2022.04.15 KSJ
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szImg		'등록 이미지

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szImg = ""
	nCutCnt = ""
	
	'OS타입
	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	if g_OsType == "1" then 'AOS
		nCutCnt = 32
	else
		nCutCnt = 33
	end if
	
	Dim szOpenData
	szOpenData = Trim(Form.GetOpenLinkData())
	If szOpenData <> null and szOpenData <> "" Then		
		Dim tData
		tData = Split(szOpenData, "★")	
		If Ubound(tData) > 0 Then
			If tData[0] <> NULL and tData[0] <> "" Then
				If tData[0] == "0" Then
					lblInfo2.changeTextAttr(6, nCutCnt, 6, 0, false)
'					lblTitle.caption = "타사 투자 경험 계좌확인서 제출"
'					tblInfo.SetCellString( 2, 1, "'계좌확인서'")
'					contProcess.tblNo.SetCellString( 1, 1, "신청용 계좌 확인서만 가능합니다.")					
				End If
			End If
			If tData[1] <> NULL and tData[1] <> "" Then
				lblFirm.caption = Trim(tData[1])	'기관명 SET
	
				If  tData[2] <> NULL and tData[2] <> "" Then	
					g_szImg = tData[2]			'이미지 SET
					imgPicture.SetImageDataEnc(g_szImg)
					btnNext.enable = true
				Else	'이미지 없으면 128r 조회!
					If  tData[3] <> NULL and tData[3] <> "" Then	
						g_DetlSrno = tData[3]
						DATAMANAGER.RequestTranData("obcsb_acif_128r")	'타사투자경험증빙서류 이미지 조회
					Else
						lblInfo3.visible = true
					End if
				End If
			End If
		End If
		
	End If
End Sub
'============================================================================
' Form_OnFormBackKeyPressed() : 화면닫기
'============================================================================
Sub Form_OnFormBackKeyPressed()	
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick() : 화면닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
' btnUpload() : 이미지 업로드
'============================================================================
Sub btnUpload_OnClick()
	Form.getGalleryImage()	
End Sub
'============================================================================
'  btnCam() : 재촬영
'============================================================================
Sub btnCam_OnClick()
	Form.runOsCamera()
End Sub

'============================================================================
' btnNext_OnClick() : 잔고증명서 제출
'============================================================================
Sub btnNext_OnClick()
	If g_szImg == null or g_szImg == "" Then
		Form.ShowAlert("알림", "제출할 이미지가 없습니다.")
		Exit Sub
	End If
	
	If Len(g_szImg) > 102400 then	'이미지 최대사이즈
		Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
		Exit Sub
	End If

	Form.SendReturnToParent("close_mbonl94004_p12" , g_szImg)
	Form.CloseForm()
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 이미지 선택 또는 촬영 후 트리거이벤트로 이미지 전달
	' 정상처리 시, 공유변수 통해 이미지 데이터 가져오기 
	' # 트리거 이벤트 명  : CAPTURECOMPLETE
	' # sParam            : 1 정상 / 0 비정상
	' # 캡쳐이미지        : &RET_CAPTURE_IMAGE
	if sEventName = "CAPTURECOMPLETE" then
'		if sParam = "1" then	'아이폰은 sPram 바로 데이터로 처리
			g_szImg = Form.GetSharedData("&RET_CAPTURE_IMAGE", true )
			
			If  g_szImg <> NULL and g_szImg <> "" Then
				lblInfo3.visible = false
			else
				lblInfo3.visible = true
			end if
			
			if Len(g_szImg) < 102400 then	'이미지 최대사이즈 
				imgPicture.SetImageDataEnc(g_szImg)
				btnNext.enable = true
			Else
				Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
			end if
'		end if
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCsno, szHostDate
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	szHostDate = Form.GetSharedData("&HOST_DATE",0)
	
	'전문투자자 타사투자경험증빙서류 이미지 조회
	if szTranID == "obcsb_acif_128r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" 			, 0, szCsno 		) '고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "INVT_EXPC_CLCD"	, 0, "1"			) '투자경험구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_SRNO" 		, 0, Form.GetSharedData("94004_ApplySrno")	) '신청일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "DETL_SRNO"		, 0, g_DetlSrno			) '세부일련번호
	End if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'전문투자자 타사투자경험증빙서류 이미지 조회
	if szTranID == "obcsb_acif_128r" Then
		szATCH_FILE_SIZE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ATCH_FILE_SIZE", 0  )	'첨부파일사이즈
		szUI_IMG_DATA = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_IMG_DATA", 0  )	'UI이미지데이터

		if Len(szUI_IMG_DATA) < 102400 then	'이미지 최대사이즈 
			imgPicture.SetImageDataEnc(szUI_IMG_DATA)
			btnNext.enable = false
		Else
			Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
		End If
	End if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_acif_128r" trcode="obcsb_acif_128r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_acif_128r" title="타사투자경험증빙서류 이미지 조" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="185" _ulen="137" >

CSNO^고객번호^10^0^0^0^0^0^0
INVT_EXPC_CLCD^투자경험구분코드^1^0^0^0^0^0^0
APLT_SRNO^신청일련번호^11^0^7^0^0^0^0
DETL_SRNO^세부일련번호^11^0^7^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="112" _ulen="86" >

ATCH_FILE_SIZE^첨부파일사이즈^11^0^7^0^0^0^0
UI_IMG_DATA^UI이미지데이터^102400^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
