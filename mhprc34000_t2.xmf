	ElseIf szTranID = "ohhts_futs_cntg" Then
		

	End if 
    
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'MarketType Default : "CM"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
				
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_3050_005r" )
		DATAMANAGER.RequestTranData( "ohhts_3050_005r_1" )
	
	End If
End Sub

'============================================================================
' 미국달러선물인 경우 소수점 첫째자리 까지만 보이게 셋팅 그외는 둘째자리까지
'============================================================================
Sub Set_MaskInfo()
	
	strItemCode =  Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	strItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
	
	if strItemMarket = "CD" then
		contFut.tblFut1.SetCellMaskInfo(0, 1, "0,0,,,1,,1,1,0")
		contFut.tblFut1.SetCellMaskInfo(2, 3, "0,0,,,1,,1,1,0")
		
		contFut.tblFut3.SetCellMaskInfo(0, 1, "0,0,,,1,,1,1,0")
		contFut.tblFut3.SetCellMaskInfo(0, 3, "0,0,,,1,,1,1,0")
		
		contFut.tblFut4.SetCellMaskInfo(0, 1, "0,0,,,1,,1,1,0")
		contFut.tblFut4.SetCellMaskInfo(1, 1, "0,0,,,1,,1,1,0")
	else
		contFut.tblFut1.SetCellMaskInfo(0, 1, "0,0,,,1,,2,1,0")
		contFut.tblFut1.SetCellMaskInfo(2, 3, "0,0,,,1,,2,1,0")
		
		contFut.tblFut3.SetCellMaskInfo(0, 1, "0,0,,,1,,2,1,0")
		contFut.tblFut3.SetCellMaskInfo(0, 3, "0,0,,,1,,2,1,0")
		
		contFut.tblFut4.SetCellMaskInfo(0, 1, "0,0,,,1,,2,1,0")
		contFut.tblFut4.SetCellMaskInfo(1, 1, "0,0,,,1,,2,1,0")

	end if
	
End Sub

