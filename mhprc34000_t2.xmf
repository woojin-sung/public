	<SCRIPT_INFO _len="12080" _ulen="11494" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 기본탭화면
' 03. 작    성 : 2017.04.30 LES
'----------------------------------------------------------------------------
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg
Dim g_szItemCode, g_ItemMarket, g_szgrdHeader1, g_szgrdHeader2

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
	
	'MarketType Default : "CM"
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CM"			
	end if
	
	if Len(Trim(g_szItemCode)) == 0 Then
		g_szItemCode = Form.getFutureCodeNight(0,"CM",true)			
	end if
	

End Sub

'============================================================================
Sub Form_OnFormInit()


	contOpt.left = 0
	
	If g_szItemMarket = "EM" or g_szItemMarket = "CM" or g_szItemMarket = "CD" Then
		contFut.visible = True
		contOpt.visible = False
	Else
		contFut.visible = False
		contOpt.visible = True
	End If
	
	Set_MaskInfo()
	

	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_3050_005r" )
	DATAMANAGER.RequestTranData( "ohhts_3050_005r_1")
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
		
		'MarketType Default : "CM"
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
		
		szBase = Form.GetItemCodeInfo( g_szItemCode , "basecode")
		
		If g_szItemMarket = "EM" or g_szItemMarket = "CM" or g_szItemMarket = "CD" Then
			contFut.visible = True
			contOpt.visible = False
		Else
			contFut.visible = False
			contOpt.visible = True
		End If
		
		Set_MaskInfo()
		
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_3050_005r" )
		DATAMANAGER.RequestTranData( "ohhts_3050_005r_1" )
	
	end	if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	Dim szCode
	
	g_szItemCode =  Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
	
	
	If szTranID = "ohhts_3050_001r" Then
		DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
'		DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
'		DATAMANAGER.CancelRealData( "ohhts_cusf_cntg" )	'20210712 HSZ 야간 미국달러선물 제도개편
		DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
				
		DATAMANAGER.CancelRealData( "ohhts_pric_extd" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3050_005r" Then
		If g_szItemMarket = "EM" or g_szItemMarket = "CM" or g_szItemMarket ="CD" Then
			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg_1" )
			DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
'			DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
'			DATAMANAGER.CancelRealData( "ohhts_cusf_cntg" )	'20210712 HSZ 야간 미국달러선물 제도개편
			
		Else
			DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg_1" )
		End If
		
		If g_szItemMarket = "EM" or g_szItemMarket = "CM" or g_szItemMarket = "CD" Then
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "K2G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "KGG01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
		Else
			
			'InBlock1 = 주간선물 최근월  InBlock2= Kospi200지수
			szCode_day = Form.GetFutureCode(0, false, true)
			
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "F" 	)
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , szCode_day 	)
			
			
			
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)			
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "K2G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
			
		
		End If
		
	Elseif szTranID = "ohhts_3050_005r_1" then
		
			szCode_night = Form.getFutureCodeNight(0,"CM",true)
			
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "CM" 	)
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r_1", "InBlock1", "FID_INPUT_ISCD" 				, 0 , szCode_night 	)
		
		
	End If
	
End Sub

'============================================================================
' 실시간 서비스 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szItemCode, szCode
	szItemCode = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_efut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
			
'20210223 HSZ 야간선물 제도개편
'	Elseif szTranID = "ohhts_cmef_cntg" then
'		DATAMANAGER.SetDataValue( 1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
	
'	Elseif szTranID = "ohhts_cusf_cntg" then	'20210712 HSZ 야간 미국달러선물 제도개편
'		DATAMANAGER.SetDataValue( 1, "ohhts_cusf_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
	
	ElseIf szTranID = "ohhts_eopt_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
	
	
	ElseIf szTranID = "ohhts_nmix_cntg" Then
		If g_szItemMarket = "EM" or g_szItemMarket = "CM" or g_szItemMarket = "CD" Then
		    DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "KGG01P")	'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
		Else
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "K2G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
		End If
	
	ElseIf szTranID = "ohhts_nmix_cntg_1" Then
	    
	    DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "K2G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
	    
	ElseIf szTranID = "ohhts_pric_extd" Then
	    DATAMANAGER.SetDataValue( 1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD"		, 0 , szItemCode	)
	    
	
	Elseif szTranID = "ohhts_futs_cntg" then
		szCode = Form.GetFutureCode(0, false,true)
		DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode)
	
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ohhts_3050_001r" Then	
	
		If g_szItemMarket = "EM" Then
		     DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		elseif g_szItemMarket = "CM" then
'			DATAMANAGER.RequestRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
			DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		elseif g_szItemMarket = "CD" then
'			DATAMANAGER.RequestRealData( "ohhts_cusf_cntg" ) '20210712 HSZ 야간 미국달러선물 제도개편
			DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		Else
			DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
		End If
	    
		DATAMANAGER.RequestRealData( "ohhts_pric_extd" )
	
	elseif szTranID = "ohhts_3050_005r" Then	
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg_1" )
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
		
	'EO -> 상세탭 야간선물 최근월 (여기서 주간/야간 선물 실시간 서비스 호출)
	elseif szTranID = "ohhts_3050_005r_1" then
		DATAMANAGER.RequestRealData("ohhts_futs_cntg")
		DATAMANAGER.RequestRealData("ohhts_efut_cntg")
		
			
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	If szTranID = "ohhts_3050_001r" Then	
		If g_szItemMarket = "EM" or g_szItemMarket = "CM" or g_szItemMarket = "CD" Then
			Dim nACML_TR_PBMN
			nACML_TR_PBMN = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_ACML_TR_PBMN" , 0 )
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_ACML_TR_PBMN" , 0 , Round( nACML_TR_PBMN / 100000 ) )
		End If
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	If szTranID = "ohhts_efut_cntg" Then
		If g_szItemMarket = "F" or g_szItemMarket = "MF" Then
			Dim nACML_TR_PBMN
			nACML_TR_PBMN = DATAMANAGER.GetDataValue( 1, "ohhts_futs_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 )
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 , Round( nACML_TR_PBMN / 100000 ) )
			
		End If
	
	End If
End Sub

