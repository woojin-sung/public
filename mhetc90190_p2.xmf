	<SCRIPT_INFO _len="6354" _ulen="5764" >
'--==========================================================================
' 01. 화 면 명 : otp등록 팝업
' 02. 화면설명 : otp등록 팝업
' 03. 작    성 : 2023.05.15 성우진
' 04. 수    정 :
' 2024.01.19 : 전상일 : v0001 : obcsb_oimf_658a ui_cust_cont_cls_code 추가 (별도 맵핑 x)
'============================================================================
Dim g_szOTPYN
Dim g_loginAthn
Dim g_RegiData, g_AlarmRegi, g_CustNum, g_szAlias
Dim g_LoginType, g_szOStype
Dim g_NextPage, g_Home
'============================================================================
Sub Form_OnFormInitBefore()
	'ImgClose.setMaintainingRatio("1")
	Img0.setMaintainingRatio("1")
End Sub
'============================================================================
'

'============================================================================
Sub Form_OnFormInit()
	'grd0.setUseCardView(true, 10, "img_bgbox_gray.9")
	'grd0.scrollenable = "0"
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	'비대면계좌개설 단계에서 들어올 때
	szBdmScr = Form.GetSharedData("NMET_SIMPLE_ATHN", true )
	'OTP 여부 판단
	g_szOTPYN = Form.GetSharedData("NMET_OTP_ISNC_YN", true )
	g_szOStype = Form.GetSharedData("&OS_TYPE", false)
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", False)
	szLoginID  = Form.GetSharedData("&USER_ID", false)
	
	if Cint(g_LoginType) > 1 then
		'BtnLogin.caption = "확인"
		g_CustNum = Form.GetSharedData("&CUST_NUM"  , false )
	else
		g_CustNum = Form.GetSharedData("Meritz_OTP_CSNO" , false )
	end if
	
	'이전 화면에서 받아옴
	g_szAlias = Form.GetSharedData( "MERITZAUTH_ALIAS" , false )

	if szBdmScr == "Y" then
		if g_szOTPYN == "Y" then		
			BtnLogin.Top = 588
			BtnLogin.left = 0
			BtnLogin.width = 188
			BtnOther.visible = True
			
			BtnLogin.btnimage = "btn_21.9.png"	
			BtnLogin.fgcolor = "334"
			BtnOther.btnimage = "btn_20.9.png"
			BtnOther.fgcolor = "338"
			BtnOther.caption = "OTP등록/발급"
		else
			'로그인 했던 ID가 없는 경우는 
			'다음에하기 버튼 눌렀을 때 home으로 보내면 안되서
			'일단 로그인 버튼만 남기자
			if Trim(szLoginID) == "" then
				exit sub
			end if
			
			BtnLogin.Top = 588
			BtnLogin.left = 0
			BtnLogin.width = 188
			BtnOther.visible = True
			
			BtnOther.btnimage = "btn_21.9.png"	
			BtnOther.fgcolor = "334"
			BtnLogin.btnimage = "btn_20.9.png"
			BtnLogin.fgcolor = "338"
			BtnLogin.left = 188
			BtnOther.left = 0
			BtnOther.caption = "다음에 하기"
		end if
	end if
	
	'알리미 발송
	DATAMANAGER.RequestTranData("obcsb_oimf_658a")
	
	g_RegiData = Form.GetOpenLinkData()
	
	if g_RegiData = "1" then
		Table0.SetCellString( 1, 2, "간편비밀번호")
		Table0.SetCellString( 2, 2, "지문")
		TblPinBio.visible = True
		g_loginAthn = "100"
		g_AlarmRegi = "01$03"

	elseif g_RegiData = "2" then
		Table0.SetCellString( 1, 2, "간편비밀번호")
		Table0.SetCellString( 2, 2, "Face ID")
		TblPinBio.visible = True
		g_loginAthn = "200"
		g_AlarmRegi = "01$02"

	else
		'Table0.top = 345
		Table0.top = 335
		Label3.height = 70
		
		Table0.SetCellString( 1, 2, "간편비밀번호")
		TblOnlyPin.visible = True
		g_loginAthn = "10"
		g_AlarmRegi = "01"
	end if
	
End Sub

'============================================================================
Sub BtnLogin_OnClick()
'	if Cint(g_LoginType) > 1 then
'		Form.CloseForm()
'	else
	
	'무조건 로그아웃 시켜야함
	'로그인 상태에서 발급 시
	'로그인 상태 그대로 주문화면 등 진입하면 축약서명 에러남
	Form.logout2(0, 0, 0)
	
	if g_loginAthn <> "" or g_loginAthn <> null then
		Form.SetEnvData(1, "login.input.atonathntchncode", g_loginAthn) 
	end if
	
	'mhetc90022에서 앱설치 후 간편인증 등록 시 남아있는 현상을 해결하기 위한 쉐어드 변수
	'mhetc90022에서 받음
	'Form.SetSharedData("ATON_Regi", "Y")
	
	'Form.OpenPopup("mhetc90021" , "mhetc90120_p2" , "")
	
	'mhetc90021에서 앱설치 후 간편인증 등록 시 남아있는 현상을 해결하기 위한 쉐어드 변수
	'mhetc90021에서 받음
	'Form.SetSharedData("ATON_Regi2", "Y")
	'Form.PostLinkData("&ATON_Regi", 6)
	
	g_NextPage = True
	Form.openStartScreen()
	'Form.SetTimerEvent2(1, 1, 0.1)
	'Form.OpenPopup("mhetc90021", "mhetc90120_p2","")
	'g_NextPage = True
	'Form.CloseForm()
	
'	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Login_Type" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub BtnOther_OnClick()
	if g_szOTPYN == "Y" then
		Form.OpenNextPopup("mbotp86200", "","")
	else
		g_Home = true
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	if g_loginAthn <> "" or g_loginAthn <> null then
		Form.SetEnvData(1, "login.input.atonathntchncode", g_loginAthn) 
	end if
	
	if g_NextPage then
		Form.OpenPopup("mhetc90021" , "mhetc90120_p2" , "")
	end if
	
	if g_Home then
		Form.OpenScreen("41000","")
	end if
	
'	'안드 : OpenScreen으로 열면 깔려있는 90021이나 90022 다 지움
'	'iOS  : POPUP_ALL_CLOSE 파라미터 넘기면 다 지움
'	if szOStype == "2" then
'		Form.OpenScreen("90020" , "POPUP_ALL_CLOSE")
'	else
'		Form.OpenScreen("90020" , "")
'	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'알리미 발송 서비스
	if szTranID == "obcsb_oimf_658a" then
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "PROS_CLS"			, 0 , "1"       ) '등록/재등록
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "UI_EASY_ATHN_KEY_VAL" , 0 , g_AlarmRegi) '간편인증/지문/Face ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "CSNO" 				, 0 , g_CustNum  ) 
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "REG_YN_IQRY_KEY"		, 0 , g_szAlias  ) 
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(1, 0, 0.1)
		Form.OpenPopup("mhetc90021" , "mhetc90120_p2" , "")
	end if
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_oimf_658a" trcode="obcsb_oimf_658a" compress="1" encryption="1" inputcheck="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_oimf_658a" title="간편 인증 완료 알리미 전송 처?" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="253" _ulen="195" >

PROS_CLS^처리구분^1^0^0^0^0^0^0
UI_EASY_ATHN_KEY_VAL^UI간편인증키값^20^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
REG_YN_IQRY_KEY^등록여부조회키^64^0^0^0^0^0^0
UI_CUST_CONT_CLS_CODE^UI고객접촉구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="42" _ulen="34" >

PROS_YN^처리여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>