<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="62010" scrname="한번에 잔액 모으기 팝업" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,314,293,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fontstyle="01" caption="출금액" halign="1" ly_vert="131,6,53,36,1" />
		<BUTTON name="BtnCnfr" caption="확인" fontstyle="01" btnimage="btn_05.9" ly_vert="163,235,114,39,1" />
		<BUTTON name="BtnCncl" caption="취소" fgcolor="004:000000000" bgcolor="052:255255255" btnimage="btn_02.9" ly_vert="38,235,114,39,1" />
		<LABEL name="Label1" caption="출금계좌 : " ly_vert="23,70,80,32,1" />
		<LABEL name="LblDrngAcnt" halign="2" autofontsize="1" ly_vert="117,70,167,32,1" />
		<EDIT name="EdtAmt" autofontsize="1" mask="0,0,,,0,,0,1,0" halign="2" imetype="1" ly_vert="117,168,152,39,1" />
		<LABEL name="Label2" caption="잔       액 : " ly_vert="23,96,80,32,1" />
		<LABEL name="Label3" caption="출금가능 : " ly_vert="23,122,80,32,1" />
		<LABEL name="Label4" caption="출금액" ly_vert="34,171,58,32,1" />
		<LABEL name="LblRmndAmt" halign="2" autofontsize="1" ly_vert="117,96,167,32,1" />
		<LABEL name="LblDrngAbleAmtHidden" visible="0" mask="0,0,,,0,,0,1,1" halign="2" ly_vert="17,36,167,32,0" />
		<LABEL name="LblDrngAbleAmt" halign="2" ly_vert="117,122,167,32,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1885" _ulen="1769" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 오픈뱅킹_한번에 잔액 모으기 1단계
' 02. 화면설명 : 한번에 잔액 모으기 1단계
' 03. 작    성 : 2020.10.12 장원혁
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'전역 변수 선언

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
    LblDrngAcnt.caption          = Form.GetSharedData("DRNG_ACNT"      , TRUE )
    
    RMND_AMT = Form.GetSharedData("RMND_AMT" , TRUE )
    LblRmndAmt.caption = FormatNumber(RMND_AMT,0) & "원"
    
    DRNG_ABLE_AMT = Form.GetSharedData("DRNG_ABLE_AMT"  , FALSE )
    LblDrngAbleAmt.caption = FormatNumber(DRNG_ABLE_AMT,0) & "원"
    
    LblDrngAbleAmtHidden.caption = Form.GetSharedData("DRNG_ABLE_AMT"  , TRUE )
    
End Sub

'============================================================================
Sub BtnCncl_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnCnfr_OnClick()

    If CDBL(EdtAmt.caption) > CDBL(LblDrngAbleAmtHidden.caption) Then
        Form.MsgBox("알림", "출금가능금액을 확인하세요.", "" , "")
        Exit Sub
    End If
    
    Form.SendReturnToParent("SetValue" , EdtAmt.caption) 
    Form.CloseForm()
    
End Sub

	</SCRIPT_INFO>
</ROOT>