'============================================================================
' 화 면 명 : 관심종목_관심종목편집_빈칸삽입
' 화면설명 : 관심종목편집창에서 종목리스트에 빈칸 삽입하는 팝업
' 작    성 : 2015.12.16 ~ 2015.12.17 ssang
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))
Dim g_szChk
Dim g_szGCode
g_szGCode = ""

Dim g_szTitle
g_szTitle = "알림"
Dim g_exInputString

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0	
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if Trim(szGroup ) <> "" then
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function	


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	szData = Form.GetOpenLinkData()
	
	'KBC : BLANK_ADD, BLANK_MOD 두 case만 진입함
	if szData <> "" then
		tData = Split(szData, "★")
		g_szChk = tData(0)
			
		if tData(0) == "BLANK_ADD" then
			'20240524_01 KBC START : 해외주식 고도화
			lblColor.bgcolor = "231230230"  '기본값 처리 (현재 관심종목에서 보여주는 색상값) - 네이티브에도 로직있음 public void setMemoColor( String colorIdx )
			rdoNameAlign.currentindex = "0"
			'20240524_01 KBC END
			
		elseif tData(0) == "BLANK_MOD" then
			lblMemo.caption = "변경 할 빈칸의 이름을 정해주세요"
			edtBlank.caption = tData(1)
			
			'20240524_01 KBC START : 해외주식 고도화
			'MsgBox tData(2) & ":" & tData(3)
			
			memoAlign = tData(2)
			memoColor = tData(3)
			
			if memoAlign == "C" then
				rdoNameAlign.currentindex = "1"
			elseif memoAlign == "R" then
				rdoNameAlign.currentindex = "2"
			else
				rdoNameAlign.currentindex = "0"
			end if
			
			if memoColor == "" then
			   memoColor = "231230230" ' 기본값 처리 (현재 관심종목에서 보여주는 색상값) - 네이티브에도 로직있음 public void setMemoColor( String colorIdx )
			end if
			
			lblColor.bgcolor = memoColor			
			'20240524_01 KBC END
		end if
	end if
End Sub


'============================================================================
' btnAdd_OnClick : Add버튼 클릭
'============================================================================
Sub btnAdd_OnClick()
	'20240524_01 KBC START : 해외주식 고도화 START
	if rdoNameAlign.currentindex == "1" then
		sMemoAlign = "C"
	elseif rdoNameAlign.currentindex == "2" then
		sMemoAlign = "R"
	else
		sMemoAlign = "L"
	end if	
	
	sMemoColor = lblColor.bgcolor

	sRslt = edtBlank.caption & "★" & sMemoAlign & "★" & sMemoColor
	
	Form.SendReturnToParent(g_szChk , sRslt)
	Form.CloseForm()
	'20240524_01 KBC END
End Sub

'============================================================================
' btnCancel_OnClick : 취소버튼 클릭
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub edtBlank_OnEditChar(CharCode)
	nTextLen = edtBlank.getLenByte(edtBlank.caption)
		
	if Cint(nTextLen) > 40 then
		edtBlank.caption = g_exInputString
		edtBlank.SetFocus()
	else
		g_exInputString = CharCode
	end if
End Sub

'============================================================================
Sub lblColor_OnClick()
	Form.OpenPopupAnimation("mhprc11010_p18", "", "","2")	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "COLOR_SECLECT" then
		lblColor.bgcolor = sRet
	end if
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	lblColor.bgcolor = "255255255"
	lblColor.setRound("1")
End Sub

	</SCRIPT_INFO>
</ROOT>