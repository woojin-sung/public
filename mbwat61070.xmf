'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 신규개발
'                2023.01.05 : 고승연 : v0002 : [T2301130023] 비밀번호 체크 수정
'                2023.11.27 : 고승연 : v0003 : [T2311160009] obwat_ctad_012r IO 수정
'-------------------------------------------------------------------------------------------

Dim g_sCsno, g_sAcno, g_sAsno, g_sCnrcNo

'============================================================================
Sub Form_OnFormInit()
	f_SetClear()
	g_sCsno = Form.GetSharedData("&CUST_NUM", false)
	
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
	DATAMANAGER.RequestTranData( "obwat_onln_004r" )
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_ctad_012r" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_012r", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_012r", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_012r", "InBlock1", "DRNG_CANC_CLCD" , 0 , "02" )
	elseif szTranID == "obwat_ctad_011a" then
		DATAMANAGER.SetEventFlag( "obwat_ctad_011a", "I" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "DRNG_CANC_CLCD" , 0 , "02" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "CRCD" , 0 , "KRW" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_CANC_CLCD" , 0 , cmbType.cbkeydata )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_ctad_012r" then
		sWA_PRNM			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "WA_PRNM" , 0 )
		sCNRC_MTRT_DATE	= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "CNRC_MTRT_DATE" , 0 )
		sLNKD_ACNO		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "LNKD_ACNO" , 0 )
		sLNKD_ASNO		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "LNKD_ASNO" , 0 )
		sWA_VLTN_AMT		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "WA_VLTN_AMT" , 0 )
		sFEE_AMT			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "FEE_AMT" , 0 )
		
		sCNRC_MTRT_DATE = Mid(sCNRC_MTRT_DATE, 1, 4).."년"..Mid(sCNRC_MTRT_DATE, 5, 2).."월 "..Mid(sCNRC_MTRT_DATE, 7, 2).."일"		
		sLNKD_ACNO = Mid(sLNKD_ACNO, 1, 4).."-"..Mid(sLNKD_ACNO, 5, 4)
		
		'tblInfo.SetCellString(0, 1, sWA_PRNM)
		lblName.caption = sWA_PRNM
		tblInfo.SetCellString(1, 1, sCNRC_MTRT_DATE)
		tblInfo.SetCellString(2, 1, sLNKD_ACNO.."-"..sLNKD_ASNO)
		tblInfo.SetCellString(3, 1, sWA_VLTN_AMT)
		tblInfo.SetCellString(4, 1, sFEE_AMT)
		
		sRQST_SRNO		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "RQST_SRNO" , 0 )
		sDRNG_SCDL_DATE	= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "DRNG_SCDL_DATE" , 0 )
		sWA_CNRC_TIMS		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "WA_CNRC_TIMS" , 0 )
		sWA_CANC_CLCD		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_012r", "OutBlock1", "WA_CANC_CLCD" , 0 )
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "RQST_SRNO" , 0 , sRQST_SRNO )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "DRNG_SCDL_DATE" , 0 , sDRNG_SCDL_DATE )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_CNRC_TIMS" , 0 , sWA_CNRC_TIMS )
		
		if Len(Trim(sWA_CANC_CLCD)) > 0 then
			btnCancel.caption = "해지 신청 완료"
			btnCancel.enable = false
		end if
		
		if Len(Trim(sWA_PRNM)) == 0 then
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_023r", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_023r", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
			DATAMANAGER.RequestTranData( "obwat_ctad_023r" )
		end if
	elseif szTranID == "obwat_ctad_023r" then
		sWA_PRNM		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_PRNM" , 0 )
		sMTRT_DATE	= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock4", "MTRT_DATE" , 0 )
		
		sMTRT_DATE = Mid(sMTRT_DATE, 1, 4).."년"..Mid(sMTRT_DATE, 5, 2).."월 "..Mid(sMTRT_DATE, 7, 2).."일"
		
		'tblInfo.SetCellString(0, 1, sWA_PRNM)
		lblName.caption = sWA_PRNM
		tblInfo.SetCellString(1, 1, sMTRT_DATE)
	elseif szTranID == "obwat_ctad_011a" then
		Form.MsgBox("알림", "해지 신청이 완료되었습니다.", "", 8, "확인", "")
		
		tblInfo.SetCellString(0, 1, "")
		tblInfo.SetCellString(1, 1, "")
		tblInfo.SetCellString(2, 1, "")
		tblInfo.SetCellString(3, 1, "")
		tblInfo.SetCellString(4, 1, "")
		lblName.caption = ""
		cmbType.currentindex = 0
		
		cmbAcnt.currentindex = cmbAcnt.currentindex
	elseif szTranID == "obwat_onln_004r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sCnrcNo, sPrcdName
				sAcnt	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCnrcNo	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CNRC_NO" , i )
				sCsnm	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				'v0002
				cmbAcnt.cbadddatatext = sAcnt..sAsno..sCnrcNo.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.."-"..sCnrcNo.." "..sCsnm
			next
			
			tblInfo.visible = true
			lblName.visible = true
			cmbType.visible = true
			imgToolTip0.visible = true
			
			cmbAcnt.currentindex = 0
			g_sAcno = Left(cmbAcnt.cbkeydata, 8)
			g_sAsno = Mid(cmbAcnt.cbkeydata, 9, 2)			'v0002
			g_sCnrcNo = Right(cmbAcnt.cbkeydata, 3)
			DATAMANAGER.RequestTranData( "obwat_ctad_012r" )
		else
			lblAcntNodata.visible = true
			lblNoData.visible = true
		end if
	end if
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
'	f_SetClear()
	g_sAcno = Left(cmbAcnt.cbkeydata, 8)
	g_sAsno = Mid(cmbAcnt.cbkeydata, 9, 2)			'v0002
	g_sCnrcNo = Right(cmbAcnt.cbkeydata, 3)
	
	btnCancel.caption = "해지 신청"
	btnCancel.enable = true
	
	DATAMANAGER.RequestTranData( "obwat_ctad_012r" )
End Sub

'============================================================================
Sub btnCancel_OnClick()
	if (g_sCnrcNo <> nil and g_sCnrcNo <> "") then
		'v0002
		Form.openPopupAnimation("pwdcheckpopup", g_sAcno & g_sAsno & "☆0" ,"","2")
	else
		Form.MsgBox("알림", "계약번호를 선택해주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				DATAMANAGER.RequestTranData( "obwat_ctad_011a" )
			end if
		end if
	end if
End Sub

'============================================================================
Sub imgToolTip0_OnClick()
	Dim sText
	sText = "평가금액은 현재 조회 기준 총평가금액이며 실제 환매 처리시 자산의 매도 가격에 따라 일부 변동될 수 있습니다."
	imgToolTip0.openToolTip( sText, 300, 80, 1 )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
Sub f_SetClear()
'	cmbAcnt.clear = true
	
	tblInfo.SetCellString(0, 1, "")
	tblInfo.SetCellString(1, 1, "")
	tblInfo.SetCellString(2, 1, "")
	tblInfo.SetCellString(3, 1, "")
	tblInfo.SetCellString(4, 1, "")
	lblName.caption = ""
	
	tblInfo.visible = false
	lblName.visible = false
	cmbType.visible = false
	
	imgToolTip0.visible = false
	
	lblNoData.visible = false
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgToolTip0.setMaintainingRatio("1")
End Sub

