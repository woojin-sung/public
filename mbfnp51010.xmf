'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum, nTIdx ' 문항번호, 테이블 인덱스
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1

	nAnswerCnt = g_tAnswerCnt[nTIdx]

	Select case nQNum
	    ' 버튼형 답변
	    case 1
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("contInput.contType1.ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("contInput.contType1.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next
	    case 2, 3
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("contInput.contType2.ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("contInput.contType2.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next
    End Select
    
End Function

