'============================================================================
'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Function f_InitUI()
	
	f_SetToggleUI(-1)
	contInput.edtPassword.caption = ""
	
	contInput.LblPrcin.caption = ""

	'투자방식 초기화
	g_szSVNG_TYPE_CODE = ""
	Form.SetCtlProp("contInput.contType1.ImgQ1A1", "imgpath", unPressedImgPath)	
	Form.SetCtlProp("contInput.contType1.ImgQ1A2", "imgpath", unPressedImgPath)	
	Form.SetCtlProp("contInput.contType1.ImgQ1A3", "imgpath", unPressedImgPath)	
	
	'분배금지급방식 초기화
	g_szRNVS_YN = ""
	Form.SetCtlProp("contInput.contType2.ImgQ2A1", "imgpath", unPressedImgPath)	
	Form.SetCtlProp("contInput.contType2.ImgQ2A2", "imgpath", unPressedImgPath)	
	
	'운용보고서 초기화
	g_szMGRI_YN = ""
	g_szINAG_TYPE_CODE = ""
	Form.SetCtlProp("contInput.contType2.ImgQ321", "imgpath", unPressedImgPath)	
	Form.SetCtlProp("contInput.contType2.ImgQ3A2", "imgpath", unPressedImgPath)	
	Form.SetCtlProp("contInput.contType2.ImgQ323", "imgpath", unPressedImgPath)	
	Form.SetCtlProp("contInput.contType2.ImgQ3A4", "imgpath", unPressedImgPath)	
	
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	contInput.edtPassword.caption = ""
	if g_szSavePwd == "0" then
		contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
		contInput.edtPassword.caption = ""
	else
		contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	contInput.btnPwd.bringfront("1")
	
	
	contInput.contType2.top = 398	'(cint(contInput.contType1.top) - 14) + cint(contInput.contType1.height)	'400 + 40
	contInput.contNoti.top = 667	'cint(contInput.contType2.top) + cint(contInput.contType2.height)	'670 + 40
	contInput.contMemo.top = 818	'cint(contInput.contNoti.top) + cint(contInput.contNoti.height)	'825 + 40
'	contInput.btnBuy.top = 977		'cint(contInput.contMemo.top) + cint(contInput.contMemo.height)	'1025

	contInput.contType1.Label1.visible = 0
	contInput.contType1.imgToolTip.visible = 0
	contInput.contType1.Calendar0.visible = 0
	contInput.contType1.Label2.visible = 0
	contInput.contType1.Calendar1.visible = 0
	
	
	'투자방식 초기화
	contInput.contType1.ImgQ1A1.visible = true
	contInput.contType1.ImgQ1A2.visible = true
	contInput.contType1.ImgQ1A3.visible = false
	contInput.contType1.LblQ1A1.visible = true
	contInput.contType1.LblQ1A2.visible = true
	contInput.contType1.LblQ1A3.visible = false

	'유의사항 더보기
	contInput.contMemo.height = 160
	contInput.contMemo.tblMemo.visible = 1
	contInput.contMemo.tblAll.visible = 0
	contInput.contMemo.lblMore.visible = 1
	contInput.contMemo.lblMore.caption =  "더보기 >"
	
	contInput.contMemo.Label01.visible = 0
	contInput.contMemo.Label02.visible = 0
	contInput.contMemo.Label03.visible = 1
	contInput.contMemo.Label04.visible = 1
	contInput.contMemo.Label05.visible = 0
	'contInput.contMemo.Label06.visible = 0
	contInput.contMemo.Label03.top = 40
	contInput.contMemo.Label04.top = 100
		
	contInput.btnBuy.top = cint(contInput.contMemo.top) + cint(contInput.contMemo.height)
	
	'contInput.contMemo.Label03.caption = "이 금융상품은 예금자 보호법에 따라 보호되지 않습니다.\n" & "단, 증권매수 미사용 현금 잔액은 예금자보호법에 따라 원\n"& "금과 소정의 이자를 합하여 1인당 ″5천만원까지″(본 금융\n"  & "회사의 여타 보호상품과 합산) 보호합니다."
	
End Function

'============================================================================
'투자방식(저축방법) 초기화 (연금저축일 경우 임의식으로 FIX
'============================================================================
Function cmbSavetypeInit()

	if g_szSeper_Tax_YN = "Y" then	''분리과세하이일드 펀드 여부

		'투자방식 : 거치식(분리과세신청)
		contInput.contType1.ImgQ1A1.visible = false
		contInput.contType1.ImgQ1A2.visible = false
		contInput.contType1.ImgQ1A3.visible = true			
		contInput.contType1.LblQ1A1.visible = false
		contInput.contType1.LblQ1A2.visible = false
		contInput.contType1.LblQ1A3.visible = true
		
		contInput_contType1_ImgQ1A3_OnClick()
		
	else
	
		'투자방식 초기화
		contInput.contType1.ImgQ1A1.visible = true
		contInput.contType1.ImgQ1A2.visible = true
		contInput.contType1.ImgQ1A3.visible = false
		contInput.contType1.LblQ1A1.visible = true
		contInput.contType1.LblQ1A2.visible = true
		contInput.contType1.LblQ1A3.visible = false
		
		if contInput.cmbAccount.itemcodetype = "131" or g_szShortCd = "16090501"	then	'연금
			contInput_contType1_ImgQ1A1_OnClick()
			contInput.contType1.ImgQ1A1.enable = False
			contInput.contType1.ImgQ1A2.enable = False
	
		else	
			'디폴트 : 임의식
			contInput_contType1_ImgQ1A1_OnClick()
			contInput.contType1.ImgQ1A1.enable = True
			contInput.contType1.ImgQ1A2.enable = True
		end if
	
	end if

End Function

'============================================================================
'f_bCheckBeforeReg() : 펀드매수 적합성 체크
'============================================================================
Function f_bCheckBeforeReg()

	'계좌번호 존재 유무 체크
	if contInput.cmbAccount.total == "" or contInput.cmbAccount.total == null or Len(contInput.cmbAccount.total) < 8 then
		Form.MsgBox("알림", "계좌번호를 확인해주세요.", "", 0)
		return false
	end if
	
	if tonumber(contInput.LblPrcin.caption) <> NULL and tonumber(contInput.lblInvtAbleAmt.caption) <> NULL then
		if tonumber(g_szMinAmt) > tonumber(contInput.LblPrcin.caption) then
			Form.ShowAlert("알림", "신청하신 금액이 신규매수 최소매수금액보다 작습니다. 매수신청 금액을 확인하시기 바랍니다.")
			return false
		end if
		
		if	tonumber(contInput.LblPrcin.caption) > tonumber(contInput.lblInvtAbleAmt.caption) or tonumber(contInput.LblPrcin.caption) == 0 then
			Form.ShowAlert("알림", "매수신청금액을 확인바랍니다.")
			return false
		end	if
		
	else
		Form.ShowAlert("알림", "매수신청금액을 확인바랍니다.")
		return false
	end if
	
	if g_szSVNG_TYPE_CODE = "3" or g_szSVNG_TYPE_CODE = "4" then
		'적립식, 거치식 기간 체크
		Dim sSDate, sFDate
		sSDate = contInput.contType1.Calendar0.calyear &"-"& contInput.contType1.Calendar0.calmonth &"-"& contInput.contType1.Calendar0.calday
		sFDate = contInput.contType1.Calendar1.calyear &"-"& contInput.contType1.Calendar1.calmonth &"-"& contInput.contType1.Calendar1.calday
	
		If DateDiff("m", sSDate, sFDate) < 12 then
			Form.MsgBox("알림", "최소적립기간은 12개월입니다.", "", 0)
			return False
		elseIf DateDiff("m", sSDate, sFDate) >= 36 then
			Form.MsgBox("알림", "최대계약기간보다 큽니다.", "", 0)
			return False
		End If
		sPrd = DateDiff("m", sSDate, sFDate)
	else 
		sPrd = 0
	end if
	
	if g_szSeper_Tax_YN = "Y" then	''분리과세하이일드 펀드 여부	
		if g_nRemainLmt == 0 then
			Form.ShowAlert("알림", "은행연합회 한도조회 오류.")
			return false
		elseif g_nRemainLmt < CInt(contInput.LblPrcin.caption) then
			Form.ShowAlert("알림", "은행연합회 한도조회 초과.")
			return false
		end if	
	end if	
	
	if g_szRNVS_YN = "" or g_szRNVS_YN = null then	'분배금
		Form.ShowAlert("알림", "분배금 지급방식을 선택해주세요.")
		return false	
	end if
		
	if g_szMGRI_YN = "" or g_szMGRI_YN = null then	'운용보고서
		Form.ShowAlert("알림", "운용보고서 통보지를 선택해주세요.")
		return false	
	end if
	
	if g_szINAG_TYPE_CODE = "" or g_szINAG_TYPE_CODE = null then
		Form.ShowAlert("알림", "운용보고서 통보지를 선택해주세요.")
		return false
	end if
	
	
	'이용동의서류 제공방식 선택 여부 체크
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		Form.MsgBox("알림", "계약서류 제공방식을 선택해 주세요.", "", 0)
		return false
	else
		dim szData
		szData = contInput.contNoti.tblInfo.GetCellString( 0, 0 )
		if szData == "" or szData == null then
			if g_szNotiFlag == "talk" then
				Form.MsgBox("알림", "계약서류 통보지를 선택해주세요.", "", 0)
				'Form.MsgBox("알림", "핸드폰 번호를 등록해 주세요.", "", 0)
			elseif g_szNotiFlag == "email" then
				Form.MsgBox("알림", "계약서류 통보지를 선택해주세요.", "", 0)
				'Form.MsgBox("알림", "이메일 주소를 등록해 주세요.", "", 0)
			else
				Form.MsgBox("알림", "계약서류 통보지를 선택해주세요.", "", 0)
				'Form.MsgBox("알림", "핸드폰 번호 혹은 이메일 주소를 확인해 주세요.", "", 0)
			end if
			return false
		end if
	end if
	
	'적합
	return true
End Function

'============================================================================
'f_SetbtnBuyEnable() : 다음 버튼 상태 결정
'============================================================================
Function f_SetbtnBuyEnable()
	if g_Reg_YN = "Y" then	
		contInput.btnBuy.visible = true
		
		'이용동의서류 제공방식 선택 여부
		if g_szNotiFlag == "" or g_szNotiFlag == null then			
			contInput.btnBuy.enable = false
			Exit Function	
		end if
	
		'계약서류 통보처 정보 없는경우 비활성화
		if g_szUserInfoFlag == false then
			contInput.btnBuy.enable = false
			Exit Function		
		end if 
	
		'신청가능
		contInput.btnBuy.enable = true
		
	else
		contInput.btnBuy.enable = false
		Exit Function		
	end if
	
End Function

'============================================================================
'f_SetToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1
	szToggleImg0 		= "btn_line_n.9.png"	'"input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "btn_line_o.9.png"	'"input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "4"	'"127" 				'비활성 컬러
	szToggleColor1 	= "4" 				'활성화 컬러

	if nFlag == 0 then '알림,톡
		contInput.contNoti.Image0.SetAlpha(0)	'알림톡	'0:선택/1:미선택
		contInput.contNoti.Image1.SetAlpha(1)	'이메일
		contInput.contNoti.imgRdo0.imgpath = szToggleImg1
		contInput.contNoti.imgRdo1.imgpath = szToggleImg0
		contInput.contNoti.lblTalk.fgcolor = szToggleColor1
		contInput.contNoti.lblEmail.fgcolor = szToggleColor0
		contInput.contNoti.lblInfoText.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니  휴대폰 번호를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "talk"
	elseif nFlag == 1 then '이메일
		contInput.contNoti.Image0.SetAlpha(1)
		contInput.contNoti.Image1.SetAlpha(0)
		contInput.contNoti.imgRdo0.imgpath = szToggleImg0
		contInput.contNoti.imgRdo1.imgpath = szToggleImg1
		contInput.contNoti.lblTalk.fgcolor = szToggleColor0
		contInput.contNoti.lblEmail.fgcolor = szToggleColor1
		contInput.contNoti.lblInfoText.caption = "고객정보에 등록된 이메일로 발송되오니 이메일 주소를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "email"
	else
		contInput.contNoti.Image0.SetAlpha(1)
		contInput.contNoti.Image1.SetAlpha(1)
		contInput.contNoti.imgRdo0.imgpath = szToggleImg0
		contInput.contNoti.imgRdo1.imgpath = szToggleImg0
		contInput.contNoti.lblTalk.fgcolor = szToggleColor0
		contInput.contNoti.lblEmail.fgcolor = szToggleColor0
		contInput.contNoti.lblInfoText.caption = ""
		contInput.contNoti.tblInfo.visible = false
		contInput.contNoti.ImageInfo0.visible = false
		contInput.contNoti.lblInfoText.visible = false
		g_szNotiFlag = ""
		Exit Function
	end if
	contInput.contNoti.tblInfo.visible = true
	contInput.contNoti.ImageInfo0.visible = true
	contInput.contNoti.lblInfoText.visible = true
End Function

'============================================================================
'f_SetToggleData(sFlag) : 서류제공방법 DATA SET
'============================================================================
Function f_SetToggleData(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	Dim szData
	szData = ""
	if sFlag == "talk" then '알림,톡
		szData = contInput.contNoti.tblUserInfo.GetCellString(0, 1) '폰번호
	elseif sFlag == "email" then '이메일
		szData = contInput.contNoti.tblUserInfo.GetCellString(1, 1) '이메일
	end if
	if szData <> "" and szData <> null then
		contInput.contNoti.tblInfo.SetCellString(0, 0, szData)
		contInput.contNoti.tblInfo.SetCellString(0, 1, "변경하기 〉")		
		
		g_szUserInfoFlag = true
	else
		contInput.contNoti.tblInfo.SetCellString(0, 0, "")
		Form.MsgBox("알림", "선택한 통보지 주소를 확인해주세요.", "", 0)
		contInput.contNoti.tblInfo.SetCellString(0, 1, "등록하기 〉")
		
		g_szUserInfoFlag = ture
		'g_szUserInfoFlag = false	'"선택한 통보지 주소를 확인해주세요." 메시지박스 추가하고 버튼 활성화!
	end if
End Function

'============================================================================
'f_CheckPwd() : 비밀번호 입력여부 체크
'============================================================================
Function f_CheckPwd()
	if contInput.edtPassword.caption == "" or contInput.edtPassword.caption == null 
		or Len(contInput.edtPassword.caption) < 4 then
		
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
		return false
	else
		return true
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Sub Form_OnFormInitBefore()	
	g_IsFormLoad = False
	
	ImgBackPress.setMaintainingRatio("1")
	
	contInput.contType1.imgTooltip.setMaintainingRatio("1")
	
	contInput.contNoti.imgTooltip.setMaintainingRatio("1")	
	contInput.contNoti.Image0.setMaintainingRatio("1")	
	contInput.contNoti.Image1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	szTheme = Form.GetEnvData("common.theme")
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	
	unPressedImgPath = "btn_line_n.9.png"
	PressedImgPath   = "btn_line_o.9.png"


	ResetItems()
	f_InitUI()

	'연금펀드 선택시 연금계좌 셋팅되도록..
	'Account1 : 연금계좌만 있고, Account0 : 연금계좌만 뺀 나머지 모두.
	if Form.GetSharedData("51000_PNSN_YN") = "Y" then
		contInput.cmbAccount.caption = contInput.Account1.caption
		
		contInput.cmbAccount.itemcodetype = "131"
		contInput.cmbAccount.statusexcept = "4"
				
		contInput.cmbAccount.ReloadAccount()
		
		if CInt(contInput.cmbAccount.accountcount) == 0 then
			Form.MsgBox("알림", "선택하신 펀드는 연금전용펀드입니다.\n연금저축계좌 개설 후 매수가능합니다.", "Account", 0)
				
		end if		
		
	else
		contInput.cmbAccount.caption = contInput.Account0.caption	
	end if
	
		
	g_szAccNo	=	left(contInput.cmbAccount.caption, 8)
	g_szAsNo		=	mid(contInput.cmbAccount.caption, 9, 2)
	
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_szShortCd 			= tData[0]
		g_szStndCd 			= tData[1]

		DATAMANAGER.RequestTranData("oocwi_mall_003r")
	end if
	

	'계좌 체크
	if g_szAccNo <> "" and g_szAccNo <> null then 
		DATAMANAGER.RequestTranData("obcsb_acif_140r")
		DATAMANAGER.RequestTranData("obcsb_acif_140r_1")
		DATAMANAGER.RequestTranData("obpds_srvc_380r")
		if	g_szShortCd	<>	""	then
			'투자방식(저축방법) 초기화
			if contInput.cmbAccount.itemcodetype <> "" then
				cmbSavetypeInit()
			end if
			
			DATAMANAGER.RequestTranData("obsim_idmn_018r")			
		end if
	end if


	contInput.SetScrollAutoSize()
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contInput.setScrollBarVisible("2")
	end if
	
	g_IsFormLoad = True
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'은행연합회 한도조회 타이머
	If trim(sTimerID)	=	"5555"	then
		Form.SetTimerEvent2(sTimerID, 0, 1.5)

		'재조회
		DATAMANAGER.RequestTranData("obaci_acct_089r")
	end	if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'===============================================
	' 가격입력창에서 리턴
	'===============================================
	if sKeyName == "PRC_POPUP" then	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			contInput.ImgPrcreset.visible = true
			g_szPopPrc = sRet
			
			contInput.LblPrcin.mask="0,0,,원,0,,0,1,0,0,0"
			
			if tonumber(sRet) > tonumber(contInput.lblInvtAbleAmt.caption) then
				contInput.LblAlert.caption = "잔여수량을 확인해주세요."
			end if
			contInput.LblAlert.visible = 1
			
			call contInput_LblPrcin_OnClick()
		else
			contInput.ImgPrcreset.visible = false
			contInput.LblAlert.caption = ""	'' 
			contInput.BtnPrcin.caption = "금액을 입력해주세요"
			
			contInput.LblAlert.visible = 0			
		end if
	
	elseif	sKeyName = 	"KYCCHK_RETURN"	then
		if	sRet	=	"Y"	then	'예				
			g_szDRVT_YN			= Form.GetSharedData("KYC_DRVT_PROS_YN", 0 )	'6. '파생상품등급코드
			g_szDRVT_YN			= Form.GetSharedData("KYC_DRVT_PROS_YN", 0 )	'7. KYC 파생 처리 여부
			g_szCAFU_TRGT_YN		= Form.GetSharedData("CAFU_TRGT_YN", 0 )	'8. v006. 숙려대상여부 
			
			g_Reg_YN = "Y"
			contInput.btnBuy.enable = true

		else	'아니오
			g_Reg_YN = "N"
			contInput.btnBuy.enable = false
			Exit Sub
			
		end if
		
		DATAMANAGER.RequestTranData("obcsb_acad_106r")			'실질수익률보고서 통보처 조회
		
	'===============================================
	'********** 고객정보 변경 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName = "mbonl81000" Then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if
		
	'-----------------------------------------------
	'펀드 실질투자수익률 보고서 통보처 팝업 v003
	'-----------------------------------------------
	elseif	sKeyName =	"returnACTL_RPRT_INAG"	then

		'통보처 등록 성공
		if	sRet =	"SUCC" then
			
			DATAMANAGER.RequestTranData("obcsb_acad_106r")
		'통보처 등록 실패
		else
			Form.ShowAlert("알림", "펀드 실질투자수익률 보고서 통보처 선택은 필수입니다.")
			Form.openPopupAnimation("mbfnp51010_p10" , "통보처★" & g_szAccNo, "2")
		end if
		
	'===============================================
	'********** 약관 동의 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbfnp51010_p16" Then	
		if sRet == "ok" then
			Form.OpenPopup("mbfnp51010_p18" , "" , "")	
		end if
		
	'===============================================
	'********** 이해여부확인 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbfnp51010_p18" Then	
		if sRet == "ok" then
			Dim sSendData
			sSendData = contInput.cmbAccount.total&contInput.cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
		end if
		
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	Elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contInput.edtPassword.pwdlen = tData(1)
				contInput.edtPassword.caption = tData(0)
			end if
			
			'인증서 팝업 호출..
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		end if
		
	'==============================================
	'*********** 공동인증서 성공여부 리턴 ************
	'==============================================
	elseif sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공			
				DATAMANAGER.RequestTranData("obacp_comm_008r")					'계좌정보에서 권유자, 관리자 가져옴

			
		else						'실패
		
			contInput.btnBuy.enable = false
			exit sub
		end if
		
	'-----------------------------------------------
	'숙려안내 popup return
	'-----------------------------------------------	
	elseif	sKeyName = "mbonl81010_p9"		then						'고위험거래확인팝업
		if 	sRet = 	"OK" then				
			'완료 페이지	'계좌번호&일련번호★펀드명★잔고번호★투자방식★매수금액★기준가적용일★결제예정일★선취수수료★종목코드★계좌비밀번호★숙려여부
			Form.OpenPopup("mbfnp51010_p19", g_szAccNo & g_szAsNo  & "★" & g_szFndname  & "★" & g_szSrno & "★" & g_szSVNG_TYPE_CODE
											& "★" & contInput.LblPrcin.caption & "★" & "XXX" & "★" & "XXX" & "★" & g_szPRCP_FEE
											& "★" & g_szShortCd & "★" & contInput.edtPassword.caption & "★Y"
								, sPosInfo)		
		end if
	
	'===============================================
	'********** 신청 완료 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbfnp51010_p19"  Then 	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			g_szRet = sRet
			Form.CloseForm()
		end if
		
	End If
End Sub

'============================================================================
Sub contInput_cmbAccount_ChangeAccount()
	ResetItems()			'초기화
	f_InitUI()

	contInput.SetScrollAutoSize()
	
	if g_IsFormLoad and (CInt(contInput.cmbAccount.accountcount) > 0) then
		DATAMANAGER.RequestTranData("obpds_srvc_380r")
		DATAMANAGER.RequestTranData( "obsim_idmn_018r" )
	end if
	
	cmbSavetypeInit()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_szAccNo	=	left(contInput.cmbAccount.caption, 8)	'계좌번호
	g_szAsNo		=	mid(contInput.cmbAccount.caption, 9, 2)	'계좌순번
	
	g_szFnprJoinSrno	= Form.GetSharedData( "FNPR_JOIN_SRNO", false )	'금융상품일련번호
	Form.SetSharedData("MBFNP51010_T1_FNPRJOINSRNO", g_szFnprJoinSrno)
	
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		g_szPasswd = contInput.edtPassword.caption
	Else
		 g_szPasswd = contInput.edtPassword.encdata
	    if Trim(g_szPasswd) == "" or Trim(g_szPasswd) == null then
		    g_szPasswd = contInput.edtPassword.caption
	    end if
	End If
	
	'고객번호
	dim szCust_Num
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	'---------------------------------------
	'펀드정보조회
	'---------------------------------------
	if	szTranID	=	"oocwi_mall_003r"	then
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "ISCD", 0, g_szStndCd)
	
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
		
	elseif	szTranID	=	"obaci_acct_009c"	then			'집합투자증권펀드등록
		
	
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "UI_CUST_CONT_CLS_CODE", 0, "4")
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ACNO", 0,	g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ASNO", 0,	 g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "CNRC_PRD"			, 0	, sPrd)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ISCD"				, 0	, g_szShortCd)
'		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE"	, 0	, g_szSVNG_TYPE_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "RCMD_EMPNO"			, 0	, g_szCanvasserCode)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MANG_EMPNO"			, 0	, g_szManagerCode)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MGRI_INFR_YN"		, 0	, g_szMGRI_YN)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MGRI_RPRT_INAG_TYPE_CODE", 0, g_szINAG_TYPE_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "RNVS_YN"				, 0	, g_szRNVS_YN)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ATMT_RPRC_YN"		, 0	, "0")
'		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0	,  g_szSPTX_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "INSU_JOIN_YN"		, 0	, g_szLNKD_PROD_YN)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "KYC_DVPD_EPMD_CODE"	, 0	,  g_szDVPD_EPMD_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "KYC_DRVT_PROS_YN"		, 0	,  g_szDRVT_YN)
		
		'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "SVNG_ENCR_ACNT_YN" 	, 0 	, "N" ) '저축 장려계좌 여부
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "CAFU_TRGT_YN" 		, 0 	, g_szCAFU_TRGT_YN ) '숙려대상여부
		'v007
		if g_szSTPL_YN = "Y" then
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "SVNG_ENCR_ACNT_YN" 	, 0 	, "SS" ) '저축장려계좌여부  SS 증권
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "AFCO_EMPNO" 			, 0 	, g_szAFCO_EMPNO ) '계열사직원번호
		else 
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "SVNG_ENCR_ACNT_YN" 	, 0 	, "N" ) '저축 장려계좌 여부
		end if
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		
		'21.07.15 JHY START
		'v008
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BYOV_AMT", 0	,  Trim(contInput.LblPrcin.caption))		'매수금액
		'21.07.15 JHY END
		
		
		if g_szSeper_Tax_YN = "Y" then	''분리과세하이일드 펀드 여부	
			if Form.GetSharedData("AGRM_RQCL_DOCU_CLCD_51010")	=	"1"  then
				szAGRM_RQCL_DOCU_CLCD = "1"
			else
				szAGRM_RQCL_DOCU_CLCD = "2"
			end if
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE"	, 0	,	g_szSVNG_TYPE_CODE)	'집합투자증권저축유형코드
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0	,	"8")	'종합 분리과세 구분 코드
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "CNRC_AMT"			, 0	,	Trim(contInput.LblPrcin.caption))	'계약 금액 = 매수 금액
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "PROS_CMPT_YN"		, 0	, 	g_PROS_CMPT_YN)		
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "LNKD_TLMS_MNNO"		, 0	, 	g_szLNKD_TLMS_MNNO)		
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock2", "AGRM_RQCL_DOCU_CLCD"	, 0	, 	szAGRM_RQCL_DOCU_CLCD)	'동의징구서류구분코드
		else
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE"	, 0	,	g_szSVNG_TYPE_CODE)
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0	, 	g_szSPTX_CODE)
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "PROS_CMPT_YN"		, 0	, 	g_PROS_CMPT_YN)		
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "LNKD_TLMS_MNNO"		, 0	, 	g_szLNKD_TLMS_MNNO)
		end if
		
		'21.08.19 JHY START (v009)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IISC_JOIN_APLT_NO", 0	, "")		'집합투자증권가입신청번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RECDNG_NO", 0	, "")			'녹취번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ODER_GRP_NO", 0	, "")			'주문그룹번호
		'21.08.19 JHY END
	
		'v012 Sta
		'MANL_RCPC_CLS_CODE : 공통팝업 처리로 넣어줄 필요가 없음 / FNPR_JOIN_SRNO : Data Set
		'21.08.19 JHY START (v010)	
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MANL_RCPC_CLS_CODE", 0	, cont01.cmbReceive.cbkeydata)		'설명서수신처구분코드
		'21.08.19 JHY END
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_SRNO"	, 0		, g_szFnprJoinSrno )		'금융상품일련번호
		'v012 Fin
		
	elseif	szTranID	=	"obacp_comm_008r"	then		'개별계좌 정보조회
		DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNO" , 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ASNO" , 0, g_szAsNo)
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		
	'v003
	elseif	szTranID =	"obcsb_acad_106r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_106r", "InBlock1", "ACNO" , 0, g_szAccNo)
	'v007
	elseif	szTranID =	"obpds_srvc_380r" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_380r", "InBlock1", "ACNO", 0,	g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_380r", "InBlock1", "ASNO", 0,	 g_szAsNo)
	
	'21.07.06 JHY START
	'v013
	elseif	szTranID	=	"obsat_deal_109r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, g_szAsNo)
	'21.07.06 JHY END
	
	'고객투자성향 및 상품위험등급조회
	elseif	szTranID	=	"obcsb_acif_400r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0, g_szShortCd)
		
	elseif szTranID == "obcsb_acad_122a" then			
		dim strCustTelno, strAddr, strInagTypeCode, strInagSrno

		if g_szNotiFlag == "talk" then
			strCustTelno = contInput.contNoti.tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = contInput.contNoti.tblUserInfo.GetCellString(0, 2)
			strInagSrno = contInput.contNoti.tblUserInfo.GetCellString(0, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
		elseif g_szNotiFlag == "email" then
			strAddr = contInput.contNoti.tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = contInput.contNoti.tblUserInfo.GetCellString(1, 2)
			strInagSrno = contInput.contNoti.tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , strAddr)
		End If 
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	
	'폰번호, 이메일 조회
	elseif szTranID == "obcsb_acif_140r" or szTranID == "obcsb_acif_140r_1" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , g_szAccNo)	
			
	'종합계좌 정보 조회
	elseif	szTranID == "obacp_comm_007r" then

		DATAMANAGER.SetDataValue( 0, "obacp_comm_007r", "InBlock1", "ACNO"     , 0 , g_szAccNo )

		'v005
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNT_PWD" , 0, g_szPasswd )
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNT_PWD" , 0, Form.GetEncData(g_szPasswd))
		end if
		
		DATAMANAGER.SetDataValue( 0, "obacp_comm_007r", "InBlock1", "IQRY_CLS_CODE" , 0 , "9" )
	
	'은행연합회 한도금액 조회
	ElseIf szTranID == "obaci_acct_089r" Then
		szProdCd = Form.GetAccountInfo(g_szAccNo..g_szAsNo, "productcode")	'계좌상품코드

		If g_bTrTimer Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE"  , 0 , 	"2"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"          		, 0 , 	g_szAccNo	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"          		, 0 , 	g_szAsNo	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRCD"          		, 0 , 	szProdCd	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"          		, 0 , 	""	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TXCM_PRCD"          	, 0 , 	"93"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TXCM_TRPR_CLS_CODE"	, 0 , 	"0"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"		, 0 , 	"1"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"		, 0 , 	g_szLnkdTlmsMnno	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"			, 0 , 	""	)  
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE"  , 0 , 	"1"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"          		, 0 , 	g_szAccNo	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"          		, 0 , 	g_szAsNo	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRCD"          		, 0 , 	szProdCd	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"          		, 0 , 	""	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TXCM_PRCD"			, 0 , 	"93"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TXCM_TRPR_CLS_CODE"	, 0 , 	"0"	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"		, 0 , 	"1"	) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"		, 0 , 	""	)  
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"			, 0 , 	""	)  
		End If
	
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szProdCd
	szProdCd = Form.GetAccountInfo(g_szAccNo..g_szAsNo, "productcode")	'계좌상품코드

	g_szScrno = "51000"
	g_szBswr = "02"
	g_szDiv = "16001"
	
	if	szTranID	=	"oocwi_mall_003r"	then
		Dim szGradCode, szTransGradNm, szTypeNm, szFundName
		
		szGradCode = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "PROD_GRAD_CODE", 0) 	'펀드등급
		szTransGradNm = Form.GetMetaData("집합투자증권상품등급코드", szGradCode)
		contInput.lblRiskNm.caption = szTransGradNm
		'contInput.lblRiskNm.fgcolor = 261
		
'		if szGradCode = "01" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_296.png"
'		elseif szGradCode = "02" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_297.png"
'		elseif szGradCode = "03" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_298.png"
'		elseif szGradCode = "04" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_299.png"
'		elseif szGradCode = "05" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		else
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		end if
		if szGradCode = "01" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_372.png"
			contInput.lblRiskNm.fgcolor = 273
		elseif szGradCode = "02" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_373.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "03" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_374.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "04" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_375.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "05" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_376.png"
			contInput.lblRiskNm.fgcolor = 144
		else
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_377.png"
			contInput.lblRiskNm.fgcolor = 273
		end if
		szTypeNm = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_TYPE_NAME", 0) 	'펀드유형		
		contInput.lblTypeNm.caption = szTypeNm
		contInput.ImgBadge2.imgpath = "img_bgsquare_grade_316.png"
		
		szFundName = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_KOR_FUND_NAME", 0)	'펀드명
		contInput.lblFundNm.caption = szFundName
		contInput.lblFundNm.SetMaxLineCount(2)	'컨트롤 라인 제한 함수
		g_szFndname = szFundName
		
	'------------------
	'펀드기본정보조회
	'------------------
	elseif	szTranID	=	"obsim_idmn_018r"	then		
		g_szSPTX_CODE = DATAMANAGER.GetDataValue(0,"obsim_idmn_018r", "OutBlock4", "OVRL_SPTX_CLS_CODE", 0)
		g_szLNKD_PROD_YN = DATAMANAGER.GetDataValue(0, "obsim_idmn_018r", "OutBlock6", "INSU_LNKD_PROD_YN", 0)
		g_szVNTR_IVTR_YN = DATAMANAGER.GetDataValue(0, "obsim_idmn_018r", "OutBlock5", "VNTR_ETPR_IVTR_YN", 0) 'v002

		'21.08.03 JHY START : 최소매수금액 제어 추가 (정우희 주임님 요청)
		g_szMinAmt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "STA_SDPR", 0) 'v002
		'21.08.03 JHY END
				
				
		szSaComCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IISC_ITCO_CODE", 0) 	'집합투자증권투자신탁회사코드 = "511" : 계열사
		szHGDTYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "HGDT_PROD_YN", 0)	'고난도상품여부
		szFITYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "FIT_PROD_YN", 0)	'적정성상품여부				
		
		'----- 적정성/고난도 유형 -----
		''적정성이나 고난도인 경우, 위험등급|펀드유형|적정성/고난도|계열사 순으로 뱃지 보이고
		''적정성이나 고난도가 아닌 경우, 위험등급|펀드유형|계열사 뱃지만 보이도록 뱃지 위치 조정	
		if szFITYn = "Y" or szHGDTYn = "Y"  then			
			if szFITYn == "Y" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_302.png"
				contInput.lblBadge3.caption = "적정성상품"
				contInput.lblBadge3.fgcolor = 261
			end if
			
			if szHGDTYn == "Y" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_302.png"
				contInput.lblBadge3.caption = "고난도상품"
				contInput.lblBadge3.fgcolor = 261
			end if
			'----- 적정성/고난도 유형 -----
				
			'----- 계열사구분코드 -----
			if szSaComCode = "511" then
				contInput.ImgBadge4.imgpath = "img_bgsquare_grade_303.png"
				contInput.lblBadge4.caption = "계열사"
				contInput.lblBadge4.fgcolor = 261
			else
				contInput.ImgBadge4.imgpath = "alpha.png"
				contInput.lblBadge4.caption = ""
				contInput.lblBadge4.fgcolor = 261
			end if
			'----- 계열사구분코드 -----
		
		else			
			'----- 계열사구분코드 -----
			if szSaComCode = "511" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_303.png"
				contInput.lblBadge3.caption = "계열사"
				contInput.lblBadge3.fgcolor = 261
			else
				contInput.ImgBadge3.imgpath = "alpha.png"
				contInput.lblBadge3.caption = ""
				contInput.lblBadge3.fgcolor = 261
			end if
	
			contInput.ImgBadge4.imgpath = "alpha.png"
			contInput.lblBadge4.caption = ""
			contInput.lblBadge4.fgcolor = 261
			'----- 계열사구분코드 -----
		end if
				
				
				
		'v011
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD", 0 , "02") '추가매수
		DATAMANAGER.RequestTranData("obsai_deal_701r")

		'01. 분리과세조건
		if g_szSPTX_CODE == "8" and (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then			
			DATAMANAGER.RequestTranData("obacp_comm_007r")	'종합계좌 정보 조회	
		end if

	'---------------------------------------
	'종합계좌 정보 조회
	'---------------------------------------
	Elseif szTranID == "obacp_comm_007r" Then
		g_szCUST_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CUST_CLS_CODE", 0)	'1 : 개인
		g_szINMR_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INMR_CLS_CODE", 0)	'111 : 내국인(주민등록번호부여자)
		g_szRSDT_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSDT_CLS_CODE", 0)	'1 : 거주

		'02. 분리과세조건 '국내거주자가 하이일드펀드 선택시 저축방법 변경
		if g_szRSDT_CLS_CODE == "1" and g_szCUST_CLS_CODE == "1" and g_szINMR_CLS_CODE == "111" and g_szSPTX_CODE == "8" and 
							 (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then
		 
			'저축방법 구분 추가 : 거치식(분리과세 신청)
			DATAMANAGER.SetDataValue(0, "obsim_idmn_089r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
			DATAMANAGER.SetDataValue(0, "obsim_idmn_089r" , "InBlock1", "OVRL_SPTX_CLS_CODE", 0 , "8")			
			DATAMANAGER.RequestTranData("obsim_idmn_089r")	
		end if

	'---------------------------------------
	'종목_집합투자증권분리과세기간정보 조회
	'---------------------------------------
	elseif	szTranID	=	"obsim_idmn_089r"	then		
		szAPLY_STA_DATE	= DATAMANAGER.GetDataValue(0,   "obsim_idmn_089r", "OutBlock1", "APLY_STA_DATE" , 0)
		szAPLY_FIN_DATE	= DATAMANAGER.GetDataValue(0,   "obsim_idmn_089r", "OutBlock1", "APLY_FIN_DATE" , 0)

		nHostDate = Form.GetSharedData( "&HOST_DATE", false )	'오늘날짜
		
		'03. 분리과세조건	'매수신청일자가 szAPLY_STA_DATE 와 szAPLY_FIN_DATE 사이인 경우 구분코드 추가됨.
		if (szAPLY_STA_DATE <> nil and szAPLY_FIN_DATE <> nil ) and
					(CDBL(szAPLY_STA_DATE) <= CDBL(nHostDate))  and (CDBL(nHostDate) <= CDBL(szAPLY_FIN_DATE)) then

			'개인신용정보제공동의
			if g_szRSDT_CLS_CODE == "1" and g_szCUST_CLS_CODE == "1" and g_szINMR_CLS_CODE == "111" and g_szSPTX_CODE == "8" and 
							 (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then
							

				g_szSeper_Tax_YN = "Y"
				
				'분리과세이면.. 투자방식(저축방법) 다시 셋팅.
				cmbSavetypeInit()
				
				
				DATAMANAGER.RequestTranData("obaci_acct_089r")	''은행연합회 한도금액 조회
				
			else
				

				g_szSeper_Tax_YN = "N"
		
			end if

			
		else
		
			g_szSeper_Tax_YN = "N"
			
		end if

		
		
	'---------------------------------------
	'은행연합회 한도금액 조회
	'---------------------------------------
	ElseIf szTranID == "obaci_acct_089r" Then
		If g_bTrTimer Then
			Dim szProsClsCode
			szProsClsCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)			'처리구분코드
			'최초 조회 후에 PROS_CLS_CODE 가 "2"로 나올때까지 타이머 이용하여 재호출
			If szProsClsCode == "2" Then
				Dim szUI_SVNG_LIMT_UNSD_AMT, szJOIN_LIMT_AMT
				szUI_SVNG_LIMT_UNSD_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT", 0)	'UI저축한도 미사용금액
				szJOIN_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "JOIN_LIMT_AMT", 0)	'가입한도금액
				
