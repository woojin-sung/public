Sub contInput_contType1_ImgQ1A2_OnClick()
	'적립식인 경우 적립기간 노출
	contInput.contType1.Label1.visible = 1
	contInput.contType1.imgToolTip.visible = 1
	contInput.contType1.Calendar0.visible = 1
	contInput.contType1.Label2.visible = 1
	contInput.contType1.Calendar1.visible = 1
	

	'적립기간은 당월부터 12개월 후로 자동셋팅!
	tmp_date = LEFT(contInput.contType1.Calendar0.caption,4) & "-" & RIGHT(LEFT(contInput.contType1.Calendar0.caption,6),2)' & "-" & RIGHT(contInput.contType1.Calendar0.caption,2)
	tmpAfter1Year = CStr(DateAdd("d",0,DateAdd("m",12,CDate(CStr(tmp_date)))))
	tmpAfter1Year = Replace(tmpAfter1Year, "-", "")
		
	contInput.contType1.Calendar1.caption = tmpAfter1Year
			
	contInput.contType1.height = 150
	contInput.contType2.top = 438
	contInput.contNoti.top = cint(contInput.contType2.top) + cint(contInput.contType2.height)
	contInput.contMemo.top = cint(contInput.contNoti.top) + cint(contInput.contNoti.height)
	contInput.btnBuy.top = cint(contInput.contMemo.top) + cint(contInput.contMemo.height)
	
	g_szSVNG_TYPE_CODE = "3"
	SetCheckAnswer("1", "2")
		
	contInput.SetScrollAutoSize()
End Sub
