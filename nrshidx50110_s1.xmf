		<LABEL name="lblSubTitle" fontstyle="01" caption="투자지역" bgcolor="029:255212175" ly_vert="20,17,200,22,1" />
		<PANNEL name="Pannel0" ly_vert="0,50,375,394,1" >
			<CONTROL_INFO>
				<LABEL name="lblNation0" fontsize="-2" halign="1" multiline="1" click="1" ly_vert="20,0,105,36,1" />
				<LABEL name="lblNation1" fontsize="-2" halign="1" multiline="1" click="1" ly_vert="135,0,105,36,1" />
				<LABEL name="lblNation2" fontsize="-4" halign="1" multiline="1" click="1" ly_vert="250,0,105,36,1" />
				<IMAGE name="imgFlag0" autosize="1" ly_vert="32,9,25,18,1" />
				<IMAGE name="imgFlag1" autosize="1" ly_vert="147,9,25,18,1" />
				<IMAGE name="imgFlag2" autosize="1" ly_vert="262,9,25,18,1" />
			</CONTROL_INFO>
			<CARD_INFO cardheight="36" gap="10" >
				<CELL name="imgFlag0" />
				<CELL name="imgFlag1" />
				<CELL name="imgFlag2" />
