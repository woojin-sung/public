	<SCRIPT_INFO _len="1642" _ulen="1530" >
'============================================================================
' 화 면 명 : 반대의사 신청팝업 유의사항, 매수청구 신청팝업 유의사항
' 작    성 : 2023.10.06 KKM
'============================================================================
Dim g_nChkRow	'체크한 그룹의 행
g_nChkRow = -1

'============================================================================
Sub Form_OnFormInit()
	grdGroup.rowcount = 2
	grdGroup.SetCellData("bd_name", 0, "국내CFD종목선택")
	grdGroup.SetCellData("bd_name", 1, "해외CFD종목선택")
	
	Dim szData
	szData = Form.GetOpenLinkData()		
	if Trim(szData) <> "" then
		g_nChkRow = CInt(szData)
		grdGroup.selectrow = g_nChkRow
		grdGroup.SetCellData("bd_mark", g_nChkRow, "1")			
	End if	

End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("nrsbtrc21002_p6", g_nChkRow)
End Sub

'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)
	if Cint(g_nChkRow) = -1 then	'그룹선택 1개만 가능
		g_nChkRow = lRow
		grdGroup.SetCellData("bd_mark", g_nChkRow, "1")	
	else
		grdGroup.SetCellData("bd_mark", g_nChkRow, "0")	
		g_nChkRow = lRow
		grdGroup.SetCellData("bd_mark", g_nChkRow, "1")	
	end if
	
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()	
End Sub
	</SCRIPT_INFO>
