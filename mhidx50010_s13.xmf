'============================================================================
Function RequestData()

	DATAMANAGER.ClearInputData(0, "ohhts_1500_001r")
	
	'---------------------
	' 다우지수
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "DJI@DJI")
	
	'---------------------
	' 나스닥
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 1 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" 				, 1 , "NAS@IXIC")
	
	'---------------------
	' S&P500
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 2 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" 				, 2 , "SPI@SPX")
	
	'---------------------
	' 필라델피아 반도체
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 3 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" 				, 3 , "NAS@SOX")
	
	'---------------------
	' 서비스 호출
	'---------------------
	DATAMANAGER.RequestTranData("ohhts_1500_001r")

End Function
'============================================================================
