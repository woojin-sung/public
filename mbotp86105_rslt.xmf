'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'20230803 SWJ START : g_sSecurity 분기 추가
'간편인증 발급 프로세스일 때만 90190_s3으로 이동 
'그 외 진입 시에는 각 업무화면 맵에서 Form_OnLinkData로 받아서 다음 프로세스 이동 제어
'(Form_OnLinkData는 모든 화면 다 받으므로 주의 필요)
	if sKeyName == "mhetc90060_motp" and sRet == "ok" then
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			
			Form.PostLinkData("&CommonNoSecurity" , 6)
			Form.CloseForm()
		else
			Form.OpenNextPopup("mhetc90190_s3" , "" , "")
		end if
	elseif sKeyName == "mhetc90060_otp" and sRet == "ok" then
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			Form.PostLinkData("&CommonNoSecurity" , 6)
			Form.CloseForm()
		else
			Form.OpenNextPopup("mhetc90190_s3" , "" , "")
		end if
	elseif sKeyName == "mhetc90060_pb" and sRet == "ok" then
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			Form.PostLinkData("&CommonNoSecurity" , 6)
			Form.CloseForm()
		else
			Form.OpenNextPopup("mhetc90190_s3" , "" , "")
		end if
	elseif sRet == "cancel" then  '취소일 경우 결과화면 닫기
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			'Form.PostLinkData("&CommonNoSecurity" , 6)
		end if 
		Form.CloseForm()
	end if
End Sub
'20230803 SWJ END
'============================================================================
'로그인 시킬 때 로그인 창에서 던짐 (발급할 때 중간에 창이 안닫힘)
'20230609 SWJ : 임시
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&ATON_REGI" and Cint(sValue) == 6 then
		Form.CloseForm()
	end if
End Sub


