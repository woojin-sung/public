	<SCRIPT_INFO _len="20136" _ulen="18084" >
'--===========================================================================
' 2023-04-18 양현정 v001 비대면인 경우 분기처리 추가
'--===========================================================================
Dim	g_IntoClcd
Dim	g_RcnoPip
Dim	g_Csno
Dim	g_rsltYN
Dim	g_BtnClcd
Dim	g_ApltYN_6
Dim	g_ApltYN_9
Dim	g_OSClcd
Dim g_szMotp
Dim gAthnMdiaUseYn 'v001
Dim gElfnIdExstYn  'v001
Dim gNmetProsCd 'v001	1:홈으로 2:ID등록 3:바이오인증
Dim g_IDRegYN, g_IDRegAcno
Dim g_sSecurity		'20230803 SWJ START
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	g_OSClcd	= Trim(Form.GetSharedData("&OS_TYPE", false)) '1:안드로이드, 2:ios
	'g_almiYn	= Trim(Form.checkPUSH("check"))	'알리미 설치 여부	' 20211110 HWG : 모바일 푸시 업그레이드 (알리미앱 삭제)
'	container0.Table0.bgcolor = 276
	For ix = 0 To 8
		For jx = 0 To 3
			Container0.Table0.SetCellBgColor( ix, jx, 276 )
			If ix < 6 Then
				Container0.Table1.SetCellBgColor( ix, jx, 276 )
			End If
		Next
	Next
	
	container0.Table0.visible = FALSE
	container0.Table1.visible = FALSE

	g_ApltYN_6 = "N"
	g_ApltYN_9 = "N"

	g_IntoClcd = Form.GetSharedData( "mOTP_IntoClcd", False )
	
	'v001
	If g_IntoClcd == "NMET_ACNT" then
		gAthnMdiaUseYn = Form.GetSharedData( "gAthnMdiaUseYn", False )		'인증서 사용여부
		gElfnIdExstYn  = Form.GetSharedData( "gElfnIdExstYn" , False )		'ID 보유여부    	
	end if

'test code
'g_IntoClcd = "NMET_ACNT"
'g_IntoClcd = "NMET_BSWR"
'g_IntoClcd = "MTS"
'g_almiYn = "0"
	' 화면번호☆타이틀명☆성공YN☆메시지☆Data1☆Data2....
	szData = Form.GetOpenLinkData()

'test code
'szData = "86101☆모바일 OTP 발급☆Y☆R☆메리츠motp☆010201029100"
'szData = "86101☆모바일 OTP 발급☆N☆R☆메리츠motp☆010201029100"
'szData = "86101" & "☆" & "모바일OTP 비밀번호 재설정" & "☆" & "Y" & "☆" & "P" & "☆" & "NULL" & "☆" & "NULL"
'szData = "85230☆ID 등록☆Y☆R☆ctypton5s☆완료"
'szData = "85230☆ID 등록☆N☆R☆ctypton5s☆이미등록된 ID가 있습니다."
'szData = "86102☆다운로드☆N☆I☆비밀번호 오류 횟수 초과입니다.(PIN 잠김 오류)☆01030158301238"
'Form.ShowAlert("mbotp86105_rslt", "g_IntoClcd = [" & g_IntoClcd & "], LinkData = [" & szData & "]" )

'szData = "86106" & "☆" & "타기관 OTP 이용 등록" & "☆" & "Y" & "☆" & "R" & "☆" & "테스트" & "☆" & "99019991"

	g_szList = Split(szData, "☆")

	If UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_scrNo	= g_szList(0)
	g_titlNm	= g_szList(1)
	g_rsltYN	= g_szList(2)
	g_prosCd	= g_szList(3)
	g_rsltMsg	= g_szList(4)
	g_data1	= g_szList(5)
	
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_RcnoPip  = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
	
	'주민번호와 고객번호를 getshared 뒤지다가 안나오면 발급 시 set한 값 불러오도록 처리(ios쪽 처리때문)
	if g_RcnoPip == "" or g_RcnoPip == null then
		g_RcnoPip = Form.GetEnvData("login.session.juminnopip")
	end if

	Container0.Label0.caption = g_titlNM
	If g_scrNo == "86102" Then
		szTail = "가"
	Else
		szTail = "이"
	End If
	
	If g_rsltYN == "Y" Then
		Container0.Image1.visible = False
		
		container0.label1.caption = g_titlNM & szTail
		container0.label5.caption = "완료되었습니다."
		If g_scrNo == "85230" Then '"85210" Then 'ID등록에서 넘어온 경우
			container0.Table1.visible = TRUE
			Container0.Table1.SetCellString( 1, 1, "등록정보"	)
			Container0.Table1.SetCellString( 4, 1, "사용자 ID" 	)
			Container0.Table1.SetCellString( 4, 2, g_rsltMsg 	)
			Container0.lblRtry.visible = TRUE
		Else
			If g_prosCd == "R" OR g_prosCd =="D" Then
				container0.Table0.visible = TRUE
				container0.Table0.bgcolor = 276
				Container0.Table0.SetCellString( 4, 2, g_rsltMsg )
				Container0.Table0.SetCellString( 7, 2, RIGHT(g_data1, 12) )
				Container0.Label6.visible = FALSE
				Container0.lblRtry.visible = TRUE
				
				' 20211110 HWG START : 모바일 푸시 업그레이드 (알리미앱 삭제)
'				'알리미앱 설치 안내(안드로이드 & 모바일OTP발급인 경우)
'				If g_OSClcd == "1" And g_scrNo == "86101" Then
'					Container0.Label4.Top = 400 'Container0.Label4.Top + 36
'					Container0.Label3.Top = 428 'Container0.Label3.Top + 36
'					Container0.Label4.fontsize = -1
'					Container0.Label3.fontsize = -1
'					If g_almiYn == "0" Or g_IntoClcd == "NMET_ACNT" Then
'						Container0.Label4.caption = "발급하신 모바일 OTP 이용 시"
'						Container0.Label3.caption = "당사 메리츠알리미 앱을 설치하셔야 합니다."
'						Container0.btnPushInst.Caption = "메리츠알리미 설치"
'					Else
'						Container0.Label4.caption = "메리츠알리미 앱이 구버전인 경우 모바일 OTP 이용이"
'						Container0.Label3.caption = "원활하지 않을 수 있으니 업데이트 해주셔야 합니다."
'						Container0.btnPushInst.Caption = "메리츠알리미 업데이트"
'					End If
'					If g_IntoClcd <> "NMET_ACNT" Then
'						Container0.btnPushInst.visible = True
'					End If
'				End IF
				' 20211110 HWG END
			ElseIf g_prosCd == "P" Then '비밀번호 초기화
				container0.Table0.visible = FALSE
				Container0.lblLine.visible = False
			End If
		End If
		Container0.lblRtry.visible = False
		Container0.Image0.imgpath = "icon_ok.png"
	Else
		container0.label1.caption = g_titlNM & szTail 
		container0.label5.caption = "실패하였습니다."
		container0.Table0.visible = FALSE
		Container0.Label2.caption = g_rsltMsg
		
		'20230307 상세메시지 있는 경우에만 표시하도록 함.
		if len(trim(g_data1)) > 0 then
			Container0.Label6.visible = TRUE
			Container0.Label6.caption = "[" & g_data1 & "]"
		end if
		
		Container0.Label4.caption = "고객센터에 문의해주세요."
		Container0.Label3.caption = "1588-3400"
		Container0.lblRtry.visible = True
		Container0.lblLine.visible = False
		Container0.Image0.imgpath = "icon_error.png"
		Container0.Image0.top = 140
		Container0.Label1.top = 230
		Container0.Label5.top = 260
	End If
	
	'Form.ShowAlert("g_IntoClcd", g_IntoClcd)
	'Form.ShowAlert("g_scrNo"   , g_scrNo)
	'Form.ShowAlert("g_szMotp"  , g_szMotp)
	
	Select Case g_IntoClcd
		
		Case "NMET_ACNT"
			btnIDReg.visible = TRUE
			btnNxtDo.visible = TRUE
			If g_scrNo == "85230" Then '"85210" Then
				If g_rsltYN == "N" Then
					gNmetProsCd = "1"
					'f_BtnPosSetting( 1 )
				Else
					'v001 바이오인증등록시 홈으로..
					if gAthnMdiaUseYn == "Y" then
						gNmetProsCd = "1"						
					else
						gNmetProsCd = "3"
						'f_BtnPosSetting( 2 )
						Container0.lblIDRegGude.caption = "이어서 간편인증수단을 등록하시겠습니까?"
					end if										
				End If
			Else
				Form.PostLinkData( "mbotp86107", "ok" )
				
				'v001 ID이미 기보유시..
				if gElfnIdExstYn == "Y" then
					'v001 바이오인증 기보유시..
					if gAthnMdiaUseYn == "Y" then
						gNmetProsCd = "1"
					else
						gNmetProsCd = "3"
						Container0.lblIDRegGude.caption = "이어서 간편인증수단을 등록하시겠습니까?"					
					end if
				else		
					gNmetProsCd = "2"
					'f_BtnPosSetting( 2 )
					Container0.lblIDRegGude.caption = "이어서 ID를 등록하시겠습니까?"
				end if
			End If
			
			f_BtnPosSetting( gNmetProsCd ) 'v001
		Case "NMET_BSWR", "MTS"
			g_RcnoPIP	= Form.GetSharedData("&JUMIN_NUM", false )
			
			'20230710 비로그인으로 접근할 경우 위의 공유변수로 가져오지 못하니 전단계에서 가져옴
			if g_RcnoPIP == "" or g_RcnoPIP == null then
				g_RcnoPIP = Form.GetSharedData("BDM_RCNO_PIP", false)
			end if
'			Form.ShowAlert("g_RcnoPIP", g_RcnoPIP)
			
			'20230608 메리츠 간편인증 관련 내용 추가
			Dim szMotp
			g_szMotp = Form.GetSharedData("MeritzAuth_Security", true)	'20230615 SWJ START
			g_sSecurity = Form.GetSharedData("CommonNoSecurity", true )	 '20230803 SWJ START : 간편인증과 타 업무화면 진입 구분
			'g_sSecurity = "N"
'			szMotp = "MOTP"
			if g_szMotp == "MOTP" or g_szMotp == "OTP" then
				If g_szMotp == "OTP" Then '타기관 otp는 비대면 업무신청에서 들어옴
					g_ApltYN_6 = "Y"
					g_ApltYN_9 = "N"
					'DATAMANAGER.RequestTranData("obaci_nmet_005a")
				end if 
				Container0.lblIDRegGude.visible = false
				
				btnIDReg.visible = true
				btnIDReg.caption = "완료"
				
				btnIDReg.left = 0
				btnIDReg.width = 375
				exit sub
			else
				If g_scrNo == "86102" And g_rsltYN == "N" And g_prosCd == "I" Then
					f_BtnPosSetting( 2 )
				Else
					f_BtnPosSetting( 1 )
				End If
			end if
			
	End Select
	
	'If g_IntoClcd == "NMET_BSWR" And g_rsltYN == "Y" Then '업무신청으로 들어온 경우
	If g_rsltYN == "Y" Then '업무신청으로 들어온 경우 (업무신청 처리 업무는 여기서 tr 모두 태운다)
		If g_scrNo == "86106" Or g_scrNo == "86101" Then '타기관OTP등록 or 모바일OTP등록
			If g_scrNo == "86106" Then
				g_ApltYN_6 = "Y"
				g_ApltYN_9 = "N"
				DATAMANAGER.RequestTranData("obaci_nmet_005a")
				
			Else
				g_ApltYN_6 = "N"
				g_ApltYN_9 = "Y"
				DATAMANAGER.RequestTranData("obaci_nmet_005a")
			End If
		End If
	End If
End Sub

'============================================================================
Function f_BtnPosSetting( iBtnCnt )
	If iBtnCnt == 1 or iBtnCnt == "1" Then
		btnIDReg.visible 	= TRUE
		btnNxtDo.visible 	= FALSE
		btnIDReg.left		= 0
		btnIDReg.width		= 375
		btnIDReg.caption	= "홈으로"
	ElseIf iBtnCnt == 3 or iBtnCnt == "3" Then	'v001
		btnIDReg.visible 	= TRUE
		btnNxtDo.visible 	= TRUE
		btnNxtDo.fgcolor 	= 269
		btnIDReg.left		= 187
		btnIDReg.width	= 188
		btnNxtDo.caption	= "다음에 하기"
		btnIDReg.caption	= "바이오인증 등록"	
	Else
		btnIDReg.visible 	= TRUE
		btnNxtDo.visible 	= TRUE
		btnNxtDo.fgcolor 	= 269
		btnIDReg.left		= 187
		btnIDReg.width		= 188
		btnNxtDo.caption	= "다음에 하기"
		If g_scrNo == "85230" Then
			btnIDReg.caption	= "바이오인증 등록"
		ElseIf g_scrNo == "86102" Then
			btnIDReg.caption	= "모바일 OTP 재발급"
		Else
			btnIDReg.caption	= "ID 등록"
		End If		
	End If
End Function

'============================================================================
Sub btnIDReg_OnClick()
	If btnIDReg.caption == "홈으로" Then
		g_BtnClcd = "N"
		Form.SetSharedData("BDM_NMETBSWRGB", "")
		'Form.OpenScreen("41000", "")
		'Form.CloseForm()
		Form.OpenStartScreen()
	ElseIf btnIDReg.caption == "모바일 OTP 재발급" Then
		g_BtnClcd = "I"
		Form.CloseForm()
	
	'
	ElseIf btnIDReg.caption == "완료" Then
'		Form.ShowAlert("알림" , g_szMotp)
		'ID등록 화면에서 모바일OTP 인증 시, ID가 없으므로 계좌번호로 대신 520r 서비스에서 분기처리
		g_IDRegYN   = Form.GetSharedData("IdRegPros"    , false)
		'계좌번호
		g_IDRegAcno = Form.GetSharedData("IdRegProsAcno", false)
		
		'20230803 SWJ START : OTP인증화면 팝업처리 여부 판단
		'CommonNoSecurity가 "Y"일 때까지 같이 확인해야함
		'Common_OTP_PopupYn로만 판단하면, 발급 도중 고객이 화면 이탈 시 쉐어드 변수 남아있음
		'(쉐어드 변수 CommonNoSecurity는 화면마다 Clear/Set 해줌)
		'(쉐어드 변수 Common_OTP_PopupYn는 화면마다 처리안해줌)
		sPopupYn = Form.GetSharedData("Common_OTP_PopupYn", true)
		'Form.ShowAlert("알림 jj", g_sSecurity )
		'Form.ShowAlert("알림 sPopupYn", sPopupYn )
		'if sPopupYn == "Y" then
		if sPopupYn == "Y" or g_sSecurity == "N" then '진행O
			if g_szMotp == "MOTP" then
				Form.SetSharedData("&SCREEN_AUTH" , "")				'20230609 SWJ START : 헤더 클리어
				Form.OpenPopup("mhetc90060_motp", "motp_success" , "") '20230609 SWJ START : 구분자가 빠짐
			else
				'OTP인지 스마트OTP인지 체크
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			end if
		else  '진행X
			if g_sSecurity == "Y" then
				Form.SetSharedData("&SCREEN_AUTH" , "")				'20240321 SWJ START
				Form.SetSharedData("CommonNoSecurity" , "Y")
				'Form.PostLinkData("&CommonNoSecurity" , 6)
			end if
			Form.CloseForm()
		end if 
		'20230803 SWJ END
		
	Else
		g_BtnClcd = "R"
		If g_IntoClcd <> "NMET_ACNT" Then
			Form.OpenScreen("41000", "")
		end if
		Form.CloseForm()
	End If	
End Sub

'============================================================================
Sub btnNxtDo_OnClick()
	g_BtnClcd = "N"
	Form.SetSharedData("BDM_NMETBSWRGB", "")
	Form.OpenScreen("41000", "")
	Form.CloseForm()
End Sub

