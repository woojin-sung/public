Sub Form_OnFormClose()

	If g_BtnClcd == "R" Then
		If g_IntoClcd == "NMET_ACNT" Then

			'v001
'			If g_scrNo == "85230" Then  '"85210" Then
'				Form.OpenPopup( "mbbdm85300.xmf" , "" , "" ) ' 바이오인증 등록
'			Else
'				Form.OpenPopup( "mbbdm85230.xmf" , "" , "" )  'ID 등록
'			End If
			
			'v001
			if gNmetProsCd == "2" then	'2:ID등록
				Form.OpenPopup( "mbbdm85230.xmf" , "" , "" )  'ID 등록
				Form.SendReturnToParent( "rslt_ret", "OK" )
				'Form.SendReturnToParent( "rslt_ret", "NEXT_ID" )
			elseif gNmetProsCd == "3" then	'3:바이오인증
				Form.OpenPopup( "mbbdm85300.xmf" , "" , "" ) ' 바이오인증 등록
				Form.SendReturnToParent( "rslt_ret", "OK" )
				'Form.SendReturnToParent( "rslt_ret", "NEXT_BIO" )
			else
				Form.SendReturnToParent( "rslt_ret", "OK" )
			end if
		Else
			Form.SendReturnToParent( "rslt_ret", "OK" )
			'Form.OpenScreen("41000", "")
		End If
'	end if	
	'if g_BtnClcd == "N" Then
	'	Form.OpenScreen("41000", "")
	'End If
	
'	If g_BtnClcd = "I" Then
	elseIf g_BtnClcd = "I" Then
		Form.OpenPopup("mbotp86100.xmf", "", "" )
		Form.SendReturnToParent( "rslt_ret", "OK" )
'	End If
	
'	If g_BtnClcd <> "B" Then
	elseIf g_BtnClcd <> "B" Then
		Form.SendReturnToParent( "rslt_ret", "OK" )
	Else
		Form.SetSharedData("BDM_NMETBSWRGB", "")
	End If

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obaci_nmet_005a" Then
		strAcno	= Form.GetSharedData( "BDM_NMET_ACNO", False )
		WholCpno	= Form.GetSharedData("BDM_HP1", False ) & Form.GetSharedData("BDM_HP2", False ) & Form.GetSharedData("BDM_HP3", False )
		OtpSuplCo	= Form.GetSharedData("BDM_OTP_SUPL_CO_CODE", False )
		RegUniqNo	= Form.GetSharedData("BDM_REG_UNIQ_NO", False )
		
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock1" ,	"ACNO"				, 0	, strAcno			) '계좌번호
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock1" ,	"IDNTF_SRNO"			, 0	, Trim(Form.GetSharedData("BDM_IDNTF_SRNO",	false) ))'신분증인증화면에서	가져옴
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock1" ,	"RLNM_CNFR_MTHD_CODE"	, 0	, "01"			)
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock1" ,	"WHOL_CPNO"			, 0	, WholCpno			)
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock1" ,	"REG_UNIQ_NO"			, 0	, RegUniqNo		)

		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock2" ,	"APLT_YN6"				, 0	, g_ApltYN_6		) '타기관OTP 등록
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock2" ,	"APLT_YN9"				, 0	, g_ApltYN_9		) '모바일OTP 등록

		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock2" ,	"OTP_SUPL_CO_CODE"		, 0	, OtpSuplCo		)
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock2" ,	"OTP_CARD_SRNO"			, 0	, RIGHT(g_data1, 12)	)
		DATAMANAGER.SetDataValue(0,	szTranID , "InBlock2" ,	"OTP_ISNC_ISTU_CODE"		, 0	, ""				)
	
	elseif szTranID == "obcsb_oimf_520r" then
		if g_IDRegYN == "Y" then 		
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO" , 0 , g_IDRegAcno )
		else
			if g_sUserID == "" or g_sUserID == null then	
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"   , 0 , g_RcnoPip )
			else
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"   , 0 , g_sUserID )		
			end if	
		end if 
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSMRT_OTP_YN 
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS    = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "RSLT_CLS"      , 0 )
		'스마트OTP 여부
		sSMRT_OTP_YN = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN", 0 )
		
'		Form.ShowAlert("sRSLT_CLS " .. sRSLT_CLS, "sSMRT_OTP_YN " .. sSMRT_OTP_YN)
		
		'스마트OTP
		if sRSLT_CLS == "3" and sSMRT_OTP_YN == "Y" then
			Form.SetSharedData("&SCREEN_AUTH" , "")
			Form.OpenPopup("mhetc90060_pb" , "MeritzAuth★" , "")
			
		'OTP
		else
			Form.SetSharedData("&SCREEN_AUTH" , "")
			Form.OpenPopup("mhetc90060_otp", "otp_success" , "")
		end if 
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "obaci_nmet_005a" Then
		Form.ShowAlert("", szErrMsg & "(" & DATAMANAGER.GetDataMsgSubText(szTranID) & ")" )
	else
		Form.ShowAlert("", szErrMsg & "(" & DATAMANAGER.GetDataMsgSubText(szTranID) & ")" )
	End If	
End Sub

