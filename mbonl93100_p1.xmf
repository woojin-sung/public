		<CONTAINER name="Container0" scroll_pos="0,0" ly_vert="30,325,285,50,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<IMAGE name="imgBg" imgpath="img_tooltip.9.png" ly_vert="0,0,285,50,1" />
				<TABLE name="tblText" insidelinecolor="102:255255255" colcount="1" rowcount="1" outline="0000" transmode="1" designorder="1" ly_vert="6,14,260,20,1" >
					<COL_INFO ly_vert_width="260" />
