	<SCRIPT_INFO _len="647" _ulen="645" >
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" and szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		
		Container0.top = tonumber(tData[0]) - 50
		Container0.tblText.SetCellString(0, 0, tData[1])
	End If
End Sub

'============================================================================
Sub btnAlpha_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_lblClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
