'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵 잔고평가
' 02. 화면설명 : 선옵 잔고평가
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북
Dim g_szTitle
g_szTitle = "알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInitBefore()

	
End Sub

'============================================================================
Sub Form_OnFormInit()
	btnSearch_OnClick()
End Sub

'============================================================================


'============================================================================
Sub btnSearch_OnClick()

	DATAMANAGER.RequestTranData( "obtrf_cntg_320r" )
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno, szAsno
	
	szAcno = acnt0.total
	szAsno = acnt0.sequence
	
	If szTranID = "obtrf_cntg_320r" Then
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_320r", "InBlock1", "ACNO"			, 0 , szAcno 	)
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_320r", "InBlock1", "ASNO"			, 0 , szAsno 	)
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_320r", "InBlock1", "DATA_CLS"		, 0 , "0" 	)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim nCnt
	nCnt = DATAMANAGER.GetDataCount( 0, "obtrf_cntg_320r", "OutBlock2" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obtrf_cntg_320r" Then
		
		For i = 0 To grd2.rowcount - 1 
			Dim nCLPR, nPRPR
			Dim szData
			
			szData = grd2.GetCellData( "bd_cell12", i )
			
			Select Case szData
				Case "1" grd2.SetCellData("bd_cell2", i, "매도")
						grd2.SetCellFgColor("bd_cell2", i, "11")
				Case "2" grd2.SetCellData("bd_cell2", i, "매수")
						grd2.SetCellFgColor("bd_cell2", i, "10")
			End Select
			
			
			'전일대비
			nCLPR = CDbl( grd2.GetCellData( "bd_cell10", i ) )		'종가
			nPRPR = CDbl( grd2.GetCellData( "bd_cell8" , i ) )		'현재가
			
			grd2.SetCellData("bd_cell9", i, nPRPR - nCLPR)
		Next
	End If
	
End Sub



'============================================================================
Sub grd2_OnClickUp(lRow, szCellID)
	Dim szItemCode, szQty, szItemMarket

	szItemCode = grd2.GetCellData("bd_cell11", lRow)

	If Left( Trim(szItemCode), 1 ) = "K" Then
		g_szItemCode	= Right( Trim(szItemCode), Len(Trim(szItemCode)) - 1)
	Else
		g_szItemCode	= szItemCode
	End If
	
	szItemMarket 	= Form.GetItemCodeInfo(g_szItemCode, "market")
	
''//거래가능상품 변경에 따른 수정.
' 지수선물/미니선물/옵션/미니옵션/위클리옵션 만 가능
'	If Trim(szItemMarket) = "F"  or Trim(szItemMarket) = "O" or 
'	   Trim(szItemMarket) = "MF" or Trim(szItemMarket) = "MO" or
'	   Trim(szItemMarket) = "JF" or Trim(szItemMarket) = "JO" or
'	   Trim(szItemMarket) = "XF" or Trim(szItemMarket) = "QO" or '2018.04.06 KRX300선물, KSQ150옵션 추가 XF(KRX300) QO(KSQ150) 
'	   Trim(szItemMarket) = "WO" 						 then '2019.09.20 위클리옵션 추가 WO
	   
		listLocation =  Split(grd2.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
	
		sPopupType = "2"
		
		szQty      = grd2.GetCellData("bd_cell3" , lRow)
	
		' 전달내용/탭위치/종목코드/수량
		' 전달내용, 탭위치는 리턴받아서 처리함.	
		g_szData = g_szItemCode & "★" & szQty 
	
		Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")	
'	Else
'		Form.ShowAlert(g_szTitle, "선택상품은 MTS에서 거래되지 않는 상품입니다.")
'	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mbtrs32000" Then
		Dim arrData
	
		arrData = Split(sRet,"|")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if
		
		If acnt0.caption <> arrData(0) Then
			acnt0.caption = arrData(0)
		Else
			btnSearch_OnClick()
		End If
		
	ElseIf sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("31000" , g_szItemCode & "★" & "0") 
			
		elseif 	szListItems(1)	=	"1"	then		'매수
			Form.OpenScreen("31030" , "잔고" & "★" & "0" & "★" & g_szData ) 
		elseif 	szListItems(1)	=	"2"	then		'매도
			Form.OpenScreen("31030" , "잔고" & "★" & "1" & "★" & g_szData ) 
		end if
		
		g_szData = ""
		
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
			
		End If
	end if 
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	btnSearch_OnClick()
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrf32000_h0" , szData , "" )		
		
	ElseIf sEventName = "SCREEN_MENU" Then
		Dim szCode
		szCode = Form.GetSharedData("&ITEM_FUTOPT", 0)		' 최근조회종목
		
		If sParam = "POPUP_MAESU" then
			Form.OpenScreen("31030" , "기타" & "★" & "0" & "★" & szCode )
			
		elseif sParam = "POPUP_MAEDO" then
			Form.OpenScreen("31030" , "기타" & "★" & "1" & "★" & szCode )
			
		elseif sParam = "SET_GRIDCOL" then
			grd0.showconfig("컬럼 순서 변경")
			
		elseif sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "", "")
			
		end if
	End If
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

