' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szIndexName
Dim g_szType 									' 13: 시간외, 그외는 현재가
Dim g_szTranID

Dim g_szCurtouch								' 현재가 터치이동 ( 최근조회종목("0"),관심종목("1"),watching등록종목("2") - 초기값 "0" )
Dim g_szSwingGroup							' 관심종목일경우 관심그룹키
Dim g_szInterest_cloud							' 관심종목동기화(0:로컬, 1:서버)

Dim g_szSearchItems							' 조회종목(최근조회종목, 관심종목, Watching종목)
Dim g_nIndexItem								' 조회종목의 Index
Dim g_bMoveItem								' 화면에서 발생 여부

Dim g_szISSU_STAT_CLS_CODE						'종목상태구분코드

Dim g_szScreenNo '20210823 HSZ CFD현재가 화면 추가


Dim g_nSearchCnt '20211021 아이티젠(김성수) 현재가 개선 추가
g_nSearchCnt = -1
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
Function SetHogaTblFgColor( nPrice )

	If nPrice  > 0 then 
		tblHoga.SetCellFgColor( 0, 0, 10 )
	ElseIf nPrice < 0 then 
		tblHoga.SetCellFgColor( 0, 0, 11 )
	Else
		tblHoga.SetCellFgColor( 0, 0, 12 )
	End If

End Function

'============================================================================
' Request_Data
'============================================================================
Function Request_Data(szType,szCd)
	Dim szTranID
	
	If g_szItemCode = "" Then
		Form.ShowAlert("알림", "조회할 종목이 없습니다.")
		Exit Function
	End If
	
	if szType <> g_szType then
		if szCd == g_szItemCode then				' 구분이 다르고, 종목코드가 같은경우
			if szType == "13" then			' 시간외단일가 선택시
				szTranID = "ohhts_1181_002r"
				g_szType = szType
			elseif g_szType == "13" then	' 기존 선택이 시간외 단일가일때
				szTranID = "ohhts_1001_001r"
				g_szType = szType
			Else
				szTranID = "ohhts_1001_001r"
				g_szType = szType
			end if
		end if
	else
		if szCd <> g_szItemCode then				' 구분이 같고, 종목코드가 다른경우
			if szType == "13" then			' 시간외단일가 선택상태일때
				szTranID = "ohhts_1181_002r"
				g_szItemCode = szCd
			else							' 시간외단일가외의 선택상태일때
				szTranID = "ohhts_1001_001r"
				g_szItemCode = szCd
			end if
		Else
			if szType == "13" then			' 시간외단일가 선택상태일때
				szTranID = "ohhts_1181_002r"
			else							' 시간외단일가외의 선택상태일때
				szTranID = "ohhts_1001_001r"
			end if

		end if
	end if
	
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szIndexName  = Form.GetItemCodeInfo( g_szItemCode , "indexname")
	g_szTranID = szTranID
	
	If g_szItemMarket = "Q" Or g_szItemMarket = "W" Then
		btnReport.enable = false
	Else
		btnReport.enable = true
	End If
	
	DATAMANAGER.RequestTranData(g_szTranID)	
	
	'20211022 아이티젠(김성수) 현재가 개선 추가 START
'	Load_GWGroup()
'	f_RequestInterestItem()
	'20211022 아이티젠(김성수) 현재가 개선 추가 END
End Function

'============================================================================
' Set_RotateItem
'============================================================================
Function Set_RotateItem()
	If g_szCurtouch = "0" Then			' 최근조회종목
		Get_History()
	ElseIf g_szCurtouch = "1" Then
	
	ElseIf g_szCurtouch = "2" Then
	
	End If
	
End Function

'============================================================================
' Get_History
'============================================================================
Function Get_History()
	Dim szData, arrData, nCnt
	
	If g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		szData = Form.GetRecentHistory("40")
	else
		szData = Form.GetRecentHistory( "1:3:4:5" )
	End if
	
	If Trim( szData ) = "" Then
		Exit Function
	End If
	
	g_szSearchItems = Split(szData,"`")
	
	if UBOUND(g_szSearchItems) < 1 then
	    Exit Function
	End if	
	
	For i = #g_szSearchItems - 1 To 0 Step - 1
		If g_szItemCode = Trim( g_szSearchItems(i) ) Then
			g_nIndexItem = i
			Exit For
		End If
	Next

End Function

'============================================================================
' Move_ItemCode
'============================================================================
Function Move_ItemCode( szType )
	If szType = "Right" Then
		Form.ACRSetProp( "moveitem", "1" )
	ElseIf szType = "Left" Then
		Form.ACRSetProp( "moveitem", "-1" )
	End If
	
