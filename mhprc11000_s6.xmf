'============================================================================
Function f_GetReturnCompareItem()
	Dim nCnt, szCode, nFlag
	nCnt = CInt(grdItem.rowcount) - 1
	
	For i=0 to nCnt
		szCode = grdItem.GetCellData( "bd_code", i )
		
		if szCode == g_szItemCode then
			nFlag = 1
			
			Exit For
		end if
		
	Next
	
	if nFlag == 1 then
		return "FIND"
	else
		return "NONE"
	end if
	
End Function

