'============================================================================
Sub Form_OnFormInitBefore()
	g_szCurtouch		 = Form.GetEnvData( "common.curtouch_swing" 		)	' 현재가 터치이동
	g_szSwingGroup	 = Form.GetEnvData( "common.curtouch_swing_group"	)	' 관심종목일경우 관심그룹키
	g_szInterest_cloud = Form.GetEnvData( "common.interest_cloud" 		)	' 관심종목동기화(0:로컬, 1:서버)
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 '20210823 HSZ
	
	If g_szCurtouch = "" Then
		g_szCurtouch = "0"
	End If
	
	If g_szSwingGroup = "" Then
		g_szSwingGroup = ""
	End If
	
'	Form.ShowAlert(g_szInterest_cloud, g_szSwingGroup)
	
	If g_szInterest_cloud = "" Then
		g_szInterest_cloud = "0"
	End If
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bMoveItem 	= true
	g_nIndexItem = 0
'	Set_RotateItem()
	
End Sub

'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then		
		If g_bMoveItem = true Then
			Request_Data(g_szType, sValue)
'			Set_RotateItem()
		End If
	end	if
End Sub
'============================================================================
'	20211110 HSZ START 실시간 호출하는 TR에서만 Cancel하도록 로직 수정
Sub Clear_Tblhoga() 'Table Clear

	'20211117 아이티젠 김성수 추가 START
	Table0.SetCellString( 0, 0, "") '현재가
	Table0.SetCellString( 2, 1, "") '대비
	Table0.SetCellString( 2, 3, "") '거래량
	Table0.SetCellString( 2, 4, "") '거래량비율
	Table0.SetCellString( 3, 0, "") '등락률
	Table0.SetCellString( 3, 3, "") '전일거래량
	Table0.SetCellString( 3, 4, "")	'전일거래량 비율
	'20211117 아이티젠 김성수 추가 END
End Sub
