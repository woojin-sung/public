<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="16050" scrname="ETF_팝업" version="2" writer="이재원" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LINKFORM name="LinkForm0" linkfile="AspBottomBar" ly_vert="0,622,375,25,1" />
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,49,375,573,1" />
		<LABEL name="Label0" fgcolor="062:255255255" fontsize="6" bgcolor="064:181181181" transmode="0" halign="1" ly_vert="0,0,375,40,1" />
		<IMAGE name="ImgClose" imgpath="icon_main_11" ly_vert="338,6,28,28,1" />
		<IMAGE name="ImgRefresh" imgpath="icon_refresh" ly_vert="6,6,28,28,1" />
		<BUTTON name="BtnRefresh" btnimage="alpha" ly_vert="6,6,28,28,1" />
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="338,6,28,28,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="989" _ulen="973" >

Dim szData
'--============================================================================
Sub Form_OnFormInit()
	if Form.GetOpenLinkData( ) <> null and Form.GetOpenLinkData( ) <> ""	then
		szData = split(Form.GetOpenLinkData( ), "^")
		Label0.caption = szData[1]
		WebView0.urlpath   = szData[0]
	end if
	WebView0.fitresize = "1"
	WebView0.viewtype  = "0"
	

end Sub

'--============================================================================
'-- 뒤로가기
'--============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

'--============================================================================
'-- 새로고침
'--============================================================================
Sub BtnRefresh_OnClick()
	Form_OnRefresh( )
End Sub
'--===========================================================================
Sub Form_OnRefresh()
	WebView0.urlpath   = szData[0]
end Sub


	</SCRIPT_INFO>
</ROOT>