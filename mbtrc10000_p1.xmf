	<SCRIPT_INFO _len="4689" _ulen="4457" >
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szRate1, g_szRate2, g_szCheck1, g_szCheck2, g_szCheck3

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
'f_InitFilterValue 설정 값 초기화
'============================================================================
Function f_InitFilterValue()
	g_szRate1 	= "0"
	g_szRate2 	= "100"
	g_szCheck1 	= "Y"
	g_szCheck2 	= "Y"
	g_szCheck3 	= "N"
	
End Function 

'============================================================================
'f_LoadFilterValue 설정 값 LOAD
'============================================================================
Function f_LoadFilterValue()
	Dim tData1, szTemp1
	szTemp1 = Form.LoadConfigData("SET_mbtrc10000", "SET_VALUE_POP"	) '상세팝업에서 설정한 필터 값
	
	if szTemp1 <> "" then
		tData1 = Split(szTemp1, "★")
		'0증거금률 이상 % 값|1증거금률 이하 % 값|2신규매수 불가종목 제외여부|3신규매도 불가종목 제외여부|4ETF 제외여부
		
		g_szRate1 	= tData1(0)
		g_szRate2 	= tData1(1)
		g_szCheck1 	= tData1(2)
		g_szCheck2 	= tData1(3)
		g_szCheck3 	= tData1(4)
		
	else '초기화
		Call f_InitFilterValue()
	end if
	
End Function

'============================================================================
'f_SaveFilterValue 설정 값 SAVE
'============================================================================
Function f_SaveFilterValue()
	'상세설정에서 설정한 필터 값
	Dim szData, szRate1, szRate2, szChk1, szChk2, szChk3
	
	szRate1 = ContSet.Edit0.caption 
	szRate2 = ContSet.Edit1.caption
	
	if ContSet.ChkMasu.checkstate == "1" or ContSet.ChkMasu.checkstate == 1 then
		szChk1 = "N"
	else
		szChk1 = "Y"
	end if
	
	if ContSet.ChkMado.checkstate == "1" or ContSet.ChkMado.checkstate == 1 then
		szChk2 = "N"
	else
		szChk2 = "Y"
	end if
	
	if ContSet.ChkETF.checkstate == "1" or ContSet.ChkETF.checkstate == 1 then
		szChk3 = "Y"
	else
		szChk3 = "N"
	end if
	
	szData = szRate1 & "★" & szRate2 & "★" & szChk1 & "★" & szChk2 & "★" & szChk3
	Form.SaveConfigData("SET_mbtrc10000", "SET_VALUE_POP", szData )
'	Form.ShowAlert("", szData)
End Function

'============================================================================
'f_SetDataInCtrl 설정 값 컨트롤에 SET
'============================================================================
Function f_SetDataInCtrl()
	if g_szRate1 <> "" then
		ContSet.Edit0.caption = g_szRate1
	end if
	
	if g_szRate2 <> "" then
		ContSet.Edit1.caption = g_szRate2
	end if
	
	if g_szCheck1 <> "Y" then
		ContSet.ChkMasu.checkstate = "1"
	else
		ContSet.ChkMasu.checkstate = "0"
	end if 
	
	if g_szCheck2 <> "Y" then
		ContSet.ChkMado.checkstate = "1"
	else
		ContSet.ChkMado.checkstate = "0"
	end if 
	
	if g_szCheck3 == "Y" then
		ContSet.ChkETF.checkstate = "1"
	else
		ContSet.ChkETF.checkstate = "0"
	end if 
	
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	Call f_LoadFilterValue()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Call f_SetDataInCtrl()
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Call f_SaveFilterValue()
	
	Form.SendReturnToParent( "POP_SET" , "" )
End Sub

'============================================================================
Sub btnReset_OnClick()
	Call f_InitFilterValue()
	Call f_SetDataInCtrl()
End Sub

'============================================================================
Sub Image1_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub ContSet_Edit1_OnEditComplete()
	if ContSet.Edit0.caption <> "" or Cint(ContSet.Edit0.caption) <> 0 then
		if Cint(ContSet.Edit1.caption) < Cint(ContSet.Edit0.caption) then
			Form.ShowAlert("알림", "최소가격보다 작을 수 없습니다. 다시 입력해주세요")
			ContSet.Edit1.caption = ""
		end if
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>