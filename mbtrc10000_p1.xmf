			<CONTROL_INFO>
				<LABEL name="Label0" fontsize="-2" caption=" 대상제외" bgcolor="090:238239240" transmode="0" ly_vert="0,105,375,32,1" />
				<CHKBUTTON name="ChkMasu" chkcaption="신규매수 불가종목" unchkcaption="신규매수 불가종목" ly_vert="19,150,160,32,1" />
				<CHKBUTTON name="ChkMado" chkcaption="신규매도 불가종목" unchkcaption="신규매도 불가종목" ly_vert="192,150,172,32,1" />
				<CHKBUTTON name="ChkETF" chkcaption="ETF" unchkcaption="ETF" ly_vert="19,196,105,32,1" />
				<LABEL name="Label4" fontsize="-2" caption=" 검색설정" bgcolor="090:238239240" transmode="0" ly_vert="0,0,375,32,1" />
				<LABEL name="Label1" caption="증거금률" ly_vert="9,50,71,39,1" />
				<EDIT name="Edit0" autofontsize="1" mask="0,0,,%,0,,0,1,0,0,0" halign="2" imetype="0" maxlength="0" minlength="3" hintcaption="최소" ly_vert="83,51,90,34,1" />
				<EDIT name="Edit1" autofontsize="1" mask="0,0,,%,0,,0,1,0,0,0" halign="2" imetype="0" maxlength="0" minlength="3" hintcaption="최대" ly_vert="231,51,90,34,1" />
				<LABEL name="Label2" caption="이상 ~" ly_vert="167,52,75,32,1" />
				<LABEL name="Label3" caption="이하" ly_vert="319,52,50,32,1" />
			</CONTROL_INFO>
