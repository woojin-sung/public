'===========================================================================
Dim g_exchCd
Dim sSaveCmb0, sSaveCmb1

'US	NS
'	AM
'	NY
'JP	JP
'HK	HK
'CN	SH
'	SZ

'============================================================================
Sub Form_OnFormInit()
	Dim szCombo0
	Dim szCombo1
	Dim szRdo

	szCombo0 = Form.GetEnvData("16031_T04_COMBO0")
	szCombo1 = Form.GetEnvData("16031_T04_COMBO1")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Combo0.cbkeydata = szCombo0
	end if
	if szCombo1 <> nil and szCombo1 <> "" then
		Combo1.cbkeydata = szCombo1
	end if
	combo_Setting()
	radio_Setting()
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Combo1.bgimagetype = "1"

	DATAMANAGER.RequestTranData( "ohhts_6250_010r" ) 
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	Dim szRdo
	szCmb0 = Combo0.cbkeydata
	szCmb1 = Combo1.cbkeydata
	
	
	if szCmb0 == "US" then '미국
		szRdo = rdoUSA.currentindex
		if szRdo == "0" then 
			szRdo = ""
		elseif szRdo == "1" then 
			szRdo = "NY"
		elseif szRdo == "2" then 
			szRdo = "AX"
		elseif szRdo == "3" then 
			szRdo = "OQ"
		end if
	elseif szCmb0 == "CN" then '중국
		szRdo = rdoCHN.currentindex
		if szRdo == "0" then 
			szRdo = ""
		elseif szRdo == "1" then 
			szRdo = "SH"
		elseif szRdo == "2" then 
			szRdo = "SZ"
		end if
	else '홍콩/일본
		szRdo = ""
	end if	

	if szTranID == "ohhts_6250_010r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6250_010r", "InBlock1", "FIDX_NTNL_CODE" , 0 , szCmb0 ) 
		DATAMANAGER.SetDataValue( false, "ohhts_6250_010r", "InBlock1", "FIDX_EXCH_CODE" , 0 , szRdo )  
		DATAMANAGER.SetDataValue( false, "ohhts_6250_010r", "InBlock1", "FID_SORT_CLS" , 0 , szCmb1) 
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6250_010r" then
		sSaveCmb0 = Combo0.cbkeydata
		sSaveCmb1 = Combo1.cbkeydata
	end if	
end Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	Dim szRdo
	szComboData = Combo0.cbkeydata
	combo_Setting()
			
	Form.SetEnvData(1, "16031_T04_COMBO0", szComboData)
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6250_010r" ) 
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)	
	Dim szComboData
	szComboData = Combo1.cbkeydata
	Form.SetEnvData(1, "16031_T04_COMBO1", szComboData)
	
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6250_010r" ) 
end Sub

'============================================================================
Sub Form_OnRefresh()

	Grid0.SetClear( )
	Combo0.cbkeydata = sSaveCmb0
	Combo1.cbkeydata = sSaveCmb1
	DATAMANAGER.RequestTranData( "ohhts_6250_010r" )
end Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "ohhts_6250_010r" ) then
		DATAMANAGER.RequestNextData( "ohhts_6250_010r" )
	end if
end Sub


'============================================================================
Function CInt(data)
	return tonumber(data) or 0
end Function
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub rdoUSA_OnClick(nIndex)
	Dim szRdoData
	Dim szRdo

	szRdo = rdoUSA.currentindex
	if szRdo == "1" then
		'뉴욕일 경우
		szRdoData = "NY"
	elseif szRdo == "2" then
		'아멕스일 경우
		szRdoData = "AX"
	elseif szRdo == "3" then
		'나스닥일 경우
		szRdoData = "OQ"
	else
		'전체일 경우
		szRdoData = ""
	end if
	
	Form.SetEnvData(1, "16031_T04_RADIO", szRdoData)
	
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6250_010r" ) 
End Sub

'============================================================================
Sub rdoCHN_OnClick(nIndex)
	Dim szRdoData
	Dim szRdo
	szRdo = rdoCHN.currentindex
	if szRdo == "1" then
		'상해일 경우
		szRdoData = "SH"
	elseif szRdo == "2" then
		'심천일 경우
		szRdoData = "SZ"
	else
		'전체일 경우
		szRdoData = ""
	end if
	Form.SetEnvData(1, "16031_T04_RADIO", szRdoData)
	
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6250_010r" ) 
End Sub

'============================================================================
Function combo_Setting()
	Dim szComboData
	szComboData = Combo0.cbkeydata
	'국가 구분하기 위함으로 추가
	if szComboData == "US" then '미국
		rdoCHN.visible = false
		rdoUSA.visible = true
		Combo0.width = 50
		Combo1.left = 270
		Combo1.width = 100
	elseif szComboData == "CN" then '중국
		rdoCHN.visible = true
		rdoUSA.visible = false
		Combo0.width = 50
		Combo1.left = 220
		Combo1.width = 150
	else '홍콩/일본
		rdoCHN.visible = false
		rdoUSA.visible = false
		Combo0.width = 81
		Combo1.left = 93
		Combo1.width = 280
	end if	
	
end Function 

'============================================================================
Function radio_Setting()
	szCombo0 = Form.GetEnvData("16031_T04_COMBO0")
	szRdo = Form.GetEnvData("16031_T04_RADIO")
	'국가 구분하기 위함으로 추가
	if szCombo0 == "US" then
		if szRdo == "" then 
			rdoUSA.currentindex = 0
		elseif szRdo == "NY" then 
			rdoUSA.currentindex = 1
		elseif szRdo == "AX" then 
			rdoUSA.currentindex = 2
		elseif szRdo == "OQ" then 
			rdoUSA.currentindex = 3
		end if
	elseif szCombo0 == "CN" then '중국
		if szRdo == "" then 
			rdoCHN.currentindex = 0
		elseif szRdo == "SH" then 
			rdoCHN.currentindex = 1
		elseif szRdo == "SZ" then 
			rdoCHN.currentindex = 2
		end if
	end if	
end Function 

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	Dim nCount
	nCount = CInt(DATAMANAGER.GetDataCount( 0, "ohhts_6250_010r", "OutBlock1"))
	
	for i = 0 to nCount-1
		nIsCnt = DATAMANAGER.GetDataValue(false,"ohhts_6250_010r", "OutBlock1", "FID_ISSU_CNT", i) ' 종목수
		nAcCnt = DATAMANAGER.GetDataValue(false,"ohhts_6250_010r", "OutBlock1", "FIDX_ASCN_ISSU_CNT", i) ' 상승종목수
		nDnCnt = DATAMANAGER.GetDataValue(false,"ohhts_6250_010r", "OutBlock1", "FIDX_DOWN_ISSU_CNT", i) ' 하락종목수
		
		DATAMANAGER.SetDataValue(false,"ohhts_6250_010r", "OutBlock1", "FID_ISSU_CNT", i, CInt(nIsCnt))
		DATAMANAGER.SetDataValue(false,"ohhts_6250_010r", "OutBlock1", "FIDX_ASCN_ISSU_CNT", i, CInt(nAcCnt))
		DATAMANAGER.SetDataValue(false,"ohhts_6250_010r", "OutBlock1", "FIDX_DOWN_ISSU_CNT", i, CInt(nDnCnt))
	next
	
End Sub

	</SCRIPT_INFO>
