'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName
	
	grdCode.rowcount = 0

	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'20190207 LES START - 최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 
		
		end if
		
		nRowcount = 0		'20221025 HSZ
		
		For i = 0 to szLen
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			szMk = Change_EtcMarket(szMk)
			'20221025 HSZ START: 최근조회종목 - 상품선물 안보이게
			'20221110 HSZ : 상품선물 "FF"분기처리 추가
			if szMk == "CF" or szMk == "FF" then

			'20221025 HSZ END 
			else
'				grdCode.insertrow = i
				grdCode.insertrow = nRowcount
		
'				grdCode.SetCellData("bd_code", i, tList(i))
				grdCode.SetCellData("bd_code", nRowcount, tList(i))
'				grdCode.SetCellData("bd_mk",   i, szMk)
				grdCode.SetCellData("bd_mk",   nRowcount, szMk)
'				grdCode.SetCellData("bd_memo", i, "")
				grdCode.SetCellData("bd_memo", nRowcount, "")
'				grdCode.SetCellData("bd_name", i, Form.GetItemCodeInfo(tList(i), "name"))	' 20160325 위젯위해 종목명 추가
				grdCode.SetCellData("bd_name", nRowcount, Form.GetItemCodeInfo(tList(i), "name"))	' 20160325 위젯위해 종목명 추가
				nRowcount = nRowcount + 1
			end if
		Next
		'20190207 LES END
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk()		
	end if
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' Load_GWGroup :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList
	
	grdCode.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", g_szGSID)

	if Trim(szGroup) <> "" then
		tGroup = Split(szGroup, "♣")

		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdCode.insertrow = i
	
			grdCode.SetCellData("bd_code", i, tList(0))
			grdCode.SetCellData("bd_mk",   i, tList(1))
			grdCode.SetCellData("bd_memo", i, tList(2))
			grdCode.SetCellData("bd_name", i, tList(3))	' 20160325 위젯위해 종목명 추가
		Next
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk()
	end if
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCd, szMk

	For i = 0 to grdCode.rowcount-1
		szCd = grdCode.GetCellData("bd_code", i)
		szMk = grdCode.GetCellData("bd_mk",   i)
		
		if Trim(szMk) == "" then
			szMk = ""
		end if

		' 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCd  & "★" & szMk & "★" & grdCode.GetCellData("bd_memo", i) & "★" & grdCode.GetCellData("bd_name", i)
		else
			szList = szList & "♣" & szCd & "★" & szMk & "★" & grdCode.GetCellData("bd_memo", i) & "★" & grdCode.GetCellData("bd_name", i)
		end if
	Next

	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	Form.SaveConfigData("GWANSIM", g_szGSID, szList)

	if g_szCloud == "0" then
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)	
		Save_grdMk()
	end if
	' ///////////////////////////////////////////////////////////////////////
End Function
'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
			end if
	
			For j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
				end if
			Next		
		end if
	Next

	if CInt(grdCode.rowcount) > 0 then
		' 관심종목 데이터조회
		DATAMANAGER.RequestTranData( "ohhts_1020_004r" )
	end if
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	' 2018.01.02 CJH JF, JO 추가
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
End Function

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
	if g_szCloud == "1" then
		DATAMANAGER.RequestTranData("ohhts_intr_009r")
		Save_GWList()
	else
		Save_GWList()
	end if
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Move_Popup 
'============================================================================
Function Move_Popup()
	
	' 시장구분별로 화면을 연동해야한다.
	szMk = Form.GetItemCodeInfo(g_szSltCd, "market")
	szMk = Change_EtcMarket(szMk)
				
	Select Case szMk
		Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			szData = nYPos & "★" & height & "★" & "0" & "★" & szMk & "★현재가★차트★뉴스★매수★매도"
			'20210823 HSZ START : CFD 화면 추가
			if g_szScreenNo = "13101" then
				Screen_No(szData, "13100", "13200", "13100")	
				Exit Function 
			End if
			'20210823 HSZ END
			Screen_No(szData, "11000", "12000", "13000")			
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
			szData = nYPos & "★" & height & "★" & "0" & "★" & szMk & "★현재가★차트★선물종합★매수★매도"
			
			Screen_No(szData, "31000", "31030", "31020")
		Case "U"						' 업종코드
			szData =  nYPos & "★" & height & "★" & "2" & "★" & szMk & "★지수상세★차트★지수종목★★"
			
			Screen_No(szData, "42000", "", "42030")
		Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
			szData =  nYPos & "★" & height & "★" & "3" & "★" & szMk & "★해외지수★해외차트★★★"
			
			Screen_No(szData, "42040", "", "42050")
		Case "B"						' 소액채권, 장내채권
			szData =  nYPos & "★" & height & "★" & "1" & "★" & szMk & "★현재가★채권시세표★매수★매도★"
			
			Screen_No(szData, "54010", "54020", "13000")
			
	End Select
End Function

'============================================================================
' Screen_No : 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
'============================================================================	
Function Screen_No(szScreen0, szScreen1, szScreen2, szScreen3)
	szMk = Form.GetItemCodeInfo(g_szSltCd, "market")
	szMk = Change_EtcMarket(szMk) '5959
	Select Case g_szMove
		Case "0"			' 연결팝업(메인에서 제공하는 팝업 오픈
			Form.OpenPopup("movepopup" , szScreen0, "")
		Case "1"			' 현재가 5959
			call Form_OnPopupReturn("MOVEPOP_RETURN", szMk&"★"&"0")
'			Form.OpenScreen(szScreen1, g_szSltCd)
		Case "2"			' 주문화면
			if Trim(szScreen2) <> "" then
				Form.OpenScreen(szScreen2, "관심종목★0" & "★" & g_szSltCd)		' 선택없으면 매수선택
			end if	
		Case "3"			' 차트
			Form.OpenScreen(szScreen3, g_szSltCd)
	End Select
End Function

'============================================================================
' Add_Item : 종목추가 20060309 , 20160407 종목다중선택위해 변수 추가
'============================================================================
Function Add_Item(nGbn)
	Dim szName, szMk
	szName, szMk = "", ""
	
	grdCode.insertrow = 0
	grdCode.SetCellData("bd_memo", 0, "")

	szName = Form.GetItemCodeInfo(g_szCd, "name")		' 20160325 위젯위해 종목명 추가
	szMk   = Form.GetItemCodeInfo(g_szCd, "market")
	szMk   = Change_EtcMarket(szMk)
	
	grdCode.SetCellData("bd_code", 0, g_szCd)
	grdCode.SetCellData("bd_mk",   0, szMk)
	grdCode.SetCellData("bd_name", 0, szName)		' 20160325 위젯위해 종목명 추가
	
	g_szCd = ""
	
	if nGbn == 0 then				' 20160407	
		Check_LocalOrServer()
	end if
End Function

'============================================================================
' Init_grdMk : 실시간 해제
'============================================================================
Function Init_grdMk()
	For j = 0 to grdMk.rowcount - 1
		szCd = Trim(grdMk.GetCellData("bd_code", j))
		szMk = Trim(grdMk.GetCellData("bd_mk",   j))
		
		if szCd <> "" and szMk <> "" then
			tCode = Split(szCd, "★")

			For k = 0 to #tCode-1
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, tCode(k))
				Set_Real_Input(szMk, k, tCode(k))
			Next
			
			Cancel_RequestReal(szMk)
		end if
	Next
	
	grdMk.rowcount = 0
End Function	


