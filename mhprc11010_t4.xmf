			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_sopt_cntg")		' 주식옵션 체결			
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_sopt_antg")		' 주식옵션 예상체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
