'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 무브팝업리턴 받아 화면 이동
	' ----------------------------------------------------------------------		
	if sKeyName == "MOVEPOP_RETURN" then
		Dim tChk
		Dim szChk
		
		if sRet == "" then
			Exit Sub
		end if
		
		tChk = Split(sRet, "★")
		
		szChk = tChk(0)
		
		if UBound(tChk) > 0 then
			if g_szScreenNo = "13101" then 'CFD 화면
				if tChk(1) == "0" then						' 현재가
					Form.OpenScreen("13100", g_szSltCd)
					exit sub
				elseif tChk(1) == "1" then					' 차트
					Form.OpenScreen("13000", g_szSltCd)
					exit sub
				elseif tChk(1) == "2" then					' 뉴스
					Form.OpenScreen("44000", g_szSltCd)
					exit sub
				elseif tChk(1) == "3" then					' 매수
					Form.OpenScreen("13200", "관심종목★0" & "★" & g_szSltCd)
					exit sub
				elseif tChk(1) == "4" then					' 매도
					Form.OpenScreen("13200", "관심종목★1" & "★" & g_szSltCd)
					exit sub
				end if
			End if
			Select Case szChk
				Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("11000", g_szSltCd)
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("13000", g_szSltCd)
					elseif tChk(1) == "2" then					' 뉴스
						Form.OpenScreen("44000", g_szSltCd)
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("12000", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("12000", "관심종목★1" & "★" & g_szSltCd)
					end if			
				Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("31000", g_szSltCd)		
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("31020", g_szSltCd)
					elseif tChk(1) == "2" then					' 선옵종합
						Form.OpenScreen("31010", g_szSltCd)
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("31030", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("31030", "관심종목★1" & "★" & g_szSltCd)
					end if
				Case "U"						' 업종코드
					if tChk(1) == "0" then						' 지수상세
						Form.OpenScreen("42000", "3★" & g_szSltCd)
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("42030", g_szSltCd)
					elseif tChk(1) == "2" then					' 지수종목
						Form.OpenScreen("42000", "2★" & g_szSltCd)
					end if
				Case "N", "EN", "FN"				' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
					if tChk(1) == "0" then						' 해외지수
						Form.OpenScreen("42040", g_szSltCd)
					elseif tChk(1) == "1" then					' 해외차트
						Form.OpenScreen("42050", g_szSltCd)
					end if
				Case "B"						' 소액채권, 장내채권
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("54010", "관심종목★" & g_szSltCd & "★" )
					elseif tChk(1) == "1" then					' 채권시세표
						Form.OpenScreen("54000", g_szSltCd)
					elseif tChk(1) == "2" then					' 매수
						Form.OpenScreen("54020", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "3" then					' 매도
						Form.OpenScreen("54020", "관심종목★1" & "★" & g_szSltCd)
					end if
			End Select
		end if
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	if sEventName == "GW_LIST" then
		if sParam <> "" then
			tData = Split(sParam, "♥")
			
			g_szGSID = tData(0)
			edtvrsnID.caption = tData(1)
			
			Init_grdMk()		' 실시간 해제
			
			grdList0.rowcount = 0
			grdList1.rowcount = 0
			grdList2.rowcount = 0
			grdCode.rowcount = 0
			
			Visible_Grid()
	
			' 실시간 하이라이트 표시
			grdList0.highlightuse = "0"
			grdList1.highlightuse = "0"
			grdList2.highlightuse = "0"
				
			if Form.GetEnvData("GW_RORDER") == "1" then
				Form.SetCtlProp("grdList" & g_szRSelect , "highlightuse", "1")
			end if
	
			' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
			g_szMove = Form.GetEnvData("GW_MOVE")
			
			if Trim(g_szMove) == "" then
				g_szMove = "0"
			end if
			
			if g_szGSID == "AA" then			' Wathcing종목
				DATAMANAGER.RequestTranData("ohhts_watch_003")
			elseif g_szGSID == "BB" then		' 최근조회 종목
				szRecent = Form.GetRecentHistory("0")
				Load_RecentList(szRecent)
			elseif g_szGSID == "CC" then		' 보유종목
				DATAMANAGER.RequestTranData("obsim_stsv_047r")
			else
				' 관심그룹의 종목을 재설정
				init_GWList()			
			end if
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 추가 Trigger
	' 20160407 : 종목다중선택 로직 추가
	' ----------------------------------------------------------------------	
	elseif sEventName == "GW_ADD" then
		Dim nRow
		Dim szCode, szName
		
		nRow = 0
		szCode, szName = "", ""
		g_tCode = {}

		if sParam <> "" then
			tData = Split(sParam, "★")
			
			if Trim(tData[0]) <> "" then
				g_tCode = Split(tData[0], ":")
	
				nRow = grdCode.rowcount()
		
				if #g_tCode == 1 then
					For i = 0 to nRow - 1
						szCode = Trim(grdCode.GetCellData("bd_code", i))
						
						if szCode == Trim(g_tCode[0]) then
							szName = Form.GetItemCodeInfo(tData[0], "name")
							g_szCd = g_tCode[0]
							
							Form.MsgBox(g_szTitle, szName & "은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEM", 1)
							Exit Sub
						end if
					Next
					
					g_szCd = g_tCode[0]
					g_GrpName = tData(1)
					Init_grdMk()		' 실시간 해제
					Add_Item(0)
				elseif #g_tCode > 1 then
					For j = 0 to #g_tCode - 1
						For i = 0 to nRow - 1
							szCode = Trim(grdCode.GetCellData("bd_code", i))
							
							if szCode == Trim(g_tCode[j]) then
								g_szCd = g_tCode[j]
								g_GrpName = tData(1)
								
								Form.MsgBox(g_szTitle, "선택종목들 중 이미 등록되어 있는 종목이 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEMS", 1)
								Exit Sub
							end if
						Next					
'						g_szCd = g_tCode[j]
'						g_GrpName = tData(1)
'						Init_grdMk()		' 실시간 해제
'						Add_Item(1)
					Next
					
					' 20160411 : 확인이 다 되었으면 리스트에 담는다.
					For k = 0 to #g_tCode - 1
						g_szCd = g_tCode[k]
						g_GrpName = tData(1)
						Init_grdMk()		' 실시간 해제
						Add_Item(1)
					Next	
						
					Check_LocalOrServer()
				end if
			end if
		end if
	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 종목 추가
	if sKeyName == "ADD_ITEM" then
		if sRet == "ok" then	
			Add_Item(0)
		end if
	' 20160407 : 다건종목 추가
	elseif sKeyName == "ADD_ITEMS" then
		if sRet == "ok" then
			For j = 0 to #g_tCode - 1					
				g_szCd = g_tCode[j]
				Add_Item(1)
			Next
			
			Check_LocalOrServer()		
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	' ----------------------------------------------------------------------
	' Wathcing종목 조회
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_watch_003" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_watch_003", "InBlock1", "FID_INPUT_WRTR_ID", 0, Form.GetSharedData("&CUST_NUM", false))
	' ----------------------------------------------------------------------
	' 보유종목 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obsim_stsv_047r" then
		grdCode.rowcount = "0"
		DATAMANAGER.SetDataValue(0, "obsim_stsv_047r", "InBlock1", "ELFN_ID", 0, Form.GetSharedData("&USER_ID", false))
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)								' 관심그룹ID	
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1020_004r" then
		grdList0.rowcount = "0"		' 종목조회그리드 초기화
		grdList1.rowcount = "0"
		grdList2.rowcount = "0"
		
		For i = 0 to grdCode.rowcount-1
			szMk = grdCode.GetCellData("bd_mk", i)
			
			' 시장구분이 없는것은 종목데이터 조회에서 뺀다. -> HTS는 그냥 던짐..ㅋ
			' 여기서 MTS마스터에 없는 종목 빼면 싱크문제 생길수 있음. 조회 한다음에 할것!
			'if Trim(szMk) <> "" then
			'if i < 2 then
				'szMk = Trim(grdCode.GetCellData("bd_mk", i))
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)

				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, szMk)
				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD",               i, szCd)
			'end if
		Next
	' ----------------------------------------------------------------------
	' 종목메모 조회
	' ----------------------------------------------------------------------	
	
	'20210622 LES START
	elseif szTranID == "ohhts_memo_013r" then
		DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID"           , 0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE", 0, "2")								' FID메모관리구분코드(1일반메모, 2종목메모)
		DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN"     , 0, "1")								' FID입력선택여부(1검색, 2전체검색, 3추가, 4수정, 5삭제, 9전체삭제)
	'20210622 LES END
	
	' ----------------------------------------------------------------------
	' 관심 수정 TR : 종목추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_009r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)						' FID버전ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_MOD_YN",      0, "0")									' FID수정여부				
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")									' FID종목수정여부
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)							' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_GRP_NAME",    0, g_GrpName)						' FID관심그룹명	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_ISSU_MOD_YN",      0, "1")								' FID종목수정여부

		For j = 0 to grdCode.rowcount - 1
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_GRP_ID", j, g_szGSID)						' FID관심종목그룹	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_ID2",    j, Change_Len(j))					' FID관심종목		

'PENTA13 START => 2019.01.23
			sMemo     = Trim(grdCode.GetCellData("bd_memo", j))
			sItemCode = Trim(grdCode.GetCellData("bd_code", j))
'PENTA13 END
			' FID코드구분코드
			if Trim(grdCode.GetCellData("bd_mk", j)) == "" then
'PENTA13 START => 2019.01.23
				if sMemo == "" then
'PENTA13 ORGSRC
				'if Trim(grdCode.GetCellData("bd_name", j)) == "" then
'PENTA13 END
					DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "3")	' 메모
				end if
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "1")		' 종목
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, grdCode.GetCellData("bd_mk", j))' FID입력시장구분코드	

			' FID관심종목코드 / FID메모내용
'PENTA13 START => 2019.01.23
				if sItemCode == "EMPTY" then			' 세개의 리스트그리드가 공통이므로 현재가 그리드만 체크
'PENTA13 ORGSRC
			'if Trim(grdList0.GetCellData("bd_code", j)) == "빈칸" then	
'PENTA13 END
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISCD", j, "EMPTY")
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_MEMO_CNTT", j, grdCode.GetCellData("bd_memo", j))	
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISCD", j, grdCode.GetCellData("bd_code", j))
			end if
		Next
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	''''''''''''''''''	
	' ----------------------------------------------------------------------
	' 보유종목/관심종목 종목/Watching종목조회
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_047r" or szTranID == "ohhts_intr_007r" or szTranID == "ohhts_watch_003" then
		if szTranID == "obsim_stsv_047r" then
			nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_047r", "OutBlock1")
			
			if nCnt > 0 then
				nRow = 0
				
				For i = 0 to nCnt -1 
					szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_047r", "OutBlock1", "ISCD", i)
					grdCode.insertrow = nRow
					
					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					szMk = Form.GetItemCodeInfo(szCd, "market")
					select Case szMk
					Case "Q", "BN", "B"
					
					'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
					Case "J"
						szCutCd = szCd
					'20210608 SWJ END
					
					Case Else
						szCutCd = Mid(szCd, 2, Len(szCd))
						szMk = Form.GetItemCodeInfo(szCutCd, "market")
					End Select
					'20160729 NOHES END
					
					' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
					' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
					' ETN (mk) = Q, 채권(mk) = BN 
					
					
					Select Case szMk
						Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
							grdCode.SetCellData("bd_code", nRow, szCutCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
						Case "Q", "BN", "B"
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
						Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
						'20160729 NOHES END
						Case Else
							if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
								grdCode.SetCellData("bd_code", nRow, szCutCd)
								grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
							else
								grdCode.SetCellData("bd_code", nRow, szCd)
								grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
							end if
					End Select
					' ////////////////////////////////////////////////////////////////////////////////////////////
					szMk = Change_EtcMarket(szMk)
					grdCode.SetCellData("bd_mk",   nRow, szMk)
					
					nRow = nRow + 1
				Next
			end if
			
		' 관심종목 종목 조회, Watching종목 조회
		elseif szTranID == "ohhts_intr_007r" or szTranID == "ohhts_watch_003" then
			nRow = grdCode.rowcount
			
			For i = 0 to nRow - 1 
				szCode = grdCode.GetCellData("bd_code", i)
				szMk = Form.GetItemCodeInfo(szCode, "market")
				szMk = Change_EtcMarket(szMk)			
				
				grdCode.SetCellData("bd_mk", i, szMk)
				grdCode.SetCellData("bd_name", i, Form.GetItemCodeInfo(szCode, "name"))	' 20160325 위젯위해 종목명 추가
			Next
		end if
		
		' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
		Save_grdMk()		
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then
		' 메모셀 적용 ////////////////////////////////////////////////////////
		' -> MTS마스터에 없는 종목 보이지 않기 20160321
'		For i =  grdCode.rowcount - 1 to 0 step -1
		For i = 0 to grdCode.rowcount - 1
			szMm = grdCode.GetCellData("bd_memo", i)
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			
			if Trim(szMm) <> "" then
				if g_szRSelect == "1" then
					grdList1.SetPropGridCell("memo", "bd_code", i, szMm)
				elseif g_szRSelect == "2" then
					grdList2.SetPropGridCell("memo", "bd_code", i, szMm)
				else
					grdList0.SetPropGridCell("memo", "bd_code", i, szMm)
				end if
			end if	
			
			' MTS에서 보여지지 않는 종목은 종목명에 종목코드 보여주기 -> MTS마스터에 없는 종목 보이지 않기 ++ 
			szMk = f_ChkMarket(szMk, szCd)
			
			if Trim(szMk) == "" and Trim(szCd) <> "EMPTY" then
'				grdList0.SetDeleteRow(i)
'				grdList1.SetDeleteRow(i)
'				grdList2.SetDeleteRow(i)				
				if g_szRSelect == "1" then
					grdList1.SetCellData("bd_name", i, szCd)
					grdList1.SetCellFgColor("bd_name", i, "127")	' 글자색_메뉴비활성글자색
				elseif g_szRSelect == "2" then
					grdList2.SetCellData("bd_name", i, szCd)
					grdList2.SetCellFgColor("bd_name", i, "127")
				else
					grdList0.SetCellData("bd_name", i, szCd)
					grdList0.SetCellFgColor("bd_name", i, "127")
				end if		
			end if
			' ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++		
		Next			
		' //////////////////////////////////////////////////////////////////

		'20210622 LES START
		' 종목메모관리자 조회
		DATAMANAGER.RequestTranData("ohhts_memo_013r")
		'20210622 LES END
		
		' 실시간을 위한 작업 //////////////////////////////////////////////
		For j = 0 to grdMk.rowcount - 1
			szCd = grdMk.GetCellData("bd_code", j)
			szMk = grdMk.GetCellData("bd_mk", j)
			
			if szCd <> "" and szMk <> "" then
				tCode = Split(szCd, "★")
				
				For k = 0 to #tCode-1
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, tCode(k))

					if szMk <> "" then
						Set_Real_Input(szMk, k, tCode(k))
					end if
				Next
				
				Real_RequestData(szMk)
			end if
		Next
		' //////////////////////////////////////////////////////////////////
	
	
	'20210622 LES START
	' ----------------------------------------------------------------------
	' 종목메모 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_memo_013r" then
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_memo_013r", "OutBlock1")
		
		For i = 0 To nCnt-1
			szCd = DATAMANAGER.GetDataValue(0, "ohhts_memo_013r", "OutBlock1", "FID_NEW_ISSU_CODE", i)
			
			For j = 0 to grdList0.rowcount - 1
				szCd2 = grdList0.GetCellData("bd_code", j)
				
				if szCd == szCd2 then		' 종목메모 이미지 적용
					if g_szRSelect == "1" then
						grdList1.SetCellImage("bd_name", j, "icon_txt_memo.9.png")
					elseif g_szRSelect == "2" then
						grdList2.SetCellImage("bd_name", j, "icon_txt_memo.9.png")
					else
						grdList0.SetCellImage("bd_name", j, "icon_txt_memo.9.png")
					end if
				end if
			Next
		Next
	'20210622 LES END
		
		
	' ----------------------------------------------------------------------
	' 관심 수정 TR : 종목추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_009r" then
		Form.SetCtlProp("##edtvrsnID", "caption", edtvrsnID.caption)
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		
		Save_grdMk()
		' 관심종목 데이터조회
		'DATAMANAGER.RequestTranData( "ohhts_1020_004r" )
	end if
End Sub
	
'============================================================================
' grdList0_OnClickUp : 현재가 그리드 클릭
'============================================================================
Sub grdList0_OnClickUp(lRow, szCellID)
	szCd = grdList0.GetCellData("bd_code", lRow)
	if Trim(szCd) == "" then
		Exit Sub
	end if

	g_szSltCd = szCd
	
	listLocation =  Split(grdList0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]

	Move_Popup(nYPos, height)
End Sub

'============================================================================
' grdList1_OnClickUp : 예상가 그리드 클릭
'============================================================================
Sub grdList1_OnClickUp(lRow, szCellID)
	szCd = grdList1.GetCellData("bd_code", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if

	g_szSltCd = szCd

	listLocation =  Split(grdList1.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	Move_Popup(nYPos, height)
End Sub

'============================================================================
' grdList2_OnClickUp : 시간외 그리드 클릭
'============================================================================
Sub grdList2_OnClickUp(lRow, szCellID)
	szCd = grdList2.GetCellData("bd_code", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if

	g_szSltCd = szCd

	listLocation =  Split(grdList2.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	Move_Popup(nYPos, height)
End Sub

