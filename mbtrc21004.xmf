	<CONTROL_INFO>
		<ACCOUNT name="acnt0" bgcolor="052:255255255" itemcodetype="136,137" etcfunctions="" accpwdctl="EditPW" ly_vert="6,10,271,39,1" />
		<EDIT name="EditPW" autofontsize="1" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" ly_vert="283,9,86,39,1" />
		<LABEL name="lblNow" caption="현재 증거금 등급" ly_vert="10,69,130,32,1" />
		<LABEL name="lblType" fontsize="-1" border="1" paddinginfo="20,0,0,0" ly_vert="150,69,215,32,1" />
		<LABEL name="lblAfter" caption="변경 증거금 등급" ly_vert="10,121,130,32,1" />
		<RADIOGROUP name="rdoType" ly_vert="150,121,215,64,1" >
			<RADIO_INFO>
				<RADIO no="0" text="CFD일반계좌" transfervalue="A" position="0,0,120,32" />
				<RADIO no="1" text="CFD안심계좌" transfervalue="B" position="0,32,120,32" />
			</RADIO_INFO>
		</RADIOGROUP>
		<BUTTON name="btnChange" caption="변경" fgcolor="095:000000000" ly_vert="10,506,355,46,1" />
