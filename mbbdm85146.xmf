						<TABLE name="Table1" insidelinecolor="102:255255255" colcount="1" rowcount="14" outline="0000" designorder="1" ly_vert="38,20,295,280,1" >
							<COL_INFO ly_vert_width="295" />
							<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20,20,20,20,20,20,20" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" bgcolor="272:246246246" halign="0" line="0,0" caption="동 보고서는 금융소비자보호령법에 따라," paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,1,0,1" bgcolor="272:246246246" halign="0" line="0,0" caption="해당 금융상품이 귀하에게 적정하지 않다" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="272:246246246" halign="0" line="0,0" caption="는 사실을 회사가 귀하에게 알리는 경우 제" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="272:246246246" halign="0" line="0,0" caption="공하는 보고서입니다." paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="272:246246246" halign="0" line="0,0" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" bgcolor="272:246246246" halign="0" line="0,0" caption="당사는 본 판단에 있어 유사한 다른 고객과" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" bgcolor="272:246246246" halign="0" line="0,0" caption="의 불합리한 차별은 없다고 판단하였습니" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" bgcolor="272:246246246" halign="0" line="0,0" caption="다." paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" bgcolor="272:246246246" halign="0" line="0,0" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" bgcolor="272:246246246" halign="0" line="0,0" caption="귀하가 당사에 제공한 정보가 정확하지 않" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" bgcolor="272:246246246" halign="0" line="0,0" caption="거나, 그 정보가 변경된 경우(변경된 정보를" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" bgcolor="272:246246246" halign="0" line="0,0" caption="당사에 알리지 아니하는 경우도 포합됩니" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" bgcolor="272:246246246" halign="0" line="0,0" caption="다)에는 적정성 판단 결과가 달라질 수 있습" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,13,0,13" bgcolor="272:246246246" halign="0" line="0,0" caption="니다." paddinginfo="-1,0,0,0" impidxs="" />
							</CELL_INFO>
						</TABLE>
						<IMAGE name="Imagedot1" autosize="1" imgpath="icon_dot.png" ly_vert="20,20,18,18,1" />
						<IMAGE name="Imagedot2" autosize="1" imgpath="icon_dot.png" ly_vert="20,120,18,18,1" />
						<IMAGE name="Imagedot3" imgpath="icon_dot.png" ly_vert="20,200,18,18,1" />
						<TABLE name="Table2" insidelinecolor="102:255255255" colcount="1" rowcount="13" outline="0000" designorder="1" ly_vert="38,372,295,260,1" >
							<COL_INFO ly_vert_width="295" />
							<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20,20,20,20,20,20" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" bgcolor="272:246246246" halign="0" line="0,0" caption="본인의 거래목적, 재산상황 및 투자경험 등" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,1,0,1" bgcolor="272:246246246" halign="0" line="0,0" caption="정보를 종합적으로 고려할 때, 위 상품이 본" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="272:246246246" halign="0" line="0,0" caption="인에게 부적정함을 귀사로부터 충분히 설" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="272:246246246" halign="0" line="0,0" caption="명 받았으며, 귀사의 투자권유 없이 본인의" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="272:246246246" halign="0" line="0,0" caption="판단하에 동 상품의 거래신청여부를 결정" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" bgcolor="272:246246246" halign="0" line="0,0" caption="하도록 하겠습니다." paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" bgcolor="272:246246246" halign="0" line="0,0" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" bgcolor="272:246246246" halign="0" line="0,0" caption="투자성 상품에 대한 투자 시에는 원금손실" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" bgcolor="272:246246246" halign="0" line="0,0" caption="이 발생할 수 있고, 본 건과 같이 부적정한" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" bgcolor="272:246246246" halign="0" line="0,0" caption="상품에 대한 투자인 경우 그 손실 가능성이" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" bgcolor="272:246246246" halign="0" line="0,0" caption="본인의 예상보다 더 높으나, 그 투자 손익에" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" bgcolor="272:246246246" halign="0" line="0,0" caption="대한책임은 본인에게 있음을 충분히 이해" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" bgcolor="272:246246246" halign="0" line="0,0" caption="하였습니다." paddinginfo="-1,0,0,0" impidxs="" />
							</CELL_INFO>
						</TABLE>
