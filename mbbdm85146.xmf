'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************


Dim szData
Dim g_close
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	'szData     = Form.GetOpenLinkData() '기관명★기관코드
	'stmp		  = Split(szData, "★")
	
	
	g_BDM_NAME		= Form.GetSharedData("BDM_NAME"               , false) '이름
	
	g_BDM_RCNO_PIP    = Form.GetSharedData("BDM_RCNO_PIP"           , false) '주민등록번호
	
    g_BDM_PRCD101_YN  = Form.GetSharedData("BDM_PRCD101_UNFIT" , False) '선물옵션(Y/N)
    g_BDM_PRCD135_YN  = Form.GetSharedData("BDM_PRCD135_UNFIT" , False)  ' 해외파생(Y/N)
    g_BDM_APLY_KYC_GRAD  = Form.GetSharedData("BDM_APLY_KYC_GRAD" , False)  ' 고객산정종합등급
	 
	 
	 if 	g_BDM_APLY_KYC_GRAD ="00" or 	g_BDM_APLY_KYC_GRAD ="" or g_BDM_APLY_KYC_GRAD = NULL then
		Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "정보미제공"	     )	'산정종합등급
	elseif g_BDM_APLY_KYC_GRAD ="01" then
		Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "고수익지향형"	     )
	elseif g_BDM_APLY_KYC_GRAD ="02" then
		Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "성장지향형"	     )
	elseif g_BDM_APLY_KYC_GRAD ="03" then
		Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "중립형"		     )
	elseif g_BDM_APLY_KYC_GRAD ="04" then
		Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "안정지향형"	     )
	elseif g_BDM_APLY_KYC_GRAD ="05" then
		Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "이자소득형"	     )
	end if
 
    
	Btncancle.fgcolor		= "269"
	Btnok.fgcolor			= "273"
	
	Container0.Grid0.SetCellData("bd_cell02"  , 0, g_BDM_NAME	     	)	'고객명
	'Container0.Grid0.SetCellData("bd_cell3" 	 , 0, "고수익지향형"	     )	'산정종합등급
	'g_BDM_PRCD101_YN = "Y"
	'g_BDM_PRCD135_YN = "Y"
	
	'ShowAlert("g_BDM_PRCD101_YN",g_BDM_PRCD101_YN)
	'ShowAlert("g_BDM_PRCD135_YN",g_BDM_PRCD135_YN )
	if g_BDM_PRCD101_YN == "Y" and g_BDM_PRCD135_YN == "Y" then '둘다 Y일때
		Container0.GridA.visible = false
		Container0.GridB.visible = true
		
		Container0.GridB.SetCellData("bd_cell02"  , 0, "선물옵션"	     )	'상품명
		Container0.GridB.SetCellData("bd_cell2"   , 0, "매우높은위험 이하"	)	'등급명
		Container0.GridB.SetCellData("bd_cell3" 	 , 0, "부적정"	     )	'산정종합등급
		Container0.GridB.SetCellData("bd_cell0"   , 0, "해외파생"	     )	'상품명
		Container0.GridB.SetCellData("bd_cell4"   , 0, "매우높은위험 이하"	)	'등급명
		Container0.GridB.SetCellData("bd_cell6" 	 , 0, "부적정"	     )	'산정종합등급
		
		Container0.Container1.top = 487
	
	elseif g_BDM_PRCD101_YN == "Y" then	'선물옵션이 부적정인 경우
		Container0.GridA.visible = true
		Container0.GridB.visible = false
		
		Container0.GridA.SetCellData("bd_cell02"  , 0, "선물옵션"	     )	'상품명
		Container0.GridA.SetCellData("bd_cell2"   , 0, "매우높은위험 이하"	)	'등급명
		Container0.GridA.SetCellData("bd_cell3" 	 , 0, "부적정"	     )	'산정종합등급
		
		'Container0.Container1.SetScrollAutoSize()
		Container0.Container1.top = 457
		Container0.SetScrollAutoSize()
		
	else								'해외파생이 부적정인 경우
		Container0.GridA.visible = true
		Container0.GridB.visible = false
		
		Container0.GridA.SetCellData("bd_cell02"  , 0, "해외파생"	     )	'상품명
		Container0.GridA.SetCellData("bd_cell2"   , 0, "매우높은위험 이하"	)	'등급
		Container0.GridA.SetCellData("bd_cell3" 	 , 0, "부적정"	     )	'산정종합등급
		
		'Container0.Container1.SetScrollAutoSize()
		Container0.Container1.top = 457
		Container0.SetScrollAutoSize()
		
		'Container0.Container1.SetHeightResize(683)
	end if
	
End Sub

