'============================================================================
' imgClose_OnClick
'============================================================================
Sub Container0_imgClose_OnClick()
	g_close ="투자적정성판단보고취소"
	
	Form.CloseForm()
End Sub
'============================================================================
Sub BtnClose_OnClick()
	g_close ="투자적정성판단보고취소"
	
	Form.CloseForm()
End Sub

'============================================================================
Sub Btncancle_OnClick()
	g_close ="투자적정성판단보고취소"
	
	Form.CloseForm()
End Sub

'============================================================================
Sub Btnok_OnClick()
	
	if Container0.Container1.ChkButton0.checkstate  = "0" or Container0.Container1.ChkButton0.checkstate  = 0 then 
		ShowAlert("안내","상기 내용에 이상이 없음 확인이 필요합니다.") 
		Container0.scroll_pos = 700
    Else
	    g_close ="투자적정성판단보고진행"
	
	    Form.CloseForm()    
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	if g_close == "투자적정성판단보고취소" then
		Form.SendReturnToParent("MBBDM85146", "")   
	elseif g_close == "투자적정성판단보고진행" then
		Form.SendReturnToParent("MBBDM85146", "ok")   
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	
	Btncancle_OnClick()
End Sub
