		<TRIO_INFO>
			<TRAN name="obcpp_intr_751a" title="인턴A팀 회원테이블 처리서비스" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="180" _ulen="128" >

