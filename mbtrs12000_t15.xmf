	Form.SaveConfigData("mbtrs15000", "balance2", sCheckState ) '비용반영
End Sub

'============================================================================
Sub cont0_chk1_OnChange(sCheckState)
	cont0.grd0.rowcount = 0
	cont0.grdCard.rowcount = 0
	
