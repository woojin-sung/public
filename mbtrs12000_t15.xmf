				<BUTTON name="btnCopyClose" btnimage="alpha" ly_vert="291,0,40,40,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="56886" _ulen="51546" >
'--===========================================================================
'20230817 SWJ START : 형 변환 (Cint -> Cdbl)
'안드로이드 32bit 폰인 경우, int형 범위를 넘어가면 최대범위 값으로 표기하는 오류 수정
' (거의 모든 기종 64bit)
'일부 Cdbl형으로 변환 (일부 나누는 처리하는 부분은 실수형 표기가 될 수 있으므로 Clng로 변환함)
'--===========================================================================
Dim g_szRmndCd, g_szLoanCd, g_szItemCode, g_szData

Dim  g_szSelect, g_szFold
Dim g_szRmndCd
Dim g_szLoanCd

Dim g_index

Dim g_RghtFlag
Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer
Dim g_switch
Dim g_VltnFlag '0 순자산평가 1 유가증권평가액
Dim g_ByovFlag '0 평가손익 1 총 매입단가
Dim g_nView'0=현재 리스트형 1= 현재 카드형

'수수료율 TR 조회 data 저장
Dim g_szDEAL_FEE_CLS_CODE, g_szBOND_RMNN_PRD_CLS_CODE, g_szSTPL_LSLM_AMT, g_szSTPL_UPLM_AMT, g_szDEAL_FERT, g_szADTN_AMT
g_nView = 0

Dim g_nOpenScreen		'해당 화면을 주문, 잔고에서 사용하기 때문에 이 변수로 구분
g_nOpenScreen = 12000

g_szFold = "1"

Dim g_nTR004r_GrdIdx'004r TR 200개씩 잘라서 올리기
g_nTR004r_GrdIdx = 0

Dim g_nTopType '0=주식평가금액/1=순자산평가금액
g_nTopType = 0

'============================================================================
Sub cont0_lblDetail_OnClick()
	Form.OpenScreen("15000" , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'20230705 htw start 체크 값 저장 및 사용 추가
	Dim szChk1,szChk2
	
	szChk1 = Form.LoadConfigData("mbtrs15000", "balance1" )'신용합산
	szChk2 = Form.LoadConfigData("mbtrs15000", "balance2" ) '비용반영
	
	'20230807 SWJ START : 주문화면에서 신용합산 체크가 되어있으면, 잔고에서도 체크
	szChk0 = Form.LoadConfigData("mbtrs12000", "balance1")
	
	if szChk0 == "" then
		szChk0 = "0"
	end if
	'20230807 SWJ END
	
'	if szChk2 == "1" then
'		contIncludeFee.visible = true
'		Form.SetTimerEvent( 999, 1, 10 )
'	end if
	
	if szChk1 == "" then
		szChk1 = "0"
	end if
	
	if szChk2 == "" then
		szChk2 = "0"
	end if
	
	if sEventName == "CHNAGE_TAB" then'주문화면에서 탭 변경
		g_nOpenScreen = 12000
		
		'20230807 SWJ START
		if szChk0 == "1" then
			cont0.chk1.checkstate = szChk0
		else
			If szChk1 <> "" Then
				cont0.chk1.checkstate = szChk1
			End If
		end if
		'20230807 SWJ END
		
		cont0.chk2.checkstate = szChk2
		
		RequestData()
	elseif sEventName == "ACNT_CHANGE" or sEventName == "CHANGE_ACCTNO" then
		RequestData()
	elseif sEventName == "RECEIVE" then'잔고 화면에서 탭 변경
		cont0.height = 469
		contIncludeFee.top = 59 + 314
'		cont0.grd0.height = 562 - 94 - 145
'		cont0.grdCard.height = 562 - 94 - 145
		g_nOpenScreen = 15000
		cont0.chk1.checkstate = szChk1
		cont0.chk2.checkstate = szChk2
		RequestData()
	end if
	'20230705 htw end 체크 값 저장 및 사용 추가
End Sub

'============================================================================
Function RequestData()
	Form.SetTimerEvent(1, 0, 1)
	grd326.rowcount = 0
	cont0.grd0.rowcount = 0
	cont0.grdCard.rowcount = 0
	cont0.tblValAmt.SetCellString(0, 0, "")
	cont0.tbl0.SetCellString(0, 3, "")
	cont0.tbl0.SetCellString(2, 1, "")
	cont0.tbl0.SetCellString(2, 4, "")
	cont0.tbl0.SetCellString(3, 1, "")
	cont0.tbl0.SetCellString(3, 4, "")
	DATAMANAGER.RequestTranData( "obacb_balc_105r" )
	'20230623 htw start 잔고 실시간 반영
'	DATAMANAGER.RequestTranData( "obacb_balc_154r" )
	DATAMANAGER.RequestTranData( "obpds_srvc_326r" )
	'20230623 htw end 잔고 실시간 반영
End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData( false, szTranID )
	DATAMANAGER.ClearOutputData( false, szTranID )
	Dim szFEE_INCU_YN
	Dim szACNO, szASNO
	
	'비용반영
	If CInt(cont0.chk2.checkstate) == 1 Then
		szFEE_INCU_YN = "Y"
	Else
		szFEE_INCU_YN = "N"
	End If
	
	if g_nOpenScreen == 12000 then
		szACNO = Form.GetCtlProp("#acnt", "total")
		szASNO = Form.GetCtlProp("#acnt", "sequence")
	elseif g_nOpenScreen == 15000 then
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
	end if
		
	If szTranID = "obacb_balc_105r" Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" 	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ACNO" 			, 0 , szACNO 		)		
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
	elseIf szTranID = "obtrs_comn_310r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "ACNO"			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "ASNO"			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "BRNG_STCK_YN"	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "FEE_INCU_YN"	, 0 , szFEE_INCU_YN )		
		
	ElseIf szTranID = "obtrs_comn_329r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "ACNO" 			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD" 	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "BRNG_STCK_YN" 	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "FEE_INCU_YN" 	, 0 , szFEE_INCU_YN )
	ElseIf szTranID = "obpds_srvc_326r" Then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_326r", "InBlock1", "ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_326r", "InBlock1", "ASNO" 	, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_326r", "InBlock1", "ONLN_YN" 	, 0 , "" )'Y=HTS,N=민츠,공란=이외의 매체 자체적 판단
	ElseIf szTranID = "obtrs_comn_308r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "ASNO" 	, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "UI_RMND_CLCD" 	, 0 , "00" )
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "FEE_INCU_YN" 	, 0 , szFEE_INCU_YN )
	ElseIf szTranID = "ohhts_intr_004r" Then
		Dim szMk,szCode,szNowCode
		Dim tMk,tCode,nIdx
		nIdx = 0
		szCode = ""
		for i = g_nTR004r_GrdIdx to cont0.grd0.rowcount - 1
			szNowCode = cont0.grd0.GetCellData("bd_cell41", i)'종목코드
			szISCD = szNowCode
			
'			szNowCode = cont0.grd0.GetCellData("bd_cell8", i)'종목코드
'			'동일한 종목은 제외시킨 후 table에 담는다.
'			
'			szCode = szNowCode
'			szISCD = right(szCode,6)
			szMk = Form.GetItemCodeInfo(szISCD, "market")'6자리
			
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, nIdx , szMk )
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_004r", "InBlock1", "FID_INPUT_ISCD" 	, nIdx , szISCD )'6자리
			
			nIdx = nIdx + 1
			g_nTR004r_GrdIdx = g_nTR004r_GrdIdx + 1
			if CInt(nIdx % 200) == 0 then'한번에 200개씩만 올리기 위함
				exit for
			end if
			
'			szNowCode = cont0.grd0.GetCellData("bd_cell8", i)'종목코드
'			'동일한 종목은 제외시킨 후 table에 담는다.
'			
'			if szNowCode <> szCode then
'				szCode = szNowCode
'				szISCD = right(szCode,6)
'				szMk = Form.GetItemCodeInfo(szISCD, "market")'6자리
'				
'				DATAMANAGER.SetDataValue( 0, "ohhts_intr_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, nIdx , szMk )
'				DATAMANAGER.SetDataValue( 0, "ohhts_intr_004r", "InBlock1", "FID_INPUT_ISCD" 	, nIdx , szISCD )'6자리
'				
'				nIdx = nIdx + 1
'			end if
		next
	ElseIf szTranID = "obacb_balc_154r" Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_154r", "InBlock1", "ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obacb_balc_154r", "InBlock1", "ASNO" 	, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" 	, 0 , "01" )
	ElseIf szTranID = "obacb_balc_154r_1" Then	'D+2예수금 조회용
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 	, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASET_CLS_CODE" 	, 0 , "11" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obacb_balc_105r" Then
'		g_szVLTN_AMT	= DATAMANAGER.GetDataValue(0, "obacb_balc_105r", "OutBlock1", "VLTN_AMT"	    , 0)'순자산평가금액

	elseIf szTranID = "obtrs_comn_329r" Or szTranID = "obtrs_comn_310r" Then
		
		if DATAMANAGER.IsMoreNextData( szTranID ) == true or DATAMANAGER.IsMoreNextData( szTranID ) == 1 or DATAMANAGER.IsMoreNextData(szTranID ) == "1" then
			DATAMANAGER.RequestNextData( szTranID )
		else
			'20230629 htw start 상단 테이블 data 계산
'			f_SetTopSumData()
			'20230629 htw end 상단 테이블 data 계산
'			g_nTR004r_GrdIdx = 0
'			DATAMANAGER.RequestTranData( "ohhts_intr_004r" )

			f_SetGridText()

			if g_nOpenScreen == 15000 and CInt(cont0.grd0.rowcount) <= 100 then '잔고 탭일 경우 + 잔고가 100개 이하인 경우 실시간
				DATAMANAGER.CancelRealData( "ohhts_stck_incg" )
				DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
				f_CalcGridData()''실시간을 타더라도 1초후에 상단 data 셋팅은 늦기에 한번 해주고 timer
				
				if CInt(cont0.grd0.rowcount) > 0 then
					cont0.imgRealTime.visible = true
					cont0.lblRealTime.visible = true
					Form.SetTimerEvent(1, 1, 1)
				end if
			else'실시간을 타지 않는 경우 바로 계산
				cont0.imgRealTime.visible = false
				cont0.lblRealTime.visible = false
				f_CalcGridData()
			end if			
		end if
	ElseIf szTranID = "obpds_srvc_326r" Then
		g_szDEAL_FEE_CLS_CODE = 		DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock4", "DEAL_FEE_CLS_CODE" , 0 )		'매매수수료구분코드
		g_szBOND_RMNN_PRD_CLS_CODE = 	DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock4", "BOND_RMNN_PRD_CLS_CODE" , 0 )	'채권잔존기간구분코드
		g_szSTPL_LSLM_AMT = 			DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock4", "STPL_LSLM_AMT" , 0 )			'약정하한금액
		g_szSTPL_UPLM_AMT = 			DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock4", "STPL_UPLM_AMT" , 0 )			'약정상한금액
		g_szDEAL_FERT = 				DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock4", "DEAL_FERT" , 0 )			'매매수수료율
		g_szADTN_AMT = 				DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock4", "ADTN_AMT" , 0 )				'가산금액
		
		'20230713 htw start 개인법인 구분코드 추가
		szPRSN_CORP_CLS_CODE = 		DATAMANAGER.GetDataValue( false, "obpds_srvc_326r", "OutBlock3", "PRSN_CORP_CLS_CODE" , 0 )		'개인법인구분코드
		
		for i = 0 to grd326.rowcount - 1
			grd326.SetCellData("bd_cell6", i, szPRSN_CORP_CLS_CODE)
		next
		'20230713 htw end 개인법인 구분코드 추가
		
		'20230623 htw start 잔고 실시간 반영
'		if cont0.chk1.checkstate == "1" or cont0.chk1.checkstate == 1 then '신용합산
'			DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
'		else
'			DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
'		end if
		DATAMANAGER.RequestTranData( "obtrs_comn_308r" )
	ElseIf szTranID = "obtrs_comn_308r" Then
'		szUI_VLTN_ERT = DATAMANAGER.GetDataValue( false, "obtrs_comn_308r", "OutBlock1", "UI_VLTN_ERT" , 0 )
'
'		if szUI_VLTN_ERT == "NaNQ" or szUI_VLTN_ERT == "" or szUI_VLTN_ERT == null then
'			
'			cont0.tbl0.SetCellString(2, 5, "0")
'		else
'			cont0.tbl0.SetCellString(2, 5, szUI_VLTN_ERT)
'		end if
		if cont0.chk1.checkstate == "1" or CInt(cont0.chk1.checkstate) == 1 then '신용합산
			DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
		else
			DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
		end if
'		'20230623 htw end 잔고 실시간 반영
'	ElseIf szTranID = "ohhts_intr_004r" Then
'		Dim nCnt, szISCD, szPrc, szGrdCd
'		nCnt = CInt(DATAMANAGER.GetDataCount( false, "ohhts_intr_004r", "OutBlock1" ))
'		
'		for i = 0 to nCnt - 1
'			szISCD = DATAMANAGER.GetDataValue( false, "ohhts_intr_004r", "OutBlock1", "FID_CNCN_ISCD" , i)'종목코드
'			szPrc = DATAMANAGER.GetDataValue( false, "ohhts_intr_004r", "OutBlock1", "FID_CNCN_PRPR" , i)	'현재가
'			
'			f_CalcGridData(szISCD, szPrc)
'		next
'		
'		if g_nTR004r_GrdIdx < CInt(cont0.grd0.rowcount) then
'			DATAMANAGER.RequestTranData( "ohhts_intr_004r" )
'		else
'			if g_nOpenScreen == 15000 and CInt(cont0.grd0.rowcount) <= 100 then '잔고 탭일 경우 + 잔고가 100개 이하인 경우 실시간
'				DATAMANAGER.CancelRealData( "ohhts_stck_incg" )
'				DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
'			end if
'		end if
	ElseIf szTranID = "obacb_balc_154r" Then
		'20230828 아이디 연결여부 추가
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "ID_LNKN_YN" , i)
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		DATAMANAGER.RequestTranData( "obacb_balc_154r_1" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert( "알림" , szErrMsg )
End Sub

'20230623 htw start 잔고 실시간 반영
'============================================================================
function f_CalcGridData()
	Dim szGrdCd, nAbleSellQty, szFee_trgt_yn, dbFert, nAdtn_amt, szDeal_fee_code, szRound_code, szRndn_code, dbDeal_sxrt,dbDeal_ttrt
	Dim szNts1, szNts2, szNts3'농특세
	Dim szGrs1, szGrs2, szGrs3'거래세
	Dim nSellFee	'매도수수료
	Dim nTemp
	Dim nLslmAmt,nUplmAmt,dbFee326, nAdtnAmt326, szDeal_fee_code326'약정하한,상한금액,수수료율, 가산금액
	DIm szLoanCode
	Dim nBuyAmt, nBuyFee, nInter, nTax, nValAmt
	
	Dim nSumVAmt, nSumBuyAmt, nSumFee, nSumInter, nSumTax, nSumSon, nSumSellFee
	nSumVAmt, nSumBuyAmt, nSumFee, nSumInter, nSumTax, nSumSon, nSumSellFee = 0,0,0,0,0,0, 0
	
	'매도 수수료 = 교섭수수료가 Y이면 : 시세*수량*교섭수수료율 ///N이면 : obpds_srvc_326r(=grd326)로 계산
	
	for i = 0 to cont0.grd0.rowcount - 1
		szPrc = 			CInt(cont0.grd0.GetCellData("bd_cell4", i))'현재가
		nQty = 			CInt(cont0.grd0.GetCellData("bd_cell1", i))'보유수량
		'20230727 htw start Trim 추가
		szLoanCode = 		Trim(cont0.grd0.GetCellData("bd_cell32", i))'대출상세유형코드
		szFee_trgt_yn = 	Trim(cont0.grd0.GetCellData("bd_cell33", i))'교섭수수료대상여부
		dbFert = 		CDbl(cont0.grd0.GetCellData("bd_cell35", i))'교섭수수료율
		nAdtn_amt = 		CDbl(cont0.grd0.GetCellData("bd_cell37", i))'가산금액				'20230817
		szDeal_fee_code =	Trim(cont0.grd0.GetCellData("bd_cell39", i))'매매수수료구분코드
		szRound_code = 	Trim(cont0.grd0.GetCellData("bd_cell34", i))'반올림구분코드
		szRndn_code = 	Trim(cont0.grd0.GetCellData("bd_cell36", i))'절사기준코드
		dbDeal_sxrt = 	CDbl(cont0.grd0.GetCellData("bd_cell38", i))'매매농특세율
		dbDeal_ttrt = 	CDbl(cont0.grd0.GetCellData("bd_cell40", i))'매매거래세율
	
		nSellFee = 0'20230721 htw 초기화추가
		'매도수수료 start=================================================================
		'szPrc=현재가

		if szFee_trgt_yn == "Y" or szFee_trgt_yn == "y" then	'교섭수수료가 Y
			nSellFee = nQty * CInt(szPrc) * dbFert + nAdtn_amt
		else							'교섭수수료가 N
			nTemp = nQty * CInt(szPrc)
			
			for j = 0 to grd326.rowcount - 1
				nLslmAmt  = Cdbl(grd326.GetCellData("bd_cell2", j))				'20230817
				nUplmAmt  = Cdbl(grd326.GetCellData("bd_cell3", j))				'20230817
				szDeal_fee_code326 = Trim(grd326.GetCellData("bd_cell0", j))
				'20230727 htw end Trim 추가
				if szDeal_fee_code == szDeal_fee_code326 then
					if nLslmAmt<= nTemp and nTemp <= nUplmAmt then
						dbFee326 = CDbl(grd326.GetCellData("bd_cell4", j))
						nAdtnAmt326 = Cdbl(grd326.GetCellData("bd_cell5", j))		'20230817
						nSellFee = Clng(dbFee326 * nTemp / 100 + nAdtnAmt326)		'20230817
					end if
				end if
			next
		end if
		
		'20230713 htw start 개인법인코드 01(개인)이 아니면 10원미만 절사(버림)
		szPRSN_CORP_CLS_CODE = grd326.GetCellData("bd_cell6", 0)
		
		if szPRSN_CORP_CLS_CODE <> "01" then
			nSellFee = round(nSellFee - 5,-1)
		end if
		
		cont0.grd0.SetCellData("bd_cell28", i, nSellFee)
		'20230713 htw end 개인법인코드 01(개인)이 아니면 원미만 절사(버림)
		
		'매도수수료 end=================================================================
		'농특세 start=================================================================
		'20230626 htw start FormatNumber()함수 작동 시 공란이 생기는 케이스가 있어 예외처리 추가
		szNts1 = CDbl(nQty * CInt(szPrc) * dbDeal_sxrt)'농특세
		if szNts1 == "0" or szNts1 == 0 then
			szNts2 = szNts1
		else
			Select Case szRound_code
				Case "00"	'소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(농특세1,0)
'						szNts2 = FormatNumber(szNts1,0)
'						szNts2 =FormatNumber(szNts1 - 0.5,0)
					szNts2 = round(szNts1 - 0.5,0)
				Case "01"	'0번째에서 반올림 후 소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(ROUND(농특세1,0),0)
'						szNts2 = FormatNumber(szNts1 + 0.5,0)
					szNts2 = round(szNts1,0)
				Case "02"	'1번째에서 반올림 후 소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(ROUND(농특세1,1),0)
'						szNts2 = FormatNumber(szNts1 + 0.05,0)
					szNts2 = round(szNts1,1)
					szNts2 = round(szNts2 - 0,5,0)
				Case "03"	'2번째에서 반올림 후 소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(ROUND(농특세1,2),0)
					szNts2 = round(szNts1,2)
					szNts2 = round(szNts2 - 0.5,0)
			end Select

'				if szNts2 <> "" and szNts2 <> "0" and szNts2 <> 0 and szNts2 <> null then
'					szNts2 = Replace(szNts2,",","")
'				else
'					szNts2 = "0"
'				end if
		end if
		
		if szNts2 == "0" or szNts2 == 0 then
			szNts3 = szNts2
		else
			Select Case szRndn_code
				Case "00"
					szNts3 = szNts2
				Case "01"	'소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(농특세2 + 0.5,0)
'						szNts3 = FormatNumber(szNts2 + 0.5,0)
'						szNts3 = FormatNumber(szNts2 + 0.5 - 0.5,0)
					szNts3 = round(szNts2 + 0.5 - 0.5,0)
				Case "02"	'소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(농특세2 + 0.4,0)
'						szNts3 = FormatNumber(szNts2 + 0.4,0)
'						szNts3 = FormatNumber(szNts2 + 0.4 - 0.5,0)
					szNts3 = round(szNts2 + 0.4 - 0.5,0)
				Case "03"	'소숫점 1번째 버림(0번째 까지만 나옴)
					'TRUNC(농특세2,0)
'						szNts3 = FormatNumber(szNts2,0)
					szNts3 = round(szNts2 - 0.5,0)
				Case "04"	'소숫점 1번째 올림(0번째 까지만 나옴)=szNts2와 동일
					'CEIL(농특세2,0)
'						szNts3 = szNts2
					szNts3 = round(szNts2 + 0.5,0)
			end Select
'				if szNts3 <> "" and szNts3 <> "0" and szNts3 <> 0 and szNts3 <> null then
'					szNts3 = Replace(szNts3,",","")
'				else
'					szNts3 = "0"
'				end if
		end if
		'농특세 end=================================================================
		'거래세 start=================================================================
		szGrs1 = CDbl(nQty * CInt(szPrc) * dbDeal_ttrt)'거래세
		if szGrs1 == "0" or szGrs1 == 0 then
			szGrs2 = szGrs1
		else
			Select Case szRound_code
				Case "00"
					'TRUNC(거래세1,0)
'						szGrs2 = FormatNumber(szGrs1,0)
'						szGrs2 = FormatNumber(szGrs1 - 0.5,0)
					szGrs2 = round(szGrs1 - 0.5,0)
				Case "01"
					'TRUNC(ROUND(거래세1,0),0)
'						szGrs2 = FormatNumber(szGrs1,0)
					szGrs2 = round(szGrs1,0)
				Case "02"
					'TRUNC(ROUND(거래세1,1),0)
'						szGrs2 = FormatNumber(szGrs1 + 0.05,0)
					szGrs2 = round(szGrs1,1)
					szGrs2 = round(szGrs2 - 0,5,0)
				Case "03"
					'TRUNC(ROUND(거래세1,2),0)
					szGrs2 = round(szGrs1,2)
					szGrs2 = round(szGrs2 - 0.5,0)
			end Select
			
'				if szGrs2 <> "" and szGrs2 <> "0" and szGrs2 <> 0 and szGrs2 <> null then
'					szGrs2 = Replace(szGrs2,",","")
'				else
'					szGrs2 = "0"
'				end if
		end if
		
		if szGrs2 == "0" or szGrs2 == 0 then
			szGrs3 = szGrs2
		else
			Select Case szRndn_code
				Case "00"
					szGrs3 = szGrs2
				Case "01"
'						szGrs3 = FormatNumber(szGrs2 + 0.5,0)
					'TRUNC(거래세2 + 0.5,0)
					szGrs3 = round(szGrs2 + 0.5 - 0.5,0)
				Case "02"
'						szGrs3 = FormatNumber(szGrs2 + 0.4,0)
					'TRUNC(거래세2 + 0.4,0)
					szGrs3 = round(szGrs2 + 0.4 - 0.5,0)
				Case "03"
'						szGrs3 = FormatNumber(szGrs2,0)
					'TRUNC(거래세2,0)
					szGrs3 = round(szGrs2 - 0.5,0)
				Case "04"
'						szGrs3 = szGrs2
					'CEIL(거래세2,0)
					szGrs3 = round(szGrs2 + 0.5,0)
			end Select
'				if szGrs3 <> "" and szGrs3 <> "0" and szGrs3 <> 0 and szGrs3 <> null then
'					szGrs3 = Replace(szGrs3,",","")
'				else
'					szGrs3 = "0"
'				end if
		end if
		'20230626 htw end FormatNumber()함수 작동 시 공란이 생기는 케이스가 있어 예외처리 추가
		'거래세 end=================================================================
		'제세금 start=================================================================
		if szLoanCode == "0103" or szLoanCode == "0104" then
			'제세금=0
			cont0.grd0.SetCellData("bd_cell26", i, "0")
		else
			cont0.grd0.SetCellData("bd_cell26", i, Cdbl(szNts3) + Cdbl(szGrs3))		'20230817
		end if
		'제세금 end=================================================================
		'평가손익 start=================================================================
		
		nBuyAmt = Cdbl(cont0.grd0.GetCellData("bd_cell3", i))'매입금액		'20230817
		nBuyFee = Cdbl(cont0.grd0.GetCellData("bd_cell25", i))'매수수수료	'20230817
		nSellFee = Cdbl(cont0.grd0.GetCellData("bd_cell28", i))'매도수수료	'20230817
		nInter = Cdbl(cont0.grd0.GetCellData("bd_cell27", i))'이자			'20230817
		nTax = Cdbl(cont0.grd0.GetCellData("bd_cell26", i))'제세금			'20230817
		
		if szLoanCode == "0103" or szLoanCode == "0104" then
			'매입금액-시세*수량-(비용포함=매수수수료+이자+제세금+매도수수료)
			if cont0.chk2.checkstate == "1" then'비용포함
				cont0.grd0.SetCellData("bd_cell2", i, nBuyAmt - nQty * CInt(szPrc) - (nBuyFee + nInter + nTax + nSellFee))
			else
				cont0.grd0.SetCellData("bd_cell2", i, nBuyAmt - nQty * CInt(szPrc))
			end if
		else
			'시세*수량 - 매입금액-(비용포함=매수수수료+이자+제세금+매도수수료)
			if cont0.chk2.checkstate == "1" then'비용포함
				cont0.grd0.SetCellData("bd_cell2", i, nQty * CInt(szPrc) - nBuyAmt - (nBuyFee + nInter + nTax + nSellFee))
			else
				cont0.grd0.SetCellData("bd_cell2", i, nQty * CInt(szPrc) - nBuyAmt)
			end if
		end if
		'평가손익 end=================================================================
		'수익률 start=================================================================
		nValAmt = Cdbl(cont0.grd0.GetCellData("bd_cell2", i))'평가손익		'20230817
		if nBuyAmt == 0 then'분모가 0일 때
			cont0.grd0.SetCellData("bd_cell12", i, 0)
		else
			cont0.grd0.SetCellData("bd_cell12", i, CDbl(nValAmt / nBuyAmt * 100))
		end if
		'수익률 end=================================================================
		'평가금액 start=================================================================
		cont0.grd0.SetCellData("bd_cell13", i, nQty * CInt(szPrc))
		'평가금액 end=================================================================
		'BEP단가 start=================================================================
		'비용포함인 경우에만 해당=매입금액 + 매수수수료 + 매도수수료(추정) + 제세금(추정) + 이자(추정) / 보유수량
		if cont0.chk2.checkstate == "1" then'비용포함
			if nQty > 0 then
				cont0.grd0.SetCellData("bd_cell7", i, Clng((nBuyAmt + nBuyFee + nSellFee + nTax + nInter) / nQty) )		'20230817
			else
				cont0.grd0.SetCellData("bd_cell7", i, "0" )
			end if
		end if
		'BEP단가 end=================================================================
		'현재가 color적용 start======================================================
		'현재가>종가
		nClpr = CInt(cont0.grd0.GetCellData("bd_cell21", i ))'종가
		if CInt(szPrc) > nClpr then
			cont0.grd0.SetCellFgColor("bd_cell4", i, "10")
		elseif CInt(szPrc) == nClpr then
			cont0.grd0.SetCellFgColor("bd_cell4", i, "4")
		else
			cont0.grd0.SetCellFgColor("bd_cell4", i, "11")
		end if
		'현재가 color적용 end========================================================
		
		'Top계산
		nSumVAmt = nSumVAmt + 		Cdbl(cont0.grd0.GetCellData("bd_cell13",i))'평가금액		'20230817
		nSumBuyAmt = nSumBuyAmt + 	Cdbl(cont0.grd0.GetCellData("bd_cell3", i))'매입금액		'20230817
		'====비용포함 시 사용 start
		nSumFee = nSumFee + 		Cdbl(cont0.grd0.GetCellData("bd_cell25", i))'매수수수료	'20230817
		nSumSellFee = nSumSellFee +	Cdbl(cont0.grd0.GetCellData("bd_cell28", i))'매도수수료	'20230817
		nSumInter = nSumInter + 	Cdbl(cont0.grd0.GetCellData("bd_cell27", i))'이자			'20230817
		nSumTax = nSumTax + 		Cdbl(cont0.grd0.GetCellData("bd_cell26", i))'제세금		'20230817
		'====비용포함 시 사용 end
		
		nSumSon = nSumSon + 		Cdbl(cont0.grd0.GetCellData("bd_cell2",i))'평가손익		'20230817
		
	next
	cont0.tbl0.SetCellString(0, 3, nSumVAmt)
	cont0.tbl0.SetCellString(3, 1, nSumBuyAmt)'매입금액
	cont0.tbl0.SetCellString(2, 1, nSumSon)
	
	if nSumBuyAmt == 0 then
		cont0.tbl0.SetCellString(2, 4, 0)
	else
		cont0.tbl0.SetCellString(2, 4, nSumSon / nSumBuyAmt * 100)
	end if	
	
'	Dim nSumVAmt, nSumBuyAmt, nSumFee, nSumInter, nSumTax, nSumSon, nSumSellFee
'	nSumVAmt, nSumBuyAmt, nSumFee, nSumInter, nSumTax, nSumSon, nSumSellFee = 0,0,0,0,0,0, 0
'	for i = 0 to cont0.grd0.rowcount - 1
'		nSumVAmt = nSumVAmt + 		CInt(cont0.grd0.GetCellData("bd_cell13",i))'평가금액
'		nSumBuyAmt = nSumBuyAmt + 	CInt(cont0.grd0.GetCellData("bd_cell3", i))'매입금액
'		'====비용포함 시 사용 start
'		nSumFee = nSumFee + 		CInt(cont0.grd0.GetCellData("bd_cell25", i))'매수수수료
'		nSumSellFee = nSumSellFee +	CInt(cont0.grd0.GetCellData("bd_cell28", i))'매도수수료
'		nSumInter = nSumInter + 	CInt(cont0.grd0.GetCellData("bd_cell27", i))'이자
'		nSumTax = nSumTax + 		CInt(cont0.grd0.GetCellData("bd_cell26", i))'제세금
'		'====비용포함 시 사용 end
'		
'		nSumSon = nSumSon + 		CInt(cont0.grd0.GetCellData("bd_cell2",i))'평가손익
'	next
'	
'	cont0.tbl0.SetCellString(0, 1, nSumVAmt)
'	if CInt(cont0.chk2.checkstate) == 1 then
'		cont0.tbl0.SetCellString(2, 1, nSumVAmt - nSumBuyAmt - (nSumFee + nSumInter + nSumTax + nSumSellFee))
'	else
'		cont0.tbl0.SetCellString(2, 1, nSumVAmt - nSumBuyAmt)
'	end if
'	if nSumBuyAmt == 0 then
'		cont0.tbl0.SetCellString(2, 5, 0)
'	else
'		cont0.tbl0.SetCellString(2, 5, nSumSon / nSumBuyAmt * 100)
'	end if
'	f_SetTopSumData()
end function
'20230623 htw end 잔고 실시간 반영

