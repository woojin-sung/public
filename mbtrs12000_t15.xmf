Sub Form_OnFormInit()

	'20230623 htw start 잔고메뉴인 경우 기간손익 버튼 제공
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	if szScreenNo <> "12000" then
		cont0.btnPeriod.left = 295
