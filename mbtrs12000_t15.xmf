'============================================================================
Sub cont0_btnViewChange_OnClick()
	'0=현재 리스트형 1= 현재 카드형
	if g_nView == 0 then
		g_nView = 1
		
		'20230726 SWJ START : AOS 화면을 움직이지 않으면 실시간 시세를 받지 못함
		'visible true/false 처리 수정
		'cont0.grd0.visible = 0
		cont0.grd0.left = 500
		'20230726 SWJ END
		
		cont0.grdCard.visible = 1
		cont0.btnViewChange.caption = "리스트형"
	else
		g_nView = 0
		cont0.grdCard.visible = 0
		
		'20230726 SWJ START : AOS 화면을 움직이지 않으면 실시간 시세를 받지 못함
		'visible true/false 처리 수정
		'cont0.grd0.visible = 1
		cont0.grd0.left = 10
		'20230726 SWJ END

		cont0.btnViewChange.caption = "카드형"
	end if
End Sub

