'============================================================================
Function f_SetGridText()'대용,대출 등 text 삽입
	Dim nCnt, szLOAN_AMT, szMTRT_DATE
		
	nCnt = DATAMANAGER.GetDataCount( false, szTranID , "OutBlock1" )

	if CInt(cont0.grd0.rowcount) == 0 then
		cont0.chk2.visible = false
		cont0.chk1.visible = false
		cont0.btnViewChange.visible = false
		cont0.grdCard.visible = false
		
		'20230726 SWJ START : AOS 화면을 움직이지 않으면 실시간 시세를 받지 못함
		'visible true/false 처리 수정
		'cont0.grd0.visible = false
		cont0.grd0.left = 500
		'20230726 SWJ END
		
		cont0.btnPeriod.visible = false
		cont0.imgRealTime.visible = false
		cont0.lblRealTime.visible = false
		
		cont0.grd0.height = 265
		
		cont0.imgNodata.visible = true
		cont0.lblNodata.visible = true
	else
		cont0.imgNodata.visible = false
		cont0.lblNodata.visible = false
	
		cont0.chk2.visible = true
		cont0.chk1.visible = true
'			cont0.btnViewChange.visible = true	'임시 주석
		if g_nOpenScreen <> 12000 then
			cont0.btnPeriod.visible = true
		end if
		'20230622 htw start OS간 SetScrollAutoSize()가 달라 visible 뷰만 height 처리
		if g_nView == 0 then
'			cont0.grd0.height = CInt(cont0.grd0.rowcount) * 54 + 45 + 7'7=여유 공간			
			if szScreenNo == "15000" then
				cont0.grd0.height = 470'잔고화면
			else'주문 잔고탭
				cont0.grd0.height = 411
			end if
			
			if CInt(cont0.grd0.rowcount) < 8 then
				cont0.grd0.height = 45 + CInt(cont0.grd0.rowcount) * 54 + 2
			end if
			
			cont0.grdCard.height = 0
			cont0.grdCard.visible = false
			
			'20230726 SWJ START : AOS 화면을 움직이지 않으면 실시간 시세를 받지 못함
			'visible true/false 처리 수정
			'cont0.grd0.visible = true
			cont0.grd0.left = 10
			'20230726 SWJ END
		else
			cont0.grdCard.height = CInt(cont0.grd0.rowcount) * 94 + 7
			cont0.grd0.height = 0
			
			'20230726 SWJ START : AOS 화면을 움직이지 않으면 실시간 시세를 받지 못함
			'visible true/false 처리 수정
			'cont0.grd0.visible = false
			cont0.grd0.left = 500
			'20230726 SWJ END
			
			cont0.grdCard.visible = true
		end if
		'20230622 htw end OS간 SetScrollAutoSize()가 달라 visible 뷰만 height 처리
	end if
	SetGridData()

	cont0.SetScrollAutoSize()
	
	dim szInt_amt, szOvfe, szExpn_amt, szFee, szBuyFee

	For i = 0 To cont0.grd0.rowcount - 1
		
		szInt_amt = cont0.grd0.GetCellData("bd_cell31", i)'대출이자금액
		szOvfe = cont0.grd0.GetCellData("bd_cell30", i)'대출연체료
		szExpn_amt = cont0.grd0.GetCellData("bd_cell29", i)'비용금액
		szFee = cont0.grd0.GetCellData("bd_cell26", i)'제세금
		szBuyFee = cont0.grd0.GetCellData("bd_cell25", i)'매수수수료
		
		cont0.grd0.SetCellData("bd_cell27",i,Cdbl(szInt_amt) - Cdbl(szOvfe))'이자(연체이자 포함임)			'20230817
		cont0.grd0.SetCellData("bd_cell28",i,Cdbl(szExpn_amt) - (Cdbl(szInt_amt) - Cdbl(szOvfe) + Cdbl(szFee) + Cdbl(szBuyFee)))'매도 수수료		'20230817
		
		cont0.grd0.SetCellData("bd_idx", i, i)'인덱스 저장(grdCard Click과 동일한 행 찾기용)
		psnt_prc = Cdbl(cont0.grd0.GetCellData("bd_cell4", i))
		psdy_clpr= Cdbl(cont0.grd0.GetCellData("bd_cell21",i))
		
'			01현금 02대출 03신용 04대주 05대여 06대용 07재활용 99기타			
		szGbn = cont0.grd0.GetCellData("bd_cell24",i)
		szLOAN_AMT = cont0.grd0.GetCellData("bd_cell6",i)
		szMTRT_DATE = cont0.grd0.GetCellData("bd_cell5",i)

		Select Case szGbn
			Case "01"
				cont0.grd0.SetCellData("bd_cell10", i, "현금")
			Case "02"
				cont0.grd0.SetCellData("bd_cell10", i, "대출")	
				
				cont0.grdCard.SetCellData("bd_tag", i, "대출")
				cont0.grdCard.SetCellFgColor("bd_tag", i, "62")
				cont0.grdCard.SetCellImage("bd_tag", i, "btn_38_n.9")
				cont0.grdCard.SetCellData("bd_text_prc", i, "대출 "..FormatNumber(szLOAN_AMT,0).."원")
				if szTranID = "obtrs_comn_310r" Then
					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
				end if
			Case "03"
				cont0.grd0.SetCellData("bd_cell10", i, "신용")
				
				cont0.grdCard.SetCellData("bd_tag", i, "신용")
				cont0.grdCard.SetCellImage("bd_tag", i, "btn_37_n.9")
				cont0.grdCard.SetCellFgColor("bd_tag", i, "4")
				cont0.grdCard.SetCellData("bd_text_prc", i, "신용 "..FormatNumber(szLOAN_AMT,0).."원")
				if szTranID = "obtrs_comn_310r" Then
					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
				end if
			Case "04"
				cont0.grd0.SetCellData("bd_cell10", i, "대주")
'					cont0.grdCard.SetCellData("bd_tag", i, "대주")	'기획서에는 대주는 없음
			Case "05"
				cont0.grd0.SetCellData("bd_cell10", i, "대여")
				
				cont0.grdCard.SetCellData("bd_tag", i, "대여")
				cont0.grdCard.SetCellImage("bd_tag", i, "btn_38_n.9")
				cont0.grdCard.SetCellFgColor("bd_tag", i, "62")
				cont0.grdCard.SetCellData("bd_text_prc", i, "대여 "..FormatNumber(szLOAN_AMT,0).."원")
				if szTranID = "obtrs_comn_310r" Then
					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
				end if
			Case "06"
				cont0.grd0.SetCellData("bd_cell10", i, "대용")
				
				cont0.grdCard.SetCellData("bd_tag", i, "대용")
				cont0.grdCard.SetCellImage("bd_tag", i, "btn_38_n.9")
				cont0.grdCard.SetCellFgColor("bd_tag", i, "62")
				cont0.grdCard.SetCellData("bd_text_prc", i, "대용 "..FormatNumber(szLOAN_AMT,0).."원")
				if szTranID = "obtrs_comn_310r" Then
					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
				end if
			Case "07"
				cont0.grd0.SetCellData("bd_cell10", i, "재활용")
			Case "99"
				cont0.grd0.SetCellData("bd_cell10", i, "기타")
		end Select
		
		'순매입금액 추가
		If Trim(cont0.grd0.GetCellData("bd_cell3", i)) == "" Then
			byng_amt = 0
		Else
			byng_amt = Cdbl(cont0.grd0.GetCellData("bd_cell3", i))
		End If

		If Trim(cont0.grd0.GetCellData("bd_cell6", i)) == "" Then
			loan_amt = 0
		Else
			loan_amt = Cdbl(cont0.grd0.GetCellData("bd_cell6", i))
		End If

		cont0.grd0.SetCellData("bd_cell16", i, byng_amt - loan_amt)
	Next
end Function

'============================================================================
Function SetGridData()
	Dim i, nRate, szData, szReturnValue
	Dim nVLTN_PRLS_AMT      ' 평가손익
	Dim nBYNG_AMT           ' 매입금액
	Dim nEXPN_AMT           ' 비용금액
	Dim nTOT_VLTN_PRLS_AMT  ' 평가손익합계
	Dim nTOT_BYNG_AMT       ' 매입금액합계
	Dim szLOAN_DATE         ' 대출일자

	nVLTN_PRLS_AMT     = 0
	nBYNG_AMT          = 0
	nTOT_VLTN_PRLS_AMT = 0
	nTOT_BYNG_AMT      = 0

	g_Toggle1 = 0
	g_Toggle2 = 0

'	SetGridHeader(g_Toggle1, g_Toggle2)


	For i = 0 To cont0.grd0.rowcount -1

		If cont0.chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT  = CDbl( cont0.grd0.GetCellData( "bd_cell2", i ) ) - CDbl( cont0.grd0.GetCellData("bd_cell20", i) )  '신용이자
		Else
			nVLTN_PRLS_AMT  = CDbl( cont0.grd0.GetCellData( "bd_cell2", i ) )
		End If

		nBYNG_AMT   = CDbl( cont0.grd0.GetCellData( "bd_cell3", i ) )
		nPSNT_PRC   = cont0.grd0.GetCellData( "bd_cell4" , i )
		szData      = cont0.grd0.GetCellData( "bd_cell17" , i )
		szLOAN_DATE = cont0.grd0.GetCellData( "bd_cell5", i)
		szRMND_CLCD = cont0.grd0.GetCellData( "bd_cell22", i)

		nTOT_VLTN_PRLS_AMT = nTOT_VLTN_PRLS_AMT + nVLTN_PRLS_AMT
		nTOT_BYNG_AMT      = nTOT_BYNG_AMT + nBYNG_AMT

		cont0.grd0.SetCellData("bd_cell2", i, nVLTN_PRLS_AMT)

		'매입금액이 있는 경우에만 계산
		If CDbl( cont0.grd0.GetCellData("bd_cell3", i) ) = 0 Then
			cont0.grd0.SetCellData("bd_cell12", i, "" )
		Else
			'수익률이 천단위가 넘는 경우 콤마가 중복으로 생기므로 FormatNumber 제거
			'cont0.grd0.SetCellData("bd_cell7", i, FormatNumber(FIX((nVLTN_PRLS_AMT/nBYNG_AMT)*10000)/100,2))
			cont0.grd0.SetCellData("bd_cell12", i, Fix( (nVLTN_PRLS_AMT/nBYNG_AMT) * 10000) / 100 )
		End If


		If nPSNT_PRC = "" and cont0.chk2.checkstate = "1" Then
			Dim nData
			nData = CDbl(cont0.grd0.GetCellData( "bd_cell18", i )) * -1
			cont0.grd0.SetCellData( "bd_cell2", i, nData )
		End If

		If szData = "0101" Or szData = "0102" Or szData = "0103" Or szData = "0104" Or
		   szData = "0201" Or szData = "0202" Or szData = "0203" Or szData = "0204" Or
		   szData = "0301" Then
			cont0.grd0.SetCellData( "bd_cell7", i, "" )
		ElseIf CDbl(cont0.grd0.GetCellData( "bd_cell1", i )) = 0 Then
			cont0.grd0.SetCellData( "bd_cell7", i, 0 )
		Else
			nBepUnpr = Fix( CDbl(cont0.grd0.GetCellData( "bd_cell23", i )) + ( CDbl(cont0.grd0.GetCellData( "bd_cell20", i ))  / CDbl(cont0.grd0.GetCellData( "bd_cell1", i )) ) )
			cont0.grd0.SetCellData( "bd_cell7", i, nBepUnpr )
		End If

		Select Case szData
			Case "0000" szReturnValue = "보통"
			Case "0101" szReturnValue = "자기융자"
			Case "0102" szReturnValue = "유통융자"
			Case "0103" szReturnValue = "자기대주"
			Case "0104" szReturnValue = "유통대주"
			Case "0201" szReturnValue = "예탁주식"
			Case "0202" szReturnValue = "예탁채권"
			Case "0203" szReturnValue = "예탁집합투자"
			Case "0204" szReturnValue = "예탁장외파생"
			Case "0211" szReturnValue = "예탁유통주식"
			Case "0212" szReturnValue = "예탁유통채권"
			Case "0213" szReturnValue = "예탁유통집합투자"
			Case "0214" szReturnValue = "예탁유통장외파생"
			Case "0301" szReturnValue = "매도증권담보대출"
			Case "0302" szReturnValue = "수익증권환매"
			Case "0303" szReturnValue = "ELS환매자금대출"
			Case "0401" szReturnValue = "소액주식"
			Case "0402" szReturnValue = "소액채권"
			Case "0403" szReturnValue = "소액수익증권"
			Case "0404" szReturnValue = "소액 ELS"
			Case "0501" szReturnValue = "공모주청약"
			Case "0502" szReturnValue = "ELS청약"
			Case "0503" szReturnValue = "주식매입"
			Case "0601" szReturnValue = "매입자금대출"
			Case "0701" szReturnValue = "초단기대출"
			Case "0801" szReturnValue = "CMA담보대출"
			Case "9201" szReturnValue = "대출(대여)" 'v003
			Case "8201" szReturnValue = "양도담보" 'v004
			Case "6201" szReturnValue = "슈퍼365(재활용)" '20230908 SWJ
			Case "7201" szReturnValue = "담보대여" 		'20230908 SWJ
			Case Else   szReturnValue = szData
		End Select

		If szData = "0000" Then
			If szRMND_CLCD = "31" Then
				szReturnValue = "주식대여"				'20230908 SWJ
			ElseIf szRMND_CLCD = "32" Then
				szReturnValue = "CFD대용"
			ElseIf szRMND_CLCD = "16" Then
				szReturnValue = "선물대용"
			End If
		End If

		cont0.grd0.SetCellData( "bd_cell17", i, szReturnValue )

	Next

End Function 
'============================================================================
Sub cont0_grd0_OnClickUp(lRow, szCellID)
	Dim szItemCode, szQty, szLoanDate, szLoanCd, szLoanSr, szLoan, listLocation
    Dim szCutCd, szMk
    Dim errmsg

    errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

    g_szItemCode    =   cont0.grd0.GetCellData("bd_cell8", lRow)

    listLocation =  Split(cont0.grd0.location,":")
    nYPos = Int(listLocation[1])
    height = listLocation[3]

    szItemCode = cont0.grd0.GetCellData("bd_cell8", lRow)
    szQty      = cont0.grd0.GetCellData("bd_cell11" , lRow)
    szLoanDate = cont0.grd0.GetCellData("bd_cell5", lRow)
    szLoanCd   = cont0.grd0.GetCellData("bd_cell9", lRow)
    szLoanSr   = cont0.grd0.GetCellData("bd_cell19", lRow)
    szRmndCd   = cont0.grd0.GetCellData("bd_cell22", lRow)
    g_szRmndCd = szRmndCd   '전역변수로 사용하기 위함
    g_szLoanCd = szLoanCd  '전역변수로 사용하기 위함

    If szLoanCd = "0000" And (szRmndCd = "31" Or szRmndCd = "32" Or szRmndCd = "16") Then
        sPopupType = "3"
'		sPopupType = "2"

	'20230908 SWJ START : 대여잔고 구분 세분화 (주식대여, 담보대여, 슈퍼365 재활용)
    elseif szLoanCd = "6201" or szLoanCd = "7201" then
	    sPopupType = "4"
    elseif  szLoanCd = "8201" then
	    Form.ShowAlert("알림", "양도담보 잔고는 매도주문이 불가능 합니다.")
	    Exit Sub
    elseif szLoanCd = "9201" then
	    Form.ShowAlert("알림", "대출대여 잔고는 MTS에서 매도주문이 불가능 합니다.")
		Exit Sub
    '20230908 SWJ END
    Else
        sPopupType = "2"
    End If

    ' 20160310 주문불가한 종목 예외처리
    ' 20170502 상장수익증권 예외처리 'F'
    ' case: 신주인수권/증권 (9자리)
    If (left(szItemCode,1) ="J" And len(szItemCode) == 9) Or left(szItemCode,1) ="Q" Or left(szItemCode,1) = "F" Then
        szMk = Form.GetItemCodeInfo(szItemCode, "market")
    ' Else: 기타
    Else
        ' 20160310 주문불가한 종목 예외처리
        szCutCd = Mid(szItemCode, 2, Len(szItemCode))
        szMk = Form.GetItemCodeInfo(szCutCd, "market")
    End If

    If Trim(szMk) = "J" Or Trim(szMk) = "Q" Or Trim(szMk) = "W" Or Trim(szMk) = "T" Then
        ' 전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
        ' 전달내용, 탭위치는 리턴받아서 처리함.
        g_szData = szItemCode & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & cont0.chk1.checkstate & "♥" & szLoanSr

        g_szSelect = "1"

        If sPopupType = "2" Then
            Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "" & "★" & g_szItemCode)
        ElseIf sPopupType = "3" Then
            If szRmndCd = "31" Then
                Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            ElseIf szRmndCd = "32" Or szRmndCd = "16" Then
                Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "대용매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            Else
                Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            End If
	    
	    '20230908 SWJ START
	   elseif sPopupType = "4" Then
		   Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & "3" & "★" &  "J"  & "★" & "현재가" & "★" & "매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
	   '20230908 SWJ END
        End If
		
    Else
        Form.MsgBox("알림", errmsg, "REUPDATE", 1)
    End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	
	if sKeyName == "MOVEPOP_RETURN" then
		Dim szListItems
		szListItems =   Split(sRet,"★")

		'20230714 htw start 종목코드 변환 함수 추가
		szItemCd = fn_ItemCdToMCI(g_szItemCode)

		If  szListItems(2)  =   "2" Then
			If  szListItems(1)  =   "0" Then            '현재가
'				Form.OpenScreen("11000" , g_szItemCode & "★" & "0")
				Form.OpenScreen("11000" , szItemCd & "★" & "0")
				
			ElseIf  szListItems(1)  =   "1" then        '매수
				If g_szLoanCd = "0103" Or g_szLoanCd = "0104" Then
					Form.OpenScreen("12090" , "잔고" & "★" & "1" & "★" & g_szData )
				Else
					if szScreenNo == "12000" then
						Form.triggerEvent("#", "12000_JANGO_TAB", "잔고" & "★" & "0" & "★" & g_szData)
					else
						Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
					end if
				End If
			ElseIf  szListItems(1)  =   "2" then        '매도
				If g_szLoanCd = "0103" Or g_szLoanCd = "0104" Then
					Form.OpenScreen("12090" , "잔고" & "★" & "0" & "★" & g_szData )
				Else
'					Form.OpenScreen("12000" , "잔고" & "★" & "1" & "★" & g_szData )
					if szScreenNo == "12000" then
						Form.triggerEvent("#", "12000_JANGO_TAB", "잔고" & "★" & "1" & "★" & g_szData)
					else
						Form.OpenScreen("12000" , "잔고" & "★" & "1" & "★" & g_szData )
					end if
				End If
			ElseIf  szListItems(1)  =   "6" Then        '차트
'				Form.OpenScreen("13000" , g_szItemCode)
				Form.OpenScreen("13000" , szItemCd)
			End If
		ElseIf  szListItems(2)  =   "3" Then
			If  szListItems(1)  =   "0" Then            '현재가
'				Form.OpenScreen("11000" , g_szItemCode & "★" & "0")
				Form.OpenScreen("11000" , szItemCd & "★" & "0")
			ElseIf  szListItems(1)  =   "1" Then        '대여매도
				If g_szRmndCd = "31" Then
					Form.OpenScreen("12060" , "잔고" & "★" & "0" & "★" & g_szData )
				Else
					'20230908 SWJ START
					if g_szLoanCd == "6201" or g_szLoanCd == "7201" then
						Form.OpenScreen("12060" , "잔고" & "★" & "0" & "★" & g_szData )
					else
						Form.OpenScreen("12080" , "잔고" & "★" & "0" & "★" & g_szData )
					end if
					'20230908 SWJ END
				End If
			ElseIf  szListItems(1)  =   "2" Then        '대용매수
'				Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
				if szScreenNo == "12000" then
					Form.triggerEvent("#", "12000_JANGO_TAB", "잔고" & "★" & "0" & "★" & g_szData)
				else
					Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
				end if
			ElseIf  szListItems(1)  =   "6" Then        '차트
'				Form.OpenScreen("13000" , g_szItemCode)
				Form.OpenScreen("13000" , szItemCd)
		'20230714 htw end 종목코드 변환 함수 추가
			End If
		End If

		g_szData = ""
	elseif sKeyName == "mbtrs12000_po" then
		'카드형 리스트 상세 팝업에서 넘어온 data
		if sRet <> "" then
			Dim szData
			szData = Split(sRet,"☆")
			
			Form.OpenScreen(szData(0) , szData(1))
		end if
	end if
	
End Sub

