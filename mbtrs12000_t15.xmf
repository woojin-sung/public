'============================================================================
Sub cont0_grdCard_OnClickUp(lRow, szCellID)
	'종목명/평가금액/매입금액/평가손익/수익률/잔고구분/잔고수량/매입단가/신용,대출금/신용,대출일(질권일)/만기일/종목코드
	'data는 grd0에서 가져온다
	Dim grdIdx, idx
	for i = 0 to cont0.grd0.rowcount - 1
		idx = CInt(cont0.grd0.GetCellData("bd_idx", i))
		if idx == CInt(lRow) then
			grdIdx = cont0.grd0.GetCellData("bd_idx", i)
		end if
	next
		
	Dim szSendData
	szSendData = cont0.grd0.GetCellData("bd_cell0", grdIdx)'				종목명
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell13", grdIdx)'평가금액
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell3", grdIdx)'	매입금액
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell2", grdIdx)'	평가손익
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell12", grdIdx)'수익률
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell17", grdIdx)'잔고구분
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell11", grdIdx)'잔고수량
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell14", grdIdx)'매입단가
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell6", grdIdx)'	신용,대출금
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell5", grdIdx)'	신용,대출일(질권일)
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell15", grdIdx)'만기일
	szSendData = szSendData.."★"..cont0.grd0.GetCellData("bd_cell8", grdIdx)'종목코드
	
	Form.OpenPopupAnimation("mbtrs12000_po" , szSendData , "","2")
End Sub

'============================================================================
Sub cont0_btnPeriod_OnClick()
	'기간별 수익률
	if g_nOpenScreen == 12000 then
		szACNO = Form.GetCtlProp("#acnt", "total")
		szASNO = Form.GetCtlProp("#acnt", "sequence")
	elseif g_nOpenScreen == 15000 then
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
	end if
	szAmt = cont0.tblValAmt.GetCellString(0, 0)
	Dim szData
	szData = szACNO.."|"..szASNO.."|"..szAmt
	
	Form.OpenFramePopup("mbtrs15000_p1" , szData, "")
End Sub


'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
	if "ohhts_stck_incg" == szTranID then
		DATAMANAGER.ClearInputData( 1, szTranID )
		DATAMANAGER.ClearOutputData( 1, szTranID )
		Dim szCode,szNowCode,InputCode
		Dim nIdx
		nIdx = 0
		szCode = ""
		
		for i = 0 to cont0.grd0.rowcount - 1
			szNowCode = cont0.grd0.GetCellData("bd_cell41", i)'종목코드
			'동일한 종목은 제외시킨 후 담는다.
			if szNowCode <> szCode then
				szCode = szNowCode
				DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD" 	, nIdx , szNowCode )
				nIdx = nIdx + 1
			end if
		next
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.imgNodata.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	cont0.imgRealTime.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub 

'============================================================================
Sub Form_OnFormClose()
	Form.SetTimerEvent(1, 0, 1)
	Form.SetTimerEvent( 999, 0, 10 )
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		f_CalcGridData()
	elseif sTimerID == "999" or sTimerID == 999 then	
		contIncludeFee.visible = false
		Form.SetTimerEvent( 999, 0, 10 )
	end if
End Sub

'============================================================================
Sub cont0_tbl0_OnClick(lRow , lColumn)
	if CInt(IRow) == 0 and CInt(lColumn) == 0 then
		g_nTopType = (g_nTopType + 1) % 2
		
		if g_nTopType == 0 then
			cont0.tbl0.SetCellString(0, 0, "주식평가금액")
			cont0.imgRight.left = 125
			cont0.imgBgValAmt.visible = false
			cont0.tblValAmt.visible = false
		elseif g_nTopType == 1 then
			DATAMANAGER.RequestTranData( "obacb_balc_105r" )
			cont0.tbl0.SetCellString(0, 0, "순자산금액")
			cont0.imgRight.left = 143
			cont0.imgBgValAmt.visible = true
			cont0.tblValAmt.visible = true
			'20230713 htw start 주문회면 제외 + 실시간 아닌 경우 제외 추가
			if g_nOpenScreen <> 12000 and CInt(cont0.grd0.rowcount) < 101 then
				Form.Toast(2, "순자산금액은 실시간조회가 지원되지 않습니다.", 1)
			end if
			'20230713 htw start 주문회면 제외 + 실시간 아닌 경우 제외 추가
		end if
	end if
End Sub

'============================================================================
Sub cont0_OnFormInitBefore()
	cont0.imgRight.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub cont0_imgRight_OnClick()
	cont0_tbl0_OnClick(0 , 0)
End Sub

'============================================================================
Sub contIncludeFee_btnCopyClose_OnClick()
	contIncludeFee.visible = false
	Form.SetTimerEvent( 999, 0, 10 )
End Sub

'20230714 htw start 종목코드 변환 함수 추가
function fn_ItemCdToMCI(szCd)
	szChangeCd = ""
	if (Left(szCd, 1) == "J" and len(szCd) == 9) or Left(szCd, 1) == "F" or left(szCd, 1) == "Q" then
		szChangeCd = szCd
	'주식/KOTC/ELW
	else
		if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "J" then
			szChangeCd = Trim(Mid(szCd,2,Len(szCd)))
		end if
	end if
	return szChangeCd
end function
