		cont0.grd0.setSortCellID("th_cell11","bd_cell11")
		cont0.grd0.setSortCellID("th_cell12","bd_cell12")
		cont0.grd0.setSortCellID("th_cell13","bd_cell13")
		cont0.grd0.setSortCellID("th_cell14","bd_cell14")
