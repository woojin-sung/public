Sub Form_OnFormInit()

	WebView0.viewtype = "0"
	WebView0.urlpath = "http://globalmonitor.einfomax.co.kr/meritz_mobile_new.html#/USA/6/01" '20210204 JRM MODIFY
	WebView0.webscroll = "1"
end Sub

'--============================================================================
Sub Form_OnRefresh()
	WebView0.urlpath = "http://globalmonitor.einfomax.co.kr/meritz_mobile_new.html#/USA/6/01" '20210204 JRM MODIFY
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

