Sub Label5_OnClick()
	
	g_p_id	 =DATAMANAGER.GetDataValue(0, "obcpp_rbit_210r", "OutBlock1", "PRTF_ID" ,0)
	g_p_grade =DATAMANAGER.GetDataValue(0, "obcpp_rbit_210r", "OutBlock1", "INP_RISK_GRAD_CODE" ,0)
	g_p_name  =DATAMANAGER.GetDataValue(0, "obcpp_rbit_210r", "OutBlock1", "PRTF_NAME" ,0)
	
	Form.SetSharedData("Shared_PNAME",g_p_name)
	Form.SetSharedData("Shared_PID",	g_p_id)
	Form.SetSharedData("Shared_GRADE",g_p_grade)
	Form.OpenFramePopup("mbcpp70110.xmf","","")
		
End Sub

