Sub Form_OnFormInit()
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_210r", "InBlock1", "PROS_CLS" , 0 , "2")
	
			DATAMANAGER.RequestTranData("obcpp_rbit_210r")
End Sub


'============================================================================

	Function Cal_grade(grade)
					
			temp=""
			
			if Cint(grade)= 1  then
				temp="초저위험"
			
			elseif Cint(grade)= 2 then
				temp="초저위험+"
					
			elseif Cint(grade)= 3 then
				temp="저위험"
				
			elseif Cint(grade)= 4 then
				temp="저위험+"
				 	
			elseif Cint(grade)= 5 then
				temp="중위험"
					
			elseif Cint(grade)= 6 then
				temp="중위험+"
					
			elseif Cint(grade)= 7 then
				temp="고위험"
				 	
			elseif Cint(grade)= 8 then
				temp="고위험+"
					
			elseif Cint(grade)= 9 then
				temp="초고위험"
					
			elseif Cint(grade)=10 then
				temp="초고위험+"
			
			else  temp=grade
			
		Cal_grade= temp 	
		
			
	end if

End Function 




''============================================================================
	Function Cal_type(type1)
					
			temp=""
						
			if Cint(type1)= 1  then
				temp="거치식"
			
			elseif Cint(type1)= 2 then
				temp="적립식"
			
			
			else temp = type1
	
			end if

	 Cal_type =temp
			

End Function 

'============================================================================


	Function Cal_color(color)
					
			temp=""
			
			if Cint(color)= 1  then
				temp="206"
			
			elseif Cint(color)= 2 then
				temp="91"
					
			elseif Cint(color)= 3 then
				temp="220"
				
			elseif Cint(color)= 4 then
				temp="84"
				 	
			elseif Cint(color)= 5 then
				temp="8"
					
			elseif Cint(color)= 6 then
				temp="203"
					
			elseif Cint(color)= 7 then
				temp="207"
				 	
			elseif Cint(color)= 8 then
				temp="101"
					
			elseif Cint(color)= 9 then
				temp="59"
					
			elseif Cint(color)=10 then
				temp="92"
			
			else  temp="49"
		
		Cal_color= temp 	
		
			
	end if

End Function 
