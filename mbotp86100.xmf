'--===========================================================================
' 01. 신규작성 : 장원혁 v000 
'2023.04.06 V001 양현정 휴대폰인증 맵id변경
'2023.06.20 V002 전상일 진입시점 추가 * 간편인증
'2023.12.19 V003 실물OTP폐기대상인 경우 OTP정보 금결원조회 추가
'2023.12.19 V004 전상일 OTP 송수신 TIMER 이벤트 설정
'2024.04.24 V005 전상일 URL 링크타고 들어오는 경우 진입시점 오류 수정
'--===========================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim 	g_RcnoPIP
'	g_RcnoPIP	= "001304FC8A4D7E156D9F62009DEA39433836"
Dim 	g_MsboVrsn
Dim 	g_OSClcd
Dim 	g_OSVrsn
Dim 	g_CustTermName
Dim 	g_CustTermID
Dim 	g_TitleNmD
	g_TitleNmD	= "모비일OTP 다운로드"
Dim 	g_TitleNmR
	g_TitleNmR	= "모비일OTP 발급"
Dim	g_OtpSrno
Dim	g_OtpStatCode
Dim	g_MOtpSrno
Dim	g_MOtpSrnoSvr
Dim	g_CustTermIDSrvr
Dim	g_ScrNo
Dim	g_DscdYN
Dim	g_IntoClcd '집입구분코드 NMET_ACNT:계좌개설 후처리, NMET_BSWR:업무처리, MTS:MTS
Dim	g_IssuAbleYN '인증처리 이후 발급 가능한지 여부
Dim	g_FormCloseClcd
Dim	g_MOtpMstkCsnu
Dim	g_Theme

'20230803 SWJ START
Dim g_sMotpAcno
Dim g_sMotpRcnoPip
Dim g_sSecurity
Dim g_sMeritzAuth
g_sSecurity = ""
g_sMeritzAuth = ""
'20230803 SWJ END

'V003
Dim g_nNextCount 
Dim g_szSTTN_NO
Dim g_szSRNO
Dim g_szSTND_DATE

Dim g_szLinkData
g_szLinkData = ""

'============================================================================
Function funcTermInfo()
	Form.SetTimerEvent2( 0, 1, 0.2 )
	g_CustTermID	=	Trim(Form.GetDeviceID())
	g_OSClcd		=	Form.GetSharedData("&OS_TYPE", false)
	g_OSVrsn		=	Form.GetSharedData("&OS_VERSION", false)
	g_CustTermName	=	Form.GetDeviceModel()
End Function

'============================================================================
Function funcNxtProc()
	g_FormCloseClcd = ""
	If 	g_IntoClcd == "MTS" Then
		If g_ScrNo == "D" Then
			
			'20230803 SWJ START : 쉐어드 변수 초기화 후, 다음 스텝으로 갈 때 변수 재설정 해준다
			if g_sMeritzAuth <> "" then
				Form.SetSharedData("MeritzAuth_Security", "MOTP")
			end if
			
			if g_sMotpRcnoPip <> "" then
				Form.SetSharedData("Motp_RcnoPip"       , g_sMotpRcnoPip)
			end if
			
			if g_sSecurity == "Y" then
				Form.SetSharedData( "CommonNoSecurity", "Y")
			end if
			if g_sSecurity == "N" then
				Form.SetSharedData( "CommonNoSecurity", "N")
			end if
			'20230803 SWJ END
			
			Form.OpenNextPopup( "mbotp86102.xmf" , "" , "" )  'JMY OpenNextPopup()로 변경
		Else
			Form.SetSharedData("BDM_NMETBSWRGB", "300")
			'V001
			'Form.OpenPopup("mbbdm85110.xmf", "", "")  'JMY OpenNextPopup()로 변경
			Form.OpenPopup("mbbdm86130.xmf", "", "")  'JMY OpenNextPopup()로 변경->OpenPopup으로 띄워야 한다고 함.
		End If
	Else
		rslt_data = "R" & "☆" & g_DscdYN & "☆" & g_OtpSrno & "☆" & g_OtpSuplCoCode & "☆" & g_IsncIstuCode & "☆" & g_Csno & "☆" & g_MOtpSrnoSvr
'Form.ShowAlert("funcNxtProc", rslt_data)
		
		'20230803 SWJ START : 쉐어드 변수 초기화 후, 다음 스텝으로 갈 때 변수 재설정 해준다
		'필요없음
'		Form.SetSharedData("MeritzAuth_Security", "MOTP")
'		
'		if g_sSecurity == "Y" then
'			Form.SetSharedData( "CommonNoSecurity", "Y")
'		end if
		'20230803 SWJ END
		
		Form.OpenNextPopup( "mbotp86101.xmf", rslt_data , "" )  'JMY OpenNextPopup()로 변경
	End If
End Function

'============================================================================
' Form.requestMOTP함수로 호출한 결과는 Form_onTriggerEventMOTP로 내려온다.
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 
'Form.ShowAlert( "debug", "86100\n" & sEventName & "\n" & sParam )

	Dim tmpList

	If sEventName == "MOTP_GET_VERSION_RETURN_86100" Then ' M SafeBox 버전 정보 가져오기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
		
		Form.requestMOTP("MOTP_GETINFO" 	, "" , "86100")
	End If

	If sEventName == "MOTP_GETINFO_RETURN_86100" Then
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MotpSrno = right(tmpList[2], 12)
		End If
		Form.SetTimerEvent2( 1, 1, 0.2)
	End If
End Sub


'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	If 	sRet <> "ok" Then
		g_FormCloseClcd = "BCK"
		Form.CloseForm()
	Else
		funcNxtProc() '다음처리
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbotpmpop" Then
		g_FormCloseClcd = "BCK"
		Form.CloseForm()
	End If
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
'Form.ShowAlert(sKey, sValue)
	If sKey == "mOTPIssuAbleYn" Then
		If sValue == "OK" Then
			g_IssuAbleYN = sValue
			g_FormCloseClcd = "NXT"
			Form.CloseForm()
		Else
			Form.ShowAlert("알림", "인증처리가 완료되지 않았습니다.")
		End If
	End If
End Sub

'주의이미지 추가 20240124
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.imgWarn.setMaintainingRatio("1")		
	Container0.imgDot0.setMaintainingRatio("1")		
	Container0.imgDot1.setMaintainingRatio("1")		
	Container0.imgDot2.setMaintainingRatio("1")		
	Container0.imgDot3.setMaintainingRatio("1")		
	Container0.imgDot4.setMaintainingRatio("1")		
	Container0.imgDot5.setMaintainingRatio("1")		
	Container0.imgDot6.setMaintainingRatio("1")		
	Container0.imgDot7.setMaintainingRatio("1")		
	Container0.imgDot8.setMaintainingRatio("1")		
End Sub

'============================================================================
Sub Form_OnFormInit()

	Dim szData
	
	g_Theme = Form.GetEnvData("common.theme")
	
	Label1.bgcolor = 270
	Container0.Label5.changeTextAttr(0, 6, 6, 0, false)	
	Container0.Label8.changeTextAttr(0, 8, 6, 0, false)	
	Container0.Label12.changeTextAttr(0, 15, 6, 0, false)	
	
	'JMY 확인버튼 비활성화
	BtnCnfr.enable  = False
	If g_Theme == "white" Then
		BtnCnfr.btnimage = "btn_21.9"
	Else
		BtnCnfr.btnimage = "btn_27.9"
	End If
	BtnCnfr.fgcolor = "269"
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		Container0.setScrollBarVisible("2")
	end if
	
	'240311 OTP등록 팝업(mhetc90190_p1)되는 경우 
	g_szLinkData = Form.GetOpenLinkData()
	'Form.ShowAlert("알림 jj" ,g_szLinkData )
	'진입구분코드
	g_IntoClcd = Form.GetSharedData( "mOTP_IntoClcd", False )
	
	'V005 URL로 들어오는 경우 진입점 값이 NULL인 경우 MTS 로 넣어준다
	if g_IntoClcd = "" then
		g_IntoClcd = "MTS"
		Form.SetSharedData("mOTP_IntoClcd", g_IntoClcd)
	end if
	
     'Form.showalert("mOTP_IntoClcd", g_IntoClcd)
	Select Case g_IntoClcd
		Case "NMET_ACNT"
			g_RcnoPIP	= Form.GetSharedData( "BDM_RCNO_PIP", FALSE )
			
'			DATAMANAGER.RequestTranData("obcsb_oimf_172r")
		Case "MTS"
			g_RcnoPIP	= Form.GetSharedData("&JUMIN_NUM", false )
			g_sSecurity    = Form.GetSharedData("CommonNoSecurity", true )	'20230803 SWJ START (로그인 상태면 JUMIN_NUM 사용)
			
			'v0002 start
			g_sMeritzAuth = Form.GetSharedData( "MeritzAuth_Security", true ) ' 간편인증 진입여부 판단	'20230803 SWJ START(true로 바꿈)
			'Form.showalert("sa_flag", sa_flag)
			if Len(Trim(g_RcnoPIP)) == 0 and g_sMeritzAuth == "MOTP" then
				
				'20230803 SWJ START : 보안매체없음 팝업(모바일OTP발급, 타기관OTP발급 유도화면)을 
				'                     업무화면에서 공통으로 쓰기 위한 처리
				g_sMotpAcno    = Form.GetSharedData("Motp_Acno"	 , true )
				g_sMotpRcnoPip = Form.GetSharedData("Motp_RcnoPip"  , true )
				
				'간편인증 제외한 업무화면에서 공통팝업 사용할 때 쓰는 변수
				if g_sSecurity == "Y" then
					g_RcnoPIP    = g_sMotpRcnoPip
					sa_acno_flag = g_sMotpAcno
				else
					g_RcnoPIP	= Form.GetSharedData( "Meritz_OTP_RCNOPIP", FALSE )
					sa_acno_flag 	  = Form.GetSharedData( "Meritz_OTP_ACNO", False )
				end if
				
				Form.SetSharedData("BDM_NMET_ACNO", sa_acno_flag)
				'20230803 SWJ END

				'Form.showalert("g_RcnoPIP", g_RcnoPIP)
			End if 
			'v0002 end 
'			DATAMANAGER.RequestTranData("obcsb_oimf_172r")
		Case Else
			If Len(Form.GetSharedData( "BDM_RCNO_PIP", FALSE )) > 0 Then
				g_RcnoPIP	= Form.GetSharedData( "BDM_RCNO_PIP", FALSE )
			Else
				g_RcnoPIP	= Form.GetSharedData("&JUMIN_NUM", false )
			End If
	End Select
'Form.ShowAlert("SharedData", g_IntoClcd & "][" & g_RcnoPIP )
	
	'고객기기 및 Motp정보 수집
	funcTermInfo()
	
	'하이라이트 240124 
	if g_OSClcd == "1" then ' 안드
		lblHeader.setHighlight(332, 0, Len(lblHeader))
		Container0.Label15.setHighlight(332, 0, Len(Container0.Label15))
	else 'iOS
		lblHeader.setHighlight(332, 0, 33)
		Container0.Label15.setHighlight(332, 0, 27)	
	end if 
	
End Sub

'============================================================================
Sub Form_OnFormClose()
'Form.ShowAlert("OnFormClose", g_IntoClcd & "][" & g_FormCloseClcd )
	If g_FormCloseClcd == "NXT" Then
'		If g_IntoClcd == "NMET_ACNT" Then
'			Form.OpenNextPopup("mbotp86107.xmf", "", "")  'JMY OpenNextPopup()로 변경
'		End If
		
		If g_IssuAbleYN == "OK" Then
			
			'20230803 SWJ START : 쉐어드 변수 초기화 후, 다음 스텝으로 갈 때 변수 재설정 해준다
			if g_sMeritzAuth <> "" then
				Form.SetSharedData("MeritzAuth_Security", "MOTP")
			end if
			
			if g_sSecurity == "Y" then
				Form.SetSharedData( "CommonNoSecurity", "Y")
			end if
			if g_sSecurity == "N" then
				Form.SetSharedData( "CommonNoSecurity", "N")
			end if
			'20230803 SWJ END
			'20240409 JSI - 앱 처음 재설치의 경우 g_RcnoPip에 아무것도 세팅되지 않았다면 R ☆ 이후 값이 모두 NULL 에러 떨어짐
			IF Len(Trim(g_RcnoPIP)) == 0 Then ' 
				rslt_data = "R" & "☆"
			ELSE
				rslt_data = "R" & "☆" & g_DscdYN & "☆" & g_OtpSrno & "☆" & g_OtpSuplCoCode & "☆" & g_IsncIstuCode & "☆" & g_Csno & "☆" & g_MOtpSrnoSvr
			END IF
			'Form.ShowAlert("여기인가..?",rslt_data)
			Form.OpenPopup( "mbotp86101.xmf", rslt_data , "" )  'JMY OpenNextPopup()로 변경
		End If
	ElseIf g_FormCloseClcd == "BCK" Then
		If g_IntoClcd == "NMET_ACNT" Then
			Form.OpenPopup("mbotp86107.xmf", "", "")  'JMY OpenNextPopup()로 변경
'		else
'			'240311 OTP등록 팝업(mhetc90190_p1)이 아닌 OTP관리에서 팝업될 경우 메뉴트리로 이동 
'			if g_szLinkData <> "mhetc90190_p1" then
'				'2024-02-22메뉴트리로 이동(보안관리)
'				if g_OSClcd == "1" then ' 안드
'					Form.OpenMainMenuWithIndex("3","1","2")
'				else 'iOS
'					Form.OpenMainMenuWithIndex("3","1","19")
'				end if 
'			end if 
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If	szTranID == "obcsb_oimf_172r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPIP )
	'V003
	elseIf	szTranID == "obcsb_oimf_160r" Then
		g_nNextCount = 0
		edtSTTNNO.caption = "001"
		edtSTNDDATE.caption = ""
		edtotp.caption = ""		
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APRV_YN" , 0 , "N")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPIP )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RQST_STA_STTN_NO", 0, edtSTTNNO.caption )
	
	elseIf	szTranID == "obcsb_oimf_160r_1" Then		
	
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APRV_YN" , 0 , "Y")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPIP )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RQST_STA_STTN_NO", 0, edtSTTNNO.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_TLMS_SRNO", 0, edtotp.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TLMS_PROS_DATE", 0, edtSTNDDATE.caption )
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If	szTranID == "obcsb_oimf_172r" Then
		
		AblePrhbYn		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "ABLE_PRHB_YN"		, 0 )
		PrhbReas		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "UI_PRHB_REAS"		, 0 )
		g_Csno		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "CSNO"			, 0 )
		
		g_MOtpSrnoSvr	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MOTP_SRNO"		, 0 )
		g_CustTermIDSrvr= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_TERM_ID"		, 0 )
		g_MOtpMstkCsnu	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MOTP_ATHN_MSTK_CSNU", 0 )
		
		g_OtpSrno		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_CARD_SRNO"	, 0 )
		g_OtpStatCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_STAT_CODE"	, 0 )
		g_OtpSuplCoCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_SUPL_CO_CODE"	, 0 )
		g_IsncIstuCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_ISNC_ISTU_CODE"	, 0 )
'msgbox g_MOtpSrnoSvr
		Dim sLOGIN_TYPE  
		sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
		
		if CInt(sLOGIN_TYPE) > 1 then '2024.03.13로그인상태일 때만 안내 팝업 처리로 수정
			'모바일OTP사용 가능여부 체크
			If AblePrhbYn <> "Y" Then
				If AblePrhbYn == "1" Then
					Form.ShowAlert("안내", "모바일 OTP 발급이 불가합니다.\n개인정보노출 등록 고객")
				ElseIf AblePrhbYn  == "2" Then
					Form.ShowAlert("안내", "모바일 OTP 발급이 불가합니다.\n미성년자 발급 불가")
				ElseIf AblePrhbYn  == "3" Then
					Form.ShowAlert("안내", "외국인은 모바일 OTP 발급이 불가능 합니다.")
				ElseIf AblePrhbYn  == "4" Then
					Form.ShowAlert("안내", "법인은 모바일 OTP 발급이 불가능 합니다.")
				End If
				g_FormCloseClcd = "BCK"
				Form.CloseForm()
			End If
		end if
'Form.ShowAlert(szTranID, "단말ID[" & g_CustTermID & "] \n서버ID[" & g_CustTermIDSrvr & "] \n오류횟수[" & g_MOtpMstkCsnu & "]")
		'발급 or 다운로드 결정
		If Len(Trim(g_MOtpSrno)) == 0 Then ' 단말에 OTP가 없는 경우
			If Len(Trim(g_MOtpSrnoSvr)) == 0 Then '서버에 등록되지 않은경우
				g_ScrNo = "R" ' 일반등록
			ElseIf g_CustTermID == g_CustTermIDSrvr And CInt(g_MOtpMstkCsnu) < 5 Then '기기ID가 같은 경우
				g_ScrNo = "D" ' 다운로드
			Else '기기가 변경된 경우
				g_ScrNo = "M" ' 재등록
			End If
		Else '단말에 OTP가 등록되어 있는경우
			If Len(Trim(g_MOtpSrnoSvr)) == 0 Then
				
			ElseIf g_MOtpSrnoSvr ==Trim(g_MOtpSrno) Then  '일련번호가 같은경우
				g_ScrNo = "N"
			Else
				g_ScrNo = "M" '재등록
			End If
		End If
		
		'실물OTP 폐기여부
		If Len(Trim(g_OtpSrno)) > 0 And (g_OtpStatCode == "01" OR g_OtpStatCode == "02") Then
			'V004 초기값 세팅.. 없으면 N
			g_DscdYN = "N"
			'V003 g_DscdYN = "Y"			
			'V003
			DATAMANAGER.RequestTranData("obcsb_oimf_160r")
			
		Else
			g_DscdYN = "N"
		End If
	
	'V003
	elseIf	szTranID == "obcsb_oimf_160r" Then
	
		g_szSTTN_NO 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "RQST_STA_STTN_NO" , 0)		'요청시작번호
		g_szSRNO 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_TLMS_SRNO" , 0)		'전문일련번호
		g_szSTND_DATE	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "TLMS_PROS_DATE" , 0)		'기준일자
		
		if Len(trim(g_szSRNO)) > 7 then			'전문일련번호
			edtotp.caption = g_szSRNO
		end if
		if Len(trim(g_szSTTN_NO)) == 3 then		'시작요청위치
			edtSTTNNO.caption = g_szSTTN_NO
		end if
		if Len(trim(g_szSTND_DATE)) == 8 then	'기준일자
			edtSTNDDATE.caption = g_szSTND_DATE
		end if	
		
		'V004 주석처리...
		'5건 이상인 경우에도 다음조회조건이 성립하고 edt0 에 전문수신응답코드가 수신되므로 조건 추가함
		'if DATAMANAGER.IsMoreNextData("obcsb_oimf_160r_1") == True then
		'	DATAMANAGER.RequestNextData("obcsb_oimf_160r_1")
		'else
		'	if edtSTTNNO.caption == "001" then
		'		Form.SetTimerEvent2( 2, 1, 1) 'V0004 타이머 1초 설정
		'		'DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")
		'	end if
		'end if	
		if edtSTTNNO.caption == "001" then
			
			Form.SetTimerEvent2( 2, 1, 1) 'V0004 타이머 1초 설정
			Form.addWaitCursor()
			'DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")
		end if	
	elseIf	szTranID == "obcsb_oimf_160r_1" Then
		g_nGrdCount = DATAMANAGER.GetDataCount( 0 , "obcsb_oimf_160r_1", "OutBlock1")
		for i = 0 to g_nGrdCount - 1
			g_nNextCount = g_nNextCount + 1
			
			if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UTLZ_REG_YN" , i) == "Y" and DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "OTP_RSPN_CODE" , 0) == "0000" then
			
				if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_CARD_SRNO" , i) == g_OtpSrno then				
					g_DscdYN = "Y"	'OTP폐기대상..
					
					g_OtpStatCode		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_STAT_CLS_CODE" , i)
					g_OtpSuplCoCode	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_SUPL_CO_CODE" , i)
					g_IsncIstuCode	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_ISNC_ISTU_CODE" , i)
					'v004 등록 건이 1건 초과하여 있을 수 없음
					exit sub
				end if
			end if
		Next
		
		'v004 등록 건으로 exit가 안되는 경우 nextkey 존재하면 다음조회 처리
		'if DATAMANAGER.IsMoreNextData("obcsb_oimf_160r_1") == True then
		'	DATAMANAGER.RequestNextData("obcsb_oimf_160r_1")
		'end if
	
	End If
End Sub

'컨테이너 안으로 체크버튼 넣고 체크시 이미지처리 수정 240124 
'============================================================================
Sub ChkButton_OnChange(sCheckState)

	If sCheckState == 0 Or sCheckState == "0" Then
	    BtnCnfr.enable = False
		'JMY 확인버튼 비활성화처리
		If g_Theme == "white" Then
			BtnCnfr.btnimage = "btn_21.9"
		Else
			BtnCnfr.btnimage = "btn_27.9"
		End If
		BtnCnfr.fgcolor = "269"
		
		'이미지처리 240124 
		Form.SetCtlProp("imgCheck", "imgpath", "btn_line_red_n.9")
		Form.SetCtlProp("lblCheck", "fontstyle", "00")
	Else
	    BtnCnfr.enable = True
		'JMY 확인버튼 활성화처리
		BtnCnfr.btnimage = "btn_20.9"
		BtnCnfr.fgcolor = "273"
		
		'이미지처리 240124 
		Form.SetCtlProp("imgCheck", "imgpath", "btn_line_red_o.9")
		Form.SetCtlProp("lblCheck", "fontstyle", "01")
	End If
	
	'로그인 세션에 고객번호와 실명확인번호암호화 데이터 셋팅
	Form.SetEnvData( 1,"login.session.custno"	, g_Csno		)
	Form.SetEnvData( 1,"login.session.juminnopip"	, g_RcnoPIP	)

	Form.regiPUSH (g_Csno) 

End Sub

'============================================================================
Sub lblCheck_OnClick()
	if ChkButton.checkstate == "0" or ChkButton.checkstate == 0 then
		ChkButton.checkstate = 1
	else
		ChkButton.checkstate = 0
	end if 
	ChkButton_OnChange(ChkButton.checkstate)
End Sub


'============================================================================
Sub BtnCnfr_OnClick()

	If	g_IntoClcd == "MTS" Then
		If 	g_ScrNo == "D" Then '다운로드
			Form.MsgBox("안내", "이미 같은 기기에서 모바일 OTP를 발급받은 이력이 있습니다.\n기존 OTP를 사용하시겠습니까?", "dnld", 1 )
		ElseIf 	g_ScrNo == "N" Then '정상인데 재발급
			Form.MsgBox( "안내", "현재 기기에서 발급하신 모바일 OTP가 있습니다.\n기존 모바일 OTP는 폐기하고 새로운 OTP를 발급하시겠습니까?", "isnc", 1 )
		ElseIf 	g_ScrNo == "M" Then '기기변경으로 재발급
			Form.MsgBox( "안내", "기존에 등록된 기기와 발급 정보가 다릅니다.\n새로운 OTP를 발급하시겠습니까?", "mod_isnc", 1 )
		Else
			funcNxtProc() '다음처리
		End If
	Else
		funcNxtProc() '다음처리
	End If
End Sub


'============================================================================
Sub Image0_OnClick()
	g_FormCloseClcd = "BCK"
	Form.CloseForm()
End Sub

'============================================================================
Sub Button0_OnClick()
	rslt_data = "R" & "☆" & g_DscdYN & "☆" & g_OtpSrno & "☆" & g_OtpSuplCoCode & "☆" & g_IsncIstuCode & "☆" & g_Csno & "☆" & g_MOtpSrnoSvr
'Form.ShowAlert("OnClick", rslt_data)
	
	'20230803 SWJ START : 쉐어드 변수 초기화 후, 다음 스텝으로 갈 때 변수 재설정 해준다
	if g_sSecurity == "Y" then
		Form.SetSharedData( "CommonNoSecurity", "Y")
	end if
	if g_sSecurity == "N" then
		Form.SetSharedData( "CommonNoSecurity", "N")
	end if
	if g_sMeritzAuth <> "" then
		Form.SetSharedData("MeritzAuth_Security", "MOTP")
	end if
	'20230803 SWJ END
	
	Form.OpenNextPopup( "mbotp86101.xmf", rslt_data , "" )	 'JMY OpenNextPopup()로 변경
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
'Form.ShowAlert("TimerEvent", sTimerID)
	If sTimerID == 0 Or sTimerID == "0" Then
		Form.requestMOTP("MOTP_GET_VERSION"	, "" , "86100")
		Form.SetTimerEvent2( 0, 0, 0.2 )
	End If
	
	If sTimerID == 1 Or sTimerID == "1" Then
		DATAMANAGER.RequestTranData("obcsb_oimf_172r")
		Form.SetTimerEvent2( 1, 0, 0.2)
	End If
	
	'V004
	If sTimerID == 2 Or sTimerID == "2" Then
		Form.SetTimerEvent2( 2, 0, 1) 
		Form.clearWaitCursor()
		DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")
		
	End If
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_oimf_172r" trcode="obcsb_oimf_172r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_160r" trcode="obcsb_oimf_160r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_160r_1" trcode="obcsb_oimf_160r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_oimf_172r" title="OTP조회(실물&모바일)" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="215" _ulen="161" >

MOTP_SRNO^모바일OTP일련번호^12^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
RCNO_PIP^실명확인번호PIP^68^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="1257" _ulen="937" >

MOTP_ERR_CNTT^모바일OTP에러내용^300^0^0^0^0^0^0
