'============================================================================
' 자주쓰는계좌
'============================================================================
Sub cont01_btnFav01_OnClick()
	if cont01.edt02.caption == "" or cont01.edt02.caption == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하세요.")
		exit sub
	end if

	Form.OpenPopup("mbbnk61010_p4" , g_szAccountNumber..g_szAccountSerialNumber, "")
End Sub


'============================================================================
' cont01_btnRecent01_OnClick - 최근이체
'============================================================================
Sub cont01_btnRecent01_OnClick()
	if cont01.edt02.caption == "" or cont01.edt02.caption == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하세요.")
		exit sub
	end if

	Form.OpenPopup("mbbnk61040_p5" , g_szAccountNumber..g_szAccountSerialNumber, "")
	
End Sub

'============================================================================
' cont01_btnAssn01_OnClick - 지정계좌
'============================================================================
Sub cont01_btnAssn01_OnClick()
	if cont01.edt02.caption == "" or cont01.edt02.caption == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하세요.")
		exit sub
	end if
    Form.SetSharedData("61010_p5", "1" )
	Form.OpenPopup("mbbnk61010_p5" , g_szAccountNumber..g_szAccountSerialNumber,"")'"★1", "")
End Sub

'============================================================================
' cont01_btnQuick01_OnClick - 빠른계좌
'============================================================================
Sub cont01_btnQuick01_OnClick()
'	if cont01.edt02.caption == "" or cont01.edt02.caption == "0" then
'		Form.ShowAlert("알림", "이체금액을 입력하세요.")
'		exit sub
'	end if

	Form.OpenFramePopup( "mbbnk61010_p6" , g_szAccountNumber..g_szAccountSerialNumber , "")
End Sub


'============================================================================
' cont01_imgSearch_OnClick - 입금기관 검색
'============================================================================
Sub cont01_imgSearch_OnClick()
	Form.OpenPopup("mbbnk61010_p3" , sOpenData , sPosInfo)
End Sub
'Sub cont01_btnIn0_OnClick()
