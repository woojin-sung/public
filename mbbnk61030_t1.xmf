'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약이체
' 02. 화면설명 : 예약이체_예약이체탭
' 03. 작    성 : 16.03.08
'-------------------------------------------------------------------------------------------
'20220610    김효준 : v001 사기의심조회 체크
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName	'계좌명
Dim g_szBIZDT	'영업일

Dim sUserID
Dim g_szDate		'날짜변수
Dim g_DateType	'폼 Init 일때와 달력 선택일때 구분 0:폼 Init , 1:달력 선택 
Dim g_szTrPass	'약정상태저장 변수
Dim DrngAmtCnfrMsgBox_fg
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회'
'		Dim sUserID
		sUserID = Form.GetSharedData("&USER_ID", false )
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , sUserID)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000")'이체	'기본 '200'  등록 '400'
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	
	elseif szTranID == "obcpp_bsdy_017r" then	'영업일 조회
	
		DATAMANAGER.SetEventFlag( "header", "S")
		
		DATAMANAGER.SetDataValue( 0 , "obcpp_bsdy_017r", "InBlock1", "CLND_CLS_CODE" , 0 , "C001" )
		DATAMANAGER.SetDataValue( 0 , "obcpp_bsdy_017r", "InBlock1", "MANG_DATE" , 0 , g_szDate )
		DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "AllAccount" then		'계좌전체
		Dim szList
		szList = Split(sParam, "★")
		
		
		if UBOUND(szList) < 1 then
			exit sub
		end if

		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) <> "" then
			g_szAccountPassword = szList(2)
		else
			g_szAccountPassword = ""
		end if
		
		if szList(3) <> "" then
			g_szAccountName = szList(3)
		else
			g_szAccountName = ""
		end if
		
		TR_Inquiry("obcsb_oimf_638r")
		cont01_btnOut_OnClick()
	end if
	
	if sEventName == "Password"	then		'계좌비밀번호
		g_szAccountPassword = sParam
	end if
	
	g_szBIZDT = Form.GetSharedData("&BIZ_DT", false )
End Sub

'============================================================================
' cont01_btnOut_OnClick - 출금가능금액조회버튼
'============================================================================
Sub cont01_btnOut_OnClick()
	if Trim(g_szAccountNumber) == "" then
		Form.ShowAlert("알림", "출금계좌가 없습니다")
		exit sub
	end if
	
	'obrtp_drab_001r 출금가능금액조회
	g_szBIZDT = Form.GetSharedData("&BIZ_DT", false )
	
	if Trim(g_szBIZDT) == "" THEN
		g_szBIZDT = Form.GetSharedData("&BIZ_DT", false )
	end if
	
	DATAMANAGER.SetDataValue(0,  "obrtp_drab_001r", "InBlock1", "ACNO", 0 , g_szAccountNumber)
	DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,  "obrtp_drab_001r", "InBlock1", "PROS_DATE", 0 , g_szBIZDT)
	DATAMANAGER.SetDataValue(0,  "obrtp_drab_001r", "InBlock1", "SMCD", 0 , "003020")
	DATAMANAGER.RequestTranData("obrtp_drab_001r")
	
	
End Sub


'============================================================================
' cont01_btnAll_OnClick - 전액버튼
'============================================================================
Sub cont01_btnAll_OnClick()
	Dim szTemp
	szTemp = Trim(cont01.edt01.caption)
	cont01.edt02.caption = szTemp
	
End Sub
'============================================================================
' cont01_btn100_OnClick - 100만버튼
'============================================================================
Sub cont01_btn100_OnClick()
	Dim szTemp
	szTemp = Trim(cont01.edt02.caption)
	cont01.edt02.caption = szTemp + 1000000	
End Sub
