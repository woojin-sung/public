'============================================================================
' cont01_btnIn1_OnClick - 입금계좌
'============================================================================
Sub cont01_btnIn1_OnClick()
	'출금계좌번호확인
	if Len(Trim(g_szAccountNumber)) == 0 then
		Form.ShowAlert("알림", "출금계좌번호가 없습니다")
		exit sub
	end if
	
	if cont01.edt04.caption == "" then
		Form.ShowAlert("알림", "입금계좌번호를 입력하세요")
		exit sub
	end if
	
	if cont01.edt02.caption == "" or cont01.edt02.caption == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하세요.")
		exit sub
	end if
	
	if Trim(cont01.lblBankCode.caption) == "287" then	'메리츠당행조회
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO"          , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO"          , 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN"        , 0 , "N")	'사용여부
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO"     , 0 , Mid(cont01.edt04.caption, 1, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO"     , 0 , Mid(cont01.edt04.caption, 9, 2))	'상대일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "TACT_CLS_CODE" , 0 , "17") '예약대체
		DATAMANAGER.RequestTranData("obrtd_drng_025r")
	else
	
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE" , 0 , Trim(cont01.lblBankCode.caption))	'입금은해코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")								'작업단말번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO" , 0 , Trim(cont01.edt04.caption))				'입금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , cont01.edt02.caption)						'거래금액
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO" , 0 , g_szAccountNumber)						'계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , g_szAccountSerialNumber)		'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "PWD" , 0 , g_szAccountPassword)							'비밀번호
		DATAMANAGER.RequestTranData("obtss_elbs_129r")
	
	end if
	
End Sub


'============================================================================
' cont01_btnChange_OnClick - 정정버튼
'============================================================================
Sub cont01_btnChange_OnClick()
	cont01.edt02.caption = ""
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "이체기관" then
		Dim szList
		szList = Split(sRet, "★")
		cont01.lblBankCode.caption = szList(0)
		cont01.edtin.caption = szList(1)
	elseif sKeyName == "61010_OFTEN" or sKeyName == "mbbnk61040_p5" then '자주쓰는계좌/최근이체계좌
		If sRet <> "" then
			
			tData = Split(sRet, "★")
			cont01.edt05.caption = tData(3)
			cont01.edt04.caption = Replace(tData(2),"-","")
			cont01.edtin.caption = tData(4)
			cont01.lblBankCode.caption = tData(1)
			
			if Trim(cont01.lblBankCode.caption) == "287" then	'메리츠당행조회
				cont01.Label0.caption = "0"
			else
			
			
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE" , 0 , Trim(cont01.lblBankCode.caption))	'입금은해코드
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")								'작업단말번호
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO" , 0 , Trim(cont01.edt04.caption))				'입금계좌번호
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , cont01.edt02.caption)						'거래금액
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO" , 0 , g_szAccountNumber)						'계좌번호
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , g_szAccountSerialNumber)		'계좌일련번호
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "PWD" , 0 , g_szAccountPassword)							'비밀번호
				DATAMANAGER.RequestTranData("obtss_elbs_129r")
			
			end if
		end if
	elseif sKeyName == "Clear" then	'정상처리 되었을때
		cont01.edt02.caption = ""
		cont01.edtin.caption = ""
		cont01.edt04.caption = ""
		cont01.edt05.caption = ""
		cont01.edt06.caption = ""
		cont01.edt07.caption = ""
		cont01.edtCMS01.caption = ""
		Form.SetCtlProp( "#edtPassword", "caption", "")
	ElseIf sKeyName == "QUICK" then '빠른이체추가 
		If sRet <> "" then
			tData2 = Split(sRet, "|")
			if Form.GetCtlProp("#cmbAccount", "caption") <> tData2(1) then
				Form.SetCtlProp("#cmbAccount", "caption", tData2(1)) 
			end if
            IF Ubound(tData2) > 0 then
			   cont01.edt05.caption = tData2(4)
			   cont01.edtin.caption = tData2(3)
			   cont01.lblBankCode.caption = tData2(2)
			   cont01.edt02.caption = tData2(5)
			   cont01.edt04.caption = tData2(6)
			   cont01.edt06.caption = tData2(7)
			   cont01.edt07.caption = tData2(8)
'			   Form.ShowAlert( "알림", "빠른이체로 등록 완료되었습니다.")
			End IF
		End If
	elseif sKeyName == "mbbnk61010_p9" then	'지정단말 등록시
		if sRet == "Yes" then
		
			sAmPm = "P"
			if cont01.rdoResv02.currentindex == "0" then
				sAmPm = "A"
			end if
		
			szAccount = Trim(cont01.edt04.caption)
			sName = Trim(cont01.edt07.caption) 
			if sName == "" then
				sName = g_szAccountName
			end if
			
			sOpenData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & Trim(cont01.edt02.caption) &"★" & Trim(cont01.lblBankCode.caption) &"★"& cont01.edtin.caption &"★"& 
					  Mid(szAccount,1,8) & "★"& Mid(szAccount,9,2)& "★"& Trim(cont01.edt05.caption) & "★" & Trim(cont01.edt06.caption) & "★"& sName &"★"& 
					  cont01.cont01.Calendar0.caption &"★"& sAmPm  &"★" &cont01.edtCMS01.caption  & "★" & Trim(cont01.edt04.caption)& "★"& Trim(cont01.Label0.caption) &"★"& szPlusUI
			
			Form.SetSharedData( "CERT_ID" , sUserID)
			Form.SetSharedData( "CERT_ACNO" , g_szAccountNumber)
			
			Form.OpenPopup( "mbbnk61030_p2.xmf" , sOpenData , "" )	
			
		end if	
	end if
End Sub


'============================================================================
Sub cont01_btnEnroll_OnClick()
	
	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.ShowAlert("알림", "비밀번호를 입력하세요.")
		exit sub
	end if
	
	if cont01.edt02.caption == "" or cont01.edt02.caption == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하세요.")
		exit sub
	end if
	
	if Trim(cont01.edtin.caption) == "" then	
		Form.ShowAlert("알림", "입금기관을 선택하세요.")
		exit sub
	end if
	
	if Trim(cont01.edt04.caption) == "" then	
		Form.ShowAlert("알림", "입금계좌를 입력하세요.")
		exit sub
	end if
		
	if Trim(cont01.edt05.caption) == "" then	
		Form.ShowAlert("알림", "수취인을 확인하세요.")
		exit sub
	end if
	
	if cont01.rdoResv02.currentindex == "-1" then
		Form.ShowAlert("알림", "예약시간을 확인하세요.")
		exit sub
	end if
	
	'출금가능금액이 작아도 예약이체가능
	if CDbl(cont01.edt01.caption)  < CDbl(cont01.edt02.caption ) + CDbl(cont01.Label0.caption) then
	'	Form.ShowAlert("알림", "이체금액이 출금가능금액 보다 큽니다.")
	'	exit sub
		tmpMsg = "이체금액이 출금가능금액 보다 큽니다. 계속 진행하시겠습니까?" & " 수수료(" & CDbl(cont01.Label0.caption ) & "원)"
		nRet = Form.MsgBox("알림", tmpMsg, "DrngAmtCnfrMsgBox", 1)
		'Form.ShowAlert("알림", nRet)
		exit sub
	end if
	
	
	'Call Pop_Confirm_page() v001 사기의심체크이후 실행
	FrdSspc_Chk()
	
	'if Trim(cont01.lblBankCode.caption) == "287" then	'메리츠당행조회
