'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_drng_023a" then
		szMsg = DATAMANAGER.GetDataMsgText(szTranID)
		Form.Toast( 0, szMsg, 0 )
	elseif szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회
		if Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "TERM_DSGT_STPL_YN" , 0)) == "N" then
			cont01.Table01.SetCellString( 1, 1, "미약정" )
			cont01.Table01.SetCellFgColor(1, 1, "10")
		elseif Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "TERM_DSGT_STPL_YN" , 0)) == "1" then
			cont01.Table01.SetCellString( 1, 1, "단말지정" )
			cont01.Table01.SetCellFgColor(1, 1, "11")
		elseif Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "TERM_DSGT_STPL_YN" , 0)) == "2" then
			cont01.Table01.SetCellString( 1, 1, "추가인증" )
			cont01.Table01.SetCellFgColor(1, 1, "11")
		end if
		
		if Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "REG_YN" , 0)) == "Y" then
			cont01.Table01.SetCellString( 1, 3, "등록단말" )
			cont01.Table01.SetCellFgColor(1, 3, "11")
		else
			cont01.Table01.SetCellString( 1, 3, "미등록단말" )
			cont01.Table01.SetCellFgColor(1, 3, "10")
		end if
	elseif szTranID == "obcpp_bsdy_017r" then
		if g_DateType == 1 then
			if g_szDate <> DATAMANAGER.GetDataValue( 0 , "obcpp_bsdy_017r", "OutBlock1", "MANG_DATE" , 0) then
				Form.ShowAlert( "알림", "선택한 예약일자는 영업일이 아닙니다.")
'				cont01.btnEnroll.enable = false
'			else
'				cont01.btnEnroll.enable = true
			end if
		end if
		cont01.Calendar0.caption = DATAMANAGER.GetDataValue( 0 , "obcpp_bsdy_017r", "OutBlock1", "MANG_DATE" , 0)
				
	elseif szTranID == "obcsb_oimf_638r_1" then	'전자금융사기예방 고객조회
				
		szPlusUI = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r_1", "OutBlock1", "SPLM_ATHN_NCSR_YN", 0 ))'추가인증팝업여부
		g_szTrPass = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock1", "UI_SPLM_YN" , 0)
		
		if g_szTrPass == "Y" then
			Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
			Exit Sub
		end if
		
		sAmPm = "P"
		if cont01.rdoResv02.currentindex == "0" then
			sAmPm = "A"
		end if
	
		szAccount = Trim(cont01.edt04.caption)
		sName = Trim(cont01.edt07.caption) 
		if sName == "" then
			sName = g_szAccountName
		end if
		
		sOpenData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & Trim(cont01.edt02.caption) &"★" & Trim(cont01.lblBankCode.caption) &"★"& cont01.edtin.caption &"★"& 
				  Mid(szAccount,1,8) & "★"& Mid(szAccount,9,2)& "★"& Trim(cont01.edt05.caption) & "★" & Trim(cont01.edt06.caption) & "★"& sName &"★"& 
				  cont01.cont01.Calendar0.caption &"★"& sAmPm  &"★" &cont01.edtCMS01.caption  & "★" & Trim(cont01.edt04.caption)& "★"& Trim(cont01.Label0.caption) &"★"& szPlusUI
		
		Form.SetSharedData( "CERT_ID" , sUserID)
		Form.SetSharedData( "CERT_ACNO" , g_szAccountNumber)
		
		Form.OpenPopup( "mbbnk61030_p2.xmf" , sOpenData , "" )	
	
	'v001 사가의심체크호출후 -> Pop_Confirm_page
	elseif szTranID == "obrtp_comn_025r" then
		ProsAbleYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_ABLE_YN" , 0)
		if ProsAbleYn == "Y" Then
			Pop_Confirm_page()
		end if
	elseif szTranID == "obrtd_drng_025r_1" or  szTranID == "obtss_elbs_129r_1" then
	
		g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "300")'이체	'기본 '200'  등록 '400'
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r_1", "InBlock2", "DRNG_ACNO" , 0, g_szAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "DRNG_ASNO", 0, g_szAccountSerialNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_BANK_CODE", 0 , Trim(cont01.lblBankCode.caption))		'
		if Trim(cont01.lblBankCode.caption) == "287" then '당사
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", 0, Left(cont01.edt04.caption, 8))
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", 0, Right(cont01.edt04.caption, 2))
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", 0 ,"03")'이체출금
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", 0, cont01.edt04.caption)
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", 0, "")
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_AMT" , 0, cont01.edt02.caption)		'대체금액
		DATAMANAGER.RequestTranData("obcsb_oimf_638r_1")	
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
    szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)
	
    If Trim(szSubErr) == "" Then
        Form.ShowAlert("알림", szErrMsg)
    Else
        Form.ShowAlert("알림", szErrMsg .. "\n(" .. szSubErr .. ")")
    End If

	if szTranID == "obrtd_drng_023a" then
		cont01.edt02.caption = ""
		cont01.edtin.caption = ""
		cont01.edt04.caption = ""
		cont01.edt05.caption = ""
		cont01.edt06.caption = ""
		cont01.edt07.caption = ""
		cont01.edtCMS01.caption = ""
		Form.SetCtlProp( "#edtPassword", "caption", "")
		
	elseif szTranID == "obtss_elbs_129r" or szTranID == "obrtd_drng_025r" or szTranID == "obtss_elbs_129r_1" or szTranID == "obrtd_drng_025r_1" then
		cont01.edt05.caption = ""
	end if
	
End Sub



'============================================================================
Sub cont01_Calendar0_OnEditComplete()
	g_DateType = 1
	g_szDate = cont01.Calendar0.caption
	if g_szDate == cldToday.caption then
		Form.ShowAlert( "알림", "예약이체는 당일 접수가 불가합니다.")
		cont01.btnEnroll.enable = false
'		TR_Inquiry( "obcpp_bsdy_017r" )
'		DATAMANAGER.SetDataValue( 0 , "obcpp_bsdy_017r", "InBlock1", "CALC_DYNU" , 0 , 1)
	elseif CDbl(g_szDate) < CDbl(cldToday.caption) then
		Form.ShowAlert( "알림", "선택한 예약일자는 영업일이 아닙니다.")
		cont01.btnEnroll.enable = false
	elseif CDbl(g_szDate) >= CDbl(cont01.calFinDate.caption) then
		Form.ShowAlert( "알림", "예약일자는 6개월이내까지 등록 가능합니다.")
		cont01.btnEnroll.enable = false
	else
		DATAMANAGER.SetDataValue( 0 , "obcpp_bsdy_017r", "InBlock1", "CALC_DYNU" , 0 , 0)
		cont01.btnEnroll.enable = true
		TR_Inquiry( "obcpp_bsdy_017r" )
	end if
'	TR_Inquiry( "obcpp_bsdy_017r" )
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_DateType = 0
	g_szDate = cont01.Calendar0.caption
	'16-04-12 YCJ 예약일자는 6개월 이내만 가능
	cont01.calFinDate.addday = 183
	DATAMANAGER.SetDataValue( 0 , "obcpp_bsdy_017r", "InBlock1", "CALC_DYNU" , 0 , 1)
	TR_Inquiry( "obcpp_bsdy_017r" )
End Sub

'============================================================================
Sub cont01_edt06_OnEditComplete()
	szLen = Form.GetByteLength(cont01.edt06.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		cont01.edt06.caption = ""
	end if	
End Sub

'============================================================================
Sub cont01_edt07_OnEditComplete()
	szLen = Form.GetByteLength(cont01.edt07.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		cont01.edt07.caption = ""
	end if		
End Sub

'============================================================================
' cont01_imgLimit_OnClick() : 한도금액 조회
'============================================================================
Sub cont01_imgLimit_OnClick()
	if g_szAccountNumber == "" then
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
	else
		Form.OpenPopup("mbbnk61040_p3" , g_szAccountNumber , sPosInfo)
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "DrngAmtCnfrMsgBox" then
		'Form.ShowAlert("알림", sRet)
		if sRet = "ok" then
			'Call Pop_Confirm_page() v001 사기의심체크이후 실행
			FrdSspc_Chk()
		end if 
	end if 
End Sub

'============================================================================
' FrdSspc_Chk() : 사기의심 체크 - v001  FrdSspc_Chk 완료시 Pop_Confirm_page 호출
'============================================================================
Function FrdSspc_Chk()

     szDataTrTxpl = cont01.edt07.caption '받는분표시

	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "ACNO"   , 0 , g_szAccountNumber)
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "ASNO"   , 0 , g_szAccountSerialNumber )
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "TR_EXPL", 0 , szDataTrTxpl )
	'DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "RMRK"   , 0 , "" )
	DATAMANAGER.RequestTranData( "obrtp_comn_025r")

End Function

'============================================================================
Sub Pop_Confirm_page()
	if Trim(cont01.lblBankCode.caption) == "287" then	'메리츠당행조회
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "ACNO"          , 0 , g_szAccountNumber)	              '계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "ASNO"          , 0 , g_szAccountSerialNumber)	         '계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "USE_YN"        , 0 , "N")	                           '사용여부
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "CNFT_ACNO"     , 0 , Mid(cont01.edt04.caption, 1, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "CNFT_ASNO"     , 0 , Mid(cont01.edt04.caption, 9, 2))	'상대일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "TACT_CLS_CODE" , 0 , "17")                               '이체구분코드
		DATAMANAGER.RequestTranData("obrtd_drng_025r_1")
	else
	
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "MNRC_BANK_CODE" , 0 , Trim(cont01.lblBankCode.caption))	'입금은해코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "JOB_TRNO", 0 , "031")								'작업단말번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "MNRC_ACNO" , 0 , Trim(cont01.edt04.caption))				'입금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "TR_AMT" , 0 , cont01.edt02.caption)						'거래금액
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "DRNG_ACNO" , 0 , g_szAccountNumber)						'계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , g_szAccountSerialNumber)		'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "PWD" , 0 , g_szAccountPassword)							'비밀번호
		DATAMANAGER.RequestTranData("obtss_elbs_129r_1")
	
	end if
End Sub

