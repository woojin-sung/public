	<SCRIPT_INFO _len="3978" _ulen="3704" >
'============================================================================
' 01. 화 면 명 : 발행어음매매_매수확인창
' 02. 화면설명 : 발행어음매매_매수확인창
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'20220830 SWJ START : 만료 2주일 전부터 팝업 공지 (하루 안보기) , 만료 후에도 공지 (일주일 안보기)
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
Dim g_nState			'종료시 버튼 선택 여부
Dim CancDate
Dim CancDateNm
Dim g_szKYCKey		'하루동안 보지않기(만료 14일전), 일주일 동안 보지 않기(만료 후) 구분 플래그
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_szData = Form.GetOpenLinkData()
	g_szKYCKey = Form.GetSharedData("KYC_KEY", true )
	
	todayDate = Form.GetSharedData("&HOST_DATE",0)
	saveDate = Form.LoadConfigData("NoticeSetting", "KYC_" & g_szKYCKey)
	     
	if saveDate <> "" then
		
		ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
		RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
		
		calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))

		if calcDate <= Cint(g_szKYCKey) then
			Form.SendReturnToParent("mbonl81010_p5" , "Y")
			Form.CloseForm()
		end if
	
	end if
     
     if g_szKYCKey == 1 or g_szKYCKey == "1" then
	     ChkButton0.visible = True
	     ChkButton1.visible = False
	     Label2.caption = "만료 예정입니다."
     else
  	     ChkButton0.visible = False
	     ChkButton1.visible = True   
	     Label2.caption = "만료 되었습니다."
     end if
     
     CancDateNm = left(g_szData,4)&"/"&mid(g_szData,5,2)&"/"&right(g_szData,2)&"일"
	
	 Label1.caption = CancDateNm

	
End Sub
'============================================================================
' btnClose_OnClick()
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnOk_OnClick() : 확인버튼 누를시 공인인증서 화면 열수 있게 값 지정
'============================================================================
Sub btnOk_OnClick()
	'Form.SendReturnToParent( "Ok" , sData )
	'Form.CloseForm()
	'Form.OpenPopup("mbonl81010" , "" , "" )
	
	Form.SendReturnToParent("mbonl81010", "Y")
	Form.CloseForm()
End Sub


'============================================================================
Sub Image5_OnClick()
	 Form.SendReturnToParent("mbonl81010_p5" , "Y")
	 Form.CloseForm()
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	saveDate = Form.GetSharedData("&HOST_DATE",0)
	Form.SaveConfigData("NoticeSetting", "KYC_" & g_szKYCKey, saveDate)
	
	Form.SendReturnToParent("mbonl81010_p5" , "Y")
	Form.CloseForm()
End Sub

'============================================================================
Sub ChkButton1_OnChange(sCheckState)
	saveDate = Form.GetSharedData("&HOST_DATE",0)
	Form.SaveConfigData("NoticeSetting", "KYC_" & g_szKYCKey, saveDate)
	
	Form.SendReturnToParent("mbonl81010_p5" , "Y")
	Form.CloseForm()
End Sub

