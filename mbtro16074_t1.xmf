'===========================================================================
' 2020.11.25 : 이현우 : v001 - 해외주식 매도상환
' 2021.02.08 : 이현우 : v002 - 수수료, 현지비용 추가
' 2022.06.16 : 장시방 : v003 - 주문유형 추가
' 2024.03.20 : 장시방 : v004 : 스위스 시장코드, 내부거래소코드, 통화코드 추가
'===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szSta_Date
Dim g_szFin_Date
Dim g_NextCnt
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TRANCALL" then
		tmp = Split(sParam, "||")
		
		g_NextCnt = 0
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		
		
		DATAMANAGER.RequestTranData("obtro_oder_103r")
	end if
End Sub
'============================================================================
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtro_oder_103r" then
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_103r", "InBlock1", "ACNO" 			, 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_103r", "InBlock1", "ASNO" 			, 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_103r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "0")
		DATAMANAGER.SetDataValue(0, "obtro_oder_103r", "InBlock1", "PROS_CLS"		, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obtro_oder_103r", "InBlock1", "DATA_CLS"		, 0 , "0")
		DATAMANAGER.SetDataValue(0, "obtro_oder_103r", "InBlock1", "IQRY_CSNU"		, 0 , "0")

		
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
		g_NextCnt = 0
		DATAMANAGER.ClearOutputData(0, "obtro_oder_103r")
		
		DATAMANAGER.RequestTranData("obtro_oder_103r")
End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
		g_NextCnt = 0
		DATAMANAGER.ClearOutputData(0, "obtro_oder_103r")
		
		DATAMANAGER.RequestTranData("obtro_oder_103r")		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtro_oder_103r" then
		
		for i = g_NextCnt to grd0.rowcount - 1
		
			deal_cls_code   = grd0.GetCellData("bd_cell4", i)
			deal_cls_name	  = ""
			nation		  = grd0.GetCellData("bd_cell12", i)
			oder_condition  = grd0.GetCellData("bd_cell10", i)
			oder_prc		  = Cstr(grd0.GetCellData("bd_cell8", i))
			cntg_prc		  = Cstr(grd0.GetCellData("bd_cell9", i))
			oder_cfee      = Cstr(grd0.GetCellData("bd_cell26", i))	'v002
			acpn_cfee	  = Cstr(grd0.GetCellData("bd_cell27", i))	'v002
			rctf_cncl_cls_code = grd0.GetCellData("bd_cell14", i)
			aspr_type_code  = grd0.GetCellData("bd_cell28", i)		'v003
			
			iscd			= grd0.GetCellData("bd_cell3", i)
			exch			= right(iscd,2)
			
			
			
			if deal_cls_code = "1" then '매도
				deal_cls_name = "매도"
				grd0.SetCellFgColor("bd_cell4", i, "11")
				'grd0.SetCellData("bd_cell4", i, "매도")
			elseif deal_cls_code = "2" then 				'매수
				deal_cls_name = "매수"
				grd0.SetCellFgColor("bd_cell4", i, "10")
				'grd0.SetCellData("bd_cell4", i, "매수")
			else 
				Form.ShowAlert("TEST", "매도/매수가 아님")
			end if
			
			if rctf_cncl_cls_code = "1" then
				deal_cls_name = deal_cls_name & "정정"
			elseif rctf_cncl_cls_code = "2" then
				deal_cls_name = deal_cls_name & "취소"
			else
				deal_cls_name = deal_cls_name
			end if
			
			grd0.SetCellData("bd_cell4", i, deal_cls_name)
			
			if nation = "01" then
				grd0.SetCellData("bd_cell13", i, "미국")
				grd0.SetCellData("bd_cell11", i, "USD")
				
			elseif nation = "02" then
				grd0.SetCellData("bd_cell13", i, "홍콩")
				grd0.SetCellData("bd_cell11", i, "HKD")
				
			elseif nation = "03" then
				grd0.SetCellData("bd_cell13", i, "중국")
				grd0.SetCellData("bd_cell11", i, "CNY")
				
			elseif nation = "04" then
				grd0.SetCellData("bd_cell13", i, "중국")
				grd0.SetCellData("bd_cell11", i, "CNY")
				
			elseif nation = "05" then '2019.05.15 추가
				grd0.SetCellData("bd_cell13", i, "일본")
				grd0.SetCellData("bd_cell11", i, "JPY")
			
			elseif nation = "06" then
				grd0.SetCellData("bd_cell13", i, "호주")								
				grd0.SetCellData("bd_cell11", i, "AUD")
				
			elseif nation = "07" then
				grd0.SetCellData("bd_cell13", i, "싱가폴")
				grd0.SetCellData("bd_cell11", i, "SGD")
				
			elseif nation = "08" then '2020.11.05 유로국가 추가
				grd0.SetCellData("bd_cell13", i, "영국")
				grd0.SetCellData("bd_cell11", i, "GBP")
			
			elseif nation = "09" then
				grd0.SetCellData("bd_cell13", i, "영국")
				grd0.SetCellData("bd_cell11", i, "USD")
			
			elseif nation = "10" then
				grd0.SetCellData("bd_cell13", i, "독일")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "11" then
				grd0.SetCellData("bd_cell13", i, "핀란드")
				grd0.SetCellData("bd_cell11", i, "EUR")

			elseif nation = "12" then
				grd0.SetCellData("bd_cell13", i, "프랑스")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "13" then
				grd0.SetCellData("bd_cell13", i, "벨기에")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "14" then
				grd0.SetCellData("bd_cell13", i, "네덜란드")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "15" then
				grd0.SetCellData("bd_cell13", i, "포르투갈")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "16" then
				grd0.SetCellData("bd_cell13", i, "그리스")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "17" then
				grd0.SetCellData("bd_cell13", i, "아일랜드")
				grd0.SetCellData("bd_cell11", i, "EUR")
				
			elseif nation = "18" then
				grd0.SetCellData("bd_cell13", i, "이탈리아")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "19" then
				grd0.SetCellData("bd_cell13", i, "스페인")
				grd0.SetCellData("bd_cell11", i, "EUR")
			
			elseif nation = "20" then
				grd0.SetCellData("bd_cell13", i, "오스트리아")
				grd0.SetCellData("bd_cell11", i, "EUR")
				
			elseif nation = "21" then
				grd0.SetCellData("bd_cell13", i, "캐나다")
				grd0.SetCellData("bd_cell11", i, "CAD")
				
			elseif nation = "23" then
				grd0.SetCellData("bd_cell13", i, "인도네시아")
				grd0.SetCellData("bd_cell11", i, "IDR")
				
			elseif nation = "24" then '2020.11.26 베트남 추가
				grd0.SetCellData("bd_cell13", i, "베트남")
				grd0.SetCellData("bd_cell11", i, "VND")
				
			elseif nation = "25" then
				grd0.SetCellData("bd_cell13", i, "베트남")
				grd0.SetCellData("bd_cell11", i, "VND")
			
			elseif nation = "26" then 'v004
				grd0.SetCellData("bd_cell13", i, "스위스")
				grd0.SetCellData("bd_cell11", i, "CHF")
			end if
			
			grd0.SetCellData("bd_cell8", i , FormatNumber(oder_prc,4))
			grd0.SetCellData("bd_cell9", i , FormatNumber(cntg_prc,4))
			
			'v002
			grd0.SetCellData("bd_cell26", i , FormatNumber(oder_cfee,2))
			grd0.SetCellData("bd_cell27", i , FormatNumber(acpn_cfee,2))
			
			'grd0.SetCellData("bd_cell6", i , FormatNumber(oder_amt,3))
			'grd0.SetCellData("bd_cell7", i , FormatNumber(cntg_amt,3))

			if oder_condition = "0" then
				grd0.SetCellData("bd_cell10", i, "정상")
			elseif oder_condition = "1" then
				grd0.SetCellData("bd_cell10", i, "거부")
			elseif oder_condition = "2" then
				grd0.SetCellData("bd_cell10", i, "자동거부")
			elseif oder_condition = "3" then
				grd0.SetCellData("bd_cell10", i, "자동취소(체결후)")
			elseif oder_condition = "4" then
				grd0.SetCellData("bd_cell10", i, "미접수")
			else
				Form.ShowAlert("TEST", "해당하는 주문조건 없음 : " & oder_condition & " , " & i)
			end if
			
			if exch = "NY" then
				grd0.SetCellData("bd_cell12", i, "뉴욕")
			elseif exch = "AX" then
				grd0.SetCellData("bd_cell12", i, "아멕스")
			elseif exch = "OQ" then
				grd0.SetCellData("bd_cell12", i, "나스닥")
			elseif exch = "SZ" then
				grd0.SetCellData("bd_cell12", i, "심천")
			elseif exch = "SH" then
				grd0.SetCellData("bd_cell12", i, "상해")
			elseif exch = "HK" then
				grd0.SetCellData("bd_cell12", i, "홍콩")
			elseif exch = "JP" then 
				grd0.SetCellData("bd_cell12", i, "도쿄")  '2019.05.15 추가
			elseif exch = "AU" then
				grd0.SetCellData("bd_cell12", i, "호주")
			elseif exch = "SP" then
				grd0.SetCellData("bd_cell12", i, "싱가폴")
			elseif exch = "CT" then
				grd0.SetCellData("bd_cell12", i, "토론토")
			elseif exch = "LN" then					 '2020.11.05 - 유로국가 추가
				grd0.SetCellData("bd_cell12", i, "런던")
			elseif exch = "LI" then
				grd0.SetCellData("bd_cell12", i, "런던인터내셔날")
			elseif exch = "GY" then
				grd0.SetCellData("bd_cell12", i, "독일")
			elseif exch = "FH" then
				grd0.SetCellData("bd_cell12", i, "핀란드")
			elseif exch = "FP" then
				grd0.SetCellData("bd_cell12", i, "프랑스") '프랑스
			elseif exch = "BB" then
				grd0.SetCellData("bd_cell12", i, "벨기에") '벨기에
			elseif exch = "NA" then
				grd0.SetCellData("bd_cell12", i, "네덜란드") '네덜란드
			elseif exch = "PL" then
				grd0.SetCellData("bd_cell12", i, "포르투갈") '포르투갈
			elseif exch = "XT" then
				grd0.SetCellData("bd_cell12", i, "그리스")
			elseif exch = "ID" then
				grd0.SetCellData("bd_cell12", i, "아일랜드")
			elseif exch = "IM" then
				grd0.SetCellData("bd_cell12", i, "이탈리아")
			elseif exch = "SM" then
				grd0.SetCellData("bd_cell12", i, "스페인")	
			elseif exch = "AV" then
				grd0.SetCellData("bd_cell12", i, "오스트리아")
			elseif exch = "IJ" then
				grd0.SetCellData("bd_cell12", i, "인도네시아")
			elseif exch = "VH" then
				grd0.SetCellData("bd_cell12", i, "하노이")
			elseif exch = "VM" then
				grd0.SetCellData("bd_cell12", i, "호치민")
			elseif exch = "SW" then
				grd0.SetCellData("bd_cell12", i, "스위스") 'v004
			else
				grd0.SetCellData("bd_cell12", i, "")
			end if
			
			'v001
			loan_type = Form.GetMetaData("대출상세유형코드", grd0.GetCellData("bd_cell21", i))
			grd0.SetCellData("bd_cell24", i, loan_type)
			
			'v003
			if aspr_type_code = "1" then
				grd0.SetCellData("bd_cell28", i, "시장가")
			elseif aspr_type_code = "2" then
				grd0.SetCellData("bd_cell28", i, "지정가")
			elseif aspr_type_code = "4" then
				grd0.SetCellData("bd_cell28", i, "LOO")
			elseif aspr_type_code = "5" then
				grd0.SetCellData("bd_cell28", i, "LOC")
			elseif aspr_type_code = "6" then
				grd0.SetCellData("bd_cell28", i, "MOO")
			elseif aspr_type_code = "7" then
				grd0.SetCellData("bd_cell28", i, "MOC")
			elseif aspr_type_code = "8" then
				grd0.SetCellData("bd_cell28", i, "Limit VWAP")
			elseif aspr_type_code = "9" then
				grd0.SetCellData("bd_cell28", i, "Limit TWAP")
			elseif aspr_type_code = "A" then
				grd0.SetCellData("bd_cell28", i, "VWAP")
			elseif aspr_type_code = "B" then
				grd0.SetCellData("bd_cell28", i, "TWAP")
			end if
			
'			select  case (oder_condition)
'			case "0" , 0
'				grd0.SetCellData("bd_cell8", i, "정상")
'			case "1" , 1
'				grd0.SetCellData("bd_cell8", i, "거부")
'			case "2" , 2
'				grd0.SetCellData("bd_cell8", i, "자동거부")
'			case "3" , 3
'				grd0.SetCellData("bd_cell8", i, "자동취소(체결후)")
'			case "4" , 4
'				grd0.SetCellData("bd_cell8", i, "미접수")
'			end select
		next
		
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_oder_103r", "OutBlock1")
		
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_NextCnt = 0
	
	'20240723 START
	grd0.SetCellMaxLineCount("bd_cell2",2)
	grd0.SetCellMaxLineCount("bd_cell22",2)
	'20240723 END
	
End Sub

