Sub contMain_edtAtherAcnt_OnEditComplete()
	g_szPreKeyPad = "edtAltnAcnt"
	
	if g_OSType <> "1" and g_szPreKeyPad == g_szCurKeyPad then
		contMain.lblScrollPos.top = 0
		contMain.SetScrollAutoSize()
		contMain.scroll_pos = 0
	end if
	
	if contMain.edtAtherAcnt.caption <> "" and contMain.edtAtherAcnt.caption <> null then
		f_BeforeCheckAnct()
	end if
End Sub

'============================================================================
' contMain_edtAtherAcnt_OnClick() : 아이폰 에이트 선택시 화면이동이슈
'============================================================================
Sub contMain_edtAtherAcnt_OnClick()
	g_szCurKeyPad = "edtAltnAcnt"
	
	if g_OSType <> "1" then
		contMain.lblScrollPos.top = 500
		contMain.SetScrollAutoSize()
		contMain.scroll_pos = 110
	end if
End Sub

