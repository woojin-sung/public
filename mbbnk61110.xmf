'============================================================================
Sub contMain_grd0_OnClickUp(lRow, szCellID)
	if g_bSubmitFlag <> true then
		if szCellID == "bd_uiqty" then
			Dim szAllQty, szQty, szItemCd, szItemNm
			g_nChoiceRow = CInt(lRow)
			szAllQty =  contMain.grd0.GetCellData( "bd_ableqty", lRow )
			szQty =  contMain.grd0.GetCellData( "bd_qty", lRow )
			szItemCd =  contMain.grd0.GetCellData( "bd_itemcd", lRow )
			szItemNm =  contMain.grd0.GetCellData( "bd_name", lRow )
			szIssuCd =  contMain.grd0.GetCellData( "bd_itmtpcd", lRow )
			
			Form.OpenPopup("mbbnk61100_p6", szAllQty&"★"&szQty&"★"&szItemCd&"★"&szItemNm&"★"&szIssuCd,"")
		
		elseif szCellID == "bd_del" then
			contMain.grd0.SetDeleteRow( lRow )
			'수수료 합계 계산
			f_SetFeeAmt()
		end if
	end if
End Sub

