Dim g_sPlain_rm
Dim g_nChoiceRow
Dim g_nChkItemCount
Dim obrts_ccfo_009r_RequestCnt
Dim obrts_ccfo_010a_RequestCnt
Dim g_bSubmitFlag
Dim g_nSuccCnt, g_nFailCnt
Dim g_sMangBrcd
Dim g_bAcntCheck

' 확장개발 > 컴플리트랑 같이 스크롤포스 조절되서 안먹도록 하기 위해 현재 포커싱 에디트와 이전 포커싱 에디트 비교하여 왓다갓다 하지 않도록 수정
Dim g_OSType
Dim g_szCurKeyPad 
Dim g_szPreKeyPad
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function f_InitCtrl()
	'계좌비밀번호 초기화
	If EdtPswd.caption <> "" Then
		EdtPswd.caption = ""
	End If
	
	'컨트롤 Data 초기화
	contMain.grd0.SetClear( ) 					'그리드 행 클리어
	contMain.lblAbleAmt.caption 	= "" 		'출고가능여부
	contMain.lblTotalFee.caption 	= "" 		'수수료 
	contMain.lblCodeName.caption 	= "증권사" 	'증권사명
	contMain.lblCodeName.fgcolor 	= "77"
	contMain.lblAcntName.caption 	= ""			'타사계좌명
	contMain.edtAtherAcnt.caption 	= "" 		'타사계좌번호
	'컨트롤 상태 초기화
	contMain.btnOpen.enable 		= true 	'타증권사 검색 버튼
	contMain.imgSearch.enable 		= true 	'타증권사 검색 이미지
	BtnProcess.enable 			= false 	'출고처리 버튼
	contMain.btnAddPopup.enable 	= true 	'잔고팝업버튼
	contMain.edtAtherAcnt.enable 	= true 	'타사계좌에디트
	contMain.btnCheckAcnt.enable 			= false  '계좌확인버튼
	contMain.lblGrdInfo.visible 	= true
	'변수 초기화
	g_nSuccCnt 				= 0 		'출고처리 성공 개수
	g_nFailCnt 				= 0 		'출고처리 실패 개수
	g_bSubmitFlag 			= false 	'출고처리 플래그
	g_nChkItemCount 			= 0 		'종목체크 수
	obrts_ccfo_009r_RequestCnt 	= 0 		'계좌수신 요청 횟수
	obrts_ccfo_010a_RequestCnt 	= -1 	'출고처리 요청 횟수
	
End Function

'============================================================================
Function f_DisableCtrl()
	if g_bSubmitFlag == true then
		contMain.btnOpen.enable 		= false '타증권사 검색 버튼
		contMain.imgSearch.enable 		= false '타증권사 검색 이미지
		BtnProcess.enable 			= false '처리버튼
		contMain.btnAddPopup.enable		= false '잔고팝업버튼
		contMain.btnCheckAcnt.enable 	= false '계좌확인버튼
		contMain.edtAtherAcnt.enable	= false '타사계좌에디트
	end if
End Function
'============================================================================
Function f_bOpIstuCodeSelCheck()
	' 예탁원                 메리츠(ISSUE_TYPE_CODE)    prod_cls_code		메리츠(SCRT_GRP_CLS_CODE)
	' 01.주식,                   :02
	' 02.채권,                   :03
	' 04.CD,                     :05
	' 05.어음(CP),               :04
	' 07.WRTS(BW증권),           :14(신주인수권 증권)
	' 08.(신주인수권)증서,       :15(신주인수권 증서)
	' 11.ELW,                    :17                      
	' 13.ELS,                    :08                     07   
	' 14.DLS,                    :08                     10
	' 15.집합투자증권            :
	' 19.ETN					 :02										: EN	
	
	Dim bReturnValue, lRecordCount
	Dim szIssuTypeCode, szProdClsData, szScrtGrpClsCode, szGetDepsScrtClsCode
	
	bReturnValue = true
    lRecordCount = CInt(contMain.grd0.rowcount)
	
    '2011.12.07 이유미 : 종목다건 선택 시, 종목유형코드가 다르면 Error(장선혜 확인)
	for i = 0 to lRecordCount -1	    
		szIssuTypeCode 	= contMain.grd0.GetCellData( "bd_itmtpcd", i		)'종목유형코드
		szProdClsCode  	= contMain.grd0.GetCellData( "bd_otc", i 		)'OTC구분
		szScrtGrpClsCode 	= contMain.grd0.GetCellData( "bd_groupcd", i	)'증권그룹구분코드
		
		szGetDepsScrtClsCode = f_szGetDepsScrtClsCode( szIssuTypeCode, szProdClsCode, szScrtGrpClsCode) 
		
		'비정상 check
	     if szGetDepsScrtClsCode == "99" then
		    bReturnValue = false
		    Form.ShowAlert("알림", "타사대체출고 가능종목이 아닙니다.")
		    
		    return bReturnValue
		 else
			 contMain.grd0.SetCellData("bd_issucd", i, szGetDepsScrtClsCode)
		 end if
	Next
	
	return bReturnValue
End Function

'============================================================================
Function f_szGetDepsScrtClsCode( szIssuTypeCode ,szProdClsCode , szScrtGrpClsCode)
	Dim sReturnValue
	
	IF szIssuTypeCode = "02" THEN      '주식
	    if szScrtGrpClsCode = "EN" then
		   sReturnValue = "19" 'ETN
	    else
	       sReturnValue = "01" '주식
	    end if
	ELSEIF szIssuTypeCode = "03" THEN   '채권
	   sReturnValue = "02"
	ELSEIF szIssuTypeCode = "04" THEN   'CP
	   sReturnValue = "05"
	ELSEIF szIssuTypeCode = "05" THEN   'CD
	   sReturnValue = "04"
	ELSEIF szIssuTypeCode = "14" THEN   '(신주인수권) 증권
	   sReturnValue = "07"
	ELSEIF szIssuTypeCode = "15" THEN   '(신주인수권) 증서
	   sReturnValue = "08"
	ELSEIF szIssuTypeCode = "17" THEN   'ELW
	   sReturnValue = "11"  
	ELSEIF szIssuTypeCode = "08" AND szProdClsCode = "07" THEN   'ELS
	      sReturnValue = "13"
	ELSEIF szIssuTypeCode = "08" AND szProdClsCode = "10" THEN   'DLS
	      sReturnValue = "14"
	ELSE
	      sReturnValue = "99"
	END IF
    
	IF sReturnValue <> "99" THEN 
		contMain.tblState.SetCellString(1, 1, sReturnValue) 'ISSU_TYPE_CODE
	Else
		contMain.tblState.SetCellString(1, 1, "") 'ISSU_TYPE_CODE
	END IF
    
    return sReturnValue
End Function

'============================================================================
Function f_CheckAbleItem(nCnt)
	Dim iIdx, sItemCode
	Dim szIssuTypeCode, szProdClsData, szScrtGrpClsCode, szGetDepsScrtClsCode
	
	iIdx = nCnt-1
	sItemCode 		= contMain.grd0.GetCellData("bd_itemcd"	, iIdx)'종목코드
	szIssuTypeCode 	= contMain.grd0.GetCellData("bd_itmtpcd"	, iIdx)'종목유형코드
	szProdClsCode  	= contMain.grd0.GetCellData("bd_otc"		, iIdx)'OTC구분
	szScrtGrpClsCode 	= contMain.grd0.GetCellData("bd_groupcd"	, iIdx)'증권그룹구분코드
	'증권예탁구분코드
	szGetDepsScrtClsCode = f_szGetDepsScrtClsCode( szIssuTypeCode, szProdClsCode, szScrtGrpClsCode) 
	
	DATAMANAGER.SetDataValue( 0, "obrts_ccfo_002c", "InBlock1", "DEPS_SCRT_CLS_CODE" , 0, szGetDepsScrtClsCode )
	DATAMANAGER.SetDataValue( 0, "obrts_ccfo_002c", "InBlock1", "ISCD" , 0, sItemCode )
	DATAMANAGER.RequestTranData( "obrts_ccfo_002c" ) 'CCF 가능사 확인
End Function

'============================================================================
Function f_OpenOtherPopup()
	dim nItemListCnt, iIdx
	nItemListCnt = CInt(contMain.grd0.rowcount)
	
	if nItemListCnt > 0 then
		dim sState, nQty
		sState = true
		
		for i=0 to nItemListCnt-1 
			nQty = CInt(contMain.grd0.GetCellData( "bd_qty", i )) '출고수량
			if nQty == 0 or nQty == "" or nQty == null then
				iIdx = i+1
				sState = false
				Exit for
			end if
		next
		
		if sState == true then
			Form.OpenPopup("mbbnk61110_p1","","") '타사증권사 조회
		else
			Form.ShowAlert("알림", "출고하실 수량을 입력해주세요.")
		end if
	else
		Form.ShowAlert("알림", "출고하실 종목을 추가해주세요.")
	end if
End Function

'============================================================================
Function f_BeforeCheckAnct()
	'출고종목 체크
	if CInt(contMain.grd0.rowcount) <= 0 then
		Form.ShowAlert("알림", "출고하실 종목을 추가해 주세요.")
		Exit Function
	end if
	'CCF처리가능여부 초기화
	contMain.tblState.SetCellString(0, 1, "") 
	'종목유형 체크
	if f_bOpIstuCodeSelCheck() then
		dim szCLSCode
		szCLSCode = contMain.tblState.GetCellString( 1, 1 ) 	'예탁증권구분코드
		if contMain.edtCode.caption <> "" and contMain.edtCode.caption <> null then
			'타사기관 출고 가능 조회
			if szCLSCode <> "" and szCLSCode <> null then
				DATAMANAGER.SetDataValue( 0, "obrts_ccfo_006r", "InBlock1", "SECO_BRCD" 			, 0, contMain.edtCode.caption )
				DATAMANAGER.SetDataValue( 0, "obrts_ccfo_006r", "InBlock1", "DEPS_SCRT_CLS_CODE" 	, 0, szCLSCode )
				DATAMANAGER.RequestTranData("obrts_ccfo_006r")	
			end if
		else
			contMain.edtAtherAcnt.caption = ""
			Form.ShowAlert("알림", "타 증권사를 선택해 주세요.")
		end if	
	end if
End Function

'============================================================================
Function f_CheckAtherAcnt()
	dim szCCF_Able, szIssuTypeCode, sItemCode
	szCCF_Able 		= contMain.tblState.GetCellString( 0, 1 ) 'CCF가능여부
	szIssuTypeCode 	= contMain.tblState.GetCellString( 1, 1 ) '예탁증권구분코드
	'출고종목 체크
	if CInt(contMain.grd0.rowcount) <= 0 then
		Form.ShowAlert("알림", "출고하실 종목을 추가해 주세요.")
		Exit Function
	end if
	'CCF 가능 여부 체크
'	if szCCF_Able == null or szCCF_Able == "" then
'		Form.ShowAlert("알림", "CCF가능사여부를 먼저 확인하십시오.")
'		Exit Sub
'	end if
	'CCF 가능 불가 시
	if szCCF_Able == "N" then
		Form.ShowAlert("알림", "계좌확인이 불가능합니다.")
		Exit Function
	end if
	'계좌번호 체크
	if contMain.edtAtherAcnt.caption == "" or contMain.edtAtherAcnt.caption == null then
		Form.ShowAlert("알림", "입고계좌번호를 입력해주세요.")
		Exit Function
	end if
	Form.Toast( 0, "타사계좌를 조회 중입니다.", false )
	'타증권사 출고처리 가능 여부 조회
	f_CheckAbleItem(1)
End Function
'============================================================================
Function f_SetFeeAmt()
	Dim nFee, nItemListCnt
	nFee = 0
	nItemListCnt = CInt(contMain.grd0.rowcount) '종목 수
	if nItemListCnt > 0 then
		'수수료 합계 계산
		for i=0 to nItemListCnt-1 
			nFee = nFee + CInt(contMain.grd0.GetCellData( "bd_feeD", i))
			contMain.lblTotalFee.caption = nFee
		next
	else
		contMain.lblTotalFee.caption = 0
		contMain.lblGrdInfo.visible = true
	end if
End Function

'============================================================================
Function f_bCheckBeforeSubmit()
	'계좌번호 체크
	if (acnt0.caption == "" or acnt0.caption == null) 
		or (acnt0.total == "" or acnt0.total == null) then
		Form.ShowAlert("알림", "계좌번호를 확인해주세요.")
		return false
	end if
	'비밀번호 체크
	if EdtPswd.caption == "" or EdtPswd.caption == null or Len(EdtPswd.caption) < 4 then
		Form.ShowAlert("알림", "계좌 비밀번호를 확인해주세요.")
		return false
	end if
	'추가된 종목 유무 체크
	if CInt(contMain.grd0.rowcount) <= 0 then
		Form.ShowAlert("알림", "처리할 종목이 없습니다.")
		return false
	end if
	'출고수량 체크
	if CInt(contMain.grd0.rowcount) > 0 then
		for i=0 to CInt(contMain.grd0.rowcount)-1
			dim nQty '입력 수량
			nQty = CInt(contMain.grd0.GetCellData("bd_qty", i))
			if nQty == 0 or nQty == null then
				Form.ShowAlert("알림", "출고수량이 입력되지 않았습니다.")
				return false
			end if
		next
	end if
	'타 증권사 계좌 체크
	if Len(contMain.edtAtherAcnt.caption) <= 0 then
		Form.ShowAlert("알림", "타증권사를 관련 정보를 확인해주세요.")
		return false
	end if
	'CCF 가능사 체크
	if contMain.tblState.GetCellString(0, 1) == "" or contMain.tblState.GetCellString(0, 1) == null then
		Form.ShowAlert("알림", "CCF 가능사 확인을 해주세요.")
		return false	
	end if
	'계좌확인 전문응답 체크
	if contMain.tblState.GetCellString(4, 1) == "" or contMain.tblState.GetCellString(4, 1) == null then
		Form.ShowAlert("알림", "계좌확인 전문 미수신 상태입니다.")
		return false	
	end if
	'출금가능금액 체크
	if CInt(contMain.lblAbleAmt.caption) < CInt(contMain.lblTotalFee.caption) then
		Form.ShowAlert("알림", "출금가능금액이 부족합니다.")
		return false
	end if
	'ELW 체크
	for i=0 to CInt(contMain.grd0.rowcount) 
		dim szIssuCd '증권예탁구분코드
		szIssuCd = contMain.grd0.GetCellData( "bd_issucd", i )
		if szIssuCd == "11" then 'ELW
			Form.MsgBox( "알림", "해당 종목에 대한 대체신청으로, 'ELW거래신청'은 취소처리가 됩니다. 취소처리후 ELW에 대한 매수는 금지되며, 매도처리는 가능합니다. \r\n대체처리를 하시겠습니까?", "ELW_CHK", 1)
			return false
		end if
	next
	'적합
	return true
End Function

'============================================================================
Function f_BeforeSubmit()
	'적합성체크
	if f_bCheckBeforeSubmit() == true then
		if contMain.tblState.GetCellString(0, 1) == "Y" then 'CCF 가능사 여부
			'계좌수신 응답코드
			if contMain.tblState.GetCellString(4, 1) == "0000" then
				Dim szSendData, szAcnt, szOtherBankNm, szOtherAcnt, szOtherName, szFee, sPwd
				szAcnt 			= acnt0.total & acnt0.sequence 	'출고계좌
				szOtherBankNm 	= contMain.lblCodeName.caption 			'입고은행명
				szOtherAcnt 		= contMain.edtAtherAcnt.caption 		'입고계좌
				szOtherName 		= contMain.lblAcntName.caption 			'입고계좌주 명
				szFee 			= contMain.lblTotalFee.caption 			'수수료
				sPwd 			= EdtPswd.caption
				'전달데이터
				szSendData = "H★"&szAcnt&"★"&szOtherBankNm&"★"&szOtherAcnt&"★"&szOtherName&"★"&szFee&"★"&sPwd
				'인증 절차 진행
				Form.OpenFramePopup( "mbbnk61100_p4", szSendData, "" )
'				f_SetSubmitState() 'TEST
			else
				Form.ShowAlert("알림", "계좌확인 전문 응답코드가 비정상입니다.")
			end if
		else
			Form.ShowAlert("알림", "처리불가한 증권사입니다.(CCF불가)")
		end if
	else
		g_bSubmitFlag =  false
	end if
End Function

'============================================================================
Function f_SetSubmitState()
	g_bSubmitFlag =  true
	Form.addWaitCursor() 'v001
	g_nChkItemCount = 1 '출고처리 할 그리드 행
	f_CheckAbleItem(g_nChkItemCount) '종목체크
	Form.Toast(0, "출고처리가 진행 중입니다.", false)
End Function

'============================================================================
Function f_Submit()
	dim nItemCnt, szTranID
	nItemCnt = CInt(contMain.grd0.rowcount) '처리할 종목 개수
	szTranID = "obrts_ccfo_010a" '출고처리 서비스 명
	obrts_ccfo_010a_RequestCnt = obrts_ccfo_010a_RequestCnt + 1
	'종목 수 만큼 처리
	if obrts_ccfo_010a_RequestCnt <= nItemCnt-1 then
		dim nRowIdx '현재 처리할 행
		nRowIdx = obrts_ccfo_010a_RequestCnt
		
		dim szTranSrno, szRcpySrno
		'거래내역일련번호
		szTranSrno = contMain.grd0.GetCellData( "bd_transrno", nRowIdx )
		'출납일련번호
		szRcpySrno = contMain.grd0.GetCellData( "bd_rcpysrno", nRowIdx )
		
		if (szTranSrno=="" or szTranSrno==null) and (szRcpySrno=="" or szRcpySrno==null) then
			dim sAcno, sAsno, sPwd, sDate, sCode
			'비밀번호 암호화
			If g_sPlain_rm == "1" Then
			    sPwd = EdtPswd.caption
			Else
			    sPwd = EdtPswd.encdata
			     if Trim(sPwd) == "" or Trim(sPwd) == null then
				    sPwd = EdtPswd.caption
			    end if
			End If
			sAcno = acnt0.total
			sAsno = acnt0.sequence
			sDate = Form.GetSharedData( "&HOST_DATE", false )
			'Input Value SET
			Dim szItemCd, szBuyDate, szTaxCd, nQty, szGrade, szTarfCd, nFee, nBuyRate, szTaxTypeCd, szFeeYN, szTaxPaym
			Dim szFeeYN
			'InBlock1 value
			szItemCd		= contMain.grd0.GetCellData( "bd_itemcd"	, nRowIdx )
			szBuyDate 	= contMain.grd0.GetCellData( "bd_buydate", nRowIdx )
			szTaxCd 		= contMain.grd0.GetCellData( "bd_feecode", nRowIdx )
			nQty 		= CInt(contMain.grd0.GetCellData( "bd_qty", nRowIdx ))
			szGrade 		= contMain.grd0.GetCellData( "bd_grade"	, nRowIdx )
			szTarfCd 	= contMain.grd0.GetCellData( "bd_percode", nRowIdx )
			nFee 		= CInt(contMain.grd0.GetCellData( "bd_feeD", nRowIdx ))
			nBuyRate 	= CDbl(contMain.grd0.GetCellData( "bd_buyrate", nRowIdx ))
			szTaxTypeCd 	= contMain.grd0.GetCellData( "bd_feecode", nRowIdx )
			szTaxPaym 	= contMain.grd0.GetCellData( "bd_taxtp", nRowIdx )
			szFeeYN 		= "0" '수수료징수여부
			if nFee > 0 then'수수료가 있을 때
				szFeeYN = "1"
			end if
			'InBlock2 value
			Dim szOwnAcntCd, szCustChk, szIssuCd, nRejectQty
			Dim szOwnAcntYN
			szOwnAcntCd 	= contMain.grd0.GetCellData( "bd_ownacnt", nRowIdx )
			szCustChk 	= contMain.grd0.GetCellData( "bd_ccfcustchk", nRowIdx )
			szIssuCd 	= contMain.grd0.GetCellData( "bd_issucd", nRowIdx )
			nRejectQty	= CInt(contMain.grd0.GetCellData( "bd_taxpaymqty", nRowIdx ))
			szOwnAcntYN = "Y"
			if szOwnAcntCd <> "1" then'동일인이 아닐 때
				szOwnAcntYN = "N"
			end if
			
			DATAMANAGER.ClearInputData( 0, szTranID )
			'InBlock1
'			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_BRCD"			, 0, g_sMangBrcd	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_DATE"			, 0, sDate 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0, sAcno 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0, sAsno 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD"			, 0, sPwd 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0, szItemCd 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BYOV_DATE"			, 0, szBuyDate 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0, szTaxCd 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TKWR_QTY"			, 0, nQty 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_GRAD_CODE"		, 0, szGrade 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TARF_CODE"			, 0, szTarfCd 	)	
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_FEE"			, 0, nFee 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FEE_LEVY_YN"		, 0, szFeeYN 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BYOV_ERT"			, 0, nBuyRate 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TAX_PAYM_CLS_CODE"	, 0, szTaxPaym 	)
			'InBlock2
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "PROS_ABLE_YN"		, 0, contMain.tblState.GetCellString(0, 1))
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ONSL_ANPR_CLS_CODE"	, 0, szOwnAcntCd 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DEPS_SCRT_CLS_CODE"	, 0, szIssuCd 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CUST_CNFR_YN"		, 0, szCustChk 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "RGHT_EXER_RFUS_QTY"	, 0, nRejectQty 	)
			
			DATAMANAGER.RequestTranData( szTranID )
		end if
	else
		'<<출고처리 모두 완료>>
		'************************************
		' szSendData : 출고정보♥종목정보~~♥종목정보~~...
		' 출고정보 : 당사/타사구분값★입고계좌번호★입고계좌명★상대증권★수수료합계(타사에서 사용/당사일경우 0)★계좌번호
		' 종목정보 : 종목명★출고수량★처리성공여부★처리불능일경우Msg
		'************************************
		Dim szSendData
		szSendData =  "H" & "★" & contMain.edtAtherAcnt.caption & "★" & contMain.lblAcntName.caption & "★" & contMain.lblCodeName.caption & "★" & contMain.lblTotalFee.caption & "★" & acnt0.caption
			
		For i = 0 to tonumber(contMain.grd0.rowcount-1) 
			Dim szIscdNm, szQty, szSuccessYN, szReasonN
			szQty 		= contMain.grd0.GetCellData( "bd_qty"	, i)
			szIscdNm 	= contMain.grd0.GetCellData( "bd_name"	, i)
			szSuccessYN 	= contMain.grd0.GetCellData( "bd_msg"	, i)
			szReasonN 	= contMain.grd0.GetCellData( "bd_errormag", i)
			szSendData 	= szSendData & "♥" & szIscdNm & "★" & szQty  & "★" & szSuccessYN & "★" & szReasonN 
		Next
		'출고결과 확인 팝업
		Form.OpenPopup( "mbbnk61100_p5" , szSendData , "")
		'초기화
		f_InitCtrl()
	end if
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Sub Form_OnFormInitBefore()
	g_sPlain_rm = Form.GetSharedData("&g_sPlain_rm" , false) '암호화 여부
	g_nChkItemCount = 0 '종목체크 수
	obrts_ccfo_009r_RequestCnt = 0 '계좌수신 요청 횟수
	obrts_ccfo_010a_RequestCnt = -1 '출고처리 요청 횟수
	g_bSubmitFlag = false '출고처리 플래그
	g_nSuccCnt = 0 '출고처리 성공 개수
	g_nFailCnt = 0 '출고처리 실패 개수
	g_sMangBrcd = "" '계좌 처리지점코드
End Sub

'============================================================================
Sub Form_OnFormInit()
	'2022.04.20 IOS 에디트 이미지 이슈 > 영향 최소화로 IOS일 경우에만 적용
	g_OSType = Form.GetSharedData( "&OS_TYPE", False )'1.안드로이드 2.iOS
	
	If g_OSType == "2" Then
		contMain.edtAtherAcnt.SetOnOffImage("input_01_o.9.png","input_01_n.9.png")	'select/normal 이미지 설정
		contMain.edtAtherAcnt.imagefilepth = "input_01_n.9.png"						'최초 이미지 설정
	End If
	
	f_InitCtrl()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'***********************************************
	'************* 잔고추가 팝업 처리 **************
	'***********************************************
	If sKeyName == "mbbnk61100_p1" Then
		Dim tData, tItem
		'선택한 종목 데이터
		If sRet <> "" and sRet <> null Then
			contMain.grd0.SetClear()'그리드 초기화
			tData = Split(sRet, "♥")
			If #tData > 0 Then
				contMain.lblGrdInfo.visible = false
				contMain.grd0.rowcount = #tData
				'그리드 SET
				for i=0 to #tData-1
					'종목 세부 데이터
					'0 종목코드
					'1 종목명
					'2 출고가능수량
					'3 과세구분명
					'4 과세구분코드
					'5 종목유형
					'6 매수수익률
					'7 세금납입구분코드
					'8 분리과세여부
					'9 분리과세신청수량
					'10 매수청구수량
					'11 매수청구포기동의여부
					'----타사 일 경우 추가 데이터----
					'12 매수일자
					'13 고객등급
					'14 요율코드
					'15 수수료
					'16 증권사그룹코드
					'17 OTC구분
					tItem = Split(tData[i], "★")
					contMain.grd0.SetCellData("bd_itemcd"	, i, tItem[0]			)
					contMain.grd0.SetCellData("bd_name"		, i, tItem[1]			)
					contMain.grd0.SetCellData("bd_ableqty"	, i, CDbl(tItem[2])	)
					contMain.grd0.SetCellData("bd_feetype"	, i, tItem[3]			)
					contMain.grd0.SetCellData("bd_feecode"	, i, tItem[4]			)
					contMain.grd0.SetCellData("bd_itmtpcd"	, i, tItem[5]			)
					contMain.grd0.SetCellData("bd_buyrate"	, i, CDbl(tItem[6])	)
					contMain.grd0.SetCellData("bd_taxtp"		, i, tItem[7]			)
					contMain.grd0.SetCellData("bd_taxpaym"	, i, tItem[8]			)
					contMain.grd0.SetCellData("bd_taxpaymqty", i, CDbl(tItem[9])	)
					contMain.grd0.SetCellData("bd_buyable"	, i, CDbl(tItem[10])	)
					contMain.grd0.SetCellData("bd_buygvup"	, i, tItem[11]		)
					contMain.grd0.SetCellData("bd_buydate"	, i, tItem[12]		)
					contMain.grd0.SetCellData("bd_grade"		, i, tItem[13]		)
					contMain.grd0.SetCellData("bd_percode"	, i, tItem[14]		)
					contMain.grd0.SetCellData("bd_feeD"		, i, CDbl(tItem[15])	)	
					contMain.grd0.SetCellData("bd_groupcd"	, i, tItem[16]		)
					contMain.grd0.SetCellData("bd_otc"		, i, tItem[17]		)
					contMain.grd0.SetCellImage("bd_uiqty"	, i,"input_01_n.9.png" )
					contMain.grd0.SetCellData("bd_uiqty"		, i, "수량입력"		)
					contMain.grd0.SetCellFgColor("bd_uiqty"	, i, "98"		 	)
					contMain.grd0.SetCellFgColor("bd_qty"	, i, 0		 		)
				next
				'출금가능금액조회
				DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
				DATAMANAGER.RequestTranData( "obrtp_comn_041r" ) ''20220518 계좌 정상 체크
				f_SetFeeAmt()
			End If
		End If
	'***********************************************
	'************* 수량 입력 팝업 처리 *************
	'***********************************************
	ElseIf sKeyName == "QTY_POPUP" Then	'수량
		Dim nAbleQty, szTaxPaymYN, nTaxPaymQty
		nAbleQty = CInt(contMain.grd0.GetCellData("bd_ableqty", g_nChoiceRow)) '출고가능수량
		szTaxPaymYN = contMain.grd0.GetCellData("bd_taxpaym", g_nChoiceRow) '분리과세여부
		'출고가능수량체크
		If nAbleQty == "" or nAbleQty == null or nAbleQty == 0 Then
			Form.ShowAlert("알림", "출고 가능수량을 확인해주세요.")
			Exit Sub
		End If
		'출고가능수량 이상 입력 체크
		If CInt(sRet) > nAbleQty Then
			Form.ShowAlert("알림", "출고 수량이 출고가능 수량보다 큽니다.")
			Exit Sub
		End If
		'분리과세수량 체크
		If szTaxPaymYN == "Y" Then
			nTaxPaymQty = CInt(contMain.grd0.GetCellData("bd_taxpaymqty", g_nChoiceRow))'분리과세신청수량
			if CInt(sRet) > nTaxPaymQty then
				Form.ShowAlert("알림", "출고대상수량에 분리과세신청 잔고가 존재합니다.\r\n해지 후 처리하시기 바랍니다")
				Exit Sub
			end if
		End If
		'수량 SET
		if CInt(sRet) > 0 then
			contMain.grd0.SetCellData( "bd_uiqty", g_nChoiceRow, FormatNumber(sRet, 0))
			contMain.grd0.SetCellFgColor( "bd_uiqty", g_nChoiceRow, "4" )
			contMain.grd0.SetCellData( "bd_qty", g_nChoiceRow, CDbl(sRet))
		else
			contMain.grd0.SetCellData( "bd_uiqty", g_nChoiceRow, "수량입력")
			contMain.grd0.SetCellFgColor( "bd_uiqty", g_nChoiceRow, "98" )
			contMain.grd0.SetCellData( "bd_qty", g_nChoiceRow, 0)
		end if
	'*************************************************
	'************* 증권사 선택 팝업 처리 *************
	'*************************************************
	ElseIf sKeyName == "RETURN_GROUP" Then
		'sRet : 지점코드★지점명
		if sRet <> "" and sRet <> null then
			dim tData
			tData = Split(sRet, "★")
			'증권사 예외처리
			if tData(0) == "000010" then '당사 코드일때
				contMain.lblCodeName.caption = ""
				Form.ShowAlert("알림", "당사대체는 당사대체출고화면에서 처리가능합니다.")
			else
				'입고계좌 조회 상태에서 입고증권사 다시 선택했을 경우 입고정보 초기화
				BtnProcess.enable = false
				contMain.btnOpen.enable = true
				contMain.imgSearch.enable = true
				contMain.edtAtherAcnt.enable = true
				contMain.edtAtherAcnt.caption = ""
				contMain.lblAcntName.caption = ""
			
				contMain.lblCodeName.caption 	= tData(1) 			'증권사명
				contMain.lblCodeName.fgcolor 	= "95"
				contMain.edtCode.caption 		= tData(0) & "99999" 	'증권사코드
'				f_BeforeCheckAnct()
			end if
		end if
	'***********************************************
	'*********** 보안매체, 공인인증 처리 ***********
	'***********************************************
	ElseIf sKeyName == "mbbnk61100_p4" Then
		if sRet <> "" and sRet <> null then
			if sRet == "ok" then
				f_DisableCtrl()
				f_SetSubmitState()
			else
				Exit Sub
			end if
		end if
	'***********************************************
	'********* 결과 팝업에서 처리내역 이동 *********
	'***********************************************
	ElseIf sKeyName == "mbbnk61100_p5" Then
		if sRet <> "" and sRet <> null then
			if sRet == "move" then
				'타사구분값 전달
				Form.OpenScreen("61120", "H")
			end if
		end if
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then
		Form.OpenFramePopup( "mbbnk61100_p2" , "H", "")
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0, 0, 1 )
		DATAMANAGER.RequestTranData( "obrts_ccfo_009r" )
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ELW_CHK" then
		if sRet == "ok" then '동의
			f_BeforeSubmit()
		else
			Form.ShowAlert("알림", "ELW매매 약정해지 동의가 필요합니다.")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sAcno, sAsno, sPwd, sDate
	sAcno = acnt0.total
	sAsno = acnt0.sequence
	sDate = Form.GetSharedData( "&HOST_DATE", false )
	'비밀번호 암호화
	If g_sPlain_rm == "1" Then
	    sPwd = EdtPswd.caption
	Else
	    sPwd = EdtPswd.encdata
	    if Trim(sPwd) == "" or Trim(sPwd) == null then
		    sPwd = EdtPswd.caption
	    end if
	End If
	
	'출금가능금액 조회
	if szTranID == "obrtp_drab_001r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0, sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0, sASno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_DATE" , 0, sDate )
	'실시간 타사이체 가능 확인 
	elseif szTranID == "obrts_ccfo_002c" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0, sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0, sASno )
	'온라인 타사이체 계확인전문 수신
	elseif szTranID == "obrts_ccfo_009r" then 
		dim sSDRC_TLMS_SRNO, sIssuTypeCode
		sIssuTypeCode = contMain.tblState.GetCellString( 1, 1 )'예탁증권구분코드
		sSDRC_TLMS_SRNO = contMain.tblState.GetCellString( 2, 1 )'송수신일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0, sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0, sASno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEPS_SCRT_CLS_CODE" , 0, sIssuTypeCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SDRC_TLMS_SRNO" , 0, sSDRC_TLMS_SRNO )
	'20220518 계좌 정상 체크
	elseif szTranID == "obrtp_comn_041r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0, sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0, sASno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0, sPwd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SCR_FUNC_CLS_CODE" , 0, "4" ) '4:출고
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_CLS_CODE" , 0, "01" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMCD" , 0, "004020" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_DATE" , 0, Form.GetSharedData("&HOST_DATE", false ))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRMD_CLS_CODE" , 0, "17")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_OCRN_CLS_CODE" , 0, "01")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_NCSR_YN" , 0, "Y") '비밀번호 확인여부
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrts_ccfo_006r" then
		Dim sPROS_ABLE_YN
		sPROS_ABLE_YN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PROS_ABLE_YN" , 0) '증권사 처리가능여부
		
		if sPROS_ABLE_YN == "N" or sPROS_ABLE_YN == "" then
			contMain.tblState.SetCellString( 0, 1, "N" )
		else
			f_CheckAtherAcnt()
			contMain.btnCheckAcnt.enable = true
		end if
	'20220518 계좌 정상 체크
	elseif szTranID == "obrtp_comn_041r" then
		dim sMsgCode, sMsg, sMsgSub, sTR_ABLE_YN
		sTR_ABLE_YN = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TR_ABLE_YN" , 0)) '계좌정상여부
		sMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
		
		if sMsgCode <> "5766" or sTR_ABLE_YN <> "Y" then
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sMsgSub = DATAMANAGER.GetDataMsgSubText( szTranID )
			
			if sMsgCode == "3335" or sMsgCode == "2414" then
				if sMsgSub <> "" and sMsgSub <> null then
					Form.ShowAlert("알림", sMsg &" (" & sMsgSub & ")")
				else
					Form.ShowAlert("알림", sMsg )
				end if
			end if
			
			g_bAcntCheck = false
		end if 
		
		g_bAcntCheck = true
	elseif szTranID == "obrts_ccfo_002c" then
		'온라인 타사출고 가능 여부 조회
		DATAMANAGER.RequestTranData( "obrts_ccfo_009r" )
	elseif szTranID == "obrts_ccfo_009r" then
		dim szResponeCode'응답코드
		szResponeCode = Trim(contMain.tblState.GetCellString(4, 1))
		if Len(szResponeCode) > 0 then'응답수신코드 존재할 때
			if Trim(contMain.tblState.GetCellString( 3, 1 )) == "N" then'처리불가일 때
				Form.removeWaitCursor()	'v001
				if szResponeCode <> "0000" then
					Form.ShowAlert("알림", "입력하신 계좌번호를 다시 확인해주세요.") 
					
					obrts_ccfo_009r_RequestCnt = 0
					contMain.btnCheckAcnt.enable = true
					contMain.btnOpen.enable = true
					contMain.imgSearch.enable = true
					contMain.edtAtherAcnt.enable = true
					BtnProcess.enable = false
					g_bSubmitFlag =  false
					Exit Sub
				else
					Form.ShowAlert("알림", "입력하신 계좌번호를 다시 확인해주세요.")
					g_bSubmitFlag =  false
				end if
			else '정상조회
				obrts_ccfo_009r_RequestCnt = 0
				contMain.btnOpen.enable = true
				contMain.imgSearch.enable = true
				contMain.edtAtherAcnt.enable = true
				dim szOwnAcntType '자기타인구분코드(0:확인불가,1:동일인,2:타인)
				szOwnAcntType = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ONSL_ANPR_CLS_CODE" , 0))
'				szOwnAcntType = "1" 'TEST
				'출고처리 시
				if g_bSubmitFlag == true then
					Dim nRowIdx
					nRowIdx = g_nChkItemCount-1
					contMain.grd0.SetCellData("bd_ccfcustchk", nRowIdx, contMain.tblState.GetCellString( 3, 1 )) '고객확인여부
					contMain.grd0.SetCellData("bd_ownacnt", nRowIdx, szOwnAcntType )
					if g_nChkItemCount < CInt(contMain.grd0.rowcount) then
						g_nChkItemCount = g_nChkItemCount + 1
						f_CheckAbleItem(g_nChkItemCount)
						Form.Toast(0, "출고처리가 진행 중입니다.", false) 'v001
					else
						g_nChkItemCount = 0
						Form.removeWaitCursor()	'v001
						'출고처리
						f_Submit()
					end if
				'타사 계좌 확인 시
				else
					'동일인여부
					if szOwnAcntType == "1" then
						contMain.btnCheckAcnt.enable = true
						contMain.btnOpen.enable = true
						contMain.imgSearch.enable = true
						contMain.edtAtherAcnt.enable = true
						
						dim sAcntNm
						sAcntNm = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "SECO_ACOW_RLTS_NAME", 0 )
						contMain.lblAcntName.caption = sAcntNm
						'20220518 계좌상태체크
						if g_bAcntCheck == true then
							BtnProcess.enable = true
						end if
						
						Form.Toast( 0, "타사계좌 조회가 완료되었습니다.", false )
					else
						Form.ShowAlert("알림", "타인계좌는 처리불가합니다.")
						BtnProcess.enable = false
						contMain.btnOpen.enable = true
						contMain.imgSearch.enable = true
						contMain.edtAtherAcnt.enable = true
						contMain.edtAtherAcnt.caption = ""
						contMain.lblAcntName.caption = ""
						Exit Sub
					end if
				end if
			end if
		else
			'최대 10회 호출
			if obrts_ccfo_009r_RequestCnt < 10 then
				contMain.btnCheckAcnt.enable = false
				contMain.btnOpen.enable = false
				contMain.imgSearch.enable = false
				contMain.edtAtherAcnt.enable = false
				obrts_ccfo_009r_RequestCnt = obrts_ccfo_009r_RequestCnt + 1
				Form.SetTimerEvent( 0, 1, 1 )'1초후 재호출
			else
				contMain.btnCheckAcnt.enable = true
				contMain.btnOpen.enable = true
				contMain.imgSearch.enable = true
				contMain.edtAtherAcnt.enable = true
				g_bSubmitFlag =  false
				Form.removeWaitCursor()	'v001
				obrts_ccfo_009r_RequestCnt = 0
				Form.ShowAlert("알림", "타사계좌 조회가 실패하였습니다.")
			end if
		end if
		
	elseif szTranID == "obrts_ccfo_010a" then
		Dim nItemCnt, nRowIdx, szTranSrno, szRcpySrno
		nItemCnt = CInt(contMain.grd0.rowcount) '처리할 종목 수
		nRowIdx  = obrts_ccfo_010a_RequestCnt'현재 처리진행 중인 행
		szTranSrno = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TRAN_SRNO", 0 ))
		szRcpySrno = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RCPY_SRNO", 0 ))
		'거래내역일련번호
		if szTranSrno <> "" then
			contMain.grd0.SetCellData( "bd_transrno", nRowIdx, szTranSrno )
		end if
		'출납일련번호
		if szRcpySrno <> "" then
			contMain.grd0.SetCellData( "bd_rcpysrno", nRowIdx, szRcpySrno )
		end if
		
		dim szTranMsgCode, szTranMag, szUIMsgText
		szTranMsgCode = Trim(DATAMANAGER.GetDataMsgCode( szTranID ))
		szTranMag = DATAMANAGER.GetDataMsgText( szTranID )
'		Form.ShowAlert(szTranMsgCode, szTranMag)
		contMain.grd0.SetCellData( "bd_resultcd", nRowIdx, szTranMsgCode )
		if szTranMsgCode <> "6620" and szTranMsgCode <> "7076" and szTranMsgCode <> "8762" then
			dim szTranSubMsg
			szTranSubMsg = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
			if szTranSubMsg == "" or szTranSubMsg == null then
				szUIMsgText = szTranMag
			else
				szUIMsgText = szTranMag & "(" & szTranSubMsg & ")"
			end if
		else
			szUIMsgText = szTranMag
		end if
		'예외처리
		if szTranMsgCode == "7076" then
			Form.ShowAlert("알림", "거액승인신청이 반드시 필요합니다.")
			BtnProcess.enable = false
			Exit Sub
		elseif szTranMsgCode == "8762" then
			Form.ShowAlert("알림", "타점 출고승인신청이 필요합니다.")
		elseif szTranMsgCode == "3335" or szTranMsgCode == "2414" then
			Form.ShowAlert("알림", szTranMag)
		end if
		'처리완료/불가 
		if szTranMsgCode == "6620" then
			g_nSuccCnt = g_nSuccCnt + 1
			contMain.grd0.SetCellData( "bd_msg", nRowIdx, "완료")
			contMain.grd0.SetCellData( "bd_errormag", nRowIdx, szUIMsgText )
		else
			g_nFailCnt = g_nFailCnt + 1
			contMain.grd0.SetCellData( "bd_msg", nRowIdx, "처리불가")
			contMain.grd0.SetCellData( "bd_errormag", nRowIdx, szUIMsgText )
		end if
		'다음 종목 행 처리
		f_Submit()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szTranID <> "obrts_ccfo_010a" then
	    Form.removeWaitCursor()	'v001
	
	    If Trim(szSubMsg) == "" Or Trim(szSubMsg) == Null Then
	        Form.ShowAlert( "알림", szErrMsg )
	    Else
	        Form.ShowAlert( "알림", szErrMsg & "\n" & "(" & szSubMsg & ")" )
	    End If
		
	elseif szTranID == "obrts_ccfo_010a" then
		Dim nRowIdx
		nRowIdx  = obrts_ccfo_010a_RequestCnt'현재 처리진행 중인 행
		if szErrCode <> "" and szErrCode <> null then
			contMain.grd0.SetCellData( "bd_resultcd", nRowIdx, szErrCode )
			contMain.grd0.SetCellData( "bd_msg", nRowIdx, "처리불가")
			
			if szSubMsg <> "" and szSubMsg <> null then
				contMain.grd0.SetCellData( "bd_errormag", nRowIdx, szErrMsg & "\n" & "(" & szSubMsg & ")")
			else
				
				contMain.grd0.SetCellData( "bd_errormag", nRowIdx, szErrMsg  )
			end if
		end if
		'처리실패 카운트 추가
		g_nFailCnt = g_nFailCnt + 1
		'다음 종목 행 처리
		f_Submit()
	end if
	
End Sub

