Sub contMain_btnAddPopup_OnClick()
	dim sAcno, sAsno, sType
	sAcno = acnt0.total
	sAsno = acnt0.sequence
	sType = "H" '당사/타사 구분
	'잔고팝업 호출
	Form.OpenFramePopup("mbbnk61100_p1", sAcno & "★" & sAsno & "★" & sType , "")
End Sub

