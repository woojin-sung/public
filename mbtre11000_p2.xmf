Dim g_tData
Dim g_szCode

'============================================================================
Sub Form_OnFormInit()
	grd1.setUseCardView(true, 10, "img_bgbox_gray.9")
	grd1.SetCellData("bd_cell0", 0, "A. 예수금 합")
	grd1.SetCellData("bd_cell2", 0, "B. 결제예정금액")
	grd1.SetCellData("bd_cell4", 0, "C. 미수금")
	grd1.SetCellData("bd_cell6", 0, "D. 평가손익")
	'grd1.SetCellData("bd_cell8", 0, "E. (최초매입기준 평가손익)")
'	grd1.SetCellData("bd_cell10", 0, " (최초매입기준 평가손익)")
	tbl0.SetCellString(0, 0, " (최초매입기준 평가손익)")
	
	grd1.scrollenable = "0"
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("11", szOpenData)
		g_tData = Split(szOpenData, "☆")
		
		if Ubound(g_tData) > 0 then
			szTmpData = Split(g_tData[4], "@")
			szTmpInfo = Split(g_tData[5], "@")
		end if
		
		sMask = "1,0,,,0,,"..g_tData[6]..",1,1,2,0"
		
		lblTitle2.mask = sMask
		grd1.SetCellIDMaskInfo("bd_cell1", sMask)
		grd1.SetCellIDMaskInfo("bd_cell3", sMask)
		grd1.SetCellIDMaskInfo("bd_cell5", sMask)
		grd1.SetCellIDMaskInfo("bd_cell7", sMask)
		tbl0.SetCellMaskInfo(0, 1, sMask)
		
		lblTitle2.caption = g_tData[0]
		grd1.SetCellData("bd_cell1", 0, g_tData[1])
		grd1.SetCellData("bd_cell3", 0, g_tData[2])
		grd1.SetCellData("bd_cell5", 0, g_tData[3])
		grd1.SetCellData("bd_cell7", 0, szTmpData[0])
		grd1.SetCellFgColor("bd_cell7", 0, szTmpData[1])
		
		'grd1.SetCellData("bd_cell9", 0, g_tData[5])
		tbl0.SetCellString(0, 1, szTmpInfo[0])
		tbl0.SetCellFgColor(0, 1, szTmpInfo[1])
'		lblName.caption = g_tData[0]
'		
'		tbl0.SetCellString(0, 2, g_tData[1])
'		
'		tbl1.SetCellString(0, 1, g_tData[2])
'		tbl1.SetCellString(1, 1, g_tData[3])

'		If CDbl(g_tData[4]) > 0 Then
'			grd1.SetCellFgColor("bd_cell7", 0, "10")
'		ElseIf CDbl(g_tData[4]) < 0 Then
'			grd1.SetCellFgColor("bd_cell7", 0, "11")
'		Else
'			grd1.SetCellFgColor("bd_cell7", 0, "12")
'		End If
'		
'		tbl3.SetCellString(0, 1, g_tData[5])
'		tbl3.SetCellString(1, 1, g_tData[6])
'		tbl3.SetCellString(2, 1, CDbl(g_tData[7]))
	End If
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

