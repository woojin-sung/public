'============================================================================


'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 1 then
		if Form.GetSharedData("check_flag_1", false ) == "0" then
			FormTab0.currenttab = 0 
			Form.Toast(0, "입력하지 않은 항목이 있습니다.", 0.5)
			
		end if
		
		
		
	elseif nCurrentTab == 2 then
		if Form.GetSharedData("check_flag_2", false ) == "0" then
			FormTab0.currenttab = 1 
			Form.Toast(0, "입력하지 않은 항목이 있습니다.", 0.5)
			
		end if
		
	elseif nCurrentTab == 3 then
		if Form.GetSharedData("check_flag_3", false ) == "0" then
			FormTab0.currenttab = 2 
			Form.Toast(0, "입력하지 않은 항목이 있습니다.", 0.5)
			
		end if
		
		
	elseif nCurrentTab == 4 then
		if Form.GetSharedData("check_flag_4", false ) == "0" then
			FormTab0.currenttab = 0 
			Form.Toast(0, "입력하지 않은 항목이 있습니다.", 0.5)
			
		end if
	
		
	
	
	end if 
End Sub

