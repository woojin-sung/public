		<BUTTON name="ButtonOK" enable="0" visible="0" ly_vert="16,149,40,26,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="5284" _ulen="4792" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_보안카드
' 02. 화면설명 : 이체예정내역 보안카드 연결화면
' 03. 작    성 : 2016.03.11 염준성
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_520r,obcsb_simf_000r IO 변경분 반영, 미사용TR ohhts_ocsp_001r 제거
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID
Dim g_sBioCertYn
Dim g_sSecCardCertYn
Dim g_sBioTrData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	
	g_sBioCertYn = "N"
	g_sSecCardCertYn = "N"
	g_sRetData = "cancel"
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if

	'Form.SetScreenName( "보안매체 인증" )

	if g_sUserID ~= null and g_sUserID ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
	g_sBioTrData = ""
	g_sBioTrData = Form.GetSharedData("BIO_TR_MSG_1", false )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'보안카드상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
	
		if sRSLT_CLS == "0" then '보안카드
			if sSCRC_STAT_CODE == "0" then '정상
				'ButtonOK.enable = true
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
	end if
End Sub

'============================================================================
Sub BioCertCall()
	sBIO_TR_CODE = "1"                                       '바이오거래유형코드 0: 인증 1: 서명 
	sATHN_USAG_CLS_CODE = "0"								' 서명데이터 생성여부
	
    sTRAN_CNTT = g_sBioTrData
    
    sData = "BIO_trType★"& sBIO_TR_CODE  &"★"&  sTRAN_CNTT &"★"& sATHN_USAG_CLS_CODE 


	'Form.OpenPopup("mhetc90060_p5", sData, "")
	'MsgBox sData
	Form.OpenFramePopup("mhetc90060_p5" , sData , "")
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	BioCertCall()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "이체확인" then

		ButtonOK_OnClick()  
	end if   
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg ~= "" or szErrMsg ~= Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	Form.ShowAlert( "알림", szErrMsg)
End Sub

'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	If sKeyName == "mhetc90060_p5" Then
		If sRet == "ok" Then
		'MsgBox( "바이오 succ return")
			g_sBioCertYn = "Y"
			Form.triggerEvent("#", "바이오인증", "Success")
		ElseIf sRet == "cancel" Then
			g_sBioCertYn = "N"			
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If	
End Sub



