'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		Label0.caption = Left(tData(0),4)&"-"&Mid(tData(0),5,4)&"-"&Right(tData(0),2)
		Label1.caption = Left(tData(1),4)&"."&Mid(tData(1),5,2)&"."&Right(tData(1),2)
		Label2.caption = tData(2)
	end if
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.OpenScreen("88026", "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl88026_p7" ,  "close")
End Sub

