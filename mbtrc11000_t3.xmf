'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리
Dim g_szData
Dim g_szItemCode
'============================================================================
' TR_Inquiry()
'============================================================================
Function TR_Inquiry()
	Dim nAcNo, nAsNo
	nAcNo = Form.GetCtlProp("#acnt0", "total")
	nAsNo = Form.GetCtlProp("#acnt0", "sequence")
	'Test 계좌
'	nAcNo = "30158194"
'	nAsNo = "02"

	Dim DEAL_CLS_CODE, NEW_CLRN_CLCD, CNTG_CLS_CODE
	
	if rdoMedosu.currentindex = 1 or rdoMedosu.currentindex = "1" then ' 매수
		DEAL_CLS_CODE = "2"
	Elseif rdoMedosu.currentindex = 2 or rdoMedosu.currentindex = "2" then ' 매도
		DEAL_CLS_CODE = "1"
	Else
		DEAL_CLS_CODE = "%"
	End if
	
	if rdoNEW.currentindex = 1 or rdoNEW.currentindex = "1" then ' 신규
		NEW_CLRN_CLCD = "1"
	Elseif rdoNEW.currentindex = 2 or rdoNEW.currentindex = "2" then ' 청산
		NEW_CLRN_CLCD = "2"
	Else
		NEW_CLRN_CLCD = "%"
	End if
	
	if rdoCNTG.currentindex = 1 or rdoCNTG.currentindex = "1" then ' 체결
		CNTG_CLS_CODE = "1"
	Elseif rdoCNTG.currentindex = 2 or rdoCNTG.currentindex = "2" then ' 미체결
		CNTG_CLS_CODE = "2"
	Else
		CNTG_CLS_CODE = "%"
	End if
	
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "ACNO", 0 , nAcNo)
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "ASNO", 0 , nAsNo)
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "DEAL_CLS_CODE", 0 , DEAL_CLS_CODE )
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "NEW_CLRN_CLCD", 0 , NEW_CLRN_CLCD )
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "CNTG_CLS_CODE", 0 , CNTG_CLS_CODE )
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "UI_SORT_CLS_VAL", 0 , "2")
	DATAMANAGER.RequestTranData("obtrc_cntg_001r")
	
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
'	TR_Inquiry()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "RECEIVE" Then
		TR_Inquiry()
		
	ElseIf sEventName == "CHANGE_ACCTNO" Then
		TR_Inquiry()
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert(szTranID, szErrMsg)
End Sub

'============================================================================
Sub rdoCNTG_OnClick(nIndex)
	TR_Inquiry()
End Sub

'============================================================================
Sub rdoMedosu_OnClick(nIndex)
	TR_Inquiry()
End Sub

'============================================================================
Sub rdoNEW_OnClick(nIndex)
	TR_Inquiry()
End Sub

'============================================================================


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		if szListItems(1) = "0"	then	'현재가
			Form.OpenScreen("13100" , g_szItemCode & "★" & "0") 
		elseif szListItems(1) = "1"	then	'정정
			Form.OpenScreen("13200" , "미체결" & "★" & "3" & "★" & g_szData ) 
		elseif szListItems(1) = "2"	then	'취소
			Form.OpenScreen("13200" , "미체결" & "★" & "3" & "★" & g_szData ) 
		end if
		
		g_szData = ""
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket

	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrc_cntg_001r" then	
		For iCnt = grd0.rowcount - 1 To 0 Step -1
			szItem = grd0.GetCellData( "bd_Cd", iCnt)
			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
'			If szMarket = "BN" or szMarket = "MM" Then
'				grdList.SetDeleteRow( iCnt )
'			Else
			
				'매매구분
				szData = grd0.GetCellData( "bd_TypeCd", iCnt)
				szData2 = grd0.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
						
				If szData2 = "2" Then								'정정
					If szData = "1" Then
						grd0.SetCellData("bd_TypeNm", iCnt, "매도정정")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellData("bd_TypeNm", iCnt, "매수정정")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
					
				ElseIf szData2 = "3" Then								'취소
					If szData = "1" Then
						grd0.SetCellData("bd_TypeNm", iCnt, "매도취소")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellData("bd_TypeNm", iCnt, "매수취소")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
					End If
					
				Else
					If szData = "1" Then
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
				End If
				
				'처리구분
				szData = grd0.GetCellData( "bd_ProcCd", iCnt)
				
				Select Case szData
					Case "0" grd0.SetCellData("bd_ProcNm", iCnt, "미접수")
					Case "1" grd0.SetCellData("bd_ProcNm", iCnt, "접수")
					Case "2" grd0.SetCellData("bd_ProcNm", iCnt, "확인")
					Case "3" grd0.SetCellData("bd_ProcNm", iCnt, "거부")
					Case "4" grd0.SetCellData("bd_ProcNm", iCnt, "PT효력정지")
				End Select
'			End If
		Next
	end if
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemCode, szOdrNo, szQty, szOdrType, szOdrPrc, szClsCd
	Dim szCutCd, szMk, szSvcTp
	
	listLocation =  Split(grd0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
		
	sPopupType = "4"
	
	szItemCode	= grd0.GetCellData("bd_Cd", lRow)
	szOdrNo		= grd0.GetCellData("bd_cell1", lRow)
	szQty		= grd0.GetCellData("bd_cell7", lRow)
	szOdrType	= grd0.GetCellData("bd_cell15", lRow)
	szOdrPrc		= grd0.GetCellData("bd_cell4", lRow)
	szClsCd		= ""
	szSvcTp		= grd0.GetCellData("bd_TypeCd", lRow)
	szSvcNmTp	= grd0.GetCellData("bd_cell3", lRow) '신규/청산
	
	g_szItemCode = szItemCode
	szMk = Form.GetItemCodeInfo(szItemCode, "market")
	
	If Trim(szMk) = "J" or Trim(szMk) = "Q" or Trim(szMk) = "W" or Trim(szMk) = "T" then
		' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격
		' 전달내용, 탭위치는 리턴받아서 처리함.	
		g_szData = szItemCode & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd & "♥" & szSvcTp & "♥" & szSvcNmTp
	
		If CInt( szQty ) > 0 Then
			Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "미체결수량: " & CInt( szQty ) & "★" & "정정" & "★" & "취소" & "★" & "" & "★" & "" & "★" & szItemCode)	
		End If
	Else
		' 20160310 주문불가한 종목 예외처리
		szCutCd = Mid(szItemCode, 2, Len(szItemCode))
		szMk = Form.GetItemCodeInfo(szCutCd, "market")		
		
		If Trim(szMk) = "J" or Trim(szMk) = "Q" or Trim(szMk) = "W" or Trim(szMk) = "T" then
			' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
			' 전달내용, 탭위치는 리턴받아서 처리함.	
			g_szData = szCutCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd & "♥" & szSvcTp & "♥" & szSvcNmTp
		
'			If CInt( szQty ) > 0 Then
				Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "미체결수량: " & CInt( szQty ) & "★" & "정정" & "★" & "취소" & "★" & "" & "★" & "" & "★" & szItemCode)	
'			End If
		Else
			Form.ShowAlert(g_szTitle, "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
		End if
	End If
End Sub


'============================================================================
Sub grd0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obtrc_cntg_001r" )
	
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obtrc_cntg_001r" )
		
	end if
End Sub

