	<SCRIPT_INFO _len="637" _ulen="597" >
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOk_OnClick()
	if rdo1.currentindex ~= "0" and rdo1.currentindex ~= "1" then
		Form.MsgBox("알림", "투자설명서 전자교부 여부를 확인해주세요.", "", 6)
		return
	end if
	
	'Form.SendReturnToParent("mbonl83110_p3" , "ok")
	Form.SendReturnToParent("mbonl83110_p3" , rdo1.currentindex)
	
	Form.CloseForm()

End Sub

