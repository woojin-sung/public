				<CELL cell_ly="0,1,1,1" halign="0" line="0,0" caption="자본시장과 금융투자업에 관한 법률 제123조에 의거하여, 당사" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,2,1,2" halign="0" line="0,0" caption="는 투자설명서를 교부할 의무가 있습니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,3,1,3" halign="0" line="0,0" caption="따라서, 해당 증권 청약시 투자설명서 교부의사를 선택하셔야만" fontsize="-2" impidxs="" />
