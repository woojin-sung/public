'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'주문 환경
Dim g_szOdrPop

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit

' 주문후 
Dim g_szAfterOrg

'20170726 HAMWG : 수량 연동위한 미체결팝업 리턴여부 플래그
Dim g_szMicheQty
g_szMicheQty = false

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szTitle
g_szTitle = "알림"

Dim g_szQty
g_szQty = ""

Dim g_bCntrtRtn		' 미체결리턴
g_bCntrtRtn = false


'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	if g_bCntrtRtn == false then
		edtOrgNo.caption = ""
	end if
	
	g_szQty = ""
	edtQty.caption = ""
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화	
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170726 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170726 HAMWG END
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if	
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if

	if Trim(edtOrgNo.caption) == "" then
		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
		return false
	end if
	
	if chkAll.checkstate == "0" then		' 일부잔량 선택시
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if
	
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order(0)
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
	szAbleCd = Return_OrderAbleCd(g_szCd) 

	if szAbleCd = "1" then
		Form.ShowAlert("안내", "해당종목은 MTS 거래 불가 종목입니다.")
		exit Function
	end if
	'20240111 HWG END
	
	Dim szData
	
	szData = "3"															' 매매구분
'	szData = szData & "|" & g_szMk											' 시장구분
	szData = szData & "|" & Form.GetCtlProp("#acnt", "caption")					' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname")				' 계좌명
	szData = szData & "|" & g_szCd											' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")				' 종목명
	szData = szData & "|" & ""												' 주문구분
	szData = szData & "|" & ""												' 주문가격	
	szData = szData & "|" & edtQty.caption									' 주문수량
	szData = szData & "|" & edtOrgNo.caption									' 원주문번호
	szData = szData & "|" & chkAll.checkstate								' 전량전부
	
	if Trim(szWarn) <> "" then
		szData = szData & "|" & szWarn										' 경고메세지
		
		Form.OpenPopup("mbtrf31050_p6", szData , "")		' 경고팝업 오픈
	else
		Form.OpenPopup("mbtrf31050_p5", szData , "")		' 주문확인팝업 오픈
	end if
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order(nGbn)
	if nGbn == 1 then
		g_szWarnFlag = "Y"
	else
		g_szWarnFlag = "N"
	end if
	
	'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
	szAbleCd = Return_OrderAbleCd(g_szCd) 
	
	if szAbleCd <> "1" then
		DATAMANAGER.RequestTranData("obtrf_oder_101c")			' 선물옵션주문
	else
		Form.ShowAlert("안내", "해당종목은 MTS 거래 불가 종목입니다.")
	end if
	'20240111 HWG END
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CInt(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CInt(szQty) + nUnit
		elseif nGbn == 1 then
			if CInt(szQty) == 0 then
				Exit Function
			else
				szQty = CInt(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "♥")		
		
	if UBound(tData) > 0 then
		' 메인화면에서 종목변경에 따른 구분자를 넣어준것
		if tData(5) == "1" then
			g_bCntrtRtn = true
		else
			g_bCntrtRtn = false
		end if

		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", tData(0))
		end if
		
		edtOrgNo.caption = tData(0)						' 주문번호	
		g_szQty = ""
		
		' 수량
		if chkAll.checkstate == "1" then
			edtQty.caption = ""						
			g_szQty = tData(1)
		else
			edtQty.caption = tData(1)
			g_szQty = tData(1)
		end if
		
		edtType.caption  = tData(2)		' 호가유형코드
		
		if Trim(tData(4)) == "" then
			edtClsCd.caption = "0"
		else
			edtClsCd.caption = tData(4)		' 주문구분코드
		end if
	end if
End Function

'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
'============================================================================
' Return_OrderAbleCd
'============================================================================
Function Return_OrderAbleCd(szCd) 
	szReturn = "0"
	
	szMkType = Form.GetItemCodeInfo(szCd, "innermarket")
	
	if szMkType = "054" or szMkType = "055" then
		if szCd <> null and szCd <> "" and Len(szCd) > 3 then
			szCdType = mid(szCd, 2, 2)
			
			if szCdType = "78" then
				szReturn = "1"
			end if
		end if
	end if
	
	return szReturn
End Function
'20240111 HWG END


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기 
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
	chkAll_OnChange("1")
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------
	if sEventName == "INIT_CODE" then		' 메인화면에서 종목코드 받기
		if g_szCd == sParam then
			if g_szChangeInit == "1" then
				Form.SetCtlProp("#edtOrgNo", "caption", "")
			else
				edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
			end if
			
			g_bCntrtRtn = false
		else	
			if g_bCntrtRtn == false then
				Form.SetCtlProp("#edtOrgNo", "caption", "")
				edtOrgNo.caption = ""
			else
				if g_szChangeInit == "1" then
					Form.SetCtlProp("#edtOrgNo", "caption", "")
				else
					Form.SetCtlProp("#edtOrgNo", "caption", edtOrgNo.caption)
				end if
			end if
			
			g_szCd = sParam
			g_szMk = Form.GetItemCodeInfo(g_szCd, "market")
			
			'20170726 HAMWG START : 잔고팝업에서 리턴시 수량 세팅 유지
			if g_szMicheQty <> true then
				if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
					Init_InputControl()
				end if
			end if
			g_szMicheQty = false
			'20170726 HAMWG END		
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 탭 체인지
	' ----------------------------------------------------------------------
	elseif sEventName == "CHANGE_TAB" then	
		edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		g_szCd = sParam
		g_szMk = Form.GetItemCodeInfo(g_szCd, "market")
			
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if	
	' ----------------------------------------------------------------------
	' 주문번호 연동
	' ----------------------------------------------------------------------			
	elseif sEventName == "AFTER_ORGNO" then		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		end if
	' ----------------------------------------------------------------------
	' 미체결팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------		
	elseif sEventName == "31030_CONTRACT_RETURN" then
		if sParam == "" then
			Exit Sub
		end if
		g_szMicheQty = true		'20170726 HAMWG : 미체결팝업 리턴 플래그 세팅
		Return_ContractScreen(sParam)
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			Request_Order(1)	
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order(0)	
		end if	
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAll, szQty
	
	' 잔량전부 여부
	if chkAll.checkstate == "1" then
		szAll = "Y"
		szQty = g_szQty
	else
		szAll = "N"
		szQty = edtQty.caption
	end if

	' ----------------------------------------------------------------------
	' 선물옵션위탁주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_oder_101c" then
		DATAMANAGER.ClearInputData(0, "obtrf_oder_101c")
		
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "SVC_CLS_CODE"		, 0, "104")								' 서비스구분코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))	' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ISCD"				, 0, "K" & g_szCd)						' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODER_COND_CLS_CODE"	, 0, edtClsCd.caption)						' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ASPR_TYPE_CODE"		, 0, edtType.caption)						' 호가유형코드 
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODQT"				, 0, edtQty.caption)						' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "PGM_ASPR_CLS_CODE"	, 0, "00")								' 프로그램 호가 구분코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)						' 경고확인여부
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ORGL_ODER_NO"		, 0, edtOrgNo.caption)						' 원주문번호
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "WHOL_RCTF_CNCL_YN"	, 0, szAll)								' 전체 취소 취소여부
	end if
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szOdrMsg
	
	' ----------------------------------------------------------------------
	' 선물옵션위탁주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_oder_101c" then
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_MSG_CNTT", 0)
		
		if szWarnCd = "1" then							' 경고
			Open_ConfirmPopup(szWarnMsg)
		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) == "0001" then
				if g_szAfterInit == "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				Form.Toast(0, szOrdMsg, true)
			end if
		end If
	end if
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	' ----------------------------------------------------------------------
	' 선물옵션위탁주문(주문에러는 초기화 안함 : 20160314 전요셉과장)
	' ----------------------------------------------------------------------	
'	if szTranID == "obtrf_oder_101c" then	
'		if g_szAfterInit == "1" then		' 주문후 초기화
'			Init_InputControl()
'		end if		
'	end if
End Sub

'============================================================================
' btnCnl_OnClick : 취소버튼 클릭
'============================================================================
Sub btnCnl_OnClick()
	Check_InputData(0)
End Sub

'============================================================================
' btnMiche_OnClick : 미체결버튼 클릭
'============================================================================
Sub btnMiche_OnClick()
	Form.triggerEvent("#", "31030_CONTRACT_OPEN", "")
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAll_OnChange(sCheckState)
	if sCheckState == "1" then
		edtQty.caption = ""	
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		edtQty.caption = g_szQty	
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	Form.OpenPopup("mbtrf31030_p1", edtQty.caption, "")
End Sub


