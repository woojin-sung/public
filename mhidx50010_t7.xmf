	<SCRIPT_INFO _len="20030" _ulen="19126" >
'============================================================================
' 01. 화 면 명 : HOME_업계동향
' 02. 화면설명 : 업계동향_해외
' 03. 작    성 : 
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szNation
Dim g_szMarket

g_szNation = "US"
g_szMarket = ""

' 수치값
Dim g_nGap
g_nGap = 3


'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	Image3.setMaintainingRatio("1")
	
	'0802
	imgNoneUP.setmaintainingratio("1")
	imgNoneDown.setmaintainingratio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		fmtab0.setTabDefaultImage("tab_03_o.9","alpha.9")
	else
		fmtab0.setTabHeaderImage("tab_00_o.9","alpha", 0)
	end if
	
	'------------------------------------------
	'2024086 초기탭 인덱스 지정
	'------------------------------------------
	nCurrentTab = GetTabIndexWithNationAndMarket()
	
	fmtab0.currenttab = nCurrentTab
	call fmtab0_OnTabChanged(nCurrentTab)

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if	szTranID	=	"ohhts_6250_010r"	then
		DATAMANAGER.ClearInputData(0, "ohhts_6250_010r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_6250_010r", "InBlock1", "FIDX_NTNL_CODE" 	, 0 , g_szNation ) 
		DATAMANAGER.SetDataValue(0, "ohhts_6250_010r", "InBlock1", "FIDX_EXCH_CODE" 	, 0 , g_szMarket )  
		DATAMANAGER.SetDataValue(0, "ohhts_6250_010r", "InBlock1", "FID_SORT_CLS" 	, 0 , "1") 
		
	elseif	szTranID	=	"ohhts_6250_010r_1"	then
		DATAMANAGER.ClearInputData(0, "ohhts_6250_010r_1")
		
		DATAMANAGER.SetDataValue(0, "ohhts_6250_010r_1", "InBlock1", "FIDX_NTNL_CODE" , 0 , g_szNation ) 
		DATAMANAGER.SetDataValue(0, "ohhts_6250_010r_1", "InBlock1", "FIDX_EXCH_CODE" , 0 , g_szMarket )  
		DATAMANAGER.SetDataValue(0, "ohhts_6250_010r_1", "InBlock1", "FID_SORT_CLS" 	, 0 , "2") 
		
	end	if
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	if CInt(nCurrentTab) = 0 then
		g_szNation = "US"
		g_szMarket = ""
	elseif CInt(nCurrentTab) = 1 then
		g_szNation = "CN"
		g_szMarket = "SH"
	elseif CInt(nCurrentTab) = 2 then
		g_szNation = "CN"
		g_szMarket = "SZ"
	elseif CInt(nCurrentTab) = 3 then
		g_szNation = "HK"
		g_szMarket = ""
	elseif CInt(nCurrentTab) = 4 then
		g_szNation = "JP"
		g_szMarket = ""
	end	if
	
	TR_Before()
	TR_Request()
	
End Sub

'============================================================================
Sub TR_Request()

	DATAMANAGER.RequestTranData("ohhts_6250_010r")

End Sub

'============================================================================
Sub TR_Before()

	'0802
	imgNoneUP.visible = false
	lblNoneUP.visible = false
	imgNoneDown.visible = false
	lblNoneDown.visible = false
	
	grdMain01T1.SetClear()
	grdMain01T0.SetClear()
	grdMain01T1.rowcount = 0
	grdMain01T0.rowcount = 0
	
	PannelUp0.rowcount = 0
	PannelUp1.rowcount = 0
	PannelDown0.rowcount = 0
	PannelDown1.rowcount = 0
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	IF szTranID = "ohhts_6250_010r" then
		DATAMANAGER.RequestTranData("ohhts_6250_010r_1")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "ohhts_6250_010r" then		'등락률 상위 조회
		dim nCntUp, nCntUp0, nTemp
		dim szCode, szName, szData
		
		nCntUp  = CDBl(DATAMANAGER.GetDataCount(0, "ohhts_6250_010r" , "OutBlock1"))
		
		'------------------------------------------------
		'20240621 LES START - 등락률 0이상인 종목만 가려냄
		'------------------------------------------------
		Dim nRealUpCnt
		nRealUpCnt = 0
		for i = 0 to nCntUp - 1 
			sCtrt = CDBl(DATAMANAGER.GetDataValue(0, "ohhts_6250_010r", "OutBlock1", "FIDX_SDPR_CTRT" , i))
			
			if sCtrt >= 0 then
				nRealUpCnt = nRealUpCnt + 1
			end if
			
		next
		
		nCntUp = nRealUpCnt
		'------------------------------------------------
		'20240621 LES END
		'------------------------------------------------
		
		nCntUp0 = 0
		
		grdMain01T1.rowcount = nCntUp		'상승 개수
		
		if CInt(nCntUp) > 1 then
			nTemp = CInt(nCntUp / 2)
			nCntUp0 = nCntUp - nTemp
			nCntUp = nTemp
		end if
		
		'상승판넬 세팅
		for i = 0 to CInt(nCntUp)-1
			szCode = grdMain01T1.GetCellData("bd_code", i)
			szName = grdMain01T1.GetCellData("bd_name", i)
			szData = grdMain01T1.GetCellData("bd_data", i)
			
			UIsetting_Up0(i, szCode, szName, szData)		'상승판넬 위
		next
		
		for j = CInt(nCntUp) to CInt(grdMain01T1.rowcount)-1
			szCode = grdMain01T1.GetCellData("bd_code", j)
			szName = grdMain01T1.GetCellData("bd_name", j)
			szData = grdMain01T1.GetCellData("bd_data", j)

			UIsetting_Up1(j, szCode, szName, szData)		'상승판넬 아래
		next
		
		'데이터 없을 때 처리 - 0802
		if CInt(PannelUp0.rowcount) = 0 then
			imgNoneUP.visible = true
			lblNoneUP.visible = true
		end if
		
	elseif szTranID = "ohhts_6250_010r_1" then	'등락률 하위 조회
		dim nCntDown, nCntDown0, nTemp
		dim szCode, szName, szData
		
		nCntDown  = CDBl(DATAMANAGER.GetDataCount(0, "ohhts_6250_010r_1" , "OutBlock1"))
		
		'------------------------------------------------
		'20240621 LES START - 등락률 0미만인 종목만 가려냄
		'------------------------------------------------
		Dim nRealDownCnt
		nRealDownCnt = 0
		for i = 0 to nCntDown - 1 
			sCtrt = CDBl(DATAMANAGER.GetDataValue(0, "ohhts_6250_010r_1", "OutBlock1", "FIDX_SDPR_CTRT" , i))
			
			if sCtrt < 0 then
				nRealDownCnt = nRealDownCnt + 1
			end if
			
		next
		
		nCntDown = nRealDownCnt
		'------------------------------------------------
		'20240621 LES END
		'------------------------------------------------
		
		nCntDown0 = 0
		grdMain01T0.rowcount = nCntDown		'하락 개수

		if CInt(nCntDown) > 1 then
			nTemp = CInt(nCntDown / 2)
			nCntDown0 = nCntDown - nTemp
			nCntDown = nTemp
		end if
		
		'하락판넬 세팅
		for i = 0 to CInt(nCntDown)-1
			szCode = grdMain01T0.GetCellData("bd_code", i)
			szName = grdMain01T0.GetCellData("bd_name", i)
			szData = grdMain01T0.GetCellData("bd_data", i)

			UIsetting_Down0(i, szCode, szName, szData)	'하락판넬 위
		next
		
		for j = CInt(nCntDown) to CInt(grdMain01T0.rowcount)-1
			szCode = grdMain01T0.GetCellData("bd_code", j)
			szName = grdMain01T0.GetCellData("bd_name", j)
			szData = grdMain01T0.GetCellData("bd_data", j)

			UIsetting_Down1(j, szCode, szName, szData)	'하락판넬 아래
		next
		
		'데이터 없을 때 처리 - 0802
		if CInt(PannelDown0.rowcount) = 0 then
			imgNoneDown.visible = true
			lblNoneDown.visible = true
		end if
		
	end if 

End Sub

'============================================================================
Function UIsetting_Up0(nIndex, szCode, szName, szData)
	
	'판넬 데이터 세팅
	PannelUp0.AddRow()
	PannelUp0.setPropCardCell("paddinginfo","lblName",nIndex,"0,0,0,0")
	PannelUp0.setPropCardCell("paddinginfo","lblData",nIndex,"0,0,0,0")
			
	PannelUp0.setPropCardCell("caption","lblName",nIndex, szName)
	PannelUp0.setPropCardCell("caption","lblData",nIndex, szData)
			
	nNameWidth = CDBl(Form.getTextWidth(szName, -2, false, false)) + 10
	nDataWidth = CDBl(Form.getTextWidth(szData.."%", -2, true, false))
	
	PannelUp0.setPropCardCell("left", "lblName", nIndex, 10)
	PannelUp0.setPropCardCell("width", "lblName", nIndex, nNameWidth)
	
	PannelUp0.setPropCardCell("left", "lblData", nIndex, nNameWidth + 10)
	PannelUp0.setPropCardCell("width", "imgbg", nIndex, nNameWidth + nDataWidth + 20)
	PannelUp0.SetCardWHAt(nIndex, nNameWidth + nDataWidth + 25)
			
	'실시간 인블럭 세팅
	PannelUp0.SetCellValue("lblCode", nIndex, szCode)

	
End Function

'============================================================================
Function UIsetting_Up1(nIndex, szCode, szName, szData)
	
	'판넬 데이터 세팅
	PannelUp1.AddRow()
