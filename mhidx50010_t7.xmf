	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="ohhts_6250_010r" trcode="ohhts_6250_010r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="ohhts_6250_010r_1" trcode="ohhts_6250_010r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="ohhts_6250_010r" title="업종리스트 + (전일대비율)" realdata="0" dessvr="5" >
				<TRBLOCK name="InBlock1" inout="in" _len="147" _ulen="121" >

FIDX_NTNL_CODE^FIDX국가코드^2^0^0^0^0^0^0
FIDX_EXCH_CODE^FIDX거래소코드^4^0^0^0^0^0^0
FID_SORT_CLS^FID정렬구분^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="100" inout="out" _len="435" _ulen="351" >

FIDX_BSTP_CLS_CODE^FIDX업종구분코드^4^0^0^0^0^0^0
FIDX_BSTP_DIV_NAME^FIDX업종분류명^80^0^0^0^0^0^0
FIDX_SDPR_CTRT^FIDX기준가대비율^10^2^7^0^0^1^0
FID_ISSU_CNT^FID종목수^6^0^7^0^0^0^0
FIDX_ASCN_ISSU_CNT^FIDX상승종목수^13^0^7^0^0^0^0
FIDX_DOWN_ISSU_CNT^FIDX하락종목수^13^0^7^0^0^0^0
FIDX_ASCN_ISSU_RATE^FIDX상승종목비율^10^2^7^0^0^1^0
FIDX_VOL_INRT^FIDX거래량증가율^10^2^7^0^0^1^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>