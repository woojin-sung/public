'============================================================================
Function GetNationMarketCode(sNation,sMarket)
	
	if sNation  == "US" then
		return "0537"
	elseif sNation == "CN" then
		
		if sMarket  == "SH" then
			return "0215"
		elseif sMarket == "SZ" then 
			return "0214"
		end if
	
	elseif sNation == "HK" then
		return "0104"
	elseif sNation == "JP" then
		return "0106"
	else
		return ""
	end if

End Function

'============================================================================
'20240806 초기 탭 인덱스 반환
'============================================================================
Function GetTabIndexWithNationAndMarket()

	sNation = Form.GetSharedData("HOME_UPDOWN_OVRS_NATION", true )
	sMarket = Form.GetSharedData("HOME_UPDOWN_OVRS_MARKET", true )
	
	if sNation == "US" then
		return 0
	elseif sNation == "CN" then
		
		if sMarket == "SH" then
			return 1
		elseif sMarket == "SZ" then
			return 2
		else
			return 1
		end if
		
	elseif sNation == "HK" then
		return 3
	elseif sNation == "JP" then
		return 4
	else
		return 0
	end if

End Function



