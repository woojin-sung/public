	Form.SetSharedData("HOME_UPDOWN_OVRS" 	, "2")
	Form.SetEnvData(1,"16031_T04_COMBO0"		, g_szNation) '국가구분코드
	Form.SetEnvData(1,"16031_T04_COMBO1"		, "1")		'상위(1)/하위(2)
	Form.SetEnvData(1,"16031_T04_RADIO"		, g_szMarket) '마켓구분코드
	
	'------------------------------------------
	'20240806 초기탭 인덱스 지정 시 사용
	'------------------------------------------
	Form.SetSharedData("HOME_UPDOWN_OVRS_NATION" , g_szNation)
	Form.SetSharedData("HOME_UPDOWN_OVRS_MARKET" , g_szMarket)
	
	Form.OpenScreen("16031" , "HOME")
	
End Sub

