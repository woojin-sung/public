	nDataWidth = CDBl(Form.getTextWidth(szData.."%", -2, true, false))
	
	PannelUp1.setPropCardCell("left", "lblName", nIndex, 10)
	PannelUp1.setPropCardCell("width", "lblName", nIndex, nNameWidth)
	
	PannelUp1.setPropCardCell("left", "lblData", nIndex, nNameWidth + 10)
	PannelUp1.setPropCardCell("width", "imgbg", nIndex, nNameWidth + nDataWidth + 20)
	PannelUp1.SetCardWHAt(nIndex, nNameWidth + nDataWidth + 25)
			 
	'실시간 인블럭 세팅
	PannelUp1.SetCellValue("lblCode", nIndex, szCode)
	
End Function

