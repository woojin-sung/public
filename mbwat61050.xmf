		<COMBO name="cmbWrap" ly_vert="400,5,70,40,1" />
		<FORMTAB name="fmtabInfo" tabcount="3" tabwidthtype="1" tabheadheight="30" ly_vert="0,55,375,507,1" >
			<PAGE name="page0" caption="계약정보" linkfile="mbwat61050_t1" />
			<PAGE name="page1" caption="자산별평가" linkfile="mbwat61050_t2" />
			<PAGE name="page2" caption="포트폴리오" linkfile="mbwat61050_t3" />
		</FORMTAB>
		<LABEL name="lblNoData" visible="0" fgcolor="146:124124124" caption="랩계약이 존재하지 않습니다." halign="1" ly_vert="30,152,315,20,0" />
		<COMBO name="cmbAcnt" ly_vert="6,5,361,39,1" />
		<LABEL name="lblAcntNodata" visible="0" caption="선택할 수 있는 계좌가 없습니다." ly_vert="6,5,250,39,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2711" _ulen="2693" >

Dim g_sCsno, g_sAcno, g_sCnrcNo

'============================================================================
Sub Form_OnFormInit()
	g_sCsno = Form.GetSharedData("&CUST_NUM", false)
	
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
	DATAMANAGER.RequestTranData( "obwat_onln_004r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_004r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sCnrcNo, sPrcdName
				sAcnt	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCnrcNo	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CNRC_NO" , i )
				sCsnm	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				cmbAcnt.cbadddatatext = sAcnt..sCnrcNo.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.."-"..sCnrcNo.." "..sCsnm
			next
			
			cmbAcnt.currentindex = 0
			g_sAcno = Left(cmbAcnt.cbkeydata, 8)
			g_sCnrcNo = Right(cmbAcnt.cbkeydata, 3)
				
			Dim sData
			sData = g_sAcno.."|"..g_sCnrcNo
			Form.triggerEvent("fmtabInfo."..fmtabInfo.currenttabpageid, "Request", sData)
		else
			lblAcntNodata.visible = true
			lblNoData.visible = true
		end if
	end if
End Sub

'============================================================================
Sub fmtabInfo_OnTabChanged(nCurrentTab)
	cmbAcnt.currentindex = cmbAcnt.currentindex
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
	g_sAcno = Left(cmbAcnt.cbkeydata, 8)
	g_sCnrcNo = Right(cmbAcnt.cbkeydata, 3)
		
	Dim sData
	sData = g_sAcno.."|"..g_sCnrcNo
	Form.triggerEvent("fmtabInfo."..fmtabInfo.currenttabpageid, "Request", sData)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

	</SCRIPT_INFO>
