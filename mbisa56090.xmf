' 2020-09-23 : 신극수 : v0001 : [T2007220015] MTS 비밀번호 Edit 메모리평문제거
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData			'데이터
Dim g_szPW			'비밀번호
Dim g_szCnrcNo 		'계약번호
Dim g_nfmtabIndex
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북
dim plain_rm 'v0002
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	'edtPwd01.caption = ""
	'g_szPW = ""
	g_szCnrcNo = ""
	g_nfmtabIndex = 0
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", FALSE )   'v0001
	
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회

	
	'acnt01_ChangeAccount()
	
End Sub

'============================================================================


'============================================================================
Sub edtPwd01_OnEditComplete()
	
	'Form.ShowAlert("알림", "??.")

	'v0001 sta
	'g_szPW = Form.GetEncData( edtPwd01.caption )
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then 
		'Form.ShowAlert("평문적용상태", "평문적용상태")
		g_szPW = Form.GetCtlProp("edtPwd01", "caption") 
	'MTS메모리평문 미적용상태일때
	else
		g_szPW = Form.GetCtlProp("edtPwd01", "encdata") 
	end if 
	
	'Form.MsgBox( "알림", g_szPW, g_szPW, 6 )
	'v0001 fin

	acnt01_ChangeAccount()
	
	'DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
	
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	'edtPwd01.caption = ""
	'g_szPW = ""
	
	g_nfmtabIndex = nCurrentTab

	acnt01_ChangeAccount()
End Sub

'============================================================================
Sub acnt01_ChangeAccount()
	
	'edtPwd01.caption = ""
	'g_szPW = ""

	g_szData = ""
	if g_nfmtabIndex == 0 then
		Form.triggerEvent( "fmtab0."&fmtab0.currenttabpageid , "mbisa56090_t1", g_szData)
	else
		Form.triggerEvent( "fmtab0."&fmtab0.currenttabpageid , "mbisa56090_t2", g_szData)
	end if
		
	If Account_Check() == False then
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		
		If sParam = "POPUP1" Then								' 잔고평가
			Form.OpenDialog("51010" , "4", "")
			
		ElseIf sParam = "SHA_SNS" Then							' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "snsshare" Then   ' SNS공유
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then          ' 이미지공유
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			   
			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else              ' 현재가공유
			Form.triggerEvent("linkfmHoga", "sharedata", "")   
		End If
	
	End If
 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_ctad_011r" then
		Dim i, nCnt	

		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		'2016-06-13 ESKIM : 계약번호 없을시 메세지 팝업 요청(노희범 차장님)
		If nCnt == 0 then
			Form.ShowAlert("알림", "ISA 계약이 존재하지 않습니다.")
		End If
		
		g_szCnrcNo = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_NO" , 0 )
		
		Edit0.caption = g_szCnrcNo 
		if edtPwd01.caption <> "" then
			DATAMANAGER.RequestTranData( "obwat_ctcs_032r" )	'계약번호 조회
		end if 
	elseif szTranID == "obwat_ctcs_032r" then
		asno = DATAMANAGER.GetDataValue( 0, "obwat_ctcs_032r" , "OutBlock1" , "WA_INDV_MGRI_ASNO" , 0 ) 
		g_szData = acnt01.total & "★" & asno & "★" & g_szPW & "★" & g_szCnrcNo
		
		if g_nfmtabIndex == 0 then
			Form.triggerEvent( "fmtab0."&fmtab0.currenttabpageid , "mbisa56090_t1", g_szData)
		else
			Form.triggerEvent( "fmtab0."&fmtab0.currenttabpageid , "mbisa56090_t2", g_szData)
		end if
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctcs_032r" then
		DATAMANAGER.SetDataValue( 0 , "obwat_ctcs_032r", "InBlock1", "WA_CNRC_NO" , 0 , g_szCnrcNo )	'계약번호
	elseIf szTranID == "obwat_ctad_011r" then
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_011r", "InBlock1", "IQRY_CLS_CODE" , 0 , "8" )	'조회구분코드
	End if 
End Sub
'============================================================================
Function Account_Check()
	If acnt01.caption == "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	'If edtPwd01.caption == "" Then
	'	Form.ShowAlert("알림", "비밀번호는 필수값입니다.")
'		Return False
	'End If
	
	'If Edit0.caption == "" Then
		'Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		'Return False
	'End If
	
	Return true
End Function

