	<CONTROL_INFO>
		<IMAGE name="imgTitle" visible="0" autosize="1" imgpath="pop_header.9.png" ly_vert="0,0,375,45,0" />
		<IMAGE name="ImgBackPress" autosize="1" imgpath="icon_top_back_light" ly_vert="20,10,20,20,1" />
		<LABEL name="lblTitle" fontsize="3" caption="채권형 ETF 보기" bgcolor="320:255255255" click="1" ly_vert="40,6,222,30,1" />
		<FORMTAB name="fmtab0" tabcount="2" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="0,45,375,602,1" >
			<PAGE name="page004548" caption="ETF" linkfile="mbonl90051_t1" loadingtype="1" />
			<PAGE name="page005122" caption="ETN" linkfile="mbonl90051_t2" loadingtype="1" />
		</FORMTAB>
