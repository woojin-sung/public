Dim gThemeButtonBG()
gThemeButtonBG = {"ImageThemeBg0","ImageThemeBg1","ImageThemeBg2","ImageThemeBg3","ImageThemeBg4","ImageThemeBg5","ImageThemeBg6","ImageThemeBg7"}

Dim gThemeButton()
gThemeButton = {"LblTheme0","LblTheme1","LblTheme2","LblTheme3","LblTheme4","LblTheme5","LblTheme6","LblTheme7"}

