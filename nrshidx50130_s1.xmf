'============================================================================
Sub Form_OnFormInitBefore()

	'OS타입
	gOsType = Form.GetSharedData("&OS_TYPE", false)

	'라벨 좌우상하 패딩값 제거
	LblTheme0.paddinginfo = "0,0,0,0"
	LblTheme1.paddinginfo = "0,0,0,0"
	LblTheme2.paddinginfo = "0,0,0,0"
	LblTheme3.paddinginfo = "0,0,0,0"
	
	LblTheme4.paddinginfo = "0,0,0,0"
	LblTheme5.paddinginfo = "0,0,0,0"
	LblTheme6.paddinginfo = "0,0,0,0"
	LblTheme7.paddinginfo = "0,0,0,0"
	
	'큰글씨모드 대응
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		
		LblTheme0.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme1.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme2.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme3.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme4.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme5.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme6.fontsize = -3 - CInt(szTextSize) * 2
		LblTheme7.fontsize = -3 - CInt(szTextSize) * 2
	else
		
		
		LblTheme0.fontsize = -3 
		LblTheme1.fontsize = -3 
		LblTheme2.fontsize = -3 
		LblTheme3.fontsize = -3 
		LblTheme4.fontsize = -3 
		LblTheme5.fontsize = -3 
		LblTheme6.fontsize = -3 
		LblTheme7.fontsize = -3 
	
	end if	
	
	'최대 줄수 설정
	LblTheme0.SetMaxLineCount(2)
	LblTheme1.SetMaxLineCount(2)
	LblTheme2.SetMaxLineCount(2)
	LblTheme3.SetMaxLineCount(2)
	LblTheme4.SetMaxLineCount(2)
	LblTheme5.SetMaxLineCount(2)
	LblTheme6.SetMaxLineCount(2)
	LblTheme7.SetMaxLineCount(2)
	
	'라벨위치 조정
	if gOsType == "1" then
		LblTheme0.left = 19
		LblTheme1.left = 107
		LblTheme2.left = 195
		LblTheme3.left = 283
		LblTheme4.left = 19
		LblTheme5.left = 107
		LblTheme6.left = 195
		LblTheme7.left = 283
	end if
	
	'이미지비율 조정
	ImgTheme0.setMaintainingRatio("1")
	ImgTheme1.setMaintainingRatio("1")
	ImgTheme2.setMaintainingRatio("1")
	ImgTheme3.setMaintainingRatio("1")
	ImgTheme4.setMaintainingRatio("1")
	ImgTheme5.setMaintainingRatio("1")
	ImgTheme6.setMaintainingRatio("1")
	ImgTheme7.setMaintainingRatio("1")
	
End Sub

