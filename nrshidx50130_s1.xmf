gThemeButtonIcon = {"ImgTheme0","ImgTheme1","ImgTheme2","ImgTheme3","ImgTheme4","ImgTheme5","ImgTheme6","ImgTheme7"}

Dim gThemeName()
gThemeName = {}
'gThemeName = {"첨단산업","AI/로봇","모빌리티","신재생에너지","인터넷/빅데이터","인프라/건설","바이오테크","소비재(럭셔리등)"}

