'============================================================================
Function ClickThemeButton(nIndx,bSlient)
	
	'배경이미지 변경
	for i = 0 to #gThemeButtonBG - 1
		
		if i == nIndx then
			Form.SetCtlProp(gThemeButtonBG[i], "imgpath", "btn_line2_o.9")
			
		else
			Form.SetCtlProp(gThemeButtonBG[i], "imgpath", "btn_line2_n.9")
		end if
		
	next
	
	'----------------------------------------------------------------
	'선택 페이지 인덱스/ 버튼 인덱스 전달
	'bSlient == true인 경우에는 부모화면에 알리지 않음.
	'----------------------------------------------------------------
	'테마선택 Flow
	'----------------------------------------------------------------
	'1. 테마선택(ClickThemeButton)
	'2. 부모화면에 Noti(SELECT_THEME)
	'3. 부모화면에서 자식화면들한테 Noti(CHANGE_SELECT_IMAGE) 
	'4. 테마선택(ClickThemeButton)
	'4번에서 호출되는 ClickThemeButton에서 bSlient = true로 호출하여 부모에게 Noti안하도록함.
	if bSlient <> true then
		Form.triggerEvent("#", "SELECT_THEME", gTabIndex .."@"..nIndx .."@"..gThemeName[nIndx] .."@"..gThemeCode[nIndx])
	end if

End Function



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "CHANGE_SELECT_IMAGE" then
		
		arrData = Split(sParam,"★")
		
		sTabIndex = Cint(arrData(0))
		sBtnIndex = Cint(arrData(1))
		
		if gTabIndex == sTabIndex then
			ClickThemeButton(sBtnIndex,true)
		else
			ClickThemeButton(-1,true)
		end if
	
	'부모화면(nrshidx50130)에서 폼탭페이지 생성 후 몇번째 페이지인지 전달
	elseif sEventName == "INIT_INDEX" then
		
		gTabIndex = Cint(sParam)
		
	'부모화면(nrshidx50130)에서 테마리스트 조회후 테마리스트 전달
	elseif sEventName == "SEND_THEME_LIST" then
	
		'이미지명@테마명@테마코드^이미지명@테마명@테마코드...
		arrData = Split(sParam,"^")
	
		if #arrData > 1 then
		
			for i = 0 to #arrData - 1
			
				'이미지명@테마명@테마코드
				arrItem = Split(arrData(i),"@")
				sItemName = arrItem(0)
				sItemCode = arrItem(1)
				
				gThemeName[i] = sItemName
				gThemeCode[i] = sItemCode
				
				sThemeImageName = GetThemeImageName(sItemName)
				Form.SetCtlProp(gThemeButtonIcon[i]	, "imgpath", sThemeImageName)
				Form.SetCtlProp(gThemeButtonIcon[i]	, "visible", "1")
				
				Form.SetCtlProp(gThemeButtonBG[i]	, "visible", "1")
				Form.SetCtlProp(gThemeButton[i]		, "visible", "1")
				Form.SetCtlProp(gThemeButton[i]		, "caption", sItemName)
			
			next
		
		end if
	
	'부모화면에서 이전 설정값이 있는경우 전송
	elseif sEventName == "SELECT_HISTORY_THEME" then
		'Form.ShowAlert("["..gTabIndex.."]"..sEventName, sParam)
		ClickThemeButton(Cint(sParam),false)
		
	end if
	
End Sub
'============================================================================
Function GetThemeImageName(sItemKey)
	
	sName = Form.getIconImg("THEME",sItemKey)
	
	if sName == "" then
		sName = Form.getIconImg("THEME","기타")
	end if
	
	return sName
	

End Function



