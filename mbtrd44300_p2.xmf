	<SCRIPT_INFO _len="2428" _ulen="2356" >
--===========================================================================
--===========================================================================

Dim g_szType

'============================================================================
Sub Form_OnFormInit()
	Dim szData, tData
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		tData = Split(szData, "★")
		
		g_szType = tData(0)
		
		if g_szType = "LIMIT_PRC" then '주문가격선택
			lblTitle.caption = "주문가격선택"
		elseif g_szType = "STOP_PRC" then '조건가격선택
			lblTitle.caption = "조건가격선택"
		end if

		if tData(1) <> "" and tData(2) <> "" and tData(3) <> "" then
			f_SetData(tData(1), tData(2), tData(3))
		end if
	end if
End Sub

'============================================================================
' 데이터 셋팅
'============================================================================
Function f_SetData(szItemCode, szCurPrc, szCtrt)
	contPrc.grdPrc.rowcount = 101
	contPrc.grdPrc.height = contPrc.grdPrc.rowheight
	contPrc.SetScrollAutoSize()
	contPrc.scroll_pos = 45*30
	'Form.GetSpinPrice(g_szItemCode, szLPrc, 1)
	Dim szPrc
	
	for i = 0 to 101 step 1
		if i = 50 then
			szPrc = szCurPrc
		else
			szPrc = Form.GetSpinPrice(szItemCode, szCurPrc, 50-i)
			if tonumber(szPrc) < 0 then
				szPrc = "0"
			end if
		end if
		
		contPrc.grdPrc.SetCellData("ItemCode", i, szItemCode)
		contPrc.grdPrc.SetCellData("Prc", i, szPrc)
		
		if tonumber(szPrc) > tonumber(szCtrt) then
			contPrc.grdPrc.SetCellFgColor( "Prc", i, "1" ) '빨간색
		elseif tonumber(szPrc) < tonumber(szCtrt) then
			contPrc.grdPrc.SetCellFgColor( "Prc", i, "2" ) '파란색
		end if
'		if i < 50 then
'			contPrc.grdPrc.SetCellFgColor( "Prc", i, "1" )
'		elseif i > 50 then
'			contPrc.grdPrc.SetCellFgColor( "Prc", i, "2" )
'		end if
	next
End Function

'============================================================================
Sub btnClose0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnClose1_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contPrc_grdPrc_OnClickUp(lRow, szCellID)
	Dim szPrc
	
	Prc = contPrc.grdPrc.GetCellData("Prc", lRow)
	
	if Trim(Prc) <> "" then
		Form.SendReturnToParent(g_szType , Prc)
	end if
	
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>