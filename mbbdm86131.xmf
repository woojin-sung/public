Dim g_szQ1
Dim g_szQ2
Dim g_szQ3

Dim g_nSlctNum
'============================================================================
'20240726 SWJ START: 금융거래한도제한 제도개선 (목적에 기타 없애고 무조건 항목에서 고름)
'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	
	contMain.imgTooltip.setMaintainingRatio("1")
	contMain.imgArrow.setMaintainingRatio("1")
	contMain.contSub.imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	contMain.edtPurpose.imagefilepth = "alpha"
	
	'os별로 처리해야하는 내용들
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		contMain.setScrollBarVisible("2")
	else
		contMain.edtPurpose.SetOnOffImage("alpha", "alpha")
	end if
	
	btnOK.enable = false
	
	If Form.GetEnvData("common.theme") = "black" Then
		btnOK.btnimage = "btn_27.9"
	Else 
		btnOK.btnimage = "btn_21.9"
	End If
	btnOK.fgcolor = "269"

	
	g_szQ1 = ""
	g_szQ2 = ""
	g_szQ3 = ""
	g_nSlctNum = 0
	

'	contMain.cmbPurpose.SetApplyLabel   ("금융거래 목적을 선택해주세요.", 0, 267, "left", false, 111)
'	contMain.cmbPurpose.cbtype = "5"
	
	contMain.cmbPurpose.currentindex = "-1"
	
	contMain.cmbPurpose.fgcolor = "195"
	contMain.cmbPurpose.caption = "금융거래 목적을 선택해주세요."
	
	contMain.lblPurpose.fgcolor = "195"
	contMain.lblPurpose.caption = "금융거래 목적을 선택해주세요."
	
	'20240726 SWJ START
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		contMain.imgTooltip.top = 26
	end if

	contMain.LblAnnounce2.changeTextAttr(8, 9, 323, -2, 0)
	contMain.LblAnnounce3.changeTextAttr(0, 22, 323, -2, 0)
	'20240726 SWJ END
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ERROR" then
		if g_nSlctNum == 1 then
			contMain.contSub.imgQ1A.imgpath = "btn_line_n.9"
			contMain.contSub.lblQ1A.fontbold = false
			contMain.contSub.lblQ1B.fontbold = false
		elseif g_nSlctNum == 2 then
			contMain.contSub.imgQ2A.imgpath = "btn_line_n.9"
			contMain.contSub.lblQ2A.fontbold = false
			contMain.contSub.lblQ2B.fontbold = false
		else
			contMain.contSub.imgQ3A.imgpath = "btn_line_n.9"
			contMain.contSub.lblQ3A.fontbold = false
			contMain.contSub.lblQ3B.fontbold = false
		end if
		
		g_nSlctNum = ""
	
	elseif sKeyName == "ABORT" and sRet == "ok" then
		Form.SetSharedData("BDM_MNY_PROS_DATE" , "")
		Form.SetSharedData("BDM_MNY_PROS_SRNO" , "")
		
		Form.SendReturnToParent("mbbdm86131" , "cancel")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'비대면금융거래목적확인서 관리
	if szTranID == "obcsb_acif_067a" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1")
		
		Dim szRcno
		szRcno = Form.GetSharedData("BDM_RCNO_PIP" , False)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , szRcno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , "")
		
		'2024.07.31 jsi start
		Dim szMnyAcntYn
		szMnyAcntYn = Form.GetSharedData("BDM_MNY_ACNT_YN" , False) '단기다수계좌여부 get
		if szMnyAcntYn == "Y" then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CNFR_TRGT_CUST_CLCD" , 0 , "01") '단기간다수계좌개설
		else 	
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CNFR_TRGT_CUST_CLCD" , 0 , "04") '기타회사지정
		end if 
		'2024.07.31 jsi end
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ANPR_LNDN_YN" , 0 , "N")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ANPR_OPNG_RQST_YN" , 0 , "N")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "OPNG_CASE_CNRC_YN" , 0 , "N")
		
		'2024.08.09 jsi start 법인관련이라 아예 세팅 하지말아야함
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CORP_EMPM_PROM_YN" , 0 , "N")
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CNPL_EXST_YN" , 0 , "N")
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ONID_CNFR_DOCU_EXST_YN" , 0 , "N")
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DMST_OCPT_RLES_EXST_YN" , 0 , "N")
		'2024.08.09 jsi end 
		
		'20240726 SWJ START
'		if contMain.cmbPurpose.currentindex == "5" then
'			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNNC_TR_OBJT_DTL_CNTT" , 0 , contMain.edtPurpose.caption)
'		else
'			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNNC_TR_OBJT_DTL_CNTT" , 0 , contMain.cmbPurpose.caption)
'		end if
		DATAMANAGER.SetDataValue(0, "obcsb_acif_067a", "InBlock1", "FNNC_TR_OBJT_CLCD" , 0 ,  contMain.cmbPurpose.cbkeydata)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_067a", "InBlock1", "DOCU_RQCL_YN"	 , 0 , "N")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_067a", "InBlock1", "RCNO_TYPE_CODE"	 , 0 , "01")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_067a", "InBlock1", "CUST_CLS_CODE"	 , 0 , "1")
		'20240726 SWJ END
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ECPT_TRGT_YN" , 0 , "N")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ECPT_REAS_DTL_CNTT" , 0 , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'비대면금융거래목적확인서 관리
	if szTranID == "obcsb_acif_067a" then
		Dim szProsDate, szProsSrno
		szProsDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_DATE" , 0)
		szProsSrno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_SRNO" , 0)
		
		'신분증 단계에서 obaci_acct_059c 입력값으로 쓰임
		Form.SetSharedData("BDM_MNY_PROS_DATE" , szProsDate)
		Form.SetSharedData("BDM_MNY_PROS_SRNO" , szProsSrno)
		
		Form.SendReturnToParent("mbbdm86131" , "ok")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	btnOK.enable = true
	
	btnOK.btnimage = "btn_20.9"
	btnOK.fgcolor = "273"
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szSubMsg <> "" then
		Form.ShowAlert("", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("", szErrMsg)
	end if
End Sub

'============================================================================
Function f_EnableNextButton()
	Dim bFlag
	bFlag = true
	
'	if contMain.cmbPurpose.caption == "" or contMain.cmbPurpose.caption == null then
'		bFlag = false
'	end if
	
	if Trim(contMain.cmbPurpose.caption) = "금융거래 목적을 선택해주세요." then
		bFlag = false
	end if
	
	'20240726 SWJ START
'	if contMain.cmbPurpose.currentindex == "5" then
'		if contMain.edtPurpose.caption == "" then
'			bFlag = false
'		end if
'	end if
	'20240726 SWJ END
	
	if g_szQ1 == "" or g_szQ2 == "" or g_szQ3 == "" then
		bFlag = false
	end if
	
	btnOK.enable = bFlag
	
	if bFlag then
		btnOK.btnimage = "btn_20.9"
		btnOK.fgcolor = "273"
	else
		If Form.GetEnvData("common.theme") = "black" Then
			btnOK.btnimage = "btn_27.9"
		Else 
			btnOK.btnimage = "btn_21.9"
		End If
		btnOK.fgcolor = "269"
	end if
End Function 

'============================================================================
Function f_SlctQuestion(nNum, szVal)
	if nNum == 1 then
		if szVal == "Y" then
			g_nSlctNum = 1
			
			contMain.contSub.imgQ1A.imgpath = "btn_line_o.9"
			contMain.contSub.imgQ1B.imgpath = "btn_line_n.9"
			contMain.contSub.lblQ1A.fontbold = true
			Form.MsgBox("안내", "계좌가 범죄에 악용될 우려가 있습니다.\n다시 확인해 주세요.", "ERROR", 6)
			
			g_szQ1 = ""
		else
			contMain.contSub.imgQ1A.imgpath = "btn_line_n.9"
			contMain.contSub.imgQ1B.imgpath = "btn_line_o.9"
			contMain.contSub.lblQ1B.fontbold = true
			g_szQ1 = "Y"
		end if
	
	elseif nNum == 2 then
		if szVal == "Y" then
			g_nSlctNum = nNum
			
			contMain.contSub.imgQ2A.imgpath = "btn_line_o.9"
			contMain.contSub.imgQ2B.imgpath = "btn_line_n.9"
			contMain.contSub.lblQ2A.fontbold = true
			Form.MsgBox("안내", "계좌가 범죄에 악용될 우려가 있습니다.\n다시 확인해 주세요.", "ERROR", 6)
			
			g_szQ2 = ""
		else
			contMain.contSub.imgQ2A.imgpath = "btn_line_n.9"
			contMain.contSub.imgQ2B.imgpath = "btn_line_o.9"
			contMain.contSub.lblQ2B.fontbold = true
			
			g_szQ2 = "Y"
		end if
		
	else
		if szVal == "Y" then
			g_nSlctNum = nNum
			
			contMain.contSub.imgQ3A.imgpath = "btn_line_o.9"
			contMain.contSub.imgQ3B.imgpath = "btn_line_n.9"
			contMain.contSub.lblQ3A.fontbold = true
			Form.MsgBox("안내", "계좌가 범죄에 악용될 우려가 있습니다.\n다시 확인해 주세요.", "ERROR", 6)
			
			g_szQ3 = ""
		else
			contMain.contSub.imgQ3A.imgpath = "btn_line_n.9"
			contMain.contSub.imgQ3B.imgpath = "btn_line_o.9"
			contMain.contSub.lblQ3B.fontbold = true
			
			g_szQ3 = "Y"
		end if
	end if
	
	f_EnableNextButton()
End Function

