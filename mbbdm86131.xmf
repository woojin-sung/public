Sub btnOK_OnClick()
	btnOK.enable = false
	
	If Form.GetEnvData("common.theme") = "black" Then
		btnOK.btnimage = "btn_27.9"
	Else 
		btnOK.btnimage = "btn_21.9"
	End If
	btnOK.fgcolor = "269"
	
	'비대면금융거래목적확인서 관리
	DATAMANAGER.RequestTranData( "obcsb_acif_067a" )
End Sub

