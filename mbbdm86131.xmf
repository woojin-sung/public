'============================================================================
Sub contMain_imgTooltip_OnClick()
	Dim szText
	szText = "증권카드, 통장을 타인에게 양도하는 경우 손해배상 책임을 부담할 수 있고, 전자금융거래법에 의해 처벌을 받을 수 있으며, 전자금융사기계좌로 의심될 경우에는 금융회사에서 계좌개설을 거부하거나 임의로 입출금정지 조치를 취할 수 있습니다."
	contMain.imgTooltip.openToolTip(szText, 340, 140, 2)
End Sub

