	<SCRIPT_INFO _len="53522" _ulen="49484" >
'============================================================================
' 신규작성 : 2023.11
'============================================================================

'obrtp_tact_004a는 obrtp_tact_101a로 교체해야함. 시간없어서 내버려둠 2023.12.12 JWH
'신지환 2024.01.22 v002 자주쓰는계좌 등록 안 된 경우 바로가기 버튼 추가 (개인&법인) / 타금융 내계좌 등록 안된 경우 바로가기 버튼 추가 (개인)

Dim g_nSelectRow,g_nSelectDeleteRow, g_nChangeRow1
g_nSelectRow = -1
Dim g_szCsno	'고객번호
Dim g_szChangeNickName
Dim g_nGrd069Idx
g_nGrd069Idx = 0
Dim g_tRegist
dim g_szCUST_ABWR_NAME, g_szCUST_ENG_NAME, g_szCUST_CLS_CODE
g_szCUST_CLS_CODE = ""
g_szCUST_ENG_NAME = ""
dim g_bTr040Error, g_szTr040ErrorMsg, g_bTr180Error, g_szTr180ErrorMsg
g_bTr040Error = false
g_szTr040ErrorMsg = ""
g_bTr180Error = false
g_szTr180ErrorMsg = ""
Dim g_szTactScreenYn

'============================================================================
Sub Form_OnFormInitBefore()
	imgNoData.setMaintainingRatio("1")
	grdList.setMaintainingRatio("bd_logo", 0, "1")
	grdListTA.setMaintainingRatio("bd_logo", 0, "1")
	
	'20231214 - 종합계좌 연동
	Account0.SetTotalLinkage(true)
	
End Sub

'============================================================================
Sub Form_OnFormInit()
    '스크롤 끊김 현상 방지 등
    grdList.SetUseLoadFast(True)
    grdList.SetUseNewDragMotion(True)
    grdList.changeDragStartOffset(True) '드래그 시작위치 조정
    grdList.changeDragScrollSpeed(8)    '드래그 속도    
	
    '이미지세팅 속도 개선
    grdListTA.SetUseLoadFast(true)

    grdList.rowcount = 0
    grdListTA.rowcount = 0
       
    g_szCsno = Form.GetSharedData("&CUST_NUM" , False ) '고객번호
    Form.SetSharedData("61140_Csno" , g_szCsno)

    If Trim(acnt.caption) <> "" And acnt.caption <> Null Then
        DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
        DATAMANAGER.RequestTranData( "obacp_opop_064r" )
    End If
		
    grdList.rowmove = "2"
    grdList.setDragImage("edit_guide_01.png")
    grdList.setDragImageOption(true,0)'1번 인자=T확장 F미확장/2번 인자=0(투명)~1.0(불투명)(안드로이드는 적용 안 되는 인자임)

    szOpenLinkData = Split(Form.GetOpenLinkData(), "★")
    
    If UBOUND(szOpenLinkData) < 1 Then
        g_szTactScreenYn = "N" '이체화면연동
        If Trim(acnt.caption) <> "" And acnt.caption <> Null Then
            DATAMANAGER.RequestTranData( "obrtp_tact_102r" )
        End If    
        Exit Sub
    Else
        g_szTactScreenYn = "Y" '이체화면연동
    End If
	
    If szOpenLinkData(0) == "0" Or Cdbl(szOpenLinkData(0)) == 0 Then '자주쓰는계좌
    
        tabType.currenttab = 0
        tabType_OnTabChanged(0)
	
        If szOpenLinkData(1) == "0" Or Cdbl(szOpenLinkData(1)) == 0 Then '원화
            rdoCurrType.currentindex = 0
            rdoCurrType_OnClick(0)
        Else
            rdoCurrType.currentindex = 1
            rdoCurrType_OnClick(1)
        End If

    ElseIf szOpenLinkData(0) == "1" Or Cdbl(szOpenLinkData(0)) == 1 Then '타금융 내계좌
    
        tabType.currenttab = 1
        tabType_OnTabChanged(1)	
        
        If szOpenLinkData(1) == "0" Or Cdbl(szOpenLinkData(1)) == 0 Then '원화
            rdoCurrType.currentindex = 0
            rdoCurrType_OnClick(0)
        Else
            rdoCurrType.currentindex = 1
            rdoCurrType_OnClick(1)
        End If

    else
        Form.msgbox("알림", "잘못된 접근입니다.", "", 0)
        Exit Sub
    End If
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_opop_064r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
	'이체계좌조회
	elseif szTranID == "obrtp_tact_102r" or szTranID == "obrtp_tact_102r_1" then
		if CInt(tabType.currenttab) == 0 then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD" , 0 , "01" )		'자주
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD" , 0 , "03" )		'타금융
		end if
		
		if CInt(rdoCurrType.currentindex) == 0 then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "1" )	'원화
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "2" )	'외화
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence )

    ElseIf szTranID == "obrtp_tact_101a" Then'계좌등록
				
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1" )'처리구분코드	1=계좌등록 3=계좌별명변경 4=계좌순서변경 5=데이터 삭제
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCsno )'고객번호
		
		if CInt(tabType.currenttab) == 0 then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD" , 0 , "01" )'업무구분코드 자주=01 약정(타금융내계좌를 말함))=02
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD" , 0 , "02" )'업무구분코드 자주=01 약정(타금융내계좌를 말함))=02
		end if
		if CInt(rdoCurrType.currentindex) == 0 then'원화계좌
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "1" )'통화구분코드 1=원화 2=외화
		else'외화계좌
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "2" )'통화구분코드 1=원화 2=외화
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRCD" , 0 , g_tRegist(7) )'통화코드
		end if
		
		szCLS_CODE = ""
		
		if g_tRegist(0) == "287" then'287=당사
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ONCO_OTCO_CLS_CODE" , 0 , "1" )'자사타사구분코드 1당사 2타사
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_CODE" , 0 , g_tRegist(0) )'은행코드
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CNFT_ACNO" , 0 , Left(g_tRegist(1), 8) )'상대계좌번호
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CNFT_ASNO" , 0 , Right(g_tRegist(1), 2) )'상대계좌일련번호
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ONCO_OTCO_CLS_CODE" , 0 , "2" )'자사타사구분코드 1당사 2타사
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_CODE" , 0 , g_tRegist(0) )'은행코드
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_USE_ACNO" , 0 , g_tRegist(1) )'은행사용계좌번호
			
'			if CInt(rdoCurrType.currentindex) == 0 then'원화계좌
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BIC_CODE" , 0 , g_tRegist(5) )'BIC코드
'			end if
			
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_ACNM" , 0 , g_tRegist(6) )'계좌명
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "USER_NAME" , 0 , g_tRegist(4) )'별명
		
    ElseIf szTranID == "obrtp_tact_101a_1" Then'계좌별명변경
		
