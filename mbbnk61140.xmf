		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01" )
	elseif szTranID == "obpds_srvc_080r" or szTranID == "obpds_srvc_180r" or szTranID == "obpds_srvc_080r_1" or szTranID == "obpds_srvc_180r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCsno )'고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SVCD" , 0 , grd069.GetCellData("bd_cell1", g_nGrd069Idx) )'서비스코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SVC_SRNO" , 0 , grd069.GetCellData("bd_cell2", g_nGrd069Idx) )'서비스 일련번호
	elseif szTranID == "obrtp_tact_004a" then'타금융 별명 변경
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "U" )'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCsno )'고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD" , 0 , "02" )'02=약정
		
		if CInt(rdoCurrType.currentindex) == 0 then'원화
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "1" )'
			szBANK_CODE = grdListTA.GetCellData("bd_cell3", g_nSelectRow)'은행코드
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_CODE" , 0 , szBANK_CODE )'
		else
			szBIC_CODE = grdListTA.GetCellData("bd_cell16", g_nSelectRow)'BIC코드
			
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "2" )'
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BIC_CODE" , 0 , szBIC_CODE )'			
		end if
		
		szBANK_USE_ACNO = grdListTA.GetCellData("bd_cell14", g_nSelectRow)
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_USE_ACNO" , 0 , szBANK_USE_ACNO )'
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "USER_NAME" , 0 , g_szChangeNickName )'
	elseif szTranID == "obtss_elbs_129r" then'원화 수취조회
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "MNRC_BANK_CODE" , 0 , g_tRegist(0) )'은행코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "JOB_TRNO" , 0 , "031" )'작업단말번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "MNRC_ACNO" , 0 , g_tRegist(1) )'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TR_AMT" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "DRNG_ACNO" , 0 , "FFFFFFFF" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PROD_CLS_CODE" , 0 , "" )
		
	elseif szTranID == "obtsd_fbnk_121r" then'외화 수취조회
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1" )'1수취조회 2약정등록
		if CInt(tabType.currenttab) == 0 then'자주
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence )
		else'타금융
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Account1.total )
'			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , Account1.sequence )'미셋팅
		end if
				
		if g_tRegist(0) == "287" then'287=당사
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TACT_LNKD_ISTU_CODE" , 0 , "287" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_CODE" , 0 , g_tRegist(0) )'은행코드(당사선택시 필수)
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TACT_LNKD_ISTU_CODE" , 0 , "702" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BIC_CODE" , 0 , g_tRegist(5) )
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "RRNO"   , 0 , Form.GetSharedData("&RET_RSNO", False))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_ACNO" , 0 , g_tRegist(1) )
	elseif szTranID == "obpds_srvc_186r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCsno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_ENG_NAME" , 0 , DATAMANAGER.GetDataValue( false, "obtsd_fbnk_121r" , "OutBlock1" , "ENG_RMT_NAME" , 0) )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    'JWH 20240213 이체화면에서 넘어왔을 경우 
    If g_szTactScreenYn == "Y" Then 
        'JWH 20240213 처리서비스 완료 시 화면 강제종료
        If szTranID == "obrtp_tact_101a" Or szTranID == "obpds_srvc_040a_2" Or szTranID == "obpds_srvc_180a_2" Then
            Form.CloseForm()
        End If
    End If

	if szTranID == "obrtp_tact_102r" or szTranID == "obrtp_tact_102r_1" then
		bMore = DATAMANAGER.IsMoreNextData( szTranID )

		if bMore == "1" or bMore == true or bMore == 1 then
			DATAMANAGER.RequestNextData( szTranID )
		else
			if CInt(grdList.rowcount) == 0 then
				grdList.visible = false
				lblNoData.visible = true
				imgNoData.visible = true
			else
				grdList.visible = true
				lblNoData.visible = false
				imgNoData.visible = false
			end if
			
			If Cint(grdList.rowcount) > 100 Then
			    grdList.rowmove = "3" '3.삭제만
			    grdList.setDragImage("edit_guide_02.png")
			    grdList.setDragImageOption(False,0)
			Else
			    grdList.rowmove = "2" '2.둘다
			    grdList.setDragImage("edit_guide_01.png")
			    grdList.setDragImageOption(true,0)
			End If
			
			for i = 0 to CInt(grdList.rowcount) - 1
				szBankCode = grdList.GetCellData("bd_cell3", i)'은행코드
				
				szName = Form.GetMetaData("은행코드", szBankCode)
'				szName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "BANK_NAME" , i)
				grdList.SetCellData("bd_cell8", i, szName)
				grdList0.SetCellData("bd_cell8", i, szName)
				
				if CInt(rdoCurrType.currentindex) == 0 and szBankCode == "287" then
					szDangAcno = grdList.GetCellData("bd_cell29", i)'당사계좌번호
					szDangAsno = grdList.GetCellData("bd_cell33", i)'당사계좌번호
					szAccName = grdList.GetCellData("bd_cell16", i)'당사계좌이름
					
					grdList.SetCellData("bd_name", i, szAccName)
					grdList.SetCellData("bd_bankacnt", i, szName .. " " .. szDangAcno..szDangAsno)
				else
					szName = grdList.GetCellData("bd_cell8", i)'은행명
					szAcNo = grdList.GetCellData("bd_cell14", i)'은행계좌번호
					
					grdList.SetCellData("bd_bankacnt", i, szName .. " " .. szAcNo)
				end if
				
				grdList.SetCellData("bd_edit", i , "icon_pencil.png")
				grdList.setMaintainingRatio("bd_edit"    , i , "1")
				
				grdList.SetCellImage("bd_logo", i, "bank".. szBankCode)
				grdList.setMaintainingRatio("bd_logo"    , i , "1")
			next
		end if

	elseif szTranID == "obrtp_tact_101a" or szTranID == "obrtp_tact_101a_1" or szTranID == "obrtp_tact_101a_3" then
		
		szIQRY_PROS_YN = DATAMANAGER.GetDataValue(szTranID, "OutBlock1", "IQRY_PROS_YN" , 0)'조회처리여부
		
		'====
		if szIQRY_PROS_YN == "Y" and szTranID <> "obrtp_tact_101a" then'
			grdList.rowcount = 0
			grdList0.rowcount = 0
			DATAMANAGER.RequestTranData( "obrtp_tact_102r" )
		end if
		'====
		
		if szTranID == "obrtp_tact_101a_3" then'삭제
			Form.Toast(0, "자주쓰는계좌가 삭제되었습니다.", 0)
			grdList.SetDeleteRow(g_nSelectDeleteRow)
			
			if CInt(grdList.rowcount) == 0 then
				grdList.visible = false
				lblNoData.visible = true
				imgNoData.visible = true
			else
				grdList.visible = true
				lblNoData.visible = false
				imgNoData.visible = false
			end if
			
			DATAMANAGER.RequestTranData( "obrtp_tact_102r_1" )
		end if
		
		if szTranID == "obrtp_tact_101a" then'계좌등록
				
			szData = ""
			if CInt(rdoCurrType.currentindex) == 0 then'원화
				szData = "원화계좌"
			else
				szData = "외화계좌"
			end if
			
			DATAMANAGER.RequestTranData( "obrtp_tact_102r" )
			
			Form.OpenPopup("mbbnk61140_p2" , szData.."★".. g_tRegist(0).."★".. g_tRegist(1).."★".. g_tRegist(6).."★".. g_tRegist(4).."★".. tabType.currenttab .."★".. g_tRegist(2), "")
		elseif szTranID == "obrtp_tact_101a_1" then'별명변경
			grdList.SetCellData("bd_alias", g_nSelectRow, g_szChangeNickName)
			grdList0.SetCellData("bd_alias", g_nSelectRow, g_szChangeNickName)
		end if
		
	elseif szTranID == "obpds_srvc_180a_2" then'타금융 외화 계좌 등록
			grdListTA.rowcount = 0
			DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
			szData = ""
			if CInt(rdoCurrType.currentindex) == 0 then'원화
				szData = "원화계좌"
			else
				szData = "외화계좌"
			end if
			
			Form.OpenPopup("mbbnk61140_p2" , szData.."★".. g_tRegist(0).."★".. g_tRegist(1).."★".. g_tRegist(6).."★".. g_tRegist(4).."★".. tabType.currenttab .."★".. g_tRegist(2), "")
    ElseIf szTranID == "obcsb_acif_000r" Then
        g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue(false, "obcsb_acif_000r", "OutBlock1", "CUST_CLS_CODE" , 0)
        g_szCUST_ABWR_NAME = DATAMANAGER.GetDataValue(false, "obcsb_acif_000r", "OutBlock1", "CUST_ABWR_NAME" , 0)'고객 한글명
        g_szCUST_ENG_NAME = DATAMANAGER.GetDataValue(false, "obcsb_acif_000r", "OutBlock1", "CUST_ENG_NAME" , 0)'고객 영문명
		
        If Trim(g_szCUST_CLS_CODE) == "2" Then '법인
            'Continue
        Else
            '약정계좌
            grdListTA.rowmove = "3"                     
            grdListTA.setDragImage("edit_guide_02.png") 
	    
            if CInt(tabType.currenttab) == 1 and CInt(rdoCurrType.currentindex) == 0 Then
                '231024 약정가능여부 TR 추가
                DATAMANAGER.RequestTranData( "obpds_srvc_040a_1" )
            ElseIf CInt(tabType.currenttab) == 1 and CInt(rdoCurrType.currentindex) == 1 Then
                DATAMANAGER.RequestTranData( "obpds_srvc_180a_1" )
            End If
        End If
	
	'등록버튼 눌렀을때
	elseif szTranID == "obcsb_acif_000r_1" then
		g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue(false, "obcsb_acif_000r_1", "OutBlock1", "CUST_CLS_CODE" , 0)
		g_szCUST_ABWR_NAME = DATAMANAGER.GetDataValue(false, "obcsb_acif_000r_1", "OutBlock1", "CUST_ABWR_NAME" , 0)'고객 한글명
		g_szCUST_ENG_NAME = DATAMANAGER.GetDataValue(false, "obcsb_acif_000r_1", "OutBlock1", "CUST_ENG_NAME" , 0)'고객 영문명
		
		'등록팝업 오픈
		if g_szCUST_CLS_CODE == "2" and CInt(tabType.currenttab) == 1 then'타금융 내계좌일 때 법인여부 + 약정가능여부
			Form.MsgBox("알림", "타금융내계좌는 개인만 등록 가능합니다.", "", "0")
			return false
		end if
		if CInt(tabType.currenttab) == 1 and CInt(rdoCurrType.currentindex) == 0 and g_bTr040Error then'타금융 원화 약정가능여부
			Form.MsgBox("알림", g_szTr040ErrorMsg, "", "0")
			return false
		end if
		
		if CInt(tabType.currenttab) == 1 and CInt(rdoCurrType.currentindex) == 1 and g_bTr180Error then'타금융 외화 약정가능여부
			Form.MsgBox("알림", g_szTr180ErrorMsg, "", "0")
			return false
		end if
		
		dim szData
		
		szData = tabType.currenttab .."★"..g_szCUST_ENG_NAME'영어명
		
		if CInt(tabType.currenttab) == 0 then'자주
			szData = szData .."★"..acnt.total.."★".. acnt.sequence
		else
			szData = szData .."★"..Account1.total.."★".. Account1.sequence
		end if
			
		szData = szData .."★".. rdoCurrType.currentindex .."★".. g_szCUST_ABWR_NAME
		
		Form.OpenPopup("mbbnk61140_p1" , szData , "")
	
	elseif szTranID == "obpds_srvc_040a_1" then'타금융 원화 약정가능여부
		g_bTr040Error = false
	elseif szTranID == "obpds_srvc_180a_1" then'타금융 원화 약정가능여부
		g_bTr180Error = false
	elseif szTranID == "obpds_srvc_069r" then'타금융내계좌 조회
		bMore = DATAMANAGER.IsMoreNextData( szTranID )

		if bMore == "1" or bMore == true or bMore == 1 then
			DATAMANAGER.RequestNextData( szTranID )
		else
			if CInt(grd069.rowcount) > 0 then
				g_nGrd069Idx = 0
				szCode = grd069.GetCellData("bd_cell3", g_nGrd069Idx)
			
				if szCode == "03" then'03인경우 TR조회 X
					bFlag = false
					nNext = -1
					for j = g_nGrd069Idx + 1 to CInt(grd069.rowcount) - 1
						szTemp = grd069.GetCellData("bd_cell3", j)
						if szTemp <> "03" and bFlag == false then'03인경우 TR조회 X
							bFlag = true
							nNext = j
						end if
					next
					
					if nNext <> -1 then
						grdListTA.visible = true
						lblNoData.visible = false
						imgNoData.visible = false
						
						g_nGrd069Idx = nNext
						
						if CInt(rdoCurrType.currentindex) == 0 then'원화
							DATAMANAGER.RequestTranData( "obpds_srvc_080r" )
						else
							DATAMANAGER.RequestTranData( "obpds_srvc_180r" )
						end if
					else
						grdListTA.visible = false
						lblNoData.visible = true
						imgNoData.visible = true
					end if
				else
					grdListTA.visible = true
					lblNoData.visible = false
					imgNoData.visible = false
					if CInt(rdoCurrType.currentindex) == 0 then'원화
						DATAMANAGER.RequestTranData( "obpds_srvc_080r" )
					else
						DATAMANAGER.RequestTranData( "obpds_srvc_180r" )
					end if
				end if
			else
				grdListTA.visible = false
				lblNoData.visible = true
				imgNoData.visible = true
			end if
		end if
	elseif szTranID == "obpds_srvc_080r" or szTranID == "obpds_srvc_180r" then
		g_nGrd069Idx = g_nGrd069Idx + 1
		if g_nGrd069Idx <= CInt(grd069.rowcount) then
			nDataCnt = CInt(DATAMANAGER.GetDataCount( false, szTranID , "OutBlock1" ))
			
			if nDataCnt > 0 then
				nGrdIdx = CInt(grdListTA.rowcount)
				nRowCnt = CInt(grdListTA.rowcount) + nDataCnt
				grdListTA.rowcount = nRowCnt
				
				for i = 0 to nDataCnt - 1 
					szCSNO = 		DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "CSNO" , i )
					szACNT_EXPL = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "ACNT_EXPL" , i )
					szUSER_NAME = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "USER_NAME" , i )
					szBANK_CODE = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BANK_CODE" , i )
					
					szTACT = ""
					szBIC_CODE = ""
					if szTranID == "obpds_srvc_080r" then
						szTACT = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "TACT_BANK_ACNO" , i )
					elseif szTranID == "obpds_srvc_180r" then
						szTACT = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "TACT_FRCR_BANK_ACNO" , i )
						szBANK_NAME = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BANK_NAME" , i )
						szBIC_CODE = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BIC_CODE" , i )
						
						grdListTA.SetCellData("bd_cell8", nGrdIdx, szBANK_NAME)
						grdListTA.SetCellData("bd_cell16", nGrdIdx, szBIC_CODE)
					end if
					
					szSVCD = 		DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "SVCD" , i )
					szSVC_SRNO = 		DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "SVC_SRNO" , i )
					szBSWR_CONV_ACNT_YN = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BSWR_CONV_ACNT_YN" , i )
					
					grdListTA.SetCellData("bd_cell2", nGrdIdx, szCSNO)			
					grdListTA.SetCellData("bd_cell36", nGrdIdx, szCSNO)			
					grdListTA.SetCellData("bd_name", nGrdIdx, szACNT_EXPL)			
					grdListTA.SetCellData("bd_alias", nGrdIdx, szUSER_NAME)			
					grdListTA.SetCellData("bd_cell3", nGrdIdx, szBANK_CODE)			
					grdListTA.SetCellData("bd_cell14", nGrdIdx, szTACT)			
					grdListTA.SetCellData("bd_cell4", nGrdIdx, szSVCD)			
					grdListTA.SetCellData("bd_cell9", nGrdIdx, szSVC_SRNO)			
					grdListTA.SetCellData("bd_cell20", nGrdIdx, szBSWR_CONV_ACNT_YN)			
					
					szBankCode = grdListTA.GetCellData("bd_cell3", nGrdIdx)'은행코드
					szName = grdListTA.GetCellData("bd_cell8", nGrdIdx)'은행명
					
					if szTranID == "obpds_srvc_080r" then'은행명 안 들어와서 여기서 넣어야함
						szName = Form.GetMetaData("은행코드", szBankCode)
						grdListTA.SetCellData("bd_cell8", nGrdIdx, szName)
					end if
					
					szAcNo = grdListTA.GetCellData("bd_cell14", nGrdIdx)'은행계좌번호
				 
					grdListTA.SetCellData("bd_bankacnt", nGrdIdx, szName .. " " .. szAcNo)
					
					grdListTA.SetCellData("bd_edit", nGrdIdx , "icon_pencil.png")
					grdListTA.setMaintainingRatio("bd_edit", nGrdIdx, "1")
				
					grdListTA.SetCellImage("bd_logo", nGrdIdx, "bank".. szBankCode)
					grdListTA.setMaintainingRatio("bd_logo", nGrdIdx, "1")
					
					nGrdIdx = nGrdIdx + 1
				next
				
			end if
			
			if g_nGrd069Idx < CInt(grd069.rowcount) then
				
				szCode = grd069.GetCellData("bd_cell3", g_nGrd069Idx)
				if szCode == "03" then'03인경우 TR조회 X
					bFlag = false
					nNext = -1
					for j = g_nGrd069Idx + 1 to CInt(grd069.rowcount) - 1
						szTemp = grd069.GetCellData("bd_cell3", j)
						if szTemp <> "03" and bFlag == false then'03인경우 TR조회 X
							bFlag = true
							nNext = j
						end if
					next
					
					if nNext <> -1 then
						g_nGrd069Idx = nNext
						DATAMANAGER.RequestTranData(szTranID)
					end if
				else
					DATAMANAGER.RequestTranData(szTranID)
				end if
			else
				'이미지 셋팅
				if CInt(grdListTA.rowcount) == 0 then
					grdListTA.visible = false
					lblNoData.visible = true
					imgNoData.visible = true
				else
					grdListTA.visible = true
					lblNoData.visible = false
					imgNoData.visible = false
				end if
			end if
			
		end if
	elseif szTranID == "obrtp_tact_004a" then'타금융 별명 변경
		grdListTA.SetCellData("bd_alias", g_nSelectRow, g_szChangeNickName)
'		grdListTA0.SetCellData("bd_alias", g_nSelectRow, g_szChangeNickName)
	elseif szTranID == "obpds_srvc_040a" or szTranID == "obpds_srvc_180a" then'타금융 약정 계좌 삭제
	
		Form.Toast(0, "타금융내계좌가 삭제되었습니다.", 0)
		grdListTA.SetDeleteRow(g_nSelectDeleteRow)
		
		if CInt(grdListTA.rowcount) == 0 then
			grdListTA.visible = false
			lblNoData.visible = true
			imgNoData.visible = true
		else
			grdListTA.visible = true
			lblNoData.visible = false
			imgNoData.visible = false
		end if
		
	elseif szTranID == "obpds_srvc_040a_2" then'타금융 약정 원화 계좌등록
		grdListTA.rowcount = 0
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
		
		szData = ""
		if CInt(rdoCurrType.currentindex) == 0 then'원화
			szData = "원화계좌"
		else
			szData = "외화계좌"
		end if
		
		Form.OpenPopup("mbbnk61140_p2" , szData.."★".. g_tRegist(0).."★".. g_tRegist(1).."★".. g_tRegist(6).."★".. g_tRegist(4).."★".. tabType.currenttab .."★".. g_tRegist(2), "")
		
	elseif szTranID == "obtsd_fbnk_121r" then'외화 수취조회
		szSELF_ACNT_YN 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SELF_ACNT_YN" , 0)		'본인계좌여부
		szRSPN_CODE	 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" , 0)		'응답코드
		szRSPN_MSG_CNTT			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" , 0)		'사유
		
		if szSELF_ACNT_YN = "Y" then	'정상
			if CInt(tabType.currenttab) == 0 then'자주쓰는
				DATAMANAGER.RequestTranData( "obrtp_tact_101a" )'계좌 등록
			else'타금융
				DATAMANAGER.RequestTranData( "obpds_srvc_180a_2" )'계좌 등록
			end if
		else
			Form.MsgBox("알림", "입력하신 계좌번호를 다시 확인해주세요.", "", 0)
		end if
		
	elseif szTranID == "obtss_elbs_129r" then'원화 수취조회
		szACNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNM" , 0)

		if g_szCUST_ABWR_NAME == szACNM then
			if CInt(tabType.currenttab) == 0 then'자주쓰는
				DATAMANAGER.RequestTranData( "obrtp_tact_101a" )'계좌 등록
			else'타금융
			
			end if
		else
			Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "", 0)
		end if
	elseif szTranID == "obpds_srvc_186r" then
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obpds_srvc_040a_1" then'타금융 원화 약정가능여부(=에러 메세지는 계좌등록시에 보여줌)
		g_bTr040Error = true
		g_szTr040ErrorMsg = szErrMsg&"\n"&szSubMsg
	elseif szTranID == "obpds_srvc_180a_1" then'타금융 원화 약정가능여부(=에러 메세지는 계좌등록시에 보여줌)
		g_bTr180Error = true
		g_szTr180ErrorMsg = szErrMsg&"\n"&szSubMsg
	elseif szTranID == "obrtp_tact_005a" then
		Form.Toast(0, szSubMsg , 0)
		DATAMANAGER.RequestTranData( "obrtp_tact_102r" )
	else
		If szSubMsg <> "" And szSubMsg <> null Then
			'Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
			Form.MsgBox("알림", szErrMsg .. "\n" .. szSubMsg , "", 6)
		Else
			'Form.ShowAlert("알림", szErrMsg)
			Form.MsgBox("알림", szErrMsg , "", 6)
		End If
	end if
End Sub

