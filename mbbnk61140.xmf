Sub grdList_OnClickUp(lRow, szCellID)
	if szCellID == "bd_edit" then'별명 편집
		g_szChangeNickName = ""
		szData = grdList.GetCellData("bd_alias", lRow)
		Form.OpenPopupAnimation("textkeypadpopup", "별명☆"..szData.."☆최대 10 글자 입력 가능☆1☆20", "","2")
'		Form.OpenPopupAnimation("textkeypadpopup", "별명☆".."☆최대 10 글자 입력 가능☆1☆20", "","2")
		g_nSelectRow = CInt(lRow)
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "POPUP_TEXT" then
		'20231120 빈값으로도 별명 변경 가능하므로 조건문 수정
'		if Trim(sRet) <> "" and g_nSelectRow > -1 then
		if g_nSelectRow > -1 then
			g_szChangeNickName = Trim(sRet)
			if CInt(tabType.currenttab) == 0 then
				DATAMANAGER.RequestTranData( "obrtp_tact_101a_1" )
			else
				DATAMANAGER.RequestTranData( "obrtp_tact_004a" )
			end if
		end if
	elseif sKeyName == "mbbnk61140_p1" then'계좌등록 팝업
		if Trim(sRet) <> "" then
			'szData = g_szBankCode.."★"..g_szBankAcno .."★"..g_szBankName .."★"..g_szBankAcntNm .."★"..g_szNickName .."★"..g_szBicCode .."★"..g_szAcntName .."★"..g_szCurr
			g_tRegist = Split(sRet, "★")
			
			if #g_tRegist > 10 then
				if g_tRegist(10) <> Account0.total then
					nFindIdx = -1
					for i = 0 to CInt(Account0.accountcount) - 1
						Account0.currentindex = i
						if g_tRegist(10) == Account0.total then
							nFindIdx = i
						end if
					next
					
					if nFindIdx > -1 then
						Account0.currentindex = nFindIdx
					end if
					
					szVisibleAcnt = Account0.total
					nIdx = 0
					
					for i = 0 to CInt(Account1.accountcount) - 1
						Account1.currentindex = i
						szNvisibleAcnt = Account1.total
						
						if szNvisibleAcnt == szVisibleAcnt then
							nIdx = i
						end if
					next
					
					Account1.currentindex = nIdx
					
				end if
			end if
			
			if CInt(rdoCurrType.currentindex) == 0 then'원화
				if CInt(tabType.currenttab) == 0 then'자주
					DATAMANAGER.RequestTranData( "obrtp_tact_101a" )'계좌 등록
				else'타금융
					DATAMANAGER.RequestTranData( "obpds_srvc_040a_2" )'계좌 등록
				end if
			else'외화
				'20231117 이미 수취 조회를 한 상황이므로 바로 등록 서비스를 호출하게 수정
'				DATAMANAGER.RequestTranData( "obtsd_fbnk_121r" )
				
				if CInt(tabType.currenttab) == 0 then'자주쓰는
					DATAMANAGER.RequestTranData( "obrtp_tact_101a" )'계좌 등록
				else'타금융
					DATAMANAGER.RequestTranData( "obpds_srvc_180a_2" )'계좌 등록
				end if
			end if
		end if
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			if CInt(rdoCurrType.currentindex) == 0 then'원화
				DATAMANAGER.RequestTranData( "obpds_srvc_040a" )'타금융계좌 원화삭제
			else
				DATAMANAGER.RequestTranData( "obpds_srvc_180a" )'타금융계좌 외화삭제
			end if
			
		end if
	end if
End Sub

'============================================================================
Sub tabType_OnTabChanged(nCurrentTab)

	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	if nCurrentTab == 0 then
		rdoCurrType.top = 60
		grdList.visible = true
		grdList.rowcount = 0
		grdList0.rowcount = 0
		
		Account0.visible = false
		grdListTA.visible = false
		DATAMANAGER.RequestTranData( "obrtp_tact_102r" )
	else
		rdoCurrType.top = 60 + 42
		grdList.visible = false
		
		Account0.visible = true
		grdListTA.visible = true
		grdListTA.rowcount = 0
		grd069.rowcount = 0
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
	end if
End Sub

'============================================================================
Sub Account0_ChangeAccount()
	szVisibleAcnt = Account0.total
	nIdx = 0
	
	for i = 0 to CInt(Account1.accountcount) - 1
		Account1.currentindex = i
		szNvisibleAcnt = Account1.total
		
		if szNvisibleAcnt == szVisibleAcnt then
			nIdx = i
		end if
	next
	
	Account1.currentindex = nIdx
	
	g_bTr040Error = false
	g_szTr040ErrorMsg = ""
	g_bTr180Error = false
	g_szTr180ErrorMsg = ""
	
	grdListTA.rowcount = 0
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
End Sub

