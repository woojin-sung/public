'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	
	Form.SetScreenName("해외주식미체결")	

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   	= tData(0)
		g_szAcntCd 	= tData(1)
		g_szAcntPwd	= tData(2)
		
		DATAMANAGER.RequestTranData("obtro_oder_103r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'Dim szDate
	'szDate = Form.GetSharedData("&BIZ_DT", false)
	
	grdList.rowcount = 0
	
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_103r" then
		DATAMANAGER.ClearInputData(0, "obtro_oder_103r")
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "ACNO"			, 0 , g_szAcnt )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "ASNO"			, 0 , g_szAcntCd )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "ACNT_PWD"		, 0 , g_szAcntPwd )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "2")			' 체결구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "SELN_BYOV_CLCD"	, 0 , "0")			' 매매구분코드(0:전체, 1:매수, 2:매도)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "PROS_CLS"		, 0 , "2" )

		DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "DATA_CLS"		, 0 , "0" )
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem

	' ----------------------------------------------------------------------
	' 해외주식 미체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_103r" then
	
		For iCnt = grdList.rowcount - 1 To 0 Step -1
			
			'20201218 SWJ START : 해외주식 오프라인 주문 유럽국가 추가
			szMarket = grdList.GetCellData("bd_cell23", iCnt)
			'20201218 SWJ END
			
			szType 	= grdList.GetCellData("bd_cell9" , iCnt)
			szVndrCd	= grdList.GetCellData("bd_cell19", iCnt)
			szStatCd = grdList.GetCellData("bd_cell10" , iCnt)
			szRCType = grdList.GetCellData("bd_cell20" , iCnt)
			
			'20201124 LES START 해외주식 시장가매도
			szOrdType = grdList.GetCellData("bd_cell21", iCnt)
			
'			if szOrdType = "1" then
'				grdList.SetCellData("bd_cell12", iCnt, "시장가")
'			else
'				grdList.SetCellData("bd_cell12", iCnt, "지정가")
'			end if
			
			'20201124 LES END
			'20220526 START
			Select Case szOrdType
				Case "1"
					grdList.SetCellData("bd_cell12", iCnt, "시장가")
				Case "2"
					grdList.SetCellData("bd_cell12", iCnt, "지정가")
				Case "4"
					grdList.SetCellData("bd_cell12", iCnt, "LOO")
				Case "5"
					grdList.SetCellData("bd_cell12", iCnt, "LOC")
				Case "6"
					grdList.SetCellData("bd_cell12", iCnt, "MOO")
				Case "7"
					grdList.SetCellData("bd_cell12", iCnt, "MOC")
				Case "8"
					grdList.SetCellData("bd_cell12", iCnt, "Limit VWAP")
				Case "9"
					grdList.SetCellData("bd_cell12", iCnt, "Limit TWAP")
				Case "A"
					grdList.SetCellData("bd_cell12", iCnt, "VWAP")
				Case "B"
					grdList.SetCellData("bd_cell12", iCnt, "TWAP")
			End Select
			'20220526 END
			
			' 매매구분
			if szType == "1" then
				grdList.SetCellFgColor( "bd_cell2", iCnt, "2" )
				if szRCType == "1" then
					grdList.SetCellData("bd_cell2", iCnt, "매도정정")
				elseif szRCType == "2" then
					grdList.SetCellData("bd_cell2", iCnt, "매도취소")
				else
					grdList.SetCellData("bd_cell2", iCnt, "매도")
				end if
				
			elseif szType == "2" then
				grdList.SetCellFgColor( "bd_cell2", iCnt, "1" )
				if szRCType == "1" then
					grdList.SetCellData("bd_cell2", iCnt, "매수정정")
				elseif szRCType == "2" then
					grdList.SetCellData("bd_cell2", iCnt, "매수취소")
				else
					grdList.SetCellData("bd_cell2", iCnt, "매수")
				end if
				
			end if
			
			' 주문상태
			if szStatCd == "0" then
				grdList.SetCellData("bd_cell8", iCnt, "정상")
			elseif szStatCd == "1" then
				grdList.SetCellData("bd_cell8", iCnt, "거부")
			elseif szStatCd == "2" then
				grdList.SetCellData("bd_cell8", iCnt, "자동거부")
			elseif szStatCd == "3" then
				grdList.SetCellData("bd_cell8", iCnt, "자동취소")
			elseif szStatCd == "4" then
				grdList.SetCellData("bd_cell8", iCnt, "미접수")
			end if
			
		'20201218 SWJ START : 시장 컬럼에 거래소 보여주는 오류 수정	
			' 시장
			szVndrName = Transform_Name(szVndrCd)
			
			if szMarket = "01" then
				grdList.SetCellData("bd_cell23", iCnt, "미국")
				
			elseif szMarket = "02" then
				grdList.SetCellData("bd_cell23", iCnt, "홍콩")
				
			elseif szMarket = "03" then
				grdList.SetCellData("bd_cell23", iCnt, "상해")
				
			elseif szMarket = "04" then
				grdList.SetCellData("bd_cell23", iCnt, "심천")
				
			elseif szMarket = "05" then 
				grdList.SetCellData("bd_cell23", iCnt, "일본")
			
			elseif szMarket = "06" then
				grdList.SetCellData("bd_cell23", iCnt, "호주")
				
			elseif szMarket = "07" then
				grdList.SetCellData("bd_cell23", iCnt, "싱가폴")
				
			elseif szMarket = "08" then
				grdList.SetCellData("bd_cell23", iCnt, "영국")
			
			elseif szMarket = "09" then
				grdList.SetCellData("bd_cell23", iCnt, "영국")
			
			elseif szMarket = "10" then
				grdList.SetCellData("bd_cell23", iCnt, "독일")
			
			elseif szMarket = "11" then
				grdList.SetCellData("bd_cell23", iCnt, "핀란드")

			elseif szMarket = "12" then
				grdList.SetCellData("bd_cell23", iCnt, "프랑스")
			
			elseif szMarket = "13" then
				grdList.SetCellData("bd_cell23", iCnt, "벨기에")
			
			elseif szMarket = "14" then
				grdList.SetCellData("bd_cell23", iCnt, "네덜란드")
			
			elseif szMarket = "15" then
				grdList.SetCellData("bd_cell23", iCnt, "포르투갈")
			
			elseif szMarket = "16" then
				grdList.SetCellData("bd_cell23", iCnt, "그리스")
			
			elseif szMarket = "17" then
				grdList.SetCellData("bd_cell23", iCnt, "아일랜드")
				
			elseif szMarket = "18" then
				grdList.SetCellData("bd_cell23", iCnt, "이탈리아")
			
			elseif szMarket = "19" then
				grdList.SetCellData("bd_cell23", iCnt, "스페인")
			
			elseif szMarket = "20" then
				grdList.SetCellData("bd_cell23", iCnt, "오스트리아")
				
			elseif szMarket = "21" then
				grdList.SetCellData("bd_cell23", iCnt, "캐나다")
				
			elseif szMarket = "23" then
				grdList.SetCellData("bd_cell23", iCnt, "인도네시아")
				
			elseif szMarket = "24" then
				grdList.SetCellData("bd_cell23", iCnt, szVndrName)  '본래 시장명은 베트남이나, 베트남만 거래소명으로
			
			'20240321 HWG START : 스위스 거래소 오프라인 주문 대응
			elseif szMarket = "26" then
				grdList.SetCellData("bd_cell23", iCnt, "스위스")
			'20240321 HWG END
			end if 
		'20201218 SWJ END	
		
			' 주문가, 체결가
'			szDecimal = grdList.GetCellData("bd_cell11" , iCnt)
'			szVltnPrlsCamt = grdList.GetCellData("bd_cell4", iCnt)
'			szVltnPrlsCamt2 = Set_Unit(CDbl(szVltnPrlsCamt), szDecimal)
'			grdList.SetCellData("bd_cell4", iCnt, szVltnPrlsCamt2)
'		
'			szPsntPrc = grdList.GetCellData("bd_cell5", iCnt)
'			szPsntPrc2 = Set_Unit(CDbl(szPsntPrc), szDecimal)
'			grdList.SetCellData("bd_cell5", iCnt, szPsntPrc2)
		Next
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
	
	if lRow > -1 then
		szCd      	= grdList.GetCellData("bd_cell3" ,	lRow)
		szVndrCd	 	= grdList.GetCellData("bd_cell19",	lRow)
		szCdName	 	= grdList.GetCellData("bd_cell13",	lRow)
		szMicheQty	= grdList.GetCellData("bd_cell6" ,	lRow)
		szOdrNo   	= grdList.GetCellData("bd_cell1" ,	lRow)	
		szOdrPrc  	= grdList.GetCellData("bd_cell4" ,	lRow)
		szDate    	= grdList.GetCellData("bd_cell7" ,	lRow)
		szOrdType    	= grdList.GetCellData("bd_cell21" ,	lRow)

'20201218 SWJ START : 오프라인 종목 예외처리
		szOnCheck    = grdList.GetCellData("bd_cell24" , lRow)
		
		if szOnCheck == "N" then
			Form.ShowAlert("알림", "현재 화면에서 거래가 불가한 종목입니다. (마스터 정보없음)")
			exit sub
		end if
'20201218 SWJ END

		' 전달내용/종목코드/해외거래소벤더코드/종목명/주문일자/주문번호/미체결수량/주문가격/주문유형
		szData = "미체결" & "★" & szCd & "★" & szVndrCd & "★" & szCdName & "★" & szDate & "★" & szOdrNo & "★" & szMicheQty & "★" & szOdrPrc & "★" & szOrdType
		
		Form.SendReturnToParent("16060_CONTRACT", szData)
		Form.CloseForm()			
	end if	
End Sub

