'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	if szTranID == "obaci_nmet_011r" then
		szProsClsCode = ""
		szRsltCode    = ""
		
		szProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		szRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If szProsClsCode == "5" and TRIM(szRsltCode) <> "00" Then
			
			sReturnMsg = ReturnPwdErrorMsg(szRsltCode)
			
			Form.MsgBox("안내", "유효하지 않은 비밀번호 입니다.\n".. sReturnMsg, "", 0)
			
			Container0.EdtPwReal.caption = ""
			nCnt = 0
			PasswordFail()
			
		Else '비밀번호 입력 성공시
			
			Call PasswordInsert()
			
			'다음 화면에서 비번 재검증 위해 set
			Form.SetSharedData("CLOUD_CERT_PWDAuth",  Container0.EditReal.caption2 )
			
			g_nextpage = true
			Form.CloseForm()

		End If
	
	end if
	
	if szTranID == "obcsb_efif_183r" then
		g_sCloudCertID = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ELFN_ID" , 0)
		
		DATAMANAGER.RequestTranData("obaci_acct_239r") 
	end if
	
	if szTranID == "obaci_acct_239r" then
		'Array이지만 하나만 받아서 쓰자
		'비밀번호 정합성 체크 시 맨 위에 계좌번호로 체크해도
		' 업무적으로 문제 없다고 확인함
		g_sCloudAcno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNO" , 0)
		
		DATAMANAGER.RequestTranData("obacp_comm_004r") 

	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obaci_nmet_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "5")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_sCloudAcno ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , Container0.EditReal.caption2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     , 0 , g_ClphNo    ) '20230623 jsi 휴대폰 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WRPL_TELNO"     , 0 , g_WorkNo    ) '20230622 jsi 직장전화 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OWHS_TELNO"     , 0 , g_HomeNo    ) '20230622 jsi 자택전화 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0 , g_RcnoPip   )
		
	elseif szTranID == "obacp_comm_004r" then  '20230622 jsi obacp_comm_004r 연락처 정보 조회 전 세팅 /'비로그인 시에는 meritz로 세팅 되기 때문에 헤더값세팅

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"   , 0 , g_sCloudAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , g_sCloudCertID   )  

	end if
	
	if szTranID == "obcsb_efif_183r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DN_DATA"   , 0 , g_sCloudCertDN )
	end if

	if szTranID == "obaci_acct_239r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"   		 , 0 , g_sCloudCertID )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_STAT_CODE"   , 0 , "1" 			)
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub
'============================================================================
Sub Container0_BtnRegi_OnClick()
	Form.OpenPopup("mpopup_auth","CommonAuthPopup","")
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	if g_nextpage then
	
		'비번 재입력 팝업
		Form.OpenPopup( "mhetc90153_p2" , "ChangePwd" & "★" & g_sCloudCertID & "★" & g_sCloudCertDN , "")

		exit sub
	end if
	
	Form.SendReturnToParent("mhetc90153_p1" , "cancel")

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID == "obacp_comm_004r" then 
	    g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
	    g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
	    g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
	    
	    g_RcnoPip = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RCNO_PIP" 		, 0)  '실명확인번호
	    
	    DATAMANAGER.RequestTranData("obaci_nmet_011r") 
	end if
End Sub

'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)

	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("[에러1]" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if		
	
	'PIN 인증 완료
	if sCommand = "CLOUD_REQ_CHECK_PASSWD_90150" then
	
		if g_sScrPoint == "ChangePwd" then
			Form.OpenPopup("mhetc90153_p1" , "" , "")
		else
			g_nextpage = true
			
		    Form.SetSharedData("CLOUD_CERT_PHONENUM", g_ClphNo)
		    Form.SetSharedData("CLOUD_CERT_RCNO_PIP", g_RcnoPip)
	    
			Form.CloseForm()
		end if
		
	end if
	
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90153_p2" then
		if sRet == "ChangePwd" then
			Form.CloseForm()
		end if
	end if
End Sub
'============================================================================
Function ReturnPwdErrorMsg(sErrCode)

	Select Case sErrCode
	
	Case "06" '4-8 자리체크
		sErrMsg = "( 4 ~ 8자리 가능 )"
	Case "01"
		sErrMsg = "(연속된 4자리 숫자)"
	Case "02"
		sErrMsg = "(동일한 숫자)"
	Case "03"
		sErrMsg = "(휴대폰번호와 4자리 이상 일치)"
	Case "04"
		sErrMsg = "(자택번호와 4자리 이상 일치)"
	Case "05"
		sErrMsg = "(직장번호와 4자리 이상 일치)"
	Case "07"
		sErrMsg = "(실명확인번호와 4자리 이상 일치)"
	Case "08"
		sErrMsg = "(계좌번호와 4자리 이상 일치)"
	Case Else
		sErrMsg = ""
	End Select
	
	return sErrMsg
	
End Function
