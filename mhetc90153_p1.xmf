'============================================================================
' 2024.05.02 SWJ START
' 클라우드 인증 비밀번호 입력
'============================================================================
Dim nCnt, g_DeviceOS
nCnt = 0

Dim g_CharFlag
g_CharFlag = ""

Dim g_CountSave
Dim g_nextpage
g_nextpage = false

Dim g_HomeNo '20230622 jsi 연락처 조회 자택번호
Dim g_ClphNo '20230622 jsi 연락처 조회 휴대폰번호
Dim g_WorkNo '20230622 jsi 연락처 조회 직장번호

Dim g_sCloudID
g_sCloudID = ""

Dim g_sCloudAcno
g_sCloudAcno = ""

Dim g_sCloudRcnoPip
g_sCloudRcnoPip = ""

'진입점
Dim g_sScrPoint
g_sScrPoint = ""

'클라우드인증서DN
Dim g_sCloudCertDN
g_sCloudCertDN = ""

'클라우드인증서ID
Dim g_sCloudCertID
g_sCloudCertID = ""

Dim g_sPinPwd
g_sPinPwd = ""

'============================================================================
Sub Form_OnFormInit()
	
	Container0.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동
	
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO",true) '메뉴클릭시 팝업메뉴 화면번호 전달
	
'	g_sCloudID 	  = Form.GetSharedData("CLOUD_CERT_ID" , false )
'	g_sCloudAcno    = Form.GetSharedData("CLOUD_CERT_ACNO" , false)
'	g_sCloudRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP" , false)
	
	sTempData = Form.GetOpenLinkData()
	
	szData = Split(sTempData, "★")
	
	if Cint(#szData) > 1 then
		'진입점
		g_sScrPoint = szData(0)
		g_sCloudCertID = szData(1)
		g_sCloudCertDN = szData(2)
		
		Form.SetSharedData("CLOUD_CERT_ID" , g_sCloudCertID)
	else
		g_sScrPoint = sTempData
	end if 
	
	'비밀번호 입력키패드 Show
	Form.SetTimerEvent2(1, 1, 0.6)
End Sub
'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if g_DeviceOS == "2"  then
			Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
		elseif g_DeviceOS == "1" then
			Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
		end if
		
	elseif nCnt = 6 then
		
		'DATAMANAGER.RequestTranData("obcsb_efif_183r")
		
		'''''''''''''''''''''비밀번호 설정 불가 Case 서비스 호출''''''''''''''''''''''''''
		'DATAMANAGER.RequestTranData("obacp_comm_004r")   '20230622 jsi 비밀번호 검증 전 연락처 조회 호출
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		nCnt = 0
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.EditReal.SetShowKeypad(True)
				
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.1)
		
		

	elseif sTimerID == "3" or sTimerID == 3 then	
		Form.SetTimerEvent2(sTimerID, 0, 0.3)
		
		g_sPinPwd = Container0.EditReal.caption2 
		
		'PIN인증
		Form.requestCertCommand("CLOUD_REQ_CHECK_PASSWD", g_sCloudCertID & "★" & g_sPinPwd, "90150") 
		
	elseif sTimerID == "9999" or sTimerID == 9999 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
End Sub
'============================================================================
'사용자에게 보여지는 패스워드 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag = "N" then
		nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case nCnt
	
	Case 0
		Container0.Pwdbasic0.visible = true	
		Container0.Pwdbasic1.visible = true	
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
