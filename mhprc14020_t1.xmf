'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szDateLimit 	'날짜제한
dim g_szSelectedItem	'그리드내 선택된아이템

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'IsValidDate() : 입력된 날짜가 로직에 벗어나지 않는지 체크
'============================================================================
Function IsValidDate()
   
    dim bIsValidDate 
    dim szDataFrom   	
    dim szDataTo 	
    
    bIsValidDate = true
    szDataFrom   = cldFromDateT1.Caption
    szDataTo     = cldToDateT1.Caption
    	
	if szDataFrom < g_szDateLimit then
	    Form.ShowAlert( "알림" , "최근1년까지만 조회됩니다." )
	    cldFromDateT1.caption = g_szDateLimit
     end if 
	
	If Len(Trim(szDataFrom)) <> 8 then
		Form.ShowAlert( "알림" , "날짜입력이 정확하지 않습니다." )
		bIsValidDate = False
		Exit Function
	End if
	
	If Len(Trim(szDataTo)) <> 8 then
		Form.ShowAlert( "알림" , "날짜입력이 정확하지 않습니다." )
		bIsValidDate = False
		Exit Function
	End if
	

     If CDbl(Trim(szDataFrom)) > CDbl(Trim(szDataTo)) then
		Form.ShowAlert( "알림" , "날짜입력이 정확하지 않습니다." )
		bIsValidDate = False
		Exit Function
     End if

    
     If Trim(szDataFrom) > Form.GetSharedData( "&HOST_DATE" , 0 ) then
	    Form.ShowAlert( "알림" , "날짜입력이 정확하지 않습니다." )
	    bIsValidDate = False
	    Exit Function
	End if
	
	return 0
    
End Function


'============================================================================
'RenameHeader() : 설정값에 따라 그리드 헤더 변경
'============================================================================
Function RenameHeader()
	dim szSectBuySell
	dim szSectQtyAmt
	
'	0`매도상위
'	1`매수상위


'	0`수량(주)
'	1`금액(백만)
	
	
	szSectBuySell = cmbSortBuySellT1.cbkeydata
	szSectQtyAmt  = cmbSortQtyAmtT1.cbkeydata
	
	if szSectBuySell = "0"  then 			'매도
		if szSectQtyAmt = "0" then 			'수량
			grdT1.SetCellTopCaption("th_cell4", "순매도량")
		else
			grdT1.SetCellTopCaption("th_cell4", "순매도금액")
		end if 
	elseif szSectBuySell = "1" then         '매수
		if szSectQtyAmt = "0" then 			'수량
			grdT1.SetCellTopCaption("th_cell4", "순매수량")
		else
			grdT1.SetCellTopCaption("th_cell4", "순매수금액")
		end if 
	else
		Form.ShowAlert("알림", "구분값을 확인하세요.")
	end if 
	

End Function 


