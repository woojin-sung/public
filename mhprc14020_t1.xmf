'============================================================================
'Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_szDateLimit = DateAdd ("yyyy", -1, cldStandard.calyear &"-"& cldStandard.calmonth &"-"& cldStandard.calday)
	g_szDateLimit = replace(g_szDateLimit, "-", "")					'날짜 선택 LIMIT 저장
	
	
	cmbListMember.cbinputdatatext = Form.GetMemberComboData()
	cmbListMember.cbkeydata = "00010"									'메리츠투자증권 
	
'	cmbListMember.cbinputdatatext = Form.GetMetaComboData("회원사종류코드")
'	cmbListMember.cbkeydata = "010"									'메리츠투자증권 

	rdoToday_OnClick(1)
	
	DATAMANAGER.RequestTranData("ohhts_0512_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_0512_001r")
End Sub


'============================================================================
'cmbListMember_OnEditComplete
'============================================================================
Sub cmbListMember_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData("ohhts_1101_001r")
End Sub


'============================================================================
'cmbSortBuySellT1_OnEditComplete()
'============================================================================
Sub cmbSortBuySellT1_OnEditComplete(iIndex)
	call RenameHeader()
	DATAMANAGER.RequestTranData("ohhts_1101_001r")
End Sub


'============================================================================
'cmbSortQtyAmtT1_OnEditComplete()
'============================================================================
Sub cmbSortQtyAmtT1_OnEditComplete(iIndex)
	call RenameHeader()
	DATAMANAGER.RequestTranData("ohhts_1101_001r")
End Sub


'============================================================================
'rdoToday_OnClick
'============================================================================
Sub rdoToday_OnClick(nIndex)
	
	if nIndex = 0 then
		cldFromDateT1.visible = 0
		cldToDateT1.visible = 0
		lbl01.visible = 1
		lbl02.visible = 0
	else
		cldFromDateT1.visible = 1
		cldToDateT1.visible = 1
		lbl01.visible = 0 
		lbl02.visible = 1
	end if 
End Sub


'
'============================================================================
'cldFromDateT1_OnEditComplete
'============================================================================
Sub cldFromDateT1_OnEditComplete()
	call IsValidDate()
	DATAMANAGER.RequestTranData("ohhts_1101_001r")
End Sub


'============================================================================
'cldToDateT1_OnEditComplete
'============================================================================
Sub cldToDateT1_OnEditComplete()
	call IsValidDate()
	DATAMANAGER.RequestTranData("ohhts_1101_001r")
End Sub


'============================================================================
'grdT1_OnClickUp
'============================================================================
Sub grdT1_OnClickUp(lRow, szCellID)
	g_szSelectedItem	=	grdT1.GetCellData("bd_cell0", lRow)

	listLocation =  Split(grdT1.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "뉴스" & "★" & "매수" & "★" & "매도")
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTrzanID)
'Form.ShowAlert("test", cmbListMember.cbkeydata)
	DATAMANAGER.SetDataValue(0, "ohhts_1101_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , "000000")	' 22년 차세대 업종코드 하드코딩
	
	DATAMANAGER.SetDataValue(0, "ohhts_1101_001r", "InBlock1", "FID_INPUT_ISCD2", 0,  cmbListMember.cbkeydata)
	'DATAMANAGER.SetDataValue(0, "ohhts_1101_001r", "InBlock1", "FID_INPUT_ISCD2", 0,  "00" & cmbListMember.cbkeydata)

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n1101Cnt

	if szTranID = "ohhts_0512_001r" then
		cldFromDateT1.caption = DATAMANAGER.GetDataValue(0, "ohhts_0512_001r", "OutBlock1", "FID_STND_DATE1", 0)
		cldToDateT1.caption = DATAMANAGER.GetDataValue(0, "ohhts_0512_001r", "OutBlock1", "FID_STND_DATE2", 0)
		DATAMANAGER.RequestTranData("ohhts_1101_001r")
	end if 
	
	if szTranID = "ohhts_1101_001r" then
	  	n1101Cnt = CInt(grdT1.rowcount )
		if n1101Cnt > 0 then
			'--> 20230105 jipark HTS와 동일하게 보이도록 수정한다.
			nDayCmbCurrent = (rdoToday.currentindex)
			nBuyCellCurrent = (cmbSortBuySellT1.currentindex)
		
			For i = n1101Cnt To 0 Step -1
	
				bDelRow = false			
				'HTS화면에서 스크립트도 반만 가져온듯(매수 0인 row 삭제처리 주석)
			    'if grdT1.GetCellData("bd_cell3", i) = "0000000000000000000" then 
				'   grdT1.SetDeleteRow(i)
				'else
				
				if nDayCmbCurrent = "0" then		'당일데이터는 매수매도 데이터가 한번에 와서 deleterow를 해줘야한다.
					nValue = CLng(grdT1.GetCellData("bd_cell4", i))
					
					if nValue = 0 then
						bDelRow = true
					else
						if nBuyCellCurrent = "0" then	'매도상위
							if nValue > 0 then
								bDelRow = true
							end if
						else
							if nValue < 0 then	'메수상위
								bDelRow = true
							end if
						end if
					end if
					
					if bDelRow = true then
						grdT1.SetDeleteRow(i)
					end if
				
				end if
			'<-- 20230105 jipark
	
				if bDelRow = false then
					if cmbSortQtyAmtT1.cbkeydata == "1" then
						sAmt = grdT1.GetCellData("bd_cell5", i)
						if Len(sAmt) > 6 then
							grdT1.SetCellData("bd_cell4", i,Left(sAmt,Len(sAmt)-6))
						else
							grdT1.SetCellData("bd_cell4", i,"0")
						end if
					end if	
			    end if
			Next
		end if
	end if
	
	RenameHeader()
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'차트
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "3") 
		elseif 	szListItems(1)	=	"2"	then		'뉴스
			Form.OpenScreen("44000" , g_szSelectedItem ) 
		elseif 	szListItems(1)	=	"3"	then		'매수
			Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem ) 
		elseif 	szListItems(1)	=	"4"	then		'매도
			Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem ) 
		else
		end if
	end if 
End Sub



