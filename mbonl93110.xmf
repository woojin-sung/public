'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 저축장려계좌 투자비율조정
' 02. 화면설명 : 저축장려계좌 투자비율조정
' 03. 작    성 : 2021.05.07 장원혁
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'전역 변수 선언
Dim ACNO
Dim ASNO
Dim PASSWORD

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

    InitCtrl()

    DATAMANAGER.SetDataValue(0 , "obsai_deal_089r" , "InBlock1" , "CSNO" , 0 , Form.GetSharedData("&CUST_NUM", false ))
    DATAMANAGER.RequestTranData("obsai_deal_089r")
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	  
    If szTranID == "obsai_deal_089r" Then
    
        ACNO = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO" , 0)
        ASNO = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ASNO" , 0)
        PRNM = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PRCD_NAME" , 0)
        Form.SetCtlProp("CmbAcnt" , "cbadddatatext" , Left(ACNO,4)&"-"&Right(ACNO,4)&"-"&ASNO&" "&PRNM)

    End If
    
    If szTranID == "obacp_opop_066r" Then
        
        ACNO = Left(REPLACE(CmbAcnt.caption,"-",""),8)
        ASNO = MID(REPLACE(CmbAcnt.caption,"-",""),9,2) 
        DATAMANAGER.SetDataValue(0 , "obrtp_save_016r" , "InBlock1" , "ACNO" , 0 , ACNO)
        DATAMANAGER.SetDataValue(0 , "obrtp_save_016r" , "InBlock1" , "ASNO" , 0 , ASNO)
        DATAMANAGER.RequestTranData("obrtp_save_016r")
    End If
    
    If szTranID == "obrtp_save_015a" Then
        InitCtrl()
          
        Form.ShowAlert("알림", "신청이 완료되었습니다.")
    End If
	  
    If szTranID == "obrtp_save_016r" Then
    
        TKWR_ABLE_QTY = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TKWR_ABLE_QTY" , 0)
        DEAL_ACNO  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DEAL_ACNO"     , 0)
        DEAL_ASNO  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DEAL_ASNO"     , 0)
        
        TableMain.SetCellString(1, 0, "008560"     )
        TableMain.SetCellString(1, 1, "메리츠증권" )
        TableMain.SetCellString(1, 2, TKWR_ABLE_QTY)
        TableMain.SetCellString(3, 0, 0            )
        TableMain.SetCellString(3, 1, DEAL_ACNO & DEAL_ASNO  )
	
        EdtApltQty.enable = True
        BtnAplt.enable = True
	
    End If
	  
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If strMsg = "" Then
        Form.ShowAlert("알림", szErrMsg)
    Else
        Form.ShowAlert("알림", szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")")
    End If	
    
    If szTranID == "obacp_opop_066r" Then
        InitCtrl()
    End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
    
    If sKeyName == "APLT_YN" Then
        If sRet == "ok" Then
            Run()
        End If
    End If	
End Sub

'============================================================================
Sub EdtPW_OnEditComplete()

    ACNO = Left(REPLACE(CmbAcnt.caption,"-",""),8) '작대기 제거
    PWD = EdtPW.caption

    DATAMANAGER.SetDataValue(0, "obacp_opop_066r" , "InBlock1" , "ACNO"     , 0 , ACNO)
    DATAMANAGER.SetDataValue(0, "obacp_opop_066r" , "InBlock1" , "ACNT_PWD" , 0 , PWD )
    DATAMANAGER.RequestTranData("obacp_opop_066r")
    
End Sub

'============================================================================
Sub InitCtrl()
    TableMain.SetCellString(1 , 0 , "")
    TableMain.SetCellString(1 , 1 , "")
    TableMain.SetCellString(1 , 2 , "")
    TableMain.SetCellString(3 , 0 , "")
    TableMain.SetCellString(3 , 1 , "")
    EdtApltQty.caption = ""
    EdtApltQty.enable = False
    BtnAplt.enable = False
End Sub

'============================================================================
Sub BtnAplt_OnClick()

	RMND_QTY = TableMain.GetCellString(1 , 2)
	APLT_QTY = EdtApltQty.caption

    If APLT_QTY == "" Then
        APLT_QTY = 0
    End If
    
    If RMND_QTY == "" Then
        RMND_QTY = 0
    End If

	If CDBL(APLT_QTY) == 0 Then
         ErrMsg = "희망매도수량을 입력해주세요."
         Form.ShowAlert("알림", ErrMsg)
         Exit Sub
	End If
	
	If CDBL(APLT_QTY) > CDBL(RMND_QTY) Then
         ErrMsg = "신청수량이 출고가능수량보다 큽니다."
         Form.ShowAlert("알림", ErrMsg)
         Exit Sub
	End If

    Form.MsgBox("알림", "신청하시겠습니까?\n(신청수량 : " & APLT_QTY & "주)", "APLT_YN", 1)
	
End Sub

'============================================================================
Sub Run()

    RMND_QTY = TableMain.GetCellString(1 , 2)
    APLT_QTY = EdtApltQty.caption

    ACNT_NO = Left(REPLACE(CmbAcnt.caption,"-",""),10)
    DEAL_ACNT_NO = TableMain.GetCellString(3 , 1)

    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "PROS_CLS_CODE" , 0 , "I"                  )
    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "ACNO"          , 0 , Left(ACNT_NO,8)      )
    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "ASNO"          , 0 , Right(ACNT_NO,2)     )
    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "ISCD"          , 0 , "A008560"            )
    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "APLT_QTY"      , 0 , APLT_QTY             )
    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "DEAL_ACNO"     , 0 , Left(DEAL_ACNT_NO,8) )
    DATAMANAGER.SetDataValue(0 , "obrtp_save_015a" , "InBlock1" , "DEAL_ASNO"     , 0 , Right(DEAL_ACNT_NO,2))	
    
    DATAMANAGER.RequestTranData("obrtp_save_015a")
    
End Sub


