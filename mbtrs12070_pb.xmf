'============================================================================
' 화 면 명 : 권리공매도_잔고팝업
' 화면설명 : 권리공매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2018.09.12 이학록
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect
g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect = "", "", "", "", "", ""

'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	Dim nRate, nData
	Dim szData, szReturnValue
	Dim nVLTN_PRLS_AMT, nBYNG_AMT, nEXPN_AMT	' 평가손익, 매입금액, 비용금액
	
	nVLTN_PRLS_AMT = 0
	nBYNG_AMT      = 0
	
	For i = 0 To grdList.rowcount -1
		If chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT	= CDbl(grdList.GetCellData("bd_cell6", i)) - CDbl( grdList.GetCellData("bd_cell0", i) )
		
		Else
			nVLTN_PRLS_AMT	= CDbl( grdList.GetCellData( "bd_cell6", i ) )
		End If	
	
		nBYNG_AMT 	  	= CDbl(grdList.GetCellData("bd_cell8", i))
		nPSNT_PRC		= grdList.GetCellData("bd_Hyun", i)
		szData			= grdList.GetCellData("bd_Gbn", i)
		
		grdList.SetCellData("bd_cell6", i, nVLTN_PRLS_AMT)
		
		'매입금액이 있는 경우에만 계산
		If CDbl(grdList.GetCellData("bd_cell8", i) ) = 0 Then
			grdList.SetCellData("bd_cell7", i, "" )
		Else
			grdList.SetCellData("bd_cell7", i, Round( (nVLTN_PRLS_AMT /nBYNG_AMT) * 100, 2))
		End If
			
		
		If nPSNT_PRC = "" and chk2.checkstate = "1" Then
			nData = CDbl(grdList.GetCellData("bd_cell13", i)) * -1
			
			grdList.SetCellData("bd_LoanCd", i, nData)
		End If
						
		Select Case szData
			Case "0000"	szReturnValue = "보통"
			Case "0101"	szReturnValue = "자기융자"
			Case "0102"	szReturnValue = "유통융자"
			Case "0103"	szReturnValue = "자기대주"
			Case "0104"	szReturnValue = "유통대주"
			Case "0201"	szReturnValue = "예탁주식"
			Case "0202"	szReturnValue = "예탁채권"
			Case "0203"	szReturnValue = "예탁집합투자"
			Case "0204"	szReturnValue = "예탁장외파생"
			Case "0211"	szReturnValue = "예탁유통주식"
			Case "0212"	szReturnValue = "예탁유통채권"
			Case "0213"	szReturnValue = "예탁유통집합투자"
			Case "0214"	szReturnValue = "예탁유통장외파생"
			Case "0301"	szReturnValue = "매도증권담보대출"
			Case "0302"	szReturnValue = "수익증권환매"
			Case "0303"	szReturnValue = "ELS환매자금대출"
			Case "0401"	szReturnValue = "소액주식"
			Case "0402"	szReturnValue = "소액채권"
			Case "0403"	szReturnValue = "소액수익증권"
			Case "0404"	szReturnValue = "소액 ELS"
			Case "0501"	szReturnValue = "공모주청약"
			Case "0502"	szReturnValue = "ELS청약"
			Case "0503"	szReturnValue = "주식매입"
			Case "0601"	szReturnValue = "매입자금대출"
			Case "0701"	szReturnValue = "초단기대출"
			Case "7777"   szReturnValue = "권리입고예정"
			Case "0801"	szReturnValue = "CMA담보대출"
		End Select
		
		'20180123 LES START - 대여주문 '20180904 대여주석처리
'		if szData == "0000" then
'			if grdList.GetCellData("bd_cell2", i) == "31" then
'				szReturnValue = "대여"
'			end if
'		end if
		
		grdList.SetCellData("bd_Gbn", i, szReturnValue)
	Next	
	
'	nRate = Round((nVLTN_PRLS_AMT / nBYNG_AMT) * 100, 2)	
'
'	tbl0.SetCellString(0, 3, nVLTN_PRLS_AMT)		'미실현손익
'	tbl0.SetCellString(1, 3, nRate)				'손익률
End Function

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	DATAMANAGER.RequestTranData("obtrs_comn_340r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
		
	Dim szChkVal2
	szChkVal2 = Form.LoadConfigData( "mbtrs12070", "balance2" )		'비용반영

	Form.SetScreenName("권리입고예정주식 잔고")
	
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	
	If szChkVal2 <> "" Then
		chk2.checkstate = szChkVal2
	End If

	
	szOpen = Form.GetOpenLinkData()
	g_szChk = "0"
	
	
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
		g_szGbn    = tData(3)
	'	chk1.checkstate = tData(4)
		if tData(3) == "1" then		' 예약주문에서 여는경우
			'chk1.left = 1000
			chk2.left = 1000
			grdList.top = 0
			grdList.height = 563		
		end if
		
			
		Request_Data()
	end if
	
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szFEE_INCU_YN
	
	
	'비용반영
	if g_szGbn == "1" then		' 예약주문에서 조회
		szFEE_INCU_YN = "N"
	else
		if chk2.checkstate = "1" then
			szFEE_INCU_YN = "Y"
		else
			szFEE_INCU_YN = "N"
		end if
	end if


	' ----------------------------------------------------------------------
	' 계좌 실시간 잔고조회(권리공매
	' ----------------------------------------------------------------------			
	If szTranID = "obtrs_comn_340r" Then
		DATAMANAGER.ClearInputData(0,"obtrs_comn_340r" )
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_340r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_340r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_340r", "InBlock1", "ACNT_PWD"	, 0, "")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_340r", "InBlock1", "FEE_INCU_YN"		, 0, szFEE_INCU_YN)			
	ElseIf szTranID = "obpds_srvc_326r" Then
		DATAMANAGER.ClearInputData(0, "obpds_srvc_326r")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ACNO" 			, 0, g_szAcnt)		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ONLN_YN" 		, 0, "Y")
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	' ----------------------------------------------------------------------
	' 계좌 실시간 잔고조회(권리공매
	' ----------------------------------------------------------------------		
	If szTranID = "obtrs_comn_340r" Then
		SetGridData()
	End If
End Sub
'============================================================================
' chk2_OnChange
'============================================================================

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

	if lRow > -1 then
		szCd       = grdList.GetCellData("bd_Cd",       lRow)
		szQty      = grdList.GetCellData("bd_Able",     lRow)
		szLoanDate = grdList.GetCellData("bd_LoanDate", lRow)	
		szLoanCd   = grdList.GetCellData("bd_LoanCd",   lRow)	
		szLoanSr   = grdList.GetCellData("bd_LoanSr",   lRow)
		
		
		
		
		'20180123 LES START - 대여주문
		szScrNo	  = Form.GetSharedData("&SCREEN_NO", false )
		szClcd 	  = grdList.GetCellData("bd_cell2", lRow)
		
		if szScrNo = "12060" then
			if szClcd <> "31" then
				Form.ShowAlert("알림", "해당종목은 대여주문화면에서 주문실행이 불가능 합니다.")
				Exit Sub
			end if
		
		else
			if szClcd == "31" then
				Form.ShowAlert("알림", "해당종목은 대여주문화면에서 주문실행하시기 바랍니다.")
				Exit Sub
			end if
				
		end if
		'20180123 LES END - 대여주문
		
		
		'20161205 ETN이나 신주인수권 등 6자리가 아닌 종목은 Q나 J를 붙여서 종목안내창에 표기하므로
		'  그 부분에 대한 처리를 하여야 한다고 함.
		' 20160310 주문불가한 종목 예외처리
		'szCutCd = Mid(szCd, 2, Len(szCd))
'		if Left(Trim(szCd), 1) <> "J" Then 
'		   szCutCd = Mid(szCd, 2, Len(szCd))
'		else
'		   szCutCd = szCd
'		end if
'		
'		'20170502 상장수익증권 예외처리
'		if Left(Trim(szCd), 1) == "F" Then
'		   szCutCd = szCd			
'		end if
'		
'		szMk = Form.GetItemCodeInfo(szCutCd, "market")

'20180416 LES
'  if Left(g_szItemCode,3) == "106" then
'   g_szItemMarket = "J"
'  end if
  
		
		
		if(left(szCd,1) == "J" and len(szCd) == 9) or left(szCd,1) == "Q" or left(szCd,1) == "F" then
			szMk = Form.GetItemCodeInfo(szCd, "market")
		else
			szCutCd = Mid(szCd,2,len(szCd))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
		end if
		
		
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
	'		if g_szGbn == "2" then		' 호가주문 예외처리
	'			if Trim(szLoanCd) <> "0000" then
	'				Form.ShowAlert("알림", "신용주문은 일반주문을 이용해주시기 바랍니다.")
	'				Exit Sub
	'			end if
	'		end if
			
			'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
			szData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr
			g_szSelect = "1"
			
			Form.SendReturnToParent("12000_BALANCE", szData)
			Form.CloseForm()
		else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		end if
	end if
End Sub
'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Dim szData
	
	if g_szSelect <> "1" then
		'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		szData = "잔고" & "★" & g_szTab & "★★♥♥♥" & "0" & "♥"
		Form.SendReturnToParent("12000_BALANCE", szData)
	end if
	
	Form.SaveConfigData("mbtrs12070", "balance2", chk2.checkstate ) '비용반영
End Sub



'============================================================================
Sub grdList_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtrs_comn_340r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub
'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData("obtrs_comn_340r")
End Sub

