End Function

Function RequestTranData_tbl1(szData0, szData1)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_011r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_011r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_011r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_011r", "InBlock1", "FID_RQST_CSNU"	, 0 , "2")
	
	DATAMANAGER.RequestTranData("ohhts_metf_011r")
End Function

Function ResponseTranData_tbl1()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_011r", "OutBlock1")

	for i = 0 to nDataCnt-1
		szItem0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_OVRS_ISCD" , i)
		szItem1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FIDX_KOR_ISNM" , i)
		szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_PRPR" , i)
		szItem3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_NAV", i)
		szItem4 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_ASET_TOT", i)
		szItem5 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_ERNN_RATE" , i)
		szItem6 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_TOTAL_PAY_RATE" , i)
		szItem7 = DATAMANAGER.GetDataValue(0, "ohhts_metf_011r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i)
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"1", "caption", trim(szItem0))
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"2", "caption", trim(szItem7))
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"3", "caption", szItem2)
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"2", "visible", false)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"1", "visible", false)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"0", "visible", true)
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"0", "caption",  trim(szItem1))
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"0", "maxlinecnt",  "2^-4")
		
		szResult = 0
		if szItem3 <> "" and Cdbl(szItem3) <> 0 then
			szResult = FormatNumber(szItem3,2)
		else
			szResult = "-"
		end if
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"4", "caption", szResult )
		
		szResult = 0
		if szItem4 <> "" and Cdbl(szItem4) <> 0 then
			if szItem7 = "J" then
				szResult = FormatNumber(Round(Cdbl(Clng(szItem4) / 100000000),2), 2)
			else
				szResult = FormatNumber(Round(Cdbl(Clng(szItem4) / 1000),2),2)
			end if
		else
			szResult = "-"
		end if
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"5", "caption", szResult)
		
		if szItem5 = "" then
			szItem5 = "-"
		else
			szItem5 = szItem5 & "%"
		end if
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"6", "caption", szItem5)
		
		szResult = ""
		if Cdbl(szItem6) = 0 then
			szResult = "-"
		else
			szResult = szItem6 & "%"
		end if
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"7", "caption", szResult)
	next
End Function

Function Request_Tran_ohhts_6000_001r()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0 , "OV" )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_szOnlyCd )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_szExidCd)
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_szRtChk)

	DATAMANAGER.RequestTranData("ohhts_6000_001r")
End Function

Function Process_Tran_ohhts_6000_001r()
	szData0 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_AVLS", 0)				'시가총액
	szData1 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_LSTN_STCN", 0)			'상장주수
	szData2 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_PER", 0)				'PER
	szData3 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_EPS", 0)				'EPS
	szData4 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE", 0)			'매매통화
	szData5 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT", 0)	'매매단위
	szData9 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_SDPR", 0)			'기준가
	szData12 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_BSTP_MDDV_NAME", 0)	'업종명
	
'	'시가총액(천)
'	if szData0 <> "" then
'		szResult = FormatNumber(Round(Cdbl(Clng(szData0) / 1000),2), 2)
'		contMain.lblData0.caption = szResult
'	else
'		contMain.lblData0.caption = "-"
'	end if
'	
'	'상장주수(천)
'	if szData1 <> "" then
'		szResult = FormatNumber(Round(Cdbl(Clng(szData1) / 1000),0), 0)
'		contMain.lblData1.caption = szResult
'	else
'		contMain.lblData1.caption = "-"
'	end if
	
	'PER
	if szData2 <> "" then
		contMain.contMid.lblData6.caption = FormatNumber(szData2, 3)
	else
		contMain.contMid.lblData6.caption = "-"
	end if
	
	'EPS
	if szData3 <> "" then
		contMain.contMid.lblData7.caption = FormatNumber(szData3, 3)
	else
		contMain.contMid.lblData7.caption = "-"
	end if
	
	'매매통화
	if szData4 <> "" then
		contMain.contMid.lblData8.caption = szData4
	else
		contMain.contMid.lblData8.caption = "-"
	end if
	
	'매매단위
	if szData5 <> "" then
		contMain.contMid.lblData9.caption = Cdbl(szData5)
	else
		contMain.contMid.lblData9.caption = "-"
	end if
	
	'기준가
	if szData9<> "" then
		szResult = ""
		if g_szExidCd == "AX" or g_szExidCd == "NY" or g_szExidCd == "OQ" then
			 szResult = FormatNumber(szData9, 4)
		elseif g_szExidCd == "SH" or g_szExidCd == "SZ" or g_szExidCd == "HK" then
			 szResult = FormatNumber(szData9, 3)
		elseif g_szExidCd == "JP" then
			 szResult = FormatNumber(szData9, 1)
		end if
		
		contMain.contMid.lblData13.caption = szResult
	else
		contMain.contMid.lblData13.caption= "-"
	end if
	
'	'업종명
'	if szData12 <> "" then
'		contMain.lblData12.caption = szData12
'	else
'		contMain.lblData12.caption = "-"
'	end if
	
End Function

Function Request_Tran_obsim_oscm_331r()
	DATAMANAGER.ClearInputData(false, "obsim_oscm_331r")
	
	DATAMANAGER.SetDataValue( false, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , g_szOnlyCd.."."..g_szExidCd )
	
	DATAMANAGER.RequestTranData("obsim_oscm_331r")
End Function

Function Process_Tran_obsim_oscm_331r()
	sSellOnly   = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN", 0) ' 매수불가여부
	sStatus     = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock1", "TRHT_YN", 0) 		' 거래정지여부
	sWeekDate   = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "STND_DATE", 0) 	' 기준일
	sMrktCls    = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "HLDY_YN", 0) 		' 휴일여부
	
	sWeekDate = WeekDay( CDate( Left( sWeekDate, 4 ) & "-" & Mid( sWeekDate, 5, 2 ) & "-" & Right( sWeekDate, 2 ) ) )
	If Trim( sMrktCls ) = "Y" And sWeekDate <> "1" And sWeekDate <> "7" Then		'일요일, 토요일 제외
		contMain.contMid.lblData12.caption = "휴장"
	Else
		if g_sClsCd == "Y" then
			contMain.contMid.lblData12.caption = "거래정지"
		else
			if g_sSellOnly == 1 then
				contMain.contMid.lblData12.caption = "매도만 가능"
			else
				contMain.contMid.lblData12.caption = "정상"
			end if
		end if
	End If	
End Function

Function Request_Tran_obsim_oscm_350r()
	DATAMANAGER.ClearInputData(false, "obsim_oscm_350r")
	
	DATAMANAGER.SetDataValue( false, "obsim_oscm_350r", "InBlock1", "ISCD" , 0 , g_szOnlyCd.."."..g_szExidCd )
	
	DATAMANAGER.RequestTranData("obsim_oscm_350r")
End Function

Function Process_Tran_obsim_oscm_350r()
	szData6 = DATAMANAGER.GetDataValue( false, "obsim_oscm_350r", "OutBlock1", "MGRT_VAL" , 0)				'증거금율
	szData7 = DATAMANAGER.GetDataValue( false, "obsim_oscm_350r", "OutBlock1", "LOAN_ABLE_YN" , 0)			'대출가능여부
	
	'증거금울
	if szData6 <> "" then
		contMain.contMid.lblData10.caption = FormatNumber(szData6, 0) & "%"
	else
		contMain.contMid.lblData10.caption = "-"
	end if
	
	'대출가능여부
	if szData7 == "Y" then
		contMain.contMid.lblData11.caption = "가능"
	elseif szData7 == "N" then
		contMain.contMid.lblData11.caption = "불가능"
	else
		contMain.contMid.lblData11.caption = "-"
	end if
End Function

'==============================================
' 거래소코드 -> 거래소명 변환 
'==============================================
Function Transform_Exid(sValue)
	if sValue == "NY" then
		contMain.contMid.lblData14.caption = "미국"
		contMain.contMid.lblData15.caption = "뉴욕"
	elseif sValue == "OQ" then
		contMain.contMid.lblData14.caption = "미국"
		contMain.contMid.lblData15.caption = "나스닥"
	elseif sValue == "AX" then
		contMain.contMid.lblData14.caption = "미국"
		contMain.contMid.lblData15.caption = "아멕스"
	elseif sValue == "HK" then
		contMain.contMid.lblData14.caption = "홍콩"
		contMain.contMid.lblData15.caption = "홍콩"
	elseif sValue == "SH" then
		contMain.contMid.lblData14.caption = "중국"
		contMain.contMid.lblData15.caption = "상해"
	elseif sValue == "SZ" then
		contMain.contMid.lblData14.caption = "중국"
		contMain.contMid.lblData15.caption = "심천"
	elseif sValue == "JP" then
		contMain.contMid.lblData14.caption = "일본"
		contMain.contMid.lblData15.caption = "도쿄"
	else
		contMain.contMid.lblData14.caption = "-"
		contMain.contMid.lblData15.caption = "-"
	end if
	
end Function

Function Expand_Cont()
	'첫실행
	if g_isExpand == "" then
		g_isExpand = false
		contMain.contMid.height = 150
'		contMain.contExpand.top = contMain.contExpand.top - 115 '340
'		contMain.contBottom.top = contMain.contBottom.top - 115 '400
'
		contMain.contExpand.lblExpand.caption = "펼치기"
		
		nWidth = Form.getTextWidth("펼치기", -4, false, false)
		contMain.contExpand.imgArrow.left = 188 + (nWidth/2) + 5
		
		contMain.contExpand.imgArrow.imgpath = g_ImgArrow_Down
		
'		g_nContMainHeight = g_nContMainHeight - 115
'		Form.triggerEvent("#", "CHANGE_LAYOUT_S2", g_nContMainHeight)
		
	'펼치기 -> 접기 
	elseif g_isExpand == true then
		g_isExpand = false
		contMain.contMid.height = 150
		contMain.contExpand.top = contMain.contExpand.top - 115 '340
		contMain.contBottom.top = contMain.contBottom.top - 115 '400

		contMain.contExpand.lblExpand.caption = "펼치기"
		
		nWidth = Form.getTextWidth("펼치기", -4, false, false)
		contMain.contExpand.imgArrow.left = 188 + (nWidth/2) + 5
	
		contMain.contExpand.imgArrow.imgpath = g_ImgArrow_Down
		g_nContMainHeight = g_nContMainHeight - 115
		Form.triggerEvent("#", "CHANGE_LAYOUT_S2", g_nContMainHeight)
		
	'접기 -> 펼치기
	else
		g_isExpand = true
		
		contMain.contMid.height = 270
		contMain.contExpand.top = contMain.contExpand.top + 115 '460
		contMain.contBottom.top = contMain.contBottom.top + 115 '520
		contMain.contExpand.lblExpand.caption = "접기"
		
		nWidth = Form.getTextWidth("접기", -4, false, false)
		contMain.contExpand.imgArrow.left = 188 + (nWidth/2) + 5
		
		contMain.contExpand.imgArrow.imgpath = g_ImgArrow_Up
		g_nContMainHeight = g_nContMainHeight + 115
		Form.triggerEvent("#", "CHANGE_LAYOUT_S2", g_nContMainHeight)
	end if
	

End Function

