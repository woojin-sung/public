'============================================================================
Sub contMain_contBottom_lblSubData10_OnClick()
	szItemCd = contMain.contBottom.lblSubData11.caption
	szMktCd = contMain.contBottom.lblSubData12.caption
	
		Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			szItemCd = szMktCd & "@" & szItemCd
			
			szItemNm = Form.GetItemCodeInfo(szItemCd, "name")
			if szItemNm = "" or szItemNm = null then
				exit Sub
			end if
			
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )
			if g_szScreenNo <> "16000" and g_szScreenNo <> "16100" then
				if g_szScreenNo = "11000" then
					Form.OpenScreen("16000","")	
				elseif g_szScreenNo == "13100" then
					Form.OpenScreen("16100","")	
				end if
			end if
			'Form.OpenScreen("16000", szItemCd)	
			
'			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", szItemCd)
		Case Else
			szItemNm = Form.GetItemCodeInfo(szItemCd, "name")
			if szItemNm = "" or szItemNm = null then
				exit Sub
			end if
			
			Form.OpenScreen("11000", szItemCd)

'			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", "J@"&szItemCd)
	End Select
End Sub
'============================================================================
