Sub contMain_lblExpand_OnClick()
	szItemNm = Form.getItemCodeInfo(g_szItemCd, "name")
	Form.OpenPopup("mhtro16000_p11" , szItemNm & "★" & contMain.lblInfo0.caption , sPosInfo)
End Sub


'============================================================================
Sub contMain_contMid_imgTooltip0_OnClick()
	sText = "국가별 보수 조회 기준\n- 미국, 한국 : 총보수(운용보수+기타비용)\n- 중국, 홍콩, 일본 : 운용보수"
	contMain.contMid.imgTooltip0.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.contMid.imgTooltip0.openToolTip( sText, 350, 80, 2 )
	else
		contMain.contMid.imgTooltip0.openToolTip( sText, 300, 80, 2 )
	end if
	
End Sub

'============================================================================
Sub contMain_contBottom_imgTooltip1_OnClick()
	sText = "순자산 기준 단위\n- 한국 : 억원\n- 미국, 중국, 홍콩, 일본 : 천 달러"
	contMain.contBottom.imgTooltip1.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.contBottom.imgTooltip1.openToolTip( sText, 300, 80, 2 )
	else
		contMain.contBottom.imgTooltip1.openToolTip( sText, 250, 80, 2 )
	end if
	
	
End Sub

'============================================================================
Sub contMain_contBottom_imgTooltip2_OnClick()
	sText = "NAV 업데이트 기준\n- 국내 : 당일 오전 9시 30분경\n- 미국, 중국, 홍콩, 일본 : 당일 오전 6시경"
	contMain.contBottom.imgTooltip2.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.contBottom.imgTooltip2.openToolTip( sText, 350, 80, 2 )
	else
		contMain.contBottom.imgTooltip2.openToolTip( sText, 300, 80, 2 )
	end if
	
	
End Sub

'============================================================================
Sub contMain_contBottom_imgTooltip3_OnClick()
	sText = "동일한 기초지수를 추종하는 펀드 중\n순자산 상위 2개 종목과 비교해보세요."
	contMain.contBottom.imgTooltip3.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.contBottom.imgTooltip3.openToolTip( sText, 340, 60, 2 )
	else
		contMain.contBottom.imgTooltip3.openToolTip( sText, 290, 60, 2 )
	end if
	
	
End Sub


