'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID  = "ohhts_metf_011r" then
		ResponseTranData_tbl1()
	elseif szTranID  = "ohhts_metf_010r" then
		ResponseTranData_tbl0()
		szTemp = contMain.lblInfo0.caption
	elseif szTranID == "ohhts_6000_001r" then
		Process_Tran_ohhts_6000_001r()
		
	elseif szTranID == "obsim_oscm_331r" then
		Process_Tran_obsim_oscm_331r()
		
	elseif szTranID == "obsim_oscm_350r" then
		Process_Tran_obsim_oscm_350r()
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		Clear_Data() 
		
		g_szItemCd = sParam
		g_szExidCd = ""
		if instr(g_szItemCd, "@") > 0 then
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 

			g_szRtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			
			contMain.lblMore0.visible = false
			contMain.lblSubTitle1.caption = "상품정보 (단위 : USD)"

			contMain.lblSubTitle1.changeTextAttr(0,5,334,0,true)
			contMain.lblSubTitle1.changeTextAttr(5,10,333,-6,true)
			
			'해외 - 괴리율 미표기
			contMain.lblTitle18.visible = false
			contMain.lblData12.visible = false
			
			'286 / 314 / 342 / 390
'			contMain.lblTitle6.top = 282
'			contMain.lblData6.top = 282
'			
'			contMain.lblTitle9.top = 282
'			contMain.lblData9.top = 282
'			contMain.imgTooltip0.top = 290
'			
'			contMain.lblTitle5.top = 310
'			contMain.lblData5.top = 310
'			
'			contMain.lblTitle10.top = 310
'			contMain.lblData10.top = 312
'			
'			contMain.lblLine4.top = 348
'			contMain.lblLine5.height = 100
'			
'			contMain.contBottom.top = 384
			
			contMain.lblTitle3.caption = "시가총액(천)"
			contMain.lblTitle4.caption = "순자산(천,$)"
			
			contMain.contBottom.lblTitle11.caption = "종목명"
			
'			contMain.contBottom.lblTitle14.caption = "순자산\n(천,$)"
'			contMain.contBottom.lblTitle14.changeTextAttr(4,5,333,-10,false)
			
			contMain.contBottom.lblTitle15.caption = "수익률(1Y)"
			'contMain.contBottom.lblTitle15.changeTextAttr(4,6,333,-10,false)

			
			RequestTranData_tbl0(g_szOnlyCd, g_szExidCd)
			RequestTranData_tbl1(g_szOnlyCd, g_szExidCd)
			Transform_Exid(g_szExidCd)
			Request_Tran_ohhts_6000_001r()
			Request_Tran_obsim_oscm_331r()
			Request_Tran_obsim_oscm_350r()
		else
			contMain.lblSubTitle1.caption = "상품정보 (단위 : 원)"

			contMain.lblSubTitle1.changeTextAttr(0,5,334,0,true)
			contMain.lblSubTitle1.changeTextAttr(5,8,333,-6,true)
			
			'국내 - 괴리율 표기
			contMain.lblTitle18.visible = true
			contMain.lblData12.visible = true
			
			
			
			'314 / 342 / 370 / 418
'			contMain.lblTitle6.top = 310
'			contMain.lblData6.top = 310
'			
'			contMain.lblTitle9.top = 310
'			contMain.lblData9.top = 310
'			
'			if Form.GetSharedData("&OS_TYPE", false) = "1" then
'				contMain.imgTooltip0.top = 318
'			else
'				contMain.imgTooltip0.top = 317
'			end if
'			
'			contMain.lblTitle5.top = 338
'			contMain.lblData5.top = 338
'			
'			contMain.lblTitle10.top = 338
'			contMain.lblData10.top = 338
''			
'			contMain.lblLine4.top = 376
'			contMain.lblLine5.height = 125
''			
'			contMain.contBottom.top = 412
			
			
			contMain.lblTitle3.caption = "시가총액(억)"
			contMain.lblTitle4.caption = "순자산(억)"
			
			contMain.contBottom.lblTitle11.caption = "종목명"
			
'			contMain.contBottom.lblTitle14.caption = "순자산\n(억,원)"
'			contMain.contBottom.lblTitle14.changeTextAttr(4,5,333,-10,false)
			
			contMain.contBottom.lblTitle15.caption = "수익률(1Y)"
			'contMain.contBottom.lblTitle15.changeTextAttr(4,6,333,-10,false)
			
			g_szOnlyCd = g_szItemCd
			g_szExidCd = "J"
			g_szRtChk = ""
			
			contMain.contMid.lblTitle6.caption = "과세유형"
			contMain.contMid.lblTitle7.caption = "과세가격"
			
			nTaxprice	= Form.GetItemCodeInfo( g_szOnlyCd, "taxprice"		)	'과표기준가격
			szTaxtypecd	= Form.GetItemCodeInfo( g_szOnlyCd, "taxtype"		)	'과표유형기준
			
			
			'과세유형(0:해당없음 1:증권거래세 2:배당소득세(보유기관과세) 3:증권거래세(회사형ETF)
			szTaxtype = ""
			Select Case Form.GetItemCodeInfo( g_szOnlyCd, "taxtype" )	
				Case "0"	szTaxtype = "해당없음"
				Case "1"	szTaxtype = "증권거래세"
		'		Case "2"	szTaxtype = "배당소득세(보유기관과세)"
				Case "2"	szTaxtype = "배당소득세"
		'		Case "3"	szTaxtype = "증권거래세(회사형ETF)"
				Case "3"	szTaxtype = "증권거래세"
				Case Else szTaxtype = ""
			End Select
			
			contMain.contMid.lblData6.caption = szTaxtype
			contMain.contMid.lblData7.caption = FormatNumber(szTaxtypecd, 0)
			
			RequestTranData_tbl0(g_szOnlyCd, g_szExidCd)
			RequestTranData_tbl1(g_szOnlyCd, g_szExidCd)
		end if
		
		if g_isChange == true then
			contMain.lblSubTitle0.visible = false
			contMain.lblMore0.visible = false
			contMain.lblLine0.visible = false
			contMain.lblTitle0.visible = false
			contMain.lblData0.visible = false
			contMain.lblTitle1.visible = false
			contMain.lblData1.visible = false
			contMain.lblTitle2.visible = false
			contMain.lblData2.visible = false
			contMain.lblTitle17.visible = false
			contMain.lblData11.visible = false
			contMain.lblExpand.visible = false
			contMain.lblLine3.visible = false
			contMain.lblDiv0.visible = false
			
			contMain.contMid.top = 0
			contMain.contExpand.top  =  270 - 115
			contMain.contBottom.visible = false
			g_nContMainHeight = 270 - 115 + 45
			Form.triggerEvent("#", "CHANGE_LAYOUT_S2", g_nContMainHeight)
			
			exit Sub
		end if
		
		if g_szExidCd = "J" then
			contMain.contMid.height = 150
			contMain.contExpand.top = 380
			contMain.contBottom.top = 445
			
			contMain.contExpand.height = 35
			contMain.contExpand.lblExpand.visible = false
			contMain.contExpand.imgArrow.visible = false
			contMain.contExpand.lblDiv1.top = 30
			
			
			g_nContMainHeight = 808
			Form.triggerEvent("#", "CHANGE_LAYOUT_S2", g_nContMainHeight)
		else
			g_isExpand = true
			Expand_Cont()

		end if
		
		
	elseif sEventName == "CHANGE_LAYOUT" then
		g_isChange = true
		
		
	end if
End Sub

