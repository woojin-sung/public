	contMain.contExpand.lblLine1.bgcolor = g_szLineColor3
	contMain.contExpand.lblDiv1.bgcolor = g_szLineColor3
	
	contMain.lblMore0.paddinginfo = "0,0,0,0"
	contMain.lblMore0.fgcolor = g_szTxtColor_Grey
	
	contMain.lblTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle1.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle2.paddinginfo = "0,0,0,0"
	
	contMain.lblData0.fgcolor = g_szTxtColor_Normal
	contMain.lblData0.paddinginfo = "0,0,0,0"
	contMain.lblData0.maxlinecnt = "1"
	
	contMain.lblData1.fgcolor = g_szTxtColor_Normal
	contMain.lblData1.paddinginfo = "0,0,0,0"
	contMain.lblData1.maxlinecnt = "1"
	
	contMain.lblData2.fgcolor = g_szTxtColor_Normal
	contMain.lblData2.paddinginfo = "0,0,0,0"
	
'	contMain.lblInfo0.maxlinecnt = "3^-2"
'	contMain.lblInfo0.fgcolor = g_szTxtColor_Grey
'	contMain.lblInfo0.paddinginfo = "0,0,0,0"
	
	
	
	contMain.lblTitle3.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle3.paddinginfo = "0,0,0,0"
	contMain.lblTitle3.maxlinecnt = "1"
	
	contMain.lblTitle4.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle4.paddinginfo = "0,0,0,0"
	contMain.lblTitle5.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle5.paddinginfo = "0,0,0,0"
	contMain.lblTitle6.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle6.paddinginfo = "0,0,0,0"
	contMain.lblTitle7.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle7.paddinginfo = "0,0,0,0"
	contMain.lblTitle8.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle8.paddinginfo = "0,0,0,0"
	contMain.lblTitle9.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle9.paddinginfo = "0,0,0,0"
	contMain.lblTitle10.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle10.paddinginfo = "0,0,0,0"
	contMain.lblTitle17.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle17.paddinginfo = "0,0,0,0"
	contMain.lblTitle18.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle18.paddinginfo = "0,0,0,0"
	
	
	contMain.contBottom.lblTitle11.fgcolor = g_szTxtColor_Grey
	contMain.contBottom.lblTitle11.paddinginfo = "5,0,0,0"
	contMain.contBottom.lblTitle12.fgcolor = g_szTxtColor_Grey
	contMain.contBottom.lblTitle12.paddinginfo = "5,0,0,0"
	contMain.contBottom.lblTitle13.fgcolor = g_szTxtColor_Grey
	contMain.contBottom.lblTitle13.paddinginfo = "5,0,0,0"
	contMain.contBottom.lblTitle14.fgcolor = g_szTxtColor_Grey
	contMain.contBottom.lblTitle14.paddinginfo = "5,0,0,0"
	contMain.contBottom.lblTitle15.fgcolor = g_szTxtColor_Grey
	contMain.contBottom.lblTitle15.paddinginfo = "5,0,0,0"
	contMain.contBottom.lblTitle16.fgcolor = g_szTxtColor_Grey
	contMain.contBottom.lblTitle16.paddinginfo = "5,0,0,0"
	contMain.contBottom.lblTitle15.maxlinecnt = "1"
'	contMain.contBottom.lblTitle14.changeTextAttr(4,6,333,-10,false)
'	contMain.contBottom.lblTitle15.changeTextAttr(4,6,333,-10,false)
	'contMain.contBottom.lblTitle15.fgcolor = g_szTxtColor_Grey
	
	contMain.lblData0.fgcolor = g_szTxtColor_Normal
	contMain.lblData1.fgcolor = g_szTxtColor_Normal
	contMain.lblData2.fgcolor = g_szTxtColor_Normal
	
	contMain.lblData3.fgcolor = g_szTxtColor_Normal
	contMain.lblData3.paddinginfo = "0,0,0,0"
	contMain.lblData4.fgcolor = g_szTxtColor_Normal
	contMain.lblData4.paddinginfo = "0,0,0,0"
	contMain.lblData5.fgcolor = g_szTxtColor_Normal
	contMain.lblData5.paddinginfo = "0,0,0,0"
	contMain.lblData6.fgcolor = g_szTxtColor_Normal
	contMain.lblData6.paddinginfo = "0,0,0,0"
	contMain.lblData7.fgcolor = g_szTxtColor_Normal
	contMain.lblData7.paddinginfo = "0,0,0,0"
	contMain.lblData8.fgcolor = g_szTxtColor_Normal
	contMain.lblData8.paddinginfo = "0,0,0,0"
	contMain.lblData9.fgcolor = g_szTxtColor_Normal
	contMain.lblData9.paddinginfo = "0,0,0,0"
	contMain.lblData10.fgcolor = g_szTxtColor_Normal
	contMain.lblData10.paddinginfo = "0,0,0,0"
	contMain.lblData12.fgcolor = g_szTxtColor_Normal
	contMain.lblData12.paddinginfo = "0,0,0,0"
	
	contMain.contMid.imgTooltip0.setMaintainingRatio("2")
	contMain.contMid.imgTooltip0.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("연보수", -4, true, false)
	contMain.contMid.imgTooltip0.left = 20 + nTextWidth + 5
	
	contMain.contBottom.imgTooltip1.setMaintainingRatio("2")
	contMain.contBottom.imgTooltip1.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("순자산", -4, true, false)
	contMain.contBottom.imgTooltip1.left = 23 + nTextWidth + 5
	
	contMain.contBottom.imgTooltip2.setMaintainingRatio("2")
	contMain.contBottom.imgTooltip2.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("NAV", -4, true, false)
	contMain.contBottom.imgTooltip2.left = 23 + nTextWidth + 5
	
	contMain.contBottom.imgTooltip3.setMaintainingRatio("2")
	contMain.contBottom.imgTooltip3.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("동일 벤치마크 펀드", 0, true, false)
	contMain.contBottom.imgTooltip3.left = 20 + nTextWidth + 5
	
	
	contMain.contMid.setEnableScroll(false)
	contMain.contExpand.lblExpand.fgcolor = g_szTxtColor_Grey
	
'	contMain.contBottom.lblTitle14.setNeighborCtlPos("imgTooltip1", "right", 5, "순자산")
'	contMain.contBottom.lblTitle13.setNeighborCtlPos("imgTooltip2", "right", 5, "NAV")
'	contMain.contBottom.lblSubTitle2.setNeighborCtlPos("imgTooltip3", "right", 5, "동일 벤치마크 펀드")
'	contMain.contMid.lblTitle4.setNeighborCtlPos("imgTooltip0", "right", 3, "연보수")
	
	
	for i = 0 to 2
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"0", "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"1", "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"2", "fgcolor", g_szTxtColor_Grey)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"2", "maxlinecnt", "2^-6")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"3", "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"4", "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"5", "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"5", "maxlinecnt", "1^-20")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"6", "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"7", "fgcolor", g_szTxtColor_Normal)
		
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"0", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"1", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"2", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"3", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"4", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"5", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"6", "paddinginfo", "3,0,3,0")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"7", "paddinginfo", "3,0,3,0")
		
	next
	
	for i = 0 to 15
		Form.SetCtlProp("contMain.contMid.lblTitle"&i, "fgcolor", g_szTxtColor_Grey)
		Form.SetCtlProp("contMain.contMid.lblTitle"&i, "paddinginfo", "0,0,0,0")
		
		Form.SetCtlProp("contMain.contMid.lblData"&i, "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.contMid.lblData"&i, "paddinginfo", "0,0,0,0")
	next
	
	contMove.btnHyun.paddinginfo = "0,0,0,0"
	contMove.btnChart.paddinginfo = "0,0,0,0"
	contMove.btnInfo.paddinginfo = "0,0,0,0"
	contMove.btnOrder0.paddinginfo = "0,0,0,0"
	contMove.btnOrder1.paddinginfo = "0,0,0,0"
	
	contMove.btnHyun.fgcolor = g_szTxtColor_Grey
	contMove.btnChart.fgcolor = g_szTxtColor_Grey
	contMove.btnInfo.fgcolor = g_szTxtColor_Grey
	contMove.btnOrder0.fgcolor = g_szTxtColor_White
	contMove.btnOrder1.fgcolor = g_szTxtColor_White
	contMain.contExpand.imgArrow.maintainratio = "1"
	Expand_Cont()
End Function

Function Clear_Data() 
	contMain.lblData0.caption = ""
	contMain.lblData1.caption = ""
	contMain.lblData2.caption = ""
	contMain.lblInfo0.caption = ""
	
	for i = 0 to 10
		Form.SetCtlProp("contMain.contBottom.lblData"&i, "caption", "")
	next
	
	for i = 0 to 2
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"1", "caption", "")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"2", "caption", "")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"3", "caption", "")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"4", "caption", "")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"5", "caption", "")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"6", "caption", "")
		Form.SetCtlProp("contMain.contBottom.lblSubData"&i&"7", "caption", "")
	next
End Function

'===============================================
' 데이터 초기설정
'===============================================
Function Init_Data()
	g_arrNation = {}
	g_arrNation_Check = {}
End Function

Function RequestTranData_tbl0(szData0, szData1)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_010r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_010r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_010r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_010r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , g_szRtChk)
	
	DATAMANAGER.RequestTranData("ohhts_metf_010r")
End Function

Function ResponseTranData_tbl0()
	'기초지수
	szItem0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_FNDT_NMIX", 0)
	'운용사
	szItem1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FIDX_MGCO_NAME", 0)
	'설정일
	szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_LSTN_DATE", 0)
	'순자산
	szItem3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_ETF_NTAS_TTAM", 0)
	'구성종목수
	szItem4 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_ETF_CNFG_ISSU_CNT", 0)
	'레버리지
	szItem5 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_LVRG", 0)
	'괴리율
	szItem6 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_ETF_DPRT", 0)
	'배당수익률
	szItem7 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_INPUT_DVDN_ERT", 0)
	'보수율
	szItem8 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_PAY_RATE", 0)
	'배당금
	szItem9 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FIDX_DVMN", 0)
	'배당주기
	szItem10 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_DVDN_CYCL", 0)
	'상장주수
	szItem11 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_LSTN_STCN", 0)
	'시가총액
	szItem12 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_AVLS", 0)
	
	'통화코드
	szItem13 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FIDX_CRNC_CODE", 0)
	
	'통화코드(연합)
	szItem14 = DATAMANAGER.GetDataValue(0, "ohhts_metf_010r", "OutBlock1", "FID_CNNM", 0)
	
	'=============================================================================================
	'기초지수
	if szItem0 = "N/A" or szItem0 = "" then
		szItem0 = "-"
	end if

	contMain.lblData0.caption = szItem0
	
	'운용사
	if szItem1 = "" then
		szItem1 = "-"
	end if
	
	contMain.lblData1.caption = szItem1
	
	'설정일
	contMain.lblData2.caption = "-"
	if szItem2 <> "" and Cint(szItem2) <> 0 then
		szData = left(szItem2, 4) & "년 " & cint(mid(szItem2, 5, 2)) &"월 " &  Cint(right(szItem2, 2))&"일"
		contMain.lblData2.caption = szData
	end if
	
	'상품설명 예외처리
	szInfo = contMain.lblInfo0.caption

	if trim(szInfo) = "" and g_isChange == false then
		contMain.lblExpand.caption = "-"
		contMain.lblExpand.enable = false
		
		contMain.lblExpand.visible = false
		contMain.lblData11.visible = false
		contMain.lblTitle17.visible = false
		
		if Form.GetSharedData("&OS_TYPE", false) = "1" then
			contMain.lblLine3.top = Form.calcUnResize(contMain.lblLine3.top, 1) - 28
			contMain.lblDiv0.top = Form.calcUnResize(contMain.lblDiv0.top, 1) - 28
		else
			contMain.lblLine3.top = contMain.lblLine3.top - 28
			contMain.lblDiv0.top = contMain.lblDiv0.top - 28
		end if
		
		contMain.contMid.top = contMain.contMid.top - 28
		contMain.contExpand.top = contMain.contExpand.top - 28
		contMain.contBottom.top = contMain.contBottom.top - 28
		g_nContMainHeight = g_nContMainHeight - 28

		Form.triggerEvent("#", "CHANGE_LAYOUT_S2", g_nContMainHeight)
	end if
	
	
	if g_szExidCd <> "J" and trim(szItem14) <> "" then
		contMain.lblTitle3.maxlinecnt = "1"
		
		if trim(szItem14) = "USD" then
			contMain.lblTitle4.caption = "순자산(천)"
		end if
'		if g_szExidCd = "OQ" or g_szExidCd = "OQ" or g_szExidCd = "OQ" then
'			if trim(szItem13) <> "USD" then
'				contMain.lblTitle3.maxlinecnt = "2"
'				contMain.lblTitle3.caption = "시가총액\n(천/USD)"
'				
'				contMain.lblTitle3.changeTextAttr(5,7,333,-8,true)
'			end if
'		elseif g_szExidCd = "SH" or g_szExidCd = "SZ" then
'			if trim(szItem13) <> "CNY" then
'				contMain.lblTitle3.maxlinecnt = "2"
'				contMain.lblTitle3.caption = "시가총액\n(천/CNY)"
'				
'				contMain.lblTitle3.changeTextAttr(5,7,333,-8,true)
'			end if
'		elseif g_szExidCd = "HK" then
'			if trim(szItem13) <> "HKD" then
'				contMain.lblTitle3.maxlinecnt = "2"
'				contMain.lblTitle3.caption = "시가총액\n(천/HKD)"
'				
'				contMain.lblTitle3.changeTextAttr(5,7,333,-8,true)
'			end if
'		elseif g_szExidCd = "JP" then
'			if trim(szItem13) <> "JPY" then
'				contMain.lblTitle3.maxlinecnt = "2"
'				contMain.lblTitle3.caption = "시가총액\n(천/JPY)"
'				
'				contMain.lblTitle3.changeTextAttr(5,7,333,-8,true)
'			end if
'		end if
		
		contMain.lblSubTitle1.caption = "상품정보 (단위 : "&trim(szItem14)&")"
		contMain.contMid.lblSubTitle1.caption = "기본정보 (단위 : "&trim(szItem14)&")"

		contMain.lblSubTitle1.changeTextAttr(0,5,334,0,true)
		contMain.lblSubTitle1.changeTextAttr(5,10,333,-6,true)
		
		contMain.contMid.lblSubTitle1.changeTextAttr(0,5,334,0,true)
		contMain.contMid.lblSubTitle1.changeTextAttr(5,10,333,-6,true)
	end if
	'=============================================================================================
	'시가총액
	szResult = 0
	if szItem12 <> "" and Cdbl(szItem12) <> 0 then
		nResult = Clng(szItem12)
		szResult = ""
		
		if nResult > 99999999 then
			szResult = FormatNumber(Round(Cdbl(nResult / 100000000),0), 0)
			contMain.contMid.lblTitle0.caption = "시가총액(억)"
		else
			szResult = FormatNumber(Round(Cdbl(nResult / 1000),0), 0)
			contMain.contMid.lblTitle0.caption = "시가총액(천)"
		end if
	else
		szResult = "-"
	end if
		
	contMain.lblData3.caption = szResult
	contMain.contMid.lblData0.caption = szResult

	'상장주수
	if Cdbl(szItem11) = 0 then
		szItem11 = "-"
	else
		szItem11 = FormatNumber(Cdbl(Cdbl(szItem11) / 1000), 0)
	end if
	
	contMain.lblData7.caption = szItem11
	contMain.contMid.lblData1.caption = szItem11
	
	'순자산
	szResult = 0
	if szItem3 <> "" and Cdbl(szItem3) <> 0 then
		nResult = Clng(szItem3)
		szResult = ""
		
		if nResult > 99999999 then
			szResult = FormatNumber(Round(Cdbl(nResult / 100000000),0), 0)
			contMain.contMid.lblTitle2.caption = "순자산(억)"
		else
			szResult = FormatNumber(Round(Cdbl(nResult / 1000),0), 0)
			contMain.contMid.lblTitle2.caption = "순자산(천)"
		end if
	else
		szResult = "-"
	end if

	contMain.lblData4.caption = szResult
	contMain.contMid.lblData2.caption = szResult
	
	'레버리지
	if szItem5 <> "" and Cdbl(szItem5) <> 0 then
		contMain.lblData8.caption = Cdbl(szItem5) & "배"
		contMain.contMid.lblData3.caption = Cdbl(szItem5) & "배"
	else
		contMain.lblData8.caption = "-"
		contMain.contMid.lblData3.caption = "-"
	end if
	
	'연보수
	szResult = ""
	if Cdbl(szItem8) = 0 then
		szResult = "-"
	else
		szResult = FormatNumber(szItem8,4) & "%"
	end if
		
	contMain.lblData9.caption = szResult
	contMain.contMid.lblData4.caption = szResult
	
	
	'괴리율
	contMain.lblData12.caption = FormatNumber(szItem6, 4) & "%"
	contMain.contMid.lblData5.caption =  FormatNumber(szItem6, 4) & "%"
	
'	'배당율
'	if Cdbl(szItem7) = 0 then
'		szItem7 = "-"
'	else
'		szItem7 = FormatNumber(szItem7, 4) & "%"
'	end if
'	contMain.lblData5.caption = szItem7
'	
'	'배당주기
'	if szItem10 = "" then
'		szItem10 = "-"
'	end if
'	contMain.lblData6.caption = szItem10
'	
'	
'	
'	'배당금
'	if Cdbl(szItem9) = 0 then
'		szItem9 = "-"
'	else
'		if g_szExidCd = "J" then
'			szItem9 = FormatNumber(szItem9,0)
'		else
'			szItem9 = FormatNumber(szItem9,4)
'		end if
'	end if
