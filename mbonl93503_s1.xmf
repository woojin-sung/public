	<SCRIPT_INFO _len="13905" _ulen="12317" >
Dim g_szAccount
Dim g_szCustGb
Dim g_szCustNm
Dim g_bPopup
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitData" then
		g_bPopup = false
		if sParam ~= "" then
			Dim tOpenData
			tOpenData = Split(sParam, "★")
			'g_szAcno & "★" & g_szAsno & "★" & g_szEdtPwd & "★" & g_szCustClsCode & "★" &  cmbAcnt.accountname
			g_szAccount = tOpenData[0]
			g_szCustGb  = tOpenData[3]
			'g_szCustNm  = Form.GetSharedData( "&USER_NAME"	, false )	'고객명 'tOpenData[4]
			g_szCustNm  = tOpenData[4]
			if trim(g_szCustNm) == "" then
				'g_szCustNm  = Form.GetSharedData( "&USER_NAME"	, false )	'고객명 'tOpenData[4]
				DATAMANAGER.RequestTranData("obcsb_acif_000r")
			else
				cont.tblData.SetCellString(0, 0, g_szCustNm.."님의 적정성 판단 결과")
			end if
			
			if trim(tOpenData[5]) ~= null and trim(tOpenData[5]) ~= "" then
				g_bPopup = true
			end if
	
			'대출 고객정보 확인서 응답 조회
			DATAMANAGER.RequestTranData("oblon_basc_102r")
		end if 
'	elseif sEventName == "SCROLL_DOWN" then
'		Form.ShowAlert("TEST", "TEST")
'		cont.scroll_pos = Form.calcUnResize( cont.height, "1") 
	end if 
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	'대출 고객정보 확인서 응답 조회
	if szTranID = "oblon_basc_102r" then
	    if trim(g_szAccount) <> "" then
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccount )
	    end if
	elseif szTranID == "obcsb_acif_000r" then
	    if trim(g_szAccount) <> "" then
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccount )
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "I" )
	    end if
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	'대출 고객정보 확인서 응답 조회
	if szTranID = "oblon_basc_102r" then
		if DATAMANAGER.IsMoreNextData(szTranID) = true then
			DATAMANAGER.RequestNextData(szTranID)
		else			
			'개인/법인
			Dim szAnxtAprtYn  
			szAnxtAprtYn  = DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "ANXT_APRT_YN" , 0)			
			if szAnxtAprtYn = "Y" then
				cont.tblData.SetCellString(1, 0, "부적정")
				cont.tblData.SetCellFgColor( 1, 0, "290" )
			elseif szAnxtAprtYn = "N" then
				cont.tblData.SetCellString(1, 0, "적정")
				cont.tblData.SetCellFgColor( 1, 0, "291" )
			else
				cont.tblData.SetCellString(1, 0, "-")
				cont.tblData.SetCellFgColor( 1, 0, "267" )
			end if
			
			Dim szStartDay
			Dim szEndDay			
			szStartDay = trim(DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "REG_DATE" , 0))
			szEndDay   = trim(DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "MTRT_DATE" , 0))
			
			if szStartDay == "" then
				cont.tblData.SetCellString(2, 0, "등록일 -")
			else
				szStartDay = Left(szStartDay, 4).."."..Mid(szStartDay, 5,2).."."..Right(szStartDay, 2)
				cont.tblData.SetCellString(2, 0, "등록일 "..szStartDay)
			end if
			
			if szEndDay == "" then
				cont.tblData.SetCellString(2, 1, "만기일 -")
			else
				szEndDay = Left(szEndDay, 4).."."..Mid(szEndDay, 5,2).."."..Right(szEndDay, 2)
				cont.tblData.SetCellString(2, 1, "만기일 "..szEndDay)
			end if
			
			if g_szCustGb == "1" then '개인
				Dim tTitle
				tTitle = {"연령대", "대출용도", "자산현황", "소득현황", "부채현황", "원리금\n연체여부", "신용점수", "변제계획","신용 공여\n이해도"}
				
				for i = 0 to #tTitle - 1
					cont.grdList.AddRow()
					cont.grdList.SetCellData("bd_Title", i, tTitle[i])
				next
				
				cont.grdList.height = 30 + (CInt(cont.grdList.rowcount) * 40)
				cont.imggrdList.height = 30 + (CInt(cont.grdList.rowcount) * 40) + 6
				
				'231218 대출용도에 따라 설명서 체크되도록 수정
				Dim nTemp
				nTemp = 0 
				
				Dim szData2
				for i = 0 to cont.Grid0.rowcount - 1
					Dim QUES_QSIT_NO
					Dim ITEM_NO_VAL
					Dim ITEM_CNTT
					Dim RSPN_SLCT_YN
					Dim TRGT_AMT
					
					QUES_QSIT_NO = CLNG(cont.Grid0.GetCellData("bd_cell0", i)) '설문문항번호
					ITEM_NO_VAL  = cont.Grid0.GetCellData("bd_cell1" , i) '항목번호값
					ITEM_CNTT    = cont.Grid0.GetCellData("bd_cell2"   , i) '항목내용
					RSPN_SLCT_YN = cont.Grid0.GetCellData("bd_cell3", i) '응답선택여부
					TRGT_AMT	 = CDBL(cont.Grid0.GetCellData("bd_cell4" , i)) '대상금액
					
					if QUES_QSIT_NO == 4 or QUES_QSIT_NO == "4" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"19세 이하", "20~40세", "41~60세", "61~70세", "71~80세"}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 0, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 1 or QUES_QSIT_NO == "1" then
						if RSPN_SLCT_YN = "Y" then 
							if szData2 == "" or szData2 == null then
								szData2 = "(신용)주식매수"
							else
								szData2 = szData2.."/(신용)주식매수"
							end if
							nTemp = nTemp + 1 '231218 대출용도에 따라 설명서 체크되도록 수정
						end if
						
					elseif QUES_QSIT_NO == 2 or QUES_QSIT_NO == "2" then
						if RSPN_SLCT_YN = "Y" then 
							if szData2 == "" or szData2 == null then
								szData2 = "(대주)주식대주"
							else
								szData2 = szData2.."/(대주)주식대주"
							end if
							nTemp = nTemp + 3 '231218 대출용도에 따라 설명서 체크되도록 수정
						end if
						
					elseif QUES_QSIT_NO == 3 or QUES_QSIT_NO == "3" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"금융투자상품매수", "가계자금", "법인 자금", "다른 대출금 상환 등"}
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							if szData2 == "" or szData2 == null then
								szData2 = "(담보대출)"..tData[nIndex]
							else
								szData2 = szData2.."/(담보대출)"..tData[nIndex]
							end if
							nTemp = nTemp + 5 '231218 대출용도에 따라 설명서 체크되도록 수정
						end if
					'LHR 수정
					elseif QUES_QSIT_NO == 5 or QUES_QSIT_NO == "5" then
						if RSPN_SLCT_YN = "Y" then 
							'cont.grdList.SetCellData("bd_Data",2, TRGT_AMT.."원")
							Dim tData
							tData = {"1억원 이하","3억원 이하","5억원 이하","10억원 이하","10억원 초과"}
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 2, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 6 or QUES_QSIT_NO == "6" then
						if RSPN_SLCT_YN = "Y" then 
							'cont.grdList.SetCellData("bd_Data", 3, TRGT_AMT.."원")
							Dim tData
							tData = {"1천만원 이하","3천만원 이하","5천만원 이하","1억원 이하","10억원 초과"}
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 3, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 7 or QUES_QSIT_NO == "7" then
						if RSPN_SLCT_YN = "Y" then 
							'cont.grdList.SetCellData("bd_Data", 4, TRGT_AMT.."원")
							Dim tData
							tData = {"1천만원 이하","3천만원 이하","5천만원 이하","1억원 이하","10억원 초과"}
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 4, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 8 or QUES_QSIT_NO == "8" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"해당없음", "연체 중"}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 5, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 12 or QUES_QSIT_NO == "12" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"515점 이상", "515점 미만"}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 6, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 13 or QUES_QSIT_NO == "13" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"근로소득", "임대소득", "연금소득", "사업소득", "매도상환", "다른 대출을 통한 상환 등"}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 7, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 14 or QUES_QSIT_NO == "14" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"신용공여를 사용해 본 적이 있으며, 신용공여에 대해 잘 이해하고 있다.", 
									"신용공여를 사용해 본 적이 있으나, 신용공여에 대해 잘 알지 못 한다", 
									"신용공여를 사용해 본 적이 없다. ", 
									"신용공여를 사용해 본 적은 없으나, 주식투자 경험이 3년 이상으로 신용공여에 대해 잘 이해하고 있다.", 
									"신용공여를 사용해 본 적이 없으며, 거래하고 싶지 않다."}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 8, tData[nIndex])
						end if
					end if
				next 
				
				if szData2 ~= "" and szData2 ~= null then
					cont.grdList.SetCellData("bd_Data", 1, szData2)
					
					'231218 대출용도에 따라 설명서 체크되도록 수정
					Form.triggerEvent("#", "SetchkAgree", nTemp) 					
				end if
				
			else
				'법인
				Dim tTitle
				tTitle = {"대출용도", "자본금 규모", "부채현황", "당기 순이익", "변제계획","신용 공여\n이해도"}
				
				for i = 0 to #tTitle - 1
					cont.grdList.AddRow()
					cont.grdList.SetCellData("bd_Title", i, tTitle[i])
				next
				
				cont.grdList.height = 30 + (CInt(cont.grdList.rowcount) * 40)
				cont.imggrdList.height = 30 + (CInt(cont.grdList.rowcount) * 40) + 6
				for i = 0 to cont.Grid0.rowcount - 1
					Dim QUES_QSIT_NO
					Dim ITEM_NO_VAL
					Dim ITEM_CNTT
					Dim RSPN_SLCT_YN
					Dim TRGT_AMT
					
					QUES_QSIT_NO = CLNG(cont.Grid0.GetCellData("bd_cell0", i)) '설문문항번호
					ITEM_NO_VAL  = cont.Grid0.GetCellData("bd_cell1" , i) '항목번호값
					ITEM_CNTT    = cont.Grid0.GetCellData("bd_cell2"   , i) '항목내용
					RSPN_SLCT_YN = cont.Grid0.GetCellData("bd_cell3", i) '응답선택여부
					'TRGT_AMT	 = CDBL(cont.Grid0.GetCellData("bd_cell4" , i)) '대상금액
					TRGT_AMT = FormatNumber(cont.Grid0.GetCellData("bd_cell4" , i),0)
					if QUES_QSIT_NO == 3 or QUES_QSIT_NO == "3" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"금융투자상품매수", "가계자금", "법인 자금", "다른 대출금 상환 등"}
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 0, tData[nIndex])							
						end if
						
					elseif QUES_QSIT_NO == 9 or QUES_QSIT_NO == "9" then
						if RSPN_SLCT_YN = "Y" then 
							cont.grdList.SetCellData("bd_Data",1, TRGT_AMT.."원")
						end if
						
					elseif QUES_QSIT_NO == 10 or QUES_QSIT_NO == "10" then
						if RSPN_SLCT_YN = "Y" then 
							cont.grdList.SetCellData("bd_Data", 2, TRGT_AMT.."원")
						end if
						
					elseif QUES_QSIT_NO == 11 or QUES_QSIT_NO == "11" then
						if RSPN_SLCT_YN = "Y" then 
							cont.grdList.SetCellData("bd_Data", 3, TRGT_AMT.."원")
						end if
						
					elseif QUES_QSIT_NO == 13 or QUES_QSIT_NO == "13" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"근로소득", "임대소득", "연금소득", "사업소득", "매도상환", "다른 대출을 통한 상환 등"}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 4, tData[nIndex])
						end if
						
					elseif QUES_QSIT_NO == 14 or QUES_QSIT_NO == "14" then
						if RSPN_SLCT_YN = "Y" then 
							Dim tData
							tData = {"신용공여를 사용해 본 적이 있으며, 신용공여에 대해 잘 이해하고 있다.", 
									"신용공여를 사용해 본 적이 있으나, 신용공여에 대해 잘 알지 못 한다", 
									"신용공여를 사용해 본 적이 없다. ", 
									"신용공여를 사용해 본 적은 없으나, 주식투자 경험이 3년 이상으로 신용공여에 대해 잘 이해하고 있다.", 
									"신용공여를 사용해 본 적이 없으며, 거래하고 싶지 않다."}
							
							Dim nIndex
							nIndex = CInt(ITEM_NO_VAL)-1
							
							cont.grdList.SetCellData("bd_Data", 5, tData[nIndex])
						end if
					end if
				next 			
			end if 
			
			cont.SetScrollAutoSize()
			
			if g_bPopup == true or g_bPopup == "true" or g_bPopup == "1" or g_bPopup == 1 then
				Dim nHeight
				nHeight = CInt(cont.grdList.top) + CInt(cont.grdList.height) + 15			
				cont.SetScrollAutoSize()
				'Form.height = nHeight
				Form.triggerEvent("#", "LinkHeight", nHeight)
			end if 
		end If
	elseif szTranID == "obcsb_acif_000r" then
		g_szCustNm = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_FULL_NAME", 0)
		cont.tblData.SetCellString(0, 0, g_szCustNm.."님의 적정성 판단 결과")
	end If
End Sub 

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "oblon_basc_102r" then
		szSub = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if trim(szSub) <> "" then
			szErrMsg = szErrMsg& "\n" &szSub
		end if
		Form.MsgBox("알림", szErrMsg , "", 0)
		Exit Sub
	end if
End Sub

