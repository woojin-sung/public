	<SCRIPT_INFO _len="4605" _ulen="4455" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 종목정보 팝업
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szItemName
Dim b_SaveFg

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   =  Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")

End Sub

'============================================================================
Sub Form_OnFormInit()

	b_SaveFg = false
	DATAMANAGER.RequestTranData( "ohhts_memo_013r" )	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	If szTranID = "ohhts_memo_013r" Then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false )
	
		If b_SaveFg = false Then
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_SHRN_ISCD" 			, 0 , g_szItemCode )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" 			, 0 , "" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , g_szItemMarket )
		
		Else
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "3" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_SHRN_ISCD" 			, 0 , g_szItemCode )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" 			, 0 , g_szItemName )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , g_szItemMarket )
		
		End If
	End If
	' 20210622 HWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	If szTranID = "ohhts_memo_013r" Then
		b_SaveFg = True
	End If	
	' 20210622 HWG END
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("11000_pb_Close" , "")
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm( )	
	
End Sub

'============================================================================
Sub btnSave_OnClick()
	If Trim( edtMemo.caption ) = "" Then
		Form.ShowAlert("알림", "저장할 메모내용이 없습니다.")
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData( "ohhts_memo_013r" )	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm( )
	
End Sub

