	<SCRIPT_INFO _len="1873" _ulen="1859" >
Dim g_szItemCode,g_szItemMarket,g_szToday
'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'szMk = "J"
	'szCd = "005930"
	
	'Request_001r()
	'Request_002r()
	
End Sub

'=============================================================================
Sub Request_001r()

	DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , g_szItemMarket)
	DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD", 0 , g_szItemCode)
	DATAMANAGER.RequestTranData("ohhts_1001_001r")

End Sub

'============================================================================
Sub Request_002r() '기관/외인 데이터
	
	DATAMANAGER.SetDataValue(0, "ohhts_1086_002r", "InBlock1", "FID_INPUT_ISCD", 0 , g_szItemCode)
	DATAMANAGER.RequestTranData("ohhts_1086_002r")

End Sub

'============================================================================
Sub Request_future()

	DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket)
	DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD", 0 , g_szItemCode)
	DATAMANAGER.RequestTranData("ohhts_3050_001r")

End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		g_szItemCode = sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		if g_szItemMarket == "F" or g_szItemMarket == "O" then
		
			Table1.visible = true
			Table0.visible = false
			Request_future()
		
		else
			Table0.visible = true
			Table1.visible = false
			Request_001r()
			Request_002r()
		end if
	end if
End Sub

