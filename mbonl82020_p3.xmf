'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_대출신청금액설정
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sAcc

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData 
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or sRevData == "" then
		Exit Sub
	end if
	
	g_sAcc = sRevData

	Form.SetScreenName("대출신청금액 설정")
	g_sRetData = "cancel"
	
	Dim name, clpr, ableqty, ableprc
	
	name = Form.GetSharedData("mbonl82020_p3_name" , false)
	clpr = Form.GetSharedData("mbonl82020_p3_clpr" , false)
	ableqty = Form.GetSharedData("mbonl82020_p3_ableqty" , false)
	ableprc = Form.GetSharedData("mbonl82020_p3_ableprc" , false)
	
	Table0.SetCellString( 0, 1, name )
	
	if Form.GetSharedData("mbonl82020_p3_typecode" , false) = "0251" then
		Table0.SetCellString( 1, 1, clpr )
	else
		Table0.SetCellString( 1, 1, clpr & "원")
	end if
	
	Table0.SetCellString( 2, 1, ableqty )
	Table0.SetCellString( 3, 1, ableprc )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_pros_810a" then
		Dim typecode, code, unit
		typecode = Form.GetSharedData("mbonl82020_p3_typecode" , false)
		code = Form.GetSharedData("mbonl82020_p3_code" , false)
		unit = Form.GetSharedData("mbonl82020_p3_unit" , false)
		
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , typecode )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "ISCD" , 0 , code )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "FRML_MRKT_DEAL_QTY_UNIT" , 0 , unit )
		
		if RdoGubun.currentindex == "0" then
			DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "APLT_QTY" , 0 , "" )
			DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "APLT_AMT" , 0 , EditInput.caption )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "APLT_QTY" , 0 , EditInput.caption )
			DATAMANAGER.SetDataValue( 0, "oblon_pros_810a", "InBlock1", "APLT_AMT" , 0 , "" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_pros_810a" then
		Dim sData
		
		if RdoGubun.currentindex == "0" then
			sData = DATAMANAGER.GetDataValue( 0, "oblon_pros_810a", "OutBlock1", "APLT_QTY" , 0 )
			
			Table0.SetCellString( 7, 0, sData )
			Table0.SetCellString( 7, 2, EditInput.caption )
		else
			sData = DATAMANAGER.GetDataValue( 0, "oblon_pros_810a", "OutBlock1", "APLT_AMT" , 0 )
			
			Table0.SetCellString( 7, 0, EditInput.caption )
			Table0.SetCellString( 7, 2, sData )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "oblon_pros_810a" then
		Table0.SetCellString( 7, 0, "" )
		Table0.SetCellString( 7, 2, "" )
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
Sub RdoGubun_OnClick(nIndex)
	EditInput.caption = ""
	
	if nIndex == 0 then
		Table0.SetCellString( 5, 0, "금액" )	
		
		EditInput.mask = "0,0,,원,0,,0,1,1"
	else
		Table0.SetCellString( 5, 0, "수량" )	
		
		EditInput.mask = "0,0,,,0,,0,1,1"
	end if
End Sub

'============================================================================
Sub EditInput_OnEditComplete()
	Table0.SetCellString( 7, 0, "" )
	Table0.SetCellString( 7, 2, "" )
End Sub

'============================================================================
Sub ButtonRequest_OnClick()
	if RdoGubun.currentindex == "0" then
		if EditInput.caption == "" or EditInput.caption == "0" then
			Form.MsgBox( "알림", "금액을 확인하세요.", "", 6 )
			Exit Sub
		end if
		
		if GetTonumber(EditInput.caption) > GetTonumber(Table0.GetCellString( 3, 1 )) then
			Form.MsgBox( "알림", "가능수량 및 가능금액을 확인하세요.", "", 6 )
			Exit Sub	
		end if
	else
		if EditInput.caption == "" or EditInput.caption == "0" then
			Form.MsgBox( "알림", "수량을 확인하세요.", "", 6 )
			Exit Sub
		end if
		
		if GetTonumber(EditInput.caption) > GetTonumber(Table0.GetCellString( 2, 1 )) then
			Form.MsgBox( "알림", "가능수량 및 가능금액을 확인하세요.", "", 6 )
			Exit Sub	
		end if
	end if
	
	DATAMANAGER.RequestTranData( "oblon_pros_810a" ) '수량금액조회
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if GetTonumber(Table0.GetCellString( 7, 0 )) == 0 or GetTonumber(Table0.GetCellString( 7, 2 )) == 0 then
		Form.MsgBox( "알림", "대출수량 및 대출금액을 확인하세요.", "", 6 )
		Exit Sub
	end if
	
	Form.SetSharedData("mbonl82020_p2_inputqty" , Table0.GetCellString( 7, 0 ))
	Form.SetSharedData("mbonl82020_p2_inputprc" , Table0.GetCellString( 7, 2 ))
	
	g_sRetData = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82020_p3" , g_sRetData)
End Sub














