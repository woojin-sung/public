'============================================================================
Sub Form_OnFormInitBefore()
	g_pid = Form.GetSharedData("Shared_PID", false )
	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_004r", "InBlock1", "PRTF_ID" , 0 ,g_pid) 	
	DATAMANAGER.RequestTranData("obcpp_rbit_004r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	
	if szTranID ==  "obcpp_rbit_004r" then
	
	g_pp_name=DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "PRTF_NAME" ,0)
	
	Label0.caption = g_pp_name
		
	end if
	
End Sub

'============================================================================


'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "PRTF_NAME" then
		Label0.caption = sValue
	elseif sKey == "TAB_CHANGE" then
		if sValue == "1" then
			FormTab0.currenttab = 0
		end if
	end if
End Sub

