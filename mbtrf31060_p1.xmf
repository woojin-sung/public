	<SCRIPT_INFO _len="2862" _ulen="2738" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 추가증거금 청산주문
' 02. 화면설명 : 추가증거금 청산주문 팝업화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szType

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData
	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData, "★")
	
	If UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_szType = arrData(0)

	If g_szType = "주문유형" Then
		cmbOrderType.visible = True
		edtAmount.visible	  = false
		edtPrice.visible	  = false
		lblTitle.caption 	  = "주문유형 변경"
	
	ElseIf g_szType = "수량" Then
		cmbOrderType.visible = false
		edtAmount.visible	  = true
		edtPrice.visible	  = false
		lblTitle.caption 	  = "수량 변경"
	
	ElseIf g_szType = "가격" Then
		cmbOrderType.visible = false
		edtAmount.visible	  = false
		edtPrice.visible	  = true
		lblTitle.caption 	  = "가격 변경"
	
	End If

End Sub
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnOk_OnClick
'============================================================================
Sub btnOk_OnClick()

	If g_szType = "주문유형" Then
		Form.SendReturnToParent( g_szType , cmbOrderType.caption )
	
	ElseIf g_szType = "수량" Then
		Form.SendReturnToParent( g_szType , edtAmount.caption )
	
	ElseIf g_szType = "가격" Then
		Form.SendReturnToParent( g_szType , edtPrice.caption )
	
	End If	

	Form.CloseForm()
	
End Sub

	</SCRIPT_INFO>
</ROOT>