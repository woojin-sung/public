'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grd00.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd01.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	
	grd00.SetCellData("bd_name", 0, "코스피")
	grd01.SetCellData("bd_name", 0, "코스닥")

	grd10.SetCellData("bd_cell0", 0, "개인")
	grd10.SetCellData("bd_cell2", 0, "외인")
	grd10.SetCellData("bd_cell4", 0, "기관")
	
	grd11.SetCellData("bd_cell0", 0, "개인")
	grd11.SetCellData("bd_cell2", 0, "외인")
	grd11.SetCellData("bd_cell4", 0, "기관")
	
	g_szFileName = "41000ITEMS.ini"

	g_szValues = Array()
	
	for i = 0 	to	UBound(g_szKeyNames)
		g_szValues(i)		= Form.LoadConfigData(g_szFileName, g_szKeyNames(i))
	next
	
	grd00.scrollenable = "0"
	grd01.scrollenable = "0"
	grd10.scrollenable = "0"
	grd11.scrollenable = "0"
	
'	DATAMANAGER.RequestTranData("ohhts_1500_001r")
'	DATAMANAGER.RequestTranData("ohhts_1500_001r_1")
	DATAMANAGER.RequestTranData("ohhts_1520_001r")
	g_szSect	=	"0"		'기본값 금액(억원)세팅
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim nIdx	'데이터위치값
	dim szTblname
	
	nIdx	=	0
	
	if szTranID = "ohhts_1500_001r" then
			
			For i=0 To 1
'				  if	g_szValues(i)	=	"1"	then
					 
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarkets(0))
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD",0, g_szCodes(0))
					    				  
					   Label1.caption = g_szNames(0)
					   
'				  end if
				  
			Next
	
	elseif szTranID = "ohhts_1500_001r_1" then
					 
			For i=0 To 1	'UBound(g_szValues)
'				  if	g_szValues(i)	=	"1"	then
					 
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarkets(1))
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r_1", "InBlock1", "FID_INPUT_ISCD", 0 , g_szCodes(1))
					   
					   Label2.caption = g_szNames(1)

'				  end if
				  
			Next
				  
	elseif szTranID = "ohhts_1520_001r" then
	    for nIndex = 0 to 1
		     DATAMANAGER.SetDataValue(0, "ohhts_1520_001r", "InBlock1", "FID_INPUT_ISCD", nIndex, g_sMarket(nIndex) )
		     DATAMANAGER.SetDataValue(0, "ohhts_1520_001r", "InBlock1", "FID_INPUT_ISCD2", nIndex, g_sMCode(nIndex) )
	    next
		
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim nDomIdx	'국내지수
	dim nOvrIdx	'해외주요지수
	dim nNfutIdx	'해외선물
	dim nExrtIdx	'환율
	dim nFutIdx	'국내선물
	
	dim bIsDom	'국내시장실시간있는지.
	dim bIsOvrs	'해외주요지수있는지.
	dim bIsNFut	'해외선물있는지
	dim bIsExrt	'환율있는지
	dim bIsFut	'선물
	
	Dim nSell
	Dim nBuy
	Dim nNetBuy
	Dim n1520Cnt
	Dim nTblCol
	
	nDomIdx	=	0
	nOvrIdx	= 	0
	nNfutIdx	=	0
	nExrtIdx	=	0
	nFutIdx	=	0

	bIsDom  	= false
	bIsOvrs	= false
	bIsNFut	= false
	bIsExrt	= false
	bIsFut	= false
	
	if szTranID = "ohhts_1500_001r" then
			
			DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
			
			'20221117 LES START 차세대 업종코드변경
			'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
			
			'1. 	시장체크해서 INPUT 세팅
			DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, "KGG01P")
			'20221117 LES END
			
				
			bIsDom  =	true
			
			'2.	실시간요청
			if	bIsDom =		true		then		'국내지수일때
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
			end if
			
			
	end if
	
	'20211026 SWJ START : iOS 쪽 간헐적 색상 오류로 인해 서비스 분리해서 테이블 세팅
	if szTranID = "ohhts_1500_001r_1" then
			
			DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
			
			'20221117 LES START 차세대 업종코드변경
			'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
			
			'1. 	시장체크해서 INPUT 세팅
			DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, "QGG01P")
			'20221117 LES END
			
			bIsDom  =	true
			
			'2.	실시간요청
			if	bIsDom =		true		then		'국내지수일때
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")
			end if
			
	elseif szTranID = "ohhts_1520_001r" then
	
		DATAMANAGER.CancelRealData("ohhts_invr_indv")
	
		n1520Cnt = DATAMANAGER.GetDataCount(0, "ohhts_1520_001r" , "OutBlock1")
		for  i = 0 to n1520Cnt - 1
			'개인--------------
			nSell	=0
			nBuy		=0
			nNetBuy 	=0
			
			if	g_szSect	=	"0"	then
				'순매수계산
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , i))
				
				if	i	=	2	then		'선물일때만 계약	160407
					nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_VOL" , i))
					nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_VOL" , i)) 
				end	if
			else
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_VOL" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_VOL" , i)) 
			end if
			nNetBuy = nBuy - nSell 
			
			'Row값계산
			tbl01.SetCellString(i+1, 1, nNetBuy)
			if i = 0 then
				grd10.SetCellData("bd_cell1", 0, nNetBuy)
			else
				grd11.SetCellData("bd_cell1", 0, nNetBuy)
			end if


			'외국인--------------
			nSell	=0
			nBuy		=0
			nNetBuy 	=0
			
			if	g_szSect	=	"0"	then
				'순매수계산
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , i))

				if	i	=	2	then		'선물일때만 계약	160407
					nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_VOL" , i))
					nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_VOL" , i))
				end	if
			else
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_VOL" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_VOL" , i))
			end if
			nNetBuy = nBuy - nSell 
			
			'Row값계산
			tbl01.SetCellString(i+1, 2, nNetBuy)
			if i = 0 then
				grd10.SetCellData("bd_cell3", 0, nNetBuy)
			else
				grd11.SetCellData("bd_cell3", 0, nNetBuy)
			end if
			
			'기관--------------
			nSell	=0
			nBuy		=0
			nNetBuy 	=0
			
			if	g_szSect	=	"0"	then
			'순매수계산
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , i))
				
				if	i	=	2	then		'선물일때만 계약	160407
					nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_VOL" , i))
					nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_VOL" , i))
				end	if
			else
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_VOL" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_VOL" , i))
			end if 
			nNetBuy = nBuy - nSell 
			
			'Row값계산
			tbl01.SetCellString(i+1, 3, nNetBuy)
			if i = 0 then
				grd10.SetCellData("bd_cell5", 0, nNetBuy)
			else
				grd11.SetCellData("bd_cell5", 0, nNetBuy)
			end if
		next
		
		DATAMANAGER.RequestRealData("ohhts_invr_indv")
		
		DATAMANAGER.RequestTranData("ohhts_1500_001r")
		DATAMANAGER.RequestTranData("ohhts_1500_001r_1")
	end if 

End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "Reload_Data" then
		DATAMANAGER.RequestTranData("ohhts_1520_001r")
	end if
End Sub

