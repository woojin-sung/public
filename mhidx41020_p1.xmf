function Link_jisu(nIdx)
'	mgidx42000	' 업종현재가		'	mgidx41020	' 예상지수
'	mgidx42040	' 해외지수
'    mhprc31000	' 선물현재가

' 업종현재가 / 파생현재가 / 해외지수 ... 현재가 링크	
'	if		trim(nCodes) = "0001" or trim(nCodes) = "1001" or trim(nCodes) = "2029"	then
'		Form.OpenScreen("42000", "0★" & nCodes)		' strMapName = "mgidx42000"
'	elseif 	trim(nCodes) = g_szFutCode	then
'		Form.OpenScreen("31000", nCodes)			' strMapName = "mgidx31000"		
'	elseif	trim(nCodes)	= "DJI@DJI" or trim(nCodes)	= "NAS@IXIC" or trim(nCodes) = "SPI@SPX" or
'			trim(nCodes)	= "SHS@000001" or trim(nCodes) = "HSI@HSCE" or trim(nCodes)	= "NII@NI225" then
'		Form.OpenScreen("42040", "0★" & nCodes)		' strMapName = "mgidx42040"
'	end if		
'--------------------------------------------------------------------------------------------------------------		
'		dim szSymbol
'		dim szMarket
'		dim szName
'	
	
'		msgbox "nIdx:[" & nIdx & "].. szSymbol:[" & szSymbol & "], szMarket[" & szMarket & "], szName[" & szName & "]"
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		
		'20211102 SWJ START
		if nIdx = 0 then
			szSendInfo = "KGG01P" & "★" &  "U" & "★" & "코스피종합"
		elseif nIdx = 1 then
			szSendInfo = "QGG01P" & "★" &  "U" & "★" & "코스닥종합"
		end if
		'20211102 SWJ END
		
		'20221117 LES END
		
		Form.OpenFramePopup("mhidx42040_p1" , szSendInfo , sPosInfo)
end Function

'============================================================================
'
'============================================================================
'
'======================================================================================================================
'20211102 SWJ START : 테이블 속성 -> 시세 속성 색깔 처리로 변경 (ios 쪽 간헐적 시세 색상 오류 수정)
'======================================================================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim n1520Cnt
	dim nBefAmt
	
	if szTranID == "ohhts_1500_001r" then
		DATAMANAGER.SetDataAttr(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRPR", 0, DATAMANAGER.GetDataAttr(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , 0) )
	
	elseif szTranID == "ohhts_1500_001r_1" then
		DATAMANAGER.SetDataAttr(0, "ohhts_1500_001r_1", "OutBlock1", "FID_CNCN_PRPR", 0, DATAMANAGER.GetDataAttr(0, "ohhts_1500_001r_1", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , 0) )		
	
	elseif szTranID = "ohhts_1520_001r" then		' 금액/ 100로 변환한다.
	
		n1520Cnt = DATAMANAGER.GetDataCount(0, "ohhts_1520_001r" , "OutBlock1")
		
		for  i = 0 to n1520Cnt - 1 
		
			'개인
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			'외국인
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			'기관계
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , i, Round(nBefAmt / 100))
		next 
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	if szTranID == "ohhts_nmix_cntg" then
		DATAMANAGER.SetDataAttr(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2", 0, DATAMANAGER.GetDataAttr(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) )
	elseif szTranID == "ohhts_nmix_cntg_1" then
		DATAMANAGER.SetDataAttr(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_PRPR2", 0, DATAMANAGER.GetDataAttr(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_invr_indv" then	
		k = 0
		for i = 0 to 1
		    For j = 0 To 2
			    DATAMANAGER.SetDataValue(1, "ohhts_invr_indv", "InBlock1", "FIDR_INVR_BSTP_CODE", k, g_sMCode(i) & g_sMarket_Feed(j) )
			    k = k + 1
		    Next
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	dim nNetBuy, nNetBuyFut
	dim nIndex
	dim szInvDiv
	dim szMarket
	
	if szTranID = "ohhts_invr_indv"	then
		if	g_szSect	=	"0"	then
			szMarket = Left(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 6)
			szInvDiv = Right(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 4)
			nNetBuy = Round(CDbl(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_NTBY_TR_PBMN", 0 )) / 100 )
			nNetBuyFut	=	Round(CDbl(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_NTBY_CNQN", 0 ))  )
		else
			szMarket = Left(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 6)
			szInvDiv = Right(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 4)
			nNetBuy = Round(CDbl(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_NTBY_CNQN", 0 ))  )
		end if 
'		sztest = DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0)
'		Form.ShowAlert("sztest:"..sztest, "nNetBuy:"..nNetBuy)
		Select Case szInvDiv	'투자자구분
		    Case "8000"
			    nIndex = 1
		    Case "9100"
			    nIndex = 2
		    Case "8888"
			    nIndex = 3
		end select
			    
		Select Case szMarket
			Case g_sMCode(0)
				nRowIdx = 1
			Case g_sMCode(1)
				nRowIdx = 2
		end select

'		tbl01.SetCellString(nRowIdx, nIndex, nNetBuy)
		if nRowIdx = 1 then
			Select Case nIndex
				Case 1
					grd10.SetCellData("bd_cell1", 0, nNetBuy)
				Case 2
					grd10.SetCellData("bd_cell3", 0, nNetBuy)
				Case 3
					grd10.SetCellData("bd_cell5", 0, nNetBuy)
			End Select
		elseif nRowIdx = 2 then
			Select Case nIndex
				Case 1
					grd11.SetCellData("bd_cell1", 0, nNetBuy)
				Case 2
					grd11.SetCellData("bd_cell3", 0, nNetBuy)
				Case 3
					grd11.SetCellData("bd_cell5", 0, nNetBuy)
			End Select
		End if
		
	end if 
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Form.bgcolor = "320"
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

