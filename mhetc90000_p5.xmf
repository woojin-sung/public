	<SCRIPT_INFO _len="6998" _ulen="6604" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_개인_메모수정
' 03. 작    성 : 2016.02.16 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sType '처리구분값
Dim g_sGubun '종목/일반메모구분값

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData 
	sRevData = Form.GetOpenLinkData( )
	
	if sRevData == null or Trim(sRevData) == "" then
		Exit Sub
	end if
	
	g_sGubun = sRevData
	g_sType = ""
	
	if g_sGubun == "1" then
		lblTitle.caption = "일반메모 수정"
		'Form.SetScreenName("일반메모 수정")
		
		Dim title, text
		title = Form.GetSharedData("mhetc90000_t7_title" , false)
		text = Form.GetSharedData("mhetc90000_t7_text" , false)	
		
		Table0.SetCellString( 0, 0, "제목" )
		Table0.SetCellString( 0, 1, title )
		EditText.caption = text
	elseif g_sGubun == "2" then
		lblTitle.caption = "종목메모 수정"
		'Form.SetScreenName("종목메모 수정")
		
		Dim codename, text
		codename = Form.GetSharedData("mhetc90000_t6_codename" , false)
		text = Form.GetSharedData("mhetc90000_t6_text" , false)

		Table0.SetCellString( 0, 0, "종목명" )
		Table0.SetCellString( 0, 1, codename )
		EditText.caption = text
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "clear" then
		if sRet == "ok" then
			g_sType = "5"

			DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '삭제	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	if szTranID == "ohhts_memo_013r" then
		DATAMANAGER.ClearInputData( 0, szTranID )
		
		Dim sUserID 
		sUserID = Form.GetSharedData("&USER_ID", false )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" , 0 , sUserID )
		'일반1,종목2
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" , 0 , g_sGubun ) 
		'입력검색1,전체검색2,추가3,수정4,선택삭제5,전체삭제9
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" , 0 , g_sType )
		'종목코드1,내용2/제목1,내용2,내용+제목3
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" , 0 , "1" )
		
		if g_sType == "4" then '수정인경우
			if g_sGubun == "1" then
				Dim sDate, sTime, title, clscode
				sDate = Form.GetSharedData("&HOST_DATE", false )
				sTime = Form.GetSharedData("&HOST_TIME", false )
				title = Form.GetSharedData("mhetc90000_t7_title" , false)
				clscode = Form.GetSharedData("mhetc90000_t7_clscode" , false)
				
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MOD_YMDH" , 0 , sDate..sTime )
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_TITL" , 0 , title )
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_GNRL_CNTT" , 0 , EditText.caption )
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_CLS_CODE" , 0 , clscode )	
			elseif g_sGubun == "2" then
				Dim codename, sCode, market
				codename = Form.GetSharedData("mhetc90000_t6_codename" , false)
				sCode = Form.GetSharedData("mhetc90000_t6_code" , false)
				market = Form.GetSharedData("mhetc90000_t6_market" , false)
				
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" , 0 , sCode )
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" , 0 , codename )
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_ISSU_MEMO_CNTT" , 0 , EditText.caption )
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , market )
			end if
		elseif g_sType == "5" then '삭제인경우
			if g_sGubun == "1" then
				Dim sClsCode
				sClsCode = Form.GetSharedData("mhetc90000_t7_clscode" , false)
				
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_CLS_CODE" , 0 , sClsCode )
			elseif g_sGubun == "2" then
				Dim sCode
				sCode = Form.GetSharedData("mhetc90000_t6_code" , false)
			
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" , 0 , sCode )
			end if	
		end if
	end if
	' 20210622 HWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Form.SendReturnToParent( "mhetc90000_p5" , "" )
	Form.CloseForm()
End Sub

'============================================================================
' 수정
'============================================================================
Sub ButtonModify_OnClick()
	if EditText.caption = "" then
		Form.MsgBox( "알림", "내용을 입력해주세요.", "", 6 )
		Exit Sub
	end if

	g_sType = "4"
	
	DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '수정	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
End Sub

'============================================================================
' 삭제
'============================================================================
Sub ButtonDel_OnClick()
	if g_sGubun == "1" then
		Form.MsgBox( "알림", "일반메모를 삭제 하시겠습니까?", "clear", 1 )
	elseif g_sGubun == "2" then
		Form.MsgBox( "알림", "종목메모를 삭제 하시겠습니까?", "clear", 1 )
	end if
End Sub

'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================


'============================================================================
Sub Image1_OnClick()
	Form.CloseForm()
End Sub

