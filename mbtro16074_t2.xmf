	<SCRIPT_INFO _len="12117" _ulen="11451" >
'===========================================================================
' 2019.05.15 : 이현우 : 일본시장 추가
' 2020.11.25 : 이현우 : v001 - 해외주식 매도상환
' 2021.02.08 : 이현우 : v002 - 수수료, 현지비용 추가
' 2022.05.23 : 아아티젠 김성수 : v003 - 소수점 데이터 추가
' 2022.06.16 : 장시방 : v004 - 주문유형 추가
' 2024.03.20 : 장시방 : v005 : 스위스 시장코드, 내부거래소코드 추가
'===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szSta_Date
Dim g_szFin_Date
Dim g_NextCnt
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TRANCALL" then
		tmp = Split(sParam, "||")
		
		g_NextCnt = 0
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		
		
		DATAMANAGER.RequestTranData("obtro_oder_201r")
	end if
End Sub
'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	g_NextCnt = 0
	DATAMANAGER.RequestTranData("obtro_oder_201r")
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	g_NextCnt = 0
	DATAMANAGER.RequestTranData("obtro_oder_201r")
End Sub



'============================================================================
Sub Calendar0_OnEditComplete()
	g_NextCnt = 0
	DATAMANAGER.RequestTranData("obtro_oder_201r")
End Sub



'============================================================================
Sub Calendar1_OnEditComplete()
	g_NextCnt = 0
	DATAMANAGER.RequestTranData("obtro_oder_201r")
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtro_oder_201r" then
		g_szSta_Date = Calendar0.caption
		g_szFin_Date = Calendar1.caption
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "ACNO" 					 , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "ASNO" 					 , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "ODER_STA_DATE" 			 , 0 , g_szSta_Date)
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "ODER_FIN_DATE" 			 , 0 , g_szFin_Date)
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , "00")
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "ISCD" 					 , 0 , "%")
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "SORT_CLS" 				 , 0 , "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "DATA_CLS" 				 , 0 , "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_201r", "InBlock1", "ENTM_ONSL_INTG_CLCD" 		 , 0 , "00")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtro_oder_201r" then
		for i = g_NextCnt to grd0.rowcount - 1
		
			deal_cls_code   = grd0.GetCellData("bd_cell1", i)
			deal_cls_name   = ""
			nation		  = grd0.GetCellData("bd_cell10", i)
			oder_condition  = grd0.GetCellData("bd_cell8", i)
			oder_prc		  = Cstr(grd0.GetCellData("bd_cell6", i))
			cntg_prc		  = Cstr(grd0.GetCellData("bd_cell7", i))
			oder_cfee       = Cstr(grd0.GetCellData("bd_cell28", i))	'v002
			acpn_cfee	  = Cstr(grd0.GetCellData("bd_cell29", i))	'v002
			rctf_cncl_cls_code = grd0.GetCellData("bd_cell12", i)
			aspr_type_code  = grd0.GetCellData("bd_cell50", i)		'v003
			
			iscd			= grd0.GetCellData("bd_cell3", i)
			exch			= right(iscd,2)
			
			'v003 START
			dim sType, nOdrQty, nCheQty
			sType = grd0.GetCellData("bd_cell21", i)
			nOdrQty = CDbl(grd0.GetCellData("bd_cell47", i))
			nCheQty = CDbl(grd0.GetCellData("bd_cell48", i))
			
			if sType == "10" then '일반
				grd0.SetCellData("bd_cell31", i, "일반")
				
				nOdrQty = FormatNumber(nOdrQty, 0)
				lblFormat0.caption = nOdrQty
				grd0.SetCellData("bd_cell4", i, lblFormat0.caption)
				
				nCheQty = FormatNumber(nCheQty, 0)
				lblFormat0.caption = nCheQty
				grd0.SetCellData("bd_cell5", i, lblFormat0.caption)
			elseif sType == "30" then '소수점
				grd0.SetCellData("bd_cell31", i, "소수점")
				
				nOdrQty = FormatNumber(nOdrQty, 6)
				lblFormat6.caption = nOdrQty
				grd0.SetCellData("bd_cell4", i, lblFormat6.caption)
				
				nCheQty = FormatNumber(nCheQty, 6)
				lblFormat6.caption = nCheQty
				grd0.SetCellData("bd_cell5", i, lblFormat6.caption)
			end if
			
'			grd0.SetCellData("bd_cell4", i, nOdrQty)
'			grd0.SetCellData("bd_cell5", i, nCheQty)
			

			

			'v003 END
			
			if deal_cls_code = "1" then 					'매도
				deal_cls_name = "매도"
				grd0.SetCellFgColor("bd_cell1", i, "11")
				'grd0.SetCellData("bd_cell1", i, "매도")
			elseif deal_cls_code = "2" then 				'매수
				deal_cls_name = "매수"
				grd0.SetCellFgColor("bd_cell1", i, "10")			
			else 
				Form.ShowAlert("TEST", "매도/매수가 아님")
			end if
			
			if rctf_cncl_cls_code = "1" then
				deal_cls_name = deal_cls_name & "정정"				
			elseif rctf_cncl_cls_code = "2" then
				deal_cls_name = deal_cls_name & "취소"
			else
				deal_cls_name = deal_cls_name
			end if
			
			grd0.SetCellData("bd_cell1", i, deal_cls_name)
			
			if nation = "01" then
				grd0.SetCellData("bd_cell11", i, "미국")
			elseif nation = "02" then
				grd0.SetCellData("bd_cell11", i, "홍콩")
			elseif nation = "03" then
				grd0.SetCellData("bd_cell11", i, "중국")
			elseif nation = "04" then
				grd0.SetCellData("bd_cell11", i, "중국")
			elseif nation = "05" then
				grd0.SetCellData("bd_cell11", i, "일본")
			elseif nation = "06" then
				grd0.SetCellData("bd_cell11", i, "호주")				
			elseif nation = "07" then
				grd0.SetCellData("bd_cell11", i, "싱가폴")
			elseif nation = "08" then '2020.11.05 유로국가 추가
				grd0.SetCellData("bd_cell11", i, "영국")			
			elseif nation = "09" then
				grd0.SetCellData("bd_cell11", i, "영국")			
			elseif nation = "10" then
				grd0.SetCellData("bd_cell11", i, "독일")			
			elseif nation = "11" then
				grd0.SetCellData("bd_cell11", i, "핀란드")
			elseif nation = "12" then
				grd0.SetCellData("bd_cell11", i, "프랑스")			
			elseif nation = "13" then
				grd0.SetCellData("bd_cell11", i, "벨기에")			
			elseif nation = "14" then
				grd0.SetCellData("bd_cell11", i, "네덜란드")
			elseif nation = "15" then
				grd0.SetCellData("bd_cell11", i, "포르투갈")
			elseif nation = "16" then
				grd0.SetCellData("bd_cell11", i, "그리스")
			elseif nation = "17" then
				grd0.SetCellData("bd_cell11", i, "아일랜드")
			elseif nation = "18" then
				grd0.SetCellData("bd_cell11", i, "이탈리아")
			elseif nation = "19" then
				grd0.SetCellData("bd_cell11", i, "스페인")			
			elseif nation = "20" then
				grd0.SetCellData("bd_cell11", i, "오스트리아")
			elseif nation = "21" then
				grd0.SetCellData("bd_cell11", i, "캐나다")
			elseif nation = "23" then
				grd0.SetCellData("bd_cell11", i, "인도네시아")
			elseif nation = "24" then
				grd0.SetCellData("bd_cell11", i, "베트남")
			elseif nation = "25" then
				grd0.SetCellData("bd_cell11", i, "베트남")
			elseif nation = "26" then
				grd0.SetCellData("bd_cell11", i, "스위스") 'v005
			else
				grd0.SetCellData("bd_cell11", i, "")
			end if
				
			grd0.SetCellData("bd_cell6", i , FormatNumber(oder_prc,4))	
			grd0.SetCellData("bd_cell7", i , FormatNumber(cntg_prc,4))	
			
			'v002
			grd0.SetCellData("bd_cell28", i , FormatNumber(oder_cfee,2))
			grd0.SetCellData("bd_cell29", i , FormatNumber(acpn_cfee,2))
				
			'grd0.SetCellData("bd_cell6", i , FormatNumber(oder_amt,3))
			'grd0.SetCellData("bd_cell7", i , FormatNumber(cntg_amt,3))

			if oder_condition = "0" then
				grd0.SetCellData("bd_cell8", i, "정상")
			elseif oder_condition = "1" then
				grd0.SetCellData("bd_cell8", i, "거부")
			elseif oder_condition = "2" then
				grd0.SetCellData("bd_cell8", i, "자동거부")
			elseif oder_condition = "3" then
				grd0.SetCellData("bd_cell8", i, "자동취소(체결후)")
			elseif oder_condition = "4" then
				grd0.SetCellData("bd_cell8", i, "미접수")
			else
				Form.ShowAlert("TEST", "해당하는 주문상태 없음 : " & oder_condition & " , " & i)
			end if
			
			if exch = "NY" then
				grd0.SetCellData("bd_cell10", i, "뉴욕")
			elseif exch = "AX" then
				grd0.SetCellData("bd_cell10", i, "아멕스")
			elseif exch = "OQ" then
				grd0.SetCellData("bd_cell10", i, "나스닥")
			elseif exch = "SZ" then
				grd0.SetCellData("bd_cell10", i, "심천")
			elseif exch = "SH" then
				grd0.SetCellData("bd_cell10", i, "상해")
			elseif exch = "HK" then
				grd0.SetCellData("bd_cell10", i, "홍콩")
			elseif exch = "JP" then
				grd0.SetCellData("bd_cell10", i, "도쿄")				
			elseif exch = "AU" then
				grd0.SetCellData("bd_cell10", i, "호주")
			elseif exch = "SP" then
				grd0.SetCellData("bd_cell10", i, "싱가폴")
			elseif exch = "CT" then
				grd0.SetCellData("bd_cell10", i, "토론토")
			elseif exch = "LN" then					 '2020.11.05 - 유로국가 추가
				grd0.SetCellData("bd_cell10", i, "런던")
			elseif exch = "LI" then
				grd0.SetCellData("bd_cell10", i, "런던인터내셔날")
			elseif exch = "GY" then
				grd0.SetCellData("bd_cell10", i, "독일")
			elseif exch = "FH" then
				grd0.SetCellData("bd_cell10", i, "핀란드")
			elseif exch = "FP" then
				grd0.SetCellData("bd_cell10", i, "프랑스") '프랑스
			elseif exch = "BB" then
				grd0.SetCellData("bd_cell10", i, "벨기에") '벨기에
			elseif exch = "NA" then
				grd0.SetCellData("bd_cell10", i, "네덜란드") '네덜란드
			elseif exch = "PL" then
				grd0.SetCellData("bd_cell10", i, "포르투갈") '포르투갈
			elseif exch = "XT" then
				grd0.SetCellData("bd_cell10", i, "그리스")
			elseif exch = "ID" then
				grd0.SetCellData("bd_cell10", i, "아일랜드")
			elseif exch = "IM" then
				grd0.SetCellData("bd_cell10", i, "이탈리아")
			elseif exch = "SM" then
				grd0.SetCellData("bd_cell10", i, "스페인")	
			elseif exch = "AV" then
				grd0.SetCellData("bd_cell10", i, "오스트리아")
			elseif exch = "IJ" then
				grd0.SetCellData("bd_cell10", i, "인도네시아")
			elseif exch = "VH" then
				grd0.SetCellData("bd_cell10", i, "하노이")	
			elseif exch = "VM" then
				grd0.SetCellData("bd_cell10", i, "호치민")
			elseif exch = "SW" then
				grd0.SetCellData("bd_cell10", i, "스위스") 'v005
			else
				grd0.SetCellData("bd_cell10", i, "")
			end if
			
			'v001
			loan_type = Form.GetMetaData("대출상세유형코드", grd0.GetCellData("bd_cell26", i))
			grd0.SetCellData("bd_cell24", i, loan_type)
			
			'v004
			if aspr_type_code = "1" then
				grd0.SetCellData("bd_cell50", i, "시장가")
			elseif aspr_type_code = "2" then
				grd0.SetCellData("bd_cell50", i, "지정가")
			elseif aspr_type_code = "4" then
				grd0.SetCellData("bd_cell50", i, "LOO")
			elseif aspr_type_code = "5" then
				grd0.SetCellData("bd_cell50", i, "LOC")
			elseif aspr_type_code = "6" then
				grd0.SetCellData("bd_cell50", i, "MOO")
			elseif aspr_type_code = "7" then
				grd0.SetCellData("bd_cell50", i, "MOC")
			elseif aspr_type_code = "8" then
				grd0.SetCellData("bd_cell50", i, "Limit VWAP")
			elseif aspr_type_code = "9" then
				grd0.SetCellData("bd_cell50", i, "Limit TWAP")
			elseif aspr_type_code = "A" then
				grd0.SetCellData("bd_cell50", i, "VWAP")
			elseif aspr_type_code = "B" then
				grd0.SetCellData("bd_cell50", i, "TWAP")
			end if
			
			

		next	
		
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_oder_201r", "OutBlock1")
	end if
End Sub

