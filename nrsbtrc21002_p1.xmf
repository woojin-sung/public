	<SCRIPT_INFO _len="3239" _ulen="2977" >
'============================================================================
' 화 면 명 : CFD권리화면_권리유형
' 화면설명 : CFD권리화면의 권리유형선택 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szRghtCd, g_szGubun
g_szRghtCd = "%"
g_szGubun = "0" '국내

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()	
	if szData <> "" then
		tData = Split(szData, "★")
		g_szRghtCd = tData(0)	
		g_szGubun = tData(1)
	
		if g_szGubun == "1" then '해외
			if g_szRghtCd == "01" then      '01	유상
				RgStyle1.currentindex = 1
			elseif g_szRghtCd == "02" then  '02	 무상
				RgStyle1.currentindex = 2
			elseif g_szRghtCd == "03" then  '03	 배당(현금, 주식, 동시배당)
				RgStyle1.currentindex = 3
			else
				RgStyle1.currentindex = 0
			end if 
			
			RgStyle1.left = 20
			RgStyle.left = 402
		else '국내
			if g_szRghtCd == "01" then      '01	유상
				RgStyle.currentindex = 1
			elseif g_szRghtCd == "02" then  '02	 무상
				RgStyle.currentindex = 2
			elseif g_szRghtCd == "03" then  '03	 배당(현금, 주식, 동시배당)
				RgStyle.currentindex = 3
			elseif g_szRghtCd == "17" then  '17	ETF분배금 28	ETN분배금,  30 펀드분배금
				RgStyle.currentindex = 4
			else
				RgStyle.currentindex = 0
			end if 		
			RgStyle1.left = 402
			RgStyle.left = 20
		end if 
		
	else
		'디폴트 전체
		RgStyle.currentindex = 0
		RgStyle1.currentindex = 0
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("RIGHT_SET", g_szRghtCd)
End Sub

'============================================================================
Sub RgStyle_OnClick(nIndex)

	if nIndex == 1 then      '01	유상
		g_szRghtCd = "01" 
	elseif nIndex == 2 then  '02	 무상
		g_szRghtCd = "02" 	
	elseif nIndex == 3 then  '03	 배당(현금, 주식, 동시배당)
		g_szRghtCd = "03" 
	elseif nIndex == 4 then  '17	ETF분배금 28	ETN분배금,  30 펀드분배금
		g_szRghtCd = "17" 
	else
		g_szRghtCd = "%" 	
	end if
End Sub

'============================================================================
Sub RgStyle1_OnClick(nIndex)

	if nIndex == 1 then      '01	유상
		g_szRghtCd = "01" 
	elseif nIndex == 2 then  '02	 무상
		g_szRghtCd = "02" 	
	elseif nIndex == 3 then  '03	 배당(현금, 주식, 동시배당)
		g_szRghtCd = "03" 
	else
		g_szRghtCd = "%" 	
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	'권리유형 선택 알림
	if g_szGubun == "1" then '해외
		Form.SendReturnToParent("RIGHT_SET1", g_szRghtCd)
	else
		Form.SendReturnToParent("RIGHT_SET", g_szRghtCd)
	end if 
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
</ROOT>