	<SCRIPT_INFO _len="20181" _ulen="18603" >
'===========================================================================
' 01. 화 면 명 : 공모주 자동 대체 약정_공모주 입고 탭
' 02. 화면설명 : 공모주 자동 대체 약정_공모주 입고 탭
' 03. 작    성 : 2016.11.09 : 윤유정
' 04. 수    정 : 2016.12.13 : 윤유정 : 약정 등록 시 공인인증서 체크 누락 수정 v0001
' 2020.07.13 : 정민영 : v0002 : 당사 계좌(본인, 타명의) 약정 가능 obacp_comm_008r -> obacp_comm_060r 변경
' 2020.09.16 : 성주혁 : v0003 : MTS 메모리 보안 
'===========================================================================
'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szList			'계좌번호와 비밀번호
Dim g_szPassWord		'비밀번호
Dim g_outSvcs			'약정여부
Dim g_szPW			'비밀번호
Dim SPLM_ATHN_STPL_YN  '추가인증여부
Dim g_sUserID
Dim g_szCSNO			'고객번호
DIm g_szASNO			'계좌일련번호
Dim g_szSvcSrno		'서비스일련번호
Dim regAcno
Dim regAsno
Dim ui_rcno
Dim prs_cls
Dim bYn
Dim regPrcd 					
Dim regInvtTrgtRstcYn 
Dim regFnprExusYn 		
Dim regOldPrcd
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	if szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO"  , 0 , g_szList(0))
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO"  , 0 , g_szASNO)
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD"  , 0 , "031")
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO"  , 0 , g_szCSNO)
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	elseif szTranID == "obpds_srvc_083r" then
		DATAMANAGER.SetDataValue(0,"obpds_srvc_083r", "InBlock1", "CSNO"  , 0 , g_szCSNO)
		DATAMANAGER.SetDataValue(0,"obpds_srvc_083r", "InBlock1", "SVCD"  , 0 , "031")
		DATAMANAGER.SetDataValue(0,"obpds_srvc_083r", "InBlock1", "SVC_SRNO"  , 0 , g_szSvcSrno)
		DATAMANAGER.RequestTranData("obpds_srvc_083r") 
	elseif szTranID == "obacp_comm_040r" then
		DATAMANAGER.SetDataValue(0,"obacp_comm_040r", "InBlock1", "ACNO"  , 0 , regAcno)
		DATAMANAGER.SetDataValue(0,"obacp_comm_040r", "InBlock1", "ASNO"  , 0 , regAsno)
		DATAMANAGER.RequestTranData("obacp_comm_040r")
    'v0002 당사 계좌(본인, 타명의) 약정 가능 obacp_comm_008r -> obacp_comm_060r 변경
	elseif szTranID == "obacp_comm_060r" then
		DATAMANAGER.SetDataValue(0,"obacp_comm_060r", "InBlock1", "ACNO"  , 0 , left(edtAccount.Caption,8))
		DATAMANAGER.SetDataValue(0,"obacp_comm_060r", "InBlock1", "ASNO"  , 0 , right(edtAccount.Caption,2))
		DATAMANAGER.RequestTranData("obacp_comm_060r")
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue(0,"obcsb_oimf_638r", "InBlock1", "ELFN_ID"  , 0 , g_sUserID)
		DATAMANAGER.SetDataValue(0,"obcsb_oimf_638r", "InBlock1", "SVCD"  , 0 , "000")
		DATAMANAGER.SetDataValue(0,"obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY"  , 0 , Form.GetDeviceID())
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit() 

	'v0003
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	g_szCSNO = Form.GetSharedData( "CSNO_83130" , false )
	
	btnCancel.enable = false
	btnEnroll.enable = false
	
	call clear_Tap()
	
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if
End Sub
'============================================================================
Function clear_Tap()
	Table0.SetCellString(0, 1, " ")
	Table0.SetCellString(0, 2, " ")
	Table0.SetCellString(0, 3, " ")
	
	edtAccount.caption = ""
	edtRmtName2.caption = ""
	
	edtAccount.enable = false
	edtRmtName2.enable = false
	
	btnEnroll.enable = false
	btnCancel.enable = false
End Function
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName <> "공모주입고" then
		call clear_Tap()
		Exit Sub
	end if

	g_szList = Split(sParam, "★")
	g_szASNO = Form.GetSharedData( "ASNO_83130" , false )
	
		
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
		
	'v0003
	'AS-IS
	'g_szPW = Form.GetEncData(g_szList(1))
	
	'To-Be
	if plain_rm =="1" then
		g_szPW = g_szList(1)
	else
		g_szPW = Form.GetEncData(g_szList(1))
	end if
	
	if g_szPW == "" then	
		call clear_Tap()
	else
		Call TR_Inquiry("obpds_srvc_323r")
	end if
	
'	if g_szPW <> "" then
'		Call TR_Inquiry("obpds_srvc_323r")
'	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_323r" then	'HTS-WTS용 서비스 내역 조회
		g_outSvcs = Trim(DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "SVCD" , 0))
		g_szSvcSrno = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "SVC_SRNO" , 0)
		bYn = DATAMANAGER.GetDataValue( 0, "obpds_srvc_323r", "OutBlock1", "APRV_YN", 0 )
		
'		if g_outSvcs <> "" then
'			Table0.SetCellString(0, 2, "약정")
'			edtAccount.enable = false
'			btnEnroll.enable = false
'			btnCancel.enable = true
'			Call TR_Inquiry("obpds_srvc_083r")
'		else
'			Table0.SetCellString(0, 2, "미약정")
'			edtAccount.enable = true
'			btnEnroll.enable = true
'			btnCancel.enable = false
'		end if
		if bYn = "Y" and g_outSvcs <> "" then
			Table0.SetCellString(0, 2, "승인처리중")
			edtAccount.enable = false
			btnEnroll.enable = false
			btnCancel.enable = false
			Call TR_Inquiry("obpds_srvc_083r")
		elseif bYn = "N" and g_outSvcs <> "" then
			Table0.SetCellString(0, 2, "약정")
			edtAccount.enable = false
			btnEnroll.enable = false
			btnCancel.enable = true
			Call TR_Inquiry("obpds_srvc_083r")
		else
			Table0.SetCellString(0, 2, "미약정")
			edtAccount.enable = true
			btnEnroll.enable = true
			btnCancel.enable = false
		end if
		
		
	elseif szTranID == "obpds_srvc_083r" then
		regAcno = DATAMANAGER.GetDataValue(0, "obpds_srvc_083r", "OutBlock1", "TACT_SCRT_ACNO" , 0)
		regAsno = DATAMANAGER.GetDataValue(0, "obpds_srvc_083r", "OutBlock1", "TACT_SCRT_ASNO" , 0)
		'ttl_acno = Trim(DATAMANAGER.GetDataValue(0, "obpds_srvc_083r", "OutBlock1", "TACT_SCRT_ACNO" , 0)) & Trim(DATAMANAGER.GetDataValue(0, "obpds_srvc_083r", "OutBlock1", "TACT_SCRT_ASNO" , 0))
		ttl_acno = regAcno & regAsno
		'Table0.SetCellString(0, 2, ttl_acno) '약정계좌
		edtAccount.caption = ttl_acno
		
		Call TR_Inquiry("obacp_comm_040r")
		
	elseif szTranID == "obacp_comm_040r" then
	
'		if Table0.GetCellString(0,2) <> "미약정" then
'			Table0.SetCellString(0, 3, Trim(DATAMANAGER.GetDataValue(0, "obacp_comm_040r", "OutBlock1", "CSNM" , 0))) '약정계좌
'		end if
		
		edtRmtName2.caption = Trim(DATAMANAGER.GetDataValue(0, "obacp_comm_040r", "OutBlock1", "CSNM" , 0))
		ui_rcno = DATAMANAGER.GetDataValue(0, "obacp_comm_040r", "OutBlock1", "UI_RCNO" , 0)

	'v0002 당사 계좌(본인, 타명의) 약정 가능 obacp_comm_008r -> obacp_comm_060r 변경
	elseif szTranID == "obacp_comm_060r" then
	
		regPrcd = DATAMANAGER.GetDataValue(0, "obacp_comm_060r", "OutBlock1", "PRCD" , 0)
		regInvtTrgtRstcYn = DATAMANAGER.GetDataValue(0, "obacp_comm_060r", "OutBlock1", "INVT_TRGT_RSTC_YN" , 0)
		regFnprExusYn = DATAMANAGER.GetDataValue(0, "obacp_comm_060r", "OutBlock1", "FNPR_EXUS_YN" , 0)
		checkDownAcno()
		
	elseif szTranID == "obpds_srvc_020a" then
		if prs_cls = 1 then	
			Form.ShowAlert( "알림" , "신청이 완료되었습니다.")
		else 
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
		end if
		
		Table0.SetCellString(0, 1, " ")
		Table0.SetCellString(0, 2, " ")
		Table0.SetCellString(0, 3, " ")
		
		edtAccount.caption = ""
		edtRmtName2.caption = ""
		
		Call TR_Inquiry("obpds_srvc_323r")
	elseif szTranID == "obcsb_oimf_638r" then
				
		if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "0" then	'보안카드
			Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "1" then	'부가정보
			Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "2" then	'보안매체없음
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "3" then	'OTP
			Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "4" then	'모바일OTP
			Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
		else			'오류
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if
	end if
End Sub 
'============================================================================
Sub edtAccount_OnEditComplete()
	tmp = edtAccount.caption
	DATAMANAGER.SetDataValue(0,"obacp_comm_040r", "InBlock1", "ACNO"  , 0 , left(tmp,8))
	DATAMANAGER.SetDataValue(0,"obacp_comm_040r", "InBlock1", "ASNO"  , 0 , right(tmp,2))
	DATAMANAGER.RequestTranData("obacp_comm_040r")
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "obpds_srvc_323r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_323r" )
		Form.ShowAlert( "알림" , szErrMsg) '.."("..szSubErr..")"
	elseif szTranID == "obpds_srvc_020a" then
		call clear_Tap()
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_020a" )
		Form.ShowAlert( "알림" , szErrMsg) '.."("..szSubErr..")"
	elseif szTranID == "obacp_comm_040r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_comm_040r" )
		Form.ShowAlert( "알림" , szErrMsg) '.."("..szSubErr..")"
    'v0002 당사 계좌(본인, 타명의) 약정 가능 obacp_comm_008r -> obacp_comm_060r 변경
	elseif szTranID == "obacp_comm_060r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_comm_060r" )
		Form.ShowAlert( "알림" , szErrMsg) '.."("..szSubErr..")"
	elseif szTranID == "obpds_srvc_083r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_083r" )
		Form.ShowAlert( "알림" , szErrMsg) '.."("..szSubErr..")"
	end if
End Sub
'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
'	if sKeyName == "mhetc90060_p8" then	'추가인증 
'	
'		if sRet == "ok" then	'추가인증성공 -> 보안매체조회 및 인증
'			Call TR_Inquiry("obcsb_oimf_638r")	
'		else
'			Form.CloseForm( )
'			exit sub
'		end if
'	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			'do_Work()		
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo) 'v0001
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			'do_Work()	
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo) 'v0001
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			'do_Work()	
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo) 'v0001
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'모바일 OTP
		if sRet == "ok" then			'성공
			'do_Work()	
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo) 'v0001
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			do_Work()
		else						'실패
			exit sub
		end if
		
	end if
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if	
	
End Sub 
