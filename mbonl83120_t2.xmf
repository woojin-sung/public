'============================================================================
Function btnEnroll_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szPW== "" or TopPW == "" then		'비밀번호 입력요구창
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Function
	elseif edtAccount.caption == "" Then
		Form.ShowAlert( "알림" , "이체 계좌번호를 확인하세요.")
		Exit Function
	elseif edtRmtName2.caption == "" Then
		Form.ShowAlert( "알림" , "계좌번호를 확인하세요.")
		Exit Function
	'v1117
	elseif Trim(g_szList(0)&g_szASNO) == Trim(edtAccount.Caption) Then
		Form.ShowAlert("알림", "약정신청계좌와 입력계좌가 동일합니다.")
	else
		prs_cls = 1
		'v0002 당사 계좌(본인, 타명의) 약정 가능 obacp_comm_008r -> obacp_comm_060r 변경
		Call TR_Inquiry("obacp_comm_060r")
		'Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)			
	end if	

End Function
'============================================================================
Function btnCancel_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szPW== "" or TopPW == "" then		'비밀번호 입력요구창
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Function
	elseif edtAccount.caption == "" Then
		Form.ShowAlert( "알림" , "이체 계좌번호를 확인하세요.")
		Exit Function
	elseif edtRmtName2.caption == "" Then
		Form.ShowAlert( "알림" , "예금자명를 확인하세요.")
		Exit Function
	else
		prs_cls = 2
		Form.MsgBox("해지 확인", "해지하시겠습니까?","cancel_check",1)		
	end if	
	
End Function 
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "cancel_check" then
		if sRet == "ok" then	'해지
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
		end if
	end if
End Sub

