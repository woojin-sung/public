'============================================================================
'Function SendReg()
'	Form.OpenFramePopup("mhetc90060_p5" , "" , "")	
'End Function 

'============================================================================
Function do_Work()
	if prs_cls = 1 then
		DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "PROS_CLS_CODE"  , 0 , "I")
	elseif prs_cls = 2 then
		DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "PROS_CLS_CODE"  , 0 , "D")
	end if

	tmp1 = edtAccount.caption 
	
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "ACNO"  , 0 , g_szList(0))
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "SVC_SRNO"  , 0 , g_szSvcSrno)
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "ASNO"  , 0 , g_szASNO)
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "ACNT_PWD"  , 0 , g_szPW)
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "CSNO"  , 0 , g_szCSNO)
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "CONT_CLS_CODE"  , 0 , "4")
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "SVCD"  , 0 , "031")
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "TACT_ACNT_CLS_CODE"  , 0 , "1")
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "TACT_SCRT_ASNO"  , 0 , right(tmp1,2))
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "TACT_SCRT_ACNO"  , 0 , left(tmp1,8))
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "DPSR_NAME"  , 0 , Trim(edtRmtName2.caption) )
	DATAMANAGER.SetDataValue(0,"obpds_srvc_020a", "InBlock1", "DPSR_RRNO_PIP"  , 0 , ui_rcno)
	
	
	DATAMANAGER.RequestTranData("obpds_srvc_020a")
	
End Function
