	<SCRIPT_INFO _len="933" _ulen="815" >
'2023.06.23. 김유경 : v001. 단기사채-매수화면 유의사항 발행물, 유통물 통일
Dim g_SHTR_BOND_REG_CLS_CODE

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("단기사채 주문 유의사항")
	
	g_SHTR_BOND_REG_CLS_CODE = Form.GetOpenLinkData()
	'v001. 단기사채-매수화면 유의사항 발행물, 유통물 통일
	g_SHTR_BOND_REG_CLS_CODE = "2"
	
	if g_SHTR_BOND_REG_CLS_CODE == "1" then	'발행물
		Container0.Table0.visible = 1
		Container0.Table1.visible = 0		
	else	'유통물
		Container0.Table0.visible = 0
		Container0.Table1.visible = 1
	end if
	
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>