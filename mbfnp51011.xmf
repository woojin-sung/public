'============================================================================
' 01.화면명 	: 펀드매매
' 02.화면설명	: 펀드매매_추가매수탭
' 03.작성		: 2016.02.19
' 04 수정	:  2019.05.07 예금보험관계 표시 확인제도 관련 수정 v0001
' 			   2019.11.18 : 펀드실질수익률보고서 통보처 없으면 매수제어 v0002
'                2020.03.19 : 투자설명서 관련 수정 v0003
'			   2020.03.24 : 테스트를 위한 MTS 펀드매수 공인인증서 skip 코드 v0004
' 			   2020.09.15 : 비밀번호 메모리 평문 노출 취약점 조치 v0005
'			   2020.09.22 : 계좌콤보 변경 시 보유잔고 팝업토록 처리 v0006
'			   2021.07.13 : 고난도금융상품 업무제어 관련 소스 추가 및 사용하지 않는 소스 삭제 v0007
'			   2021.08.10 : 매수입력금액 노치있는 아이폰에서 키패드가 에디트 가리는 현상있어, 컨트롤들 다 컨테이너로 싸도록 수정 v0008
'			   2021.08.19 JHY : 신규매수와 동일하게 최소주문금액 체크라도록 추가 v0009
'			   2021.09.23 JHY : 핵심상품설명서 추가 v0010
'			   2022.01.11 JHY : v0011 오스템임플란트 팝업창 추가
'			   2022.03.17 임동군 : v0012 018r I/O 변경, 매수가능금액모듈 drab_001r -> deal_109r로 변경(중개형ISA 매수가능금액 틀어짐 보완)
'			   2022.08.02 임동군 : v0013 투설/간투설/핵심설명서 다시볼 수 있도록 체크 활설/비활성화 기능 살림
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt		'계좌번호 8+2
dim	g_szPasswd		'비밀번호
dim	g_szRmndNo		'펀드잔고번호

dim	g_szShortCd		'펀드단축코드
dim	g_szStndCd		'펀드풀코드
dim	g_szFndname		'펀드명
dim	g_szSaveType		'저축방법
dim	g_szDealFee		'선취수수료
dim	g_szAlertTitle	'알림타이틀
dim	g_szAutoMove		'신규매수에서 넘어온것인지

Dim g_szCTCN_FILE			'집합투자규약 파일명
Dim g_szINVT_FILE			'투자설명서 파일명
Dim g_szCORE_FILE			'간이설명서 파일명
Dim g_szCO_FILE			'벤처펀드약관 설명서 파일명

Dim	g_szCash	'매수가능 현금
Dim	g_szRp	'매수가능 현금성자산
Dim	g_MinAmount	'매수최소금액	'018r로 조회된 값
g_MinAmount = ""


g_szFullAcnt	=	""	
g_szPasswd	=	""
g_szRmndNo	=	""

g_szShortCd	=	""
g_szStndCd	=	""
g_szFndname	=	""
g_szSaveType	=	""
g_szDealFee	=	""
g_szAlertTitle	=	"알림"
g_szAutoMove	=	"0"			'메뉴얼

Dim g_szPROD_FILE '21.09.23 추가 : UI상품첨부파일원본명 (v0010)
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ResetItems
'============================================================================
Function	ResetItems()

	'1. 잔고번호
	'2. 저축방법
	'3. 매수가능금액초기화

'	contInput.tbl01.SetCellString(0, 1, "")		'잔고번호
'	contInput.tbl01.SetCellString(1, 1, "")		'저축방법
	contInput.LblPrcin.caption	=	"0"			'매수가능금액
	g_szRmndNo	=	""				'잔고번호
	g_szSaveType	=	""				'저축방법

End	Function

'============================================================================
'AddNum	:	수량입력
'============================================================================
Function	AddNum(nAddNum)
	dim szOrgNum
	
	szOrgNum = contInput.LblPrcin.caption	
	contInput.LblPrcin.caption	=	szOrgNum + nAddNum
	
	if	CDBL(contInput.LblPrcin.caption)		>	CDbl(contInput.lblInvtAbleAmt.caption)	then
		Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
		contInput.LblPrcin.caption	=	"0"
	end	if
End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'============================================================================
'투자설명서 가져오는 함수
'============================================================================
Function getInvtAtchFile()
 	
	DATAMANAGER.RequestTranData("obsim_idmn_080r")

End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'잔고			Form.SetSharedData("RMNDNO_51010", szSrno)			'추가매수위함
'저축방법  		Form.SetSharedData("SAVETYPE_51010" , "임의식")

'펀드코드		Form.SetSharedData("FUNDCODE_51010", g_szShortCd)		'결제정보, from fmtab
