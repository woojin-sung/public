'============================================================================
Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()	

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_szAccNo	= Form.GetSharedData("ADD_FUND_ACCOUNT_NO",false)	'계좌번호
		g_szAsNo		= Form.GetSharedData("ADD_FUND_ACCOUNT_SEQ",false)	'계좌순번
		g_szFullAcnt	= g_szAccNo & g_szAsNo

		contInput.cmbAccount.caption = g_szFullAcnt	'계좌콤보에 계좌번호SharedData 셋팅한번 더해줌.
		
		g_szShortCd	= tData[0]
		g_szStndCd 	= tData[1]	'종목코드(표준코드)
		g_szRmndNo 	= tData[2]	'잔고일련번호
	end if
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'잔고에서 선택한 계좌로 추가매수하기 위함.
	contInput.cmbAccount.enable = False
	
	if g_szStndCd <> "" and g_szStndCd <> null then
		DATAMANAGER.RequestTranData("oocwi_mall_003r")
	end if
	
	'계좌 체크
	if g_szAccNo <> "" and g_szAccNo <> null then 
		DATAMANAGER.RequestTranData("obsat_deal_109r")
		if	g_szShortCd	<>	""	then
			DATAMANAGER.RequestTranData("obsim_idmn_018r")
		end if
	end if
	
End Sub

'============================================================================
'contInput_btnAll_OnClick
'============================================================================
Sub contInput_btnAll_OnClick()
	dim szOrgNum
	
	szOrgNum = contInput.lblInvtAbleAmt.caption	'contInput.tbl02.GetCellString(0, 1)
	contInput.LblPrcin.caption	=	szOrgNum
End Sub

'============================================================================
'contInput_btnAddBuy_OnClick
'============================================================================
Sub contInput_btnAddBuy_OnClick()
	if f_bCheckBeforeReg() then
		szParam = contInput.cmbAccount.total & "★" & contInput.cmbAccount.sequence & "★" & g_szShortCd
		Form.openPopupAnimation("mbfnp51011_p2", szParam, "", "2")	'약관동의팝업
	end if
End Sub

'============================================================================
'f_bCheckBeforeReg() : 펀드매수 적합성 체크
'============================================================================
Function f_bCheckBeforeReg()

	'계좌번호 존재 유무 체크
	if contInput.cmbAccount.total == "" or contInput.cmbAccount.total == null or Len(contInput.cmbAccount.total) < 8 then
		Form.MsgBox("알림", "계좌번호를 확인해주세요.", "", 0)
		return false
	end if
	
	if	g_szRmndNo =	""		then
		Form.ShowAlert(g_szAlertTitle, "매수펀드를 선택하여 주시기 바랍니다.")
		Exit	Function
	end if

	if tonumber(contInput.LblPrcin.caption) <> NULL and tonumber(contInput.lblInvtAbleAmt.caption) <> NULL then
		if tonumber(g_MinAmount) > tonumber(contInput.LblPrcin.caption) then
			Form.ShowAlert(g_szAlertTitle, "신청하신 금액이 최소매수금액보다 작습니다. 매수신청 금액을 확인하시기 바랍니다.")
			return false
		end if
		
		if	tonumber(contInput.LblPrcin.caption) > tonumber(contInput.lblInvtAbleAmt.caption) or tonumber(contInput.LblPrcin.caption) == 0 then
			Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
			return false
		end	if
		
	else
		Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
		return false
	end if
	'21.08.19 JHY END

	if	g_szShortCd = NULL	or	len(g_szShortCd)	<	3	then
		Form.ShowAlert(g_szAlertTitle, "종목을 선택하여주시기바랍니다.")
		Exit	Function
	end	if
	

	'적합
	return true
End Function

'============================================================================
' BtnPrcin_OnClick
'============================================================================
Sub contInput_BtnPrcin_OnClick()
	Dim szPrc, szData

	szPrc = ""
	
	contInput.BtnPrcin.caption = ""
	contInput.LblPrcin.caption = ""
	
'	Form.SetSharedData("OPEN_FILE_NAME", "mbfnp51010" )


	if tonumber(contInput.lblInvtAbleAmt.caption) <> NULL and tonumber(contInput.lblInvtAbleAmt.caption) <> NULL then
		szMaxPrc = contInput.lblInvtAbleAmt.caption		'매수가능 합계
	else
		szMax = 0
	end if

	Form.openPopup("mbfnp51010_p20", szPrc.."★"..szMaxPrc, "")	'mhtro16090_p1
	
End Sub

'============================================================================
Sub contInput_LblPrcin_OnClick()
	contInput.ImgPrcreset.visible = true
	if Trim(g_szPopPrc) <> "" then
		szPrc = CLng(g_szPopPrc)
	else
		szPrc = CLng(contInput.LblPrcin.caption)
	end if
	
	dim nAbleAmt			'가능금액
	dim nInputAmt			'매수신청금액
	nAbleAmt	=	0
	
	nAbleAmt		=	CDbl(contInput.lblInvtAbleAmt.caption)
	nInputAmt	=	contInput.LblPrcin.caption

	if	Cdbl(nInputAmt)	>	Cdbl(nAbleAmt)	then
		contInput.LblAlert.caption = "매수가능 금액을 초과합니다."
		contInput.LblPrcin.caption	=	"0"
		
		return false	
		
	else
		
		contInput.LblAlert.caption = ""
		if szPrc == 0 then
			contInput.LblPrcin.caption = ""
			contInput.BtnPrcin.caption = "금액을 입력해주세요"
		else
			contInput.LblPrcin.caption = szPrc	
		end if
		
	
	end	if
	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_szAccNo		= left(contInput.cmbAccount.caption, 8)		'계좌번호
	g_szAsNo			= mid(contInput.cmbAccount.caption, 9, 2)	'계좌순번
	g_szFullAcnt		= g_szAccNo & g_szAsNo
	g_szFnprJoinSrno	= Form.GetSharedData( "FNPR_JOIN_SRNO", false )	'금융상품일련번호
	
	
	if	szTranID	=	"oocwi_mall_003r"	then
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "ISCD", 0, g_szStndCd)
		
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
		
    ' v012 임동군 추가
    elseif	szTranID	=	"obsat_deal_109r"	then
		DATAMANAGER.SetDataValue(0, "obsat_deal_109r", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obsat_deal_109r", "InBlock1", "ASNO", 0, g_szAsNo)
	elseif	szTranID	=	"obsai_deal_001a"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "CONT_CLS_CODE", 0, "4")	'접촉구분코드 HTS 4
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "ASNO", 0, g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "RMND_SRNO", 0, g_szRmndNo )
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "CASH_AMT", 0, 	g_szCash )
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "RP_VLTN_AMT", 0,	g_szRp )
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "BYOV_AMT", 0, contInput.LblPrcin.caption)	
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		
		'21.07.20 JHY START
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CAFU_TRGT_YN" 		, 0 	, g_szCAFU_TRGT_YN ) '숙려대상여부
		
		Dim szHgdtYN, szOldtYN, szInfoYN, szUnfitYN
		szHgdtYN 	= Form.GetSharedData("700r_HGDT_PROD_YN", false) '고난도상품여부
		szOldtYN 	= Form.GetSharedData("700r_CAFU_OLDT_YN", false) '숙려고령자여부
		szInfoYN 	= Form.GetSharedData("700r_INFO_REFS_YN", szInfoYN) '정보미제공여부
		szUnfitYN 	= Form.GetSharedData("700r_UNFIT_YN", szUnfitYN) '부적합여부		
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "HGDT_PROD_YN" 		, 0 	, szHgdtYN ) '고난도상품여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CAFU_OLDT_YN" 		, 0 	, szOldtYN ) '숙려고령자여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "INFO_REFS_YN" 		, 0 	, szInfoYN ) '정보미제공여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UNFIT_YN" 		, 0 	, szUnfitYN ) '부적합여부
		'21.07.20 JHY END
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_SRNO"	, 0	, g_szFnprJoinSrno )		'금융상품일련번호
	
	'v0002
	elseif	szTranID =	"obcsb_acad_106r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_106r", "InBlock1", "ACNO" , 0, g_szAccNo)
	'v0003
	elseif	szTranID =	"obsim_idmn_080r" then
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "ISCD"				, 0, g_szShortCd	)
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "MFI_ATCH_FILE_CLCD" 	, 0, "%"			)
		
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szCash, szRp
	dim	szMsg
	
	szCash	=""
	szRp		=""
	szMsg	=""
	
	if	szTranID	=	"oocwi_mall_003r"	then
		Dim szGradCode, szTransGradNm, szTypeNm, szFundName
		
		szGradCode = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "PROD_GRAD_CODE", 0) 	'펀드등급
		szTransGradNm = Form.GetMetaData("집합투자증권상품등급코드", szGradCode)
		contInput.lblRiskNm.caption = szTransGradNm
		'contInput.lblRiskNm.fgcolor = 261
		
'		if szGradCode = "01" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_296.png"
'		elseif szGradCode = "02" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_297.png"
'		elseif szGradCode = "03" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_298.png"
'		elseif szGradCode = "04" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_299.png"
'		elseif szGradCode = "05" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		else
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		end if
		if szGradCode = "01" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_372.png"
			contInput.lblRiskNm.fgcolor = 273
		elseif szGradCode = "02" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_373.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "03" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_374.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "04" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_375.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "05" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_376.png"
			contInput.lblRiskNm.fgcolor = 144
		else
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_377.png"
			contInput.lblRiskNm.fgcolor = 273
		end if
		
		szTypeNm = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_TYPE_NAME", 0) 	'펀드유형		
		contInput.lblTypeNm.caption = szTypeNm
		
		szFundName = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_KOR_FUND_NAME", 0)	'펀드명
		contInput.lblFundNm.caption = szFundName
		contInput.lblFundNm.SetMaxLineCount(2)	'컨트롤 라인 제한 함수
		contInput.ImgBadge2.imgpath = "img_bgsquare_grade_316.png"
		
	
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD", 0 , "02") '추가매수
		DATAMANAGER.RequestTranData("obsai_deal_701r")
		
	elseif	szTranID	=	"obsim_idmn_018r"	then
		g_szStndCd	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "SCTY_STND_CODE", 0 )
		g_MinAmount = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "STA_SDPR", 0 ))	'매수최소금액
	
		szSaComCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IISC_ITCO_CODE", 0) 	'집합투자증권투자신탁회사코드 = "511" : 계열사
		szHGDTYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "HGDT_PROD_YN", 0)	'고난도상품여부
		szFITYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "FIT_PROD_YN", 0)	'적정성상품여부
				
		'----- 적정성/고난도 유형 -----
		''적정성이나 고난도인 경우, 위험등급|펀드유형|적정성/고난도|계열사 순으로 뱃지 보이고
		''적정성이나 고난도가 아닌 경우, 위험등급|펀드유형|계열사 뱃지만 보이도록 뱃지 위치 조정	
		if szFITYn = "Y" or szHGDTYn = "Y"  then			
			if szFITYn == "Y" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_302.png"
				contInput.lblBadge3.caption = "적정성상품"
				contInput.lblBadge3.fgcolor = 261
			end if
			
			if szHGDTYn == "Y" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_302.png"
				contInput.lblBadge3.caption = "고난도상품"
				contInput.lblBadge3.fgcolor = 261
			end if
			'----- 적정성/고난도 유형 -----
				
			'----- 계열사구분코드 -----
			if szSaComCode = "511" then
				contInput.ImgBadge4.imgpath = "img_bgsquare_grade_303.png"
				contInput.lblBadge4.caption = "계열사"
				contInput.lblBadge4.fgcolor = 261
			else
				contInput.ImgBadge4.imgpath = "alpha.png"
				contInput.lblBadge4.caption = ""
				contInput.lblBadge4.fgcolor = 261
			end if
			'----- 계열사구분코드 -----
		
		else			
			'----- 계열사구분코드 -----
			if szSaComCode = "511" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_303.png"
				contInput.lblBadge3.caption = "계열사"
				contInput.lblBadge3.fgcolor = 261
			else
				contInput.ImgBadge3.imgpath = "alpha.png"
				contInput.lblBadge3.caption = ""
				contInput.lblBadge3.fgcolor = 261
			end if
	
			contInput.ImgBadge4.imgpath = "alpha.png"
			contInput.lblBadge4.caption = ""
			contInput.lblBadge4.fgcolor = 261
			'----- 계열사구분코드 -----
		end if
		

	'v012 임동군 추가
    elseif	szTranID	=	"obsat_deal_109r"	then
		g_szCash	= CDbl(DATAMANAGER.GetDataValue(0, "obsat_deal_109r", "OutBlock1", "CASH_AMT",0)) 
		g_szRp 	= CDbl(DATAMANAGER.GetDataValue(0, "obsat_deal_109r", "OutBlock1", "RP_VLTN_AMT" ,0))  
		
		if tonumber(g_szCash) <> NULL and tonumber(g_szRp) <> NULL then
			contInput.lblInvtAbleAmt.caption = trim(g_szCash + g_szRp	)
		end if


		Form.OpenPopup("mbonl81010_p1" , "51000★1★" & g_szAccNo & "★" &  g_szAsNo & "★" &  g_szShortCd)	
		g_szFnprJoinSrno = Form.GetSharedData( "FNPR_JOIN_SRNO", false )
		

	elseif	szTranID	=	"obsai_deal_001a"	then
		'21.07.20 JHY START
		Dim szCAFU_DDLN_STA_DATE, szCAFU_DDLN_FIN_DATE, szINTN_DTRM_STA_DATE, szINTN_DTRM_FIN_DATE
		
		szCAFU_DDLN_STA_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE1", 0 )
		szCAFU_DDLN_FIN_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE2", 0 )
		szINTN_DTRM_STA_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE3", 0 )
		szINTN_DTRM_FIN_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE4", 0 )
		'21.07.20 JHY END
		
		g_szSDPR_APLY_DATE 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SDPR_APLY_DATE", 0)	'기준가적용일자
		g_szSTLM_DATE 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STLM_DATE", 0)			'결제일자
		g_szPRCP_FEE 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRCP_FEE", 0)			'선취수수료
		
		
		if	DATAMANAGER.GetDataMsgCode("obsai_deal_001a")		=	"8128"	then
			szMsg	=	Form.GetSharedData("&HOST_DATE", 0)
			szMsg	=	szMsg & " 에 매도 신청한 전액매도 결제시, 현재 매수 신청하는 금액은 미포함 됩니다. 처리하시겠습니까?"
			Form.MsgBox(g_szAlertTitle, szMsg, "MSG_8128", 6)
		else				
			
			
			'21.07.20 JHY START
			
			'
'''			contInput.LblPrcin.caption	=	"0"									'1.	매수가능금액 초기화
''			if len(g_szFullAcnt)	>	8	then
''			    ' v012 임동군 변경
''				'DATAMANAGER.RequestTranData("obrtp_drab_001r")			'2. 잔고재조회
''				DATAMANAGER.RequestTranData("obsat_deal_109r")			'2. 잔고재조회
''			end if
			
			if g_szCAFU_TRGT_YN = "Y" then 
				Dim szSavingTpCode
				g_szSaveType = Form.GetSharedData("ADD_FUND_SAVETYPE")
				
				if g_szSaveType == "임의식" then
					szSavingTpCode = "1"
				elseif g_szSaveType == "자유적립식" then
					szSavingTpCode = "3"
				else
					szSavingTpCode = "1"
				end if 
				
				Dim szHgdtYN, szOldtYN, szInfoYN, szUnfitYN
				szHgdtYN 	= Form.GetSharedData("700r_HGDT_PROD_YN", false) '고난도상품여부
				szOldtYN 	= Form.GetSharedData("700r_CAFU_OLDT_YN", false) '숙려고령자여부
				szInfoYN 	= Form.GetSharedData("700r_INFO_REFS_YN", szInfoYN) '정보미제공여부
				szUnfitYN 	= Form.GetSharedData("700r_UNFIT_YN", szUnfitYN) '부적합여부		
				
				Dim szReason
				szReason = "숙려제도 대상 고객"
				
				if szHgdtYN == "Y" then
					szReason = "고난도상품"
				elseif szOldtYN == "Y" then
					szReason = "만 65세 이상 투자자"
				elseif szUnfitYN == "Y" then
					szReason = "부적합투자자"
				end if
				
				Form.OpenPopup("mbonl81010_p9" ,	g_szRmndNo  & "★" &  
													g_szFndname	& "★" & szSavingTpCode	& "★" &
													szReason 	& "★" & szCAFU_DDLN_STA_DATE	& "★" & szCAFU_DDLN_FIN_DATE& "★" & szINTN_DTRM_STA_DATE	& "★" & szINTN_DTRM_FIN_DATE
										, sPosInfo)
				Exit Sub
				
			else 
				
				'완료 페이지	'펀드매수신청이 완료되었습니다
				Form.OpenPopup("mbfnp51011_p3", g_szAccNo & g_szAsNo & "★" & contInput.lblFundNm.caption & "★" & contInput.LblPrcin.caption & "★" & g_szSDPR_APLY_DATE & "★" & g_szSTLM_DATE & "★" & g_szPRCP_FEE & "★N"
										, sPosInfo)
				Exit Sub
			
			end if
			'21.07.20 JHY END
		end	if
	'v0003 추가
	elseif	szTranID =	"obsim_idmn_080r" then
		 g_szCTCN_FILE = 	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CTCN_ATCH_FILE_ORTX_NAME", 0)	'집합투자규약 파일명
		 g_szINVT_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_INVT_ATCH_FILE_ORTX_NAME", 0)	'투자설명서 파일명
		 g_szCORE_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CORE_ATCH_FILE_ORTX_NAME", 0)	'간이설명서 파일명
		 g_szCO_FILE	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CO_ATCH_FILE_ORTX_NAME", 0)		'벤처펀드약관 설명서 파일명
		 
		 '21.09.23 JHY START (v0010)
		 g_szPROD_FILE	=	DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "UI_PROD_ATCH_FILE_ORTX_NAME", 0)		'UI상품첨부파일원본명
		 '21.09.23 JHY END
	'v0011
	elseif	szTranID	=	"obsai_deal_701r"	then
		 g_szFND_DEAL_RSTC_CLCD = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "FND_DEAL_RSTC_CLCD", 0)	'펀드매매제한구분코드
		 g_szTN_INFORM_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "TN_INFORM_YN", 0)		'주의알림여부
		 g_szDEAL_ABLE_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "DEAL_ABLE_YN", 0)		'매매제한여부
		 
		 if g_szTN_INFORM_YN = "Y" then
			 if g_szFND_DEAL_RSTC_CLCD = "001" then
				 'Form.ShowAlert(g_szAlertTitle, "선택하신 펀드는 횡령사건으로 거래가 중지된 오스템임플란트 주식을 편입하고 있습니다. 해당펀드는 오스템임플란트 주가를 작년말 종가로 기준가격에 반영하고 있어 향후 전개상황에 따라 펀드 수익률 변동이 예상됩니다. 투자의사 결정시 참고하시기 바랍니다. 자세한 사항은 고객센터(1588-3400) 또는 거래 영업점으로 문의하시기 바랍니다.")
				 Form.ShowAlert(g_szAlertTitle, "선택하신 펀드는 오스템임플란트 주식(2022.01.03일자 거래정지)을 편입하고 있습니다. 오스템임플란트 주식을 편입한 펀드의 경우, 운용사에서 공정가치 재평가 후 자산 상각을 진행하여 기준가에 반영하였으나 향후 추가 상각될 가능성이 있습니다. 이와 관련하여 편입비율 변동 및 추가 위험에 노출될 수 있으니 투자시 유의하시기 바랍니다. 자세한 사항은 거래 영업점 또는 고객센터(1588-3400)로 문의하시기 바랍니다.")
				 

			 elseif g_szFND_DEAL_RSTC_CLCD = "002" then
				 Form.ShowAlert(g_szAlertTitle, "선택하신 펀드는 주요 투자 지역(러시아)의 지정학적 리스크 확대 및 투자자산의 유동성 제한에 따라 환매 연기 조치 되었습니다. 이에 따라 적립식 매수를 포함한 매수신청이 제한됨을 안내드립니다.")	 
			 end if
			 
			 if g_szDEAL_ABLE_YN = "N" then
				 contInput.btnAddBuy.enable = FALSE
			 else 
				 contInput.btnAddBuy.enable = TRUE
			 end if
		 else 
			 contInput.btnAddBuy.enable = TRUE
		 end if
		 		
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'v0002
	if szTranID =	"obcsb_acad_106r" and szErrCode = "5820" then
		Form.OpenPopup("mbfnp51010_p10" , "통보처★" & left(g_szFullAcnt, 8), sPosInfo) ''에러
	else
	
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	end if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	dim	szRmno,	szFundCode,	szStndCode,	szFundName

	'===============================================
	' 가격입력창에서 리턴
	'===============================================
	if sKeyName == "PRC_POPUP" then	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			contInput.ImgPrcreset.visible = true
			g_szPopPrc = sRet
			
			contInput.LblPrcin.mask="0,0,,원,0,,0,1,0,0,0"
			
			contInput.LblAlert.visible = 1
			
			call contInput_LblPrcin_OnClick()
		else
			contInput.ImgPrcreset.visible = false
			contInput.LblAlert.caption = ""	'' 
			contInput.BtnPrcin.caption = "금액을 입력해주세요"
			
			contInput.LblAlert.visible = 0			
		end if

	'-----------------------------------
	'투자성향확인
	'-----------------------------------		
	elseif	sKeyName = 	"KYCCHK_RETURN"	then

		if	sRet	=	"Y"	then
			'21.07.20 JHY START
			'숙려대상여부 
			g_szCAFU_TRGT_YN		= Form.GetSharedData("CAFU_TRGT_YN", 0 )
			
			contInput.btnAddBuy.enable = true
			
		else			
			contInput.btnAddBuy.enable = false
			Exit Sub
			
		end if
	
	'===============================================
	'********** 약관 동의 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbfnp51011_p2" Then		
		if sRet == "ok" then
			Dim sSendData
			sSendData = contInput.cmbAccount.total&contInput.cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")		
		end if
		
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	Elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contInput.edtPassword.pwdlen = tData(1)
				contInput.edtPassword.caption = tData(0)
			end if
			
			Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)			'공통프로세스 체크완료후 공인인증서
		end if
		
	'==============================================
	'*********** 공동인증서 성공여부 리턴 ************
	'==============================================
	elseif sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공			
			
			DATAMANAGER.SetEventFlag("obsai_deal_001a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_001a")	'매수신청
		
		else						'실패
			contInput.btnAddBuy.enable = false
			exit sub
		end if
		
	'===============================================
	'********** 신청 완료 팝업 리턴  ***********
	'===============================================
	elseif	sKeyName =	"mbfnp51011_p3" then
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			g_szRet = sRet
			Form.CloseForm()
		end if	

	'-----------------------------------
	'잔고팝업(CLOSE시)
	'-----------------------------------	
	Elseif	sKeyName	=	"51010_RMNOSELECTED"	then
		if	sRet	=	"0"		then
			'Form.triggerEvent("#", "CHGTAB_51010", "4")
			ResetItems()	'잔고, 저축타입,매수금액초기화
		end	if
	
	'-----------------------------------------------
	'펀드 실질투자수익률 보고서 통보처 팝업 v0002
	'-----------------------------------------------
	elseif	sKeyName =	"returnACTL_RPRT_INAG"	then
		'통보처 등록 성공
		if	sRet =	"SUCC" then
			
			DATAMANAGER.RequestTranData("obcsb_acad_106r")
		'통보처 등록 실패
		else
			Form.ShowAlert("알림", "펀드 실질투자수익률 보고서 통보처 선택은 필수입니다.")
			Form.OpenPopup("mbfnp51010_p10" , "통보처★" & left(g_szFullAcnt, 8), sPosInfo) ''에러
			'contInput.btnBuy.enable = False
		end if

	'-----------------------------------------------
	'숙려안내 popup return
	'-----------------------------------------------	
	elseif	sKeyName = "mbonl81010_p9"		then						'고위험거래확인팝업
		if 	sRet = 	"OK" then
			'완료 페이지	'펀드매수신청이 완료되었습니다
			Form.OpenPopup("mbfnp51011_p3", g_szAccNo & g_szAsNo & "★" & contInput.lblFundNm.caption & "★" & contInput.LblPrcin.caption & "★" & "XXX" & "★" & "XXX" & "★" & g_szPRCP_FEE & "★Y"
			, sPosInfo)
				
			'Form.ShowAlert(g_szAlertTitle, "펀드매수신청이 완료되었습니다.")
		end if
	'21.07.09 JHY END	
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51011", g_szRet)
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
    Form.CloseForm()
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.OpenPopup("mbfnp51011_p1" , sOpenData , sPosInfo)
End Sub

'============================================================================
Sub contInput_cmbAccount_ChangeAccount()	
	DATAMANAGER.RequestTranData("obsim_idmn_018r")
End Sub

