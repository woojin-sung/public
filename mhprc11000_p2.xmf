Sub imgchart_OnClick()
'	grdCNTG.visible = true
'	ChartEx0.visible = false
'	imgchart.visible = false
	g_bGrd_Chart_Toggle = "CHART"
	imgToggle4_OnClick()
End Sub

'============================================================================
Sub grdCNTG_OnClickUp(lRow, szCellID)
	g_bGrd_Chart_Toggle = "GRID"
	imgToggle4_OnClick()	
End Sub

'============================================================================
Sub imggrdCnTGHeader_OnClick(lRow, szCellID)
	g_bGrd_Chart_Toggle = "GRID"
	imgToggle4_OnClick()	
End Sub
