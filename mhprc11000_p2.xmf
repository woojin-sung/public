			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		
		'20180712 HAMWG START : K-OTC MTS 도입
		ElseIf g_szItemMarket = "T" Then
			DATAMANAGER.RequestRealData( "ohhts_frbr_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
		
		Else
			DATAMANAGER.RequestRealData( "ohhts_stck_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
			
