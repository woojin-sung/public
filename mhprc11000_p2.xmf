		    szDataA1 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN1" , 0 )
		    szDataA2 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN2" , 0 )
		    szDataA3 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN3" , 0 )
		    szDataA4 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN4" , 0 )
		    szDataA5 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN5" , 0 )
		    szDataA6 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN6" , 0 )
		    szDataA7 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN7" , 0 )
		    szDataA8 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN8" , 0 )
		    szDataA9 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN9" , 0 )
		    szDataA10 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN10" , 0 )
		    
		    
		    szDataB1 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN1" , 0 )
		    szDataB2 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN2" , 0 )
		    szDataB3 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN3" , 0 )
		    szDataB4 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN4" , 0 )
		    szDataB5 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN5" , 0 )
		    szDataB6 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN6" , 0 )
		    szDataB7 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN7" , 0 )
		    szDataB8 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN8" , 0 )
		    szDataB9 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN9" , 0 )
		    szDataB10 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_BIDP_RSQN10" , 0 )
		    
		    if cint(szDataA1) = 0 then
				szDataA1 = ""
			end if
			
			if cint(szDataA2) = 0 then
				szDataA2 = ""
			end if
			
			if cint(szDataA3) = 0 then
				szDataA3 = ""
			end if
			
			if cint(szDataA4) = 0 then
				szDataA4 = ""
			end if
			
			if cint(szDataA5) = 0 then
