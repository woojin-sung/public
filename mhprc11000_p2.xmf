'
'20230420 KKM 현재가개선 : 시고저 대비율 테이블 삭제하고 시고저가와 바로 아래 표기로 tblPrice0, tblPrice4, tblPrice5 삭제
'20230420 KKM 현재가개선 : 좌하단 체결/차트 토글 이미지로 변경
'20230420 KKM 현재가개선 : 폰트와 색상 수정
'20230420 KKM 현재가개선 : 대비율 (-)(%) 표기
'20230913 LES START - 시세묶음 처리
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szDiplayrest
Dim g_szLP	'20240503_01 HWG : MTS ETF 고도화 대응
Dim g_szAplyCode
'Dim g_tblPriceStyle
'g_tblPriceStyle = "1"

Dim g_nSdpr	'20191107 HWG : 시고저등락률 계산오류 수정
g_nSdpr = 0

Dim g_bGrd_Chart_Toggle
g_bGrd_Chart_Toggle = "GRID"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function RequestData()
	DATAMANAGER.CancelRealData( "ohhts_elw_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_elw_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_stck_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_mbcr" )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_frbr_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_lppr" )

	DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
	DATAMANAGER.RequestTranData( "ohhts_1001_004r" )
	DATAMANAGER.RequestTranData( "ohhts_1001_005r" )
	
	'20180511 LES START 정적VI 추가
	DATAMANAGER.RequestTranData("ohhts_viex_001r")
	
	
	'차트 조회-----------------------------------------------------------------------
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)

	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 
	
	szToday = Form.GetSharedData("&HOST_DATE", 0 )
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1" , 0, szToday)
	DATAMANAGER.RequestTranData("ohhts_5010_001r")	
	'-------------------------------------------------------------------------------------

end Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Function SetHogaTblFgColor( nPrice )

	If nPrice  > 0 then 
		tblHoga.SetCellFgColor( 0, 0, "10" )
	ElseIf nPrice < 0 then
		tblHoga.SetCellFgColor( 0, 0, "11" )
	Else
		tblHoga.SetCellFgColor( 0, 0, "12" )
	End If

End Function

Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth, szHAlign

	szDispdiff		= Form.LoadConfigData("mhprc11000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc11000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc11000", "Diplayrest"	)	'호가직전수량표시
	g_szLP			= Form.LoadConfigData("mhprc11000", "LP"	)			'LP잔량 '20240503_01 HWG : MTS ETF 고도화 대응
	szPriceoutline	= Form.LoadConfigData("mhprc11000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc11000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldJan		= Form.LoadConfigData("mhprc11000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc11000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" or g_szLP = "1" Then
			'szColWidth = "45,74,98,40,73,45"
			szColWidth = "44,72,93,48,72,44"
		Else
			'szColWidth = "0,119,98,40,118,0"
			szColWidth = "0,116,93,48,116,0"
		End If
		szHAlign = "2"
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" or g_szLP = "1"  Then
			'szColWidth = "45,74,138,0,73,45"
			szColWidth = "44,72,141,0,72,44"
		Else
			'szColWidth = "0,119,138,0,118,0"
			szColWidth = "0,116,141,0,116,0"
		End if
		szHAlign = "1"
	End If	
	'20240503_01 HWG END
	
	'호가등락률
	hogaTbl.SetColumnWidth( szColWidth )
	
	tblTime.SetColumnWidth( "119,138,0,118" )
	
	'호가잔량그래프
	hogaTbl.hojangraph = szJangraph
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	if g_szLP = "1" then
		hogaTbl.setUseLPChange(true)
	elseif g_szLP = "0" then
		hogaTbl.setUseLPChange(false)
	else
		hogaTbl.setUseLPChange(false)
	end if
	'20240503_01 HWG END
	
	'현재가 외곽선 표시
	hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 19
		'호가
		If szBoldHoga = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 1 , "01")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 1 , "00")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		'호가 가로 정렬
		hogaTbl.SetCellHAlign(i, 2, szHAlign)		
	Next

End Function


'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szItemCode		= arrData(0)
	g_szItemMarket	= arrData(1)	
	
	Form.SetScreenName( arrData(2) )
	
	ChartEx0.setChartType("minibong")
	
	'20170814 LES START
'	g_tblPriceStyle = Form.LoadConfigData("mhprc11000", "tblPriceStyle")
	
'	if g_tblPriceStyle == "" then
'		g_tblPriceStyle = "1"
'	end if
	'20170815 LES START
		
'	g_szItemCode =  Form.GetSharedData( "&ITEM_STOCK", 0 )
'	g_szItemCode = "005930"
'	g_szItemMarket = "J"

	imgToggle4.SetMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'20230913 LES START - 시세묶음 처리
	Form.SetRealBundle("1")


	tblTime.visible   = false		' 시간외	
	
	'20170804 LES START
	'if g_tblPriceStyle == "1" then
	'	tblPrice0.visible = false	
	'else
	'	tblPrice1.visible = false
	'end if
		
	'tblPrice4.visible = false		'예상체결%
	'tblPrice5.visible = false 		'변동성%
	
	tblPrice1.visible = true
	tblPrice2.visible = false		' 예상체결
	tblPrice3.visible = false		' 변동성
	
	'imgToggle2.visible = false
	'imgToggle3.visible = false
	'20170804 LES END
	
	grdCNTG.scrollenable = "0"
	ChartEx0.visible = false
	imgchart.visible = false
	
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "2" then '아이폰
       'grdCNTG.left = 1
       ChartEx0.Top = 306
       ChartEx0.width = 117
       tblPrice1.Top = 92
	   Label0.left = -4
	   Grid0.left = 51       
      else   
'       grdCNTG.left = 0
'       ChartEx0.Top = 308
	   Label0.setNeighborCtlPos(Grid0, "left", 2, "") '20230522 KKM 안드로이드 공통적용
     end if	

	'환경설정 Load
	Set_HogaTable()
	RequestData()	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    If szTranID = "ohhts_1001_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

    '20180511 LES START 정적VI 추가
    elseif szTranID = "ohhts_viex_001r" then
	    DATAMANAGER.SetDataValue(0, "ohhts_viex_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szItemCode)
	    DATAMANAGER.SetDataValue(0, "ohhts_viex_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket)
    
    
    ElseIf szTranID = "ohhts_1001_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

	Elseif szTranID = "ohhts_1001_004r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	Elseif szTranID = "ohhts_1001_005r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

	Elseif szTranID = "ohhts_3800_004r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_3800_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)

	Elseif szTranID = "ohhts_1126_001r" then
		Dim szOrdCode
	
	    DATAMANAGER.CancelRealData("ohhts_stck_stat")
	    
	    If Left(g_szItemCode, 1) = "J" or Left(g_szItemCode, 1) = "F" Then
		    szOrdCode = g_szItemCode		    
	    ElseIf g_szItemMarket = "J" or g_szItemMarket= "T" Then	'주식	    
		    szOrdCode = "A" + g_szItemCode		    
		ElseIf g_szItemMarket = "W" Then	'ELW
		    szOrdCode = "J" + g_szItemCode		    
		Else
		    szOrdCode = g_szItemCode		    
		End If
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1126_001r", "InBlock1", "FID_SHRN_ISCD", 0 , szOrdCode )
	    
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szCode
	
	szCode = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_stck_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_stck_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , g_szItemCode )
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	ElseIf szTranID = "ohhts_stck_lppr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_lppr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	'20240503_01 HWG END
	
	ElseIf szTranID = "ohhts_stck_mbcr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_mbcr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_stck_stat" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_stat", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_elw_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_elw_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_frbr_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_frbr_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_smns_rate" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_smns_rate", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	'20180521 LES START 정적VI추가
	ElseIf szTranID = "ohhts_stck_viex" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_viex", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode)
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_1001_001r" Then
		Dim szItemName
		Dim 	nPrice					'전일대비
		
		szItemName 	= Trim( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_KOR_ISNM" , 0 ) )
		nPrice 		= DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_PRDY_VRSS" , 0 )
		
		SetHogaTblFgColor( CDbl( nPrice ) )	
		
		'호가컨트롤 속성		
		hogaTbl.startprice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0 )
		hogaTbl.highprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0 )
		hogaTbl.lowprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0 )		
	
	
		'=================================================================================
		'20170803 LES START - 시고저 등락률 추가 + 상/하한 등락률 추가
		'=================================================================================
		sdpr = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_SDPR" , 0)
		siga = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0)
		goga = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0)
		juga = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0)
		hprc = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_MXPR" , 0)
		lprc = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_LLAM" , 0)
		
		g_nSdpr = sdpr	'20191107 HWG : 시고저등락률 계산오류 수정
		
		'20191107 HWG START : 시고저등락률 계산오류 수정
		if CInt(sdpr) > 0 then
		
			goga_debi = (goga / sdpr * 100 ) - 100
			siga_debi = (siga / sdpr * 100 ) - 100
			juga_debi = (juga / sdpr * 100 ) - 100
			hprc_debi = ((hprc - sdpr) / sdpr) * 100
			lprc_debi = ((lprc - sdpr) / sdpr) * 100
			
			'고가
			if goga_debi < 0 then
'				goga_debi = goga_debi * -1
'				tblPrice0.SetCellFgColor(1, 1, 11) '11 : 파란색
'				tblPrice4.SetCellFgColor(1, 1, 11)
'				tblPrice5.SetCellFgColor(1, 1, 11)
				tblPrice1.SetCellFgColor(5, 1, 11) 
				tblPrice2.SetCellFgColor(5, 1, 11)
				tblPrice3.SetCellFgColor(5, 1, 11)
			elseif goga_debi > 0 then
'				tblPrice0.SetCellFgColor(1, 1, 10) '10 : 빨간색
'				tblPrice4.SetCellFgColor(1, 1, 10)
'				tblPrice5.SetCellFgColor(1, 1, 10)
				tblPrice1.SetCellFgColor(5, 1, 10) 
				tblPrice2.SetCellFgColor(5, 1, 10) 
				tblPrice3.SetCellFgColor(5, 1, 10) 
			else
'				tblPrice0.SetCellFgColor(1, 1, 3) 
'				tblPrice4.SetCellFgColor(1, 1, 3)
'				tblPrice5.SetCellFgColor(1, 1, 3)
			end if
			
			'시가
			if siga_debi < 0 then
'				siga_debi = siga_debi * -1
'				tblPrice0.SetCellFgColor(2, 1, 11)
'				tblPrice4.SetCellFgColor(2, 1, 11)
'				tblPrice5.SetCellFgColor(2, 1, 11)
				tblPrice1.SetCellFgColor(3, 1, 11)
				tblPrice2.SetCellFgColor(3, 1, 11)
				tblPrice3.SetCellFgColor(3, 1, 11)
			elseif siga_debi > 0 then
'				tblPrice0.SetCellFgColor(2, 1, 10)
'				tblPrice4.SetCellFgColor(2, 1, 10)
'				tblPrice5.SetCellFgColor(2, 1, 10)
				tblPrice1.SetCellFgColor(3, 1, 10)
				tblPrice2.SetCellFgColor(3, 1, 10)
				tblPrice3.SetCellFgColor(3, 1, 10)
			else
'				tblPrice0.SetCellFgColor(2, 1, 3) 
'				tblPrice4.SetCellFgColor(2, 1, 3)
'				tblPrice5.SetCellFgColor(2, 1, 3)
				tblPrice1.SetCellFgColor(3, 1, 3)
				tblPrice2.SetCellFgColor(3, 1, 3)
				tblPrice3.SetCellFgColor(3, 1, 3)
			end if
			
			'저가
			if juga_debi < 0 then
'				juga_debi =juga_debi * -1
'				tblPrice0.SetCellFgColor(3, 1, 11)
'				tblPrice4.SetCellFgColor(3, 1, 11)
'				tblPrice5.SetCellFgColor(3, 1, 11)
				tblPrice1.SetCellFgColor(7, 1, 11)
				tblPrice2.SetCellFgColor(7, 1, 11)
				tblPrice3.SetCellFgColor(7, 1, 11)
			elseif juga_debi > 0 then
'				tblPrice0.SetCellFgColor(3, 1, 10)
'				tblPrice4.SetCellFgColor(3, 1, 10)
'				tblPrice5.SetCellFgColor(3, 1, 10)
				tblPrice1.SetCellFgColor(7, 1, 10)
				tblPrice2.SetCellFgColor(7, 1, 10)
				tblPrice3.SetCellFgColor(7, 1, 10)
			else
'				tblPrice0.SetCellFgColor(3, 1, 3) 
'				tblPrice4.SetCellFgColor(3, 1, 3)
'				tblPrice5.SetCellFgColor(3, 1, 3)
				tblPrice1.SetCellFgColor(7, 1, 3)
				tblPrice2.SetCellFgColor(7, 1, 3)
				tblPrice3.SetCellFgColor(7, 1, 3)
			end if
			
'			tblPrice0.SetCellString(0, 1, FormatNumber(hprc_debi,2))
'			tblPrice0.SetCellString(1, 1, FormatNumber(goga_debi,2))
'			tblPrice0.SetCellString(2, 1, FormatNumber(siga_debi,2))
'			tblPrice0.SetCellString(3, 1, FormatNumber(juga_debi,2))
'			tblPrice0.SetCellString(4, 1, FormatNumber(lprc_debi,2))
			tblPrice1.SetCellString(5, 1, FormatNumber(goga_debi,2))
			tblPrice1.SetCellString(3, 1, FormatNumber(siga_debi,2))
			tblPrice1.SetCellString(7, 1, FormatNumber(juga_debi,2))
	
			
'			tblPrice4.SetCellString(0, 1, FormatNumber(hprc_debi,2))
'			tblPrice4.SetCellString(1, 1, FormatNumber(goga_debi,2))
'			tblPrice4.SetCellString(2, 1, FormatNumber(siga_debi,2))
'			tblPrice4.SetCellString(3, 1, FormatNumber(juga_debi,2))
'			tblPrice4.SetCellString(4, 1, FormatNumber(lprc_debi,2))
			tblPrice2.SetCellString(5, 1, FormatNumber(goga_debi,2))
