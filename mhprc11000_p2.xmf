		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량				
		
		nTOTAL_BIDP_RSQN 		= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN" 		, 0 )
		nTOTAL_ASKP_RSQN 		= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN" 		, 0 )		
				
		hogaTbl.SetCellString( 20, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
		
		'환경설정에서 직전비수량 표시시
		If g_szDiplayrest = "1" Then
			Dim nTOTAL_BIDP_RSQN_ICDC	' 총매수잔량증감
			Dim nTOTAL_ASKP_RSQN_ICDC	' 총매도잔량증감
		
			nTOTAL_BIDP_RSQN_ICDC 	= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN_ICDC"	, 0 )
			nTOTAL_ASKP_RSQN_ICDC 	= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN_ICDC" , 0 )
			
			hogaTbl.SetCellString( 20, 0, nTOTAL_ASKP_RSQN_ICDC )
			hogaTbl.SetCellString( 20, 5, nTOTAL_BIDP_RSQN_ICDC )
		Else
			hogaTbl.SetCellString( 20, 0, "" )
			hogaTbl.SetCellString( 20, 5, "" )
			
		End If
	
	Elseif szTranID = "ohhts_stck_cntg" or szTranID = "ohhts_elw_cntg" or szTranID = "ohhts_frbr_cntg" then
	
		'=================================================================================
		'20170803 LES START - 시고저 등락률 추가
		'=================================================================================
		
		if szTranID = "ohhts_stck_cntg" then
			siga = DATAMANAGER.GetDataValue(1, "ohhts_stck_cntg", "OutBlock1", "RLTM_OPRC" , 0)
			goga = DATAMANAGER.GetDataValue(1, "ohhts_stck_cntg", "OutBlock1", "RLTM_HPRC" , 0)
			juga = DATAMANAGER.GetDataValue(1, "ohhts_stck_cntg", "OutBlock1", "RLTM_LPRC" , 0)
		
		else
			siga = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_OPRC" , 0) 
			goga = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_HPRC" , 0)
			juga = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_LPRC" , 0)
		
		end if
		
		'20230503 KKM START : 실시간 시고저 추가 		
		hogaTbl.startprice = siga
		hogaTbl.highprice	 = goga
		hogaTbl.lowprice	 = juga
		'20230503 KKM END		
		
		'20191107 HWG START : 시고저등락률 계산오류 수정
		if CInt(g_nSdpr) > 0 then
			goga_debi = (goga / sdpr * 100 ) - 100
			siga_debi = (siga / sdpr * 100 ) - 100
			juga_debi = (juga / sdpr * 100 ) - 100
			
			'고가
			if goga_debi < 0 then
'				goga_debi = goga_debi * -1
'				tblPrice0.SetCellFgColor(1, 1, 11) '11 : 파란색
'				tblPrice4.SetCellFgColor(1, 1, 11)
'				tblPrice5.SetCellFgColor(1, 1, 11)
				tblPrice1.SetCellFgColor(5, 1, 11)
				tblPrice2.SetCellFgColor(5, 1, 11)
				tblPrice3.SetCellFgColor(5, 1, 11)
				
			elseif goga_debi > 0 then
'				tblPrice0.SetCellFgColor(1, 1, 10) '10 : 빨간색
'				tblPrice4.SetCellFgColor(1, 1, 10)
'				tblPrice5.SetCellFgColor(1, 1, 10)
				tblPrice1.SetCellFgColor(5, 1, 10)
				tblPrice2.SetCellFgColor(5, 1, 10)
				tblPrice3.SetCellFgColor(5, 1, 10)
			else
'				tblPrice0.SetCellFgColor(1, 1, 3) ' 	0 : 검정색
'				tblPrice4.SetCellFgColor(1, 1, 3)
'				tblPrice5.SetCellFgColor(1, 1, 3)
				tblPrice1.SetCellFgColor(5, 1, 3)
				tblPrice2.SetCellFgColor(5, 1, 3)
				tblPrice3.SetCellFgColor(5, 1, 3)
			end if
			
			'시가
			if siga_debi < 0 then
'				siga_debi = siga_debi * -1
'				tblPrice0.SetCellFgColor(2, 1, 11)
'				tblPrice4.SetCellFgColor(2, 1, 11)
'				tblPrice5.SetCellFgColor(2, 1, 11)
				tblPrice1.SetCellFgColor(3, 1, 11)
				tblPrice2.SetCellFgColor(3, 1, 11)
				tblPrice3.SetCellFgColor(3, 1, 11)
				
			elseif siga_debi > 0 then
'				tblPrice0.SetCellFgColor(2, 1, 10)
'				tblPrice4.SetCellFgColor(2, 1, 10)
'				tblPrice5.SetCellFgColor(2, 1, 10)
				tblPrice1.SetCellFgColor(3, 1, 10)
				tblPrice2.SetCellFgColor(3, 1, 10)
				tblPrice3.SetCellFgColor(3, 1, 10)
			else
'				tblPrice0.SetCellFgColor(2, 1, 3) 
'				tblPrice4.SetCellFgColor(2, 1, 3)
'				tblPrice5.SetCellFgColor(2, 1, 3)
				tblPrice1.SetCellFgColor(3, 1, 3)
				tblPrice2.SetCellFgColor(3, 1, 3)
				tblPrice3.SetCellFgColor(3, 1, 3)
			end if
			
			'저가
			if juga_debi < 0 then
'				juga_debi = juga_debi * -1
'				tblPrice0.SetCellFgColor(3, 1, 11)
'				tblPrice4.SetCellFgColor(3, 1, 11)
'				tblPrice5.SetCellFgColor(3, 1, 11)
				tblPrice1.SetCellFgColor(7, 1, 11)
				tblPrice2.SetCellFgColor(7, 1, 11)
				tblPrice3.SetCellFgColor(7, 1, 11)
			elseif juga_debi > 0 then
'				tblPrice0.SetCellFgColor(3, 1, 10)
'				tblPrice4.SetCellFgColor(3, 1, 10)
'				tblPrice5.SetCellFgColor(3, 1, 10)
				tblPrice1.SetCellFgColor(7, 1, 10)
				tblPrice2.SetCellFgColor(7, 1, 10)
				tblPrice3.SetCellFgColor(7, 1, 10)
			else
'				tblPrice0.SetCellFgColor(3, 1, 3) 
'				tblPrice4.SetCellFgColor(3, 1, 3)
'				tblPrice5.SetCellFgColor(3, 1, 3)
				tblPrice1.SetCellFgColor(7, 1, 3)
				tblPrice2.SetCellFgColor(7, 1, 3)
				tblPrice3.SetCellFgColor(7, 1, 3)
			end if
			
			
'			tblPrice0.SetCellString(1, 1, FormatNumber(goga_debi,2))
'			tblPrice0.SetCellString(2, 1, FormatNumber(siga_debi,2))
'			tblPrice0.SetCellString(3, 1, FormatNumber(juga_debi,2))
'			
'			tblPrice4.SetCellString(1, 1, FormatNumber(goga_debi,2))
'			tblPrice4.SetCellString(2, 1, FormatNumber(siga_debi,2))
'			tblPrice4.SetCellString(3, 1, FormatNumber(juga_debi,2))
'			
'			tblPrice4.SetCellString(1, 1, FormatNumber(goga_debi,2))
'			tblPrice4.SetCellString(2, 1, FormatNumber(siga_debi,2))
'			tblPrice4.SetCellString(3, 1, FormatNumber(juga_debi,2))
			
			tblPrice1.SetCellString(5, 1, FormatNumber(goga_debi,2))
			tblPrice1.SetCellString(3, 1, FormatNumber(siga_debi,2))
			tblPrice1.SetCellString(7, 1, FormatNumber(juga_debi,2))
			
			tblPrice2.SetCellString(5, 1, FormatNumber(goga_debi,2))
			tblPrice2.SetCellString(3, 1, FormatNumber(siga_debi,2))
			tblPrice2.SetCellString(7, 1, FormatNumber(juga_debi,2))
			
			tblPrice3.SetCellString(5, 1, FormatNumber(goga_debi,2))
			tblPrice3.SetCellString(3, 1, FormatNumber(siga_debi,2))
			tblPrice3.SetCellString(7, 1, FormatNumber(juga_debi,2))			
		end if
		'20191107 HWG END
		
		'==============================================================================
		'20170803 LES END
		'==============================================================================	
		
		
	End If

End Sub


'============================================================================
Sub tblTime_OnClick(lRow , lColumn)
	If lRow = 0 and lColumn = 1 Then
		tblTime.visible = false
	End If
	
End Sub

'============================================================================
Sub hogaTbl_OnClick(lRow, lCol)
	If lRow = 20 and lCol = 2 Then
	
		tblTime.visible = true
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	If szTranID = "ohhts_1001_001r" Then
		Dim nSDPR , nOPRC, nHPRC, nLPRC
		
		nSDPR = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_SDPR" , 0 ) )	'기준가
		nOPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0 ) )	'시가
		nHPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0 ) )	'고가
		nLPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0 ) )	'저가
		
		If nSDPR < nHPRC Then '고가
'			tblPrice1.SetCellFgColor( 1, 1, "10" )
'			tblPrice2.SetCellFgColor( 1, 1, "10" )
'			tblPrice3.SetCellFgColor( 1, 1, "10" )
			tblPrice1.SetCellFgColor( 4, 1, "10" )
			tblPrice2.SetCellFgColor( 4, 1, "10" )
			tblPrice3.SetCellFgColor( 4, 1, "10" )			
		ElseIf nSDPR > nHPRC Then
'			tblPrice1.SetCellFgColor( 1, 1, "11" )
'			tblPrice2.SetCellFgColor( 1, 1, "11" )
'			tblPrice3.SetCellFgColor( 1, 1, "11" )
			tblPrice1.SetCellFgColor( 4, 1, "11" )
			tblPrice2.SetCellFgColor( 4, 1, "11" )
			tblPrice3.SetCellFgColor( 4, 1, "11" )			
		Else
'			tblPrice1.SetCellFgColor( 1, 1, "12" )
'			tblPrice2.SetCellFgColor( 1, 1, "12" )
'			tblPrice3.SetCellFgColor( 1, 1, "12" )
			tblPrice1.SetCellFgColor( 4, 1, "12" )
			tblPrice2.SetCellFgColor( 4, 1, "12" )
			tblPrice3.SetCellFgColor( 4, 1, "12" )
		End If
		
		If nSDPR < nOPRC Then  '시가
'			tblPrice1.SetCellFgColor( 2, 1, "10" )
'			tblPrice2.SetCellFgColor( 2, 1, "10" )
'			tblPrice3.SetCellFgColor( 2, 1, "10" )
			tblPrice1.SetCellFgColor( 2, 1, "10" )
			tblPrice2.SetCellFgColor( 2, 1, "10" )
			tblPrice3.SetCellFgColor( 2, 1, "10" )			
		ElseIf nSDPR > nOPRC Then
'			tblPrice1.SetCellFgColor( 2, 1, "11" )
'			tblPrice2.SetCellFgColor( 2, 1, "11" )
'			tblPrice3.SetCellFgColor( 2, 1, "11" )
			tblPrice1.SetCellFgColor( 2, 1, "11" )
			tblPrice2.SetCellFgColor( 2, 1, "11" )
			tblPrice3.SetCellFgColor( 2, 1, "11" )
		Else
'			tblPrice1.SetCellFgColor( 2, 1, "12" )
'			tblPrice2.SetCellFgColor( 2, 1, "12" )
'			tblPrice3.SetCellFgColor( 2, 1, "12" )
			tblPrice1.SetCellFgColor( 2, 1, "12" )
			tblPrice2.SetCellFgColor( 2, 1, "12" )
			tblPrice3.SetCellFgColor( 2, 1, "12" )			
		End If
		
		If nSDPR < nLPRC Then '저가
'			tblPrice1.SetCellFgColor( 3, 1, "10" )
'			tblPrice2.SetCellFgColor( 3, 1, "10" )
'			tblPrice3.SetCellFgColor( 3, 1, "10" )
			tblPrice1.SetCellFgColor( 6, 1, "10" )
			tblPrice2.SetCellFgColor( 6, 1, "10" )
			tblPrice3.SetCellFgColor( 6, 1, "10" )			
		ElseIf nSDPR > nLPRC Then
'			tblPrice1.SetCellFgColor( 3, 1, "11" )
'			tblPrice2.SetCellFgColor( 3, 1, "11" )
'			tblPrice3.SetCellFgColor( 3, 1, "11" )
			tblPrice1.SetCellFgColor( 6, 1, "11" )
			tblPrice2.SetCellFgColor( 6, 1, "11" )
			tblPrice3.SetCellFgColor( 6, 1, "11" )
		Else
'			tblPrice1.SetCellFgColor( 3, 1, "12" )
'			tblPrice2.SetCellFgColor( 3, 1, "12" )
'			tblPrice3.SetCellFgColor( 3, 1, "12" )
			tblPrice1.SetCellFgColor( 6, 1, "12" )
			tblPrice2.SetCellFgColor( 6, 1, "12" )
			tblPrice3.SetCellFgColor( 6, 1, "12" )
		End If
		
	
	End If
End Sub

