'============================================================================
Sub imgToggle4_OnClick()
	if g_bGrd_Chart_Toggle == "GRID" then
		g_bGrd_Chart_Toggle = "CHART"
		imgToggle4.imgpath = "icon_2navi2.png"
		grdCNTG.visible = false
		imggrdCnTGHeader.visible = false
		Label0.visible = false
		Grid0.visible = false
		ChartEx0.visible = true
		imgchart.visible = true
	else
		g_bGrd_Chart_Toggle = "GRID"
		imgToggle4.imgpath = "icon_2navi1.png"
		grdCNTG.visible = true
		imggrdCnTGHeader.visible = true
		Label0.visible = true
		Grid0.visible = true
		ChartEx0.visible = false
		imgchart.visible = false
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	If szTranID = "ohhts_stck_aspr" then
		Dim nCLS_CODE
		
		nCLS_CODE = DATAMANAGER.GetDataValue( 1, "ohhts_stck_aspr", "OutBlock1", "FIDR_HOUR_CLS_CODE" , 0 ) '시간구분코드 0 = 장중 그외는 예상( B 장전, C 9시이후, A 장후, D 시간외 )
		
		If g_szAplyCode = "2" Then
			If nCLS_CODE = "0" Then
			    
			    '20170804 LES START
'			    if g_tblPriceStyle == "1" then
'				    tblPrice1.visible = true
'				    tblPrice0.visible = false
'				else
'					tblPrice0.visible = true
'					tblPrice1.visible = false
'				end if
				
				tblPrice0.visible = true
				'imgToggle1.visible = true
			    
			    tblPrice2.visible = false
'			    tblPrice4.visible = false
'			    imgToggle2.visible = false
			    
			    tblPrice3.visible = false
'			    tblPrice5.visible = false
'			    imgToggle3.visible = false
			    '20170804 LES END
			    
		    else
		    
			    '20170804 LES START
			    tblPrice1.visible = false
'			    tblPrice0.visible = false
'			    imgToggle1.visible = false
			    
'			    if g_tblPriceStyle == "1" then
'				    tblPrice2.visible = true
'				    tblPrice4.visible = false
'				else
'					tblPrice4.visible = true
'					tblPrice2.visible = false
'				end if
				tblPrice2.visible = true
'			    imgToggle2.visible = true
			    
			    tblPrice3.visible = false
'			    tblPrice5.visible = false
'			    imgToggle3.visible = false
			    '20170804 LES END
			    
		    end if
		End If
	End If
	
	If szTranID = "ohhts_elw_cntg" then
		If g_szAplyCode = "2" Then	    
		    If Left( DATAMANAGER.GetDataValue( 1, "ohhts_stck_aspr", "OutBlock1", "FIDR_HOUR_CLS_CODE" , 0 ) , 1) = "0" Then
			    
			    '20170804 LES START
'			    if g_tblPriceStyle == "1" then
'				    tblPrice1.visible = true
'				    tblPrice0.visible = false
'				else
'					tblPrice0.visible = true
'					tblPrice1.visible = false
'				end if
				tblPrice1.visible = true
'			    imgToggle1.visible = true
			    
			    tblPrice2.visible = false
'			    tblPrice4.visible = false
'			    imgToggle2.visible = false
			    
			    tblPrice3.visible = false
'			    tblPrice5.visible = false
'			    imgToggle3.visible = false
			    '20170804 LES END
	
		    else
		    
			    '20170804 LES START
			    tblPrice1.visible = false
'			    tblPrice0.visible = false
'			    imgToggle1.visible = false
			    
'			    if g_tblPriceStyle == "1" then
'				    tblPrice2.visible = true
'				    tblPrice4.visible = false
'				else
'					tblPrice4.visible = true
'					tblPrice2.visible = false
'				end if
				tblPrice2.visible = true
'			    imgToggle2.visible = true
			    
			    tblPrice3.visible = false
'			    tblPrice5.visible = false
'			    imgToggle3.visible = false
			    '20170804 LES END
	
		    end if
		End If
	End If
	
    If szTranID ="ohhts_stck_stat" then
'	    Dim szAplyCode
	    g_szAplyCode = Trim( DATAMANAGER.GetDataValue( 1, "ohhts_stck_stat", "OutBlock1", "FIDR_APLY_CLS_CODE", 0 ) ) 	'1:발동 , 2:해제 
	   
	    If g_szAplyCode = "1" Then 
		    Dim szKindCode
		    
		    '20170804 LES START
		    tblPrice1.visible = false
'		    tblPrice0.visible = false
'		    imgToggle1.visible = false
		    
		    tblPrice2.visible = false
'		    tblPrice4.visible = false
'		    imgToggle2.visible = false
		    
'		    if g_tblPriceStyle == "1" then
'			    tblPrice3.visible = true
'			    tblPrice5.visible = false
'			else
'				tblPrice5.visible = true
'				tblPrice3.visible = false
'			end if
			tblPrice3.visible = true
'		    imgToggle3.visible = true
		    '20170804 LES END
		    
		    szKindCode = DATAMANAGER.GetDataValue( 1, "ohhts_stck_stat", "OutBlock1", "FIDR_KIND_CODE"  , 0 ) '1:정적VI 2:동적VI 3:정적+동적VI
		    
		    if szKindCode = "1" Then 
			    tblPrice3.SetCellString( 14, 1, "정적" )
'			    tblPrice3.SetCellString( 11, 1, "정적" )
'			    tblPrice5.SetCellString( 11, 1, "정적" )
			    
		    elseif szKindCode = "2" Then 
			    tblPrice3.SetCellString( 14, 1, "동적" )
'			    tblPrice3.SetCellString( 11, 1, "동적" )
'			    tblPrice5.SetCellString( 11, 1, "동적" )
			    
		    elseif szKindCode = "3" Then
			    tblPrice3.SetCellString( 14, 1, "정+동적" )
'			    tblPrice3.SetCellString( 11, 1, "정+동적" )
'			    tblPrice5.SetCellString( 11, 1, "정+동적" )
			    
		    End if 
		    
	    Else
	    
		    '20170804 LES START
		    tblPrice1.visible = false
'		    tblPrice0.visible = false
'		    imgToggle1.visible = false
		    
'		    if g_tblPriceStyle == "1" then
'			    tblPrice2.visible = true
'			    tblPrice4.visible = false
'		    else
'			    tblPrice4.visible = true
'			    tblPrice2.visible = false
'			end if
			tblPrice2.visible = true
'		    imgToggle2.visible = true
		    
		    tblPrice3.visible = false
'		    tblPrice5.visible = false
'		    imgToggle3.visible = false
		    '20170804 LES END
		    
	    End if
    
    End if
End Sub


