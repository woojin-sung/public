		'==============================================================================
	
	
	
	ElseIf szTranID = "ohhts_1001_004r" Then
		
		For i = 0 To grdCNTG.rowcount - 1
			Dim nData
			nData = CDbl( grdCNTG.GetCellData( "bd_cell2", i ) )
			
			If nData > 0 Then
				grdCNTG.SetCellFgColor( "bd_cell0", i, "10")
			ElseIf nData < 0 Then
				grdCNTG.SetCellFgColor( "bd_cell0", i, "11")
			Else
				grdCNTG.SetCellFgColor( "bd_cell0", i, "12")
			End If
		
		Next
	
	ElseIf szTranID = "ohhts_1001_005r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		hogaTbl.SetCellString( 20, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )

	
		'예상체결 Visible 여부
	    if Left( DATAMANAGER.GetDataValue( false, "ohhts_1001_005r", "OutBlock1", "FID_NW_MKOP_CLS_CODE", 0 ),1) = "0" OR 
	             DATAMANAGER.GetDataValue( false, "ohhts_1001_005r", "OutBlock1", "FID_NW_MKOP_CLS_CODE", 0 )    = "49" then
		    	
			'20180712 HAMWG START : K-OTC MTS 도입
		    If g_szItemMarket <> "T" Then
				'20170804 LES START
				tblPrice1.visible = false
				'tblPrice0.visible = false
				'imgToggle1.visible = false
				
				'if g_tblPriceStyle == "1" then
				'	tblPrice2.visible = true
				'	tblPrice4.visible = false
				'else
				'	tblPrice4.visible = true
				'	tblPrice2.visible = false
				'end if
				
				'imgToggle2.visible = true
				
				tblPrice2.visible = true
				tblPrice3.visible = false
				'tblPrice5.visible = false
				'imgToggle3.visible = false
								
				'20170804 LES END
			End If
			'20180712 HAMWG END
			
	    end if
	    
	    '20240503_01 HWG START : MTS ETF 고도화 대응
