		DATAMANAGER.RequestRealData("ohhts_stck_viex")
		
		DATAMANAGER.RequestTranData( "ohhts_1126_001r" )
		
	ElseIf szTranID = "ohhts_1126_001r" Then
		Dim szAplyCode, szKindCode
		
		g_szAplyCode = DATAMANAGER.GetDataValue( false , "ohhts_1126_001r", "OutBlock1", "FID_APLY_CLS_CODE" , 0 )'1:발동 , 2:해제 
		
	    If g_szAplyCode = "1" Then 	
		    
		    '20170804 LES START
		    tblPrice1.Visible = false
		    'tblPrice0.visible = false
		    'imgToggle1.visible = false
		    
		    tblPrice2.Visible = false
		    'tblPrice4.visible = false
		    'imgToggle2.visible = false
		    
'		    if g_tblPriceStyle == "1" then
'			    tblPrice3.Visible = True
'			    tblPrice5.visible = false
'			else
'				tblPrice5.visible = true
'				tblPrice3.visible = false
'			end if
			
		    tblPrice3.Visible = True
		    'imgToggle3.visible = true
		    '20170804 LES END

		    szKindCode = DATAMANAGER.GetDataValue( false, "ohhts_1126_001r", "OutBlock1", "FID_KIND_CODE" , 0 ) '1:정적VI 2:동적VI 3:정적+동적VI
		    
		    if szKindCode = "1" Then 
			    tblPrice3.SetCellString( 14, 1, "정적" )
			    'tblPrice3.SetCellString( 11, 1, "정적" )
			    'tblPrice5.SetCellString( 11, 1, "정적" )
			    
		    elseif szKindCode = "2" Then 
			    tblPrice3.SetCellString( 14, 1, "동적" )
			    tblPrice3.SetCellString( 11, 1, "동적" )
			    'tblPrice5.SetCellString( 11, 1, "동적" )
			    
		    elseif szKindCode = "3" Then
			    tblPrice3.SetCellString( 14, 1, "정+동적" )
			    'tblPrice3.SetCellString( 11, 1, "정+동적" )
			    'tblPrice5.SetCellString( 11, 1, "정+동적" )
			    
		    End if 
	    End if 
	   
		DATAMANAGER.RequestRealData( "ohhts_stck_stat" )		
		
	End If
	
End Sub

