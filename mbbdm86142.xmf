'v0005 해외 CFD_JPN 계좌 유형 안심 선택시 화면 디자인
'============================================================================
Sub Container0_contACFD_imgJPNSafe_OnClick()
	If g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "N" Then '미선택 -> 선택
		Container0.contACFD.imgJPNSafe.SetStatus("focus")	 
		Container0.contACFD.imgJPNSafeChk.imgpath = "checkmenu_o"
		g_BDM_OVRS_CFD_ACNT_APLT_YN8 = f_UserChkBold("contACFD", "JPNSafe", g_BDM_OVRS_CFD_ACNT_APLT_YN8)
	Else 
		Container0.contACFD.imgJPNSafe.SetStatus("normal")
		Container0.contACFD.imgJPNSafeChk.imgpath = "checkmenu_n"
		g_BDM_OVRS_CFD_ACNT_APLT_YN8 = f_UserChkBold("contACFD", "JPNSafe", g_BDM_OVRS_CFD_ACNT_APLT_YN8)
	End If	
	f_UserChk()
	Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN8" , g_BDM_OVRS_CFD_ACNT_APLT_YN8)	
	NextBtn_Enable()
	
	if g_BDM_PRCDCFD == "Y" and g_BDM_PRCD137 == "Y" then
		Container0.scroll_pos = 97
	end if
End Sub

Sub Container0_contACFD_imgJPNSafeChk_OnClick()
	Container0_contACFD_imgJPNSafe_OnClick()
End Sub
