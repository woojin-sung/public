		Container0.contACFD.imgCHNNorChk.imgpath = "checkmenu_n"
		Container0.contACFD.imgHKGNorChk.imgpath = "checkmenu_n"
		Container0.contACFD.imgJPNNorChk.imgpath = "checkmenu_n"
