'============================================================================
Function Chk_Data()
    
    'v0005 sta 콤보(v0002,v0004) > 컨테이너로 변경, 변수로 체크
    '국내CFD개설시
    If g_BDM_PRCDCFD == "Y" Then
        '-계좌유형
        If g_BDM_DMST_CFD_ACNT_APLT_YN1 <> "Y" and g_BDM_DMST_CFD_ACNT_APLT_YN2 <> "Y" Then
            Form.ShowAlert("오류", "국내 CFD 계좌 유형을 선택해주세요.")
            return False
        End If
	
        '임직원인 경우, 국내CFD 일반/안심 동시 선택 불가
        If g_BDM_DREM_YN == "Y" Then
		    If g_BDM_DMST_CFD_ACNT_APLT_YN1 == "Y" and g_BDM_DMST_CFD_ACNT_APLT_YN2 == "Y" Then
'                 Container0.scroll_pos = CInt(Form.calcUnResize(Container0.Combo1.top, "1"))
			   'Form.ShowAlert("오류", "임직원은 CFD 추가 개설이 불가능합니다.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 국가별 1개 유형만 개설 가능")
                 'Form.ShowAlert("오류", "임직원은 CFD 추가 개설이 불가능합니다.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 일반 유형은 국가별 1계좌만 가능") 'v0008
			   Form.ShowAlert("오류", "임직원 제한사항을 확인해주세요.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 일반 유형은 국가별 1계좌만 가능") 'v0008
			   return False
		    End If
        End If
    End If   

    '해외CFD개설시 
    If g_BDM_PRCD137 == "Y" Then
        '-계좌유형
        If g_BDM_OVRS_CFD_ACNT_APLT_YN1 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN3 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN5 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN7 <> "Y" and
		g_BDM_OVRS_CFD_ACNT_APLT_YN2 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 <> "Y" Then
            Form.ShowAlert("오류", "해외 CFD 거래희망 국가의 계좌 유형을 선택해주세요.")
            return False
        End If
	
	    '임직원인 경우, 해외CFD 국가별 일반/안심 동시 선택 불가
	    'v0008 해외CFD 일반/안심 동시개설 가능해짐에 따라 주석처리함.
        'If g_BDM_DREM_YN == "Y" Then
		'    If (g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "Y") or (g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "Y") or
		'     (g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "Y") or (g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "Y") Then
         '        Container0.scroll_pos = CInt(Form.calcUnResize(Container0.Combo1.top, "1"))
         '        Form.ShowAlert("오류", "임직원은 CFD 추가 개설이 불가능합니다.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 국가별 1개 유형만 개설 가능")
		'	   return False
		'    End If
        'End If
	End If
    'v0005 fin
    
    return True
End Function 
'============================================================================
Function NextBtn_Enable()
    '입력항목이 모두 펼쳐져있는 경우에만 버튼 활성화
    '연금저축 가입정보 입력 화면
    If g_BDM_PRCD131 == "Y" and g_bPnsnView Then
		Button0.enable = False
		If g_szTheme = "black" Then
			Button0.btnimage = "btn_27.9"
		Else 
			Button0.btnimage = "btn_21.9"
		End If
		Button0.fgcolor = "269"
	    
		If Container1.rdoType.currentindex ~= "0" and Container1.rdoType.currentindex ~= "1" Then
			Exit Function
		End If
		
		'계약기간 체크
		If Container1.edtPeriod.caption == "" or Container1.edtPeriod.caption == null or CInt(Container1.edtPeriod.caption) < 60 Then
			Exit Function
		End If
		
		'연금지급예정일 체크
		If Container1.edtStartDate.caption == "" or Container1.edtStartDate.caption == null Then
			Exit Function
		Else
			'빈값은 아니지만 유효값이 아닌경우
			if not g_bDateValid then
				Exit Function
			end if
		End If
		
		'계약금액 체크(신규계좌일시에만))
		If Container1.rdoType.currentindex == "0" Then
			If Container1.edtAmount.caption == "" or Container1.edtAmount.caption == null or CInt(Container1.edtAmount.caption) == 0 Then
				Exit Function
			Else
				'빈값은 아니지만 유효값이 아닌경우
				if not g_bAmountValid then
					Exit Function
				end if
			End If
		End If
		
		If g_bAcntVerified == false Then
			Exit Function
		End If
		
	'기본 계좌정보 입력 화면
	Else
	    
		'v0005 Combo2 콤보제거 > 요건에 맞추기 위해 컨테이너로 변경(컨테이너는 IOS에서 visible 여부를 못가져와 변수로 변경)
		'v0004 sta 국내CFD개설시, 국가
	    If g_BDM_PRCDCFD == "Y" Then
		    If g_BDM_DMST_CFD_ACNT_APLT_YN1 == "N" and g_BDM_DMST_CFD_ACNT_APLT_YN2 == "N" Then
				Button0.enable = False
				If g_szTheme = "black" Then
					Button0.btnimage = "btn_27.9"
				Else 
					Button0.btnimage = "btn_21.9"
				End If
				Button0.fgcolor = "269"
				
				Exit Function 
		    End If    
		End If
	    'v0004 fin 
	    
		'v0005 Combo3,Combo4 콤보제거 > 요건에 맞추기 위해 컨테이너로 변경(컨테이너는 IOS에서 visible 여부를 못가져와 변수로 변경)
		'v0002 sta 해외CFD개설시, 국가
	    If g_BDM_PRCD137 == "Y" Then
		    If g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "N" and
			g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "N" Then	
				Button0.enable = False
				If g_szTheme = "black" Then
					Button0.btnimage = "btn_27.9"
				Else 
					Button0.btnimage = "btn_21.9"
				End If
				Button0.fgcolor = "269"
				
				Exit Function 
		    End If    
		End If
	    'v0002 fin  
	End If
	
	'다음버튼 활성화
	Button0.enable = True
	Button0.btnimage = "btn_20.9"
	Button0.fgcolor = "273"

End Function

'============================================================================
'v0005 국내/해외 CFD 계좌 유형 선택시 폰트 볼드처리 설정
'============================================================================
Function f_UserChkBold(szCFDType,sztrgt, szChk) 
	'20230421 선택항목 볼드처리 제거
	if szChk == "N" Then '미선택 -> 선택
'		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt, "fontbold", true)
'		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt.."Sub", "fontbold", true)
		szChk = "Y"
	else 
'		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt, "fontbold", false)
'		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt.."Sub", "fontbold", false)
		szChk = "N"
	end if	
	return szChk
End Function

'============================================================================
'v0005 국내/해외 CFD 계좌 유형 체크 확인
'============================================================================
Function f_UserChk() 
	If g_BDM_PRCD137 == "Y" Then		
	
		'해외 CFD 계좌유형 일반/안심 각각모두 선택된 경우, 전체개설 자동체크
		'일반
		If g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "Y" Then
			Container0.contACFD.chkAllNor.chksilence = "1"
		Else
			Container0.contACFD.chkAllNor.chksilence = "0"	
		End If	
		'안심
		If g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "Y" Then
			Container0.contACFD.chkAllSafe.chksilence = "1"
		Else
			Container0.contACFD.chkAllSafe.chksilence = "0"	
		End If
		
		
		'20230421 국가 체크표시 사용안함(컨트롤 삭제는 안하고 일단 주석으로 처리)
		
		'해당 국가에 일반/안심 하나라도 개설시 국가 체크 표시
		'USA
'		If g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "Y" Then
'			Container0.contACFD.imgUSAChk.visible = true
'			Container0.contACFD.imgUSAChk.imgpath = "check_on.png"
'		Else
'			Container0.contACFD.imgUSAChk.visible = false
'		End If
'		'CHN
'		If g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "Y" Then
'			Container0.contACFD.imgCHNChk.visible = true
'			Container0.contACFD.imgCHNChk.imgpath = "check_on.png"
'		Else
'			Container0.contACFD.imgCHNChk.visible = false
'		End If	
'		'HKG
'		If g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "Y" Then
'			Container0.contACFD.imgHKGChk.visible = true
'			Container0.contACFD.imgHKGChk.imgpath = "check_on.png"
'		Else
'			Container0.contACFD.imgHKGChk.visible = false
'		End If	
'		'JPN
'		If g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "Y" Then
'			Container0.contACFD.imgJPNChk.visible = true
'			Container0.contACFD.imgJPNChk.imgpath = "check_on.png"
'		Else
'			Container0.contACFD.imgJPNChk.visible = false
'		End If
	End If	
End Function

Function f_SetFailScroll()
	
	if g_nErrorCnt == 1 then
		Container1.lblSpace.top = 430
	elseif g_nErrorCnt == 1 then
		Container1.lblSpace.top = 510
	elseif g_nErrorCnt == 2 then
		Container1.lblSpace.top = 530
	elseif g_nErrorCnt == 3 then
		Container1.lblSpace.top = 550
	end if
	
	Container1.SetScrollAutoSize()
End Function 


'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)
	
	'테스트용 연금저축 계좌확인스킵 체크
    g_nDev = Form.GetSharedData("&SERVER_MODE", False )
	
    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		Container0.setScrollBarVisible("2")
		Container1.setScrollBarVisible("2")
		
		Container1.edtPeriod.maxlength = 5
		Container1.edtAmount.maxlength = 9
	end if
	
	Container1.Label2.setNeighborCtlPos("imgPnsn", "right", 8, "")
	
    '다음버튼 비활성화
	Button0.enable = False
	If g_szTheme = "black" Then
		Button0.btnimage = "btn_27.9"
	Else 
		Button0.btnimage = "btn_21.9"
	End If
	Button0.fgcolor = "269"

	'파일설정
	'User_File_Set()
	
	'공유정보Get
	User_SharedData_Get()	
	
	'test
'	g_BDM_PRCDCFD = "Y"
'	g_BDM_PRCD137 = "Y"
'	g_BDM_PRCD131 = "Y"
	
	Container0.contCFD.visible = false
	Container0.contACFD.visible = false
	
	Container0.contACFD.lblACFDTitle.setNeighborCtlPos("imgACFDQuestion", "right", 8, "")
	Container0.contCFD.lblCFDTitle.setNeighborCtlPos("imgCFDQuestion", "right", 8, "")
	
	g_bDateValid = false
	g_bAmountValid = false
	
	'연금저축 개설 케이스일시
	If g_BDM_PRCD131 == "Y" Then
		SetPnsnDataSet()
	End If
	
	'CFD 영역 세팅
	if g_BDM_PRCDCFD == "Y" or g_BDM_PRCD137 == "Y" then
		if g_BDM_PRCDCFD == "Y" and g_BDM_PRCD137 == "Y" then
			Container0.contCFD.top = 5
			Container0.contACFD.top = 150
			
			'국내 / 해외 컨테이너 사이 구분선
			Container0.lblLine.visible = true
			
			Container0.contCFD.visible = true
			Container0.contACFD.visible = true
		else
			if g_BDM_PRCDCFD == "Y" then
				Container0.contCFD.top = 5
				
				Container0.contCFD.visible = true
				Container0.contACFD.visible = false
			else
				Container0.contACFD.top = 5
				
				Container0.contCFD.visible = false
				Container0.contACFD.visible = true
			end if
		end if
		
		Container0.SetScrollAutoSize()
	else
		'연금저축만 개설하는 경우
		if g_BDM_PRCD131 == "Y" then
			Container0.visible = false
			Container1.visible = true
		end if
	end if
	
	'연금저축 가입정보 추가
	Container1.edtPeriod.SetApplyLabel ("계약기간" ,1 , 267 , "left", false)
	Container1.edtStartDate.SetApplyLabel ("연금지급개시 예정일" ,1 , 267 , "left", false)
	Container1.edtAmount.SetApplyLabel ("계약금액(납입한도)" ,1 , 267 , "left", false)
	
	Container1.edtPeriod.SetUseResultLabel(True, 1)
	Container1.edtStartDate.SetUseResultLabel(True, 1)
	Container1.edtAmount.SetUseResultLabel(True, 1)

	Container1.btnCalendar.bringFront("1")
	Container1.imgBankSearch.bringFront("1")
	Container1.btnShowAcntList.bringFront("1")
	Container1.Button1.bringFront("1")
	
	'iOS만 처리
	If g_sz_OSType == "2" or g_sz_OSType == 2 Then
		Container1.edtAcnt.SetOnOffImage("alpha", "alpha")
	End If
	
	'연금저축 가입정보 항목들 개설구분 제외 처음엔 숨김
	Container1.edtPeriod.visible = false
	Container1.edtStartDate.visible = false
	Container1.edtAmount.visible = false
	Container1.imgAcntBg.visible = false
	Container1.lblAcntTitle.visible = false
	Container1.edtBank.visible = false
	Container1.imgBankSearch.visible = false
	Container1.edtAcnt.visible = false
	Container1.btnCalendar.visible = false
	Container1.chkSkip.visible = false
	Container1.Label3.visible = false
	
	'비대면계좌개설 이어가기 조회(CFD 체크 관련 조회)
	DATAMANAGER.RequestTranData( "obaci_acct_058r_1" )
	
	'v0005 sta
	Container0.contCFD.imgCFDNor.SetStatus("normal")
	Container0.contCFD.imgCFDSafe.SetStatus("normal")
	Container0.contACFD.imgUSANor.SetStatus("normal")
	Container0.contACFD.imgCHNNor.SetStatus("normal")	
	Container0.contACFD.imgHKGNor.SetStatus("normal")
	Container0.contACFD.imgJPNNor.SetStatus("normal")
	Container0.contACFD.imgUSASafe.SetStatus("normal")	
	Container0.contACFD.imgCHNSafe.SetStatus("normal")	
	Container0.contACFD.imgHKGSafe.SetStatus("normal")	
	Container0.contACFD.imgJPNSafe.SetStatus("normal")	

	g_BDM_DMST_CFD_ACNT_APLT_YN1	= "N"		'국내CFD 일반계좌 Y/N
	g_BDM_DMST_CFD_ACNT_APLT_YN2	= "N"		'국내CFD 안심계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN1	= "N"		'미국 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN2 	= "N"		'미국 안심계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN3 	= "N"		'중국 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN4 	= "N"		'중국 안심계좌 Y/N	
	g_BDM_OVRS_CFD_ACNT_APLT_YN5	= "N"		'홍콩 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN6 	= "N"		'홍콩 안심계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN7	= "N"		'일본 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN8	= "N"		'일본 안심계좌 Y/N
	'v0005 fin
End Sub

