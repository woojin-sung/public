			Container1.edtPeriod.caption = g_szTmpPeriod
			Container1.edtPeriod.SetFocus()
		else
			g_szTmpPeriod = Container1.edtPeriod.caption
		end if
	end if
	
	If Container1.edtPeriod.getLen(Container1.edtPeriod.caption) == 0 Then
	     'v0001 입력된정보가 모두 지워진 경우, 오입력플래그 초기화
		Container1.edtPeriod.SetResultLabel("0","complete","","Container1")
	End If
	
End Sub

