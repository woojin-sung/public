Sub Container1_edtAmount_OnEditChar(CharCode)
	if g_sz_OSType = "1" then
		if Cint(Container1.edtAmount.GetLen(Container1.edtAmount.Caption)) > 8 then
			Container1.edtAmount.caption = g_szTmpAmount
			Container1.edtAmount.SetFocus()
		else
			g_szTmpAmount = Container1.edtAmount.caption
		end if
	end if
	
	If Container1.edtAmount.getLen(Container1.edtAmount.caption) == 0 Then
	     'v0001 입력된정보가 모두 지워진 경우, 오입력플래그 초기화
		Container1.edtAmount.SetResultLabel("0","complete","","Container1")
	End If
End Sub

