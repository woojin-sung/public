'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'은행연합회 한도금액 조회
	If szTranID == "obaci_acct_089r" Then
		Set_Input_obaci_acct_089r()
	
	'비대면용 설정가능 계좌조회(CMA)
	ElseIf szTranID == "obaci_nmet_016r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_CLS_CODE"            , 0 , "1"	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"            , 0 , g_BDM_RCNO_PIP	)
	
	'타행수취인조회
	ElseIf szTranID == "obtss_elbs_129r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE"            , 0 , g_BDM_PNSN_PRVS_BANK_CODE	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOB_TRNO"            , 0 , "031"	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO"            , 0 , Container1.edtAcnt.caption	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_AMT"            , 0 , 1	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO"            , 0 , "XXXXXXXX"	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PROD_CLS_CODE"            , 0 , ""	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD"            , 0 , ""	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RMRK"            , 0 , ""	)
	
	'비대면계좌개설 이어가기 조회
	ElseIf szTranID == "obaci_acct_058r" Or szTranID == "obaci_acct_058r_1" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , g_BDM_RCNO_PIP      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , g_BDM_REG_UNIQ_NO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , "0"	)
	End If
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore에 변수가 너무 많이 들어가 사용자 함수로 생성
'============================================================================
Function Set_Input_obaci_acct_089r()
	'obaci_acct_089r 인풋 세팅
	If g_bTrTimer Then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "BSWR_PROS_CLS_CODE"          , 0 , 	"4"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "PRCD"          , 0 , 	"131"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO_PIP"          , 0 , 	g_BDM_RCNO_PIP	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_PRCD"          , 0 , 	"36"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "CUST_CLS_CODE"          , 0 , 	"1"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_TRPR_CLS_CODE"          , 0 , 	"0"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "LNKD_TLMS_MNNO"          , 0 , 	g_szLnkdTlmsMnno	)  
	Else
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "BSWR_PROS_CLS_CODE"          , 0 , 	"3"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "PRCD"          , 0 , 	"131"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO_PIP"          , 0 , 	g_BDM_RCNO_PIP	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_PRCD"          , 0 , 	"36"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "CUST_CLS_CODE"          , 0 , 	"1"	) 
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_TRPR_CLS_CODE"          , 0 , 	"0"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "LNKD_TLMS_MNNO"          , 0 , 	""	)  
	End If
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'다음버튼 활성화여부 확인
	NextBtn_Enable()
	
	'오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null Or Trim(strSubMsg) ~= "" Then
        strMsg = szErrMsg.."("..Trim(strSubMsg)..")"
    Else
        strMsg = szErrMsg
    End If
    
	If szTranID == "obaci_acct_089r" Then
		'은행연합회 한도조회 오류
	    Container1.edtAmount.hintcaption = "잔여한도 0원"
	    
	    Form.OpenPopup("mbbdm86142_p2", "", "")
	    
	    Form.ShowAlert("오류", strMsg )
	    
	ElseIf szTranID == "obtss_elbs_129r" Then
	    g_bAcntVerified = false
	    
	    g_BDM_PNSN_PRVS_BANK_ACNO = ""
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
		
		Form.ShowAlert("오류", strMsg )
		
	Else
		Form.ShowAlert("오류", strMsg )
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'은행연합회 한도금액 조회
	If szTranID == "obaci_acct_089r" Then
		If g_bTrTimer Then
			Dim szProsClsCode
			szProsClsCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)			'처리구분코드
			'최초 조회 후에 PROS_CLS_CODE 가 "2"로 나올때까지 타이머 이용하여 재호출
			If szProsClsCode == "2" Then
				Dim szUI_SVNG_LIMT_UNSD_AMT, szJOIN_LIMT_AMT
				szUI_SVNG_LIMT_UNSD_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT", 0)
				szJOIN_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "JOIN_LIMT_AMT", 0)
				
				g_nRemainLmt = CInt(szUI_SVNG_LIMT_UNSD_AMT)
				
				'연금저축 잔여한도 없을 시 안내창 노출
'				If CInt(szUI_SVNG_LIMT_UNSD_AMT) <= 0 Then
'					Form.OpenPopup("mbbdm86142_p2", "", "")
'					Exit Sub
'				Else
					Container1.edtAmount.hintcaption = "잔여한도 " .. FormatNumber(szUI_SVNG_LIMT_UNSD_AMT, 0) .. "원"
'				End If
				
				'비대면용 설정가능계좌 조회(CMA)
				DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			Else
				Form.SetTimerEvent2("5555", 1, 1.5)
			End If
		Else
			g_szLnkdTlmsMnno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LNKD_TLMS_MNNO", 0)		'연계전문번호
			g_bTrTimer = true
			
			DATAMANAGER.RequestTranData( szTranID )
		End If
	
	'비대면용 설정가능 계좌조회(CMA)
	ElseIf szTranID == "obaci_nmet_016r" Then
		If DATAMANAGER.IsMoreNextData(szTranID) Then
			DATAMANAGER.RequestNextData( szTranID )
			Exit Sub
		End If
		
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IQRY_CSNU", 0))
		
		g_nPnsnCmaCnt = nCnt
		
		Dim szAcno, szAsno, szPrcd
		'당사 CMA 계좌 보유시 기본세팅 메리츠증권
		If nCnt > 0 Then
'			cmbCMA.clear = "1"
			
			'연금지급기관
			g_BDM_PNSN_PRVS_BANK_CODE = "287"		'초기선택 메리츠
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
			
			Container1.edtBank.caption = "메리츠증권"
			Container1.edtBank.fgcolor = "4"
			
			For i = 0 to nCnt - 1
				szAcno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO", i) 
				szAsno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO", i) 
				szPrcd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRCD", i) 
				' "118":CMA 만 콤보에 추가
				If szPrcd == "118" Then
					cmbCMA.cbadddatatext = szAcno & szAsno & "`" & "[CMA]" & Left(szAcno, 4) & "-" & Right(szAcno, 4) & "-" & szAsno
				End If
			Next
			
'			cmbCMA.caption = ""
			
'			cmbCMA.openList()
		Else
			'연금지급기관
			g_BDM_PNSN_PRVS_BANK_CODE = ""		'초기선택 없음
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
			
'			'CMA 계좌 없을시 메시지 띄워주고 타사기관 선택 팝업 오픈
'			Form.MsgBox("안내", "당사 보유중인 CMA계좌가 없습니다.", "NO_CMA_ACNT", 6)
		End If
	
	'타행수취인조회
	ElseIf szTranID == "obtss_elbs_129r" Then
		'입력한 계좌 수취인명
		Dim szName, szStartName
		szName = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNM", 0) 
		
		'앞단계에서 입력받은 고객명
		szStartName = Form.GetSharedData("BDM_NAME", false)
		
		If szName <> szStartName Then
			g_BDM_PNSN_PRVS_BANK_ACNO = ""
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
			
			Form.ShowAlert("안내", "수취인이 일치하지 않습니다.")
			g_bAcntVerified = false
		Else
			Form.ShowAlert("안내", "계좌 수취인 확인 완료")
			g_bAcntVerified = true
		End If
		
		NextBtn_Enable()
	
	'비대면계좌개설 이어가기 조회
	ElseIf szTranID == "obaci_acct_058r" Then
		'실명확인번호 가져와서 날짜 계산
		Dim szRcno
		szRcno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_RCNO", 0) 
'		If szRcno <> "" and szRcno <> null Then
			'연금지급개시 예정일자 세팅
			'1.신청일자 기준 5년후
			Dim szDateOne
			Calendar0.caption = Form.GetSharedData("&HOST_DATE", false)
			szDateOne = Replace(DateAdd("m", 60, Calendar0.calyear & "-" & Calendar0.calmonth & "-" & Calendar0.calday), "-", "")
			
			'2.만 55세 생일 중 늦은 날짜로 세팅
			Dim szFront, szRear, szDateTwo, szYear
			szFront = Left(szRcno, 6)
			szRear = Right(szRcno, 1)
			
			'주민번호의 7번째 자리가 3, 4, 7, 8 중 하나이면 20 + YYMMDD
			'그 외 19 + YYMMDD
			'생년월일 구한 후 55년 더하기
			If szRear == "3" or szRear == "4" or szRear == "7" or szRear == "8" Then
				szDateTwo = "20" & szFront
			Else
				szDateTwo = "19" & szFront
			End If
			szYear = CInt(Left(szDateTwo, 4)) + 55		'55년후 계산
			szDateTwo = szYear & Right(szDateTwo, 4)		'계산된 년도 + 월 일
			
			'계산한 2가지 날짜중 더 늦는 날짜를 세팅
			If CInt(szDateOne) > CInt(szDateTwo) Then
				Calendar0.caption = szDateOne
'				Container1.edtStartDate.caption = szDateOne
			Else
				Calendar0.caption = szDateTwo
'				Container1.edtStartDate.caption = szDateTwo
			End If
			
			g_szBaseDate = Calendar0.caption
			
			g_BDM_PNSN_PRVS_BEGN_SCDL_DATE = Calendar0.caption
			Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
			
			g_bDateValid = true
			
			Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
'		End If
	
	'비대면계좌개설 이어가기 조회(CFD 체크 관련 조회)
	ElseIf szTranID == "obaci_acct_058r_1" then
		'CFD 체크관련 데이터
		g_szDremYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DREM_YN", 0) 
		g_szHldnYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_ACNT_HLDN_YN", 0) 
		g_szHldnYn840 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_ACNT_HLDN_YN840", 0) 
		g_szHldnYn156 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_ACNT_HLDN_YN156", 0) 
		g_szHldnYn344 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_ACNT_HLDN_YN344", 0) 
		g_szHldnYn392 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_ACNT_HLDN_YN392", 0) 
		
		'test
'		g_szDremYn = "Y"
'		g_szHldnYn840 = "Y"
		
'		Form.ShowAlert(szDremYn, szHldnYn .. " " .. szHldnYn840 .. " " .. szHldnYn156 .. " " .. szHldnYn344 .. " " .. szHldnYn392 )
		
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
    If sTimerID == "5555" Or sTimerID == 5555 Then
		Form.SetTimerEvent2(sTimerID, 0, 1.5)
		
		'재조회
		DATAMANAGER.RequestTranData("obaci_acct_089r")
	
	elseIf sTimerID == "10" Or sTimerID == 10 Then
		Form.SetTimerEvent2(sTimerID, 0, 0.5)
		
		Form.ShowAlert("안내", "계좌 수취인 확인 완료")
		g_bAcntVerified = true
	
		NextBtn_Enable()
    End If
End Sub

