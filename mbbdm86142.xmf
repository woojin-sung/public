Function Confirm_CFD_Get_Data()  'v0001
'	G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
	g_BDM_CFD_CtcnChkAll    = Form.GetSharedData("BDM_CFD_CtcnChkAll"      , false)  'CFD 전체약관
	g_BDM_CFD_CtcnChk1      = Form.GetSharedData("BDM_CFD_CtcnChk1"        , false)  '장외파생상품거래 기본계약서(위험고지 포함)
	g_BDM_CFD_CtcnChk2      = Form.GetSharedData("BDM_CFD_CtcnChk2"        , false)  '장외파생상품 담보계약서
	g_BDM_CFD_CtcnChk3      = Form.GetSharedData("BDM_CFD_CtcnChk3"        , false)  '장외파생상품 투자를 위한 전문투자자 대우 확인서
	g_BDM_CFD_CtcnChk4      = Form.GetSharedData("BDM_CFD_CtcnChk4"        , false)  '개인전문투자자에 대한 보호제도 미적용 확인서
	g_BDM_CFD_CtcnChk5      = Form.GetSharedData("BDM_CFD_CtcnChk5"        , false)  'v0003 금융거래 정보제공 동의서 약관 추가
End Function
