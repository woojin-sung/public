    g_BDM_CtcnChk1           = Form.GetSharedData("BDM_CtcnChk1"           , false)  '계좌개설/서비스기본약관
    g_BDM_CtcnChk2           = Form.GetSharedData("BDM_CtcnChk2"           , false)  '금융거래필수안내/위험고지 확인
    g_BDM_CtcnChk100         = Form.GetSharedData("BDM_CtcnChk100"         , false)  '종합매매계좌 주요약관/설명서
    g_BDM_CtcnChk118         = Form.GetSharedData("BDM_CtcnChk118"         , false)  'CMA계좌 주요약관/설명서
    g_BDM_CtcnChk101         = Form.GetSharedData("BDM_CtcnChk101"         , false)  '선물옵션계좌 주요약관/설명서
    g_BDM_CtcnChk135         = Form.GetSharedData("BDM_CtcnChk135"         , false)  '해외파생계좌 주요약관/설명서
    g_BDM_CtcnChkMndt        = Form.GetSharedData("BDM_CtcnChkMndt"        , false)  '개인(신용)정보 처리 필수 동의서
    g_BDM_CtcnChkSlct        = Form.GetSharedData("BDM_CtcnChkSlct"        , false)  '개인(신용)정보 처리 선택 동의서   
    g_BDM_CtcnChkCFD         = Form.GetSharedData("BDM_CtcnChkCFD"         , false)  'CFD계좌 주요약관/설명서
    'v0002 
    g_BDM_MISA_CtcnChk1 	= Form.GetSharedData("BDM_MISA_CtcnChk1"		, false)	'중개형ISA 주요약관/설명서
    g_BDM_ISA_ACNT_OPNG_CLCD	= Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"		, false)	'ISA계좌개설구분코드(1:신규/2:이수)
    g_BDM_137_CtcnChk1 	= Form.GetSharedData("BDM_137_CtcnChk1"		, false)	'v0003 해외CFD계좌 약관/거래설명서
    g_BDM_BNK_MNY_OPNG_YN 	= Form.GetSharedData("BDM_BNK_MNY_OPNG_YN"    , false)	'v0006 단기다수개설 여부 
End Function
