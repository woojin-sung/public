'============================================================================
'화면 진입시 연금저축 영역에 대한 데이터 세팅
'============================================================================
Function SetPnsnDataSet()
	Container1.SetScrollAutoSize()
	
	g_bAcntVerified = false
	g_bTrTimer = false
	
	if g_BDM_PRCDCFD == "Y" or g_BDM_PRCD137 == "Y" then
		g_bPnsnView = false
	else
		if g_BDM_PRCD131 == "Y" then
			g_bPnsnView = true
		end if
	end if
	
	g_bErrorFlag1 = false
	g_bErrorFlag2 = false
	g_bErrorFlag3 = false
	g_nErrorCnt = 0
	
	g_nPnsnCmaCnt = 0
	
	Container1.lblAcntTitle.fgcolor = "267"
	
	Container1.edtBank.fgcolor = "103"
	
	'연금지급기관, 계좌 초기화
	g_BDM_PNSN_PRVS_BANK_CODE = ""
'	g_BDM_PNSN_PRVS_BANK_CODE = "287"		'초기선택 메리츠
	g_BDM_PNSN_PRVS_BANK_ACNO = ""			'지급계좌번호
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
	
	'비대면계좌개설 이어가기 조회
	'조회 후 연금지급개시 예정일자 세팅
	DATAMANAGER.RequestTranData( "obaci_acct_058r" )
	
	'은행연합회 한도금액 조회
	DATAMANAGER.RequestTranData( "obaci_acct_089r" )
End Function 

'============================================================================
Sub Container1_rdoType_OnClick(nIndex)
	'아이폰용 예외처리
	If CInt(nIndex) == -1 Then
		Exit Sub
	End If
		
	'연금저축 개설구분
	'신규계좌 개설은 화면처리 전에 잔여한도 체크
	If nIndex == 0 Then
'		g_nRemainLmt = 0
		If CInt(g_nRemainLmt) <= 0 Then
			Form.OpenPopup("mbbdm86142_p2", "", "")
			Exit Sub
		End If
	End If
	
	Container1.edtPeriod.visible = true
	Container1.edtStartDate.visible = true
	
	Container1.imgAcntBg.visible = true
	Container1.lblAcntTitle.visible = true
	Container1.edtBank.visible = true
	Container1.imgBankSearch.visible = true
	Container1.edtAcnt.visible = true
	Container1.btnCalendar.visible = true
	Container1.Label3.visible = true
	
	If g_nDev == "1" Or g_nDev == 1 Then
		Container1.chkSkip.visible = true
	End If
	
	'입력값 및 에러문구 초기화
	Container1.edtAmount.SetResultLabel("0","complete","","Container1")
	Container1.edtPeriod.SetResultLabel("0","complete","","Container1")
	Container1.edtStartDate.SetResultLabel("0","complete","","Container1")
	
	g_nErrorCnt = 0
	
	g_BDM_PNSN_CNRC_AMT = ""
	Container1.edtAmount.caption = g_BDM_PNSN_CNRC_AMT
	Form.SetSharedData("BDM_PNSN_CNRC_AMT", g_BDM_PNSN_CNRC_AMT)
	
	Container1.edtPeriod.caption = ""
	Form.SetSharedData("BDM_PNSN_CNRC_PRD", "")
	
'	Calendar0.caption = g_BDM_PNSN_PRVS_BEGN_SCDL_DATE
'	Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
	Calendar0.caption = g_szBaseDate
	Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_szBaseDate)	
	Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
	
	Container1.Label3.visible = true
	Container1.edtAcnt.caption = ""
	g_BDM_PNSN_PRVS_BANK_ACNO = Container1.edtAcnt.caption
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
	g_bAcntVerified = false
	
	'금융기관 초기화 : 당사보유 CMA 계좌가 있으면 메리츠증권 아니면 미선택 처리
	If g_nPnsnCmaCnt > 0 Then
		g_BDM_PNSN_PRVS_BANK_CODE = "287"
		Container1.edtBank.caption = "메리츠증권"
		Container1.edtBank.fgcolor = "4"
	Else
		g_BDM_PNSN_PRVS_BANK_CODE = ""
		Container1.edtBank.caption = "금융기관"
		Container1.edtBank.fgcolor = "103"
	End If
	Container1.btnShowAcntList.visible = true
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
	
	'신규계좌
	If nIndex == 0 Then
		'계약금액은 신규계좌 선택시에만 보여줌
		Container1.edtAmount.visible = true
		Container1.edtAmount.caption = ""
		
		Container1.imgAcntBg.top = 390 '405
		Container1.lblAcntTitle.top = 400 '415
		Container1.edtBank.top = 422 '438
		Container1.imgBankSearch.top = 427 '442
		Container1.edtAcnt.top = 422 '438
		Container1.Label3.top = 422 '438
		Container1.btnShowAcntList.top = 422 '438
		Container1.Button1.top = 422 '438
		
		Container1.chkSkip.top = 390 '405
		
		g_BDM_PNSN_TCTR_CLS_CODE = "1"
		
		Container1.lblSpace.top = 435 '450
		
	'이수전용계좌
	ElseIf nIndex == 1 Then 
		'계약금액은 신규계좌 선택시에만 보여줌
		Container1.edtAmount.visible = false
		Container1.edtAmount.caption = ""
		
		Container1.imgAcntBg.top = 305 '320
		Container1.lblAcntTitle.top = 315 '330
		Container1.edtBank.top = 338 '353
		Container1.imgBankSearch.top = 342 '357
		Container1.edtAcnt.top = 338 '353
		Container1.Label3.top = 338 '353
		Container1.btnShowAcntList.top = 338 '353
		Container1.Button1.top = 338 '353
		
		Container1.chkSkip.top = 305 '320
		
		g_BDM_PNSN_TCTR_CLS_CODE = "2"
		
		Container1.lblSpace.top = 435 '450
	End If 
	
	'구분에 따른 안내팝업 오픈
	If nIndex == 0 Then
		Form.OpenPopup("mbbdm86142_p4", "1", "")
	ElseIf nIndex == 1 Then
		Form.OpenPopup("mbbdm86142_p4", "2", "")
	End If
	
	
	Form.SetSharedData("BDM_PNSN_TCTR_CLS_CODE", g_BDM_PNSN_TCTR_CLS_CODE)			'신규 / 이수전용계좌코드
	
	NextBtn_Enable()
	
	'입력영역으로 스크롤 조정
'	Dim nTop
'	nTop = CInt(Form.calcUnResize(Container1.lbl1.top, "1"))
'	Container1.scroll_pos = nTop
	
	Container1.SetScrollAutoSize()
End Sub

'============================================================================
'계약기간 입력
'============================================================================
Sub Container1_edtPeriod_OnEditComplete()

'	if g_sz_OSType = "1" then
'		Container1.edtPeriod.mask = "0,0,,개월,0,,0,1,1"		
'	end if
	
	Dim nPeriod
	nPeriod = CInt(Container1.edtPeriod.caption)
	'60개월 미만 입력시 
	If nPeriod < 60 Then
'		Container1.scroll_pos = CInt(Form.calcUnResize(Container1.edtPeriod.top, "1"))
		Container1.edtPeriod.SetResultLabel("1","error","계약기간은 60개월 이상으로 입력해주세요.","Container1")
		
		NextBtn_Enable()
		
		g_nErrorCnt = g_nErrorCnt + 1
		
		f_SetFailScroll()
		
		Exit Sub
	End If
	
	g_BDM_PNSN_CNRC_PRD = Container1.edtPeriod.caption
	Form.SetSharedData("BDM_PNSN_CNRC_PRD", g_BDM_PNSN_CNRC_PRD)
	
	Container1.edtPeriod.SetResultLabel("0","complete","","Container1")
	
'	Container1.scroll_pos = CInt(Form.calcUnResize(Container1.edtPeriod.top, "1"))
	
	if g_nErrorCnt > 0 then
		g_nErrorCnt = g_nErrorCnt - 1
	end if
	
	f_SetFailScroll()
	
	Container1.SetScrollAutoSize()
	
	NextBtn_Enable()
End Sub

'============================================================================
'계약금액 입력
'============================================================================
Sub Container1_edtAmount_OnEditComplete()

'	if g_sz_OSType = "1" then
'		Container1.edtAmount.mask = "0,0,,원,0,,0,1,1"
'	end if
	
	Dim nAmount
	nAmount = CInt(Container1.edtAmount.caption)
	'남은한도금액보다 계약금액이 크거나 입력금액이 0원일시
	If nAmount > g_nRemainLmt or nAmount == 0 Then
'		Container1.scroll_pos = CInt(Form.calcUnResize(Container1.edtAmount.top, "1"))

		If nAmount > g_nRemainLmt Then
			Container1.edtAmount.SetResultLabel("1","error","계약금액을 확인해주세요.(납입한도 초과)","Container1")
		ElseIf nAmount == 0 Then
			Container1.edtAmount.SetResultLabel("1","error","계약금액을 확인해주세요.(최소 계약금액 1원)","Container1")
		End If
		
		g_nErrorCnt = g_nErrorCnt + 1
		
		g_bAmountValid = false
		
		NextBtn_Enable()
		
		f_SetFailScroll()
		
		Exit Sub
	Else
		g_bAmountValid = true
		
		if g_nErrorCnt > 0 then
			g_nErrorCnt = g_nErrorCnt - 1
		end if
		
		Container1.edtAmount.SetResultLabel("0","","","Container1")
	End If
	
	g_BDM_PNSN_CNRC_AMT = Container1.edtAmount.caption
	Form.SetSharedData("BDM_PNSN_CNRC_AMT", g_BDM_PNSN_CNRC_AMT)
	
	f_SetFailScroll()
	
	Container1.SetScrollAutoSize()
	
	NextBtn_Enable()
End Sub


'============================================================================
'연금지급예정일 영역 터치시 달력 팝업
'============================================================================
Sub Container1_btnCalendar_OnClick()
	Calendar0.showcalendar = "1"
End Sub

'============================================================================
'연금지급예정일 변경 세팅
'============================================================================
Sub Calendar0_OnEditComplete()
	'자동세팅된 날짜 이전으로 선택시 예외처리
	If CInt(g_szBaseDate) > CInt(Calendar0.caption) Then
		Container1.edtStartDate.SetResultLabel("1","error","연금지급개시예정일 이후로 변경 가능합니다.","Container1")
		Calendar0.caption = g_szBaseDate
		
		g_bDateValid = false
		
		NextBtn_Enable()
		
		g_nErrorCnt = g_nErrorCnt + 1
		
		f_SetFailScroll()
		
		Exit Sub
	End If
	
	if g_nErrorCnt > 0 then
		g_nErrorCnt = g_nErrorCnt - 1
	end if
	
	Container1.edtStartDate.SetResultLabel("0","","","Container1")
	
	g_BDM_PNSN_PRVS_BEGN_SCDL_DATE = Calendar0.caption
	Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
	
	Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
	
	g_bDateValid = true
	
	f_SetFailScroll()
	
	Container1.SetScrollAutoSize()
	
	NextBtn_Enable()
End Sub

'============================================================================
'당사 CMA 계좌 선택팝업
'============================================================================
Sub Container1_btnShowAcntList_OnClick()
	If g_BDM_PNSN_PRVS_BANK_CODE <> "" Then
		If g_nPnsnCmaCnt > 0 Then
			cmbCMA.openList()
		Else
			'CMA 계좌 없을시 메시지 띄워주고 타사기관 선택 팝업 오픈
			Form.MsgBox("안내", "당사 보유중인 CMA계좌가 없습니다.", "NO_CMA_ACNT", 6)
		End If
	Else
		Form.MsgBox("안내", "금융기관을 선택해주세요.", "NO_CMA_ACNT", 6)
	End If

	'이 버튼을 누르는 시점에 CMA 계좌 조회
	'비대면용 설정가능계좌 조회(CMA)
'	DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
End Sub

'============================================================================
'연금지급계좌 당사CMA 계좌선택
'============================================================================
Sub cmbCMA_OnEditComplete(iIndex)
	Dim szAcnt
	szAcnt = cmbCMA.cbkeydata
	If szAcnt <> "" and szAcnt <> null Then
	
		Container1.Label3.visible = false
		
		g_BDM_PNSN_PRVS_BANK_ACNO = szAcnt
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
		Container1.edtAcnt.caption = Left(szAcnt, 4) & "-" & Mid(szAcnt, 5, 4) & "-" & Right(szAcnt, 2)
		
		g_bAcntVerified = true
	End If
	
	NextBtn_Enable()
End Sub

'============================================================================
'연금지급계좌 기관선택 팝업
'============================================================================
Sub Container1_imgBankSearch_OnClick()
	Form.OpenPopupAnimation("mbbdm86190_p1" , ""  ,"","2")
	Container1.edtAcnt.caption = ""
	Container1.Label3.visible = true
End Sub

'============================================================================
'연금지급계좌 입력
'============================================================================
Sub Container1_edtAcnt_OnEditComplete()
	'타사일경우만 수취인 조회 실행
	If g_BDM_PNSN_PRVS_BANK_CODE <> "287" Then
		g_BDM_PNSN_PRVS_BANK_ACNO = Container1.edtAcnt.caption
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
		
		If Container1.edtAcnt.caption == "" Then
			Container1.Label3.visible = true
			Exit Sub
		End If
		
		g_bAcntVerified = false
		'타행수취인조회
		If Container1.chkSkip.checkstate == "1" Then
			if Form.GetSharedData("&OS_TYPE", false) == "1" then
				Form.ShowAlert("안내", "계좌 수취인 확인 완료")
				g_bAcntVerified = true
			
				NextBtn_Enable()
			else
				Form.SetTimerEvent2(10, 1, 0.5)
			end if
		Else
			DATAMANAGER.RequestTranData( "obtss_elbs_129r" )
		End If
	Else
		g_bAcntVerified = true
	End If
	
	NextBtn_Enable()
End Sub

