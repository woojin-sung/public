Sub Container0_contCFD_imgCFDNor_OnClick()
	if g_BDM_DMST_CFD_ACNT_APLT_YN1 == "N" Then '미선택 -> 선택
		Container0.contCFD.imgCFDNor.SetStatus("focus")	
		Container0.contCFD.imgCFDNorChk.imgpath = "checkmenu_o"
		g_BDM_DMST_CFD_ACNT_APLT_YN1 = f_UserChkBold("contCFD", "CFDNor", g_BDM_DMST_CFD_ACNT_APLT_YN1)
	else 
		Container0.contCFD.imgCFDNor.SetStatus("normal")
		Container0.contCFD.imgCFDNorChk.imgpath = "checkmenu_n"
		g_BDM_DMST_CFD_ACNT_APLT_YN1 = f_UserChkBold("contCFD", "CFDNor", g_BDM_DMST_CFD_ACNT_APLT_YN1)
	end if	
	f_UserChk()
	Form.SetSharedData("BDM_DMST_CFD_ACNT_APLT_YN1" , g_BDM_DMST_CFD_ACNT_APLT_YN1)
	NextBtn_Enable()
End Sub

