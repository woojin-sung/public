Function User_SharedData_Get()
    '진입점에서 설정되는 정보 --------------------------------------------------
    g_BDM_FRST_MAPID         = Form.GetSharedData("BDM_FRST_MAPID"         , false)  '최초진입점화면ID
    g_BDMNMETBSWRGB          = Form.GetSharedData("BDM_NMETBSWRGB"         , false)  '비대면업무구분 : 100.비대면계좌개설    0xx.비대면업무신청 3xx.모바일OTP발급    999.비대면진행상태조회
    g_mOTP_IntoClcd          = Form.GetSharedData("mOTP_IntoClcd"          , false)  '(모바일OTP)진입구분코드 NMET_ACNT.계좌개설후처리, NMET_BSWR.업무처리, MTS.MTS
    g_BDM_CSNO               = Form.GetSharedData("BDM_CSNO"               , false)  '고객번호 :비대면업무신청/모바일OTP발급업무시 1원역이체 화면에서 사용
    g_BDM_REG_UNIQ_NO        = Form.GetSharedData("BDM_REG_UNIQ_NO"        , false)  '등록고유번호
    g_BDM_RCNO_PIP           = Form.GetSharedData("BDM_RCNO_PIP"           , false)  '실명확인번호
    g_BDM_HP1                = Form.GetSharedData("BDM_HP1"                , false)  '휴대폰번호
    g_BDM_HP2                = Form.GetSharedData("BDM_HP2"                , false)
    g_BDM_HP3                = Form.GetSharedData("BDM_HP3"                , false)
    g_BDM_CLEAR_YN           = Form.GetSharedData("BDM_CLEAR_YN"           , false)  '이어가기여부
    '2단계진입 설정정보 --------------------------------------------------------
    g_BDM_ABLE_YN            = Form.GetSharedData("BDM_ABLE_YN"            , false)  '개별추가가능여부
    g_BDM_OVRL_ACNT_OPNG_YN  = Form.GetSharedData("BDM_OVRL_ACNT_OPNG_YN"  , false)  '종합개설가능여부(최근30일내종합신규개설여부) Y.불가 N.가능
    g_BDM_DREM_YN            = Form.GetSharedData("BDM_DREM_YN"            , false)  'Y.임직원 N.고객
    g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"        , false)			'등록일련번호	'ksj 2021-07-23    
    g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)			'목표시장부적합여부'ksj 2021-07-23
    'v0002 sta
    g_BDM_ACFD_REG_SRNO		= Form.GetSharedData("BDM_ACFD_REG_SRNO"					, false)	'해외CFD목표시장등록일련번호	
    g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부	
    'v0002 fin
    
    'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
    g_BDM_PRCD100            = Form.GetSharedData("BDM_PRCD100"            , false)  '종합매매 가입여부
    g_BDM_PRCD118RP          = Form.GetSharedData("BDM_PRCD118RP"          , false)  'CMA(증권형) 가입여부
    g_BDM_PRCD100F           = Form.GetSharedData("BDM_PRCD100F"           , false)  '종합매매(금상전용) 가입여부
    g_BDM_PRCD101            = Form.GetSharedData("BDM_PRCD101"            , false)  '선물옵션 가입여부
    g_BDM_PRCD135            = Form.GetSharedData("BDM_PRCD135"            , false)  '해외파생 가입여부
    g_BDM_PRCD133            = Form.GetSharedData("BDM_PRCD133"            , false)  'ISA 가입여부
    g_BDM_PRCDCFD            = Form.GetSharedData("BDM_PRCDCFD"            , false)  'CFD 가입여부
    'v0002
    g_BDM_PRCD137			= Form.GetSharedData("BDM_PRCD137"			, false)	'해외CFD 가입여부
    g_BDM_ISA_PROD_TYPE	= Form.GetSharedData("BDM_ISA_PROD_TYPE"		, false)	'ISA type
    
    '연금저축, 랩 추가
    g_BDM_PRCD131			= Form.GetSharedData("BDM_PRCD131"		, false)	'연금저축 가입여부
    g_BDM_WRAP			= Form.GetSharedData("BDM_WRAP"			, false)	'랩 가입여부
    g_BDM_PRCD200			= Form.GetSharedData("BDM_PRCD200"		, false)	'다드림 가입여부
    
    'G_STEP2_2_FILE 설정정보 ---------------------------------------------------
    G_STEP2_2_FILE_Get_Data()  'v0002
    
    'G_STEP2_2_P2_FILE 설정정보 ------------------------------------------------
    g_BDM_MndtC              = Form.GetSharedData("BDM_MndtC"              , false)  '(공통)고유식별정보처리
    g_BDM_MndtD              = Form.GetSharedData("BDM_MndtD"              , false)  '(상품)조회
    g_BDM_MndtE              = Form.GetSharedData("BDM_MndtE"              , false)  '(상품)제공
    g_BDM_MndtE1             = Form.GetSharedData("BDM_MndtE1"             , false)  '(상품)신용정보조회및집중
    g_BDM_MndtE2             = Form.GetSharedData("BDM_MndtE2"             , false)  '(상품)해외증권/파생
    g_BDM_MndtF              = Form.GetSharedData("BDM_MndtF"              , false)  '(상품)민감정보
    'G_STEP2_2_P3_FILE 설정정보 ------------------------------------------------
    g_BDM_SlctG              = Form.GetSharedData("BDM_SlctG"              , false)  '(선택)수집이용
    g_BDM_SlctH              = Form.GetSharedData("BDM_SlctH"              , false)  '(선택)고유식별정보처리
    g_BDM_SlctTel            = Form.GetSharedData("BDM_SlctTel"            , false)  '홍보수신_전화
    g_BDM_SlctSMS            = Form.GetSharedData("BDM_SlctSMS"            , false)  '홍보수신_문자
    g_BDM_SlctEmail          = Form.GetSharedData("BDM_SlctEmail"          , false)  '홍보수신_이메일
    g_BDM_SlctPost           = Form.GetSharedData("BDM_SlctPost"           , false)  '홍보수신_우편
    'G_STEP2_3_FILE 설정정보 ---------------------------------------------------
    g_BDM_ACNT_OPNG_CLCD     = Form.GetSharedData("BDM_ACNT_OPNG_CLCD"     , false)  '개설구분
    'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 -----------------------------------
    g_BDM_MANG_BRCD          = Form.GetSharedData("BDM_MANG_BRCD"          , false)  '관리점
    g_BDM_DALY_TACT_AMT      = Form.GetSharedData("BDM_DALY_TACT_AMT"      , false)  '1일이체한도
    g_BDM_ONTR_TACT_AMT      = Form.GetSharedData("BDM_ONTR_TACT_AMT"      , false)  '1회인체한도
    g_BDM_MARG_GRAD_CODE     = Form.GetSharedData("BDM_MARG_GRAD_CODE"     , false)  '증거금등급
    g_BDM_ACNT_PWD           = Form.GetSharedData("BDM_ACNT_PWD"           , false)  '계좌비밀번호
    'v0002
    g_BDM_ACFD_CTCD          = Form.GetSharedData("BDM_ACFD_CTCD"           , false)  '해외CFD국가코드
    'v0005
    G_STEP2_4_5_FILE_Get_Data_v0005()  'v0005  
    
    '투자성향 정보 -------------------------------------------------------------
    g_BDM_KYC_GRAD           = Form.GetSharedData("BDM_KYC_GRAD"           , false)  '투자성향등급
    g_BDM_PROD_GRAD          = Form.GetSharedData("BDM_PROD_GRAD"          , false)  '상품등급
    g_BDM_UNFIT_YN           = Form.GetSharedData("BDM_UNFIT_YN"           , false)  '부적합여부
    g_BDM_DVPD_KYC_GRAD      = Form.GetSharedData("BDM_DVPD_KYC_GRAD"      , false)  '파생상품투자성향등급
    g_BDM_DVPD_PROD_GRAD     = Form.GetSharedData("BDM_DVPD_PROD_GRAD"     , false)  '파생상품상품등급
    g_BDM_DVPD_UNFIT_YN      = Form.GetSharedData("BDM_DVPD_UNFIT_YN"      , false)  '파생상품부적합여부
    g_BDM_WEAK_FNNC_YN       = Form.GetSharedData("BDM_WEAK_FNNC_YN"       , false)  '취약금융소비자여부
    g_BDM_KYC_INVT_RCMD_CLS_CODE   = Form.GetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , false)  'KYC투자권유구분코드
  'G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
	Confirm_CFD_Get_Data()

End Function
