'============================================================================
' 화 면 명 : 권리화면_권리유형
' 화면설명 : 권리화면의 권리유형선택 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szRghtCd, g_szGubun
g_szRghtCd = "%"
g_szGubun = "0" '국내

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()	
	if szData <> "" then
		tData = Split(szData, "★")
		g_szRghtCd = tData(0)	
		g_szGubun = tData(1)
		if g_szGubun == "1" then '해외
			if g_szRghtCd == "01" then      '01	유상
				RgStyle1.currentindex = 1
			elseif g_szRghtCd == "02" then  '02	 무상
				RgStyle1.currentindex = 2
			elseif g_szRghtCd == "03" then  '03	 배당(현금, 주식, 동시배당)
				RgStyle1.currentindex = 3
			elseif g_szRghtCd == "04" then  '04  합병
				RgStyle1.currentindex = 4
			elseif g_szRghtCd == "05" then  '05	감자
				RgStyle1.currentindex = 5
			elseif g_szRghtCd == "06" then  '06	액면분할
				RgStyle1.currentindex = 6
			elseif g_szRghtCd == "07" then  '07	액면병합 
				RgStyle1.currentindex = 7			
			elseif g_szRghtCd == "09" then  '08	코드변경
				RgStyle1.currentindex = 8
			elseif g_szRghtCd == "08" then  '09	회사분할
				RgStyle1.currentindex = 9
			else
				RgStyle1.currentindex = 0
			end if 
			RgStyle1.left = 20
			RgStyle.left = 402
			Label0.left = 500
		else '국내
			if g_szRghtCd == "01" then      '01	유상
				RgStyle.currentindex = 1
			elseif g_szRghtCd == "02" then  '02	 무상
				RgStyle.currentindex = 2
			elseif g_szRghtCd == "03" then  '03	 배당(현금, 주식, 동시배당)
				RgStyle.currentindex = 3
			elseif g_szRghtCd == "04" then  '04 매수청구
				RgStyle.currentindex = 4
			elseif g_szRghtCd == "17" then  '17	ETF분배금
				RgStyle.currentindex = 5
			elseif g_szRghtCd == "07" then  '07	합병
				RgStyle.currentindex = 6
			elseif g_szRghtCd == "08" then  '08	무상감자 
				RgStyle.currentindex = 7
			elseif g_szRghtCd == "09" then  '09	유상감자
				RgStyle.currentindex = 7			
			elseif g_szRghtCd == "10" then  '10	액면분할
				RgStyle.currentindex = 9
			elseif g_szRghtCd == "11" then  '11	액면병합
				RgStyle.currentindex = 10
			elseif g_szRghtCd == "12" then  '12	기업분할
				RgStyle.currentindex = 8
			elseif g_szRghtCd == "15" then  '15	주식교환
				RgStyle.currentindex = 11
			elseif g_szRghtCd == "16" then  '16	주식이전
				RgStyle.currentindex = 11
			else
				RgStyle.currentindex = 0
			end if 		
			RgStyle1.left = 402
			RgStyle.left = 20
		end if 
		
	else
		'디폴트 전체
		RgStyle.currentindex = 0
		RgStyle1.currentindex = 0
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("RIGHT_SET", g_szRghtCd)
End Sub

'============================================================================
Sub RgStyle1_OnClick(nIndex)
	if nIndex == 1 then      '01	유상
		g_szRghtCd = "01" 
	elseif nIndex == 2 then  '02	무상
		g_szRghtCd = "02" 	
	elseif nIndex == 3 then  '03	배당(현금, 주식, 동시배당)
		g_szRghtCd = "03" 	
	elseif nIndex == 4 then  '04    합병
		g_szRghtCd = "04" 	
	elseif nIndex == 5 then  '05	감자
		g_szRghtCd = "05" 	
	elseif nIndex == 6 then  '06	액면분할
		g_szRghtCd = "06" 	
	elseif nIndex ==  7 then  '07	액변병합
		g_szRghtCd = "07" 	
	elseif nIndex == 8 then   '08	코드변경
		g_szRghtCd = "09" 	
	elseif nIndex == 9 then  '09	회사분할
		g_szRghtCd = "08" 	
	else
		g_szRghtCd = "%" 	
	end if
End Sub


'============================================================================
Sub RgStyle_OnClick(nIndex)

	if nIndex == 1 then      '01	유상
		g_szRghtCd = "01" 
	elseif nIndex == 2 then  '02	 무상
		g_szRghtCd = "02" 	
	elseif nIndex == 3 then  '03	 배당(현금, 주식, 동시배당)
		g_szRghtCd = "03" 	
	elseif nIndex == 4 then  '04     매수청구
		g_szRghtCd = "04" 	
	elseif nIndex == 5 then  '17	ETF분배금
		g_szRghtCd = "17" 	
	elseif nIndex == 6 then  '07	합병
		g_szRghtCd = "07" 	
	elseif nIndex ==  7 then  '08	무상감자, 09	유상감자 
		g_szRghtCd = "08" 	
	elseif nIndex == 9 then   '10	액면분할
		g_szRghtCd = "10" 	
	elseif nIndex == 10 then  '11	액면병합
		g_szRghtCd = "11" 	
	elseif nIndex == 8 then  '12	기업분할
		g_szRghtCd = "12" 	
	elseif nIndex == 11 then  '15	주식교환, 16	주식이전
		g_szRghtCd = "15" 	
	else
		g_szRghtCd = "%" 	
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	'권리유형 선택 알림
	if g_szGubun == "1" then '해외
		Form.SendReturnToParent("RIGHT_SET1", g_szRghtCd)
	else
		Form.SendReturnToParent("RIGHT_SET", g_szRghtCd)
	end if 
	Form.CloseForm()	
End Sub

