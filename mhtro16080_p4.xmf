'--===========================================================================
Dim g_szFullAcnt
'--===========================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obrtd_fcur_001r" then
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ACNO" , 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ASNO" , 0 , mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "SVCD" , 0 , "001")
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szLinkedData
	
	szLinkedData = ""
	
	szLinkedData = Form.GetOpenLinkData()
	
	g_szFullAcnt = szLinkedData
	
	DATAMANAGER.RequestTranData("obrtd_fcur_001r")
	
	
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szDataCnt
	dim szCrcd, szCrcdKrNm, szExDealAmt
	
	szDataCnt = ""
	szCrcd =	""
	szCrcdKrNm = ""
	szExDealAmt = ""
	
	if	szTranID =	"obrtd_fcur_001r" then
		
		szDataCnt =	DATAMANAGER.GetDataCount(0, "obrtd_fcur_001r", "OutBlock1")
		
		
		for	i=0 to szDataCnt - 1
		
			szCrcd		 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD", i )
			szCrcdKrNm	 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD_KOR_NAME", i )
			'szExDealAmt	 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_FRCR_WTMN_ABLE_AMT", i ) v002 주석처리
			szExDealAmt	 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "ATMT_INVT_VLTN_ADUP_FRCR_AMT", i ) 'v002
			szExDealAmtMax =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_MAX_MNEC_ABLE_FRCR_AMT", i ) 'v001
						
			
			Grid0.SetCellData("bd_cell0", i, szCrcd & " " & szCrcdKrNm)
			Grid0.SetCellData("bd_cell1", i, szExDealAmt)
			Grid0.SetCellData("bd_cell2", i, szExDealAmtMax) 'v001
					
		next
		
	end if
End Sub


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	if Left(Grid0.GetCellData( "bd_cell0", lRow ), 3) = "KRW" then
		
		Form.ShowAlert("알림", "매도 할 외화를 선택해주십시오.")
		Exit Sub
	
	else
		
		Form.SetSharedData("G_bcpp_commonFrCd" 	   , Grid0.GetCellData( "bd_cell0", lRow )	)
		Form.SetSharedData("G_bcpp_commonFrBalc"    , Grid0.GetCellData( "bd_cell1", lRow )	)
		Form.SetSharedData("G_bcpp_commonFrBalcMax" , Grid0.GetCellData( "bd_cell2", lRow )	) 'v001
		
		Form.CloseForm()
	end if
End Sub


'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("16080_Frbalc" , "1")
End Sub

