'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_nCount
g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	
Dim	g_nOrd_Decimal		' 가격자릿수
Dim g_szPrcType			' 시장가or지정가
Dim	g_nOrd_Currency		' 통화기호
Dim g_szOrgnOrdGubun		' 원주문 매매구분코드
Dim g_szWarnMsg			' 경고메시지

Dim g_szLoanType			' 대출상세유형코드
Dim g_szLoanDate			' 대출일자
Dim g_szLoanSrno			' 대출일련번호

Dim g_OsType
Dim g_nTextSize

'============================================================================
Sub Form_OnFormInitBefore()

	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	g_nTextSize = Form.GetEnvData("common.textsize")

	'-----------------------------------------------------------
	' 컨트롤 설정
	'-----------------------------------------------------------
	Label3.paddinginfo = "0,0,0,0"
	Label0.paddinginfo = "0,0,0,0"
	lblMaesu1Title.paddinginfo = "0,0,0,0"
	lblMaesu1Title0.paddinginfo = "0,0,0,0"
	
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	imgInfo.setMaintainingRatio("1")
	
	'-----------------------------------------------------------
	' 공통(일반주문/현금&대출 정정주문 경고확인창)
	'-----------------------------------------------------------
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
	g_nOrd_Currency		= arrData(12)	' 통화
	
	g_szPrcType			= arrData(13)	' 시장가or지정가
	g_szLoanType 			= arrData(14)	' 대출상세유형코드
	g_szLoanDate 			= arrData(15)	' 대출일자
	g_szLoanSrno 			= arrData(16)	' 대출일련번호
	g_szOrgnOrdGubun 		= arrData(17)	' 원주문 매매구분
	g_szWarnMsg  			= arrData(18)	' 경고메시지
		
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Label0.caption = "정정 주문"
	Label0.bgcolor = "93"
	btnMaesu1.btnimage = "btn_etc17.9"
	btnMaesu1.caption="정정하기"
	
    Set_Data(g_nIndex)
    
End Sub

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    If g_nOrd_ChkAll = "1" Then
		g_nOrd_Price = "잔량"
    End If
    
    '===========================================================
    ' (공통) 경고메시지 설정
    '===========================================================
    lblMaesu1Title.caption = g_szWarnMsg
			
	'-----------------------------------------------------------
	' 큰글씨 모드에 따른 컨트롤 위치이동
	'-----------------------------------------------------------
    if CInt(g_nTextSize) > 0 then	'큰글씨
	    
	    imgInfo.left = 105
		
		if g_OsType == "1" then
			imgInfo.top = 547
		else
			imgInfo.top = 543
		end if
		
	else							'큰글씨 아님
		
		if g_OsType == "1" then
			imgInfo.top = 548
		end if
					
	end if
   
   
    '===========================================================
    ' 대출주문
    '===========================================================
	if g_szOrd_Security == "1" then
		     
		'-----------------------------------------------------------
		' 테이블 숨김처리
		'-----------------------------------------------------------
		tblMaesu1.visible = false 	'현금정정경고 테이블
		tblMaesu2.visible = true	'대출정정경고 테이블
			
		Image0.top = 321
		Image0.height = 255
			
		lblMaesu1Title0.top = 285
		lblMaesu1Title.top = 230
		Label0.top = 202
		Image1.top = 197
		Label3.top = 160
		
		imgMain.top = 137
		imgMain.height = 600
			
		'-----------------------------------------------------------
		' 대출정정 테이블 위치이동
		'-----------------------------------------------------------
		tblMaesu2.left = 30

		'-----------------------------------------------------------
		' 계좌번호/고객명
		'-----------------------------------------------------------
		szStr1 = left(g_szOrder_Acc,4)
		szStr2 = mid(g_szOrder_Acc,5,4)
		szStr3 = right(g_szOrder_Acc,2)
		tblMaesu2.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
			
		'-----------------------------------------------------------
		' 매매구분(g_szOrgnOrdGubun 1:매도 / 2:매수)
		'-----------------------------------------------------------
		if g_szOrgnOrdGubun == "1" or g_szOrgnOrdGubun == 1 then
			tblMaesu2.SetCellFgColor(1, 1, 291)
			tblMaesu2.SetCellString(1, 1, "매도")
		elseif g_szOrgnOrdGubun == "2" or g_szOrgnOrdGubun == 2 then
			tblMaesu2.SetCellFgColor(1, 1, 290)
			tblMaesu2.SetCellString(1, 1, "매수")
		end if
		
		'-----------------------------------------------------------
		' 대출구분/대출일자
		'-----------------------------------------------------------
		sLoanName = ""
		if g_szLoanType = "0251" then
			sLoanName = "예탁주식"
		end if
		
		sLoanDate = Left(g_szLoanDate,4) .. "." .. Mid(g_szLoanDate,5,2) .. "." .. Right(g_szLoanDate,2)
		
		tblMaesu2.SetCellString( 2, 1, sLoanName .. " | " .. sLoanDate)
			
		'-----------------------------------------------------------
		' 종목코드/종목명
		'-----------------------------------------------------------
		tblMaesu2.SetCellString( 3, 1, g_szOrd_ItmCode)
		
		'tblMaesu2.SetCellString( 3, 1, g_szOrd_ItmName)
		LabelItemName.top = 418
		if g_OsType == "1" then
			LabelItemName.paddinginfo = "0,2,10,0"
		else
			LabelItemName.paddinginfo = "0,0,8,0"
		end if
		
		LabelItemName.maxlinecnt = "2^-8"
		LabelItemName.caption = g_szOrd_ItmName
		
		'-----------------------------------------------------------
		' 주문구분
		'-----------------------------------------------------------
		tblMaesu2.SetCellString( 5, 1, g_szOrd_OrdType)
		
		'-----------------------------------------------------------
		' 수량
		'-----------------------------------------------------------
		tblMaesu2.SetCellString( 6, 1, g_nOrd_Qty)
		
		'-----------------------------------------------------------
		' 단가(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sMask = "0,0,,".. " "..g_nOrd_Currency ..",0,,"..g_nOrd_Decimal..",1,1,2,0"
		tblMaesu2.SetCellMaskInfo( 7, 1, sMask )
		tblMaesu2.SetCellString( 7, 1, g_nOrd_Price )	
		
		'-----------------------------------------------------------
		' 주문금액(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sTotalPrice = g_nOrd_Price * g_nOrd_Qty
		tblMaesu2.SetCellMaskInfo( 8, 1, sMask )
		tblMaesu2.SetCellString( 8, 1, sTotalPrice )	
			
	else
			
		'-----------------------------------------------------------
		' 테이블 숨김처리
		'-----------------------------------------------------------
		tblMaesu1.visible = true 	'현금정정 경고 테이블
		tblMaesu2.visible = false	'대출정정 경고 테이블
			
		'-----------------------------------------------------------
		' 계좌번호/고객명
		'-----------------------------------------------------------
		szStr1 = left(g_szOrder_Acc,4)
		szStr2 = mid(g_szOrder_Acc,5,4)
		szStr3 = right(g_szOrder_Acc,2)
		tblMaesu1.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
		
		'-----------------------------------------------------------
		' 매매구분(g_szOrgnOrdGubun 1:매도 / 2:매수)
		'-----------------------------------------------------------
		if g_szOrgnOrdGubun == "1" or g_szOrgnOrdGubun == 1 then
			tblMaesu1.SetCellFgColor(1, 1, 291)
			tblMaesu1.SetCellString(1, 1, "매도")
		elseif g_szOrgnOrdGubun == "2" or g_szOrgnOrdGubun == 2 then
			tblMaesu1.SetCellFgColor(1, 1, 290)
			tblMaesu1.SetCellString(1, 1, "매수")
		end if
		
		'-----------------------------------------------------------
		' 종목코드/종목명
		'-----------------------------------------------------------
		tblMaesu1.SetCellString( 2, 1, g_szOrd_ItmCode)
		
		'tblMaesu1.SetCellString( 3, 1, g_szOrd_ItmName)
		if g_OsType == "1" then
			LabelItemName.paddinginfo = "0,2,10,0"
		else
			LabelItemName.paddinginfo = "0,0,8,0"
		end if
		
		LabelItemName.maxlinecnt = "2^-8"
		LabelItemName.caption = g_szOrd_ItmName
		
		'-----------------------------------------------------------
		' 주문구분
		'-----------------------------------------------------------
		tblMaesu1.SetCellString( 4, 1, g_szOrd_OrdType)
		
		'-----------------------------------------------------------
		' 수량
		'-----------------------------------------------------------
		tblMaesu1.SetCellString( 5, 1, g_nOrd_Qty)
		
		'-----------------------------------------------------------
		' 단가(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sMask = "0,0,,".. " "..g_nOrd_Currency ..",0,,"..g_nOrd_Decimal..",1,1,2,0"
		tblMaesu1.SetCellMaskInfo( 6, 1, sMask )
		tblMaesu1.SetCellString( 6, 1, g_nOrd_Price )	
		
		'-----------------------------------------------------------
		' 주문금액(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sTotalPrice = g_nOrd_Price * g_nOrd_Qty
		tblMaesu1.SetCellMaskInfo( 7, 1, sMask )
		tblMaesu1.SetCellString( 7, 1, sTotalPrice )	
	    
    end if
	    

End Function

'============================================================================
Function SendOrder()
    
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
	    
    End If
    
End Function
'============================================================================
Sub btnMaesu1Close_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub btnMaesu1_OnClick()
	SendOrder()
End Sub
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub imgInfo_OnClick()
	sText = "수수료 및 세금이 제외된 금액입니다.\n체결 후 매매일지 화면에서 수수료 및 세금을 확인 할 수 있어요."
	imgInfo.openToolTip(sText, 300, 80, 0)
End Sub

	</SCRIPT_INFO>
</ROOT>