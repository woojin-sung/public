'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim disp, dec

	disp = Form.GetItemCodeInfo( g_tActiveCode[gCurInd], "dispscale" )
	dec = Form.GetItemCodeInfo( g_tActiveCode[gCurInd], "dispdecimal" )
	ChartEx0.SetScaleInfo(disp..";"..dec) '차트 스케일 세팅
	
	' 현재 선택 입력 받은 종목의 RealData 요청
	g_flagInit  = false
End Sub

'****************************************************************************
' Chart          
'****************************************************************************


'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
	' 차트 설정창에서 주기 값 넘어온 경우
	' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i ) '분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i ) '분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function 

 '============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	 sMinArr = {}
	 sTicArr = {}
	 sDataArr = {}
	 
	 g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   'Form.Log("sPeriodType",sPeriodType)
	   for i = 0 to 7 step 1
			Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )
	   next
	   
   end if
end function

'============================================================================
'멀티 차트의 분할된 차트 선택시 처리 
'============================================================================
function ChartEx0_OnSelectedChart(nIndex, sData)
	gCurInd = nIndex -1
	
     if sData == "" then        '비어있는 영역 선택시
'	     g_tLinkItemCode[gCurInd] = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)
'	     gMulCode[gCurInd] = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)
'	     g_szItemCode = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)
	     gMulCode[gCurInd] = ""
	     
	     Exit function
     end if
	
     Data = split(sData, ";")
     if Cstr(Trim(Data[0])) = "" or Cstr(Trim(Data[0])) = null then
	     gMulCode[gCurInd] = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)	' 종목코드        
     else
	     gMulCode[gCurInd] = Cstr(Trim(Data[0]))
     end if
     
     sName           = Cstr(Trim(Data[1]))
     g_sPeriodType   = Cstr(Trim(Data[2]))
     g_sPeriod       = Cstr(Trim(Data[3]))
     sPrice          = Cstr(Trim(Data[4]))
     sSign           = Cstr(Trim(Data[5]))
     sChange         = Cstr(Trim(Data[6]))
     sRate           = Cstr(Trim(Data[7]))
     sVolume         = Cstr(Trim(Data[8]))
     sRealKey        = Cstr(Trim(Data[9]))
     sMarket         = Cstr(Trim(Data[10]))
     
     if InStr(gMulCode[gCurInd] , "." ) = 0 then
		g_tLinkItemCode[gCurInd] = gMulCode[gCurInd]
	end if
     
     if f_FindMarket(gMulCode[gCurInd]) <> "F" then
	     BtnLink.enable = false
     else
	     BtnLink.enable = true
     end if
     
     if g_tChartLinkData[gCurInd] = "" then
	     g_tChartLinkData[gCurInd] = BtnLink.caption
     end if
     BtnLink.caption = g_tChartLinkData[gCurInd]
	
	if InStr(gMulCode[gCurInd] , "." ) = 0 then
		BtnLink.caption = "개별"
	else
		BtnLink.caption = "연결"
	end if
	
	if g_sPeriodType = "0" then
		if g_tChartLinkData[gCurInd] <> "" then
			BtnLink.caption = g_tChartLinkData[gCurInd]
		end if
	end if
	
'	if gMulCode[gCurInd] <> Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0) then
'		Form.SetItemCode(gMulCode[gCurInd])
'	end if
	
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			g_sPeriod = g_szTicType
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			g_sPeriod = g_szMinType
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType == "3" then
			g_TempIndex = 1
			'g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )	'PENTA13 START => 2023.08.17(차트성능개선)
			
		else
			g_TempIndex = 1
			'g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )	'PENTA13 START => 2023.08.17(차트성능개선)
		
		end if
	end if
	
     ChartEx0.SetPeriodType(g_sPeriodType)
     ChartEx0.SetPeriodTime(g_sPeriod)
	
	g_bTranFlag = false
	RadioGroup0.currentindex = g_TempIndex
	g_bTranFlag = true

	Dim codeTemp, zItemCode
	
	if g_tChartLinkData[gCurInd] = "연결" and f_FindMarket(gMulCode[gCurInd]) = "F" then
		if gMulCode[gCurInd] <> g_szItemCode then
			Form.triggerEvent("linkfmHoga", "ITEMCODE", g_tActiveCode[gCurInd])
			Form.SetItemCode(g_tActiveCode[gCurInd])
		end if
		
		g_szItemCode = gMulCode[gCurInd]
		
	else
		if InStr(gMulCode[gCurInd] , "." ) <> 0 then
			codeTemp = split(gMulCode[gCurInd], ".")
			zItemCode = codeTemp[0]
		
			zItemCode = Form.GetFirstMonth(zItemCode)
			gMulCode[gCurInd] = Form.GetActiveMonth(zItemCode)
			
		end if
		
		if gMulCode[gCurInd] <> g_szItemCode then
			Form.triggerEvent("linkfmHoga", "ITEMCODE", gMulCode[gCurInd])
			Form.SetItemCode(gMulCode[gCurInd])
			
		end if
		
		g_szItemCode = gMulCode[gCurInd]
	end if

end function

'============================================================================
'Chart 불러오기
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	nIndex = CInt(nIndex)
	gCurInd = nIndex
	
	Data = split(sData, ";")
	
	gMulCode[gCurInd]	= Cstr(Trim(Data[0]))             '코드
	g_sPeriodType  	= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod      	= Cstr(Trim(Data[2]))             '주기(분/틱- 1,5,...)
	sRefresh       	= Cstr(Trim(Data[3]))             '초기화(1.0)
	
'	if InStr(gMulCode[gCurInd] , "." ) <> 0 then
'		codeTemp = split(zItemCode, ".")
'		zItemCode = codeTemp[0]
'		
'		zItemCode = Form.GetFirstMonth(zItemCode)
'		g_tActiveCode[gCurInd] = Form.GetActiveMonth(zItemCode)
'	end if
	
	if sMarket = "S31" then
'		Form.ShowAlert("알림", g_TempIndex..">>>"..g_flagWeek..">>>>"..g_szChrtType)

		if g_szChrtType = "D" then '일
			g_sPeriodType = "2"
			g_sPeriod = "1"
			
		elseif g_szChrtType = "W" then '주
			g_sPeriodType = "3"
			g_sPeriod = "1"
			
		elseif g_szChrtType = "M" then '월
			g_sPeriodType = "4"
			g_sPeriod = "1"
			
		elseif g_szChrtType = "A" then '분
			g_sPeriodType = "1"
'			g_sPeriod = "1" '분 값 셋팅을 짜주세요

		elseif g_szChrtType = "T" then '틱
			g_sPeriodType = "0"
'			g_sPeriod = "1" '틱 값 셋팅을 짜주세요 

		end if	
	end if
	
	' 차트 초기화 이벤트
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		g_TempIndex = 0
		g_szChrtType =  "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )

	else
		
		if g_sPeriodType = "0" then 
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		elseif g_sPeriodType = "1" then
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szTicType = g_sPeriod
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
		
		else
			g_sPeriod = "1"
			if g_sPeriodType = "2" then
				g_TempIndex = 0
				g_szChrtType = "D"
				
			elseif g_sPeriodType = "3" then
				g_TempIndex = 1
				'g_flagWeek = false
				g_szChrtType = "W"
				RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
				
			else
				g_TempIndex = 1
				'g_flagWeek = false
				g_szChrtType = "M"
				RadioGroup0.SetRadioCaption( g_TempIndex, "월" )

			end if
		end if
	
	end if
	
	if InStr(gMulCode[gCurInd] , "." ) = 0 then
		g_tLinkItemCode[gCurInd] = gMulCode[gCurInd]
	end if
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	g_bTranFlag = false
	RadioGroup0.currentindex = g_TempIndex
	g_bTranFlag = true
	
	f_ChangeCode()
	RequestData()

end function

