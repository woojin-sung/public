'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_6509_001r" then
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf" ) '차트 실시간 조회
	elseif szTranID = "ohhts_6509_001r_1" then
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_1" ) '차트 실시간 조회
	elseif szTranID = "ohhts_6509_001r_2" then
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_2" ) '차트 실시간 조회
	elseif szTranID = "ohhts_6509_001r_3"then '차트 조회
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_3" ) '차트 실시간 조회
	end if
	
	g_flagInit = false

End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_ovdv_cntf" then '차트 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf", "InBlock1", "FID_OVDV_ISCD" , 0 , g_tActiveCode[0] ) '종목코드
	elseif szTranID = "ohhts_ovdv_cntf_1" then '차트 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_1", "InBlock1", "FID_OVDV_ISCD" , 0 , g_tActiveCode[1] ) '종목코드
	elseif szTranID = "ohhts_ovdv_cntf_2" then '차트 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_2", "InBlock1", "FID_OVDV_ISCD" , 0 ,g_tActiveCode[2] ) '종목코드
	elseif szTranID = "ohhts_ovdv_cntf_3" then '차트 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_3", "InBlock1", "FID_OVDV_ISCD" , 0 , g_tActiveCode[3] ) '종목코드
	end if
	
End Sub

'============================================================================
Sub BtnLink_OnClick()
	if BtnLink.caption = "개별" then
		BtnLink.caption = "연결"
		
	elseif BtnLink.caption = "연결" then
		BtnLink.caption = "개별"
		
	end if

	g_tChartLinkData[gCurInd] = BtnLink.caption
	
	f_ChangeCode()
	RequestData()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		elseif sParam = "OPEN_PRICE" then
			Form.OpenScreen("43100" , gMulCode[gCurInd])
		End If
	
	elseif sEventName = "REG_INTR" then
		if g_szItemCode <> "" or g_szItemCode <> null then
			Form.OpenPopup( "mhtrd43110_p4" , g_szItemCode, "" )
		end if
		
	elseif sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
	
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "16" , "")
	'20220922 SWJ END	
	
	End If
End Sub

'============================================================================
Sub ChartEx0_OnScrollEnd()
	szTranID = ""
	
	if gCurInd = 0 then
		szTranID = "ohhts_6509_001r"
	else
		szTranID = "ohhts_6509_001r_"..Cstr(gCurInd)
	end if
	
	DATAMANAGER.RequestNextData(szTranID)
End Sub


'============================================================================
'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub

