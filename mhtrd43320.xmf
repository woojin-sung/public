'화면 Open 시 차트 설정 및 Setting
function setChart()
	' 차트 값 불러오기
	szValue = Form.GetEnvData( "multichart_setting" )
	szValueMinTick = Form.GetEnvData( "multichart_settingmintick" ) 
	
    if szValue = "" then
		 Form.SetEnvData( "multichart_settingmintick", "2^001" )
	     g_sPeriod 	 = "001"
	     g_sPeriodType = "2"
	     
	else
		temp = split(szValue, "^")
		
	     g_sPeriodType = temp[0]
	     g_sPeriod 	 = temp[1]
	     
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")
		g_szMinType = temp1[0]
		g_szTicType = temp1[1]
		
	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "chart_min0" )
		szTic0 = Form.GetEnvData( "chart_tic0" )
	
		if szMin0 <> "" and szMin0 <> 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			g_szTicType = szTic0
		else 
			g_szTicType = "1"
		end if
		' 20190404 HWG END  
	     
	end if
	
	'분틱 세팅
	if g_sPeriodType = "0" or g_sPeriodType = "1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )

		end if
	
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"		'PENTA13 START => 2023.08.11(차트성능개선)
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		end if
	end if
	
	RadioGroup0.currentindex = g_TempIndex
	
end function

'============================================================================
Function RequestData()
	if g_bTranflag = false or g_szItemCode = "" or g_szItemCode = null then
		Exit Function 
	end if
	
	if gCurInd = 0 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf" )
	elseif gCurInd = 1 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_1" )
	elseif gCurInd = 2 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_2" )
	elseif gCurInd = 3 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_3" )
	end if

	Dim szChrtType	'주기타입
	Dim szJoogiType	'N
	
	if g_szChrtType = "T" then		'틱
		szChrtType = "0"
		sTic = Split(g_szTicType, "틱", -1, 1)
		szJoogiType = sTic[0]
		
	elseif g_szChrtType = "A" then	'분
		szChrtType = "1"
		sMin = Split(g_szMinType, "분", -1, 1)
		szJoogiType = sMin[0]
		
	else 						'D/W/M/Y 일/주/월/년
		if g_szChrtType = "D" then
			szChrtType = "2"
			
		elseif g_szChrtType = "W" then
			szChrtType = "3"
			
		elseif g_szChrtType = "M" then
			szChrtType = "4"
			
		end if
		
		szJoogiType = "1"
	end if
	
	if gCurInd = 0  then
		szTranID = "ohhts_6509_001r"
	else
		szTranID = "ohhts_6509_001r_"..Cstr(gCurInd)
	end if
	
	Dim szItemCode, szExchName, szToday, szActiveCode
	
'	szItemCode = gMulCode[gCurInd]
	
'	if g_tChartLinkData[gCurInd] = "연결" and f_FindMarket(szItemCode) = "F" then
'		g_tActiveCode[gCurInd] = Form.GetActiveMonth(szItemCode)
'		szItemCode = Form.GetItemCodeInfo( gMulCode[gCurInd] , "commodity" ) & ".1"
'		ChartEx0.SetContiueFuture("1;" & g_tActiveCode[gCurInd])
'		
'		if gMulCode[gCurInd] <> g_tLinkItemCode[gCurInd] then
'			Form.SetItemCode(szActiveCode)
'			Form.triggerEvent("linkfmHoga", "ITEMCODE", g_tActiveCode[gCurInd])
'		end if
'	else
'		if g_tLinkItemCode[gCurInd] <> "" then
'			szItemCode = g_tLinkItemCode[gCurInd]
'			g_tActiveCode[gCurInd] = szItemCode
'			ChartEx0.SetContiueFuture("0;" & szItemCode)
'
'			if gMulCode[gCurInd] <> g_tLinkItemCode[gCurInd] then
''				Form.SetItemCode(szItemCode)
'				Form.triggerEvent("linkfmHoga", "ITEMCODE", szItemCode)
'			end if
'		end if
'	end if
	
	szExchName = Form.GetItemCodeInfo( gMulCode[gCurInd] , "exchname")
	szToday = Form.GetSharedData("&HOST_DATE", 0 )
	
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , szExchName )	'거래소명
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) 		'종목코드
'	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_DATE" , 0 , szToday) 					'조회날짜
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_JOB_CLS_CODE" , 0 , szChrtType ) 		'주기타입 0:틱, 1:분, 2:일, 3:주, 4:월
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_CNT" , 0 , "300" ) 				'조회개수
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_HOUR_CLS_CODE" , 0 , szJoogiType )'N분, N틱 ~~ 
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" , 0 , "0" ) 	'당일조회여부 1:당일
	DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_PRC_CLS_CODE" , 0 , "1" ) 		'가격구분 0:정산가, 1:종가
	
	DATAMANAGER.RequestTranData( szTranID )
	
end Function

'============================================================================
Function f_ChangeCode()
	if g_bTranflag = false then
		Exit Function
	end if

	Dim codeTemp, zItemCode
	
	if gMulCode[gCurInd] = "" then
		gMulCode[gCurInd] = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)
	end if
	
'	g_szItemCode = ""
	
	if BtnLink.caption = "연결" and f_FindMarket(gMulCode[gCurInd]) = "F" then
		if InStr(gMulCode[gCurInd] , "." ) <> 0 then
			codeTemp = split(gMulCode[gCurInd], ".")
			zItemCode = codeTemp[0]
			zItemCode = Form.GetFirstMonth(zItemCode)
			g_tActiveCode[gCurInd] = Form.GetActiveMonth(zItemCode)
			
			g_szItemCode = gMulCode[gCurInd]
			
		else
			g_tActiveCode[gCurInd] = Form.GetActiveMonth(gMulCode[gCurInd])
			g_szItemCode = Form.GetItemCodeInfo( gMulCode[gCurInd] , "commodity" ) & ".1"
			g_szExchName = Form.GetItemCodeInfo( g_szItemCode, "exchname")
			
		end if
		
		ChartEx0.SetContiueFuture("1;" & g_tActiveCode[gCurInd]) '연결개별여부;실시간코드
		g_flagInit = false

		Form.triggerEvent("lkform", "ITEMCODE", g_tActiveCode[gCurInd])
		Form.SetItemCode(g_tActiveCode[gCurInd])

	elseif g_tLinkItemCode[gCurInd] <> "" or  gMulCode[gCurInd] <> ""  then
		if g_tLinkItemCode[gCurInd] = "" then 
			if InStr(gMulCode[gCurInd] , "." ) <> 0 then 
				codeTemp = split(gMulCode[gCurInd], ".")
				zItemCode = codeTemp[0]
		
				zItemCode = Form.GetFirstMonth(zItemCode)
				g_tLinkItemCode[gCurInd] = Form.GetActiveMonth(zItemCode)
				
			else 
				g_tLinkItemCode[gCurInd] = gMulCode[gCurInd]
				
			end if
		else 
			if InStr(gMulCode[gCurInd] , "." ) <> 0 then
				codeTemp = split(gMulCode[gCurInd], ".")
				zItemCode = codeTemp[0]
		
				zItemCode = Form.GetFirstMonth(zItemCode)
				g_tLinkItemCode[gCurInd] = Form.GetActiveMonth(zItemCode)
			end if
		end if
		
		g_szItemCode = g_tLinkItemCode[gCurInd]
		g_tActiveCode[gCurInd] = g_szItemCode
		ChartEx0.SetContiueFuture("0;" & g_szItemCode)
		
		if gMulCode[gCurInd] <> g_tLinkItemCode[gCurInd] then
			Form.triggerEvent("lkform", "ITEMCODE", g_szItemCode)
		end if
		
		Form.SetItemCode(gMulCode[gCurInd])
	end if

End Function
'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	   
	end if
	
	sPeriod = CInt( g_sPeriod)
	if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	end if
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Form.SetSearchType ("16")	'20180712 HAMWG : K-OTC MTS 도입
	ChartEx0.SetLoadChart("foreignfuture_multi")      
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END'
End Sub

'============================================================================
Sub Form_OnFormInit()
	ChartEx0.SetForeignFuture("1")
	ChartEx0.SetMarketCategory("6")

	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_flagInit = false
	Form.SetInterestTitle("N")		'비활성화로 기본 세팅 20230722 HSZ
	
	Dim szItemCode, szChartLinkData

	szItemCode = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)	' 최근조회종목
	szChartLinkData = Form.GetEnvData("GLOBAL_CHART_LINK") 	' 차트 개별,연결
	
	if szItemCode = nil or szItemCode = "" then
		szItemCode = ""
	end if
	
	gMulCode[gCurInd] = szItemCode
	g_tActiveCode[gCurInd] = szItemCode
	
	if f_FindMarket(szItemCode) <> "F" then
		BtnLink.enable = false
	else
		g_tLinkItemCode[gCurInd] = szItemCode
	end if
	
	if szChartLinkData = nil or szChartLinkData = "" or szChartLinkData = "개별" then
		BtnLink.caption = "개별"
	else
		BtnLink.caption = "연결"
	end if
	
	g_tChartLinkData[gCurInd] = BtnLink.caption
	
	Form.SetItemCode(szItemCode)	
	Form.triggerEvent("linkfmHoga", "ITEMCODE", szItemCode) 	' 링크화면에 종목코드 던지기
	
	setChart()
	f_ChangeCode()
	RequestData()
End Sub

'============================================================================
Function f_FindMarket(szCode)
	Dim szMarketCode
	
	if cint(InStr( szCode, " " )) > 0 then '옵션
		szMarketCode = "O"
'	elseif cint(InStr( szCode , "-" )) > 0 then '스프레드
'		szMarketCode = "SP"
	else
		szMarketCode = "F" '선물
	end if
	
	return szMarketCode
End Function

'============================================================================
Sub Form_OnFormClose()
	Form.SetEnvData( 1,"multichart_setting" , g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"multichart_settingmintick" , g_szMinType.."^"..g_szTicType )
	'Form.SetSharedData("&ITEM_GLOBAL_FUTOPT", gMulCode[0])	' 첫번째 분할면 종목 넘겨주기
	Form.SetSharedData("&ITEM_GLOBAL_FUTOPT", g_tActiveCode[0])	' 첫번째 분할면 종목 넘겨주기
	Form.SetEnvData(1, "GLOBAL_CHART_LINK", g_tChartLinkData[gCurInd])
	
	ChartEx0.SetSaveChart("1")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" or sKey = "&ACR_ITEM" then
'		if sKey = "&ACR_ITEM" then
'			Form.SetItemCode(sValue)
'		end if
		
		' 현재 선택된 분할 면의 종목코드와 받아온 종목코드가 같으면
		' 조회 하지 않음...
		' 받아온 종목 넣어주기
		if g_tActiveCode[gCurInd] = sValue and gMulCode[gCurInd] <> "" then
			exit Sub
		end if
		
		if sValue <> "" then
			gMulCode[gCurInd] = sValue
			g_tActiveCode[gCurInd] = sValue
			g_tLinkItemCode[gCurInd] = sValue
			Form.SetItemCode(sValue)
			
			if f_FindMarket(sValue) <> "F" then
				BtnLink.enable = false
			else
				BtnLink.enable = true
			end if
		end if
		
		g_bTranFlag = true
		f_ChangeCode()
		RequestData()
		
	end	if	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
		f_ChangeCode()
		RequestData()
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(RadioGroup0.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]
		PeriodSet(g_szChrtType)
		
		f_ChangeCode()
		RequestData()
		
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet)
		PeriodSet(g_szChrtType)	
		
		f_ChangeCode()
		RequestData()
'
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then		'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		f_ChangeCode()
		RequestData()
		
	elseif nIndex == 1 then	'주/월
		g_flagMin = false
		g_flagTic = false

		if g_flagWeek == false   then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
			else
				g_szChrtType = "W"
			end if
			
			PeriodSet(g_szChrtType)
			
			f_ChangeCode()
			RequestData()
			g_flagWeek = true
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_p3", sTemp, "" )
			
		end if

	elseif nIndex == 2 then   '분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin == false then
			tmpMin = split(RadioGroup0.GetRadioCaption( 2),"분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
			
			f_ChangeCode()
			RequestData()
			g_flagMin = true
			
		else
			Form.OpenPopup( "mhcht13000_p1" , g_szMinType , "" )
			
		end if

	elseif nIndex == 3 then   '틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"

		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption( 3),"틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
			
			f_ChangeCode()
			RequestData()
			
		else
			Form.OpenPopup( "mhcht13000_p2", g_szTicType, "" )
			
		end if
	end if	
	
End Sub

