Sub ContMain_EditPwd_OnEditComplete()
	
	if cint(ContMain.EditPwd.pwdlen) < 4 then
		ShowAlert("안내", "최소 4자리 이상 입력해야 합니다.")
		Exit Sub	
	end if

	btnOK.enable 		= false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		= "269"
	
	ContMain.Label0.enable 	= false
	ContMain.Label1.enable 	= false
	ContMain.Label2.enable 	= false
	ContMain.Image0.enable 	= false
	ContMain.Image1.enable 	= false
	ContMain.Image2.enable 	= false
	
	g_finish1 = 0
	g_finish2 = 0
	g_finish3 = 0
	
	'ContMain.EditPwd.SetResultLabel("1","complete","인증에성공하였습니다","ContMain")
	DATAMANAGER.RequestTranData("obacp_opop_066r")
	
End Sub


'============================================================================
' 최종업무신청
'============================================================================
Sub btnOK_OnClick()
	
	If ContMain.EditPwd.caption ="" then
		ShowAlert("안내", "비밀번호를 입력하세요.")
		Exit Sub
	End If
	
	If pwSetYn <> 1 Then
		ShowAlert("안내", "계좌비밀번호 재설정 신청내역이 존재합니다. 영업점 승인 및 재설정 완료 후 신청가능합니다.")
		Exit Sub
	End If

	If g_Chk6_007r == 0 Then
		ShowAlert("안내","이미 신청된 업무가 존재합니다.")
		Exit Sub
	End If

	If strTRGT_YN == "N" Then
		'g_Cchk6 = sCheckState
	
	ElseIf strTRGT_YN == "Y" Then
		ShowAlert("알림", "제휴은행에서 개설하신 계좌는 타기관 은행이체 등록이 불가능합니다.")
		Exit Sub
	End If

	DATAMANAGER.RequestTranData("obaci_nmet_005a")

End Sub

