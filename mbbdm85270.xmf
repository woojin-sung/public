	<SCRIPT_INFO _len="43540" _ulen="40140" >
'===========================================================================
' 01. 화 면 명 : 업무신청 타기관 은행이체등록
' 02. 화면설명 : 업무신청 타기관 은행이체등록
' 03. 작    성 : 2021.01.14 성주혁
' 04. 수    정 :  
'2022.08.12 전상일 : v0001 : 바이오인증 송수신 분리
'2023.04.18 전상일 : v0002 : 단기다수개설자 에러메세지 분리
'===========================================================================
'진입점에서 설정되는 정보 ---------------------------------------
Dim g_BDM_FRST_MAPID			'최초진입점화면ID

'as-is mbact15006
Dim strRsno '주민번호
Dim strAcno '계좌번호
Dim strCsno '고객번호
Dim TEL_no  '휴대폰번호
 
Dim pwSetYn '계좌비밀번호재설정 신청여부 확인 (as-is :g_Cnt2)

'as-is mbact15007

'업무별 기 신청내역
Dim g_Chk1_007r
Dim g_Chk2_007r
Dim g_Chk3_007r
Dim g_Chk4_007r
Dim g_Chk5_007r
Dim g_Chk6_007r
Dim g_Chk7_007r

'기 신청내역 조회 (0(N):존재 1(Y):미존재)
g_Chk1_007r = 0
g_Chk2_007r = 0
g_Chk3_007r = 0
g_Chk4_007r = 0
g_Chk5_007r = 0
g_Chk6_007r = 0
g_Chk7_007r = 0

'개인정보입력 화면에서 휴대폰번호 받아옴(mbcnf15000) 
HP1 = Form.GetSharedData("BDM_HP1", False )
HP2 = Form.GetSharedData("BDM_HP2", False )
HP3 = Form.GetSharedData("BDM_HP3", False )
TEL_no = HP1 & HP2 & HP3


'타기관은행이체 기관명
Dim g_bankNm1
Dim g_bankNm2
Dim g_bankNm3

'타기관은행이체 기관코드
Dim g_code1
Dim g_code2
Dim g_code3

'타기관은행이체 계좌
Dim g_bankAcno1
Dim g_bankAcno2
Dim g_bankAcno3

'계좌입력대상체크
Dim g_regFlag

'입력완료여부
Dim g_finish1
Dim g_finish2
Dim g_finish3

Dim pw_okcheck
Dim strREG_UNIQ_NO

Dim strTRGT_YN '제휴은행개설계좌여부

'안내사항
Dim bWide
bWide = false

Dim szTheme


'v0001
Dim g_BIORetry1
Dim g_BIORetry2
Dim g_BIORetry3
Dim g_BIOTrName1
Dim g_BIOTrName2
Dim g_BIOTrName3
DIM DEF_1ST_TIME
DIM DEF_2ST_TIME

DEF_1ST_TIME = 0.5
DEF_2ST_TIME = 1.0

Dim g_OsType
Dim g_szOSType

Dim g_RcvnIqryNo1
Dim g_RcvnIqryNo2
Dim g_RcvnIqryNo3

Dim g_TR_DATE

'============================================================================
Sub Form_OnFormInit()
	g_TR_DATE  = Form.GetSharedData("&HOST_DATE", false )
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	szTheme  = Form.GetEnvData("common.theme")
	
	if g_OsType == "1" then
		g_szOSType = "112"			'안드로이드
	else
		g_szOSType = "111"			'IOS
	end if
	
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	szTheme = Form.GetEnvData("common.theme")
	
	pwSetYn = ""
	pw_okcheck = 0
	ContMain.Combo0.SetApplyLabel("종합계좌번호"		, 0 ,268  ,"left",true,80)
	'ContMain.Combo0.cbtype 		= 4 ' 3:bottomsheet 4:dropdown
	
	ContMain.Editpwd.SetApplyLabel           ("종합계좌 비밀번호"   , 0 , 268 , "left",true)

	ContMain.EdtAcc0.SetApplyLabel("계좌번호" , 0 , 76 , "left",false)
	ContMain.EdtAcc1.SetApplyLabel("계좌번호"   , 0 , 76 , "left",false)
	ContMain.EdtAcc2.SetApplyLabel("계좌번호"   , 0 , 76 , "left",false)
	
	ContMain.EdtAcc0.enable = false
	ContMain.EdtAcc1.enable = false
	ContMain.EdtAcc2.enable = false

	ContMain.EditPwd.enable = false
	
	btnOK.enable		= false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		= "269"
	
	ContMain.Label0.enable = false
	ContMain.Label1.enable = false
	ContMain.Label2.enable = false
	ContMain.Image0.enable = false
	ContMain.Image1.enable = false
	ContMain.Image2.enable = false
	
	ContMain.Label0.bringFront("0")
	ContMain.Label1.bringFront("0")
	ContMain.Label2.bringFront("0")
	ContMain.Image0.bringFront("0")
	ContMain.Image1.bringFront("0")
	ContMain.Image2.bringFront("0")
	
	
	ContMain.EdtAcc0.SetUseResultLabel(True,2)
	ContMain.EdtAcc1.SetUseResultLabel(True,2)
	ContMain.EdtAcc2.SetUseResultLabel(True,2)
	
	strREG_UNIQ_NO = Form.GetSharedData("BDM_REG_UNIQ_NO"        , False)
	
	
	strRsno = Form.GetSharedData("BDM_RCNO_PIP", 0)	'주민번호 v0002.난수암호화된 rcno setting
	'strRsno ="001342144A13CF8E3A32DD125D4636156EB3" 'dfdf
	g_BDM_FRST_MAPID = Form.GetSharedData("BDM_FRST_MAPID"         , false)  '최초진입화면ID
	
	
	g_finish1 = 0
	g_finish2 = 0
	g_finish3 = 0
	
	ContMain.Label0.fgcolor = "270"
	ContMain.Label1.fgcolor = "270"
	ContMain.Label2.fgcolor = "270"
	
	DATAMANAGER.RequestTranData("obaci_acct_185r") 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_acct_185r" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r", "InBlock1", "RCNO" 	 , 0 , "NMET")	'주민번호(은행개설계좌조회를위한 NMET전달)
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
	
	elseif szTranID = "obaci_nmet_006r" then
				
		DATAMANAGER.SetDataValue(0, "obaci_nmet_006r", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
		DATAMANAGER.SetDataValue(0, "obaci_nmet_006r", "InBlock1", "ACNO" , 0 , strAcno)	'계좌번호
	
	elseIf szTranID == "obacp_opop_066r" Then
		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNO", 0, strAcno )
	elseif szTranID == "obaci_nmet_005a" then
		
		'고정부
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" 				 , 0 , strAcno 	) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" 				 , 0 , ""		) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DRNG_BANK_CODE" 	 , 0 , ""    		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BANK_ACNO" 		 , 0 , "" 		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNRC_ACNO" 	 , 0 , ""   		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNRC_ASNO" 	 , 0 , ""	   	)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IDNTF_SRNO" 		 , 0 , Trim(Form.GetSharedData("BDM_IDNTF_SRNO", false) ))'신분증인증화면에서 가져옴
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IDNTF_SRNO" 		 , 0 , 9999		)'신분증인증화면에서 가져옴
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RLNM_CNFR_MTHD_CODE" , 0 , "01"       	)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "WHOL_CPNO" 		 , 0 , TEL_no		)
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "WHOL_CPNO" 		 , 0 , "01056084566")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "REG_UNIQ_NO" 		 , 0 , strREG_UNIQ_NO	)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN1" 			, 0 , ""			) '온라인개설계좌 실명 확인
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN2" 			, 0 , ""			) '비밀번호 재설정
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN3" 			, 0 , ""			) '공인인증서 재발급 동의  신청여부 
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN4" 			, 0 , ""			) '온라인서비스 신청
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN5" 			, 0 , ""			) '온라인 이체한도 등록 및 증액
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN6" 			, 0 , ""			) '타기관OTP 등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN7" 			, 0 , "Y"			) '타기관 은행이체 등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN8" 			, 0 , ""			) '메리츠 종합계좌간 대체 등록
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "T1_TACT_LIMT_AMT" , 0 , 0			) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "D1_TACT_LIMT_AMT" , 0 , 0			)
		
		'otp업무 안하므로 고정 ""
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_SUPL_CO_CODE" 	, 0 , "" 		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_CARD_SRNO" 		, 0 , ""			)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_ISNC_ISTU_CODE" , 0 , ""			)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO1" , 0 , "" 				) '메리츠계좌간대체 계좌1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO2" , 0 , ""				) '			   계좌2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO3" , 0 , ""				) '			   계좌3
		
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO1"	, 0 , g_bankAcno1 ) '타기관 은행이체 계좌1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO2"	, 0 , g_bankAcno2 ) '				계좌2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO3"	, 0 , g_bankAcno3 ) '				계좌3
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE1"		, 0 , g_code1 	) '타기관 은행이체 은행1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE2"		, 0 , g_code2 	) '			      은행2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE3" 	  	, 0 , g_code3 	) '			      은행3
			
		
		
	End if
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obaci_acct_185r" Then
		
		tmp = DATAMANAGER.GetDataCount( 0 , "obaci_acct_185r", "OutBlock1")	
		for i = 0 to tmp-1
			acno 	 = DATAMANAGER.GetDataValue( 0 ,"obaci_acct_185r", "OutBlock1", "ACNO",i )
			mask_acno = Combo_AccMask(acno)
			ContMain.Combo0.cbadddatatext  = mask_acno
			
			strAcno = replace(ContMain.Combo0.caption, "-" , "")
		next 
		
		ContMain.Combo0.caption  = "종합계좌를 선택해주세요"
		ContMain.Combo0.fgcolor = 270
		
		'DATAMANAGER.RequestTranData("obaci_nmet_006r")
	
	elseif szTranID = "obaci_nmet_006r" Then
		
		g_StatCd = DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_006r", "OutBlock4", "ACNT_STAT_CODE",0 )
		g_ProsYN =  DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_006r", "OutBlock4", "PROS_ABLE_YN",0 )
		
		Form.SetSharedData("ACNT_STAT_CODE", g_StatCd)
			
		'입력한 종합계좌 상태 체크
		if g_StatCd == "3" Then
			ShowAlert("오류","폐쇄된 종합계좌입니다.")
			Exit Sub
		End If
		
		'보유중인 계좌 중, 계좌상태가 정상인 종합계좌, 하위개별계좌 건수 확인
'		If g_ProsYN == "N" Then
'			ShowAlert("오류","정상 개별계좌가 없습니다.")
'			Exit Sub
'		End If
		
		'ShowAlert("확인", "계좌번호가 확인되었습니다.")
		
		
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1" , "ACNO" , 0 , strAcno)
		DATAMANAGER.RequestTranData "obacp_opop_064r"
	
	ElseIf szTranID == "obacp_opop_064r" Then
		strCsno = DATAMANAGER.GetDataValue(0, "obacp_opop_064r" , "OutBlock1" , "CSNO" , 0)
		'0203
		Form.SetSharedData("CSNO" , strCsno)
		'strRcno = DATAMANAGER.GetDataValue(0, "obacp_opop_064r" , "OutBlock1" , "RCNO" , 0) v0002. 난수암호화된 rcno setting
		
		DATAMANAGER.SetDataValue(0, "obaci_nmet_007r", "InBlock1", "ACNO" , 0 , strAcno)
		DATAMANAGER.SetDataValue(0, "obaci_nmet_007r", "InBlock1", "CSNO" , 0 , strCsno)
		DATAMANAGER.RequestTranData "obaci_nmet_007r"
		
		get_STPL_YN()
		
	ElseIf szTranID == "obaci_nmet_007r" Then '계좌비밀번호재설정 신청여부 확인
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN2", 0) == "Y" Then
			pwSetYn = 1 '신청 내역 없음
		End if
		
		g_strTactLimitBfr = DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN5", 0)
		g_strOTPBf		= DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN6", 0)
			
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN4", 0) == "Y" Then
			g_Chk1_007r = 1
		Else
			g_Chk1_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN5", 0) == "Y" Then
			g_Chk2_007r = 1
		Else
			g_Chk2_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN1", 0) == "Y" Then
			g_Chk4_007r = 1
		Else
			g_Chk4_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN3", 0) == "Y" Then
			g_Chk5_007r = 1
		Else
			g_Chk5_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN7", 0) == "Y" Then
			g_Chk6_007r = 1
		Else
			g_Chk6_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN8", 0) == "Y" Then
			g_Chk7_007r = 1
		Else
			g_Chk7_007r = 0
		End if	
	
	elseIf szTranID == "obacp_opop_066r" Then		
		pw_okcheck = 1
		
		If g_Chk6_007r == 0 Then
			ShowAlert("안내","이미 신청된 업무가 존재합니다.")
			Exit Sub
		else
			ContMain.Label0.enable = true
			ContMain.Label1.enable = true
			ContMain.Label2.enable = true
			ContMain.Image0.enable = true
			ContMain.Image1.enable = true
			ContMain.Image2.enable = true
			
			ContMain.EdtAcc0.SetResultLabel("0", "complete", "",  "ContMain")
			ContMain.EdtAcc1.SetResultLabel("0", "complete", "",  "ContMain")
			ContMain.EdtAcc2.SetResultLabel("0", "complete", "",  "ContMain")
		End If
		
		
	ElseIf szTranID == "obaci_nmet_009r" Then
		
		'은행이체한도등록및변경 
		STPL_YN2 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "STPL_YN" , 0 )
		Form.SetSharedData("STPL_YN2", STPL_YN2)
		
		T1 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "T1_TACT_LIMT_AMT" , 0 )
		D1 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0 )
		Grade = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "SECU_GRAD_CLS_CODE" , 0 )
		
		Form.SetSharedData("15007_T1", T1)
		Form.SetSharedData("15007_D1", D1)
		Form.SetSharedData("15007_Grade", Grade)
			
		
		'타기관 은행이체 등록
		STPL_YN6 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock3" , "STPL_YN" , 0 )
		Form.SetSharedData("STPL_YN6", STPL_YN6)
		
		'메리츠 종합계좌간 대체 등록
		STPL_YN7 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock4" , "STPL_YN" , 0 )		
		Form.SetSharedData("STPL_YN7", STPL_YN7)
		
		'제휴은행개설계좌 여부 확인 
		strTRGT_YN = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock5" , "TRGT_YN" , 0 )		
		Form.SetSharedData("15007_TRGT_YN", TRGT_YN)
		
		ContMain.EditPwd.SetShowKeypad(true)
		
	'=============================================
	'타기관 추가
	'=============================================
	elseIf szTranID == "obtss_arss_101r" Then
		'Form.SetTimerEvent("1", 0, 50)
		'v0006 jsi start
		g_BIOTrName1	= szTranID
		g_BIORetry1	= 0
		g_RcvnIqryNo1 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		
		Form.SetTimerEvent2(1,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
		'v0006 jsi end
	'v0006 jsi start
	elseIf szTranID == "obtss_arss_102r" Then		
		sName       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACHO_NAME" 	, 0)
		sCODE       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 	, 0)
		sCNTT       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		'sRcvnDate   = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_DATE"    , 0)
		'sRcvnIqryNo = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		'nCnt = DATAMANAGER.GetDataCount( 0 , "obtss_arss_102r", "OutBlock1")
		
		if sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry1 = g_BIORetry1 + 1
			if g_BIORetry1 >= 3 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry1 = 0 '초기화
				Exit Sub
			end if 
			
			Form.SetTimerEvent(11,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			exit sub
		end if
		
		'sCODE ="1111" 'dfdf
		If CLng(sCODE) <> 0 Then
			szBankCode1 = Form.GetMetaData("은행코드", g_code1)
			'ShowAlert ("알림", "송금하실 출금기관 및 계좌번호를 다시 확인해주시기 바랍니다. ("&szBankCode1&"/"&g_bankAcno1&")")
			
			ContMain.EdtAcc0.SetResultLabel("1", "error", "등록하실 출금기관 및 계좌번호를\n다시 확인해주시기 바랍니다.", "ContMain",2)
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain_Image0_OnClick()
			Exit Sub
		ElseIf CLng(sCODE) == 0 Then
			g_finish1   = 1 '최종입력완료
			ContMain.Label0.caption = g_bankNm1 &" "&g_bankAcno1
			ContMain.Label0.fgcolor = "267"
			
		End If
		
		btnOK_Change()
		
	ElseIf szTranID == "obtss_arss_101r_1" Then
		'v0006 jsi start
		g_BIOTrName2	= szTranID
		g_BIORetry2	= 0
		g_RcvnIqryNo2 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		
		Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
		'v0006 jsi end
	elseIf szTranID == "obtss_arss_102r_1" Then		
		sName       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACHO_NAME" 	, 0)
		sCODE1       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 	, 0)
		sCNTT1      = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		'sRcvnDate   = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_DATE"    , 0)
		'sRcvnIqryNo2 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		'nCnt = DATAMANAGER.GetDataCount( 0 , "obtss_arss_102r", "OutBlock1")
		
		if sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry2 = g_BIORetry2 + 1
			
			if g_BIORetry2 >= 3 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry2 = 0 '초기화
				Exit Sub
			end if 
			
			Form.SetTimerEvent(22,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			
			exit sub
		end if
		
		If CLng(sCODE1) <> 0 Then			
			szBankCode2 = Form.GetMetaData("은행코드", g_code2)
			'ShowAlert ("알림", "송금하실 출금기관 및 계좌번호를 다시 확인해주시기 바랍니다. ("&szBankCode2&"/"&g_bankAcno2&")")
			
			ContMain.EdtAcc1.SetResultLabel("1", "error", "등록하실 출금기관 및 계좌번호를\n다시 확인해주시기 바랍니다.", "ContMain",2)
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain_Image1_OnClick()
			Exit Sub
			
		ElseIf CLng(sCODE1) == 0 Then
			g_finish2   = 1 '최종입력완료
			ContMain.Label1.caption = g_bankNm2 &" "&g_bankAcno2
			ContMain.Label1.fgcolor = "267"
		End If
		
		btnOK_Change()
		
	ElseIf szTranID == "obtss_arss_101r_2" Then
		'v0006 jsi start
		g_BIOTrName3	= szTranID
		g_BIORetry3	= 0
		g_RcvnIqryNo3 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		
		Form.SetTimerEvent2(3,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
		'v0006 jsi end
	'v0006 jsi start	
	elseIf szTranID == "obtss_arss_102r_2" Then			
		
		sName       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACHO_NAME" 	, 0)
		sCODE2      = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 	, 0)
		sCNTT2       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		'sRcvnDate   = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_DATE"    , 0)
		'sRcvnIqryNo3 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		if sCODE2 == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry3 = g_BIORetry3 + 1
			if g_BIORetry3 >= 3 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry3 = 0 '초기화
				Exit Sub
			end if 
			
			Form.SetTimerEvent(33,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			exit sub
		end if
		
		If CLng(sCODE2) <> 0 Then
			szBankCode3 = Form.GetMetaData("은행코드", g_code3)
			'ShowAlert ("알림", "송금하실 출금기관 및 계좌번호를 다시 확인해주시기 바랍니다. ("&szBankCode3&"/"&g_bankAcno3&")")
			
			ContMain.EdtAcc2.SetResultLabel("1", "error", "등록하실 출금기관 및 계좌번호를\n다시 확인해주시기 바랍니다.", "ContMain",2)
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain_Image2_OnClick()
			Exit Sub
			
		ElseIf CLng(sCODE2) == 0 Then
			g_finish3   = 1 '최종입력완료
			ContMain.Label2.caption = g_bankNm3 &" "&g_bankAcno3
			ContMain.Label2.fgcolor = "267"
		End If
	
		btnOK_Change()
	'v0006 jsi end
	elseif szTranID == "obaci_nmet_010r" Then
		cnt = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_010r" , "OutBlock1" , "IQRY_CSNU" , 0 )
		If cdbl(cnt) > 0 Then
			If g_regFlag == "0" Then
				'ShowAlert("안내" , "이미 약정 등록된 계좌입니다. ("&g_bankAcno1&")")
				
				ContMain.EdtAcc0.SetResultLabel("1", "error", "이미 약정 등록된 계좌입니다.", "ContMain")
				Form.SetTimerEvent2("9999", 1, 0.5)
				ContMain_Image0_OnClick()
				
			elseif g_regFlag == "1" Then
				'ShowAlert("안내" , "이미 약정 등록된 계좌입니다. ("&g_bankAcno2&")")
				
				ContMain.EdtAcc1.SetResultLabel("1", "error", "이미 약정 등록된 계좌입니다.", "ContMain")
				Form.SetTimerEvent2("9999", 1, 0.5)
				ContMain_Image1_OnClick()
				
			elseif  g_regFlag == "2" Then
				'ShowAlert("안내" , "이미 약정 등록된 계좌입니다. ("&g_bankAcno3&")")
				
				ContMain.EdtAcc2.SetResultLabel("1", "error", "이미 약정 등록된 계좌입니다.", "ContMain")
				Form.SetTimerEvent2("9999", 1, 0.5)
				ContMain_Image2_OnClick()
			end if
			Exit Sub
		Else
			If g_regFlag == "0" Then
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r" , "InBlock1",  "OPNG_RPRS_ISTU_CODE" , 0 , g_code1								)
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r" , "InBlock1",  "TR_ACNO" 			 , 0 , g_bankAcno1							) 
				'DATAMANAGER.SetDataValue(0, "obtss_arss_101r" , "InBlock1",  "RRNO" 			 , 0 , Form.GetSharedData("&RET_RSNO", False)		)
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r" , "InBlock1",  "RCNO_PIP" 			 , 0 , strRsno								)
				
				DATAMANAGER.RequestTranData "obtss_arss_101r"
			ElseIf g_regFlag == "1" Then
				
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r_1" , "InBlock1",  "OPNG_RPRS_ISTU_CODE" , 0 , g_code2								)
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r_1" , "InBlock1",  "TR_ACNO" 		   , 0 , g_bankAcno2							) 
				'DATAMANAGER.SetDataValue(0, "obtss_arss_101r_1" , "InBlock1",  "RRNO" 			   , 0 , Form.GetSharedData("&RET_RSNO", False)	)
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r_1" , "InBlock1",  "RCNO_PIP" 		   , 0 , strRsno								)
				DATAMANAGER.RequestTranData "obtss_arss_101r_1"
			ElseIf g_regFlag == "2" Then
				
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r_2" , "InBlock1",  "OPNG_RPRS_ISTU_CODE" , 0 , g_code3								)
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r_2" , "InBlock1",  "TR_ACNO" 		   , 0 , g_bankAcno3							) 
				'DATAMANAGER.SetDataValue(0, "obtss_arss_101r_2" , "InBlock1",  "RRNO" 			   , 0 , Form.GetSharedData("&RET_RSNO", False)	)
				DATAMANAGER.SetDataValue(0, "obtss_arss_101r_2" , "InBlock1",  "RCNO_PIP" 		   , 0 , strRsno								)
				DATAMANAGER.RequestTranData "obtss_arss_101r_2"
			End If
		End If
		
	ElseIf szTranID == "obaci_nmet_005a" Then '최종업무신청 성공
		
		tmp_aplt_date	= DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_005a", "OutBlock1", "APLT_DATE"			,0 )
		tmp_aplt_time	= DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_005a", "OutBlock1", "NMET_OPNG_APLT_TIME"	,0 )
	
		
		sz_Data = strAcno & "★" & "BANKACCT" & "★" & tmp_aplt_date & tmp_aplt_time
		
		'Form.OpenScreen("85201", sz_Data)
		
		Form.OpenPopup("mbbdm85201", sz_Data , "" ) '비대면휴대폰인증
	End if
End Sub
'============================================================================
'데이터 오류 수신
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szTranID == "obacp_opop_066r" Then
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
		ContMain.Label0.enable 	= false
		ContMain.Label1.enable 	= false
		ContMain.Label2.enable 	= false
		ContMain.Image0.enable 	= false
		ContMain.Image1.enable 	= false
		ContMain.Image2.enable 	= false
	
		ContMain.EdtAcc0.SetResultLabel("0", "complete", "",  "ContMain")
		ContMain.EdtAcc1.SetResultLabel("0", "complete", "",  "ContMain")
		ContMain.EdtAcc2.SetResultLabel("0", "complete", "",  "ContMain")
			
		ContMain.Label0.caption = "계좌번호를 입력해주세요"
		ContMain.Label1.caption = "계좌번호를 입력해주세요"
		ContMain.Label2.caption = "계좌번호를 입력해주세요"
		ContMain.Label0.fgcolor = "270"
		ContMain.Label1.fgcolor = "270"
		ContMain.Label2.fgcolor = "270"
		
		g_bankNm1	=""
		g_code1		=""
		g_bankAcno1	=""
		
		g_bankNm2	=""
		g_code2		=""
		g_bankAcno2	=""
		
		g_bankNm3	=""
		g_code3		=""
		g_bankAcno3	=""
		
		g_finish1 = 0
		g_finish2 = 0
		g_finish3 = 0
	
		If ContMain.Editpwd.caption == "" Then
			'Form.MsgBox( "알림", szErrMsg , "", 0 )
			PwErrorMsg  = szErrMsg
		Else
			'Form.MsgBox( "알림", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&" 또는 비대면실명확인 재설정 필요)" , "", 0 )
			PwErrorMsg  = szErrMsg&"★("&DATAMANAGER.GetDataMsgSubText(szTranID)&" 또는 비대면실명확인 재설정 필요)"
		End If 
		
		Form.OpenPopup("mbbdm85203" , PwErrorMsg , "5")
		
		ContMain.Editpwd.caption = ""
	
	ElseIf szTranID == "obaci_nmet_007r" Then
		ContMain.Editpwd.caption = ""
	
		Form.MsgBox("안내",szErrMsg,0,0)	
		
	ElseIf szTranID == "obtss_arss_101r" or szTranID == "obtss_arss_102r"  Then
		'ShowAlert ("알림", "본인 계좌만 등록 가능합니다. ")
		
		ContMain.EdtAcc0.SetResultLabel("1", "error", "본인 계좌만 등록 가능합니다.", "ContMain")
		
		Form.SetTimerEvent2("9999", 1, 0.5)
				
		ContMain_Image0_OnClick()
		Exit Sub

	ElseIf szTranID == "obtss_arss_101r_1" or szTranID == "obtss_arss_102r_1" Then
		'ShowAlert ("알림", "본인 계좌만 등록 가능합니다.")
		
		ContMain.EdtAcc1.SetResultLabel("1", "error", "본인 계좌만 등록 가능합니다.", "ContMain")
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain_Image1_OnClick()
		Exit Sub
	ElseIf szTranID == "obtss_arss_101r_2" or szTranID == "obtss_arss_102r_2" Then
		'ShowAlert ("알림", "본인 계좌만 등록 가능합니다.")
		
		ContMain.EdtAcc2.SetResultLabel("1", "error", "본인 계좌만 등록 가능합니다.", "ContMain")
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain_Image2_OnClick()
		Exit Sub	
		
	
	ElseIf szTranID == "obaci_nmet_005a" Then '최종업무신청 실패
		if sSubmsg ="" then
			Form.OpenPopup("mbbdm85202", szErrMsg , "" )
		else		'v0002 : 단기다수개설자 에러메세지 분리
			if szErrCode == "7111" or szErrCode == 7111 then
				Form.SetSharedData("BDM_NMET_SHORT_TERM_OPEN" , "Y")
				Form.OpenPopup("mbbdm85202", "단기다수개설 출금고제한 계좌는 타기관은행이체 등록이 불가능합니다." , "" )
			else
				Form.OpenPopup("mbbdm85202", szErrMsg&"("&sSubmsg&")" , "" )
			end if
		end if
	
	End if
		
End Sub
