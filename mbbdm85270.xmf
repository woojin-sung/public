Sub ContMain_Container1_Label11_OnClick()
	ContMain.EdtAcc0.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.EdtAcc1.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.EdtAcc2.SetResultLabel("0", "complete", "",  "ContMain")
	
	if bWide == false then
		bWide = true
		
		'안보이는라벨위치 아래로 조정
		ContMain.InfoPos.top = 660
		ContMain.SetScrollAutoSize()
		ContMain.Container1.ImageINFOB.imgpath = "icon_caret_up.png"
		
		ContMain.Container1.SetHeightResize(220)
		ContMain.scroll_pos = 190
	else
		
		bWide = false
		ContMain.Container1.SetHeightResize(40)
		ContMain.InfoPos.top = 0
		ContMain.scroll_pos = 30
		ContMain.Container1.ImageINFOB.imgpath = "icon_caret_down.png"
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		'ContMain.SetScrollAutoSize()
		
	end if
end Sub
 
 '============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" then
		Form.SetTimerEvent2("9999", 0, 0.5)
		ContMain.SetScrollAutoSize()
        'v0006 jsi start
	'1첫번째
	ElseIf sTimerID == "1" or sTimerID == 1 Then
		Form.SetTimerEvent2(sTimerID, 0, DEF_1ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RCVN_IQRY_NO"	, 0,  g_RcvnIqryNo1)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry1)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r")
		
	ElseIf sTimerID == "11" or sTimerID == 11 Then
		Form.SetTimerEvent(sTimerID, 0, DEF_1ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RCVN_IQRY_NO"	, 0,  g_RcvnIqryNo1)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry1)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r")
		
	ElseIf sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2(sTimerID, 0, DEF_2ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_1", "InBlock1", "RCVN_IQRY_NO"	, 0,  g_RcvnIqryNo2)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_1", "InBlock1", "RPCS_TMNU"	        , 0,  g_BIORetry2)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_1", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r_1")
		
	ElseIf sTimerID == "22" or sTimerID == 22 Then
		Form.SetTimerEvent(sTimerID, 0, DEF_2ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_1", "InBlock1", "RCVN_IQRY_NO"	, 0,  g_RcvnIqryNo2)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_1", "InBlock1", "RPCS_TMNU"	        , 0,  g_BIORetry2)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_1", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r_1")	
		
	ElseIf sTimerID == "3" or sTimerID == 3 Then	
		Form.SetTimerEvent2(sTimerID, 0, DEF_2ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_2", "InBlock1", "RCVN_IQRY_NO"	, 0,  g_RcvnIqryNo3)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_2", "InBlock1", "RPCS_TMNU"	        , 0,  g_BIORetry3)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_2", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r_2")
	ElseIf sTimerID == "33" or sTimerID == 33 Then	
		Form.SetTimerEvent(sTimerID, 0, DEF_2ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_2", "InBlock1", "RCVN_IQRY_NO"	, 0,  g_RcvnIqryNo3)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_2", "InBlock1", "RPCS_TMNU"	        , 0,  g_BIORetry3)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r_2", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r_2")
	'v0006 jsi end			
	end if
