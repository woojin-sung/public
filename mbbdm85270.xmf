'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName =="업무신청타기관취소" then
		if     g_regFlag == "0" then
			
			g_bankNm1   = ""
			g_code1     = ""
			g_bankAcno1 = ""
			
			ContMain.Label0.caption = "계좌번호를 입력해주세요"
			ContMain.Label0.fgcolor = "270"
			Form.SetTimerEvent2("9999", 1, 0.5)
			
			g_finish1   = 0
			
		elseif g_regFlag == "1" then
			
			g_bankNm2   = ""
			g_code2     = ""
			g_bankAcno2 = ""
			
			ContMain.Label1.caption = "계좌번호를 입력해주세요"
			ContMain.Label1.fgcolor = "270"
			Form.SetTimerEvent2("9999", 1, 0.5)

			g_finish2   = 0
			
		elseif	  g_regFlag == "2" then
			
			g_bankNm3   = ""
			g_code3     = ""
			g_bankAcno3 = ""
			ContMain.Label2.caption = "계좌번호를 입력해주세요"
			ContMain.Label2.fgcolor = "270"
			Form.SetTimerEvent2("9999", 1, 0.5)
			g_finish3   = 0
		end if
		
		btnOK_Change()
	elseIf sKeyName =="업무신청타기관완료" then
		tData1 = Split(sRet, "★")
		
		if     g_regFlag == "0" then
			g_bankNm1   = tData1(0)
			g_code1     = tData1(1)
			g_bankAcno1 = tData1(2)
			ContMain.Label0.caption = g_bankNm1 & " " & g_bankAcno1
			
			g_finish1   = 1
			
		elseif g_regFlag == "1" then
			g_bankNm2   = tData1(0)
			g_code2     = tData1(1)
			g_bankAcno2 = tData1(2)
			ContMain.Label1.caption = g_bankNm2 & " " & g_bankAcno2
			
			g_finish2   = 1
			
		elseif	  g_regFlag == "2" then
			g_bankNm3   = tData1(0)
			g_code3     = tData1(1)
			g_bankAcno3 = tData1(2)
			ContMain.Label2.caption = g_bankNm3 & " " & g_bankAcno3
			
			g_finish3   = 1
			
		end if
		
		If     g_regFlag == "0" then
			If g_bankAcno1 == g_bankAcno2 or g_bankAcno1 == g_bankAcno3 Then
				ContMain.Label0.caption = "계좌번호를 입력해주세요"
				'ShowAlert("안내","이미 등록된 계좌번호입니다. ("&g_bankAcno1&")")
				
				ContMain.EdtAcc0.SetResultLabel("1", "error", "이미 등록된 계좌번호입니다.", "ContMain")
				ContMain.Label0.fgcolor = "270"
				Form.SetTimerEvent2("9999", 1, 0.5)
				
				g_bankNm1   = ""
				g_code1     = ""
				g_bankAcno1 = "" 
				g_finish1   = 0
				Exit Sub
			end if
		elseif g_regFlag == "1" then
			If g_bankAcno2 == g_bankAcno1 or g_bankAcno2 == g_bankAcno3 Then
				ContMain.Label1.caption = "계좌번호를 입력해주세요"
				'ShowAlert("안내","이미 등록된 계좌번호입니다. ("&g_bankAcno2&")")
				
				ContMain.EdtAcc1.SetResultLabel("1", "error", "이미 등록된 계좌번호입니다.", "ContMain")
				ContMain.Label1.fgcolor = "270"
				Form.SetTimerEvent2("9999", 1, 0.5)
				g_bankNm2   = ""
				g_code2     = ""
				g_bankAcno2 = "" 
				g_finish2   = 0
				Exit Sub
			end if
		elseif g_regFlag == "2" then
			If g_bankAcno3 == g_bankAcno1 or g_bankAcno3 == g_bankAcno2 Then
				ContMain.Label2.caption = "계좌번호를 입력해주세요"
				'ShowAlert("안내","이미 등록된 계좌번호입니다. ("&g_bankAcno3&")")
				
				ContMain.EdtAcc2.SetResultLabel("1", "error", "이미 등록된 계좌번호입니다.", "ContMain")
				ContMain.Label2.fgcolor = "270"
				Form.SetTimerEvent2("9999", 1, 0.5)
				g_bankNm3   = ""
				g_code3     = ""
				g_bankAcno3 = "" 
				g_finish3   = 0
				Exit Sub
			end if
		End If
		
		if     g_regFlag == "0" then
			tmp_tact_bank_acno = g_bankAcno1
		elseif g_regFlag == "1" then
			tmp_tact_bank_acno = g_bankAcno2
		elseif g_regFlag == "2" then
			tmp_tact_bank_acno = g_bankAcno3
		end if
		
		
		DATAMANAGER.SetDataValue(0, "obaci_nmet_010r" , "InBlock1",  "CSNO" , 			0 , strCsno		   	)
		DATAMANAGER.SetDataValue(0, "obaci_nmet_010r" , "InBlock1",  "TACT_BANK_ACNO" , 	0 , tmp_tact_bank_acno	)
		DATAMANAGER.SetDataValue( 0, "obaci_nmet_010r" , "InBlock1",  "ACNO" 		, 	0 , strAcno		 	)
		DATAMANAGER.RequestTranData "obaci_nmet_010r"
		
	elseif sKeyName == "mbbdm85200_p9_end" or  sKeyName == "mbbdm85201_end" or  sKeyName == "mbbdm85202_end" then 
		if sRet =="ok" then
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			if g_BDM_FRST_MAPID ="screen41000" then
				Form.OpenScreen( "41000" , "")
				Form.CloseForm()	
			else
				Form.OpenNextPopup(g_BDM_FRST_MAPID, "", "")
			end if
		end if
	elseif sKeyName == "mbbdm85240_start" then
		if sRet =="ok" then
			'--------------------------------------------------------------
			
			s_hp1  = Trim(Form.GetSharedData("BDM_HP1"        , false))
			s_hp2  = Trim(Form.GetSharedData("BDM_HP2"        , false))
			s_hp3  = Trim(Form.GetSharedData("BDM_HP3"        , false))
			s_brun = Trim(Form.GetSharedData("BDM_REG_UNIQ_NO", false))
			s_brp  = Trim(Form.GetSharedData("BDM_RCNO_PIP"   , false))
			s_bis  = Trim(Form.GetSharedData("BDM_IDNTF_SRNO" , false))
			
			Form.SetSharedData("BDM_HP1"                 , s_hp1  )
			Form.SetSharedData("BDM_HP2"                 , s_hp2  )
			Form.SetSharedData("BDM_HP3"                 , s_hp3  )
			Form.SetSharedData("BDM_REG_UNIQ_NO"         , s_brun )
			Form.SetSharedData("BDM_RCNO_PIP"            , s_brp  )
			Form.SetSharedData("BDM_IDNTF_SRNO"          , s_bis  )
			'--------------------------------------------------------------
			Form.OpenNextPopup("mbbdm85240", "", "")
		end if
	end if
End Sub

'============================================================================
Function btnOK_Change()
	'If g_Chk1_007r == 1 and ContMain.ChkButton0.checkstate == "1" and ContMain.ChkButton1.checkstate == "1" Then
	
	If g_Chk6_007r == 1  Then '신청중 내역이 없는 경우
		If pw_okcheck ==1 Then
			if g_finish1 == 0 and  g_finish2 == 0 and g_finish3 == 0 then
				btnOK.enable		= false
				if szTheme = "black" then
					btnOK.btnimage	= "btn_27.9"
				else
					btnOK.btnimage	= "btn_21.9"
				end if
				btnOK.fgcolor		= "269"
			else
				btnOK.enable 		= true
				btnOK.btnimage	 = "btn_20.9"
				btnOK.fgcolor		= "273"
			end if
		end if
	else
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	end if

End Function

