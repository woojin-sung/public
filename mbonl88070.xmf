			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
			
		else	
		
