			Container0.ContMain.tblInvestCheck.visible = 0
			Container0.ContMain.tblInvestCheck2.visible = 0
			Container0.ContMain.lblInvestCheck.visible = 0
			
			Container0.ContMain.grdData.height = 100
			Container0.ContMain.height = 538	'553
			Container0.ContMain.SetScrollAutoSize()
	
			Container0.contCheck.visible = 0
			Container0.Label999BG.visible = 0
			Container0.Label999.visible = 0
			
			if g_CUST_CLS_CODE == "2" then	'2: 법인/1:개인
				Form.MsgBox("알림", "법인은 신청이 불가합니다.", "auth_check", 6)		
				Exit Sub
			end if

			Exit Sub
				
'''		'2023.04.19 권유미희망(불원)인 경우, 전체 상품 조회
'''		elseif (szKYC_INVT_RCMD_CLS_CODE == "3" or szKYC_INVT_RCMD_CLS_CODE == "4") and g_COMN_PFIN_YN == "N"  then
'''		
'''			'투자권유 희망하지 않는 경우
'''			Container0.ContMain.lblNoData.visible = 1
'''			Container0.ContMain.tblInvestCheck.visible = 1
'''			Container0.ContMain.tblInvestCheck2.visible = 0
'''			Container0.ContMain.lblInvestCheck.visible = 1
'''			Container0.ContMain.lblInvestCheck.caption = "투자성향분석하기 >"
'''
'''			Container0.ContMain.grdData.visible = 0
'''			Container0.ContMain.imgBreakTime.visible = 0
'''			Container0.ContMain.tblBreakTime.visible = 0
'''			Container0.ContMain.tblBreakTime2.visible = 0
'''			
'''			Container0.ContMain.grdData.height = 100
'''			Container0.ContMain.SetScrollAutoSize()
''''			Container0.ContMain.scroll_pos = 0
'''
'''			Container0.contCheck.visible = 0
'			Container0.Label999BG.visible = 0
'''			Container0.Label999.visible = 0
'''
'''			if g_CUST_CLS_CODE == "2" then	'2: 법인/1:개인
'''				Form.MsgBox("알림", "법인은 신청이 불가합니다.", "auth_check", 6)		
'''				Exit Sub
'''			end if
'''
'''			Exit Sub
		
		elseif (nTotalCsnu > 0  and nCnt == 0) and g_COMN_PFIN_YN == "N" then

			'내투자성향에 맞는 상품 없는 경우				
			Container0.ContMain.lblNoData.visible = 1
			Container0.ContMain.tblInvestCheck.visible = 0
			Container0.ContMain.tblInvestCheck2.visible = 1
			Container0.ContMain.lblInvestCheck.visible = 1
			Container0.ContMain.lblInvestCheck.caption = "투자성향분석하기 >"

			Container0.ContMain.grdData.visible = 0
			Container0.ContMain.imgBreakTime.visible = 0
			Container0.ContMain.tblBreakTime.visible = 0
			Container0.ContMain.tblBreakTime2.visible = 0
			
			Container0.ContMain.grdData.height = 100
			Container0.ContMain.height = 538	'553
			Container0.ContMain.SetScrollAutoSize()

			Container0.contCheck.visible = 0
			Container0.Label999BG.visible = 0
			Container0.Label999.visible = 0

			if g_CUST_CLS_CODE == "2" then	'2: 법인/1:개인
				Form.MsgBox("알림", "법인은 신청이 불가합니다.", "auth_check", 6)		
				Exit Sub
			end if

			Exit Sub
		
		else
			'탭 이동시 컨테이너 잘리는 현상이 있어서 추가.
			Container0.ContMain.height = 498	'!!!
					
			Container0.ContMain.lblNoData.visible = 0
			Container0.ContMain.imgBreakTime.visible = 0
			Container0.ContMain.tblBreakTime.visible = 0
			Container0.ContMain.tblBreakTime2.visible = 0
			Container0.ContMain.tblInvestCheck.visible = 0
			Container0.ContMain.lblInvestCheck.visible = 0
			Container0.ContMain.tblInvestCheck2.visible = 0
			
			'그리드랑 컨테이너 데이터 건수에 맞게 높이 조절
			Container0.ContMain.grdData.visible = 1
			Container0.ContMain.grdData.height = (157 * nCnt) + 15	'nGridCnt
			Container0.ContMain.SetScrollAutoSize()
			
			g_nNextCount = 0
		
			for i = 0 to DATAMANAGER.GetDataCount( 0 , "obsap_deal_003r", "OutBlock1")-1
				
				Container0.ContMain.grdData.AddRow()
				
				szTemp1  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "ISCD", 				i) 	'종목코드
				szTemp2  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "KOR_ISNM",			i)	'한글종목명
				szTemp3  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "CRDT_GRAD",			i)	'신용등급
				szTemp4  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "ESBD_STND_DYNU_CLCD",	i)	'전자단기사채기준일수구분코드
				szTemp5  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "PBLC_DATE",			i)	'발행일자
				szTemp6  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "MTRT_DATE",			i)	'만기일자
				szTemp7  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "GNRL_INTRT",			i)	'일반이자율
				szTemp8  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "TOTAL_ODER_LIMT_AMT",	i)	'총주문한도금액
				szTemp9  = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "RMNN_WNCR_AMT",		i)	'잔여원화금액
				szTemp10 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "INVT_TRGT_TYPE_CODE",	i)	'투자대상유형코드			
				
				szTemp11 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "RCRT_FIN_DATE",				i)	'모집종료일자
				szTemp12 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "RCRT_CLSN_HOUR",				i)	'모집마감시간
				szTemp13 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "PROD_GRAD_CODE",				i)	'상품등급코드
				szTemp14 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "ATCH_FILE_PATH_NAME",			i)	'첨부파일경로명
				szTemp15 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "HMPG_ATCH_FILE_PATH_NAME",		i)	'홈페이지첨부파일경로명
				szTemp16 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "ATCH_FILE_PATH_NAME1",		i)	'신용평가파일경로명
				szTemp17 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "HMPG_ATCH_FILE_PATH_NAME1",	i)	'홈페이지평가파일경로명
				szTemp18 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "INVT_DYNU",					i)	'투자일수
				szTemp19 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "RCRT_STA_DATE",				i)	'모집시작일자
				szTemp20 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "RCRT_STA_HOUR",				i)	'모집시작시간
				
				szTemp21 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "SHTR_BOND_REG_CLS_CODE",	i)	'단기사채등록구분코드
				szTemp22 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "CREN_CO_NAME",			i)	'신용보강회사명
				szTemp23 = DATAMANAGER.GetDataValue( 0 , "obsap_deal_003r", "OutBlock1", "PSNT_DATE",				i)	'현재일자
				
				'------------------------
				'상품위험등급
				'------------------------
				Container0.ContMain.grdData.SetCellData("badge_1", g_nNextCount , szTemp13)
				
				Dim sRiskGrade
				sRiskGrade = Container0.ContMain.grdData.GetCellData("badge_1", i) 
				
				if sRiskGrade = "01" then
					Container0.ContMain.grdData.SetCellImage("badge_1", g_nNextCount, "img_bgsquare_grade_296.png")
					Container0.ContMain.grdData.SetCellData("badge_1", g_nNextCount, "초고위험")
				elseif sRiskGrade = "02" then
					Container0.ContMain.grdData.SetCellImage("badge_1", g_nNextCount, "img_bgsquare_grade_297.png")
					Container0.ContMain.grdData.SetCellData("badge_1", g_nNextCount, "고위험")			
				elseif sRiskGrade = "03" then
					Container0.ContMain.grdData.SetCellImage("badge_1", g_nNextCount, "img_bgsquare_grade_298.png")
					Container0.ContMain.grdData.SetCellData("badge_1", g_nNextCount, "중위험")
				elseif sRiskGrade = "04" then
					Container0.ContMain.grdData.SetCellImage("badge_1", g_nNextCount, "img_bgsquare_grade_299.png")
					Container0.ContMain.grdData.SetCellData("badge_1", g_nNextCount, "저위험")
				elseif sRiskGrade = "05" then
					Container0.ContMain.grdData.SetCellImage("badge_1", g_nNextCount, "img_bgsquare_grade_300.png")
					Container0.ContMain.grdData.SetCellData("badge_1", g_nNextCount, "초저위험")
				end if
				
				'261 : 블랙/화이트 모두 하얀색
				Container0.ContMain.grdData.SetCellFgColor("badge_1", i, 261)
				
				
				'------------------------
				'신용등급
				'------------------------
				Container0.ContMain.grdData.SetCellData("badge_2", g_nNextCount , szTemp3)
							
				Dim sCreditGrade
				sCreditGrade = Container0.ContMain.grdData.GetCellData("badge_2", i)
				
				Container0.ContMain.grdData.SetCellImage("badge_2", i, "img_bgsquare_grade_316.png")
				Container0.ContMain.grdData.SetCellData("badge_2", i, sCreditGrade)
				
				Container0.ContMain.grdData.SetCellFgColor("badge_2", i, 321)
							
							
				Container0.ContMain.grdData.SetCellData("bd_cell71", g_nNextCount , "매수금리(연 세전)")
				
				'종목명 : 스페이스로 구분하여 줄바꿈해줌.. 스페이스 없으면 자동 줄바꿈..
				if InStr(szTemp2, " ") <> 0 Then
					szTemp2 = Left(szTemp2, InStr(szTemp2, " ")) .. "\n" .. Mid(szTemp2, InStr(szTemp2, " ")+1, Len(szTemp2)-InStr(szTemp2, " ")+1 )
				end if
				Container0.ContMain.grdData.SetCellData("KOR_ISNM", g_nNextCount , szTemp2)
				Container0.ContMain.grdData.SetCellData("GNRL_INTRT", g_nNextCount , szTemp7)
				
				Container0.ContMain.grdData.SetCellData("bd_cell27", g_nNextCount , "투자기간")
				Container0.ContMain.grdData.SetCellData("INVT_DYNU", g_nNextCount , szTemp18)
				
				Container0.ContMain.grdData.SetCellData("bd_cell67", g_nNextCount , "가능수량")
				Container0.ContMain.grdData.SetCellData("RMNN_WNCR_AMT_2", g_nNextCount , Clng(szTemp9)/100000000)	'매수가능잔여수량
				
				Container0.ContMain.grdData.SetCellData("bd_cell29", g_nNextCount , "만기일")
				Container0.ContMain.grdData.SetCellData("MTRT_DATE", g_nNextCount , szTemp6)
				
				if Container1.FormTab0.currenttab = 1 or Container1.FormTab0.currenttab = "1" then
					'유통물(자산유동화 단기사채)
					Container0.ContMain.grdData.SetCellData("bd_cell69", g_nNextCount , "신용보강")
					Container0.ContMain.grdData.SetCellData("CREN_CO_NAME", g_nNextCount , szTemp22)
				else
