'============================================================================
Sub Container2_contNotice_imgFold_OnClick()
	Dim szimgFile

	if bFoldState then
		szimgFile = "icon_arrow_down.png"
	else
		szimgFile = "icon_arrow_up.png"
	end if
	
	bFoldState = not bFoldState
	Container2.contNotice.imgFold.imgpath = szimgFile
	f_ShowInfo(bFoldState)
End Sub

'============================================================================
Function f_ShowInfo(bState)
	if bState then
		Container2.contNotice.height = 521
		Container2.contNotice.SetScrollAutoSize()
		
		Container2.scroll_pos = 335	
		Container2.lblCnfrNum.top = 434 + 495 + 15
		
		Container2.SetScrollAutoSize()
	else
		Container2.contNotice.height = 25	'25	'!!!
		Container2.contNotice.SetScrollAutoSize()

		Container2.scroll_pos = 0
		Container2.lblCnfrNum.top = 434 + 15
		
		Container2.SetScrollAutoSize()
	end if
End Function 

