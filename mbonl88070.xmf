'				end if
'			end if		
'		end if
			
	
		
		Dim nHostDate, nHostTime
		nHostDate = Form.GetSharedData( "&HOST_DATE", false )	'오늘날짜
		nHostTime = CDBL(LEFT(Form.GetSharedData( "&HOST_TIME", false ),4))	'오늘시간(시분)
	
	
		Dim nTotalCsnu, szBSDY_YN
		nTotalCsnu = CDBl(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock4", "TOTAL_CSNU" , 0)) 
		szBSDY_YN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock4", "BSDY_YN" , 0) 	'영업일여부 (Y:영업일 / N:비영업일)

'ShowAlert(g_COMN_PFIN_YN, nCnt)
'szBSDY_YN = "Y"
'nTotalCsnu = 1
'nCnt = 0
'szKYC_INVT_RCMD_CLS_CODE = "3"
'
		
		if szBSDY_YN == "N" and nTotalCsnu == 0  and nCnt == 0  then'and g_COMN_PFIN_YN == "N" then 'v001. 전문투자자 조건 제거
			
			'모집상품 없는 경우 (휴일인경우)
			Container0.ContMain.lblNoData.visible = 1
			Container0.ContMain.imgBreakTime.visible = 1
