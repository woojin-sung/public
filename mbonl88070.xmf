				Container1.Label4.fgcolor = "328"
				
			elseif szKYC_INVT_INCL_GRAD_CODE = "05" then	
				Container1.Label4.caption = "이자소득형"
				Container1.Label4.fgcolor = "329"
			'v0001 fin
					
			end if
		
		end if
		
		DATAMANAGER.RequestTranData( "obsan_deal_221r" )
