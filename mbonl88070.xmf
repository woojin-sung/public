'============================================================================
Sub Container1_lblSort_OnClick()
	if g_COMN_PFIN_YN == "N" then
		if g_szMtrtDate = "" or g_szMtrtDate = Null then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n발행어음 정렬 기준 변경이 불가합니다.")
		elseif int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false)) then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n발행어음 정렬 기준 변경이 불가합니다.")
		elseif szKYC_INVT_RCMD_CLS_CODE = "2" or szKYC_INVT_RCMD_CLS_CODE ="4" then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n발행어음 정렬 기준 변경이 불가합니다.")
		elseif szKYC_INVT_RCMD_CLS_CODE = "3" then	'투자권유 미희망 + 정보제공 일때 추가
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n발행어음 정렬 기준 변경이 불가합니다.")
		else
			Container1.cmbSortGb.openList()
		end if
	else
		Container1.cmbSortGb.openList()
	end if
End Sub

