'============================================================================
Sub Container1_btnToggle_OnClick()
	if CInt(Container1.btnToggle.switchindex) == 0 then
		f_SetCheckState(false)
	else
		f_SetCheckState(true)
	end if
End Sub

'============================================================================
Sub Container1_imgCheck_OnClick()
	if CInt(Container1.ChkButton0.checkstate) == 1 then
		f_SetCheckState(false)
	else
		f_SetCheckState(true)
	end if
End Sub

'============================================================================
Function f_SetCheckState(bValue)
	if bValue == true then
		Container1.ChkButton0.chksilence = "1"
		Container1.imgCheck.imgpath = CheckImgPath
		
		g_Trgt_Cls_Code = "0"	'내성향맞춤시
'		DATAMANAGER.RequestTranData( "obsap_deal_003r" )
			
		DATAMANAGER.RequestTranData( "obsan_deal_221r" )	
		
	else
		Container1.ChkButton0.chksilence = "0"
		Container1.imgCheck.imgpath = unCheckImgPath

		'전문투자자인 경우 체크해지하더라도 팝업 미생성
		if g_COMN_PFIN_YN == "Y" then
			g_Trgt_Cls_Code = "1"	'내성향맞춤해제시			
'			DATAMANAGER.RequestTranData( "obsap_deal_003r" )
			
			DATAMANAGER.RequestTranData( "obsan_deal_221r" )	
		else			
			if szKYC_INVT_RCMD_CLS_CODE == "3" or szKYC_INVT_RCMD_CLS_CODE == "4" then
				'미희망(불원)&미제공 or 미희망(불원)&제공 인 경우, 체크해지하면 팝업 생성 후 전체상품조회
				Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
			else
				' 내성향맞춤 체크해제시, 안내 팜업 확인 후 전체등급의 상품 조회 가능.
				Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
			end if
		end if
	end if
End Function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl88060_p11" then		
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			g_Trgt_Cls_Code = "1"	'내성향맞춤해제시			
'			DATAMANAGER.RequestTranData( "obsap_deal_003r" )
			
			DATAMANAGER.RequestTranData( "obsan_deal_221r" )	
		end if
	elseif sKeyName == "mbonl88060_p1" then		
		DATAMANAGER.RequestTranData( "obsap_deal_003r" )
	
	elseif sKeyName == "close" then
		Form.CloseForm()
		
	elseif sKeyName == "MBBDM85143" then
	
	
	'발행어음 주요정보확인 단계 팝업 리턴
	elseif sKeyName == "mbonl88070_p1" and sRet == "ok" then
		DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		
'		'금융소비자 유형 확인
'		Form.OpenPopup("mbonl81010_p20" , "" , "")
	
	'금융소비자 유형 확인 팝업 리턴
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			Dim tTemp
			tTemp = Split(g_szSendData, "★")
			if UBound(tTemp) > 0 then
				Dim szSendData
				szSendData = cmbAccount.total & "★" & tTemp[5]
				
				'투자성향 및 등급 확인
				Form.OpenPopup("mbonl88070_p7" , szSendData , "")
			end if
			
			'test
'			Form.OpenPopup("mbonl88070_s1" , g_szSendData , "")
			
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
		
		end if 
	
	'투자성향 및 등급 확인
	elseif sKeyName == "mbonl88070_p7" and sRet == "ok" then
	
		'발행어음 매수화면으로 이동
		Form.OpenPopup("mbonl88070_s1" , g_szSendData , "")
	end if
End Sub

