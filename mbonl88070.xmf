				szToDt		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "INVT_PRD_FIN_DYNU",		i)		'투자최대일수
				szRate		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "APLY_INRT",				i)		'수익률
