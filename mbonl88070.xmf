			end if

			Exit Sub
			
		elseif szBSDY_YN == "Y" and nTotalCsnu == 0  and nCnt == 0 then 'and g_COMN_PFIN_YN == "N" then 'v001. 전문투자자 조건 제거
	
			'모집상품 없는 경우 (평일인경우)
