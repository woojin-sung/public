' 그리드 이미지 세팅 타이머
Sub Form_OnTimerEvent(sTimerID)
	
	if Cint(sTimerID) = 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0)
		
		
		Dim nCnt, nGridCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, "obsap_deal_003r", "OutBlock1" ))
		nGridCnt = CInt(Container0.ContMain.grdData.rowcount)

		
'		Dim nHostDate, nHostTime
'		nHostDate = Form.GetSharedData( "&HOST_DATE", false )	'오늘날짜
'		nHostTime = CDBL(LEFT(Form.GetSharedData( "&HOST_TIME", false ),4))	'오늘시간(시분)
'
'		
'		for i = (nGridCnt - nCnt) to nGridCnt-1
'			dim tmpString
'			tmpString = ""
'			
'			sHOST_DATE = CDBL(Form.GetSharedData( "&HOST_DATE", false ))	'오늘
'			sRCRT_FIN_DATE = CDBL(Container0.ContMain.grdData.GetCellData("RCRT_FIN_DATE", i))	'모집만료일자
'			sRCRT_CLSN_HOUR = Container0.ContMain.grdData.GetCellData("RCRT_CLSN_HOUR", i)	'모집마감시간
'			sRMNN_WNCR_AMT = CDBL(Container0.ContMain.grdData.GetCellData("RMNN_WNCR_AMT", i))	'잔여한도
'
'			if sRMNN_WNCR_AMT < 100000000  then	'잔여수량(한도)이 1억 미만인 경우, 상품가입 불가하므로.. Sold Out으로 표시 & 잔여수량은 0으로 표기 & 매수 불가
'				sRMNN_WNCR_AMT = 0
'			
'				Container0.ContMain.grdData.SetCellImage("badge2", i, "icon_clock.png")
'			
'			elseif sRCRT_FIN_DATE == sHOST_DATE then
'				tmpString = Left(sRCRT_CLSN_HOUR,2)..":".. Mid(sRCRT_CLSN_HOUR,3,2)
'				tmpTime = LEFT(sRCRT_CLSN_HOUR, 4)
'
'				if int(nHostTime) > int(tmpTime)  then
'					Container0.ContMain.grdData.SetCellImage("badge2", i, "icon_clock.png")
'
'				elseif int(nHostTime) == int(tmpTime)  then
'					Container0.ContMain.grdData.SetCellImage("badge2", i, "icon_clock.png")
''					
'				else						
'					Container0.ContMain.grdData.SetCellImage("badge2", i, "icon_clock_highlight.png")
'
'				end if
'
'			elseif sRCRT_FIN_DATE < sHOST_DATE  then	
'				Container0.ContMain.grdData.SetCellImage("badge2", i, "icon_clock.png")
''					
'			elseif sRCRT_FIN_DATE <> null and Trim(sRCRT_FIN_DATE) <> "" then
'				
'				Container0.ContMain.grdData.SetCellImage("badge2", i, "icon_clock.png")
'			end if
'			
'		next
		
		if DATAMANAGER.IsMoreNextData("obsap_deal_003r") == true then
			DATAMANAGER.RequestNextData("obsap_deal_003r")
		end if
		
		
	elseif Cint(sTimerID) = 2 then
		Form.SetTimerEvent2(2, 0, 1)
'		DATAMANAGER.RequestTranData( "obsap_deal_003r" )	'장외_전단채모집관리매수가능종목조회
		
		DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
	
	elseif Cint(sTimerID) == 3 then
		Form.SetTimerEvent2(3, 0, 0.5)
		
		Container1.FormTab0.currenttab = 0
	end if 
	
End Sub

