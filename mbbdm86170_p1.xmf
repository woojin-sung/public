'--===========================================================================
' 작성 : 2021.02.17. 장원혁
' 2023.07.03 : 양현정 : v0001 : 비대면전용->기존고객용으로 수정함.
'--===========================================================================
Dim g_RCNO_PIP
Dim isValid     '투자성향만료여부
Dim g_ProsDate  '투자성향진단등록일자
    g_ProsDate = 0
Dim CurrentGrade
Dim LastGrade
Dim CloseValue

Dim g_BDM_YN	'v0001
Dim g_BDM_EXSN_CUST_YN 'v0001
Dim g_ACNO    'v0001

'============================================================================
Sub Form_OnFormInit()
	
    g_RCNO_PIP = Form.GetSharedData("BDM_RCNO_PIP", False )
    
    'v0001 sta
    g_BDM_YN = Form.GetSharedData("BDM_YN"     , false)
    g_BDM_EXSN_CUST_YN   = Form.GetSharedData("BDM_EXSN_CUST_YN"  , False )  'Y.기존고객 N.신규고객
     
    if len(trim(g_BDM_YN)) <= 0 THEN
	    g_BDM_YN = "Y"	
    end if
    
    if g_BDM_EXSN_CUST_YN == "Y" and g_BDM_YN == "N" then
		g_ACNO  = Form.GetSharedData("BDM_CUST_ACNO"    , False)    
    end if     
    'v0001 fin
    
    'v0001
    if g_BDM_YN == "N" then
	    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "ACNO"           , 0,  g_ACNO  )
	    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_PIP"       , 0,  g_RCNO_PIP)  
    else
	    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO"           , 0, "NMET"   )
	    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_PIP"       , 0,  g_RCNO_PIP)
	    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_TYPE_CODE" , 0, "01"     )
    end if
    
    DATAMANAGER.RequestTranData("obcsb_acif_701r")       
    
    'DATAMANAGER.SetDataValue(0 , "obcsb_acif_801r" , "InBlock1" , "RCNO_PIP" , 0 , g_RCNO_PIP)
    'DATAMANAGER.RequestTranData("obcsb_acif_801r")
	
	Container.ImgClose.visible = false
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    'If szTranID == "obcsb_acif_801r" Then
     
    'End If

    If szTranID == "obcsb_acif_701r" Then
        	
        szMtrtDate   = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_VALD_PRD_MTRT_DATE" , 0)	
        If szMtrtDate < Today.caption Then '만기가 지났으면
            isValid = 0 '만료
        Else '만기가 안지났으면
            isValid = 1
        End If
	
        '투자성향 최근등록일
        g_ProsDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "PROS_DATE" , 0)
        If g_ProsDate == "" Or g_ProsDate == null Then
            g_ProsDate = "00000000"
        End If 
	
        szInvGradeIn = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		
	    '	[KYC투자성향등급코드]
	    '	00@정보미제공
	    '	01@고수익지향형
	    '	02@성장지향형
	    '	03@중립형
	    '	04@안정지향형
	    '	05@이자소득형	
        If szInvGradeIn == "01" Then
            CurrentGrade = 1
            LastGrade = 1
        ElseIf szInvGradeIn == "02" Then
            CurrentGrade = 2
            LastGrade = 2
        ElseIf szInvGradeIn == "03" Then
            CurrentGrade = 3
            LastGrade = 3
        ElseIf szInvGradeIn == "04" Then
            CurrentGrade = 4
            LastGrade = 4
        ElseIf szInvGradeIn == "05" Then
            CurrentGrade = 5
            LastGrade = 5
        Else  '정보미제공
            CurrentGrade = 0
            LastGrade = 0
        End If
	    
	    ScreenSet()
	    
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(szSubMsg) == "" Then
        Form.MsgBox("알림" , szErrMsg, "", 6)
    Else
        Form.MsgBox("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" , "", 6)
    End If	
	
End Sub

'============================================================================
Sub ScreenSet()
    Dim szDate
	nDev = Form.GetSharedData("&SERVER_MODE", 0 )
	
	if nDev == "1" then
		szDate = "20210913"
	Else
		szDate = "20210925"
	end if
    
    If isValid == 0 Or (isValid == 1 And CInt(g_ProsDate) < CDbl(szDate) ) Then '기존 투자성향 만료, '금융소비자보호법 제정(2021.09.25~ 적용)이전 등록분은 새로진단만 가능
        If isValid == 0 Then
            Container.LblExpr1.caption = "고객님의 투자성향 유효기간이\n만료되었습니다."
        Else
            Container.LblExpr1.caption = "금융소비자보호법 제정(2021.09.25)에 따라\n고객님의 투자성향 재진단이 필요합니다."
        End If
   
        Container.ImgExpr.visible = True
        Container.LblExpr1.visible = True	
        Container.LblExpr2.visible = True		
        Container.LblExpr3.visible = True			
        Container.LblExpr4.visible = True	
        BtnCnfr.visible = True

        If LastGrade == 1 Then
            Container.LblExpr3.caption = "고수익지향형"
        ElseIf LastGrade == 2 Then
            Container.LblExpr3.caption = "성장지향형"            
        ElseIf LastGrade == 3 Then
            Container.LblExpr3.caption = "중립형"
        ElseIf LastGrade == 4 Then
            Container.LblExpr3.caption = "안정지향형"
        ElseIf LastGrade == 5 Then
            Container.LblExpr3.caption = "이자소득형"
        ElseIf LastGrade == 0 Then
            Container.LblExpr3.caption = "정보미제공"
        End If	    
	
        Container.ImgValid.visible = False
        Container.LblValid1.visible = False
        Container.LblValid2.visible = False
        Container.LblValid3.visible = False	
        BtnNew.visible = False
'        BtnCont.visible = False	
    
    Else '투자성향 유효
    
        Container.ImgValid.visible = True
        Container.LblValid1.visible = True
        Container.LblValid2.visible = True
        Container.LblValid3.visible = True
        BtnNew.visible = True
'        BtnCont.visible = True
				
        If CurrentGrade == 1 Then
            Container.LblValid2.caption = "고수익지향형"
            Container.ImgValid.imgpath = "icon_invest_grade_5.png"
        ElseIf CurrentGrade == 2 Then
            Container.LblValid2.caption = "성장지향형"
            Container.ImgValid.imgpath = "icon_invest_grade_4.png"	    
        ElseIf CurrentGrade == 3 Then
            Container.LblValid2.caption = "중립형"
            Container.ImgValid.imgpath = "icon_invest_grade_3.png"
        ElseIf CurrentGrade == 4 Then
            Container.LblValid2.caption = "안정지향형"
            Container.ImgValid.imgpath = "icon_invest_grade_2.png"	    
        ElseIf CurrentGrade == 5 Then
            Container.LblValid2.caption = "이자소득형"
            Container.ImgValid.imgpath = "icon_invest_grade_1.png"
        ElseIf CurrentGrade == 0 Then
            Container.LblValid2.caption = "정보미제공"
        End If
		
        Container.ImgExpr.visible = False
	   If CurrentGrade == 0 Then  '정보미제공인경우, 
            Container.ImgExpr.visible = True
            Container.ImgValid.visible = False
	   End If
        Container.LblExpr1.visible = False
        Container.LblExpr2.visible = False		
        Container.LblExpr3.visible = False			
        Container.LblExpr4.visible = False	
        BtnCnfr.visible = False
	
    End If

End Sub

'============================================================================
Sub ImgBg_OnClick()
    Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormBackKeyPressed()  '안드로이드전용
    ImgBg_OnClick()
End Sub

'============================================================================
Sub Container_ImgClose_OnClick()
    Form.CloseForm()	
End Sub

'============================================================================
Sub BtnNew_OnClick()
    CloseValue = 0 '신규 또는 정보변경
    Form.CloseForm()	
End Sub

'============================================================================
Sub BtnCont_OnClick()
    CloseValue = 1 '기존정보와 동일
    Form.CloseForm()	
End Sub

'============================================================================
Sub BtnCnfr_OnClick()
    CloseValue = 0 '신규 또는 정보변경
    Form.CloseForm()	
End Sub

'============================================================================
Sub Form_OnFormClose()
    Form.SendReturnToParent("MBBDM86170_P1" , CloseValue)
End Sub


