'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_basc_501r" then
		'서비스에서 MTS는 당일자로 변환함.
		DATAMANAGER.SetDataValue(0, "oblon_basc_501r", "InBlock1", "STND_DATE", 0, "")
	elseif szTranID == "oblon_basc_503r" then
		'서비스에서 MTS는 당일자로 변환함.
		DATAMANAGER.SetDataValue(0, "oblon_basc_503r", "InBlock1", "STND_DATE", 0, "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_501r" then
		tmpDate = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "APLY_STA_DATE", 0)
		tmpAplyRate1 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_APLY_MNRT1", 0)
		tmpAplyRate2 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_APLY_MNRT2", 0)
		tmpAplyRate3 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_APLY_MNRT3", 0)
		tmpAplyRate4 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_APLY_MNRT4", 0)
		tmpAplyRate5 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_APLY_MNRT5", 0)
		tmpAplyRate6 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_APLY_MNRT6", 0)
		tmpBsrt1     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_BSRT1", 0)
		tmpBsrt2     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_BSRT2", 0)
		tmpBsrt3     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_BSRT3", 0)
		tmpBsrt4     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_BSRT4", 0)
		tmpBsrt5     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_BSRT5", 0)
		tmpBsrt6     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_BSRT6", 0)
		tmpSprd1     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_SPRD1", 0)
		tmpSprd2     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_SPRD2", 0)
		tmpSprd3     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_SPRD3", 0)
		tmpSprd4     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_SPRD4", 0)
		tmpSprd5     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_SPRD5", 0)
		tmpSprd6     = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "UI_SPRD6", 0)
		
		szAplyRate1 = "연 "..FormatNumber(tmpAplyRate1,2).."%"
		szAplyRate2 = "연 "..FormatNumber(tmpAplyRate2,2).."%"
		szAplyRate3 = "연 "..FormatNumber(tmpAplyRate3,2).."%"
		szAplyRate4 = "연 "..FormatNumber(tmpAplyRate4,2).."%"
		szAplyRate5 = "연 "..FormatNumber(tmpAplyRate5,2).."%"
		szAplyRate6 = "연 "..FormatNumber(tmpAplyRate6,2).."%"
		
		szBsrt1 = "연 "..FormatNumber(tmpBsrt1,2).."%"
		szBsrt2 = "연 "..FormatNumber(tmpBsrt2,2).."%"
		szBsrt3 = "연 "..FormatNumber(tmpBsrt3,2).."%"
		szBsrt4 = "연 "..FormatNumber(tmpBsrt4,2).."%"
		szBsrt5 = "연 "..FormatNumber(tmpBsrt5,2).."%"
		szBsrt6 = "연 "..FormatNumber(tmpBsrt6,2).."%"
		
		szSprd1 = "연 "..FormatNumber(tmpSprd1,2).."%"
		szSprd2 = "연 "..FormatNumber(tmpSprd2,2).."%"
		szSprd3 = "연 "..FormatNumber(tmpSprd3,2).."%"
		szSprd4 = "연 "..FormatNumber(tmpSprd4,2).."%"
		szSprd5 = "연 "..FormatNumber(tmpSprd5,2).."%"
		szSprd6 = "연 "..FormatNumber(tmpSprd6,2).."%"
		
		contScroll.Container5.Table3.SetCellString(1, 1, szAplyRate1)
		contScroll.Container5.Table3.SetCellString(1, 2, szAplyRate2)
		contScroll.Container5.Table3.SetCellString(1, 3, szAplyRate3)
		contScroll.Container5.Table3.SetCellString(1, 4, szAplyRate4)
		contScroll.Container5.Table3.SetCellString(1, 5, szAplyRate5)
		contScroll.Container5.Table3.SetCellString(1, 6, szAplyRate6)
		
		contScroll.Container5.Table3.SetCellString(2, 1, szBsrt1)
		contScroll.Container5.Table3.SetCellString(2, 2, szBsrt2)
		contScroll.Container5.Table3.SetCellString(2, 3, szBsrt3)
		contScroll.Container5.Table3.SetCellString(2, 4, szBsrt4)
		contScroll.Container5.Table3.SetCellString(2, 5, szBsrt5)
		contScroll.Container5.Table3.SetCellString(2, 6, szBsrt6)
		
		contScroll.Container5.Table3.SetCellString(3, 1, szSprd1)
		contScroll.Container5.Table3.SetCellString(3, 2, szSprd2)
		contScroll.Container5.Table3.SetCellString(3, 3, szSprd3)
		contScroll.Container5.Table3.SetCellString(3, 4, szSprd4)
		contScroll.Container5.Table3.SetCellString(3, 5, szSprd5)
		contScroll.Container5.Table3.SetCellString(3, 6, szSprd6)
		
		contScroll.Container5.Table3.SetCellString(1, 7, tmpDate)

		
		'라벨 초기화
		contScroll.Container5.Label21.caption = ""
		'날짜 입력
		tmpYear = mid(tmpDate,3,2)
		tmpMon  = Cint(mid(tmpDate,5,2))
		tmpDay  = Cint(mid(tmpDate,7,2))
		
		'라벨 재조합
		contScroll.Container5.Label21.caption = "· 신용거래융자/대주 : 시행일 신규 매수/매도체결분부터 적용\n"..
										   "· 이자율은 기준금리+가산금리로 구성되며, 수시로 변경될 수 있습니다\n"..
										   "   - 기준금리 : 전전월 1개월 평균 CD수익률\n"..
										   "   - 가산금리 : 리스크 프리미엄, 신용 및 유동성 프리미엄, 제반 비용, 목표 이익률 등을 반영\n"
	elseif szTranID == "oblon_basc_503r" then
		tmpDate = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock1", "APLY_STA_DATE", 0)
		tmpAplyRate1 = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_APLY_MNRT1", 0)
		tmpAplyRate3 = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_APLY_MNRT3", 0)
		tmpAplyRate4 = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_APLY_MNRT4", 0)
		tmpBsrt1     = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_BSRT1", 0)
		tmpBsrt3     = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_BSRT3", 0)
		tmpBsrt4     = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_BSRT4", 0)
		tmpSprd1     = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_SPRD1", 0)
		tmpSprd3     = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_SPRD3", 0)
		tmpSprd4     = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock1", "UI_SPRD4", 0)
		
		szAplyRate1 = "연 "..FormatNumber(tmpAplyRate1,2).."%"
		szAplyRate3 = "연 "..FormatNumber(tmpAplyRate3,2).."%"
		szAplyRate4 = "연 "..FormatNumber(tmpAplyRate4,2).."%"
		
		szBsrt1 = "연 "..FormatNumber(tmpBsrt1,2).."%"
		szBsrt3 = "연 "..FormatNumber(tmpBsrt3,2).."%"
		szBsrt4 = "연 "..FormatNumber(tmpBsrt4,2).."%"
		
		szSprd1 = "연 "..FormatNumber(tmpSprd1,2).."%"
		szSprd3 = "연 "..FormatNumber(tmpSprd3,2).."%"
		szSprd4 = "연 "..FormatNumber(tmpSprd4,2).."%"
		
		contScroll.Container5.Table6.SetCellString(1, 1, szAplyRate1)
		contScroll.Container5.Table6.SetCellString(1, 2, szAplyRate3)
		contScroll.Container5.Table6.SetCellString(1, 3, szAplyRate4)
		
		contScroll.Container5.Table6.SetCellString(2, 1, szBsrt1)
		contScroll.Container5.Table6.SetCellString(2, 2, szBsrt3)
		contScroll.Container5.Table6.SetCellString(2, 3, szBsrt4)
		
		contScroll.Container5.Table6.SetCellString(3, 1, szSprd1)
		contScroll.Container5.Table6.SetCellString(3, 2, szSprd3)
		contScroll.Container5.Table6.SetCellString(3, 3, szSprd4)
		
		contScroll.Container5.Table6.SetCellString(1, 4, tmpDate)

	end if
End Sub

