	<SCRIPT_INFO _len="7977" _ulen="7709" >
'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 
' 04. 수    정 : 필수 동의서 열람 + 동의모두체크 : 다음 버튼 활성화
'
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bSilence
g_bSilence = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_ChangeBtnState() : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Function f_ChangeBtnState()
	if tonumber(rdoIdentiAgree.currentindex) == 0 and tonumber(rdoInfoAgree.currentindex) == 0 then
		g_bSilence = false
		chkAllAgree.checkstate = "1"
		imgCheck2.imgpath = "checkmenu_o.png"
	else
		chkAllAgree.checkstate = "0"
		imgCheck2.imgpath = "checkmenu_n.png"
	end if
	
	if tonumber(chkAgree.checkstate) == 1 and tonumber(chkAllAgree.checkstate) == 1  then
		Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", true)
		
	else
		Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
	end if
End Function
''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgCheck1.setMaintainingRatio("1")
	imgCheck2.setMaintainingRatio("1")
	
	imgProcess.setMaintainingRatio("1")
End Sub 

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	lblRedCheck.fgcolor = 265
	
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

	lblCtcnShow.caption = "필수동의서(요약/상세) 보기 >"
	
	chkAllAgree.chksilence = "0"
	
	imgCheck1.imgpath = "checkmenu_n.png"
	imgCheck2.imgpath = "checkmenu_n.png"
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "PREV_STEP" then
		Dim szChkStaSummary, szChkStaDetail
		
		szChkStaSummary = Form.GetSharedData( "mbonl94002_s1_CHECK_SUMMARY", false)
		szChkStaDetail = Form.GetSharedData( "mbonl94002_s1_CHECK_DETAIL", false)
		
		chkAgree.chksilence = "1"
		imgCheck1.imgpath = "checkmenu_o.png"
		
		chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl94004_s21" then
		if sRet == "ok_Mndt" then
			Form.SetSharedData("mbonl94004_s21_Agree", "Y")
				
			chkAgree.chksilence = "1"
			imgCheck1.imgpath = "checkmenu_o.png"
			
			f_ChangeBtnState()
		else
			Form.SetSharedData("mbonl94004_s21_Agree", "N")
			
			chkAgree.chksilence = "0"
			imgCheck1.imgpath = "checkmenu_n.png"
			
			f_ChangeBtnState() 
		end if
	end if
End Sub

'============================================================================
' chkAllAgree_OnChange(sCheckState) : 체크시 하단 동의 / 미동의로 모두 체크
'============================================================================
Sub chkAllAgree_OnChange(sCheckState)
	if g_bSilence == false then
		if tonumber(sCheckState) == 0 then
			rdoIdentiAgree.currentindex = "1"
			rdoInfoAgree.currentindex = "1"
			
		else
			rdoIdentiAgree.currentindex = "0"
			rdoInfoAgree.currentindex = "0"
		end if
		
		f_ChangeBtnState() 
	
	else
		g_bSilence = true
	end if
End Sub

'============================================================================
' rdoIdentiAgree_OnClick(nIndex) : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Sub rdoIdentiAgree_OnClick(nIndex)	
	if nIndex = 0 then
		imgidentiY.imgpath = "check_on.png"
		imgidentiN.imgpath = "check_off.png"
	else
		imgidentiY.imgpath = "check_off.png"
		imgidentiN.imgpath = "check_on.png"
	end if
	f_ChangeBtnState()
End Sub

'============================================================================
' rdoInfoAgree_OnClick(nIndex) : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Sub rdoInfoAgree_OnClick(nIndex)
	if nIndex = 0 then
		imgInfoY.imgpath = "check_on.png"
		imgInfoN.imgpath = "check_off.png"
	else
		imgInfoY.imgpath = "check_off.png"
		imgInfoN.imgpath = "check_on.png"
	end if
	f_ChangeBtnState()
End Sub

'============================================================================
' 동의서보기
'============================================================================
Sub lblCtcnShow_OnClick()

	Form.OpenPopup("mbonl94004_s21", "Mndt", "")
End Sub


