'End Sub

'============================================================================
Sub imgCheck2_OnClick()
	if CInt(chkAllAgree.checkstate) == 1 then
		f_SetCheckState(false)
	else
		f_SetCheckState(true)
	end if
End Sub

'============================================================================
Function f_SetCheckState(bValue)
	if bValue == true then
		chkAllAgree.chksilence = "1"
		imgCheck2.imgpath = "checkmenu_o.png"
		chkAllAgree_OnChange("1")
	else
		chkAllAgree.chksilence = "0"
		imgCheck2.imgpath = "checkmenu_n.png"
		chkAllAgree_OnChange("0")
	end if
End Function

'============================================================================
Sub lblCheckMsg_OnClick()
	imgCheck2_OnClick()
End Sub

'============================================================================
Sub lblidentiY_OnClick()
	rdoIdentiAgree.currentindex = 0
	rdoIdentiAgree_OnClick(0)	
End Sub

'============================================================================
Sub lblidentiN_OnClick()
	rdoIdentiAgree.currentindex = 1
	rdoIdentiAgree_OnClick(1)	
End Sub


'============================================================================
Sub lblInfoY_OnClick()
	rdoInfoAgree.currentindex = 0
	rdoInfoAgree_OnClick(0)	
End Sub

'============================================================================
Sub lblInfoN_OnClick()
	rdoInfoAgree.currentindex = 1
	rdoInfoAgree_OnClick(1)	
End Sub

'============================================================================
Sub imgidentiY_OnClick()
	lblidentiY_OnClick()
End Sub

'============================================================================
Sub imgidentiN_OnClick()
	lblidentiN_OnClick()
End Sub

'============================================================================
Sub imgInfoY_OnClick()
	lblInfoY_OnClick()
End Sub

'============================================================================
Sub imgInfoN_OnClick()
	lblInfoN_OnClick()
End Sub

	</SCRIPT_INFO>
</ROOT>