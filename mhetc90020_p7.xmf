	<SCRIPT_INFO _len="13637" _ulen="11453" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 은행개설계좌 ID등록_부가정보 입력
' 02. 화면설명 :
' 03. 작    성 : 2016.03.07 김은숙
' 04. 수    정 : 2017.03.30 윤유정 : IO변경에 따른 서비스 재적용(계좌비밀번호 inblock 추가)  v0001
'		      : 2018.09.10 김유경 : 은행개설계좌 ID 등록시 개인신용정보제공동의 위치 변경 - 현재화면에서 obcsb_acif_557a 콜 주석처리 v0002
'			  현재: *개인신용정보 제공동의(A)(단말에 저장)>ID등록정보 입력(B)>필수정보입력(C)>부가질문 입력(D)>*개인신용정보 제공동의(E) 처리
'			  개선: ID등록정보 입력(B) 처리 직전에 *개인신용정보 제공동의(A) 처리 선행
'			  : 2019.03    성주혁 : CDD/EDD 추가, obcsb_efif_060a 호출안하고  mhetc90020_pg 에서 cdd/edd등록후 호출함 v0003
'			  : 2019.09.02 조승행 : 은행개설계좌 ID등록시 해외증권/파생 동의 데이터 추가 v0004
'			  : 2020.06.10 김유경 : 부가정보 sharedData 오류 수정 v0005
' 2020.10.27 : 권오상 : v006 : T2008250015 : 실명확인번호 암호화 처리'
' 2021.04.29 : 정민영 : v007 : 오입력 체크로직 추가
' 2021.05.27 : 정민영 : v008 : T2105070009 : 개인신용정보동의제도 개편안 반영
' 2023.12.21 : 전상일 : v009 : ID 등록 시 주문내역 존재 체크 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData		'Form Close시 리턴값("ok" / "cancel")
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array

'v0003
Dim g_sPopupFileName	'다음 버튼 클릭시 팝업화면 파일명
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달

'g_szList(0)  : "은행" / "지점"
'g_szList(1)  : [은행만 사용] 개인정보필수동의_수집/이용
'g_szList(2)  : [은행만 사용] 개인정보필수동의_조회
'g_szList(3)  : [은행만 사용] 개인정보필수동의_업무위탁
'g_szList(4)  : [은행만 사용] 개인정보필수동의_제공
'g_szList(5)  : [은행만 사용] 개인정보필수동의_고유식별정보의 처리
'g_szList(6)  : [은행만 사용] 개인정보필수동의_민감정보의 처리
'g_szList(7)	: [은행만 사용] 개인정보필수동의_해외증권/파생 자료 요청 처리 v0004
'g_szList(8)  : [은행/지점 공통] 필수정보입력_고객구분("1":내국인/"2":외국인/"3":법인)
'g_szList(9)  : [은행/지점 공통] 필수정보입력_고객식별번호
'g_szList(10)  : [은행/지점 공통] 필수정보입력_계좌번호
'g_szList(11) : [은행/지점 공통] 필수정보입력_계좌비밀번호
'g_szList(12) : [은행/지점 공통] 필수정보입력_사용자ID
'g_szList(13) : [은행/지점 공통] 필수정보입력_ID비밀번호
'g_szList(14) : [지점만 사용] 보안매체종류("0":보안카드/"3":OTP)

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "cancel"
	Form.SetScreenName("은행개설계좌 ID등록")

	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
End Sub

'============================================================================
'취소 버튼
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'다음 버튼
Sub btnOK_OnClick()

     'v007 MoveNextPage()에서 등록처리 하므로, 화면 넘어가기전 유효성 체크(한/영 비교하여 체크)
'v007 Sta    
'	if Len(edtAns0.caption) < 2 then
'		Form.MsgBox("알림", "부가정보답1 항목을 입력해 주세요.", 0, 6)
'		Exit Sub
'	end if
'
'	if Len(edtAns1.caption) < 2 then
'		Form.MsgBox("알림", "부가정보답2 항목을 입력해 주세요.", 0, 6)
'		Exit Sub
'	end if
'v007 Fin
    nLen = Len(Trim(edtAns0.caption))
    If CInt(nLen) == 0 Then
        Form.MsgBox("알림", "부가정보답1 항목을 입력해 주세요.", 0, 6)
        Exit Sub
    End If

    nChk = 0
    nEtc = 0
    chkStr = Trim(Replace(edtAns0.caption," ",""))   
    For i = 1 To nLen
        nAscii = Asc(Mid(chkStr, i, 1))

        'Mid() 1자리 끊었을때 3byte,2byte 다양하게 나옴_한글,특수기호 판단불가)
        '스페이스(32)제외 33~126까지는 1자리씩으로 체크됨	
        
        If (CInt(nAscii) >= 33 And CInt(nAscii) <= 126) Then
            nChk = nChk + 1
        Else
            nEtc = nEtc + 1
        End If
    Next

    If nEtc == 0 Then
        If nChk < 4 Then
            Form.MsgBox("알림", "부가정보답1 항목을 확인해 주세요.", 0, 6)
            Exit Sub
        End If
    ElseIf nChk == 0 Then
        If nEtc < 4 Then
            Form.MsgBox("알림", "부가정보답1 항목을 확인해 주세요.", 0, 6)
            Exit Sub
        End If
    End If

    nLen = Len(Trim(edtAns1.caption))
    If CInt(nLen) == 0 Then
        Form.MsgBox("알림", "부가정보답2 항목을 입력해 주세요.", 0, 6)
        Exit Sub
    End If

    nChk = 0
    nEtc = 0
    chkStr = Trim(Replace(edtAns1.caption," ",""))
    For i = 1 To nLen
        nAscii = Asc(Mid(chkStr, i, 1))

        'Mid() 1자리 끊었을때 3byte,2byte 다양하게 나옴_한글,특수기호 판단불가)
        '스페이스(32)제외 33~126까지는 1자리씩으로 체크됨	
        
        If (CInt(nAscii) >= 33 And CInt(nAscii) <= 126) Then
            nChk = nChk + 1
        Else
            nEtc = nEtc + 1
        End If
    Next

    If nEtc == 0 Then
        If nChk < 4 Then
            Form.MsgBox("알림", "부가정보답2 항목을 확인해 주세요.", 0, 6)
            Exit Sub
        End If
    ElseIf nChk == 0 Then
        If nEtc < 4 Then
            Form.MsgBox("알림", "부가정보답2 항목을 확인해 주세요.", 0, 6)
            Exit Sub
        End If
    End If

'	g_sSendData = g_sSendData + cmbQust0.caption + "★"
'	g_sSendData = g_sSendData + edtAns0.caption + "★"
'	g_sSendData = g_sSendData + cmbQust1.caption + "★"
'	g_sSendData = g_sSendData + cmbQust0.caption + "★"
	'v0005
	g_sSendData = g_sSendData + cmbQust0.cbkeydata + "★"
	g_sSendData = g_sSendData + edtAns0.caption + "★"
	g_sSendData = g_sSendData + cmbQust1.cbkeydata + "★"
	g_sSendData = g_sSendData + edtAns1.caption + "★"

	MoveNextPage() 'v0003
	'DATAMANAGER.RequestTranData("obcsb_efif_060a")	'ID 등록요청 > mbetc90020_pg cdd/edd 완료후 해당화면에서 처리
End Sub


'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mhetc90020_p7" , g_sRetData )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		g_sRetData = "ok"
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'필수동의서(공통)
	if szTranID == "obcsb_acif_557a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(10) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(11) )

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "UI_COMN_AGRM_YN1" , 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "UI_COMN_AGRM_YN2" , 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "UI_COMN_AGRM_YN3" , 0 , "Y" )
	end if

	'필수동의서(상품별)
	if szTranID == "obcsb_acif_557a_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(10) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(11) )

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN7" , 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN4" , 0 , g_szList(2) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN2" , 0 , g_szList(3) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN5" , 0 , g_szList(4) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN3" , 0 , g_szList(5) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN6" , 0 , g_szList(6) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "UI_PROD_AGRM_YN14" , 0 , g_szList(7) ) 'v0004
	end if

	'부가정보등록
	if szTranID == "obcsb_aaif_003a" then
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO" , 0 , g_szList(9) ) 'v006
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" , 0 , g_szList(9) ) 'v006
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(12) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" , 0 , g_szList(13) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(10) )
	end if

	'HTS 고객등록처리
	if szTranID == "obcsb_efif_060a" then
		DATAMANAGER.SetUserID("meritz")	'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(10) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(11) )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO" , 0 , g_szList(9) ) 'v006
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" , 0 , g_szList(8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(12) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" , 0 , g_szList(13) )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_efif_060a" then	'ID 등록요청
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SUCS_YN" , 0) == "Y" then
			DATAMANAGER.RequestTranData("obcsb_aaif_003a")	'부가정보 등록
		else
			Form.MsgBox( "알림", "ID등록이 실패하였습니다. 해당 영업점 또는 고객지원센터(1588-3400)로 문의 바랍니다.", "", 6 )
		end if
	end if

	if szTranID == "obcsb_aaif_003a" then	'부가정보 등록
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RSLT_CLS" , 0) == "0" then

			'v0002 주석처리
			'DATAMANAGER.RequestTranData("obcsb_acif_557a")	'고객신용정보관리(공통)
			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 6 )

		end if
	end if

	if szTranID == "obcsb_acif_557a" then	'고객신용정보관리(공통)
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RSLT_YN" , 0) == "Y" then
			DATAMANAGER.RequestTranData("obcsb_acif_557a_1")	'고객신용정보관리(상품별)
		else
			Form.MsgBox( "알림", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_RSLT_DTL_CNTT" , 0), "", 6 )
		end if
	end if

	if szTranID == "obcsb_acif_557a_1" then	'고객신용정보관리(상품별)
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RSLT_YN" , 0) == "Y" then
			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 6 )
		else
			Form.MsgBox( "알림", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_RSLT_DTL_CNTT" , 0), "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'v009
	if szTranID == "obcsb_efif_060a" and (szErrCode == 6049 or szErrCode == "6049") then	
		strSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox( "알림", szErrMsg.."\n("..strSubMsg..")\n".."주문 취소 후 다시 ID등록을 진행하시기 바랍니다.", "", 6 )
	else
		'v007 상세 오류메시지 표시 
	    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	    If Trim(strSubMsg) ~= null And Trim(strSubMsg) ~= "" Then
			Form.MsgBox( "알림", Trim(szErrMsg).."\n("..Trim(strSubMsg)..")", "", 0 )	
	    Else
			Form.MsgBox( "알림", szErrMsg, "", 0 )
	    End If
	end if
    
End Sub
'============================================================================

Sub MoveNextPage(sGubn)

	g_sPopupFileName = "mhetc90020_pg"
	Form.OpenFramePopup( g_sPopupFileName , g_sSendData , sPosInfo)
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == g_sPopupFileName then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
End Sub
