	<SCRIPT_INFO _len="18869" _ulen="18029" >
Dim gCompareItemCode1,gCompareItemCode2
Dim gCompareItemName1,gCompareItemName2
Dim gCompareItemMarket1,gCompareItemMarket2
Dim gCompareItemNation1,gCompareItemNation2
gCompareItemName1 = ""
gCompareItemName2 = ""
gCompareItemCode1 = ""
gCompareItemCode2 = ""
gCompareItemMarket1 = ""
gCompareItemMarket2 = ""
gCompareItemNation1 = ""
gCompareItemNation2 = ""

Dim gDateList1,gErtList1
Dim gDateList2,gErtList2
gDateList1,gErtList1 = ""
gDateList2,gErtList2 = ""

Dim gItemChartReqComplete1
Dim gItemChartReqComplete2
gItemChartReqComplete1 = false
gItemChartReqComplete2 = false

Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)
	Container0.Image0.setMaintainingRatio("1")

	Container0.LabelText.paddinginfo = "0,0,0,0"
	Container0.LabelItem1.paddinginfo = "0,0,0,0"
	Container0.LabelItem2.paddinginfo = "0,0,0,0"
	Container0.LabelText.sizeAutoFit()
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		'--------------------------------------------------------------
		'종목명 라벨
		'--------------------------------------------------------------
		Container0.LabelItemName1.fontsize = - Cint((gsLargeFontsize * 2))
		Container0.LabelItemName2.fontsize = - Cint((gsLargeFontsize * 2))
		
		'--------------------------------------------------------------
		'기준일자 라벨
		'--------------------------------------------------------------
		Container0.LabelItemStndDate1.fontsize = - Cint((gsLargeFontsize * 4))
		Container0.LabelItemStndDate2.fontsize = - Cint((gsLargeFontsize * 4))
	
	end if	
	
	Container0.LabelText.sizeAutoFit()
	Container0.LabelText.caption = "기간 수익률"
	
	Container0.LabelItem1.SetMaxLineCount(1)
	Container0.LabelItem2.SetMaxLineCount(1)
	
	Container0.Table0.SetCellMaxLineCount(0,0,2)
	Container0.Table0.SetCellMaxLineCount(0,2,2)
	
End Sub

'============================================================================
Sub Container0_LabelText_OnSizeAutoFit()

	if gOsType == "1" then
		nLeft = Form.calcUnResize(Container0.LabelText.left, "2")
		nWidth = Form.calcUnResize(Container0.LabelText.width, "2")
	else
		nLeft = Container0.LabelText.left
		nWidth = Container0.LabelText.width
	end if
	
	Container0.Image0.left = nLeft + nWidth + 8

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'Form.ShowAlert("[수익률]"..sEventName, sParam)
	
	if sEventName == "SEND_COMPARE_ITEM" then
	
		'종목명★시장구분코드★종목코드@종목명★시장구분코드★종목코드
		arrData = Split(sParam, "@")
		
		if #arrData > 1 then
		
			arrItem1 = Split(arrData(0),"★")
			arrItem2 = Split(arrData(1),"★")
		
			gCompareItemName1 = arrItem1(0)
			gCompareItemName2 = arrItem2(0)
		
			gCompareItemMarket1 = arrItem1(1)
			gCompareItemMarket2 = arrItem2(1)
		
			gCompareItemCode1 = arrItem1(2)
			gCompareItemCode2 = arrItem2(2)
		
			'차트 종목명 세팅
			Container0.LabelItem1.caption = gCompareItemName1
			Container0.LabelItem2.caption = gCompareItemName2
		
			'테이블 종목명 세팅
			Container0.LabelItemName1.paddinginfo = "0,0,0,0"
			Container0.LabelItemName2.paddinginfo = "0,0,0,0"
			Container0.LabelItemName1.SetMaxLineCount(2)
			Container0.LabelItemName2.SetMaxLineCount(2)
			Container0.LabelItemName1.caption = gCompareItemName1
			Container0.LabelItemName2.caption = gCompareItemName2
			
			'Container0.Table0.SetCellString(0, 0, gCompareItemName1)
			'Container0.Table0.SetCellString(0, 2, gCompareItemName2)
		
			'테이블 종목 기준일자 세팅
			Container0.LabelItemStndDate1.paddinginfo = "0,0,0,0"
			Container0.LabelItemStndDate2.paddinginfo = "0,0,0,0"
			
			if gOsType == "1" then
				Container0.LabelItemStndDate1.left = 27
				Container0.LabelItemStndDate2.left = 243
				
			end if
		
			'수익률 차트서비스 호출
			RequestChartData(gCompareItemCode1,gCompareItemCode2)
		
			'수익률 테이블서비스 호출
			RequestTableData(gCompareItemCode1,gCompareItemCode2)
			
		end if
	
	end if
End Sub


'============================================================================
Function RequestChartData(sItemCode1,sItemCode2)

	gDateList1 = ""
	gErtList1 = ""
	
	gDateList2 = ""
	gErtList2 = ""
	
	gItemChartReqComplete1 = false
	gItemChartReqComplete2 = false

	'----------------------------------------------------------------------
	'최근(1/3/6개월, 1/3년) 수익률 차트 데이터 조회
	'----------------------------------------------------------------------
	'FID_INPUT_SCTN_CLS_CODE => 최근 X개월 데이터 조회
	sPeriod = GetChartPeriod()
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , gCompareItemCode1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , gCompareItemMarket1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_DIV_CLS_CODE"		, 0 , "0")
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE"		, 0 , sPeriod)
		
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , gCompareItemCode2)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , gCompareItemMarket2)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_DIV_CLS_CODE"		, 0 , "0")
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_SCTN_CLS_CODE"		, 0 , sPeriod)
	
	DATAMANAGER.RequestTranData("ohhts_metf_008r")
	DATAMANAGER.RequestTranData("ohhts_metf_008r_1")
	 

End Function

'============================================================================
' 조회기간 가져오기
'============================================================================
Function GetChartPeriod()
	
	nIndex = Cint(Container0.RadioGroup0.currentindex)
	
	if nIndex == 0 then
		return "1"
	elseif nIndex == 1 then
		return "3"
	elseif nIndex == 2 then
		return "6"
	elseif nIndex == 3 then
		return "12"
	elseif nIndex == 4 then
		return "36"
	end if

End Function

'============================================================================
Function RequestTableData(sItemCode1,sItemCode2)

	'------------------------------------------------------------------------
	'최근 3년 수익률 테이블 데이터 조회(임시로 특정 종목만 조회)
	'------------------------------------------------------------------------
	DATAMANAGER.SetDataValue(0, "ohhts_metf_005r"		,"InBlock1"	,"FID_INPUT_OVRS_ISCD" 	, 0 , gCompareItemCode1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_005r"		,"InBlock1"	,"FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , gCompareItemMarket1)
		
	DATAMANAGER.SetDataValue(0, "ohhts_metf_005r_1"	,"InBlock1"	,"FID_INPUT_OVRS_ISCD" 	, 0 , gCompareItemCode2)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_005r_1"	,"InBlock1"	,"FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , gCompareItemMarket2)
	
	DATAMANAGER.RequestTranData("ohhts_metf_005r")
	DATAMANAGER.RequestTranData("ohhts_metf_005r_1")
	 

End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'------------------------------------------------------------------------
	' 첫번째 아이템 차트 데이터
	'------------------------------------------------------------------------
	if szTranID == "ohhts_metf_008r" then
	
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_008r", "OutBlock1")
		
		if nCnt > 0 then
			for i = 0 to nCnt - 1 
				
				sDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_008r", "OutBlock1", "FID_DATE" , i)
				sErt = CDbl(DATAMANAGER.GetDataValue(0, "ohhts_metf_008r", "OutBlock1", "FID_ERNN_RATE" , i))
				
				if gDateList1 == "" then
					gDateList1 = sDate
				else
					gDateList1 = sDate .. ";" .. gDateList1
				end if
				
				if gErtList1 == "" then
					gErtList1 = sErt
				else
					gErtList1 = sErt .. ";" .. gErtList1
				end if
					
			next
		end if
	
		gItemChartReqComplete1 = true
		SetChartData(gDateList1,gErtList1)
		
	'------------------------------------------------------------------------
	' 두번째 아이템 차트 데이터
	'------------------------------------------------------------------------
	elseif szTranID == "ohhts_metf_008r_1" then
	
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_008r_1", "OutBlock1")
		
		if nCnt > 0 then
			for i = 0 to nCnt - 1 
				
				sDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_008r_1", "OutBlock1", "FID_DATE" , i)
				sErt = CDbl(DATAMANAGER.GetDataValue(0, "ohhts_metf_008r_1", "OutBlock1", "FID_ERNN_RATE" , i))
				
				if gDateList2 == "" then
					gDateList2 = sDate
				else
					gDateList2 = sDate .. ";" .. gDateList2
				end if
				
				if gErtList2 == "" then
					gErtList2 = sErt
				else
					gErtList2 = sErt .. ";" .. gErtList2
				end if
					
			next
		end if
	
		gItemChartReqComplete2 = true
		SetChartData(gDateList2,gErtList2)
	
	'------------------------------------------------------------------------
	'(첫번째 아이템) 최근 3년간 수익률 테이블 데이터 세팅
	'------------------------------------------------------------------------
	elseif szTranID == "ohhts_metf_005r" then
	
		sRecentM1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r", "OutBlock1", "FID_M1_ERT" 		, 0)
		sRecentM3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r", "OutBlock1", "FID_M3_ERT" 		, 0)
		sRecentM6 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r", "OutBlock1", "FID_M6_ERT" 		, 0)
		sRecentY1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r", "OutBlock1", "FID_Y1_ERT" 		, 0)
		sRecentY3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r", "OutBlock1", "FID_Y3_ERT" 		, 0)
		sStndDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r", "OutBlock1", "FID_STND_DATE" 	, 0)
		
		sRecentM1 = CheckDataValid(sRecentM1)
		sRecentM3 = CheckDataValid(sRecentM3)
		sRecentM6 = CheckDataValid(sRecentM6)
		sRecentY1 = CheckDataValid(sRecentY1)
		sRecentY3 = CheckDataValid(sRecentY3)
		
		SetTableData(sRecentM1,1,0)
		SetTableData(sRecentM3,2,0)
		SetTableData(sRecentM6,3,0)
		SetTableData(sRecentY1,4,0)
		SetTableData(sRecentY3,5,0)
		
		nStndDateLen = Form.getLen(sStndDate)
	
		if nStndDateLen > 7 then
			Container0.LabelItemStndDate1.caption = sStndDate
		else
			Container0.LabelItemStndDate1.visible = false
			Container0.LabelItemName1.height = 48
		end if
		
		
		'Container0.Table0.SetCellString(1, 0, sRecentM1)
		'Container0.Table0.SetCellString(2, 0, sRecentM3)
		'Container0.Table0.SetCellString(3, 0, sRecentM6)
		'Container0.Table0.SetCellString(4, 0, sRecentY1)
		'Container0.Table0.SetCellString(5, 0, sRecentY3)
	
	'------------------------------------------------------------------------
	'(두번째 아이템) 최근 3년간 수익률 테이블 데이터 세팅
	'------------------------------------------------------------------------
	elseif szTranID == "ohhts_metf_005r_1" then
	
		sRecentM1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r_1", "OutBlock1", "FID_M1_ERT" 	, 0)
		sRecentM3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r_1", "OutBlock1", "FID_M3_ERT" 	, 0)
		sRecentM6 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r_1", "OutBlock1", "FID_M6_ERT" 	, 0)
		sRecentY1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r_1", "OutBlock1", "FID_Y1_ERT" 	, 0)
		sRecentY3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r_1", "OutBlock1", "FID_Y3_ERT" 	, 0)
		sStndDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_005r_1", "OutBlock1", "FID_STND_DATE" 	, 0)
		
		sRecentM1 = CheckDataValid(sRecentM1)
		sRecentM3 = CheckDataValid(sRecentM3)
		sRecentM6 = CheckDataValid(sRecentM6)
		sRecentY1 = CheckDataValid(sRecentY1)
		sRecentY3 = CheckDataValid(sRecentY3)
		
		SetTableData(sRecentM1,1,2)
		SetTableData(sRecentM3,2,2)
		SetTableData(sRecentM6,3,2)
		SetTableData(sRecentY1,4,2)
		SetTableData(sRecentY3,5,2)
		
		
		nStndDateLen = Form.getLen(sStndDate)
		
		if nStndDateLen > 7 then
			Container0.LabelItemStndDate2.caption = sStndDate
		else
			Container0.LabelItemStndDate2.visible = false
			Container0.LabelItemName2.height = 48
		end if
		
		'Container0.Table0.SetCellString(1, 2, sRecentM1)
		'Container0.Table0.SetCellString(2, 2, sRecentM3)
		'Container0.Table0.SetCellString(3, 2, sRecentM6)
		'Container0.Table0.SetCellString(4, 2, sRecentY1)
		'Container0.Table0.SetCellString(5, 2, sRecentY3)
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	

End Sub
'============================================================================
Function SetChartData(sDate,sData)
	'Dim gDateList1,gErtList1
	if gItemChartReqComplete1 and gItemChartReqComplete2 then
	
		'----------------------------------------
		' 종목명1,종목명2,차트유형,스케일유형
		'----------------------------------------
		sChartType = "ETF_Compare2"
		sScaleType = "L"
		Container0.ChartEx0.SetAccrueName(gCompareItemName1..","..gCompareItemName2..","..sChartType..","..sScaleType)
		
		'----------------------------------------
		' 데이터 자리 초기화
		'----------------------------------------
		'Container0.ChartEx0.SetAccrueData("initdata="..sData)
		
		if gErtList1 <> "" and gErtList2 <> "" then
			
			sLen1 = Form.getLen(gDateList1)
			sLen2 = Form.getLen(gDateList2)
			
			if sLen1 >= sLen2 then
				Container0.ChartEx0.SetAccrueData("initdata="..gErtList1)
			else
				Container0.ChartEx0.SetAccrueData("initdata="..gErtList2)
			end if 
		
		else
			
			if gErtList1 <> "" then
				Container0.ChartEx0.SetAccrueData("initdata="..gErtList1)
			else
				Container0.ChartEx0.SetAccrueData("initdata="..gErtList2)
			end if
		
		end if
		
		'----------------------------------------
		' 날짜 데이터
		'----------------------------------------
		'Container0.ChartEx0.SetAccrueData("자료일자="..sDate)
		
		if gDateList1 <> "" and gDateList2 <> "" then
			
			sLen1 = Form.getLen(gDateList1)
			sLen2 = Form.getLen(gDateList2)
			
			if sLen1 >= sLen2 then
				Container0.ChartEx0.SetAccrueData("자료일자="..gDateList1)
			else
				Container0.ChartEx0.SetAccrueData("자료일자="..gDateList2)
			end if 
		
		else
			
			if gDateList1 <> "" then
				Container0.ChartEx0.SetAccrueData("자료일자="..gDateList1)
			else
				Container0.ChartEx0.SetAccrueData("자료일자="..gDateList2)
			end if
		
		end if
		
		'----------------------------------------
		' 차트 데이터
		'----------------------------------------
		if gErtList1 <> "" then
			Container0.ChartEx0.SetAccrueData("data1="..gErtList1.."=2")
		end if
		
		if gErtList2 <> "" then
			Container0.ChartEx0.SetAccrueData("data2="..gErtList2.."=2")
		end if
		
		'----------------------------------------
		' 차트데이터 두종목 모두 빈값일 시
		'----------------------------------------
		if gErtList1 == "" and gErtList2 == "" then
			
			Container0.LabelItemColor1.visible = false
			Container0.LabelItemColor2.visible = false
			Container0.LabelItem1.visible = false
			Container0.LabelItem2.visible = false
			Container0.RadioGroup0.visible = false
			
			Container0.ChartEx0.visible = false
			Container0.imgNotice1.visible = true
			Container0.LabelGuideText1.visible = true
			
		else

			Container0.LabelItemColor1.visible = true
			Container0.LabelItemColor2.visible = true
			Container0.LabelItem1.visible = true
			Container0.LabelItem2.visible = true
			Container0.ChartEx0.visible = true
			Container0.RadioGroup0.visible = true
			
			Container0.imgNotice1.visible = false
			Container0.LabelGuideText1.visible = false
			
		end if
		
		'----------------------------------------
		' 차트 그리기
		'----------------------------------------
		Container0.ChartEx0.SetAccrueData("repaintall")
		
		'----------------------------------------
		'라인색 설정
		'----------------------------------------
		Container0.ChartEx0.SetLineColor(gCompareItemName1..";".."117;147;226")
		Container0.ChartEx0.SetLineColor(gCompareItemName2..";".."219;161;012")
		
		
	end if

End Function

'============================================================================
' 데이터 없는 경우 - 처리
'============================================================================
Function CheckDataValid(sData)
	if sData == "" then
		return "-"
	else
		return sData
	end if
End Function

'============================================================================
' 데이터 없는 경우 - 처리
'============================================================================
Function SetTableData(sData,nRow,nCol)
	
	if sData == "-" then
		sMask = "1,0,,,0,,0,0,0"
		Container0.Table0.SetCellMaskInfo(nRow, nCol, sMask)
		Container0.Table0.SetCellString(nRow, nCol, sData)
	
	else
		Container0.Table0.SetCellString(nRow, nCol, sData)
	end if
	
End Function

'============================================================================
' 조회기간 변경
'============================================================================
Sub Container0_RadioGroup0_OnClick(nIndex)
	RequestChartData(gCompareItemCode1,gCompareItemCode2)
End Sub

'============================================================================
' 툴팁 생성
'============================================================================
Sub Container0_Image0_OnClick()

	Container0.Image0.ToolTipBringFront(true)

	sText = 	"수익률 조회 기준 (NAV 기준)\n"..
			"- 분배금 재투자를 가정한 세전 수익률로\n"..
			"   전 영업일 기준으로 제공돼요.\n"..
			"- 단, 운용사별 제공되는 시점이 상이하므로\n"..
			"  제공되는 최종 기준일은 다를 수 있어요."
			
	sLen = Form.getLen(sText)
	
	if gbLargeFont then
		
		if gOsType == "1" then
			nApplyTextsize = - Cint((gsLargeFontsize * 2))
		else
			nApplyTextsize = - Cint((gsLargeFontsize * 3))
		end if
		
		Container0.Image0.openToolTip(sText, 310, 120, 0)
		Container0.Image0.changeToolTipTextAttr(0, sLen, 338, nApplyTextsize, false)
	else
		Container0.Image0.openToolTip(sText, 290, 120, 0)
		Container0.Image0.changeToolTipTextAttr(0, sLen, 338, -3, false)
	end if
	
End Sub

'============================================================================
Sub Container0_LabelText_OnClick()
	Container0_Image0_OnClick()
End Sub

