'============================================================================
' 화 면 명 : 사이드종목_관심종목_스타일1
' 화면설명 : 사이드종목_관심종목_스타일1
' 작    성 : 2016.02.19 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' 관심그룹 Key
Dim g_szGSID 
g_szGSID = ""

' 현재가/예상가/단일가 구분
Dim g_szRSelect
g_szRSelect = "0"

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
DIm g_szMove
g_szMove = "0"

' 화면에서 종목추가위해 선택관심그룹명 필요
Dim g_GrpName

' 20160126 선택팝업관련 추가사항
Dim g_szSltCd, szMk


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' init_GWList :  관심그룹의 종목 재설정 (로컬/서버)
'============================================================================
Function init_GWList()
	DATAMANAGER.RequestTranData("ohhts_intr_037r")
End Function

'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	
	For i = 0 to grdCode.rowcount-1
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
			end if
	
			For j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
				end if
			Next		
		end if
	Next

	if CInt(grdCode.rowcount) > 0 then
		' 관심종목 데이터조회
		DATAMANAGER.RequestTranData( "ohhts_1030_001r" )
	end if
End Function


'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	' 2018.01.02 CJH JF, JO 추가
	Select Case szMk
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
		Case Else
			return ""
	End Select
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	if sEventName == "GW_LIST" then
		if sParam <> "" then
			tData = Split(sParam, "♥")
			
			g_szGSID = tData[0]
			edtvrsnID.caption = tData[1]
			
			DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 실시간 해제
			
			For j = 0 to grdMk.rowcount - 1
				szCd = Trim(grdMk.GetCellData("bd_code", j))
				szMk = Trim(grdMk.GetCellData("bd_mk",   j))
				
				if szCd <> "" and szMk <> "" then
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, szCd)
					DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , j , szCd)
				end if
			Next
			
			' /////////////////////////////////////////////////////////////////
			
			grdList0.rowcount = 0
			grdCode.rowcount = 0
			grdMk.rowcount = 0
			
	
			' 실시간 하이라이트 표시
'			grdList0.highlightuse = "0"
'				
'			if Form.GetEnvData("GW_RORDER") == "1" then
'				Form.SetCtlProp("grdList" & g_szRSelect , "highlightuse", "1")
'			end if
	
			' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
			'g_szMove = Form.GetEnvData("GW_MOVE") 임시막기
			
			' 관심그룹의 종목을 재설정
			init_GWList()			
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_037r" then
		grdCode.rowcount = "0"
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_KIND_CODE",         0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)								' 관심그룹ID	
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1030_001r" then
		grdList0.rowcount = "0"		' 종목조회그리드 초기화
		DATAMANAGER.ClearInputData( false, "ohhts_1030_001r" )
		For i = 0 to grdCode.rowcount-1
			szMk = grdCode.GetCellData("bd_mk", i)
			szCd = Trim(grdCode.GetCellData("bd_code", i))
			tCode = {}
			
			' MTS에서 보여주는 상품의 종목만 선택
			szMk = f_ChkMarket(szMk, szCd)
			
			DATAMANAGER.SetDataValue( false, "ohhts_1030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i , "OV" ) '해외주식			
			DATAMANAGER.SetDataValue( false, "ohhts_1030_001r", "InBlock1", "FID_INPUT_OVRS_ISCD", i , szCd ) ' 종목코드
			DATAMANAGER.SetDataValue( false, "ohhts_1030_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE", i , szMk ) '종목시장
			' 시장별 실시간여부값
			szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
			DATAMANAGER.SetDataValue( false, "ohhts_1030_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", i , szRealAble ) '실시간여부
		Next
	' ----------------------------------------------------------------------
	' 종목메모 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_memo_003r" then
		DATAMANAGER.ClearInputData(0, "ohhts_memo_003r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_memo_003r", "InBlock1", "FID_USER_ID"           , 0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_memo_003r", "InBlock1", "FID_MEMO_MANG_CLS_CODE", 0, "2")								' FID메모관리구분코드(1일반메모, 2종목메모)
		DATAMANAGER.SetDataValue(0, "ohhts_memo_003r", "InBlock1", "FID_INPUT_SLCT_YN"     , 0, "1")								' FID입력선택여부(1검색, 2전체검색, 3추가, 4수정, 5삭제, 9전체삭제)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	''''''''''''''''''	
	' ----------------------------------------------------------------------
	' 관심종목 종목조회
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_intr_037r"then
		nRow = grdCode.rowcount
		Dim szName, tCode, szMk
		tCode = {}
		szMk = ""
		szName = ""
		For i = 0 to nRow - 1 
			szCode = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			if Trim(szCode) <> "" then				
				szName = Form.GetItemCodeInfo(szCode, "name")
			end if
			grdCode.SetCellData("bd_name", i, szName)	' 20160325 위젯위해 종목명 추가
		Next
		
		' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("#edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk()	
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1030_001r" then
		Dim tItemData, nIndex, sCellBong, szMk, szKormarket
		szKormarket = ""
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")
		
		grdlist0.SetClear()
		

		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1030_001r", "OutBlock1" ) )
		grdlist0.rowcount = nCount
		
		Dim nRequestCount
		nRequestCount = 0
		For i = 0 to grdCode.rowcount - 1
			
			szMm = grdCode.GetCellData("bd_memo", i)
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)

			Dim tCode
			if Trim(szMm) <> "" then
				grdList0.SetPropGridCell("memo", "bd_code", i, szMm)
			end if	

			For j = 0 to nCount-1
				code = DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_ISCD" , j ) 
				if Null <> code and code == szCd then
'					
					if szMk == "AX" then
						szKormarket = "아멕스"
					elseif szMk == "HK" then
						szKormarket = "홍콩"
					elseif szMk == "JP" then
						szKormarket = "도쿄"
					elseif szMk == "SZ" then
						szKormarket = "심천"
					elseif szMk == "SH" then
						szKormarket = "상해"
					elseif szMk == "NY" then
						szKormarket = "뉴욕"
					elseif szMk == "OQ" then
						szKormarket = "나스닥"
					end if
					
					'code			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "code" , j )
					symbol		= szMk
					korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
					sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_001r", "OutBlock1", "FIDX_PRPR", j )
					'sign			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "sign" , j )
					diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_PRDY_VRSS" , j )
					bd_debiIcon	= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , j )					
					rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_PRDY_CTRT" , j )
					tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_ACML_VOL" , j )
					'isvalid		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "isvalid" , j )
					sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_001r", "OutBlock1", "FIDX_DCPN_CNT", j )
					'market		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "market" , j )
					'orgcode		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "orgcode" , j )
					'accessibility	= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "accessibility" , j )
	'				realcode		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "realcode" , j )
					open			= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_OPRC" , j )
					high			= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_HPRC", j )
					low			= DATAMANAGER.GetDataValue( false, "ohhts_1030_001r", "OutBlock1", "FIDX_LPRC", j )
					'pbid			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "pbid" , j )
					'pask			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "pask" , j )
					
					
					sCellBong  = "|" & open & "|" & high & "|" & low & "|" & sclose

					grdlist0.SetCellData( "bd_code" , j, szMk&"@"&szCd )
					grdlist0.SetCellData( "bd_name" , j, korname )
					grdlist0.SetCellData( "bd_hyun" , j, Decimal_Setting( sclose , sdecimal ) )
					grdlist0.SetCellData( "bd_debi" , j, bd_debiIcon&"|"&Decimal_Setting( diff , sdecimal ) )
					grdlist0.SetCellData( "bd_codeSub" , j, szCd )
					grdlist0.SetCellData( "bd_mk" , j, szKormarket )
					grdlist0.SetCellData( "bd_vol" , j, tvol )
					grdlist0.SetCellData( "bd_rate" , j, rate )
					grdlist0.SetCellData( "bd_bong" , j, sCellBong )
					grdlist0.SetCellData( "bd_decimal", j, sdecimal )
					grdlist0.SetCellData( "bd_symbol", j, symbol )
					grdlist0.SetCellData( "bd_market", j, szMk )
'					
					swapItemColor( j, CDbl(diff))
					DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount , szMk&"@"&szCd)
					nRequestCount = nRequestCount + 1
				end if
			Next
		Next
		grdList0.keyall = "1"
		DATAMANAGER.RequestRealData("ohhts_exst_ictg")
	end if
End Sub

'============================================================================
' 입력값조절
'============================================================================
Sub Decimal_Setting(sValue, sDecimalLen)
	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Sub

'============================================================================
' 2017.11.22 -  LSS : 종목 대비값에 따른 색상 및 대비부호 설정
'============================================================================
Function swapItemColor(nIndex, nDiff)
	grdlist0.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist0.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist0.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
End Function
	
'============================================================================
' grdList0_OnClickUp : 현재가 그리드 클릭
'============================================================================
Sub grdList0_OnClickUp(lRow, szCellID)
	szItemCode = grdList0.GetCellData("bd_code", lRow)
	szName = grdList0.GetCellData("bd_name", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if
	
	Form.SetSharedData( "&ITEM_OVERSTOCK" , szItemCode & "★" & szName & "★" & "" )		
	Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCode & "★" & szName & "★" & "", "" )
	
	Form.triggerEvent("#", "CLOSE_FORM", "")
End Sub

