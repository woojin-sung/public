'============================================================================
' 위탁증거금 등급 변경	
' V001 2024-01-12 양현정 : 미성년자체크 추가..
'============================================================================

Dim g_nAccountNumber	'계좌번호 8글자 ex)18431988
Dim g_nAccountSerialNumber	'계좌 일련번호 2글자 ex)01

Dim g_plain_rm  		'v0002 메모리평문적용여부

'256r 조회결과 담기
Dim sCOMN_YN1
Dim sCOMN_YN2
Dim sPROD_YN1
Dim sPROD_YN2
Dim sPROD_YN3
Dim sPROD_YN4
Dim sPROD_YN5
Dim sPROD_YN6
Dim sPROD_YN7
Dim sPROD_YN8
Dim sPROD_YN9
Dim sPROD_YN10
Dim sPROD_YN11
Dim sPROD_YN12
Dim sPROD_YN13

Dim g_MARG_GRAD_CODE, g_MARG_GRAD_CODE_NAME	'현재 사용중인 증거금
Dim g_CHG_MARG_GRAD_CODE	'변경할 증거금

Dim g_Answer
Dim unCheckImgPath 
Dim CheckImgPath

Dim g_Status	'개인(신용)정보처리대상이 "100% 징수 (수수료 포함)" 선택한 경우 : P0
			'개인(신용)정보처리대상이 "100% 징수 (수수료 포함)" 이외 선택한 경우 : P1

Dim gMnrYn 'V001 미성년자여부

'============================================================================
Sub Form_OnFormInitBefore()

	Image0.setMaintainingRatio("1")
	
	ImgQ1A0.SetMaintainingRatio("1")
	ImgQ1A1.SetMaintainingRatio("1")
	ImgQ1A2.SetMaintainingRatio("1")

	'contInfo.lblInfo0.changeTextAttr(8, 1, szFontColor, -3, true)
	LblQ1A0.changeTextAttr(8, 8, 4, -1, false)
	LblQ1A1.changeTextAttr(8, 9, 4, -1, false)
	LblQ1A2.changeTextAttr(7, 18, 4, -1, false)
	

	'텍스트와 이미지 컨트롤간 간격조정
	Label2.setNeighborCtlPos("Image0", "right", 5, "")
	LblQ1A0.setNeighborCtlPos("ImgQ1A0", "left", 10, "")
	LblQ1A1.setNeighborCtlPos("ImgQ1A1", "left", 10, "")
	LblQ1A2.setNeighborCtlPos("ImgQ1A2", "left", 10, "")

End Sub

'============================================================================
Sub Form_OnFormInit()
	lblNoData.visible = 1
	btnOk.enable = 0

	'계좌 체크
	if cmbAccount.caption <> "" and cmbAccount.caption <> null then 
		Setinit()
		ClearCheckAnswer()
		
		DATAMANAGER.RequestTranData("obacp_comm_008r")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'===============================================
	'********** 개읹신용정보처리 필수 동의 팝업 리턴  ***********
	'===============================================		
	If sKeyName = "mbonl87060_p1" Then
		if sRet == "ok" then
			Dim sSendData
			sSendData = g_nAccountNumber&g_nAccountSerialNumber&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
		
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	Elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)

				if g_Status == "P0" or g_Status == "P1" then
					DATAMANAGER.RequestTranData("obaci_acct_256a")	'신용정보동의처리
				else
					DATAMANAGER.RequestTranData("obaci_acct_029a")	'증거금 변경
				end if
			end if
		end if
		
	'===============================================
	'********** 신청 등록완료 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbonl87060_p2"  Then 	
		if sRet == "close" then
			Form.CloseForm()
		end if
	End if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항 아이콘 클릭 이벤트
	if sEventName == "INFO_CLICK" then 
		Form.OpenPopup("mbonl87060_p4", "", "")
	end if
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	lblNoData.visible = 1
	
	Setinit()
	ClearCheckAnswer()
	
	DATAMANAGER.RequestTranData("obacp_comm_008r")
End Sub

'============================================================================
Sub Setinit()
	lblNoData.visible = 0
	btnOk.enable = 0
	
	g_nAccountNumber = cmbAccount.total 
	g_nAccountSerialNumber = cmbAccount.sequence
	
	unCheckImgPath = "checkmenu_n.png"
	CheckImgPath   = "checkmenu_o.png"
	
	for j = 0 to 2
		Form.SetCtlProp("LblQ1A" & j, "fontstyle", "00")	'폰트굵기 초기화
	next
	
	'MTS메모리평문 적용유무
	'g_plain_rm = ( 0 : 미적용 / 1 : 적용 )
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	g_Status = ""
	gMnrYn = "N" 'V001
End Sub

'============================================================================
Sub btnOk_OnClick()
	'미수발생가능한 유형의 증거금 변경시, 개인(신용)정보 필수동의 미동의 고객에 한해 동의 화면 생성
'	if g_Answer == "1" or g_Answer == "2" then
		'신용정보동의내역 조회
		DATAMANAGER.RequestTranData("obaci_acct_256r")
'	else
'		Dim sSendData
'		sSendData = cmbAccount.total&cmbAccount.sequence&"☆"&"0"
'		'비밀번호 팝업 띄움..	
'		Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
'	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
     if szTranID == "obacp_comm_008r" then		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",     0, g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",     0, g_nAccountSerialNumber)


	elseif szTranID == "obaci_acct_256r" then	'신용정보동의내역 조회	(계좌비번 체크 안함)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_nAccountNumber)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"           , 0 , g_nAccountSerialNumber)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"  , 0 , "A")	


	elseif szTranID == "obaci_acct_256a" then	'신용정보동의처리	(계좌비번 체크 함)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE"  , 0 , "4")	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_nAccountNumber)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"           , 0 , g_nAccountSerialNumber)	
		'MTS메모리평문 적용상태일때
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, edtPassword.caption)
		
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, edtPassword.encdata)
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "1")		'1:등록
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AGRM_RQCL_DOCU_CLCD"  , 0 , "3")		'3:요약+상세
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD"  , 0 , "998")	'998:온라인고객등록
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RQCL_OBJT_CNTT"  , 0 , "위탁증거금 변경")	'위탁증거금변경
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "UI_COMN_AGRM_YN1" , 0 , "Y" )	'sCOMN_YN1
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "UI_COMN_AGRM_YN2" , 0 , "Y" )	'sCOMN_YN2
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN1" , 0 , "Y" )	'sPROD_YN1
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN2" , 0 , "Y" )	'sPROD_YN2
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN3" , 0 , sPROD_YN3 )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN4" , 0 , sPROD_YN4 )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN5" , 0 , sPROD_YN5 )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN6" , 0 , sPROD_YN6 )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "UI_COMN_AGRM_YN7" , 0 , sPROD_YN7 )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "UI_COMN_AGRM_YN1" , 0 , "Y" )	'sPROD_YN8
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "UI_COMN_AGRM_YN2" , 0 , "Y" )	'sPROD_YN9
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "UI_COMN_AGRM_YN3" , 0 , sPROD_YN10 )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "UI_COMN_AGRM_YN4" , 0 , sPROD_YN11 )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock5", "UI_COMN_AGRM_YN1" , 0 , "Y" )	'sPROD_YN12
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock5", "UI_COMN_AGRM_YN2" , 0 , "Y" )	'sPROD_YN13


	elseif szTranID == "obaci_acct_029a" then		
		dim szMARG_GRAD_CODE
		if g_Answer == "0" then	'4.100%징수(수수료포함)
			szMARG_GRAD_CODE = "4"
		elseif g_Answer == "1" then	'3.100%징수(수수료미포함)
			szMARG_GRAD_CODE = "3"
		elseif g_Answer == "2" then	'6.종목별차등
			szMARG_GRAD_CODE = "6"
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE"  , 0 , "4")	'4.온라인
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_nAccountNumber)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"           , 0 , g_nAccountSerialNumber)	
		'MTS메모리평문 적용상태일때
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, edtPassword.caption)
		
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, edtPassword.encdata)
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MARG_GRAD_CODE" , 0 , szMARG_GRAD_CODE)
		
	'V001
	elseif szTranID == "obcsb_acif_013r" then	'고객나이정보조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_nAccountNumber)	
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_comm_008r" then
		
		g_MARG_GRAD_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MARG_GRAD_CODE" , 0)	'증거금 등급 코드

		If g_MARG_GRAD_CODE = "1" Then
			g_MARG_GRAD_CODE_NAME = "40%징수"
		ElseIf g_MARG_GRAD_CODE = "3" Then
			g_MARG_GRAD_CODE_NAME = "100% 징수 (수수료 미포함)"
		ElseIf g_MARG_GRAD_CODE = "4" Then
			g_MARG_GRAD_CODE_NAME = "100% 징수 (수수료 포함)"
		ElseIf g_MARG_GRAD_CODE = "5" Then
			g_MARG_GRAD_CODE_NAME = "요주의"
		ElseIf g_MARG_GRAD_CODE = "6" Then
			g_MARG_GRAD_CODE_NAME = "종목별 차등"	' (30%/40%/50%/100%)
		ElseIf g_MARG_GRAD_CODE = "7" Then
			g_MARG_GRAD_CODE_NAME = "특별증거금(우대)"
		ElseIf g_MARG_GRAD_CODE = "8" Then
			g_MARG_GRAD_CODE_NAME = "30%일괄적용"
		End If

		Label0.caption = g_MARG_GRAD_CODE_NAME
		
		'V001
		gMnrYn = "N"
		DATAMANAGER.RequestTranData("obcsb_acif_013r")
		
	'V001
	elseif szTranID == "obcsb_acif_013r" then		
		gMnrYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1" , "UI_MNR_YN" , 0 )
		
	elseif szTranID == "obaci_acct_256r" then	
		Dim sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN
		Dim nCnt 
		nCnt = DATAMANAGER.GetDataCount( 0, "obaci_acct_256r", "OutBlock2")

		for i = 0 to nCnt -1 
			sNW_AGRM_BSWR_CLCD 	= DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "NW_AGRM_BSWR_CLCD" , i )
			sUI_CLS 				= DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "NW_AGRM_BSWR_DETL_CLS_CODE" , i )
			sNW_AGRM_KIND_CLCD 	= DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "NW_AGRM_KIND_CLCD" , i )
			sAGRM_YN 			= DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "CRIN_AGRM_YN" , i )
			
			f_SetYN(sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN)
		next

		if (g_Answer == "0") and 
			(sCOMN_YN1 <> "Y" or sCOMN_YN2 <> "Y" ) then
		
			g_Status = "P0"
			
			'개인(신용)정보 처리 필수 동의 팝업 오픈
			szParam = sCOMN_YN1 .. "★" .. sCOMN_YN2 .. "★" .. sPROD_YN1 .. "★" .. sPROD_YN2 .. "★" .. sPROD_YN8 .. "★" .. sPROD_YN9 .. "★" .. sPROD_YN12 .. "★" .. sPROD_YN13 .. "★" .. g_Status
			Form.OpenPopup("mbonl87060_p1", szParam, "")
			
		elseif (g_Answer == "1" or g_Answer == "2") and 
			(sCOMN_YN1 <> "Y" or sCOMN_YN2 <> "Y" or sPROD_YN1 <> "Y" or sPROD_YN2 <> "Y" or sPROD_YN8 <> "Y" or sPROD_YN9 <> "Y" or sPROD_YN12 <> "Y" or sPROD_YN13 <> "Y") then
			
			g_Status = "P1"
			
			'개인(신용)정보 처리 필수 동의 팝업 오픈
			szParam = sCOMN_YN1 .. "★" .. sCOMN_YN2 .. "★" .. sPROD_YN1 .. "★" .. sPROD_YN2 .. "★" .. sPROD_YN8 .. "★" .. sPROD_YN9 .. "★" .. sPROD_YN12 .. "★" .. sPROD_YN13 .. "★" .. g_Status
			Form.OpenPopup("mbonl87060_p1", szParam, "")
			
		else
			Dim sSendData
			sSendData = g_nAccountNumber&g_nAccountSerialNumber&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
		end if
		
		
	elseif szTranID == "obaci_acct_256a" then	'신용정보동의처리	
		Dim szRSLT_YN, szPROS_RSLT_DTL_CNTT
		szRSLT_YN = DATAMANAGER.GetDataValue( 0, "obaci_acct_256a", "OutBlock1" , "RSLT_YN" , 0 )	'결과여부
		szPROS_RSLT_DTL_CNTT = DATAMANAGER.GetDataValue( 0, "obaci_acct_256a", "OutBlock1" , "PROS_RSLT_DTL_CNTT" , 0 )	'처리결과상세내용
		if szRSLT_YN == "Y" then	'변경완료
			DATAMANAGER.RequestTranData("obaci_acct_029a")	'증거금 변경
		end if
		
	elseif szTranID == "obaci_acct_029a" then
		Dim szResult
		if g_Answer == "0" then	'4.100%징수(수수료포함)
			szResult = "100% 징수 (수수료 포함)"
		elseif g_Answer == "1" then	'3.100%징수(수수료미포함)
			szResult = "100% 징수 (수수료 미포함)"
		elseif g_Answer == "2" then	'6.종목별차등
			szResult = "종목별 차등"	' (30%/40%/50%/100%)
		end if
		
		g_szSendData = g_nAccountNumber .. "★" .. g_nAccountSerialNumber .. "★" .. szResult
	
		' 완료팝업
		Form.OpenPopup("mbonl87060_p2" , g_szSendData , "")
		
	end if
End Sub

'===========================================================================
' OutBlock 값 셋팅
'===========================================================================
Function f_SetYN(sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN)
	if sNW_AGRM_BSWR_CLCD ~= nil and sNW_AGRM_BSWR_CLCD ~= "" then
'		수집이용(공통)
		if sNW_AGRM_BSWR_CLCD == "1" then
			if sNW_AGRM_KIND_CLCD == "1" then		'고유식별번호
				sCOMN_YN1 = sAGRM_YN
			elseif sNW_AGRM_KIND_CLCD == "2" then	'개인(신용)정보
				sCOMN_YN2 = sAGRM_YN
			end if
'		수집이용(상품별)
		elseif sNW_AGRM_BSWR_CLCD == "2" then	
			if sUI_CLS == "01" then						'신용공여/미수/파생상품
				if sNW_AGRM_KIND_CLCD == "1" then		'고유식별번호
					sPROD_YN1 = sAGRM_YN
				elseif sNW_AGRM_KIND_CLCD == "2" then	'개인(신용)정보
					sPROD_YN2 = sAGRM_YN
				end if
			elseif sUI_CLS == "02" then					'비과세종합저축/ISA/연금저축							
				if sNW_AGRM_KIND_CLCD == "1" then	'1.고유식별번호
					sPROD_YN3 = sAGRM_YN				
				elseif sNW_AGRM_KIND_CLCD == "3" then	'3.민감정보	
					sPROD_YN5 = sAGRM_YN											
				elseif sNW_AGRM_KIND_CLCD == "2" then	'2.개인신용정보	
					sPROD_YN4 = sAGRM_YN					
				end if				
			elseif sUI_CLS == "03" then					'해외주식/해외파생/외화금융상품/EUREX				
				if sNW_AGRM_KIND_CLCD == "1" then	'1.고유식별번호
					sPROD_YN6 = sAGRM_YN				
				elseif sNW_AGRM_KIND_CLCD == "2" then	'2.개인신용정보	
					sPROD_YN7 = sAGRM_YN
				end if
			end if
'		제공(상품별)
		elseif sNW_AGRM_BSWR_CLCD == "3" then				'신용공여/미수/파생상품/해외파생
			if sUI_CLS == "01" then
				if sNW_AGRM_KIND_CLCD == "1" then		'고유식별번호
					sPROD_YN8 = sAGRM_YN
				elseif sNW_AGRM_KIND_CLCD == "2" then	'개인(신용)정보
					sPROD_YN9 = sAGRM_YN
				end if
			'해외주식/해외파생/해외금융상품	
			elseif sUI_CLS == "02" then
				'1.고유식별번호
				if sNW_AGRM_KIND_CLCD == "1" then
					sPROD_YN10 = sAGRM_YN
				'2.개인신용정보	
				elseif sNW_AGRM_KIND_CLCD == "2" then
					sPROD_YN11 = sAGRM_YN	
				end if
			end if
'		제공(공통)
		elseif sNW_AGRM_BSWR_CLCD == "4" then				'신용공여/미수/파생상품/해외파생
			if sUI_CLS == "01" then
				if sNW_AGRM_KIND_CLCD == "1" then		'고유식별번호
					sPROD_YN12 = sAGRM_YN
				elseif sNW_AGRM_KIND_CLCD == "2" then	'개인(신용)정보
					sPROD_YN13 = sAGRM_YN
				end if
			end if 
		end if
	end if 
End Function	

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrMsg .. "\n("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrMsg)
	end if
End Sub

'============================================================================
Sub BtnQ1A0_OnClick()
	g_Answer = "0"
	lblMessage.caption = "현금 100% 보유시 주문이 가능해요"
	
	SetCheckAnswer()
End Sub

'============================================================================
Sub BtnQ1A1_OnClick()
	g_Answer = "1"
	lblMessage.caption = "현금 100% 보유시 주문이 가능해요\n\n단, 수수료 미포함으로\n연체(미수)가 발생할 수 있어요"
	
	SetCheckAnswer()
End Sub

'============================================================================
Sub BtnQ1A2_OnClick()
	g_Answer = "2"
	lblMessage.caption = "종목에 따라 증거금 차등 적용으로\n외상(미수)주문이 가능해요"
	
	SetCheckAnswer()
End Sub

'============================================================================
' 설문 답안 초기화
'============================================================================
Function ClearCheckAnswer()
    for j = 0 to  2
	   Form.SetCtlProp("ImgQ1A" & j, "imgpath", unCheckImgPath)
    next
    
    lblMessage.caption = ""
End Function

'============================================================================
' 선택된 설문 답안 화면에 표시
'============================================================================
Function SetCheckAnswer()
	if g_Answer == "0" then	'4.100%징수(수수료포함)
		g_CHG_MARG_GRAD_CODE = "4"
	elseif g_Answer == "1" then	'3.100%징수(수수료미포함)
		g_CHG_MARG_GRAD_CODE = "3"
	elseif g_Answer == "2" then	'6.종목별차등
		g_CHG_MARG_GRAD_CODE = "6"
	end if

	for j = 0 to 2
	    if j == CDBL(g_Answer) then
			Form.SetCtlProp("LblQ1A" & j, "fontstyle", "01")	'폰트굵기 적용
			Form.SetCtlProp("ImgQ1A" & j, "imgpath", CheckImgPath)
	    else
			Form.SetCtlProp("LblQ1A" & j, "fontstyle", "00")
			Form.SetCtlProp("ImgQ1A" & j, "imgpath", unCheckImgPath)
	    end if
	next
	
	'현재 증거금이랑 변경할 증거금이랑 동일하면 변경하기 버튼 비활성화.. 
	if g_MARG_GRAD_CODE == g_CHG_MARG_GRAD_CODE then
		btnOk.enable = 0
	else
		btnOk.enable = 1
		
		'V001 미성년자면.. 비활성화
		if gMnrYn == "Y" and g_CHG_MARG_GRAD_CODE <> "4" then
			Form.ShowAlert("알림", "미성년자 계좌는 100%징수(수수료포함)만 가능합니다.\n(미수거래 불가)")	
			btnOk.enable = 0
		end if
	end if
End Function

