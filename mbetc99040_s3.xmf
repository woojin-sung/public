'============================================================================
Sub Form_OnFormInit()

	type_flag = 0
	
	Combo0.visible = 0
	Calendar0.visible = 0
	Combo1.visible = 0
	Combo2.visible = 0
	Combo3.visible = 0
	
	
	Label0.visible = 0
	
	Label1.visible =0
	Label2.visible = 0
	
	Table1.SetCellFgColor(0,0,"92")
	
	Label2.caption = "서울 영등포구 여의대방로69길 17"
	
	
	
	
	

     szData = Form.GetOpenLinkData()
	szList = Split(szData,"●")	
	
	Table0.SetCellString(0, 1, szList(0))
	Table0.SetCellString(1, 1, szList(1))
	Table0.SetCellString(2, 1, szList(2))
	Table0.SetCellString(3, 1, szList(3))
	Table0.SetCellString(4, 1, szList(4))
	
	tmp_prtf = szList(5)
	tmp_srno = szList(6)
	
	'Form.MsgBox("테스트", szList(6), "", "")
	
	'szData = Form.GetOpenLinkData()
	'szList = Split(szData,"●")	
	
	'Label1.caption = szList(0)
	'Label2.caption = szList(1)
End Sub

'============================================================================


'============================================================================


'============================================================================
Sub Table1_OnClick(lRow , lColumn)

Table1.SetCellFgColor(0,0, "92")
Table2.SetCellFgColor(0,0, "89")

	Combo0.visible = 0
	Combo2.visible = 0
	Combo3.visible = 0
	Calendar0.visible = 0
	Combo1.visible = 0
	
	Label0.visible = 0
	
	Label1.visible =0
	Label2.visible =0
	
	type_flag = 0
	
End Sub

'============================================================================
Sub Table2_OnClick(lRow , lColumn)


Table1.SetCellFgColor(0,0, "89")
Table2.SetCellFgColor(0,0, "92")

	Combo0.visible = 1
	Combo2.visible = 1
	Combo3.visible = 1
	Calendar0.visible = 1
	Combo1.visible = 1
	
	Label0.visible = 1
	
	Label1.visible =1
	Label2.visible =1
	
	type_flag = 1
	
End Sub

'============================================================================
Sub Button0_OnClick()


	if type_flag == 0 then
	
	DATAMANAGER.SetEventFlag("obcpp_intr_758a", "I")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "BRNM" , 0 , Table0.GetCellString(0, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "BRNC_ADDR" , 0 , Table0.GetCellString(1, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_DATE" , 0 , Table0.GetCellString(2, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Table0.GetCellString(3, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "RSNS_EMPNO" , 0 , Table0.GetCellString(4, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_MEMB_SRNO" , 0 , 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PRTF_ID" , 0 , tmp_prtf)
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_CLS_CODE" , 0 , 0)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_YN_CODE" , 0 , 0)
	
	DATAMANAGER.RequestTranData("obcpp_intr_758a")
	Form.Toast(0, "예약취소가 완료되었습니다.", 0.5)
	
	
	
	elseif type_flag == 1 then
	
	DATAMANAGER.SetEventFlag("obcpp_intr_758a", "U")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "BRNM" , 0 , Combo0.caption)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "BRNC_ADDR" , 0 , Label2.caption)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_DATE" , 0 , Calendar0.caption)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_RSEV_SRNO", 0 , tmp_srno)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "CODE_CLS_CODE" , 0 , "1")
	'DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_YN_CODE" , 0 , 1)
	
	if Combo1.caption == 1 then
	tmp_hour = Combo2.caption+12&":"&Combo3.caption
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , tmp_hour)
	
	else
	tmp_hour = Combo2.caption&":"&Combo3.caption
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , tmp_hour)
	
	end if
	
	
	
	DATAMANAGER.RequestTranData("obcpp_intr_758a")
	Form.Toast(0, "예약수정이 완료되었습니다.", 0.5)
	
	end if
	

	
	Form.SendReturnToParent("mbetc99040_s3" , "1")


	Form.CloseForm()
End Sub

'============================================================================
Sub Combo0_OnEditComplete(nIndex)

 Select Case CInt(nIndex)
		Case 0
			Label2.caption = "서울 영등포구 여의대방로69길 17"
		Case 1
			Label2.caption = "서울 종로구 새문안로 92"
		Case 2
			Label2.caption = "서울 강남구 삼성동 141-31"
		Case 3
			Label2.caption = "서울 강남구 도곡동 467-14"
		Case 4
			Label2.caption = "부산 부산진구 부전동 91-5"
		Case 5
			Label2.caption = "대구 수성구 범어동 177-4"
	End Select
 
	
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.CloseForm()
End Sub

