	<SCRIPT_INFO _len="5825" _ulen="5687" >
--===========================================================================
--===========================================================================
Dim g_szAcntInfo
Dim g_sPlain_rm
'============================================================================
'f_SetCalendarWithPeriod(iIdx) : 기간 콤보 선택 시 처리되는 함수
'============================================================================
Function f_SetCalendarWithPeriod(iIdx)
	dim sHostDate
	sHostDate = Form.GetSharedData("&HOST_DATE", false)
	
	if iIdx == 0 then
		Calendar0.caption = sHostDate
	elseif iIdx == 1 then
		Calendar2.addday = -7
		Calendar0.caption = Calendar2.caption
	elseif iIdx == 2 then
		Calendar2.addday = -30
		Calendar0.caption = Calendar2.caption
	elseif iIdx == 3 then
		Calendar2.addday = -90
		Calendar0.caption = Calendar2.caption
	end if
	
	Calendar1.caption = sHostDate
	Calendar2.caption = sHostDate
	
	f_RequestDataList()
End Function

'============================================================================
Function f_RequestDataList()
	if g_szAcntInfo <> "" and g_szAcntInfo <> null then
		if Form.GetCtlProp( "#edtPassword", "caption" ) <> "" and Form.GetCtlProp( "#edtPassword", "caption" ) <> null then
			DATAMANAGER.RequestTranData( "obtro_stlm_491r" )
		end if
	end if
End Function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Request" then
		g_szAcntInfo = sParam
		f_RequestDataList()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtro_stlm_491r" then
		dim sPwd
		'비밀번호 암호화
		If g_sPlain_rm == "1" Then
			sPwd = Form.GetCtlProp( "#edtPassword", "caption" )
		else
			sPwd = Form.GetCtlProp( "#edtPassword", "encdata" )
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_STA_DATE", 0, Calendar0.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_FIN_DATE", 0, Calendar1.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, Left(g_szAcntInfo, 8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0, Right(g_szAcntInfo, 2) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD", 0, sPwd )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_stlm_491r" then
		dim nDataCnt
		nDataCnt = CInt( DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1"))
		if nDataCnt > 0 then
			if CInt(Grid0.rowcount) > 0 then
				lblNoData.visible = false
				iRow = CInt(Grid0.rowcount) - nDataCnt
				for i=iRow to CInt(Grid0.rowcount)-1 
					dim szCd, szNm, tCode
					Grid0.SetCellData( "bd_text", i, "전환수량" )
					
					szCd = Grid0.GetCellData("bd_itemcd", i)
					szNm = Grid0.GetCellData("bd_itemnm", i)
					szCancelYn = Grid0.GetCellData("bd_cancelyn", i)
					tCode = Split(szCd, ".")
					
'					Grid0.SetCellData("bd_uicode", i, tCode(0) & " | " & szNm)
					Grid0.SetCellData("bd_uicode", i, tCode(0))
					Grid0.SetCellData("bd_split", i, "|" )
					Grid0.SetCellData("bd_uiname", i, szNm)
					Grid0.SetCellImage( "bd_qty", i, "img_bgbox.9" )
					if szCancelYn == "Y" then
						Grid0.SetCellData("bd_cancel", i, "취소")
					else
						Grid0.SetCellData("bd_cancel", i, "신청")
					end if
				next
			else
				lblNoData.visible = true
			end if
		else
			lblNoData.visible = true
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtro_stlm_491r" then
		dim szSubMsg
		szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		if szSubMsg <> "" and szSubMsg <> null then
			Form.ShowAlert("알림", szErrMsg & " " & szSubMsg)
		else
			Form.ShowAlert("알림", szErrMsg)
		end if
		
	end if
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	f_SetCalendarWithPeriod(CInt(iIndex))
End Sub

'============================================================================
Sub Calendar0_OnEditComplete()
	f_RequestDataList()
End Sub

'============================================================================
Sub Calendar1_OnEditComplete()
	f_RequestDataList()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	g_sPlain_rm = Form.GetSharedData("&PLAIN_RM" , false) '암호화 여부
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obtro_stlm_491r" )
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obtro_stlm_491r" )
	end if
End Sub

'============================================================================
Sub btnCmb_OnClick()
	dim nWidth, nTop, nLeft, nHeight, szSendData, szLocation, szComboData
	nWidth = 75
	nTop = 100 '부모화면 높이 포함
	nLeft = 290
	nHeight = 32
	
	szLocation = nWidth &"★"& nTop &"★"& nLeft &"★"& nHeight
	szComboData = "당일★1주일★1개월★3개월"
	
	szSendData = szLocation&"♥"&szComboData&"♥"&"cmbPeriod"&"♥"& cmbPeriod.currentindex
	Form.OpenPopup("mhtro16093_p3" , szSendData, "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "COMBO_POP" then '비번 입력 팝업
		if sRet <> "" and sRet <> null then
			dim tData
			tData = Split(sRet, "★")
			Form.SetCtlProp(tData(0), "currentindex", tData(1))
		end if
	end if
End Sub



