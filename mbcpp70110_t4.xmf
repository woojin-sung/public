--===========================================================================
Dim prtf_id
Dim user_risk
Dim prtf_risk
Dim prtf_name
Dim myptrf_name
Dim prtf_grade
--===========================================================================



'============================================================================
Sub Form_OnFormInitBefore()
	prtf_grade = Form.GetSharedData("Shared_GRADE", false)
	prtf_id = Form.GetSharedData("Shared_PID", false)
	user_risk = Form.GetSharedData("User_Grade_Code", false)
	prtf_risk = Invest_Grade(prtf_grade)
	
	prtf_name = Form.GetSharedData("Shared_PNAME", false)
End Sub


'============================================================================
Sub Form_OnFormInit()
	Label1.caption = prtf_name
	Label2.caption = prtf_risk
	

	
	Label2.fgcolor = Cal_color(Cint(prtf_grade))
End Sub

'============================================================================
Sub Button0_OnClick()
	dim currenttime
	dim uid
	
	currenttime = Form.GetSharedData("&HOST_DATE", false) & Form.GetSharedData("&HOST_TIME", false)
	uid = Form.GetSharedData("&USER_ID", false)
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "PROS_CLS_CODE", 0 , "u")
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "CUST_ID" , 0 , uid)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "MOD_YMDH", 0 , currenttime)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "PRTF_ID", 0, prtf_id)
'	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "PRTF_NAME", 0 , "")

	DATAMANAGER.RequestTranData("obcpp_rbit_018a")
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "PROS_CLS_CODE", 0 , "i")
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "CUST_ID" , 0 , uid)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "MOD_YMDH", 0 , currenttime)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "PRTF_ID", 0, prtf_id)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1", "PRTF_NAME", 0 , Edit0.caption)
	
	DATAMANAGER.RequestTranData("obcpp_rbit_018a")
	Form.Toast(0,"정상적으로 저장되었습니다.",0)
	
	Form.PostLinkData("POPUP_CLOSE", "mbcpp70110_t4.xmf")
	
End Sub

'============================================================================
Function Invest_Grade(grade)

temp=""

	if grade == "1" then
		temp = "초저위험"
	elseif grade == "2" then
		temp = "초저위험+"
	elseif grade == "3" then
		temp = "저위험"
	elseif grade == "4" then
		temp = "저위험+"
	elseif grade == "5" then
		temp = "중위험"
	elseif grade == "6" then
		temp = "중위험+"
	elseif grade == "7" then
		temp = "고위험"
	elseif grade == "8" then
		temp = "고위험+"
	elseif grade == "9" then
		temp = "초고위험"
	elseif  grade =="10"then
		temp = "초고위험+"
	else temp = grade
	end if

Invest_Grade =temp
End Function
'====================================

	Function Cal_color(color)
					
			temp=""
			
			if Cint(color)= 1  then
				temp="206"
			
			elseif Cint(color)= 2 then
				temp="91"
					
			elseif Cint(color)= 3 then
				temp="220"
				
			elseif Cint(color)= 4 then
				temp="84"
				 	
			elseif Cint(color)= 5 then
				temp="8"
					
			elseif Cint(color)= 6 then
				temp="203"
					
			elseif Cint(color)= 7 then
				temp="207"
				 	
			elseif Cint(color)= 8 then
				temp="101"
					
			elseif Cint(color)= 9 then
				temp="59"
					
			elseif Cint(color)=10 then
				temp="92"
			
			else  temp="49"
		
		Cal_color= temp 	
		
			
	end if

End Function 

