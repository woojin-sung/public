'--===========================================================================
' 01. 화 면 명 : 전환(분류)신청_지정확인서정보입력팝업
' 02. 화면설명 : 
' 03. 작    성 : 2021.08.03 : 정효영 : v0001 :
' 04. 수    정 : 2021.08.24 : JHY    : v0002 : 지정확인서 발급일자 현시점으로부터 3개월 이내인지 확인하는 로직 추가, IO변경 적용 ( v001)
'                2023.08.24 : 고승연 : v0003 : 화면명 수정
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAccount
Dim g_szImageName, g_szImageSize

g_szAccount = ""
g_szImageName = ""
g_szImageSize = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function ChangeBtnEnable()
	Dim isEnable
	isEnable = true
	
	if Trim(cont01.edtDsgtNum.caption) == NULL or Trim(cont01.edtDsgtNum.caption) == "" then
		isEnable = false
	else
		if tonumber(cont01.rdoGubun.currentindex) == 0 then	
			if Len(cont01.edtDsgtNum.caption) <> 15 then
				isEnable = false
			end if
		end if
	end if
		
	if Trim(cont01.cldDsgtDate.caption) == NULL or Trim(cont01.cldDsgtDate.caption) == "" then
		isEnable = false
	end if
		
	if Trim(cont01.cldStart.caption) == NULL or Trim(cont01.cldStart.caption) == "" or Trim(cont01.cldFinal.caption) == NULL or Trim(cont01.cldFinal.caption) == "" then
		isEnable = false
	end if
		
	if Trim(cont01.edtIssueNum.caption) == NULL or Trim(cont01.edtIssueNum.caption) == "" then
		isEnable = false
	end if
	
	if Trim(cont01.cldIssueDate.caption) == NULL or Trim(cont01.cldIssueDate.caption) == "" then
		isEnable = false
	
	'21.08.24 JHY START (v001)
	else
		if isCorrectDate() == false then
			isEnable = false
		end if
	'21.08.24 JHY END
	end if
		
	if tonumber(cont01.rdoGubun.currentindex) == 0 then	
		if Trim(cont01.lblCompName.caption) == NULL or Trim(cont01.lblCompName.caption) == "" then
			isEnable = false
		end if
	end if
	
	btnNext.enable = isEnable
End Function

'============================================================================
' 21.08.24 JHY 추가
' isCorrectDate() : 현재로부터 3개월 이내 (이전 3개월) 이 맞는지 체크하는 함수
'============================================================================
Function isCorrectDate()
	Dim szTodayFotmat, szToday, szStart
	
	szTodayFotmat = cont01.cldToday.calyear &"-"& cont01.cldToday.calmonth &"-"& cont01.cldToday.calday
	szToday = cont01.cldToday.caption
	szStart = Replace(DateAdd ("m", -3, szTodayFotmat), "-", "")

	if CDbl(cont01.cldIssueDate.caption) <> NULL then
		if CDbl(cont01.cldIssueDate.caption) <  CDbl(szStart) or CDbl(szToday) <  CDbl(cont01.cldIssueDate.caption) then
			return false
		end if
		
	else
		return false
	end if
	
	return true
End Function

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szAccount = Form.GetOpenLinkData()
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "close_mbonl94003_p4" then
		if sRet <> NULL and sRet <> "" then
			Dim tCompany
			tCompany = Split(sRet, "★")

			if Ubound(tCompany) > 0 then
				if tCompany[0] <> NULL then
					cont01.edtCompCd.caption = tCompany[0]
				end if
'				
				if tCompany[1] <> NULL then
					cont01.lblCompName.caption = tCompany[1]
				end if
			end if
		end if
		
		ChangeBtnEnable()
	
	'신청 후 필수 절차 안내 팝업 닫았을때 공인인증서 확인하고 신청 TR 호출
	elseif sKeyName == "close_mbonl94003_p1" then
		Dim szCertUseType 
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입

		if szCertUseType == "1" or szCertUseType == 1 then '간편인증 v001
		    Form.OpenFramePopup( "mhetc90060_px" , "" , mhetc90060_px)		'간편인증
		else
		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if
		
	' 확인 후 공인인증 처리 완료 되면 전환 신청 TR 호출
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			DATAMANAGER.RequestTranData( "obcsb_acif_111a" )
		end if
		
     elseif sKeyName == "mhetc90060_px" then
	     if sRet == "ok" Then  
		     DATAMANAGER.RequestTranData( "obcsb_acif_111a" )
	     end if
	
	' 지정확인서 업로드 이미지 파일 정보
     elseif sKeyName == "mbonl94003_p5" then
	     if sRet <> NULL and sRet <> "" then
		     Dim tImage
			tImage = Split(sRet, "★")

			if Ubound(tImage) > 0 then
				if tImage[0] <> NULL then
					g_szImageName = tImage[0]
				end if
'				
				if tImage[1] <> NULL then
					g_szImageSize = tImage[1]
				end if
				
				Form.OpenPopup("mbonl94003_p1" , "" , "")
			
			else
				Form.ShowAlert("알림", "이미지 등록에 실패하였습니다. 다시 시도해주세요")
			end if
			
		else
			Form.ShowAlert("알림", "이미지 등록에 실패하였습니다. 다시 시도해주세요")
	     end if
	 
	 ' 전환(분류) 신청 완료 팝업 리턴
     elseif sKeyName == "close_mbonl94002_p2" then
	     Form.CloseForm()
	end if
End Sub

'============================================================================
' btnBack_OnClick() : 메뉴 닫기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' cont01_btnSearch_OnClick() : 회사코드 팝업 오픈
'============================================================================
Sub cont01_btnSearch_OnClick()
	Form.openDialog("mbonl94003_p4","","")
End Sub

'============================================================================
' cont01_rdoGubun_OnClick(nIndex) : 해당 라디오에 맞게 컨트롤 세팅
'============================================================================
Sub cont01_rdoGubun_OnClick(nIndex)
	cont01.edtDsgtNum.caption = ""
	cont01.cldDsgtDate.caption = ""
	cont01.cldStart.caption = ""
	cont01.cldFinal.caption = ""
	cont01.edtIssueNum.caption = ""
	cont01.cldIssueDate.caption = ""
	
	cont01.edtCompCd.caption = "%"
	cont01.lblCompName.caption = ""

	if tonumber(nIndex) == 0 then		
'		cont01.edtCompCd.enable = true
		cont01.btnSearch.enable = true
		cont01.lblCompName.enable = true
		
		cont01.edtDsgtNum.imetype = 1 ' 숫자만 가능하므로 숫자키보드
		cont01.edtDsgtNum.mask = "1,0,,,1,###-########-####,0,1,1,0,0"
		cont01.edtDsgtNum.maxlength = 15
		
	else
'		cont01.edtCompCd.enable = false
		cont01.btnSearch.enable = false
		cont01.lblCompName.enable = false
		cont01.lblCompName.caption = "금융투자협회 지정"
		
		cont01.edtDsgtNum.imetype = 0 ' 문자, 숫자 상관 없으므로 일반키보드
		cont01.edtDsgtNum.mask = "1,0,,,1,,0,1,1,0,0"
		cont01.edtDsgtNum.maxlength = 50
	end if
End Sub


'============================================================================
' btnNext_OnClick() : 입력 값 확인 및 신청
'============================================================================
Sub btnNext_OnClick()
	Form.OpenPopup("mbonl94003_p5" , "" , "")
End Sub

'============================================================================
' cont01_cldStart_OnEditComplete()
'============================================================================
Sub cont01_cldStart_OnEditComplete()
	if Trim(cont01.cldFinal.caption) <> NULL and Trim(cont01.cldFinal.caption) <> "" then
		if tonumber(cont01.cldStart.caption) > tonumber(cont01.cldFinal.caption) then
			Form.ShowAlert("알림", "시작일자가 종료일자보다 이후일 수 없습니다.")
			cont01.cldStart.caption = cont01.cldFinal.caption
		end if
	end if
	
	ChangeBtnEnable()
End Sub

'============================================================================
' cont01_cldFinal_OnEditComplete()
'============================================================================
Sub cont01_cldFinal_OnEditComplete()
	if Trim(cont01.cldStart.caption) <> NULL and Trim(cont01.cldStart.caption) <> "" then
		if tonumber(cont01.cldStart.caption) > tonumber(cont01.cldFinal.caption) then
			Form.ShowAlert("알림", "종료일자가 시작일자보다 이전일 수 없습니다.")
			cont01.cldFinal.caption = cont01.cldStart.caption
		end if
	end if
	
	ChangeBtnEnable()
End Sub


'============================================================================
' cont01_edtDsgtNum_OnClick()
'============================================================================
Sub cont01_edtDsgtNum_OnClick()
	if tonumber(cont01.rdoGubun.currentindex) == 0 then		
		Dim szOsType
		szOsType = Form.GetSharedData("&OS_TYPE", false) '1.안드로이드 2.iOS
		
		' 안드로이드는 마스크 문자 포함한 것까지 글자수로 판단하여 complete에서 - 포함한 17글자로 변경 (컴플리트 전에는 마스크 문자 뺀것으로 계산)
		' OS 동작 상이하게 되어있어서 분기처리로 맞춤
		if tonumber(szOsType) == 1 then
			cont01.edtDsgtNum.maxlength = 15
			
		else
			cont01.edtDsgtNum.maxlength = 17
		end if
	end if
End Sub

'============================================================================
' cont01_edtDsgtNum_OnEditComplete()
'============================================================================
Sub cont01_edtDsgtNum_OnEditComplete()
	if tonumber(cont01.rdoGubun.currentindex) == 0 then	
		if Len(cont01.edtDsgtNum.caption) <> 15 then
			Form.ShowAlert( "알림", "금융투자업자 지정 전문투자자 지정번호는 15자리로 구성되어 있습니다 (지정번호 오류)" )
		end if
	end if
	
	if tonumber(cont01.rdoGubun.currentindex) == 0 then		
		Dim szOsType
		szOsType = Form.GetSharedData("&OS_TYPE", false) '1.안드로이드 2.iOS
		
		' 안드로이드는 마스크 문자 포함한 것까지 글자수로 판단하여 complete에서 - 포함한 17글자로 변경 (컴플리트 전에는 
		if tonumber(szOsType) == 1 then
			cont01.edtDsgtNum.maxlength = 17
		end if
		
		cont01.edtDsgtNum.mask = "1,0,,,1,###-########-####,0,1,1,0,0"
		
	else
		cont01.edtDsgtNum.mask = "1,0,,,1,,0,1,1,0,0"
	end if	
	
	ChangeBtnEnable()
End Sub

'============================================================================
' cont01_cldDsgtDate_OnEditComplete()
'============================================================================
Sub cont01_cldDsgtDate_OnEditComplete()
	ChangeBtnEnable()
End Sub

'============================================================================
' 21.08.10 JHY 추가
' cont01_edtIssueNum_OnClick() : 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경
'============================================================================
Sub cont01_edtIssueNum_OnClick()
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" then
		cont01.lblScrollPos.top = 700
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 100
	end if
End Sub

'============================================================================
' cont01_edtIssueNum_OnEditComplete()
'============================================================================
Sub cont01_edtIssueNum_OnEditComplete()
	ChangeBtnEnable()
	
	' 21.08.10 JHY 추가
	' 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경했던것 제자리로

	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" then
		cont01.lblScrollPos.top = 0
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 0
	end if
End Sub

'============================================================================
' cont01_cldIssueDate_OnEditComplete()
'============================================================================
Sub cont01_cldIssueDate_OnEditComplete()
	'21.08.24 JHY START
	Dim szToday
	szToday = Form.GetSharedData( "&HOST_DATE", false )
	
	if isCorrectDate() == false then
		Form.ShowAlert( "알림", "지정확인서는 발급일로부터 3개월이내만 가능합니다.")
	end if
	'21.08.24 JHY END
	
	ChangeBtnEnable()
End Sub

'''****************************************************************************
'''               		D A T A				M A N A G E R               
'''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	if szTranID == "obcsb_acif_111a" then		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0, "I" ) '처리구분코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0, g_szAccount ) '계좌번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0, szCustNum ) '고객번호		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_RGNO" , 0, Trim(cont01.edtDsgtNum.caption) ) '전문투자자등록번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "DSGT_DATE" , 0, Trim(cont01.cldDsgtDate.caption) ) '지정일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "STA_DATE" , 0, Trim(cont01.cldStart.caption) ) '시작일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "FIN_DATE" , 0, Trim(cont01.cldFinal.caption) ) '종료일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "UI_IMG_DATA" , 0, g_szImageName ) 'UI이미지데이터
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ATCH_FILE_SIZE" , 0, g_szImageSize ) '첨부파일사이즈
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "DSGT_CNSH_ISNC_DATE" , 0, Trim(cont01.cldIssueDate.caption) ) '지정확인서발급일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "OTCO_CNSH_ISNC_NO" , 0, Trim(cont01.edtIssueNum.caption) ) '타사확인서발급번호 v001
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0, "4" ) '접촉구분코드
		
		if tonumber(cont01.rdoGubun.currentindex) == 0 then
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_CLS_CODE" , 0, "4" ) '전문투자자구분코드
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ISTU_CLCD" , 0, "F" ) '기관구분코드
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "OTCO_ISTU_CODE" , 0, Trim(cont01.edtCompCd.caption) ) '타사기관코드
		else
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_CLS_CODE" , 0, "3" ) '전문투자자구분코드
		end if
	end if
End Sub
'
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	if szTranID == "obcsb_acif_111a" then		
		Form.OpenPopup("mbonl94002_p2" , "switch_professional_others" , "")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 에러
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szSubMsg == "" then
		Form.ShowAlert("알림", szErrMsg)
	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub


