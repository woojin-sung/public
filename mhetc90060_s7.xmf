'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_발급/타기관(본인확인계좌)
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'20201116 SWJ START 실명확인번호 암호화 (rcno_plain_rm = 0 미적용 / rcno_plain_rm = 1 적용)
'20201126 SWJ START 공인인증서 '공인' 글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

Dim g_MediaType
g_MediaType =""

'20240418 SWJ START
Dim g_bNeedConnect 
g_bNeedConnect = ""

Dim g_sNewRegi
g_sNewRegi = ""

Dim g_sCustClsCode
g_sCustClsCode = ""

Dim g_sGubunCode
g_sGubunCode = ""

Dim g_MotpYN
g_MotpYN = ""

Dim g_motpAppYN
g_motpAppYN = ""

Dim G_MERITZ_SECURITY_FILE 		'보안카드풀팝업
Dim G_MERITZ_QUESTION_FILE 		'부가정보풀팝업
Dim G_MERITZ_OTP_FILE 			'일반OTP풀팝업
Dim G_MERITZ_SOTP_FILE 		'스마트OTP풀팝업
Dim G_MERITZ_MOTP_FILE 		'모바일OTP풀팝업

G_MERITZ_SECURITY_FILE 		= "mhetc90060_p9"		'보안카드풀팝업
G_MERITZ_QUESTION_FILE			= "mhetc90060_pa"		'부가정보풀팝업
G_MERITZ_SOTP_FILE 			= "mhetc90060_pb"		'스마트OTP풀팝업
G_MERITZ_OTP_FILE 			= "mhetc90060_otp"	'일반OTP풀팝업
G_MERITZ_MOTP_FILE			= "mhetc90060_motp"    '모바일OTP풀팝업
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		if sParam == "new" then '발급/재발급
			Table1.visible = true
		elseif sParam == "regi" then '타기관등록
			Table2.visible = true
		end if
		
		'20240418 SWJ START
		g_sNewRegi = sParam
		'20240418 SWJ END
		
	elseif sEventName == "NextCheck" then
		if Edit0.caption == null or Edit0.caption == "" then
			Form.MsgBox( "알림", "종합계좌번호를 입력하세요.", "", 6 )
		elseif Edit1.caption == null or Edit1.caption == "" then			
			Form.MsgBox( "알림", "계좌비밀번호를 입력하세요.", "", 6 )
		else '본인 확인 유효성체크
			
			'20240418 SWJ START
			Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90060") '응답이벤트에서 procSelectedCloudCert(g_sDN) 실행
			'20240418 SWJ END
			
			DATAMANAGER.RequestTranData( "obacp_opop_007r" )
		end if
	elseif sEventName == "BeforeCheck" then
		Form.triggerEvent( "#", "BeforeStep", "0" )
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_opop_007r" then
		Dim sRCNO, sACNT_PWD
		sRCNO = Form.GetSharedData("CERT_RCNO" , false)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			sACNT_PWD = Edit1.caption
		'MTS메모리평문제거 미적용상태일 때
		else
			sACNT_PWD = Form.GetEncData(Edit1.caption)
		end if
		'20200910 SWJ END
		
		'20201116 SWJ START : 실명확인번호 암호화 (RCNO > RCNO_PIP로 변경)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then '고유MTS 미적용
			DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "RCNO"     , 0 , sRCNO )
		else	
			DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "RCNO_PIP" , 0 , sRCNO )
		end if
		'20201116 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "ACNO" , 0 , Edit0.caption )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	
	'20240408 SWJ START: 클라우드 인증
	elseif szTranID == "obcsb_oimf_638r" then
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ACNO" , 0 , Edit0.caption )

		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID() )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "100" ) '인증서신규
	
	elseif szTranID == "obpds_srvc_173r" then
		
		sUserID = Form.GetSharedData("CLOUD_CERT_ID", false)
		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r", "InBlock1", "SVCD"	  , 0 ,"073" )		'서비스 코드

	'사고계좌 여부 확인	
	elseif szTranID == "obpds_srvc_173r_1" then
	
		sUserID = Form.GetSharedData("CLOUD_CERT_ID", false)
		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "SVCD"	  , 0 ,"ZZZ" )			'서비스 코드
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "CSNO"	  , 0 , g_sCloudCSNO)		'고객번호
	
	elseif szTranID == "obcsb_oimf_520r" then	
		sCloudRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP", false )
		
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS", 0, "2" )
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"  , 0, sCloudRcnoPip)	
	end if
	'20240408 SWJ END
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_007r" then
		Dim sCSNM, sName
		sName = Form.GetSharedData("CERT_USER_NAME" , false)
		sCSNM = DATAMANAGER.GetDataValue( 0, "obacp_opop_007r", "OutBlock1", "CSNM" , 0 )
		
		if sCSNM == null or Trim(sCSNM) == "" or (Trim(sName) ~= Trim(sCSNM)) then
			Form.MsgBox( "알림", "고객정보가 일치하지 않습니다.", "", 6 )
		else
			Dim sACNT_PWD
			
			'20200910 SWJ START
			'MTS메모리평문제거 적용상태일 때
			if plain_rm == "1" then
				sACNT_PWD = Edit1.caption
			'MTS메모리평문제거 미적용상태일 때
			else
				sACNT_PWD = Form.GetEncData(Edit1.caption)
			end if
			'20200910 SWJ END
			
			Form.SetSharedData("CERT_ACNO" , Edit0.caption)
			Form.SetSharedData("CERT_ACNT_PWD" , sACNT_PWD)
			
			'20240408 SWJ START: 클라우드 인증
			'법인/개인 판단
			DATAMANAGER.SetDataValue( 0 , "obcsb_acif_005r", "InBlock1", "PROS_CLS_CODE", 0 , "1")		
			DATAMANAGER.SetDataValue( 0 , "obcsb_acif_005r", "InBlock1", "ACNO", 0 , Edit0.caption)		
			DATAMANAGER.RequestTranData("obcsb_acif_005r")
			
			'Form.triggerEvent( "#", "NextStep", "2" )	
			'20240408 SWJ END
			
		end if
	end if
	
	'20240408 SWJ START: 클라우드 인증
	if szTranID == "obcsb_acif_005r" then
		'고객구분코드 
		g_sCustClsCode = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_005r", "OutBlock1", "CUST_CLS_CODE", 0 )
		
		g_bNeedConnect = Form.GetSharedData("CLOUD_CONNECT_FROM_CERT", true)
		
		'개인1/법인2
		if Trim(g_sCustClsCode) == "2" then
			Form.triggerEvent( "#", "NextStep", "2" )
		else	
			if g_bNeedConnect <> "" then
				Form.MsgBox("안내", "개인 고객은 코스콤 클라우드 계정 연결 후\n인증서 발급이 가능합니다.\n\n클라우드 계정을 연결하시겠어요?", "ConnectCloud", 7, "클라우드 계정 연결하기", "취소")
			else
				DATAMANAGER.RequestTranData("obcsb_oimf_638r")
			end if
		end if
	
	'단말기 지정여부 팝업 오픈
	elseif szTranID == "obcsb_oimf_638r" then

		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0) == "Y" then
			Form.OpenPopup("mhetc90060_p14",g_sNewRegi, "")				
		else
			'추가인증 약정 여부
			if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0) == "Y" then
				Form.SetSharedData("CLOUD_ADD_AUTH_FLAG" , g_sNewRegi)
				
				Form.OpenPopup("mhetc90060_p8", g_sNewRegi,"")
			else
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			end if
		end if
	
	'인증서 온라인 신원확인 사전동의 조회 
	elseif szTranID == "obpds_srvc_173r" then
		
		g_sCloudCSNO = DATAMANAGER.GetDataValue( 0, "obpds_srvc_173r", "OutBlock2", "CSNO" , 0 )

		'약정(고객번호 있으면 약정으로 판단)
		if g_sCloudCSNO ~= null and Trim(g_sCloudCSNO) ~= "" then
			
			sAgrmYN = DATAMANAGER.GetDataValue( 0, "obpds_srvc_173r", "OutBlock1", "AGRM_YN" , 0 )
			
			'동의
			if sAgrmYN == "Y" Then
				
				'사고계좌 여부 확인
				DATAMANAGER.RequestTranData("obpds_srvc_173r_1")
			
			'미동의 - 진행불가 
			else
				Form.OpenPopup("mhetc90060_p12","","")
			end if
	    
	    '미약정 	
		else	
			' 인증서 발급시 온라인 신원확인 사전동의 진행
			Form.OpenPopup("mhetc90060_p13","","")
		end if
	
	'사고계좌 여부 확인
	elseif szTranID == "obpds_srvc_173r_1" then
		Dim sAgrmYN2
		
		sAgrmYN2 = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_173r_1", "OutBlock1", "AGRM_YN" , 0)
		
		if sAgrmYN2 == "N" then
			
			'모바일OTP 보안매체가 원장 기준으로는 있더라도
			'앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
			Form.requestMOTP("MOTP_GETINFO"     , "" , "90150")     '등록된 OTP alias 존재하는지 확인
			
			DATAMANAGER.RequestTranData("obcsb_oimf_520r")
		else
			sText = "사고의심계좌로 등록된 계좌는 인증서 발급/재발급 진행이 불가합니다."
			Form.MsgBox("알림", sText, "ACCI_MSG", 1)
		end if
	
	elseif szTranID == "obcsb_oimf_520r" then
		'0: 보안카드 / 1: 부가정보 / 2: otp,보안카드,부가정보 없음 / 3: otp / 9: 기타오류
		g_sGubunCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0)
		g_MotpYN      = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0)
		
		sTempID = Form.GetSharedData("CLOUD_CERT_ID", false)
		Form.SetSharedData("CERT_ID", sTempID)
		
		SetSecurityOpen()
		
	end if
	
	'20240408 SWJ END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obacp_opop_007r" then
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	Label1.caption	= "계좌번호 찾기 >"
	
	Edit0.setApplyLabel("계좌번호" , 	0 , 268 , "left" , false)
	Edit1.setApplyLabel("계좌비밀번호" ,	0 , 268 , "left" , false)
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
	'20201116 SWJ START : 실명확인번호 암호화
	'rcno_plain_rm = ( 0 : 미적용/ 1 : 적용)
	rcno_plain_rm = Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	'20201116 SWJ END

End Sub

'============================================================================
' 계좌번호 찾기
'============================================================================
Sub Button0_OnClick()
	Form.OpenPopup("mbonl85001", "", "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' 계좌번호찾기 완료
	if sKeyName == "mbonl85001" then
		
		if len(sRet) > 8 then
			Dim sAcntArr
			sAcntArr = split(sRet, "-")
			
			Edit0.caption = sAcntArr(0)
		else
			Edit0.caption = sRet
		end if
	
	'20240408 SWJ START: 클라우드 인증
	elseif sKeyName == "CLOUD_CHECK_CONNECT" then
	
		if sRet == "OK" then
			'단말기 지정여부 확인
			DATAMANAGER.RequestTranData("obcsb_oimf_638r")
		else
			Form.CloseForm()
		end if
		
	elseif sKeyName == "mhetc90060_p14" then
	
		Form.SetSharedData("CLOUD_ADD_AUTH_FLAG" , g_sNewRegi)
		Form.OpenPopup( "mhetc90060_p8" , g_sNewRegi&"_otp", "" )	
	
	elseif sKeyName == "mhetc90060_p8" then
		
		if sRet == "ok" then
			
			'인증서 발급/재발급
			if g_sNewRegi == "new" Then
				'인증 발급시 온라인 신원확인 동의 조회
				DATAMANAGER.RequestTranData("obpds_srvc_173r")
				
			'타기관 등록
			else
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			end if
			
		else
			Form.CloseForm()
		end if
	
	elseif sKeyName == G_MERITZ_SECURITY_FILE or sKeyName == G_MERITZ_QUESTION_FILE or sKeyName == G_MERITZ_OTP_FILE or sKeyName == G_MERITZ_SOTP_FILE or sKeyName == G_MERITZ_MOTP_FILE then
		 if sRet == "ok" then
			
			'인증서 발급/재발급
			 if g_sNewRegi == "new" Then
				
				'개인/법인 모두 클라우드 인증서 발급
				 Form.OpenPopup("mhetc90150_s3" , "new" , "")
				 
			 else
				  '인증서 목록 화면
				  Form.OpenPopup("mhetc90152_p1" , "클라우드인증서" , "")
			 end if
			 
		 else
			 Form.CloseForm()
		 end if
	
	elseif sKeyName == "mhetc90150_s3" then
		if sRet == "register" then
			Form.OpenPopup("mhetc90150_p2","register","")
		elseif sRet == "new" then
			Form.CloseForm()
		else
			Form.CloseForm()
		end if
	
	elseif sKeyName == "mhetc90152_p1" then
		
		if sRet <> "" then
			if sRet == "cancel" then
				Form.CloseForm()
			else
				'sRet은 클라우드 인증서ID
				
				Form.OpenPopup("mhetc90150_s3" , "register" & "★" & sRet , "")
			end if
		end if
	
	'완료 팝업
	elseif sKeyName == "mhetc90150_p2" then
		if sRet == "register" then
			Form.CloseForm()
		end if
	
	end if
	'20240408 SWJ END
End Sub

'============================================================================
'20240408 SWJ START: 클라우드 인증
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ConnectCloud" then
		if sRet == "ok" then
			'사용자인증 시작하면 됨 (이름/전화번호/생년월일 입력하는 화면)
			Form.OpenPopup("mhetc90302" , "" , "") 'Form_OnPopupReturn : CLOUD_CHECK_CONNECT 로 리턴
		else
			Form.CloseForm()
		end if
	end if
End Sub
'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	
	'모바일OTP 인증화면에서
	'로그아웃 상태에서 520r 서비스 input을 ID로 태우지 않기 위함
	'보안카드 인증화면에도 모바일OTP발급 프로세스가 있음
'	if Cint(Container0.rdoAuthType.currentindex) == 0 then
'		Form.SetSharedData("IdRegPros", "Y")
'		Form.SetSharedData("IdRegProsAcno", Container0.contAcnt.EditAcnt.caption)
'	end if
	
	szRcno = Form.GetSharedData("CLOUD_CERT_RCNO_PIP", false)
	
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러	
	if g_sCustClsCode == "1" then
		if g_sGubunCode == "0" then '보안카드
			
			Form.OpenFramePopup( G_MERITZ_SECURITY_FILE , "individual_check" , "" )	'보안카드풀팝업
		
		'해당케이스는 삭제되었다고 함	
		elseif g_sGubunCode == "1" then '부가정보
			Form.OpenFramePopup( G_MERITZ_QUESTION_FILE , "individual_check" , "" )	'부가정보풀팝업
			
		elseif g_sGubunCode == "3" then 'OTP
			
			if g_MotpYN == "M" then
				
				if g_motpAppYN <> "00000" then
					Form.OpenPopup( "mhetc90190_p1", "" &"★"& szRcno &"★"& "N" &"★"& "", "")					'안내 팝업
					exit function
				end if
				
				'모바일otp 발급이 완료된 이후, 사설인증 프로세스로 돌아오기 위한 데이터 
				'(모바일OTP가 원장에는 등록 상태지만, 앱에 정보가 없는경우)
				'(인증화면 오픈 후에 발급화면으로 이동시킴)
				'(그래서 모바일OTP를 열 때 화면 오픈 전에 Set을 해줘도 될듯)
				'Form.SetSharedData("MeritzAuth_Security", "MOTP")
				
				Form.OpenPopup( G_MERITZ_MOTP_FILE , "motp_success" , "")	'MOTP
				
			'스마트OTP
			'elseif g_MotpYN == "Y" then
			
				'스마트OTP 화면에도 모바일OTP 발급 프로세스를 만들거라고 함
'				Form.SetSharedData("MeritzAuth_Security", "MOTP")
'				
'				if Container0.contAcnt.visible then
'					Form.SetSharedData("Meritz_OTP_RCNOPIP", Container0.contAcnt.EditRcno.caption)
'				else
'					Form.SetSharedData("Meritz_OTP_RCNOPIP", Container0.contID.EditRcno.caption)
'				end if
'				
'				Form.OpenFramePopup( G_MERITZ_SOTP_FILE , "MeritzAuth" & "★" , "")	'스마트OTP
			
			'OTP/스마트OTP
			else
				Form.OpenPopup( G_MERITZ_SOTP_FILE , "" , "")
			end if
	
		elseif g_sGubunCode == "2" then '없을경우
			Form.OpenPopup( "mhetc90190_p1", "", "")					'안내 팝업
			
		else '에러
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if
		
	'법인
	else
		if g_sGubunCode == "0" then '보안카드
			Form.OpenFramePopup( G_MERITZ_SECURITY_FILE , "" , "" )	'보안카드풀팝업
			
		elseif g_sGubunCode == "1" then '부가정보
			Form.OpenFramePopup( G_MERITZ_QUESTION_FILE , "" , "" )	'부가정보풀팝업
			
		elseif g_sGubunCode == "3" then 'OTP
			Form.OpenFramePopup( G_MERITZ_SOTP_FILE , "" , "" )	  	'일반/스마트OTP풀팝업
		
		elseif g_sGubunCode == "4" then '모바일OTP
			Form.OpenPopup( G_MERITZ_MOTP_FILE,"motp_success","")                          	'모바일 OTP
			
		elseif g_sGubunCode == "2" then '없을경우
		
			Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			
		else '에러
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
			
		end if
	end if
End Function
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)

	if sEventName == "MOTP_GETINFO_RETURN_90150" then

		mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		if Ubound(mOTPInfo) < 1 then
			exit sub
		else	
			g_motpAppYN = mOTPInfo(0)
		end if
	end if
End Sub
