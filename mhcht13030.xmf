Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_flagLine
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북	'20160426 LKM

'============================================================================
Sub Form_OnFormInit()
	szStyle	= Form.LoadConfigData("mhprc11000", "Style"	)	'현재가 스타일
		
	If szStyle = "0" Then
		linkfmHoga.linkfile = "mhprc11000_s1.xmf"
	ElseIf szStyle = "1" Then
		linkfmHoga.linkfile = "mhprc11000_s2.xmf"
	ElseIf szStyle = "2" Then
		linkfmHoga.linkfile = "mhprc11000_s3.xmf"
	Else
		linkfmHoga.linkfile = "mhprc11000_s1.xmf"
	End If

	szData = Form.GetOpenLinkData()
	if szData <> "" then
		If Left(szData, 1) = "A" Then
			g_szItemCode = Right(szData, Len(szData) - 1)
		Else
			g_szItemCode = szData		
		End If		
	else
		g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	end if	

	If g_szItemCode = "" Or g_szItemCode = null Then
		g_szItemCode = "008560" '메리츠종금증권
	End If
		
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
	'20180906 LES START KOTC상품추가
	if g_szItemMarket = "T" then
		Exit Sub
	end if
	'20180906 LES END
	
	Form.SetItemCode(g_szItemCode)	
	'Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 						' 링크화면에 종목코드 던지기
	
	g_szChrtType = "D" '일
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
	g_flagLine = false
	PeriodSet(g_szChrtType)
	RequestData()
	
	Form.SetRealBundle("1")		'PENTA13 START => 2023.09.12(플랫폼개선)
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20221005_01 HWG START : 거래소 차세대 대응
		'20180906 LES START KOTC상품추가
'		if g_szItemMarket = "T" then
'			
'			Form.Toast(0, "K-OTC 종목은 기관외인차트 사용이 불가능 합니다.", 1)
'			
'			szOsType = Form.GetSharedData("&OS_TYPE", false)
'	
'			if szOsType = "1" then
'				szRecent = Form.GetRecentHistory("1")
'				Load_RecentList(szRecent)
'			end if
'			Exit Sub
'		end if
		'20180906 LES END
		'20221005_01 HWG END
		
		RequestData()
		
	elseif sKey = "&ACR_ITEM" then
		Form.SetItemCode(sValue)
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )
		RequestData()
	
	end	if		
End Sub
'============================================================================
Function RequestData()
	If g_szItemMarket = "T" Then
		Form.Toast(0, "K-OTC 종목은 기관외인차트 사용이 불가능 합니다.", 1)
		Exit Function
	End If
	
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)

	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,g_szChrtType)  'D/W/M/Y 일/주/월/년 
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)

	DATAMANAGER.RequestTranData("ohhts_5010_001r")	
	
	If g_szItemMarket = "W" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
	Else
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
	End If
	
end Function

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  		'일
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then  	'주
		g_szChrtType = "W"
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 2 then  	'월
		g_szChrtType = "M"
		PeriodSet(g_szChrtType)
		
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "Orientation" then
		'20170120 HWG Start- 종목코드 연동
		g_szItemCode = sRet
		Form.SetItemCode(g_szItemCode)
		'20170120 HWG END
		
		tmpIndex = Form.GetSharedData("13030_period", 1 ) 
		RadioGroup0.currentindex = tmpIndex
		
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
			
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
			
		end if
	end if
End Sub

'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType, period)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   'g_sNextKey[gCurInd] = ""
'   Form.ShowAlert(sPeriodType, period)
   
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1=1:1=3...#1=1:1=3...#
   if InStr(sPeriodType, "#") > 0 then
	   sTemp = split(sPeriodType, "#")
	   sMinArr = split(sTemp[0], ":")
	   sTicArr = split(sTemp[1], ":")
	   Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 13 step 2
		   if i == 0 then	
			   j = 0
		   else
			   j = i/2
		   end if
		   
		   g_chartMinArr[j] = sMinArr[i]
		   g_chartMinFlagArr[j] = sMinArr[i+1]
		   
		   g_chartTicArr[j] = sTicArr[i]
		   g_chartTicFlagArr[j] = sTicArr[i+1]

	   next

   end if
	   
	Save_ini()

end function

'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)

   if #Count == 1 then
	   Count = "000"..Count
   elseif #Count == 2 then
	   Count = "00"..Count
   elseif #Count == 3 then
	   Count = "0"..Count
   end if

	g_sChartCnt = Count
	RequestData()
end function

'============================================================================
' 분,틱 설정파일 저장
'============================================================================
function Save_ini()
	dim sMin, sTic, sflag	
	for i = 0 to 6 
		
		Form.SetEnvData( 1, "chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "chart_min"..i, g_chartMinArr[i] )
		
		Form.SetEnvData( 1, "chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, g_chartTicArr[i] )
		
	next	
	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )

end function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)

'	Form.ShowAlert("", sIndex..":"..sPeriod)
	
	if sPeriodType= "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType= "A" then
	   g_sPeriod = CInt(g_szMinType) *60
	   g_sPeriodType = "1"
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	   
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	    g_sPeriod ="1"
	    
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	    g_sPeriod ="1"
	    
	end if
	
	sPeriod = CInt( g_sPeriod)
	if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	' 조회TR 보내기
	RequestData()	
end function

'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("netbuy")
	'Form.SetSearchType ("1:2:3:5:6")
	Form.SetSearchType ("29:1:5:6:3")	'20220922 SWJ START : 최근조회 탭 추가
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_ORIENTATION" Then
		sData = RadioGroup0.currentindex
		Form.SetSharedData("13030_period" , sData)
		Form.OpenPopup( "mhcht13030_h1.xmf" , szData , "" )
	
	' 연결정보
	elseIf sEventName = "SCREEN_MENU" Then								
		If sParam = "REG_INTR" Then									' 관심종목등록
			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			
		ElseIf sParam = "REG_WATCHING" Then							' Watching종목등록
			Form.OpenFramePopup("mhprc11020_p1" , g_szItemCode , "")
	
		ElseIf sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If
		
	'20160426 LKM START
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
    '20160426 LKM END
    
     '20220922 SWJ START : 종목선택 팝업 추가
	elseIf sEventName = "TITLE_CLICK" Then
		'20221005_01 HWG START : 거래소 차세대 대응
		Form.OpenCommonDialog("SEARCH", "29:1:5:6:3", "MAIN")
		'20221005_01 HWG END
	'20220922 SWJ END
	End If
	
End Sub
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	RequestData()	
end function

'============================================================================
Sub ChartEx0_OnScrollEnd()
	if g_szChrtType = "A" then
		DATAMANAGER.RequestNextData("ohhts_5010_002r")
	elseif g_szChrtType = "T" then
		DATAMANAGER.RequestNextData("ohhts_5010_003r")
	else
		DATAMANAGER.RequestNextData("ohhts_5010_001r")
	end if
End Sub

'============================================================================
Sub BtnLine_OnClick()
	if g_flagLine = false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath ="btn_chart01_o.9.png"
		
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath ="btn_chart01_n.9.png"
		
	end if
End Sub
'============================================================================
Sub Form_OnRefresh()
	RequestData()
End Sub
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName
	
	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'20190207 LES START - 최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 
		
		end if

		For i = 0 to szLen
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			
			if szMk <> "T" then
				Form.setItemCode(tList(i))
				exit Function
			end if
		Next
		'20190207 LES END
	else
		Form.setItemCode("008560")
	end if
End Function
