End Sub

'============================================================================
'editNum_OnEditComplete() : 연령대 계산하여 자동체크
'============================================================================
Sub editNum_OnEditComplete()
	if tonumber(rdoPersonGubun.currentindex) == 0 then
		if Len(editNum.caption) > 8 then
			editNum.caption = Mid(editNum.caption, 1, 8)
		end if
	else
		if Len(editNum.caption) > 10 then
			editNum.caption = Mid(editNum.caption, 1, 10)
		end if
	end if
	
	f_CalcAge()
End Sub

'============================================================================
' btnComplete_OnClick() : 투자성향 진단 완료 팝업 오픈
'============================================================================
Sub btnComplete_OnClick()
	Dim szGradeName
	szGradeName = cont01.tblGrade.GetCellString( 0, 3 )
	
	Form.OpenPopup("mbonl81011_p1" , szGradeName , "")
End Sub

