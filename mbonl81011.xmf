'============================================================================
'cont01_rdoAns5_OnClick(nIndex) : 설문문항 누를때마다 투자등급 계산
'============================================================================
Sub cont01_rdoAns5_OnClick(nIndex)
	if -1 < nIndex then
		if f_CheckAbleSurvey() == false then
			cont01.rdoAns5.currentindex = -1
			Exit Sub
		end if
	else
		Exit Sub
	end if
	
	f_CalcInvestGrade()
End Sub

