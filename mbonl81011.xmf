'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData( 0, szTranID )

	if szTranID	= "obcsb_acif_711r"	then	'투자설문조회
		Dim szCustClsCode
		szCustClsCode = tonumber(rdoPersonGubun.currentindex) == 0 and "1" or "2"
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CUST_CLS_CODE", 0, szCustClsCode)
		
	elseif szTranID	= "obwat_ctad_020r" then		
		if tonumber(rdoPersonGubun.currentindex) <> 0 then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CORP_YN", 0, "Y")
		end if
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID	= "obcsb_acif_711r" or szTranID	= "obwat_ctad_020r" then
		f_SetSurvey(szTranID)
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'rdoPersonGubun_OnClick(nIndex) : 개인/법인 선택에 따른 문항 변경
'============================================================================
Sub rdoPersonGubun_OnClick(nIndex)
	if tonumber(rdoPersonGubun.currentindex) == 0 then
		editNum.mask = "1,0,,,1,####-##-##,0,1,1,0,0"
	else
		editNum.mask = "1,0,,,1,###-##-#####,0,1,1,0,0"
	end if
	
	editNum.caption =  ""
	
	f_RequestTR()
End Sub

'============================================================================
'cont01_rdoAns1_OnClick(nIndex) : 설문문항 누를때마다 투자등급 계산
'============================================================================
Sub cont01_rdoAns1_OnClick(nIndex)
	if -1 < nIndex then
		if Len(editNum.caption) < 8 then
			Form.ShowAlert("알림", "이 항목은 생년월일 입력시 자동 체크 되는 항목입니다")
			cont01.rdoAns1.currentindex = -1
			Exit Sub
		end if
		
		if g_isSilence == false then
			Form.ShowAlert("알림", "이 항목은 생년월일 입력시 자동 체크 되는 항목입니다")
			
			f_CalcAge()
		end if
	end if
End Sub

'============================================================================
'cont01_rdoAns2_OnClick(nIndex) : 설문문항 누를때마다 투자등급 계산
'============================================================================
Sub cont01_rdoAns2_OnClick(nIndex)
	if -1 < nIndex then
		if f_CheckAbleSurvey() == false then
			cont01.rdoAns2.currentindex = -1
			Exit Sub
		end if
	else
		Exit Sub	
	end if
	
	f_CalcInvestGrade()
End Sub

