'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	cmbGubun.currentindex = "0"  '처음에는 일반형이 디폴트 세팅
	
	f_RequestTR()
End Sub

'============================================================================
'cmbInvest01_OnEditComplete : 정보 미제공의 경우, 진단 할 수 없음
'============================================================================
Sub cmbInvest01_OnEditComplete(iIndex)
	if tonumber(iIndex) = 2 then				'투자권유불원(정보미제공)
		cont01.visible = false
		cont02.visible = true
		
		cont01.tblGrade.SetCellString( 0, 1, "00등급")
		cont01.tblGrade.SetCellString( 0, 2, "0점" )
		cont01.tblGrade.SetCellString( 0, 3, "정보미제공" )
		
		cont02.chkInvest01.checkstate = 0
		f_ChangeBtnState()
	else		
		cont01.visible = true
		cont02.visible = false
		
		f_RequestTR()
	end if 
End Sub

