	<SCRIPT_INFO _len="1125" _ulen="1097" >
--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	lkform.linkfile = "mhtrd44510_t1"
End Sub

'============================================================================
Sub rdoType_OnClick(nIndex)
	if nIndex = 0 then
		lkform.linkfile = "mhtrd44510_t1"
	else
		lkform.linkfile = "mhtrd44510_t2"
	end if
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	Form.triggerEvent("lkform", "REQUEST", "")
	Form.triggerEvent("lkform", "CLEAR", "")
	
	if Form.GetCtlProp("edtPwd", "caption") <> "" then
		Form.triggerEvent("lkform", "PWD_CONFIRM", "")
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "ACNT_CHANGE" then
		acnt0.SetAccountInfoByAttr("nethedge", sParam) '변경 처리 후 계좌변경속성값 처리
	end if
End Sub

