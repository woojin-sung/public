'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szSavePwd
dim g_sPlain_rm
dim g_MNRC_STLM_CRNC_CLCD '입금결제통화구분코드  1 원화, 2 외화
dim g_DRNG_STLM_CRNC_CLCD '출금결제통화구분코드  1 원화, 2 외화
'============================================================================
Sub Form_OnFormInit()
	f_InitUI()
	btnPwd.bringfront("1")
End Sub


Sub btnPwd_OnClick()
	btnChange.enable = false
	if cmbAccount.caption = null or cmbAccount.caption = "" then
		Form.ShowAlert("알림", "선택할 수 있는 계좌가 없습니다.")
		Exit Sub
	end if
	Form.openPopupAnimation("pwdcheckpopup",cmbAccount.caption,"","2")
End Sub

Sub cmbAccount_ChangeAccount()
	f_InitUI()
End Sub

Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				edtPassword_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPassword.caption = ""
			else
				szCurAcc = cmbAccount.caption
				nCnt = Cint(cmbAccount.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = cmbAccount.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						cmbAccount.currentindex = i
						Exit For
					end if
				Next
				
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if
	end if
End Sub


'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Sub f_InitUI()
	g_MNRC_STLM_CRNC_CLCD = 0 '입금결제통화구분코드  1 원화, 2 외화
	g_DRNG_STLM_CRNC_CLCD = 0 '출금결제통화구분코드  1 원화, 2 외화
	Label1.caption = ""
	RadioGroup0.currentindex = -1
	Label3.caption = ""
	btnChange.enable = false
	
	if cmbAccount.caption <> null and cmbAccount.caption <> "" then
		DATAMANAGER.RequestTranData("obtre_acnt_002r") '계좌정보(영문명) 조회
	end if
End Sub

Sub f_SetNextBtnEnable()
	btnChange.enable = cmbAccount.caption <> null and cmbAccount.caption <> "" and edtPassword.caption <> null and edtPassword.caption <> "" and CInt(RadioGroup0.currentindex) <> -1
end Sub

Sub edtPassword_OnEditComplete()
'	if Len(edtPassword.caption) > 3 then
'		f_SetNextBtnEnable()
'	end if
	f_SetNextBtnEnable()
End Sub

Function f_GetRadioValue()
	dim nChangeValue
	
	if CInt(RadioGroup0.currentindex) = 0 then
		nChangeValue = "1"
	elseif CInt(RadioGroup0.currentindex) = 1 then
		nChangeValue = "2"
	else
		nChangeValue = ""
	end if

	return nChangeValue
End Function


Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_sPlain_rm = Form.GetSharedData("&PLAIN_RM" , false) '암호화 여부
	dim szPwd
	szPwd = ""
	'패스워드 암호화여부
	If g_sPlain_rm = "1" Then
		szPwd = edtPassword.caption
	Else
		szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If
	
	if szTranID = "obtre_acnt_002r" then  ' 현재결제통화 조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)

	elseif szTranID = "obtre_acnt_002a" then ' 결제통화 변경
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MDBF_VAL" , 0 , g_MNRC_STLM_CRNC_CLCD)  '현재 결제방식입금
		
		dim nChangeValue
	
		nChangeValue = f_GetRadioValue()
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MNRC_STLM_CRNC_CLCD" , 0 , nChangeValue) '변경 할 결제방식입금

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MDBF_1_VAL" , 0 , g_DRNG_STLM_CRNC_CLCD)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DRNG_STLM_CRNC_CLCD" , 0 , g_DRNG_STLM_CRNC_CLCD)
	end if
End Sub


Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID = "obtre_acnt_002r" then  ' 현재결제통화 조회
		dim sMNRC_STLM_CRNC_CLCD
		g_MNRC_STLM_CRNC_CLCD = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "MNRC_STLM_CRNC_CLCD", 0)  '입금결제통화구분코드
		g_DRNG_STLM_CRNC_CLCD = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "DRNG_STLM_CRNC_CLCD", 0)  '출금결제통화구분코드
		
		if g_MNRC_STLM_CRNC_CLCD = "1" then
			Label1.caption = "원화"
		elseif g_MNRC_STLM_CRNC_CLCD = "2" then
			Label1.caption = "외화"
		end if
		
		if g_DRNG_STLM_CRNC_CLCD = "1" then
			Label3.caption = "원화"
		elseif g_DRNG_STLM_CRNC_CLCD = "2" then
			Label3.caption = "외화"
		end if
		
	elseif szTranID = "obtre_acnt_002a" then ' 결제통화 변경
		Form.ShowAlert( "알림" , "해외CFD 결제통화 변경이 완료되었습니다.")
		f_InitUI()
	end if
End Sub

Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null or Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrMsg)
	end if
End Sub

'============================================================================
Sub btnChange_OnClick()
	if edtPassword.caption = "" or edtPassword.caption == null then
		Form.MsgBox("알림", "비밀번호를 입력해주세요.", "", 0)
		Exit Sub
	end if
	
	dim nChangeValue
	
	if g_MNRC_STLM_CRNC_CLCD = f_GetRadioValue() then
		Form.ShowAlert("알림", "변경하실 결제방식이 현재 결재방식과 동일합니다.")
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData("obtre_acnt_002a") '계좌정보(영문명) 조회
End Sub


'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	f_SetNextBtnEnable()
End Sub

