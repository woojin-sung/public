'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	
	szData = Form.GetOpenLinkData()
	
	if szData = null or trim(szData) = "" then
		exit Sub
	end if
	
	szArrData = split(szData, "★")
	
	

	nArrCnt = #szArrData
	
	if nArrCnt > 3 then
		g_szLinkGbn = szArrData(0)

		g_szDupSel = szArrData(1)
		
		szContData = szArrData(2)
		szContData2 = szArrData(3)
		
		
		szSavaData1 = ""
		szSavaData2 = ""
		if #szArrData > 4 then
			szSavaData1 = szArrData(4)
		end if
		
		if #szArrData > 5 then
			szSavaData2 = szArrData(5)
		end if
		
		if g_szDupSel = "1" then
			szContData = "전체`" & szContData
		end if
		
		g_arrContent = Convert_StringToArr(szContData, "`")
		
		nArrCnt = #g_arrContent
		
		g_arrContent_Check = {}
		for i = 0 to nArrCnt-1
			if instr(szSavaData1, g_arrContent(i)) > 0 then
				g_arrContent_Check(i) = "1"
			else
				g_arrContent_Check(i) = "0"
			end if
		next
		
		g_arrContent2 = Convert_StringToArr(szContData2, "`")
		
		nArrCnt = #g_arrContent2
		
		g_arrContent2_Check = {}
		
		for i = 0 to nArrCnt-1
			if instr(szSavaData2, g_arrContent2(i)) > 0 then
				g_arrContent2_Check(i) = "1"
			else
				g_arrContent2_Check(i) = "0"
			end if
		next
	end if
	
	Init_Control()
	Init_Content()
End Sub

'===============================================
' imgBack_OnClick
'===============================================
Sub imgBack_OnClick()
End Sub

'============================================================================
Sub contBg_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelBtn(nIndex, sCellID)
End Sub

'============================================================================
Sub contBg_Pannel1_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelList(nIndex, sCellID)
End Sub

'============================================================================
Sub contBg_btnOk_OnClick()
	szContent0 = Convert_ChkArrToString(g_arrContent, g_arrContent_Check, "`")
	szContent1 = Convert_ChkArrToString(g_arrContent2, g_arrContent2_Check, "`")
	
	szReturnData = szContent0 & "★" & szContent1
	Form.SendReturnToParent("50500_P1_RETURN_DATA_"&g_szLinkGbn, szReturnData)
	Form.CloseForm()
End Sub

'============================================================================
Sub contBg_btnCancel_OnClick()
	Clear_Content("0")
	Clear_Content("1")
	
	szIdx = 3
	g_arrContent2_Check(szIdx) = "1"
	
	contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl3", 1, g_szBtnImg_Select)

End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

