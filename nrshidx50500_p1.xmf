Function Init_Control()
	contBg.btnCancel.caption = "초기화"
	contBg.btnOK.caption = "검색"
	
	contBg.lblGuideLine.bgcolor = g_szLineColor_Title
	
	contBg.lblSubTitle0.paddinginfo = "0,0,0,0"
	contBg.lblSubTitle1.paddinginfo = "0,0,0,0"
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function DisplaySetting_Content()
'	contBg.top = g_nForm_Height - g_nContBg_Height 
'	contBg.height = g_nContBg_Height
'	
'	contBg.btnCancel.top = g_nContBg_Height - g_nBottomBtn_Height
'	contBg.btnOK.top = g_nContBg_Height - g_nBottomBtn_Height
'	
'	if szGbn = "0" then
'		left = 0
'		top = g_nForm_Height - g_nContBg_Height + g_nContBg_Title_Height
'	
'	elseif szGbn = "1" then
'		left = 0
'		top = g_nForm_Height - g_nContBg_Height + g_nContBg_Title_Height
'	end if

	nTotalHeight = 102 + g_nPannel0_Height + 45 + g_nPannel1_Height + 10 + 60
	contBg.top = 755 - nTotalHeight
	contBg.height = nTotalHeight+5
	
	contBg.lblSubTitle1.top = 102 + g_nPannel0_Height + 19
	contBg.Pannel1.top = 102 + g_nPannel0_Height + 19 + 26
	
	contBg.btnCancel.top = 102 + g_nPannel0_Height + 19 + 26 + g_nPannel1_Height + 10
	contBg.btnOk.top = 102 + g_nPannel0_Height + 19 + 26 + g_nPannel1_Height + 10
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Content(szGbn)
	
	nArrCnt = #g_arrContent
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	contBg.Pannel0.rowcount = nPannelRowCnt
	
	g_nPannel0_Height = (44 * nPannelRowCnt) + (10 * (nPannelRowCnt-1)) + 1
	contBg.Pannel0.height = g_nPannel0_Height
	
	nArrIdx = 0
	szData = ""
	
	for i = 0 to nPannelRowCnt - 1
		if instr(g_arrContent(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent(nArrIdx)
		end if
		
		if g_arrContent_Check(nArrIdx) = "1" then
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Select)
		else 
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
		end if
	

		contBg.Pannel0.SetCellValue( "lbl0", i, szData)	
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contBg.Pannel0.SetCellVisible("lbl1",i,false)
			contBg.Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
	
		if instr(g_arrContent(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent(nArrIdx)
		end if
		
		if g_arrContent_Check(nArrIdx) = "1" then
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Select)
		else 
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)
		end if
		
		
		contBg.Pannel0.SetCellValue( "lbl1", i, szData)	
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contBg.Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
		
		if instr(g_arrContent(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent(nArrIdx)
		end if
		
		if g_arrContent_Check(nArrIdx) = "1" then
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Select)
		else 
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)
		end if
		
		contBg.Pannel0.SetCellValue( "lbl2", i, szData)	
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next

	nArrCnt = #g_arrContent2
	
	nPannelRowCnt = Cint(nArrCnt / 2)
	if (nArrCnt mod 2) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	contBg.Pannel1.rowcount = nPannelRowCnt
	
	g_nPannel1_Height = (44 * nPannelRowCnt) + (10 * (nPannelRowCnt-1)) + 1
	contBg.Pannel1.height = g_nPannel1_Height

	nArrIdx = 0
	szData = ""
	for i = 0 to nPannelRowCnt - 1
		if instr(g_arrContent2(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent2(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent2(nArrIdx)
		end if
		
		if g_arrContent2_Check(nArrIdx) = "1" then
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Select)
		else 
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
		end if
		
		contBg.Pannel1.SetCellValue( "lbl0", i, szData)	
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contBg.Pannel0.SetCellVisible("lbl3",i,false)
			Exit for
		end if
	
		if instr(g_arrContent2(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent2(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent2(nArrIdx)
		end if
		
		if g_arrContent2_Check(nArrIdx) = "1" then
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl3", i, g_szBtnImg_Select)
		else 
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl3", i, g_szBtnImg_Normal)
		end if
		
		contBg.Pannel1.SetCellValue( "lbl3", i, szData)	
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	DisplaySetting_Content()
End Function

Function Clear_Content(szGbn)
	
	if szGbn = "0" then
		nArrCnt = #g_arrContent
		
		nPannelRowCnt = Cint(nArrCnt / 3)
		if (nArrCnt mod 3) > 0 then
			nPannelRowCnt = nPannelRowCnt + 1
		end if 
		
		nArrIdx = 0
		
		for i = 0 to nPannelRowCnt - 1
			g_arrContent_Check(nArrIdx) = "0"
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
			
			g_arrContent_Check(nArrIdx) = "0"
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
			
			g_arrContent_Check(nArrIdx) = "0"
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
		next
		
		if g_szDupSel = "1" then
			g_arrContent_Check(0) = "1"
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
		end if
		
	elseif szGbn = "1" then
		nArrCnt = #g_arrContent2
		
		nPannelRowCnt = Cint(nArrCnt / 2)
		if (nArrCnt mod 2) > 0 then
			nPannelRowCnt = nPannelRowCnt + 1
		end if 
		
		nArrIdx = 0

		for i = 0 to nPannelRowCnt - 1
			g_arrContent2_Check(nArrIdx) = "0"
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
			
			g_arrContent2_Check(nArrIdx) = "0"
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl3", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
		next
		
'		g_arrContent2_Check(2) = "1"
'		contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", 2, g_szBtnImg_Select)
		
	end if
	
End Function

Function DisplaySetting_PannelBtn(nRowIdx, szCtlName)
	nCnt = nRowIdx * 3
	if szCtlName = "lbl0" then
		nCnt = Cint(nCnt) + 0
	elseif szCtlName = "lbl1" then
		nCnt = Cint(nCnt) + 1
	elseif szCtlName = "lbl2" then
		nCnt = Cint(nCnt) + 2
	end if
	
	if #g_arrContent_Check < nCnt+1 then
		Exit Function
	end if
	
	if g_szDupSel = "1" then
		if nCnt = 0 then
			Clear_Content("0")
			
'			g_arrContent_Check(nCnt) = "1"
'			contBg.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
		else
			if g_arrContent_Check(0) = "1" then
				g_arrContent_Check(0) = "0"
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Normal)
			end if
			
			if g_arrContent_Check(nCnt) = "0" then
				g_arrContent_Check(nCnt) = "1"
				contBg.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
			else 
				g_arrContent_Check(nCnt) = "0"
				contBg.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
			end if
			
			szYN = Return_AllChkYN(g_arrContent_Check)
			
			if szYN = "Y" then
				Clear_Content("0")
			
'				g_arrContent_Check(0) = "1"
'				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
			end if
			
			szYN = Return_ClearChkYN(g_arrContent_Check)
			
			if szYN = "Y" then
				Clear_Content("0")
			
'				g_arrContent_Check(0) = "1"
'				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
			end if
		end if

	else
		if g_arrContent_Check(nCnt) = "0" then
			g_arrContent_Check(nCnt) = "1"
			contBg.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
		else 
			g_arrContent_Check(nCnt) = "0"
			contBg.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
		end if
	end if
End Function

Function DisplaySetting_PannelList(nRowIdx, szCtlName)
	nCnt = nRowIdx * 2
	if szCtlName = "lbl0" then
		nCnt = Cint(nCnt) + 0
	elseif szCtlName = "lbl3" then
		nCnt = Cint(nCnt) + 1
	end if
	
	if g_arrContent2_Check(nCnt) = "1" then
		g_arrContent2_Check(nCnt) = "0"
		contBg.Pannel1.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
	else
		Clear_Content("1")
		
		g_arrContent2_Check(nCnt) = "1"
		contBg.Pannel1.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
	end if
End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 체크배열 초기화
'===============================================
Function Clear_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "0"	
	next 
End Function

'===============================================
' 체크배열 전체선택
'===============================================
Function All_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "1"	
	next 
End Function

'===============================================
' 배열 인덱스 추출
'===============================================
Function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData = null or arrData = "" then
		return nReturn
	end if
	
	if szData = null or szData = "" then
		return nReturn
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = szData then
			nReturn = i
			exit for
		end if	
	next 
	
	return nReturn
End Function

Function Return_AllChkYN(arrData)
	if arrData = null or arrData = "" then
		return "N"
	end if
	
	nArrCnt = #arrData
	for i = 1 to nArrCnt-1
		if arrData(i) = "0" then
			return "N"
		end if	
	next 
	
	return "Y"
End Function

Function Return_ClearChkYN(arrData)
	if arrData = null or arrData = "" then
		return "N"
	end if
	
	nArrCnt = #arrData
	for i = 1 to nArrCnt-1
		if arrData(i) = "1" then
			return "N"
		end if	
	next 
	
	return "Y"
End Function



