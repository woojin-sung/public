				<LABEL name="LblQ13A4" caption="원금기준 ±100% 범위" valign="0" multiline="1" ly_vert="40,2515,315,32,1" />
				<LABEL name="LblQ13A5" caption="원금 초과이익(또는 초과손실) 범위" valign="0" multiline="1" ly_vert="40,2551,315,32,1" />
				<BUTTON name="BtnQ13A1" btnimage="alpha" ly_vert="14,2403,346,36,1" />
				<BUTTON name="BtnQ13A2" btnimage="alpha" ly_vert="14,2439,346,36,1" />
				<BUTTON name="BtnQ13A3" btnimage="alpha" ly_vert="15,2475,344,36,1" />
				<BUTTON name="BtnQ13A4" btnimage="alpha" ly_vert="15,2511,344,36,1" />
				<BUTTON name="BtnQ13A5" btnimage="alpha" ly_vert="15,2547,344,36,1" />
				<LABEL name="lblQuestion14" fontsize="2" fontstyle="01" caption="13. 감내할 수 있는 손실 수준
        (투자위험 감수능력)" valign="0" multiline="1" ly_vert="10,2598,355,51,1" />
				<IMAGE name="ImgQ14A1" autosize="1" ly_vert="20,2649,24,24,1" />
				<IMAGE name="ImgQ14A2" autosize="1" ly_vert="20,2685,24,24,1" />
				<IMAGE name="ImgQ14A3" autosize="1" ly_vert="20,2737,24,24,1" />
				<IMAGE name="ImgQ14A4" autosize="1" ly_vert="20,2773,24,24,1" />
				<LABEL name="LblQ14A1" caption="투자원금 보전을 선호함" valign="0" multiline="1" ly_vert="40,2653,315,32,1" />
				<LABEL name="LblQ14A2" caption="투자원금에서 최소한의 손실만을 감수할 수 있음" valign="0" multiline="1" ly_vert="40,2685,315,52,1" />
				<LABEL name="LblQ14A3" caption="투자원금 중 일부의 손실을 감수할 수 있음" valign="0" multiline="1" ly_vert="40,2741,315,32,1" />
				<LABEL name="LblQ14A4" caption="기대수익이 높다면 위험이 높아도 상관하지 않음" valign="0" multiline="1" ly_vert="40,2767,315,52,1" />
				<BUTTON name="BtnQ14A1" btnimage="alpha" ly_vert="15,2649,355,36,1" />
				<BUTTON name="BtnQ14A2" btnimage="alpha" ly_vert="15,2685,344,52,1" />
				<BUTTON name="BtnQ14A3" btnimage="alpha" ly_vert="15,2737,344,36,1" />
				<BUTTON name="BtnQ14A4" btnimage="alpha" ly_vert="15,2763,344,52,1" />
				<CHKBUTTON name="ChkQ8A1" visible="0" chkcaption="은행 CD, 국채, 지방채, 보증채, MMF 등" unchkcaption="은행 CD, 국채, 지방채, 보증채, MMF 등" ly_vert="400,115,100,32,0" />
				<CHKBUTTON name="ChkQ8A2" visible="0" chkcaption="금융채, 신용도가 높은 회사채, 채권형펀드, 원금보장형 ELS 등" unchkcaption="금융채, 신용도가 높은 회사채, 채권형펀드, 원금보장형 ELS 등" ly_vert="400,139,100,32,0" />
				<CHKBUTTON name="ChkQ8A3" visible="0" chkcaption="신용도 중간 등급의 회사채, 원금의 일부만 보장되는 ELS, 혼합형 펀드 등" unchkcaption="신용도 중간 등급의 회사채, 원금의 일부만 보장되는 ELS, 혼합형 펀드 등" ly_vert="400,165,100,32,0" />
				<CHKBUTTON name="ChkQ8A4" visible="0" chkcaption="주식, 원금이 보장되지 않는 ELS, 신용도가 낮은 회사채, 시장수익률 수준의 수익을 추구하는 주식형펀드 등" unchkcaption="주식, 원금이 보장되지 않는 ELS, 신용도가 낮은 회사채, 시장수익률 수준의 수익을 추구하는 주식형펀드 등" ly_vert="400,194,100,32,0" />
				<CHKBUTTON name="ChkQ8A5" visible="0" chkcaption="ELW, 선물옵션, 시장수익률 이상의 수익을 추구하는 주식형펀드, 파생상품펀드, 주식 신용거래 등" unchkcaption="ELW, 선물옵션, 시장수익률 이상의 수익을 추구하는 주식형펀드, 파생상품펀드, 주식 신용거래 등" ly_vert="400,227,100,32,0" />
				<TABLE name="tblTry" insidelinecolor="102:255255255" colcount="2" rowcount="1" outline="0000" designorder="1" ly_vert="10,0,310,20,1" >
					<COL_INFO ly_vert_width="110,200" />
					<ROW_INFO ly_vert_height="20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" valign="0" halign="0" line="0,0" caption="당일진단 회차 :" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" valign="0" halign="0" line="0,0" fontstyle="01" impidxs="" />
