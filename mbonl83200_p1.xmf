	<SCRIPT_INFO _len="4606" _ulen="4390" >
'============================================================================
' 01. 화 면 명 : 공개매수
' 02. 화면설명 : 공개매수
' 03. 작    성 : 2023. 06. 01. 정지환
'============================================================================
Dim g_tData
'============================================================================
Sub Form_OnFormInit()
	dim szData 
	szData = Form.GetOpenLinkData( )
	if szData <> "" and szData <> null then
		g_tData = Split(szData , "★")
		
		DATAMANAGER.RequestTranData( "obibk_tbmn_001r" )
	end if
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 보안매체 처리하기 위한 TR 입력
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obibk_tbmn_001r" then
		
		if g_tData(0) == "01" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "" )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 			, 0 , g_tData(1) )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TOB_SRNO" 		, 0 , g_tData(2) )
		end if
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obibk_tbmn_001r" then
	
		dim szBuyNm, szAbwrNm, szQty, szStaDate, szFinDate, szClsCode, szDmprPrc, szTkwrDt, szPrvsDt, szCntt, szClsNm
		
		szBuyNm 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RQST_TRGT_INNM" 		, 0 )	'공개매수자
		szAbwrNm 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TRGT_STCK_ISNM" 		, 0 )	'대상주식
		szQty	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TOB_QTY" 			, 0 )	'공개매수예정주식수
		szStaDate 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "APLT_STA_DATE" 		, 0 )	'공개매수기간
		szFinDate 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "APLT_FIN_DATE" 		, 0 )	'공개매수기간
		szClsCode	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PRVS_CLS_CODE" 		, 0 )	'공개매수방식
		szDmprPrc 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "DMPR_PRC" 			, 0 )	'공개매수가격
		szTkwrDt	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TKWR_DATE" 			, 0 )	'출고일
		szPrvsDt	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CASH_PRVS_DATE" 		, 0 )	'결제일
		szCntt	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CNTT" 				, 0 )	'경쟁률
		szKorIssuNm 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "KOR_ISSU_ABWR_NAME" 	, 0 )	
		
		if szClsCode == "01" then
			szClsNm = "현금매수"
		elseif szClsCode == "02" then
			szClsNm = "주식교환"
		end if
		
		lblBuyNm.caption 		= szBuyNm
		lblAbwrNm.caption 	= szAbwrNm & "(" & mid(g_tData(1),2,6) & ")" 
		lblQty.caption 		= szQty
		lblDate.caption 		= szStaDate & szFinDate
		lblClsCode.caption 	= szClsNm
		lblDmprPrc.caption 	= szDmprPrc
		lblTkwrDt.caption 	= szTkwrDt
		lblPrvsDt.caption 	= szPrvsDt
		lblCntt.caption 		= szCntt	
		
		
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	Form.ShowAlert("알림", szErrMsg.."("..szSubErr..")" )

End Sub
'============================================================================
Sub btnBGUP_OnClick()
	Form.CloseForm("")
End Sub

'============================================================================
Sub Form_OnFormClose()

End Sub

'============================================================================
Sub btnOkWide_OnClick()
	Form.CloseForm( )
End Sub




'============================================================================
Sub btnExplain_OnClick()
	dim nType, szFileName

	
	szFileName = "IBKTOB" & g_tData(1) & "01" & Cint(g_tData(2)) & ".pdf"
	
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	if nType == "0" then
		szUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"& szFileName
	elseif nType == "1" then
		szUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"& szFileName
	end if
	Form.OpenPdfViewer(szUrl, "공개매수설명서")
End Sub

