''----------------------------------------------------------------------------
'' 01. 화 면 명 : 선옵현재가
'' 02. 화면설명 : 선옵현재가 미결제약정별 탭화면
'' 03. 작    성 : 2017.04.30 LES
''----------------------------------------------------------------------------
'
''****************************************************************************
''               G  L  O  B  A  L       V  A  R  I  A  B  L  E
''****************************************************************************
'
Dim g_szItemCode, g_ItemMarket, g_szgrdHeader1, g_szgrdHeader2

''============================================================================

Sub Form_OnFormInit()

	Set_Position()
	Set_Cont()
	
	DATAMANAGER.RequestTranData("ohhts_3000_003r")
	DATAMANAGER.RequestTranData("ohhts_3000_021r")
	
	
		
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")	
	
	'MarketType Default : "CM"
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CM"			
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	curIndex = RadioGroup0.currentindex 
		
	if szTranID = "ohhts_3000_003r" then
		if curIndex = "0" then '라디오버튼 : K200선물
			DATAMANAGER.SetDataValue(0, "ohhts_3000_003r", "InBlock1", "FID_INPUT_ISCD" , 0 , "CK2")
			DATAMANAGER.SetDataValue(0, "ohhts_3000_003r", "InBlock1", "FID_INPUT_ISCD2" ,0 , "CF01")
			
		elseif curIndex = "1" then '라디오버튼 : 미국달러선물
			DATAMANAGER.SetDataValue(0, "ohhts_3000_003r", "InBlock1", "FID_INPUT_ISCD", 0 , "CUS")
			DATAMANAGER.SetDataValue(0, "ohhts_3000_003r", "InBlock1", "FID_INPUT_ISCD2", 0 , "CI01")
		end if
	
	elseif szTranID = "ohhts_3000_021r" then
		if curIndex = "0" then '라디오버튼 : K200선물
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "InBlock1", "FID_INPUT_ISCD" , 0 , "CK2")
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "InBlock1", "FID_INPUT_ISCD2" , 0 , "CF01")
			
		elseif curIndex = "1" then '라디오버튼 : 미국달러선물
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "InBlock1", "FID_INPUT_ISCD", 0 , "CUS")
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "InBlock1", "FID_INPUT_ISCD2", 0 , "CI01")
			
		end if
		
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	DATAMANAGER.CancelRealData("ohhts_invr_cntg")

	if szTranID = "ohhts_3000_003r" then
		
			'매도 금액
		    Frgn_medo  = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , 0 ) ) / 100, 0)
		    Prsn_medo  = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , 0 ) ) / 100, 0)
		    Orgn_medo  = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , 0 ) ) / 100, 0)
		   	'매수금액	    
		    Frgn_mesu = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , 0 ) ) / 100, 0)
		    Prsn_mesu = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , 0 ) ) / 100, 0)
		    Orgn_mesu = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , 0 ) ) / 100, 0)
		    ' 순매수 금액
		    Frgn_sun = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , 0 ) ) / 100, 0)
		    Prsn_sun = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , 0 ) ) / 100, 0)
		    Orgn_sun = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_003r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , 0 ) ) / 100, 0)
		    
		      
		    Table1.SetCellString(1, 1, Prsn_medo)
		    Table1.SetCellString(2, 1, Prsn_mesu)
		    Table1.SetCellString(3, 1, Prsn_sun)
		    
		    Table1.SetCellString(1, 2, Frgn_medo)
		    Table1.SetCellString(2, 2, Frgn_mesu)
		    Table1.SetCellString(3, 2, Frgn_sun)
		    
		    Table1.SetCellString(1, 3, Orgn_medo)
		    Table1.SetCellString(2, 3, Orgn_mesu)
		    Table1.SetCellString(3, 3, Orgn_sun)
		   
	elseif szTranID = "ohhts_3000_021r" then
		
		DATAMANAGER.RequestRealData("ohhts_invr_cntg")
		    
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' 0 : K200선물 1: 미달러선물
	strIndex = RadioGroup0.currentindex
	
	if szTranID = "ohhts_invr_cntg" then
		if strIndex = "0" then
			DATAMANAGER.SetDataValue(1, "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , "CF01CK2")
		
		elseif strIndex = "1" then
			DATAMANAGER.SetDataValue(1, "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , "CI01CUS")
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	'if szTranID = "ohhts_invr_cntg" then
		'Form.ShowAlert("test", "test")
	'end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")

		'MarketType Default : "CM"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"	
		end if
		
		RadioGroup0_OnClick(nIndex)
		
	end	if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
		
		'MarketType Default : "CM"
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
		
		
		RadioGroup0_OnClick(nIndex)
		
	End If
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
		
	DATAMANAGER.RequestTranData("ohhts_3000_003r")
	DATAMANAGER.RequestTranData("ohhts_3000_021r")
	
End Sub

'============================================================================

Sub Set_Position()

'계약
Table0.left = 0
Grid0.left =  0

'금액
Table1.left = 0
Grid1.left =  0

End Sub

'=============================================================================
Sub Set_Cont()

	strIndex = Combo0.currentindex
	
	if strIndex = "0" then
		Table0.visible = true
		Grid0.visible = true
	
		Table1.visible = false
		Grid1.visible = false
	
	elseif strIndex = "1" then
		Table0.visible = false
		Grid0.visible = false
	
		Table1.visible = true
		Grid1.visible = true
	
	end if
	

End Sub


'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Set_Cont()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID = "ohhts_3000_021r" then
		
		szCnt = CInt(DATAMANAGER.GetDataCount(0, "ohhts_3000_021r" , "OutBlock1"))
		
		
		for i = 0 to szCnt -1
			P_sun = Round( DATAMANAGER.GetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN", i) / 100 )
			F_sun = Round( DATAMANAGER.GetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN", i) / 100 )
			O_sun = Round( DATAMANAGER.GetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN", i) / 100 )
			
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN", i, P_sun)
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN", i, F_sun)
			DATAMANAGER.SetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN", i, O_sun)
			'Form.ShowAlert("P_sun", DATAMANAGER.GetDataValue(0, "ohhts_3000_021r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN", 0))
		next
	
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	if szTranID = "ohhts_invr_cntg" then
	
		'거래금액 단위변환
		p_medo	= Round( DATAMANAGER.GetDataValue(1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SELN_TR_PBMN", 0) / 100 )
		p_mesu	= Round( DATAMANAGER.GetDataValue(1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SHNU_TR_PBMN", 0) / 100 )
		p_sun	= Round( DATAMANAGER.GetDataValue(1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_TR_PBMN", 0) / 100 )
		
		f_medo	= Round( DATAMANAGER.GetDataValue(1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SELN_TR_PBMN", 0) / 100 )
