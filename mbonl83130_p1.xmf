'============================================================================
' 01. 화 면 명 : ELS/DLS청약_청약신청팝업
' 02. 화면설명 : ELS/DLS청약_청약신청팝업
' 03. 작    성 : 2016. 03. 05. 유창재
' 04. 수    정 : 2020. 09. 16. 성주혁 MTS 메모리 보안 v0001
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
Dim g_szPW			'비밀번호
Dim g_Chk0			'투자설명서 동의여부(Chk0)
Dim g_ngoMoney		'청약금액
Dim g_nAmount			'청약주수
Dim g_szYesorNo		'청약취소여부
Dim g_szAbleMoney		'출금가능액

Dim g_dPsntDate		'현재일자
Dim g_sSbscIssuClsCode	'청약종목구분코드
Dim g_sIscd			'종목코드
Dim g_sMaul_cls_code	'투자설명서교부여부
Dim g_Download		'투자설명서 다운로드여부
Dim g_lSbscUnpr		'청약단가
Dim g_lSbscAbleQty	'청약가능수량
Dim g_lSbscMinQty		'청약최소수량
Dim g_dSbscMgrt		'증거금률

Dim g_szOSTest			'OS Type, 1:안드로이드, 2:IOS
Dim g_szOSType			'OS Type, 안드로이드 = 157, IOS = 156

Dim g_rfnd_acno, g_wrhs_acno

Dim g_lRealAsgmStcn	'실배정수량
Dim g_lSppmScDlStcn	'추납예정주수
Dim g_lSppmScDlAmt	'추납예정금액
Dim g_lSbscApltSrno	'청약신청일련번호

Dim g_lSppmSrno		'추납 일련번호
Dim plain_rm			'메모리평문 적용유무

g_nAmount = 0

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Setpass() : 청약 신청 함수
'============================================================================
Function Setpass()

	if CDbl(g_lSppmSrno) > 0 then		
		Form.MsgBox( "계좌확인", "이미 추가납입 처리된 내역이 존재합니다." , "", 6 )
		Exit Function
	end if
	
	g_nAmount = edtQty.caption
	
	'DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , g_szOSType)		'채널유형구분코드(OS별 입력값 안드로이드:157, IOS:156)
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock1", "PROS_CLS_CODE" , 0 , "")		'처리구분코드-사용안함.
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock1", "CONT_CLS_CODE" , 0 , "4")		'접촉 구분코드 1.창구 4.온라인
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock1", "ACNO" , 0 , acnt0.total)			'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock1", "ASNO" , 0 , acnt0.sequence)		'일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)			'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock1", "SNOT_EMPNO" , 0 , "")			'파출직원번호
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock2", "SBSC_DATE" , 0 ,g_szList(0))			'청약일자
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock2", "SBSC_ISSU_SRNO" , 0 , g_szList(1))	'청약종목일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock2", "SBSC_APLT_SRNO" , 0 , g_lSbscApltSrno )			'청약신청일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock2", "SPPM_SRNO" , 0 , "0" )			'추납 일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock2", "SPPM_STCN" , 0 , g_nAmount)		'추납 주수
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001a", "InBlock2", "CNCL_YN" , 0 , "N")				'취소여부
		
	DATAMANAGER.SetEventFlag( "obibk_pssm_001a", "A" )
	DATAMANAGER.RequestTranData( "obibk_pssm_001a" )
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	'변수초기화	
	g_lSbscUnpr = 0		'청약단가
	g_lSbscAbleQty = 0	'청약가능수량
	g_lSbscMinQty = 0		'청약최소수량
	g_dSbscMgrt = 0		'증거금률
	g_ngoMoney = 0
	g_lRealAsgmStcn = 0	'실배정수량
	
	'컨트롤초기화
	edtQty.caption = ""
	tbl0.SetCellString( 6 , 1, 0 ) 	'청약금액
	tbl0.SetCellString( 7 , 1, 0 ) 	'증거금
		
	Form.SetScreenName( "추가납입 신청" )
	
	g_szData = Form.GetOpenLinkData()
	
	'테스트임시
	'청약일자, 청약종목일련번호
	'g_szData = ''
	'g_szData = "20161101" & "★" & "1"
	'테스트임시
	
	g_szList = Split( g_szData, "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	
	g_dPsntDate = Left(Form.calcDateTime( nYear, nMonth, 0, nHour, nMinute, nSecond ),8)	'현재일자
	
	g_szOSTest = Form.GetSharedData( "&OS_TYPE", false )
	
	if g_szOSTest == "1" then
		g_szOSType = 157			'안드로이드
	else
		g_szOSType = 156			'IOS
	end if
	
	DATAMANAGER.RequestTranData( "obibk_pssb_001r" )
	DATAMANAGER.RequestTranData( "obibk_psif_001r" )
		
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obibk_pssb_001r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ACNO" , 0 , acnt0.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ASNO" , 0 , acnt0.sequence )	'일련번호
		
	elseif szTranID == "obibk_pssb_029r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "APLT_DATE" , 0 , g_dPsntDate )		'신청일자(현재날자)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ACNO" , 0 , acnt0.total )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ASNO" , 0 , acnt0.sequence )			'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "SBSC_ISSU_CLS_CODE" , 0 , g_sSbscIssuClsCode )	'청약종목구분코드

	elseif szTranID == "obibk_psif_001r" then			'청약정보조회
		DATAMANAGER.SetDataValue( 0 , "obibk_psif_001r", "InBlock1", "SBSC_DATE" , 0 , g_szList(0) )		'청약일자
		DATAMANAGER.SetDataValue( 0 , "obibk_psif_001r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , g_szList(1) )	'청약종목일련번호
		
	elseif szTranID == "obcsb_oimf_625r" then			'보안매체 확인을 위한 TR
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = acnt0.total
		sACNO_PWD = g_szPW
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		
	elseif szTranID == "obibk_pssm_001r" then			'공모주 청약 추가납입 조회
	
		DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001r", "InBlock1", "SBSC_DATE" , 0 , Left(g_szList(0), 6) )		'청약일자
		DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , g_szList(1) )	'청약종목일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001r", "InBlock1", "ACNO" , 0 , acnt0.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001r", "InBlock1", "ASNO" , 0 , acnt0.sequence )	'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001r", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )	'접촉구분코드
	end if
	
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()
	
	'v0001
	'AS-IS
	'g_szPW = Form.GetEncData( edtPW.caption )
	
	'TO-BE
	if plain_rm =="1" then
		g_szPW = edtPW.caption
	else
	     g_szPW = Form.GetEncData( edtPW.caption )
	end if
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssm_001r", "InBlock1", "ACNT_PWD" , 0 , g_szPW )
	DATAMANAGER.RequestTranData( "obibk_pssm_001r" )
	
	DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	Call Form_OnFormInit()

	DATAMANAGER.RequestTranData( "obibk_pssb_001r" )
	
End Sub
'============================================================================
' rdoQty_OnClick(nIndex) : 라디오 버튼 선택에 따른 청약주수 선택
'============================================================================
Sub rdoQty_OnClick(nIndex)
	Dim tmp_sppm_amt
	tmp_sppm_amt = 0	
	
	Select Case nIndex
		Case 0		'10주
			g_nAmount = g_nAmount + 10
			edtQty.caption = g_nAmount
'			edtQty.enable = false
		Case 1		'100주
			g_nAmount = g_nAmount + 100
			edtQty.caption = g_nAmount
'			edtQty.enable = false
		Case 2		'1000주
			g_nAmount = g_nAmount + 1000
			edtQty.caption = g_nAmount
'			edtQty.enable = false
		Case 3		'10000주
			g_nAmount = g_nAmount + 10000
			edtQty.caption = g_nAmount
'			edtQty.enable = false
		Case 4		'정정
			g_nAmount = 0
			edtQty.caption = ""
			edtQty.enable = true
			edtQty.SetShowKeypad( true )		
	End Select
	
	if g_nAmount > 0 then
		'추가납입금액(수량*단가) setting
		tmp_sppm_amt = g_nAmount * g_lSbscUnpr
		'tmp_sppm_amt = tmp_sppm_amt * g_dSbscMgrt / 100
		tbl0.SetCellString( 6 , 1, tmp_sppm_amt )
		
		'최종배정수량 setting		
		tbl0.SetCellString( 7 , 1, g_lRealAsgmStcn + g_nAmount )
	elseif g_nAmount == 0 then
		tbl0.SetCellString( 6 , 1, 0 )
		tbl0.SetCellString( 7 , 1, g_lRealAsgmStcn )
	end if

End Sub
'============================================================================
' btnOK_OnClick()
'============================================================================
Sub btnOK_OnClick()
	Dim szData
	
	if CDbl(edtQty.caption) > Cdbl(g_lSppmScDlStcn) then
		Form.ShowAlert( "알림", "추가납입가능수량을 확인하십시오.")
		Exit Sub
		
	elseif CDBL(tbl0.GetCellString( 0, 1)) < CDBL(tbl0.GetCellString( 6, 1)) then
		Form.ShowAlert( "알림", "출금가능금액을 확인하십시오.")
		Exit Sub
	end if

	if g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")
		Exit Sub
	elseif edtQty.caption == "" then
		Form.ShowAlert( "알림", "청약금액을 입력해주세요.")
		Exit Sub	
	end if
	
	DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'추가납입신청
			Setpass()
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if	
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'Dim rfnd_acno, wrhs_acno
	Dim tmp_sbsc_amt
	Dim msg_succ, tmp_SbscApltSrno, tmp_SbscStcn
	
	tmp_sbsc_amt = 0
	msg_succ = ""
	tmp_SbscApltSrno = 0
	tmp_SbscStcn = 0
	
	if szTranID == "obibk_pssb_001r" then
		g_szAbleMoney	= DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "DRNG_ABLE_AMT" , 0 ) '출금가능금액
		
				
	elseif szTranID == "obibk_psif_001r" then
		g_sSbscIssuClsCode = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock1", "SBSC_ISSU_CLS_CODE" , 0 )
		g_sIscd       = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock1", "ISCD" , 0 )
		g_lSbscUnpr   = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock1", "ELW_SBSC_UNPR" , 0 )	'청약단가		
		g_lSbscMinQty = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock6", "SBSC_MIN_QTY" , 0 )	'청약최소수량
		g_dSbscMgrt   = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock4", "SBSC_MGRT" , 0 )	'청약증거금률
		
		DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
		
	elseif szTranID == "obibk_pssb_029r" then
		g_szYesorNo = DATAMANAGER.GetDataValue( 0, "obibk_pssb_029r", "OutBlock1", "CNCL_YN" , 0)			'취소여부
		
		Dim iDataCount
		iDataCount = 0
		iDataCount = DATAMANAGER.GetDataCount( 0, "obibk_pssb_029r", "OutBlock1" )
		
'		if iDataCount > 0 then
'			Form.MsgBox( "알림", "이미 청약처리되었습니다.", "", 6 )
'		end if
		
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	
	elseif szTranID == "obibk_pssm_001r" then	'공모주 청약 추가납입 조회
		g_lRealAsgmStcn = 0
		g_lSppmScDlStcn = 0
		g_lSppmScDlAmt = 0
		g_lSbscApltSrno = 0
		g_lSppmSrno = 0
		g_lRealAsgmStcn = DATAMANAGER.GetDataValue( 0, "obibk_pssm_001r", "OutBlock1", "REAL_ASGM_STCN" , 0 ) '실배정주수
		g_lSppmScDlStcn = DATAMANAGER.GetDataValue( 0, "obibk_pssm_001r", "OutBlock1", "SPPM_SCDL_STCN" , 0 ) '추납예정주수
		g_lSppmScDlAmt  = DATAMANAGER.GetDataValue( 0, "obibk_pssm_001r", "OutBlock1", "SPPM_SCDL_AMT" , 0 )	  '추납예정금액
		g_lSbscApltSrno = DATAMANAGER.GetDataValue( 0, "obibk_pssm_001r", "OutBlock1", "SBSC_APLT_SRNO" , 0 ) '청약신청일련번호
		g_lSppmSrno	  = DATAMANAGER.GetDataValue( 0, "obibk_pssm_001r", "OutBlock1", "SPPM_SRNO" , 0 ) '추납 일련번호
				
		if CDbl(g_lSbscApltSrno) == 0 then
			Form.MsgBox( "계좌확인", "해당 계좌는 공모주 청약\n 신청내역이 없습니다." , "", 6 )
		end if
		
		if CDbl(g_lSppmSrno) > 0 then
			
			Dim tmp_sppm_amt, tmp_sppm_stcn
			tmp_sppm_stcn = DATAMANAGER.GetDataValue( 0, "obibk_pssm_001r", "OutBlock1", "SPPM_AMT" , 0 )	  '추납금액(실제론 추납수량이 조회됨)
			tmp_sppm_amt = CDbl(tmp_sppm_stcn) * CDbl(g_lSbscUnpr)
			'기 추납금액 setting
			tbl0.SetCellString( 6 , 1, tmp_sppm_amt )
			
			Form.MsgBox( "계좌확인", "이미 추가납입 처리된 내역이 존재합니다." , "", 6 )
		end if
		
		
	elseif szTranID == "obibk_pssm_001a" then
		
		
		msg_succ = "추가납입 신청 처리 되었습니다\n\n    (추가납입수량: " & FormatNumber(g_nAmount, 0) & "주)"
		
		Form.MsgBox( "청약 신청 완료",msg_succ , "", 6 )
		Form.SendReturnToParent( "mbonl83110_p2" , "Ok")
		Form.CloseForm()
		
	end if
	
End Sub
