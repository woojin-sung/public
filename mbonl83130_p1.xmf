'============================================================================
' btnFull_OnClick()
'============================================================================
Sub btnFull_OnClick()
	Dim tmp_sppm_amt, tmp_sppm_qty
	tmp_sppm_amt = 0
	tmp_sppm_qty = 0
	
	'출금가능금액 >= 추납예정금액 
	If CDbl(g_szAbleMoney) >= CDbl(g_lSppmScDlAmt) then
		'추가납입수량 setting
		tmp_sppm_qty = g_lSppmScDlStcn
	Else
		tmp_sppm_qty = g_szAbleMoney / g_lSbscUnpr
	End If
	
	edtQty.caption = CDbl(tmp_sppm_qty)
	
	'추가납입금액(수량*단가) setting
	tmp_sppm_amt = tmp_sppm_qty * g_lSbscUnpr
	'tmp_sppm_amt = tmp_sppm_amt * g_dSbscMgrt / 100
	tbl0.SetCellString( 6 , 1, tmp_sppm_amt )
	
	'최종배정수량 setting	
	tbl0.SetCellString( 7 , 1, g_lRealAsgmStcn + tmp_sppm_qty )
	
	'수량변수 clear
	g_nAmount = 0
End Sub

