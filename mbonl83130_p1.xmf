'============================================================================
' edtQty_OnEditComplete()
'============================================================================
Sub edtQty_OnEditComplete()
	Dim tmp_sppm_amt
		
	g_nAmount = g_nAmount + CDbl(edtQty.caption)
	
	if g_nAmount > 0 then
		'추가납입금액(수량*단가) setting
		tmp_sppm_amt = g_nAmount * g_lSbscUnpr
		'tmp_sppm_amt = tmp_sppm_amt * g_dSbscMgrt / 100
		tbl0.SetCellString( 6 , 1, tmp_sppm_amt )
		
		'최종배정수량 setting		
		tbl0.SetCellString( 7 , 1, g_lRealAsgmStcn + g_nAmount )
		
	elseif g_nAmount == 0 then
		tbl0.SetCellString( 6 , 1, 0 )
		tbl0.SetCellString( 7 , 1, g_lRealAsgmStcn )
	end if
	
	'g_nAmount = g_ngoMoney/tbl0.GetCellString( 3, 1)
	
'	if g_nAmount <> Int(g_nAmount) then			'청약금액이 단가 단위와 맞지 않을때 오류 메세지 호출 후 변경안됨
'		Form.ShowAlert( "알림" , "단가를 확인하시기 바랍니다.")
'		edtQty.caption = ""
'		g_ngoMoney = 0
'		Exit Sub
'	end if	
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obibk_pssm_001r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obibk_pssm_001r" )
		if Trim(szSubErr) <> "" and Trim(szSubErr) <> Null then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림", szErrMsg)
		end if
		'Form.CloseForm()			'에러시 폼 종료 해달라는 요청을 받음
	end if
	
	if szTranID == "obibk_pssm_001a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obibk_pssm_001a" )
		if Trim(szSubErr) <> "" and Trim(szSubErr) <> Null then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림", szErrMsg)
		end if
		'Form.CloseForm()			'에러시 폼 종료 해달라는 요청을 받음
	end if
	
End Sub

