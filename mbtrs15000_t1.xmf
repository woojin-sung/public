		<LABEL name="Label0" fgcolor="006:213049051" fontsize="-3" caption="※권리입고예정주식 확인요망" multiline="1" ly_vert="0,227,199,30,1" />
		<TABLE name="tbl1" insidelinecolor="102:255255255" colcount="3" rowcount="2" designorder="1" ly_vert="403,42,375,80,1" >
