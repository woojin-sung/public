	<SCRIPT_INFO _len="32846" _ulen="30616" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 잔고평가
' 02. 화면설명 : 주식잔고평가
' 03. 작    성 : 2016.04.30 LJS
'			 : 2018.09.14 : v001. 현재가 색상 추가
'			 : 2020.04.03 : v002. 대여 추가
'              : 2022.11.01 : v003. 대출대여 추가 
'              : 2023.02.07 : v004. 양도담보 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szACNO, g_szASNO, g_szItemCode, g_szData
Dim g_bFalg, g_szSelect, g_szFold
Dim g_szRmndCd
Dim g_szLoanCd

Dim g_index

Dim g_RghtFlag
Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer
Dim g_switch
Dim g_VltnFlag '0 순자산평가 1 유가증권평가액
Dim g_ByovFlag '0 평가손익 1 총 매입단가

g_bFalg = True
g_szFold = "1"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	Dim szACNO, szASNO

	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")

	If szACNO = "" OR szASNO = "" Then
		Form.ShowAlert("알림", "계좌정보가 없습니다.")
		Return False
	End If

	Return True
End Function

'============================================================================
Function SetGridData()
	Dim i, nRate, szData, szReturnValue
	Dim nVLTN_PRLS_AMT      ' 평가손익
	Dim nBYNG_AMT           ' 매입금액
	Dim nEXPN_AMT           ' 비용금액
	Dim nTOT_VLTN_PRLS_AMT  ' 평가손익합계
	Dim nTOT_BYNG_AMT       ' 매입금액합계
	Dim szLOAN_DATE         ' 대출일자

	nVLTN_PRLS_AMT     = 0
	nBYNG_AMT          = 0
	nTOT_VLTN_PRLS_AMT = 0
	nTOT_BYNG_AMT      = 0

	g_Toggle1 = 0
	g_Toggle2 = 0

	SetGridHeader(g_Toggle1, g_Toggle2)

	For i = 0 To grd0.rowcount -1

		If chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT  = CDbl( grd0.GetCellData( "bd_cell6", i ) ) - CDbl( grd0.GetCellData("bd_cell16", i) )  '신용이자
		Else
			nVLTN_PRLS_AMT  = CDbl( grd0.GetCellData( "bd_cell6", i ) )
		End If

		nBYNG_AMT   = CDbl( grd0.GetCellData( "bd_cell8", i ) )
		nPSNT_PRC   = grd0.GetCellData( "bd_cell4" , i )
		szData      = grd0.GetCellData( "bd_cell1" , i )
		szLOAN_DATE = grd0.GetCellData( "bd_cell10", i)
		szRMND_CLCD = grd0.GetCellData( "bd_cell20", i)

		nTOT_VLTN_PRLS_AMT = nTOT_VLTN_PRLS_AMT + nVLTN_PRLS_AMT
		nTOT_BYNG_AMT      = nTOT_BYNG_AMT + nBYNG_AMT

		grd0.SetCellData("bd_cell6", i, nVLTN_PRLS_AMT)

		'매입금액이 있는 경우에만 계산
		If CDbl( grd0.GetCellData("bd_cell8", i) ) = 0 Then
			grd0.SetCellData("bd_cell7", i, "" )
		Else
			'수익률이 천단위가 넘는 경우 콤마가 중복으로 생기므로 FormatNumber 제거
			'grd0.SetCellData("bd_cell7", i, FormatNumber(FIX((nVLTN_PRLS_AMT/nBYNG_AMT)*10000)/100,2))
			grd0.SetCellData("bd_cell7", i, Fix( (nVLTN_PRLS_AMT/nBYNG_AMT) * 10000) / 100 )
		End If


		If nPSNT_PRC = "" and chk2.checkstate = "1" Then
			Dim nData
			nData = CDbl(grd0.GetCellData( "bd_cell13", i )) * -1
			grd0.SetCellData( "bd_cell6", i, nData )
		End If

		If szData = "0101" Or szData = "0102" Or szData = "0103" Or szData = "0104" Or
		   szData = "0201" Or szData = "0202" Or szData = "0203" Or szData = "0204" Or
		   szData = "0301" Then
			grd0.SetCellData( "bd_cell22", i, "" )
		ElseIf CDbl(grd0.GetCellData( "bd_cell2", i )) = 0 Then
			grd0.SetCellData( "bd_cell22", i, 0 )
		Else
			nBepUnpr = Fix( CDbl(grd0.GetCellData( "bd_cell21", i )) + ( CDbl(grd0.GetCellData( "bd_cell16", i ))  / CDbl(grd0.GetCellData( "bd_cell2", i )) ) )
			grd0.SetCellData( "bd_cell22", i, nBepUnpr )
		End If

		Select Case szData
			Case "0000" szReturnValue = "보통"
			Case "0101" szReturnValue = "자기융자"
			Case "0102" szReturnValue = "유통융자"
			Case "0103" szReturnValue = "자기대주"
			Case "0104" szReturnValue = "유통대주"
			Case "0201" szReturnValue = "예탁주식"
			Case "0202" szReturnValue = "예탁채권"
			Case "0203" szReturnValue = "예탁집합투자"
			Case "0204" szReturnValue = "예탁장외파생"
			Case "0211" szReturnValue = "예탁유통주식"
			Case "0212" szReturnValue = "예탁유통채권"
			Case "0213" szReturnValue = "예탁유통집합투자"
			Case "0214" szReturnValue = "예탁유통장외파생"
			Case "0301" szReturnValue = "매도증권담보대출"
			Case "0302" szReturnValue = "수익증권환매"
			Case "0303" szReturnValue = "ELS환매자금대출"
			Case "0401" szReturnValue = "소액주식"
			Case "0402" szReturnValue = "소액채권"
			Case "0403" szReturnValue = "소액수익증권"
			Case "0404" szReturnValue = "소액 ELS"
			Case "0501" szReturnValue = "공모주청약"
			Case "0502" szReturnValue = "ELS청약"
			Case "0503" szReturnValue = "주식매입"
			Case "0601" szReturnValue = "매입자금대출"
			Case "0701" szReturnValue = "초단기대출"
			Case "0801" szReturnValue = "CMA담보대출"
			Case "9201" szReturnValue = "대출(대여)" 'v003
			Case "8201" szReturnValue = "양도담보" 'v004
			Case Else   szReturnValue = szData
		End Select

		If szData = "0000" Then
			If szRMND_CLCD = "31" Then
				szReturnValue = "대여주식"
			ElseIf szRMND_CLCD = "32" Then
				szReturnValue = "CFD대용"
			ElseIf szRMND_CLCD = "16" Then
				szReturnValue = "선물대용"
			End If
		End If

		grd0.SetCellData( "bd_cell1", i, szReturnValue )

	Next

	'20210628 마지막 종목의 매입금액이 0인 경우 수익률이 0으로 나오는 경우가 있어서 총매입금액으로 변경
	'If nBYNG_AMT == 0 Then
	If nTOT_BYNG_AMT == 0 Then
		nRate = 0
	Else
		nRate = Round((nTOT_VLTN_PRLS_AMT / nTOT_BYNG_AMT) * 100, 2)
	End If

	if g_ByovFlag == "0" then
		tbl0.SetCellString( 2, 2, nTOT_VLTN_PRLS_AMT)   '미실현손익
		tbl0.SetCellString( 2, 1, nRate             )   '손익률
		tbl1.SetCellString( 1, 2, nTOT_BYNG_AMT	   )   '총매입금액
		tbl1.SetCellString( 1, 1, ""	   		   )
		if trim(nTOT_VLTN_PRLS_AMT) == "" or nTOT_VLTN_PRLS_AMT == 0 then
			tbl0.SetCellFgColor(2, 2, "3")
		elseif nTOT_VLTN_PRLS_AMT > 0 then
			tbl0.SetCellFgColor(2, 2, "1")
		elseif nTOT_VLTN_PRLS_AMT < 0 then
			tbl0.SetCellFgColor(2, 2, "2")
		end if
	else
		tbl0.SetCellString( 2, 2, nTOT_BYNG_AMT	   )   '총매입금액
		tbl0.SetCellString( 2, 1, ""                ) 
		tbl1.SetCellString( 1, 2, nTOT_VLTN_PRLS_AMT)   '미실현손익
		tbl1.SetCellString( 1, 1, nRate	   		   )   '손익률
		tbl0.SetCellFgColor(2, 2, "3")
		tbl0.SetCellFgColor(2, 2, "3")
	end if

'   g_index = 0
'   iscd = grd0.GetCellData("bd_cell12", 0)
'
'   DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)
'   DATAMANAGER.RequestTranData("obsim_stsv_001r")

End Function

'============================================================================
Function RequestData()

	grd0.rowcount = 0

	If chk1.checkstate = "1" Then
		DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
	Else
		DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
	End If

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szChkVal1, szChkVal2, szFold
	
	szChkVal1 = Form.LoadConfigData( "mbtrs15000", "balance1"	)		'신용합산
	szChkVal2 = Form.LoadConfigData( "mbtrs15000", "balance2"	)		'비용반영
	szFold	 = Form.LoadConfigData( "mbtrs15000", "fold"		)		'펼침버튼
	
	If szChkVal1 <> "" Then
		chk1.checkstate = szChkVal1
	End If
	
	If szChkVal2 <> "" Then
		chk2.checkstate = szChkVal2
	End If
	
	Button0.visible = False
	Label0.visible  = False
	
	g_VltnFlag = "0"
	g_ByovFlag = "0"
	
	DATAMANAGER.RequestTranData("obtrs_oder_161r")
	
	If szFold <> "" Then
		If szFold = "1" Then
			g_szFold = "0"
		Else
			g_szFold = "1"
		End If
	End If
	
	btnFold_OnClick()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	
	szData = chk1.checkstate & "|" & chk2.checkstate

	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrs15000_h0" , szData , "" )
		
	ElseIf sEventName = "RECEIVE" Then
		btnSearch_OnClick()
		
	ElseIf sEventName = "CHANGE_ACCTNO" Then
		btnSearch_OnClick()
		
	End If

End Sub

'============================================================================
Sub chk1_OnChange(sCheckState)
	If g_bFalg = True Then
		Exit Sub
	End If

	If Account_Check() = False Then
		Exit Sub
	End If
	
	RequestData()
	
End Sub

'============================================================================
Sub chk2_OnChange(sCheckState)
	If g_bFalg = True Then
		Exit Sub
	End If

	If Account_Check() = False Then
		Exit Sub
	End If
	
	RequestData()
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	g_switch  = 0
	g_Buffer  = 0
	DATAMANAGER.RequestTranData( "obacb_balc_105r" )
	DATAMANAGER.RequestTranData( "obtrs_oder_161r" )
End Sub


'============================================================================
Sub btnRate_OnClick()
	Dim szData

	If tbl0.GetCellString(3, 0) = "" Or tbl0.GetCellString(3, 0) = "0" Or tbl0.GetCellString(3, 0) = 0 Then
		Form.ShowAlert("알림", "조회를 먼저 하셔야 합니다.")
		Exit Sub
	End If

	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	szData = szACNO & "|" & szASNO & "|" & CDbl( tbl0.GetCellString(1, 2) )

	Form.OpenFramePopup( "mbtrs15000_p1" , szData , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szFEE_INCU_YN
	Dim szACNO, szASNO
	
	'비용반영
	If chk2.checkstate = "1" Then
		szFEE_INCU_YN = "Y"
	Else
		szFEE_INCU_YN = "N"
	End If
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	If szTranID = "obacb_balc_105r" Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" 	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ACNO" 			, 0 , szACNO 		)		
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		
	ElseIf szTranID = "obtrs_comn_308r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "ACNO"		 	, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "UI_RMND_CLCD" 	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_308r", "InBlock1", "FEE_INCU_YN" 	, 0 , szFEE_INCU_YN )
		
	ElseIf szTranID = "obtrs_comn_310r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "ACNO"			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "ASNO"			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "BRNG_STCK_YN"	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "FEE_INCU_YN"	, 0 , szFEE_INCU_YN )		
		
	ElseIf szTranID = "obtrs_comn_329r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "ACNO" 			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD" 	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "BRNG_STCK_YN" 	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "FEE_INCU_YN" 	, 0 , szFEE_INCU_YN )
		
	ElseIf szTranID = "obpds_srvc_326r" Then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_326r", "InBlock1", "ACNO" 			, 0 , szACNO 		)		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_326r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_326r", "InBlock1", "ONLN_YN" 		, 0 , "Y" 		)
	
	ElseIf szTranID = "ooase_seex_084r" Then
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ACNO" 			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
	ElseIf szTranID = "obtrs_oder_161r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_161r", "InBlock1", "ACNO"			, 0 , szACNO		)
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_161r", "InBlock1", "ASNO"			, 0 , szASNO		)
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_161r", "InBlock1", "ISCD"			, 0 , "%"		)
	End If
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obacb_balc_105r" Then
		g_bFalg = False
		
		MKSC_VLTN_AMT	= DATAMANAGER.GetDataValue(0, "obacb_balc_105r", "OutBlock1", "MKSC_VLTN_AMT" , 0)
		VLTN_AMT		= DATAMANAGER.GetDataValue(0, "obacb_balc_105r", "OutBlock1", "VLTN_AMT"	    , 0)
		
		If g_VltnFlag == "0" Then
			tbl0.SetCellString(1, 2, VLTN_AMT)
			tbl1.SetCellString(0, 2, MKSC_VLTN_AMT)
		Else
			tbl0.SetCellString(1, 2, MKSC_VLTN_AMT)
			tbl1.SetCellString(0, 2, VLTN_AMT)
		End If
		
		DATAMANAGER.RequestTranData( "ooase_seex_084r" )		
	
	ElseIf szTranID = "ooase_seex_084r" Then
	
		'당일
		tbl0.SetCellString( 3, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT" 		, 0 ) )
		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "Y" Then 
			tbl0.SetCellString( 3, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "A" Then 
			tbl0.SetCellString( 3, 1, "N/A" )
		Else 
			tbl0.SetCellString( 3, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "PLRT", 0 ) )
		End If
	
		'누적
		tbl0.SetCellString( 4, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT5" 		, 0 ) )
		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "Y" Then 
			tbl0.SetCellString( 4, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "A" Then 
			tbl0.SetCellString( 4, 1, "N/A" )
		Else 
			tbl0.SetCellString( 4, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M6_PLRT", 0 ) )
		End If	
	
		DATAMANAGER.RequestTranData( "obtrs_comn_308r" )
		
	ElseIf szTranID = "obtrs_comn_308r" Then
		If chk1.checkstate = "1" Then
			DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
		Else
			DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
		End If
	
	ElseIf szTranID = "obtrs_comn_329r" Or szTranID = "obtrs_comn_310r" Then
		'for i = 0 to DATAMANAGER.GetDataCount(0, "obtrs_comn_310r" , "OutBlock1") - 1
		'	msgbox DATAMANAGER.GetDataValue(0, "obtrs_comn_310r", "OutBlock1", "UI_VLTN_ERT"  , i)		
		'next
		
		SetGridData()

		For i = 0 To grd0.rowcount - 1
			psnt_prc = Cdbl(grd0.GetCellData("bd_cell4", i))
			psdy_clpr= Cdbl(grd0.GetCellData("bd_cell17",i))

			If psnt_prc > psdy_clpr Then
				grd0.SetCellFgColor("bd_cell4", i, "10")
			ElseIf psnt_prc = psdy_clpr Then
				grd0.SetCellFgColor("bd_cell4", i, "4")
			Else
				grd0.SetCellFgColor("bd_cell4", i, "11")
			End If

			'순매입금액 추가
			If Trim(grd0.GetCellData("bd_cell8", i)) == "" Then
				byng_amt = 0
			Else
				byng_amt = Cdbl(grd0.GetCellData("bd_cell8", i))
			End If

			If Trim(grd0.GetCellData("bd_cell18", i)) == "" Then
				loan_amt = 0
			Else
				loan_amt = Cdbl(grd0.GetCellData("bd_cell18", i))
			End If

			grd0.SetCellData("bd_cell19", i, byng_amt - loan_amt)
		Next

'	ElseIf szTranID = "obsim_stsv_001r"  Then
'		If Cint(g_index) < Cint(grd0.rowcount)   Then
'
'			iscd = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0)
'			prdy_clpr = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "PRDY_CLPR" , 0)
'
'			grd0.SetCellData("bd_cell17", g_index, prdy_clpr)
'			g_index = g_index + 1
'
'			iscd = grd0.GetCellData("bd_cell12", g_index)
'			DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)
'			DATAMANAGER.RequestTranData("obsim_stsv_001r")
'		End If
'
'		'v001. g_index = grdList.rowcnt 일때 complete를 안타므로 바로 색상처리
'		If Cint(g_index) == Cint(grd0.rowcount)  Then
'			For i = 0 To grd0.rowcount - 1
'				psnt_prc = Cdbl(grd0.GetCellData("bd_cell4", i))
'				psdy_clpr= Cdbl(grd0.GetCellData("bd_cell17", i))
'
'				If psnt_prc > psdy_clpr Then
'					grd0.SetCellFgColor("bd_cell4", i, "10")
'				ElseIf psnt_prc = psdy_clpr then
'					grd0.SetCellFgColor("bd_cell4", i, "4")
'				Else
'					grd0.SetCellFgColor("bd_cell4", i, "11")
'				End If
'			Next
'		End If

		g_switch  = 1

	ElseIf szTranID = "obtrs_oder_161r" Then
		If DATAMANAGER.GetDataValue(0, "obtrs_oder_161r", "OutBlock1", "RGHT_HLDN_YN" , 0) == "Y"Then
			g_RghtFlag = "Y"

			Button0.visible = True
			Label0.visible  = True

			chk1.height = 19
			chk1.fontsize = 0
			chk2.height = 19
			chk2.fontsize = 0
		Else
			g_RghtFlag = "N"

			Button0.visible = False
			Label0.visible  = False

			chk1.height = 39
			chk1.fontsize = 0
			chk2.height = 39
			chk2.fontsize = 0
		End If
	End If

End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mbtrs15000" Then
		Dim arrData, szACNO

		szACNO = Form.GetCtlProp("#acnt0", "caption")

		arrData = Split(sRet,"|")

		If UBOUND(arrData) < 1 Then
			Exit Sub
		End If

		chk1.checkstate = CInt( arrData(0) )
		chk2.checkstate = CInt( arrData(1) )

		If szACNO <> arrData(2) Then
			Form.SetCtlProp( "#acnt0", "caption", arrData(2) )
		Else
			If chk1.checkstate = "1" Then
				DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
			Else
				DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
			End If
		End If

	ElseIf sKeyName = "MOVEPOP_RETURN"  Then
		Dim szListItems
		szListItems =   Split(sRet,"★")

		If  szListItems(2)  =   "2" Then
			If  szListItems(1)  =   "0" Then            '현재가
				Form.OpenScreen("11000" , g_szItemCode & "★" & "0")

			ElseIf  szListItems(1)  =   "1" then        '매수
				If g_szLoanCd = "0103" Or g_szLoanCd = "0104" Then
					Form.OpenScreen("12090" , "잔고" & "★" & "1" & "★" & g_szData )
				Else
					Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
				End If
			ElseIf  szListItems(1)  =   "2" then        '매도
				If g_szLoanCd = "0103" Or g_szLoanCd = "0104" Then
					Form.OpenScreen("12090" , "잔고" & "★" & "0" & "★" & g_szData )
				Else
					Form.OpenScreen("12000" , "잔고" & "★" & "1" & "★" & g_szData )
				End If
			ElseIf  szListItems(1)  =   "6" Then        '차트
				Form.OpenScreen("13000" , g_szItemCode)
			End If
		ElseIf  szListItems(2)  =   "3" Then
			If  szListItems(1)  =   "0" Then            '현재가
				Form.OpenScreen("11000" , g_szItemCode & "★" & "0")
			ElseIf  szListItems(1)  =   "1" Then        '대여매도
				If g_szRmndCd = "31" Then
					Form.OpenScreen("12060" , "잔고" & "★" & "0" & "★" & g_szData )
				Else
					Form.OpenScreen("12080" , "잔고" & "★" & "0" & "★" & g_szData )
				End If
			ElseIf  szListItems(1)  =   "2" Then        '대용매수
				Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
			ElseIf  szListItems(1)  =   "6" Then        '차트
				Form.OpenScreen("13000" , g_szItemCode)
			End If
		End If

'       If  szListItems(1)  =   "0" Then            '현재가
'           Form.OpenScreen("11000" , g_szItemCode & "★" & "0")
'       ElseIf  szListItems(1)  =   "1" Then        '매수
'           Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
'       ElseIf  szListItems(1)  =   "2" Then        '매도
'           Form.OpenScreen("12000" , "잔고" & "★" & "1" & "★" & g_szData )
'       End If

		g_szData = ""

	End If

End Sub


'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
    Dim szItemCode, szQty, szLoanDate, szLoanCd, szLoanSr, szLoan
    Dim szCutCd, szMk
    Dim errmsg

    errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

    g_szItemCode    =   grd0.GetCellData("bd_cell12", lRow)

    listLocation =  Split(grd0.location,":")
    nYPos = Int(listLocation[1])
    height = listLocation[3]

    szItemCode = grd0.GetCellData("bd_cell12", lRow)
    szQty      = grd0.GetCellData("bd_cell3" , lRow)
    szLoanDate = grd0.GetCellData("bd_cell10", lRow)
    szLoanCd   = grd0.GetCellData("bd_cell14", lRow)
    szLoanSr   = grd0.GetCellData("bd_cell15", lRow)
    szRmndCd   = grd0.GetCellData("bd_cell20", lRow)
    g_szRmndCd = szRmndCd   '전역변수로 사용하기 위함
    g_szLoanCd = szLoanCd  '전역변수로 사용하기 위함

    If szLoanCd = "0000" And (szRmndCd = "31" Or szRmndCd = "32" Or szRmndCd = "16") Then
        sPopupType = "3"
    Else
        sPopupType = "2"
    End If

    ' 20160310 주문불가한 종목 예외처리
    ' 20170502 상장수익증권 예외처리 'F'
    ' case: 신주인수권/증권 (9자리)
    If (left(szItemCode,1) ="J" And len(szItemCode) == 9) Or left(szItemCode,1) ="Q" Or left(szItemCode,1) = "F" Then
        szMk = Form.GetItemCodeInfo(szItemCode, "market")
    ' Else: 기타
    Else
        ' 20160310 주문불가한 종목 예외처리
        szCutCd = Mid(szItemCode, 2, Len(szItemCode))
        szMk = Form.GetItemCodeInfo(szCutCd, "market")
    End If

    If Trim(szMk) = "J" Or Trim(szMk) = "Q" Or Trim(szMk) = "W" Or Trim(szMk) = "T" Then
        ' 전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
        ' 전달내용, 탭위치는 리턴받아서 처리함.
        g_szData = szItemCode & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr

        g_szSelect = "1"

'       Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "" & "★" & g_szItemCode)
        If sPopupType = "2" Then
            Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "" & "★" & g_szItemCode)
        ElseIf sPopupType = "3" Then
            If szRmndCd = "31" Then
                Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            ElseIf szRmndCd = "32" Or szRmndCd = "16" Then
                Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "대용매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            Else
                Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            End If
        End If
    Else
        Form.MsgBox("알림", errmsg, "REUPDATE", 1)
    End If
End Sub

