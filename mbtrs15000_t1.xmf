Sub btnFold_OnClick()

	If g_szFold = "1" Then
		g_szFold = "0"
		btnFold.btnimage = "btn_filter2.9.png"

		Image0.visible = True
		Image1.visible = True
		Image2.visible = True
		tbl0.visible   = True

		chk1.top    = 205
		chk2.top    = 205
		btnFold.top = 205
		grd0.top    = 249
		grd0.height = 220
		Button0.top = 205
		Label0.top  = 222
	Else
		g_szFold = "1"
		btnFold.btnimage = "btn_filter.9.png"

		Image0.visible = False
		Image1.visible = False
		Image2.visible = False
		tbl0.visible   = False

		chk1.top    = 10
		chk2.top    = 10
		btnFold.top = 10
		grd0.top    = 54
		grd0.height = 415
		Button0.top = 10
		Label0.top  = 27
	End If

End Sub

