'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
    If g_switch = 1 Then
    If g_Buffer = 1 Then

        If szCellID = "th_cell0" Or szCellID = "th_cell1" Then
            g_Toggle1 = g_Toggle1 + 1
            g_Toggle2 = 0

            If g_Toggle1 > 2 Then
                g_Toggle1 = 0
            End If

            SetGridHeader(g_Toggle1, g_Toggle2)
        ElseIf szCellID = "th_cell6" Or szCellID = "th_cell7" Then
            g_Toggle1 = 0
            g_Toggle2 = g_Toggle2 + 1

            If g_Toggle2 > 2 Then
                g_Toggle2 = 0
            End If

            SetGridHeader(g_Toggle1, g_Toggle2)
        End If
    End If

    g_Buffer = 1
    End If

    '20201028 LES START 보유잔고 정렬마킹
    If szCellID == "th_cell9" Or szCellID == "th_cell8" Then
        grdTopCaption = grd0.GetCellTopCaption("th_cell9")

        If grdTopCaption == "평가금액▼" Then
'            grd0.SetCellTopCaption("th_cell9", "평가금액▲")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
            grd0.SetCellTopCaption("th_cell9", "평가금액")
        ElseIf grdTopCaption ==  "평가금액▲" Then
            grd0.SetCellTopCaption("th_cell9", "평가금액")
        Else
'            grd0.SetCellTopCaption("th_cell9", "평가금액▼")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
            grd0.SetCellTopCaption("th_cell9", "평가금액")
        End If

    End If

    If szCellID == "th_cell2" or szCellID == "th_cell3" Then
        grdTopCaption = grd0.GetCellTopCaption("th_cell2")

        If grdTopCaption == "보유수량▼" then
'            grd0.SetCellTopCaption("th_cell2", "보유수량▲")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
            grd0.SetCellTopCaption("th_cell2", "보유수량")
        ElseIf grdTopCaption ==  "보유수량▲" then
            grd0.SetCellTopCaption("th_cell2", "보유수량")
        Else
'            grd0.SetCellTopCaption("th_cell2", "보유수량▼")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
            grd0.SetCellTopCaption("th_cell2", "보유수량")
        End If

    End If
    '20201028 LES END

End Sub

'============================================================================
Sub SetGridHeader(g_Toggle1, g_Toggle2)
	If g_Toggle1 = 0 Then
		grd0.SetCellTopCaption("th_cell0", "종목명")
	ElseIf g_Toggle1 = 1 Then
'		grd0.SetCellTopCaption("th_cell0", "종목명▼")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grd0.SetCellTopCaption("th_cell0", "종목명")
	Else
'		grd0.SetCellTopCaption("th_cell0", "종목명▲")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grd0.SetCellTopCaption("th_cell0", "종목명")
	End If
	
	If g_Toggle2 = 0 Then
		grd0.SetCellTopCaption("th_cell6", "평가손익")
	ElseIf g_Toggle2 = 1 Then
'		grd0.SetCellTopCaption("th_cell6", "평가손익▼")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grd0.SetCellTopCaption("th_cell6", "평가손익")
	Else
'		grd0.SetCellTopCaption("th_cell6", "평가손익▲")	20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grd0.SetCellTopCaption("th_cell6", "평가손익")
	End If	
End Sub

'============================================================================
Sub Image1_OnClick()
	Dim tbl0_vltn_amt, tbl1_vltn_amt
	Dim tbl0_vltn_name, tbl1_vltn_name

	tbl0_vltn_amt  = tbl0.GetCellString(1, 2)
	tbl0_vltn_name = tbl0.GetCellString(1, 0)
	tbl1_vltn_amt  = tbl1.GetCellString(0, 2)
	tbl1_vltn_name = tbl1.GetCellString(0, 0)

	tbl0.SetCellString(1, 0, tbl1_vltn_name)
	tbl0.SetCellString(1, 2, tbl1_vltn_amt)
	tbl1.SetCellString(0, 0, tbl0_vltn_name)
	tbl1.SetCellString(0, 2, tbl0_vltn_amt)

	If g_VltnFlag == "0" Then
		g_VltnFlag = "1"
		Image1.left = 103
	Else
		g_VltnFlag = "0"
		Image1.left = 78
	End If

End Sub


'============================================================================
Sub Image2_OnClick()
	Dim tbl0_prls_amt, tbl1_prls_amt
	Dim tbl0_prls_name, tbl1_prls_name
	Dim tbl0_prls_rate, tbl1_prls_rate

	
	tbl0_prls_name = tbl0.GetCellString(2, 0)
	tbl0_prls_rate = tbl0.GetCellString(2, 1)
	tbl0_prls_amt  = tbl0.GetCellString(2, 2)
	tbl1_prls_name = tbl1.GetCellString(1, 0)
	tbl1_prls_rate = tbl1.GetCellString(1, 1)
	tbl1_prls_amt  = tbl1.GetCellString(1, 2)
	
	tbl0.SetCellString(2, 0, tbl1_prls_name)
	tbl0.SetCellString(2, 1, tbl1_prls_rate)
	tbl0.SetCellString(2, 2, tbl1_prls_amt)
	tbl1.SetCellString(1, 0, tbl0_prls_name)
	tbl1.SetCellString(1, 1, tbl0_prls_rate)
	tbl1.SetCellString(1, 2, tbl0_prls_amt)
	
	If g_ByovFlag == "0" Then
		g_ByovFlag = "1"
		Image2.left = 82
		tbl0.SetCellFgColor(2, 2, "3")
	Else
		g_ByovFlag = "0"
		Image2.left = 68
		if trim(tbl0.GetCellString(2, 2)) == "" or Cint(trim(tbl0.GetCellString(2, 2))) == 0 then
			tbl0.SetCellFgColor(2, 2, "3")
		elseif Cint(trim(tbl0.GetCellString(2, 2))) > 0 then
			tbl0.SetCellFgColor(2, 2, "1")
		elseif Cint(trim(tbl0.GetCellString(2, 2))) < 0 then
			tbl0.SetCellFgColor(2, 2, "2")
		end if
	End If
End Sub

