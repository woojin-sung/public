	<SCRIPT_INFO _len="4473" _ulen="3785" >

Dim g_tData
Dim g_szCode
Dim g_szLinkedYN

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		'20230828 아이디 연결여부 추가
		g_szLinkedYN = Form.GetSharedData("71052_ID_LNKN_YN", false)
		
'		Form.ShowAlert("", szOpenData)
		'종목명, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 체결잔고, 매입단가, 신용/대출금, 신용/대출일, 만기일, 종목코드, 대출상세유형코드, UI잔고구분코드, 대출일련번호
		g_tData = Split(szOpenData, "☆")
		
		if UBOUND(g_tData) < 1 then
			exit sub
		end if
		
		lblName.caption = g_tData[0]
		
		tbl0.SetCellString(0, 2, g_tData[1])
		
		tbl1.SetCellString(0, 1, g_tData[2])
		tbl1.SetCellString(1, 1, g_tData[3])
		'평가손익 색상 적용
		'아랫줄의 수익률도 똑같이 넘버포맷이 아닌데 컨트롤 속성의 증감색 적용이 되서 평가손익만 따로 처리 
		Select Case Left(g_tData[3], 1)
			Case "+"
				tbl1.SetCellFgColor(1, 1, "1")
			Case "-"
				tbl1.SetCellFgColor(1, 1, "2")
		End Select
		
		tbl1.SetCellString(2, 1, g_tData[4])
		Select Case Left(g_tData[4], 1)
			Case "+"
				tbl1.SetCellFgColor(2, 1, "1")
			Case "-"
				tbl1.SetCellFgColor(2, 1, "2")
		End Select
		
		tbl3.SetCellString(0, 1, g_tData[5])
		tbl3.SetCellString(1, 1, g_tData[6])
		tbl3.SetCellString(2, 1, g_tData[7].."원")
		
		'20230925 현재가, 기준가 추가
		tbl3.SetCellString(3, 1, g_tData[15])

		tbl2.SetCellString(0, 1, g_tData[8])
		tbl2.SetCellString(1, 1, g_tData[9])
		tbl2.SetCellString(2, 1, g_tData[10])
		
		'풀종목코드라서 
		g_szCode = g_tData[11]
		If Len(g_szCode) == 7 And InStr(g_szCode, "A") <> 0 Then
			g_szCode = Right(g_szCode, 6)
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnPrice_OnClick()
	Form.OpenScreen("11000" , g_szCode)
End Sub

'============================================================================
Sub btnBuy_OnClick()
	If g_szCode <> "" And g_szCode <> null Then
		'20230828 아이디 연결여부 추가
		if g_szLinkedYN == "N" then
			Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
			exit sub
		end if
		
		szData = "기타" & "★" & "0" & "★" & g_szCode
		Form.OpenScreen("12000" , szData)
	End If
End Sub

'============================================================================
Sub btnSell_OnClick()
	If g_szCode <> "" And g_szCode <> null Then
		'20230828 아이디 연결여부 추가
		if g_szLinkedYN == "N" then
			Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
			exit sub
		end if
		
		Dim szData
		'대여, 대용, 대주 종목은 해당 주문화면으로 이동
		If g_tData[12] == "0104" Or g_tData[13] == "31" Or g_tData[13] == "32" Or g_tData[13] == "16" Then
			'전달내용/탭위치/종목코드
			szData = "기타" & "★" & "0" & "★" & g_szCode 
			'전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
'			szData = "잔고" & "★" & "0" & "★" & g_szCode & "★" & g_tData[6] & "♥" & g_tData[9] & "♥" & g_tData[12] & "♥" & "0" & "♥" & g_tData[14]

'			Form.ShowAlert("szData", szData)
			'대여주문매도
			If g_tData[13] == "31" Then
				Form.OpenScreen("12060" , szData)
				Exit Sub
			End If
			
			'대용주문매도
			If g_tData[13] == "32" Or g_tData[13] == "16" Then
				Form.OpenScreen("12080" , szData)
				Exit Sub
			End If
			
			'대주주문매도
			If g_tData[12] == "0104" Then
				Form.OpenScreen("12090" , szData)
				Exit Sub
			End If
			
			
		'그 외 일반주문
		Else
			szData = "기타" & "★" & "1" & "★" & g_szCode
			Form.OpenScreen("12000" , szData)	
		End If
	End If
End Sub



