	<SCRIPT_INFO _len="6837" _ulen="6297" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_인증서목록
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20201126 SWJ START : 공인인증서 '공인'글자 삭제
'20220805_01 KBC : 로그인개선
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sGubun '인증서업무구분
Dim g_OpenType

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'20160428 NOHES : update의 경우 이 맵 사용 안함. 주석처리 여부 추후 확인 필요.
'============================================================================
Sub ContainerExist_Grid0_OnClickUp(lRow, szCellID)
	if g_sGubun == "update" then '갱신인경우 "SignKorea" 인증서가 아닌경우 안내팝업
		Dim sCertSort 
		sCertSort = ContainerExist.Grid0.GetCellData( "bd_cert", lRow )
		
		'20170825 HAMWG START : SignKorea 증권/보험용, 범용 사용가능
		if InStr(Trim(sCertSort), "SignKorea") > 0 then
		'20170825 HAMWG END
		
		'NOHES START 20160609 발급기관정보추가
		'if InStr(Trim(sCertSort), "증권/보험용") > 0 then
		'NOHES END
			Dim sDN, sIndex
			sDN = ContainerExist.Grid0.GetCellData( "bd_dn", lRow )
			sIndex = ContainerExist.Grid0.GetCellData( "bd_index", lRow )

			Form.SetSharedData("CERT_DN" , sDN)
			Form.SetSharedData("CERT_INDEX" , sIndex)
			Form.triggerEvent( "#", "NextStep", "1" )
		else
			Form.MsgBox( "알림", sCertSort.."인증서는 해당 발급기관에서 갱신하시기 바랍니다.", "", 6 )
		end if
	else	
		Dim sDN, sIndex
		sDN = ContainerExist.Grid0.GetCellData( "bd_dn", lRow )
		sIndex = ContainerExist.Grid0.GetCellData( "bd_index", lRow )
		
		Form.SetSharedData("CERT_DN" , sDN)
		Form.SetSharedData("CERT_INDEX" , sIndex)
		Form.triggerEvent( "#", "NextStep", "1" )
	end if
	
	if g_OpenType == "Login_Open" then
	'20160428 NOHES START : 모든 인증서 사용가능	
	'	if Trim(sCertSort) == "증권/보험용" then
	'		Form.ShowAlert( "알림" , "증권용 인증서가 아닙니다.")
	'		Exit sub
	'	end if
	'20160428 NOHES END
		Form.SendReturnToParent("Login_Close","")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	ContainerExist.left = 0
	ContainerNotExist.left = 0
	
	g_OpenType = Form.GetOpenLinkData( )
		
	if g_OpenType == "Login_Open" then
		Form.SetScreenName("인증서 로그인")
		
		Dim sCertCnt, sToday, sCalDate
		sCertCnt = Form.GetCertListSize()
		sToday = Form.GetSharedData("&HOST_DATE",false )
		sCalDate = Form.calcDateTime( 0, 0, 30, 0, 0, 0 )
		sCalDate = Left(sCalDate, 8)
				
		if sCertCnt ~= null and sCertCnt ~= "" then
			if CInt(sCertCnt) > 0 then
				ContainerExist.Grid0.rowcount = sCertCnt
'PENTA13 START => 2019.01.21
				Dim sCertInfo, sTemp, sDate, bUseCert, sOSType
				bUseCert = false
				sOSType = Form.GetSharedData("&OS_TYPE", false)
'PENTA13 END
				for i = 0 to ContainerExist.Grid0.rowcount-1
					sCertInfo = Form.GetCertListDataAt(i)
					
					sTemp = Split(sCertInfo, ";")
					
					for j = 0 to #sTemp-1
						'sTemp[0] 성명
						'sTemp[1] DN
						'sTemp[2] 종류(범용개인)
						'sTemp[3] 발급기관
						'sTemp[5] 사용가능여부(가능1)
						'sTemp[6] 만기일
						'sTemp[7] 시작일
						
						ContainerExist.Grid0.SetCellData( "bd_name", i, sTemp[0] )
						
						'NOHES START 20160609 발급기관정보추가
						ContainerExist.Grid0.SetCellData( "bd_cert", i, sTemp[2].." ("..sTemp[3]..")"  )
						
						'NOHES END
						sDate = sTemp[7]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerExist.Grid0.SetCellData( "bd_date", i, "20"..sDate )
						
						sDate = sTemp[6]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerExist.Grid0.SetCellData( "bd_Edate", i, "20"..sDate )
						ContainerExist.Grid0.SetCellData( "bd_dn", i, sTemp[1] )
						ContainerExist.Grid0.SetCellData( "bd_index", i, i )

						if tonumber("20"..sDate) > tonumber(sCalDate) then
							ContainerExist.Grid0.SetCellData( "bd_icon", i, "login_sub_11.png" )
						else
							ContainerExist.Grid0.SetCellData( "bd_icon", i, "login_sub_12.png" )
						end if
						
'PENTA13 START => 2019.01.25
						if sOSType = "1" then			'안드로이드(1:유효,-1:만료,0:만료예정)
							if sTemp[5] == "0" or sTemp[5] == "1" then
								bUseCert = true
							end if
						else							'iOS(0:유효,1:만료,2:만료예정)
							if sTemp[5] == "0" or sTemp[5] == "2" then
								bUseCert = true
							end if
						end if
'PENTA13 END
					next
				next
				
				for i = ContainerExist.Grid0.rowcount-1 to 0 step -1
					sDate = ContainerExist.Grid0.GetCellData( "bd_Edate", i )
					sCert = ContainerExist.Grid0.GetCellData( "bd_cert", i )
					
					if CInt(sDate) < CInt(sToday) then
						ContainerExist.Grid0.SetDeleteRow( i )
						'ContainerExist.Grid1.SetDeleteRow( i )
					'20160428 NOHES START : 모든 인증서 리스트에 셋팅(만기된 인증서 제외)	
					'elseif Trim(sCert) ~= "증권/보험용" then
					'	Grid0.SetDeleteRow( i )
					'20160428 NOHES END
					end if
				next
				
'PENTA13 START => 2018.12.05
				if bUseCert = true then
					ContainerExist.visible = TRUE
					ContainerNotExist.visible = FALSE
				else
					ContainerExist.visible = FALSE
					ContainerNotExist.visible = TRUE
				end if
			else
				ContainerExist.visible = FALSE
				ContainerNotExist.visible = TRUE
			end if
		else
			ContainerExist.visible = FALSE
			ContainerNotExist.visible = TRUE
'PENTA13 END
		end if
	end if
End Sub

'============================================================================
Sub Image5_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
'인증서 발급하기/가져오기
Sub ContainerNotExist_btnCertPublish_OnClick()
	'인증서 선택 팝업 닫고 인증센터로 이동
	Form.SendReturnToParent("Login_Cert_Select", "0")
	Form.CloseForm()
End Sub


	</SCRIPT_INFO>
