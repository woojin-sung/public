	<SCRIPT_INFO _len="2952" _ulen="2822" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szCnt				' 건수
Dim	g_szText				' 전종목 or 선택종목
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)


	Dim szStr1,szStr2,szStr3
	szStr1 = left(g_szOrder_Acc,4)
	szStr2 = mid(g_szOrder_Acc,5,4)
	szStr3 = right(g_szOrder_Acc,2)

	tblCancle.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)

	tblCancle.SetCellString( 1, 1, g_szCnt)
	tblCancle.SetCellString( 2, 1, g_szText)
	
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_szOrder_Acc			= arrData( 0)	' 계좌번호
	g_szOrder_AccName		= arrData( 1)	' 고객명
	g_szCnt				= arrData( 2)	' 건수
	g_szText				= arrData( 3)' 전종목 or 선택종목
End Sub

'============================================================================
Sub Form_OnFormInit()
    Set_Data(g_nIndex)
    
End Sub


'============================================================================
Sub btnCancle_OnClick()
	SendOrder()
End Sub


'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancleClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
