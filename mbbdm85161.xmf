'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 신규계좌 비밀번호 등록 완료
' 02. 화면설명 : 신규계좌 비밀번호 등록 완료
' 03. 작    성 : 2021.01.22 김유경
' 04. 수    정 :  
' 2021.06.09 : 정민영 : v0001 : T2102250017 : CFD차액결제시스템 구축
'            :        : obaci_acct_049c 변경IO 적용
' 2021.07.21 : 정민영 : v0002 : 비대면CFD개설 목표시장비교에 따른 obaci_acct_049c 변경IO 적용
' 2021.10.26 : 김수진 : v0003 : 비대면중개형ISA/ 해외CFD 상품추가에 따른 obaci_acct_049c 변경IO 적용
' 2022.02.21 : 김수진 : v0004 : 국내/해외 CFD 계좌개설시_국가/계좌 유형 일괄개설 추가 > obaci_acct_049c 변경IO 적용
' 2022.05.04 : 김수진 : v0005 : 계약서류 제공방식 추가 > obaci_acct_049c 변경IO 적용
'-------------------------------------------------------------------------------------------
Dim szCode
Dim gWRPL_TELNO
Dim gCLPH_TELNO
Dim gOWHS_TELNO

Dim gRCNO
Dim gPageID	  '화면의 단계 구분
Dim gRegUniqNo

'****************************************************************************
' GetSharedData ( mbbdm10050/10053)
'****************************************************************************
Dim getDataName        
Dim getDataRcno        
Dim getDataEngname     
Dim getDataAddrgbn     
Dim getDataRegnzip     
Dim getDataDtlzip      
Dim getDataAddr        
Dim getDataAddrdtl     
Dim getDatacyn       
Dim getDataCbldn     
Dim getDataSnmlclcd    
Dim getDataMailclcd    
Dim getDataClphcnplsrno
Dim getDataHp          
Dim getDataEmail       
Dim getDataClpharcd    
Dim getDataClphtono    
Dim getDataCpno        
Dim getDataOwhscnplsrno
Dim getDataOwhsnum     
Dim getDataOwhsarcd    
Dim getDataOwhstono    
Dim getDataOwhstelno   
Dim getDataCocnplsrno  
Dim getDataWrplnum     
Dim getDataWrplarcd    
Dim getDataWrpltono    
Dim getDataWrpltelno   
Dim getDataAcntopngclcd
Dim getHndvMthdCd		'v0005 계약서류 제공방식 추가
Dim getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE	'연금수익률통보처 유형코드
Dim getPnsnYn							'연금저축 개설여부

Dim getAmlProdCode
Dim getOcptCode
Dim getAmlOcknLrdvCode
DIm getAmlOcknSmdvCode
Dim getEddTrObjtCode
Dim getEddTrFndsSorcCode

Dim gCNFR_PW_PIP
Dim gPW_PIP

Dim gMANG_BRCD
'============================================================================

'============================================================================
Sub Form_OnFormInit()
	'BtnNext.bgcolor = 265
	gPageID	   = "3"
		
	'휴대폰번호
	HP1 = Form.GetSharedData("BDM_HP1" , false )
	HP2 = Form.GetSharedData("BDM_HP2" , false )
	HP3 = Form.GetSharedData("BDM_HP3" , false )
	gCLPH_TELNO = HP1 & HP2 & HP3
	
	gWRPL_TELNO = Form.GetSharedData("BDM_WRPLNUM" , false )
	gOWHS_TELNO = Form.GetSharedData("BDM_OWHSNUM" , false )
	
	'>>>>>>>test
'	gWRPL_TELNO = "0264544785"
'	gCLPH_TELNO = "01047657422"
'	gOWHS_TELNO = "0264544785"
		
	gRCNO       = Form.GetSharedData("BDM_RCNO_PIP"    , false ) '주민등록번호
	gRegUniqNo  = Form.GetSharedData("BDM_REG_UNIQ_NO" , false ) '등록고유번호
	
	gPW_PIP     = Form.GetSharedData("BDM_PW_PIP"      , false ) '비밀번호
	gCNFR_PW_PIP= Form.GetSharedData("BDM_CNFR_PW_PIP" , false ) '비밀번호확인
	gMANG_BRCD  = Form.GetSharedData("BDM_MANG_BRCD"   , false ) '관리지점
	
'	gRegUniqNo  = "2020121000001"
'	gRCNO       = "0013AA4383CDA9E15818A39A885FBEA46C0C"
'	
	'***********************************************************
     ' GetSharedData 고객정보 입력_기본정보 ( mbbdm10050/10051)
     '***********************************************************
	Call GetSharedData_Setting()	
	'Container3Step.Image0.visible = True
End Sub

'============================================================================

'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranId = "obaci_acct_049c" Then
		'공통-필수(InBlock1)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 			, 0 , gRegUniqNo			     ) '등록고유번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 		, 0 , gPageID				     ) '등록단계구분코드
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "MANG_BRCD" 		     , 0 , gMANG_BRCD			     ) '등록단계구분코드
		'3단계-고객정보(InBlock5)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "ACNT_OPNG_CLCD" 		, 0 , getDataAcntopngclcd		) '계좌개설구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ABWR_NAME" 		, 0 , getDataName			     ) '고객약어명
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ENG_NAME" 		     , 0 , getDataEngname			) '고객영문명
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "ACNT_PWD"    	  	     , 0 , gPW_PIP			     ) '계좌비밀번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "UI_CNFR_PWD" 		     , 0 , gCNFR_PW_PIP			) 'UI확인비밀번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_PROD_CODE" 			, 0 , getDataAmlProdCode		) 'AML상품코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_CHAN_TYPE_CODE" 	, 0 , "03"					) 'AML채널유형코드
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OCPT_CODE" 			, 0 , getDataOcptCode			) '직업코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_OCKN_LRDV_CODE" 	, 0 , getDataAmlOcknLrdvCode	) 'AML직종대분류코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_OCKN_SMDV_CODE" 	, 0 , getDataAmlOcknSmdvCode	) 'AML직종소분류코드
		
		'거래목적, 자금원천
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EDD_TR_OBJT_CODE" 		, 0 , getDataEddTrObjtCode		) 'EDD거래목적코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EDD_TR_FNDS_SORC_CODE" 	, 0 , getDataEddTrFndsSorcCode	) 'EDD거래자금출처코드
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_ADDR_SRNO" 		, 0 , getOwhsAddrSrno		     ) '자택주소일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_ADDR_SRNO" 			, 0 , getCoAddrSrno		     ) '회사주소일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR_SRNO" 		, 0 , getEmailAddrSrno		     ) '이메일주소일련번호	
	
		If getDataAddrgbn ="01" Then '주소지정보: 자택 
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_REGN_ZIP" 		     , 0 , getDataRegnzip 	) '자택지역우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_DTL_ZIP" 			 , 0 , getDataDtlzip   ) '자택상세우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_POST" 			 , 0 , getDataAddr     ) '자택우편주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_DTAD" 			 , 0 , getDataAddrdtl  ) '자택상세주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_NW_ADDR_USE_YN"      , 0 , getDataCyn     	) '자택신주소사용여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_BLDN_MNNO" 		 , 0 , getDataCbldn    ) '자택건물관리번호
		ElseIf getDataAddrgbn ="02" Then '주소지정보: 직장 
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_REGN_ZIP" 			 , 0 , getDataRegnzip 	) '회사지역우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_DTL_ZIP" 			 , 0 , getDataDtlzip  	) '회사상세우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_POST" 				 , 0 , getDataAddr     ) '회사우편주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_DTAD" 				 , 0 , getDataAddrdtl  ) '회사상세주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_NW_ADDR_USE_YN"        , 0 , getDataCyn     	) '회사신주소사용여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_BLDN_MNNO" 			 , 0 , getDataCbldn   	) '회사건물관리번호
		End If

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR" 			 , 0 , getDataEmail	) '이메일주소
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_ARCD" 			 , 0 , getDataOwhsarcd ) '자택지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_TONO" 			 , 0 , getDataOwhstono ) '자택국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_TELNO" 			 , 0 , getDataOwhstelno) '자택전화번호

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_ARCD" 				 , 0 , getDataWrplarcd ) '회사지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_TONO" 				 , 0 , getDataWrpltono ) '회사국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_TELNO" 				 , 0 , getDataWrpltelno) '회사전화번호

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_ARCD" 			 , 0 , getDataClpharcd	) '휴대폰지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_TONO" 			 , 0 , getDataClphtono	) '휴대폰국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CPNO" 					 , 0 , getDataCpno	) '휴대폰번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "SNML_INAG_TYPE_CODE"      , 0 , getDataSnmlclcd ) '발송물통보처유형코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "MAIL_INAG_TYPE_CODE"      , 0 , getDataMailclcd ) '우편물통보처유형코드	

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_CNPL_SRNO" 		 , 0 , "0"			) '자택연락처일련번호	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_CNPL_SRNO" 			 , 0 , "0"			) '회사연락처일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_CNPL_SRNO" 		 , 0 , "0"			) '휴대폰연락처일련번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE"   		 , 0 , getHndvMthdCd	) 'v0005 교부방식
		
		If getPnsnYn == "Y" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 ,  getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE )
		End If

	End If
End Sub 

'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_acct_049c" Then
		Form.OpenNextPopup("mbbdm85170" , "" , "")
	End If
End Sub 

'============================================================================
Sub BtnNext_OnClick()
	DATAMANAGER.RequestTranData("obaci_acct_049c")
End Sub

'===========================================================================
' GetSharedData_Setting 고객정보 입력_기본정보 ( mbbdm10050/10053/10051)
'===========================================================================
Function GetSharedData_Setting()
	'고객정보 입력_기본정보(신규종합) (mbbdm10050)
	getDataName          = Form.GetSharedData( "BDM_NAME"    	, false )
	getDataRcno          = Form.GetSharedData( "BDM_RCNO"    	, false )
	getDataEngname       = Form.GetSharedData( "BDM_ENGNAME" 	, false )
	getDataAddrgbn       = Form.GetSharedData( "BDM_ADDRGBN" 	, false )
	getDataRegnzip       = Form.GetSharedData( "BDM_REGNZIP" 	, false )
	getDataDtlzip        = Form.GetSharedData( "BDM_DTLZIP"  	, false )
	getDataAddr          = Form.GetSharedData( "BDM_ADDR"    	, false )
	getDataAddrdtl       = Form.GetSharedData( "BDM_ADDRDTL" 	, false )
	getDataCyn           = Form.GetSharedData( "BDM_CYN"      	, false )
	getDataCbldn         = Form.GetSharedData( "BDM_CBLDN"    	, false )
	getDataSnmlclcd      = Form.GetSharedData( "BDM_SNMLCLCD"	, false )
	getDataMailclcd      = Form.GetSharedData( "BDM_MAILCLCD"	, false )
	getDataClphcnplsrno  = Form.GetSharedData( "BDM_CLPHCNPLSRNO" , false )
	getDataHp            = Form.GetSharedData( "BDM_HP"      	, false )
	getDataEmail         = Form.GetSharedData( "BDM_EMAIL"   	, false )
	getDataClpharcd      = Form.GetSharedData( "BDM_CLPHARCD"	, false )
	getDataClphtono      = Form.GetSharedData( "BDM_CLPHTONO"	, false )
	getDataCpno          = Form.GetSharedData( "BDM_CPNO" 		, false )
	getDataOwhscnplsrno  = Form.GetSharedData( "BDM_OWHSCNPLSRNO" , false )
	getDataOwhsnum       = Form.GetSharedData( "BDM_OWHSNUM"  	, false )
	getDataOwhsarcd      = Form.GetSharedData( "BDM_OWHSARCD" 	, false )
	getDataOwhstono      = Form.GetSharedData( "BDM_OWHSTONO" 	, false )
	getDataOwhstelno     = Form.GetSharedData( "BDM_OWHSTELNO"	, false )
	getDataCocnplsrno    = Form.GetSharedData( "BDM_COCNPLSRNO"   , false )
	getDataWrplnum       = Form.GetSharedData( "BDM_WRPLNUM"  	, false )
	getDataWrplarcd      = Form.GetSharedData( "BDM_WRPLARCD" 	, false )
	getDataWrpltono      = Form.GetSharedData( "BDM_WRPLTONO" 	, false )
	getDataWrpltelno     = Form.GetSharedData( "BDM_WRPLTELNO"	, false )
	getDataAcntopngclcd  = Form.GetSharedData( "BDM_ACNTOPNGCLCD", false)
	getOwhsAddrSrno      =	Form.GetSharedData( "BDM_OWHS_ADDR_SRNO" , false) '자택주소일련번호	
	getCoAddrSrno        =	Form.GetSharedData( "BDM_CO_ADDR_SRNO"   , false) '회사주소일련번호
	getEmailAddrSrno     = Form.GetSharedData( "BDM_EMAIL_ADDR_SRNO", false) '이메일주소일련번호
	getHndvMthdCd        = Form.GetSharedData( "BDM_HNDV_MTHD_CODE"  , false) 'v0005 계약서류 제공방식 추가
	
	'연금수익률보고서 통보처 유형코드, 연금저축 개설여부 추가
	getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE = Form.GetSharedData( "BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE"   	, false )
	getPnsnYn = Form.GetSharedData( "BDM_PRCD131"   	, false )
	
	'고객정보 입력_고객확인의무(mbbdm10051)
	getDataAmlProdCode     = Form.GetSharedData( "BDM_AMLPRODCODE"      , false )
	getDataOcptCode        = Form.GetSharedData( "BDM_OCPTCODE" 	    , false )
	getDataAmlOcknLrdvCode = Form.GetSharedData( "BDM_AMLOCKNLRDVCODE"  , false )
	getDataAmlOcknSmdvCode = Form.GetSharedData( "BDM_AMLOCKNSMDVCODE"  , false )
	getDataEddTrObjtCode   = Form.GetSharedData( "BDM_EDDTROBJTCODE"    , false )	
	getDataEddTrFndsSorcCode = Form.GetSharedData( "BDM_EDDTRFNDSORCCODE",  false ) '자금의원천
	
End Function 


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranId = "obaci_acct_049c" Then	
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	End If  
	
	Container3Step.Image0.visible = True
	
End Sub

'============================================================================
Sub Container3Step_Image0_OnClick()
	Form.OpenNextPopup("mbbdm85162" , "" , "")
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obaci_acct_049c" trcode="obaci_acct_049c" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obaci_acct_049c" title="비대면계좌개설 이어가기" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="111" _ulen="83" >

REG_UNIQ_NO^등록고유번호^13^0^0^0^0^0^0
REG_STAG_CLS_CODE^등록단계구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="InBlock2" inout="in" _len="552" _ulen="404" >

RCNO_TYPE_CODE^실명확인번호유형코드^2^0^0^0^0^0^0
RCNO_PIP^실명확인번호PIP^68^0^0^0^0^0^0
CUST_ABWR_NAME^고객약어명^40^0^0^0^0^0^0
ATHN_MTHD_CLS_CODE^인증방법구분코드^1^0^0^0^0^0^0
ATHN_STAT_CLS_CODE^인증상태구분코드^1^0^0^0^0^0^0
MCCO_CODE^이동통신사코드^3^0^0^0^0^0^0
CLPH_ARCD^휴대폰지역번호^4^0^0^0^0^0^0
