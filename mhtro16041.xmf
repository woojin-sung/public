Sub Form_OnFormInit()
	WebView0.webscroll = "1"
	WebView0.viewtype  = "0"
	WebView0.urlpath = "http://globalmonitor.einfomax.co.kr/meritz_mobile_new.html#/USA/7/01" '20210204 JRM MODIFY
end Sub

'============================================================================
Sub Form_OnRefresh()
	WebView0.urlpath = "http://globalmonitor.einfomax.co.kr/meritz_mobile_new.html#/USA/7/01" '20210204 JRM MODIFY
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

	</SCRIPT_INFO>
