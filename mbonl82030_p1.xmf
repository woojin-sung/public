	<SCRIPT_INFO _len="2230" _ulen="2212" >
--===========================================================================
--===========================================================================
Dim szOpenData
Dim arrOpenData
Dim szACNO
Dim szASNO
Dim szLOAN_DTL_TYPE_CODE
Dim szLOAN_DATE
Dim szISCD
Dim nLOAN_SRNO
Dim szSTND_DATE
'============================================================================
Sub Form_OnFormInit()
	szOpenData = Form.GetOpenLinkData()
	
	arrOpenData = Split(szOpenData, "★",-1,0)
	
	szACNO 				= arrOpenData(0)
	szASNO 				= arrOpenData(1)
	szLOAN_DTL_TYPE_CODE 	= arrOpenData(2)
	szLOAN_DATE 			= arrOpenData(3)
	szISCD 				= arrOpenData(4)
	nLOAN_SRNO 			= arrOpenData(5)
	szSTND_DATE 			= arrOpenData(6)
	
	
	DATAMANAGER.RequestTranData( "oblon_pros_976r" )
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "oblon_pros_976r" then
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "ACNO"			, 0 , szACNO)
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "ASNO"			, 0 , szASNO)
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "ISCD"			, 0 , szISCD)
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "LOAN_DATE"		, 0 , szLOAN_DATE)
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "STND_DATE"		, 0 , szSTND_DATE)
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "LOAN_DTL_TYPE_CODE", 0 , szLOAN_DTL_TYPE_CODE)
		DATAMANAGER.SetDataValue(0, "oblon_pros_976r", "InBlock1", "LOAN_SRNO"		, 0 , nLOAN_SRNO)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_pros_976r" then
		iqry_cls_code = DATAMANAGER.GetDataValue(0, "oblon_pros_976r", "OutBlock1", "IQRY_CLS_CODE" , 0)
		
		if iqry_cls_code = "1" then
			Grid0.visible = true
			Grid1.visible = false
		else
			Grid0.visible = false
			Grid1.visible = true
		end if
		
		tmpLOAN_DTL_TYPE_CODE = DATAMANAGER.GetDataValue(0, "oblon_pros_976r", "OutBlock1", "LOAN_DTL_TYPE_CODE", 0)
		Label0.caption = Form.GetMetaData( "대출상세유형코드", tmpLOAN_DTL_TYPE_CODE )
	end if
End Sub

	</SCRIPT_INFO>
