Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_42_n.9"

Dim g_szToolTipImg
g_szToolTipImg = "icon_question"

Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

Dim g_szBgColor_Grey  
g_szBgColor_Grey = "320"

' 기본 구분선 색상
' 진한색
Dim g_szLineColor
g_szLineColor = "347"
' 중간색
Dim g_szLineColor2
g_szLineColor2 = "256"
' 연한색
Dim g_szLineColor3
g_szLineColor3 = "320"

Dim g_szItemCd, g_szExidCd, g_szOnlyCd
g_szItemCd = ""
g_szExidCd = ""
g_szOnlyCd = ""

Dim g_nCommFontSize
g_nCommFontSize = "0"
'****************************************************************************
