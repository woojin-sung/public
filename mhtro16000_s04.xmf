'===============================================
' 컨트롤 초기화
'===============================================
Function Init_Control()
	g_nCommFontSize = Form.getEnvData("common.textsize")
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle1.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle1.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle2.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle2.paddinginfo = "0,0,0,0"

	contMain.lblBg0.imagefilepth = "img_bgbox_blue.9"
	contMain.lblBg1.imagefilepth = "img_bgbox_line1.9"
	contMain.lblTitle0.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle1.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle1.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle2.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle2.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle3.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle3.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle4.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle4.paddinginfo = "0,0,0,0"
	
	contMain.lblTitle5.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle5.paddinginfo = "0,0,0,0"
	
	contMain.lblData0.fgcolor = g_szTxtColor_Normal
	contMain.lblData0.paddinginfo = "0,0,0,0"
	
	contMain.lblData1.fgcolor = g_szTxtColor_Normal
	contMain.lblData1.paddinginfo = "0,0,0,0"
	
	contMain.lblData2.fgcolor = g_szTxtColor_Normal
	contMain.lblData2.paddinginfo = "0,0,0,0"
	
	contMain.lblData3.fgcolor = g_szTxtColor_Normal
	contMain.lblData3.paddinginfo = "0,0,0,0"
	
	contMain.lblData4.fgcolor = g_szTxtColor_Normal
	contMain.lblData4.paddinginfo = "0,0,0,0"
	
	contMain.lblData6.fgcolor = g_szTxtColor_Normal
	contMain.lblData6.paddinginfo = "0,0,0,0"
	
	contMain.lblData5.fgcolor = g_szTxtColor_Grey
	contMain.lblData5.paddinginfo = "0,0,0,0"
	contMain.lblData5.caption = "최근 배당금 지급 내역이 없습니다."
	
	contMain.imgTooltip0.setMaintainingRatio("2")
	contMain.imgTooltip0.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("예상 배당", 0, true, false)
	contMain.imgTooltip0.left = 20 + nTextWidth + 5
	
'	contMain.lblSubTitle0.setNeighborCtlPos("imgTooltip0", "right", 5, "예상 배당")
	
	contMain.imgTooltip1.setMaintainingRatio("2")
	contMain.imgTooltip1.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("최근 배당", 0, true, false)
	contMain.imgTooltip1.left = 20 + nTextWidth + 5
	
'	contMain.lblSubTitle1.setNeighborCtlPos("imgTooltip1", "right", 5, "최근 배당")
	
	contMain.lblExpand.fgcolor = g_szTxtColor_Grey
	contMain.lblExpand.paddinginfo = "0,0,0,0"
	
	contMain.lblLine2.bgcolor = "238239240"
	
	contMain.lblDiv0.bgcolor = g_szLineColor3

End Function

Function Change_Layout(isEmpty1, isEmpty2)
	if isEmpty1 == "" and isEmpty2 == "" then
		Form.triggerEvent("#", "CHANGE_LAYOUT_S4", "0")
		Exit Function
	end if
	
	contMain.lblSubTitle2.visible = false
	contMain.lblLine1.visible = false
	contMain.lblData5.visible = false
	
	contMain.tbl1.visible = false
	contMain.tbl0.visible = false
	
	if isEmpty1 == true then 
		Form.triggerEvent("#", "CHANGE_LAYOUT_S4", "177")
	else
		Form.triggerEvent("#", "CHANGE_LAYOUT_S4", "336")
	end if
	
	if isEmpty2 == true then
		contMain.lblExpand.visible = false
	else
		contMain.lblExpand.visible = true
	end if
End Function

Function RequestTranData_016r(szItemCd, szMktCd)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_016r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_016r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szItemCd)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_016r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMktCd)
	
	DATAMANAGER.RequestTranData("ohhts_metf_016r")
End Function

Function ResponseTranData_016r()
	szData0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock1", "FID_ANTC_DVDN_ERT" , 0)
	szData1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock1", "FIDX_ANTC_DVMN" , 0)
	szData2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock1", "FID_DVDN_ERT" , 0)
	szData3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock1", "FID_DVMN_PRVS_FORM" , 0)
	szData7 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock1", "FIDX_CRNC_CODE" , 0)
	szData8 = DATAMANAGER.GetDataValue(0,  "ohhts_metf_016r", "OutBlock1", "FID_DVDN_CYCL", 0)
	
	szData4 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock2", "FID_EXDV_DAY" , 0)
	szData6 = DATAMANAGER.GetDataValue(0, "ohhts_metf_016r", "OutBlock2", "FIDX_DVMN" , 0)
	
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_016r", "OutBlock2")
	
	nChkData = 0
	'예상 배당
	'예상 배당률
	if szData0 = "" or Cdbl(szData0) = 0 then
		contMain.lblData0.caption = "-"
		nChkData = nChkData + 1
	else
		contMain.lblData0.caption = szData0 & "%"
	end if
	
	'예상 배당금
	if szData1 = "" or Cdbl(szData1) = 0 then
		contMain.lblData1.caption = "-"
		nChkData = nChkData + 1
	else
		if g_szExidCd = "J" then
			contMain.lblData1.caption = szData1 & " 원"
		else
			contMain.lblData1.caption = szData1 & " " & szData7
		end if
	end if
	
	'최근 배당
	'최근 배당금
	szData6_Result = ""
	if g_szExidCd = "J" then
		if szData6 == "" or Cdbl(szData6) == 0 then
			szData6_Result = "-"
			nChkData = nChkData + 1
		else
			szData6_Result = FormatNumber(szData6, 0) & " 원"
		end if
		
	else
		if g_szExidCd == "SH" or g_szExidCd == "SZ" then
			szData6_Result = "-"
			nChkData = nChkData + 1
		elseif szData6 == "" or Cdbl(szData6) == 0 then
			szData6_Result = "-"
			nChkData = nChkData + 1
		else
			szData6_Result = FormatNumber(szData6, 2) & " " & szData7
		end if
	end if
	
	contMain.lblData6.caption = szData6_Result
	
	'최근 배당락일
	szData4_Result = ""
	if szData4 = "19000101" or szData4 = "" then
		szData4_Result = "-"
		nChkData = nChkData + 1
	elseif g_szExidCd == "SH" or g_szExidCd == "SZ" then
		szData4_Result = "-"
		nChkData = nChkData + 1
	else
		szData4_Result = left(szData4, 4) & "년 " & mid(szData4, 5, 2) & "월 " & right(szData4, 2) & "일"
	end if
	
	contMain.lblData4.caption = szData4_Result
	
	'배당주기
	if szData8 = "" then
		contMain.lblData2.caption = "-" 
		nChkData = nChkData + 1
	else
		contMain.lblData2.caption = szData8
	end if
	
	'연간 배당률
	if szData2 = "" or Cdbl(szData2) = 0 then
		contMain.lblData3.caption = "-"
		nChkData = nChkData + 1
	else
		contMain.lblData3.caption = szData2 & "%"
	end if
	
	isEmpty1 = false
	if contMain.lblData0.caption == "-" and contMain.lblData1.caption = "-" then
		isEmpty1 = true
	end if
	
	isEmpty2 = false
	if Cint(nDataCnt) == 0 or g_szExidCd == "SH" or g_szExidCd == "SZ" then
		isEmpty2 = true
	end if
	
	if nChkData == 6 then
		isEmpty1 = ""
		isEmpty2 = ""
	end if
	
	Change_Layout(isEmpty1, isEmpty2)
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_016r" then
		ResponseTranData_016r()
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		g_szItemCd = sParam
		g_szExidCd = ""
		
		if instr(g_szItemCd, "@") > 0 then
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 
			g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
		else
			g_szExidCd = "J"
			g_szOnlyCd = sParam
		end if

		
		RequestTranData_016r(g_szOnlyCd, g_szExidCd)
	end if
End Sub

'============================================================================
Sub contMain_lblExpand_OnClick()
	szItemNm = Form.getItemCodeInfo(g_szItemCd, "name")
	Form.OpenPopup("mhtro16000_p13" , szItemNm & "★" & g_szOnlyCd & "★" & g_szExidCd,"" )
End Sub

'============================================================================
Sub contMain_imgTooltip0_OnClick()
	sText = "향후 12개월 예상 배당으로 최근 배당 추이를 기준으로 모닝스타와 당사 리서치센터에서 산출한 정보입니다.\n예상 배당금은 변동 될 수 있으니 참고용으로만 사용해주세요."
	contMain.imgTooltip0.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.imgTooltip0.openToolTip( sText, 350, 135, 2 )
	else
		contMain.imgTooltip0.openToolTip( sText, 300, 135, 2 )
	end if
End Sub

