'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기   
	chkAll_OnChange("1")
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 호가테이블 클릭 호가연동
	' ----------------------------------------------------------------------	
	if sEventName == "HOGA" then
		'20220524 SWJ START : 시장가 유형 추가
		szType = Check_OrdType()
		
		if szType <> "05" and szType <> "33" and szType <> "34" and szType <> "37" and szType <> "38" then 
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
		'20220524 SWJ END
	' ----------------------------------------------------------------------
	' 메인화면 이벤트 처리 (종목변경, 탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	elseif sEventName == "16060_InitCode" or sEventName == "16060_ChangeCode" or sEventName == "16060_ChangeTab" then			
		if g_szCd <> sParam  or g_szCd == "" then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")	' 거래소벤더코드
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		
		if g_bCntrtRtn == false then
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
			end if
		else
			g_bCntrtRtn = false
		end if
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "16060_ChangeAcnt" then
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
	' 20171127 HAMWG END	

	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		
		if g_bCntrtRtn == false then
			if Trim(sParam) <> "" then	
				if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
					Init_InputControl()
				else
					edtPrc.caption = sParam
					edtPrc_OnEditComplete()
				end if
			end if
		else
		
			g_bCntrtRtn = false
		end if

	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 20181022 HWG END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		g_szQty = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	' ----------------------------------------------------------------------
	' 해외주식 미체결팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "16060_CONTRACT" then
		if sRet == "" then
			Exit Sub
		end if
		
		g_bCntrtRtn = true
		Return_ContractScreen(sRet)	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 해외주식 정정주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_102a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtro_oder_102a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNO"					, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ASNO"					, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_DATE"				, 0, g_szOrdDate)								' 주문일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ORGL_ODER_NO"			, 0, edtOrgNo.caption)							' 원주문번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "PRTN_WHOL_TPCD"			, 0, "2")									' 전량체크
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODQT"					, 0, g_szQty)									' 주문수량
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "OVRS_STCK_ODER_PRC"		, 0, edtPrc.caption)							' 주문가격
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_RCTF_CNCL_CLS_CODE"	, 0, "1")									' 주문정정취소구분
'		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_CLS_CODE"			, 0, "01")									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_CLS_CODE"			, 0, Check_OrdType())							' 20220526 
'		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_COND_CLS_CODE"		, 0, "0")									' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_COND_CLS_CODE"		, 0, Check_OrdCond())							' 20220526
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, "01")									' 주문발생유형코드(01:일반주문)	
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "WARN_CNFR_YN"			, 0, g_szWarnFlag)								' 경고확인여부	' 20181022 HWG : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_6000_001r" then
		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
		
	'20171204 HAMWG START : 해외주식_시세조회 서비스 세팅
	elseif szTranID == "getGtsHogaDetail" then
		DATAMANAGER.SetDataValue( 0, "getGtsHogaDetail", "inblock", "code" , 0 , g_szCd )
		
	' ----------------------------------------------------------------------
	' 고시환율 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )
	end if
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg
	
	' ----------------------------------------------------------------------
	' 해외주식 정정주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtro_oder_102a"	
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
				
				if Trim(szOrdCd) == "0001" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
				end if
			end if
			' 20181022 HWG END

	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
		Case "ohhts_6000_001r"

			g_szLast		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 	, 0 )	' 현재가
			g_szUpLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" 	, 0 )))	' 상한가
			g_szDnLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" 	, 0 )))	' 하한가
'			g_szUnit		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ASPR_UNIT" 	, 0 )	' 호가단위
			g_szOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" , 0 )	' 매매단위
			g_szCur		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 	, 0 )	' 통화
			g_szDecimal 	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
			g_szKorName	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" 	, 0 )	' 한글종목명
			g_szTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_TICK_CLS" 	, 0 )	' 종목 틱타입
'			g_szKofx		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 		, 0 )	' 환율

			GetHogaUnit(g_szMk, g_szLast, 0)		'20180710 HAMWG : 호가단위 설정함수 변경

			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
			edtPrc.mask = sMask
			Table0.SetCellMaskInfo(2, 1, sMask)
			
			Table0.SetCellString(2, 0, g_szCur)
			Table0.SetCellString(0, 1, g_szOrdSize)
			
			DATAMANAGER.RequestTranData("obtro_comn_025r")
		Case "obtro_comn_025r"
			szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
			Table0.SetCellString(1, 1, Cdbl(szAnncExrt))
		
	'20171204 HAMWG END
	End Select	
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
' btnMod_OnClick : 정정버튼 클릭
'============================================================================
Sub btnMod_OnClick()
	Check_InputData(0)
End Sub

'============================================================================
' btnMiche_OnClick : 미체결버튼 클릭
'============================================================================
Sub btnMiche_OnClick()
	szAcnt 		= Form.GetTopCtlProp("acnt", "total")
	szAcntCd 	= Form.GetTopCtlProp("acnt", "sequence")
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcntPwd	= Form.GetTopCtlProp("edtPwd", "caption")
	'MTS메모리평문제거 미적용상태일 때
	else
		szAcntPwd	= Form.GetTopCtlProp("edtPwd", "encdata")
	end if
	'20200910 SWJ END
	
	' 계좌번호(8), 계좌일련번호(2), 비밀번호
	szData = szAcnt & "★" & szAcntCd & "★" & szAcntPwd 
	Form.OpenFramePopup("mhtro16060_pc", szData, "")
End Sub

'============================================================================
' btnPPlus_OnClick : 가격 + 버튼
'============================================================================
Sub btnPPlus_OnClick()
	Calc_Price(0)

End Sub

'============================================================================
' btnPMinus_OnClick : 가격 - 버튼
'============================================================================
Sub btnPMinus_OnClick()
	Calc_Price(1)
End Sub

'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAll_OnChange(sCheckState)
	
	if sCheckState == "1" then
		edtQty.caption = ""	
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		edtQty.caption = g_szQty	
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()	
	if chkAll.checkstate == "0" then
		szData = "0★" & edtQty.caption & "★" & _tonumber(g_szOrdSize)
		Form.OpenPopup("mhtro16060_p1", szData, "")
	end if
End Sub

'============================================================================
' btnPrc_OnClick
'============================================================================
Sub btnPrc_OnClick()
if Trim(edtPrc.caption) == "" then
		szPrc = ""
	else
		szChk = InStr(CStr(edtPrc.caption), ".")
	
		if CStr(szChk) == "0" then
			if g_szDecimal = "1" then
				szPrc = edtPrc.caption & ".0"	
			elseif g_szDecimal = "2" then
				szPrc = edtPrc.caption & ".00"	
			elseif g_szDecimal = "3" then
				szPrc = edtPrc.caption & ".000"	
			elseif g_szDecimal = "4" then
				szPrc = edtPrc.caption & ".0000"	
			end if 
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == "1" then 
				if g_szDecimal == "2" then
					szPrc = edtPrc.caption & "0"	
				elseif g_szDecimal == "3" then
					szPrc = edtPrc.caption & "00"	
				elseif g_szDecimal == "4" then
					szPrc = edtPrc.caption & "000"
				else 
					szPrc = edtPrc.caption
				end if 	
			elseif CStr(szCha) == "2" then 
				if g_szDecimal == "3" then
					szPrc = edtPrc.caption & "0"	
				elseif g_szDecimal == "4" then
					szPrc = edtPrc.caption & "00"
				else
					szPrc = edtPrc.caption
				end if	
			elseif CStr(szCha) == "3" then 
				if g_szDecimal == "4" then
					szPrc = edtPrc.caption & "0"
				else 
					szPrc = edtPrc.caption
				end if	
			else
				szPrc = edtPrc.caption
			end if
		end if
	end if
	
	'20180710 HAMWG : 호가단위 설정함수 변경(국가코드->거래소벤더코드 변경)
	Form.OpenPopup("mhtro16060_p2" , szPrc & "★" & g_szCd & "★" & g_szMk & "★" & g_szUnit & "★" & cmbType.currentindex & "★" & g_szUpLimit & "★" & g_szDnLimit & "★" & g_szDecimal & "★" & g_szTickType, "")
End Sub


'============================================================================
Sub edtPrc_OnEditComplete()
	if edtQty.caption == "" or edtPrc.caption == "" then
		Table0.SetCellString(2, 1, "")
		Table0.SetCellString(3, 1, "")
	else	
		if edtQty.caption == "0" or edtPrc.caption == "0" then
			Table0.SetCellString(2, 1, "")
			Table0.SetCellString(3, 1, "")
		else
			temp = Cdbl(edtPrc.caption) * Cdbl(edtQty.caption)
			Table0.SetCellString(2, 1, temp)
		
			temp2 = Cdbl(Table0.GetCellString(1, 1))
			temp3 = temp * temp2
			Table0.SetCellString(3, 1, Cdbl(temp3))
		end if
	end if
End Sub

'============================================================================
Sub edtQty_OnEditComplete()
	if edtQty.caption == "" or edtPrc.caption == "" then
		Table0.SetCellString(2, 1, "")
		Table0.SetCellString(3, 1, "")
	else	
		if edtQty.caption == "0" or edtPrc.caption == "0" then
			Table0.SetCellString(2, 1, "")
			Table0.SetCellString(3, 1, "")
		else
			temp = Cdbl(edtPrc.caption) * Cdbl(edtQty.caption)
			Table0.SetCellString(2, 1, temp)
		
			temp2 = Cdbl(Table0.GetCellString(1, 1))
			temp3 = temp * temp2
			Table0.SetCellString(3, 1, Cdbl(temp3))
		end if
	end if
End Sub

