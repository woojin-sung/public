g_szWarnFlag	= "N"
' 20181022 HWG END

Dim g_szTR

Dim g_szTitle
g_szTitle = "알림"

Dim g_szQty
g_szQty = ""

Dim g_bCntrtRtn		' 미체결리턴
g_bCntrtRtn = false

' 20171204 HAMWG START : 해외주식_공유변수 선언
Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szLast			' 현재가
g_szLast = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit	=  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit	=  ""

