'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "★")
	' 전달내용/종목코드/해외거래소벤더코드/종목명/주문일자/주문번호/미체결수량/주문가격/주문유형
	if UBound(tData) > 0 then
		szMkCd = Transform_Exid(tData(2))

		Form.triggerEvent("#", "16060_CONTRACT", szMkCd & "@" & tData(1) & "★" & tData(3))
		
		'20220526 START
		if tData(8) <> "" and tData(8) <> null then
			f_SetCmbIdx(tData(8))
			
			'MOO,MOC,VWAP,TWAP 시장가 주문일 때
			if tData(8) == "6" or tData(8) == "7" or tData(8) == "A" or tData(8) == "B" then
				btnPrc.enable = false
				btnPPlus.enable = false
				btnPMinus.enable = false
				edtPrc.enable = false
			else
				btnPrc.enable = true
				btnPPlus.enable = true
				btnPMinus.enable = true
				edtPrc.enable = true
			end if
		end if
		'20220526 END
		
		' 주문번호
		edtOrgNo.caption = tData(5)						
		edtOrgNo_OnEditComplete()
		
		' 주문일자
		g_szOrdDate = tData(4)
		
		' 수량
		g_szQty = ""
		edtQty.caption = tData(6)	
		edtQty_OnEditComplete()
		g_szQty = tData(6)
		
		' 주문가격
		'20230309_01 HWG START : 시장가 유형 주문가격 세팅 방지 
		szOrdType = Check_OrdType()
		if szOrdType <> "05" and szOrdType <> "33" and szOrdType <> "34" and szOrdType <> "37" and szOrdType <> "38" then 
			edtPrc.caption = tData(7)
		else
			edtPrc.caption = 0
		end if
		'20230309_01 HWG END 
		
		edtPrc_OnEditComplete()
	end if
End Function
'============================================================================
' f_SetCmbIdx : 주문유형 SET 20220526
'============================================================================
'20220526 START
Function f_SetCmbIdx(sType)
	Select Case sType
		Case "1"
			cmbType.currentindex = "1" '시장가
		Case "2"
			cmbType.currentindex = "0" '지정가
		Case "4"
			cmbType.currentindex = "2" 'LOO
		Case "5"
			cmbType.currentindex = "3" 'LOC
		Case "6"
			cmbType.currentindex = "4" 'MOO
		Case "7"
			cmbType.currentindex = "5" 'MOC
		Case "8"
			cmbType.currentindex = "6" 'Limit VWAP
		Case "9"
			cmbType.currentindex = "7" 'Limit TWAP
		Case "A"
			cmbType.currentindex = "8" 'VWAP
		Case "B"
			cmbType.currentindex = "9" 'TWAP
	End Select	
End Function
'20220526 END
'============================================================================
' 거래소코드 <- 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
' Check_OrdType : 주문주문유형 값 20220526
'============================================================================
Function Check_OrdType()
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	Select Case szIdx
		Case "0"
			return "01" '지정가
		Case "1"
			return "05" '시장가
		Case "2" 
			return "31" 'LOO
		Case "3"
			return "32" 'LOC
		Case "4"
			return "33" 'MOO
		Case "5"
			return "34" 'MOC
		Case "8"
			return "37" 'VWAP
		Case "9"
			return "38" 'TWAP
		Case "6"
			return "35" 'Limit VWAP
		Case "7"
			return "36" 'Limit TWAP
	End Select
End Function

'============================================================================
' Check_OrdCond 주문조건구분코드 20220526 아이티젠 김성수 추가
'============================================================================
Function Check_OrdCond()
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "0" '지정가
		Case "05"
			return "0" '시장가
		Case "31"
			return "2" 'LOO
		Case "32"
			return "7" 'LOC
		Case "33"
			return "2" 'MOO
		Case "34"
			return "7" 'MOC
		Case "35"
			return "0" 'Limit VWAP
		Case "36"
			return "0" 'Limit TWAP
		Case "37"
			return "0" 'VWAP
		Case "38"
			return "0" 'TWAP
	End Select
End Function

'============================================================================
' Check_OrdName 주문유형명 20220526 아이티젠 김성수 추가
'============================================================================
Function Check_OrdName()
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "지정가"
		Case "05"
			return "시장가"
		Case "31"
			return "LOO" 
		Case "32"
			return "LOC" 
		Case "33"
			return "MOO" 
		Case "34"
			return "MOC" 
		Case "35"
			return "Limit VWAP" 
		Case "36"
			return "Limit TWAP" 
		Case "37"
			return "VWAP" 
		Case "38"
			return "TWAP" 
	End Select
End Function
