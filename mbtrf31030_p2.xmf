	<SCRIPT_INFO _len="38570" _ulen="36206" >

' 20160317 가격 Max : 7 (전요셉과장)

'============================================================================
' 화 면 명 : 선물옵션주문_가격입력창
' 화면설명 : 선물옵션주문 가격입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================
'20180320 LES START - KRX300선물/코스닥150옵션 추가 
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg
'20231121 SWJ START : 제도개선 : 주식선물 ETF 호가 단위 변경
				   '2000 미만은 1원, 2000원 이상은 5원 단위로 변경
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive
g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive = "", "", "", ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' ReSet_Prc : 20160324 추가
'============================================================================
'20170420 HAMWG START : 야간선옵 틱가격 단위 추가
Function ReSet_Prc(szData, nGbn)
		
	'20220915 LES START 상품선물 추가
	'금리선물/스프레드 (g_szMk:CF, nzInnerMarket = 52 / 53)
	'통화선물/스프레드 (g_szMk:CF, nzInnerMarket = 54 / 55)
	'상품선물/스프레드 (g_szMk:CF, nzInnerMarket = 56 / 57) 
	'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
	if g_szMk == "CF" or g_szMk == "FF" then
	
		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
		
		'상품선물(금)
		if nzInnerMarket == 56 or nzInnerMarket == 57 then
			nUnit =  10.0
	
		'금리선물(국채)
		elseif nzInnerMarket == 52 or nzInnerMarket == 53 then
			nUnit = 0.01
			
			'20240213 LES START
			'30년국채 호가단위 0.02
			nzName = Form.GetItemCodeInfo(g_szCd, "name")
			if Instr(nzName,"30년국채") > 0 then
				nUnit = 0.02
			end if
			'20240213 LES END
	
		'통화선물(미국달러)
		else
			nUnit = 0.10
		end if
					
		'+ 버튼
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod nUnit, 2)
			
			if nResult <> 0 and nResult <> nUnit then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		
		'- 버튼
		else
			nResult = Round(CDbl(szData) Mod nUnit, 2)

			if nResult <> 0 then
				return CDbl(szData) + (nUnit - nResult)
			else
				return szData
			end if
		end if
	'20220915 LES END
	
	
	elseif g_szMk == "O" or g_szMk == "EO" or g_szMk == "WO" or g_szMk == "EW" then	' 옵션	' 20190809_01 HWG : 위클리옵션추가 '20220311 HSZ 야간 위클리옵션 추가
		if nGbn == 0 then
			if CDbl(szData) >= 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)
				 
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				return szData
			end if
		else
			if CDbl(szData) > 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)
				
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) + (0.05 - nResult)
				else
					return szData
				end if
			else
				return szData
			end if
		end if		
	elseif g_szMk == "MO" then		' 미니옵션
		if nGbn == 0 then
			if CDbl(szData) >= 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)
				 
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			elseif CDbl(szData) < 10.00 and CDbl(szData) >= 3.00 then
				nResult = Round(CDbl(szData) Mod 0.02, 2)
				
				if nResult <> 0 and nResult <> 0.02 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				return szData
			end if
		else
			if CDbl(szData) > 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)

				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) + (0.05 - nResult)
				else
					return szData
				end if
			elseif CDbl(szData) <= 10.00 and CDbl(szData) > 3.00 then
				nResult = Round(CDbl(szData) Mod 0.02, 2)
				
				if nResult <> 0 and nResult <> 0.02 then
					return CDbl(szData) + (0.02 - nResult)
				else
					return szData
				end if
			else
				return szData
			end if
		end if
	
	'20180323 LES STATRT - 코스닥150옵션/KRX300선물 추가
	elseif g_szMk == "QO" then
		if nGbn == 0 then
			if CDbl(szData) >= 50.00 then 
				nResult = Round(CDbl(szData) Mod 0.5, 2)
				 
				if nResult <> 0 and nResult <> 0.5 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			
			else
				return szData
			end if
					
		else
			if CDbl(szData) > 50.00 then 
				nResult = Round(CDbl(szData) Mod 0.5, 2)
				
				if nResult <> 0 and nResult <> 0.5 then
					return CDbl(szData) + (0.5 - nResult)
				else
					return szData
				end if
			else
				return szData
			end if
		
		end if
	'-----------------------------------------------------------
	elseif g_szMk == "XF" then
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.2, 2)

			if nResult <> 0 and nResult <> 0.2 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
					
		else
		
			nResult = Round(CDbl(szData) Mod 0.2, 2)

			if nResult <> 0 then
				return CDbl(szData) + (0.2 - nResult)
			else
				return szData
			end if
		
		end if
		
	'20180323 LES END
	'------------------------------------------------------------
	
	' 20240412 HSZ START : 코스닥글로벌지수 추가
	elseif g_szMk == "KF" then	
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.10, 2)
				
			if nResult <> 0 and nResult <> 0.10 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.10, 2)
			
			if nResult <> 0 then					
				return CDbl(szData) + (0.10 - nResult)
			else
				return szData
			end if
		end if					
	' 20240412 HSZ END
				
	elseif g_szMk == "MF" or g_szMk == "EM" then		' 미니선물
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.02, 2)
			
			if nResult <> 0 and nResult <> 0.02 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.02, 2)
			
			if nResult <> 0 then
				return CDbl(szData) + (0.02 - nResult)
			else
				return szData
			end if
		end if
		
	elseif g_szMk == "CD" then		' 미국달러선물
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.1, 2)
			
			if nResult <> 0 and nResult <> 0.1 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.1, 2)
			
			if nResult <> 0 then
				return CDbl(szData) + (0.1 - nResult)
			else
				return szData
			end if
		end if	
	else							' 선물, 그외?
		
		'20240201_01 KBC START : 코스닥150선물 추가 (코스닥150은 g_szMk로만 구분 불가) - ReSet_Prc
		'   코스닥 150 옵션은 QO, 선물/스프레드는 F로 정의됨
		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
		
		if g_szMk == "F" and (nzInnerMarket == 43 or nzInnerMarket == 44 or nzInnerMarket == 45) then
			'코스닥 150 (선물, 스프레드, 옵션)
			if nGbn == 0 then
				nResult = Round(CDbl(szData) Mod 0.10, 2)
				
				if nResult <> 0 and nResult <> 0.10 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				nResult = Round(CDbl(szData) Mod 0.10, 2)
	
				if nResult <> 0 then
					return CDbl(szData) + (0.10 - nResult)
				else
					return szData
				end if
			end if					
		end if						
		'20240201_01 KBC END	
		
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.05, 2)

			if nResult <> 0 and nResult <> 0.05 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.05, 2)

			if nResult <> 0 then
				return CDbl(szData) + (0.05 - nResult)
			else
				return szData
			end if
		end if
	end if		
End Function
'20170420 HAMWG END
'============================================================================
' Init_Unit : 2016.03.24 분리
'============================================================================
'20170420 HAMWG START : 야간선옵 틱가격 단위 추가
Function Init_Unit(szPrc, nGbn)
	Dim szMkType 
	
	'20220915 LES START 상품선물 추가
	'금리선물/스프레드 (g_szMk:CF, nzInnerMarket = 52 / 53)
	'통화선물/스프레드 (g_szMk:CF, nzInnerMarket = 54 / 55)
	'상품선물/스프레드 (g_szMk:CF, nzInnerMarket = 56 / 57) 
	'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
	if g_szMk == "CF" or g_szMk == "FF" then
		
		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
		
		'상품선물(금)
		if nzInnerMarket == 56 or nzInnerMarket == 57  then
			return "10.0"
		
		'금리선물(국채)
		elseif nzInnerMarket == 52 or nzInnerMarket == 53 then
			
			'20240213 LES START
			'30년국채 호가단위 0.02
			nzName = Form.GetItemCodeInfo(g_szCd, "name")
			if Instr(nzName,"30년국채") > 0 then
				return "0.02"
			end if
			'20240213 LES END
			
			return "0.01"
		
		'통화선물(미국달러)
		else
			return "0.10"
		end if
	
	'20220915 LES END 
	
	
	elseif g_szMk == "O" or g_szMk == "WO" then	' 옵션	' 20190809_01 HWG : 위클리옵션추가
		if nGbn == 0 then
			if CDbl(szPrc) >= 10.00 then 
				return "0.05"
			else
				return "0.01"
			end if
		else
			if CDbl(szPrc) > 10.00 then 
				return "0.05"
			else
				return "0.01"
			end if
		end if		
	elseif g_szMk == "MO" then		' 미니옵션
		if nGbn == 0 then
			if CDbl(szPrc) >= 10.00 then 
				return "0.05"
			elseif CDbl(szPrc) < 3.00 then
				return "0.01"
			else
				return "0.02"
			end if
		else
			if CDbl(szPrc) > 10.00 then 
				return "0.05"
			elseif CDbl(szPrc) <= 3.00 then
				return "0.01"
			else
				return "0.02"
			end if
		end if
	
	'20180320 LES START - KRX300선물/코스닥150옵션 추가
	'코스닥150옵션 (50P미만 : 0.1P / 50P이상 : 0.5P)
	elseif g_szMk == "QO" then
		if nGbn == 0 then
			if CDbl(szPrc) >= 50.00 then
				return "0.5"
			else
				return "0.1"
			end if
		else
			if CDbl(szPrc) > 50.00 then
				return "0.5"
			else
				return "0.1"
			end if
		end if
		
	'KRX300선물(0.2P)
	elseif g_szMk == "XF" then
		return "0.2"
		
	'20180320 LES END - KRX300선물/코스닥150옵션 추가
	
	' 20240412 HSZ START : 코스닥글로벌지수 추가
	'코스닥글로벌(0.1P)
	elseif g_szMk == "KF" then
		return "0.1"
		
	' 20240412 HSZ END
		
	elseif g_szMk == "MF" then		' 미니선물
		return "0.02"
	else
		szMkType = ""
		szMkType = Form.getFutureMrktId(g_szCd) 'KOSPI, KOSDAQ, ETF
		
		'20220203 SWJ START : 주식선물 스프레드 호가단위 변경
		'(로직 분기 처리 방식 전반적으로 수정)
	
		szSpread = Form.GetItemCodeInfo(g_szCd, "innermarket")			
		szUnas1 = "0"
		szUnas2 = "0"
		if szSpread == "016" then 
			'최근월물 기준가
			szUnas1 = Form.GetItemCodeInfo(g_szCd, "unas_price1")		
			'차근월물 기준가
			szUnas2 = Form.GetItemCodeInfo(g_szCd, "unas_price2")		
			'기초자산 시장ID
			szMrktID = Form.GetItemCodeInfo(g_szCd, "unas_market_id")
		end if

		'최근월물 차근월물 기준가 중 낮은 가격으로 기준가 설정
		if CDbl(szUnas1) >= CDbl(szUnas2) then
			szUnas = szUnas2
		else
			szUnas = szUnas1
		end if
		
		if g_szMk == "JF" or g_szMk == "JO" then
			'=======================================================================
			'20221116 HWG START : (거래소 차세대) 호가단위 개선
			'=======================================================================
			if szMkType == "J" or szMkType == "Q" then
			
				'주식선물 스프레드
				if szSpread == "016" then
					szUnit = "5"
					if CDbl(szUnas) < 2000 then
						szUnit = "1"
					elseif (CDbl(szUnas) >= 2000 and CDbl(szUnas) < 5000) then
						szUnit = "5" 
					elseif (CDbl(szUnas) >= 5000 and CDbl(szUnas) < 20000) then
						szUnit = "10"
					elseif (CDbl(szUnas) >= 20000 and CDbl(szUnas) < 50000) then
						szUnit = "50"
					elseif (CDbl(szUnas) >= 50000 and CDbl(szUnas) < 200000) then
						szUnit = "100"
					elseif (CDbl(szUnas) >= 200000 and CDbl(szUnas) < 500000) then
						szUnit = "500"
					elseif CDbl(szUnas) > 500000 then
						szUnit = "1000"
					end if
					
					if nGbn == 1 then
						if CDbl(szUnas) = 2000 then
							szUnit = "1"
						elseif CDbl(szUnas) = 5000 then
							szUnit = "5" 
						elseif CDbl(szUnas) = 20000 then
							szUnit = "10"
						elseif CDbl(szUnas) = 50000 then
							szUnit = "50"
						elseif CDbl(szUnas) = 200000 then
							szUnit = "100"
						elseif CDbl(szUnas) = 500000 then
							szUnit = "500"
						end if
					end if
					
					return szUnit
				else
					if g_szMk == "JF" then
						szUnit = "5"
						if CDbl(szPrc) < 2000 then
							szUnit = "1"
						elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
							szUnit = "5" 
						elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
							szUnit = "10"
						elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
							szUnit = "50"
						elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
							szUnit = "100"
						elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
							szUnit = "500"
						elseif CDbl(szPrc) > 500000 then
							szUnit = "1000"
						end if
						
						if nGbn == 1 then
							if CDbl(szPrc) = 2000 then
								szUnit = "1"
							elseif CDbl(szPrc) = 5000 then
								szUnit = "5" 
							elseif CDbl(szPrc) = 20000 then
								szUnit = "10"
							elseif CDbl(szPrc) = 50000 then
								szUnit = "50"
							elseif CDbl(szPrc) = 200000 then
								szUnit = "100"
							elseif CDbl(szPrc) = 500000 then
								szUnit = "500"
							end if
						end if
						
						return szUnit
					else
						if nGbn == 0 then
						
							if CDbl(szPrc) >= 10000 then 
								return "200"
							elseif CDbl(szPrc) < 10000 and CDbl(szPrc) >= 5000 then
								return "100"
							elseif CDbl(szPrc) < 5000 and CDbl(szPrc) >= 2000 then
								return "50"
							elseif CDbl(szPrc) < 2000 and CDbl(szPrc) >= 1000 then
								return "20"							
							else
								return "10"
							end if
						else
							if CDbl(szPrc) > 10000 then 
								return "200"
							elseif CDbl(szPrc) <= 10000 and CDbl(szPrc) > 5000 then
								return "100"
							elseif CDbl(szPrc) <= 5000 and CDbl(szPrc) > 2000 then
								return "50"
							elseif CDbl(szPrc) <= 2000 and CDbl(szPrc) > 1000 then
								return "20"							
							else
								return "10"
							end if
						end if
					end if
				end if
				
		 ' 20231121 SWJ START
		  'T일 때 ETF
		   elseif szMkType == "T" then
				'주식선물일 때
				if szSpread == "015" then
					if CDbl(szPrc) < 2000 then
						return "1"
					else
						return "5"
					end if
				'주식선물 스프레드
				elseif szSpread == "016" then
					if CDbl(szUnas) < 2000 then
						return "1"
					else
						return "5"
					end if
				else
					return "5"
				end if
				
		  '20231121 SWJ END
				
		   else
			   return "5"
		   end if				
		else
		
			'20240201_01 KBC START : 코스닥150선물 추가 (코스닥150은 g_szMk로만 구분 불가) - Init_Unit
			'   코스닥 150 옵션은 QO, 선물/스프레드는 F로 정의됨
			nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
			
			if g_szMk == "F" and (nzInnerMarket == 43 or nzInnerMarket == 44 or nzInnerMarket == 45) then 
				'코스닥 150 (선물, 스프레드, 옵션)
				return "0.1"
			end if			
			'20240201_01 KBC END	
			
			' 선물, 그외?
			return "0.05"
		end if
		'20221116 HWG END

	end if
End Function
'20170420 HAMWG END 
'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, szOld, szRight
	
	g_szReceive = ""
	
	
	szPrc  = edtPrc.caption
	
	szHigh = edtHigh.caption
	szLow  = edtLow.caption
	szHyun = tblData.GetCellString(1, 0)
	szOld  = szPrc
	
	
	if Trim(szPrc) == "" then
		szPrc = CDbl(szHyun)
	else
		 ' 20160317 예외처리 추가 //////////////////////////////////////////////
		if CDbl(szPrc) >= 9900000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
		' //////////////////////////////////////////////////////////////////////	
	
		szUnit = Init_Unit(szPrc, nGbn)
		szPrc = ReSet_Prc(szPrc, nGbn)
		szPrc = Set_Unit(szPrc)

		' 20230127_01 HWG START : 틱계산 가격제한 해제
		' * 실시간 상하한가 제한 없는 종목 틱계산 오류발생 하여 해제 
		
		' + 버튼 클릭 /////////////////////////////
		if nGbn = 0 then		
'			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
'				szPrc = szHigh
'			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
'				szPrc = szLow
'			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
'			end if
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn = 1 then						
'			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
'				szPrc = szHigh		
'			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
'				szPrc = szLow
'			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
'			end if
		end if
		' 20230127_01 HWG END
	end if
	
	
	Sum_Prc(szPrc, 0)
	
	
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData, nGbn)
	'if Len(szData) < 16 then
	if Len(szData) < 8 then		' Max 7(20160317 전요셉과장)	
		if nGbn == 0 then
			szData = Set_Unit(szData)
		end if

		edtPrc.caption = szData

		
	end if
End Function	

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData)
	Dim szChk
	
	szChk = InStr(CStr(szData), ".")
	
	
	if g_szMk == "JF" or g_szMk == "JO" then 
	
	else
		if CStr(szChk) == "0" then
			return szData & ".00"
		else
			szCha = CInt(Len(szData) - szChk)
			
			if CStr(szCha) == "1" then 
				return szData & "0"
			end if
		end if
	end if
	return szData
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(szPlus)
	Dim szPrc
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = szPlus
	else
		szPrc = Trim(edtPrc.caption)
		
		' 20160318 0이 있으면 무조건 지우고 숫자 넣기 //////////////////////
		if szPrc == "0" then
			edtPrc.caption = szPlus
			Exit Function
		end if
		' //////////////////////////////////////////////////////////////////
		
		szChk = InStr(edtPrc.caption, ".")
	
		if CStr(szChk) <> "0" then	
			szCha = CInt(Len(edtPrc.caption) - szChk)
			  
			if CStr(szCha) == "2" then
				Exit Function
			end if
		else
			
		end if
		
		'edtPrc.caption = szPrc & szPlus
		szPrc = szPrc & szPlus
		Sum_Prc(szPrc, 1)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	end if
	
	szPrc = Trim(edtPrc.caption)

	' 20160328 첫번째 0은 입력처리 필요 ////////////////////////////////////
	if szPlus == "0" or szPlus == "00" or szPlus == "000" then
		if szPrc == "0" then
			Exit Function
		elseif szPrc == "" then
			edtPrc.caption = "0"
			Exit Function
		end if
	end if
	' /////////////////////////////////////////////////////////////////////
	
	' "."이 있는지 체크
	szChk = InStr(edtPrc.caption, ".")

	if CStr(szChk) <> "0" then
		if Trim(szPlus) == "." then
			Exit Function
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			  
			if CStr(szCha) == "2" then
				Exit Function
			elseif CStr(szCha) == "1" then
				if Len(szPlus) == 1 then
					'edtPrc.caption = edtPrc.caption & szPlus
					szPrc = edtPrc.caption & szPlus
					Sum_Prc(szPrc, 1)
				end if
				
				Exit Function
			end if
		end if
	end if
	
	if Len(edtPrc.caption) > 0 then
		'edtPrc.caption = edtPrc.caption & szPlus
		szPrc = edtPrc.caption & szPlus
		Sum_Prc(szPrc, 1)
	end if
End Function

