'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtPrc.caption)
	
	if nLen <> 0 then
		szPrc = Left(edtPrc.caption, nLen-1)
		
		edtPrc.caption = szPrc
		
		
	end if
	
	g_szReceive = ""	
End Sub

'============================================================================
' btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
	
		edtPrc.caption = ""

End Sub

'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
'	if Trim(edtPrc.caption) <> "" then

	Form.SendReturnToParent("PRC_POPUP", edtPrc.caption)

'	end if
	
	Form.CloseForm()
End Sub

'============================================================================
' tblData_OnClick
'============================================================================
Sub tblData_OnClick(lRow , lColumn)
	Dim szPrc
	
	if CStr(lRow) == "1" then
		g_szReceive = "1"
		szPrc = Trim(tblData.GetCellString(1, lColumn))
		
		if szPrc <> "" then
			szPrc = Set_Unit(CDbl(szPrc))
		end if
		
		edtPrc.caption = szPrc
	end if
End Sub

