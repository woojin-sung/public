'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()

	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
		
		g_szReceive = "1"
		edtPrc.caption = tData(0)
		g_szCd   = tData(1)
		g_szMk   = tData(2)
		g_szType = tData(3)
		edtHigh.caption = tData(4)
		edtLow.caption  = tData(5)
		
		if g_szMk == "JF" or g_szMk == "JO" then 
			btnPlus001.visible = true
			edtPrc.mask = "0,0,, 원,0,,0,1,1"
			edtPrc.hintcaption = " 원" 
			DATAMANAGER.RequestTranData("ohhts_3070_003r")	
		
		else '선물옵션
			btnPlus001.visible = false
			
			'20180321 LES START
			'안드로이드에서 소수점 가격입력 시, 정상적으로 소수점이 입력되지 않아
			'임시로 ios만 마스킹처리(안드로이드는 컨트롤 마스킹 설정대로 처리)
			szOstype = Form.GetSharedData("&OS_TYPE", false )  'iOS("2") Android("1") 기타("9")
			
			if szOstype = "2" then
				edtPrc.mask = "0,0,, P,0,,2,1,1"
			end if
			
			'ORGN
			'edtPrc.mask = "0,0,, P,0,,2,1,1"
			'20180321 LES END
			
			edtPrc.hintcaption = " P" 
			DATAMANAGER.RequestTranData("ohhts_3050_004r")	
			
'			Request_Data()
		end if
		
		
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_futs_aspr")
	DATAMANAGER.CancelRealData("ohhts_optn_aspr")
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")	
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")	
	'20170421 HAMWG START : 야간선옵 실시간 서비스 추가
	DATAMANAGER.CancelRealData("ohhts_efut_aspr")
	DATAMANAGER.CancelRealData("ohhts_eopt_aspr")
'	DATAMANAGER.CancelRealData("ohhts_cmef_aspr")	'20210223 HSZ 야간선물 제도개편
'	DATAMANAGER.CancelRealData("ohhts_cusf_aspr") '20210712 HSZ 야간 미국달러선물 제도개편
	
	DATAMANAGER.CancelRealData("ohhts_efut_cntg")	
	DATAMANAGER.CancelRealData("ohhts_eopt_cntg")	
'	DATAMANAGER.CancelRealData("ohhts_cmef_cntg")	'20210223 HSZ 야간선물 제도개편
'	DATAMANAGER.CancelRealData("ohhts_cusf_cntg")	'20210712 HSZ 야간 미국달러선물 제도개편
	'20170421 HAMWG END 
	
	DATAMANAGER.CancelRealData("ohhts_sfut_aspr")
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_sopt_aspr")
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")
	
	'20220915 LES START 상품선물 추가
	DATAMANAGER.CancelRealData("ohhts_cfut_aspr")
	DATAMANAGER.CancelRealData("ohhts_cfut_cntg")
	'20220915 LES END
	
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_3050_004r" then
		DATAMANAGER.ClearInputData(0, "ohhts_3050_004r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	
	elseif szTranID = "ohhts_3070_003r" then '주식선물
		DATAMANAGER.SetDataValue(0, "ohhts_3070_003r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3070_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
	'20170421 HAMWG START : 야간선옵 주문 대응
    if szTranID = "ohhts_3050_004r" then
	     if g_szMk = "EO" or g_szMk = "EW" then '20220307 HSZ 야간 위클리옵션 신규상장(EW 추가)
		     DATAMANAGER.RequestRealData("ohhts_eopt_cntg")
			DATAMANAGER.RequestRealData("ohhts_eopt_aspr")
	     elseif g_szMk = "EM" or  g_szMk = "CD" then '20210712 HSZ 야간 미국달러선물 제도개편(CD 추가)
		     DATAMANAGER.RequestRealData("ohhts_efut_cntg")
			DATAMANAGER.RequestRealData("ohhts_efut_aspr")
		'20210223 HSZ 야간선물 제도개편
	     elseif g_szMk = "CM" then
'		     DATAMANAGER.RequestRealData("ohhts_cmef_cntg")
		     DATAMANAGER.RequestRealData("ohhts_efut_cntg")
'			DATAMANAGER.RequestRealData("ohhts_cmef_aspr")
			DATAMANAGER.RequestRealData("ohhts_efut_aspr")
		'20210223 HSZ END
		
		'20180320 LES START - KRX300선물/코스닥150옵션 추가
		elseif g_szMk = "O" or g_szMk = "MO" or g_szMk ="QO" or g_szMk ="WO" then	' 20190809_01 HWG : 위클리옵션추가
			DATAMANAGER.RequestRealData("ohhts_optn_cntg")
			DATAMANAGER.RequestRealData("ohhts_optn_aspr")
			DATAMANAGER.RequestRealData("ohhts_pric_extd")
		
		'20220915 LES START 상품선물 추가
		'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
		elseif g_szMk == "CF" or g_szMk == "FF" then
		
			DATAMANAGER.RequestRealData("ohhts_cfut_cntg")
			DATAMANAGER.RequestRealData("ohhts_cfut_aspr")
		
		'20220915 LES END
		
		else
			DATAMANAGER.RequestRealData("ohhts_futs_cntg")
			DATAMANAGER.RequestRealData("ohhts_futs_aspr")
			DATAMANAGER.RequestRealData("ohhts_pric_extd")
		end if
	'20170421 HAMWG END
	
	elseif szTranID = "ohhts_3070_003r" then
		
		 if g_szMk = "JF" then
			DATAMANAGER.RequestRealData("ohhts_sfut_aspr")
			DATAMANAGER.RequestRealData("ohhts_sfut_cntg")
		 elseif g_szMk = "JO" then
			DATAMANAGER.RequestRealData("ohhts_sopt_aspr")
			DATAMANAGER.RequestRealData("ohhts_sopt_cntg")
		 end if
		 
		 
	end if
	
	
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 선물체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_futs_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 선물호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_futs_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_futs_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 옵션체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_optn_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 옵션호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_optn_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_optn_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	'20170421 HAMWG START : 야간선옵 실시간 서비스 대응
	' ----------------------------------------------------------------------
	' CME 선물체결 자동갱신
'	' ----------------------------------------------------------------------	
'20210223 HSZ START 야간선물 제도개편
'	elseif szTranID == "ohhts_cmef_cntg" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' CME 선물호가 자동갱신
'	' ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_cmef_aspr" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cmef_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
'20210223 HSZ END
	' ----------------------------------------------------------------------
	' CME 미국달러체결 자동갱신
	' ----------------------------------------------------------------------	
	'20210712 HSZ 야간 미국달러선물 제도개편
'	elseif szTranID == "ohhts_cusf_cntg" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cusf_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' CME 미국달러호가 자동갱신
	' ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_cusf_aspr" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cusf_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	'20210712 HSZ END 
	' ----------------------------------------------------------------------
	' EUREX 미니선물체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_efut_cntg" then
