	<SCRIPT_INFO _len="818" _ulen="774" >
'============================================================================
' 2017.10.27 -  LSS
' 연합인포맥스 관심편집 화면
'
'============================================================================
Sub Form_OnFormInitBefore()
	Form.SetScreenName( "해외주식 관심종목편집" )
	
	Dim sOpenData
	sOpenData = Form.GetOpenLinkData( )
	
	if sOpenData <> "" and sOpenData <> nil then
		rdoChange.currentindex = sOpenData
		fmTab.currenttab = sOpenData
	end if
End Sub

'============================================================================
Sub rdoChange_OnClick(nIndex)
	fmTab.currenttab = nIndex
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "INTR_EDIT_COMPLETE" , "1" )
End Sub

	</SCRIPT_INFO>
</ROOT>