'	
'		LabelData2.fontsize = sTextSize
'	
'	elseif sCtlName == "LabelData3" then
'	
'		LabelData3.fontsize = sTextSize
'		
'	
'	elseif sCtlName == "LabelData4" then
'	
'		LabelData4.fontsize = sTextSize
'		
'	
'	elseif sCtlName == "LabelData5" then
'		
'		LabelData5.fontsize = sTextSize
'		
'	elseif sCtlName == "LabelData6" then
'		
'		LabelData6.fontsize = sTextSize
'		
'	end if

End Function
'============================================================================
Function ChangeLabelPos(sOrgnCtlName,sTargetCtlName)
	
	nOrgnTop = Form.GetCtlProp(sOrgnCtlName, "top")
	nOrgnHeight = Form.GetCtlProp(sOrgnCtlName, "height")
	
	if gOsType == "1" then
		nTargetTop = Form.calcUnResize(nOrgnTop + nOrgnHeight, "1") + 10
	else
		nTargetTop = nOrgnTop + nOrgnHeight + 10
	end if
	
	Form.SetCtlProp(sTargetCtlName, "top", nTargetTop)

End Function

'============================================================================
Sub LabelData0_OnSizeAutoFit()

	ChangeLabelPos("LabelData0","LabelData1")
	
End Sub

'============================================================================
Sub LabelData1_OnSizeAutoFit()

	ChangeLabelPos("LabelData1","LabelData2")
	
End Sub

'============================================================================
Sub LabelData2_OnSizeAutoFit()

	ChangeLabelPos("LabelData2","LabelData3")
	
End Sub

'============================================================================
Sub LabelData3_OnSizeAutoFit()

	ChangeLabelPos("LabelData3","LabelData4")
	
End Sub

'============================================================================
Sub LabelData4_OnSizeAutoFit()

	'테이블 높이값 조정
	nOrgnTop = Form.GetCtlProp("LabelData4", "top")
	nOrgnHeight = Form.GetCtlProp("LabelData4", "height")
	
	if gOsType == "1" then
		nTargetHeight = Form.calcUnResize(nOrgnTop + nOrgnHeight, "1") + 10
	else
		nTargetHeight = nOrgnTop + nOrgnHeight + 10
	end if
	
	Table0.height = nTargetHeight
	
	'테이블 타이틀라벨 Top값 지정
	nTableTitleTop = nTargetHeight / 2 - 50
	LabelData5.top = nTableTitleTop
	
	'부모화면에 자기사이즈 알리기
	Form.triggerEvent("#", "HONGKONG_LinkForm3_Height", nTargetHeight + 20)
	
	
End Sub
