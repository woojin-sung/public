--===========================================================================
--===========================================================================

'============================================================================
Dim g_sUI_1_COND_VAL, g_sUI_2_COND_VAL, g_sUI_3_COND_VAL, g_sUI_4_COND_VAL, g_sUI_5_COND_VAL
Dim g_sWA_PRNM, g_sEMPNO
Dim g_szBIZDATE 
Dim g_szAcnt, g_szAsno, g_szPopupAcnt, g_szPopupAsno 
Dim g_szRsevYn
Dim total_sbsc_qty
Dim g_Evnt_Name
'============================================================================
Sub Form_OnFormInit()
	g_szBIZDATE = Form.GetSharedData("&HOST_DATE", 0)
	g_RghtType = cmb1.cbkeydata
	Grid0.setUseCardView(true, 15, "btn_12_n.9")
	f_SendRequestData()
	
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
End Sub

'============================================================================
Function f_SendRequestData()
	grid0.rowcount = 0
	DATAMANAGER.RequestTranData("obrgt_stsb_205r")
end function

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'DATAMANAGER.ClearInputData(0, szTranID)
	'유상청약가능종목 조회 TR 입력값 세팅
	if szTranID == "obrgt_stsb_205r" then
		DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "RGHT_TYPE_CODE" , 0 , g_RghtType)
		DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "IQRY_CLS_CODE" , 0 , "A")
		DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "ACNO" , 0 , g_szAcnt)
		DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "ASNO" , 0 , g_szAsno)
		DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "RSEV_YN" , 0 , "N")
		if g_Evnt_Name = "청약" then
			DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "JOB_CLS_CODE" , 0 , "1")
		elseif g_Evnt_Name = "취소" then
			DATAMANAGER.SetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "JOB_CLS_CODE" , 0 , "A")
		end if 
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szAbleMoney		'출금가능액
	
	if szTranID == "obrgt_stsb_205r" then
		g_szPopupAcnt = DATAMANAGER.GetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "ACNO" , 0 )
		g_szPopupAsno = DATAMANAGER.GetDataValue( 0, "obrgt_stsb_205r", "InBlock1", "ASNO" , 0 )
		
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obrgt_stsb_205r", "OutBlock1")
		if nCnt == 0 then
			imgNotice.left = 160
			lbNoticeMsg.left = 0
			g_nIndex = 0
			Exit Sub
		else
			imgNotice.left = 560
			lbNoticeMsg.left = 500
		end if 		
		
		szAbleMoney = DATAMANAGER.GetDataValue( 0 , "obrgt_stsb_205r", "OutBlock2", "DRNG_ABLE_AMT" , 0)
		for i = 0 to DATAMANAGER.GetDataCount( 0, "obrgt_stsb_205r", "OutBlock1") - 1
			total_sbsc_qty =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "TOTAL_SBSC_QTY", i)
			sbsc_sta_date =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "SBSC_STA_DATE", i)
			rght_type_code =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "RGHT_TYPE_CODE", i)			
			
			total_asgm_qty =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "TOTAL_ASGM_QTY", i)
			total_asgm_amt =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "TOTAL_ASGM_AMT", i)
			sbsc_unpr      =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "SBSC_UNPR", i)
			total_sbsc_amt =  DATAMANAGER.GetDataValue(0, "obrgt_stsb_205r", "OutBlock1", "TOTAL_SBSC_AMT", i)
			
			grd1.SetCellData( "bd_cell2", i, szAbleMoney)
			
			Grid0.SetCellData("bd_cell14", i, "총 청약가능수량")
			Grid0.SetCellFgColor("bd_cell54", i, "3")
			Grid0.SetCellFgColor("bd_cell43", i, "3")
			Grid0.SetCellFgColor("bd_cell35", i, "3")
			Grid0.SetCellData("bd_cell15", i, "청약단가")
			Grid0.SetCellData("bd_cell16", i, "총 청약금액")
			Grid0.SetCellImage("bd_cell19", i, "img_bgbox.9.png")

			if g_Evnt_Name = "청약" then
				Grid0.SetCellData("bd_cell19", i, "청약신청")
				
				Grid0.SetCellData("bd_cell14", i, "총 청약가능수량") 
				Grid0.SetCellData("bd_cell54", i, total_asgm_qty)
				
				Grid0.SetCellData("bd_cell15", i, "청약단가")
				Grid0.SetCellData("bd_cell43", i, sbsc_unpr)
				
				Grid0.SetCellData("bd_cell16", i, "총 청약가능금액")
				Grid0.SetCellData("bd_cell35", i, total_asgm_amt)
				if int(total_sbsc_qty) > 0 then
					Grid0.SetCellImage("bd_cell19", i, "")
					Grid0.SetCellEnable("bd_cell19", i, false)
					Grid0.SetCellData("bd_cell19", i, "")
				end if 
			elseif g_Evnt_Name = "취소" then
				Grid0.SetCellData("bd_cell19", i, "취소하기")
				
				Grid0.SetCellData("bd_cell14", i, "총 청약수량") 
				Grid0.SetCellData("bd_cell54", i, total_sbsc_qty)
				
				Grid0.SetCellData("bd_cell15", i, "총 청약금액")
				Grid0.SetCellData("bd_cell43", i, total_sbsc_amt)
				
				Grid0.SetCellData("bd_cell16", i, "")
				Grid0.SetCellData("bd_cell35", i, "")
				
			end if 
			
			if sbsc_sta_date > g_szBIZDATE then
				if int(total_sbsc_qty) > 0 then
					Grid0.SetCellData("bd_cell48", i, "예약청약완료")
					Grid0.SetCellImage("bd_cell48", i, "btn_blue_bg_02.9.png")
					Grid0.SetCellFgColor("bd_cell48", i, "16")
					if g_Evnt_Name = "취소" then
						Grid0.SetCellImage("bd_cell19", i, "btn_01_n.9.png")
						Grid0.SetCellFgColor("bd_cell19", i, "16")
					end if
				else
					Grid0.SetCellData("bd_cell48", i, "예약청약")
					Grid0.SetCellImage("bd_cell19", i, "btn_01_n.9.png")
					Grid0.SetCellFgColor("bd_cell19", i, "16")
					Grid0.SetCellFgColor("bd_cell48", i, "16")
				end if 
				if g_Evnt_Name = "청약" then
					grd1.SetCellData("bd_cell17", i, "Y") '예약청약
				elseif g_Evnt_Name = "취소" then
					grd1.SetCellData("bd_cell17", i, "A") '예약청약취소
				end if
			else
				if int(total_sbsc_qty) > 0 then
					Grid0.SetCellData("bd_cell48", i, "청약완료")
					Grid0.SetCellImage("bd_cell48", i, "btn_blue_bg_02.9.png")
					Grid0.SetCellFgColor("bd_cell48", i, "16")
					if g_Evnt_Name = "취소" then
						Grid0.SetCellImage("bd_cell19", i, "btn_01_n.9.png")
						Grid0.SetCellFgColor("bd_cell19", i, "16")
					end if
				else
					Grid0.SetCellData("bd_cell48", i, "청약")
					Grid0.SetCellImage("bd_cell19", i, "btn_01_n.9.png")
					'Grid0.SetCellBgColor("bd_cell19", i, "289")
					Grid0.SetCellFgColor("bd_cell19", i, "16")
					Grid0.SetCellFgColor("bd_cell48", i, "16")
				end if
				if g_Evnt_Name = "청약" then
					grd1.SetCellData("bd_cell17", i, "N") '일반청약
				elseif g_Evnt_Name = "취소" then
					grd1.SetCellData("bd_cell17", i, "X") '청약취소
				end if
			end if 
		next
	end if

End Sub
