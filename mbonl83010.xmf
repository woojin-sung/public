		g_szData = g_szPopupAcnt & "★" & g_szPopupAsno & "★" & tmp_RghtType & "★" & grd1.GetCellData( "bd_cell0", lRow) & "★" &
		grd1.GetCellData( "bd_cell1", lRow) & "★" & grd1.GetCellData( "bd_cell2", lRow) & "★" & grd1.GetCellData( "bd_cell3", lRow) & "★" &
		grd1.GetCellData( "bd_cell4", lRow) & "★" & grd1.GetCellData( "bd_cell5", lRow) & "★" & grd1.GetCellData( "bd_cell6", lRow) & "★" &
		grd1.GetCellData( "bd_cell7", lRow) & "★" & grd1.GetCellData( "bd_cell8", lRow) & "★" & grd1.GetCellData( "bd_cell9", lRow) & "★" &
		grd1.GetCellData( "bd_cell10", lRow) & "★" & grd1.GetCellData( "bd_cell11", lRow) & "★" & grd1.GetCellData( "bd_cell12", lRow) & "★" &
		grd1.GetCellData( "bd_cell16", lRow) & "★" & grd1.GetCellData("bd_cell17", lRow)  & "★" &
		grd1.GetCellData( "bd_cell18", lRow) & "★" & grd1.GetCellData( "bd_cell19", lRow) & "★" & grd1.GetCellData( "bd_cell20", lRow) & "★" & 
		grd1.GetCellData( "bd_cell21", lRow)
