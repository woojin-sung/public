'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "GOTOLOGIN" Then
		if sRet == "ok" then
			Form.CloseForm()
			'if g_szData <> "1" Then
				Form.OpenScreen("90020" , "")
			'end if
		end if
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'청약취소
			Call SubCancel()
		end if
	end if
	
End Sub


'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Dim szList
	
	if sEventName == "청약신청" then
		szList = Split(sParam , "★")
		
		if UBOUND(szList) < 1 then
			Exit Sub
		End if
		g_szAcnt = szList(0)				'계좌번호
		g_szAsno = szList(1)				'구분코드
		g_Evnt_Name = "청약"
		DATAMANAGER.RequestTranData("obrgt_stsb_205r")		'조회
	elseif sEventName == "청약취소/내역" then
		szList = Split(sParam , "★")
		
		if UBOUND(szList) < 1 then
			Exit Sub
		End if
		g_szAcnt = szList(0)				'계좌번호
		g_szAsno = szList(1)				'구분코드
		g_Evnt_Name = "취소"
		DATAMANAGER.RequestTranData("obrgt_stsb_205r")		'조회		
	end if
	
	

	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obrgt_stsb_205r" then
		Grid0.SetClear()
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obrgt_stsb_205r" )
		Form.ShowAlert("알림", szErrMsg.."("..szSubErr..")" )
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgNotice.setMaintainingRatio("1")		
End Sub

