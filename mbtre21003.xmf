	<SCRIPT_INFO _len="5835" _ulen="5589" >
'============================================================================
' 01. 화 면 명 : CFD 리콜내역 및 처리내역 조회
' 02. 화면설명 : CFD 리콜내역 및 처리내역 조회
' 03. 작    성 : 2021. 07. 26. KSJ
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD 리콜내역" )

	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )
End Sub
'============================================================================
' cldFrom_OnEditComplete()
'============================================================================
Sub cldFrom_OnEditComplete()
	If cldFrom.caption > cldTo.caption then
		Form.ShowAlert( "알림", "조회날짜를 확인하여 주십시오.")
		cldFrom.caption = cldTo.caption
		Exit Sub
	End If
	
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )
End Sub
'============================================================================
' cldTo_OnEditComplete()
'============================================================================
Sub cldTo_OnEditComplete()
	If cldFrom.caption > cldTo.caption then
		Form.ShowAlert( "알림", "조회날짜를 확인하여 주십시오.")
		cldTo.caption = cldFrom.caption
		Exit Sub
	End If
	
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )
End Sub
'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_recl_003r") == True Then
		DATAMANAGER.RequestNextData("obtre_recl_003r")
	End If
End Sub

'============================================================================
' cmbGubun_OnEditComplete()
'============================================================================
Sub cmbGubun_OnEditComplete(iIndex)
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )
End Sub
'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )
End Sub
'============================================================================
' btnRefresh_OnClick()
'============================================================================
Sub btnRefresh_OnClick()
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obtre_recl_003r" )	
End Sub

'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtre_recl_003r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_STA_DATE" , 0 , cldFrom.caption)					'조회시작일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_FIN_DATE" , 0 , cldTo.caption)					'조회종료일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")									'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_RGHT_TPCD" , 0 , cmbGubun.cbkeydata)				'CFD 권리유형코드
	End If
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtre_recl_003r" Then
		If tonumber(grd0.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = grd0.rowcount - nDataCnt
			
			For i = 0 to nDataCnt - 1
				dim nRCL_RQST_OQTY, nRDMP_OQTY, nDiff '리콜요청수량, 상환수량, 잔존리콜요청수량
				
				nRCL_RQST_OQTY = CDbl(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RCL_RQST_OQTY", i ))
				nRDMP_OQTY = CDbl(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RDMP_OQTY", i ))
				
				nDiff = nRCL_RQST_OQTY - nRDMP_OQTY
				
				grd0.SetCellData("bd_cell0", nRowCnt+i, nRowCnt+i+1 )
				grd0.SetCellData("bd_cell7", nRowCnt+i, nDiff )
			Next
		End If
	End If
End Sub



	</SCRIPT_INFO>
