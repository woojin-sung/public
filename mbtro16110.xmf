'============================================================================
' 화 면 명 : 해외주식양도소득신고대행
' 화면설명 : MTS 해외주식양도소득신고대행
'============================================================================
'v001 20240220: 장시방 : 신고대행 신청기간 수정

Dim g_bMore
Dim g_nAddrRow

'obacs_ovrs_002a InBlock2 주소관련 변수
Dim g_szAddrSurfType		'주소검색 종류(양도소득세인지 납부고지서인지)

'양도소득세 신고지 주소
Dim g_szLctnZip			'지역우편번호
Dim g_szLctnZipDtl		'상세우편번호
Dim g_szLctnZipSrno		'우편일련번호
Dim g_szLctnAddr			'우편주소
Dim g_szLctnAddrDtl		'우편상세주소
Dim g_szLctnAddrNewYn		'신주소사용여부
Dim g_szLctnBldnMnno		'건물관리번호

'납부고지서 수령지 주소
Dim g_szZip			'지역우편번호
Dim g_szZipDtl		'상세우편번호
Dim g_szZipSrno		'우편일련번호
Dim g_szAddr			'우편주소
Dim g_szAddrDtl		'우편상세주소
Dim g_szAddrNewYn		'신주소사용여부
Dim g_szBldnMnno		'건물관리번호

'신고대행수수료 금액
Dim g_szVcexFeeAmt

Dim g_szEmail

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgToolTip.setMaintainingRatio("2")
	contMain.imgMore.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'비밀번호 투명 버튼을 레이아웃 맨 위로
	btnPwd.bringFront("1")
	
	contMain.contAddr.lblGuide.bringFront("1")
	contMain.contPayMethod.lblGuide.bringFront("1")
	
	'툴팁 아이콘 OS별로 위치 조정
	Dim szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	If szOSType == "1" Then
		contMain.imgToolTip.left = 238
	Else
		contMain.imgToolTip.left = 245
	End If
	
	'신고년도 세팅
	Dim szYear 
	szYear = Left(Form.GetSharedData("&HOST_DATE", false), 4)
	tblYear.SetCellString(0, 1, CInt(szYear) - 1)
	
	f_SetClear("All")
	
	'신청가능 날짜 체크
	Dim szDate
	szDate = Form.GetSharedData("&HOST_DATE", false)
'	'2023년도 신청가능 날짜 : 2023.03.20 ~ 2023.04.14
'	'v001 MTS 2024년도 신청가능 날짜 : 2024.03.18 ~ 2024.04.12
'	'해마다 달라서 그때그때 직접 수정해야함
	If CLng(szDate) < 20240318 Or CLng(szDate) > 20240412 Then
		Form.MsgBox("안내", "신청 가능 기간이 아닙니다.", "PERIOD_ERROR", 6)
	End If
	
	'테스터 요청 날짜 체크
'	If CLng(szDate) == 20230222 Then
'		Form.MsgBox("안내", "신청 가능기간이 아닙니다.", "PERIOD_ERROR", 6)
'		Exit Sub
'	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항
	If sEventName == "INFO_CLICK" Then
		Form.OpenFramePopup("mbtro16110_p5" , "1" , "")
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "CORRECT_PWD" Then
		If nil ~= sRet And "" ~= sRet Then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			
			if UBOUND(tPwd) > 0 then
				edtPwd.pwdlen = tPwd(1)
				edtPwd.caption = tPwd(0)
				
				'해외주식 양도소득신고대행 신청정보조회
				DATAMANAGER.RequestTranData( "obacs_ovrs_002r" )
			End If
		End If
	
	'주소검색 팝업 리턴
	ElseIf sKeyName == "mbbdm85150_p1" And sRet == "ok" Then	
		contMain.contAddr.chkLoadAddr.chksilence = "0"
		contMain.contPayMethod.chkLoadAddr.chksilence = "0"
		
		Dim szTmpRegnZip, szTmpDtlZip, szTmpPost, szTmpDtl, szTmpBldnMnno, szNewYn
		szNewYn 			= Form.GetSharedData("10050_ADDRESS_YN", False )
		szTmpRegnZip		= Form.GetSharedData("10050_ADDRESS_REGN_ZIP", False )
		szTmpDtlZip		= Form.GetSharedData("10050_ADDRESS_DTL_ZIP" , False )
		szTmpPost		= Form.GetSharedData("10050_ADDRESS_POST"    , False )
		szTmpDtl			= Form.GetSharedData("10050_ADDRESS_DTAD"    , False )
		szTmpBldnMnno		= Form.GetSharedData("10050_ADDRESS_BLDN"    , False )
		
		'양도소득세 신고지인지 납부고지서 수령지인지 구분하여 데이터 저장
		If g_szAddrSurfType == "1" Then
			g_szLctnZip = szTmpRegnZip
			g_szLctnZipDtl = szTmpDtlZip
			g_szLctnZipSrno = ""				'우편일련번호를 mbbdm85150_p1 에서 가져올 수 있는지 확인해야함
			g_szLctnAddr = szTmpPost
			g_szLctnAddrDtl = szTmpDtl
			g_szLctnAddrNewYn = szNewYn
			g_szLctnBldnMnno = szTmpBldnMnno
			
			contMain.contAddr.lblAddr.visible = true
			contMain.contAddr.lblAddrDtl.visible = true
'			contMain.contAddr.lblGuide.visible = false
			contMain.contAddr.lblGuide.caption = ""
			
			contMain.contAddr.lblAddr.caption = g_szLctnAddr
			contMain.contAddr.lblAddrDtl.caption = g_szLctnAddrDtl
		Else
			g_szZip = szTmpRegnZip
			g_szZipDtl = szTmpDtlZip
			g_szZipSrno = ""					'우편일련번호를 mbbdm85150_p1 에서 가져올 수 있는지 확인해야함
			g_szAddr = szTmpPost
			g_szAddrDtl = szTmpDtl
			g_szAddrNewYn = szNewYn
			g_szBldnMnno = szTmpBldnMnno
			
			contMain.contPayMethod.lblAddr.visible = true
			contMain.contPayMethod.lblAddrDtl.visible = true
'			contMain.contPayMethod.lblGuide.visible = false
			contMain.contPayMethod.lblGuide.caption = ""
			
			contMain.contPayMethod.lblAddr.caption = g_szAddr
			contMain.contPayMethod.lblAddrDtl.caption = g_szAddrDtl
		End If
		
		f_ShowPayCont()
		f_EnableRegBtn()
		
		g_szAddrSurfType = ""
	
	'연락처변경 팝업 리턴
	ElseIf sKeyName == "mbonl81000" And sRet == "ok" Then
		'등록된 이메일 조회
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	
	'약관동의 팝업 리턴
	ElseIf sKeyName == "mbtro16110_p2" And sRet == "ok" Then
		'해외주식신용정보동의내역 관리
		DATAMANAGER.RequestTranData( "obcsb_acif_554a" )
	
	'완료팝업 리턴
	ElseIf sKeyName == "mbtro16110_p1" Then
		'초기화 후 재조회
		f_SetClear()
		
		'해외주식 양도소득신고대행 신청정보조회
		DATAMANAGER.RequestTranData( "obacs_ovrs_002r" )
		
		'전체메뉴 오픈
		Form.OpenMainMenuWithIndex(0, 1, 0)
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'신청대상, 신청기간 등이 아닐때 시장종합 화면으로 돌려보냄
	If sKeyName == "MOVE_HOME" Then
'		Form.OpenScreen("41000", "")
		
		'전체메뉴 오픈
		Form.OpenMainMenuWithIndex(0, 1, 0)
	
	'취소확인 메시지박스
	ElseIf sKeyName == "CANCEL_CONFIRM" And sRet == "ok" Then
		'해외주식 양도소득신고대행 신청관리
		DATAMANAGER.RequestTranData( "obacs_ovrs_002a" )
		
	'신청 취소 완료 메시지박스
	ElseIf sKeyName == "CANCEL_COMPLETE" Then
		'초기화 후 재조회
		f_SetClear()
		
		'해외주식 양도소득신고대행 신청정보조회
		DATAMANAGER.RequestTranData( "obacs_ovrs_002r" )
		
		'전체메뉴 오픈
		Form.OpenMainMenuWithIndex(0, 1, 0)
	
	'신청가능기간 오류 메시지박스 
	ElseIf sKeyName == "PERIOD_ERROR" Then
'		'홈화면으로 돌려보냄
'		Form.OpenScreen("41000", "")

		'전체메뉴 오픈
		Form.OpenMainMenuWithIndex(0, 1, 0)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'해외주식 양도소득신고대행 신청정보조회
	If szTranID == "obacs_ovrs_002r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , edtPwd.caption )
		Dim szStndYear
		szStndYear = tblYear.GetCellString(0, 1)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STND_YEAR" , 0 ,  szStndYear)
	
	'등록된 이메일 조회
	ElseIf szTranID == "obcsb_acif_140r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
	
	'해외주식 양도소득신고대행 신청관리
	ElseIf szTranID == "obacs_ovrs_002a" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )		' "4": 온라인
		If Trim(btnReg.caption) == "취소하기" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "2" )	' "2": 신청취소
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1" )	' "1": 신청
		End If
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , edtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STND_YEAR" , 0 , tblYear.GetCellString(0, 1))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FEE_VCEX_CLCD" , 0 , "1" )		'"1": 당사합산
		
		'신청일련번호
		If Trim(btnReg.caption) == "취소하기" Then
			Dim szApltSrno
			szApltSrno = DATAMANAGER.GetDataValue(0 , "obacs_ovrs_002r" , "OutBlock4" , "APLT_SRNO" , 0)
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "APLT_SRNO" , 0 , szApltSrno )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "APLT_SRNO" , 0 , "" )
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "CRIN_OFER_AGRM_YN" , 0 , "Y" )	'신용정보제공동의여부
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "SELN_AMT_SMTN" , 0 , contMain.tblData.GetCellString(1, 1) )		'매도금액합계
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "BYOV_AMT_SMTN" , 0 , contMain.tblData.GetCellString(2, 1) )		'매수금액합계
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "NCSR_AMT" , 0 , contMain.tblData.GetCellString(3, 1) )			'필요금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "BASC_DDCT_AMT" , 0 , contMain.tblData.GetCellString(4, 1) )		'기본공제금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "TXTN_STND_AMT_SMTN" , 0 , contMain.tblData.GetCellString(5, 1) )	'과제표준금액합계
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "ANTC_CALC_AMT" , 0 , contMain.lblTotal.caption )				'예상계산금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "TRNF_INCM_AMT" , 0 , contMain.tblData.GetCellString(0, 1) )		'양도소득금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "OTCO_TRNF_INCM_AMT" , 0 , "" )								'타사양도소득금액
		
		'양도소득세 신고지 주소 
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_REGN_ZIP" , 0 , g_szLctnZip )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_DTL_ZIP" , 0 , g_szLctnZipDtl )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_PSSR_SRNO" , 0 , g_szLctnZipSrno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_POST" , 0 , g_szLctnAddr )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_DTAD" , 0 , g_szLctnAddrDtl )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_NW_ADDR_USE_YN" , 0 , g_szLctnAddrNewYn )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LCTN_BLDN_MNNO" , 0 , g_szLctnBldnMnno )
		
		'납부수령구분코드
		If contMain.contPayMethod.rdoProvision.currentindex == "1" Then	'등기우편
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PAYM_RECV_CLCD" , 0 , "1" )	
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "EMAIL_ADDR" , 0 , "" )			'등기우편 일땐 비워서 보냄
		Else														'이메일
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PAYM_RECV_CLCD" , 0 , "2" )	
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "EMAIL_ADDR" , 0 , g_szEmail )	'이메일 주소
		End If
		
		'납부고지서 수령지 주소(이메일 선택시에는 아래 변수들 전부 빈칸이라 상관 없을듯)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "REGN_ZIP" , 0 , g_szZip )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "DTL_ZIP" , 0 , g_szZipDtl )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PSSR_SRNO" , 0 , g_szZipSrno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "POST" , 0 , g_szAddr )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "DTAD" , 0 , g_szAddrDtl )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "NW_ADDR_USE_YN" , 0 , g_szAddrNewYn )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "BLDN_MNNO" , 0 , g_szBldnMnno )
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "LEVY_YN" , 0 , "N" )		'대행세무서구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "VCEX_TXOF_CLCD" , 0 , "1" )		'대행세무서구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "DCLR_VCEX_FEE_AMT" , 0 , g_szVcexFeeAmt )	'신고대행수수료금액
	
	'해외주식신용정보동의내역 관리
	ElseIf szTranID == "obcsb_acif_554a" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )	' "4": 온라인
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_KIND_CLCD" , 0 , "1" )	' "1": 양도소득신고대행
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , edtPwd.caption )
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "CRIN_UTLZ_AGRM_YN" , 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "CRIN_OFER_AGRM_YN" , 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "CRIN_CNJG_AGRM_YN" , 0 , "Y" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'해외주식 양도소득신고대행 신청정보조회
	If szTranID == "obacs_ovrs_002r" Then
		'신청여부
		Dim szRegYn
		szRegYn = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "APLT_YN" , 0)
		
		Dim szSellAmt, szBuyAmt, szNcsrAmt, szPrlsAmt, szBasicAmt, szStndAmt, szAntcCalcAmt, szOtcoIncmAmt
		
		lblNoPwd.visible = false
		contMain.visible = true
		tblYear.visible = true
		btnReg.visible = true
		
		'취소 케이스 
		If szRegYn == "Y" Then		
			btnReg.caption = "취소하기"
			
			szSellAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "WNCR_SELN_AMT" , 0)			'양도가액
			szBuyAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "WNCR_BYOV_AMT" , 0)			'취득가액
			szNcsrAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "NCSR_AMT" , 0)				'필요경비
			szPrlsAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "TRNF_INCM_AMT" , 0)			'양도소득합계
			szBasicAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "BASC_DDCT_AMT" , 0)		'기본공제금액
			szStndAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "TXTN_STND_AMT_SMTN" , 0)		'과세표준금액
			szAntcCalcAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "ANTC_CALC_AMT" , 0)		'예상계산금액
			szOtcoIncmAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock4" , "OTCO_TRNF_INCM_AMT" , 0)	'타사양도소득금액 (안쓰이는듯?)
			
			If szSellAmt == "" Or szSellAmt == null Then
				szSellAmt = "0"
			End If
			If szBuyAmt == "" Or szBuyAmt == null Then
				szBuyAmt = "0"
			End If
			If szNcsrAmt == "" Or szNcsrAmt == null Then
				szNcsrAmt = "0"
			End If
			If szPrlsAmt == "" Or szPrlsAmt == null Then
				szPrlsAmt = "0"
			End If
			If szBasicAmt == "" Or szBasicAmt == null Then
				szBasicAmt = "0"
			End If
			If szStndAmt == "" Or szStndAmt == null Then
				szStndAmt = "0"
			End If
			If szAntcCalcAmt == "" Or szAntcCalcAmt == null Then
				szAntcCalcAmt = "0"
			End If
			
			contMain.tblData.SetCellString(0, 1, szPrlsAmt)
			contMain.tblData.SetCellString(1, 1, szSellAmt)
			contMain.tblData.SetCellString(2, 1, szBuyAmt)
			contMain.tblData.SetCellString(3, 1, szNcsrAmt)
			contMain.tblData.SetCellString(4, 1, szBasicAmt)
			contMain.tblData.SetCellString(5, 1, szStndAmt)
			
			contMain.lblTotal.caption = szAntcCalcAmt
			
			'양도소득세 신고지 주소 세팅
			g_szLctnZip = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_REGN_ZIP" , 0)
			g_szLctnZipDtl = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_DTL_ZIP" , 0)
			g_szLctnZipSrno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_PSSR_SRNO" , 0)
			g_szLctnAddr = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_POST" , 0)
			g_szLctnAddrDtl = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_DTAD" , 0)
			g_szLctnAddrNewYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_NW_ADDR_USE_YN" , 0)
			If g_szLctnAddrNewYn == "" Then
				g_szLctnAddrNewYn = "N"
			End If
			g_szLctnBldnMnno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "LCTN_BLDN_MNNO" , 0)
			
			contMain.contAddr.lblAddr.visible = true
			contMain.contAddr.lblAddrDtl.visible = true
'			contMain.contAddr.lblGuide.visible = false
			contMain.contAddr.lblGuide.caption = ""
			
			contMain.contAddr.lblAddr.caption = g_szLctnAddr
			contMain.contAddr.lblAddrDtl.caption = g_szLctnAddrDtl
			
			f_ShowPayCont()
			
			'취소케이스에는 주소 불러오기 체크 숨김 처리
			contMain.contAddr.chkLoadAddr.visible = false
			
			'납부고지서 수령방법 
			Dim szPayRcvClcd
			szPayRcvClcd = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "PAYM_RECV_CLCD" , 0)
			contMain.contPayMethod.rdoProvision.enable = false
			If szPayRcvClcd == "1" Then		'등기우편
				contMain.contPayMethod.rdoProvision.currentindex = "1"
				contMain_contPayMethod_rdoProvision_OnClick(1)
				
				'취소케이스에는 주소 불러오기 체크 숨김 처리
				contMain.contPayMethod.chkLoadAddr.visible = false
				
				g_szZip = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "REGN_ZIP" , 0)
				g_szZipDtl = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "DTL_ZIP" , 0)
				g_szZipSrno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "PSSR_SRNO" , 0)
				g_szAddr = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "POST" , 0)
				g_szAddrDtl = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "DTAD" , 0)
				g_szAddrNewYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "NW_ADDR_USE_YN" , 0)
				If g_szAddrNewYn == "" Then
					g_szAddrNewYn = "N"
				End If
				g_szBldnMnno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "BLDN_MNNO" , 0)
				
				'불러온 주소 화면에 세팅
				contMain.contPayMethod.lblAddr.visible = true
				contMain.contPayMethod.lblAddrDtl.visible = true
'				contMain.contPayMethod.lblGuide.visible = false
				contMain.contPayMethod.lblGuide.caption = ""
				
				contMain.contPayMethod.lblAddr.caption = g_szAddr
				contMain.contPayMethod.lblAddrDtl.caption = g_szAddrDtl
				
			Else							'이메일
				g_szEmail = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "EMAIL_ADDR" , 0)
				
				contMain.contPayMethod.rdoProvision.currentindex = "0"
				contMain_contPayMethod_rdoProvision_OnClick(0)
				
				'불러온 이메일 화면에 세팅
				contMain.contPayMethod.tblProvision.SetCellString(0, 0, g_szEmail)
				contMain.contPayMethod.tblProvision.SetCellString(0, 1, "")
				
				contMain.contPayMethod.imgProvision.visible = false
				contMain.contPayMethod.lblProNotice.visible = false
				
				g_szZip = ""
				g_szZipDtl = ""
				g_szZipSrno = ""
				g_szAddr = ""
				g_szAddrDtl = ""
				g_szAddrNewYn = ""
				g_szBldnMnno = ""
			End If
			
			'신고대행료
			g_szVcexFeeAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock4" , "DCLR_VCEX_FEE_AMT" , 0)
			If g_szVcexFeeAmt == "" Then
				g_szVcexFeeAmt = "0"
			End If
			
			f_EnableRegBtn()
			
		'신청 케이스	
		Else						
			btnReg.caption = "신청하기"
			
			szSellAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "WNCR_SELN_AMT" , 0)			'양도가액
			szBuyAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "WNCR_BYOV_AMT" , 0)			'취득가액
			szNcsrAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "NCSR_AMT" , 0)				'필요경비
			szPrlsAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "PRLS_AMT" , 0)				'양도소득합계
			szBasicAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "BASC_DDCT_AMT" , 0)		'기본공제금액
			szStndAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "TXTN_STND_AMT" , 0)			'과세표준금액
			szAntcCalcAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "ANTC_CALC_AMT" , 0)		'예상계산금액
			szOtcoIncmAmt = ""
			
			If szSellAmt == "" Or szSellAmt == null Then
				szSellAmt = "0"
			End If
			If szBuyAmt == "" Or szBuyAmt == null Then
				szBuyAmt = "0"
			End If
			If szNcsrAmt == "" Or szNcsrAmt == null Then
				szNcsrAmt = "0"
			End If
			If szPrlsAmt == "" Or szPrlsAmt == null Then
				szPrlsAmt = "0"
			End If
			If szBasicAmt == "" Or szBasicAmt == null Then
				szBasicAmt = "0"
			End If
			If szStndAmt == "" Or szStndAmt == null Then
				szStndAmt = "0"
			End If
			If szAntcCalcAmt == "" Or szAntcCalcAmt == null Then
				szAntcCalcAmt = "0"
			End If
			
			contMain.tblData.SetCellString(0, 1, szPrlsAmt)
			contMain.tblData.SetCellString(1, 1, szSellAmt)
			contMain.tblData.SetCellString(2, 1, szBuyAmt)
			contMain.tblData.SetCellString(3, 1, szNcsrAmt)
			contMain.tblData.SetCellString(4, 1, szBasicAmt)
			contMain.tblData.SetCellString(5, 1, szStndAmt)
			
			contMain.lblTotal.caption = szAntcCalcAmt
			
			'신고대행 관련
			'온라인인 경우 면제로 고정 세팅(민츠 14402 참고함)
			DIm nFeeCnt
			nFeeCnt = grdFee.rowcount
			For i = 0 To nFeeCnt - 1
				Dim szYear, szCenter, szClcd, szFeeAmt
				szYear = grdFee.GetCellData("bd_cell0", i)
				szCenter = grdFee.GetCellData("bd_cell1", i)
				szClcd = grdFee.GetCellData("bd_cell2", i)
				szFeeAmt = grdFee.GetCellData("bd_cell6", i)
				
				If szYear == tblYear.GetCellString(0, 1) And szCenter == "1" And szClcd == "1" Then
					g_szVcexFeeAmt = szFeeAmt
					
					Exit For
				Else
					g_szVcexFeeAmt = "0"
				End If
			Next
			If g_szVcexFeeAmt == "" Or g_szVcexFeeAmt == null Then
				g_szVcexFeeAmt = "0"
			End If
			
			'미성년자 체크
			Dim szMnrYn
			szMnrYn = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock5" , "UI_MNR_YN" , 0)
			If szMnrYn == "Y" Then
				Form.MsgBox("알림", "미성년자는 온라인 신청이 불가합니다.\n내방 또는 관리점에 문의하세요.", "MOVE_HOME", 6)
				Exit Sub
			End If
			
			'과세표준금액 체크 (과세표준금액 > 0 만 처리가능)
			If CLng(szStndAmt) <= 0 Then
				Form.MsgBox("알림", "기본공제금액 이하 양도소득금액은 온라인 신청이 불가합니다.\n내방 또는 관리점에 문의하세요.", "MOVE_HOME", 6)
				Exit Sub
			End If
			
			'양도소득세 신고지 주소 관련 처리
			Dim nAddrCnt
			nAddrCnt = grdAddr.rowcount
			'자택 > 직장의 우선순위로 주소를 설정함
			For i = 0 To nAddrCnt - 1
				Dim szClsCode, szRegYn
				szClsCode = grdAddr.GetCellData("bd_cell0", i)
				szRegYn = grdAddr.GetCellData("bd_cell1", i)
				
				'유효한 자택 또는 회사주소가 있으면 인덱스 설정하고 반복문 종료
				'자택주소등록여부
				If szClsCode == "2" And szRegYn == "Y" Then
					g_nAddrRow = i
					Exit For
				End If
				'회사주소등록여부
				If szClsCode == "3" And szRegYn == "Y" Then
					g_nAddrRow = i
					Exit For
				End If
			Next
			
			'등록된 이메일 조회
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		End If
		
		
	'등록된 이메일 조회
	ElseIf szTranID == "obcsb_acif_140r" Then
		Dim nCnt
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'mbonl81000 화면에서 이메일 삭제하는 경우가 있어 이 시점에서 초기화
			g_szEmail = ""
			
			Dim strInagTypeCode2, strInagSrno2, strAddr
			'이메일 주소
			nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to nCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    If strInagTypeCode2 = "21" Then
					g_szEmail = strAddr
			    End If
			Next 	
		End If 
		
		'납부고지서 수령방법 이메일 영역에 세팅
		If g_szEmail <> "" And g_szEmail <> null Then
			contMain.contPayMethod.tblProvision.SetCellString(0, 0, g_szEmail)
			contMain.contPayMethod.tblProvision.SetCellString(0, 1, "변경하기 〉")
		Else
			contMain.contPayMethod.tblProvision.SetCellString(0, 0, "")
			contMain.contPayMethod.tblProvision.SetCellString(0, 1, "등록하기 〉")
		End If
		
		f_EnableRegBtn()
	
	'해외주식 양도소득신고대행 신청관리
	ElseIf szTranID == "obacs_ovrs_002a" Then
		If Trim(btnReg.caption) == "취소하기" Then
			Form.MsgBox("안내", "해외주식 양도소득 신고대행 신청이 취소되었습니다.", "CANCEL_COMPLETE", 6)
			
		Else
			'신고년도 / 납부고지서 수령방법 / 수령지 주소1 / 수령지 주소2
			Dim szSendData
			If contMain.contPayMethod.rdoProvision.currentindex == "0" Or contMain.contPayMethod.rdoProvision.currentindex == 0 Then
				szSendData = tblYear.GetCellString(0, 1) & "★" & contMain.contPayMethod.rdoProvision.currentindex & "★" & g_szEmail
			Else
				szSendData = tblYear.GetCellString(0, 1) & "★" & contMain.contPayMethod.rdoProvision.currentindex & "★" & g_szAddr & "★" & g_szAddrDtl
			End If
			
			'완료화면 팝업
			Form.OpenPopup("mbtro16110_p1" , szSendData , "")
		End If
	
	'해외주식신용정보동의내역 관리
	ElseIf szTranID == "obcsb_acif_554a" Then
	
		'해외주식 양도소득신고대행 신청관리
		DATAMANAGER.RequestTranData( "obacs_ovrs_002a" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szSubMsg <> "" And szSubMsg <> null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Function f_SetClear(szType)
	If szType == "All" Then
		lblNoPwd.visible = true
		contMain.visible = false
		tblYear.visible = false
		btnReg.visible = false
		
		edtPwd.caption = ""
	End If
	
	'년도 세팅 
	Dim szYear 
	szYear = Left(Form.GetSharedData("&HOST_DATE", false), 4)
	tblYear.SetCellString(0, 1, CInt(szYear) - 1)
	
	'아코디언 영역 초기화
	g_bMore = true
	f_SetMore()
	
	'양도소득세 신고지 관련 초기화
	grdAddr.SetClear()
	
	g_nAddrRow = -1
	contMain.contAddr.lblAddr.visible = false
	contMain.contAddr.lblAddrDtl.visible = false
'	contMain.contAddr.lblGuide.visible = true
	contMain.contAddr.lblGuide.caption = "주민등록지 주소를 입력하세요."
	
	contMain.contAddr.lblAddr.caption = ""
	contMain.contAddr.lblAddrDtl.caption = ""
	
	contMain.contAddr.chkLoadAddr.chksilence = "0"
	
	contMain.contAddr.chkLoadAddr.visible = true
	
	'신고대행 그리드 초기화
	grdFee.SetClear()
	
	'납부고지서 수령방법 관련 초기화
	contMain.contPayMethod.visible = false
	
	contMain.contPayMethod.rdoProvision.enable = true
	contMain.contPayMethod.rdoProvision.currentindex = "-1"
	contMain.contPayMethod.tblProvision.visible = false
	contMain.contPayMethod.imgProvision.visible = false
	contMain.contPayMethod.lblProNotice.visible = false
	
	contMain.contPayMethod.tblProvision.SetCellString(0, 0, "")
	
	contMain.contPayMethod.imgAddrBg.visible = false
	contMain.contPayMethod.lblGuide.visible = false
'	contMain.contPayMethod.lblGuide.caption = ""
	contMain.contPayMethod.lblAddr.visible = false
	contMain.contPayMethod.lblAddrDtl.visible = false
	contMain.contPayMethod.chkLoadAddr.visible = false
	
	contMain.contPayMethod.chkLoadAddr.chksilence = "0"
	
	contMain.contPayMethod.lblAddr.caption = ""
	contMain.contPayMethod.lblAddrDtl.caption = ""
	
	'전역변수 초기화 
	g_szLctnZip = ""
	g_szLctnZipDtl = ""
	g_szLctnZipSrno = ""
	g_szLctnAddr = ""
	g_szLctnAddrDtl = ""
	g_szLctnAddrNewYn = ""
	g_szLctnBldnMnno = ""
	
	g_szZip = ""
	g_szZipDtl = ""
	g_szZipSrno = ""
	g_szAddr = ""
	g_szAddrDtl = ""
	g_szAddrNewYn = ""
	g_szBldnMnno = ""
	
	g_szVcexFeeAmt = ""
	g_szEmail = ""
	
	g_szAddrSurfType = ""
	
	contMain.lblTotal.caption = ""
	contMain.tblData.SetCellString(0, 1, "")
	contMain.tblData.SetCellString(1, 1, "")
	contMain.tblData.SetCellString(2, 1, "")
	contMain.tblData.SetCellString(3, 1, "")
	contMain.tblData.SetCellString(4, 1, "")
	contMain.tblData.SetCellString(5, 1, "")
	
	f_EnableRegBtn()
End Function

'============================================================================
Function f_SetMore()
	'상단 아코디언 영역 처리
	If g_bMore Then
		g_bMore = false
		
		contMain.lblMore.caption = "상세"
		contMain.imgMore.imgpath = "icon_gray_down"
		
		contMain.lblMore.top = 75
		contMain.imgMore.top = 75
		
		contMain.contAddr.top = 118
		contMain.contPayMethod.top = 245
		contMain.Label1.top = 380
		
		contMain.imgBg.height = 108
		
		contMain.tblData.visible = false
	Else
		g_bMore = true
		
		contMain.lblMore.caption = "접기"
		contMain.imgMore.imgpath = "icon_gray_up"
		
		contMain.lblMore.top = 225
		contMain.imgMore.top = 225
		
		contMain.contAddr.top = 268
		contMain.contPayMethod.top = 395
		contMain.Label1.top = 565
		
		contMain.imgBg.height = 258
		
		contMain.tblData.visible = true
	End If
	
	contMain.SetScrollAutoSize()
End Function

'============================================================================
Function f_ShowPayCont()
	'contPayMethod 보임여부
	If g_szLctnZip <> "" And g_szLctnZip <> null And g_szLctnZipDtl <> "" And g_szLctnZipDtl <> null Then
		contMain.contPayMethod.visible = true
	Else
		contMain.contPayMethod.visible = false
	End If
End Function

'============================================================================
Function f_EnableRegBtn()
	Dim bFlag
	bFlag = true
	
	'양도소득세 신고지 입력 여부
	If g_szLctnZip == "" Or g_szLctnZip == null Or g_szLctnZipDtl == "" Or g_szLctnZipDtl == null Then
		bFlag = false
	End If
	
	'납부고지서 수령 방법 입력 여부
	If contMain.contPayMethod.rdoProvision.currentindex == "0" Then		'이메일
		If g_szEmail == "" Or g_szEmail == null Then
			bFlag = false
		End If
	ElseIf contMain.contPayMethod.rdoProvision.currentindex == "1" Then	'등기우편
		If g_szZip == "" OR g_szZip == null Or g_szZipDtl == "" Or g_szZipDtl == null Then
			bFlag = false
		End If
	Else
		bFlag = false
	End If
	
	btnReg.enable = bFlag
End Function

'============================================================================
Sub btnPwd_OnClick()
	If edtPwd.caption == "" Or edtPwd.caption == null Then
		Form.openPopupAnimation( "pwdcheckpopup", acnt.caption & "☆2", "", "2" )
	End If
End Sub


'============================================================================
Sub contMain_contAddr_chkLoadAddr_OnChange(sCheckState)
	'기존 주소정보 불러오기
	If g_nAddrRow <> -1 Then
		If sCheckState == "1" Then
			contMain.contAddr.lblAddr.visible = true
			contMain.contAddr.lblAddrDtl.visible = true
'			contMain.contAddr.lblGuide.visible = false
			contMain.contAddr.lblGuide.caption = ""
			
			contMain.contAddr.lblAddr.caption = grdAddr.GetCellData("bd_cell8", g_nAddrRow)
			contMain.contAddr.lblAddrDtl.caption = grdAddr.GetCellData("bd_cell9", g_nAddrRow)
			
			'주소 변수에 데이터 세팅
			g_szLctnZip = grdAddr.GetCellData("bd_cell5", g_nAddrRow)
			g_szLctnZipDtl = grdAddr.GetCellData("bd_cell6", g_nAddrRow)
			g_szLctnZipSrno = grdAddr.GetCellData("bd_cell7", g_nAddrRow)
			g_szLctnAddr = grdAddr.GetCellData("bd_cell8", g_nAddrRow)
			g_szLctnAddrDtl = grdAddr.GetCellData("bd_cell9", g_nAddrRow)
			g_szLctnAddrNewYn = grdAddr.GetCellData("bd_cell10", g_nAddrRow)
			g_szLctnBldnMnno = grdAddr.GetCellData("bd_cell11", g_nAddrRow)
			
		Else
			contMain.contAddr.lblAddr.visible = false
			contMain.contAddr.lblAddrDtl.visible = false
'			contMain.contAddr.lblGuide.visible = true
			contMain.contAddr.lblGuide.caption = "주민등록지 주소를 입력하세요."
			
			contMain.contAddr.lblAddr.caption = ""
			contMain.contAddr.lblAddrDtl.caption = ""
			
			g_szLctnZip = ""
			g_szLctnZipDtl = "" 
			g_szLctnZipSrno = ""
			g_szLctnAddr = ""
			g_szLctnAddrDtl = ""
			g_szLctnAddrNewYn = ""
			g_szLctnBldnMnno = ""
		End If
		
		f_ShowPayCont()
	Else
		'등록된 주소 없으면 주소검색 유도얼럿 노출
		Form.ShowAlert("알림", "등록된 주소정보가 존재하지 않습니다. 주소를 직접 검색해 주세요.")
		contMain.contAddr.chkLoadAddr.chksilence = "0"
	End If
	
	f_EnableRegBtn()
End Sub

'============================================================================
Sub contMain_contAddr_lblGuide_OnClick()
	If Trim(btnReg.caption) == "신청하기" Then
		g_szAddrSurfType = "1"
		
		'주소검색 팝업 오픈
		Form.OpenPopupAnimation("mbbdm85150_p1", "pass", "", "2")
	End If
End Sub

'============================================================================
Sub contMain_lblMore_OnClick()
	f_SetMore()
End Sub

'============================================================================
Sub contMain_imgMore_OnClick()
	f_SetMore()
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	f_SetClear("All")
End Sub

'============================================================================
Sub contMain_contPayMethod_rdoProvision_OnClick(nIndex)
	'contPayMethod의 수령 방법 라디오그룹 변경 이벤트
	'이메일
	If nIndex == 0 Then
		contMain.contPayMethod.tblProvision.visible = true
		contMain.contPayMethod.imgProvision.visible = true
		contMain.contPayMethod.lblProNotice.visible = true
		
		contMain.contPayMethod.imgAddrBg.visible = false
		contMain.contPayMethod.lblGuide.visible = false
		contMain.contPayMethod.lblAddr.visible = false
		contMain.contPayMethod.lblAddrDtl.visible = false
		contMain.contPayMethod.chkLoadAddr.visible = false
		
		g_szZip = ""
		g_szZipDtl = ""
		g_szZipSrno = ""
		g_szAddr = ""
		g_szAddrDtl = ""
		g_szAddrNewYn = ""
		g_szBldnMnno = ""
		
		contMain.contPayMethod.chkLoadAddr.chksilence = false
		
	'등기우편
	Else
		contMain.contPayMethod.tblProvision.visible = false
		contMain.contPayMethod.imgProvision.visible = false
		contMain.contPayMethod.lblProNotice.visible = false
		
		contMain.contPayMethod.imgAddrBg.visible = true
		contMain.contPayMethod.lblGuide.visible = true
		contMain.contPayMethod.lblGuide.caption = "실제 수령 가능한 주소를 입력해주세요."
		'lblAddr, lblAddrDtl 는 기존주소 불러오기나 주소검색 완료 후 보여줌
		contMain.contPayMethod.lblAddr.visible = false
		contMain.contPayMethod.lblAddrDtl.visible = false
		contMain.contPayMethod.chkLoadAddr.visible = true
	End If
	
	f_EnableRegBtn()
End Sub

'============================================================================
Sub contMain_contPayMethod_tblProvision_OnClick(lRow , lColumn)
	'신청하기의 경우에만 기능하게
	If Trim(btnReg.caption) == "신청하기" Then
		If lRow == 0 And lColumn == 1 Then
			'연락처변경 화면 오픈
			Dim szSendData
			szSendData = acnt.total & ";" & edtPwd.caption & ";" & "1"
			Form.OpenFramePopup("mbonl81000" , szSendData , "")
		End If
	End If
End Sub

'============================================================================
Sub contMain_contPayMethod_lblGuide_OnClick()
	If Trim(btnReg.caption) == "신청하기" Then
		g_szAddrSurfType = "2"
		
		'주소검색 팝업 오픈
		Form.OpenPopupAnimation("mbbdm85150_p1", "pass", "", "2")
	End If
End Sub

'============================================================================
Sub contMain_contPayMethod_chkLoadAddr_OnChange(sCheckState)
	'양도소득세 신고지가 입력이 되어 있는 경우만 유효
	If sCheckState == "1" Then
		If g_szLctnZip <> "" And g_szLctnZip <> null And g_szLctnZipDtl <> "" And g_szLctnZipDtl <> null Then
			g_szZip = g_szLctnZip
			g_szZipDtl = g_szLctnZipDtl
			g_szZipSrno = g_szLctnZipSrno
			g_szAddr = g_szLctnAddr
			g_szAddrDtl = g_szLctnAddrDtl
			g_szAddrNewYn = g_szLctnAddrNewYn
			g_szBldnMnno = g_szLctnBldnMnno
			
'			contMain.contPayMethod.lblGuide.visible = false
			contMain.contPayMethod.lblGuide.caption = ""
			contMain.contPayMethod.lblAddr.visible = true
			contMain.contPayMethod.lblAddrDtl.visible = true
			
			contMain.contPayMethod.lblAddr.caption = g_szAddr
			contMain.contPayMethod.lblAddrDtl.caption = g_szAddrDtl
		Else
			Form.ShowAlert("알림", "양도소득세 신고지가 입력되지 않았습니다.\n양도소득세 신고지 입력 후, 다시 체크하세요.")
			contMain.contPayMethod.chkLoadAddr.chksilence = "0"
		End If
	Else
		g_szZip = ""
		g_szZipDtl = ""
		g_szZipSrno = ""
		g_szAddr = ""
		g_szAddrDtl = ""
		g_szAddrNewYn = ""
		g_szBldnMnno = ""
		
		contMain.contPayMethod.lblGuide.visible = true
		contMain.contPayMethod.lblGuide.caption = "실제 수령 가능한 주소를 입력해주세요."
		contMain.contPayMethod.lblAddr.visible = false
		contMain.contPayMethod.lblAddrDtl.visible = false
		
		contMain.contPayMethod.lblAddr.caption = ""
		contMain.contPayMethod.lblAddrDtl.caption = ""
	End If
	
	f_EnableRegBtn()
End Sub

'============================================================================
Sub btnReg_OnClick()
	If Trim(btnReg.caption) == "신청하기" Then
		'약관동의 화면 팝업
		Form.OpenPopup("mbtro16110_p2", "", "")
	Else
		'해지 케이스라면 확인 메시지 박스 띄운 후 서비스 호출
		Form.MsgBox("안내", "해외주식 양도소득 신고대행 신청을 취소하시겠습니까?", "CANCEL_CONFIRM", 2)
	End If
End Sub

'============================================================================
Sub contMain_imgToolTip_OnClick()
	Dim szText
	szText = "예상 양도소득세:\n과세표준금액(양도소득합계 - 기본공제금액) * 22%"
	
	Dim szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	If szOSType == "1" Then
		contMain.imgToolTip.openToolTip(szText, 335, 70, 2)
	Else
		contMain.imgToolTip.openToolTip(szText, 340, 70, 2)
	End If
End Sub



