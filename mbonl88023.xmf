Dim g_szPwd
Dim g_szAgree1, g_szAgree2
Dim g_szAgrTp
Dim g_szFnprJoinSrno
Dim g_szSvcSrno
Dim g_szPhoneNum, g_szPhoneInagTypeCode, g_szPhoneInagSrno		'알림톡/문자 정보
Dim g_szEmail, g_szEmailInagTypeCode, g_szEmailInagSrno		'이메일 정보

Dim g_szProcType

Dim g_szCsno
Dim g_szCsnm
Dim g_szCustClsCode
Dim g_szAnxtAprt_Yn

Dim g_bChangeAcnt
Dim g_nSelectRow

Dim g_NICE_TR_CODE
Dim g_NICE_TR_SRNO
Dim g_Timer_TRY_CNT 
Dim g_PROS_CLS'1.조회 2.처리
'============================================================================
Sub Form_OnFormInitBefore()
	contReg.imgChkAll.setMaintainingRatio("1")
	contReg.imgTooltip.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bChangeAcnt = false
	
	contList.visible = false
	contReg.visible = false
	
	f_ResetScreen()
	
	g_szCsno = Form.GetSharedData("&CUST_NUM", false)
	
	if contReg.acnt.caption <> "" and contReg.acnt.caption <> null then
		'등록된 휴대폰번호, 이메일 조회
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		
		'해외주식 대출약정 계좌 조회
		DATAMANAGER.RequestTranData( "oblon_basc_813r" )
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then
		'유의사항
		Form.OpenFramePopup("mbonl88023_p2", "" , "")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'약관 팝업 리턴
	if sKeyName == "mbonl88023_p3" and sRet == "AGREE" then
		if g_szAgrTp == "1" then
			g_szAgree1 = "Y"
			contReg.imgChk1.imgpath = "check_line_o"
			if g_szAgree2 == "Y" then
				contReg.imgChkAll.imgpath = "checkmenu_o"
			end if
			
		elseif g_szAgrTp == "2" then
			g_szAgree2 = "Y"
			contReg.imgChk2.imgpath = "check_line_o"
			if g_szAgree1 == "Y" then
				contReg.imgChkAll.imgpath = "checkmenu_o"
			end if
			
		elseif g_szAgrTp == "All" then
			g_szAgree1 = "Y"
			g_szAgree2 = "Y"
			contReg.imgChkAll.imgpath = "checkmenu_o"
			contReg.imgChk1.imgpath = "check_line_o"
			contReg.imgChk2.imgpath = "check_line_o"
		end if
		
		g_szAgrTp = ""
		
		f_CheckNextEnable()
		
	'연락처 변경
	elseif sKeyName == "mbonl81000" and sRet == "ok" then
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	
	'금융소비자 유형 확인 팝업 리턴
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			'이 시점에서 신청화면으로 전환
			f_ShowContainer("contReg")
			
			'대출 고객정보 확인서 징구 여부 관련 조회
			DATAMANAGER.RequestTranData( "oblon_basc_103r" )
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
			f_ResetScreen()
			f_ShowContainer("contList")
		end if
		
	'설문지 리턴
	elseif sKeyName = "mbonl93500" Then
		g_szAnxtAprt_Yn = sRet	'부적정여부
		if g_szAnxtAprt_Yn == "" or g_szAnxtAprt_Yn == null then
			f_ResetScreen()
			f_ShowContainer("contList")
			exit sub
		end if
		if g_szAnxtAprt_Yn = "N" then	'부적정여부 리턴: 적정
			Form.MsgBox("알림", "부적정여부 : [적정]. 계속 진행하세요", "kyc_check", 0)	'확인 버튼만
		elseif g_szAnxtAprt_Yn = "Y" then
			'대출_고객정보 확인서 징구 여부 관련 조회로 처음부터 체크한다. 
			Form.MsgBox("알림", "부적정여부 : [부적정]", "kyc_check", 0) '확인 버튼만
		end If
	
	'주요내용, 이해여부 확인 팝업 리턴
	elseif sKeyName == "mbonl82010_p9" and sRet == "OK" then
		'계좌비밀번호 체크 팝업
		Form.openPopupAnimation("pwdcheckpopup", contReg.acnt.caption & "☆0" ,"","2")
	
	'계좌 비밀번호 팝업 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tPwd
		tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
		
		if UBOUND(tPwd) > 0 then
			g_szPwd = tPwd(0)
			
			'"I": 등록, "D": 해지
			if g_szProcType == "I" then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
			elseif g_szProcType == "D" then
				DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
			end if
		end if 
	
	'인증 팝업 리턴
	elseif sKeyName == "mhetc90060_p5" then
		Dim tData
		tData = Split(sRet, ";")	'성공여부, 비밀번호
		if tData(0) == "ok" then
			'가입계약서류 제공방식 관리
			DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
		else	
			
		end if	
	
	'완료팝업 리턴
	elseif sKeyName == "mbonl88023_p1" and sRet <> "" and sRet <> null then
		if sRet == "ok" then
			f_ResetScreen()
			f_ShowContainer("contList")
			
			Form.OpenMainMenuWithIndex(2,2,1)
			
		elseif sRet == "continue" then
			f_ResetScreen()
			
			g_bChangeAcnt = true
			
			'해외주식 대출약정 계좌 조회
			DATAMANAGER.RequestTranData( "oblon_basc_813r" )
			
			'등록된 휴대폰번호, 이메일 조회
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if
		
	'부적정보고서 리턴
	elseif sKeyName = "mbonl93503" Then
		if sRet == "Y" then
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		else
			f_ResetScreen()
			f_ShowContainer("contList")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "kyc" then
		if sRet == "ok" then			
			Dim szData
			szData = f_SetKycSharedData("mbonl93500")
			Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		else
			f_ResetScreen()
			f_ShowContainer("contList")
		End if
	
	elseif sKeyName == "kyc_check" then
		if g_szAnxtAprt_Yn == "Y" then
			'oblon_basc_103r 부터 다시 체크 시작
			DATAMANAGER.RequestTranData( "oblon_basc_103r" )
		
		else
			'부적정 아니라면 해외주식거래 신청 여부 조회
			DATAMANAGER.RequestTranData( "obpds_srvc_423r_1" )
		end if
	
	elseif sKeyName == "kyc_report" then
		if sRet == "ok" then
			f_SetKycSharedData("mbonl93503")
			Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		else
'			Form.MsgBox( "안내", "부적정확인서를 발급하여야 진행하실 수 있습니다.", "kyc_fail", 6 )	
'			exit sub
			
			f_ResetScreen()
			f_ShowContainer("contList")
			
		end if
	
	'증권담보대출약정 미신청 메시지박스 리턴
	elseif sKeyName == "REG_MOVE1" then
		if sRet == "ok" then
			Form.OpenScreen("82020", "")
		else
			f_ResetScreen()
			f_ShowContainer("contList")
		end if
	
	'해외주식거래 미신청 메시지박스 리턴
	elseif sKeyName == "REG_MOVE2" then
		if sRet == "ok" then
			Form.OpenScreen("87051", "")
		else
'			f_ResetScreen()
'			f_ShowContainer("contList")
		end if
	
	elseif sKeyName == "REG_MOVE3" then
		if sRet == "ok" then
			f_ResetScreen()
			f_ShowContainer("contList")
		else
			Form.OpenScreen("82024", "")
		end if
	
	'고객지원센터 유도 메시지박스 리턴
	elseif sKeyName == "CUST_CENTER" then
		if sRet == "ok" then
			Form.OpenScreen("89020", "")
		else
			f_ResetScreen()
			f_ShowContainer("contList")
		end if
	
	'계좌 해지 확인 메시지박스 리턴
	elseif sKeyName == "CANCEL_CONFIRM" then
		if sRet == "ok" then
			g_szProcType = "D"
			
			Dim szTemp
			szTemp = contList.pannList.getPropCardCell("caption", "lblDataAcnt", g_nSelectRow)
			
			'계좌비밀번호 체크 팝업
			Form.openPopupAnimation("pwdcheckpopup", szTemp & "☆0" ,"","2")
			
'			'해외주식 대출약정 해지
'			DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
		end if
		
	'계좌 해지 완료 메시지박스 리턴
	elseif sKeyName == "CANCEL_COMPLETE" then
		f_ShowContainer("contList")
		
		if sRet == "ok" then
			Form.OpenMainMenuWithIndex(2,2,1)
		end if
	
	'부적정확인서 
	elseif sKeyName == "kyc_fail" then
		f_ResetScreen()
		f_ShowContainer("contList")
	elseif sKeyName == "LN01" then
		if sRet == "ok" then
			NICE_LN01_CALL()
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contReg.acnt.total)
		
	'고객정보조회
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "I" 			 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		   , 0 , contReg.acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 	   , 0 , ""	 )
	
	'해외주식 대출약정 계좌 조회
	elseif szTranID == "oblon_basc_813r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contReg.acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , contReg.acnt.sequence)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
	
	'해외주식 대출약정 가능여부 조회
	elseif szTranID == "oblon_basc_814r" then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID" , 0 , szUserID)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
	
	'증권담보대출 신청 여부 조회
	elseif szTranID == "obpds_srvc_423r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , contReg.acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , contReg.acnt.sequence )
	
	'해외주식거래 신청 여부 조회
	elseif szTranID == "obpds_srvc_423r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "1" 			  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , contReg.acnt.total)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , contReg.acnt.sequence)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" , 0 , "082" )
		
	'대출 고객정보 확인서 징구 여부 관련 조회
	elseif szTranID == "oblon_basc_103r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		   , 0 , contReg.acnt.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , 0 , "17198" )				'대출약정
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOAN_TYPE_CODE", 0 , "02" )				'예탁담보
	
	'해외주식 대출약정 신청/해지
	elseif szTranID == "obpds_srvc_045a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , g_szProcType )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 		   , 0 , g_szCsno 		 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" 		   , 0 , "085" 		 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03" 	 )
		if g_szProcType == "D" then
			'해지시에는 리스트에서 선택한 계좌번호를 가져와 세팅
			Dim szAcno, szAsno, szTemp
			szTemp = contList.pannList.getPropCardCell("caption", "lblDataAcnt", g_nSelectRow)
			szAcno = left(szTemp, 8)
			szAsno = right(szTemp, 2)
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			   , 0 , szAcno )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 			   , 0 , szAsno )
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			   , 0 , contReg.acnt.total )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 			   , 0 , contReg.acnt.sequence )
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		   , 0 , g_szPwd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4" 			 )	
		
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		if CInt(contReg.rdoCtcn.currentindex) == 0 then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "04")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , "13")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UI_CUST_TEL_NO" , 0 , g_szPhoneNum)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_SRNO" , 0 , g_szPhoneInagSrno)
		else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "02")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , "21")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ADDR" , 0 , g_szEmail)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_SRNO" , 0 , g_szEmailInagSrno)
		end if
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
	
	'계약서류 교부처리
	elseif szTranID == "obcsb_dbif_322a" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 		   		, 0 , contReg.acnt.total )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_SRNO" 		, 0 , g_szFnprJoinSrno )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE"  		, 0 , "4")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_LRDV_CODE" 		, 0 , "017")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RECDNG_NO" 	   	   	, 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" 	, 0 , "00001")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ISCD" 		   		, 0 , "085")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BSWR_DIV_CODE"  		, 0 , "17198")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"   	, 0 , g_szCsno & "$" & "085" & "$" & g_szSvcSrno)
	elseif szTranID == "oblon_nice_001r" then
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "NICE_TR_CLCD" , 0 , "2P001")
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "ACNO" 		 , 0 , contReg.acnt.total)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		Dim nCnt, nCnt1
		'이메일 주소
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
		for i = 0 to nCnt - 1
		    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
		    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
		    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
		    if strInagTypeCode2 = "21" then
				g_szEmail = strAddr
				g_szEmailInagTypeCode = strInagTypeCode2
				g_szEmailInagSrno = strInagSrno2
		    end if
		next 	
		'휴대폰 번호
		nCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
		for i = 0 to nCnt1 - 1
		    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
		    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
		    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)
		    if strInagTypeCode3 = "13" then
			    g_szPhoneNum = strCustTelno
			    g_szPhoneInagTypeCode = strInagTypeCode3
			    g_szPhoneInagSrno = strInagSrno3
		    end if
		next
		
		'재조회 시 표시영역에 바뀐 정보 보여줌
		if CInt(contReg.rdoCtcn.currentindex) == 0 then
			contReg.tblCtcn.SetCellString(0, 0, g_szPhoneNum)
			contReg.lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
		elseif CInt(contReg.rdoCtcn.currentindex) == 1 then
			contReg.tblCtcn.SetCellString(0, 0, g_szEmail)
			contReg.lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
		end if
		
		'계좌 변경을 해서 화면 재조회 하는 경우
		if g_bChangeAcnt then
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		end if
	
	'고객정보조회
	elseif szTranID == "obcsb_acif_000r" then
		g_szCsno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO" , 0 )
		g_szCsnm = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_FULL_NAME" , 0 )
		g_szCustClsCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_CLS_CODE" , 0 )
		
		'금융상품가입일련번호 채번
		DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		
	'해외주식 대출약정 계좌 조회
	elseif szTranID == "oblon_basc_813r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1")
		
		contList.pannList.rowcount = 0

		Dim szAcno, szAsno, szMaskAcnt, szRegDate, szPrnm
		if nCnt > 0 then
			for i = 0 to nCnt - 1
				contList.pannList.AddRow()
				szAcno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ACNO" , i)
				szAsno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ASNO" , i)
				szRegDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "REG_DATE" , i)
				szPrnm = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "PRNM" , i)
				
				szMaskAcnt = "[" .. szPrnm .. "]" .. Left(szAcno, 4) .. "-" .. Right(szAcno, 4) .. "-" .. szAsno
				
				contList.pannList.setPropCardCell("caption", "lblAcnt", i, szMaskAcnt)
				contList.pannList.setPropCardCell("caption", "lblRegDate", i, szRegDate)
				contList.pannList.setPropCardCell("caption", "lblDataAcnt", i, szAcno .. szAsno)
			next 
			
			contList.pannList.FitToSize()
			
			'계좌추가 영역 위치 세팅
			Dim nHeight
			nHeight = contList.pannList.height
			contList.contAdd.top = 80 + nHeight + 10
		else			
			contList.pannList.FitToSize()
			
			contList.contAdd.top = 80
		end if

		contList.SetScrollAutoSize()
		
		if CInt(contList.pannList.rowcount) == 0 then
			contList.contAdd.tblAddTextNoData.visible = true
			contList.contAdd.tblAddText.visible = false
		else
			contList.contAdd.tblAddTextNoData.visible = false
			contList.contAdd.tblAddText.visible = true
		end if
		
		'완료 후 추가등록하기시에 분기하기 위한 부분
		if not g_bChangeAcnt then
			'전부 세팅 후 보이게
			contList.visible = true
		end if
	
	'금융상품가입일련번호 채번
	elseif szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO" , 0 )
		
		'계좌 변경을 해서 화면 재조회 하는 경우
		if g_bChangeAcnt then
			DATAMANAGER.RequestTranData( "obpds_srvc_423r_1" )
			exit sub
		end if
		
		'금융소비자 유형 확인 팝업
		Form.SetSharedData( "SPCL_CNFR_ACNO", contReg.acnt.total )
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		Form.SetSharedData( "LoanYN", "Y")
		Form.OpenPopup("mbonl81010_p20" , "" , "")
		
	'해외주식 대출약정 가능여부 조회
	elseif szTranID == "oblon_basc_814r" then
		Dim szAbleYn, szMsgCode
		szAbleYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "LOAN_ABLE_YN" , 0 )
		szMsgCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MSG_CODE" , 0 )
'		Form.ShowAlert(szAbleYn, szMsgCode)
		
		'"0000" 정상 
		if szMsgCode == "0000" then
'			f_ShowContainer("contReg")
			
			'고객정보조회
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		
		'그 외 불가사유 메시지박스 처리
		elseif szMsgCode == "8970" then
			Form.MsgBox("안내", "담보대출약정 가능시간이 아닙니다.\n(가능시간 : 영업일 8시 ~ 17시)", "", 6)
		elseif szMsgCode == "8978" then
			Form.MsgBox("안내", "미성년자는 담보약정대출이 불가능합니다.", "", 6)
		elseif szMsgCode == "8971" then
			Form.MsgBox("안내", "외국인은 지점 또는 고객지원센터로\n문의주시기 바랍니다.", "CUST_CENTER", 7, "고객지원센터", "확인")
		elseif szMsgCode == "8975" then
			Form.MsgBox("안내", "신용불량자는 담보대출약정이 불가능합니다.", "", 6)
		elseif szMsgCode == "7423" then
			Form.MsgBox("안내", "반송계좌 보유 고객은\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.", "CUST_CENTER", 7, "고객지원센터", "확인")
		elseif szMsgCode == "8987" then
			Form.MsgBox("안내", "실명 미확인 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.", "CUST_CENTER", 7, "고객지원센터", "확인")
		elseif szMsgCode == "8988" then
			Form.MsgBox("안내", "금융사기이용계좌는\n담보대출약정이 불가능합니다.", "", 6)
		elseif szMsgCode == "8990" then
			Form.MsgBox("안내", "등기임원 등록 계좌는\n담보대출약정이 불가능합니다.", "", 6)
		elseif szMsgCode == "1238" then
			Form.MsgBox("안내", "담보대출약정 신청 후\n해외주식 대출약정 신청이\n가능합니다.", "REG_MOVE1", 7, "신청하러가기", "취소")
		elseif szMsgCode == "8972" then
			Form.MsgBox("안내", "약정 가능한 개별계좌가 없습니다.\n다른 계좌를 선택해주세요.", "", 6)
		end if
	
	'증권담보대출 신청 여부 조회
	elseif szTranID == "obpds_srvc_423r" then
		Dim szRegYn
		szRegYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "USE_YN" , 0 )
		if szRegYn == "N" or szRegYn == "" or szRegYn == null then
			Form.MsgBox("안내", "담보대출약정 신청 후\n해외주식 대출약정 신청이\n가능합니다.", "REG_MOVE1", 7, "신청하러가기", "취소")
		else
			'신청되어있으면 금융소비자 유형 확인 팝업
			Form.SetSharedData( "SPCL_CNFR_ACNO", contReg.acnt.total )
			Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
			Form.SetSharedData( "LoanYN", "Y")
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	
	'해외주식거래 신청 여부 조회
	elseif szTranID == "obpds_srvc_423r_1" then
		Dim szCode
		szCode = DATAMANAGER.GetDataMsgCode(szTranID)
		if szCode == "5766" then
			contReg.lblBlock.visible = false
			
			'기약정 계좌 처리 추가 필요?
			g_PROS_CLS = "1"
			NICE_LN01_CALL()
		else
			'신청되어있지 않으면 주식거래 신청 유도 메시지박스 팝업
			Form.MsgBox("안내", "해외주식 거래 신청 후\n해외주식 대출약정이 가능합니다", "REG_MOVE2", 7, "신청하러가기", "취소")
		end if
		g_bChangeAcnt = false
	elseif szTranID == "oblon_nice_001r" then
		tmpRSLT_CLS = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock1", "RSLT_CLS", 0)
		if tmpRSLT_CLS == "1" then
			g_NICE_TR_SRNO = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock2", "SDRC_SRNO", 0)
			g_Timer_TRY_CNT = 0
			
			Form.SetTimerEvent(1, 1, 1)
		elseif tmpRSLT_CLS == "0" or tmpRSLT_CLS == "3" then
			Form.SetTimerEvent(1, 0, 1)
			'contReg.btnNext.enable = true
			
			if DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock3", "PROS_ABLE_YN", 0) == "Y" then
				if g_PROS_CLS = "1" then
					'추가동작 없음
				else
					'Form.OpenFramePopup("mbonl82010_p9" , "", "")
					DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
				end if
			else
				contReg.btnNext.enable = False
				Dim szErrMsg
				Dim szSub
				szErrMsg = chr(34)&"여신거래 안심차단"&chr(34)&" 서비스 이용 중이므로,"&chr(10)&"대출거래가 제한됩니다."
				szSub = DATAMANAGER.GetDataMsgSubText( szTranID)

				Form.ShowAlert("알림", szErrMsg)
			end if
			
			Form.clearWaitCursor()
		end if
	'대출 고객정보 확인서 징구 여부 관련 조회
	elseif szTranID == "oblon_basc_103r" then
		Dim szCase
		szCase = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_YN" , 0 )
'		szCase = "4"
		select case szCase
		    case "Y"	'처리가능
			    '해외주식거래 신청 여부 조회
			    DATAMANAGER.RequestTranData( "obpds_srvc_423r_1" )
		    case "1"	'미등록
			    '고객정보확인서 등록하도록 화면 open
			    Form.MsgBox("안내", "신용공여 고객정보확인서 등록 후\n신청 가능합니다." , "kyc", 7, "등록하기", "취소")
		    case "2"	'고객정보 확인서 만기경과
			    Form.MsgBox("안내", "신용공여 고객정보확인서 만기가\n경과되었습니다.\n재등록 후 신청 가능합니다." , "kyc", 7, "등록하기", "취소")
		    case "3"	'대출약정을 위한 설문 미응답
			    Form.MsgBox("안내", "신용공여 고객정보확인서 설문 미응답 고객입니다.\n확인하시겠습니까?" , "kyc", 7,  "등록하기", "취소")
		    case "4"	'부적정확인서 발급필요
			    '20231207 개선요건에서는 별도의 얼럿 없이 바로 부적정확인서 팝업(확인필요)
'			    f_SetKycSharedData("mbonl93503")
'				Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
			    
			    Form.MsgBox("안내", "부적정확인서를 발급하여야 진행하실 수 있습니다." , "kyc_report", 7, "등록하기", "취소")
		end select
	
	'해외주식 대출약정 신청/해지
	elseif szTranID == "obpds_srvc_045a" then
		if g_szProcType == "I" then
			g_szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SVC_SRNO" , 0)
			
			'계약서류 교부처리
			DATAMANAGER.RequestTranData("obcsb_dbif_322a")
			
		elseif g_szProcType == "D" then
			g_nSelectRow = -1
			Form.MsgBox("안내", "해외주식 대출 약정\n취소가 완료되었습니다.", "CANCEL_COMPLETE", 7, "확인", "추가 해지하기")
		end if
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		'해외주식 대출약정 신청
		'DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
		g_PROS_CLS = "2"
		NICE_LN01_CALL()
	
	'계약서류 교부처리
	elseif szTranID == "obcsb_dbif_322a" then
		'여기까지 하고 완료 팝업 띄움
		Dim szSendData
		szSendData = contReg.acnt.caption .. "★" .. Form.GetSharedData("&HOST_DATE", false)
		
		Form.OpenPopup("mbonl88023_p1", szSendData , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'담보대출 미신청 계좌 예외처리
	if szTranID == "obpds_srvc_045a" and szErrCode == "1891" then
		Form.MsgBox("안내", "담보대출계좌 등록 후 약정이\n가능합니다.", "REG_MOVE3" , 7, "확인", "대출계좌신청")
		exit sub
	end if
	
	'
	if szTranID == "obpds_srvc_045a" and szErrCode == "3532" then
		Form.MsgBox("안내", "해외주식 외 다른 잔고(국내주식 등)\n보유시 약정이 불가합니다.", "CUST_CENTER", 7, "고객지원센터", "확인")
		exit sub
	end if
	
	if szTranID == "oblon_nice_001r" then
		Form.ShowAlert("알림", szMsgText)
		contReg.btnNext.enable = False
		exit Sub
	end if
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
Function f_ResetScreen()
	'고객정보 변수 초기화
'	g_szCsno = ""
	g_szCsnm = ""
	g_szCustClsCode = ""
	
	'금융상품가입일련번호, 서비스일련번호 초기화
	g_szFnprJoinSrno = ""
	g_szSvcSrno = ""
	
	'부적정 여부 초기화
	g_szAnxtAprt_Yn = ""
	
	'약관 동의 관련 초기화
	g_szAgree1 = "N"
	g_szAgree2 = "N"
	
	g_szPwd = ""
	g_szProcType = ""
	g_nSelectRow = -1
	
	contReg.lblBlock.visible = true
	contReg.imgChkAll.imgpath = "checkmenu_n"
	contReg.imgChk1.imgpath = "check_line_n"
	contReg.imgChk2.imgpath = "check_line_n"
	
	contReg.rdoCtcn.currentindex = "-1"
	
	'굳이 초기화 할 필요없을듯?
'	g_szPhoneNum = ""
'	g_szPhoneInagTypeCode = ""
'	g_szPhoneInagSrno = ""
'	g_szEmail = ""
'	g_szEmailInagTypeCode = ""
'	g_szEmailInagSrno = ""
	
	'계약서류 관련 초기화
	contReg.tblCtcn.visible = false
	contReg.lblCtcnInfo.visible = false
	contReg.imgCtcnInfo.visible = false
	
	'하단 신청하기 버튼 초기화
	contReg.btnNext.enable = False
	    
	if Form.GetEnvData("common.theme") = "black" then
		contReg.btnNext.btnimage = "btn_27.9"
	else
		contReg.btnNext.btnimage = "btn_21.9"
	end if
	contReg.btnNext.fgcolor = "269"
	
End Function 

'============================================================================
Function f_CheckNextEnable()
	'약관 2개 동의 + 계약서류 선택 여부 체크
	Dim bFlag
	bFlag = true
	
	if g_szAgree1 <> "Y" then
		bFlag = false
	end if
	if g_szAgree2 <> "Y" then
		bFlag = false
	end if
	if CInt(contReg.rdoCtcn.currentindex) == -1 then
		bFlag = false
	else
		if CInt(contReg.rdoCtcn.currentindex) == 0 then
			if g_szPhoneNum == "" or g_szPhoneNum == null then
				bFlag = false
			end if
		else
			if g_szEmail == "" or g_szEmail == null then
				bFlag = false
			end if
		end if
	end if
	
	'조건 체크하여 하단 신청버튼 활성화 처리
	if bFlag then
		contReg.btnNext.enable = true
		
		contReg.btnNext.btnimage = "btn_20.9"
		contReg.btnNext.fgcolor = "273"
	else
		contReg.btnNext.enable = False
	    
		if Form.GetEnvData("common.theme") = "black" then
			contReg.btnNext.btnimage = "btn_27.9"
		else
			contReg.btnNext.btnimage = "btn_21.9"
		end if
		contReg.btnNext.fgcolor = "269"
	end if
End Function

'============================================================================
Function f_ShowContainer(szCtlName)
	if szCtlName == "contList" then
		contList.visible = true
		contReg.visible = false
		
		'해외주식 대출약정 계좌 조회
		DATAMANAGER.RequestTranData( "oblon_basc_813r" )
		
	elseif szCtlName == "contReg" then
		contList.visible = false
		contReg.visible = true
	end if
End Function

'============================================================================
' setKycSharedData : 파일 오픈 공유데이터 설정 : 대출KYC : 2021.03.17
'============================================================================
Function f_SetKycSharedData(szFileName)
	'MTS 메모리평문 적용유무 (0:미적용 / 1:적용)
	szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS 메모리평문 적용
	if szPlainRm = "1" Then
		szPwd = Form.GetCtlProp( "EditPW", "caption" )	'비밀번호
	'MTS메모리평문 미적용
	else
		szPwd = Form.GetCtlProp( "EditPW", "encdata" )
	end if
	
	'개선 요건에서는 이 시점에서 계좌 비밀번호 가지고 있지 않음
	szPwd = ""
	
	Dim szData
	
	'대출 KYC MTS_메인
	if szFileName = "mbonl93500" then
		szAcno = contReg.acnt.total        '계좌번호
		szCsnm = g_szCsnm			    	'고객명
		szLoanTypeCode = "02"			'신용
		szData = szAcno & "||" & szPwd & "||" & szCsnm & "||" & g_szCustClsCode & "||" & szLoanTypeCode
		  
	'대출성 상품 적정성 판단 보고서(MTS)
	elseif szFileName = "mbonl93503" then
		'보고서는 Shared Memory로 통신한다.
		szAcno = contReg.acnt.total     '계좌번호
		szCsnm = g_szCsnm			    	'고객명
		szBswrdivcode = "17198"		'해외주식 대출약정'
		szLoanTypeCode = "02"			'신용
		Form.SetSharedData( "mbonl93503_acno" 	  		, szAcno )
		Form.SetSharedData( "mbonl93503_acnopwd" 		, szPwd )
		Form.SetSharedData( "mbonl93503_csnm"             , g_sCsnm )
		Form.SetSharedData( "mbonl93503_loan_type_code"   , szLoanTypeCode )
		Form.SetSharedData( "mbonl93503_bswr_div_code"    , szBswrdivcode )
		Form.SetSharedData( "mbonl93503_cont_cls_code"    , "4" )
	end if

	return szData
End Function

