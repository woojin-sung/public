Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "REFRESH" then
					
		DATAMANAGER.RequestTranData("obcpp_rbit_919r")
		DATAMANAGER.RequestTranData("obcpp_rbit_201r")

		
	end if
End Sub

'============================================================================

Function Simulation_On_Off(ror)
	temp = 0
	
	if ror > 0 then
		 Container0.Label29.visible = 0
		 Container0.Label29.enable = 0
		
		
	elseif  temp == Cint(g_goal_profit) then
	
		 Container0.Label29.visible = 1
		 Container0.Label29.enable = 1
		 Form.ShowAlert("알림","목표 자금이 0일경우 예상수익 시뮬레이션을 할 수 없습니다.")
	 
	 else 
	 	 Container0.Label29.visible = 1
		 Container0.Label29.enable = 1
		 Form.ShowAlert("알림","기대 수익률이 마이너스인 경우, 예상수익 시뮬레이션을 할 수 없습니다.")
		
	 end if

End Function 


