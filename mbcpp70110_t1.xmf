'===========================================================================
		Function Cal_grade(grade)
		
		
		
		if Cint(grade) = 1  then
				Container0.Label10.caption="초저위험"
				Container0.Label10.fgcolor  = "206" 	
			elseif Cint(grade)= 2 then
				Container0.Label10.caption="초저위험+"
				Container0.Label10.fgcolor  = "91" 	
			elseif Cint(grade)= 3 then
				Container0.Label10.caption="저위험"
			Container0.Label10.fgcolor  = "220" 	
			elseif Cint(grade)= 4 then
				Container0.Label10.caption="저위험+"
				Container0.Label10.fgcolor  = "84" 	
			elseif Cint(grade)= 5 then
				Container0.Label10.caption="중위험"
				Container0.Label10.fgcolor  = "8" 	
			elseif Cint(grade)= 6 then
				Container0.Label10.caption="중위험+"
				Container0.Label10.fgcolor  = "203" 	
			elseif Cint(grade)= 7 then
				Container0.Label10.caption="고위험"
				Container0.Label10.fgcolor  = "207" 	
			elseif Cint(grade)= 8 then
				Container0.Label10.caption="고위험+"
				Container0.Label10.fgcolor  = "101" 	
			elseif Cint(grade)= 9 then
				Container0.Label10.caption="초고위험"
				Container0.Label10.fgcolor  = "59" 	
			elseif Cint(grade)= 10 then
				Container0.Label10.caption="초고위험+"
				Container0.Label10.fgcolor  = "92" 	
			
			else 
			
			Container0.Label10.caption=grade
			Container0.Label10.fgcolor  = "2" 	
			end if

		
		
		End Function

'===========================================================================

Sub Form_OnFormInitBefore()
		
	g_u_id = Form.GetSharedData("&USER_ID", false )
	g_start_date=GetSharedData("&Host_Date",false)
	g_start_date=Cstr(g_start_date)
	g_start_date=Mid(g_start_date,3,4)
	
	
	
	g_g_u_id = Form.GetSharedData("DB_User_Id",false)
		
	
	g_pid = Form.GetSharedData("Shared_PID", false )
		
	g_pgrade = Cint(Form.GetSharedData("Shared_GRADE", false ))
	
	g_market_rate = 1.25
	g_kospi_rate = 2.3
	
	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_919r", "InBlock1", "CUST_ID" , 0 ,g_u_id) 	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_004r", "InBlock1", "PRTF_ID" , 0 ,g_pid) 	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_201r", "InBlock1", "INP_RISK_GRAD_CODE" , 0 ,g_pgrade)
		
	DATAMANAGER.RequestTranData("obcpp_rbit_919r")
	DATAMANAGER.RequestTranData("obcpp_rbit_201r")
		
	
	
	
End Sub

'============================================================================


Function Draw_Graph()

'============================================================================ 차트 초기화!
	Container0.ChartEx0.SetAccrueData("repaintall");
	
	Container0.ChartEx0.SetAccrueName("포트폴리오,기준금리,KOSPI")
	
	Container0.ChartEx0.SetAccrueData("period=5=YYMM")
	Container0.ChartEx0.SetChartType("compare")
	
	Container0.ChartEx0.SetAccrueData("initdata="&g_start_date)
	Container0.ChartEx0.SetAccrueData("changetitle=".."포트폴리오"..";".."기준금리"..";".."KOSPI")
	
	Container0.ChartEx0.SetAccrueData("자료일자="..g_start_date)
	Container0.ChartEx0.SetAccrueData("data1="..g_init_invest)
	Container0.ChartEx0.SetAccrueData("data2="..g_init_invest)
	Container0.ChartEx0.SetAccrueData("data3="..g_init_invest)
	Container0.ChartEx0.SetShowCrossLine("true")
	
	Container0.ChartEx0.SetAccrueData("repaintall");	
'	Container0.ChartEx0.SetPeriodType(2)   '0:틱, 1:분, 2:일자
				
'============================================================================
	sumdate = g_start_date
	temp_term = g_term
	
	suminvest = (g_init_invest+g_monthly_invest)*((g_expect_ror/100)/12+"1")
	suminvset_mr = (g_init_invest+g_monthly_invest)*((g_market_rate/100)/12+"1")
	suminvest_kp = (g_init_invest+g_monthly_invest)*((g_kospi_rate/100)/12+"1")
	
	
	sumdate= sumdate+1
	
	Container0.ChartEx0.setInvestorRealData("포트폴리오;기준금리;KOSPI="..g_start_date..";"..suminvest..";"..suminvset_mr..";"..suminvest_kp)	


	for i=0 to g_term-2
	
		if Right(sumdate,2) == "12" then
			ltemp = left(sumdate,2)+1
			rtemp = "01"
			sumdate = ltemp&rtemp
		else 	
			sumdate=sumdate+1
		end if 
	
		suminvest= (suminvest + g_monthly_invest)*((g_expect_ror/100)/12+"1")
		suminvset_mr = (suminvset_mr + g_monthly_invest)*((g_market_rate/100)/12+"1")
		suminvest_kp = (suminvest_kp + g_monthly_invest)*((g_kospi_rate/100)/12+"1")
		Container0.ChartEx0.setInvestorRealData("포트폴리오;기준금리;KOSPI="..sumdate..";"..suminvest..";"..suminvset_mr..";"..suminvest_kp)	
	next
		
			Container0.ChartEx0.setLineColor("포트폴리오;255;0;0")
			Container0.ChartEx0.setLineColor("기준금리;0;255;0")
			Container0.ChartEx0.setLineColor("KOSPI;0;0;255")
		
		
	g_expect_goal_term = sumdate
	g_expect_profit = suminvest

End Function


'============================================================================

Function Display_Probability()
		

	Container0.Label3.caption = "20"&Left(g_expect_goal_term,2)&"년 "&Right(g_expect_goal_term,2)&"월에 목표가 달성될 확률"
	Container0.Label32.caption = "20"&Left(g_expect_goal_term,2)&"/"&Right(g_expect_goal_term,2)
	Call Simulation_On_Off(g_expect_ror)	

	if  Cint(Cal_Plus_init_invest() )>0 then
						
		Container0.Label7.fgcolor = "2"
		Container0.Label7.caption = "낮음"
	
		Container0.Label8.caption="초기 자금"
		Container0.Label9.caption="추가"
		Container0.Label11.caption= "투자 기간"
		Container0.Label12.caption= "추가"
		Container0.Label17.caption= "월 납입 금액"
		Container0.Label18.caption= "추가"
				
		Container0.Label0.caption = (Cint(Cal_Plus_init_invest()))&" 만원"
		Container0.Label4.caption = (Cal_Plus_monthly_invest())&" 만원"
		Container0.Label1.caption = (Cint(Cal_Plus_term()))&" 개월"
		
		Form.Toast(1, "예상 수익 시뮬레이션 완료", 10000)
		Form.Toast(1, "목표 달성 확률이 낮습니다.", 10000)		
	else 
		Container0.Label7.fgcolor = "1"
		Container0.Label7.caption = "높음"
		Container0.Label0.caption = "-"
		Container0.Label1.caption = "-"
		Container0.Label4.caption = "-"
		Container0.Label8.caption = ""
		Container0.Label9.caption = ""
		Container0.Label11.caption = ""
		Container0.Label12.caption = ""
		Container0.Label17.caption = ""
		Container0.Label18.caption = ""
		
		Form.Toast(1, "예상 수익 시뮬레이션 완료", 10000)
		Form.Toast(1, "목표 달성 확률이 높습니다.", 10000)	
		
	end if
	
	if  g_expect_ror<0 then
		
		Container0.Label0.caption = "-"
		Container0.Label1.caption = "-"
		Container0.Label4.caption = "-"
		Container0.Label16.caption = "-"
		Container0.Label8.caption = ""
		Container0.Label9.caption = ""
		Container0.Label11.caption = ""
		Container0.Label12.caption = ""
		Container0.Label17.caption = ""
		Container0.Label18.caption = ""
		
	end if
	
	
End Function



'============================================================================

Function Cal_Plus_init_invest()
 
	 Cal_Plus_init_invest= g_goal_profit-g_expect_profit +1
	 
End Function

'============================================================================

Function Cal_Plus_monthly_invest() 
		temp =0
		
'		if Cint(g_monthly_invest) <> 0 then
'		
'			
'		
'		temp = Cint ((g_goal_profit / g_expect_profit) * g_monthly_invest)-g_monthly_invest +3
'		
'		
'		else 
'		
'		temp= Cint  (g_goal_profit / g_expect_profit) +2
'		
'		'Cint(PMT( g_expect_ror/12,g_term,g_init_invest,-g_expect_profit,0))-g_monthly_invest+1
'			
'		end if
			
		temp=Cint(PMT(g_expect_ror/12,g_term,g_init_invest,-g_goal_profit,1))-g_monthly_invest+1
		
		
			
		Cal_Plus_monthly_invest = temp
		
		
End Function



'============================================================================


Function PMT ( rate,  nper,  pv,   fv,  type1 )
 amt = 0;
		
		if rate ==0 then
				amt = (-pv -fv)/nper
		
		else 
				amt = (-fv* rate/100 - pv* rate/100 * Pow( 1+ rate/100,nper))/
				((1+rate/100*type1)*(Pow(1+rate/100,nper)-1))
	
			end if
		PMT = amt
		
End Function
'============================================================================

Function Change_nation ( code )
		temp = ""
		
		if code= "1" then
		temp = "국내"
		
		elseif code ="2" then
		temp = "해외"
		
		else 
		temp = code
		
		end if
		
		Change_nation = temp 


End Function

'===========================================================================

Function  Pow (x1, x2)

	 
	tr = 1.0
	
	for i=0 to x2-1
		
	tr=tr * x1	
		
	
	next
	
	Pow = tr
	
End Function
'===========================================================================

Function Cal_Plus_term() 
			
'	temp1= g_goal_profit
'	temp2= g_expect_profit
'	
'	temp1=Clng(temp1)
'	temp2=Clng(temp2)
'		
'	i=0
'	
'	Do 
'		i=i+1
'		temp2 = (temp2+ g_monthly_invest) * (g_expect_ror/12/100+"1") 
'
'	Loop Until temp2 >= temp1	


	
	
	Cal_Plus_term =NPER(g_expect_ror/12,g_monthly_invest,g_init_invest,-g_goal_profit,1) - g_term+1
	
	
	
	
	
End Function

'============================================================================

Function NPER	(rate, pmt, pv, fv, type1)

		if rate == 0 then
			amt = (-pv -fv )/pmt
		else
			amt	= Log((pmt*(1+rate/100*type1)-fv*rate/100)/(pv*rate/100+pmt*(1+rate/100*type1)))
						/Log(1+rate/100)
		end if
	NPER = amt

End Function 

