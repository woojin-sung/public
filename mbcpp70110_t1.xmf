'============================================================================

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	if szTranID ==  "obcpp_rbit_919a"	then
		
		
		DATAMANAGER.RequestTranData("obcpp_rbit_919r")
		
			

	elseif szTranID ==  "obcpp_rbit_919r" then

		g_g_u_id = DATAMANAGER.GetDataValue(0, "obcpp_rbit_919r", "OutBlock1", "CUST_ID",0)
		g_init_invest = Cint(DATAMANAGER.GetDataValue(0,"obcpp_rbit_919r", "OutBlock1", "FRST_CNRC_AMT" ,0))
		g_monthly_invest = Cint(DATAMANAGER.GetDataValue(0,"obcpp_rbit_919r", "OutBlock1", "SPLM_INVT_AMT" ,0))
		g_term = Cint(DATAMANAGER.GetDataValue(0,"obcpp_rbit_919r", "OutBlock1", "ANTC_INVT_PRD" ,0))
		g_goal_profit = Cint(DATAMANAGER.GetDataValue(0,"obcpp_rbit_919r", "OutBlock1", "GOAL_AMT" ,0))
			
		
		Form.SetSharedData("Init_Capital", g_init_invest)
		Form.SetSharedData("Monthly_Capital", g_monthly_invest)
		Form.SetSharedData("Invest_Term", g_term)
		Form.SetSharedData("Goal_Amt", g_goal_profit)
		
		
		if g_g_u_id <> g_u_id then 
		
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "CUST_ID", 0 , g_u_id)               
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "USE_YN", 0 , "y")
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "TOTAL_CSNU", 0 , Form.GetSharedData("User_Grade_Score", false ))     
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INCL_GRAD_CODE", 0 , 	Form.GetSharedData("User_Grade_Code", false ))
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "FRST_CNRC_AMT", 0 , 5000)     
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "SPLM_INVT_AMT", 0 , 100)     
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "AGE", 0 , Form.GetSharedData("Age_Value",false))               
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "ANTC_INVT_PRD", 0 ,6)     
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_DVPD_INVT_EXPC", 0 , Form.GetSharedData("Exp_Value",false))
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INVT_KNLD", 0 , Form.GetSharedData("Know_Value",false))     
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "GOAL_AMT" ,0 , 10000)          
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_SCHL_REVN_YN", 0 , Form.GetSharedData("Regular_Earn_Value",false))
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "PROS_CLS_CODE", 0 , "i")
		
		DATAMANAGER.RequestTranData("obcpp_rbit_919a")
		
				
		end if
		
		
				
		DATAMANAGER.RequestTranData("obcpp_rbit_004r")	
		
		
	elseif szTranID ==  "obcpp_rbit_004r" then
	
		g_expect_ror=CDbl(DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "ERT" ,0))
		
		
		
		g_pp_name=DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "PRTF_NAME" ,0)
		Form.PostLinkData("PRTF_NAME", g_pp_name)
		
				
		Form.SetSharedData("Shared_CID", DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "OUTS_INVT_ADCP_CODE" ,0))
		Container0.Label15.caption= g_goal_profit&" 만원"
		
		
		Form.SetSharedData("Shared_PNAME", g_pp_name)
		Call Cal_grade(g_pgrade)
		
		Container0.Label8.caption="초기 자금"
		Container0.Label9.caption="추가"
		Container0.Label11.caption= "투자 기간"
		Container0.Label12.caption= "추가"
		Container0.Label17.caption= "월 납입 금액"
		Container0.Label18.caption= "추가"
		Container0.Label6.caption= "기대수익률"
		Container0.Label13.caption= "요구수익률"
		Container0.Label14.caption= "목표 금액"
		Container0.Label19.caption= "등급의 또 다른 상품을 보고 싶다면?"		
		
		Call Draw_Graph()
		
		g_request_ror=(g_goal_profit / g_expect_profit )*(g_expect_ror)	
		Container0.Label16.caption=  g_request_ror
		Container0.Label5.caption=g_expect_ror
		
				if CDbl(Container0.Label16.caption )> Cint(g_expect_ror) then
				
				Container0.Label16.fgcolor = "2"
				Container0.Label5.fgcolor  = "1" 
		
				else 
				Container0.Label16.fgcolor = "1"
				Container0.Label5.fgcolor  = "2" 
				end if
		
		Call Display_Probability()
		
		Form.SetSharedData("Shared_PID", DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "PRTF_ID" ,0))
		
	elseif szTranID ==  "obcpp_rbit_201r" then
		
		
		Container0.Label20.caption=Change_nation(DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r" , "OutBlock1" , "NTNL_GR_LCTN_CLCD" , 0))
		Container0.Label21.caption= Change_nation(DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r" , "OutBlock1" , "NTNL_GR_LCTN_CLCD" , 1))
		Container0.Label22.caption= Change_nation(DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r" , "OutBlock1" , "NTNL_GR_LCTN_CLCD" , 2))
		
		
		Container0.Label23.caption=DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r" , "OutBlock1" , "ERT" , 0)
		Container0.Label24.caption= DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r" , "OutBlock1" , "ERT" , 1)
		Container0.Label26.caption= DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r" , "OutBlock1" , "ERT" , 2)
		Form.SetSharedData("Shared_PID",g_pid)		
	end if
			
		
End Sub

