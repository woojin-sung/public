' 종목검색창 호출 명령 들어올 경우
'============================================================================
Sub Form_OnOpenSearchDialog()
	Form.OpenPopup( "ItemSearchOverStock" , "" , "I" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 				, 0 	, acnt.total )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO"				, 0 	, acnt.sequence )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD"				, 0 	, "082" )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO"				, 0 	, "" )
	
	'20240710 SWJ START : 주석 처리
	'20200827 LES START 애플/테슬라 액면분할 관련 고객유의사항
'	elseif szTranID == "obtro_acnt_900r" then
'	
'		szCustNum = Form.GetSharedData("&CUST_NUM", false)
'	
'		DATAMANAGER.SetDataValue(0, "obtro_acnt_900r", "InBlock1", "BSWR_CLCD" 			, 0 , "09") '20220531 SWJ : AMZN 종목
'		DATAMANAGER.SetDataValue(0, "obtro_acnt_900r", "InBlock1", "CSNO" 				, 0 , szCustNum)
'		
	'20200827 LES END
	'20240710 SWJ END
	
	elseif szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_002r" then

		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( ItemCode0.code, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1])
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0])
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay)

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_323r" then
		szYakCd = DATAMANAGER.GetDataMsgCode(szTranID)
		
		if szYakCd <> "5766" then
			Form.MsgBox("약정신청안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 1)
		else
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
			
			'20220720 SWJ START : GME 권리분할
			'20220713 SWJ START : GOOG, GOOGL 권리분할
			szToday = Form.GetSharedData("&HOST_DATE", false )
			
'			if tonumber(szToday) >= 20220718 and tonumber(szToday) <= 20220721 then
'				g_RightPop = "05"
'				DATAMANAGER.RequestTranData("obtro_acnt_900r")
'				
'			elseif tonumber(szToday) >= 20220722 and tonumber(szToday) <= 20220728 then
'				g_RightPop = "06"
'				DATAMANAGER.RequestTranData("obtro_acnt_900r")
'			end if
			
			'20220822 SWJ START
			if tonumber(szToday) >= 20240610 and tonumber(szToday) <= 20240614 then
				DATAMANAGER.RequestTranData("obtro_acnt_900r")
			end if
			'20220713 SWJ END
			'20220720 SWJ END
			'20220822 SWJ END
		end if
		
	'20200827 LES START 애플/테슬라 액면분할 관련 고객유의사항
	elseif szTranID == "obtro_acnt_900r" then
	
		'애플/테슬라 잔고보유 고객한테만 유의사항 팝업 띄어줌.
		agreeYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "AGRM_YN" 		, 0)
		jangoYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "RMND_EXST_YN" 	, 0)
		
		if jangoYn = "Y" then
			if agreeYn = "N" then
				
				'20220822 SWJ START
				'20220719 SWJ START
				'if g_RightPop = "05" then
					Form.OpenPopup("mhtro16060_p9" , "" , "")
				'elseif g_RightPop = "06" then
				'	Form.OpenPopup("mhtro16060_p14" , "" , "")
				'end if 
				'20220719 SWJ END
				'20220822 SWJ END
				
				'20240710 SWJ START
				'로그인 후 한번 뜨면 안떠도 됨
				Form.SetSharedData("AbroadAgreement_PopupYN", "N")
				'20240710 SWJ END
			else
				DATAMANAGER.RequestTranData("obpds_srvc_323r")	'20240710 SWJ START
			end if
		else
			DATAMANAGER.RequestTranData("obpds_srvc_323r")	'20240710 SWJ START
		end if
		
	'20200827 LES END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obpds_srvc_323r" then
		szYakCd = DATAMANAGER.GetDataMsgCode(szTranID)
		
		if szYakCd <> "5766" then
			Form.MsgBox("약정신청안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 1)
		else
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )	
		end if
	end if
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwd.caption = ""
		edtPwdIcon.imgpath = "icon_save_password_n.9"
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	edtOrgNo.caption = ""
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
End Sub
