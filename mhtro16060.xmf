Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG" then
		if sRet == "ok" then
			Form.OpenScreen("87051" , "")
		end if
	end if
End Sub

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
    '20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END
	
	'20240710 SWJ START
	'해외주식 권리선반영 팝업
	'이제 주문화면 배포 안해도 됨
	nStartDate = Cint(Form.LoadConfigData("NoticeSetting", "AbroadAgreement_StartDate"))
	nEndDate = Cint(Form.LoadConfigData("NoticeSetting", "AbroadAgreement_EndDate"))
	sBswrClcd = Form.LoadConfigData("NoticeSetting", "AbroadAgreement_BswrClcd")
			
	nToday = Cint(Form.GetSharedData("&HOST_DATE", false))
			
	if nToday >= nStartDate and nToday <= nEndDate then
		sCustCSNO = Form.GetSharedData("&CUST_NUM", false)
				
		sPopupYN = Form.GetSharedData( "AbroadAgreement_PopupYN" , false)
				
		if sPopupYN == "Y" then
			DATAMANAGER.SetDataValue( 0 , "obtro_acnt_900r", "InBlock1", "CSNO" , 0 , sCustCSNO )	
			DATAMANAGER.SetDataValue( 0 , "obtro_acnt_900r", "InBlock1", "BSWR_CLCD" , 0 , sBswrClcd )	
			DATAMANAGER.RequestTranData( "obtro_acnt_900r" )
		else
			DATAMANAGER.RequestTranData("obpds_srvc_323r")	'20240710 SWJ START
		end if
	else
		DATAMANAGER.RequestTranData("obpds_srvc_323r")	'20240710 SWJ START
	end if
	'20240710 SWJ END
	
	'20201111 SWJ START : 프리마켓 유의사항 팝업 게시
'	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
'    if szMediaCode = "156" or szMediaCode = "157" then
'    
'		bPopYN = Form.GetEnvData("PreMarket")
'		
'		if bPopYN == "" or bPopYN == "0" then
'			Form.OpenPopup("mhtro16060_p9" , "" , "")
'		end if
'	end if
	'20201111 SWJ END

end function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "ITEMINFO_POP_CLOSE" then
		Image0.visible = true
	
	'20200827 LES START 애플/테슬라 액면분할 관련 고객유의사항
	elseif sKeyName == "16060_p9" then
		
		'20240710 SWJ START
		'권리선반영 팝업 이후 약정 체크
'		if sRet == "cancel" then
'			szPrevScr = Form.GetSharedData("&PREV_SCREEN_NO", false )
'			
'			if szPrevScr == "" or szPrevScr == nil or szPrevScr == "16060" then
'				szPrevScr = "41000"
'			end if
'			
'			Form.OpenScreen(szPrevScr , "")
'		end if
		
		DATAMANAGER.RequestTranData("obpds_srvc_323r")	'20240710 SWJ START
		'20240710 SWJ END
		
	'20200827 LES END
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
	end if
End Sub

