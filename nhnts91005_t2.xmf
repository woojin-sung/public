'============================================================================
Sub Form_OnFormInit()
	G_ORDERQTY_FILE = "nhnts91005_p1"
	g_sFileName = "SET_ORDER" 
	g_sPwdKey = "order.save_orderpwd" 
	g_sConfirmKey = "OPEN_CONFIRM" 
'	g_sMarketKey = "BTN_MARKET" 
	g_sAfterInitKey = "AFERTORD_INIT" 
	g_sChangeInitKey = "CHANGE_INIT" 
	g_sAutoNoKey = "AUTO_ORGNO" 
	g_sStockBuyPrcKey = "AUTO_STOCK_BUYPRC" 
	g_sStockSelPrcKey = "AUTO_STOCK_SELPRC" 
	g_sStockModPrcKey = "AUTO_STOCK_MODPRC" 
	g_sStockBuyQtyKey = "AUTO_STOCK_BUYQTY" 
	g_sStockSelQtyKey = "AUTO_STOCK_SELQTY" 
	g_sFutOptBuyPrcKey = "AUTO_FUTOPT_BUYPRC" 
	g_sFutOptSelPrcKey = "AUTO_FUTOPT_SELPRC" 
	g_sFutOptModPrcKey = "AUTO_FUTOPT_MODPRC" 
	g_sFutOptBuyQtyKey = "AUTO_FUTOPT_BUYQTY" 
	g_sFutOptSelQtyKey = "AUTO_FUTOPT_SELQTY" 
	
	GetConfigData(g_sFileName, g_sPwdKey, 1, 1)
	GetConfigData(g_sFileName, g_sConfirmKey, 2, 1)
'	GetConfigData(g_sFileName, g_sMarketKey, 3, 1)
	GetConfigData(g_sFileName, g_sAfterInitKey, 5, 1)
	GetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
	GetConfigData(g_sFileName, g_sAutoNoKey, 7, 1)
	GetConfigData(g_sFileName, g_sStockBuyQtyKey, 12, 1)
	GetConfigData(g_sFileName, g_sStockSelQtyKey, 13, 1)
	GetConfigData(g_sFileName, g_sFutOptBuyQtyKey, 18, 1)
	GetConfigData(g_sFileName, g_sFutOptSelQtyKey, 19, 1)
	
	GetConfigData1(g_sFileName, g_sStockBuyPrcKey, "Cont0.Combo0", "cbkeydata")
	GetConfigData1(g_sFileName, g_sStockSelPrcKey, "Cont0.Combo1", "cbkeydata")
	GetConfigData1(g_sFileName, g_sStockModPrcKey, "Cont0.Combo2", "cbkeydata")
	GetConfigData1(g_sFileName, g_sFutOptBuyPrcKey, "Cont0.Combo3", "cbkeydata")
	GetConfigData1(g_sFileName, g_sFutOptSelPrcKey, "Cont0.Combo4", "cbkeydata")
	GetConfigData1(g_sFileName, g_sFutOptModPrcKey, "Cont0.Combo5", "cbkeydata")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "clear" then
		if sRet == "ok" then
			SetInitData()
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'20180824 LES START
	'주식/선물 매수수량 자동입력 세팅시 팝업 리턴

	if sKeyName == G_ORDERQTY_FILE then
		if sRet == g_sStockBuyQtyKey then
			GetConfigData(g_sFileName, g_sStockBuyQtyKey, 12, 1)
			
			'20180824 LES START
			Change_changeInitKey("Cont0.Table0", 12)
			
		elseif sRet == g_sStockSelQtyKey then
			GetConfigData(g_sFileName, g_sStockSelQtyKey, 13, 1)
			
			'20180824 LES START
			Change_changeInitKey("Cont0.Table0", 13)
			
		elseif sRet == g_sFutOptBuyQtyKey then
			GetConfigData(g_sFileName, g_sFutOptBuyQtyKey, 18, 1)
			
			'20180824 LES START
			Change_changeInitKey("Cont0.Table0", 18)
			
		elseif sRet == g_sFutOptSelQtyKey then
			GetConfigData(g_sFileName, g_sFutOptSelQtyKey, 19, 1)
			
			'20180824 LES START
			Change_changeInitKey("Cont0.Table0", 19)
			
		end if
	end if
End Sub

'============================================================================
Sub Cont0_Table0_OnClick(lRow , lColumn)
	'색상있는 영역 클릭시에만 이벤트 처리
	If lColumn > 0 Then
		if lRow == 1 then '계좌비밀번호저장
			'20200331 HWG START : 고유MTS
'			SetConfigData(g_sFileName, g_sPwdKey, 1, 1)
'			GetConfigData(g_sFileName, g_sPwdKey, 1, 1)
			'20200331 HWG END
		elseif lRow == 2 then '주문입력확인창사용
			SetConfigData(g_sFileName, g_sConfirmKey, 2, 1)
			GetConfigData(g_sFileName, g_sConfirmKey, 2, 1)
	'	elseif lRow == 3 then '시장가주문버튼이용
	'		SetConfigData(g_sFileName, g_sMarketKey, 3, 1)
	'		GetConfigData(g_sFileName, g_sMarketKey, 3, 1)
		elseif lRow == 5 then '주문전송후초기화
			SetConfigData(g_sFileName, g_sAfterInitKey, 5, 1)
			GetConfigData(g_sFileName, g_sAfterInitKey, 5, 1)
		elseif lRow == 6 then '종목/탭변경시초기화
			SetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
			GetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
		elseif lColumn == 0 and (lRow == 6 or lRow == 7) then '종목/탭변경시초기화
			SetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
			GetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
		elseif lRow == 7 then '원주문번호자동입력
			SetConfigData(g_sFileName, g_sAutoNoKey, 7, 1)
			GetConfigData(g_sFileName, g_sAutoNoKey, 7, 1)
		elseif lColumn == 0 and (lRow == 8 or lRow == 9) then '원주문번호자동입력
			SetConfigData(g_sFileName, g_sAutoNoKey, 7, 1)
			GetConfigData(g_sFileName, g_sAutoNoKey, 7, 1)
		elseif lRow == 12 then '매수수량 자동입력-주식
			Form.OpenPopup(G_ORDERQTY_FILE , g_sStockBuyQtyKey, "")
		elseif lRow == 13 then '매도수량 자동입력-주식
			Form.OpenPopup(G_ORDERQTY_FILE , g_sStockSelQtyKey, "")
		elseif lRow == 18 then '매수수량 자동입력-선물옵션
			Form.OpenPopup(G_ORDERQTY_FILE , g_sFutOptBuyQtyKey, "")
		elseif lRow == 19 then '매도수량 자동입력-선물옵션
			Form.OpenPopup(G_ORDERQTY_FILE , g_sFutOptSelQtyKey, "")
		end if
	End If
End Sub

