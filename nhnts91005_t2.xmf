'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_주문
' 03. 작    성 : 2016.02.16 김보라
'
' Form, Cont 375 X 522
'
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sFileName '파일명
Dim g_sPwdKey '계좌비밀번호저장키
Dim g_sConfirmKey '주문입력확인창사용키
'2016.02.29 시장가주문버튼삭제
'Dim g_sMarketKey '시장가주문버튼사용키
Dim g_sAfterInitKey '주문전송후초기화키
Dim g_sChangeInitKey '종목/탭변경시초기화키
Dim g_sAutoNoKey '원주문번호자동입력키
Dim g_sStockBuyPrcKey '매수주문가격자동입력-주식키
Dim g_sStockSelPrcKey '매도주문가격자동입력-주식키
Dim g_sStockModPrcKey '정정주문가격자동입력-주식키
Dim g_sStockBuyQtyKey '매수수량자동입력-주식키
Dim g_sStockSelQtyKey '매도수량자동입력-주식키
Dim g_sFutOptBuyPrcKey '매수주문가격자동입력-선물옵션키
Dim g_sFutOptSelPrcKey '매도주문가격자동입력-선물옵션키
Dim g_sFutOptModPrcKey '정정주문가격자동입력-선물옵션키
Dim g_sFutOptBuyQtyKey '매수수량자동입력-선물옵션키
Dim g_sFutOptSelQtyKey '매도수량자동입력-선물옵션키
Dim G_ORDERQTY_FILE '수량자동입력팝업

Dim g_OtherCtlPropAllZero

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 환경설정초기화함수
'============================================================================
Function SetInitData()
	'계좌비밀번호저장 - Off
	'주문입력확인창사용 - On
	'시장가주문버튼이용 - Off
	'주문전송후초기화 - On
	'종목/탭변경시초기화 - On
	'원주문번호자동입력 - On
	'매수주문가격자동입력-주식/선물옵션 - 사용하지않음
	'매도주문가격자동입력-주식/선물옵션 - 사용하지않음
	'정정주문가격자동입력-주식/선물옵션 - 사용하지않음
	'매수수량자동입력-주식/선물옵션 - 사용하지않음
	'매도수량자동입력-주식/선물옵션 - 사용하지않음
	
	'Cont0.Table0.SetCellString( 1, 1, "미사용" ) '20200331 HWG : 고유MTS
	Cont0.Table0.SetCellString( 2, 1, "사용" )
'	Cont0.Table0.SetCellString( 3, 1, "미사용" )
	Cont0.Table0.SetCellString( 5, 1, "사용" )
	Cont0.Table0.SetCellString( 6, 1, "사용" )
	Cont0.Table0.SetCellString( 7, 1, "사용" )
	Cont0.Table0.SetCellString( 12, 1, "미사용" )
	Cont0.Table0.SetCellString( 13, 1, "미사용" )
	Cont0.Table0.SetCellString( 18, 1, "미사용" )
	Cont0.Table0.SetCellString( 19, 1, "미사용" )
	
	SetFgColor(1, 1)
	SetFgColor(2, 1)
'	SetFgColor(3, 1)
	SetFgColor(5, 1)
	SetFgColor(6, 1)
	SetFgColor(7, 1)
	SetFgColor(12, 1)
	SetFgColor(13, 1)
	SetFgColor(18, 1)
	SetFgColor(19, 1)
	
	Form.SetEnvData(1, g_sFileName, "0") 					'SetConfigData(g_sFileName, g_sPwdKey, 1, 1)	
	Form.SaveConfigData( g_sFileName, g_sConfirmKey, "1" )		'SetConfigData(g_sFileName, g_sConfirmKey, 2, 1)
'	SetConfigData(g_sFileName, g_sMarketKey, 3, 1)
	Form.SaveConfigData( g_sFileName, g_sAfterInitKey, "1" )		'SetConfigData(g_sFileName, g_sAfterInitKey, 5, 1)
	Form.SaveConfigData( g_sFileName, g_sChangeInitKey, "1" )	'SetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
	Form.SaveConfigData( g_sFileName, g_sAutoNoKey, "1" )		'SetConfigData(g_sFileName, g_sAutoNoKey, 7, 1)

' g_sCertScreenKey, g_sCertScreenKey, g_sSideChangeKey, g_sTickerKey 값이 없어서 IOS에서 죽어서 막음
'	Form.SaveConfigData( g_sFileName, g_sScreenKey, "0" )		'SetConfigData(g_sFileName, g_sScreenKey, 12, 1)
'	Form.SaveConfigData( g_sFileName, g_sCertScreenKey, "0" )	'SetConfigData(g_sFileName, g_sCertScreenKey, 13, 1)
'	Form.SaveConfigData( g_sFileName,  g_sSideChangeKey, "0" )	'SetConfigData(g_sFileName, g_sSideChangeKey, 18, 1)
'	Form.SaveConfigData( g_sFileName,  g_sTickerKey, "0" )	'SetConfigData(g_sFileName, g_sTickerKey, 19, 1)
	
	Cont0.Combo0.cbkeydata = "0"
	Cont0.Combo1.cbkeydata = "0"
	Cont0.Combo2.cbkeydata = "0"
	Cont0.Combo3.cbkeydata = "0"
	Cont0.Combo4.cbkeydata = "0"
	Cont0.Combo5.cbkeydata = "0"
	
	SetConfigData1( g_sFileName, g_sStockBuyPrcKey, "Cont0.Combo0", "cbkeydata" )
	SetConfigData1( g_sFileName, g_sStockSelPrcKey, "Cont0.Combo1", "cbkeydata" )
	SetConfigData1( g_sFileName, g_sStockModPrcKey, "Cont0.Combo2", "cbkeydata" )
	SetConfigData1( g_sFileName, g_sFutOptBuyPrcKey, "Cont0.Combo3", "cbkeydata" )
	SetConfigData1( g_sFileName, g_sFutOptSelPrcKey, "Cont0.Combo4", "cbkeydata" )
	SetConfigData1( g_sFileName, g_sFutOptModPrcKey, "Cont0.Combo5", "cbkeydata" )
	
	Form.SaveConfigData( g_sFileName, g_sStockBuyQtyKey, "0" )
	Form.SaveConfigData( g_sFileName, g_sStockSelQtyKey, "0" )
	Form.SaveConfigData( g_sFileName, g_sFutOptBuyQtyKey, "0" )
	Form.SaveConfigData( g_sFileName, g_sFutOptSelQtyKey, "0" )
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sFileName, sKey, nRow, nCol)
	Dim sValue
	if sKey == g_sPwdKey then
		sValue = Form.GetEnvData(sKey)
	else
		sValue = Form.LoadConfigData(sFileName, sKey)
	end if

	if sValue == null or Trim(sValue) == "" then
		if sKey == g_sPwdKey then
			sValue = "0" '기본값 Off
'		else sKey == g_sMarketKey then
'			sValue = "0" '기본값 Off
		elseif sKey == g_sConfirmKey or sKey == g_sAfterInitKey or sKey == g_sAutoNoKey or sKey == g_sChangeInitKey then
			sValue = "1" '기본값 On
		else
			sValue = "0" '기본값 Off
		end if
	end if
	
	if sKey == g_sStockBuyQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "현금가능수량"
		elseif sValue == "2" then
			sValue = "최대가능수량"
		else
			sValue = "수량입력"
		end if
	elseif sKey == g_sStockSelQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "보유잔고수량"
		else
			sValue = "수량입력"
		end if
	elseif sKey == g_sFutOptBuyQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "신규가능수량"
		elseif sValue == "2" then
			sValue = "청산가능수량"
		else
			sValue = "수량입력"
		end if
	elseif sKey == g_sFutOptSelQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "신규가능수량"
		elseif sValue == "2" then
			sValue = "청산가능수량"
		else
			sValue = "수량입력"
		end if
	else
		if sValue == "1" then 'On
			sValue = "사용"
		else 'Off
			sValue = "미사용"
		end if
	end if
	
	'20200331 HWG START : 고유MTS
	if toNumber(nRow) <> 1 then
		Cont0.Table0.SetCellString( nRow, nCol, sValue )
	end if
	'20200331 HWG END
	
	if sValue == "미사용" then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
	else
		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
	end if
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData1(sFileName, sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.LoadConfigData(sFileName, sKey)

	if sValue == null or Trim(sValue) == "" then
		sValue = "0" '기본값 사용하지않음
	end if
	
	Form.SetCtlProp( sCtlName, sPropName, sValue )
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sFileName, sKey, nRow, nCol)
	
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sValue == "사용" then
		sValue = "0"
	else
		sValue = "1"
	end if
	
	if sKey == g_sPwdKey then
		Form.SetEnvData(1, sKey, sValue)
	else
		Form.SaveConfigData( sFileName, sKey, sValue )
	end if
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData1(sFileName, sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.GetCtlProp( sCtlName, sPropName )
	
	Form.SaveConfigData( sFileName, sKey, sValue )
End Function 

'============================================================================
' 글자색상함수
'============================================================================
Function SetFgColor(nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sValue == "미사용" then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
	else
		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
	end if
End Function 

