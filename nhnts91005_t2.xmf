'20180824 LES START
'기존 : 가격/수량 자동입력 사용시에도 [종목/탭 변경시 초기화] 설정을 사용으로 설정시 자동입력이 되지않음.
'변경 : 가격/수량 자동입력 사용시에 [종목/탭 변경시 초기화] 설정을 미사용으로 자동변경
'===============================================================================
' 주식/선물- 주문가격/수량 자동입력 설정에 따른 [종목/탭 변경시 초기화]설정 변경
'===============================================================================
Sub Change_changeInitKey(sCtlName, sPropName)
	Select Case sCtlName
		
		'가격 자동입력의 경우 컨트롤 이름으로 
		'구분이 가능함으로 sPropName 속성값이 넘어온다.
		Case "Cont0.Combo0", "Cont0.Combo1", "Cont0.Combo2", "Cont0.Combo3", "Cont0.Combo4", "Cont0.Combo5"
			szValue = Form.GetCtlProp(sCtlName, sPropName)
			
			'주문가격 입력이 미사용이 아닐때
			if szValue <> 0 then
			
					OtherCtlPropAllZero()
					if g_OtherCtlPropAllZero <> true then
						'[종목/탭 변경시 초기화] 설정을 자동으로 미사용으로 변경해준다
						Cont0.Table0.SetCellString(6, 1, "미사용")
						Cont0.Table0.SetCellFgColor(6, 1, 4)
						Form.SaveConfigData( g_sFileName, g_sChangeInitKey, "0" )
						
						'SetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
						'GetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
					else
						Cont0.Table0.SetCellString(6, 1, "사용")
						Cont0.Table0.SetCellFgColor(6, 1, 128)
						Form.SaveConfigData( g_sFileName, g_sChangeInitKey, "1" )
					end if
				
				
			end if	
		
		
		'수량 자동입력의 경우 행을 구분하기위해
		'sPropName에 어떤 설정값인지 넘어온다.
		Case "Cont0.Table0"
		
			szValue = Cont0.Table0.GetCellString(sPropName, 1) 
			
			'if szValue <> "미사용" then
				'[종목/탭 변경시 초기화] 설정을 자동으로 미사용으로 변경해준다
				
				OtherCtlPropAllZero()
				if g_OtherCtlPropAllZero <> true then
					'[종목/탭 변경시 초기화] 설정을 자동으로 미사용으로 변경해준다
					Cont0.Table0.SetCellString(6, 1, "미사용")
					Cont0.Table0.SetCellFgColor(6, 1, 4)
					Form.SaveConfigData( g_sFileName, g_sChangeInitKey, "0" )
					
				else
					
					Cont0.Table0.SetCellString(6, 1, "사용")
					Cont0.Table0.SetCellFgColor(6, 1, 128)
					Form.SaveConfigData( g_sFileName, g_sChangeInitKey, "1" )
				
				end if
				
			
			'else
			
				'OtherCtlPropAllZero()
				
				
				
				'SetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
				'GetConfigData(g_sFileName, g_sChangeInitKey, 6, 1)
			'end if
	
				
	End Select
		
		
	
End Sub
'===============================================================================
Sub OtherCtlPropAllZero()
	
	g_OtherCtlPropAllZero = true
	
	for i = 0 to 5
	 
		szData = Form.GetCtlProp("Cont0.Combo"&Cstr(i), "cbkeydata")
	     
		if szData <> "0" then
			g_OtherCtlPropAllZero =  false
		end if
	
	next
	
	
	if Cont0.Table0.GetCellString(12, 1) <> "미사용" then
		'Form.ShowAlert("(12, 1)", "")
		g_OtherCtlPropAllZero =false
	
	elseif Cont0.Table0.GetCellString(13, 1) <> "미사용" then
		'Form.ShowAlert("(13, 1)", "")
		g_OtherCtlPropAllZero =false
	elseif Cont0.Table0.GetCellString(18, 1) <> "미사용" then
		'Form.ShowAlert("(18, 1)", "")
		g_OtherCtlPropAllZero =false
	
	elseif Cont0.Table0.GetCellString(19, 1) <> "미사용" then
		'Form.ShowAlert("(19, 1)", "")
		g_OtherCtlPropAllZero =false
	end if
	
	

End Sub




