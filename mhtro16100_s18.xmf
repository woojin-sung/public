	<SCRIPT_INFO _len="5115" _ulen="4823" >
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()
	
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	LabelData0.paddinginfo = "0,0,0,0"
	LabelData1.paddinginfo = "0,0,0,0"
	LabelData2.paddinginfo = "0,0,0,0"
	LabelData3.paddinginfo = "0,0,0,0"
	LabelData4.paddinginfo = "0,0,0,0"
	LabelData5.paddinginfo = "0,0,0,0"
	LabelData6.paddinginfo = "0,0,0,0"
	LabelData7.paddinginfo = "0,0,0,0"
	LabelData8.paddinginfo = "0,0,0,0"
	LabelData9.paddinginfo = "0,0,0,0"
	LabelData10.paddinginfo = "0,0,0,0"
	LabelData11.paddinginfo = "0,0,0,0"
	LabelData12.paddinginfo = "0,0,0,0"
	LabelData13.paddinginfo = "0,0,0,0"
	LabelData14.paddinginfo = "0,0,0,0"
	LabelData15.paddinginfo = "0,0,0,0"
	
	LabelData4.transmode = "1"
	LabelData5.transmode = "1"
	LabelData6.transmode = "1"
	LabelData7.transmode = "1"
	LabelData8.transmode = "1"
	LabelData9.transmode = "1"
	LabelData10.transmode = "1"
	LabelData11.transmode = "1"
	LabelData12.transmode = "1"
	LabelData13.transmode = "1"
	LabelData14.transmode = "1"
	LabelData15.transmode = "1"
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
	end if
	
	'--------------------------------------------------------------
	'텍스트 크기 설정
	'--------------------------------------------------------------
	ChangeTextSize("LabelData0")
	ChangeTextSize("LabelData1")
	ChangeTextSize("LabelData2")
	ChangeTextSize("LabelData3")
	ChangeTextSize("LabelData4")
	ChangeTextSize("LabelData5")
	ChangeTextSize("LabelData6")
	ChangeTextSize("LabelData7")
	ChangeTextSize("LabelData8")
	ChangeTextSize("LabelData9")
	ChangeTextSize("LabelData10")
	ChangeTextSize("LabelData11")
	ChangeTextSize("LabelData12")
	ChangeTextSize("LabelData13")
	ChangeTextSize("LabelData14")
	ChangeTextSize("LabelData15")
	
	'--------------------------------------------------------------
	' 텍스트 세팅
	'--------------------------------------------------------------
	LabelData0.caption = "위안화(CNY)"
	LabelData1.caption = "온라인 0.3%\n(Super365계좌 0.07%)"
	LabelData2.caption = "오프라인 0.5%"
	LabelData3.caption = "* 최소 수수료 없음"
	LabelData4.caption = "· 일반 주식"
	LabelData9.caption = "· ETF"
	LabelData14.caption = "실시간 환전 09:00 ~ 15:30"
	LabelData15.caption = "(환전은 영업일만 가능)"
		
	'일반주식
	LabelData5.caption = "Stamp Duty\n: 0.05% (인지세, 매도 시 부과)"
	LabelData6.caption = "Handling Fee\n: 0.00341%"
	LabelData7.caption = "Securities Management Fee\n: 0.002%"
	LabelData8.caption = "Transfer Fee\n: 0.003%"
	
	'ETF
	LabelData10.caption = "Stamp Duty\n: 면제 (인지세, 매도 시 부과)"
	LabelData11.caption = "Handling Fee\n: 0.004%"
	LabelData12.caption = "Securities Management Fee\n: 면제"
	LabelData13.caption = "Transfer Fee\n: 0.002%"
	

	'--------------------------------------------------------------
	' 텍스트 속성 변경
	'--------------------------------------------------------------
	ChangeTextAttr("LabelData1")
	
	
End Sub
'============================================================================
Function ChangeTextSize(sCtlName)

	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	Form.SetCtlProp(sCtlName, "fontsize", sTextSize)
	

End Function
'============================================================================
Function ChangeTextAttr(sCtlName)
	
	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	'-------------------------------------
	' 속성변경
	'-------------------------------------
	if sCtlName == "LabelData1" then
		
		LabelData1.fontsize = sTextSize
		
		nStart = 0
		nLen = Form.getLen("온라인 0.3%")
		LabelData1.changeTextAttr(nStart, nLen, 334, sTextSize , true)
		
		nStart = Form.getLen("온라인 0.3%\n")
		nLen = Form.getLen("(Super365계좌 0.07%)")
		LabelData1.changeTextAttr(nStart, nLen, 333, sTextSize - 1 , true)
	
		
	end if

End Function
