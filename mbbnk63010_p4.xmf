--===========================================================================
--===========================================================================

Dim g_szUserID '고객아이디
Dim g_szACNO
Dim g_szASNO
Dim isNext
'============================================================================
Sub Form_OnFormInit()
	g_szUserID = Form.GetSharedData("&USER_ID", false) '고객아이디
	
	szTotalAcc = Form.GetOpenLinkData()
	g_szACNO = Left(szTotalAcc,8)
	g_szASNO = Right(szTotalAcc,2)
	
	DATAMANAGER.RequestTranData( "obacp_comm_064r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obacp_comm_064r" then
	     DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "IQRY_CSNU" , 0 , 10)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ELFN_ID" , 0 , g_szUserID)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , g_szACNO)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" , 0 , g_szASNO)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'내계좌 조회
	if szTranID == "obacp_comm_064r" then
		nCnt = grdList.rowcount

		For i=0 to nCnt-1
			szAcno = grdList.GetCellData( "bd_acno", i)
			szAsno = grdList.GetCellData( "bd_asno", i)
			grdList.SetCellData( "bd_total", i, Left(szAcno,4).."-"..Right(szAcno,4).."-"..szAsno)

		Next
		
         if isNext == "1" or isNext == true then
             Form.Toast(0, "조회가 계속됩니다. 화면을 위로 드래그해주세요.", 0)
	    end if
	    
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
	
	if szSubErr <> "" and szSubErr <> null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	szAcno = grdList.GetCellData( "bd_acno", lRow)
	szAsno = grdList.GetCellData( "bd_asno", lRow)
	szPrnm = grdList.GetCellData( "bd_prnm", lRow)
	szAmt = grdList.GetCellData( "bd_amt", lRow)
	
	szData = szAcno..szAsno.."★"..szPrnm.."★"..szAmt
	
	Form.SendReturnToParent("mbbnk63010_p4" , szData)
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	isNext = DATAMANAGER.IsMoreNextData("obacp_comm_064r")
	if isNext == "1" or isNext == true then
		DATAMANAGER.RequestNextData("obacp_comm_064r")
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

