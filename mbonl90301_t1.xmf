				contMain.gridData.SetCellData("BYNG_UNPR",				g_iDataCount + i, szTemp11) '매입단가
				contMain.gridData.SetCellData("BYOV_ERT",				g_iDataCount + i, szTemp12) '매수수익률
				contMain.gridData.SetCellData("BOND_DIV_NAME",			g_iDataCount + i, szTemp13) '채권분류명
				contMain.gridData.SetCellData("ISNM",					g_iDataCount + i, szTemp14) '종목명
				contMain.gridData.SetCellData("MTRT_DATE",				g_iDataCount + i, szTemp15) '만기일자
				contMain.gridData.SetCellData("VLTN_PRLS_AMT",			g_iDataCount + i, szTemp16) '평가손익금액
				contMain.gridData.SetCellData("RMND_OWN_TYPE_NAME",		g_iDataCount + i, szTemp17) '잔고소유유형명
				contMain.gridData.SetCellData("VLTN_UNPR",				g_iDataCount + i, szTemp18) '평가단가
				contMain.gridData.SetCellData("LOAN_AMT",				g_iDataCount + i, szTemp19) '대출금액
				contMain.gridData.SetCellData("LOAN_DATE",				g_iDataCount + i, szTemp20) '대출일자
				contMain.gridData.SetCellData("LOAN_MTRT_DATE",			g_iDataCount + i, szTemp21) '대출만기일자
				contMain.gridData.SetCellData("PSNT_PRC",				g_iDataCount + i, szTemp22) '현재가격
				contMain.gridData.SetCellData("PRDY_VRSS",				g_iDataCount + i, szTemp23) '전일대비
				contMain.gridData.SetCellData("RLTM_PRDY_VRSS_SIGN",		g_iDataCount + i, szTemp24)	'실시간전일대비부호
				contMain.gridData.SetCellData("OVRL_SPTX_CLS_CODE",		g_iDataCount + i, szTemp25)	'종합분리과세구분코드
				contMain.gridData.SetCellData("IQRY_CSNU",				g_iDataCount + i, szTemp26)	'조회건수
				contMain.gridData.SetCellData("RMND_CLCD",				g_iDataCount + i, szTemp27)	'잔고구분코드
			end if
		next                                                                             
		
		g_iDataCount = g_iDataCount + iDataCnt
		
		if g_bSingle then
			contMain.gridDataSingle.rowcount = g_iDataCount
		else			
			contMain.gridData.rowcount = g_iDataCount
		end if
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			'다음 조회 요청
			DATAMANAGER.RequestNextData(szTranID)
			
		else
			if g_iDataCount > 0 then
				if g_bSingle then
					contMain.gridDataSingle.visible = True
					contMain.gridDataSingle.OnSortingByScript("BYOV_DATE", 0 , 0 )
				else
					contMain.gridData.visible = True
					contMain.gridData.OnSortingByScript("BYOV_DATE", 0 , 0 )
				end if
				
				szToday = Form.GetSharedData("&HOST_DATE", false)
				szToday = Right(szToday, 6)
				
				contMain.cont1.tblInfo.SetCellString(1, 2, szToday)			'날짜
				
				contMain.cont1.tblInfo.SetCellString(3, 2, CInt(g_iAmtSum))		'평가금액
								
				if CInt(g_ievalAmt) > 0 then
					contMain.cont1.tblInfo.SetCellString(5, 2, "+" & FormatNumber(g_ievalAmt, 0) & "원")	'평가손익
					contMain.cont1.tblInfo.SetCellFgColor(5, 2, 6)
				else
					contMain.cont1.tblInfo.SetCellString(5, 2, FormatNumber(g_ievalAmt, 0) & "원")	'평가손익
					contMain.cont1.tblInfo.SetCellFgColor(5, 2, 7)
				end if
			
				if g_bSingle then
					iHeight = (156 * g_iDataCount) + 15 + 10
					
					contMain.gridDataSingle.height = (156 * g_iDataCount) + 15
					
					if iHeight < 282 then
						contMain.lblBG.height = 282
					else
						contMain.lblBG.height = (156 * g_iDataCount) + 15 + 10
					end if
				else
					iHeight = (156 * g_iDataCount) + 15 + 10
					
					contMain.gridData.height = (179 * g_iDataCount) + 15
					
					if iHeight < 282 then
						contMain.lblBG.height = 282
					else
						contMain.lblBG.height = (179 * g_iDataCount) + 15 + 10
					end if
					
				end if
				
				contMain.imgNotice.visible = False
				contMain.tblNoData.visible = False
				
				contMain.SetScrollAutoSize()
				
				if g_bQry_deal_605r_Index then
					f_SendIndexQry(0, CInt(g_szList(0)) - 1, szTranID)
				end if
				
			else
'				Form.ShowAlert("TranComplte", g_bQry_deal_605r_Index .. " : " .. g_iQry_deal_605r_Index)
				if g_bQry_deal_605r_Index then
					f_SendIndexQry(0, CInt(g_szList(0)) - 1, szTranID)
					
				else
'					Form.ShowAlert("", g_bQry_deal_605r_Index .. " : " .. g_iQry_deal_605r_Index)
					if g_bSingle then
						contMain.gridDataSingle.visible = False
					else
						contMain.gridData.visible = False
					end if
					
					contMain.lblBG.top = 225
					contMain.lblBG.height = 242
					
					contMain.gridData.top = 230
					contMain.gridData.height = 225
					
					contMain.gridDataSingle.top = 230
					contMain.gridDataSingle.height = 225
					
					contMain.tblNoData.top = 280
					contMain.imgNotice.top = 240
						
					contMain.imgNotice.visible = True
					contMain.tblNoData.visible = True
'					
'					contMain.gridData.top = 190
'					contMain.gridData.height = 225
'				
'					contMain.gridDataSingle.top = 190
'					contMain.gridDataSingle.height = 225
'					
''					contMain.lblBG.Height = 325
'					contMain.lblBG.Height = 282
					contMain.SetScrollAutoSize()
				end if
				
				
			end if
			
		end if
		f_SortGrid()
	end if
	
End Sub


'============================================================================
Sub contMain_cont1_btnSort_OnClick()
	contMain.cont1.cmbSort.openList()
End Sub

'============================================================================
Sub contMain_cont1_cmbSort_OnEditComplete(iIndex)
	select case CInt(contMain.cont1.cmbSort.currentindex)
		case 0	contMain.cont1.cmbSort.left = 230
		case 1	contMain.cont1.cmbSort.left = 260
		case 2	contMain.cont1.cmbSort.left = 245
	end select
	
	f_SortGrid()
	
'	f_sendQry()
End Sub

'============================================================================
Function f_SortGrid()
	Dim nIndex
	nIndex = CInt(contMain.cont1.cmbSort.currentindex)
	if g_bSingle then
		contMain.gridDataSingle.visible = True
		if nIndex == 0 then
			contMain.gridDataSingle.OnSortingByScript("BYOV_DATE", 0 , 0 )
		elseif nIndex == 1 then
			contMain.gridDataSingle.OnSortingByScript("bd_Title", 0 , 1 )
		else
			contMain.gridDataSingle.OnSortingByScript("bd_eval2", 0 , 0 )
		end if
	else
		contMain.gridData.visible = True
		if nIndex == 0 then
			contMain.gridData.OnSortingByScript("BYOV_DATE", 0 , 0 )
		elseif nIndex == 1 then
			contMain.gridData.OnSortingByScript("bd_Title", 0 , 1 )
		else
			contMain.gridData.OnSortingByScript("bd_eval2", 0 , 0 )
		end if
	end if
End Function

