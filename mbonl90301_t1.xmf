		Form.OpenPopupAnimation("mbonl90301_p2", szLinkData,  "",  2)
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림_" & szTranID , "90301_t1\n" & szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림_" & szTranID , "90301_t1\n" & szErrCode .. " : ".. szErrMsg)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szProdCD, szValue, szSumYN

	if szTranID == "obsab_deal_605r" then
		DATAMANAGER.ClearInputData(0, szTranID)
		
'		Form.ShowAlert("TranBefore", contMain.cont1.FormTab0.currenttab)
	
		if CInt(contMain.cont1.FormTab0.currenttab) == 1 and CInt(contMain.cont1.chkSum.checkstate) == 1 then
			g_szSumYN = "Y"
		else
			g_szSumYN = "N"
		end if			
				
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_UNIT_CLS",		0, g_szQryType)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_TRGT_CLS_CODE",	0, g_szProducType) '0:전체, 1:채권, 2:단기사채
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",				0, g_szACNO)
		
		if g_szQryType == 1 then			
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, "")
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",			0, "")
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, "")
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AMT_ADUP_YN",		0, g_szSumYN)
		
		elseif g_szQryType == 2 then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, g_szASNO)
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",			0, "")
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, "")
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AMT_ADUP_YN",		0, g_szSumYN)
		
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, g_szASNO)
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",			0, "")
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, g_szSymbolCode)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AMT_ADUP_YN",		0, g_szSumYN)
		end if 
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData, iDataCnt, iAmtSum, ievalAmt, iHeight
'	Form.ShowAlert("TranComplete", szTranID)
	
	if szTranID == "obsab_deal_605r" then
		if g_bSingle then
			g_iDataCount = contMain.gridDataSingle.rowcount
		else			
			g_iDataCount = contMain.gridData.rowcount
		end if
		
		iDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" ))
'		Form.ShowAlert("TranComplete1", g_iDataCount & " : " &iDataCnt)
		
		for i = 0 to iDataCnt - 1
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_TRGT_CLS_CODE",		i)	'처리대상구분코드
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO",					i)   '계좌번호
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO",					i)   '계좌일련번호
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_INPR_NAME",				i)   'UI개별상품명
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CUST_FULL_NAME",			i)   '고객풀명
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",					i)   '종목코드
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_DATE",				i)   '매수일자
			szTemp8  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_QTY",				i)   '잔고수량
			szTemp9  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYNG_AMT",				i)   '매입금액
			szTemp10 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_AMT",				i)   '평가금액
			szTemp11 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYNG_UNPR",				i)   '매입단가
			szTemp12 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_ERT",				i)   '매수수익률
			szTemp13 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_NAME",			i)   '채권분류명
			szTemp14 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM",					i)   '종목명
			szTemp15 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE",				i)   '만기일자
			szTemp16 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_PRLS_AMT",			i)   '평가손익금액
			szTemp17 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_OWN_TYPE_NAME",		i)   '잔고소유유형명
			szTemp18 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_UNPR",				i)   '평가단가
			szTemp19 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_AMT",				i)   '대출금액
			szTemp20 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_DATE",				i)   '대출일자
			szTemp21 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_MTRT_DATE",			i)   '대출만기일자
			szTemp22 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PSNT_PRC",				i)   '현재가격
			szTemp23 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRDY_VRSS",				i)   '전일대비
			szTemp24 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RLTM_PRDY_VRSS_SIGN",		i)   '실시간전일대비부호
			szTemp25 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OVRL_SPTX_CLS_CODE",		i)   '종합분리과세구분코드
			szTemp26 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "IQRY_CSNU",				i)   '조회건수
			szTemp27 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_CLCD",				i)   '잔고구분코드  1:일반, 2:대출, 4:대여, 5:대용(선물), 6:대용(CFD)

			if g_bSingle then
				contMain.gridDataSingle.AddRow()				
			
				'badge_1  채권분류명
				if szTemp13 <> "" and szTemp13 <> null then
					contMain.gridDataSingle.SetCellImage("bd_badge1", g_iDataCount + i, "img_bgsquare_grade_363.png")
					contMain.gridDataSingle.SetCellData("bd_badge1", g_iDataCount + i, szTemp13)
		'			Form.ShowAlert("TranComplete2", g_iDataCount + i & " : " & szTemp13)
				
				else
					if szTemp1 == "2" then  '단기사채일 경우
						contMain.gridDataSingle.SetCellImage("bd_badge1", g_iDataCount + i, "img_bgsquare_grade_363.png")
						contMain.gridDataSingle.SetCellData("bd_badge1",	g_iDataCount + i, "단기사채")
					end if
				end if
				
				'badge_2   대용채권/대출채권
				if szTemp27 == "2" then
					contMain.gridDataSingle.SetCellImage("bd_badge2", g_iDataCount + i, "img_bgsquare_grade_316.png")
					contMain.gridDataSingle.SetCellData("bd_badge2", g_iDataCount + i, "대출채권")
					contMain.gridDataSingle.SetCellData("bd_badge3", g_iDataCount + i, "icon_notice")
					
				elseif (szTemp27 == "5") or (szTemp27 == "6") then
					contMain.gridDataSingle.SetCellImage("bd_badge2", g_iDataCount + i, "img_bgsquare_grade_316.png")
					contMain.gridDataSingle.SetCellData("bd_badge2", g_iDataCount + i, "대용채권")
					contMain.gridDataSingle.SetCellData("bd_badge3", g_iDataCount + i, "icon_notice")
				end if
							
				contMain.gridDataSingle.SetCellData("bd_Title",	g_iDataCount + i, szTemp14)		'종목명
							
				'계좌명
	'			contMain.gridDataSingle.SetCellData("bd_account",	g_iDataCount + i, f_getAccFullName(szTemp2, szTemp3))
				if szTemp4 == "" or szTemp4 == null then
					contMain.gridDataSingle.SetCellData("bd_account",	g_iDataCount + i, Left(szTemp2, 4) & "-" & Right(szTemp2, 4) & "-" &
																			szTemp3 & " " & szTemp5)
				else
					szTemp4 = replace(szTemp4, "(", "")
					szTemp4 = replace(szTemp4, ")", "")
					
					contMain.gridDataSingle.SetCellData("bd_account",	g_iDataCount + i, "[" & szTemp4 & "] " &
																			Left(szTemp2, 4) & "-" & Right(szTemp2, 4) & "-" &
																			szTemp3 & " " & szTemp5)
				end if
				
				contMain.gridDataSingle.SetCellData("bd_date1",	g_iDataCount + i, "만기일")			
				
				'종목별 합산보기시 매수일자가 다른 보유종목이 합산됐을 경우 "매수일자" 필드값이 00000000 으로 전송
				if szTemp7 = "00000000" then	
					contMain.gridDataSingle.SetCellData("bd_date2", 	g_iDataCount + i, "매수일별보기>")
					contMain.gridDataSingle.SetCellFgColor("bd_date2", 	g_iDataCount + i, 91)
				else
					if szTemp15 <> "" then
						contMain.gridDataSingle.SetCellData("bd_date2", g_iDataCount + i, Left(szTemp15, 4) & "." &
																			 Mid(szTemp15, 5, 2) & "." &
																			 Right(szTemp15, 2))
						contMain.gridDataSingle.SetCellFgColor("bd_date2", 	g_iDataCount + i, 4)
					end if
				end if
				
				contMain.gridDataSingle.SetCellData("bd_qty1",		g_iDataCount + i, "수량")
				contMain.gridDataSingle.SetCellData("bd_qty2",		g_iDataCount + i, szTemp8)
				
				contMain.gridDataSingle.SetCellData("bd_amt1",		g_iDataCount + i, "매입금액")
				contMain.gridDataSingle.SetCellData("bd_amt2",		g_iDataCount + i, szTemp9)
				
				contMain.gridDataSingle.SetCellData("bd_eval1",		g_iDataCount + i, "평가금액")
				contMain.gridDataSingle.SetCellData("bd_eval2",		g_iDataCount + i, szTemp10)
				
				'채권일 경우만 매도버튼 표시
				if (szTemp1 == "1") and (szTemp27 == "1") then
					contMain.gridDataSingle.SetCellData("bd_sell",		g_iDataCount + i, "채권매도")
					contMain.gridDataSingle.SetCellFgColor("bd_sell", 	g_iDataCount + i, 38)
	
					'종목별 합산보기시 매수일자가 다른 보유종목이 합산됐을 경우 "매수일자" 필드값이 00000000 으로 전송
					if szTemp7 = "00000000" then	
						contMain.gridDataSingle.SetCellImage("bd_sell", 	g_iDataCount + i, "btn_bg_01_n.9.png")
					else
						contMain.gridDataSingle.SetCellImage("bd_sell", 	g_iDataCount + i, "btn_31_n.9.png")
					end if
				end if
							
				'평가금액 합산
				g_iAmtSum  = g_iAmtSum + CInt(szTemp10)
				g_ievalAmt = g_ievalAmt + CInt(szTemp16)
				
				'숨겨진 컬럼
				contMain.gridDataSingle.SetCellData("PROS_TRGT_CLS_CODE",		g_iDataCount + i, szTemp1 )	'처리대상구분코드
				contMain.gridDataSingle.SetCellData("ACNO",					g_iDataCount + i, szTemp2 ) '계좌번호
				contMain.gridDataSingle.SetCellData("ASNO",					g_iDataCount + i, szTemp3 ) '계좌일련번호
				contMain.gridDataSingle.SetCellData("UI_INPR_NAME",			g_iDataCount + i, szTemp4 ) 'UI개별상품명
				contMain.gridDataSingle.SetCellData("CUST_FULL_NAME",			g_iDataCount + i, szTemp5 ) '고객풀명
				contMain.gridDataSingle.SetCellData("ISCD",					g_iDataCount + i, szTemp6 ) '종목코드
				contMain.gridDataSingle.SetCellData("BYOV_DATE",				g_iDataCount + i, szTemp7 ) '매수일자
				contMain.gridDataSingle.SetCellData("RMND_QTY",				g_iDataCount + i, szTemp8 ) '잔고수량
				contMain.gridDataSingle.SetCellData("BYNG_AMT",				g_iDataCount + i, szTemp9 ) '매입금액
				contMain.gridDataSingle.SetCellData("VLTN_AMT",				g_iDataCount + i, szTemp10) '평가금액
				contMain.gridDataSingle.SetCellData("BYNG_UNPR",				g_iDataCount + i, szTemp11) '매입단가
				contMain.gridDataSingle.SetCellData("BYOV_ERT",				g_iDataCount + i, szTemp12) '매수수익률
				contMain.gridDataSingle.SetCellData("BOND_DIV_NAME",			g_iDataCount + i, szTemp13) '채권분류명
				contMain.gridDataSingle.SetCellData("ISNM",					g_iDataCount + i, szTemp14) '종목명
				contMain.gridDataSingle.SetCellData("MTRT_DATE",				g_iDataCount + i, szTemp15) '만기일자
				contMain.gridDataSingle.SetCellData("VLTN_PRLS_AMT",			g_iDataCount + i, szTemp16) '평가손익금액
				contMain.gridDataSingle.SetCellData("RMND_OWN_TYPE_NAME",		g_iDataCount + i, szTemp17) '잔고소유유형명
				contMain.gridDataSingle.SetCellData("VLTN_UNPR",				g_iDataCount + i, szTemp18) '평가단가
				contMain.gridDataSingle.SetCellData("LOAN_AMT",				g_iDataCount + i, szTemp19) '대출금액
				contMain.gridDataSingle.SetCellData("LOAN_DATE",				g_iDataCount + i, szTemp20) '대출일자
				contMain.gridDataSingle.SetCellData("LOAN_MTRT_DATE",			g_iDataCount + i, szTemp21) '대출만기일자
				contMain.gridDataSingle.SetCellData("PSNT_PRC",				g_iDataCount + i, szTemp22) '현재가격
				contMain.gridDataSingle.SetCellData("PRDY_VRSS",				g_iDataCount + i, szTemp23) '전일대비
				contMain.gridDataSingle.SetCellData("RLTM_PRDY_VRSS_SIGN",		g_iDataCount + i, szTemp24)	'실시간전일대비부호
				contMain.gridDataSingle.SetCellData("OVRL_SPTX_CLS_CODE",		g_iDataCount + i, szTemp25)	'종합분리과세구분코드
				contMain.gridDataSingle.SetCellData("IQRY_CSNU",				g_iDataCount + i, szTemp26)	'조회건수
				contMain.gridDataSingle.SetCellData("RMND_CLCD",				g_iDataCount + i, szTemp27)	'잔고구분코드
				
			else
				contMain.gridData.AddRow()				
			
				'badge_1  채권분류명
				if szTemp13 <> "" and szTemp13 <> null then
					contMain.gridData.SetCellImage("bd_badge1", g_iDataCount + i, "img_bgsquare_grade_363.png")
					contMain.gridData.SetCellData("bd_badge1", g_iDataCount + i, szTemp13)
