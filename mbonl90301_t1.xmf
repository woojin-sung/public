				contMain.gridData.SetCellData("bd_Title",	g_iDataCount + i, szTemp14)		'종목명
							
				'계좌명
	'			contMain.gridData.SetCellData("bd_account",	g_iDataCount + i, f_getAccFullName(szTemp2, szTemp3))
				if szTemp4 == "" or szTemp4 == null then
					contMain.gridData.SetCellData("bd_account",	g_iDataCount + i, Left(szTemp2, 4) & "-" & Right(szTemp2, 4) & "-" &
																			szTemp3 & " " & szTemp5)
				else
					szTemp4 = replace(szTemp4, "(", "")
					szTemp4 = replace(szTemp4, ")", "")
					
					contMain.gridData.SetCellData("bd_account",	g_iDataCount + i, "[" & szTemp4 & "] " &
																			Left(szTemp2, 4) & "-" & Right(szTemp2, 4) & "-" &
