'============================================================================
Function f_getAccFullName(szAcNo, szAsNo)
	Dim szAcc
	Dim szResult
	
	szAcc = Left(szAcNo, 4) & "-" & Right(szAcNo, 4) & "-" & szAsNo
	for i = 0 to CInt(g_iAccountCount) - 1
		if InStr(g_szAccountList(i), szAcc) > 0 then
			szResult = g_szAccountList(i)
			exit for
		end if
	next
	
	return szResult
end function

'============================================================================
Sub f_InitCtrl()
	szToday = Form.GetSharedData("&HOST_DATE", false)
	szToday = Right(szToday, 6)
	
	contMain.cont1.tblInfo.SetCellString(1, 2, szToday)			'날짜	
	contMain.cont1.tblInfo.SetCellString(3, 2, 0)		'평가금액
	contMain.cont1.tblInfo.SetCellString(5, 2, "")	'평가손익

	contMain.gridData.rowcount = 0
	contMain.gridDataSingle.rowcount = 0
	g_iAmtSum = 0
	g_ievalAmt = 0
end sub

'============================================================================
'for문에서 동시에 TR 요청시 제대로 못받는 경우가 생겨서 순차적으로 요청
Sub f_SendIndexQry(iStart, iEnd, szTranID)
'	Form.ShowAlert("f_SendIndexQry1", iStart & " : " &
'								 iEnd & " : " &
'								 szTranID & " : " &
'								 g_iQry_deal_605r_Index)
	Dim iCnt
	
	if CInt(g_iQry_deal_605r_Index) > CInt(iEnd) then
'		Form.ShowAlert("f_SendIndexQry2", g_iQry_deal_605r_Index)
		
		g_bQry_deal_605r_Index = False
				
		if g_bSingle then
			iCnt = CInt(contMain.gridDataSingle.rowcount)
		else
			iCnt = CInt(contMain.gridData.rowcount)
		end if
		
		if iCnt == 0 then
			contMain.imgNotice.visible = True
			contMain.tblNoData.visible = True
			
'			contMain.gridData.top = 190
'			contMain.gridData.height = 225
'			
'			contMain.gridDataSingle.top = 190
'			contMain.gridDataSingle.height = 225
'			
''			contMain.lblBG.Height = 325
'			contMain.lblBG.Height = 282
			
			
			contMain.lblBG.top = 225
			contMain.lblBG.height = 242
			
			contMain.gridData.top = 230
			contMain.gridData.height = 225
			
			contMain.gridDataSingle.top = 230
			contMain.gridDataSingle.height = 225
			
			contMain.tblNoData.top = 280
			contMain.imgNotice.top = 240
			
			contMain.SetScrollAutoSize()
		end if
		
		Exit Sub
	
	else
'		Form.ShowAlert("f_SendIndexQry3", g_iQry_deal_605r_Index)
		
		if szTranID == "obsab_deal_605r" then
			g_szACNO = g_szAccList(g_iQry_deal_605r_Index)
			
			DATAMANAGER.RequestTranData(szTranID)
			
		end if
		
		g_iQry_deal_605r_Index = CInt(g_iQry_deal_605r_Index) + 1
	end if
	
end Sub

'============================================================================
Sub f_sendQry()
	Dim szAccList
	
	f_InitCtrl()
'	Form.ShowAlert("f_sendQry1", g_szSelectAcc)
	
	if g_szSelectAcc == "전체" then
		g_bSingle = False
		
		contMain.gridData.visible = True
		contMain.gridDataSingle.visible = False	
	
'		Form.ShowAlert("f_sendQry", g_szList(1))
		g_szQryType = 1	'전체계좌 조회
		
		g_szAccList = split(g_szList(1), "○")
		
'		Form.ShowAlert("f_sendQry", szAccList(0) & "\n" &
'								szAccList(1) & "\n" &
'								szAccList(2) & "\n" &
'								szAccList(3) & "\n" &
'								szAccList(4))
		g_iQry_deal_605r_Index = 0
		g_bQry_deal_605r_Index = True
		f_SendIndexQry(0, CInt(g_szList(0)) - 1, "obsab_deal_605r")
		
'		for i = 0 to CInt(g_szList(0)) - 1
'			g_szACNO = g_szAccList(i)
''			Form.ShowAlert("f_sendQry", i & ":\n" & g_szACNO)
'
'			DATAMANAGER.RequestTranData("obsab_deal_605r")
'		next
		
	else	
		g_bSingle = True
		
		contMain.gridData.visible = False
		contMain.gridDataSingle.visible = True
		
		g_szQryType = 2	'개별 계좌 조회
		g_szACNO = g_szSelectAcc
		g_szASNO = g_szSelectAccSeq
		
		g_bQry_deal_605r_Index = False
		DATAMANAGER.RequestTranData("obsab_deal_605r")
		
	end if

end sub

'============================================================================
'채권 매도 화면 팝업
Sub f_callBondOrder()
	Dim szData, szLinkData, szCode, iRow
	
	iRow = CInt(g_iSelectedRow)
	
	if g_bSingle then
		szData = contMain.gridDataSingle.GetCellData("BYOV_DATE", iRow)
	else
		szData = contMain.gridData.GetCellData("BYOV_DATE", iRow)
	end if
	
	szLinkData = ""
	if szData <> "00000000" then
		'장내채권 매도 화면으로 이동
		
		szLinkData = "채권잔고" & "★" &	'0 채권매도
				    "1"					'1 매도탭
		
		if g_bSingle then
			szCode = contMain.gridDataSingle.GetCellData("ISCD",		iRow)
		else
			szCode = contMain.gridData.GetCellData("ISCD",		iRow)
		end if 
		
		szLinkData = szLinkData & "★" & szCode	'2 종목코드
		
		'3 시장구분
		szData = Form.GetItemCodeInfo(szCode, "innermarket")
		if szData == "020" then
			szLinkData = szLinkData & "★" & "B"		'장내
		elseif szData == "019" then
			szLinkData = szLinkData & "★" & "SB"	'소액
		elseif Trim(szData) == "" then
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
			
			Exit Sub
		end if 
		
		if g_bSingle then
			szLinkData = szLinkData & "★" & CInt(contMain.gridDataSingle.GetCellData("RMND_QTY",	iRow)) / 1000	'4 잔고수량
			szLinkData = szLinkData & "★" & contMain.gridDataSingle.GetCellData("BYOV_DATE",	iRow)	'5 매수일자
			
			'6 매수구분(종합과세/분리과세)코드
			szData = contMain.gridDataSingle.GetCellData("OVRL_SPTX_CLS_CODE",	iRow)
			
		else
			szLinkData = szLinkData & "★" & CInt(contMain.gridData.GetCellData("RMND_QTY",	iRow)) / 1000	'4 잔고수량
			szLinkData = szLinkData & "★" & contMain.gridData.GetCellData("BYOV_DATE",	iRow)	'5 매수일자
			
			'6 매수구분(종합과세/분리과세)코드
			szData = contMain.gridData.GetCellData("OVRL_SPTX_CLS_CODE",	iRow)
		end if
		
'		Form.ShowAlert("f_callBondOrder1", szData)
		if szData == "1" then
			szLinkData = szLinkData & "★" & "종합과세"	
		else
			szLinkData = szLinkData & "★" & "분리과세"
		end if
		
		if g_bSingle then
			szAccString = contMain.gridDataSingle.GetCellData("ACNO", g_iSelectedRow) & contMain.gridDataSingle.GetCellData("ASNO", g_iSelectedRow)
		else
			szAccString = contMain.gridData.GetCellData("ACNO", g_iSelectedRow) & contMain.gridData.GetCellData("ASNO", g_iSelectedRow)
		
		end if
		
'		Form.ShowAlert("", szAccString)
		szIdx = acc1.GetIndexByAccountinfo(szAccString)
		acc1.currentindex = szIdx
		
'		Form.ShowAlert("f_callBondOrder2", szLinkData)
'		Form.OpenPopup("mbfnp54021", szLinkData, "")
		Form.OpenScreen(54020 , szLinkData)
		
		'iOS 에서 매도화면이 안열리는 현상이 발생하여, 매도화면으로 연결 이후 form close 하게 수정함.
		Form.triggerEvent("#", "mbonl90301_t1_close", "")
	end if

end sub


