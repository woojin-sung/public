Sub Form_OnFormInitBefore()
	contMain.cont1.imgMine.setMaintainingRatio("1")
	contMain.cont1.imgCheck.setMaintainingRatio("1")
End Sub


'============================================================================
Sub Form_OnFormInit()
	g_iDataCount = 0
	
	g_szQryType = "1"
	g_szProducType = "00"
	g_szSumYN = "N"
	
	g_bQry_deal_605r_Index = False
	
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'고객번호
	g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then	'Android("1")iOS("2")
		contMain.gridData.setUseCardView(true, -5, "bg_listbox.9.png")
		contMain.gridDataSingle.setUseCardView(true, -5, "bg_listbox.9.png")
	else
		contMain.gridData.setUseCardView(true, 1, "bg_listbox.9.png")
		contMain.gridDataSingle.setUseCardView(true, 1, "bg_listbox.9.png")
	end if 
	
'	contMain.cont1.Tab0.setTabHeaderImage("bg_tab_sel.9.png" , "bg.tab_nor.9.png" , 6) '활성화/비활성화/여백	

	'20240221 헤더이미지 관련 세팅하면 뭔가 어긋남.. 위치값 조정 추가
	if  Form.GetSharedData("&OS_TYPE", false ) == "2" then
		contMain.cont1.FormTab0.left = 22
	end if
	contMain.cont1.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	contMain.cont1.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	contMain.cont1.FormTab0.insertPage( contMain.cont1.FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	contMain.cont1.FormTab0.insertPage( contMain.cont1.FormTab0.tabcount, "page2", "page2", "empty", "0", "채권")
	contMain.cont1.FormTab0.insertPage( contMain.cont1.FormTab0.tabcount, "page3", "page3", "empty", "0", "단기사채")
	
'	contMain.cont1.FormTab0.currenttab = 0
	
	contMain.cont1.chkSum.visible = False
	
'	contMain.cont1.imgCheck.enable = False
'	contMain.cont1.lblSum.enable = False
'	contMain.cont1.btnSum.enable = False	
	contMain.cont1.imgCheck.visible = False
	contMain.cont1.lblSum.visible = False
	contMain.cont1.btnSum.visible = False
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contMain.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
	Dim szList, szAccList
	
'	Form.ShowAlert("90301t1_Trigger_" & sEventName, sParam)
	
	'화면 처음 열때
	if sEventName == "Init" then
'		Form.ShowAlert("90301t1_Trigger_" & sEventName, sParam)
		'0 종합계좌 개수
		'1 종합계좌 리스트
		'2 개별계좌개수
		'3 개별계좌 리스트(ACNo + ASNo)
		'4 개별계좌명 리스트([상품명]계좌번호)
		'5 계좌개수☆개별계좌의 그룹인덱스
		'6 선택한 계좌번호
		'7 선택한 계좌seq
		'8 비밀번호
		
		g_szLinkData = sParam
		g_szList = split(g_szLinkData, "|")
'		Form.ShowAlert("90301t1_Trigger_" & sEventName, g_szList(2) & " : " & g_szList(4))
		g_szSelectAcc = g_szList(6)
		g_szSelectAccSeq = g_szList(7)
		
		'계좌번호전체, 계좌명을 비교하기 위해서 
		g_iAccountCount = CInt(g_szList(2))
		g_szAccountList = split(g_szList(4), "○")
		
'		contMain.cont1.FormTab0.currenttab = CInt(g_szList(9))
		
		'20240214 VOC 메뉴별로 디폴트 탭 세팅
		Dim szTab
		'20240221 mbonl90000에서 진입하면 전체탭으로 세팅
		szTab = Form.GetSharedData("90301_TAB", true)
		if szTab <> "" and szTab <> null then
			contMain.cont1.FormTab0.currenttab = CInt(szTab)
		else
			Dim szScreenNo
			szScreenNo = Form.GetSharedData("&SCREEN_NO", false)
			if szScreenNo <> "" and szScreenNo <> null then
				if szScreenNo == "54140" then
					contMain.cont1.FormTab0.currenttab = 1
				elseif szScreenNo == "54120" then
					contMain.cont1.FormTab0.currenttab = 2
				end if
			else
				contMain.cont1.FormTab0.currenttab = 0
			end if
		end if
		
		
		contMain_cont1_FormTab0_OnTabChanged(CInt(contMain.cont1.FormTab0.currenttab))
		
'		f_sendQry()
	
	'계좌콤보 변경시
	elseif sEventName == "AccountChange" then
'		Form.ShowAlert("90301t1_Trigger_" & sEventName, sParam)
		
		'0 선택한 계좌번호		
		'1 선택한 계좌seq
		'2 비밀번호
		
		szList = split(sParam, "|")
		g_szSelectAcc = szList(0)
		g_szSelectAccSeq = szList(1)
		
		f_sendQry()
		
	end if
	
End Sub

'============================================================================
Sub contMain_cont1_FormTab0_OnTabChanged(nCurrentTab)
	select case nCurrentTab
		case 0		g_szProducType = "0"
		case 1		g_szProducType = "1"
		case 2		g_szProducType = "2"	
	end select
	
	'20240215 필터값 추가
	if g_szProducType == "1" then
		contMain.cont1.imgCheck.visible = True
		contMain.cont1.lblSum.visible = True
		contMain.cont1.btnSum.visible = True
	else
		contMain.cont1.imgCheck.visible = false
		contMain.cont1.lblSum.visible = false
		contMain.cont1.btnSum.visible = false
	end if 
	
	contMain.cont1.height = 225
	
	contMain.lblBG.top = 225
	contMain.lblBG.height = 242
	
	contMain.gridData.top = 230
	contMain.gridData.height = 225
	
	contMain.gridDataSingle.top = 230
	contMain.gridDataSingle.height = 225
	
	contMain.tblNoData.top = 280
	contMain.imgNotice.top = 240
	
	if g_szProducType == "1" then
		if CInt(contMain.cont1.chkSum.checkstate) == 0 then
			g_szSumYN = "N"			
		else
			g_szSumYN = "Y"			
		end if
	else
		if CInt(contMain.cont1.chkSum.checkstate) == 1 then
			contMain_cont1_btnSum_OnClick()
		end if
		
		g_szSumYN = "N"
	end if
	
	f_sendQry()
End Sub

'============================================================================
Sub contMain_cont1_btnSum_OnClick()
	if CInt(contMain.cont1.chkSum.checkstate) == 0 then
		contMain.cont1.chkSum.chksilence = "1"
		contMain.cont1.imgCheck.imgpath = "checkmenu_o.png"
		
		g_szSumYN = "N"
		
	else
		contMain.cont1.chkSum.chksilence = "0"
		contMain.cont1.imgCheck.imgpath = "checkmenu_n.png"
		
		g_szSumYN = "Y"
		
	end if
	
	f_sendQry()
End Sub

'============================================================================
Sub contMain_cont1_tblInfo_OnClick(lRow , lColumn)
'	Form.ShowAlert("tblInfo_OnClick1", lRow .. " : " .. lColumn)
	
	if (lRow == 3) and (lColumn == 2) then
'		Form.ShowAlert("tblInfo_OnClick2", lRow .. " : " .. lColumn)
		contMain_cont1_imgarrow_OnClick()
	end if
End Sub

'============================================================================
Sub contMain_cont1_btnDetail_OnClick()
	contMain_cont1_imgarrow_OnClick()
End Sub

'============================================================================
Sub contMain_cont1_imgarrow_OnClick()
	Dim szAcc
	
	'보유계좌 상품별 자산현황 화면으로 연결 mbact71052_t1, mbact71052_t2 참고
	if UBound(g_szList) > 1 then
		'0 종합계좌 개수
		'1 종합계좌 리스트
		'2 개별계좌개수
		'3 개별계좌 리스트(ACNo + ASNo)
		'4 개별계좌명 리스트([상품명]계좌번호)
		'5 계좌개수☆개별계좌의 그룹인덱스
		'6 선택한 계좌번호
		'7 선택한 계좌seq
		'8 비밀번호
		
		Form.SetSharedData("71052_Index" , g_szList(5) )	'계좌개수☆개별계좌의 그룹인덱스
		
		if g_szSelectAcc == "전체" then
			szAcc = "t1"
		else
			szAcc = "t2"
		end if
		
		'국내채권 탭으로 설정
		szData = "7"			& "☆" & 				'0 tab인덱스
				g_szList(0)	& "☆" & 				'1 종합계좌개수
				szAcc		& "☆" & 				'2 탭
				g_szSelectAcc..g_szSelectAccSeq	& "☆" & '3 선택계좌번호
				"○" & g_szList(1)	& "☆" & 		'4 종합계좌리스트
				g_szList(2)	& "☆" & 				'5 개별계좌개수
				"○" & g_szList(3)	& "☆" & 		'6 개별계좌리스트
				"○" & g_szList(4) 					'7 개별계좌리스트(계좌번호+계좌명)
				
'		Form.ShowAlert("imgarrow_OnClick", szData)					
		Form.OpenPopup( "mbact71052_p1" , szData , "")
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl90301_p6" then
		f_callBondOrder()
		
	end if
	
End Sub

'============================================================================
Sub contMain_gridData_OnClickUp(lRow, szCellID)
	Dim szData, szLinkData, szCode, szUserID, szLoadDate, szToday
	
	if szCellID == "bd_date2" then
		
		if g_bSingle then
			szData = contMain.gridDataSingle.GetCellData("BYOV_DATE", lRow)
		else
			szData = contMain.gridData.GetCellData("BYOV_DATE", lRow)
		end if
		
		'매수일별보기 선택시
		if szData = "00000000" then
			szLinkData = contMain.gridData.GetCellData("ISCD",					lRow)	'0 종목코드
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ISNM",		lRow)	'1 종목명
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ACNO",		lRow)	'2 ACNO
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ASNO",		lRow)	'3 ASNO
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("MTRT_DATE",	lRow)	'4 만기일
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_AMT",	lRow)	'5 평가금액
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("RMND_QTY",	lRow)	'6 보유수량
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYNG_AMT",	lRow)	'7 매입총액
						
'			Form.OpenPopup("mbonl90301_p3", szLinkData, "")
			Form.OpenPopupAnimation("mbonl90301_p3", szLinkData,  "",  2)
			
		else
			szLinkData = contMain.gridData.GetCellData("ISNM", 							lRow)	'0 종목명
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ISCD",			lRow)	'1 종목코드
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_AMT",		lRow)	'2 평가금액
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_PRLS_AMT",	lRow)	'3 평가손익금액
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYOV_ERT",		lRow)	'4 매수수익률
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("RMND_OWN_TYPE_NAME",lRow)	'5 잔고소유유형명
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("RMND_QTY",		lRow)	'6 잔고수량
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYNG_UNPR",		lRow)	'7 매입단가
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_UNPR",		lRow)	'8 평가단가(민평단가)
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYOV_DATE",		lRow)	'9 매수일자
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("MTRT_DATE",		lRow)	'10 만기일자
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("LOAN_AMT",		lRow)	'11 대출금액
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("LOAN_DATE",		lRow)	'12 대출일자
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("LOAN_MTRT_DATE",	lRow)	'13 대출만기일자
			
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ACNO",			lRow)	'14 계좌번호
			szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ASNO",			lRow)	'15 계좌일련번호
			
'			Form.ShowAlert("gridData_OnClickUp1", szLinkData)
'			Form.OpenPopup("mbonl90301_p2", szLinkData, "")
			Form.OpenPopupAnimation("mbonl90301_p2", szLinkData,  "",  2)
			
		end if
	
	elseif szCellID == "bd_badge3" then
		'대용채권/대출채권 가이드
		szToolTipText = "대출채권/대용채권의 경우 MTS에서 주문 할 수 없어요. HTS를 이용해주세요."
	
		Form.ShowAlert("안내", szToolTipText)	
	
	elseif szCellID == "bd_sell" then
		'매도버튼 클릭시
		
		szTemp1 = contMain.gridData.GetCellData("PROS_TRGT_CLS_CODE",		lRow)	'처리대상구분코드
		szTemp2 = contMain.gridData.GetCellData("RMND_CLCD",				lRow)	'잔고구분코드
		
'		Form.ShowAlert("안내", szTemp1 .. " : " .. szTemp2)
		
		'채권일 경우만 처리
		if szTemp1 == "1" and szTemp2 == "1" then
			if contMain.gridData.GetCellData("BYOV_DATE", lRow) == "00000000" then '종목별 합산보기시에는 매도버튼 비활성
				exit sub
			
			end if
			
			szCode = contMain.gridData.GetCellData("ISCD", lRow)
			
			szData = Form.GetItemCodeInfo(szCode, "innermarket")
			if Trim(szData) == "" then
				Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
				
				Exit Sub
			end if
			
			szUserID = Form.GetSharedData("&USER_ID" , false)
			szToday = Form.GetSharedData("&HOST_DATE", false)
			
			'팝업 화면에서 오늘 열지 않기 여부 확인
			szLoadDate = Form.LoadConfigData("NoticeSetting", szUserID & "_BondSellNotice")
			
			g_iSelectedRow = lRow
			
			if (szLoadDate == "") or (szLoadDate <> szToday) then
	'			Form.OpenPopup("mbonl90301_p6", "", "")
				Form.OpenPopupAnimation("mbonl90301_p6", "",  "",  2)
				
			else
				f_callBondOrder()
			end if
		end if
	
	else				
		szLinkData = contMain.gridData.GetCellData("ISNM", lRow)								'0 종목명
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ISCD",			lRow)	'1 종목코드
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_AMT",		lRow)	'2 평가금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_PRLS_AMT",	lRow)	'3 평가손익금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYOV_ERT",		lRow)	'4 매수수익률
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("RMND_OWN_TYPE_NAME",lRow)	'5 잔고소유유형명
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("RMND_QTY",		lRow)	'6 잔고수량
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYNG_UNPR",		lRow)	'7 매입단가
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_UNPR",		lRow)	'8 평가단가(민평단가)
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYOV_DATE",		lRow)	'9 매수일자
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("MTRT_DATE",		lRow)	'10 만기일자
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("LOAN_AMT",		lRow)	'11 대출금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("LOAN_DATE",		lRow)	'12 대출일자
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("LOAN_MTRT_DATE",	lRow)	'13 대출만기일자
		
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ACNO",	lRow)	'14 계좌번호
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ASNO",	lRow)	'15 계좌일련번호
		
'		Form.ShowAlert("gridData_OnClickUp2", szLinkData)
		
		'채권보유 현황 상세
'		Form.OpenPopup("mbonl90301_p2", szLinkData, "")
		Form.OpenPopupAnimation("mbonl90301_p2", szLinkData,  "",  2)
		
	end if
End Sub

