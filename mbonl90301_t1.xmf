			if (szLoadDate == "") or (szLoadDate <> szToday) then
	'			Form.OpenPopup("mbonl90301_p6", "", "")
				Form.OpenPopupAnimation("mbonl90301_p6", "",  "",  2)
				
			else
				f_callBondOrder()
			end if
		end if
		
	elseif szCellID == "bd_badge3" then
		'대용채권/대출채권 가이드
		Form.ShowAlert("안내", "")
	
	else
		szLinkData = contMain.gridDataSingle.GetCellData("ISNM", lRow)								'0 종목명
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("ISCD",			lRow)	'1 종목코드
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("VLTN_AMT",		lRow)	'2 평가금액
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("VLTN_PRLS_AMT",	lRow)	'3 평가손익금액
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("BYOV_ERT",		lRow)	'4 매수수익률
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("RMND_OWN_TYPE_NAME",lRow)	'5 잔고소유유형명
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("RMND_QTY",		lRow)	'6 잔고수량
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("BYNG_UNPR",		lRow)	'7 매입단가
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("VLTN_UNPR",		lRow)	'8 평가단가(민평단가)
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("BYOV_DATE",		lRow)	'9 매수일자
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("MTRT_DATE",		lRow)	'10 만기일자
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("LOAN_AMT",		lRow)	'11 대출금액
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("LOAN_DATE",		lRow)	'12 대출일자
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("LOAN_MTRT_DATE",	lRow)	'13 대출만기일자
		
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("ACNO",	lRow)	'14 계좌번호
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("ASNO",	lRow)	'15 계좌일련번호

'		Form.ShowAlert("gridData_OnClickUp2", szLinkData)
		
		'채권보유 현황 상세
