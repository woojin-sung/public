	<SCRIPT_INFO _len="18543" _ulen="17417" >
'v001 20220524 아이티젠 김성수 : 소수점 표기기능 추가(그리드 잔고수량 셀 마스킹 숫자>문자 변경)
'============================================================================
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
Dim g_nGrdRowCnt
Dim g_nSelectRow
'============================================================================
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "02")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Function Asset_Request()
	'--------------------------------------------------------------
	' 전역변수 초기화
	'--------------------------------------------------------------	
	'대상계좌 개수 세팅
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	'서비스 날리기전 인덱스 초기화
	g_nNextCount = 0
	
	'--------------------------------------------------------------
	'서비스 호출
	'--------------------------------------------------------------
	'Y:전체 그외:개별

	if g_szList(1) == "Y" then
		grd0.rowcount = 0
		cont0.grd1.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.ClearInputData(0, "obacb_balc_137r")
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "WRAP_ACNT_YN" , 0 , "Y")
	'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "UI_UNIT_CLS" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "IQRY_CLS_CODE" , 0 , "" )	
		
		DATAMANAGER.RequestTranData( "obacb_balc_137r" )
	end if
End Function

'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd0.SetClear()
	cont0.grd1.SetClear()
	cont0.lblNone.visible = false
	
	if sEventName == "mbact71052_p10" then			'주식/채권
		g_szList = Split(sParam,"○")

		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		'상단 카드뷰 평가금액 서비스 호출 후 자산조회
		call VltnAmt_Request()
	end if

End Sub
'============================================================================
Function AllSearch()
	g_nAllCount = CInt(g_nAllCount) - 1
	if g_nAllCount > 2 then
		DATAMANAGER.ClearInputData(0, "obacb_balc_137r")
		
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "ACNO" , 0 , Left(g_szList(g_nAllCount), 8) ) '계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "UI_UNIT_CLS" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "WRAP_ACNT_YN" , 0 , "Y")

		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "IQRY_CLS_CODE" , 0 , "" )	'
		
		DATAMANAGER.RequestTranData( "obacb_balc_137r" )
	else
		lblVisible()
	end if

	
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	grd0.SetClear()
	cont0.grd1.SetClear()
	g_nNextCount = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	cont0.imgTooltip.imgpath = "icon_question"
	g_nAllCount = 0
	'hsz
	szDate = right(Form.GetSharedData("&HOST_DATE" , false), 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
	'hsz
	
	nWidth = Form.getTextWidth("보유잔고",-2,true,false)
	
	cont0.imgTooltip.left = 20 + nWidth + 5
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, 
	    szTemp12, szTemp13, szTemp14, szTemp15, szTemp16, nTemp17, szTempcode, szTempcdnm, szTempacnt, szTempacno, szTempasno, szTempname, TempCount
	    
	if szTranID = "obacb_balc_137r" then
		for i = 0 to DATAMANAGER.GetDataCount(0, "obacb_balc_137r" , "OutBlock1") - 1
			grd0.AddRow()
			cont0.grd1.AddRow()
			
			szTemp1  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ACNO" , i)		'계좌번호
			szTemp2  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ISCD" , i)		'종목코드
			szTemp3  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ISNM" , i)		'종목명
			szTemp4  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "RMND_QTY" , i)		'잔고수량
			szTemp5  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "BYNG_AMT" , i)		'매입금액
			szTemp6  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "VLTN_AMT" , i)		'평가금액
			szTemp7  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp8  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ERT" , i)			'수익률
			szTemp9  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i)	'해외주식시장거래구분코드
			szTemp10 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "CRCD" , i)		'통화코드
			szTemp11 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ACNT_PRNM" , i)	'계좌상품명
			szTemp12 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "MKSC_CLS_NAME" , i)	'유가증권구분명
			szTemp13 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "LOAN_DATE" , i)	'대출일자
			szTemp14 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "MTRT_DATE" , i)	'만기일자
			szTemp15 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "LOAN_SRNO" , i)	'대출일련번호
			szTemp16 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "RMND_DQTY" , i)	'잔고소수점수량
			nTemp17  = CDbl(szTemp4) + CDbl(szTemp16) 'v001
			TempCount = Len(szTemp11)
			
			'20230925 현재가, 기준가 추가
			szTemp18 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "PSNT_PRC" , i)	'현재가
			
			szTempcode = szTemp9
			szTempacno = szTemp1
			szTempasno = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ASNO" , i)
			szTempname = Mid(szTemp11,3,TempCount-2)
			
			szTempacnt = Left(szTempacno, 4) & "-" & Right(szTempacno, 4) & "-" & szTempasno
			
			if szTempcode = "01" then
				szTempcdnm = "미국"
			elseif szTempcode = "02" then
				szTempcdnm = "홍콩"
			elseif szTempcode = "03" then
				szTempcdnm = "상해"
			elseif szTempcode = "04" then
				szTempcdnm = "심천"
			end if
			
			grd0.SetCellData("bd_cell0" , g_nNextCount, szTempacnt)
			grd0.SetCellData("bd_cell1" , g_nNextCount, szTemp2)
			grd0.SetCellData("bd_cell2" , g_nNextCount, szTemp3)
'			grd0.SetCellData("bd_cell3" , g_nNextCount, szTemp4) 'v001
			grd0.SetCellData("bd_cell4" , g_nNextCount, szTemp5)
			grd0.SetCellData("bd_cell5" , g_nNextCount, szTemp6)
			grd0.SetCellData("bd_cell6" , g_nNextCount, szTemp7)
			grd0.SetCellData("bd_cell7" , g_nNextCount, szTemp8)
			grd0.SetCellData("bd_cell8" , g_nNextCount, szTempcdnm)
			grd0.SetCellData("bd_cell9" , g_nNextCount, szTemp10)
			grd0.SetCellData("bd_cell10", g_nNextCount, szTemp11)
			grd0.SetCellData("bd_cell15", g_nNextCount, szTemp12)
			grd0.SetCellData("bd_cell11", g_nNextCount, szTemp13)
			grd0.SetCellData("bd_cell14", g_nNextCount, szTemp14)
			grd0.SetCellData("bd_cell12", g_nNextCount, szTemp15)
			grd0.SetCellData("bd_cell13", g_nNextCount, szTempname)
			grd0.SetCellData("bd_cell16", g_nNextCount, szTempacno..szTempasno)
			
			'20230925 현재가, 기준가 추가
			grd0.SetCellData("bd_cell17", g_nNextCount, szTemp18)
			
			'v001 START
			if Trim(szTemp12) == "소수점" then
				grd0.SetCellData("bd_cell3" , g_nNextCount, FormatNumber(nTemp17,6))
			else
				grd0.SetCellData("bd_cell3" , g_nNextCount, FormatNumber(nTemp17,0))
			end if
			'v001 END
			
			' 시장별 실시간여부값
			szMk = Right(szTemp2, 2)
			szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )					
			
			' 실시간
			if szRealAble == "0" then
				cont0.grd1.SetCellData( "bd_real", g_nNextCount, "realtime_red" )
			' 실시간아님
			elseif szRealAble == "1" then
				cont0.grd1.SetCellData( "bd_real", g_nNextCount, "realtime_gray" )
			end if
					
			szTemp5  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "BYNG_UNPR" , i)
			szTemp11 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "MKSC_CLS_NAME" , i)
			szTemp12 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "LOAN_AMT" , i)
			szTemp13 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "MTRT_DATE" , i)
			szTempacnt = szTempacnt&szTempname
			if g_szList(1) == "Y" then
				cont0.grd1.SetCellData("bd_cell0" , g_nNextCount, szTempacnt) '계좌번호
			end if
			cont0.grd1.SetCellData("bd_cell12", g_nNextCount, "| 매입가")
			cont0.grd1.SetCellData("bd_cell1" , g_nNextCount, szTemp2) '종목코드
			cont0.grd1.SetCellData("bd_cell2" , g_nNextCount, szTemp3) '종목명
'			cont0.grd1.SetCellData("bd_cell3" , g_nNextCount, szTemp4) 'v001 보유잔고수
			cont0.grd1.SetCellData("bd_cell4" , g_nNextCount, szTemp5) '매입가격
			cont0.grd1.SetCellData("bd_cell5" , g_nNextCount, szTemp6)  '평가가격
			cont0.grd1.SetCellData("bd_cell9" , g_nNextCount, szTemp10) '화폐
'			cont0.grd1.SetCellData("bd_cell6" , g_nNextCount, szTemp7)  '평가손익
'			cont0.grd1.SetCellData("bd_cell7" , g_nNextCount, szTemp8)  '평가손익률
			cont0.grd1.SetCellData("bd_cell10", g_nNextCount, szTemp11) '잔고구분
			if Clng(szTemp12) > 0 then 'szTemp11 = "대출" then
				szJango = "대출"
				cont0.grd1.SetCellImage("bd_img", g_nNextCount, "btn_blue_bg_02.9.png")
				cont0.grd1.SetCellData("bd_img", g_nNextCount, szJango)
				cont0.grd1.SetCellData("bd_cell15", g_nNextCount, szTemp12) '대출금액
				cont0.grd1.SetCellData("bd_cell11", g_nNextCount, mid(szTemp13, 3, 2)&"."&mid(szTemp13, 5, 2)&"."&right(szTemp13,2)) '만기일
				cont0.grd1.SetCellFgColor("bd_img", g_nNextCount, "250")
			end if
			
			if CDBL(szTemp8) > 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , "+"..FormatNumber(szTemp7, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , "+"..FormatNumber(szTemp8, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
			elseif CDBL(szTemp8) < 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp7, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp8, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp7, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp8, 2))
			end if
			
			'v001 START
			if Trim(szTemp11) == "소수점" then
				cont0.grd1.SetCellData("bd_cell3" , g_nNextCount, FormatNumber(nTemp17,6))
			else
				cont0.grd1.SetCellData("bd_cell3" , g_nNextCount, FormatNumber(nTemp17,0))
			end if
			'v001 END
			
			g_nNextCount = g_nNextCount + 1
			
		next
		
		grd0.rowcount = g_nNextCount
		cont0.grd1.rowcount = g_nNextCount
		
		if DATAMANAGER.IsMoreNextData( "obacb_balc_137r" ) == True then 
			DATAMANAGER.RequestNextData( "obacb_balc_137r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if
		
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		if CDBL(nPrlsrate) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0).."원   |   +"..FormatNumber(nPrlsrate,2).."%"
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsrate) < 0 then
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "4")
		end if
		call Asset_Request()
	
	
	'계좌번호로 ID연결여부 조회
	elseif szTranID == "obcsb_efif_264r" then
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ID_LNKN_YN" , 0)
		
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		'종목명, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 체결잔고, 매입단가, 대출금, 대출일, 만기일, 종목코드, 통화코드
		Dim szSendData
		Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, szTemp12
		szTemp1 = grd0.GetCellData("bd_cell2", g_nSelectRow)
		szTemp2 = grd0.GetCellData("bd_cell5", g_nSelectRow)
		szTemp3 = grd0.GetCellData("bd_cell4", g_nSelectRow)
		szTemp4 = grd0.GetCellData("bd_cell6", g_nSelectRow)
		szTemp5 = grd0.GetCellData("bd_cell7", g_nSelectRow)
		szTemp6 = grd0.GetCellData("bd_cell15", g_nSelectRow)
		szTemp7 = grd0.GetCellData("bd_cell3", g_nSelectRow)
		
		szTemp8 = cont0.grd1.GetCellData("bd_cell4", g_nSelectRow)
		szTemp9 = cont0.grd1.GetCellData("bd_cell15", g_nSelectRow)
		szTemp10 = grd0.GetCellData("bd_cell11", g_nSelectRow)
		szTemp11 = grd0.GetCellData("bd_cell14", g_nSelectRow)
		szTemp12 = grd0.GetCellData("bd_cell1", g_nSelectRow)
		if szTemp9 == "" or szTemp9 == null then
			szTemp9 = 0
			szTemp10 = " - "
			szTemp11 = " - "
		end if
		szTemp13 = grd0.GetCellData("bd_cell9", g_nSelectRow)
		
		'20230925 현재가, 기준가 추가
		szTemp14 = grd0.GetCellData("bd_cell17", g_nSelectRow)
		
		szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10 & "☆" & szTemp11 & "☆" & szTemp12 & "☆" & szTemp13 & "☆" & szTemp14
		
	'	Form.ShowAlert("szSendData", szSendData)
		
		Form.OpenPopupAnimation("mbact71052_pb", szSendData, "", "2")
	end if

End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.imgRed.setMaintaingRatio("1")
	cont0.imgGray.setMaintaingRatio("1")
	cont0.imgTooltip.maintainratio = "1"
	
	cont0.grd1.setMaintainingRatio("bd_real", 0, "1")
End Sub

'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.lblNone.visible = true
	else
		cont0.lblNone.visible = false
	end if
End Function 

