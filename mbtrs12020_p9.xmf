	<SCRIPT_INFO _len="5399" _ulen="4925" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 기간설정 창
' 03. 작    성 : 2016.07.15 NOHES
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************



'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	sData = Form.GetOpenLinkData()
	Form.SetCtlProp("cmbRange", "currentindex", sData)
	
	If cmbRange.currentindex == "0" Then
		cldStart.visible = False
		Label0.visible = False
		cldFinish.visible = False
	Else
		cldStart.visible = True
		Label0.visible = True
		cldFinish.visible = True
	End If
		
	cmbRange.enable = False
	DATAMANAGER.RequestTranData( "obtrs_oder_507r" )
End Sub


'============================================================================
Sub btnChange_OnClick()
	cmbRange.enable = True
	If cmbRange.currentindex == "0" Then
		cldStart.visible = False
		Label0.visible = False
		cldFinish.visible = False
	Else
		cldStart.visible = True
		Label0.visible = True
		cldFinish.visible = True
	End If
	
End Sub


'============================================================================
Sub btnOK_OnClick()
	If cmbRange.currentindex <> 0 Then
		If cldStart.caption == "" or Len(cldStart.caption) <> 8 Then
			ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
			Exit Sub
		End If
		
		If cldFinish.caption == "" or Len(cldFinish.caption) <> 8 Then
			ShowAlert "기간설정", "예약주문 종료일자가 유효하지 않습니다."
			Exit Sub
		End If
		
		If CDbl(cldStart.caption) > CDbl(cldFinish.caption) Then
			ShowAlert "기간설정", "기간예약 종료일이 시작일보다 앞설 수 없습니다."
			Exit Sub
		End If
		
		sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& cldStart.caption &"★"& cldFinish.caption
	Else
		sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& "" &"★"& ""
	
	End If
		
	Form.SendReturnToParent("Range" , sLnkData)

	Form.CloseForm()
End Sub

'============================================================================
Sub cldStart_OnEditComplete()
	If Len(cldStart.caption) <> 8 Then
		ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
		cldStart.caption = ""
		Exit Sub
	End If
	
	If CDbl(cldStart.caption) > CDbl(cldadd30.caption) Then
		ShowAlert "기간설정", "주문예약기간은 30일 이내만 지정가능합니다."
		cldStart.caption = cldadd30.caption
		cldFinish.caption = cldadd30.caption
		Exit Sub
	End If
	If CDbl(cldStart.caption) < CDbl(cldHost.caption) Then
		ShowAlert "기간설정", "시작일을 오늘날짜로 변경합니다.(당일 이후 날짜부터 지정 가능)"
		cldStart.caption = cldHost.caption
	End If
	
End Sub

'============================================================================
Sub cldFinish_OnEditComplete()
	If Len(cldFinish.caption) <> 8 Then
		ShowAlert "기간설정", "예약주문 종료일자가 유효하지 않습니다."
		cldFinish.caption = ""
		Exit Sub
	End If
		
	If cldadd30.caption == "" Then
		ShowAlert "기간설정", "예약 시작날짜를 확인해주십시오."
		Exit Sub
	End If
	If CDbl(cldFinish.caption) > CDbl(cldadd30.caption) Then
		ShowAlert "기간설정", "주문예약기간은 30일 이내만 지정가능합니다.(종료일자 30일 이후 지정 불가)"
		cldFinish.caption = cldadd30.caption
		Exit Sub
	End If
	
End Sub

'============================================================================
Sub cmbRange_OnEditComplete(iIndex)
	If iIndex == 0  Then
		cldStart.caption = cldHost.caption
		cldFinish.caption = cldHost.caption
		cldStart.visible = False
		Label0.visible = False
		cldFinish.visible = False
	Else
		cldStart.visible = True
		Label0.visible = True
		cldFinish.visible = True
	End If
	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtrs_oder_507r" Then
		cldStart.caption = DATAMANAGER.GetDataValue(0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE"  , 0)
		cldFinish.caption =  DATAMANAGER.GetDataValue(0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE"  , 0)
		cldHost.caption =  DATAMANAGER.GetDataValue(0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE"  , 0)
		cldadd30.caption =  DATAMANAGER.GetDataValue(0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE"  , 0)
		Form.SetCtlProp("cldadd30", "addday", "30")
	End If
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtrs_oder_507r" trcode="obtrs_oder_507r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtrs_oder_507r" title="예약주문 일자 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="42" _ulen="32" >

SVCD^서비스코드^3^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="44" _ulen="36" >

ODER_DATE^주문일자^8^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
