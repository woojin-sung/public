'============================================================================
' 01. 화 면 명 : Home 화면 My자산 로그인
' 02. 화면설명 : Home 화면 My자산 로그인시 자산 조회 화면
' 03. 작    성 : 2024. 01. 25. KIS
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim nCellType			'토글 상태를 구분하기 위한 변수
Dim szCSNO			'고객번호
Dim szACNO			'계좌번호
Dim szASNO             '계좌일련번호'
Dim szUSERID           '사용자ID' 
Dim g_szNm
Dim strSwitchIndex      '자산숨김 토글 인덱스'

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

Sub Set_RequestData()

    szUSERID = Form.GetSharedData("&USER_ID", false )
    szCSNO = Form.GetSharedData("&CUST_NUM", false )

    If Trim(Account0.caption) == "ALL" then
	
   	   szACNO = ""

     
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_151r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_151r", "InBlock1", "ELFN_ID" , 0 , szUSERID)
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_151r", "InBlock1", "CSNO" , 0 , szCSNO)
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_151r", "InBlock1", "ACNO" , 0 , szACNO)

        DATAMANAGER.RequestTranData( "obacb_balc_151r" )
     
     Elseif Trim(Account0.caption) <> "" Then
     
   	   szACNO = Trim(Account0.total)
	   szASNO = Trim(Account0.sequence)


'Form.ShowAlert("ACNO", szACNO)
'Form.ShowAlert("ASNO", szASNO)
'Form.ShowAlert("CSNO", szCSNO)


        DATAMANAGER.SetDataValue( 0 , "obacb_balc_154r", "InBlock1", "ACNO" , 0 , szACNO)
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_154r", "InBlock1", "ASNO" , 0 , szASNO)
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "00")
        DATAMANAGER.SetDataValue( 0 , "obacb_balc_154r", "InBlock1", "CSNO" , 0 , szCSNO)

        DATAMANAGER.RequestTranData( "obacb_balc_154r" )     
     
     End If
     
End Sub

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()		
'============================================================================
Sub Form_OnFormInit()
     Account0.SetTotalEnable(true)  '전체계좌 추가
	g_szNm = Form.GetSharedData("&USER_NAME", false)
	LabelCSNM.caption = g_szNm & "님"

     'Button0.setApplySwitch("OFF", "ON", "294", "200", "270", "249") 'CI색상
      Button0.setApplySwitch2( "295", "323", "347", "390") '스위치버튼 2 : ON/OFF 글자 없는 버전


	szDate = right(Form.GetSharedData("&HOST_DATE" , false), 6)
	Container0.lblDate.caption = szDate
	
	'저장된 스위치 인덱스 값을 가져오기
	Button0.switchindex = Form.GetEnvData("SWID_VALUE_SAVE") 
	Button0_OnClick() 'SwitchIndex 값에 따라 컨트롤 크기와 위치를 조정함
	
    'Account0.visible = False  ' 계좌콤보 숨기기
    
    Account0_ChangeAccount()        
    
    If Button0.switchindex = "0" Then
     Set_RequestData()  'Input Data Setting / Request Data
    End If 
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    
    Dim nPrlsrate 
    Dim nPrlsamt 
    Dim nVltnamt 


	if szTranID == "obacb_balc_151r" then
	    nVltnamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_151r", "OutBlock1", "VLTN_AMT" , 0)		'평가금액
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_151r", "OutBlock1", "PLRT" , 0)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_151r", "OutBlock1", "VLTN_PRLS_AMT" , 0)	'평가손익
		if CDBL(nPrlsamt) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0).."원   |   +"..FormatNumber(nPrlsrate,2).."%"
			Container0.Table0.SetCellString(0, 1, szPrls)
			Container0.Table0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsamt) < 0 then
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			Container0.Table0.SetCellString(0, 1, szPrls)
			Container0.Table0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			Container0.Table0.SetCellString(0, 1, szPrls)
			Container0.Table0.SetCellFgColor(0, 1, "4")
		end if
	
	    Container0.LblTotal.Caption = nVltnamt
		
	Elseif szTranID == "obacb_balc_154r" Then
	    nVltnamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_AMT" , 0)		'평가금액
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , 0)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , 0)	'평가손익
		if CDBL(nPrlsamt) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0).."원   |   +"..FormatNumber(nPrlsrate,2).."%"
			Container0.Table0.SetCellString(0, 1, szPrls)
			Container0.Table0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsamt) < 0 then
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			Container0.Table0.SetCellString(0, 1, szPrls)
			Container0.Table0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			Container0.Table0.SetCellString(0, 1, szPrls)
			Container0.Table0.SetCellFgColor(0, 1, "4")
		end if
		
		Container0.LblTotal.Caption = nVltnamt
		
	End if
	
	
     '컨트롤 위치 이동 / 펼침 (자산보임)
    
    Container0.ImageArrowR.visible = True
    Container0.ImageRefresh.visible = True
    Container0.Table0.visible = True
    Container0.LblTotal.fgcolor = "004"  '(RGB:000/000/000 : 004)
   'Container0.LblTotal.Caption = ""
    Container0.LblTotal.mask = "0,0, , ,1,'',0,1,1"  
   '(Mask property :숫자or문자 / 0표시여부 / prefix / postfix /마스크처리여부 / 마스크포맷 / 소수점 자리수/천단위 부호표시 여부 / - 부호표시 여부)

    Container0.Table0.visible = True
	
    Container0.ImageBtn1.Top = 170
    Container0.ImageBtn2.Top = 170
    Container0.LabelBtn1.Top = 170
    Container0.LabelBtn2.Top = 170
    Container0.height = 229
    Container0.ImageCrd.height = 229
	
End Sub
'============================================================================

Sub Container0_ImgRefresh_OnClick()

	Set_RequestData()  'Input Data Setting / Request Data

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================

Sub Button0_OnClick()

    strSwitchIndex = Button0.switchindex

    'Form.MsgBox("알림", strSwitchIndex , strSwitchIndex, 0)

    If strSwitchIndex = "1" Then  'Switch ON
	  
    '1. 숨김처리
       Container0.ImageArrowR.visible = False
       Container0.ImageRefresh.visible = False
       Container0.Table0.visible = False
       Container0.LblTotal.fgcolor = "295"  '(RGB:153/153/153 : 295)
       Container0.LblTotal.Caption = "금액숨김"
       Container0.LblTotal.mask = "1,0, , ,0,'',0,0,0"  
     '(Mask property :숫자or문자 / 0표시여부 / prefix / postfix /마스크처리여부 / 마스크포맷 / 소수점 자리수/천단위 부호표시 여부 / - 부호표시 여부)
    
    '2. 사이즈 조정 (축소)
        
       Container0.ImageBtn1.Top = 110
       Container0.ImageBtn2.Top = 110
       Container0.LabelBtn1.Top = 110
       Container0.LabelBtn2.Top = 110
       Container0.height = 163
       Container0.ImageCrd.height = 163
       
       Form.SetEnvData(1, "SWID_VALUE_SAVE", strSwitchIndex)

	 
    Elseif strSwitchIndex = "0" Then  'Switch OFF'

    '1. 보임처리 

       Set_RequestData()  'Input Data Setting / Request Data / 컨트롤 보임처리  


    '2. 사이즈 조정 (확대))

      '컨트롤 위치 이동 / 펼침 (자산보임)

       Container0.ImageBtn1.Top = 170
       Container0.ImageBtn2.Top = 170
       Container0.LabelBtn1.Top = 170
       Container0.LabelBtn2.Top = 170
       Container0.height = 229
       Container0.ImageCrd.height = 229
       'Container0.LblTotal.Caption = ""
 
    End If
   

    'Down Arrow 위치 조정
    If Trim(Account0.caption) == "ALL" Then
       Container0.ImageArrowDn.left = "90"
    Else
       Container0.ImageArrowDn.left = "140"						    
    End if
   
   
   
   '부모창에 스위치 값 넘거주기
    Form.triggerEvent( "#", "SWID", strSwitchIndex) 
    Form.SetEnvData(1, "SWID_VALUE_SAVE", strSwitchIndex)

End Sub

