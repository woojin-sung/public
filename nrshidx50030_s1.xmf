'============================================================================
Sub Account0_ChangeAccount()

    if Trim(Account0.caption) == "ALL" then
    
       Container0.lblAcct.Caption = "전체계좌"
       Container0.ImageArrowDn.left = "90"
       
    else

'       Container0.lblAcct.Caption = "[" & Account0.accproductshortname & "]" 
'                                     & MID(Account0.total, 1,4) & "-" & MID(Account0.total, 1,4) 
'                                     & "-" & Account0.sequence
						    
       Container0.lblAcct.Caption =   MID(Account0.total, 1,4) & "-" & MID(Account0.total, 5,4) 
				                    & "-" & Account0.sequence
						    
       Container0.ImageArrowDn.left = "140"						    
    end if
    
   
   If Button0.switchindex = "0" Then 
      Set_RequestData()  'Input Data Setting / Request Data / 컨트롤 보임처리 
   end if
    
End Sub

