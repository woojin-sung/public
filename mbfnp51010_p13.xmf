	<SCRIPT_INFO _len="1389" _ulen="1319" >
'============================================================================
Sub Form_OnFormInit()
	Dim szUnfitYn
	szUnfitYn = Form.GetOpenLinkData()
	
	if szUnfitYn == "Y" then
		lblResult.caption = "일치하지 않습니다."
		tblResult.SetCellString( 0, 1, "불일치" )
		tblResult.SetCellFgColor( 0, 1, "10" )
		
		tblHgdtDesc.top = 371
'		ChkButton0.top = 471
'		btnNext.top = 523
'		Form.height = 583
		
		tblNoti.visible = true
		
		btnNext.left = 20
		btnCancel.left = 190
	else
		lblResult.caption = "일치합니다."
		tblResult.SetCellString( 0, 1, "일치" )
		tblResult.SetCellFgColor( 0, 1, "11" )
		
		tblHgdtDesc.top = 271
'		ChkButton0.top = 371
'		btnNext.top = 423
'		Form.height = 483
		
		tblNoti.visible = false
	end if
End Sub

'============================================================================
' btnNext_OnClick() : 계속 진행
'============================================================================
Sub btnNext_OnClick()
	if tonumber(ChkButton0.checkstate) == 0 then
		Form.ShowAlert("알림", "체크박스를 확인해주세요")
	else
		Form.SendReturnToParent( "close_mbfnp51010_p13" , "OK" )
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.SendReturnToParent( "close_mbfnp51010_p13" , "CANCEL" )
	Form.CloseForm()
End Sub

