	<SCRIPT_INFO _len="5079" _ulen="4369" >
Dim gTextSize
gTextSize = -2

'============================================================================
Sub Form_OnFormInitBefore()

	Container0.Image0.setMaintainingRatio("1")

	'--------------------------------------------------------------
	' 라벨 투명모드
	'--------------------------------------------------------------
	Container0.Label1.transmode = "1"
	Container0.Label2.transmode = "1"
	Container0.Label3.transmode = "1"
	Container0.Label4.transmode = "1"
	Container0.Label5.transmode = "1"
	Container0.Label6.transmode = "1"
	Container0.Label7.transmode = "1"
	Container0.Label8.transmode = "1"
	Container0.Label9.transmode = "1"
	Container0.Label10.transmode = "1"
	Container0.Label11.transmode = "1"
	
	'--------------------------------------------------------------
	' 라벨 패딩값 설정
	'--------------------------------------------------------------
	Container0.Label1.paddinginfo = "0,0,0,0"
	Container0.Label2.paddinginfo = "0,0,0,0"
	Container0.Label3.paddinginfo = "0,0,0,0"
	Container0.Label4.paddinginfo = "0,0,0,0"
	Container0.Label5.paddinginfo = "0,0,0,0"
	Container0.Label6.paddinginfo = "0,0,0,0"
	Container0.Label7.paddinginfo = "0,0,0,0"
	Container0.Label8.paddinginfo = "0,0,0,0"
	Container0.Label9.paddinginfo = "0,0,0,0"
	Container0.Label10.paddinginfo = "0,0,0,0"
	Container0.Label11.paddinginfo = "0,0,0,0"
	
	'--------------------------------------------------------------
	' 큰글씨 모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
	
		gTextSize = - Cint((szTextSize * 2)) + 1
		
		Container0.Label1.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label2.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label3.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label4.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label5.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label6.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label7.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label8.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label9.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label10.fontsize = - Cint((szTextSize * 2)) + 1
		Container0.Label11.fontsize = - Cint((szTextSize * 2)) + 1
		
	end if
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	Container0.Label1.caption = "· 조회 시점의 시세로 잔고가 조회돼요"
	Container0.Label2.caption = "· 실시간 시세 신청 기준에 따라\n   실시간/지연 시세가 반영되어 조회 돼요"
	Container0.Label3.caption = "· 미국 주간거래, Pre Market, 정규장 시장은\n   해당 시장의 시세가 반영되어 조회 돼요"
	Container0.Label4.caption = "· 잔고 조회 시, 매입금액의 소수점 자리 수 표기에\n   따라 단가가 변경 될 수 있어요"
