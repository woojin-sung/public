'============================================================================
' 작성 : 2021.06.18 ksj
' 2021-10-21 : KSJ : v0004 해외 CFD 추가 
'============================================================================

'전역변수 설정
Dim g_szRet					'Return 값
Dim g_BDM_REG_UNIQ_NO			'등록고유번호 : 비대면계좌개설(YYYYMMDD+N+일련번호4자리), 비대면업무신청(YYYYMMDD+B+일련번호4자리)
Dim g_GOAL_MRKT_INFO_CLS_CODE	'목표시장정보구분코드
Dim g_szISCD					'v0004 상품코드
Dim g_nRegistCnt				'v0004 등록횟수

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'f_SetSurvey(): 설문 셋팅
'============================================================================
Function f_SetSurvey(szTranID)
	Dim nDataCnt		'DATACOUNT
	Dim szQuestion	'문항내용
	Dim nQNum		'질문항
	Dim nItemNo		'아이템번호
	
	nDataCnt = tonumber(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1"))
	
	For i = 0 to nDataCnt - 1 
		nQNum = tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "QUES_QSIT_NO", i))
		nItemNo = tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ITEM_NO_VAL", i))
		szQuestion = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "GOAL_MRKT_QUES_QSIT_CNTT" , i))
		
		
		If nItemNo == 0 Then
			Form.SetCtlProp("ContBody.Cont0.LabelQ" & tostring(nQNum), "caption", nQNum & ". " &szQuestion)
		Else
			Dim tLabelID
			tLabelID = Array("a", "b", "c","d", "e")
			
			Select Case nQNum
				Case 1
					ContBody.Cont0.RadioQrg1.SetRadioCaption(nItemNo-1, szQuestion)
				Case 2, 3 , 4
					Form.SetCtlProp("ContBody.Cont0.lbl"& tostring(nQNum) & tLabelID(nItemNo-1), "caption", szQuestion)
				Case 5
					ContBody.Cont0.RadioQrg5.SetRadioCaption(nItemNo-1, szQuestion)
				Case 6 
					ContBody.Cont0.RadioQrg6.SetRadioCaption(nItemNo-1, szQuestion)
			End Select
		End If
	Next
End Function
'============================================================================
'f_RegistSurvey(): 설문답변 등록
'============================================================================
Function f_RegistSurvey(szTranID)	
	Dim nBtnNum		'라디오 버든 수
	Dim nCurIdx		'선택된 인덱스
	Dim szQContent	'설문문항내용(lbl)
	Dim szRdoYN		'선택여부

	Dim nDataIdx
	nDataIdx = 0
	
	For i = 1 to 6
		Dim tRdoNumber
		tRdoNumber = Array("4", "4", "3", "5", "5", "2")
		nBtnNum = tonumber(tRdoNumber(i-1))
		For j = 0 to nBtnNum
			
			'설문문항내용 가져오기
			If j == 0 Then
				szQContent = Form.GetCtlProp( "ContBody.Cont0.LabelQ" & i, "caption")
			Else
				Select Case nQNum
					Case 1
						szQContent = ContBody.Cont0.RadioQrg1.GetRadioCaption( j - 1 )
					Case 2, 3 , 4
						Dim tLabelID
						tLabelID = Array("a", "b", "c","d", "e")	
						szQContent = Form.GetCtlProp( "ContBody.Cont0.lbl" & tostring(i) & tostring(tLabelID(j-1)), "caption")
					Case 5
						szQContent = ContBody.Cont0.RadioQrg5.GetRadioCaption( j - 1 )
					Case 6 
						szQContent = ContBody.Cont0.RadioQrg6.GetRadioCaption( j - 1 )
				End Select
			End If
			
			'선택여부 가져오기
			nCurIdx = tonumber(Form.GetCtlProp( "ContBody.Cont0.RadioQrg" & i, "currentindex" ))
			if nCurIdx + 1 == j Then
				szRdoYN = "Y"
			Else
				szRdoYN = "N"
			End If

			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "QUES_QSIT_NO" , nDataIdx , i )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "ITEM_NO_VAL" , nDataIdx , j )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RSPN_SLCT_YN" , nDataIdx, szRdoYN )
			nDataIdx = nDataIdx + 1
		Next
	Next
End Function
'============================================================================
'f_ChkAnswer: 설문응답 체크
'============================================================================
Function f_ChkAnswer()
	For i = 1 to 6
		Dim szCurIdx
		szCurIdx = tostring(Form.GetCtlProp( "ContBody.Cont0.RadioQrg" & i, "currentindex" ))
		If szCurIdx == "-1" Then
			Form.ShowAlert( "알림" , i & "번 문항에 답을 하지 않았습니다." )
			return False
		End If
	Next
	
	return True
End Function
'============================================================================
'f_SetPFIN: 고객유형 체크
'============================================================================
Function f_SetPFIN(szPRSN_PFIN_CODE)
	If szPRSN_PFIN_CODE == "1" Then
		ContBody.Cont0.RadioQrg1.currentindex = 1
	End If
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()    
	g_szRet = "no"
	g_GOAL_MRKT_INFO_CLS_CODE = ""
	g_BDM_REG_UNIQ_NO = Form.GetSharedData("BDM_REG_UNIQ_NO"        , false) '등록고유번호
	ContBody.Cont0.SetScrollAutoSize()
	
	'v0004 sta
	Dim szData, szList, szCusType
	szData = Form.GetOpenLinkData()
	szList = Split(szData, "★")
	if UBOUND(szList) < 1 then
		Exit Sub
	End if
	
	If szList(0) <> null and szList(0) <> "" and szList(1) <> null and szList(1) <> "" Then
		g_szISCD = szList(0)	'상품코드
		szCusType = szList(1)	'고객유형
		g_nRegistCnt = CDbl(szList(2))	'등록 TR 돌리는 횟수
		ContBody.Cont0.RadioQrg1.currentindex = szCusType
		DATAMANAGER.RequestTranData( "obcsb_acif_831r" )
	End if
	'v0004 fin
End Sub
'============================================================================
'Form_OnPopupReturn()
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "MBBDM85130_P8_end" Then
		'v0004 sta
		If sRet == "ok" Then
			g_szRet = "ok"
		Else
			g_szRet = "no"								
			Form.SetSharedData( "BDM_REG_SRNO" 				, "" )	'국내등록일련번호
			Form.SetSharedData( "BDM_GOAL_MRKT_UNFIT_YN" 		, "" )	'국내목표시장부적합여부 '(Y.목표시장부적합 N.정상)
			Form.SetSharedData( "BDM_ACFD_REG_SRNO" 			, ""	 )	'해외등록일련번호
			Form.SetSharedData( "BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, ""	 )	'해외목표시장부적합여부 '(Y.목표시장부적합 N.정상)
		End If
		'v0004 fin
		Form.CloseForm()
	End If
End Sub
'============================================================================
'Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("MBBDM85130_P8" , g_szRet)
End Sub
'============================================================================
'닫기 Form_OnFormBackKeyPressed()  
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Form.CloseForm()
End Sub
'============================================================================
'닫기
'============================================================================
Sub ImgBg_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
'닫기
'============================================================================
Sub ContBody_ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'취소 선택
'============================================================================
Sub BtnCancel_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
'목표시장 비교 선택
'============================================================================
Sub ButtonOK_OnClick()
	If f_ChkAnswer() == True Then
		DATAMANAGER.RequestTranData( "obaci_acct_266a" )
	End If
End Sub



'****************************************************************************
'           				D A T A M A N A G E R        	
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_acif_831r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "HGDT_PROD_TYPE_CODE" , 0 , "05" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , g_szISCD )		'v0004 해외 CFD 추가로 하드코딩 제거
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_SALE_CLS_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_INFO_CLS_CODE" , 0 , "1" )
	ElseIf szTranID == "obaci_acct_266a" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "REG_UNIQ_NO" , 0 , g_BDM_REG_UNIQ_NO )	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "HGDT_PROD_TYPE_CODE" , 0 , "05" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , g_szISCD )		'v0004 해외 CFD 추가로 하드코딩 제거
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_SALE_CLS_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_INFO_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "UI_SPLM_YN" , 0 , "L" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_REG_SRNO" , 0 , 0 )
		
		f_RegistSurvey(szTranID)
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_acif_831r" Then
		g_GOAL_MRKT_INFO_CLS_CODE = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "GOAL_MRKT_INFO_CLS_CODE", 0 )	
		
		f_SetSurvey(szTranID)
		
	ElseIf szTranID == "obaci_acct_266a" Then
		Dim szREG_SRNO, szGOAL_MRKT_UNFIT_YN
		szREG_SRNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "REG_SRNO", 0 )
		szGOAL_MRKT_UNFIT_YN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "GOAL_MRKT_UNFIT_YN", 0 )
		
		'v0004 sta
		'이력생성(날짜, 넘버)
		if g_szISCD == "136" Then '국내 CFD
			Form.SetSharedData( "BDM_REG_SRNO" , szREG_SRNO)	'등록일련번호
			Form.SetSharedData( "BDM_GOAL_MRKT_UNFIT_YN" , szGOAL_MRKT_UNFIT_YN)	'목표시장부적합여부 '(Y.목표시장부적합 N.정상)
		else	'해외 CFD
			Form.SetSharedData( "BDM_ACFD_REG_SRNO" , szREG_SRNO)	'등록일련번호
			Form.SetSharedData( "BDM_ACFD_GOAL_MRKT_UNFIT_YN" , szGOAL_MRKT_UNFIT_YN)	'목표시장부적합여부 '(Y.목표시장부적합 N.정상)
		end if
		
		g_nRegistCnt = g_nRegistCnt - 1
		
		If g_nRegistCnt > 0 Then
			g_szISCD = "137"
			DATAMANAGER.RequestTranData( "obaci_acct_266a" )
		Else
			If szGOAL_MRKT_UNFIT_YN ~= null and szGOAL_MRKT_UNFIT_YN ~= "" Then	
				Form.OpenPopup( "mbbdm85130_p8_end", szGOAL_MRKT_UNFIT_YN, "")
			End If
		End If
		'v0004 fin
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError()
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg ~= null and Trim(szSubMsg) ~= "" then
		szErrMsg = szErrMsg.."("..szSubMsg..")"
	end if
	
	if szTranID == "obaci_acct_266a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub


