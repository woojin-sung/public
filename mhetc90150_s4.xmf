'============================================================================
Sub Form_OnFormInit()
	
	Container0.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동

	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO",true) '메뉴클릭시 팝업메뉴 화면번호 전달
	
	g_sCloudRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP" , false )
	g_PwdpipAuth = Form.GetSharedData("CLOUD_CERT_PWDAuth", false)
	g_sCloudPhoneNum = Form.GetSharedData("CLOUD_CERT_PHONENUM", false)
	g_sCloudID = Form.GetSharedData("CLOUD_CERT_ID", false)
	g_sCloudCustName = Form.GetSharedData("CLOUD_CERT_CUST_NAME", false)
	
	g_sCloudAcno = Form.GetSharedData("CLOUD_CERT_ACNO", false)
	g_sCloudLocalPwd = Form.GetSharedData("CLOUD_CERT_LOCAL_PWD", false)
	g_sCloudCertIndex = Form.GetSharedData("CLOUD_CERT_INDEX", false)
	
	g_sTempData = Form.GetOpenLinkData()
	szData = Split(g_sTempData, "★")
	
	if Cint(#szData) > 1 then
		'진입점
		g_sScrPoint = szData(0)
	else
		g_sScrPoint = sTempData
	end if 
	
	if g_sScrPoint == "UploadToCloud" then
		Container0.labTitle.caption = "공동인증서 클라우드에 등록"
	end if
	
	'비밀번호 입력키패드 Show
	Form.SetTimerEvent2(1, 1, 0.6)
End Sub
'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.EditReal.caption == null or Container0.EditReal.caption == "" then
		Form.MsgBox( "알림", "클라우드인증서 비밀번호를 입력해주세요.", "", 6 )
	else	
		if g_AuthSucess = "success" then
		
			Call PasswordInsert()
			
			Container0.Label3.visible = false
			Container0.Label4.visible = false
			
			Form.SetTimerEvent2( "2", 1, 0.1)
			
			'obcsb_acad_002r -> obcpp_pcrt_170a -> 발급
			'DATAMANAGER.RequestTranData("obcsb_acad_002r")
		end if
	end if
	
	nCnt = 0
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.EditReal.SetShowKeypad(True)
		
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.1)
		DATAMANAGER.RequestTranData("obcsb_efif_011r")
		
	elseif sTimerID == "9999" or sTimerID == 9999 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
End Sub
'============================================================================
'사용자에게 보여지는 패스워드 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag = "N" then
		nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case nCnt
	
	Case 0
		Container0.Pwdbasic0.visible = true	
