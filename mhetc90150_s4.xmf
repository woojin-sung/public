g_sAsctRcno = ""

Dim g_sRcnoPip
g_sRcnoPip = ""

Dim g_sCloudID
g_sCloudID = ""

Dim g_sCloudCustName
g_sCloudCustName = ""

Dim g_sRefNo
g_sRefNo = ""

Dim g_sAuthCode
g_sAuthCode = ""

Dim g_sPinPwd
g_sPinPwd = ""

