Sub Container0_Btnretry_OnClick()
	Form.SendReturnToParent("mhetc90150_s4" , "retry")
	Form.CloseForm()
End Sub
'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)

	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("[에러1]" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if		
	
	'인증서 발급
	if sCommand = "CLOUD_REQ_CERT_ISSUE_90150" then
		
		'응답문 처리
		if #szItem >= 3 then
			if szItem(2) <> "CMP200" then
				Form.MsgBox("안내", szItem(3), "", 0)
			'정상
			else
				DATAMANAGER.RequestTranData( "obcsb_padc_002a" ) '발급SMS전송
			end if
		end if
		
	end if
	
	'인증서 업로드(등록)
	if sCommand == "CLOUD_REQ_CERT_UPLOAD_90150" then
		
		'응답문 처리
		if #szItem >= 3 then
			if szItem(2) <> "CMP201" then
				Form.MsgBox("안내", szItem(3), "", 0)
			'정상
			else
				g_nextpage = True
				Form.CloseForm()
			end if
		end if
		
	end if
	
End Sub
'============================================================================
Sub Form_OnFormClose()
	if g_nextpage then
		if g_sScrPoint == "UploadToCloud" then
			Form.OpenPopup("mhetc90150_p2" , "UploadToCloud" , "")
		else
			Form.OpenPopup("mhetc90150_p2" , "New" , "")
		end if
	end if
End Sub

