'============================================================================
Sub Form_OnFormInit()
	Dim szLinkedData ' 고객투자성향 등급
	
	Form.SetScreenName("고객투자성향 안내")
	szLinkedData = Form.GetOpenLinkData( )
	
	szInvColor = getInvTypeColor(szLinkedData)
	g_szInvTypeNm = Form.GetMetaData("KYC투자성향등급코드", szLinkedData)
	
	if szLinkedData = "" then
		Form.ShowAlert("알림", "투자성향진단 내역이 없습니다.")
	else
		Table0.SetCellString(0, 0, "고객님의 투자성향은 ")
		Table0.SetCellString(0, 1, g_szInvTypeNm)
		Table0.SetCellFgColor(0, 1, szInvColor)
		Table0.SetCellString(0, 2, "입니다.")
		
		if szLinkedData = "01" then
			Image1.imgpath = "invgradeclut01.png"
		elseif szLinkedData = "02" then 	
			Image1.imgpath = "invgradeclut02.png"
		elseif szLinkedData = "03" then 	
			Image1.imgpath = "invgradeclut03.png"
		elseif szLinkedData = "04" then 
			Image1.imgpath = "invgradeclut04.png"
		elseif szLinkedData = "05" then 
			Image1.imgpath = "invgradeclut05.png"
		else
			Image1.imgpath = ""
		end if
		
		if szLinkedData = "01" then
			Table1.SetCellString(0, 0, "고객님은 투자 위험을 적극적으로 수용하면서")
			Table1.SetCellString(1, 0, "국내외 다양한 고수익 기회를 추구하시는")
			Table1.SetCellString(2, 0, "'고수익지향형' 투자 유형입니다.")
			
			Table2.SetCellString(0, 0, "당사 상품분류 기준 상 '고수익 고위험'을 추구하는")
			Table2.SetCellString(1, 0, "상품을 비롯한 당사 모든 상품 가입이 가능하십니다.")
			Table2.SetCellString(2, 0, "단, 해당 상품군 중 '원금 이상의 손실'이 발생할")
			Table2.SetCellString(3, 0, "가능성이 있는 상품도 있사오니 ")
			Table2.SetCellString(4, 0, "투자에 유의하셔야 합니다.")
		
		elseif szLinkedData = "02" then
			Table1.SetCellString(0, 0, "고객님은 투자원금의 손실을 상당부분 감수하더라도")
			Table1.SetCellString(1, 0, "주식형펀드, 투기등급 채권 등을 통해 수익을")
			Table1.SetCellString(2, 0, "추구하시는 '성장지향형' 투자 유형입니다.")
			
			Table2.SetCellString(0, 0, "따라서 고수익 고위험 상품군을 제외한 모든 상품")
			Table2.SetCellString(1, 0, "가입이 가능하십니다. 단, 해당 상품군 중 ")
			Table2.SetCellString(2, 0, "'원금 전체 손실'이 발생할 가능성이 있는")
			Table2.SetCellString(3, 0, "상품도 있사오니 투자에 유의하시기 바랍니다.")
			
		elseif szLinkedData = "03" then
			Table1.SetCellString(0, 0, "고객님은 투자원금의 손실을 감수하더라도")
			Table1.SetCellString(1, 0, "채권금리보다 높은 투자수익을 추구하시는")
			Table1.SetCellString(2, 0, "'중립형' 투자 유형입니다.")
			
			Table2.SetCellString(0, 0, "'중립형'투자는 특정자산에의 편중을 피하고 중위험")
			Table2.SetCellString(1, 0, "투자 방식의 포트폴리오 구성을 지향합니다.")
			Table2.SetCellString(2, 0, "따라서 고객님께서는 채권 관련 상품과 주식상품의 ")
			Table2.SetCellString(3, 0, "혼합형 상품을 포함, 해당 유형 이하 위험등급")
			Table2.SetCellString(4, 0, "상품 가입이 가능 하십니다.")
			
		elseif szLinkedData = "04" then
			Table1.SetCellString(0, 0, "고객님은 최대한 투자원금을 보전하면서 정기예금")
			Table1.SetCellString(1, 0, "금리보다 조금 높은 투자수익을 추구하시는")
			Table1.SetCellString(2, 0, "'안전지향형' 투자유형입니다.")
			
			Table2.SetCellString(0, 0, "따라서 신용등급이 높은 국공채, 회사채, 기업어음")
			Table2.SetCellString(1, 0, "및 채권형펀드 등 채권 관련 상품 가입이")
			Table2.SetCellString(2, 0, "가능하십니다. 단, 주식 관련 상품 등 위험자산의")
			Table2.SetCellString(3, 0, "편입에 따른 원금 손실도 발생할 수 있습니다.")
		
		elseif szLinkedData = "05" then
			Table1.SetCellString(0, 0, "고객님은 투자원금을 보전하면서 정기예금")
			Table1.SetCellString(1, 0, "수준의 투자수익을 추구하시는")
			Table1.SetCellString(2, 0, "'이자소득형' 투자유형입니다.")
			
			Table2.SetCellString(0, 0, "따라서 예금신탁상품, 원금보장상품 및 기타 당사")
			Table2.SetCellString(1, 0, "상품 분류기준에 따른 상품가입이 가능하십니다.")
			Table2.SetCellString(2, 0, "단, 주식형 상품가입을 원할 시에는 별도의")
			Table2.SetCellString(3, 0, "고객 확인 및 안정지향형 이상의")
			Table2.SetCellString(4, 0, "고객 분류 작업이 필요합니다.")
			
		end if
	end if

	
	
	
	
End Sub

'============================================================================

Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'getInvTypeColor	:	 투자성향등급코드 색상을 리턴한다.
'============================================================================
Function getInvTypeColor (szInvGrad)
	if		szInvGrad = "01"	then
		return "1"
	elseif	szInvGrad = "02" 	then
		return "101"
	elseif	szInvGrad = "03"	then
		return "207"
	elseif	szInvGrad = "04"	then
		return "129"
	elseif	szInvGrad = "05"	then
		return "140" 
	else
		return "4"
	end	if
End Function
'============================================================================
Sub Button0_OnClick()
	Form.OpenFramePopup("mbonl81010" , sOpenData , sPosInfo)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Form.SendReturnToParent("mbfnp51000_p5_refresh" , "Y")
	if sKeyName = "mbonl81010_close" then
		Form.CloseForm( )
		'Form.SendReturnToParent("mbfnp51000_p5_refresh" , "Y")
	end if
End Sub



