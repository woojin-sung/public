'============================================================================
' 작성 : 2021.02.07. 장원혁
'============================================================================

'전역변수 설정

Dim unPressedImgPath 
Dim PressedImgPath

Dim Q1Answer
Dim Q2Answer
Dim Q3Answer

Dim aFlag '아코디언 플래그


'============================================================================
Sub Form_OnFormInit()

    unPressedImgPath = "x.png"
    PressedImgPath   = "transkey_image_button.png"

    Q1Answer = 0
    Q2Answer = 0
    Q3Answer = 0
    
    ContainerBody.ImgQ1A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ1A2.imgpath = unPressedImgPath    
    
    ContainerBody.ImgQ2A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ2A2.imgpath = unPressedImgPath    
    
    ContainerBody.ImgQ3A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ3A2.imgpath = unPressedImgPath        
       
    aFlag = 0       
       
End Sub

'============================================================================
Sub Common_Check()
    
End Sub

'============================================================================
Sub ContainerBody_ImgQ1A1_OnClick()
    Q1Answer = 1
    ContainerBody.ImgQ1A1.imgpath = PressedImgPath
    ContainerBody.ImgQ1A2.imgpath = unPressedImgPath        
    Common_Check()
End Sub

'============================================================================
Sub ContainerBody_ImgQ1A2_OnClick()
    Q1Answer = 2
    ContainerBody.ImgQ1A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ1A2.imgpath = PressedImgPath            
    Common_Check()	
End Sub

'============================================================================
Sub ContainerBody_ImgQ2A1_OnClick()
    Q2Answer = 1
    ContainerBody.ImgQ2A1.imgpath = PressedImgPath
    ContainerBody.ImgQ2A2.imgpath = unPressedImgPath      
    Common_Check()	
End Sub

'============================================================================
Sub ContainerBody_ImgQ2A2_OnClick()
    Q2Answer = 2
    ContainerBody.ImgQ2A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ2A2.imgpath = PressedImgPath          
    Common_Check()	
End Sub

'============================================================================
Sub ContainerBody_ImgQ3A1_OnClick()
    Q3Answer = 1
    ContainerBody.ImgQ3A1.imgpath = PressedImgPath
    ContainerBody.ImgQ3A2.imgpath = unPressedImgPath                  
    Common_Check()
End Sub

'============================================================================
Sub ContainerBody_ImgQ3A2_OnClick()
    Q3Answer = 2
    ContainerBody.ImgQ3A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ3A2.imgpath = PressedImgPath          
    Common_Check()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

    if trim(sTimerID) == "9999" then
        Form.SetTimerEvent("9999", 0, 1)
        ContainerBody.scroll_pos = 0        
        ContainerBody.SetScrollAutoSize()   
    end if
    
End Sub 

'============================================================================
Sub ContainerBody_Container0_BtnAccordion_OnClick()

    If aFlag == 0 Then    
    
        ContainerBody.Container2.setHeightResize(280)    
        ContainerBody.LblDummy.top = 840
        ContainerBody.SetScrollAutoSize()
        ContainerBody.scroll_pos = 500

        aFlag = 1
	
    Else
        
        ContainerBody.Container2.setHeightResize(0)        
        ContainerBody.LblDummy.top = 560
        Form.SetTimerEvent("9999", 1, 1)
	
        aFlag = 0
	
    End If
    
End Sub

