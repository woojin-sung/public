	g_szOpenDate_mbonl81000 =  g_szAcno & ";" & "" & ";" & "1" & ";" & "9999"
	'Form.MsgBox("1",g_szOpenDate_mbonl81000,0,0)
	Form.OpenFramePopup("mbonl81000" , g_szOpenDate_mbonl81000 , sPosInfo)		
