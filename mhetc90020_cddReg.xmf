'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	'직종
	If sKeyName == "mbact13010_p2" Then	
		'v0003
		'Container0.Container2.Label20.caption= sRet
		g_LRDV_CODE   = Form.GetSharedData("13010_OCCU_LRDV", False )	'대업무분류
		g_SMDV_CODE   = Form.GetSharedData("13010_OCCU_SMDV", False )		'소업무분류
		g_SMDV_CODE11 = Form.GetSharedData("13010_OCCU_NAME", False )		'소업무분류
		
		'V0003 
		Container0.Container2.Combo3.cbkeydata = g_LRDV_CODE
		Container0.Container2.Label20.caption= ""
		Container0.Container2.Edit1.caption = ""
		Container0.Container2.Edit1.enable = false	'기타 활성화..
		
		if g_LRDV_CODE = "01" or g_LRDV_CODE = "02" or g_LRDV_CODE = "03" then
			Container0.Container2.Label20.caption= sRet
		else
			g_SMDV_CODE = g_LRDV_CODE&"00"
		end if
		
		g_SPF_HRISK_BSTP_CLCD="00"	'00`해당없음
		g_OCPT_CD = g_LRDV_CODE
'		if g_LRDV_CODE == "04" then
'			g_OCPT_CD = "14"	'14:학생
'		elseif g_LRDV_CODE == "05" then
'			g_OCPT_CD = "17"	'17:주부
'		elseif g_LRDV_CODE == "06" then
'			g_OCPT_CD = "19"	'19:무직
'		elseif g_LRDV_CODE == "07" then
