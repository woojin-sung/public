	'국가
	ELSEIf sKeyName == "mhetc90020_cddReg_p1" Then		
		Container0.Container3.LabelNtc.caption= sRet
		g_NTCD_NAME   = Form.GetSharedData("cddReg_CODE_NAME", False )	'국가명
		g_NTCD_CODE   = Form.GetSharedData("cddReg_CODE", False )	'국가코드				
	'주소변경팝업
