		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "ETC_CNTT"			, 0 , Container0.Container2.Edit1.caption	)	'기타내용
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "AML_OCKN_LRDV_CODE"	, 0 , g_LRDV_CODE							)	'AML직종대분류코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "AML_OCKN_SMDV_CODE"	, 0 , g_SMDV_CODE							)	'AML직종소분류코드
		
		'v0003 DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "SPF_HRISK_BSTP_CLCD"	, 0 , Container0.Container2.Combo4.cbkeydata	)	'특종고위험업종구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "SPF_HRISK_BSTP_CLCD"	, 0 , g_SPF_HRISK_BSTP_CLCD	)	'특종고위험업종구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "WRPL_NAME"			, 0 , Container0.Container2.Edit2.caption	)	'직장명
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock4", "AML_CHAN_TYPE_CODE"	, 0 , Container0.Container5.Combo0.cbkeydata	)	'AML채널유형코드 (MTS : 03 )
		'aml_prod_code 서비스에서 처리하는데 현재 소스 수정 안되었으므로 하드 타이핑		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock4", "AML_PROD_CODE"		, 0 , Container0.Container5.Combo1.cbkeydata	)	'AML상품코드
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock4", "CDD_TR_KIND_CODE" 	, 0 , "4"								)	'CDD 거래종류코드
		
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "CUST_FULL_NAME" 		, 0 , Container0.Container1.Label1.caption	)	'고객풀명		
		if( Container0.Container3.RadioGroup3.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_FRGN_YN" 			, 0 , "Y"							)	'UI_외국인여부
		elseif( Container0.Container3.RadioGroup3.currentindex =="1") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_FRGN_YN" 			, 0 , "N"							)	'UI_외국인여부
			g_NTCD_CODE = "410"
		end if
		
		if( Container0.Container3.RadioGroup2.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_YN"	 		, 0 , "Y"								)	'개인실제소유자여부
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "WRTR_INTG_CSNM" 	, 0 , Container0.Container1.Label1.caption	)	'작성자통합고객명
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_NTNT_CTCD" 	, 0 , Container0.Container3.Label21.caption	)	'개인실제소유자국적국가코드
		else
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_YN"	 		, 0 , 	"N"								)	'개인실제소유자여부
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_INTG_CSNM" 	, 0 , Container0.Container3.Edit3.caption	)	'UI개인실제소유자실명확인번호
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_RCNO_PIP" 	, 0 , Container0.Container3.Edit4.caption	)	'UI개인실제소유자실명확인번호  v0001 UI_PBO_RCNO->PBO_RCNO_PIP
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_INTG_CSNM"	, 0 , Container0.Container3.Edit3.caption	)	'UI개인실제소유자통합고객명
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "WRTR_INTG_CSNM" 	, 0 , Container0.Container3.Edit3.caption	)	'작성자통합고객명
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_NTNT_CTCD" 	, 0 , g_NTCD_CODE							)	'개인실제소유자국적국가코드
		end if
		
		DATAMANAGER.RequestTranData("obcsb_srpi_102a")
	elseif szTranID == "obcmm_kedd_019a" then
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "PROS_CLS" 				, 0 , "W"						)
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "ACNO" 					, 0 , g_szAcno					)
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "EDD_TR_OBJT_CODE"			, 0 , Container0.Container4.Combo5.cbkeydata	)
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "EDD_TR_OBJT_ETC_CNTT"		, 0 , Container0.Container4.Edit5.caption)
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "EDD_TR_FNDS_SORC_CODE" 	, 0 , Container0.Container4.Combo6.cbkeydata	)
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "EDD_TR_FNDS_SORC_ETC_CNTT"	, 0 , Container0.Container4.Edit6.caption	)
		
		
		DATAMANAGER.RequestTranData("obcmm_kedd_019a")
		
	end if
End Function


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcmm_kcdd_042r" then		
		g_szAcno = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "ACNO" 	, 0 ))
		g_szAsno = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "ASNO" 	, 0 ))
		
		Container0.Container5.Combo1.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "AML_PROD_CODE" , 0 ))				
		Container0.Container4.Combo5.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "EDD_TR_OBJT_CODE" , 0 ))		
		Container0.Container4.Combo6.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "EDD_TR_FNDS_SORC_CODE" , 0 ))		
		Container0.Container4.Edit5.caption    = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "EDD_TR_OBJT_ETC_CNTT" , 0 ))		
		Container0.Container4.Edit6.caption    = Trim(DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "EDD_TR_FNDS_SORC_ETC_CNTT" , 0 ))		
		
	
		TR_Inquiry("obcsb_srpi_101r")
		
	elseif szTranID == "obcsb_srpi_101r" then		
		Container0.Container1.Label1.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "CUST_FULL_NAME" 	, 0 ))
		Container0.Container1.Edit0.caption  = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "CUST_ENG_NAME"	, 0 ))		
		Container0.Container1.Edit7.caption  = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "BRDT"	         , 0 ))
		
		IF Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "RSDT_CLS_CODE" , 0 )) = "1" THEN
			Container0.Container1.RadioGroup0.currentindex = "0"
		ELSEIF Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "RSDT_CLS_CODE" , 0 )) = "2" THEN		
			Container0.Container1.RadioGroup0.currentindex = "1"
		END IF
		
		Container0.Container1.Label2.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "CLPH_ARCD" 	, 0 ))
		Container0.Container1.Label3.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "CLPH_TONO" 	, 0 ))
		Container0.Container1.Label4.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "CLPH_SRNO" 	, 0 ))
		
		IF Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "GNDR_CLS_CODE" , 0 )) = "1" THEN
			Container0.Container1.RadioGroup1.currentindex = "0"
		ELSEIF Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "GNDR_CLS_CODE" , 0 )) = "2" THEN		
			Container0.Container1.RadioGroup1.currentindex = "1"
		END IF
		
		Container0.Container1.Label5.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "EMAIL_ADDR" 	, 0 ))
		
		Container0.Container1.Label6.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_ARCD" 	, 0 ))
		Container0.Container1.Label7.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_TONO" 	, 0 ))
		Container0.Container1.Label8.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_TELNO" 	, 0 ))
		
		Container0.Container1.Label9.caption  = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_REGN_ZIP", 0 ))
		Container0.Container1.Label10.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_DTL_ZIP" 	, 0 ))
		Container0.Container1.Label11.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_POST" 	, 0 ))
		Container0.Container1.Label12.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_DTAD" 	, 0 ))
		Container0.Container1.Label24.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_NW_ADDR_USE_YN"      , 0 ))
		Container0.Container1.Label25.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_OWHS_BLDN_MNNO" , 0 ))

		Container0.Container1.Label13.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_ARCD" 	, 0 ))
		Container0.Container1.Label14.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_TONO" 	, 0 ))
		Container0.Container1.Label15.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_TELNO" 	, 0 ))
		
		Container0.Container1.Label16.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_REGN_ZIP", 0 ))
		Container0.Container1.Label17.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_DTL_ZIP" , 0 ))
		Container0.Container1.Label18.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_POST" 	  , 0 ))
		Container0.Container1.Label19.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_DTAD" 	  , 0 ))
		Container0.Container1.Label26.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_NW_ADDR_USE_YN"      , 0 ))
		Container0.Container1.Label27.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "UI_CO_BLDN_MNNO" , 0 ))

		Container0.Container3.Label21.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "NTNT_CTCD" 	       , 0 ))
		Container0.Container3.Label22.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock1", "NTFR_CLS_CODE"      , 0 ))
		Container0.Container3.Label23.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock3", "AML_CHAN_TYPE_CODE" , 0 ))		
		
		'직장정보입력
		'v0003 Container0.Container2.Combo3.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "OCPT_CODE" , 0 ))		
		g_OCPT_CD = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "OCPT_CODE" , 0 ))		
		if g_OCPT_CD == "02" then
			'Container0.Container2.Combo3.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_BSTP_LRDV_CODE2" , 0 ))				
			'Container0.Container2.Label20.caption  = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "BSTP_NAME" , 0 ))		
		
			'g_LRDV_CODE   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_BSTP_LRDV_CODE2" , 0 ))	'대업무분류
			'g_SMDV_CODE   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_BSTP_SMDV_CODE2" , 0 ))		'소업무분류
			'g_SMDV_CODE11 = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "BSTP_NAME"      , 0 ))		'소업무분류		
		
			g_Iqry_LRDV_CODE = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_BSTP_LRDV_CODE2" , 0 ))	'대업무분류
			g_Iqry_SMDV_CODE = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_BSTP_SMDV_CODE2" , 0 ))		'소업무분류
			g_Iqry_SMDV_CDNM = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "BSTP_NAME"      , 0 ))		'소업무분류		
			
			Container0.Container2.Combo3.cbkeydata = Trim(g_Iqry_LRDV_CODE)			
		else
			'Container0.Container2.Combo3.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_LRDV_CODE2" , 0 ))				
			'Container0.Container2.Label20.caption  = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_NAME" , 0 ))		
			
			'g_LRDV_CODE   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_LRDV_CODE2" , 0 ))	'대업무분류
			'g_SMDV_CODE   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_SMDV_CODE2" , 0 ))		'소업무분류
			'g_SMDV_CODE11 = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_NAME"      , 0 ))		'소업무분류					
			
			g_Iqry_LRDV_CODE = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_LRDV_CODE2" , 0 ))	'대업무분류
			g_Iqry_SMDV_CODE = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_SMDV_CODE2" , 0 ))		'소업무분류
			g_Iqry_SMDV_CDNM = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "AML_OCKN_NAME"      , 0 ))		'소업무분류				

			Container0.Container2.Combo3.cbkeydata = Trim(g_Iqry_LRDV_CODE)							
		end if
		
		Form.SetTimerEvent2(1, 1, 0.5)  'Combo3_OnEditComplete 함수 세팅후 소분류세팅용..
		
		Container0.Container2.Edit1.caption    = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "OCPT_NAME" , 0 ))				
				
		'v0003 Container0.Container2.Combo4.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "SPF_HRISK_BSTP_CLCD" , 0 ))		
		g_SPF_HRISK_BSTP_CLCD = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "SPF_HRISK_BSTP_CLCD" , 0 ))		
		
		Container0.Container2.Edit2.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock2", "WRPL_NAME" , 0 ))		
		
		'주거래채널/상품정보
		Container0.Container5.Combo0.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock3", "AML_CHAN_TYPE_CODE" , 0 ))		
		
		
		'실제소유자정보입력
		
		IF Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock5", "PBO_YN" , 0 )) = "N" THEN
			Container0.Container3.RadioGroup2.currentindex = "1"
			Container0.Container3.Edit3	.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock5", "PBO_INTG_CSNM" , 0 ))		
			Container0.Container3.Edit4.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock5", "PBO_RCNO_PIP" , 0 )) 'v0001 UI_PBO_RCNO->PBO_RCNO_PIP
			IF Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock5", "PBO_NTNT_CTCD" , 0 )) ="410" THEN				
				Container0.Container3.RadioGroup3.currentindex = "1"
			ELSE
				Container0.Container3.RadioGroup3.currentindex = "0"
			END IF
			Container0.Container3.Combo2.cbkeydata = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock5", "PBO_NTNT_CTCD" , 0 ))
			Container0.Container3.LabelNtc.caption = Container0.Container3.Combo2.caption
			g_NTCD_NAME   = Container0.Container3.Combo2.caption	'국가명
			g_NTCD_CODE   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_srpi_101r", "OutBlock5", "PBO_NTNT_CTCD" , 0 ))	'국가코드	
		ELSE
			Container0.Container3.RadioGroup2.currentindex = "0"
		END IF
		

	elseif szTranID == "obcsb_srpi_102a" then	'CDD 고객개인내역 등록
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CDD_RISK_CLCD" , 0) == "3" then 'EDD 실행대상
			TR_Inquiry("obcmm_kedd_019a")	'개인 EDD 처리
		else
			g_sRetData = "REG"
			'Form.ShowAlert("알림","CDD 재이행이 완료 되었습니다.")
			Form.CloseForm()
		end if
	elseif szTranID == "obcmm_kedd_019a" then
		g_sRetData = "REG"	
		
		Form.CloseForm()
	end if
End Sub



