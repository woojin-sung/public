Sub Container0_Container3_RadioGroup2_OnClick(nIndex)	
	if nIndex ==0 then
		Container0.Container3.height = 69		
		Container0.Container4.top = 734
	elseif nIndex ==1 then
		Container0.Container3.height = 138		
		Container0.Container4.top = 807	
	end if
END sub

Sub Container0_btnOK_OnClick()		

	If Trim(Container0.Container1.Edit0.Caption) = "" Then
		ShowAlert "알림", "영문명을 입력하세요."		
		Exit Sub
	End If
	
	If Trim(Container0.Container1.Edit7.Caption) = "" Then
		ShowAlert "알림", "생년월일을 입력하세요."		
		Exit Sub
	End If
	
	If Container0.Container2.Combo3.Caption = " "  Then
		ShowAlert "알림", "직업을 확인하세요."
		Exit Sub
	End If
	
	'v0003
'	if(Trim(Container0.Container2.Combo3.Caption) <>"주부"
'	and Trim(Container0.Container2.Combo3.Caption) <>"학생"
'	and Trim(Container0.Container2.Combo3.Caption) <>"전업투자자"
'	and Trim(Container0.Container2.Combo3.Caption) <>"무직"
'	and Trim(Container0.Container2.Combo3.Caption) <>"기타") Then
	if (Trim(Container0.Container2.Combo3.Caption) = "직장인" or Trim(Container0.Container2.Combo3.Caption) = "자영업자" or Trim(Container0.Container2.Combo3.Caption) = "전문직") then
		if Container0.Container2.Label20.caption = "" then
			ShowAlert "알림", "직종을 확인하세요"
			Exit Sub
		end if
	end if
	
	If Trim(Container0.Container2.Combo3.Caption) =="기타" Then
		'if Len(Trim(Container0.Container2.Edit1.Caption)) < 4 Then
		if Form.getLen(Trim(Container0.Container2.Edit1.Caption)) < 3 Then
			ShowAlert "알림", "직업-기타 입력을 확인하세요(3자이상)."
			Exit Sub
		end if
		if Trim(Container0.Container2.Edit1.Caption) = "기타" Then
			ShowAlert "알림", "기타 항목을 올바르게 입력하세요('기타' 입력 불가)."
			Exit Sub
		end if
	End If

	'v0003
	'If Container0.Container2.Combo4.Caption = " "  Then
	'	ShowAlert "알림", "특정고위험업종을 확인하세요."
	'	Exit Sub
	'End If

	If Container0.Container5.Combo0.Caption = " "  Then
		ShowAlert "알림", "주거래채널을 확인하세요."
		Exit Sub
	End If

	If Container0.Container5.Combo1.Caption = " "  Then
		ShowAlert "알림", "상품정보를 확인하세요."
		Exit Sub
	End If

	if Container0.Container3.RadioGroup2.currentindex =="1" then
		if Trim(Container0.Container3.Edit3.Caption) ==""
			or Trim(Container0.Container3.Edit4.Caption) =="" Then
			ShowAlert "알림", "실제소유자 정보를 확인하세요"
			Exit Sub
		ELSEif Container0.Container3.RadioGroup3.currentindex =="0" then
			IF TRIM(Container0.Container3.LabelNtc.Caption) = "" THEN
				ShowAlert "알림", "실제소유자 국적 정보를 확인하세요"
				Exit Sub
			END IF
		END IF
	End If
	
	if TRIM(Container0.Container4.Combo5.caption) == "" then
		ShowAlert "알림", "거래목적을 입력하세요"
		Exit Sub
	end if
	
	if Container0.Container4.Combo5.cbkeydata =="9" then '선택 기타일 때
		if (TRIM(Container0.Container4.Edit5.Caption) ="") or (Len(Trim(Container0.Container4.Edit5.Caption)) < 4)  then
			ShowAlert "알림", "거래목적 기타내용을 입력하세요"
			Exit Sub
		end if
	end if
	
	if TRIM(Container0.Container4.Combo6.caption) == "" then
		ShowAlert "알림", "자금의 원천을 입력하세요"
		Exit Sub
	end if

	if Container0.Container4.Combo6.cbkeydata =="99" then '선택 기타일 때
		if (TRIM(Container0.Container4.Edit6.Caption) ="") or (Len(Trim(Container0.Container4.Edit6.Caption)) < 4) then
			ShowAlert "알림", "자금원천 기타내용을 입력하세요"
			Exit Sub
		end if
	end if
	TR_Inquiry("obcsb_srpi_102a")	'CDD고객개인내역등록
	
END sub


