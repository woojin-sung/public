Sub Container0_Container2_Combo3_OnEditComplete(iIndex)	
	sKey = iIndex + 1 
	'학생(14), 주부(17), 전업투자자(18), 무직(19), 기타(99) 직종 비활성화 : 직종 안보냄
	'Container0.Combo6.cbkeydata 으로 실제 매핑데이터 전달하지만 여기서는 sKey 사용하여 기타(20 > 단순 인덱스)
	'v0003 키값 변경..
'	If sKey == 14 or sKey == 17 or sKey == 18 or sKey == 19 or sKey == 20 Then			
'		'Container0.Container2.BtnOccu.visible = False
'		Container0.Container2.BtnOccu.enable = False
'		Container0.Container2.Label20.caption= ""
'		g_LRDV_CODE   = ""	'대업무분류
'		g_SMDV_CODE   = ""		'소업무분류
'		g_SMDV_CODE11 = ""		'소업무분류
'	ELSE
'		Container0.Container2.BtnOccu.enable = TRUE
'	END IF
	
	Container0.Container2.BtnOccu.enable = False			
	Container0.Container2.Edit1.caption = ""
	Container0.Container2.Edit1.enable = false
	
	If sKey == 1 or sKey == 2 or sKey == 3 Then		
		Container0.Container2.BtnOccu.enable = TRUE		
	elseIf sKey == 13 then
		Container0.Container2.Edit1.enable = true	
	end if
	
	Container0.Container2.Label20.caption= ""
	
	if sKey >= 10 then
		g_LRDV_CODE   = sKey	'대업무분류
	else
		g_LRDV_CODE   = "0"&sKey
	end if
	
	'V0003 값세팅 추가
	g_SPF_HRISK_BSTP_CLCD = "00" '00:해당없음
	g_OCPT_CD = g_LRDV_CODE
'	if sKey == 4 then
'		g_OCPT_CD = "14"	'14:학생
'	elseif sKey == 5 then
'		g_OCPT_CD = "17"	'17:주부
'	elseif sKey == 6 then
'		g_OCPT_CD = "19"	'19:무직
'	elseif sKey == 7 then
'		g_OCPT_CD = "18"	'18:전업투자자
'	elseif sKey == 13 then				
'		g_OCPT_CD = "99" '99:기타
'		g_SPF_HRISK_BSTP_CLCD="00"	'00`해당없음			
'	elseif sKey == 3 then	
'		g_OCPT_CD = "16"	'16:전문직
'	elseif sKey == 2 then	
'		g_OCPT_CD = "03"	'03:자영업자
'	else		
'		g_OCPT_CD = "15" '15:회사원
		
		if sKey == 8 then
			g_SPF_HRISK_BSTP_CLCD="01"	'01`가상화폐업자			
		elseif sKey == 9 then			
			g_SPF_HRISK_BSTP_CLCD="02"	'02`카지노사업자			
		elseif sKey == 10 then			
			g_SPF_HRISK_BSTP_CLCD="03"	'03`대부업자			
		elseif sKey == 11 then			
			g_SPF_HRISK_BSTP_CLCD="04"	'04`환전상			
		elseif sKey == 12 then			
			g_SPF_HRISK_BSTP_CLCD="05"	'05`귀금속판매상						
		end if
'	end if	
	if g_LRDV_CODE <> "01" and g_LRDV_CODE <> "02" and g_LRDV_CODE <> "03" then
		g_SMDV_CODE = g_LRDV_CODE&"00"
	else
		g_SMDV_CODE   = ""	'소업무분류
		g_SMDV_CODE11 = ""	'소업무분류	
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.5)  
	
		if g_Iqry_LRDV_CODE == "01" or g_Iqry_LRDV_CODE == "02" or g_Iqry_LRDV_CODE == "03" then
			Container0.Container2.Label20.caption  = g_Iqry_SMDV_CDNM 	
			Container0.Container2.BtnOccu.enable = TRUE	
		elseif g_Iqry_LRDV_CODE == "13" then
			Container0.Container2.Edit1.enable = true	
		end if
		
		g_LRDV_CODE   = g_Iqry_LRDV_CODE
		g_SMDV_CODE   = g_Iqry_SMDV_CODE
		g_SMDV_CODE11 = g_Iqry_SMDV_CDNM		
	end if
	
End Sub

