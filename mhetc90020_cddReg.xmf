'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : CDD 고객확인서 등록
' 02. 화면설명 : CDD 고객확인서 등록
' 03. 작    성 : 2018.04.16	
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_srpi_101r,102a, obcmm_kedd_019a IO 변경분 반영
' 2021.04.28 : 정민영 : v0002 : T2101080009 : obcsb_srpi_102a IO변경분 적용
' 2023.03.22 : 양현정 : v0003 : CDD 직업구분 변경반영
'-------------------------------------------------------------------------------------------

'---------------------------------------------------------------------
' v0001 실명번호 컨트롤 속성 변경(비밀번호사용X->일반비밀번호사용)
' Container0.Container3.Edit4.caption
'---------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 
Dim g_szScrNo 	'호출한 화면번호
Dim g_ELFN_ID
Dim g_RCNO_PIP

dim g_szAcno		'사용자 계좌번호
dim g_szAsno		'사용자 일련번호

Dim g_LRDV_CODE		'대업무분류
Dim g_SMDV_CODE		'소업무분류
Dim g_PROD_CODE		'상품코드
Dim g_AML_PROD_CODE	'AML상품코드

Dim g_NTCD_NAME		'국가명
Dim g_NTCD_CODE		'국가코드

Dim g_szOpenDate_mbonl81000
Dim g_SPF_HRISK_BSTP_CLCD 'V0003
Dim g_OCPT_CD	'V0003

Dim g_Iqry_LRDV_CODE		'대업무분류
Dim g_Iqry_SMDV_CODE		'소업무분류
Dim g_Iqry_SMDV_CDNM

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setGlobalItems(szInput)

	g_szScrNo		=	getListItem(szInput, 0)
	g_ELFN_ID		=	getListItem(szInput, 1)

End Function

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList(0) <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 초기화
'	Form.SendReturnToParent("mbact13050_p5" , "CANCEL")\	
	
	g_sRetData = "CANCEL"
	g_szAcno = ""
	g_szAsno = ""
	szLinkedData = Form.GetOpenLinkData( )
	
	Form.SetScreenName("고객확인서 등록")	
	if szLinkedData = "" then
		'Form.ShowAlert(g_szAlertTitle, "입력값이 없습니다.")
	else
		setGlobalItems(szLinkedData)
	end if 
'g_ELFN_ID = "12youn21"	
'g_ELFN_ID = "kimikimi"	
	TR_Inquiry("obcmm_kcdd_042r")
	
	Container0.Container3.height = 69
	Container0.Container4.top = 734
	

	'Container0.Container2.Combo3.setcursel(-1)
	Container0.Container2.Combo3.currentindex = -1
	Container0.Container2.Combo3.caption = " "
	'V0003
	'Container0.Container2.Combo4.currentindex = -1
	'Container0.Container2.Combo4.caption = " "
	Container0.Container5.Combo0.currentindex = -1
	Container0.Container5.Combo0.caption = " "
	Container0.Container5.Combo1.currentindex = -1	
	Container0.Container5.Combo1.caption = " "
	Container0.Container4.Combo5.currentindex = -1	
	Container0.Container4.Combo5.caption = " "
	Container0.Container4.Combo6.currentindex = -1
	Container0.Container4.Combo6.caption = " "
	'TR_Inquiry("obcsb_srpi_101r")
	
	Container0.Container2.Edit1.enable = false 'V0003
	
End Sub


'============================================================================
' TR_Inquiry() - tr명에 따라
'============================================================================
Function TR_Inquiry(szTranID)	
	if szTranID == "obcmm_kcdd_042r" then
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_042r", "InBlock1", "PROS_CLS_CODE", 0 , "1"		)	'구분코드
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_042r", "InBlock1", "ELFN_ID"      , 0 , g_ELFN_ID	)	'ID
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_042r", "InBlock1", "ACNO" 		 , 0 , "" 		)	'계좌번호
		
		DATAMANAGER.RequestTranData("obcmm_kcdd_042r")
	elseif szTranID == "obcsb_srpi_101r" then
		'showAlert("g_szAcno",g_szAcno)
		'showAlert("g_szAsno",g_szAsno)
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_101r", "InBlock1", "RLTD_ACNO"         , 0 , g_szAcno)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_101r", "InBlock1", "RLTD_ASNO"         , 0 , g_szAsno)	'일련번호
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_101r", "InBlock1", "AML_CUST_CLS_CODE" , 0 , "1" )	
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_101r", "InBlock1", "CDD_TR_KIND_CODE"  , 0 , "4" )	'재이행
		DATAMANAGER.RequestTranData("obcsb_srpi_101r")
		
	elseif szTranID == "obcsb_srpi_102a" then	
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "RLTD_ACNO" 			, 0 , g_szAcno	)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "RLTD_ASNO" 			, 0 , g_szAsno	)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "AML_CUST_CLS_CODE"	, 0 , "1"		)	'AML고객구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "RCNO_TYPE_CODE"		, 0 , "01"		)	'AML고객구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "CUST_TYPE_CODE"		, 0 , "01"		)	'고객유형코드 01:계좌고객
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CUST_FULL_NAME"		, 0 , Container0.Container1.Label1.caption	)	'고객명
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CUST_ENG_FULL_NAME"	, 0 , Container0.Container1.Edit0.caption	)	'영문명
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "BRDT"	 			, 0 , Container0.Container1.Edit7.Caption	)	'생년월일

		if( Container0.Container1.RadioGroup0.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "RSDT_CLS_CODE"		, 0 , "1"	)	'거주구분코드
		else
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "RSDT_CLS_CODE"		, 0 , "2"	)	'거주구분코드
		end if

		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CLPH_ARCD"			, 0 , Container0.Container1.Label2.caption		)	'휴대폰1
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CLPH_TONO"			, 0 , Container0.Container1.Label3.caption		)	'휴대폰2
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CLPH_SRNO"			, 0 , Container0.Container1.Label4.caption		)	'휴대폰3
		
		if( Container0.Container1.RadioGroup1.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "GNDR_CLS_CODE"		, 0 , "1"	)	'성별
		else
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "GNDR_CLS_CODE"		, 0 , "2"	)	'성별
		end if
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "EMAIL_ADDR"			, 0 , Container0.Container1.Label5.caption		)	'이메일
		
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "NTNT_CTCD"			, 0 , Container0.Container3.Label21.caption		)	'국적국가코드 (대한민국)
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "NTFR_CLS_CODE"		, 0 , Container0.Container3.Label22.caption		)	'내외국인구분코드

		'자택
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_REGN_ZIP"		 	, 0 , Container0.Container1.Label9.caption		)	'지역우편
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_DTL_ZIP"		 	, 0 , Container0.Container1.Label10.caption		)	'상세우편
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_POST"		 	, 0 , Container0.Container1.Label11.caption		)	'우편주소
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_DTAD"		 	, 0 , Container0.Container1.Label12.caption		)	'상세주소
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_NW_ADDR_USE_YN"	, 0 , Container0.Container1.Label24.caption		)	'신주소사용여부
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_BLDN_MNNO"	 	, 0 , Container0.Container1.Label25.caption		)	'건물관리번호

		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_ARCD"		, 0 , Container0.Container1.Label6.caption	)	'자택1 (전화)
