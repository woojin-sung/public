Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim szSaveCmb0, szSaveCmb1
g_nPage = 1
g_xPos  = ""
g_nIndex = 0

'============================================================================
Sub Form_OnFormInit()
	Combo0.bgimagetype = "1"
	Combo1.bgimagetype = "1"
	
	DATAMANAGER.RequestTranData("gtsETFThemeSearch")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "gtsETFThemeInquiry"	then
		Dim szCmb0, szCmb1, szInqd
		szCmb0 = Combo0.cbkeydata
		szCmb1 = Combo1.cbkeydata
		if szCmb0 == "전체" then
			szInqd = "0"
		else
			if szCmb1 == "전체" then
				szInqd = "1"
			else
				szInqd = "2"
			end if
		end if
		DATAMANAGER.SetDataValue(false, "gtsETFThemeInquiry", "inblock", "fdes" , 0 , szCmb0)
		DATAMANAGER.SetDataValue(false, "gtsETFThemeInquiry", "inblock", "sdes" , 0 , szCmb1)
		DATAMANAGER.SetDataValue(false, "gtsETFThemeInquiry", "inblock", "page" , 0 , g_nPage)
		DATAMANAGER.SetDataValue(false, "gtsETFThemeInquiry", "inblock", "inqd" , 0 , szInqd)
	end if
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "gtsETFThemeSearch"	then
		Combo0.clear = "1"
		Combo1.clear = "1"
		
		Dim szCombo1
		szCombo1 = ""
		nRowCount = Grid1.rowcount
		Combo0.cbadddatatext = "전체`전체"
		for i = 0 to nRowCount-1
			Dim nFindPos
			Dim sClass
			sClass = Grid1.GetCellData("Clss", i)
			nFindPos = InStr( szCombo1, sClass )
			if nFindPos == 0 then
				szCombo1 = szCombo1.."/"..sClass
				Combo0.cbadddatatext = sClass.."`"..sClass
			end if
		next
		
		Dim sSelectCombo1
		sSelectCombo1 = Combo0.cbkeydata
		Combo1.cbadddatatext = "전체`전체"
		for i = 0 to nRowCount-1
			Dim sClass
			sClass = Grid1.GetCellData("Clss", i)
			if sClass == sSelectCombo1 then
				Dim sUni
				sUni = Grid1.GetCellData("Uni", i)
				Combo1.cbadddatatext = sUni.."`"..sUni
			end if
		next
		'ETF조회
		g_nPage = 1
		DATAMANAGER.RequestTranData( "gtsETFThemeInquiry" ) 
	elseif szTranID == "gtsETFThemeInquiry"	then
		Dim nCount
		nCount    = CInt( DATAMANAGER.GetDataCount( false, szTranID , "itemList" ) )
		
		'DATA값 (현재page / 전체page)
		g_xPos = DATAMANAGER.GetDataValue( false, szTranID , "itemInfo" , "xpos" , 0 )
		
		nRowCount = Grid0.rowcount
		for i=0 to nCount-1
			Grid0.insertrow = nRowCount + i
			Dim sName, sLast, sExid, nDiff, sCode, nLevg, sTvol, sRate, sSymb
			sName = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "hname" , i)
			sLast = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "last" , i)
			sExid = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "exid" , i)
			nDiff = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "diff" , i)
			sCode = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "symb" , i)
			nLevg = _tonumber(DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "levg" , i))
			sTvol = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "tvol" , i)
			sRate = DATAMANAGER.GetDataValue(false, "gtsETFThemeInquiry", "itemList", "rate" , i)

			Grid0.SetCellData("bd_cell0", nRowCount + i, sName)
			Grid0.SetCellData("bd_cell2", nRowCount + i, sLast)
			Grid0.SetCellData("bd_cell4", nRowCount + i, nDiff)
			Grid0.SetCellData("bd_cell1", nRowCount + i, sExid)
			Grid0.SetCellData("bd_cell6", nRowCount + i, sCode)
			Grid0.SetCellData("bd_cell8", nRowCount + i, sTvol)
			Grid0.SetCellData("bd_cell9", nRowCount + i, sRate)

'			현재가, 등락률 글자색, 대비부호 셋팅                                     
			nDiff = _tonumber(nDiff)
			if nDiff > 0  then
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + i, "1" ) 
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + i, "1" )
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + i, "1" ) 
				Grid0.SetCellData( "bd_cell3", nRowCount + i, "2" ) '1
				
			elseif nDiff < 0  then
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + i, "2" )
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + i, "2" )
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + i, "2" ) 
				Grid0.SetCellData( "bd_cell3", nRowCount + i, "5" ) '3
				
			else
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + i, "3" )
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + i, "3" ) 
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + i, "3" ) '대비
				Grid0.SetCellData( "bd_cell3", nRowCount + i, "0" ) '5
			end if
			
			'레버리지 셋팅                              
			if nLevg > 0  then
				Grid0.SetCellData( "bd_cell7", nRowCount + i, "+" .. tostring(nLevg) )

				
			elseif nLevg < 0  then
				Grid0.SetCellData( "bd_cell7", nRowCount + i, (nLevg) )
				
			else 
				Grid0.SetCellData( "bd_cell7", nRowCount + i, "" )
				
			end if
		
		next
		
	end if
End Sub


Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Form_OnRefresh()	
	g_nPage  = 1
	g_nIndex = 0
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "gtsETFThemeInquiry" )
end Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	g_nPage  = 1
	g_nIndex = 0
	
'	Grid1.SetClear( )
	Grid0.SetClear( )
'	szSaveCmb0 = Combo0.cbkeydata
'	szSaveCmb1 = Combo1.cbkeydata
	
	Combo1.clear = "1"
	nRowCount = Grid1.rowcount
	Dim sSelectCombo1
	sSelectCombo1 = Combo0.cbkeydata
	Combo1.cbadddatatext = "전체`전체"
	for i = 0 to nRowCount-1
		Dim sClass
		sClass = Grid1.GetCellData("Clss", i)
		if sClass == sSelectCombo1 then
			Dim sUni
			sUni = Grid1.GetCellData("Uni", i)
			Combo1.cbadddatatext = sUni.."`"..sUni
		end if
	next
	
	Form.SetEnvData(1, "16051_T4_COMBO0", Combo0.cbkeydata)
	DATAMANAGER.RequestTranData( "gtsETFThemeInquiry" ) 
end Sub


'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	Grid0.SetClear( )
	g_nPage  = 1
	g_nIndex = 0
'	szSaveCmb0 = Combo0.cbkeydata
'	szSaveCmb1 = Combo1.cbkeydata
	Form.SetEnvData(1, "16051_T4_COMBO1", Combo1.cbkeydata)
	DATAMANAGER.RequestTranData( "gtsETFThemeInquiry" )
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	'DATA값 (현재page / 전체page)
	Dim nTmpIndex
	Dim nPageIndex
	Dim nPageTotal
	
	nTmpIndex  = CInt( Instr(1, g_xPos, "/") )
	nPageIndex = CInt( Mid(g_xPos, 1, nTmpIndex-2)  )
	nPageTotal = CInt(Mid(g_xPos, nTmpIndex+1, -1))
	
	if g_nPage + 1 <= nPageTotal then
		g_nPage = g_nPage + 1
		DATAMANAGER.RequestTranData( "gtsETFThemeInquiry"  )
	end if
	
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode, listlocation, nYPos, szData, sExid, sProCode, sName
'	sCode = Grid0.GetCellData("bd_cell1", lRow)
	sExid = (Grid0.GetCellData("bd_cell1", lRow))
'	sExid = (Grid0.GetCellData("bd_cell10", lRow))
	sProCode = Grid0.GetCellData("bd_cell6", lRow)
	sName = Grid0.GetCellData("bd_cell0", lRow)
	sCode = Transform_Code(sExid).."@"..sProCode
	if sCode <> null and sCode <> ""	then
		listlocation = split(Grid0.location, ":")
		nYPos = Int(listLocation[1])
		szData = sCode.."^"..sProCode.."^"..sName.."^".."".."^"..sExid.."^"..nYPos
		Form.OpenPopup("mhtro16052_p1" , szData , "")
	end if
End Sub


'============================================================================
' 숫자를 거래소 ID로 변환
'============================================================================
Function Transform_Code(sValue)
	if sValue == "104"	then
		return "HKS"
	elseif sValue == "529"	then
		return "HSI"
	elseif sValue == "215"	then
		return "SHS"
	elseif sValue == "214"	then
		return "SZS"
	elseif sValue == "321"	then
		return "NYS"
	elseif sValue == "066" or sValue == "66"	then
		return "AMX"
	elseif sValue == "537"	then
		return "NAS"
	elseif sValue =="130"	then
		return "NAO"
	elseif sValue == "625"	then
		return "SPI"
	elseif sValue == "310"	then
		return "DJI"
	elseif sValue == "106"	then
		return "TSE"
	elseif sValue == "107"	then
		return "OSE"
	elseif sValue == "112"	then
		return "JSD"
	elseif sValue == "889"	then
		return "NII"
	elseif sValue == "538"	then
		return "NAI"
	elseif sValue == "770"	then
		return "HSX"
	elseif sValue == "771"	then
		return "HNX"
	end if
end function

