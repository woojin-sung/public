			<TRAN tranid="gtsETFThemeInquiry" trcode="gtsETFThemeInquiry" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="gtsETFThemeSearch" title="gtsETFThemeSearch" realdata="0" dessvr="9" datamode=".WSKJson" >
				<TRBLOCK name="inblock" inout="in" _len="_calc_" />
				<TRBLOCK name="itemInfo" inout="out" _len="28" _ulen="28" >

nrec^^-1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="itemList" occurs="1" inout="out" _len="50" _ulen="50" >

fdes^^-1^0^0^0^0^0^0
sdes^^-1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="gtsETFThemeInquiry" title="gtsETFThemeInquiry" realdata="0" dessvr="9" datamode=".WSKJson" >
				<TRBLOCK name="inblock" inout="in" _len="94" _ulen="94" >

fdes^^-1^0^0^0^0^0^0
sdes^^-1^0^0^0^0^0^0
page^^-1^0^0^0^0^0^0
inqd^^-1^0^0^0^0^0^0

				</TRBLOCK>
