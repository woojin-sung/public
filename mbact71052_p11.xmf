'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_국내CFD
' 02. 화면설명 : 고객자산평가_상품별잔고_국내CFD
' 03. 작    성 : 2020.08.18 홍수지
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
Dim g_sParam

Dim g_szDate

dim g_szInputFile	'읽어들일세팅파일
g_szInputFile	 = "mbact71052.ini"
dim g_szKey		'키값		
g_szKey = "71052P11cmb"
Dim g_OpenFlag	'콤보인덱스 세팅 시, 서비스 중복조회 방지
g_OpenFlag = False

Dim g_nSelectRow

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "ACNO" , 0 , Left(g_szList(g_nAllCount), 8) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "ASNO" , 0 , "%" )							'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )				'날짜
		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )	'조회구분 : 월정산기준으로만 조회
		DATAMANAGER.RequestTranData( "obtrc_rmnd_004r" )
	else
		lblVisible()
	end if

End Function
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "03")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	

	cont0.grd1.SetClear()
	cont0.lblNone.visible = false
	
	g_sParam = sParam
	if sEventName == "mbact71052_p11" then			'국내CFD
	
		g_szList = Split(sParam,"○")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		VltnAmt_Request()
		
		g_nAcntCount = g_szList(0)		'계좌개수
		g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
		g_nNextCount = 0
		
'		szLoadData = CInt(Form.LoadConfigData(g_szInputFile, g_szKey))
		g_OpenFlag = true
'		if szLoadData == 0 or szLoadData == 1 then
'			cont0.cmb0.currentindex = szLoadData
'		else
'			cont0.cmb0.currentindex = "1"
'		end if
		
		if g_szList(1) == "Y" then
			cont0.grd1.rowcount = 0
			cont0.grd1.SetClear()
			AllSearch()
		else
			cont0.grd1.rowcount = 0
			cont0.grd1.SetClear()
			DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8)  )		'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )		'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
			DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )	'조회구분 : 월정산기준으로만 조회
			
			DATAMANAGER.RequestTranData( "obtrc_rmnd_004r" )
		end if
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, TempCount
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obtrc_rmnd_004r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obtrc_rmnd_004r", "OutBlock1")-1
			cont0.grd1.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ACNO" , i)
			szTemp0 = Left(szTemp0, 4).."-"..Right(szTemp0, 4).."-"..DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ASNO" , i)	
			szTemp0 = szTemp0.."("..DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ACNT_PRNM" , i)..")"	'계좌번호(상품명)
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ISNM" , i)						'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)			'포지션
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ACBK_QTY" , i)					'잔고수량
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "CFD_ACBK_PRC" , i)					'매수단가
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "CFD_VLTN_AMT" , i)					'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "CFD_VLTN_PRLS_AMT" , i)			'평가손익
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ERT" , i)						'수익률
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ACBK_AMT" , i)					'매입금액 - 상세
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "CFD_MGRT" , i)					'증거금률 - 상세
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "DEAL_CLS_CODE" , i)				'매매구분 코드
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ISCD" , i)						'종목코드
			
			'20230925 현재가, 기준가 추가
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "PSNT_PRC" , i)					'현재가
			
			if g_szList(1) == "Y" then
				cont0.grd1.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			end if
			cont0.grd1.SetCellData("bd_acc", g_nNextCount , DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ACNO" , i)..DATAMANAGER.GetDataValue( 0 , "obtrc_rmnd_004r", "OutBlock1", "ASNO" , i))	'20221110 HSZ 
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , "|  "&szTemp1)
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			cont0.grd1.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			cont0.grd1.SetCellData("bd_cell5", g_nNextCount , szTemp5)
'			cont0.grd1.SetCellData("bd_cell6", g_nNextCount , szTemp6)
'			cont0.grd1.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			cont0.grd1.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			cont0.grd1.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			cont0.grd1.SetCellData("bd_cell10", g_nNextCount  , szTemp10)
			cont0.grd1.SetCellData("bd_cell11", g_nNextCount  , szTemp11)
			
			'20230925 현재가, 기준가 추가
			cont0.grd1.SetCellData("bd_cell12", g_nNextCount  , szTemp12)
			
			if CDbl(szTemp7) > 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , "+"..FormatNumber(szTemp6, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , "+"..FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
			elseif CDbl(szTemp7) < 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp7, 2))
			end if	
			if CInt(szTemp10) = 2 then '매수
				cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCount, "10")
			elseif CInt(szTemp10) = 1 then '매도
				cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCount, "11")
			end if
			
			g_nNextCount = g_nNextCount + 1
		next
		
		cont0.grd1.rowcount = g_nNextCount
		
		if  DATAMANAGER.IsMoreNextData( "obtrc_rmnd_004r" ) == True then 
				DATAMANAGER.RequestNextData( "obtrc_rmnd_004r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'수익률
		if CDBL(nPrlsrate) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0)
			cont0.LblTotal.caption = szPrls
			cont0.LblTotal.fgcolor = "10"
		elseif CDBL(nPrlsrate) < 0 then
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.LblTotal.caption = szPrls
			cont0.LblTotal.fgcolor = "11"
		else
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.LblTotal.caption = szPrls
			cont0.LblTotal.fgcolor = "4"
		end if
	
	
	'계좌번호로 ID연결여부 조회
	elseif szTranID == "obcsb_efif_264r" then
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ID_LNKN_YN" , 0)
		
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		Dim szSendData
		Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10
		
		szTemp1 = cont0.grd1.GetCellData("bd_cell1", g_nSelectRow)		'종목명
		szTemp2 = cont0.grd1.GetCellData("bd_cell5", g_nSelectRow)		'평가금액
		szTemp3 = cont0.grd1.GetCellData("bd_cell8", g_nSelectRow)		'매입금액
		szTemp4 = cont0.grd1.GetCellData("bd_cell6", g_nSelectRow)		'평가손익
		szTemp5 = cont0.grd1.GetCellData("bd_cell7", g_nSelectRow)		'수익률
		szTemp6 = cont0.grd1.GetCellData("bd_cell2", g_nSelectRow)		'잔고구분
		szTemp7 = cont0.grd1.GetCellData("bd_cell9", g_nSelectRow)		'증거금율
		szTemp8 = cont0.grd1.GetCellData("bd_cell3", g_nSelectRow)		'체결잔고
		szTemp9 = cont0.grd1.GetCellData("bd_cell4", g_nSelectRow)		'매입단가
		szTemp10 = cont0.grd1.GetCellData("bd_cell11", g_nSelectRow)		'종목코드
		
		'20230925 현재가, 기준가 추가
		szTemp11 = cont0.grd1.GetCellData("bd_cell12", g_nSelectRow)		'현재가
		
		szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10 & "☆" & szTemp11
		
'		Form.ShowAlert("szSendData", szSendData)
		
		Form.OpenPopupAnimation("mbact71052_pc", szSendData, "", "2")
		
	end if
	
End Sub
