	g_nSelectRow = lRow
	
	'계좌번호로 ID연결여부 조회
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_264r" , "InBlock1" , "ACNO" , 0 , Left(szAccString, 8))
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_264r" , "InBlock1" , "ASNO" , 0 , Right(szAccString, 2))
