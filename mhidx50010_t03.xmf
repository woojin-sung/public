'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCodes

g_szCodes		=	Array(	"USDKRWSMBS", "CNYKRWCOMP", "JPYKRWCOMP", "EURKRWCOMP" )
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'해외 지수/종목 주기를 리턴해준다 . ( 종가 또는 지연)
'============================================================================
Function gf_GetForeignCycle(szCode)
	Select Case szCode  
		case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "NAS@SOX" '미국 '20190813 HWG : 미국 필라델피아 반도체 지수 심볼변경
		    return "종가"  
		    
		Case  "CME@ND", "CME@NQ", "CME@ES", "USI@RUT" '미국 '"CME@SP"20220209 HSZ S&P500 선물 삭제
		    return "지연(15분)"
		    
		Case "HSI@HSCE", "SZS@399107", "SZS@399108", "HSI@HSI", "SHS@000001", "SHS@000002", "SHS@000003" '아시아
		    return "지연(15분)"  
		
		Case "NII@NI225" '아시아
		    return "지연(20분)"    
		    
		Case "ILI@TA100", "ILI@TA125", "TWS@TI01", "INI@BSE30", "IDI@JKSE", "PHI@COMP", "VNI@VIDX"  '아시아 
		    return "종가"   
		
		Case "NLI@AEX", "PAS@CAC40", "XTR@DAX30", "STX@SX5E", "RUI@RTSI" '유럽
		    return "종가"
		
		Case "TRI@ISE100"	'유럽  			
		    return "지연(15분)"
		    
		Case "BRI@BVSP", "CAI@SPTSX", "ETC@DXY00", "MXI@IPC", "NZI@NZ50"	'미주/오세아니아주 
		    return "종가" 
		    
		Case "AUI@AORD" '미주/오세아니아주
		    return "지연(20분)"   
			
		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP","CNYKRWCOMP", "JPYKRWCOMP"  
			return "실시간" 	

		Case "USDCNYCOMP", "USDTWDCOMP", "USDGBPCOMP", "USDBRLCOMP", "USDVNDCOMP", "USDEURCOMP", "GBPKRWCOMP", "EURKRWCOMP", "USDRUBCOMP", "USDQARCOMP", "USDOMRCOMP", "USDMYRCOMP", "USDJODCOMP", "USDKWDCOMP", "USDAEDCOMP", "USDIDRCOMP", "USDEGPCOMP", "USDILSCOMP", "USDARSCOMP", "USDMXNCOMP", "USDNZDCOMP", "USDAUDCOMP", "USDTHBCOMP", "USDSEKCOMP", "USDNOKCOMP", "USDSARCOMP", "USDDKKCOMP", "USDINRCOMP", "USDHUFCOMP", "USDTRYCOMP", "USDPHPCOMP", "BRLKRWCOMP"		 
			return "실시간"
	End Select
' 20190603 HWG END
End Function

'============================================================================
'TR_Query()
'============================================================================
Function TR_Query()
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	DATAMANAGER.ClearInputData(1, "ohhts_exrt_cntg")

	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 1 , "EN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 2 , "EN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 3 , "EN" )
	
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , "USDKRWSMBS" )	'원/달러 환율
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , 1 , "JPYKRWCOMP" )	'원/엔 환율
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , 2 , "CNYKRWCOMP" )	'원/위안 환율
	DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , 3 , "EURKRWCOMP" )	'원/유로 환율
	
	DATAMANAGER.RequestTranData("ohhts_1684_001r" )

end Function 

