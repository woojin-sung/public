'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grd00.transmode = 1
	grd01.transmode = 1
	grd02.transmode = 1
	grd03.transmode = 1

	grd00.SetCellData("bd_name", 0, "원/달러")
	grd01.SetCellData("bd_name", 0, "원/위안")
	grd02.SetCellData("bd_name", 0, "원/엔")
	grd03.SetCellData("bd_name", 0, "원/유로")
	
	'가격 색상속성값 미사용
	grd00.setAttributeEnable("0", "bd_pr")
	grd01.setAttributeEnable("0", "bd_pr")
	grd02.setAttributeEnable("0", "bd_pr")
	grd03.setAttributeEnable("0", "bd_pr")
	
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "2" then '아이폰
		grd00.SetPropGridCell("fontstyle", "bd_pr" , 0, true)
		grd01.SetPropGridCell("fontstyle", "bd_pr" , 0, true)
		grd02.SetPropGridCell("fontstyle", "bd_pr" , 0, true)
		grd03.SetPropGridCell("fontstyle", "bd_pr" , 0, true)
	end if 
	
	TR_Query()
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'rdoCounty00_OnClick
'============================================================================
Sub rdoCounty00_OnClick(nIndex)
	TR_Query()
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1684
	dim szRealCode
	
	if szTranID = "ohhts_1684_001r" then 
		DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
		ncnt1684 = DATAMANAGER.GetDataCount(0, "ohhts_1684_001r" , "OutBlock1")
	
		for i = 0 to ncnt1684 - 1
		  szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_ISCD", i )
		  szName = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_ISNM", i )
		  szPrpr = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRPR", i )
		  szSign = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", i )
		  szVrss = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS", i )
		  szCtrt = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT", i )
		  
		  Select Case szRealCode
		  Case g_szCodes(0)
			  grd00.SetCellData("bd_code", 0, szRealCode)
			  grd00.SetCellData("bd_pr", 0, szPrpr)
			  grd00.SetCellData("bd_debi", 0, szSign)
			  grd00.SetCellData("bd_prdy", 0, szVrss)
			  grd00.SetCellData("bd_ctrt", 0, szCtrt)
			  
			  DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", 0, szRealCode) 
			  grd00_colorSetting(CInt(szSign))
			  grd00.rowcount = 1
		  Case g_szCodes(1)
		  	  grd01.SetCellData("bd_code", 0, szRealCode)
			  grd01.SetCellData("bd_pr", 0, szPrpr)
			  grd01.SetCellData("bd_debi", 0, szSign)
			  grd01.SetCellData("bd_prdy", 0, szVrss)
			  grd01.SetCellData("bd_ctrt", 0, szCtrt)
			  
			  DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg_1", "InBlock1", "FIDR_SYMB", 0, szRealCode) 
			  grd01_colorSetting(CInt(szSign))
			  grd01.rowcount = 1
		  Case g_szCodes(2)
			  grd02.SetCellData("bd_code", 0, szRealCode)
			  grd02.SetCellData("bd_pr", 0, szPrpr)
			  grd02.SetCellData("bd_debi", 0, szSign)
			  grd02.SetCellData("bd_prdy", 0, szVrss)
			  grd02.SetCellData("bd_ctrt", 0, szCtrt)
			  
			  DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg_2", "InBlock1", "FIDR_SYMB", 0, szRealCode) 
			  grd02_colorSetting(CInt(szSign))
			  grd02.rowcount = 1
		  Case g_szCodes(3)
			  grd03.SetCellData("bd_code", 0, szRealCode)
			  grd03.SetCellData("bd_pr", 0, szPrpr)
			  grd03.SetCellData("bd_debi", 0, szSign)
			  grd03.SetCellData("bd_prdy", 0, szVrss)
			  grd03.SetCellData("bd_ctrt", 0, szCtrt)
			  
			  DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg_3", "InBlock1", "FIDR_SYMB", 0, szRealCode) 
			  grd03_colorSetting(CInt(szSign))
			  grd03.rowcount = 1
		  End Select
		  
		Next	    
		
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg_1")
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg_2")
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg_3")
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	szPrpr = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_EXRT_PRPR", 0 )
	szSign = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_PRDY_VRSS_SIGN", 0 )
	szVrss = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_EXRT_PRDY_VRSS", 0 )
	szCtrt = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_PRDY_CTRT", 0 )

	Select Case szTranID
		Case "ohhts_exrt_cntg"
			grd00.SetCellData("bd_pr", 0, szPrpr)
			grd00.SetCellData("bd_debi", 0, szSign)
			grd00.SetCellData("bd_prdy", 0, szVrss)
			grd00.SetCellData("bd_ctrt", 0, szCtrt)
			  
			grd00_colorSetting(CInt(szSign))
			
		Case "ohhts_exrt_cntg_1"
			grd01.SetCellData("bd_pr", 0, szPrpr)
			grd01.SetCellData("bd_debi", 0, szSign)
			grd01.SetCellData("bd_prdy", 0, szVrss)
			grd01.SetCellData("bd_ctrt", 0, szCtrt)
			  
			grd01_colorSetting(CInt(szSign))
			
		Case "ohhts_exrt_cntg_2"
			grd02.SetCellData("bd_pr", 0, szPrpr)
			grd02.SetCellData("bd_debi", 0, szSign)
			grd02.SetCellData("bd_prdy", 0, szVrss)
			grd02.SetCellData("bd_ctrt", 0, szCtrt)
			  
			grd02_colorSetting(CInt(szSign))
			
		Case "ohhts_exrt_cntg_3"
			grd03.SetCellData("bd_pr", 0, szPrpr)
			grd03.SetCellData("bd_debi", 0, szSign)
			grd03.SetCellData("bd_prdy", 0, szVrss)
			grd03.SetCellData("bd_ctrt", 0, szCtrt)
			  
			grd03_colorSetting(CInt(szSign))
	End Select
	
End Sub
'============================================================================
'	조회 서비스 호출 후, fgcolor 세팅
'============================================================================
Function grd00_colorSetting(nVrssSign)
	Select Case nVrssSign
	Case 1, 2
		grd00.SetCellFgColor("bd_debi", 0, "10")
		grd00.SetCellFgColor("bd_prdy", 0, "10")
		grd00.SetCellFgColor("bd_ctrt", 0, "10")

	Case 4, 5
		grd00.SetCellFgColor("bd_debi", 0, "11")
		grd00.SetCellFgColor("bd_prdy", 0, "11")
		grd00.SetCellFgColor("bd_ctrt", 0, "11")

	Case Else
		grd00.SetCellFgColor("bd_debi", 0, "12")
		grd00.SetCellFgColor("bd_prdy", 0, "12")
		grd00.SetCellFgColor("bd_ctrt", 0, "12")
	End Select
End Function

'============================================================================
Function grd01_colorSetting(nVrssSign)
	Select Case nVrssSign
	Case 1, 2
		grd01.SetCellFgColor("bd_debi", 0, "10")
		grd01.SetCellFgColor("bd_prdy", 0, "10")
		grd01.SetCellFgColor("bd_ctrt", 0, "10")

	Case 4, 5
		grd01.SetCellFgColor("bd_debi", 0, "11")
		grd01.SetCellFgColor("bd_prdy", 0, "11")
		grd01.SetCellFgColor("bd_ctrt", 0, "11")


	Case Else
		grd01.SetCellFgColor("bd_debi", 0, "12")
		grd01.SetCellFgColor("bd_prdy", 0, "12")
		grd01.SetCellFgColor("bd_ctrt", 0, "12")

	End Select
End Function

'============================================================================
Function grd02_colorSetting(nVrssSign)
	Select Case nVrssSign
	Case 1, 2
		grd02.SetCellFgColor("bd_debi", 0, "10")
		grd02.SetCellFgColor("bd_prdy", 0, "10")
		grd02.SetCellFgColor("bd_ctrt", 0, "10")

	Case 4, 5
		grd02.SetCellFgColor("bd_debi", 0, "11")
		grd02.SetCellFgColor("bd_prdy", 0, "11")
		grd02.SetCellFgColor("bd_ctrt", 0, "11")

	Case Else
		grd02.SetCellFgColor("bd_debi", 0, "12")
		grd02.SetCellFgColor("bd_prdy", 0, "12")
		grd02.SetCellFgColor("bd_ctrt", 0, "12")

	End Select
End Function

'============================================================================
Function grd03_colorSetting(nVrssSign)
	Select Case nVrssSign
	Case 1, 2
		grd03.SetCellFgColor("bd_debi", 0, "10")
		grd03.SetCellFgColor("bd_prdy", 0, "10")
		grd03.SetCellFgColor("bd_ctrt", 0, "10")

	Case 4, 5
		grd03.SetCellFgColor("bd_debi", 0, "11")
		grd03.SetCellFgColor("bd_prdy", 0, "11")
		grd03.SetCellFgColor("bd_ctrt", 0, "11")

	Case Else
		grd03.SetCellFgColor("bd_debi", 0, "12")
		grd03.SetCellFgColor("bd_prdy", 0, "12")
		grd03.SetCellFgColor("bd_ctrt", 0, "12")
		
	End Select
End Function
				
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Reload_Data" then
		TR_Query()
	end if		
End Sub

