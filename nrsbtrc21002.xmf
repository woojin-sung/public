'============================================================================
' 화 면 명 : 보유CFD 권리(국내/해외)
' 화면설명 : 보유CFD 권리(국내/해외) 화면
' 작    성 : 2023.09.25 KKM
'============================================================================
Dim g_nIndex '0, 30, 60..... 
Dim g_szGubun
Dim g_szData, g_szSearchWord, g_szFullCode, g_szItemCode0, g_szMarket ', g_szItemCode1
Dim g_nTopLine1, g_nTopLine2, g_nTopLine23, g_nTopLine3, g_nTopLine33, g_nTopLine4, g_nTopLine5, g_nTopLine6
g_nTopLine1 = 14
g_nTopLine2 = 42
g_nTopLine22 = 35
g_nTopLine3 = 63
g_nTopLine33 = 73
g_nTopLine4 = 97		
g_nTopLine5 = 117 
g_nTopLine6 = 137	

g_nIndex = 0
g_isEmpty_Code0 = false
'g_isEmpty_Code1 = false

Dim g_szAcno, g_szAsno

Dim g_szBefore
g_szBefore = 0

function SetVisible()

	'국내해외 전화	
	if g_szGubun == "1" then '해외
		g_szBefore = Combo2.currentindex		
		Combo2.enable = "0"		
		Combo2.currentindex = 1
		Label2.caption = "지급"
		Img2.visible = "0"
		
	else
		Combo2.enable = "1"
		'Combo2.currentindex = 1
		Label2.caption = Combo2.caption		
		Img2.visible = "1"
	end if
end function

'============================================================================
Sub Form_OnFormInitBefore()
	'아이콘 이미지 
	ImgBackPress.setMaintainingRatio("1")	
	imgInfo.setMaintainingRatio("1")	
	ImgMenu.setMaintainingRatio("1")		
	Img1.setMaintainingRatio("1")	
	Img2.setMaintainingRatio("1")	
	Img3.setMaintainingRatio("1")	
	imgDate.setMaintainingRatio("1")	
	imgNotice.setMaintainingRatio("1")	
	Pannel0.Image0.setMaintainingRatio("1")	
	Pannel0.Image1.setMaintainingRatio("1")	
	Pannel0.Image2.setMaintainingRatio("1")	
	Pannel0.Image3.setMaintainingRatio("1")	
	Pannel0.Image4.setMaintainingRatio("1")	
	Pannel0.Image5.setMaintainingRatio("1")	
	Pannel0.imgBG.setMaintainingRatio("1")	
	
	imgSearch.setMaintainingRatio("1")
	ImgX.setMaintainingRatio("1")		
	
	Pannel0.bgcolor = "246247248"
	Form.bgcolor = "246247248"	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	acnt1.SetTotalEnable(true)  '전체계좌 추가

	 '국내/해외구분
	if Form.GetAccountInfo(Trim(acnt1.caption), "productcode") == "137" then '해외
		g_szGubun = "1"
		g_szMarket = "OV"
		'Image5.left = 763
	elseif Form.GetAccountInfo(Trim(acnt1.caption), "productcode") == "136" then '국내
		g_szGubun = "0"
		g_szMarket = "%"
		'Image5.left = 763
	else 
		g_szGubun = "-1" '전체(해외+국내)
		g_szMarket = "%"
		'Image5.left = 276		
	end if 
	
	ImgX.visible = false
	Container0.lblItemCode.setAutoScrollText("종목 검색")
	Container0.lblItemCode.fgcolor = 294 	

	'국내권리유형
	 sSavedData = Form.LoadConfigData("nrsbtrc21002", "Combo1") 
	 if sSaveData <> "" and sSaveData <> null then
		Combo1.cbkeydata = sSaveData
	 end if 
	Label1.caption = Combo1.caption
'	'해외권리유형
'	 sSavedData = Form.LoadConfigData("nrsbtrc21002", "Combo4") 
'	 if sSaveData <> "" and sSaveData <> null then
'		Combo4.cbkeydata = sSaveData
'	 end if 
'	Label4.caption = Combo4.caption	
	'처리상태
	 sSavedData = Form.LoadConfigData("nrsbtrc21002", "Combo2")	
	 if sSaveData <> "" and sSaveData <> null then
		Combo2.cbkeydata = sSaveData
	 end if 	
	 Label2.caption = Combo2.caption
	 '매매구분 for CFD
	 sSavedData =  Form.LoadConfigData("nrsbtrc21002", "Combo3")
	 if sSaveData <> "" and sSaveData <> null then
		Combo3.cbkeydata = sSaveData
	 end if 	
	Label3.caption = Combo3.caption
	
	'기간 6 개월
	cldFromDate.caption = Left(Form.calcDateTime( nYear, -6, nDay, nHour, nMinute, nSecond ), 8)	
	lbDate.caption = Right(cldFromDate.caption, 6) & Right(cldToDate.caption, 6)
	
	g_isEmpty_Code0 = true

	SetVisible()
	requestData()
	'Pannel0.addfooter = "nrsbonl83000_p0.xmf"	
	
	ImgX.visible = false
	Container0.lblItemCode.setUseAutoScroll(true, 30, true)
	Container0.lblItemCode.setAutoScrollText("종목 검색")
	Container0.lblItemCode.fgcolor = 294		
End Sub

'============================================================================
Sub Form_OnFormClose()
	 '국내/해외구분
	 'Form.SaveConfigData("nrsbonl83000", "fmtab0", fmtab0.currenttab)
	 '국내권리유형
	 Form.SaveConfigData("nrsbtrc21002", "Combo1", Combo1.cbkeydata)
	 '해외권리유형
'	 Form.SaveConfigData("nrsbtrc21002", "Combo4", Combo4.cbkeydata)
	 '처리상태
	 Form.SaveConfigData("nrsbtrc21002", "Combo2", Combo2.cbkeydata)
	 '매매구분 for CFD
	 Form.SaveConfigData("nrsbtrc21002", "Combo3", Combo3.cbkeydata)
End Sub

