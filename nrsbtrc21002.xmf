'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 0 then  '보유주식권리(국내/해외)
		Form.CloseForm()
		Form.OpenScreen("83000" , "")
	elseif iIndex == 2 then ' 전체권리일정조회(국내/해외)
		Form.CloseForm()
		Form.OpenScreen("16402" , "")
	else '보유CFD 권리(국내/해외)
		ImgMenu.imgpath = "icon_arrow_down2.png"
	end if 
End Sub
'20230907 KKM END

'국내/해외 계좌전환
'============================================================================
Sub acnt1_ChangeAccount()

	if acnt1.caption == "ALL" then
		g_szGubun = "-1" '전체(해외+국내)
	else
		'국내/해외구분
		if Form.GetAccountInfo(Trim(acnt1.caption), "productcode") == "137" then '해외
			g_szGubun = "1"
			if Label1.caption == "분배금" then
				Combo1.currentindex = 0
				Label1.caption = Combo1.caption
			end if 
		elseif Form.GetAccountInfo(Trim(acnt1.caption), "productcode") == "136" then '국내
			Combo2.currentindex = g_szBefore 
			g_szGubun = "0"
		end if
	end if  

	lbDate.caption = Right(cldFromDate.caption, 6) & Right(cldToDate.caption, 6)

	SetVisible()
	ImgX_OnClick()
	requestData()	
End Sub

