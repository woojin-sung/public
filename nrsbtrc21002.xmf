'조회
'============================================================================
Function requestData()
	g_nIndex = 0
	Pannel0.rowcount = 0
	grd0.SetClear()
	
	'계좌체크
	if acnt1.total == "" or acnt1.total == null then
		'Form.ShowAlert("알림", "계좌번호를 확인해 주시기 바랍니다.")
		imgNotice.left = 160
		lbNoticeMsg.left = 84
		return False
	else
		imgNotice.left = 560
		lbNoticeMsg.left = 484	
	end if
	
	DATAMANAGER.RequestTranData("obrgt_oscm_860r") '국내	
end Function

'============================================================================
Sub Button1_OnClick()
	requestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szInputCode
	'종목코드
'msgbox g_isEmpty_Code0
	'종목코드
	if g_isEmpty_Code0 == true then	
		g_szItemCode0 = "%"		
		g_szMarket = "%"		
	end if 
	
	'계좌번호
	if Trim(acnt1.caption) == "ALL" or Trim(acnt1.caption) == ""  then
		g_szAcno = "%"
		g_szAsno = "%"
	else
		g_szAcno = left(Trim(acnt1.caption),8)
		g_szAsno = right(Trim(acnt1.caption),2)	
	end if 
	
	imgNotice.left = 560
	lbNoticeMsg.left = 484
	
	if szTranID == "obrgt_oscm_860r" then   '국내/해외 모두 사용
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STA_DATE" , 0 , cldFromDate.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIN_DATE" , 0 , cldToDate.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szAsno )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , g_szMarket ) '해외주식시장거래구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , 0 , g_szItemCode0 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RGHT_TYPE_CODE" , 0 , Combo1.cbkeydata ) '%전체, .... 권리들
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PSTN_CLS_CODE" , 0 , Combo3.cbkeydata ) ' %전체 1.매수 2.매도
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_CLS" , 0 , Combo2.cbkeydata) ' %전체 1.지급 2.예정
	end if 

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	Dim szRghtCd, szRghtNm, szProsCode, szProsNm, szActNm, szRgDate, sTemp, szFrskQty, iSetHeight, szCRCD
	Dim szPstnNm, szPstnColor, szAmt1, szAmt2
	Dim j
	Dim szGubun
	
'국내CFD 01 유상, 02 무상, 03 배당  (예정,지금)
'해외CFD 03 배당 (지급)

'msgbox Form.GetAccountInfo( Trim(acnt1.caption), "itemcodetype")
	if szTranID == "obrgt_oscm_860r" then   '국내CFD/해외CFD권리

		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		if nCnt == 0 then
			imgNotice.left = 160
			lbNoticeMsg.left = 84
			Pannel0.rowcount = 0
			g_nIndex = 0
			Exit Sub
		else
			imgNotice.left = 560
			lbNoticeMsg.left = 484
		end if 
		
		Pannel0.rowcount = g_nIndex + nCnt
		for i = 0 to nCnt-1		
			j = i + g_nIndex
			
			szRghtCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RGHT_TYPE_CODE" , i)   '권리유형코드 		
			szRghtNm = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RGHT_TYPE_NAME" , i)	'권리유형명
			szProsCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_CLS" , i)	'처리구분코드	: '0 전체, 1 지급, 2 예정
			if szProsCode == "1" then
				szProsNm = "지급"
			else
				szProsNm = "예정"
			end if 	
			
			Pannel0.SetcellVisible( "Label7", j, 0 )
			Pannel0.SetcellVisible( "Label9", j, 0 )
			Pannel0.SetcellVisible( "Label8", j, 0 )
			Pannel0.SetcellVisible( "Label10", j, 0 )			
			Pannel0.SetcellVisible( "Label16", j, 0 )			
			Pannel0.SetcellVisible( "Label17", j, 0 )
			
			'계좌명
			szActNm = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNT_PRNM" , i))
			szCRCD = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CRCD", i) '통화코드
			if szCRCD <> "원" then
				szCRCD = " "& szCRCD
			end if 
			if szActNm <> "" and szActNm <> nil then
				Pannel0.SetCellValue( "Label0", j, szActNm )				
				'국내해외구분코드 1:국내, 2:해외
				if DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DMAB_CLS_CODE", i) == "1" then '국내
					szGubun = "0"'국내
				else
					szGubun = "1" '해외
				end if 			
				'SetVisible()
 				
				'계좌가 전체일 경우 계좌정보 보이고 아닌 경우 숨기기
				if Trim(acnt1.caption) == "ALL" then
					Pannel0.SetCellVisible( "Label0", j, 1 )					
					Pannel0.SetPropCardCell( "left", "Label0", j, "20" )					
					
					g_nTopLine1 = 14
					g_nTopLine2 = 42
					g_nTopLine22 = 37
					g_nTopLine3 = 63
					g_nTopLine33 = 73
					g_nTopLine4 = 97		
					g_nTopLine5 = 117 
					g_nTopLine6 = 137						
				else
					Pannel0.SetCellVisible( "Label0", j, 0 )
					Pannel0.SetPropCardCell( "left", "Label0", j, "520" )
					
					g_nTopLine1 = 14
					g_nTopLine2 = 22
					g_nTopLine22 = 17
					g_nTopLine3 = 46
					g_nTopLine33 = 56
					g_nTopLine4 = 79		
					g_nTopLine5 = 100 
					g_nTopLine6 = 121	
				end if
				
				Pannel0.SetPropCardCell( "top", "Label11", j, g_nTopLine2 )	
				Pannel0.SetPropCardCell( "top", "Image0",  j, g_nTopLine2 )	
				Pannel0.SetPropCardCell( "top", "Label12", j, g_nTopLine2 )	
				Pannel0.SetPropCardCell( "top", "Image1", j, g_nTopLine2 )
				Pannel0.SetPropCardCell( "top", "Image5", j, g_nTopLine2 )
				Pannel0.SetPropCardCell( "top", "Label13", j, g_nTopLine2 )
				Pannel0.SetPropCardCell( "top", "Image2", j, g_nTopLine2 )
				Pannel0.SetPropCardCell( "top", "Image4", j, g_nTopLine2 )
				Pannel0.SetPropCardCell( "top", "Label5", j, g_nTopLine22)		
						
				Pannel0.SetPropCardCell( "top", "Label6", j, g_nTopLine3 )		
				Pannel0.SetPropCardCell( "top", "Label15", j, g_nTopLine3 )		
				Pannel0.SetPropCardCell( "top", "Image3", j, g_nTopLine33 )		
						
				Pannel0.SetPropCardCell( "top", "Label7", j, g_nTopLine4 )		
				Pannel0.SetPropCardCell( "top", "Label9", j, g_nTopLine4 )		
				Pannel0.SetPropCardCell( "top", "Label8", j,  g_nTopLine5 )		
				Pannel0.SetPropCardCell( "top", "Label10", j, g_nTopLine5 )		
				Pannel0.SetPropCardCell( "top", "Label16", j, g_nTopLine6 )		
				Pannel0.SetPropCardCell( "top", "Label17", j, g_nTopLine6 )	

				Pannel0.SetCellValue( "Label11", j, szRghtNm ) '권리유형명
				
				'지급/예정
				if szProsNm == "지급" then
					Pannel0.SetcellVisible( "Image1", j, 1 )
					Pannel0.SetcellVisible( "Image5", j, 0 )
					Pannel0.SetPropCardCell( "fgcolor", "Label12", j, "323:198131000" )	'수정예정				
				else '예정
					Pannel0.SetcellVisible( "Image1", j, 0 )
					Pannel0.SetcellVisible( "Image5", j, 1 )
					Pannel0.SetPropCardCell( "fgcolor", "Label12", j, "368:081133048" ) '수정예정						
				end if 
				Pannel0.SetCellValue( "Label12", j, szProsNm ) 
				
				'CFD 매수매도
				if DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PSTN_CLS_CODE" , i) == "1" then '매매구분
					szPstnNm = "매수"
					Pannel0.SetcellVisible( "Image2", j, 1 )
					Pannel0.SetcellVisible( "Image4", j, 0 )
					Pannel0.SetPropCardCell( "fgcolor", "Label13", j, "323:218100096" )	
				else
					szPstnNm = "매도"
					Pannel0.SetcellVisible( "Image2", j, 0 )
					Pannel0.SetcellVisible( "Image4", j, 1 )
					Pannel0.SetPropCardCell( "fgcolor", "Label13", j, "291:079102214" )							
				end if 
				Pannel0.SetCellValue( "Label13", j, szPstnNm ) '매수/매도
				'종목명
				if szGubun == "1" then '해외
					sTemp = "[" & DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", i) & "] "
					sTemp = sTemp & DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM", i)
					Pannel0.SetCellValue( "Label6", j, sTemp)	'[종목코드]종목명			
				else
					Pannel0.SetCellValue( "Label6", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM", i))	'종목명			
				end if 
				'지급일자
				Pannel0.SetcellVisible( "Label5", j, 1 )
				sTemp = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STND_DATE" , i)
				szRgDate = Mid(sTemp, 3, 2) & "." & Mid(sTemp, 5, 2) & "." & Mid(sTemp, 7, 2)
				
				Pannel0.SetCellValue( "Label5", j, szRgDate)	
			
				Pannel0.SetcellVisible( "Label7", j, 0 )
				Pannel0.SetcellVisible( "Label9", j, 0 )
				Pannel0.SetcellVisible( "Label8", j, 0 )
				Pannel0.SetcellVisible( "Label10", j, 0 )	
				
				szAmt1 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MNRC_FRCR_AMT" , i)
				if szAmt1 <> nil then 
					szAmt1 = CDbl(szAmt1)
					if szAmt1 == "0" or szAmt1 == 0 then
						szAmt1 = "0"
					end if
				else 
					szAmt1 = "0"
				end if 				
				szAmt2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DRNG_FRCR_AMT" , i)
				if szAmt2 <> nil then 
					szAmt2 = CDbl(szAmt2)
					if szAmt2 <= 0 then
						szAmt2 = "0"
					end if
				else 
					szAmt2 = "0"
				end if 				
	
				'권리유형별 보여지는 정보설정
				iSetHeight = 130
				Select Case szRghtCd
				
					Case "01" '01	유상
						Pannel0.SetcellVisible( "Label7", j, 1 )
						Pannel0.SetcellVisible( "Label9", j, 1 )
						Pannel0.SetcellVisible( "Label5", j, 1 )
						Pannel0.SetCellValue( "Label5", j, "기준일 " & szRgDate)
						
						'신주인수권이 있는 경우 
						if InStr(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LSTN_ISCD" , i) , "J") > 0 or InStr(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LSTN_ISCD" , i) , "j") > 0 then						
							Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0" )
							if szPstnNm ==  "매수" then '매수
								if szGubun == "1" then '해외
									Pannel0.SetCellValue( "Label7", j, "CFD유상증서매각대금입금" )
									Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0" )
								else
									Pannel0.SetCellValue( "Label7", j, "CFD유상증서매각대금입금" )
									Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0" )
								end if 
								Pannel0.SetCellValue( "Label9", j, szAmt1)
							else '매도 
								if szGubun == "1" then '해외
									Pannel0.SetCellValue( "Label7", j, "CFD유상증서매각대금출금" )
									Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0" )
								else '- 국내없음
									Pannel0.SetCellValue( "Label7", j, "CFD유상증서차입매각대금출금" )
									Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0" )
								end if 
								Pannel0.SetCellValue( "Label9", j, szAmt2)
							end if
						else
							'Pannel0.SetCellValue( "Label7", j, "배정주수" )
							'Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LAST_ASGM_QTY" , i))						
							Pannel0.SetCellValue( "Label7", j, "입고수량" )
							Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,주,0,,-1,1,0,0,0" )
							Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))						
						end if 
					Case "02" '02	무상
						Pannel0.SetcellVisible( "Label7", j, 1 )
						Pannel0.SetcellVisible( "Label9", j, 1 )
						Pannel0.SetcellVisible( "Label5", j, 1 )
						Pannel0.SetCellValue( "Label5", j, "기준일 " & szRgDate)
						
						Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,주,0,,-1,1,0,0,0" )
						if szProsCode ==  "2" then '예정						
							if szPstnNm ==  "매수" then '매수
								if szGubun == "1" then '해외
									Pannel0.SetCellValue( "Label7", j, "CFD무상주입고" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))
								else
									Pannel0.SetCellValue( "Label7", j, "CFD무상주입고" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))
								end if 
							else '매도
								if szGubun == "1" then '해외
									Pannel0.SetCellValue( "Label7", j, "CFD권리분차입" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TKWR_QTY" , i))
								else
									Pannel0.SetCellValue( "Label7", j, "CFD차입배정수량" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TKWR_QTY" , i))
								end if 
							end if 
						else '지급				
							if szPstnNm ==  "매수" then '매수
								if szGubun == "1" then '해외
									Pannel0.SetCellValue( "Label7", j, "CFD무상주입고" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))
								else
									Pannel0.SetCellValue( "Label7", j, "CFD무상주지급수량" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))
								end if 
								
							else '매도
								if szGubun == "1" then '해외
									Pannel0.SetCellValue( "Label7", j, "CFD권리분차입" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TKWR_QTY" , i))
								else
									Pannel0.SetCellValue( "Label7", j, "CFD차입배정수량" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TKWR_QTY" , i))
								end if 
								
							end if 						
						end if 

'						
					Case "03" '03	배당(현금, 주식, 동시배당)	국내/해외
						
						if szGubun == "1" then '해외	
							Pannel0.SetcellVisible( "Label7", j, 1 )
							Pannel0.SetcellVisible( "Label9", j, 1 )
							Pannel0.SetcellVisible( "Label5", j, 1 )
							Pannel0.SetCellValue( "Label5", j, "기준일 " & szRgDate)						
	
							if szRghtNm == "현금배당" then
								Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0" )
								if szPstnNm ==  "매수" then '매수
									Pannel0.SetCellValue( "Label7", j, "CFD배당상당액입금" )
									Pannel0.SetCellValue( "Label9", j, szAmt1)
								else '매도
									Pannel0.SetCellValue( "Label7", j, "CFD배당상당액출금" )
									Pannel0.SetCellValue( "Label9", j, szAmt2 )
								end if 								
							
							elseif szRghtNm == "주식배당" then
								Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,주,0,,-1,1,0,0,0" )
								if szPstnNm ==  "매수" then '매수
									Pannel0.SetCellValue( "Label7", j, "CFD배당입고" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))
								else '매도
									Pannel0.SetCellValue( "Label7", j, "CFD배당출고" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TKWR_QTY" , i))
								end if 								
							end if 				
							
						else '국내
							Pannel0.SetcellVisible( "Label7", j, 1 )
							Pannel0.SetcellVisible( "Label9", j, 1 )
							Pannel0.SetcellVisible( "Label5", j, 1 )
							Pannel0.SetCellValue( "Label5", j, "기준일 " & szRgDate)
							
							if szRghtNm == "현금배당" or szRghtNm == "동시배당" then					
								Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,0,1,0,0,0" )
								if szPstnNm ==  "매수" then '매수
									Pannel0.SetCellValue( "Label7", j, "CFD배당상당액입금" )
									Pannel0.SetCellValue( "Label9", j, szAmt1)
								else '매도
									Pannel0.SetCellValue( "Label7", j, "CFD차입배당상당액출금" )
									Pannel0.SetCellValue( "Label9", j, szAmt2)
								end if 
							elseif szRghtNm == "주식배당" then
								Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,주,0,,-1,1,0,0,0" )
								if szPstnNm ==  "매수" then '매수
									Pannel0.SetCellValue( "Label7", j, "CFD배당입고수량" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WRHS_QTY" , i))
								else '매도
									Pannel0.SetCellValue( "Label7", j, "CFD배당출고수량" )
									Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TKWR_QTY" , i))
								end if 							
							end if 
						
						end if 	
						
					Case "17", "28", "30" '17	ETF분배금, 28	ETN분배금, 30	펀드분배금 17,28,30 
						Pannel0.SetcellVisible( "Label7", j, 1 )
						Pannel0.SetcellVisible( "Label7", j, 1 )
						Pannel0.SetcellVisible( "Label9", j, 1 )
						Pannel0.SetcellVisible( "Label5", j, 1 )
						Pannel0.SetCellValue( "Label5", j, "기준일 " & szRgDate)
						
						if szGubun == "0" then 'Only 국내
							Pannel0.SetPropCardCell( "mask", "Label9", j, "0,0,,"& szCRCD & ",0,,0,1,0,0,0" )
							if szPstnNm ==  "매수" then '매수
								Pannel0.SetCellValue( "Label7", j, "CFD배당상당액입금" )
								Pannel0.SetCellValue( "Label9", j, szAmt1)
							else '매도
								Pannel0.SetCellValue( "Label7", j, "CFD차입배당상당액출금" )
								Pannel0.SetCellValue( "Label9", j, szAmt2)
							end if 
						end if 
				End Select 
				
				'계좌번호가 표기되지 않을 경우
				if Trim(acnt1.caption) <> "ALL" then
					iSetHeight = iSetHeight - 20
				end if 

				Pannel0.SetPropCardCell( "height", "imgBG", j, iSetHeight+9&"" )
				Pannel0.SetCardWHAt( j, iSetHeight)				
				
			end if			
		next
		
		if  DATAMANAGER.IsMoreNextData( "obrgt_oscm_860r" ) == True then
			g_nIndex = _tonumber( grd0.rowcount )			
			DATAMANAGER.RequestNextData( "obrgt_oscm_860r" )
		else
			Pannel0.addfooter = "nrsbonl83000_p0.xmf"		
		end if
		
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'msgbox 	szErrCode & "::" & szErrMsg
	if szErrCode == "5820" then
		imgNotice.left = 160
		lbNoticeMsg.left = 84
		Pannel0.rowcount = 0
	end if 
End Sub

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'종목코드 검색창
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	Dim sCode
	if sDlgName == "SEARCH" then
		if sReturn1 <> "" and sReturn1 <> null then
			Container0.lblItemCode.setAutoScrollText(sItemCode)
			Container0.lblItemCode.fgcolor = 267
			ImgX.visible = true
		
			g_szFullCode = sReturn1
			g_szSearchWord = Form.GetItemCodeInfo(g_szFullCode, "name")	
			g_szMarket = Form.GetItemCodeInfo(g_szFullCode, "market")	
'msgbox  "Form_OnCommonDialogReturn : "& g_szGubun & " : " & g_szFullCode & " : " & g_szSearchWord & " : " & g_szMarket	
			if g_szMarket == "OV" then
				sCode = Split(g_szFullCode, "@")
				g_szMarket = sCode(0)
				g_szItemCode0 = sCode(1)			
			else
			    if g_szMarket = "J" Then
				    g_szItemCode0 = "A" & g_szFullCode	
			    else 
				    g_szItemCode0 = g_szFullCode
			    end if			
			end if
			
			'Container0.lblItemCode.caption = g_szSearchWord				
			Container0.lblItemCode.setAutoScrollText(g_szSearchWord)
			g_isEmpty_Code0 = false	
			requestData()			
		else
			g_isEmpty_Code0 = true		
		end if 
			
	end if
End Sub

'조건선택 후
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'if sKeyName == "RIGHT_SET" then '권리유형(국내)
	if sKeyName == "RIGHT_SET" or sKeyName ==  "RIGHT_SET1" then '권리유형(국내/해외)
		if sRet <> "" and sRet <> null then
			Combo1.cbkeydata = sRet
			Label1.caption = Combo1.caption
			requestData()
		end if 
'	elseif sKeyName == "RIGHT_SET1" then '권리유형(해외)
'		if sRet <> "" and sRet <> null then
'			Combo4.cbkeydata = sRet
'			Label4.caption = Combo4.caption
'			requestData()
'		end if 
	elseif sKeyName == "PROC_SET" then  '처리상태
		if sRet <> "" and sRet <> null then
			Combo2.cbkeydata = sRet
			Label2.caption = Combo2.caption
			requestData()
		end if 
	elseif sKeyName == "DATE_SET" then  '기간설정
	
		if sRet <> "" and sRet <> null then
			cldFromDate.caption = Left(sRet, 8)
			cldToDate.caption = Right(sRet, 8)
			lbDate.caption = Right(cldFromDate.caption, 6) & Right(cldToDate.caption, 6)
			requestData()
		end if 
	elseif sKeyName == "SELLBUY_SET" then '매매유형 for CFD
		if sRet <> "" and sRet <> null then
			Combo3.cbkeydata = sRet
			Label3.caption = Combo3.caption
			requestData()
		end if 
'	elseif sKeyName == "nrsbtrc21002_p6" then '국내/해외 종목선택창 구분	
'		if sRet <> "" and sRet <> null then
'			g_szGubun = sRet
'			if g_szGubun == "0" then '국내
'				Form.OpenCommonDialog("SEARCH", "22:23:24:25", "")
'			elseif g_szGubun == "1" then '해외
'				Form.OpenCommonDialog("SEARCH", "26", "")
'			end if 
'		end if 
	end if	
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	'if sCellID == "Label15" or sCellID == "Image3" then
		szData = ""		
		for i = 0 to grd0.colcount -1
			if i == 0 then
				szData = grd0.GetCellData("bd_cell" & CStr(i), nIndex)
			else
				szData = szData & "★" &  grd0.GetCellData("bd_cell" & CStr(i), nIndex)
			end if 
		Next
'msgbox nIndex & " :: " & szData
		'if InStr(grd0.GetCellData("bd_cell24", nIndex), "국내") > 0 then
		if Trim(grd0.GetCellData("bd_cell32", nIndex)) ==  "1" then '국내
			Form.OpenPopupAnimation("nrsbtrc21002_p3", szData,"", "2") '국내
		else
			Form.OpenPopupAnimation("nrsbtrc21002_p4", szData,"", "2") '해외
		end if 

	'end if	
End Sub
