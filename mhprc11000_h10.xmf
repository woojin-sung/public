'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemCode = "005930"
	g_szItemMarket = "J"
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&ITEM_STOCK" then
		g_szItemCode = sValue
		DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
	end	if	
End Sub

'============================================================================
Sub Form_OnFormInit()
	grd1.top = 101
	grd1.visible = false

	DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID = "ohhts_1146_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_1146_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
