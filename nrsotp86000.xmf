'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p5" then
		if sRet ~= "cancel" then
			Call SetOTP(g_nClickIndex)		'OTP 등록/해지 처리
		end if
	elseif sKeyName == "mhetc90060_p8" then  'OTP교체, 사용불가, 
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
		end if
'	elseif sKeyName == "mbonl86000_p2" then 'v0001
'		if sRet == "ok" then
'			Form.triggerEvent( "#" , "TabChg", szParam)
'		end if

	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")			
			if UBOUND(tData) > 0 then
				g_szPassWord = tData(0)
				if grd0.GetCellData( "bd_cell9" , g_nClickIndex) == "OTP등록" then
					'SetOTP(g_nClickIndex)					'Test용
					Form.OpenFramePopup( "mhetc90060_p5" , "" , "")
				elseif grd0.GetCellData( "bd_cell9" , g_nClickIndex) == "OTP교체" then 'v006
					'SetOTP(g_nClickIndex)					'Test용
					'추가인증팝업 필요 -
					Form.OpenFramePopup( "mhetc90060_p8" , "otp" , "")
				else  ' "사용불가 등 
					'SetOTP(g_nClickIndex)					'Test용
					'추가인증팝업 필요 -
					Form.OpenFramePopup( "mhetc90060_p8" , "otp" , "")
				end if
		
			end if
		end if
		
    '등록/변경/해지 완료 및 실패메시지 팝업후
	elseif sKeyName = "mbbdm86203_end" then
		if sRet == "ok" then
			if Form.GetSharedData("Common_OTP_PopupCloseYn" , true ) == "Y" then  '다른 업무중간이면 처리완료시 화면닫기 
'Form.ShowAlert("Close_ok")	'for TEST		
				Form.CloseForm()
			end if 		
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sRet == "ok" then	
		'교체/변경하기 
		if sKeyName == "CHANGE_OTP" then 
			if Len( g_szPassWord ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == ""then
				'Form.ShowAlert("알림", "비밀번호를 확인하여 주십시오.")
				Form.openPopupAnimation("pwdcheckpopup", acnt0.total & acnt0.sequence & "☆0" ,"","2")
			else
				'SetOTP(g_nClickIndex)					'Test용
				'추가인증팝업 필요 -
				Form.OpenFramePopup( "mhetc90060_p8" , "otp" , sPosInfo) '인증서_추가인증
			end if
		'해지하기
		elseif sKeyName == "CANCEL_OTP" then 
			if Len( g_szPassWord ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == ""then
				'Form.ShowAlert("알림", "비밀번호를 확인하여 주십시오.")
				Form.openPopupAnimation("pwdcheckpopup", acnt0.total & acnt0.sequence & "☆0" ,"","2")
			else
				'SetOTP(g_nClickIndex)					'Test용
				'추가인증팝업 >> 간편비밀번호 >> SetOTP(해지하기)
				Form.OpenFramePopup( "mhetc90060_p8" , "otp" , sPosInfo) '인증서_추가인증
			end if		
		end if
	end if
End Sub


'============================================================================
'OTP등록/해지시 전문수신조회중 오류 개선(타이머 추가) v0003
Sub Form_OnTimerEvent(sTimerID) 'v0001
	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent(0, 0, 1)
		DATAMANAGER.RequestTranData("obcsb_oimf_140c_1")
	elseif sTimerID == 1 or sTimerID == "1" then	
		Form.SetTimerEvent(1, 0, 1)
		DATAMANAGER.RequestTranData("obcsb_oimf_141a_1")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_oimf_140c" then						'OTP 등록
		'DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell0", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))	
	elseif szTranID == "obcsb_oimf_141a" then					'OTP 해지
		'DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell0", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))
	elseif szTranID == "obcsb_oimf_141a_1" then					'OTP 해지
		'DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell0", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))	
	elseif szTranID == "obcsb_oimf_140c_1" then					'OTP 등록
		'DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell0", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))
		if grd0.GetCellData( "bd_cell9" , g_nClickIndex) == "OTP교체" then
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "REG_CLCD", 0 , "5")
		else
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "REG_CLCD", 0 , "1")
		End If
	elseif szTranID == "obcsb_oimf_160r" then			'재조회시
		'g_nNextCount = 0
		g_nIndex = 0
	end if
		
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim StateCode, StateCodeName, ResponeCode, ResponeMs, UtlzRegYn
	'Dim sIsncIstuName, sCardSrNo, sSuplCoName, sIsncDate, sGurnStaDate, sGurnNtrtDate
	Dim temp
	Dim szSendData
	
	if szTranID == "obacp_opop_064r" then
		
		edtJumin.caption = DATAMANAGER.GetDataValue( 0 , "obacp_opop_064r", "OutBlock1", "RCNO_PIP" , 0)  'v0005 RCNO->RCNO_PIP
		'v0005 edtJumin.caption 전송데이터 In.RCNO->In.RCNO_PIP 모두변경
	
		Call SetFirst()
		
	elseif szTranID == "obcsb_oimf_160r" then
	
		'전문일련번호
		g_szSRNO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock2", "OTP_TLMS_SRNO" , 0)			
		if Len(trim(g_szSRNO)) > 7 then		
			edtotp.caption = g_szSRNO
		end if		
		'요청시작위치번호
		g_szSTTN_NO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock2", "RQST_STA_STTN_NO" , 0)		
		if Len(trim(g_szSTTN_NO)) == 3 then		
			edtSTTNNO.caption = g_szSTTN_NO
		end if		
		'전문처리일자(기준일자)
		g_szSTND_DATE = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock2", "TLMS_PROS_DATE" , 0)		
		if Len(trim(g_szSTND_DATE)) == 8 then	
			edtSTNDDATE.caption = g_szSTND_DATE
		end if
			
		Call Query()
	
	'OTP 목록 구성
	elseif szTranID == "obcsb_oimf_160r_1" then
		
		Dim sFgColor, iSetHeight	
		sFgColor =  "4:000000000"
		iSetHeight = 122		
		
		g_nGrdCount = DATAMANAGER.GetDataCount( 0 , "obcsb_oimf_160r_1", "OutBlock1")		
		'for i = 0 to g_nGrdCount - 1
		Pannel0.rowcount = g_nIndex + g_nGrdCount
		for i = 0 to g_nGrdCount -1	
		
			j = i + g_nIndex
			
			'보이지 않기 
			Pannel0.SetCellVisible( "imgState", j, 0 )
			Pannel0.SetCellVisible( "lbState", j, 0 )
			Pannel0.SetCellVisible( "chkSelect", j, 0 )
			Pannel0.SetCellVisible( "btnCancel", j, 0 ) '해지하기 버튼보이지 않기
			
			'이용등록여부			
			UtlzRegYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "UTLZ_REG_YN" , i)	
'if j == 1 then
'	UtlzRegYn = "Y" 'for TEST
'end if 
			if  UtlzRegYn == "Y" then	
				grd0.SetCellData("bd_cell9", j, "OTP해지")
				Pannel0.SetPropCardCell( "chkcaption", "chkSelect", j, "OTP해지" )
				Pannel0.SetCellVisible( "lbState", j, 1 ) 
				Pannel0.SetCellVisible( "imgState", j, 1 ) 
				Pannel0.SetCellValue("lbState", j, "이용 중")
				Pannel0.SetCellVisible( "btnCancel", j, 1 ) '해지하기 버튼보이기
				iSetHeight = 165
				g_bRegYn = true
				
			elseif UtlzRegYn == "C" then 'v006
				grd0.SetCellData("bd_cell9", j, "OTP교체")
				Pannel0.SetPropCardCell( "chkcaption", "chkSelect", j, "OTP교체" )
				Pannel0.SetcellVisible( "chkSelect", j, 1 ) '체크버튼 보이기 
				iSetHeight = 122
				
			elseif UtlzRegYn == "N" then '등록여부
				grd0.SetCellData("bd_cell9", j, "OTP등록")
				Pannel0.SetPropCardCell( "chkcaption", "chkSelect", j, "OTP등록")
				Pannel0.SetcellVisible( "chkSelect", j, 1 ) '체크버튼 보이기 
				iSetHeight = 122
				
			else
				grd0.SetCellData("bd_cell9", j, "사용불가") 'v006
				Pannel0.SetPropCardCell( "chkcaption", "chkSelect", j, "사용불가" )
				Pannel0.SetCellVisible( "lbState", j, 1 ) 
				Pannel0.SetCellVisible( "imgState", j, 1 ) 
				Pannel0.SetCellValue("lbState", j, "사용불가")				
				sFgColor =  "100:102102102"
				iSetHeight = 122
				
			end if			

			'OTP상태코드/상태명
			StateCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_STAT_CLS_CODE" , i)
			'StateCodeName = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_STAT_NAME" , i)
			StateCodeName = Form.GetMetaData("인증센터OTP상태코드", StateCode) 
			grd0.SetCellData("bd_cell12",j, StateCodeName)			
			Pannel0.SetCellValue("lbSubState", j, grd0.GetCellData("bd_cell12", j))
			'Pannel0.SetPropCardCell( "fgcolor", "lbSubState", j, sFgColor )
			
			'OTP발급기관
			temp = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_ISNC_ISTU_NAME" , i)
			Pannel0.SetCellValue("lbTitle", j, temp)
			
			'OTP번호 | OTP공급회사명(벤더)
			temp = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_CARD_SRNO" , i) & " | " & DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_SUPL_CO_NAME" , i)
			Pannel0.SetCellValue("lbSubTitle", j, temp)

			'OTP발급일자
			temp = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_ISNC_DATE" , i)
			Pannel0.SetCellValue("lbSubDate1", j, temp)
			
			'OTP보증시작일자 ~ OTP보증만기일자
			temp = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_GURN_STA_DATE" , i) & DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_GURN_MTRT_DATE" , i)
			Pannel0.SetCellValue("lbSubDate2", j, temp)
			
			'g_nNextCount = g_nNextCount + 1
			
			'Pannel0.SetPropCardCell( "height", "imgBG", j, iSetHeight+9&"" )
			Pannel0.SetPropCardCell( "height", "imgBG", j, iSetHeight+4 )
			Pannel0.SetCardWHAt( j, iSetHeight)				
		next
		
'g_bRegYn = true 'for TEST		
		'v0001
		if g_nGrdCount > 0 then
			g_Flag = 0
		end if
	
		if g_bRegYn == true then
			BtnReg.enable = false
			BtnReg.left = 500
			Pannel0.height = 650
		else 
			BtnReg.enable = true
			BtnReg.left = -1
			Pannel0.height = 590
		end if 
		
		ResponeCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock2", "OTP_RSPN_CODE" , 0)
		ResponeMs = Form.GetMetaData("OTP응답코드", ResponeCode)			
		edt1.caption = ResponeMs
		
	elseif szTranID == "obcsb_oimf_140c" then 
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_140c", "OutBlock1", "OTP_RSPN_CODE" , 0) <> ""then
			edt0.caption = ""
			Form.SetTimerEvent(0, 0, 1)
			DATAMANAGER.RequestTranData("obacp_opop_064r")
		else
              Form.SetTimerEvent(0, 1, 1) 'v0001
			'DATAMANAGER.RequestTranData("obcsb_oimf_140c_1")		
		end if
		
	elseif szTranID == "obcsb_oimf_141a" then 
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a", "OutBlock1", "OTP_RSPN_CODE" , 0) <> ""then
			edt0.caption = ""
			Form.SetTimerEvent(1, 0, 1)
			DATAMANAGER.RequestTranData("obacp_opop_064r")
		else
              Form.SetTimerEvent(1, 1, 1) 'v0001		
			'v0004 Timer Event로 처리하므로 TR호출불필요
			'DATAMANAGER.RequestTranData("obcsb_oimf_141a_1")
		end if
		
	elseif szTranID == "obcsb_oimf_141a_1" then 'OTP해지
		temp = Form.GetMetaData( "OTP응답코드" , DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a_1", "OutBlock1", "OTP_RSPN_CODE" , 0))
		edt1.caption = temp
		Form.triggerEvent( "#" , "Reset", szParam)			'비밀번호 초기화 요청
		'g_szPassWord = ""			'비밀번호 초기화
		Form.SetTimerEvent(1, 0, 1)
		'v0004 정상처리된 경우에만 해지완료표시 및 재조회/정상처리 아닌경우 처리불가 팝업메시지
		rspnCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		if rspnCode == "0000" or rspnCode == "3999" then
			'Form.MsgBox( "알림", "OTP해지가 완료되었습니다.", 0, 6)
			szSendData = "타기관 OTP 이용 등록이\n해지되었습니다."  & "★" & g_szSendData
			Form.OpenPopup("mbbdm86203", szSendData , "" ) '업무 완료 화면			
			g_bRegYn = false			
			DATAMANAGER.RequestTranData("obacp_opop_064r")			'재조회
		else
			if rspnCode <> "3021" then  '3021.수신전문 조회 중 입니다.
				'Form.ShowAlert( "알림" , "처리에 실패하였습니다.("..temp..")")
				szSendData = "처리에 실패하였습니다.("..temp..")"  & "★" & g_szSendData
				Form.OpenPopup("mbbdm86203", szSendData , "" ) '업무 완료 화면
			end if
		end if
		
	elseif szTranID == "obcsb_oimf_140c_1" then 'OTP등록
		temp = Form.GetMetaData( "OTP응답코드" , DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_140c_1", "OutBlock1", "OTP_RSPN_CODE" , 0))
		edt1.caption = temp
		Form.triggerEvent( "#" , "Reset1", szParam)			'비밀번호 초기화 요청
		'g_szPassWord = ""			'비밀번호 초기화
		Form.SetTimerEvent(0, 0, 1)
		'v0004 정상처리된 경우에만 등록완료표시 및 재조회/정상처리 아닌경우 처리불가 팝업메시지
		rspnCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_140c_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		if rspnCode == "0000" or rspnCode == "3999" then
			if g_bRegYn == true then
				'Form.MsgBox( "알림", "OTP변경이 완료되었습니다.", 0, 6)
				szSendData = "타기관 OTP 이용 등록이\n변경되었습니다."  & "★" & g_szSendData
				Form.OpenPopup("mbbdm86203", szSendData , "" ) '업무 완료 화면
		    else
				'Form.MsgBox( "알림", "OTP등록이 완료되었습니다.", 0, 6)
				szSendData = "타기관 OTP 이용 등록이\n완료되었습니다." & "★" & g_szSendData
				Form.OpenPopup("mbbdm86203", szSendData , "" ) '업무 완료 화면
				g_bRegYn = true
			end if 
			'Form.OpenPopup( "mbonl86000_p2" , "일회용PIN이동" , sPosInfo)
			DATAMANAGER.RequestTranData("obacp_opop_064r")			'재조회
		else
			if temp <> "3021" then	  '3021.수신전문 조회 중 입니다.			
				'Form.ShowAlert( "알림" , "처리에 실패하였습니다.("..temp..")")	
				szSendData = "처리에 실패하였습니다.("..temp..")" & "★" & g_szSendData
				Form.OpenPopup("mbbdm86203", szSendData, "" ) '업무 완료 화면
			end if
		end if		
	end if	
'	if Len(trim(g_szSRNO)) > 7 then		'전문일련번호
'		edtotp.caption = g_szSRNO
'	end if
'	if Len(trim(g_szSTTN_NO)) == 3 then		'시작요청위치
'		edtSTTNNO.caption = g_szSTTN_NO
'	end if
'	if Len(trim(g_szSTND_DATE)) == 8 then	'기준일자
'		edtSTNDDATE.caption = g_szSTND_DATE
'	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
'msgbox "error " & szTranID 'for TEST
	if szTranID == "obcsb_oimf_141a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_141a_1" )
		if szErrCode <> "3021" then
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")		
		end if
	elseif szTranID == "obcsb_oimf_140c_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_140c_1" )
		if szErrCode <> "3021" then		
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		end if
	elseif szTranID == "obcsb_oimf_141a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_141a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")		
	elseif szTranID == "obcsb_oimf_140c" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_140c" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_160r_1" then 'v0001
		if szErrCode == "3021" then
			if g_Flag == 0 then  '그리드건수가 0보다 크면 --> 조회가 된 경우
				g_Flag = 1
				Query()
			else  
				szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r_1" )
			'	Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
			end if
		else	
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r_1" )
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		end if
	end if
End Sub
