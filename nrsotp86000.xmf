Sub Form_OnFormInitBefore()
	'아이콘 이미지 
	ImgBackPress.setMaintainingRatio("1")	
	imgInfo.setMaintainingRatio("1")
	Pannel0.imgState.setMaintainingRatio("1")	
	Pannel0.imgBG.setMaintainingRatio("1")		
	
	Pannel0.bgcolor = "246247248"
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	funcBtnSet(False)
	
	'v0004 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	if edtPW.caption <> "" then
		'v0004
		if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		    'g_szPassWord = g_szList(1)
		    g_szPassWord = edtPW.caption
		else  'MTS메모리평문 미적용상태일때-부모(mbonl86000)에서 미암호화된정보로 넘어오므로 암호화 필요
			'g_szPassWord = Form.GetEncData(g_szList(1))
			g_szPassWord = Form.GetEncData(edtPW.caption)
		end if		
	else
		g_szPassWord = ""
	end if
	
	btn0_OnClick() '조회하기	
	
End Sub

'============================================================================
' Pannel0_OnClick(nIndex, sCellID)
'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	Dim i	
	
	edtSTNDDATE.caption = ""
	edtotp.caption = ""
	edt0.caption = ""
	edt1.caption = ""
	
	g_nClickIndex = nIndex
	'BtnReg.caption = Pannel0.GetPropCardCell( "chkcaption", "chkSelect", nIndex)
	g_szSendData = Replace(Pannel0.GetCellValue("lbSubTitle", nIndex), "|", "★")
	if sCellID == "btnCancel" then  '해지하기 
		if g_bRegYn == true then
			if Pannel0.GetPropCardCell( "chkcaption", "chkSelect", nIndex) == "OTP해지" then
				Form.MsgBox("안내", "등록된 OTP를\n해지 하시겠습니까?", "CANCEL_OTP", 7, "해지하기", "아니오")
			end if 			
		end if			
	else'if sCellID == "chkSelect" then '등록,교체,사용불가 

		for i = 0 to Pannel0.rowcount - 1
			if i <> nIndex then
				'Pannel0.SetCellValue( "chkSelect", i, "0" )
				Pannel0.SetPropCardCell( "checkstate", "chkSelect", i, "0" )
				Pannel0.SetPropCardCell( "imgpath", "imgBG", i, "bg_infobox_n.9") 
			end if 
		next
		
		if sCellID <> "chkSelect" then
			if Pannel0.GetPropCardCell( "checkstate", "chkSelect", nIndex) == "1" then
				Pannel0.SetPropCardCell( "checkstate", "chkSelect", nIndex, "0" )
			else
				Pannel0.SetPropCardCell( "checkstate", "chkSelect", nIndex, "1" )
			end if 
		end if 
		
'g_bRegYn = true	 'for TEST	
		if Pannel0.GetPropCardCell( "checkstate", "chkSelect", nIndex) == "1" then 
			Pannel0.SetPropCardCell( "imgpath", "imgBG", nIndex, "bg_infobox_o.9") '이미지필요
'			g_szSendData = Replace(Pannel0.GetCellValue("lbSubTitle", nIndex), "|", "★")
			BtnReg.enable = true
			'BtnReg.visible = true
			'Pannel0.height = 590		
				
'BtnReg.caption = "선택한 OTP 교체" 'for TEST			
			'OTP변경
			if g_bRegYn == true then
				if Pannel0.GetPropCardCell( "chkcaption", "chkSelect", nIndex) == "OTP교체" then
					Form.MsgBox("안내", "선택한 OTP로\n변경하시겠습니까?", "CHANGE_OTP", 7, "변경하기", "아니오")
				end if 			
			end if			
		else
			Pannel0.SetPropCardCell( "imgpath", "imgBG", nIndex, "bg_infobox_n.9") '이미지필요
'			g_szSendData = ""
			BtnReg.enable = false
			'BtnReg.visible = false
			'Pannel0.height = 650		
		end if
'Form.ShowAlert(g_szSendData)				
		
		'g_nClickIndex = nIndex 
	end if	
End Sub

'only OTP등록
'============================================================================
Sub BtnReg_OnClick()
	
	if Pannel0.GetPropCardCell( "chkcaption", "chkSelect", g_nClickIndex) == "OTP등록" then
		if Len( g_szPassWord ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == "" then
			'Form.ShowAlert("알림", "비밀번호를 확인하여 주십시오.")
			Form.openPopupAnimation("pwdcheckpopup", acnt0.total & acnt0.sequence & "☆0" ,"","2")
		else
'				SetOTP(g_nClickIndex)					'Test용
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo) '간편비밀번호입력
		end if	
	end if
	
End Sub


