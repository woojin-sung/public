'============================================================================

Dim g_UserID,g_OStype,g_UserClcd,g_rowIdx
Dim g_prosClcd

'실시간 메세지 수신시 사용하는 변수
Dim g_PopupGb, g_Msg , g_mClcd, g_msgSrno

Dim g_Data



'============================================================================
Sub imgClose_OnClick()

	if g_prosClcd = 2 or g_prosClcd = "2" then
		ButtonOK_OnClick()
		
	else
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()


	if g_PopupGb = "01" then	'실시간 메시지 수신시
	

		setRealMsg()

	else
		'재실행 구분코드 (0 : 재실행 필요x  1: 선택종료 2: 필수종료 //3:업데아트)
		g_prosClcd = "0"
	
		'사용자 아이디 획득
		g_UserID = Form.GetSharedData("&USER_ID" , false)
		g_OStype = Form.GetSharedData("&OS_TYPE", false)   '(1: Android 2:IOS)
	
		if g_OStype = "1" then
			g_UserClcd = "30"
		else
			g_UserClcd = "31"
		end if
		
			
		DATAMANAGER.SetDataValue(0, "obcpp_msga_102r", "InBlock1", "USER_ID" , 0 , g_UserID)
		DATAMANAGER.RequestTranData("obcpp_msga_102r")
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)


	if szTranID = "obcpp_msga_102r" then

		cnt = DATAMANAGER.GetDataCount(0, "obcpp_msga_102r" ,"OutBlock1")
	
		g_rowIdx = 0
	
	
		for i = 0 to cnt -1 
	
			mClcd = DATAMANAGER.GetDataValue(0, "obcpp_msga_102r", "OutBlock1", "MSG_TRNM_MDIA_CLCD" , i)
		
			'MTS를 포함하는 매체구분 코드 값을 가지는 메세지만 보여준다.
			'g_UserClcd => OS 타입에 따른 매체구분 코드 값 ( Android = 30 / IOS = 31)
			if mClcd ="10" or mClcd = "11" or mClcd = "21" or mClcd = g_UserClcd then
			
				Grid0.AddRow()
	
				msg = DATAMANAGER.GetDataValue(0,"obcpp_msga_102r", "OutBlock1", "MSG_CNTT", i)
				srno = DATAMANAGER.GetDataValue(0, "obcpp_msga_102r", "OutBlock1", "MSG_SRNO" , i)
				proc_clcd = DATAMANAGER.GetDataValue(0,"obcpp_msga_102r", "OutBlock1", "MSG_PROS_CLCD", i)	
				
				Grid0.SetCellData("bd_arrow", g_rowIdx, ">")
				Grid0.SetCellData("bd_msg", g_rowIdx, msg)
				Grid0.SetCellData("bd_srno", g_rowIdx, srno)
				
				'메세지
				if proc_clcd = "0" then
				'단순히 메세지만 보여줌
				
				'메세지+선택종료
				elseif proc_clcd = "1" then
					Grid0.SetCellData("bd_addmsg", g_rowIdx, "※ 앱 재실행이 필요합니다. (선택)")
					
					if Cint(g_prosClcd) < 1 then
						g_prosClcd = "1"
					end if
					
				'메세지+필수종료
				elseif proc_clcd = "2" then
					Grid0.SetCellData("bd_addmsg", g_rowIdx, "※ 앱 재실행이 필요합니다. (필수)")
					
					if Cint(g_prosClcd) < 2 then
						g_prosClcd = "2"
					end if
				
				
				
				end if
				
				g_rowIdx = g_rowIdx + 1 
				
			end if
		
		next
	
	elseif szTranID = "obcpp_msga_102a" then

		Form.CloseForm()
	
	end if


	
End Sub

'============================================================================
' 재실행 여부 팝업 호출
'============================================================================
Sub ButtonOK_OnClick()
	
	if g_prosClcd = 0 or g_prosClcd ="0" then
		setRead()
		Form.CloseForm()
	
	elseif g_prosClcd = 1 or g_prosClcd = "1" then
		Form.MsgBox("알림", "앱 종료후 재실행이 필요합니다. 지금 재실행 하시겠습니까?", "CLCD1", 2)
		
	elseif g_prosClcd = 2 or g_prosClcd = "2" then
		Form.MsgBox("알림", "앱 종료후 재실행이 필요합니다. (필수)", "CLCD2", 6)
	end if
	
	
End Sub



'=============================================================================
' 호출팝업 close 이벤트
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	if sKeyName = "CLCD1" then'선택종료일떄
	
		if sRet = "ok" then ' 예 선택시 재실행
			setRead()
			Form.restartApp()
			
		
		else				  ' 아니오 선택시 그냥 종료
			setRead()
			Form.CloseForm()
		
		end if
	
	
	elseif sKeyName = "CLCD2" then'필수종료
		
		if sRet = "close" then
			setRead()
			Form.restartApp()
		end if
	
	
	end if

	
End Sub


'========================================================================================
'긴급메세지 읽음 처리
'========================================================================================
Sub setRead()
	'Form.ShowAlert(g_UserID, g_rowIdx)
	
	'20201211 SWJ START : 사용자 ID 서비스에 태우기 (읽음 확인 필요) 
	g_UserID = Form.GetSharedData("&USER_ID", false )
	'20201211 SWJ END
	
	for i = 0 to g_rowIdx -1
	
		srno = Grid0.GetCellData("bd_srno", i )
	
		DATAMANAGER.SetDataValue(0, "obcpp_msga_102a", "InBlock1", "USER_ID" , i , g_UserID)
		DATAMANAGER.SetDataValue(0, "obcpp_msga_102a", "InBlock1", "MSG_SRNO" , i , srno)
	
	next
	
	DATAMANAGER.SetDataValue(0, "obcpp_msga_102a", "InBlock2", "PROS_CLS_CODE" , 0 , "I")
	DATAMANAGER.SetEventFlag("obcpp_msga_102a", "A")
	DATAMANAGER.RequestTranData("obcpp_msga_102a")


End Sub

