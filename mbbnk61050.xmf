		Form.ShowAlert("알림", "전일가능수표금액이 전일대체수표금액보다 큽니다")
		cont01.contNoMoney.edtNoMoney3.caption =  cont01.contNoMoney.edtNoMoney1.caption
		exit sub		
	else		
		cont01.edtAllMoney.caption = cont01.contMoney.edtMoney2.caption + cont01.contNoMoney.edtNoMoney3.caption + cont01.contNoMoney.edtNoMoney4.caption

	end if

	if szTempMoney2 == "" or szTempMoney2 == null then
		cont01.contNoMoney.edtNoMoney3.caption = "0"
	end if	
	
End Sub
'============================================================================
' cont01_contNoMoney_edtNoMoney4_OnEditComplete - 당일대체수표금액 입력완료
