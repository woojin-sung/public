'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim AccidentList		'출금고 사고 여부 판단 0:Y,N 값 , 1 : 출금고상태 명

	if sEventName == "ACCIDENT" then
		AccidentList = Split(sParam, "★")
		
		if UBOUND(AccidentList) < 1 then
			Exit Sub
		end if

		if AccidentList(0) == "Y" then
			Form.ShowAlert( "알림", "출금고 정지계좌입니다. ("..AccidentList(1)..")" )
			edtPassword.caption = ""
			g_szAccountPassword = ""
			Exit Sub
		end if
	end if
	
End Sub

'============================================================================
' cont01_edtMy_OnClick : v004 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경
'============================================================================
Sub cont01_edtMy_OnClick()
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" then
		g_nClickCnt = g_nClickCnt + 1
		cont01.lblScrollPos.top = 600
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 100
	end if	
End Sub
'============================================================================
Sub cont01_edtMy_OnEditComplete()

	'v004 2022.01.07 KSJ
	' 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경했던것 제자리로
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" and g_nClickCnt < 2 then
		cont01.lblScrollPos.top = 0
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 0
		g_nClickCnt = 0
	else
		g_nClickCnt = 1
	end if
	
	szLen = Form.GetByteLength(cont01.edtMy.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		cont01.edtMy.caption = ""
	end if
End Sub


