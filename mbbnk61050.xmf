'============================================================================
' btnWithDraw_OnClick - 출금버튼
'============================================================================
Sub btnWithDraw_OnClick()
'USE_YN_CHK() '종료체크 v008
	'출금계좌, 출금일련번호, 계좌비밀번호, 출금액, 전일수표, 당일수표, 현금출금, 
	'거래설명(내통장), 상대거래설명(상대통장), 입금계좌번호, 입금계좌명, 출금계좌명
	
	if Trim(g_szAccountPassword) == "" or edtPassword.caption == "" then
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요")
		exit sub
	end if
	
	if Trim(cont01.edtAccount.caption) == "" then
		Form.ShowAlert("알림", "입금계좌를 입력해 주세요")
		exit sub
	end if	

	if cmbAccount.caption == cont01.edtAccount.caption then
		Form.ShowAlert("알림", "출금 계좌와 입금계좌가 동일합니다.")
		exit sub
	end if	
	
	if CDbl(cont01.edtAllMoney.caption) == 0 then
		Form.ShowAlert("알림", "출금 금액을 확인하세요.")
		exit sub
	end if
	
	
	if Trim(cont01.edtAllMoney.caption) == "" then
		cont01.edtAllMoney.caption = "0"
	end if
	
	if Trim(cont01.contNoMoney.edtNoMoney3.caption) == "" then
		cont01.contNoMoney.edtNoMoney3.caption = "0"
	end if
	
	if Trim(cont01.contNoMoney.edtNoMoney4.caption) == "" then
		cont01.contNoMoney.edtNoMoney4.caption = "0"
	end if
	
	if Trim(cont01.contMoney.edtMoney2.caption) ==  "" then
		cont01.contMoney.edtMoney2.caption = "0"
	end if
	
	
	'v008
	FrdSspc_Chk()
	
	'v003 sta : 입금계좌가 당사 동일명의 계좌인지 확인 
	'DATAMANAGER.RequestTranData("obrtp_comn_019r") 'v008 FrdSspc_Chk 완료후 호출로 변경
End Sub
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbbnk61050_p1" then	'지정이체계좌조회에서 넘어온 데이터
	
		if sRet == "cancel" then	'지정취소버튼
			cont01.rdoAccount.currentindex = 1
			btnWithDraw.enable = false
		else 
			cont01.btnChange.enable = true
			Dim szReturnDataList
			szReturnDataList = Split(sRet, "★")
			
			if UBOUND(szReturnDataList) < 1 then
				exit sub
			end if
			
			'계좌번호, 계좌명, 상품명, 계좌설명, 은행코드, 상품코드		
			g_szAccountFlg = "1"
			cont01.edtAccount.caption = Mid(szReturnDataList(0), 1, 4) & Mid(szReturnDataList(0), 6, 4) & Mid(szReturnDataList(0), 11, 2)
			cont01.edtAccountName.caption = szReturnDataList(1)
			lblBankCode.caption = szReturnDataList(4)
			lblItemCode.caption = szReturnDataList(5)
			btnWithDraw.enable = true
			
			cont01_edtAccount_OnEditComplete()
		end if
	elseif sKeyName == "Clear" then		'공인인증서 확인버튼 눌렀을때 데이터 클리어하기 위해 받음
		edtPassword.caption = ""
		cont01.contMoney.edtMoney2.caption = ""
		cont01.edtAccount.caption = ""
		cont01.edtAccountName.caption = ""
		cont01.edtAllMoney.caption = ""
		cont01.edtMy.caption = ""
		cont01.edtYou.caption = ""
		g_szAccountPassword = ""
		
		btnSearch_OnClick()
		
'	elseif sKeyName == "Close" then		'화면 이동이 필요할때 부분
'		if sRet == "61060" then	'입출력내역 이동
'			Form.OpenScreen("61060", "")
'		elseif sRet == "61010" then	'지연이체접수내역 이동
'			Form.OpenScreen("61010", "1")
'		end if
		
	elseif sKeyName == "mbbnk61010_p9" then	'지정단말 등록시
		if sRet == "Yes" then
		    If g_SapeYN == "Y" Then
		        TR_Inquiry("obcsb_oimf_638r_1")	'지정단말 등록시 재조회 
		    Else
		        TR_Inquiry("obcsb_oimf_638r")	'지정단말 등록시 재조회
		    End If
		end if	
		
	end if
	
	if sKeyName == "mhetc90060_p8" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			TR_Inquiry("obcsb_oimf_625r")	'보안매체인증하기
		else 					'실패
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)

		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)
				'Call TR_Inquiry("obcsb_oimf_636a")
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
				Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)

		else						'실패		
			exit sub
		end if	
	end if	
	
		'jhi T1811160033
     If sKeyName == "mbbnk61010_pe" then
        If sRet == "Y" then
           ' 단건처리일경우
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "DRNG_ACNO"     , 0, g_szAccountNumber           ) 
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "DRNG_ASNO"     , 0, g_szAccountSerialNumber     )
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CNFT_BANK_CODE", 0, "287"                       )

           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ACNO"     , 0, Left (cont01.edtAccount.caption, 8))
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ASNO"     , 0, Right(cont01.edtAccount.caption, 2))

           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "RMT_NAME"      , 0, cont01.edtAccountName.caption      )
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CRCD"          , 0, "KRW"                       )
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CHECK_AMT"     , 0, CDbl(cont01.contNoMoney.edtNoMoney3.caption) + CDbl(cont01.contNoMoney.edtNoMoney4.caption))
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "FRCR_TR_AMT"   , 0, cont01.edtAllMoney.caption         )
           DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "PRTR_DTL_CNTT" , 0, "MTS당사대체"               )
           DATAMANAGER.RequestTranData("obtss_comm_502a")
     
           '데이터클리어
           cmbAccount_ChangeAccount() 		
	   
           Form.OpenPopup("mbbnk61010_pd" , ""  , "")
        Else
           szWithDrawData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & 
           cont01.edtAllMoney.caption & "★" & cont01.contNoMoney.edtNoMoney3.caption & "★" & cont01.contNoMoney.edtNoMoney4.caption & "★" 
           & cont01.contMoney.edtMoney2.caption & "★" & cont01.edtMy.caption & "★" & cont01.edtYou.caption & "★" 
           & cont01.edtAccount.caption & "★" & cont01.edtAccountName.caption & "★" & lblAccountName.caption	
	
           if g_szAccountFlg == "1" then	'등록계좌인 상태에서 출금 누르면 바로 공인인증
              sMdiaSkipYn = "N"
              Form.SetSharedData("61050_SMDIA_SKIP", sMdiaSkipYn )	'간편송금한도 미포함
              Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)
           elseif g_szCertUserType == "1" then ' 간편인증 로그인인 경우	2017.04.24 박영택 간편도 보안매체제거를 위해 638r 호출
              'Form.OpenFramePopup("mbbnk61050_p4" , szWithDrawData , sPosInfo)
              TR_Inquiry("obcsb_oimf_638r")	'추가인증여부 판단
           elseif g_szAccountFlg == "2" then	'미등록 계좌 상태에서 출금 누르면 보안매체로
              TR_Inquiry("obcsb_oimf_638r")	'추가인증여부 판단
           else
              Form.ShowAlert("알림", "등록/미등록계좌를 선택하세요")
              exit sub
           end if
        End If
     End If	
     
     '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		if sRet == "ok" then									
'		end if
'	end if 
End Sub

'============================================================================
' edtPassword_OnEditComplete
'============================================================================
Sub edtPassword_OnEditComplete()
	Dim szData
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption) v001 주석처리
	'v001 sta ****************
	plain_rm = Form.GetSharedData("&PLAIN_RM" , false)	
	If plain_rm == "1" Then
	    g_szAccountPassword = edtPassword.caption
	Else
	    g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	'v001 fin ****************
	
	'출금고 사고여부 판단
	szData = cmbAccount.total & "★" & g_szAccountPassword
	linkfm0.linkfile = "accidentchk"
	Form.triggerEvent( "linkfm0", "Chk", szData)
End Sub


'============================================================================'
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obrtd_drng_025r" then	'입금계좌조회 오류
		cont01.edtAccount.caption = ""
		cont01.edtAccountName.caption = ""
		cont01.contMoney.edtMoney2.caption = ""
		cont01.edtAllMoney.caption = ""
		cont01.edtMy.caption = ""
		cont01.edtYou.caption = ""
		edtPassword.caption = ""
		btnWithDraw.enable = false
		
		Form.ShowAlert("알림", szErrMsg)
		btnSearch_OnClick()
		
	elseif szTranID = "obrtp_comn_025r" then
	
		if szErrCode == "5841" then 'v008
		
		    osType = Form.GetSharedData("&OS_TYPE", false)
             appVer = Form.GetSharedData("&APP_VERSION", false )
             appVer = replace(appVer,".","")
		
		    if osType == "1" then
		        if Cint(appVer) < 226 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
                 ElseIf Cint(appVer) == 226 then
                     Form.ShowAlert( "알림", "이체 업무가 새롭게 변경되었습니다.".."\n\n".."고객님의 안전한 서비스를 위해 앱을 재실행해주세요." )
                     return
		        end if
			    
		    elseif osType == "2" then
		        if Cint(appVer) < 2521 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
                 ElseIf Cint(appVer) == 2521 then
                     Form.ShowAlert( "알림", "이체 업무가 새롭게 변경되었습니다.".."\n\n".."고객님의 안전한 서비스를 위해 앱을 재실행해주세요." )
                     return
		        end if
		    end if
		    
		else
			szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.ShowAlert( "알림", szErrMsg.."\n".."("..szSubErr..")" )
		end if
         
	end if
End Sub

