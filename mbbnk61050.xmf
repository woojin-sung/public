'============================================================================
' 수정 : 2020.09.21. 장원혁 v001 : 메모리 평문 제거
'        2021.02.24. 장원혁 v002 : 모바일 OTP 적용
'		2021.11.03. 김수진 v003 : 동일인 계좌간 대체출금 개선건적용
'							 : 상대 계좌 당사 동일명의 계좌일 경우 : 금융사기문진, 보안매체, 전자서명 생략 및 간편이체한도 미적용 
'							 : obrtp_comn_019r - 당사 동일명의 계좌 여부 리턴 서비스 추가
'		2022.01.07. 김수진 v004 : 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버리는 문제 > 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경
'        2022.01.20. 장원혁 v005 : 동일인 계좌간 대체출금 개선건적용 - 일부 오류 개선
'        2022.03.02. 장원혁 v006 : 휴일 조회 시 출금가능금액 표기 오류 개선
'        2022.04.28. 장원혁 v007 : 자동완성 비밀번호 clear
'        2022.06.10. 김효준 v008 : 사기의심조회 체크
'20221111    김효준 : v008 : 이체종료안내추가
'============================================================================

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szFlg	'현금(1)/수표(2) 플래그
Dim g_szAccountFlg	'등록계좌(1)/미등록계좌(2) 플래그
Dim szWithDrawData
Dim g_szAccountName
Dim g_szUserId			'사용자 ID
Dim g_szCertUserType

Dim g_szTrPass		'단말지정 여부 판단 변수
Dim g_nClickCnt		'v004 에디트 클릭 횟수 (아이폰에서 edt1 > edt2 선택시 edt1 Complete 보다 edt2 onclick 이벤트가 먼저 발생하여 해당 변수로 컨트롤)[edtAccount, edtMy, edtYou 해당]

Dim g_SapeYN 'v005 동일명의인여부

'============================================================================
' TR_Inquiry 
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_625r" then	'보안인증매체조회
		Dim sDeviceID
		
		sDeviceID = Form.GetDeviceID()
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE"    , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD"         , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO"        , 0 , g_szAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD"              , 0 , g_szAccountPassword )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE"   , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO"        , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT"         , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	elseif szTranID == "obcsb_oimf_638r" then	'추가인증여부조회
	
		g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
		
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		'DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		IF g_szCertUserType = "1" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
		ELSEIF g_szCertUserType = "3" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
		ELSE
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		END IF
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r", "InBlock2", "DRNG_ACNO" , 0, g_szAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ASNO", 0, g_szAccountSerialNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_BANK_CODE", 0 , "287")		'당사
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO", 0, Left(cont01.edtAccount.caption, 8))
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO", 0, Right(cont01.edtAccount.caption, 2))
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_AMT" , 0, cont01.edtAllMoney.caption)		'대체금액
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
		
	elseif szTranID == "obcsb_oimf_638r_1" then	'중요단말여부판단 v005
	    'v005 sta *********
		g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
		
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		'DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		IF g_szCertUserType = "1" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
		ELSEIF g_szCertUserType = "3" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
		ELSE
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		END IF
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r_1", "InBlock2", "DRNG_ACNO" , 0, g_szAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "DRNG_ASNO", 0, g_szAccountSerialNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_BANK_CODE", 0 , "287")		'당사
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", 0, Left(cont01.edtAccount.caption, 8))
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", 0, Right(cont01.edtAccount.caption, 2))
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_AMT" , 0, cont01.edtAllMoney.caption)		'대체금액
		DATAMANAGER.RequestTranData("obcsb_oimf_638r_1")
		'v005 fin *********
	end if
End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'v003 sta : 당사 동일명의 계좌 여부 리턴 서비스
	If szTranID == "obrtp_comn_019r" Then	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0, g_szAccountNumber				)		'계좌번호(From)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 		, 0, g_szAccountSerialNumber		)		'계좌일련번호(From)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ACNO" 	, 0, Left(cont01.edtAccount.caption, 8)	)		'계좌번호(To)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ASNO" 	, 0, Right(cont01.edtAccount.caption, 2)	)		'계좌일련번호(To)
	End If
	'v003 fin
End Sub


'============================================================================
' Form_OnFormInit 
'============================================================================
Sub Form_OnFormInit()
USE_YN_CHK() '종료체크 v008
	g_szCertUserType        = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	szWithDrawData          = ""
	g_szAccountNumber       = cmbAccount.total
	g_szAccountSerialNumber = cmbAccount.sequence 
	'g_szAccountPassword     = Form.GetEncData(edtPassword.caption) v001 주석처리
	'v001 sta **************
	plain_rm = Form.GetSharedData("&PLAIN_RM" , false)
	If plain_rm = "1" Then
	    g_szAccountPassword = edtPassword.caption
	Else
	    g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	'v001 fin **************
	g_szAccountName        		= cmbAccount.accountname
	g_szFlg						= "1"	
	cont01.btnChange.caption       	= "수표금액대체"
	cont01.contMoney.visible       	= true
	cont01.contNoMoney.visible     	= false
	cont01.edtAccount.enable       	= false
	cont01.edtAccountName.enable   	= false
	cont01.edtAccount.caption      	= ""
	cont01.edtAccountName.caption  	= ""
	g_szAccountFlg         		= "2"
	btnSearch_OnClick()
	btnWithDraw.enable      		= false
	cont01.rdoAccount.currentindex	= 1
	g_nClickCnt 					= 0	'v004
	
	edtPassword.caption = "" 'v007
End Sub


'============================================================================
' btnSearch_OnClick - 조회
'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.SetDataValue(0,  "obrtp_drab_001r", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
	DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber)	'계좌일련번호
	
	Dim szDate
	'szDate = Form.GetSharedData( "&BIZ_DT" , false ) 주석처리 v006
	
	'if Trim(szDate) = "" then 주석처리 v006
		'szDate = cldToday.caption 주석처리 v006
	'end if 주석처리 v006
	
	szDate = cldToday.caption 'v006
	
	DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "PROS_DATE" , 0 , szDate)		'처리일자
	DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "SMCD" , 0 , "003020")		'적요코드
	
	DATAMANAGER.RequestTranData("obrtp_drab_001r")	
	
End Sub
'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_szAccountNumber               = cmbAccount.total
	g_szAccountSerialNumber         = cmbAccount.sequence 
	g_szAccountName                 = cmbAccount.accountname
	g_szAccountPassword             = ""
	edtPassword.caption             = ""
	g_szFlg                         = "1"	
	cont01.btnChange.caption               	= "수표금액대체"
	cont01.contMoney.visible               	= true
	cont01.contNoMoney.visible             	= false
	'cont01.edtAccount.enable = false
	cont01.edtAccountName.enable           	= false
	cont01.edtAccount.caption              	= ""
	cont01.edtAccountName.caption          	= ""
	g_szAccountFlg						= "2"
	cont01.contNoMoney.edtNoMoney3.caption 	= "0"
	cont01.contNoMoney.edtNoMoney4.caption 	= "0"
	cont01.contMoney.edtMoney2.caption     	= "0"
	cont01.edtAllMoney.caption             	= "0"
	cont01.rdoAccount.currentindex         	= 1
	btnSearch_OnClick()
	btnWithDraw.enable              		= false
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtp_drab_001r" then	'출금가능금액조회
		cont01.edtAllMoney.caption = cont01.contMoney.edtMoney2.caption + cont01.contNoMoney.edtNoMoney3.caption + cont01.contNoMoney.edtNoMoney4.caption
	elseif szTranID == "obcsb_oimf_638r" then	'추가인증여부
		Form.SetSharedData( "CERT_ID" , g_szUserId)
		Form.SetSharedData( "CERT_ACNO" , g_szAccountNumber)

		sMdiaSkipYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)
		IF g_szAccountFlg = "1" THEN	'등록계좌는 무조건 보안매체skip
			sMdiaSkipYn = "N"			'한도미포함
		END IF
		Form.SetSharedData("61050_SMDIA_SKIP", sMdiaSkipYn )
		
		g_szTrPass = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0)	
		
		IF g_szCertUserType = "1" OR g_szCertUserType = "3" THEN
			TR_Inquiry("obcsb_oimf_625r")	'보안매체인증하기
			Exit Sub
		END IF 
		
		if g_szTrPass == "Y" then
			Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
			Exit Sub
		end if
		
		if DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0) == "Y" then
			Dim szSendData
			
			Form.SetSharedData("BANK_TRANSTYPE", "01" )
			
			'이체 단일건과 같은 값 전달 -> 화면명, 건수, 입금은행명, 은행코드 (당사대체라 전부 메리츠) , 입금계좌수취인명, 대체출금금액
			szSendData = "bank_61010" & "★" & "1" & "★" & "메리츠증권" & "★" & "287" & "★" & cont01.edtAccountName.caption & "★" & cont01.edtAllMoney.caption
			Form.OpenFramePopup( "mhetc90060_p8" , szSendData , sPosInfo)
		elseif DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0) == "N" then
			TR_Inquiry("obcsb_oimf_625r")	'보안매체인증하기
		end if
    ElseIf szTranID == "obcsb_oimf_638r_1" Then 'v005 추가
        'v005 sta *************
        g_szTrPass = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock1", "UI_SPLM_YN" , 0)
        if g_szTrPass == "Y" And g_szCertUserType <> "1" And g_szCertUserType <> "3" And g_szCertUserType <> "4" then  
            Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
            Exit Sub
	    Else
			szWithDrawData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & 
			cont01.edtAllMoney.caption & "★" & cont01.contNoMoney.edtNoMoney3.caption & "★" & cont01.contNoMoney.edtNoMoney4.caption & "★" 
			& cont01.contMoney.edtMoney2.caption & "★" & cont01.edtMy.caption & "★" & cont01.edtYou.caption & "★" 
			& cont01.edtAccount.caption & "★" & cont01.edtAccountName.caption & "★" & lblAccountName.caption	
			
			sMdiaSkipYn = "N"
			Form.SetSharedData("61050_SMDIA_SKIP", sMdiaSkipYn )	'간편송금한도 미포함
			Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)	    
        end if	    
        'v005 fin *************
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup("mbbnk61050_p4" , szWithDrawData , sPosInfo)	'공인인증서_보안카드화면
'				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form_OnFormInit()
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup("mbbnk61050_p4" , szWithDrawData , sPosInfo)	'공인인증서_보안카드화면
'				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
              Case "4" 'v002
	              Form.OpenFramePopup( "mbbnk61050_p4" , szWithDrawData , sPosInfo ) 'v002
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
'	elseif szTranID == "obrtd_drng_025r" then	
'			
'			sName = DATAMANAGER.GetDataValue( 0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME" , 0 )
'			if Trim(g_szAccountName) == Trim(sName) then
'				g_szAccountFlg = "1"
'			else
'				g_szAccountFlg = "2"
'			end if
	'v008 사가의심체크호출후 -> obrtp_comn_019r 호출
	elseif szTranID == "obrtp_comn_025r" then
		ProsAbleYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_ABLE_YN" , 0)
		if ProsAbleYn == "Y" Then
			DATAMANAGER.RequestTranData("obrtp_comn_019r")
		end if
	
	'v003 : 문진프로세스 처리 로직 obrtp_comn_019r complete 시점으로 변경
	ElseIf szTranID == "obrtp_comn_019r" Then
		'v003 sta : 동일인 여부 받아와 동일인일경우 금융사기문진, 보안매체, 전자서명 생략 및 간편이체한도 미적용 
		'v005 szSapeYN을 전역변수로 변경
		'Dim szSapeYN 주석처리 v005
		g_SapeYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SAPE_YN" , 0)		'동일인 여부(Y/N)
		Form.SetSharedData("61050_SAPE_YN", g_SapeYN )
		
		If g_SapeYN == "Y" Then
			TR_Inquiry("obcsb_oimf_638r_1")	'중요거래단말여부 판단 v005
		'v003 fin
		Else
			'jhi. T1811160033 금융사기 예방을 위한 문진제도 강화 대응
			'미등록계좌로 처리할경우에만 문진프로세스 처리   
			if cont01.rdoAccount.currentindex == "1" Then
				Dim szFiledate2, szPopup2
				szFiledate2 = Form.LoadConfigData( "mbbnk61010_pe", "mbbnk61010_curdate" )
				szPopup2    = Form.LoadConfigData( "mbbnk61010_pe", "mbbnk61010_popup" )
			
				If szFiledate2 <> Form.GetSharedData("&HOST_DATE" , false)  Then
					'팝업에서 예를 선택하면 OnPopupReturn 이벤트 Call 됨.
					Form.OpenPopup("mbbnk61010_pe" , ""  , "")	
				Else
					If popup2 = "Y" Then
						'팝업에서 예를 선택하면 OnPopupReturn 이벤트 Call 됨.
						Form.OpenPopup("mbbnk61010_pe" , ""  , "")	
					Else
						'처리
						szWithDrawData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & 
						cont01.edtAllMoney.caption & "★" & cont01.contNoMoney.edtNoMoney3.caption & "★" & cont01.contNoMoney.edtNoMoney4.caption & "★" 
						& cont01.contMoney.edtMoney2.caption & "★" & cont01.edtMy.caption & "★" & cont01.edtYou.caption & "★" 
						& cont01.edtAccount.caption & "★" & cont01.edtAccountName.caption & "★" & lblAccountName.caption	
					
						if g_szAccountFlg == "1" then	'등록계좌인 상태에서 출금 누르면 바로 공인인증
							sMdiaSkipYn = "N"
							Form.SetSharedData("61050_SMDIA_SKIP", sMdiaSkipYn )	'간편송금한도 미포함
							Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)
						elseif g_szCertUserType == "1" then ' 간편인증 로그인인 경우	2017.04.24 박영택 간편도 보안매체제거를 위해 638r 호출
							'Form.OpenFramePopup("mbbnk61050_p4" , szWithDrawData , sPosInfo)
							TR_Inquiry("obcsb_oimf_638r")	'추가인증여부 판단
						elseif g_szAccountFlg == "2" then	'미등록 계좌 상태에서 출금 누르면 보안매체로
							TR_Inquiry("obcsb_oimf_638r")	'추가인증여부 판단
						else
							Form.ShowAlert("알림", "등록/미등록계좌를 선택하세요")
							exit sub
						end if
					End if
				End if    
			Else
				szWithDrawData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & 
				cont01.edtAllMoney.caption & "★" & cont01.contNoMoney.edtNoMoney3.caption & "★" & cont01.contNoMoney.edtNoMoney4.caption & "★" 
				& cont01.contMoney.edtMoney2.caption & "★" & cont01.edtMy.caption & "★" & cont01.edtYou.caption & "★" 
				& cont01.edtAccount.caption & "★" & cont01.edtAccountName.caption & "★" & lblAccountName.caption	
			
				if g_szAccountFlg == "1" then	'등록계좌인 상태에서 출금 누르면 바로 공인인증
					sMdiaSkipYn = "N"
					Form.SetSharedData("61050_SMDIA_SKIP", sMdiaSkipYn )	'간편송금한도 미포함
					Form.OpenFramePopup("mbbnk61050_p2" , szWithDrawData , sPosInfo)
				elseif g_szCertUserType == "1" then ' 간편인증 로그인인 경우	2017.04.24 박영택 간편도 보안매체제거를 위해 638r 호출
					'Form.OpenFramePopup("mbbnk61050_p4" , szWithDrawData , sPosInfo)
					TR_Inquiry("obcsb_oimf_638r")	'추가인증여부 판단
				elseif g_szAccountFlg == "2" then	'미등록 계좌 상태에서 출금 누르면 보안매체로
					TR_Inquiry("obcsb_oimf_638r")	'추가인증여부 판단
				else
					Form.ShowAlert("알림", "등록/미등록계좌를 선택하세요")
					exit sub
				end if
			End If 
		End If			
	End If 
End Sub

'============================================================================
' cont01_btnChange_OnClick
'============================================================================
Sub cont01_btnChange_OnClick()
	if g_szFlg == "1" then	'전일가능수표금액보이기
		g_szFlg = "2"
		cont01.btnChange.caption   = "현금대체"
		cont01.contMoney.visible   = false
		cont01.contNoMoney.visible = true
	elseif g_szFlg == "2" then	'현금가능금액보이기
		g_szFlg = "1"
		cont01.btnChange.caption   = "수표금액대체"
		cont01.contMoney.visible   = true
		cont01.contNoMoney.visible = false
	end if
	
End Sub


'============================================================================
' cont01_rdoAccount_OnClick - 등록계좌/미등록계좌 누르기
'============================================================================
Sub cont01_rdoAccount_OnClick(nIndex)
	if nIndex == 0 then	'등록계좌버튼 누름
		Dim szSendData
		szSendData             = g_szAccountNumber & "★" & g_szAccountSerialNumber
		Form.OpenPopup("mbbnk61050_p1" , szSendData , sPosInfo)
		cont01.edtAccount.caption     = ""
		cont01.edtAccountName.caption = ""
		cont01.edtAccount.enable      = false
		cont01.edtAccountName.enable  = false
		
		'등록계좌 눌러서 성공해서 돌아오면
	elseif nIndex == 1 then '미등록계좌버튼 누름
		cont01.edtAccount.caption     	= ""
		cont01.edtAccountName.caption 	= ""
		cont01.edtAccount.enable      	= true
		cont01.edtAccountName.enable  	= false
		g_szAccountFlg         		= "2"
		cont01.btnChange.enable      	= false
		if g_szFlg == "2" then	
			cont01_btnChange_OnClick()
		end if	
	end if
End Sub


'============================================================================
' cont01_contMoney_btnAll_OnClick - 전액버튼
'============================================================================
Sub cont01_contMoney_btnAll_OnClick()
	cont01.contMoney.edtMoney2.caption = cont01.contMoney.edtMoney1.caption
	
	cont01.edtAllMoney.caption = cont01.contMoney.edtMoney2.caption + cont01.contNoMoney.edtNoMoney3.caption + cont01.contNoMoney.edtNoMoney4.caption
End Sub

'============================================================================
' cont01_contMoney_btn100_OnClick - 100만
'============================================================================
Sub cont01_contMoney_btn100_OnClick()
	Dim szTempMoney1, szTempMoney2
	szTempMoney1 = cont01.contMoney.edtMoney1.caption
	szTempMoney2 = cont01.contMoney.edtMoney2.caption + 1000000
	if CDbl(szTempMoney1) < CDbl(szTempMoney2) then
		Form.ShowAlert("알림", "현금대체금액이 현금가능금액보다 큽니다")
		exit sub		
	else		
		cont01.contMoney.edtMoney2.caption = szTempMoney2
		
		Dim szTempAllMoney
		szTempAllMoney = cont01.edtAllMoney.caption
		cont01.edtAllMoney.caption = szTempAllMoney + 1000000
	end if
End Sub

