'============================================================================
' cont01_edtAccount_OnClick : v004 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경
'============================================================================
Sub cont01_edtAccount_OnClick()

	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" then
		g_nClickCnt = g_nClickCnt + 1
		cont01.lblScrollPos.top = 600
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 80
	end if
End Sub
'============================================================================
' cont01_edtAccount_OnEditComplete - 입금계좌입력 완료시 계좌명 가져오기
'============================================================================
Sub cont01_edtAccount_OnEditComplete()

	'v004 2022.01.07 KSJ
	' 노치 있는 아이폰의 경우, 에디트를 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경했던것 제자리로
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" and g_nClickCnt < 2 then
		cont01.lblScrollPos.top = 0
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 0
		g_nClickCnt = 0
	else
		g_nClickCnt = 1
	end if
	
	if Len(Trim(cont01.edtAccount.caption)) <> 10 then
		cont01.edtAccount.caption = ""
		cont01.edtAccountName.caption = ""
		btnWithDraw.enable = false
		exit sub
	else		
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_025r", "InBlock1", "ASNO", 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN" , 0 , "N")	'사용여부
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Mid(cont01.edtAccount.caption, 1, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO", 0 , Mid(cont01.edtAccount.caption, 9, 2))	'상대일련번호
		DATAMANAGER.RequestTranData("obrtd_drng_025r")
		btnWithDraw.enable = true
	end if
End Sub

'============================================================================
' cont01_contMoney_edtMoney2_OnEditComplete - 현금대체금액 입력완료
'============================================================================
Sub cont01_contMoney_edtMoney2_OnEditComplete()

	Dim szTempMoney1, szTempMoney2
	szTempMoney1 = cont01.contMoney.edtMoney1.caption
	szTempMoney2 = cont01.contMoney.edtMoney2.caption
	if CDbl(szTempMoney1) < CDbl(szTempMoney2) then
		Form.ShowAlert("알림", "현금대체금액이 현금가능금액보다 큽니다")
		cont01.contMoney.edtMoney2.caption =  cont01.contMoney.edtMoney1.caption
		exit sub		
	else		
		cont01.edtAllMoney.caption = cont01.contMoney.edtMoney2.caption + cont01.contNoMoney.edtNoMoney3.caption + cont01.contNoMoney.edtNoMoney4.caption

	end if

	if szTempMoney2 == "" or szTempMoney2 == null then
		cont01.contMoney.edtMoney2.caption = "0"
	end if

End Sub

'============================================================================
' cont01_contNoMoney_edtNoMoney3_OnEditComplete - 전일대체수표금액 입력완료
