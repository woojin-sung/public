'===========================================================================
' 등록/변경/삭제 버튼 속성함수
'===========================================================================
Function SetControlType()
	if Cont0.Table0.GetCellString( 1, 0 ) == "" then '자택주소
		Cont0.ButtonHReg.visible = true
		Cont0.ButtonHModi.visible = false
		Cont0.ButtonHDel.visible = false
	else
		Cont0.ButtonHReg.visible = false
		Cont0.ButtonHModi.visible = true
		Cont0.ButtonHDel.visible = true
	end if
	
	if Cont0.Table0.GetCellString( 4, 0 ) == "" then '직장주소
		Cont0.ButtonOReg.visible = true
		Cont0.ButtonOModi.visible = false
		Cont0.ButtonODel.visible = false
	else
		Cont0.ButtonOReg.visible = false
		Cont0.ButtonOModi.visible = true
		Cont0.ButtonODel.visible = true
	end if
	
	if Cont0.Table0.GetCellString( 7, 0 ) == "" then 'e-mail주소
		Cont0.ButtonReg.visible = true
		Cont0.ButtonModi.visible = false
		Cont0.ButtonDel.visible = false
	else
		Cont0.ButtonReg.visible = false
		Cont0.ButtonModi.visible = true
		Cont0.ButtonDel.visible = true
	end if
	
	'20221208 수정요청 : 기타 삭제
'	if Cont0.Table0.GetCellString( 7, 0 ) == "" then '기타주소
'		Cont0.ButtonReg.visible = true
'		Cont0.ButtonModi.visible = false
'		Cont0.ButtonDel.visible = false
'	else
'		Cont0.ButtonReg.visible = false
'		Cont0.ButtonModi.visible = true
'		Cont0.ButtonDel.visible = true
'	end if
'	
'	if Cont0.Table0.GetCellString( 10, 0 ) == "" then 'e-mail주소
'		Cont0.ButtonEReg.visible = true
'		Cont0.ButtonEModi.visible = false
'		Cont0.ButtonEDel.visible = false
'	else
'		Cont0.ButtonEReg.visible = false
'		Cont0.ButtonEModi.visible = true
'		Cont0.ButtonEDel.visible = true
'	end if
End Function

'===========================================================================
' 전화번호 클리어
'===========================================================================
Function SetControlViewClear()
	Cont0.Table0.SetCellString( 1, 0, "" )
	Cont0.Table0.SetCellString( 2, 0, "" )
	Cont0.Table0.SetCellString( 4, 0, "" )
	Cont0.Table0.SetCellString( 5, 0, "" )
	Cont0.Table0.SetCellString( 7, 0, "" )
'	Cont0.Table0.SetCellString( 8, 0, "" )
'	Cont0.Table0.SetCellString( 10, 0, "" )
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		SetControlViewClear()
		
		Dim sHome1, sHome2, sHome3, sHome4, sOffice1, sOffice2, sOffice3, sOffice4, sEtc1, sEtc2, sEtc3, sEtc4, sEmail1
		sHome1 = Form.GetSharedData("Adress_Home1" , false)
		sHome2 = Form.GetSharedData("Adress_Home2" , false)
		sHome3 = Form.GetSharedData("Adress_Home3" , false)
		sHome4 = Form.GetSharedData("Adress_Home4" , false)
		sOffice1 = Form.GetSharedData("Adress_Office1" , false)
		sOffice2 = Form.GetSharedData("Adress_Office2" , false)
		sOffice3 = Form.GetSharedData("Adress_Office3" , false)
		sOffice4 = Form.GetSharedData("Adress_Office4" , false)
		sEtc1 = Form.GetSharedData("Adress_Etc1" , false)
		sEtc2 = Form.GetSharedData("Adress_Etc2" , false)
		sEtc3 = Form.GetSharedData("Adress_Etc3" , false)
		sEtc4 = Form.GetSharedData("Adress_Etc4" , false)
		sEmail1 = Form.GetSharedData("Adress_Email1" , false)
		
		if sHome1 ~= null and sHome1 ~= "" then
			Cont0.Table0.SetCellString( 1, 0, "("..sHome1.."-"..sHome2..")"..sHome3 )
			Cont0.Table0.SetCellString( 2, 0, sHome4 )
		end if 
		
		if sOffice1 ~= null and sOffice1 ~= "" then
			Cont0.Table0.SetCellString( 4, 0, "("..sOffice1.."-"..sOffice2..")"..sOffice3 )
			Cont0.Table0.SetCellString( 5, 0, sOffice4 )
		end if 
		
		'20221208 수정요청 : 기타 삭제
'		if sEtc1 ~= null and sEtc1 ~= "" then
'			Cont0.Table0.SetCellString( 7, 0, "("..sEtc1.."-"..sEtc2..")"..sEtc3 )
'			Cont0.Table0.SetCellString( 8, 0, sEtc4 )
'		end if 
		
		if sEmail1 ~= null and sEmail1 ~= "" then
			Cont0.Table0.SetCellString( 7, 0, sEmail1 )
		end if 	
		
'		if sEmail1 ~= null and sEmail1 ~= "" then
'			Cont0.Table0.SetCellString( 10, 0, sEmail1 )
'		end if 	
		
		SetControlType()
	end if
End Sub


