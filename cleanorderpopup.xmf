'============================================================================
Sub ButtonOK_OnClick()
	DATAMANAGER.SetDataValue( 0, "obcmp_uftr_233u", "InBlock1", "EXTC_DATE", 0 , g_strExtcDate )
	DATAMANAGER.SetDataValue( 0, "obcmp_uftr_233u", "InBlock1", "ACNO", 0 , g_strAcno )
	DATAMANAGER.SetDataValue( 0, "obcmp_uftr_233u", "InBlock1", "ASNO", 0 , g_strAsno )
	DATAMANAGER.SetDataValue( 0, "obcmp_uftr_233u", "InBlock1", "STND_ISCD", 0 , g_strStndIsCd )
	DATAMANAGER.SetDataValue( 0, "obcmp_uftr_233u", "InBlock1", "QUL_ODER_INFR_TRGT_TYPE", 0 , g_strTypeCode )
	DATAMANAGER.SetDataValue( 0, "obcmp_uftr_233u", "InBlock1", "QUL_ODER_INFR_TRGT_PPP_CLS", 0 , g_strPopupGb )
	
	DATAMANAGER.RequestTranData( "obcmp_uftr_233u" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)



	if szTranID == "obcmp_uftr_233r" then
	
		szType = DATAMANAGER.GetDataValue(0, "obcmp_uftr_233r", "OutBlock1", "QUL_ODER_INFR_TRGT_TYPE"	, 0)
		szIsnm = DATAMANAGER.GetDataValue(0, "obcmp_uftr_233r", "OutBlock1", "ISNM" 					, 0)
		szCntt = DATAMANAGER.GetDataValue(0, "obcmp_uftr_233r", "OutBlock1", "QUL_ODER_INFR_LETT_CNTT" 	, 0)
		szYN   = DATAMANAGER.GetDataValue(0, "obcmp_uftr_233r", "OutBlock1", "CNFR_YN" 				, 0)
		
		if szYn == "Y" then
			Exit sub
		end if
		
		
		if szType == "01" then
		
			LabelTitle.caption = "가장성매매 우려"
			Label1.caption = "가장성매매"
			Label2.caption = szCntt&"\n\n※ 기타 궁금하신 사항은 컴플라이언스팀 (02-6309-2997)으로 문의하시기 바랍니다."
			Label4.caption = szIsnm
		
		elseif szType == "02" then
		
			LabelTitle.caption = "시세관여 과다(일반 종목, 주가 급등 종목 공동"
			Label1.caption = "소량 분할호가를 통한 종목 시세상승 관여"
			Label2.caption = szCntt&"\n\n※ 기타 궁금하신 사항은 컴플라이언스팀 (02-6309-2997)으로 문의하시기 바랍니다."
			Label4.caption = szIsnm
		
		elseif szType == "03" then
		
			LabelTitle.caption = "허수성호가 과다"
			Label1.caption = "허수성호가"
			Label2.caption = szCntt&"\n\n※ 기타 궁금하신 사항은 컴플라이언스팀 (02-6309-2997)으로 문의하시기 바랍니다."
			Label4.caption = szIsnm
		
		elseif szType == "04" then
		
			LabelTitle.caption = "취소·정정호가 과다"
			Label1.caption = "취소·정정과다"
			Label2.caption = szCntt&"\n\n※ 기타 궁금하신 사항은 컴플라이언스팀 (02-6309-2997)으로 문의하시기 바랍니다."
			Label4.caption = szIsnm
		
		elseif szType == "05" then
		
			LabelTitle.caption = "건전주문 확인요청"
			Label1.caption = "기타"
			Label2.caption = szCntt&"\n\n※ 기타 궁금하신 사항은 컴플라이언스팀 (02-6309-2997)으로 문의하시기 바랍니다."
			Label4.caption = szIsnm
		
		end if
	
		
	
	elseif szTranID == "obcmp_uftr_233u" then
	
	Form.CloseForm()
	
	end if
	
End Sub


'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()

	sOpenData = Form.GetOpenLinkData()
	arrData = Split( sOpenData, "`" )
	
 	
	g_strExtcDate = arrData[0]
	g_strAcno = arrData[1]
	g_strAsno = arrData[2]
	g_strStndIsCd = arrData[3]
	g_strIsNm = arrData[4]
	g_strTypeCode = arrData[5]
	g_strPopupGb = arrData[6]
	
	strAcno = arrData[1]
	
	
	
	if Len(strAcno) < 5 then
		Form.CloseForm()
	end if
	
	
	
End Sub

