'============================================================================
Function AML_DATA_Setting()

	'AML_PROD_CODE(AML상품코드)-CMA 계좌 개설이 포함되어 있으면 '0004', 없으면 '0005'
	'v0007 
	If sSac == "Y" Then	
		gAmlProdCode = "0092"
	ElseIf sCmpRp == "Y" Then	
		gAmlProdCode = "0004"
	Else
		gAmlProdCode = "0005"
	End If
	
	'직업직종
	gOcptCode 		= ContMain.CmbJob.cbkeydata	
	
	If Trim(gLRDV_CODE ) <> ""  Then 
		gAmlOcknLrdvCode 	= gLRDV_CODE
		
		gAmlOcknSmdvCode	= gSMDV_CODE	
	End If 
	
	'거래목적, 자금원천
	gEddTrObjtCode 		= ContMain.CmbPurpose.cbkeydata
	gEddTrFndsSorcCode 	= ContMain.CmbMoney.cbkeydata
	
End Function 



