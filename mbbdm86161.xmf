'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_acct_058r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , gRCNO      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , gRegUniqNo	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , "2"	)
	
	ElseIf szTranID = "obaci_acct_059c" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 			, 0 , gRegUniqNo			     ) '등록고유번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 		, 0 , "2"				     ) '등록단계구분코드
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ABWR_NAME" 		, 0 , getDataName			     ) '고객약어명
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ENG_NAME" 		     , 0 , getDataEngname			) '고객영문명
		
'		If getDataAddrgbn ="01" Then '주소지정보: 자택 
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_REGN_ZIP" 		     , 0 , getDataRegnzip 	) '자택지역우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_DTL_ZIP" 			 , 0 , getDataDtlzip   ) '자택상세우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_POST" 			 , 0 , getDataAddr     ) '자택우편주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_DTAD" 			 , 0 , getDataAddrdtl  ) '자택상세주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_NW_ADDR_USE_YN"      , 0 , getDataCyn     	) '자택신주소사용여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_BLDN_MNNO" 		 , 0 , getDataCbldn    ) '자택건물관리번호
'		ElseIf getDataAddrgbn ="02" Then '주소지정보: 직장 
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_REGN_ZIP" 			 , 0 , getDataCoRegnzip 	) '회사지역우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_DTL_ZIP" 			 , 0 , getDataCoDtlzip  	) '회사상세우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_POST" 				 , 0 , getDataCoAddr     ) '회사우편주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_DTAD" 				 , 0 , getDataCoAddrdtl  ) '회사상세주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_NW_ADDR_USE_YN"        , 0 , getDataCoCyn     	) '회사신주소사용여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_BLDN_MNNO" 			 , 0 , getDataCoCbldn   	) '회사건물관리번호
'		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_ADDR_SRNO" 		, 0 , getOwhsAddrSrno		     ) '자택주소일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_ADDR_SRNO" 			, 0 , getCoAddrSrno		     ) '회사주소일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR_SRNO" 		, 0 , getEmailAddrSrno		     ) '이메일주소일련번호	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR" 			 , 0 , getDataEmail	) '이메일주소
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "SNML_INAG_TYPE_CODE"      , 0 , getDataSnmlclcd ) '발송물통보처유형코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "MAIL_INAG_TYPE_CODE"      , 0 , getDataMailclcd ) '우편물통보처유형코드	
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_CNPL_SRNO" 		 , 0 , "0"			) '자택연락처일련번호	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_CNPL_SRNO" 			 , 0 , "0"			) '회사연락처일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_CNPL_SRNO" 		 , 0 , "0"			) '휴대폰연락처일련번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_ARCD" 			 , 0 , getDataOwhsarcd ) '자택지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_TONO" 			 , 0 , getDataOwhstono ) '자택국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_TELNO" 			 , 0 , getDataOwhstelno) '자택전화번호

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_ARCD" 				 , 0 , getDataWrplarcd ) '회사지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_TONO" 				 , 0 , getDataWrpltono ) '회사국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_TELNO" 				 , 0 , getDataWrpltelno) '회사전화번호

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_ARCD" 			 , 0 , getDataClpharcd	) '휴대폰지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_TONO" 			 , 0 , getDataClphtono	) '휴대폰국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CPNO" 					 , 0 , getDataCpno	) '휴대폰번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_PROD_CODE" 			, 0 , gAmlProdCode			) 'AML상품코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_CHAN_TYPE_CODE" 	, 0 , "03"					) 'AML채널유형코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OCPT_CODE" 			, 0 , ""						) '직업코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_OCKN_LRDV_CODE" 	, 0 , gAmlOcknLrdvCode			) 'AML직종대분류코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "AML_OCKN_SMDV_CODE" 	, 0 , gAmlOcknSmdvCode			) 'AML직종소분류코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EDD_TR_OBJT_CODE" 		, 0 , gEddTrObjtCode			) 'EDD거래목적코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EDD_TR_FNDS_SORC_CODE" 	, 0 , gEddTrFndsSorcCode		) 'EDD거래자금출처코드
		if CInt(gLRDV_CODE) == 13 then 'and Trim(ContMain.CmbJob.caption) <> "기타" then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OCPT_NAME" 			, 0 , ContMain.CmbJob.caption				) '직업명
		end if
		if ContMain.edtCompany.caption <> "" and ContMain.edtCompany.caption <> null then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "WRPL_NAME" 			, 0 , ContMain.edtCompany.caption	) '직장명
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE"   		 , 0 , getHndvMthdCd	) 'v0006 교부방식
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE  ) 
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "UI_INVT_INCL_ACMP_YN"           , 0 , g_Invt_YN               )  'UI투자성향수행여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "KYC_INVT_INCL_GRAD_CODE"        , 0 , g_BDM_KYC_GRAD          )  'KYC투자성향등급코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "KYC_PROD_GRAD_CODE"             , 0 , g_BDM_PROD_GRAD         )  'KYC상품등급코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "UNFIT_YN"                       , 0 , g_BDM_UNFIT_YN          )  '부적합여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "FTOT_INVT_INCL_GRAD_CODE"       , 0 , g_BDM_DVPD_KYC_GRAD     )  '선물옵션투자성향등급코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "FTOT_PROD_GRAD_CODE"            , 0 , g_BDM_DVPD_PROD_GRAD    )  '선물옵션상품등급코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "FTOT_UNFIT_YN"                  , 0 , g_BDM_DVPD_UNFIT_YN     )  '선물옵션부적합여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "WEAK_FNNC_SMAL_VISA_YN"         , 0 , g_BDM_WEAK_FNNC_YN      )  '취약금융소비자여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "KYC_INVT_RCMD_CLS_CODE"         , 0 , g_BDM_KYC_INVT_RCMD_CLS_CODE      )  'KYC투자권유구분코드
		
		'20230724 모바일 우선 통보 여부 추가
		'모바일우선통보여부
		if getMBL_PRTY_INFR_YN == "0" or getMBL_PRTY_INFR_YN == 0 then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "MBL_PRTY_INFR_YN"         , 0 , "N"      )		
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock5", "MBL_PRTY_INFR_YN"         , 0 , "Y"      )
		end if
	End If
End Sub

'============================================================================
Sub BtnNext_OnClick()
	BtnNext.enable = False
	If g_szTheme = "black" Then
		BtnNext.btnimage = "btn_27.9"
	Else 
		BtnNext.btnimage = "btn_21.9"
	End If
	BtnNext.fgcolor = "269"

	Call AML_DATA_Setting()
	Call SetSharedData_Setting()
		
	'투자성향단계까지 마친 후 obaci_acct_059c 호출
	Form.OpenPopup("mbbdm86170", "", "")

End Sub

'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_acct_058r" Then
		sCmpRp		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "CMA_RP_JOIN_APLT_YN" 	, 0)
		sSac  		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "SAC_ACNT_APLT_YN" 	, 0)
		
'		'초기값 : 직장인.... 상세 업종은 초기값 x
'		gLRDV_CODE = "01"		'"1": 직장인
'		gSMDV_CODE = "0114"	'"0114": 경영 및 회계 관련 사무직
'		
'		ContMain.CmbJob.currentindex = "0"
'		ContMain.CmbPurpose.currentindex = "3"
'		ContMain.CmbMoney.currentindex = "4"
		
		'고객확인의무 데이터 불러와서 세팅
		Dim szObjtCode, szSourceCode, szWrplName, szOcptName
		gLRDV_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "AML_OCKN_LRDV_CODE" 	, 0)		'직종대분류
		gSMDV_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "AML_OCKN_SMDV_CODE" 	, 0)		'직종소분류
		szObjtCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "EDD_TR_OBJT_CODE" 	, 0)			'거래목적
		szSourceCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "EDD_TR_FNDS_SORC_CODE" 	, 0)	'거래자금출처
		szWrplName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "WRPL_NAME" 	, 0)				'직장명
		szOcptName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "OCPT_NAME" 	, 0)				'직업명(기타일시)
		
		'학생, 주부, 무직, 전업투자자 선택
		if CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
			ContMain.edtCompany.visible = false	'무조건 false처리..
			
'			if errorFlag == 0 and errorFlag1 == 0 then
'				ContMain.CmbPurpose.top= 463-80
'				ContMain.CmbMoney.top  = 547-80					
'			elseif errorFlag == 1 and errorFlag1 == 1 then
'				ContMain.CmbPurpose.top= 463'-80+60
'				ContMain.CmbMoney.top  = 547'-80+60
'			else
'				ContMain.CmbPurpose.top= 463-40
'				ContMain.CmbMoney.top  = 547-40	
'			end if				
			
			'이 시점에서는 오류 갯수 체크할 수 없을 듯 하니 위에 내용 주석처리 하고 기본 top값 세팅
			ContMain.CmbPurpose.top= 463-80
			ContMain.CmbMoney.top  = 547-80					
			
			ContMain.LabStnd.top = 550
		else
			
			ContMain.edtCompany.visible = true				
			
'			if errorFlag == 0 and errorFlag1 == 0 then
'				ContMain.CmbPurpose.top= 463
'				ContMain.CmbMoney.top  = 547						
'			elseif errorFlag == 1 and errorFlag1 == 1 then
'				ContMain.CmbPurpose.top= 463+80
'				ContMain.CmbMoney.top  = 547+80
'			else
'				ContMain.CmbPurpose.top= 463+40
'				ContMain.CmbMoney.top  = 547+40	
'			end if				
			
			'이 시점에서는 오류 갯수 체크할 수 없을 듯 하니 위에 내용 주석처리 하고 기본 top값 세팅
			ContMain.CmbPurpose.top= 463
			ContMain.CmbMoney.top  = 547	
			
			ContMain.LabStnd.top = 610
		end if
		
		ContMain.SetScrollAutoSize()
		
		ContMain.CmbJob.currentindex = CInt(gLRDV_CODE) - 1
		ContMain.CmbPurpose.cbkeydata = szObjtCode
		ContMain.CmbMoney.cbkeydata = szSourceCode
		ContMain.edtCompany.caption = szWrplName
		
		'값은 세팅됐지만 색상이 힌트색이라서 처리
		if Form.GetSharedData("&OS_TYPE", false) == "1" then
'			ContMain.CmbJob.currentindex = ContMain.CmbJob.currentindex
'			ContMain.CmbPurpose.currentindex = ContMain.CmbPurpose.currentindex
'			ContMain.CmbMoney.currentindex = ContMain.CmbMoney.currentindex
			
			ContMain.CmbJob.fgcolor = "4"
			ContMain.CmbPurpose.fgcolor = "4"
			ContMain.CmbMoney.fgcolor = "4"
			if ContMain.edtCompany.caption <> "" then
				ContMain.edtCompany.fgcolor = "4"
			end if
		end if
		
		if gLRDV_CODE == "13" then
			ContMain.CmbJob.caption = szOcptName
		end if
		
		f_CheckNextEnable()
		
	ElseIf szTranID = "obaci_acct_059c" Then
		'계좌비밀번호 등록 화면으로 넘어감
		Form.OpenNextPopup("mbbdm86180", "", "")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	BtnNext.enable = true
	BtnNext.btnimage = "btn_20.9"
	BtnNext.fgcolor = "62"
	
	if szTranID == "obaci_acct_059c" then
		if szErrCode == "4572" or szErrCode == "4480" then
			'ShowAlert "안내", "이미 개설이 완료되었거나, 취소가 된 경우에는" & Chr(13) & Chr(10) & "이어하기가 불가합니다."
     		Form.MsgBox("안내", "이미 개설이 완료되었거나\n취소가 된 경우에는\n이어하기가 불가합니다.", "PrgsExit", 6)
			Exit Sub 			
		else
			if len(trim(DATAMANAGER.GetDataMsgSubText(szTranID))) == 0 then
				ShowAlert "안내", szErrMsg
			else
				ShowAlert "안내", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
			end if			
		end if
	else
		if len(trim(DATAMANAGER.GetDataMsgSubText(szTranID))) == 0 then
			ShowAlert "안내", szErrMsg
		else
			ShowAlert "안내", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
		end if	
	end if	

End Sub

