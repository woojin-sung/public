Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	g_szTheme = Form.GetEnvData("common.theme")
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		ContMain.Label8.setNeighborCtlPos("imgTooltip", "right", 8, "")
		
		ContMain.setScrollBarVisible("2")
	end if
	
	ContMain.Label2.visible = False '해외납세자 구분
	ContMain.Label3.visible = False '*
	
	'"94" 는 콤보 펼친 값이 ImgF 아래 오기 위한 속성값
     ContMain.CmbMoney.setApplyLabel  ("자금의 원천" ,0  , 268 , "left" , true, "94" )
	ContMain.CmbJob.setApplyLabel    ("직업"        ,0  , 268 , "left" , true, "94" )
	ContMain.CmbPurpose.setApplyLabel("거래목적"    ,0  , 268 , "left" , true, "94" )
	ContMain.edtCompany.setApplyLabel   ("회사명/상호명"        ,0  , 268 , "left" , false, "94" )
	
	ContMain.CmbJob.cbtype = "5"
	ContMain.CmbPurpose.cbtype = "5"
	ContMain.CmbMoney.cbtype = "5"
	
	
	'에디트 위에 다른 컨트롤이 올라가면 꼭 호출해줘야함
	ContMain.BtnOccu.bringFront("1") 
	
	gRCNO         = Form.GetSharedData("BDM_RCNO_PIP"       , false ) '주민등록번호
	gRegUniqNo 	= Form.GetSharedData("BDM_REG_UNIQ_NO"    , false ) '등록고유번호
	gAcntOpngClcd = Form.GetSharedData("BDM_ACNT_OPNG_CLCD" , false ) '계좌개설구분코드
	
	gPageID		= "3"
	errorFlag     = 0
	errorFlag1    = 0
	succFlag      = 0
	
	'help msg
	ContMain.RadioGroup0.SetUseResultLabel(true,2)
	ContMain.RadioGroup1.SetUseResultLabel(true,2)
	
	'**************************************
     ' GetSharedData 고객정보 입력_기본정보
     '**************************************
	Call GetSharedData_Setting()	
	'gAcntOpngClcd = "2" ' test
'	Call SetFrame(gAcntOpngClcd)
	
	BtnNext.enable = False
	If g_szTheme = "black" Then
		BtnNext.btnimage = "btn_27.9"
	Else 
		BtnNext.btnimage = "btn_21.9"
	End If
	BtnNext.fgcolor = "269"
	
	'2021.04.19. 김유경. 이전 화면에서 돌아오면 컨트롤 모두 보이기
	sRevData = Form.GetOpenLinkData()
	
	ContMain.edtCompany.visible = false
	
	ContMain.CmbPurpose.top= 463-84
	ContMain.CmbMoney.top  = 547-84
		
	
	'실제소유자여부
	ContMain.Label0.visible      = True
	ContMain.Label1.visible      = True
	ContMain.RadioGroup0.visible = True
	
	ContMain.RadioGroup0.currentindex = "0"	'default값 세팅
	
	'해외납세자구분
	ContMain.Label2.visible      = True
	ContMain.Label3.visible      = True
	ContMain.RadioGroup1.visible = True
	
'		ContMain.RadioGroup1.currentindex = "0"	'default값 세팅
	
	'직업
	ContMain.CmbJob.visible      = True
	
	ContMain.BtnOccu.visible     = True
	ContMain.BtnOccu.caption     = ""
	
	'거래목적
	ContMain.CmbPurpose.visible  = True
'		ContMain.CmbPurpose.cbkeydata= gEddTrObjtCode
'		ContMain.CmbPurpose.fgcolor  = 268
	
	'자금의원천
	ContMain.CmbMoney.visible    = True
'		ContMain.CmbMoney.cbkeydata  = gEddTrFndsSorcCode
'		ContMain.CmbMoney.fgcolor    = 268	
	
	ContMain.SetScrollAutoSize()
	
	DATAMANAGER.RequestTranData("obaci_acct_058r")
	
End Sub

'============================================================================
Function f_CheckNextEnable()
	Dim bFlag
	bFlag = true
	
	'if ContMain.RadioGroup0.currentindex == "-1" then
	if ContMain.RadioGroup0.currentindex <> "0" then
		bFlag = false
	end if
	
	'if ContMain.RadioGroup1.currentindex == "-1" then
	if ContMain.RadioGroup1.currentindex <> "0" then
		bFlag = false
	end if
	
	if trim(ContMain.CmbJob.caption) = "직업을 선택해주세요." then
		bFlag = false
	end if
	
	'직업/직종 코드(초기값 세팅 때문에 추가함)
	if gLRDV_CODE == "" or gLRDV_CODE == null then
		bFlag = false
	end if
	
	if CInt(gLRDV_CODE) == 1 or CInt(gLRDV_CODE) == 2 or CInt(gLRDV_CODE) == 3 then
		if gSMDV_CODE == "" or gSMDV_CODE == null then
			bFlag = false
		end if
	end if
	
	'기타일경우 직업명 입력 필수
'	Form.ShowAlert(gLRDV_CODE, ContMain.edtCompany.caption)
	if CInt(gLRDV_CODE) == 13 then
		'if trim(ContMain.edtCompany.caption) == "" then
		'if trim(ContMain.CmbJob.caption) == "기타" then		
		'	bFlag = false
		'end if
		
'		Dim nLen
'		nLen = Form.getLen(trim(ContMain.edtCompany.caption))
'		Form.ShowAlert("", nLen)
		
		if Form.getLen(trim(ContMain.CmbJob.caption)) < 3 then
'			Form.ShowAlert("안내", "기타인 경우 직업명을 입력해주세요.\n(3자 이상 필수)")
			bFlag = false
		end if		
	end if
	
	if trim(ContMain.CmbPurpose.caption) = "거래목적을 선택해주세요." then
		bFlag = false
	end if
	
	if trim(ContMain.CmbMoney.caption) = "자금의 원천을 선택해주세요." then
		bFlag = false
	end if
	
	BtnNext.enable = bFlag
	
	if bFlag then
		BtnNext.btnimage = "btn_20.9"
		'BtnNext.fgcolor = "62"
		BtnNext.fgcolor = "273"
	else
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
	end if
End Function

'============================================================================
Function User_Invt_Proc()

    g_BDM_KYC_GRAD           = Form.GetSharedData("BDM_KYC_GRAD"           , false)  '투자성향등급
    g_BDM_PROD_GRAD          = Form.GetSharedData("BDM_PROD_GRAD"          , false)  '상품등급
    g_BDM_UNFIT_YN           = Form.GetSharedData("BDM_UNFIT_YN"           , false)  '부적합여부
    g_BDM_DVPD_KYC_GRAD      = Form.GetSharedData("BDM_DVPD_KYC_GRAD"      , false)  '파생상품투자성향등급
    g_BDM_DVPD_PROD_GRAD     = Form.GetSharedData("BDM_DVPD_PROD_GRAD"     , false)  '파생상품상품등급
    g_BDM_DVPD_UNFIT_YN      = Form.GetSharedData("BDM_DVPD_UNFIT_YN"      , false)  '파생상품부적합여부
    g_BDM_WEAK_FNNC_YN       = Form.GetSharedData("BDM_WEAK_FNNC_YN"       , false)  '취약금융소비자여부
    g_BDM_KYC_INVT_RCMD_CLS_CODE	= Form.GetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , false)  'KYC투자권유구분코드
	
	SetSharedData_Setting()
	
    g_Invt_YN = "Y"  '투자성향진단완료
End Function

