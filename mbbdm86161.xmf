'===========================================================================
' SetSharedData_Setting 고객정보 입력_고객확인의무 (mbbdm10051)
'===========================================================================
Function SetSharedData_Setting()

	Form.SetSharedData( "BDM_AMLPRODCODE"     , gAmlProdCode     ) 'AML상품코드
	Form.SetSharedData( "BDM_OCPTCODE"        , gOcptCode        ) '직업
	Form.SetSharedData( "BDM_AMLOCKNLRDVCODE" , gAmlOcknLrdvCode ) '직종대분류
	Form.SetSharedData( "BDM_AMLOCKNSMDVCODE" , gAmlOcknSmdvCode ) '직종소분류
	Form.SetSharedData( "BDM_EDDTROBJTCODE"   , gEddTrObjtCode   ) '거래목적
	Form.SetSharedData( "BDM_EDDTRFNDSORCCODE", gEddTrFndsSorcCode ) '자금의원천
	Form.SetSharedData( "BDM_AMLOcknName"     , gAmlOcknName     ) '직종명
	
	
	Form.SetSharedData("BDM_KYC_GRAD"           , ""  )  '투자성향등급
	Form.SetSharedData("BDM_PROD_GRAD"          , ""  )  '상품등급
	Form.SetSharedData("BDM_UNFIT_YN"           , ""  )  '부적합여부
	Form.SetSharedData("BDM_DVPD_KYC_GRAD"      , ""  )  '파생상품투자성향등급
	Form.SetSharedData("BDM_DVPD_PROD_GRAD"     , ""  )  '파생상품상품등급
	Form.SetSharedData("BDM_DVPD_UNFIT_YN"      , ""  )  '파생상품부적합여부
	Form.SetSharedData("BDM_WEAK_FNNC_YN"       , ""  )  '취약금융소비자여부
	Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , ""  )  'KYC투자권유구분코드
	
	'온라인계좌개설에서 투자성향화면 호출하면서 변수 추가함, 비대면에서는 null로 넘기도록 초기화 로직 추가함 (230703)
	Form.SetSharedData("BDM_YN"        		   , ""  )  '비대면여부 (투자성향화면)
	Form.SetSharedData("BDM_CUST_ACNO"           , ""  )  '비대면N인때 종합계좌번호 넘기는 값(투자성향화면)	
	
End Function 

