Sub ContMain_BtnOccu_OnClick()		
	Form.OpenPopupAnimation("mbbdm86161_p1" , "pass"  ,"","2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'직종
	If sKeyName == "mbbdm86161_p1" Then	
		ContMain.Label6.visible = False
		ContMain.CmbJob.fgcolor = 268
'		ContMain.CmbJob.Caption = sRet
		
		gAmlOcknName      = sRet
		
		gLRDV_CODE = Form.GetSharedData("13010_OCCU_LRDV", False )	'대업무분류
		gSMDV_CODE = Form.GetSharedData("13010_OCCU_SMDV", False )	'소업무분류
		
		
		'Form.ShowAlert("jsi알림", "gLRDV_CODE ::: " & gLRDV_CODE)
		ContMain.CmbJob.currentindex = CInt(gLRDV_CODE) - 1
		
		'학생, 주부, 무직, 전업투자자 선택
		if CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
		'if CInt(gLRDV_CODE) == 1 or CInt(gLRDV_CODE) == 2 or CInt(gLRDV_CODE) == 3 or CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
			ContMain.edtCompany.visible = false	'무조건 false처리..
			
			'ContMain.CmbPurpose.top= 463-80
			'ContMain.CmbMoney.top  = 547-80
			
			
			'라디오항목 오류메시지 있을때 os별로 top값 지정이 달라서 분기했음
			if errorFlag == 0 and errorFlag1 == 0 then				'오류메시지 없음
				ContMain.CmbPurpose.top= 463-84
				ContMain.CmbMoney.top  = 547-84					
				
				ContMain.LabStnd.top = 550
				
			elseif errorFlag == 1 and errorFlag1 == 1 then
				if Form.GetSharedData("&OS_TYPE", false) == "2" then	'오류메시지 2개
					ContMain.CmbPurpose.top= 463 + 16 '-80+60 
					ContMain.CmbMoney.top  = 547 + 16'-80+60
					
					ContMain.LabStnd.top = 650
				else
					ContMain.CmbPurpose.top= 463 '-80+60 
					ContMain.CmbMoney.top  = 547'-80+60
					
					ContMain.LabStnd.top = 600
				end if
			else													'오류메시지 1개
			
				if Form.GetSharedData("&OS_TYPE", false) == "2" then
					ContMain.CmbPurpose.top= 463-42+8
					ContMain.CmbMoney.top  = 547-42+8
					
					ContMain.LabStnd.top = 550 + 30
				else
					ContMain.CmbPurpose.top= 463-42
					ContMain.CmbMoney.top  = 547-42
				
					ContMain.LabStnd.top = 550
				end if
			end if	
			
		'그 외
		else
		'if CInt(gLRDV_CODE) == 13 then
		
			ContMain.CmbPurpose.top= 463
			ContMain.CmbMoney.top  = 547			
			
			'라디오항목 오류메시지 있을때 os별로 top값 지정이 달라서 분기했음
			if errorFlag == 0 and errorFlag1 == 0 then				'오류메시지 없음
				ContMain.CmbPurpose.top= 463
				ContMain.CmbMoney.top  = 547						
				
				ContMain.LabStnd.top = 610
				
			elseif errorFlag == 1 and errorFlag1 == 1 then
				if Form.GetSharedData("&OS_TYPE", false) == "2" then	'오류메시지 2개
					ContMain.CmbPurpose.top= 463+82+16
					ContMain.CmbMoney.top  = 547+82+16
					
					ContMain.LabStnd.top = 610 + 80 + 30
				else
					ContMain.CmbPurpose.top= 463+84
					ContMain.CmbMoney.top  = 547+84
					
					ContMain.LabStnd.top = 610 + 80 + 30
				end if
			else													'오류메시지 1개
			
				if Form.GetSharedData("&OS_TYPE", false) == "2" then
					ContMain.CmbPurpose.top= 463+34+16
					ContMain.CmbMoney.top  = 547+34+16
					
					ContMain.LabStnd.top = 610 + 40 + 30
				else
					ContMain.CmbPurpose.top= 463+40
					ContMain.CmbMoney.top  = 547+40
					
					ContMain.LabStnd.top = 610 + 40
				end if
			end if				
			
			if CInt(gLRDV_CODE) <> 13 then
				ContMain.edtCompany.hintcaption = "입력해주세요(선택)"
			else
				ContMain.edtCompany.hintcaption = "입력해주세요(선택)"
				
				'기타일경우 직업입력 팝업 오픈
				Dim szEtcName
				if CInt(gLRDV_CODE) == 13 and Trim(ContMain.CmbJob.caption) <> "기타" then
					szEtcName = ContMain.CmbJob.caption
				else
					szEtcName = ""
				end if
				Form.OpenPopup("mbbdm86161_p2" , szEtcName , "")
			end if
			
			ContMain.edtCompany.visible = true
		end if
		
		ContMain.SetScrollAutoSize()
		
		f_CheckNextEnable()
	
	'기타 직업명 직접입력 리턴
	elseif sKeyName == "mbbdm86161_p2" and sRet <> "" and sRet <> null then
		ContMain.CmbJob.caption = sRet
		
		f_CheckNextEnable()		
	
	'투자성향등록 리턴
	elseif sKeyName == "MBBDM86170" then
		If sRet == "ok" Then
		   User_Invt_Proc()
		   DATAMANAGER.RequestTranData("obaci_acct_059c")
	   
	   '투자성향 진행중 계좌개설 중단
	   ElseIf sRet == "abort" then
			Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
			
			if Form.GetSharedData("&OS_TYPE", false) == "2" then
				Form.SetTimerEvent2(30, 1, 0.1)
			else
				Form.OpenNextPopup("mbbdm85100", "", "")
			end if
		   
        Else
            '투자성향진단 비정상종료와 부적합(적정성보고서) 비정상종료 분리
            If sRet == "unfit_fail" Then
                Form.ShowAlert("알림", "[투자성향 대비 고위험거래 가입확인],\n[투자성상품 적정성 판단 보고서확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                'Form.ShowAlert("알림", "[투자성상품 적정성 판단 보고서확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")		
                BtnNext.enable = true
                BtnNext.btnimage = "btn_20.9"
                BtnNext.fgcolor = "273"		
                Exit Sub
		   '투자권유 희망 확인서 미처리에 따른 진행불가 알럿	
            ElseIf sRet == "hopeRecInv_fail" Then
                Form.ShowAlert("알림", "[투자권유 희망 여부 확인],\n[투자권유 희망 여부 확인서 확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                'Form.ShowAlert("알림", "[투자권유 희망 여부 확인서 확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                BtnNext.enable = true
                BtnNext.btnimage = "btn_20.9"
                BtnNext.fgcolor = "273"			
                Exit Sub	
            Else
                'TEST용 SKIP 종료
                'Form.MsgBox("알림", "투자성향 진단이 올바르게 처리되지 않았습니다.\n계속 진행하시겠습니까?", "Invt_Error", "2")  '2.예/아니오
                Form.ShowAlert("알림", "투자성향 진단이 올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                BtnNext.enable = true
                BtnNext.btnimage = "btn_20.9"
                BtnNext.fgcolor = "273"			
                Exit Sub
            End If
		    
        End If
		
	End If
End Sub

'============================================================================
Sub ContMain_RadioGroup0_OnClick(nIndex)
	f_CheckNextEnable()
	If nIndex == 0 or nIndex == 1 Then

		If nIndex == 1 Then
		
			ContMain.RadioGroup0.SetResultLabel("1", "error","실제소유자가 아닌 경우에는 계좌개설이 불가합니다.","ContMain")
			ContMain.RadioGroup0.currentindex = -1
			errorFlag = 1
						
			'에러메시지 고려해서 컨트롤 위치 세팅
			if CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 550
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 600
				else
					ContMain.LabStnd.top = 550 + 40
				end if
			else
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 610
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 610 + 80
				else
					ContMain.LabStnd.top = 610 + 40
				end if
			end if 
			
			ContMain.SetScrollAutoSize()
			
			Exit Sub
			
		ElseIf nIndex == 0  Then  

			If errorFlag == 1 Then '최초 nIndex = 0 누른 경우와 nIndex = 1 선택 후 nIndex 눌렀을 때 구분하는 플래그
				'helpmsg Reset
				ContMain.RadioGroup0.SetResultLabel("0", "", "", "ContMain")
				errorFlag = 0
			End If 	
			
			'에러메시지 고려해서 컨트롤 위치 세팅
			if CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 550
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 600
				else
					ContMain.LabStnd.top = 550 + 40
				end if
			else
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 610
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 610 + 80
				else
					ContMain.LabStnd.top = 610 + 40
				end if
			end if 
			
		End If 
		
		ContMain.SetScrollAutoSize()
	End If
End Sub


'============================================================================
' 해외납세자 구분
'============================================================================
Sub ContMain_RadioGroup1_OnClick(nIndex)
	f_CheckNextEnable()
	If nIndex == 0 or nIndex == 1 Then
	
		'(To-Be) 해외납세자의 경우에만 계좌개설가능 하므로, InBlock 삭제
		If nIndex == 1 Then
			
			ContMain.RadioGroup1.SetResultLabel("1", "error","해외납세자는 가까운 영업점을 내방하여\n 계좌 개설해 주시기 바랍니다.","ContMain")
			ContMain.RadioGroup1.currentindex = -1
			errorFlag1 = 1
			succFlag  = 0
			
			'에러메시지 고려해서 컨트롤 위치 세팅
			if CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 550
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 600
				else
					ContMain.LabStnd.top = 550 + 40
				end if
			else
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 610
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 610 + 80
				else
					ContMain.LabStnd.top = 610 + 40
				end if
			end if 
			
			ContMain.SetScrollAutoSize()
			
			Exit Sub
			
		ElseIf nIndex == 0 and succFlag <> 1 Then  
			
			If errorFlag1 == 1 Then '최초 nIndex = 0 누른 경우와 nIndex = 1 선택 후 nIndex 눌렀을 때 구분하는 플래그
				'helpmsg Reset
				ContMain.RadioGroup1.SetResultLabel("0", "", "", "ContMain")
				errorFlag1 = 0
			End If 
			
			'에러메시지 고려해서 컨트롤 위치 세팅
			if CInt(gLRDV_CODE) == 4 or CInt(gLRDV_CODE) == 5 or CInt(gLRDV_CODE) == 6 or CInt(gLRDV_CODE) == 7 then
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 550
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 600
				else
					ContMain.LabStnd.top = 550 + 40
				end if
			else
				if errorFlag == 0 and errorFlag1 == 0 then
					ContMain.LabStnd.top = 610
				elseif errorFlag == 1 and errorFlag1 == 1 then
					ContMain.LabStnd.top = 610 + 80
				else
					ContMain.LabStnd.top = 610 + 40
				end if
			end if 
			
			ContMain.SetScrollAutoSize()
		End If 	
	End If
End Sub

