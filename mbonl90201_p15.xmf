'2024.06.25. 박윤경 : v001. 예금자보호 문구 변경
'============================================================================
' 화 면 명 : 장외채권 투자위험및불이익팝업
'============================================================================

Dim g_szReturnKey

'============================================================================
Sub Form_OnFormInit()
	lblInfo1.changeTextAttr(32, 41, 10, -2, false)
	lblInfo2.changeTextAttr(38, 37, 10, -2, false)
	'lblInfo3.changeTextAttr(19, 19, 10, -2, false)
	lblInfo3.changeTextAttr(19, 10, 10, -2, false)	'v001
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl90201_p15" , g_szReturnKey)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szReturnKey = "cancel"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_szReturnKey = "ok"
	Form.CloseForm()	
End Sub

