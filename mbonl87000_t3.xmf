'============================================================================
' 01. 화 면 명 : 알리미서비스_Email알리미
' 02. 화면설명 : 알리미서비스_Email알리미
' 03. 작    성 : 2016.01.18 ~ 최지희
' 04. 수    정 : 2018.11.29 : 윤유정 : 오프라인 주문체결 알리미 약정 관련 화면수정 v0001
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szAccountNumber	'계좌번호 8글자
Dim g_szAccountSerialNumber	'계좌일련번호 2글자
Dim g_szAccountPassword	'계좌 비밀번호

Dim g_szPros, g_szSVCD, g_szAPRV
Dim g_szEmailpros, g_szEmailSVCD, g_szEmailAPRV
Dim g_szARCD, g_szTONO, g_szCPNO
Dim g_szInagTypeCode, g_szInagSrno

Dim g_szCheckOne, g_szCheckTwo ', g_szCheckThree 'v0001


'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' BtnEnrollEnable
'============================================================================
Function BtnEnrollEnable()
	Dim szTemp
	szTemp = 0
	
	if g_szCheckOne <> "0" then
		szTemp = szTemp + 1
	end if
	
	if g_szCheckTwo <> "0" then
		szTemp = szTemp + 1
	end if
	
'	if g_szCheckThree <> "0" then 'v0001
'		szTemp = szTemp + 1
'	end if
	
	btnEnroll.enable = true
'	if szTemp <> 0 then
'		btnEnroll.enable = true
'	else
'		btnEnroll.enable = false
'	end if
	
End Function


'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_acif_000r" then		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		if g_szAccountPassword <> "" then
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_000r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
		end if
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	end if
	
	if szTranID == "obpds_srvc_241r" then	'계좌단위 알리미 조회		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_241r", "InBlock1", "SVC_MANG_UNIT_CODE", 0 , "02")	'기본값셋팅
		DATAMANAGER.SetDataValue(0, "obpds_srvc_241r", "InBlock1", "PROS_CLS" , 0 , "1")			'기본값셋팅
		DATAMANAGER.SetDataValue(0, "obpds_srvc_241r", "InBlock1", "SVCD" , 0 , "049")	'이메일서비스코드
		DATAMANAGER.RequestTranData("obpds_srvc_241r")
	end if
	
	if szTranID == "obpds_srvc_323r" then	'이메일일때 hts-mts용 서비스 내역 조회
		if Container0.Label21.caption <> "01" then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
			DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO"  , 0 , "%")	'계좌일련번호
		else
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" , 0 , "%")	'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" , 0 , "%")	'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , Container0.Label17.caption)	'고객번호
		end if
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_323r", "InBlock1", "SVCD", 0 , "049")	'기본값셋팅(서비스코드)
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	end if
	
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회tr
		DATAMANAGER.SetDataValue(0, "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obpds_srvc_070r")
	end if
	
	
	if szTranID == "obpds_srvc_342r" then	'이메일 약정대상 이메일 주소
		Dim szCSNM
		szCSNM = DATAMANAGER.GetDataValue(0,  "obpds_srvc_070r", "OutBlock1", "CSNM", 0)	'고객명
		DATAMANAGER.SetDataValue(0, "obpds_srvc_342r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_342r", "InBlock1", "CSNM", 0 , szCSNM)
		DATAMANAGER.RequestTranData("obpds_srvc_342r")
	end if
	
	
	if szTranID == "obpds_srvc_341r" then	'알리미 이메일 발송목록조회
		DATAMANAGER.ClearInputData(0, "obpds_srvc_341r")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_341r", "InBlock1", "INAG_TYPE_CODE" , 0 , g_szInagTypeCode)	'통보처유형코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_341r", "InBlock1", "INAG_SRNO", 0 , g_szInagSrno)	'통보처일련번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_341r", "InBlock1", "CSNO" , 0 , Container0.Label17.caption)	'고객번호
		DATAMANAGER.SetDataValue(0,"obpds_srvc_341r", "InBlock1", "SVCD"  , 0 , "049")	'서비스코드
		DATAMANAGER.SetDataValue(0,"obpds_srvc_341r", "InBlock1", "SVC_SRNO" , 0 , Container0.Label23.caption)	'이메일서비스일련번호
		DATAMANAGER.RequestTranData("obpds_srvc_341r")
	end if
	
	if szTranID == "obpds_srvc_339a" then	'알리미이메일약정
	
		DATAMANAGER.ClearInputData(0, "obpds_srvc_339a")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "PROS_CLS_CODE" ,  0, g_szEmailPros)	'처리구분코드		
		Dim nTempCnt		
		nTempCnt = 0
		
		if g_szCheckOne <> "0" then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock2", "INAG_TYPE_CODE" , nTempCnt , g_szInagTypeCode)	'통보처유형코드
			DATAMANAGER.SetDataValue(0,"obpds_srvc_339a", "InBlock2", "INAG_SRNO"  , nTempCnt , g_szInagSrno)	'통보처일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD", nTempCnt , "32")	'sms통보업무세부구분코드
			nTempCnt = nTempCnt + 1
		end if
		
		if g_szCheckTwo <> "0" then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock2", "INAG_TYPE_CODE" , nTempCnt , g_szInagTypeCode)	'통보처유형코드
			DATAMANAGER.SetDataValue(0,"obpds_srvc_339a", "InBlock2", "INAG_SRNO"  , nTempCnt , g_szInagSrno)	'통보처일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD", nTempCnt , "30")	'sms통보업무세부구분코드
			nTempCnt = nTempCnt + 1
			
		end if
		
'		if g_szCheckThree <> "0" then 'v0001		 	
'			DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock2", "INAG_TYPE_CODE" , nTempCnt , g_szInagTypeCode)	'통보처유형코드
'			DATAMANAGER.SetDataValue(0,"obpds_srvc_339a", "InBlock2", "INAG_SRNO"  , nTempCnt , g_szInagSrno)	'통보처일련번호
'			DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD", nTempCnt , "37")	'sms통보업무세부구분코드
'			nTempCnt = nTempCnt + 1
'		end if	
		
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "SVCD" , 0 , "049")	'서비스코드(기본값셋팅)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "CONT_CLS_CODE" , 0 , "4")	'접촉구분코드(기본값셋팅)
		
		Dim szCCC
		szCCC = DATAMANAGER.GetDataValue(0,"obpds_srvc_070r", "OutBlock1", "CUST_CLS_CODE"  , 0)	'고객구분코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "CUST_CLS_CODE" , 0 , szCCC)	'고객구분코드
		Dim szCGC
		szCGC = DATAMANAGER.GetDataValue(0,  "obpds_srvc_070r", "OutBlock1", "CUST_GRAD_CODE", 0)	'고객등급코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "CUST_GRAD_CODE" , 0 , szCGC)	'고객등급코드	
		
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "ACNO" ,0, g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "ACNT_PWD" , 0 , g_szAccountPassword)	'계좌비밀번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "CSNO" , 0 , Container0.Label17.caption)	'고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_339a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 ,Container0.Label21.caption )	'서비스관리단위코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_339a", "InBlock1", "SVC_SRNO", 0 , Container0.Label23.caption)	'서비스일련번호
		DATAMANAGER.RequestTranData("obpds_srvc_339a")
		
	end if
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
	BtnEnrollEnable()
	Dim szList
	
	chkEmailOne.checkstate = "0"
	chkEmailTwo.checkstate = "0"
	'chkEmailThree.checkstate = "0" 'v0001
	
	szList = Split(sParam, "★")	'계좌번호, 일련번호, 비밀번호	
	if sEventName == "AccountData" then
		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) == "" then
			g_szAccountPassword = ""
		else
			g_szAccountPassword = szList(2)
		end if
		
		btnSearch_OnClick()
	end if
	
	
	
	if sEventName == "PASSWORD" then		
		g_szAccountPassword = sParam		
	end if
	
	
End Sub

'============================================================================
' btnSearch_OnClick
'============================================================================
Sub btnSearch_OnClick()
	btnEnroll.enable = false
	Call TR_Inquiry("obcsb_acif_000r")	'고객정보조회
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_000r" then	'고객정보조회
		TR_Inquiry("obpds_srvc_241r")
	end if
	
	if szTranID == "obpds_srvc_241r" then	'계좌단위알리미조회
		if DATAMANAGER.GetDataCount(0, "obpds_srvc_241r", "OutBlock1") <> 0 then
			Container0.Label18.caption = "계좌"	'서비스단위
			Container0.Label21.caption = "02"	'서비스관리단위
		else
			if Container0.LblCorp.caption == "2" then
				Container0.Label18.caption = "계좌"	'서비스단위
				Container0.Label21.caption = "02"	'서비스관리단위
			else
				Container0.Label18.caption = "고객"	'서비스단위
				Container0.Label21.caption = "01"	'서비스관리단위
			end if
			
		end if
		
		Call TR_Inquiry("obpds_srvc_323r")		
	end if
	
	if szTranID == "obpds_srvc_323r" then	'이메일일때 hts-mts용 서비스 내역조회
		g_szEmailSVCD = DATAMANAGER.GetDataValue(0,  "obpds_srvc_323r", "OutBlock1", "SVC_SRNO", 0)	'이메일 서비스일련번호
		g_szEmailAPRV = DATAMANAGER.GetDataValue(0,  "obpds_srvc_323r", "OutBlock1", "APRV_YN", 0)	'이메일 승인여부
		
		if g_szEmailAPRV == "Y" then
			Container0.Label23.caption = g_szEmailSVCD
			Form.MsgBox("알림", "현재 알리미 서비스 신규등록중이므로 변경하실 수 없습니다.", "", 0)
		elseif g_szEmailAPRV == "N" then
			if g_szEmailSVCD <> "" then
				g_szEmailPros = "U"
			end if
			Container0.Label23.caption = g_szEmailSVCD
		else
			if g_szEmailSVCD == "00000000000" then
				g_szEmailPros = "I"
				Container0.Label23.caption = g_szEmailSVCD
			end if			
		end if
		Call TR_Inquiry("obpds_srvc_070r")
	end if
	
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회tr
		Call TR_Inquiry("obpds_srvc_342r")
	end if
	
	
	if szTranID == "obpds_srvc_342r" then	'이메일 약정대상 이메일 주소
		for i=0 to DATAMANAGER.GetDataCount(0, "obpds_srvc_342r", "OutBlock1")-1
			if DATAMANAGER.GetDataValue(0, "obpds_srvc_342r", "OutBlock1", "RPRS_YN_CLS_CODE" , i) == "Y" then
				g_szInagTypeCode = DATAMANAGER.GetDataValue(0, "obpds_srvc_342r", "OutBlock1", "INAG_TYPE_CODE" , i)	'통보처유형코드
				g_szInagSrno = DATAMANAGER.GetDataValue(0, "obpds_srvc_342r", "OutBlock1", "INAG_SRNO" , i)	'통보처일련번호
				Container0.lblEmail.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_342r", "OutBlock1", "EMAIL_ADDR" , i)
				
			end if
		next
		
		lblEmail.caption = Container0.lblEmail.caption
		TR_Inquiry("obpds_srvc_341r")	'알리미 이메일 발송목록조회
	end if
	
	if szTranID == "obpds_srvc_341r" then		'알리미 이메일 발송목록조회	
		g_szCheckOne="0"
		g_szCheckTwo="0"
		'g_szCheckThree="0" 'v0001
		for i=0 to DATAMANAGER.GetDataCount(0, "obpds_srvc_341r", "OutBlock1")-1
			Select Case DATAMANAGER.GetDataValue(0, "obpds_srvc_341r", "OutBlock1", "SMS_INFR_BSWR_DETL_CLCD" , i)
			Case "32"
				chkEmailOne.checkstate = "1"
				g_szCheckOne = chkEmailOne.checkstate
			Case "30"
				chkEmailTwo.checkstate = "1"
				g_szCheckTwo = chkEmailTwo.checkstate
'			Case "37" 'v0001
'				chkEmailThree.checkstate = "1"
'				g_szCheckThree = chkEmailThree.checkstate
			End Select
		next		
		
		btnEnroll.enable = false
		
	end if
	
	if szTranID == "obpds_srvc_339a" then	'알리미이메일약정		
		if g_szEmailPros == "D" then	'해지버튼 클릭시 멘트 구분 16-03-23 YCJ 수정
			Form.ShowAlert( "알림" , "E-mail알리미 서비스 해지가 완료되었습니다.")
		else
			Form.MsgBox("알림", "E-mail알리미 서비스 신청이 완료되었습니다.", "", 0)
		end if
		TR_Inquiry("obcsb_acif_000r")
		btnEnroll.enable  = false
	end if
	
End Sub

'============================================================================
' btnEnroll_OnClick
'============================================================================
Sub btnEnroll_OnClick()
	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	
	TR_Inquiry("obpds_srvc_339a")	'알리미 이메일 약정
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obpds_srvc_339a" THEN
		Form.ShowAlert("알림", szErrMsg)
	end if
	
	if szTranID == "obcsb_acif_000r" then
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub


'============================================================================
'chkEmailOne_OnChange
'============================================================================
Sub chkEmailOne_OnChange(sCheckState)	
	g_szCheckOne = sCheckState	
	BtnEnrollEnable()
End Sub


'============================================================================
' chkEmailTwo_OnChange
'============================================================================
Sub chkEmailTwo_OnChange(sCheckState)
	g_szCheckTwo = sCheckState
	BtnEnrollEnable()
End Sub


'============================================================================
' chkEmailThree_OnChange
'============================================================================
'Sub chkEmailThree_OnChange(sCheckState) 'v0001
'	g_szCheckThree = sCheckState
'	BtnEnrollEnable()
'End Sub


'============================================================================
' btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if

	Form.MsgBox("알림", "E-Mail 알리미 서비스 약정을 해지하시겠습니까?", "btnCancelOK", 1)
End Sub


'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "btnCancelOK" then
		if sRet == "ok" then
			if g_szEmailAPRV <> "" then
				g_szEmailPros = "D"
				Call TR_Inquiry("obpds_srvc_339a")	'알리미 이메일 약정
				
				chkEmailOne.checkstate = "0"
				chkEmailTwo.checkstate = "0"
				'chkEmailThree.checkstate = "0" 'v0001
				btnSearch_OnClick()
			end if
		else
			Form.MsgBox("알림", "해지 신청이 취소되었습니다.", "", 0)			
		end if	
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	btnEnroll.enable = false
	
End Sub

