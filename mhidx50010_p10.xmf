'============================================================================
Sub lblMore0_OnClick()									'상승업종
	if CInt(fmtab0.currenttab) = 0 then
		Form.OpenScreen("42000" , "0★KGG01P★0★UP")		'코스피
	elseif CInt(fmtab0.currenttab) = 1 then
		Form.OpenScreen("42000" , "0★QGG01P★1★UP")		'코스닥
	end if
End Sub

'============================================================================
Sub lblMore1_OnClick()									'하락업종
	if CInt(fmtab0.currenttab) = 0 then
		Form.OpenScreen("42000" , "0★KGG01P★0★DOWN")	'코스피
	elseif CInt(fmtab0.currenttab) = 1 then
		Form.OpenScreen("42000" , "0★QGG01P★1★DOWN")	'코스닥
	end if
End Sub

'============================================================================
Sub PannelUp0_OnClick(nIndex, sCellID)
	szCode = PannelUp0.GetCellValue("lblCode",nIndex)
	if Trim(szCode) <> "" then
		Form.OpenScreen("42000" , "2★"..szCode)	'종목구성탭
	end if
End Sub

