'============================================================================
' 01. 화 면 명 : HOME_업계동향
' 02. 화면설명 : 업계동향_국내
' 03. 작    성 : 
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szMarket

' 수치값
Dim g_nGap
g_nGap = 3


'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	Image3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		fmtab0.setTabDefaultImage("tab_03_o.9","alpha.9")
	else
		fmtab0.setTabHeaderImage("tab_00_o.9","alpha", 0)
	end if
	
	nCurrentTab = 0
	fmtab0.currenttab = nCurrentTab
	
	call fmtab0_OnTabChanged(nCurrentTab)

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'msgbox szTranID
	if	szTranID	=	"ohhts_1511_001r"	then
		DATAMANAGER.ClearInputData(0, "ohhts_1511_001r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "U")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0 , "1511")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE",0 , g_szMarket)
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE",0 , "01")	'등락률 상위정렬 & 등락률 +,0 종목만 조회
	elseif	szTranID	=	"ohhts_1511_001r_1"	then
		DATAMANAGER.ClearInputData(0, "ohhts_1511_001r_1")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "U")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r_1", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0 , "1511")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r_1", "InBlock1", "FID_INPUT_MRKT_CLS_CODE",0 , g_szMarket)
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r_1", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE",0 , "02")	'등락률 하위정렬 & 등락률 - 종목만 조회
	end	if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
	end if	
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	if CInt(nCurrentTab) = 0 then
		g_szMarket	="K"
	elseif CInt(nCurrentTab) = 1 then
		g_szMarket	="Q"
	else
		g_szMarket	=""
	end	if
	
	TR_Before()
	TR_Request()
End Sub

'============================================================================
Sub TR_Request()
	'영업일 장시작 전 조회서비스 호출 안함
	Dim szBizDt, szToday, szBizTime, szNowTime
	szBizDt = Form.GetSharedData("&BIZ_DT", false)
	szToday = Form.GetSharedData("&HOST_DATE", false)
'	szBizTime = Form.GetSharedData("&BIZ_START_TIME", false)
	szBizTime = "090000"	'테스트용
	szNowTime = Form.GetSharedData("&HOST_TIME", false)
	
	if Trim(szBizDt) == Trim(szToday) then
		if CLng(szNowTime) < CLng(szBizTime) then
			DATAMANAGER.RequestRealData("ohhts_whol_mkop")	'장 운영 실시간 호출
			msgbox "request"
			exit Sub 
		end if
	end if
	
	'등락률 상위, 하위 조회
	DATAMANAGER.RequestTranData("ohhts_1511_001r")
'	DATAMANAGER.RequestTranData("ohhts_1511_001r_1")
End Sub

'============================================================================
Sub TR_Before()
	grdMain01T1.SetClear()
	grdMain01T0.SetClear()
	grdMain01T1.rowcount = 0
	grdMain01T0.rowcount = 0
	
	PannelUp0.rowcount = 0
	PannelUp1.rowcount = 0
	PannelDown0.rowcount = 0
	PannelDown1.rowcount = 0
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID = "ohhts_whol_mkop" then
		szMkCode = DATAMANAGER.GetDataValue(1, szTranID , "OutBlock1" , "FIDR_MKOP_TRNM_CODE" , 0)
		
		'test
		Label1.caption =  szMkCode
		
		if szMkCode = "P100" then	'장 시작 시, 서비스 조회
			DATAMANAGER.RequestTranData("ohhts_1511_001r")
			DATAMANAGER.RequestTranData("ohhts_1511_001r_1")
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	IF szTranID = "ohhts_1511_001r" then
		DATAMANAGER.RequestTranData("ohhts_1511_001r_1")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	msgbox szTranID
	if szTranID = "ohhts_1511_001r" then		'등락률 상위 조회
		dim nCntUp, nCntUp0, nTemp
		dim szCode, szName, szData
		
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
		
		nCntUp  = CDBl(DATAMANAGER.GetDataCount(0, "ohhts_1511_001r" , "OutBlock1"))
		nCntUp0 = 0
		grdMain01T1.rowcount = nCntUp		'상승 개수

		if CInt(nCntUp) > 1 then
			nTemp = CInt(nCntUp / 2)
			nCntUp0 = nCntUp - nTemp
			nCntUp = nTemp
		end if
		
		'상승판넬 세팅
		for i = 0 to CInt(nCntUp)-1
			szCode = grdMain01T1.GetCellData("bd_code", i)
			szName = grdMain01T1.GetCellData("bd_name", i)
			szData = grdMain01T1.GetCellData("bd_data", i)

			UIsetting_Up0(i, szCode, szName, szData)		'상승판넬 위
		next
		for j = CInt(nCntUp) to CInt(grdMain01T1.rowcount)-1
			szCode = grdMain01T1.GetCellData("bd_code", j)
			szName = grdMain01T1.GetCellData("bd_name", j)
			szData = grdMain01T1.GetCellData("bd_data", j)

			UIsetting_Up1(j, szCode, szName, szData)		'상승판넬 아래
		next
		
		'실시간 데이터 호출
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")
'		msgbox "complete"
		
	elseif szTranID = "ohhts_1511_001r_1" then	'등락률 하위 조회
		dim nCntDown, nCntDown0, nTemp
		dim szCode, szName, szData
		
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg_2")
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg_3")
		
		nCntDown  = CDBl(DATAMANAGER.GetDataCount(0, "ohhts_1511_001r_1" , "OutBlock1"))
		nCntDown0 = 0
		grdMain01T0.rowcount = nCntDown		'하락 개수

		if CInt(nCntDown) > 1 then
			nTemp = CInt(nCntDown / 2)
			nCntDown0 = nCntDown - nTemp
			nCntDown = nTemp
		end if
		
		'하락판넬 세팅
		for i = 0 to CInt(nCntDown)-1
			szCode = grdMain01T0.GetCellData("bd_code", i)
			szName = grdMain01T0.GetCellData("bd_name", i)
			szData = grdMain01T0.GetCellData("bd_data", i)

			UIsetting_Down0(i, szCode, szName, szData)	'하락판넬 위
		next
		for j = CInt(nCntDown) to CInt(grdMain01T0.rowcount)-1
			szCode = grdMain01T0.GetCellData("bd_code", j)
			szName = grdMain01T0.GetCellData("bd_name", j)
			szData = grdMain01T0.GetCellData("bd_data", j)

			UIsetting_Down1(j, szCode, szName, szData)	'하락판넬 아래
		next
		
		'실시간 데이터 호출
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg_2")
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg_3")
		
	end if 

End Sub

'============================================================================
Function UIsetting_Up0(nIndex, szCode, szName, szData)
	'판넬 데이터 세팅
	PannelUp0.AddRow()
	PannelUp0.setPropCardCell("paddinginfo","lblName",nIndex,"10,0,0,0")
	PannelUp0.setPropCardCell("paddinginfo","lblData",nIndex,"0,0,0,0")
			
	PannelUp0.setPropCardCell("caption","lblName",nIndex, szName)
	PannelUp0.setPropCardCell("caption","lblData",nIndex, szData)
			
	nNameWidth = CDBl(Form.getTextWidth(szName, -2, false, false)) + 10
	nDataWidth = CDBl(Form.getTextWidth(szData, -2, true, true))
	PannelUp0.setPropCardCell("width", "lblName", nIndex, nNameWidth)
	PannelUp0.setPropCardCell("left", "lblData", nIndex, nNameWidth + g_nGap)
	PannelUp0.setPropCardCell("width", "imgbg", nIndex, nNameWidth + nDataWidth - 13)
	PannelUp0.SetCardWHAt(nIndex, nNameWidth + nDataWidth - 8)
			
	'실시간 인블럭 세팅
	PannelUp0.SetCellValue("lblCode", nIndex, szCode)
	DATAMANAGER.SetDataValue(1,"ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIndex, szCode)
	
End Function

'============================================================================
Function UIsetting_Up1(nIndex, szCode, szName, szData)
	'판넬 데이터 세팅
	PannelUp1.AddRow()
	nIndex = CInt(PannelUp1.rowcount) -1
	PannelUp1.setPropCardCell("paddinginfo","lblName",nIndex,"10,0,0,0")
	PannelUp1.setPropCardCell("paddinginfo","lblData",nIndex,"0,0,0,0")
			
	PannelUp1.setPropCardCell("caption","lblName",nIndex, szName)
	PannelUp1.setPropCardCell("caption","lblData",nIndex, szData)
			
	nNameWidth = CDBl(Form.getTextWidth(szName, -2, false, false)) + 10
	nDataWidth = CDBl(Form.getTextWidth(szData, -2, true, true))
	PannelUp1.setPropCardCell("width", "lblName", nIndex, nNameWidth)
	PannelUp1.setPropCardCell("left", "lblData", nIndex, nNameWidth + g_nGap)
	PannelUp1.setPropCardCell("width", "imgbg", nIndex, nNameWidth + nDataWidth - 13)
	PannelUp1.SetCardWHAt(nIndex, nNameWidth + nDataWidth - 8 )
			 
	'실시간 인블럭 세팅
	PannelUp1.SetCellValue("lblCode", nIndex, szCode)
	DATAMANAGER.SetDataValue(1,"ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", nIndex, szCode)
	
End Function

