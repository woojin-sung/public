					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="대차중개 약정 등록과 동시에 계좌 내 출고가능한 증권은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,1" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="대여풀에 편입되므로, 특정 종목의 대여제한을 위해서는" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="고객대여 불가종목을 지정하셔야 합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,3,1,3" line="0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="대여내역이 있을 경우 온라인 직접조회를 신청한 고객은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,5,0,5" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="온라인채널, 영업점 전산을 통해 대여거래내역을 수시로" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,6,0,6" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="열람 가능하며, SMS 수신 동의 고객께는 SMS로" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,7,0,7" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="통보합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,8,0,8" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="대차거래 통보방법은 종합계좌단위로 최종 설정하신" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,9,0,9" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="방법으로 관리됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,10,0,10" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,10,1,10" line="0,0" impidxs="" />
						<CELL cell_ly="0,11,0,11" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="대여 체결 시 대여잔고로 전환되어 계좌에서 출고 및" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,12,0,12" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="차입자에게 대여됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,13,0,13" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,13,1,13" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,14,0,14" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="대여 수수료율은 해당 종목의 시장동향 및 대차중개" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,15,0,15" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="시장동향 등에 따라 결정됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,16,0,16" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,16,1,16" halign="0" line="0,0" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,17,0,17" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="당사는 이 금융투자상품 및 서비스에 관하여 충분히" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,18,0,18" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="설명할 의무가 있으며, 투자자는 투자에 앞서 그러한 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,19,0,19" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,19,1,19" halign="0" line="0,0" caption="설명을 충분히 들으시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,20,0,20" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,20,1,20" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,21,0,21" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="이 금융투자상품은 예금자보호법에 따라 예금보험공사" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,22,0,22" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,22,1,22" halign="0" line="0,0" caption="가 보호하지 않습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,23,0,23" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,23,1,23" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,24,0,24" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="이 금융투자상품은 투자 결과 원금의 손실이 발생할 수" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,25,0,25" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,25,1,25" halign="0" line="0,0" caption="있으며, 그 손실은 투자자에게 귀속됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,26,0,26" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,26,1,26" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,27,0,27" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,27,1,27" halign="0" line="0,0" caption="대차중개 서비스를 통해 대여된 주식은 매매 거래의" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,28,0,28" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,28,1,28" halign="0" line="0,0" caption="결제, 차익 헤지 거래, 공매도 등 다양한 투자전략 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,29,0,29" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="목적으로 활용될 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,30,0,30" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,30,1,30" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,31,0,31" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,31,1,31" halign="0" line="0,0" caption="사고 등록 계좌, 미수 계좌, 대용 지정 계좌, 선물증거금 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,32,0,32" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,32,1,32" halign="0" line="0,0" caption="연계 계좌, 저축계좌, 현금 계좌 중 보호예수 설정 계좌 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,33,0,33" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,33,1,33" halign="0" line="0,0" caption="등은 본 서비스를 이용할 수 없습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,34,0,34" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,34,1,34" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,35,0,35" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,35,1,35" halign="0" line="0,0" caption="대여 상환 신청은 08:00 ~ 정규장 마감 시 까지 상환 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,36,0,36" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,36,1,36" halign="0" line="0,0" caption="신청 가능하며 거래 정지 발생 사유로 지정된 종목은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,37,0,37" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,37,1,37" halign="0" line="0,0" caption=" 거래 정지 해제 후 상환 신청이 가능합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,38,0,38" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,38,1,38" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,39,0,39" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,39,1,39" halign="0" line="0,0" caption="대여 중인 주식은 의결권, 반대의사, 매수청구 및 공개" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,40,0,40" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,40,1,40" halign="0" line="0,0" caption="매수청구권 등의 행사가 불가능하오니 이사회결의 공시" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,41,0,41" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,41,1,41" halign="0" line="0,0" caption="익영업일 오전 11시까지 상환 신청을 하시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,42,0,42" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,42,1,42" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,43,0,43" line="0,0" caption="ㆍ" fontsize="5" impidxs="" />
						<CELL cell_ly="1,43,1,43" halign="0" line="0,0" caption="대여 주식에 의한 배당 수익에는 배당 소득세가, 대여" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,44,0,44" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,44,1,44" halign="0" line="0,0" caption="수수료 수익에는 기타 소득세가 적용되어 이를 원청징수" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,45,0,45" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,45,1,45" halign="0" line="0,0" caption="한 후 지급됩니다. 기타 소득이 연간 300만원을 초과하는" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,46,0,46" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,46,1,46" halign="0" line="0,0" caption="경우, 종합과세 대상에 포함되므로 개별 소득 신고하셔야" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,47,0,47" line="0,0" fontsize="5" impidxs="" />
