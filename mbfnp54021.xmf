Sub ImgBackPress_OnClick()
	szPrevScr = Form.GetSharedData("&PREV_SCREEN_NO", false )	'직전화면번호
	szBondTab = Form.GetSharedData("mbonl90000_TAB", false )	'BONDHOME 화면오픈 관련
	if szPrevScr = "54100" or szPrevScr = 54100 then
		Form.OpenScreen(szPrevScr , szBondTab)
	else
		Form.OpenPrevScreen()
	end if
End Sub

