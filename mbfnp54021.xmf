Sub rdoHoga_OnClick(nIndex)
    if nIndex = 0 then		'호가
		 g_szSlt = "HOGA"
		 grdList.left = 700
		 hogaTbl.left = 0
		 grdList.visible = false
	else					'체결
		 g_szSlt = "SISE"
		 grdList.visible = true
		 grdList.left = 0
		 hogaTbl.left = 700
	end if
End Sub

