'============================================================================
Sub ItmCode_OnEditComplete(sCode)
	szMstChk = Form.GetItemCodeInfo(g_szCd, "name")	'마스터파일 체크
	If Trim(szMstChk) = "" then
		g_szCd = ""
		exit sub
	end if
	
	g_szCd = sCode
	szInnerMarket = Form.GetSharedData(g_szCd, false )
	g_szGp = fn_TypeGubun(szInnerMarket)
	
	if g_szFromTag == "popp" then
		g_szParamInitCode = g_szGp & "★" & g_szCd
	end if
	
	Request_Hoga()
	Form.triggerEvent("linkfmBond", "종류구분", g_szGp & "★" & g_szCd)
	Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szParamInitCode)

	g_szFromTag = "popp";
End Sub 

