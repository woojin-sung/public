Sub acc_ChangeAccount()
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwd.caption = ""
		edtPwdIcon.imgpath = "icon_save_password_n.9"
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	Form.SetSharedData("BOND_ORDER_ACC" , acc.caption)	'채권주문_가격입력창 서비스 조회용
	Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "ACNT_CHANGE", "")	' 폼탭화면에 계좌변경 이벤트 던지기
End Sub
