'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	ItmCode.itemtype = "7"
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	fmtabTbond.setTabHeaderFgColorWithIndex(0,290,110)
	fmtabTbond.setTabHeaderFgColorWithIndex(1,291,110)
	fmtabTbond.setTabHeaderFgColorWithIndex(2,292,110)
	fmtabTbond.setTabHeaderFgColorWithIndex(3,49,110)
	fmtabTbond.setTabHeaderFgColorWithIndex(4,49,110)
	
	fmtabTbond.setTabHeaderImageWithIndex(0,"tab_04_o.9","tab_03_n.9")
	fmtabTbond.setTabHeaderImageWithIndex(1,"tab_05_o.9","tab_03_n.9")
	fmtabTbond.setTabHeaderImageWithIndex(2,"tab_06_o.9","tab_03_n.9")
	
	hogaTbl.setRateColor(69,69,69)
	hogaTbl0.setRateColor(69,69,69)
	hogaTbl.SetHogaRect("1")
	hogaTbl0.SetHogaRect("1")
	cont0.lblName.setUseAutoScroll(True, 30, True)
	ItmCode.setEnableHistory("1")					'iOS - ITEMCODE 컨트롤에 HISTORY 적용
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")	' 원주문번호 자동입력
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if

	Form.SetSharedData("BOND_ORDER_ACC" , acc.caption)	'채권주문_가격입력창 서비스 조회용
	
	'20240712 HSZ START: 매크로주문 긴급대응
	szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	if CInt(szAfterInit) = 0 and trim(szAfterInit) <> "" then
		saveDate = Form.LoadConfigData("mbfnp54021", "AFTERINIT_NOTICE")
		todayDate = Form.GetSharedData("&HOST_DATE",0)
		
		szText = "'주문 후 가격/수량 초기화'설정을 해제한 후 과도한 주문을 발생시키는 경우가 발생하여 부득이하게 해당 기능을 차단하게 되어 안내드립니다.\n시스템 과부하로 전체 고객의 주문지연 현상이 발생하여 진행하는 조치이오니 고객님의 양해 바랍니다."
		
		if saveDate <> "" then
			ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
			RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
			
			calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))
			if calcDate > 0 then
				Form.MsgBox("안내", szText, "AFTERINIT_NOTICE", 7,  "확인", "오늘 하루 보지않기")
			end if
		else
			Form.MsgBox("안내", szText, "AFTERINIT_NOTICE", 7,  "확인", "오늘 하루 보지않기")
		end if
	end if
	'20240712 HSZ END
	 
'	Form.SetSearchType ( "7" )
	szOpen = Form.GetOpenLinkData()
	if szOpen <> "" then
		tData = Split(szOpen, "★")
		
		'화면링크로 진입
		g_szFromTag = "link"

		if #tData > 0 then
		
			'관심종목
			if tData(0) == "관심종목" then
				
				'시장구분이 없어서 구한다.
				Dim szInnerMkt
				g_szCd = tData(2)
				szInnerMkt = Form.GetItemCodeInfo(g_szCd, "innermarket")
				g_szGp = fn_TypeGubun(szInnerMkt)
				g_szParamInitCode = g_szGp & "★" & g_szCd
				
			'채권시세표
			elseif tData(0) == "채권시세표" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				g_szParamInitCode = g_szGp & "★" & g_szCd
			
			'채권호가
			elseif tData(0) == "채권호가" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(4) '호가

			'주문체결
			elseif tData(0) == "주문체결" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				
				'수량, 주문번호, 주문유형, 가격, 주문조건코드
				g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(4) & "★" & tData(5)  & "★" & tData(6)  & "★" & tData(7)  & "★" & tData(8) 
                
			'채권가상매매
			elseif tData(0) == "채권가상매매" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				'가격, 수량
				g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(4) & "★" & tData(5)
				
			'잔고연동
			elseif tData(0) == "채권잔고" then
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				
				'시구분/종목코드/시장구분/수량/매수일자/매수구분
				g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(4) & "★" & tData(5)  & "★" & tData(6)
			end if

			'탭처리
			if Trim(tData(1)) == "" then
				fmtabTbond.currenttab = 0
			else
				fmtabTbond.currenttab = tData(1)
			end if
			
			'일반/소액 저장
			Form.SetSharedData(g_szCd, fn_OrgGubun(g_szGp))
		end if		
	else
		'메뉴에서 진입
		g_szFromTag = "menu"


		Dim szCd, szInnerMkt, szGp
		szCd = Form.GetSharedData("&ITEM_BOND", false )
		
		if Trim(szCd) == ""  then
			g_szCd = ""
			g_szGp = ""
			
			exit sub
		else
			szInnerMarket = Form.GetSharedData(szCd, false )
			szGp = fn_TypeGubun(szInnerMarket)
		
			g_szCd = szCd
			g_szGp = szGp
			
			g_szParamInitCode = g_szGp & "★" & g_szCd
		end if
		
		fmtabTbond.currenttab = 0
	end if
	
	szMstChk = Form.GetItemCodeInfo(g_szCd, "name")	'마스터파일 체크
	If Trim(szMstChk) = "" then
		g_szCd = ""
		exit sub
	end if
	
	if Trim(g_szCd) <> "" then
		ItmCode.code = g_szCd
		Request_Hoga()
		Form.triggerEvent("linkfmBond", "종류구분", g_szParamInitCode)
		Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szParamInitCode)	
	end if

End Sub

