' 20240307 HWG START : 사이드아이템 채권종목 연동기능 추가 
Sub Form_OnTriggerEventSemiScreen(sEventName, sParam)
	if sEventName = "ITEM_CD" then
		
		Dim szCd, szInnerMarket, szGp
		szCd = sParam
		
		if Trim(szCd) == ""  then
			g_szCd = ""
			g_szGp = ""
			
			exit sub
		else
			szInnerMarket = Form.GetItemCodeInfo(szCd, "innermarket")
			if szInnerMarket <> "019" and szInnerMarket <> "020" and szInnerMarket <> "021" then
				exit Sub
			end if
			szGp = fn_TypeGubun(szInnerMarket)
		
			g_szCd = szCd
			g_szGp = szGp
			
			g_szParamInitCode = g_szGp & "★" & g_szCd
		end if
		
		fmtabTbond.currenttab = 0

	
		szMstChk = Form.GetItemCodeInfo(g_szCd, "name")	'마스터파일 체크
		If Trim(szMstChk) = "" then
			g_szCd = ""
			exit sub
		end if
		
		if Trim(g_szCd) <> "" then
			ItmCode.code = g_szCd
			Request_Hoga()
			Form.triggerEvent("linkfmBond", "종류구분", g_szParamInitCode)
			Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szParamInitCode)	
		end if
	end if
End sub
' 20240307 HWG END 

