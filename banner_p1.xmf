<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="배너 팝업" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<CONTAINER name="Container0" vscroll="1" scroll_pos="0,0" ly_vert="0,0,375,647,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<IMAGE name="Image0" autosize="1" imgpath="debit.png" ly_vert="0,0,369,1200,1" />
				<IMAGE name="Image1" imgpath="icon_main_11" ly_vert="341,1,30,28,1" />
				<BUTTON name="Button0" btnimage="alpha" ly_vert="0,1100,400,80,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1814" _ulen="1700" >
'============================================================================
'20210509 SWJ START : 비대면 이벤트 안내 배너 게시
'============================================================================
Dim g_LoginType, g_ScrNum 
'============================================================================
Sub Container0_Image1_OnClick()
	Form.CloseForm()
End Sub

