'============================================================================
Sub Container0_Button0_OnClick()
	if Cint(g_LoginType) > 1 then '로그인상태
		Form.OpenNextPopup("banner_p0","", "")
	else
		Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", 0 )
	g_ScrNum = Form.GetSharedData("&SCREEN_NO",true)
	
	if g_ScrNum == "90100" then
		Container0.Image1.visible = false
		Container0.height = 525
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOG_FORCE" then
		if sRet == "ok" then
			Form.SetSharedData("BDM_CORPORATE", "Y")
			Form.OpenNextPopup("mhetc90021" , "" , "")
		else
			Form.CloseForm()			
		end if	
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>