'============================================================================
Dim g_Flag
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	recv_data = Form.GetOpenLinkData()
	'recv_data = "계좌비밀번호 입력 오류입니다. ★ 1회 오류. 5회 오류시 지점방문 필요 또는 비대면 실명확인 재설정 필요"
	
	tData = Split(recv_data, "★")
	
	'tData[0] = "계좌비밀번호 입력 오류입니다."
	'tData[1] = "1회 오류. 5회 오류시 지점방문 필요 또는 비대면 실명확인 재설정 필요"
	
	
	'Table0.SetCellString( 2, 1, tData[0] )
	Label0.caption =tData[0]
	if UBOUND(tData) < 2  then
		if tData[1] <> "" then
			'Table0.SetCellString( 3, 1, tData[1] )
			Label0.caption =  Label0.caption +"\n"+ tData[1]
		end if
	end if
	
	
'	if tData[0] = "from_mbbdm85183" then
'		Table0.SetCellString( 2, 1, "진행중인 계좌개설건을" )
'		Table0.SetCellString( 3, 1, "삭제하시겠습니까?" )
'		ButtonO.caption = "삭제"
'	else
'		Table0.SetCellString( 2, 1, "업무신청을 중단하시겠습니까?" )
'	end if
	
	
	
	'ButtonC.fgcolor = 269
	Image2.imgpath = "alpha128.png"

End Sub


'============================================================================
Sub ButtonC_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
