'============================================================================
'라디오 인덱스 Disable시 구분이 가지 않아, 테이블 글자색 회색 변경 요청(채화석 차장님)
Sub SetTableForeColor(nIdx)
	sColor = "110"
	
	If nIdx < 4 then
		'고수익지향형
		cont0.tbl0.SetCellFgColor( 6, 6, sColor)
		cont0.tbl0.SetCellFgColor( 7, 6, sColor)
		
'		cont0.tbl0.SetCellFgColor( 11, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 11, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 11, 6, sColor)
'		
'		cont0.tbl0.SetCellFgColor( 13, 1, sColor)
'		cont0.tbl0.SetCellFgColor( 13, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 13, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 13, 6, sColor)
	End If
	
	If nIdx < 3 then
		'성장지향형
		cont0.tbl0.SetCellFgColor( 4, 6, sColor)
		cont0.tbl0.SetCellFgColor( 5, 6, sColor)
		
'		cont0.tbl0.SetCellFgColor( 7, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 7, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 7, 6, sColor)
'		
'		cont0.tbl0.SetCellFgColor( 9, 1, sColor)
'		cont0.tbl0.SetCellFgColor( 9, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 9, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 9, 6, sColor)
	End If
	
	If nIdx < 2 then
		'중립형
		cont0.tbl0.SetCellFgColor( 4, 6, sColor)
		cont0.tbl0.SetCellFgColor( 5, 6, sColor)
		
'		cont0.tbl0.SetCellFgColor( 7, 1, sColor)
'		cont0.tbl0.SetCellFgColor( 7, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 7, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 7, 6, sColor)
'		
'		cont0.tbl0.SetCellFgColor( 5, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 5, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 5, 6, sColor)
	End If
	
	If nIdx < 1 then
		'안정지향형	
		cont0.tbl0.SetCellFgColor( 2, 6, sColor)
		cont0.tbl0.SetCellFgColor( 3, 6, sColor)
	
'		cont0.tbl0.SetCellFgColor( 1, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 1, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 1, 6, sColor)
'		
'		cont0.tbl0.SetCellFgColor( 5, 1, sColor)
'		cont0.tbl0.SetCellFgColor( 3, 4, sColor)
'		cont0.tbl0.SetCellFgColor( 3, 5, sColor)
'		cont0.tbl0.SetCellFgColor( 3, 6, sColor)
	End If
	
	'중립형 제외
'	cont0.tbl0.SetCellFgColor( 9, 1, sColor)
'	cont0.tbl0.SetCellFgColor( 9, 4, sColor)
'	cont0.tbl0.SetCellFgColor( 9, 5, sColor)
'	cont0.tbl0.SetCellFgColor( 9, 6, sColor)
'	
'	cont0.tbl0.SetCellFgColor( 7, 4, sColor)
'	cont0.tbl0.SetCellFgColor( 7, 5, sColor)
'	cont0.tbl0.SetCellFgColor( 7, 6, sColor)
	
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sGrade
	sGrade = Form.GetOpenLinkData()		'투자성향진단 등급
	
	'v0002 유형별색상 초기화
	cont0.tbl0.SetCellBgColor(3, 2, "383")
	cont0.tbl0.SetCellBgColor(7, 2, "382")
	cont0.tbl0.SetCellBgColor(11, 2, "380")
	cont0.tbl0.SetCellBgColor(15, 2, "378")

	'투자성향진단 등급에 따른 상품선택 라디오 Enable/Disable
	If sGrade == "01" then		'고수익지향형
		
	ElseIf sGrade == "02" then	'성장지향형
		cont0.rdo0.enableindex = "5,0"
		cont0.rdo0.enableindex = "6,0"
		SetTableForeColor(3)
		
	ElseIf sGrade == "03" then	'중립형
		cont0.rdo0.enableindex = "3,0"
		cont0.rdo0.enableindex = "4,0"
		cont0.rdo0.enableindex = "5,0"
		cont0.rdo0.enableindex = "6,0"
		SetTableForeColor(2)
		
	ElseIf sGrade == "04" then	'안정지향형
		cont0.rdo0.enableindex = "3,0"
		cont0.rdo0.enableindex = "4,0"
		cont0.rdo0.enableindex = "5,0"
		cont0.rdo0.enableindex = "6,0"
		SetTableForeColor(1)
		
	ElseIf sGrade == "05" then	'이자소득형
		cont0.rdo0.enableindex = "1,0"
		cont0.rdo0.enableindex = "2,0"
		cont0.rdo0.enableindex = "3,0"
		cont0.rdo0.enableindex = "4,0"
		cont0.rdo0.enableindex = "5,0"
		cont0.rdo0.enableindex = "6,0"
		SetTableForeColor(0)
	End If
'		cont0.rdo0.enableindex = "3,0"
'		cont0.rdo0.enableindex = "4,0"
'		SetTableForeColor(1)
	Form.SetScreenName("상품(MP) 선택")
End Sub

'============================================================================
'확인
Sub cont0_btnOK_OnClick()
	If CDbl(cont0.rdo0.currentindex) < 0 then
		Form.ShowAlert("알림", "가입하실 상품(MP)을 선택해 주세요.")
		Exit Sub
	End If
	
	dim sReturnValue
	if CInt(cont0.rdo0.currentindex) > 2 then'중립형 이상 일때
		sReturnValue = CInt(cont0.rdo0.currentindex) + 2
	else
		sReturnValue = cont0.rdo0.currentindex
	end if
	
	Form.SendReturnToParent( "mbisa56110_p2" , sReturnValue )
	Form.CloseForm( )
End Sub

'============================================================================
'MP설명서 오픈
Sub OpenMPManual(sUrl)
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/comm/ctcn/pdf/" & sUrl & ".pdf", "MP설명서")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/" & sUrl & ".pdf", "MP설명서")	'테스트계주소
	end if	
End Sub
	
