					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="(1) 금융상품분류기준 :" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="128:188030030" line="0,0" caption="[1종] 예적금, RP" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="2,0,2,0" fgcolor="067:049081150" line="0,0" caption="[2종] 집합투자증권" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="3,0,3,0" fgcolor="065:102102102" line="0,0" caption="[3종] 파생결합증권" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,1,3,1" halign="0" line="0,0" caption="(2) 위험자산군 : 다소높은위험자산 이상" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,2,3,2" halign="0" line="0,0" caption="(3) MP위험값 : MP자산별 위험도의 스코어(2~10점) 및 비중" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,3,3,3" halign="0" line="0,0" caption="(4) 투자일임수수료는 일일 평가금액을 기준으로 일할 계산하여 분기(1,4,7,10월)마다 후취함." fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,4,3,4" halign="0" line="0,0" caption="     펀드 총보수는 편입되는 개별펀드에 부과되는 연간 총보수(판매보수+운용보수+사무수탁보수 등)" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,5,3,5" halign="0" line="0,0" caption="     로 현재 편입된 포트폴리오를 기준으로 작성한 것이며, 리밸런싱등 실제 상품 편입 과정에서" fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,6,3,6" halign="0" line="0,0" caption="     징수되는 보수는 달라질 수 있습니다. ( 실제 편입된 포트폴리오의 보수 징수내역은 홈페이지를 " fontsize="-5" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,7,3,7" halign="0" line="0,0" caption="     통해 유형별로 확인 가능합니다. )" fontsize="-5" autofontsize="1" impidxs="" />
					</CELL_INFO>
