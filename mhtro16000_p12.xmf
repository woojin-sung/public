						<IMAGE name="imgIcon" autosize="1" ly_vert="0,10,20,18,1" />
						<LABEL name="lblLine2" bgcolor="271:236236236" transmode="0" ly_vert="0,39,335,1,1" />
						<LABEL name="lblItemCd" fontsize="-2" multiline="1" click="1" ly_vert="20,0,150,40,1" />
						<LABEL name="lblRate0" fontsize="-2" halign="2" autofontsize="1" ly_vert="170,0,80,40,1" />
						<LABEL name="lblRate1" fontsize="-2" halign="1" ly_vert="258,0,70,40,1" />
						<LABEL name="Label0" ly_vert="20,50,100,32,1" />
						<LABEL name="Label1" ly_vert="20,80,100,32,1" />
					</CONTROL_INFO>
					<CARD_INFO cardheight="40" >
						<CELL name="imgIcon" />
