	<SCRIPT_INFO _len="7131" _ulen="7037" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_42_n.9"

Dim g_szBtnImg_Close
g_szBtnImg_Close = "icon_close"

Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

Dim g_szItemCd, g_szExidCd, g_szOnlyCd
g_szItemCd = ""
g_szExidCd = ""
g_szOnlyCd = ""

Dim g_szItemNm
g_szItemNm = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기화
'===============================================
Function Init_Control()
	lblTitle.fgcolor = g_szTxtColor_Normal
	lblTitle.paddinginfo = "0,0,0,0"
	
	imgBack.maintainratio = "3"
	imgBack.imgpath = g_szBtnImg_Close
	
	contMain.lblSubTitle.paddinginfo = "0,0,0,0"
	
	contMain.lblLine0.bgcolor = "245246247"
	
	contMain.lblItemCd0.fgcolor = g_szTxtColor_Grey
	contMain.lblRate2.fgcolor = g_szTxtColor_Grey
	contMain.lblRate3.fgcolor = g_szTxtColor_Grey
End Function

Function RequestTranData_006r(szData0, szData1)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_006r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 ,szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 ,szData1)
	
	DATAMANAGER.RequestTranData("ohhts_metf_006r")
End Function

Function ResponseTranData_006r()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_006r", "OutBlock1")
	if Cint(nDataCnt) > 25 then
		nDataCnt = 25
	end if
	
	for i = 0 to nDataCnt-1
		szItem0 = DATAMANAGER.GetDataValue(0,"ohhts_metf_006r", "OutBlock1", "FID_OVRS_ISCD" , i)
		szItem1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FIDX_KOR_ISNM", i)
		szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_RLIM", i)
		szItem3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i)
		szItem4 = DATAMANAGER.GetDataValue(0,"ohhts_metf_006r", "OutBlock1", "FID_Y1_ERT" , i)
		szItem5 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_LSTN_NTNL_CODE", i)

		nIdx = contMain.Pannel0.AddRow()
		
		sGroupID = ""
		if szItem3 = "AX" or szItem3 = "NY" or szItem3 = "OQ" then
			sGroupID = "CI_USD"
		elseif szItem3 = "JP" then
			sGroupID = "CI_JPN"
		elseif szItem3 = "SH" or szItem3 = "SZ" then
			sGroupID = "CI_CHN"
		elseif szItem3 = "HK" then
			sGroupID = "CI_HKG"
		else
			sGroupID = "CI_KOR"
		end if
		
		szImgNm = Form.getIconImg(sGroupID, szItem0)
		
		if szImgNm = "" then
			szImgNm = Form.getIconImg("FLAG", szItem5)
			
			if szImgNm = "" then
				szImgNm = "flag_general"
			end if
		end if
		
		DisplaySetting_Pannel(nIdx, szImgNm, szItem1, szItem4, szItem2, szItem0, szItem3)
	next
End Function

Function DisplaySetting_Pannel(nIdx, szImgNm, szItemCd, szRate0, szRate1, szHideData0, szHideData1 ) 
	contMain.Pannel0.setPropCardCell("maintainratio", "imgIcon",	nIdx,	"3")
	contMain.Pannel0.setPropCardCell("imgpath", "imgIcon",			nIdx,	szImgNm)
	
	contMain.Pannel0.setPropCardCell("maxlinecnt", "lblItemCd",		nIdx,	"1^-6")
	contMain.Pannel0.setPropCardCell("caption", "lblItemCd",		nIdx,	szItemCd)
	
	if trim(szRate0) = "" then
		contMain.Pannel0.setPropCardCell("caption", "lblRate0",	nIdx,	"-")
	else
		contMain.Pannel0.setPropCardCell("caption", "lblRate0",	nIdx,	FormatNumber(szRate0,2)&"%")
	end if
	
	if trim(szRate1) = "" then
		contMain.Pannel0.setPropCardCell("caption", "lblRate1",		nIdx,	"-")
	else
		contMain.Pannel0.setPropCardCell("caption", "lblRate1",		nIdx,	szRate1&"%")
	end if
	
	contMain.Pannel0.setPropCardCell("caption", "Label0",		nIdx,	szHideData0)
	contMain.Pannel0.setPropCardCell("caption", "Label1",		nIdx,	szHideData1)
End Function

Function MoveScreen(nIdx) 
	szItemCd = contMain.Pannel0.getPropCardCell("caption", "Label0", nIdx)
	szMktCd = contMain.Pannel0.getPropCardCell("caption", "Label1", nIdx)

	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			szItemCd = szMktCd & "@" & szItemCd
			
			szItemNm = Form.GetItemCodeInfo(szItemCd, "name")
			if szItemNm = "" or szItemNm = null then
				Form.Toast(2, "주식(국내/해외)만 현재가 연동이 가능합니다.", 0)
				exit Function
			end if
			
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			Form.CloseForm()
			g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )
			if g_szScreenNo <> "16000" then
				Form.OpenScreen("16000","")	
			end if
		Case Else
			szItemNm = Form.GetItemCodeInfo(szItemCd, "name")
			if szItemNm = "" or szItemNm = null then
				Form.Toast(2, "주식(국내/해외)만 현재가 연동이 가능합니다.", 0)
				exit Function
			end if
			Form.CloseForm()
			Form.OpenScreen("11000", szItemCd)
	End Select

End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
	
	Dim szLinkData
	szLinkData = Form.GetOpenLinkData()

	if szLinkData = "" then
		exit Sub
	end if
	arrLinkData = split(szLinkData, "★")
	
	lblTitle.caption = arrLinkData(0)
	
	lblTitle.setUseAutoScroll(true, 50, true)
	g_szItemNm = arrLinkData(0)
	
	Form.SetTimerEvent2(1, 1, 0.1)
	RequestTranData_006r(arrLinkData(1), arrLinkData(2))
End Sub
'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_006r" then
		ResponseTranData_006r()
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	
	if CInt(sTimerID) = 1 then
		lblTitle.setAutoScrollText(g_szItemNm)
	end if
End Sub

'============================================================================
Sub contMain_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "lblItemCd" then
		MoveScreen(nIndex)
	end if
End Sub

	</SCRIPT_INFO>
