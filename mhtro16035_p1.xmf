'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	dim szCodeInfo
	dim tCodeInfo
	dim szCodeMarket, szCode, szMarket, szName
	
	szCode = ""
	szMarket = ""
	szName = ""
	
	szCodeInfo = Form.GetSharedData("PEERGRP_CODEINFO", false )
	
	if szCodeInfo ~= nil and szCodeInfo ~= "" then
		if CStr(Instr(szCodeInfo, "@")) <> "0" then
			if CStr(Instr(szCodeInfo, "★")) <> "0" Then
				tCodeInfo = split(szCodeInfo, "★")
				
				for i = 0 to #tCodeInfo - 1
					szCodeMarket = split(tCodeInfo[i], "@")
	
					szMarket = szCodeMarket[0] 
					szCode = szCodeMarket[1]
					szName = szCodeMarket[2]
					
					Grid1.AddRow()
				
					Grid1.SetCellData( "bd_code", Grid1.rowcount - 1, szCode )
					Grid1.SetCellData( "bd_market", Grid1.rowcount - 1, szMarket )
					Grid1.SetCellData( "bd_name", Grid1.rowcount - 1, szName )
				next
			else
				szCodeMarket = split(szCodeInfo, "@")
	
				szMarket = szCodeMarket[0] 
				szCode = szCodeMarket[1]
				szName = szCodeMarket[2]
				
				Grid1.rowcount = "1"
				
				Grid1.SetCellData( "bd_code", 0, szCode )
				Grid1.SetCellData( "bd_market", 0, szMarket )
				Grid1.SetCellData( "bd_name", 0, szName )
			end if
		end if
	end if
	
	f_Search()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_6230_011r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_NTNL_CODE" , 				0 , "US" )					'FIDX국가코드
	
	elseif szTranID == "ohhts_6252_003r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 	0 , "OV" )					'FID입력조건시장분류코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 	0 , "60001" )					'FID입력조건화면분류코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 	0 , "0" )					'FIDX입력지연실시간구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 			0 , cmbType1.cbkeydata )		'국가코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 		0 , cmbType2.cbkeydata )		'시장구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_BSTP_CODE" , 			0 , cmbType3.cbkeydata )		'업종코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_SRCH_NAME" , 			0 , UCase( edtSearch.caption ) )'입력검색명
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6230_011r" then
		dim nDataCnt
		
		nDataCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		if nDataCnt > 0 then
			cmbType3.clear = ""
				
			cmbType3.cbadddatatext = "`업종전체"
			
			for i = 0 to nDataCnt - 1
				dim szFIDX_BSTP_CLS_CODE, szFIDX_BSTP_DIV_NAME
				
				szFIDX_BSTP_CLS_CODE = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FIDX_BSTP_CLS_CODE" , i )
				szFIDX_BSTP_DIV_NAME = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FIDX_BSTP_DIV_NAME" , i )
				
				cmbType3.cbadddatatext = szFIDX_BSTP_CLS_CODE.."`"..szFIDX_BSTP_DIV_NAME
			next
			
			' 종목조회
			DATAMANAGER.RequestTranData( "ohhts_6252_003r" )
		end if
	end if
End Sub

'============================================================================
Sub cmbType1_OnEditComplete(iIndex)
	' 거래소 변경
	cmbType2.clear = ""
	
	edtSearch.caption = ""
	
	cmbType2.cbadddatatext = "`전체"
	
	if (cmbType1.cbkeydata == "US") then
		cmbType2.cbadddatatext = "NY`뉴욕"
		cmbType2.cbadddatatext = "OQ`나스닥"
		cmbType2.cbadddatatext = "AX`아멕스"
	
	elseif (cmbType1.cbkeydata == "CN") then
		cmbType2.cbadddatatext = "SH`상해"
		cmbType2.cbadddatatext = "SZ`심천"
	
	elseif (cmbType1.cbkeydata == "HK") then
'		cmbType2.cbadddatatext = "SH`상해"
	
	elseif (cmbType1.cbkeydata == "JP") then
'		cmbType2.cbadddatatext = "JP`일본"
	end if
	
	f_Search()
End Sub

'============================================================================
Sub cmbType2_OnEditComplete(iIndex)
	' 종목조회
	DATAMANAGER.RequestTranData( "ohhts_6252_003r" )	
End Sub

'============================================================================
Sub cmbType3_OnEditComplete(iIndex)
	' 종목조회
	DATAMANAGER.RequestTranData( "ohhts_6252_003r" )
End Sub

'============================================================================
Sub edtSearch_OnEditChar(CharCode)
	' 종목조회
	DATAMANAGER.RequestTranData( "ohhts_6252_003r" )
End Sub

'============================================================================
Sub f_Search()
	' 업종조회
	DATAMANAGER.RequestTranData( "ohhts_6230_011r" )
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	dim nItemCount, nOverlap
	
	nItemCount = tonumber(Grid1.rowcount)
	nOverlap = 0
	
	dim szItemCode
	
	szItemCode = Grid0.GetCellData( "bd_code", lRow )
	
	for i = 0 to nItemCount - 1
		'중복체크
		if szItemCode == Grid1.GetCellData( "bd_code", i ) then
			nOverlap = 1
			
			if nItemCount < g_nMaxCount then
				Form.ShowAlert("알림", "이미 추가된 종목입니다.")
			else
				Form.ShowAlert("알림", "종목 추가 개수는 최대 "..g_nMaxCount.."개 입니다.")
			end if
			
			return
		end if
	next
	
	'중복 아닌경우에만 추가
	if nOverlap == 0 then
		if nItemCount < g_nMaxCount then					
			Grid1.AddRow()
	
			Grid1.SetCellData( "bd_name", Grid1.rowcount - 1, Grid0.GetCellData( "bd_name", lRow ) )
			Grid1.SetCellData( "bd_code", Grid1.rowcount - 1, Grid0.GetCellData( "bd_code", lRow ) )
			Grid1.SetCellData( "bd_market", Grid1.rowcount - 1, Grid0.GetCellData( "bd_market", lRow ) )
			return
		else
			Form.ShowAlert("알림", "종목 추가 개수는 최대 "..g_nMaxCount.."개 입니다.")
			return
		end if
	end if
End Sub

'============================================================================
Sub Grid1_OnClickUp(lRow, szCellID)
	dim nSelectCount
	nSelectCount = 0
	
	if szCellID ~= "bd_check" then
		if Grid1.GetCellData( "bd_check", lRow ) == "1" then
			Grid1.SetCellData( "bd_check", lRow, "0" )
		else
			Grid1.SetCellData( "bd_check", lRow, "1" )
		end if
	end if
	
	for i = 0 to tonumber(Grid1.rowcount) - 1
		if Grid1.GetCellData( "bd_check", i ) == "1" then
			nSelectCount = nSelectCount + 1
		end if
	next

	if nSelectCount == 0 then
		btnDelete.enable = "0"
	else
		btnDelete.enable = "1"
	end if
End Sub

'============================================================================
Sub btnDelete_OnClick()
	for i = tonumber(Grid1.rowcount) - 1 to 0 Step -1
		if Grid1.GetCellData( "bd_check", i ) == "1" then
			Grid1.SetDeleteRow( i )
		end if
	next
End Sub

'============================================================================
Sub btnSave_OnClick()
	dim nSelectCount, szCodeInfo
	nSelectCount = 0
	szCodeInfo = ""
	
	if tonumber(Grid1.rowcount) < g_nMinCount then
		Form.ShowAlert("알림", "종목을 최소 "..g_nMinCount.."종목 이상 하셔야 합니다.")
		return
	end if

	if tonumber(Grid1.rowcount) > 0 then
		dim szCode, szMarketm, szName
		
		for i = 0 to tonumber(Grid1.rowcount) - 1
			szCode = Grid1.GetCellData( "bd_code", i )
			szMarket = Grid1.GetCellData( "bd_market", i )
			szName = Grid1.GetCellData( "bd_name", i )
			
			if szCodeInfo == "" then
				szCodeInfo = szMarket.."@"..szCode.."@"..szName
			else
				szCodeInfo = szCodeInfo.."★"..szMarket.."@"..szCode.."@"..szName
			end if
		next

		Form.SetSharedData("PEERGRP_CODEINFO" , szCodeInfo)	
		Form.SendReturnToParent( "mhtro16035_p1" , "" )
		
		Form.CloseForm()
	end if
End Sub

