'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 종목정보 팝업
' 03. 작    성 : 2023.06.26 KKM 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

Dim g_szCode, g_szAction
g_szCode = ""
g_szAction = "ADD" 

Dim g_szRow
Dim g_szGroupID, g_szGroupName

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)	

Dim g_bInsertExcept
g_bInsertExcept = false

Dim g_szTitle
g_szTitle = "알림"

Dim g_nChkRow	'체크한 그룹의 행
g_nChkRow = -1

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0	
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if Trim(szGroup ) <> "" then
		tGroup = Split(szGroup, "♣")
		
		k = 0
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★") '그룹아이디
			grdGroup.insertrow = i
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1) & "(" & CInt(tList(2)) & ")") '20230608 KKM 관심종목수 포함
			grdGroup.SetCellData("bd_name2", i, tList(1) )
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
	
	grdGroup.selectrow = 0
	grdGroup_OnClickUp(0, "bd_name")
	
End Function	

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		'szName = grdGroup.GetCellData("bd_name",  i)
		szName = grdGroup.GetCellData("bd_name2",  i) '20230608 KKM 관심종목수 제외
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function


'============================================================================
' Load_GWList :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList

	grdList.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", g_szGroupID)

	if szGroup <> "" then
		tGroup = Split(szGroup, "♣")
	
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdList.insertrow = i
		'20180905_01 NOHES : 빈칸 처리
		'	if Trim(tList(0)) == "" then
			if Trim(tList(0)) == "" or Trim(tList(0)) == "빈칸" or Trim(tList(0)) == "EMPTY" then
				grdList.SetCellFgColor("bd_code", i, "6")
				grdList.SetCellFgColor("bd_name", i, "6")
				
				grdList.SetCellData("bd_code", i, "빈칸")
				grdList.SetCellData("bd_mk",   i, "")
				grdList.SetCellData("bd_name", i, tList(2))
				grdList.SetCellData("bd_memo", i, tList(2))
				grdList.SetCellImage("bd_mod", i, "icon_sub_04.9.png")
			else
				grdList.SetCellData("bd_code", i, tList(0))
				grdList.SetCellData("bd_mk",   i, tList(1))
				szName = Form.GetItemCodeInfo(tList(0), "name")	' 종목명은 저장 안하므로 메인에서 가져온다.
				grdList.SetCellData("bd_name", i, szName)
				grdList.SetCellData("bd_memo", i, "")
			end if
		Next
	end if
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCd, szMk
	'20211208 HSZ START : 등록된 관심그룹이 없는 경우
	if int(grdGroup.rowcount) == 0 then
		'Form.MsgBox("안내", "등록된 관심그룹이 없습니다.\n관심그룹을 새로 등록하시겠습니까?", "ADDGROUP", 1)
		Exit Function 
'	20211208 HSZ END
	else
		For i = 0 to grdList.rowcount-1
			szCd = grdList.GetCellData("bd_code", i)
			szMk = grdList.GetCellData("bd_mk",   i)
			
			if Trim(szMk) == "" then
				szMk = ""
				szCd = ""
			end if
			
	'20180905_01 NOHES ORG		
	'		if i == 0 then
	'			szList = szCd  & "★" & szMk & "★" & grdList.GetCellData("bd_name", i)
	'		else
	'			szList = szList & "♣" & szCd & "★" & szMk & "★" & grdList.GetCellData("bd_name", i)
	'		end if
	'201800905_01 NOHES START : 메모 관심리스트 저장
			if i == 0 then
				szList = szCd  & "★" & szMk & "★" & grdList.GetCellData("bd_memo", i) & "★" & grdList.GetCellData("bd_name", i)
			else
				szList = szList & "♣" & szCd & "★" & szMk & "★" & grdList.GetCellData("bd_memo", i) & "★" & grdList.GetCellData("bd_name", i)
			end if 
	'20180905_01 NOHES END		
		Next
	end if
	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	if g_szCloud == "0" then
		szChange = Form.GetCtlProp("#edtChange", "caption")
			
		' 그룹편집(1)이 된 상태이면 그룹도 조회해야하기 때문에 그룹편집이 안된상태일때 종목편집(0)조건을 넣어준다.
		if szChange <> "1" then
			Form.SetCtlProp("#edtChange", "caption", "0")
		end if
		
		For j = 0 to grdGroup.rowcount-1
			szCd = grdGroup.GetCellData("bd_code", j)
			
			if g_szGroupID == szCd then
				grdGroup.SetCellData("bd_count", j, grdList.rowcount)
				Exit For
			end if
		Next
	end if
	
	Save_GWGroup()
	
	Form.SaveConfigData("GWANSIM", g_szGroupID, szList)
	
	'20211022 아이티젠(김성수) 현재가 개선 START
	Form.SendReturnToParent("mhprc11000_save" , g_szGroupID & "★" & g_szGroupName & "★" & g_szAction) '200230518 KKM 그룹ID+그룹명+추가또는삭제
	'20211022 아이티젠(김성수) 현재가 개선 END
	
	Form.Toast(2, "[" &g_szGroupName & "] 그룹에 추가되었습니다.", true)
	
	Form.CloseForm()
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
	if g_szCloud == "1" then
		'DATAMANAGER.RequestTranData("ohhts_intr_009r")
		DATAMANAGER.RequestTranData("ohhts_intr_102r") ' 추가		
	else
		Save_GWList()
	end if

End Function


'============================================================================
' Insert_GrdList : grdList에 종목 추가
'============================================================================
Function Insert_GrdList()
     '20230530 KKM  맨위/맨아래 위치에 추가 
	k = 0 '맨 위 추가 (T) - 기본
	if Trim(g_szCode) <> "" then
		if rgTopButtom.currentindex == "1" then '맨 아래 추가(B)
			grdList.insertrow = grdList.rowcount
		end if 
		grdList.insertrow = k
		grdList.SetCellData("bd_memo", k, "")
		grdList.SetCellData("bd_code", k, g_szCode)
		
		szMk = Form.GetItemCodeInfo(g_szCode, "market")
		grdList.SetCellData("bd_mk", k, szMk)
		
		szName = Form.GetItemCodeInfo(g_szCode, "name")
		grdList.SetCellData("bd_name", k, szName)
	end if
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData 

	szData = Form.GetOpenLinkData()	
	if Trim(szData) = "" then
	    Exit sub
	End if
	
	'ADD or GROUP_ADD2
	'20230516 HSZ START 	: 관심종목 삭제 로직 추가 - 기존화면에서는 종목코드만 넘겨줌
	szInstr = CInt(Instr(szData, "★"))
	
	if szInstr > 0 then	'추가로직
		arrData = Split(szData, "★")	
		g_szCode = arrData(0)		'종목코드
		g_szAction = arrData(1)
	else					'기존로직
		ImgClose.imgpath = "alpha128"
		g_szCode = szData
		g_szAction = "ADD"
	end if
	
	'20230516 HSZ END
	
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////

	' 그리드 로우 위치 변경 위한 속성
'	grdGroup.rowmove = "1"	
	
	if g_szCloud == "1" then		' Server 저장시	
		'관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		
		DATAMANAGER.RequestTranData("ohhts_intr_006r")	
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기	
		Load_GWGroup()
	end if
End Sub

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

