'			' FID입력시장구분코드
'			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, grdList.GetCellData("bd_mk", j))	
'
'			' FID관심종목코드 / FID메모내용
