'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

Dim g_nAccountNumber	'계좌번호 8글자 ex)18431988
Dim g_nAccountSerialNumber	'계좌 일련번호 2글자 ex)01
Dim g_szData			'계좌번호★일련번호 ex) 18431988★01
Dim g_OriMangEmp         ' 원관리자사원번호
Dim g_Prcd               ' 상품코드
Dim g_chan_type_cls_code ' 가입채널구분코드

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
     'MTS메모리평문 적용유무
     'plain_rm = ( 0 : 미적용 / 1 : 적용 )
     plain_rm = Form.GetSharedData("&PLAIN_RM", false)
     
     if szTranID == "obacp_comm_008r" then		
		DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNO",     0, g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ASNO",     0, g_nAccountSerialNumber)
		'MTS메모리평문 적용상태일때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNT_PWD", 0, edtPassword.caption)
		
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNT_PWD", 0, edtPassword.encdata)
		end if
		
		DATAMANAGER.RequestTranData("obacp_comm_008r")
		
		
	elseif szTranID == "obaci_acct_053u" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "ACNO",     0 , g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "ASNO",     0 , g_nAccountSerialNumber)
		'MTS메모리평문 적용상태일때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "ACNT_PWD", 0 , edtPassword.caption)
		
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "ACNT_PWD", 0 , edtPassword.encdata)
		end if
		'DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "ACNT_PWD", 0 , edtPassword.encdata)
		' 20160415 아래와 같이 수정
'		DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "MANG_EMPNO", 0 , tblAfter.GetCellString( 0, 1 ))
'		DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "RCMD_EMPNO" , 0 , tblAfter.GetCellString( 1, 1 ))
		DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "MANG_EMPNO", 0 , tblAfter.GetCellString( 0, 4 ))		
		DATAMANAGER.SetDataValue(0, "obaci_acct_053u", "InBlock1", "RCMD_EMPNO" , 0 , tblAfter.GetCellString( 1, 4 ))
		
		DATAMANAGER.RequestTranData("obaci_acct_053u")
	end if
End Function

'============================================================================
' Set_NumMasking : 20160415 함수추가
'============================================================================
Function Set_NumMasking(szData)					
	if szData == null then		
		return ""
	else
		if Len(szData) <= 1 then				
			return szData			
		else				
			return Left(szData, Len(szData)-1 ) & "*"			
		end if		
	end if
End Function					

'============================================================================
' Set_StrMasking : 20160415 함수추가
'============================================================================
Function Set_StrMasking(szData)					
	if szData == null then		
		return ""
	else
		if Len(szData) < 6 then	
			return szData
		elseif Len(szData) == 6 then	
			return Left(szData, 3) .. "*"
		elseif Len(szData) > 6 then	
			return Left(szData, 3) .."*"..Mid(szData, 7)
		end if	
	end if
End Function	

'============================================================================
' Init_Grid : 20160415 함수화
'============================================================================
Function Init_Grid()
	tblAfter.SetCellString( 0, 1, "" )
	tblAfter.SetCellString( 0, 2, "" )
	tblAfter.SetCellString( 0, 4, "" )
	tblAfter.SetCellString( 0, 5, "" )
	tblAfter.SetCellString( 1, 1, "" )
	tblAfter.SetCellString( 1, 2, "" )
	tblAfter.SetCellString( 1, 4, "" )
	tblAfter.SetCellString( 1, 5, "" )	
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' imgManagerSearch_OnClick	- 관리자 돋보기 클릭
'============================================================================
Sub imgManagerSearch_OnClick()
	if edtBrcd.caption == "" then
		Form.MsgBox("알림", "관리점을 확인하세요", "", 0)
		exit sub
	end if
	'//관리점 정보(edtBrcd.caption) 보내기
	Form.OpenPopup("mbonl87030_p1" , "관리자 검색" & "★" & edtBrcd.caption , sPosInfo)
End Sub


'============================================================================
' imgSolicitorSearch_OnClick	- 권유자 돋보기 클릭
'============================================================================
Sub imgSolicitorSearch_OnClick()
	Form.OpenPopup("mbonl87030_p1" , "권유자 검색" & "★" & edtBrcd.caption , sPosInfo)
End Sub



'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_nAccountNumber = cmbAccount.total				'계좌번호
	g_nAccountSerialNumber = cmbAccount.sequence				'일련번호
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber	
	btnSearch_OnClick()
	
	
	edtPassword.caption = ""
End Sub



'============================================================================
' btnSearch_OnClick	- 조회(개별계좌 정보 조회)
'============================================================================
Sub btnSearch_OnClick()
	TR_Inquiry("obacp_comm_008r")
End Sub



'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obaci_acct_053u" then	'계좌 관리자 변경 tr
		'if Form.GetSharedData("&USER_TYPE", false ) <> "0" then
		'	edtPassword.caption = ""
		'end if		
		btnSearch_OnClick()
		Init_Grid()
		btnChange.enable = false
		edtPassword.caption = ""
		Edit0.caption = ""
		Edit1.caption = ""
		Form.MsgBox("알림", "변경이 완료되었습니다.", "", 0)
	elseif szTranID == "obacp_comm_008r" then		' 20160415 추가
		' 관리자 직원번호
		szData = tblBefore.GetCellString(0, 4)
		szRtn = Set_NumMasking(szData)
		tblBefore.SetCellString(0, 1, szRtn)
		
		' 관리자 직원명
		szData = tblBefore.GetCellString(0, 3)				
		szData = Replace(szData, "**", "나")		' 실제데이터가 아니라 보여주기 위한 데이터이기 때문에 임의의 문자 삽입해도 됨.			
		szRtn = Set_StrMasking(szData)			
		tblBefore.SetCellString(0, 2, szRtn)			

		' 권유자 직원번호
		szData = tblBefore.GetCellString(1, 4)
		szRtn = Set_NumMasking(szData)
		tblBefore.SetCellString(1, 1, szRtn)
		
		' 권유자 직원명
		szData = tblBefore.GetCellString(1, 3)				
		szData = Replace(szData, "**", "나")				
		szRtn = Set_StrMasking(szData)				
		tblBefore.SetCellString(1, 2, szRtn)			
		g_OriMangEmp = DATAMANAGER.GetDataValue( 0 , "obacp_comm_008r", "OutBlock1", "MANG_EMPNO" , 0)
		g_Prcd = DATAMANAGER.GetDataValue( 0 , "obacp_comm_008r", "OutBlock1", "PRCD" , 0)
		
		DATAMANAGER.SetDataValue(0, "obacb_balc_132r", "InBlock1", "ACNO",     0, g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obacb_balc_132r", "InBlock1", "ASNO",     0, g_nAccountSerialNumber)
		TR_Inquiry("obacb_balc_132r")
		DATAMANAGER.RequestTranData("obacb_balc_132r")
		
     elseif szTranID == "obcsb_efif_005r" then
          if Edit0.Caption( ) = "Y" And Edit1.Caption() ="002" Then
          Form.MsgBox( "알림", "<신용공여 이벤트 계좌 주의>" & Chr(13) & Chr(10) & Chr(13) & Chr(10)
                               &"· 본 계좌는 신용공여 이자율 인하" & Chr(13) & Chr(10) 
			                 &"     이벤트 대상계좌입니다."  & Chr(13) & Chr(10) 
                               &"    관리자 등록시, 익일부터 이벤트" & Chr(13) & Chr(10) 
                               &"     (연장이벤트 포함)이 사라지며"  & Chr(13) & Chr(10) 
			                 &"     복원되지 않습니다. "  , "exec", 1 )
          else
	         TR_Inquiry("obaci_acct_053u")
	      end if
	elseif szTranID == "obacb_balc_132r" then
       g_chan_type_cls_code = DATAMANAGER.GetDataValue( 0 , "obacb_balc_132r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , 0)      
    
	end if
End Sub

'============================================================================
' btnChange_OnClick	- 변경 클릭
'============================================================================
Sub btnChange_OnClick()
	if Trim(tblAfter.GetCellString( 0, 1 )) == "" and Trim(tblAfter.GetCellString( 0, 2 )) <> "" then
		Form.MsgBox("알림", "관리자를 정확하게 입력하세요", "", 0)
		exit sub
	end if
	
	if Trim(tblAfter.GetCellString( 0, 1 )) <> "" and Trim(tblAfter.GetCellString( 0, 2 )) == "" then
		Form.MsgBox("알림", "관리자를 정확하게 입력하세요", "", 0)
		exit sub
	end if
	
	
	if Trim(tblAfter.GetCellString( 1, 1 )) == "" and Trim(tblAfter.GetCellString( 1, 2 )) <> "" then
		Form.MsgBox("알림", "권유자를 확인하세요", "", 0)
		exit sub
	end if
	
	
	if Trim(tblAfter.GetCellString( 1, 1 )) <> "" and Trim(tblAfter.GetCellString( 1, 2 )) == "" then
		Form.MsgBox("알림", "권유자를 확인하세요", "", 0)
		exit sub
	end if
	
	
	if Trim(tblAfter.GetCellString( 0, 1 )) == "" and Trim(tblAfter.GetCellString( 0, 2 )) == "" and Trim(tblAfter.GetCellString( 1, 1 )) == "" and Trim(tblAfter.GetCellString( 1, 2 )) == "" then
		Form.MsgBox("알림", "관리자 또는 권유자를 입력하세요", "", 0)
		exit sub
	end if
	
	if edtPassword.caption == "" or edtPassword.caption == Null then
		Form.ShowAlert( "알림", "계좌비밀번호를 입력하십시오.")
		Exit Sub
	end if

	If MID(TRIM(g_OriMangEmp),1,1) = "C" and (g_chan_type_cls_code="111" or g_chan_type_cls_code="112"  ) and Trim(tblAfter.GetCellString( 0, 1 )) <> "" Then
		If TRIM(g_Prcd) = "136" or TRIM(g_Prcd) = "137" Then
			Form.MsgBox("알림", "<비대면 CFD 계좌 주의>" & Chr(13) & Chr(10) & Chr(13) & Chr(10)
							&"· 비대면혜택을 받고 있는 CFD계좌는 " & Chr(13) & Chr(10) 
							&"· 관리자 등록 시 혜택이 소멸되어 " & Chr(13) & Chr(10) 
							&"   복원되지 않습니다."  & Chr(13) & Chr(10) 
							&"  (수수료 익일부터 반영,"  & Chr(13) & Chr(10) 
							&"   롤오버이자 당일부터 반영 됩니다.)"  & Chr(13) & Chr(10) 
							&"   변경하시겠습니까?"    , "exec", 1 )
			Exit Sub
		ElseIf TRIM(g_Prcd) = "140" Then
			Form.MsgBox("알림", "<비대면 중개형ISA 계좌 주의>" & Chr(13) & Chr(10) & Chr(13) & Chr(10)
							&" 본 계좌는 중개형ISA 수수료면제혜택" & Chr(13) & Chr(10) 
							&" 적용계좌로 관리자지정 시 혜택적용이" & Chr(13) & Chr(10) 
							&" 중단됩니다. " & Chr(13) & Chr(10) & Chr(13) & Chr(10)
							&" 변경하시겠습니까?"    , "exec", 1 )
			Exit Sub
		End If
	End If

	'v0005	
'	if (MID(TRIM(g_OriMangEmp),1,1) = "C" and ( TRIM(g_Prcd) = "136"  or TRIM(g_Prcd) = "137" )) and (g_chan_type_cls_code="111" or g_chan_type_cls_code="112"  ) and Trim(tblAfter.GetCellString( 0, 1 )) <> ""
'	       then
'	  Form.MsgBox( "알림", "<비대면 CFD 계좌 주의>" & Chr(13) & Chr(10) & Chr(13) & Chr(10)
'                               &"· 비대면혜택을 받고 있는 CFD계좌는 " & Chr(13) & Chr(10) 
'			                 &"· 관리자 등록 시 혜택이 소멸되어 " & Chr(13) & Chr(10) 
'			                 &"   복원되지 않습니다."  & Chr(13) & Chr(10) 
'					        &"  (수수료 익일부터 반영,"  & Chr(13) & Chr(10) 
'						   &"   롤오버이자 당일부터 반영 됩니다.)"  & Chr(13) & Chr(10) 
'                               &"   변경하시겠습니까?"    , "exec", 1 )
'			Exit Sub
'     else
'	end if
'	
    If MID(Trim(tblAfter.GetCellString( 0, 1 )),1,1) == "C" Then 
       TR_Inquiry("obaci_acct_053u")	'계좌 관리자 변경 tr요청
    elseif MID(Trim(tblAfter.GetCellString( 0, 1 )),1,1) == "" Then 
       TR_Inquiry("obaci_acct_053u")	'계좌 관리자 변경 tr요청
	else
	   If  MID(Trim(tblBefore.GetCellString( 0, 1 )),1,1) = "C" AND  MID(Trim(tblAfter.GetCellString( 0, 1 )),1,1) <> "C"  Then	       
           DATAMANAGER.SetDataValue(0, "obcsb_efif_005r", "InBlock1", "PROS_CLS_CODE",     0, "3")
           DATAMANAGER.SetDataValue(0, "obcsb_efif_005r", "InBlock1", "ACNO",     0, g_nAccountNumber)
           DATAMANAGER.SetDataValue(0, "obcsb_efif_005r", "InBlock1", "ASNO",     0, g_nAccountSerialNumber)
           DATAMANAGER.RequestTranData("obcsb_efif_005r")
        Else
           TR_Inquiry("obaci_acct_053u")
        End If
	end if

End Sub


'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20160415 항목추가
	if sKeyName == "returnEmployee" then
		Dim szList
		szList = Split(sRet, "★")
		if szList(0) == "관리자" then
			tblAfter.SetCellString( 0, 1, szList(4) )
			tblAfter.SetCellString( 0, 2, szList(5) )
			tblAfter.SetCellString( 0, 4, szList(1) )
			tblAfter.SetCellString( 0, 5, szList(2) )
			btnChange.enable = true
		elseif szList(0) == "권유자" then
			tblAfter.SetCellString( 1, 1, szList(4) )
			tblAfter.SetCellString( 1, 2, szList(5) )
			tblAfter.SetCellString( 1, 4, szList(1) )
			tblAfter.SetCellString( 1, 5, szList(2) )
			btnChange.enable = true
		end if
	end if
End Sub




'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obaci_acct_053u" then
	    'v0002
		If CInt(szErrCode) = 6660 Then
		    sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		    If Trim(sSubMsg) == "[신용정보미동의제휴계좌]동의후등록가능" Then		       
			    Form.ShowAlert( "알림", "[개인(신용)정보 처리 미동의 제휴계좌] 는\n[개인(신용)정보 처리 동의]화면에서 동의 후 등록가능합니다.", "")
		    Else
				Form.MsgBox("알림", szErrMsg.."\n("..Trim(sSubMsg)..")", "", 0)
		    End If
		Else
			Form.MsgBox("알림", szErrMsg, "", 0)
	    End If
'		tblAfter.SetCellString( 0, 1, "" )
'		tblAfter.SetCellString( 0, 2, "" )
'		tblAfter.SetCellString( 1, 1, "" )
'		tblAfter.SetCellString( 1, 2, "" )
		edtPassword.caption = ""
	end if
End Sub

'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_nAccountNumber = cmbAccount.total 
	g_nAccountSerialNumber = cmbAccount.sequence
	edtPassword.caption = ""
	Init_Grid()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "exec" then
		if sRet == "ok" then
			TR_Inquiry("obaci_acct_053u")
		end if
	end if
End Sub
