	<SCRIPT_INFO _len="5625" _ulen="5325" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 계좌번호_찾기_완료팝업
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_CPNO
Dim g_RCNO
Dim g_CSNM

Dim g_szScrno
'============================================================================
'							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.setMaintainingRatio("1")
	Img0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()	
	'20240119 HSZ START: 메뉴오픈 추가
	g_szScrno = Form.GetSharedData("&POPUP_SCREEN_NO", false )
	'20240119 HSZ END
	
	g_CPNO	= Form.GetSharedData("mbonl85001_CPNO", 		true)
	g_RCNO	= Form.GetSharedData("mbonl85001_RCNO_PIP", 	true)
	g_CSNM	= Form.GetSharedData("mbonl85001_CSNM", 		true)
	
	DATAMANAGER.RequestTranData("obaci_acct_401r")
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SetSharedData("mbonl85001_CPNO" , 		"")
	Form.SetSharedData("mbonl85001_RCNO_PIP" , 	"")
	Form.SetSharedData("mbonl85001_CSNM" , 		"")	
End Sub

'============================================================================
'						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obaci_acct_401r" then	
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "IQRY_CLS_CODE",	0, "1")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CLPH_TELNO", 		0, g_CPNO)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO_PIP", 		0, g_RCNO)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CSNM", 			0, g_CSNM)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obaci_acct_401r" then
		Dim nCnt, szTxt
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		'20240119 HSZ START: 메뉴오픈 추가
		if g_szScrno = "85110" then
			szTxt = "복사"
		else		'기존텍스트
			szTxt = "선택"
		end if
		'20240119 HSZ END
		
		if nCnt > 0 then
			Table0.visible	= true
			grd0.visible		= true
			Label0.caption 	= "계좌번호 찾기가 완료되었습니다."
			
			for i = 0 to nCnt - 1
				Dim sPRNM, sACNO, sASNO
				sPRNM = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PRNM", 	i)
				sACNO = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ACNO",	i)
				sASNO = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ASNO",	i)
				
				grd0.AddRow()
				grd0.SetMaintainingRatio("BD_BUTTON", 	i, "1")
				grd0.SetCellImage("BD_BUTTON", 			i, "input_01_n.9.png")
				grd0.SetCellData("BD_BUTTON", 			i, szTxt)
				grd0.SetCellData("PRNM",				i, sPRNM)
				grd0.SetCellData("ACNO",				i, sACNO.."-"..sASNO)
			next
			
		else
			Table0.visible	= false
			grd0.visible		= false
			Label0.caption 	= "조회된 계좌번호 내역이 없습니다."
		end if
		
		'20240119 HSZ START: 메뉴오픈 추가
		if g_szScrno = "85110" then
			ImgClose.visible = false
			btnOK.visible = true
		else		'기존
			ImgClose.visible = true
			btnOK.visible = false
		end if
		'20240119 HSZ END
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubmsg 			= DATAMANAGER.GetDataMsgSubText(szTranID)
	Label0.caption	= "ERROR"
	
	Form.MsgBox("알림", szErrMsg & " " & sSubmsg, "", 0)
	Form.CloseForm()
End Sub

'============================================================================
'							CONTROL 함수
'============================================================================
' ID정보 선택
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	' 선택
	if szCellID == "BD_BUTTON" then
		'20240119 HSZ START: 메뉴오픈 추가
		if g_szScrno = "85110" then				' 복사 - 메뉴 진입 시에만
			szClipAcno = grd0.GetCellData("ACNO", lRow)
			Form.setClipboardText(szClipAcno)
			Form.Toast(0, "복사되었습니다.", 0.2)
		'20240119 HSZ END
		else									' 선택
			Form.SetSharedData("mbonl85001_p1_ACNO", grd0.GetCellData("ACNO", lRow))
			Form.SendReturnToParent("mbonl85001_p1", "RETURN")
			
			'20230620 SWJ START : iOS 화면 안열리는 현상이 있어서 mbonl85001과 함꼐 일부 수정
			if Form.GetSharedData("&OS_TYPE", false ) == "1" then
				Form.CloseForm()
			end if
			'20230620 SWJ END
		end if
	end if
	
End Sub

'============================================================================
' 닫기 버튼
'============================================================================
Sub ImgClose_OnClick()
	Form.SendReturnToParent("mbonl85001_p1", "CLOSE")
	Form.CloseForm()
End Sub

'20240119 HSZ START: 메뉴오픈 추가
'============================================================================
' 확인 버튼 - 메뉴에서 진입 시에만
'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl85001_p1", "MENU_CLOSE")
	Form.CloseForm()
End Sub
'20240119 HSZ END
