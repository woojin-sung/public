'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("이용안내")
End Sub

'============================================================================
'영업점안내
Sub cont0_btnBranch_OnClick()
	Form.OpenFramePopup( "mbonl89000" , sOpenData , sPosInfo)
End Sub

'============================================================================
'온라인계좌개설
Sub cont0_btnAcnt_OnClick()
	Form.OpenFramePopup( "mbonl84010" , sOpenData , sPosInfo)
End Sub

'============================================================================
'공인인증센터
Sub cont0_btnCert_OnClick()
	Form.OpenFramePopup( "mhetc90060" , sOpenData , sPosInfo)	
End Sub

'============================================================================
'지점 개설계좌 ID등록
Sub cont0_btnID0_OnClick()
	Form.OpenFramePopup( "mhetc90020_p2" , sOpenData , sPosInfo)
End Sub

'============================================================================
'제휴은행 개설계좌 ID등록
Sub cont0_btnID1_OnClick()
	Form.OpenFramePopup( "mhetc90020_p2" , sOpenData , sPosInfo)
End Sub

'============================================================================
'ID 조회
Sub cont0_btnSrchID_OnClick()
	Form.OpenFramePopup( "mhetc90020_pa" , sOpenData , sPosInfo)
End Sub

'============================================================================
'ID 비밀번호 재설정
Sub cont0_btnPswd_OnClick()
	Form.OpenFramePopup( "mhetc90020_pb" , sOpenData , sPosInfo)
End Sub

'============================================================================
'고객지원센터 연결
Sub cont0_tbl4_OnClick(lRow , lColumn)
	if lRow == 4 and lColumn == 1 then 
		Form.SendCall( "15883400" )
	end if
End Sub

