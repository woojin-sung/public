	<SCRIPT_INFO _len="8101" _ulen="7755" >
'--===========================================================================
'2023.06.22 : 대여수익금조회화면 개발
'--===========================================================================
Dim g_LndnFeeYN		'Y : 포함하여 조회, N : 미포함하여 조회, default = N
Dim g_LndnStplYN
Dim g_StaDate
Dim g_FinDate
Dim g_PrdCd
Dim g_AplyYN           'default = N
'--===========================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	'ContNoAcct.Image1.setMaintainingRatio("1")
	ContAcct.imgArrow.setMaintainingRatio("1")
	'ContAcct.imgWonArrow.setMaintainingRatio("1")
	'ContAcct.imgUsdArrow.setMaintainingRatio("1")
	ContAcct.imgLndnArrow.setMaintainingRatio("1")
	'위치조정
	ContAcct.lblFeeCdName.setNeighborCtlPos("imgArrow","right",5,"")
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_LndnFeeYN = "N"
	g_AplyYN = "N"
	
	f_Init()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_lndn_050r" then
		DATAMANAGER.SetDataValue(0, "oblon_lndn_050r", "InBlock1", "PROS_CLS_CODE" , 0 , g_LndnFeeYN)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_050r", "InBlock1", "STA_DATE"      , 0 , g_StaDate)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_050r", "InBlock1", "FIN_DATE"      , 0 , g_FinDate)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_050r", "InBlock1", "ACNO"          , 0 , cmbAccount.total )
		DATAMANAGER.SetDataValue(0, "oblon_lndn_050r", "InBlock1", "ASNO"          , 0 , cmbAccount.sequence)
	end if
End Sub
'============================================================================
Function f_Init()
	ContAcct.lblTopBg.visible = false
	BtnLndnControl(false)
	f_SetInit()
	'초기 개월수는 1개월로 셋팅
	g_PrdCd = "1"
	
	tmpDate = LEFT(ContAcct.CalPsntDate.caption,4) & "-" & RIGHT(LEFT(ContAcct.CalPsntDate.caption,6),2) & "-" & RIGHT(ContAcct.CalPsntDate.caption,2)
	tmpPrd1month = CStr(DateAdd("d",0,DateAdd("m",-1,CDate(CStr(tmpDate)))))
	tmpPrd1month = Replace(tmpPrd1month, "-", "")
	
	g_StaDate = tmpPrd1month
	g_FinDate = ContAcct.CalPsntDate.caption
	
	f_SetFlag()
	g_LndnStplYN = "N"
	
	f_CallTran(0)
End Function

'============================================================================
Function f_SetInit()
	'수익금 합산
	ContAcct.lblAmt.caption = ""	'초기화
	ContAcct.lblAmt.fontsize = 27
	ContAcct.lblAmt.fgcolor  = 290
	
	ContAcct.lblLndnAmt.caption  = ""
	ContAcct.lblLndnAmt2.caption = ""
	ContAcct.lblLndnAmt3.caption = ""	
End Function

'============================================================================
Function BtnLndnControl(bStat)
	ContAcct.imgLndn.visible 		= bStat
	ContAcct.lblLndnCodeNm.visible 	= bStat
	ContAcct.lblLndnAmt.visible 	= bStat
	ContAcct.lblLndnText.visible 	= bStat
	ContAcct.lblLndnText2.visible 	= bStat
	ContAcct.lblLndnAmt2.visible 	= bStat
	ContAcct.lblLndnAmt3.visible 	= bStat
	ContAcct.imgLndnArrow.visible 	= bStat
	ContAcct.BtnLndn.visible 		= bStat
	ContAcct.lblSubTitle.visible    = bStat
End Function

'============================================================================
Function f_SetFlag()
	Dim tCodeName1
	Dim sStaDate, sFinDate
	
	if g_PrdCd == "1" then
		tCodeName1 = "1개월"		
		ContAcct.imgArrow.left = 215
	elseif g_PrdCd == "2" then		
		tCodeName1 = "3개월"
		ContAcct.imgArrow.left = 215
	elseif g_PrdCd == "3" then				
		sStaDate = Mid(g_StaDate,3,2) & "." & Mid(g_StaDate,5,2) & "." & Right(g_StaDate,2)
		sFinDate = Mid(g_FinDate,3,2) & "." & Mid(g_FinDate,5,2) & "." & Right(g_FinDate,2)

		tCodeName1 = sStaDate&" ~ "&sFinDate
		
		ContAcct.imgArrow.left = 285
	else 
		tCodeName1 = ""
	end if
	
	ContAcct.lblFeeCdName.caption = tCodeName1
End Function


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_lndn_050r" then
		dim nStaOffset
		dim nTotal, nLndnStckAmt, nLndnBondAmt
		
		g_LndnStplYN = DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock4", "STPL_YN" , 0)
		nTotal       = Clng(DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock1", "TOTAL_FEE", 0))
		nLndnStckAmt = Clng(DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock2", "STCK_FEE", 0))
		nLndnBondAmt = Clng(DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock3", "BOND_FEE", 0))
		g_AplyYN     = DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock4", "APLY_YN" , 0)
		
		ContAcct.lblFee.caption = Clng(nTotal)
		ContAcct.lblAmt.caption = ContAcct.lblFee.dispcaption&" 원"
		nStaOffset = ContAcct.lblAmt.getLen(ContAcct.lblAmt.caption) -2
		
		ContAcct.lblAmt.changeTextAttr(nStaOffset, 2, 290, 5, true)
		ContAcct.lblLndnAmt.caption = nTotal
		ContAcct.lblLndnAmt2.caption = nLndnStckAmt
		ContAcct.lblLndnAmt3.caption = nLndnBondAmt
		
		'대차약정 & 수익있음 = 수익란 보임
		'대차약정 & 수익없음 = 수익란 보임
		'대차미약정 & 수익있음 = 수익란 보임
		'대차이먁정 & 수익없음 = 수익란 안보임
		if g_LndnStplYN == "Y" and nTotal > 0 then
			BtnLndnControl(true)
		elseif g_LndnStplYN == "Y" and nTotal <= 0 then
			BtnLndnControl(true)
		elseif g_LndnStplYN == "N" and nTotal > 0 then
			BtnLndnControl(true)
		elseif g_LndnStplYN == "N" and nTotal <= 0 then
			BtnLndnControl(false)
		else
			BtnLndnControl(false)
		end if
	end if
End Sub

'============================================================================
'TR오류시..
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "안내" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
End Sub

'============================================================================
' 기간 및 수수료구분 선택팝업창 띄움
'============================================================================
Sub ContAcct_lblFeeCdName_OnClick()
	dim sSendData
	sSendData = g_PrdCd&"★"&g_StaDate&"★"&g_FinDate&"★"&g_AplyYN&"★"&g_LndnFeeYN
	
	Form.openPopupAnimation("mbonl88029_p2", sSendData,"","2")	
End Sub

'============================================================================
' PopUp Return 처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "mbonl88029_p2" then
		if sRet <> "" and sRet <> null then
			Dim tData
			tData = Split(sRet, "★")

			g_PrdCd    = tData(0)		'1:1개월 2:3개월 3:직접입력
			g_StaDate  = tData(1)
			g_FinDate  = tData(2)
			g_LndnFeeYN= tData(3)
				
			f_SetInit()
			f_SetFlag()
			
			f_CallTran(0)
		end if
	end if
End Sub

'============================================================================
' 대여수수료 상세조회
'============================================================================
Sub ContAcct_BtnLndn_OnClick()
	dim sSendData
	sSendData = cmbAccount.total&"★"&cmbAccount.sequence&"★"&g_StaDate&"★"&g_FinDate&"★3"&"★"&g_LndnFeeYN&"★"&ContAcct.lblFeeCdName.caption
	
	Form.openPopupAnimation("mbonl88029_p4", sSendData, "", "2")
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	f_Init()	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항 아이콘 클릭 이벤트
	if sEventName == "INFO_CLICK" Then
		Form.OpenPopup("mbonl92020_p1" , "" , "")
	End If	
End Sub

'============================================================================
Function f_CallTran(nIndex)
	if nIndex == 0 then
		if trim(cmbAccount.itemcodetype) <> "" then
			DATAMANAGER.RequestTranData("oblon_lndn_050r")
		end if
	end if
End Function
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="oblon_lndn_050r" trcode="oblon_lndn_050r" compress="1" encryption="1" inputcheck="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="oblon_lndn_050r" title="슈퍼365 대여수익 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="200" _ulen="152" >

