'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szList
Dim g_szQryType		'1:전체보유계좌보기, 2:선택계좌보기, 3:매수일별보기
Dim g_szACNO, g_szASNO, g_Pwd	'선택 계좌 정보
Dim g_szProducType      		 '00:전체, 09:채권, 12:단기사채
Dim g_szSumYN
Dim g_szSymbolCode
Dim g_iAccountCount
Dim g_szAccountList
Dim g_iDataCount, g_iAmtSum, g_ievalAmt
Dim g_szSelectAcc, g_szSelectAccSeq
Dim g_iSelectedRow
Dim g_szAccList

g_iDataCount = 0

Dim g_bSingle

g_szQryType = "1"
g_szProducType = "00"
g_szSumYN = "N"

Dim g_szUSERID    '고객 ID
Dim g_szCsno 		'v0004 고객번호

Dim g_bQry_balc_033r_Index, g_iQry_balc_033r_Index

Dim g_sTemp21, g_sTemp22, g_sTemp23
g_sTemp21 = ""
g_sTemp22 = ""
g_sTemp23 = ""

Dim g_sSaveAccountList
g_sSaveAccountList = ""

Dim g_bEntire
g_bEntire = True

Dim g_sEntireAcc
g_sEntireAcc = Array()

Dim g_sEntireAccSeq
g_sEntireAccSeq = Array()

Dim g_nAcntIndex
g_nAcntIndex = 0

Dim g_sHostDate
g_sHostDate = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function f_getAccFullName(szAcNo, szAsNo)
	Dim szAcc
	Dim szResult
	
	szAcc = Left(szAcNo, 4) & "-" & Right(szAcNo, 4) & "-" & szAsNo
	for i = 0 to CInt(g_iAccountCount) - 1
		if InStr(g_szAccountList(i), szAcc) > 0 then
			szResult = g_szAccountList(i)
			exit for
		end if
	next
	
	return szResult
end function

'============================================================================
Sub f_InitCtrl()
	szToday = Form.GetSharedData("&HOST_DATE", false)
	szToday = Right(szToday, 6)
	
	contMain.cont1.tblInfo.SetCellString(1, 2, szToday)			'날짜	
	contMain.cont1.tblInfo.SetCellString(3, 2, 0)					'평가금액
	contMain.cont1.tblInfo.SetCellString(5, 2, "")				'평가손익

	contMain.gridData.rowcount = 0
	contMain.gridDataSingle.rowcount = 0
	g_iAmtSum = 0
	g_ievalAmt = 0
end sub

'============================================================================
'for문에서 동시에 TR 요청시 제대로 못받는 경우가 생겨서 순차적으로 요청
Sub f_SendIndexQry(iStart, iEnd, szTranID)

	Dim iCnt
	
	if CInt(g_iQry_balc_033r_Index) > CInt(iEnd) then
		
		g_bQry_balc_033r_Index = False
				
		if g_bSingle then
			iCnt = CInt(contMain.gridDataSingle.rowcount)
		else
			iCnt = CInt(contMain.gridData.rowcount)
		end if
		
		if iCnt == 0 then
			contMain.imgNotice.visible = True
			contMain.tblNoData.visible = True
			
			
			contMain.lblBG.top = 225
			contMain.lblBG.height = 242
			
			contMain.gridData.top = 230
			contMain.gridData.height = 225
			
			contMain.gridDataSingle.top = 230
			contMain.gridDataSingle.height = 225
			
			contMain.tblNoData.top = 280
			contMain.imgNotice.top = 240
			
			contMain.SetScrollAutoSize()
		end if
		
		Exit Sub
	
	else
		
		if szTranID == "obacb_balc_033r" then
		
			g_szACNO = Left(g_szAccList(g_iQry_balc_033r_Index), 8)
			g_szASNO = Right(g_szAccList(g_iQry_balc_033r_Index), 2)
			
			DATAMANAGER.RequestTranData(szTranID)
			
		end if
		
		g_iQry_balc_033r_Index = CInt(g_iQry_balc_033r_Index) + 1
	end if
	
end Sub
'============================================================================
Sub ProcessAccount(sEventName)
	
	if g_szSelectAcc == "전체" then
		
		'전체 계좌 여부
		g_bEntire = True
		
		contMain.gridData.SetClear()
		contMain.gridDataSingle.rowcount = 0
		contMain.gridData.visible = True
		contMain.gridDataSingle.visible = False
		
		if sEventName == "Init" then
			Form.SetTimerEvent2(2, 1, 0.2)
		else
			RequestDataForEntire()
		end if
		
	else
		'전체 계좌 여부
		g_bEntire = False
		
		contMain.gridDataSingle.SetClear()
		contMain.gridData.rowcount = 0
		contMain.gridData.visible = False
		contMain.gridDataSingle.visible = True

		DATAMANAGER.RequestTranData("obacb_balc_033r")
	end if
	
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Sub
'============================================================================
Sub RequestDataForEntire()
	szAccList = Split(g_sSaveAccountList, "○")
	
	for i = 0 to CInt(g_iAccountCount) - 1		
		g_sEntireAcc(i) = Left(szAccList(i), 8)
		g_sEntireAccSeq(i) = Right(szAccList(i), 2)
	next
	
	DATAMANAGER.RequestTranData("obacb_balc_033r")
	
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent2(sTimerID,0,0.1)
	
	if Cint(sTimerID) == 1 then
		
		DATAMANAGER.RequestTranData("obacb_balc_033r")
	
	elseif Cint(sTimerID) == 2 then
		
		RequestDataForEntire()
		
	end if
End Sub
'============================================================================
Sub f_sendQry()
	Dim szAccList
	
	f_InitCtrl()
	
	if g_szSelectAcc == "전체" then
		g_bSingle = False
		
		contMain.gridData.visible = True
		contMain.gridDataSingle.visible = False	
	
		g_szQryType = 1	'전체계좌 조회
		
		g_szAccList = split(g_szList(3), "○")
		
		g_iQry_balc_033r_Index = 0
		g_bQry_balc_033r_Index = True
		
		f_SendIndexQry(0, CInt(g_szList(0)) - 1, "obacb_balc_033r")
		
	else	
		g_bSingle = True
		
		contMain.gridData.visible = False
		contMain.gridDataSingle.visible = True
		
		g_szQryType = 2	'개별 계좌 조회
		g_szACNO = g_szSelectAcc
		g_szASNO = g_szSelectAccSeq
		
		g_bQry_balc_033r_Index = False
		DATAMANAGER.RequestTranData("obacb_balc_033r")
		
	end if
	
	DATAMANAGER.RequestTranData("obacb_balc_154r")
end sub




'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.cont1.imgMine.setMaintainingRatio("1")
	contMain.cont1.imgCheck.setMaintainingRatio("1")
End Sub


'============================================================================
Sub Form_OnFormInit()

	g_szQryType = "1"
	g_szProducType = "00"
	g_szSumYN = "N"

	g_bQry_balc_033r_Index = False
	
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'고객번호
	g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then	'Android("1")iOS("2")
		contMain.gridData.setUseCardView(true, 2, "bg_listbox.9.png")
		contMain.gridDataSingle.setUseCardView(true, 2, "bg_listbox.9.png")
	else
		contMain.gridData.setUseCardView(true, 5, "bg_listbox.9.png")
		contMain.gridDataSingle.setUseCardView(true, 5, "bg_listbox.9.png")
	end if 
	
'	contMain.cont1.Tab0.setTabHeaderImage("bg_tab_sel.9.png" , "bg.tab_nor.9.png" , 6) '활성화/비활성화/여백	
	
	contMain.cont1.chkSum.visible = False
	
'	contMain.cont1.imgCheck.enable = False
'	contMain.cont1.lblSum.enable = False
'	contMain.cont1.btnSum.enable = False	
	contMain.cont1.imgCheck.visible = False
	contMain.cont1.lblSum.visible = False
	contMain.cont1.btnSum.visible = False
	
	g_sHostDate = Form.GetSharedData("&HOST_DATE", false)
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contMain.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
	Dim szList, szAccList
	
	g_iDataCount = 0
	g_nAcntIndex = 0

	'화면 처음 열때
	if sEventName == "Init" then

		'0 종합계좌 개수
		'1 종합계좌 리스트
		'2 개별계좌개수
		'3 개별계좌 리스트(ACNo + ASNo)
		'4 개별계좌명 리스트([상품명]계좌번호)
		'5 계좌개수☆개별계좌의 그룹인덱스
		'6 선택한 계좌번호
		'7 선택한 계좌seq
		'8 비밀번호
		
		g_szLinkData = sParam
		g_szList = split(g_szLinkData, "|")
'		
'		g_szSelectAcc = g_szList(6)
'		g_szSelectAccSeq = g_szList(7)
'		
'		'계좌번호전체, 계좌명을 비교하기 위해서 
'		g_iAccountCount = CInt(g_szList(2))
'		g_szAccountList = split(g_szList(4), "○")
'		
		'20240620 SWJ START
		'SettingForSearch()
		
		'contMain_cont1_FormTab0_OnTabChanged(CInt(contMain.cont1.FormTab0.currenttab))
		'20240620 SWJ END
		
		g_szSelectAcc = g_szList(6)
		g_szSelectAccSeq = g_szList(7)
		
		'계좌번호전체, 계좌명을 비교하기 위해서 
		g_iAccountCount = CInt(g_szList(2))
		g_szAccountList = split(g_szList(4), "○")
		g_sSaveAccountList = g_szList(3)
		
		ProcessAccount(sEventName)
		
'		f_sendQry()
	
	'계좌콤보 변경시
	elseif sEventName == "AccountChange" then
		
		'0 선택한 계좌번호		
		'1 선택한 계좌seq
		'2 비밀번호
		
		szList = split(sParam, "|")
		g_szSelectAcc = szList(0)
		g_szSelectAccSeq = szList(1)
		
		'f_sendQry()
		ProcessAccount(sEventName)
		
	end if
	
End Sub
'============================================================================
'20240620 SWJ START
Function SettingForSearch()

	contMain.cont1.imgCheck.visible = false
	contMain.cont1.lblSum.visible = false
	contMain.cont1.btnSum.visible = false
	
	contMain.gridData.top = 230 - 90 + 10
	contMain.gridData.height = 225 + 90 - 10
	
	contMain.gridDataSingle.top = 230 - 90 + 10
	contMain.gridDataSingle.height = 225 + 90 - 10
	
	contMain.tblNoData.top = 280
	contMain.imgNotice.top = 240
	
	g_szSumYN = "N"

	'f_sendQry()
	
End Function
'20240620 SWJ END

