'				contMain.gridData.SetCellData("MTRT_DATE",				g_iDataCount + i, szTemp15) '만기일자
'				contMain.gridData.SetCellData("VLTN_PRLS_AMT",			g_iDataCount + i, szTemp16) '평가손익금액
'				contMain.gridData.SetCellData("RMND_OWN_TYPE_NAME",		g_iDataCount + i, szTemp17) '잔고소유유형명
'				contMain.gridData.SetCellData("VLTN_UNPR",				g_iDataCount + i, szTemp18) '평가단가
'				contMain.gridData.SetCellData("LOAN_AMT",				g_iDataCount + i, szTemp19) '대출금액
'				contMain.gridData.SetCellData("LOAN_DATE",				g_iDataCount + i, szTemp20) '대출일자
'				contMain.gridData.SetCellData("LOAN_MTRT_DATE",			g_iDataCount + i, szTemp21) '대출만기일자
'				contMain.gridData.SetCellData("PSNT_PRC",				g_iDataCount + i, szTemp22) '현재가격
'				contMain.gridData.SetCellData("PRDY_VRSS",				g_iDataCount + i, szTemp23) '전일대비
'				contMain.gridData.SetCellData("RLTM_PRDY_VRSS_SIGN",		g_iDataCount + i, szTemp24)	'실시간전일대비부호
'				contMain.gridData.SetCellData("OVRL_SPTX_CLS_CODE",		g_iDataCount + i, szTemp25)	'종합분리과세구분코드
'				contMain.gridData.SetCellData("IQRY_CSNU",				g_iDataCount + i, szTemp26)	'조회건수
'				contMain.gridData.SetCellData("RMND_CLCD",				g_iDataCount + i, szTemp27)	'잔고구분코드
			end if
		next                                                                            
		
		if DATAMANAGER.IsMoreNextData("obacb_balc_033r") then

			'다음 조회 요청
			DATAMANAGER.RequestNextData("obacb_balc_033r")
				
		else
			
			g_iDataCount = g_iDataCount + CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" ))
			
			if g_bEntire then
				contMain.gridDataSingle.height = 0
				contMain.gridData.bgcolor = 320
				
				'계좌 리스트 개수 비교 후 다음 계좌에 대한 데이터 재조회
				if g_nAcntIndex <  CInt(g_iAccountCount) - 1 then
					g_nAcntIndex = g_nAcntIndex + 1
		
					DATAMANAGER.RequestTranData("obacb_balc_033r")
				else
					iHeight = (232 * g_iDataCount) + 15 + 10
							
					contMain.gridData.height = (232 * g_iDataCount) + 25
							
					if iHeight < 330 then
						contMain.lblBG.height = 330
					else
						contMain.lblBG.height = (232 * g_iDataCount) + 40 '179
					end if
				end if
			else	
				contMain.gridData.height = 0
				contMain.gridDataSingle.bgcolor = 320
				contMain.gridDataSingle.rowcount =  g_iDataCount
				
				iHeight = (209 * g_iDataCount) + 15 + 10
						
				contMain.gridDataSingle.height = (209 * g_iDataCount) + 25
						
				if iHeight < 330 then
					contMain.lblBG.height = 330
				else
					contMain.lblBG.height = (209 * g_iDataCount) + 40 '156
				end if

			end if
		end if
		
		if Cint(g_iDataCount) > 0 then
			'contMain.cont1.visible = True
			contMain.gridDataSingle.visible = True
			contMain.gridData.visible = True
			contMain.imgNotice.visible = False
			contMain.tblNoData.visible = False
		else	
			'contMain.cont1.visible = False
'			contMain.gridDataSingle.left = 500
'			contMain.gridData.left = 500
			
			contMain.gridDataSingle.visible = False
			contMain.gridData.visible = False
				
			contMain.lblBG.top = 140
			contMain.lblBG.height = 385
					
			contMain.tblNoData.top = 100 + 140
			contMain.imgNotice.top = 60 + 140
						
			contMain.imgNotice.visible = True
			contMain.tblNoData.visible = True

		end if
		
		contMain.SetScrollAutoSize()
		
		'f_SortGrid()
	end if
End Sub
