'============================================================================
Sub contMain_cont1_tblInfo_OnClick(lRow , lColumn)
	
	if (lRow == 3) and (lColumn == 2) then
		contMain_cont1_imgarrow_OnClick()
	end if
End Sub

'============================================================================
Sub contMain_cont1_btnDetail_OnClick()
	contMain_cont1_imgarrow_OnClick()
End Sub

'============================================================================
Sub contMain_cont1_imgarrow_OnClick()
	Dim szAcc
	
	'보유계좌 상품별 자산현황 화면으로 연결 mbact71052_t1, mbact71052_t2 참고
	if UBound(g_szList) > 1 then
		'0 종합계좌 개수
		'1 종합계좌 리스트
		'2 개별계좌개수
		'3 개별계좌 리스트(ACNo + ASNo)
		'4 개별계좌명 리스트([상품명]계좌번호)
		'5 계좌개수☆개별계좌의 그룹인덱스
		'6 선택한 계좌번호
		'7 선택한 계좌seq
		'8 비밀번호
		
		Form.SetSharedData("71052_Index" , g_szList(5) )	'계좌개수☆개별계좌의 그룹인덱스
		
		if g_szSelectAcc == "전체" then
			szAcc = "t1"
		else
			szAcc = "t1"
		end if
		
		'ELS/DLS 탭으로 설정
		szData = "5"			& "☆" & 				'0 tab인덱스
				g_szList(2)	& "☆" & 				'1 개별계좌개수(였으나, g_szList(1) 대신 g_szList(3)
				szAcc		& "☆" & 				'2 탭
				g_szSelectAcc..g_szSelectAccSeq	& "☆" & '3 선택계좌번호
				"○" & g_szList(3)	& "☆" & 		'4 개별계좌리스트
				g_szList(2)	& "☆" & 				'5 개별계좌개수
				"○" & g_szList(3)	& "☆" & 		'6 개별계좌리스트
				"○" & g_szList(4) 					'7 개별계좌리스트(계좌번호+계좌명)
		
						
		Form.OpenPopup( "mbact71052_p1" , szData , "")
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl90301_p6" then
		f_callBondOrder()
	
	elseif sKeyName == "mbfnp53100_p2" then
		Form.triggerEvent("#", "mbfnp53100_p2", "")
	end if
	
End Sub

'============================================================================
Sub contMain_gridData_OnClickUp(lRow, szCellID)
	if szCellID == "bd_sell" then		
		
		szISCD = contMain.gridData.GetCellData("ISCD",			lRow)
		szACNO = contMain.gridData.GetCellData("ACNO",			lRow)
		szASNO = contMain.gridData.GetCellData("ASNO",			lRow)
		sAcntName = contMain.gridData.GetCellData("bd_account",	lRow)
		
		sFgColor = contMain.gridData.GetCellFgColor("bd_sell", lRow)
		
		if sFgColor == "295" then
			exit sub
		end if
		
		Form.SetSharedData("53100_ACNO"  , szACNO)
		Form.SetSharedData("53100_ASNO"  , szASNO)
		Form.SetSharedData("53100_ISCD"  , szISCD)
		Form.SetSharedData("53100_TEMP21", g_sTemp21)  '원금보장여부
		Form.SetSharedData("53100_TEMP22", g_sTemp22)  '위험여부판단
		Form.SetSharedData("53100_TEMP23", g_sTemp23)  '고난도여부
		Form.SetSharedData("53100_ACNTNAME", sAcntName)  '계좌명

		Form.OpenPopupAnimation("mbfnp53100_p2", "",  "",  2)
		
	else
		szLinkData = contMain.gridData.GetCellData("ISNM", lRow)								'0 종목명
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ISCD",			lRow)	'1 종목코드
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_AMT",		lRow)	'2 평가금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("PBLC_DATE"	,	lRow)	'3 청약일
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("MTRT_DATE"	,	lRow)	'4 만기일
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("CLRD_DATE"	,	lRow)	'5 다음평가일
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("UNAS_NAME"	,	lRow)	'6 기초자산
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYNG_AMT"	,	lRow)	'7 매입금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("PRNC_GUAR_YN",	lRow)	'8 원금보장여부
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("VLTN_PRLS_AMT",	lRow)	'9 평가손익금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ERT"		,	 	lRow)	'10 수익률
		'szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("bd_date2",		lRow)	'11 발행통화

		Form.OpenPopupAnimation("mbfnp53100_p1", szLinkData,  "",  2)
		
	end if
End Sub

'============================================================================
Sub contMain_gridDataSingle_OnClickUp(lRow, szCellID)

	if szCellID == "bd_sell" then		
		
		szISCD = contMain.gridDataSingle.GetCellData("ISCD",			lRow)
