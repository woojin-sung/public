			exit sub
		end if
		
		Form.SetSharedData("53100_ACNO"  , g_szSelectAcc)
		Form.SetSharedData("53100_ASNO"  , g_szSelectAccSeq)
		Form.SetSharedData("53100_ISCD"  , szISCD)
