		Form.SetSharedData("53100_TEMP23", g_sTemp23)  '고난도여부
		Form.SetSharedData("53100_ACNTNAME", sAcntName)  '계좌명

		Form.OpenPopupAnimation("mbfnp53100_p2", "",  "",  2)
	
	else
		szLinkData = contMain.gridDataSingle.GetCellData("ISNM", lRow)								'0 종목명
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("ISCD",			lRow)	'1 종목코드
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("VLTN_AMT",		lRow)	'2 평가금액
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("PBLC_DATE"	,	lRow)	'3 청약일
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("MTRT_DATE"	,	lRow)	'4 만기일
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("CLRD_DATE"	,	lRow)	'5 다음평가일
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("UNAS_NAME"	,	lRow)	'6 기초자산
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("BYNG_AMT"	,	lRow)	'7 매입금액
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("PRNC_GUAR_YN",	lRow)	'8 원금보장여부
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("VLTN_PRLS_AMT",	lRow)	'9 평가손익금액
		szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("ERT"		,	lRow)	'10 수익률
		'szLinkData = szLinkData & "|" & contMain.gridDataSingle.GetCellData("bd_date2",		lRow)	'11 발행통화

		
		Form.OpenPopupAnimation("mbfnp53100_p1", szLinkData,  "",  2)
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.MsgBox("안내", szErrMsg.."("..szSubErr..")" , "", 6)
	else
		Form.MsgBox("안내", szErrMsg , "", 6)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obacb_balc_033r" then
		
		szToday = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "IQRY_CLS_CODE",		0, "1")
		
		if g_bEntire then
			DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "ACNO" 			 , 0 , g_sEntireAcc(g_nAcntIndex))
			DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "ASNO"		      , 0 , g_sEntireAccSeq(g_nAcntIndex))
		else
			DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "ACNO"		 ,		0, g_szSelectAcc)
			DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "ASNO"		 ,		0, g_szSelectAccSeq)
		end if
		
		DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "ACNT_PWD"	 ,		0, "")
		DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "PROS_CLS"	 ,		0, "2")
		DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "STND_DATE"	 ,		0, szToday)
		DATAMANAGER.SetDataValue(0, "obacb_balc_033r", "InBlock1", "IQRY_CNT"	 ,		0, "30")	'MY자산현황과 동일?
	
	elseif szTranID == "obacb_balc_154r" then
	
		szCsno = Form.GetSharedData("&CUST_NUM", false )

		if g_bEntire then	
			DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
		else
			DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , g_szSelectAcc)
			DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , g_szSelectAccSeq)
		end if
		
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "08")
	
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim szData, iDataCnt, iAmtSum, ievalAmt, iHeight
	Dim sCurrencyUnit
	
	if szTranID == "obacb_balc_154r" then
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , 0)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , 0)	'평가손익
		
		if CDBL(nPrlsrate) > 0 then
		
			sEstiPrice = "+"..FormatNumber(nPrlsamt,0).."원"
			sEstiRate = "+"..FormatNumber(nPrlsrate,2).."%"
					
			sEventualPrice = sEstiPrice.." | "..sEstiRate
			
			contMain.cont1.tblInfo.SetCellString(5, 2, sEventualPrice)
			contMain.cont1.tblInfo.SetCellFgColor(5, 2, "10")
			
		elseif CDBL(nPrlsrate) < 0 then
			
			sEstiPrice = FormatNumber(nPrlsamt,0).."원"
			sEstiRate = FormatNumber(nPrlsrate,2).."%"
			
			sEventualPrice = sEstiPrice.." | "..sEstiRate
			
			contMain.cont1.tblInfo.SetCellString(5, 2, sEventualPrice)
			contMain.cont1.tblInfo.SetCellFgColor(5, 2, "11")
		else
			
			sEstiPrice = FormatNumber(nPrlsamt,0).."원"
			sEstiRate = FormatNumber(nPrlsrate,2).."%"
			
			sEventualPrice = sEstiPrice.." | "..sEstiRate
			
			contMain.cont1.tblInfo.SetCellString(5, 2, sEventualPrice)
			contMain.cont1.tblInfo.SetCellFgColor(5, 2, "4")
		end if
	
	elseif szTranID == "obacb_balc_033r" then
		
'		if g_bEntire then
'			g_iDataCount = contMain.gridData.rowcount
'		else
'			g_iDataCount = contMain.gridDataSingle.rowcount
'		end if
		
		iDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" ))
		
		for i = 0 to iDataCnt - 1
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO",					i)   '계좌번호
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO",					i)   '계좌일련번호
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROD_ABWR_NAME",			i)   '계좌상품명
			
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",					i)   '종목코드
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ABRV_ISNM",				i)   '상품명
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MKSC_CLS_CODE",			i)   '상품코드
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MKSC_CLS_NAME",			i)   '상품이름(ELB/DLB/ELS/DLS)
			szTemp8  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_QTY",				i)   '잔고수량
			szTemp9  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBLC_DATE",				i)   '발행일자
			szTemp10 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE",				i)   '만기일자
			szTemp11 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYNG_AMT",				i)   '매입금액
			szTemp12 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_AMT",				i)   '평가금액
			szTemp13 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FUND_PBLC_UNPR",			i)   '펀드발행단가			
			szTemp14 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PSNT_PRC",				i)   '현재가
			szTemp15 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ERT",						i)   '수익률
			szTemp16 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_PRLS_AMT",			i)   '평가손익금액
			szTemp17 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CLRD_DATE",				i)   '조기상환일자
			szTemp18 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CLRD_DTRM_DATE",			i)   '조기상환결정일자
			
			szTemp19 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CRCD",					i)   '통화코드
			
			szTemp20 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "HLFW_RPRC_ABLE_YN",		i)   '중도환매신청가능여부
			
			szTemp21 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRNC_GUAR_YN",				i)   '원금보장여부
			
			szTemp22 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROD_GRAD_CODE",			i)   '상품등급
			szTemp23 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "HGDT_PROD_YN",				i)   '고난도상품여부
			szTemp24 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UNAS_NAME",				i)   '기초자산명
			
			'szTemp25 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSRP_ODER_ABLE_QTY",		i)   '환매가능수량
			szTemp26 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_DATE",				i)   '대출일자
			
			szTemp27 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_RMND_QTY",			i)   '매매잔고수량
			
			if g_bEntire = False then
				
				contMain.gridDataSingle.AddRow()		
				
				g_sTemp21 = szTemp21
				g_sTemp22 = szTemp22
				g_sTemp23 = szTemp23
				
				'contMain.gridDataSingle.SetCellMaxLineCount("bd_badge1", g_iDataCount + i, 1)
				'contMain.gridDataSingle.SetCellMaxLineCount("bd_badge2", g_iDataCount + i, 1)
				
				'주석 해제 해야함
				'고난도 여부
				if szTemp23 == "Y" then
					contMain.gridDataSingle.SetCellImage("bd_badge3", g_iDataCount + i, "img_bgsquare_grade_363.png")
					contMain.gridDataSingle.SetCellData("bd_badge3", g_iDataCount + i, "고난도")
					contMain.gridDataSingle.SetCellFgColor("bd_badge3", g_iDataCount + i, 384)
				end if
				
				'원금보장여부
				if szTemp21 == "Y" then
					contMain.gridDataSingle.SetCellImage("bd_badge1", g_iDataCount + i, "img_bgsquare_grade_316.png")
					contMain.gridDataSingle.SetCellData("bd_badge1", g_iDataCount + i, "원금보장형")
					contMain.gridDataSingle.SetCellFgColor("bd_badge1", g_iDataCount + i, 333)
				else
					contMain.gridDataSingle.resize = "1"
					contMain.gridDataSingle.SetCellImage("bd_badge1", g_iDataCount + i, "img_bgsquare_grade_316.png")
					contMain.gridDataSingle.SetCellData("bd_badge1", g_iDataCount + i, "원금비보장형")
					contMain.gridDataSingle.SetCellFgColor("bd_badge1", g_iDataCount + i, 333)
