'============================================================================
Sub contMain_cont1_btnSort_OnClick()
	contMain.cont1.cmbSort.openList()
End Sub

'============================================================================
Sub contMain_cont1_cmbSort_OnEditComplete(iIndex)
	select case CInt(contMain.cont1.cmbSort.currentindex)
		case 0	contMain.cont1.cmbSort.left = 230
		case 1	contMain.cont1.cmbSort.left = 260
		case 2	contMain.cont1.cmbSort.left = 245
	end select
	
	f_SortGrid()
	
'	f_sendQry()
End Sub

'============================================================================
Function f_SortGrid()
	Dim nIndex
	nIndex = CInt(contMain.cont1.cmbSort.currentindex)
	if g_bSingle then
		contMain.gridDataSingle.visible = True
		if nIndex == 0 then
			contMain.gridDataSingle.OnSortingByScript("BYOV_DATE", 0 , 0 )
		elseif nIndex == 1 then
			contMain.gridDataSingle.OnSortingByScript("bd_Title", 0 , 1 )
		else
			contMain.gridDataSingle.OnSortingByScript("bd_eval2", 0 , 0 )
		end if
	else
		contMain.gridData.visible = True
		if nIndex == 0 then
			contMain.gridData.OnSortingByScript("BYOV_DATE", 0 , 0 )
		elseif nIndex == 1 then
			contMain.gridData.OnSortingByScript("bd_Title", 0 , 1 )
		else
			contMain.gridData.OnSortingByScript("bd_eval2", 0 , 0 )
		end if
	end if
End Function


'============================================================================
'FULL 계좌명 찾기 함수
Function FindFullAcntName(sAccount, sAccountSeq)

	sComparedData = sAccount & sAccountSeq
	
	sSaveAccountList = Split(g_sSaveAccountList, "○")
	
	for i = 0 to #sSaveAccountList - 1
		if sComparedData == sSaveAccountList(i) then
			 return g_szAccountList(i)
		end if
	next
	
	return ""
End Function


