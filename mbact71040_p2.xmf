		<LABEL name="Label0" fontsize="2" fontstyle="01" caption="유의사항" bgcolor="064:188030030" halign="1" ly_vert="0,0,355,55,1" />
		<IMAGE name="imgClose" autosize="1" imgpath="icon_main_11" ly_vert="331,16,24,24,1" />
		<LABEL name="Label1" fontsize="-2" valign="0" multiline="1" ly_vert="4,61,368,389,1" />
