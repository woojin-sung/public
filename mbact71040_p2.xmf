	<SCRIPT_INFO _len="2095" _ulen="2069" >
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================

'============================================================================
Sub Form_OnFormInit()
	szAcno = Form.GetSharedData("mbact71040_p2_acno", 0)
	szAsno = Form.GetSharedData("mbact71040_p2_asno", 0)
'	Form.MsgBox("알림1", szAcno, "", 0)
'	Form.MsgBox("알림", szAsno, "", 0)
	DATAMANAGER.SetDataValue(0 , "obaci_mdia_079r" , "InBlock1" , "ACNO", 0 , szAcno)
	DATAMANAGER.SetDataValue(0 , "obaci_mdia_079r" , "InBlock1" , "ASNO", 0 , szAsno)
	DATAMANAGER.RequestTranData("obaci_mdia_079r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'Grid0.SetCellFgColor("bd_cell0", 0, "6")
	'Form.msgbox("알림", MID(DATAMANAGER.GetDataValue( 0, "obaci_mdia_079r" , "OutBlock1" , "BNKB_PHR_OTPT_NAME", 0), 1, 1), "", 0)

	For i=0 to 15
		If DATAMANAGER.GetDataValue( 0, "obaci_mdia_079r" , "OutBlock1" , "BNKB_PHR_OTPT_NAME", i) <> "" Then
			Label1.caption = Label1.caption & DATAMANAGER.GetDataValue( 0, "obaci_mdia_079r" , "OutBlock1" , "BNKB_PHR_OTPT_NAME", i)
			
			If i = 0 AND MID(DATAMANAGER.GetDataValue( 0, "obaci_mdia_079r" , "OutBlock1" , "BNKB_PHR_OTPT_NAME", 0), 1, 1) = "*" Then
				szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
				if szDeviceOS == "2" then '아이폰
					Label1.caption = Label1.caption & CHR(10) & CHR(13)
				else
					Label1.caption = Label1.caption & "\n" & "\n"
				end if 
				
			End If
			
		End If
	Next
	
	'Form.msgbox("알림", MID(DATAMANAGER.GetDataValue( 0, "obaci_mdia_079r" , "OutBlock1" , "BNKB_PHR_OTPT_NAME", 0), 1, 1), "", 0)
	If MID(DATAMANAGER.GetDataValue( 0, "obaci_mdia_079r" , "OutBlock1" , "BNKB_PHR_OTPT_NAME", i), 1, 1) = "*" Then
		Label1.ChangeTextAttr(0, 33, 1, -2, true)
	End If

	'Form.ShowAlert("아림",  DATAMANAGER.GetDataValue(0, "obaci_mdia_079r", "OutBlock1", "BNKB_PHR_OTPT_NAME" , 0))
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obaci_mdia_079r" trcode="obaci_mdia_079r" compress="1" encryption="1" inputcheck="1" useattr="0" />
