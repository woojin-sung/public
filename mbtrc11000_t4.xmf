'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szTranID, g_szFold
g_szFold = "0"
g_szTranID = "obtrc_prls_001r"

Dim g_Buffer
Dim g_switch
Dim g_Toggle1
Dim g_Toggle2
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub SetGridHeader(g_Toggle1, g_Toggle2)
	grd0.SetCellTopCaption("th_cell0", "종목명")			'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
'	if g_Toggle1 = 0 then
'		grd0.SetCellTopCaption("th_cell0", "종목명")
'	elseif g_Toggle1 = 1 then
'		grd0.SetCellTopCaption("th_cell0", "종목명▼")
'	else
'		grd0.SetCellTopCaption("th_cell0", "종목명▲")
'	end if
	
'	if g_Toggle2 = 0 then
'		grd0.SetCellTopCaption("th_cell4", "손익")
'	elseif g_Toggle2 = 1 then
'		grd0.SetCellTopCaption("th_cell4", "손익▼")
'	else
'		grd0.SetCellTopCaption("th_cell4", "손익▲")
'	end if	
End Sub
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Dim szYYYY, szMM
	'조회시작 날짜 당월 1일로 세팅
	n_date = Form.GetSharedData("&HOST_DATE" , false)
	szYYYY 	= left(n_date, 4)
	szMM 	= mid(n_date, 5, 2)
	fromdate = szYYYY & szMM & "01"
	cldFrom.caption = fromdate
	
	szFold	 = Form.LoadConfigData( "mbtrs11000_t4", "fold" )'펼침버튼
	
	If szFold <> "" Then
		If szFold = "1" Then
			g_szFold = "0"
		Else
			g_szFold = "1"
		End If
	End If
	
	btnFold_OnClick()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RECEIVE" or sEventName == "CHANGE_ACCTNO" then
		g_switch  = 0
		g_Buffer  = 0
		
		DATAMANAGER.RequestTranData( g_szTranID )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == g_szTranID then
		Dim szACNO, szASNO
		
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0, szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_STA_DATE", 0, cldFrom.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_FIN_DATE", 0, cldTo.caption )
	end if
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == g_szTranID then
		g_Toggle1 = 0
		g_Toggle2 = 0
	
		g_switch = 1
		
		Dim szData
		
		For i = 0 To grd0.rowcount -1
			'매매구분
			szData = grd0.GetCellData( "bd_cell1", i)
			
			If szData = "1" Then
				grd0.SetCellFgColor("bd_cell2", i, "11")
			Else
				grd0.SetCellFgColor("bd_cell2", i, "10")
			End If
		Next	
	end if
	
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( g_szTranID )
	
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( g_szTranID )
	
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( g_szTranID )
	
	if isMore == 1 or isMore == "0" then
		DATAMANAGER.RequestNextData( g_szTranID )
	end if
	
End Sub

'============================================================================
Sub btnFold_OnClick()
	If g_szFold = "1" Then
		g_szFold = "0"
'		btnFold.btnimage = "btn_filter2.9.png"
		btnFold.caption = "상세"
		tbl0.visible = true
		
'		grd0.top = 377
'		grd0.height = 92

		grd0.visible = false
	Else
		g_szFold = "1"
'		btnFold.btnimage = "btn_filter.9.png"
		btnFold.caption = "요약"
		
		tbl0.visible = false
		
'		grd0.top = 59
'		grd0.height = 410

		grd0.visible = true
	End If
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs11000_t4", "fold", g_szFold) 	'펼침버튼
End Sub

'============================================================================


'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	if g_switch = 1 then
		if g_Buffer = 1 then
			
			if szCellID = "th_cell0" then
				g_Toggle1 = g_Toggle1 + 1
				g_Toggle2 = 0
				
				if g_Toggle1 > 2 then
					g_Toggle1 = 0
				end if
		
				SetGridHeader(g_Toggle1, g_Toggle2)
			elseif szCellID = "th_cell4" then
'				g_Toggle1 = 0
				g_Toggle2 = g_Toggle2 + 1
				
				if g_Toggle2 > 2 then
					g_Toggle2 = 0
				end if
			
				SetGridHeader(0, g_Toggle2)
			end if
		end if
	
		g_Buffer = 1
	end if
	
	
	'20201028 LES START 보유잔고 정렬마킹
	if szCellID == "th_cell4" then	
		grdTopCaption = grd0.GetCellTopCaption("th_cell4")
		
		grd0.SetCellTopCaption("th_cell4", "손익")			'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
'		if grdTopCaption == "손익▼" then
'			grd0.SetCellTopCaption("th_cell4", "손익▲")
'		elseif grdTopCaption ==  "손익▲" then
'			grd0.SetCellTopCaption("th_cell4", "손익")
'		else
'			grd0.SetCellTopCaption("th_cell4", "손익▼")
'		end if
	end if
'	
'	
'	if szCellID == "th_cell2" or szCellID == "th_cell3" then	
'		grdTopCaption = grd0.GetCellTopCaption("th_cell2")
'				
'		if grdTopCaption == "매입수량▼" then
'			grd0.SetCellTopCaption("th_cell2", "매입수량▲")
'		elseif grdTopCaption ==  "매입수량▲" then
'			grd0.SetCellTopCaption("th_cell2", "매입수량")
'		else
'			grd0.SetCellTopCaption("th_cell2", "매입수량▼")
'		end if
'	
'	end if
End Sub



'============================================================================
Sub grd0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( g_szTranID )
	
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( g_szTranID )
		
	end if
End Sub



