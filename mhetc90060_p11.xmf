'16-03-08 YCJ 추가
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	
	if sTimerID == "0" or sTimerID == 0 then
		Form.SetTimerEvent( 0 , 0, 2)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 20 then			'1분 30~40초 정도만 적용해놓음
'			g_nTryCnt = 0
'			ButtonARS.enable = true
			Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
			Exit Sub
'			Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
		
	end if	
End Sub

