						<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="트 지연에 따른 출국정보 이용이 제한될 수 있으며, 이로" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,16,0,16" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,16,1,16" halign="0" line="0,0" caption="인하여 이체 및 인증서 발급 동의 서비스 이용이 제한될" fontsize="-2" impidxs="" />
