'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_추가인증
' 03. 작    성 : 2016.01.13 김보라
' 2020.11.24.	권오상 : v002 : 오픈뱅킹 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_IP_CONFIRM_FILE '해외체류자인증면제풀팝업
Dim G_BIO_OCSP_FILE			'공인인증서 검증 팝업

Dim g_sRevData '발급/타기관/연락처등록/연락처변경/연락처삭제/단말기등록/단말기해지 구분값
Dim g_sRetData
Dim g_sUserID, g_sMacAddress, g_sACNO 'ID, MAC주소, 계좌번호
Dim g_sSMSSeqNo 'SMS인증전문일련번호
Dim g_nTryCnt  'SMS/ARS인증검증요청횟수
Dim g_sARSSeqNo 'ARS인증전문일련번호
Dim g_DNdata 	'20210215 SWJ START : DN 변수
'-------------------------------------------------------------------------
'은행/지점개설계좌 ID등록 화면에서 팝업시 사용
'-------------------------------------------------------------------------
Dim g_sIDNextPopup	'다음 버튼 클릭시 팝업화면 파일명
Dim g_bIsFromIDReg	'True:지점개설계좌ID등록 화면에서 팝업
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array

'g_szList(0)  : "은행" / "지점"
'g_szList(1)  : [은행만 사용] 개인정보필수동의_수집/이용
'g_szList(2)  : [은행만 사용] 개인정보필수동의_조회
'g_szList(3)  : [은행만 사용] 개인정보필수동의_업무위탁
'g_szList(4)  : [은행만 사용] 개인정보필수동의_제공
'g_szList(5)  : [은행만 사용] 개인정보필수동의_고유식별정보의 처리
'g_szList(6)  : [은행만 사용] 개인정보필수동의_민감정보의 처리
'g_szList(7)  : [은행/지점 공통] 필수정보입력_고객구분("1":내국인/"2":외국인/"3":법인)
'g_szList(8)  : [은행/지점 공통] 필수정보입력_고객식별번호
'g_szList(9)  : [은행/지점 공통] 필수정보입력_계좌번호
'g_szList(10) : [은행/지점 공통] 필수정보입력_계좌비밀번호
'g_szList(11) : [은행/지점 공통] 필수정보입력_사용자ID
'g_szList(12) : [은행/지점 공통] 필수정보입력_ID비밀번호
'g_szList(13) : [지점만 사용] 보안매체종류("0":보안카드/"3":OTP)
'-------------------------------------------------------------------------

'============================================================================
' 이체화면시 받아오는 Date들		'16-03-22 YCJ 추가
'============================================================================
Dim g_szTRANSTYPE			'단건, 다건 구분 코드   01 - 단건, 02 - 다건
Dim g_szBankData			'이체처리시 필요 데이터
Dim g_szBankList			'이체시 데이터 Split 값 저장
Dim g_szMoneySum			'이체금액합

'============================================================================
' 예약이체화면시 받아오는 Date들		'16-03-24 YCJ 추가
'============================================================================
Dim g_szYeBankName		'입금은행명
Dim g_szYeName			'수취인명
Dim g_szYeMoney			'이체금액
Dim g_szYeDate			'예약이체일시

'============================================================================
' 매도담보대출화면시 받아오는 Date들		'16-03-24 YCJ 추가
'============================================================================
'Dim g_szYeBankName		'입금은행명
Dim g_szYeName			'수취인명
Dim g_szSaleMoney			'매도담보대출금액
'Dim g_szYeDate			'예약이체일시
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 전화번호 마스킹처리함수
'============================================================================
Function GetMaskNumber(sNum)
	if sNum == null or Trim(sNum) == "" then
		return sNum
	end if
	
	if #sNum <= 2 then
		return sNum
	end if
	
	Dim sMaskNum
	sMaskNum = Left(sNum, 2)
	for i = 1 to #sNum-2 
		sMaskNum = sMaskNum.."*"
	next
	
	return sMaskNum
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_bIsFromIDReg = False
	g_nTryCnt = 0
	g_sSMSSeqNo = ""
	g_sARSSeqNo = ""
	g_sRetData = "cancel"
	RadioGroup0.height = "250"
	g_sMacAddress = Form.GetSharedData("&MAC_ADDRESS", false )
	
	'2016-11-21 HWG Start - 상황별 문구 수정
	Label2.visible = true
	cont0.visible = false
	cont1.visible = true
	cont2.visible = false
	cont3.visible = false
	'2016-11-21 HWG End
	
	'20180802 LES START - 바이오인증 등록절차 변경
	G_BIO_OCSP_FILE			= "mhetc90060_p5"		'공인인증서 검증 팝업
	'20180802 LES END
	
	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")	
	
	'20210215 SWJ START
	g_DNdata = Form.GetSharedData("BIO_DNDATA", false )
	'20210215 SWJ END
	
	g_szMoneySum = 0
	'---------------------------------------------------
	'그외 화면에서 팝업시
	'---------------------------------------------------
	if UBOUND(g_szList) < 1 then

		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		
		g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
		G_IP_CONFIRM_FILE = "mhetc90060_pc" 

		Form.SetScreenName( "추가인증" )

		g_sRevData = Form.GetOpenLinkData( )
       
		'16-04-11 YCJ 공인인증서 타기관 등록시 추가 - 전요셉 과장님 요청
		'20170418 LES START - 미지정단말 공인인증서 발급 프로세스 변경
		if g_sRevData == "new" or g_sRevData == "regi" or g_sRevData == "new_otp" or g_sRevData = "regi_otp" then
			RadioGroup0.SetRadioCaption( 2, "1회용 인증번호" )
			Label2.caption = "(영업점에서 발급받은 1회용 인증번호 6자리를 입력)"
			EditNum.visible = true
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			Label2.visible = true
	         cont0.visible = true
			cont1.visible = false
			cont2.visible = false
			cont3.visible = false
			'2016-11-21 HWG End
			
			RadioGroup0.height = "319"
			
			'20170418 LES START- 미지정단말 프로세스 추가
			if g_sRevData == "new_otp" or g_sRevData =="regi_otp" then
				RadioGroup0.currentindex = 2
				RadioGroup0.enable = false
			end if
			'20170418 LES END
			
			
			
		'SMS인증/ARS인증/해외 체류자 인증면제
		elseif g_sRevData == null or g_sRevData == "" then		
			g_sRevData = "new"
		'SMS인증/ARS인증			,'16-03-08 YCJ OTP 해지일때 경우 추가
		elseif g_sRevData == "contact_regi" or g_sRevData == "contact_modi" or g_sRevData == "contact_del" or
			g_sRevData == "otp" or g_sRevData == "bank_monthlyD" then	'g_sRevData == "regi" or 
			'해외체류자인증면제 숨김
			RadioGroup0.height = "170"
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			Label2.visible = false
	         cont0.visible = false
			cont1.visible = false
			cont2.visible = false
			cont3.visible = true
			'2016-11-21 HWG End
			
		'SMS인증/ARS인증  16-03-31 YCJ 정기이체시 안내문구 수정됨.
		elseif g_sRevData == "bank_monthly" then
			'해외체류자인증면제 숨김
			RadioGroup0.height = "213"
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			Label2.visible = false
	         cont0.visible = false
			cont1.visible = false
			cont2.visible = false
			cont3.visible = true
			'2016-11-21 HWG End
		
		'SMS인증/ARS인증  16-03-31 YCJ 이용단말 추가 해지시 안내문구 수정됨.
		elseif g_sRevData == "mobile_cancel" then
			'해외체류자인증면제 숨김
			RadioGroup0.height = "170"
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			Label2.visible = false
	         cont0.visible = false
			cont1.visible = false
			cont2.visible = false
			cont3.visible = true
			'2016-11-21 HWG End
			
		'SMS인증/ARS인증/1회용인증
		elseif g_sRevData == "mobile_enroll" then '1회용인증번호
			RadioGroup0.SetRadioCaption( 2, "1회용 인증번호" )
			Label2.caption = "(영업점에서 발급받은 1회용 인증번호 6자리를 입력)"
			EditNum.visible = true
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			Label2.visible = true
	         cont0.visible = false
			cont1.visible = false
			cont2.visible = true
			cont3.visible = false
			'2016-11-21 HWG End
		
		
		
		'20161114 hwg Start - 바이오인증 	
		elseif g_sRevData == "bio_new" then
			
			'20180802 LES START - 바이오인증 등록절차 변경
			'바이오인증 등록/재등록일 경우, 공인인증서 등록 보임
			'ORGN
			'RadioGroup0.height = "170"
			'
			''2016-11-21 HWG Start - 상황별 문구 수정
			'Label2.visible = false
	         'cont0.visible = false
			'cont1.visible = false
			'cont2.visible = false
			'cont3.visible = true
			''2016-11-21 HWG End
			
			'20210215 SWJ START : 바이오인증 등록시 DN값 shared 해주는 부분 skip 위해 라디오 숨김
			if g_DNdata = "" then
				RadioGroup0.height = "170"
			else
				RadioGroup0.height = "235"
				RadioGroup0.SetRadioCaption( 2, "인증서 인증" )
			end if
			'20210215 SWJ END
			
			Label2.visible = false
	         cont0.visible  = false
		 
			'안내사항 라벨
			Label3.visible = true
			Label3.top = 290
			
			LabelLine0.visible = true
			LabelLine0.top = 319
			
			'20180816 LES STARt - cont1안에 있는 테이블문구는
			'바이오인증 전용으로 법인,법무부내용이 삭제되어있음.
			cont1.top = 325
			cont1.height = 220
			cont1.visible  = true
			
			cont2.visible  = false
			cont3.visible  = false
			'20180802 LES END - 바이오인증 등록절차 변경
		
		
		'20161114 hwg End 
		
		'20180802 LES START - 바이오인증 등록절차 변경
		'바이오인증 해지일 경우, 공인인증서 인증 숨김
		elseif g_sRevData == "bio_cancel" then
					
			RadioGroup0.height = "170"
			Label2.visible = false
	         cont0.visible = false
			cont1.visible = false
			cont2.visible = false
			cont3.visible = true
		
		end if
		'20180802 LES END - 바이오인증 등록절차 변경

		if g_sUserID ~= null and g_sUserID ~= "" then
			DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
		end if
		
	'---------------------------------------------------
	' 이체화면에서 인증이 필요한 경우	16-03-22 YCJ 추가
	'---------------------------------------------------
	elseif g_szList(0) == "bank_61010" Or g_szList(0) == "bank_opn" then
	
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
		G_IP_CONFIRM_FILE = "mhetc90060_pc" 
		
		for i = 0 to g_szList(1) - 1
			grd0.AddRow()
			grd0.SetCellData( "bd_cell0", i, g_szList(4*(i+1) - 2))
			grd0.SetCellData( "bd_cell1", i, g_szList(4*(i+1) - 1))
			grd0.SetCellData( "bd_cell2", i, g_szList(4*(i+1) ))
			grd0.SetCellData( "bd_cell3", i, g_szList(4*(i+1) + 1))
			
			g_szMoneySum = g_szMoneySum + CDbl(grd0.GetCellData( "bd_cell3", i))
		next
		grd0.rowcount = g_szList(1)
		DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
	'---------------------------------------------------
	' 예약이체화면에서 인증이 필요한 경우	16-03-24 YCJ 추가
	'---------------------------------------------------
	elseif g_szList(0) == "bank_reservation" then
	
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
		G_IP_CONFIRM_FILE = "mhetc90060_pc" 
	
		g_szYeBankName = g_szList(1)		'입금은행명
		g_szYeName = g_szList(2)		'수취인명
		g_szYeMoney = g_szList(3)			'이체금액
		g_szYeDate = g_szList(4)			'예약이체일시
	
		DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
	'---------------------------------------------------
	' 예탁담보신청화화면에서 인증이 필요한 경우	16-03-24 YCJ 추가
	'---------------------------------------------------	
	elseif g_szList(0) == "deposit_loan" then	
		
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
		G_IP_CONFIRM_FILE = "mhetc90060_pc" 
		
		for i = 0 to g_szList(1) - 1
			grd1.AddRow()
			grd1.SetCellData( "bd_cell0", i, g_szList(3 * (i+1) - 1))
			grd1.SetCellData( "bd_cell1", i, g_szList(3 * (i+1) ) )
			grd1.SetCellData( "bd_cell2", i, g_szList(3 * (i+1) + 1))
			
			g_szMoneySum = g_szMoneySum + CDbl(grd1.GetCellData( "bd_cell2", i))
		next
		grd1.rowcount = g_szList(1)
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
	'---------------------------------------------------
	' 매도담보신청화면에서 인증이 필요한 경우	16-03-24 YCJ 추가
	'---------------------------------------------------	
	elseif g_szList(0) == "sale_loan" then	
		
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
		G_IP_CONFIRM_FILE = "mhetc90060_pc" 
		
		g_szSaleMoney = g_szList(1)		'매도담보대출신청금액
		g_szYeName = g_szList(2)		'매도인성명
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
	'---------------------------------------------------
	'은행/지점개설계좌 ID등록 화면에서 팝업시
	'---------------------------------------------------
	else
		g_bIsFromIDReg = True
		Form.SetScreenName(g_szList(0) & "개설계좌 ID등록")
		
		if g_szList(0) == "은행" then
			g_sIDNextPopup = "mhetc90020_p7" 
		elseif g_szList(0) == "지점" then
			if g_szList(13) == "3" then		'OTP
				g_sIDNextPopup = "mhetc90060_pb" 
			elseif g_szList(13) == "0" then	'보안카드
				g_sIDNextPopup = "mhetc90060_p9" 
			end if
		end if	
		
		'ID기준이 아닌 계좌번호 기준으로 조회하기 위해 ID를 비워 보낸다. 
		g_sUserID = ""
		g_sACNO = g_szList(9)
		
		'해외체류자인증면제 숨김
		RadioGroup0.height = "260"
		Label2.visible = true

         '2016-11-21 HWG Start - 상황별 문구 수정
		cont0.visible = false
		cont1.visible = false
		cont2.visible = false
		cont3.visible = false
			
		Label2.caption = "* 휴대폰 SMS인증 시 통신사의 사정에 따라 전송이 지연될 수 있습니다."
		Label2.width = 360
		Label2.left = 3
		Label2.top = 302
		'2016-11-21 HWG End
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
	End if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_IP_CONFIRM_FILE or sKeyName == g_sIDNextPopup then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	
	'20180802 LES START - 바이오인증 등록절차 변경
	elseif sKeyName == G_BIO_OCSP_FILE then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	'20180802 LES END	
	
	'16-03-08 YCJ 추가 수정본
	elseif sKeyName == "ARSTry" then			'ARS 인증 재시도
		g_nTryCnt = 0
		DATAMANAGER.RequestTranData( "obcsb_oimf_611a" ) ''ARS요청조회
	elseif sKeyName == "ReSelect" then			'인증수단 재선택
		g_nTryCnt = 0
		ButtonARS.enable = true
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ACNO" , 0 , g_sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID() )
'		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "MAC_ADDR" , 0 , g_sMacAddress )
		
		'100:인증서신규 101:인증서재발급 102:타행인증서등록 ... 200:이체		
		if g_sRevData == "new" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "100" ) '인증서신규
		elseif g_sRevData == "regi" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "102" ) '타행인증서등록
		elseif g_sRevData == "contact_regi" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '연락처변경
		elseif g_sRevData == "contact_modi" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '연락처변경
		elseif g_sRevData == "contact_del" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '연락처변경
		elseif g_sRevData == "mobile_enroll" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '단말기등록
		elseif g_sRevData == "mobile_cancel" then 
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '단말기해지
		elseif g_sRevData == "bank_monthly" or g_sRevData == "bank_monthlyD" then 'or g_sRevData == "bank_reservation" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '정기이체
		elseif g_sRevData == "bio_new" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '20161114 hwg - 바이오인증 신규
		elseif g_sRevData == "bio_cancel" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '20161114 hwg - 바이오인증 신규
		end if
		
		if g_szList(0) == "bank_61010" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '이체	16-03-22 YCJ 추가
		elseif g_szList(0) == "bank_opn" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "500" ) 'v002
		elseif g_szList(0) == "bank_reservation" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '예약이체
		elseif g_szList(0) == "deposit_loan" or g_szList(0) == "sale_loan" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "PROS_CLS" , 0 , "3" ) '예탁담보대출신청
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "400" )
		end if
	elseif szTranID == "obcsb_oimf_613a" then
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "3" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_ARCD" , 0 , LabelPhone1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_TONO" , 0 , LabelPhone2.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_SRNO" , 0 , LabelPhone3.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "SVCD" , 0 , "000" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ACNO" , 0 , g_sACNO )
		
		if g_sRevData == "bank_monthly" then
			sACNONM = Form.GetSharedData("BANK_ACNONM" , true)
			sBANKN = Form.GetSharedData("BANK_NAME", true )
			sAMT = Form.GetSharedData("BANK_AMT" , true)
			
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "PROS_CLS" , 0, "2")	'1:예약이체, 2:자동이체
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , sBANKN )	'입금은행명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "RMT_NAME" , 0 , sACNONM )	'수취인명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1" )	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_AMT_SMTN" , 0 , sAMT )	'금액합계
		elseif g_szList(0) == "bank_61010" Or g_szList(0) == "bank_opn" then '이체	16-03-22 YCJ 추가, v002
'			sBANKNAME = Form.GetSharedData("BANK_NAME" , true)		'맨위의 은행명
'			sACNONM = Form.GetSharedData("BANK_ACNONM" , true)		'맨위의 수취인명
'			sTOTALGUN = Form.GetSharedData("BANK_TOTALGUN" , true)		'grdcount
'			sAMTSUM = Form.GetSharedData("BANK_AMTSUM" , true)		'금액합계
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd0.GetCellData( "bd_cell0", 0) )	'입금은행명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "RMT_NAME" , 0 , grd0.GetCellData( "bd_cell2", 0) )	'수취인명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_TOTAL_CSNU" , 0 , grd0.rowcount )	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_AMT_SMTN" , 0 , g_szMoneySum )	'금액합계
		elseif g_szList(0) == "bank_reservation" then	'16-03-24 YCJ 예약이체 추가
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "PROS_CLS" , 0 , "1" )	'처리구분 1:예약이체, 2:자동이체
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , g_szYeBankName )	'입금은행명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "RMT_NAME" , 0 , g_szYeName )	'수취인명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1" )	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_AMT_SMTN" , 0 , g_szYeMoney )	'금액합계
		elseif g_szList(0) == "deposit_loan" then '예탁담보대출신청	16-03-24 YCJ 추가
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "PROS_CLS" , 0 , "3" )	'처리구분
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "RMT_NAME" , 0 , grd1.GetCellData( "bd_cell1", 0) )	'계좌명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_TOTAL_CSNU" , 0 , grd1.rowcount )	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_AMT_SMTN" , 0 , CDbl(g_szMoneySum) )	'대출금액합계
		elseif g_szList(0) == "sale_loan" then '매도담보대출신청	16-03-24 YCJ 추가
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "PROS_CLS" , 0 , "3" )	'처리구분
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_AMT_SMTN" , 0 , g_szSaleMoney )	'대출금액합계
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1" )	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "RMT_NAME" , 0 , g_szYeName )	'계좌명
		end if
	elseif szTranID == "obcsb_oimf_615r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )	
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "SMS_ATHN_NO" , 0 , EditSMSNum.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "ACNO" , 0 , g_sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
	elseif szTranID == "obcsb_oimf_611a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "PROS_CLS" , 0 , "1" ) '미사용
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )	
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "ACNO" , 0 , g_sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "CUST_TELNO" , 0 , ComboARS.cbkeydata ) '
		
		if g_bIsFromIDReg == True then	'은행/지점개설계좌 ID등록 화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "01" )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "02" ) 
		end if
		
		'01:공인인증서 발급 02:공인인증서 재발급 03:타행 공인인증서 등록 04:타행 공인인증서 해지 
		if g_sRevData == "new" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "02" ) '공인인증서관리
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "01" ) '공인인증서 발급
		elseif g_sRevData == "regi" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "02" ) '공인인증서관리
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "03" ) '타행 공인인증서 등록
		elseif g_sRevData == "contact_regi" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "06" ) '연락처변경
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "01" ) '연락처변경
		elseif g_sRevData == "contact_modi" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "06" ) '연락처변경
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "01" ) '연락처변경
		elseif g_sRevData == "contact_del" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "06" ) '연락처변경
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "01" ) '연락처변경
		elseif g_sRevData == "mobile_enroll" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "03" ) '단말기등록
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "01" ) '단말기등록
		elseif g_sRevData == "mobile_cancel" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "03" ) '단말기해지
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "02" ) '단말기해지
		elseif g_sRevData == "otp" then			'16-03-08 YCJ OTP 해지일때 경우 추가
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "07" ) '서비스관리
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "09" ) 'OTP해지
		elseif g_sRevData == "bank_monthly" or g_sRevData == "bank_monthlyD" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "05" ) '이체 == 대체이체
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "05" ) '자동이체

			sACNONM = Form.GetSharedData("BANK_ACNONM" , true)
			sBANKN = Form.GetSharedData("BANK_NAME", true )
			sAMT = Form.GetSharedData("BANK_AMT" , true)
			sFromYM = Form.GetSharedData("BANK_FROMYM" , true)
			sToYM = Form.GetSharedData("BANK_TOYM" , true)
		
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , 0 , sACNONM )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , sBANKN )	'은행명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , 0 , sAMT )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
'			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_AMT_SMTN" , 0 , sAMT )	'
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RSEV_TACT_YMDH" , 0 , sFromYM )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_ATMT_TACT_YMDH" , 0 , sToYM )
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , 0)	'반복개수
		'20161114 hwg Start - 바이오인증 추가
		elseif g_sRevData == "bio_new" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "07" ) '바이오인증관리
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "17" ) '바이오인증 발급
		'20161114 hwg End 	
		'20161114 hwg Start - 바이오인증 추가
		elseif g_sRevData == "bio_cancel" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "07" ) '바이오인증관리
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "18" ) '바이오인증 발급
		'20161114 hwg End 	
		end if
		
		'16-03-25 ARS 신 버전의 내용에서는 총건수가 없을경우 구 버전 멘트가 나옴.
		if g_szList(0) == "bank_reservation" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "05" ) '이체
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "03" ) '예약이체
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , g_szYeBankName)	'입금은행명
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , 0 , g_szYeName)	'수취인명
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , 0 , g_szYeMoney)	'이체금액
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_RSEV_TACT_YMDH" , 0 , g_szYeDate)	'예약이체일시
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , 0)	'반복개수
		elseif g_szList(0) == "bank_61010" then		'이체 16-03-22 YCJ추가
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "05" ) '이체
			
			g_szTRANSTYPE = Form.GetSharedData("BANK_TRANSTYPE", false )
			
			if g_szTRANSTYPE == "01" then	'단건이체
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , g_szTRANSTYPE ) 
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd0.GetCellData( "bd_cell1", 0) ) '입금은행코드
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , i , grd0.GetCellData( "bd_cell2", 0 ) ) '수취인명
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , grd0.GetCellData( "bd_cell3", 0) ) '이체금액
				DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , 0 ) '반복개수
			elseif g_szTRANSTYPE == "02" then	'다건이체
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , g_szTRANSTYPE ) 
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd0.GetCellData( "bd_cell1", 0) ) '입금은행코드
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , i , grd0.GetCellData( "bd_cell2", 0 ) ) '수취인명
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , grd0.GetCellData( "bd_cell3", 0) ) '이체금액
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , grd0.rowcount ) '총 건수
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_AMT_SMTN" , 0 , CDbl(g_szMoneySum) ) '이체금액합
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , grd0.rowcount ) '반복개수
				for i = 0 to grd0.rowcount - 1
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock2", "UI_MNRC_BANK_NAME" , i , grd0.GetCellData( "bd_cell1", i) ) '입금은행코드
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock2", "RMT_NAME" , i , grd0.GetCellData( "bd_cell2", i) ) '수취인명
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock2", "TACT_AMT" , i , grd0.GetCellData( "bd_cell3", i) ) '이체금액
				next
			end if
		elseif g_szList(0) == "deposit_loan" then	'예탁담보대출
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "05" ) '이체
			
			if grd1.rowcount == "1" then	
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "06" ) '예탁담보대출 단건
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd1.GetCellData( "bd_cell0", 0) ) '대출종목명
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , 0 , grd1.GetCellData( "bd_cell1", 0) ) '계좌명
				DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , 0 ) '반복개수
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , 0 , CDbl(g_szMoneySum) ) '대출금액
			else
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "07" ) '예탁담보대출 다건
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd1.GetCellData( "bd_cell0", 0) ) '대출종목명 - 대표로 가장 첫번째 종목
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , grd1.rowcount ) '총 건수
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_AMT_SMTN" , 0 , CDbl(g_szMoneySum) ) '대출금액합
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , 0 , grd1.GetCellData( "bd_cell1", 0) ) '계좌명
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , grd1.rowcount ) '반복개수
				for i = 0 to grd1.rowcount - 1
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock2", "UI_MNRC_BANK_NAME" , i , grd1.GetCellData( "bd_cell0", i) ) '대출종목명
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock2", "TACT_AMT" , i , grd1.GetCellData( "bd_cell2", i) ) '대출금액
				next
			end if
		elseif g_szList(0) == "sale_loan" then	'매도담보대출
'			Dim szSAccName
'			szSAccName = Form.GetSharedData( "Sale_Name", false )
			
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "05" ) '이체
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "08" ) '매도담보대출 단건
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , g_szSaleMoney ) '대출금액
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , 0 , g_szYeName ) '계좌명
		elseif g_szList(0) == "bank_opn" then		'v002
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "12" ) '오픈뱅킹
			
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , g_szTRANSTYPE ) 
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd0.GetCellData( "bd_cell1", 0) ) '입금은행코드
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , i , grd0.GetCellData( "bd_cell2", 0 ) ) '수취인명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , grd0.GetCellData( "bd_cell3", 0) ) '이체금액
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , 0 ) '반복개수
		end if
	elseif szTranID == "obcsb_oimf_612r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "PROS_CLS" , 0 , "1" ) '미사용
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "ACNO" , 0 , g_sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "ARS_ATHN_TLMS_UNIQ_NO" , 0 , g_sARSSeqNo )
	
	'20160516 LKM START
	'1회용인증번호 검증 
	elseif szTranID == "obcsb_oimf_609r" then
	
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "PROS_CLS" ,			0 , "1" ) 			'처리구분
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "ELFN_ID"  , 		0 , g_sUserID ) 			'ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "ACNO", 				0 , g_sACNO ) 			'계좌번호 
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "UI_CUST_ATHN_NO"	,	0 , Trim(EditNum.caption) )	'1회용인증번호
		
		'20170424 LES START - 단말ONLY 미지정단말일 경우에만 처리구분코드를 넘긴다.
		'Form.ShowAlert("test",g_sRevData )
		if  g_sRevData == "new_otp" or g_sRevData = "regi_otp" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "PROS_CLS_CODE" ,		0 , "1" )
		end if
		'20170424 LES END
		
		
	'20160516 LKM END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		Dim sCLPH_ARCD, sCLPH_TONO, sCLPH_SRNO, sOWHS_ARCD, sOWHS_TONO, sOWHS_TLPH_SRNO, sWRPL_TLPH_ARCD, sWRPL_TLPH_TONO, sWRPL_TLPH_SRNO
		sCLPH_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_ARCD" , 0 )
		sCLPH_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_TONO" , 0 )
		sCLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_SRNO" , 0 )
		
		sOWHS_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "OWHS_ARCD" , 0 )
		sOWHS_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "OWHS_TONO" , 0 )
		sOWHS_TLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "OWHS_TLPH_SRNO" , 0 )
		
		sWRPL_TLPH_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "WRPL_TLPH_ARCD" , 0 )
		sWRPL_TLPH_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "WRPL_TLPH_TONO" , 0 )
		sWRPL_TLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "WRPL_TLPH_SRNO" , 0 )
		
		if sCLPH_ARCD ~= null and Trim(sCLPH_ARCD) ~= "" then
			ComboARS.cbadddatatext = sCLPH_ARCD..sCLPH_TONO..sCLPH_SRNO.."`"..sCLPH_ARCD.."-"..GetMaskNumber(sCLPH_TONO).."-"..GetMaskNumber(sCLPH_SRNO)
			EditSMSPhone.caption = sCLPH_ARCD.."-"..GetMaskNumber(sCLPH_TONO).."-"..GetMaskNumber(sCLPH_SRNO)
		end if
		
		if sOWHS_ARCD ~= null and Trim(sOWHS_ARCD) ~= "" then
			ComboARS.cbadddatatext = sOWHS_ARCD..sOWHS_TONO..sOWHS_TLPH_SRNO.."`"..sOWHS_ARCD.."-"..GetMaskNumber(sOWHS_TONO).."-"..GetMaskNumber(sOWHS_TLPH_SRNO)
		end if
		
		if sWRPL_TLPH_ARCD ~= null and Trim(sWRPL_TLPH_ARCD) ~= "" then
			ComboARS.cbadddatatext = sWRPL_TLPH_ARCD..sWRPL_TLPH_TONO..sWRPL_TLPH_SRNO.."`"..sWRPL_TLPH_ARCD.."-"..GetMaskNumber(sWRPL_TLPH_TONO).."-"..GetMaskNumber(sWRPL_TLPH_SRNO)
		end if
	elseif szTranID == "obcsb_oimf_613a" then
		g_sSMSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_613a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
	elseif szTranID == "obcsb_oimf_615r" then
		if g_sRevData == "mobile_enroll" or g_sRevData == "mobile_cancel" then
			Form.SetSharedData("MobileCertRadio" , "1")
			Form.SetSharedData("MobileCertNumber" , EditSMSNum.caption)
		end if
		
		if g_bIsFromIDReg == True then	'은행/지점개설계좌 ID등록 화면에서 팝업시
			Form.OpenFramePopup( g_sIDNextPopup , g_sSendData , sPosInfo)
		else
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
		
	elseif szTranID == "obcsb_oimf_611a" then
		g_sARSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_611a", "OutBlock1", "ARS_ATHN_TLMS_UNIQ_NO" , 0 )
		Form.SetTimerEvent( 0 , 1, 5)			'16-03-08 YCJ 추가, 현재 사용 안되고 있음 확인 필요
	elseif szTranID == "obcsb_oimf_612r" then
		if g_sRevData == "mobile_enroll" or g_sRevData == "mobile_cancel" then
			Form.SetSharedData("MobileCertRadio" , "3")
		end if
		
		if g_bIsFromIDReg == True then	'은행/지점개설계좌 ID등록 화면에서 팝업시
			Form.OpenFramePopup( g_sIDNextPopup , g_sSendData , sPosInfo)
		else
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
'20160516 LKM START
	'1회용인증번호 
	elseif szTranID == "obcsb_oimf_609r" then
		g_sRetData = "ok"
		Form.CloseForm( )
'21060516 LKM END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_oimf_615r" then
		if szErrCode == "3021" then '수신대기중
			g_nTryCnt = g_nTryCnt+1
			if g_nTryCnt < 10 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) 'SMS인증번호검증
			else
				g_nTryCnt = 0
				Form.MsgBox( "안내", "SMS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
			end if
		else '인증실패
			g_nTryCnt = 0
			Form.MsgBox( "안내", "SMS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
		end if
	'16-03-08 YCJ 수정 내용
	elseif szTranID == "obcsb_oimf_611a" then
		ButtonARS.enable = true
	elseif szTranID == "obcsb_oimf_612r" then
		if szErrCode == "3021" then '수신대기중
			Form.SetTimerEvent( 0, 1, 5)
		else
			Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
		end if
	elseif szTranID == "obcsb_oimf_613a" then
		Form.ShowAlert("알림", szErrMsg)
'			g_nTryCnt = g_nTryCnt+1
'			if g_nTryCnt < 8 then
'				DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
'			else
'				g_nTryCnt = 0
'				ButtonARS.enable = true
'				Form.SetTimerEvent(0, 0, 5)
'				Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
''				Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'			end if
'		else
'			g_nTryCnt = 0
'			ButtonARS.enable = true
'			Form.SetTimerEvent(0, 0, 5)
'			Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
'		end if
'	end if

'	elseif szTranID == "obcsb_oimf_611a" then		'16-03-08 YCJ 수정전 원본
'		ButtonARS.enable = true
'	elseif szTranID == "obcsb_oimf_612r" then
'		if szErrCode == "3021" then '수신대기중
'			g_nTryCnt = g_nTryCnt+1
'			if g_nTryCnt < 40 then
'				DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
'			else
'				g_nTryCnt = 0
'				ButtonARS.enable = true
'				Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'			end if
'		else
'			g_nTryCnt = 0
'			ButtonARS.enable = true
'			Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'		end if

'20160516 LKM START
	'1회용인증번호 
	elseif szTranID == "obcsb_oimf_609r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
'20160516 LKM END

	end if
End Sub
 
 '============================================================================
Sub RadioGroup0_OnClick(nIndex)
	ButtonSMS.enable = false
	EditSMSNum.enable = false
	ComboARS.enable = false
	ButtonARS.enable = false
	EditNum.enable = false
	
	if nIndex == 0 then 'SMS인증
		ButtonSMS.enable = true
	elseif nIndex = 1 then 'ARS인증
		ComboARS.enable = true
		ButtonARS.enable = true
	else '해외체류자인증면제/1회용인증번호
		if nIndex = 2 then
			EditNum.enable = true
		end if
		if g_sRevData == "mobile_enroll" then
			EditNum.enable = true
		end if
	end if 
End Sub

'============================================================================
Sub ButtonSMS_OnClick()
	if EditSMSPhone.caption == null or EditSMSPhone.caption == "" then
		Form.MsgBox( "안내", "고객 연락처 변경 화면에서 휴대폰 번호를 입력하신 후 사용 가능합니다.", "", 6 )
	else
		g_nTryCnt = 0
		g_sSMSSeqNo = ""
		EditSMSNum.enable = true
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_613a" ) ''인증번호요청조회
	end if
End Sub

'============================================================================
Sub ButtonARS_OnClick()
	if ComboARS.caption == null or ComboARS.caption == "" then
		Form.MsgBox( "안내", "고객 연락처 변경 화면에서 휴대폰 번호를 입력하신 후 사용 가능합니다.", "", 6 )
	else
		g_nTryCnt = 0
		g_sARSSeqNo = ""
		ButtonARS.enable = false
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_611a" ) ''ARS요청조회
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if RadioGroup0.currentindex == "0" then 'SMS인증
		if EditSMSNum.caption == null or EditSMSNum.caption == "" then
			Form.MsgBox( "안내", "SMS 인증번호를 입력하세요.", "", 6 )
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) 'SMS인증번호검증
		end if
	elseif RadioGroup0.currentindex == "1" then 'ARS인증
		if ButtonARS.enable == "1" or ButtonARS.enable == true then
			Form.MsgBox( "안내", "ARS인증 후 사용 가능합니다.", "", 6 )
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
		end if
	else '해외체류자인증면제/1회용인증번호
	
'20160516 LKM START
'아래 사항에 대한 오류 수정
'1) 해외체류 선택시 1회용인증번호 메시지 출력
'2) 1회용인증번호 선택시 1회용인증번호 검증 누락 
		
		'1회용인증번호 
		if RadioGroup0.currentindex == "2" and RadioGroup0.GetRadioCaption( 2 ) == "1회용 인증번호" then
			
			if EditNum.caption == null or EditNum.caption == "" then
				Form.MsgBox( "안내", "1회용 인증번호를 입력하세요.", "", 6 )
				exit sub 
			else
				if Len(EditNum.caption) < 6 then
					Form.MsgBox( "안내", "1회용 인증번호 6자리를 입력하세요.", "", 6 )
					exit sub 
				end if
				
				DATAMANAGER.RequestTranData( "obcsb_oimf_609r" ) '1회용인증번호 검증 
			
			end if
			
		
		'20180802 LES START - 바이오인증 등록절차 변경
		elseif RadioGroup0.currentindex == "2" and RadioGroup0.GetRadioCaption( 2 ) == "인증서 인증" then
			sSendData =g_sRevData&"★"& Form.GetSharedData("CERT_ID" , false) &"★"& Form.GetSharedData("BIO_DNDATA", false )
			Form.OpenFramePopup( G_BIO_OCSP_FILE,  sSendData, "")
			
		'20180802 LES END -바이오인증 등록절차 변경
			
		
		'해외체류 
		else
			Form.OpenFramePopup( G_IP_CONFIRM_FILE , "" , "" )
		end if 
		
	
'ORG
'		if g_sRevData == "mobile_enroll" or RadioGroup0.GetRadioCaption( 2 ) == "1회용 인증번호" then
'			if EditNum.caption == null or EditNum.caption == "" then
'				Form.MsgBox( "안내", "1회용 인증번호를 입력하세요.", "", 6 )
'			else
'				if Len(EditNum.caption) < 6 then
'					Form.MsgBox( "안내", "1회용 인증번호 6자리를 입력하세요.", "", 6 )
'				else
'					if g_sRevData == "mobile_enroll" or g_sRevData == "mobile_cancel" then
'						Form.SetSharedData("MobileCertRadio" , "4")
'						Form.SetSharedData("MobileCertNumber" , EditNum.caption)
'					end if
'					
'					g_sRetData = "ok"
'					Form.CloseForm( )
'				end if
'			end if
'		else
'			Form.OpenFramePopup( G_IP_CONFIRM_FILE , "" , "" )
'		end if

'20160516 LKM END
	end if
End Sub

