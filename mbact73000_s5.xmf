DIM DEF_1ST_TIME
DIM DEF_2ST_TIME

DEF_1ST_TIME = 0.5
DEF_2ST_TIME = 1.0


'============================================================================
Sub Form_OnFormInit()
	gRcvnDate  = Form.GetSharedData("&HOST_DATE", false )
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	szTheme  = Form.GetEnvData("common.theme")
	
	if g_OsType == "1" then
		g_szOSType =  "112"			'안드로이드
	else
		g_szOSType = "111"			'IOS
	end if
	
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	'JMY 안내문구 설정(1개의 Label로 통합)
	ContMain.Label5.caption = "고객님 명의의 금융기관 본인계좌로 인증합니다.\n인증번호 3자리가 포함된 입금자명으로 1원을 보내드립니다."
	
	'**************
	' 컨트롤 셋팅
	'**************		
	ContMain.Label5.fgcolor = 269
	'ContMain.Label4.fgcolor = 269
	'ContMain.Label6.fgcolor = 269
	
	'다음버튼 비활성화
	BtnNext.enable  = False
	If szTheme == "black" Then
		BtnNext.btnimage = "btn_27.9" '"btn_21.9"
	Else
		BtnNext.btnimage = "btn_21.9"
	End If 
	BtnNext.fgcolor = "269"
     
     ContMain.Edit0.hintcaption = "숫자만 입력해주세요." '2021.05.01. 김유경. 개선사항 추가 (컨트롤에서 스크립트로 변경)
	ContMain.Edit1.setApplyLabel   ("금융기관" ,0 , 268 , "left" , false)
	ContMain.Edit0.setApplyLabel   ("계좌번호" ,0 , 268 , "left" , false)
			
	'테스트용 인증스킵 체크
    nDev = Form.GetSharedData("&SERVER_MODE", False )
    
    If nDev == "1" Or nDev == 1 Then
        chkSkip.visible = True
        'chkSkip.checkstate = "1"  '자동체크 해제
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If
    
	'**************
	' 데이터 셋팅
	'**************
'	gPageID	= "4" '단계
'	sNmetBswrGb = Form.GetSharedData("BDM_NMETBSWRGB", false )  '100.비대면계좌개설 000.비대면업무신청 300.모바일OTP발급
	gRCNO       = Form.GetSharedData("BDM_RCNO_PIP"  , false ) '주민등록번호
	'gBackYN	   = Form.GetSharedData("BDM_BACK_YN"   , true  ) 'Y: 본인계좌인증(2/2) 에서 넘어옴
	'gRegUniqNo  = Form.GetSharedData("BDM_REG_UNIQ_NO"	 , false ) '등록고유번호
	
	'If sNmetBswrGb == "100" Then
	'	ImgF.visible = True
	'Else
		ImgF.visible = False
	'End If
		
	'20210216 HWG
	ContMain.Button0.bringFront("0")
	
	g_sz_HPNo = Form.GetSharedData("&PHONE_NUMBER"  , false )	'기기정보에서 읽어온 휴대폰번호(P로 시작하면 핸드폰번호, R로 시작하면 단말ID)
	
	DATAMANAGER.ClearInputData(0, "obtss_arss_101r")
	'DATAMANAGER.ClearInputData(0, "obaci_acct_049c")
	DATAMANAGER.ClearInputData(0, "obtss_opnf_101a")
	'DATAMANAGER.ClearInputData(0, "obaci_nmet_013a")
	'DATAMANAGER.ClearInputData(0, "obaci_acct_301a")
End Sub

'============================================================================
Sub ContMain_Button0_OnClick()
	Form.OpenPopupAnimation("mbbdm85170_p1" , "pass"  ,"","2")
	ContMain.Edit0.caption = ""
End Sub

