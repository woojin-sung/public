'----------------------------------------------------------------------------
' 01. 화 면 명 : 해외현재가 주문팝업창
' 02. 화면설명 : 해외현재가 주문팝업창
' 03. 작    성 : 2023.05.11 신규작성 KKM
'----------------------------------------------------------------------------

Dim g_szCode, g_szMarket, g_nSelectRow, g_PrePrc, g_rtChk

'============================================================================
Function f_SetPrice_UI(nRow, szState)
	dim nSelectPrc, nSelectRate
	dim szColorValue
	
	nSelectPrc = CDbl(hogaTbl.GetCellString( nRow, 2 ))

	if nSelectPrc > 0 then
		if nSelectPrc-g_PrePrc == 0 then
			nSelectRate = 0
		else
			nSelectRate = CDbl(FormatNumber(((nSelectPrc-g_PrePrc)/g_PrePrc) * 100 , 2))
		end if
		
		if nSelectRate > 0 then
			szColorValue = "10"
		elseif nSelectRate < 0 then
			szColorValue = "11"
		else
			szColorValue = "12"
		end if
		
		'20230420 KKM : 현재가열 색상컬러 변경 START		
	'	lblLine.SetCellString( 1, 1, nSelectPrc )
		lblLine.SetCellString( 1, 1, hogaTbl.GetCellString( nRow, 2 ) )
		lblLine.SetCellFgColor( 1, 1, szColorValue )
		
		
		'lblLine.SetCellString(1, 2, nSelectRate )
		lblLine.SetCellString(1, 2, hogaTbl.GetCellString( nRow, 3 ) )
		'20230420 KKM : 현재가열 색상컬러 변경 END		
		
		dim sStr, sFontColor
		
		if nRow < 10 then
			sStr = "매도 " & 10-nRow & "호가"
			sFontColor = "11"
		else
			sStr = "매수 " & nRow-9 & "호가"
			sFontColor = "10"
		end if

		lblLine.SetCellString(0, 1, sStr ) '20230420 KKM : 현재가열 색상컬러 변경
	'	lblLine.SetCellFgColor( 0, 1, sFontColor )
	else
		if szState == "UP" then
			g_nSelectRow = nRow + 1
		elseif szState == "DOWN" then
			g_nSelectRow = nRow - 1
		end if
	end if
	
End Function

'============================================================================
'매도/매수 버튼 누를시
'============================================================================
Function SendOrder( szTab, szPrice )
	Dim szData, nPrice
	'20230524 KKM START : 선택된 값 명확하게 보내지도록 수정
	if Trim(szPrice) = "" then
		nPrice = lblLine.GetCellString(1, 1)
	else
		nPrice = szPrice
	end if 
	'20230524 KKM END 	
	
	' 전달내용/탭위치/종목코드/가격
'	szData = "현재가" & "★" & szTab & "★" & g_sCode & "★" & g_nSelectPrice
	Form.SetSharedData("PRICE" , nPrice)
	szData = szTab
	
	'20200331 HWG START : 고유MTS
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false)

	if szMediaCode = "156" or szMediaCode = "157" then
	'20211203 HSZ START : 해외CFD 
		g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			
		If g_szScreenNo = "16100" then
			Form.OpenScreen("16200" , szData)
		else
			Form.OpenScreen( "16060" , szData )
		end if
	elseif szMediaCode = "158" or szMediaCode = "159" then
		Form.OpenScreen( "02000" , szData )
	end if
	
	Form.CloseForm()	
End Function

'============================================================================
Function f_RequestRealTran()
	' 실시간 연결
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_szCode )
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , g_szCode)
	'DATAMANAGER.SetDataValue( 1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD" , 0 , g_szCode ) 
	'DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_szCode ) 
		
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	DATAMANAGER.RequestRealData( "ohhts_exst_aspr" )
	'DATAMANAGER.RequestRealData( "ohhts_exst_cnta" ) 
	'DATAMANAGER.RequestRealData( "ohhts_exst_cntd" ) 
	
End Function
'============================================================================
Sub Form_OnFormInit()
	szOpen = Form.GetOpenLinkData()
	
	if szOpen <> "" and szOpen <> null then
		Dim tHogaData
		tHogaData = Split(szOpen,"★" )
		'nTop = hogaData(0)
		'btnSell.top = nTop
		'btnBuy.top  = nTop
		'lblLine.top  = nTop
		'lblLine.SetCellString(0, 0, hogaData(1))
		'lblLine.SetCellString(0, 1, hogaData(2))
		 
		g_nSelectRow = CInt(tHogaData(0))
		g_szCode = tHogaData(1)
		g_szMarket = tHogaData(2)
		'Form.ShowAlert("", g_nSelectRow)
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		DATAMANAGER.RequestTranData( "ohhts_6000_002r" )			
	end if
End Sub

'============================================================================
'Sub Form_OnLinkData(sKey, sValue)
'	if sKey = "hogapopup" then
'		Form.ShowAlert("sValue", sValue)
'	end if
'End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_szMarket, false )
	
	if (zTranID == "ohhts_6000_001r") then
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_szMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk)
		
	elseif szTranID == "ohhts_6000_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_szMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk)	
	end if 
	
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	DATAMANAGER.CancelRealData("ohhts_exst_aspr")
	'DATAMANAGER.CancelRealData("ohhts_exst_cnta") 
	'DATAMANAGER.CancelRealData("ohhts_exst_cntd")	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'if szTranID == "ohhts_1001_005r" then
	if szTranID == "ohhts_6000_001r" then
		g_PrePrc = CInt(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_SDPR", 0 )) '기준가
	elseif szTranID == "ohhts_6000_002r" then
		f_SetPrice_UI(g_nSelectRow, "")
		f_RequestRealTran()
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData( "ohhts_exst_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_exst_aspr" )
	'DATAMANAGER.CancelRealData( "ohhts_exst_cnta" )
	'DATAMANAGER.CancelRealData( "ohhts_exst_cntd" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	f_SetPrice_UI(g_nSelectRow, "")
End Sub

'============================================================================
Sub btnUp_OnClick()
	g_nSelectRow = g_nSelectRow - 1
	
	if g_nSelectRow < 0 then
		g_nSelectRow = 0
	end if
	
	
	f_SetPrice_UI(g_nSelectRow, "UP")
End Sub

'============================================================================
Sub btnDown_OnClick()
	g_nSelectRow = g_nSelectRow + 1
	
	if g_nSelectRow > 19 then
		g_nSelectRow = 19
	end if
	
	f_SetPrice_UI(g_nSelectRow, "DOWN")
End Sub

'============================================================================
Sub Label0_OnClick()
	call btnUp_OnClick()
End Sub

'============================================================================
Sub Label1_OnClick()
	call btnDown_OnClick()
End Sub

'============================================================================
Sub btnMado_OnClick()
	nPrice= lblLine.GetCellString(1, 1)
	Form.SetSharedData("HYUN_RETURN2" , nPrice)
	SendOrder( "1" )
End Sub

'============================================================================
Sub btnMasu_OnClick()
	nPrice= lblLine.GetCellString(1, 1)
	Form.SetSharedData("HYUN_RETURN2" , nPrice)
	SendOrder( "0" )
End Sub

'============================================================================
'20230414 KKM : 위아래이미지
Sub Form_OnFormInitBefore()
	btnUp.SetMaintainingRatio("1")
	btnDown.SetMaintainingRatio("1")	
End Sub

