'============================================================================
' 화 면 명 : 자동투자금액_상세팝업(mbact71052_p15.xmf)
'============================================================================
Dim g_szDataList, g_szList

Dim g_AcntList
g_AcntList = {}
Dim g_AcntList_idx

Dim g_nGrdCnt	'NextData 조회시 grid Index값 설정을 위한 변수

'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.Table0.SetCellString(0, 1, "상세보기 >")
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
		Image0.visible = false
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData()	' 자동투자금액@계좌개수○전체여부○날짜○계좌번호

	if szData <> "" and szData <> null then
		g_szDataList	= split(szData, "@")	
		g_szList 	= split(g_szDataList[1], "○")	' 계좌개수○전체여부○날짜○선택계좌번호
		
		Container0.Grid0.visible = false
		
		' 자동투자금액
		Container0.lblAMT.caption = g_szDataList[0]
		Container0.lblAMT.setHighlight(332)
		
		' 자동투자된 금액이 없을 경우
		if CInt(g_szDataList[0]) == 0 then
			Container0.Label0.visible = true
			
			Container0.SetScrollAutoSize()
			Container0.scroll_pos = 0
			Exit Sub
		
		' 자동투자된 금액이 있을 경우
		else
			Container0.Label0.visible	= false
		end if
		
		f_setScrn()
		
		' 전체 계좌일 경우 ------------------------
		if g_szList(1) == "Y" then

			for i = 0 to #g_szList - 1
			
				if i > 2 then
					Dim x
					x = i - 3
					
					g_AcntList[x] = g_szList[i]
				end if
				
			next
			
		end if
		' -----------------------------------------
		
		f_RqstTran()
	end if

End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(Cint(sTimerID), 0, 0)
	
	if Cint(sTimerID) == 1 then
		Dim nRowCnt, nCnt
		nRowCnt	= CInt(Container0.Grid0.rowcount)
		nCnt		= 0
		
		if nRowCnt == "" or nRowCnt == 0 then
			exit Sub
		end if

		if nRowCnt > 0 then
	
			for i = 0 to nRowCnt - 1

				if Container0.Grid0.GetCellData("BD_ISNM", i) == "CMA-RP" then
					nCnt = nCnt + 1
					
					Container0.Grid0.SetVisibleSubRows(i, "bd_cell1|BD_BYOV_DATE",	false)
					Container0.Grid0.SetVisibleSubRows(i, "7|8",					false)
					Container0.Grid0.SetVisibleSubRows(i, "bd_cell2|BD_STPL_INRT",	false)
					Container0.Grid0.SetVisibleSubRows(i, "9|10",					false)

					Container0.Grid0.SetCellLineVisible("5", i, "0,1")
					Container0.Grid0.SetCellLineVisible("6",	i, "0,1")
				end if

			next
			
		end if

		if g_szList(1) == "Y" then
			Dim grdHeight
			grdHeight 				= (nRowCnt * 105) - (nCnt * 48) + 3
			Container0.Grid0.height	= grdHeight

			if grdHeight < 300 then
				Image0.top		= 495 - grdHeight
				Container0.top 	= 490 - grdHeight
				Container0.height	= 597 - (490 - grdHeight)
			end if
			
		end if

		Container0.Grid0.visible = true
		Container0.SetScrollAutoSize()
		Container0.scroll_pos = 0
	end if
	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
' 						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obacb_balc_159r" then
	
		for i = 0 to DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1") - 1
			Dim ACNO, ASNO, ISNM, VLTN_AMT, BYOV_DATE, STPL_INRT, AcntNo, tmpAMT
			ACNO 		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ACNO", 		i)
			ASNO 		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ASNO", 		i)
			ISNM 		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ISNM", 		i)
			VLTN_AMT		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "VLTN_AMT",		i)
			BYOV_DATE 	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BYOV_DATE",	i)
			STPL_INRT	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "STPL_INRT",	i)
			ISCD 		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ISCD", 		i)
			AcntNo 		= left(ACNO, 4) & "-" & right(ACNO, 4) & "-" & ASNO
			tmpAMT		= 0

			Container0.Grid0.AddRow()
				
			Container0.Grid0.SetCellData("bd_cell0",		g_nGrdCnt, 	"자동투자금액")
			Container0.Grid0.SetCellData("bd_cell1",		g_nGrdCnt, 	"매수일")
			Container0.Grid0.SetCellData("bd_cell2",		g_nGrdCnt, 	"적용금리")
			Container0.Grid0.SetCellData("BD_ACNO", 		g_nGrdCnt, 	AcntNo)
			Container0.Grid0.SetCellData("BD_ACNO", 		g_nGrdCnt, 	AcntNo)
			Container0.Grid0.SetCellData("BD_ISNM", 		g_nGrdCnt, 	ISNM)
			Container0.Grid0.SetCellData("BD_VLTN_AMT", 	g_nGrdCnt, 	VLTN_AMT)
			Container0.Grid0.SetCellData("BD_BYOV_DATE", 	g_nGrdCnt, 	BYOV_DATE)
			Container0.Grid0.SetCellData("BD_STPL_INRT", 	g_nGrdCnt, 	CDBL(STPL_INRT) & "%")
			
			Container0.Grid0.SetPropGridCell("fontstyle", "BD_ACNO", g_nGrdCnt, true)
			
			' CMA_RP 1건으로 조회
			if Container0.Grid0.GetCellData("BD_ACNO", g_nGrdCnt - 1) == AcntNo and ISCD == "RP10000" then
				tmpAMT = CDBL(Container0.Grid0.GetCellData("BD_VLTN_AMT", g_nGrdCnt - 1)) + CDBL(VLTN_AMT)
				
				Container0.Grid0.SetCellData("BD_VLTN_AMT", g_nGrdCnt - 1, 	tmpAMT)
				
				Container0.Grid0.SetDeleteRow(g_nGrdCnt)
			else				
				g_nGrdCnt = g_nGrdCnt + 1
			end if

		next

		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
		else
			
			if g_szList(1) == "Y" then

				if #g_AcntList >= g_AcntList_idx + 1 then
					f_RqstAllAcnt()
				else
					Form.SetTimerEvent2(1, 1, 0.1)
				end if
			
			else
				Form.SetTimerEvent2(1, 1, 0.1)
			end if

		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
	g_nNextCount = 0
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'확인버튼
'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'상세보기
'============================================================================
Sub Container0_Table0_OnClick(lRow, lColumn)

	if CInt(lRow) == 0 and CInt(lColumn) == 1 then
		Dim szOpenData
		
		if g_szList(1) == "Y" then
			szOpenData = ""
		else
			szOpenData = g_szList[3]
		end if
		
		Form.OpenScreen("52020" , szOpenData)
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
' 							사용자 함수
'============================================================================
'화면세팅함수
'============================================================================
Function f_setScrn()

	if g_szList(1) == "Y" and CInt(g_szDataList[0]) > 0 then
		Image0.top				= 195
		Container0.top			= 200
		Container0.height			= 397
	else
		Image0.top				= 380
		Container0.top			= 385
		Container0.heigh			= 212
		Container0.Grid0.height	= 110
	end if
	
End Function

'============================================================================
' 데이터 요청 함수
'============================================================================
Function f_RqstTran()
	g_AcntList_idx = 0
	g_nGrdCnt = 0
	Container0.Grid0.rowcount = 0

	if g_szList(1) == "Y" then
		f_RqstAllAcnt()
	else
		DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "UI_UNIT_CLS",	0, "2")
		DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "ACNO",		0, left(g_szList[3], 	8))
		DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "ASNO",		0, right(g_szList[3], 	2))
		DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "IQRY_CNT",	0, "00000030")
		
		DATAMANAGER.RequestTranData("obacb_balc_159r")
	end if
	
End Function

'============================================================================
' 전체 계좌 조회 함수
'============================================================================
Function f_RqstAllAcnt()	
	DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "UI_UNIT_CLS",	0, "1")
	DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "ACNO", 		0, left(g_AcntList[g_AcntList_idx], 8))
	DATAMANAGER.SetDataValue(false, "obacb_balc_159r", "InBlock1", "IQRY_CNT",	0, "00000030")
	
	g_AcntList_idx = g_AcntList_idx + 1
	
	DATAMANAGER.RequestTranData("obacb_balc_159r")
End Function

