'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	
	scrNo = Form.GetSharedData("&SCREEN_NO", false)
	
	if scrNo == "16060" then
		Form.SetEnvData(0, "OrdNotice_16060", sCheckState )
	else
		Form.SetEnvData(0, "OrdNotice_16061", sCheckState )
	end if
	
End Sub
