Sub imgInfo_OnClick()
	
End Sub

'============================================================================
Sub lblAbleQty0_OnClick()
	Dim nQty
	
	if g_szUNCL_OCRN_ODER_ABLE_QTY <> "" then
		nQty = CInt(g_szUNCL_OCRN_ODER_ABLE_QTY)
		edtQty.caption = nQty
		edtQty_OnEditComplete()
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CantSin" then
		if sRet == "ok" then
			'신용거래 신청
			Form.OpenScreen("82010" , "")
		end if
	end if
End Sub

'============================================================================
Sub btnPrderPricePopup_OnClick()

	'정산금액 미리보기
	Dim szType, szCode, szPrice, szInner, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
'	if Check_InputData(2) == false then
'		Exit Sub
'	end if
	
	'20220602 LES START 정산금 호출로직 개선
	szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
	
	'시장구분
	if szInner == "002" then		'코스닥
	    szInrMk = "02"
	elseif szInner == "033" then	'코넥스
		szInrMk = "21"
	
	'현재 AOS = 25 , iOS = 11 (메인에서 맞춰야됨)
	elseif szInner == "011" or szInner == "025" then  '프리보드 
		szInrMk = "03"
	else
		szInrMk = "01"
	end if
	'20220602 LES END 
	
		
	'주문유형에 따른 주문단가
	szType = cmbType.cbkeydata
    
	Select Case szType
		Case "11"										' 장개시전시간외(전일종가)
			szPrice =  Form.GetCtlProp("#lblStd", "caption")
		Case "12"										' 시간외종가(현재가)
			szPrice =  Form.GetCtlProp("#lblHyun", "caption")
		Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
			szPrice =  Form.GetCtlProp("#lblHigh", "caption")		' 매수시(상한가), 매도시 ( 하한가 )	
		Case else
		    if edtPrc.caption == "" then
				szPrice = "0"
			else
				szPrice = edtPrc.caption
			end if
	    
'			if edtPrc.caption = "0" or edtPrc.caption = "" then
'				Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
'				exit Sub
'			end if	    
	End Select

    '종목코드
	szCode = Change_ItemCode()
	Dim szQty
	if edtQty.caption == "" then
		szQty = 0
	else
		szQty = edtQty.caption
	end if
    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드|주문유형
    szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "2" & "★" & szQty & "★" & szPrice & "★" & szCode & "★" & szType
    
    Form.OpenPopupAnimation("mbtrs12000_pm" , szData , "","2")
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'20230710 htw start '환경설정 자동가격=미사용, 자동수량=미사용 제외 다른것.일 경우에만 사용
	if CInt(sTimerID) == 1 then
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
		if szPrc <> "" and g_szNowCd <> g_szCd and g_szCd <> "" then
			g_szNowCd = g_szCd
			if Check_RequestAble() == true then
				if g_bTabChangeFlag == false then	'CHANGE_TAB 트리거가 들어오면 T 이후 AUTO PRICE가 들어오면 false
					DATAMANAGER.RequestTranData("obtrs_comn_413r_2")	'환경설정 자동가격=미사용, 자동수량=미사용 제외 다른것.일 경우에만 사용
				end if
			end if 
			g_bAbleRequestQty = false
			Form.SetTimerEvent2(1, 0, 0.5)
			
		end if
	'20230710 htw end '환경설정 자동가격=미사용, 자동수량=미사용 제외 다른것.일 경우에만 사용
	'20230717 htw start '휴장일 판단 추가
	elseif CInt(sTimerID) == 55 then
		szBdsyYn = Form.GetCtlProp("#lblBdsyYn", "caption")'휴장일판단 N=휴장일

		if szBdsyYn <> "" then
			Form.SetTimerEvent2(55, 0, 0.5)
'			20230720 htw start Request_autoQry에서 Request_Able로 함수 변경
			Request_Able(1)
		end if
	'20230717 htw end '휴장일 판단 추가
	'20230719 htw start 가능수량 TR 조회시 이전 종목으로 조회되는 경우 방지를 위해 시세 조회 후 종목코드 저장한 값과 기존 종목코드 비교 후 수량 조회
	elseif CInt(sTimerID) == 77 then	
		szMainItemCode = Form.GetCtlProp("#lblItemCode", "caption")
			
		if szMainItemCode == g_szCd then
			Form.SetTimerEvent2(77, 0, 0.5)
'			20230720 htw start Request_autoQry에서 Request_Able로 함수 변경
			Request_Able(1)
		end if
	'20230719 htw end 가능수량 TR 조회시 이전 종목으로 조회되는 경우 방지를 위해 시세 조회 후 종목코드 저장한 값과 기존 종목코드 비교 후 수량 조회
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetTimerEvent2(1, 0, 0.5)
	Form.SetTimerEvent2(55, 0, 0.5)
	Form.SetTimerEvent2(77, 0, 0.5)
End Sub

