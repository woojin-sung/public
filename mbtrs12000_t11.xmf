		DATAMANAGER.RequestTranData("obtrs_comn_413r_1")	
	else
		szSendData = g_szCd.."★".. g_szMk .."★"..szPrc.."★"..szQty.."★".."0".."★"..g_szODER_ABLE_AMT.."★"..szHigh.."★"..szLow.."★"..szCmbType.."★"..szCmbCap.."★".."1"
		Form.OpenPopupAnimation("mbtrs12000_pl" , szSendData, "","2")
	end if
	'20230627 htw end 가능금액 미조회 상황에서 키패드 오픈 시 조회 후 오픈
	
