'============================================================================
' cmbType_OnEditComplete
'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	szCLS = Form.GetCtlProp("#rdoGbn", "currentindex")
		
	if szCLS == "0" then	'현금
		lblAbleQty.caption = "현금가능  주"
	else
		lblAbleQty.caption = "신용가능  주"
	end if
	lblAbleQty0.caption = "최대가능  주"
	Form.SetSharedData("B_TYPE", cmbType.currentindex)
	Form.SetSharedData("STOCK_BUYTYPE", cmbType.cbkeydata)
	Form.triggerEvent("#", "12000_BUYTYPE", "")
	Visible_Control(iIndex)
	
	'20180716 LES START
	'Position_Control()
	
	'20190806 LES START
'	if iIndex == 11 then
'		Label0.visible = true
'	else
'		Label0.visible = false
'	end if
	'20190806 LES END
	
	if iIndex == 1 then
		chkMarketPrice.chksilence = true
		edtPrc.caption = ""
	else
		chkMarketPrice.chksilence = false
	end if
	
	'htw 230525 장전시간외 최초 클릭 시 토스트 메세지 제공 start
	if iIndex == 11 then
		if g_bFirstSelectBeforeMarket == false then
			g_bFirstSelectBeforeMarket = true
'			Form.Toast(1, "장전시간외로 주문시 08:15~08:30에는 정정 및 취소가 불가하오니 유의해주세요.", 1)
			Form.triggerEvent("#", "FirstBeforeMarketClick", "")
		end if
	end if	
	'htw 230525 장전시간외 최초 클릭 시 토스트 메세지 제공 end
	if edtPrc.caption <> "" then
		Request_Able(0)
	end if
End Sub

'============================================================================
' edtPrc_OnEditComplete
'============================================================================
Sub edtPrc_OnEditComplete()
	Form.SetSharedData("B_PRC", edtPrc.caption)
	Form.SetCtlProp("#lblPrc", "caption", edtPrc.caption)
	
	Dim szPrc
	szPrc = Form.GetCtlProp("#lblHyun", "caption")
	Request_Able(1)
	
	f_SetOrderPrice()
End Sub

'============================================================================
' edtQty_OnEditComplete
'============================================================================
Sub edtQty_OnEditComplete()
	Form.SetSharedData("B_QTY", edtQty.caption)
	f_SetOrderPrice()
End Sub

'============================================================================
' 20180716 LES START - K-OTC종목 선택 시, 컨트롤 위치조정
'============================================================================
Sub Position_Control()
	'20191106 HWG START : 수량필드 스핀컨트롤 추가
	
	if g_szMk == "T" then
		cmbType.top = 7 
		chkMarketPrice.top = 7
		btnQty.top = 99
		edtQty.top = 99
		btnQPlus.top = 99
		btnQMinus.top = 99
		
		btnPrc.top = 53
		edtPrc.top = 53
		btnPPlus.top = 53
		btnPMinus.top = 53
		
		cmbType.enable = false
		'20230622 htw start K-OTC,ELW인 경우 시장가 visible 연동 추가
		chkMarketPrice.visible = false
		'20230622 htw end K-OTC,ELW인 경우 시장가 visible 연동 추가
		
'		lblAbleQty.top = 141
'		lblAbleQty0.top = 157
		lblAbleQty.top = 142
		lblAbleQty0.top = 172
		btnAble.top = 142
		
	else
		cmbType.top = 54 
		chkMarketPrice.top = 54
		btnQty.top = 148
		edtQty.top = 148
		btnQPlus.top = 148
		btnQMinus.top = 148

		
		btnPrc.top = 101
		edtPrc.top = 101
		btnPPlus.top = 101
		btnPMinus.top = 101
		
		cmbType.enable = true
		'20230622 htw start K-OTC,ELW인 경우 시장가 visible 연동 추가
		if g_szMk == "W" then
			chkMarketPrice.visible = false
		else
			chkMarketPrice.visible = true
		end if
		'20230622 htw end K-OTC,ELW인 경우 시장가 visible 연동 추가
		
'		lblAbleQty.top = 199
'		lblAbleQty0.top = 215
		lblAbleQty.top = 200
		lblAbleQty0.top = 230
		btnAble.top = 200
		
	end if
	'20191106 HWG END
	
'	btnCash.visible = false
'	btnMax.visible = false
	
	'기존오류 수정
	'탭변경시 수량/가격 초기화 사용설정 시,
	'최대,현금버튼 배경이미지 초기이미지로 변경
'	if g_szChangeInit == "1" then
'		Form.SetSharedData("B_QTY_TYPE" , "2")
'		btnCash.btnimage = "btn_02.9.png"
'		btnMax.btnimage  = "btn_02.9.png"
'	end if

End Sub




'============================================================================
Sub chkMarketPrice_OnChange(sCheckState)
	if sCheckState == "1" then
		'시장가
		cmbType.currentindex = 1
		edtPrc.caption = ""
	else
		cmbType.currentindex = 0
	end if
End Sub

'============================================================================
Sub lblAbleQty_OnClick()
	Dim nQty
	if g_szODER_ABLE_QTY <> "" then
		nQty = CInt(g_szODER_ABLE_QTY)
		edtQty.caption = nQty
		edtQty_OnEditComplete()
	end if
End Sub

'가능 버튼
'============================================================================
Sub btnAble_OnClick()
	Form.triggerEvent("#", "Open_mbtrs12000_pk", cmbType.cbkeydata.."★"..cmbType.caption.."★"..edtPrc.caption.."★"..cmbType.currentindex)
End Sub

Sub f_SetOrderPrice()
	Dim nPrc,nQty,nOrderPrice
	nPrc = 0
	nQty = 0
	nOrderPrice = 0
	
	if edtPrc.caption <> "" then
		nPrc = CInt(edtPrc.caption)
	else
		lblOrderPrice.caption = "-"
		Exit Sub
	end if
	
	if edtQty.caption <> "" then
		nQty = CInt(edtQty.caption)
	end if
	
	nOrderPrice = nPrc * nQty
	lblOrderPrice.caption = FormatNumber(nOrderPrice,0).." 원"
End Sub 
'============================================================================
Sub btnOrderPrice_OnClick()
	'종목코드, 종목마켓, 단가, 수량, 매수탭(0),최대 매수 가능 금액,상한가, 하한가, 주문 타입,주문 타입명,단가or수량or금액(단가=0수량=1금액=2)
	Dim szSendData, szPrc, szQty,szHigh,szLow,szCmbType,szCmbCap
	
	if edtPrc.caption <> "" then
		szPrc = edtPrc.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
	
	if edtQty.caption <> "" then
		szQty = edtQty.caption
	else
		szQty = "0"
	end if
	
	szHigh =  Form.GetCtlProp("#lblHigh", "caption")
	szLow =  Form.GetCtlProp("#lblLow", "caption")
	szCmbType = cmbType.cbkeydata
	szCmbCap = cmbType.caption
	'20230627 htw start 가능금액 미조회 상황에서 키패드 오픈 시 조회 후 오픈
	g_szOpenCalcClickType = "2" '0=단가 1=수량 2=금액
	if g_szODER_ABLE_AMT == "" or g_szODER_ABLE_AMT == "0" then
		DATAMANAGER.RequestTranData("obtrs_comn_413r_1")	
	else
		szSendData = g_szCd.."★".. g_szMk .."★"..szPrc.."★"..szQty.."★".."0".."★"..g_szODER_ABLE_AMT.."★"..szHigh.."★"..szLow.."★"..szCmbType.."★"..szCmbCap.."★".."2"
		Form.OpenPopupAnimation("mbtrs12000_pl" , szSendData, "","2")
	end if
	'20230627 htw end 가능금액 미조회 상황에서 키패드 오픈 시 조회 후 오픈
End Sub

