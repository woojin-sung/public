'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szSubMsg <> "" And szSubMsg <> null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	'연락처 연결
	If szCellID == "bd_imgtel" Or szCellID == "bd_telno" Then
		Dim szTelNo
		szTelNo = grdList.GetCellData("bd_telno", lRow)
		szTelNo = Replace(szTelNo, "-", "")
		If szTelNo <> "" And szTelNo <> null Then
			Form.SendCall(szTelNo)
		End If
	
	'각 리스트의 화면으로 이동(bd_move1~6)
	ElseIf szCellID == "bd_move1" Then
		g_szScrNo = grdList.GetCellData("bd_scrno1", lRow)
		If g_szScrNo <> "" And g_szScrNo <> null Then
			g_szSendDate = grdList.GetCellData("bd_date", lRow)
			g_szSendNo = grdList.GetCellData("bd_sendno1", lRow)
			g_szScrYn = grdList.GetCellData("bd_scryn1", lRow)
			g_szLogOut = grdList.GetCellData("bd_logout1", lRow)
			
			'디지털업무솔루션 고객확인내역 관리
			DATAMANAGER.RequestTranData( "obcpp_digt_007a" )
		End If
	
	ElseIf szCellID == "bd_move2" Then
		g_szScrNo = grdList.GetCellData("bd_scrno2", lRow)
		If g_szScrNo <> "" And g_szScrNo <> null Then
			g_szSendDate = grdList.GetCellData("bd_date", lRow)
			g_szSendNo = grdList.GetCellData("bd_sendno2", lRow)
			g_szScrYn = grdList.GetCellData("bd_scryn2", lRow)
			g_szLogOut = grdList.GetCellData("bd_logout2", lRow)
			
			'디지털업무솔루션 고객확인내역 관리
			DATAMANAGER.RequestTranData( "obcpp_digt_007a" )
		End If
	
	ElseIf szCellID == "bd_move3" Then
		g_szScrNo = grdList.GetCellData("bd_scrno3", lRow)
		
		If g_szScrNo <> "" And g_szScrNo <> null Then
			g_szSendDate = grdList.GetCellData("bd_date", lRow)
			g_szSendNo = grdList.GetCellData("bd_sendno3", lRow)
			g_szScrYn = grdList.GetCellData("bd_scryn3", lRow)
			g_szLogOut = grdList.GetCellData("bd_logout3", lRow)
			
			'디지털업무솔루션 고객확인내역 관리
			DATAMANAGER.RequestTranData( "obcpp_digt_007a" )
		End If
	End If
End Sub

