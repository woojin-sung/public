	<SCRIPT_INFO _len="21156" _ulen="19430" >

Dim g_szScrNo
Dim g_szScrYn
Dim g_szSendDate
Dim g_szSendNo
Dim g_szLogOut

'============================================================================
Sub Form_OnFormInit()
	grdList.setUseCardView(true, 8, "input_03_n.9")
	
	
	'20230214 START
	'디지털업무솔루션 고객확인내역 관리
	szData = Form.GetOpenLinkData()
	
	if szData <> "" then
		'카카오에서 옴
		Form.SetTimerEvent2(1, 1, 1)
	else
		'메뉴에서 오픈한 경우
		DATAMANAGER.RequestTranData( "obcpp_digt_006r" )
	end if
	'20230214 END
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'로그아웃 확인 메시지박스
	If sKeyName == "LOGOUT_MSG" And sRet == "ok" Then
		Form.LogOut(0,1)
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		
		Form.OpenScreen(g_szScrNo , "")
		
		'알아서 날아가겠지만 초기화
		g_szScrNo = ""
		g_szScrYn = ""
		g_szSendDate = ""
		g_szSendNo = ""
		g_szLogOut = ""
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'디지털업무솔루션 고객확인내역 조회
	If szTranID == "obcpp_digt_006r" Then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ELFN_ID" , 0 , szUserID)
	
	'디지털업무솔루션 고객확인내역 관리 
	ElseIf szTranID == "obcpp_digt_007a" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SNDN_DATE" , 0 , g_szSendDate)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SNDN_NO" , 0 , g_szSendNo)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'디지털업무솔루션 고객확인내역 관리
	If szTranID == "obcpp_digt_007a" Then
		'그리드에서 선택한 화면번호로 이동 또는 팝업오픈
		If g_szScrYn == "N" Then		'화면이동
			'로그아웃이 필요한 화면인지 체크
			If g_szLogOut == "Y" Then
				Dim nLoginType
				nLoginType = CInt(Form.GetSharedData( "&LOGIN_TYPE", false ))
				If nLoginType > 1 Then
					Form.MsgBox("알림", "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?" , "LOGOUT_MSG" , 1 )
					Exit Sub
				End If
			End If
			
			'요청이 있어 화면별로 예외처리
			Dim szSendData
			If g_szScrNo == "81020" Then	'81020: 개인(신용)정보동의
				szSendData = "탭이동;1"
			Else
				szSendData = ""
			End If
			
			Form.OpenScreen(g_szScrNo , szSendData)
		Else							'팝업 오픈 
			Form.OpenFramePopup(g_szScrNo , "" , "")
		End If
		
		'화면이동하는 경우는 알아서 날아가겠지만 팝업을 띄우는 경우가 있기에 초기화
		g_szScrNo = ""
		g_szScrYn = ""
		g_szSendDate = ""
		g_szSendNo = ""
		g_szLogOut = ""
	
	'디지털업무솔루션 고객확인내역 조회
	ElseIf szTranID == "obcpp_digt_006r" Then
	
		'3개가 한묶음인것으로 보고 처리해야함
		'3개당 그리드 row 한 줄 생성, 1회 호출시 내려오는 데이터 최대갯수는 18개 
		'18개 내려올 경우 생성해야 하는 그리드 row는 6줄
		
		'조회해 온 데이터 갯수
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1")
		
		If nCnt == 0 Then
			grdList.visible = false
			lblNoData.visible = true
			Exit Sub
		End If
		
		Dim nGrdCnt
		nGrdCnt = grdList.rowcount
		
		grdList.rowcount = nGrdCnt + (nCnt / 3)
		
		Dim szSendDate, szSendNo, szSrno, szDpnm, szPrchName, szClpsName, szTelNo, szScrNo, szScrName, szScrYn, szLogOutYn
		For i = 0 To nCnt - 1
			szSendDate = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SNDN_DATE" , i)		'발송일자
			szSendNo = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SNDN_NO" , i)			'발송번호
			szSrno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SRNO" , i)				'일련번호
			szDpnm = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "DPNM" , i)				'부서명
			szPrchName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PRCH_NAME" , i)		'담당자명
			szClpsName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CLPS_NAME" , i)		'담당자직급
			szTelNo = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SNDR_TELNO" , i)			'연락처
			szScrNo = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MTS_SCR_NO" , i)			'요청화면번호
			szScrName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SCR_PATH_NAME1" , i)	'요청화면명
			szScrYn = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SCR_YN" , i)				'화면여부
			szLogOutYn = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CONN_FIN_NCSR_YN" , i)	'로그아웃 여부
			
'			Form.ShowAlert(i, szScrName .. szScrYn)
			
			'상단 문구나 연락처는 5개 단위로 고정이므로 한번만 채워넣게 함
			'화면명, 화면번호, 발송번호, 일련번호는 각 반복에서 해당되는 셀에 세팅
				
			'첫번째 row 채우는 내용	
			If i+1 <= 3 Then
				If i == 0 Then
					grdList.SetCellData("bd_date", nGrdCnt + 0, szSendDate)
					If szPrchName <> "" And szClpsName <> "" Then
						grdList.SetCellData("bd_text1", nGrdCnt + 0, "오늘 상담드린 " & szDpnm & " " & szPrchName & " " & szClpsName  & " 입니다.")
					Else
						grdList.SetCellData("bd_text1", nGrdCnt + 0, "오늘 상담드린 " & szDpnm & " 입니다.")
					End If
					grdList.SetCellData("bd_text2", nGrdCnt + 0, "상담이 필요하시면 언제든지 연락주세요.")
					grdList.SetCellData("bd_telno", nGrdCnt + 0, szTelNo)
					
					grdList.SetCellData("bd_title", nGrdCnt + 0, "요청하신 화면")
					
					grdList.SetCellData("bd_scrnm1", nGrdCnt + 0, szScrName)
					If szScrName <> "" Then
						grdList.SetCellImage("bd_move1", nGrdCnt + 0, "input_01_n.9")
						grdList.SetCellData("bd_move1", nGrdCnt + 0, "바로가기")
						grdList.SetCellData("bd_scrno1", nGrdCnt + 0, szScrNo)
						grdList.SetCellData("bd_sendno1", nGrdCnt + 0, szSendNo)
						grdList.SetCellData("bd_scryn1", nGrdCnt + 0, szScrYn)
						grdList.SetCellData("bd_logout1", nGrdCnt + 0, szLogOutYn)
					End If
				End If
				
				If i == 1 Then
					grdList.SetCellData("bd_scrnm2", nGrdCnt + 0, szScrName)
					If szScrName <> "" Then
						grdList.SetCellImage("bd_move2", nGrdCnt + 0, "input_01_n.9")
						grdList.SetCellData("bd_move2", nGrdCnt + 0, "바로가기")
						grdList.SetCellData("bd_scrno2", nGrdCnt + 0, szScrNo)
						grdList.SetCellData("bd_sendno2", nGrdCnt + 0, szSendNo)
						grdList.SetCellData("bd_scryn2", nGrdCnt + 0, szScrYn)
						grdList.SetCellData("bd_logout2", nGrdCnt + 0, szLogOutYn)
					End If
				ElseIf i == 2 Then
					grdList.SetCellData("bd_scrnm3", nGrdCnt + 0, szScrName)
					If szScrName <> "" Then
						grdList.SetCellImage("bd_move3", nGrdCnt + 0, "input_01_n.9")
						grdList.SetCellData("bd_move3", nGrdCnt + 0, "바로가기")
						grdList.SetCellData("bd_scrno3", nGrdCnt + 0, szScrNo)
						grdList.SetCellData("bd_sendno3", nGrdCnt + 0, szSendNo)
						grdList.SetCellData("bd_scryn3", nGrdCnt + 0, szScrYn)
						grdList.SetCellData("bd_logout3", nGrdCnt + 0, szLogOutYn)
					End If
				End If
			
			'두번째 row 채우는 내용
			ElseIf i+1 <= 6 Then
				If i == 3 Then
					grdList.SetCellData("bd_date", nGrdCnt + 1, szSendDate)
					If szPrchName <> "" And szClpsName <> "" Then
						grdList.SetCellData("bd_text1", nGrdCnt + 1, "오늘 상담드린 " & szDpnm & " " & szPrchName & " " & szClpsName  & " 입니다.")
					Else
						grdList.SetCellData("bd_text1", nGrdCnt + 1, "오늘 상담드린 " & szDpnm & " 입니다.")
					End If
					grdList.SetCellData("bd_text2", nGrdCnt + 1, "상담이 필요하시면 언제든지 연락주세요.")
					grdList.SetCellData("bd_telno", nGrdCnt + 1, szTelNo)
					
					grdList.SetCellData("bd_title", nGrdCnt + 1, "요청하신 화면")
					
					grdList.SetCellData("bd_scrnm1", nGrdCnt + 1, szScrName)
					If szScrName <> "" Then
						grdList.SetCellImage("bd_move1", nGrdCnt + 1, "input_01_n.9")
						grdList.SetCellData("bd_move1", nGrdCnt + 1, "바로가기")
						grdList.SetCellData("bd_scrno1", nGrdCnt + 1, szScrNo)
						grdList.SetCellData("bd_sendno1", nGrdCnt + 1, szSendNo)
						grdList.SetCellData("bd_scryn1", nGrdCnt + 1, szScrYn)
						grdList.SetCellData("bd_logout1", nGrdCnt + 1, szLogOutYn)
					End If
				End If
				
				If i == 4 Then
					grdList.SetCellData("bd_scrnm2", nGrdCnt + 1, szScrName)
					If szScrName <> "" Then
						grdList.SetCellImage("bd_move2", nGrdCnt + 1, "input_01_n.9")
