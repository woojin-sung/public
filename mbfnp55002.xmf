'============================================================================
Sub Form_OnFormInit()
	Combo0.clear = 0
	Table0.SetCellString(0, 1, "")
	Table0.SetCellString(1, 1, "")
	Table1.SetCellString(0, 1, "")
	Table1.SetCellString(0, 3, "")
	
	Table2.SetCellString(2, 0, "")
	Table2.SetCellString(2, 1, "")
	Table2.SetCellString(2, 2, "")
	Table2.SetCellString(2, 3, "")
	Table2.SetCellString(2, 4, "")
	Table2.SetCellString(2, 5, "")
	Table2.SetCellString(3, 0, "")
	Table2.SetCellString(3, 1, "")
	Table2.SetCellString(3, 2, "")
	Table2.SetCellString(3, 3, "")
	Table2.SetCellString(3, 4, "")
	Table2.SetCellString(3, 5, "")
	
	Table1.SetCellString(0, 4, "-")
	Table1.SetCellBgColor(0, 4, 2)
	DATAMANAGER.RequestTranData( "obsap_smpr_008r_1" )
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obsap_smpr_008r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsap_smpr_008r" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_008r", "InBlock1", "ACNO" , 0 , LEFT(Account0.caption, 8))
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_008r", "InBlock1", "ASNO" , 0 , MID(Account0.caption, 9,2))
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_008r", "InBlock1", "OTC_FUND_ISCD" , 0 , Combo0.cbkeydata )
	ElseIf szTranID == "obsao_rght_001a" Then
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "CONT_CLS_CODE" 	, 0 ,  "4"					)
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "ACNO" 			, 0 ,  LEFT(Account0.caption, 8))
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "ASNO" 			, 0 ,  MID(Account0.caption, 9,2))
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "PWD" 			, 0 ,  Edit0.encdata 			)
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "ISCD" 			, 0 ,  g_szOtcFundIscd 		)
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "OM_RMND_CLS_CODE", 0 ,  "1" 		              )
		DATAMANAGER.SetDataValue( 0, "obsao_rght_001a", "InBlock1", "APLT_QTY"		, 0 ,  g_szRmndQty 		     )
	ElseIf szTranID == "obsap_smpr_008r_1" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_008r_1", "InBlock1", "ACNO" , 0 , LEFT(Account0.caption, 8))
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_008r_1", "InBlock1", "ASNO" , 0 , MID(Account0.caption, 9,2))
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_008r_1", "InBlock1", "OTC_FUND_ISCD" , 0 , "%")
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obsap_smpr_008r" Then
		
		
		Table2.SetCellString(2, 2, "")
		Table2.SetCellString(2, 5, "")
		Table2.SetCellString(3, 2, "")
		Table2.SetCellString(3, 5, "")	
			
		LongQty1      = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_BYOV_CALC_QTY1", 0)) '수량
		LongStndPrc1  = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_BYOV_STND_PRC1", 0)) '기준가격
		LongVltnPrc1  = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_BYOV_VLTN_PRC1", 0)) '평가가격
	
		LongQty2      = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_BYOV_CALC_QTY2", 0)) '수량
		LongStndPrc2  = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_BYOV_STND_PRC2", 0)) '기준가격
		LongVltnPrc2  = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_BYOV_VLTN_PRC2", 0)) '평가가격
		
		ShortQty1     = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_SELN_CALC_QTY1", 0)) '수량
		ShortStndPrc1 = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_SELN_STND_PRC1", 0)) '기준가격
		ShortVltnPrc1 = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_SELN_VLTN_PRC1", 0)) '평가가격
		
		ShortQty2     = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_SELN_CALC_QTY2", 0)) '수량
		ShortStndPrc2 = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_SELN_STND_PRC2", 0)) '기준가격
		ShortVltnPrc2 = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "SMPR_SELN_VLTN_PRC2", 0)) '평가가격
	
		g_szOtcFundIscd = DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "OTC_FUND_ISCD", 0)
		g_szRmndQty     = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "RMND_QTY", 0))
		
		If LongQty1 <> 0 and LongStndPrc1 <> 0 and LongVltnPrc1 <> 0  Then
	'			LongInvtAmt1  = LongQty1 * LongStndPrc1 '매입금액
	'			LongVltnAmt1  = LongQty1 * LongVltnPrc1 '평가금액
			LongErt1 = Round(((LongVltnPrc1 - LongStndPrc1) / LongStndPrc1)*100,2)
			Table2.SetCellString(2, 2, LongErt1)
		
			If LongErt1 > 0 Then
				Table2.SetCellFgColor(2,2, 1)
			ElseIf LongErt1 < 0 Then
				Table2.SetCellFgColor(2,2, 2)
			Else
				Table2.SetCellFgColor(2,2, 3)
			End If
		End If
	
		If LongQty2 <> 0 and LongStndPrc2 <> 0 and LongVltnPrc2 <> 0 Then
	'			LongInvtAmt2  = LongQty2 * LongStndPrc2 '매입금액
	'			LongVltnAmt2  = LongQty2 * LongVltnPrc2 '평가금액
			LongErt2 = Round(((LongVltnPrc2 - LongStndPrc2) / LongStndPrc2)*100,2)
			Table2.SetCellString(3, 2, LongErt2)
			
			If LongErt2 > 0 Then
				Table2.SetCellFgColor(3,2, 1)
			ElseIf LongErt2 < 0 Then
				Table2.SetCellFgColor(3,2, 2)
			Else
				Table2.SetCellFgColor(3,2, 3)
			End If
		End If
	
		If ShortQty1 <> 0 and ShortStndPrc1 <> 0 and ShortVltnPrc1 <> 0 Then
	'			ShortInvtAmt1 = ShortQty1 * ShortStndPrc1 '매입금액
	'			ShortVltnAmt1 = ShortQty1 * ShortVltnPrc1 '평가금액
			ShortErt1 = Round(((ShortStndPrc1 - ShortVltnPrc1) / ShortStndPrc1)*100,2)
			Table2.SetCellString(2, 5, ShortErt1)
			
			If ShortErt1 > 0 Then
				Table2.SetCellFgColor(2, 5, 1)
			ElseIf ShortErt1 < 0 Then
				Table2.SetCellFgColor(2, 5, 2)
			Else
				Table2.SetCellFgColor(2, 5, 3)
			End If
		End If
	
		If ShortQty2 <> 0 and ShortStndPrc2 <> 0 and ShortVltnPrc2 <> 0 Then
	'			ShortInvtAmt2 = ShortQty2 * ShortStndPrc2 '매입금액
	'			ShortVltnAmt2 = ShortQty2 * ShortVltnPrc2 '평가금액	
			ShortErt2 = Round(((ShortStndPrc2 - ShortVltnPrc2) / ShortStndPrc2)*100,2)
			Table2.SetCellString(3, 5, ShortErt2)
			
			If ShortErt2 > 0 Then
				Table2.SetCellFgColor(3, 5, 1)
			ElseIf ShortErt2 < 0 Then
				Table2.SetCellFgColor(3, 5, 2)
			Else
				Table2.SetCellFgColor(3, 5, 3)
			End If
		End If	
	
		If DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "RMND_STAT_CODE", 0) == "1" Then
			Table1.SetCellString(0, 4, "환매대기중")
			Table1.SetCellBgColor(0, 4, 100)
		ElseIf  DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "RMND_STAT_CODE", 0) == "2" Then
			Table1.SetCellString(0, 4, "강제청산")
			Table1.SetCellBgColor(0, 4, 1)
		ElseIf  DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "RMND_STAT_CODE", 0) == "0" Then
			Table1.SetCellString(0, 4, "환매신청")
			Table1.SetCellBgColor(0, 4, 2)
		ElseIf DATAMANAGER.GetDataValue(0, "obsap_smpr_008r", "OutBlock1", "RMND_STAT_CODE", 0) == "4" Then
			Table1.SetCellString(0, 4, "발행대기")
			Table1.SetCellBgColor(0, 4, 100)
		End If
		
	ElseIf szTranID == "obsap_smpr_008r_1" Then
		If DATAMANAGER.GetDataCount(0, "obsap_smpr_008r_1" , "OutBlock1") <= 0 Then
			Form.ShowAlert("알림", "선택가능한 잔고가 없습니다.")
			Exit Sub
		Else
			For i = 0 To DATAMANAGER.GetDataCount(0, "obsap_smpr_008r_1" , "OutBlock1")-1
				Combo0.cbadddatatext = DATAMANAGER.GetDataValue(0, "obsap_smpr_008r_1", "OutBlock1", "OTC_FUND_ISCD" , i) &"`"&DATAMANAGER.GetDataValue(0, "obsap_smpr_008r_1", "OutBlock1", "PO_MKSC_NAME" , i)
			Next
			btnSearch_OnClick()
		End If
	ElseIf szTranID == "obsao_rght_001a" Then
		Form.ShowAlert("알림", "정상처리되었습니다.")
		btnSearch_OnClick()
	End If
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "RPRC_APLT" Then
		If sRet == "ok" Then
			'환매신청 TR
			DATAMANAGER.RequestTranData( "obsao_rght_001a" )
		End If
	End If
End Sub

'============================================================================
Sub Account0_ChangeAccount()
	Form_OnFormInit()
End Sub
'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")

End Sub
'============================================================================
Sub Table1_OnClick(lRow , lColumn)
	
	If lRow == 0 and lColumn == 4 Then
		If Table1.GetCellString(0, 4) == "환매신청" Then
			If LEN(Edit0.caption) == 0 Then
				Form.ShowAlert("알림", "비밀번호를 입력하세요.")
				Exit Sub
			End If
			Form.MsgBox("환매신청", "환매신청 하시겠습니까?", "RPRC_APLT", 1)
		End If
	End If	
End Sub

'============================================================================
Sub Button0_OnClick()
	szData = "5" & "☆" & 0 & "☆" & "0" & "☆" & LEFT(Account0.caption, 8)
	Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	'Form_OnFormInit()
	'Form.MsgBox("111111", Combo0.cbkeydata , "RPRC_APLT", 1)
	DATAMANAGER.RequestTranData( "obsap_smpr_008r" )
End Sub


