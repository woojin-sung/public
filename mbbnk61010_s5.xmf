'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_보안카드
' 02. 화면설명 : 이체예정내역 보안카드 연결화면
' 03. 작    성 : 2016.03.11 염준성
'-------------------------------------------------------------------------------------------
' 2020.11.06 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
'           : - 보안카드비밀번호 컨트롤 속성 : 계좌/거래비밀번호 -> 일반비밀번호로 변경
' 2020.11.13 : 정민영 : v0002 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_520r,obcsb_simf_000r IO 변경분 반영, ohhts_ocsp_001r 미사용TR삭제
'-------------------------------------------------------------------------------------------
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID
Dim g_sSpinCertYn
Dim g_sSecCardCertYn
Dim g_plain_rm  'v0001 메모리평문적용여부

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	EditInput1.certname = "보안카드 "&Label0.caption&Label1.caption
	EditInput2.certname = "보안카드 "&Label3.caption&Label4.caption

	g_sSpinCertYn = "N"
	g_sSecCardCertYn = "N"
	g_sRetData = "cancel"

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	if g_plain_rm == "1" then
	     '화면 마스킹표시/평문데이터로 설정(컨트롤속성-일반비밀번호사용 적용필수)
		EditInput1.SetEncExcept()
		EditInput2.SetEncExcept()
	end if 

	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if

	'Form.SetScreenName( "보안매체 인증" )

	if g_sUserID ~= null and g_sUserID ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	elseif szTranID == "obcsb_simf_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_IDX_NO1" , 0 , Label0.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_IDX_NO2" , 0 , Label3.caption )
		'v0001 값은 평문으로 전송(서비스에서 해쉬암호화처리해서 체크함)
		'MTS메모리평문적용(g_plain_rm == "1")시에는 OnFormInit()에서 평문데이터로 설정하므로 caption으로 전송가능
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_NO1" , 0 , EditInput1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_NO2" , 0 , EditInput2.caption )
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'보안카드상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
	
		if sRSLT_CLS == "0" then '보안카드
			if sSCRC_STAT_CODE == "0" then '정상
				'ButtonOK.enable = true
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
		
		EditInput1.certname = "보안카드 "&CInt(Label0.caption)&Label1.caption
		EditInput2.certname = "보안카드 "&CInt(Label3.caption)&Label4.caption
	elseif szTranID == "obcsb_simf_000r" then
		Dim sRSLT_CLS, sSCRC_PWD_MSTK_TMNU
		
		'결과구분 0:정상 그외에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_simf_000r", "OutBlock1", "RSLT_CLS" , 0 )
		'보안카드오류횟수
		sSCRC_PWD_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_simf_000r", "OutBlock1", "SCRC_PWD_MSTK_TMNU" , 0 )
		
		if sRSLT_CLS == "0" then '정상
			if CInt(sSCRC_PWD_MSTK_TMNU) > 5 then '에러
				Form.MsgBox( "알림", "보안카드 입력 오류 횟수 초과입니다.", "", 6 )				
			elseif g_sSpinCertYn == "Y" then
				g_sSecCardCertYn = "Y"
				Form.triggerEvent("#", "보안카드", "Success")
			else
				g_sSecCardCertYn = "Y"
			end if
		else
			Dim sMsg, sSubMsg 
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub BtnSpinPwd_OnClick()
	Form.OpenPopup("mhetc90060_px", "", "")
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if (EditInput1.caption == null or EditInput1.caption == "" ) or
		(EditInput2.caption == null or EditInput2.caption == "" ) then
		Form.MsgBox( "알림", "보안카드 번호를 입력해주세요.", "", 6 )
	else
		if g_sSpinCertYn == "Y" then
			DATAMANAGER.RequestTranData( "obcsb_simf_000r" ) '보안카드정보확인
		else
			Form.MsgBox( "알림", "간편인증 비밀번호를 입력해주세요.", "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "이체확인" then
		if (EditInput1.caption == null or EditInput1.caption == "" ) or
			(EditInput2.caption == null or EditInput2.caption == "" ) then
			Form.MsgBox( "알림", "보안카드 번호를 입력해주세요.", "", 6 )
			Exit Sub
		elseif g_sSpinCertYn <> "Y" then
			Form.MsgBox("알림", "간편인증 비밀번호를 입력하세요", "", 6)
			Exit Sub
		end if
		ButtonOK_OnClick()  
	end if   
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg ~= "" or szErrMsg ~= Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	Form.ShowAlert( "알림", szErrMsg)
End Sub

'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			g_sSpinCertYn = "Y"
			BtnSpinPwd.caption = "＊＊＊＊"
			if (EditInput1.caption == null or EditInput1.caption == "" ) or
				(EditInput2.caption == null or EditInput2.caption == "" ) then
				Form.MsgBox( "알림", "보안카드 번호를 입력해주세요.", "", 6 )
			else
				Form.triggerEvent("#", "간편인증", "Success")
			end if
		ElseIf sRet == "cancel" Then
			g_sSpinCertYn = "N"
			BtnSpinPwd.caption = ""
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
End Sub

Sub EditInput1_OnEditComplete()
	if Len(Trim(EditInput1.caption)) <> 2 then
		exit sub
	else	
		'Form.MsgBox( "알림", "보안카드 입력완료", "", 6 )
	end if
	
End Sub

