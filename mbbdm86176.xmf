						<TABLE name="Table1" insidelinecolor="102:255255255" colcount="1" rowcount="14" outline="0000" designorder="1" ly_vert="38,20,295,280,1" >
							<COL_INFO ly_vert_width="295" />
							<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20,20,20,20,20,20,20" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" bgcolor="272:246246246" halign="0" line="0,0" caption="동 보고서는 금융소비자보호령법에 따라," paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,1,0,1" bgcolor="272:246246246" halign="0" line="0,0" caption="해당 금융상품이 귀하에게 적정하지 않다" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="272:246246246" halign="0" line="0,0" caption="는 사실을 회사가 귀하에게 알리는 경우 제" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="272:246246246" halign="0" line="0,0" caption="공하는 보고서입니다." paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="272:246246246" halign="0" line="0,0" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" bgcolor="272:246246246" halign="0" line="0,0" caption="당사는 본 판단에 있어 유사한 다른 고객과" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" bgcolor="272:246246246" halign="0" line="0,0" caption="의 불합리한 차별은 없다고 판단하였습니" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" bgcolor="272:246246246" halign="0" line="0,0" caption="다." paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" bgcolor="272:246246246" halign="0" line="0,0" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" bgcolor="272:246246246" halign="0" line="0,0" caption="귀하가 당사에 제공한 정보가 정확하지 않" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" bgcolor="272:246246246" halign="0" line="0,0" caption="거나, 그 정보가 변경된 경우(변경된 정보를" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" bgcolor="272:246246246" halign="0" line="0,0" caption="당사에 알리지 아니하는 경우도 포합됩니" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" bgcolor="272:246246246" halign="0" line="0,0" caption="다)에는 적정성 판단 결과가 달라질 수 있습" paddinginfo="-1,0,0,0" impidxs="" />
								<CELL cell_ly="0,13,0,13" bgcolor="272:246246246" halign="0" line="0,0" caption="니다." paddinginfo="-1,0,0,0" impidxs="" />
							</CELL_INFO>
						</TABLE>
