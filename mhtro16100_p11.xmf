'============================================================================
Sub contTotal_LabelAbleTotalQtyData2_OnClick()

	Dim sPrice,sQty
	sPrice = edtPrc.caption
	sQty = contTotal.LabelAbleTotalQtyData2.caption
	
	szData = sPrice & "★" & sQty
	Form.SendReturnToParent("OrderAble_Popup" , szData)
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub edtPrc_OnEditComplete()
	Request_Able("2")
End Sub

'============================================================================
' 해외주식 주문가능금액 화면으로 이동
'============================================================================
Sub contTotal_LabelCurrencyMoveScreen_OnClick()
	
	'주문가능금액 화면에서 현재보고 있는 시장으로 자동 세팅될 수 있도록 거래소벤더코드 같이 넘김.
	Form.OpenScreen("16076" , gVndrCode)
	
End Sub

'============================================================================
' 환전신청화면으로 이동
'============================================================================
Sub ButtonMoveExchange_OnClick()
	
	scrNo = Form.GetSharedData("&SCREEN_NO", false)
	szData = "매수통화" & "`" &  gCurrency & "`" & scrNo & "`" & "0" 
	Form.OpenScreen("65000" , szData)
	
End Sub

'============================================================================
' 거래소벤더코드(4자리) => 거래소코드(2자리)
'============================================================================
Function GetMarketCode(sVndrCode)

	if sVndrCode == "0321" then
		return "NY"
	elseif sVndrCode == "0537" then
		return "OQ"	
	elseif sVndrCode == "0066" then
		return "AX"
	elseif sVndrCode == "0215" then
		return "SH"
	elseif sVndrCode == "0214" then
		return "SZ"
	elseif sVndrCode == "0104" then
		return "HK"
	elseif sVndrCode == "0106" then
		return "JP"
	else
		return ""
	end if

End Function

