	<SCRIPT_INFO _len="32145" _ulen="30055" >
Dim gAcno,gAsno,gCode,gVndrCode,gLinkPrice,gCurPrice,gDecimalLen,gTickType,gHighPrice,gLowPrice,gTotalYN,gCurrency,gUnit
Dim gOsType,gMask,gType

gAcno = ""
gAsno = ""
gCode = ""
gVndrCode = ""
gLinkPrice = ""
gCurPrice = ""
gDecimalLen = ""
gTickType = ""
gHighPrice = ""
gLowPrice = ""
gTotalYN = ""
gCurrency = ""
gUnit = ""
gMask = ""
gType = ""

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	LabelDepositTitle.paddinginfo 		= "0,0,0,0"
	LabelAbleExchangeTitle.paddinginfo 	= "0,0,0,0"
	lblCurrency.paddinginfo 			= "0,0,0,0"
	LabelAbleQtyData.paddinginfo 		= "0,0,0,0"
	
	contTotal.LabelCurrencyTableTitle.paddinginfo = "0,0,0,0"
	contTotal.LabelCurrencyMoveScreen.paddinginfo = "0,0,0,0"
	contTotal.LabelAbleTotalQtyData1.paddinginfo = "0,0,0,0"
	contTotal.LabelAbleTotalQtyData2.paddinginfo = "0,0,0,0"
	
	if gOsType == "1" then
		edtPrc.imetype = "1"
	else
		edtPrc.SetOnOffImage("alpha", "alpha")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------
	' 환전하기 버튼 이미지 세팅
	'--------------------------------
	ButtonMoveExchange.singleimage = "btn_radio_select_o.9"

	'-----------------------------------------------------------------------------------------------------------
	'계좌번호★계좌일련번호★종목코드★거래소코드(4자리)★연동가격★현재가★소수점자리수★틱타입
	'★상한가★하한가★통합증거금여부★통화★호가단위
	'-----------------------------------------------------------------------------------------------------------
	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"★")
	
	if #arrData > 11 then
		
		gAcno 		= arrData(0)
		gAsno 		= arrData(1)
		gCode 		= arrData(2)
		gVndrCode 	= arrData(3)
		gLinkPrice 	= arrData(4)
		gCurPrice 	= arrData(5)
		gDecimalLen 	= arrData(6)
		gTickType 	= arrData(7)
		gHighPrice 	= arrData(8)
		gLowPrice 	= arrData(9)
		gTotalYN 	= arrData(10)
		gCurrency	= arrData(11)
		gUnit		= arrData(12)
		
		'------------------------------------
		' 통합증거금 여부에 따라 컨트롤 UI변경
		'------------------------------------
		SetContType(gTotalYN)
		
		'------------------------------------
		' 초기데이터 설정
		'------------------------------------
		'SetInitData()
		RequestSiseData()
			
	end if
	
	
End Sub
'============================================================================
' 통합증거금 약정여부에 따른 UI변경
'============================================================================
Function SetContType(sTotalYN)

	if sTotalYN == "Y" then
	
		imgMain.top = 56
		imgMain.height = 583
		
		lblTitle.top = 67
		LabelSeperator.top = 116
		
		Label1.top = 189
		LabelOrdPrc.top = 146
		edtPrc.top = 146
		btnMinus.top = 146
		btnPlus.top = 146
		
		contTotal.left = 0 
	
	end if

End Function

'============================================================================
' 해당 종목 현재가 조회(링크로 넘어온 주문가격이 없을 경우 현재가 자동 세팅)
'============================================================================
Function RequestSiseData()

	sMarketCode = GetMarketCode(gVndrCode)
	szDelay = Form.GetSharedData("REALTIME_"..sMarketCode, 0 )

	if sMarKetCode <> "" then
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 		, 0 , "OV" ) 			' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , gCode ) 		' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 , sMarKetCode ) 	' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , szDelay ) 		' 실시간구분 0 : 실시간 (Default), 1:지연
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
		
	else
		SetInitData()
	end if


End Function

'============================================================================
' 해당 종목 주간현재가 조회(링크로 넘어온 주문가격이 없을 경우 현재가 자동 세팅)
'============================================================================
Function RequestDayMarketSiseData()

	sMarketCode = GetMarketCode(gVndrCode)
	szDelay = Form.GetSharedData("REALTIME_"..sMarketCode, 0 )
	
	'-----------------------------------------
	' 거래소코드 정상 획득시
	'-----------------------------------------
	if sMarKetCode <> "" then
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 		, 0 , "OV" ) 			' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , gCode ) 		' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 , sMarKetCode ) 	' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , szDelay ) 		' 실시간구분 0 : 실시간 (Default), 1:지연
		DATAMANAGER.RequestTranData("ohhts_6000_017r")
	
	'-----------------------------------------
	' 거래소코드 비정상 획득 시
	'-----------------------------------------
	else
		SetInitData()
	end if
	

End Function

'============================================================================
' 해당 종목 애프터현재가 조회(링크로 넘어온 주문가격이 없을 경우 현재가 자동 세팅)
'============================================================================
Function RequestAfterMarketSiseData()

	sMarketCode = GetMarketCode(gVndrCode)
	szDelay = Form.GetSharedData("REALTIME_"..sMarketCode, 0 )
	
	'-----------------------------------------
	' 거래소코드 정상 획득시
	'-----------------------------------------
	if sMarKetCode <> "" then
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_020r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 		, 0 , "OV" ) 			' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_020r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , gCode ) 		' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_020r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 , sMarKetCode ) 	' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_020r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , szDelay ) 		' 실시간구분 0 : 실시간 (Default), 1:지연
		DATAMANAGER.RequestTranData("ohhts_6000_020r")
	
	'-----------------------------------------
	' 거래소코드 비정상 획득 시
	'-----------------------------------------
	else
		SetInitData()
	end if
	

End Function

'============================================================================
' 초기 데이터 설정
'============================================================================
Function SetInitData()

	'-----------------------------------------
	'가격입력창 마스킹처리
	'-----------------------------------------
	if gCurrency <> "" then
		gMask = "0,0,,".. " " .. gCurrency .. ",0,,"..gDecimalLen..",1,1,2,0"
	else
		gMask = "0,0,,,0,,"..gDecimalLen..",1,1,2,0"
	end if
	
	edtPrc.mask = gMask

	'-----------------------------------------
	' 가격입력
	'------------------------------------------
	' 연동가격이 있는 경우 : 연동가격 세팅
	' 연동가격이 없는 경우 : 현재가 세팅
	'------------------------------------------
	if Cdbl(gLinkPrice) <> 0 then
		edtPrc.caption = gLinkPrice
	else
		edtPrc.caption = gCurPrice
	end if
	
	'-----------------------------------------
	' 주문가능수량 조회
	'-----------------------------------------
	Request_Able("1")
	

End Function

'============================================================================
' 주문가능수량 조회(통합증거금 미약정 고객)
'============================================================================
Function Request_Able(sType)
	
	'-----------------------------------------------------------------------
	' gType : 1일때는 서비스 조회가 완료되어도 금액/수량 데이터만 변경
	'-----------------------------------------------------------------------
	gType = sType

	'------------------------------------------------------------------------------------------------------
	'sType 1 : 전체 데이터 조회 (추정예수금/환전가능금액 포함 데이터)
	'sType 2 : 가능금액/가능수량 데이터만 조회(+/-버튼으로 주문가격만 바꿀때 이 타입으로 조회)
	'------------------------------------------------------------------------------------------------------
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , sType)
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , gAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , gAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , gCode)
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , gVndrCode)
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "2")
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CRNC_PRC" 		, 0 , edtPrc.caption)
	
	if gTotalYN == "Y" then
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "Y")
	else
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "N")
	end if
	
	DATAMANAGER.RequestTranData("obtro_oder_264r")	
	
End Function

'============================================================================
' 주문가능수량 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'-----------------------------------------
	' 정규장 현재가 조회
	'-----------------------------------------
	if szTranID == "ohhts_6000_001r" then
	
		gCurPrice = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" , 0)
		
		sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
		sAfterYN = Form.GetSharedData("OVRS_AFTER_MARKET_ORDER", false )
		
		'-----------------------------------------
		' 주간장일 경우 주간장 현재가 조회 서비스 호출
		'-----------------------------------------
		if sDayYN == "Y" then
			RequestDayMarketSiseData()
		
		elseif sAfterYN == "Y" then
			RequestAfterMarketSiseData()
		
		else
			SetInitData()
		end if
	
	'-----------------------------------------
	' 주간장 현재가 조회
	'-----------------------------------------
	elseif szTranID == "ohhts_6000_017r" then
	
		szDayPrc = Cdbl(DATAMANAGER.GetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0))
		
		'-----------------------------------------
		' 주간장 현재가가 있을 경우 현재가 대체
		'-----------------------------------------
		if szDayPrc <> 0 then
			gCurPrice = szDayPrc
			SetInitData()
		else
			SetInitData()
		end if
		
	'-----------------------------------------
	' 애프터 현재가 조회
	'-----------------------------------------
	elseif szTranID == "ohhts_6000_020r" then
	
		szAfterPrc = Cdbl(DATAMANAGER.GetDataValue(0, "ohhts_6000_020r", "OutBlock1", "FIDX_MKT_AFT_PRPR" , 0))
		
		'-----------------------------------------
		' 애프터 현재가가 있을 경우 현재가 대체
		'-----------------------------------------
		if szAfterPrc <> 0 then
			gCurPrice = szAfterPrc
			SetInitData()
		else
			SetInitData()
		end if
		
		
	elseif szTranID == "obtro_oder_264r" then
	
		if gTotalYN == "Y" then
			
			'-------------------------------------------------
			' 해당통화 주문가능 금액/수량
			'-------------------------------------------------
			'contTotal.tblAbleTotal.SetCellMaskInfo(0, 2, gMask)
			sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
			contTotal.tblAbleTotal.SetCellMaskInfo(0, 2, sMask)
			
			
			sOrdAblePrc = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_CAMT" , 0)
			sOrdAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY" , 0)
			
			contTotal.tblAbleTotal.SetCellString(0, 2, sOrdAblePrc)
			contTotal.LabelAbleTotalQtyData1.caption = sOrdAbleQty
			
			
			'-------------------------------------------------
			' 통합 주문가능 금액/수량
			'-------------------------------------------------
			'contTotal.tblAbleTotal.SetCellMaskInfo(2, 2, gMask)
			sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
			contTotal.tblAbleTotal.SetCellMaskInfo(2, 2, sMask)
			
			sOrdTotalAblePrc = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "INTG_MARG_ODER_ABLE_CAMT" , 0)
			sOrdTotalAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "INTG_MARG_ODER_ABLE_QTY" , 0)
			
			contTotal.tblAbleTotal.SetCellString(2, 2, sOrdTotalAblePrc)
			contTotal.LabelAbleTotalQtyData2.caption = sOrdTotalAbleQty
			
			if gType == "1" then
				
				'-------------------------------------------------
				' 통화별 가능금액
				'-------------------------------------------------
				sCurrencyCnt = DATAMANAGER.GetDataCount(0, "obtro_oder_264r", "OutBlock3")
				
				for i = 0 to Cint(sCurrencyCnt) - 1
					
					sCrcd = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock3", "CRCD" , i)
					contTotal.tblAbleTotalCurrency.SetCellString(i+1, 0, sCrcd)
					
					if sCrcd == "USD" then
						
						sMask = "0,0,,,0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 1, sMask)
						
						sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 2, sMask)
					
					elseif sCrcd == "KRW" then
						
						sMask = "0,0,,,0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 1, sMask)
						
						sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 2, sMask)
					
					elseif sCrcd == "CNY" then
						
						sMask = "0,0,,,0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 1, sMask)
						
						sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 2, sMask)
					
					elseif sCrcd == "HKD" then
						
						sMask = "0,0,,,0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 1, sMask)
						
						sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 2, sMask)
					
					elseif sCrcd == "JPY" then
						
						sMask = "0,0,,,0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 1, sMask)
						
						sMask = "0,0,, " & gCurrency & ",0,,".."2"..",1,1,2,0"
						contTotal.tblAbleTotalCurrency.SetCellMaskInfo(i+1, 2, sMask)
						
					end if
					
					'-------------------------------------------------
					'추정예수금/통합주문가능금액 세팅
					'-------------------------------------------------
					sDeposit 	= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock3", "FRCR_AMT" , i)
					sTotalAblePrc = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock3", "ODER_CRNC_ODER_ABLE_CAMT" , i)
					
					contTotal.tblAbleTotalCurrency.SetCellString(i+1, 1, sDeposit)
					contTotal.tblAbleTotalCurrency.SetCellString(i+1, 2, sTotalAblePrc)
				
				next
				
			end if
			
					
		else
			
			sOrdAblePrc 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_CAMT" 	, 0)
			sOrdAbleQty 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY" 	, 0)
			sDeposit 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock2", "FRCR_AMT" 		, 0)
			sAbleExChange 	= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock2", "UI_MNEC_ABLE_AMT" 	, 0)
			
			'-------------------------------------------------
			' 주문가능금액
			'-------------------------------------------------
			'tblAble.SetCellMaskInfo(0, 1, gMask)
