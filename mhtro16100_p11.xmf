				LabelDepositData.caption = sDeposit
				
				'-------------------------------------------------
				' 원화환전가능금액
				'-------------------------------------------------
				LabelAbleExchangeData.caption = sAbleExChange
				
			end if
			
		
		end if
	
	
	end if
	
End Sub

