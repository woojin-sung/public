			<CONTROL_INFO>
				<LABEL name="lblTitle0" fgcolor="334:034034034" fontsize="2" fontstyle="01" caption="ETF 투자할 때 발생되는 세금!" paddinginfo="1,0,0,0" ly_vert="20,30,335,25,1" />
				<LABEL name="lblTitle1" fgcolor="334:034034034" fontsize="2" fontstyle="01" caption="어떤게 있을까요?" paddinginfo="1,0,0,0" ly_vert="20,55,335,25,1" />
				<LABEL name="Label0" bgcolor="320:246247248" transmode="0" ly_vert="20,99,335,84,1" />
				<LABEL name="Label1" fgcolor="321:115118124" fontsize="-2" caption="ETF를 거래할 때 발생하는 매매차익에 대한 세금" paddinginfo="1,0,0,0" ly_vert="58,118,285,20,1" />
				<LABEL name="Label2" fgcolor="321:115118124" fontsize="-2" caption="ETF를 보유중에 받게되는 분배금에 대한 세금" paddinginfo="1,0,0,0" ly_vert="58,144,285,20,1" />
				<IMAGE name="imgCheck0" autosize="1" imgpath="icon_check" ly_vert="38,122,12,12,1" />
				<IMAGE name="imgCheck1" autosize="1" imgpath="icon_check" ly_vert="38,148,12,12,1" />
				<LABEL name="Label3" fontstyle="01" caption="ETF 종류별 과세" paddinginfo="1,0,0,0" ly_vert="20,213,335,20,1" />
				<TABLE name="Table0" outlinecolor="334:034034034" insidelinecolor="102:255255255" colcount="3" rowcount="7" outline="0100" designorder="1" ly_vert="20,249,335,220,1" >
					<COL_INFO ly_vert_width="87,125,123" />
					<ROW_INFO ly_vert_height="40,30,30,30,30,30,30" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="321:115118124" bgcolor="320:246247248" caption="구분" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="321:115118124" bgcolor="320:246247248" caption="매매차익" fontsize="-2" impidxs="" />
						<CELL cell_ly="2,0,2,0" fgcolor="321:115118124" bgcolor="320:246247248" line="0,1" caption="분배금" fontsize="-2" impidxs="" />
