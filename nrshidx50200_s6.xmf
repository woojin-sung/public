						<CELL cell_ly="2,1,2,6" fgcolor="334:034034034" line="0,1" caption="배당소득세15.4%" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="321:115118124" bgcolor="320:246247248" valign="0" caption="주식형 ETF" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="321:115118124" bgcolor="320:246247248" valign="2" line="1,0" caption="국내상장" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,3,1,4" fgcolor="334:034034034" caption="배당소득세15.4%" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="321:115118124" bgcolor="320:246247248" valign="0" caption="기타 ETF" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="321:115118124" bgcolor="320:246247248" valign="2" line="1,0" caption="해외상장" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,5,1,5" fgcolor="334:034034034" valign="2" line="1,0" caption="양도소득세22%" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="321:115118124" bgcolor="320:246247248" valign="0" caption="ETF" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,6,1,6" fgcolor="321:115118124" valign="0" caption="(단, 250만원 공제)" fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="Label4" fgcolor="321:115118124" fontsize="-2" caption="해외시장에 상장된 ETF는 해외주식과 과세상 동일하게 취
급되어 매매차익은 해외주식 양도소득세로, 분배금은 배당
소득세로 과세됩니다.
양도소득세는 매매차익 250만원까지는 공제되고, 초과한
금액에 대해 22% 세율이 적용됩니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,491,335,100,1" />
				<LABEL name="Label5" fontstyle="01" caption="ETF 세금! 피할 수 없다면 아껴라" paddinginfo="1,0,0,0" ly_vert="20,623,335,20,1" />
				<LABEL name="Label6" fgcolor="321:115118124" fontsize="-2" caption="ETF에 투자할 때 연금계좌(연금저축과 IRP)혹은 ISA계좌
를 이용하는 것은 좋은 절세 전략입니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,651,335,40,1" />
				<TABLE name="Table1" outlinecolor="334:034034034" insidelinecolor="102:255255255" colcount="3" rowcount="7" outline="0100" designorder="1" ly_vert="20,699,335,220,1" >
					<COL_INFO ly_vert_width="77,135,123" />
					<ROW_INFO ly_vert_height="40,30,30,30,30,30,30" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="321:115118124" bgcolor="320:246247248" caption="구분" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="321:115118124" bgcolor="320:246247248" caption="매매차익" fontsize="-2" impidxs="" />
						<CELL cell_ly="2,0,2,0" fgcolor="321:115118124" bgcolor="320:246247248" line="0,1" caption="분배금" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,2" fgcolor="321:115118124" bgcolor="320:246247248" caption="일반계좌" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,1,2,2" fgcolor="334:034034034" line="0,1" caption="배당소득세" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,4" fgcolor="321:115118124" bgcolor="320:246247248" caption="연금계좌" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,3,2,3" fgcolor="334:034034034" valign="2" line="0,0" caption="과세이연" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,4,2,4" fgcolor="321:115118124" valign="0" line="0,1" caption="(연금 수령 시 연금소득세 3.3~5.5%)" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,5,0,6" fgcolor="321:115118124" bgcolor="320:246247248" caption="ISA계좌" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,5,2,5" fgcolor="334:034034034" valign="2" line="0,0" caption="일반형 200만원(서민형 400만원)까지 비과세" fontsize="-3" autofontsize="1" impidxs="" />
						<CELL cell_ly="1,6,2,6" fgcolor="321:115118124" valign="0" line="0,1" caption="(초과분 9.9% 분리과세)" fontsize="-3" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table2" insidelinecolor="102:255255255" colcount="1" rowcount="11" outline="0000" designorder="1" ly_vert="20,936,335,205,1" >
					<COL_INFO ly_vert_width="335" />
					<ROW_INFO ly_vert_height="18,18,18,18,18,18,18,18,18,18,25" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="321:115118124" halign="0" line="0,0" caption="연금 계좌는 수익을 찾을 때까지 과세하지 않습니다. 연금" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="321:115118124" halign="0" line="0,0" caption="을 수령할때 배당소득세(15.4%)가 아닌 연금소득세" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="321:115118124" halign="0" line="0,0" caption="(3.3~5.5%)만 내면 되니 세금을 절약할 수 있습니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="321:115118124" halign="0" line="0,0" caption="연금이 연 1500만원 이하일 경우 분리과세되고, 초과시" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="321:115118124" halign="0" line="0,0" caption="금융소득종합과세되니 유의해주세요." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="321:115118124" halign="0" line="0,0" caption="또한 ISA계좌는 발생한 수익에 대해 일반형 200만원(서민" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="321:115118124" halign="0" line="0,0" caption="형 400만원)까지는 비과세이고, 초과분에 대해서는 9.9% " fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="321:115118124" halign="0" line="0,0" caption="저율로 분리과세하는 절세 계좌입니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
