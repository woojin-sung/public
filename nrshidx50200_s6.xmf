	contMain.imgCheck1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contMain.lblTitle0.setHighlight(332)
	contMain.lblTitle1.setHighlight(332)
	
	contMain.Label1.changeTextAttr(16, 11, 334, -2, true)
	contMain.Label2.changeTextAttr(15, 10, 334, -2, true)
End Sub

