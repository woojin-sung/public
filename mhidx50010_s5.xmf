		<IMAGE name="imgNationDown" visible="0" imgpath="icon_arrow_d" ly_vert="342,52,10,11,0" />
		<IMAGE name="ImageNation" visible="0" imgpath="flag_us2" ly_vert="250,50,14,14,0" />
		<BUTTON name="BtnSelectNation" btnimage="alpha" ly_vert="240,40,130,32,1" />
