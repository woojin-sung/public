	<SCRIPT_INFO _len="6959" _ulen="6635" >
'============================================================================
' 01. 화 면 명 : HOME_업계동향
' 02. 화면설명 : 업계동향
' 03. 작    성 : 
'============================================================================
Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false )
	
	'20240618 LES START
	imgNationDown.setMaintainingRatio("1")
	ImageNation.setMaintainingRatio("1")
	LabelNation.paddinginfo = "0,0,0,0"
	LabelNation.sizeAutoFit()
	'20240618 LES END

End Sub

'============================================================================
Sub Form_OnFormInit()
	
	lblTitle.fgcolor = 334
	
	'20240620 LES START
	sRdoNationIndex = Form.GetSharedData("HOME_RANKING_INDEX", true )
	
	'-----------------------------
	' 국내
	'-----------------------------
	if sRdoNationIndex == "0" then
	
		rdoNation.currentindex = 0
		nIndex = CInt(rdoNation.currentindex)
		call rdoNation_OnClick(nIndex)
	
	'-----------------------------
	' 해외
	'-----------------------------
	elseif sRdoNationIndex == "1" then
		
		rdoNation.currentindex = Cint(sRdoNationIndex)
		
		sOvrsMarketIndex = Form.GetSharedData("HOME_RANKING_OVRS_MARKET", true )
		sOvrsCondIndex = Form.GetSharedData("HOME_RANKING_OVRS_COND", true )
		
		if sOvrsMarketIndex <> "" then
			ComboNation.currentindex = Cint(sOvrsMarketIndex)
		end if
		
		Form.triggerEvent("linkfm", "SEND_PREV_COND", sOvrsMarketIndex & "★" & sOvrsCondIndex)
	
	'-----------------------------
	' 빈값이거나 그 외 값
	'-----------------------------
	else
		'----------------------------------------------------------------------
		'미국장 장운영정보 조회(미국 정규장일때, 초기탭 해외로 설정)
		'----------------------------------------------------------------------
		RequestMarketTime("01")
		
	end if
	'20240620 LES END
	
	linkfm.gesture = true
	
End Sub

'============================================================================
Sub rdoNation_OnClick(nIndex)
	if CInt(nIndex) = 0 then	'국내
		
		'20240618 LES START
		ComboNation.visible = false
		BtnSelectNation.visible = false
		LabelNation.visible = false
		imgNationDown.visible = false
		ImageNation.visible = false
		'20240618 LES END
	
		linkfm.linkfile = "mhidx50010_t3"
	else						'해외
		
		'20240618 LES START
		ComboNation.visible = false
		BtnSelectNation.visible = true
		LabelNation.visible = true
		imgNationDown.visible = true
		ImageNation.visible = true
		
		LabelNation.caption = "미국"
		ImageNation.imgpath = "flag_us2"
		'20240618 LES END
		
		linkfm.linkfile = "mhidx50010_t4"
	end if
End Sub

'============================================================================
Sub lblMore0_OnClick()
	Form.triggerEvent("linkfm", "MOVE_MORE_SCREEN", "HOME")

End Sub

'============================================================================
' 20240618 LES START
'============================================================================
Sub ComboNation_OnEditComplete(iIndex)
	
	Form.triggerEvent("linkfm", "SELECT_NATION", iIndex)
	
	'국가명 세팅
	sNationName = ComboNation.caption
	LabelNation.caption = sNationName
	
	'국기 이미지 세팅
	sFlagName = "flag_general"
	
	if iIndex == 0 or iIndex == "0" then
		sFlagName = "flag_us2"
	elseif iIndex == 1 or iIndex == "1" then
		sFlagName = "flag_chn"
	elseif iIndex == 2 or iIndex == "2" then
		sFlagName = "flag_chn"
	elseif iIndex == 3 or iIndex == "3" then
		sFlagName = "flag_hk"
	elseif iIndex == 4 or iIndex == "4" then
		sFlagName = "flag_jp2"
	end if
	
	ImageNation.imgpath = sFlagName
	
	
End Sub

'============================================================================
Sub LabelNation_OnSizeAutoFit()

	if gOsType == "1" then
		nLeftLabel = Form.calcUnResize(LabelNation.left, "2")
		nWidtArrow = Form.calcUnResize(ImageNation.width, "2")
	else
		nLeftLabel = LabelNation.left
		nWidtArrow = ImageNation.width
	end if
	
	ImageNation.left = nLeftLabel - nWidtArrow - 3

End Sub

'============================================================================
Sub BtnSelectNation_OnClick()
	ComboNation.OpenList()
End Sub

'스와이프 기능 추가
'============================================================================
Sub linkfm_OnGestureEvent(sEvent)
	if sEvent == "RtoL" then
		Form.triggerEvent( "linkfm", "SWIPE", "NEXT"  )
		
	elseif sEvent == "LtoR" then
		Form.triggerEvent( "linkfm", "SWIPE", "PREV"  )
	end if
	
End Sub

'============================================================================
' 미국시장 장운영정보 조회
'============================================================================
Function RequestMarketTime(sCountryCode)

	DATAMANAGER.SetDataValue(0, "obtro_comn_010r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , sCountryCode)
	DATAMANAGER.RequestTranData("obtro_comn_010r")
		
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'-----------------------------------------------------------
	'해외 장운영정보 조회
	'-----------------------------------------------------------
	if szTranID == "obtro_comn_010r" then
	
		'-----------------------------------------------------------
		' 장운영정보
		'-----------------------------------------------------------
		sMkop = DATAMANAGER.GetDataValue(0, "obtro_comn_010r", "OutBlock1", "OVRS_MKOP_CLS_CODE" , 0)
		
		'---------------------------------------------------------------
		' 미국 정규장 시, 초기 탭 "해외"로 설정. 그외에는 "국내"로 설정
		' 004:정규개시 / 011:장개시
		'---------------------------------------------------------------
		if sMkop == "004" or sMkop == "011" then
			
			rdoNation.currentindex = 1
			
			sOvrsMarketIndex = Form.GetSharedData("HOME_RANKING_OVRS_MARKET", true )
			sOvrsCondIndex = Form.GetSharedData("HOME_RANKING_OVRS_COND", true )
			
			if sOvrsMarketIndex <> "" then
				ComboNation.currentindex = Cint(sOvrsMarketIndex)
			end if
			
			Form.triggerEvent("linkfm", "SEND_PREV_COND", sOvrsMarketIndex & "★" & sOvrsCondIndex)
		
		else
		
			rdoNation.currentindex = 0
			call rdoNation_OnClick(0)
		
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	RequestMarketTime("01")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'---------------------------------------------------------------
	' 미국장운영정보 조회 오류 시, 무조건 국내탭으로 초기탭 설정
	'---------------------------------------------------------------
	if szTranID == "obtro_comn_010r" then
	
		rdoNation.currentindex = 0
		call rdoNation_OnClick(0)
	
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtro_comn_010r" trcode="obtro_comn_010r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtro_comn_010r" title="해외주식 장운영정보 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="85" _ulen="61" >

OVRS_STCK_MRKT_TR_CLS_CODE^해외주식시장거래구분코드^2^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="244" _ulen="178" >

OVRS_STCK_MRKT_TR_CLS_CODE^해외주식시장거래구분코드^2^0^0^0^0^0^0
OVRS_MKOP_CLS_CODE^해외장운영구분코드^3^0^0^0^0^0^0
MRKT_BEGN_TIME^시장개시시각^9^0^0^0^0^0^0
MRKT_FIN_TIME^시장종료시각^9^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>