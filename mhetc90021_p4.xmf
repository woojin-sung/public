'============================================================================
Sub btnOK_OnClick()
	
	UserID = Form.GetSharedData( "&USER_ID", 0 )
	
	Form.SetEnvData(1, UserID&"OTCPOPUP", "1")
	Form.CloseForm()
	Form.OpenFramePopup("notice_p6" , "mhetc90021_p4" , "")	
End Sub

'============================================================================


'============================================================================
Sub Form_OnFormClose()
	
