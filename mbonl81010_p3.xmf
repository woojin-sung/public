	<SCRIPT_INFO _len="24375" _ulen="22211" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객투자성향진단
' 02. 화면설명 : 고객투자성향진단_고위험거래가입팝업
' 03. 작    성 : 2016.02.17	
' 04. 수    정 : 2016.11.10 주식 공모주청약 관련 프로세스 추가 v002
'                2017.07.11 CME/EUREX 약정 추가 v003
'                2017.12.21 윤유정 : 해외주식, 해외파생ETF 약정 추가 v004
'		      : 2018.03.14 : 김유경 : 변동성ETN거래신청 추가 v005
' 2021.05.27 : 정민영 :v006 : ETF -> 파생상품ETF 명칭 변경(By전요셉Cha)
' 2021.06.16 : 김인택 :v007 : 부적합확인서 서식변경(금융소비자보호법) 
' 2021.08.26 : 정효영 :v008 : 박미선 대리님 요청으로 타이틀 중간에 짤리지 않도록 타이틀 생성하여 풀 팝업으로 변경 (mbonl81010_p1 에서만 열고 있어 수정함)
' 2021.12.27 : 김수진 :v009 : K-OTC 거래신청 추가
' 2022.04.21 : 김성수 :v010 : 해외주식 소수점 거래 신청 추가
' 2022.07.01 : 임동군 :v011 : 펀드거래시 버튼명 변경
' 2023.07.04 : 양현정 :v012 : 발행어음관련 수정
' 2023.12.05 : 권오상 :V013 : 투자성향 상품등급 6단계 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

dim	g_szAcno		'계좌번호
dim	g_szAsno		'계좌일련번호
dim	g_szBswr		'KYC업무분류코드(KYC_BSWR_DIV_COE)
dim	g_szDiv		'업무분류코드(BSWR_DIV_CODE)
dim	g_szISCD		'종목코드
dim	g_szAlertTitle	'알림타이틀
Dim g_szScrNo 	'호출한 화면번호

Dim g_szRetData 
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 		'KYC상품등급코드
Dim g_szKYC_DVPD_EPMD_CODE 		'KYC파생상품유의코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szDVPD_GRAD_CODE 			'파생상품등급코드
Dim g_szFIT_PROD_GRAD_CODE		'적합상품등급코드 V013

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setGlobalItems(szInput)


	g_szScrNo	=	getListItem(szInput, 0)
	g_szAcno		=	getListItem(szInput, 1)
	g_szAsno		=	getListItem(szInput, 2)
	g_szBswr		=	getListItem(szInput, 3)
	g_szDiv		=	getListItem(szInput, 4)
	g_szISCD		=	getListItem(szInput, 5)


	g_szKYC_INVT_INCL_GRAD_CODE 	=	getListItem(szInput, 6)
	g_szKYC_PROD_GRAD_CODE 		=	getListItem(szInput, 7)
	g_szKYC_DVPD_EPMD_CODE 		=	getListItem(szInput, 8)
	g_szKYC_DRVT_PROS_YN 			=	getListItem(szInput, 9)
	g_szDVPD_GRAD_CODE 			=	getListItem(szInput, 10)

	If g_szKYC_INVT_INCL_GRAD_CODE == "05" Then
		g_szFIT_PROD_GRAD_CODE = "06"
	ElseIf g_szKYC_INVT_INCL_GRAD_CODE == "04" Then
		g_szFIT_PROD_GRAD_CODE = "05"
	ElseIf g_szKYC_INVT_INCL_GRAD_CODE == "03" Then
		g_szFIT_PROD_GRAD_CODE = "04"
	Else
		g_szFIT_PROD_GRAD_CODE = g_szKYC_INVT_INCL_GRAD_CODE
	End If
End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function



