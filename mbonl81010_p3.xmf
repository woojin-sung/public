Sub imgClose_OnClick()
	g_sRetData	=	"CANCEL"
	Form.SendReturnToParent("mbonl81010_p3" , g_sRetData)

	Form.CloseForm()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_703a" then
	
	     ' 84010 종합매매계좌개설 , 83110 주식공모주쳥약 은 부적합을 주식 매매로 처리함
		if	g_szScrNo == "84010" or g_szScrNo == "83110"	then 'v002 83110 주식공모주쳥약 화면 추가
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_szKYC_PROD_GRAD_CODE )
			'DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , g_szBswr ) 'v002
			'DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "BSWR_DIV_CODE" , 0 , g_szDiv ) 'v002
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "04" ) 'v002
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "BSWR_DIV_CODE" , 0 , "13009"  ) 'v002
			
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "ACNO" , 0 , g_szAcno )
			'DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "PRCD" , 0 , "100" )            'v002
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "PRCD" , 0 , "" )                'v002
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )		'온라인 :  4
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_szKYC_PROD_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , g_szBswr ) 
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "BSWR_DIV_CODE" , 0 , g_szDiv )
		
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "ACNO" , 0 , g_szAcno )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "ASNO" , 0 , g_szAsno )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "ISCD" , 0 , g_szISCD )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "PRCD" , 0 , "" )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_szKYC_DRVT_PROS_YN )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_szKYC_DVPD_EPMD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_703a", "InBlock1", "DVPD_GRAD_CODE" , 0 , g_szDVPD_GRAD_CODE )
		end	if
	'v008 소수점 거래 추가 START
	elseif szTranID == "obcsb_acif_713a" then
		dim nCnt
		if g_szScrNo == "87052_1" then '해외주식 소수점 약정
			nCnt = 1
		elseif g_szScrNo == "87052_2" then '해외주식 소수점 약정2
			nCnt = 1
		elseif g_szScrNo == "87052_3" then '해외주식 소수점 약정3
			nCnt = 2
		elseif g_szScrNo == "87052_4" then '해외주식 소수점 약정4
			nCnt = 1
		end if
		
		if nCnt > 1 then
			for i=0 to nCnt-1 
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , i , g_szKYC_INVT_INCL_GRAD_CODE )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_PROD_GRAD_CODE" , i , g_szKYC_PROD_GRAD_CODE )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE" , i , g_szBswr ) 
				if i == 0 then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , i , g_szDiv )
				elseif i == 1 then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , i , g_szDiv_1 )
				elseif i == 2 then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , i , g_szDiv_2 )
				end if
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , i , g_szAcno )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , i , g_szAsno )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , i , g_szISCD )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRCD" , i , "" )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DRVT_PROS_YN" , i , g_szKYC_DRVT_PROS_YN )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DVPD_EPMD_CODE" , i , g_szKYC_DVPD_EPMD_CODE )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , i , "4" )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DVPD_GRAD_CODE" , i , g_szDVPD_GRAD_CODE )
			next
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_szKYC_PROD_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , g_szBswr ) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , 0 , g_szDiv )
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szAsno )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , 0 , g_szISCD )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRCD" , 0 , "" )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_szKYC_DRVT_PROS_YN )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_szKYC_DVPD_EPMD_CODE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DVPD_GRAD_CODE" , 0 , g_szDVPD_GRAD_CODE )
		end if
	'v008 소수점 거래 추가 END
	end if
End Sub
'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_703a" then
		Dim sSUCS_YN, sCSNO, sSTND_DATE, sREG_SRNO
		sSUCS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_acif_703a", "OutBlock1", "SUCS_YN" , 0 )
		sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_703a", "OutBlock1", "CSNO" , 0 )
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_703a", "OutBlock1", "STND_DATE" , 0 )
		sREG_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_703a", "OutBlock1", "REG_SRNO" , 0 )
		
		Form.SetSharedData("KYC_SUCS_YN", sSUCS_YN)
		Form.SetSharedData("KYC_CSNO",sCSNO)
		Form.SetSharedData("KYC_STND_DATE", sSTND_DATE)
		Form.SetSharedData("KYC_REG_SRNO",sREG_SRNO)
		g_sRetData = "OK"
		Form.CloseForm()
	'v008 소수점 거래 추가 START
	elseif szTranID == "obcsb_acif_713a" then
		dim nDataCnt
		nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		if nDataCnt > 0 then
			Dim sSUCS_YN, sCSNO, sSTND_DATE, sREG_SRNO
			for i=0 to nDataCnt-1
				sSUCS_YN 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SUCS_YN" 	, i )
				sCSNO 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO" 		, i )
				sSTND_DATE 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STND_DATE" 	, i )
				sREG_SRNO 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "REG_SRNO" 	, i )
				
				Form.SetSharedData("KYC_SUCS_YN_"&i+1, sSUCS_YN)
				Form.SetSharedData("KYC_CSNO_"&i+1,sCSNO)
				Form.SetSharedData("KYC_STND_DATE_"&i+1, sSTND_DATE)
				Form.SetSharedData("KYC_REG_SRNO_"&i+1,sREG_SRNO)
			next
			g_sRetData = "OK"
		end if
		
		Form.CloseForm()
	'v008 소수점 거래 추가 END
	end if
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()

	if	g_sRetData		<>	"OK"		then
		g_sRetData	=	"CANCEL"
		
		Form.SetSharedData("KYC_ACNO" , null)
		Form.SetSharedData("KYC_INVT_INCL_GRAD_CODE" , null)
		Form.SetSharedData("KYC_PROD_GRAD_CODE" , null)
		Form.SetSharedData("KYC_DVPD_EPMD_CODE" , null)
		Form.SetSharedData("KYC_DRVT_PROS_YN" , null)
		Form.SetSharedData("KYC_DVPD_GRAD_CODE" , null)
		
		Form.SendReturnToParent("mbonl81010_p3" , g_sRetData)
	else
		Form.SendReturnToParent("mbonl81010_p3" , g_sRetData)
	end if
End Sub



'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub
'============================================================================
Sub Container0_Button0_OnClick()
	Form.OpenFramePopup("mbonl81010_p12" , "", "")
End Sub


