'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_sRetData = "CANCEL"
	szLinkedData = Form.GetOpenLinkData( )
	
'	Form.SetScreenName("투자성향에 적합(적정)하지 않은\n투자성 상품 거래 확인")


	if szLinkedData = "" then
		Form.ShowAlert(g_szAlertTitle, "입력값이 없습니다.")
	else
		setGlobalItems(szLinkedData)
	end if 

        ' v011
        IF g_szScrNo == "51000"  THEN
	    btnCancel.caption  = "가입중단"
	END IF


	'신용계좌개설,	펀드매매,	ELS/DLS청약,   온라인계좌개설 (종합매매), 공모주청약-주식 v002
	'CME/EUREX 약정 추가 v003
	'해외주식, 해외파생ETF 약정 추가 v004
	'CMA유형전환신청 추가 v012
	'해외(주식.ETP)거래 화면번호 변경 (87051 > 87057)	
	if g_szScrNo == "82010" or	g_szScrNo == "51000" or g_szScrNo == "53000" or  g_szScrNo == "84010" or g_szScrNo == "83110" or g_szScrNo == "87040_t1" or g_szScrNo == "87040_t2" or g_szScrNo == "87050" or g_szScrNo == "87051" 
		or g_szScrNo == "87052_1" or g_szScrNo == "87052_2" or g_szScrNo == "87052_3" or g_szScrNo == "87052_4"  or g_szScrNo == "88060" or g_szScrNo == "89030" or g_szScrNo == "87057_1" or g_szScrNo == "87057_2" or g_szScrNo == "87057_3" then 
		'Form.MsgBox( g_szAlertTitle, "111111", "", 6 )
		sName = Form.GetSharedData("&USER_NAME", false )
			
'		szGRAD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_INVT_INCL_GRAD_CODE) 'v013
		szGRAD_NAME 		= Form.GetMetaData("상품등급코드", g_szFIT_PROD_GRAD_CODE) 'v013
		szKYC_GRAD_NAME 	= Form.GetMetaData("KYC투자성향등급코드", g_szKYC_INVT_INCL_GRAD_CODE)
		szPROD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_PROD_GRAD_CODE)
		szKYC_PROD_NAME 	= Form.GetMetaData("KYC상품등급코드", g_szKYC_PROD_GRAD_CODE)
		
		'v007 Container0.tbl01.SetCellString( 1, 1, g_szAcno & g_szAsno)
		'v007 Container0.tbl01.SetCellString( 1, 4, sName )
		'Container0.tbl01.SetCellString( 4, 3, szKYC_GRAD_NAME.."("..CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급)") 'v007
		Container0.tbl01.SetCellString( 4, 3, szKYC_GRAD_NAME) 'v007
'		Container0.tbl01.SetCellString( 5, 3, szGRAD_NAME.."("..CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급)") 'v007
		Container0.tbl01.SetCellString( 5, 3, szGRAD_NAME.."("..CInt(g_szFIT_PROD_GRAD_CODE).."등급)") 'v007
		'v007 Container0.tbl01.SetCellString( 4, 2, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
		
		
		if	g_szScrNo	=	"82010"	then
			szProdName	=	"신용계좌개설"
		elseif	g_szScrNo	=	"51000"	then
			szProdName	=	"펀드매매"
		elseif	g_szScrNo	=	"53000"	then
			szProdName	=	"ELS/DLS청약"
		elseif	g_szScrNo	=	"84010"	then
			'szProdName	=	"온라인계좌개설"   '종합매매계좌 개설 시 부적합 징구는 주식매매로 징구함 v002	
			szProdName	=	"주식 매매"   
		elseif   g_szScrNo	=	"83110"	then '공모주청약-주식 v002	
		     szProdName	=	"주식 매매"
		elseif   g_szScrNo	=	"87040_t1"	then 'CME 야간거래 v003	
		     szProdName	=	"CME 야간거래"
		elseif   g_szScrNo	=	"87040_t2"	then 'EUREX 야간거래 v003	
		     szProdName	=	"EUREX 야간거래"
		elseif   g_szScrNo	=	"87050"	then '해외파생ETF 약정 v004
		     szProdName	=	"해외ETP 거래"
		elseif   g_szScrNo	=	"87051"	then '해외주식 약정 v004
		     szProdName	=	"해외주식 거래"	
		     
		'2023.05.23  해외주식/ETP 거래신청----------------------------------
		elseif   g_szScrNo	=	"87057_1"	then '해외주식 거래 약정 1
			g_szDiv = "17190"
