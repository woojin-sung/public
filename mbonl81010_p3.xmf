'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	'v007
	'if Container0.ChkButton0.chksilence == "0" AND Container0.ChkButton1.chksilence == "0" then
	'	Form.MsgBox( g_szAlertTitle, "내용을 확인해 주세요.", "", 6 )
	'	Exit Sub
	'end if
	
	
	if Container0.ChkButton0.chksilence == "0"  then
		Form.MsgBox( g_szAlertTitle, "체크박스를 확인해 주세요.", "", 6 )
		Exit Sub
	end if
	
	'if Container0.ChkButton1.chksilence == "0" then
	'	Form.MsgBox( g_szAlertTitle, "내용을 확인해 주세요.(투자성상품 적정성 판단 보고서)", "", 6 )
	'	Exit Sub
	'end if
	'v008 소수점 거래 추가 START
	if g_szScrNo == "87052_1" or g_szScrNo == "87052_2" or g_szScrNo == "87052_3" or g_szScrNo == "87052_4" then
		DATAMANAGER.SetEventFlag( "obcsb_acif_713a", "I" )
		DATAMANAGER.RequestTranData( "obcsb_acif_713a" )
	else
		DATAMANAGER.SetEventFlag( "obcsb_acif_703a", "I" )
		DATAMANAGER.RequestTranData( "obcsb_acif_703a" )
	end if
	'v008 소수점 거래 추가 END
End Sub


'============================================================================
'btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	'20220712 ITGEN START
	'  신규매수인경우(화면번호가 51000에서 호출된 경우 "가입중단" ) 51000화면 실행
	if g_szScrNo == "51000" then
		Form.OpenScreen("51000" , "")
		Form.CloseForm()
		Exit Sub
	end if
	'20220712 ITGEN END
	
	g_sRetData	=	"CANCEL"
	Form.SendReturnToParent("mbonl81010_p3" , g_sRetData)

	Form.CloseForm()
End Sub

'============================================================================
' 21.08.26 JHY 추가 (v008)
