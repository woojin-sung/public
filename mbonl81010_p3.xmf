		elseif   g_szScrNo	=	"87057_3"	then 'ETP 거래 약정 3
			g_szDiv = "17192"		
			szProdName	=	"해외주식 ETP 거래"
		'---------------------------------------------------------------------
		
		'v010 START
		elseif   g_szScrNo	=	"87052_1" then '해외주식 소수점 약정1
			szProdName	=	"해외주식 소수점 거래"
		elseif   g_szScrNo	=	"87052_2" then '해외주식 소수점 약정2
			szProdName	=	"해외주식 ETP 거래"
			g_szDiv = "17192"
			'g_szDiv_1 = "17213"
			'Container0.tbl01.SetCellString( 8, 0, "해외주식 ETP 거래" )
			'Container0.tbl01.SetCellString( 8, 3, szPROD_NAME.."("..CInt(g_szKYC_PROD_GRAD_CODE).."등급)")			
		elseif   g_szScrNo	=	"87052_3" then '해외주식 소수점 약정3
			szProdName	=	"해외주식 거래"
			g_szDiv = "17190"
			g_szDiv_1 = "17192"
			'g_szDiv_2 = "17213"
			'Container0.tbl01.SetCellString( 8, 0, "해외주식 거래" )
			Container0.tbl01.SetCellString( 8, 0, "해외주식 ETP 거래" )
			'Container0.tbl01.SetCellString( 8, 3, szPROD_NAME.."("..CInt(g_szKYC_PROD_GRAD_CODE).."등급)")			
			Container0.tbl01.SetCellString( 8, 3, szPROD_NAME.."("..CInt(g_szKYC_PROD_GRAD_CODE).."등급)")	
			'Container0.tbl01.SetCellString( 8, 5, "부적합")			
			Container0.tbl01.SetCellString( 8, 5, "부적합")			
		elseif   g_szScrNo	=	"87052_4" then '해외주식 소수점 약정4
			szProdName	=	"해외주식 거래"
			g_szDiv = "17190"
			'g_szDiv_1 = "17213"
			'Container0.tbl01.SetCellString( 8, 0, "해외주식 거래" )
			'Container0.tbl01.SetCellString( 8, 3, szPROD_NAME.."("..CInt(g_szKYC_PROD_GRAD_CODE).."등급)")			
		'v010 END
		elseif   g_szScrNo	=	"88060" then '해외주식 소수점 약정1		
			szProdName	=	"단기사채"
		elseif   g_szScrNo	=	"89030" then 'v012 CMA계좌
			szProdName	=	"CMA계좌"			
		else
			szProdName	=	" "
		end if
		
		'v007
		Container0.tbl01.SetCellString( 7, 0, szProdName )			
		Container0.tbl01.SetCellString( 7, 3, szPROD_NAME.."("..CInt(g_szKYC_PROD_GRAD_CODE).."등급)")			
		
		
		
		'적정성보고서 v007 주석
'		Container0.Table1.SetCellString( 1, 1, sName )
'		Container0.Table1.SetCellString( 1, 3, g_szAcno & g_szAsno)
'		Container0.Table1.SetCellString( 2, 1, szProdName )
'		Container0.Table1.SetCellString( 2, 3, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
'		Container0.Table2.SetCellString( 6, 1, CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급 ".."("..szKYC_GRAD_NAME..")" )

	'ELW/ETF/ETN/ELS
	'v005 변동성ETN거래신청 약정 추가 (g_szScrNo="88021")
	'v009 K-OTC 거래신청 약정 추가 (g_szScrNo="88050")
	elseif g_szScrNo == "88010" or	g_szScrNo == "88000" or g_szScrNo == "88020" or g_szScrNo == "53000" or g_szScrNo == "88021" or g_szScrNo == "88021" or g_szScrNo == "88050" then 'ETN거래신청
		'Form.MsgBox( g_szAlertTitle, "22222", "", 6 )
		sName = Form.GetSharedData("&USER_NAME", false )
		
	
		szGRAD_NAME 		= Form.GetMetaData("상품등급코드", g_szFIT_PROD_GRAD_CODE)
		szKYC_GRAD_NAME 	= Form.GetMetaData("KYC투자성향등급코드", g_szKYC_INVT_INCL_GRAD_CODE)
		szPROD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_PROD_GRAD_CODE)
		szKYC_PROD_NAME 	= Form.GetMetaData("KYC상품등급코드", g_szKYC_PROD_GRAD_CODE)
		
		'Container0.tbl01.SetCellString( 1, 1, g_szAcno )
		'Container0.tbl01.SetCellMaskInfo( 1, 1, "1,0,,,1,####-####,0,1,1" )
		'Container0.tbl01.SetCellString( 1, 4, sName )
		'Container0.tbl01.SetCellString( 4, 0, CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급 ".."("..szKYC_GRAD_NAME..")" )
		'Container0.tbl01.SetCellString( 4, 4, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
		'Container0.tbl01.SetCellString( 4, 3, szKYC_GRAD_NAME.."("..CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급)") 'v007 투자성향등급
		Container0.tbl01.SetCellString( 4, 3, szKYC_GRAD_NAME) 'v007 투자성향등급
		Container0.tbl01.SetCellString( 5, 3, szGRAD_NAME.."("..CInt(g_szFIT_PROD_GRAD_CODE).."등급)") 'v007 적합상품
		
		if	g_szScrNo	=	"88010"	then
			szProdName	=	"ELW거래신청"
		elseif	g_szScrNo	=	"88000"	then
			szProdName	=	"파생상품ETF 거래신청"  'v006
		elseif	g_szScrNo	=	"88020"	then
			szProdName	=	"ETN거래신청"
		elseif	g_szScrNo	=	"53000"	then
			szProdName	=	"ELS/DLS청약"
		'v005 변동성ETN거래신청
		elseif	g_szScrNo	=	"88021"	then
			szProdName	=	"변동성ETN거래신청"
		'v009 K-OTC 거래신청
		elseif	g_szScrNo	=	"88050"	then
			szProdName	=	"K-OTC 거래신청"				
		else
			szProdName	=	" "
		end if
		
		'v007 Container0.tbl01.SetCellString( 4, 2, szProdName )
		
		'v007
		Container0.tbl01.SetCellString( 7, 0, szProdName )			
		Container0.tbl01.SetCellString( 7, 3, szPROD_NAME.."("..CInt(g_szKYC_PROD_GRAD_CODE).."등급)")	
		
		'적정성보고서
