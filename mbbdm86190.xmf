End Sub


'============================================================================
Sub ContMain_Edit1_OnEditComplete()
	'JMY 계좌번호에 포커싱
	If ContMain.Edit1.caption ~= "" Or ContMain.Edit1.caption ~= null Then
		ContMain.Edit0.SetShowKeypad(true)
	End If
End Sub
'============================================================================
'2021.04.07. 백버튼 불가 추가
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    Call Image0_OnClick()
End Sub


'============================================================================
Sub Form_OnFormInitBefore()
	ImgF.setMaintainingRatio("5")
	Image0.setMaintainingRatio("1")
	ContMain.Image1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ABORT" and sRet == "ok" then
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
		
		If sNmetBswrGb = "100" Then '100.비대면계좌개설
			Form.OpenNextPopup("mbbdm85100" , "" , "")
		else
			Form.CloseForm()
		end if
            
	elseif sKeyName == "PrgsExit" then		
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
		
'		Form.CloseForm()		
		Form.OpenNextPopup("mbbdm85100", "", "")	
	end if  
End Sub

