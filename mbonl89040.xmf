	<SCRIPT_INFO _len="9544" _ulen="8936" >
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szPwd
Dim g_CUST_ENG_NAME

'20240611 SWJ START
Dim g_sOSType
g_sOSType = ""
'20240611 SWJ END

'============================================================================
'					F O R M	F U N C T I O N
'============================================================================
Sub Form_OnFormInit()
	'Table2.SetCellString(1, 1, "영문명 입력 > 고객영문명 등록/변경 창에서 변경할 수 있습니다.")

	f_Reset()
	
	'20240611 SWJ START
	g_sOSType = Form.GetSharedData("&OS_TYPE", false)
	'20240611 SWJ END
	
	Dim nAcntCnt
	nAcntCnt = CInt(Account0.accountcount)

	if nAcntCnt > 0 then
		DATAMANAGER.RequestTranData("obtsd_fbnk_005r")
	else
		btnNext.enable	= false
		BtnNm.enable		= false
		LblNm.caption		= ""
		Table0.SetCellString(1, 1, "")
		Table0.SetCellString(0, 1, "미등록")
		Table0.SetCellFgColor(0, 1, "110")
	end if
	
End Sub
'============================================================================
'20240611 SWJ START
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub
'20240611 SWJ END
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	if sKeyName == "obtsd_fbnk_001a_6660" then
	
		if sRet == "ok" then
			Form.OpenFramePopup("mbonl87052", "", "")
		end if
		
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 0.5)
		
		Form.openPopupAnimation("pwdcheckpopup", Account0.caption&"☆"&"0", "", "2")
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	' 상단 INFO 클릭
	if sEventName == "INFO_CLICK" then
		Form.OpenPopup("mbonl89040_p1", "", "")
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "NewEngName" then
	
		if sRet == "ok" then
			f_Reset()
			DATAMANAGER.RequestTranData("obtsd_fbnk_005r")
		end if
		
	'계좌 비밀번호 입력 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tData
		tData = Split(sRet, "★")
		
		if UBOUND(tData) > 0 Then
			g_szPwd = tData[0]
			
			DATAMANAGER.RequestTranData("obtsd_fbnk_001a")
		end if
	
	end if

End Sub

'============================================================================
'				D A T A M A N A G E R	F U N C T I O N
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'외화 가상계좌 정보
	if szTranID == "obtsd_fbnk_005r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE",	0, "701")			'이체연계기관코드
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 				0, Account0.total)	'계좌번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ASNO", 				0, Account0.sequence)	'계좌일련번호

	'외화 가상계좌 등록
	elseif szTranID == "obtsd_fbnk_001a" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 		0, "1")				'처리구분코드
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE",	0, "701")			'이체연계기관코드
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 				0, Account0.total)	'계좌번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ASNO", 				0, Account0.sequence)	'계좌일련번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNT_PWD",			0, g_szPwd)			'계좌비밀번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CONT_CLS_CODE", 		0, "4")				'접촉구분코드
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CUST_ENG_NAME",		0, g_CUST_ENG_NAME)	'고객영문명
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'외화 가상계좌 정보
	if szTranID == "obtsd_fbnk_005r" then
		Dim REG_YN, CUST_ENG_NAME, BANK_NAME, OPNG_DATE, VRTL_ACNO
		REG_YN		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_YN", 			0)	' 등록여부
		CUST_ENG_NAME	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_ENG_NAME",	0)	' 고객영문명
		BANK_NAME	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BANK_NAME",		0)	' 은행명
		OPNG_DATE	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "OPNG_DATE",		0)	' 개설일자
		VRTL_ACNO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "VRTL_ACNO",		0)	' 가상계좌번호
		
		g_CUST_ENG_NAME = CUST_ENG_NAME
		
		if REG_YN == "Y" then
			btnNext.enable = false
			Table0.SetCellString(0, 1, "등록")
			Table0.SetCellFgColor(0, 1, "1")
		else
			btnNext.enable = true
			Table0.SetCellString(0, 1, "미등록")
			Table0.SetCellFgColor(0, 1, "110")
		end if

		if trim(CUST_ENG_NAME) == "" or trim(CUST_ENG_NAME) == null then
			Table0.SetCellString(1, 1, "등록하기 >")
		else
			Table0.SetCellString(1, 1, "변경하기 >")
		end if
		
		LblNm.caption = CUST_ENG_NAME
		
		Dim szEngOffice
		if Trim(BANK_NAME) <> "" then
			szEngOffice = "Corporate Banking Center"
		else
			szEngOffice = ""
		end if
		
		Table1.SetCellString(1, 1, BANK_NAME)		
		Table1.SetCellString(2, 1, szEngOffice)
		Table1.SetCellString(4, 1, VRTL_ACNO)
		Table1.SetCellString(6, 1, OPNG_DATE)
		
		'20240611 SWJ START
		if VRTL_ACNO <> "" then
			Image0.visible = True
		else
			Image0.visible = False
		end if
		'20240611 SWJ END
		
	'외화 가상계좌 등록
	elseif szTranID == "obtsd_fbnk_001a" then
		Form.ShowAlert("알림", "외화연계계좌 등록이 완료 되었습니다.")
		
		f_Reset()
		DATAMANAGER.RequestTranData("obtsd_fbnk_005r")
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID, szErrCode, szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)

	if Len(Trim(szSubErr)) > 0 then
		szSubErr = szErrMsg.."\n("..szSubErr..")"
	else
		szSubErr = szErrMsg
	end if
	
	if szTranID == "obtsd_fbnk_001a" then

		if szErrCode == "6660" then
			Form.MsgBox("안내", "외화금융상품거래약정 또는 해외주식거래신청 미등록계좌는 신청 후 처리가능합니다. 해당화면으로 이동하시겠습니까?", "obtsd_fbnk_001a_6660", 1)
			Exit Sub
		else
			f_Reset()
			DATAMANAGER.RequestTranData("obtsd_fbnk_005r")
		end if
	
	elseif szTranID == "obtsd_fbnk_005r" and szErrCode == "0417" then
		BtnNm.enable = false
		Table0.SetCellString(1, 1, "")
	end if
	
	Form.ShowAlert("알림", szSubErr)
End Sub

'============================================================================
'				C O N T R O L	 F U N C T I O N
'============================================================================
' 계좌번호
'============================================================================
Sub Account0_ChangeAccount()
	f_Reset()
	DATAMANAGER.RequestTranData("obtsd_fbnk_005r")	
End Sub

'============================================================================
' 고객영문명 버튼
'============================================================================
Sub BtnNm_OnClick()
	Form.SetSharedData("89040_ACNO", Account0.total)
	Form.SetSharedData("89040_ASNO", Account0.sequence)
	
	Form.OpenPopup("mbonl89040_p2", g_CUST_ENG_NAME, "")
End Sub

'============================================================================
' 신청 버튼
'============================================================================
Sub btnNext_OnClick()
	
	if f_AplyCheck() then
		DATAMANAGER.RequestTranData("obtsd_fbnk_001a")
	end if
	
End Sub

'============================================================================
'						사 용 자	 F U N C T I O N
'============================================================================
' 신청 전 체크 함수
'============================================================================
Function f_AplyCheck()
	Dim sReturn
	sReturn = true
	
	if trim(LblNm.caption) == "" then
		sReturn = false
		
		Form.MsgBox("알림", "영문명을 등록하십시오.", "", 6)

	elseif edtPwd.caption == "" or edtPwd.caption == null then
		sReturn = false
		edtPwd.caption = ""
		
		Form.SetTimerEvent2(1, 1, 0.5)
	end if
	
	return sReturn
End Function

'============================================================================
' 리셋 함수
'============================================================================
Sub f_Reset()
	BtnNm.enable		= true
	btnNext.enable	= true
	edtPwd.caption	= ""
	g_CUST_ENG_NAME	= ""
	LblNm.caption		= ""

	Table0.SetCellString(1, 1, "")
	Table0.SetCellString(0, 1, "미등록")
	Table0.SetCellFgColor(0, 1, "110")
	
	
	Table1.SetCellString(1, 1, "")		
	Table1.SetCellString(2, 1, "")
	Table1.SetCellString(4, 1, "")
	Table1.SetCellString(6, 1, "")
	
End Sub

'============================================================================
'20240611 SWJ START
Sub Image0_OnClick()
	sAcno       = Table1.GetCellString(4, 1)
		
	Form.setClipboardText(sAcno)  '클립보드에 복사
		
	if g_sOSType == "2" then
		Form.Toast(0, "클립보드에 복사되었어요.", 0.2)
	end if
End Sub
'20240611 SWJ END

