'============================================================================
' 화 면 명 : 대차중개약정 안내
'============================================================================


'============================================================================
Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")
	contMain.Image0.setMaintainingRatio("1")
	contMain.imgNotice.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()	
	szOSType = Form.GetSharedData("&OS_TYPE", false)	'iOS("2")Android("1")
	
	if szOSType == "1" then
		contMain.lblSubText1.changeTextAttr(57, 15, 4, -2, false)
		contMain.lblSubText2.changeTextAttr(14, 8, 4, -2, false)
		contMain.lblSubText2.changeTextAttr(38, 9, 4, -2, false)
	else
		contMain.lblSubText1.changeTextAttr(58, 16, 4, -2, false)
		contMain.lblSubText2.changeTextAttr(14, 8, 4, -2, false)
		contMain.lblSubText2.changeTextAttr(38, 9, 4, -2, false)
	end if
	
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.CloseForm()
End Sub

