	'20230719 htw end 내용 변경
End Sub


'============================================================================
Sub imgInfo0_OnClick()
	imgInfo0.openToolTip("종목별 합산되어 정산되므로, 최종 정산금액은 현재 조회되는 금액과 상이 할 수 있어요.",315,80,2)
End Sub

