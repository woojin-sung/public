'============================================================================
' 화 면 명 : 주식주문_정산금팝업
' 화면설명 : 주식주문 정상금팝업
' 작    성 : 2016.01.28 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_tData

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	'계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
	'szCLS(신용1대출2)|szLoanCd|신용합산|대출일|대출번호|전액상환방식|주문유형
	DATAMANAGER.ClearInputData(0, "obtrs_oder_212r")
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "ACNO"             	, 0, g_tData(0))	' 계좌번호
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "ASNO"             	, 0, g_tData(1))	' 계좌일련번호
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "IQRY_CLS_CODE"    	, 0, "1")		' 조회구분코드
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "FEE_MDIA_GRP_CODE"	, 0, "020")		' 수수료매체그룹코드
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "MKPL_CLS_CODE"    	, 0, g_tData(2))	' 매매시장구분코드
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "DEAL_CLS_CODE"    	, 0, g_tData(3))	' 매매구분코드
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "ODQT"             	, 0, g_tData(4))	' 주문수량
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "ODER_UNPR"   			, 0, g_tData(5))	' 주문단가
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "ISCD"             	, 0, g_tData(6))	' 종목코드
	DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "LOAN_DTL_TYPE_CODE"    , 0, g_tData(8))	' 대출상세유형코드
	
	'20180614 LES START - 전액상환방식 추가
	scrNo = Form.GetSharedData("&SCREEN_NO" , false )
	if scrNo = "12000" then
		DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "RDMP_COND_CLCD"        , 0, g_tData(12))		' 상환조건구분코드
	else
		DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "RDMP_COND_CLCD"        , 0, "1")
	end if
	'LES END
	
	if g_tData(9) = "0" then
		DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "IQRY_CLS_CODE"         , 0, "1")	' 조회구분코드
		DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "LOAN_DATE"           	, 0, g_tData(10))	' 대출일자
		DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "LOAN_SRNO"           	, 0, g_tData(11))	' 대출일련번호
	else 
		DATAMANAGER.SetDataValue(0,	"obtrs_oder_212r", "InBlock1", "IQRY_CLS_CODE"         , 0, "2")	' 조회구분코드
	end if
	
	DATAMANAGER.RequestTranData("obtrs_oder_212r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Label0.setNeighbolCtlPos("imgInfo","right",0,"")
	Dim tData
	Dim szData
	
	szData = Form.GetOpenLinkData()
	
	tData = Split(szData, "★")
	'계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
	'szCLS(신용1대출2)|szLoanCd|신용합산|대출일|대출번호|전액상환방식|주문유형
	if UBound(tData) > 0 then
		g_tData = tData	
		Table1.SetCellString(1, 1, g_tData(4))
		
		Dim szType
		szType = g_tData(13)
		
		Select Case szType
			Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
				Table1.SetCellString(0, 1, "-원")
				Table1.SetCellString(2, 1, "-원")
				Table1.SetCellString(3, 1, "-")
				Table2.SetCellString(0, 1, "-")
				Table2.SetCellString(1, 1, "-")
				Table2.SetCellString(2, 1, "-")
				Table2.SetCellString(3, 1, "-")
				Table2.SetCellString(4, 1, "-")
			Case else
				Table1.SetCellString(0, 1, FormatNumber(g_tData(5),0).."원")
				Table1.SetCellString(2, 1, FormatNumber(CInt(g_tData(4)) * CInt(g_tData(5)),0).."원")
				Table2.SetCellString(0, 1, CInt(g_tData(4)) * CInt(g_tData(5)))
				RequestData()
		End Select
	end if
End Sub

