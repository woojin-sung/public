'--===========================================================================
' 01. 화 면 명 : 지정심사신청
' 02. 화면설명 : 타자 투자경험 등록
' 03. 작    성 : 2022.04.15 KSJ
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nFirmFlag	'기관선택 플래그
Dim g_szAplyDate 	'신청일자
Dim g_szAplySrno	'신청일련번호

Dim g_nTrCount		'서비스 카운트
Dim g_szRgstFailText	'등록실패 Alert 문구
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_RgstDocu() : 타사 투자 경험 잔고증명서 제출 Open
'============================================================================
Function f_RgstDocu(nFirmFlag)
	If nFirmFlag > -1 Then
		Dim szFirmNm, szFirmCd, szIstuCd
		szFirmNm = Trim(Form.GetCtlProp("btnFirm"..nFirmFlag, "caption"))
		szFirmCd = Trim(tblFirm.GetCellString(nFirmFlag, 0))
		szIstuCd = Trim(tblFirm.GetCellString(nFirmFlag, 5))
		
		If szFirmNm <> "거래기관 선택" and szFirmCd <> "" and szIstuCd <> "" Then
			g_nFirmFlag = nFirmFlag
			Dim szImg
			szImg = Trim(tblFirm.GetCellString(g_nFirmFlag, 2))
			Form.OpenPopup("mbonl94002_p32", g_nFirmFlag & "★" & szFirmNm & "★" & szImg , "")
		Else
			Form.ShowAlert("알림", "거래기관을 선택해 주세요.")
			g_nFirmFlag = -1
		End If
	End If
End 	Function
'============================================================================
' f_DoubleChkData() : 등록하기 전 데이터 더블체크
'============================================================================
Function f_DoubleChkData()
	For i = 0 to 3
		Dim szText
		If i == 0 Then
			szText = lblRgstTitle0.caption
		Else
			szText = lblRgstTitle1.caption.." "..i.."번째"
		End If
		
		If Form.GetCtlProp("btnFirm"..i, "enable" ) == "1" Then
			If Form.GetCtlProp("chkFirm"..i, "checkstate" ) == "1" Then
				Dim szFirmCd, szIstuCd, szImg
				szFirmCd = Trim(tblFirm.GetCellString(i, 1))
				szIstuCd = Trim(tblFirm.GetCellString(i, 5))
				
				If szFirmCd == "" or szIstuCd == "" Then
					'데이터 초기화
					Form.SetCtlProp("chkFirm"..i, "checkstate", False)
					Form.SetCtlProp("btnFirm"..i, "caption", "거래기관 선택")
					tblFirm.SetCellString(i, 0, ""  )
					tblFirm.SetCellString(i, 1, "거래기관 선택" )
					tblFirm.SetCellString(i, 2, ""  )
					tblFirm.SetCellString(i, 3, "N" )
					tblFirm.SetCellString(i, 5, ""  )
					Form.ShowAlert("알림", szText.."거래기관을 다시 선택해주세요.")
					
					Return false
				End If
				
				szImg = Trim(tblFirm.GetCellString(i, 2))
				If szImg == null or szImg == "" Then
					'데이터 초기화
					Form.SetCtlProp("chkFirm"..i, "checkstate", False)
					tblFirm.SetCellString(i, 2, ""  )
					tblFirm.SetCellString(i, 3, "N" )
					Form.ShowAlert("알림", szText.."서류 등록을 다시 해주세요.")
					
					Return false
				End If
			Else
				'데이터 초기화
				Form.SetCtlProp("btnFirm"..i, "caption", "거래기관 선택")
				tblFirm.SetCellString(i, 0, ""  )
				tblFirm.SetCellString(i, 1, "거래기관 선택" )
				tblFirm.SetCellString(i, 2, ""  )
				tblFirm.SetCellString(i, 3, "N" )
				tblFirm.SetCellString(i, 5, ""  )
			End If
		End If
	Next
	
	Return true
End 	Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'전역변수 초기화--------------------------------
	g_nFirmFlag = -1	'선택기관 플래그
	g_szAplyDate = ""	'신청일자
	g_szAplyNum = ""	'신청일련번호
	
	g_nTrCount = 0		'서비스카운트
	g_szRgstFailText = ""	'등록실패 Alert 문구

	'OpenData SET ----------------------------------
	Dim szOpenData
	szOpenData = Trim(Form.GetOpenLinkData())
	If szOpenData <> null and szOpenData <> "" Then
		Dim tData
		tData = Split(szOpenData, "★")
		If Ubound(tData) > 0 Then
			If tData[0] <> NULL and tData[1] <> NULL Then
				g_szAplyDate = tData[0]			
				g_szAplySrno = tData[1]
				
				DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'전문투자자 서류등록내역
			End If
		End If
	End If	
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'거래기관석택팝업-----------------------------------
	if sKeyName == "close_mbonl94003_p4" then
		if sRet <> NULL and sRet <> "" then
			'데이터 초기화
			Form.SetCtlProp("chkFirm"..g_nFirmFlag, "checkstate", False)
			Form.SetCtlProp("btnFirm"..g_nFirmFlag, "caption", "거래기관 선택")
			tblFirm.SetCellString(g_nFirmFlag, 0, ""  )
			tblFirm.SetCellString(g_nFirmFlag, 1, "거래기관 선택"  )
			tblFirm.SetCellString(g_nFirmFlag, 2, ""  )
			tblFirm.SetCellString(g_nFirmFlag, 3, "N" )
			tblFirm.SetCellString(g_nFirmFlag, 5, ""  )
			
			Dim tCompany
			tCompany = Split(sRet, "★")
			if Ubound(tCompany) > 0 then			
				if tCompany[0] <> NULL and tCompany[1] <> NULL and tCompany[2] <> NULL then
					If g_nFirmFlag > 0 Then 
						Dim szFirmCd1, szFirmCd2, szFirmCd3
						szFirmCd1 = tblFirm.GetCellString(1, 0)
						szFirmCd2 = tblFirm.GetCellString(2, 0)
						szFirmCd3 = tblFirm.GetCellString(3, 0)
						Dim szIstuCd1, szIstuCd2, szIstuCd3
						szIstuCd1 = tblFirm.GetCellString(1, 5)
						szIstuCd2 = tblFirm.GetCellString(2, 5)
						szIstuCd3 = tblFirm.GetCellString(3, 5)
					
						If (tCompany[2] == szIstuCd1 and tCompany[0] == szFirmCd1) or (tCompany[2] == szIstuCd2 and tCompany[0] == szFirmCd2) 
							or (tCompany[2] == szIstuCd3 and tCompany[0] == szFirmCd3) Then
							Form.ShowAlert("알림", "이미 선택한 기관입니다.")
						Else
							tblFirm.SetCellString(g_nFirmFlag, 0, tCompany[0])
							tblFirm.SetCellString(g_nFirmFlag, 1, tCompany[1])
							tblFirm.SetCellString(g_nFirmFlag, 5, tCompany[2])
							Form.SetCtlProp("btnFirm"..g_nFirmFlag, "caption", tCompany[1])
						End If
					Else
						tblFirm.SetCellString(g_nFirmFlag, 0, tCompany[0])
						tblFirm.SetCellString(g_nFirmFlag, 1, tCompany[1])
						tblFirm.SetCellString(g_nFirmFlag, 5, tCompany[2])
						Form.SetCtlProp("btnFirm"..g_nFirmFlag, "caption", tCompany[1])
					End If
				end if
			end if
		end if
	
	' 타사 투자 경험 잔고증명서 제출 팝업 -----------------------------------
	elseif sKeyName == "close_mbonl94002_p32" then
		if sRet <> NULL and sRet <> "" then
			Form.SetCtlProp("chkFirm"..g_nFirmFlag, "checkstate", True)
			tblFirm.SetCellString(g_nFirmFlag, 2, sRet )	'등록이미지
			tblFirm.SetCellString(g_nFirmFlag, 3, "Y" )	'등록여부
		else
			Form.SetCtlProp("chkFirm"..g_nFirmFlag, "checkstate", False)
			tblFirm.SetCellString(g_nFirmFlag, 2, ""  )	'등록이미지
			tblFirm.SetCellString(g_nFirmFlag, 3, "N" )	'등록여부
		end if	
	end if		
	
End Sub

