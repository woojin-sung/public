'============================================================================
' imgQ1_OnClick() : 투자경험 등록 안내
'============================================================================
Sub imgQ1_OnClick()
	Form.MsgBox("안내", "거래기관 선택 후 서류를 등록해 주세요.\n\n".."거래 기관은 '최대 3개 기관'까지 등록\n가능합니다.", "", 6)
End Sub
'============================================================================
' btnBack_OnClick() : 돌아가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnNext_OnClick() : 투자경험 등록
'============================================================================
Sub btnNext_OnClick()
	'등록전 데이터 더블 체킹
	If f_DoubleChkData() == false Then
		Exit Sub
	End if

	'거래기관 선택하고 이미지 등록한 경우만 서비스 호출
	Dim szRgstYN
	g_nTrCount = 0
	For i = g_nTrCount to 3
		szRgstYN = Trim(tblFirm.GetCellString(i, 3))	'등록여부
		If szRgstYN == "Y" Then
			g_nTrCount = i
			DATAMANAGER.RequestTranData( "obcsb_acif_114c" )
			Form.Toast(0, "타사 투자경험 등록 중입니다.", false)
			Exit Sub
		End If
	Next
	
	If szRgstYN <> "Y" Then
		Form.ShowAlert("알림", "등록할 서류가 없습니다.")
	End If
End Sub
'****************************************************************************
'               		D A T A				M A N A G E R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCsno
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	
	'전문투자자 서류등록내역
	if szTranID == "obcsb_acif_115r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" 			, 0, szCsno 		) '고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_DATE"		, 0, g_szAplyDate	) '신청일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_SRNO" 		, 0, g_szAplySrno	) '신청일련번호
		
	'전문투자자 서류등록
	elseif szTranID == "obcsb_acif_114c" Then	
		Dim szCertCd, szFirmCd, szImg, szIstuCd
		szCertCd = Trim(tblFirm.GetCellString(g_nTrCount, 4))	'증명서종류코드
		szFirmCd = Trim(tblFirm.GetCellString(g_nTrCount, 0))	'타사기관코드
		szIstuCd = Trim(tblFirm.GetCellString(g_nTrCount, 5))	'기관구분코드
		szImg 	= tblFirm.GetCellString(g_nTrCount, 2)	'이미지데이터	
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" 			, 0, szCsno 		) '고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_DATE"		, 0, g_szAplyDate	) '신청일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_SRNO" 		, 0, g_szAplySrno	) '신청일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CERT_KIND_CODE" 	, 0, szCertCd 	) '(1년이상거래계좌등록: 18 / 투자경험잔고증명서: 16)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISTU_CLCD" 		, 0, szIstuCd 	) '기관구분코드(은행:B/ 증권:F/ 보험:I/ 기타:E)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OTCO_ISTU_CODE" 	, 0, szFirmCd 	) '타사기관코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ATCH_FILE_SIZE" 	, 0, LEN(szImg) 	) '첨부파일사이즈
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "UI_IMG_DATA" 		, 0, szImg		) '이미지데이터	
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	'전문투자자 서류등록내역
	if szTranID == "obcsb_acif_115r" Then	
		Dim szCnshIsncYN, szRmndCertIsncYN
		szCnshIsncYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CNSH_ISNC_YN", 0  ) 	'1년이상거래계좌 관련서류등록여부	
		szRmndCertIsncYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RMND_CERT_ISNC_YN", 0  )	'투자경럼 서류등록여부
	
		If szCnshIsncYN == "Y" Then
			Dim szFirmCd, szIstuCode, szIstuName
			szFirmCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTCO_ISTU_CODE", 0 )	'타사기관코드
			szFirmNm = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "ISTU_NAME", 0 )	'기관명
			szIstuCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "ISTU_CLCD", 0 )	'기관구분코드

			If szFirmCd <> "" and szFirmNm <> "" and szIstuCd <> "" Then
				Form.SetCtlProp("btnFirm0", "caption", szFirmNm)
				tblFirm.SetCellString(0, 0, szFirmCd )
				tblFirm.SetCellString(0, 1, szFirmNm )
				tblFirm.SetCellString(0, 5, szIstuCd)
				Form.SetCtlProp("chkFirm0", "checkstate", True)
				Form.SetCtlProp("btnFirm0", "enable", False)				
				Form.SetCtlProp("btnExpRgst0", "enable", False)
				imgSearch0.enable = False
			End If	
		End If
		
		If szRmndCertIsncYN == "Y" Then
			Dim nDataCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock3"))
			If nDataCnt > 0 Then
				If nDataCnt > 2 Then
					nDataCnt = 3
					btnNext.enable = False
				End if
				
				Dim szComCode, szIstuCode, szIstuName 
				For i = 1 to nDataCnt
					szFirmCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "OTCO_ISTU_CODE", i-1 )	'타사기관코드
					szFirmNm = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "ISTU_NAME", i-1 )	'기관명
					szIstuCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "ISTU_CLCD", i-1 )	'기관구분코드
					
					If szFirmCd <> "" and szFirmNm <> "" and szIstuCd <> "" Then
						Form.SetCtlProp("btnFirm"..i, "caption", szFirmNm)
						tblFirm.SetCellString(i, 0, szFirmCd )
						tblFirm.SetCellString(i, 1, szFirmNm)
						tblFirm.SetCellString(i, 5, szIstuCd)						
						Form.SetCtlProp("chkFirm"..i, "checkstate", True)					
						Form.SetCtlProp("btnFirm"..i, "enable", False)
						Form.SetCtlProp("btnExpRgst"..i, "enable", False)	
						'이미지 SetCtlProp enable적용 안됨
						if i == 1 then
							imgSearch1.enable = False
						elseif i == 2 then 
							imgSearch2.enable = False
						else
							imgSearch3.enable = False
						end if
					End If
				Next
			End If
		End If
		
	'전문투자자 서류등록
	elseif szTranID == "obcsb_acif_114c" then
		g_nTrCount = g_nTrCount + 1
		If g_nTrCount < 4 Then
			Dim szRgstYN
			szRgstYN = ""
			For i = g_nTrCount to 3
				szRgstYN = Trim(tblFirm.GetCellString(i, 3))	'등록여부
				If szRgstYN == "Y" Then
					g_nTrCount = i
					Exit For
				End If
			Next
			
			If szRgstYN == "Y" Then
				DATAMANAGER.RequestTranData( "obcsb_acif_114c" )
			Else
				If g_szRgstFailText <> "" Then
					DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'전문투자자 서류등록내역
					Form.ShowAlert("알림", g_szRgstFailText)
				Else
					Form.SendReturnToParent("close_mbonl94002_p31" , "")
					Form.CloseForm()
				End If
			End If
		Else
			If g_szRgstFailText <> "" Then
				DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'전문투자자 서류등록내역
				Form.ShowAlert("알림", g_szRgstFailText)
			Else
				Form.SendReturnToParent("close_mbonl94002_p31" , "")
				Form.CloseForm()
			End If
		End If
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 에러
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "obcsb_acif_114c" then
		Dim szSubMsg
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if szSubMsg <> null and szSubMsg <> "" then
			szErrMsg = szErrMsg & "(" & szSubMsg & ")"
		end if
	
		'에러메시지 생성
		If szErrMsg <> "" or szErrMsg <> null Then
			If g_nTrCount == 0 Then
				g_szRgstFailText = g_szRgstFailText & "-" & lblRgstTitle0.caption & "실패 " & "[" & szErrMsg & "]".."\n\n"
			Else
				g_szRgstFailText = g_szRgstFailText & "-" & g_nTrCount.."번 " & lblRgstTitle1.caption & "실패 " & "[" & szErrMsg & "]".."\n\n"
			End If
		End If		
		
		g_nTrCount = g_nTrCount + 1
		If g_nTrCount < 4 Then
			Dim szRgstYN
			szRgstYN = ""
			For i = g_nTrCount to 3
				szRgstYN = Trim(tblFirm.GetCellString(i, 3))	'등록여부
				If szRgstYN == "Y" Then
					g_nTrCount = i
					Exit For
				End If
			Next
			
			If szRgstYN == "Y" Then
				DATAMANAGER.RequestTranData( "obcsb_acif_114c" )
			Else
				If g_szRgstFailText <> "" Then
					DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'전문투자자 서류등록내역
					Form.ShowAlert("알림", g_szRgstFailText)
				Else
					Form.SendReturnToParent("close_mbonl94002_p31" , "")
					Form.CloseForm()
				End If
			End If
		Else
			If g_szRgstFailText <> "" Then
				DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'전문투자자 서류등록내역
				Form.ShowAlert("알림", g_szRgstFailText)
			Else
				Form.SendReturnToParent("close_mbonl94002_p31" , "")
				Form.CloseForm()
			End If
		End If
	End If
End Sub

