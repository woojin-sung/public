<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="44020" scrname="상장기업분석백과" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<WEBVIEW name="webView01" urlpath="about:blank" ly_vert="0,75,375,486,1" />
		<LINKFORM name="LinkForm0" linkfile="mhprc11000_s1" ly_vert="0,0,375,75,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3416" _ulen="3252" >
'============================================================================
' 01.화면명 	: 상장기업분석
' 02.화면설명	: 상장기업분석
' 03.작성		: 2016.01.07
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szItemCode 		'종목코드
dim g_szMarket		'시장구분
dim g_szIndexName 	'업종명


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'webDraw
'============================================================================
Function webDraw()
	dim szURL
	
	szURL = "http://comp.fnguide.com/svo/mobilecompany.asp?cid=10&colortype=w&gicode=" & g_szItemCode 
	
	webView01.viewtype = 0
	webView01.urlpath = szURL
End Function 


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetSearchType ("29:1:5:6:3:15")		'20220922 SWJ START : 최근조회 탭 추가
	
	g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	
	if g_szItemCode == "" then
		g_szItemCode = "008560"			'초기종목: 메리츠종금증권
	end if
	
	Form.SetItemCode(g_szItemCode)

End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if	sKey	=	"ITEMCODE"		then
		g_szItemCode	=	sValue
		g_szMarket		=	Form.GetItemCodeInfo(sValue,	"market")

		Form.triggerEvent("LinkForm0", "ITEMCODE", g_szItemCode)
		Form.triggerEvent("LinkForm0", "DEL_LEFTRIGHT", g_szItemCode)
		call webDraw()
	end if
End Sub

'============================================================================
'20220922 SWJ START : 상단 바 종목명 클릭 시 종목선택 팝업 추가
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "29:1:5:6:3:15", "")
	end if
End Sub
'============================================================================
' Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub
	</SCRIPT_INFO>
</ROOT>