'============================================================================
'20220510 LES START : 마스터파일에 있는 종목인지 체크
'============================================================================
Function Transform_Exid(szExid)

	if szExid = "HKS" then
		Transform_Exid = "HK"
		exit Function
	elseif szExid = "SHS" then
		Transform_Exid = "SH"
		exit Function
	elseif szExid = "SZS" then
		Transform_Exid = "SZ"
		exit Function
	elseif szExid = "NYS" then
		Transform_Exid = "NY"
		exit Function
	elseif szExid = "AMX" then
		Transform_Exid = "AX"
		exit Function
	elseif szExid = "NAS" then
		Transform_Exid = "OQ"
		exit Function
	elseif szExid = "TSE" then
		Transform_Exid = "JP"
		exit Function
	else
		Transform_Exid = szExid
	end if

End Function

'============================================================================
'20220510 LES START : 마스터파일에 있는 종목인지 체크
'============================================================================
Function CheckMasterFile(szCode)
	'Form.ShowAlert("szCode", szCode)
	arrCode = Split(szCode,"@")
	'Form.ShowAlert("arrCode0", arrCode(0))
	'Form.ShowAlert("arrCode1", arrCode(1))
	szTransExidCode = Transform_Exid(arrCode(0))
	
	szTransItemCode = szTransExidCode .. "@" .. arrCode(1)
	'Form.ShowAlert("szTransItemCode", szTransItemCode)

	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	'Form.ShowAlert("szCheckData", szCheckData)
	
	if szCheckData = "" or szCheckData = null then
		CheckMasterFile = false
		Exit Function
	end if
	
	CheckMasterFile = true
	
End Function
