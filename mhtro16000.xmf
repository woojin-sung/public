'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
	'20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

'============================================================================
Sub Image0_OnClick()
	Form.OpenPopup( "mhtro16000_p0" , ItemCode0.code & "^" , "" )
	Image0.visible = false

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	If sKeyName == "HOGA_SETUP" Then			' 폼탭 초기화
		If FormTab0.currenttab == "0" or  FormTab0.currenttab ==  0 Then
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "HOGA_SETUP", "" )
		End If
		
	Elseif sKeyName = "FORMTAB_INIT" Then		' 폼탭 초기화
		FormTab0.SetDefaultHeader()
		
		szOsType 	= Form.GetSharedData("&OS_TYPE", False)
		if szOsType = "2" then
			Change_Tab()
		end if
		
	Elseif sKeyName = "FORMTAB_SET" Then			' 폼탭 셋팅
		'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
		szOsType 	= Form.GetSharedData("&OS_TYPE", False)
		if szOsType = "2" then
			szAppVer 	= Form.GetSharedData("&APP_VERSION", False)
			arrAppVer	= split(szAppVer, ".")
			
			if #arrAppVer > 2 then
				nAppVer = Cint(arrAppVer(0)) * 1000 + Cint(arrAppVer(1)) * 100 + Cint(arrAppVer(2))
				
				if nAppVer < 2546 then
					Form.ShowAlert("안내", "업데이트 후 이용이 가능해요.\n앱스토어에서 업데이트를 진행해주세요.")
				else
					g_szTabChange = "1"
					FormTab0.showconfig("탭표시 순서 변경")
				end if
			else
				Form.ShowAlert("안내", "업데이트 후 이용이 가능해요.\n앱스토어에서 업데이트를 진행해주세요.")
			end if
		else
			g_szTabChange = "1"
			FormTab0.showconfig("탭표시 순서 변경")
		end if
		'20240613_01 HWG END
		
	Elseif sKeyName == "ITEMINFO_POP_CLOSE" then
		Image0.visible = true
		if sRet == "btnReport" then
			sOsType = Form.GetSharedData("&OS_TYPE", false ) '1.안드로이드 / 2.IOS
			if sOsType = "2" then
				FormTab0.currenttabpageid = g_ItemInfoPage
				Form.triggerEvent("FormTab0." .. g_ItemInfoPage, "RequestData", ItemCode0.code)
			else
				FormTab0.currenttabpageid = g_ItemInfoPage
			end if
		end if
	'20211222 HSZ START : 해외CFD 종목검색 화면 리턴
	elseif sKeyName == "MBTRE10000_ITEMCODE" then
		'20220510 LES START
		
		arrLinkCode = Split(sRet,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 조회가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		Form.setOverStockItemCode(sRet)
'		ItemCode0.code = sRet
		ItemCode0_OnEditComplete(sRet)
	END IF
	'20211222 HSZ END
End Sub
'20211222 HSZ START : 해외CFD
