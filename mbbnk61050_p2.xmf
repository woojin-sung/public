'----------------------------------------------------------------------------
' 01. 화 면 명 : 당사대체출금
' 02. 화면설명 : 당사대체출금_대체예정내역확인
' 03. 작    성 : 16.03.09
' 04. 수    정 : 2021.11.03 : 김수진 : v001 : 동일인 계좌간 대체출금시 전자서명, 보안매체 생략, 간편이체한도 미적용
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
	
Dim g_szAccountNumber	'출금계좌
Dim g_szAccountSerialNumber'	출금일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szWithAll	'출금액
Dim g_szBeforeNoMoney	'전일수표
Dim g_szTodayNoMoney	'당일수표
Dim g_szTodayMoney	'현금출금
Dim g_szMy	'내통장
Dim g_szYou	'상대
Dim g_szSendBeforeAccount	'입금계좌번호가공전
Dim g_szSendAccountName	'입금계좌명
Dim g_szAccountName	'출금계좌명
Dim g_szSendAccount
Dim g_szSendAccoutnSerialNumber
Dim g_szCertUserType
Dim g_sSpinCertYn
Dim g_sBioCertYn
Dim g_sBioTrMsg
Dim g_sMdiaSkipYn
'20190905 LES START 공인인증 최대오류횟수 변경
Dim DEF_CERT_PSWD_LIMIT_CNT
DEF_CERT_PSWD_LIMIT_CNT = 5
'20190905 LES END

Dim g_szSapeYN 	'v001 입금계좌 동일인 여부

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obrtd_drng_004a" then	'이체등록
	
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "RCPY_DATE" , 0 , Form.GetSharedData("&BIZ_DT", false ))	'영업일
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "SMCD", 0 , "003020")	'적요코드
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "TRMD_CLS_CODE", 0 , "17")	'거래매체구분코드
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "TACT_CLS_CODE" , 0 , "01")	'이체구분코드
		
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "TACT_ACNO", 0 , g_szSendAccount)	'출금계좌번호(8)
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "TACT_ASNO", 0 , g_szSendAccoutnSerialNumber)	'출금계좌일련번호(2)
		
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)	'계좌비밀번호
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "AMDR", 0 , g_szWithAll)		'출금액
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "PRDY_CHECK_AMT", 0 , g_szBeforeNoMoney)	'전일수표금액
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "TDAY_CHECK_AMT" , 0 , g_szTodayNoMoney)	'당일수표금액
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "CASH_DRNG_AMT", 0 , g_szTodayMoney)	'현금출금금액
		
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "RSEV_YN" , 0 , "N")	'예약여부
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_004a", "InBlock1", "TR_EXPL", 0 , g_szMy)	'거래설명
		DATAMANAGER.SetDataValue(0, "obrtd_drng_004a", "InBlock1", "CNFT_TR_EXPL" , 0 , g_szYou)	'상대거래설명
		DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "BNKB_GRP_NO" , 0, g_szCertUserType & g_sMdiaSkipYn )
		
		DATAMANAGER.RequestTranData("obrtd_drng_004a")
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	'v001 sta : 동일인 여부에 따른 분기처리 : 동일인일경우 전자서명, 보안매체 생략 후 출금처리
	If g_szSapeYN == "Y" Then
		btnOK.enable = false
		TR_Inquiry("obrtd_drng_004a")
	Else	
	'v001 fin
		if g_szCertUserType == "1" then
			if g_sSpinCertYn == "Y" OR g_sBioCertYn == "Y" then
				btnOK.enable = false
				TR_Inquiry("obrtd_drng_004a")
			else
				Form.MsgBox( "알림", "간편인증 비밀번호를 입력해주세요.", "", 6 )
				Exit Sub
			end if
		elseif g_szCertUserType == "3" OR g_szCertUserType == "4" then
			if g_sBioCertYn == "Y" then
				btnOK.enable = false
				TR_Inquiry("obrtd_drng_004a")
			else			
				sBIO_TR_CODE = "1"                                       '바이오거래유형코드 0: 인증 1: 서명 
				sATHN_USAG_CLS_CODE = "0"								' 서명데이터 생성여부
		
			     sTRAN_CNTT = g_sBioTrMsg
	    
			     if g_szCertUserType == "4" then
				     sData = "BCHAIN_trType★"& sBIO_TR_CODE  &"★"&  sTRAN_CNTT &"★"& sATHN_USAG_CLS_CODE 
			     else
				     sData = "BIO_trType★"& sBIO_TR_CODE  &"★"&  sTRAN_CNTT &"★"& sATHN_USAG_CLS_CODE 
			     end if
			     
				'Form.OpenPopup("mhetc90060_px", sData, "")
				Form.OpenFramePopup("mhetc90060_p5" , sData , "")
				
			end if
		else
			if Edit0.caption == null or Edit0.caption == "" then
				Form.MsgBox("알림", "공인인증서 비밀번호를 입력하세요", "", 6)
			else
				Dim sDN
				sDN = Form.GetSharedData("&USER_CERT_DN" , false)
			
				Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
			end if
		end if
	End If
End Sub

'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	if sType == "RetIsCertPasswordValid" then
		if sParam1 == "Success" then
		    '공인인증서 비번초기화
	         Edit0.caption = "" 
		
			btnOK.enable = false
			Request_obcpp_logn_015a("Y")
			
			'==============================================================================================
			'20191004 LES START 공인인증 최대오류횟수 변경
			'==============================================================================================
			'OCSP검증 서비스만 타도 오류횟수가 초기화됨. 
			'인증서비번이 5회초과된 경우 OCSP검증 서비스 자체를 못타게 앞단에서 막음.
			
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
				
			if sCertErrCnt + 1  >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "공인인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				Edit0.visible = False
				Exit Sub
			end if
			'==============================================================================================
			'20191004 LES END
			'==============================================================================================
			
			TR_Inquiry("obrtd_drng_004a")
	   elseif sParam1 == "Failed" then '  비밀번호 오류
	     
		Request_obcpp_logn_015a("N")
		Edit0.caption = ""
	   elseif sParam1 == "Error" then ' 인증서 업승ㅁ
		   Form.ShowAlert("알림", "공인인증서 없습니다.\n\n다시 확인하시기 바랍니다.")
	   end if		
	end if
End Sub

Sub Request_obcpp_logn_015a(szSucs_YN)
	szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "USER_ID" , 0 , szUserId ) '사용자ID
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 		'성공여부	
	DATAMANAGER.RequestTranData("obcpp_logn_015a")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'출금계좌, 출금일련번호, 계좌비밀번호, 출금액, 전일수표, 당일수표, 현금출금, 
	'거래설명(내통장), 상대거래설명(상대통장), 입금계좌번호, 입금계좌명, 출금계좌명
	Form.SetScreenName("대체예정내역 확인")
	
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	g_sSpinCertYn = "N"
	g_sBioCertYn = "N"
	
	g_sMdiaSkipYn = ""
	g_sMdiaSkipYn = Form.GetSharedData("61050_SMDIA_SKIP" , TRUE)
	
	'v001 sta : 동일인 여부에 따른 분기처리 : 동일인일경우 전자서명, 보안매체 생략 후 출금처리
	g_szSapeYN = ""
	g_szSapeYN = Form.GetSharedData("61050_SAPE_YN" , TRUE)

	If g_szSapeYN == "Y" Then
		lblSapeY1.visible = True
		lblSapeY2.visible = True
		Label0.visible = False
		Edit0.visible = False
		Label3.visible = False
		Label5.visible = False
		BtnSpinPwd.visible = False
	Else
		lblSapeY1.visible = False
		lblSapeY2.visible = False
	'v001 fin
	
		if g_szCertUserType == "1" then
			Label0.visible = False
			Edit0.visible = False
			Label3.visible = false
			Label5.visible = True
			BtnSpinPwd.visible = True
			
		elseif g_szCertUserType == "3" OR g_szCertUserType == "4" then	'바이오인증
			Label0.visible = False
			Edit0.visible = False		
			Label5.visible = FALSE
			BtnSpinPwd.visible = FALSE
			Label3.visible = true
			
			if g_szCertUserType = "4" then
				Label3.caption = "공동인증을 수행합니다."
			elseif g_szCertUserType = "3" then
				Label3.caption = "바이오인증을 수행합니다."
			end if 
		else
			Label0.visible = True
			Edit0.visible = True
			Edit0.certname = "공인인증서 비밀번호 입력"
			
			Label5.visible = False
			BtnSpinPwd.visible = False
			Label3.visible = false
		end if
	End If
	
	Dim szData
	szData = Form.GetOpenLinkData()

	Dim szList
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	g_szAccountNumber = szList(0)
	g_szAccountSerialNumber = szList(1)
	g_szAccountPassword = szList(2)
	g_szWithAll = szList(3)
	g_szBeforeNoMoney = szList(4)
	g_szTodayNoMoney = szList(5)
	g_szTodayMoney = szList(6)
	g_szMy = szList(7)
	g_szYou = szList(8)
	g_szSendBeforeAccount = szList(9)
	
	if Len(Trim(g_szSendBeforeAccount)) > 10 then	'3007-3881-02 이런식으로 들어올때
		Dim szTemp
		szTemp = Split(g_szSendBeforeAccount, "-")
		g_szSendAccount = szTemp(0) & szTemp(1)
		g_szSendAccoutnSerialNumber = szTemp(2)
	
	elseif Len(Trim(g_szSendBeforeAccount)) == 10 then	'3007388102 이런식으로 들어올때
		g_szSendAccount = Mid(g_szSendBeforeAccount, 1, 8)
		g_szSendAccoutnSerialNumber = Mid(g_szSendBeforeAccount, 9, 2)
		
	end if
	
	g_szSendAccountName = szList(10)
	g_szAccountName = szList(11)
	
	Table0.SetCellString( 0, 1,   g_szAccountNumber ..g_szAccountSerialNumber  )
	Table0.SetCellString( 1, 1, g_szAccountName   )
	
	Table1.SetCellString( 1, 1, g_szSendAccount..g_szSendAccoutnSerialNumber )
	Table1.SetCellString( 2, 1, g_szSendAccountName )
	
	Table1.SetCellString( 3, 1, g_szWithAll )
	
	g_sBioTrMsg = ""
	g_sBioTrMsg = "이체예정내역\n" & "입금기관 : " & "메리츠증권" & "\n" & "입금계좌 : " & g_szSendAccount & g_szSendAccoutnSerialNumber & "\n" & "예금주명 : " & g_szSendAccountName & "\n" & "이체금액 : " & FormatNumber(CDbl(g_szWithAll), 0, 0, 0, -1) & "원\n" 
	
End Sub

'============================================================================
Sub BtnSpinPwd_OnClick()
	Form.OpenPopup("mhetc90060_px", "", "")
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_drng_004a" then	'이체출금등록되면 
		Dim szCode
		szCode = DATAMANAGER.GetDataValue(0, "obrtd_drng_004a", "OutBlock1", "DELY_TACT_YN" , 0)
'		if szCode == "Y" then
'			Form.MsgBox("알림", "지연이체 접수되었습니다.", "", 0 )
'		else 
'			Form.MsgBox("알림", "대체처리 되었습니다.", "", 0 )
'		end if
		
'		if DATAMANAGER.GetDataMsgCode( "obrtd_drng_004a" ) == "E311" then
'			Dim szText
'			szText = DATAMANAGER.GetDataMsgText("obrtd_drng_004a")
'			Form.ShowAlert( "알림", szText)
'			Form.SendReturnToParent( "Clear" , sData)
'			Form.CloseForm()
'		end if
			
		Form.OpenPopup("mbbnk61050_p3" , szCode , "")
'		Form.SendReturnToParent( "Clear" , sData)
'		Form.CloseForm()
		
	elseif szTranID == "obcpp_logn_015a" then		
	
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)
		nCount = CInt(sMstk)
		if nCount >  0 then	
			'Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")	\
			'1. 공인인증 5회이상 초과
			if CInt(sMstk) >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "공인인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.", "", 0)
				Edit0.visible = False
				Exit Sub
			
			'2. 공인인증 오류횟수 5회 미만
			else
				Form.MsgBox( "알림",  "공인인증 비밀번호 " + CInt(sMstk) + "회 오류입니다. 5회 오류 초과시 업무진행이 불가능 합니다.", "", 0)				
			end if
			
   			'3. 오류횟수 공유변수 저장 (공인인증 오류횟수는 공유변수로 앱 종료전까지 모든화면이 공유)
			Form.SetSharedData("CERT_PWD_ERR_CNT" , sMstk)			
			
		'-----------------------------------------------------
		' 인증서 비밀번호 일치시
		'-----------------------------------------------------	
		else
			
			' 기존) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 가능
			' 변경) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 불가
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
			'4. 공유 오류횟수 > 최대 오류횟수 : 업무진행 불가 메세지
			if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "공인인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				Edit0.visible = False
				Exit Sub
			
			'5. 공유 오류횟수 < 최대 오류횟수 : 공유 오류횟수 초기화
			else
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0)
			end if
		end if		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obrtd_drng_004a" then	
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox( "알림", szErrMsg.." ("..szSubErr..")" , "", 0 )
		Form.SendReturnToParent( "Clear" , sData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "Close" then
		if sRet == "61060" then
			Form.OpenScreen("61060", "")
		elseif sRet == "61010" then
			Form.OpenScreen("61010", "1")
		else
			Form.SendReturnToParent( "Clear" , sRet)
			Form.CloseForm()
		end if
	elseIf sKeyName == "mhetc90060_px" OR sKeyName == "mhetc90060_p5" Then
		If sRet == "ok" Then
			if g_szCertUserType == "1" then
				g_sSpinCertYn = "Y"
				BtnSpinPwd.caption = "＊＊＊＊"
			elseif g_szCertUserType == "3" OR g_szCertUserType == "4"  then
				g_sBioCertYn = "Y"
			end if 
			btnOK_OnClick()
			'TR_Inquiry("obrtd_drng_004a")
		ElseIf sRet == "cancel" Then
			g_sSpinCertYn = "N"
			BtnSpinPwd.caption = ""
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If		
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnRequestTranTimeout(szTranID) : TR TimeOut 발생시 함수
'============================================================================
Sub DATAMANAGER_OnRequestTranTimeout(szTranID)
	
	if szTranID == "obrtd_drng_004a" then
		Form.ShowAlert( "알림", "이체결과를 확인하시기 바랍니다.")
		Form.SendReturnToParent( "Clear" , sRet)
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
		'20190905 LES START 공인인증 최대오류횟수 변경
	if sKeyName == "CERT_PSWD_FAIL_APP_TERMINATE" then
		sDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
		
		if sDeviceOS = "2" then
			Form.restartApp()
		else	
			Form.TerminateApp()
		end if	
	end if
End Sub

