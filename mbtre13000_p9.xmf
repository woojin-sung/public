'============================================================================
' 화 면 명 : 해외주식주문_정산금팝업
' 화면설명 : 해외주식주문 정산금팝업
' 작    성 : 2017.12
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szGbn
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szLinkData = Form.GetOpenLinkData()
	
	szData = Split(szLinkData, "@")
	
	if UBOUND(szData) > 0 then
		g_szGbn = szData(0)
		if szData(0) == "1" then
			Table0.visible = true
			Table1.visible = false
			
			Label0.caption = szData(1)
			Label0.left = 8
			Label0.top = 73
			
		elseif szData(0) == "2" then
			Table0.visible = false
			Table1.visible = true
			
			Label0.caption = szData(1)
			Label0.left = 44
			Label0.top = 112		'20220627 SWJ START : 문구 변경으로 인한 위치 변경
			
			btnClose2.visible = false
			btnReceive.left = 0
			btnReceive.width = 309
		end if
	end if
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("SISECHECK2" , "N")
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.SendReturnToParent("SISECHECK2" , "N")
	Form.CloseForm()
End Sub

'============================================================================
' btnClose2_OnClick : 닫기
'============================================================================
Sub btnClose2_OnClick()
	Form.SendReturnToParent("SISECHECK2" , "N")
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnReceive_OnClick()
	if g_szGbn == "1" then
		Form.SendReturnToParent("SISECHECK2" , "Y-1")
	elseif g_szGbn == "2" then
		Form.SendReturnToParent("SISECHECK2" , "Y-2")
	else
		Form.SendReturnToParent("SISECHECK2" , "Y")
	end if
	
	Form.CloseForm()
End Sub

