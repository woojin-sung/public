'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = trim(Form.GetOpenLinkData())
	if szOpenData ~= "" then
		Form.triggerEvent("lnkMain", "InitData", szOpenData)
	else
		Form.CloseForm()
	end if 	
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
End Sub

