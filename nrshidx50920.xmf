'***************************************************
'               전역 변수
'***************************************************
Dim g_szData

DIM g_szCalYYYY
DIM g_szCalMM

DIM g_szNimgname
DIM g_szOimgname

DIM gOsType

DIM g_realrowcount

DIM g_001r_titlearr(200)
DIM g_001r_subtitlearr(200)

'***************************************************
'               공용 함수
'***************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	'이미지 모두 비율 설정
	 contMain.imgCalArrow.setMaintainingRatio("1")
	 contMain.imgMonth1.setMaintainingRatio("1")
	 contMain.imgMonth2.setMaintainingRatio("1")
	 contMain.imgMonth3.setMaintainingRatio("1")
	 contMain.imgMonth4.setMaintainingRatio("1")
	 contMain.imgMonth5.setMaintainingRatio("1")
	 contMain.imgMonth6.setMaintainingRatio("1")
	 contMain.imgMonth7.setMaintainingRatio("1")
	 contMain.imgMonth8.setMaintainingRatio("1")
	 contMain.imgMonth9.setMaintainingRatio("1")
	 contMain.imgMonth10.setMaintainingRatio("1")
	 contMain.imgMonth11.setMaintainingRatio("1")
	 contMain.imgMonth12.setMaintainingRatio("1")
	 contMain.imgNotice.setMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub
'============================================================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	'글로벌 변수 세팅
	g_realrowcount = 0 '필터링 후 행 수

	'글로벌 이미지 세팅
	g_szNimgname = "tax365_cal_n" 'iOS
	g_szOimgname = "tax365_cal_o" 'iOS
	if Form.GetSharedData("&OS_TYPE", false ) == "1" then 'Android
		g_szNimgname = "btn_cal_n.9.png"
		g_szOimgname = "btn_cal_o.9.png"
	end if
	
'	금일 날짜 구하기
	szToday = Form.GetSharedData("&HOST_DATE", false) 'YYYYMMDD
	
'	미리미리~ 글자색 회색으로 변경
	contMain.lblDesc.fgcolor = "333"

'	전역 변수를 금일로 설정
	g_szCalYYYY = CInt(LEFT(szToday, 4))
	g_szCalMM = CInt(MID(szToday, 5, 2))
	
'	연도 범위 가져오기
'	DATAMANAGER.RequestTranData("obcpp_mtss_004r")
	
	'topbar #F6F7F8 (RGB 246,247,248)로 색칠하기
	contMain.lblTopDivider.bgcolor = 320
	
	'여백 삭제
	contMain.lblYYYYMM.paddinginfo = "0,0,0,0"
	
	'lblTItle 하이라이트 벌겋게 칠하기
	contMain.lblTItle.setHighlight(411)
	
	'달력 옆 화살표 그리기
	contMain.imgCalArrow.singleimage = "icon_arrow_down2.png"
	contMain.imgCalArrow.maintainratio = "1"
	contMain.lblCalUnderline.bgcolor = 144
	
	contMain.setScrollBarVisible("2") '스크롤시만 스크롤바 보이기

'	안드로이드는 달력 이미지 갱신 및 TR 001r 요청 (iOS는 cmbyear onEditComplete가 작동)
	If gOsType == "1" Then	
		updateCalDate()
'	iOS 는 cmbYear 글자가 좀 왼쪽에 튀어나오니 좌표 약간 옮기기
	ElseIf gOsType == "2" Then
		contMain.cmbYear.left = contMain.cmbYear.left + 2
		contMain.cmbYear.top = contMain.cmbYear.top + 2
	End If
	
	'20240521_01 HWG START : TAX365화면 웹연동 오류 수정
	Form.SetTimerEvent2(1, 1, 0.5)	
	'20240521_01 HWG END
End Function

'***************************************************
'               개별 함수
'***************************************************
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcpp_mtss_001r" Then
		DATAMANAGER.SetDataValue(0, "obcpp_mtss_001r", "InBlock1", "STND_YYMM", 0, g_szCalYYYY..Right("0" & g_szCalMM, 2))
	ElseIf szTranID == "obcpp_mtss_004r" Then
		DATAMANAGER.SetDataValue(0, "obcpp_mtss_004r", "InBlock1", "STND_YEAR", 0, g_szCalYYYY - 3)
	End If
End Sub

'============================================================================
Function Max(x, y)
	If x > y Then
		return x
	Else
		return y
	End If
End Function

Function Min(x, y)
	If x < y Then
		return x
	Else
		return y
	End If
End Function

'============================================================================
Sub drawCal()
'	패널 행 수 설정
	contMain.pnl0.rowcount = g_realrowcount

	totalpnlheight = 0 '요소들의 총 높이 구해서 패널 높이 세팅
	For rowindex = 0 to g_realrowcount - 1
		'표시할 subtitle 조작을 위해 임시 변수로 얕은 복사
		tempsubtitle = g_001r_subtitlearr(rowindex)
		If gOsType == "1" Then '안드인 경우 특수 문자를 개행 문자로 바꿔준다.
			tempsubtitle = Replace(g_001r_subtitlearr(rowindex), "§", "\n")
		Else 'iOS인 경우 특수 문자를 없앤다.
			tempsubtitle = Replace(g_001r_subtitlearr(rowindex), "§", "")
		End If
		
		contMain.pnl0.SetCellValue("lblTitle", rowindex, g_001r_titlearr(rowindex))
		contMain.pnl0.SetCellValue("lblSubtitle", rowindex, tempsubtitle)
		contMain.pnl0.setPropCardCell("paddinginfo", "lblTitle", rowindex, "0,0,0,0")
		contMain.pnl0.setPropCardCell("paddinginfo", "lblSubtitle", rowindex, "0,0,0,0")

'		sSubtitle 줄 개수 세고 높이 조정: 텍스트 tempsubtitle
		marginheight = 10	
		subtitlelinecnt = form.getTextLineCount(tempsubtitle, -2, false, 270)
		
'		만약 회색텍스트가 없으면 타이틀 세로중앙 정렬
		If subtitlelinecnt == 0 Then
			contMain.pnl0.setPropCardCell("top", "lblTitle", rowindex, "25")
		Else
			contMain.pnl0.setPropCardCell("top", "lblTitle", rowindex, "14")
		End If
		
'		카드 높이 설정
		
		If gOsType == "1" Then '안드인 경우 20으로 세팅(갤럭시 S6 기준)
			cardheight = 64 + 20*Max(Min(subtitlelinecnt, 10), 1)
		Else 'iOS인 경우 18로 세팅
			cardheight = 64 + 18*Max(Min(subtitlelinecnt, 10), 1)
		End If
		contMain.pnl0.SetCardWHAt(rowindex, cardheight + marginheight)
'		텍스트 최대 줄 수 설정
		contMain.pnl0.setPropCardCell("maxlinecnt", "lblTitle", rowindex, "1^-2")
		contMain.pnl0.setPropCardCell("maxlinecnt", "lblSubtitle", rowindex, "10^-2")
'		핑크 네모배경 높이 설정
		contMain.pnl0.setPropCardCell("height", "imgBg", rowindex, cardheight)
'		왼쪽 빨간 원
		contMain.pnl0.setPropCardCell("maintainratio", "imgCircle", rowindex, "1")
		contMain.pnl0.setPropCardCell("imgpath", "imgCircle", rowindex, "img_timeline_o.png")
		contMain.pnl0.setPropCardCell("top", "imgCircle", rowindex, cardheight/2 - 7)
'		왼쪽 줄 빨갛고 길게 설정
		contMain.pnl0.setPropCardCell("bgcolor", "lblVerticalInnerLine", rowindex, "417")
		contMain.pnl0.setPropCardCell("height", "lblVerticalInnerLine", rowindex, cardheight + marginheight)
		
'		패널 총 길이 합산 (10은 여백)
		totalpnlheight = totalpnlheight + cardheight + marginheight
		
'		테스트 영역
'		showalert "totalh, cardh, subtitlelinecnt", totalpnlheight..", "..cardheight..", "..subtitlelinecnt
	next
	
'	패널 길이 세팅
	contMain.pnl0.height = totalpnlheight
	
'	추가된 행이 0개면 없다고 표시, 있으면 거꾸로
	If g_realrowcount == 0 Then
		contMain.pnl0.visible = false
		contMain.lblGuideText.visible = true
		contMain.imgNotice.visible = true
		contMain.imgNoCalBg.visible = true
		
'		패널 밑에 링크폼 (개인세무신고안내) 붙이기
'		contMain.imgNoCalBg.top: 345, contMain.imgNoCalBg.height: 140, 여백 30
		contMain.linkfmS2.top = 345 + 140 + 30
		contMain.setScrollAutoSize()
		Exit Sub
	Else
		contMain.pnl0.visible = true
		contMain.lblGuideText.visible = false
		contMain.imgNotice.visible = false
		contMain.imgNoCalBg.visible = false
		
'		패널 밑에 링크폼 (개인세무신고안내) 붙이기: 여백 30이나 패널에서 10 남음
		contMain.linkfmS2.top = contMain.pnl0.top + contMain.pnl0.height + 20
		contMain.setScrollAutoSize()
	End If
	
'	줄 표시 설정
	If g_realrowcount > 1 Then
		tempheight = contMain.pnl0.GetCardWHAt(0)/2
		temptop = contMain.pnl0.getPropCardCell("top", "imgCircle", 0)
		
'		처음 항목은 왼쪽 빨간줄이 중간부터 나오게 설정
		contMain.pnl0.setPropCardCell("top", "lblVerticalInnerLine", 0, temptop)
		contMain.pnl0.setPropCardCell("height", "lblVerticalInnerLine", 0, tempheight+15)
		
'		마지막 항목은 왼쪽 빨간줄이 중간까지만 오게 설정
		tempheight = contMain.pnl0.GetCardWHAt(g_realrowcount-1)/2
		contMain.pnl0.setPropCardCell("height", "lblVerticalInnerLine", g_realrowcount-1, tempheight-5)
	Else '항목이 한 개면 처음/마지막 항목의 줄을 없애기
		contMain.pnl0.setPropCardCell("height", "lblVerticalInnerLine", 0, "0")
		contMain.pnl0.setPropCardCell("height", "lblVerticalInnerLine", g_realrowcount-1, "0")
	End If
	
'	컨테이너 스크롤 사이즈 재조정
	contMain.setScrollAutoSize()

'	글로벌 인덱스 값 초기화
	g_realrowcount = 0
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	===================항목리스트 조회===================
	If szTranID == "obcpp_mtss_001r" Then
		trtotalrow = DATAMANAGER.GetDataCount(0, "obcpp_mtss_001r", "OutBlock1")
		
'		제목, 부제 배열에 쌓기
		For tempidx = 0 to trtotalrow - 1
			sTitle_1 = DATAMANAGER.GetDataValue(0, "obcpp_mtss_001r", "OutBlock1", "TITL_CNTT", tempidx)
			sTitle_2 = DATAMANAGER.GetDataValue(0, "obcpp_mtss_001r", "OutBlock1", "PAYM_DDLN_DATE", tempidx)
			sTitle = sTitle_1 & " (" & sTitle_2 & ")"
			
			sSubtitle = DATAMANAGER.GetDataValue(0, "obcpp_mtss_001r", "OutBlock1", "TXAF_DTL_CNTT", tempidx)
			
			g_001r_titlearr(g_realrowcount + tempidx) = sTitle
			g_001r_subtitlearr(g_realrowcount + tempidx) = sSubtitle
		Next
		g_realrowcount = g_realrowcount + trtotalrow
		
'		다음조회
		If DATAMANAGER.IsMoreNextData("obcpp_mtss_001r") == true Then
			DATAMANAGER.RequestNextData("obcpp_mtss_001r")
		Else '다음조회 없으면
			drawCal()
		End If
'	========================이번연도 선택========================
	ElseIf szTranID == "obcpp_mtss_004r" Then
		trtotalrow = DATAMANAGER.GetDataCount(0, "obcpp_mtss_004r", "OutBlock1")
		For rowindex = 0 to trtotalrow - 1
			tempyearval = CInt(DATAMANAGER.GetDataValue(0, "obcpp_mtss_004r", "OutBlock1", "STND_YEAR", rowindex))

'			연도 콤보에 항목 추가
			contMain.cmbYear.cbadddatatext = rowindex & "`" & tempyearval

'			연도콤보컨트롤 금년도 선택
			If g_szCalYYYY == tempyearval Then
				contMain.cmbYear.currentindex = rowindex
			End If
		Next
	End If
End Sub

'============================================================================
'달력 YYYYMM 수정 후 달력 이미지 적용 후 TR 요청
Sub updateCalDate()
	contMain.lblYYYYMM.caption = g_szCalYYYY & "." & Right("0" & g_szCalMM, 2)

	Select Case g_szCalMM
		Case 1
			f_MonthBtnClickEvt(contMain.imgMonth1)
		Case 2
			f_MonthBtnClickEvt(contMain.imgMonth2)
		Case 3
			f_MonthBtnClickEvt(contMain.imgMonth3)
		Case 4
			f_MonthBtnClickEvt(contMain.imgMonth4)
		Case 5
			f_MonthBtnClickEvt(contMain.imgMonth5)
		Case 6
			f_MonthBtnClickEvt(contMain.imgMonth6)
		Case 7
			f_MonthBtnClickEvt(contMain.imgMonth7)
		Case 8
			f_MonthBtnClickEvt(contMain.imgMonth8)
		Case 9
			f_MonthBtnClickEvt(contMain.imgMonth9)
		Case 10
			f_MonthBtnClickEvt(contMain.imgMonth10)
		Case 11
			f_MonthBtnClickEvt(contMain.imgMonth11)
		Case 12
			f_MonthBtnClickEvt(contMain.imgMonth12)
	End Select
	
	'TR 데이터 요청
	DATAMANAGER.RequestTranData("obcpp_mtss_001r")
End Sub
'============================================================================
'달력 이미지 적용
Function f_MonthBtnClickEvt(paramImg)
	btnimgs = Array(contMain.imgMonth1, contMain.imgMonth2, contMain.imgMonth3, contMain.imgMonth4, contMain.imgMonth5, contMain.imgMonth6, contMain.imgMonth7, contMain.imgMonth8, contMain.imgMonth9, contMain.imgMonth10, contMain.imgMonth11, contMain.imgMonth12)

	'모든 버튼에 해제이미지 적용
	for i = 0 to Ubound(btnimgs)
		btnimgs[i].setMaintainingRatio("1") '비율조정
		btnimgs[i].imgpath = g_szNimgname '버튼 이미지
	next

	'파라미터만 press 효과 적용
	paramImg.imgpath = g_szOimgname
End Function
'============================================================================
'달력 YYYY 수정하면서 TR 요청
Sub contMain_cmbYear_OnEditComplete(iIndex)
	g_szCalYYYY = CInt(contMain.cmbYear.caption)
	updateCalDate()
End Sub
'============================================================================
'이미지나 텍스트 클릭하면 버튼 클릭한 것처럼 사용
Sub contMain_lblMonth1_OnClick()
	contMain.btnMonth1_OnClick()
End Sub
Sub contMain_lblMonth2_OnClick()
	contMain.btnMonth2_OnClick()
End Sub
Sub contMain_lblMonth3_OnClick()
	contMain.btnMonth3_OnClick()
End Sub
Sub contMain_lblMonth4_OnClick()
