	<SCRIPT_INFO _len="9107" _ulen="8005" >
dim g_szFlag

dim g_szGBCD			'개인/법인구분코드(1:개인,2:법인)
dim g_szACNO
dim g_szASNO

Dim g_nTryCnt					' 신용정보조회
Dim g_szSDRC_CLS_CODE
Dim g_szCRIN_IQRY_CLCD
Dim g_szSDRC_SRNO

'============================================================================
Sub Form_OnFormInit()
	Dim szData	
	szData = Form.GetOpenLinkData()
	
	g_szGBCD = getListItem(szData, 0)	
	g_szACNO = getListItem(szData, 1)		
	g_szASNO = getListItem(szData, 1)		

	if g_szGBCD == "2" then	'법인
		tblInfoH.SetCellString( 10, 2, "" )
	else	'개인
		tblInfoH.SetCellString( 10, 2, "신용정보 조회 후 신청 가능합니다." )
	end if
	
	' 신용정보조회 변수 초기화
	g_nTryCnt = 0
	g_szSDRC_CLS_CODE = "1"
	g_szCRIN_IQRY_CLCD =   "TR01"
	g_szSDRC_SRNO = ""
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szFlag = "cancel"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnNext_OnClick()
	if g_szGBCD == "2" then
		g_szFlag = "ok"
		Form.CloseForm()
	else
		'개인이면, 나이스 신용정보 조회
		DATAMANAGER.RequestTranData("obaci_acct_255a")
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl88026_p4", g_szFlag)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obaci_acct_255a" then			
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ASNO" , 0 , g_szASNO )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ISCD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "RMND_SRNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD" , 0 , "027") 'g_sKindCode
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "1" ) '요약1, 상세2, 둘다3
		
		'필수동의(공통)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "UI_COMN_AGRM_YN1" , 0 , "Y")'수집이용 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "UI_COMN_AGRM_YN2" , 0 , "Y")'수집이용 개인신용정보
		
		'필수동의(수집/이용 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "UI_COMN_AGRM_YN1" , 0 , "Y" )'수집이용_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "UI_COMN_AGRM_YN2" , 0 , "Y" )'수집이용_신용공여/미수/파생상품 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN1" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 고유식별번호
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN2" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 민감정보
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN3" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "UI_COMN_AGRM_YN1" , 0 , "0" )'수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "UI_COMN_AGRM_YN2" , 0 , "0" )'수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보

		'필수동의(제공 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "UI_COMN_AGRM_YN1" , 0 , "Y" )'제공_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "UI_COMN_AGRM_YN2" , 0 , "Y" )'제공_신용공여/미수/파생상품 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "UI_COMN_AGRM_YN1" , 0 , "0" )'제공_해외주식/해외파생/해외금융/EUREX 고유식별번호
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "UI_COMN_AGRM_YN2" , 0 , "0" )'제공_해외주식/해외파생/해외금융/EUREX 개인신용정보

		'필수동의(조회 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "PROS_CLS_CODE" , 0 ,"1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "UI_COMN_AGRM_YN1" , 0 , "Y" )'조회_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "UI_COMN_AGRM_YN2" , 0 , "Y" )'조회_신용공여/미수/파생상품 개인신용정보 
	
	elseif szTranID == "obcsb_nice_010r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE" , 0 , g_szSDRC_CLS_CODE ) '송신
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "BSWR_CLS_CODE", 0 , "1" ) '개설
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "CRIN_IQRY_CLCD", 0 , g_szCRIN_IQRY_CLCD ) '- >TR01 로 조회하고 정상이면 SA25로 조회함
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "ACNO", 0 , g_szACNO )		
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock2", "SDRC_SRNO", 0 , g_szSDRC_SRNO ) '-> 처음엔 “”  ->LabelSDRCSRNO.captio
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obaci_acct_255a" then
		tProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
		tProsSrno =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
		
		Form.SetSharedData("255a_PROS_DATE" , tProsDate)
		Form.SetSharedData("255a_PROS_SRNO" , tProsSrno)
		
		DATAMANAGER.RequestTranData("obcsb_nice_010r")
		
	elseif szTranID == "obcsb_nice_010r" then

		Dim sRSLT_CLS
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_nice_010r", "OutBlock1", "RSLT_CLS" , 0 )		
		
		' RSLT_CLS = '0' : 전문 전송하지 않아도 되는 정상적인 경우
		' RSLT_CLS = '1' : 전문 송신한 경우
		' RSLT_CLS = '2' : 전문 송신 후 응답 대기 중
		' RSLT_CLS = '3' : 전문 수신 결과 정상 응답			
		if sRSLT_CLS == "0" or sRSLT_CLS == "3" then '정상/전문수신결과정상응답			
			if g_szCRIN_IQRY_CLCD == "TR01" then '첫번째호출후재호출				
				g_szCRIN_IQRY_CLCD = "SA25"					
				g_szSDRC_CLS_CODE = "1"
				g_nTryCnt = 0
				
				DATAMANAGER.RequestTranData( "obcsb_nice_010r" ) '고객정보확인조회		
				
			elseif g_szCRIN_IQRY_CLCD == "SA25" then '두번째호출후 실질적인업무처리			
				g_szSDRC_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_nice_010r", "OutBlock2", "SDRC_SRNO" , 0 )		
						
				Form.MsgBox( "알림", "신용정보 조회가 완료되었습니다.", szTranID, 6 )	
				
			end if
			
		elseif sRSLT_CLS == "1" or sRSLT_CLS == "2" then			
			g_szSDRC_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_nice_010r", "OutBlock2", "SDRC_SRNO" , 0 )		
			
			g_nTryCnt = g_nTryCnt+1			
			
			if g_nTryCnt <= 7 then	
				g_nTryCnt = 0
				g_szSDRC_CLS_CODE = "2"
				
				DATAMANAGER.RequestTranData( "obcsb_nice_010r" ) '고객정보확인조회			
			else
				Form.MsgBox( "알림", "신용 정보 조회 실패입니다.\n다시 확인해주세요.", "", 6 )				
			end if 			
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "obcsb_nice_010r" then
		if sRet == "close" then
			g_szFlag = "success"
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			'21.07.28 JHY START : 예외처리 추가
			'v006
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return
				end if
				
			else
				return
			end if
			'21.07.28 JHY END
		else
			return
		end if 
	end if 
	
end function

