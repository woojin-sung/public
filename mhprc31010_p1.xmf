'============================================================================
Sub Form_OnFormInit()	
	DATAMANAGER.RequestTranData( "ohhts_3072_004r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "ohhts_3072_004r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FID_INPUT_COND_MRKT_DIV_CODE" , 	0 , "J" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FID_INPUT_COND_SCR_DIV_CODE" , 	0 , "3072" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	DATAMANAGER.CancelRealData( "ohhts_stck_incg" )	
		
	If szTranID = "ohhts_3072_004r" Then
		DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
	End If
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim szSendData
	
	szSendData1 = Grid0.GetCellData( "bd_cell0", lRow )
	szSendData2 = Grid0.GetCellData( "bd_cell3", lRow )
	
	'한글종목명★단축종목코드
	Form.SendReturnToParent( "mhprc31010" , szSendData1.."★"..szSendData2 )
	
	Form.CloseForm( )
End Sub

