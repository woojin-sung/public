<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="41000" scrname="시장종합_투자자별/프로그램" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,190,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" bgcolor="272:246246246" transmode="0" ly_vert="0,0,375,190,1" />
		<IMAGE name="Image0" autosize="1" imgpath="new_tab01_on" ly_vert="25,15,102,20,1" />
		<IMAGE name="Image1" autosize="1" imgpath="new_tab02_off" ly_vert="133,15,102,20,1" />
		<BUTTON name="Button0" visible="0" bgcolor="234:251251251" btnimage="btn_12.9" ly_vert="10,40,355,140,0" />
		<IMAGE name="Image3" imgpath="input_03_n.9" ly_vert="10,40,355,140,1" />
		<LINKFORM name="LinkForm0" ly_vert="20,47,335,126,1" />
		<LABEL name="Label1" fontsize="-4" valign="2" ly_vert="279,15,80,21,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1709" _ulen="1657" >
Dim g_SelectIdx
g_SelectIdx = 0

'============================================================================
'투지지별 버튼
'============================================================================
Sub Image0_OnClick()

	g_SelectIdx = 0
	ChangeSelectImage()
	
End Sub

'============================================================================
'프로그램 버튼
'============================================================================
Sub Image1_OnClick()

	g_SelectIdx = 1
	ChangeSelectImage()
	Label1.visible = false
	
End Sub



'============================================================================

Sub ChangeSelectImage()

	if g_SelectIdx = 0 then
		
		Image0.imgpath = "new_tab01_on"
		Image1.imgpath = "new_tab02_off"
		LinkForm0.linkfile = "mhidx41000_sg"
	
	elseif g_SelectIdx = 1 then
		
		Image0.imgpath = "new_tab01_off"
		Image1.imgpath = "new_tab02_on"
		LinkForm0.linkfile = "mhidx41000_s3"
	
	end if

End Sub


'============================================================================
Sub Form_OnFormInit()
	ChangeSelectImage()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "PageChange" then
	
		if sParam == "0" or sParam == 0 then
			Label1.visible = false
		
		elseif sParam == "1" or sParam == 1 then
			Label1.visible = true
			Label1.caption = "거래소(백만)"
			
		
		elseif sParam == "2" or sParam == 2 then
			Label1.visible = true
			Label1.caption = "코스닥(백만)"
			
		elseif sParam == "3" or sParam == 3 then
			Label1.visible = true
			Label1.caption = "선물(계약)"
		
		end if
	
	end if
	
End Sub


	</SCRIPT_INFO>
</ROOT>