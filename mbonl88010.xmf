'============================================================================
' 01. 화 면 명 : ELW거래신청
' 02. 화면설명 : ELW거래신청
' 03. 작    성 : 2016. 02. 15. 유창재
'			 : 2019.04.30 김유경 : 이수번호 확인 사이트 주소 변경 (화면 문구)
'			: 2020.09.16 : 권오상 : v002 : T2008250015 : 메모리평문 취약점 수정
' 2021.05.22 : 정민영 : v003 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
' 2022.04.11 : 김수진 : v004 : 계약서류 교부처리,obsap_acif_999a obcsb_dbif_322a IO 추가
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCustNum			'고객번호
Dim g_szPW				'비밀번호
Dim g_szApproveCode		'약정승인상태코드

Dim g_SUCS_YN				'처리결과
Dim g_INCL_Code			'KYC 투자성향등급코드
Dim g_PROD_Code			'KYC 상품등급코드
Dim g_DVPD_Code			'KYC 파생상품유의코드
Dim g_DRVT_YN				'KYC 파생 처리 여부
Dim g_STND_Date			'기준일자
Dim g_REG_Srno			'등록일련번호
Dim	g_PlainRm 'v002

'v004 STA
Dim g_szFnprJoinSrno		'금융상품일련번호
DIm g_szSvcSrno			'서비스 일련번호
'v004 FIN

Dim g_FinCustomer 		'금융소비자 팝업 진행상태
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTrans() : ELW 거래 신청
'============================================================================
Function SetTrans()
	
	if edt0.caption == "승인완료" then
'		g_szApproveCode = "U"
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "PROS_CLS_CODE" , 0 , "U")
		DATAMANAGER.RequestTranData( "obpds_srvc_244a" )
	else
'		g_szApproveCode = "I"
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "I")
		DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
	end if


End Function
'============================================================================
' f_InitData() : 초기화 v004
'============================================================================
Function f_InitData()
	g_szCustNum = ""
	edt0.caption = ""
	edt1.caption = ""
	
	chkProvision.checkstate = "0"
	g_szFnprJoinSrno = ""
	g_szSvcSrno = ""
End Function


'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002

'	g_szCustNum = Form.GetSharedData( "&CUST_NUM", false )
	edtPW.caption = ""
	
	g_SUCS_YN = Form.GetSharedData( "KYC_SUCS_YN" , false )
	g_STND_Date = Form.GetSharedData( "KYC_STND_DATE", false )
	g_REG_Srno = Form.GetSharedData( "KYC_REG_SRNO", false )
	' 현재는 703r TR에서 받아옴
	g_INCL_Code = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
	g_PROD_Code = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
	g_DVPD_Code = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
	g_DRVT_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
	
	btnOK.enable = false 
	f_InitData() 'v004
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' 
'============================================================================
Sub btn0_OnClick()
	Form.OpenFramePopup( "mbonl88010_p1" , sOpenData , sPosInfo)
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szText, szSubText		'ELW교육이수번호 수정 Text
	
	if szTranID == "obpds_srvc_069r" then
		if DATAMANAGER.GetDataCount( 0 , "obpds_srvc_069r", "OutBlock1") > 0 then
			if DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) == "03" then
				edt0.caption = "신청중"
				btnOK.enable = false
				btnProvision.enable = false	'v004
				btnModiTel.enable = false 'v004
				
				g_FinCustomer = "Y"
			elseif DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) == "01" then
				edt0.caption = "승인완료"
				btnOK.enable = false
'				btnOK.caption = "수정"
				btnProvision.enable = false	'v004
				btnModiTel.enable = false 'v004
				
				g_FinCustomer = "Y"
			else
				edt0.caption = "미신청"
				btnOK.enable = true
				btnProvision.enable = true	'v004
				btnModiTel.enable = true 'v004
				
	'			05.22 일련번호채결 과정 변경
'				g_FinCustomer = "N"				
			end if
		else
			edt0.caption = "미신청"
			btnOK.enable = true
			btnProvision.enable = true	'v004
			btnModiTel.enable = true 'v004
'			g_FinCustomer = "N"
			'DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v007 금융상품 일련번호 GET
		end if
		
		DATAMANAGER.RequestTranData( "obpds_srvc_243r" )		'ELW 교육이수번호
		
	elseif szTranID == "obpds_srvc_243r" then
		edt1.caption = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_243r", "OutBlock1", "EDCT_CMCO_NO" , 0)
'		if DATAMANAGER.GetDataValue( 0 , "obpds_srvc_243r", "OutBlock1", "ELW_EDCT_CMCO_YN" , 0) == "Y" then
'			edt1.caption = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_243r", "OutBlock1", "EDCT_CMCO_NO" , 0)
'		else
			if DATAMANAGER.GetDataValue( 0 , "obpds_srvc_243r", "OutBlock1", "NTFR_CLS_CODE" , 0) <> "1" or DATAMANAGER.GetDataValue( 0 , "obpds_srvc_243r", "OutBlock1", "CUST_DETL_CLS_CODE" , 0) <> "01" then
				edt1.caption = "면제"
				edt1.enable = false
				btnOK.enable = false
				btnProvision.enable = false	'v004
				btnModiTel.enable = false 'v004
			end if
'		end if
		
	elseif szTranID == "obcsb_acif_000r" then
		g_szCustNum = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_000r", "OutBlock1", "CSNO" , 0)
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
		
	elseif szTranID == "obpds_srvc_045a" then
		Form.ShowAlert( "알림", DATAMANAGER.GetDataMsgText(szTranID))
		
		'v004 STA
		g_szSvcSrno = tostring(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO" , 0))
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" ) '계약서류교부처리
		'v004 FIN
		
	elseif szTranID == "obpds_srvc_244a" then
		szText = DATAMANAGER.GetDataMsgText( "obpds_srvc_244a" )
		szSubText = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_244a")
		Form.ShowAlert( "알림", szText&"\n"&szSubText)
		
	'v004 STA
	elseif szTranID	= "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		Form.SetSharedData("SPCL_CNFR_ACNO", acnt0.caption )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가		
		
'		If g_szFnprJoinSrno <> "" Then
'			Form.OpenPopup("mbonl81010_p16" , acnt0.total & "★" & g_szFnprJoinSrno, "")
'		End If
		
	elseif szTranID	= "obcsb_dbif_322a" then
'		f_InitData() 
'		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	'v004 Fin 
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )	
	elseif szTranID == "obcsb_acif_199a" then 
		f_InitData()
		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )	
	end if
	
End Sub
'============================================================================
'
'============================================================================
Sub acnt0_ChangeAccount()
	
	edtPW.caption = ""
	g_szPW = ""
'	edt1.caption = ""	'16-03-25 임보라 대리님 요청 계좌변경시 교육이수번호도 Clear 처리 v004 
	f_InitData() 'v004
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_243r" then				'ELW교육이수 확인내역
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_243r", "InBlock1", "ACNO" , 0 , acnt0.caption)
	elseif szTranID == "obpds_srvc_244a" then			'ELW교육이수 확인여부처리
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "ACNO" , 0 , acnt0.caption)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "EDCT_CMCO_NO" , 0 , edtEduCheck.caption)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "ELW_EDCT_CMCO_YN" , 0 , edtEduCheck.caption)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "SVC_SRNO" , 0 , edtSerNum.caption)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "01")
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_244a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	elseif szTranID == "obpds_srvc_045a" then			'ELW약정
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ELW_EDCT_CMCO_YN" , 0 , edtEduCheck.caption)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "EDCT_CMCO_NO" , 0 , edt1.caption)
		
		if g_SUCS_YN == "Y" then
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "STND_DATE" , 0 , g_STND_Date)
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "REG_SRNO" , 0 , g_REG_Srno)
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_YN" , 0 , "Y")
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_INCL_Code )
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_PROD_Code)
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_DVPD_Code)
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_DRVT_YN)
		end if
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , acnt0.total)
	elseif szTranID == "obpds_srvc_069r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_069r", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_069r", "InBlock1", "ACNO" , 0 , acnt0.total)
	'v004 STA
	elseif szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , acnt0.total		) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_szFnprJoinSrno	) 	'금융상품일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "021"				)	'prcd:계좌개설 / svcd:서비스약정 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , g_szCustNum & "$" & "021" & "$" & g_szSvcSrno )	'고객번호$서비스코드$서비스일련번호 
	'v004 FIN
	elseif szTranID == "obcsb_acif_199a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 			, 0 , g_szFnprJoinSrno	) 	'금융상풍일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO" 	 	, 0 , "00001"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_LRDV_LEVL_CODE" 	, 0 , "01"			)'	"01"투자성
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_MDDV_LEVL_CODE" 	, 0 , "02"			)	'02 서비스약정
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_SMDV_LEVL_CODE"	, 0 , "02"& "021"		)	'&서비스약정코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_DTL_DIV_LEVL_CODE"	, 0 , "000" 			)	'CMA전환신청인경우 "009" 그외엔 "000"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_ISSU_DIV_LEVL_CODE", 0 , "000"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 	 					, 0 , "021"			)	'054 서비스약정 코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KOR_ISNM" 					, 0 , ""				)	
