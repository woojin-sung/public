'============================================================================
' 화 면 명 : 관심종목_스타일2(선물옵션)
' 화면설명 : 관심종목_스타일2에서 선물옵션종목 선택시 조회
' 작    성 : 2016.01.05 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk

Dim g_szGwanData
g_szGwanData = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Init_tblInfo
'============================================================================
Function Init_tblInfo()
	tblInfo.SetCellString(0, 0, "")
	tblInfo.SetCellString(1, 0, "")
	tblInfo.SetCellString(7, 0, "")
		
	For i = 3 to tblInfo.rowcount-1
		tblInfo.SetCellString(i, 1, "")
		tblInfo.SetCellString(i, 2, "")
	Next
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 스타일2화면에서 트리거 받음
	if sEventName == "JMCODE" then
		if g_szMk == "F" or g_szMk == "MF" or g_szMk == "XF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)
			DATAMANAGER.CancelRealData("ohhts_futs_cntg")			' 선물체결 자동갱신 취소
			DATAMANAGER.CancelRealData("ohhts_futs_cntg_1")		' 선물체결 자동갱신 취소(차트)
		elseif g_szMk = "O" or g_szMk == "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
			DATAMANAGER.CancelRealData("ohhts_optn_cntg")			' 옵션체결 자동갱신 취소
			DATAMANAGER.CancelRealData("ohhts_optn_cntg_1")		' 옵션체결 자동갱신 취소(차트)
		
		elseif g_szMk = "JF" then
			DATAMANAGER.CancelRealData("ohhts_sfut_cntg")			' 주식선물체결 자동갱신 취소
		
		elseif g_szMk = "JO" then
			DATAMANAGER.CancelRealData("ohhts_sopt_cntg")			' 주식옵션체결 자동갱신 취소
		
		end if
		
		Init_tblInfo()
	
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")
			tblInfo.SetCellString(0, 0, tData(0))		' 종목코드
			tblInfo.SetCellString(1, 0, tData(2))		' 종목명
			
			g_szCd = tData(0)	
			g_szMk = tData(1)	
			
'			if g_szMk == "JF" or g_szMk == "JO" then
'				DATAMANAGER.RequestTranData("ohhts_3070_001r")	' 주식선물옵션현재가
''				DATAMANAGER.RequestTranData("ohhts_3070_002r")	' 주식선물옵션현재가
'				DATAMANAGER.RequestTranData("ohhts_5030_001r")	' 현재가(차트[일])
''				tblInfo0.visible = true
''				tblInfo.visible = false
'			else
				' 기본 세팅후 조회
				DATAMANAGER.RequestTranData("ohhts_3050_001r")	' 선물옵션현재가
				DATAMANAGER.RequestTranData("ohhts_5030_001r")	' 현재가(차트[일])
'				tblInfo0.visible = false
'				tblInfo.visible = true
				
'				if g_szMk == "JF" or g_szMk == "JO" then
'					tblInfo.SetCellMaskInfo( 4, 1, "0,0,,,0,,0,1,1" )
'					tblInfo.SetCellMaskInfo( 7, 0, "0,0,,,0,,0,1,1" )
'					tblInfo.SetCellMaskInfo( 8, 1, "0,0,,,0,,0,1,1" )
'					tblInfo.SetCellMaskInfo( 9, 1, "0,0,,,0,,0,1,1" )
'					tblInfo.SetCellMaskInfo( 10, 1, "0,0,,,0,,0,1,1" )
'					
'				end if
'				
'			end if
		end if
		
		g_szGwanData = Form.GetSharedData("PRE_GWAN_GRID_POS", true )
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")			' 선물체결 자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_futs_cntg_1")		' 선물체결 자동갱신 취소(차트)
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")			' 옵션체결 자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_optn_cntg_1")		' 옵션체결 자동갱신 취소(차트)
	
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")			' 주식선물체결 자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")			' 주식옵션체결 자동갱신 취소
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 선물옵션현재가
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_3050_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5030_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE",  0, "Y")
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))		
	
	' ----------------------------------------------------------------------
	' 주식선물옵션현재가
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3070_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 주식선물옵션현재가(2)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3070_002r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3070_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_3070_002r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
		DATAMANAGER.SetDataValue(0, "ohhts_3070_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_3070_002r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 선물옵션현재가
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_3050_001r" then
		if g_szMk == "F" or g_szMk == "MF" or g_szMk == "XF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)
			DATAMANAGER.RequestRealData("ohhts_futs_cntg")			'  선물체결 자동갱신
		elseif g_szMk = "O" or g_szMk == "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
			DATAMANAGER.RequestRealData("ohhts_optn_cntg")			'  옵션체결 자동갱신
		elseif g_szMk == "JF" then
			DATAMANAGER.RequestRealData("ohhts_sfut_cntg")			'  주식선물체결 자동갱신
		elseif g_szMk = "JO" then
			DATAMANAGER.RequestRealData("ohhts_sopt_cntg")			'  주식옵션체결 자동갱신
		end if	
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5030_001r" then		
		if g_szMk == "F" or g_szMk == "MF" or g_szMk == "XF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)
			DATAMANAGER.RequestRealData("ohhts_futs_cntg_1")			'  선물체결 자동갱신
		elseif g_szMk = "O" or g_szMk == "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
			DATAMANAGER.RequestRealData("ohhts_optn_cntg_1")			'  옵션체결 자동갱신

		
		end if
		
	' ----------------------------------------------------------------------
	' 주식선물옵션현재가
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3070_001r" then
'		if g_szMk == "JF" then
'			DATAMANAGER.RequestRealData("ohhts_sfut_cntg")			'  주식선물체결 자동갱신
'		elseif g_szMk = "JO" then
'			DATAMANAGER.RequestRealData("ohhts_sopt_cntg")			'  주식옵션체결 자동갱신
'		end if	
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	DATAMANAGER.ClearInputData(1, szTranID)
	
	' ----------------------------------------------------------------------
	' 선물체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_futs_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 옵션체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_optn_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 선물체결 자동갱신(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_futs_cntg_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 옵션체결 자동갱신(차트)
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_optn_cntg_1" then
