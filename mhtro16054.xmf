	</CONTROL_INFO>
	<SCRIPT_INFO _len="832" _ulen="832" >
--===========================================================================
--===========================================================================

'--============================================================================
Sub Form_OnFormInit()
	WebView0.viewtype = "0"
	WebView0.urlpath = "http://dev_globalmonitor.einfomax.co.kr/meritz_mobile_new.html#/ETF/1/01"
	WebView0.webscroll = "1"
end Sub

'--============================================================================
Sub Form_OnRefresh()
	WebView0.urlpath = "http://dev_globalmonitor.einfomax.co.kr/meritz_mobile_new.html#/ETF/1/01"
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub
