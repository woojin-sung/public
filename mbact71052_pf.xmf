Dim g_tData
Dim g_szCode
Dim g_szStndCd
Dim g_szFundSrno
Dim g_szSpclInvrYn
dim g_szHGDTYn	'고난도상품여부
dim g_szFITYn		'적정성상품여부

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	g_szSpclInvrYn = "N"
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("11", szOpenData)
		'20230828 아이디 연결여부 추가
		g_szLinkedYN = Form.GetSharedData("71052_ID_LNKN_YN", false)
		
'		Form.ShowAlert("11", szOpenData)
		'종목명, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 체결잔고, 대출금, 대출일, 만기일, 종목코드, 잔고일련번호

		g_tData = Split(szOpenData, "☆")
		
		lblName.caption = g_tData[0]

		tbl0.SetCellString(0, 2, g_tData[1])
		
		tbl1.SetCellString(0, 1, g_tData[2])
		tbl1.SetCellString(1, 1, g_tData[3])
		If Left(g_tData[3], 1) == "+" Then
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(g_tData[3], 1) == "-" Then
			tbl1.SetCellFgColor(1, 1, "2")
		End If
		
		tbl1.SetCellString(2, 1, g_tData[4])
		If Left(g_tData[4], 1) == "+" Then
			tbl1.SetCellFgColor(2, 1, "1")
		ElseIf Left(g_tData[4], 1) == "-" Then
			tbl1.SetCellFgColor(2, 1, "2")
		End If
		
		szSaveType = Form.GetMetaData("집합투자증권저축유형코드", g_tData[13])
		tbl3.SetCellString(0, 1, szSaveType)
		tbl3.SetCellString(1, 1, g_tData[6])
		
		'20230925 현재가, 기준가 추가
		tbl3.SetCellString(2, 1, g_tData[14])
		
		If CDBL(g_tData[7]) <> 0 Then
			tbl2.SetCellString(0, 1, g_tData[7])
'			tbl2.SetCellString(1, 1, g_tData[8])
			tbl2.SetCellString(1, 1, g_tData[9])
		Else
			tbl2.SetCellString(0, 1, "0")
'			tbl2.SetCellString(1, 1, "-")
			tbl2.SetCellString(1, 1, "-")
		End If
		
		g_szCode = g_tData[10]
		g_szFundSrno = g_tData[11]
		
		g_szStndCd = g_tData[12]
		'ShowAlert(g_tData[10], g_tData[12])	
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnInfo_OnClick()
	Dim szSendData
	szSendData = g_szCode & "★" & g_szStndCd & "★" & ""	'g_szSaleChanTp
		
	'펀드 상세정보 팝업 오픈
	Form.OpenPopup("mbfnp51000_p2", szSendData, "")
End Sub

'============================================================================
Sub btnBuy_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	DATAMANAGER.RequestTranData("obsim_idmn_018r")
	DATAMANAGER.RequestTranData("obsap_acif_999a") '금융상품 일련번호 GET
End Sub

'============================================================================
Sub btnSell_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	'매도	'잔고일련번호★축약코드★종목코드(표준코드)★저축유형코드
	Dim szSendData
	szSendData = g_szFundSrno & "★" & g_szCode & "★" & g_szStndCd & "★" & g_tData[13]
	Form.OpenPopup("mbfnp51012", szSendData, "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"obcsb_acif_400r"	then
		'고객번호
		g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_400r", "InBlock1", "CSNO" , 0 , g_szCsno)

	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szCode)
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	If szTranID = "obsap_acif_999a" Then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
	
		'금융소비자확인팝업에서 723a 호출할때 필요!
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
'		Form.SetSharedData( "SPCL_CNFR_ACNO", "" )		'mbact71052_p5에서 그리드 셀 선택시 셋팅해줌!

		'금융소비자유형 확인
		Form.OpenPopup("mbonl81010_p20" , "" , "")
		
		
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회	
		g_szHGDTYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "HGDT_PROD_YN", 0)	'고난도상품여부
		g_szFITYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "FIT_PROD_YN", 0)	'적정성상품여부
		Form.SetSharedData("FNP51000_P8_PROD" , DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_PROD_GRAD_CODE", 0))	'추가매수에서 사용

	elseif	szTranID =	"obcsb_acif_400r" then
		g_szSpclInvrYn = DATAMANAGER.GetDataValue(0, "obcsb_acif_400r" , "OutBlock1" , "KYC_SPCL_INVR_YN" , 0)	'KYC전문투자자여부
		Form.SetSharedData("ADD_FUND_KYC_SPCL_INVR_YN" , g_szSpclInvrYn)	'추가매수에서 사용
		
		
		
		g_szID = Form.GetSharedData("&USER_ID", false )
		DATAMANAGER.SetDataValue(0, "obcsb_acif_798r", "InBlock1", "ELFN_ID", 0 , g_szID)
		DATAMANAGER.RequestTranData("obcsb_acif_798r")
		


	elseif	szTranID =	"obcsb_acif_798r" then
		g_szInvType = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE" , 0)	'KYC투자성향등급코드
		g_szRcmdClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_RCMD_CLS_CODE" , 0) 'KYC투자권유구분코드
		g_szModDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "MOD_DATE" , 0) '변경일자
		g_szMtrtDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_VALD_PRD_MTRT_DATE" , 0) '만기일자
	

		if g_szSpclInvrYn <> "Y" AND (g_szMtrtDate = "" or g_szMtrtDate = Null) then	
			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자성향 정보가 등록되지 않아\n해당 상품 가입이 불가합니다.\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
		elseif g_szSpclInvrYn <> "Y" AND (int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false))) then
			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자성향 유효기간이 경과되어\n해당 상품 가입이 불가합니다.\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
						
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
		elseif g_szSpclInvrYn <> "Y" AND ((g_szRcmdClsCode = "2" or g_szRcmdClsCode ="4")  and (g_szHGDTYn = "Y" or g_szFITYn = "Y")) then
			'적정성대상상품인 경우에만 띄움.			
			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자정보가 확인되지 않아\n해당 금융상품을 가입할 수 없습니다.\n고객님의 성향에 적합한 금융상품 투자를\n위하여 투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
	
		else	

			'정상이면, 투자성향 및 위험등급 확인 화면 오픈!
			Dim szSendData
			Dim TmpAcc
			Dim TmpIscd
			
			TmpAcc = Form.GetSharedData("ADD_FUND_ACCOUNT_NO") 
			szSendData = Form.GetSharedData("ADD_FUND_KYC_SPCL_INVR_YN") & "★" & TmpAcc & "★" & g_szCode & "★" & g_szStndCd & "★" & g_szFundSrno & "★" & "ADD"					
			Form.SetSharedData("FNP51000_P8_ACC_NO" , TmpAcc)
			Form.SetSharedData("FNP51000_P8_ISCD" , g_szCode)
			Form.SetSharedData( "FNDNAME_51010" , lblName.caption)	
			Form.OpenPopup("mbfnp51000_p8", szSendData, sPosInfo)
		
		end if
		
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	if sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then			
			DATAMANAGER.RequestTranData("obcsb_acif_400r")
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
			
		end if	
		
	elseIf sKeyName == "errMsgBox"  Then 
		if sRet = "Right" then				
			'투자성향재진단 화면 연결
			Form.OpenFramePopup("mbonl81010" , "" , "")
		end if
		
	end if
End Sub

	</SCRIPT_INFO>
