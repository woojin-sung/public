				</TRBLOCK>
			</TRAN>
			<TRAN name="obcsb_acif_798r" title="고객_전자금융ID_투자성향고객기" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="45" _ulen="37" >

ELFN_ID^전자금융ID^20^0^0^0^0^0^0

				</TRBLOCK>
