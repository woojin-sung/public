		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obsap_acif_999a" title="금융상품가입일련번호 채번" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="54" _ulen="42" >

