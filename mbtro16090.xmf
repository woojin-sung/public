--===========================================================================

Dim g_szEngName		'구독자 영문이름
Dim g_szEngAddress	'구독자 영문주소
Dim g_szEngJob		'구독자 영문직업명
Dim g_szEngCompany	'구독자 영문회사명
Dim g_szEngWorkAddr	'구독자 영문회사주소
Dim g_szOpenData
Dim g_szAgree			'이용계약 동의여부
Dim g_ExchName

g_CheckBtn3Cnt = 0  	'이용약관 카운트 횟수 - 2019.11.04

g_szEngName = ""
g_szEngAddress = ""
g_szEngJob = ""
g_szEngCompany = ""
g_szEngWorkAddr = ""
g_szAgree = ""
g_szPlainRm = ""		'MTS메모리평문 적용여부
g_szOpenData = ""
'============================================================================

Sub edtPwd01_OnEditComplete()
	
	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "PWDINFO_CHG",  edtPwd01.caption)
End Sub


'============================================================================
Sub acnt01_ChangeAccount()
	edtPwd01.caption = ""
	f_RequestAcntStateTR()
	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "ACNTINFO_CHG", left(acnt01.caption,8) & "★" & mid(acnt01.caption,9,2))
End Sub


'============================================================================
Sub fmtab01_OnTabChanged(nCurrentTab)
	if	acnt01.caption	<>	null		and	len(acnt01.caption)	>6	then
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "ACNTINFO_CHG", left(acnt01.caption,8) & "★" & mid(acnt01.caption,9,2)  & "★" & edtPwd01.caption)
	end	if
	
	'20211215 아이티젠 김성수 추가 START
	'주문화면에서 연동 시 최초 1회 계좌 비밀번호 없이 조회
	if g_szOpenData <> "" and g_szOpenData <> null then
		dim tData
		tData = {}
		tData = split(g_szOpenData, "★")
		
		if tData(0) == "주문" then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "PWDINFO_CHG_EXEPT", tData(1))
		end if
		
		g_szOpenData = "" '1회만 적용 되므로 변수 초기화
	else
		if	edtPwd01.caption	<>	null		and	len(edtPwd01.caption)	> 2	then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "PWDINFO_CHG", edtPwd01.caption)
		end	if
	end if
	'20211215 아이티젠 김성수 추가 END
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szScreenNo , szOS_TYPE, szOpenData
	
	'20211215 아이티젠 김성수 추가 START
	g_szOpenData = Form.GetOpenLinkData() '주문"★"해외마켓코드
	'20211215 아이티젠 김성수 추가 END
	
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	szOS_TYPE = Form.GetSharedData("&OS_TYPE", false)
	
	if szScreenNo == "16090" then '실시간 시세 신청/해지
		fmtab01.currenttab = 0
	
		if szOS_TYPE ~= "2" then
			fmtab01_OnTabChanged(0)
		else
			'211230 아이티젠 김성수 추가 START
			'iOS에서 비번 없이 바로 조회를 위해 추가
			if acnt01.caption <> null and len(acnt01.caption) > 6 then
				Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "ACNTINFO_CHG", left(acnt01.caption,8) & "★" & mid(acnt01.caption,9,2)  & "★" & edtPwd01.caption)
			end	if
			'211230 아이티젠 김성수 추가 END
		end if
	Else                          '실시간 시세 조회
		fmtab01.currenttab = 1
		
		if szOS_TYPE ~= "2" then
			fmtab01_OnTabChanged(1)
		end if
	end if
	
	f_RequestAcntStateTR()
	

End Sub


'============================================================================
Sub Form_OnRefresh()
	fmtab01_OnTabChanged(tonumber(fmtab01.currenttab))
End Sub

'20220124 아이티젠 김성수 추가 START : CFD계좌일 때 안내문구 팝업(전요셉 부장 요청)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtre_comm_004r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt01.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt01.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")							'비밀번호
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_comm_004r" then
		Dim szNationalCode
		szNationalCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CTCD", 0)

	        if szNationalCode = "840" then '미국
		    g_ExchName = "미국"
		elseif szNationalCode = "344" then '홍콩
		    g_ExchName = "홍콩"
		elseif szNationalCode = "156" then '중국
		    g_ExchName = "중국"
		elseif szNationalCode = "392" then '일본
		    g_ExchName = "일본"
	        end if

		if szNationalCode <> null and szNationalCode <> "" then
			if CInt(fmtab01.currenttab) == 0 then
			    '20220701 알림문구변경, T2205160017 해외주식 실시간시세 이벤트
				'Form.ShowAlert("알림", "※2022년 12월까지 개설한 CFD계좌는 실시간시세 신청시 개설국가에 한하여 2023년 6월까지 무료 적용됩니다." & chr(10) & "(단, 잔고와 매매내역이 없는 경우 익월 자동해지)")
                                'Form.ShowAlert("알림", "※2022년 6월까지 개설한 CFD계좌는 실시간시세 신청시 개설국가에 한하여 당해 12월까지 무료 적용됩니다.")
				'20230101 알림문구변경, T2212230006 해외주식 실시간시세 이벤트 연장
				'Form.ShowAlert("알림", "※ 해외주식CFD 거래를 위해 실시간 시세 신청이 필요합니다. 2024년 06월까지 실시간 시세 사용료는 무료입니다." & chr(10) & "(단, 잔고와 매매내역이 모두 없는 경우 익월 자동 해지됩니다.)")
				'Form.ShowAlert("알림", "※ 해외주식CFD 거래를 위해 실시간 시세 신청이 필요합니다. " & g_ExchName & "주식CFD 거래 고객은 2024년 06월까지 해외시장(" & g_ExchName & ")의 실시간 시세 사용료는 무료입니다."& chr(10) & "(단, 잔고와 매매내역이 모두 없는 경우 익월 자동 해지)")
				Form.ShowAlert("알림", "해외CFD 거래를 위해서 해외시장의 실시간 시세 신청이 필요하며, 해외CFD를 거래하시는 고객님에게는 무료로 제공하고 있습니다." & chr(10) & chr(10) & "단, 매월 매매내역이 없고 월말잔고 미보유 시 익월 실시간 시세 신청이 해지되며, 무료 제공은 회사 정책에 따라 변경될 수 있습니다.")
			end if
		end if
	end if
End Sub

'============================================================================
Function f_RequestAcntStateTR()
	DATAMANAGER.RequestTranData( "obtre_comm_004r" )
End Function
