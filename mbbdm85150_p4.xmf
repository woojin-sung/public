'============================================================================
' 01. 화 면 명 : 영어주소검색
' 02. 화면설명 : 영어주소검색
' 03. 작    성 : 2024.05.24
' 04. 수    정 : 통합검색(카카오MAP API)
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim sAddr1 
Dim sAddrDtl1
DIm sAddr2 
DIm sAddrDtl2
Dim g_Post_KOR
Dim g_Post_ENG
Dim g_Dtad
Dim g_BLDN_MNNO
Dim g_nFlag
Dim g_DeviceOS

Dim g_DataArr
g_DataArr = {"YN", "REGN_ZIP", "DTL_ZIP", "POST", "DTAD", "BLDN"}

'===========================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	f_SetSharedDataVal()

	'============================================================================
	'20230420 LES
	'============================================================================
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		ConPage0.EditDtlAddrBtn.visible = true
	else
		ConPage0.EditDtlAddrBtn.visible = false
	end if
	'============================================================================

	ConPage0.EditDtlAddr.imagefilepth 		= "login_input.9.png"
	
	'############ LES START ######################
	'iOS 는 컨테이너 이미지, 안드로이드는 이미지에 이미지, 힌트캡션
	OsType = Form.GetSharedData("&OS_TYPE", false)
	
	if OsType == "2" then
		Container0.containerimage = "popup_bg.9"
	else
		Container0.Image4.imgpath = "popup_bg.9"
	end if
	'############ LES End ######################

	'========================================================================
	' 앱<->웹 연동을 위한 필수 세팅 
	'========================================================================
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if g_DeviceOS == "1" then
		ConPage0.ConPage0.WebView0.SetUserAgent("meritz_android")
	elseif g_DeviceOS == "2" then
		ConPage0.WebView0.SetUseJavaScript("1")
		ConPage0.WebView0.SetUserAgent("meritz_ios")
	end if
	
	f_SyncKAKAO() ' 카카오 주소검색 페이지 연동	
End Sub

'===========================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'========================================================================
	' 주소선택 후(통합검색 카카오API)
	'========================================================================
	if sEventName == "WebViewReturn" then
		ConPage0.Grid3.visible 		= true
		ConPage0.EditDtlAddr.visible 	= true
		ConPage0.EditDtlAddr.caption	= ""
		
'		arrData(0) : 도로명주소 / arrData(1) : 지번주소 / arrData(2) : 우편번호
'		arrData(0) : 도로명주소 / arrData(1) : 지번주소 / arrData(2) : 우편번호 / arrData(3) : 도로명주소(영문) / arrData(4) : 지번주소(영문) 
		arrData = Split(sParam , "@")

		if arrData(0) == "" or arrData(0) == null then
			g_nFlag = "지번주소"
			'ConPage0.Grid3.SetCellData("BD_POST", 0, arrData(1))
			ConPage0.Grid3.SetCellData("BD_POST_KOR", 0, arrData(1))
			ConPage0.Grid3.SetCellData("BD_POST_ENG", 0, arrData(4))
			g_Post_ENG = arrData(3)
		else
			g_nFlag = "도로명주소"
			'ConPage0.Grid3.SetCellData("BD_POST", 0, arrData(0))
			ConPage0.Grid3.SetCellData("BD_POST_KOR", 0, arrData(0))
			ConPage0.Grid3.SetCellData("BD_POST_ENG", 0, arrData(3))
			g_Post_ENG = arrData(3)
		end if

		ConPage0.Grid3.SetCellData("BD_ZIP", 0, arrData(2))
		ConPage0.Grid3.SetCellFgColor("BD_ZIP", 0, 350)
	end if
	
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' X버튼
'============================================================================
Sub Container0_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 통합검색 : 상세주소
'============================================================================
Sub ConPage0_EditDtlAddr_OnEditComplete()

	'20230420 LES
	Call addrEndEditing()
	'if ConPage0.Grid3.GetCellData("BD_POST", 0) == "" or ConPage0.Grid3.GetCellData("BD_POST", 0) == null then
	if ConPage0.Grid3.GetCellData("BD_POST_KOR", 0) == "" or ConPage0.Grid3.GetCellData("BD_POST_KOR", 0) == null  then
		ConPage0.EditDtlAddr.caption = ""
		Form.MsgBox("알림", "기본주소를 검색하세요.", "", 6)
	else
		'g_Post_KOR = ConPage0.Grid3.GetCellData("BD_POST", 0).." "..ConPage0.EditDtlAddr.caption
		g_Post_KOR = ConPage0.Grid3.GetCellData("BD_POST_KOR", 0).." "..ConPage0.EditDtlAddr.caption
		g_Post_ENG = ConPage0.Grid3.GetCellData("BD_POST_ENG", 0).." "..ConPage0.EditDtlAddr.caption
		g_Dtad = ConPage0.EditDtlAddr.caption
		
		'DATAMANAGER.RequestTranData("obcpp_zipa_011r") '정제주소조회	
	end if
	
End Sub

'============================================================================
' 통합검색탭 : IOS의 경우 상세주소
'============================================================================
Sub ConPage0_EditDtlAddrBtn_OnClick()

	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		Call addrWhileEditing()
	end if
	
End Sub

'============================================================================
' 통합검색탭 : 확인버튼
'============================================================================
Sub ConPage0_BtnOk0_OnClick()

	if (ConPage0.EditDtlAddr.caption == "" or ConPage0.EditDtlAddr.caption == null) then
		Form.MsgBox("알림", "상세주소를 입력해주세요.", "", 6)
		Exit Sub
	end if

	Dim sYN
	sYN		   = g_nFlag == "도로명주소" and "Y" or "N"
	g_BLDN_MNNO  = g_nFlag == "도로명주소" and g_BLDN_MNNO	or ""

	'if g_Post_KOR == "" or g_Post_KOR == null then	
	if g_Post_ENG == "" or g_Post_ENG == null then	
		Form.MsgBox("알림", "기본주소를 검색하세요.", "", 6)
		Exit Sub
	end if
	
	if g_Dtad == "" or g_Dtad == null then	
		Form.MsgBox("알림", "상세주소를 입력하세요.", "", 6)
		Exit Sub
	end if
	
	f_ResetSharedData()

	Form.SetSharedData(g_DataArr[0], 	sYN)
	Form.SetSharedData(g_DataArr[1],	LEFT(ConPage0.Grid3.GetCellData("BD_ZIP", 0), 	3))
	Form.SetSharedData(g_DataArr[2],	RIGHT(ConPage0.Grid3.GetCellData("BD_ZIP", 0), 	2))
	Form.SetSharedData(g_DataArr[3], 	g_Post_ENG)
	Form.SetSharedData(g_DataArr[4], 	g_Dtad)
	Form.SetSharedData(g_DataArr[5], 	g_BLDN_MNNO)
				
	g_sRetData = "OK"
	
	Form.SendReturnToParent("mbbdm85150_p4" , g_sRetData)
	Form.CloseForm()
End Sub

'===========================================================================
' 							사용자 함수
'============================================================================

'===========================================================================
' SetSharedData 리셋 함수
'===========================================================================
Function f_ResetSharedData()
'	Form.SetSharedData("16090_ADDRESS_ENG_YN"		, "")
'	Form.SetSharedData("16090_ADDRESS_ENG_REGN_ZIP"	, "")
'	Form.SetSharedData("16090_ADDRESS_ENG_DTL_ZIP" 	, "")
'	Form.SetSharedData("16090_ADDRESS_ENG_POST" 		, "")
'	Form.SetSharedData("16090_ADDRESS_ENG_DTAD" 		, "")
'	Form.SetSharedData("16090_ADDRESS_ENG_BLDN" 		, "")	
		
	for i = 0 to #g_DataArr - 1
		Form.SetSharedData(g_DataArr[i], "")
	next
		
End Function

'===========================================================================
' 카카오 주소검색 페이지 연동
'===========================================================================
Function f_SyncKAKAO()
	serverMode = Form.GetSharedData("&SERVER_MODE", false)
	
	if serverMode == "1" Then	'개발기
		ConPage0.WebView0.urlpath = "https://testhome.imeritz.com/biz/kakaoaddr.html"
	else
		ConPage0.WebView0.urlpath = "https://home.imeritz.com/biz/kakaoaddr.html"
	end if
	
End Function

'============================================================================
'20230420 LES
'============================================================================
Function addrWhileEditing()
	ConPage0.LblBar.top = 707
	ConPage0.EditDtlAddrBtn.width = 345
	ConPage0.setScrollAutoSize()
	'ConPage0.scroll_pos_noAni = ConPage0.scroll_pos + 220
	ConPage0.scroll_pos = ConPage0.scroll_pos + 220
	ConPage0.EditDtlAddr.setFocus()
	
	ConPage0.BtnOk0.visible = false	
End Function

'============================================================================
''20230420 LES
'============================================================================
Function addrEndEditing()
	ConPage0.LblBar.top = 505
	ConPage0.EditDtlAddrBtn.width = 370
	ConPage0.setScrollAutoSize()
		
	ConPage0.BtnOk0.visible = true
End Function

'============================================================================
'어느 화면에서 왔느냐에 따라 sharedData 변수 할당
'============================================================================
Function f_SetSharedDataVal()
	Dim OpnScrnNm
	OpnScrnNm = Form.GetOpenLinkData() == "pass" and "mbbdm85150_p4" 
	if OpnScrnNm == "mbbdm85150_p4" then		
		for i = 0 to #g_DataArr - 1
			g_DataArr[i] = "16090_ADDRESS_ENG_"..g_DataArr[i]
		next
	end if

End Function
	</SCRIPT_INFO>
