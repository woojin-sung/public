	<SCRIPT_INFO _len="1814" _ulen="1812" >
'============================================================================
Sub Form_OnFormInit()
		
	szData = Form.GetOpenLinkData()
	
	if szData <> "" then
		szData = Split(szData,"★")
		
		szYear = Left(szData(0),4)
		szMon = Mid(szData(0),5,2)
		szDay = Right(szData(0),2)
		
		szYear2 = Left(szData(1),4)
		szMon2 = Mid(szData(1),5,2)
		szDay2 = Right(szData(1),2)
		
		Container0.Table1.SetCellString(17, 6, szYear&". "&szMon&". "&szDay)
		Container0.Table1.SetCellString(18, 6, szYear2&". "&szMon2&". "&szDay2)
	end if
	
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)

	UserID = Form.GetSharedData( "&USER_ID", 0 )
	Form.SetEnvData(1, UserID&"BDMEVENTPOPUP", "1")
	
End Sub

'============================================================================
Sub Button0_OnClick()

	Form.CloseForm()

End Sub

'============================================================================
Sub Container0_Table1_OnClick(lRow , lColumn)
	if lRow == 29 and lColumn == 4 then
		Form.OpenPopup("notice_p8" , "" , "")
'		Form.OpenExternalBrowser("https://home.imeritz.com/EM.html")
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

