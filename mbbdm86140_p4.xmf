	<SCRIPT_INFO _len="4298" _ulen="4212" >
'v0001 : 전상일 : pdf스트리밍 적용 
Dim g_szDev
Dim g_szOpenData

'============================================================================
Sub Form_OnFormInit()
	g_szDev = Form.GetSharedData("&SERVER_MODE", False )
	
	g_szOpenData = Form.GetOpenLinkData()
	if g_szOpenData <> "" and g_szOpenData <> null then
		if g_szOpenData == "Mndt" then
			labTitle.caption = "개인(신용)정보 처리 필수 동의"
			
			'필수
			'if g_szDev == "1" or g_szDev == 1 then
			'	WebView0.urlpath = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf"
			'else
			'	WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf"
			'end if 
			
			'필수
			if g_szDev == "1" or g_szDev == 1 then
				WebView0.urlpath = "https://teststreamdocs.imeritz.com/mobile?filePath=meritz_ts_3.pdf" 
			else
				WebView0.urlpath = "https://streamdocs.imeritz.com/mobile?filePath=meritz_ts_3.pdf"
			end if 
			
		else
			labTitle.caption = "개인(신용)정보 처리 선택 동의"
			
			'선택
			if g_szDev == "1" or g_szDev == 1 then
				WebView0.urlpath = "https://teststreamdocs.imeritz.com/mobile?filePath=meritz_ts_5.pdf" 
				'WebView0.urlpath = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm10.pdf"
			else
				WebView0.urlpath = "https://streamdocs.imeritz.com/mobile?filePath=meritz_ts_5.pdf"
				'WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm10.pdf"
			end if 
		end if
	end if
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	if g_szOpenData <> "" and g_szOpenData <> null then
		'필수
		if g_szOpenData == "Mndt" then
			if nCurrentTab == 0 then
				if g_szDev == "1" or g_szDev == 1 then
					WebView0.urlpath = "https://teststreamdocs.imeritz.com/mobile?filePath=meritz_ts_3.pdf" 
				else
					WebView0.urlpath = "https://streamdocs.imeritz.com/mobile?filePath=meritz_ts_3.pdf"
				end if 
				'if g_szDev == "1" or g_szDev == 1 then
				'	WebView0.urlpath = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf"
				'else
				'	WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf"
				'end if 
			else
				if g_szDev == "1" or g_szDev == 1 then
					WebView0.urlpath = "https://teststreamdocs.imeritz.com/mobile?filePath=meritz_ts_4.pdf" 
				else
					WebView0.urlpath = "https://streamdocs.imeritz.com/mobile?filePath=meritz_ts_4.pdf"
				end if 
				'if g_szDev == "1" or g_szDev == 1 then
				'	WebView0.urlpath = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm9.pdf"
				'else
				'	WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm9.pdf"
				'end if 
			end if
		
		'선택
		else
			if nCurrentTab == 0 then
				if g_szDev == "1" or g_szDev == 1 then
					WebView0.urlpath = "https://teststreamdocs.imeritz.com/mobile?filePath=meritz_ts_5.pdf" 
				else
					WebView0.urlpath = "https://streamdocs.imeritz.com/mobile?filePath=meritz_ts_5.pdf"
				end if 
				'if g_szDev == "1" or g_szDev == 1 then
				'	WebView0.urlpath = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm10.pdf"
				'else
				'	WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm10.pdf"
				'end if 
			else
				if g_szDev == "1" or g_szDev == 1 then
					WebView0.urlpath = "https://teststreamdocs.imeritz.com/mobile?filePath=meritz_ts_6.pdf" 
				else
					WebView0.urlpath = "https://streamdocs.imeritz.com/mobile?filePath=meritz_ts_6.pdf"
				end if 
				'if g_szDev == "1" or g_szDev == 1 then
				'	WebView0.urlpath = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm11.pdf"
				'else
				'	WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm11.pdf"
				'end if 
			end if
		end if
	end if
End Sub

'============================================================================
Sub imgExit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub bntOK_OnClick()
	Form.SendReturnToParent("mbbdm86140_p4" , "ok_" & g_szOpenData)
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>