'============================================================================
Function User_Invt_Proc(gb)  'JMY
	If gb == "ok" Then
	    g_PUKYC_INVT_INCL_GRAD_CODE   	= Form.GetSharedData("BDM_KYC_GRAD"           , false)  '투자성향등급
	    g_PUKYC_PROD_GRAD_CODE     		= Form.GetSharedData("BDM_PROD_GRAD"          , false)  '상품등급
	    g_PUunfitYn                		= Form.GetSharedData("BDM_UNFIT_YN"           , false)  '부적합여부
	    g_PUFTOT_KYC_INVT_INCL_GRAD_CODE	= Form.GetSharedData("BDM_DVPD_KYC_GRAD"      , false)  '파생상품투자성향등급
	    g_PUFTOT_KYC_PROD_GRAD_CODE		= Form.GetSharedData("BDM_DVPD_PROD_GRAD"     , false)  '파생상품상품등급
	    g_PUFtotUnfitYn		         = Form.GetSharedData("BDM_DVPD_UNFIT_YN"      , false)  '파생상품부적합여부
	    g_PUWeakFnncYn				= Form.GetSharedData("BDM_WEAK_FNNC_YN"       , false)  '취약금융소비자여부	
	    g_PUKYC_INVT_RCMD_CLS_CODE		= Form.GetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"  , false)		'KYC투자권유구분코드
	End If
End Function         
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
    'JMY 투자성향진단 미완료 
    if sKeyName == "Invt_Error" then
        if sRet == "ok" then  '예.ok / 아니오.no
            DATAMANAGER.RequestTranData("obaci_acct_052c")
	    end if    
    end if
    
    'v0003 sta
    if sKeyName = "ReTryPrcd2" Then
	    If sRet = "no" Then  'ok.예 no.아니오
		    	closeFlag = "2"
			Form.CloseForm()
	    Else
		   g_szISA_APLY_ACNT_OPNG_CLCD = "2"
		   DATAMANAGER.RequestTranData("obaci_acct_052c")
	    End if
    End if
    'v0003 fin
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    'JMY 투자성향진단
    If sKeyName == "MBBDM85140" Then
		User_Invt_Proc("ok")
		If sRet == "ok" Then
		
			'v0003 sta
			if g_szPRCD133YN == "Y" and g_szISA_PROD_TYPE == "3" Then
				DATAMANAGER.RequestTranData("obaci_acct_089r")
			Else
				DATAMANAGER.RequestTranData("obaci_acct_052c")
			End if
			'v0003 fin
			
         ElseIf sRet == "unable" Then
              '최종 투자성향 체크시, 개설불가(상품가입불가능 및 상품부적합)인 경우, 현재 개설중인 건 취소 후, 종료처리
			DATAMANAGER.RequestTranData("obaci_acct_049c_1")

         '최종단계에서 개설불가 체크된 경우, 신청내역을 (자동)취소/종료되지만 취소플래그(sRet = unable)가 미설정될 경우, 
         '2단계_투자성향진단 체크처럼 고객에게 안내함
		Else
			'투자성향진단 비정상종료와 부적합(적정성보고서) 비정상종료 분리
			If sRet == "unfit_fail" Then
				Form.ShowAlert("알림", "[투자성향 대비 고위험거래 가입확인],\n[투자성상품 적정성 판단 보고서확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행(확인)해주세요.")
				Exit Sub
			'투자권유 희망 확인서 미처리에 따른 진행불가 알럿	
			ElseIf sRet == "hopeRecInv_fail" Then
				Form.ShowAlert("알림", "[투자권유 희망 여부 확인],\n[투자권유 희망 여부 확인서 확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
				Exit Sub	
			Else
				'TEST용 SKIP 종료
				'Form.MsgBox("알림", "투자성향 진단이 올바르게 처리되지 않았습니다.\n계속 진행하시겠습니까?(계좌개설이 불가될 수 있습니다.)", "Invt_Error", "2")  '2.예/아니오
				Form.ShowAlert("알림", "투자성향 진단이 올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행(확인)해주세요.")
                  Exit Sub
			End If
		End If	
	ElseIf sKeyName = "mbbdm85171_p1_end" Then
		If sRet == "ok" Then
			'2021.04.20. 김유경. 10번 이상 오류 시 계좌개설 취소
			'closeFlag = "2"
			'Form.CloseForm()		
			DATAMANAGER.RequestTranData("obaci_acct_049c_1")
		End If
		
    end if
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)  'JMY
	If sTimerID == "1" or sTimerID == 1 Then
		Form.ShowAlert("오류", "통신상태가 원활하지 않습니다.\n잠시 후 다시 처리해 주세요.")
		Form.SetTimerEvent("1", 0, 30)
	ElseIf sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2("2", 0, 0.8)
		ContMain.Edit0.SetShowKeypad(true)		
	 'v0011 jsi start
	ElseIf sTimerID == "3" or sTimerID == 3 Then
		Form.SetTimerEvent2(sTimerID, 0, DEF_1ST_TIME)
		
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "OTSD_TR_UNIQ_NO"	, 0,  sOTSDTRUNIQNO)
		DATAMANAGER.RequestTranData("obtss_idvs_002a")
		
	ElseIf sTimerID == "4" or sTimerID == 4 Then
		Form.SetTimerEvent(sTimerID, 0, DEF_2ST_TIME)
		
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "OTSD_TR_UNIQ_NO"	, 0,  sOTSDTRUNIQNO)
		DATAMANAGER.RequestTranData("obtss_idvs_002a")
		
	'v0011 jsi end		
	End If
	
	'v0003 sta 은합회 결과값에 따라 체크 
    '안드로이드는 num, 아이폰은 string으로 받음
	If sTimerID == 10 or sTimerID == "10" then
		Form.SetTimerEvent( 10, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	End If
	
	If sTimerID == 11 or sTimerID == "11" then
		Form.SetTimerEvent( 11, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	End If
	
	If sTimerID == 12 or sTimerID == "12" then
		Form.SetTimerEvent( 12, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	End If
	
	If sTimerID == 13 or sTimerID == "13" then
		Form.SetTimerEvent( 13, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
	End If
	'v0002 fin
End Sub
'============================================================================
Sub Form_OnFormClose()
	If closeFlag == "2" Then
		Form.OpenScreen( "41000" , "")
	End If
End Sub 



'============================================================================
' 테스트인증Skip
'============================================================================
Sub chkSkip_OnChange(sCheckState)
	If sCheckState == "0" Or sCheckState == 0 Then     	
		BtnNext.enable = False
	Else 
		BtnNext.enable = True
    End If
End Sub 
'============================================================================
Sub ContMain_Button0_OnClick()
	Call Image1_OnClick()
End Sub

