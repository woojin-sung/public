'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'비대면업무_1원이체 검증 및 오류내역 처리
	If szTranId = "obaci_nmet_012a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "ATHN_CNFR_NO"  , 0 , ContMain.Edit0.caption) '인증확인번호	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO"   , 0 , gRegUniqNo            ) '등록고유번호	
		
	ElseIf szTranId = "obcsb_acif_809r" Then	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"         , 0 , gRCNO       )
	ElseIf szTranId = "obcsb_acif_801r" Then	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"         , 0 , gRCNO       )
	ElseIf szTranID = "obaci_acct_072r" Then
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , gRCNO      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , gRegUniqNo	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , gPageID	)
		
'JMY Sta
'	ElseIf szTranId = "obcsb_nice_030r" Then	
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SDRC_CLS_CODE"  , 0, "1"       )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_CLS_CODE"  , 0, "1"       )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRIN_IQRY_CLCD" , 0, "TR01"    )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_TYPE_CODE" , 0, "01"      )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNM"           , 0, gsUserName)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0, gRCNO     )
'JMY Fin

	ElseIf szTranID == "obtss_idvs_001a" Then
		Call setIDNTF(szTranID)
	'진위확인 실패 시(obtss_idvs_001a) 이력 TR 호출
	ElseIf szTranID == "obaci_idvs_003a" Then
		Call setIDNTF_HISTORY(szTranID)
	ElseIf szTranID == "obaci_acct_049c" Then
	
		'공통
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 		, 0 , gRegUniqNo  ) '등록고유번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE"  , 0 , "5"	    ) '등록단계구분코드

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "TR_DATE"			, 0 	, sTR_DATE 	  	  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 	, sOTSDTRUNIQNO 	  )
'		2021-11-19 sta mbbdm85121 테스트 스킵 할경우 정상처리, mbbdm85171화면에서도 정상처리
		Dim szTestMode
		szTestMode = Form.GetSharedData("&SERVER_MODE", False )
		If szTestMode == "1" or szTestMode == 1 Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "RSPN_TYPE_CODE"		, 0 	, "T"				)
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "RSPN_TYPE_CODE"		, 0 	, sRSPNTYPECODE 	  	)
		End If
'		2021-11-19 fin
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "IDNTF_TORF_YN"		, 0 	, g_IDNTF_TORF 	  )	
		
		'v0003 sta : 중개형 ISA 개설시 신규개설/ 이수개설 여부 재저장(타사 비대면 계좌개설 동시에 할경우 예방)
		If g_szPRCD133YN == "Y" and g_szISA_PROD_TYPE == "3" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock4",  "ISA_ACNT_APLT_YN"	, 0 , g_szPRCD133YN 				)	'ISA 계좌개설 여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock4",  "ISA_PROD_TYPE_CLCD"	, 0 , g_szISA_PROD_TYPE	 		)	'ISA 상품유형구분코드
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock4",  "ISA_JOIN_TPCD"		, 0 , "66" 						)	'ISA 가입유혀 코드
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock4",  "ISA_ACNT_OPNG_CLCD"	, 0 , g_szISA_APLY_ACNT_OPNG_CLCD 	)	'이어가기시 다시 적용하는 계좌개설구분코드	
		End If
		'v0003 fin
		
		'Call setResultIdntf(szTranId)
		
	ElseIf szTranID == "obaci_acct_052c" Then
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "REG_UNIQ_NO"				, 0	, gRegUniqNo                         ) 
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE"	, 0	, g_PUKYC_INVT_INCL_GRAD_CODE		)
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "KYC_PROD_GRAD_CODE"		, 0	, g_PUKYC_PROD_GRAD_CODE			)
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "UNFIT_YN"				, 0	, g_PUunfitYn						)
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "FTOT_INVT_INCL_GRAD_CODE"	, 0	, g_PUFTOT_KYC_INVT_INCL_GRAD_CODE	)
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "FTOT_PROD_GRAD_CODE"		, 0	, g_PUFTOT_KYC_PROD_GRAD_CODE		)
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "FTOT_UNFIT_YN"			, 0	, g_PUFtotUnfitYn					)
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "KYC_INVT_RCMD_CLS_CODE"	, 0	, g_PUKYC_INVT_RCMD_CLS_CODE		)
		
	ElseIf szTranID == "obaci_nmet_015c" Then
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "RCNO_PIP"	, 0	, gRCNO	    )		
		DATAMANAGER.SetDataValue(0,	szTranID, "InBlock1", "REG_UNIQ_NO"	, 0	, gRegUniqNo )
	ElseIf szTranID == "obaci_acct_049c_1" Then
	     DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_UNIQ_NO"       , 0 , gRegUniqNo  )
         DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , "9"                )  ' 9.취소
	
	'v0003 sta 은합회 결과값에 따라 체크 
	ElseIf szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then	
		if szTranID == "obaci_acct_089r" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_PROS_CLS_CODE" , 0 , "3"			)	'업무처리구분코드
		else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_PROS_CLS_CODE" , 0 , "4"			)	'업무처리구분코드
		end if
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PRCD" 				, 0 , "140"			)	'상품코드 : 중개형 ISA '2021-12-06 kSJ
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" 		, 0 , "66"			)	'은행연합회상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_TRPR_CLS_CODE" , 0 , "0" 			)	'세금우대대상자구분
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CUST_CLS_CODE" 		, 0 , "1" 			)	'고객구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RCNO_PIP" 			, 0 , gRCNO			)	'고객실명확인번호PIP값
	End If
	'v0003 fin  
End Sub

'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	If szTranID = "obaci_nmet_012a" Then
		
		gAthnMstkCsnu    = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ATHN_MSTK_CSNU"     , 0) 
		gAthnCnfrDate    = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ATHN_CNFR_DATE"     , 0) 
		gOpnOtsdTrUniqNo = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OPN_OTSD_TR_UNIQ_NO", 0) 
			
		
		If LEN(TRIM(gAthnCnfrDate)) > 0 Then '인증완료 
		
			If TRIM(gAthnCnfrDate) == "00010101" Then '인증완료: 이미 사용한 인증번호 입니다.
				ContMain.Edit0.SetResultLabel("1", "error","이미 사용한 인증번호 입니다." ,"ContMain")
				
				BtnNext.enable = False
				'BtnNext.bgcolor = 271
				'BtnNext.fgcolor = 269
				BtnNext.btnimage = "btn_21.9"
				BtnNext.fgcolor = "269"
			Else 
				
				ContMain.Edit0.SetResultLabel("1", "complete","본인계좌 인증에 성공하였습니다.","ContMain")
				BtnNext.enable = True
				ContMain.Edit0.enable = False
				'BtnNext.bgcolor = 265
				'BtnNext.fgcolor = 0
				BtnNext.btnimage = "btn_20.9"
				BtnNext.fgcolor = "273"
			End If
			'DATAMANAGER.RequestTranData("obaci_acct_072r")
		Else
			
			If Cint(gAthnMstkCsnu) >= 10 Then
				Form.OpenPopup("mbbdm85171_p1", "" , "" )
			Else
				ContMain.Edit0.SetResultLabel("1", "error","인증번호가 일치하지 않습니다.("..	Cint(gAthnMstkCsnu).."/10)\n 10회 오류 시 신청과정이 종료됩니다." ,"ContMain")
				'ContMain.Edit0.SetShowKeypad(true)
				Form.SetTimerEvent2("2", 1, 0.8) '1:Set
			End If
			
			BtnNext.enable = False
			'BtnNext.bgcolor = 271
			'BtnNext.fgcolor = 269
						
		End If
	ElseIf szTranID == "obcsb_acif_801r" Then		

'JMY 투자성향 Sta.
		Form.OpenPopup("mbbdm85140", "", "")
        'DATAMANAGER.RequestTranData("obcsb_acif_809r")
'JMY 투자성향 Fin.
		

	ElseIf szTranID == "obcsb_acif_809r" Then
		gOLDMAN = DATAMANAGER.GetDataValue(0, "obcsb_acif_809r" , "OutBlock1" , "EXSN_CUST_YN" , 0) '기존고객여부

		If gOPTN_YN == "Y" or gOVDV_YN == "Y" or gDmstCFD_YN == "Y" or gOvrsCFD_YN = "Y" Then  'v0001 CFD추가	'v0003 해외CFD 추가
			'JMY Sta
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01")
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1")
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, g_RSNOTYPE)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, gRCNO)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM" 			, 0, gsUserName)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "1")
			'JMY Fin
			DATAMANAGER.RequestTranData("obcsb_nice_030r")
		Else
		'gClearYN = "Y"
			'v0003 sta 이어가기 여부 상관없이 obtss_idvs_001a 돌려
			If gClearYN == "N" Then '이어가기여부
				DATAMANAGER.RequestTranData("obtss_idvs_001a")
				'Form.SetTimerEvent("1", 1, 30) '1:Set
				
			Else
				'v0003 sta : 중개형 ISA 개설시 신규개설/ 이수개설 여부 재저장(타사 비대면 계좌개설 동시에 할경우 예방) obtss_idvs_001a > obaci_acct_049c > obaci_acct_015c
				If g_szPRCD133YN == "Y" and g_szISA_PROD_TYPE == "3" Then
					DATAMANAGER.RequestTranData("obtss_idvs_001a")
					'Form.SetTimerEvent("1", 1, 30) '1:Set	
					
				Else
					DATAMANAGER.RequestTranData("obaci_nmet_015c") '계좌개설 서비스
				End If
				'v0003 fin
			End If
		End If 
	ElseIf szTranID == "obcsb_nice_030r" Then 
		gSdrcSrno_1 = DATAMANAGER.GetDataValue(0, "obcsb_nice_030r" , "OutBlock2" , "SDRC_SRNO" , 0 )
		sRsltCls_1  = DATAMANAGER.GetDataValue(0, "obcsb_nice_030r" , "OutBlock1" , "RSLT_CLS"  , 0 )
		sBdcrClcd_1 = DATAMANAGER.GetDataValue(0, "obcsb_nice_030r" , "OutBlock3" , "BDCR_CLCD" , 0 )

		If sRsltCls_1 == "3" Or sRsltCls_1 == "0" Then
			If sBdcrClcd_1 == "N" Then
				If gClearYN = "N" Then '이어가기여부
					DATAMANAGER.RequestTranData("obtss_idvs_001a")
					'Form.SetTimerEvent("1", 1, 30) '1:Set
				Else
					'v0003 sta : 중개형 ISA 개설시 신규개설/ 이수개설 여부 재저장(타사 비대면 계좌개설 동시에 할경우 예방) obtss_idvs_001a > obaci_acct_049c > obaci_acct_015c
					If g_szPRCD133YN == "Y" and g_szISA_PROD_TYPE == "3" Then
						DATAMANAGER.RequestTranData("obtss_idvs_001a")
						'Form.SetTimerEvent("1", 1, 30) '1:Set 	
						
					Else
						DATAMANAGER.RequestTranData("obaci_nmet_015c") '계좌개설 서비스
					End If
					'v0003 fin
				End If
				
			Else
				'계좌실패 화면 OPEN. 계좌개설 프로세스 종료
				Dim sSendData
				sSendData = "신용도 판단정보 및 공공정보가 등록된 자"
				
				'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
				Form.OpenNextPopup("mbbdm85181", sSendData, "" )              '계좌개설 실패
				'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
				
			End If
		Else
		    'JMY Sta
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD"	, 0, "TR01")
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1")
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, g_RSNOTYPE)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, gRCNO)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM"    		, 0, gsUserName)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "2"	)
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock2", "SDRC_SRNO"		, 0, gSdrcSrno_1)
			'JMY Fin
			DATAMANAGER.RequestTranData("obcsb_nice_030r")
		End If	
	ElseIf szTranID == "obtss_idvs_001a" Then
		'v0011 jsi start
		'Form.SetTimerEvent("1", 0, 30) '1:Set
		
		g_BIOTrName	= szTranID
		g_BIORetry	= 0
		sOTSDTRUNIQNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
		
		
		Form.SetTimerEvent2(3,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
         ElseIf szTranID == "obtss_idvs_002a" Then
		sCODE 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 		, 0)
		sCNTT 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		'sTR_DATE 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
		'sOTSDTRUNIQNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
		sRSPNTYPECODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_TYPE_CODE"	, 0) '0:정상 9:오류  8:수기허용 R:재시도
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
'		2021-11-19 sta mbbdm85121 테스트 스킵 할경우 정상처리, mbbdm85171화면에서도 정상처리
		Dim szTestMode
		szTestMode = Form.GetSharedData("&SERVER_MODE", False )
		If szTestMode == "1" or szTestMode == 1 Then
			sRSPNTYPECODE = "0"
			
'		2021-11-19 fin	
		
		elseIf  sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry = g_BIORetry + 1
			'v0012
			'if g_BIORetry >= 3 then 
			if g_BIORetry >= 21 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry= 0 '초기화	
			end if 
			
			Form.SetTimerEvent(4,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			
		end if
		
		If sRSPNTYPECODE = "0" Then 						'정상
			g_IDNTF_TORF = "Y" 							'신분증진위확인여부
			g_NrmlCnvrProsYn = "Y"
			Form.SetTimerEvent("2", 1, 40) 
			
			if (szTestMode == "1" or szTestMode == 1) and  sTR_DATE == "" then 
				'001a가 거래일자를 주지않음.
				sTR_DATE = g_TR_DATE
			else
				'v0002 : obtss_idvs_002a 에서 받은 거래일자를 세팅해준다
				sTR_DATE =  DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" , 0)
			end if 
			
			'ShowAlert("알림", "수신 거래일자 :::" & sTR_DATE)	
			'20210309. 서비스 콜 순서 변경. 이어가기의경우에만 obtss_idvs_001a -> obaci_acct_049c -> obaci_nmet_015c
			'DATAMANAGER.RequestTranData("obaci_nmet_015c")  '계좌개설 서비스
			DATAMANAGER.RequestTranData("obaci_acct_049c")
			'20210309. 서비스 콜 순서 변경
		ElseIf sRSPNTYPECODE = "8" Then 					'수기허용
			g_IDNTF_TORF = "N" 
			g_NrmlCnvrProsYn = "N"
			ShowAlert("알림", "신분증정보가 불일치합니다. \n재촬영하시거나, 인식된 정보를 확인해주시기 바랍니다. \n문의:고객센터 1588-3400")	
			DATAMANAGER.RequestTranData("obaci_idvs_003a")   '비대면에서는 수기허용 비허용
		ElseIf sRSPNTYPECODE = "R" Then 				   '재시도
			ShowAlert("알림", "신분증정보가 불일치합니다. \n재촬영하시거나, 인식된 정보를 확인해주시기 바랍니다. \n문의:고객센터 1588-3400")	
			g_IDNTF_TORF = "N" 
			g_NrmlCnvrProsYn = "N"
			DATAMANAGER.RequestTranData("obaci_idvs_003a")   
		ElseIf sRSPNTYPECODE = "7" Then 
			ShowAlert("알림", "죄송합니다. 시스템 문제로 신분증\n진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다.\n문의:고객센터 1588-3400")	
			g_IDNTF_TORF = "N" 							'신분증진위확인여부
			g_NrmlCnvrProsYn = "N"
			DATAMANAGER.RequestTranData("obaci_idvs_003a")   '비대면에서는 수기허용 비허용
		ElseIf sRSPNTYPECODE = "P" Then 
			ShowAlert("알림", "죄송합니다. 시스템 문제로 신분증\n진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다.\n문의:고객센터 1588-3400")	
			g_IDNTF_TORF = "N" 						   '신분증진위확인여부
			g_NrmlCnvrProsYn = "N"
			DATAMANAGER.RequestTranData("obaci_idvs_003a")   '비대면에서는 수기허용 비허용
		ElseIf sRSPNTYPECODE = "9" Then 				   '오류
			ShowAlert("알림", "신분증 진위확인을 하지 못하였습니다.\n확인 후 이용바랍니다. \n문의:고객센터 1588-3400")
			'szMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
			'szMsg = "죄송합니다. \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."		
			g_IDNTF_TORF = "N" 
			g_NrmlCnvrProsYn = "N"
			DATAMANAGER.RequestTranData("obaci_idvs_003a")   
		End If	
	ElseIf szTranID == "obaci_acct_072r" Then
	
		'============================================================================
		' OutBlock4 신분증 진위확인
		'============================================================================		
		g_idntf_torf_yn         = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "IDNTF_TORF_YN"            , 0)
		g_idntf_cls_code        = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "IDNTF_CLS_CODE"           , 0)
