		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_3", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 12, 1, 1 )
		End If	
	ElseIf szTranID == "obaci_acct_089r_3" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부 V0005

			if sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자는 ISA 가입이 불가합니다.")
				Exit Sub
			end if 
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				g_szISA_APLY_ACNT_OPNG_CLCD = "1"
				DATAMANAGER.RequestTranData("obaci_acct_052c")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				
				If g_szISA_ACNT_OPNG_CLCD == "2" Then
					g_szISA_APLY_ACNT_OPNG_CLCD = "2"
					DATAMANAGER.RequestTranData("obaci_acct_052c")
				Else
					Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
					Exit Sub		
				End If
			End If
			
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_4", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 13, 1, 1 )
		End If
	ElseIf szTranID == "obaci_acct_089r_4" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부 V0005

			if sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자는 ISA 가입이 불가합니다.")
				Exit Sub
			end if 
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				g_szISA_APLY_ACNT_OPNG_CLCD = "1"
				DATAMANAGER.RequestTranData("obaci_acct_052c")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				
				If g_szISA_ACNT_OPNG_CLCD == "2" Then
					g_szISA_APLY_ACNT_OPNG_CLCD = "2"
					DATAMANAGER.RequestTranData("obaci_acct_052c")	
				Else
					Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
					Exit Sub		
				End If
			End If
			
		Else
			Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다.")
			Exit Sub
		End If
	End If
End Sub 

