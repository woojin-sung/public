Function OutBlock5_072(szTranID)
	
	g_KycInvtInclGradCode		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "KYC_INVT_INCL_GRAD_CODE"	, 0)'step2에서 처리한 투자성향 등급
	g_KycProdGradCode 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "KYC_PROD_GRAD_CODE"		, 0)
	g_UnfitYn         		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "UNFIT_YN"				, 0)
	g_FtotInvtInclCode		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "FTOT_INVT_INCL_GRAD_CODE"	, 0)'step2에서 처리한 투자성향 등급
	g_FtotProdGradCode		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "FTOT_PROD_GRAD_CODE"		, 0)
	g_FtotUnfitYn     		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "FTOT_UNFIT_YN"			, 0)
	g_FtotUnfitYn     		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "FTOT_UNFIT_YN"			, 0)
	g_DealPrmsYn				= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DEAL_PRMS_YN"			, 0)
	g_072OldMan				= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "EXSN_CUST_YN"			, 0)
	g_KycInvtRcmdClsCode		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock5" , "KYC_INVT_RCMD_CLS_CODE"	, 0)
	If g_KycInvtInclGradCode == "" Then
		g_KycInvtInclGradCode = g_FtotInvtInclCode
	End If
	
End Function

