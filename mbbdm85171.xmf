'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID <> "obaci_nmet_015c" Then
		'오류메시지 설정
		sSendData = DATAMANAGER.GetDataMsgSubText(szTranID) 'szErrCode.."★"..szErrMsg.."★"..DATAMANAGER.GetDataMsgSubText(szTranID) & "(" & szTranID & ")"
		If Trim(sSendData) ~= null And Trim(sSendData) ~= "" Then
			strMsg = szErrMsg.."("..Trim(sSendData)..")"
		Else
			strMsg = szErrMsg
		End If
		
		If szTranID = "obtss_idvs_001a" Then 
			Form.SetTimerEvent("1", 0, 30)
		
		ElseIf szTranID == "obaci_nmet_012a" Then
			'2021.04.13. 김유경. 메시지 추가
			ContMain.Edit0.SetResultLabel("1", "error","계좌변경 선택 후 재처리 바랍니다." ,"ContMain")
		ElseIf szTranID == "obtss_opnf_101a" Then
			Form.ShowAlert("오류", strMsg)
		End If
	Else
		sSendData = DATAMANAGER.GetDataMsgSubText(szTranID)  'szErrCode.."★"..szErrMsg.."★"..DATAMANAGER.GetDataMsgSubText(szTranID) & "(" & szTranID & ")"
		'ex)임직원매매계좌[%s-%s]보유-사전승인필요
		l_szList1 = Split(sSendData,"[") 'ex1) 임직원매매계좌 / %s-%s]보유-사전승인필요
		if l_szList1(0) = "임직원매매계좌" then
			l_szList2 = Split(l_szList1(1),"]") '  %s-%s
			sSendData = "임직원 매매계좌는 1개만 보유 가능합니다.\n사전승인 후 개설 가능하며\n법규준수팀으로 문의해주세요.\n("& l_szList2(0) & "계좌 보유)"
			Form.SetSharedData("mbbdm85181_EMP_YN", "Y")
		end if
		'2021.04.13. 김유경 위치변경
		'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
		Form.OpenNextPopup("mbbdm85181", sSendData , "" ) '계좌개설 실패
		'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
	End If
	
End Sub 

