'--===========================================================================
' 01. 화 면 명 : 당사/타사대체출고_잔고조회/추가 팝업
' 02. 화면설명 : 당사/타사대체출고_잔고조회/추가 팝업
' 03. 작    성 : 2022.03.28 김수진 
' 04. 수    정 : 2022.08.19 장원혁 v001 연금저축 & 투융자계좌 신주인수권증서 출고허용
' 05. 수    정 : 2023.02.01 안중진 v002 타사대체시 당일 매수결제건 체크
' 06. 수    정 : 2023.10.20 신지환 v003 당일 매수채권 타사대체출고 불가 조건 추가
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcno		'계좌번호
Dim g_szAsno		'계좌일련번호
Dim g_szType 		'당사/타사 구분값 3:당사 H:타사
Dim g_tAddItem		'추가할 종목코드 테이블
Dim g_tAddItemData	'추가할 종목정보 테이블
Dim g_nSelectRow		'선택한 Row
Dim g_nRmndExstRow     '당일매수결체종목선택한 Row수
Dim g_tAddBuyDate      '추가할 매수일자 테이블
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function f_SetItem(szState, IRow )
	Dim szISCD, szBuyDate
	szISCD  	= grdList.GetCellData( "bd_Iscd", IRow )		'종목코드
	szBuyDate = grdList.GetCellData( "bd_BuyDate", IRow )'매수일자
	
	If szState == "insert" Then
		'테이블 종목추가
		g_tAddItem[#g_tAddItem] = szISCD
		g_tAddBuyDate[#g_tAddBuyDate] = szBuyDate
		
		DIm szIscdNm, szAbleQty, szTaxType, szTaxCode, szIssuTpCd, szByovErt, szTaxPaymCd, szSptxYN, szRmndQty, szBuyAble, szBuyGvup
		szIscdNm 	= grdList.GetCellData( "bd_IscdNm"		, IRow )'종목명
		szAbleQty 	= grdList.GetCellData( "bd_AbleQty"		, IRow )'출고가능수량
		szTaxType 	= grdList.GetCellData( "bd_TaxType"		, IRow )'과세
		szTaxCode 	= grdList.GetCellData( "bd_TaxCode"		, IRow )'과세구분 코드
		szIssuTpCd 	= grdList.GetCellData( "bd_IssuTpCd"		, IRow )'종목유형 코드
		szByovErt 	= grdList.GetCellData( "bd_ByovErt"		, IRow )'매수수익률
		szTaxPaymCd 	= grdList.GetCellData( "bd_TaxPaymCd"	, IRow )'세금납입구분코드
		szSptxYN 	= grdList.GetCellData( "bd_SptxYN"		, IRow )'분리과세여부
		szRmndQty 	= grdList.GetCellData( "bd_RmndQty"		, IRow )'분리과세신청수량
		szBuyAble 	= grdList.GetCellData( "bd_BuyAbleQty"	, IRow )'매수청구가능수량
		szBuyGvup 	= grdList.GetCellData( "bd_BuyGuYN"		, IRow )'매수포기동의여부
		
		Dim szItemInfo
		szItemInfo = ""
		szItemInfo = szISCD.."★"..szIscdNm.."★"..szAbleQty.."★"..szTaxType.."★"..
					szTaxCode.."★"..szIssuTpCd.."★"..szByovErt.."★"..szTaxPaymCd.."★"..
					szSptxYN.."★"..szRmndQty.."★"..szBuyAble.."★".. szBuyGvup
					
		Dim szCustGrade, szTarfCode, szFee, szGroupCode, szOTC
		'szBuyDate 	= grdList.GetCellData( "bd_BuyDate"		, IRow )'매수일자
		szCustGrade 	= grdList.GetCellData( "bd_CusRateCd"	, IRow )'고객등급
		szTarfCode 	= grdList.GetCellData( "bd_TariffCd"		, IRow )'요율코드
		szFee 		= grdList.GetCellData( "bd_CommissonD"	, IRow )'수수료
		szGroupCode 	= grdList.GetCellData( "bd_ScrtCd"		, IRow )'증권그룹코드
		szOTC 		= grdList.GetCellData( "bd_OTC"			, IRow )'OTC 구분
		
		szItemInfo 	= szItemInfo.."★"..szBuyDate.."★"..szCustGrade.."★"..szTarfCode.."★"..
						szFee.."★"..szGroupCode.."★"..szOTC

		if szItemInfo <> "" then
			'g_tAddItemData
			'0 종목코드
			'1 종목명
			'2 출고가능수량
			'3 과세구분명
			'4 과세구분코드
			'5 종목유형
			'6 매수수익률
			'7 세금납입구분코드
			'8 분리과세여부
			'9 분리과세신청수량
			'10 매수청구수량
			'11 매수청구포기동의여부
			'12 매수일자
			'----타사 일 경우 추가 데이터----
			'13 고객등급
			'14 요율코드
			'15 수수료
			'16 증권사그룹코드
			'17 OTC구분
			
			g_tAddItemData[#g_tAddItemData] = szItemInfo
		end if
	Else
		'테이블 종목삭제
		Dim szIssuTpCd
		szIssuTpCd 	= grdList.GetCellData( "bd_IssuTpCd"		, IRow )'종목유형 코드

		Dim tTemp1, tTemp2, tTemp3
		tTemp1 = {}
		tTemp2 = {}
		tTemp3 = {}

		For i = 0 to #g_tAddItem - 1 
			If szIssuTpCd <> "03" Then
				If g_tAddItem[i] <> szISCD Then
					tTemp1[#tTemp1] = g_tAddItem[i]
					tTemp2[#tTemp2] = g_tAddItemData[i]
					tTemp3[#tTemp3] = g_tAddBuyDate[i]
				End If
			Else
				If g_tAddItem[i] <> szISCD OR g_tAddBuyDate[i] <> szBuyDate Then 
					tTemp1[#tTemp1] = g_tAddItem[i]
					tTemp2[#tTemp2] = g_tAddItemData[i]
					tTemp3[#tTemp3] = g_tAddBuyDate[i]
				End If
			End If
		Next
		
		g_tAddItem = tTemp1
		g_tAddItemData = tTemp2
		g_tAddBuyDate = tTemp3
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("출고가능종목")
	g_szAcno = ""		
	g_szAsno	= ""
	g_szType = ""
	g_tAddItem = {}
	g_tAddItemData = {}
	g_nSelectRow = -1
	g_nRmndExstRow = 0
	g_tAddBuyDate = {}
	
	Dim szOpenData
	szOpenData = Form.GetopenLinkData()
	
	If Trim(szOpenData) == "" Then
		Exit Sub
	End If

	Dim tData
	tData = Split(szOpenData, "★")
	
	If UBound(tData) > 0 Then
		g_szAcno = tData(0)
		g_szAsno	= tData(1)
		g_szType	= tData(2)
		
		Account.caption = g_szAcno & g_szAsno 'v001

		DATAMANAGER.RequestTranData( "obrts_tkwr_018r" )	'계좌별종목잔고조회
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'매수청구권리포기 안내 팝업
	If sKeyName == "mbbnk61100_p3" Then
		If sRet == "Y" Then
			'동의상태 SET
			grdList.SetCellData("bd_BuyGuYN", g_nSelectRow, "Y")
			'테이블 종목추가
			f_SetItem("insert", g_nSelectRow)
		Else
			'동의상태 SET
			grdList.SetCellData("bd_BuyGuYN", g_nSelectRow, "N")
			grdList.SetCellData( "bd_Chk", g_nSelectRow, "0" ) '체크상태 해제
			g_nSelectRow = -1
			
			Form.ShowAlert( "알림", "매수청구 권리포기 동의시 출고가능합니다." )
		End If
	'사모채권 거래쿼터 신청 팝업
	ElseIf sKeyName == "mbbnk61130" Then 
		'거래쿼터 신청 화면 사이즈때문에 가렸던 버튼 visible 다시 true
		btnCancel.visible = true
		btnOK.visible = true
		If sRet == "Y" Then
			If g_szType == "3" then
				DATAMANAGER.RequestTranData( "obrts_wrhs_013r" )	'입출고 필요종목정보 조회2			
			Else
				Dim szFeeTranID, szItemCd, szTARF_CODE
				szFeeTranID 	= "obrtp_comn_004r"'수수료 조회 서비스명
				szItemCd 	= grdList.GetCellData("bd_Iscd"		, g_nSelectRow)'종목코드
				szTARF_CODE 	= grdList.GetCellData("bd_TariffCd"	, g_nSelectRow)'요율코드
				DATAMANAGER.ClearInputData( 0, szFeeTranID )
				DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "ACNO"		, 0, g_szAcno 	)
				DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "ASNO"		, 0, g_szAsno 	)
				DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "TARF_CODE"	, 0, szTARF_CODE 	)
				DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "ISCD"		, 0, szItemCd 	)
				DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "STND_DATE"	, 0, Form.GetSharedData("&HOST_DATE", false))
				
				DATAMANAGER.RequestTranData( "obrtp_comn_004r" ) '수수료
			End If
		Else
			grdList.SetCellData( "bd_Chk", g_nSelectRow, "0" ) '체크상태 변경
			g_nSelectRow = -1
		End If
	End If
    
End Sub

'============================================================================
' Form_OnMsgBoxClose()
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "mbbnk61100_p1_ELW" Then
		if sRet == "ok" Then
			'서비스 흐름 obrts_ccfo_007r > obrts_wrhs_013r
			DATAMANAGER.RequestTranData( "obrts_ccfo_007r" )	'입출고 필요종목정보 조회(사모채권)
		Else
			grdList.SetCellData( "bd_Chk", g_nSelectRow, "0" ) '체크상태 해제
			g_nSelectRow = -1
		End If
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_Chk" Then	
		Dim szCheckState
		szCheckState = grdList.GetCellData( szCellID, lRow ) 	'체크상태
		
		' uncheck >> check
		If szCheckState == "1" Then
			g_nSelectRow = lRow	
			Dim szIssuTpCd
			szIssuTpCd = grdList.GetCellData( "bd_IssuTpCd", g_nSelectRow )	'종목유형 코드
			Dim szIssuTpNm 'JWH
			szIssuTpNm = grdList.GetCellData( "bd_IssuTpNm", g_nSelectRow )	'종목유형명 JWH
			
			'선택종목 개수 예외처리 ------------------------------
			If #g_tAddItem > 4 Then
				Form.ShowAlert("알림", "최대 5종목까지 선택 가능합니다.")
				grdList.SetCellData( szCellID, lRow, "0" ) '체크상태 변경
				g_nSelectRow = -1 
			Else 
				'집합투자증권 예외처리 ------------------------------
				If szIssuTpCd == "07" Then
					Form.ShowAlert( "알림", "집합투자증권은 온라인에서 출고가 불가능합니다." )
					grdList.SetCellData( szCellID, lRow, "0" ) '체크상태 변경
					g_nSelectRow = -1
				ElseIf szIssuTpCd == "08" Then 'JWH
					Form.ShowAlert( "알림", "파생결합증권은 온라인에서 출고가 불가능합니다." ) 'JWH
					grdList.SetCellData( szCellID, lRow, "0" ) '체크상태 변경 JWH
					g_nSelectRow = -1 'JHW
				ElseIf szIssuTpCd == "04" Then 'JWH
					Form.ShowAlert( "알림", "CP/전단채는 온라인에서 출고가 불가능합니다." ) 'JWH
					grdList.SetCellData( szCellID, lRow, "0" ) '체크상태 변경 JWH
					g_nSelectRow = -1 'JHW					
				ElseIf Trim(szIssuTpNm) == "해외채권" Then 'JWH
				    Form.ShowAlert( "알림", "해외채권은 온라인에서 출고가 불가능합니다." ) 'JWH
				    grdList.SetCellData( szCellID, lRow, "0" ) '체크상태 변경 JWH
				    g_nSelectRow = -1 'JWH
				Else
				
					'종목시장에 따른 예외처리------------------------------
					Dim szISCD, szMK, szInnerMk
					szISCD  	= grdList.GetCellData( "bd_Iscd", lRow )		'종목코드
					szMK = Form.GetItemCodeInfo( Mid(Trim(szISCD), 2, Len(Trim(szISCD))) , "market")
					' 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
					Select Case szMk
						Case "J", "T", "W"
							szISCD = Mid(Trim(szISCD), 2, Len(Trim(szISCD))) 
						Case Else
							if Left(szISCD, 1, 1) == "A" then
								szISCD = Mid(Trim(szISCD), 2, Len(Trim(szISCD))) 
							else
								szISCD = szISCD	
							end if
					End Select	
					szMK = Form.GetItemCodeInfo( szISCD, "market")
					szInnerMk = Form.GetItemCodeInfo( szISCD, "innermarket")
					'ELW ------------------------------
					If (szMK == "W" and Left( szISCD, 1 ) = "J") or szIssuTpCd == "17" Then
						Form.MsgBox( "알림", "해당 종목에 대한 대체신청으로, 'ELW거래신청'은 취소처리가 됩니다. 취소처리후 ELW에 대한 매수는 금지되며, 매도처리는 가능합니다. 대체처리를 하시겠습니까?", "mbbnk61100_p1_ELW", 2)
						Exit Sub
					End If
						
					'서비스 흐름 : obrts_ccfo_007r > obrts_wrhs_013r
					DATAMANAGER.RequestTranData( "obrts_ccfo_007r" )	'입출고 필요종목정보 조회
				End If
			End If
			
			'grdList.SetCellData("bd_RmndExstYn" , lRow, "N" 	) '당일수매결제여부
			
			'If g_szType == "H" Then
				'DATAMANAGER.RequestTranData( "obrts_tkwr_052r" ) '20231026 JWH 위치이동
			'End If
			
		' check >> uncheck	
		Else 
			'테이블 종목삭제
			f_SetItem("remove", lRow)
			
			Dim szRmndExstYn
			szRmndExstYn = grdList.GetCellData( "bd_Iscd", lRow )	
			
			If szRmndExstYn	== "Y" Then
				g_nRmndExstRow = g_nRmndExstRow - 1
				grdList.SetCellData("bd_RmndExstYn" , lRow, "N" 	) '당일수매결제여부
			End If
		End If
	End If
End Sub
'============================================================================
' grdList_OnScrollEnd() : 넥스트 조회
'============================================================================
Sub grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData( "obrts_tkwr_018r" ) == True then 
		DATAMANAGER.RequestNextData( "obrts_tkwr_018r" )
	End If
End Sub

'============================================================================
' btnCancel_OnClick() : 취소
'============================================================================
Sub btnCancel_OnClick()
	Form.SendReturnToParent( "mbbnk61100_p1" , "")
	Form.CloseForm()
End Sub

'============================================================================
' btnOK_OnClick() : 종목추가
'============================================================================
Sub btnOK_OnClick()
	
	If #g_tAddItem == 0 Then
		Form.ShowAlert("알림", "추가할 종목을 선택하세요.")
		Exit Sub
	End if
	
	If g_nRmndExstRow > 0 Then
		Form.SetSharedData("mbbnk61100_RmndExstYn" , "Y")
	Else
		Form.SetSharedData("mbbnk61100_RmndExstYn" , "N")
	End If
	
	'전송데이터 포맷 
	Dim szSendItem
	For i = 0 to #g_tAddItemData - 1 
		If i == 0 Then
			szSendItem = g_tAddItemData[i]
		Else
			szSendItem = szSendItem.."♥"..g_tAddItemData[i]
		End If	
	Next
	Form.SendReturnToParent( "mbbnk61100_p1" , szSendItem )
	Form.CloseForm()	
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'계좌별종목잔고조회
	If szTranID == "obrts_tkwr_018r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO"          , 0 , g_szAcno )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO"          , 0 , g_szAsno )	'계좌일련번호	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , g_szType )	'당사/타사 구분코드

	'입출고 필요종목정보 조회
	ElseIf szTranID == "obrts_wrhs_013r" Then
		Dim szISCD, szBuyDate, szTaxPaymCd
		szISCD  		= grdList.GetCellData( "bd_Iscd", 		g_nSelectRow )		
		szBuyDate 	= grdList.GetCellData( "bd_BuyDate", 	g_nSelectRow )		
		szTaxPaymCd 	= grdList.GetCellData( "bd_TaxPaymCd",	g_nSelectRow )	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO"          		, 0 , g_szAcno	 )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO"         			, 0 , g_szAsno	 )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD"          		, 0 , szISCD 	 	 )	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BYOV_DATE"     		, 0 , szBuyDate	 )	'매수일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OVRL_SPTX_CLS_CODE"    	, 0 , szTaxCode	 )	'종합분리과세코드
			
	'입출고 필요종목정보 조회(사모채권)
	ElseIf szTranID == "obrts_ccfo_007r" Then
		Dim szISCD, szBuyDate, szTaxCode, nByovErt, szTaxPaymCd
		szISCD  		= grdList.GetCellData( "bd_Iscd", 		g_nSelectRow )		
		szBuyDate 	= grdList.GetCellData( "bd_BuyDate", 	g_nSelectRow )	
		szTaxCode	= grdList.GetCellData( "bd_TaxCode", 	g_nSelectRow )		'
		nByovErt 	= grdList.GetCellData( "bd_ByovErt", 	g_nSelectRow )		
		szTaxPaymCd 	= grdList.GetCellData( "bd_TaxPaymCd",	g_nSelectRow )		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO"          		, 0 , g_szAcno 	 )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO"          		, 0 , g_szAsno 	 )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD"          		, 0 , szISCD 	 	 )	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BYOV_DATE"     		, 0 , szBuyDate	 )	'매수일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OVRL_SPTX_CLS_CODE"    	, 0 , szTaxCode	 )	'종합분리과세코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BYOV_ERT"     			, 0 , nByovErt	 )	'매수수익률
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TAX_PAYM_CLS_CODE"		, 0 , szTaxPaymCd	 )	'세금납입구분코드
	
	'당일 매수결제여부 조회
	ElseIf szTranID == "obrts_tkwr_052r" Then
		Dim szISCD, szBuyDate
		szISCD  		= grdList.GetCellData( "bd_Iscd", 		g_nSelectRow )
		szBuyDate 	= grdList.GetCellData( "bd_BuyDate", 	g_nSelectRow )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO"          		, 0 , g_szAcno 	 )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO"          		, 0 , g_szAsno 	 )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD"          		, 0 , szISCD 	 	 )	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BYOV_DATE"          	, 0 , szBuyDate 	 )	'매수일자
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계좌별 종목잔고조회 
	If szTranID == "obrts_tkwr_018r" Then
		If tonumber(grdList.rowcount) > 0 Then
			DIm nDataCnt, nRowCnt
			nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ))
			nRowCnt = grdList.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1					
				If szTaxPaymCode == "0" Then
					grdList.SetCellData("bd_TaxPaymClsCd", nRowCnt + i, "해당없음")
				ElseIf szTaxPaymCode == "1" Then
					grdList.SetCellData("bd_TaxPaymClsCd", nRowCnt + i, "선취")
				ElseIf szTaxPaymCode == "2" Then
					grdList.SetCellData("bd_TaxPaymClsCd", nRowCnt + i, "후취")
				End If
				
				'채권일경우에만 매수일자, 과세구분 SET
				Dim szISCD, szMK
				szISCD  	= grdList.GetCellData( "bd_Iscd", nRowCnt + i)		'종목코드
				szMK = Form.GetItemCodeInfo( szISCD, "market") 				'시장구분값
				
				Dim szIssuTpCd
				szIssuTpCd = grdList.GetCellData( "bd_IssuTpCd", nRowCnt + i)	'종목유형 코드
				If szIssuTpCd == "03" Then							'채권 : 03
					Dim szTaxCode, szTaxPaymCode
					szTaxCode 	= grdList.GetCellData( "bd_TaxCode", nRowCnt + i)
					szTaxPaymCode	= grdList.GetCellData( "bd_TaxPaymCd", nRowCnt + i)
					
					If szTaxCode == "1" Then
						grdList.SetCellData("bd_TaxType", nRowCnt + i, "종합")
					ElseIf szTaxCode == "2" Then
						grdList.SetCellData("bd_TaxType", nRowCnt + i, "분리")
					Else
						grdList.SetCellData("bd_TaxType", nRowCnt + i, "")
					End If
				Else
					grdList.SetCellData("bd_BuyDate", nRowCnt + i, "")	'매수일자
					grdList.SetCellData("bd_TaxType", nRowCnt + i, "")	'과세구분
				End If
				
				'해외종목 종목코드만 보이게 처리
				Dim szIscd
				szIscd = grdList.GetCellData( "bd_Iscd", nRowCnt + i)
				If InStr(szIscd, ".") <> null Then
					Dim tData
					tData = Split(szIscd, ".")
					grdList.SetCellData("bd_cell0", nRowCnt + i, tData[0])
				Else
					grdList.SetCellData("bd_cell0", nRowCnt + i, szIscd)
				End If
			Next
			'2022.05.09 KSJ 출고가능 종목 없을 경우 취소/종목선택 버튼 invisible
			btnCancel.visible = true
			btnOK.visible = true
			grdList.visible = true
			lblNoData.visible = false		
			lblUnit.visible = true
		Else
			'2022.05.09 KSJ 출고가능 종목 없을 경우 취소/종목선택 버튼 invisible
			btnCancel.visible = false
			btnOK.visible = false
			grdList.visible = false
			lblNoData.visible = true
			lblUnit.visible = false
		End If

	'입출고 필요종목정보 조회
	ElseIf szTranID == "obrts_ccfo_007r" Then
	
		'사모채권 종목 예외처리 --------------------
		Dim szPeBondYN
		szPeBondYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PE_BOND_YN" , 0 )	'사모채권여부
		If szPeBondYN == "Y" Then
			'사모채권일 경우 거래쿼터 신청화면 Open
			'********************************************************************************************************************************
			' szSendData : 오픈한 화면번호(key)★계좌번호★계좌일련번호★종목코드★종목명★잔고수량★매수일자★종합분리과세구분코드
			'********************************************************************************************************************************
			Dim szIscd, szIscdNm, szRmQty, szBuyDate, szTaxCode
			szIscd  		= grdList.GetCellData( "bd_Iscd", 		g_nSelectRow )	'종목코드
			szIscdNm		= grdList.GetCellData( "bd_IscdNm", 		g_nSelectRow )	'종목명
			szRmQty		= grdList.GetCellData( "bd_RmQty", 		g_nSelectRow )	'잔고수량
			szBuyDate 	= grdList.GetCellData( "bd_BuyDate", 	g_nSelectRow )	'매수일자	
			szTaxCode	= grdList.GetCellData( "bd_TaxCode", 	g_nSelectRow )	'종합분리과세구분코드

			Dim szSendData
			szSendData = "mbbnk61100_p1" & "★" & g_szAcno & "★" & g_szAsno & "★" & 
						szIscd & "★" & szIscdNm & "★" & szRmQty & "★" & szBuyDate & "★" & szTaxCode
			
			'거래쿼터 신청 화면 사이즈때문에 버튼 visible false
			btnCancel.visible = false
			btnOK.visible = false
			Form.OpenFramePopup("mbbnk61130" , szSendData , "")
			Exit Sub
		End If
		
		Dim szTARF_CODE
		If g_szType == "H" then '타사대체출고일 때
			Dim isCall '수수료 호출 여부
			isCall = grdList.GetCellData("bd_CommissonCall", g_nSelectRow)
			If isCall <> "Y" then
				'-------------------------------------------------------------
				'OTC구분 SET
				Dim szIssuCd '종목유형코드
				szIssuCd = grdList.GetCellData( "bd_IssuTpCd", g_nSelectRow )
				if szIssuCd == "08" then
					dim szOTC 'OTC 구분 > 07:ELS,10:DLS
					szOTC = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROD_CLS_CODE" , 0)
					grdList.SetCellData( "bd_OTC", g_nSelectRow, szOTC )
				end if
				'-------------------------------------------------------------
				'미국인계좌,미국거주계좌 예외처리
				Dim szRGSYN
				szRGSYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RGS_YN" , 0)
				If szRGSYN == "Y" Then
					Form.ShowAlert( "알림", "해당종목은 미국거주계좌, 미국인계좌에 입고가 불가능합니다.\n거주국가 및 국적 확인후 출고바랍니다. (CCF출고처리 불가능)" )
					grdList.SetCellData( "bd_Chk", g_nSelectRow, "0" ) '체크상태 변경
					g_nSelectRow = -1
					Exit Sub
				End If
				'-------------------------------------------------------------
				'공모입고 수량 존재 시 수수료 알림
				Dim szPOSCYN
				szPOSCYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "POSC_YN" , 0)
				If szPOSCYN == "Y" Then
					Form.ShowAlert( "알림", "공모입고된 수량이 존재합니다. 출고시 수수료가 징수됩니다." )
					szTARF_CODE = "0210"
				Else
					szTARF_CODE = "0207"
				End If
				grdList.SetCellData("bd_TariffCd", g_nSelectRow, szTARF_CODE )'요율코드
				'-------------------------------------------------------------
				'ETF 구분 SET
				Dim szEXCH_TXTN_TYPE_CODE
				szEXCH_TXTN_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "EXCH_TXTN_TYPE_CODE" , 0)
				If szEXCH_TXTN_TYPE_CODE == "2" or szEXCH_TXTN_TYPE_CODE == "3" or szEXCH_TXTN_TYPE_CODE == "4" Then'ETF
					grdList.SetCellData("bd_ETF", g_nSelectRow, szEXCH_TXTN_TYPE_CODE)
				End If
				'-------------------------------------------------------------
				'분리과세 신청 수량 SET
				Dim szSPTXYN '분리과세여부
				szSPTXYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SPTX_YN" , 0)
				grdList.SetCellData( "bd_SptxYN",  g_nSelectRow, szSPTXYN )
				If szSPTXYN == "Y" then
					Dim nRMNDQTY '분리과세신청수량
					nRMNDQTY = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RMND_QTY" , 0))
					grdList.SetCellData("bd_RmndQty", g_nSelectRow, nRMNDQTY)
				End If
				'-------------------------------------------------------------
				'권리포기동의 관련 데이터 SET
				Dim nDMPR_ABLE_QTY '반대의사가능수량
				nDMPR_ABLE_QTY = CInt(Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DMPR_ABLE_QTY" , 0)))
				If nDMPR_ABLE_QTY > 0 then '수량 존재 시
					Dim szEXRSYN '반대의사수량구분
					szEXRSYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "EXRS_YN" , 0)
					grdList.SetCellData("bd_BuyAbleQty", g_nSelectRow, nDMPR_ABLE_QTY )
					grdList.SetCellData("bd_ExrsYN", g_nSelectRow, szEXRSYN )
				End If
			End If
		End If
		
		If g_szType == "3" then
			DATAMANAGER.RequestTranData( "obrts_wrhs_013r" )	'입출고 필요종목정보 조회2			
		Else
			Dim szFeeTranID, szItemCd, szTARF_CODE
			szFeeTranID 	= "obrtp_comn_004r"'수수료 조회 서비스명
			szItemCd 	= grdList.GetCellData("bd_Iscd"		, g_nSelectRow)'종목코드
			szTARF_CODE 	= grdList.GetCellData("bd_TariffCd"	, g_nSelectRow)'요율코드
			DATAMANAGER.ClearInputData( 0, szFeeTranID )
			DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "ACNO"		, 0, g_szAcno 	)
			DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "ASNO"		, 0, g_szAsno 	)
			DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "TARF_CODE"	, 0, szTARF_CODE 	)
			DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "ISCD"		, 0, szItemCd 	)
			DATAMANAGER.SetDataValue( 0, szFeeTranID, "InBlock1", "STND_DATE"	, 0, Form.GetSharedData("&HOST_DATE", false))
			
			'채권이고 요율코드가 NULL이면 수수료 조회안함
			Dim szIssuCd '종목유형코드
			szIssuCd = grdList.GetCellData( "bd_IssuTpCd", g_nSelectRow )
			If szTARF_CODE == "" AND szIssuCd == "03" Then
				grdList.SetCellData("bd_TariffCd"		, g_nSelectRow, ""	)'요율코드
				grdList.SetCellData("bd_CusRateCd"		, g_nSelectRow, ""	)'고객등급
				grdList.SetCellData("bd_Commisson"		, g_nSelectRow, "N" 	)'수수료대상여부
				grdList.SetCellData("bd_CommissonD"		, g_nSelectRow, 0 	)'수수료
				grdList.SetCellData("bd_CommissonCall"	, g_nSelectRow, "Y" 	)'수수료조회여부
				
				Dim szExrsYN, nDmprAbleQty, szSptxYN, szIscdNm
				szExrsYN 	= grdList.GetCellData( "bd_ExrsYN", g_nSelectRow )
				nDmprAbleQty 	= CDbl(grdList.GetCellData( "bd_BuyAbleQty", g_nSelectRow ))
				szIscdNm 	= grdList.GetCellData( "bd_IscdNm", g_nSelectRow )
				'권리포기동의 체크
				If nDmprAbleQty > 0 Then
					If szExrsYN <> "" and szExrsYN <> null and szIscdNm <> "" and szIscdNm <> null Then 
						Form.OpenPopup( "mbbnk61100_p3" , szIscdNm.."★"..szExrsYN , "")
					End If
				Else
					'테이블 종목추가
					f_SetItem("insert", g_nSelectRow)
				End If
			Else
				DATAMANAGER.RequestTranData( "obrtp_comn_004r" ) '수수료
			End If
		End If
		
        grdList.SetCellData("bd_RmndExstYn" , g_nSelectRow , "N") '당일매수결제여부
			
        If g_szType == "H" Then
            DATAMANAGER.RequestTranData( "obrts_tkwr_052r" ) '20231026 JWH 당일매수체결수량존재여부 (위치 여기로 변경. 서비스 Sync 맞추기 위해)
        End If
	
	'입출고 필요종목정보 조회2	
	ElseIf szTranID == "obrts_wrhs_013r" Then

		'분리과세 관련 처리 --------------------
		Dim szSptxYN 
		szSptxYN	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SPTX_YN" , 0) '분리과세여부
		grdList.SetCellData( "bd_SptxYN",  g_nSelectRow, szSptxYN )
		If szSptxYN = "Y" Then
			Dim nRmndQty
			nRmndQty = tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RMND_QTY" , 0))			       
			
			grdList.SetCellData( "bd_RmndQty",  g_nSelectRow, nRmndQty )
		Else
			grdList.SetCellData( "bd_RmndQty",  g_nSelectRow, 0 )			       
		End If
		
		'권리포기동의 관련 처리 --------------------
		Dim szExrsYN, nDmprAbleQty, szIscdNm
		szExrsYN 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "EXRS_YN" , 0) '표시여부
		nDmprAbleQty 	= tonumber(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DMPR_ABLE_QTY" , 0 )) '매수청구가능수량
		szIscdNm 	= grdList.GetCellData( "bd_IscdNm", g_nSelectRow ) '종목명
		grdList.SetCellData("bd_BuyAbleQty"	, g_nSelectRow, nDmprAbleQty 	)
		grdList.SetCellData("bd_ExrsYN"		, g_nSelectRow, szExrsYN 		)
	
		'20220520 김성수 추가
		'ETF/ETN 배당세금 관련 처리 --------------------
		Dim szIssuCd '02 = ETF/ETN
		szIssuCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ISSU_TYPE_CODE" , 0)
		If szIssuCd == "02" Then
			Dim nSTAS_SDPR
			nSTAS_SDPR = CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STAS_SDPR" , 0)) '과표기준가
			if nSTAS_SDPR > 0 then
				Form.ShowAlert( "알림", "해당 ETF/ETN종목은 타인명의 대체시 보유기간 배당세금이 출금됩니다.")
			end if
		End if
		
		If nDmprAbleQty > 0 Then
			If szExrsYN <> "" and szExrsYN <> null and szIscdNm <> "" and szIscdNm <> null Then 
				Form.OpenPopup( "mbbnk61100_p3" , szIscdNm.."★"..szExrsYN , "")
			End If
		Else
			'테이블 종목추가
			f_SetItem("insert", g_nSelectRow)
		End If
		
		
	'수수료 조회 시 처리
	ElseIf szTranID == "obrtp_comn_004r" Then
		Dim szIssuTpCd
		szIssuTpCd = grdList.GetCellData("bd_IssuTpCd", g_nSelectRow)
		'주식과 OTC만 수수료 발생
		if szIssuTpCd == "02" or szIssuTpCd == "08" then
			Dim sTARF_CODE, sCUST_GRADE, nFEE_AMT
			sTARF_CODE = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "TARF_CODE", 0 ))
			sCUST_GRADE = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_GRAD_CODE", 0 ))
			nFEE_AMT = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FEE_AMT", 0 ))
			
			grdList.SetCellData("bd_TariffCd"	, g_nSelectRow, sTARF_CODE 	)'요율코드
			grdList.SetCellData("bd_CusRateCd"	, g_nSelectRow, sCUST_GRADE	)'고객등급
			'수수료 대상 여부 판단
			if  nFEE_AMT > 0 then
				grdList.SetCellData("bd_Commisson", g_nSelectRow, "Y" 	)
			else
				grdList.SetCellData("bd_Commisson", g_nSelectRow, "N" 	)
			end if
			grdList.SetCellData("bd_CommissonD"	, g_nSelectRow, nFEE_AMT 	)'수수료
			grdList.SetCellData("bd_CommissonCall"	, g_nSelectRow, "Y" 	)'수수료조회여부
		else
			grdList.SetCellData("bd_TariffCd"		, g_nSelectRow, ""	)'요율코드
			grdList.SetCellData("bd_CusRateCd"		, g_nSelectRow, ""	)'고객등급
			grdList.SetCellData("bd_Commisson"		, g_nSelectRow, "N" 	)'수수료대상여부
			grdList.SetCellData("bd_CommissonD"		, g_nSelectRow, 0 	)'수수료
			grdList.SetCellData("bd_CommissonCall"	, g_nSelectRow, "Y" 	)'수수료조회여부
		end if
		
		Dim szExrsYN, nDmprAbleQty, szSptxYN, szIscdNm
		szExrsYN 	= grdList.GetCellData( "bd_ExrsYN", g_nSelectRow )
		nDmprAbleQty 	= CDbl(grdList.GetCellData( "bd_BuyAbleQty", g_nSelectRow ))
		szIscdNm 	= grdList.GetCellData( "bd_IscdNm", g_nSelectRow )
		'권리포기동의 체크
		If nDmprAbleQty > 0 Then
			If szExrsYN <> "" and szExrsYN <> null and szIscdNm <> "" and szIscdNm <> null Then 
				Form.OpenPopup( "mbbnk61100_p3" , szIscdNm.."★"..szExrsYN , "")
			End If
		Else
			'테이블 종목추가
			f_SetItem("insert", g_nSelectRow)
		End If
		
	'당일 매수결제여부 조회
	ElseIf szTranID == "obrts_tkwr_052r" Then
	
        Dim szRmndExstYn
        szRmndExstYn = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RMND_EXST_YN", 0 ))
		
        If g_szType == "H" And Trim(szRmndExstYn) == "Y" Then

            szBdIssuTpCd = grdList.GetCellData( "bd_IssuTpCd", g_nSelectRow )
			
            If szBdIssuTpCd == "02" Then '주식
                Form.OpenPopup("mbbnk61100_p9" , "" , "")
		
            ElseIf szBdIssuTpCd == "03" Then '채권
                Form.OpenPopup("mbbnk61100_p8" , "" , "")
                grdList.SetCellData("bd_Chk" , g_nSelectRow , "0") '20231026 JWH 여기로 위치이동
                f_SetItem("remove", g_nSelectRow) '20231026 JWH
            End If
	    
        End If
		
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'실행 서비스 모두 그리드 종목선택을 위한 서비스임
	grdList.SetCellData( "bd_Chk", g_nSelectRow, "0" ) '체크상태 변경
	g_nSelectRow = -1
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> NULL and szSubMsg <> "" Then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	Else
		Form.ShowAlert( "알림", szErrMsg )
	End If
End Sub

