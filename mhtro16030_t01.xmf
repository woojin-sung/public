'20240528 LES START 홈화면 연동
Dim gLinkFileName
gLinkFileName = ""
'20240528 LES END

'============================================================================
Sub Form_OnFormInit()
	SetLinkFile()
end Sub

'============================================================================
Sub Form_OnRefresh()
	SetLinkFile()
end Sub

'============================================================================
function _tonumber(data)
	return tonumber(data) or 0
end function

'============================================================================
function SetLinkFile()
	
	'-----------------------------------------------
	'20240528 LES START 홈화면 연동
	'-----------------------------------------------
	if gLinkFileName <> "" then
		SetComboIndex(gLinkFileName)
	else
		
		Dim nIndex
		nIndex = _tonumber(Combo0.currentindex)
		LinkForm0.linkfile = g_GridListDic1[nIndex][0]
	
	end if
	'20240528 LES END

	
end function

'_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-


'============================================================================
' 2017.11.22 - LSS : 연합인포맥스에서 마지막 선택 리스트가 팝업되도록 수정요청
'============================================================================
Function saveLastPopup(fileName)
	Form.SetEnvData( 1, "mhtro16030.lastscreen", fileName )
End Function

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	LinkForm0.linkfile = g_GridListDic1[iIndex][0]
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH" then
		Form.triggerEvent("LinkForm0", "SCREEN_REFRESH", "")
	
	'-----------------------------------------------
	'20240528 LES START 홈화면 연동
	'-----------------------------------------------
	elseif sEventName == "HOME" then
		
		sLinkFileName = Form.GetSharedData("HOME_RANKING_OVRS_GUBUN", true )
		
		if sLinkFileName <> "" then
			gLinkFileName = sLinkFileName
			SetComboIndex(sLinkFileName)
		end if
	
	'20240528 LES END 
	
	end if
End Sub

'============================================================================
' 20240528 LES START 홈화면 연동
'============================================================================
Function SetComboIndex(sFileName)

	'-----------------------------------------------
	' 상승/하락/거래량
	'-----------------------------------------------
	if sFileName == "mhtro16030_s01" then
		Combo0.currentindex = 0
		
	'-----------------------------------------------
	' 거래대금
	'-----------------------------------------------
	elseif sFileName == "mhtro16030_s10" then
		Combo0.currentindex = 9
	
	'-----------------------------------------------
	' 시가총액
	'-----------------------------------------------
	elseif sFileName == "mhtro16030_s17" then
		Combo0.currentindex = 16
	
	'-----------------------------------------------
	' 신고가
	'-----------------------------------------------
	elseif sFileName == "mhtro16030_s05" then
		Combo0.currentindex = 4
	end if

End Function

