'============================================================================
Function Tonum(sValue)
	return tonumber( sValue ) or 0
end Function

'============================================================================
' 거래소 ID 시장명으로 변환
'============================================================================
Function Transform_Market(sValue)
	if sValue == "HK" then
		return "홍콩"
	elseif sValue == "CN" then
		return "중국"
	elseif sValue == "JP" then
		return "일본"
	elseif sValue == "US" then
		return "미국"
	end if
end Function

'============================================================================
'[[ 폼 초기화 ]]
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szPopup
	szPopup = Form.LoadConfigData( "mhtro16061", "mhtro16061_p1" )
	
	If szPopup <> "1" Then
		Form.OpenPopup( "mhtro16061_p1", "" , "")
	End If
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	Form.SetInterestTitle("N")		'비활성화로 기본 세팅 20230722 HSZ
	
	'f_EventPopup()		'20240710 SWJ START
	if Form.GetOpenLinkData( ) == "0" or Form.GetOpenLinkData( ) == 0	then			'매수
		FormTab0.currenttabpageid = "page0"
	elseif Form.GetOpenLinkData( ) == "1" or Form.GetOpenLinkData( ) == 1	then		'매도
		FormTab0.currenttabpageid = "page1"
	end if
	ItemCode0.code = Form.GetSharedData("&ITEM_CODE", false)
	if Len(ItemCode0.code) > 0 then
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "InitCode", ItemCode0.code )
		Form.triggerEvent( "LinkForm2", "RequestData", ItemCode0.code)
	end if
	
	'20240710 SWJ START
	'팝업 위치 변경, 311r은 권리선반영 체크 이후에 진행
	f_EventPopup()
	'DATAMANAGER.RequestTranData("obpds_srvc_323r")
	'20240710 SWJ END
end Sub

'============================================================================
'[[ 폼탭 변경시 ]]
'============================================================================


'============================================================================
Sub Form_OnRefresh()
	ItemCode0_OnEditComplete(ItemCode0.code)
end Sub
 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH" then
		ItemCode0_OnEditComplete(ItemCode0.code)
			
	elseif sEventName == "REG_INTR" then ' 상반바 우측 관심추가 버튼 클릭 시 
		Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code , "" )
		
	elseif sEventName = "SCREEN_MENU" then							' 연결정보(상단 ...)
		
		if sParam = "REG_INTR" Then								' 관심종목등록
			Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code & "★" & ItemCode0.caption, "" )

		elseif sParam = "POP_UP1" Then							' 유의사항
			 Form.OpenPopup( "mhtro16061_p1", "" , "")

		end if
	
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	elseif sEventName == "TITLE_CLICK" then
		Form.OpenCommonDialog("SEARCH", "19", "")
	'20220922 SWJ END
	
	elseif (sEventName == "16061_BALANCE") then
		'20220510 LES START
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		Form.setOverStockItemCode(sParam)
	end if
end Sub



'============================================================================
Sub Form_OnLinkData(sKey, sValue)	
	if "&ITEM_CODE" == sKey then
		
		ItemCode0_OnEditComplete(sValue)
	end if
End Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	ItemCode0.code = sCode
	Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeCode", ItemCode0.code )
	Form.triggerEvent( "LinkForm2", "RequestData", ItemCode0.code)

End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if Len(ItemCode0.code) > 0 then
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeTab", ItemCode0.code )	
	end if
End Sub
