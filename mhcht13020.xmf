'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_bTranflag 
Dim gCurInd
Dim gMulCode 
Dim gCurInd
Dim g_sStockMode
Dim g_bTranFlag

g_sStockMode = "1"	' 수정주가 1: 0
gCurInd = 0
g_szChrtType = "D" 

gMulCode = { "", "", "", "" } 
gMulMarket = { "", "", "", "" }

Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북 '20160426 LKM 
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'화면 Open 시 차트 설정 및 Setting
function setChart()
	' 차트 값 불러오기
	szValue 			= Form.GetEnvData( "multichart_setting" )
	szValueMinTick 	= Form.GetEnvData( "multichart_settingmintick" )
	tempStock 		= Form.GetEnvData( "chart_stockmode" )
     
	if tempStock <> "" then
		g_sStockMode = tempStock
		ChartEx0.SetAdjustedStock(g_sStockMode)
	end if
	
     if szValue = "" then
		 Form.SetEnvData( "multichart_settingmintick", "2^001" )
	     g_sPeriod 	 = "001"
	     g_sPeriodType = "2"
	else
		temp = split(szValue, "^")
		
	     g_sPeriodType = temp[0]
	     g_sPeriod 	 = temp[1]
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")
		g_szMinType = temp1[0]
		g_szTicType = temp1[1]

	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "chart_min0" )
		szTic0 = Form.GetEnvData( "chart_tic0" )
	
		if szMin0 <> "" and szMin0 <> 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			g_szTicType = szTic0
		else 
			g_szTicType = "1"
		end if
		' 20190404 HWG END     
	     
	end if
	
	tmpIndex = null 
	if g_sPeriodType = "0" or g_sPeriodType = "1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		end if

	end if

	RadioGroup0.currentindex = g_TempIndex
end function

'============================================================================
Function RequestData()
	'--차트 실시간 연결 해제
	if g_bTranflag = false then
		Exit Function 
	end if
	
	szStockMode = "0"
	
	if g_sStockMode = "0" then
		szStockMode = "1"
	end if
	
	strCode = gMulCode[gCurInd]
	
'PENTA13 START => 2023.07.24(차트성능개선)
'	if strCode <> "" then
'		nHaveCodes = 0
'		for CurInd = 0 to 3
'			if gMulCode[CurInd] <> "" then
'				if CurInd <> gCurInd and strCode = gMulCode[CurInd] then
'					nHaveCodes = nHaveCodes + 1
'				end if
'			end if
'		next

'		if nHaveCodes < 1 then
'			szMarketType =  Form.GetItemCodeInfo( strCode, "market" ) 
'			if szMarketType = "W" then
'				DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, strCode )
'				DATAMANAGER.CancelRealData( "ohhts_elw_cntg" )
'			
'			'20180712 HAMWG START : K-OTC MTS 도입	
'			elseif szMarketType = "T" then
'				DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, strCode )
'				DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
'			'20180712 HAMWG END
'			
'			else			
'				DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, strCode )
'				DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
'			end if
'		end if
		
'	end if
'PENTA13 END

	if g_szChrtType = "A" then		'분차트
		if gCurInd = 0 then
			szTranID = "ohhts_5010_002r"
		else
			szTranID = "ohhts_5010_002r_"..Cstr(gCurInd)
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,szStockMode)	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, sTemp)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN", 0,"N")
			
		DATAMANAGER.RequestTranData(szTranID)

	elseif g_szChrtType == "T" then		'틱차트
		if gCurInd = 0 then
			szTranID = "ohhts_5010_003r"
		else
			szTranID = "ohhts_5010_003r_"..Cstr(gCurInd)
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
		sTic = Split(g_szTicType, "틱", -1, 1)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_CNT1" , 0, sTic[0])
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, "2")	
		DATAMANAGER.SetDataValue( 0,  szTranID, "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "N")
			
		DATAMANAGER.RequestTranData(szTranID)

	Else
		if gCurInd = 0 then
			szTranID = "ohhts_5010_001r"
		else
			szTranID = "ohhts_5010_001r_"..Cstr(gCurInd)
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0, szStockMode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,g_szChrtType)  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
		
		DATAMANAGER.RequestTranData(szTranID)	
			
	End If
	
end Function


'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	    g_sPeriod ="1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	    g_sPeriod ="1"
	    
	end if
	
	sPeriod = CInt( g_sPeriod)
	if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	'Form.SetSearchType ("2:3:5:6:15")	'20180712 HAMWG : K-OTC MTS 도입
	Form.SetSearchType ("29:1:5:6:3:15")	'20220922 SWJ START : 최근조회 탭 추가
	
	ChartEx0.SetLoadChart("multi")    
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END'
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_flagInit = false

	szStyle	= Form.LoadConfigData( "mhprc11000", "Style" )	'현재가 스타일
		
	If szStyle = "0" Then
		linkfmHoga.linkfile = "mhprc11000_s1"
	ElseIf szStyle = "1" Then
		linkfmHoga.linkfile = "mhprc11000_s2"
	ElseIf szStyle = "2" Then
		linkfmHoga.linkfile = "mhprc11000_s3"
	Else
		linkfmHoga.linkfile = "mhprc11000_s1"
	End If

	szData = Form.GetOpenLinkData()
	if szData <> "" then
		If Left(szData, 1) = "A" Then
			g_szItemCode = Right(szData, Len(szData) - 1)
		Else
			g_szItemCode = szData		
		End If		
	else
		g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	end if	
	
	if g_szItemCode = "" or g_szItemCode = null then
		g_szItemCode = "138040"	'메리츠금융지주	'PENTA13 START => 2023.09.04(차트성능개선)
		'g_szItemCode = "008560"
	end if
	
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )

	gMulCode[gCurInd] = g_szItemCode
	gMulMarket[gCurInd] = g_szItemMarket
	Form.SetItemCode(g_szItemCode)	
	'Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) ' 링크화면에 종목코드 던지기

	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
	Form.triggerEvent("linkfmHoga", "DEL_LEFTRIGHT", "")		' 20160405 상단 좌우 버튼 없이기
	
'PENTA13 START => 2023.07.20(차트성능개선)
	g_bTranflag = false
	setChart()
	g_bTranflag = true
'PENTA13 END

	RequestData()
	
	Form.SetRealBundle("1")		'PENTA13 START => 2023.09.12(플랫폼개선)
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetEnvData( 1,"multichart_setting" , g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"multichart_settingmintick" , g_szMinType.."^"..g_szTicType )
	Form.SetSharedData("&ITEM_STOCK", gMulCode[0])	' 첫번째 분할면 종목 넘겨주기
	
	ChartEx0.SetSaveChart("1")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )
		
		' 현재 선택된 분할 면의 종목코드와 받아온 종목코드가 같으면
		' 조회 하지 않음...
		' 받아온 종목 넣어주기

		if gMulCode[gCurInd]  <> g_szItemCode then	
			g_bTranflag = true
			RequestData()
		end if
		
		gMulCode[gCurInd] = g_szItemCode
		
	elseif sKey = "&ACR_ITEM" then	
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		Form.SetItemCode(g_szItemCode)
		
		' 현재 선택된 분할 면의 종목코드와 받아온 종목코드가 같으면
		' 조회 하지 않음...
		' 받아온 종목 넣어주기

		if gMulCode[gCurInd]  <> g_szItemCode then	
			g_bTranflag = true
			RequestData()
		end if
		
		gMulCode[gCurInd] = g_szItemCode
	end	if	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption(2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		RequestData()
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(RadioGroup0.GetRadioCaption(3),"틱")
		g_szTicType = tmpTic[0]
		PeriodSet(g_szChrtType)
		RequestData()
		
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet)
		PeriodSet(g_szChrtType)
		RequestData()
'
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO", false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
		
	elseif sKeyName = "OrientaitonClose" then
		ChartEx0.SetLoadChart("reload")
		
		g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)	
		Form.SetItemCode(g_szItemCode)
		g_bTranflag = true 
		setChart()
		RequestData()
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_ORIENTATION" Then
		Form.SetEnvData( 1,"multichart_setting" , g_sPeriodType.."^"..g_sPeriod )
		Form.SetEnvData( 1,"multichart_settingmintick" , g_szMinType.."^"..g_szTicType )
		
		Form.SetSharedData("&ITEM_STOCK", gMulCode[0])	' 첫번째 분할면 종목 넘겨주기
		ChartEx0.SetSaveChart("1")

		Form.OpenPopup( "mhcht13020_h1" , gMulCode[0] , "" )
		
	' 연결정보
	elseIf sEventName = "SCREEN_MENU" Then								
		If sParam = "REG_INTR" Then									' 관심종목등록
			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			
		ElseIf sParam = "REG_WATCHING" Then							' Watching종목등록
			Form.OpenFramePopup("mhprc11020_p1" , g_szItemCode , "")
	
		ElseIf sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If
		
	ElseIf sEventName = "sharedata" Then
	  Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
	
	'20220922 SWJ START : 종목선택 팝업 추가
	elseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "29:1:5:6:3:15", "")
	'20220922 SWJ END
	
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  		'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"

		PeriodSet(g_szChrtType)
		RequestData()
		
	elseif nIndex == 1 then  	'주/월
		g_flagMin = false
		g_flagTic = false

		if g_flagWeek == false   then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
			else
				g_szChrtType = "W"
			end if
			
			PeriodSet(g_szChrtType)
			RequestData()
			g_flagWeek = true
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_p3" , sTemp , "" )
		end if

	elseif nIndex == 2 then   	'분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin == false then
			tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
			RequestData()
			g_flagMin = true
			
		else
			Form.OpenPopup( "mhcht13000_p1" , g_szMinType , "" )
			
		end if
		
	elseif nIndex == 3 then   	'틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"

		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
			RequestData()

		else		
			Form.OpenPopup( "mhcht13000_p2" , g_szTicType , "" )
			
		end if
	end if	
	
End Sub

