'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	' 현재 선택 입력 받은 종목의 RealData 요청
	g_flagInit  = false
	tmpTranID = ""
	
	if gCurInd = 0 then
		if g_szChrtType = "A" then
			tmpTranID = "ohhts_5010_002r"	
		elseif g_szChrtType = "T" then
			tmpTranID = "ohhts_5010_003r"	
		else
			tmpTranID = "ohhts_5010_001r"
		end if
		
	else
		if g_szChrtType = "A" then
			tmpTranID = "ohhts_5010_002r_"..gCurInd	
		elseif g_szChrtType = "T" then
			tmpTranID = "ohhts_5010_003r_"..gCurInd	
		else
			tmpTranID = "ohhts_5010_001r_"..gCurInd
		end if
		
	end if
	
	if tmpTranID = szTranID then
		' 현재 선택된 분할 면의 아이템 코드를 넣어줌
		szItemCode = gMulCode[gCurInd]
		szMarkeType =  Form.GetItemCodeInfo( szItemCode, "market" )
		
		if szMarkeType = "W" then
			DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )	'PENTA13 START => 2023.07.18(차트성능개선)
		
		'20180712 HAMWG START : K-OTC MTS 도입	
		elseif szMarketType = "T" then
			DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, szItemCode )
		'20180712 HAMWG END
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )	'PENTA13 START => 2023.07.18(차트성능개선)
		
		else
			DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )	'PENTA13 START => 2023.07.18(차트성능개선)
			
		end if
		
	end if 
	
End Sub

'****************************************************************************
' Chart          
'****************************************************************************


'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	sPeriodType = ""
	
	Dim sMin, sTic
	' 차트 설정창에서 주기 값 넘어온 경우
	' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i ) '분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i ) '분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function 

 '============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	 sMinArr = {}
	 sTicArr = {}
	 sDataArr = {}
	 
	 g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
			Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )
	   next
   end if
   
end function

'============================================================================
'멀티 차트의 분할된 차트 선택시 처리 
'============================================================================
function ChartEx0_OnSelectedChart(nIndex, sData)
	gCurInd = nIndex -1
	
     if sData == "" then        '비어있는 영역 선택시
		Exit function
     end if
	
	' 차트 종목정보만 셋팅 해준다.
'	g_bTranflag = 0

     Data = split(sData, ";")
     if Cstr(Trim(Data[0])) = "" or Cstr(Trim(Data[0])) = null then
	   g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)	' 종목코드
	'   g_szItemCode = ""
     else
	     g_szItemCode     = Cstr(Trim(Data[0]))
     end if

     sName           = Cstr(Trim(Data[1]))
     g_sPeriodType   = Cstr(Trim(Data[2]))
     g_sPeriod       = Cstr(Trim(Data[3]))
     sPrice          = Cstr(Trim(Data[4]))
     sSign           = Cstr(Trim(Data[5]))
     sChange         = Cstr(Trim(Data[6]))
     sRate           = Cstr(Trim(Data[7]))
     sVolume         = Cstr(Trim(Data[8]))
     sRealKey        = Cstr(Trim(Data[9]))
     sMarket         = Cstr(Trim(Data[10]))

	gMulCode[gCurInd] = g_szItemCode

	g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode, "market")
	
	gMulMarket[gCurInd] = g_szItemMarket
	
	if g_szItemCode <> Form.GetSharedData("&ITEM_STOCK", 0) then
		Form.SetItemCode(g_szItemCode)
	end if
	
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			g_sPeriod = g_szTicType
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			g_sPeriod = g_szMinType
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			g_szChrtType = "D"			'PENTA13 START => 2023.09.04(차트성능개선)
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )	'PENTA13 START => 2023.09.04(차트성능개선)
			
		else								'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )	'PENTA13 START => 2023.09.04(차트성능개선)
		
		end if
	end if
	
     ChartEx0.SetPeriodType(g_sPeriodType)
     ChartEx0.SetPeriodTime(g_sPeriod)
	
	g_bTranFlag = false
	RadioGroup0.currentindex = g_TempIndex
	g_bTranFlag = true
end function

'============================================================================
'Chart 불러오기
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode   = Cstr(Trim(Data[0]))             '코드
	g_sPeriodType  = Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod      = Cstr(Trim(Data[2]))             '주기(1,5,...)
	
	sRefresh = Cstr(Trim(Data[3]))
	
	g_sMarket = Form.GetItemCodeInfo(g_szItemCode , "market")
	g_szItemMarket = g_sMarket

	nIndex = CInt(nIndex)

	gCurInd = nIndex
	
	gMulCode[gCurInd] = g_szItemCode
	gMulMarket[gCurInd] = Form.GetItemCodeInfo(g_szItemCode, "market")
	
	 ' 차트 초기화 이벤트
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		g_TempIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )

	else
		if g_sPeriodType = "0" then 
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
				
		elseif g_sPeriodType = "1" then
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szTicType = g_sPeriod
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
		
		else
			g_sPeriod = "1"
			
			if g_sPeriodType = "2" then
				g_TempIndex = 0
				g_szChrtType = "D"		'PENTA13 START => 2023.09.04(차트성능개선)
				
			elseif g_sPeriodType = "3" then
				g_TempIndex = 1
				g_flagWeek = false
				g_szChrtType = "W"
				RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
				
			else
				g_TempIndex = 1
				g_flagWeek = false
				g_szChrtType = "M"
				RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
				
			end if
		end if
	
	end if
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	g_bTranflag = false
	RadioGroup0.currentindex = g_TempIndex
	g_bTranflag = true
	
	RequestData()

end function

'============================================================================
'Chart 멀티 분할타입 변경시 해당 종목들의 실시간을 등록한다
'============================================================================
function ChartEx0_OnDivideChart(nIndexCnt, sCodeData, sRealData)
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG : K-OTC MTS 도입	
						
	sCode = split(sCodeData, ";")
	sReal = split(sRealData, ";")
	sMarket = ""

'PENTA13 START => 2023.07.18(차트성능개선)
	Dim nStkCnt, nElwCnt, nKotcCnt
	nStkCnt = 0
	nElwCnt = 0
	nKotcCnt = 0

	for i = 0 to nIndexCnt step 1
		if sCode[i] <> nil and sCode[i]<> "" then			
			tmpsCode = sCode[i]
			sMarket = Form.GetItemCodeInfo(tmpsCode , "market")
			gMulCode[i] = tmpsCode
			
			If g_szItemMarket = "W" Then
				DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nElwCnt, tmpsCode )
				nElwCnt = nElwCnt + 1
			
			ElseIf g_szItemMarket = "T" Then	'20180712 HAMWG START : K-OTC MTS 도입
				DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nKotcCnt, tmpsCode )
				nKotcCnt = nKotcCnt + 1
			
			Else
				DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nStkCnt, tmpsCode )
				nStkCnt = nStkCnt + 1

			End If
'PENTA13 ORGSRC
'			If g_szItemMarket = "W" Then
'				DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , tmpsCode )
'				szTranID = "ohhts_elw_cntg"
'			
'			'20180712 HAMWG START : K-OTC MTS 도입	
'			ElseIf g_szItemMarket = "T" Then
'				DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , tmpsCode )
'				szTranID = "ohhts_frbr_cntg"
'			'20180712 HAMWG END
'			
'			Else
'				DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , tmpsCode )
'				szTranID = "ohhts_stck_cntg"
'			End If
'PENTA13 END
		end if
	next
	
'PENTA13 START => 2023.07.18(차트성능개선)
	if nStkCnt >  0 then
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
	end if
	
	if nElwCnt >  0 then
		DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
	end if
	
	if nKotcCnt >  0 then
		DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
	end if
'PENTA13 ORGSRC
	'DATAMANAGER.RequestRealData(szTranID)
'PENTA13 END
	
end function

'============================================================================
' 차트 설정 개수 변경시
function ChartEx0_OnByNumber(Count)
   if #Count == 1 then
	   Count = "000"..Count
   elseif #Count == 2 then
	   Count = "00"..Count
   elseif #Count == 3 then
	   Count = "0"..Count
   end if

	g_sChartCnt = Count
	
	RequestData()
end function

'============================================================================
Sub ChartEx0_OnScrollEnd()
	szTranID = ""

	if g_szChrtType = "A" then
		if gCurInd = 0 then
			szTranID = "ohhts_5010_002r"
		else
			szTranID = "ohhts_5010_002r_"..Cstr(gCurInd)
		end if
		
	elseif g_szChrtType = "T" then
		if gCurInd = 0 then
			szTranID = "ohhts_5010_003r"
		else
			szTranID = "ohhts_5010_003r_"..Cstr(gCurInd)
		end if
		
	else
		if gCurInd = 0 then
			szTranID = "ohhts_5010_001r"
		else
			szTranID = "ohhts_5010_001r_"..Cstr(gCurInd)
		end if
		
	end if
	
	DATAMANAGER.RequestNextData(szTranID)	'PENTA13 START => 2023.07.20(차트성능개선)
	
End Sub
 
'============================================================================
function ChartEx0_OnChangeAdjustedStock(sData)	
	if g_sStockMode <> sData then
		g_sStockMode = sData
		Form.SetEnvData( 1,"chart_stockmode", g_sStockMode )
		g_bTranflag = true
		
		RequestData()
	end if

end function

'============================================================================
' 20181001 LES START OnRefresh처리
'============================================================================
Sub Form_OnRefresh()
	RequestData()
End Sub
'============================================================================
'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
'============================================================================
' Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub
