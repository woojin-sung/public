'============================================================================
Sub contHoga_hogaTbl_OnClick(lRow, lCol)
	If lRow = 20 Then
		Exit Sub
	End If

	If lCol = 2 Then
		If g_bBtnSellBuy = false Then
			Dim nPrice
			nPrice = CDbl( contHoga.hogaTbl.GetCellString(lRow, lCol) )
			
			' 스프레드의 경우 마이너스(-)도 주문 가능/ 2018.01.03 추가
			nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szItemCode, "innermarket"))
			If nzInnerMarket = 16 or nPrice > 0 Then			
				Dim nTop
				nTop = lRow * 42
				
				g_nPrice = nPrice
				Form.SetSharedData("FUTHYUN_RETURN" , g_nPrice)
		
				contHoga.btnSell.top = nTop
				contHoga.btnBuy.top  = nTop
				contHoga.lblLine.top  = nTop
				
				g_bBtnSellBuy = true
				SetBtnVisible( g_bBtnSellBuy )				
			End If
		Else
			g_bBtnSellBuy = false
			SetBtnVisible( g_bBtnSellBuy )
		End If
	End If	
End Sub

'============================================================================
Sub contHoga_btnBuy_OnClick()
	SendOrder( "0" )
	
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )
End Sub

'============================================================================
Sub contHoga_btnSell_OnClick()
	SendOrder( "1" )
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )	
End Sub

'============================================================================
Sub contHoga_lblLine_OnClick()
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )	
End Sub

'============================================================================
Sub contHoga_btnAlpha_OnClick()
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )	
End Sub

