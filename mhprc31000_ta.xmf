	<SCRIPT_INFO _len="20639" _ulen="19835" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가_호가
' 02. 화면설명 : 선옵현재가 호가탭화면
' 03. 작    성 : 2016.04.30 LJS
' 04. 참    고 : ohhts_3050_003r : 차트용 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

'파생 실시간 가격 제한
'0: 실시간 상하한 적용, 1: 실시간 상하한 미적용 종목, 2: 실시간 상하한 미적용 시간, 3: 실시간 상하한 KRX 적용 해제 시
Dim g_realLimit
Dim g_Rup

g_realLimit = 0
g_Rup = 1

Dim g_nPrice
	
Dim g_bBtnSellBuy
g_bBtnSellBuy = false


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function Change_Mini_Table()

'    If g_szItemMarket = "JF" Then
'	    tblRLimitF.visible = true
'	    tblRLimitO.visible = false
'    
'	Else
'	    tblRLimitF.visible = false
'	    tblRLimitO.visible = true
'	    
'	End if
	
    If g_realLimit = 0 Then
	    contHoga.tblLT1.visible = true
	    contHoga.tblLT2.visible = false
	    contHoga.tblLT3.visible = false
	    contHoga.tblLT4.visible = false

    ElseIf g_realLimit = 1 Then
	    contHoga.tblLT1.visible = false
	    contHoga.tblLT2.visible = true
	    contHoga.tblLT3.visible = false
	    contHoga.tblLT4.visible = false

    ElseIf g_realLimit = 2 Then
	    contHoga.tblLT1.visible = false
	    contHoga.tblLT2.visible = false
	    contHoga.tblLT3.visible = true
	    contHoga.tblLT4.visible = false

    ElseIf g_realLimit = 3 Then
	    contHoga.tblLT1.visible = false
	    contHoga.tblLT2.visible = false
	    contHoga.tblLT3.visible = false
	    contHoga.tblLT4.visible = true

    End If
	
End Function

'============================================================================
Function Change_RightUp()
	'20170823 NOHES START : visible 셋팅 전 처리방식으로 변경
    If g_Rup = 2 Then		'차트 추가시 3으로 처리
	    g_Rup = 1
	Else
	    g_Rup = g_Rup + 1
	End If
	'20170823 NOHES END
    Set_RightUp()
    

End Function

'============================================================================
Function Set_RightUp()
	if g_Rup = 1 then
		contHoga.tblInfo1.visible = true
		contHoga.ChartEx0.visible = false
	    
	elseif g_Rup = 2 then
		contHoga.tblInfo1.visible = false
		contHoga.ChartEx0.visible = true
	
	end if
    
End Function

'============================================================================
Function FormInit()
	
	'오른쪽 상단
	
'	ChartEx0.visible = false
	'왼쪽 하단
	contHoga.tblLT1.left = 0
	contHoga.tblLT2.left = 0
	contHoga.tblLT3.left = 0
	contHoga.tblLT4.left = 0
	
	contHoga.tblLT1.top = 421
	contHoga.tblLT2.top = 421
	contHoga.tblLT3.top = 421
	contHoga.tblLT4.top = 421
	
	contHoga.btnAlpha.left = 0	
	
	contHoga.tblExpectation.left = 0
	contHoga.tblExpectation.top  = 420
	
	
	contHoga.tblLT2.visible = false
	contHoga.tblLT3.visible = false
	contHoga.tblLT4.visible = false	
	contHoga.tblExpectation.visible = false

End Function

'============================================================================
Function RequestData()
	Change_Mini_Table()
	Set_RightUp()
	
	DATAMANAGER.RequestTranData( "ohhts_1001_017r" )
	DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
	DATAMANAGER.RequestTranData( "ohhts_3070_003r" )
	
	'차트
	DATAMANAGER.SetDataValue( 0, "ohhts_3070_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_3070_006r", "InBlock1", "FID_INPUT_ISCD" , 				0, g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_3070_006r", "InBlock1", "FID_INPUT_ETC_CLS_CODE" , 		0, "1")
	DATAMANAGER.SetDataValue( 0, "ohhts_3070_006r", "InBlock1", "FID_INPUT_HOUR_CLS_CODE" , 		0, "")
	DATAMANAGER.SetDataValue( 0, "ohhts_3070_006r", "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" , 	0, "Y")

	DATAMANAGER.RequestTranData("ohhts_3070_006r")	

end Function


Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth, szHAlign

	szDispdiff		= Form.LoadConfigData("mhprc31000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc31000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc31000", "Diplayrest"	)	'호가직전수량표시
	szPriceoutline	= Form.LoadConfigData("mhprc31000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc31000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldJan		= Form.LoadConfigData("mhprc31000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc31000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'설정된 값이 없을 경우 초기값 Insert 함.
	If szDispdiff = "" Then
		szDispdiff 		= "1"
		szJangraph 		= "1"
		g_szDiplayrest 	= "0"
		szPriceoutline 	= "1"
		szBoldHoga 		= "1"
		szBoldJan 		= "0"
		szBoldRest		= "0"
		
		Form.SaveConfigData("mhprc31000", "Dispdiff"		, szDispdiff		)	'호가등락률
		Form.SaveConfigData("mhprc31000", "Jangraph"		, szJangraph		)	'호가잔량그래프
		Form.SaveConfigData("mhprc31000", "Diplayrest"	, g_szDiplayrest	)	'호가직전수량표시
		Form.SaveConfigData("mhprc31000", "Priceoutline"	, szPriceoutline	)	'현재가 외곽선 표시
		Form.SaveConfigData("mhprc31000", "Style"		, "0"			)	'현재가 스타일
		Form.SaveConfigData("mhprc31000", "BoldHoga"		, szBoldHoga		)	'텍스트굵기 호가
		Form.SaveConfigData("mhprc31000", "BoldJan"		, szBoldJan		)	'텍스트굵기 호가잔량
		Form.SaveConfigData("mhprc31000", "BoldRest"		, szBoldRest		)	'텍스트굵기 직전대비
	End If
	

	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,90,48,73,45"
		Else
			szColWidth = "0,119,90,48,118,0"
		End If
		szHAlign = "2"
		
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,138,0,73,45"
		Else
			szColWidth = "0,119,138,0,118,0"
		End If		
		szHAlign = "1"
		
	End If	
	
'	Form.ShowAlert(g_szDiplayrest, szColWidth)	
	
	'호가등락률
	contHoga.hogaTbl.SetColumnWidth( szColWidth )
	
	'호가잔량그래프
	contHoga.hogaTbl.hojangraph = szJangraph
	
	'현재가 외곽선 표시
	contHoga.hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 19
		'호가
		If szBoldHoga = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 1 , "01")
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 4 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 1 , "00")
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 4 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		
		'호가 가로 정렬
		contHoga.hogaTbl.SetCellHAlign(i, 2, szHAlign)
	Next

End Function

'============================================================================
Function SendOrder( szTab )
	Dim szData

	' 전달내용/탭위치/종목코드/가격
	szData = "현재가" & "★" & szTab & "★" & g_szItemCode & "★" & g_nPrice
	
	Form.OpenScreen( "31030" , szData )

End Function

'============================================================================
Function SetBtnVisible( bValue )
	contHoga.btnSell.visible	= bValue
	contHoga.btnBuy.visible 	= bValue
	contHoga.lblLine.visible 	= bValue
	contHoga.btnAlpha.visible	= bValue
	
End Function

