'============================================================================
Sub Form_OnFormInitBefore()
	
	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "JF"			
	end if
	'20160705 NOHES END

	contHoga.ChartEx0.setChartType("minibong")
End Sub

'============================================================================
Sub Form_OnFormInit()

	FormInit()		'컨트롤 Init
	
	contHoga.grdCNTG.scrollenable = "0"
	contHoga.btnAlpha.left = 0
	
	SetBtnVisible( g_bBtnSellBuy )
	
	'환경설정 Load
	Set_HogaTable()
	
'	RequestData()	
End Sub


'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "JF"			
		end if
		'20160705 NOHES END
	
		g_bBtnSellBuy = false
		SetBtnVisible( g_bBtnSellBuy )	
		
		RequestData()
	end	if

End Sub



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "JF"			
		end if
		'20160705 NOHES END
		
		g_bBtnSellBuy = false
		SetBtnVisible( g_bBtnSellBuy )	
		
		RequestData()
		
	ElseIf sEventName = "HOGA_SETUP" Then
		Set_HogaTable()
	End If

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.CancelRealData( "ohhts_pric_extd" )
	DATAMANAGER.CancelRealData( "ohhts_pric_rstc" )
	
	DATAMANAGER.CancelRealData( "ohhts_sopt_antg" )
	DATAMANAGER.CancelRealData( "ohhts_sfut_antg" )
	
	DATAMANAGER.CancelRealData( "ohhts_sfut_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_sfut_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_sopt_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_sopt_cntg" )
	
	If szTranID = "ohhts_1001_017r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_017r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3070_003r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_003r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3070_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3070_009r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_009r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_009r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
'		DATAMANAGER.SetDataValue( 0, "ohhts_3070_009r", "InBlock1", "FID_INPUT_DATE1" 			, 0 ,  	)
	
	ElseIf szTranID = "ohhts_3070_013r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_013r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_013r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szCode
	
	szCode = DATAMANAGER.GetDataValue( 0, "ohhts_3070_003r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_sfut_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sfut_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_sfut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_sopt_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sopt_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_sopt_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_pric_extd" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_pric_rstc" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_pric_rstc", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	ElseIf szTranID = "ohhts_sfut_antg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sfut_antg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	ElseIf szTranID = "ohhts_sopt_antg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sopt_antg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ohhts_3070_001r" Then
		Dim nSDPR , nOPRC, nHPRC, nLPRC
		Dim szRstcYn
		
		nSDPR = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_SDPR" , 0 ) )	'기준가
		nOPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_OPRC" , 0 ) )	'시가
		nHPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_HPRC" , 0 ) )	'고가
		nLPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_LPRC" , 0 ) )	'저가
		szRstcYn = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_RLTM_PRC_RSTC_YN", 0 )	'실시간가격제한여부
	
		'호가컨트롤 속성		
'		contHoga.hogaTbl.startprice = nOPRC
'		contHoga.hogaTbl.highprice	 = nHPRC
'		contHoga.hogaTbl.lowprice	 = nLPRC
		
	    If szRstcYn <> "" Then
		    g_realLimit = CInt(szRstcYn)
		    Change_Mini_Table()
	    End If
	    
	End If
	
	If szTranID = "ohhts_3070_003r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_3070_003r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_3070_003r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		tblMaeDoSu.SetCellString( 0, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
			
		DATAMANAGER.RequestTranData( "ohhts_3070_009r" )
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
	End If
	
	If szTranID = "ohhts_3070_009r" Then
		DATAMANAGER.RequestTranData( "ohhts_3070_013r" )
	End If
	
    If szTranID = "ohhts_3070_013r" then
	    Dim szACNT_CODE
	    szACNT_CODE = DATAMANAGER.GetDataValue( 0, "ohhts_3070_013r", "OutBlock1", "FID_ANTC_CLS_CODE" , 0 )
	    
		
	    If szACNT_CODE <> "" then
		    If szACNT_CODE <> "0" then
			    
			    contHoga.tblExpectation.visible = true
			    contHoga.grdCNTG.visible = false
			    	contHoga.tblLT2.visible = false
				contHoga.tblLT3.visible = false
				contHoga.tblLT4.visible = false	
'				tblRLimitF.visible = false
'				tblRLimitO.visible = false
    
		    Else
			    
			    contHoga.tblExpectation.visible = false
			    contHoga.grdCNTG.visible = true
			    Change_Mini_Table()
		    End if
		End if
	    
		if g_szItemMarket = "JF" then
			DATAMANAGER.RequestRealData( "ohhts_sfut_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_sfut_antg" )
		    
		elseif g_szItemMarket = "JO" then
		    DATAMANAGER.RequestRealData( "ohhts_sopt_aspr" )
		    DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )
		    DATAMANAGER.RequestRealData( "ohhts_sopt_antg" )
		    
		end if
		
	    DATAMANAGER.RequestRealData( "ohhts_pric_rstc" )
	    DATAMANAGER.RequestRealData( "ohhts_pric_extd" )	'실시간 상하한가 표시
	End if
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mhprc31000_p4" then	
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
	End If	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

	If szTranID = "ohhts_sfut_aspr" Or szTranID = "ohhts_sopt_aspr" Then

		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		Dim szACNT_CODE
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN" , 0 )
		szACNT_CODE = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_HOUR_CLS_CODE" , 0 )
		
		tblMaeDoSu.SetCellString( 0, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
		
		
		If szACNT_CODE <> "" then
			 If szACNT_CODE <> "0" then
			    
			    contHoga.tblExpectation.visible = true
			    contHoga.grdCNTG.visible = false
			    	contHoga.tblLT2.visible = false
				contHoga.tblLT3.visible = false
				contHoga.tblLT4.visible = false	
'				tblRLimitF.visible = false
'				tblRLimitO.visible = false
    
		    Else
			    
			    contHoga.tblExpectation.visible = false
			    contHoga.grdCNTG.visible = true
			    Change_Mini_Table()
		    End if
	    End if
	    
	ElseIf szTranID = "ohhts_pric_rstc" then
		Dim szRstcYN
	    szRstcYN = DATAMANAGER.GetDataValue( 1, "ohhts_pric_rstc", "OutBlock1", "FIDR_RLTM_PRC_RSTC_YN" , 0 )
	    
	    If szRstcYN <> "" Then
		    g_realLimit = CInt( szRstcYN )
		    Change_Mini_Table()
	    End If
	End If
End Sub

