'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'20200331 HWG START : 고유MTS
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	edtFundCd.setFundPwCtl("edtPwd")
	'20200326 HWG END

	'20200331 HWG START : 고유MTS
	'20170726 HAMWG START : 야간선옵 현재가 스타일 연동
'	szStyle = Form.LoadConfigData("mhprc34000", "Style" ) '현재가 스타일 
'	
'	If szStyle = "0" Then
'		linkfm.linkfile = "mhprc34000_s2"
'	ElseIf szStyle = "1" Then
'		linkfm.linkfile = "mhprc34000_s1"
'	Else
'		linkfm.linkfile = "mhprc34000_s2"
'	End If
	'20170726 HAMWG END
	'20200326 HWG END

	Load_OrderSet()

	Dim szCd, szChk
	contHoga.scroll_pos = "vcenter"
	contHoga1.scroll_pos = "vcenter"
	
	'20170420 HAMWG START : 종목검색 타입 설정 (야간선옵)
	'20220307 HSZ 야간 위클리옵션 신규상장 (27 추가)
	Form.SetSearchType ("11:12:13:27")
	'20170420 HAMWG END
	
	
	szOpen = Form.GetOpenLinkData()
	' ----------------------------------------------------------------------
	' 다른화면에서 화면오픈시
	' ----------------------------------------------------------------------	
	if szOpen <> "" then
		'- 잔고	
		' 전달내용/탭위치/종목코드/수량
		' szData = "잔고" & "★" & szTab & "★" & szCd & "★" & szQty
			
		'- 미체결	
		' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
		' szData = "미체결" & "★" & szTab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd	

		'- 현재가화면 : 20160321 현재가에서 주문화면 오픈 추가
		' 전달내용/탭위치/종목코드/전달가격
		' szData = "현재가" & "★" & szTab & "★" & szCd & "★" & szPrc
		
		'- 기타화면
		' 전달내용/탭위치/종목코드
		' szData = "기타" & "★" & szTab & "★" & szCd
		
		tData = Split(szOpen, "★")

		' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
		if g_szCd == tData(2) then
			szChk = "0"
		else
			szChk = "1" 
		end if
		
		szCd = tData(2)
		
		' 폼탭변경(0:매수, 1:매도, 2:정정, 3:취소)
		if Trim(tData(1)) == "" then
			fmTab.currenttab = "0"
		else
			fmTab.currenttab = tData(1)
		end if
		
		Form.SetItemCode(szCd)							' 최초 화면진입시 종목코드 설정
		
		'20200331 HWG START : 고유MTS
		if tData(0) == "잔고" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "01000_BALANCE_RETURN", tData(3))	
		elseif tData(0) == "미체결" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "01000_CONTRACT_RETURN", tData(3) & "♥" & szChk)
		elseif tData(0) == "현재가" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "01000_HYUN_RETURN", tData(3))
		end if
		'20200331 HWG END
		
	' ----------------------------------------------------------------------
	' 최근조회종목
	' ----------------------------------------------------------------------			
	else
		szCd = Form.GetSharedData("&ITEM_CMEEUREX", 0)	' 최근조회종목
		Form.SetItemCode(szCd)							' 최초 화면진입시 종목코드 설정
		Form.triggerEvent("linkfm", "INIT_CODE", szCd)	' 링크화면에 종목코드 던지기
	end if
End Sub

'============================================================================
' Form_OnLinkData
'============================================================================ 
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		if g_szRtnO == "1" then	'잔고팝업에서 리턴한경우
			g_szRtnO = ""
			
			if g_szChangeInit == "1" then   '탭 변경시 가격 초기화
				edtOrgNo.caption = ""		'주문번호 초기화
			end if
		else
			edtOrgNo.caption = ""  '주문번호 초기화
		end if
		
		edtModTab.caption = ""
		edtCnlTab.caption = ""
		lblPrc.caption = ""
		
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		Init_Hoga(sValue)
		Request_Hoga(sValue)
	end	if	


End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'20200331 HWG START : 고유MTS
	' ----------------------------------------------------------------------
	' 매수/매도화면에서 잔고팝업 오픈 요청
	' ----------------------------------------------------------------------	
	if sEventName == "01000_BALANCE_OPEN" then
		Form.OpenFramePopup("nbnts01000_p5", edtFundCd.caption & "★"& edtPwd.encdata & "★" & "0", "")	'20200331 HWG : 고유MTS	
	' ----------------------------------------------------------------------
	' 정정/취소화면에서 미체결팝업 오픈 요청
	' ----------------------------------------------------------------------	
	elseif sEventName == "01000_CONTRACT_OPEN" then		
		' 계좌번호(8), 계좌일련번호(2), 탭구분
		Form.OpenFramePopup("nbnts01000_p6", edtFundCd.caption & "★" & edtPwd.encdata & "★" & fmTab.currenttab, "")	'20200331 HWG : 고유MTS
	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
'	elseif sEventName == "SCREEN_MENU" then	
'		if sParam == "POPUP1" then			' 예수금
'			Form.OpenPopup("mbtrf41030_pc", edtFundCd.caption , "")	'20200331 HWG : 고유MTS
'		elseif sParam == "POPUP2" then		' 주문가능
'			if Trim(lblPrc.caption) == "" then
'				Form.OpenPopup("mbtrf41030_pd", edtFundCd.caption & "★" & g_szCd & "★" & lblHyun.caption, "")		'20200331 HWG : 고유MTS
'			else
'				Form.OpenPopup("mbtrf41030_pd", edtFundCd.caption & "★" & g_szCd & "★" & lblPrc.caption, "")		'20200331 HWG : 고유MTS
'			end if
'		elseif sParam == "SET_SCREEN" then		' 주문설정
'			Form.OpenScreen("90000" , "1")
'		end if	
	'20200331 HWG END
	
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 잔고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "01000_BALANCE" or sKeyName == "01000_CONTRACT" then	'20200331 HWG : 고유MTS
		Dim szChk
		
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			g_szRtnO = "1"	' 20160316
			
			' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
			if g_szCd == tData(2) then
				szChk = "0"
			else
				szChk = "1" 
			end if
			
			' 폼탭변경(0:매수, 1:매도, 2:정정, 3:취소)
			if Trim(tData(1)) == "" then
				fmTab.currenttab = "0"
			else
				fmTab.currenttab = tData(1)
			end if
			
			Form.SetItemCode(tData(2))
	
			if sKeyName == "01000_CONTRACT" then	'20200331 HWG : 고유MTS
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3) & "♥" & szChk)
			else
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3))
			end if
		end if
	end if	
	
	'20200331 HWG START : 고유MTS
	if sKeyName = "FUNDINFO" then
	
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
		end if
	end if
	'20200331 HWG END
	
End Sub

'============================================================================
' Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	szCd = g_szCd
	g_szCd = ""
	Request_Hoga(szCd)	
End Sub

'============================================================================
' fmTab_OnTabChanged
'============================================================================
Sub fmTab_OnTabChanged(nCurrentTab)
	lblPrc.caption = ""
	'Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", g_szCd)	' 폼탭화면에 종목코드 던지기
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "CHANGE_TAB", g_szCd)	' 폼탭화면에 종목코드 던지기
	
	if nCurrentTab == 2 or nCurrentTab == 3 then
		if g_szAfterOrg == "1" then			' 주문연동시
			if nCurrentTab == 2 then
				if edtModTab.caption = "" or edtModTab.caption = "0" then
					'if Trim(edtModTab.caption) <> "" then
						Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption)		' 주문번호 연동
					'end if
				end if
				
				edtModTab.caption = "1"
			elseif nCurrentTab == 3 then
				if edtCnlTab.caption = "" or edtCnlTab.caption = "0" then
					'if Trim(edtCnlTab.caption) <> "" then				
						Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption)		' 주문번호 연동
					'end if
				end if
				
				edtCnlTab.caption = "1"
			end if
		end if
	end if
	
	Return_AutoPrice()
End Sub

'============================================================================
' tblSelect_OnClick
'============================================================================
Sub tblSelect_OnClick(lRow , lColumn)
	if lColumn == 1 then
		if g_szSlt == "HOGA" then
			g_szSlt = "SISE"
			tblSelect.SetCellString(0, 1, "시간별")
			
			lblTime.left = 1
			lblTime.visible = true
			If g_szMk == "CD" Then 
				grdList.visible 	= False
				contHoga.visible 	= False
				grdList0.visible 	= True
				contHoga1.visible	= False
				
				grdList0.left = 0
				contHoga1.left = 700
			Else
				grdList0.visible 	= False
				contHoga1.visible	= False
				grdList.visible 	= True
				contHoga.visible	= False
				
				grdList.left = 0
				contHoga.left = 700
			End If
			
		elseif g_szSlt == "SISE" then
			g_szSlt = "HOGA"
			tblSelect.SetCellString(0, 1, "호가")
			lblTime.left = 701
			lblTime.visible = false
				
			If g_szMk == "CD" Then 
				grdList.visible 	= False
				contHoga.visible 	= False
				grdList0.visible 	= False
				contHoga1.visible	= True
				
				grdList0.left = 700
				contHoga1.left = 0
			Else
				grdList0.visible 	= False
				contHoga1.visible	= False
				grdList.visible 	= False
				contHoga.visible	= True
				
				grdList.left = 700
				contHoga.left = 0
			End If
		end if
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_3050_002r" then	    
		DATAMANAGER.ClearInputData(0, "ohhts_3050_002r")
		
		DATAMANAGER.SetDataValue(0,"ohhts_3050_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0, g_szMk)
		DATAMANAGER.SetDataValue(0,"ohhts_3050_002r", "InBlock1", "FID_INPUT_ISCD"               , 0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_3050_004r" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "01000_HOGA", "")	'20200331 HWG : 고유MTS
			
		DATAMANAGER.ClearInputData(0, "ohhts_3050_004r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_3050_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_3050_001r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)

	
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
    if szTranID = "ohhts_3050_002r" then
	    '20170413 HAMWG START : 야간선옵주문 대응

	    if g_szMk = "CD" then
'		    DATAMANAGER.RequestRealData("ohhts_cusf_cntg") '20210712 HSZ 야간 미국달러선물 제도개편
		    DATAMANAGER.RequestRealData("ohhts_efut_cntg")
		'20210223 HSZ 야간선물 제도개편
	    elseif g_szMk = "CM" then
'		    DATAMANAGER.RequestRealData("ohhts_cmef_cntg")
		    DATAMANAGER.RequestRealData("ohhts_efut_cntg")
		'20210223 HSZ END
	    elseif g_szMk = "EM" then
		    DATAMANAGER.RequestRealData("ohhts_efut_cntg")
	    elseif g_szMk = "EO" or g_szMk = "EW" then '20220307 HSZ 야간 위클리옵션 신규상장(EW 추가)
		    DATAMANAGER.RequestRealData("ohhts_eopt_cntg")
	    end if
	    '20170413 HAMWG END
	    
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_3050_004r" then			
		DATAMANAGER.RequestTranData("ohhts_3050_002r")	' 현재가(시간별)
		DATAMANAGER.RequestTranData("ohhts_3050_001r")	' 현재가(시세&상세내역)
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		
		'20170413 HAMWG START : 야간선옵주문 대응
	    if g_szMk = "CD" then
'		    DATAMANAGER.RequestRealData("ohhts_cusf_aspr") '20210712 HSZ 야간 미국달러선물 제도개편
		    DATAMANAGER.RequestRealData("ohhts_efut_aspr")
		'20210223 HSZ START : 야간선물 제도개편
	    elseif g_szMk = "CM" then
'		    DATAMANAGER.RequestRealData("ohhts_cmef_aspr")
		    DATAMANAGER.RequestRealData("ohhts_efut_aspr")
		'20210223 HSZ END
	    elseif g_szMk = "EM" then
		    DATAMANAGER.RequestRealData("ohhts_efut_aspr")
	    elseif g_szMk = "EO" or g_szMk = "EW" then '20220307 HSZ 야간 위클리옵션 신규상장(EW 추가)
		    DATAMANAGER.RequestRealData("ohhts_eopt_aspr")
	    end if
	    '20170413 HAMWG END

	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
    elseif szTranID = "ohhts_3050_001r" then
		Return_AutoPrice()
		
    end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	'20170413 HAMWG START : 야간선옵주문 대응
	'20210223 HSZ START : 야간선물 제도개편
	' ----------------------------------------------------------------------
	' CME 선물 체결 자동갱신
'	' ----------------------------------------------------------------------	
'	if szTranID == "ohhts_cmef_cntg" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' CME 선물 호가 자동갱신
'	 ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_cmef_aspr" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cmef_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	'20210223 HSZ END
	' ----------------------------------------------------------------------
	' CME 달러선물 체결 자동갱신
	' ----------------------------------------------------------------------	
	'20210712 HSZ START 야간 미국달러선물 제도개편
'	if szTranID == "ohhts_cusf_cntg" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cusf_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
'	' ----------------------------------------------------------------------
'	' CME 달러선물 호가 자동갱신
'	' ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_cusf_aspr" then
'		DATAMANAGER.SetDataValue(1, "ohhts_cusf_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	'20210712 HSZ END
	' ----------------------------------------------------------------------
	' EUREX미니선물 체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_efut_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' EUREX미니선물 호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_efut_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_efut_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' EUREX옵션 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_eopt_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_eopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' EUREX옵션 호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_eopt_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_eopt_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' EUREX미니선물 예상체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_efut_antg" then
		DATAMANAGER.SetDataValue(1, "ohhts_efut_antg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' EUREX호가 예상체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_eopt_antg" then
		DATAMANAGER.SetDataValue(1, "ohhts_eopt_antg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 파생 가격제한폭확대발동
	' ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_pric_extd" then
'		DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)		
	end if
	'20170413 HAMWG END
	
End Sub

