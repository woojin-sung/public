'============================================================================
' 화 면 명 : 선물옵션주문
' 화면설명 : 선물옵션주문 메인화면
' 작    성 : 2016.02.01 ~ 2016.  .       ssang
'============================================================================
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------

Dim g_szChangeInit

'주문 환경
Dim g_szBuyPrc
Dim g_szSelPrc
Dim g_szModPrc

' 주문후 
Dim g_szAfterOrg
' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
g_szCd = ""
g_szMk = ""

Dim g_szSlt
g_szSlt = "HOGA"

Dim g_szType
g_szType = ""

Dim g_szRtnO
g_szRtnO = ""

Dim g_szToday

Dim g_csno
g_csno = "" 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		' 종목/탭 변경시 초기화
	g_szBuyPrc = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_BUYPRC")		' 선옵매수주문가격 자동입력
	g_szSelPrc = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_SELPRC")		' 선옵매도주문가격 자동입력
	g_szModPrc = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_MODPRC")		' 선옵정정주문가격 자동입력
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			' 원주문번호 자동입력

	' 선옵매수주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 선옵매도주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 선옵정정주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20170517 HAMWG START : 환경설정 기본값 변경
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170517 HAMWG END
	
End Function

'============================================================================
' Click_Hoga
'============================================================================
Function Click_Hoga(szClk)
	if Trim(szClk) <> "" and CDbl(szClk) <> 0 then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "01000_HOGA", szClk)	'20200331 HWG : 고유MTS
	end if
End Function

'============================================================================
' Request_Hoga
'============================================================================
Function Request_Hoga(szCd)
	if szCd <> g_szCd then
		g_szCd = szCd
		g_szMk = Form.GetItemCodeInfo(szCd, "market_night")

		DATAMANAGER.CancelRealData("ohhts_efut_antg")
		DATAMANAGER.CancelRealData("ohhts_efut_aspr")
		DATAMANAGER.CancelRealData("ohhts_efut_cntg")
		DATAMANAGER.CancelRealData("ohhts_eopt_antg")
		DATAMANAGER.CancelRealData("ohhts_eopt_aspr")
		DATAMANAGER.CancelRealData("ohhts_eopt_cntg")
'		DATAMANAGER.CancelRealData("ohhts_cmef_aspr")'20210223 HSZ 야간선물 제도개편
'		DATAMANAGER.CancelRealData("ohhts_cmef_cntg")'20210223 HSZ 야간선물 제도개편
'		DATAMANAGER.CancelRealData("ohhts_cusf_aspr")'20210712 HSZ 야간 미국달러선물 제도개편
'		DATAMANAGER.CancelRealData("ohhts_cusf_cntg")'20210712 HSZ 야간 미국달러선물 제도개편
			
		DATAMANAGER.RequestTranData("ohhts_3050_004r")	' 현재가(호가)
	else
		' 변경사항이 전혀 없을때
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "NO_RETURN", "")	
	end if
End Function

'============================================================================
' Return_AutoPrice : 가격 자동연동(화면실행 or 탭변경시)
'============================================================================
Function Return_AutoPrice()
	Dim szTab, szAuto
	
	if g_szChangeInit == "1" then		' 20160324 종목/탭 변경시 초기화 사용시는 가격자동연동 제외
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AUTO_PRICE", "")
		Exit Function
	end if
	
	szTab = CStr(fmTab.currenttab)

	if szTab <> "3" then
		if szTab == "0" then
			szAuto = g_szBuyPrc
		elseif szTab == "1" then
			szAuto = g_szSelPrc
		elseif szTab == "2" then
			szAuto = g_szModPrc
		end if

		Select Case Trim(szAuto)
			Case "1"											' 매도5호가
				szPrc = contHoga.hogaTbl.GetCellString( 0, 0)
			Case "2"											' 매도4호가
				szPrc = contHoga.hogaTbl.GetCellString( 1, 0)
			Case "3"											' 매도3호가
				szPrc = contHoga.hogaTbl.GetCellString( 2, 0)
			Case "4"											' 매도2호가
				szPrc = contHoga.hogaTbl.GetCellString( 3, 0)
			Case "5"											' 매도1호가
				szPrc = contHoga.hogaTbl.GetCellString( 4, 0)
			Case "6"											' 현재가
				szPrc = lblHyun.caption					
			Case "7"											' 매수1호가
				szPrc = contHoga.hogaTbl.GetCellString(5, 0)
			Case "8"											' 매수2호가
				szPrc = contHoga.hogaTbl.GetCellString(6, 0)
			Case "9"											' 매수3호가
				szPrc = contHoga.hogaTbl.GetCellString(7, 0)
			Case "10"										' 매수4호가
				szPrc = contHoga.hogaTbl.GetCellString(8, 0)
			Case "11"										' 매수5호가
				szPrc = contHoga.hogaTbl.GetCellString(9, 0)
			Case "12"										' 상한가
				szPrc = lblHigh.caption
			Case "13"										' 하한가
				szPrc = lblLow.caption
			Case Else										' 미적용 및 기타에러
				szPrc = ""
		End Select		

		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AUTO_PRICE", szPrc)
	end if
End Function

'============================================================================
' Init_Hoga
'============================================================================
Function Init_Hoga(szCd) 
	
	szMk = Form.GetItemCodeInfo(szCd, "market_night")
	
	if g_szSlt == "SISE" then
		tblSelect.SetCellString(0, 1, "시간별")
		lblTime.left = 1
		lblTime.visible = true
		If szMk = "CD" Then 
			grdList.visible 	= False
			contHoga.visible 	= False
			grdList0.visible 	= True
			contHoga1.visible	= False
			
			grdList0.left = 0
			contHoga.left = 700
			grdList.left = 700
			contHoga1.left = 700
		Else
			grdList0.visible 	= False
			contHoga1.visible	= False
			grdList.visible 	= True
			contHoga.visible	= False
			
			grdList.left = 0
			contHoga.left = 700
			contHoga1.left = 700
			grdList0.left = 700
		End If
			
	elseif g_szSlt == "HOGA" then
		tblSelect.SetCellString(0, 1, "호가")
		lblTime.left = 701
		lblTime.visible = false
			
		If szMk = "CD" Then 
			grdList.visible 	= False
			contHoga.visible 	= False
			grdList0.visible 	= False
			contHoga1.visible	= True
			
			grdList0.left = 700
			contHoga1.left = 0
			contHoga.left = 700
			grdList.left = 700
		Else
			grdList0.visible 	= False
			contHoga1.visible	= False
			grdList.visible 	= False
			contHoga.visible	= True
			
			grdList.left = 700
			contHoga.left = 0
			contHoga1.left = 700
			grdList0.left = 700
		End If
	end if

End Function


