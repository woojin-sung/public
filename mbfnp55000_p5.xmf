' 20160317 수량 Max : 8 (전요셉과장)

'============================================================================
' 화 면 명 : 주식주문_수량입력창
' 화면설명 : 주식주문 수량입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szMk, g_szReceive
g_szMk, g_szReceive = "", ""


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, szCalc, szUnit, szCut, szData, szChk
	Dim nUnit, nLen, nResult
	
	g_szReceive = ""
	g_szMk = Form.GetCtlProp("#edtMk", "caption")
	szQty = edtQty.caption

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szQty) <> "" then
		if CDbl(szQty) >= 99000000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	if g_szMk == "W" then
		if Trim(szQty) == "" then
			szQty = 10
		else			
			nUnit = 10
			
			nLen = Len(nUnit)
			
			if nGbn == 0 then
				szQty = CDbl(szQty) + nUnit
				nResult = CDbl(szQty) Mod 10
				
				if nResult <> 0 then
					szQty = CDbl(szQty) - nResult
				end if
			else			
				if CDbl(szQty) == 0 then
					Exit Function
				else
					szQty = szQty - nUnit
					nResult = CDbl(szQty) Mod 10
					
					if nResult <> 0 then
						nResult = 10 - nResult
						szQty = CDbl(szQty) + nResult
					end if
				end if
			end if
		end if
	else
		if Trim(szQty) == "" then
			if nGbn == 0 then
				szQty = 1
			else
				Exit Function
			end if
		else
			if Len(szQty) = 1 or Len(szQty) = 2 then
				nUnit = 1
			else
				nCnt = Len(szQty)-1
				
				For i = 0 to nCnt-1
					if i == 0 then
						szUnit = "1"
					else
						szUnit = szUnit & "0"
					end if
				Next
				
				nUnit = CDbl(szUnit)
			end if
		
			if nGbn == 0 then
				szQty = CDbl(szQty) + nUnit
				nResult = CDbl(szQty) Mod nUnit
				
				if nResult <> 0 then
					szQty = CDbl(szQty) - nResult
				end if
			elseif nGbn == 1 then
				if CDbl(szQty) == 0 then
					Exit Function
				else		' 20160317 추가사항 적용
					szQty = szQty - nUnit
					nResult = CDbl(szQty) Mod nUnit

					if nResult <> 0 then
						nResult = nUnit - nResult
						szQty = CDbl(szQty) + nResult
					elseif nResult == 0 then
						if Len(nUnit) > 1 then
							szQty = szQty + nUnit
							szCut = Mid(szQty, 1, 1)
							
							if szCut == "1" then
								szChk = Mid(szQty, 2, Len(szQty))

								For i = 0 to Len(szChk)-1
									szData = Mid(szChk, i+1, 1)

									if szData <> "0" then
										szQty = szQty - nUnit
										Exit For
									end if
									
									if i == Len(szChk)-1 then
										nUnit = Left(nUnit, Len(nUnit)-1)
										szQty = szQty - nUnit
									end if
								Next
							else
								szQty = szQty - nUnit
							end if
						end if
					end if
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szQty
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtQty.caption = nPlus
	else
		szQty = edtQty.caption
		
		if nGbn == 1 then
			if Trim(szQty) == "" then
				szQty = 0
			end if
			
			szQty = CDbl(szQty) + nPlus
		else
			szQty = szQty & nPlus
		end if
		
		Sum_Qty(szQty)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szQty
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtQty.caption = ""
	else	
		szQty = edtQty.caption
		
		if Len(edtQty.caption) > 0 then
			szQty = edtQty.caption & szPlus
			
			Sum_Qty(szQty)
		end if
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	'if Len(szData) < 16 then
	if Len(szData) < 9 then		' Max 8(20160317 전요셉과장)
		if CStr(szData) == "0" or CStr(szData) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szData
		end if
	end if
End Function	


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
