	<SCRIPT_INFO _len="2845" _ulen="2785" >
'============================================================================
' 2022.02.23: 김수진 : 국내/해외 CFD 계좌유형 안내
'============================================================================
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()
    
	imgBg.imgpath = "alpha128.png"   
	Dim szData
	szData = Trim(Form.GetOpenLinkData())
 	
	If szData <> "" and szData <> null Then
		Dim tList
		tList = Split(szData, "★")
		
		if UBOUND(tList) < 1 then
			exit sub
		end if
		
		Dim nCount,nLine, nTop
		nCount   = tonumber(tList(0)) '안내 내용 갯수
		nTop = 0
		For i = 0 to nCount-1
			nLine = tonumber(tList(i*2+1))
			Form.SetCtlProp( "contContent.lblContent"..i, "height", 15*nLine+7)
			Form.SetCtlProp( "contContent.lblContent"..i, "height", 15*nLine+7)
			nTop = nTop + (15*nLine+7) + 10
			If i <> nCount-1 Then
				Form.SetCtlProp( "contContent.lblContent"..i+1, "top", nTop)
				Form.SetCtlProp( "contContent.imgdot"..i+1, "top", nTop)
			End If
			Form.SetCtlProp( "contContent.lblContent"..i, "caption", tList(i*2+2))
			Form.SetCtlProp( "contContent.lblContent"..i, "visible", True)
			Form.SetCtlProp( "contContent.imgdot"..i, "visible", True)
		Next 
		contContent.height = nTop
		
		'647 : 화면 길이
		'75 : contContent.top - imgBox.top 
		'60 : btnOK.height
		imgBox.height = 75 + nTop + 60
		imgBox.top = CInt((647 - (75 + nTop + 60))/2)	
		lblTitle.top = CInt((647 - (75 + nTop + 60))/2)
		imgBgTitle.top = CInt((647 - (75 + nTop + 60))/2) + 15	'15 : imgBgTitle.top - imgBox.top	
		
		contContent.top = CInt((647 - (75 + nTop + 60))/2) + 75	
		imgClose. top = CInt((647 - (75 + nTop + 60))/2) + 15		'15 : imgClose.top - imgBox.top
		btnOK.top = CInt((647 - (75 + nTop + 60))/2) + 75 + nTop
	End If
	
End Sub

'============================================================================
' imgBg_OnClick() : 닫기
'============================================================================
'Sub imgBg_OnClick()
