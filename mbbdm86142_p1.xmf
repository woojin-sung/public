		<IMAGE name="imgBox" imgpath="popup_bg_common.9" ly_vert="31,90,315,450,1" />
		<IMAGE name="imgBgTitle" imgpath="pop_header.9" ly_vert="31,105,315,40,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="안내" halign="1" ly_vert="52,90,275,60,1" />
		<IMAGE name="imgClose" enable="0" visible="0" imgpath="icon_main_13" ly_vert="306,105,21,21,0" />
		<BUTTON name="btnOK" caption="확인" fontsize="2" fontstyle="01" btnimage="btn_22.9" ly_vert="31,490,315,60,1" />
		<CONTAINER name="contContent" scroll_pos="0,0" ly_vert="31,165,315,302,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblContent0" visible="0" fontsize="-1" multiline="1" ly_vert="20,0,295,22,0" />
				<LABEL name="lblContent1" visible="0" fontsize="-1" multiline="1" ly_vert="20,40,295,22,0" />
				<LABEL name="lblContent2" visible="0" fontsize="-1" multiline="1" ly_vert="20,80,295,22,0" />
				<LABEL name="lblContent3" visible="0" fontsize="-1" multiline="1" ly_vert="20,120,295,22,0" />
				<LABEL name="lblContent4" visible="0" fontsize="-1" multiline="1" ly_vert="20,160,295,22,0" />
				<LABEL name="lblContent5" visible="0" fontsize="-1" multiline="1" ly_vert="20,200,295,22,0" />
				<IMAGE name="imgdot0" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,0,18,18,0" />
				<IMAGE name="imgdot1" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,40,18,18,0" />
				<IMAGE name="imgdot2" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,80,18,18,0" />
				<IMAGE name="imgdot3" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,120,18,18,0" />
				<IMAGE name="imgdot4" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,160,18,18,0" />
				<IMAGE name="imgdot5" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,200,18,18,0" />
