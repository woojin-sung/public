'--===========================================================================
' 01. 화 면 명 : CFD한도
' 02. 화면설명 : CFD한도_종목한도증액신청
' 03. 작    성 : 2022.05.19 KSJ 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szState			'신청/해지 여부

Dim g_nChoiceRow		'선택한 Row
Dim g_nBuyAbleAmt 	'매수가능금액
Dim g_nDealStndExrt	'매매기준환율
Dim g_szCurrCode		'선택종목 통화코드
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()

	tblState.SetCellString( 2 , 1, "")	'통화코드
	tblState.SetCellString( 3 , 1, "")	'매수가능금액
	tblState.SetCellString( 4 , 1, "")	'보유잔고금액
	tblState.SetCellString( 6 , 1, "")	'기준환율
	tblState.SetCellString( 7 , 1, "")	'원화환산금액
	tblState.SetCellString( 8 , 1, "")	'신청상태

	edtApltLimt.caption = ""	'추가신청한도
	grdList.SetClear()		'신청내역
	
	edtIscd.caption = ""	'종목코드
	lblIscdNm.caption = ""	'종목명
	
	g_nBuyAbleAmt = 0		'매수가능금액
	g_nDealStndExrt = 0 	'매매기준환율
	g_nChoiceRow = -1		'선택한 Row
End Function
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )

	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	f_ClearData()
	edtPswd.caption = ""
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	f_ClearData()
	edtPswd.caption = ""
End Sub
'============================================================================
' edtPswd_OnEditComplete() : 비밀번호 입력완료
'============================================================================
Sub edtPswd_OnEditComplete()
	f_ClearData()
	DATAMANAGER.RequestTranData( "obtrc_limt_008r" ) 
End Sub

'============================================================================
' grdList_OnScrollEnd() : Next 조회
'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtrc_limt_008r") == true then
		DATAMANAGER.RequestNextData("obtrc_limt_008r")
	end if
End Sub

'============================================================================
' grdList_OnClickUp(lRow, szCellID)
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_Del" Then
		g_szState = "D"
		g_nChoiceRow = CInt(lRow)
		DATAMANAGER.RequestTranData( "obtrc_limt_009a" ) '총한도증액신청
	End If
End Sub

'============================================================================
' edtApltLimt_OnClick() : 추가신청한도 입력
'============================================================================
Sub edtApltLimt_OnClick()
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	If edtIscd.caption == "" or edtIscd.caption == null Then
		Form.ShowAlert( "알림", "종목을 선택해주세요." )
		Exit Sub
	End If
End Sub
'============================================================================
Sub edtApltLimt_OnEditComplete()
	'원화환산금액 = 추가신청한도 * 매매기준환율
	If edtApltLimt.caption <> "" and edtApltLimt.caption <> null Then
		tblState.SetCellString( 7 , 1, tonumber(edtApltLimt.caption) * g_nDealStndExrt )	
	End If
End Sub

'============================================================================
' btnAplt_OnClick() : 신청
'============================================================================
Sub btnAplt_OnClick()
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	If edtIscd.caption == "" or edtIscd.caption == null Then
		Form.ShowAlert( "알림", "종목을 선택해주세요." )
		Exit Sub
	End If
	
	If edtApltLimt.caption == "" or edtApltLimt.caption == 0 Then
		Form.ShowAlert( "알림", "추가신청한도를 입력해주세요." )
		Exit Sub
	End If
	
	g_szState = "I"
	DATAMANAGER.RequestTranData( "obtrc_limt_009a" ) '총한도증액신청
End Sub


'============================================================================
' edtIscd_OnEditComplete() : 종목코드입력
'============================================================================
Sub edtIscd_OnEditComplete()
	'초기화------------------------------------------
	tblState.SetCellString( 2 , 1, "")	'통화코드
	tblState.SetCellString( 3 , 1, "")	'매수가능금액
	tblState.SetCellString( 4 , 1, "")	'보유잔고금액
	tblState.SetCellString( 6 , 1, "")	'기준환율
	tblState.SetCellString( 7 , 1, "")	'원화환산금액
	tblState.SetCellString( 8 , 1, "")	'신청상태
	lblIscdNm.caption = ""	'종목명
	g_nBuyAbleAmt = 0	'매수가능금액
	g_nDealStndExrt = 0	'매매기준환율
	edtApltLimt.caption = ""
	
	If edtIscd.caption <> "" and edtIscd.caption <> null Then
		Dim szMarketType
		szMarketType = Form.GetItemCodeInfo(edtIscd.caption, "market")
	
		If edtIscd.caption ~= "" and edtIscd.caption ~= null and len(edtIscd.caption) > 0 Then
			if szMarketType == "J" and Left(edtIscd.caption,1) <> "A"Then
			    edtIscd.caption = "A"..edtIscd.caption
			else 
			    edtIscd.caption = edtIscd.caption
			End if
		End if
		DATAMANAGER.RequestTranData( "obtrc_limt_005r" )	'CFD 종목별한도관리다건조회
	End If
End Sub

'============================================================================
' imgSearch_OnClick() : 종목선택팝업 호출
'============================================================================
Sub imgSearch_OnClick()
	Form.OpenPopup( "mbtrc12000_p1" , "" , "" )
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'종목정보선택팝업------------------------------------------
	'서비스 호출 순서 
	'obtrc_limt_005r(팝업에서 이미 호출함) > obtrc_limt_003r > obtrc_limt_012r
	If sKeyName == "mbtrc12000_p1" Then 
		'초기화------------------------------------------
		tblState.SetCellString( 2 , 1, "")	'통화코드
		tblState.SetCellString( 3 , 1, "")	'매수가능금액
		tblState.SetCellString( 4 , 1, "")	'보유잔고금액
		tblState.SetCellString( 6 , 1, "")	'기준환율
		tblState.SetCellString( 7 , 1, "")	'원화환산금액
		tblState.SetCellString( 8 , 1, "")	'신청상태
		edtIscd.caption = "" 	'종목코드
		lblIscdNm.caption = ""	'종목명
		g_nBuyAbleAmt = 0	'매수가능금액
		g_nDealStndExrt = 0	'매매기준환율
		edtApltLimt.caption = ""
		
		If Trim(sRet) <> "" and Trim(sRet) <> null Then
			'종목셋팅
			Dim tItem
			tItem = Split(sRet, "★")
			if UBound(tItem) < 1 then
				Form.ShowAlert( "알림", "종목을 다시 선택해주세요." )
				exit sub
			end if
			edtIscd.caption = tItem(0)			'종목코드
			lblIscdNm.caption = tItem(1)		'종목명
			tblState.SetCellString( 2 , 1, tItem(2))	'통화코드
			g_szCurrCode = tItem(2)                      '(v001) 추가
			
			DATAMANAGER.RequestTranData( "obtrc_limt_012r" )	 
		Else
			Form.ShowAlert( "알림", "종목을 다시 선택해주세요." )
		End If
	End If	
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
	
	If szTranID == "obtrc_limt_008r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 	, 0 , cmbAcct.total	) '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 	, 0 , cmbAcct.sequence ) '계좌일련번호	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" 		, 0 , szACNT_PWD 		) '비밀번호	
		
	'CFD_종목별한도종목다건조회
	ElseIf szTranID == "obtrc_limt_005r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"		, 0 , "2"			) '처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 			, 0 , edtIscd.caption 	) '종목번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "KOR_ISSU_ABWR_NAME", 0 , ""				) '종목명
	
	ElseIf szTranID == "obsim_oscm_326r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 			, 0 , edtIscd.caption 	) '종목코드
		
	'CFD고객한도조회
	ElseIf szTranID == "obtrc_limt_012r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"		, 0 , "2"			) '처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 			, 0 , cmbAcct.total	) '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 			, 0 , cmbAcct.sequence ) '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 			, 0 , edtIscd.caption 	) '종목코드
		
	'CFD 종목별한도관리다건조회
	ElseIf szTranID == "obtrc_limt_003r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 			, 0 , edtIscd.caption 	) '종목코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CFD_EXCH_CODE" 	, 0 , "%" 			) '종목코드

	'CFD고객별협의한도신청
	ElseIf szTranID == "obtrc_limt_009a" Then
		If g_szState == "I" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISSU_SPLM_LIMT_APLT_AMT" 	, 0 , edtApltLimt.caption	) '추가신청한도
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" 		, 0 , Form.GetSharedData("&HOST_DATE", false )) '시작일자
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" 		, 0 , "99991231"			) '종료일자
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APRV_APLT_CNTT" 	, 0 , ""					) '승인신청내용
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 			, 0 , edtIscd.caption 		) '종목코드
		Else
			DIm szSrno, szCsno, szIscd
			szSrno = grdList.GetCellData( "bd_Srno", g_nChoiceRow) 
			szCsno = grdList.GetCellData( "bd_Csno", g_nChoiceRow) 
			szIscd = grdList.GetCellData( "bd_Iscd", g_nChoiceRow) 
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO"		, 0 , szCsno	)	'고객번호
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SRNO" 	, 0 , szSrno	)	'일련번호
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 	, 0 , szIscd 	)	'종목코드
		End If
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"	, 0 , g_szState		)	'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total	)	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" 			, 0 , szACNT_PWD 		)	'비밀번호

	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtrc_limt_008r" Then
		If tonumber(grdList.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = grdList.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1		
				Dim szAprvYN, szDelYN
				szAprvYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APRV_YN" 	, i)
				szDelYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DEL_YN" 	, i)
				
				grdList.SetCellData( "bd_Del",  i, "해지" )	'해지버튼 Caption 설정
				If szDelYN == "Y" Then
					grdList.SetCellEnable( "bd_Del", nRowCnt + i, false )
					grdList.SetCellFgColor( "bd_Del", nRowCnt + i, "100" )
					grdList.SetCellData( "bd_DelYN", nRowCnt + i , "해지")	' 해지여부
				ElseIf szDelYN == "N" Then
					'버튼문구 정상에서 "-" 로 처리
					grdList.SetCellData( "bd_DelYN", nRowCnt + i , "-")	' 해지여부
				End If
				
				'정상이여도 승인일 경우에만 해지버튼 활성화
				If szAprvYN == "Y" Then
					grdList.SetCellData( "bd_AprvYN", nRowCnt + i , "승인")	' 승인여부
				ElseIf szAprvYN == "N" Then
					grdList.SetCellEnable( "bd_Del", nRowCnt + i, false )
					grdList.SetCellFgColor( "bd_Del", nRowCnt + i, "100" )
					grdList.SetCellData( "bd_AprvYN", nRowCnt + i , "승인대기")	' 승인여부
				ElseIf szAprvYN == "C" Then
					grdList.SetCellEnable( "bd_Del", nRowCnt + i, false )
					grdList.SetCellFgColor( "bd_Del", nRowCnt + i, "100" )
					grdList.SetCellData( "bd_AprvYN", nRowCnt + i , "반려")	' 승인여부
				End If
			Next
	    End If
	    
	'CFD_종목별한도종목다건조회
	ElseIf szTranID == "obtrc_limt_005r" Then
		Dim nCnt
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0 , szTranID , "OutBlock1" ))
		
		If nCnt > 0 Then
			g_szCurrCode = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "CRCD" , 0 )
			
			DATAMANAGER.RequestTranData( "obtrc_limt_012r" )
		End If
	
	'CFD고객한도조회
	ElseIf szTranID == "obtrc_limt_012r" Then
		Dim nCnt
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" ))
		If nCnt > 0 Then
			'보유잔고금액 SET
			Dim nCustRmndStndExhsAmt, nCustNcntExhsAmt, nCustTotalExhsAmt
			nCustRmndStndExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2", "CUST_ISSU_RMND_STND_EXHS_AMT" , 0 )) '고객종목잔고기준소진금액
			nCustNcntExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2", "CUST_ISSU_NCNT_EXHS_AMT" , 0 )) '고객종목미체결소진금액
			nCustTotalExhsAmt = nCustRmndStndExhsAmt + nCustNcntExhsAmt
			
			'통화코드에 따라서 소숫점 다르게 하여 표기
			if g_szCurrCode == "KRW" or g_szCurrCode == "JPY" then
				tblState.SetCellString( 4 , 1, FormatNumber(nCustTotalExhsAmt, 0) )	'보유잔고금액
			else
				tblState.SetCellString( 4 , 1, FormatNumber(nCustTotalExhsAmt, 2) )	'보유잔고금액
			end if
			
			'매수가능금액 SET
			Dim nCustSplmLimtAmt
			nCustSplmLimtAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2", "CUST_ISSU_SPLM_LIMT_AMT" , 0 )) '고객종목추가한도금액
			
			g_nBuyAbleAmt = nCustSplmLimtAmt - nCustRmndStndExhsAmt - nCustNcntExhsAmt	
			DATAMANAGER.RequestTranData( "obtrc_limt_003r" )
			
			'신청상태
			Dim szAPRV_CLS_CODE
			Dim szStatusNm
			szAPRV_CLS_CODE = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2", "APRV_CLS_CODE" , 0 )
			if szAPRV_CLS_CODE == "01" then
				szStatusNm = "1차승인대기"
			elseif szAPRV_CLS_CODE == "02" then
				szStatusNm = "1차승인"
			elseif szAPRV_CLS_CODE == "03" then
				szStatusNm = "2차승인"
			elseif szAPRV_CLS_CODE == "04" then
				szStatusNm = "승인완료(3차승인)"
			elseif szAPRV_CLS_CODE == "00" then
				szStatusNm = "승인건미존재"
			end if
			tblState.SetCellString( 8 , 1, szStatusNm )
		End If
		
	'종목별한도관리다건조회
	ElseIf szTranID == "obtrc_limt_003r" Then
		Dim nCnt
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		If nCnt > 0 Then
			Dim nIssuLimtAnt, nIssuRmndStndExhsAmt, nIssuNcntExhsAmt
			nIssuLimtAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ISSU_LIMT_AMT" , 0 )) '종목한도금액
			nIssuRmndStndExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ISSU_RMND_STND_EXHS_AMT" , 0 )) '종목잔고기준소진금액
			nIssuNcntExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ISSU_NCNT_EXHS_AMT" , 0 )) '종목미체결소진금액
	
			'매수가능금액 계산중
			g_nBuyAbleAmt = g_nBuyAbleAmt + nIssuLimtAmt - nIssuRmndStndExhsAmt - nIssuNcntExhsAmt
			
			'매수가능금액이 음수일 경우 0으로 처리
			if g_nBuyAbleAmt < 0 then
				g_nBuyAbleAmt = 0
			end if
			
			'통화코드에 따라서 소숫점 다르게 하여 표기
			if g_szCurrCode == "KRW" or g_szCurrCode == "JPY" then
				tblState.SetCellString( 3 , 1, FormatNumber(g_nBuyAbleAmt, 0) )	'매수가능금액
			else
				tblState.SetCellString( 3 , 1, FormatNumber(g_nBuyAbleAmt, 2) )	'매수가능금액
			end if
		End If
		DATAMANAGER.RequestTranData( "obsim_oscm_326r" )
		
	ElseIf szTranID == "obsim_oscm_326r" Then
		g_nDealStndExrt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "DEAL_STND_EXRT" , 0 )) '매매기준환율
		
		'기준환율
		tblState.SetCellString( 6 , 1, g_nDealStndExrt )
		
		'원화환산금액 = 추가신청한도 * 매매기준환율
		If edtApltLimt.caption <> "" and edtApltLimt.caption <> null then
			tblState.SetCellString( 7 , 1, tonumber(edtApltLimt.caption) * g_nDealStndExrt )	
		End If
	'CFD고객한도조회
	ElseIf szTranID == "obtrc_limt_009a" Then
		If g_szState == "I" Then
			Form.ShowAlert( "알림", "신청 완료되었습니다.")
		Else
			Form.ShowAlert( "알림", "해지 완료되었습니다.")
		End If

		f_ClearData()
		DATAMANAGER.RequestTranData( "obtrc_limt_008r" ) 
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if

	Form.MsgBox( "알림", szErrMsg, "", 6 )

End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtrc_limt_012r" trcode="obtrc_limt_012r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrc_limt_003r" trcode="obtrc_limt_003r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrc_limt_005r" trcode="obtrc_limt_005r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrc_limt_008r" trcode="obtrc_limt_008r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obsim_oscm_326r" trcode="obsim_oscm_326r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrc_limt_009a" trcode="obtrc_limt_009a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtrc_limt_012r" title="CFD_고객한도조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="160" _ulen="120" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ISCD^종목코드^12^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="784" _ulen="572" >

CUST_BASC_LIMT_AMT^고객기본한도금액^19^0^7^0^0^0^0
CUST_SPLM_LIMT_AMT^고객추가한도금액^19^0^7^0^0^0^0
RMND_STND_EXHS_AMT^잔고기준소진금액^19^0^7^0^0^0^0
NCNT_EXHS_AMT^미체결소진금액^19^0^7^0^0^0^0
UNMA_CUST_BASC_LIMT_AMT^비관리고객기본한도금액^19^0^7^0^0^0^0
UNMA_RMND_STND_EXHS_AMT^비관리잔고기준소진금액^19^0^7^0^0^0^0
UNMA_NCNT_EXHS_AMT^비관리미체결소진금액^19^0^7^0^0^0^0
TOTAL_LIMT_AMT^총한도금액^19^0^7^0^0^0^0
EXHS_LIMT_AMT^소진한도금액^19^0^7^0^0^0^0
RMNN_LIMT_AMT^잔여한도금액^19^0^7^0^0^0^0
UNMA_TOTAL_LIMT_AMT^비관리총한도금액^19^0^7^0^0^0^0
UNMA_EXHS_LIMT_AMT^비관리소진한도금액^19^0^7^0^0^0^0
UNMA_RMNN_LIMT_AMT^비관리잔여한도금액^19^0^7^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock2" inout="out" _len="314" _ulen="228" >

CRCD^통화코드^3^0^0^0^0^0^0
CUST_ISSU_SPLM_LIMT_AMT^고객종목추가한도금액^20^6^7^0^0^0^0
CUST_ISSU_RMND_STND_EXHS_AMT^고객종목잔고기준소진금액^20^6^7^0^0^0^0
CUST_ISSU_NCNT_EXHS_AMT^고객종목미체결소진금액^20^6^7^0^0^0^0
APRV_CLS_CODE^승인구분코드^2^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock3" occurs="30" inout="out" _len="610" _ulen="460" >

