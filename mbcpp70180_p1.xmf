'--===========================================================================
'--===========================================================================
Dim g_szData
Dim g_arrItem
Dim g_intItemCnt
Dim tmpPortfID

'Dim g_arrCheck
Dim g_arrPfID

Dim Pid_search
Dim Pname_search

Dim getdataid
Dim getdataname

Dim nGridCnt
'============================================================================
Sub Form_OnFormInit()
	 
	g_intItemCnt = Form.GetEnvData( "ccomp_itemCnt")
	tmpItem =  Form.GetEnvData( "ccomp_itemList" )
	'tmpCheckSt = Form.GetEnvData("ccomp_itmeCheck")
	tmpPortfID = Form.GetEnvData("ccomp_PfoID")
	
	if g_intItemCnt = "" then
		Exit Sub		
	end if
	g_arrItem = split(tmpItem , "^")
	'g_arrCheck = split(tmpCheckSt , "^")
	g_arrPfID = split(tmpPortfID , "^")

	for i = 0 to g_intItemCnt - 1
		Grid0.insertrow = i
		Grid0.SetCellData( "bd_cell1", i , g_arrItem[i] )
		Grid0.SetCellData( "bd_cell3", i,  g_arrPfID[i] )
		
		'if g_arrCheck[i] = "" then
		'	g_arrCheck[i] = "1"
		'end if
		'Grid0.SetCellData( "bd_cell0", i , g_arrCheck[i] )
	next
End Sub

'============================================================================
Sub Form_OnFormClose()
	nGridCnt = CInt(Grid0.rowcount)
	if nGridCnt =  0 then
		Exit Sub
	end if
	tmpItemData = ""
	'tmpCheck = ""
	tmpPortfID = ""
	for i = 0 to nGridCnt -1
		tmpItemData = tmpItemData..Grid0.GetCellData( "bd_cell1", i ).."^"
		'tmpCheck = tmpCheck..Grid0.GetCellData( "bd_cell0", i ).."^"
		tmpPortfID = tmpPortfID..Grid0.GetCellData( "bd_cell3", i ).."^"
	next
	Form.SetEnvData( 1, "ccomp_itemCnt", nGridCnt )
	Form.SetEnvData( 1, "ccomp_itemList", tmpItemData )
	'Form.SetEnvData( 1, "ccomp_itmeCheck", tmpCheck )
	Form.SetEnvData( 1, "ccomp_PfoID", tmpPortfID)
	'Form.MsgBox("", nGridCnt, "", "")
	'Form.MsgBox("", tmpItemData, "", "")
	'Form.MsgBox("", tmpCheck, "", "")
	'Form.MsgBox("", tmpPortfID, "", "")
	Form.SendReturnToParent( "CompOption" , "true" )
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub BtnSave_OnClick()
	nGridCnt = CInt(Grid0.rowcount)
	if nGridCnt = 1 then
		Form.ShowAlert("알림", "2개의 상품을 추가해야 비교가능합니다.")
		Exit Sub
	end if
	Form.CloseForm( )
	Form.SendReturnToParent( "CompOption" , "true" )

End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	nGridCnt = CInt(Grid0.rowcount)
	if szCellID = "bd_cell2" then
		if nGridCnt = 1 then
			Form.ShowAlert("알림", "최소 1개 종목은 있어야 합니다. ")
			Exit Sub
		else
			Grid0.SetDeleteRow( lRow )
		end if
	end if
End Sub
'============================================================================
Sub BtnAdd_OnClick()
	nGridCnt = CInt(Grid0.rowcount)
	if nGridCnt = 2 then
		Form.ShowAlert("알림" , "비교종목편집에는 최대 2개까지 추가가능합니다.")
		Exit Sub
	end if
	Form.OpenPopup("mbcpp70180_p2.xmf" , "" , "")
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	 getdataid	=	""
	 getdataname	=	""
	
	 
	 if sKeyname == "A" then
		 if sRet == "1" then
			getdataid = Form.GetSharedData("selectedPid_fav" , true)
			getdataname = Form.GetSharedData("selectedPname_fav" , true)
			
		 end if
		
		if sRet == "2" then
			getdataid = Form.GetSharedData("selectedPid_search" , true)
			getdataname = Form.GetSharedData("selectedPname_search" , true)
			
			
		end if
				
	end if
	 
	nGridCnt = CInt(Grid0.rowcount)
	
	if sKeyname = "A" then
		if sRet = "" or  sRet = null then
			Exit Sub
		else
			if nGridCnt = 0 then
				Grid0.insertrow = 0
				Grid0.SetCellData("bd_cell1", 0, getdataname)
				Grid0.SetCellData("bd_cell3", 0, getdataid)
			
			else
				for i = 0 to nGridCnt-1
					if i = nGridCnt -1 then
						Grid0.insertrow = i+1
						Grid0.SetCellData("bd_cell1", i+1, getdataname)
						Grid0.SetCellData("bd_cell3", i+1, getdataid)
						Grid0.SetCellData("bd_cell0", i+1, "1")
					elseif i = 4 then
						Grid0.SetCellData("bd_cell1", i+1, getdataname)
						Grid0.SetCellData("bd_cell3", i+1, getdataid)
						Grid0.SetCellData("bd_cell0", i+1, "1")
					end if
				next
			end if
		end if
	end if
				
		
	'Form.MsgBox("검색창에서설정창으로잘넘어오나?", getdataid, "", "")
	'Form.MsgBox("검색창에서설정창으로잘넘어오나?", getdataname, "", "")
	
	
End Sub

