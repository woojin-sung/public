'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	g_szSharedData0 = Form.GetSharedData(g_szSharedKey_Domestic, false )
	g_szSharedData1 = Form.GetSharedData(g_szSharedKey_Oversea, false )
	Init_Control()
	Init_Data()
	
	Dim szData 
	szData = Form.GetSharedData("50110_S3_CHECK", false )
	
	if szData = "" then
		contMain.contDomestic.top = 0
		contMain.contDomestic.visible = true
		
		contMain.contOversea.top = g_nTop_Oversea
		contMain.contOversea.visible = true
	
	elseif instr(szData, "한국 상장") > 0 then
		if instr(szData, "미국 상장") > 0 or instr(szData, "중국 상장") > 0 or instr(szData, "일본 상장") > 0 or instr(szData, "홍콩 상장") > 0 then
			contMain.contDomestic.top = 0
			contMain.contDomestic.visible = true
			
			contMain.contOversea.top = g_nTop_Oversea
			contMain.contOversea.visible = true
			
		else
			contMain.contDomestic.top = 0
			contMain.contDomestic.visible = true
			
			contMain.contOversea.top = g_nTop_Oversea
			contMain.contOversea.visible = false
			
		end if
	else
		if instr(szData, "미국 상장") > 0 or instr(szData, "중국 상장") > 0 or instr(szData, "일본 상장") > 0 or instr(szData, "홍콩 상장") > 0 then
			contMain.contDomestic.visible = false
			
			contMain.contOversea.top = 0
			contMain.contOversea.visible = true
			
		else
			contMain.contDomestic.top = 0
			contMain.contDomestic.visible = true
			
			contMain.contOversea.top = g_nTop_Oversea
			contMain.contOversea.visible = true
		end if
	end if
	
	arrTempData = Convert_StringToArr(g_szSharedData0, "`")
					
	for i = 0 to #arrTempData - 1
		nStep0_Idx = Return_ArrayIndex(g_arrDomestic, arrTempData(i))
		Reload_PannelBtn_Domestic(nStep0_Idx)
	next
	
	szReturn = Return_AllChkYN(g_arrDomestic_Check)

	if szReturn = "Y" then
		g_szChk_Domestic = "1"
		contMain.contDomestic.imgChk.imgpath = g_szChkImg_Select
	end if
	
	arrTempData = Convert_StringToArr(g_szSharedData1, "`")
					
	for i = 0 to #arrTempData - 1
		nStep0_Idx = Return_ArrayIndex(g_arrOversea, arrTempData(i))
		Reload_PannelBtn_Oversea(nStep0_Idx)
	next
	
	szReturn = Return_AllChkYN(g_arrOversea_Check)

	if szReturn = "Y" then
		g_szChk_Oversea = "1"
		contMain.contOversea.imgChk.imgpath = g_szChkImg_Select
	end if
End Sub


'============================================================================
Sub contMain_contDomestic_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelBtn_Domestic(nIndex, sCellID)
	Form.SetSharedData(g_szSharedKey_Domestic , Convert_ChkArrToString(g_arrDomestic, g_arrDomestic_Check, "`"))
	Form.triggerEvent("#", g_szSharedKey_Real, "")
End Sub

'============================================================================
Sub contMain_contOversea_Pannel1_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelBtn_Oversea(nIndex, sCellID)
	Form.SetSharedData(g_szSharedKey_Oversea , Convert_ChkArrToString(g_arrOversea, g_arrOversea_Check, "`"))
	Form.triggerEvent("#", g_szSharedKey_Real, "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "50110_S4_CHECK" then
		Init_Data()

		g_szSharedData = Form.GetSharedData(g_szSharedKey_Domestic, false )
		arrTempData = Convert_StringToArr(g_szSharedData, "`")
						
		for i = 0 to #arrTempData - 1
			nStep0_Idx = Return_ArrayIndex(g_arrDomestic, arrTempData(i))
			Reload_PannelBtn_Domestic(nStep0_Idx)
		next
		
		szReturn = Return_AllChkYN(g_arrDomestic_Check)

		if szReturn = "Y" then
			g_szChk_Domestic = "1"
			contMain.contDomestic.imgChk.imgpath = g_szChkImg_Select
		else
			g_szChk_Domestic = "0"
			contMain.contDomestic.imgChk.imgpath = g_szChkImg_Normal
		end if
		
		
		
