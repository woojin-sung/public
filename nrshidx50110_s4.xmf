'============================================================================
Sub contMain_contDomestic_btnChk_OnClick()
	if g_szChk_Domestic = "1" then
		g_szChk_Domestic = "0"
		contMain.contDomestic.imgChk.imgpath = g_szChkImg_Normal
		
		Clear_Domestic()
	else
		g_szChk_Domestic = "1"
		contMain.contDomestic.imgChk.imgpath = g_szChkImg_Select
		
		All_Domestic()
	end if
	
	Form.SetSharedData(g_szSharedKey_Domestic , Convert_ChkArrToString(g_arrDomestic, g_arrDomestic_Check, "`"))
	Form.triggerEvent("#", g_szSharedKey_Real, "")
End Sub

'============================================================================
Sub contMain_contOversea_btnChk_OnClick()
	if g_szChk_Oversea = "1" then
		g_szChk_Oversea = "0"
		contMain.contOversea.imgChk.imgpath = g_szChkImg_Normal
		
		Clear_Oversea()
	else
		g_szChk_Oversea = "1"
		contMain.contOversea.imgChk.imgpath = g_szChkImg_Select
		
		All_Oversea()
	end if
	
	Form.SetSharedData(g_szSharedKey_Oversea , Convert_ChkArrToString(g_arrOversea, g_arrOversea_Check, "`"))
	Form.triggerEvent("#", g_szSharedKey_Real, "")
End Sub


'============================================================================
Sub contMain_contOversea_imgTooltip_OnClick()
	sText = "해외 ETF 상장 자산 규모\n중국,홍콩,일본에 상장된 ETF의 자산규모는 달러로 환산되어 제공됩니다."
	g_nCommFontSize = Form.getEnvData("common.textsize")
	
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.contOversea.imgTooltip.openToolTip( sText, 350, 100, 2 )
	else
		contMain.contOversea.imgTooltip.openToolTip( sText, 300, 100, 2 )
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) = 1 then
		Form.SetTimerEvent2(sTimerID,0,0)
		Dim szData
		szData = Form.GetSharedData("50110_S3_CHECK", false )

		if szData = "" then
			contMain.contDomestic.top = 0
			contMain.contDomestic.visible = true
			
			contMain.contOversea.top = g_nTop_Oversea
			contMain.contOversea.visible = true
		
		elseif instr(szData, "한국 상장") > 0 then
			if instr(szData, "미국 상장") > 0 or instr(szData, "중국 상장") > 0 or instr(szData, "일본 상장") > 0 or instr(szData, "홍콩 상장") > 0 then
				contMain.contDomestic.top = 0
				contMain.contDomestic.visible = true
				
				contMain.contOversea.top = g_nTop_Oversea
				contMain.contOversea.visible = true
				
			else
				contMain.contDomestic.top = 0
				contMain.contDomestic.visible = true
				
				contMain.contOversea.top = g_nTop_Oversea
				contMain.contOversea.visible = false
			end if
		else
			if instr(szData, "미국 상장") > 0 or instr(szData, "중국 상장") > 0 or instr(szData, "일본 상장") > 0 or instr(szData, "홍콩 상장") > 0 then
				contMain.contDomestic.visible = false
				
				contMain.contOversea.top  = 0
				contMain.contOversea.visible = true
			
			else
				contMain.contDomestic.top = 0
				contMain.contDomestic.visible = true
				
				contMain.contOversea.top = g_nTop_Oversea
				contMain.contOversea.visible = true
			end if
		end if

		contMain.setScrollAutoSize()
	end if
End Sub

