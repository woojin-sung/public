	<SCRIPT_INFO _len="28000" _ulen="27392" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'==============================================
' 이미지
'==============================================
Dim g_szCmbImg_Normal
g_szCmbImg_Normal = "combo_04.9"

Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_line2_o.9"

Dim g_szChkImg_Normal
g_szChkImg_Normal = "checkmenu_n"

Dim g_szChkImg_Select
g_szChkImg_Select = "checkmenu_o"

Dim g_szToolTipImg
g_szToolTipImg = "icon_question"


'==============================================
' 컬러코드
'==============================================
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

'==============================================
' 전역변수
'==============================================
Dim g_szSharedKey_Real
g_szSharedKey_Real = "50110_S4_CHECK"

Dim g_szSharedKey_Domestic
g_szSharedKey_Domestic = "50110_S4_CHECK_DOMESTIC"

Dim g_szSharedKey_Oversea
g_szSharedKey_Oversea = "50110_S4_CHECK_OVERSEA"

Dim g_arrDomestic
g_arrDomestic = Array("500억 미만", "5백억~\n1천억 미만", "1천억~\n5천억 미만", "5천억 이상")

Dim g_arrDomestic_Check
g_arrDomestic_Check = Array("0", "0", "0", "0")

Dim g_arrOversea
g_arrOversea = Array("1천만 달러 미만", "1천만~\n1억 달러 미만", "1억~\n10억 달러 미만", "10억~\n100억달러 미만", "100억 달러 이상")

Dim g_arrOversea_Check
g_arrOversea_Check = Array("0", "0", "0", "0", "0")

Dim g_szChk_Domestic, g_szChk_Oversea

Dim g_nTop_Oversea
g_nTop_Oversea = 0

Dim g_nHeight_Oversea
g_nHeight_Oversea = 0

Dim g_nHeight_Domestic
g_nHeight_Domestic = 0

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	contMain.contDomestic.lblSubTitle.fgcolor = g_szTxtColor_Normal
	contMain.contDomestic.lblSubTitle.paddinginfo = "0,0,0,0"
	
	contMain.contOversea.lblSubTitle.fgcolor = g_szTxtColor_Normal
	contMain.contOversea.lblSubTitle.paddinginfo = "0,0,0,0"
End Function
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Data()
	'===============================================
	' 뒤로가기 버튼 초기화
	'===============================================
	contMain.contDomestic.lblChk.fgcolor = g_szTxtColor_Grey
	contMain.contDomestic.lblChk.paddinginfo = "0,0,0,0"
	
	contMain.contDomestic.lblChk.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contDomestic.imgChk.setMaintainingRatio("3")
	contMain.contDomestic.imgChk.imgpath = g_szChkImg_Normal
	
	nArrCnt = #g_arrDomestic
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	contMain.contDomestic.Pannel0.rowcount = nPannelRowCnt
	contMain.contDomestic.Pannel0.height = (55 * nPannelRowCnt) + (10 * (nPannelRowCnt-1))

	contMain.contDomestic.height = 20 + 20 +10 + (55 * nPannelRowCnt) + (10 * (nPannelRowCnt-1))
	g_nHeight_Domestic = 0 + 20 +10 + (55 * nPannelRowCnt) + (10 * (nPannelRowCnt-1))
	
	contMain.contDomestic.setScrollAutoSize()
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		contMain.contDomestic.Pannel0.SetCellValue( "lblDomestic0", i, g_arrDomestic(nArrIdx))	
		contMain.contDomestic.Pannel0.setPropCardCell("fgcolor", "lblDomestic0", i, g_szTxtColor_Normal)
		
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", "lblDomestic0", i, g_szBtnImg_Normal)
		g_arrDomestic_Check(nArrIdx) = "0" 
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contMain.contDomestic.Pannel0.SetCellVisible("lblDomestic1",i,false)
			contMain.contDomestic.Pannel0.SetCellVisible("lblDomestic2",i,false)
			
			contMain.contDomestic.Pannel0.SetPropCardCell("enable", "lblDomestic1", i, false)
			contMain.contDomestic.Pannel0.SetPropCardCell("enable", "lblDomestic2", i, false)
			Exit for
		end if
		
		contMain.contDomestic.Pannel0.SetCellValue( "lblDomestic1", i, g_arrDomestic(nArrIdx))	
		contMain.contDomestic.Pannel0.setPropCardCell("fgcolor", "lblDomestic1", i, g_szTxtColor_Normal)
		
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", "lblDomestic1", i, g_szBtnImg_Normal)
		g_arrDomestic_Check(nArrIdx) = "0" 
	
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contMain.contDomestic.Pannel0.SetCellVisible("lblDomestic2",i,false)
			
			contMain.contDomestic.Pannel0.SetPropCardCell("enable", "lblDomestic2", i, false)
			Exit for
		end if
		
		contMain.contDomestic.Pannel0.SetCellValue( "lblDomestic2", i, g_arrDomestic(nArrIdx))	
		contMain.contDomestic.Pannel0.setPropCardCell("fgcolor", "lblDomestic2", i, g_szTxtColor_Normal)
		
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", "lblDomestic2", i, g_szBtnImg_Normal)
		g_arrDomestic_Check(nArrIdx) = "0" 
		
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	
	contMain.contOversea.lblChk.fgcolor = g_szTxtColor_Grey
	contMain.contOversea.lblChk.paddinginfo = "0,0,0,0"
	
	contMain.contOversea.lblChk.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contOversea.imgChk.setMaintainingRatio("3")
	contMain.contOversea.imgChk.imgpath = g_szChkImg_Normal
	
	contMain.contOversea.imgTooltip.setMaintainingRatio("3")
	contMain.contOversea.imgTooltip.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("해외ETF 규모", 0, true, false)
	contMain.contOversea.imgTooltip.left = 20 + nTextWidth
	
	contMain.contOversea.lblSubTitle.setNeighborCtlPos("imgTooltip", "right", -5, "해외ETF 규모")
	
	nArrCnt = #g_arrOversea
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	g_nTop_Oversea = contMain.contDomestic.height + 10
	contMain.contOversea.top =  g_nTop_Oversea
	contMain.contOversea.Pannel1.rowcount = nPannelRowCnt
	contMain.contOversea.Pannel1.height = (55 * nPannelRowCnt) + (10 * (nPannelRowCnt-1))
	contMain.contOversea.height = 20 + 20 +10 + (55 * nPannelRowCnt) + (10 * (nPannelRowCnt-1)) + 20
	
	g_nHeight_Oversea = 20 + 20 +10 + (55 * nPannelRowCnt) + (10 * (nPannelRowCnt-1)) + 20
	contMain.contOversea.setScrollAutoSize()
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		contMain.contOversea.Pannel1.SetCellValue( "lblOversea0", i, g_arrOversea(nArrIdx))	
		contMain.contOversea.Pannel1.setPropCardCell("fgcolor", "lblOversea0", i, g_szTxtColor_Normal)
		
		contMain.contOversea.Pannel1.SetPropCardCell("imagefilepth", "lblOversea0", i, g_szBtnImg_Normal)
		g_arrOversea_Check(nArrIdx) = "0" 
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contMain.contOversea.Pannel1.SetCellVisible("lblOversea1",i,false)
			contMain.contOversea.Pannel1.SetCellVisible("lblOversea2",i,false)
			
			contMain.contOversea.Pannel1.SetPropCardCell("enable", "lblOversea1", i, false)
			contMain.contOversea.Pannel1.SetPropCardCell("enable", "lblOversea2", i, false)
			Exit for
		end if
		
		contMain.contOversea.Pannel1.SetCellValue( "lblOversea1", i, g_arrOversea(nArrIdx))	
		contMain.contOversea.Pannel1.setPropCardCell("fgcolor", "lblOversea1", i, g_szTxtColor_Normal)
		
		contMain.contOversea.Pannel1.SetPropCardCell("imagefilepth", "lblOversea1", i, g_szBtnImg_Normal)
		g_arrOversea_Check(nArrIdx) = "0" 
		
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contMain.contOversea.Pannel1.SetCellVisible("lblOversea2",i,false)
			contMain.contOversea.Pannel1.SetPropCardCell("enable", "lblOversea2", i, false)
			Exit for
		end if
		
		contMain.contOversea.Pannel1.SetCellValue( "lblOversea2", i, g_arrOversea(nArrIdx))	
		contMain.contOversea.Pannel1.setPropCardCell("fgcolor", "lblOversea2", i, g_szTxtColor_Normal)
		
		contMain.contOversea.Pannel1.SetPropCardCell("imagefilepth", "lblOversea2", i, g_szBtnImg_Normal)
		g_arrOversea_Check(nArrIdx) = "0" 
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	contMain.setScrollAutoSize()
	
End Function

'===============================================
' 패널버튼 클릭 이벤트 처리
'===============================================
Function DisplaySetting_PannelBtn_Domestic(nRowIdx, szCtlName)
	
	
		
		
	nCnt = nRowIdx * 3
	if szCtlName = "lblDomestic0" then
		
	elseif szCtlName = "lblDomestic1" then
		nCnt = Cint(nCnt) + 1
	elseif szCtlName = "lblDomestic2" then
		nCnt = Cint(nCnt) + 2
	end if
	
	if #g_arrDomestic_Check < nCnt+1 then
		Exit Function
	end if
	
	if g_szChk_Domestic = "1" then
		g_szChk_Domestic = "0"
		contMain.contDomestic.imgChk.imgpath = g_szChkImg_Normal
	end if
	
	if g_arrDomestic_Check(nCnt) = "0" then
		g_arrDomestic_Check(nCnt) = "1"
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
	else 
		g_arrDomestic_Check(nCnt) = "0"
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
	end if
	
	szReturn = Return_AllChkYN(g_arrDomestic_Check)

	if szReturn = "Y" then
		g_szChk_Domestic = "1"
		contMain.contDomestic.imgChk.imgpath = g_szChkImg_Select
	end if
	
End Function

Function Reload_PannelBtn_Domestic(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblDomestic0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblDomestic1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblDomestic2"
	end if
	
	g_arrDomestic_Check(nArrIdx) = "1"
	contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
End Function

Function DisplaySetting_PannelBtn_Oversea(nRowIdx, szCtlName)
	
	
	
	nCnt = nRowIdx * 3
	if szCtlName = "lblOversea0" then
		
	elseif szCtlName = "lblOversea1" then
		nCnt = Cint(nCnt) + 1
	elseif szCtlName = "lblOversea2" then
		nCnt = Cint(nCnt) + 2
	end if
	
	if #g_arrOversea_Check < nCnt+1 then
		Exit Function
	end if
	
	if g_szChk_Oversea = "1" then
		g_szChk_Oversea = "0"
		contMain.contOversea.imgChk.imgpath = g_szChkImg_Normal
	end if
	
	if g_arrOversea_Check(nCnt) = "0" then
		g_arrOversea_Check(nCnt) = "1"
		contMain.contOversea.Pannel1.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
	else 
		g_arrOversea_Check(nCnt) = "0"
		contMain.contOversea.Pannel1.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
	end if
	
	
	szReturn = Return_AllChkYN(g_arrOversea_Check)

	if szReturn = "Y" then
		g_szChk_Oversea = "1"
		contMain.contOversea.imgChk.imgpath = g_szChkImg_Select
	end if
End Function

Function Reload_PannelBtn_Oversea(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblOversea0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblOversea1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblOversea2"
	end if
	
	g_arrOversea_Check(nArrIdx) = "1"
	contMain.contOversea.Pannel1.SetPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
End Function

Function All_Domestic()
	nArrCnt = #g_arrDomestic
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", "lblDomestic0", i, g_szBtnImg_Select)
		g_arrDomestic_Check(nArrIdx) = "1" 
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", "lblDomestic1", i, g_szBtnImg_Select)
		g_arrDomestic_Check(nArrIdx) = "1" 

		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contDomestic.Pannel0.SetPropCardCell("imagefilepth", "lblDomestic2", i, g_szBtnImg_Select)
		g_arrDomestic_Check(nArrIdx) = "1" 
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

