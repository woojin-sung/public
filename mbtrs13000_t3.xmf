Sub btnCash_OnClick()
	if cmbType.currentindex = "0" or cmbType.currentindex = 0 then
		if edtPrc.caption = "" or edtPrc.caption = "0" or edtPrc.caption = 0 then
'			Form.ShowAlert(g_szTitle, "주문가격을 입력해주세요.")
			edtPrc.caption = Form.GetCtlProp("#lblHyun", "caption")
		end if
		
		Request_Able(1)
	Else
		Request_Able(1)
	End if
End Sub

