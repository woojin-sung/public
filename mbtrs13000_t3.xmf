'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "13000_HOGA" then
		if sParam <> "" then
			'주문유형에 따른 주문단가
			szType = Check_OrdType()
			
			if szType == "01" or szType == "06" or szType == "81" then		'지정, 조건부, 시간외 주문
				edtPrc.caption = sParam			
				edtPrc_OnEditComplete()
			end if	
		else
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기/ 탭 체인지
	' ----------------------------------------------------------------------		
	elseif sEventName == "INIT_CODE" or sEventName == "CHNAGE_TAB" then
		if sEventName == "INIT_CODE" then
			Form.SetCtlProp("#edtOrgNo", "caption", "")
		end if
		
		' 20160407 예외처리 추가
		if g_szCd <> sParam then
			g_szCd = sParam
		
			Set_OrdType()					' 종목코드에 따라 주문유형 설정
		end if
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
		
		'20170816 LES START - 주문유형콤보세팅 여기다가???
		szType = Form.GetSharedData("B_TYPE", false)		' 주문구분
		cmbType.currentindex = szType					' 주문구분 콤보박스 세팅
		'20170816 LES END
		
		'20180716 LES START
		Position_Control()
		
		'20230308 HSZ START
		szACNO = Trim(Form.GetCtlProp("#acnt", "total"))
		if szACNO <> "" then
			g_szLabel = true
			Request_Able(1)
		end if
		'20230308 HSZ END
		
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			Return_AutoQty()
		end if
		'20170919 HAMWG END
		
		szPrc = Form.GetSharedData("HYUN_RETURN", true)
		Form.SetSharedData("HYUN_RETURN", "")
		
		if Trim(szPrc) <> "" and szPrc <> null then
			edtPrc.caption = szPrc
			edtPrc_OnEditComplete()
		else
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
		end if
	
	' ----------------------------------------------------------------------
	' 잔고팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------			
	elseif sEventName == "13000_BALANCE_RETURN" then	
'		g_bRtnData = true
'		g_bRtnData1 = true
		
		if sParam == "" then
			Exit Sub
		end if

		Return_BalanceScreen(sParam)
		
		'20180716 LES START
		Position_Control()
		
	' ----------------------------------------------------------------------
	' 현재가에서 리턴된 값 적용 : 20160321 추가
	' ----------------------------------------------------------------------		
	elseif sEventName == "12000_HYUN_RETURN" then
		'edtPrc.caption = sParam
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			
			'20201117 LES START
			g_szWarnFlag = "A"
			
			'20200824 LES START 제도개선
			'if gWarnCd = "3" then
			'	g_szWarnFlag = "O"
			'elseif gWarnCd = "4"then
			'	g_szWarnFlag = "A"
			'elseif gWarnCd = "5" then
			'	g_szWarnFlag = "A"
			'else
			'	g_szWarnFlag = "Y"
			'end if
			'20200824 LES END
			
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		

		'20160829_01 LKM START
		 btnCash.btnimage = "btn_02.9.png"
'		 btnMax.btnimage  = "btn_02.9.png"
		 Form.SetSharedData("B_QTY_TYPE" , "2")
		'20160829_01 LKM END		
		
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szCondCd
	
	' 종목코드
	szCd = Change_ItemCode()
		
	'주문유형
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	'서비스 구분코드
	szCLSCd = cmbOrdType.cbkeydata
	
	'주문유형에 따른 주문단가
	Select Case szType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
			
			' HTS에서 가격없고, 가능금액조회시 현재가를 넣어준다.
			if Trim(szPrc) == "" and szTranID == "obtrc_oder_004r" then
				szPrc = Form.GetCtlProp("#lblHyun", "caption")
				
			end if
	End Select
	
	' ----------------------------------------------------------------------
	' CFD 청산주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrc_oder_001a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrc_oder_001a")

		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ISCD"				, 0, szCd)									' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ODER_UNPR"			, 0, szPrc)									' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ODQT"				, 0, edtQty.caption)							' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ODER_CLS_CODE"		, 0, szType)									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd)								' 주문조건구분코드
'		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ORGL_ODER_NO"		, 0, "Y")									' 전체정정취소여부
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)							' 경고확인여부
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "SVC_CLS_CODE"		, 0, szCLSCd )								' 서비스 구분 코드(101:신규매수, 102:신규매도, 111:청산매도, 112:청산매수, 103:정정, 104:취소)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ODER_GRP_NO"			, 0, "0")									' 주문그룹번호(0 고정)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0, "")										' 채널유형구분코드(메리츠공통)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문, 03:반대주문)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_001a", "InBlock1", "LQDT_CLCD"			, 0, "1")									' 반대매매구분코드
	' ----------------------------------------------------------------------
	' 청산 주문가능금액 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrc_oder_005r" then
		DATAMANAGER.ClearInputData(0, "obtrc_oder_005r")
		
		DATAMANAGER.SetDataValue(0, "obtrc_oder_005r", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_005r", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_005r", "InBlock1", "BROK_CODE"			, 0, "MERITZ")								' 브로커코드(고정)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_005r", "InBlock1", "CFD_EXCH_CODE"		, 0, "KRX")									' CFD거래소코드(고정)
		DATAMANAGER.SetDataValue(0, "obtrc_oder_005r", "InBlock1", "ISCD"				, 0, szCd)									' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrc_oder_005r", "InBlock1", "SVC_CLS_CODE"		, 0, szCLSCd )								' 매매유형구분코드(111:청산매도, 112:청산매수)
	
	'20220217 SWJ START
	elseif szTranID = "obrtd_drng_036r" then
		DATAMANAGER.SetDataValue(0, "obrtd_drng_036r", "InBlock1", "ACNO" , 0 , Form.GetCtlProp("#acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obrtd_drng_036r", "InBlock1", "ASNO" , 0 , Form.GetCtlProp("#acnt", "sequence"))	
	'20220217 SWJ END	
	
	End if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' CFD 매수주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtrc_oder_001a"		
			
			'20200824 LES START 제도개선
			'경고구분코드 (0.정상, 1.경고, 2.보류  추가: 3.투자유의 4.투자유의+경고  5.투자유의+보류)
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			gWarnCd = szWarnCd
			'20200824 LES END
			
			'20201117 LES START 제도개선
			'20200824 LES START 제도개선
			Select Case szWarnCd
				
				Case "1","3","4","6","7","9","a","c","d","f","g"
					Open_ConfirmPopup(szWarnMsg)
				Case "2","5","8","b","e","h"
					g_szTR = ""
				Case Else
					g_szTR = ""
					
					szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
					szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

					if Trim(szOrdCd) == "0001" then			' 정상주문
						Form.Toast(0, szOrdMsg, true)
					
						if g_szAfterInit == "1" then		' 주문후 초기화
							Init_InputControl()
						end if
					
						if g_szAfterOrg == "1" then			' 주문번호 연동
							szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
							Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
						else
							Form.SetCtlProp("#edtOrgNo", "caption", "")
						end if
						
						'20230308 HSZ START : 청산가능수량 재조회
						g_szLabel = true
						Request_Able(1)
						'20230308 HSZ END
					end if
				
			End Select
	' ----------------------------------------------------------------------
	' 청산 주문가능금액 조회
	' ----------------------------------------------------------------------	
		Case "obtrc_oder_005r"
		
		if g_szMax == "0" or g_szMax == "1" then			' 현금
			if g_szLabel == false then	'20230308 HSZ 분기처리 추가
				Dim nMaxQty 
				nMaxQty = CInt(DATAMANAGER.GetDataValue(0, "obtrc_oder_005r", "OutBlock1", "CLRN_ABLE_QTY", 0))
				
				edtQty.caption = Get_QtyinPer(nMaxQty)
				edtQty_OnEditComplete()
				
				
				'20160829_01 LKM START
	'			 btnCash.btnimage = "btn_04.9.png"
	'			 btnMax.btnimage  = "btn_02.9.png"
	'			 Form.SetSharedData("B_QTY_TYPE" , "0")
				'20160829_01 LKM END
				
	'		elseif g_szMax == "1" then		' 최대
	'			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrc_oder_004r", "OutBlock1", "UNCL_OCRN_ODER_ABLE_QTY", 0)
	'			edtQty_OnEditComplete()
	'			
	'			 '20160829_01 LKM START
	'			 btnCash.btnimage = "btn_02.9.png"
	'			 btnMax.btnimage  = "btn_04.9.png"
	'			 Form.SetSharedData("B_QTY_TYPE" , "1")
	'			'20160829_01 LKM END
			end if
			
		end if
		
		'20230308 HSZ START
		if g_szLabel == true then
			nMaxQty = CDbl(DATAMANAGER.GetDataValue(0, "obtrc_oder_005r", "OutBlock1", "CLRN_ABLE_QTY", 0))
			if CDbl(g_nQty) > 0 then	'20230401 HSZ
				lblDeposit.caption = g_nQty
				g_nQty = 0
			else
				lblDeposit.caption = nMaxQty
			end if
			g_szLabel = false
		end if
		'20230308 HSZ END
		
		'20220217 SWJ START
		Case "obrtd_drng_036r"
			szOutAcno = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "CNFT_ACNO" 		, 0)		'출금계좌번호
			szOutAsno = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "CNFT_ASNO" 		, 0)		'출금계좌일련번호
			szOutPrnm = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "PRNM" 			, 0)		'출금상품명
			szInPrnm  = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "MNRC_ACNT_PRNM"   , 0)		'입금상품명
			szAbleAmt = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "DRNG_ABLE_AMT"    , 0)		'출금가능금액
			
			'20200910 SWJ START
			'MTS메모리평문제거 적용상태일 때
			if plain_rm == "1" then
				sztmpPwd = Form.GetCtlProp("#edtPwd", "caption")		' 계좌 비밀번호
			'MTS메모리평문제거 미적용상태일 때
			else
				sztmpPwd = Form.GetCtlProp("#edtPwd", "encdata")		' 계좌 비밀번호
			end if	
			
			'출금가능액 >= 증거금부족액
			if CDbl(szAbleAmt) >= CDbl(g_ShortAmt) then
				szData = "0" & "@" & szOutAcno&szOutAsno & "@" & szOutPrnm & "@" & szAbleAmt & "@" & Form.GetCtlProp("#acnt", "total") & Form.GetCtlProp("#acnt", "sequence") & "@" & sztmpPwd & "@" & szInPrnm & "@" & g_ShortAmt & "@" & "청산"
			'출금가능액 < 증거금부족액
			else
				szData = "1" & "@" & szOutAcno&szOutAsno & "@" & szOutPrnm & "@" & szAbleAmt & "@" & g_ShortAmt
			end if		
			
			'대체주문확인팝업
			Form.OpenPopup("mbtre13000_p11" , szData , "")
		'20220217 SWJ END
	End Select
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'20220217 SWJ START : 증거금 부족 이후 대체출금 주문 요건 추가
	if szTranID == "obtrc_oder_001a" then
		Select Case szErrCode
		
		'주문종료
'		Case "5988"

		'연결계좌 입금 후 주문
		Case "5989"
			'원장 내부 영향도로 인해 오류코드로 대체후 주문처리 할 것
			'증거금 부족금액은 주문모듈에서 계산해서 알 수 있는 값인데
			'오류로 떨어지면 증거금부족금액을 받을 수 있는 방법이
			'오류메시지에서 뿐이라.. (이체 쪽 서비스에서 받기엔 속도 및 유지보수 측면에서 별로)
			
			'증거금부족금액
			g_ShortAmt = tonumber(Trim(szSubMsg))

			DATAMANAGER.RequestTranData("obrtd_drng_036r")
		Case Else
				
			if Trim(szSubMsg) <> "" then
				Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
				'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
			else
				Form.ShowAlert(g_szTitle, szErrMsg)
				'Form.Toast(0, szErrMsg, true)
			end if
		End Select
		
		exit sub
	end if
	'20220217 SWJ END
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	Dim szType, szCode, szPrice, szInner, szInrMk, szAcnt, szAcntCd, szSvcCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if
	
 	'시장구분
	if g_szInner == "002" then		'코스닥
	    szInrMk = "02"
	elseif g_szInner == "033" then	'코넥스
		szInrMk = "21"
	elseif g_szInner == "025" then  '프리보드 '20180820 LES START
		szInrMk = "03"
	else
		szInrMk = "01"
	end if
	
	'주문유형에 따른 주문단가
	szType = cmbType.cbkeydata
    
	Select Case szType
		Case "11"										' 장개시전시간외(전일종가)
			szPrice =  Form.GetCtlProp("#lblStd", "caption")
		Case "12"										' 시간외종가(현재가)
			szPrice =  Form.GetCtlProp("#lblHyun", "caption")
		Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
			szPrice =  Form.GetCtlProp("#lblHigh", "caption")		' 매수시(상한가), 매도시 ( 하한가 )	
		Case else
		    szPrice = edtPrc.caption
	    
			if edtPrc.caption = "0" or edtPrc.caption = "" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
				exit Sub
			end if	    
	End Select

    '종목코드
	szCode = Change_ItemCode()
	
	if cmbOrdType.currentindex == 0 or cmbOrdType.currentindex == "0" then
		szSvcCd = "2" '매수
	else
		szSvcCd = "1" '매도
	end if
	
    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드|신규청산구분
    szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & szSvcCd & "★" & edtQty.caption & "★" & szPrice & "★" & szCode & "★" & "1"
    
    Form.OpenPopup("mbtrs13000_pc" , szData , "")
End Sub

