'============================================================================
' Get_QtyinPer() - 가능수량 %에 따른 수량 계산 값 리턴
'============================================================================
Function Get_QtyinPer(nMaxQty)
	Dim nPer
	nPer = CInt(cmbQtyPer.cbkeydata) / 100

	return CInt(nMaxQty * nPer)
End Function

