'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	
	szData = Form.GetOpenLinkData()
	
'	Form.ShowAlert("FormInit", szData)
	select case szData
		case "0"
			Container0.Label0.fgcolor = "334"
'			Container0.Image0.imgpath = "input_03_o.9.png"
			Container0.Image0.imgpath = "btn_line2_o.9"
			
		case "1"
			Container0.Label1.fgcolor = "334"
'			Container0.Image1.imgpath = "input_03_o.9.png"
			Container0.Image1.imgpath = "btn_line2_o.9"
		case "2"
			Container0.Label2.fgcolor = "334"
'			Container0.Image2.imgpath = "input_03_o.9.png"
			Container0.Image2.imgpath = "btn_line2_o.9"
		case "3"
			Container0.Label3.fgcolor = "334"
'			Container0.Image3.imgpath = "input_03_o.9.png"
			Container0.Image3.imgpath = "btn_line2_o.9"
	end select
End Sub

