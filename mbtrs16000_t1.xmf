'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szChkCrdt
	
	Load_OrderSet() '주문설정값 읽어오기 
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "12000_HOGA" then		
		if sParam <> "" then
			'주문유형에 따른 주문단가
			szType = Check_OrdType()
			
			if szType == "01" or szType == "06" or szType == "81" then		'지정, 조건부, 시간외 주문
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if	
		else
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------			
	elseif sEventName == "INIT_CODE" then
		Form.SetCtlProp("#edtOrgNo", "caption", "")	

		if g_bRtnData == false then
			if g_szCd <> sParam then
				g_szCd = sParam
				
				Set_OrdType()		' 종목코드에 따라 주문유형 설정
				
				if g_bRtnData1 == true then
					g_bRtnData1 = false
				else
					if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
						Init_InputControl()
					end if
				end if		
			end if
		else
			' 20160331 : 주문구분(시간외)에 따른 예외처리로 인하여 종목코드 미변경사항으로 인해 추가
			if g_szCd <> sParam then
				g_szCd = sParam
			end if
		end if
		
		'20180716 LES START
'		Position_Control() '211118 대주에서 삭제

		
	' ----------------------------------------------------------------------
	' 메인화면에서 탭 체인지
	' ----------------------------------------------------------------------			
	elseif sEventName == "CHNAGE_TAB" then
		
		'===================================================================================
		' 20170726 LES START - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		if g_szCd <> sParam then
			g_szCd = sParam
			Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		end if
		
		'===================================================================================
		' 20170726 LES END - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		'g_szCd = sParam
		'Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
		
		'20170816 LES START - 주문유형콤보세팅 여기다가???
		szType = Form.GetSharedData("S_TYPE_DAEJU", false)		' 주문구분
		cmbType.currentindex = szType					' 주문구분 콤보박스 세팅
		'20170816 LES END
				
		
		'===================================================================================
		
		'20180716 LES START
	
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
	
		if g_bRtnData == true then
			g_bRtnData = false
		else
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			Return_AutoQty()
		end if
		'20170919 HAMWG END
		
		szPrc = Form.GetSharedData("HYUN_RETURN", true)
		Form.SetSharedData("HYUN_RETURN", "")

			if Trim(szPrc) <> "" and szPrc <> null then
				edtPrc.caption = szPrc
				edtPrc_OnEditComplete()
			else
				if Trim(sParam) <> "" then
					edtPrc.caption = sParam
					edtPrc_OnEditComplete()
				end if
			end if
		end if
	' ----------------------------------------------------------------------
	' 종목등 변경사항 전혀 없을때
	' ----------------------------------------------------------------------		
	elseif sEventName == "NO_RETURN" then		
		g_bRtnData = false
		
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szIqry, szLoanCd, szLoanDate
	
	' 종목코드
	szCd = Change_ItemCode()

	'주문유형
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	'주문유형에 따른 주문단가
	Select Case szType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
			
			' HTS에서 가격없고, 가능금액조회시 현재가를 넣어준다.
			if Trim(szPrc) == "" and szTranID == "obtrs_comn_406r" then
				szPrc = Form.GetCtlProp("#lblHyun", "caption")
				edtPrc.caption = szPrc
			end if
	End Select
	
	szCLSCd = "201" '대주매도 서비스구분코드
	
	' ----------------------------------------------------------------------
	' 신용합산 주문가능수량 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_406r" then
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"	))' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"	))' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, szCd )	' 종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_UNPR"			, 0, szPrc )	' 주문가격
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_CLS_CODE"		, 0, szType )	' 주문유형
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRDT_ODER_CLS_CODE"	, 0, "33" )'신용주문구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MAX_MIN_CLCD" 		, 0, "0" )	' 20190502 HWG : 현금/최대 가능수량 구분값 변경
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BABD_YN"				, 0, "N" )
	
	elseif szTranID == "obtrs_oder_231a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, szTranID)
		
		'20180614 LES START - 전액상환방식 추가
		if chkRepay.checkstate == "1" then
			chkWhole = "Y"
		else
			chkWhole = "N"
		end if
		'20180614 LES END
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, Form.GetCtlProp("#acnt", "total"	))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, cmbCredit.cbkeydata	)' 신용구분
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD" 				, 0, szCd				)' 종목코드 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_UNPR" 			, 0, szPrc				)' 주문가격
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT" 				, 0, edtQty.caption		)' 주문수량
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DATE" 			, 0, ""					)' 대출일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_SRNO" 			, 0, "1"					)' 대출일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_CLS_CODE" 		, 0, szType				)' 주문구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd				)' 주문조건구분코드		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag			)' 경고확인여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd				)' 서비스구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, "N"					)' 전체금액상환여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, ""					)' 채널유형구분
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01"				)' 주문발생유형코드(01:일반주문)
	end if
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' 주식 대주매도주문
	' ----------------------------------------------------------------------	
	Select Case szTranID
		Case "obtrs_oder_231a"	
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)'메세지 내용
			
			if szWarnCd = "1" then	' 경고
				Open_ConfirmPopup(szWarnMsg)
				
			elseif szWarnCd = "2" then ' 보류
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

				if Trim(szOrdCd) == "0001" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
					
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					end if
				end if
			end If
	
	' ----------------------------------------------------------------------
	' 신용합산 주문가능수량 조회
	' ----------------------------------------------------------------------	
		 Case "obtrs_comn_406r"
			 edtQty.caption = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_ABLE_QTY", 0)' 주문가능수량
			 edtQty_OnEditComplete()
				
	End Select
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	if szTranID == "obtrs_oder_231a" and szErrCode == "3271" then
		szSubMsg = "\n\n※ 등록방법\n- MTS: 뱅킹/대출 > 신용/대출 > 대주 위험고지 등록\n- HTS: [7495] 대주 위험고지 등록"
		
		Form.ShowAlert(g_szTitle, szErrMsg & szSubMsg)
		
	else
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
			'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
			'Form.Toast(0, szErrMsg, true)
		end if
	end if
	' ----------------------------------------------------------------------
	' 주식 매도주문(주문에러는 초기화 안함 : 20160314 전요셉과장)
	' ----------------------------------------------------------------------	
'	if szTranID == "obtrs_oder_101a" or szTranID == "obtrs_oder_201a" or szTranID == "obtrs_oder_211a" then
'		if g_szAfterInit == "1" then		' 주문후 초기화
'			Init_InputControl()
'		end if	
'	end if
End Sub

'============================================================================
' cmbType_OnEditComplete
'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	Form.SetSharedData("S_TYPE_DAEJU", cmbType.currentindex)
	Form.SetSharedData("STOCK_SELTYPE", cmbType.cbkeydata)
	Form.triggerEvent("#", "12000_SELTYPE", "")
	Visible_Control(CInt(cmbType.cbkeydata))
	
	'20180716 LES START
	'Position_Control()
	
	'20190806 LES START
	if CInt(cmbType.cbkeydata) == 11 then
		Label0.visible = true
	else
		Label0.visible = false
	end if
	'20190806 LES END
	
End Sub

