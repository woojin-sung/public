		<LABEL name="labTitle" fontsize="4" fontstyle="01" caption="온라인서비스 이용약관" halign="1" ly_vert="0,0,375,60,1" />
		<BUTTON name="bntOK" caption="확인" fontsize="4" btnimage="btn_20.9" ly_vert="0,587,375,60,1" />
