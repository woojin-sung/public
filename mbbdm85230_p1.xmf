'============================================================================
' Form
'============================================================================
'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	WebView0.urlpath = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_13.html"
	
    '좌/우페이지넘김 이미지 설정
    'imgPrev.imgpath = "icon_menu_scroll_arrow_left.9.png"    '연한회색 작은꺽쇠
    'imgNext.imgpath = "icon_menu_scroll_arrow_right.9.png"
    'imgPrev.imgpath = "icon_arrow5_l.png"    '두껍고 큰 꺽쇠
    'imgNext.imgpath = "icon_arrow5_r.png"
    imgPrev.imgpath = "icon_arrow3_l.png"    '덜두껍고 큰 꺽쇠
    imgNext.imgpath = "icon_arrow3_r.png"
    imgPrev.bringFront("1") 
    imgNext.bringFront("1") 

    lblPage.caption = "1/1"
End Sub



'============================================================================
' 종료
'============================================================================
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    imgCanc_OnClick()
End Sub
'============================================================================
Sub imgCanc_OnClick()
     g_Flag = ""
	Form.CloseForm()
End Sub
'============================================================================
Sub bntOK_OnClick()
	'확인 버튼으로 종료시에만 정상확인 처리
	g_Flag = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
    '화면닫기전 안드로이드-백버튼 작동Y 원복
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
     Form.SendReturnToParent( "mbbdm85230_p1" , g_Flag)
End Sub





	</SCRIPT_INFO>
