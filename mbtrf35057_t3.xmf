'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function RequestData()

	
	DATAMANAGER.RequestTranData( "obtrf_oder_813r" )
	DATAMANAGER.RequestTranData( "obtrf_cntg_829r" )


End Function


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#cmbAccount", "total")
	szASNO = Form.GetCtlProp("#cmbAccount", "sequence")
	
	if szTranID = "obtrf_oder_813r" then
		DATAMANAGER.SetDataValue( false, "obtrf_oder_813r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( false, "obtrf_oder_813r", "InBlock1", "ASNO" , 0 , szASNO )
	elseif szTranID =  "obtrf_cntg_829r" then
		DATAMANAGER.SetDataValue( false, "obtrf_cntg_829r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( false, "obtrf_cntg_829r", "InBlock1", "ASNO" , 0 , szASNO )		
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName  = "RECEIVE" then
		RequestData()
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	RequestData()
End Sub

	</SCRIPT_INFO>
