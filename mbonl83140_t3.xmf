'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "#EdtPswd", "caption" )
	
	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	


'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	grdList.SetClear()
	g_nSelectRow = -1
End Function

'============================================================================
' f_ClearData0() : 초기화
'============================================================================
Function f_ClearData0()
	grdList0.SetClear()
	g_nSelectRow0 = -1
End Function

'============================================================================
' f_Proc() : 취소처리
'============================================================================
Function f_Proc()
	DATAMANAGER.RequestTranData( g_sCancelTranID )
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()	
	g_szPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	f_ClearData()
	f_ClearData0()
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "REQ" Then
		if sParam <> "" and sParam <> null then
			g_sAcno = Left(sParam, 8)
			g_sAsno = Right(sParam, 2)
			f_ClearData()
			DATAMANAGER.RequestTranData( "obrgt_dmac_104r" )
			DATAMANAGER.RequestTranData( "obrgt_dmac_105r" )
		end if
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb"  or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업	> test skip
		end if 													'							> test skip
	elseif sKeyName == "mhetc90060_p5" then 							'							> test skip
		if sRet ~= "cancel" then									'							> test skip
			f_Proc()
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
End Sub

'============================================================================
' grdList_OnClickUp() : 취소
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_Cancel" Then
		'비밀번호 체크
		If f_GetPWCkeck() Then
			Exit Sub	
		End If
		
		g_nSelectRow = IRow
		g_sCancelTranID = "obrgt_dmac_109a"
'		DATAMANAGER.RequestTranData( "obrgt_dmac_109a" )
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	End If
End Sub

'============================================================================
' grdList0_OnScrollEnd() : 넥스트 데이터 조회
'============================================================================
Sub grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData( "obrgt_dmac_104r" ) == True then 
		DATAMANAGER.RequestNextData( "obrgt_dmac_104r" )
	End If
End Sub

'============================================================================
' grdList0_OnClickUp() : 취소
'============================================================================
Sub grdList0_OnClickUp(lRow, szCellID)
	If szCellID == "bd_cancel" Then
		'비밀번호 체크
		If f_GetPWCkeck() Then
			Exit Sub
		End If
		
		g_nSelectRow0 = IRow
		g_sCancelTranID = "obrgt_dmac_108a"
'		DATAMANAGER.RequestTranData( "obrgt_dmac_108a" )
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	End If
End Sub

'============================================================================
' grdList_OnScrollEnd() : 넥스트 데이터 조회
'============================================================================
Sub grdList0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData( "obrgt_dmac_105r" ) == True then 
		DATAMANAGER.RequestNextData( "obrgt_dmac_105r" )
	End If
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'------------------------------ SET DATA ------------------------------
	DIm szACNT_PWD
	szACNT_PWD = Form.GetCtlProp("#EdtPswd", "caption")
	If g_szPlain_rm == "1" Then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = szACNT_PWD
	Else  							'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(szACNT_PWD)
	End If
	
	'------------------------------ SET INPUT ------------------------------
	'고객정보조회
	If szTranID == "obrgt_dmac_104r" or szTranID == "obrgt_dmac_105r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 				, 0 , g_sAsno )
		'인증 처리 프로세스
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID
		sDeviceID = Form.GetDeviceID()
'		sACNO = acnt0.total
		
		'v0001
		'AS-IS
		'sACNO_PWD = Form.GetEncData(g_szList(2))
		
		'TO-BE
		'obcsb_oimf_625r 에 pw전달하지 않아도됨. 기존 g_szList(2)는 rght_type_code로, 잘못된 값 전달중이었음. 삭제처리.
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "5" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD" 			, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO" 			, 0 , g_sAcno )
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE" 		, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO" 			, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_AMT" 			, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_TERM_IDNT_KEY" 	, 0 , sDeviceID )

	'신청
	ElseIf szTranID == "obrgt_dmac_109a" Then
		Dim szRghtDate, szMangBrcd
		szRghtDate 	= grdList.GetCellData("bd_RghtDate", g_nSelectRow)
		szMangBrcd 	= grdList.GetCellData("bd_Mang", g_nSelectRow)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "U" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOB_CLS_CODE" 		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RGHT_STND_DATE"		, 0 , szRghtDate )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MANG_BRCD"			, 0 , szMangBrcd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 				, 0 , g_sAsno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" 				, 0 , szACNT_PWD )
		
		Dim szIscd, nAbleQty, nCrclAbleQty, nOpstQty, nCrclOpstQty
		szIscd 		= grdList.GetCellData("bd_Iscd", g_nSelectRow)
		nAbleQty 	= tonumber(grdList.GetCellData("bd_AbleQty", g_nSelectRow))
		nCrclAbleQty 	= tonumber(grdList.GetCellData("bd_CrclAbleQty", g_nSelectRow))
		nOpstQty 	= tonumber(grdList.GetCellData("bd_OpstQty", g_nSelectRow))
		nCrclOpstQty 	= tonumber(grdList.GetCellData("bd_CrclOpstQty", g_nSelectRow))
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ISCD"				, 0 , szIscd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DMPR_ABLE_QTY"		, 0 , nAbleQty )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CRCL_DMPR_ABLE_QTY"	, 0 , nCrclAbleQty )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "OPST_INTN_EXRS_QTY" 		, 0 , nOpstQty )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CRCL_OPST_INTN_EXRS_QTY" 	, 0 , nCrclOpstQty )
	ElseIf szTranID == "obrgt_dmac_108a" Then
		Dim szRghtDate, szMangBrcd, szQty
		szRghtDate 	= grdList0.GetCellData("bd_rgtdate"	, g_nSelectRow0)
		szMangBrcd 	= grdList0.GetCellData("bd_mang"	, g_nSelectRow0)
		szQty 		= grdList0.GetCellData("bd_regqty"	, g_nSelectRow0)
		szItemCd 	= grdList0.GetCellData("bd_itemcd"	, g_nSelectRow0)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOB_CLS_CODE" 		, 0 , "U" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RGHT_STND_DATE"		, 0 , szRghtDate )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MANG_BRCD"			, 0 , szMangBrcd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 				, 0 , g_sAsno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" 				, 0 , szACNT_PWD )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DMPR_QTY" 			, 0 , szQty )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DMPR_PRC_PRCN_YN" 	, 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 				, 0 , szItemCd )
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obrgt_dmac_104r" Then
		dim nDataCnt, nRow, iIdx
		nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		nRow = CInt(grdList.rowcount)
		iIdx = nRow - nDataCnt
		for i=iIdx to nRow-1
			grdList.SetCellData( "bd_Cancel", i, "취소" )
			grdList.SetCellFgColor( "bd_Cancel", i, "4" )
		next
	elseIf szTranID == "obrgt_dmac_105r" Then
		dim nDataCnt, nRow, iIdx
		nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		nRow = CInt(grdList0.rowcount)
		iIdx = nRow - nDataCnt
		for i=iIdx to nRow-1
			grdList0.SetCellData( "bd_cancel", i, "취소" )
			grdList0.SetCellFgColor( "bd_cancel", i, "4" )
		next
		
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	'매수청구 신청 취소
	elseIf szTranID == "obrgt_dmac_108a" Then
		Form.ShowAlert("알림", "취소 완료되었습니다.")
		
		f_ClearData0()
		DATAMANAGER.RequestTranData( "obrgt_dmac_105r" )
	'반대의사 신청 취소
	elseIf szTranID == "obrgt_dmac_109a" Then
		Form.ShowAlert("알림", "취소 완료되었습니다.")
		
		f_ClearData()
		DATAMANAGER.RequestTranData( "obrgt_dmac_104r" )
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	Form.ShowAlert( "알림", szErrMsg )
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_sAcno &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub
