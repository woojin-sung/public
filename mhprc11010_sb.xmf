End Function

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	Change_Mini_Table()
	Set_RightUp()

	DATAMANAGER.RequestTranData("ohhts_3050_001r")
	DATAMANAGER.RequestTranData("ohhts_3050_004r")
	DATAMANAGER.RequestTranData("ohhts_5030_001r")
end Function

'============================================================================
' Cancel_RealData
'============================================================================
Function Cancel_RealData()
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")			' 선물체결 자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_futs_aspr")	
	DATAMANAGER.CancelRealData("ohhts_futs_cntg_1")		' 선물체결 자동갱신 취소(차트)
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")			' 옵션체결 자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_optn_aspr")	
	DATAMANAGER.CancelRealData("ohhts_optn_cntg_1")		' 옵션체결 자동갱신 취소(차트)
	DATAMANAGER.CancelRealData("ohhts_pric_extd")
	DATAMANAGER.CancelRealData("ohhts_pric_rstc")
	
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_sfut_aspr")
	DATAMANAGER.CancelRealData("ohhts_sopt_aspr")
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Init_Control()		'컨트롤 Init
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "JMCODE" then
		'Cancel_RealData()							' 무조건 리얼해제
		
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")

			g_szCd = tData(0)
			g_szMk = tData(1)
			
			Cancel_RealData()
			RequestData()	
			
			if g_szMk == "JO" or g_szMk == "JF" then
				hogaTbl.visible = false
				hogaTbl2.visible = true
				tblOptRT2.SetCellMaskInfo( 0, 1, "0,0,,,0,,0,1,1" )
				tblOptRT2.SetCellMaskInfo( 1, 1, "0,0,,,0,,0,1,1" )
				tblOptRT2.SetCellMaskInfo( 2, 1, "0,0,,,0,,0,1,1" )
				tblOptRT2.SetCellMaskInfo( 3, 1, "0,0,,,0,,0,1,1" )
			else
				hogaTbl.visible = true
				hogaTbl2.visible = false
			end if 
		end if	
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Cancel_RealData()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 미니선물현재가(시세&상세)
	' ----------------------------------------------------------------------		
    if szTranID = "ohhts_3050_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 미니선물현재가(호가)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_3050_004r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd	)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk	)    
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5030_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE",  0, "Y")
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue(0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szRstcYn
	Dim nTotalBuy, nTotalSel				' 총매수잔량, 총매도잔량
	
	' ----------------------------------------------------------------------
	' 미니선물현재가(시세&상세)
	' ----------------------------------------------------------------------
	if szTranID = "ohhts_3050_001r" then
		'호가컨트롤 속성		
		hogaTbl.startprice = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_OPRC2", 0)
		hogaTbl.highprice  = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_HPRC2", 0)
		hogaTbl.lowprice   = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_LPRC2", 0)		
		
		hogaTbl2.startprice = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_OPRC2", 0)
		hogaTbl2.highprice  = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_HPRC2", 0)
		hogaTbl2.lowprice   = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_LPRC2", 0)		
		
	    szRstcYn = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_RLTM_PRC_RSTC_YN", 0)
	    
	    if Trim(szRstcYn) <> "" then
		    g_nLimit = CInt(szRstcYn)
		    Change_Mini_Table()
	    end if
	    
	    DATAMANAGER.RequestRealData("ohhts_pric_rstc")
	    DATAMANAGER.RequestRealData("ohhts_pric_extd")	'실시간 상하한가 표시
	' ----------------------------------------------------------------------
	' 미니선물현재가(호가)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_3050_004r" then
		nTotalBuy = DATAMANAGER.GetDataValue(0, "ohhts_3050_004r", "OutBlock1", "FID_TOTAL_BIDP_RSQN", 0)
		nTotalSel = DATAMANAGER.GetDataValue(0, "ohhts_3050_004r", "OutBlock1", "FID_TOTAL_ASKP_RSQN", 0)
		
		hogaTbl.SetCellString(10, 1, CInt(nTotalBuy - nTotalSel))
		hogaTbl2.SetCellString(10, 1, CInt(nTotalBuy - nTotalSel))
	
		if g_szMk = "F" or  g_szMk = "MF" or g_szMk == "XF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)
			DATAMANAGER.RequestRealData( "ohhts_futs_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		    
		elseif g_szMk = "O" or g_szMk = "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
		    DATAMANAGER.RequestRealData( "ohhts_optn_aspr" )
		    DATAMANAGER.RequestRealData( "ohhts_optn_cntg" ) 
		elseif g_szMk = "JO" then
			DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_sopt_aspr" )
		elseif g_szMk = "JF" then
			DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_sfut_aspr" )
		end if
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5030_001r" then		
		if g_szMk = "F" or  g_szMk = "MF" or g_szMk == "XF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg_1" )
		elseif g_szMk = "O" or g_szMk = "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
		    DATAMANAGER.RequestRealData( "ohhts_optn_cntg_1" ) 
		end if	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 선물 호가/체결, 옵션 호가/체결, 파생 가격제한, 파생 실시간 가격제한여부
	' ----------------------------------------------------------------------	
	DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szCd )	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim nTotalBuy, nTotalSel				' 총매수잔량, 총매도잔량
	
	' ----------------------------------------------------------------------
	' 선물호가, 옵션호가 자동갱신
	' ----------------------------------------------------------------------
	if szTranID = "ohhts_futs_aspr" or szTranID = "ohhts_optn_aspr" then		
		nTotalBuy = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN", 0)
		nTotalSel = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN", 0)
		
		hogaTbl.SetCellString( 10, 1, CInt(nTotalBuy - nTotalSel))
	elseif szTranID = "ohhts_sopt_aspr" or szTranID = "ohhts_sfut_aspr" then	
		nTotalBuy = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN", 0)
		nTotalSel = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN", 0)
		
		hogaTbl2.SetCellString( 10, 1, CInt(nTotalBuy - nTotalSel))
	end if
End Sub

'============================================================================
' tblFutRT1_OnClick
'============================================================================
Sub tblFutRT1_OnClick(lRow , lColumn)
	if lRow = 0 And lColumn = 0 then
		Change_RightUp()
	end if
End Sub

'============================================================================
' tblFutRT2_OnClick
'============================================================================
Sub tblFutRT2_OnClick(lRow , lColumn)
	if lRow = 0 And lColumn = 0 then
		Change_RightUp()
	end if
End Sub





