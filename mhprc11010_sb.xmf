'============================================================================
' Change_RightUp
'============================================================================
Function Change_RightUp()
	Set_RightUp()
	
	if g_nRup = 3 then
		g_nRup = 1
	else
		g_nRup = g_nRup + 1
	end if
End Function

'============================================================================
' Set_RightUp
'============================================================================
Function Set_RightUp()
    if g_szMk = "F" or g_szMk = "MF" or g_szMk = "JF" or g_szMk = "JO" then 
		if g_nRup = 1 then
		    tblOptRT1.visible = true
		    tblOptRT2.visible = false
'		    MChart1.visible = false
		elseif g_nRup = 2 then
		    tblOptRT1.visible = false
		    tblOptRT2.visible = true
'		    MChart1.visible = false
'		elseif g_nRup = 3 then
'		    tblOptRT1.visible = false
'		    tblOptRT2.visible = false
' 		    MChart1.visible = true
		end if
    else
	    if g_nRup = 1 then
		    tblFutRT1.visible = true
		    tblFutRT2.visible = false
'		    MChart1.visible = false
		elseif g_nRup = 2 then
		    tblFutRT1.visible = false
		    tblFutRT2.visible = true
'		    MChart1.visible = false
'		elseif g_nRup = 3 then
'		    tblFutRT1.visible = false
'		    tblFutRT2.visible = false
'		    MChart1.visible = true
		end if
    end if
End Function

'============================================================================
' Init_Control
'============================================================================
Function Init_Control()
	'왼쪽 상단
	tblFutRT2.left = 206
	tblOptRT1.left = 206
	tblOptRT2.left = 206
	
	tblFutRT2.visible = false
	tblOptRT1.visible = false
	tblOptRT2.visible = false
	
	'왼쪽 하단
'	tblLT1.left = 1
'	tblLT2.left = 1
'	tblLT3.left = 1
'	tblLT4.left = 1
'	tblLT1.top = 129
'	tblLT2.top = 129
'	tblLT3.top = 129
'	tblLT4.top = 129
'	
