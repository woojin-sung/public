	<SCRIPT_INFO _len="7067" _ulen="6693" >
'============================================================================
' 01.화면명 	: 청탁금지거래상대방정보관리
' 02.화면설명	: 청탁금지거래상대방정보관리화면
' 03.작성	: 2016.09.22
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szName					'성명
dim g_szType					'구분
dim g_szCheck					'고객여부
dim g_szAccount				'계좌번호
dim g_szOffice_name			'직장명
dim g_szPartname				'부서명
dim g_szInstitution_check		'청탁기관여부
dim g_szPhone					'연락처
dim g_szAffairs_check			'공무수행사인여부

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Button1_OnClick()

	if g_szCheck == "1" then
		if g_szName = "" then
			Form.ShowAlert("알림","성명을 입력해주세요")
			exit sub
		elseif g_szOffice_name = "" then
			Form.ShowAlert("알림","직장명을 입력해주세요")
			exit sub
		elseif g_szInstitution_check == "" then
			Form.ShowAlert("알림","청탁기관여부를 입력해주세요")
			exit sub
		end if
	elseif g_szCheck == "2" then
		if g_szName = "" then
			Form.ShowAlert("알림","성명을 입력해주세요")
			exit sub
		elseif g_szOffice_name = "" then
			Form.ShowAlert("알림","직장명을 입력해주세요")
		elseif g_szInstitution_check == "" then
			Form.ShowAlert("알림","청탁기관여부를 입력해주세요")
		exit sub
		end if
	end if
	
	DATAMANAGER.RequestTranData("obcmp_momt_474a")
End Sub

'============================================================================
Sub Edit0_OnEditComplete()
	g_szName = Edit0.caption
End Sub

'============================================================================


'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	if iIndex == 0 then
		g_szCheck = "1"
	else
		g_szCheck = "2"
	end if
End Sub

'============================================================================
Sub Edit3_OnEditComplete()
	g_szAccount = Edit3.caption
End Sub

'============================================================================
Sub Edit4_OnEditComplete()
	g_szOffice_name = Edit4.caption
End Sub

'============================================================================
Sub Edit5_OnEditComplete()
	g_szPartname = Edit5.caption
End Sub

'============================================================================
Sub Edit1_OnEditComplete()
	g_szPhone = Edit1.caption
End Sub

'============================================================================
Sub Combo2_OnEditComplete(iIndex)
	
	if iIndex == 0 then
		g_szAffairs_check = "Y"
		
	else
		g_szAffairs_check = "N"
		
	end if
	
	if iIndex == 0 then
		if g_szInstitution_check == "N" then
			g_szInstitution_check = "Y"
			Edit6.caption = "청탁금지대상"
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szName = ""
	g_szType = "4"
	g_szCheck = "1"
	g_szAccount = ""
	g_szOffice_name = ""
	g_szPartname = ""
	g_szPhone = ""
	g_szAffairs_check = ""
	g_szInstitution_check = "Y"
	Edit6.caption = ""
	Edit4.enable = false
	
End Sub

'============================================================================
'

'============================================================================
Sub Button0_OnClick()
	Form.OpenPopup("mbonl91001_p1.xmf" , "" , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "check" then
		Edit6.caption = sRet
		g_szInstitution_check = sRet
		
		if sRet == "Y" then
			Edit6.caption = "청탁금지대상"
		elseif sRet == "N" then
			Edit6.caption = "청탁금지비대상"
		end if
		
		if sRet == "N" then
			Combo2.currentindex = 1
			g_szAffairs_check = "N"
			
		end if
	elseif sKeyName == "name" then
		Edit4.caption = sRet
		g_szOffice_name = sRet
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)


	if szTranID = "obcmp_momt_474a" then
		
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "PROS_CLS_CODE",0,"I")
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "TR_CNRP_MNNO" , 0 , "")
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "TR_CNRP_NAME" , 0 , g_szName)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "CUST_CLS_CODE" , 0 , g_szType)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "TR_CNRP_CUST_CLCD", 0 , g_szCheck)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "ACNO" , 0 , g_szAccount)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "WRPL_NAME" , 0 , g_szOffice_name)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "DPNM", 0 , g_szPartname)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "RMRK", 0 , "")
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "TR_CNRP_TELNO" , 0 , g_szPhone)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "TRGT_YN" , 0 , g_szInstitution_check)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_474a", "InBlock1", "ISTU_BSWR_ACMP_YN" , 0 , g_szAffairs_check)
		
		DATAMANAGER.SetEventFlag("obcmp_momt_474a", "A")
		
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcmp_momt_474a" then
		Form.Toast(0,"등록되었습니다",0.5)
		
		g_szName = ""
		g_szType = "4"
		g_szCheck = "1"
		g_szAccount = ""
		g_szOffice_name = ""
		g_szPartname = ""
		g_szPhone = ""
		g_szAffairs_check = ""
		g_szInstitution_check = "Y"
		
		Edit0.caption = g_szName
		Combo1.currentindex = 0
		Edit3.caption = g_szAccount
		Edit4.caption = g_szOffice_name
		Edit5.caption = g_szPartname
		Edit1.caption = g_szPhone
		Edit6.caption = ""
		Combo2.currentindex = 0
		
		
		Form.CloseForm()
	end if
End Sub

'============================================================================

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szErrCode == "6660" then
		Form.ShowAlert("오류", "이미 등록된 사용자입니다")
	end if
End Sub

	</SCRIPT_INFO>
