Sub Form_OnFormClose()
'	Form.SaveConfigData("mhprc31050", "frmTab", g_nfmTab)
End Sub

'======================================
' Form_OnTriggerEvent
'======================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 매수/매도화면에서 잔고팝업 오픈 요청
	' ----------------------------------------------------------------------	
	if sEventName = "31030_BALANCE_OPEN" then
		Form.OpenFramePopup("mbtrf31030_pb", acnt.total & "★" & acnt.sequence & "★" & "0", "")	
		
	ElseIf sEventName = "SCREEN_MENU" Then
		If sParam = "POP_UP1" Then								' 예수금			
			Form.OpenPopup("mbtrf31030_pc", acnt.total & "★" & acnt.sequence, "")
			
		ElseIf sParam = "POP_UP2" Then								' 주문가능
			if Trim(lblPrc.caption) == "" then
				Form.OpenPopup("mbtrf31030_pd", acnt.total & "★" & acnt.sequence & "★" & g_szCd & "★" & lblHyun.caption, "")	
			else
				Form.OpenPopup("mbtrf31030_pd", acnt.total & "★" & acnt.sequence & "★" & g_szCd & "★" & lblPrc.caption, "")	
			end if			
		ElseIf sParam = "POP_UP3" Then								' 예약주문 유의사항
			Form.OpenPopup("mbtrf31050_p1" , "" , "")
		End If
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "4:14:30", "")		' 선물옵션:주식선물옵션:상품선물
	'20220922 SWJ END
	End If

End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 잔고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName = "31030_BALANCE" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			Form.SetItemCode(tData(2))

			' 폼탭변경(0:매수, 1:매도, 2:정정, 3:취소)
			if Trim(tData(1)) = "" then
				fmTab.currenttab = "0"
			else
				fmTab.currenttab = tData(1)
			end if
		
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3))
		end if
		
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
	end if	
End Sub

'======================================
' fmTab_OnTabChanged
'======================================
Sub fmTab_OnTabChanged(nCurrentTab)
	g_nfmTab = nCurrentTab
	
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", g_szCd)	' 폼탭화면에 종목코드 던지기
	
	if nCurrentTab = 0 or nCurrentTab = 1 then
		tblOldHigh.visible = true
		tblOldLow.visible  = true
		contHoga.visible	 = true

	else
		tblOldHigh.visible = false
		tblOldLow.visible  = false
		contHoga.visible	 = false
		
	end if
	
	Return_AutoPrice()
End Sub

'======================================
' DATAMANAGER_OnSendTranBefore
'======================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
	if szTranID = "obtrf_oder_408r" then
		Dim szItem
		
		If Len(g_szCd) = 5 Then
			szItem = "K" & g_szCd & "000"
		Else
			szItem = "K" & g_szCd
		End If
		
		DATAMANAGER.ClearInputData(0, "obtrf_oder_408r")
		
		DATAMANAGER.SetDataValue(0,"obtrf_oder_408r", "InBlock1", "ISCD" 						, 0, szItem)
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_3050_004r" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "31030_HOGA", "")
			
		DATAMANAGER.ClearInputData(0, "ohhts_3050_004r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_ISCD"              	, 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMk)
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_3050_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_3050_001r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"              	, 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMk)
		
	' ----------------------------------------------------------------------
	' 주식선물현재가(호가)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_3070_003r" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "31030_HOGA", "")
			
		DATAMANAGER.ClearInputData(0, "ohhts_3070_003r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_3070_003r", "InBlock1", "FID_INPUT_ISCD"              	, 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3070_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMk)
	' ----------------------------------------------------------------------
	' 주식선물현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
	elseif szTranID ="ohhts_3070_001r"  then
		DATAMANAGER.ClearInputData(0, "ohhts_3070_001r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD"              	, 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMk)		
	end if	
End Sub

'======================================
' DATAMANAGER_OnReceiveTranComplete
'======================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
    if szTranID = "ohhts_3050_002r" then
	    '20180323 LES START - 코스닥150옵션/KRX300선물 추가
		if g_szMk = "O" or g_szMk = "MO" or g_szMk = "QO" or g_szMk = "WO" then	' 20190809_01 HWG : 위클리옵션추가
			DATAMANAGER.RequestRealData("ohhts_optn_cntg")
		
		'20220915 LES START 상품선물 추가
		'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
		elseif g_szMk = "CF" or g_szMk = "FF" then
		
			DATAMANAGER.RequestRealData("ohhts_cfut_cntg")
		
		'20220915 LES END 
		
		
		else
			DATAMANAGER.RequestRealData("ohhts_futs_cntg")
		end if
		
		DATAMANAGER.RequestRealData("ohhts_pric_extd")
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_3050_004r" then			
		DATAMANAGER.RequestTranData("ohhts_3050_002r")	' 현재가(시간별)
		DATAMANAGER.RequestTranData("ohhts_3050_001r")	' 현재가(시세&상세내역)
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		
		'20180323 LES START - 코스닥150옵션/KRX300선물 추가
		if g_szMk = "O" or g_szMk = "MO" or g_szMk ="QO" or g_szMk = "WO" then	' 20190809_01 HWG : 위클리옵션추가	
			DATAMANAGER.RequestRealData("ohhts_optn_aspr")
		
		'20220915 LES START 상품선물 추가
		'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
		elseif g_szMk = "CF" or g_szMk = "FF" then
		
			DATAMANAGER.RequestRealData("ohhts_cfut_aspr")
		
		'20220915 LES END 
		
		else
			DATAMANAGER.RequestRealData("ohhts_futs_aspr")
		end if
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
    elseif szTranID = "ohhts_3050_001r" then
		Return_AutoPrice()
		
	' ----------------------------------------------------------------------
	' 주식선물현재가(호가)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_3070_003r" then			
		DATAMANAGER.RequestTranData("ohhts_3070_001r")	' 주식선물현재가
		
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		
		if g_szMk = "JO" then
			DATAMANAGER.RequestRealData( "ohhts_sopt_aspr" )	'호가
			DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )	'체결
		else
			DATAMANAGER.RequestRealData( "ohhts_sfut_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )	'체결
		end if
		
		
		DATAMANAGER.RequestRealData("ohhts_pric_rstc")		'파생 실시간 가격제한여부실시
		
    end if
End Sub

'======================================
' DATAMANAGER_OnSendRealBefore
'======================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 선물체결 자동갱신
