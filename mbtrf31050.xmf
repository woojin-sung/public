'-------------------------------------------------------------------------------------------

'20220915 LES START 상품선물 추가

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
Dim g_szChangeInit
g_szChangeInit = ""
'20170919 HAMWG END

'주문 환경
Dim g_szSavePwd 
g_szSavePwd  = "0"
' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
g_szCd = ""
g_szMk = ""

Dim g_szSlt
g_szSlt = "HOGA"

Dim g_szType
g_szType = ""

Dim g_nfmTab


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
	
	g_szBuyPrc = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_BUYPRC")		' 선옵매수주문가격 자동입력
	g_szSelPrc = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_SELPRC")		' 선옵매도주문가격 자동입력
	g_szModPrc = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_MODPRC")		' 선옵정정주문가격 자동입력
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			' 원주문번호 자동입력
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부

	' 선옵매수주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 선옵매도주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 선옵정정주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
End Function

'======================================
' Click_Hoga
'======================================
Function Click_Hoga(szClk)
	'2018.01.04 스프레드인 경우에만 0, 0.00 값 셋팅 하도록 했으나, 이경민 대리님 요청으로
	'			종목에 상관없이 0, 0.00 값 셋팅하도록 변경
	'nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))	
	'if ((g_szMk == "F" and nzInnerMarket == 4) or (g_szMk == "JF" and nzInnerMarket == 16)) or (Trim(szClk) <> "" and CDbl(szClk) <> 0) then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "31030_HOGA", szClk)
	'end if
End Function

'======================================
' Request_Hoga
'======================================
Function Request_Hoga(szCd)
	if szCd <> g_szCd then
		g_szCd = szCd
		g_szMk = Trim(Form.GetItemCodeInfo(szCd, "market"))
		
		DATAMANAGER.CancelRealData("ohhts_futs_antg")
		DATAMANAGER.CancelRealData("ohhts_futs_aspr")
		DATAMANAGER.CancelRealData("ohhts_futs_cntg")
		DATAMANAGER.CancelRealData("ohhts_optn_antg")
		DATAMANAGER.CancelRealData("ohhts_optn_aspr")
		DATAMANAGER.CancelRealData("ohhts_optn_cntg")
		DATAMANAGER.CancelRealData("ohhts_pric_extd")
		
		DATAMANAGER.CancelRealData( "ohhts_sfut_aspr" )	'주식선물호가자동갱신
		DATAMANAGER.CancelRealData( "ohhts_sopt_aspr" )	'주식옵션호가자동갱신
		DATAMANAGER.CancelRealData( "ohhts_sfut_cntg" )	'주식선물체결자동갱신
		DATAMANAGER.CancelRealData( "ohhts_sopt_cntg" )	'주식옵션체결자동갱신
		DATAMANAGER.CancelRealData( "ohhts_pric_rstc" )	'파생 실시간 가격제한여부 실시
		
		'20220915 LES START 상품선물 추가
		DATAMANAGER.CancelRealData("ohhts_cfut_aspr")
		DATAMANAGER.CancelRealData("ohhts_cfut_cntg")
		DATAMANAGER.CancelRealData("ohhts_cfut_antg")
		'20220915 LES END
		
		DATAMANAGER.RequestTranData("obtrf_oder_408r")	' 예상상하한가조회
		
		if g_szMk == "JF" or g_szMk == "JO" then
			contHoga.hogaTbl2.visible = true
			contHoga.hogaTbl.visible = false
			contHoga.tblHigh.SetCellMaskInfo( 0, 1, "0,0,,,0,,0,1,1" )
			contHoga.tblLow.SetCellMaskInfo( 0, 1, "0,0,,,0,,0,1,1" )
			tblOldHigh.SetCellMaskInfo(0, 2, "0,0,,,0,,0,1,1")
			tblOldLow.SetCellMaskInfo(0, 2, "0,0,,,0,,0,1,1")
			DATAMANAGER.RequestTranData("ohhts_3070_003r")	' 현재가(호가)
		else
			contHoga.hogaTbl2.visible = false
			contHoga.hogaTbl.visible = true
			contHoga.tblHigh.SetCellMaskInfo( 0, 1, "0,0,,,0,,2,1,1" )
			contHoga.tblLow.SetCellMaskInfo( 0, 1, "0,0,,,0,,2,1,1" )
			tblOldHigh.SetCellMaskInfo(0, 2, "0,0,,,0,,2,1,1")
			tblOldLow.SetCellMaskInfo(0, 2, "0,0,,,0,,2,1,1")
			
			DATAMANAGER.RequestTranData("ohhts_3050_004r")	' 현재가(호가)
		end if
		
	else
		' 변경사항이 전혀 없을때
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "NO_RETURN", "")	
	end if
End Function

'============================================================================
' Return_AutoPrice : 가격 자동연동(화면실행 or 탭변경시)
'============================================================================
Function Return_AutoPrice()
	Dim szTab, szAuto
	
	'20170919 HAMWG START : 탭/종목 변경시 초기화 반영
	if g_szChangeInit == "1" then		' 20160324 종목/탭 변경시 초기화 사용시는 가격자동연동 제외
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AUTO_PRICE", "")
		Exit Function
	end if
	'20170919 HAMWG END
	
	szTab = CStr(fmTab.currenttab)

	if szTab <> "3" then
		if szTab == "0" then
			szAuto = g_szBuyPrc
		elseif szTab == "1" then
			szAuto = g_szSelPrc
		elseif szTab == "2" then
			szAuto = g_szModPrc
		end if
		
		Select Case szAuto
			Case "1"											' 매도5호가
				szPrc = contHoga.hogaTbl.GetCellString( 0, 0)
			Case "2"											' 매도4호가
				szPrc = contHoga.hogaTbl.GetCellString( 1, 0)
			Case "3"											' 매도3호가
				szPrc = contHoga.hogaTbl.GetCellString( 2, 0)
			Case "4"											' 매도2호가
				szPrc = contHoga.hogaTbl.GetCellString( 3, 0)
			Case "5"											' 매도1호가
				szPrc = contHoga.hogaTbl.GetCellString( 4, 0)
			Case "6"											' 현재가
				szPrc = lblHyun.caption					
			Case "7"											' 매수1호가
				szPrc = contHoga.hogaTbl.GetCellString(5, 0)
			Case "8"											' 매수2호가
				szPrc = contHoga.hogaTbl.GetCellString(6, 0)
			Case "9"											' 매수3호가
				szPrc = contHoga.hogaTbl.GetCellString(7, 0)
			Case "10"										' 매수4호가
				szPrc = contHoga.hogaTbl.GetCellString(8, 0)
			Case "11"										' 매수5호가
				szPrc = contHoga.hogaTbl.GetCellString(9, 0)
			Case "12"										' 상한가
				szPrc = lblHigh.caption
			Case "13"										' 하한가
				szPrc = lblLow.caption
			Case Else										' 미적용 및 기타에러
				szPrc = ""
		End Select		

		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AUTO_PRICE", szPrc)
	end if
End Function

