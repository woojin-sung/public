		DATAMANAGER.SetDataValue(1, "ohhts_sopt_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 주식선물체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_sfut_cntg"  then
		DATAMANAGER.SetDataValue(1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	
	' ----------------------------------------------------------------------
	' 주식옵션체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_sopt_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 파생 실시간 가격제한여부 실시
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_pric_rstc" then
		DATAMANAGER.SetDataValue(1, "ohhts_pric_rstc", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)	
	
	'20220915 LES START 상품선물 추가
	' ----------------------------------------------------------------------
	' 상품선물 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_cfut_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
