	' 상품선물 호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_cfut_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_cfut_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 상품선물 예상체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_cfut_antg" then
		DATAMANAGER.SetDataValue(1, "ohhts_cfut_antg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	
	'20220915 LES END
	
	
	end if
