Sub Form_OnFormInitBefore()
	Dim szPopup
	szPopup = Form.LoadConfigData( "mbtrf31050", "mbtrf31050_p1" )
	
	If szPopup <> "1" Then
		Form.OpenPopup( "mbtrf31050_p1", "" , "")
	End If
End Sub


'======================================
' Form_OnFormInit
'======================================
Sub Form_OnFormInit()
	Dim szCd
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	Load_OrderSet()
	
	'10호가창 중간위치
	contHoga.scroll_pos = "vcenter"
	
	'20220915 LES START 상품선물(30) 추가
	' 종목컨트롤
	Form.SetSearchType ("4:14:30")
	'20220915 LES END
	
'	g_nfmTab = CDbl( Form.LoadConfigData( "mhprc31050", "frmTab" ) )
'	fmTab.currenttab = g_nfmTab
'	fmTab_OnTabChanged( g_nfmTab )

	szCd = Form.GetSharedData("&ITEM_FUTOPT", 0)		' 최근조회종목
	Form.SetItemCode(szCd)							' 최초 화면진입시 종목코드 설정
	Form.triggerEvent("linkfm", "INIT_CODE", szCd)	' 링크화면에 종목코드 던지기
	
	fmTab_OnTabChanged( CInt(fmTab.currenttab) )
End Sub

'======================================
' Form_OnLinkData
'======================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		edtOrgNo.caption = ""
		edtModTab.caption = ""
		edtCnlTab.caption = ""
		
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		
		Request_Hoga(sValue)
	end	if	
End Sub

