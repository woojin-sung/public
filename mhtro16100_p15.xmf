		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="PTP종목 주문 주의 안내" bgcolor="092:185046046" halign="1" ly_vert="0,240,375,60,1" />
		<LABEL name="Label0" fontsize="-1" caption="해당종목은 PTP(Publicly Traded Partnership)로" ly_vert="20,310,335,32,1" />
		<LABEL name="Label1" fontsize="-1" caption="지정된 종목으로 美 국세청 *Section 1446(f) " ly_vert="20,340,335,32,1" />
		<LABEL name="Label2" fontsize="-1" caption="조항에 근거하여 매도일 기준" ly_vert="20,370,335,32,1" />
