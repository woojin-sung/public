	<SCRIPT_INFO _len="6500" _ulen="6098" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주문체결(제세금포함)
' 02. 화면설명 : 매매일지 탭화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_ItemMarket

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode 	 =  Form.GetSharedData( "&ITEM_CODE", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

End Sub

'============================================================================
Sub Form_OnFormInit()
	btnSearch_OnClick()
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID) 
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")

	DATAMANAGER.SetDataValue( false, "obtrs_stlm_315r", "InBlock1", "ACNO"			, 0, szACNO )		'계좌번호
	DATAMANAGER.SetDataValue( false, "obtrs_stlm_315r", "InBlock1", "ASNO"			, 0, szASNO )		'계좌일련번호
	DATAMANAGER.SetDataValue( false, "obtrs_stlm_315r", "InBlock1", "DEAL_CLS_CODE"	, 0, "0"    )		'매매구분코드 0:전체 1:매도 2:매수
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	Dim iCnt, szData
	Dim szLOAN_DATE
	
	For iCnt = grd0.rowcount - 1 To 0 Step -1
		Dim szItem, szMarket
		
		szItem = grd0.GetCellData( "bd_cell16", iCnt)
		szMarket = Form.GetItemCodeInfo(szItem, "market")
	
		'매매구분
		szData = grd0.GetCellData( "bd_cell17", iCnt)
		Select Case szData
			Case "1" grd0.SetCellData("bd_cell1", iCnt, "매도")
					grd0.SetCellFgColor("bd_cell1", iCnt, "11")
			Case "2" grd0.SetCellData("bd_cell1", iCnt, "매수")
					grd0.SetCellFgColor("bd_cell1", iCnt, "10")
		End Select
		
		
		'대출상세유형코드
		szData = grd0.GetCellData( "bd_cell9", iCnt)
		szLOAN_DATE = grd0.GetCellData("bd_cell18", iCnt)
		
		Select Case szData
		    Case "0000" grd0.SetCellData("bd_cell9", iCnt, "보통")
		    Case "0101" grd0.SetCellData("bd_cell9", iCnt, "자기융자")
		    Case "0102" grd0.SetCellData("bd_cell9", iCnt, "유통융자")
		    Case "0103" grd0.SetCellData("bd_cell9", iCnt, "자기대주")
		    Case "0104" grd0.SetCellData("bd_cell9", iCnt, "유통대주")
		    Case "0201" grd0.SetCellData("bd_cell9", iCnt, "예탁주식")
		    Case "0202" grd0.SetCellData("bd_cell9", iCnt, "예탁채권")
		    Case "0203" grd0.SetCellData("bd_cell9", iCnt, "예탁집합투자")
		    Case "0204" grd0.SetCellData("bd_cell9", iCnt, "예탁장외파생")
		    Case "0211" grd0.SetCellData("bd_cell9", iCnt, "예탁유통주식")
		    Case "0212" grd0.SetCellData("bd_cell9", iCnt, "예탁유통채권")
		    Case "0213" grd0.SetCellData("bd_cell9", iCnt, "예탁유통집합투자")
		    Case "0214" grd0.SetCellData("bd_cell9", iCnt, "예탁유통장외파생")
		    Case "0301" grd0.SetCellData("bd_cell9", iCnt, "매도증권담보대출")
		    Case "0302" grd0.SetCellData("bd_cell9", iCnt, "수익증권환매")
		    Case "0303" grd0.SetCellData("bd_cell9", iCnt, "ELS환매자금대출")
		    Case "0401" grd0.SetCellData("bd_cell9", iCnt, "소액주식")
		    Case "0402" grd0.SetCellData("bd_cell9", iCnt, "소액채권")
		    Case "0403" grd0.SetCellData("bd_cell9", iCnt, "소액수익증권")
		    Case "0404" grd0.SetCellData("bd_cell9", iCnt, "소액 ELS")
		    Case "0501" grd0.SetCellData("bd_cell9", iCnt, "공모주청약")
		    Case "0502" grd0.SetCellData("bd_cell9", iCnt, "ELS청약")
		    Case "0503" grd0.SetCellData("bd_cell9", iCnt, "주식매입")
		    Case "0601" grd0.SetCellData("bd_cell9", iCnt, "매입자금대출")
		    Case "0701" grd0.SetCellData("bd_cell9", iCnt, "초단기대출")
		    Case "0801" grd0.SetCellData("bd_cell9", iCnt, "CMA담보대출")
		    Case Else	  grd0.SetCellData("bd_cell9", iCnt, szData)
		End Select
		if szData = "0000" and szLOAN_DATE <> "00000000" then
			grd0.SetCellData("bd_cell9", iCnt, "주식대여")
		end if
	Next

End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrs_stlm_315r" )

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	szData = cldFrom.caption & "|" & cldTo.caption


	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrs12050_h0" , szData , "" )
		
	ElseIf sEventName = "RECEIVE" Then
		btnSearch_OnClick()
		
	ElseIf sEventName = "CHANGE_ACCTNO" Then
		btnSearch_OnClick()
		
	ElseIf sEventName = "SCREEN_MENU" Then
		If sParam = "SET_GRIDCOL" then
			grd0.showconfig("컬럼 순서 변경")
			
		end if
	End If		

	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbtrs12050" Then
		Dim arrData, szACNO
	
		szACNO = Form.GetCtlProp("#acnt0", "caption")
	
		arrData = Split(sRet,"|")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if
		
		cldFrom.caption	= arrData(0)
		cldTo.caption		= arrData(1)

		If szACNO <> arrData(2) Then
			Form.SetCtlProp( "#acnt0", "caption", arrData(2) )
		Else		
			btnSearch_OnClick()
		End If
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert( szErrCode , szErrMsg )
End Sub

