Dim g_szFncd
Dim g_szSta_Date
Dim g_szFin_Date
Dim g_NextCnt
'============================================================================
Sub Form_OnFormInitBefore()
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	g_szFncd = edtFundCd.caption
End Sub
'============================================================================
Sub Form_OnFormInit()
		
	'야간선옵 고유 주문체결조회(MTS)
	if len(trim(g_szFncd)) > 0 Then
		DATAMANAGER.RequestTranData("obtrf_cntg_715r")
	End if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obtrf_cntg_715r" then
	
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
	
		'전체/체결/미체결
		if rdoType.currentindex = "0" then
			g_szCntgType = "0"
		elseif rdoType.currentindex = "1" then
			g_szCntgType = "1"
		else
			g_szCntgType = "2"
		end if
		
		'전체/매수/매도
		if rdoType2.currentindex = "0" then
			g_szDealType = "%"
		elseif rdoType2.currentindex = "1" then
			g_szDealType = "2"
		elseif rdoType2.currentindex = "2" then
			g_szDealType = "1"
		end if
	
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_715r", "InBlock1", "FNCD" 			, 0 , g_szFncd)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_715r", "InBlock1", "IQRY_CLS_CODE"    , 0 , "0")	'0:전체 1:선물 2:콜옵션 3:풋옵션
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_715r", "InBlock1", "DEAL_CLS_CODE"	, 0 , g_szDealType)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_715r", "InBlock1", "CNTG_FIN_CLS_CODE", 0 , g_szCntgType) '0:전체 1:체결 2:미체결
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_715r", "InBlock1", "ISCD"			, 0 , "")
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_715r", "InBlock1", "ODER_NO"			, 0 , 0)

		
	end if
End Sub

'============================================================================
' 체결구분 선택시
'============================================================================
Sub rdoType_OnClick(nIndex)
		g_NextCnt = 0
		DATAMANAGER.ClearOutputData(0, "obtrf_cntg_715r")
		
		DATAMANAGER.RequestTranData("obtrf_cntg_715r")
End Sub
'============================================================================
' 매매구분 선택시
'============================================================================
Sub rdoType2_OnClick(nIndex)
		g_NextCnt = 0
		DATAMANAGER.ClearOutputData(0, "obtrf_cntg_715r")
		
		DATAMANAGER.RequestTranData("obtrf_cntg_715r")		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obtrf_cntg_715r" then
		
		for i = g_NextCnt to grd0.rowcount - 1
		
			deal_cls_code   = grd0.GetCellData("side_output", i)
			deal_cls_name	  = ""
			
			rctf_cncl_cls_code = grd0.GetCellData("rctf_cncl_cls_code_output", i)
			rctf_cncl_cls_name = ""
			
			aspr_type_code = grd0.GetCellData("aspr_type_code_output", i)
			aspr_type_name = ""
			
			oder_pros_stat_cls_code = grd0.GetCellData("pros_stat_cls_code", i)
			
			' 매매구분
			if deal_cls_code = "1" then '매도
				deal_cls_name = "매도"
				grd0.SetCellData("side", i, deal_cls_name)
				grd0.SetCellFgColor("side", i, "11")
			elseif deal_cls_code = "2" then 				'매수
				deal_cls_name = "매수"
				grd0.SetCellData("side", i, deal_cls_name)
				grd0.SetCellFgColor("side", i, "10")
			end if
			
			'정정취소구분
			if rctf_cncl_cls_code = "1" then
				rctf_cncl_cls_name = rctf_cncl_cls_name & "정상"
			elseif rctf_cncl_cls_code = "2" then
				rctf_cncl_cls_name = rctf_cncl_cls_name & "정정접수"
			elseif rctf_cncl_cls_code = "3" then
				rctf_cncl_cls_name = rctf_cncl_cls_name & "정정확인"
			elseif rctf_cncl_cls_code = "4" then
				rctf_cncl_cls_name = rctf_cncl_cls_name & "취소접수"
			elseif rctf_cncl_cls_code = "5" then
				rctf_cncl_cls_name = rctf_cncl_cls_name & "취소확인"
			else
				rctf_cncl_cls_name = rctf_cncl_cls_name
			end if
			
			grd0.SetCellData("rctf_cncl_cls_code", i, rctf_cncl_cls_name)

			'주문유형
			if aspr_type_code = "1" then
				grd0.SetCellData("aspr_type_code", i, "시장가")
			elseif aspr_type_code = "2" then
				grd0.SetCellData("aspr_type_code", i, "지정가")
			elseif aspr_type_code = "3" then
				grd0.SetCellData("aspr_type_code", i, "경쟁대량")
			elseif aspr_type_code = "I" then
				grd0.SetCellData("aspr_type_code", i, "조건부지정가")
			elseif aspr_type_code = "X" then
				grd0.SetCellData("aspr_type_code", i, "최유리지정가")
			elseif aspr_type_code = "Y" then
				grd0.SetCellData("aspr_type_code", i, "최우선지정가")				
			elseif aspr_type_code = "T" then
				grd0.SetCellData("aspr_type_code", i, "시장가(실시간가격제한)")
			elseif aspr_type_code = "W" then
				grd0.SetCellData("aspr_type_code", i, "최유리지정가(실시간가격제한)3")
			elseif aspr_type_code = "J" then
				grd0.SetCellData("aspr_type_code", i, "지정가전환")
			end if
			
			'상태구분
			if oder_pros_stat_cls_code = "0" then
				grd0.SetCellData("oder_pros_stat_cls_code", i, "미접수")
			elseif oder_pros_stat_cls_code = "1" then
				grd0.SetCellData("oder_pros_stat_cls_code", i, "접수")
			elseif oder_pros_stat_cls_code = "2" then
				grd0.SetCellData("oder_pros_stat_cls_code", i, "확인")
			elseif oder_pros_stat_cls_code = "3" then
				grd0.SetCellData("oder_pros_stat_cls_code", i, "거부")
			elseif oder_pros_stat_cls_code = "4" then
				grd0.SetCellData("oder_pros_stat_cls_code", i, "PT효력정지")
			end if
		next
		
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtrf_cntg_715r", "OutBlock1")
		
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_NextCnt = 0
End Sub

'============================================================================
' 연속조회
'============================================================================
Sub grd0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obtrf_cntg_715r" ) then
		DATAMANAGER.RequestNextData( "obtrf_cntg_715r" )
	end if
End Sub
'============================================================================
' 조회버튼
'============================================================================
Sub btnSearch_OnClick()
	g_NextCnt = 0
	DATAMANAGER.RequestTranData("obtrf_cntg_715r")	
End Sub
'============================================================================
' 펀드코드 변경시 
'============================================================================
Sub edtFundCd_OnEditComplete()
	g_szFncd = edtFundCd.caption
	g_NextCnt = 0
	DATAMANAGER.RequestTranData( "obtrf_cntg_715r" )
End Sub
'============================================================================
' 돋보기
'============================================================================
Sub btnFncd_OnClick()
	Form.OpenFramePopup("nhnts00001_p1" , "", "")
End Sub
'============================================================================
' 돋보기 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "FUNDINFO" then
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
		end if 
	end if
End Sub
