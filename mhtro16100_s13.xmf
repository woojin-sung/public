		<LABEL name="LabelData6" fgcolor="334:034034034" fontsize="-3" fontstyle="01" caption="시간외 환전 익일 02:00 ~ 06:00" bgcolor="035:237246255" multiline="1" ly_vert="140,173,205,20,1" />
