'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_tInfo
g_tInfo = {} ' 신청에 필요한 고객 정보들을 가지고 있는 테이블

''****************************************************************************
''            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
''****************************************************************************
'============================================================================
' f_GetTData(sKey) : 해당 key에 해당하는 value 반환, 예외처리 통과 못할 시 빈값 반환
'============================================================================
Function f_GetTData(sKey)
	if g_tInfo == NULL then
		return ""
	else
		if g_tInfo[sKey] == NULL or g_tInfo[sKey] == "" then
			return ""
		else
			return g_tInfo[sKey]
		end if
	end if
End Function

'''****************************************************************************
'''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	contState.tblState.visible = false
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "requestTR" then
		Dim szAccount
		
		szAccount = Form.GetCtlProp( "#Account0", "caption" )
		
		for i=0 to 2
			contState.tblState.SetCellString( i, 2, "" )
		next
		
		contState.tblState.visible = false
		contState.lblNoData.visible = false
		lblChgReasonText.visible = false
		edtChgReason.visible = false
		
		btnSubmit.enable = false
		
		if szAccount <> "" then
			DATAMANAGER.RequestTranData( "obcsb_acif_721r" )
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "close_mbonl94002_p2" then
		Dim szAccount
		
		szAccount = Form.GetCtlProp( "#Account0", "caption" )
		
		if szAccount <> "" then
			DATAMANAGER.RequestTranData( "obcsb_acif_721r" )
		end if

	' 확인 후 공인인증 처리 완료 되면 전환 신청 TR 호출
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			DATAMANAGER.RequestTranData( "obcsb_acif_720a" )
		end if
		
     elseif sKeyName == "mhetc90060_px" Then 'v001
         if sRet == "ok" Then
	         DATAMANAGER.RequestTranData( "obcsb_acif_720a" )
	     end if
	end if
End Sub

'============================================================================
' btnSubmit_OnClick() : 개인 전문투자자 전환(분류) 위험설명 팝업 오픈
'============================================================================
Sub btnSubmit_OnClick()
	Dim szPassword
		
	szPassword = Form.GetCtlProp( "#edtPassword", "caption" )
	
	if szPassword <> "" then			
		if edtChgReason.caption == "" then
			Form.ShowAlert("알림", "일반투자자 전환사유를 입력하세요.")
		else
			Dim szCertUseType 
			szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입
	
			if szCertUseType == "1" or szCertUseType == 1 then '간편인증 v001
			    Form.OpenFramePopup( "mhetc90060_px" , "" , mhetc90060_px)		'간편인증
			else
			    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
			end if
		end if
	else
		Form.ShowAlert("알림", "비밀번호를 입력해주세요")
	end if
End Sub

'''****************************************************************************
'''               		D A T A				M A N A G E R               
'''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szJumin, szUserName, szCustNum
	szJumin = Form.GetSharedData("&JUMIN_NUM", false )
	szUserName = Form.GetSharedData("&USER_NAME", false )
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	if szTranID == "obcsb_acif_721r" then		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RCNO_PIP" , 0, szJumin )
	
	elseif szTranID == "obcsb_acif_720a" then		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0, "3" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RCNO_TYPE_CODE" , 0, "01" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RCNO_PIP" , 0, szJumin ) '실명확인번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CUST_FULL_NAME" , 0, szUserName ) '고객풀명
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_CLS_CODE" , 0, f_GetTData("clsCode") ) '전문투자자구분코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_RGNO" , 0, f_GetTData("registerNum") ) '전문투자자등록번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_DSGT_DATE" , 0, null ) '전문투자자지정일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_VLDT_STA_DATE" , 0, null ) '전문투자자효력시작일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_VLDT_FIN_DATE" , 0, null ) '전문투자자효력종료일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_DSGT_APLT_DATE" , 0, null ) '전문투자자지정신청일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "GNRL_INVR_CNVR_REAS_CNTT", 0, Trim(edtChgReason.caption) ) '일반투자자전환사유내용
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "TORF_CNFR_YN", 0, null ) '진위확인여부
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "TORF_CNFR_EMPNO", 0, null ) '진위확인직원번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ISTU_CLCD", 0, null ) '기관구분코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "OTCO_ISTU_CODE", 0, null ) '타사기관코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "TORF_CNFR_YMDH", 0, null ) '진위확인일시
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "SPCL_FNCM_TYPE_CODE" , 0, f_GetTData("fncmTypeCode") ) '전문금융소비자유형
	
	elseif szTranID == "obcsb_acif_097r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0, szCustNum )
	end if
End Sub
'
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	Dim szMsgCode, szMsg, szSubMsg
		
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsg = DATAMANAGER.GetDataMsgText(szTranID)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obcsb_acif_721r" then		
		Dim szStaDate, szFinDate, szClsCode

		szStaDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_VLDT_STA_DATE" , 0  ) '시작일자
		szFinDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_VLDT_FIN_DATE" , 0  ) '종료일자	
		
		Dim szClsCode
		
		szClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_CLS_CODE" , 0 )

		if g_tInfo <> NULL then
			g_tInfo["clsCode"]		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_CLS_CODE" , 0 )
			g_tInfo["registerNum"]		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_RGNO" , 0  )
			g_tInfo["applyDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_DSGT_APLT_DATE" , 0  ) '신청일자
			g_tInfo["confirmDate"]		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_DSGT_DATE" , 0  ) '지정일자
			g_tInfo["startDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_VLDT_STA_DATE" , 0  ) '시작일자
			g_tInfo["finalDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_VLDT_FIN_DATE" , 0  ) '종료일자
			g_tInfo["fncmTypeCode"] 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "SPCL_FNCM_TYPE_CODE" , 0  ) '전문금융소비자유형코드
		end if

		if 2 <= tonumber(szClsCode) and tonumber(szClsCode) <= 6 then
			contState.tblState.visible = true
			
'			Dim szPassword
'		
'			szPassword = Form.GetCtlProp( "#edtPassword", "caption" )
'			
'			if szPassword <> "" then				
				Dim szChangeDate
				Dim szFormatStart, szFormatExp '날짜 형식에 맞게 포맷팅
			
				szChangeDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PFIN_DSGT_DATE" , 0  ) '전문금융소비자유형코드
				szFormatStart = Mid(szStaDate, 1, 4) & "-" & Mid(szStaDate, 5, 2) & "-" & Mid(szStaDate, 7, 2)
				szFormatExp = Mid(szFinDate, 1, 4) & "-" & Mid(szFinDate, 5, 2) & "-" & Mid(szFinDate, 7, 2)
				
				szClsCode = Form.GetMetaData("전문투자자구분코드", szClsCode )
				
				contState.tblState.SetCellString( 0, 2, szClsCode )
				'전환일자 obcsb_acif_097r 에서 조회하도록 수정
'				contState.tblState.SetCellString( 1, 2, szChangeDate )
				contState.tblState.SetCellString( 2, 2, szFormatStart & "~" & szFormatExp )
				
				lblChgReasonText.visible = true
				edtChgReason.visible = true
				btnSubmit.enable = true
'			end if
		else
			contState.tblState.visible = false
			lblChgReasonText.visible = false
			edtChgReason.visible = false
			contState.lblNoData.visible = true
			
			btnSubmit.enable = false
		end if
		
		'전환일자 조회를 위해 호출
		DATAMANAGER.RequestTranData( "obcsb_acif_097r" )
	
	elseif szTranID == "obcsb_acif_720a" then
		Dim szSucsYN
		szSucsYN = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "SUCS_YN" , 0  )
		
		if szSucsYN == "Y" then
			Form.OpenPopup("mbonl94002_p2" , "switch_normal" , "")
		end if
	
	elseif szTranID == "obcsb_acif_097r" then
		Dim szChangeDate 
		szChangeDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "CNVR_DATE" , 0  ) '전환일자
		contState.tblState.SetCellString( 1, 2, szChangeDate )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	
	if szTranID == "obcsb_acif_721r" then
		contState.tblState.visible = false
		lblChgReasonText.visible = false
		edtChgReason.visible = false
		contState.lblNoData.visible = true
		
		btnSubmit.enable = false
	end if
End Sub

