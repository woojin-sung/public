	<SCRIPT_INFO _len="6677" _ulen="5117" >
Dim g_szOSType
Dim g_ServerMode
'Dim g_szScreenNo
Dim g_URLheader
Dim g_szURL	'고객투자성향 다운로드 URL

'============================================================================
Sub Form_OnFormInitBefore()
	imgDownLoad.setMaintainingRatio("1")
	imgClose.setMaintainingRatio("1")	
End Sub

'============================================================================
Sub Form_OnFormInit()	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData( )
	
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
'		g_URLheader = "http://testhome.imeritz.com/include/resource/comm/ctcn/files/"
		g_URLheader = "http://testhome.imeritz.com/include/images/img/"
	Else
'		g_URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/files/"
		g_URLheader = "http://home.imeritz.com/include/images/img/"
	End If

	If szOpenData <> "" And szOpenData <> null Then
		g_szInvType = szOpenData
	
		SetScreen(g_szInvType)
	else
		SetScreen(g_szInvType)
	end if
End Sub

'============================================================================
Function SetScreen(g_szInvType)

	'---------------------------------------------------
	'일반투자자 : 고객투자성향
	'---------------------------------------------------
	g_szInvTypeNm = Form.GetMetaData("KYC투자성향등급코드", g_szInvType)
	
	if g_szInvType = "01" then	'고수익지향형
		Container0.ImgInvestGrade1.imgpath = "bg_risk1_o.9.png"
		Container0.lblInvt01.fgcolor = "16"
		
'		szResult = "고객님은 투자 위험을 적극적으로 수용하면서 국내외 다양한 고수익 기회를 추구하시는 '고수익지향형' 투자유형입니다."
'					.. " 당사 상품분류 기준에 의거 '(1등급) 매우 높은 위험'에 해당하는 상품을 비롯한 모든 금융투자상품 가입(※ 전문투자자"
'					.. " 자격 필수 상품 제외)이 가능합니다. 단, 해당 상품군 중 '원금 초과 손실' 발생 가능성이 있는 상품도 있으니 투자에"
'					.. " 유의하시기 바랍니다."
'		
'		Container0.lblResult.caption = szResult
	
	elseif g_szInvType = "02" then	'성장지향형
		Container0.ImgInvestGrade2.imgpath = "bg_risk2_o.9.png"
		Container0.lblInvt02.fgcolor = "4"
		
'		szResult = "고객님은 투자원금의 손실을 상당 부분 감수하더라도 다양한 금융투자상품 투자를 통해 수익을 추구하시는 '성장지향형'"
'					.. " 투자유형입니다. 당사 상품분류 기준에 의거 '(2등급) 높은 위험' 이하 금융투자상품 가입이 가능합니다. 단, 해당"
'					.. " 상품군 중 '원금 전체 손실' 발생 가능성이 있는 상품도 있으니 투자에 유의하시기 바랍니다."
'		
'		Container0.lblResult.caption = szResult
	
	elseif g_szInvType = "03" then	'중립형
		Container0.ImgInvestGrade3.imgpath = "bg_risk4_o.9.png"
		Container0.lblInvt03.fgcolor = "4"
		
'		szResult = "고객님은 투자원금의 손실을 감수하더라도 채권금리 이상의 수익을 추구하시는 '중립형' 투자유형입니다.\n'중립형' 투자는"
'					.. " 특정자산에 대한 편중을 피하고 중위험 투자 방식의 포트폴리오 구성을 지향하며, 당사 상품분류 기준에 의거 '(4등급)"
'					.. " 보통 위험' 이하 금융투자상품 가입이 가능합니다. 단, 해당 상품군 중 '원금 전체 손실' 발생 가능성이 있는 상품도"
'					.. " 있으니 투자에 유의하시기 바랍니다."
'		
'		Container0.lblResult.caption = szResult
	
	elseif g_szInvType = "04" then	'안정지향형
		Container0.ImgInvestGrade4.imgpath = "bg_risk5_o.9.png"
		Container0.lblInvt04.fgcolor = "4"
		
'		szResult = "고객님은 최대한 투자원금을 보전하면서 정기예금 금리보다 조금 높은 투자수익을 추구하시는 ‘안정지향형’ 투자유형입니다."
'					.. " 신용등급이 높은 회사채, 단기사채 등 당사 상품분류 기준에 의거 '(5등급) 낮은 위험' 이하 금융투자상품 가입이"
'					.. " 가능합니다. 단, 해당 상품군 중 '원금 손실'이 발생할 가능성이 있는 상품도 있으니 투자에 유의하시기 바랍니다."
'		
'		Container0.lblResult.caption = szResult
	
	elseif g_szInvType = "05" then	'이자소득형
		Container0.ImgInvestGrade5.imgpath = "bg_risk6_o.9.png"
		Container0.lblInvt05.fgcolor = "16"
		
'		szResult = "고객님은 투자원금을 보전하면서 정기예금 수준의 투자수익을 추구하시는 '이자소득형' 투자유형입니다. 국공채, 원화RP, CMA 등"
'					.. " 당사 상품분류 기준에 의거 '(6등급) 매우 낮은 위험'에 해당하는 금융투자상품 가입이 가능합니다. 단, 해당 상품군은"
'					.. " 「예금자보호법」에 따른 예금자보호상품이 아닌 점을 유의하시기 바랍니다."
'		
'		Container0.lblResult.caption = szResult
		
	end if
	
	g_szURL = g_URLheader & "kyc_investment_" & g_szInvType & ".png"
	
	'투자성향설명 조회
	IF g_szInvType = "01" OR g_szInvType = "02" OR g_szInvType = "03" OR g_szInvType = "04" OR g_szInvType = "05" THEN
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE", 0, g_szInvType)
		Container0.Label0.caption = ""
	ELSE
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE", 0, "4")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE", 0, "00")
		Container0.Label0.caption = "투자권유 미희망/정보 미제공"
	END IF
	
	DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "PROS_CLS_CODE", 0, "S")
	DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "ENTR_YN", 0, "N")
	DATAMANAGER.RequestTranData("obcsb_acif_709a")
	
End Function

'============================================================================
Sub imgDownLoad_OnClick()
'	'투자성향 PDF 다운로드		
	if g_szOSType == "1" then	'Android("1")'iOS("2")
		Form.OpenExternalBrowser(g_szURL)
	else
		Form.OpenInternalBrowser(g_szURL)
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_acif_709a"	then
		Container0.lblResult.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "INVT_INCL_OVRV_EXPL", 0 )
	end if
End Sub


	</SCRIPT_INFO>
