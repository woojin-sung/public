Sub Form_OnFormInit()
	g_TR_DATE  = Form.GetSharedData("&HOST_DATE", false )
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	szTheme  = Form.GetEnvData("common.theme")
	
	Image1.imgpath = "icon_top_back_light"
		
	'확인버튼 비활성화
	BtnNext.enable  = False
	
	If szTheme == "black" Then
		BtnNext.btnimage = "btn_27.9"
	Else
		BtnNext.btnimage = "btn_21.9"
	End If 
	
	BtnNext.fgcolor = "269"
	
	'BtnNext.enable  = True
'	BtnNext.btnimage = "btn_20.9"
	
	ContMain.Edit0.setApplyLabel("입금자 표시번호" ,0 , 268 , "left" , False )
	ContMain.Edit0.SetUseResultLabel(true,2)
	
	ContMain.LblTime.bringFront("1")
	ContMain.Image3.bringFront("1")
	ContMain.Image3.visible = false
	InitCountTimer()
	Form.SetTimerEvent(30, 1, 1)
	
	
    '테스트용 인증스킵 체크
    nDev = Form.GetSharedData("&SERVER_MODE", False )
    
    If nDev == "1" Or nDev == 1 Then
        chkSkip.visible = True
        'chkSkip.checkstate = "1"  '자동체크 해제
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If
    
    'v0015
    'v0013 다른앱 인증번호 확인후 돌아오면서 권한설정 풀리는 경우가 있어 재설정 추가(함원규대리확인)
    '로그인여부
    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )

    '비로그인상태에서만 비대면화면 권한부여
    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
        Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
    End If
    
	
	sNmetBswrGb	   = Form.GetSharedData("BDM_NMETBSWRGB"      , false ) 
	gTrDate 		   = Form.GetSharedData("BDM_TR_DATE"         , false ) 
	gOtsdTrUniqNo    = Form.GetSharedData("BDM_OTSD_TR_UNIQ_NO" , false ) 
	gsUserName 	   = Form.GetSharedData("BDM_NAME" 		     , false ) '이름
	gRCNO 		   = Form.GetSharedData("BDM_RCNO_PIP" 		 , false ) '주민등록번호
	gRegUniqNo 	   = Form.GetSharedData("BDM_REG_UNIQ_NO"	 , false ) '등록고유번호
	gRegStagClsCode = Form.GetSharedData("REG_STAG_CLS_CODE"	 , false ) '등록단계구분코드
	gClearYN	       = Form.GetSharedData("BDM_CLEAR_YN"	      , false ) 'Y:처음부터하d기 N: 이어가기
	HP1			   = Form.GetSharedData("BDM_HP1"	           , false ) '휴대폰번호
	HP2 			   = Form.GetSharedData("BDM_HP2"	           , false )
	HP3 			   = Form.GetSharedData("BDM_HP3"	           , false )
	
	gRcvnDate = Form.GetSharedData("RCVN_DATE"      , false ) 
	gRcvnIqryNo = Form.GetSharedData("RCVN_IQRY_NO"      , false ) 
	sName = Form.GetSharedData("ACHO_NAME"      , false )
	
	getDataBankCode = Form.GetSharedData("BDM_BANKCODE"	      , false )
	getDataBankAcno = Form.GetSharedData("BDM_BANKACNO"	      , false )
	getDataBankName =	Form.GetSharedData("BDM_BANKNAME"         , false )
	
	'2021.04.12. 김유경. "입력하신 계좌로 1원을 보냈습니다."로 변경
	'ContMain.Label2.caption = Trim(getDataBankName) & " " & Trim(getDataBankAcno) & " 계좌로 1원을 보냈습니다."	
	
	'>>>>>>test
'	gTrDate     = "20210218"
'	gRegUniqNo  = "20210224N0005"
'	gRCNO       = "0013AA4383CDA9E15818A39A885FBEA46C0C"

	
'	gRegUniqNo = "20210226N0005"
'	gRCNO      = "0013AA4383CDA9E15818A39A885FBEA46C0C"
'	sNmetBswrGb= "000" '>>>>test 임시
	
End Sub

'============================================================================
Sub ContMain_Edit0_OnClick()
	if Form.GetSharedData("&OS_TYPE") == "2" then
		ContMain.LabStnd.top = 550
		ContMain.SetScrollAutoSize()
		
		ContMain.scroll_pos = 50
	else
		ContMain.Button1.visible = true
	end if
End Sub

'============================================================================
Sub ContMain_Edit0_OnEditComplete()
'	DATAMANAGER.RequestTranData("obaci_nmet_012a")
	
	if Form.GetSharedData("&OS_TYPE") == "2" then
		ContMain.LabStnd.top = 0
		ContMain.SetScrollAutoSize()
		
		ContMain.scroll_pos = 0
	else
		ContMain.Button1.visible = false
	end if
	
	If ContMain.Edit0.caption = "" Then
		g_szResultText = "인증번호가 입력되지 않았습니다."
		Form.SetTimerEvent2(31, 1, 0.3)
		ContMain.Edit0.SetStatus("error")
	else
		DATAMANAGER.RequestTranData("obaci_nmet_012a")
	End If
End Sub

