Sub Form_OnRefresh()
	'v0016 start
	Form.SetTimerEvent(99, 1, 1)
	Form.addWaitCursor()
	'v0016 end
    'v0015
    'v0013 다른앱 인증번호 확인후 돌아오면서 권한설정 풀리는 경우가 있어 재설정 추가(함원규대리확인)
    '로그인여부
    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )

    '비로그인상태에서만 비대면화면 권한부여
    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
        Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
    End If
    
End Sub

