'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	'계좌인증관련 서비스가 아닌 경우 확인버튼 다시 활성화함.
	If szTranID <> "obaci_nmet_012a" and szTranID <> "obtss_opnf_101a" Then
		BtnNext.enable = true
		BtnNext.btnimage = "btn_20.9"
		BtnNext.fgcolor = "273"		
	end if

	sSendData = trim(DATAMANAGER.GetDataMsgSubText(szTranID))  'szErrCode.."★"..szErrMsg.."★"..DATAMANAGER.GetDataMsgSubText(szTranID) & "(" & szTranID & ")"
	If szTranID == "obaci_nmet_015c" Then
		
		'ex)임직원매매계좌[%s-%s]보유-사전승인필요
		
'Form.ShowAlert("오류메시지", sSendData)		
		'l_szList1 = Split(sSendData,"[") 'ex1) 임직원매매계좌 / %s-%s]보유-사전승인필요
		l_szList1 = Split(sSendData," ") 'ex1) 임직원매매계좌 / %s-%s]보유-사전승인필요
'Form.ShowAlert("l_szList1", l_szList1(0))		
		if l_szList1(0) = "임직원매매계좌" then
			l_szList2 = Split(l_szList1(1),"]") '  %s-%s
			'v0018 sSendData = "임직원 매매계좌는 1개만 보유 가능합니다.\n사전승인 후 개설 가능하며\n법규준수팀으로 문의해주세요.\n("& l_szList2(0) & "계좌 보유)"
			sSendData = "임직원 매매계좌는 1개만 보유 가능합니다.\n사전승인 후 개설 가능하며\n법규준수팀으로 문의해주세요."
			Form.SetSharedData("mbbdm86193_EMP_YN", "Y")
		elseif trim(sSendData) = "신용 불량" then			
			sSendData = "채무불이행자는 계좌개설이 불가합니다.\n(선물옵션/해외파생/CFD)"
		end if
		'2021.04.13. 김유경 위치변경
		'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
		Form.OpenNextPopup("mbbdm86193", sSendData , "" ) '계좌개설 실패
		'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
		
	elseIf szTranID == "obaci_acct_059c" or szTranID == "obaci_acct_059c_1" Then		
		if szErrCode == "4572" or szErrCode == "4480" then
		
			'sSendData = "이미 개설이 완료되었거나, 취소가 된 경우에는\n이어하기가 불가합니다."
			'Form.OpenNextPopup("mbbdm86193", sSendData , "" ) '계좌개설 실패
			
     		Form.MsgBox("안내", "이미 개설이 완료되었거나\n취소가 된 경우에는\n이어하기가 불가합니다.", "PrgsExit", 6)
			Exit Sub      			
			
		else	
			If Trim(sSendData) ~= null And Trim(sSendData) ~= "" Then
				strMsg = szErrMsg.."("..Trim(sSendData)..")"
			Else
				strMsg = szErrMsg
			End If	
			Form.ShowAlert("오류", strMsg)
		end if	
	Else
		'오류메시지 설정
		'sSendData = DATAMANAGER.GetDataMsgSubText(szTranID) 'szErrCode.."★"..szErrMsg.."★"..DATAMANAGER.GetDataMsgSubText(szTranID) & "(" & szTranID & ")"
		If Trim(sSendData) ~= null And Trim(sSendData) ~= "" Then
			strMsg = szErrMsg.."("..Trim(sSendData)..")"
		Else
			strMsg = szErrMsg
		End If
		
'		If szTranID = "obtss_idvs_001a" Then 
'			Form.SetTimerEvent("1", 0, 30)
'		
'		Else
		If szTranID == "obaci_nmet_012a" Then
			'2021.04.13. 김유경. 메시지 추가
'			ContMain.Edit0.SetResultLabel("1", "error","계좌변경 선택 후 재처리 바랍니다." ,"ContMain")
			
			g_szResultText = "계좌변경 선택 후 재처리 바랍니다."
			Form.SetTimerEvent2(31, 1, 0.3)
			
		Else
			Form.ShowAlert("오류", strMsg)
		End If
	End If
	
End Sub 

