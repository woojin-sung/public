Sub chkSkip_OnChange(sCheckState)
	If sCheckState == "0" Or sCheckState == 0 Then     	
		BtnNext.enable = False
		BtnNext.btnimage = "btn_21.9"
		BtnNext.fgcolor = "269"
	Else 
		BtnNext.enable = True
		BtnNext.btnimage = "btn_20.9"
		BtnNext.fgcolor = "273"    		
    End If
End Sub 
