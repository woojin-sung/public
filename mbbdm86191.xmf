						g_szISA_APLY_ACNT_OPNG_CLCD = "2"
						
						If gOPTN_YN == "Y" or gOVDV_YN == "Y" or gDmstCFD_YN == "Y" or gOvrsCFD_YN = "Y" Then  'v0001 CFD추가	'v0003 해외CFD 추가
							'JMY Sta
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01")
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1")
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, g_RSNOTYPE)
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, gRCNO)
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM" 			, 0, gsUserName)
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "1")
							'JMY Fin
							DATAMANAGER.RequestTranData("obcsb_nice_030r")
						Else
	'						If gCNFR_TRGT_CUST_CLCD == "01" Then
	'							DATAMANAGER.RequestTranData( "obaci_acct_091r" )
	'						Else
	'							DATAMANAGER.RequestTranData( "obcsb_acif_801r" )
	'						End If
							DATAMANAGER.RequestTranData( "obaci_acct_091r" )
						End If
						
						
					Else
						'Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
						Form.MsgBox("알림", "ISA 계좌 보유시,\n이수전용으로만 개설이 가능합니다.\n\n이수전용으로 계좌를 개설하시겠습니까?", "ReTryPrcd2", 2)
						Exit Sub		
					End If
				End If '중개형isa일때만 체크 end
			End If
			
			'정상일 때 하던 체크를 뒤로 뺌 *일임형isa일 경우는 중복 체크 안함 부분 start------
			g_szISA_APLY_ACNT_OPNG_CLCD = "1"
					
			If gOPTN_YN == "Y" or gOVDV_YN == "Y" or gDmstCFD_YN == "Y" or gOvrsCFD_YN = "Y" Then  'v0001 CFD추가	'v0003 해외CFD 추가
				'JMY Sta
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01")
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1")
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, g_RSNOTYPE)
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, gRCNO)
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM" 			, 0, gsUserName)
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "1")
				'JMY Fin
				DATAMANAGER.RequestTranData("obcsb_nice_030r")
			Else
'					If gCNFR_TRGT_CUST_CLCD == "01" Then
'						DATAMANAGER.RequestTranData( "obaci_acct_091r" )
'					Else
'						DATAMANAGER.RequestTranData( "obcsb_acif_801r" )
'					End If
				DATAMANAGER.RequestTranData( "obaci_acct_091r" )
			End If
			
			'정상일 때 하던 체크를 뒤로 뺌 *일임형isa일 경우는 중복 체크 안함 부분 end------
			
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_4", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 13, 1, 1 )
		End If
	ElseIf szTranID == "obaci_acct_089r_4" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부 V0005

			if sTxcmTrprClsCode == "1" then
				'Form.ShowAlert("알림", "금융소득종합과세대상자는\nISA 가입이 불가합니다.")
				Form.MsgBox("안내", "금융소득종합과세대상자는\nISA 가입이 불가합니다.", "TXCM_TRPR_CSNO_EXIT", 6)
				Exit Sub
			end if 
			
			If g_szISA_PROD_TYPE == "3" then '중개형isa일때만 체크 start
			
				If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
					'정상일 때 하던 체크를 뒤로 뺌 *일임형isa일 경우는 중복 체크 안함 부분
				ElseIf sTxcmDplcAcntYn == "1"  then 
					Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
					Exit Sub
				ElseIf sTxcmDplcAcntYn == "2"  then 
					
					If g_szISA_ACNT_OPNG_CLCD == "2" Then
						g_szISA_APLY_ACNT_OPNG_CLCD = "2"
						
						If gOPTN_YN == "Y" or gOVDV_YN == "Y" or gDmstCFD_YN == "Y" or gOvrsCFD_YN = "Y" Then  'v0001 CFD추가	'v0003 해외CFD 추가
							'JMY Sta
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01")
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1")
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, g_RSNOTYPE)
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, gRCNO)
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM" 			, 0, gsUserName)
							'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "1")
							'JMY Fin
							DATAMANAGER.RequestTranData("obcsb_nice_030r")
						Else
	'						If gCNFR_TRGT_CUST_CLCD == "01" Then
	'							DATAMANAGER.RequestTranData( "obaci_acct_091r" )
	'						Else
	'							DATAMANAGER.RequestTranData( "obcsb_acif_801r" )
	'						End If
							DATAMANAGER.RequestTranData( "obaci_acct_091r" )
						End If
						
						
					Else
						'Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
						Form.MsgBox("알림", "ISA 계좌 보유시,\n이수전용으로만 개설이 가능합니다.\n\n이수전용으로 계좌를 개설하시겠습니까?", "ReTryPrcd2", 2)
						Exit Sub		
					End If
				End If '중개형isa일때만 체크 end
			End If
			
			'정상일 때 하던 체크를 뒤로 뺌 *일임형isa일 경우는 중복 체크 안함 부분 start------
			g_szISA_APLY_ACNT_OPNG_CLCD = "1"
					
			If gOPTN_YN == "Y" or gOVDV_YN == "Y" or gDmstCFD_YN == "Y" or gOvrsCFD_YN = "Y" Then  'v0001 CFD추가	'v0003 해외CFD 추가
				'JMY Sta
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01")
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1")
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, g_RSNOTYPE)
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, gRCNO)
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM" 			, 0, gsUserName)
				'DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "1")
				'JMY Fin
				DATAMANAGER.RequestTranData("obcsb_nice_030r")
			Else
'					If gCNFR_TRGT_CUST_CLCD == "01" Then
'						DATAMANAGER.RequestTranData( "obaci_acct_091r" )
'					Else
'						DATAMANAGER.RequestTranData( "obcsb_acif_801r" )
'					End If
				DATAMANAGER.RequestTranData( "obaci_acct_091r" )
			End If
			
			'정상일 때 하던 체크를 뒤로 뺌 *일임형isa일 경우는 중복 체크 안함 부분 end------
			
		Else
			Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다.")
			Exit Sub
		End If
	End If
End Sub 

