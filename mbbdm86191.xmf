'============================================================================
Function User_Invt_Proc(gb)  'JMY
	If gb == "ok" Then
	    g_PUKYC_INVT_INCL_GRAD_CODE   	= Form.GetSharedData("BDM_KYC_GRAD"           , false)  '투자성향등급
	    g_PUKYC_PROD_GRAD_CODE     		= Form.GetSharedData("BDM_PROD_GRAD"          , false)  '상품등급
	    g_PUunfitYn                		= Form.GetSharedData("BDM_UNFIT_YN"           , false)  '부적합여부
	    g_PUFTOT_KYC_INVT_INCL_GRAD_CODE	= Form.GetSharedData("BDM_DVPD_KYC_GRAD"      , false)  '파생상품투자성향등급
	    g_PUFTOT_KYC_PROD_GRAD_CODE		= Form.GetSharedData("BDM_DVPD_PROD_GRAD"     , false)  '파생상품상품등급
	    g_PUFtotUnfitYn		         = Form.GetSharedData("BDM_DVPD_UNFIT_YN"      , false)  '파생상품부적합여부
	    g_PUWeakFnncYn				= Form.GetSharedData("BDM_WEAK_FNNC_YN"       , false)  '취약금융소비자여부	
	    g_PUKYC_INVT_RCMD_CLS_CODE		= Form.GetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"  , false)		'KYC투자권유구분코드
	End If
End Function         

