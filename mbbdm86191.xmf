    'JMY 투자성향진단 미완료 
'    if sKeyName == "Invt_Error" then
'        if sRet == "ok" then  '예.ok / 아니오.no
'            DATAMANAGER.RequestTranData("obaci_acct_052c")
'	    end if    
'    
'    'v0003 sta
'    else
	if sKeyName = "ReTryPrcd2" Then
	    If sRet = "no" Then  'ok.예 no.아니오
		    	closeFlag = "2"
			'Form.OpenScreen( "41000" , "")
			'Form.CloseForm()
			Form.OpenNextPopup("mbbdm85100", "", "")  			
	    Else
		   g_szISA_APLY_ACNT_OPNG_CLCD = "2"
		   DATAMANAGER.RequestTranData("obaci_acct_052c")
	    End if
	    
    elseif sKeyName = "TXCM_TRPR_CSNO_EXIT" Then
    
'		Form.CloseForm()		
		Form.OpenNextPopup("mbbdm85100", "", "")    
		
	elseif sKeyName == "PrgsExit" then				
		
'		Form.CloseForm()		
		Form.OpenNextPopup("mbbdm85100", "", "")	
		
	end if  
    'v0003 fin
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    'JMY 투자성향진단
    If sKeyName == "MBBDM86170" Then
		User_Invt_Proc("ok")
		If sRet == "ok" Then
		
'			'v0003 sta
'			if g_szPRCD133YN == "Y" and g_szISA_PROD_TYPE == "3" Then
'				DATAMANAGER.RequestTranData("obaci_acct_089r")
'			Else
'				DATAMANAGER.RequestTranData("obaci_acct_052c")
'			End if
'			'v0003 fin
			
			DATAMANAGER.RequestTranData("obaci_acct_052c")
			
			
         ElseIf sRet == "unable" Then
              '최종 투자성향 체크시, 개설불가(상품가입불가능 및 상품부적합)인 경우, 현재 개설중인 건 취소 후, 종료처리
			DATAMANAGER.RequestTranData("obaci_acct_059c_1")
			

         '최종단계에서 개설불가 체크된 경우, 신청내역을 (자동)취소/종료되지만 취소플래그(sRet = unable)가 미설정될 경우, 
         '2단계_투자성향진단 체크처럼 고객에게 안내함
		Else
			BtnNext.enable = true	'하단버튼 활성화
			BtnNext.btnimage = "btn_20.9"
			BtnNext.fgcolor = "273"			
			
			'투자성향진단 비정상종료와 부적합(적정성보고서) 비정상종료 분리
			If sRet == "unfit_fail" Then
				Form.ShowAlert("알림", "[투자성향 대비 고위험거래 가입확인],\n[투자성상품 적정성 판단 보고서확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행(확인)해주세요.")
				Exit Sub
			'투자권유 희망 확인서 미처리에 따른 진행불가 알럿	
			ElseIf sRet == "hopeRecInv_fail" Then
				Form.ShowAlert("알림", "[투자권유 희망 여부 확인],\n[투자권유 희망 여부 확인서 확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
				Exit Sub	
			Else
				'TEST용 SKIP 종료
				'Form.MsgBox("알림", "투자성향 진단이 올바르게 처리되지 않았습니다.\n계속 진행하시겠습니까?(계좌개설이 불가될 수 있습니다.)", "Invt_Error", "2")  '2.예/아니오
				Form.ShowAlert("알림", "투자성향 진단이 올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행(확인)해주세요.")
                  Exit Sub
			End If
		End If	
	ElseIf sKeyName = "mbbdm86191_p1_end" Then
		If sRet == "ok" Then
			'2021.04.20. 김유경. 10번 이상 오류 시 계좌개설 취소
			'closeFlag = "2"
			'Form.CloseForm()		
			DATAMANAGER.RequestTranData("obaci_acct_059c_1")
		End If
	
	ElseIf sKeyName == "mbbdm86131" And sRet == "ok" Then
		gFnnrObjtChkYn = "Y"
		DATAMANAGER.RequestTranData( "obcsb_acif_801r" )
    end if
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)  'JMY

	If sTimerID == "1" or sTimerID == 1 Then
		BtnNext.enable = true	'하단 버튼 다시 활성화
		BtnNext.btnimage = "btn_20.9"
		BtnNext.fgcolor = "273"		
		
		Form.ShowAlert("오류", "통신상태가 원활하지 않습니다.\n잠시 후 다시 처리해 주세요.")
		Form.SetTimerEvent("1", 0, 30)
	ElseIf sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2("2", 0, 0.8)
		ContMain.Edit0.SetShowKeypad(true)		
	
	'v0003 sta 은합회 결과값에 따라 체크 
    '안드로이드는 num, 아이폰은 string으로 받음
	ElseIf sTimerID == 10 or sTimerID == "10" then
		Form.SetTimerEvent( 10, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	
	ElseIf sTimerID == 11 or sTimerID == "11" then
		Form.SetTimerEvent( 11, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	
	ElseIf sTimerID == 12 or sTimerID == "12" then
		Form.SetTimerEvent( 12, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	
	ElseIf sTimerID == 13 or sTimerID == "13" then
		Form.SetTimerEvent( 13, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
		
	'단기다수계좌여부 확인
    ElseIf sTimerID == 20 Or sTimerID == "20" Then
        '정보송신 타이머종료
        Form.SetTimerEvent(20, 0, 1)

        '송신유효횟수 설정
        g_nCnt_091_1 = CInt(g_nCnt_091_1) + 1

        '송신유효횟수 초과 체크
        If CInt(g_nCnt_091_1) > 7 Then
		   BtnNext.enable = true	'하단 버튼 다시 활성화
		   BtnNext.btnimage = "btn_20.9"
		   BtnNext.fgcolor = "273"		   
		   
            'contMain.edtAthnNo.SetResultLabel("1","error","은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.","contMain")
            Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")

            '3분 타이머 초기화
            'InitCountTimer()

            Exit Sub
        End If
	
        '단기다수계좌여부/대포통장명의인여부 확인
        DATAMANAGER.RequestTranData "obaci_acct_091r_1"
	'v0002 fin
		
	Elseif sTimerID == 30 or sTimerID == "30" then
		if g_HPSec ==  0 then
			Form.SetTimerEvent(30, 0, 1)
			Call InitCountTimer()					'5분 타이머 초기화
			ContMain.Edit0.SetResultLabel("1", "error","인증시간이 만료되었습니다.\n 다시 시도하여 주시기 바랍니다." ,"ContMain")
			ContMain.Image3.visible = true
			ContMain.LblTime.visible = false
			ContMain.Edit0.enable = false
			ContMain.Edit0.SetStatus("error")
			'Container0.Edit1.enable = false
			'Container0.Edit1.caption = ""
			'Container0.btnConfirm.enable = false		
			'Container0.btnConfirm.visible = false	
			
		else
			Dim nMin, nSec
			nMin  = int(g_HPSec / 60 )
			nSec  =  g_HPSec mod  60
			if len(nSec) == 1 then 
				nSec = "0"..nSec
				nSec = nSec
			End if 	
			ContMain.LblTime.caption = nMin..":"..nSec
			g_HPSec = g_HPSec-1		
		end if
		
	elseif sTimerID == 31 or sTimerID == "31" then	
		Form.SetTimerEvent2(sTimerID, 0, 0)
		ContMain.Edit0.SetResultLabel("1", "error",g_szResultText,"ContMain")	
		ContMain.Edit0.caption = ""	'20230426 초기화 추가
	elseif sTimerID == 32 or sTimerID == "32" then
		'Form.SetTimerEvent2(sTimerID, 0, 1)
		Form.SetTimerEvent(sTimerID, 0, 1) 'v0012 타이버 페어 맞춤
		'송신유효횟수 설정
		g_nCnt_030_1 = CInt(g_nCnt_030_1) + 1
		
		'송신유효횟수 초과 체크
        If CInt(g_nCnt_030_1) > 7 Then
		   
            'contMain.edtAthnNo.SetResultLabel("1","error","은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.","contMain")
            Form.ShowAlert("오류", "통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")

            '3분 타이머 초기화
            'InitCountTimer()

            Exit Sub
        End If
	
		DATAMANAGER.RequestTranData("obcsb_nice_030r_1")	
	elseif sTimerID == 99 or sTimerID == "99" then
		Form.SetTimerEvent(99,0,1)
		Form.clearWaitCursor()
		
		'v0017 : 권한설정 추가4 (타이머 안에서 권한 설정 해제 추가)
		'로그인여부
	    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )
	
	    '비로그인상태에서만 비대면화면 권한부여
	    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
			Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
	    End If
	end if	
End Sub


