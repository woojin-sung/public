<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="56110" scrname="일임형ISA이수관_팝업_가입필수안내" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<BUTTON name="btnOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9" ly_vert="0,557,375,50,1" />
		<CONTAINER name="cont0" vscroll="1" scroll_pos="0,0" ly_vert="0,0,375,557,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblTitle0" fontsize="-2" caption="ISA계좌이전에 따른 일반적인 투자자 유의사항" ly_vert="20,20,327,30,1" />
				<CHKBUTTON name="chk0" ly_vert="20,60,32,60,1" />
				<LABEL name="lbltext0" fontsize="-3" caption="ISA계좌는 세제상의 불이익 없이 다른 금융기관으로 계좌를 이전할 수 있으나, 이전금액은 약관 및 계약서에 따른 보수, 환매수수료등을 차감 후 나머지 금액이 이전됩니다." multiline="1" click="1" ly_vert="47,60,303,70,1" />
				<CHKBUTTON name="chk1" ly_vert="20,130,32,50,1" />
				<LABEL name="lbltext1" fontsize="-3" caption="계좌이전시 편입 금융상품 해지에 따른 환매수수료(펀드), 중도상환 비용(파생결합증권), 금리손실(예적금 등)이 발생할 수 있습니다." multiline="1" click="1" ly_vert="47,130,303,50,1" />
				<CHKBUTTON name="chk2" ly_vert="20,180,32,50,1" />
				<LABEL name="lbltext2" fontsize="-3" caption="상품의 특성에 따라 계좌이전으로 인한 해지로 인해 원금손실이 발생하거나, 의무납입기간 미충족시 해지수수료가 크게 발생하는 등 투자위험이 수반될 수 있습니다." multiline="1" click="1" ly_vert="47,180,303,50,1" />
				<CHKBUTTON name="chk3" ly_vert="20,230,32,40,1" />
				<LABEL name="lbltext3" fontsize="-3" caption="이전 예상금액과 실제 이전금액은 환매일의 기준가, 수수료 등에 따라 달라질 수 있습니다." multiline="1" click="1" ly_vert="47,230,303,40,1" />
				<CHKBUTTON name="chk4" ly_vert="20,270,32,20,1" />
				<LABEL name="lbltext4" fontsize="-3" caption="상품의 특성에 따라 환매기간이 오래 걸릴 수 있습니다." multiline="1" click="1" ly_vert="47,270,303,20,1" />
				<CHKBUTTON name="chk5" ly_vert="20,290,32,50,1" />
				<LABEL name="lbltext5" fontsize="-3" caption="따라서 가입자는 이전신청 전 상기 상황을 충분히 설명을 들은 후 이전 결정을 내리시기 바랍니다." multiline="1" click="1" ly_vert="47,380,303,40,1" />
				<BUTTON name="btnAllCheck0" caption="전체선택" fgcolor="005:000000000" fontsize="-2" ly_vert="300,20,62,30,1" />
				<LABEL name="lblTitle1" fontsize="-2" caption="ISA 계좌이전 절차 관련 투자자 유의사항" ly_vert="20,425,327,30,1" />
				<BUTTON name="btnAllCheck1" caption="전체선택" fgcolor="005:000000000" fontsize="-2" ly_vert="300,425,62,30,1" />
				<CHKBUTTON name="chk6" ly_vert="20,465,32,50,1" />
				<LABEL name="lbltext6" fontsize="-3" caption="모든 편입 금융상품의 환매가 완료된 후 계좌이전이 완료되며, 이후 가입자가 사전에 정한 종목 및 비중(또는 MP상품)에 따라 해당 자산이 운용됩니다." multiline="1" click="1" ly_vert="47,465,303,50,1" />
				<CHKBUTTON name="chk7" ly_vert="20,515,32,50,1" />
				<LABEL name="lbltext7" fontsize="-3" caption="압류, 가압류, 질권 설정 등의 계좌, 부적격자 통보, 이전받을 금융기관의 여신 취급(구속성 여부) 등 일부 사유로 계좌이전이 불가할 수 있습니다." multiline="1" click="1" ly_vert="47,515,303,50,1" />
				<CHKBUTTON name="chk8" ly_vert="20,565,32,40,1" />
				<LABEL name="lbltext8" fontsize="-3" caption="통화불능, 기존 금융기관 미방문 등으로 이전의사가 확인되지 않을 경우 이전 신청이 취소될 수 있습니다." multiline="1" click="1" ly_vert="47,565,303,40,1" />
				<CHKBUTTON name="chk9" ly_vert="20,610,32,60,1" />
				<LABEL name="lbltext9" fontsize="-3" caption="가입자 요청에 의한 계좌이전 취소는 기존금융기관과의 최종적인 이전의사 확인(해피콜)전까지는 이전 신청을 취소할 수 있습니다. 단, 기존금융기관과의 이전의사 확인이후에는 취소가 불가능합니다." multiline="1" click="1" ly_vert="47,610,303,60,1" />
				<LABEL name="lblBlank" ly_vert="91,680,100,20,1" />
				<CHKBUTTON name="chk10" ly_vert="20,340,32,40,1" />
				<LABEL name="lbltext10" fontsize="-3" caption="금융기관 내 일임형↔중개형 이전시 수수료 등의 변경이 있을 수 있습니다." multiline="1" click="1" ly_vert="47,340,303,40,1" />
				<LABEL name="lbltext11" fontsize="-3" caption="주식 권리관계(배당 등)가 진행 중인 계좌는 권리관계 종료 후 이전을 권장합니다. 권리관계中 이전은 기존 계좌에서 세제 혜택 일부가 제한될 수 있습니다." multiline="1" click="1" ly_vert="47,290,303,50,1" />
				<CHKBUTTON name="chk11" ly_vert="20,380,32,40,1" />
				<LABEL name="lbltext12" fontsize="-3" caption="금융회사는 계좌이전 과정에서 금융회사의 절차 미준수 등 책임있는 사유로 고객이 과세특례를 받지 못하는 등 손해가 발생하는 경우 이에 대해 책임을 집니다." multiline="1" click="1" ly_vert="20,680,323,60,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3220" _ulen="3022" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청_가입필수안내
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'			   2022.11.25 : 고승연 : v0002 : [T2206170023] 유의사항 문구 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sRetData 


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function f_CheckAgreeState()
	if CInt(cont0.chk0.checkstate) == 0 or CInt(cont0.chk1.checkstate) == 0 or
		CInt(cont0.chk2.checkstate) == 0 or CInt(cont0.chk3.checkstate) == 0 or
		CInt(cont0.chk4.checkstate) == 0 or CInt(cont0.chk5.checkstate) == 0 or 
		CInt(cont0.chk10.checkstate) == 0 or CInt(cont0.chk10.checkstate) == 0 then
		
		Form.ShowAlert("알림", "ISA계좌이전에 따른 일반적인 투자자 유의사항을 확인해주세요.")
		
		return false
	end if
	
	if CInt(cont0.chk6.checkstate) == 0 or CInt(cont0.chk7.checkstate) == 0 or 
		CInt(cont0.chk8.checkstate) == 0 or CInt(cont0.chk9.checkstate) == 0 then
		
		Form.ShowAlert("알림", "ISA계좌이전에 절차 관련 투자자 유의사항을 확인해주세요.")
		
		return false
	end if
	
	return true
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "cancel"
	Form.SetScreenName("ISA계좌이전에 따른 가입자 유의사항")
End Sub

'============================================================================
Sub btnOK_OnClick()
	if f_CheckAgreeState() == true then
		g_sRetData = "ok"
		Form.SendReturnToParent( "mbisa56110_p1" , g_sRetData )
		Form.CloseForm( )
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_sRetData == "cancel" then
		Form.SendReturnToParent( "mbisa56110_p1" , "cancel" )
	end if
End Sub

'============================================================================
Sub cont0_btnAllCheck0_OnClick()
	cont0.chk0.checkstate = true
	cont0.chk1.checkstate = true
	cont0.chk2.checkstate = true
	cont0.chk3.checkstate = true
	cont0.chk4.checkstate = true
	cont0.chk5.checkstate = true
	cont0.chk10.checkstate = true
	cont0.chk11.checkstate = true
	
End Sub

'============================================================================
Sub cont0_btnAllCheck1_OnClick()
	cont0.scroll_pos = "bottom"
	
	cont0.chk6.checkstate = true
	cont0.chk7.checkstate = true
	cont0.chk8.checkstate = true
	cont0.chk9.checkstate = true
End Sub



	</SCRIPT_INFO>
</ROOT>