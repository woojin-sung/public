'============================================================================
Sub chkGrid_OnChange(sCheckState)
	RequestData()
End Sub
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	'szTrDate = Grid0.GetCellData( "bd_cell0", lRow )
	'Form.OpenFramePopup( "mbtrs15020_p2.xmf" , szTrDate+"!"+g_szISCD+"!"+chkGrid.checkstate , "" )
	if szCellID == "bd_cell30" then
		'순서 : 계좌번호 계좌일련번호 종목코드 시작일자 종료일자 신용비용
		szTempAcno = Form.GetCtlProp("#acnt0", "total")
		szTempAsno = Form.GetCtlProp("#acnt0", "sequence")
		szTempIscd = Grid0.GetCellData("bd_cell9", lRow)
		szTempStaDate = cldFrom.caption
		szTempFinDate = cldTo.caption
		szTempIncuFlag= chkGrid.checkstate
		
		szOpenData = szTempAcno & "★" & szTempAsno & "★" & szTempIscd & "★" & szTempStaDate & "★" & szTempFinDate & "★" & szTempIncuFlag
		Form.OpenFramePopup("mbtrs15020_p3.xmf" , szOpenData , "")
	end if
End Sub

'v001
'============================================================================
Sub cboPrd_OnEditComplete(iIndex)
	cldTo.todaymode = 1
	cldFrom.todaymode = 1
	
	if iIndex == 0 then		'당일
		'cldTo.todaymode = 1
		'cldFrom.todaymode = 1
	elseif iIndex == 1 then	'1주일
		cldFrom.addday = -7
	elseif iIndex == 2 then	'당월
		cldFrom.caption = mid(cldTo.caption, 1, 6) & "01"
	elseif iIndex == 3 then	'1개월
		cldFrom.addday = -30
	elseif iIndex == 4 then	'3개월
		cldFrom.addday = -30*3
	elseif iIndex == 5 then	'6개월
		cldFrom.addday = -30*6
	end if
	
	RequestData()
End Sub
