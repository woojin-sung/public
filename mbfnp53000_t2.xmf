'============================================================================
' 01. 화 면 명 : ELS/DLS청약_취소탭
' 02. 화면설명 : ELS/DLS청약_취소탭
' 03. 작    성 : 2016. 03. 05. 유창재
' 04. 수    정 : 2020. 09. 16. 성주혁 MTS 메모리 보안 v0001
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szOSTest			'OS Type, 1:안드로이드, 2:IOS
Dim g_szOSType			'OS Type, 안드로이드 = 157, IOS = 156
Dim g_szPW				'비밀번호
Dim g_nRowIndex			'RowIndex
Dim plain_rm				'메모리평문 적용유무 
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	g_szOSTest = Form.GetSharedData( "&OS_TYPE", false )
	
	if g_szOSTest == "1" then
		g_szOSType = 157			'안드로이드
	else
		g_szOSType = 156			'IOS
	end if
	
	DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Form_OnFormInit()
	
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()
	
	'v0001
	'AS-IS
	'g_szPW = Form.GetEncData( edtPW.caption )
	
	'To-Be
	if plain_rm =="1" then
		g_szPW = edtPW.caption
	else
		g_szPW = Form.GetEncData( edtPW.caption )
	end if
	
	
	DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obibk_pssb_029r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "APLT_DATE" , 0 , cld0.caption)			'신청일자(당일날자)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ACNO" , 0 , acnt0.total)					'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ASNO" , 0 , acnt0.sequence)				'일련번호
		
	elseif szTranID == "obibk_pssb_022a" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , g_szOSType)		'채널유형구분코드(OS별 입력값 안드로이드:157, IOS:156)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock1", "ACNO" , 0 , acnt0.total)					'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock1", "ASNO" , 0 , acnt0.sequence)				'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)					'비밀번호

		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock2", "SBSC_DATE" , 0 , grd0.GetCellData( "bd_cell4", g_nRowIndex))		'신청일자
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock2", "SBSC_ISSU_SRNO" , 0 , grd0.GetCellData( "bd_cell8", g_nRowIndex))		'청약종목일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock2", "SBSC_APLT_SRNO" , 0 , grd0.GetCellData( "bd_cell9", g_nRowIndex))		'청약신청일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock2", "SBSC_STCN" , 0 , grd0.GetCellData( "bd_cell1", g_nRowIndex))			'청약주수
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock2", "SBSC_MARG" , 0 , grd0.GetCellData( "bd_cell5", g_nRowIndex))			'청약증거금
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_022a", "InBlock2", "CNCL_YN" , 0 , "Y")			'취소 신청시 무조건 취소가능 값으로 보내라고 요청받음
		
	elseif szTranID == "obcsb_oimf_625r" then			'보안매체 확인을 위한 TR
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = acnt0.total
		sACNO_PWD = g_szPW
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obibk_pssb_029r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obibk_pssb_029r", "OutBlock1") - 1
			if grd0.GetCellData( "bd_cell10", i) == "N" then			'취소여부 판별 N:취소가능, Y:취소불가
				grd0.SetCellData( "bd_cell7", i, "취소")
				grd0.SetCellEnable("bd_cell7", i, true)
			else
				grd0.SetCellData( "bd_cell7", i, "취소")
				grd0.SetCellEnable("bd_cell7", i, false)
			end if
			grd0.SetCellFgColor("bd_cell7", i, "4")
		next
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'모바일OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	elseif szTranID == "obibk_pssb_022a" then
		Form.ShowAlert( "알림", "정상처리 되었습니다.")
		DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
	end if
	
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	
	DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	
	if g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요")
		Exit Sub
	else
		if szCellID == "bd_cell7" then
			g_nRowIndex = lRow
'			DATAMANAGER.RequestTranData( "obibk_pssb_022a" )			'Test용
			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
		end if
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	
	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'취소실행
			DATAMANAGER.RequestTranData( "obibk_pssb_022a" )
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if		
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obibk_pssb_022a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obibk_pssb_022a" )
		if Trim(szSubErr) <> "" or Trim(szSubErr) <> Null then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		else
			Form.ShowAlert( "알림", szErrMsg )
		end if
	end if
	
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", acnt0.total &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obibk_pssb_029r" trcode="obibk_pssb_029r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="SBSC_ISSU_CLS_CODE" idx="3" defconst="03" />
				</TRBLOCK>
