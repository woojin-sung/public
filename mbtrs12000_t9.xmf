				<CELL cell_ly="0,0,0,0" fgcolor="321:115118124" halign="0" line="0,1" caption="평가금액" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="1,0,5,0" import="0,1,4" halign="2" line="0,1" fontsize="-2" mask="0,0,,원,0,,0,1,0,0,0" fontstyle="01" paddinginfo="0,0,1,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" fgcolor="321:115118124" valign="2" halign="0" line="0,0" caption="평가손익" fontsize="-2" paddinginfo="1,0,0,5" impidxs="" />
				<CELL cell_ly="1,1,4,1" valign="2" halign="2" line="0,0" fontsize="-2" autofontsize="1" paddinginfo="0,0,1,5" impidxs="" />
				<CELL cell_ly="5,1,5,1" valign="2" halign="2" line="0,0" fontsize="-2" mask="0,0,,%,0,,2,1,1,0,0" paddinginfo="0,0,1,5" impidxs="" />
				<CELL cell_ly="0,2,0,2" fgcolor="321:115118124" halign="0" line="0,0" caption="매입금액" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="1,2,2,2" import="0,1,7" halign="2" line="1,0" fontsize="-2" mask="0,0,, ,0,,0,1,0,0,0" autofontsize="1" paddinginfo="0,0,1,0" impidxs="" />
				<CELL cell_ly="3,2,3,2" fgcolor="321:115118124" line="0,0" caption=" D+2예수금" fontsize="-2" impidxs="" />
				<CELL cell_ly="4,2,5,2" import="0,1,1" halign="2" line="0,0" fontsize="-2" mask="0,0,,,0,,0,1,1,0,0" autofontsize="1" paddinginfo="0,0,1,0" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<CHKBUTTON name="chk2" fontsize="-2" chkcaption="비용포함" unchkcaption="비용포함" chkbtnimage="checkmenu_o.png" unchkbtnimage="checkmenu_n.png" ly_vert="10,120,80,25,1" />
		<CHKBUTTON name="chk1" fontsize="-2" chkcaption="신용합산" unchkcaption="신용합산" chkbtnimage="checkmenu_o.png" unchkbtnimage="checkmenu_n.png" ly_vert="95,120,77,25,1" />
		<LABEL name="lblDetail" fontsize="-2" caption="상세 ＞" halign="2" paddinginfo="0,0,1,0" click="1" ly_vert="300,120,65,25,1" />
		<LABEL name="lblPer" fontsize="-2" mask="0,0,,%,0,,2,1,1,0,0" halign="2" valign="2" paddinginfo="0,0,1,10" ly_vert="280,50,75,30,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="15800" _ulen="14608" >
