'--===========================================================================
Dim g_szRmndCd, g_szLoanCd, g_szItemCode, g_szData

Dim  g_szSelect, g_szFold
Dim g_szRmndCd
Dim g_szLoanCd

Dim g_index

Dim g_RghtFlag
Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer
Dim g_switch
Dim g_VltnFlag '0 순자산평가 1 유가증권평가액
Dim g_ByovFlag '0 평가손익 1 총 매입단가

g_szFold = "1"

'============================================================================
Sub lblDetail_OnClick()
	Form.OpenScreen("15000" , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHNAGE_TAB" then
		chk1.checkstate = "0"
		chk2.checkstate = "0"
		RequestData()
	elseif sEventName == "ACNT_CHANGE" then
		RequestData()
	end if
End Sub

'============================================================================
Function RequestData()
	grd0.rowcount = 0
	lblPer.caption = ""
	tbl0.SetCellString(0, 1, "")
	tbl0.SetCellString(1, 1, "")
	tbl0.SetCellString(2, 1, "")
	tbl0.SetCellString(2, 4, "")
	DATAMANAGER.RequestTranData( "obacb_balc_105r" )

End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szFEE_INCU_YN
	Dim szACNO, szASNO
	
	'비용반영
	If chk2.checkstate = "1" Then
		szFEE_INCU_YN = "Y"
	Else
		szFEE_INCU_YN = "N"
	End If
	
	szACNO = Form.GetCtlProp("#acnt", "total")
	szASNO = Form.GetCtlProp("#acnt", "sequence")
	
	If szTranID = "obacb_balc_105r" Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" 	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ACNO" 			, 0 , szACNO 		)		
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
	elseIf szTranID = "obtrs_comn_310r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "ACNO"			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "ASNO"			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "BRNG_STCK_YN"	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_310r", "InBlock1", "FEE_INCU_YN"	, 0 , szFEE_INCU_YN )		
		
	ElseIf szTranID = "obtrs_comn_329r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "ACNO" 			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD" 	, 0 , "00" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "BRNG_STCK_YN" 	, 0 , "N" 		)
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_329r", "InBlock1", "FEE_INCU_YN" 	, 0 , szFEE_INCU_YN )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obacb_balc_105r" Then
		
		If chk1.checkstate = "1" Then
			DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
		Else
			DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
		End If

	elseIf szTranID = "obtrs_comn_329r" Or szTranID = "obtrs_comn_310r" Then
		
		SetGridData()

		For i = 0 To grd0.rowcount - 1
			psnt_prc = Cdbl(grd0.GetCellData("bd_cell4", i))
			psdy_clpr= Cdbl(grd0.GetCellData("bd_cell21",i))
			
'			01현금 02대출 03신용 04대주 05대여 06대용 07재활용 99기타			
			szGbn = grd0.GetCellData("bd_cell24",i)
			
			Select Case szGbn
				Case "01"
					grd0.SetCellData("bd_cell17", i, "현금")
				Case "02"
					grd0.SetCellData("bd_cell17", i, "대출")	
				Case "03"
					grd0.SetCellData("bd_cell17", i, "신용")
				Case "04"
					grd0.SetCellData("bd_cell17", i, "대주")
				Case "05"
					grd0.SetCellData("bd_cell17", i, "대여")
				Case "06"
					grd0.SetCellData("bd_cell17", i, "대용")
				Case "07"
					grd0.SetCellData("bd_cell17", i, "재활용")
				Case "99"
					grd0.SetCellData("bd_cell17", i, "기타")
			end Select
			
			'순매입금액 추가
			If Trim(grd0.GetCellData("bd_cell3", i)) == "" Then
				byng_amt = 0
			Else
				byng_amt = Cdbl(grd0.GetCellData("bd_cell3", i))
			End If

			If Trim(grd0.GetCellData("bd_cell6", i)) == "" Then
				loan_amt = 0
			Else
				loan_amt = Cdbl(grd0.GetCellData("bd_cell6", i))
			End If

			grd0.SetCellData("bd_cell16", i, byng_amt - loan_amt)
		Next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert( "알림" , szErrMsg )
End Sub

'============================================================================
Function SetGridData()
	Dim i, nRate, szData, szReturnValue
	Dim nVLTN_PRLS_AMT      ' 평가손익
	Dim nBYNG_AMT           ' 매입금액
	Dim nEXPN_AMT           ' 비용금액
	Dim nTOT_VLTN_PRLS_AMT  ' 평가손익합계
	Dim nTOT_BYNG_AMT       ' 매입금액합계
	Dim szLOAN_DATE         ' 대출일자

	nVLTN_PRLS_AMT     = 0
	nBYNG_AMT          = 0
	nTOT_VLTN_PRLS_AMT = 0
	nTOT_BYNG_AMT      = 0

	g_Toggle1 = 0
	g_Toggle2 = 0

'	SetGridHeader(g_Toggle1, g_Toggle2)

	For i = 0 To grd0.rowcount -1

		If chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT  = CDbl( grd0.GetCellData( "bd_cell2", i ) ) - CDbl( grd0.GetCellData("bd_cell20", i) )  '신용이자
		Else
			nVLTN_PRLS_AMT  = CDbl( grd0.GetCellData( "bd_cell2", i ) )
		End If

		nBYNG_AMT   = CDbl( grd0.GetCellData( "bd_cell3", i ) )
		nPSNT_PRC   = grd0.GetCellData( "bd_cell4" , i )
		szData      = grd0.GetCellData( "bd_cell10" , i )
		szLOAN_DATE = grd0.GetCellData( "bd_cell5", i)
		szRMND_CLCD = grd0.GetCellData( "bd_cell22", i)

		nTOT_VLTN_PRLS_AMT = nTOT_VLTN_PRLS_AMT + nVLTN_PRLS_AMT
		nTOT_BYNG_AMT      = nTOT_BYNG_AMT + nBYNG_AMT

		grd0.SetCellData("bd_cell2", i, nVLTN_PRLS_AMT)

		'매입금액이 있는 경우에만 계산
		If CDbl( grd0.GetCellData("bd_cell3", i) ) = 0 Then
			grd0.SetCellData("bd_cell12", i, "" )
		Else
			'수익률이 천단위가 넘는 경우 콤마가 중복으로 생기므로 FormatNumber 제거
			'grd0.SetCellData("bd_cell7", i, FormatNumber(FIX((nVLTN_PRLS_AMT/nBYNG_AMT)*10000)/100,2))
			grd0.SetCellData("bd_cell12", i, Fix( (nVLTN_PRLS_AMT/nBYNG_AMT) * 10000) / 100 )
		End If


		If nPSNT_PRC = "" and chk2.checkstate = "1" Then
			Dim nData
			nData = CDbl(grd0.GetCellData( "bd_cell18", i )) * -1
			grd0.SetCellData( "bd_cell2", i, nData )
		End If

		If szData = "0101" Or szData = "0102" Or szData = "0103" Or szData = "0104" Or
		   szData = "0201" Or szData = "0202" Or szData = "0203" Or szData = "0204" Or
		   szData = "0301" Then
			grd0.SetCellData( "bd_cell7", i, "" )
		ElseIf CDbl(grd0.GetCellData( "bd_cell1", i )) = 0 Then
			grd0.SetCellData( "bd_cell7", i, 0 )
		Else
			nBepUnpr = Fix( CDbl(grd0.GetCellData( "bd_cell23", i )) + ( CDbl(grd0.GetCellData( "bd_cell20", i ))  / CDbl(grd0.GetCellData( "bd_cell1", i )) ) )
			grd0.SetCellData( "bd_cell7", i, nBepUnpr )
		End If

		Select Case szData
			Case "0000" szReturnValue = "보통"
			Case "0101" szReturnValue = "자기융자"
			Case "0102" szReturnValue = "유통융자"
			Case "0103" szReturnValue = "자기대주"
			Case "0104" szReturnValue = "유통대주"
			Case "0201" szReturnValue = "예탁주식"
			Case "0202" szReturnValue = "예탁채권"
			Case "0203" szReturnValue = "예탁집합투자"
			Case "0204" szReturnValue = "예탁장외파생"
			Case "0211" szReturnValue = "예탁유통주식"
			Case "0212" szReturnValue = "예탁유통채권"
			Case "0213" szReturnValue = "예탁유통집합투자"
			Case "0214" szReturnValue = "예탁유통장외파생"
			Case "0301" szReturnValue = "매도증권담보대출"
			Case "0302" szReturnValue = "수익증권환매"
			Case "0303" szReturnValue = "ELS환매자금대출"
			Case "0401" szReturnValue = "소액주식"
			Case "0402" szReturnValue = "소액채권"
			Case "0403" szReturnValue = "소액수익증권"
			Case "0404" szReturnValue = "소액 ELS"
			Case "0501" szReturnValue = "공모주청약"
			Case "0502" szReturnValue = "ELS청약"
			Case "0503" szReturnValue = "주식매입"
			Case "0601" szReturnValue = "매입자금대출"
			Case "0701" szReturnValue = "초단기대출"
			Case "0801" szReturnValue = "CMA담보대출"
			Case "9201" szReturnValue = "대출(대여)" 'v003
			Case "8201" szReturnValue = "양도담보" 'v004
			Case Else   szReturnValue = szData
		End Select

		If szData = "0000" Then
			If szRMND_CLCD = "31" Then
				szReturnValue = "대여주식"
			ElseIf szRMND_CLCD = "32" Then
				szReturnValue = "CFD대용"
			ElseIf szRMND_CLCD = "16" Then
				szReturnValue = "선물대용"
			End If
		End If

		grd0.SetCellData( "bd_cell10", i, szReturnValue )

	Next

	If nTOT_BYNG_AMT == 0 Then
		nRate = 0
	Else
		nRate = Round((nTOT_VLTN_PRLS_AMT / nTOT_BYNG_AMT) * 100, 2)
	End If

	tbl0.SetCellString( 1, 1, FormatNumber(nTOT_VLTN_PRLS_AMT,0).." |")   '미실현손익
'	tbl0.SetCellString( 1, 2, nRate             )   '손익률
	lblPer.caption = nRate

	if trim(nTOT_VLTN_PRLS_AMT) == "" or nTOT_VLTN_PRLS_AMT == 0 then
		tbl0.SetCellFgColor(1, 1, "3")
'		tbl0.SetCellFgColor(1, 2, "3")
		lblPer.fgcolor = "3"
	elseif nTOT_VLTN_PRLS_AMT > 0 then
		tbl0.SetCellFgColor(1, 1, "1")
		tbl0.SetCellFgColor(1, 2, "1")
		lblPer.fgcolor = "1"
	elseif nTOT_VLTN_PRLS_AMT < 0 then
		tbl0.SetCellFgColor(1, 1, "2")
'		tbl0.SetCellFgColor(1, 2, "2")
		lblPer.fgcolor = "2"
	end if

End Function 
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemCode, szQty, szLoanDate, szLoanCd, szLoanSr, szLoan, listLocation
    Dim szCutCd, szMk
    Dim errmsg

    errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

    g_szItemCode    =   grd0.GetCellData("bd_cell8", lRow)

    listLocation =  Split(grd0.location,":")
    nYPos = Int(listLocation[1])
    height = listLocation[3]

    szItemCode = grd0.GetCellData("bd_cell8", lRow)
    szQty      = grd0.GetCellData("bd_cell11" , lRow)
    szLoanDate = grd0.GetCellData("bd_cell5", lRow)
    szLoanCd   = grd0.GetCellData("bd_cell9", lRow)
    szLoanSr   = grd0.GetCellData("bd_cell19", lRow)
    szRmndCd   = grd0.GetCellData("bd_cell22", lRow)
    g_szRmndCd = szRmndCd   '전역변수로 사용하기 위함
    g_szLoanCd = szLoanCd  '전역변수로 사용하기 위함

    If szLoanCd = "0000" And (szRmndCd = "31" Or szRmndCd = "32" Or szRmndCd = "16") Then
        sPopupType = "3"
'		sPopupType = "2"
    Else
        sPopupType = "2"
    End If

    ' 20160310 주문불가한 종목 예외처리
    ' 20170502 상장수익증권 예외처리 'F'
    ' case: 신주인수권/증권 (9자리)
    If (left(szItemCode,1) ="J" And len(szItemCode) == 9) Or left(szItemCode,1) ="Q" Or left(szItemCode,1) = "F" Then
        szMk = Form.GetItemCodeInfo(szItemCode, "market")
    ' Else: 기타
    Else
        ' 20160310 주문불가한 종목 예외처리
        szCutCd = Mid(szItemCode, 2, Len(szItemCode))
        szMk = Form.GetItemCodeInfo(szCutCd, "market")
    End If

    If Trim(szMk) = "J" Or Trim(szMk) = "Q" Or Trim(szMk) = "W" Or Trim(szMk) = "T" Then
        ' 전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
        ' 전달내용, 탭위치는 리턴받아서 처리함.
        g_szData = szItemCode & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr

        g_szSelect = "1"

        If sPopupType = "2" Then
            Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "" & "★" & g_szItemCode)
        ElseIf sPopupType = "3" Then
            If szRmndCd = "31" Then
                Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            ElseIf szRmndCd = "32" Or szRmndCd = "16" Then
                Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "대용매도" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            Else
                Form.OpenPopup("movepopup4" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "" & "★" & "" & "★" & "" & "★" & g_szItemCode)
            End If
        End If
		
    Else
        Form.MsgBox("알림", errmsg, "REUPDATE", 1)
    End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "MOVEPOP_RETURN" then
		Dim szListItems
		szListItems =   Split(sRet,"★")

		If  szListItems(2)  =   "2" Then
			If  szListItems(1)  =   "0" Then            '현재가
				Form.OpenScreen("11000" , g_szItemCode & "★" & "0")

			ElseIf  szListItems(1)  =   "1" then        '매수
				If g_szLoanCd = "0103" Or g_szLoanCd = "0104" Then
					Form.OpenScreen("12090" , "잔고" & "★" & "1" & "★" & g_szData )
				Else
					Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
				End If
			ElseIf  szListItems(1)  =   "2" then        '매도
				If g_szLoanCd = "0103" Or g_szLoanCd = "0104" Then
					Form.OpenScreen("12090" , "잔고" & "★" & "0" & "★" & g_szData )
				Else
					Form.OpenScreen("12000" , "잔고" & "★" & "1" & "★" & g_szData )
				End If
			ElseIf  szListItems(1)  =   "6" Then        '차트
				Form.OpenScreen("13000" , g_szItemCode)
			End If
		ElseIf  szListItems(2)  =   "3" Then
			If  szListItems(1)  =   "0" Then            '현재가
				Form.OpenScreen("11000" , g_szItemCode & "★" & "0")
			ElseIf  szListItems(1)  =   "1" Then        '대여매도
				If g_szRmndCd = "31" Then
					Form.OpenScreen("12060" , "잔고" & "★" & "0" & "★" & g_szData )
				Else
					Form.OpenScreen("12080" , "잔고" & "★" & "0" & "★" & g_szData )
				End If
			ElseIf  szListItems(1)  =   "2" Then        '대용매수
				Form.OpenScreen("12000" , "잔고" & "★" & "0" & "★" & g_szData )
			ElseIf  szListItems(1)  =   "6" Then        '차트
				Form.OpenScreen("13000" , g_szItemCode)
			End If
		End If

		g_szData = ""
	end if
	
End Sub

