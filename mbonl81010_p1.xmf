'								  국내/해외파생ETF 보완조치 로직 추가 
'		     : 2018.02.12 : 윤유정 : ETP 약정일 경우 계좌일련번호 셋팅 제외 v006
'		     : 2018.03.14 : 김유경 : 변동성ETN거래신청 추가 v007
'			: 2020.01.23 : 조승행 : 집합투자증권 위임인계좌 비적합대상 추가매수 불가 v008 
' 			: 2020.10.12  : 정민영 : v009 : [T2008250015] 메모리취약점 보완
'			: 2021.04.30 : 정우희 : v010 집합투자증권 가입시 숙려여부 체크 / 목표시장 체크
'             : 2021.06.16 : 김인택 : v011
'             : 2021.08.02 : 정효영 : v012
'             : 2021.08.12 : 정효영 : v013
' 2021.08.31 : 정민영 : v014 : 투자권유 희망여부 확인서 추가(5등급 상품개설)
' 2021.09.10 : 김인택 : v015 : 투자권유 희망여부 확인서 추가(5등급 상품개설)
' 2021.12.23 : 김수진 : v016 : K-OTC 거래신청 추가
' 2022.03.15 : 김유경 : obcsb_acif_792a IO 추가
' 2022.03.25 : 김수진 : v017 펀드매매> 신규매수탭 금융상품 일련번호 Shared 값 obcsb_acif_792a input으로 셋팅
' 2022.04.20 : 김성수 : v018 소수점 거래 추가
' 2022.07.22 : 임동군 : v019 미스터리쇼핑 결과에 따른 비대면채널 펀드신규매수 프로세스 개선
'                                     펀드신규매수시 투자성금융투자상품 확인서 확인 후 공인인증서 수행
' 2022.08-15 : 신극수 : v020 : Wrap 비대면 계약 [계좌전환]
' 2023.06.19 : 양현정 : v021 : CMA전환신청관련 수정
' 2023.08.04 : 강희승 : v022 해외주식 소수점 거래신청 시 투자성향 skip
' 2023.11.22 : 권오상 : v023 mbonl81010_s1 -> mbonl81010_s2 모두 변경
' 2023.12.04 : 고승연 : v024 : [T2310260012] 상품등급변경 적용
' 2024.07.23 : 정우희 : v025 : 자동이체약정 적정(적합)성 원칙 적용
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim  szProsYN     'v011 
dim	g_szScrno	'화면번호
dim	g_szAcno		'계좌번호
dim	g_szAsno		'계좌일련번호
dim	g_szBswr		'KYC업무분류코드(KYC_BSWR_DIV_COE)
dim	g_szDiv		'업무분류코드(BSWR_DIV_CODE)
dim	g_szISCD		'종목코드
dim	g_szPasswd	'패스워드
dim	g_szKspKdq	'유가증권시장 및 코스닥시작 상장증권 매매함
dim	g_szAlertTitle'안내창 타이틀
dim	g_szSvcd      '서비스코드
dim	g_szProcTc    '처리구분 1:700r과 2:713r 분기용  

g_szAlertTitle	=	"알림"
'For obcsb_acif_703a INPUT------from obcsb_acif_700a -----------------------
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 			'KYC상품등급코드
Dim g_szKYC_DVPD_EPMD_CODE		 	'KYC파생상품유의코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szDVPD_GRAD_CODE 			'파생상품등급코드

Dim g_szKYC_INVT_RCMD_CLS_CODE  	'KYC투자권유구분코드 v011
Dim g_szAPRT_SRNM_PROD_YN            '적정성상품여부 v011
Dim g_szRSLT_CLS                     '결과구분 v020
' v003 for obcsb_acif_760a input from mbonl81010_p6/7
Dim g_szSfdiAcmpYn
Dim g_szExnTlmsCnfrYn

Dim g_szTrgtYn
Dim g_szSelfDigReturn
'v008
Dim g_szSelfacctyn				'본인계좌여부
Dim g_plain_rm  					'v009 메모리평문적용여부
Dim g_szOPNG_PRCD					'v014

'21.08.12 JHY (v013)
Dim g_szCustCode '고객구분코드
'Dim g_szPfinYn '전문금융소비자 여부
Dim g_isOpenPopup '전문금융소비자 목표시장 설문팝업 오픈
g_isOpenPopup = false


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setItemSetting(szInput)
	g_szScrno	=	getListItem(szInput, 0)

	g_szAcno=""
	g_szAsno=""
	g_szBswr=""
	g_szDiv=""
	g_szIscd=""
	g_szPasswd=""
	g_szKspKdq=""
	g_szSvcd=""
	
	'온라인계좌개설,	
	'			 화면번호★상세구분★유가증권체크★ACNO★PASSWD
	'	  종합매매: 84010★0★유가증권체크★ACNO★PASSWD
	'	  CMA(RP) : 84010★1★" "★ACNO★PASSWD
	'	  선물옵션: 84010★2★" "★ACNO★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl84010_t2.xmf	84010★0★금상전용구분★ACNO★PWD	온라인계좌개설_종합매매계좌개설
	'mbonl84010_t4.xmf	84010★1★★ACNO★PWD				온라인계좌개설_CMA계좌개설
	'mbonl84010_t7.xmf	84010★0★0★ACNO★PWD				온라인계좌개설_ISA계좌개설
	'mbonl89030.xmf		84010★1★★ACNO★PWD				CMA 계좌 전환 신청
	if	g_szScrno	=	"84010"	then
		
		'v014 종합매매: 84010★0★유가증권체크(1)종합매매구분(1)★ACNO★PASSWD
		'g_szKspKdq 
		tmpStr = getListItem(szInput,2)
		'Form.ShowAlert("테스트", tmpStr)
		g_szKspKdq = Mid(tmpStr,1,1)  '1.유가증권체크 0.유가증권미체크
	
		g_szAcno	=	getListItem(szInput,3)
		g_szPasswd =	getListItem(szInput,4)

		g_szBswr	=	"03"
		
		if	getListItem(szInput,1)	=	"0"	then			'종합매매계설
			g_szDiv	=	"01004"
			'v014
			'v015 '1.금융상품전용체크 0.금융상품전용미체크
			
			'Form.ShowAlert("tmpStr", Mid(tmpStr,2,1))
			If Mid(tmpStr,2,1) = "1" Then   
			    g_szOPNG_PRCD = "10F"	'금상전용
			    g_szDiv	=	"01052" '금융상품전용계좌 'v015	
			Elseif Mid(tmpStr,2,1) = "0" Then  
			    g_szOPNG_PRCD = "100"
			Else 'v015 ISA계좌
			    g_szOPNG_PRCD = "133" 
			End If
		elseif	getListItem(szInput,1)	=	"1"	then		'CMA(RP)
			'v015 g_szDiv	=	"17052"
			g_szDiv	=	"01045"  'v015
			g_szOPNG_PRCD = "118"	'v014
		elseif	getListItem(szInput,1)	=	"2"	then		'선물옵션
			g_szDiv	=	"01005"
			g_szOPNG_PRCD = "101"	'v014
		end if
		

	'파생상품ETF거래신청
	'			 화면번호★ACNO★PASSWD
	'			 88000★ACNO★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl88000.xmf		88000★ACNO★PWD★054		파생상품ETF거래신청
	'mbonl88000_p2.xmf	88000★ACNO★PWD★054		자동해지 보완처리
	elseif	g_szScrno	=	"88000"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,2)
		g_szSvcd = getListItem(szInput,3) 'v005
		
		'v005
'		g_szBswr	=	"02"
'		g_szDiv	=	"17127"
		if g_szSvcd = "054" then
			g_szBswr	=	"02"
			g_szDiv	=	"17127"
		elseif g_szSvcd = "083" then
			g_szBswr	=	"02"
			g_szDiv	=	"17192"
		end if
		
		
	'ELW거래신청
	'			 화면번호★ACNO★PASSWD
	'			 88010★ACNO★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl88010.xmf	88010★ACNO★PWD	ELW거래신청
	elseif	g_szScrno	=	"88010"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,2)
		g_szBswr	=	"02"
		g_szDiv	=	"17015"


	'ETN거래신청
	'			 화면번호★ACNO★PASSWD
	'			 88020★ACNO★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl88020.xmf	88020★ACNO★PWD	ETN거래신청
	elseif	g_szScrno	=	"88020"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,2)

		g_szBswr	=	"02"
		g_szDiv	=	"17160"
		
		
	'신용계좌개설
	'			 화면번호★ACNO★ASNO★PASSWD
	'			 82010★ACNO★ASNO★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl81020.xmf	81020★ACNO★ASNO★PWD		신용계좌개설
	elseif	g_szScrno	=	"82010"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szAsno	=	getListItem(szInput,2)
		g_szPasswd =	getListItem(szInput,3)
		g_szBswr	=	"02"
		g_szDiv	=	"16001"

	'펀드매매
	'			 화면번호★상세구분★ACNO★ASNO★ISCD★PASSWD
	'	  신규매수: 51000★0★ACNO★ASNO★ISCD★PASSWD
	'	  추가매수: 51000★1★ACNO★ASNO★ISCD★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbfnp51010_t1.xmf	51000★0★ACNO★ASNO★ISCD★PWD		펀드매매_신규매수탭
	'mbfnp51010_t2.xmf	51000★1★ACNO★ASNO★ISCD★PWD		펀드매매_추가매수탭
	elseif	g_szScrno	=	"51000"	then
		g_szBswr	=	"01"
		g_szAcno	=	getListItem(szInput,2)
		g_szAsno	=	getListItem(szInput,3)
		g_szIscd	=	getListItem(szInput,4)
'		g_szPasswd =	getListItem(szInput,5)	'비밀번호 사용 안함. 20230509 EK. 


		if	getListItem(szInput,1)	=	"0"	then			'신규매수
			g_szDiv	=	"01010"
		elseif	getListItem(szInput,1)	=	"1"	then		'추가매수
			g_szDiv	=	"13005"
		end if
	

	'ELS/ DLS청약	
	'			 화면번호★ACNO★ASNO★ISCD★PASSWD
	'			 53000★ACNO★ASNO★ISCD★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbfnp53000_p1.xmf	53000★0★ACNO★ASNO★ISCD★PWD		ELS/DLS청약_청약신청팝업
	elseif	g_szScrno	=	"53000"	then
		g_szBswr	=	"01"
		g_szAcno	=	getListItem(szInput,1)
		g_szAsno	=	getListItem(szInput,2)
		g_szIscd	=	getListItem(szInput,3)
		g_szPasswd =	getListItem(szInput,4)

		g_szDiv	=	"15008"
	'공모주청약-주식 v002	
	'			 화면번호★ACNO★ASNO★ISCD★PASSWD
	'			 83110★ACNO★ASNO★ISCD★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl83110_p2.xmf	83110★0★ACNO★ASNO★ISCD★PWD		공모주청약_청약신청팝업
	elseif	g_szScrno	=	"83110"	then
	     g_szBswr	=	"04"
		g_szAcno	=	getListItem(szInput,1)
		g_szAsno	=	getListItem(szInput,2)
		g_szIscd	=	getListItem(szInput,3)
		g_szPasswd =	getListItem(szInput,4)

		g_szDiv	=	"15006" 

	'CME/EUREX야간거래신청 추가 v004	
	'			 화면번호★ACNO★ASNO★PASSWD★SVCD
	'			 87040★ACNO★ASNO★PASSWD★SVCD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl87040_t1.xmf	87040_t1★ACNO★ASNO★PWD★075		CME 야간거래 신청/해지
	'mbonl87040_t2.xmf	87040_t2★ACNO★ASNO★PWD★076		EUREX 야간거래 신청/해지
	elseif	g_szScrno	=	"87040_t1" or g_szScrno	=	"87040_t2"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szAsno	=	getListItem(szInput,2)
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"
		
		if g_szSvcd = "075" then
			g_szDiv	=	"17178"
		elseif g_szSvcd = "076" then
			g_szDiv	=	"17180"
		end if	
	
	'해외주식, 해외파생ETF 거래신청 추가 v005
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl88000_p2.xmf	87050★ACNO★★PWD★083		자동해지 보완처리
	'mbonl87051.xmf		87051★ACNO★ASNO★PWD★082		해외주식 거래신청
	'mbonl87050.xmf		87050★ACNO★ASNO★PWD★083		해외ETP 거래신청
	elseif	g_szScrno	=	"87050" or g_szScrno	=	"87051"	then
		g_szAcno	=	getListItem(szInput,1)
		'g_szAsno	=	getListItem(szInput,2) 'v006
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"
		
		if g_szSvcd = "082" then
			g_szAsno	=	getListItem(szInput,2)
			g_szDiv	=	"17190"
		elseif g_szSvcd = "083" then
			g_szAsno	=	""
			g_szDiv	=	"17192"
		end if
	
	'2023.05.23  해외주식/ETP 거래신청--------------------------------------------------- 
	'mbonl87057_p1.xmf 87057_1★ACNO★ASNO★PWD★083 해외주식 거래신청
	'mbonl87057_p1.xmf 87057_2★ACNO★ASNO★PWD★083 해외주식 거래, 해외ETP 거래신청
	'mbonl87057_p1.xmf 87057_3★ACNO★ASNO★PWD★082 해외ETP 거래신청		
	elseif g_szScrno = "87057_1" or  g_szScrno = "87057_2" or g_szScrno = "87057_3" then
		g_szAcno	=	getListItem(szInput,1)
		'g_szAsno	=	getListItem(szInput,2) 'v006
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"
		
		if g_szSvcd = "082" then
			g_szAsno	=	getListItem(szInput,2)
			g_szDiv	=	"17190"
		elseif g_szSvcd = "083" then
			g_szAsno	=	""
			g_szDiv	=	"17192"
		end if
	'------------------------------------------------------------------------------------
	'v018 해외주식 소수점 거래
	'mbonl87056.xmf 87052_1★ACNO★ASNO★PWD★086 해외주식 소수점 신청
	'mbonl87056.xmf 87052_2★ACNO★ASNO★PWD★086 해외주식 소수점, 해외ETP 거래신청
	'mbonl87056.xmf 87052_3★ACNO★ASNO★PWD★086 해외주식 거래, 해외주식 소수점 거래,해외ETP 거래신청
	'mbonl87056.xmf 87052_4★ACNO★ASNO★PWD★086 해외주식 거래, 해외주식 소수점 거래
	'v022
	'elseif	g_szScrno = "87052_1" or g_szScrno = "87052_2" or g_szScrno	= "87052_3" or g_szScrno = "87052_4"	then
	'	g_szAcno	=	getListItem(szInput,1)
	'	g_szPasswd =	getListItem(szInput,3)
	'	g_szSvcd =	getListItem(szInput,4)
	'	g_szBswr	=	"02"
		
	'	if g_szSvcd = "079" then
	'		g_szAsno	=	getListItem(szInput,2)
	'		g_szDiv	=	"17213"
	'	end if
	elseif	g_szScrno = "87052_2" then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"
		
		if g_szSvcd = "083" then
			g_szAsno	=	getListItem(szInput,2)
			g_szDiv	=	"17192"
		end if
		
	elseif g_szScrno = "87052_4" then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"
		
		if g_szSvcd = "082" then
			g_szAsno	=	getListItem(szInput,2)
			g_szDiv	=	"17190"
		end if
		
     elseif g_szScrno = "87052_3" then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"

		if g_szSvcd = "083" then
			g_szAsno	=	getListItem(szInput,2)
			g_szDiv	=	"17192"
		end if
		
	'v007 변동성ETN거래신청
	'화면번호★ACNO★PASSWD
	'88021★ACNO★PASSWD
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl88021.xmf	88021★ACNO★PWD		변동성ETN거래신청
	elseif	g_szScrno	=	"88021"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,2)
	
		g_szBswr	=	"02"
		g_szDiv	=	"17194"

	'v016 K-OTC 거래신청
	'화면번호★ACNO★PASSWD	
	'88050★ACNO★PASSWD	
	'v009 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	'mbonl88050.xmf	88050★ACNO★PWD		K-OTC 거래신청
	elseif	g_szScrno	=	"88050"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szPasswd =	getListItem(szInput,2)
		
		g_szBswr	=	"02"
		g_szDiv	=	"17148"
	'v020 Wrap계좌전환
	'화면번호★ACNO★ASNO★PASSWD	
	elseif	g_szScrno	=	"57090"	then 
		g_szAcno	=	getListItem(szInput,1)
		g_szAsno	=	getListItem(szInput,2)
		g_szPasswd =	getListItem(szInput,3)
		
		g_szBswr	=	"03"
		g_szDiv	=	"01020"
		
	'v021
	elseif	g_szScrno	=	"89030"	then
		g_szAcno	=	getListItem(szInput,1)
		g_szAsno	=	getListItem(szInput,2) 
		g_szPasswd =	getListItem(szInput,3)
		g_szSvcd =	getListItem(szInput,4)
		g_szBswr	=	"02"
		
		if g_szSvcd = "06" then			
			g_szDiv	=	"17226"	'06:RP형 - 17226 CMA계좌전환(RP)
		elseif g_szSvcd = "08" then		
			g_szDiv	=	"17227"  '08:MMW형 - 17227 CMA계좌전환(MMW)
		elseif g_szSvcd = "09" then	
			g_szDiv	=	"17228"  '09:발행어음형 - 17228 CMA계좌전환(발행어음)
		end if		
	'KEK.투자성향 공통팝업 테스트_20240111
	elseif	g_szScrno	=	"90201"	then
		g_szAcno	=	getListItem(szInput,2)
		g_szAsno	=	getListItem(szInput,3)
		g_szIscd	=	getListItem(szInput,4)
		
		g_szBswr	=	"01"
		g_szDiv	=	"13005"
	'KEK.투자성향 공통팝업 테스트_20240111
	'v025
	elseif	g_szScrno	=	"51020"	then
		g_szBswr	=	"01"
		g_szAcno	=	getListItem(szInput,2)
		g_szAsno	=	getListItem(szInput,3)
		g_szIscd	=	getListItem(szInput,4)
		
		g_szDiv	=	"17058" '자동이체약정
		
	
	end if
End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 

end function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	dim szLinkedData
	Form.SendReturnToParent("KYCCHK_RETURN" , "N")

	'v009 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	szLinkedData = Form.GetOpenLinkData( )

	if len(szLinkedData) <= 6 then
		Form.ShowAlert("안내", "입력값이 없습니다.")
	else
		setItemSetting(szLinkedData)
		
		if	g_szScrno <> null		and		len(trim(g_szScrno))  > 4 	then
		
			'KEK.투자성향 공통팝업 테스트_20240111 ( g_szScrno = "90201"추가)
			if	g_szScrno	=	"53000"	or	g_szScrno	=	"90201"	then					'ELS 일때 791r로 투자자금 원금보존확인
				DATAMANAGER.RequestTranData("obcsb_acif_791r")
			
			'21.08.17 JHY START (v013)
			'펀드 매매일때, 전문금융투자자여부 먼저 알기 위해 005r -> 721r (-> 신규매수일시 791r) -> 700r
			'v025추가
			elseif	g_szScrno	="51000" or g_szScrno	="51020" then
				DATAMANAGER.RequestTranData("obacp_comm_005r")	
			'21.08.17 JHY END (v013)
			
			elseif	g_szScrno	=	"84010"			then				'개설시엔 무조건 설문
			    'v009 g_szPasswd값 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
				Form.OpenPopup("mbonl81010_s2" , g_szAcno & "★" &  g_szPasswd, sPosInfo)
			elseif	g_szScrno	=	"57090"			then				'v020 Wrap계좌전환
				DATAMANAGER.RequestTranData("obcsb_acif_713r") ' 당일투자성향 존재여부 확인
			else
				DATAMANAGER.RequestTranData("obcsb_acif_700r")			'온라인계좌개설이 아니면 투자성향등급조회를 통한 루트
			end	if
		end	if
	end if 

	
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"obcsb_acif_700r"	then				'투자성향등급조회
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ACNO"				, 0, g_szAcno)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ASNO"				, 0, g_szAsno)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "KYC_BSWR_DIV_CODE"	, 0, g_szBswr)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "BSWR_DIV_CODE"		, 0, g_szDiv)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ISCD"				, 0, g_szIscd)
	elseif	szTranID	=	"obcsb_acif_713r"	then			'투자성향등급정보체크
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "ACNO"				, 0, g_szAcno)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "ASNO"				, 0, g_szAsno)
		'v015 DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DOMN_CLCD"		, 0, "02")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DOMN_CLCD"		, 0, "01") 'v015 공통모듈을 타도록 
		'v014 실제 개설되는 상품으로 매핑
		'DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "PRCD"				, 0, "100")
		If g_szOPNG_PRCD = "100" Or g_szOPNG_PRCD = "10F" Then
		    DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "PRCD"			, 0, "100")
		ElseIf g_szOPNG_PRCD = "118" Then
		    DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "PRCD"			, 0, "118")
		    DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "ISSU_TYPE_CODE"   , 0, "06"  )  '06.RP - 온라인CMA개설은 RP만 가능
		End If
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "KYC_BSWR_DIV_CODE"	, 0, g_szBswr)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DIV_CODE"		, 0, g_szDiv)
	elseif	szTranID	=	"obcsb_acif_791r"	then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_791r", "InBlock1", "ACNO"				, 0, g_szAcno)
	elseif	szTranID	=	"obcsb_acif_762r"	then '  v003 자가진단시행 필요여부 조회
		DATAMANAGER.SetDataValue(0, "obcsb_acif_762r", "InBlock1", "ACNO"				, 0, g_szAcno) '계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_acif_762r", "InBlock1", "ISSU_TYPE_CODE"		, 0, "08"    ) '종목유형코드
		DATAMANAGER.SetDataValue(0, "obcsb_acif_762r", "InBlock1", "ISCD"				, 0, g_szIscd) '종목코드
	
	'21.08.13 JHY START (v013)
	'전문투자자 정보 조회 (목표시장 설문 팝업 1번 자동 세팅)
	elseif	szTranID	=	"obacp_comm_005r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0, "1") '조회구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0, g_szAcno) '계좌번호
	
	elseif	szTranID	=	"obcsb_acif_721r"	then
		Dim szJumin
		szJumin = Form.GetSharedData("&JUMIN_NUM", false )

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP" , 0, szJumin) '실명번호PIP
		
	'21.08.13 JHY END (v013)
	
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'v011 dim	szProsYN		'700r 리턴값
	
	'---------------------------------------------------------------------------------------------------------------------
	'A:투자성향진단필요				-->해당관련 서브 팝업실행후 재진단 정상여부에따라분기	--> Y: 다시서비스호출
	'B:투자성향진단필요(유효)															--> N: "N"리턴
	'M:취약금융소비자 정보없음
	'P:투자성향진단필요(파생)
	'C:원금보존 투자자금 정보없음
	
	'D:원금보존 투자자금 가입불가 상품	-->해당관련 팝업실행후								--> "N"리턴					
	'S:취약자가입불가
	'T:고령자최초가입자가입불가
	'U:초고령자온라인파생가입불가
	'V:고령자 당일 파생신청
	
	'N:정상																			--> "Y"리턴
	'X:전문투자자
	
	'Y:비적합동의필요				-->해당관련 서브 팝업실행후 재진단 정상여부에따라 분기		--> Y: "Y"리턴
	'																				--> N: "N"리턴
	'E:고령자투자보호안내																--> N: "N"리턴 (16.03.29 김인택과장님)
	'---------------------------------------------------------------------------------------------------------------------
	'---------------------------------------------------------------------------------------------------------------------
	'종합매매계좌 개설시 (프로세스 추가, 16.03.10 김인택과장님)
	'N:정상, X:전문투자자	--> obcsb_acif_713r 호출		--> S : 취약금융소비자 투자보호
	'												--> Y : 비적합처리
	'												--> N : 정상처리
	'---------------------------------------------------------------------------------------------------------------------
	
	if	szTranID	=	"obcsb_acif_700r"	then
	     g_szProcTc = "1"
		szProsYN	=	""
		g_szKYC_INVT_INCL_GRAD_CODE= "" 'KYC투자성향등급코드
		g_szKYC_PROD_GRAD_CODE	= "" 'KYC상품등급코드
		g_szKYC_DVPD_EPMD_CODE	= "" 'KYC파생상품유의코드
		g_szKYC_DRVT_PROS_YN 	= "" 'KYC파생처리여부
		g_szDVPD_GRAD_CODE	= "" '파생상품등급코드
		g_szCAFU_TRGT_YN		= "" '숙려대상여부 v010
		g_szGOAL_MRKT_TRGT_YN 	= "" '목표시장대상여부 v010
		g_szGOAL_MRKT_UNFIT_YN = "" '목표시장부적합여부 v010
		
		
		
		szProsYN	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "PROS_YN", 0)
		g_szKYC_INVT_INCL_GRAD_CODE	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		g_szKYC_PROD_GRAD_CODE		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_PROD_GRAD_CODE", 0)
		g_szKYC_DVPD_EPMD_CODE		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_DVPD_EPMD_CODE", 0)
		g_szKYC_DRVT_PROS_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_DRVT_PROS_YN", 0)
		g_szDVPD_GRAD_CODE		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "DVPD_GRAD_CODE", 0)
		g_szCAFU_TRGT_YN			=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "CAFU_TRGT_YN", 0) 'v010 숙려대상
		g_szGOAL_MRKT_TRGT_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "GOAL_MRKT_TRGT_YN", 0) 'v010 목표시장대상여부
		g_szGOAL_MRKT_UNFIT_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "GOAL_MRKT_UNFIT_YN", 0) 'v010 목표시장부적합여부
