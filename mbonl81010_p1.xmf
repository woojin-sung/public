	'21.08.13 JHY START (v013)
	'전문투자자 정보 조회 (목표시장 설문 팝업 1번 자동 세팅)
	elseif szTranID = "obacp_comm_005r" Then
		g_szCustCode 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CUST_CLS_CODE" , 0) '고객구분코드

		DATAMANAGER.RequestTranData("obcsb_acif_721r")
	
	elseif	szTranID	=	"obcsb_acif_721r"	then
		Dim szPfinYn, szPfinCls, szSpclFncmType, szStartDate, szFinalDate, szCancelDate, szToday
		
		szPfinYn = "N"
		
		szPfinCls		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PFIN_CLS_CODE" , 0)) '전문투자자구분코드
		szSpclFncmType	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SPCL_FNCM_TYPE_CODE" , 0)) '전문금융소비자유형코드
		szStartDate		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PFIN_VLDT_STA_DATE" , 0)) '효력시작일자
		szFinalDate		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PFIN_VLDT_FIN_DATE" , 0)) '효력종료일자		
		szCancelDate		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CANC_DATE" , 0)) '해지일자	
		
		szToday = Trim(Form.GetSharedData( "&HOST_DATE" , false ))
 
		if szSpclFncmType == "01" or szSpclFncmType == "02" or szSpclFncmType == "03" then
			if szPfinCls = "1" then
				szPfinYn = "Y"
			else
				if tonumber(szStartDate) <> NULL and tonumber(szFinalDate) <> NULL then
					if tonumber(szStartDate) <=  tonumber(szToday) and tonumber(szToday) <=  tonumber(szFinalDate) then
						szPfinYn = "Y"
					end if
				end if
			end if
		end if
		
		'목표시장 오픈 할지 말지 여부 ( 1인 경우는 당연이라 설문 안해도 유형이라 전문금융소비자여부랑 팝업여는 여부 다름.)
		'위 조건문과 합치려다가 szSpclFncmType 조건에서 차이날 수도 있을꺼같아 아래에 따로
		if tonumber(szStartDate) <> NULL and tonumber(szFinalDate) <> NULL and g_szScrno	<> "51020"then
			if szPfinCls <> "1" and szCancelDate == "30000101" and tonumber(szStartDate) <=  tonumber(szToday) and tonumber(szToday) <=  tonumber(szFinalDate) then
				g_isOpenPopup = true
			end if
		end if
		
'		
		'설문지 고객유형 자동설정(2.개인전문투자자->4.당연->3.전환가능->1.일반 순으로 체크)
		Dim szCusType
		szCusType = "1"
		
		if g_szCustCode == "1" and szPfinYn == "Y" then
			szCusType = "2"
		
		else
			if szPfinYn == "Y" then
				if szPfinCls == "1" then
					szCusType = "4"
				else
					szCusType = "3"
				end if
			else
				szCusType = "1"
			end if
		end if
		
		Form.SetSharedData("obcsb_acif_831r_HGDT_TYPE" , "02")
		Form.SetSharedData("obcsb_acif_831r_ISCD" , g_szIscd)
		Form.SetSharedData("obcsb_acif_831r_SALE_CLS_CODE" , "2")
		Form.SetSharedData("obcsb_acif_831r_INFO_CLS_CODE" , "1")
		Form.SetSharedData("obcsb_acif_721r_CLS_CODE" , szPfinCls)
		Form.SetSharedData("obcsb_acif_721r_STA_DATE" , szStartDate)
		Form.SetSharedData("obcsb_acif_721r_FIN_DATE" , szFinalDate)
		Form.SetSharedData("obcsb_acif_831r_CUST_TYPE" , szCusType)
		
		'펀드매매(신규가입)일때 791r로 투자자금 원금보존확인
		if g_szDiv == "01010"	then
			DATAMANAGER.RequestTranData("obcsb_acif_791r")
			
		'추가매수일때	
		'v025 17058 자동이체약정
		elseif g_szDiv == "13005" or g_szDiv == "17058"  then
			DATAMANAGER.RequestTranData("obcsb_acif_700r")
		end if
	'21.08.13 JHY END (v013)
	
	end	if
	
	
End Sub


'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	'v009 g_szPasswd값 주의! g_plain_rm=="1" 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘어옴
	
	if sKeyName = "PROSYN_A" then						'KYC 정보없음
		if sRet = "ok" then							'예
			Form.OpenPopup("mbonl81010_s2" , g_szAcno & "★" &  g_szPasswd, sPosInfo)
		else 									'아니오
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
		
	elseif sKeyName = "PROSYN_B" then					'KYC유효기간 초과
		if sRet = "ok" then							'예
			Form.OpenPopup("mbonl81010_s2" , g_szAcno & "★" &  g_szPasswd , sPosInfo)
		else 									'아니오
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
		
	elseif sKeyName = "PROSYN_M" then					'취약금융정보없음
		if sRet = "ok" then							'예
			Form.OpenPopup("mbonl81010_s2" , g_szAcno & "★" &  g_szPasswd , sPosInfo)
		else 									'아니오
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
	
	elseif sKeyName = "PROSYN_P" Then
		if sRet = "ok" then
			Form.OpenPopup("mbonl81010_s2" , g_szAcno & "★" &  g_szPasswd , sPosInfo)
		Else
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		End If
	elseif sKeyName = "PROSYN_1" then					'정보미제공가입제한 '21.08.24 JHY SATRT : PROS_YN 1인 경우 추가
		'Form.CloseForm()
		Form.OpenPopup("mbonl81010_s2" , g_szAcno & "★" &  g_szPasswd , sPosInfo)

				
	elseif sKeyName = "PROSYN_C" then					'투자자금원금보존 확인		
		if sRet = "ok" then							'예
			'v017 sta 다른 화면에 영향있을지도 모르니 펀드매매 > 신규매수로 조건
			if g_szDiv == "01010"	then
				Dim szFNPR_JOIN_SRNO
				szFNPR_JOIN_SRNO = Form.GetSharedData( "MBFNP51010_T1_FNPRJOINSRNO", false )
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_SRNO", 0, szFNPR_JOIN_SRNO)
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")
			End If
			'v017 end 
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ACNO", 0, g_szAcno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ASNO", 0, g_szAsno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN" , 0, "Y")
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "MOD_REAS_RMRK", 0, "")
			
			DATAMANAGER.RequestTranData("obcsb_acif_792a")
		elseif sRet = "no" then						'아니오
			'v017 sta 다른 화면에 영향있을지도 모르니 펀드매매 > 신규매수로 조건
			if g_szDiv == "01010"	then
				Dim szFNPR_JOIN_SRNO
				szFNPR_JOIN_SRNO = Form.GetSharedData( "MBFNP51010_T1_FNPRJOINSRNO", false )
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_SRNO", 0, szFNPR_JOIN_SRNO)
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")
			End If
			'v017 end 
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ACNO", 0, g_szAcno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ASNO", 0, g_szAsno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN", 0, "N")
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "MOD_REAS_RMRK", 0, "")
			
			DATAMANAGER.RequestTranData("obcsb_acif_792a")
		else	
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
			
	elseif sKeyName = "PROSYN_D" then					'원금보존위험상품안내
		'상품가입 불가
		if g_szDiv == "01010"	then
			Form.OpenScreen("51000" , "")
			Form.CloseForm()
			Exit Sub
		end if
	
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
		
	elseif sKeyName = "PROSYN_S" then					'취약금융소비자투자보호안내
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
		
	elseif sKeyName = "PROSYN_T" then					'고령자 투자보호안내 1
		
		if sRet = "ok" then							'확인
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "ACNO", 0, g_szAcno )			'계좌번호
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CNSH_CLS_CODE", 0 , "07" )		'확인서구분코드
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "Y" )		'고객확인여부
			DATAMANAGER.RequestTranData("obcsb_acif_715a")
		else
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")	'취소 와 MsgBoxClose
			Form.CloseForm()
		end if
		
	elseif sKeyName = "PROSYN_T2" then					'고령자 투자보호안내 2
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
		
	elseif sKeyName = "PROSYN_U" then					'초고령자온라인파생가입불가
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
		
	elseif sKeyName = "PROSYN_V" then					'고령자 당일 파생신청 투자숙려안내
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
		
	elseif sKeyName = "PROSYN_E" then					'고령자투자보호안내
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif sKeyName = "PROSYN_F" then					'v003 자가진단표 문제풀이
		if sRet = "ok" then '파생경험 있음
			Form.OpenPopup("mbonl81010_p7" , g_szAcno &"★"&g_szAsno&"★"&g_szIscd&"★"&"Y"&"★"&"N", "N")
		else  '파생경험 없음
			Form.OpenPopup("mbonl81010_p6" , g_szAcno &"★"&g_szAsno&"★"&g_szIscd&"★"&"N", "N")
		end if
	end if 
	
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'Form.ShowAlert( "Form_OnPopupReturn", "["..sKeyName.."]["..sRet.."]" )
	if	sKeyName = "mbonl81010_s2"	then							'투자성향설문체크
	
		if	sRet = "OK"		then									'투자성향등록완료
		
			if	g_szScrno	=	"84010"	then						'계좌개설이고 
			
				'v014 : 투자권유 희망여부 확인서 추가(5등급 상품개설)
				'if	g_szKspKdq =		"1"	then						'유가증권 코스닥 매매함
				
				'Form.ShowAlert("테스트",  g_szOPNG_PRCD)
				
				If g_szOPNG_PRCD = "100" Or g_szOPNG_PRCD = "10F" Or g_szOPNG_PRCD = "118" Then
					DATAMANAGER.RequestTranData("obcsb_acif_713r")
				else
					Form.SendReturnToParent("KYCCHK_RETURN" , "Y")	'등록처리후 결과 Y 리턴
					Form.CloseForm()
				end	if
				
			else
				DATAMANAGER.RequestTranData("obcsb_acif_700r")		'투자성향 PROS_YN 변경에 따라 재판단함.
			end	if
			
		else														'투자성향등록취소
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
	elseif	sKeyName = "mbonl81010_p2"		then						'고위험거래확인팝업

		if	sRet	=	"CANCEL"	then		'취소버튼
			'v003
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		elseif sRet	=	"OK"	then		'확인버튼
			'v025 자동이체약정 추가
			if g_szScrno = "51000" or  g_szScrno = "51020" then		
				if g_szDiv = "13005" then
					Form.SetSharedData("FUND_PAGE_SET"	, "51040")	'mbonl81010_p24 에서 가입중단시 51040으로 이동
				'v025
				elseif g_szScrno = "51020" then
					Form.SetSharedData("FUND_PAGE_SET"	, "51020")	'mbonl81010_p24 에서 가입중단시 51020으로 이동
				else 
					Form.SetSharedData("FUND_PAGE_SET"	, "51000")	'mbonl81010_p24 에서 가입중단시 51000으로 이동
				end if
				
				Form.OpenPopup("mbonl81010_p24", g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
												 g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
												 g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
												 g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
							, sPosInfo)		
			elseif g_szScrno = "82010" then	
				Form.OpenPopup("mbonl81010_p24", g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
												 g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
												 g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
												 g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
							, sPosInfo)	
			'KEK.투자성향 공통팝업 테스트_20240111 (90201 추가)
			elseif g_szScrno = "90201"   Then
				Form.SetSharedData("FUND_PAGE_SET"	, "90000")	'mbonl81010_p24 에서 가입중단시 90000으로 이동
				
				Form.OpenPopup("mbonl81010_p24", g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
												 g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
												 g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
												 g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
							, sPosInfo)	
			'KEK.투자성향 공통팝업 테스트_20240111 (90201 추가)
			
			else		
				'21.08.26 JHY 변경 : 박미선 대리님 요청으로 해당 팝업 타이틀 중간에 짤리지 않게 타이틀 생성했으므로 openpopup으로 변경
				Form.OpenPopup("mbonl81010_p3" , g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
												 g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
												 g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
												 g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
							, sPosInfo)	
				'Form.CloseForm()
			end if
		end if
	elseif	sKeyName = "mbonl81010_p3"	or sKeyName = "mbonl81010_p24"	then						'고위험거래가입팝업

		if	sRet	=	"CANCEL"	then		'취소버튼
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		elseif sRet	=	"OK"	then		'확인버튼

'		        '[v019] 22.07.22 임동군 수정
'		        ' 펀드신규의 경우 부적정금융투자상품 확인서 '확인' 후 인증서를 띄운다(고객서명 확인)
'                        IF  g_szDiv == "01010"  THEN
			If g_szScrno = "51000" or g_szScrno = "51020" then				'23.06.27 추가매수 추가 / v001 자동이체약정추가
				Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)
			ELSE
'				IF g_szAPRT_SRNM_PROD_YN = "Y" and g_szDiv <> "17192" THEN '적정성대상상품이라면
				IF g_szAPRT_SRNM_PROD_YN = "Y" THEN '적정성대상상품이라면
					Form.OpenFramePopup("mbonl81010_p11" , g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
                                                              g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
                                                              g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
                                                              g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
								, sPosInfo)	
				ELSE
					IF g_szDiv  =  "15008"  THEN
						SelfDigPross()
					ELSE
						CHECK_GOAL_MRKT_TRGT()
					END IF
				END IF
			END IF

			'v011
			'Form.ShowAlert("테스트", g_szAPRT_SRNM_PROD_YN) 
			'[v019] 22.07.22 임동군 ( ..) 주석처리 start
			'----------------------------------------------------------------------------------
			'if g_szAPRT_SRNM_PROD_YN = "Y" then '적정성대상상품이라면
			'	Form.OpenFramePopup("mbonl81010_p11" , g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
			'									 g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
			'									 g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
			'									 g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
			'					, sPosInfo)	
			'else
			'	if g_szDiv	=	"15008" then
			'		SelfDigPross()
			'	else
			'		'21.08.17 JHY START (v013)
			'		 CHECK_GOAL_MRKT_TRGT()
			'		'21.08.17 JHY END (v013)
			'	end if
			'end if
			'----------------------------------------------------------------------------------
			'[v019] 22.07.22 임동군 ('' ) 주석처리 end

		end if
	elseif	sKeyName = "mbonl81010_p7"		then	 ' v003 자가진단문제 해석팝업
		if	sRet	=	"OK"	then		'확인버튼
			Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
		elseif	sRet	=	"CANCEL"	then
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		end if
		Form.CloseForm()
	elseif	sKeyName = "mbonl81010_p6"	then 'v003 자가진단문제 풀이팝업
		if	sRet	=	"OK"	then ' 계좌번호★계좌일련번호★종목코드★파생경험★문제풀이여부
			Form.OpenPopup("mbonl81010_p7" , g_szAcno &"★"&g_szAsno&"★"&g_szIscd&"★"&"N"&"★"&"Y", "N")
		elseif sRet	=	"CANCEL"	then
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
	elseif	sKeyName = "mbonl81010_p10" or sKeyName = "mbonl81010_p23"	then 'v011 투자권유 희망여부 확인서
		if	sRet	=	"OK"	then 
		     if g_szProcTc = "1" then
				Call KYC_CHECK_PROD()
			elseif g_szProcTc = "2" then
				Call KYC_CHECK_AC()
			end if
		elseif sRet	=	"CANCEL"	then
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if	
	elseif	sKeyName = "mbonl81010_p11"	then 'v011 적정성판단보고서
		if	sRet	=	"OK"	then 
			if g_szDiv	=	"15008" then
				SelfDigPross()
			else
				'21.08.17 JHY START (v013)
				 CHECK_GOAL_MRKT_TRGT()
				'21.08.17 JHY END (v013)
			end if
		elseif sRet	=	"CANCEL"	then
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if	
		
	elseif sKeyName == "close_mbfnp51010_p12" then
		if	sRet	=	"OK"	then		'확인버튼
			Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
		elseif	sRet	=	"CANCEL"	then
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		end if
		
		Form.CloseForm()
		
	'21.08.26 JHY START(v013)
	elseif sKeyName == "close_mbfnp51010_p13" then
		if	sRet	=	"OK"	then		'확인버튼
			Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
		elseif	sRet	=	"CANCEL"	then
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		end if
		
		Form.CloseForm()
	'21.08.26 JHY END(v013)
	' [v019] 22.07.22 임동군 추가
	' 인증서 정상리턴 처리 추가.
	' 부적정 투자상품 확인서 '확인'시 로직과 동일하게 넣음
	elseif	sKeyName	==	"mhetc90060_p5"	then	

		IF    sRet    <>    "cancel"    THEN
		    IF    g_szAPRT_SRNM_PROD_YN  =  "Y"  THEN '적정성대상상품이라면
				Form.OpenFramePopup("mbonl81010_p11" , g_szScrno	& "★" & g_szAcno	& "★" & g_szAsno & "★" &
												 g_szBswr	& "★" & g_szDiv	& "★" & g_szISCD & "★" &
												 g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE & "★" &
												 g_szKYC_DVPD_EPMD_CODE		& "★" & g_szKYC_DRVT_PROS_YN 	& "★" & g_szDVPD_GRAD_CODE
								, sPosInfo)
			ELSE

				IF  g_szDiv  =  "15008"  THEN
					SelfDigPross()
				ELSEIF g_szScrno = "51020" THEN 
					'v001 자동이체약정은 목표시장체크 X
					Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
					Form.CloseForm()
				ELSE
					 CHECK_GOAL_MRKT_TRGT()
				END IF
			END IF
		ELSE

			
             ' 취소를 하였거나 X 표시 눌렀을때는 KYC체크폼을 닫는다.
		    ' 하지 않으면 신규매수 화면에 락이걸린다.		    
		    Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		    Form.CloseForm()

		END IF
		
	elseif	sKeyName	==	"mbonl81010_p22_agree"	then
		if sRet == "Y" then
			'상품가입 불가
			if g_szDiv == "01010"	then
				Dim szFNPR_JOIN_SRNO
				szFNPR_JOIN_SRNO = Form.GetSharedData( "MBFNP51010_T1_FNPRJOINSRNO", false )
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_SRNO", 0, szFNPR_JOIN_SRNO)
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")
			End If
			'v017 end 
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ACNO", 0, g_szAcno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ASNO", 0, g_szAsno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN" , 0, "Y")
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "MOD_REAS_RMRK", 0, "")
			
			DATAMANAGER.RequestTranData("obcsb_acif_792a")		
		elseif sRet == "N" then
			'v017 sta 다른 화면에 영향있을지도 모르니 펀드매매 > 신규매수로 조건
			if g_szDiv == "01010"	then
				Dim szFNPR_JOIN_SRNO
				szFNPR_JOIN_SRNO = Form.GetSharedData( "MBFNP51010_T1_FNPRJOINSRNO", false )
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_SRNO", 0, szFNPR_JOIN_SRNO)
				DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")
			End If
			'v017 end 
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ACNO", 0, g_szAcno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ASNO", 0, g_szAsno)
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN", 0, "N")
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "MOD_REAS_RMRK", 0, "")
			
			DATAMANAGER.RequestTranData("obcsb_acif_792a")
		else	
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if
		
	elseif sKeyName == "errMsgBox"  Then 
		if sRet = "Right" then				
			'투자성향재진단 화면 연결
			Form.OpenFramePopup("mbonl81010" , "" , "")
		else
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		end if	
	end if
End Sub




'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'21.08.23 JHY START : 721r 에서 일반투자자인 경우 여기로 에러 들어와 다음 진행 안되므로 이 경우에는 뒤에 로직 탈 수 있도록
	if szTranID == "obcsb_acif_721r" and szErrCode == "5820"  then	
		'펀드매매(신규가입)일때 791r로 투자자금 원금보존확인
		if g_szDiv == "01010"	then
			DATAMANAGER.RequestTranData("obcsb_acif_791r")
			
		'추가매수일때	
		'v025. 자동이체약정
		elseif g_szDiv == "13005" or g_szDiv == "17058" then
			DATAMANAGER.RequestTranData("obcsb_acif_700r")
		end if
		
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
		
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	end if
	'21.08.23 JHY END
End Sub


'============================================================================
'v003 자가진단 프로세스
'============================================================================
Function SelfDigPross()
	DATAMANAGER.RequestTranData("obcsb_acif_762r") ' 자가진단표 수행 대상여부 확인
End Function

'============================================================================
' 21.08.17 JHY 추가
' CHECK_GOAL_MRKT_TRGT() : 목표시장 체크 팝업
'============================================================================
Function CHECK_GOAL_MRKT_TRGT()

	if g_szGOAL_MRKT_TRGT_YN == "Y" then
		if g_isOpenPopup == true then
			Form.OpenPopupAnimation("mbfnp51010_p12", g_szAcno & "★" & g_szAsno, "","2") '목표시장 비교 설문 팝업
			
		else
			'21.08.26 JHY START : 다른 화면에 영향이 있을 수도 있어, 신규인 경우만 있던것에 추가 매수 넣고, 밑에 닫는 부분은 그대로 유지
			if g_szDiv	==	"01010" or g_szDiv	== "13005" then
				Form.OpenPopup("mbfnp51010_p13" , g_szGOAL_MRKT_UNFIT_YN , "")
								
			else
				Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
				Form.CloseForm()
			end if
		end if
	else
		Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
		Form.CloseForm()
	end if
End Function

'============================================================================
'v011 투자성향 비교 프로세스
'============================================================================
Sub KYC_CHECK_PROD()
	
	if	szProsYN	=	"N"	or	szProsYN	=	"X"	then			'정상, 전문투자자	
		'v003
		if g_szDiv	=	"15008" then
			SelfDigPross()
		else
			'21.08.17 JHY START (v013)
			CHECK_GOAL_MRKT_TRGT()
			'21.08.17 JHY END (v013)
		end if
		
	elseif	szProsYN	=	"A"	then
		Form.MsgBox("고객투자성향등급 확인안내", "고객님의 투자성향등급 정보가 없습니다. 해당 정보가 없으면 상품가입이 불가합니다. 투자성향등급을 확인하고 상품에 가입하시겠습니까?", "PROSYN_A", "1")
	
	elseif	szProsYN	=	"B"	then
		Form.MsgBox("고객투자성향등급 재확인안내", "고객님의 투자성향등급이 정보미제공 또는 기간 만료되어 재확인하셔야 합니다.", "PROSYN_B", "1")
	
	elseif	szProsYN	=	"M"	then
		Form.MsgBox("고객투자성향등급 취약금융소비자 투자보호 안내", "고객님의 취약금융소비자 정보가 없습니다. 해당 정보가 없으면 상품가입이 불가합니다. 투자성향등급을 확인하고 상품에 가입하시겠습니까?", "PROSYN_M", "1")
	
	elseif	szProsYN	=	"P"	then		'
		Form.MsgBox("안내", "투자자 정보가 제공되어야 \n가입하실 수 있습니다.\n투자성향진단 후 신청해주세요.\n(투자자정보 [제공]선택 필수)", "PROSYN_P", 7, "투자성향 진단", "취소")
		
	elseif	szProsYN	=	"C"	then
		Form.MsgBox("투자자금 원금보존 확인" , "이번에 투자되는 자금이 단기간내 사용처가 정해져 있는등( 예: 6개월 이내에 전세자금으로 활용될 자금)의 이유로 원금 보존을 추구하는 자금입니까?", "PROSYN_C", "2")
	
	' v024
	' 문구수정 1~3등급 -> 1~4등급
	elseif	szProsYN	=	"D"	then
		Form.MsgBox("원금보존 위험 상품 안내" , "고객님은 금융투자자금 원금보존을 선택하였습니다. 투자자보호를 위해 파생상품 및 위험등급 1~4등급 상품가입이 제한됩니다.", "PROSYN_D", "6")

	elseif	szProsYN	=	"S"	then
		Form.MsgBox("취약금융소비자 투자보호 안내" , "고객님은 취약금융소비자입니다. 투자자보호를 위해 투자성향보다 위험등급이 한단계를 초과한 상품가입이 불가합니다.", "PROSYN_S", "6")

	elseif	szProsYN	=	"T"	then
		Form.MsgBox("고령자 투자보호 안내" , "고객님은 파생상품 관련 투자경험이 없는 고령자(만 65세 이상)입니다. 투자성향등급을 재확인하고 파생상품 신청을 하시겠습니까?", "PROSYN_T", "1")

	elseif	szProsYN	=	"U"	then
		Form.MsgBox("초고령자 투자보호 안내" , "초고령자(만 80세 이상) 고객님께서는 파생상품 온라인 가입이 제한됩니다.", "PROSYN_U", "6")

	elseif	szProsYN	=	"V"	then
		Form.MsgBox("고령자 투자보호 안내" , "고객님은 파생상품관련 투자경험이 없는 고령자(만 65세 이상)입니다. 투자숙려제도에 따라서 익영업일부터는 5일 이내에 가입이 가능합니다. 단, 초고령자(만 80세 이상)고객님께서는 파생상품 온라인 가입이 제한됩니다.", "PROSYN_V", "6")
	elseif	szProsYN	=	"Y"	then
		'v008 sta
		if g_szDiv = "13005" then
		
			'KEK.투자성향 공통팝업 테스트_20240111 51000 / 90201 분기추가
			if	g_szScrno	=	"51000"	then
				'본인계좌 아니며 비적합대상의 경우 추매 불가
				if g_szSelfacctyn = "N" then
					Form.ShowAlert("확인", "위임인의 투자성향이 투자권유 미희망이거나, 해당 상품의 투자에 부적합(부적정)하여 매수가 불가능합니다.")
					Form.CloseForm( )
					Exit Sub
				else
					Form.SetSharedData("FUND_PAGE_SET"	, "51040")	'mbonl81010_p2 에서 가입중단시 51040으로 이동
			
					'펀드추가매수시(MY자산현황 포함)
					Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
													g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE	& "★" &
													g_szKYC_DVPD_EPMD_CODE 	& "★" & g_szKYC_DRVT_PROS_YN	& "★" & g_szDVPD_GRAD_CODE
									, sPosInfo)
				end if
			'v025 자동이체약정
			elseif g_szScrno = "51020" then
				Form.SetSharedData("FUND_PAGE_SET"	, "51020")	'mbonl81010_p2 에서 가입중단시 51020으로 이동
			
				'펀드자동이체약정
				Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
												g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE	& "★" &
												g_szKYC_DVPD_EPMD_CODE 	& "★" & g_szKYC_DRVT_PROS_YN	& "★" & g_szDVPD_GRAD_CODE
								, sPosInfo)
			
			else
				Form.SetSharedData("FUND_PAGE_SET"	, "90201")	'mbonl81010_p2 에서 가입중단시 51040으로 이동
		
				'펀드추가매수시(MY자산현황 포함)
				Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
												g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE	& "★" &
												g_szKYC_DVPD_EPMD_CODE 	& "★" & g_szKYC_DRVT_PROS_YN	& "★" & g_szDVPD_GRAD_CODE
								, sPosInfo)	
			end If 
			'KEK.투자성향 공통팝업 테스트_20240111
			
		'v008 fin	
		else
		
			'펀드신규매수시
			if g_szDiv = "13005" then
				Form.SetSharedData("FUND_PAGE_SET"	, "51000")	'mbonl81010_p2 에서 가입중단시 51000으로 이동
			end if
		
			Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
												g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE	& "★" &
												g_szKYC_DVPD_EPMD_CODE 	& "★" & g_szKYC_DRVT_PROS_YN	& "★" & g_szDVPD_GRAD_CODE
								, sPosInfo)
		end if
						
	elseif	szProsYN	=	"E"	then
		Form.MsgBox("고령자 투자보호안내" , "고객보호를 위해 투자권유 유의상품의 가입이 제한됩니다.", "PROSYN_E", "6")
		
	'21.08.24 JHY START (v013)
	elseif	szProsYN	=	"1"	then
'		Form.MsgBox("정보 미제공에 대한 안내" , "정보미제공 가입불가 (고난도상품)", "PROSYN_1", "6")
		Dim szAlertData, szTitle
		szTitle = "투자자정보 미제공 안내"
		g_ErrMsgText = "고객님의 투자정보가 확인되지 않아\n해당 금융상품을 가입할 수 없습니다. \n고객님의 성향에 적합한 금융상품 투자를\n위하여 투자성향 등록 후 진행해 주세요."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
	'21.08.24 JHY END (v013)
	'숙려대상가입불가상품 (2024.01.12)
	elseif	szProsYN	=	"2"	then
		Form.ShowAlert("확인", "숙려대상고객은 가입이 불가능한 상품입니다.")
		Form.CloseForm( )
		Exit Sub
	else	
		Form.ShowAlert(g_szAlertTitle, "정의되지 않은 리턴값입니다. :"  & szProsYN)
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	end if
End Sub

Sub KYC_CHECK_AC()
     
	if	szProsYN	= 	"S"	then						'취약금융소비자투자보호
		Form.MsgBox("취약금융소비자 투자보호 안내" , "고객님은 취약금융소비자입니다. 투자자보호를 위해 투자성향보다 위험등급이 한단계를 초과한 상품가입이 불가합니다.", "PROSYN_S", "6")
	elseif	szProsYN	=	"Y"	then					'비적합처리
		Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
											g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE	& "★" &
											g_szKYC_DVPD_EPMD_CODE 	& "★" & g_szKYC_DRVT_PROS_YN	& "★" & g_szDVPD_GRAD_CODE
					, sPosInfo)	
	elseif	szProsYN	=	"N" or szProsYN	=	"X" then					'정상처리
		'v003
		if g_szDiv	=	"15008" then
			SelfDigPross()
		else
			Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
			Form.CloseForm()
		end if
	end	if
End Sub
'============================================================================
'v020 Wrap 계좌전환 체크
'============================================================================
Sub KYC_CHECK_WRAP()
	Form.SetSharedData("KYC_INVT_INCL_GRAD_CODE"	, g_szKYC_INVT_INCL_GRAD_CODE)
	Form.SetSharedData("KYC_PROD_GRAD_CODE"		, g_szKYC_PROD_GRAD_CODE)
	Form.SetSharedData("KYC_DVPD_EPMD_CODE"		, g_szKYC_DVPD_EPMD_CODE)
	Form.SetSharedData("KYC_DRVT_PROS_YN"		, g_szKYC_DRVT_PROS_YN)
	Form.SetSharedData("DVPD_GRAD_CODE"			, g_szDVPD_GRAD_CODE)
	Form.SetSharedData("KYC_INVT_RCMD_CLS_CODE"	, g_szKYC_INVT_RCMD_CLS_CODE)
	
	if g_szRSLT_CLS <> "0" then
		Form.MsgBox("투자성향진단" , "투자성향진단 후 거래하시기 바랍니다.", "PROSYN_S", "6")
	end if 
	
	if	szProsYN	= 	"Y"	then	'투자성향 등급 확인 팝업
		Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
											g_szKYC_INVT_INCL_GRAD_CODE	& "★" & g_szKYC_PROD_GRAD_CODE	& "★" &
											g_szKYC_DVPD_EPMD_CODE 	& "★" & g_szKYC_DRVT_PROS_YN	& "★" & g_szDVPD_GRAD_CODE
							, sPosInfo)
	elseif	szProsYN	= 	"P"	then	 
		Form.MsgBox("안내", "투자자 정보가 제공되어야 \n가입하실 수 있습니다.\n투자성향진단 후 신청해주세요.\n(투자자정보 [제공]선택 필수)", "PROSYN_P", 7, "투자성향 진단", "취소")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"A"	then	 
		Form.MsgBox("고객투자성향등급 확인안내", "고객님의 투자성향등급 정보가 없습니다. 해당 정보가 없으면 상품가입이 불가합니다. 투자성향등급을 확인하고 상품에 가입하시겠습니까?", "PROSYN_A", "1")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"B" 	then	 
		Form.MsgBox("고객투자성향등급 재확인안내", "고객님의 투자성향등급이 정보미제공 또는 기간 만료되어 재확인하셔야 합니다.", "PROSYN_B", "1")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"S"	then	 
		Form.MsgBox("취약금융소비자 투자보호 안내" , "고객님은 취약금융소비자입니다. 투자자보호를 위해 투자성향보다 위험등급이 한단계를 초과한 상품가입이 불가합니다.", "PROSYN_S", "6")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"T"	then	 
		Form.MsgBox("고령자 투자보호 안내" , "고객님은 파생상품 관련 투자경험이 없는 고령자(만 65세 이상)입니다. 투자성향등급을 재확인하고 파생상품 신청을 하시겠습니까?", "PROSYN_T", "1")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"V"	then	 
		Form.MsgBox("고령자 투자보호 안내" , "고객님은 파생상품관련 투자경험이 없는 고령자(만 65세 이상)입니다. 투자숙려제도에 따라서 익영업일부터는 5일 이내에 가입이 가능합니다. 단, 초고령자(만 80세 이상)고객님께서는 파생상품 온라인 가입이 제한됩니다.", "PROSYN_V", "6")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"M"	then	 
		Form.MsgBox("고객투자성향등급 취약금융소비자 투자보호 안내", "고객님의 취약금융소비자 정보가 없습니다. 해당 정보가 없으면 상품가입이 불가합니다. 투자성향등급을 확인하고 상품에 가입하시겠습니까?", "PROSYN_M", "1")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"E"	then	 
		Form.MsgBox("고령자 투자보호안내" , "고객보호를 위해 투자권유 유의상품의 가입이 제한됩니다.", "PROSYN_E", "6")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	elseif	szProsYN	= 	"H"	then	 
		Form.MsgBox("고령자 투자보호안내" , "고객보호를 위해 투자권유 유의상품의 가입이 제한됩니다.", "PROSYN_E", "6")
		Form.SendReturnToParent("KYCCHK_RETURN" , "N")
		Form.CloseForm()
	end if
	

	Form.SendReturnToParent("KYCCHK_RETURN" , "Y")
	Form.CloseForm()
End Sub
