	<SCRIPT_INFO _len="28921" _ulen="26407" >
'375 X 114

Dim nExid
Dim sItemCode
Dim g_sDecimal
Dim nNat

Dim g_sCode
Dim g_sExid
Dim g_rtChk
Dim g_sClsCd 			'현재가 종목상태구분코드 Y : 거래정지
Dim g_sSellOnly 		'현재가 거래상태 1 : 매도만가능

Dim g_szScreenNo 		'화면번호 20211203 HSZ 해외CFD
Dim g_ACNO, g_ASNO 	'20220823 SWJ

Dim g_szGroupID, g_szGroupName, g_nMutilGroup, g_szAction ' 202305011 KKM 관심종목그룹ID, 관심종목그룹명 
g_szGroupID = "" 
g_szGroupName = ""
g_nMutilGroup = 0
g_szAction = "ADD"

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)	

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "RequestData"	then
		g_sDecimal = "0"
		sItemCode = sParam
		Dim sTemp
		sTemp = split(sParam, "@")
		
		'20211223 HSZ START
		if UBOUND(sTemp)<1 then
			exit Sub
		end if
		'20211223 HSZ END
		
		g_sExid = sTemp[0] '시장구분
		g_sCode = sTemp[1] '종목코드 
		
		initRealCheck(g_sExid)
		
		DATAMANAGER.CancelRealData("ohhts_exst_cntg")
		DATAMANAGER.CancelRealData("ohhts_exst_cntd") '20221213_01 KBC 해외주식주간거래
		
		if Len(sItemCode) > 0	then
			DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
			DATAMANAGER.RequestTranData( "ohhts_6000_017r" ) '20221213_01 KBC 해외주식주간거래
		end if

'		'202300510 KKM START 관심종목 설정여부 확인
'		if g_szCloud == "1" then		' Server 저장시
'			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
'			DATAMANAGER.RequestTranData("ohhts_intr_101r")
'		else							' Local 저장시
'			' 로컬 저장된 관심그룹에 해당 종목이 있는지 찾기 	
'			Search_InLocalGroup()
'		end if
'		'202300510 KKM END 
	
	'20220823 SWJ START : 일반계좌인 경우만 증거금율 표출
	elseif sEventName == "16200_cfdmgrt" then
		
		Dim sTemp
		sTemp = split(sParam, "@")
		
		if Ubound(sTemp) < 1 then
			exit sub
		end if		
		
		g_ACNO = sTemp[0]
		g_ASNO = sTemp[1]
		
		DATAMANAGER.RequestTranData( "obtre_comm_004r" )
	'20220823 SWJ END
		
	'202300510 KKM 관심종목 등록/삭제 팝업 & 등록/삭제 후 
	elseif sEventName == "CLICK_GWANSIM" then
'Form.ShowAlert(sParam & "★" & g_szGroupID & "★"& g_szGroupName & "★" & g_nMutilGroup)		
'		if g_nMutilGroup == 1 then
'			g_szAction = "DEL"
'			if g_szGroupID <> "" and g_szGroupName <> "" then '그룹 1개에 속함
'				'관심종목으로 등록된 경우 삭제여부
'				Form.MsgBox("알림", g_szGroupName .." 에서 해당 종목을 삭제하시겠습니까?", "NOTI_GWANSIMDEL", "1")
'			End if
'		elseif g_nMutilGroup > 1 then
'			'관심종목 삭제 화면 팝업
'			g_szAction = "DEL"
'			Form.triggerEvent("#", "mhtro16010_p5_popup", "DEL")
'		else
			'관심종목 등록 화면 팝업
			g_szAction = "ADD"
			Form.triggerEvent("#", "mhtro16010_p5_popup", "ADD")
'		end if 		

	elseif sEventName == "mhtro16010_save" then 
'Form.ShowAlert("mhtro16010_save :: " & sParam & " ★ " & g_szCloud)	
		tList = Split(sParam, "★") 
		if tList(2) == "ADD" then 		
			Form.SetInterestTitle("Y")
			g_szGroupID = tList(0)
			g_szGroupName = tList(1)
		elseif tList(2) == "DEL" then 
			Form.SetInterestTitle("N")
			g_szGroupID = ""
			g_szGroupName = ""
		end if 	
'		if g_szCloud == "1" then		' Server 저장시
'			'FID 버전id 조회
'			DATAMANAGER.RequestTranData("ohhts_intr_006r")
'			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
'			DATAMANAGER.RequestTranData("ohhts_intr_101r")
'		else							' Local 저장시
'			' 로컬 저장된 관심그룹에 해당 종목이 있는지 찾기 	
'			Search_InLocalGroup()
'		end if 		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'20221213_01 KBC 해외주식주간거래
	if szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_017r" then
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_sExid)
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_sCode )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
	elseif szTranID == "obsim_oscm_331r"	then
		DATAMANAGER.SetDataValue( false, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , g_sCode.."."..g_sExid )
'	elseif szTranID == "obtre_comm_005r" then '20211203 HSZ 해외CFD
'		TblCFD.SetCellString(0, 1, "")
'		TblCFD.SetCellString(1, 1, "")
'		szToday = Form.GetSharedData("&HOST_DATE", 0 )
'		DATAMANAGER.SetDataValue( false, "obtre_comm_005r", "InBlock1", "ISNM" , 0 , g_sCode.."."..g_sExid )
'		DATAMANAGER.SetDataValue( false, "obtre_comm_005r", "InBlock1", "STND_DATE" , 0 , szToday )
	
	'20220607 SWJ START : 종목한도 추가
	elseif szTranID == "obtre_comm_024r" then
		TblCFD.SetCellString(0, 1, "")
		TblCFD.SetCellString(1, 1, "")
		TblCFD0.SetCellString(0, 1, "")		'20220823 SWJ START
		TblCFD0.SetCellString(1, 1, "")		'20220823 SWJ END
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue( false, "obtre_comm_024r", "InBlock1", "ISNM" , 0 , g_sCode.."."..g_sExid )
		DATAMANAGER.SetDataValue( false, "obtre_comm_024r", "InBlock1", "STND_DATE" , 0 , szToday )
	'20220607 SWJ END
	
	'20220823 SWJ START : 일반계좌인 경우만 증거금율 표출
	elseif szTranID == "obtre_comm_004r" then
		DATAMANAGER.SetDataValue( false, "obtre_comm_004r", "InBlock1", "ACNO" , 0 , g_ACNO )
		DATAMANAGER.SetDataValue( false, "obtre_comm_004r", "InBlock1", "ASNO" , 0 , g_ASNO )
	'20220823 SWJ END
	'202300510 KKM START : 관심종목 설정
	ElseIf szTranID = "ohhts_intr_101r" then
		g_szGroupID = "" 
		g_szGroupName = ""	
		grdList.rowcount = 0	' 종목그리드 초기화
	
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_USER_ID", 0 , g_szUserId)
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD", 0 , g_szItemCode)	
	ElseIf szTranID == "ohhts_intr_006r" then
		grdGroup.rowcount = 0	' 관심종목그룹 초기화
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0 , g_szUserId)
'	ElseIf szTranID == "ohhts_intr_007r" then  
'		DATAMANAGER.ClearInputData(0, "ohhts_intr_007r")		
'		grdList.rowcount = 0	' 종목그리드 초기화
'		
'		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID", 0 , g_szUserId)
'		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0 , g_szGroupID)	

	ElseIf szTranID == "ohhts_intr_102r" then  '관심종목 삭제
		DATAMANAGER.ClearInputData(0, "ohhts_intr_102r")		
		grdList.rowcount = 0	' 종목그리드 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_USER_ID", 0 , g_szUserId)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_VRSN_ID"	, 0 , edtvrsnID.caption)	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0 , g_szItemCode)		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock3", "FID_CNCN_ISSU_GRP_ID", 0 , g_szGroupID )	
	'202300510 KKM END	
	end If	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_001r"	then
		
		nNat = Form.GetItemCodeInfo(sItemCode, "ovsnation") '국가구분 코드
		
		Dim sExid
		
		'USA, HKG JPY, CHN
		if nNat == "USA"	then
			LblNat.caption = "미국"
		elseif nNat == "HKG"	then
			LblNat.caption = "홍콩"
		elseif nNat == "CHN"	then
			LblNat.caption = "중국"
		elseif nNat == "JPY"	then		'해외주식 일본 추가
			LblNat.caption = "일본"
		end if
		
		'20221213_01 KBC START 해외주식주간거래
		if nNat == "USA"	then
			LblDay.visible = TRUE
			LblDayPrice.visible = TRUE
			Label0.visible = TRUE
			LblDayDiff.visible = TRUE
			LblDayRate.visible = TRUE
			LblDayVol.visible = TRUE
		else
			LblDay.visible = FALSE
			LblDayPrice.visible = FALSE
			Label0.visible = FALSE
			LblDayDiff.visible = FALSE
			LblDayRate.visible = FALSE
			LblDayVol.visible = FALSE
		end if
		'20221213_01 KBC END

		nExid = Form.GetItemCodeInfo(sItemCode, "exchcode3") '거래소 구분코드
		sExid = Transform_Exid(nExid)
		LblExid.caption = sExid
		
		g_sClsCd = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ISSU_STAT_CLS_CODE", 0) ' 종목상태구분코드 Y : 거래정지
		g_sSellOnly = CInt(DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_SELL_ONLY", 0)) '거래상태 ' 1매도만가능
		
		sEtfYn = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ETF_YN", 0) ' ETF여부
		sLvrg = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FID_LVRG", 0) ' 레버리지
		
		if sEtfYn = "Y" then
			LblIndu.caption = "ETF(" & FormatNumber(sLvrg,1) & ")"
			LblIndu1.caption = "ETF(" & FormatNumber(sLvrg,1) & ")"
		end if
		
		DATAMANAGER.RequestTranData( "obsim_oscm_331r" )
		
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , sItemCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
		
		'20221213_01 KBC START 해외주식주간거래
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , sItemCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
		'20221213_01 KBC END
		
		'20211203 HSZ START : 해외CFD
		If g_szScreenNo = "16100" or g_szScreenNo = "16200" or g_szScreenNo = "16210" then
			'DATAMANAGER.RequestTranData( "obtre_comm_005r" ) '20211203 HSZ 해외CFD
			DATAMANAGER.RequestTranData( "obtre_comm_024r" ) '20220607 SWJ : 종목한도 개선
		End if
		'20211203 HSZ END
	elseif szTranID == "obsim_oscm_331r"	then
	
		Dim ssSellOnly,sStatus,WeekDate,sMrktCls
		
		sSellOnly   = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN", 0) ' 매수불가여부
		sStatus     = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock1", "TRHT_YN", 0) 		' 거래정지여부
		sWeekDate   = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "STND_DATE", 0) 	' 기준일
		sMrktCls    = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "HLDY_YN", 0) 		' 휴일여부
		sPtpYn      = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "PTP_ISSU_YN", 0) 	' PTP종목여부 '20221206_01 KBC : 해외주식 미국PTP 종목과세관련

		sWeekDate = WeekDay( CDate( Left( sWeekDate, 4 ) & "-" & Mid( sWeekDate, 5, 2 ) & "-" & Right( sWeekDate, 2 ) ) )
		If Trim( sMrktCls ) = "Y" And Trim( sWeekDate ) <> "1" And Trim( sWeekDate ) <> "7" Then		'일요일, 토요일 제외
			LblStatus.caption = "휴장"
		Else
			if g_sClsCd == "Y" then
				LblStatus.caption = "거래정지"
			else
				LblStatus.caption = ""
				if g_sSellOnly == 1 then
					LblStatus.caption = "매도만가능"
					
				'20221206_01 KBC START : 해외주식 미국PTP 종목과세관련
				else
					if sPtpYn = "Y" then
						LblStatus.caption = "PTP지정"
					end if	
				'20221206_01 KBC END

				end if
			end if
		End If
		
		if LblStatus.caption == "" then
			LblIndu1.visible = true
			LblIndu.visible = false
		else
			LblIndu1.visible = false
			LblIndu.visible = true
		end if
	'20211203 HSZ START : CFD현재가 화면 추가
'	elseif szTranID == "obtre_comm_005r" then
'		cfd_buy = DATAMANAGER.GetDataValue( 0, "obtre_comm_005r", "OutBlock1", "BYOV_ABLE_YN" , 0 )
'		if cfd_buy = "Y" then
'			cfd_buy = "가능"
'			TblCFD.SetCellFgColor(1, 1, "6")
'		else
'			cfd_buy = "불가"
'			TblCFD.SetCellFgColor(1, 1, "11")
'		end if
'		cfd_sell = DATAMANAGER.GetDataValue( 0, "obtre_comm_005r", "OutBlock1", "SELN_ABLE_YN" , 0 )
'		if cfd_sell = "Y" then
'			cfd_sell = "가능"
'			TblCFD.SetCellFgColor(2, 1, "6")
'		else
'			cfd_sell = "불가"
'			TblCFD.SetCellFgColor(2, 1, "11")
'		end if
'		
'		TblCFD.SetCellString(1, 1, cfd_buy)
'		TblCFD.SetCellString(2, 1, cfd_sell)
		'20211203 HSZ END
	
	'20221012 SWJ START : 서비스 내부 로직으로 변경 (회사 종목한도 추가)
	'20220607 SWJ START : 주문한도 추가
	elseif szTranID == "obtre_comm_024r" then
		cfd_buy = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "BYOV_ABLE_ACNT_CLCD" , 0 )	
		cfd_sell = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "SELN_ABLE_ACNT_CLCD" , 0 )	
		'cfd_mrgt = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "CFD_MGRT" , 0 )
		'cfd_rgrp = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "CFD_ISSU_RISK_GRP_CODE" , 0 )
		
		'20230109 SWJ START
		cfd_tax = DATAMANAGER.GetDataValue( 0, "obtre_comm_024r", "OutBlock1", "TRNF_INCM_TXTN_CLCD" , 0 )
		'20230428 KKM  증거금율 추가
		cfd_mgrt  = DATAMANAGER.GetDataValue( 0,  "obtre_comm_024r", "OutBlock1", "CFD_MGRT"		, 0 )		
		
		'비과세
		if cfd_tax = "0" then
			cfd_tax = "비과세"
		'과세 (1일 때이지만, 과세가 기본이라 함)
		else
			cfd_tax = "과세"
		end if
		'20230109 SWJ END
		
'		if cfd_buy = "Y" then			
'			if cfd_mrgt <> "" then
'				if Cint(cfd_mrgt) = 40 then
'					if cfd_rgrp = "E" then
'						cfd_buy = "안심"
'					else
'						cfd_buy = "안심/일반"
'					end if
'				elseif Cint(cfd_mrgt) = 100 then
'					cfd_buy = "안심"
'				else
'					cfd_buy = ""
'				end if
'			end if
'		else
'			cfd_buy = "불가"
'		end if
'		
'		if cfd_sell = "Y" then
'			if cfd_rgrp = "E" then
'				cfd_sell = "불가"
'			else
'				cfd_sell = "일반"
'			end if
'		else
'			cfd_sell = "불가"
'		end if
		
		TblCFD.SetCellString(0, 1, cfd_buy)
		TblCFD.SetCellString(1, 1, cfd_sell)
		'TblCFD.SetCellString(2, 1, cfd_tax)		'20230109 SWJ START
		TblCFD.SetCellString(0, 4, cfd_tax)		'20230428 KKM 테이블 UI변경
		
		TblCFD0.SetCellString(0, 1, cfd_buy)		'20220823 SWJ START
		TblCFD0.SetCellString(1, 1, cfd_sell)	'20220823 SWJ END
		'TblCFD0.SetCellString(3, 1, cfd_tax)	'20230109 SWJ START
		TblCFD0.SetCellString(1, 4, cfd_tax)		'20230428 KKM 테이블 UI변경
		TblCFD0.SetCellString(0, 4, cfd_mgrt)	'20230428 KKM 증거금율추가
		
	'20220607 SWJ END
	'20221012 SWJ END
	
	'20220823 SWJ START : 일반계좌인 경우만 증거금율 표출
	elseif szTranID == "obtre_comm_004r" then
		szAcnoAB = DATAMANAGER.GetDataValue( 0, "obtre_comm_004r", "OutBlock1", "CFD_MARG_GRAD_CODE" , 0 ) 	'A:일반, B:안심
		
		if szAcnoAB = "A" then
			TblCFD.visible = false
			TblCFD0.visible = true	
		else
			TblCFD.visible = true
			TblCFD0.visible = false
		end if
	'202300510 KKM START : 관심종목 설정
	ElseIf szTranID = "ohhts_intr_101r" then
		cnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_101r", "OutBlock1")		
		if cnt > 0 then
			g_nMutilGroup = cnt
			Form.SetInterestTitle("Y")
			if cnt == 1 then 
				g_szGroupID = DATAMANAGER.GetDataValue( 0, "ohhts_intr_101r", "OutBlock1", "FID_CNCN_ISSU_GRP_ID", 0 ) 
				g_szGroupName = DATAMANAGER.GetDataValue( 0, "ohhts_intr_101r", "OutBlock1", "FID_CNCN_GRP_NAME", 0 ) 
			end if 
'Form.ShowAlert("ohhts_intr_101r ::: " & g_szGroupID & "★" & g_szGroupName)
		else
			g_nMutilGroup = 0
			Form.SetInterestTitle("N")
			g_szGroupID = ""
			g_szGroupName = ""
			grdList.rowcount = 0	' 종목그리드 초기화			
		end if
		
		Save_GWList() ' for server
		
	ElseIf szTranID == "ohhts_intr_006r" then  		

	ElseIf szTranID == "ohhts_intr_102r" then  '관심종목 삭제
		DATAMANAGER.RequestTranData("ohhts_intr_101r"	)	
	'202300510 KKM END	
	end if
End Sub

'============================================================================
' 거래소 ID 이름으로 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 104
		return "홍콩"
	elseif sValue == "HSI" then ' 529
		return "항셍 지수"
'		return "중국"
	elseif sValue == "SHS" then ' 215
		return "상해"
'		return "중국"
	elseif sValue == "SZS" then ' 214
		return "심천"
'		return "중국"
	elseif sValue == "NYS" then ' 321
		return "뉴욕"
'		return "미국"
	elseif sValue == "AMX" then ' 66
		return "아멕스"
'		return "미국"
	elseif sValue == "NAS" then ' 537
		return "나스닥"
'		return "미국"
	elseif sValue == "NAO" then ' 130
		return "미국"
	elseif sValue == "SPI" then ' 625
		return "S&P"
	elseif sValue == "DJI" then ' 310
		return "다우존스"
	elseif sValue == "TSE" then ' 106
		return "도쿄"
	elseif sValue == "OSE" then ' 107
		return "오사카"
	elseif sValue == "JSD" then ' 112
		return "자스닥"
	elseif sValue == "NII" then ' 889
		return "니케이"
	elseif sValue == "NAI" then ' 538
		return "나스닥"
	elseif sValue == "HSX" then ' 770
		return "호치민"
	elseif sValue == "HNX" then ' 771
		return "하노이"
	end if
end Function

'============================================================================
Sub initRealCheck(sValue)
	g_rtChk = Form.GetSharedData( "REALTIME_"..sValue, false )
	if g_rtChk == "0" then
		LblSise.caption = "실시간"
	else
		if sValue == "JP" then
			LblSise.caption = "20분지연"
		else
			LblSise.caption = "15분지연"
		end if
		
		'20221213_01 KBC START 해외주식주간거래 
		sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
		
		if sDayYN == "Y" then
			if sValue == "NY" or sValue == "AX" or sValue == "OQ" then
				LblSise.caption = "실시간"
			end if
		end if
		'20221213_01 KBC END
	end if 	
end Sub


'============================================================================
Sub btnItemLeft_OnClick()
	Move_ItemCode( "Left" )
End Sub

'============================================================================
Sub btnItemRight_OnClick()
	Move_ItemCode( "Right" )
End Sub
'============================================================================
Function Move_ItemCode( szType )
	If szType = "Right" Then
		Form.ACRSetProp( "moveitem", "1" )
	ElseIf szType = "Left" Then
		Form.ACRSetProp( "moveitem", "-1" )
	End If
End Function

