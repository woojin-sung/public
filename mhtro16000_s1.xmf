'============================================================================
Sub Form_OnFormInitBefore()
	'20221213_01 KBC START 해외주식주간거래
	TblCFD.left = 167
	TblCFD0.left = 167
	LblIndu1.left = 268
	'20221213_01 KBC END
		
'	20211203 HSZ START : 해외CFD 
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20211203 HSZ 해외CFD
	If g_szScreenNo = "16100" or g_szScreenNo = "16200" or g_szScreenNo = "16210" then
'		Form.setSearchType("26")
		TblCFD.visible = true
		'TblCFD0.visible = true
		LblIndu1.visible = false
		'LblStatus.visible = false '20221213_01 KBC 해외주식주간거래 : 주간시세 보여지면서 공간이 되서 휴장여부 CFD화면도 보여줌
		Label8.visible = false
	else
		TblCFD.visible = false
		TblCFD0.visible = false
	end if
'	20211203 HSZ END

	'20230503 KKM  : 종목메모이미지
	imgMemo.SetMaintainingRatio("1")
	
	'202300510 KKM : 관심종목 설정 초기화
	Form.SetInterestTitle("N")
	
End Sub


'============================================================================
Sub Form_OnFormInit()
	'20221213_01 KBC START 해외주식주간거래
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_mkop", "InBlock1", "FIDR_SHRN_ISCD" , 0 , "*" )
	DATAMANAGER.RequestRealData( "ohhts_exst_mkop" )
	'20221213_01 KBC END	
	
	'202300510 KKM 주문버튼 설정
	Form.SetButtonTitle("주문")	
	'202300510 KKM 관심종목 설정
	' 관심 동기화 
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	
	if g_szCloud == "1" then		' Server 저장시
		' FID버전ID 가져오기
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기	
		Load_GWGroup()
	end if
	'202300510 KKM END
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	'20221213_01 KBC START 해외주식주간거래
	DATAMANAGER.CancelRealData("ohhts_exst_mkop")
	'20221213_01 KBC END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	'20221213_01 KBC START 해외주식주간거래
	if szTranID = "ohhts_exst_mkop" then
		szMKOP = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDXR_MKOP_CLS_CODE" , 0)
		
		if szMKOP = "O001" then '주간장시작
			Form.SetSharedData("&OVRS_DAYMARKET", "Y")
			
		elseif szMKOP = "O000" then '주간장종료
			Form.SetSharedData("&OVRS_DAYMARKET", "N")
			
		end if
		
		initRealCheck(g_sExid)
		
	end if	
	'20221213_01 KBC END
End Sub

'20230426 KKM 메모 추가 START
'============================================================================
Sub imgMemo_OnClick()
	btnMeno_OnClick()	
End Sub

'============================================================================
Sub btnMeno_OnClick()
	Form.triggerEvent("#", "TITLE_CLICK", "16000_MEMO") '메인화면에 메모팝업 오픈 요청	'20220922 SWJ START : 11000_MEMO 파라미터 추가
End Sub

'20230426 KKM 메모 추가 END 

'============================================================================
'20230512 KKM 등록된 관심종목을 등록삭제 START
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "NOTI_GWANSIMDEL" then
		if sRet == "ok" then
			if g_szCloud == "1" then		' Server 저장시
				DATAMANAGER.RequestTranData("ohhts_intr_102r" ) '등록삭제
			else							' Local 저장시				
				Load_GWList() '로컬 해당 그룹 관심종목 가져오기 
				'로컬 해당 그룹 관심종목 저장하기
				Save_GWList() ' for local
			
				g_szGroupID = "" 
				g_szGroupName = ""	
				grdList.rowcount = 0	' 종목그리드 초기화	
				Form.SetInterestTitle("N")
			end if			
		end if
	end if	
End Sub

'20211021 아이티젠(김성수) 현재가 개선 START
'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if	
	
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

'202300515 KKM START	
'============================================================================
' SearchInLocalGroup :  로컬 저장된 관심그룹들에 현재의 종목이 있는지 찾기
'============================================================================
Function Search_InLocalGroup()
	if g_szCloud == "1" then
		Exit Function
	end if 
	
	Dim tGroup, tList
	g_nMutilGroup = 0 
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		
		szGroup = Form.LoadConfigData("GWANSIM", szCode)
		if szGroup <> "" then
			tGroup = Split(szGroup, "♣")
			For j = 0 to #tGroup-1
				tList = Split(tGroup(j), "★")
				if tList(0) == g_szItemCode then ' 종목이 있음.
					g_szGroupID = szCode
					g_szGroupName = szName
					g_nMutilGroup = g_nMutilGroup + 1
				end if 
			Next
		end if 		
	Next
	
	if g_nMutilGroup > 0 then
		if g_nMutilGroup > 1 then
			g_szGroupID = ""
			g_szGroupName = ""	
		end if
		Form.SetInterestTitle("Y")		
	else
		g_szGroupID = ""
		g_szGroupName = ""
		Form.SetInterestTitle("N")
	end if  	
End Function
'202300515 KKM END 

'============================================================================
' Insert_GrdList : grdList에 종목 삭제
'============================================================================
Function Delete_GrdList()

	if g_szCloud == "1" then		' Server 저장시
		DATAMANAGER.RequestTranData("ohhts_intr_102r" ) '등록삭제
	end if
			
	'로컬 해당 그룹 관심종목 저장하기
	Save_GWList() '등록삭제후 저장
	
	g_szGroupID = "" 
	g_szGroupName = ""	
	grdList.rowcount = 0	' 종목그리드 초기화	
	Form.SetInterestTitle("N")

End Function

'============================================================================
' Load_GWList :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList

	grdList.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", g_szGroupID)

	if szGroup <> "" then
		tGroup = Split(szGroup, "♣")
	
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdList.insertrow = i
			'20180905_01 NOHES : 빈칸 처리
			if Trim(tList(0)) == "" or Trim(tList(0)) == "빈칸" or Trim(tList(0)) == "EMPTY" then
				grdList.SetCellFgColor("bd_code", i, "6")
				grdList.SetCellFgColor("bd_name", i, "6")
				
				grdList.SetCellData("bd_code", i, "빈칸")
				grdList.SetCellData("bd_mk",   i, "")
				grdList.SetCellData("bd_name", i, tList(2))
				grdList.SetCellData("bd_memo", i, tList(2))
				grdList.SetCellImage("bd_mod", i, "icon_sub_04.9.png")
			else
				grdList.SetCellData("bd_code", i, tList(0))
				grdList.SetCellData("bd_mk",   i, tList(1))
				szName = Form.GetItemCodeInfo(tList(0), "name")	' 종목명은 저장 안하므로 메인에서 가져온다.
				grdList.SetCellData("bd_name", i, szName)
				grdList.SetCellData("bd_memo", i, "")
			end if
		Next
	end if
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()

	Dim szList, szCd, szMk
	'20211208 HSZ START : 등록된 관심그룹이 없는 경우
	if int(grdGroup.rowcount) == 0 then
		'Form.MsgBox("안내", "등록된 관심그룹이 없습니다.\n관심그룹을 새로 등록하시겠습니까?", "ADDGROUP", 1)
		Exit Function 
'	20211208 HSZ END
	else
		For i = 0 to grdList.rowcount-1
			szCd = grdList.GetCellData("bd_code", i)
			szMk = grdList.GetCellData("bd_mk",   i)
			
			if Trim(szMk) == "" then
				szMk = ""
				szCd = ""
			end if
			'해당 그룹의 관심종목 삭제
			if (g_szItemCode <> szCd) and (szCd <> "") then 
			
	'201800905_01 NOHES START : 메모 관심리스트 저장
				'if i == 0 then
				if szList  = nil or szList = "" then
					szList = szCd  & "★" & szMk & "★" & grdList.GetCellData("bd_memo", i) & "★" & grdList.GetCellData("bd_name", i)
				else
					szList = szList & "♣" & szCd & "★" & szMk & "★" & grdList.GetCellData("bd_memo", i) & "★" & grdList.GetCellData("bd_name", i)
				end if
	'20180905_01 NOHES END	
			end if 
		Next
	end if
	
	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	if g_szCloud == "0" then
		szChange = Form.GetCtlProp("#edtChange", "caption")
			
		' 그룹편집(1)이 된 상태이면 그룹도 조회해야하기 때문에 그룹편집이 안된상태일때 종목편집(0)조건을 넣어준다.
		if szChange <> "1" then
			Form.SetCtlProp("#edtChange", "caption", "0")
		end if
		
		For j = 0 to grdGroup.rowcount-1
			szCd = grdGroup.GetCellData("bd_code", j)
			
			if g_szGroupID == szCd then
				grdGroup.SetCellData("bd_count", j, grdList.rowcount)
				Exit For
			end if
		Next
	end if
	
	Save_GWGroup()
	
	Form.SaveConfigData("GWANSIM", g_szGroupID, szList)

End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function
