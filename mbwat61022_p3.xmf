'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 운용대상자산 조회
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.19 : 고승연 : v0001 : 
'                2022.10.25 : 고승연 : v0002 : 파생인경우 선물옵션매수/청산만허용 필수
'                2023.11.10 : 고승연 : v0003 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szWA_PRCD	'랩상품코드
Dim g_sMgriYN		'운용주체
Dim g_sDrvtYN		'파생여부
Dim g_tData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgDot0.setMaintainingRatio("1")
	imgDot1.setMaintainingRatio("1")
	imgDot2.setMaintainingRatio("1")
	imgDot3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim sData
	sData = Form.GetOpenLinkData()
	
	if sData <> "" then
		g_tData = Split(sData, "|")
		
		g_szWA_PRCD = g_tData(0)	' 상품코드
		g_sMgriYN = g_tData(1)		' 운용주체
		g_sDrvtYN = g_tData(2)		' 파생여부
		
		DATAMANAGER.RequestTranData("obwat_pdad_065r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_pdad_065r" then '운용대상자산
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD)	'랩어카운트상품코드	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_pdad_065r" then '운용대상자산
		sEXCH_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EXCH_INVT_YN" , 0)	'거래소
		sKOSDAQ_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KOSDAQ_INVT_YN" , 0)	'코스닥
		sKONEX_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KONEX_INVT_YN" , 0)	'코넥스		
		sETN_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETN_INVT_YN" , 0)	'ETN
		sOTC_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTC_INVT_YN" , 0)	'K-OTC
		
		sOVRS_STCK_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OVRS_STCK_INVT_YN" , 0)	'해외주식
		sOVRS_ETP_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETP_INVT_YN" , 0)	'해외ETP
		
		sCLRN_INDC_YN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CLRN_INDC_YN" , 0)	'선물옵션매수/청산만 허용
		sOPTN_TR_ABLE_YN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OPTN_TR_ABLE_YN" , 0) '모든선물옵션
		
		sBOND_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BOND_INVT_YN" , 0)	'채권
		sFND_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FND_INVT_YN" , 0)	'펀드
		sDRVT_ETF_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DRVT_ETF_INVT_YN" , 0)	'파생ETF
		sMMW_ATMT_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MMW_ATMT_INVT_YN" , 0)
		
		f_Check("chk00", sEXCH_INVT_YN)
		f_Check("chk01", sKOSDAQ_INVT_YN)
		f_Check("chk02", sKONEX_INVT_YN)
		f_Check("chk03", sETN_INVT_YN)
		f_Check("chk04", sOTC_INVT_YN)
		
		f_Check("chk10", sOVRS_STCK_INVT_YN)
		f_Check("chk11", sOVRS_ETP_INVT_YN)
		
		f_Check("chk20", sCLRN_INDC_YN)
		f_Check("chk21", sOPTN_TR_ABLE_YN)
		
		f_Check("chk30", sBOND_INVT_YN)
		f_Check("chk31", sFND_INVT_YN)
		f_Check("chk32", sDRVT_ETF_INVT_YN)
		f_Check("chk33", sMMW_ATMT_INVT_YN)
		
		chk20.enable = false
		
		if g_sMgriYN == "N" then
			chk00.enable = false
			chk01.enable = false
			chk02.enable = false
			chk03.enable = false
			chk04.enable = false
			
			chk10.enable = false
			chk11.enable = false
			
			chk20.enable = false
			chk21.enable = false
			
			chk30.enable = false
			chk31.enable = false
			chk32.enable = false
			chk33.enable = false
		end if
	end if
End Sub

Sub f_Check(sCtlName, sYN)
	Dim sState
	
	if sYN == "Y" then
		sState = "1"
	else
		sState = "0"
	end if
	
	if g_sMgriYN == "Y" then
		Form.SetCtlProp(sCtlName, "enable", sState)
	end if
	
	if #g_tData == 16 then
		if sCtlName == "chk00" then
			if g_tData(3) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk01" then
			if g_tData(4) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk02" then
			if g_tData(5) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk03" then
			if g_tData(6) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk04" then
			if g_tData(7) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk10" then
			if g_tData(8) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk11" then
			if g_tData(9) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk20" then
			if g_tData(10) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk21" then
			if g_tData(11) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk30" then
			if g_tData(12) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk31" then
			if g_tData(13) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk32" then
			if g_tData(14) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk33" then
			if g_tData(15) == "N" then
				sState = "0"
			end if
		end if
	end if
	
	Form.SetCtlProp(sCtlName, "checkstate", sState)
End Sub

Function CheckYN(sCtlName)
	Dim sState
	sState = Form.GetCtlProp(sCtlName, "checkstate")
	CheckYN = sState = "1" and "Y" or "N"
End Function

'============================================================================
Sub btnNext_OnClick()
	Dim sData
	
	sData = CheckYN("chk00").."|"..CheckYN("chk01").."|"..CheckYN("chk02").."|"
	sData = sData..CheckYN("chk03").."|"..CheckYN("chk04").."|"
	
	sData = sData..CheckYN("chk10").."|"..CheckYN("chk11").."|"
	
	sData = sData..CheckYN("chk20").."|"..CheckYN("chk21").."|"
	
	sData = sData..CheckYN("chk30").."|"..CheckYN("chk31").."|"
	sData = sData..CheckYN("chk32").."|"..CheckYN("chk33")
	
	Form.SendReturnToParent("CONFIRM" , sData)
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

