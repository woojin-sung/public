'============================================================================
' 01. 화 면 명 : HOME_실시간순위
' 02. 화면설명 : 실시간순위_해외
' 03. 작    성 : 
'============================================================================

Dim gGubun
Dim gMarket

gGubun = 0
gMarket = "US"

Dim g_szOsType

'============================================================================
Sub Form_OnFormInitBefore()

	imgNotice.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'--------------------------------------------------
	'거래소 구분 폼탭(FormTab1) 헤더 생성
	'--------------------------------------------------
	FormTab1.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab1.setTabHeaderFgColor("28" , "321") 								 '활성화/비활성화 폰트색상

	FormTab1.insertPage( FormTab1.tabcount, "page1", "page1", "empty", "0", "미국")
	FormTab1.insertPage( FormTab1.tabcount, "page2", "page2", "empty", "0", "상해")
	FormTab1.insertPage( FormTab1.tabcount, "page3", "page3", "empty", "0", "심천")
	FormTab1.insertPage( FormTab1.tabcount, "page4", "page4", "empty", "0", "홍콩")
	FormTab1.insertPage( FormTab1.tabcount, "page5", "page5", "empty", "0", "일본")

	FormTab1.currenttab = 0

	'--------------------------------------------------
	'조회조건 폼탭(FormTab0) 헤더 설정
	'--------------------------------------------------
	g_szOsType = Form.GetSharedData("&OS_TYPE", false)
	if g_szOsType == "1" then
		FormTab0.setTabDefaultImage("tab_03_o.9","alpha.9")
	else
		FormTab0.setTabHeaderImage("tab_00_o.9","alpha", 0)
	end if

	'--------------------------------------------------
	' 초기탭 선택
	'--------------------------------------------------
	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
	
End Sub

'============================================================================
'
'============================================================================
Function RequestData()

	'-----------------------------------------------
	' 조회조건 확인
	'-----------------------------------------------
	nCond = Cint(FormTab0.currenttab)
	
	'-----------------------------------------------
	' 데이터행 초기화
	'-----------------------------------------------
	Pannel0.rowcount = 0
	
	'-----------------------------------------------
	' 실시간 해제 및 인풋데이터 클리어
	'-----------------------------------------------
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")
	DATAMANAGER.ClearInputData(1, "ohhts_exst_ictg")

	'-----------------------------------------------
	'상승률(0)/하락률(1)/거래량(3)
	'-----------------------------------------------
	if nCond == 0 or nCond == 1 or nCond == 3 then
		
		DATAMANAGER.ClearInputData(0, "ohhts_6230_002r")
		
		szNation = GetNation()
		szMarket = GetMarket()
		szGubun 	= GetGubun()
		szSort	= GetSortCode()
		
		if szNation == "US" then
			szDelay =  Form.GetSharedData("REALTIME_OQ", false)
		else
			szDelay = Form.GetSharedData("REALTIME_"..szMarket, false )
		end if
				
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 	, "OV" 		)
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" 		, 0 	, "62300" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 	, szDelay 	) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FIDX_INPUT_NTNL_CODE" 			, 0 	, szNation 	) '국가구분
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 	, szMarket 	) '마켓구분
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FID_INPUT_DATE1" 				, 0 , "1" 		) '기간(1일)
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE" 	, 0 	, szGubun 	) '기간등락률(0) / 당일거래량(2)
		DATAMANAGER.SetDataValue( 0, "ohhts_6230_002r" , "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE4" 	, 0 	, szSort 	) '상위(0)/하위(1)
				
		DATAMANAGER.RequestTranData("ohhts_6230_002r")
	
	'-----------------------------------------------
	' 거래대금(2)
	'-----------------------------------------------
	elseif nCond == 2 then
	
		DATAMANAGER.ClearInputData(0, "ohhts_6242_001r")
		
		szNation = GetNation()
		szMarket = GetMarket()
		
		if szNation == "US" then
			szDelay =  Form.GetSharedData("REALTIME_OQ", false)
		else
			szDelay = Form.GetSharedData("REALTIME_"..szMarket, false )
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_6242_001r" , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 	, "OV" 		)
		DATAMANAGER.SetDataValue( 0, "ohhts_6242_001r" , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" 		, 0 	, "62420" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_6242_001r" , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 	, szDelay 	) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, "ohhts_6242_001r" , "InBlock1", "FIDX_INPUT_NTNL_CODE" 			, 0 	, szNation 	) '국가구분
		DATAMANAGER.SetDataValue( 0, "ohhts_6242_001r" , "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 	, szMarket 	) '마켓구분
		DATAMANAGER.SetDataValue( 0, "ohhts_6242_001r" , "InBlock1", "FID_INPUT_DATE1" 				, 0 	, "0" 		) '당일(0)
		
		DATAMANAGER.RequestTranData("ohhts_6242_001r")
	
	'-----------------------------------------------
	' 시가총액(4)
	'-----------------------------------------------
	elseif nCond == 4 then
	
		DATAMANAGER.ClearInputData(0, "ohhts_6233_001r")
		
		szNation = GetNation()
		szMarket = GetMarket()
		
		if szNation == "US" then
			szDelay =  Form.GetSharedData("REALTIME_OQ", false)
		else
			szDelay = Form.GetSharedData("REALTIME_"..szMarket, false )
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_6233_001r" , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6233_001r" , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" 	, 0 , "62330" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6233_001r" , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , szDelay )
		DATAMANAGER.SetDataValue( 0, "ohhts_6233_001r" , "InBlock1", "FIDX_INPUT_NTNL_CODE" 			, 0 , szNation )
		DATAMANAGER.SetDataValue( 0, "ohhts_6233_001r" , "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 , szMarket )
		
		DATAMANAGER.RequestTranData("ohhts_6233_001r")
	
	'-----------------------------------------------
	' 신고가(5)
	'-----------------------------------------------
	elseif nCond == 5 then
	
		DATAMANAGER.ClearInputData(0, "ohhts_6236_001r")
		
		szNation = GetNation()
		szMarket = GetMarket()
		szGubun 	= GetGubun()
		szSort	= GetSortCode()
		
		if szNation == "US" then
			szDelay =  Form.GetSharedData("REALTIME_OQ", false)
		else
			szDelay = Form.GetSharedData("REALTIME_"..szMarket, false )
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" 		, 0 , "62360" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , szDelay 	) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FIDX_INPUT_NTNL_CODE" 			, 0 , szNation 	) '국가구분
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 , szMarket 	) '마켓구분
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FID_INPUT_BLNG_CLS_CODE" 		, 0 , "0" 		) '신고(0)/신저(1)
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FID_INPUT_DATE1" 				, 0 , "1" 		) '전일
		DATAMANAGER.SetDataValue( 0, "ohhts_6236_001r" , "InBlock1", "FID_INPUT_OPTN1" 				, 0 , "0" 		) '일시돌파(0)/돌파유지(1)
			
		
		DATAMANAGER.RequestTranData("ohhts_6236_001r")
		
	end if
	
End Function
'============================================================================
Function Set_Real_Input(nIdx, szCd)
	
	DATAMANAGER.SetDataValue(1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD", nIdx, szCd)		
	
End Function

'============================================================================
Function Real_RequestData()
	
	DATAMANAGER.RequestRealData("ohhts_exst_ictg")
	
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	
	if szTranID == "ohhts_6230_002r" or szTranID =="ohhts_6236_001r" or szTranID =="ohhts_6233_001r" or szTranID == "ohhts_6242_001r" then
		
		'----------------------------
		' 데이터는 5개까지만 보여줌.
		'----------------------------
		nDataCnt = Cint(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1"))
		
		if nDataCnt > 5 then
			nDataCnt = 5
		end if
		
		if nDataCnt > 0 then
			imgNotice.visible = false
			lbNoticeMsg.visible = false
		else
			imgNotice.visible = true
			lbNoticeMsg.visible = true
		end if
		
		'----------------------------
		' 행 초기화
		'----------------------------
		Pannel0.rowcount = 0
		
		for i = 0 to nDataCnt - 1 
		
			'------------------------------------------------------------
			'행추가
			'------------------------------------------------------------
			Pannel0.AddRow()
			
			'등락컨트롤 패딩 설정(안드만)
			if g_szOsType = "1" then
				Pannel0.setPropCardCell("paddinginfo","Change0",i,"0,0,0,0")
			end if
			
			'------------------------------------------------------------
			'순위세팅
			'------------------------------------------------------------
			Pannel0.setPropCardCell("caption","lblRank",i, i+1)
			
			'------------------------------------------------------------
			'종목코드 세팅
			'------------------------------------------------------------
			sCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_ISCD" , i)
			Pannel0.SetCellValue("lblCode",i,sCode)
			
			'------------------------------------------------------------
			'마켓코드 세팅
			'------------------------------------------------------------
			sMarekt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
			Pannel0.SetCellValue("lblMarket",i,sMarekt)
			
			'------------------------------------------------------------
			'마켓코드@종목코드 세팅
			'------------------------------------------------------------
			Pannel0.SetCellValue("lblFullCode",i,sMarekt & "@" & sCode)
			
			'------------------------------------------------------------
			'종목명 세팅
			'------------------------------------------------------------
			Pannel0.setPropCardCell("fontsize","lblName",i,"-1")
			Pannel0.setPropCardCell("maxlinecnt","lblName",i,"2^-1")
			
			sName = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_KOR_ISNM", i)
			Pannel0.SetCellValue("lblName",i,sName)
			
			'------------------------------------------------------------
			'소수점 자리수 세팅
			'------------------------------------------------------------
			nDecimalLen = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_DCPN_CNT" , i)
			Pannel0.SetCellValue("lblDecimalLen",i,nDecimalLen)
			
			'------------------------------------------------------------
			'현재가 세팅
			'------------------------------------------------------------
			sPrice = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRPR" , i)
			sTransPrice = FormatNumber(sPrice,nDecimalLen)
			
			if g_szOsType == "1" then
				Pannel0.setPropCardCell("paddinginfo","lblPr",i,"0,0,3,0")
			else
				Pannel0.setPropCardCell("paddinginfo","lblPr",i,"0,0,4,0")
			end if
			
			Pannel0.SetCellValue("lblPr",i,sTransPrice)
			
			'------------------------------------------------------------
			'전일대비 세팅
			'------------------------------------------------------------
			sDebi = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRDY_VRSS" , i)
			sTransDebi = FormatNumber(sDebi,nDecimalLen)
			
			Pannel0.setPropCardCell("signpos","Change0",i,"1")
			Pannel0.setPropCardCell("caption","Change0",i,sTransDebi)
			
			'------------------------------------------------------------
			'전일대비 부호 세팅
			'------------------------------------------------------------
			sDebiBuho = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , i)
		
			Pannel0.setPropCardCell("changesign","Change0",i,sDebiBuho)
			
			'------------------------------------------------------------
			'등락률 세팅
			'------------------------------------------------------------
			sRate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRDY_CTRT" , i)
			Pannel0.setPropCardCell("paddinginfo","lblCtrt",i,"0,0,0,0")
			Pannel0.SetCellValue("lblCtrt",i,sRate)
			
			'------------------------------------------------------------
			' 등락률 글자색상 설정 && 등락률 배경이미지 세팅
			'------------------------------------------------------------
			if sDebiBuho == "1" or sDebiBuho == "2" then
				
				Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"10")
				Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1") '동일 이미지 중복세팅 방지			
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_pink.9.png")
			
			elseif sDebiBuho == "4" or sDebiBuho == "5" then
			
				Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"11")
				Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1") '동일 이미지 중복세팅 방지
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_blue.9.png")

			else
				
				Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"12")
				Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1") '동일 이미지 중복세팅 방지
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_gray.9.png")
			
			end if
			
			'------------------------------------------------------------
			'실시간 서비스 인풋값 세팅
			'------------------------------------------------------------
			Set_Real_Input(i, sMarekt&"@"&sCode)
		
		next
		
		'------------------------------------------------------------
		' 실시간 서비스 호출
		'------------------------------------------------------------
		Real_RequestData()
	
	end if
	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

	if szTranID == "ohhts_exst_ictg" then
	
		sCode = DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_ISCD" , 0)
		
		nIndex = Pannel0.FindRow("lblFullCode",sCode,0)
		
		if nIndex >= 0 then
		
			'------------------------------------------------------------
			' 소수점 자리수 가져오기
			'------------------------------------------------------------
			sDecimalLen = Pannel0.GetCellValue("lblDecimalLen",nIndex)
			
			'------------------------------------------------------------
			'현재가 세팅
			'------------------------------------------------------------
			sPrice = DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_PRPR" , 0)
			sTransPrice = FormatNumber(sPrice,sDecimalLen)
			Pannel0.SetCellValue("lblPr",nIndex,sTransPrice)
			
			'------------------------------------------------------------
			'전일대비 세팅
			'------------------------------------------------------------
			sDebi = DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_PRDY_VRSS" , 0)
			sTransDebi = FormatNumber(sDebi,sDecimalLen)
			Pannel0.setPropCardCell("signpos","Change0",nIndex,"1")
			Pannel0.setPropCardCell("caption","Change0",nIndex,sTransDebi)
			
			'------------------------------------------------------------
			'전일대비 부호 세팅
			'------------------------------------------------------------
			sDebiBuho = DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_VRSS_SIGN" , 0)
			Pannel0.setPropCardCell("changesign","Change0",nIndex,sDebiBuho)
			
			'------------------------------------------------------------
			'등락률 세팅
			'------------------------------------------------------------
			sRate = DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_RSFL_RT" , i)
			Pannel0.setPropCardCell("paddinginfo","lblCtrt",i,"0,0,0,0")
			Pannel0.SetCellValue("lblCtrt",nIndex,sRate)
			
			'------------------------------------------------------------
			' 등락률 글자색상 설정 && 등락률 배경이미지 세팅
			'------------------------------------------------------------
			if sDebiBuho == "1" or sDebiBuho == "2" then
				
				Pannel0.setPropCardCell("fgcolor","lblCtrt",nIndex,"10")		
				Pannel0.setPropCardCell("imgpath", "imgBg", nIndex, "roundbox_4r_pink.9.png")
			
			elseif sDebiBuho == "4" or sDebiBuho == "5" then
			
				Pannel0.setPropCardCell("fgcolor","lblCtrt",nIndex,"11")
				Pannel0.setPropCardCell("imgpath", "imgBg", nIndex, "roundbox_4r_blue.9.png")
				
			else
				
				Pannel0.setPropCardCell("fgcolor","lblCtrt",nIndex,"12")
				Pannel0.setPropCardCell("imgpath", "imgBg", nIndex, "roundbox_4r_gray.9.png")
			
			end if
		
		end if
		
	end if

End Sub
'============================================================================
Sub Form_OnRefresh()
	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
End Sub

'============================================================================
' 정렬조건 선택 시, [더보기] 화면으로 이동해서 띄워줘야하는 화면 설정
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	
	'-----------------------------------------------
	' 상승
	'-----------------------------------------------
	if nCurrentTab == 0 or nCurrentTab == "0" then
		gGubun = "mhtro16030_s01"
		
	'-----------------------------------------------
	' 하락
	'-----------------------------------------------
	elseif nCurrentTab == 1 or nCurrentTab == "1" then
		gGubun = "mhtro16030_s01"
	
	'-----------------------------------------------
	' 거래대금
	'-----------------------------------------------
	elseif nCurrentTab == 2 or nCurrentTab == "2" then
		gGubun = "mhtro16030_s10"
	
	'-----------------------------------------------
	' 거래량
	'-----------------------------------------------
	elseif nCurrentTab == 3 or nCurrentTab == "3" then
		gGubun = "mhtro16030_s01"
	
	'-----------------------------------------------
	' 시가총액
	'-----------------------------------------------
	elseif nCurrentTab == 4 or nCurrentTab == "4" then
		gGubun = "mhtro16030_s17"
	
	'-----------------------------------------------
	' 신고가
	'-----------------------------------------------
	elseif nCurrentTab == 5 or nCurrentTab == "5" then
		gGubun = "mhtro16030_s05"
	end if
	
	'--------------------------------------------------------------------
	'HOME_RANKING_OVRS_GUBUN : 해외주식 종목분석에서 띄워줘야하는 맵파일명
	'(mhtro16030_t01에서 사용)
	'--------------------------------------------------------------------
	Form.SetSharedData("HOME_RANKING_OVRS_GUBUN" , gGubun)

	RequestData()
	
End Sub 

'============================================================================
' 국가(시장)선택 시 
'============================================================================
Sub FormTab1_OnTabChanged(nCurrentTab)
	
	if nCurrentTab == 0 or nCurrentTab == "0" then
		gMarket = "US"
	elseif nCurrentTab == 1 or nCurrentTab == "1" then
		gMarket = "SH"
	elseif nCurrentTab == 2 or nCurrentTab == "2" then
		gMarket = "SZ"
	elseif nCurrentTab == 3 or nCurrentTab == "3" then
		gMarket = "HK" 
	elseif nCurrentTab == 4 or nCurrentTab == "4" then
		gMarket = "JP"
	end if
	
	RequestData()
	
End Sub 

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)

	'-------------------------------------------------
	' 리스트에서 종목선택 시, 현재가 화면으로 이동
	'-------------------------------------------------
	szMk = Pannel0.GetCellValue("lblMarket",nIndex)
	szItemCode = Pannel0.GetCellValue("lblCode",nIndex)
	szName = Pannel0.GetCellValue("lblName",nIndex)
	
	SetEnvDataWithMoveScr("HYUN",szMk,szItemCode,szName)
	
End Sub

'============================================================================
' 서비스 인풋값 반환
'============================================================================
Function GetNation()

	nCurNationTab = Cint(FormTab1.currenttab)
	
	if nCurNationTab == 0 then
		return "US"
	elseif nCurNationTab == 1 then
		return "CN"
	elseif nCurNationTab == 2 then
		return "CN"
	elseif nCurNationTab == 3 then
		return "HK"
	elseif nCurNationTab == 4 then
		return "JP"
	end if

End Function

'============================================================================
' 서비스 인풋값 반환
'============================================================================
Function GetMarket()

	nCurMarketTab = Cint(FormTab1.currenttab)
	
	if nCurMarketTab == 0 then
		return ""
	elseif nCurMarketTab == 1 then
		return "SH"
	elseif nCurMarketTab == 2 then
		return "SZ"
	elseif nCurMarketTab == 3 then
		return "HK"
	elseif nCurMarketTab == 4 then
		return "JP"
	end if

End Function

'============================================================================
' 서비스 인풋값 반환
'============================================================================
Function GetGubun()
	
	nGubunTab = Cint(FormTab0.currenttab)
	
	if nGubunTab == 0 then
		return "0"
	elseif nGubunTab == 1 then
		return "0"
	elseif nGubunTab == 3 then
		return "2"
	end if
	

End Function

'============================================================================
' 서비스 인풋값 반환
'============================================================================
Function GetSortCode()

	nGubunTab = Cint(FormTab0.currenttab)
	
	if nGubunTab == 0 then
		return "0"
	elseif nGubunTab == 1 then
		return "1"
	elseif nGubunTab == 3 then
		return "0"
	end if

End Function

'============================================================================
' 화면이동 시, 현재 설정 조건값 저장 후 화면 이동(백해서 다시 돌아왔을때 유지해주기 위해)
' 더보기화면으로 이동 시에는, 이동한 화면에 자동으로 세팅되어야하는 조건값을 미리 세팅해준다.
'============================================================================
Function SetEnvDataWithMoveScr(sGubun,szMk,szItemCode,szName)

	'---------------------------------------------
	' 국내/해외 선택값 저장
	'---------------------------------------------
	Form.SetSharedData("HOME_RANKING_INDEX" , "1")
	
	'---------------------------------------------
	' 국가(시장) 선택값 저장
	'---------------------------------------------
	nMarketTabIndex = Cint(FormTab1.currenttab)
	Form.SetSharedData("HOME_RANKING_OVRS_MARKET" , nMarketTabIndex)
	
	'---------------------------------------------
	' 정렬 조회조건 저장
	'---------------------------------------------
	nCondTabIndex = Cint(FormTab0.currenttab)
	Form.SetSharedData("HOME_RANKING_OVRS_COND" , nCondTabIndex)
	
	'=============================================
	' 더보기 화면 연동
	'=============================================
	if sGubun == "MORE" then
		
		'---------------------------------------------
		' 국가(시장) 코드 가져오기
		'---------------------------------------------
		sMarket = GetNation()
		
		'=============================================
		' 상승률
		'=============================================
		if nCondTabIndex == 0 then
			
			'----------------------------------------------------------
			'국가 설정
			'----------------------------------------------------------
			'중국인 경우 해외주식 종목분석 화면에서
			'상해/심천이 자동 선택되야 하므로, 추가적으로 공유변수 세팅
			'----------------------------------------------------------
			if sMarket == "CN" then
				
				if nMarketTabIndex == 1 then
					Form.SetSharedData("16030_S01_RDO1" , "0")
				else
					Form.SetSharedData("16030_S01_RDO1" , "1")
				end if
				
				Form.SetEnvData(1, "16030_S01_COMBO0", sMarket)  
				
			else
				
				Form.SetEnvData(1, "16030_S01_COMBO0", sMarket)  
				
			end if
			
			'-----------------------------------------------
			'등락(0)/거래량(2) 구분
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S01_COMBO2", "0")	
			
			'-----------------------------------------------
			'상위(0)/하위(1)
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S01_COMBO3", "0")		
		
		'=============================================
		' 하락률
		'=============================================
		elseif nCondTabIndex == 1 then
			
			'----------------------------------------------------------
			'국가 설정
			'----------------------------------------------------------
			'중국인 경우 해외주식 종목분석 화면에서
			'상해/심천이 자동 선택되야 하므로, 추가적으로 공유변수 세팅
			'----------------------------------------------------------
			if sMarket == "CN" then
				
				if nMarketTabIndex == 1 then
					Form.SetSharedData("16030_S01_RDO1" , "0")
				else
					Form.SetSharedData("16030_S01_RDO1" , "1")
				end if
				
				Form.SetEnvData(1, "16030_S01_COMBO0", sMarket)  
				
			else
				
				Form.SetEnvData(1, "16030_S01_COMBO0", sMarket)  
				
			end if
			
			'-----------------------------------------------
			'등락(0)/거래량(2) 구분
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S01_COMBO2", "0")
			
			'-----------------------------------------------
			'상위(0)/하위(1)
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S01_COMBO3", "1")		
		
		'=============================================
		' 거래대금
		'=============================================
		elseif nCondTabIndex == 2 then
		
			'----------------------------------------------------------
			'국가 설정
			'----------------------------------------------------------
			'중국인 경우 해외주식 종목분석 화면에서
			'상해/심천이 자동 선택되야 하므로, 추가적으로 공유변수 세팅
			'----------------------------------------------------------
			if sMarket == "CN" then
				
				if nMarketTabIndex == 1 then
					Form.SetSharedData("16030_S10_RDO1" , "0")
				else
					Form.SetSharedData("16030_S10_RDO1" , "1")
				end if
				
				Form.SetEnvData(1, "16030_S10_COMBO0", sMarket)  
				
			else
				
				Form.SetEnvData(1, "16030_S10_COMBO0", sMarket)  
				
			end if
			
			'-----------------------------------------------
			'기간 구분 : 당일(0)
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S10_COMBO1", "0")
		
		
		'=============================================
		' 거래량
		'=============================================
		elseif nCondTabIndex == 3 then
		
			'----------------------------------------------------------
			'국가 설정
			'----------------------------------------------------------
			'중국인 경우 해외주식 종목분석 화면에서
			'상해/심천이 자동 선택되야 하므로, 추가적으로 공유변수 세팅
			'----------------------------------------------------------
			if sMarket == "CN" then
				
				if nMarketTabIndex == 1 then
					Form.SetSharedData("16030_S01_RDO1" , "0")
				else
					Form.SetSharedData("16030_S01_RDO1" , "1")
				end if
				
				Form.SetEnvData(1, "16030_S01_COMBO0", sMarket)  
				
			else
				
				Form.SetEnvData(1, "16030_S01_COMBO0", sMarket)  
				
			end if
			
			'-----------------------------------------------
			'등락(0)/거래량(2) 구분
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S01_COMBO2", "2")	
			
			'-----------------------------------------------
			'상위(0)/하위(1)
			'-----------------------------------------------
			Form.SetEnvData(1, "16030_S01_COMBO3", "0")	
		
		
		'=============================================
		' 시가총액
		'=============================================
		elseif nCondTabIndex == 4 then
		
			'----------------------------------------------------------
			'국가 설정
			'----------------------------------------------------------
			'중국인 경우 해외주식 종목분석 화면에서
			'상해/심천이 자동 선택되야 하므로, 추가적으로 공유변수 세팅
			'----------------------------------------------------------
			if sMarket == "CN" then
				
				if nMarketTabIndex == 1 then
					Form.SetSharedData("16030_S17_RDO1" , "0")
				else
					Form.SetSharedData("16030_S17_RDO1" , "1")
				end if
				
				Form.SetEnvData(1, "16030_S17_COMBO0", sMarket)  
				
			else
				
				Form.SetEnvData(1, "16030_S17_COMBO0", sMarket)  
				
			end if
			
		'=============================================
		' 신고가
		'=============================================
		elseif nCondTabIndex == 5 then
		
			'----------------------------------------------------------
			'국가 설정
			'----------------------------------------------------------
			'중국인 경우 해외주식 종목분석 화면에서
			'상해/심천이 자동 선택되야 하므로, 추가적으로 공유변수 세팅
			'----------------------------------------------------------
			if sMarket == "CN" then
				
				if nMarketTabIndex == 1 then
					Form.SetSharedData("16030_S05_RDO1" , "0")
				else
					Form.SetSharedData("16030_S05_RDO1" , "1")
				end if
				
				Form.SetEnvData(1, "16030_S05_COMBO0", sMarket)  
				
			else
				
				Form.SetEnvData(1, "16030_S05_COMBO0", sMarket)  
				
			end if
			
			'----------------------------------------------------------
			' 신고/신저구분 (신고:0)
			'----------------------------------------------------------
			Form.SetEnvData(1, "16030_S05_COMBO1", "0")  
			
			'----------------------------------------------------------
			' 기간설정(전일:1)
			'----------------------------------------------------------
			Form.SetEnvData(1, "16030_S05_COMBO2", "0")  
			
			'----------------------------------------------------------
			' 일시돌파(0) / 돌파유지(1)
			'----------------------------------------------------------
			Form.SetEnvData(1, "16030_S05_COMBO3", "0")  
			
		
		end if
		
		
		Form.OpenScreen("16030" , "HOME")
	
	'=============================================
	' 현재가 화면 연동
	'=============================================
	elseif sGubun == "HYUN" then
	
		if szMk <> "" and szItemCode <> "" then
		
			Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
			Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
			Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
			
			etfYN = Form.GetItemCodeInfo(szMk.."@"..szItemCode, "etfyn")
			
			if etfYN == "Y" then
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
			else
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
			end if
		
		end if
		
	end if

	
End Function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'---------------------------------------
	' [더보기] 화면 이동 시
	'---------------------------------------
	if sEventName == "MOVE_MORE_SCREEN" then
		
		if sParam == "HOME" then
		
			SetEnvDataWithMoveScr("MORE","","","")
		
		end if
		
	'---------------------------------------
	' 부모화면에서 국가(시장) 변경 시
	'---------------------------------------
	elseif sEventName == "SELECT_NATION" then
	
		FormTab1.currenttab = sParam
		FormTab1_OnTabChanged(sParam)
		
	'---------------------------------------
	' 이전 설정값이 있던 경우 부모화면에서 받아옴
	'---------------------------------------
	elseif sEventName == "SEND_PREV_COND" then
	
		arrCond = Split(sParam,"★")
		
		sMarketIndex = arrCond(0)
		sCondIndex = arrCond(1)
		
		if sMarketIndex <> "" then
			
			FormTab1.currenttab = sMarketIndex
			FormTab1_OnTabChanged(sMarketIndex)
			
		end if
		
		if sCondIndex <> "" then
		
			FormTab0.currenttab = sCondIndex
			FormTab0_OnTabChanged(sCondIndex)
			
		end if
		
	'---------------------------------------
	' 부모화면 스와이프
	'---------------------------------------
	elseif sEventName = "SWIPE" then			'스와이프 탭변경
		if sParam = "NEXT" then
			btnNext()
		elseif sParam = "PREV" then
			btnPrev()
		end if
		
		
	end if
		
	
End Sub

'============================================================================
Function btnPrev()
	Dim nTab
	
	nCurTab = CInt(FormTab0.currenttab)
	if nCurTab == 0 then
		nTab = 0		
	else
		nTab = nCurTab - 1		
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Function

'============================================================================
Function btnNext()
	Dim nTab
	
	nCurTab = CInt(FormTab0.currenttab)
	nTabCnt = CInt(FormTab0.tabcount)
	
	if nCurTab == nTabCnt then
		nTab = nTabCnt		
	else
		nTab = nCurTab + 1		
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Function

