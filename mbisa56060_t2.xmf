'============================================================================
'MP설명서_내용보기
Sub cont0_btnDetail3_OnClick()
	Dim nType
	Dim urlStr, titleStr, lnkData
	Dim fielStr
	
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		urlStr = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	elseif nType == "1" then
		urlStr = "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/"
	end if
	
	If g_nMPIdx < 0 then
		Form.ShowAlert("알림", "상품(MP)을 선택해주세요.")
		cont0.chk3.checkstate = "0"
		Exit Sub
	End If
	
	cont0.chk3.checkstate = "1"
	g_sClickTime2 = Form.GetSharedData("&HOST_TIME", True )	'클릭시각
	
	Select Case g_nMPIdx
		Case 0
			fielStr = "meritz_isa_mp_itrstIncmDoc"
		Case 1
			fielStr = "meritz_isa_mp_sftyAimADoc_A"
		Case 2
			fielStr = "meritz_isa_mp_sftyAimADoc_B"
		Case 3
			fielStr = "nuratyTypeADoc_A"
		Case 4
			fielStr = "nuratyTypeBDoc_B"
		Case 5
			fielStr = "meritz_isa_mp_grthAimADoc_A"
		Case 6
			fielStr = "meritz_isa_mp_grthAimADoc_B"
		Case 7
			fielStr = "meritz_isa_mp_hgtIncmAimADoc_A"
		Case 8
			fielStr = "meritz_isa_mp_hgtIncmAimADoc_B"
	End Select
	
	titleStr = "MP설명서"
	lnkData = urlStr .. fielStr .. ".pdf" .. "|" .. titleStr
	Form.OpenPopup("mbisa56060_pg", lnkData, "")

End Sub

