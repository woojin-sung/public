'============================================================================
Function ValidateCheck()
	If cont0.tbl0.GetCellString( 0 , 0 ) == "" then
		Form.ShowAlert("알림", "적용가능한 투자성향 진단이 없습니다. ISA 투자성향진단을 등록해주세요.[권유불원, 정보미제공 고객 일임형 상품 가입 불가]")
		return False
	End If
	
	If cont0.tbl1.GetCellString( 0 , 0 ) == "" then
		Form.ShowAlert("알림", "상품(MP)을 선택해주세요.")
		return False
	End If
	
	If cont0.chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "ISA 계약권유문서를 확인해주세요.")
		return False
	End If
	
	If cont0.chk2.checkstate <> "1" then
		Form.ShowAlert("알림", "개인종합자산관리계좌(일임형)약관을 확인해주세요.")
		return False
	End If
	
	If cont0.chk3.checkstate <> "1" then
		Form.ShowAlert("알림", "MP설명서를 확인해주세요.")
		return False
	End If
	
	If cont0.chk4.checkstate <> "1" then
		Form.ShowAlert("알림", "투자 유의사항을 확인해주세요.")
		return False
	End If
	
	If cont0.chk4.checkstate <> "1" then
		Form.ShowAlert("알림", "금융소비자의 권리를 확인해주세요.")
		return False
	End If
	
	
	return True
End Function

'============================================================================
'투자성향진단 & 상품(MP) 비교
Function CheckInvestType()

	Dim sGrade, nLimit
	
	sGrade = cont0.lblGrade.caption	'투자성향진단 등급

	If sGrade <> "" and cont0.lblMPCode.caption <> "" then
	
		Select Case sGrade
			Case "00"         '0 : 전문투자자(정보미제공)
				nLimit = 8    
			Case "01"		'1 : 고수익지향형    매우높은위험
				nLimit = 8
			Case "02"		'2 : 성장지향형      높은위험 / 다소높은위험
				nLimit = 6
			Case "03"		'3 : 중립형          보통위험
				nLimit = 4
			Case "04"		'4 : 안정지향형      낮은위험
				nLimit = 2
			Case "05"		'5 : 이자소득형      매우낮은위험
				nLimit = 0
		End Select
		
		'v002 전문투자자의 경우 모든 상품 투자 가능
		if g_sKycInvtSpclInvrYn = "Y" then
			nLimit = 8    
		end if
		
'		g_nMPIdx : 상품(MP) 선택 라디오 인덱스
'		0 : 메리츠 ISA 이자소득형A    매우낮은위험
'		1 : 메리츠 ISA 안정지향형A    낮은위험
'		2 : 메리츠 ISA 안정지향형B    낮은위험
'		3 : 메리츠 ISA 중립형A        보통위험
'		4 : 메리츠 ISA 중립형B        보통위험
'		5 : 메리츠 ISA 성장지향형A    다소높은위험
'		6 : 메리츠 ISA 성장지향형B    다소높은위험
'		7 : 메리츠 ISA 고수익지향형A  매우높은위험
'		8 : 메리츠 ISA 고수익지향형B  매우높은위험

		If nLimit < g_nMPIdx then
			Form.ShowAlert("알림", "고객등급 < 상품등급일 경우 가입이 불가합니다.")
			return False
		End If
	End If
	
	return True
End Function


' 투자원금보존여부 확인
'============================================================================
Sub CheckPrincipalPreserv()
	'mbonl81010_p1(고객투자성향진단_공통프로세스팝업) 화면 로직 사용
	Form.OpenPopup( "mbisa56060_pd" , "" , "")
End Sub

'============================================================================
Sub MoveNextPage()
	Dim sSendData

	'추후 유지보수 중 항목 추가 발생할 경우에 대비, 각 화면마다 array 20개씩 잡아놓음
	
	'20210312_01 HSZ START : ISA계좌개설 개선
	sSendData = cont0.tbl0.GetCellString(0, 0) & "★" 
	'sSendData = g_sSendData & tbl0.GetCellString(0, 0) & "★" 
	'20210312_01 HSZ END
	
	sSendData = sSendData & cont0.lblMPCode.caption & "★"
	sSendData = sSendData & cont0.tbl1.GetCellString(0, 0) & "★"
'	sSendData = sSendData & cmbPaper.cbkeydata & "★"		'서류제출방법 첫페이지로 이동
'	sSendData = sSendData & cmbPaper.caption & "★"
	sSendData = sSendData & g_sFNPR_JOIN_SRNO & "★" '20220315 아이티젠 김성수 수정
	sSendData = sSendData & "★"
	sSendData = sSendData & g_sAmt & "★"
	sSendData = sSendData & g_sClickTime0 & "★"
	sSendData = sSendData & g_sClickTime1 & "★"
	sSendData = sSendData & g_sClickTime2 & "★"
	sSendData = sSendData & cont0.lblGrade.caption & "★"
	sSendData = sSendData & g_sMPChange & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	
	prevList = g_szList(0)
	For i = 1 to 17
		prevList = prevList & "★" & g_szList(i)
	Next
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	'20210312_01 HSZ START : ISA계좌개설 개선
'	Form.SetSharedData("56060_STEP_LINK", g_sSendData & sSendData )
	if nFlag = 1 then
		Form.SetSharedData("56060_STEP_LINK", prevList & sSendData)
	else
		Form.SetSharedData("56060_STEP_LINK", g_sSendData & sSendData )
	end if
	'20210312_01 HSZ END
	
	'=====================================================================================
	'20210312_01 HSZ START : ISA계좌개설 개선 (서비스사용으로 대체필요)
	'=====================================================================================
	sSaveExt1 = cont0.chk0.checkstate & "★" & cont0.chk3.checkstate & "★" & cont0.chk2.checkstate & "★" & cont0.chk1.checkstate

	Form.SetSharedData("56060_STEP_LINK_ETC2" ,sSaveExt1)

	
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_068a", "InBlock1", "ACNO" , 0 , g_szList(0)	)	'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_068a", "InBlock1", "ASNO" , 0 , g_szList(1)	)	'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_068a", "InBlock1", "APLT_DATE" , 0 , Form.GetSharedData("&HOST_DATE" , false)	)	'신청일자
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_068a", "InBlock1", "PWD" , 0 , g_szList(2)	)	'비밀번호
	
	'필수정보(기존유지)
'	Form.SaveConfigData("56060_STEP_LINK", "STEP2", sSendData)
'	DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "EXIN_TLMS_CNTT", 0 , g_sSendData & sSendData )
	if nFlag = 1 then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "EXIN_TLMS_CNTT", 0 , prevList & sSendData)
	else
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "EXIN_TLMS_CNTT", 0 , g_sSendData & sSendData )
	end if
	'"ANTC_PNSN_RECV_CNTT1" 	, 0 , sSendData )
	
	'단계정보
'	Form.SaveConfigData("56060_STEP_LINK", "STEP_FINAL", "2") '2단계완료	
	DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "REG_STAG_CLS_CODE" 	, 0 , "2")
	
	'부가정보1
'	Form.SaveConfigData("56060_STEP_LINK", "STEP2_1", sSaveExt1)
	DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "APLT_SVC_INFO_CNTT2" 	, 0 , sSaveExt1)
	
	'앞단계 정보
	DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "APLT_SVC_INFO_CNTT" 	, 0 , g_sReceiveExt0)
	DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "APLT_SVC_INFO_CNTT1" 	, 0 , g_sReceiveExt1)
	
	DATAMANAGER.RequestTranData("obwat_ctad_068a")
	'=====================================================================================
	'20210312_01 HSZ END	
	'=====================================================================================

	Form.triggerEvent("#", "OPEN_NEXT", "2")
End Sub

'============================================================================
Sub LoadLinkData()
	cont0.btnOK.enable = True
	
	g_sSendData = Form.GetSharedData("56060_STEP_LINK", True)
	
	g_szList = Split(g_sSendData,"★")	
	'20210312_01 HSZ START : ISA계좌개설 개선
	 g_sReceiveExt0 = Form.GetSharedData("56060_STEP_LINK_ETC" , false)
	 g_sReceiveExt1 = Form.GetSharedData("56060_STEP_LINK_ETC1", false)
	'20210312_01 HSZ END
	if UBOUND(g_szList) < 1 then
		Exit Sub
	'21.09.08 JHY START (v001)
	'투자성향진단 시도 가능 횟수 조회
	else
		DATAMANAGER.RequestTranData( "obcsb_acif_701r" )
	'21.09.08 JHY END
	End if
End Sub
	
