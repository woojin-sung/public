'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "Change_Invest_Type" and sValue == "refresh" then
		DATAMANAGER.RequestTranData( "obcsb_acif_701r_1" )
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obaci_acct_089r" trcode="obaci_acct_089r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="BSWR_PROS_CLS_CODE" idx="0" defconst="1" />
					<FIELD name="PRCD" idx="2" defconst="133" />
					<FIELD name="TXCM_TRPR_CLS_CODE" idx="5" defconst="0" />
				</TRBLOCK>
			</TRAN>
			<TRAN tranid="obaci_acct_089r_1" trcode="obaci_acct_089r" compress="1" encryption="1" inputcheck="1" useattr="0" >
