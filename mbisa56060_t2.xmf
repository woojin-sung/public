	'Form.OpenFramePopup("mbonl81010_s1" , g_szList(0) & "★" &  g_szList(2), sPosInfo) '21.09.07 JHY START (v001)
	
	Form.OpenFramePopup("mbonl81010" , "" , sPosInfo)
	'Form.OpenScreen("81010", "")
End Sub

