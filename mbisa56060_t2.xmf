'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'Form.ShowAlert(sKeyName, sRet)
	
	'상품(MP) 선택
	If sKeyName == "mbisa56060_p6" and sRet <> "" then
		g_nMPIdx = CDbl(sRet)

	    'v0003
		Dim sMPText, sMPCode, sMPGrade
		Dim sProdGrad
		
		Call ClearNextStep("2")	'상품선택 변경시 ISA계약필수문서 확인 초기화
		
		Select Case sRet
			Case "0"
				sMPText = "메리츠 ISA 이자소득형A"
				sMPCode = "WA000101"
				sMPGrade = "icon_investmentrisk_case1_6.png"
				sProdGrad = "06"
				sImgCnt = 5
			Case "1"
				sMPText = "메리츠 ISA 안정지향형A"
				sMPCode = "WA000102"
				sMPGrade = "icon_investmentrisk_case1_5.png"
				sProdGrad = "05"
				sImgCnt = 5
			Case "2"
				sMPText = "메리츠 ISA 안정지향형B"
				sMPCode = "WA000103"
				sMPGrade = "icon_investmentrisk_case1_5.png"
				sProdGrad = "05"
				sImgCnt = 5
			Case "3"
				sMPText = "메리츠 ISA 중립형A"
				sMPCode = "WA000104"
				sMPGrade = "icon_investmentrisk_case1_4.png"
				sProdGrad = "04"
				sImgCnt = 5
			Case "4"
				sMPText = "메리츠 ISA 중립형B"
				sMPCode = "WA000105"
				sMPGrade = "icon_investmentrisk_case1_4.png"
				sProdGrad = "04"
				sImgCnt = 5
			Case "5"
				sMPText = "메리츠 ISA 성장지향형A"
				sMPCode = "WA000106"
				sMPGrade = "icon_investmentrisk_case1_3.png"
				sProdGrad = "03"
				sImgCnt = 6
			Case "6"
				sMPText = "메리츠 ISA 성장지향형B"
				sMPCode = "WA000107"
				sMPGrade = "icon_investmentrisk_case1_3.png"
				sProdGrad = "03"
				sImgCnt = 6
			Case "7"
				sMPText = "메리츠 ISA 고수익지향형A"
				sMPCode = "WA000108"
				sMPGrade = "icon_investmentrisk_case1_1.png"
				sProdGrad = "01"
				sImgCnt = 6
			Case "8"
				sMPText = "메리츠 ISA 고수익지향형B"
				sMPCode = "WA000109"
				sMPGrade = "icon_investmentrisk_case1_1.png"
				sProdGrad = "01"
				sImgCnt = 6
		End Select
		
		Call SetIconImage(sImgCnt)
		cont0.lblMPCode.caption = sMPCode
		cont0.ImageMPGrade.imgpath = sMPGrade
		cont0.tbl1.SetCellString(0, 0, sMPText)
		g_sMPChange = "1"
		
		' 상품선택이 완료된 경우 비교값 전달
		Form.SetSharedData("FNP51000_P8_ACC_NO" , g_szList(0))		'계좌번호
		Form.SetSharedData("FNP51000_P8_PROD" , sProdGrad)		'상품등급
		Form.OpenPopup("mbfnp51000_p8" , "" , "")
	
	End If
	
	
	'ISA 계좌개설 투자성향진단
	If sKeyName == "mbisa56060_pb" then
		If Trim(sRet) <> "" then
			cont0.chk0.checkstate = "1"
			cont0.lblGrade.caption = Left(sRet, 2)	'등급(계약자 확인사항 팝업에서 사용)
			cont0.tbl0.SetCellString( 0, 0, Right(sRet, Len(sRet)-2 ))
			
'			투자성향진단 선택시 상품선택 가능
			g_bMPSelect = True
		Else
			cont0.chk0.checkstate = "0"
			cont0.lblGrade.caption = ""
			cont0.tbl0.SetCellString( 0, 0, "")
		End If
		
		'투자성향진단 변경시 상품선택 클리어
		cont0.tbl1.SetCellString( 0, 0, "")
		cont0.lblMPCode.caption = ""
	End If
	
	
	'v0003
	'변경투자성향진단
	if sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			'확인인경우
		elseif sRet == "CANCEL_mbonl81010_p20" then
			'취소인경우
		end if
	end if
	
	'투자자성향, 상품위험등급 비교결과
	if sKeyName == "mbfnp51000_p8" then
		if sRet == "NEXT_mbfnp51000_p8" then
			'확인인경우
		elseif sRet == "CANCEL" then
			'취소인경우
			g_nMPIdx = -1
			cont0.lblMPCode.caption = ""
			cont0.ImageMPGrade.imgpath = "icon_investmentrisk_case1_1.png"
			cont0.tbl1.SetCellString(0, 0, "")
		elseif  sRet == "MOVE" then
			Form.triggerEvent("#", "MOVE_81010", "0")
		end if
	end if
	
	'투자자금 원금보존 확인
	If sKeyName == "mbisa56060_pd" then
		cont0.btnOK.enable = True
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ACNO", 0, g_szList(0))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ASNO", 0, g_szList(1))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_SRNO", 0, g_sFNPR_JOIN_SRNO) '금융상품가입일련번호
		DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")'금융상품가입세부일련번호(00001 고정)

		'예
		if sRet = "ok" then							
			'예 선택시 이자소득형/안정지향형이 아닌 경우 Alert
			If g_nMPIdx > 2 then
				Form.ShowAlert("알림", "원금보존 추구 투자자금인 경우, 이자소득형과 안정지향형만 선택 가능합니다.")
				Exit Sub
			End If
			
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN" , 0, "Y")
			DATAMANAGER.RequestTranData("obcsb_acif_792a")	'투자자금 원금보존여부 등록
		
		'아니오
		elseif sRet = "no" then						
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN", 0, "N")
			DATAMANAGER.RequestTranData("obcsb_acif_792a")	'투자자금 원금보존여부 등록
		end if
	End If
	
	
	If sKeyName == "mbisa56060_p2" then
		If sRet == "ok" then
			Form.SendReturnToParent( "mbisa56060_p1" , "ok" )
			Form.CloseForm()
		End If
	End If
	
	
	'21.09.07 JHY START (v001)
	'기존 SendReturnToParent에 담는 값 있어서 변경하지 않고 shared 값으로 등급이랑 등급한글명 가져오도록
	'( mbonl81010_s1 에서 712a 등록 완료후 sRet "1"로 변경 하므로 sRet "1" 일때만 등급 보여주고, 투자성향진단 체크 표시 해주도록 )
	if sKeyName == "TYPECHK_OK" then
		'투자성향 진단 등록 완료시
		if sRet == "1" then
			cont0.chk0.checkstate = "1"
			
			' 등록 가능 횟수때문에 여기서 701r 조회하므로,  shared 저장하는것 주석하고 서비스로 조회하도록
			isWriteGrade = true
			DATAMANAGER.RequestTranData( "obcsb_acif_701r" )
			
'			Dim szGrade, szGradeKorean
'			szGrade			= Form.GetSharedData("mbonl81010_s1_grade" , true)
'			szGradeKorean		= Form.GetSharedData("mbonl81010_s1_grade_korean" , true)
'
'			lblGrade.caption = szGrade' 등급
'			tbl0.SetCellString(0, 0, szGradeKorean) ' 등급 한글명
			
			'투자성향진단 선택시 상품선택 가능
			g_bMPSelect = True
			
		else
			cont0.chk0.checkstate = "0"
			cont0.lblGrade.caption = ""
			cont0.tbl0.SetCellString( 0, 0, "")
		end if
		
		'투자성향진단 변경시 상품선택 클리어
		cont0.tbl1.SetCellString( 0, 0, "")
		cont0.lblMPCode.caption = ""
	end if
	'21.09.07 JHY END
	
	'투자유의사항 팝업 리턴
	If sKeyName == "mbisa56060_pe" and sRet <> "" then
		If sRet == "AGREE" then
			cont0.chk4.checkstate = "1"
		elseif sRet == "CANCEL" then
			cont0.chk4.checkstate = "1"
		End If
	end if
	
	'금융소비자의권리 팝업 리턴
	If sKeyName == "mbisa56060_pf" and sRet <> "" then
		If sRet == "AGREE" then
			cont0.chk5.checkstate = "1"
		elseif sRet == "CANCEL" then
			cont0.chk5.checkstate = "1"
		End If
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'안드로이드는 num, 아이폰은 string으로 받음
	If sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	End If
	
	If sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent( 1, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	End If
	
	If sTimerID == 2 or sTimerID == "2" then
		Form.SetTimerEvent( 2, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	End If
	
	If sTimerID == 3 or sTimerID == "3" then
		Form.SetTimerEvent( 3, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
	End If
End Sub

