'다음 버튼
Sub cont0_btnOK_OnClick()
	cont0.btnOK.enable = False
	
	If ValidateCheck() == False then
		cont0.btnOK.enable = True
		Exit Sub
	End If
		
	'투자성향진단 & 상품(MP) 비교
	If CheckInvestType() == False then
		cont0.btnOK.enable = True
		Exit Sub
	End If
	
	g_sFNPR_JOIN_SRNO = Form.GetSharedData( "FNPR_JOIN_SRNO", false )
	DATAMANAGER.RequestTranData("obaci_acct_089r")	'은행연합회 한도금액 조회
'	DATAMANAGER.RequestTranData( "obsap_acif_999a" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" , 0 , g_szList(4))	'은행연합회 상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))			'계좌번호
	End If
	
	If szTranID == "obwat_ctad_010r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))			'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , g_szList(1))			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , cont0.lblMPCode.caption)	'랩어카운트상품코드	
	End If
	
	if szTranID = "obwat_ctad_069r" then
		n_acno = Form.GetSharedData("ISA_ACNO_SEND", 0 )
		n_asno = Form.GetSharedData("ISA_ASNO_SEND", 0 )
		n_pwd = Form.GetSharedData("ISA_PWD_SEND", 0 )
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_069r", "InBlock1", "ACNO" , 0 , n_acno	)	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_069r", "InBlock1", "ASNO" , 0 , n_asno	)	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_069r", "InBlock1", "APLT_DATE" , 0 , Form.GetSharedData("&HOST_DATE" , false)	)	'신청일자
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_069r", "InBlock1", "PWD" , 0 ,n_pwd	)	'비밀번호
		
		
	End if
	
	'21.09.08 JHY START (v001)
	if szTranID == "obcsb_acif_701r" then
		DATAMANAGER.SetDataValue(0, szTranID,  "InBlock1", "ACNO", 0, g_szList(0)) '계좌번호
	end if
	'21.09.08 JHY END
	
	if szTranID == "obcsb_acif_701r_1" then
		DATAMANAGER.SetDataValue(0, szTranID,  "InBlock1", "ACNO", 0, g_szList(0)) '계좌번호
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'Form.ShowAlert("DATAMANAGER_OnReceiveTranComplete", "["..szTranID.."]")
	'-----------------------------------------------------------------
	'은행연합회 한도금액 조회
	'-----------------------------------------------------------------
	Dim sCode, sOutput
	
	'PROS_CLS_CODE가 '1'이면 1초에 한번 총 5회 OutBlock1.LNKD_TLMS_MNNO를 INPUT으로 하여 다시 전송한다.
	'PROS_CLS_CODE가 '2'로 정상응답을 수신하면 재전송 중단
	If szTranID == "obaci_acct_089r" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)

		If sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_1", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 0, 1, 1 )
		End If
	End If
	
	If szTranID == "obaci_acct_089r_1" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)

		If sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_2", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 1, 1, 1 )
		End If
	End If
	
	If szTranID == "obaci_acct_089r_2" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
			
		If sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_3", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 2, 1, 1 )	
		End If
	End If
	
	If szTranID == "obaci_acct_089r_3" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)

		If sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_4", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 3, 1, 1 )	
		End If
	End If
	
	If szTranID == "obaci_acct_089r_4" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
			
		If sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		Else
			cont0.btnOK.enable = True
			Form.ShowAlert("알림", "은행연합회 한도조회에 실패하였습니다.")
			Exit Sub
		End If
	End If

	'-----------------------------------------------------------------
	'투자자금 원금보존여부 등록
	'-----------------------------------------------------------------
	If szTranID == "obcsb_acif_792a" then
		isKycGrade = false
		DATAMANAGER.RequestTranData("obwat_ctad_010r")	'KYC고객등급상품등급비교
	End If
	
	'-----------------------------------------------------------------
	'KYC고객등급상품등급비교
	'-----------------------------------------------------------------
	If szTranID == "obwat_ctad_010r" then
		If isKycGrade == true Then
			szGrade = Trim(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WA_KYC_GRAD_CODE" , 0))
			szGradeKorean = Form.GetMetaData("KYC투자성향등급코드", szGrade)
		
			cont0.lblGrade.caption = szGrade
			cont0.tbl0.SetCellString( 0, 0, szGradeKorean )
			If Len(szGradeKorean) > 0 Then
				cont0.chk0.checkstate = "1"
				g_bMPSelect = True
			End If
			isKycGrade = false
		Else
			If DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "JOIN_ABLE_YN" , 0) <> "Y" then
				cont0.btnOK.enable = True
				Form.ShowAlert("알림", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DEAL_PRHB_CNTT" , 0))
				Exit Sub
			Else
				Call MoveNextPage()
			End If
		End If
	End If
	'-----------------------------------------------------------------
	'20210312_01 HSZ ISA 계좌개설 이어가기
	'-----------------------------------------------------------------
	if szTranID = "obwat_ctad_069r" then
	
		g_sReceiveExt0  = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT" , 0)
		g_sReceiveExt1  = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT1" , 0)
	
		g_sReceiveData2  =  DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "EXIN_TLMS_CNTT", 0)
		g_sReceiveExt2 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT2" , 0) 
		
		Call DataSetting()
	end if
	
	'21.09.08 JHY START (v001)
	'등록 가능 횟수 초과하면 얼럿 뜨의고 투자 성향 진단 버튼 및 체크 버튼, 내용 초기화 및 비활성화
	if szTranID == "obcsb_acif_701r" then
		Dim szGrade, szGradeKorean
		szGrade = Trim(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ENTT_IVIC_GRCD" , 0))
		szGradeKorean = Form.GetMetaData("KYC투자성향등급코드", szGrade)
		g_sKycInvtSpclInvrYn = Trim(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "KYC_SPCL_INVR_YN" , 0))'v002 전문투자자여부
		
		' 등급을 보여주기 위한 조회일 경우
		if isWriteGrade == true then
			cont0.lblGrade.caption = szGrade
			cont0.tbl0.SetCellString( 0, 0, szGradeKorean )
			
			isWriteGrade = false
			
			' 당일 투자성향, 최근1년 투자성향 포함하여 재조회
			isKycGrade = true
			DATAMANAGER.RequestTranData( "obwat_ctad_010r" )
		' 등록 가능 횟수를 위한 조회일 경우
		else
'			Dim nTryCnt
'			nTryCnt = CDbl(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "KYC_ACMP_TMNU" , 0))
'			
'			if CDbl(nTryCnt) >= 4 then
'				Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다")
'	
'				cont0.btnDetail0.enable = false
'				cont0.chk0.enable = false
'				cont0.btnOK.enable = false
'				
'				cont0.chk0.checkstate = "0"
'				cont0.lblGrade.caption = ""
'				cont0.tbl0.SetCellString( 0, 0, "" )
'			end if
		end if
	end if
	'21.09.08 JHY END
	
	if szTranID == "obcsb_acif_701r_1" then
		Dim szGrade, szGradeKorean
		szGrade = Trim(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ENTT_IVIC_GRCD" , 0))
		szGradeKorean = Form.GetMetaData("KYC투자성향등급코드", szGrade)
		g_sKycInvtSpclInvrYn = Trim(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "KYC_SPCL_INVR_YN" , 0))'v002 전문투자자여부
		cont0.lblGrade.caption = szGrade
		cont0.tbl0.SetCellString( 0, 0, szGradeKorean )
		isKycGrade = true
		DATAMANAGER.RequestTranData( "obwat_ctad_010r" )	
	end if
	
	'-----------------------------------------------------------------
	'20220315 아이티젠 김성수 금융상품일련번호 조회 추가
	'-----------------------------------------------------------------
'	If szTranID == "obsap_acif_999a" then
'		g_sFNPR_JOIN_SRNO = Trim(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "FNPR_JOIN_SRNO" , 0))'금융상품일련번호
'		DATAMANAGER.RequestTranData("obaci_acct_089r")	'은행연합회 한도금액 조회
'	End if
End Sub

