'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'sGubn = "1" : 투자성향진단 변경시 상품선택/ISA계약필수문서 확인 초기화
'sGubn = "2" : 상품선택 변경시 ISA계약필수문서 확인 초기화
Sub ClearNextStep(sGubn)
	If sGubn == "1" then
		cont0.tbl1.SetCellString( 0, 0, "" )
		cont0.lblMPCode.caption = ""
	End If
	
'	chk1.checkstate = "0"
'	chk2.checkstate = "0"
	cont0.chk3.checkstate = "0"

End Sub

