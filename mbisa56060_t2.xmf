'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call LoadLinkData()
	isKycGrade = true
	
	' 이어가기시 오류 방지
	if g_szList <> null and g_szList <> "" then
		if g_szList(0) <> null and g_szList(0) <> "" then
			DATAMANAGER.RequestTranData( "obwat_ctad_010r" )
		end if
	end if
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'STEP1의 계좌번호 변경시 Data Clear
	If sEventName == "CLEAR_DATA" Then
		cont0.chk0.checkstate = "0"
		cont0.lblGrade.caption = ""
		cont0.tbl0.SetCellString( 0, 0, "" )
		
		cont0.tbl1.SetCellString( 0, 0, "" )
		cont0.lblMPCode.caption = ""
			
		cont0.chk1.checkstate = "0"
		cont0.chk2.checkstate = "0"
		cont0.chk3.checkstate = "0"	
		cont0.chk4.checkstate = "0"	
		cont0.chk5.checkstate = "0"	
		
		g_sClickTime0 = ""
		g_sClickTime0 = ""
		g_sClickTime0 = ""
		g_sAmt = ""		
		g_bMPSelect = False
		g_nMPIdx = -1
	End If
	
	'[입력데이터 재로드]
	'다음 버튼 클릭시 SetSharedData한 후, 다음 화면 Form_OnFormInit에서 GetSharedData 하는데,
	'입력내용 유지 위해 폼 변환시 Unload를 하지 않으므로, 
	'이전 화면으로 돌아가 데이터 변경 후 다음 버튼 클릭시, Form_OnFormInit을 타지 않음 
	'-> Trigger로 GetSharedData 재호출
	If sEventName == "RELOAD_DATA" Then
		Call LoadLinkData()
	End If
	
	'Step3에서 이전버튼으로 이동시 MP선택 변경 여부 초기화
	If sEventName == "INIT_MPCHANGE" Then
		g_sMPChange = "0"		
	End If
	'=====================================================================================
	'20210312_01 HSZ START : ISA계좌개설 개선
	'=====================================================================================
	If sEventName = "OPEN_PREV" then
		nFlag = 1
		DATAMANAGER.RequestTranData("obwat_ctad_069r")
'		LoadLinkData()	
	End If

	'=====================================================================================
	'20210312_01 HSZ END	
	'=====================================================================================	
End Sub
'============================================================================
'20210312_01 HSZ START : 이어가기 데이터 세팅 함수
'============================================================================
Function DataSetting()
	szList		= Split(g_sReceiveData2,"★") '필수정보(기존유지)
	szListExt1	= Split(g_sReceiveExt2,"★") '부가정보1

	if UBOUND(szList) > 0 then
		'원래 공유 링크변수에 값 셋팅해줘야 함
		Form.SetSharedData("56060_STEP_LINK", g_sReceiveData2 )
		
		Form.SetSharedData("56060_STEP_LINK_ETC" , g_sReceiveExt0)
		Form.SetSharedData("56060_STEP_LINK_ETC1", g_sReceiveExt1)
		Form.SetSharedData("56060_STEP_LINK_ETC2", g_sReceiveExt2)
		
		LoadLinkData() 
		'-------------------------------------------------------------------
		'(유형1) UI 강제셋팅
		'-------------------------------------------------------------------
		if UBOUND(szListExt1) > 0 then
			cont0.chk0.checkstate = szListExt1(0)
			cont0.chk3.checkstate = szListExt1(1)
			cont0.chk2.checkstate = szListExt1(2)
			cont0.chk1.checkstate = szListExt1(3)
			
			cont0.chk4.checkstate = szListExt1(3)
			cont0.chk5.checkstate = szListExt1(3)
		End if
			
		'-------------------------------------------------------------------
		'(유형2) Saved Data -> UI & Variable 셋팅
		'-------------------------------------------------------------------
		cont0.tbl0.SetCellString(0, 0, szList(20))		
		cont0.lblMPCode.caption	= szList(21)
		cont0.tbl1.SetCellString(0, 0, szList(22))
		g_bMPSelect = True
		sRet = szList(22)
		
		Select Case sRet
		Case "메리츠 ISA 이자소득형A"
			g_nMPIdx = 0
		Case "메리츠 ISA 안정지향형A"
			g_nMPIdx = 1
		Case "메리츠 ISA 안정지향형B"
			g_nMPIdx = 2
		Case "메리츠 ISA 중립형A"
			g_nMPIdx = 3
		Case "메리츠 ISA 중립형B"
			g_nMPIdx = 4
		Case "메리츠 ISA 성장지향형A"
			g_nMPIdx = 5
		Case "메리츠 ISA 성장지향형B"
			g_nMPIdx = 6
		Case "메리츠 ISA 고수익지향형A"
			g_nMPIdx = 7
		Case "메리츠 ISA 고수익지향형B"
			g_nMPIdx = 8
		end select
		
		g_sAmt 			= szList(25)
		g_sClickTime0 	= szList(26)
		g_sClickTime1 	= szList(27)
		g_sClickTime2 	= szList(28)
		cont0.lblGrade.caption 	= szList(29)
		g_sMPChange 		= szList(30)
		
	else
		LoadLinkData()
	End if
	
End Function


