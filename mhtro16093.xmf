Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtro_oder_813r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					 , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					 , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_STA_DATE" 			 , 0 , Calendar0.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_FIN_DATE" 			 , 0 , Calendar1.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_BYOV_CLCD" 			, 0 , cmbTradeType.cbkeydata)	
	elseif szTranID == "obtro_oder_810r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					 , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					 , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_STA_DATE" 			 , 0 , Calendar0.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_FIN_DATE" 			 , 0 , Calendar1.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_BYOV_CLCD" 			, 0 , cmbTradeType.cbkeydata)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNCL_YN" 				, 0 , "N")	
	elseif szTranID == "obtro_oder_814r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					 , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					 , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_STA_DATE" 			 , 0 , Calendar0.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_FIN_DATE" 			 , 0 , Calendar1.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_BYOV_CLCD" 			, 0 , cmbTradeType.cbkeydata)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNCL_YN" 				, 0 , "%")	
	elseif szTranID == "obtro_oder_815r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					 , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					 , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_STA_DATE" 			 , 0 , Calendar0.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_FIN_DATE" 			 , 0 , Calendar1.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_BYOV_CLCD" 			 , 0 , cmbTradeType.cbkeydata)	
	end if
