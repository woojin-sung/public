'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_oder_813r" or szTranID == "obtro_oder_810r" or szTranID == "obtro_oder_815r" or szTranID == "obtro_oder_814r" then
		dim nDataCnt '데이터 카운트
		nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		if nDataCnt > 0 then
			lblNoData.visible = false
			f_SetGridData(nDataCnt)
		else
			lblNoData.visible = true'데이터 없는 문구 표시
		end if
	elseif szTranID == "obtro_oder_802a" then
		Form.MsgBox("알림", "소수점 주문이 취소 되었습니다.", "", 0)
		f_RequestTR()
	end if
End Sub

