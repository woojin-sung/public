'============================================================================
Sub contAll_grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cancel" then
		dim sState
		sState = contAll.grid0.GetCellData( "bd_typeimg", lRow )
		if sState == "접수중" then
			dim sSendData, szAcnt, szOdrType, szCode, szName
			'취소 진행 시 가지고 있어야 할 데이터
			g_szOrdDate = contAll.grid0.GetCellData("bd_date", lRow)
			g_szOrdSrno = contAll.grid0.GetCellData("bd_odersrno", lRow)
			'취소 확인 팝업 전달 데이터
			szAcnt = acnt0.caption
			szOdrType = contAll.grid0.GetCellData("bd_tradetp", lRow)
			szCode = contAll.grid0.GetCellData("bd_uicode", lRow)
			szName = contAll.grid0.GetCellData("bd_itemnm", lRow)
			sSendData = "1|"& szAcnt &"|"& szOdrType &"|"& szCode &"|"& szName
			'취소확인팝업
			Form.OpenPopupAnimation("mhtro16090_p7", sSendData&"★"&"", "", "2")
		elseif sState == "체결완료" then
			dim szCode, szName, szOrdType, szOrdAmt, szQty, szPrc, szAmt, szFee, szDate
			szCode 		= contAll.grid0.GetCellData("bd_itemcd"	, lRow)
			szName 		= contAll.grid0.GetCellData("bd_itemnm"	, lRow)
			szOrdType 	= contAll.grid0.GetCellData("bd_tradetp"	, lRow)
			szOrdAmt 	= contAll.grid0.GetCellData("bd_ordprc"	, lRow)
			szCheQty 	= contAll.grid0.GetCellData("bd_cheqty"	, lRow)
			szPrc 		= contAll.grid0.GetCellData("bd_cheprc"	, lRow)
			szAmt 		= contAll.grid0.GetCellData("bd_cheamt"	, lRow)
			szFee 		= contAll.grid0.GetCellData("bd_fee"		, lRow)
			szDate 		= contAll.grid0.GetCellData("bd_date"	, lRow)
			szSendData	= szCode & "★" & szName  & "★" & szOrdType & "★" & szOrdAmt & "★" & szCheQty & "★" & szPrc & "★" & szAmt & "★" & szFee & "★" & szDate
			'전달내용 : 0종목코드 1종목명 2매수매도구분코드 3주문금액 4체결수량 5체결단가 6체결금액 7수수료 8날짜
			Form.OpenPopupAnimation("mhtro16093_p1", szSendData, "", "2")
		end if
	end if
End Sub

'============================================================================
Sub cont1_grid1_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cancel" then
		dim sState
		sState = cont1.grid1.GetCellData( "bd_typeimg", lRow )
		if sState == "접수중" then
			dim sSendData, szAcnt, szOrdNo, szOrdDate
			g_szOrdDate = cont1.grid1.GetCellData("bd_date", lRow)
			g_szOrdSrno = cont1.grid1.GetCellData("bd_odersrno", lRow)
			szAcnt = acnt0.caption
			szOdrType = cont1.grid1.GetCellData("bd_tradetp", lRow)
			szCode = cont1.grid1.GetCellData("bd_uicode", lRow)
			szName = cont1.grid1.GetCellData("bd_itemnm", lRow)
			sSendData = "1|"& szAcnt &"|"& szOdrType &"|"& szCode &"|"& szName
			'취소확인팝업
			Form.OpenPopupAnimation("mhtro16090_p7", sSendData&"★"&"", "", "2")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	Form.ShowAlert( "알림", szErrMsg )
End Sub

