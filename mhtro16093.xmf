Sub btnCombo1_OnClick()
	dim nWidth, nTop, nLeft, nHeight, szSendData, szLocation, szComboData
	nWidth = 75
	nTop = 58
	nLeft = 290
	nHeight = 32
	
	szLocation = nWidth &"★"& nTop &"★"& nLeft &"★"& nHeight
	szComboData = "전체★매수★매도"
	
	szSendData = szLocation&"♥"&szComboData&"♥"&"cmbTradeType"&"♥"& cmbTradeType.currentindex
	Form.OpenPopup("mhtro16093_p3" , szSendData, "")
End Sub

