Dim g_szOrdDate, g_szOrdSrno
Dim g_sPlain_rm
'============================================================================
'f_RequestTR() : 라디오 타입별 서비스 호출 함수
'============================================================================
Function f_RequestTR()
	contAll.grid0.rowcount = 0
	cont1.grid1.rowcount = 0
	cont2.grid2.rowcount = 0
	
	if CInt(rdoType.currentindex) == 0 then
		DATAMANAGER.RequestTranData( "obtro_oder_813r" )
	elseif CInt(rdoType.currentindex) == 1 then
'		DATAMANAGER.RequestTranData( "obtro_oder_810r" )
		DATAMANAGER.RequestTranData( "obtro_oder_814r" )
	elseif CInt(rdoType.currentindex) == 2 then
		DATAMANAGER.RequestTranData( "obtro_oder_815r" )
	end if
	
	Label1.caption = "주문"& rdoType.GetRadioCaption(rdoType.currentindex) &"내역"
End Function
'============================================================================
'f_RequestNextTR() : 라디오 타입별 서비스 다음 조회 함수
'============================================================================
Function f_RequestNextTR()
	dim szTranID, isMore
	
	if CInt(rdoType.currentindex) == 0 then
		szTranID = "obtro_oder_813r"
	elseif CInt(rdoType.currentindex) == 1 then
'		szTranID = "obtro_oder_810r"
		szTranID = "obtro_oder_814r"
	elseif CInt(rdoType.currentindex) == 2 then
		szTranID = "obtro_oder_815r"
	end if
	isMore = DATAMANAGER.IsMoreNextData( szTranID )
	if isMore == true or isMore = 1 or isMore = "1" then
		DATAMANAGER.RequestNextData( szTranID )
	end if
End Function
'============================================================================
'f_SetContVisible(nIndex) : 라디오 선택에 따른 컨테이너 VISIBLE SET
'============================================================================
Function f_SetContVisible(nIndex)
	if CInt(nIndex) == 0 then '전체
		contAll.visible = true
		cont1.visible = false
		cont2.visible = false
	elseif CInt(nIndex) == 1 then '접수
		contAll.visible = false
		cont1.visible = true
		cont2.visible = false
	elseif CInt(nIndex) == 2 then '체결
		contAll.visible = false
		cont1.visible = false
		cont2.visible = true
	end if
End Function
'============================================================================
'f_SetCalendarWithPeriod(iIdx) : 기간 콤보 선택 시 처리되는 함수
'============================================================================
Function f_SetCalendarWithPeriod(iIdx)
	dim sHostDate
	sHostDate = Form.GetSharedData("&HOST_DATE", false)
	
	if iIdx == 0 then
		Calendar2.addday = -7
		Calendar0.caption = Calendar2.caption
	elseif iIdx == 1 then
		Calendar2.addday = -30
		Calendar0.caption = Calendar2.caption
	elseif iIdx == 2 then
		Calendar2.addday = -90
		Calendar0.caption = Calendar2.caption
	end if
	
	Calendar1.caption = sHostDate
	Calendar2.caption = sHostDate
End Function
'============================================================================
'f_szGetOderState(sState) : 주문 상태를 치환하여 리턴하는 함수
'============================================================================
Function f_szGetOderState(sState)
	if sState = "0" then
		return "정상"
	elseif sState = "1" then
		return "거부"
	elseif sState = "2" then
		return "자동거부"
	elseif sState = "3" then
		return "자동취소(체결후)"
	elseif sState = "4" then
		return "미접수"
	else
		return "상태없음"
	end if
End Function
'============================================================================
'f_szGetMasuMadoType(sType, sMod) : 주문 타입을 치환하여 리턴하는 함수
'============================================================================
Function f_szGetMasuMadoType(sType, sMod)
	dim szReturnStr
	
	if sType == "1" then
		szReturnStr = "매도"
	elseif sType == "2" then
		szReturnStr = "매수"
	else
		szReturnStr = ""
	end if
	
	if sMod == "1" then
		szReturnStr = szReturnStr & "정정"
	elseif sMod == "2" then
		szReturnStr = szReturnStr & "취소"
	end if
	
	return szReturnStr
End Function
'============================================================================
'f_szGetMasuMadoColor(sType) : 주문 타입에 따른 컬러 값을 리턴하는 함수
'============================================================================
Function f_szGetMasuMadoColor(sType)
	dim szReturnStr
	
	if sType == "1" then
		szReturnStr = "11"
	elseif sType == "2" then
		szReturnStr = "10"
	else
		szReturnStr = "13"
	end if
	
	return szReturnStr
End Function
'============================================================================
'f_GetQtyText(sState, sTradeType) : 처리구분 상태에 따른 수량 텍스트 값 리턴
'============================================================================
Function f_GetQtyText(sState, sTradeType)
	if sState == "체결완료" then
		return "체결수량"
	else
		if sTradeType == "1" then
			return "주문수량"
		elseif sTradeType == "2" then
			return "예상수량"
		else
			return "예상수량"
		end if 
	end if
End Function
'============================================================================
'f_SetGridData(nDataCnt) : 라디오 선택에 따른 그리드 데이터 SET 함수
'============================================================================
Function f_SetGridData(nDataCnt)
	dim nRdoIdx, nRowCnt, iRow, sTradeType, sMod, sState, sCancel, sItemCd, sItemNm
	nRdoIdx = CInt(rdoType.currentindex)
	'전체
	if nRdoIdx == 0 then
		nRowCnt = CInt(contAll.grid0.rowcount)
		iRow = nRowCnt - nDataCnt
		sTradeType = ""
		for i=iRow to nRowCnt-1
			sTradeType = contAll.grid0.GetCellData( "bd_tradetp", i )
			sMod = contAll.grid0.GetCellData( "bd_modtp", i )
			if sMod == "" or sMod == null then
				sMod = "0"
			end if
			sState = Trim(contAll.grid0.GetCellData( "bd_typeimg", i ))
			sCancel = contAll.grid0.GetCellData( "bd_cancelyn", i )
			sItemCd = contAll.grid0.GetCellData( "bd_itemcd", i )
			sItemNm = contAll.grid0.GetCellData( "bd_itemnm", i )
			
			contAll.grid0.SetCellData( "bd_text1", i, "주문금액" )
			contAll.grid0.SetCellData( "bd_text2", i, f_GetQtyText(sState, sTradeType))
			contAll.grid0.SetCellData( "bd_tradenm", i, f_szGetMasuMadoType(sTradeType, sMod))
			
			dim tItem, szUI_Text
			'tItem = Split(sItemCd, ".")
			tItem = f_GetCode(sItemCd)
'			szUI_Text = tItem(0) & " | " & sItemNm
'			contAll.grid0.SetCellData( "bd_uicode", i,  szUI_Text)
			contAll.grid0.SetCellData( "bd_uicode", i,  tItem )
			contAll.grid0.SetCellData( "bd_split", i, "|" )
			contAll.grid0.SetCellData( "bd_uiname", i, sItemNm )

			contAll.grid0.SetCellFgColor( "bd_tradenm", i, f_szGetMasuMadoColor(sTradeType))
			if sState = "체결완료" then
				contAll.grid0.SetCellImage( "bd_typeimg", i, "img_bg.9")
				contAll.grid0.SetCellFgColor("bd_typeimg", i, "16")
			else
				contAll.grid0.SetCellImage( "bd_typeimg", i, "img_bgbox.9")
				contAll.grid0.SetCellFgColor("bd_typeimg", i, "4")
			end if
			
			'주문상태에 따른 하단 버튼 이미지 및 주문,체결수량 SET
			if sState == "접수중"  then
				dim szQty
				szQty = contAll.grid0.GetCellData("bd_oderqty", i)
				contAll.grid0.SetCellData( "bd_qty", i, szQty )
				contAll.grid0.SetCellData( "bd_cancel", i, "취소하기")
				contAll.grid0.SetCellImage( "bd_cell6", i, "login_cert_tw.9")
			elseif sState == "취소완료" or sState == "접수완료" then
				dim szQty
				szQty = contAll.grid0.GetCellData("bd_oderqty", i)
				contAll.grid0.SetCellData( "bd_qty", i, szQty )
			elseif sState == "체결완료"  then
				dim szQty
				szQty = contAll.grid0.GetCellData("bd_cheqty", i)
				contAll.grid0.SetCellData( "bd_qty", i, szQty )
				contAll.grid0.SetCellData( "bd_cancel", i, "상세보기")
				contAll.grid0.SetCellImage( "bd_cell6", i, "login_cert_tw.9")
			end if
			
			'취소완료일 시 주문금액, 주문수량 컬러 변경
			if sCancel == "Y"  then
				contAll.grid0.SetCellFgColor( "bd_ordprc", i, "127" )
				contAll.grid0.SetCellFgColor( "bd_qty", i, "127" )
				contAll.grid0.SetCellFgColor( "bd_text1", i, "127" )
				contAll.grid0.SetCellFgColor( "bd_text2", i, "127" )
			end if
		next
	'접수
	elseif nRdoIdx == 1 then
		nRowCnt = CInt(cont1.grid1.rowcount)
		iRow = nRowCnt - nDataCnt
		sTradeType = ""
		for i=iRow to nRowCnt-1
			sTradeType = cont1.grid1.GetCellData( "bd_tradetp", i )
			sMod = cont1.grid1.GetCellData( "bd_modtp", i )
			sState = cont1.grid1.GetCellData( "bd_typeimg", i )
			sCancel = cont1.grid1.GetCellData( "bd_cancelyn", i )
			sItemCd = cont1.grid1.GetCellData( "bd_itemcd", i )
			sItemNm = cont1.grid1.GetCellData( "bd_itemnm", i )
			
			cont1.grid1.SetCellData( "bd_text1", i, "주문금액" )
			cont1.grid1.SetCellData( "bd_text2", i, f_GetQtyText(sState, sTradeType))			cont1.grid1.SetCellData( "bd_tradenm", i, f_szGetMasuMadoType(sTradeType, sMod))
			
			dim tItem
			'tItem = Split(sItemCd, ".")
			tItem = f_GetCode(sItemCd)
'			cont1.grid1.SetCellData( "bd_uicode", i, tItem(0) & " | " & sItemNm )
			cont1.grid1.SetCellData( "bd_uicode", i, tItem)
			cont1.grid1.SetCellData( "bd_split", i, "|")
			cont1.grid1.SetCellData( "bd_uiname", i, sItemNm)
			cont1.grid1.SetCellFgColor( "bd_tradenm", i, f_szGetMasuMadoColor(sTradeType))
			cont1.grid1.SetCellImage( "bd_typeimg", i, "img_bgbox.9")
			'주문상태에 따른 하단 버튼 이미지 변경
			if sState == "접수중"  then
				cont1.grid1.SetCellData( "bd_cancel", i, "취소하기")
				cont1.grid1.SetCellImage( "bd_cell6", i, "login_cert_tw.9")
			end if
			'취소완료일 시 주문금액, 주문수량 컬러 변경
			if sCancel == "Y"  then
				cont1.grid1.SetCellFgColor( "bd_ordprc", i, "127" )
				cont1.grid1.SetCellFgColor( "bd_qty", i, "127" )
				cont1.grid1.SetCellFgColor( "bd_text1", i, "127" )
				cont1.grid1.SetCellFgColor( "bd_text2", i, "127" )	
			end if
		next
	'체결
	elseif nRdoIdx == 2 then
		dim szCRCD
		nRowCnt = CInt(cont2.grid2.rowcount)
		iRow = nRowCnt - nDataCnt
		sTradeType = ""
		for i=iRow to nRowCnt-1
			sTradeType = cont2.grid2.GetCellData( "bd_tradenm", i )
			sItemCd = cont2.grid2.GetCellData( "bd_itemcd", i )
			sItemNm = cont2.grid2.GetCellData( "bd_itemnm", i )
			
			'cont2.grid2.SetCellData( "bd_typeimg", i, "체결완료" )
			sState = cont2.grid2.GetCellData( "bd_typeimg", i)
			if sState = "체결완료" then
				cont2.grid2.SetCellImage( "bd_typeimg", i, "img_bg.9")
				cont2.grid2.SetCellFgColor("bd_typeimg", i, "16")
			else
				cont2.grid2.SetCellImage( "bd_typeimg", i, "img_bgbox.9")
				cont2.grid2.SetCellFgColor("bd_typeimg", i, "4")
			end if
			'cont2.grid2.SetCellImage( "bd_typeimg", i, "img_bgbox.9")
			
			cont2.grid2.SetCellData( "bd_text1", i, "주문금액" )
			cont2.grid2.SetCellData( "bd_text2", i, "체결수량" )
			cont2.grid2.SetCellData( "bd_text3", i, "체결단가" )
			cont2.grid2.SetCellData( "bd_text4", i, "체결금액" )
			cont2.grid2.SetCellData( "bd_text5", i, "수수료" )
			
			dim tItem
			'tItem = Split(sItemCd, ".")
			tItem = f_GetCode(sItemCd)
'			cont2.grid2.SetCellData( "bd_uicode", i, tItem(0) & " | " & sItemNm )
			cont2.grid2.SetCellData( "bd_uicode", i, tItem )
			cont2.grid2.SetCellData( "bd_split", i, "|")
			cont2.grid2.SetCellData( "bd_uiname", i, sItemNm )
			
			if sTradeType == "매수" then
				cont2.grid2.SetCellFgColor( "bd_tradenm", i, "10")
			elseif sTradeType == "매도" then
				cont2.grid2.SetCellFgColor( "bd_tradenm", i, "11")
			end if
			
			cont2.grid2.SetCellData( "bd_crcdtext1", i, "USD")
			cont2.grid2.SetCellData( "bd_crcdtext2", i, "USD")
			cont2.grid2.SetCellData( "bd_crcdtext3", i, "USD")
			
		next
	end if
	
	f_SetContVisible(nRdoIdx)
End Function
'============================================================================
Sub Form_OnFormInit()
	g_sPlain_rm = Form.GetSharedData("&g_sPlain_rm" , false) '암호화 여부
	'날짜 SET
	f_SetCalendarWithPeriod(0)
	'그리드 카드 뷰 이미지 속성 지정(적용여부, 뷰 사이의 거리, 이미지 명)
	
	contAll.grid0.setUseCardView(true, 15, "btn_12_n.9")
	cont1.grid1.setUseCardView(true, 15, "btn_12_n.9")
	cont2.grid2.setUseCardView(true, 15, "btn_12_n.9")
	'내역 조회
	if acnt0.total <> "" and acnt0.total <> null then
		f_RequestTR()
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "주문전송" then '주문 취소 팝업
		if sRet == "1" then
			Form.openPopupAnimation("pwdcheckpopup" , acnt0.total & acnt0.sequence, "", "2")
		else
			g_szOrdDate = ""
			g_szOrdSrno = ""
		end if
	elseif sKeyName == "mhtro16093_p2" then '비번 입력 팝업
		if sRet <> "" and sRet <> null then
			dim sPwd
			sPwd = sRet
'			If g_sPlain_rm == "1" Then
'			    sPwd = sRet
'			Else
'			    sPwd = Form.GetEncData(sRet)
'			End If
			
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ACNO", 0 , acnt0.total )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ASNO", 0 , acnt0.sequence )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ACNT_PWD", 0 , sPwd )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ODER_DATE", 0 , g_szOrdDate )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ACPT_SRNO", 0 , g_szOrdSrno )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ODER_OCRN_TYPE_CODE", 0 , "01" )
			
			DATAMANAGER.RequestTranData( "obtro_oder_802a" )
		end if
	elseif sKeyName == "CORRECT_PWD" then
		if sRet <> "" and sRet <> null then
			dim sPwd, tData
			tData = Split(sRet,"★")
			
			if CInt(tData(1)) > 3 then
				sPwd = tData(0)
			else
				Exit Sub
			end if
			
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ACNO", 0 , acnt0.total )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ASNO", 0 , acnt0.sequence )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ACNT_PWD", 0 , sPwd )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ODER_DATE", 0 , g_szOrdDate )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ACPT_SRNO", 0 , g_szOrdSrno )
			DATAMANAGER.SetDataValue( 0, "obtro_oder_802a", "InBlock1", "ODER_OCRN_TYPE_CODE", 0 , "01" )
			
			DATAMANAGER.RequestTranData( "obtro_oder_802a" )
		end if
	elseif sKeyName == "COMBO_POP" then '콤보 팝업
		if sRet <> "" and sRet <> null then
			dim tData
			tData = Split(sRet, "★")
			Form.SetCtlProp(tData(0), "currentindex", tData(1))
		end if
	end if
End Sub

