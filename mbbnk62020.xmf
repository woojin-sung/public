'============================================================================
' 01.화면명 	: 오픈뱅킹 다른금융기관 계좌 이체
' 02.화면설명	: 오픈뱅킹 다른금융기관 계좌 이체
' 03.작성	: 2020.10.15
'============================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
'============================================================================
'Todo 
'출금가능금액 서비스 opnf_007r sendtranbefore 정의할 것
'주기적으로 콜다시해주는부분 이체에서 찾을것


'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCom
Dim g_szUserID	'ID
Dim szCust_Num    '고객번호

Dim g_szData		'♥출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시♥
Dim g_tact_amt	'이체금액 dbl형
Dim g_szFee		'수수료 (오픈뱅킹 수수료 없음)
Dim g_szBrcd		'
Dim sMdiaSkipYn   '보안매체제외여부

Dim g_szProType	'이체추가, 즉시이체 여부
Dim g_szTRPass 	'단말지정 구분시 필요한 변수
Dim g_szEdtName	'수취인
Dim g_IsMyAccount '내계좌여부
Dim g_isAcdnCust  '정보노출고객여부

Dim g_szDrng_bank_code '출금기관코드
Dim g_szDrng_bank_name '출금기관명
Dim g_szDrng_bank_acno '출금기관계좌번호
Dim g_szDrng_agree_yn '출금동의여부

Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
Dim g_recv_data  '수신데이터   v001

Sub Form_OnFormInit()

	g_szUserID = Form.GetSharedData("&USER_ID" , false)
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
	g_isAcdnCust = ""
	
	if Container1.edtBank.caption == "메리츠증권" then
       g_szCom = "287"
    end if        
	
	g_IsMyAccount = "N" '내계좌여부 기본 N
	
	'recv_data = Form.GetOpenLinkData()

	g_recv_data = Form.GetOpenLinkData()
	
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false) = "Y" THEN
	    Form_Init()
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
	
	DATAMANAGER.RequestTranData("obcsb_scif_033r")
	
End Sub


'============================================================================
' 'v001 이용재동의여부조회 추가에따라 Form_OnFormInit() > 스크립트 이동 > Form_Init() 
'============================================================================
Function Form_Init()	

	tData = Split(g_recv_data, "★")
	
	if UBOUND(tData) < 1 then
		Form.OpenPopup("mbbnk62020_t2" , ""  , sPosInfo) '전달받은인자 없으면 계좌조회 팝업 호출
	else
		
		g_szDrng_bank_code = tData(1) '출금기관코드
		g_szDrng_bank_acno = tData(2) '출금기관계좌번호
		g_szDrng_bank_name = tData(3)  '출금기관명
		g_szDrng_agree_yn  = tData(4)  '출금동의여부
		tmp_bankname_bankacno =  g_szDrng_bank_name  &" "&g_szDrng_bank_acno 
		Edit0.caption = tmp_bankname_bankacno
			

		If g_szDrng_agree_yn   <> "Y" then
			Form.ShowAlert("알림", "선택하신 계좌의 출금동의 여부를 확인하세요.")
			btnProc.enable = False
		elseif g_szDrng_agree_yn   = "Y" then '출금동의계좌일때 출금가능금액 조회
			DATAMANAGER.RequestTranData( "obtss_opnf_007r" ) '오픈뱅킹_타행계좌잔액조회
		end if
	end if
	
	
	
	
	'Form.OpenPopup("mbbnk62020_t2" , ""  , sPosInfo)
End Function

