	Form.OpenPopup("mbbnk62020_t2" , ""  , "")
End Sub

'============================================================================
'출금가능금액 재조회
'============================================================================
Sub Container0_btnIqry_OnClick()
	if Edit0.caption = "" then
		Form.ShowAlert("알림", "계좌를 선택하세요")
	end if
	DATAMANAGER.RequestTranData( "obtss_opnf_007r" ) '오픈뱅킹_타행계좌잔액조회
	
End Sub

'============================================================================
'이체금액초기화
'============================================================================
Sub Container0_btnReset_OnClick()
	Container0.edtAmt.caption = 0
End Sub

'============================================================================
'이체금액_전액
'============================================================================
Sub Container0_btnAll_OnClick()
	Container0.edtAmt.caption = Container0.edtAble.caption	
	
	if CDbl(Container0.edtAmt.caption) > Cdbl(10000000) then
		Form.ShowAlert("알림", "출금한도 초과입니다.(1천만원)")
		Container0.edtAmt.caption = ""
		exit sub
	end if
End Sub

'============================================================================
'이체금액_증가
'============================================================================
Sub Container0_btn1_OnClick()
	Call Cal_Btn(10000)
End Sub

'============================================================================
Sub Container0_btn10_OnClick()
	Call Cal_Btn(100000)
End Sub

'============================================================================
Sub Container0_btn100_OnClick()
	Call Cal_Btn(1000000)
End Sub

'============================================================================
Sub Container0_btn5_OnClick()
	Call Cal_Btn(50000)
End Sub

'============================================================================
Sub Container0_btn50_OnClick()
	Call Cal_Btn(500000)
End Sub

'============================================================================
' Cal_Btn(nAdd)
'============================================================================
Function Cal_Btn(nAdd)	
   Dim nAmt
   if Trim(Container0.edtAmt.caption) == "" then
      nAmt = 0
   else 
      nAmt = CDbl(Container0.edtAmt.caption)
   end if
   Container0.edtAmt.caption = nAmt + nAdd
   
   Container0_edtAmt_OnEditComplete()
End Function

'============================================================================
'이체금액_초과검사
'============================================================================
Sub Container0_edtAmt_OnEditComplete()
	Dim szTempMoney1, szTempMoney2
	szTempMoney1 = Container0.edtAble.caption
	szTempMoney2 = Container0.edtAmt.caption
	if CDbl(szTempMoney1) < CDbl(szTempMoney2) then
		Form.ShowAlert("알림", "이체금액이 출금가능금액을 초과했습니다.")
		Container0.edtAmt.caption = ""
		exit sub
	end if
	
	if CDbl(szTempMoney2) > Cdbl(10000000) then
		Form.ShowAlert("알림", "출금한도 초과입니다.(1천만원)")
		Container0.edtAmt.caption = ""
		exit sub
	end if
	
End Sub

'============================================================================
'입금계좌 수정시
'============================================================================
Sub Container0_edtAcnt_OnEditComplete()
	g_IsMyAccount = "N"
End Sub

'============================================================================
'입금계좌조회(수취조회)
'============================================================================
Sub Container1_btnName_OnClick()

	if Container1.edtAcnt.caption ="" then
		Form.ShowAlert("알림", "입금계좌를 입력하세요")
		Exit Sub
	end if
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r", "InBlock1", "ELFN_ID", 0, g_szUserID )
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r", "InBlock1", "DRNG_BANK_CODE"	, 0, g_szDrng_bank_code  )'출금은행코드
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r", "InBlock1", "DRNG_BANK_ACNO"	, 0, g_szDrng_bank_acno  )'출금계좌번호
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r", "InBlock1", "MNRC_BANK_CODE"	, 0, g_szCom				    )'입금은행코드
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r", "InBlock1", "TACT_BANK_ACNO"	, 0, Container1.edtAcnt.caption  )'입금계좌번호
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r", "InBlock1", "TR_AMT"			, 0, Container0.edtAmt.caption  )'이체금액
	
	DATAMANAGER.RequestTranData( "obtss_opnf_010r" )
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbbnk62020_t4" then
		If sRet == "Cancel" then
			Form_Reset() 
		end if
	elseIf sKeyName == "오픈뱅킹기관" then
		If sRet <> "" then
			tData1 = Split(sRet, "★")
			Container1.edtBank.caption = tData1(1)
			g_szCom = tData1(0)
			'cont0_contTran_btnName_OnClick()
		End If 
	ElseIf sKeyName == "62020_T2" then '출금계좌조회
		tData = Split(sRet, "★")
		if UBOUND(tData) < 1 THEN
			if Edit0.caption = "" then
				Form.ShowAlert("알림", "계좌를 선택하세요")
			end if
			Exit Sub
		END IF
		 
		g_IsMyAccount = "N"
		
		g_szDrng_bank_code = tData(1) '출금기관코드
		g_szDrng_bank_acno = tData(2) '출금기관계좌번호
		g_szDrng_bank_name = tData(3)  '출금기관명
		g_szDrng_agree_yn  = tData(4)  '출금동의여부
		tmp_bankname_bankacno =  g_szDrng_bank_name  &" "&g_szDrng_bank_acno 
		Edit0.caption = tmp_bankname_bankacno
			

		If g_szDrng_agree_yn   <> "Y" then
			Form.ShowAlert("알림", "선택하신 계좌의 출금동의 여부를 확인하세요.")
			btnProc.enable = False
		elseif g_szDrng_agree_yn   = "Y" then '출금동의계좌일때 출금가능금액 조회
			DATAMANAGER.RequestTranData( "obtss_opnf_007r" ) '오픈뱅킹_타행계좌잔액조회
		end if
	
	ElseIf sKeyName == "62020_OFTEN" then '입금계좌조회
		If sRet <> "" then
			tData = Split(sRet, "★")
			Container1.edtReceiver.caption = tData(3)
			g_szEdtName = Container1.edtReceiver.caption
			Container1.edtAcnt.caption = Replace(tData(2),"-","")
			Container1.edtBank.caption = tData(4)
			g_IsMyAccount  = tData(5) '내계좌여부
			
			Container1.edtMytip.caption = "메리츠오픈".. LEFT(g_szEdtName ,6)
			
			g_szCom = tData(1)
	      'cont0_contTran_btnName_OnClick()
		End If	
	Elseif sKeyName == "mbbnk61010_pe" then
		If sRet == "Y" then 
			Form_Reset() 
              
              Form.OpenPopup("mbbnk61010_pd" , ""  , "")
		     Exit Sub
		else
			'단건 즉시이체시
			'♥출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥수취인명
			Form.OpenFramePopup( "mbbnk62020_t3", g_szData &"♥"& g_szFee  &"♥"&  g_IsMyAccount  &"♥"& g_szEdtName &"♥"& g_szCom, "")
		end if
			
	Elseif sKeyName == "mbbnk62020_t3" then	'인증 완료
		If sRet == "ok" then
			QR_Tran() 
		else
			Form_Reset()
			'"출금가능금액체크서비스"
		end if
	ElseIf sKeyName == "mbbnk62000_p1" then 'v001
	     
		If sRet == "Y" then 'Y:재동의 N:취소
			Form_Enable(True)
			
			Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
'			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
				Form_Enable(True)
				
				Form_Init()
			Else
				Form_Enable(False)

			End If
		End If
	end if
End Sub

'============================================================================
'계좌조회
'============================================================================

Sub Container1_btnOften0_OnClick()
	Form.OpenPopup("mbbnk62020_t1" , ""  , "")
End Sub


Sub btnProc_OnClick()
	g_szEdtPrice = Container0.edtAmt.caption				'이체금액
	
	if Trim(g_szEdtPrice) == "" or Trim(g_szEdtPrice) == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하십시요.")
		Exit Sub
	end if
	
    If g_isAcdnCust == "Y" Then
        Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )	
        Exit Sub
    End If
	
	Final_Chk()
	
End Sub

'============================================================================
' Final_Chk() : 이체추가, 즉시이체 전 수취인 조회
'============================================================================
Function Final_Chk()
	szData1 = g_szDrng_bank_acno		  	'출금기관계좌번호
	szData2 = g_szDrng_bank_code			'출금기관코드
	szData3 = g_szDrng_bank_name			'출금기관명
	
	szData4 = Container1.edtAcnt.caption		'입금계좌번호	   			    
	'szData5 = g_szCom	
	szData6 = Container1.edtBank.caption  	'입금계좌기관명
	szData7 = Container0.edtAmt.caption		'이체금액
	
	szData8 = Container1.edtMytip.caption	'내통장표시			
	szData9 = Container1.edtRcvTip.caption	'받는분표시
	szData10 = Container1.edtReceiver.caption	'수취인명
	
	
	'		  출금계좌번호♥출금기관코드 ♥출금기관명   ♥입금계좌번호 ♥입금기관명   ♥이체금액
	g_szData    = szData1&"♥"& szData2 &"♥"& szData3 &"♥"& szData4 &"♥"& szData6 &"♥"& szData7
	
			 '출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥내통장표시♥받는분표시
	g_szOneData = szData1&"♥"& szData2 &"♥"& szData3 &"♥"& szData4 &"♥"& szData6 &"♥"& szData7 &"♥"& szData8 &"♥"& szData9 
	
	if Trim(szData4) = "" then
		Form.ShowAlert("알림", "입금계좌번호를 입력하십시요.")
		Exit Function
	end if
	   
	if Trim(szData1) = Trim(szData4) then
		Form.ShowAlert("알림","출금계좌번호와 입금계좌번호가 같습니다.")
		Exit Function
	end if

	g_tact_amt = CDbl(szData7) 
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r_1", "InBlock1", "ELFN_ID", 0, g_szUserID )
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r_1", "InBlock1", "DRNG_BANK_CODE", 0, g_szDrng_bank_code  )'출금은행코드
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r_1", "InBlock1", "DRNG_BANK_ACNO", 0, g_szDrng_bank_acno  )'출금계좌번호
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r_1", "InBlock1", "MNRC_BANK_CODE", 0, g_szCom				    )'입금은행코드
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r_1", "InBlock1", "TACT_BANK_ACNO", 0, Container1.edtAcnt.caption  )'입금계좌번호
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_010r_1", "InBlock1", "TR_AMT"			, 0, Container0.edtAmt.caption  )'이체금액

	DATAMANAGER.RequestTranData( "obtss_opnf_010r_1" )
	
	
End Function	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtss_opnf_007r" then
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "ELFN_ID"	, 0 , g_szUserID 			) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "BANK_CODE"	, 0 , g_szDrng_bank_code 	) '출금기관코드
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "BANK_ACNO"	, 0 , g_szDrng_bank_acno	) '출금기관계좌번호
	end if
	
	'v001
	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
	end if
	
     'v001
	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
	
    If szTranID == "obcsb_scif_033r" Then
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO"    , 0 , ""        )
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"    , 0 , ""        )
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID" , 0 , g_szUserID)
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtss_opnf_010r" then
		szName = DATAMANAGER.GetDataValue (0, "obtss_opnf_010r", "OutBlock1", "RMT_NAME", 0 )
		Container1.edtReceiver.caption = szName
		
		
		Container1.edtMytip.caption = "메리츠오픈".. LEFT(szName ,6)
		'Container1.edtMytip.caption = "메리츠오픈"
		g_szEdtName = szName	      
		g_szFee = "0"
		
	elseif szTranID == "obtss_opnf_010r_1" then
		szName 		= DATAMANAGER.GetDataValue (0, "obtss_opnf_010r_1", "OutBlock1", "RMT_NAME"			, 0 )
		g_IsMyAccount = DATAMANAGER.GetDataValue (0, "obtss_opnf_010r_1", "OutBlock1", "SECU_MDIA_EXLS_YN"	, 0 )'인자명은 보안매체 제외 여부지만 당사 본인계좌일때만 Y 나머지 N이므로 Y일때만 인증스킵
		
		Container1.edtReceiver.caption = szName
		g_szEdtName = szName	      
		
		g_szFee = "0"
		
		if g_szCom == "" or g_szCom == null then
			Form.ShowAlert( "알림", "입금 은행을 확인 하십시오" )
		end if
		
		'이체 프로세스의 경우 여기서 obcsb_oimf_638r(전자금융사기예방 고객조회) 호출하지만 오픈뱅킹이체는 해당서비스 조회 x
		
		'g_szPlusUI = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r_1", "OutBlock1", "SPLM_ATHN_NCSR_YN", 0 ))'추가인증팝업여부
		'sMdiaSkipYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)

		sMdiaSkipYn  = "N" '오픈뱅킹 보안매체 제외x
		Form.SetSharedData("61010_SMDIA_SKIP", sMdiaSkipYn )
		
		
		'이체가능금액 조회 프로세스 없음. 이체 api 호출 후 한도 초과시 리턴 fail
		
		'금융사기 예방을 위한 문진제도 강화 대응
		'팝업에서 예를 선택하면 OnPopupReturn 이벤트 Call 됨.
		'보이스피싱 팝업은 띄워주나, obtss_comm_502a 등 문진 프로세스는 타지않음
		
		'START--------------------------------
		'v001 이체금액 재조립
		szTempList = Split(g_szData, "♥")
			    
		if UBOUND(szTempList) < 1 THEN
			exit sub
		END IF
		
		'이체금액 > 출금가능금액
		if CDbl(szTempList(5)) > CDbl(Container0.edtAble.caption) then
			Form.ShowAlert( "알림", "출금가능금액이 부족합니다." )
			Exit Sub
		end if
		'----------------------------------END
		
		g_szEdtName = Container1.edtReceiver.caption
		
		szFiledate2 = Form.LoadConfigData( "mbbnk61010_pe", "mbbnk61010_curdate" ) 'mbbnk61010_curdate 값 고정 20181218
		szPopup2    = Form.LoadConfigData( "mbbnk61010_pe", "mbbnk61010_popup" )
			
		if g_IsMyAccount =="Y" then	 '내계좌일때 보이스피싱체크 skip
			'  출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥수수료♥내계좌여부♥수취인명♥금융기관코드
			Form.OpenFramePopup( "mbbnk62020_t3", g_szData &"♥"& g_szFee  &"♥"&  g_IsMyAccount  &"♥"& g_szEdtName &"♥"& g_szCom, "")
		elseIf szFiledate2 <> Form.GetSharedData("&HOST_DATE" , false)  Then
		     Form.OpenPopup("mbbnk61010_pe" , ""  , "")	
		Else
			If popup2 = "Y" Then
				Form.OpenPopup("mbbnk61010_pe" , ""  , "")	
			ELSE
			'단건 즉시이체시
			'♥출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥수취인명
			'  출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥수수료♥내계좌여부♥수취인명♥금융기관코드
				Form.OpenFramePopup( "mbbnk62020_t3", g_szData &"♥"& g_szFee  &"♥"&  g_IsMyAccount  &"♥"& g_szEdtName &"♥"& g_szCom, "")
			End if
		End if
	
	
	elseif szTranID == "obtss_opnf_007r" then	' 출금가능조회 완료 후 이체누적금액조회,이체한도는 안함, 자사에서 관리 데이터 아님
		Container0.edtAble.caption =  DATAMANAGER.GetDataValue (0, "obtss_opnf_007r", "OutBlock1", "DRNG_ABLE_AMT", 0 )
	
	elseif szTranID == "obtss_opnf_003a" then '오픈뱅킹_이체
		szMsg = DATAMANAGER.GetDataMsgText( "obtss_opnf_003a" )
		szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_opnf_003a" )..")"
					
		'g_szOneData   출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥내통장표시♥받는분표시
		'출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥내통장표시♥받는분표시♥수취인명♥출금기관코드
		Form.OpenPopup("mbbnk62020_t4", g_szOneData &"♥"& g_szEdtName &"♥"& g_szCom &"♥"& szMsg &"♥"& "정상" &"♥"& g_szCom, "") '''단건이체완료창(8)
		
		Form_Reset()
	elseif szTranID == "obtss_opnf_047r" then	'v001
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부

	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
	    
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If
	    
	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
        '다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then
	 
			Form_Enable(False)
		Else
		
		    Form_Init()
	    End If
	elseif szTranID == "obtss_opnf_048a" then	'v001
	
		Form_Init()
		
	ElseIf szTranID == "obcsb_scif_033r" Then
	
	    g_isAcdnCust = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TRGT_YN" , 0)
	    
	    If g_isAcdnCust == "Y" Then
	        Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )
	    End If
		
	end if
	
	
End Sub


'============================================================================
'  ()'''
'============================================================================		
Function QR_Tran()
	DATAMANAGER.ClearOutputData( 0 , "obtss_opnf_003a" )
	
	arrData = Split(g_szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시
	
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "PROS_CLS_CODE"		, 0, "1"					) '1: 타투타 , 2:잔액모으기
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "ELFN_ID" 			, 0, g_szUserID 			) '전자금융ID
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "DRNG_BANK_CODE" 		, 0, arrData[1] 			) '출금은행코드
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "DRNG_BANK_ACNO" 		, 0, arrData[0]			) '출금은행계좌번호
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "DRNG_OPN_SUMR_CNTT" 	, 0, Container1.edtMytip.caption		) '출금오픈뱅킹적요내용(출금계좌통장표시)
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "MNRC_BANK_CODE" 		, 0, g_szCom				) '입금은행코드
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "RCVN_BANK_ACNO" 		, 0, arrData[3]			) '수취은행계좌번호
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "TR_AMT" 				, 0, arrData[5]			) '거래금액
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "MNRC_OPN_SUMR_CNTT" 	, 0, Container1.edtRcvTip.caption) '입금오픈뱅킹적요내용(입금계좌통장표시)
	DATAMANAGER.SetDataValue( 0,"obtss_opnf_003a", "InBlock1", "RMT_NAME" 			, 0, g_szEdtName 			) '수취인명
	
	DATAMANAGER.RequestTranData( "obtss_opnf_003a" )
	
End Function

'============================================================================
' Form_Reset()
'============================================================================	
Function Form_Reset()
	Container0.edtAble.caption     = ""
	Container0.edtAmt.caption      = ""
	Container1.edtReceiver.caption = ""
	Container1.edtMytip.caption    = "메리츠오픈"
	Container1.edtRcvTip.caption   = ""
	Container1.edtAcnt.caption     = ""
	Container1.edtBank.caption     = "메리츠증권"
	g_szCom                        = "287"
	
	
	DATAMANAGER.RequestTranData( "obtss_opnf_007r" ) '오픈뱅킹_타행계좌잔액조회
	
	
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "obtss_opnf_010r" or szTranID = "obtss_opnf_010r_1"then
         szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
         Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
         Container1.edtReceiver.caption = ""
	 
	 elseif szTranID = "obtss_opnf_007r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
	
	
	elseif szTranID == "obtss_opnf_003a" then '오픈뱅킹_이체 
		szMsg = DATAMANAGER.GetDataMsgText( "obtss_opnf_003a" )
		
		if DATAMANAGER.GetDataMsgSubText( "obtss_opnf_003a" ) =="" then
			szMsg = szMsg
		else
			szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_opnf_003a" )..")"
		end if
					
		'g_szOneData'출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥내통장표시♥받는분표시
		            '(출금계좌번호♥출금기관코드♥출금기관명♥입금계좌번호♥입금기관명♥이체금액♥내통장표시♥받는분표시) ♥수취인명♥입금기관코드♥리턴메시지♥"오류"♥입금기관코드
		Form.OpenPopup("mbbnk62020_t4", g_szOneData &"♥"& g_szEdtName &"♥"& g_szCom &"♥"& szMsg &"♥"& "오류" &"♥"& g_szCom, "") '''단건이체완료창(8)
		
		Form_Reset() 
	end if
	
End Sub

'============================================================================
'Form_Enable
'============================================================================
Function Form_Enable(EnableYn)
    if EnableYn = True then
    
		imgSearch0.enable            = True	'계좌
		Container0.btnIqry.enable    = True	'출금가능금액 조회
		Container0.edtAmt.enable     = True	'이체금액
		Container0.btnReset.enable   = True	'이체금액 정정
		Container0.btnAll.enable     = True	'전액
		Container0.btn100.enable     = True	'100만
		Container0.btn50.enable      = True	'50만
		Container0.btn10.enable      = True	'10만
		Container0.btn5.enable       = True	'5만
		Container0.btn1.enable       = True	'1만			
		Container1.edtAcnt.enable    = True	'입금기관
		Container1.imgSearch.enable  = True	'입금기관 조회
		Container1.btnOften0.enable  = True	'계좌 조회
		Container1.btnName.enable    = True	'입금계좌 조회
		Container1.edtMytip.enable   = True	'내통장표시
		Container1.edtRcvTip.enable  = True	'받는분통장표시
		btnProc.enable               = True   '이체
				
    elseif EnableYn = False then
    
		imgSearch0.enable            = False	'계좌
		Container0.btnIqry.enable    = False	'출금가능금액 조회
		Container0.edtAmt.enable     = False	'이체금액
		Container0.btnReset.enable   = False	'이체금액 정정
		Container0.btnAll.enable     = False	'전액
		Container0.btn100.enable     = False	'100만
		Container0.btn50.enable      = False	'50만
		Container0.btn10.enable      = False	'10만
		Container0.btn5.enable       = False	'5만
		Container0.btn1.enable       = False	'1만			
		Container1.edtAcnt.enable    = False	'입금기관
		Container1.imgSearch.enable  = False	'입금기관 조회
		Container1.btnOften0.enable  = False	'계좌 조회
		Container1.btnName.enable    = False	'입금계좌 조회
		Container1.edtMytip.enable   = False	'내통장표시
		Container1.edtRcvTip.enable  = False	'받는분통장표시
		btnProc.enable               = False   '이체
    end if
End Function
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtss_opnf_008r" trcode="obtss_opnf_008r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_010r" trcode="obtss_opnf_010r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_010r_1" trcode="obtss_opnf_010r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_007r" trcode="obtss_opnf_007r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_003a" trcode="obtss_opnf_003a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_047r" trcode="obtss_opnf_047r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_048a" trcode="obtss_opnf_048a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_scif_033r" trcode="obcsb_scif_033r" compress="1" encryption="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtss_opnf_008r" title="오픈뱅킹_타행계좌내역조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="227" _ulen="171" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
OPN_ACNT_KIND_CODE^오픈뱅킹계좌종류코드^1^0^0^0^0^0^0
