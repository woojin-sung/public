	<SCRIPT_INFO _len="973" _ulen="871" >
' 실시간시세신청_확인창

Sub Form_OnFormInit()
	Dim szData, szSplitData	
	szData = Form.GetOpenLinkData()
'시장★신청타입★신청기간★월사용료★결제계좌
'szData = "미국★24.03.01 ~ 24.05.08★무료★1234567801"
'szData = "미국★24.03.01 ~ 자동연장★월 5 USD★1234567801"
'msgbox szData	
	if szData <> "" then	
		szSplitData = Split(szData, "★")	
		Table0.SetCellString(0, 1, szSplitData(0))		
		Table0.SetCellString(1, 1, szSplitData(1))
		Table0.SetCellString(2, 1, Replace(szSplitData(2), "월 ", ""))
		Table0.SetCellString(3, 1, szSplitData(3))
	end if
End Sub

'============================================================================
Sub btnQuit_OnClick()
	Form.SendReturnToParent("REG_SET", "CANCEL")
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnReg_OnClick()
	Form.SendReturnToParent("REG_SET", "OK")
	Form.CloseForm()	
End Sub

