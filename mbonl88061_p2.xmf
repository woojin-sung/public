'============================================================================
' 단기사채 매수신청 취소팝업
'============================================================================

'============================================================================
Sub Form_OnFormInit()
	lblTitle.changeTextAttr(0, 2, 293, 4, true)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
    
		g_tData = Split(szOpenData, "★")
		
		tblMaemae.SetCellString(0, 1, g_tData[0])
		tblMaemae.SetCellString(1, 1, g_tData[3])
		lblKorIsNm.caption = g_tData[2]
'		tblMaemae.SetCellString(2, 1, g_tData[2])
		tblMaemae.SetCellString(3, 1, g_tData[4])
		tblMaemae.SetCellString(4, 1, g_tData[5])
		
	End If
	
'	''//test
'	tblMaemae.SetCellString(0, 1, "3003342703")
'	tblMaemae.SetCellString(1, 1, "매수")
''	lblKorIsNm.caption = "메리츠증권 20230424-60"	'test
''	lblKorIsNm.caption = "쥐피에스22제십삼차 20230324-33-1(E)"	'test
'	lblKorIsNm.caption = "유동화 단기사채 메타그린제칠차 20230315-92-1(E)"	'test
'	tblMaemae.SetCellString(3, 1, "123000")
End Sub

'============================================================================
' 하단 닫기 버튼
'============================================================================
Sub btnCancel_OnClick()	
	Form.CloseForm( )	
End Sub

'============================================================================
' 하단 취소 버튼
'============================================================================
Sub btnOrder_OnClick()
	Form.SendReturnToParent( "mbonl88061_p2" , "cancel")
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

