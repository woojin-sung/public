<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50110" scrname="ETF Super검색_스크리너_상장국가" version="2" writer="함원규" />
	<FORM_INFO name="Form" ly_vert="0,0,375,444,1" />
	<CONTROL_INFO>
		<LABEL name="lblSubTitle" fontstyle="01" caption="상장국가" ly_vert="20,17,200,22,1" />
		<PANNEL name="Pannel0" ly_vert="20,50,335,390,1" >
			<CONTROL_INFO>
				<LABEL name="lblPublicNation0" fontsize="-2" halign="1" click="1" ly_vert="0,0,105,36,1" />
				<LABEL name="lblPublicNation1" fontsize="-2" halign="1" click="1" ly_vert="115,0,105,36,1" />
				<LABEL name="lblPublicNation2" fontsize="-2" halign="1" click="1" ly_vert="230,0,105,36,1" />
			</CONTROL_INFO>
			<CARD_INFO cardheight="36" gap="10" >
				<CELL name="lblPublicNation0" />
				<CELL name="lblPublicNation1" />
				<CELL name="lblPublicNation2" />
			</CARD_INFO>
		</PANNEL>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="10034" _ulen="9774" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'==============================================
' 이미지
'==============================================
Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_line2_o.9"

'==============================================
' 컬러코드
'==============================================
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

'==============================================
' 전역변수
'==============================================
Dim g_szSharedData
g_szSharedData = ""

Dim g_szSharedKey
g_szSharedKey = "50110_S3_CHECK"

Dim g_arrPublicNation
g_arrPublicNation = Array("한국 상장", "미국 상장", "중국 상장", "홍콩 상장", "일본 상장")

Dim g_arrPublicNation_Check
g_arrPublicNation_Check = Array("0", "0", "0", "0", "0")

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	lblSubTitle.fgcolor = g_szTxtColor_Normal
	lblSubTitle.paddinginfo = "0,0,0,0"
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Data()
	nArrCnt = #g_arrPublicNation
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	Pannel0.rowcount = nPannelRowCnt
	
	nArrIdx = 0
	szChkData = Form.GetSharedData(g_szSharedKey, false)
	
	for i = 0 to nPannelRowCnt - 1
		Pannel0.SetCellValue( "lblPublicNation0", i, g_arrPublicNation(nArrIdx))	
		
		Pannel0.SetPropCardCell("fgcolor", "lblPublicNation0", i, g_szTxtColor_Normal)
		Pannel0.SetPropCardCell("imagefilepth", "lblPublicNation0", i, g_szBtnImg_Normal)
		g_arrPublicNation_Check(nArrIdx) = "0" 

		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Pannel0.SetCellVisible("lblPublicNation1",i,false)
			Pannel0.SetCellVisible("lblPublicNation2",i,false)
			Exit for
		end if
		
		Pannel0.SetCellValue( "lblPublicNation1", i, g_arrPublicNation(nArrIdx))	
		
		Pannel0.SetPropCardCell("fgcolor", "lblPublicNation1", i, g_szTxtColor_Normal)
		Pannel0.SetPropCardCell("imagefilepth", "lblPublicNation1", i, g_szBtnImg_Normal)
		g_arrPublicNation_Check(nArrIdx) = "0" 

		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Pannel0.SetCellVisible("lblPublicNation2",i,false)
			Exit for
		end if
		
		Pannel0.SetCellValue( "lblPublicNation2", i, g_arrPublicNation(nArrIdx))	
		
		Pannel0.SetPropCardCell("fgcolor", "lblPublicNation2", i, g_szTxtColor_Normal)
		Pannel0.SetPropCardCell("imagefilepth", "lblPublicNation2", i, g_szBtnImg_Normal)
		g_arrPublicNation_Check(nArrIdx) = "0" 
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
End Function

'===============================================
' 패널버튼 클릭 이벤트 처리
'===============================================
Function DisplaySetting_PannelBtn(nRowIdx, szCtlName)
	nCnt = nRowIdx * 3
	if szCtlName = "lblPublicNation0" then
		
	elseif szCtlName = "lblPublicNation1" then
		nCnt = Cint(nCnt) + 1
	elseif szCtlName = "lblPublicNation2" then
		nCnt = Cint(nCnt) + 2
	end if
	if #g_arrPublicNation_Check < nCnt+1 then
		Exit Function
	end if
	
	if g_arrPublicNation_Check(nCnt) = "0" then
		g_arrPublicNation_Check(nCnt) = "1"
		Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
	else 
		g_arrPublicNation_Check(nCnt) = "0"
		
		szData = g_arrPublicNation(nCnt)
		
		Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
		
		szData = Convert_ChkArrToString(g_arrPublicNation, g_arrPublicNation_Check, "`")
		
		if instr(szData,"한국 상장") <= 0 then
			Form.SetSharedData("50110_S4_CHECK_DOMESTIC", "" )
		end if
		
		if instr(szData, "미국 상장") <= 0 and instr(szData, "중국 상장") <= 0 and instr(szData, "일본 상장") <= 0 and instr(szData, "홍콩 상장") <= 0 then
			Form.SetSharedData("50110_S4_CHECK_OVERSEA", "" )
		end if
	end if
	
End Function

Function Reload_PannelBtn(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblPublicNation0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblPublicNation1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblPublicNation2"
	end if
	
	g_arrPublicNation_Check(nArrIdx) = "1"
	Pannel0.setPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
End Function


'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 체크배열 초기화
'===============================================
Function Clear_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "0"	
	next 
End Function

'===============================================
' 체크배열 전체선택
'===============================================
Function All_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "1"	
	next 
End Function

'===============================================
' 배열 인덱스 추출
'===============================================
Function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData = null or arrData = "" then
		return nReturn
	end if
	
	if szData = null or szData = "" then
		return nReturn
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = szData then
			nReturn = i
			exit for
		end if	
	next 
	
	return nReturn
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	g_szSharedData = Form.GetSharedData(g_szSharedKey, false )
	
	Init_Control()
	Init_Data()

	arrTempData = Convert_StringToArr(g_szSharedData, "`")
					
	for i = 0 to #arrTempData - 1
		nStep0_Idx = Return_ArrayIndex(g_arrPublicNation, arrTempData(i))
		Reload_PannelBtn(nStep0_Idx)
	next
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	
	DisplaySetting_PannelBtn(nIndex, sCellID)
	
	szData = Convert_ChkArrToString(g_arrPublicNation, g_arrPublicNation_Check, "`")
	Form.SetSharedData(g_szSharedKey , szData)
	Form.triggerEvent("#", g_szSharedKey, "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "50110_S3_CHECK" then
		Init_Data()
		
		g_szSharedData = Form.GetSharedData(g_szSharedKey, false )
		arrTempData = Convert_StringToArr(g_szSharedData, "`")
						
		for i = 0 to #arrTempData - 1
			nStep0_Idx = Return_ArrayIndex(g_arrPublicNation, arrTempData(i))
			Reload_PannelBtn(nStep0_Idx)
		next
	elseif sEventName = "50110_COND_STAT" then
		if sParam = "N" then
			Pannel0.height = 398
		elseif sParam = "Y" then
			Pannel0.height = 288
		end if
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>