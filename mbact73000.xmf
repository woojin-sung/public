'--===========================================================================
Dim sLOGIN_TYPE        '로그인여부
Dim g_szCloseFlag

'============================================================================
Sub Form_OnFormInitBefore()
	imgLogo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Label0.changeTextSpacing(5)
	
	g_szCloseFlag = Form.GetOpenLinkData()

	f_ClearSharedData()    
		
    '로그인여부
    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )

    '비로그인상태에서만 비대면화면 권한부여
    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
        Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
    End If
    
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")    
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.OpenNextPopup("mbact73000_s1", "", "")
End Sub

