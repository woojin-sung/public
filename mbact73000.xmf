Sub imgBack_OnClick()
	f_ClearSharedData()
	
	Form.SetSharedData("&SCREEN_AUTH" , "") '비대면화면 권한프리	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
	'Form.OpenScreen( "41000" , "")
	Form.OpenNextPopup("mhetc90022", "", "")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    imgBack_OnClick()   
End Sub

