'--===========================================================================
'--===========================================================================
Dim	g_Acno
Dim	g_sMapFile

Dim gAthnMdiaUseYn
Dim gElfnIdExstYn

'============================================================================
Sub Form_OnTimerEvent(sTimerID) 'v0002

	if sTimerID == 0 or sTimerID == "0" then ' 타기관OTP등록
		Form.SetTimerEvent2(0, 0, 1)
		g_sMapFile = "mbotp86106.xmf"
	end if
	
	if sTimerID == 99 or sTimerID == "99" then ' 모바일 OTP등록
		Form.SetTimerEvent2(99, 0, 1)
		g_sMapFile = "mbotp86100.xmf"
	end if
	
	If sTimerID == 2 Or sTimerID == "2" Then ' 보안매체 변경 없이 진행
		Form.SetTimerEvent2(2, 0, 1)
		
		if gElfnIdExstYn == "N" then
			'ID 등록 안되어있으면 ID 등록 
			g_sMapFile = "mbbdm85230.xmf"
		else
			'ID 등록되어있고 인증서 등록되어있으면 화면 종료
			if gAthnMdiaUseYn == "Y" then
				Form.OpenScreen("41000", "")
				Form.CloseForm()
				exit sub
			
			'ID 등록 되어있고 인증서 등록 안 되어있으면 바이오인증 등록 단계
			else
				g_sMapFile = "mbbdm85300.xmf"
			end if
		end if
	End If
	
	'JMY Form.CloseForm()
	Form.OpenNextPopup( g_sMapFile, "", "" )  '화면오픈후,자동 Close
End Sub

'============================================================================
Sub Form_OnFormInit()

'test code
'Form.ShowAlert("실명확인번호", Form.GetSharedData( "RCNO_PIP", FALSE ))
'Form.SetSharedData("NMET_ACNO" , "30003130")
'Form.SetSharedData("mOTP_IntoClcd", "NMET_ACNT" )
'Form.SetSharedData("BDM_RCNO_PIP", "001304FC8A4D7E156D9F62009DEA39433836" )
'Form.SetSharedData("BDM_NMET_ACNO", "30003130" )
'Form.SetSharedData("SCRC_YN" , "Y")

	'계조번호
	g_Acno = Form.GetSharedData( "NMET_ACNO", False )
	'보안카드 유무에 따라 위치 변경
	ScrcIsncYN = Form.GetSharedData( "SCRC_YN", False )
	
	gAthnMdiaUseYn = Form.GetSharedData( "gAthnMdiaUseYn", False )		'인증서 사용여부
	gElfnIdExstYn = Form.GetSharedData( "gElfnIdExstYn", False )		'ID 보유여부
	
	Cntn.imgPOTP.imgpath = "icon_otp_off.png"
	Cntn.imgMOTP.imgpath = "icon_mobile_off.png"
	
	Cntn.Image0.Setstatus("normal")
	Cntn.Image1.Setstatus("normal")
	Cntn.Image2.Setstatus("normal")
	
	If ScrcIsncYN == "Y" Then
		DATAMANAGER.RequestTranData( "obcsb_oimf_491r" )
	Else
		Cntn.Table0.visible = False
		Cntn.Image2.visible = False
		Cntn.ChkSkip.visible= False
		Cntn.Image0.top 	= 138
		Cntn.ChkPOTP.top 	= 138
		Cntn.imgPOTP.top 	= 152
		Cntn.Image1.top 	= 222
		Cntn.ChkMOTP.top 	= 222
		Cntn.imgMOTP.top 	= 236
		Cntn.Table1.SetCellString( 0, 0, "이어서 온라인 로그인을 위한 OTP처리가 진행")
		Cntn.Table1.SetCellString( 1, 0, "됩니다. OTP 유형을 선택하세요.")
		Cntn.Table1.SetCellString( 2, 0, "")
		Cntn.Table1.SetCellFgColor( 0, 0, 3 )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_oimf_491r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_Acno )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_oimf_491r" Then
		IsncDate		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SCRC_ISNC_DATE", 0 )
		ScrcStatCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SCRC_STAT_CODE", 0 )
		MstkTmnu		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ISNC_TMNU", 0 )
		If ScrcStatCode == "01" And CInt(MstkTmnu) >= 5 Then
			StatName	= "오류횟수 초과(사용불가)"
		Else
			StatName	= Form.GetMetaData("보안카드상태코드", DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SCRC_STAT_CODE", 0 ) )
		End If
		
		Cntn.Table0.SetCellString( 3, 2, "보안카드" )
		Cntn.Table0.SetCellString( 4, 2, IsncDate )
		Cntn.Table0.SetCellString( 5, 2, StatName )
		
	End If
End Sub

'============================================================================
Sub Cntn_ChkPOTP_OnChange(sCheckState)
	If sCheckState == "1" Then
		Form.setTimerEvent2(0, 1, 0.5)
		Cntn.Image0.SetStatus("focus")
		Cntn.ChkMOTP.checkstate = "0"
		Cntn.ChkSkip.checkstate = "0"
		Cntn.Image1.Setstatus("normal")
		Cntn.Image2.Setstatus("normal")
		Cntn.imgPOTP.imgpath = "icon_otp_on.png"
		Cntn.imgMOTP.imgpath = "icon_mobile_off.png"
	Else
		Cntn.ChkPOTP.checkstate = "0"
		Cntn.Image0.Setstatus("normal")
		Cntn.imgPOTP.imgpath = "icon_otp_off.png"
	End If
End Sub

'============================================================================
Sub Cntn_ChkMOTP_OnChange(sCheckState)
	If sCheckState == "1" Then
		Form.SetTimerEvent2(99, 1, 0.5)
		Cntn.Image1.Setstatus("focus")
		Cntn.ChkPOTP.checkstate = "0"
		Cntn.ChkSkip.checkstate = "0"
		Cntn.Image0.Setstatus("normal")
		Cntn.Image2.Setstatus("normal")
		Cntn.imgPOTP.imgpath = "icon_otp_off.png"
		Cntn.imgMOTP.imgpath = "icon_mobile_on.png"
	Else
		Cntn.ChkMOTP.checkstate = "0"
		Cntn.Image1.Setstatus("normal")
		Cntn.imgMOTP.imgpath = "icon_mobile_off.png"
	End If
End Sub

'============================================================================
Sub Cntn_ChkSkip_OnChange(sCheckState)
	Cntn.ChkMOTP.chkdata = 0
	Cntn.ChkPOTP.chkdata = 0
	
	If sCheckState == "1" Then
		Form.SetTimerEvent2(2, 1, 0.5)
		Cntn.Image2.Setstatus("focus")
		Cntn.ChkMOTP.checkstate = "0"
		Cntn.ChkPOTP.checkstate = "0"
		Cntn.Image1.Setstatus("normal")
		Cntn.Image0.Setstatus("normal")
		Cntn.imgPOTP.imgpath = "icon_otp_off.png"
		Cntn.imgMOTP.imgpath = "icon_mobile_off.png"
	Else
		Cntn.ChkSkip.checkstate = "0"
		Cntn.Image2.Setstatus("normal")
	End If
End Sub

'============================================================================
Sub imgGoToHome_OnClick()
'	Form.OpenScreen("41000" , "")
	Form.MsgBox( "알림", "OTP 등록/발급을 중단하시겠습니까?", "imgGoToHome", 1 )
End Sub

