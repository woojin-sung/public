	<SCRIPT_INFO _len="2125" _ulen="2051" >
'--==========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 2024.06.26 성우진
' 04. 수    정 :
'============================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	Img0.setMaintainingRatio("1")
End Sub
'============================================================================
'

'============================================================================
Sub Form_OnFormInit()
	
	szData = Form.GetOpenLinkData()
	
	sSplitData = Split(szData, "★")
	
	if Ubound(sSplitData) > 0 then
		'청약 취소하기
		if sSplitData(0) == "SubScriptionCancel" then
			Label0.top = 197
			Label0.caption = "청약이 취소되었습니다."
			Label1.caption = ""
			Table0.SetCellString(3,1 , "청약금액")
			Table0.SetCellString(4,1 , "")
			Table0.SetCellString(5,1 , "")
			
			Table0.SetCellMaskInfo(1, 2, "1,0,,,1,,0,1,1")
			Table0.SetCellMaskInfo(2, 2, "1,0,,,1,,0,1,1")
			Table0.SetCellMaskInfo(3, 2, "0,0,,원,1,,0,1,1")
			
			Table0.SetCellString(1,2 , sSplitData(1))
			Table0.SetCellString(2,2 , sSplitData(2))
			Table0.SetCellString(3,2 , sSplitData(3))
		
		elseif sSplitData(0) == "SubScription" then
			Table0.SetCellMaskInfo(1, 2, "1,0,,,1,,0,1,1")
			Table0.SetCellMaskInfo(2, 2, "1,0,,,1,,0,1,1")
			Table0.SetCellMaskInfo(3, 2, "0,0,,주,1,,0,1,1")
			
			Table0.SetCellString(1,2 , sSplitData(1))
			Table0.SetCellString(2,2 , sSplitData(2))
			Table0.SetCellString(3,2 , sSplitData(3))
			Table0.SetCellString(4,2 , sSplitData(4))
			Table0.SetCellString(5,2 , sSplitData(5))
		end if
	end if
End Sub



'============================================================================



'============================================================================
Sub BtnOK_OnClick()
	Form.SendReturnToParent("mbfnp53100_p3" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	
End Sub

