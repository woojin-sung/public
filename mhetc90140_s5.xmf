		<BUTTON name="Button0" caption="다음" bgcolor="085:205216147" bgcolor2="102:216216216" fontsize="4" fontstyle="01" btnimage="btn_20.9" ly_vert="0,527,375,60,1" />
		<LABEL name="LblTitle" fontsize="6" fontstyle="01" caption="전송요구 내역 세부 설정" ly_vert="5,45,365,26,1" />
		<IMAGE name="Image1" autosize="1" imgpath="icon_4stepline.png" ly_vert="0,1,375,30,1" />
		<CHKBUTTON name="Chk1Y" fontsize="-2" chkcaption="예 (주1회)" unchkcaption="예 (주1회)" ly_vert="35,343,100,27,1" />
		<CHKBUTTON name="Chk1N" fontsize="-2" chkcaption="아니오" unchkcaption="아니오" ly_vert="175,343,100,27,1" />
		<CHKBUTTON name="Chk2Y" enable="0" fontsize="-2" chkcaption="1년" unchkcaption="1년" ly_vert="35,405,100,27,1" />
		<CHKBUTTON name="Chk2N" enable="0" fontsize="-2" chkcaption="1년 범위 내 직접 선택" unchkcaption="1년 범위 내 직접 선택" ly_vert="175,405,166,27,1" />
		<CHKBUTTON name="ChkAgree" chkcaption="상기와 같이 전송요구에 동의합니다." unchkcaption="상기와 같이 전송요구에 동의합니다." ly_vert="9,485,357,32,1" />
		<LABEL name="LblScope" fontsize="-2" caption="보유 계좌정보, 잔액정보, 거래내역, 개별상품기본정보" ly_vert="20,108,336,32,1" />
		<LABEL name="Label1" fontsize="-1" fontstyle="01" caption="■ 전송을 요구하는 개인신용 정보" ly_vert="9,92,342,18,1" />
		<LABEL name="Label2" fontsize="-1" fontstyle="01" caption="■ 개인신용정보를 제공 받는 자" ly_vert="9,156,342,18,1" />
