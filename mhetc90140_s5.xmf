			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="전송요구를 통한 본인신용정보 통합조회," fontsize="-2" impidxs="" />
				<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="데이터분석 서비스의 이용" fontsize="-2" impidxs="" />
