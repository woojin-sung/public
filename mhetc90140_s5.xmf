	<SCRIPT_INFO _len="4953" _ulen="4635" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_today
Dim g_yearDate
'============================================================================
Sub Button0_OnClick()
	call Save_Select()
	Form.triggerEvent( "#", "NextStep", "1" )
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'접근범위 세팅
'	scope = Form.GetSharedData("&MYDATA_SCOPE", false )
	scope = Form.GetSharedData("&MYDATA_MAP_ANNACNT", false )
'	if scope ="invest.account" then
	if scope = "available" then
		LblScope0.visible = true
	else
		LblScope0.visible = false
	end if
	
	'본인신용정보관리회사의 상호
	szName = Form.GetSharedData("&MYDATA_CLIENT_ORG_NM", false )
'	szName = Form.GetSharedData("&MYDATA_CLIENT_SVC_NM", false )
	LblName.caption = szName
	
	'정기전송 여부 세팅
	scheduled = Form.GetSharedData("&MYDATA_IS_SCHEDULED", false )
	if scheduled = "true" then
		Chk1Y.checkstate = 1
		call Chk1Y_OnChange("1")
	else
		Chk1N.checkstate = 1
		call Chk1N_OnChange("1")
	end if
	
	g_today = Form.GetSharedData("&HOST_DATE"  , false) '당일
	g_yearDate = Int(g_today)+10000 				  '1년후
	
	Button0.enable = False
End Sub

'============================================================================
Sub Save_Select()
	Form.SetSharedData("&MYDATA_PURPOSE"		, "본인신용정보 통합조회" )	'전송목적
	if Chk2Y.checkstate = "1" then
		end_date = g_yearDate
	elseif Chk2N.checkstate = "1" then
		end_date = Int(DueDate.caption)
	end if
	
	if Chk1Y.checkstate = "1" then
		Form.SetSharedData("&MYDATA_IS_SCHEDULED", "true" )
		Form.SetSharedData("&MYDATA_FND_CYCLE", "1/w" )
		Form.SetSharedData("&MYDATA_ADD_CYCLE", "1/w" )
	elseif Chk1N.checkstate = "1" then
		Form.SetSharedData("&MYDATA_IS_SCHEDULED", "false" )
		Form.SetSharedData("&MYDATA_FND_CYCLE", "" )
		Form.SetSharedData("&MYDATA_ADD_CYCLE", "" )
	end if
	
	Form.SetSharedData("&MYDATA_END_DATE"	 , end_date )				'전송종료일자
	Form.SetSharedData("&MYDATA_HOLDING_PERIOD", "99991231" )			'전송요구기간
	Form.SetSharedData("&MYDATA_IS_CONSENT_TRANS_MEMO", " " )			'적요전송요구여부
	Form.SetSharedData("&MYDATA_IS_CONSENT_MERCHANT_NAME", " " )		'가맹점명전송요구여부
	Form.SetSharedData("&MYDATA_IS_CONSENT_TRANS_CATEGORY", " " )		'상품분류전송요구여부
'	Form.SetSharedData("&MYDATA_REQ_DATETIME", " " )					'인가코드 발급요청 일자
End Sub

'============================================================================
Sub ChkAgree_OnChange(sCheckState)
	if sCheckState = "1" then
		if Chk1Y.checkstate = "1" or Chk1N.checkstate = "1" then
			if Chk2Y.checkstate = "1" or Chk2N.checkstate = "1" then
				Button0.enable = True
			else
				Form.MsgBox("알림", "모든 항목에 체크 후 다음단계로 이동가능합니다.", "", 6)
				ChkAgree.chksilence = "0"
			end if
'		elseif Chk1N.checkstate = "1" then
'			Button0.enable = True
		else
			Form.MsgBox("알림", "모든 항목에 체크 후 다음단계로 이동가능합니다.", "", 6)
			ChkAgree.chksilence = "0"
		end if
	else
		Button0.enable = False
	end if
End Sub

'============================================================================
Sub DueDate_OnEditComplete()									'당일 1년후
	if Int(DueDate.caption) > g_yearDate then
		Form.ShowAlert("알림", "1년 범위 내 날짜만 선택가능합니다.")
		DueDate.caption = g_today
	end if
End Sub

'============================================================================
Sub Chk1Y_OnChange(sCheckState)
	Chk2Y.chksilence = "0"
	Chk2N.chksilence = "0"
	DueDate.visible = false
	if sCheckState = "1" then
		Chk2Y.enable = true
		Chk2N.enable = true
		if Chk1N.checkstate = "1" then
			Chk1N.chksilence = "0"
		end if
	else 
		Chk2Y.enable = false
		Chk2N.enable = false
	end if
End Sub

'============================================================================
Sub Chk1N_OnChange(sCheckState)
	Chk2Y.chksilence = "0"
	Chk2N.chksilence = "0"
	DueDate.visible = false
	if sCheckState = "1" then
		Chk2Y.enable = true
		Chk2N.enable = true
		if Chk1Y.checkstate = "1" then
			Chk1Y.chksilence = "0"
		end if
	else 
		Chk2Y.enable = false
		Chk2N.enable = false
	end if	
End Sub

'============================================================================
Sub Chk2Y_OnChange(sCheckState)
	if sCheckState = "1" then
		if Chk2N.checkstate = "1" then
			Chk2N.chksilence = "0"
			DueDate.visible = false
		end if
	end if
End Sub

'============================================================================
Sub Chk2N_OnChange(sCheckState)
	if sCheckState = "1" then
		if Chk2Y.checkstate = "1" then
			Chk2Y.chksilence = "0"
		end if
		DueDate.visible = true
	else
		DueDate.visible = false
	end if
	
End Sub

	</SCRIPT_INFO>
</ROOT>