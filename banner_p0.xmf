'============================================================================
Sub Container0_RadioGroup0_OnClick(nIndex)
	
'	if g_sOpen = "N" or g_sOpen = "ISA" then
'	else
'		Container0.scroll_pos = 845
'	end if
	
	if Container0.RadioGroup0.currentindex == "0" then
		g_AgreeCYN = "Y"
	elseif Container0.RadioGroup0.currentindex == "1" then
		g_AgreeCYN = "N"
	end if
	
	Container0.uniSetScroll("1", 760)
End Sub
'============================================================================

'============================================================================
Sub Container0_RadioGroup1_OnClick(nIndex)
	if Container0.RadioGroup1.currentindex == "0" then
		g_AgreeYN = "Y"
	elseif Container0.RadioGroup1.currentindex == "1" then
		g_AgreeYN = "N"
	end if
End Sub

'============================================================================
Sub Container0_ButtonApply_OnClick()
	
	'20230309 SWJ START
	if g_sOpen = "CreditInfo" then
		if Cint(g_sDate) < 20230315 then
			Form.MsgBox( "알림", "이벤트 신청은 3월 15일부터 가능합니다.", "", 6 )
			exit sub
		elseif Cint(g_sDate) > 20230515 then
			Form.MsgBox("알림", "종료된 이벤트 입니다.", "", 6)
			exit sub
		end if
	end if
	'20230309 SWJ END
	
	'20230414 SWJ START
	if g_sOpen == "AceEtf" then
		if Cint(g_sDate) < 20230417 then
			Form.MsgBox( "알림", "이벤트 신청은 4월 17일부터 가능합니다.", "", 6 )
			exit sub
		elseif Cint(g_sDate) > 20230623 then
			Form.MsgBox("알림", "종료된 이벤트 입니다.", "", 6)
			exit sub
		end if
	end if
	'20230414 SWJ END
	
	'20240423 SWJ START
	if g_sOpen == "EtnEvent" then
		if Cint(g_sDate) < 20240425 then
			Form.MsgBox( "알림", "이벤트 신청은 4월 25일부터 가능합니다.", "", 6 )
			exit sub
		elseif Cint(g_sDate) > 20240530 then
			Form.MsgBox("알림", "종료된 이벤트 입니다.", "", 6)
			exit sub
		end if
	end if
	'20240423 SWJ END
	
	if g_AgreeYN == null or g_AgreeCYN == null then
		Form.MsgBox( "알림", "동의 또는 미동의 버튼을 눌러주세요.", "", 6 )
	elseif g_AgreeYN == "Y" and g_AgreeCYN == "Y" then			
		if g_bAgree == "Y" and g_bCAgree == "Y" then
			Form.MsgBox( "알림", "신청 내역이 존재합니다.", "CLOSE", 6 )			
		else
			DATAMANAGER.RequestTranData("ooopc_evca_121a")
		end if
	else
		DATAMANAGER.RequestTranData("ooopc_evca_121a")
	end if
End Sub

