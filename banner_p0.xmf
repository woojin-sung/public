'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ooopc_evca_121a" then
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "CSNO"    		  	   , 0 	, g_sCsNo	)
		
		if g_sOpen = "Y" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00004")		'디지털금융센터 개점 이벤트
		elseif g_sOpen = "COMBINE" then																				'ETN 이벤트 -> 통합증거금 이벤트
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00008")
		elseif g_sOpen = "INDIV"then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00010")		'개인전문투자자 이벤트
		elseif g_sOpen = "ETF"then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00011")		'TIGER ETF 이벤트
		elseif g_sOpen = "STOCKETF"then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00012")		'ETF 증정 이벤트
		elseif g_sOpen = "ISA" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00006")
		elseif g_sOpen = "BDMSTOCK" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00014")		'국내주식 이벤트
		elseif g_sOpen = "ETF2" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00015")		'ETF 이벤트2
		elseif g_sOpen = "CFDSUPER" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00016")		'CFD 베트남 이벤트	'20230206 SWJ START
		elseif g_sOpen = "CreditInfo" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00017")		'개인신용정보제공동의 이벤트 '20230309 SWJ START
		elseif g_sOpen = "AceEtf" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00018")		'ACE ETF 이벤트 '20230414 SWJ START
		elseif g_sOpen = "EtnEvent" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00019")
		else
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00019")   	'EVENT00001은 비대면이벤트, EVENT00002는 CFD이벤트, EVENT00007은 CFD 11월 이벤트
		end if
		
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "CRIN_GTHR_UTLZ_AGRM_YN" , 0 	, g_AgreeCYN 	) 		'신용정보제공동의여부
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "INFO_OFER_AGRM_YN" 	   , 0   , g_AgreeYN 	)  		'정보제공동의여부
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "REG_DATE" 			   , 0   , g_sDate 	)  		'등록일자
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "REG_YMDH" 			   , 0   , g_sDate..g_sTime	)  	'등록일시
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_121a", "InBlock1", "TERM_ID" 			   , 0   , g_DeviceID  )  		'고객 단말정보
		
	elseif szTranID == "ooopc_evca_123r" then
		DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "CSNO" 			   	   , 0 	, g_sCsNo     )
		
		if g_sOpen = "Y" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00004")		'디지털금융센터 개점 이벤트
		elseif g_sOpen = "COMBINE" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00008")		'통합증거금 이벤트
		elseif g_sOpen = "INDIV"then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00010")		'개인전문투자자 이벤트
		elseif g_sOpen = "ETF"then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00011")		'TIGER ETF 이벤트
		elseif g_sOpen = "STOCKETF"then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00017")		'ETF 증정 이벤트	'20230309 SWJ START : 개인신용정보제공동의 이벤트
		elseif g_sOpen = "ISA" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00006")		'ISA 이벤트
		elseif g_sOpen = "BDMSTOCK" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00014")		'국내주식 이벤트
		elseif g_sOpen = "ETF2" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00015")		'ETF 이벤트2
		elseif g_sOpen = "CFDSUPER" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00016")		'CFD 베트남 이벤트		'20230206 SWJ START
		elseif g_sOpen = "CreditInfo" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00017")		'개인신용정보제공동의 이벤트 '20230309 SWJ START
		elseif g_sOpen = "AceEtf" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00018")		'ACE ETF 이벤트 '20230414 SWJ START
		elseif g_sOpen = "EtnEvent" then
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00019")
		else
			DATAMANAGER.SetDataValue( 0, "ooopc_evca_123r", "InBlock1", "EVNT_ID" 			   , 0 	, "EVENT00019")		'20210817 SWJ START
		end if
		
	elseif szTranID == "obaci_acct_269r" then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_269r", "InBlock1", "CSNO" 			   , 0 	, g_sCsNo)
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ooopc_evca_123r" then
		g_bCAgree  = DATAMANAGER.GetDataValue( 0 , "ooopc_evca_123r", "OutBlock1", "CRIN_GTHR_UTLZ_AGRM_YN" , 0)
		g_bAgree = DATAMANAGER.GetDataValue( 0 , "ooopc_evca_123r", "OutBlock1", "INFO_OFER_AGRM_YN"      , 0)
		
		if g_bAgree = "Y" then
			Container0.RadioGroup1.currentindex = "0"
		elseif g_bAgree = "N" then
			Container0.RadioGroup1.currentindex = "1"
		end if
		
		if g_bCAgree = "Y" then
			Container0.RadioGroup0.currentindex = "0"
			'Container1.RadioGroup0.currentindex = "0"
		elseif g_bCAgree = "N" then
			Container0.RadioGroup0.currentindex = "1"
			'Container1.RadioGroup0.currentindex = "1"
		end if
		
		'20230309 SWJ START
		if g_sOpen = "CreditInfo" then
			if g_bAgree = "Y" and g_bCAgree = "Y" then
				Form.MsgBox( "알림", "신청내역이 존재합니다. (단, 대상자인 경우 개인(신용)정보동의 처리를 하셔야 이벤트 참여가 가능합니다.)\n\n메뉴로 이동하시겠습니까?", "mbonl81020", 1 )
			end if
		end if
		'20230309 SWJ END
		
	'20210817 SWJ START : 로직 변경
	elseif szTranID == "ooopc_evca_121a" then
		g_sCAgree = DATAMANAGER.GetDataValue( 0 , "ooopc_evca_121a", "OutBlock1", "CRIN_GTHR_UTLZ_AGRM_YN" , 0)
		g_sIAgree = DATAMANAGER.GetDataValue( 0 , "ooopc_evca_121a", "OutBlock1", "INFO_OFER_AGRM_YN"      , 0)
		
		if g_sOpen = "BDMSTOCK" then
			if g_sCAgree = "Y" then 			
				Form.MsgBox( "알림", "신청이 완료되었습니다.", "CLOSE", 6 )
			else
				Form.MsgBox( "알림", "미동의시 이벤트 신청이 불가합니다.", "CLOSE", 6 )
			end if
		'20230309 SWJ START
		elseif g_sOpen = "CreditInfo" then
			if g_sCAgree = "Y" and g_sIAgree = "Y" then 			
				Form.MsgBox( "알림", "신청이 완료되었습니다. (단, 대상자인 경우 개인(신용)정보동의 처리를 하셔야 이벤트 참여가 가능합니다.)\n\n메뉴로 이동하시겠습니까?", "mbonl81020", 1 )
			else
				Form.MsgBox( "알림", "미동의시 이벤트 신청이 불가합니다.", "CLOSE", 1 )
			end if
		'20230309 SWJ END
		else
			if g_sCAgree = "Y" and g_sIAgree = "Y" then 			
				Form.MsgBox( "알림", "신청이 완료되었습니다.", "CLOSE", 6 )
			else
				Form.MsgBox( "알림", "미동의시 이벤트 신청이 불가합니다.", "CLOSE", 6 )
			end if
		end if
	'20210817 SWJ END
	
	elseif szTranID == "obaci_acct_269r" then
		szEVNT_TRGT_YN = DATAMANAGER.GetDataValue( 0 , "obaci_acct_269r", "OutBlock1", "EVNT_TRGT_YN"      , 0)
		
		'대상자
		if szEVNT_TRGT_YN == "Y" then
			DATAMANAGER.RequestTranData("ooopc_evca_123r")
		else
			Form.MsgBox( "알림", "이벤트 대상자가 아닙니다.", "CLOSE", 6 )
		end if
	end if
End Sub

'============================================================================
'
'============================================================================
'20210817 SWJ START : 에러 메시지 추가
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "ooopc_evca_121a" or szTranID == "ooopc_evca_123r" then
		Dim sSubMsg
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID ) 	
		szErrMsg = szErrMsg & "\n" & sSubMsg
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2("1", 0, 0.4)
		
		if g_sOpen == "CreditInfo" then
			DATAMANAGER.RequestTranData("obaci_acct_269r")
		else
			DATAMANAGER.RequestTranData("ooopc_evca_123r")
		end if
	end if
End Sub


