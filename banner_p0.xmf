	<SCRIPT_INFO _len="15459" _ulen="13941" >
'============================================================================
'20210429 SWJ START : 비대면 통합 이벤트 관련 정보제공 동의 및 이벤트 신청
'============================================================================
Dim g_LoginType
Dim g_AgreeCYN,g_AgreeYN,g_sCsNo, g_bAgree, g_bCAgree
Dim g_sDate,g_sTime, g_DeviceID, g_sOpen, g_szScreen
Dim g_DeviceOS
'============================================================================
Sub Form_OnFormInit()
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", 0 )
	g_sCsNo 	   = Form.GetSharedData("&CUST_NUM"  , false )	 '고객번호
	g_sDate 	   = Form.GetSharedData("&HOST_DATE"  , false )	 
	g_sTime 	   = Form.GetSharedData("&HOST_TIME"  , false )
	g_DeviceOS  = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	'20211124 SWJ START : 디지털 이벤트 추가
	g_sOpen 	   = Form.GetSharedData("DIGITAL_EVENT", true )
	
	'20220627 SWJ START : 모바일 웹에서 내부 화면 호출하는 경우, 화면번호가 필요함
	'바로 호출하기 때문에, 화면번호에 따라 g_sOpen 변수를 맞춰주기
	'(내부에서 오픈하는 경우랑 맞춰주기 위함)
	g_szScreen = Form.GetSharedData("&POPUP_SCREEN_NO", false)

'	if g_szScreen == "90170" then
'		'g_sOpen = "STOCKETF"
'		g_sOpen = "CreditInfo"									'20230309 SWJ START : 마케팅동의이벤트
'	elseif g_szScreen == "90180" then							'20230414 SWJ START : ETF 이벤트
'		g_sOpen = "AceEtf"
'	elseif g_szScreen == "90160" or g_szScreen == "90190" then		'20220901 SWJ START : 신규 이벤트 추가 '20221102 SWJ START : 이벤트 분리
'		g_sOpen = "BDMSTOCK"
'	elseif g_szScreen = "90150" then							'20230206 SWJ START : CFD 이벤트 추가
'		g_sOpen = "CFDSUPER"
'	end if
	if g_szScreen == "90150" then
		g_sOpen = "EtnEvent"
	end if
	'20220628 SWJ END
	
	g_DeviceID  = Form.GetDeviceID()
			
	'20220627 SWJ START : 모바일웹에서 접근할 때, 로그인 여부 판단
	if Cint(g_LoginType) > 1 then '로그인상태
		if g_DeviceOS == "1" then
			if g_sOpen == "CreditInfo" then
				DATAMANAGER.RequestTranData("obaci_acct_269r")
			else
				DATAMANAGER.RequestTranData("ooopc_evca_123r")
			end if
		'iOS 모바일웹에서 진입 시(MTS는 이미 로그인 상태여서 강제로그인 안시킬 때)
		'서비스를 못태워서 타이머 이벤트
		else
			Form.SetTimerEvent2("1",1, 0.4)
		end if
	else
		Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
	end if
	
	'Container0.uniSetScroll("1", 100)
	'20220627 SWJ END
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.Image1.setmaintainingratio("1")
	Container0.Image3.setmaintainingratio("1")
	Container0.Image0.setmaintainingratio("1")
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOG_FORCE" then
		if sRet == "ok" then
			Form.SetSharedData("BDM_CORPORATE", "Y")
			Form.OpenNextPopup("mhetc90021" , "" , "")	
		else
			Form.CloseForm()			
		end if
	elseif sKeyName == "CLOSE" then
		Form.CloseForm()
		
	'20230309 SWJ START
	elseif sKeyName == "mbonl81020" then
		if sRet == "ok" then
			Form.CloseForm()
			Form.OpenScreen("81020" , "탭이동;1")
		else
			Form.CloseForm()
		end if
	'20230309 SWJ END
	end if
End Sub

'============================================================================
Sub Container0_Image5_OnClick()
	Form.CloseForm()
End Sub
