<ROOT>
	<MAP_INFO scrno="50010" scrname="ETF(HOME)_검색" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,225,1" />
	<CONTROL_INFO>
		<LABEL name="LabelScreenTitle" fontsize="2" fontstyle="01" caption="ETF Super 검색" bgcolor="029:255212175" ly_vert="20,10,335,23,1" />
		<IMAGE name="ImageBackGround" autosize="1" ly_vert="20,43,335,161,1" />
		<LABEL name="Label1" fontsize="-1" caption="강력한 파워 검색 기능" halign="1" ly_vert="20,67,335,32,1" />
		<LABEL name="Label2" fontsize="4" fontstyle="01" caption="<![CDATA[메리츠가 바꿔놓은 검색 판 >]]>" halign="1" click="1" ly_vert="20,91,335,32,1" />
		<IMAGE name="ImageSearchBackGround" ly_vert="40,140,295,44,1" />
		<IMAGE name="iconSearch" autosize="1" ly_vert="60,154,16,16,1" />
		<LABEL name="Label3" fontsize="-2" caption="다양한 조건으로 빠르게 검색해 보세요." autofontsize="1" click="1" ly_vert="76,140,238,44,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1553" _ulen="1459" >
'============================================================================
Sub Form_OnFormInit()

	'------------------------------------------------------------------------
	'전체 배경이미지
	'------------------------------------------------------------------------
	ImageBackGround.imgpath = "img_bground_391_392_10"
	
	'------------------------------------------------------------------------
	'검색창
	'------------------------------------------------------------------------

	'배경이미지
	'ImageSearchBackGround.setMaintainingRatio("1")
	ImageSearchBackGround.imgpath = "img_white_searchbar.9"
	
	'돋보기이미지
	iconSearch.setMaintainingRatio("1")
	iconSearch.imgpath = "icon_search"
	
	'------------------------------------------------------------------------
	'글자색상
	'------------------------------------------------------------------------
	Label1.fgcolor = 338 '흰색
	Label2.fgcolor = 338 '흰색
	Label3.fgcolor = 65  '회색
	
	LabelScreenTitle.paddinginfo = "0,0,0,0"
	
	
End Sub

'============================================================================
' ETF Super검색 화면으로 이동
'============================================================================
Sub Label3_OnClick()
	Form.OpenScreen("50100" , "")
End Sub

'============================================================================
' ETF Super검색 화면으로 이동
'============================================================================
Sub Label2_OnClick()
	Form.OpenScreen("50100" , "")
End Sub

