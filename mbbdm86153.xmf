		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN8"           , "")		'해외CFD 계좌신청여부(일본/안심)
		
		Form.SetSharedData("BDM_PNSN_TCTR_CLS_CODE"          , "")		'연금이관구분코드(신규/이수전용)
