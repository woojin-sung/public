Sub btnNext_OnClick()
	btnNext.enable = false
    if Form.GetEnvData("common.theme") == "black" then
        btnNext.btnimage = "btn_27.9"
    else
        btnNext.btnimage = "btn_21.9"
    end if
    btnNext.fgcolor = "269"
	
	Form.runAlcCamera()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if CInt(sTimerID) == 1 then
'		Form.ShowAlert("11", g_nTrCount)
		Form.SetTimerEvent2(1, 0, 1.5)
		
		DATAMANAGER.RequestTranData( "obcsb_face_002a" )
	
	elseif CInt(sTimerID) == 2 then
		Form.SetTimerEvent2(2, 0, 0.5)
		
		DATAMANAGER.RequestTranData( "obcsb_face_002a" )
	end if
End Sub

