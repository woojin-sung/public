Dim g_szCheckYn
Dim g_szCheckSubYn1
Dim g_szCheckSubYn2

Dim g_szLivnessSrno

Dim g_InputTrDate
Dim g_InputRcnoPip
Dim g_InputSnmsSrno
Dim g_InputHgrnSdrt
Dim g_InputLrnkSdrt

Dim g_nTrCount
Dim g_nErrCount

'============================================================================
Sub Form_OnFormInitBefore()
	imgCtcnChkAll.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	imgStep.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'뒤로가기(물리버튼) 막음
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	btnNext.enable = false
    if Form.GetEnvData("common.theme") == "black" then
        btnNext.btnimage = "btn_27.9"
    else
        btnNext.btnimage = "btn_21.9"
    end if
    btnNext.fgcolor = "269"
	
	g_nTrCount = 0
	g_nErrCount = 0
	
	g_szCheckYn = "N"
	g_szCheckSubYn1 = "N"
	g_szCheckSubYn2 = "N"
	
	User_SharedData_Get()
	
	f_SetData()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'개인(신용)정보처리필수동의서	
	if sKeyName == G_STEP2_2_P2_FILE then
		if sRet == "ok" then
			lblCtcnAll_OnClick()
		end if
	elseif sKeyName == "mbbdm86153_p1" then
		Form.OpenNextPopup("mbbdm85100", "", "")
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ABORT" and sRet == "ok" then
		if g_BDMNMETBSWRGB == "100" then
			Form.OpenNextPopup("mbbdm85100", "", "")
		else
			Form.CloseForm()
		end if
	
	elseif sKeyName == "FACE_ERROR" then
		if sRet == "ok" then
			Form.runAlcCamera()
		else
			Form.OpenNextPopup("mbbdm85100", "", "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert(sEventName, sParam)
	if sEventName == "ALC_COMPLETE" then
		g_nTrCount = 0
		
		DATAMANAGER.RequestTranData( "obcsb_face_003a" )
	
	elseif sEventName == "ALC_ERROR" then	
		btnNext.enable = true
					
		btnNext.btnimage = "btn_20.9"
		btnNext.fgcolor = "273"	
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Image1_OnClick()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'뒤로가기(물리버튼) 활성화
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'안면인식_라이브니스확인요청
	if szTranID == "obcsb_face_003a" then
		Dim szFaceImg, szImgLen, szStatusCd, szConfidence, szReturnCd, szReturnMsg
		szFaceImg = Form.GetSharedData( "&RET_ALC_FACE_IMAGE", false )
		szStatusCd = Form.GetSharedData( "&RET_ALC_STATUS_CD", false )
		szConfidence = Form.GetSharedData( "&RET_ALC_CONFIDENCE", false )
		szReturnCd = Form.GetSharedData( "&RET_ALC_RETURN_CODE", false )
		szReturnMsg = Form.GetSharedData( "&RET_ALC_RETURN_MSG", false )
		if szFaceImg <> "" and szFaceImg <> null then
			szImgLen = Len(szFaceImg)
		end if
	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CNFR_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , g_BDM_RCNO_PIP)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLOT_API_NAME" , 0 , "test")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "HTTP_STAT_CODE" , 0 , szStatusCd)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LIVNESS_RSCD" , 0 , szReturnCd)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RSPN_CODE_CNTT" , 0 , szReturnMsg)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONF" , 0 , szConfidence)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ATCH_FILE_SIZE" , 0 , szImgLen)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "UI_IMG_DATA" , 0 , szFaceImg)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IDNTF_SRNO" , 0 , g_BDM_IDNTF_SRNO)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "REG_UNIQ_NO" , 0 , g_BDM_REG_UNIQ_NO)
	
	'금결원_안면인식진위확인요청
	elseif szTranID == "obcsb_face_001a" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TR_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , g_BDM_RCNO_PIP)
'		if g_BDM_CERT_METHOD == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IDNTF_SRNO"			, 0 , g_BDM_IDNTF_SRNO		)
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IDNTF_SRNO"			, 0 , g_SRNO		)
'		end if
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LIVNESS_CNFR_SRNO" , 0 , g_szLivnessSrno)
'		if g_ID_CARD_TYPE == "10" then		'주민등록증
'			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IDNF_CLS_CODE" , 0 , "1")
'		elseif g_ID_CARD_TYPE == "11" then	'면허증
'			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IDNF_CLS_CODE" , 0 , "2")
'		end if
		'OCR 데이터면 신분증 종류 구분, 모바일신분증이면 "7" 로 고정값
		if g_BDM_CERT_METHOD == "1" then
			if g_ID_CARD_TYPE == "10" then
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNF_CLS_CODE"		, 0 	, "1" 	 			)
			else
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNF_CLS_CODE"		, 0 	, "2" 	 			)
			end if
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNF_CLS_CODE"		, 0 	, "3" 	 			)
		end if
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_CHAN_CLCD" , 0 , "1")
	     DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "REG_UNIQ_NO" , 0 , g_BDM_REG_UNIQ_NO)
	     
	elseif szTranID == "obcsb_face_002a" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TR_DATE" , 0 , g_InputTrDate)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , g_InputRcnoPip)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SNMS_SRNO" , 0 , g_InputSnmsSrno)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RPCS_TMNU" , 0 , g_nTrCount)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "HGRN_SDRT" , 0 , g_InputHgrnSdrt)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LRNK_SDRT" , 0 , g_InputLrnkSdrt)
		
	elseif szTranID == "obaci_acct_158a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"		, 0 	, g_ImgDataLen			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IMG_DATA"		, 0 	, g_ImgData		)
		'OCR 데이터면 신분증 종류 구분, 모바일신분증이면 "7" 로 고정값
		if g_BDM_CERT_METHOD == "1" then
			if g_ID_CARD_TYPE == "10" then
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "1" 	 			)
			else
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "2" 	 			)
			end if
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "3" 	 			)
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"		, 0 	, g_BDM_RCNO_PIP 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BRDT"				, 0 	, Right(g_BIRTH,6)			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_RCNO_7	 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 	, "I" 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SRNO"				, 0 	, ""	 				)
	
	elseif szTranID == "obaci_acct_158a_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"		, 0 	, g_ImgFaceLen			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IMG_DATA"		, 0 	, g_ImgFace		)
		'OCR 데이터면 신분증 종류 구분, 모바일신분증이면 "7" 로 고정값
		if g_BDM_CERT_METHOD == "1" then
			if g_ID_CARD_TYPE == "10" then
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "1" 	 			)
			else
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "2" 	 			)
			end if
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "3" 	 			)
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"		, 0 	, g_MDAF_RCNO_PIP 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BRDT"				, 0 	, Right(g_BIRTH,6)			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_RCNO_7	 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 	, "U" 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SRNO"				, 0 	, g_SRNO	 				)
	
	'비대면계좌개설시 호출
	elseif szTranID == "obcsb_nmet_102c" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NMET_BSWR_CLCD" 		, 0 , g_BDMNMETBSWRGB	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_CLS_CODE"		, 0 , "2")	'2.신분증진위확인
		
		if g_BDM_CERT_METHOD == "1" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"		, 0 	, "3" 	 			)
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"		, 0 	, "" 	 			)
		end if
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , ""		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "TR_DATE"				, 0 , Form.GetSharedData("&HOST_DATE", false )			)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_SRNO"			, 0 , g_SRNO		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"		, 0 , "0"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_TORF_YN"		, 0 , "Y"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , 1		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "RCNO_PIP"	, 0 , g_MDAF_RCNO_PIP		)
		
		'OCR 데이터면 신분증 종류 구분, 모바일신분증이면 "3" 로 고정값
		if g_BDM_CERT_METHOD == "1" then
			if g_ID_CARD_TYPE == "10" then
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "IDNTF_KIND_CODE"		, 0 	, "1" 	 			)
			else
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "IDNTF_KIND_CODE"		, 0 	, "2" 	 			)
			end if
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "IDNTF_KIND_CODE"		, 0 	, "3" 	 			)
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_FLNM"	, 0 , g_NAME		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_RCNO_PIP"	, 0 , g_RCNO		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_IDNTF_FLNM"	, 0 , g_NAME		)
		'test
'		g_ISSU_DATE = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ISNC_DATE"	, 0 , g_ISSU_DATE		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_ISNC_DATE"	, 0 , g_ISSU_DATE 		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OLD_DRVN_LCNS_NO"	, 0 , ""		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_OLD_DRVN_LCNS_NO"	, 0 , ""		)
	
	elseif szTranID == "obaci_acct_059c" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE"	, 0 , "1")
		
		Dim szMccoCode
		If g_BDM_COMPANY_CODE == "1" Or g_BDM_COMPANY_CODE == 1 Then
		    szMccoCode = "SKT"
		ElseIf g_BDM_COMPANY_CODE == "2" Or g_BDM_COMPANY_CODE == 2 Then
		    szMccoCode = "KTF"
		ElseIf g_BDM_COMPANY_CODE == "3" Or g_BDM_COMPANY_CODE == 3 Then
		    szMccoCode = "LGT"
		ElseIf g_BDM_COMPANY_CODE == "5" Or g_BDM_COMPANY_CODE == 5 Then
		    szMccoCode = "SKA "
		ElseIf g_BDM_COMPANY_CODE == "6" Or g_BDM_COMPANY_CODE == 6 Then
		    szMccoCode = "KTA"
		ElseIf g_BDM_COMPANY_CODE == "7" Or g_BDM_COMPANY_CODE == 7 Then
		    szMccoCode = "LGA"
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "RCNO_TYPE_CODE"      , 0 , "01"                     )  '실명확인번호유형코드 01.주민등록번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "RCNO_PIP"            , 0 , g_BDM_RCNO_PIP )  '실명확인번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CUST_ABWR_NAME"      , 0 , g_BDM_NAME )  '고객명
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ATHN_MTHD_CLS_CODE"  , 0 , "1"                      )  '인증방법구분코드 1.휴대폰본인인증 2.인증서인증 3.바이오인증
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ATHN_STAT_CLS_CODE"  , 0 , "1"                      )  '인증상태구분코드 1.정상
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MCCO_CODE"           , 0 , szMccoCode                )  '통신사코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CLPH_ARCD"           , 0 , g_BDM_HP1                  )  '휴대폰
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CLPH_TONO"           , 0 , g_BDM_HP2                  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CPNO"                , 0 , g_BDM_HP3                  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CIKEY_NO"            , 0 , g_BDM_CIKEY                )  'CIKEY번호
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_OTSDTRUNIQNO		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "TR_DATE"				, 0 , Form.GetSharedData("&HOST_DATE", false )			)
		
		'20231102 obaci_acct_158a를 앞화면에서 호출하므로 주석처리
'		if g_BDM_CERT_METHOD == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_SRNO"			, 0 , g_BDM_IDNTF_SRNO		)
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_SRNO"			, 0 , g_SRNO		)
'		end if
'		if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then  'JMY TEST Skip
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"	, 0 , "T")
'		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"	, 0 , "0"		)
'		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_TORF_YN"		, 0 , "Y"		)
		if g_BDM_CERT_METHOD == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_KIND_CODE"	, 0 , "1"		)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_FEATURE_LEN		)
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_KIND_CODE"	, 0 , "3"		)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , 1		)
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "SRNO"	, 0 , g_SRNO2		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "SNMS_SRNO"	, 0 , g_InputSnmsSrno	)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "LIVNESS_CNFR_SRNO"		, 0 , g_szLivnessSrno		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FACEID_ACMP_YN"	, 0 , g_BDM_FACE_YN)
		
		if g_BDM_MNY_ACNT == "Y" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "CNFR_TRGT_CUST_CLCD"	, 0 , 	"01"	)
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "CNFR_TRGT_CUST_CLCD"	, 0 , 	"04"	)
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "ACNT_OPNG_CLCD"	, 0 , 	"1"	)		'신규개설 
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "SAC_ACNT_APLT_YN"               , 0 , g_BDM_PRCD200			)  '슈퍼365신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVTR_JOIN_APLT_YN"              , 0 , g_BDM_PRCD100       	)  '종합매매가입신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "CMA_RP_JOIN_APLT_YN"            , 0 , g_BDM_PRCD118RP		)  'CMARP가입신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "FUTS_OPTN_ACNT_APLT_YN"         , 0 , g_BDM_PRCD101			)  '선물옵션계좌신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVDV_ACNT_APLT_YN"              , 0 , g_BDM_PRCD135			)  '해외파생계좌신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "WRAP_ACNT_APLT_YN"              , 0 , g_BDM_WRAP				)  '랩신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_ACNT_APLT_YN"          , 0 , g_BDM_PRCDCFD			)  'CFD계좌신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_ACNT_APLT_YN"               , 0 , g_BDM_PRCD133			)  'ISA계좌신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_PROD_TYPE_CLCD"				, 0 , g_BDM_ISA_PROD_TYPE			)  'ISA상품유형구분코드(2:일임형 / 3:중개형)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_JOIN_TPCD"					, 0 , "66"						)  'ISA가입유형코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_ACNT_OPNG_CLCD"				, 0 , g_BDM_ISA_ACNT_OPNG_CLCD		)  'ISA계좌개설구분코드(1:신규 / 2:이수)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN"			, 0 , g_BDM_PRCD137				)  '해외CFD계좌신청여부
		
		If g_BDM_PRCDCFD == "Y" Then
			Dim szDMST_CFD_GOAL_MRKT_AGR_YN
			szDMST_CFD_GOAL_MRKT_AGR_YN = ""
			If g_BDM_GOAL_MRKT_UNFIT_YN == "Y" Then
				szDMST_CFD_GOAL_MRKT_AGR_YN = "N"
			ElseIf g_BDM_GOAL_MRKT_UNFIT_YN == "N" Then
				szDMST_CFD_GOAL_MRKT_AGR_YN = "Y"
			End If
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "UI_SRNO"					, 0 , g_BDM_REG_SRNO     			)  '국내CFD목표시장일련번호
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_GOAL_MRKT_AGR_YN"	, 0 , szDMST_CFD_GOAL_MRKT_AGR_YN	)  '국내CFD목표시장일치여부
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "UI_SRNO"         			, 0 , 0							)  '국내CFD목표시장일련번호
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_GOAL_MRKT_AGR_YN"	, 0 , ""							)  '국내CFD목표시장일치여부
		End If
		If g_BDM_PRCD137 == "Y" Then
			Dim szOVRS_CFD_GOAL_MRKT_AGR_YN	
			szOVRS_CFD_GOAL_MRKT_AGR_YN = ""
			If g_BDM_ACFD_GOAL_MRKT_UNFIT_YN == "Y" Then
				szOVRS_CFD_GOAL_MRKT_AGR_YN = "N"
			ElseIf g_BDM_ACFD_GOAL_MRKT_UNFIT_YN == "N" Then
				szOVRS_CFD_GOAL_MRKT_AGR_YN = "Y"
			End If
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_SRNO"         , 0 , g_BDM_ACFD_REG_SRNO     		) '해외CFD목표시장일련번호
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_AGR_YN"       , 0 , szOVRS_CFD_GOAL_MRKT_AGR_YN     ) '해외CFD목표시장일치여부
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_SRNO"         , 0 , 0     )  '해외CFD목표시장일련번호
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_AGR_YN"       , 0 , ""    ) 	'해외CFD목표시장일치여부
		End If
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_ACNT_APLT_YN1"          , 0 , g_BDM_DMST_CFD_ACNT_APLT_YN1		)  '국내CFD 계좌신청여부(일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_ACNT_APLT_YN2"          , 0 , g_BDM_DMST_CFD_ACNT_APLT_YN2		)  '국내CFD 계좌신청여부(안심)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN1"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN1		)  '해외CFD 계좌신청여부(미국/일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN2"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN2		)  '해외CFD 계좌신청여부(미국/안심)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN3"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN3		)  '해외CFD 계좌신청여부(중국/일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN4"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN4		)  '해외CFD 계좌신청여부(중국/일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN5"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN5		)  '해외CFD 계좌신청여부(홍콩/일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN6"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN6		)  '해외CFD 계좌신청여부(홍콩/일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN7"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN7		)  '해외CFD 계좌신청여부(일본/일반)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN8"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN8		)  '해외CFD 계좌신청여부(일본/일반)
		
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_SVNG_ACNT_APLT_YN"         , 0 , g_BDM_PRCD131			)  '연금저축신청여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_TCTR_CLS_CODE"                        , 0 , g_BDM_PNSN_TCTR_CLS_CODE		)			'연금이관구분코드(신규/이수전용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_CNRC_PRD"             		        , 0 , g_BDM_PNSN_CNRC_PRD		)                 '연금계약기간
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_PRVS_BEGN_SCDL_DATE"                  , 0 , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE		)    	'연금지급개시예정일
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_CNRC_AMT"                             , 0 , g_BDM_PNSN_CNRC_AMT				)        '연금계약금액
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_PRVS_BANK_CODE"                       , 0 , g_BDM_PNSN_PRVS_BANK_CODE    		)    	'연금지급은행코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_PRVS_BANK_ACNO"                       , 0 , g_BDM_PNSN_PRVS_BANK_ACNO    		)    	'연금지급은행계좌번호
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "PROS_DATE"	, 0 , 	g_BDM_PROS_DATE	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "PROS_SRNO"	, 0 , 	g_BDM_PROS_SRNO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FNNC_TR_OBJT_CNFR_DATE"	, 0 , 	g_BDM_MNY_PROS_DATE	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FNNC_TR_OBJT_CNFR_SRNO"	, 0 , 	g_BDM_MNY_PROS_SRNO	)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "ACNO"	, 0 , 		""	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "ACNO_PWD"	, 0 , 	""	)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "MANG_BRCD"	, 0 , 	g_BDM_MANG_BRCD	)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "MNGR_EMPNO"	, 0 , 	g_BDM_MANG_EMPNO	)
	
	elseif szTranID == "obaci_acct_234a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_STAG_CLS_CODE"		, 0  , "1"				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_UNIQ_NO"			, 0  , g_BDM_REG_UNIQ_NO	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"			, 0  , g_FEATURE_LEN		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_PHTG_DATA_CNTT"		, 0  , g_FEATURE			)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'안면인식_라이브니스확인요청
	if szTranID == "obcsb_face_003a" then
		g_szLivnessSrno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LIVNESS_CNFR_SRNO" , 0 )
		
		Dim nHGRN_SDRT, nConfidence
		nHGRN_SDRT = CDbl(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "HGRN_SDRT" , 0 ))
		nConfidence = CDbl(Form.GetSharedData( "&RET_ALC_CONFIDENCE", false ))
'		Form.ShowAlert(nHGRN_SDRT,nConfidence)
		if g_szLivnessSrno <> "" and g_szLivnessSrno <> null then
			if nConfidence >= nHGRN_SDRT then
				DATAMANAGER.RequestTranData( "obcsb_face_001a" )
			else
				Form.MsgBox("안내", "얼굴 기준율 미달입니다.\n다시 촬영하시거나\n다음에 개설해주시기 바랍니다.", "FACE_ERROR", 7, "다시 촬영하기", "다음에 개설하기")
			end if
		end if
	
	'금결원_안면인식진위확인요청
	elseif szTranID == "obcsb_face_001a" then
		g_InputTrDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TR_DATE" , 0 )
		g_InputRcnoPip = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RCNO_PIP" , 0 )
		g_InputSnmsSrno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SNMS_SRNO" , 0 )
		g_InputHgrnSdrt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "HGRN_SDRT" , 0 )
		g_InputLrnkSdrt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LRNK_SDRT" , 0 )
		
		'obcsb_face_002a 최초 호출시 약간의 텀을 주고 호출
		Form.SetTimerEvent2(2, 1, 0.5)
		
'		DATAMANAGER.RequestTranData( "obcsb_face_002a" )
	
	elseif szTranID == "obcsb_face_002a" then
		Dim szRspCode
		szRspCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RSPN_CODE" , 0 )
		
		'test
'		szRspCode = "200"
'		Form.ShowAlert("szRspCode", szRspCode)	
		if szRspCode <> "" and szRspCode <> null then		
			if szRspCode == "000" then
				g_nTrCount = 0
				
				if g_BDMNMETBSWRGB == "100" then
					'OCR 촬영하는 경우 obaci_acct_158a 및 idvs_001a, 002a 등 이전 로직은 앞화면에서 수행하므로 acct_059c -> acct_234a 만 호출하여 진행
	'				if g_BDM_CERT_METHOD == "1" then
	'					DATAMANAGER.RequestTranData( "obaci_acct_059c" )
	'				else
	'					DATAMANAGER.RequestTranData( "obaci_acct_158a" )
	'				end if
					
					'20231102 로직 수정 : 앞 화면에서 서비스 호출 전부 수행하고 이 화면에서는 obaci_acct_059c만 호출
					DATAMANAGER.RequestTranData( "obaci_acct_059c" )
				else
					'일단.. 업무신청은 탈 일 없음
					'업무신청은 앞화면에서 전부 수행하고 오기때문에 바로 다음단계로 이동
					Form.OpenPopup("mbbdm86190", "", "")
				end if
			else
				btnNext.enable = true
							
				btnNext.btnimage = "btn_20.9"
				btnNext.fgcolor = "273"	
				
				g_nErrCount = g_nErrCount + 1
				if g_nErrCount < 5 then
					Form.MsgBox("안내", "얼굴 인증 " .. g_nErrCount .. "회 오류입니다.\n다시 촬영하시거나\n다음에 개설해주시기 바랍니다.\n연속 5회 오류 시 얼굴 인증은 제한됩니다.", "FACE_ERROR", 7, "다시 촬영하기", "다음에 개설하기")
				else
					Dim szMsg
					szMsg = "신분증 사진과 얼굴 인증한 이미지가 불일치합니다.\n확인 후 다시 시도하여 주시기 바랍니다."
					Form.OpenPopup("mbbdm86153_p1", szMsg, "")
				end if
			end if
		else
			g_nTrCount = g_nTrCount + 1
			
			if g_nTrCount >= 20 then
				btnNext.enable = true
							
				btnNext.btnimage = "btn_20.9"
				btnNext.fgcolor = "273"	
				
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry = 0 '초기화
				exit sub
			else
'				DATAMANAGER.RequestTranData( "obcsb_face_002a" )
				
				Form.SetTimerEvent2(1, 1, 1.5)
			end if
		end if
	
	elseif szTranID == "obaci_acct_158a" then
		g_SRNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SRNO" , 0 )
		g_BDM_IDNTF_SRNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SRNO" , 0 )
		g_MDAF_RCNO_PIP = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "MDAF_RCNO_PIP" , 0 )
		
		DATAMANAGER.RequestTranData( "obaci_acct_158a_1" )

	elseif szTranID == "obaci_acct_158a_1" then
		DATAMANAGER.RequestTranData( "obcsb_nmet_102c" )
	
	elseif szTranID == "obcsb_nmet_102c" then
		g_SRNO2 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SRNO" , 0 )
		
		'계좌개설은 obaci_acct_059c 호출 후 다음단계(mbbdm86160)
		'업무신청은 바로 다음 단계(mbbdm86190)
		if g_BDMNMETBSWRGB == "100" then
			DATAMANAGER.RequestTranData( "obaci_acct_059c" )
		else
			Form.OpenNextPopup("mbbdm86190", "" , "")
		end if
		
	elseif szTranID == "obaci_acct_059c" then
		'OCR 촬영했다면 obaci_acct_234a를 추가 호출하고 다음단계로 이동
		if g_BDM_CERT_METHOD == "1" then
			DATAMANAGER.RequestTranData( "obaci_acct_234a" )		
		else
			User_SharedData_Set("")
			
			Form.OpenNextPopup("mbbdm86160", "" , "")
		end if
		
	elseif szTranID == "obaci_acct_234a" then
		User_SharedData_Set("")
		
		Form.OpenNextPopup("mbbdm86160", "" , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	btnNext.enable = true
				
	btnNext.btnimage = "btn_20.9"
	btnNext.fgcolor = "273"	
	
	Dim szErrSub
	szErrSub = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szErrSub <> "" and szErrSub <> null then
		Form.ShowAlert("알림" .. szTranID, szErrMsg .. "(" .. szErrSub .. ")")
	else
		Form.ShowAlert("알림" .. szTranID, szErrMsg)
	end if
End Sub

'============================================================================
Function User_SharedData_Get()	'JMY

	'진입점에서 설정되는 정보 ---------------------------------------
	g_BDM_FRST_MAPID        	= Form.GetSharedData("BDM_FRST_MAPID"		, false)	'최초진입화면ID
	g_BDMNMETBSWRGB         	= Form.GetSharedData("BDM_NMETBSWRGB"		, false)	'비대면업무구분
	g_NMETBSWRGB			   	= Form.GetSharedData("BDM_NMETBSWRGB"		, false)	'비대면업무구분
	g_mOTP_IntoClcd			= Form.GetSharedData("mOTP_IntoClcd"			, false)	'(모바일OTP)진입구분코드
	g_BDM_CSNO   				= Form.GetSharedData("BDM_CSNO"   			, false) '고객번호

	'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
	g_BDM_REG_UNIQ_NO       	= Form.GetSharedData("BDM_REG_UNIQ_NO"        , false) '등록고유번호
	g_BDM_REG_STAG_CLS_CODE 	= Form.GetSharedData("BDM_REG_STAG_CLS_CODE"  , false) '등록단계구분코드
