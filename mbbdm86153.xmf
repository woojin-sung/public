Sub lblCtcnAll_OnClick()
	if g_szCheckYn == "Y" then
		imgCtcnChkAll.imgpath = "checkmenu_n"
		contCtcn1.imgCtcnChk.imgpath = "check_line_n"
		contCtcn1.imgAgreeChk1.imgpath = "check_line_n"
		contCtcn1.imgAgreeChk2.imgpath = "check_line_n"
		
		g_szCheckYn = "N"
		g_szCheckSubYn1 = "N"
		g_szCheckSubYn2 = "N"
	else
		imgCtcnChkAll.imgpath = "checkmenu_o"
		contCtcn1.imgCtcnChk.imgpath = "check_line_o"
		contCtcn1.imgAgreeChk1.imgpath = "check_line_o"
		contCtcn1.imgAgreeChk2.imgpath = "check_line_o"
		
		g_szCheckYn = "Y"
		g_szCheckSubYn1 = "Y"
		g_szCheckSubYn2 = "Y"
	end if
	
	f_CheckNextEnable()
End Sub

