		Form.SetSharedData("BDM_MANG_BRCD"          , "")  '관리점
		Form.SetSharedData("BDM_FACE_YN"          , "")	'안면인식 수행 여부
		Form.SetSharedData("BDM_CERT_METHOD"          , "")
		Form.SetSharedData("BDM_SRNO2"          , "")
    else
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"       	, g_BDM_REG_UNIQ_NO   		)	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, g_BDM_REG_STAG_CLS_CODE 	)	'등록단계구분코드
