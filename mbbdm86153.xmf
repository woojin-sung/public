    g_BDM_PRCD101            = Form.GetSharedData("BDM_PRCD101"            , false)  '선물옵션 가입여부
    g_BDM_PRCD135            = Form.GetSharedData("BDM_PRCD135"            , false)  '해외파생 가입여부
    g_BDM_PRCD133            = Form.GetSharedData("BDM_PRCD133"            , false)  'ISA 가입여부
    g_BDM_PRCDCFD            = Form.GetSharedData("BDM_PRCDCFD"            , false)  'CFD 가입여부	
    g_BDM_PRCD137			= Form.GetSharedData("BDM_PRCD137"			, false)	'해외CFD 가입여부
    g_BDM_ISA_PROD_TYPE	= Form.GetSharedData("BDM_ISA_PROD_TYPE"		, false)	'ISA type
    g_BDM_PRCD131			= Form.GetSharedData("BDM_PRCD131"		, false)	'연금저축 가입여부
    g_BDM_ISA_ACNT_OPNG_CLCD =  Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"		, false)	'isa계좌개설구분코드 (1:신규/2:이수전용)
    g_BDM_WRAP			= Form.GetSharedData("BDM_WRAP"			, false)		'랩 가입여부
    g_BDM_PRCD200			= Form.GetSharedData("BDM_PRCD200"		, false)		'슈퍼365 가입여부
    
    g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"        , false)			'등록일련번호	'ksj 2021-07-23    
    g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)			'목표시장부적합여부'ksj 2021-07-23
    'v0002 sta
    g_BDM_ACFD_REG_SRNO		= Form.GetSharedData("BDM_ACFD_REG_SRNO"					, false)	'해외CFD목표시장등록일련번호	
    g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부	
    
    g_BDM_DMST_CFD_ACNT_APLT_YN1  = Form.GetSharedData("BDM_DMST_CFD_ACNT_APLT_YN1"           , false)		'국내CFD 계좌신청여부(일반)
    g_BDM_DMST_CFD_ACNT_APLT_YN2  = Form.GetSharedData("BDM_DMST_CFD_ACNT_APLT_YN2"           , false)		'국내CFD 계좌신청여부(안심)
    g_BDM_OVRS_CFD_ACNT_APLT_YN1  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN1"           , false)		'해외CFD 계좌신청여부(미국/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN2  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN2"           , false)		'해외CFD 계좌신청여부(미국/안심)
    g_BDM_OVRS_CFD_ACNT_APLT_YN3  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN3"           , false)		'해외CFD 계좌신청여부(중국/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN4  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN4"           , false)	 	'해외CFD 계좌신청여부(중국/안심)	
    g_BDM_OVRS_CFD_ACNT_APLT_YN5  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN5"           , false)		'해외CFD 계좌신청여부(홍콩/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN6  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN6"           , false)	 	'해외CFD 계좌신청여부(홍콩/안심)
    g_BDM_OVRS_CFD_ACNT_APLT_YN7  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN7"           , false)		'해외CFD 계좌신청여부(일본/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN8  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN8"           , false)		'해외CFD 계좌신청여부(일본/안심)   
    
    g_BDM_PNSN_TCTR_CLS_CODE		= Form.GetSharedData("BDM_PNSN_TCTR_CLS_CODE"          , false)		'연금이관구분코드(신규/이수전용)
    g_BDM_PNSN_CNRC_PRD			= Form.GetSharedData("BDM_PNSN_CNRC_PRD"           	, false)		'연금계약기관
    g_BDM_PNSN_PRVS_BEGN_SCDL_DATE	= Form.GetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , false)		'연금지급개시예정일
    g_BDM_PNSN_CNRC_AMT			= Form.GetSharedData("BDM_PNSN_CNRC_AMT"           	, false)		'연금계약금액
    g_BDM_PNSN_PRVS_BANK_CODE		= Form.GetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , false)		'연금지급은행코드
    g_BDM_PNSN_PRVS_BANK_ACNO		= Form.GetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , false)		'연금지급은행계좌번호
    
    g_BDM_PROS_DATE	= Form.GetSharedData("BDM_PROS_DATE"          , false)
    g_BDM_PROS_SRNO	= Form.GetSharedData("BDM_PROS_SRNO"          , false)
    g_BDM_MNY_PROS_DATE	= Form.GetSharedData("BDM_MNY_PROS_DATE"          , false)
    g_BDM_MNY_PROS_SRNO	= Form.GetSharedData("BDM_MNY_PROS_SRNO"          , false)
    
    g_BDM_MANG_BRCD          = Form.GetSharedData("BDM_MANG_BRCD"          , false)  '관리점
    g_BDM_MANG_EMPNO         = Form.GetSharedData("BDM_MANG_EMPNO"          , false)  '관리직원번호
    g_BDM_CERT_METHOD                = Form.GetSharedData("BDM_CERT_METHOD"          , false)
    g_BDM_FACE_YN					= Form.GetSharedData("BDM_FACE_YN"          , false)
    
    g_SRNO2						= Form.GetSharedData("BDM_SRNO2"          , false)
    
    'OCR 촬영 후 안면인식단계로 오는 경우를 위해 저장한 데이터
    '이후 단계에도 같은 키값을 쓰는게 있으니 여기서 꺼내쓰고 날림 처리
    g_OTSDTRUNIQNO				= Form.GetSharedData("BDM_OTSD_TR_UNIQ_NO"          , true)
    
    
End Function

