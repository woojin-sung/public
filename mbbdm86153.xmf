'============================================================================
Function f_CheckNextEnable()
'	if g_szCheckYn == "Y" then
	if g_szCheckSubYn1 == "Y" and g_szCheckSubYn2 == "Y" then
		btnNext.enable = true
					
		btnNext.btnimage = "btn_20.9"
		btnNext.fgcolor = "273"	
		
		imgCtcnChkAll.imgpath = "checkmenu_o"
		contCtcn1.imgCtcnChk.imgpath = "check_line_o"
	else
		btnNext.enable = false
		
	    if Form.GetEnvData("common.theme") == "black" then
		btnNext.btnimage = "btn_27.9"
	    else
		btnNext.btnimage = "btn_21.9"
	    end if
	    btnNext.fgcolor = "269"
	    
	    imgCtcnChkAll.imgpath = "checkmenu_n"
		contCtcn1.imgCtcnChk.imgpath = "check_line_n"
	end if
End Function

'============================================================================
Function f_SetData()
	g_ImgData = ""
	g_ImgDataLen = 0
	g_ImgFace = ""
	g_ImgFaceLen = 0 
	
	if g_BDM_CERT_METHOD == "1" then		'실물신분증
		g_NAME		    = Form.GetSharedData("&RET_NAME", 0)				'이름
		g_RCNO 		    = Form.GetSharedData("&RET_JUMIN_NUM", 0 )		'암호화된 실명확인번호
		g_ISSU_DATE	    = Form.GetSharedData("&RET_ISSU_DATE", 0)			'발급일자
		g_BIRTH  	    = Form.GetSharedData("&RET_BIRTHDAY", 0)			'생년월일
		
		ImgMskData 	    = Form.GetSharedData("&RET_MASK_IMAGE_ENC" , 0)	'주민번호 마스킹이미지 
		g_ImgData  	    = Form.GetSharedData("&RET_IMAGE_ENC", 0)			'주민번호 마스킹없는이미지
		
		g_ImgFace	    = Form.GetSharedData("&RET_FACE_IMAGE" , 0)		'얼굴 이미지
		
		g_RCNO_7		  = Form.GetSharedData("&RET_JUMIN_NUM_BACK"	, 0 ) 	'실명확인번호 뒷 7자리
		
		'실물 신분증은 주민등록증인지 운전면허증인지 정보 가져옴
		g_ID_CARD_TYPE    = Form.GetSharedData("&RET_CARD_TYPE", 0)
		
		g_FEATURE 	  = Form.GetSharedData("&RET_FEATURE"		, 0 ) 	'특징점데이터
		g_FEATURE_SCORE = Form.GetSharedData("&RET_FEATURE_SCORE"	, 0 ) 	'특징점 점수
		g_FEATURE_LEN   = Form.GetSharedData("&RET_FEATURE_LEN"	, 0 ) 	'특징점데이터 길이
		g_SERIAL    	  = Form.GetSharedData("&RET_SERIAL"			, 0 ) 	'발급번호
		g_LISENCE_NUM   = Form.GetSharedData("&RET_LICENSE_NUM"	, 0 ) 	'신분증번호
		
		if ImgMskData <> "" and g_ImgData <> "" then 
			g_ImgDataLen 	= Len(g_ImgData)
			ImgMskDataLen = Len(ImgMskData)
		end if
		
		if g_ImgFace <> "" and g_ImgFace <> null then
			g_ImgFaceLen = Len(g_ImgFace)
		end if
	else									'모바일신분증
		g_NAME		    = Form.GetSharedData("&RET_MOBILEID_NAME", 0)				'이름
		g_RCNO 		    = Form.GetSharedData("&RET_MOBILEID_IHIDNUM", 0 )			'암호화된 실명확인번호
		g_ISSU_DATE	    = Form.GetSharedData("&RET_MOBILEID_ISSUDE", 0)			'발급일자
		g_BIRTH		    = Form.GetSharedData("&RET_MOBILEID_BIRTH", 0)			'생년월일
		
		ImgMskData 	    = Form.GetSharedData("&RET_MOBILEID_IMAGE_MASK" , 0)		'주민번호 마스킹이미지 
		g_ImgData  	    = Form.GetSharedData("&RET_MOBILEID_IMAGE", 0)			'주민번호 마스킹없는이미지
		g_ImgFace	    = Form.GetSharedData("&RET_MOBILEID_IMAGE_FACE", 0)			'얼굴 이미지
		if ImgMskData <> "" and g_ImgData <> "" then
			g_ImgDataLen 	= Len(g_ImgData)
		end if
		if g_ImgFace <> "" and g_ImgFace <> "" then
			g_ImgFaceLen 	= Len(g_ImgFace)
		end if
		
		g_LISENCE_NUM   = Form.GetSharedData("&RET_MOBILEID_DLNO"	, 0 ) 	'신분증번호
		
		g_RCNO_7		  = Form.GetSharedData("&RET_MOBILEID_IHIDNUM7"	, 0 ) 	'실명확인번호 뒷 7자리
	end if
End Function

