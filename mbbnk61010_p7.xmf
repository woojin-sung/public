'============================================================================
' 01. 화 면 명 : 빠른이체 등록 팝업
' 02. 화면설명 : 이체_빠른이체 등록 화면 
' 03. 작    성 : 2016.02.19 ~ 2016.04.  테스트3
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szACNO	'계좌번호 (8)
Dim g_szASNO    '일련번호 (2) 
Dim g_szUserJumin		'실명확인번호(주민번호)
Dim g_szUserNum			'고객번호
Dim g_szIRow			'선택된 행의 인덱스
Dim g_szCom             '기관코드
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' Check_Data()
'============================================================================
Function Check_Data()
    If edtQname.caption == ""  Then
	   Form.ShowAlert( "알림" , "빠른이체명을 입력하십시오!")
	   return False
	End If
    szAcnt = Form.GetCtlProp("accQuick", "caption")
    If Len(szAcnt) < 10 Then
	    Form.ShowAlert( "알림" , "출금계좌번호를 확인하십시오!")
	    return False
	End If
	If edtAmt.caption == ""  Then
	   Form.ShowAlert( "알림" , "이체금액을 확인하십시오!")
	   return False
	End If
	If edtAcnt.caption == ""  Then
	   Form.ShowAlert( "알림" , "입금계좌번호를 확인하십시오!")
	   return False
	End If
End Function
'============================================================================
' Cal_Btn(nAdd)
'============================================================================
Function Cal_Btn(nAdd)	
   Dim nAmt
   if Trim(edtAmt.caption) == "" then
      nAmt = 0
   else 
      nAmt = CDbl(edtAmt.caption)
   end if
   edtAmt.caption = nAmt + nAdd
End Function   
'============================================================================
'TR_Inquiry(g_szGbn)
'============================================================================
Function TR_Inquiry(g_szGbn)
     g_szACNO = Form.GetCtlProp("accQuick", "total")
     g_szASNO = Form.GetCtlProp("accQuick", "sequence")
     g_szAccIn = edtAcnt.caption
     
     if g_szGbn == "Out" then	'타행 조회
        
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE", 0 , g_szCom)	'입금은행코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO" , 0 ,g_szAccIn)	'입금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 ,  edtAmt.caption)		'거래금액
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO" , 0 , g_szACNO)	'출금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , g_szASNO)	'계좌상품구분코드
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")	'작업단말번호(기본값)
		DATAMANAGER.RequestTranData("obtss_elbs_129r")
	 
	 else	'당행조회
	    DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Left(g_szAccIn, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO" , 0 , Right(g_szAccIn, 2))	'상대계좌일련번호	
	    DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO" , 0 , g_szACNO)	'계좌번호
	    DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO" , 0 , g_szASNO)	'계좌일련번호
	    DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN" , 0 , "N")	'사용여부(기본값)			
	    DATAMANAGER.RequestTranData("obrtd_drng_025r")
     end if
End Function 

Function Open_Confirm()
    Dim szData
	' I★이체명★받는분★출금계좌번호★계좌명★이체금액★은행코드★기관명★입금계좌★내통장표시★받는분표시 
	szData = "I"													' 구분 I:등록 D:삭제
	szData = szData & "★" & edtQname.caption	
	szData = szData & "★" & g_szInName	
	szData = szData & "★" & Form.GetCtlProp("accQuick", "caption")			' 계좌번호
	szData = szData & "★" & Form.GetCtlProp("accQuick", "accountname")		' 계좌명
	szData = szData & "★" & edtAmt.caption					' 금액
	szData = szData & "★" & g_szCom									' 코드
	szData = szData & "★" & edtBank.caption		' 기관명	
	szData = szData & "★" & edtAcnt.caption				' 입금계좌
	szData = szData & "★" & edtMytip.caption					' 내통장표시
	szData = szData & "★" & edtRcvTip.caption				' 받는분표시
	
	
	' 등록확인팝업 오픈
	Form.OpenPopup("mbbnk61010_p8", szData , "")
End Function
    
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szValue = Form.GetOpenLinkData()
	Form.SetCtlProp("accQuick", "caption", szValue)
    accQuick_ChangeAccount()
    edtBank.caption = "메리츠"
    g_szCom = "287"
'    Form.PostLinkData('sKey, sValue)

End Sub




'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbnk61010_p8" then
		if sRet == "ok" then
'			btnSearch_OnClick()
            Form.SendReturnToParent("등록" , sRet)
            Form.CloseForm()
		end if
	ElseIf sKeyName == "61010_OFTEN" then
	   If sRet <> "" then
	      tData = Split(sRet, "★")
	      'edtReceiver.caption = tData(3)
	      edtAcnt.caption = Replace(tData(2),"-","")
	      edtBank.caption = tData(4)
	      g_szCom = tData(1)
	   End If	
	ElseIf sKeyName == "이체기관" then
	   If sRet <> "" then
	      tData1 = Split(sRet, "★")
	      edtBank.caption = tData1(1)
	      g_szCom = tData1(0)
	   End If   
	end if
End Sub
