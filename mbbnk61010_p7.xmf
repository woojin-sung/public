'============================================================================
Sub btnEnroll_OnClick()
    temp = Check_Data()
    if temp = false then
       exit Sub
    end if 
    if g_szCom =="287" then
        call TR_Inquiry("In")
	else 
	    call TR_Inquiry("Out") 
	end if    
    
'	DATAMANAGER.RequestTranData( "obtss_elbs_200a" )
End Sub

'============================================================================
Sub accQuick_ChangeAccount()
	g_szACNO = Form.GetCtlProp("accQuick", "total")
	g_szACNO = Form.GetCtlProp("accQuick", "sequence")
End Sub

