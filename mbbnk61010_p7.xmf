'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_drng_025r" then
	   g_szInName = DATAMANAGER.GetDataValue( 0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME" , 0 )
	elseif szTranID == "obtss_elbs_129r" then
	   g_szInName = DATAMANAGER.GetDataValue( 0, "obtss_elbs_129r", "OutBlock1", "ACNM", 0 )
	end if	
	Call Open_Confirm()
End Sub

Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.MsgBox("알림", szErrMsg, 0, 0)
End Sub

'============================================================================
Sub edtMytip_OnEditComplete()
	szLen = Form.GetByteLength(edtMytip.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		edtMyTip.caption = ""
	end if	
End Sub

