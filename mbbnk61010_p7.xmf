Sub btnOften_OnClick()
	szAcnt = Form.GetCtlProp("accQuick", "caption")
'	szAcno = Form.GetCtlProp("accQuick", "total")
    If Len(szAcnt) < 10 Then
	    Form.ShowAlert("알림", "계좌번호를 확인하십시오!")
	    return False
	End If
