	<SCRIPT_INFO _len="11534" _ulen="10750" >
'============================================================================
' 화면명   : 01. 종목선택
' 화면설명 : Long종목, Short종목을 국내주식, 국내ETF에서 선택(최대 3종목까지)
'============================================================================
' 2018-04-03 : 신재영 : 신규개발
'============================================================================

Dim g_szList
Dim g_szCd
Dim g_sSmprPstnClcd ' 포지션 1:short 2:long
Dim g_sDmabClsCode  ' 국내외구분코드 1:국내 2:국외
Dim g_sSmprIssuTpcd ' 종목유형 1:주식 2:ETF
Dim g_sAcno
Dim g_sAsno
DIm g_sPrsClsCode
'============================================================================
Sub Form_OnFormInit()

	sSendData = Form.GetOpenLinkData()
	g_szList = Split(sSendData,"★")

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if

End Sub
'============================================================================
Sub Button0_OnClick() ' 다음
	If Len(Edit0.caption) == 0 Then
		Form.MsgBox("알림", "비밀번호를 입력하세요.", "", 0)
		Exit Sub
	ElseIf Int(Container0.Grid1.rowcount) <= 0 Then
		Form.MsgBox("알림", "Long종목을 선택하세요.", "", 0)
		Exit Sub
	ElseIf Int(Container0.Grid0.rowcount) <= 0 Then
		Form.MsgBox("알림", "Short종목을 선택하세요.", "", 0)
		Exit Sub
	ElseIf Int(Container0.Grid1.rowcount) > 2 Then
		Form.MsgBox("알림", "Long종목은 최대 2종목까지 선택 가능합니다.", "", 0)	
		Exit Sub
	ElseIf Int(Container0.Grid0.rowcount) > 2 Then
		Form.MsgBox("알림", "Short종목은 최대 2종목까지 선택 가능합니다.", "", 0)
		Exit Sub
	ElseIf Int(Container0.Grid1.rowcount) + Int(Container0.Grid0.rowcount) > 3 Then
		Form.MsgBox("알림", "Long/Short 합하여 최대 3종목까지 선택 가능합니다.", "", 0)
		Exit Sub
	Else
		DATAMANAGER.RequestTranData("obsap_smpr_001a") ' 저장
	End If
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsap_smpr_001a" Then ' 등록
		DATAMANAGER.ClearInputData(0, "obsap_smpr_001a")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "I"			) 
'		If g_sProsClsCode == "U" Then
'			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRTF_SRNO" 		, 0 , g_szList(3)				) 
'		End If
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMPR_REG_STAG" 	, 0 , 1							) 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , Left(Account0.caption , 8 )	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 			, 0 , Mid(Account0.caption, 9, 2)	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , Edit0.encdata				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMPR_TPCD" 		, 0 , "1"						) ' 100%
		
		' inblock 2 test
		
		For i = 0 to Container0.Grid1.rowcount - 1
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "SMPR_PSTN_CLCD" 	, i , "2" 								    )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DMAB_CLS_CODE" 	, i ,  Container0.Grid1.GetCellData("bd_cell2", i))
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "SMPR_ISSU_TPCD" 	, i ,  Container0.Grid1.GetCellData("bd_cell3", i))
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ISCD" 			, i ,  Container0.Grid1.GetCellData("bd_code" , i))
		Next
		
		i = Container0.Grid1.rowcount			
		
		For j = 0 to Container0.Grid0.rowcount - 1
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "SMPR_PSTN_CLCD" 	, i+j ,  "1" 								    	  )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DMAB_CLS_CODE" 	, i+j ,  Container0.Grid0.GetCellData("bd_cell2", j))
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "SMPR_ISSU_TPCD" 	, i+j ,  Container0.Grid0.GetCellData("bd_cell3", j))
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ISCD" 			, i+j ,  Container0.Grid0.GetCellData("bd_code" , j))
		Next
	ElseIf szTranID == "obsap_smpr_009r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1" 						)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , Left(Account0.caption , 8 )	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 			, 0 , Mid(Account0.caption, 9, 2)	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRTF_SRNO" 		, 0 , g_szList(3)					)
	
	ElseIf szTranID == "obsim_stsv_001r" Then
		If Left(g_szCd, 1) <> "J" and Left(g_szCd, 1) <> "F" Then 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , 0 , "A"&g_szCd)
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , 0 , g_szCd)
		End If
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID == "obsap_smpr_001a" Then ' 등록
		DATAMANAGER.ClearInputData(0, sTranID)
		
		sOpenData = Left(Account0.caption , 8 )                  ' 계좌번호
		sOpenData = sOpenData &"★"& Mid(Account0.caption, 9, 2) ' 계좌일련번호
		sOpenData = sOpenData &"★"& Edit0.encdata               ' 계좌비밀번호
		sOpenData = sOpenData &"★"& Int(DATAMANAGER.GetDataValue(0,"obsap_smpr_001a", "OutBlock1", "PRTF_SRNO", 0)) ' 포트폴리오일련번호
		
		Form.OpenFramePopup( "mbfnp55000_p3" , sOpenData , "" )
	
	ElseIf szTranID == "obsim_stsv_001r" Then
		Dim s_Isnm
	
		'메리츠 종목제한 : 메리츠금융지주(A138040), 메리츠화재(A000060), 메리츠종금증권(A008560)
		s_Isnm = Trim(DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "KOR_ISNM" , 0))
		
		'Form.ShowAlert("알림", s_Isnm) 
		
		If instr(s_Isnm,"메리츠") > 0 Then
			Form.ShowAlert("알림", "선택할 수 없는 종목입니다.")
			Exit Sub
		ElseIf DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0) == "A138040"  Then
			Form.ShowAlert("알림", "선택할 수 없는 종목입니다.")
			Exit Sub
		ElseIf DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0) == "A000060"  Then
			Form.ShowAlert("알림", "선택할 수 없는 종목입니다.")
			Exit Sub
		ElseIf DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0) == "A008560"  Then
			Form.ShowAlert("알림", "선택할 수 없는 종목입니다.")
			Exit Sub
		End If 
		
		If DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "SCRT_GRP_CLS_CODE" , 0) == "ST" Then
			g_sSmprIssuTpcd = "1"
			Add_Item(0)
		ElseIf DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "SCRT_GRP_CLS_CODE" , 0) == "EF" Then ' ETF
			g_sSmprIssuTpcd = "2"
		     Add_Item(0)
		Else
			Form.ShowAlert("알림", "선택할 수 없는 종목입니다.")
			Exit Sub
		End If
	End If
	
End Sub


'============================================================================
Sub Container0_Table6_OnClick(lRow , lColumn) 'LONG
	g_sSmprPstnClcd = 2
	g_sDmabClsCode  = 1

	'(0,1) 국내주식
	'(1,1) 국내ETF
	'(2,1) 해외주식
	'(3,1) 해외ETF
	If lColumn == 1 and Container0.Grid1.rowcount == "4" Then
		Form.MsgBox("알림","더 이상 추가할 수 없습니다.", "", 0)
		Exit Sub
	ElseIf lRow == 0 and lColumn == 1 Then
		Form.OpenCommonDialog("SEARCH", "2", Container0.Grid1.rowcount)
	ElseIf lRow == 1 and lColumn == 1 Then
		Form.OpenCommonDialog("SEARCH", "5", Container0.Grid1.rowcount)
	ElseIf lColumn = 1 Then
		Form.MsgBox("알림","준비중입니다.", "", 0)
	Else 
		Exit Sub
	End If
	
End Sub
'============================================================================
Sub Container0_Table5_OnClick(lRow , lColumn) 'Short
	g_sSmprPstnClcd = 1
	g_sDmabClsCode  = 1

	'(0,1) 국내주식
	'(1,1) 국내ETF
	'(2,1) 해외주식
	'(3,1) 해외ETF
	If lColumn == 1 and Container0.Grid0.rowcount == "4" Then
		Form.MsgBox("알림","더 이상 추가할 수 없습니다.", "", 0)
		Exit Sub
	ElseIf lRow == 0 and lColumn == 1 Then
		Form.OpenCommonDialog("SEARCH", "2", Container0.Grid0.rowcount)
	ElseIf lRow == 1 and lColumn == 1 Then
		Form.OpenCommonDialog("SEARCH", "5", Container0.Grid0.rowcount)
	ElseIf lColumn = 1 Then
		Form.MsgBox("알림","준비중입니다.", "", 0)
	Else 
		Exit Sub
	End If
	
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	Dim nRow
	Dim szCode, szName, szMk
	
	nRow = 0
	szCode, szName, szMk = "", "", ""
	g_tCode = {}
	
	if sDlgName == "SEARCH" then
		
		if Trim(sReturn1) <> "" then
			g_tCode = Split(sReturn1, ":")
			
			szName = Form.GetItemCodeInfo(g_tCode[0], "name")
			
			if #g_tCode == 1 then
				For i = 0 to Container0.Grid1.rowcount - 1
				
					szCode = Trim(Container0.Grid1.GetCellData("bd_code", i))
					
					if szCode == "A"&Trim(g_tCode[0]) then ' 중복확인
						
						g_szCd = g_tCode[0]
						
						Form.MsgBox("알림", szName & "은(는) 이미 등록되어 있습니다.", "", 0)
						Exit Sub
					end if
				Next
				
				For j = 0 to Container0.Grid0.rowcount - 1

					szCode = Trim(Container0.Grid0.GetCellData("bd_code", j))
					
					if szCode == "A"&Trim(g_tCode[0]) then ' 중복확인

						g_szCd = g_tCode[0]
						
						Form.MsgBox("알림", szName & "은(는) 이미 등록되어 있습니다.", "", 0)
						Exit Sub
					end if
				Next
				g_szCd = g_tCode[0]
				
				DATAMANAGER.RequestTranData( "obsim_stsv_001r" ) ' 종목구분 조회
				
				'Add_Item(0)
				
			end if
			
		end if	
	end if
End Sub


'============================================================================
' Add_Item : 종목추가 
'============================================================================
Function Add_Item(nGbn)
	
	szName = Form.GetItemCodeInfo(g_szCd, "name")
	
	If g_sSmprPstnClcd = 2 Then
		Container0.Grid1.insertrow = Container0.Grid1.rowcount
		Container0.Grid1.SetCellData("bd_code" , Container0.Grid1.rowcount-1, "A"&g_szCd		)
		Container0.Grid1.SetCellData("bd_cell0", Container0.Grid1.rowcount-1, szName			)
		Container0.Grid1.SetCellData("bd_cell2", Container0.Grid1.rowcount-1, g_sDmabClsCode	)
		Container0.Grid1.SetCellData("bd_cell3", Container0.Grid1.rowcount-1, g_sSmprIssuTpcd	)
	ElseIf g_sSmprPstnClcd = 1 Then
		Container0.Grid0.insertrow = Container0.Grid0.rowcount
		Container0.Grid0.SetCellData("bd_code" , Container0.Grid0.rowcount-1, "A"&g_szCd		)
		Container0.Grid0.SetCellData("bd_cell0", Container0.Grid0.rowcount-1, szName			)
		Container0.Grid0.SetCellData("bd_cell2", Container0.Grid0.rowcount-1, g_sDmabClsCode	)
		Container0.Grid0.SetCellData("bd_cell3", Container0.Grid0.rowcount-1, g_sSmprIssuTpcd	)
	End If
	
	g_szCd = ""

End Function

'============================================================================
Sub Container0_Grid1_OnClickUp(lRow, szCellID)
	If szCellID == "bd_del" Then
		Container0.Grid1.SetDeleteRow( lRow )
	End If
End Sub

'============================================================================
Sub Container0_Grid0_OnClickUp(lRow, szCellID)
	If szCellID == "bd_del" Then
		Container0.Grid0.SetDeleteRow( lRow )
	End If
End Sub

