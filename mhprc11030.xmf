'============================================================================
'Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	grdRise0.SetClear()
	grdCtrt0.SetClear()
	
	'20240513 HSZ START: HOME 연결 추가
	szData = Form.GetOpenLinkData()
	if Trim(szData) <> "" then
		rdoMain0.currentindex = CInt(szData)
	end if
	'20240513 HSZ END
	
	DATAMANAGER.RequestTranData("ohhts_1031_001r")

End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'grdRise0_OnClickUp
'============================================================================
Sub grdRise0_OnClickUp(lRow, szCellID)
	dim szItemCode
	dim szItemName

	szItemCode = grdRise0.GetCellData("bd_cell0", lRow)
	szItemName = grdRise0.GetCellData("bd_cell1", lRow)
		
	
	Form.OpenFramePopup("mhprc11030_p1" , szItemCode & "★" & szItemName, "")
End Sub


'============================================================================
'grdCtrt0_OnClickUp
'============================================================================
Sub grdCtrt0_OnClickUp(lRow, szCellID)
	dim szItemCode2
	dim szItemName2
	dim row2				'grid 겹칠시 row값 못가져옴.
	
	row2= grdCtrt0.selectrow
			
	szItemCode2 = grdCtrt0.GetCellData("bd_cell0", row2)
	szItemName2 = grdCtrt0.GetCellData("bd_cell1", row2)
	
	Form.OpenFramePopup("mhprc11030_p1" , szItemCode2 & "★" & szItemName2, "")
	
End Sub


'============================================================================
'rdoMain0_OnClick
'============================================================================
Sub rdoMain0_OnClick(nIndex)
   
	if nIndex = 0 then 
		'상승비율상위일때
		grdRise0.visible = true
		grdRise0.enable = true
		grdCtrt0.visible = false
		grdCtrt0.enable = false
		
		grdRise0.left = 0
		grdCtrt0.left = 406
	else
		
		'등락율상위일때
		grdRise0.visible = false
		grdRise0.enable = false
		grdCtrt0.visible = true
		grdCtrt0.enable = true
		
		grdCtrt0.left = 0
		grdRise0.left = 406
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1031
	dim szRealCode
	
	ncnt1031 = DATAMANAGER.GetDataCount(0, "ohhts_1031_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1031_001r" then
		DATAMANAGER.CancelRealData("ohhts_tmst_rsfl")
		
		for i = 0 to ncnt1031 - 1
			szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1031_001r", "OutBlock1", "FID_TMST_CODE", i)
			DATAMANAGER.SetDataValue(1,"ohhts_tmst_rsfl", "InBlock1", "FIDR_TMST_CODE" , i, szRealCode)
		next
		
		DATAMANAGER.RequestRealData("ohhts_tmst_rsfl")
	end if 
End Sub


