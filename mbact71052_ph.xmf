	<SCRIPT_INFO _len="7391" _ulen="6875" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nIndex
Dim g_szCurrType
Dim g_szCode
Dim g_szBuySeq
Dim g_szBuyDate
Dim g_szAcnt

Dim szTemp1
Dim szTemp2
Dim szTemp3
Dim szTemp4
Dim szTemp5
Dim szTemp6
Dim szTemp7
Dim szTemp8
Dim szTemp9
Dim szTemp10
Dim szTemp11

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)
	'슈퍼365 원화RP 또는 그 외 CMA 
	If (CInt(g_nIndex) == 0 And g_szCurrType == "1") Or CInt(g_nIndex) == 1 Then
		contType1.visible = true
		contType2.visible = false
		
		'슈퍼365 아니면 하단버튼 확인만 표시
		If CInt(g_nIndex) == 1 Then
			contType1.btnOK.visible = true
			contType1.btnSell.visible = false
			contType1.btnOKl.visible = false
		Else
			contType1.btnOK.visible = false
			contType1.btnSell.visible = true
			contType1.btnOKl.visible = true
		End If
		
		contType1.lblName.caption = szTemp1
		contType1.tbl0.SetCellString(0, 2, szTemp2)
		contType1.tbl1.SetCellString(0, 1, szTemp3)
		
		contType1.tbl1.SetCellString(1, 1, szTemp4)
		If Left(szTemp4, 1) == "+" Then
			contType1.tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(szTemp4, 1) == "-" Then
			contType1.tbl1.SetCellFgColor(1, 1, "2")
		End If
		
		contType1.tbl1.SetCellString(2, 1, szTemp5)
		contType1.tbl2.SetCellString(0, 1, szTemp6)
		contType1.tbl2.SetCellString(1, 1, szTemp11)
		contType1.tbl2.SetCellString(2, 1, szTemp7)
		
	'슈퍼365 외화RP
	Else
		contType1.visible = false
		contType2.visible = true
		
		contType2.btnOK.visible = false
		contType2.btnSell.visible = true
		contType2.btnOKl.visible = true
		
		contType2.lblName.caption = szTemp1
		contType2.tbl0.SetCellString(0, 2, szTemp2)
		contType2.tbl1.SetCellString(0, 1, szTemp3)
		
		contType2.tbl1.SetCellString(1, 1, szTemp4)
		If Left(szTemp4, 1) == "+" Then
			contType2.tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(szTemp4, 1) == "-" Then
			contType2.tbl1.SetCellFgColor(1, 1, "2")
		End If
		
		contType2.tbl1.SetCellString(2, 1, szTemp5)
		contType2.tbl2.SetCellString(0, 1, szTemp6)
		contType2.tbl2.SetCellString(1, 1, szTemp11)
		contType2.tbl2.SetCellString(2, 1, szTemp7)
		
		contType2.tbl3.SetCellString(0, 1, szTemp8)
		contType2.tbl3.SetCellString(1, 1, szTemp9)
		contType2.tbl3.SetCellString(2, 1, FormatNumber(szTemp10), 2)
		If CDbl(szTemp10) > 0 Then
			contType2.tbl3.SetCellFgColor(2, 1, "1")
		ElseIf CDbl(szTemp10) < 0 Then
			contType2.tbl3.SetCellFgColor(2, 1, "2")
		End If
	End If

End Function

'============================================================================
'Function SendOrder()
'    If g_nCount = 0 Then
'	    Form.SendReturnToParent( "주문전송" , "1")
'	    
'	elseif g_nCount = 1 then
'	    Form.CloseForm( )
'    End If
'    
'End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
    Else
	    '20230828 아이디 연결여부 추가
		g_szLinkedYN = Form.GetSharedData("71052_ID_LNKN_YN", false)
	    
'	    Form.ShowAlert("11", szData)
	    
	    g_nIndex				= arrData( 0) ' 종목구분 (0:슈퍼365, 1:이외)
		g_szCurrType			= arrData( 1) ' 원화/외화 통화구분
		szTemp1 				= arrData( 2) ' 종목명
		szTemp2 				= arrData( 3) ' 평가금액
		szTemp3 				= arrData( 4) ' 매입금액
		szTemp4 				= arrData( 5) ' 평가손익
		szTemp5 				= arrData( 6) ' 약정금리
		szTemp6 				= arrData( 7) ' 매수일
		szTemp7 				= arrData( 8) ' 경과일수
		
		szTemp8 				= arrData( 9) ' 외화매입금액
		szTemp9 				= arrData(10) ' 외화평가금액
		szTemp10				= arrData(11) ' 외화평가손익
		
		szTemp11				= arrData(16) ' 만기일자
		
		g_szCode				= arrData(12)	' 종목코드 
		g_szBuySeq			= arrData(13)	' 매수일련번호
		g_szBuyDate			= arrData(14)	' 매수일자
		g_szAcnt				= arrData(15)	' 계좌번호
		
	    Set_Data(g_nIndex)
	End if	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub contType1_btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contType1_btnOKl_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contType2_btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contType2_btnOKl_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contType1_btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contType2_btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contType1_btnSell_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	'원화RP 매도
	Dim szSendData
	szSendData = g_szAcnt & "☆" & "1" & "☆" & g_szCode & "☆" & g_szBuySeq
	Form.OpenNextPopup("mbfnp55010" , szSendData, "")
End Sub

'============================================================================
Sub contType2_btnSell_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	'외화RP 매도
	Dim szSendData
	szSendData = g_szAcnt & "☆" & "2" & "☆" & g_szCode & "☆" & g_szBuySeq & "☆" & g_szBuyDate
	Form.OpenNextPopup("mbfnp55020" , szSendData, "")
End Sub

