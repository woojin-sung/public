'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 매매일지_팝업-종목별 매매일지
' 02. 화면설명 : 매매일지 팝업화면
' 03. 작    성 : 
'-------------------------------------------------------------------------------------------
Dim g_szAcno
Dim g_szAsno
Dim g_szIscd
Dim g_szStaDate
Dim g_szFinDate
Dim g_szIncuFlag
'Dim g_nIscdCnt
'============================================================================
Sub Form_OnFormInit()
	Dim szTempData
	Dim arrTempData
	
	'종목콤보박스 초기화
	'g_nIscdCnt = 0
	
	Form.SetScreenName("종목 매매일지")
	
	'순서 : 계좌번호 계좌일련번호 종목코드 시작일자 종료일자 신용비용
	szTempData = Form.GetOpenLinkData()
	arrTempData = Split(szTempData, "★")
	
	g_szAcno = arrTempData(0)
	g_szAsno = arrTempData(1)
	g_szIscd = arrTempData(2)
	g_szStaDate = arrTempData(3)
	g_szFinDate = arrTempData(4)
	g_szIncuFlag= arrTempData(5)
	
	'Return_Change_ItemCode(g_szIscd)
	chkGrid.checkstate = g_szIncuFlag
	
	'매매종목 조회(1번만 호출)
	DATAMANAGER.RequestTranData("obtrs_cntg_540r")
	
	Request()
End Sub

'============================================================================
Sub Request()
	DATAMANAGER.RequestTranData("obtrs_cntg_537r")
	DATAMANAGER.RequestTranData("obtrs_cntg_538r")
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrs_cntg_538r" then
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "ACNO"		  , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "ASNO"		  , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "IQRY_STA_DATE" , 0 , g_szStaDate)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "IQRY_FIN_DATE" , 0 , g_szFinDate)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "ISCD" 		  , 0 , g_szIscd)
		if chkGrid.checkstate == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y")
		else
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N")
		end if
	elseif szTranID = "obtrs_cntg_537r" then
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "ACNO"		  , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "ASNO"		  , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "IQRY_STA_DATE" , 0 , g_szStaDate)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "IQRY_FIN_DATE" , 0 , g_szFinDate)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "ISCD" 		  , 0 , g_szIscd)
		if chkGrid.checkstate == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y")
		else
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N")
		end if
	elseif szTranID = "obtrs_cntg_540r" then
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_540r", "InBlock1", "ACNO"		  , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_540r", "InBlock1", "ASNO"		  , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_540r", "InBlock1", "IQRY_STA_DATE" , 0 , g_szStaDate)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_540r", "InBlock1", "IQRY_FIN_DATE" , 0 , g_szFinDate)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_540r", "InBlock1", "ISCD" 		  , 0 , "%")
		if chkGrid.checkstate == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y")
		else
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N")
		end if
	end if
End Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	szMarketGubun = Form.GetItemCodeInfo(sCode, "market")
	
	if szMarketGubun = "W" then
		szMarketGubun = "Q"
	elseif szMarketGubun = "Q" then
		szMarketGubun = ""
	elseif szMarketGubun = "J" then
		if Left(ItemCode0.code, 1) = "J" or Left(ItemCode0.code, 1) = "F" then
			szMarketGubun = ""
		else
			szMarketGubun = "A"
		end if
	elseif szMarketGubun = "K" then
		szMarketGubun = "A"
	end if
	
	g_szIscd = szMarketGubun + sCode
	
	Request()
End Sub

