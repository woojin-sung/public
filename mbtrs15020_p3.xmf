'============================================================================
Sub chkGrid_OnChange(sCheckState)
	Request()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrs_cntg_540r" then
		'g_nIscdCnt 초기값 = 0
		for i = 0 to DATAMANAGER.GetDataCount(0, "obtrs_cntg_540r" , "OutBlock1") - 1
			tmpIscd = DATAMANAGER.GetDataValue(0, "obtrs_cntg_540r", "OutBlock1", "ISCD", i)
			tmpIsnm = DATAMANAGER.GetDataValue(0, "obtrs_cntg_540r", "OutBlock1", "ISNM", i)
			
			CboIscd.cbadddatatext = tmpIscd & "`" & tmpIsnm
			CboIscd.caption = ""
		next
		
		if DATAMANAGER.IsMoreNextData("obtrs_cntg_540r") = true then
			DATAMANAGER.RequestNextData("obtrs_cntg_540r")
		else
			'조회 완료 후 화면에서 넘어온 종목코드로 초기설정
			CboIscd.cbkeydata = g_szIscd
		end if
	end if
End Sub

'============================================================================
Sub CboIscd_OnEditComplete(iIndex)
	'종목코드 변경
	g_szIscd = CboIscd.cbkeydata
	
	Request()
End Sub

