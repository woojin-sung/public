'============================================================================
Sub contOther_btnAcct_OnClick()
	IF trim(g_szPW) == "" THEN
		Form.ShowAlert( "알림", "비밀번호를 입력해 주세요.")
		Exit Sub
	END IF 
	
	DATAMANAGER.RequestTranData( "obtss_elbs_129r" )
End Sub

'============================================================================
Sub btnSave_OnClick()
	IF trim(g_szPW) == "" THEN
		Form.ShowAlert( "알림", "비밀번호를 입력해 주세요.")
		Exit Sub
	END IF 
	if edtMoney.caption == "" then
		Form.ShowAlert( "알림", "이체금액을 입력해 주세요.")
		Exit Sub
	end if

	if Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 )) < Int(edtMoney.caption * 12) THEN
		'Form.ShowAlert( "알림", "이체금액 * 12 > 계약금액["&Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 ))&"] 불가.")
		Form.ShowAlert( "알림", "정기이체 신청금액이 계약금의 연간 납입한도를 초과합니다.")
		Exit Sub	
	END IF 
	
	if g_nRdoIndex == 1 then
		if contOther.Label4.caption == "" then 
			Form.ShowAlert( "알림", "출금은행을 선택해 주세요.")
			Exit Sub
		elseif contOther.Edit1.caption == "" then
			Form.ShowAlert( "알림", "계좌번호를 입력해 주세요.")
			Exit Sub
		elseif contOther.Label6.caption == "" then 
			Form.ShowAlert( "알림", "계좌를 확인해 주십시오.")
			Exit Sub
		elseif contOther.Edit2.caption == "" then
			Form.ShowAlert( "알림", "주민번호 앞자리 6자리를 입력해 주세요.")
			Exit Sub
		end if
		
	end if
	
	IF p_str_ProsClsCode <> "1" Then 
	    IF (trim(contMeritz.anct0.total)+TRIM(contMeritz.anct0.sequence)   	<> trim(g_TactScrtAcno))  OR  '계좌번호
	       (trim(contOther.Edit1.caption ) 								<> trim(g_TactBankAcno))  Then '타행계좌번호
		    p_str_ProsClsCode = "3"
	    End if    
    End if
    
    IF p_str_ProsClsCode <> "1" Then 
	    	Form.ShowAlert( "알림", "기존 신청내역이 존재합니다. 해지 후 신청하세요.")
		Exit Sub	
    end if 
	
	'v0001 sta
	sTRAN_CNTT = ""
	sBIO_TR_CODE = "1"
	sATHN_USAG_CLS_CODE ="1"                            '서명데이터사용
	sData = ""
