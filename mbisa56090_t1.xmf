Sub CommonCheck()
    If contOther.ChkSumm.checkstate == "1" Or contOther.ChkDtl.checkstate == "1" Then
        contOther.ChkAgrm.checkstate = True
    Else
        contOther.ChkAgrm.checkstate = False
    End If
    
    
    If contOther.ChkAgrm.checkstate == "1" Then
		btnSave.enable = True
	Else
		btnSave.enable = False	
    End If
End Sub


