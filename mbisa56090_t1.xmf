'============================================================================
Sub cld0_OnEditComplete()
	
	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "날짜를 확인하여 주십시오.")
		cld0.caption = g_szNextDay
		Exit Sub
	end if
	
	'v0005 익일부터 가능하도록 체크
	if cld0.caption < g_szNextDay then
		Form.ShowAlert( "알림", "시작일자는 익일부터 신청 가능합니다.")
		cld0.caption = g_szNextDay
		Exit Sub
	end if
	
	rdoYear.SetCurIndexSilent(-1)
	
End Sub

'============================================================================
Sub cld1_OnEditComplete()
	
	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "날짜를 확인하여 주십시오.")
		cld1.caption = g_szNextDay
		Exit Sub
	end if
	
	gCNRC_MTRT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctcs_032r" , "OutBlock1" , "CNRC_MTRT_DATE" , 0 )
	gNextMonth = Left(Form.calcDateTime( nYear, 1, nDay, nHour, nMinute, nSecond ), 8)	'1개월
	
	' 종료일자가 만기일자 이후인 경우
	if gCNRC_MTRT_DATE <> "" and cld1.caption > gCNRC_MTRT_DATE  then
		if gNextMonth <> "" and cld1.caption < gNextMonth then
			Form.ShowAlert( "알림", "이체신청이 불가능합니다.\n종료일자 만기일 이전 / 이체기간 1개월 이상")
			cld1.caption = g_szNextDay
			Exit Sub
		else
			Form.ShowAlert( "알림", "이체기간 종료일자가 만기일자보다 큽니다.")
			cld1.caption = gCNRC_MTRT_DATE
			Exit Sub
		end if	
	end if
	
	' 종료일자가 1개월 미만인 경우
	if gNextMonth <> "" and cld1.caption < gNextMonth then
		if gCNRC_MTRT_DATE <> "" and cld1.caption > gCNRC_MTRT_DATE  then
			Form.ShowAlert( "알림", "이체신청이 불가능합니다.\n이체기간 1개월 이상 / 종료일자 만기일 이전")
			cld1.caption = g_szNextDay
			Exit Sub
		else
			Form.ShowAlert( "알림", "이체기간이 한달 미만 입니다.")
			cld1.caption = gNextMonth
			exit sub
		end if
	end if
	
	
	rdoYear.SetCurIndexSilent(-1)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim ErrSub
	
	ErrSub = DATAMANAGER.GetDataMsgSubText( "obwat_ctad_015a" )
	
	if szTranID == "obwat_ctad_015a" then
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	elseif szTranID == "obtss_elbs_129r" then
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	elseif szTranID == "obpds_srvc_416a" then 'v0001
		ErrSub = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_416a" )
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	elseif szTranID == "obpds_srvc_417r" then 'v0003
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	end if
	
End Sub



'============================================================================
Sub rdoAmt_OnClick(nIndex)
Dim tactAmt
	tactAmt = edtMoney.caption
	Select Case nIndex
		Case 0
			edtMoney.caption = tactAmt + 100000
		Case 1
			edtMoney.caption = tactAmt + 500000
		Case 2
			edtMoney.caption = tactAmt + 1000000
		Case 3
			edtMoney.caption = tactAmt + 1500000
		Case 4
			edtMoney.caption = 0
	End Select
	
Dim ableAmt	
	ableAmt = (Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 )) - Int(edtMoney.caption * 12) )/12

	if int(ableAmt) < 100000 then
		rdoAmt.enableindex = "0,0"
		rdoAmt.enableindex = "1,0"
		rdoAmt.enableindex = "2,0"
		rdoAmt.enableindex = "3,0"
	elseif int(ableAmt) < 500000 then
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,0"
		rdoAmt.enableindex = "2,0"
		rdoAmt.enableindex = "3,0"
	elseif int(ableAmt) < 1000000 then 
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,1"
		rdoAmt.enableindex = "2,0"
		rdoAmt.enableindex = "3,0"
	elseif int(ableAmt) < 1500000 then
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,1"
		rdoAmt.enableindex = "2,1"
		rdoAmt.enableindex = "3,0"
	else 
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,1"
		rdoAmt.enableindex = "2,1"
		rdoAmt.enableindex = "3,1"
	end if 
	
	if Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 )) < Int(edtMoney.caption * 12) THEN
		'Form.ShowAlert( "알림", "이체금액 * 12 > 계약금액["&Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 ))&"] 불가.")
		Form.ShowAlert( "알림", "정기이체 신청금액이 계약금의 연간 납입한도를 초과합니다.")
		Exit Sub	
	END IF 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Table0.SetPropTable("caption", 0,1," ")
	Table0.SetPropTable("caption", 1,1," ")
	edtMoney.caption = ""
	
	g_szNextData = 0
	if sEventName == "mbisa56090_t1" then
		g_szData = sParam
	end if
	
	contMeritz.anct0.currentindex = 0
	
	g_szList = Split(g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	g_szAcnt = g_szList(0)
'	Form.ShowAlert("계좌번호", g_szAcnt)
	
	g_szPW = g_szList(2)	
	
	DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
	
	lblCnrcNo.Caption = g_szList(3)
	DATAMANAGER.RequestTranData( "obwat_ctcs_032r" )
	
	DATAMANAGER.RequestTranData( "obpds_srvc_221r" )
End Sub
'============================================================================ v0001
Sub Form_OnFormInitBefore()
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
End Sub

'============================================================================ v0001
Sub BioSgntDataInsert(szMsg)
	
	szTranID = "obpds_srvc_416a"
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 				, 0, g_szCustNum)			
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" 	, 0, "012")
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BCDT_CLS_CODE" 				, 0, "3")				'단말운영체제	: 1.안드로이드 2.아이폰 9.기타
	'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILD_SIZE" 				, 0, STRING(LEN(szMsg)))				'단말ID
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RMND_SRNO" 				, 0, g_szList(3))			'서비스코드	: 001 고정
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_FIDO_ELCT_SGNT_DATA" 		, 0, szMsg)		'인증타입	: S.자사인증 D.교차인증 C.호환인증
	DATAMANAGER.RequestTranData(szTranID)	
End Sub

