			sTRAN_CNTT = "ISA정기입금이체예정내역\n" & "출금기관: " & "메리츠증권" & "\n" & "출금계좌: " & contMeritz.anct0.total & contMeritz.anct0.sequence & "\n" & "예금주명: " & contMeritz.anct0.accountname & "\n" & "이체금액: " & FormatNumber(CDbl(edtMoney.caption), 0, 0, 0, -1) & "원\n" 
