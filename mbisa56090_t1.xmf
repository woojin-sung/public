	<SCRIPT_INFO _len="35567" _ulen="32457" >
'============================================================================
' 01.화면명 	: 펀드정기입금이체
' 02.화면설명	: 펀드정기입금이체 상세정보 및 해지신청 팝업
' 03.작성	: 2016. 03. 10. 유창재
' 2016.12.21 : 신극수 : v0001 : 바이오인증 추가에 따른 프로그램 수정
' 2018.06.29 : 성주혁 : v0002 : 타은행/증권사 선택시 개인정보 제공동의 팝업 추가	
' 2020.10.12 : 신극수 : v0003 : [T2007220015] MTS 비밀번호 Edit 메모리평문제거
' 2022.04.06 : 고승연 : v0004 : [T2204060001] 개인(신용)정보 수집 이용.제공 동의 추가
' 2022-11-22 : 고승연 : v0005 : [T2211030005] 최소 이체금액 (1,000원 체크), 시작일자 익일부터 가능
' 2022.07.05 : 고승연 : v0006 : 사설인증 수정
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szBankCode		'은행코드
Dim g_szBankName		'은행명
Dim g_szData			'
Dim g_szList
Dim g_szAcnt			'계좌번호
Dim g_szCustNum		'고객번호
Dim g_szPW			'비밀번호
Dim g_nRdoIndex		'라디오 인덱스
Dim g_szUserID		'금융ID
Dim g_szToday			'당일날짜
Dim g_szNextDay		'내일일자
Dim g_szNextMonth		'다음달일자
Dim g_szNextMonthDate  '다음월
Dim p_str_ProsClsCode
Dim g_TactScrtAcno	' obpds_srvc_082r.TACT_SCRT_ACNO + TACT_SCRT_ASNO
Dim g_TactBankAcno	' obpds_srvc_211r.TactBankAcno
Dim p_str_SvcSrno
Dim g_szCertUserType	'로그인type 1:간편 3:바이오 v0001
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	g_szNextDay	= Left(Form.calcDateTime( nYear , nMonth, 1, nHour, nMinute, nSecond ), 8)
	
	Dim strMediaType, sVer, sVerList, sVerKey
	strMediaType =  Form.GetSharedData("&MEDIA_CODE", false )	'단말기 종류
'	' ios일 경우만.
'	if trim(strMediaType) = "156" then 
'		sVer = Form.GetSharedData("&APP_VERSION")
'		Form.ShowAlert(sVer, sVer)
'		sVerList = Split(sVer, ".")
'		if len(sVerList[2]) == 1 then
'			sVerKey = CInt(sVerList[2] & "0")
'		end if
'		if sVerKey < 50 then
'			Form.ShowAlert("업데이트 확인 필요", "업데이트 후 처리가 가능합니다. 현재 버전 " & sVer)
'			Form.CloseForm()
'		end if
'	End if
	
	'contOther.tbl3.SetCellString( 3, 0, "은행계좌\n주민번호" )
	Form.SetScreenName("정기입금이체신청")
	g_szToday = cld0.caption
	g_szNextMonthDate = Replace(DateAdd ("m", 1, mid(g_szToday,1,4) &"-"& mid(g_szToday,5,2) &"-"& "01"), "-", "")
	cld0.caption = g_szNextMonthDate 
	
	cld0.caption = g_szNextDay
	cld1.caption = g_szNextDay
	
	rdoYear_OnClick(0)
	rdoType_OnClick( 0 )
	g_nRdoIndex = 0
	contOther.Edit2.certname = "은행계좌 주민번호 입력"
	
	g_szData = Form.GetOpenLinkData()
'Form.ShowAlert("gData", g_szData)
	contMeritz.anct0.currentindex = 0
	contMeritz.lblName.caption = contMeritz.anct0.accountname
	contMeritz.Label3.caption = contMeritz.anct0.proclsname
	
'	g_szList = Split(g_szData, "★")
'	if UBOUND(g_szList) < 1 then
'		Exit Sub
'	end if

'	g_szAcnt = g_szList(0)
''	Form.ShowAlert("계좌번호", g_szAcnt)
'	
'	g_szPW = g_szList(2)

	g_szUserID = Form.GetSharedData( "&USER_ID", false )
	
'	DATAMANAGER.SetDataValue( 0 , "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAcnt )	'계좌번호
'	DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obtss_elbs_129r" then	
		DATAMANAGER.SetDataValue( 0 , "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE" , 0 , contOther.Label4.caption )	'은행코드
		DATAMANAGER.SetDataValue( 0 , "obtss_elbs_129r", "InBlock1", "MNRC_ACNO" , 0 , contOther.Edit1.caption )	'입금계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , "1" )	'거래금액
		DATAMANAGER.SetDataValue( 0 , "obtss_elbs_129r", "InBlock1", "DRNG_ACNO" , 0 , g_szAcnt )	'출금계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , g_szList(1) )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obtss_elbs_129r", "InBlock1", "JOB_TRNO" , 0 , "031" )	
	
	elseif szTranID == "obpds_srvc_137r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_137r", "InBlock1", "CSNO" , 0 , g_szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_137r", "InBlock1", "TACT_AMT" , 0 , edtMoney.caption )		'이체금액
	
	elseif szTranID == "obwat_ctad_015a" then

		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "ACNO" , 0 , g_szAcnt)	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "ASNO" , 0 , g_szList(1))	'일련번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "CSNO" , 0 , g_szCustNum)	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_AMT" , 0 , edtMoney.caption)	'이체금액
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)	'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "RMND_SRNO" , 0 , g_szList(3) )	'펀드 잔고번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "NXET_TIMS_ATMT_APLT_YN" , 0 , "0" )	'다음회차자동신청여부
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "SVC_SRNO" , 0 , p_str_SvcSrno)	'서비스 일련번호
		'서비스해지구분코드-1:요청해지, 2:자동해지, 3:강재해지
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "SVC_CANC_CLS_CODE", 0, "1" )
		
		If g_nRdoIndex == 0 then	'메리츠일때
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_ACNT_CLS_CODE" , 0 , "1")	'이체계좌 구분코드 -> 메리츠 : 1
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_HOPE_DAY_CODE" , 0 , cmbMeritz.cbkeydata)	'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_SCRT_ACNO" , 0 , contMeritz.anct0.total )	'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_SCRT_ASNO" , 0 , contMeritz.anct0.sequence )	'일련번호
		Else
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_ACNT_CLS_CODE" , 0 , "2")	'이체계좌 구분코드 -> 타행
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_HOPE_DAY_CODE" , 0 , cmbOther.cbkeydata )	'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "BANK_CODE" , 0 , contOther.Label4.caption )	'타행기관코드
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "TACT_BANK_ACNO" , 0 , contOther.Edit1.caption )	'타행계좌번호
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "DPSR_RRNO" , 0 , contOther.Edit2.caption )	'예금자 주민등록번호
			DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "DPSR_NAME" , 0 , contOther.Label6.caption )	'예금자명
			
			'v0004
			If contOther.ChkSumm.checkstate == "1" And contOther.ChkDtl.checkstate == "1" Then
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "3" )	'동의징구서류구분코드 : 3.요약 + 상세
			ElseIf contOther.ChkSumm.checkstate == "1" Then
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "1" )	'동의징구서류구분코드 : 1.요약
			ElseIf contOther.ChkDtl.checkstate == "1" Then
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_015a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "2" )	'동의징구서류구분코드 : 2.상세
			End If    
		End if
		
		'등록
		If p_str_ProsClsCode == "1" Then
			DATAMANAGER.SetEventFlag( "obwat_ctad_015a", "I" )
		    DATAMANAGER.SetDataValue( "obwat_ctad_015a", "InBlock1", "TACT_BANK_ACNO", 0,contOther.Edit1.caption )

		'수정
		ElseIf p_str_ProsClsCode == "2" Then
			DATAMANAGER.SetEventFlag( "obwat_ctad_015a", "U" )
		    DATAMANAGER.SetDataValue( "obwat_ctad_015a", "InBlock1", "TACT_BANK_ACNO", 0,contOther.Edit1.caption )

		'삭제 후 등록
	    ElseIf p_str_ProsClsCode == "3" Then
		    DATAMANAGER.SetEventFlag( "obwat_ctad_015a", "D" )
		   	'이체은행계좌번호
		    DATAMANAGER.SetDataValue( "obwat_ctad_015a", "InBlock1", "TACT_BANK_ACNO", 0, g_TactBankAcno )
		    '이체증권계좌번호
		    DATAMANAGER.SetDataValue( "obwat_ctad_015a", "InBlock1", "TACT_SCRT_ACNO", 	0, DATAMANAGER.GetDataValue(0 , "obpds_srvc_082r", "OutBlock1", "TACT_SCRT_ACNO", 0	) )
		    'DATAMANAGER
		    DATAMANAGER.SetDataValue( "obwat_ctad_015a", "InBlock1", "TACT_SCRT_ASNO", 	0, DATAMANAGER.GetDataValue(0 , "obpds_srvc_082r", "OutBlock1", "TACT_SCRT_ASNO", 0	) )
		    
	    
	    END IF
		
	elseif szTranID == "obpds_srvc_417r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "ACNO" , 0 , g_szAcnt)	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "ASNO" , 0 , g_szList(1))	'일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "CSNO" , 0 , g_szCustNum)	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "SVCD" , 0 , "012")		'서비스코드(정기입금이체)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_AMT" , 0 , edtMoney.caption)	'이체금액
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "RMND_SRNO" , 0 , g_szList(3) )	'펀드 잔고번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "RQST_ISTU_NAME" , 0 , "메리츠증권" )	'요청기관명
		
		'v0006
		if g_szCertUserType == "5" then
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "SVCD" , 0 , "412")		'서비스코드(정기입금이체)
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "SVCD" , 0 , "012")		'서비스코드(정기입금이체)
		end if
		
		
		if g_nRdoIndex == 0 then	'메리츠일때
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_ACNT_CLS_CODE" , 0 , "1")	'이체계좌 구분코드 -> 메리츠 : 1
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_HOPE_DAY_CODE" , 0 , cmbMeritz.cbkeydata)	'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_SCRT_ACNO" , 0 , contMeritz.anct0.total )	'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_SCRT_ASNO" , 0 , contMeritz.anct0.sequence )	'일련번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "BANK_NAME" , 0 , "메리츠증권" )	'은행명
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_HOPE_DAY_CODE" , 0 , cmbOther.cbkeydata )	'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "BANK_CODE" , 0 , contOther.Label4.caption )	'타행기관코드
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_BANK_ACNO" , 0 , contOther.Edit1.caption )	'타행계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "DPSR_RRNO" , 0 , contOther.Edit2.caption )	'예금자 주민등록번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "BANK_NAME" , 0 , contOther.Label5.Caption )	'은행명
			
		end if
	elseif szTranID == "obwat_ctcs_032r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" 	, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , g_szList(3) )
	elseif szTranID == "obpds_srvc_070r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAcnt )	'계좌번호
	elseif szTranID == "obpds_srvc_221r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_221r", "InBlock1", "ACNO" , 0 , g_szAcnt 	)	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_221r", "InBlock1", "ASNO" , 0 , g_szList(1) 	)	'일련번호
	elseif szTranID == "obpds_srvc_082r" then
		DATAMANAGER.SetDataValue (0 ,"obpds_srvc_082r", "InBlock1" ,"CSNO",		0, g_szCustNum )
		DATAMANAGER.SetDataValue (0 ,"obpds_srvc_082r", "InBlock1" ,"SVCD",		0, "012" )
		DATAMANAGER.SetDataValue (0 ,"obpds_srvc_082r", "InBlock1" ,"SVC_SRNO",		0, p_str_SvcSrno)
	elseif szTranID == "obwat_ctad_023r" then
		DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"WA_ACNO",			0, g_szAcnt 		)
		DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"WA_CNRC_NO",		0, g_szList(3) 	)
		'DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"WA_PRCD",			0, "133" 		)
		DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"CSNO",				0, g_szCustNum 	)
		DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"PWD",				0, g_szPW 		)
		'DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"PROS_CLS_CODE",		0, "1" 			)
		DATAMANAGER.SetDataValue (0 ,"obwat_ctad_023r", "InBlock1" ,"WA_INDV_MGRI_ASNO",	0, g_szList(1) 			)
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim g_szCMSAble
	Dim g_szAbleAmt
	
	if szTranID == "obpds_srvc_070r" then
		g_szCustNum = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_070r", "OutBlock1", "CSNO" , 0)
		
	elseif szTranID == "obpds_srvc_137r" then		'CMS 한도 체크
		g_szCMSAble = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_137r", "OutBlock1", "UI_PROS_ABLE_YN" , 0)	'이체 가능 여부
		g_szAbleAmt = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_137r", "OutBlock1", "TACT_AMT" , 0)		'이체가능 금액
		
		if g_szCMSAble == "N" then
			Form.ShowAlert( "알림", "등록가능한 이체금액을 초과하였습니다.\n"&"(등록가능한 이체금액 : "&g_szAbleAmt&"원")
		elseif g_szCMSAble == "Y" then
			DATAMANAGER.RequestTranData( "obpds_srvc_417r" )
		end if
	
	elseif szTranID == "obpds_srvc_417r" or szTranID == "obpds_srvc_416a" then		''16-04-12 YCJ 정기이체동의 전자서명내역 등록 - 박영택 과장님 추가 || or szTranID == "obpds_srvc_416a" 추가 v0001
		DATAMANAGER.RequestTranData( "obwat_ctad_015a" )
	
	elseif szTranID == "obwat_ctad_015a" then	'이체신청완료시
	    If p_str_ProsClsCode <> "3" Then
			Form.ShowAlert( "알림", DATAMANAGER.GetDataMsgText( szTranID ) )
'			Form.ShowAlert( "알림", "자동이체신청이 완료되었습니다.")
			Form.SendReturnToParent( "TRSREQUEST_OK" , "1")
			Form.CloseForm()
		end if 
		
		'삭제 후 등록
	    If p_str_ProsClsCode == "3" Then
		    '등록
		    p_str_ProsClsCode = "1"
		    '적립식랩정보등록
		    DATAMANAGER.RequestTranData( "obwat_ctad_015a" )
	    ElseIf p_str_ProsClsCode == "1" Then
		    '등록
		    p_str_ProsClsCode = "2"	    
		ElseIf p_str_ProsClsCode == "4" Then
		    '등록
		    p_str_ProsClsCode = "2"
	    End if
	    
		
	elseif szTranID == "obpds_srvc_221r" Then
		
		'기존내역이 있는 경우에만 수정한다.
	    If DATAMANAGER.GetDataValue( 0 , "obpds_srvc_221r", "OutBlock1", "CSNO" , 0) == 0 OR DATAMANAGER.GetDataValue( 0 , "obpds_srvc_221r", "OutBlock1", "CSNO" , 0) == "" Then
		    '등록
		    p_str_ProsClsCode = "1"
	    Else
		    '수정
		    p_str_ProsClsCode = "2"
	    End If
	    
	    g_TactBankAcno = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_221r", "OutBlock1", "CUST_ACNO" , 0)		'타행계좌번호
	    '정기이체약정명세 조회
	    If DATAMANAGER.GetDataValue(0 , "obpds_srvc_221r" , "OutBlock1" , "CSNO" , 0 ) <> "" Then
		    '서비스일련번호
		    p_str_SvcSrno = DATAMANAGER.GetDataValue( 0 ,"obpds_srvc_221r" , "OutBlock1" , "SVC_SRNO" , 0 )

		    DATAMANAGER.RequestTranData "obpds_srvc_082r"
	    end if 
	elseif szTranID == "obpds_srvc_082r" Then
		g_TactScrtAcno =  DATAMANAGER.GetDataValue(0 , "obpds_srvc_082r", "OutBlock1", "TACT_SCRT_ACNO", 0	) + DATAMANAGER.GetDataValue(0 , "obpds_srvc_082r", "OutBlock1", "TACT_SCRT_ASNO", 0	)
	elseif szTranID == "obwat_ctcs_032r" Then
	
		'v0005
		gCNRC_MTRT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctcs_032r" , "OutBlock1" , "CNRC_MTRT_DATE" , 0 )
		
		cld0.caption = Left(Form.calcDateTime( nYear , nMonth, 1, nHour, nMinute, nSecond ), 8)
		cld1.caption = Left(Form.calcDateTime( 1, nMonth, nDay, nHour, nMinute, nSecond ), 8)
		gNextMonth = Left(Form.calcDateTime( nYear , 1, nDay, nHour, nMinute, nSecond ), 8)

		' 종료일자가 만기일자 이후인 경우
		if trim(gCNRC_MTRT_DATE) <> "" and cld1.caption > trim(gCNRC_MTRT_DATE)  then
			cld1.caption = gCNRC_MTRT_DATE
			
			if gNextMonth <> "" and cld1.caption < gNextMonth then
				Form.ShowAlert( "알림", "이체신청이 불가능합니다.\n종료일자 만기일 이전 / 이체기간 1개월 이상")
				cld1.caption = gCNRC_MTRT_DATE
				Exit Sub
			end if
			
		end if
	
		DATAMANAGER.RequestTranData "obwat_ctad_023r"
	elseif szTranID == "" Then
		g_szCMSAble = DATAMANAGER.GetDataValue( 0 , "obwat_ctcs_032r", "OutBlock1", "WA_PRNM" , 0)	'이체 가능 여부
	end if
	
End Sub

'============================================================================
Sub rdoType_OnClick(nIndex)
	
	If nIndex == 0 Then
		g_nRdoIndex = 0
		contMeritz.visible = True
		contOther.visible	 = False
		cmbMeritz.visible = True
		cmbOther.visible = False
		btnSave.enable = True
	Else
		g_nRdoIndex = 1
		contMeritz.visible = False
		contOther.visible	 = True
		cmbMeritz.visible = False
		cmbOther.visible = True
		btnSave.enable = False
	End If
	
End Sub

'============================================================================
Sub rdoYear_OnClick(nIndex)
	
	Select Case nIndex
		Case 0
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, 1, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 1, nMonth, nDay, nHour, nMinute, nSecond ), 8)	'1년
		Case 1
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, 1, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 2, nMonth, nDay, nHour, nMinute, nSecond ), 8)	'2년
		Case 2
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, 1, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 3, nMonth, nDay, nHour, nMinute, nSecond ), 8)	'3년
		Case 3
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, 1, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 5, nMonth, nDay, nHour, nMinute, nSecond ), 8)	'5년
	End Select
	
	gCNRC_MTRT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctcs_032r" , "OutBlock1" , "CNRC_MTRT_DATE" , 0 )
	
	IF trim(gCNRC_MTRT_DATE) <> "" and cld1.caption > trim(gCNRC_MTRT_DATE)  then
		Form.ShowAlert( "알림", "이체기간 종료일자가 만기일자보다 큽니다.")
		cld1.caption = gCNRC_MTRT_DATE
		Exit Sub
	END IF 
	
End Sub

'============================================================================
Sub edtMoney_OnEditComplete()
	
	if edtMoney.caption == "" then
	
	'v0005
	elseif Int(edtMoney.caption) < 1000 then
		Form.ShowAlert( "알림", "1천원 미만은 입력이 불가합니다.")
		edtMoney.caption = ""
		edtMoney.SetShowKeypad( true )
		Exit Sub
	end if
	
	Dim ableAmt	
	ableAmt = (Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 )) - Int(edtMoney.caption * 12) )/12

	if int(ableAmt) < 100000 then
		rdoAmt.enableindex = "0,0"
		rdoAmt.enableindex = "1,0"
		rdoAmt.enableindex = "2,0"
		rdoAmt.enableindex = "3,0"
	elseif int(ableAmt) < 500000 then
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,0"
		rdoAmt.enableindex = "2,0"
		rdoAmt.enableindex = "3,0"
	elseif int(ableAmt) < 1000000 then 
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,1"
		rdoAmt.enableindex = "2,0"
		rdoAmt.enableindex = "3,0"
	elseif int(ableAmt) < 1500000 then
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,1"
		rdoAmt.enableindex = "2,1"
		rdoAmt.enableindex = "3,0"
	else 
		rdoAmt.enableindex = "0,1"
		rdoAmt.enableindex = "1,1"
		rdoAmt.enableindex = "2,1"
		rdoAmt.enableindex = "3,1"
	end if 
	
	if Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 )) < Int(edtMoney.caption * 12) THEN
		'Form.ShowAlert( "알림", "이체금액 * 12 > 계약금액["&Int(DATAMANAGER.GetDataValue( 0 ,"obwat_ctcs_032r" , "OutBlock2" , "FRST_CNRC_AMT" , 0 ))&"] 불가.")
		Form.ShowAlert( "알림", "정기이체 신청금액이 계약금의 연간 납입한도를 초과합니다.")
		Exit Sub	
	END IF 
End Sub

'============================================================================
Sub contOther_btnBank_OnClick()
	Form.OpenPopup( "mbbnk61010_p3" , sOpenData , sPosInfo)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList
	
	If sKeyName == "이체기관" then
		szList = Split( sRet, "★")
		If UBOUND(szList) < 1 Then 'v0004
			Exit Sub
		End if
		
		g_szBankCode = szList(0)
		g_szBankName = szList(1)
	elseif sKeyName == "mhetc90060_p5" then 
		'v0001 sta
		if g_szCertUserType == "3" then
			szTempData = Split(sRet, ";")    
			if szTempData(0) == "ok" then    
				szTmpMsg = MID(sRet, 5, LEN(sRet) - 4)
				'if UBOUND(szTempData) > 2 Then
                  '   ShowAlert "return",szTempData(2)
				'     
				'   Exit Sub
				'end if
				'Form.MsgBox("xxx", szTmpMsg, "", "")
				BioSgntDataInsert(szTmpMsg)
			end if			
		else
			if sRet ~= "cancel" then
				'DATAMANAGER.RequestTranData( "obwat_ctad_015a" )
				DATAMANAGER.RequestTranData( "obpds_srvc_417r" )
			end if
		end if
		'v0001 fin
		Exit Sub
'v0002============================================
'	elseif sKeyName == "mbbnk61040_t4" then 
'		if sRet == "ok" then	'개인정보동의확인
'			Form.OpenFramePopup( "mhetc90060_p5" , sData , sPosInfo) 
'		else
'			Exit Sub
'		end if
'		Exit Sub
	ElseIf sKeyName == "mbfnp51020_pa" Then 'v0004
         If sRet == "ok" Then
             contOther.ChkSumm.checkstate = True
         Else
             contOther.ChkSumm.checkstate = False
         End If
	    CommonCheck()
     ElseIf sKeyName == "mbfnp51020_pb" Then 'v0004
         If sRet == "ok" Then
             contOther.ChkDtl.checkstate = True
         Else
             contOther.ChkDtl.checkstate = False
         End If
         CommonCheck()
	End if
	

	

	
	contOther.Label4.caption = g_szBankCode
	contOther.Label5.caption = g_szBankName

	
End Sub

