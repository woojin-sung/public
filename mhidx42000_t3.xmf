'============================================================================
' 01.화면명 	: 업종현재가
' 02.화면설명	: 업종현재가_종목구성탭
' 03.작성	: 2016.01.04
'============================================================================
'20230913 LES START : stck_cntg -> stck_incg로 교체


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szIndexCode	'지수코드
dim g_szSelectedItem	'그리드내 선택된아이템

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ShowTable() : 설정 값에 따라 알맞은 테이블 보임
'============================================================================
Function ShowTable()
	dim	szSort

	

'	0`등락율상위
'	1`등락율하위
'	2`거래량상위
' 	3`거래대금상위
'	4`시가총액상위

	szSort = rdo01T3.currentindex 
	
	if szSort = "0"	or	szSort ="1"  then 			'등락율상위, 등락율하위
		grd01T3.left = 0
		grd02T3.left = 400
	else
		grd01T3.left = 400
		grd02T3.left = 0
		
		if szSort = "2" then
			grd02T3.SetVisibleCol(5, 1)
			grd02T3.SetVisibleCol(6, 0)
			grd02T3.SetVisibleCol(7, 0)
		elseif szSort = "3" then
			grd02T3.SetVisibleCol(5, 0)
			grd02T3.SetVisibleCol(6, 1)
			grd02T3.SetVisibleCol(7, 0)
		else 
			grd02T3.SetVisibleCol(5, 0)
			grd02T3.SetVisibleCol(6, 0)
			grd02T3.SetVisibleCol(7, 1)
		end if 
		
	end if 
	
end function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grd01T3.SetClear(1)
	grd02T3.SetClear(1)
	g_szIndexCode =	Form.GetSharedData("42000INITCODE" , 0)
	DATAMANAGER.RequestTranData("ohhts_1515_001r")
End Sub


'============================================================================
'rdo01T3_OnClick()
'============================================================================
Sub rdo01T3_OnClick(nIndex)
	grd01T3.SetClear(1)
	grd02T3.SetClear(1)
	DATAMANAGER.RequestTranData("ohhts_1515_001r")
End Sub


'============================================================================
'grd02T3_OnHeaderClickUp
'============================================================================
Sub grd02T3_OnHeaderClickUp(lRow, szCellID)
	if szCellID = "th_cell3" then
		grd02T3.SetVisibleCol(3, 0)
		grd02T3.SetVisibleCol(4, 1)
	elseif	szCellID = "th_cell4" then
		grd02T3.SetVisibleCol(3, 1)
		grd02T3.SetVisibleCol(4, 0)		
	end if 
End Sub


'============================================================================
'grd01T3_OnClickUp
'============================================================================
Sub grd01T3_OnClickUp(lRow, szCellID)
	g_szSelectedItem	=	grd01T3.GetCellData("bd_cell0", lRow)

	listLocation =  Split(grd01T3.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "뉴스" & "★" & "매수" & "★" & "매도")
End Sub


'============================================================================
'grd02T3_OnClickUp
'============================================================================
Sub grd02T3_OnClickUp(lRow, szCellID)
	g_szSelectedItem	=	grd02T3.GetCellData("bd_cell0", lRow)

	listLocation =  Split(grd02T3.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "뉴스" & "★" & "매수" & "★" & "매도")
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	ShowTable()
	
	if	szTranID	=	"ohhts_1515_001r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1515_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData()
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim n1515Cnt
	dim nBefAmt
	
	if szTranID = "ohhts_1515_001r" then		'1515일시 금액/ 1000000로 변환한다. 단위가 백만임.
	
		n1515Cnt = DATAMANAGER.GetDataCount(0, "ohhts_1515_001r" , "OutBlock1")
		
		for  i = 0 to n1515Cnt - 1 
			nBefAmt = DATAMANAGER.GetDataValue(0 ,"ohhts_1515_001r", "OutBlock1", "FID_ACML_TR_PBMN" , i)
			DATAMANAGER.SetDataValue(0 ,"ohhts_1515_001r", "OutBlock1", "FID_ACML_TR_PBMN" , i, Fix(nBefAmt / 1000000,0))		'20230112 jipark HTS와 동일하게 버림처리
			'DATAMANAGER.SetDataValue(0 ,"ohhts_1515_001r", "OutBlock1", "FID_ACML_TR_PBMN" , i, Round(nBefAmt / 1000000,0))
		next 
	end if 
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealData
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	dim nStckCnt
	dim nBefAmt
	
	'20230913 LES START - incg로 변경
	'if szTranID = "ohhts_stck_cntg" then	'ohhts_stck_cntg 금액/ 1000000로 변환한다. 단위가 백만임.
	if szTranID = "ohhts_stck_incg" then		'ohhts_stck_cntg 금액/ 1000000로 변환한다. 단위가 백만임.
	
		'20230913 LES START - incg로 변경
		'nStckCnt = DATAMANAGER.GetDataCount(1, "ohhts_stck_cntg" , "OutBlock1")
		nStckCnt = DATAMANAGER.GetDataCount(1, "ohhts_stck_incg" , "OutBlock1")
		
		for  i = 0 to nStckCnt - 1 
			
			'20230913 LES START - incg로 변경
			'nBefAmt = DATAMANAGER.GetDataValue(1 ,"ohhts_stck_cntg", "OutBlock1", "RLTM_ACML_TR_PBMN" , i)
			'DATAMANAGER.SetDataValue(1 ,"ohhts_stck_cntg", "OutBlock1", "RLTM_ACML_TR_PBMN" , i, Round(nBefAmt / 1000000,0))
			nBefAmt = DATAMANAGER.GetDataValue(1 ,"ohhts_stck_incg", "OutBlock1", "RLTM_ACML_TR_PBMN" , i)
			DATAMANAGER.SetDataValue(1 ,"ohhts_stck_incg", "OutBlock1", "RLTM_ACML_TR_PBMN" , i, Round(nBefAmt / 1000000,0))
			
			
		next 
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim iCnt1515
	dim szRealCode
	
	'20230913 LES START - incg로 변경
	'DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_incg")
	
	if szTranID = "ohhts_1515_001r" then
		iCnt1515 = DATAMANAGER.GetDataCount(0, "ohhts_1515_001r" , "OutBlock1")
			for i = 0 to iCnt1515 - 1 
				szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1515_001r", "OutBlock1", "FID_SHRN_ISCD", i)
				
				'20230913 LES START - incg로 변경
				'DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", i, szRealCode)
				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", i, szRealCode)
				
			next
		
		'20230913 LES START - incg로 변경
		'DATAMANAGER.RequestRealData("ohhts_stck_cntg")
		DATAMANAGER.RequestRealData("ohhts_stck_incg")
		
		
	end if 
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName = "42000ITEMCODE"	then
		 g_szIndexCode = sParam
		 
		 DATAMANAGER.RequestTranData("ohhts_1515_001r")
	
	'20240508 HSZ START: 해외주식고도화_HOME연동 추가
	elseif sEventName = "HOME_RDOIDX" then
		if sParam <> "" then
			rdo01T3.currentindex = CInt(sParam)
		end if
	'20240508 HSZ END
	
	end if 
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'차트
			Form.OpenScreen("13000" , g_szSelectedItem) 
		elseif 	szListItems(1)	=	"2"	then		'뉴스
			Form.OpenScreen("44000" , g_szSelectedItem ) 
		elseif 	szListItems(1)	=	"3"	then		'매수
			Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem ) 
		elseif 	szListItems(1)	=	"4"	then		'매도
			Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem ) 
		else
		end if
	end if 
End Sub


