	<SCRIPT_INFO _len="1753" _ulen="1565" >
'============================================================================
' 화면명   : Smart Pro 위험고지
' 화면설명 : 
'============================================================================
' 2018-04-03 : 신재영 : 신규개발
'============================================================================
'============================================================================
Dim g_Chk0			'chk0
Dim g_Chk1			'chk1
Dim g_Chk2			'chk2

'============================================================================
Sub Form_OnFormInit()

	g_Chk0 = "0"
	g_Chk1 = "0"
	g_Chk2 = "0"

End Sub

'============================================================================
Sub Button0_OnClick()

	if g_Chk0 == "0" then		
		Form.ShowAlert( "알림", "상품구조 및 위험 설명이해 여부를 확인하여 주십시오.")
		Exit Sub
	end if
	
	if g_Chk1 == "0" then		
		Form.ShowAlert( "알림", "상품설명, 위험고지서, 거래계약서(안)의 내용 숙지여부를 확인하여 주십시오.")
		Exit Sub
	end if
	
	if g_Chk2 == "0" then		
		Form.ShowAlert( "알림", "청약관련 안내 내용을 확인하여 주십시오.")
		Exit Sub
	end if

	Form.OpenFramePopup( "mbfnp55000_p2", "" , "")
End Sub

'============================================================================
Sub Container1_ChkButton2_OnChange(sCheckState)
	
	g_Chk2 = sCheckState
	
	
End Sub

'============================================================================
Sub Container1_ChkButton0_OnChange(sCheckState)
	
	g_Chk0 = sCheckState
	
End Sub

'============================================================================
Sub Container1_ChkButton1_OnChange(sCheckState)
	
	g_Chk1 = sCheckState
	
End Sub

	</SCRIPT_INFO>
