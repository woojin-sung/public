				<LABEL name="Label0" fgcolor="095:000000000" fontsize="-2" caption="ㆍ종목 및 시장상황에 따라 대차비용이 증가할 수 있으며 하락" ly_vert="0,140,374,39,1" />
				<LABEL name="Label4" fgcolor="095:000000000" fontsize="-2" caption="의사와 무관하게 임의 조기상환될 수 있습니다." ly_vert="11,180,309,39,1" />
