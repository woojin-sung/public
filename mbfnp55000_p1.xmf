				<LABEL name="Label116" fgcolor="095:000000000" fontsize="-2" caption="수 있어 평가금액 변동성이 클 수 있습니다." ly_vert="11,420,339,39,1" />
				<LABEL name="Label119" fgcolor="095:000000000" fontsize="-2" caption="가 발생하며, 발행 시 본 증권의 평가금액에 별도로 반영됩니" ly_vert="11,470,350,39,1" />
				<LABEL name="Label1110" fgcolor="095:000000000" fontsize="-2" caption="본 증권에 청약 시 명목금액의 50bp에 해당하는 발행수수료" ly_vert="11,450,352,39,1" />
