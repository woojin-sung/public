<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="86120" scrname="비대면계좌개설_배너" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,95,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBanner" autosize="1" ly_vert="0,0,375,95,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="562" _ulen="562" >


'============================================================================
Sub Form_OnFormInitBefore()
	imgBanner.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SetBanner" and sParam <> "" and sParam <> null then
		imgBanner.imgpath = sParam
	end if
End Sub

'============================================================================
Sub imgBanner_OnClick()
	Form.OpenPopup("mbonl88031", "BDM", "")
End Sub

	</SCRIPT_INFO>
</ROOT>