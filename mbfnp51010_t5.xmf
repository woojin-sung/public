'============================================================================
' 01.화면명 		: 펀드매매
' 02.화면설명		: 펀드매매_잔고탭
' 03.작성		: 2016.02.19
' 04.수정		: 2020.09.15 비밀번호 메모리 평문 노출 취약점 조치 v001
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
dim	g_szPasswd	'계좌비밀번호

dim	g_szShortCd	'단축코드
dim	g_szStndCd	'협회코드
dim	g_szRmno		'잔고번호
dim	g_szSavetype	'저축방법
dim	g_szFundName	'펀드명
dim	g_szAlertTitle	'알림타이틀

g_szFullAcnt	=""
g_szPasswd	=""
g_szShortCd	=""
g_szStndCd	=""
g_szRmno		=""
g_szSavetype	=""
g_szFundName	=""
g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szFullAcnt= Form.GetCtlProp("#acnt01", "caption")
	'g_szFullAcnt= Form.GetCtlProp("#acnt02", "caption")
	
	if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
			DATAMANAGER.SetEventFlag("obacb_balc_030r" , "S")
			DATAMANAGER.RequestTranData("obacb_balc_030r")
	end if
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	'g_szFullAcnt	=	Form.GetCtlProp("#acnt02", "caption")
	
	if	szTranID	=	"obacb_balc_030r"	then
		DATAMANAGER.SetDataValue(0, "obacb_balc_030r", "InBlock1", "ACNO" , 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_030r", "InBlock1", "ASNO" , 0 , mid(g_szFullAcnt,9,2))
		
		'v001
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacb_balc_030r", "InBlock1", "ACNT_PWD" , 0 , g_szPasswd)
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacb_balc_030r", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData("g_szPasswd"))
		end if
	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName		=	"ACNTINFO_CHG"	then
		g_szFullAcnt= Form.GetSharedData("&ACCOUNT", 0 )
				
		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
			DATAMANAGER.RequestTranData("obacb_balc_030r")
		end if

	elseif	sEventName	=	"PWDINFO_CHG"	then
		g_szPasswd	=	sParam
		
		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
			DATAMANAGER.RequestTranData("obacb_balc_030r")
		end if
	end if
	
End Sub


'============================================================================
'grdT501_OnClickUp
'============================================================================
Sub grdT501_OnClickUp(lRow, szCellID)
	g_szShortCd		=	grdT501.GetCellData("bd_cell9", lRow)
	g_szStndCd		= 	grdT501.GetCellData("bd_cell10", lRow)
	g_szRmno			=	grdT501.GetCellData("bd_cell2", lRow)
	g_szSavetype		=	grdT501.GetCellData("bd_savetype", lRow)
	g_szFundName		=	grdT501.GetCellData("bd_cell0", lRow)
	
	listLocation =  Split(grdT501.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "1"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "펀드상세" & "★" & "관심펀드등록" & "★" & "매도" & "★" & "추가매수" & "★" & " ")

	'각 기능 필요값
	'추가매수 '잔고, 저축방법, 펀드코드, 펀드명
	'펀드상세 'Shortcd, StndCd
	'관심펀드 'Shortcd
	'매도	 '잔고, 저축방법, 펀드코드, 펀드명	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n030Cnt, nDivCnt
	dim	szOrgWay, szTransWay
	dim	nIntrIdx	
	dim  nMulti
	dim	szisMore	'다음데이터있는지..
	
	nIntrIdx	=	0
	szisMore	=	""
	
	if	szTranID	=	"obacb_balc_030r"	then
		n030Cnt 	=	grdT501.rowcount
		nDivCnt	=	DATAMANAGER.GetDataCount(0, "obacb_balc_030r" , "OutBlock2")
		nMulti =  ( n030Cnt / nDivCnt) - 1
		
		for	i=0+(nMulti * nDivCnt) to	n030Cnt -1
			szOrgWay 	 =	grdT501.GetCellData("bd_savetype", i)
	
			szTransWay =  Form.GetMetaData("집합투자증권저축유형코드", szOrgWay)
			grdT501.SetCellData("bd_savetype", i, szTransWay)
		next
	elseif	szTranID	=	"oocwi_mall_002r"	then
			
			szisMore	=	DATAMANAGER.IsMoreNextData("oocwi_mall_002r")
			
			if	szisMore	=	true		then
				DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "PROS_CLS_CODE", 0 , "2")
				DATAMANAGER.RequestNextData("oocwi_mall_002r")
				Exit	Sub
			end	if
			
			nIntrIdx = grdIntrFund01.rowcount
					
			'1. 기존관심펀드에 등록되어있는지 확인
			for	i = 0	to	nIntrIdx	- 1
				szIntrCD	=	grdIntrFund01.GetCellData("bd_cell0", i)
				if	trim(szIntrCD)	=	trim(g_szShortCd)	then
					Form.ShowAlert(g_szAlertTitle, "이미 등록된 펀드가 존재합니다.")
					exit sub
				end if
			next
			
			
			'2. 기존에 관심펀드 없을경우 있을경우만 그리드에 추가
			grdIntrFund01.AddRow()
			grdIntrFund01.SetCellData("bd_cell0", nIntrIdx  , g_szShortCd)
			
			nIntrIdx = grdIntrFund01.rowcount		'등록되기전 조회하여 데이터 들어간 갯수체크 재확인

'			'3. 등록 TR 전송
			for	i = 0	to	nIntrIdx -1 
				szCode	=	grdIntrFund01.GetCellData("bd_cell0", i)
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", i  , "1")	'집합투자증권 1
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", i, szCode)
			next
			
			DATAMANAGER.SetEventFlag("oocwi_gmyg_011a", "A")
			DATAMANAGER.RequestTranData("oocwi_gmyg_011a")
	elseif	szTranID	=	"oocwi_gmyg_011a"	then
			Form.ShowAlert(g_szAlertTitle, "관심펀드에 등록 완료되었습니다.")
	end if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "MOVEPOP_RETURN"	then				'미니팝업처리
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then		'펀드상세
			Form.OpenFramePopup("mbfnp51000_p2", g_szShortCd & "★" & g_szStndCd & "★" & g_szFundName, sPosInfo)
			
		elseif 	szListItems(1)	=	"1"	then		'관심등록
						
			'관심펀드 조회 TR		
			DATAMANAGER.ClearInputData(0, "oocwi_mall_002r")
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "PROS_CLS_CODE", 0 , "2")
			DATAMANAGER.RequestTranData("oocwi_mall_002r")
			
		elseif	szListItems(1)	=	"3"		or	szListItems(1)	=	"2"	then			'신규매수	'매도
			
			'1. 메인에 데이터 재조회
			Form.triggerEvent("#", "CHGCODE_51010", g_szShortCd & "★" & g_szStndCd  & "★" & g_szFundName)
			
			'2. 잔고번호, 저축방법 재세팅
			Form.SetSharedData("SAVETYPE_51010" , g_szSavetype)			'추가매수위함
			Form.SetSharedData("RMNDNO_51010", g_szRmno)					'추가매수위함
			
			'3. 탭이동
			if	szListItems(1)	=	"3"		then				'추가매수
				'Form.triggerEvent("#", "CHGTAB_51010", "1")
				Form.triggerEvent("#", "MOVE_ADDBUY", g_szRmno)			'추가매수로이동
			elseif	szListItems(1)	=	"2"		then			'매도
				Form.triggerEvent("#", "MOVE_SELL", g_szRmno)			'추가매수로이동
			end if
			
		end if
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub


