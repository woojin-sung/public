	<SCRIPT_INFO _len="1999" _ulen="1977" >
--===========================================================================
' 2023.01.10 : 이학록 : v001. 주건거래시세 추가
--===========================================================================
'============================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_NextCnt
Dim g_szDytmYN
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TRANCALL" then
		
		tmp = Split(sParam,"||")
		
		g_NextCnt = 0
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		g_szDytmYN = tmp(2)
		
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_208r", "InBlock1", "ACNO" 		  , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_208r", "InBlock1", "ASNO" 		  , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_208r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , g_szDytmYN)
		
		DATAMANAGER.RequestTranData("obtro_oder_208r")
		
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtro_oder_208r" then
		for i = g_NextCnt to grd0.rowcount - 1
			crcd = grd0.GetCellData("bd_cell0", i)
			frcr_amt = grd0.GetCellData("bd_cell2", i)
			vltn_amt	= grd0.GetCellData("bd_cell3", i)

			'grd0.SetCellData("bd_cell2", i, FormatNumber(frcr_amt,2))
			'grd0.SetCellData("bd_cell3", i, FormatNumber(vltn_amt,2))
			
			
'			if crcd = "USD" then
'				grd0.SetCellData("bd_cell2", i, FormatNumber(frcr_amt,4))
'				grd0.SetCellData("bd_cell3", i, FormatNumber(vltn_amt,4))
'			else
'				grd0.SetCellData("bd_cell2", i, FormatNumber(frcr_amt,3))
'				grd0.SetCellData("bd_cell3", i, FormatNumber(vltn_amt,3))
'			end if
		next
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_oder_208r", "OutBlock1")
	end if
End Sub


'============================================================================
Sub Form_OnFormInit()
	g_NextCnt = 0
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtro_oder_208r" trcode="obtro_oder_208r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtro_oder_208r" title="잔고 / 증거금 조회 (외화잔고 ?" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="189" _ulen="137" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
DYTM_TR_CLPR_APLY_YN^주간거래종가적용여부^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="30" inout="out" _len="1484" _ulen="1092" >

CRCD^통화코드^3^0^0^0^0^0^0
FRCR_AMT1^예수금^20^3^7^0^0^0^0
FRCR_AMT2^추정예수금^20^3^7^0^0^0^0
ODER_MARG_CAMT^주문증거금통화금액^20^4^7^0^0^0^0
CAMT^재매수통화금액^20^4^7^0^0^0^0
TR_CAMT^주문가능통화금액^20^4^7^0^0^0^0
DRNG_ABLE_FRCR_AMT^출금가능외화금액^20^3^7^0^0^0^0
RGPL_STUP_CAMT^질권설정통화금액^20^4^7^0^0^0^0
OTST_SELN_CAMT^미결제매도통화금액^20^4^7^0^0^0^0
OTST_BYOV_CAMT^미결제매수통화금액^20^4^7^0^0^0^0
VLTN_CAMT1^주식평가금액^20^4^7^0^0^0^0
VLTN_CAMT2^자산평가금액^20^4^7^0^0^0^0
WNCR_VLTN_AMT^원화평가금액^19^0^7^0^0^0^0
WNCR_BYOV_AMT^원화매수금액^19^0^7^0^0^0^0
WNCR_VLTN_PRLS_AMT^원화평가손익금액^19^0^7^0^0^0^0
