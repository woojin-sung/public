'============================================================================
' 01.화면명 	: 펀드매매
' 02.화면설명	: 펀드매매_매도탭
' 03.작성	: 2016.02.19
' 04.수정 	: 2020.09.15 : 비밀번호 메모리 평문 노출 취약점 조치 v001 
'		: 2022.03.07 : v002 정우희 러시아펀드 매수/환매 불가 팝업창 추가
'               : 2022.06.21 : v003 임동군 매도구분 변경에 따라 caption 변경
'============================================================================



'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt		'계좌번호 8+2
dim	g_szPasswd		'비밀번호
dim	g_szRmndNo		'펀드잔고번호

dim	g_szShortCd		'펀드단축코드
dim	g_szStndCd		'펀드풀코드
dim	g_szFndname		'펀드명
dim	g_szDealFee		'수수료
dim	g_szOvrlSptxCd	'종합분리과세구분코드

dim	g_szIISC_FEE_LEVY_CLS_CODE	'집합투자증권수수료징수구분코드
dim	g_szAPRV_YN				'승인여부
dim	g_szUI_ATMT_BYOV_STPL_YN	'UI 자동매수1약정여부
dim	g_szCNVR_ABLE_YN			'전환가능여부
dim	g_szAlertTitle	'알림타이틀

g_szFullAcnt	=	""	
g_szPasswd	=	""
g_szRmndNo	=	""

g_szShortCd	=	""
g_szStndCd	=	""
g_szFndname	=	""
g_szDealFee	=	""
g_szOvrlSptxCd =	""

g_szIISC_FEE_LEVY_CLS_CODE	= "3"	'최초3입력
g_szAPRV_YN				= ""		'최초 NULL입력
g_szUI_ATMT_BYOV_STPL_YN	= "N"	'최초 N입력
g_szCNVR_ABLE_YN			= "N"	'최초 N입력

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'ResetItems
'============================================================================
Function	ResetItems()

	'1. 잔고번호
	'2. 저축방법
	'3. 매도신청좌수초기화
	'4. 매도가능잔고, 평가금액, 예상환매수수료 초기화

	g_szRmndNo	=	""				'잔고번호
	g_szSaveType	=	""				'저축방법

	tbl01.SetCellString(0, 1, "")		'잔고번호
	tbl01.SetCellString(1, 1, "")		'저축방법
	edtSellAmt.caption	=	"0"		'매도가능좌수

	tbl02.SetCellString(0, 1, "0")
	tbl02.SetCellString(1, 1, "0")
	tbl02.SetCellString(2, 1, "0")

End	Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	ResetItems()
	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")			'1. 계좌만 세팅
		
End Sub


'============================================================================
'btnBal_OnClick
'============================================================================
Sub btnBal_OnClick()
	Form.OpenPopup("mbfnp51010_p2" , g_szFullAcnt , sPosInfo)
End Sub



'============================================================================
'btnDeal_OnClick
'============================================================================
Sub btnDeal_OnClick()
	if	g_szShortCd	=	NULL	 	or		len(trim(g_szShortCd))	<	0	then
		Form.ShowAlert(g_szAlertTitle, "종목코드를 입력하여 주십시오.")
	end	if

	if	len(g_szShortCd)	>	0	and	len(g_szFndname) > 0	then
		Form.OpenPopup("mbfnp51010_p3" , g_szShortCd & "★" & g_szFndname , sPosInfo)
	end if
End Sub


'============================================================================
'btnCaution_OnClick
'============================================================================
Sub btnCaution_OnClick()
	Form.OpenPopup("mbfnp51010_p4" , "", sPosInfo)
End Sub


'============================================================================
'cmbSellType01_OnEditComplete
'============================================================================
Sub cmbSellType01_OnEditComplete(iIndex)
	if iIndex  =   1	 then
		edtSellAmt.caption	=	"0"		'좌수매도일경우는 '0세팅
		edtSellAmt.enable	=	true
		edtSellAmt.hintcaption =      "좌수입력"  'v003
		tbl04.SetCellString(0, 0, "매도신청좌수")  'v003
	elseif	iIndex	=	2	then
		edtSellAmt.caption	=	tbl02.GetCellString(0, 1)
		edtSellAmt.enable	=	false
		tbl04.SetCellString(0, 0, "매도신청좌수")   ' v003
	else
		edtSellAmt.caption	=	"0"		'정액매도일경우는 '0세팅
		edtSellAmt.enable	=	true
		edtSellAmt.hintcaption =      "금액입력"   ' v003
		tbl04.SetCellString(0, 0, "매도신청금액")  ' v003
	end	if
End Sub


'============================================================================
'btnSell_OnClick
'============================================================================
Sub btnSell_OnClick()

	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	
	if	len(trim(g_szFullAcnt))	<	8	then
		Form.ShowAlert(g_szAlertTitle, "계좌번호를 입력해 주십시오.")
		Exit Sub
	end	if
	
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")

	if	len(trim(g_szPasswd))	<	4	then
		Form.ShowAlert(g_szAlertTitle, "비밀번호를 확인해 주십시오.")
		Exit Sub
	end	if
	
	if	g_szRmndNo =	""		or		tbl01.GetCellString(0, 1)	=	""		then
		Form.ShowAlert(g_szAlertTitle, "매도펀드를 선택하여 주시기 바랍니다.")
		Exit	Sub
	end if
	
	if	CDBL(edtSellAmt.caption)		>	CDbl(tbl02.GetCellString(0, 1))		or
		CDBL(edtSellAmt.caption)		=	0								then
		
	        IF cmbSellType01.cbkeydata = "01" THEN
		    Form.ShowAlert(g_szAlertTitle, "매도신청 금액을 확인바랍니다.")
		ELSE
		    Form.ShowAlert(g_szAlertTitle, "매도신청 좌수를 확인바랍니다.")
		END IF
		Exit	Sub
	end	if
	
	
	
	if (( Form.GetSharedData("SAVETYPE_51010", 0) = "자유적립식" or Form.GetSharedData("SAVETYPE_51010", 0) = "정액적립식" ) and cmbSellType01.cbkeydata = "03" ) then
		ShowAlert "알림", "가입하신 적립식저축펀드를 전액매도하시면 자동으로 저축계약이 해지됩니다. 해지 후 추가매수하실 수 없습니다."
	end if
	
	'부동산분리과세 잔고 매도 시 팝업 요청
	if	g_szOvrlSptxCd = "9" then
		ShowAlert "알림", "공모부동산펀드 분리과세 신청 된 잔고로 과세 혜택 내역이 있는 경우 수정신고 대상이며, 세금추징이 발생될 수 있습니다."
	end if
	
'	'분리과세하이일드 추가
	DATAMANAGER.RequestTranData("obacp_opop_030r")
'	DATAMANAGER.RequestTranData("obacp_opop_068r")	'030r 다음으로 이동.
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	dim	szNewAcnt	'이벤트에 의해 가져온 계좌번호
	szNewAcnt	=	""
	
	'-------------------------------------------------
	'펀드코드변경시
	'-------------------------------------------------
	if	sEventName		=	"FNDCODE_CHG"	then					'펀드코드변경
	
		if	len(sParam)	>	3	then
		
			g_szShortCd	=	getListItem(sParam, 0)
			g_szStndCd	=	getListItem(sParam, 1)
			g_szFndname	=	getListItem(sParam, 2)
		
		end	if
		
		'v002
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD", 0 , "02") '추가매수
		DATAMANAGER.RequestTranData("obsai_deal_701r")
	'-------------------------------------------------
	'계좌변경시
	'-------------------------------------------------
	elseif	sEventName	=	"ACNTINFO_CHG"	then
	
		szNewAcnt= Form.GetCtlProp("#acnt01", "caption")
		
		if	szNewAcnt	<>	g_szFullAcnt	then		'계좌가 변경될때만 화면 리셋
			g_szFullAcnt	=	szNewAcnt	
			ResetItems()
		end	if
					
		if	len(trim(g_szFullAcnt)) > 8		and 		len(trim(szRmno))	>	0	then
				DATAMANAGER.RequestTranData("obsai_deal_042r")
		end if
	
	'-------------------------------------------------
	'비밀번호변경시
	'-------------------------------------------------
	elseif	sEventName	=	"PWDINFO_CHG"	then
		'g_szPasswd	=	sParam

	'-------------------------------------------------
	'잔고번호 로 세팅
	'-------------------------------------------------
	elseif	sEventName	=	"INIT_WITHRMNO"	then
		
		g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")

		'1. 잔고번호 가져옴
		g_szRmndNo = Form.GetSharedData("RMNDNO_51010", 1)
		
		'2. 잔고번호와 저축방법 세팅
		
		tbl01.SetCellString(0, 1, g_szRmndNo)								'잔고번호
		tbl01.SetCellString(1, 1, Form.GetSharedData("SAVETYPE_51010", 0))		'저축방법
		
		'3. 계좌, 잔고있을시 조회
		if	len(trim(g_szFullAcnt)) > 8		and 		len(trim(g_szRmndNo))	>	0	then
			DATAMANAGER.RequestTranData("obsai_deal_042r")
		end if
		
	'-------------------------------------------------
	'잔고번호 없이 초기화
	'-------------------------------------------------	
	elseif	sEventName	=	"INIT_NORMNO"	then
	
		'1. 잔고조회
	
		btnBal_OnClick()
		
	'--------------------------------------------
	'종목검색을 통해이벤트 받을시
	'--------------------------------------------	
	elseif	sEventName	=	"RESET_ITEM"	then							
		ResetItems()
	'	DATAMANAGER.RequestTranData("obsai_deal_042r")
		g_szShortCd	= ""
		g_szFndname	= ""
	end if
	
End sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	
	'---------------------------------------
	'매도가능잔고조회
	'---------------------------------------
	if	szTranID	=	"obsai_deal_042r"	then
		DATAMANAGER.ClearInputData(0, "obsai_deal_042r")
	
		DATAMANAGER.SetDataValue(0,"obsai_deal_042r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0,"obsai_deal_042r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0,"obsai_deal_042r", "InBlock1", "RMND_SRNO", 0, g_szRmndNo )

		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "DEAL_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "LOAN_YN", 0, "N")
		
		
	'---------------------------------------
	'비밀번호조회
	'---------------------------------------
	elseif		szTranID	=	"obacp_opop_068r"	then
		DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		
		'v001
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNT_PWD", 0, g_szPasswd)
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPasswd))
		end if
		
		
		
		
	'---------------------------------------
	'펀드매도
	'---------------------------------------
	elseif		szTranID	=	"obsai_deal_002a"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "RMND_SRNO", 0, g_szRmndNo)
		
		'v001
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ACNT_PWD", 0, g_szPasswd)
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPasswd))
		end if
		
		
		'IISC_SELN_FORM_CLS_CODE	'매도구분		컴포넌트직접연결
		'SELN_ACNU				'매도신청좌수는	컴포넌트직접연결

		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "RNVS_RMND_INCU_SELN_YN"	,0 ,"N")
		DATAMANAGER.SetDataValue(0,	 "obsai_deal_002a", "InBlock1", "IISC_FEE_LEVY_CLS_CODE"	,0 ,g_szIISC_FEE_LEVY_CLS_CODE)	'최초3 , 추후 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "TACT_APLT_YN"			,0 ,"N")
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "TACT_MTHD_CLS_CODE"		,0 ,"00")
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "PNSN_MOVE_APLT_YN"		,0 ,"N")
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "APRV_YN"					,0 ,g_szAPRV_YN)							'최초 NULL, 이후 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "UI_ATMT_BYOV_STPL_YN"		,0 ,g_szUI_ATMT_BYOV_STPL_YN)		'최초 N 입력, 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "CNVR_ABLE_YN"			,0 ,g_szCNVR_ABLE_YN)	'최초 N입력, 이후 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ODER_GRP_NO" 			,0 ,"0")
		
		
		
	'---------------------------------------
	'분리과세하이일드 펀드 체크
	'---------------------------------------
	elseif		szTranID	=	"obacp_opop_030r"	then
		DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "RMND_SRNO", 0, g_szRmndNo)
		
		'v001
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ACNT_PWD", 0, g_szPasswd)
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPasswd))
		end if		
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szMsgCode

	szMsgCode	=""

	if	szTranID	=	"obacp_opop_068r"	then
		Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)			'공인인증서로그인될때 오픈해서 테스트
				
	elseif	szTranID	=	"obsai_deal_002a"	then	
	
		
		szMsgCode	=	DATAMANAGER.GetDataMsgCode("obsai_deal_002a")
		'Form.ShowAlert("Rcv_Msgcode", szMsgCode)
		
		if	szMsgCode	=	"0354"	then
			Form.MsgBox(g_szAlertTitle, "정기입금 이체가 신청중입니다. 매수자금이 입금 될 수 있으니 확인 바랍니다." , "MSG_0354", "6")
		elseif	szMsgCode	=	"4304"	then
			Form.MsgBox(g_szAlertTitle, "정기이체약정이 설정된 펀드입니다. 정기이체약정 유지 및 해지 여부를 확인하세요." , "MSG_4304", "6")
		elseif	szMsgCode	=	"7550"	then
			Form.MsgBox(g_szAlertTitle, "적립식 일부매도는 임의식으로 자동 전환 됩니다." , "MSG_7550", "6")
		elseif	szMsgCode	=	"3016"	then
			if	cmbSellType01.cbkeydata	=	"02"		or	cmbSellType01.cbkeydata	=	"03"		then
				Form.MsgBox(g_szAlertTitle, "환매수수료가 징구됩니다. 처리하시겠습니까?" , "MSG_3016A", "1")
			else
				Form.MsgBox(g_szAlertTitle, "정액매도시 환매수수료가 징구될 수 있습니다. 처리하시겠습니까?" , "MSG_3016B", "1")	'MTS오픈이후 사용됨.
			end	if
		elseif	szMsgCode	=	"5132"	then
			Form.MsgBox(g_szAlertTitle, "적립식 일부매도는 임의식으로 자동전환됩니다." , "MSG_5132", "6")
		else
			Form.ShowAlert(g_szAlertTitle, "정상적으로 매도되었습니다.")
			edtSellAmt.caption	=	"0"		'매도가능좌수
			DATAMANAGER.RequestTranData("obsai_deal_042r")
		end	if
	elseif	szTranID	=	"obsai_deal_042r"	then	
		if cmbSellType01.cbkeydata = "01"	then			'정액매도시
			cmbSellType01_OnEditComplete(0)
		elseif	cmbSellType01.cbkeydata = "02"	then		'좌수매도시
			cmbSellType01_OnEditComplete(1)
		elseif	cmbSellType01.cbkeydata = "03"	then		'전액매도시
			cmbSellType01_OnEditComplete(2)
		end	if
	'v002
	elseif	szTranID	=	"obsai_deal_701r"	then
		 g_szFND_DEAL_RSTC_CLCD = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "FND_DEAL_RSTC_CLCD", 0)	'펀드매매제한구분코드
		 g_szTN_INFORM_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "TN_INFORM_YN", 0)		'주의알림여부
		 g_szDEAL_ABLE_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "DEAL_ABLE_YN", 0)		'매매제한여부
		 
		 if g_szTN_INFORM_YN = "Y" then
			 if g_szFND_DEAL_RSTC_CLCD = "002" then
				 Form.ShowAlert("알림", "선택하신 펀드는 주요 투자 지역(러시아)의 지정학적 리스크 확대 및 투자자산의 유동성 제한에 따라 환매 연기 조치 되었습니다. 환매연기 사유 해소시까지 환매신청이 제한됨을 안내드립니다. 자세한 사항은 고객센터(1588-3400)또는 거래 영업점으로 문의하시기 바랍니다.")	 
			 end if
			 
			 if g_szDEAL_ABLE_YN = "N" then
				 btnSell.enable = FALSE
			 end if
	      else 
			 btnSell.enable = TRUE
		 end if	
		 
	'---------------------------------------
	'분리과세하이일드 펀드 체크
	'---------------------------------------
	elseif		szTranID	=	"obacp_opop_030r"	then
		dim szOVRL_SPTX_CLS_CODE, szJOIN_DATE, tmpToDate, tmpPre1Year

		szOVRL_SPTX_CLS_CODE = DATAMANAGER.GetDataValue(0,"obacp_opop_030r", "OutBlock1", "OVRL_SPTX_CLS_CODE", 0)	'종합 분리과세 구분 코드
		szJOIN_DATE = DATAMANAGER.GetDataValue(0,"obacp_opop_030r", "OutBlock1", "JOIN_DATE", 0)	'가입 일자
		
		tmpToDate = LEFT(Calendar0.caption,4) & "-" & RIGHT(LEFT(Calendar0.caption,6),2) & "-" & RIGHT(Calendar0.caption,2)	'오늘날짜		
		tmpPre1Year = CStr(DateAdd("d",0,DateAdd("m", -12, CDate(CStr(tmpToDate)))))	'1년전 오늘
		tmpPre1Year = Replace(tmpPre1Year, "-", "")
		
		tmpToDate = Replace(tmpToDate, "-", "")
		
'ShowAlert(szJOIN_DATE , tmpPre1Year .. " : " .. tmpToDate)

		if szOVRL_SPTX_CLS_CODE == "8" and 
			(CDBL(szJOIN_DATE) >= CDBL(tmpPre1Year))  and (CDBL(szJOIN_DATE) <= CDBL(tmpToDate)) then
			
			Form.MsgBox(g_szAlertTitle, "분리과세 하이일드 펀드를 가입일로부터 1년 이내에 환매하는 경우 감액세액이 추징됩니다" , "MSG_HIGH", "1")			
		else
		
			DATAMANAGER.RequestTranData("obacp_opop_068r")
			
		end if
		
		
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim	szMsgCode
	dim	szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if	szTranID	=	"obsai_deal_042r"	then
	
		szMsgCode	=	DATAMANAGER.GetDataMsgCode("obsai_deal_042r")
		
		if	szMsgCode	<>	"1594"	then		'잔고가 없습니다.:MSGCODE =1594
			if	len(trim(szSubMsg))	>	0	then
				Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
			else
				Form.ShowAlert(g_szAlertTitle, szErrMsg )
			end	if
		end	if
		
		tbl02.SetCellString(0, 1, "0")
		tbl02.SetCellString(1, 1, "0")
		tbl02.SetCellString(2, 1, "0")
	else
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	end if
	
End Sub	


'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName = "MSG_0354" then							'정기입금 이체가 신청중..
		if	sRet		=	"close"		then
			g_szUI_ATMT_BYOV_STPL_YN	= "Y"	
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_4304" then						'정기이체약정이 설정된 펀드..
		if	sRet		=	"close"		then
			g_szUI_ATMT_BYOV_STPL_YN	= "Y"	
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_7550" then						'적립식 일부매도는 임의식으로 자동전환됨
		if	sRet		=	"close"		then
			g_szCNVR_ABLE_YN			= "Y"
			g_szAPRV_YN				= "Y"				'160324 권오상과장님 요청에 의해 추가.
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_3016A" then					'전액, 일부
		if	sRet		=	"ok"		then
			g_szIISC_FEE_LEVY_CLS_CODE	= "1"	'최초3입력
			g_szCNVR_ABLE_YN			= "Y"	'최초 N입력
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_3016B" then					'정액매도
		if	sRet		=	"ok"		then
			g_szIISC_FEE_LEVY_CLS_CODE	= "1"	'최초3입력
			g_szCNVR_ABLE_YN			= "Y"	'최초 N입력
			g_szUI_ATMT_BYOV_STPL_YN	= "Y"	'최초 N입력
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_5132" then						'적립식 일부매도는 임의식으로 자동전환됨
		if	sRet		=	"close"		then
			g_szCNVR_ABLE_YN			= "Y"	'최초 N입력
			g_szAPRV_YN				= "Y"	'최초 NULL입력
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_HIGH" then	
		if	sRet		=	"ok"		then
			DATAMANAGER.RequestTranData("obacp_opop_068r")
		end if		
	end	if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim	szRmno,	szSaveType,	szFundCode,	szStndCode,	szFundName
	
	'-----------------------------------
	'잔고팝업(CLOSE시)
	'-----------------------------------	
	if	sKeyName	=	"51010_RMNOSELECTED"	then
		if	sRet	=	"0"		then
			'Form.triggerEvent("#", "CHGTAB_51010", "4")
			ResetItems()
		end	if
		
	'-----------------------------------
	'잔고팝업
	'-----------------------------------		
	elseif	sKeyName	=	"51010_RMNO"	then
		
		if	len(sRet)	>	4	then
			szRmno		=	getListItem(sRet, 0)
			szSaveType	=	getListItem(sRet, 1)
			szFundCode	=	getListItem(sRet, 2)	'펀드코드
			szStndCode	=	getListItem(sRet, 3)	'표준코드
			szFundName	=	getListItem(sRet, 4)	'펀드명
			g_szOvrlSptxCd	=	getListItem(sRet, 5)	'종합분리과세코드
			
					
			tbl01.SetCellString(0, 1, szRmno)		'잔고번호
			tbl01.SetCellString(1, 1, szSaveType)	'저축방법
				
			g_szRmndNo	=	szRmno
				
			Form.triggerEvent("#", "CHGCODE_51010", szFundCode & "★" &	 szStndCode & "★" & szFundName) 	
			
			g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
			
			edtSellAmt.caption	=	"0"		'매도가능좌수
			if	len(trim(g_szFullAcnt))  > 8	and 	len(trim(szRmno))	>	0	then
				DATAMANAGER.RequestTranData("obsai_deal_042r")
			else
				ResetItems()
			end	if
		end	if

	'-----------------------------------
	'공인인증검증
	'-----------------------------------	
	elseif	sKeyName	=	"mhetc90060_p5"	then			

		if	 sRet	<>	"cancel"		then
				
			g_szIISC_FEE_LEVY_CLS_CODE	= "3"	'최초3입력
			g_szAPRV_YN				= ""		'최초 NULL입력
			g_szUI_ATMT_BYOV_STPL_YN	= "N"	'최초 N입력
			g_szCNVR_ABLE_YN			= "N"	'최초 N입력
			
			g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")

			if	len(trim(g_szPasswd))	<	4	then
				Form.ShowAlert(g_szAlertTitle, "비밀번호를 확인해 주십시오.")
				Exit Sub
			end	if
	
			if	len(trim(g_szPasswd))	>=	4	and	len(trim(g_szFullAcnt))	>=	10	then
					
				'계좌번호, 잔고번호, 펀드명, 매도신청좌수, 잔고평가금액 
				Form.OpenPopup("mbfnp51010_p7" , g_szFullAcnt & "★" &  g_szRmndNo & "★" &  g_szFndname & "★" &
												 edtSellAmt.caption & "★" &  tbl02.GetCellString(1, 1) & "★" &  cmbSellType01.cbkeydata  , sPosInfo)
			end	if
			
								
		end	if
	'-----------------------------------
	'매도확인팝업창
	'-----------------------------------	
	elseif	sKeyName	=	"mbfnp51010_p7"	then
	
		szSect	=	getListItem(sRet, 0)
		
		if	szSect	=	"ok"		then
			g_szDealFee	=	getListItem(sRet, 1)
			
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")

		end	if
	end if
End Sub


'============================================================================
'edtSellAmt_OnEditComplete
'============================================================================
Sub edtSellAmt_OnEditComplete()
	dim nAbleAmt			'가능금액
	dim nInputAmt			'매도신청좌수
	nAbleAmt	=	0
	
	nAbleAmt		=	CDbl(tbl02.GetCellString(0, 1))
	nInputAmt	=	edtSellAmt.caption

	if	Cdbl(nInputAmt)	>	Cdbl(nAbleAmt)	then
	        IF cmbSellType01.cbkeydata = "01" THEN
		    Form.ShowAlert(g_szAlertTitle, "매도가능 금액을 초과합니다.")
		ELSE
		    Form.ShowAlert(g_szAlertTitle, "매도가능 좌수를 초과합니다.")
		END IF
		edtSellAmt.caption	=	"0"
	end	if
End Sub

