'============================================================================
Sub Form_OnFormInit()

	prtf_id = Cstr(Form.GetOpenLinkData())

	DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock2", "PRTF_ID" , 0 , prtf_id)
	DATAMANAGER.RequestTranData("obcpp_intr_722r")


	 ChartEx0.SetAccrueName("최고 수익률,평균 수익률,최저 수익률")
	 
     gTempDate= ""
	gTempData1=""
	gTempData2=""
	gTempData3=""
	 
	 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)


 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "ADCP_NAME" , 0) '자문사명
 Table5.SetCellString(0, 1 , tmp)
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "PRTF_NAME" , 0) '포트폴리오명
 Table5.SetCellString(1, 1 , tmp)
 
 
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "INP_INVT_INCL_CLCD" , 0) '포트폴리오 위험등급
 
 if abs(tmp) == 1 then
	tmp = "안정형"
	  
	elseif abs(tmp) == 2 then
	tmp = "안정추구형"
	
	elseif abs(tmp) ==3 then
	tmp = "중립형"
	
	elseif abs(tmp) == 4 then
	tmp = "수익추구형"
	
	elseif abs(tmp) ==5 then
	tmp = "고수익추구형"
	
end if
	
 
Table5.SetCellString(2, 1 , tmp)
 
 
 
 
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "FERT" , 0) '수수료
 Table5.SetCellString(3, 1 , round(tmp,2)&"%")
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_ERT_MAX_VAL" , 0) '최고수익률
Table5.SetCellString(4, 1 , round(tmp,2)&"%")
high_rate = round(tmp,2)
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_ERT" , 0) '평균수익률
Table5.SetCellString(5, 1 ,round(tmp,2)&"%")
avg_rate = round(tmp,2)
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_ERT_MIN_VAL", "UI_ERT" , 0) '최저수익률
 Table5.SetCellString(6, 1 ,round(tmp,2)&"%")
 low_rate = round(tmp,2)

 lwst_join_amt = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "LWST_JOIN_AMT" , 0) '최저가입금액 -> 최초투자금액으로 사용
 cnrc_prd = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "CNRC_PRD" , 0) '계약기간
 
 
 invt_sum = lwst_join_amt/10000 + (50 * cnrc_prd) '총 투자원금
 
 low_result = invt_sum + (invt_sum * low_rate/100 ) '최저수익률로 계산만 시뮬레이션 값 결과
 avg_result = invt_sum + (invt_sum * avg_rate/100 ) '평균수익률로 계산만 시뮬레이션 값 결과
 high_result = invt_sum + (invt_sum * high_rate/100 ) '최고수익률로 계산만 시뮬레이션 값 결과
 
 tmp_low = round(low_result / Cint(cnrc_prd),0)
 tmp_avg = round(avg_result / Cint(cnrc_prd),0)
 tmp_high = round(high_result / Cint(cnrc_prd),0)
 
 
 '그래프 데이터 설정
 for i = 0 to cnrc_prd
	
	if i == cnrc_prd then
	gTempDate = gTempDate&dateadd("m",i,date)
	gTempData3 = gTempData3&Cstr(tmp_low*i)
	gTempData2 = gTempData2&Cstr(tmp_avg*i)
	gTempData1 = gTempData1&Cstr(tmp_high*i)
	
	else
	gTempDate = gTempDate&dateadd("m",i,date)&";"
	gTempData3 = gTempData3&Cstr(tmp_low*i)&";"
	gTempData2 = gTempData2&Cstr(tmp_avg*i)&";"
	gTempData1 = gTempData1&Cstr(tmp_high*i)&";"
	
	end if
	
next
 
 gTempDate = replace(gTempDate,"-","")
' 
 'Form.MsgBox("",tmp_low&"/"&tmp_avg&"/"& tmp_high, "", "")
 
 'Form.MsgBox("",low_result&"/"&avg_result&"/"& high_result, "", "")
 
 'Form.MsgBox("",gTempDate, "", "")
 'Form.MsgBox("",gTempData1, "", "")
 'Form.MsgBox("",gTempData2, "", "")
 'Form.MsgBox("",gTempData3, "", "")
 
 
 
  ChartEx0.SetAccrueData("initdata="&gTempDate&"="&gTempDate)	
	 ChartEx0.SetAccrueData("자료일자="..gTempDate.."="..gTempDate)
	ChartEx0.SetAccrueData("data1="..gTempData1.."="..gTempData1)
	ChartEx0.SetAccrueData("data2="..gTempData2.."="..gTempData2)
	ChartEx0.SetAccrueData("data3="..gTempData3.."="..gTempData3)
	ChartEx0.SetShowCrossLine("true")
	ChartEx0.SetAccrueData("repaintall");


	
End Sub

'============================================================================
Sub Button0_OnClick()

	tmp_data = lwst_join_amt&"●"&cnrc_prd

	Form.OpenPopup("mbetc99000_s24" , tmp_data , "")
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

if sKeyName =="mbetc99000_s24" then

 gTempDate= ""
	gTempData1=""
	gTempData2=""
	gTempData3=""

g_szData = sRet
g_szList = Split(g_szData, "●")

lwst_join_amt = Cint(g_szList(0))
m_invt_amt = cint(g_szList(1))
cnrc_prd = Cint(g_szList(2))




invt_sum = lwst_join_amt/10000 + (m_invt_amt * cnrc_prd) '총 투자원금
 
 low_result = invt_sum + (invt_sum * low_rate/100 ) '최저수익률로 계산만 시뮬레이션 값 결과
 avg_result = invt_sum + (invt_sum * avg_rate/100 ) '평균수익률로 계산만 시뮬레이션 값 결과
 high_result = invt_sum + (invt_sum * high_rate/100 ) '최고수익률로 계산만 시뮬레이션 값 결과
 
 tmp_low = round(low_result / Cint(cnrc_prd),0)
 tmp_avg = round(avg_result / Cint(cnrc_prd),0)
 tmp_high = round(high_result / Cint(cnrc_prd),0)


for i = 0 to cnrc_prd
	
	if i == cnrc_prd then
	gTempDate = gTempDate&dateadd("m",i,date)
	gTempData3 = gTempData3&Cstr(tmp_low*i)
	gTempData2 = gTempData2&Cstr(tmp_avg*i)
	gTempData1 = gTempData1&Cstr(tmp_high*i)
	
	else
	gTempDate = gTempDate&dateadd("m",i,date)&";"
	gTempData3 = gTempData3&Cstr(tmp_low*i)&";"
	gTempData2 = gTempData2&Cstr(tmp_avg*i)&";"
	gTempData1 = gTempData1&Cstr(tmp_high*i)&";"
	
	end if
	
next
 
 gTempDate = replace(gTempDate,"-","")
' 
 'Form.MsgBox("",tmp_low&"/"&tmp_avg&"/"& tmp_high, "", "")
 
 'Form.MsgBox("",low_result&"/"&avg_result&"/"& high_result, "", "")
 
 'Form.MsgBox("",gTempDate, "", "")
 'Form.MsgBox("",gTempData1, "", "")
 'Form.MsgBox("",gTempData2, "", "")
 'Form.MsgBox("",gTempData3, "", "")
 
 
 
  ChartEx0.SetAccrueData("initdata="&gTempDate&"="&gTempDate)	
	 ChartEx0.SetAccrueData("자료일자="..gTempDate.."="..gTempDate)
	ChartEx0.SetAccrueData("data1="..gTempData1.."="..gTempData1)
	ChartEx0.SetAccrueData("data2="..gTempData2.."="..gTempData2)
	ChartEx0.SetAccrueData("data3="..gTempData3.."="..gTempData3)
	
	ChartEx0.SetAccrueData("repaintall");
	



end if



	
End Sub

