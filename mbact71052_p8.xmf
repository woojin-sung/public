'============================================================================
Sub cont0_grd2_OnClickUp(lRow, szCellID)
	'20221110 HSZ START : 계좌컨트롤에 잔고 계좌 세팅
	szAccString = cont0.grd2.GetCellData("bd_acc", lRow)
	szIdx = acc0.GetIndexByAccountinfo(szAccString)
	acc0.currentindex = szIdx
	'20221110 HSZ END
	'종목명, 매수/매도, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 미결제잔고, 매입단가, 종목구분명, 종목코드
	Dim szName, szPosition, szValPrc, szBuyPrc, szValProfit, szRate, szGubun, szUnQty, szBuyUnit, szCode, szPrc
	szName = cont0.grd2.GetCellData("bd_cell1", lRow)
	szPosition = cont0.grd2.GetCellData("bd_cell2", lRow)
	szValPrc = cont0.grd2.GetCellData("bd_cell5", lRow)
	szBuyPrc = cont0.grd2.GetCellData("bd_cell8", lRow)
	szValProfit = cont0.grd2.GetCellData("bd_cell6", lRow)
	szRate = cont0.grd2.GetCellData("bd_cell7", lRow)
	szGubun = cont0.grd2.GetCellData("bd_cell16", lRow) .. szPosition
	szUnQty = cont0.grd2.GetCellData("bd_cell3", lRow)
	szBuyUnit = cont0.grd2.GetCellData("bd_cell4", lRow)
	szCode = cont0.grd2.GetCellData("bd_cell10", lRow)
	
	szPrc = cont0.grd2.GetCellData("bd_cell12", lRow)
	
	Dim szSendData
	szSendData = "O" .. "☆" .. szName .. "☆" .. szPosition .. "☆" .. szValPrc .."☆" .. szBuyPrc .. "☆" .. szValProfit .. "☆" .. szRate .. "☆" .. szGubun .. "☆" .. szUnQty .. "☆" .. szBuyUnit .. "☆" .. szCode .. "☆" .. szPrc
	
'	Form.ShowAlert("11", szSendData)
	
	Form.OpenPopupAnimation("mbact71052_pe", szSendData , "" , "2")
End Sub

