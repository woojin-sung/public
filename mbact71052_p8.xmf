'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_선물옵션
' 02. 화면설명 : 고객자산평가_상품별잔고_선물옵션
' 03. 작    성 : 2016. 02. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCountA	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nNextCountB	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList

Dim g_szDate

Dim g_szSep

Dim g_nSelectRow
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )		
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "PROS_CLS" , 0 , "1" )		
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "ACNO" , 0 , Left(g_szList(g_nAllCount), 8) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_036r" )
	else
		lblVisible()
	end if

End Function
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "09")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
	cont0.grd1.SetClear()
	cont0.grd2.SetClear()
	
	if sEventName == "mbact71052_p8" then			'선물옵션
	
		g_szList = Split(sParam,"○")
	
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		
		g_nAcntCount = g_szList(0)		'계좌개수
		
		g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
		
		g_nNextCountA = 0
		g_nNextCountB = 0
		g_nNextCount = 0
		
		cont0.FormTab0.currenttab = 0
		cont0.grd1.visible = true
		cont0.grd2.visible = false
		
		VltnAmt_Request()
		
		if g_szList(1) == "Y" then
'			grd0.rowcount = 0
			AllSearch()
		else
			DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "IQRY_CLS_CODE" , 0 ,"2" )		
			DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "PROS_CLS" , 0 , "2" )		
			DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8)  )		'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )		'계좌번호
		'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
			DATAMANAGER.SetDataValue( 0 , "obacb_balc_036r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
			
			DATAMANAGER.RequestTranData( "obacb_balc_036r" )
		end if
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, TempCount
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_036r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_036r", "OutBlock1")-1
			
			
'			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNO" , i) &
'					DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ASNO" , i)	'계좌번호
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNO" , i)
			szTemp0 = Left(szTemp0, 4).."-"..Right(szTemp0, 4).."-"..DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNT_PRNM" , i)	'계좌번호(상품명)
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ABRV_ISNM" , i)					'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "PSTN_CLS_NAME" , i)				'포지션
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "RMND_QTY" , i)					'잔고수량
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "PSNT_PRC" , i)					'현재가
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "VLTN_AMT" , i)					'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "MKSC_BYNG_UNPR" , i)				'매수단가
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "VLTN_PRLS_AMT" , i)				'평가손익
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ERT" , i)						'수익률
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "MKSC_CLS_CODE" , i)				'잔고코드 1:선물 2:콜옵션 3: 풋옵션
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "PSTN_CLS_CODE" , i)				'포지션코드 2: 매수 1: 매도
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNT_PRNM" , i))
			szTemp11 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "BYNG_AMT" , i)					'매입금액
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ISCD" , i)						'종목코드
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "MKSC_CLS_NAME" , i)				'구분명
			
			if CInt(szTemp9) = 1 then	'선물
				cont0.grd1.AddRow()
				cont0.grd1.SetCellData("bd_acc", g_nNextCountA, DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNO" , i)..DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ASNO" , i))	'20221110 HSZ
				if g_szList(1) == "Y" then	'전체조회시
					cont0.grd1.SetCellData("bd_cell0", g_nNextCountA, szTemp0)
				end if
				cont0.grd1.SetCellData("bd_cell2", g_nNextCountA, szTemp2)
				cont0.grd1.SetCellData("bd_cell1", g_nNextCountA, "| "&szTemp1)
				cont0.grd1.SetCellData("bd_cell3", g_nNextCountA, szTemp3)
				cont0.grd1.SetCellData("bd_cell4", g_nNextCountA, szTemp6)
				cont0.grd1.SetCellData("bd_cell5", g_nNextCountA, szTemp5)
'				cont0.grd1.SetCellData("bd_cell11", g_nNextCountA, szTemp7)
				cont0.grd1.SetCellData("bd_cell8", g_nNextCountA, szTemp12)
				cont0.grd1.SetCellData("bd_cell9", g_nNextCountA, szTemp8)
				cont0.grd1.SetCellData("bd_cell10", g_nNextCountA, szTemp13)
				cont0.grd1.SetCellData("bd_cell16", g_nNextCountA, szTemp14)
				
				'20230925 현재가, 기준가 추가
				cont0.grd1.SetCellData("bd_cell12", g_nNextCountA, szTemp4)
				
				
				
				if CInt(szTemp10) = 2 then '매수
					cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCountA, "10")
				elseif CInt(szTemp10) = 1 then '매도
					cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCountA, "11")
				end if
				
				if CDbl(szTemp7) > 0 then
					cont0.grd1.SetCellData("bd_cell11", g_nNextCountA, "+"..FormatNumber(szTemp7, 0))
					cont0.grd1.SetCellFgColor("bd_cell11", g_nNextCountA, "10")
				elseif CDbl(szTemp7) < 0 then
					cont0.grd1.SetCellData("bd_cell11", g_nNextCountA, FormatNumber(szTemp7, 0))
					cont0.grd1.SetCellFgColor("bd_cell11", g_nNextCountA, "11")
				else
					cont0.grd1.SetCellData("bd_cell11", g_nNextCountA, FormatNumber(szTemp7, 0))
					cont0.grd1.SetCellFgColor("bd_cell11", g_nNextCountA, "4")
				end if	
				
				g_nNextCountA = g_nNextCountA + 1
			
			
			else	'옵션
				cont0.grd2.AddRow()
				cont0.grd2.SetCellData("bd_acc", g_nNextCountB, DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ACNO" , i)..DATAMANAGER.GetDataValue( 0 , "obacb_balc_036r", "OutBlock1", "ASNO" , i))	'20221110 HSZ
				if g_szList(1) == "Y" then	'전체조회시
					cont0.grd2.SetCellData("bd_cell0", g_nNextCountB, szTemp0)
				end if
				cont0.grd2.SetCellData("bd_cell2", g_nNextCountB, szTemp2)
				cont0.grd2.SetCellData("bd_cell1", g_nNextCountB, "| "&szTemp1)
				cont0.grd2.SetCellData("bd_cell3", g_nNextCountB, szTemp3)
				cont0.grd2.SetCellData("bd_cell4", g_nNextCountB, szTemp6)
				cont0.grd2.SetCellData("bd_cell5", g_nNextCountB, szTemp5)
'				cont0.grd2.SetCellData("bd_cell6", g_nNextCountB, szTemp7)
'				cont0.grd2.SetCellData("bd_cell7", g_nNextCountB, szTemp8)
				cont0.grd2.SetCellData("bd_cell8", g_nNextCountB, szTemp12)
				cont0.grd2.SetCellData("bd_cell10", g_nNextCountB, szTemp13)
				cont0.grd2.SetCellData("bd_cell16", g_nNextCountB, szTemp14)
				
				'20230925 현재가, 기준가 추가
				cont0.grd2.SetCellData("bd_cell12", g_nNextCountB, szTemp4)
				
				if CInt(szTemp10) = 2 then '매수
					cont0.grd2.SetCellFgColor("bd_cell2", g_nNextCountB, "10")
				elseif CInt(szTemp10) = 1 then '매도
					cont0.grd2.SetCellFgColor("bd_cell2", g_nNextCountB, "11")
				end if
				
				if CDbl(szTemp7) > 0 then
					cont0.grd2.SetCellData("bd_cell6", g_nNextCountB, "+"..FormatNumber(szTemp7, 0))
					cont0.grd2.SetCellData("bd_cell7", g_nNextCountB, "+"..FormatNumber(szTemp8, 2))
					cont0.grd2.SetCellFgColor("bd_cell6", g_nNextCountB, "10")
					cont0.grd2.SetCellFgColor("bd_cell7", g_nNextCountB, "10")
				elseif CDbl(szTemp7) < 0 then
					cont0.grd2.SetCellData("bd_cell6", g_nNextCountB, FormatNumber(szTemp7, 0))
					cont0.grd2.SetCellData("bd_cell7", g_nNextCountB, FormatNumber(szTemp8, 2))
					cont0.grd2.SetCellFgColor("bd_cell6", g_nNextCountB, "11")
					cont0.grd2.SetCellFgColor("bd_cell7", g_nNextCountB, "11")
				else
					cont0.grd2.SetCellData("bd_cell6", g_nNextCountB, FormatNumber(szTemp7, 0))
					cont0.grd2.SetCellData("bd_cell7", g_nNextCountB, FormatNumber(szTemp8, 2))
					cont0.grd2.SetCellFgColor("bd_cell6", g_nNextCountB, "4")
					cont0.grd2.SetCellFgColor("bd_cell7", g_nNextCountB, "4")
				end if	
				
				g_nNextCountB = g_nNextCountB + 1
				
			end if
		next
		
'		grd0.rowcount = g_nNextCount
		cont0.grd1.rowcount = g_nNextCountA
		cont0.grd2.rowcount = g_nNextCountB
		
		if  DATAMANAGER.IsMoreNextData( "obacb_balc_036r" ) == True then 
				DATAMANAGER.RequestNextData( "obacb_balc_036r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		if CDBL(nPrlsamt) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsamt) < 0 then
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "4")
		end if
	
	'계좌번호로 ID연결여부 조회
	elseif szTranID == "obcsb_efif_264r" then
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ID_LNKN_YN" , 0)
		
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		'종목명, 매수/매도, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 미결제잔고, 매입단가, 종목구분명, 종목코드
		Dim szName, szPosition, szValPrc, szBuyPrc, szValProfit, szRate, szGubun, szUnQty, szBuyUnit, szCode, szPrc
		szName = cont0.grd1.GetCellData("bd_cell1", g_nSelectRow)
		szPosition = cont0.grd1.GetCellData("bd_cell2", g_nSelectRow)
		szValPrc = cont0.grd1.GetCellData("bd_cell5", g_nSelectRow)
		szBuyPrc = cont0.grd1.GetCellData("bd_cell8", g_nSelectRow)
		szValProfit = cont0.grd1.GetCellData("bd_cell11", g_nSelectRow)
		szRate = cont0.grd1.GetCellData("bd_cell9", g_nSelectRow)
		szGubun = cont0.grd1.GetCellData("bd_cell16", g_nSelectRow) .. szPosition
		szUnQty = cont0.grd1.GetCellData("bd_cell3", g_nSelectRow)
		szBuyUnit = cont0.grd1.GetCellData("bd_cell4", g_nSelectRow)
		szCode = cont0.grd1.GetCellData("bd_cell10", g_nSelectRow)
		
		szPrc = cont0.grd1.GetCellData("bd_cell12", g_nSelectRow)
		
		Dim szSendData
		szSendData = "F" .. "☆" .. szName .. "☆" .. szPosition .. "☆" .. szValPrc .."☆" .. szBuyPrc .. "☆" .. szValProfit .. "☆" .. szRate .. "☆" .. szGubun .. "☆" .. szUnQty .. "☆" .. szBuyUnit .. "☆" .. szCode .. "☆" .. szPrc
		
	'	Form.ShowAlert("11", szSendData)
		
		Form.OpenPopupAnimation("mbact71052_pe", szSendData , "" , "2")
	end if
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	cont0.grd1.SetClear()
	cont0.grd2.SetClear()
	g_nNextCount = 0
	g_nNextCountA = 0
	g_nNextCountB = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_szSep = "☆"
	
	g_nAllCount = 0
	'hsz
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
	
	cont0.FormTab0.setTabHeaderImage("img_bgcircle_darkblue.9" , "img_bgcircle_lightgray.9" , 10) '활성화/비활성화/여백
	cont0.FormTab0.setTabHeaderFgColor("200" , "295") '활성화/비활성화 폰트색상
		
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page1", "page1", "empty", "0", "선물")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page2", "page2", "empty", "0", "옵션")
	cont0.FormTab0.currenttab = 0
	'hsz
End Sub

'============================================================================
Sub cont0_Imgicon_OnClick()
	cont0.Imgicon.openToolTip("계좌 총 평가금액 및 평가손익 기준 \n -옵션잔고만 평가되어 조회됩니다.\n(선물미포함)", 250, 70, 0)
End Sub

'============================================================================
Sub cont0_lblTitle_OnClick()
	cont0.Imgicon.openToolTip("계좌 총 평가금액 및 평가손익 기준 \n -옵션잔고만 평가되어 조회됩니다.\n(선물미포함)", 250, 70, 0)
End Sub

'============================================================================
Sub cont0_FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab = 0 then
		cont0.grd1.visible = true
		cont0.grd2.visible = false
	else
		cont0.grd1.visible = false
		cont0.grd2.visible = true
	end if
	lblVisible()
End Sub
'============================================================================
Function lblVisible()
	if CInt(cont0.FormTab0.currenttab) = 0 then
		if CInt(cont0.grd1.rowcount) = 0 then
			cont0.lblNone.visible = true
		else
			cont0.lblNone.visible = false
		end if
	else
		if CInt(cont0.grd2.rowcount) = 0 then
			cont0.lblNone.visible = true
		else
			cont0.lblNone.visible = false
		end if
	end if
End Function 

