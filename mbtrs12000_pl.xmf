Function f_AddQty(nAdd)
	Dim szQty
	szQty = edtQty.caption
	if szQty == "" then
		szQty = "0"
	end if
	
	edtQty.caption = CInt(szQty) + nAdd
	f_Cal_Order_Prc()
end function

function f_Cal_Order_Prc()
	Dim szQty
	szQty = edtQty.caption
	
	lblOrderPrice.caption = CInt(g_szPrc) * CInt(szQty)
end function
'수량 FOCUS 버튼 end===========================================================

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szNum
	
'	g_szFocusType'(단가=0수량=1금액=2)
	
	if g_szFocusType == "0" then
		g_bNowMkPrc = false
		szNum = g_szPrc
		btnPrc.enable = true
		btnPMinus.enable = true
		btnPPlus.enable = true
	elseif g_szFocusType == "1" then
		szNum = edtQty.caption
	elseif g_szFocusType == "2" then
		szNum = lblOrderPrice.caption
	end if	
	
	if nGbn == 1 then	'금액 10,100,500만
		g_bFirstClear = true'최초 클리어
		
		Dim nTemp
		nTemp = CDbl(szNum) + nPlus * 10000
		
		if Len(szNum) == 14 and Len(nTemp) > 14 then
			return
		end if
		
		if Trim(szNum) == "" then
			szNum = 0
		end if
		
		szNum = nTemp
	else
		if g_bFirstClear == false then
			g_bFirstClear = true'최초 클리어
			szNum = nPlus
		else
			if Len(szNum) > 13 then
				return
			end if
			szNum = szNum & nPlus
		end if
	end if
	
	if g_szFocusType == "0" then
		g_szPrc = szNum
		edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "1" then
		edtQty.caption = szNum
		f_Cal_Order_Prc()
	elseif g_szFocusType == "2" then
		lblOrderPrice.caption = szNum
		f_Calc_Prc_Qty()
	end if	
	
End Function

function f_Calc_Prc_Qty()
	Dim nNum,nPrc,nQty
	nNum = CInt(lblOrderPrice.caption)
	nPrc = CInt(g_szPrc)
	
	if nPrc <> 0 then
		edtQty.caption = CInt(nNum / nPrc)
	else
		edtQty.caption = 0
	end if
	
end function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szNum
	
	'	g_szFocusType'(단가=0수량=1금액=2)
	
	if g_szFocusType == "0" then
		if edtPrc.caption == "" then
			szNum = 0
		else
			szNum = CInt(g_szPrc)
		end if
	elseif g_szFocusType == "1" then
		if edtQty.caption == "" then
			szNum = 0
		else
			szNum = CInt(edtQty.caption)
		end if
	elseif g_szFocusType == "2" then
		if lblOrderPrice.caption == "" then
			szNum = 0
		else
			szNum = CInt(lblOrderPrice.caption)
		end if
	end if
	
	if g_bFirstClear == false then
		g_bFirstClear = true
		szNum = 0
	else
		if szNum <> 0 then
			if Len(szNum) < 14 or (Len(szNum) == 14 and szPlus == "0") then
				szNum = szNum & szPlus
			end if
		end if
	end if
	
	if g_szFocusType == "0" then
		g_bNowMkPrc = false
		g_szPrc = szNum
		edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "1" then
		edtQty.caption = szNum
		f_Cal_Order_Prc()
	elseif g_szFocusType == "2" then
		lblOrderPrice.caption = szNum
		f_Calc_Prc_Qty()
	end if	
End Function 
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if "ohhts_1001_005r" == szTranID then
		DATAMANAGER.SetDataAttr( false, szTranID , "OutBlock1" , "FID_MXPR" , 0 , "1" )
		DATAMANAGER.SetDataAttr( false, szTranID , "OutBlock1" , "FID_LLAM" , 0 , "1" )
	elseif "ohhts_1181_001r" == szTranID then
		DATAMANAGER.SetDataAttr( false, szTranID , "OutBlock1" , "FID_OVTM_UNTP_MXPR" , 0 , "1" )
		DATAMANAGER.SetDataAttr( false, szTranID , "OutBlock1" , "FID_OVTM_UNTP_LLAM" , 0 , "1" )
	end if
End Sub

