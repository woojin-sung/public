'	'20230629 htw end 시고저 for문 밖에서 삽입
'	
''	현재가 가운데로
'	grdPrc.toprow = iCurPRow-4
end function

'============================================================================
' grd_Price : 가격에 따른 호가단위 return
'============================================================================
Function grd_Price(szPrc)
	Dim szUnit, szHigh, szLow, szHyun, nResult
	
	g_szReceive = ""
'	szUnit = g_szUnit
	szHigh = tblHigh.GetCellString(0, 1)		'상한가
	szLow  = tblLow.GetCellString(0, 1)		'하한가
	szHyun = tblData.GetCellString(1, 0)

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szPrc) <> "" then
		if CDbl(szPrc) > 9900000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	'=======================================================================
	'20221116 HWG START : (거래소 차세대) 호가단위 개선
	'=======================================================================
	
	'=======================================================================
	' ETN/ELW
	'=======================================================================
	if g_szMk == "Q" or g_szMk == "W" then
		szUnit = 5
		
	'=======================================================================
	' ETN/ELW 외
	'=======================================================================
	else
		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		'=======================================================================
		' ETF
		'=======================================================================
		if szInnerMk = "013" then
			szUnit = 5
		
'		'=======================================================================
'		' KOTC
'		'=======================================================================
'		elseif szInnerMk = "025" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc)<  500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'			
'			if nGbn == 1 then
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 20000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 50
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 100
'				elseif CDbl(szPrc) = 100000 then
'					szUnit = 500
'				elseif CDbl(szPrc) = 500000 then
'					szUnit = 1000
'				end if
'			end if
		
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			if nGbn == 1 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
	end if
	'20221116 HWG END
	
	' 이전소스
'	'=======================================================================
'	' 20190403 LES START 호가단위 설정
'	'=======================================================================
'	if g_szMk == "J" or g_szMk == "T" then
'			
'		
'		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
'			
'		'-------------------------------------------------------------------
'		'코스닥, 코넥스
'		'-------------------------------------------------------------------
'		if szInnerMk == "002" or szInnerMk == "033" then
'			if CDbl(szPrc) <= 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) > 1000 and CDbl(szPrc) <= 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) > 5000 and CDbl(szPrc) <= 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) > 10000 and CDbl(szPrc) <= 50000) then
'				szUnit = 50
'			elseif CDbl(szPrc) > 50000 then
'				szUnit = 100
'			end if
'				
'		'-------------------------------------------------------------------
'		'ETF
'		'-------------------------------------------------------------------
'		elseif szInnerMk = "013" then
'			szUnit = 5
'						
'		
'		'-------------------------------------------------------------------
'		'코스피, 신주인수권, 수익증권, K-OTC
'		'-------------------------------------------------------------------
'		else
'					
'			if CDbl(szPrc) <=1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) > 1000 and CDbl(szPrc) <=5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) > 5000 and CDbl(szPrc) <=10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) > 10000 and CDbl(szPrc) <=50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) > 50000 and CDbl(szPrc) <=100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) > 100000 and CDbl(szPrc)<= 500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) > 500000 then
'				szUnit = 1000
'			end if
'					
'		end if
'	
'	'-------------------------------------------------------------------
'	'ETN, ELW
'	'-------------------------------------------------------------------
'	elseif g_szMk == "Q" or g_szMk == "W" then
'		szUnit = 5
'					
'	end if
'	'20190403 LES END
	return szUnit
End Function 

sub f_SetOrderPrice()
	Dim nPrc,nQty,nOrderPrice
	nPrc = 0
	nQty = 0
	nOrderPrice = 0
	
	if g_szPrc <> "" then
		nPrc = CInt(g_szPrc)
	end if
	
	if edtQty.caption <> "" then
		nQty = CInt(edtQty.caption)
	end if
	
	nOrderPrice = nPrc * nQty
	lblOrderPrice.caption = nOrderPrice
end sub 
