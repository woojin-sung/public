Sub contQty_btnAble_OnClick()
	f_SetFocus("1")'(단가=0수량=1금액=2)
	g_bFirstClear = true
	if g_szODER_ABLE_AMT == "" then
		g_szODER_ABLE_AMT = 0
	end if
	
	if g_szTab == "0" then
		'20230628 htw start 단가 0일 경우 수량 0으로 설정
		if g_szPrc == "" or CInt(g_szPrc) == 0 then
			edtQty.caption = "0"
		else
			edtQty.caption = CInt(CInt(g_szODER_ABLE_AMT) / CInt(g_szPrc))
		end if
		'20230628 htw start 단가 0일 경우 수량 0으로 설정
	elseif g_szTab == "1" then
		edtQty.caption = g_szODER_ABLE_AMT
	end if
	f_Cal_Order_Prc()
End Sub

