	<SCRIPT_INFO _len="51225" _ulen="47767" >
Dim g_szCd, g_szMk, g_szPrc, g_szQty, g_szTab, g_szODER_ABLE_AMT, g_szType, g_szInner
Dim g_szHigh,g_szLow
Dim g_szFocusType'(단가=0수량=1금액=2)
Dim g_szModGbn
Dim g_bNowMkPrc
g_bNowMkPrc = false'키패드에서 시장가 클릭했는지 판단
dim g_szFID_OPRC, g_szFID_HPRC, g_szFID_LPRC
'==============================================================
'키패드 clear 정리
'포커싱 변경 + 키패드(1~9,0,00) 클릭 시 클리어
'호가 클릭 > 키패드 클릭 시 클리어
'10주,100만 클릭 이후 키패드 클릭 시 클리어XXXX
'==============================================================
dim g_bFirstClear'키패드 첫 클릭 시 현재 포커싱 된 곳 초기화 후 키패드 삽입
g_bFirstClear = false
'============================================================================
Sub Form_OnFormInit()
	imgBg.imgpath       = "alpha128"
'	contHoga.HogaTable0.SetHogaRect("1")
'	contHoga.setScrollBarVisible("0")
	'20220211 HSZ START : 안드로이드 하한가 아이콘 표시 수정
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	if szDeviceOS = "1" then
		tblLow.SetCellString(0, 0, "4")
	end if
	
	grdPrc.SetUseScriptImageCell("1")	'20230718 SWJ START : IOS 그리드 반복그림 관련 버그 수정
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData( )
	
	if szOpenData <> "" then
'		0=종목코드
'		1=종목마켓
'		2=단가
'		3=수량
'		4=매수탭(0) or 매도탭(1) or 정정(2●1=매도 or 매수)
'		5=최대 매수 가능 금액 or 최대 매도 가능 수량
'		6=상한가
'		7=하한가
'		8=주문 타입
'		9=주문 타입명
'		10=단가or수량or금액(단가=0수량=1금액=2)
		Dim tData, szTradeType
		tData = Split(szOpenData, "★")
		g_szCd = tData(0)
		g_szMk = tData(1)
		g_szPrc = tData(2)
		g_szQty = tData(3)
		g_szTab = tData(4)
		
		if g_szTab == "2●" then
			g_szTab = "2"
			g_szModGbn = right(g_szTab,1)'1매도
		end if
		
		g_szODER_ABLE_AMT = tData(5)
		g_szType = tData(8)
		g_szHigh = tData(6)
		g_szLow = tData(7)
		g_szFocusType = tData(10)
		g_szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		f_SetFocus(g_szFocusType)
		
		'=====================20230601 htw start 장전시간외,장후시간외 유형일 경우 단가에 숫자 입력으로 변경
		if g_szMk == "W" then
'			"00`보통(지정가)\r\n01`보통(IOC)\r\n02`보통(FOK)"
			edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
		else
			if Trim(szInner) =="033" then		' 코넥스
'				"00`보통(지정가)\r\n01`시장가\r\n02`장후시간외"
				Select Case g_szType
					Case "01"	'시장가
						'매매유형 text
						if g_szTab == "0" then '매수
							g_szPrc = g_szHigh
		'					edtPrc.caption = "상한가"
						elseif g_szTab == "1" then '매도
							g_szPrc = g_szLow
		'					edtPrc.caption = "하한가"
						elseif g_szTab == "2" then '정정
							if g_szModGbn == "1" then'매도정정
								g_szPrc = g_szLow
		'						edtPrc.caption = "하한가"
							else
								g_szPrc = g_szHigh
		'						edtPrc.caption = "상한가"
							end if
						end if
						edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
						btnPrc.enable = false
						btnPMinus.enable = false
						btnPPlus.enable = false
					Case "02"	'시간외종가
						DATAMANAGER.RequestTranData( "ohhts_1181_002r")'장후시간외 단가 표기용
						btnPrc.enable = false
						btnPMinus.enable = false
						btnPPlus.enable = false
					Case else	'보통
						edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
				end select
			else
'				"00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외\r\n12`장후시간외\r\n13`시간외단일가"
				Select Case g_szType
					Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
						'매매유형 text
						if g_szTab == "0" then '매수
							g_szPrc = g_szHigh
		'					edtPrc.caption = "상한가"
						elseif g_szTab == "1" then '매도
							g_szPrc = g_szLow
		'					edtPrc.caption = "하한가"
						elseif g_szTab == "2" then '정정
							if g_szModGbn == "1" then'매도정정
								g_szPrc = g_szLow
		'						edtPrc.caption = "하한가"
							else
								g_szPrc = g_szHigh
		'						edtPrc.caption = "상한가"
							end if
						end if
						edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
						btnPrc.enable = false
						btnPMinus.enable = false
						btnPPlus.enable = false
					Case "11"										' 장개시전시간외(전일종가)
						DATAMANAGER.RequestTranData( "ohhts_1001_029r")'장전시간외 단가 표기용
						
						btnPrc.enable = false
						btnPMinus.enable = false
						btnPPlus.enable = false
					Case "12"										' 시간외종가(현재가)
						DATAMANAGER.RequestTranData( "ohhts_1181_002r")'장후시간외 단가 표기용
						
						btnPrc.enable = false
						btnPMinus.enable = false
						btnPPlus.enable = false
					case else
						edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
				End Select
			end if
		end if
		'=====================20230601 htw end 장전시간외,장후시간외 유형일 경우 단가에 숫자 입력으로 변경
		
		edtQty.caption = g_szQty
		
		f_SetOrderPrice()
		
		if g_szTab == 0 then
			szTradeType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif g_szTab == 1 then
			szTradeType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif g_szTab == 2 then
			szTradeType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif g_szTab == 3 then
			szTradeType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
'		if szTradeType == "13" then
		if g_szType == "13" then
			DATAMANAGER.RequestTranData("ohhts_1181_001r")		' 시간외단일가(호가)
		else
			DATAMANAGER.RequestTranData("ohhts_1001_005r")		' 현재가(호가&예상체결)
		end if
	end if
	
End Sub

function f_SetFocus(szFocusType)
	if szFocusType == "0" then'단가
		lblTitle.caption = "단가 입력"
		'상한가 하한가 시장가 버튼
		contPrc.visible = 		true
		contQty.visible = 		false
		contOrderPrice.visible = 	false
		
		btnPMinus0.visible = true
		btnPMinus.visible = false
		btnPPlus0.visible = true
		btnPPlus.visible = false
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
		
		edtPrc.imagefilepth = "input_07_o.9"
		edtQty.imagefilepth = "input_07_n.9"
		imgOrderPrc.imgpath = "input_06_n.9"
		
	elseif szFocusType == "1" then'수량
		lblTitle.caption = "수량 입력"
		'가능 10주 100주 1000주 버튼
		contPrc.visible = 		false
		contQty.visible = 		true
		contOrderPrice.visible = 	false
		
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = true
		btnQMinus.visible = false
		btnQPlus0.visible = true
		btnQPlus.visible = false
		
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_o.9"
		imgOrderPrc.imgpath = "input_06_n.9"

	elseif szFocusType == "2" then'금액
		lblTitle.caption = "금액 입력"
		'10만 100만 1000만 내잔고 버튼
		contPrc.visible = 		false
		contQty.visible = 		false
		contOrderPrice.visible = 	true
		
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
		
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_n.9"
		imgOrderPrc.imgpath = "input_06_o.9"
	end if
	
	'20230705 htw start 포커스가 달라질 경우 clear 플레그 초기화
	if g_szFocusType <> szFocusType then
		g_bFirstClear = false
	end if
	'20230705 htw end 포커스가 달라질 경우 clear 플레그 초기화
	
	g_szFocusType = szFocusType
	
end function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1181_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1181_001r")

		DATAMANAGER.SetDataValue(0,"ohhts_1181_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0,"ohhts_1181_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	elseif szTranID = "ohhts_1001_005r" then
			
		DATAMANAGER.ClearInputData(0, "ohhts_1001_005r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	elseif szTranID = "ohhts_1001_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1001_001r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	elseif szTranID = "ohhts_1181_002r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1181_002r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	elseif szTranID = "ohhts_1001_029r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1001_029r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1001_029r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_029r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID == "ohhts_ovtp_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	elseif szTranID == "ohhts_elw_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	elseif szTranID == "ohhts_stck_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	elseif szTranID == "ohhts_frbr_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		
	elseif szTranID == "ohhts_frbr_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	elseif szTranID == "ohhts_ovtp_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	elseif szTranID == "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg" , "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	elseif szTranID == "ohhts_stck_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	
	'20230912 SWJ START
	elseif szTranID == "ohhts_stck_incg" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	'20230912 SWJ END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_1001_005r" then
		g_szFID_OPRC = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_OPRC" , 0)
		g_szFID_HPRC = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_HPRC" , 0)
		g_szFID_LPRC = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_LPRC" , 0)
		Add_Prc()
		
		DATAMANAGER.RequestTranData("ohhts_1001_001r")		' 현재가(시세&상세내역)
		if g_szMk = "W" then		
'			DATAMANAGER.RequestRealData("ohhts_elw_aspr")
			DATAMANAGER.RequestRealData("ohhts_elw_cntg")
		elseif g_szMk = "T" then
'			DATAMANAGER.RequestRealData("ohhts_frbr_aspr")
			DATAMANAGER.RequestRealData("ohhts_frbr_cntg")
		else
'			DATAMANAGER.RequestRealData("ohhts_stck_aspr")
			
			'20230912 SWJ START
			'DATAMANAGER.RequestRealData("ohhts_stck_cntg")
			DATAMANAGER.RequestRealData("ohhts_stck_incg")
			'20230912 SWJ END
		end if
		
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(호가)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_1181_001r" then	
		g_szFID_OPRC = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_OVTM_UNTP_OPRC" , 0)
		g_szFID_HPRC = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_OVTM_UNTP_HPRC" , 0)
		g_szFID_LPRC = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_OVTM_UNTP_LPRC" , 0)
		
		Add_Prc()
		
		if g_szMk = "W" then		
			'DATAMANAGER.RequestRealData("")
		else
'			DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")
			DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")
		end if
		
	elseif szTranID = "ohhts_1181_002r" then'금일종가 표기
		g_szPrc = CInt(DATAMANAGER.GetDataValue( 0, "ohhts_1181_002r", "OutBlock1", "FID_OVTM_UNTP_OPRC" , 0 ))
		edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
	elseif szTranID = "ohhts_1001_029r" then
		g_szPrc = CInt(DATAMANAGER.GetDataValue( 0, "ohhts_1001_029r", "OutBlock1", "FID_PRDY_CLPR" , 0 ))
		edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
	end if
End Sub

Function Add_Prc()
	'전체 호가 그리드
	szSdpr = tblData0.GetCellString(1, 0)	'기준가
	szHyun = tblData0.GetCellString(1, 1)	'현재가
	szMaedo = tblData.GetCellString(1, 0)	'매도1호가
	szMaesu = tblData.GetCellString(3, 0)	'매수1차호가
	szMxpr = tblHigh.GetCellString(0, 1)		'상한가
	szLlam = tblLow.GetCellString(0, 1)		'하한가

	if szSdpr = null or szSdpr = "" then
		szSdpr = "0"
	end if
	
	if szHyun = null or szHyun = "" then
		szHyun = "0"
	end if
	
	if szMaedo = null or szMaedo = "" then
		szMaedo = "0"
	end if
	
	if szMaesu = null or szMaesu = "" then
		szMaesu = "0"
	end if
	
	if szMxpr = null or szMxpr = "" then
		szMxpr = "0"
	end if
	
	if szLlam = null or szLlam = "" then
		szLlam = "0"
	end if

	'상하한가 같을 경우 예외처리
	if szMxpr == szLlam then
		exit function 
	end if
	
	lBasP	= CLng(szSdpr)
	lCurP	= CLng(szHyun)
	lSellP	= CLng(szMaedo)
	lBuyP	= CLng(szMaesu)
	lMax		= CLng(szMxpr)
	lMin		= CLng(szLlam)
	
	iCurPRow = 0
	i = 0 		 			'가격개수 저장
	
	szStep = grd_Price(lMax)
	szPrc = lMax - szStep 	'시작가격
	
	Dim szOPenIdx, szHighIdx, szLowIdx
	'=======20230629 htw start 호가 메인에서 그려주는 것으로 변경
	Dim szMk
	if g_szInner == "012" or g_szInner == "013" or g_szInner == "014" then'ELW/ETF/ETN
		szMk = "2"
	else'코스피/코스닥/코넥스 등등
		szMk = "1"
	end if
	grdPrc.setOrderPriceList(szMk,szMxpr,szLlam,szSdpr,szHyun,"bd_prc","bd_debi")'마켓구분/고/저/기준/현재가/가격영역cellID/비율영역

