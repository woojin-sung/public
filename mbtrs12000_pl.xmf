Sub contPrc_btnPrcMk_OnClick()
	f_SetFocus("0")'(단가=0수량=1금액=2)
	'매매유형 text
	g_bFirstClear = true
	if g_szTab == "0" then '매수
		g_szPrc = g_szHigh
	elseif g_szTab == "1" then '매도
		g_szPrc = g_szLow
	elseif g_szTab == "2" then '정정
		if g_szModGbn == "1" then'매도정정
			g_szPrc = g_szLow
		else
			g_szPrc = g_szHigh
		end if
	end if
	g_bNowMkPrc = true'키패드에서 시장가 클릭했는지 판단
	
	edtPrc.caption = "시장가"
	edtPrc_OnEditComplete()
'	btnPrc.enable = false
'	btnPMinus.enable = false
'	btnPPlus.enable = false
End Sub
'단가 FOCUS 버튼 end===========================================================

