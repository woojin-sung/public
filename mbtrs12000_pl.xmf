Sub btnOk_OnClick()
	Dim szData
	
	if g_bNowMkPrc == true then'시장가 클릭한 상태로 나가면 1, 아니면 0
		szData = g_szPrc .."★".. edtQty.caption.."★1".."★"..g_szMk.."★"..g_szInner.."★"..g_szType
	else
		szData = g_szPrc .."★".. edtQty.caption.."★0".."★"..g_szMk.."★"..g_szInner.."★"..g_szType
	end if
	Form.SendReturnToParent("mbtrs12000_pl", szData)
	Form.CloseForm()
End Sub

