Sub btnClear_OnClick()
	if g_bFirstClear == false then
		g_bFirstClear = true
	end if
	
	if g_szFocusType == "0" then'(단가=0수량=1금액=2)
		g_bNowMkPrc = false
		g_szPrc = "0"
		edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "1" then
		edtQty.caption = "0"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "2" then
		lblOrderPrice.caption = "0"
		f_Calc_Prc_Qty()
	end if
End Sub

'============================================================================
Sub btnBack_OnClick()
	Dim szNum
	if g_bFirstClear == false then
		g_bFirstClear = true
		szNum = 0
	else
		if g_szFocusType == "0" then
			szNum = g_szPrc
		elseif g_szFocusType == "1" then
			szNum = edtQty.caption
		elseif g_szFocusType == "2" then
			szNum = lblOrderPrice.caption
		end if	
	
		Dim nLen
		nLen = Len(szNum)
		
		szNum = left(szNum ,nLen - 1)
	end if
	
	if g_szFocusType == "0" then
		g_szPrc = szNum
		edtPrc.caption = FormatNumber(g_szPrc,0).." 원"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "1" then
		edtQty.caption = szNum
		f_Cal_Order_Prc()
	elseif g_szFocusType == "2" then
		lblOrderPrice.caption = szNum
		f_Calc_Prc_Qty()
	end if	
	
End Sub
