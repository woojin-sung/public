Sub tblHigh_OnClick(lRow , lColumn)
	if lRow == 0 then
		Select Case g_szType
			Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
			
			Case Else
				Dim nHPrc
				nHPrc = tblHigh.GetCellString(lRow , lColumn)
				edtPrc.caption = FormatNumber(nHPrc,0).." 원"
				g_szPrc = nHPrc
				f_SetFocus("0")'(단가=0수량=1금액=2)
				g_bFirstClear = false
				edtPrc_OnEditComplete()
		end Select
	end if
End Sub

