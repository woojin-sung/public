'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	dim szFID_OPRC, szFID_HPRC, szFID_LPRC
	
	if szTranID == "ohhts_stck_cntg" then
		szFID_OPRC = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1", "RLTM_OPRC" , 0)
		szFID_HPRC = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1", "RLTM_HPRC" , 0)
		szFID_LPRC = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1", "RLTM_LPRC" , 0)
	elseif szTranID == "ohhts_ovtp_cntg" or szTranID == "ohhts_frbr_cntg" or szTranID == "ohhts_elw_cntg" then	
		'10호가창 중간위치
		szFID_OPRC = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1", "FIDR_OPRC" , 0)
		szFID_HPRC = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1", "FIDR_HPRC" , 0)
		szFID_LPRC = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1", "FIDR_LPRC" , 0)
	end if
End Sub

'============================================================================
Sub grdPrc_OnClickUp(lRow, szCellID)
	
	Select Case g_szType
		Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
		
		Case Else
			nPrc = grdPrc.GetCellData("bd_prc", lRow)
			edtPrc.caption = FormatNumber(nPrc,0).." 원"
			g_szPrc = nPrc
			f_SetFocus("0")'(단가=0수량=1금액=2)
			g_bFirstClear = false
			edtPrc_OnEditComplete()
	end Select
End Sub

'============================================================================
' 20230705_01 HWG : 호가그리드 후처리는 SetOrderPriceList 완료 이벤트에서 치리하도록 변경
'============================================================================
Sub grdPrc_OnOrderPriceListEnd()
	for i = 0 to grdPrc.rowcount - 1
		grdPrc.SetCellFgColor("bd_debi", i, "69")
		szPrc = CInt(grdPrc.GetCellData("bd_prc", i))
		
'		if szPrc >= CInt(szSdpr) then	'배경 파랑
'			grdPrc.SetCellBgColor("bd_prc",i, "349")
'			grdPrc.SetCellBgColor("bd_debi",i, "349")
'			grdPrc.SetCellBgColor("bd_cell2",i, "349")
'			grdPrc.SetCellBgColor("bd_cell1",i, "349")
'			grdPrc.SetCellBgColor("bd_cell0",i, "349")
'			grdPrc.SetCellBgColor("bd_cell3",i, "349")
'		else				'배경 빨간
'			grdPrc.SetCellBgColor("bd_prc",i, "348")
'			grdPrc.SetCellBgColor("bd_debi",i, "348")
'			grdPrc.SetCellBgColor("bd_cell2",i, "348")
'			grdPrc.SetCellBgColor("bd_cell1",i, "348")
'			grdPrc.SetCellBgColor("bd_cell0",i, "348")
'			grdPrc.SetCellBgColor("bd_cell3",i, "348")
'		end if
		
		if CInt(g_szFID_OPRC) == CInt(szPrc) then'시가
			szOPenIdx = i		
		end if
		
		if CInt(g_szFID_LPRC) == CInt(szPrc) then'저가
			szLowIdx = i
		end if
		
		if CInt(g_szFID_HPRC) == CInt(szPrc) then'고가
			szHighIdx = i
		end if
		
		'현재가 행
		if szPrc = lCurP then
			iCurPRow = i
		end if
	next
	'		'장전의 경우 시고저가 모두 동일하게 들어와서 고가만 표시
	
	'=======20230629 htw end 호가 메인에서 그려주는 것으로 변경
	
	'20230718 SWJ START : null 체크 추가
	if Trim(szOPenIdx) <> "" then
		'시가
		grdPrc.SetCellImage("bd_cell0", szOPenIdx, "hoga_marking01")
		grdPrc.SetMaintainingRatio("bd_cell0", CInt(szOPenIdx), "1")
	end if
	
	if Trim(szLowIdx) <> "" then
		'저가
		grdPrc.SetCellImage("bd_cell0", szLowIdx, "hoga_marking03")
		grdPrc.SetMaintainingRatio("bd_cell0", CInt(szLowIdx), "1")
	end if
	
	if Trim(szHighIdx) <> "" then
		'고가
		grdPrc.SetCellImage("bd_cell0", szHighIdx, "hoga_marking02")
		grdPrc.SetMaintainingRatio("bd_cell0", CInt(szHighIdx), "1")
	end if 
	'20230629 htw end 시고저 for문 밖에서 삽입
	'20230718 SWJ END
	
'	현재가 가운데로
	grdPrc.toprow = iCurPRow-4
End Sub

