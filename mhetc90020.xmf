'============================================================================
' 2021.07.05 : 정민영 : obcsb_efif_005r IO 재매핑
' 2023.10.23 : 양현정 : v001 obcpp_logn_022a, obcpp_logn_006a, obcpp_spin_022a, obcpp_pcrt_166a IO 재매핑
'============================================================================

Dim g_sID
Dim g_sPass
Dim g_sCertPass
Dim g_sSiseCheck
Dim g_sRCNO
Dim g_sRCNO_PIP 'v001
Dim g_sUserName
Dim g_sCSNO
Dim g_sDplcPrms
Dim g_sDN
Dim g_sCertLogin

Dim g_nCertPswdLimitCnt '20160425 KBC
Dim g_SSTM_Date '20160905_01 KBC : CDD이행주기 안내팝업

'로그인 사이즈 375 X 647

'20160803_01 KBC : 간편인증로그인 도입 (변경범위 많아서 모든 라인별 주석처리 하지 않음)

'============================================================================
Sub Form_OnFormInit()
	ContainerID.edtPass.certname = "ID 비밀번호 입력"
	ContainerID.edtCertPass.certname = "공인인증 비밀번호 입력"
	
	sId = ""
	g_sID = ""
	g_sPass = ""
	g_sCertPass = ""
	g_sCertLogin = "0"
	g_SSTM_Date = "00000000" '20160905_01 KBC : CDD이행주기 안내팝업
	g_nCertPswdLimitCnt = 7 '20160425 KBC
	
	sVersion = Form.GetSharedData( "&APP_VERSION", 0  )
	Label1.caption = "Ver " & sVersion
	
	bSaveId = Form.GetEnvData( "login.input.saveid")
	sSaveTab = Form.GetEnvData( "login.input.savetab")
	
	'------------------------------------------------------------------
	'ID, ID저장체크박스 
	if bSaveId <> null and bSaveId <> "" then
		if bSaveId == "1" then
			Form.SetCtlProp( "ContainerID.chkSaveID", "checkstate",bSaveId)
			Form.SetCtlProp( "ContainerSpin.chkSaveID", "checkstate",bSaveId)
			
			sId = Form.GetEnvData( "login.input.userid")
			
			if sId <> null and sId <> "" then
				Form.SetCtlProp( "ContainerID.edtID", "caption",sId)
				Form.SetCtlProp( "ContainerSpin.edtID", "caption",sId)
			else
				Form.SetCtlProp( "ContainerID.edtID", "caption","")
				Form.SetCtlProp( "ContainerSpin.edtID", "caption","")
			end if	
		
		elseif bSaveId == "0" then
			Form.SetCtlProp( "ContainerID.chkSaveID", "checkstate",bSaveId)
			Form.SetCtlProp( "ContainerSpin.chkSaveID", "checkstate",bSaveId)
		end if
	
		g_sSiseCheck = Form.GetEnvData("login.input.siseonly")
		Form.SetCtlProp( "ContainerID.chkSise", "checkstate",g_sSiseCheck)
		
		if g_sSiseCheck == "1" then	
			ContainerID.edtCertPass.enable = false
		else
			ContainerID.edtCertPass.enable = true		
		end if
		
	end if
	
	'------------------------------------------------------------------
'20161101_01 KBC : 주석처리	
'	sOpenData = Form.GetOpenLinkData()
'
'	if sOpenData == "2" then
'		'공인인증로그인도 가능 (이체)
'		Form.SetCtlProp( "ContainerID.edtCertPass", "enable", "1")
'		Form.SetCtlProp( "ContainerID.chkSise", "checkstate", "0")
'		Form.SetCtlProp( "ContainerID.chkSise", "enable","0")
'		sSaveTab = "1"
'	elseif sOpenData == "3" then
'	     'ID+공인인증로그인만 가능 (주문)
'		Form.SetCtlProp( "ContainerID.edtCertPass", "enable", "1")
'		Form.SetCtlProp( "ContainerID.chkSise", "checkstate", "0")
'		Form.SetCtlProp( "ContainerID.chkSise", "enable","0")
'		Form.SetCtlProp( "ContainerID.Button0", "enable","0")
'		sSaveTab = "2"
'	end if
	
	'------------------------------------------------------------------
	
	if sSaveTab == "0" then
		'간편인증
		Tab0.currenttab = 0
		Tab0_OnTabChanged(0)
	elseif sSaveTab == "1" then
		'공인인증
		Tab0.currenttab = 1
		Tab0_OnTabChanged(1)
	elseif sSaveTab == "2" then
		'ID인증
		Tab0.currenttab = 2
		Tab0_OnTabChanged(2)
	else
		'ID인증 (기본값)
		Tab0.currenttab = 2
		Tab0_OnTabChanged(2)
	end if

End Sub
'============================================================================
Sub ContainerID_chkSaveID_OnChange(sCheckState)
	Form.SetEnvData(1, "login.input.saveid",sCheckState)
	Form.SetCtlProp( "ContainerSpin.chkSaveID", "checkstate",sCheckState)
End Sub

'============================================================================
Sub ContainerID_chkSise_OnChange(sCheckState)
	g_sSiseCheck = sCheckState
	Form.SetEnvData(1, "login.input.siseonly",sCheckState)
	
	if g_sSiseCheck == "1" then	
		ContainerID.edtCertPass.enable = false
	else
		ContainerID.edtCertPass.enable = true		
	end if
	
End Sub

'============================================================================
Sub ContainerID_btnLogin_OnClick()
	g_sID = Form.GetCtlProp( "ContainerID.edtID", "caption")
	
	if g_sID == null or g_sID == "" then
		Form.MsgBox( "알림", "사용자 ID를 입력하세요.", "", 0 )
		return
	end if	
	
	g_sPass = Form.GetCtlProp( "ContainerID.edtPass", "caption")
	
	if g_sPass == null or g_sPass == "" then
		Form.MsgBox( "알림", "사용자 ID 비밀번호를 입력하세요.", "", 0 )
		return
	end if	

	g_sSiseCheck =  Form.GetCtlProp( "ContainerID.chkSise", "checkstate") 
	
	if g_sSiseCheck == "0" then
		g_sCertPass = Form.GetCtlProp( "ContainerID.edtCertPass", "caption")
		
		if g_sCertPass == null or g_sCertPass == "" then
			Form.MsgBox( "알림", "공인인증 비밀번호를 입력하세요.", "", 0 )
			return
		end if	
	end if		
	
	'사용자 ID
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_022a", "InBlock1", "USER_ID", 0 , g_sID ) 
	
	'비밀번호
	sEncPass = Form.GetEncData( g_sPass)
	
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_022a", "InBlock1", "CONN_PWD", 0, sEncPass)
	
	'시세전용로그인 여부
	if g_sSiseCheck == "0" then
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_022a", "InBlock1", "QTTN_EXUS_LOGN_YN", 0, "N" )
	else	
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_022a", "InBlock1", "QTTN_EXUS_LOGN_YN", 0, "Y" )
	end if
	
	'단말식별키
	sDeviceID = Form.GetDeviceID()
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_022a", "InBlock1", "TERM_IDNT_KEY" , 0, sDeviceID)
	
	'로그인 TR
	DATAMANAGER.RequestTranData("obcpp_logn_022a")	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'로그인 TR
	if szTranID == "obcpp_logn_022a" then	
		
		g_sCertLogin = "0"
		Form.SetSharedData("&CERT_USE_TYPE" , "0") '0.일반인증서 1.간편인증인증서 2.KOSCOM지문인식용인증서
		
		sMsg = DATAMANAGER.GetDataMsgText("obcpp_logn_022a")
		
		'20160808 NOHES START submessage  가져오기
		sSubMsg = DATAMANAGER.GetDataMsgSubText("obcpp_logn_022a")
		'20160808 NOHES END
	
		'접속허용구분 코드
		sClscode = DATAMANAGER.GetDataValue( 0,"obcpp_logn_022a", "OutBlock1", "CONN_PRMS_CLS_CODE" ,0)

'테스트입력
'sSubMsg = "1-2시"
'sClscode = "A"

		Select Case  sClscode
			Case  "0" '접속허용(정상로그인)
				Form.SetEnvData( 1,"login.input.userid",g_sID)
			Case  "1" '등록되지 않은 ID
				Form.ShowAlert( "알림", "등록되지 않은 ID입니다. ID를 확인하시기 바랍니다." )
				exit sub
			Case  "2" '접속비밀번호 오류
				sPassErrCnt = DATAMANAGER.GetDataValue( 0,"obcpp_logn_022a", "OutBlock1", "PWD_ERR_TMNU" ,0)
				sPassAbleErrCnt = DATAMANAGER.GetDataValue( 0,"obcpp_logn_022a", "OutBlock1", "PWD_MSTK_ABLE_TMNU" ,0)
				
				Form.ShowAlert("알림", "ID비밀번호 " & CInt( sPassErrCnt ) & "회 오류입니다.\n연속 " & CInt( sPassAbleErrCnt ) & "회 오류 시 접속이 제한됩니다.\n\nID비밀번호를 모르시는 경우에는 내방하시거나 \n홈페이지(ID 비밀번호 재설정)에서 변경할 수 있습니다.")
				exit sub
			Case  "3" '접속비밀번호 오류 초과
				Form.ShowAlert("알림", "ID비밀번호 5회 오류입니다.\n\nID비밀번호를 5회 연속 잘못 입력하여 접속이 불가능하오니\n내방하시거나 홈페이지(ID 비밀번호 재설정)에서 재설정하시기\n바랍니다.")
				exit sub
			Case  "5" '비밀번호를 입력 하지 않았을경우
				Form.ShowAlert( "알림","비밀번호를 입력하세요." )
				exit sub
			Case  "8" '미등록 단말
				Form.ShowAlert( "알림" ,"[" & sClscode &  "]" &  sMsg)
				exit sub
			Case  "A" '20160808 NOHES START 부메세지에 시간이 들어있음	/ 시세조회 전용으로 로그인
				Form.MsgBox("알림", "시스템 점검시간 " & sSubMsg & "동안은 \n시세조회 전용으로 로그인 됩니다.\n계좌정보 조회 및 이체서비스는\n시스템 점검시간 이후 재접속하셔야만\n이용 가능합니다.", "CheckSystem", 0)
				exit sub
				'20160808 NOHES END		
			Case else ' 알 수 없는 오류
				Form.ShowAlert( "알림", "[" & sClscode &  "]" & sMsg)
				exit sub
		End Select	
		
		'비밀번호 초기화시에는 체크 않함
		sPassInit = DATAMANAGER.GetDataValue( 0,"obcpp_logn_022a", "OutBlock1", "CONN_PWD_INIT_YN" ,0)
		if sPassInit == "N" then
			sWarnCode = DATAMANAGER.GetDataValue(0,"obcpp_logn_022a", "OutBlock1", "CONN_WARN_CLS_CODE" ,0)
			if sWarnCode == "1" then
