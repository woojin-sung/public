			Form.MsgBox( "알림", "간편인증서비스 신청을 위해서 \n최초 1회 ID+공인인증 로그인이 필요합니다.", "", 0 )
		else
			Form.OpenScreen("86030" , "")
		end if
	else
		Form.CloseForm()
		Form.OpenScreen("86030" , "")
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
		
	Call Form_OnTriggerEventSpin(sEventName, sParam)

End Sub

'============================================================================
' 간편인증 응답용 TriggerEventSpin
'============================================================================
Sub Form_OnTriggerEventSpin(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	
	sErrorCode = ""
	sErrorMsg = ""
	
	if #sRet > 1 then
		sErrorCode = sRet[0]
		sErrorMsg = sRet[1]	
	else
		exit sub
	end if
	
	if sEventName == "reqCheckJoin" then
		
		'처리순서 : 가입상태체크 -> 간편인증로그인(*) -> 기간계로그인(obcpp_spin_022a)
		
		'간편인증로그인
		'[요청타입]`[고객ID]`[인증서시리얼번호] <- 로그인의 경우 시리얼번호 공백처리
		'요청타입 => 2.로그인 3.이체 4.비밀번호변경 5.해지

		'메리츠 미사용 코드
		'	3000.정상 사용자 입니다.
		
		'메리츠 사용 코드
		'	3001.이미 가입된 사용자 입니다.
		'	3002.가입된 이력이 확인되지 않습니다. 가입해 주시기 바랍니다.
		'	3003.설정한앱을 삭제한 이력이 있거나, 등록시 사용했던 기기와 상이합니다. 재가입이 필요합니다.
		'	3004.가입 대기중인 사용자 입니다.
		'	3005.가입이 해지된 사용자 입니다.
		'	3006.가입 된 이력이 확인되지 않습니다.
		'	3007.인증서 정보가 확인되지 않습니다. 재가입이 필요합니다.
		'	3008.5회 이상 비밀번호 오류가 발생하였습니다. 재가입이 필요합니다.
		'	3009.중복된 사용자  id 입니다.
		'	3010.미사용 처리 된 사용자 아이디

		if sErrorCode == "3000" then
			sParam = "2" & "★" & g_sID & "★" & ""
			Form.requestOneShotPad("reqPush", sParam, "")
		else 
			ContainerSpin.btnLogin.enable = "1"
			
			'기간계로그인(log)
			Request_obcpp_spin_022a("N", sErrorMsg) '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
				
			Form.MsgBox( "알림", "[" & sErrorCode & "] " & sErrorMsg, "", 0 )
		end if
	
	elseif sEventName == "reqAuthPinPad" then
	
		'간편인증 비밀번호 맞거나 틀리거나 모두 진입
		ContainerSpin.btnLogin.enable = "1"
		
		if sErrorCode == "0000" then '성공
			'no action (reqLogin 응답이 내려옴)
		else
			if sErrorCode == "2004" or sErrorCode == "2005" then
				if #sRet > 2 then
					sPassFailCnt = sRet[2]
					
					if LEN(sPassFailCnt) > 0 then
						if CInt(sPassFailCnt) >= 5 then
							'5회오류 시 SMS전송요청
							DATAMANAGER.SetDataValue(0, "obcsb_spin_001a", "InBlock1", "INPUT_CLS", 0, "3")		'5회오류
							DATAMANAGER.SetDataValue(0, "obcsb_spin_001a", "InBlock1", "ELFN_ID", 0, g_sID)
							DATAMANAGER.RequestTranData("obcsb_spin_001a")
						end if
					end if					
					
					sErrorMsg = "간편인증 비밀번호 " & sPassFailCnt & "회 오류입니다.\n\n" &
					            "연속 5회 오류 시 간편인증으로 접속이 제한됩니다."
				else
					sErrorMsg = "간편인증 비밀번호 오류입니다."
				end if
			end if
			
			'기간계로그인(log)
			Request_obcpp_spin_022a("N", sErrorMsg) '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
			
			Form.MsgBox( "알림", "[" & sErrorCode & "] " & sErrorMsg, "", 0 )
		end if

	elseif sEventName == "reqLogin" then

		'처리순서 : 가입상태체크 -> 간편인증로그인 -> 기간계로그인(*)
		
		if sErrorCode == "0000" then
		
			'20161101_01 KBC START : 인증서 특수기호 ">"종료글자 오류회피
			sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1 )
			sCertDn = Form.GetSharedData("CERT_IMSI_DN", 1 )
			
			if sCertPass <> null and sCertPass <> "" and 
			   sCertDn   <> null and sCertDn   <> "" then
			   
				g_sCertPass = sCertPass
				g_sDN = sCertDn
				
				Form.SetCertDNPW(g_sDN, g_sCertPass) '필수
				
				'기간계로그인(log)
				Request_obcpp_spin_022a("Y", "") '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
			
			else
				if #sRet > 3 then
					g_sCertPass = sRet[2] '간편인증서용 비밀번호
					g_sDN = sRet[3] '간편인증서용 DN값
					
					Form.SetCertDNPW(g_sDN, g_sCertPass) '필수
					
					'기간계로그인(log)
					Request_obcpp_spin_022a("Y", "") '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
				end if
			end if
			
			'이전소스
'			if #sRet > 3 then
'				g_sCertPass = sRet[2] '간편인증서용 비밀번호
'				g_sDN = sRet[3] '간편인증서용 DN값
'				
'				Form.SetCertDNPW(g_sDN, g_sCertPass) '필수
'				
'				'기간계로그인(log)
'				Request_obcpp_spin_022a("Y", "") '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
'			end if			
			'20161101_01 KBC END 
			

			
			
			
		elseif sErrorCode == "-1" then
			
			' 20161026_01 KBC : 긴급조치
			' 아이폰의 경우 -> 인증서 재발급 시, 간편인증용 복사된 인증서는 영향이 없어야 하는데
			' 삭제되는 문제가 있음. 이때 reqLogin시 -1로 에러 떨어지고 메시지는 성공으로 내려옴
			' 일단 아래와 같이 메시지 처리 다시 함
			
			ContainerSpin.btnLogin.enable = "1"
			
			'기간계로그인(log)
			Request_obcpp_spin_022a("N", sErrorMsg) '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
			
			sErrorMsg = "간편인증서비스 신청 시 사용한 인증서는 더이상 사용하실 수 없습니다.\n\n" &
			            "유효한 인증서로 로그인(ID+공인인증)하신 후 간편인증서비스를 재설정 해주시기 바랍니다."
			
			Form.MsgBox( "알림", "[" & sErrorCode & "] " & sErrorMsg, "", 0 )
			
		else
			ContainerSpin.btnLogin.enable = "1" '20161026_01 KBC
			Form.MsgBox( "알림", "[" & sErrorCode & "] " & sErrorMsg, "", 0 )
		end if
		
		
	elseif sEventName == "reqPush" then
		
		if sErrorCode == "0000" then '성공
			'no action
		else
			'기간계로그인(log)
			Request_obcpp_spin_022a("N", sErrorMsg) '20161101_02 KBC : 전문변경대응 (obcpp_spin_022a)
			
			Form.MsgBox( "알림", "[" & sErrorCode & "] " & sErrorMsg, "", 0 )
		end if
		
	elseif sEventName == "pinpadNoInput" then
		'간편인증 비밀번호 입력하지 않고 그냥 닫은 경우
		ContainerSpin.btnLogin.enable = "1"
	else
		
		Form.MsgBox( "알림", "[" & sErrorCode & "] " & sErrorMsg, "", 0 )
	end if
	
	
End Sub


'============================================================================
Sub Request_obcpp_spin_022a(sSuccessYn, sMessage)
	if g_sID == null or g_sID == "" then
		Form.MsgBox( "알림", "사용자 ID를 입력하세요.", "", 0 )
		return
	end if	
	
	'사용자 ID
	DATAMANAGER.SetDataValue( 0, "obcpp_spin_022a", "InBlock1", "USER_ID", 0 , g_sID ) 

	'단말식별키
	sDeviceID = Form.GetDeviceID()
	DATAMANAGER.SetDataValue( 0, "obcpp_spin_022a", "InBlock1", "TERM_IDNT_KEY" , 0, sDeviceID)
	
	'20161101_02 KBC START : 전문변경대응 (obcpp_spin_022a)
	DATAMANAGER.SetDataValue( 0, "obcpp_spin_022a", "InBlock1", "CONN_SUCS_YN" , 0, sSuccessYn)
	DATAMANAGER.SetDataValue( 0, "obcpp_spin_022a", "InBlock1", "CONN_DTL_CNTT" , 0, sMessage)
	'20161101_02 KBC END

	'로그인 TR
	DATAMANAGER.RequestTranData("obcpp_spin_022a")	
End Sub

