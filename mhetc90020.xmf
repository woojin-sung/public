		g_sCSNO = DATAMANAGER.GetDataValue( 0,"obcpp_spin_022a", "OutBlock1", "CSNO" ,0)
		
		'DN Data
		sDN = DATAMANAGER.GetDataValue( 0,"obcpp_spin_022a", "OutBlock1", "DN_DATA" ,0)
		
		g_SSTM_Date = DATAMANAGER.GetDataValue( 0,"obcpp_spin_022a", "OutBlock1", "SSTM_DATE" ,0) '20160905_01 KBC : CDD이행주기 안내팝업
		
		if g_sDN <> sDN then
			Form.MsgBox("알림", "간편인증가입 시 등록된 인증서가 변경되었습니다. 재설정해주세요", "", 2)
		end if

		'공인인증 기관 장애 여부
		sCertSkip = DATAMANAGER.GetDataValue( 0,"obcpp_spin_022a", "OutBlock1", "AUTH_ATHN_ISTU_DSBL_YN" ,0)

		if sCertSkip == "Y" then
			Form.MsgBox("알림", "현재 공인인증센터 장애로 인해 전자서명을 사용하지 않고 접속합니다.", "certskip", 2)			
		else 
			'간편인증용 API사용 : ReqCheckIsValidPassword -> ReqAutoCheckIsValidPassword
			Form.RequestCertCommand("ReqAutoCheckIsValidPassword", g_sDN, g_sCertPass) '로그인 정상 시 인증서 체크시작
		end if
		
		Form.RequestCommand("NEW_EMGR_MSG", "", "")
		Form.RequestCommand("DEVICE_LOG", "", "")
		
	'20160803_01 KBC END
	'------------------------------------------------------------------
	'------------------------------------------------------------------
	'------------------------------------------------------------------
		
	elseif szTranID == "obcpp_pcrt_166a" then
		'상태구분코드
		sStatCode =  DATAMANAGER.GetDataValue( 0,"obcpp_pcrt_166a", "OutBlock1", "STAT_CLS_CODE" ,0)

		if sStatCode == "Y" then
			Form.Toast(0, "로그인 성공" , 0 )
			
			'중복접속체크
			DATAMANAGER.RequestTranData("ohhts_logn_dupt")
		else 
			Form.ShowAlert("알림","유효하지 않은 인증서로 인하여 로그인이 취소되었습니다." )
		end if
	
		
	elseif szTranID == "obcpp_logn_015a" then
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)

		nCount = CInt(sMstk)
		
		if nCount >  0 then	
			Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")	
		end if
	
	'20160425 KBC START : 	
	elseif szTranID == "obcpp_logn_017a" then
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_017a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)

		nCount = CInt(sMstk)
		if nCount >  0 then	
			Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")
		else
			Request_obcpp_logn_006a()
		end if	
	'20160425 KBC END
		
	'중복접속여부체크
	elseif szTranID == "ohhts_logn_dupt" then
		sDual =  DATAMANAGER.GetDataValue( 0,"ohhts_logn_dupt", "OutBlock1", "PROS_CLS",0)

		'접속자 없음
		if sDual == "1" then
			Request_obcpp_logn_010a()
		else
			if g_sDplcPrms == "Y" then '중복접속 허용
				Form.ShowAlert("알림","다른 PC 또는 스마트폰에서 동일ID로 접속 중입니다.\n\n※ 스마트폰에서 로그아웃하지 않고 종료한 경우 접속 중으로 표시될 수 있습니다.")

				'중복접속 후속처리
				DATAMANAGER.SetDataValue( 0, "ohhts_kick_dupt", "InBlock1", "PROS_CLS" , 0 , g_sDplcPrms ) 
				DATAMANAGER.RequestTranData("ohhts_kick_dupt")
			else
				Form.MsgBox("알림", "다른 PC 또는 스마트폰에서 접속 중입니다.\n기존 접속을 종료하고 강제 로그인하시겠습니까\n\n※ 스마트폰에서 로그아웃하지 않고 종료한 경우 접속 중으로 표시될 수 있습니다.", "DplcPrms", 2)
			end if
		end if

	'중복접속 후속처리
	elseif szTranID == "ohhts_kick_dupt" then
		Request_obcpp_logn_010a()

	'최종접속일
	elseif szTranID == "obcpp_logn_010a" then
		sDay =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_010a", "OutBlock1", "CONN_YMDH" ,0)
		
		Form.Toast( 0,"최종접속일 : " & sDay , 0 )

		if g_sCertLogin == "0" or g_sCertLogin == "2" then
			'ID로그인, 간편로그인
			if g_sSiseCheck == "0" then
				Request_obcsb_efif_021r(false)
			else
				'20160713_01 KBC START : 투자성향진단 업무변경사항
				'HTS정보조회
				Request_obcsb_efif_005r()
				'20160713_01 KBC END
			end if
		else	
			'공인인증서로그인
			Request_obcsb_efif_021r(false) 
		end if
		
	'계좌리스트	
	elseif szTranID == "obcsb_efif_021r" then
		nCount = DATAMANAGER.GetDataCount( 0, "obcsb_efif_021r", "OutBlock1")
		bNextData =  DATAMANAGER.IsMoreNextData("obcsb_efif_021r")
		
		if bNextData == "1" or bNextData == true then
			Request_obcsb_efif_021r(true)
		else 
			'20160713_01 KBC START : 투자성향진단 업무변경사항
			'HTS정보조회
			Request_obcsb_efif_005r()
			'20160713_01 KBC END
		end if	

	'20160713_01 KBC START : 투자성향진단 업무변경사항

	'HTS정보조회
	elseif szTranID == "obcsb_efif_005r" then
		bClose = TRUE

		'=======================================================================================================
		'ETF자동해지대상고객 팝업 - 201607 김인택과장 요청
		'=======================================================================================================
		if bClose then
		
			'ETF자동해지대상구분코드
			EtfCancCode = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_005r", "OutBlock2", "ETF_ATMT_CANC_TRGT_CLS_CODE" , 0)
			
			'ETF해지예정일자
			EtfCancDate = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_005r", "OutBlock2", "ETF_CANC_SCDL_DATE" , 0)       
		
'TEST
'EtfCancCode = "1"
'EtfCancDate = "20160808"
	
			if Len(EtfCancDate) == 8 then
				szData = EtfCancCode & "★" & EtfCancDate 
				bClose = FALSE
				Form.OpenPopup( "mbonl88000_p1" , szData , sPosInfo)
			end if		
		end if
		
		'=======================================================================================================
		'투자성향 만료 안내 팝업 (2년)
		'=======================================================================================================
		
		if bClose then 'ETF자동해지 해당없을때만 2년만기 고려 (아이폰 : 두개 팝업 실행 시 로그인 종료 시 문제되어...MTS만 이와같이 처리하기로 함)
		
			'투자권유구분코드 (투자성향 만료 안내 팝업 (2년))
			KYCPopChk = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "KYC_INVT_RCMD_CLS_CODE" , 0))
			
			If KYCPopChk <> "" Then '전문투자자만 팝업 공지를 하지 않음.
			
				'KYC 유효기간만료일자
				KYCValdDate = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "KYC_VALD_PRD_MTRT_DATE", 0 )) 
				
				'당영업일자
				'CurDate = Form.GetSharedData("&BIZ_DT", 0) '최초실행 시 사용불가

				If Len(KYCValdDate) >= 8 And Len(g_SSTM_Date) >= 8 Then
	
					ReKYCValdDate = left(KYCValdDate,4)&"-"&mid(KYCValdDate,5,2)&"-"&right(KYCValdDate,2)
					ReCurDate = left(g_SSTM_Date,4)&"-"&mid(g_SSTM_Date,5,2)&"-"&right(g_SSTM_Date,2)
				
					If DateDiff("d",ReCurDate,ReKYCValdDate) <= 30 Then '만료 30일전부터 안내
						bClose = FALSE
						szData = KYCValdDate
						Form.OpenPopup("mbonl81010_p5" , szData , sPosInfo )
					End if
				End if 		
			End if 
		end if
		
		'=======================================================================================================
		'CDD재이행 주기 도래 고객에 대한 안내 팝업창 제공 - 201608 나숙희과장 요청
		'=======================================================================================================
		'20160905_01 KBC START : CDD이행주기 안내팝업
		if bClose then
			bCDDYn = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_005r", "OutBlock3", "REG_YN" , 0)
			
			if bCDDYn == "N" then
				szOpenedDate = Form.GetEnvData( "90020_pd_opened" )
				
				if szOpenedDate == "99999999" or szOpenedDate == "" then
					Form.OpenFramePopup( "mhetc90020_pd" , szData , sPosInfo)
					bClose = FALSE

				elseif LEN(szOpenedDate) >= 8 and LEN(g_SSTM_Date) >= 8 then
					DTszOpenedDate = left(szOpenedDate,4)&"-"&mid(szOpenedDate,5,2)&"-"&right(szOpenedDate,2) '마지막팝업일자
					DTSSTM_Date = left(g_SSTM_Date,4)&"-"&mid(g_SSTM_Date,5,2)&"-"&right(g_SSTM_Date,2) '오늘일자

					If DateDiff("d",DTszOpenedDate,DTSSTM_Date) > 30 Then '30일동안보지않기
						Form.OpenFramePopup( "mhetc90020_pd" , szData , sPosInfo)
						bClose = FALSE
					end if
					
				end if
				
			end if
		end if
		'20160905_01 KBC END
		
		'=======================================================================================================
		'로그인화면 종료
		'=======================================================================================================
		if bClose then
			Form.CloseForm( )
		end if
		
	'20160713_01 KBC END

	end if	
	
End Sub
'============================================================================


Sub Form_OnCertEvent ( sType  , sSucces , stext )

	'20160425 KBC START
	if sType == "RetIsCertPasswordValid" then  '(ReqCheckIsValidPassword -> RetIsCertPasswordValid)
		if sSucces == "Success" then  ' 성공
			Form.SetEnvData( 1,"login.input.userid",g_sID)
			Form.SetCertDNPW(g_sDN, g_sCertPass)

			if g_sCertLogin == "0" or g_sCertLogin == "2" then 'ID로그인
				Request_obcpp_logn_015a("Y")
				Request_obcpp_pcrt_166a()	
				
			elseif g_sCertLogin == "1" then  '인증서로그인
				Request_obcpp_logn_017a("Y")
			end if
			
		elseif sSucces == "Failed" then '  비밀번호 오류
			if g_sCertLogin == "0" or g_sCertLogin == "2" then
				Request_obcpp_logn_015a("N")
			else
				Request_obcpp_logn_017a("N")
			end if
			
		elseif sSucces == "Error" then ' 인증서 없음
			'20160613 NOHES START 공인인증서 없음 처리
			Form.OpenDialog("mhetc90020_perr", "", "")
			'20160613 NOHES END
		end if
	
	'20160803_01 KBC START : 간편인증로그인 도입
	'간편인증 시 기존 로그인의 공인인증 비밀번호횟수 관리를 하지말자고 함 (시스템개발팀협의)
	elseif sType == "RetIsAutoCertPasswordValid" then '간편인증 (ReqAutoCheckIsValidPassword -> RetIsAutoCertPasswordValid)
	
		if sSucces == "Success" then  ' 성공
			Form.SetEnvData( 1,"login.input.userid",g_sID)
			Form.SetCertDNPW(g_sDN, g_sCertPass)
			Request_obcpp_pcrt_166a()
				
		elseif sSucces == "Failed" then '  비밀번호 오류
			Form.ShowAlert("알림", "공인인증서 비밀번호 오류입니다. 간편인증서비스 재설정해주시기 바랍니다.")
			
		elseif sSucces == "Error" then ' 인증서 없음
			Form.OpenDialog("mhetc90020_perr", "", "")
		end if	
	'20160803_01 KBC END
	
	end if
	
	'20160425 KBC END
	
End Sub
'============================================================================
Sub Request_obcpp_logn_006a()
	szTranID = "obcpp_logn_006a"
	
	'20160526 LKM START - iOS/안드로이드채널유형코드 세팅 오류 수정 
	'참고) 156: MTS-IOS      157 - MTS-안드로이드 
	
	Dim strMediaType
	strMediaType =  Trim(Form.GetSharedData("&MEDIA_CODE", 0 ))	'20160429 lkm iOS는 숨김 
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , strMediaType ) 	'채널유형코드
	'20160526 LKM END
	
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DN_DATA" , 0 , g_sDN ) 					'DM
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "AUTH_ATHN_USE_YN" , 0 , "Y" )				'공인인증 사용여부
	DATAMANAGER.RequestTranData( szTranID )
End Sub
'============================================================================
Sub Request_obcpp_pcrt_166a()
	
	DATAMANAGER.SetUserID(g_sID)
	
	DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "USER_ID" , 0 , g_sID )					'사용자ID
	DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "RCNO" , 0 , g_sRCNO) 					'실명확인번호
	DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "RCNO_PIP" , 0 , g_sRCNO_PIP) 				'실명확인번호PIP v001
	DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "USER_NAME" , 0 , g_sUserName ) 			'사용자명
	DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "CSNO" , 0 , g_sCSNO) 					'고객번호

	'20160803_01 KBC START : 간편인증로그인 도입
	'(0.일반인증서 1.간편인증인증서 2.KOSCOM지문인식용인증서)
	if Form.GetSharedData("&CERT_USE_TYPE" , 0) == "0" then
	
		sRValue = Form.GetRvalue( g_sDN , g_sCertPass)
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "UI_R_VAL" , 0 , sRValue) 					'R 값	
		
		sSignData = Form.GetCertSignData( g_sDN , g_sCertPass)
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" , 0 , sSignData) 	'전자서명데이타
		
		sSerialNum = Form.GetCertSerialNumber( g_sDN)
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "NTAT_SRNO" , 0 , sSerialNum) 				'인증서 일련번호	

	else	
	
		sRValue = Form.GetAutoRvalue( g_sDN , g_sCertPass)
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "UI_R_VAL" , 0 , sRValue) 					'R 값	
		
		sSignData = Form.GetAutoCertSignData( g_sDN , g_sCertPass)
		
		if sSignData == "-1" then
			sSignData = g_sFingerSignedData
			g_sFingerSignedData = ""
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" , 0 , sSignData) 	'전자서명데이타
		
		sSerialNum = Form.GetAutoCertSerialNumber(g_sDN)
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_166a", "InBlock1", "NTAT_SRNO" , 0 , sSerialNum) 				'인증서 일련번호
	
	end if
	'20160803_01 KBC END


	'공인인증검증 TR
	DATAMANAGER.RequestTranData("obcpp_pcrt_166a")
End Sub
'============================================================================
'최종접속정보 조회   TR
Sub Request_obcpp_logn_010a()
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_010a", "InBlock1", "USER_ID" , 0 , g_sID ) 		'사용자ID
	DATAMANAGER.RequestTranData("obcpp_logn_010a")
End Sub	
'============================================================================
' MTS 로그인 공인인증서 접속로그  TR
Sub Request_obcpp_logn_015a(szSucs_YN)
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "USER_ID" , 0 , g_sID ) 		'사용자ID
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 	'성공여부	
	
	'20161101_02 KBC START : 전문변경대응 (obcpp_logn_015a)
	if g_sCertLogin == "2" then '간편인증
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE" , 0 , "06") 	'06.간편인증
	else
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE" , 0 , "  ")
	end if
	'20161101_02 KBC END
	
	DATAMANAGER.RequestTranData("obcpp_logn_015a")
End Sub
'============================================================================
'20160425 KBC START
Sub Request_obcpp_logn_017a(szSucs_YN)
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_017a", "InBlock1", "DN_DATA" , 0 , g_sDN ) 		'DN
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_017a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 	'성공여부	
	DATAMANAGER.RequestTranData("obcpp_logn_017a")
End Sub
'20160425 KBC END
'============================================================================
'계좌리스트 조회	
Sub Request_obcsb_efif_021r(bNext)
	'20160607_03 KBC : 계좌컨트롤
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )	'1.ID 2.주민번호
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "ELFN_ID" , 0 , g_sID) 		'ID
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "RCNO" , 0 , g_sRCNO) 		'주민번호
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "RCNO_PIP" , 0 , g_sRCNO_PIP) 	'주민번호 v001
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN", 0 , "N") 		'평가수행여부		
	'20160607_03 KBC : 계좌컨트롤

	if bNext == true then
		DATAMANAGER.RequestNextData("obcsb_efif_021r")
	else
		DATAMANAGER.RequestTranData("obcsb_efif_021r")
	end if
End Sub	

'============================================================================
'20160713_01 KBC START : 투자성향진단 업무변경사항
'HTS정보조회
Sub Request_obcsb_efif_005r()
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_005r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1" )
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_005r", "InBlock1", "ELFN_ID" 		, 0 , g_sID)
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_005r", "InBlock1", "ACNO" 			, 0 , "") 
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_005r", "InBlock1", "ASNO"			, 0 , "")
	
	DATAMANAGER.RequestTranData("obcsb_efif_005r")
End Sub	
'20160713_01 KBC END

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "obcsb_efif_005r" then
		Form.MsgBox( "알림", "[" & szErrCode & "]" & szErrMsg & "(" & szTranID & ")", "", 0 )
		Form.CloseForm()
	elseif szTranID == "obcpp_pcrt_166a" then
		'OCSP검증 -> 폐지된 인증서 등...인증서 유효하지않음
		
		if g_sCertLogin == "2" then
			'간편인증
			
			ContainerSpin.btnLogin.enable = "1" '20161026_01 KBC
			
			'20161026_01 KBC
			szErrMsg2 = "간편인증서비스 신청 시 사용한 인증서는 더이상 사용하실 수 없습니다.\n\n" &
			            "유효한 인증서로 로그인(ID+공인인증)하신 후 간편인증서비스를 재설정 해주시기 바랍니다.\n\n" &
				        "[" & szErrCode & "]" & szErrMsg
					
			Form.MsgBox( "알림", szErrMsg2, "", 0 )
			
'이전소스			
'			szErrMsg2 = szErrMsg & "\n\n간편인증서비스 신청 시 사용한 인증서는 더이상 사용하실 수 없습니다.\n\n" &
'			            "유효한 인증서로 로그인(ID+공인인증)하신 후 간편인증서비스를 재설정 해주시기 바랍니다."
'					
'			Form.MsgBox( "알림", "[" & szErrCode & "]" & szErrMsg2, "", 0 )
		else
			Form.MsgBox( "알림", "[" & szErrCode & "]" & szErrMsg, "", 0 )
		end if
	else
		Form.MsgBox( "알림", "[" & szErrCode & "]" & szErrMsg & "(" & szTranID & ")", "", 0 )
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "certskip" then
		if sRet == "ok" then
			if g_sSiseCheck == "1" then
				Form.MsgBox( "알림", "고객님께서는 현재 시세조회전용으로 접속하셨습니다. \n\n주문 및 계좌조회 서비스는 불가하오니 모든 거래를 원하시면 시세조회전용 선택을 해제 후 다시 접속하시기 바랍니다. \n", "", 0 )			
				
				DATAMANAGER.RequestTranData("ohhts_logn_dupt")
			else
				DATAMANAGER.RequestTranData("ohhts_logn_dupt")
			end if		
		end if
		
	 elseif sKeyName == "DplcPrms" then	
		 if sRet == "ok" then
			DATAMANAGER.SetDataValue( 0, "ohhts_kick_dupt", "InBlock1", "PROS_CLS" , 0 , g_sDplcPrms ) 
			DATAMANAGER.RequestTranData("ohhts_kick_dupt")		 
		 end if
		 
	'20160808 NOHES START 시스템점검시간 시 시세조회전용으로 접속 허용	 
	elseif sKeyName == "CheckSystem" then	
		Form.CloseForm( )
	
	'20160808 NOHES END
	
	end if
	
End Sub
'============================================================================
Sub procSelectedCert(sDN)

	Dim sCertCnt, sToday, sCalDate 
	Dim bFind
	
	sCertCnt = Form.GetCertListSize()
	sToday = Form.GetSharedData("&HOST_DATE",0 )
	sCalDate = Form.calcDateTime( 0, 0, 30, 0, 0, 0 )
	sCalDate = Left(sCalDate, 8)
	bFind = false
	
	ContainerCert.Grid0.SetClear()
	ContainerCert.Grid0.rowcount = 1
	
	if sCertCnt ~= null and sCertCnt ~= "" then
		if CInt(sCertCnt) > 0 then
			Dim sCertInfo, sTemp, sDate

			for i = 0 to CInt(sCertCnt)-1
				sCertInfo = Form.GetCertListDataAt(i)
				sTemp = Split(sCertInfo, ";")
				
				if #sTemp > 7 then
					'sTemp[0] 성명
					'sTemp[1] DN
					'sTemp[2] 종류(범용개인)
					'sTemp[3] 발급기관
					'sTemp[5] 사용가능여부(가능1)
					'sTemp[6] 만기일
					'sTemp[7] 시작일
					
					if sTemp[1] == sDN then
						bFind = true
						
						ContainerCert.Grid0.SetCellData( "bd_name", 0, sTemp[0] )
						ContainerCert.Grid0.SetCellData( "bd_cert", 0, sTemp[2].." ("..sTemp[3]..")" )
						sDate = sTemp[7]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerCert.Grid0.SetCellData( "bd_date", 0, "20"..sDate )
						
						sDate = sTemp[6]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerCert.Grid0.SetCellData( "bd_Edate", 0, "20"..sDate )
						ContainerCert.Grid0.SetCellData( "bd_dn", 0, sTemp[1] )
						ContainerCert.Grid0.SetCellData( "bd_index", 0, i )
						
						if tonumber("20"..sDate) > tonumber(sCalDate) then
							ContainerCert.Grid0.SetCellData( "bd_icon", 0, "icon_sub_05.9.png" )
						else
							ContainerCert.Grid0.SetCellData( "bd_icon", 0, "icon_sub_06.9.png" )
						end if
					end if
				end if
			next

		end if
	end if
	
	if bFind == false then
		ContainerCert.Grid0.SetCellData( "bd_cert", 0, "공인인증서를 선택하세요." )
		ContainerCert_btnCertList_OnClick()
	end if
	
End Sub		

