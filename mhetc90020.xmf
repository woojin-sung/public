'============================================================================
'20160803_01 KBC START : 간편인증로그인 도입
'============================================================================
Sub Tab0_OnTabChanged(nIndex)

	nInitLeft = 36
	nInitTop = 193

	if nIndex = 0 then
		'-----------------------------------------------------
		'간편인증로그인
		ContainerSpin.left = nInitLeft
		ContainerSpin.top = nInitTop

		ContainerID.visible = false
		ContainerCert.visible = false
		ContainerSpin.visible = true
		
'		'로그인->간편인증 탭 전환시에만 팝업 띄움
'		'간편인증 탭 저장되어 자동으로 선택된 경우에는 팝업 안함
'		sSaveTab = Form.GetEnvData( "login.input.savetab")
'		if sSaveTab <> "1" then
'			szSave = Form.GetEnvData( "spinpadnotice" )
'
'			if szSave <> "1" Then
'			     Form.OpenPopup("notice_spin", "")
'			End if			
'		end if

			
		'-----------------------------------------------------
		
		Form.SetEnvData(1, "login.input.savetab", "0")
		
	elseif nIndex = 1 then
		'-----------------------------------------------------
		'공인인증
		ContainerCert.left = nInitLeft
		ContainerCert.top = nInitTop

		ContainerID.visible = false
		ContainerSpin.visible = false		
		ContainerCert.visible = true
		
		g_sDN = Form.GetEnvData("login.input.userdn")
		procSelectedCert(g_sDN)		
		'-----------------------------------------------------
		
		Form.SetEnvData(1, "login.input.savetab", "1")
		
	elseif nIndex = 2 then
		'-----------------------------------------------------
		'ID인증
		ContainerID.left = nInitLeft
		ContainerID.top = nInitTop
		
		ContainerCert.visible = false
		ContainerSpin.visible = false
		ContainerID.visible = true
		'-----------------------------------------------------
		
		Form.SetEnvData(1, "login.input.savetab", "2")
	end if	
End Sub
