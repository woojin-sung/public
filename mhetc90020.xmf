Sub ContainerSpin_Button9_OnClick()
	'Form.OpenFramePopup( "mhetc90070_p1", "LOGIN" , "" )
	
	'직원여부 : 기본값 처리 (필수-지우지마시오)
	sEmplYn = Form.GetSharedData("&EMPL_YN" , 0)
