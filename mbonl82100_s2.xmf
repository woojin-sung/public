'				end if
'			next
'		end if
	elseif szTranID == "obcsb_acad_120r" then
		Dim sCustTelNo
		Dim szSRNO
		
		tmpArcd = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_ARCD", 0)
		tmpTono = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_TONO", 0)
		tmpTelno = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_TELNO", 0)
