	<SCRIPT_INFO _len="39213" _ulen="36599" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 신용거래약정
' 02. 화면설명 : 신용거래약정
' 03. 작    성 : 2022.09.04 이아영
' 04. 수    정 : v001.이학록.금융거래안심차단 서비스 내용 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szSelectLoan1
Dim g_szSelectLoan2
Dim g_szButtonEmail
Dim g_szButtonRadio2

Dim g_bState 'true 변경하고자함 false 등록하고자 함

Dim g_szAccount
Dim g_szActPwd

Dim g_bSubActPwd

Dim g_szEmailSRNO
Dim g_szPhoneSRNO
Dim g_szFnprJoinSrno
Dim g_szProsDate
Dim g_szProsSRNO
Dim g_nAmt1
Dim g_nPossibleAmount

'LHR 수정
Dim g_sz801aAsno
Dim g_szProsClsCode
Dim g_szStplYN
Dim g_szbtnAmtFlag
Dim g_szCustClsCode

'v001
Dim g_NICE_TR_CODE
Dim g_NICE_TR_SRNO
Dim g_Timer_TRY_CNT 
Dim g_PROS_CLS'1.조회 2.처리
'============================================================================
Sub Form_OnFormInit()
	g_bSubActPwd = false
	g_szButtonEmail = "0"
	g_szSelectLoan1 = "0"
	g_szSelectLoan2 = "0"
	g_szStplYN = "N"
	
	'LHR 수정
	Form.SetCtlProp( "contAll.contScroll.lblQ21", "fgcolor", "67")
	Form.SetCtlProp( "contAll.contScroll.btnMove", "fgcolor", "67")
	'LHR 수정 초기 셋팅
	contAll.contTop.visible = "0"
	contAll.contScroll.top = "0"	
	contAll.contScroll.height = "552"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert(sEventName, sParam)
	if sEventName == "InitData" then
		if trim(sParam) ~= "" then
			Dim tParam
			tParam = Split(sParam, "★")
			g_szAccount = tParam[0]
			g_szActPwd  = tParam[1]			
'			if trim(tParam[2]) == "Y" then
'				f_SetButtonCheck("imgQ21")			
'			end if
			
			if trim(tParam[3]) == "Y" then
				'f_SetButtonCheck("imgQ22")
				szCtlName = "imgQ22"
				Form.SetCtlProp( "contAll.contScroll."..szCtlName, "imgpath", "input_01_o.9" )
	'			contScroll.imgQ22.imgpath = "input_03_o.9"
				'LHR 수정
				Form.SetCtlProp("contAll.contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")	
				g_szButtonEmail = "1"
				contAll.contScroll.lblQ22.enable = "0"
			end if
			
			
			'증권담보융자 trim(tParam[4])			
			Dim tData1
			tData1 = Split(trim(tParam[4]), "☆")
			if trim(tData1[0]) == "" or trim(tData1[0]) == "Y" then
				'미등록
				contAll.contTop.visible = "0"
				contAll.contScroll.top = "0"	
				contAll.contScroll.height = "552"
				g_szStplYN = "N"
			else
				contAll.contTop.visible = "1"
				contAll.contScroll.top = "80"
				contAll.contScroll.height = "472"
				g_szStplYN = "Y"
			
				f_SetButtonCheck("imgTypeBg1")
				g_szSelectLoan1 = "2"
				
				if trim(tData1[1]) ~= "" then
					contAll.contScroll.edtAmt.caption = CInt(trim(tData1[1]) )
					DATAMANAGER.RequestTranData("oblon_stmp_001r")
				end if
				
				'매도담보융자 trim(tParam[5])			
				Dim tData2
				tData2 = Split(trim(tParam[5]), "☆")
				if trim(tData2[0]) == "" or trim(tData2[0]) == "Y" then
					'미등록
				else
					f_SetButtonCheck("imgTypeBg2")
					g_szSelectLoan2 = "2"
				end if
				
				'LHR 수정 둘 다 약정이면 위에 버튼 숨김
				if g_szSelectLoan1 == "2" and g_szSelectLoan2 == "2" then
					'미등록
					contAll.contTop.visible = "0"
					contAll.contScroll.top = "0"	
					contAll.contScroll.height = "552"
				end if
			end if		
			'Form.ShowAlert("tParam[8]", tParam[8])
			g_szCustClsCode = tParam[8]
			contAll.SetScrollAutoSize()
			
			'LHR 수정
			'DATAMANAGER.RequestTranData("obrtp_drab_001r")
			
			g_szFnprJoinSrno  = tParam[9]
			
			if trim(g_szFnprJoinSrno) == "" then
				g_FinCustomer = "N"
			else
				g_FinCustomer = "Y"
			end if
		end if
	
	elseif sEventName == "SetEmailInfo" then
		if trim(sParam) ~= "" then
			Dim tData 
			tData = Split(sParam, "★")
			contAll.contScroll.tblInfo.SetCellString(1,1,tData[0])
			g_szEmailSRNO = tData[1]
		end if
		
	elseif sEventName == "SetPhoneInfo" then
		if trim(sParam) ~= "" then
			Dim tData 
			tData = Split(sParam, "★")
			contAll.contScroll.tblInfo.SetCellString(0,1,tData[0])
			g_szPhoneSRNO = tData[1]
		end if
		
	elseif sEventName == "ActChange" then
		if trim(sParam) ~= "" then
			Dim tActParam
			tActParam = Split(sParam, "☆")
			g_szAccount = tActParam[0]
			g_szActPwd  = tActParam[1]
			
			DATAMANAGER.RequestTranData("obrtp_drab_001r")
		end if 
	
	elseif sEventName == "PwdComplete" then
		if trim(sParam) ~= "" then
			Dim tActParam
			tActParam = Split(sParam, "☆")
			g_szAccount = tActParam[0]
			g_szActPwd  = tActParam[1]
		end if 
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'231207 - 온라이가이드 추가	 START
	if sKeyName == "mbonl82100_p1" then
		'동의
		if sRet ~= "Close" then
			Form.OpenFramePopup("mbonl82010_p9" , "", "") '주요내용 확인		
		end if 
		
	'if sKeyName == "mbonl82100_p1" then
	elseif sKeyName == "mbonl82010_p9" then
'231207 - 온라이가이드 추가	 END 	
		'동의
		if sRet ~= "Close" then
			'법인인 경우 개인신용정보제공 동의 없음
			if g_szCustClsCode == "2" then				
				'LHR 수정 비밀번호 무조건 입력
				g_szActPwd = ""
				if trim(g_szActPwd) == "" then
					Dim sValue
					sValue = g_szAccount.."☆2"
					Form.openPopupAnimation("pwdcheckpopup", sValue ,"","2")
				else
		'			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
		
					if trim(g_szFnprJoinSrno) == "" then
						DATAMANAGER.RequestTranData("obsap_acif_999a")
					else 
						DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
					end if
				end if
			else
				'DATAMANAGER.RequestTranData("obaci_acct_255a")
				'g_szProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
				'g_szProsSRNO =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
				g_szProsDate = Form.GetSharedData("255a_PROS_DATE", true)
				g_szProsSRNO = Form.GetSharedData("255a_PROS_SRNO", true)
				'LHR 수정 비밀번호 무조건 입력
				g_szActPwd = ""
				if trim(g_szActPwd) == "" then
					Dim sValue
					sValue = g_szAccount.."☆2"
					Form.openPopupAnimation("pwdcheckpopup", sValue ,"","2")
				else
		'			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
		
					if trim(g_szFnprJoinSrno) == "" then
						DATAMANAGER.RequestTranData("obsap_acif_999a")
					else
						DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
					end if
				end if
			end if
		end if
		
	elseif sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			
			if g_bSubActPwd == true then
				g_bSubActPwd = false
				
				if UBOUND(tPwd) > 0 then
					contAll.contScroll.edtPwd.pwdlen = tPwd(1)
					contAll.contScroll.edtPwd.caption = tPwd(0)
				end if
			else
				Form.triggerEvent("#", "CORRECT_PWD", tPwd[0])
			
				g_szActPwd = tPwd[0]
'				Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증

				if trim(g_szFnprJoinSrno) == "" then
					DATAMANAGER.RequestTranData("obsap_acif_999a")
				else
					DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
				end if
			end if

		end if
		
	elseif sKeyName == "mhetc90060_p5" then		
		if sRet ~= "cancel" then		
			'LHR 수정
			'DATAMANAGER.RequestTranData("obsap_acif_999a")
			'DATAMANAGER.SetEventFlag( "oblon_basc_801a", "A" )
			'DATAMANAGER.RequestTranData( "oblon_basc_801a" ) '약정등록
			'v001
			g_PROS_CLS = "2"
			NICE_LN01_CALL()
		end if 
	elseif sKeyName = "mbonl81000" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
		end if
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then	
			g_FinCustomer = "Y"
		elseif sRet == "CANCEL_mbonl81010_p20" then
			g_FinCustomer = "N"
		end if		
	end if
End Sub

'============================================================================
Sub contAll_contScroll_edtPwd_OnClick()
	Dim szPwd  
	szPwd = contAll.contScroll.edtPwd.caption
	if szPwd == null or szPwd == "" then
		g_bSubActPwd = true
		Dim sValue
		sValue = contAll.contScroll.Account1.caption.."☆2"
		Form.openPopupAnimation("pwdcheckpopup", sValue ,"","2")
	end if
End Sub

'===========================================================================
Function f_SetButtonCheck(szCtlName)	
	if szCtlName == "imgTypeBg1" then
		if g_szSelectLoan1 == "0" then
			g_szSelectLoan1 = "1"
			Form.SetCtlProp( "contAll.contTop.imgTypeBg1", "imgpath", "input_01_o.9")
			'LHR 수정
			Form.SetCtlProp( "contAll.contTop.lblType1", "fgcolor", "67")
		else
			g_szSelectLoan1 = "0"
			Form.SetCtlProp( "contAll.contTop.imgTypeBg1", "imgpath", "input_01_n.9")
			'LHR 수정
			Form.SetCtlProp( "contAll.contTop.lblType1", "fgcolor", "127")
		end if 
		
	elseif szCtlName == "imgTypeBg2" then
		if g_szSelectLoan2 == "0" then
			g_szSelectLoan2 = "1"
			Form.SetCtlProp( "contAll.contTop.imgTypeBg2", "imgpath", "input_01_o.9")
			'LHR 수정
			Form.SetCtlProp( "contAll.contTop.lblType2", "fgcolor", "67")
		else
			g_szSelectLoan2 = "0"
			Form.SetCtlProp( "contAll.contTop.imgTypeBg2", "imgpath", "input_01_n.9")
			'LHR 수정
			Form.SetCtlProp( "contAll.contTop.lblType2", "fgcolor", "127")
		end if 
'	
	elseif szCtlName == "imgQ31" or szCtlName == "imgQ32" then
		Dim tBtnName1
		tBtnName1 = {"imgQ31", "imgQ32"}
		for i = 0 to 1
			if szCtlName == tBtnName1[i] then
				Form.SetCtlProp( "contAll.contScroll."..szCtlName, "imgpath", "input_01_o.9")
				g_szButtonRadio2 = Right( szCtlName, 1 )
				'LHR 수정
				Form.SetCtlProp("contAll.contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")
			else
				Form.SetCtlProp( "contAll.contScroll."..tBtnName1[i], "imgpath", "input_01_n.9")
				'LHR 수정
				Form.SetCtlProp("contAll.contScroll.lbl"..MID(tBtnName1[i],4,3), "fgcolor", "127")
			end if
		next
'		
	else
		Dim szBtnBg
'		szBtnBg = Form.GetCtlProp( "contScroll."..szCtlName, "imgpath" )
		if g_szButtonEmail == "0" then
			Form.SetCtlProp( "contAll.contScroll."..szCtlName, "imgpath", "input_01_o.9" )
'			contScroll.imgQ22.imgpath = "input_03_o.9"

			g_szButtonEmail = "1"
			'LHR 수정
			Form.SetCtlProp("contAll.contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")
		else
			Form.SetCtlProp( "contAll.contScroll."..szCtlName, "imgpath", "input_01_n.9" )
'			contScroll.imgQ22.imgpath = "input_03_n.9"

			g_szButtonEmail = "0"
			'LHR 수정
			Form.SetCtlProp("contAll.contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "127")
		end if
	end if
	
End Function

