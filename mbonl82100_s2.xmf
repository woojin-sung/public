		if g_szStplYN == "Y" then
			if g_szbtnAmtFlag == "Y" then
				contAll.contScroll.lblAmtInfo.caption = "고객님의 기납부세액은 "..FormatNumber(nAmt2,0).."원입니다.\n추가로 납부하실 금액은 "..FormatNumber(g_nAmt1,0).."원입니다. (총인지세 : "..FormatNumber(nAmt3,0).."원)"
				contAll.contScroll.btnAmt.enable = "0"
			else
				contAll.contScroll.lblAmtInfo.caption = "고객님의 기납부세액은 "..FormatNumber(nAmt2,0).."원입니다."
				contAll.contScroll.btnAmt.enable = "1"
			end if
		else
			if g_szbtnAmtFlag == "Y" then
				'contAll.contScroll.lblAmtInfo.caption = "고객님의 기납부세액은 "..FormatNumber(nAmt2,0).."원입니다.\n추가로 납부하실 금액은 "..FormatNumber(g_nAmt1,0).."원입니다. (총인지세 : "..FormatNumber(nAmt3,0).."원)"
				contAll.contScroll.lblAmtInfo.caption = "고객님이 납부하실 인지세는 "..FormatNumber(g_nAmt1,0).."원입니다."
				contAll.contScroll.btnAmt.enable = "0"
			else
				contAll.contScroll.lblAmtInfo.caption = "고객님이 납부하실 인지세는 "..FormatNumber(g_nAmt1,0).."원입니다."
				contAll.contScroll.btnAmt.enable = "1"
			end if
		end if
	'LHR 수정
	elseif szTranID == "obacp_opop_065r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obacp_opop_065r", "OutBlock1" )

		if nCnt > 0 then
			Dim ACNT_STAT_CODE, PRCD, ACNO, ASNO, CSNM, UI_INPR_NAME
			
			for i = 0 to nCnt-1
				ACNT_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ACNT_STAT_CODE" , i )
				PRCD = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "PRCD" , i )
				if ACNT_STAT_CODE == "1" and PRCD == "100" or PRCD == "105" or PRCD == "106" or PRCD == "107" or PRCD == "119" or PRCD == "200" then
					g_sz801aAsno = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , i )

					Exit For
				else
					g_sz801aAsno = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , 0 )
				end if

			next
		end if
		'LHR 수정
		Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
	'LHR 수정 고객연락처
	elseif szTranID == "obcsb_acad_002r" then
		'연락처 초기화
		contAll.contScroll.tblInfo.SetCellString(0, 1, "")
		contAll.contScroll.tblInfo.SetCellString(1, 1, "")
		
		Dim nCnt 
		Dim szCustClsCode
		
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )	)
		if nCnt > 0 then
			for i = 0 to nCnt-1
				Dim sINAG_TYPE_CODE
				Dim sEMAIL_ADDR
				Dim szSRNO
				
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )	
				if sINAG_TYPE_CODE == "21" then 'E-mail
					sEMAIL_ADDR = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )	
					szSRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )	
					
					contAll.contScroll.tblInfo.SetCellString(1, 1, sEMAIL_ADDR)
					g_szEmailSRNO = szSRNO
					Exit for '첫번째껄 세팅후 out
				end if
			next
		end if
		
		szCustClsCode   = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE" , 0 )
		If szCustClsCode = "2" Then '법인
			'DATAMANAGER.RequestTranData( "obaci_acct_095r" ) '법인연락처조회
			'DATAMANAGER.RequestTranData(  "obacp_comm_007r") '법인연락처조회
			DATAMANAGER.RequestTranData(  "obcsb_acad_120r") '법인연락처조회
		else
			Dim nCnt
			nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )	)	
			if nCnt > 0 then
				for i = 0 to nCnt-1
					Dim  sINAG_TYPE_CODE
					Dim szSRNO
					
					sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )	
					
					if sINAG_TYPE_CODE == "13" then '휴대폰번호
						Dim sARCD
						Dim sTONO
						Dim sTELNO
						
						sARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
						sTONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
						sTELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
						szSRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )	

						contAll.contScroll.tblInfo.SetCellString(0, 1, sARCD.."-"..sTONO.."-"..sTELNO)
						 g_szPhoneSRNO = szSRNO
						Exit for '첫번째껄 세팅후 out - 박정숙과장이 seq=1인걸 세팅해달라 함.
					end if
				next
			end if
		end if
'	elseif szTranID == "obaci_acct_095r" then
'		Dim nCnt 
'		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2" )		)
'		if nCnt > 0 then
'			for i = 0 to nCnt-1
