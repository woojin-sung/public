	end if 
End Sub


'============================================================================
Sub btnNext_OnClick()
	if trim(contAll.contScroll.edtAmt.caption) == "" or trim(contAll.contScroll.edtAmt.caption) == null then
		'LHR 수정
		sMseg = "약정금액을 입력해주세요."
		Form.MsgBox("알림", sMseg, "", 6)
	elseif g_nAmt1 == "" then
		'LHR 수정
		sMseg = "인지세를 확인해주세요."
		Form.MsgBox("알림", sMseg, "", 6)
	elseif g_szbtnAmtFlag <> "Y" then
		sMseg = "인지세를 확인하신 후 진행해주세요."
		Form.MsgBox("알림", sMseg, "", 6)
	elseif trim(contAll.contScroll.edtPwd.caption) == "" or trim(contAll.contScroll.edtPwd.caption) == null then
		'LHR 수정
		sMseg = "출금계좌 비밀번호를 입력해주세요."
		Form.MsgBox("알림", sMseg, "", 6)
	elseif trim(g_szButtonRadio2) == "" then
		'LHR 수정
		sMseg = "계약서류 통보방법을 선택해주세요."
		Form.MsgBox("알림", sMseg, "", 6)
	elseif g_FinCustomer <> "Y" then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
	else
		'g_szStplYn == "Y" 약정이 있는 상태 : 변경
		'g_szStplYn == "N" 약정이 없는 상태 : 등록
		Form.OpenPopup("mbonl82100_p1" , g_szAccount.."★"..g_szCustClsCode.."★"..g_szStplYn , "")
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSub
	szSub = DATAMANAGER.GetDataMsgSubText( szTranID)
	
	if trim(szSub) <> "" then
		szErrMsg = szErrMsg.."\n"..szSub
	end if
	Form.ShowAlert("알림", szErrMsg)
	'if szTranID == "oblon_nice_001r" then
		'Form.clearWaitCursor()
	'end if
End Sub

'============================================================================
Sub contAll_contScroll_edtAmt_OnClick()
	g_nAmt1 = 0
	contAll.contScroll.btnAmt.enable = "1"
	
	g_szbtnAmtFlag = "N"
End Sub

'============================================================================
Sub contAll_contScroll_edtAmt_OnEditComplete()
	Dim nAmt 
	nAmt = CInt(contAll.contScroll.edtAmt.caption)
	
	if nAmt > 0 then
		contAll.contScroll.btnAmt.enable = "0"
		call contAll_contScroll_btnAmt_OnClick()
	else
		contAll.contScroll.btnAmt.enable = "1"
		g_szbtnAmtFlag = "N"
	end if	
End Sub

'============================================================================
Sub contAll_contScroll_btnAmt_OnClick()
	g_szbtnAmtFlag = "Y"
	DATAMANAGER.RequestTranData("oblon_stmp_001r")
End Sub



'============================================================================
Sub Form_OnFormInitBefore()
	contAll.contScroll.imgTip1.setMaintainingRatio("2")
End Sub



'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	elseif sKeyName == "LN01" then
		if sRet == "ok" then
			g_PROS_CLS = "2"
			NICE_LN01_CALL()
		end if
	end if
End Sub

'============================================================================
Sub NICE_LN01_CALL()
	g_NICE_TR_CODE = "LN01"
	g_NICE_TR_SRNO = 0
	g_Timer_TRY_CNT = 0
	'Form.SetTimerEvent( 1, 1, 1 )
	DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "SDRC_CLS_CODE", 0 , "1")
	DATAMANAGER.RequestTranData("oblon_nice_001r")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'Form.ShowAlert("Form_OnTimerEvent" , sTimerID)
	if Cint(sTimerID) = 1 then
		g_Timer_TRY_CNT = g_Timer_TRY_CNT + 1
		
		if g_Timer_TRY_CNT > 6 then
			'Form.clearWaitCursor()
			Form.SetTimerEvent(1, 0, 1)
			
			Form.MsgBox("알림", "여신거래 안심차단 정보 조회 지연중입니다.\n 다시 조회하시겠습니까?", "LN01", 1)
		else
			DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "SDRC_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock2", "SDRC_SRNO"	 , 0 , g_NICE_TR_SRNO)
			DATAMANAGER.RequestTranData("oblon_nice_001r")
		end if
	end if
End Sub
