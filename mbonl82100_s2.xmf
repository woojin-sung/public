Sub contAll_contScroll_btnMove_OnClick()
	'연락처번경으로 메뉴이동
	'LHR 수정
	'Form.OpenScreen("81000", "")
	Form.OpenFramePopup( "mbonl81000" , "" , "")
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	Dim sACNT_PWD
	Dim sACNT_SUB_PWD
	Dim plain_rm
	Dim szSubAcPwd
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = g_szActPwd
		szSubAcPwd = contAll.contScroll.edtPwd.caption
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetEncData(g_szActPwd)
		szSubAcPwd = Form.GetEncData(contAll.contScroll.edtPwd.caption)
	end if
	
	if szTranID == "obrtp_drab_001r" then
		Dim sToday 
		sToday = Form.GetSharedData("&HOST_DATE", false )
		
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ACNO" , 0 , Left(g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , Right(g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "PROS_DATE" , 0 , sToday )	
	
	elseif szTranID == "obsap_acif_999a" then
		DATAMANAGER.SetDataValue( 0 , "obsap_acif_999a", "InBlock1", "IQRY_CLS_CODE", 0 , "")	
	
	elseif szTranID == "obcsb_acad_122a" then
		If g_szButtonRadio2 == "1" Then  '알림톡/문자
			Dim szNumber
			szNumber = contAll.contScroll.tblInfo.GetCellString( 0, 1)
			szNumber = Replace(szNumber, "-" , "")			
		
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , "13")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , g_szPhoneSRNO)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , szNumber)
		Else                                                                       '이메일
			Dim szEmail
			szEmail = contAll.contScroll.tblInfo.GetCellString( 1, 1)
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , "21")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , g_szEmailSRNO)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , szEmail)
		End If 
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	
	
	elseif szTranID == "oblon_basc_801a" then
		DATAMANAGER.ClearInputData( 0, szTranID )
		
		Dim nIndex 
'		if g_szSelectLoan1 == "1" then '예탁담보융자
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "PROS_YN" , 0 , "Y" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LOAN_TYPE_CODE" , 0 , "02" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LIMT_AMT" , 0 , contAll.contScroll.edtAmt.caption ) '약정금액
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "STPL_CANC_CLS_CODE" , 0 , "0" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "UNCL_ATMT_LOAN_YN" , 0 , "N" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "FEE_LEVY_CLS_CODE" , 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "SPLM_PAYM_AMT" , 0 , g_nAmt1 ) '추가납부인지세
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_MNRC_AMT1" , 0 , g_nAmt1 ) '추가납부인지세

'		end if
'		Form.ShowAlert("g_szSelectLoan1 : "..g_szSelectLoan1, "g_szSelectLoan2 : "..g_szSelectLoan2)
		if g_szSelectLoan2 == "1" or g_szSelectLoan1 == "0" then '매도담보융자
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "PROS_YN" , 1 , "Y" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LOAN_TYPE_CODE" , 1 , "03" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LIMT_AMT" , 1 , contAll.contScroll.edtAmt.caption ) '약정금액
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "STPL_CANC_CLS_CODE" , 1 , "0" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ACNO" , 0 , Left(g_szAccount, 8) )
		'LHR 수정
		'DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ASNO" , 0 , Right(g_szAccount, 2 ))
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ASNO" , 0 , g_sz801aAsno)
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ACNT_PWD" , 0 , g_szActPwd )
		
		if g_szSelectLoan1 == "2" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "PROS_CLS_CODE" , 0 , "2" )
			g_szProsClsCode = "2"
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "PROS_CLS_CODE" , 0 , "1" )
			g_szProsClsCode = "1"
		end if
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "DRNG_ACNO" , 0 , Left(contAll.contScroll.Account1.caption, 8) ) '인지세납부계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "DRNG_ASNO" , 0 , Right(contAll.contScroll.Account1.caption, 2) ) '인지세납부계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_CNFR_PWD" , 0 , szSubAcPwd )
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "CRDT_AGRM_BSWR_KIND_CLCD", 0, "014")
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "PROS_DATE", 0, g_szProsDate)
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "PROS_SRNO", 0, g_szProsSrno)
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "FNPR_JOIN_SRNO", 0, g_szFnprJoinSrno) 'v001
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "CONT_CLS_CODE" , 0, "4") 'v001
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN1" , 0 , "Y" )
		
		if g_szButtonEmail == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN2" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN2" , 0 , "N" )
		end if

		
	' 개인신용정보동의
	elseif szTranID == "obaci_acct_255a" then				
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ACNO" , 0 , Left( g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ASNO" , 0 , Right( g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ISCD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "RMND_SRNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD" , 0 , "014") 'g_sKindCode
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "1" ) '요약1, 상세2, 둘다3
		
		'필수동의(공통)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "UI_COMN_AGRM_YN1" , 0 , "Y")'수집이용 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "UI_COMN_AGRM_YN2" , 0 , "Y")'수집이용 개인신용정보
		
		'필수동의(수집/이용 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "UI_COMN_AGRM_YN1" , 0 , "Y" )'수집이용_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "UI_COMN_AGRM_YN2" , 0 , "Y" )'수집이용_신용공여/미수/파생상품 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN1" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 고유식별번호
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN2" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 민감정보
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN3" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "UI_COMN_AGRM_YN1" , 0 , "0" )'수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "UI_COMN_AGRM_YN2" , 0 , "0" )'수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보

		'필수동의(제공 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "UI_COMN_AGRM_YN1" , 0 , "Y" )'제공_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "UI_COMN_AGRM_YN2" , 0 , "Y" )'제공_신용공여/미수/파생상품 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "UI_COMN_AGRM_YN1" , 0 , "0" )'제공_해외주식/해외파생/해외금융/EUREX 고유식별번호
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "UI_COMN_AGRM_YN2" , 0 , "0" )'제공_해외주식/해외파생/해외금융/EUREX 개인신용정보

		'필수동의(조회 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "PROS_CLS_CODE" , 0 ,"1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "UI_COMN_AGRM_YN1" , 0 , "Y" )'조회_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "UI_COMN_AGRM_YN2" , 0 , "Y" )'조회_신용공여/미수/파생상품 개인신용정보 
	
	
	elseif szTranID == "oblon_stmp_001r" then
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "ACNO" , 0 , Left(g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "ASNO" , 0 , Right(g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "UI_STPL_AMT1" , 0 , contAll.contScroll.edtAmt.caption )
	'LHR 수정
	elseif szTranID == "obacp_opop_065r" then
		DATAMANAGER.SetDataValue( 0,  "obacp_opop_065r", "InBlock1", "ACNO", 0 , Left(g_szAccount, 8))
	'LHR 수정 고객연락처
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , Left(g_szAccount,8))
	elseif szTranID == "obaci_acct_095r" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_095r", "InBlock1", "ACNO" , 0 , Left(g_szAccount,8))
	elseif szTranID == "obcsb_acad_120r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_120r", "InBlock1", "ACNO", 0 , Left(g_szAccount,8))
	elseif szTranID == "obacp_comm_007r" then
		DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNO" , 0 , Left(g_szAccount,8))
		DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNT_PWD" , 0 , "")
		DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "IQRY_CLS_CODE" , 0 , "9")
	elseif szTranID == "oblon_nice_001r" then
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "NICE_TR_CLCD" , 0 , "2P001")
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "ACNO" 		 , 0 , Left(g_szAccount,8))
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	Form.ShowAlert("DATAMANAGER_OnReceiveTranComplete", szTranID)

	if szTranID == "obrtp_drab_001r" then
		g_nPossibleAmount = CInt( DATAMANAGER.GetDataValue(0, "obrtp_drab_001r" , "OutBlock1" , "DRNG_ABLE_AMT" , 0) )

	elseif szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0, "obsap_acif_999a" , "OutBlock1" , "FNPR_JOIN_SRNO" , 0)
		
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		Form.OpenPopup("mbonl81010_p20" , "" , "")
		
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록

	elseif szTranID == "obcsb_acad_122a" then
		'LHR 수정
		DATAMANAGER.RequestTranData("obacp_opop_065r")
		
		'DATAMANAGER.SetEventFlag( "oblon_basc_801a", "A" )
		'DATAMANAGER.RequestTranData( "oblon_basc_801a" ) '약정등록
	elseif szTranID == "oblon_nice_001r" then
		tmpRSLT_CLS = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock1", "RSLT_CLS", 0)
		if tmpRSLT_CLS == "1" then
			g_NICE_TR_SRNO = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock2", "SDRC_SRNO", 0)
			g_Timer_TRY_CNT = 0
			
			'Form.addWaitCursor()
			Form.SetTimerEvent(1, 1, 1)
		elseif tmpRSLT_CLS == "0" or tmpRSLT_CLS == "3" then
			'Form.clearWaitCursor()
			Form.SetTimerEvent(1, 0, 1)
			
			if DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock3", "PROS_ABLE_YN", 0) == "Y" then
				if g_PROS_CLS = "2" then
					DATAMANAGER.SetEventFlag( "oblon_basc_801a", "A" )
					DATAMANAGER.RequestTranData( "oblon_basc_801a" ) '약정등록
				end if
			else
				Dim szErrMsg
				Dim szSub
				szErrMsg = chr(34)&"여신거래 안심차단"&chr(34)&" 서비스 이용 중이므로,"&chr(10)&"대출거래가 제한됩니다."
				szSub = DATAMANAGER.GetDataMsgSubText( szTranID)

				Form.ShowAlert("알림", szErrMsg)
			end if
		end if
	elseif szTranID == "oblon_basc_801a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if

		'LHR 수정
		'Form.MsgBox( "알림", sMsg, "", 6 )
		'LHR수정 처리 완료 후 비밀번호 초기화
		'완료화면 노출
		Dim szData
		' 신청계좌 약정금액 인지세 담보관련통보방법 계약서류통보방법 처리구분
		szData = left(g_szAccount,8).."★"..contAll.contScroll.edtAmt.caption.."★"..g_nAmt1.."★"..g_szButtonEmail.."★"..g_szButtonRadio2.."★"..g_szProsClsCode
		
		g_szFnprJoinSrno = ""
		g_FinCustomer = "N"
				
		Form.triggerEvent("#", "NextView", szData)
	
	' 개인신용정보동의
	elseif szTranID == "obaci_acct_255a" then
		g_szProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
		g_szProsSRNO =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
		
		'LHR 수정 비밀번호 무조건 입력
		g_szActPwd = ""
		if trim(g_szActPwd) == "" then
			Dim sValue
			sValue = g_szAccount.."☆2"
			Form.openPopupAnimation("pwdcheckpopup", sValue ,"","2")
		else
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증

			if trim(g_szFnprJoinSrno) == "" then
				DATAMANAGER.RequestTranData("obsap_acif_999a")
			else
				DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
			end if
		end if
		
	elseif szTranID == "oblon_stmp_001r" then
		g_nAmt1 = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_MNRC_AMT1" , 0 )) '납부인지세
		Dim nAmt2
		nAmt2 = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_TOTAL_STPL_AMT1" , 0 )) '기납부인지세
		Dim nAmt3
		nAmt3 = tonumber(g_nAmt1)+tonumber(nAmt2)
		'LHR 수정
'		if nAmt2 > 0 then
'			contAll.contScroll.lblAmtInfo.caption = "고객님이 납부하실 인지세는 "..FormatNumber(g_nAmt1,0).."원입니다.\n인지세: "..FormatNumber(nAmt3,0).."원 (기납부세액 : "..FormatNumber(nAmt2,0).."원)" 
'		else
