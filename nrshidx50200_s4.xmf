<ROOT>
	<MAP_INFO scrno="50200" scrname="ETF투자가이드_ETF란_지표" version="2" writer="함원규" />
	<FORM_INFO name="Form" ly_vert="0,0,375,880,1" />
	<CONTROL_INFO>
		<CONTAINER name="contMain" ly_vert="0,0,375,880,1" scroll_ly_vert="0,0,375,880,1" >
			<CONTROL_INFO>
				<LABEL name="lblTitle0" fgcolor="334:034034034" fontsize="2" fontstyle="01" caption="ETF 투자 시 꼭 알아야 할 핵심 투자지표!" paddinginfo="1,0,0,0" ly_vert="20,30,335,25,1" />
				<IMAGE name="imgIndex" autosize="1" imgpath="etf_img02" ly_vert="20,84,335,86,1" />
				<TABLE name="tblText" insidelinecolor="102:255255255" colcount="1" rowcount="40" outline="0000" designorder="1" ly_vert="20,192,340,672,1" >
					<COL_INFO ly_vert_width="340" />
					<ROW_INFO ly_vert_height="18,5,18,18,18,25,18,5,18,18,25,18,5,18,18,25,18,5,18,25,18,5,18,18,25,18,5,18,25,18,5,18,18,18,25,18,5,18,18,25" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="334:034034034" halign="0" line="0,0" caption="기초지수" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="321:115118124" halign="0" line="0,0" caption="ETF가 추종하는 지수입니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="321:115118124" halign="0" line="0,0" caption="대표적인 기초지수로 코스피200지수, 코스닥150지수, " fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="321:115118124" halign="0" line="0,0" caption="<![CDATA[S&P500 지수 등이 있습니다.]]>" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="334:034034034" halign="0" line="0,0" caption="NAV(순자산가치)" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="321:115118124" halign="0" line="0,0" caption="ETF의 자산에서 부채 및 관련 비용을 공제하여 산출한 ETF" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="321:115118124" halign="0" line="0,0" caption="의 이론적 가치이며, ETF의 순자산 가치를 의미합니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,10,0,10" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,11,0,11" fgcolor="334:034034034" halign="0" line="0,0" caption="iNAV(실시간 추정 자산가치)" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,12,0,12" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,13,0,13" fgcolor="321:115118124" halign="0" line="0,0" caption="ETF 구성종목(PDF)를 이용해서 거래소에서 10초 단위로" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,14,0,14" fgcolor="321:115118124" halign="0" line="0,0" caption="제공해주고, ETF 매매 시 기준이 되는 가격입니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,15,0,15" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,16,0,16" fgcolor="334:034034034" halign="0" line="0,0" caption="시장가격" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,17,0,17" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,18,0,18" fgcolor="321:115118124" halign="0" line="0,0" caption="거래소에서 실시간으로 거래되는 ETF의 가격입니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,19,0,19" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,20,0,20" fgcolor="334:034034034" halign="0" line="0,0" caption="추적오차" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,21,0,21" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,22,0,22" fgcolor="321:115118124" halign="0" line="0,0" caption="기초지수와 NAV와의 수익률 차이이며, ETF의 NAV가 추종" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,23,0,23" fgcolor="321:115118124" halign="0" line="0,0" caption="하는 기초지수를 잘 따라가고 있는지를 보여주는 지표입니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,24,0,24" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,25,0,25" fgcolor="334:034034034" halign="0" line="0,0" caption="괴리율" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,26,0,26" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,27,0,27" fgcolor="321:115118124" halign="0" line="0,0" caption="시장가격과 NAV간의 격차를 괴리율이라고 합니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,28,0,28" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,29,0,29" fgcolor="334:034034034" halign="0" line="0,0" caption="LP(Liquidity Provider)" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,30,0,30" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,31,0,31" fgcolor="321:115118124" halign="0" line="0,0" caption="유동성 공급자를 의미하며 증권사가 그 역할을 담당합니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,32,0,32" fgcolor="321:115118124" halign="0" line="0,0" caption="투자자가 ETF를 원활하게 거래할 수 있도록 호가를 제시" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,33,0,33" fgcolor="321:115118124" halign="0" line="0,0" caption="합니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,34,0,34" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,35,0,35" fgcolor="334:034034034" halign="0" line="0,0" caption="PDF(Protfolio Deposit File)" fontstyle="01" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,36,0,36" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,37,0,37" fgcolor="321:115118124" halign="0" line="0,0" caption="ETF가 담고있는 투자종목정보입니다. ETF의 자산 내역을" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,38,0,38" fgcolor="321:115118124" halign="0" line="0,0" caption="매달 확인할 수 있습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,39,0,39" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
					</CELL_INFO>
				</TABLE>
			</CONTROL_INFO>
		</CONTAINER>
