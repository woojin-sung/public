'============================================================================
' 01. 화 면 명 : 빠른이체 선택 팝업
' 02. 화면설명 : 이체_빠른이체 조회 및 관리 화면 
' 03. 작    성 : 2016.02.17 ~ 2016.   테스트3
' 04. 수    정 : v001 장원혁 실명확인번호 평문 메모리 제거
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szAccountNumber	'출금계좌번호 (8)
Dim g_szAccountSerial	'출금계좌일련번호 (2)
'Dim g_szUserJumin		'실명확인번호(주민번호) v001 주석처리
Dim g_szUserNum			'고객번호
Dim g_szIRow			'선택된 행의 인덱스
Dim g_nFlag             '선택/관리 구분값
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
    if szTranID == "obacp_opop_064r" then
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obacp_opop_064r")
		
	elseif szTranID == "obtss_elbs_200r" then '조회TR
'        DATAMANAGER.SetDataValue(0,	"obtss_elbs_200r", "InBlock1", "CSNO" , 0 , g_szUserNum)
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200r", "InBlock1", "ASNO" , 0 , g_szAccountSerial)	
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200r", "InBlock1", "CANC_YN", 0 , "N" ) '계좌해지여부
		DATAMANAGER.RequestTranData("obtss_elbs_200r")
	
	
	elseif szTranID == "obtss_elbs_200a" then '삭제TR
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "CSNO" , 0 , g_szUserNum)	'고객번호
		
		Dim szTempSerial, szTempBankCode, szTempAcno, szTempAccName, szTempUserName, szTempBankName
		szTempSerial = Grid0.GetCellData( "bd_cell2", g_szIRow )	'일련번호
		szTempBankCode = Grid0.GetCellData( "bd_cell8", g_szIRow )	'은행코드
		szTempAcno = Grid0.GetCellData( "bd_cell9", g_szIRow )			
		szTempAccName = Grid0.GetCellData( "bd_cell1", g_szIRow )   '빠른이체명
		szTempUserName = Grid0.GetCellData( "bd_cell6", g_szIRow )
''''''''		
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "REG_SRNO", 0 , szTempSerial)	'일련번호	
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ACNO", 0 , Left(szTempAcno, 8))	'계좌번호(8)
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ASNO", 0 , Right(szTempAcno, 2))	''계좌번호(2)
'		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "RMT_NAME", 0,   szTempUserName)
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "FAST_TACT_NAME", 0 , szTempAccName)	'빠른이체명
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "PROS_CLS_CODE" , 0 , "D")	'등록삭제여부		
		DATAMANAGER.RequestTranData("obtss_elbs_200a")
	
	
	
	elseif szTranID == "obtss_elbs_200u" then '변경TR
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200u", "InBlock1", "CSNO" , 0 , g_szUserNum)	'고객번호
'		Form.ShowAlert("usernum", g_szUserNum)
'		Dim szSrnoCount
'		szStarSrno = DATAMANAGER.GetDataValue(0, "obtss_elbs_200r", "OutBlock1", "REG_SRNO" , 0)
'		szSrnoCount = DATAMANAGER.GetDataCount(0, "obtss_elbs_200r", "OutBlock1")-1
		
'		szFinSrno = DATAMANAGER.GetDataValue(0, "obtss_elbs_200r", "OutBlock1", "REG_SRNO" , szSrnoCount)
		
		
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200u", "InBlock1", "PROS_CSNU" , 0 , Grid0.rowcount)	'처리건수

'		Dim arrCnt 
'		arrCnt = 0
		for i=0 to Grid0.rowcount-1
			
			DATAMANAGER.SetDataValue(0, "obtss_elbs_200u", "InBlock2", "DRNG_ACNO" , i , Left(Grid0.GetCellData( "bd_cell9", i ), 8))
			DATAMANAGER.SetDataValue(0,  "obtss_elbs_200u", "InBlock2", "DRNG_ASNO", i , Right(Grid0.GetCellData( "bd_cell9", i ), 2))
			DATAMANAGER.SetDataValue(0, "obtss_elbs_200u", "InBlock2", "REG_SRNO" , i , Grid0.GetCellData( "bd_cell2", i ))
'			DATAMANAGER.SetDataValue(0,  "obtss_elbs_200u", "InBlock2", "ACNO", i , Grid0.GetCellData( "bd_cell12", i ))
'			arrCnt = arrCnt  +1		
		next
	 
		DATAMANAGER.RequestTranData("obtss_elbs_200u")
	end if
End Function 

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Grid0.rowmove = "1"
	g_nFlag = 0
	g_szIRow = ""
	'////// 이체화면에서 출금계좌번호 넘어올 경우와 기존 계좌번호를 사용할 경우 분기처리를 해야함 /////////
    Dim szSharedAccount
	szSharedAccount = Form.GetOpenLinkData()
'	Form.ShowAlert("빠른이체", szSharedAccount)
	g_szAccountNumber = Left( szSharedAccount,8)
	g_szAccountSerial = Right(szSharedAccount,2)
	' g_szUserJumin = "" v001 주석처리
	g_szUserNum = ""
	
	btnSearch_OnClick()
	
End Sub

'주민번호,일련번호,은행명,계좌번호, 수취인계좌명, 계좌별칭, 은행코드, 사용여부
'============================================================================
' btnEnroll_OnClick - 등록하기 
'============================================================================
Sub btnEnroll_OnClick()
	
	'enroll, 주민번호,일련번호,은행명,계쫘번호, 수취인계좌명, 계좌별칭, 은행코드, 사용여부
	Dim szTempData
	szTempData = g_szAccountNumber & g_szAccountSerial '"enroll★주민번호★일련번호★은행명★계좌번호★수취인계좌명★계좌별칭★은행코드★사용여부"
'    Form.ShowAlert("acc", g_szAccountNumber & g_szAccountSerial)
	Form.OpenFramePopup("mbbnk61010_p7" , szTempData, sPosInfo)
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obacp_opop_064r" then	'종합계좌기준계좌
		'if DATAMANAGER.GetDataValue(0,  "obacp_opop_064r", "OutBlock1", "RCNO", 0) <> g_szUserJumin then v001 주석처리
			'g_szUserJumin = DATAMANAGER.GetDataValue(0,  "obacp_opop_064r", "OutBlock1", "RCNO", 0)	'실명확인번호(주민번호)
		'end if
		g_szUserNum = DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO", 0)	'고객번호
		
		TR_Inquiry("obtss_elbs_200r")		' 조회		
	
	
	
	elseif szTranID == "obtss_elbs_200r" then
		for i=0 to DATAMANAGER.GetDataCount(0, "obtss_elbs_200r", "OutBlock1")-1
		    szCode = DATAMANAGER.GetDataValue(0, "obtss_elbs_200r", "OutBlock1", "MNRC_BANK_CODE" , i)
		    szAcno = DATAMANAGER.GetDataValue(0, "obtss_elbs_200r", "OutBlock1", "DRNG_ACNO", i)
		    szAsno = DATAMANAGER.GetDataValue(0, "obtss_elbs_200r", "OutBlock1", "DRNG_ASNO", i)
			Dim szTempName
			if szCode== "" or  szCode== "287" then
				
				Grid0.SetCellData( "bd_cell7", i, "메리츠증권" )	
			else 
			    szTempName = Form.Form.GetMetaData( "은행코드", szCode )'은행명
			    Grid0.SetCellData( "bd_cell7", i, szTempName )
			end if	
				'Grid0.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, "obtss_elbs_200r", "OutBlock1", "" , i) )	'상대계좌명
				
			Grid0.SetCellData( "bd_cell9", i, szAcno & szAsno)	'계좌번호	
			Grid0.SetCellFgColor( "bd_cell15", i, "10" )
			Grid0.SetCellData( "bd_cell13", i, "이체금액" )
			
		next		
	end if
	
	 
	if szTranID == "obtss_elbs_200a" then
		Form.MsgBox("알림", "삭제 완료되었습니다.", "", 0)
		btnSearch_OnClick()	'재조회
	end if
	
	
	if szTranID == "obtss_elbs_200u" then
	    szNO = DATAMANAGER.GetDataValue(0, "obtss_elbs_200u", "OutBlock1", "PROS_CSNU", 0)
'		Form.MsgBox("알림", " '" &CInt(szNO)&"'건의  순서가 변경되었습니다.", "", 0)
		btnSearch_OnClick()	'재조회
	end if
End Sub


'============================================================================
' btnSearch_OnClick - 조회
'============================================================================
Sub btnSearch_OnClick()
	g_szIRow = ""
	g_nFlag = 0
	TR_Inquiry("obacp_opop_064r")
End Sub


'============================================================================
' Grid0_OnClickUp 
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	
	
	if szCellID == "bd_cell0" then	'삭제 버튼 클릭
	    g_szIRow = lRow
		Form.MsgBox("알림", "삭제하시겠습니까?", "deleteokcancel", 1)
	end if
	
'	if szCellID == "" then	'수정 버튼 클릭
		'modify, 주민번호,일련번호,은행명,계좌번호, 수취인계좌명, 계좌별칭, 은행코드, 사용여부
'		Dim szSendJumin, szSendSerial, szSendBankName, szSendAcno, szSendAccName, szSendUserName, szSendBankCode, szSendRnDel
'		szSendJumin = g_szUserJumin
'		szSendSerial = Grid0.GetCellData( "bd_cell5", g_szIRow )
'		szSendBankName = Grid0.GetCellData( "bd_cell1", g_szIRow )
'		szSendAcno = Grid0.GetCellData( "bd_cell6", g_szIRow )
'		szSendAccName = Grid0.GetCellData( "bd_cell2", g_szIRow )
'		szSendUserName = Grid0.GetCellData( "bd_cell7", g_szIRow )
'		szSendBankCode = Grid0.GetCellData( "bd_cell9", g_szIRow )
'		szSendRnDel = "Y"
'		Dim szTempData
'		szTempData = "modify★"& szSendJumin & "★" & szSendSerial & "★" & szSendBankName & "★" & szSendAcno & "★" & szSendAccName & "★" & szSendUserName & "★" & szSendBankCode & "★" & szSendRnDel
'		Form.OpenPopup("mbbnk61010_p7" , szTempData, sPosInfo)
'	end if
	if szCellID <> "bd_cell0" and szCellID <> "bd_cell29" then	'삭제 버튼 클릭
	    if g_nFlag <> 1 then
	       Dim szData
	       Dim szAcnt
	       Dim szTempData
		   szTempData = g_szAccountNumber & g_szAccountSerial 
	       szAcnt = Grid0.GetCellData( "bd_cell9", lRow )
	       If szTempData <> szAcnt then
		  g_szIRow = lRow
		  Form.MsgBox("알림", "현재 이체화면과 다른 계좌의 빠른이체를 선택하셨습니다. 이전이체화면의 이체예정내역은 취소됩니다. 그래도 진행하시겠습니까?" , "newacc", 1)
		   Else
		   szData = "Q" & "|" & Grid0.GetCellData( "bd_cell9", lRow ) '출금계좌
		   szData = szData & "|" & Grid0.GetCellData( "bd_cell18", lRow) '입금기관코드
		       szData = szData & "|" & Grid0.GetCellData( "bd_cell7", lRow ) '입금기관
		       szData = szData & "|" & Grid0.GetCellData( "bd_cell6", lRow ) '입금인명
		       szData = szData & "|" & Grid0.GetCellData( "bd_cell15", lRow ) '이체금액  
		       szData = szData & "|" & Grid0.GetCellData( "bd_cell10", lRow )'입금계좌
		       szData = szData & "|" & Grid0.GetCellData( "bd_cell30", lRow )'내표시
		       szData = szData & "|" & Grid0.GetCellData( "bd_cell31", lRow )'상대표시
		       Form.SendReturnToParent("QUICK" , szData)
	       'Form.ShowAlert("QUICK", szData)
		       Form.CloseForm()
	       End If
	    end if   
	end if
	
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	if sKeyName == "deleteokcancel" then
		if sRet == "ok" then	'삭제 후 재조회			
				TR_Inquiry("obtss_elbs_200a")
		end if
	elseif sKeyName == "editokcancel" then
		if sRet == "ok" then				
				TR_Inquiry("obtss_elbs_200u")
		end if
		'Grid0.SetVisibleCol( 4, True )
        'Grid0.SetVisibleCol( 3, False )
	    'Grid0.rowmove = "0"
	    g_nFalg = 0
	    'btnEdit.enable = False
        'btnEdit.visible = False
	    btnEnroll.enable = True
	elseif sKeyName == "newacc" then
	    if sRet == "ok" then
	       szData = "Q" & "|" & Grid0.GetCellData( "bd_cell9", g_szIRow ) '출금계좌
           szData = szData & "|" & Grid0.GetCellData( "bd_cell18", g_szIRow) '입금기관코드
	       szData = szData & "|" & Grid0.GetCellData( "bd_cell7", g_szIRow ) '입금기관
	       szData = szData & "|" & Grid0.GetCellData( "bd_cell6", g_szIRow ) '입금인명
	       szData = szData & "|" & Grid0.GetCellData( "bd_cell15", g_szIRow ) '이체금액  
	       szData = szData & "|" & Grid0.GetCellData( "bd_cell10", g_szIRow )'입금계좌
	       szData = szData & "|" & Grid0.GetCellData( "bd_cell30", g_szIRow )'내표시
	       szData = szData & "|" & Grid0.GetCellData( "bd_cell31", g_szIRow )'상대표시
	       Form.SendReturnToParent("QUICK" , szData)      
	       Form.CloseForm()
	    end if   
	end if
	
End Sub


'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "등록" then
		if sRet == "ok" then
			btnSearch_OnClick()
'            Form.CloseForm()
		end if
	end if
End Sub


