'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array


'[Page1]
'g_szList(0)   : 계좌번호
'g_szList(1)   : 계좌일련번호
'g_szList(2)   : 비밀번호
'g_szList(3)   : 고객번호
'g_szList(4)   : 가입자유형 코드
'g_szList(5)   : 가입자유형 한글명
'g_szList(6)   : 연령
'g_szList(7)   : 동영상시청 날짜
'g_szList(8)   : 동영상시청 시각
'g_szList(9)   : 소득증명발급번호
'g_szList(10)  : 소득확인증명서번호
'g_szList(11)  : 자택주소
'g_szList(12)  : 회사주소
'g_szList(13)  : 연락처
'g_szList(14)  : 이메일주소
'g_szList(15)  : 서류제출방법 코드
'g_szList(16)  : 서류제출방법 한글명
'g_szList(17)  : 최소가입금액
'g_szList(18)  : buffer
'g_szList(19)  : buffer

'[Page2]
'g_szList(20)  : 투자성향 한글명
'g_szList(21)  : 상품(MP) 코드
'g_szList(22)  : 상품(MP) 한글명
'g_szList(23)  : buffer
'g_szList(24)  : buffer
'g_szList(25)  : 은행연합회 한도
'g_szList(26)  : ISA계약권유문서 클릭 시각
'g_szList(27)  : 개인종합자산관리계좌(일임형)약관 클릭 시각
'g_szList(28)  : MP설명서 클릭 시각
'g_szList(29)  : 투자성향진단 등급
'g_szList(30)  : buffer
'g_szList(31)  : buffer
'g_szList(32)  : buffer
'g_szList(33)  : buffer
'g_szList(34)  : buffer
'g_szList(35)  : buffer
'g_szList(36)  : buffer
'g_szList(37)  : buffer
'g_szList(38)  : buffer
'g_szList(39)  : buffer


Dim g_sClickTime		'계약자확인사항 클릭 시각
g_sClickTime = ""

Dim g_sInputText		'계약자확인사항 작성중 화면 닫았다가 다시 열었을때 기존 작성 내용 유지되도록 입력내용 저장
g_sInputText = "★★★★★★★"

Dim g_cmbKey1			'연락처 변경 클릭시 보고서 발송처 선택값 저장 후 콤보 재셋팅시 기존 선택값 유지
Dim g_cmbKey3			'연락처 변경 클릭시 계약서 수령방법 선택값 저장 후 콤보 재셋팅시 기존 선택값 유지


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub SetTableData()
	cont0.tbl0.SetCellString( 0, 1, g_szList(25))		'미사용한도
	cont0.tbl0.SetCellString( 8, 1, g_szList(11))		'자택주소
	cont0.tbl0.SetCellString( 9, 1, g_szList(12))		'직장주소
	cont0.tbl0.SetCellString( 10, 1, g_szList(13))	'연락처
	cont0.tbl0.SetCellString( 11, 1, g_szList(14))	'email
	
	'보고서발송처 : 연락처가 존재하는 항목만 콤보에 셋팅
	If g_szList(11) <> "" then
		cont0.cmb1.cbadddatatext = "01`자택"
	End If
	
	If g_szList(12) <> "" then
		cont0.cmb1.cbadddatatext = "02`직장"
	End If
	
	If g_szList(14) <> "" then
		cont0.cmb1.cbadddatatext = "21`Email"
	End If

	'계약서수령방법 : 연락처가 존재하는 항목만 콤보에 셋팅
	If g_szList(11) <> "" then
		cont0.cmb3.cbadddatatext = "02`자택"
	End If
	
	If g_szList(12) <> "" then
		cont0.cmb3.cbadddatatext = "03`직장"
	End If
	
	'증권약정계좌 중 ISA 계좌와 앞 8자리가 같은 계좌로 디폴트 셋팅(자동매도 : 종합매매, CMA)
	For i = 0 to cont0.acnt0.accountcount-1
		cont0.acnt0.currentindex = i
		If (cont0.acnt0.itemcodetype == "100" or cont0.acnt0.itemcodetype == "118") and cont0.acnt0.total == g_szList(0) then
			Exit For
		End If
	Next

	'증권약정계좌 중 ISA 계좌와 앞 8자리가 같은 계좌로 디폴트 셋팅(지정매도 : 종합매매)
	For i = 0 to cont0.acnt1.accountcount-1
		cont0.acnt1.currentindex = i
		If cont0.acnt1.itemcodetype == "100" and cont0.acnt1.total == g_szList(0) then
			Exit For
		End If
	Next
End Sub

'============================================================================
'연락처 변경시 연락처 정보 및 보고서발송처/계약서수령방법 콤보 재셋팅
Sub ResetAddrInfo(szTranID)
	sHomeAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_ADDR" , 0)	'자택주소
	sCoAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CO_ADDR" , 0)		'회사주소
	sTel = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CNPL_TELNO" , 0)		'연락처
	sEMail = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "EMAIL_ADDR" , 0)	'이메일주소
	
	cont0.tbl0.SetCellString( 8, 1, sHomeAddr)		'자택주소
	cont0.tbl0.SetCellString( 9, 1, sCoAddr)		'직장주소
	cont0.tbl0.SetCellString( 10, 1, sTel)	'연락처
	cont0.tbl0.SetCellString( 11, 1, sEMail)	'email
	
	'보고서발송처 : 연락처가 존재하는 항목만 콤보에 셋팅
	cont0.cmb1.clear = 1
	If sHomeAddr <> "" then
		cont0.cmb1.cbadddatatext = "01`자택"
	End If
	
	If sCoAddr <> "" then
		cont0.cmb1.cbadddatatext = "02`직장"
	End If
	
	If sEMail <> "" then
		cont0.cmb1.cbadddatatext = "21`Email"
	End If
	
	cont0.cmb1.cbkeydata = g_cmbKey1
	
	'계약서수령방법 : 연락처가 존재하는 항목만 콤보에 셋팅
	cont0.cmb3.clear = 1
	cont0.cmb3.cbadddatatext = "01`온라인"
	
	If sHomeAddr <> "" then
		cont0.cmb3.cbadddatatext = "02`자택"
	End If
	
	If sCoAddr <> "" then
		cont0.cmb3.cbadddatatext = "03`직장"
	End If
	
	cont0.cmb3.cbkeydata = g_cmbKey3
End Sub

'============================================================================
Function ValidateCheck()
	If cont0.edtAmt.caption == "" then
		Form.ShowAlert("알림", "계약금액을 입력해주세요.")
		return False
	End If

	If CDbl(cont0.edtAmt.caption) <  CDbl(g_szList(17)) then
		Form.ShowAlert("알림", "최소가입금액은 " & CDbl(g_szList(17)) & "원 입니다.")
		return False
	End If
	
	If CDbl(cont0.edtAmt.caption) >  CDbl(cont0.tbl0.GetCellString( 0 , 1 )) then
		Form.ShowAlert("알림", "계약금액은 미사용한도 금액 이내로 가능합니다.")
		return False
	End If
	
	'선택사항으로 변경
'	If cont0.edt0.caption == "" then
'		Form.ShowAlert("알림", "목표수익률을 입력해주세요.")
'		return False
'	End If
'	
'	If cont0.edt1.caption == "" then
'		Form.ShowAlert("알림", "손절수익률을 입력해주세요.")
'		return False
'	End If
'	
'	If CDbl(cont0.edt0.caption) <= 0 then
'		Form.ShowAlert("알림", "목표수익률을 입력해주세요.")
'		return False
'	End If
'	
'	If CDbl(cont0.edt1.caption) <= 0 then
'		Form.ShowAlert("알림", "손절수익률을 입력해주세요.")
'		return False
'	End If
	
	If cont0.cmb1.cbkeydata == "" then
		Form.ShowAlert("알림", "보고서발송처가 존재하지 않습니다.")
		return False
	End If

	If cont0.chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "계약자 확인사항을 입력해주세요.")
		return False
	End If
	
	return True
End Function

'============================================================================
Sub MoveNextPage()
	Dim sSendData
	
	'추후 유지보수 중 항목 추가 발생할 경우에 대비, 각 화면마다 array 20개씩 잡아놓음
	sSendData = g_sSendData & cont0.edtAMt.caption & "★"
	sSendData = sSendData & cont0.cmb0.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb0.caption & "★"
	
	If cont0.cmb0.currentindex == "0" then
		sSendData = sSendData & cont0.acnt0.total & "★"
		sSendData = sSendData & cont0.acnt0.sequence & "★"
	Else
		sSendData = sSendData & cont0.acnt1.caption & "★"
		sSendData = sSendData & cont0.acnt1.sequence & "★"
	End If
	
	sSendData = sSendData & cont0.cmb1.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb1.caption & "★"
	sSendData = sSendData & cont0.cmb2.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb2.caption & "★"
	sSendData = sSendData & cont0.cmb4.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb4.caption & "★"
	
	sSendData = sSendData & cont0.edt0.caption & "★"
	sSendData = sSendData & cont0.edt1.caption & "★"
	sSendData = sSendData & g_sClickTime & "★"
	sSendData = sSendData & cont0.cmb3.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb3.caption & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	
	Form.OpenFramePopup( "mbisa56060_p3" , sSendData , sPosInfo)
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("가입신청")
	
	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	Call SetTableData()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'계약자확인사항
	If sKeyName == "mbisa56060_p8" then
		Dim szText
		
		g_sInputText = sRet
		szText = Split(sRet,"★")	
		
		if UBOUND(szText) < 1 then
			cont0.chk1.checkstate = "0"
			Exit Sub
		End if
		
		If szText(0) == "ok" then
			cont0.chk1.checkstate = "1"
			g_sClickTime = Form.GetSharedData("&HOST_TIME", True )
		Else
			cont0.chk1.checkstate = "0"
		End If
	End If
	
	If sKeyName == "mbisa56060_p3" then
		If sRet == "ok" then
			Form.SendReturnToParent( "mbisa56060_p2" , "ok" )
			Form.CloseForm()
		End If
	End If
	
	'연락처 변경시 연락처 정보 및 보고서발송처/계약서수령방법 콤보 재셋팅
	If sKeyName == "mbonl81000" then
		g_cmbKey1 = cont0.cmb1.cbkeydata
		g_cmbKey3 = cont0.cmb3.cbkeydata
		DATAMANAGER.RequestTranData( "obwat_ctad_023r" )	'랩계약조회
	End If
End Sub

'============================================================================
'만기처리방법에 따른 증권약정계좌 컨트롤 조회
'자동매도 : 종합매매, CMA
'지정매도 : 종합매매
Sub cont0_cmb0_OnEditComplete(iIndex)
	If iIndex == "0" then	'자동매도
		cont0.acnt0.visible = True
		cont0.acnt1.visible = False
	Else					'지정매도
		cont0.acnt0.visible = False
		cont0.acnt1.visible = True
	End If
End Sub

'============================================================================
'계약자확인사항
Sub cont0_chk1_OnChange(sCheckState)
	If sCheckState == "1" then
		Call cont0_btnDetail1_OnClick()
	End If
End Sub

'============================================================================
'계약자확인사항_내용보기
Sub cont0_btnDetail1_OnClick()
	Form.OpenFramePopup( "mbisa56060_p8" , g_szList(0) & g_szList(1) & "★" & g_szList(21) & "★" & g_szList(22) & "★" & g_szList(20) & "★" & g_sInputText , "")
End Sub

'============================================================================
'취소 버튼
Sub cont0_btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'다음 버튼
Sub cont0_btnOK_OnClick()
	If ValidateCheck() == False then
		Exit Sub
	End If

	Call MoveNextPage()
End Sub

'============================================================================
Sub cont0_acnt0_ChangeAccount()
	If cont0.acnt0.total == g_szList(0) then
		Exit Sub
	End If
	
	Form.ShowAlert("알림", "선택하신 계좌는 증권약정계좌로 사용 불가합니다.")
	
	'증권약정계좌 중 ISA 계좌와 앞 8자리가 같은 계좌로 디폴트 셋팅(자동매도 : 종합매매, CMA)
	For i = 0 to cont0.acnt0.accountcount-1
		cont0.acnt0.currentindex = i
		If (cont0.acnt0.itemcodetype == "100" or cont0.acnt0.itemcodetype == "118") and cont0.acnt0.total == g_szList(0) then
			Exit For
		End If
	Next
End Sub

'============================================================================
Sub cont0_acnt1_ChangeAccount()
	If cont0.acnt1.total == g_szList(0) then
		Exit Sub
	End If
	
	Form.ShowAlert("알림", "선택하신 계좌는 증권약정계좌로 사용 불가합니다.")
	
	'증권약정계좌 중 ISA 계좌와 앞 8자리가 같은 계좌로 디폴트 셋팅(지정매도 : 종합매매)
	For i = 0 to cont0.acnt1.accountcount-1
		cont0.acnt1.currentindex = i
		If cont0.acnt1.itemcodetype == "100" and cont0.acnt1.total == g_szList(0) then
			Exit For
		End If
	Next
End Sub

'============================================================================
'연락처 변경
Sub cont0_btnNumber_OnClick()
	'Form.OpenScreen("81000" , "")
	Form.OpenFramePopup( "mbonl81000" , "" , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctad_023r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_INDV_MGRI_ASNO" , 0 , g_szList(1))
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD" , 0 , g_szList(2))
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_ctad_023r" then	
		Call ResetAddrInfo(szTranID)	'연락처 변경시 연락처 정보 및 보고서발송처/계약서수령방법 콤보 재셋팅
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub
