	<SCRIPT_INFO _len="5803" _ulen="5251" >
'20201126 SWJ START : 공인인증서 '공인'글자 삭제
'20230626 양현정 : V001 : 매핑수정...
'============================================================================

Dim gFlag 	'20160923_01 LKM 
Dim gOSType   'V001

'============================================================================
Sub Form_OnFormInit()
	gFlag = "CLOSE"	'기본값은 닫기
	
	gOSType = Form.GetSharedData("&OS_TYPE", false) 'V001
End Sub
'============================================================================

'============================================================================
Sub Image0_OnClick()
	Dim sText
	sText = "인증서 발급/재발급 업무를 중단하시겠습니까?"
	Form.MsgBox( "알림", sText, "CLOSE_MSG", 1 )
End Sub
'============================================================================

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'닫기
	if sKeyName == "CLOSE_MSG" Then 
		if sRet == "ok" Then 
			Form.CloseForm()	
		end if
	
	'약정-동의
	elseif sKeyName == "MSG_AgreeY" then
		if sRet == "close" then
			Form.CloseForm()
		end if
	'약정-미동의
	elseif 	sKeyName == "MSG_AgreeN" then
		if sRet == "close" then
			Form.CloseForm()
		end if	
	end if

End Sub
'============================================================================

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mhetc90060_p13" , gFlag)
End Sub	
'============================================================================
' 등록
'============================================================================
Sub BtnOK_OnClick()
	
	if RadioGroup0.currentindex == "0" then '동의
		DATAMANAGER.RequestTranData( "obpds_srvc_173a" )
	
	elseif RadioGroup0.currentindex == "1" then '미동의
		Form.OpenPopup("mhetc90060_p12","","")
	else
		Form.ShowAlert("안내", "동의 여부를 선택하시기 바랍니다.")
	end if
	
End Sub
'============================================================================
'팝업창 리턴 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 발급불가 팝업창 
	if sKeyName == "mhetc90060_p12" Then
		if sRet == "1" Then 
			DATAMANAGER.RequestTranData( "obpds_srvc_173a" )
		end if
	end if
End Sub
'============================================================================
' 데이터 처리전 SET
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNO, sACNO_PWD, sUserID, sAgreeYN
	
	sACNO 	 = Form.GetSharedData("CERT_ACNO" , 		false)
	sACNO_PWD = Form.GetSharedData("CERT_ACNT_PWD" ,  false)
	sUserID 	 = Form.GetSharedData("CERT_ID" , 		false)
	
	'인증서 발급시 사전동의 약정 처리 
	if szTranID == "obpds_srvc_173a" then
	
		if RadioGroup0.currentindex == "0" then 		'동의
			sAgreeYN = "Y"
		elseif RadioGroup0.currentindex == "1" then 	'미동의
			sAgreeYN = "N"
		end if
	
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "PROS_CLS_CODE", 			0 , "I" )		'처리구분코드
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "SVCD" , 				0 , "073" )		'서비스코드 
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "SVC_MANG_UNIT_CODE" , 	0 , "01" )		'서비스관리단위코드
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "ACNO", 					0 , sACNO)		'계좌번호
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "ACNT_PWD", 				0 , sACNO_PWD)	'계좌비번
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "AGRM_YN", 				0 , sAgreeYN)		'동의여부
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173a", "InBlock1", "ELFN_ID", 				0 , sUserID)		'ID
		DATAMANAGER.SetDataValue (0, "obpds_srvc_173a", "InBlock1", "CONT_CLS_CODE" , 		0 , "4")			'접촉구분코드
		'DATAMANAGER.SetDataValue (0, "obpds_srvc_173a", "InBlock1", "CHAN_TYPE_CLS_CODE", 	0 , "060")		'채널유형구분코드	
		'V001
		if gOSType == "1" then
			DATAMANAGER.SetDataValue (0, "obpds_srvc_173a", "InBlock1", "CHAN_TYPE_CLS_CODE", 	0 , "157")
		else
			DATAMANAGER.SetDataValue (0, "obpds_srvc_173a", "InBlock1", "CHAN_TYPE_CLS_CODE", 	0 , "156")
		end if
		
	
	end if
	
End Sub


'============================================================================
' 데이터 처리 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'인증서 발급시 사전동의 약정 처리 
	if szTranID == "obpds_srvc_173a" then
		
		Dim sText
		
		if RadioGroup0.currentindex == "0" then 			'동의
			sText = "인증서 발급시 온라인 신원확인 사전동의 '동의' 처리가 완료되었습니다."
			gFlag = "AgreeY"
			Form.MsgBox("알림",sText , "MSG_AgreeY", 0)
			
		elseif RadioGroup0.currentindex == "1" then 		'미동의
			sText = "인증서 발급시 온라인 신원확인 사전동의 '미동의' 처리가 완료되었습니다.\n"..
					"인증서 발급/재발급 업무를 중단합니다."
					
			Form.MsgBox("알림", sText, "MSG_AgreeN", 0)
		end if
		
	end if
		
End Sub

'============================================================================
' 데이터 처리 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obpds_srvc_173a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if	
	
End Sub

	</SCRIPT_INFO>
