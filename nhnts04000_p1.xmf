'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szInputFile	'읽어들일세팅파일
dim g_szFileName	'시장항목세팅파일
dim g_szKeys		'키값		
dim g_szValues		'읽어들인세팅값
dim g_szNames 		'한글로 출력할 이름
'g_szKeys=Array(	"41000P2_TILE", "41000P2_TILE6ROW" , "41000P2_INVR", "41000P2_PROG", "41000P2_CHNG", 
'			"41000P2_PROD", "41000P2_RATE") 				'7개	
g_szKeys		=	Array(	"04000P2_TILE6ROW", "04000P2_GLOB"	)	'20200331 HWG : 고유MTS

'g_szNames=Array( "지수타일",  "지수타일2줄", "투자자별매매동향", "프로그램매매동향", "환율", 
'			 "상품", "금리")									'7개
 g_szNames=Array( "지수타일2줄",  "주요종목")	'20200331 HWG : 고유MTS
				
				
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들임
'============================================================================
Function LoadSettings()
	dim szVal

	g_szValues = Array()
	
	For i = 0 to UBound(g_szKeys)
		szVal = Form.LoadConfigData(g_szInputFile, g_szKeys(i))
'		Form.ShowAlert("output",g_szKeys(i) & "=" & szVal & ",," & i)
		g_szValues(i) = szVal
	Next
	
	'TEST 출력용 
'	For j = 0 to UBound(g_szKeys)
'		Form.ShowAlert("output22",g_szKeys(j) & "=" & g_szValues(j)  & ",," & j )
'	Next
	
End Function


'============================================================================
'ShowSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function ShowSettings()
	dim nGridIdx
	dim szOutputData
	
	nGridIdx = 0 
	call LoadSettings()
	
	grdMain00.SetClear()
	grdMain00.rowcount = 1
	
	for i = 0 to UBound(g_szKeys) 
		szOutputData = g_szValues (i)
		
		if szOutputData = "1" then
			'grdMain00.SetCellData("bd_cell0", nGridIdx, "DEL")
			grdMain00.SetCellData("bd_cell1", nGridIdx, g_szNames(i))
			grdMain00.SetCellData("bd_cell3", nGridIdx, g_szKeys(i))
			grdMain00.SetCellData("bd_cell5", nGridIdx, g_szValues(i))
			nGridIdx = nGridIdx + 1
			grdMain00.AddRow()
		end if 
	next 
	
	grdMain00.SetDeleteRow(nGridIdx)
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	'20200331 HWG START : 고유MTS
	g_szInputFile	= "04000P2ITEMS.ini"	
	g_szFileName	= "04000ITEMS.ini"
	'20200331 HWG END
	
	Form.SetScreenName("설정")
	grdMain00.rowmove = "1"			
	ShowSettings()

End Sub


