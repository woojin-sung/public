'============================================================================
'grdMain00_OnClickUp
'============================================================================
Sub grdMain00_OnClickUp(lRow, szCellID)
	dim szCnt
	dim szItemName			'선택된 ITEM의 이름 

	szCnt = grdMain00.rowcount
	
	if szCellID = "bd_cell0" then					' 삭제 기능 
		'20200331 HWG START : 고유MTS
		if szCnt <= "1" then	
			Form.ShowAlert("알림", "최소1개이상유지해야합니다.")
		'20200331 HWG END
		else
			szItemName = grdMain00.GetCellData("bd_cell3", lRow)
			Form.SaveConfigData(g_szInputFile, szItemName, "0★-1")
			grdMain00.SetDeleteRow(lRow)
		end if 
	end if 
End Sub


'============================================================================
'btnAddMrkt_OnClick
'============================================================================
Sub btnAddMrkt_OnClick()
	Form.OpenFramePopup("nhnts04000_p2" , sOpenData , sPosInfo)	'20200331 HWG : 고유MTS
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	ShowSettings()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	dim szGridCnt
	dim szLinkData
	
	szGridCnt = grdMain00.rowcount
	
	szLinkData = szGridCnt & "★"
	
	for i = 0 to  szGridCnt - 1
		szLinkData = szLinkData & grdMain00.GetCellData("bd_cell3", i) & "★" & grdMain00.GetCellData("bd_cell5", i) &  "★"
	next 
	
	Form.SaveConfigData(g_szInputFile, "04000P2_LISTITEMS", szLinkData)	'20200331 HWG : 고유MTS
	Form.SendReturnToParent("REFRESH_MAIN" , szLinkData)

End Sub


