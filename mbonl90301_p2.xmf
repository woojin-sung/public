	<SCRIPT_INFO _len="5037" _ulen="4655" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 보유 현황 상세
' 02. 화면설명 : 장외채권 상품 보유 현황 상세
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szList
Dim g_ACNo, g_ASNo, g_szSymbolCode


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub imgDim_OnClick()
	Form.CloseForm("")
End Sub
	
'============================================================================
Sub contMain_btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szLinkData = Form.GetOpenLinkData()
	
'	Form.ShowAlert("90301_p2_FormInit", g_szLinkData)
	if g_szLinkData == "" or g_szLinkData == null then
		Exit Sub
	end if 
	
	g_szList = split(g_szLinkData, "|")
	'0 종목명
	'1 종목코드
	'2 평가금액
	'3 평가손익금액
	'4 매수수익률
	'5 잔고소유유형명
	'6 잔고수량
	'7 매입단가
	'8 평가단가(민평단가)
	'9 매수일자
	'10 만기일자
	'11 대출금액
	'12 대출일자
	'13 대출만기일자
	'14 계좌번호
	'15 계좌일련번호

	contMain.lblName.caption = g_szList(0)
		
	contMain.tbl0.SetCellString(0, 2, g_szList(2))
	
	contMain.tbl1.SetCellString(0, 2, CInt(g_szList(3)))
	
	contMain.tbl2.SetCellString(0, 2, g_szList(5))	'잔고구분 (잔고소유유형명)
	contMain.tbl2.SetCellString(1, 2, CInt(g_szList(6)) / 1000)	'잔고수량
	contMain.tbl2.SetCellString(2, 2, g_szList(7))	'매입단가
	contMain.tbl2.SetCellString(3, 2, g_szList(8))	'민평단가
	
	if g_szList(9) == "00000000" then
		contMain.tbl2.SetCellString(4, 2, "-")		'매수일
		
		contMain.tbl1.SetCellMaskInfo(1, 2, "1,0,,,0,,0,0,0")
		contMain.tbl1.SetCellString(1, 2, "-")		'만기수익률
	else
		contMain.tbl2.SetCellString(4, 2, g_szList(9))	'매수일
	end if
	contMain.tbl2.SetCellString(5, 2, g_szList(10))
	
	if CInt(g_szList(11)) == 0 then
		contMain.tbl3.SetCellString(0, 2, "-")
	else
		contMain.tbl3.SetCellString(0, 2, FormatNumber(CInt(g_szList(11)), 0) )
	end if
	
	if g_szList(12) == "" then
		contMain.tbl3.SetCellString(1, 2, "-")
	else
		contMain.tbl3.SetCellString(1, 2, g_szList(12))
	end if
	
	if g_szList(13) == "" then
		contMain.tbl3.SetCellString(2, 2, "-")
	else
		contMain.tbl3.SetCellString(2, 2, g_szList(13))
	end if
	
	if g_szList(9) <> "00000000" then
		DATAMANAGER.RequestTranData("obsab_deal_606r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림_" & szTranID , "90301_p2\n" & szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림_" & szTranID , "90301_p2\n" & szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsab_deal_606r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",				0, g_szList(14))	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, g_szList(15))	'계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, g_szList(1))	'종목코드
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BYOV_DATE",			0, g_szList(9))	'매수일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BYOV_UNPR",			0, g_szList(7))	'매수단가
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsab_deal_606r" then
		szTemp1  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PEBO_YN",		0)	'영구채여부
		szTemp2  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_ERT",	0)   '만기수익률
		
		contMain.tbl1.SetCellMaskInfo(1, 2, "0,0,,%,0,,2,1,1")
		contMain.tbl1.SetCellString(1, 2, CDbl(szTemp2))	'만기수익률
'		CInt(CDbl(FormatNumber(szTemp2), 3)) * 100) / 100
	end if
	
End Sub



	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obsab_deal_606r" trcode="obsab_deal_606r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obsab_deal_606r" title="만기수익률조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="189" _ulen="145" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ISCD^종목코드^12^0^0^0^0^0^0
BYOV_DATE^매수일자^8^0^0^0^0^0^0
BYOV_UNPR^매수단가^22^5^7^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="86" _ulen="66" >

PEBO_YN^영구채여부^1^0^0^0^0^0^0
MTRT_ERT^만기수익률^14^5^7^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
