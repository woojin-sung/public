'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szInstitution_name
dim nRow

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Button0_OnClick()
	nRow = 0
	
	DATAMANAGER.SetDataValue(0, "obcmp_momt_473r", "InBlock1", "RQST_TRGT_INNM", 0 , g_szInstitution_name)
	
	DATAMANAGER.RequestTranData("obcmp_momt_473r")
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_szInstitution_name = "%"
	nRow = 0
End Sub

'============================================================================
Sub Container0_Edit0_OnEditComplete()
	g_szInstitution_name = "%"&Container0.Edit0.caption&"%"
	
	if g_szInstitution_name == "" then
		g_szInstitution_name = "%"
	end if
End Sub

'============================================================================
Sub Container0_Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obcmp_momt_473r")
End Sub

'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obcmp_momt_473r" then
		nCnt = DATAMANAGER.GetDataCount(0, "obcmp_momt_473r", "OutBlock1")
	
		for i = 0 to nCnt-1
			if DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "1"
				then Container0.Grid0.SetCellData("bd_cell0", nRow, "행정기관")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "2"
				then Container0.Grid0.SetCellData("bd_cell0", nRow, "공직유관단체")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "3"
				then Container0.Grid0.SetCellData("bd_cell0", nRow, "공공기관")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "4"
				then Container0.Grid0.SetCellData("bd_cell0", nRow, "교육기관")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "5"
				then Container0.Grid0.SetCellData("bd_cell0", nRow, "언론사")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "6"
				then Container0.Grid0.SetCellData("bd_cell0", nRow, "기타기관")
			else
				Container0.Grid0.SetCellData("bd_cell0", nRow, "기타기관")
			end if
			
			
			nRow = nRow+1
		next
	end if
End Sub

'============================================================================
Sub Container0_Grid0_OnClickUp(lRow, szCellID)

	
	szType = Container0.Grid0.GetCellData("bd_cell0", lRow)
	szName = Container0.Grid0.GetCellData("bd_cell1", lRow)
	szCheck = Container0.Grid0.GetCellData("bd_cell2", lRow)
	
	
	
	Form.CloseForm()
	
	Form.SendReturnToParent("type" , szType)
	Form.SendReturnToParent("name" , szName)
	Form.SendReturnToParent("check" , szCheck)
End Sub

