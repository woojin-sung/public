						<CELL cell_ly="0,17,0,17" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="적용하며, 약관에서 정하는 바에 따라 변경될 수 있으므로" fontsize="-2" impidxs="" />
