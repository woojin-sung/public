						<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="가능금액' 내에서 바로 출금이 가능합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,10,0,10" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="- 단, 바로출금서비스 약정금액 최대 5천만원에 한함" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,11,0,11" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="- 주식매도금액의 98% 금액까지 대출 가능" fontsize="-2" impidxs="" />
