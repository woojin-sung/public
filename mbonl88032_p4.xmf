						<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="매도 체결로 인한 매도 대금 보유시에만 해당 서비스를" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,8,0,8" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="이용할 수 있으며, 전일 및 금일 매도 금액 중 '대출신청" fontsize="-2" impidxs="" />
