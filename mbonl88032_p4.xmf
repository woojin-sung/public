						<CELL cell_ly="0,21,0,21" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="매도 결제일에 전부 상환만 가능합니다. " fontsize="-2" impidxs="" />
