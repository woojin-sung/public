'===========================================================================
' 2020.04.07 : 이현우 - 고유 MTS 
'===========================================================================
Dim g_szFncd
Dim g_szItemCode

g_szItemCode = ""
'============================================================================
Sub Form_OnFormInit()
	ItemCode0.code = "empty"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName = "REQUEST" THEN
		if sParam <> null then
			g_szFncd = sParam
			'해외파생 고유 거래내역 조회
			DATAMANAGER.RequestTranData("obfnd_fund_022r")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obfnd_fund_022r" then
	
		if Trim(g_szFncd) = "" Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "STA_DATE" 			, 0 , cldFrom.caption ) '시작일
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "FIN_DATE" 			, 0 , cldTo.caption )	 '종료일
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "FISCD" 				, 0 , g_szItemCode )	 '종목코드 
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "FNCD" 				, 0 , g_szFncd )	      '펀드코드
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "MANG_DPCD" 			, 0 , "%" )
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "ACNG_ASET_CLS_CODE" 	, 0 , "%" )
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "FTOT_TPCD" 			, 0 , "%" )
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "FUTS_OPTN_CLCD" 		, 0 , "%" )
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "PROD_TR_CODE" 		, 0 , "%" )
		DATAMANAGER.SetDataValue( false, "obfnd_fund_022r", "InBlock1", "SMTN_FUND_CLCD" 		, 0 , "2" )	'개별펀드			
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obfnd_fund_022r" then
		Dim nCnt, nIndex
		Dim szCRCD, szTR_FAMT, szACBK_FAMT, szTR_PRLS_FAMT
		
		nCnt = DATAMANAGER.GetDataCount(false, "obfnd_fund_022r", "OutBlock1")
		
		nIndex = tonumber(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1 
			szCRCD 			= DATAMANAGER.GetDataValue(false, "obfnd_fund_022r", "OutBlock1", "CRCD" , i)
			szTR_FAMT	 	= DATAMANAGER.GetDataValue(false, "obfnd_fund_022r", "OutBlock1", "TR_FAMT" , i)
			szACBK_FAMT	 	= DATAMANAGER.GetDataValue(false, "obfnd_fund_022r", "OutBlock1", "ACBK_FAMT" , i)
			szTR_PRLS_FAMT 	= DATAMANAGER.GetDataValue(false, "obfnd_fund_022r", "OutBlock1", "TR_PRLS_FAMT" , i)
						
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szTR_FAMT,0))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szACBK_FAMT,0))
				grdList.SetCellData("bd_cell5", nIndex+i, FormatNumber(szTR_PRLS_FAMT,0))
			else
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szTR_FAMT,2))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szACBK_FAMT,2))
				grdList.SetCellData("bd_cell5", nIndex+i, FormatNumber(szTR_PRLS_FAMT,2))
			end if
		next
	end if
End Sub



'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obfnd_fund_022r" )
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( "obfnd_fund_022r" )
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obfnd_fund_022r" ) then
		DATAMANAGER.RequestNextData( "obfnd_fund_022r" )
	end if
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		g_szItemCode = sReturn1
		DATAMANAGER.RequestTranData( "obfnd_fund_022r" )
	end if
End Sub

'============================================================================
Sub btnErase_OnClick()
'	if ItemCode0.code <> "" then
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
		
		ItemCode0.code = "empty"
		g_szItemCode = ""
	
		DATAMANAGER.RequestTranData( "obfnd_fund_022r" )
'	end if
End Sub 
