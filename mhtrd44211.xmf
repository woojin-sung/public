	<SCRIPT_INFO _len="3957" _ulen="3825" >

Dim g_szThemecode
Dim g_szExchCode
Dim g_szType

'============================================================================
Sub Form_OnFormInit()
	'초기 선택 라디오그룹: 상품별
	contTheme0.visible = true
	contExch0.visible = false
	
	grdList.subformname = "mhtrd44210_p1"
	grdList.subformindex = -1
	
	contTheme0_rdoTheme_OnClick( cint(contTheme0.rdoTheme.currentindex) )
End Sub

'============================================================================
'상품/거래소별 탭 전환
Sub Tab0_OnTabChanged(nCurrentTab)	
	if nCurrentTab = 0 then
		contTheme0.visible = true
		contExch0.visible = false
		contTheme0_rdoTheme_OnClick( cint(contTheme0.rdoTheme.currentindex) )
	else
		contTheme0.visible = false
		contExch0.visible = true
		contExch0_rdoExch_OnClick(cint(contExch0.rdoExch.currentindex) )
	end if
End Sub

'============================================================================
Sub contTheme0_rdoTheme_OnClick(nIndex)
	Select Case nIndex
		Case 0 
			g_szThemeCode = "10"	'통화
		Case 1 
			g_szThemeCode = "30"	'지수
		Case 2 
			g_szThemeCode = "20"	'금리
		Case 3 
			g_szThemeCode = "50"	'금속
		Case 4 
			g_szThemeCode = "60"	'에너지
		Case 5 
			g_szThemeCode = "40"	'농/축산물
	End Select
	
	g_szType = "Theme"
	DATAMANAGER.RequestTranData("obtrd_comm_010r")
End Sub

'============================================================================
Sub contExch0_rdoExch_OnClick(nIndex)
	Select Case nIndex
		Case 0 
			g_szExchCode = "CME" 'CME
		Case 1 
			g_szExchCode = "EUREX" 'EUREX
		Case 2 
			g_szExchCode = "HKEX" 'HKEX
		Case 3 
			g_szExchCode = "SGX" 'SGX
'		Case 4 20211222 HSZ 주석처리(OSE거래소 서비스 종료)
'			g_szExchCode = "OSE" 'OSE
	End Select
	
	g_szType = "Exch"
	DATAMANAGER.RequestTranData("obtrd_comm_010r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	grdList.SetClear()
	
	if szTranID = "obtrd_comm_010r" then
		if g_szType = "Theme" then
			DATAMANAGER.SetDataValue( false, "obtrd_comm_010r", "InBlock1", "INSS_MTIT_CLCD" , 0 , g_szThemeCode)
			DATAMANAGER.SetDataValue( false, "obtrd_comm_010r", "InBlock1", "FTOT_TPCD" , 0 , "F")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_010r", "InBlock1", "OVDV_EXCH_CODE" , 0 , "%")
		else
			DATAMANAGER.SetDataValue( false, "obtrd_comm_010r", "InBlock1", "INSS_MTIT_CLCD" , 0 , "%")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_010r", "InBlock1", "FTOT_TPCD" , 0 , "F")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_010r", "InBlock1", "OVDV_EXCH_CODE" , 0 , g_szExchCode)
		end if
	end if
End Sub 

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	 szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
  
	 if Trim(szSubMsg) <> "" then
		 Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	 else
		 Form.ShowAlert("알림", szErrMsg)
	 end if
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	szCode = grdList.GetCellData("bd_cell0", lRow)
	
	'품목코드를 종목코드로 변환
	szCode = Form.GetFirstMonth(szCode)
	
	if szCode = "" then
		Exit Sub
	end if
	
	listLocation =  Split(grdList.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	Move_Popup(szCode, nYPos, height)
End Sub

'============================================================================
' Move_Popup 
'============================================================================
Function Move_Popup(szCode, nYPos, height)
	szData = szCode & "★" & nYPos & "★" & height
	Screen_No(szData)
End Function

'============================================================================	
Function Screen_No(szScreen0)
	Form.OpenPopup("mhtrd44210_p1" , szScreen0, "")
End Function 

