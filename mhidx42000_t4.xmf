'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szIndexCode	'지수코드

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ShowTable() : 설정 값에 따라 알맞은 테이블 보임
'============================================================================
Function ShowTable()
	dim	szSort

	grdTimeT4.SetClear(1)
	grdDayT4.SetClear(1)

'	0`시간별
'	1`일별	

	szSort = rdoTimeT4.currentindex 
	
	if szSort = "0"	 then 				'시간별
		grdTimeT4.left = 0
		grdDayT4.left = 400
		DATAMANAGER.RequestTranData("ohhts_1514_002r")
	else								'일별
		grdTimeT4.left = 400
		grdDayT4.left = 0
		DATAMANAGER.RequestTranData("ohhts_1514_004r")
	end if 
	
end function 


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szIndexCode	= 	Form.GetSharedData("42000INITCODE" , 0)

	ShowTable()
End Sub


'============================================================================
'rdoTimeT4_OnClick
'============================================================================
Sub rdoTimeT4_OnClick(nIndex)
	ShowTable()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)


	if	szTranID	=	"ohhts_1514_002r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1514_002r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
'	elseif	szTranID	=	"ohhts_1514_003r"	then
'		DATAMANAGER.SetDataValue(0, "ohhts_1514_003r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
	elseif	szTranID	=	"ohhts_1514_004r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1514_004r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim szOrgTime
	dim n1514Cnt
	dim szHour
	dim szMin
	dim szSec
		
	if szTranID = "ohhts_1514_002r" then

		n1514Cnt = DATAMANAGER.GetDataCount(0, "ohhts_1514_002r" , "OutBlock1")
		
		for  i = 0 to n1514Cnt - 1 
			
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1514_002r", "OutBlock1", "FID_PRPR_HOUR", i)
					
			szHour = Int(left(szOrgTime, 2))
			szMin = Int(mid(szOrgTime, 3,2))
			szSec = Int(right(szOrgTime, 2))
			
			
			if szOrgTIme = "888888" then
				DATAMANAGER.SetDataValue(0, "ohhts_1514_002r", "OutBlock1", "FID_PRPR_HOUR", i, "장마감")
			elseif szOrgTIme = "999999" then
				DATAMANAGER.SetDataValue(0, "ohhts_1514_002r", "OutBlock1", "FID_PRPR_HOUR", i, "시간외" )
			else 
				
			     if int(szHour) <= 9 then
				    szHour = "0"&szHour
				End if
				
				'szMin = szMin+1
				szHour = szHour
			    
				If szMin >= 60 then
				    szMin = szMin - 60
				    szHour = szHour + 1		    
				End if
			    
				if int(szSec) <= 9 then	
					If Len(szSec) < 2 then
					    szSec = "0"&szSec
					Else
					    szSec = Right( szSec, 2 )
					End if
				End if
			    
			      If int(szMin) <= 9 then
				     If Len( szMin ) < 2 then
					    szMin = "0"&szMin
					Else
					    szMin = Right( szMin, 2 )
					End if
			      End if
			
				DATAMANAGER.SetDataValue(0, "ohhts_1514_002r", "OutBlock1", "FID_PRPR_HOUR", i, szHour&szMin&szSec )
		
			end if
			
		next 
		
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szData
	dim	n002Cnt, szDataCnt
	dim  nMulti
	
	if szTranID = "ohhts_1514_004r" then				'일별
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE" , 0 , g_szIndexCode)
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
	end if
	

	
	if szTranID = "ohhts_1514_002r" then				'시간별
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szIndexCode)
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")
		
		n002Cnt = grdTimeT4.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "ohhts_1514_002r", "OutBlock1")
		nMulti =  ( n002Cnt / szDataCnt ) - 1
		
		for	i=0+(nMulti * szDataCnt) to	n002Cnt-1
			szData = trim(grdTimeT4.GetCellData("bd_cell0", i))
			if szData  = "장마감"	then
			elseif szData  = "시간외"	then
			else
				'grdTimeT4.SetCellData("bd_cell0", i, left(szData,2) &":" & mid(szData,3,2) &":"& right(szData,2))
			end if 
		next 
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealData
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	dim szOrgTime
	dim n1514Cnt
	dim szHour
	dim szMin
	dim szSec
	
	if	szTranID	=	"ohhts_nmix_cntg_1"	then
	
		szNmixCnt = DATAMANAGER.GetDataCount(1, "ohhts_nmix_cntg_1" , "OutBlock1")
		
		
			szOrgTime = DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_BSOP_HOUR", i)
					
			szHour = Int(left(szOrgTime, 2))
			szMin = Int(mid(szOrgTime, 3,2))
			szSec = Int(right(szOrgTime, 2))
		
		
		
			if szOrgTIme = "888888" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_BSOP_HOUR", i, "장마감")
			elseif szOrgTIme = "999999" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_BSOP_HOUR", i, "시간외" )
			else 
				
			     if int(szHour) <= 9 then
				    szHour = "0"&szHour
				End if
				
				'szMin = szMin+1
				szHour = szHour
			    
				If szMin >= 60 then
				    szMin = szMin - 60
				    szHour = szHour + 1		    
				End if
			    
				if int(szSec) <= 9 then	
					If Len(szSec) < 2 then
					    szSec = "0"&szSec
					Else
					    szSec = Right( szSec, 2 )
					End if
				End if
			    
			      If int(szMin) <= 9 then
				     If Len( szMin ) < 2 then
					    szMin = "0"&szMin
					Else
					    szMin = Right( szMin, 2 )
					End if
			      End if
			
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_BSOP_HOUR", i, szHour&szMin&szSec )
		
			end if		
	end if
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

	if szTranID = "ohhts_nmix_cntg_1" then				'시간별
			
		szData = trim(grdTimeT4.GetCellData("bd_cell0", 0))
			if szData  = "장마감"	then
			elseif szData  = "시간외"	then
			else
				'grdTimeT4.SetCellData("bd_cell0", 0, left(szData,2) &":" & mid(szData,3,2) &":"& right(szData,2))
			end if 
		 
	end if 
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName = "42000ITEMCODE"	then
		 g_szIndexCode = sParam
		 ShowTable()
