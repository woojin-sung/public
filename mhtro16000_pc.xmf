	<SCRIPT_INFO _len="8216" _ulen="7378" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 팝업_설정
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
' 설정테이블
Dim g_tSetTable()
'g_tSetTable = {}

' 항목 선택여부
Dim g_szClick
g_szClick = ""

Dim g_bFrist
g_bFirst = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'======================================
' Init_SetTable : 설정테이블 초기화
'======================================
Function Init_SetTable()
	g_tSetTable.Dispdiff 		= "1"
	g_tSetTable.Jangraph 		= "1"
	'g_tSetTable.Diplayrest 	= "0"
	g_tSetTable.Priceoutline 	= "1"
	g_tSetTable.BoldHoga 		= "0"
	g_tSetTable.BoldJan 		= "0"
	
	Form.SaveConfigData("mhtro16000", "Dispdiff"		, g_tSetTable.Dispdiff		)	'호가등락률
	Form.SaveConfigData("mhtro16000", "Jangraph"		, g_tSetTable.Jangraph		)	'호가잔량그래프
	'Form.SaveConfigData("mhtro16000", "Diplayrest"	, g_tSetTable.Diplayrest	)	'호가직전수량표시
	Form.SaveConfigData("mhtro16000", "Priceoutline"	, g_tSetTable.Priceoutline	)	'현재가 외곽선 표시
	Form.SaveConfigData("mhtro16000", "BoldHoga"		, g_tSetTable.BoldHoga		)	'텍스트굵기 호가
	Form.SaveConfigData("mhtro16000", "BoldJan"		, g_tSetTable.BoldJan		)	'텍스트굵기 호가잔량
	
End Function

'======================================
' Set_TableData : 선택영역 네이밍 및 폰트 색상 적용
'======================================
Function Set_TableData(nRow, szName)
	contSet.tblSet.SetCellString(nRow, 1, szName)
	
	if Trim(szName) = "선택" then
		contSet.tblSet.SetCellFgColor(nRow, 1, "12")	
	else
		contSet.tblSet.SetCellFgColor(nRow, 1, "10")	
	end if
End Function

'======================================
' Init_Control : 설정 초기화(0: 화면오픈, 1:초기화버튽클릭)
'======================================
Function Init_Control(nIdx)
	if nIdx = 1 then							' 초기화 버튼 클릭시
		Set_TableData(0, "선택")
		Set_TableData(1, "선택")
		Set_TableData(2, "선택")
		Set_TableData(3, "순서변경")
		Set_TableData(4, "미선택")
		Set_TableData(5, "미선택")
		Set_TableData(6, "미선택")		

		
		Init_SetTable()
		
		Form.SendReturnToParent( "FORMTAB_INIT", g_szClick )
		
		Form.Toast(0, "설정이 초기화 되었습니다.", true)
	else										' Form_init
		g_tSetTable.Dispdiff		= Form.LoadConfigData("mhtro16000", "Dispdiff"	)	'호가등락률
		g_tSetTable.Jangraph		= Form.LoadConfigData("mhtro16000", "Jangraph"	)	'호가잔량그래프
		'g_tSetTable.Diplayrest		= Form.LoadConfigData("mhtro16000", "Diplayrest"	)	'호가직전수량표시
		g_tSetTable.Priceoutline	= Form.LoadConfigData("mhtro16000", "Priceoutline")	'현재가 외곽선 표시
		g_tSetTable.BoldHoga		= Form.LoadConfigData("mhtro16000", "BoldHoga"	)	'텍스트굵기 호가
		g_tSetTable.BoldJan		= Form.LoadConfigData("mhtro16000", "BoldJan"		)	'텍스트굵기 호가잔량
		
		'호가등락률
		If g_tSetTable.Dispdiff = "1" Then
			Set_TableData(0, "선택")
		Else
			Set_TableData(0, "미선택")
		End If
		
		'호가잔량그래프
		If g_tSetTable.Jangraph = "1" Then
			Set_TableData(1, "선택")
		Else
			Set_TableData(1, "미선택")
		End If
		
		'호가직전수량표시
		'If g_tSetTable.Diplayrest = "1" Then
		'	Set_TableData(2, "선택")
		'Else
		'	Set_TableData(2, "미선택")
		'End If
		
		'현재가 외곽선 표시
		If g_tSetTable.Priceoutline = "1" Then
			Set_TableData(2, "선택")
		Else
			Set_TableData(2, "미선택")
		End If
		
		Set_TableData(3, "순서변경") ' 순서변경 이름저장
		
		'텍스트굵기 호가
		If g_tSetTable.BoldHoga = "1" Then
			Set_TableData(4, "선택")
		Else
			Set_TableData(4, "미선택")
		End If
		
		'텍스트굵기 호가잔량
		If g_tSetTable.BoldJan = "1" Then
			Set_TableData(5, "선택")
		Else
			Set_TableData(5, "미선택")
		End If
		
		
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'======================================
Sub Form_OnFormInit()
	Form.SetScreenName( "해외주식 현재가 화면설정" )
	Init_Control( 0 )
End Sub

'======================================
Sub Form_OnFormClose()
	' 주식현재가화면에 셋팅 적용 알림
	Form.SendReturnToParent( "HOGA_SETUP", g_szClick )
	
End Sub


'============================================================================
Sub contSet_imgDispdiff_OnClick()
	If g_tSetTable.Dispdiff = "1" Then
		g_tSetTable.Dispdiff = "0"
		Set_TableData(0, "미선택")
	Else
		g_tSetTable.Dispdiff = "1"
		Set_TableData(0, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhtro16000", "Dispdiff"		, g_tSetTable.Dispdiff		)	'호가등락률

End Sub

'============================================================================
Sub contSet_imgjangraph_OnClick()
	If g_tSetTable.Jangraph = "1" Then
		g_tSetTable.Jangraph = "0"
		Set_TableData(1, "미선택")
	Else
		g_tSetTable.Jangraph = "1"
		Set_TableData(1, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhtro16000", "Jangraph"		, g_tSetTable.Jangraph		)	'호가잔량그래프

End Sub


'============================================================================
Sub contSet_imgPriceoutline_OnClick()
	If g_tSetTable.Priceoutline = "1" Then
		g_tSetTable.Priceoutline = "0"
		Set_TableData(2, "미선택")
	Else
		g_tSetTable.Priceoutline = "1"
		Set_TableData(2, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhtro16000", "Priceoutline"	, g_tSetTable.Priceoutline	)	'현재가 외곽선 표시

End Sub

'============================================================================


'============================================================================
Sub contSet_imgBoldHoga_OnClick()
	If g_tSetTable.BoldHoga = "1" Then
		g_tSetTable.BoldHoga = "0"
		Set_TableData(4, "미선택")
	Else
		g_tSetTable.BoldHoga = "1"
		Set_TableData(4, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhtro16000", "BoldHoga"		, g_tSetTable.BoldHoga		)	'텍스트굵기 호가

End Sub

'============================================================================
Sub contSet_imgBoldJan_OnClick()
	If g_tSetTable.BoldJan = "1" Then
		g_tSetTable.BoldJan = "0"
		Set_TableData(5, "미선택")
	Else
		g_tSetTable.BoldJan = "1"
		Set_TableData(5, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhtro16000", "BoldJan"		, g_tSetTable.BoldJan		)	'텍스트굵기 호가잔량
	
End Sub

'============================================================================
Sub contSet_btnInit_OnClick()
	Init_Control( 1 )
	
End Sub



'============================================================================
Sub contSet_tblSet_OnClick(lRow , lColumn)

	if lColumn = 1 or lColumn = 2 then
		if lRow = 0 then						' 호가등락률
			contSet_imgDispdiff_OnClick()
		elseif lRow = 1 then					' 호가잔량그래프
			contSet_imgjangraph_OnClick()
		'elseif lRow = 2 then					' 호가직전수량표시
		'	contSet_imgDiplayrest_OnClick()
		elseif lRow = 2 then					' 현재가 외곽선 표시
			contSet_imgPriceoutline_OnClick()
'		elseif lRow = 3 then					' 탭표시
'			contSet_imgTab_OnClick()
		elseif lRow = 4 then					' 텍스트굵기 호가
			contSet_imgBoldHoga_OnClick()
		elseif lRow = 5 then					' 텍스트굵기 호가잔량
			contSet_imgBoldJan_OnClick()			
		end if
	end if
	
End Sub

'============================================================================


	</SCRIPT_INFO>
</ROOT>