	<SCRIPT_INFO _len="1468" _ulen="1456" >
--===========================================================================
--===========================================================================
Dim g_SuccYn

'============================================================================
Sub Form_OnFormInit()
	g_SuccYn = "N"
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	Form.OpenFramePopup("mbonl86011" , "mbbnk63010" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
    Form.SendReturnToParent("TERM_REG_SUCC" , g_SuccYn)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "63010_CLOSE" then
	    If sRet == "Y" Then '단말지정성공
	        g_SuccYn= "Y"
	        Form.CloseForm()
	    End If
		
	end If
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

