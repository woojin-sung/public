'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szListItems
	dim szLinkData
	
		
'	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_1")
'	DATAMANAGER.CancelRealData("ohhts_nfut_cntg_1")
	
	
	szLinkData = Form.GetOpenLinkData()
	chart01.SetMarketCategory("4")
	
	if szLinkData <> NULL	and	len(szLinkData)  >	0	then
		szListItems 	= split(szLinkData, "★")
		g_szSymbol  	= szListItems(0)
		g_szMarket 	= szListItems(1)
		g_szName 	= szListItems(2)

		if	g_szMarket	=	"RATE"	then			'금리일때 일자
			g_szDate 	= szListItems(3)	
		end if
			
		Form.SetScreenName(g_szName)
	
		if 	g_szMarket	=	"RATE"	then			
			DATAMANAGER.RequestTranData("obfni_rmss_140r")			'CD금리, 회사채, 국고채 조회
		else
			DATAMANAGER.RequestTranData("ohhts_1682_002r")
			if		g_szMarket	=	"EN"	then
				chart01.SetDeleteIndicaBlock("거래량")				'20240703 HSZ 해외주식 고도화
				DATAMANAGER.RequestTranData("ohhts_1682_003r")		'환율차트		
			else
				DATAMANAGER.RequestTranData("ohhts_1682_002r_1")		'그외차트
			end	if
		end if
	end if 
	
End Sub

'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'chart01.SetDeleteIndicaBlock("거래량")
	'chart01.SetChartType ("linefill")
		
	'해외환율일때 소수점 4자리로 160422 KMC 추가
	' 환율 중, 원/엔만 소숫점 4자리 & 환율부분에 원/엔 없음으로 4자리 하지 않음 - 2016.07.15.YHK
	'if g_szMarket == "EN" then
	'	chart01.setDecimal("4") ' 소수점 4자리
	'else
		chart01.setDecimal("2") ' 소수점 2자리
	'end if
	' -----------------------		
	if  	g_szName == "회사채" or g_szName == "국고채" then
		mask="0,0,,,0,,4,1,1" 
		grd00.SetMaskCol(1,mask )
		grd00.SetMaskCol(2,mask )
'	else
'		mask="0,0,,,0,,2,1,1" 
'		grd00.SetMaskCol(1,mask )
'		grd00.SetMaskCol(2,mask )
	end if
	' -----------------------
	
	if	szTranID	=	"ohhts_1682_002r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1682_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1682_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", 0, g_szSymbol )
	elseif	szTranID	=	"ohhts_1682_002r_1"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1682_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1682_002r_1", "InBlock1", "FID_INPUT_OVRS_ISCD", 0, g_szSymbol )
	elseif	szTranID	=	"ohhts_1682_003r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1682_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1682_003r", "InBlock1", "FID_INPUT_OVRS_ISCD", 0, g_szSymbol )
	elseif	szTranID	=	"obfni_rmss_140r"	then	
		'g_szSymbol = szListItems(0)
		'g_szMarket = szListItems(1)
		'g_szName =  szListItems(2)
	
		'chart01.SetAccrueName("가격")
		chart01.SetDeleteIndicaBlock("거래량")		
		chart01.SetChartType ("line")	
		
		if  		g_szName == "CD금리" then
			'chart01.setDecimal("2") ' 소수점 2자리	
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_DETL_GRAD", 0, "AAA" )		' CD			
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_FIN_DATE", 	0, g_szDate)					'"20160712")	' CD금리
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_STA_DATE", 	0, g_szDate - 30000)			'"20130712")	' CD금리
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_CLCD", 	0, "3" )						' CD금리
		elseif  	g_szName == "회사채" then
			chart01.setDecimal("4") ' 소수점 4자리	
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_FIN_DATE", 	0, g_szDate)					'"20160712")	' 회사채
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_STA_DATE", 	0, g_szDate - 30000)			'"20130712")	' 회사채		
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_CLCD", 	0, "2" )						' 회사채			
		elseif  	g_szName == "국고채" then
			chart01.setDecimal("4") ' 소수점 4자리	
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_FIN_DATE", 	0, g_szDate)					'"20160712")	' 국고채
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_STA_DATE", 	0, g_szDate - 30000)			'"20130712")	' 국고채
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", "InBlock1", "OVRS_PRMR_NMIX_CLCD", 	0, "1" )						' 국고채
		end if

	end if 
End Sub


'============================================================================
'chart01_OnScrollEnd
'============================================================================
Sub chart01_OnScrollEnd()

'	if	g_szMarket	=	"RATE"	then			
'		DATAMANAGER.RequestTranData("obfni_rmss_140r")	
'	else
		DATAMANAGER.RequestNextData("ohhts_1682_002r_1")
