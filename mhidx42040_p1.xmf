'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szCode
	
	szCode	=	""

	if	szTranID	=	"ohhts_1682_002r"	then
		DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_1")
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg_1")
		
		if	g_szMarket	=	"N"	then				'주요지수
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix_1")
		elseif	g_szMarket	=	"FN"		then		'해외선물
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg_1")
		end	if
	elseif	szTranID	=	"ohhts_1682_002r_1"	then
		DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_2")
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg_2")
		
		if	g_szMarket	=	"N"	then				'주요지수
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix_2")
		elseif	g_szMarket	=	"FN"		then		'해외선물
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg_2")
		end	if
	elseif	szTranID	=	"ohhts_1682_003r"	then
		DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if	szTranID	=	"ohhts_ovrs_nmix_1"	then
		DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix_1", "InBlock1", "FIDR_SYMB", 0, Trim(g_szSymbol))
	elseif	szTranID	=	"ohhts_ovrs_nmix_2"	then
		DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix_2", "InBlock1", "FIDR_SYMB", 0, Trim(g_szSymbol))
	elseif	szTranID	=	"ohhts_nfut_cntg_1"	then
		DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg_1", "InBlock1", "FIDR_SYMB", 0, Trim(g_szSymbol))
	elseif	szTranID	=	"ohhts_nfut_cntg_2"	then
		DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg_2", "InBlock1", "FIDR_SYMB", 0, Trim(g_szSymbol))		'20221202 jipark 누락된 차트실시간 추가
	elseif	szTranID	=	"ohhts_exrt_cntg"		then
		DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", 0, Trim(g_szSymbol))
	end	if
End Sub

