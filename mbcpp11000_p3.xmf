	end if
	
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubMsg <> null and szSubMsg <> "" then
		Form.ShowAlert( "안내" , szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
	
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' 삭제 버튼
'============================================================================
Sub Button0_OnClick()
	Form.MsgBox("알림", "제안 내용을 삭제하시겠습니까?", "DEL", 2)
End Sub

'============================================================================
' 수정 버튼
'============================================================================
Sub Button1_OnClick()

	if Container0.Edit0.caption == g_TITL_NAME and Container0.Edit1.caption == g_REG_DTL_CNTT then
		Form.MsgBox("알림", "수정 사항이 없습니다. 다시 수정 입력하시겠습니까?", "REMODIFICATION", 2)
		Exit Sub
	end if
	
	Form.MsgBox("알림", "제안 내용을 수정하시겠습니까?", "UPDATE", 2)
End Sub

'============================================================================
' 돌아가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub
