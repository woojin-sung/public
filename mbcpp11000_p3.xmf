'===========================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()	
	g_PROP_REG_ID = Form.GetOpenLinkData()

	if g_PROP_REG_ID <> "" and g_PROP_REG_ID <> null then
		DATAMANAGER.RequestTranData("obcpp_cbbs_002r")
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	' 제안 내용 삭제
	if sKeyName == "DEL" then
	
		if sRet == "ok" then
			g_PROS_CLS_CODE = "D"
			
			DATAMANAGER.RequestTranData("obcpp_cbbs_002a")
		end if
		
	' 제안 내용 업데이트
	elseif sKeyName == "UPDATE" then
	
		if sRet == "ok" then
			g_PROS_CLS_CODE = "U"
		
			DATAMANAGER.RequestTranData("obcpp_cbbs_002a")
		end if
	
	' 수정사항 없을 경우
	elseif sKeyName == "REMODIFICATION" then

		if sRet == "no" then
			Form.SendReturnToParent("mbcpp11000", "REFRESH")
			Form.CloseForm()
		end if
		
	end if
	
End Sub

