'===========================================================================
' 							DATAMANAGER 함수
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	if szTranID == "obcpp_cbbs_002r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 	0, g_PROP_REG_ID)
		
	elseif szTranID == "obcpp_cbbs_002a" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 	0, g_PROS_CLS_CODE)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 	0, g_PROP_REG_ID)
		
		if g_PROS_CLS_CODE == "U" then
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ELFN_ID", 		0, Form.GetSharedData("&USER_ID", false))
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "TITL_NAME", 		0, Trim(Container0.Edit0.caption))
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "REG_DTL_CNTT", 	0, Trim(Container0.Edit1.caption))
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "WHOL_CPNO", 		0, g_WHOL_CPNO)
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ANSR_CNTT", 		0, "")
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RMRK", 			0, "")
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "SMS_SNDN_YN", 	0, g_SMS_SNDN_YN)
		end if
		
'	elseif szTranID == "obcpp_cbbs_003r" then
'		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 	0, g_PROP_REG_ID)
'		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "REG_SRNO", 		0, g_REG_SRNO)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcpp_cbbs_002r" then
		g_TITL_NAME				= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TITL_NAME",	0)
		g_REG_DTL_CNTT			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_DTL_CNTT",	0)
		g_WHOL_CPNO				= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "WHOL_CPNO",	0)
		g_SMS_SNDN_YN				= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "SMS_SNDN_YN",	0)
		g_BBS_CNTT_ATCH_FILE_CNT	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BBS_CNTT_ATCH_FILE_CNT", 0)
		g_BBS_CNTT_ATCH_FILE_CNT	= g_BBS_CNTT_ATCH_FILE_CNT <> "" and CInt(g_BBS_CNTT_ATCH_FILE_CNT) or 0
		
		Container0.Edit0.caption = g_TITL_NAME
		Container0.Edit1.caption = g_REG_DTL_CNTT
	
		if g_BBS_CNTT_ATCH_FILE_CNT > 0 then
			Dim LabelNm, ImgNm
			
			for i = 0 to g_BBS_CNTT_ATCH_FILE_CNT - 1
				LabelNm 	= "Container0.Container1.Label"..i
				ImgNm	= "Container0.Container1.ImgChk"..i

				Form.SetCtlProp(LabelNm,	"visible", true)
				Form.SetCtlProp(ImgNm,		"visible", true)
			next
		
			Container0.Container1.visible = true
		else
			Container0.Container1.visible = false
		end if		
		
		
	elseif szTranID == "obcpp_cbbs_002a" then
		Dim msg
		
		' 제안내용 삭제 시
		if g_PROS_CLS_CODE == "D" then
			msg = "삭제가 완료되었습니다."

		' 제안내용 업데이트 시
		elseif g_PROS_CLS_CODE == "U" then
			msg = "수정이 완료되었습니다."			
		end if
		
		Form.ShowAlert("알림", msg)
		Form.SendReturnToParent("mbcpp11000", "REFRESH")
		Form.CloseForm()
			
'	elseif szTranID == "obcpp_cbbs_003a" then
'		
'		' 제안내용 삭제 시
'		if g_PROS_CLS_CODE == "D" then
'			 g_ReqCnt = g_ReqCnt - 1
'
'			if g_ReqCnt == 0 then
'				Form.ShowAlert("알림", "삭제가 완료되었습니다.")
'				Form.SendReturnToParent("mbcpp11000", "REFRESH")
'				Form.CloseForm()
'			end if
'			
'		' 제안내용 업데이트 시
'		elseif g_PROS_CLS_CODE == "U" then
'			g_ReqCnt = g_ReqCnt - 1
'
'			if g_ReqCnt == 0 then
'				Form.ShowAlert("알림", "수정이 완료되었습니다.")
'				Form.SendReturnToParent("mbcpp11000", "REFRESH")
'				Form.CloseForm()
'			end if
'			
'		end if
'
'	elseif szTranID == "obcpp_cbbs_003r" then
'		Dim REG_SRNO, ATCH_FILE_SIZE, UI_IMG_DATA
'		g_REG_SRNO 		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_SRNO", 		0)
'		REG_SRNO			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "REG_SRNO",			0)
'		ATCH_FILE_SIZE	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "ATCH_FILE_SIZE",	0)
'		UI_IMG_DATA		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "UI_IMG_DATA", 		0)
'
'		if g_IMG_INDX == 0 then
'			Container0.Container1.ImgDel0.visible	= true
'			Container0.Container1.DelBg0.visible		= true
'			Container0.Container1.ImgPic0.visible	= true
'			Container0.Container1.ImgPic0.SetImageDataEnc(UI_IMG_DATA)
'		elseif g_IMG_INDX == 1 then
'			Container0.Container1.ImgDel1.visible	= true
'			Container0.Container1.DelBg1.visible		= true
'			Container0.Container1.ImgPic1.visible	= true
'			Container0.Container1.ImgPic1.SetImageDataEnc(UI_IMG_DATA)
'		elseif g_IMG_INDX == 2 then
'			Container0.Container1.ImgDel2.visible	= true
'			Container0.Container1.DelBg2.visible		= true
'			Container0.Container1.ImgPic2.visible	= true
'			Container0.Container1.ImgPic2.SetImageDataEnc(UI_IMG_DATA)
'		end if
'
'		'등록이미지 정보
'		Table0.SetCellString(g_IMG_INDX, 0, UI_IMG_DATA)
'		Table0.SetCellString(g_IMG_INDX, 1, ATCH_FILE_SIZE)
