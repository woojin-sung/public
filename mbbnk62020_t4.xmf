	<SCRIPT_INFO _len="4615" _ulen="4109" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_이체완료
' 02. 화면설명 : 이체확인 팝업
' 03. 작    성 : 16.03.02
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szDrngAcnt 	   	'출금계좌번호
Dim g_szDrngBankCode 	'출금기관코드
Dim g_szDrngBankName 	'출금기관명

Dim g_szRAcnt			'입금계좌번호
Dim g_szBank		   	'입금기관명
Dim g_szAmnt			'이체금액
Dim g_szMyTip			'내통장표시
Dim g_szRecvTip		'받는분통장표시
Dim g_szRName
Dim g_szCom


'---------------------------------
Dim g_ExitType	'0:Clear 종료 , 1,2:이체완료화면
Dim g_szText		'단건일 경우 추가 메세지
Dim g_szState		'이체결과 (정상/오류)
'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Dim nCnt, nCntTotal, nTrCnt, nCntErr
	g_ExitType = 0
	nCntTotal = 0
	g_szAcnt = ""
	
	Label3.visible =0

	szData = Form.GetOpenLinkData()
	
	if szData <> "" then
		
		arrData = Split(Trim(szData), "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시♥+'받는분'코드
		
		g_szAcnt = arrData(0)
		If Ubound(arrData) > 0 and Ubound(arrData) < 16 then
			g_szDrngAcnt 		= arrData(0)	'출금계좌번호
			g_szDrngBankCode	= arrData(1) 	'출금기관코드
			g_szDrngBankName	= arrData(2)	'출금기관명
			
			g_szRAcnt 	= arrData(3)		'입금계좌번호
			g_szBank	 	= arrData(4)		'입금기관명
			g_szAmnt 	= arrData(5)		'이체금액
			g_szMyTip	= arrData(6) '내통장표시
			g_szRecvTip	= arrData(7) '받는분통장표시
			g_szRName 	= arrData(8)		'수취인명
			
			g_szText      = arrData(10)		'obtss_opnf_003a 리턴메시지
			g_szState	 = arrData(11)	'이체결과
			g_szCom		=arrData(12)		'입금기관코드
			
			if g_szCom == "287" then
				contSingle.Table1.SetCellMaskInfo( 5, 1, "1,0,,,1,####-####-##,0,1,1")
				
			end if
			contSingle.Table1.SetCellString( 0, 1, g_szDrngBankName)'출금기관명
			contSingle.Table1.SetCellString( 1, 1, g_szDrngAcnt	)'출금계좌번호
			contSingle.Table1.SetCellString( 2, 1, g_szMyTip		)'출금계좌통장표시
			
			contSingle.Table1.SetCellString( 3, 1, g_szAmnt		)'이체금액
			contSingle.Table1.SetCellString( 4, 1, g_szBank		)'입금기관명
			
			contSingle.Table1.SetCellString( 5, 1, g_szRAcnt		)'입금계좌번호
			contSingle.Table1.SetCellString( 6, 1, g_szRName		)'수취인명
			
			if g_szState =="정상" then
				contSingle.Table1.SetCellString( 7, 1, g_szState		)'이체결과(정상/오류)
			elseif g_szState <>"정상" then
				contSingle.Table1.SetCellString( 7, 1, g_szText		)'리턴메시지
				Label3.visible =1
				contSingle.Table1.SetCellFgColor(7, 1, "10")
			end if
			contSingle.visible = True
		End If  
	end if  
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.SendReturnToParent("mbbnk62020_t4", "Cancel")
	Form.CloseForm()
End Sub

Sub btnScreen_OnClick()
	g_ExitType = 1
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	msg = DATAMANAGER.GetDataMsgText( szTranID )
    
    Form.Toast( 0, msg, 0 )
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	if g_ExitType == 1 then
		sSendData = "mbbnk62020_t4" &"★"& g_szDrngBankCode &"★"& g_szDrngAcnt&"★"& g_szDrngBankName
		
		
		'Form.ShowAlert("이체결과전달", sSendData)
		Form.OpenFramePopup("mbbnk62011" , sSendData  , sPosInfo)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg ~= "" or szErrMsg ~= null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
End Sub

	</SCRIPT_INFO>
</ROOT>