			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" bgcolor="066:238239240" caption="마켓 데이터 디스플레이 서비스 계약서
(사용량 방식 서비스/비전문가 고객용)" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,1,0,1" impidxs="" />
				<CELL cell_ly="0,2,0,2" bgcolor="066:238239240" halign="0" line="0,1" caption="SECTION 1. 일반 거래조건 " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,3,0,3" halign="0" impidxs="" />
				<CELL cell_ly="0,4,0,4" bgcolor="087:240240240" halign="0" caption="SECTION 2: NONPROFESSIONAL SUBSCRIBER" fontsize="-2" impidxs="" />
