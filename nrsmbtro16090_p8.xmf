'Dim g_nURL_Cnt
'Dim g_tURL,
Dim g_nTitle_Cnt
Dim g_tTitle
Dim g_nNowCnt
Dim g_sReturnType
Dim g_bAgree
Dim g_szDev

Dim g_szCUST_CLS_CODE	'고객구분코드(2:법인)
g_szCUST_CLS_CODE = ""
'============================================================================
Function f_SetNextUrl()	
	if g_nNowCnt+1 >= g_nTitle_Cnt then
		Exit Function
	else
		g_nNowCnt = g_nNowCnt + 1
		'WebView0.urlpath = g_tURL(g_nNowCnt)
		labTitle.caption = g_tTitle(g_nNowCnt)
		lblPage.caption = g_nNowCnt+1&"/"&g_nTitle_Cnt
		f_SetPage(g_nNowCnt+1)		
	end if
End Function

'============================================================================
Function f_SetPrevUrl()
	if g_nNowCnt == 0 then
		Exit Function
	else
		g_nNowCnt = g_nNowCnt - 1
		'WebView0.urlpath = g_tURL(g_nNowCnt)
		labTitle.caption = g_tTitle(g_nNowCnt)
		lblPage.caption = g_nNowCnt+1&"/"&g_nTitle_Cnt
		f_SetPage(g_nNowCnt+1)
	end if
End Function

'============================================================================
Function f_SetPage(iIdx)
	if iIdx == 1 then
		'해외주식 실시간시세정보 이용약관
		WebView0.left = 25
		Container0.left = 500
		tblSection0.left = 500
		Container1.left = 500
		Container2.left = 500
		Container3.left = 500
		Tab0.left = 500		
		if g_szDev == "1" or g_szDev == 1 then 
			WebView0.urlpath =  "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_yk_42.html"
		Else
			WebView0.urlpath =  "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_42.html"
		End If	
	elseif iIdx == 2 then
		'해외주식시세신청 비전문가확인
		WebView0.left = 500
		Tab0.left = 500	
		
		if g_szCUST_CLS_CODE == "2" then
			'Container0.left = 25
			btnOK.left = 187
			btnOK.width = 188
			btnCancel.left = 0
			
			Container0.left = 0
			tblSection0.left = 500
			Container1.left = 500
			Container2.left = 500
			Container3.left = 500			
		else
'			tblSection0.left = 25
'			Container1.left = 25
'			Container2.left = 25
'			Container3.left = 25
			
			Container0.left = 500
			tblSection0.left = 0
			Container1.left = 0
			Container2.left = 0
			Container3.left = 0			
		end if 
		
		btnOK.left = 187
		btnOK.width = 188
		btnCancel.left = 0
		
	elseif iIdx == 3 then
		'해외주식 개인(신용)정보 동의서
		Tab0.left = 25
		Tab0.top = 64
		WebView0.top = 64 + 64
		WebView0.height = 604 - 64
		
		btnOK.left = 0
		btnOK.width = 375
		btnCancel.left = 500
		
		WebView0.left = 25
		Container0.left = 500
		tblSection0.left = 500
		Container1.left = 500
		Container2.left = 500
		Container3.left = 500		
		
		'필수'요약동의서
		if g_szDev == "1" or g_szDev == 1 then 
			WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf" '요약	
		else
			WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf" '요약	
		end if 
	end if 
End Function


'============================================================================
Sub Form_OnFormInit()

	g_szDev = Form.GetSharedData("&SERVER_MODE", False )
	g_szCUST_CLS_CODE = Form.GetSharedData("16090_CUST_CLS_CODE", true )
	
	g_bAgree = false
	dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		dim tTemp

		tTemp = Split(szOpenData, "♥")
		g_sReturnType = tTemp(0)
		'g_tURL = Split(tTemp(1), "★")
		'g_tTitle = Split(tTemp(2), "★")		
		g_tTitle = Split(tTemp(1), "★")		
		g_nNowCnt = 0
		if g_sReturnType == "All" then		
			'g_tURL = Split(tTemp(1), "★")
			'g_tTitle = Split(tTemp(2), "★")
'msgbox tTemp(1)			
			g_tTitle = Split(tTemp(1), "★")
			if #g_tTitle > 0 then
				g_nTitle_Cnt = #g_tTitle
				'WebView0.urlpath = g_tURL(g_nNowCnt)
				'해외주식 실시간시세정보 이용약관
				if g_szDev == "1" or g_szDev == 1 then 
					WebView0.urlpath =  "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_yk_42.html"
				Else
					WebView0.urlpath =  "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_42.html"
				End If				
				labTitle.caption = g_tTitle(g_nNowCnt)
				lblPage.caption = g_nNowCnt+1&"/"&g_nTitle_Cnt
				'g_szCUST_CLS_CODE =  g_tURL(g_nNowCnt)
				f_SetPage(g_nNowCnt+1)
			end if
		else
			imgPrev.visible = false
			imgNext.visible = false
			lblPage.visible = false
			
			labTitle.caption = g_tTitle(g_nNowCnt)
			if g_sReturnType == "1" then ''해외주식 실시간시세정보 이용약관
				'WebView0.urlpath = g_tURL(g_nNowCnt)
				f_SetPage(1)
				WebView0.height = 604 + 20
'				'해외주식 실시간시세정보 이용약관
'				WebView0.left = 25
'				if g_szDev == "1" or g_szDev == 1 then 
'					WebView0.urlpath =  "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_yk_42.html"
'				Else
'					WebView0.urlpath =  "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_42.html"
'				End If
			
			elseif g_sReturnType == "2" then '해외주식시세신청 비전문가확인				
				'g_szCUST_CLS_CODE = g_tURL(0) ' 2: 법입전문가, 나머지:비전문가
				f_SetPage(2)			
				Container0.height = 604 + 20
				tblSection0.height = 604 + 20
'				WebView0.left = 500
'				if g_szCUST_CLS_CODE == "2" then
'					Container0.left = 25
'				else
'					tblSection0.left = 25
'					Container1.left = 25
'					Container2.left = 25
'					Container3.left = 25
'				end if 
			elseif g_sReturnType == "3" then '해외주식 개인(신용)정보 동의서
				f_SetPage(3)	
'				Tab0.left = 25
'				Tab0.top = 64
'				WebView0.top = 64 + 64
'				WebView0.height = 604 - 64
'				'필수'요약동의서
'				if g_szDev == "1" or g_szDev == 1 then 
'					WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf" '요약	
'				else
'					WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf" '요약	
'				end if 
			end if 
		
		end if 		
	end if
End Sub


'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 then	'요약동의서
		if g_szDev == "1" or g_szDev == 1 then
			WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf" '요약	
		else
			WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf" '요약	
		end if 
	else	'상세동의서
		if g_szDev == "1" or g_szDev == 1 then
			WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm7.pdf" '상세
		else
			WebView0.urlpath = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm7.pdf" '상세
		end if 
	end if
End Sub

'============================================================================
Sub imgNext_OnClick()
	f_SetNextUrl()
End Sub

'============================================================================
Sub imgPrev_OnClick()
	f_SetPrevUrl()
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_bAgree = true	
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub imExit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_bAgree == true then
		Form.SendReturnToParent("nrsmbtro16090_p8", g_sReturnType)
	else
		Form.SendReturnToParent("nrsmbtro16090_p8", "CANCEL")
	end if
End Sub


	</SCRIPT_INFO>
