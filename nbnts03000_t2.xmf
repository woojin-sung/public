Sub btnCntClear_OnClick()
	edtCnt.caption = ""
	edtLPrc.caption = ""
	edtSPrc.caption = ""
End Sub

'============================================================================
' 수량 -
'============================================================================
Sub btnCntMinus_OnClick()
	if f_ItemCheck() = false then
		Exit Sub
	end if
	
	Dim nCnt
	
	if edtCnt.caption = "" then
		nCnt = 0
	else
		nCnt = tonumber(edtCnt.caption)
	end if
	
	if nCnt > 0 then
		edtCnt.caption = tonumber(edtCnt.caption) - 1
	else
		edtCnt.caption = 0
	end if
End Sub

'============================================================================
' 수량 +
'============================================================================
Sub btnCntPlus_OnClick()
	if f_ItemCheck() = false then
		Exit Sub
	end if
	
	Dim nCnt
	
	if edtCnt.caption = "" then
		nCnt = 0
	else
		nCnt = tonumber(edtCnt.caption)
	end if

	edtCnt.caption = nCnt + 1
End Sub

