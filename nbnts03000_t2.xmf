'============================================================================
' 주문유형 선택
'============================================================================
Sub rdoType_OnClick(nIndex)
	Dim szBtnName, bLPrcEnable, bSPrcEnable
	szBtnName = " 매도주문"
	
	if nIndex = 0 then '지정가
		bLPrcEnable = true '주문가격 활성
		bSPrcEnable = false '조건가격 비활성
		g_szType = "2"
		szBtnName = "지정가"..szBtnName
		
	elseif nIndex = 1 then '시장가
		bLPrcEnable = false '주문가격 비활성
		bSPrcEnable = false '조건가격 비활성
		g_szType = "1"
		szBtnName = "시장가"..szBtnName
		
	elseif nIndex = 2 then 'STOP
		bLPrcEnable = false '주문가격 비활성
		bSPrcEnable = true '조건가격 활성
		g_szType = "3"
		szBtnName = "STOP"..szBtnName
		
	elseif nIndex = 3 then 'S/L
		bLPrcEnable = true '주문가격 활성
		bSPrcEnable = true '조건가격 활성
		g_szType = "4"
		szBtnName = "S/L"..szBtnName
		
	end if
	
	btnSel.caption = szBtnName
	
	' 주문가격 활성 셋팅
	btnLPrcSelect.enable = bLPrcEnable
	edtLPrc.enable = bLPrcEnable
	btnLPrcMinus.enable = bLPrcEnable
	btnLPrc.enable = bLPrcEnable
	btnLPrcPlus.enable = bLPrcEnable
	if bLPrcEnable = false then
		edtLPrc.caption = ""
	end if
	' 조건가격 활성 셋팅
	btnSPrcSelect.enable = bSPrcEnable
	edtSPrc.enable = bSPrcEnable
	btnSPrcMinus.enable = bSPrcEnable
	btnSPrc.enable = bSPrcEnable
	btnSPrcPlus.enable = bSPrcEnable
	if bSPrcEnable = false then
		edtSPrc.caption = ""
	end if
	
End Sub

'============================================================================
' 주문가격 활성 셋팅
'============================================================================
Function f_LPrcEnable(bValue)
	btnLPrcSelect.enable = bValue
	edtLPrc.enable = bValue
	btnLPrcMinus.enable = bValue
	btnLPrc.enable = bValue
	btnLPrcPlus.enable = bValue
	
	'비활성이거나 종목탭변경시 초기화 사용인 경우 가격 클리어
	if bValue = false or g_szChangeInit = "1" then
		edtLPrc.caption = ""
	end if
End Function

'============================================================================
' 조건가격 활성 셋팅
'============================================================================
Function f_SPrcEnable(bValue)
	btnSPrcSelect.enable = bValue
	edtSPrc.enable = bValue
	btnSPrcMinus.enable = bValue
	btnSPrc.enable = bValue
	btnSPrcPlus.enable = bValue
	
	'비활성이거나 종목탭변경시 초기화 사용인 경우 가격 클리어
	if bValue = false or g_szChangeInit = "1" then
		edtSPrc.caption = ""
	end if
End Function

'============================================================================
' 계좌 비밀번호 체크
'============================================================================
Function f_CheckAccount()
	if Len(Form.GetCtlProp("#edtFundCd", "caption")) < 4 then	'20200331 HWG : 고유MTS
		Form.ShowAlert("알림", "펀드코드를 확인후 다시 입력하십시오.")
		return false
		
	elseif Trim(Form.GetCtlProp("#edtPwd", "caption")) = "" then
		Form.ShowAlert("알림", "비밀번호를 확인후 다시 입력하십시오.")
		return false
		
	end if
	
	return true
End Function

