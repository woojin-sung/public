'주문설정값
Dim g_szOdrPop
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szAfterOrg
Dim g_szSelQty
Dim g_szSelQtyCnt

Dim g_szTempPrc '현재가에서 넘어온 가격 잠시 저장
Dim g_szTempCnt '보유잔고에서 넘어온 수량 잠시 저장

Dim g_szItemCode '종목코드
Dim g_szExchName '거래소명

Dim g_szType '주문유형 지정가:2, 시장가:1, STOP:3, S/L:4
Dim g_nSelCnt '수량 가:1, 청:0
Dim g_szTickSize '틱사이즈

Dim	g_szWarnFlag ' 주문 경고 확인플래그

g_szTempPrc = ""
g_szTempCnt = ""
g_szType = "2"
g_nSelCnt = 0
g_szTickSize = "0"
g_szWarnFlag = "N"

'============================================================================
' 주문후 초기화
'============================================================================
Function f_InputClear()
	edtCnt.caption = ""
	edtLPrc.caption = ""
	edtSPrc.caption = ""
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	'20200331 HWG START : 고유MTS
	g_szSelQty     = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_SELQTY")	' 매도수량 자동입력
	g_szSelQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_SELQTYCNT")	' 매도수량 계약수(수량입력 선택시)
	'20200331 HWG END
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170726 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170726 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매도수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelQty) = "" then
		g_szSelQty = "0"		
	end if
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup()
	Dim szData
	'20200331 HWG START : 고유MTS
	szData = Form.GetCtlProp("#edtFundCd", "caption")							' 펀드코드
	szData = szData & "|" & Form.GetCtlProp("#lblFundNm", "caption")			' 펀드명
	szData = szData & "|" & g_szItemCode										' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szItemCode, "name")			' 종목명
	szData = szData & "|" & rdoType.GetRadioCaption(rdoType.currentindex)		' 주문구분
	'기간
	if rdoDG.currentindex = "0" then
		szData = szData & "|" & "DAY"
	elseif rdoDG.currentindex = "1" then
		szData = szData & "|" & "GTD"
		if cldGTD.caption <> "" and Len(cldGTD.caption) = 8 then
			szData = szData & " (" & Mid(cldGTD.caption,1,4)
			szData = szData & "/" & Mid(cldGTD.caption,5,2)
			szData = szData & "/" & Mid(cldGTD.caption,7,2) & "까지)"
		end if
	end if
	szData = szData & "|" & edtLPrc.caption									' 주문가격
	szData = szData & "|" & edtSPrc.caption									' 조건가격
	szData = szData & "|" & edtCnt.caption									' 주문수량
	
	Form.OpenPopup("nbnts03000_p4", szData , "")		' 주문확인팝업 오픈
	'20200331 HWG END
End Function

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	'20200331 HWG START : 고유MTS
	if g_szSelQty == "1" then			' 신규가능수량
'		if Len(Form.GetCtlProp("#acnt", "caption")) = 10 then
'			g_nSelCnt = 1
'			f_RequestCnt() '가능수량 조회
'		end if
	elseif g_szSelQty == "2" then		' 청산가능수량
'		if Len(Form.GetCtlProp("#acnt", "caption")) = 10 then
'			g_nSelCnt = 2
'			f_RequestCnt() '가능수량 조회
'		end if
	elseif g_szSelQty == "3" then		' 수랑입력
		edtCnt.caption = g_szSelQtyCnt
	end if
	'20200331 HWG END
End Function

'============================================================================
Sub Form_OnFormInit()
	' 에디트 폰트 크기 자동 조정 체크시 안드로이드에서 힌트글자가 작아져서 초기화 넣어줌
	edtCnt.caption = ""
	edtLPrc.caption = ""
	edtSPrc.caption = ""
	
	Load_OrderSet() '주문설정값 읽어오기
	
	Dim szItemCode
	szItemCode = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0) '최근조회종목
	
	if szItemCode <> nil and szItemCode <> "" then
		f_FormStart(szItemCode)
	end if
	
	f_LPrcEnable(true) '주문가격 활성 셋팅
	f_SPrcEnable(false) '조건가격 활성 셋팅
	btnSel.caption = "지정가 매도주문"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "PRC" then '현재가에서 가격 넘어옴
		g_szTempPrc = sParam
		edtLPrc.caption = g_szTempPrc
		
	elseif sEventName = "QTY" then '잔고에서 수량 넘어옴
		g_szTempCnt = sParam
		edtCnt.caption = g_szTempCnt
		
	elseif sEventName = "HOGA" then	'메인화면의 호가 클릭시
		if Trim(sParam) <> "" then
			f_SetPrc(sParam) '가격셋팅
		end if
	
	elseif sEventName == "AUTO_PRICE" then '자동가격입력
		if Trim(sParam) <> "" and g_szTempPrc = "" then
			f_SetPrc(sParam) '가격셋팅
		end if
		
		g_szTempPrc = ""
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then
			if g_szTempCnt = "" then
				Return_AutoQty()
			end if
		end if
		
		g_szTempCnt = ""
		
	elseif sEventName == "ITEMCODE" then '다른탭에서 종목변경시 종목받아옴
		f_FormStart(sParam)
	
	elseif sEventName = "CHANGE_FUNDCD" then '계좌번경	
		'20200331 HWG START : 고유MTS
		if g_szTempCnt == "" and  g_szTempPrc <> "" then	
			edtCnt.caption = ""
		elseif g_szTempCnt <> "" and  g_szTempPrc == "" then
			
		else
			edtCnt.caption = ""
			edtLPrc.caption = ""
			edtSPrc.caption = ""
		end if
		'20200331 HWG END
	
	elseif sEventName = "GTD" then '거래정지일자
		if sParam <> nil and sParam <> "" then
			cldGTD.caption = sParam
		end if
		
	end if
End Sub

'============================================================================
' 가격 셋팅
' sParam : 셋팅가격
'============================================================================
Function f_SetPrc(sParam)
	edtLPrc.caption = ""
	edtSPrc.caption = ""
	
	if tonumber(sParam) > 0 then
		'지정가, S/L 주문가격 셋팅
		if g_szType = "2" or g_szType = "4" then
			edtLPrc.caption = sParam
		end if
		
		'STOP, S/L 조건가격 셋팅
		if g_szType = "3" or g_szType = "4" then
			edtSPrc.caption = sParam
		end if
	end if
End Function

'============================================================================
'화면 시작
'============================================================================
Function f_FormStart(szItemCode)
	if szItemCode <> nil and szItemCode <> "" then
		if g_szChangeInit == "1" then '종목변경시 인풋항목 초기화
			if g_szTempPrc = "" and g_szTempCnt = "" then
				f_InputClear()
			end if
		end if
		
		g_szTickSize = "0"
		if g_szItemCode <> szItemCode then
			edtLPrc.caption = ""
			edtSPrc.caption = ""
		end if
		g_szItemCode = szItemCode
		g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
		g_szTickSize = Form.GetItemCodeInfo( g_szItemCode , "ticksize")
	end if
end Function

