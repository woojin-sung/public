'============================================================================
' 01.화면명 	: 펀드검색
' 02.화면설명	: 펀드검색_관심펀드탭
' 03.작성		: 2016.02.11
' 2021.07.12 정효영 : 고난도 금융투자상품 추가 v0001
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szSelectedIdx	'그리드 선택된 인덱스
dim	g_szFundName		'펀드명
dim	g_szAlertTitle	'알림타이틀
dim	g_szSaleChanTp	'선택된아이템 판매채널

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'getGradeColor	:	 등급코드 색상을 리턴한다.
'============================================================================
Function getGradeColor (szOrgGrad)
	if		szOrgGrad = "01"	then
		return "1"
	elseif	szOrgGrad = "02"	then
		return "101"
	elseif	szOrgGrad = "03"	then
		return "207"
	elseif	szOrgGrad = "04"	then
		return "202"
	elseif	szOrgGrad = "05"	then
		return "56"
	elseif	szOrgGrad = "06"	then
		return "158"
	else
		return "4"
	end	if
End Function


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	DATAMANAGER.RequestTranData("oocwi_mall_002r")
			
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'btnCaution01_OnClick
'============================================================================
Sub btnCaution01_OnClick()
	Form.OpenFramePopup("mbfnp51000_p3" , sOpenData , sPosInfo)
End Sub


'============================================================================
'grd01T4_OnClickUp
'============================================================================
Sub grd01T4_OnClickUp(lRow, szCellID)
	g_szShortCd		=	grd01T4.GetCellData("bd_cell0", lRow)
	g_szStndCd		= 	grd01T4.GetCellData("bd_cell5", lRow)
	g_szFundName		=	grd01T4.GetCellData("bd_name", lRow)
	g_szSaleChanTp	=	grd01T4.GetCellData("bd_cell1", lRow)
	
	g_szSelectedIdx = 	lRow
	
	listLocation =  Split(grd01T4.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "1"
	
	'21.07.26 JHY START : 클릭했을때 이동 하는 팝업 신규가입이었던것 신규 매수로
	'v0001
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "펀드상세" & "★" & "다른클래스" & "★" & "관심펀드삭제" & "★" & "신규매수" & "★" & "판매채널" &  g_szSaleChanTp & "★" & " ")
	'21.07.26 JHY END
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"oocwi_mall_002r"	then
		'관심펀드		
		DATAMANAGER.ClearInputData(0, "oocwi_mall_002r")
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "PROS_CLS_CODE", 0 , "2")
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n002Cnt
	dim	szOrgGrad, szTransGrad, szColor, szDataCnt
	dim	bIsmore		'다음데이터있는지.
	
	dim szFee, szSaleChan, szCDSC_yn, szCLEN_yn, szCLAS_yn, szWaFd_yn, szCNVR_yn, szPNSN_yn, szAPAN_yn, szPfSv_yn 'v0002
	dim div3_cnt			'펀드 한글클래스 3차분류 갯수
	
	bIsmore	=	false
	
	if	szTranID	=	"oocwi_mall_002r"	then
	
		n002Cnt 	=	grd01T4.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "oocwi_mall_002r", "OutBlock2")
		nMulti =  ( n002Cnt / szDataCnt ) - 1
		
		for	i=0+(nMulti * szDataCnt) to	n002Cnt-1
		
			div3_cnt		= 0
			szOrgGrad 	 =	grd01T4.GetCellData("bd_grade", i)
			
			szTransGrad =  Form.GetMetaData("집합투자증권상품등급코드", szOrgGrad)
			szColor	=	getGradeColor (szOrgGrad)
			grd01T4.SetCellFgColor("bd_grade", i, szColor)
			grd01T4.SetCellData("bd_grade", i, szTransGrad)
			
			'1. 계열사구분코드 > 변환 매크로 v0001 sta
