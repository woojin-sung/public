End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub



'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim	nIntrIdx 
	nIntrIdx  = 0
	
	szListItems	=	split(sRet,"★")
		
	if sKeyName = "MOVEPOP_RETURN"	then				'미니팝업처리

	
		if	szListItems(1)	=	"0"	then		'펀드상세
			Form.OpenFramePopup("mbfnp51000_p2", g_szShortCd & "★" & g_szStndCd & "★" & g_szFundName & "★" & g_szSaleChanTp, sPosInfo)
			
		elseif	szListItems(1)	=	"1" then		'다른클래스 펀드
		
			Form.OpenPopup("mbfnp51000_p4" , g_szShortCd, sPosInfo)
		
		elseif 	szListItems(1)	=	"2"	then		'관심삭제
			
			grd01T4.SetDeleteRow(g_szSelectedIdx)
	
			nIntrIdx = grd01T4.rowcount
			
			'3. 등록 TR 전송
			DATAMANAGER.ClearInputData(0, "oocwi_gmyg_011a")
			
			if nIntrIdx	=	"0"	then
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", 0  , "1")	'집합투자증권 1
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", 0, "0001")
			else
				for	i = 0	to	nIntrIdx -1 
					DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", i  , "1")	'집합투자증권 1
					DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", i, grd01T4.GetCellData("bd_cell0", i))
				next
			end if
			
			DATAMANAGER.SetEventFlag("oocwi_gmyg_011a", "A")
			DATAMANAGER.RequestTranData("oocwi_gmyg_011a")
		elseif	szListItems(1)	=	"3"	then			'신규매수
			Form.OpenScreen("51010" , g_szShortCd & "★" & g_szStndCd  & "★" & g_szFundName) 
			
		end if
	end if
	
End Sub



