--===========================================================================
' 2019.10.16 - 자동조회 기능추가
--===========================================================================

Dim g_szItemCode '종목코드
Dim g_szQty '청산가능수량

'============================================================================
Sub Form_OnFormInit()
	if Form.GetCtlProp("acnt", "total") <> "" then
		DATAMANAGER.RequestTranData( "obtrd_acnt_702r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtrd_acnt_702r" then 
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_702r", "InBlock1", "ACNO" , 0 , Form.GetCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_702r", "InBlock1", "ASNO" , 0 , Form.GetCtlProp("acnt", "sequence"))
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_702r", "InBlock1", "FTOT_TPCD" , 0 , "A")
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_702r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_acnt_702r" then
		Dim nCount, nIndex
		
		nCount = DATAMANAGER.GetDataCount( false, "obtrd_acnt_702r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount step 1
				Dim szDealCode, szOTST_VPAL_FAMT, szCRCD
				
				szDealCode = DATAMANAGER.GetDataValue( false, "obtrd_acnt_702r", "OutBlock1", "DEAL_CLS_NAME" , i )'매매구분코드 1:매수, 2:매도
				szOTST_VPAL_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_acnt_702r", "OutBlock1", "OTST_VPAL_FAMT" , i )
				szCRCD = DATAMANAGER.GetDataValue( false, "obtrd_acnt_702r", "OutBlock1", "CRCD" , i )
				szRATE = DATAMANAGER.GetDataValue( false, "obtrd_acnt_702r", "OutBlock1", "RATE" , i ) '평가율
				
				if szDealCode = "매수" then
					grdData.SetCellData("Deal", nIndex+i, "매수")
					grdData.SetCellFgColor("Deal", nIndex+i, "1")
				elseif szDealCode = "매도" then
					grdData.SetCellData("Deal", nIndex+i, "매도")
					grdData.SetCellFgColor("Deal", nIndex+i, "2")
				end if
				
				if szCRCD = "KRW" or szCRCD = "JPY" then
					nPosition = 0
				else
					nPosition = 2
				end if
				
				if szOTST_VPAL_FAMT <> nil and szOTST_VPAL_FAMT <> "" then
					if tonumber(szOTST_VPAL_FAMT) > 0 then
						grdData.SetCellFgColor("bd_cell6", nIndex+i, "1")
					elseif tonumber(szOTST_VPAL_FAMT) < 0 then
						grdData.SetCellFgColor("bd_cell6", nIndex+i, "2")
					end if
					grdData.SetCellData("bd_cell6", nIndex+i, FormatNumber(szOTST_VPAL_FAMT, nPosition))
				end if
				
				if szRATE <> null and szRATE <> "" then
					if tonumber(szRATE) > 100 then
						grdData.SetCellFgColor("bd_cell7", nIndex+i, "1")
					elseif tonumber(szRATE) < 100 then
						grdData.SetCellFgColor("bd_cell7", nIndex+i, "2")
					end if
				end if
			next
		end if
		
		if btnAuto.caption = "수동" Then  '수동으로 되어 있는 상태가 자동조회되고 있는 상태임
			'Form.SetTimerEvent(0, 1, 5)
		else
			'Form.SetTimerEvent(0, 0, 5)
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
'	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		
'	if Trim(szSubMsg) <> "" then
'		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
'	else
'		Form.ShowAlert("알림", szErrMsg)
'	end if
	if szTranID == "obtrd_acnt_702r" then
		Form.SetTimerEvent(0, 0, 5)
	end if
End Sub


'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrd_acnt_702r" )
End Sub

'============================================================================
' 2019.10.16 - 자동조회 기능추가
Sub btnAuto_OnClick()
	if btnAuto.caption = "자동" Then
		Form.SetTimerEvent(0, 1, 5)
		btnAuto.caption = "수동"
	else
		Form.SetTimerEvent(0, 0, 5)
		btnAuto.caption = "자동"
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 0 or sTimerID == "0" then
		DATAMANAGER.RequestTranData( "obtrd_acnt_702r" )
	end if
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrd_acnt_702r" )
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	DATAMANAGER.RequestTranData( "obtrd_acnt_702r" )
End Sub

'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	Dim tlistLocation, nYPos, nheight, szExchName
	
	g_szItemCode = grdData.GetCellData("ItemCode", lRow)
	if Trim(g_szItemCode) == "" then
		Exit Sub
	end if
	
	tlistLocation =  Split(grdData.location,":")
	nYPos = Int(tlistLocation[1])
	nheight = tlistLocation[3]
	szExchName = Form.GetItemCodeInfo(g_szItemCode, "exchname")
	g_szQty = grdData.GetCellData("Qty", lRow)
	
	Form.OpenPopup("movepopup" , nYPos & "★" & nheight & "★" & "2" & "★" &  szExchName  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "MOVEPOP_RETURN" then
		Dim tChk, szChk, szQty
		
		if sRet == "" then
			Exit Sub
		end if
		
		tChk = Split(sRet, "★")
		szChk = tChk(0)
		
		If szChk <> "" Then
			If tChk(1) == "0" Then						' 현재가
				Form.OpenScreen("43100", g_szItemCode)
			ElseIf tChk(1) == "1" Then					' 매수
				Form.OpenScreen("44300", "보유잔고★0" & "★" & g_szItemCode & "★" & g_szQty)
			ElseIf tChk(1) == "2" Then					' 매도
				Form.OpenScreen("44300", "보유잔고★1" & "★" & g_szItemCode & "★" & g_szQty)
			End If
		End If
	end if
End Sub 

