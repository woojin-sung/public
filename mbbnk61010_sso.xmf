Sub Container0_EditInput1_OnEditComplete()

     If CInt(Container0.EditInput1.pwdlen) < 6 Then 
         Form.MsgBox("알림", "6글자 이상 입력해 주세요." , "", 0)
         Exit Sub
     End If

	DATAMANAGER.RequestTranData( "obcsb_oimf_174a" )
End Sub

'============================================================================
Sub Container0_EditInput1_OnClick()
	Container0.EditInput1.SetResultLabel("0", "complete", "", "Container0" )
	If Len(Trim(g_mSBValue)) <= 0 Or Len(Trim(g_mOTPsrno)) <= 0 Then
		g_mSBValue	= Form.GetSharedData( "mOTP_MsbVrsn", True )
		g_mOTPsrno	= Form.GetSharedData( "mOTP_OTPSrno", True )
	End If
End Sub

