'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 간편인증_이체
' 02. 화면설명 : 간편인증/mOTP
' 03. 작    성 : 2021.02.21
' 2021.05.27 : 정민영 : v001 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID, g_nOTPCnt, g_sSmartYN '사용자ID, OTP인증처리횟수, SmartOTP여부값
Dim g_nOTPPreCnt		'OTP 사전정보전송 cnt
Dim	g_PlainRm 'v003

'-------------------------------------------------------
'90020 은행/지점 개설계좌 ID등록 화면에서 팝업시 사용
'-------------------------------------------------------
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array
Dim g_bIsFromIDReg	'True : 은행/지점개설계좌ID 화면에서 팝업, False : 그외 화면에서 팝업

'g_szList(0) : "지점"
'g_szList(1) : 필수정보입력_고객구분(내국인/외국인/법인)
'g_szList(2) : 필수정보입력_고객식별번호
'g_szList(3) : 필수정보입력_계좌번호
'g_szList(4) : 필수정보입력_계좌비밀번호
'g_szList(5) : 필수정보입력_사용자ID
'g_szList(6) : 필수정보입력_ID비밀번호
'-------------------------------------------------------
Dim szText
Dim g_sAthnType
Dim g_sTrData
Dim g_sTranCrpt
Dim g_sSmrtOtpYn
Dim g_szChk

Dim	g_mSBValue, g_mOTPInfo, g_mOTPAlias, g_mOTPData, g_DeviceID
Dim	sTRcntt, sTRNo, sHourVal
Dim	g_RcnoPip, g_Csno, g_sUserNM
Dim	g_MotpAthnYn, g_SpinAthnYn

'20190905 LES START 공인인증 최대오류횟수 변경
Dim DEF_CERT_PSWD_LIMIT_CNT
DEF_CERT_PSWD_LIMIT_CNT = 5
'20190905 LES END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "이체확인" then
		if g_sSpinCertYn <> "Y" then
			Form.MsgBox("알림", "간편인증 비밀번호를 입력하세요", "", 6)
			Exit Sub
		end if
		
		If g_MotpAthnYn == "Y" And g_SpinAthnYn == "Y" Then
			Form.triggerEvent("#", "인증서", "Success")
		Else
			Form.ShowAlert("알림", "인증이 완료되지 않았습니다.")
		End If
	end if   
	If sEventName == "mOTP_Gen" Then
		g_mOTPData = Form.GetSharedData( "mOTP_SrnoGen", True )
		DATAMANAGER.RequestTranData("obcsb_oimf_176a")
	End If
End Sub
'============================================================================

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Function f_InitDataSetting()
	g_sUserID	= Form.GetSharedData( "&USER_ID"	, false )	'사용자ID
	g_RcnoPip	= Form.GetSharedData( "&JUMIN_NUM"	, false )   '주민번호 암호화 값
	g_sUserNM	= Form.GetSharedData( "&USER_NAME"	, false )	'고객명
	g_Csno	= Form.GetSharedData( "&CUST_NUM"	, false )	'고객번호
	g_DeviceID	= Form.GetDeviceID() 

End Function

'============================================================================
Sub Form_OnFormInit()

	Dim szData
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v003
    
	Container0.EditInput1.SetApplyLabel("모바일 OTP 비밀번호", 0, 76, "left", true)
	Container0.EditInput1.SetUseResultLabel(True, 2)
	EdtSpinPwd.SetApplyLabel("간편인증비밀번호", 0, 76, "left", true)
	
	EdtSpinPwd.enable = False
	
	f_InitDataSetting() '초기 데이터 설정.
	
	'v003
'	If g_PlainRm = "1" Then '보안모듈 적용
'		Container0.EditInput1.SetEncExcept()
'	End If

	'Edit0.certname = "공인인증서 비밀번호 입력"	
'	Container0.EditInput1.certname = "OTP번호 입력"
	g_sSmartYN = "N"
	g_nOTPCnt = 0
	g_nOTPPreCnt = 0
	g_sRetData = "cancel"
	g_sAthnType = "2"		'거래연동인증
	g_szChk = "1"
	
	g_sTrData = Form.GetSharedData("OTP_TR_MSG_1", false )

	Container0.enable = TRUE
	Container0.EditInput1.enable = TRUE
	
'	'-------------------------------------------------------
'	'90020 은행/지점 개설계좌 ID등록 화면에서 팝업시
'	'-------------------------------------------------------
	g_bIsFromIDReg = False
	szData = Form.GetOpenLinkData()
	
	if szData == "" or szData == Null then
		g_sSendData = ""
	else
		g_sSendData = szData
	end if
	
	if Trim(g_sSendData) <> "" or Trim(g_sSendData) <> Null then
		g_szList = Split(g_sSendData,"★")		
	end if
	
	'그외 화면에서 팝업한 경우
	if #g_szList < 2 then	'16-04-15 YCJ if UBOUND(g_szList) < 1 then 였던 부분 수정
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
	
		Form.SetScreenName( "보안매체 인증" )
	
		if g_sUserID ~= null and g_sUserID ~= "" then
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		end if
		
	'은행/지점개설계좌ID 화면에서 팝업한 경우
	else
		g_bIsFromIDReg = True
		Form.SetScreenName( "지점개설계좌ID등록" )
	End if
	'-------------------------------------------------------
	BtnSpinPwd.bringFront()	
	'Form.MsgBox( g_sTrData)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"   , 0 , g_sUserID )
		
	ElseIf szTranID == "obcsb_oimf_174a" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_PROS_CLCD"  	, 0 , "TRTI")
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"                 , 0 , "")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"             , 0 , g_RcnoPip)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"              , 0 , g_sUserID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"                 , 0 , g_Csno)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MSBO_VRSN"            , 0 , g_mSBValue)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_SRNO"            , 0 , RIGHT(g_mOTPsrno, 12))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_TERM_ID"         , 0 , g_DeviceID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_ATHN_TYPE_CLCD"  , 0 , "10")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_ATHN_DATA_CNTT"  , 0 , Container0.EditInput1.caption )
		
	elseif szTranID == "obcsb_oimf_176a" then
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_PROS_CLCD" , 0 , "NBVR")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"           , 0 ,  g_Csno)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"        , 0 ,  g_sUserID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MSBO_VRSN"      , 0 ,  g_mSBValue)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_SRNO"      , 0 ,  RIGHT(g_mOTPsrno, 12))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_TERM_ID"   , 0 ,  g_DeviceID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_TR_NO"     , 0 ,  sTRNo)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOTP_PWD_PIP"   , 0 ,  g_mOTPData)

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		g_sSmrtOtpYn = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0 )
		
		if sRSLT_CLS == "3" then 'OTP
			if sSCRC_STAT_CODE == "0" then '정상
				Form.requestMOTP("MOTP_GET_VERSION" , "" , "61010p0")     'mSB 버전값 획득위한 호출
				Form.requestMOTP("MOTP_GETINFO"     , "" , "61010p0")     '등록된 OTP alias 존재하는지 확인
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if

	elseif szTranID == "obcsb_oimf_174a" then
		
		sTRcntt  = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_CNTT" , 0 )
		sTRNo    = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_NO"   , 0 )
		sHourVal = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_HOUR_VAL", 0 )
		sErrCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_ERR_CODE", 0 )
		sErrCntt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_ERR_CNTT", 0 )
		
		if sErrCode == "000000" then
			szData = g_mOTPsrno.."★".."02010".."★"..sHourVal.."★"..sTRcntt '기관코드(siteCode) 02010으로 고정
			Form.triggerEvent("#", "mOTP_GenReq", szData)
		else
			Form.MsgBox("알림", sErrCntt, "", 6)
		end if
		
	elseif szTranID == "obcsb_oimf_176a" then
		sErrCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_176a", "OutBlock1", "MOTP_ERR_CODE", 0 )
		sErrCntt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_176a", "OutBlock1", "MOTP_ERR_CNTT", 0 )
		
		if sErrCode <> "000000" then
			Form.MsgBox("알림", sErrCntt, "", 6)
		else
			Container0.EditInput1.SetResultLabel("1", "complete", "인증이 완료되었습니다.", "Container0")
			Container0.EditInput1.enable = False
			g_MotpAthnYn = "Y"
			BtnSpinPwd.enable = TRUE
		end if
			
	elseif szTranID == "obcpp_logn_015a" then
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)

		nCount = CInt(sMstk)
		if nCount >  0 then	
			'Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")	
			'1. 공인인증 5회이상 초과
			if CInt(sMstk) >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 앱이 종료됩니다.", "CERT_PSWD_FAIL_APP_TERMINATE", 0)
				Exit Sub
			
			'2. 공인인증 오류횟수 5회 미만
			else
				Form.MsgBox( "알림",  "인증 비밀번호 " + CInt(sMstk) + "회 오류입니다. 5회 오류 초과시 업무진행이 불가능 합니다.", "", 0)
			end if
			
			'3. 오류횟수 공유변수 저장 (공인인증 오류횟수는 공유변수로 앱 종료전까지 모든화면이 공유)
			Form.SetSharedData("CERT_PWD_ERR_CNT" , sMstk)
		
		
		'-----------------------------------------------------
		' 인증서 비밀번호 일치시
		'-----------------------------------------------------
		else
			
			' 기존) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 가능
			' 변경) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 불가
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
			'4. 공유 오류횟수 > 최대 오류횟수 : 업무진행 불가 메세지
			if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				Exit Sub
			
			'5. 공유 오류횟수 < 최대 오류횟수 : 공유 오류횟수 초기화
			else
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0)
			end if
		    
		end if
	
	'20160517 OCSP검증 추가
	elseif szTranID == "ohhts_ocsp_001r" then
		sStatCode =  DATAMANAGER.GetDataValue( 0,"ohhts_ocsp_001r", "OutBlock1", "STAT_CLS_CODE" ,0) '상태구분코드

		if sStatCode == "Y" then
			szText = "Success"
			g_SpinAthnYn = "Y"
		end if
	'20160517 END	
	
	end if
	
	'ID 등록요청
	if szTranID == "obcsb_efif_060a" then	
		Dim sSucsYN
		sSucsYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SUCS_YN" , 0)
		if sSucsYN == "Y" then
			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 6 )
		elseif sSucsYN == "N" then
			Form.MsgBox( "알림", "ID등록이 실패하였습니다. 해당 영업점 또는 고객지원센터(1588-3400)로 문의 바랍니다.", "", 6 )
		end if
		
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "obcsb_oimf_174a" then
		If szErrCode == "2424" Then
			Form.ShowAlert( "인증오류횟수 초과", "모바일 OTP 비밀번호 5회 오류로 OTP 사용이 불가합니다.\n모바일 OTP 비밀번호를 재설정 후 이용해주시기 바랍니다.")
		Else
			Container0.EditInput1.SetResultLabel("1", "error", szErrMsg&"\n["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "Container0" )
		End If
	End If
	
	If szTranID == "obcsb_oimf_176a" then
		Container0.EditInput1.SetResultLabel("1", "error",  szErrMsg&"\n["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "Container0")
	End IF
End Sub
 
'============================================================================
Sub ButtonOK_OnClick()
	if Container0.EditInput1.caption == null or Container0.EditInput1.caption == "" then
		Form.MsgBox( "알림", "OTP 카드 비밀번호를 입력해주세요.", "", 6 )
	else
		if g_sSmartYN == "Y" then 'SmartOTP인경우 PIN번호확인
			if (Container1.EditPin.caption == null or Container1.EditPin.caption == "") and g_sAthnType = "9" then
				Form.MsgBox( "알림", "PIN번호를 재조회해주세요.", "", 6 )	
			else
				g_nOTPCnt = 0
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			end if
		else
			g_nOTPCnt = 0
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	Dim sDN                 '공인인증 과정으로 ???
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		g_sRetData = "ok"
		sDN = Form.GetSharedData("&USER_CERT_DN" , false)	
		Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
	'20190905 LES START 공인인증 최대오류횟수 변경
	elseif sKeyName == "CERT_PSWD_FAIL_APP_TERMINATE" then
		sDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
		
		if sDeviceOS = "2" then
			Form.restartApp()
		else	
			Form.TerminateApp()
		end if
	'20190905 LES END
	
	end if
End Sub
'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	if sType == "RetIsCertPasswordValid" then
		if sParam1 == "Success" then
		
			'20160517 OCSP검증 추가
			sLoginType = Form.GetSharedData( "&LOGIN_TYPE", false ) '0.권한없음 1.시세조회전용 2.공인인증로그인 3.ID+공인인증로그인
			
			if sLoginType == "2" or sLoginType == "3" then
				szText = "Success"
				Request_ohhts_ocsp_001r()
			else
				'원래소스
				szText = "Success"
				g_SpinAthnYn = "Y"
			end if
			'20160517 END
				
		elseif sParam1 == "Failed" then '  비밀번호 오류	     
			Request_obcpp_logn_015a("N")
			Edit0.caption = ""
		elseif sParam1 == "Error" then ' 인증서 업승ㅁ
			Form.ShowAlert("알림", "인증서 없습니다.\n\n다시 확인하시기 바랍니다.")
		end if		
	end if
End Sub

'============================================================================
'20160517 OCSP검증 추가
Sub Request_ohhts_ocsp_001r()
	'--------------------------------------------------------
	sUserID		= Form.GetSharedData( "&USER_ID"		, false )	'사용자ID
	sRcNo 		= Form.GetSharedData( "&JUMIN_NUM"		, false )	'실명확인번호 'v004 메모리취약점보완이후 암호화된실명번호로 내려옴
	sUserName 	= Form.GetSharedData( "&USER_NAME"		, false )	'고객명
	sCsNo 		= Form.GetSharedData( "&CUST_NUM"		, false )	'고객번호
	sCertPass 	= Edit0.caption									'인증비밀번호
	sDN 			= Form.GetSharedData( "&USER_CERT_DN"	, false )	'DN값
	'--------------------------------------------------------
	
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "USER_ID" 				, 0 , sUserID ) 	'사용자ID
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "RCNO_PIP" 				, 0 , sRcNo) 		'실명확인번호 v004 RCNO->RCNO_PIP
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "USER_NAME" 				, 0 , sUserName ) '고객명
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "CSNO" 					, 0 , sCsNo) 		'고객번호
	
	sRValue = Form.GetRvalue( sDN , sCertPass)
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "UI_R_VAL" 				, 0 , sRValue) 	'R 값	
				
	sSignData = Form.GetCertSignData( sDN , sCertPass)
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" 	, 0 , sSignData) 	'전자서명데이타
	
	sSerialNum = Form.getCertSerialNumber( sDN)
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "NTAT_SRNO" 				, 0 , sSerialNum) '인증서 일련번호
	
	DATAMANAGER.RequestTranData("ohhts_ocsp_001r")
End Sub
'20160517 END

Sub Request_obcpp_logn_015a(szSucs_YN)
	szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "USER_ID" , 0 , szUserId ) '사용자ID
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 		'성공여부	
	DATAMANAGER.RequestTranData("obcpp_logn_015a")
End Sub

