		<EDIT name="EdtSpinPwd" enable="0" imetype="0" hintcaption="간편인증비밀번호를 입력해주세요." clearall="0" imagefilepth="input_03.9" ly_vert="1,142,334,74,1" />
		<BUTTON name="ButtonOK" enable="0" visible="0" ly_vert="10,222,40,26,0" />
		<CONTAINER name="Container0" scroll_pos="0,0" ly_vert="1,10,334,128,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<EDIT name="EditInput1" fontsize="-2" password="2" imetype="1" maxlength="6" minlength="6" hintcaption="비밀번호 6자리를 입력해주세요." imagefilepth="input_03.9" ly_vert="0,14,334,74,1" />
			</CONTROL_INFO>
