'============================================================================
Sub BtnSpinPwd_OnClick()
	Form.OpenPopup("mhetc90060_px", "", "") 
End Sub


'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			g_sSpinCertYn = "Y"
			EdtSpinPwd.caption = "＊＊＊＊"
			if Container0.EditInput1.caption == null or Container0.EditInput1.caption == "" then
				Form.MsgBox( "알림", "OTP 카드 비밀번호를 입력해주세요.", "", 6 )
				Exit Sub
			elseif g_sSpinCertYn <> "Y" then
				Form.MsgBox("알림", "간편인증 비밀번호를 입력하세요", "", 6)
				Exit Sub
			else
				g_SpinAthnYn = "Y"
				If g_MotpAthnYn == "Y" Then
					Form.triggerEvent("#", "인증서", "Success")
				End If
			end if
		ElseIf sRet == "cancel" Then
			g_sSpinCertYn = "N"
			'EdtSpinPwd.caption = ""
		End If
	End If
	
End Sub

