			</PAGE>
			<PAGE name="page006406" caption="15:00" >
				<CONTROL_INFO/>
			</PAGE>
		</TAB>
		<LABEL name="Label10" caption="예약 시간 선택" ly_vert="17,234,186,32,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4967" _ulen="4747" >
--===========================================================================
--===========================================================================
Dim g_rsvID
Dim g_aCode
Dim g_date
Dim g_Time
Dim g_f_Time
Dim rsv_type, stat_type
Dim g_descrip
Dim sYN, REGN_ZIP, DTL_ZIP, POST, DTAD, BLDN
Dim cldToday
Dim Edt_rsvPlace
Dim Edt_rsvDRP
Dim g_u_id, g_u_name
'==============================================================================


'=================================================================================
Sub Form_OnFormInitBefore()
	
	
	
	
	g_aCode = Form.GetSharedData("aCode", true )
	
	g_Time = "09:00"
	cldToday = Form.GetSharedData("&HOST_DATE", false)
	g_u_id = Form.GetSharedData("&USER_ID", false )
	
	rsv_type = 2
	stat_type = 1
	
	g_u_name = Form.GetSharedData("&USER_NAME", false )
	g_u_cphone = Form.GetSharedData("&USER_CELLPHONE", false )
	
		
	if g_aCode == "U" or g_aCode == "u" then
'		g_u_name = Form.GetSharedData("&USER_NAME", false )
'		g_u_cphone = Form.GetSharedData("&USER_CELLPHONE", false )
		g_rsvID = Form.GetSharedData("szrsvID", false )
		Edt_rsvPlace = Form.GetSharedData("szrsvPlace", false )
	
	end if
	
	
End Sub

'=================================================================================
Sub Form_OnFormInit()
	
	g_date = cldToday
	
	if g_aCode == "U" or g_aCode == "u" then
		Edit0.caption = g_u_name
		Edit1.caption = g_u_cphone
		Edit2.caption = Edt_rsvPlace
		
		
	else
		Edit0.caption = g_u_name
		Edit1.caption = g_u_cphone
		Edit2.caption = ""
		Edit3.caption = ""
		
		
	end if

	
	
	
		
End Sub
'=================================================================================
Sub Calendar0_OnEditComplete()

	g_date = Calendar0.caption
		
	if g_date == cldToday then
		Form.ShowAlert("알림", "방문상담은 당일 접수가 불가합니다.")
		
		
	elseif g_date < cldToday then
		Form.ShowAlert("알림", "선택한 예약일자는 영업일이 아닙니다.")
		
		
	end if
	
	
End Sub

'=================================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	
	
	if nCurrentTab == 0 then
			
			g_Time = "09:00"
	
	elseif nCurrentTab == 1 then
			
			g_Time = "10:00"
	
	elseif nCurrentTab == 2 then
		
			g_Time = "11:00"
			
	elseif nCurrentTab == 3 then
		
			g_Time = "13:00"
			
	elseif nCurrentTab == 4 then
		
			g_Time = "14:00"
			
	elseif nCurrentTab == 5 then
		
			g_Time = "15:00"
	
	end if
	
End Sub

'============================================================================
Sub Button0_OnClick()

	if g_date == cldToday then
		Form.ShowAlert("알림", "방문상담은 당일 접수가 불가합니다.")
		Exit sub
		
	elseif g_date < cldToday then
		Form.ShowAlert("알림", "선택한 예약일자는 영업일이 아닙니다.")
		Exit sub	
		
	end if
	
	if Edit0.caption == "" then
		Form.ShowAlert("알림", "이름을 입력해주세요.")
		Exit sub
	elseif Edit1.caption == "" then
		Form.ShowAlert("알림", "전화번호를 입력해주세요.")
		Exit sub
	elseif Edit2.caption == "" then
		Form.ShowAlert("알림", "상담장소를 확인해주세요.")
		Exit sub
	
	
	end if
	
	
	
	g_f_Time = left(g_date,4) &"/"&mid(g_date,5,2)& "/"& right(g_date,2)&" "&g_Time&":00"
	
	g_descrip = Edit3.caption
	
	
	Form.SetSharedData("ck_pros_code" , g_aCode)
	
	Form.SetSharedData("ck_rsvID" , g_rsvID)
	Form.SetSharedData("ck_username" ,Edit0.caption)
	Form.SetSharedData("ck_custtel" ,Edit1.caption)
	Form.SetSharedData("ck_plac" ,Edit2.caption)
	Form.SetSharedData("ck_rsevymdh" ,g_f_Time)
	Form.SetSharedData("ck_prtrcntt" ,g_descrip)
	Form.SetSharedData("ck_rsevcode" ,rsv_type)
	Form.SetSharedData("ck_rsevstat" ,stat_type)
	Form.SetSharedData("ck_userID" , g_u_id)
	
	Form.SetSharedData("check_loca" , Edit2.caption )
	Form.SetSharedData("check_time" , left(g_date,4) &"년"&mid(g_date,5,2)& "월"& right(g_date,2)&"일 "&g_Time)
	
	Form.OpenPopup("mbcpp70140_t2.xmf" , "" , "")
		
	
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.OpenFramePopup( "mbonl81000_p4.xmf" , "" , "" )
End Sub

'============================================================================

Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mbonl81000_p4" then
	
		if sRet == "ok" then
			sYN = Form.GetSharedData("mbonl81000_p4_YN" , false)
			REGN_ZIP = Form.GetSharedData("mbonl81000_p4_REGN_ZIP" , false)
			DTL_ZIP = Form.GetSharedData("mbonl81000_p4_DTL_ZIP" , false)
			POST = Form.GetSharedData("mbonl81000_p4_POST" , false)
			DTAD = Form.GetSharedData("mbonl81000_p4_DTAD" , false)
			BLDN = Form.GetSharedData("mbonl81000_p4_BLDN" , false)
			
					
			Edit2.caption = POST & " " & DTAD & " "
			
			
		end if
	elseif sKeyName == "RESERVATION_CLOSE" then
		if sRet == "1" then
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================

