		<LABEL name="Label0" caption="이름" ly_vert="16,48,100,32,1" />
		<LABEL name="Label1" caption="전화번호" ly_vert="16,88,100,32,1" />
		<LABEL name="Label2" caption="상담장소" ly_vert="16,128,100,32,1" />
		<LABEL name="Label3" caption="상담일시" ly_vert="16,168,100,32,1" />
		<EDIT name="Edit0" imetype="0" senddatafield="obcpp_rbit_022a.InBlock1.USER_NAME" ly_vert="117,49,222,32,1" export="0,0,7" />
		<EDIT name="Edit1" imetype="1" ly_vert="117,89,222,32,1" />
		<EDIT name="Edit2" imetype="0" ly_vert="117,129,222,32,1" />
		<LABEL name="Label5" caption="특이사항" ly_vert="18,318,186,32,1" />
		<CALENDAR name="Calendar0" dispmode="22334656" ly_vert="117,169,222,31,1" />
		<EDIT name="Edit3" multiline="1" imetype="0" hintcaption="연락 가능 시간을 입력해 주세요!" ly_vert="15,346,320,128,1" />
		<BUTTON name="Button0" caption="예약하기" btnimage="btn_05.9" ly_vert="127,501,121,35,1" />
		<BUTTON name="Button1" caption="검색" btnimage="btn_05.9" ly_vert="298,130,42,30,1" />
		<TAB name="Tab0" tabheadheight="36" tabwidthtype="1" tabcount="6" ly_vert="19,265,323,41,1" >
			<PAGE name="09:00" caption="09:00" >
