'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 화상상담 조회/변경
' 02. 화면설명 : 
' 03. 이    력 : 2023.03.07 : 고승연 : v0002 : [T2302170013] 상담가능시간 수정
'                2023.11.10 : 고승연 : v0003 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

Dim g_sAcnt, g_sAcntSub, g_bCheckFlag
Dim g_sAbleStartDate, g_sAbleEndDate
Dim g_sAbleTimeData
Dim g_sAbleStartTime, g_sAbleEndTime
Dim g_sPwd

'============================================================================
Sub Form_OnFormInitBefore()
	ImageStep0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bCheckFlag = false '숙려대상자 플레그
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "001rData" then
		if sParam <> "" then
			Dim tData, sCsno
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			tData = Split(sParam, "|")
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_DATE" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_SRNO" , 0 , tData(1) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_001r" )
		end if
		
	elseif sEventName == "PWD" then
		g_sPwd = sParam
		
		'추가인증
		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_ctad_081r" then
		DATAMANAGER.ClearOutputData( 0, "obwat_ctad_081r" )
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_081r", "InBlock1", "ACNO" , 0 , g_sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_081r", "InBlock1", "ASNO" , 0 , g_sAcntSub )
		
	elseif szTranID == "obcpp_bsdy_006r" then
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CLND_CLS_CODE" , 0 , "C001" )
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "MANG_DATE" , 0 , calTempDate.caption )
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CALC_DYNU" , 0 , "1" )
	
	elseif szTranID == "obwat_ctad_082r" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_082r", "InBlock1", "ACNO" , 0 , g_sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_082r", "InBlock1", "ASNO" , 0 , g_sAcntSub )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_082r", "InBlock1", "RSEV_DATE" , 0 , calDate.caption )
			
	elseif szTranID == "obwat_ctad_083a" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "RSEV_DATE" , 0 , calDate.caption )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "RSEV_APLT_STA_HOUR" , 0 , g_sAbleStartTime )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "RSEV_APLT_FIN_HOUR" , 0 , g_sAbleEndTime )
		
	elseif szTranID == "obwat_onln_002a" then
		if g_bCheckFlag == false then
			DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT4" , 0 , "X" )
		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_001r" then
		Dim sDate, sSrno, sCode, sData1, sData2, sData3
		
		sDate = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_DATE" , 0 )
		sSrno = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_SRNO" , 0 )
		g_sAcnt = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ACNO" , 0 )
		g_sAcntSub = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ASNO" , 0 )
		sCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ISCD" , 0 )
		sData1 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT1" , 0 )
		sData2 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT2" , 0 )
		sData3 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT3" , 0 )
		
		DATAMANAGER.SetEventFlag( "obwat_onln_002a", "U" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_DATE" , 0 , sDate )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_SRNO" , 0 , sSrno )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "PRGS_STAT_CODE" , 0 , "04" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "BSWR_CLCD" , 0 , "01" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ACNO" , 0 , g_sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ASNO" , 0 , g_sAcntSub )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT1" , 0 , sData1 )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT2" , 0 , sData2 )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT3" , 0 , sData3 )
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "ACNO" , 0 , g_sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "ASNO" , 0 , g_sAcntSub )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "NMET_APLT_DATE" , 0 , sDate )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_083a", "InBlock1", "NMET_APLT_SRNO" , 0 , sSrno )
		
		DATAMANAGER.RequestTranData( "obwat_ctad_081r" )
		
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "WA_PRCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
		DATAMANAGER.RequestTranData( "obwat_csad_003r" )
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_791r", "InBlock1", "ACNO" , 0 , g_sAcnt )
		
	elseif szTranID == "obwat_ctad_081r" then
		Dim sNumber, sStartDate, sEndDate
		
		g_sAbleStartDate = DATAMANAGER.GetDataValue( 0, "obwat_ctad_081r", "OutBlock1", "RSEV_STA_DATE" , 0 )
		g_sAbleEndDate = DATAMANAGER.GetDataValue( 0, "obwat_ctad_081r", "OutBlock1", "RSEV_FIN_DATE" , 0 )
		sNumber = DATAMANAGER.GetDataValue( 0, "obwat_ctad_081r", "OutBlock1", "CNPL_TELNO" , 0 )
		
		sStartDate = Mid(g_sAbleStartDate, 3, 2).."."..Mid(g_sAbleStartDate, 5, 2).."."..Mid(g_sAbleStartDate, 7, 2)
		sEndDate = Mid(g_sAbleEndDate, 3, 2).."."..Mid(g_sAbleEndDate, 5, 2).."."..Mid(g_sAbleEndDate, 7, 2)
		
		tblData.SetCellString(0, 1, sStartDate.."~"..sEndDate)
		tblData.SetCellString(1, 1, sNumber)
		
	elseif szTranID == "obcpp_bsdy_006r" then
		Dim sMangDate
		sMangDate = DATAMANAGER.GetDataValue( 0, "obcpp_bsdy_006r", "OutBlock1", "MANG_DATE" , 0 )
		
		if calDate.caption == sMangDate then '선택일이 영업일 맞음
			lblNoDate.visible = false
			lblDate.visible = true
			lblDate.caption = Mid(calDate.caption, 1, 4).."년 "..Mid(calDate.caption, 5, 2).."월 "..Mid(calDate.caption, 7, 2).."일"
			DATAMANAGER.RequestTranData( "obwat_ctad_082r" )
		else
			lblNoDate.visible = true
			lblDate.visible = false
			lblNoTime.visible = true
			lblTime.visible = false
			Form.MsgBox("알림", "휴일은 상담이 불가합니다.\n다른 요일을 선택해 주세요.", "", 8, "확인", "")
		end if
		
	elseif szTranID == "obwat_csad_003r" then
		Dim sHighYN
		sHighYN = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "HGDT_PROD_YN" , 0 )
		
		if sHighYN == "Y" then '고난도이면 전문투자자여부 확인
			DATAMANAGER.RequestTranData( "obcsb_acif_791r" )
		end if
		
	elseif szTranID == "obcsb_acif_791r" then
		Dim sPfinYN
		sPfinYN = DATAMANAGER.GetDataValue( 0, "obcsb_acif_791r", "OutBlock1", "UI_PFIN_YN" , 0 )
		
		if sPfinYN <> "Y" then '전문투자자가 아니면 숙려대상자.
			g_bCheckFlag = true
		end if
		
	elseif szTranID == "obwat_ctad_082r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_ctad_082r", "OutBlock1" )
		nCount = tonumber(nCount)
		g_sAbleTimeData = ""
		
		for i = 0 to nCount-1
			Dim sStartDate, sEndDate, sAbleQty, sApltQty
			
			sStartDate = DATAMANAGER.GetDataValue( 0, "obwat_ctad_082r", "OutBlock1", "STA_HOUR" , i )
			sEndDate = DATAMANAGER.GetDataValue( 0, "obwat_ctad_082r", "OutBlock1", "FIN_HOUR" , i )
			sAbleQty = DATAMANAGER.GetDataValue( 0, "obwat_ctad_082r", "OutBlock1", "RSEV_ABLE_QTY" , i )
			sApltQty = DATAMANAGER.GetDataValue( 0, "obwat_ctad_082r", "OutBlock1", "APLT_QTY" , i )
			
			if i <> 0 then
				g_sAbleTimeData = g_sAbleTimeData.."|"
			end if
			
			g_sAbleTimeData = g_sAbleTimeData..sStartDate.."|"..sEndDate.."|"..sAbleQty.."|"..sApltQty
		next
		
	elseif szTranID == "obwat_onln_002a" then
		Dim sData
		sData = Mid(calDate.caption, 3, 2).."."..Mid(calDate.caption, 5, 2).."."..Mid(calDate.caption, 7, 2).." "..lblTime.caption
		Form.triggerEvent("#", "NEXT", sData)
		
	elseif szTranID == "obwat_ctad_083a" then
		DATAMANAGER.RequestTranData( "obwat_onln_002a" )
		
	end if
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.MsgBox("안내", "Wrap 가입을 취소 하시겠습니까?", "Cancel", 7, "가입취소", "닫기")
End Sub

'============================================================================
Sub btnDate_OnClick()
	calDate.showcalendar = true
End Sub

'============================================================================
Sub calDate_OnEditComplete()
	g_sAbleTimeData = ""
	lblNoTime.visible = true
	lblTime.visible = false
	
	if tonumber(g_sAbleStartDate) <= tonumber(calDate.caption) and tonumber(g_sAbleEndDate) >= tonumber(calDate.caption) then
		calTempDate.caption = calDate.caption
		calTempDate.addday = -1
		DATAMANAGER.RequestTranData( "obcpp_bsdy_006r" ) '영업일 조회
	else
		lblNoDate.visible = true
		lblDate.visible = false
		Form.MsgBox("알림", "예약 가능 일자를 확인해 주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub btnTime_OnClick()
	if lblDate.visible == true or lblDate.visible == "1" then
		Form.OpenPopup("mbwat61022_p5" , g_sAbleTimeData, "")
	else
		Form.MsgBox("알림", "예약일자를 선택해주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	if g_bCheckFlag then '숙려대상자는 팝업확인
		Form.OpenPopup("mbwat61022_p6", "", "")
	else
		Form.triggerEvent("#", "GETPWD", "")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "ABLETIME" then
		if sRet <> null and sRet <> "" then
			Dim tData
			tData = Split(sRet, "|")
			
			lblTime.caption = tData(0)
			g_sAbleStartTime = tData(1)
			g_sAbleEndTime = tData(2)
			
			lblNoTime.visible = false
			lblTime.visible = true
			
			btnConfirm.enable = true
		end if
		
	elseif sKeyName == "Check" then '숙려대상자 팝업확인후 예약진행
		if sRet <> "" then
			DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT4" , 0 , sRet )
		else
			DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT4" , 0 , "N" )
		end if
		
		Form.triggerEvent("#", "GETPWD", "")
		
	elseif sKeyName == "mbonl81000" then
		Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
		
		btnCancel.visible = true
		btnConfirm.visible = true
		tblData.SetCellString(1, 1, "")
		
		DATAMANAGER.RequestTranData( "obwat_ctad_081r" )
		
	'v001 모바일 OTP 추가
	elseif sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then			
			Form.OpenFramePopup( "mhetc90060_p5" , "" , "") '공인인증서_비밀번호입력 풀팝업
		end if
		
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			DATAMANAGER.RequestTranData( "obwat_ctad_083a" )
		end if
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	
	if szTranID == "obwat_ctad_083a" then
'		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
		Form.MsgBox("알림", szErrMsg, "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub lblPhone_OnClick()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	Form.OpenFramePopup( "mbonl81000" , "" , "")
	btnCancel.visible = false
	btnConfirm.visible = false
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Cancel" then
		if sRet == "ok" then
			Form.triggerEvent("#", "CLOSEFORM", "")
		end if
	end if
End Sub

	</SCRIPT_INFO>
