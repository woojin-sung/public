'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵 예약주문
' 02. 화면설명 : 선옵 예약주문의 주문내역 조회 화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'*****************************************ㅋ***********************************
Dim g_szACNO, g_szASNO, g_szACPW
Dim gszSet_OrdChkPop  		'주문확인창표시

'주문확인창 및 주문에 사용
Dim	g_szOrdNo			'원주문번호

Dim g_szWarnClsCode		'경고메시지코드
	 g_szWarnClsCode	= "N"
	 
Dim g_szPopupData			'주문확인창 데이터
Dim g_szTitle
g_szTitle = "알림"

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""
	
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'	주문설정값 가져오기
'============================================================================
Function Load_OrderSet()
	'주문확인창 설정
	gszSet_OrdChkPop = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
End Function

'============================================================================
'	계좌번호/비밀번호 확인
'============================================================================
Function Check_Accout()
	Dim szAcctNo, szAcpw
	
	szAcctNo = Form.GetCtlProp("#acnt", "caption")
	szAcpw	= Form.GetCtlProp("#edtPwd", "caption")
	
    If Len(Trim(szAcctNo)) < 10 Then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If
	
	If szAcpw = "" Then
	    Form.ShowAlert( g_szTitle, "비밀번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If

	Check_Accout = True
	
End Function

'============================================================================
'	주문전송(주문확인창)
'============================================================================
Function Send_Order()	

	'주문전송
	If gszSet_OrdChkPop <> "0" Then	'주문입력확인창 사용시(주문설정) '20130715 scm start 주문고도화(주문확인창 방어로직)
	    Form.OpenPopup( "mbtrf31050_p5" , g_szPopupData , "")

	Else	'주문입력확인창 사용안함(주문설정) - 주문전송
		OrderRequest()

	End If   
    
End Function


'============================================================================
'<<<<주문전 확인사항>>>> 
'============================================================================
Function Check_Order(nRowIdx)
	Dim szAcctNo, szAcctName
	Dim szItemCode, szItemName, nQty
	
	'계좌번호, 계좌명
	szAcctNo 	= Form.GetCtlProp("#acnt", "caption")
	szAcctName	= Form.GetCtlProp("#acnt", "accountname")
	
	'계좌번호/비밀번호 확인 
    If Check_Accout() = False Then
	    Exit Function
    End If

	'종목코드, 종목명
	szItemCode	= grd0.GetCellData("bd_cell2", nRowIdx)
	szItemName	= grd0.GetCellData("bd_cell12", nRowIdx)
	
	'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
	szAbleCd = Return_OrderAbleCd(szItemCode) 

	if szAbleCd = "1" then
		Form.ShowAlert("안내", "해당종목은 MTS 거래 불가 종목입니다.")
		Exit Function
	end if
	'20240111 HWG END
	
	'수량확인
	nQty = grd0.GetCellData("bd_cell14", nRowIdx)
	
	'원주문번호확인   
	g_szOrdNo = grd0.GetCellData("bd_cell15", nRowIdx)
	
	'주문데이터    
	g_szPopupData = "13"											' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 13:예약취소))
	g_szPopupData = g_szPopupData & "|" & Trim(szAcctNo)				' 계좌번호
	g_szPopupData = g_szPopupData & "|" & szAcctName					' 고객명
	g_szPopupData = g_szPopupData & "|" & szItemCode					' 종목코드
	g_szPopupData = g_szPopupData & "|" & szItemName					' 종목명
	g_szPopupData = g_szPopupData & "|" & ""							' 주문구분
	g_szPopupData = g_szPopupData & "|" & ""							' 주문가격
	g_szPopupData = g_szPopupData & "|" & nQty						' 주문수량	
	g_szPopupData = g_szPopupData & "|" & g_szOrdNo					' 원주문번호      
      
	Send_Order()	'주문전송

End Function

'============================================================================
''''''주문전송''''''
'gnOrderBtn 0:매수, 1:매도, 2:매수시장가, 3:매도시장가, 4:정정시장가
'		   5:매수신용, 6:매도신용, 7:정정, 8:취소
'============================================================================
Function OrderRequest()
	DATAMANAGER.RequestTranData( "obtrf_oder_402u" )	'정정/취소    
End Function

'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
'============================================================================
' Return_OrderAbleCd
'============================================================================
Function Return_OrderAbleCd(szCd) 
	szReturn = "0"
	
	szMkType = Form.GetItemCodeInfo(szCd, "innermarket")
	
	if szMkType = "054" or szMkType = "055" then
		if szCd <> null and szCd <> "" and Len(szCd) > 3 then
			szCdType = mid(szCd, 2, 2)
			
			if szCdType = "78" then
				szReturn = "1"
			end if
		end if
	end if
	
	return szReturn
End Function
'20240111 HWG END


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	Load_OrderSet()	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szTemp
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
	szTemp   	= Form.GetCtlProp("#edtPwd", "caption")
	
	If szTemp <> "" Then
	
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			g_szACPW 	= szTemp
		'MTS메모리평문제거 미적용상태일 때
		else
			g_szACPW 	= Form.GetEncData( szTemp )
		end if
		'20200910 SWJ END
		
		DATAMANAGER.RequestTranData( "obtrs_oder_507r" )
		
	End If
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno,szAsno, szAcpw
	szAcno = Form.GetCtlProp("#acnt", "total")
	szAsno = Form.GetCtlProp("#acnt", "sequence")
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcpw = Form.GetCtlProp("#edtPwd"	, "caption")
	'MTS메모리평문제거 미적용상태일 때
	else
		szAcpw = Form.GetCtlProp("#edtPwd"	, "encdata")
	end if
	'20200910 SWJ END
	
	If szTranID = "obtrf_oder_404r" Then
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_404r", "InBlock1", "ACNO" 			, 0 , szAcno 		)	' 계좌1
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_404r", "InBlock1", "ASNO" 			, 0 , szAsno 		)	' 계좌2
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_404r", "InBlock1", "ACNT_PWD" 		, 0 , szAcpw 		)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_404r", "InBlock1", "DEAL_CLS_CODE" 	, 0 , "0" 		)	' 매매구분코드 0:전체
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_404r", "InBlock1", "ISCD" 			, 0 , "K" 		)	' 종목코드

	ElseIf szTranID = "obtrf_oder_402u" Then		'정정/취소	
	    DATAMANAGER.SetDataValue( 0, "obtrf_oder_402u", "InBlock1", "ACNO"			, 0 , szAcno 		)	'계좌번호8
	    DATAMANAGER.SetDataValue( 0, "obtrf_oder_402u", "InBlock1", "ASNO"			, 0 , szAsno 		)	'계좌번호2
	    DATAMANAGER.SetDataValue( 0, "obtrf_oder_402u", "InBlock1", "ACNT_PWD"		, 0 , szAcpw 		)	'계좌비밀번호
	    DATAMANAGER.SetDataValue( 0, "obtrf_oder_402u", "InBlock1", "DEAL_CLS_CODE"	, 0 , "" 		)	'매매구분코드
	    DATAMANAGER.SetDataValue( 0, "obtrf_oder_402u", "InBlock1", "CNCL_QTY"		, 0 , "" 		)	'취소수량
	    DATAMANAGER.SetDataValue( 0, "obtrf_oder_402u", "InBlock1", "RSEV_ACPT_SRNO"	, 0 , g_szOrdNo 	)	'예약접수 일련번호
	    
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtrf_oder_404r" Then
		
		For i = 0 To grd0.rowcount -1 
			Dim szISCD, szODER_CLS_CODE, szADOD_TYPE_CODE
			
			szISCD			= grd0.GetCellData( "bd_cell6" , i)
			szODER_CLS_CODE	= grd0.GetCellData( "bd_cell7" , i)
			szCNCL_CLS_CODE	= grd0.GetCellData( "bd_cell16", i)
			szADOD_TYPE_CODE	= grd0.GetCellData( "bd_cell17", i)
			
			'버튼 폰트색		
			grd0.SetCellData("bd_cell1", i, "취\r\n소")
			grd0.SetCellFgColor( "bd_cell1", i, "4")

			
			'종목코드
			grd0.SetCellData( "bd_cell2", i, Mid(szISCD, 2, 11 ) )
			
			'구분
			Select Case szODER_CLS_CODE
				Case "1"	grd0.SetCellData( "bd_cell3", i, "매도" 		)
						grd0.SetCellFgColor("bd_cell3", i, "11")
				Case "2"	grd0.SetCellData( "bd_cell3", i, "매수" 		)
						grd0.SetCellFgColor("bd_cell3", i, "10")
				Case "3"	grd0.SetCellData( "bd_cell3", i, "매수청산" 	)
						grd0.SetCellFgColor("bd_cell3", i, "10")
				Case "4"	grd0.SetCellData( "bd_cell3", i, "매도청산" 	)
						grd0.SetCellFgColor("bd_cell3", i, "11")
				Case "5"	grd0.SetCellData( "bd_cell3", i, "권리행사" 	)
				Case "6"	grd0.SetCellData( "bd_cell3", i, "의무배정" 	)
				Case "7"	grd0.SetCellData( "bd_cell3", i, "행사포기" 	)
				Case "8"	grd0.SetCellData( "bd_cell3", i, "의무면제" 	)
				Case "A"	grd0.SetCellData( "bd_cell3", i, "인수대금" 	)
				Case "B"	grd0.SetCellData( "bd_cell3", i, "인도대금" 	)
				Case "C"	grd0.SetCellData( "bd_cell3", i, "단주행사" 	)
				Case "D"	grd0.SetCellData( "bd_cell3", i, "단주배정" 	)
				Case "0"	grd0.SetCellData( "bd_cell3", i, "상계" 		)
			End Select		
			
			'주문종류
			Select Case szADOD_TYPE_CODE
				Case "1"	grd0.SetCellData( "bd_cell13", i, "시장가" 						)
				Case "2"	grd0.SetCellData( "bd_cell13", i, "지정가" 						)
				Case "3"	grd0.SetCellData( "bd_cell13", i, "경쟁대량(현물만 해당)" 			)
				Case "I"	grd0.SetCellData( "bd_cell13", i, "조건부지정가" 					)
				Case "X"	grd0.SetCellData( "bd_cell13", i, "최유리 지정가" 				)
				Case "Y"	grd0.SetCellData( "bd_cell13", i, "최우선 지정가" 				)
				Case "T"	grd0.SetCellData( "bd_cell13", i, "시장가(실시간 가격제한)" 		)
				Case "W"	grd0.SetCellData( "bd_cell13", i, "최유리지정가(실시간 가격제한)" 	)
				Case "J"	grd0.SetCellData( "bd_cell13", i, "지정가 전환" 					)
			End Select
			
			'취소
			Select Case szCNCL_CLS_CODE
				Case "Y"	grd0.SetCellData( "bd_cell5", i, "취소" )
				Case "N"	grd0.SetCellData( "bd_cell5", i, "정상")
			End Select
		
		Next

	ElseIf szTranID = "obtrs_oder_507r" Then
		cld0.caption = DATAMANAGER.GetDataValue( 0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE" , 0 )
		btnSearch_OnClick()
		
	ElseIf szTranID = "obtrf_oder_402u" Then		
		Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg
		
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		if szWarnCd = "1" then							' 경고
			g_szPopupData = g_szPopupData & "|" & szWarn	' 경고메세지		
			Form.OpenPopup("mbtrs12020_p8", szData , "")	' 경고팝업 오픈

		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
			
			if Trim(szOrdCd) = "3786" then
				Form.Toast(0, szOrdMsg, true)
			end if
		end If
		
		g_szPopupData = ""
		btnSearch_OnClick()		
		
	End If
	
End Sub


'============================================================================
Sub btnSearch_OnClick()
	
	If Check_Accout() = False Then
		Exit Sub
	End If
		
	DATAMANAGER.RequestTranData( "obtrf_oder_404r" )
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	If szCellID = "bd_cell1" Then
		Check_Order( lRow )
		
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "주문전송" Then
		OrderRequest()
		
	End If
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID = "obtrf_oder_402u" Then		
		Dim szSubMsg
		
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
			
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
			'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
			'Form.Toast(0, szErrMsg, true)
		end if
	End If
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

