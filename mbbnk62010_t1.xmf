'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()

    Form.SetSharedData("CLOSE_YN" , "Y")
    loginID = Form.GetSharedData("&USER_ID", false )
    DATAMANAGER.SetDataValue(0, "obcsb_efif_021r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2")
    DATAMANAGER.SetDataValue(0, "obcsb_efif_021r" , "InBlock1" , "ELFN_ID"       , 0 , loginID)
    DATAMANAGER.SetDataValue(0, "obcsb_efif_021r" , "InBlock1" , "VLTN_ACMP_YN"  , 0 , "N")
    DATAMANAGER.RequestTranData("obcsb_efif_021r")
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obcsb_efif_021r" Then
    
        USER_NAME = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_ABWR_NAME" , 0)
	   Form.SetSharedData("mbbnk62010_USER_NAME" , USER_NAME)
       
        For i = 0 To DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1") - 1
	
            SELF_ACNT_YN = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SELF_ACNT_YN"  , i)
	    
            If SELF_ACNT_YN == "Y" Then
	    
                ACNO      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "REG_ACNO"  , i)
                ASNO      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "REG_ASNO"  , i)
                PRCD_NAME = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_INPR_NAME" , i)
	    
                Form.SetCtlProp("Account", "cbadddatatext", Left(ACNO,4) & "-" & Right(ACNO,4) & "-" & ASNO & " " & PRCD_NAME)	    
	    
            End If
	    
        Next
	  
    End If
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    If sKeyName = "CLOSE_YN" Then
        If sRet = "Y" Then
            Form.SendReturnToParent("CLOSE_YN" , "Y")
            Form.CloseForm()
        End If
    End If
    
End Sub

'============================================================================
Sub BtnCnfr_OnClick()
    Form.SetSharedData("mbbnk62010_MNRC_ACNO" , Account.caption)

    Form.OpenFramePopup("mbbnk62010_t2" , "" , "")
End Sub

'============================================================================
Sub BtnCncl_OnClick()
    Form.SendReturnToParent("CLOSE_YN" , "Y")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("CLOSE_YN" , "Y")
End Sub
	</SCRIPT_INFO>
