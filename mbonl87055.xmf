'--===========================================================================
' 01. 화 면 명 : 대용 설정
' 02. 화면설명 : 대용 설정
' 03. 작    성 : 2021.11.25 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit() 
'============================================================================
Sub Form_OnFormInit()
	Dim szState
	If fmtabChange.currenttab == 1 Then
		szState = "set"
	ElseIf fmtabChange.currenttab == 2 Then
		szState = "cancel"
	End If
	Form.triggerEvent("fmtabChange." & fmtabChange.currenttabpageid, "changeTab", szState)
End Sub

'============================================================================
' fmtabChange_OnTabChanged(nCurrentTab) : 탭 변경 이벤트 트리거
'============================================================================
Sub fmtabChange_OnTabChanged(nCurrentTab)
	Dim szState
	If nCurrentTab == 1 Then
		szState = "set"
	ElseIf nCurrentTab == 2 Then
		szState = "cancel"
	End If
	Form.triggerEvent("fmtabChange." & fmtabChange.currenttabpageid, "changeTab", szState)
End Sub


	</SCRIPT_INFO>
</ROOT>