'============================================================================
' 01.화면명 	: 펀드매매
' 02.화면설명	: 펀드매매_신규매수탭 팝업창
' 03.작성		: 2016.02.23
'				: v001 투자설명서 관리 펀드코드 추가
'				: v002 비밀번호 메모리 평문 노출 취약점 조치
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_BtnMode		'버튼모드  0:자동이체등록	1:매수신청
dim	g_szAcc		 	'종합계좌번호
dim	g_szAsno			'일련번호
dim	g_szPswd			'비밀번호
dim	g_szRegno		'잔고번호
dim  g_szIscd			'펀드코드 v001

g_BtnMode	=	"0"
g_szAcc	=""
g_szAsno	=""
g_szPswd	=""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szLinkedData
	dim	szFundName, szAcntName
	
	szLinkedData = Form.GetOpenLinkData()
	
	if	len(trim(szLinkedData))	>	6	then
		g_szAcc	= 	getListItem(szLinkedData, 0)
		g_szAsno	= 	getListItem(szLinkedData, 1)
		g_szRegno	=	getListItem(szLinkedData, 2)
		'szFundName	=	getListItem(szLinkedData, 3)
		lblFndName.caption	=	getListItem(szLinkedData, 3)
		szAcntName = 	Form.GetAccountInfo(g_szAcc, "name")
		g_szPswd	=	getListItem(szLinkedData, 4)
		g_szIscd = 	getListItem(szLinkedData, 5) 'v001
		'계좌번호 ★ 일련번호 ★ 잔고번호 ★ 펀드명 ★ 비밀번호 ★ 펀드코드 'v001 펀드코드 추가
		tbl01.SetCellString(0, 1, left(g_szAcc,4) & "-" & mid(g_szAcc,5,4) & "-" & g_szAsno & "  " & szAcntName)
		tbl01.SetCellString(1, 1, g_szRegno )
		tbl01.SetCellString(2, 1, szFundName )
	end if
	
End Sub


