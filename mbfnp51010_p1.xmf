'============================================================================
'btnFunction_OnClick	:	자동이체등록, 매수신청버튼
'============================================================================
Sub btnFunction_OnClick()
	dim	szEncpwd
	szEncpwd	=""
	
	if	g_BtnMode	=	"0"	then
		'자동이체 화면 만들어지면 연결
		
		'v002
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			szEncpwd	=	g_szPswd
		'MTS메모리평문 미적용상태 일 때
		else
			szEncpwd	=	Form.GetEncData(g_szPswd)
		end if		
		
		Form.OpenFramePopup("mbfnp51020_p3" , g_szAcc & "★" & g_szAsno & "★" &  szEncpwd & "★" & g_szRegno & "★" & g_szIscd, sPosInfo) 'v001 펀드코드 추가
		'g_szData = acnt01.total & "★" & acnt01.sequence & "★" & g_szPW
	elseif	g_BtnMode	=	"1"	then
		Form.SendReturnToParent("BUYREQUEST_51010" , "1")
		Form.CloseForm()
	end if
End Sub


'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	'21.08.03 JHY START
	Form.SendReturnToParent("BUYREQUEST_COMPL" , "1")
	'21.08.03 JHY END
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if	sKeyName		=	"TRSREQUEST_OK"	then
		if	sRet	=	"1"	then
			 btnCloseBot_OnClick()
		end	if
	end	if
End Sub

