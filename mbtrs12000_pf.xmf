'============================================================================
' 화 면 명 : 주식주문_주문가능팝업
' 화면설명 : 주식주문에서 상단연결팝업에서 주문가능 선택시 오픈
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szCd

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Init_Table
'============================================================================
Sub Init_Table()
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(1, 2, "")
	tblData.SetCellString(2, 1, "")
	tblData.SetCellString(2, 2, "")
	tblData.SetCellString(3, 1, "")
	tblData.SetCellString(3, 2, "")
	tblData.SetCellString(4, 1, "")
	tblData.SetCellString(4, 2, "")
	
	tblData0.SetCellString(1, 0, "")
	tblData0.SetCellString(1, 1, "")
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")

	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szCd     = tData(2)
		edtPrc.caption = tData(3)
		
		Init_Table()
		DATAMANAGER.RequestTranData("obtrs_comn_413r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 주문가능금액 조회
	' ----------------------------------------------------------------------	
	if szTranID = "obtrs_comn_413r" then	 
		DATAMANAGER.ClearInputData(0, "obtrs_comn_413r")
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ACNO",          0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ASNO",          0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ISCD" ,         0, g_szCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ODER_UNPR",     0, edtPrc.caption)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ODER_CLS_CODE", 0, "01")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	if szTranID == "obtrs_comn_413r" then
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
'		if Trim(szSubMsg) <> "" then
'			Form.Toast(1, szErrMsg & "(" & szSubMsg & ")", true)	
'		else
'			Form.Toast(1, szErrMsg, true)
'		end if
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	Init_Table()
	DATAMANAGER.RequestTranData("obtrs_comn_413r")
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub


