'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "BTN_CHANGE_GROUP" then	
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData("obtrc_comm_031a") 'CFD 동의내역관리
		End If
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtrc_comm_031r" trcode="obtrc_comm_031r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrc_comm_031a" trcode="obtrc_comm_031a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtrc_comm_031r" title="CFD_동의종류별 동의여부 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="245" _ulen="181" >

AGRM_CSNO^동의고객번호^10^0^0^0^0^0^0
AGRM_ACNO^동의계좌번호^8^0^0^0^0^0^0
AGRM_ASNO^동의계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
CFD_AGRM_KIND_CODE^CFD동의종류코드^7^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="164" _ulen="126" >

CFD_MARG_GRAD_CODE^CFD증거금등급코드^1^0^0^0^0^0^0
CFD_AGRM_KIND_SRNO^CFD동의종류일련번호^11^0^7^0^0^0^0
AGRM_YN^동의여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="obtrc_comm_031a" title="CFD_동의내역 관리" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="478" _ulen="358" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
CFD_AGRM_KIND_CODE^CFD동의종류코드^7^0^0^0^0^0^0
CFD_AGRM_KIND_SRNO^CFD동의종류일련번호^11^0^7^0^0^0^0
AGRM_CSNO^동의고객번호^10^0^0^0^0^0^0
AGRM_SRNO^동의일련번호^11^0^7^0^0^0^0
AGRM_ACNO^동의계좌번호^8^0^0^0^0^0^0
AGRM_ASNO^동의계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
RMRK^비고^100^0^0^0^0^0^0
CONT_CLS_CODE^접촉구분코드^1^0^0^0^0^0^0

