						<CELL cell_ly="0,19,2,19" halign="0" line="0,0" caption="민사, 형사, 행정상 어떠한 이의도 제기할 수 없으며, 과세 " fontsize="-3" impidxs="" />
						<CELL cell_ly="0,20,2,20" halign="0" line="0,0" caption="적용과 관련한 문의 및 이의 제기는 과세 당국에 대해서만" fontsize="-3" impidxs="" />
