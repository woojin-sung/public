<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="배너" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,100,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" transmode="0" ly_vert="0,-15,375,56,1" />
		<IMAGE name="Image1" autosize="1" ly_vert="280,5,80,80,1" />
		<LABEL name="lblTitle" fgcolor="145:255255255" fontsize="-2" fontstyle="01" bgcolor="029:255212175" autofontsize="1" ly_vert="10,5,250,40,1" />
		<LABEL name="lblSubTitle" fgcolor="096:102102102" fontsize="-4" fontstyle="01" multiline="1" ly_vert="10,-3,217,17,1" />
		<LABEL name="lblIcon" fgcolor="145:255255255" fontsize="-2" fontstyle="10" autofontsize="1" ly_vert="10,50,217,18,1" />
		<BUTTON name="btn0" btnimage="alpha" ly_vert="0,0,375,170,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1826" _ulen="1646" >

'============================================================================
Sub Form_OnFormInit()
	szOsType 		= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS

	Image1.imgpath 		= "home_banner02_ico"
	
	lblTitle.fgcolor	= "334"
	lblIcon.fgcolor	= "334"
	
	lblSubTitle.caption 	= "ETF 투자하기 OPEN 안내"
	lblTitle.caption 		= "메리츠만의 강력한 ETF 플랫폼! 파워검색!"
	lblIcon.caption 		= "ETF HOME 바로가기 > "

End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	'Image0.setMaintainingRatio("4")	'안드:좌측상단 / iOS: 상단
	Image1.setMaintainingRatio("3")	
End Sub

'============================================================================
Sub btn0_OnClick()
	DATAMANAGER.RequestTranData("ohhts_open_001r")	'20230308 SWJ: 화면 오픈 횟수 집계
	
	Form.OpenScreen("50010" , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'20230308 SWJ START: 화면오픈횟수 집계
	if szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = szOSType + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "99996") 	 '메뉴에 등록된 화면번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "HOME 롤링배너") '하드코딩
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) '최근 로그인 아이디
	end if
	'20230308 SWJ END
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="ohhts_open_001r" trcode="ohhts_open_001r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="ohhts_open_001r" title="화면조회 횟수 입력" realdata="0" dessvr="C" >
				<TRBLOCK name="InBlock1" inout="in" _len="171" _ulen="143" >

FID_SORT_CLS^FID정렬구분^1^0^0^0^0^0^0
FID_SCR_NO^FID화면번호^5^0^0^0^0^0^0
FID_SCR_NAME^FID화면명^100^0^0^0^0^0^0
USER_ID^사용자ID^20^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>