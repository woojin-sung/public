	<SCRIPT_INFO _len="10657" _ulen="10303" >
Dim g_AcntNo
Dim g_AcntSeq
Dim g_AttachFile

Dim g_tAgreeUrl 	'2차 개발시 약관 추가예정. 현재는 1개!
Dim g_tAgreeState 	

dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러

dim g_szRet

Dim g_bAllView

'============================================================================
Sub Form_OnFormInitBefore()
	imgAllAgree.setMaintainingRatio("1")
	imgUIChk1.setMaintainingRatio("1")
	imgUIChkSub.setMaintainingRatio("1")
'	imgChk1.setMaintainingRatio("1")
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_AcntNo 		= tData[0]
		g_AcntSeq 		= tData[1]
		g_AttachFile 		= tData[2]
	end if
	
	g_szUnCheckImg = "icon_check_off.png"
	g_szCheckImg = "icon_check_on.png"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"

	g_bAllView = false
	
	Form.SetTimerEvent(10, 1, 1)
		
