	g_tAgreeState = {"0"}
	tOpenData = Form.GetOpenLinkData()
	tData1 = Split(tOpenData,"★")
	
	g_szRet = ""
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	Form.SetTimerEvent(10, 0, 1)

	Dim sDev
	sDev = Form.GetSharedData("&SERVER_MODE", False )
	
	If sDev == "1" Or sDev == 1 Then
		g_tAgreeUrl = {
		    {g_AttachFile, "투자설명서",  "urlpath", "N", ""}
		}	
'		g_tAgreeUrl = {
'		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_04.pdf", "신용거래융자 핵심설명서",  "urlpath", "N", ""}
'		}
		
	Else '운영
		g_tAgreeUrl = {
		    {g_AttachFile, "투자설명서",  "urlpath", "N", ""}
		}
'		g_tAgreeUrl = {
'		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_04.pdf", "신용거래융자 핵심설명서",  "urlpath", "N", ""}
'		}
	End If
	
End Sub

'============================================================================
Sub chkAllAgree_OnChange(sCheckState)
	if sCheckState == "1" then
		chkAllAgree.chksilence = "0"
		
		Dim szAllData
		
		tCnt = 0
		
		for i=0 to tCnt
			Dim szData
'			if g_tAgreeState[i] == "0" then
				'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
				szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
				if szAllData == "" or szAllData == null then
					szAllData = szData
				else
					szAllData = szAllData.."☆"..szData
				end if
'			end if
		next
	    
	    g_bAllView = true
	    
		if #szAllData > 0 then
			Form.OpenPopup( "mbonl88060_p12" ,  szAllData , "" )
		end if
	else
		g_tAgreeState = {"0"}
		
		f_AllAgreeCheck()
		
	end if
End Sub


'============================================================================
Sub imgAllAgree_OnClick()
	if chkAllAgree.checkstate == "1" then
		chkAllAgree.checkstate = "0"
		chkAllAgree_OnChange("0")
	else
		chkAllAgree.checkstate = "1"
		chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
Sub lblAllAgree_OnClick()
	if chkAllAgree.checkstate == "1" then
		chkAllAgree.checkstate = "0"
		chkAllAgree_OnChange("0")
	else
		chkAllAgree.checkstate = "1"
		chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl88060_p12" then
	    if trim(sRet) ~= "" and trim(sRet) ~= nil and sRet ~= "close" then
			Dim tReturnData
			Dim nCnt
			
			tReturnData = Split(sRet, "☆")			 

			nCnt = #tReturnData
			for i = 0 to nCnt - 1
				Dim nIndex      
				nIndex = tonumber(tReturnData[i]) - 1
				g_tAgreeState[nIndex] = "1"
			next
			
			if g_bAllView then
				f_AllAgreeCheck()
			else
				f_AgreeCheck()
			end if
	    end if	
	end if
End Sub

'============================================================================
Function f_CheckButtonEnable()
	If chkAgree1.checkstate == "1" And chkAgree2.checkstate == "1" Then
		btnOk.enable = true
	Else
		btnOk.enable = false
	End If
End Function

'============================================================================
Function f_AgreeCheck()
	for i = 0 to #g_tAgreeState - 1
		Form.SetCtlProp("chkAgree"..i+1, "chksilence", g_tAgreeState[i])		
		
		if g_tAgreeState[i] == "1" then
			Form.SetCtlProp("imgUIChk"..i+1, "imgpath", g_szCheckImg)
			Form.SetCtlProp("lblChkText"..i+1, "fgcolor", g_szCheckFg)
		else
			Form.SetCtlProp("imgUIChk"..i+1, "imgpath", g_szUnCheckImg)
			Form.SetCtlProp("lblChkText"..i+1, "fgcolor", g_szUnCheckFg)
		end if
	next
	
	if chkAgree1.checkstate == "1" and chkAgree2.checkstate == "1" then
		imgAllAgree.imgpath = g_szCheckImg
		lblAllAgree.fgcolor = g_szCheckFg
	
		chkAllAgree.chksilence = "1"
		btnOk.enable = "1"
	else
		imgAllAgree.imgpath = g_szUnCheckImg
		lblAllAgree.fgcolor = g_szUnCheckFg
	
		chkAllAgree.chksilence = "0"
		btnOk.enable = "0"
	end if
End Function 

'============================================================================
Function f_AllAgreeCheck()
	Dim nAll
	nAll = 0

	for i = 0 to #g_tAgreeState - 1
	
		Form.SetCtlProp("chkAgree"..i+1, "chksilence", g_tAgreeState[i])		
		Form.SetCtlProp("chkAgree"..i+2, "chksilence", g_tAgreeState[i])		
		
		if g_tAgreeState[i] == "1" then
			Form.SetCtlProp("imgUIChk"..i+1, "imgpath", g_szCheckImg)
			Form.SetCtlProp("lblChkText"..i+1, "fgcolor", g_szCheckFg)
		
			if i == 0 then	'건설사채권(CP) 주요내용 확인
				Form.SetCtlProp("imgUIChkSub", "imgpath", g_szCheckImg)
				Form.SetCtlProp("lblChkTextSub", "fgcolor", g_szCheckFg)
			end if
			nAll = nAll + 1
		else
			Form.SetCtlProp("imgUIChk"..i+1, "imgpath", g_szUnCheckImg)
			Form.SetCtlProp("lblChkText"..i+1, "fgcolor", g_szUnCheckFg)
			
			if i == 0 then	'건설사채권(CP) 주요내용 확인
				Form.SetCtlProp("imgUIChkSub", "imgpath", g_szUnCheckImg)
				Form.SetCtlProp("lblChkTextSub", "fgcolor", g_szUnCheckFg)
			end if
		end if
		
	next

	tCnt = 0

	if nAll == tCnt+1 then
		imgAllAgree.imgpath = g_szCheckImg
		lblAllAgree.fgcolor = g_szCheckFg
	
		chkAllAgree.chksilence = "1"
		btnOk.enable = "1"
	else
		imgAllAgree.imgpath = g_szUnCheckImg
		lblAllAgree.fgcolor = g_szUnCheckFg
	
		chkAllAgree.chksilence = "0"
		btnOk.enable = "0"
	end if

End Function

'============================================================================
Sub chkAgree1_OnChange(sCheckState)
	if sCheckState == "1" then
		chkAgree1.chksilence = "0"

		'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
		Dim szAllData
		szAllData = g_tAgreeUrl[0][1].."★"..g_tAgreeUrl[0][0].."★"..g_tAgreeUrl[0][2].."★"..g_tAgreeUrl[0][3].."★"..g_tAgreeUrl[0][4].."★".."1".."★".."0"
		
		g_bAllView = false
		
	     Form.OpenPopup( "mbonl88060_p12" ,  szAllData , "" )
	else
		Dim nIdex
		nIdex = 0
		g_tAgreeState[nIdex] = "0"
'		f_AllAgreeCheck()
	
		f_AgreeCheck()
	end if
End Sub


'============================================================================
Sub imgUIChk1_OnClick()
	if chkAgree1.checkstate == "0" then
		chkAgree1.checkstate = "1"
		chkAgree1_OnChange("1")
	else
		chkAgree1.checkstate = "0"
		chkAgree1_OnChange("0")
	end if 
End Sub

'============================================================================
Sub lblChkText1_OnClick()
	if chkAgree1.checkstate == "0" then
		chkAgree1.checkstate = "1"
		chkAgree1_OnChange("1")
	else
		chkAgree1.checkstate = "0"
		chkAgree1_OnChange("0")
	end if 
End Sub

