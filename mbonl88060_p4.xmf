End Sub

'============================================================================
Sub imgUIChkSub_OnClick()
	if chkAgree2.checkstate == "0" then
		chkAgree2.checkstate = "1"
		chkAgree2_OnChange("1")
	else
		chkAgree2.checkstate = "0"
		chkAgree2_OnChange("0")
	end if 
End Sub

'============================================================================
Sub lblChkTextSub_OnClick()
	if chkAgree2.checkstate == "0" then
		chkAgree2.checkstate = "1"
		chkAgree2_OnChange("1")
	else
		chkAgree2.checkstate = "0"
		chkAgree2_OnChange("0")
	end if 
End Sub

'============================================================================
Sub btnOk_OnClick()
	if chkAgree1.checkstate == "1" then
		g_szRet = "ok"
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl88060_p4" , g_szRet )	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub chkAgree2_OnChange(sCheckState)
	if sCheckState == "1" then
		Form.SetCtlProp("imgUIChkSub", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblChkTextSub", "fgcolor", g_szCheckFg)
	else
		Form.SetCtlProp("imgUIChkSub", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblChkTextSub", "fgcolor", g_szUnCheckFg)
	end if
	
	if chkAgree1.checkstate == "1" and chkAgree2.checkstate == "1" then
		imgAllAgree.imgpath = g_szCheckImg
		lblAllAgree.fgcolor = g_szCheckFg
	
		chkAllAgree.chksilence = "1"
		btnOk.enable = "1"
	else
		imgAllAgree.imgpath = g_szUnCheckImg
		lblAllAgree.fgcolor = g_szUnCheckFg
	
		chkAllAgree.chksilence = "0"
		btnOk.enable = "0"
	end if
End Sub

