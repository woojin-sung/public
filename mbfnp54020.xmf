'============================================================================
' 화 면 명 : 채권주문
' 화면설명 : 채권주문 메인화면
' 작    성 : 2016.01.19  test3
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCd
Dim g_szGp
Dim g_szSlt
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북
Dim g_szFromTag  '진입유형
Dim g_szParamInitCode
g_szParamInitCode = ""

Dim g_szAfterOrg

' 계좌비밀번호 저장여부
Dim g_szSavePwd 
g_szSavePwd  = "0"

'=======================================================================
'종목의 장내,소액코드를 가져오는 유형이 3가지임
'=======================================================================
'menu : 메뉴에서 진입 : 최종 저장된 종목과 종목유형을 가져옴
'link : 링크에서 진입 : 파라메터로 종목과 종목유형을 가져옴
'popp : 종목팝업 진입 : 종목명은 파라메터, 종목유형은 Form.GetSharedData 구함
'=======================================================================

g_szCd = ""
g_szGp = ""
g_szSlt = "HOGA"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'InnerMarket -> 채권코드
'============================================================================
Function fn_TypeGubun(szCode)

	Select Case szCode
		Case "020" return "B"   '장내채권
		Case "019" return "SB"  '소액채권
	end Select
	
	return "B"

End Function

Function fn_OrgGubun(szCode)

	Select Case szCode
		Case "B" return "020"   '장내채권
		Case "SB" return "019"  '소액채권
	end Select
	
	return "020"

End Function

'============================================================================
' Request_Hoga
'============================================================================
Function Request_Hoga()

    DATAMANAGER.CancelRealData(  "ohhts_bond_aspr" )
    DATAMANAGER.CancelRealData(  "ohhts_smbd_aspr" )
    DATAMANAGER.CancelRealData(  "ohhts_rebd_aspr" )
    DATAMANAGER.CancelRealData(  "ohhts_bond_cntg" )
    DATAMANAGER.CancelRealData(  "ohhts_smbd_cntg" )
    DATAMANAGER.CancelRealData(  "ohhts_rebd_cntg" )
	'if g_szSlt == "HOGA" then
	DATAMANAGER.RequestTranData("ohhts_7052_005r")
	'else 
	DATAMANAGER.RequestTranData("ohhts_7061_001r")
	'end if 한번에 호가/현재가 TR 요청으로 변경    

End Function

'============================================================================
' Click_Hoga
'============================================================================
Function Click_Hoga(szClk)
	if Trim(szClk) <> "" and CInt(szClk) <> 0 then
		Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "54020_HOGA", szClk)
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	'20240105 SWJ START : 삭제
	'20231005 SWJ START
'	sLoadDate = Form.LoadConfigData("NoticeSetting", "OrderBond")
'	
'	if sLoadDate == "" then
'		Form.OpenPopup("notice_bond" , "" , "")
'	end if
	'20231005 SWJ END
	'20240105 SWJ END
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")	' 원주문번호 자동입력
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if

	Form.SetSearchType ( "7" )

	szOpen = Form.GetOpenLinkData()
	if szOpen <> "" then
		tData = Split(szOpen, "★")
		
		'화면링크로 진입
		g_szFromTag = "link"

		if #tData > 0 then
		
			'관심종목
			if tData(0) == "관심종목" then
				
				'시장구분이 없어서 구한다.
				Dim innermarket
				g_szCd = tData(2)
				innermarket = Form.GetItemCodeInfo(g_szCd, "innermarket")
				g_szGp = fn_TypeGubun(innermarket)
				g_szParamInitCode = g_szGp & "★" & g_szCd
				
			'채권시세표
			elseif tData(0) == "채권시세표" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				g_szParamInitCode = g_szGp & "★" & g_szCd
			
			'채권호가
			elseif tData(0) == "채권호가" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(4) '호가

			'주문체결
			elseif tData(0) == "주문체결" then
				
				g_szCd = tData(2) '코드
				g_szGp = tData(3) '시장구분
				
				'수량, 주문번호, 주문유형, 가격, 주문조건코드
				g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(4) & "★" & tData(5)  & "★" & tData(6)  & "★" & tData(7)  & "★" & tData(8) 
                
			end if

			'텝처리
			if Trim(tData(1)) == "" then
				fmtabTbond.currenttab = "0"
			else
				fmtabTbond.currenttab = tData(1)
			end if
			
		end if
	else
		'메뉴에서 진입
		g_szFromTag = "menu"
	end if

	if g_szFromTag == "link" then
		Form.SetSharedData(g_szCd, fn_OrgGubun(g_szGp))
		Form.SetItemCode(g_szCd)
	
	else
		Dim szCd, szGp
		szCd = Form.LoadConfigData( "mhprc54010", "frmItemCode" )
		szGp = Form.LoadConfigData( "mhprc54010", "frmItemGubun" )

		if Trim(szCd) == ""  then
			g_szCd = ""
			g_szGp = ""
			g_szFromTag = "popp"	'20221216 HSZ : 앱 설치 후, 최초오픈 시 종목정보 세팅 오류 조치
		else
			g_szCd = szCd
			g_szGp = szGp
		end if

		g_szParamInitCode = g_szGp & "★" & g_szCd
		
		Form.SetSharedData(g_szCd, fn_OrgGubun(g_szGp))
		Form.SetItemCode(g_szCd)

	end if
    
	'''Form.triggerEvent("linkfmBond", "종류구분", g_szGp & "★" & g_szCd)''''
	'''Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szCd)
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
	if sKey == "ITEMCODE" then
		
		Dim szInnerMarket
		szInnerMarket = Form.GetSharedData(sValue, 1 )
		g_szGp = fn_TypeGubun(szInnerMarket)
		g_szCd = sValue
		if g_szFromTag == "popp" then
		   g_szParamInitCode = g_szGp & "★" & g_szCd
		end if
		Request_Hoga()
		Form.triggerEvent("linkfmBond", "종류구분", g_szGp & "★" & g_szCd)
		Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szParamInitCode)
	
		Form.SaveConfigData("mhprc54010", "frmItemCode",   g_szCd)
		Form.SaveConfigData("mhprc54010", "frmItemGubun",  g_szGp)

		g_szFromTag = "popp";
	
	end	if

End Sub

'============================================================================
Sub tblSelect_OnClick(lRow , lColumn)
    if lColumn = 1 then
	  szSelect = Trim(tblSelect.GetCellString(0 , 1))
	
	  if g_szSlt == "HOGA" then
		 g_szSlt = "SISE"
		 lblTime.visible = True
		 tblSelect.SetCellString(0, lColumn, "시간별")
		 grdList.left = 0
		 hogaTbl.left = 700
	  elseif g_szSlt == "SISE" then
		 g_szSlt = "HOGA"
		 tblSelect.SetCellString(0, lColumn, "호가")
		 lblTime.visible = False
		 grdList.left = 700
		 hogaTbl.left = 0
	  end if		
	  'tblSelect.SetCellString(0, 0, "")
	  'Call Request_Hoga()'''
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    
	if szTranID = "ohhts_7061_001r" then '시간별
	   DATAMANAGER.CancelRealData("ohhts_rebd_cntg")
	   DATAMANAGER.CancelRealData("ohhts_bond_cntg")
	   DATAMANAGER.CancelRealData("ohhts_smbd_cntg")
	   DATAMANAGER.ClearInputData(0, "ohhts_7061_001r")
	   DATAMANAGER.SetDataValue(0, "ohhts_7061_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szGp)
	   DATAMANAGER.SetDataValue(0, "ohhts_7061_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szCd )
	end if   
	
	if szTranID = "ohhts_7052_005r" then '호가
	   DATAMANAGER.CancelRealData("ohhts_rebd_aspr")
	   DATAMANAGER.CancelRealData("ohhts_bond_aspr")
	   DATAMANAGER.CancelRealData("ohhts_smbd_aspr")
	   DATAMANAGER.ClearInputData(0, "ohhts_7052_005r")
	   DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szGp)
	   DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szCd )
	end if 
	
	if szTranID = "ohhts_7052_001r" then '현재가 
	   DATAMANAGER.ClearInputData(0, "ohhts_7052_001r")
	   DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szGp)
	   DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szCd )
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_smbd_aspr" then
	   DATAMANAGER.SetDataValue( 1, "ohhts_smbd_aspr", "InBlock1", "FIDR_STND_ISCD", 0 , g_szCd )
	elseif szTranID = "ohhts_smbd_cntg"  then
	   DATAMANAGER.SetDataValue( 1, "ohhts_smbd_cntg", "InBlock1", "FIDR_STND_ISCD", 0 , g_szCd ) 
	elseif szTranID = "ohhts_rebd_aspr"  then
	   DATAMANAGER.SetDataValue( 1, "ohhts_rebd_aspr", "InBlock1", "FIDR_STND_ISCD", 0 , g_szCd ) 
	elseif szTranID = "ohhts_rebd_cntg"  then
	   DATAMANAGER.SetDataValue( 1, "ohhts_rebd_cntg", "InBlock1", "FIDR_STND_ISCD", 0 , g_szCd ) 
	elseif szTranID = "ohhts_bond_aspr"  then
	   DATAMANAGER.SetDataValue( 1, "ohhts_bond_aspr", "InBlock1", "FIDR_STND_ISCD", 0 , g_szCd ) 
	elseif szTranID = "ohhts_bond_cntg"  then
	   DATAMANAGER.SetDataValue( 1, "ohhts_rebd_cntg", "InBlock1", "FIDR_STND_ISCD", 0 , g_szCd )    
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_7061_001r" then 
	    if g_szGp == "B" then
			
			DATAMANAGER.RequestRealData( "ohhts_bond_cntg" )
		elseif g_szGp == "SB" then
			
			DATAMANAGER.RequestRealData( "ohhts_smbd_cntg" )
		else 
			
			DATAMANAGER.RequestRealData( "ohhts_rebd_cntg" )
		end if
	end if 	
	
	if szTranID == "ohhts_7052_005r" then 
	    if g_szGp == "B" then
			DATAMANAGER.RequestRealData( "ohhts_bond_aspr" )
		elseif g_szGp == "SB" then
			DATAMANAGER.RequestRealData( "ohhts_smbd_aspr" )
		else 	
		    DATAMANAGER.RequestRealData( "ohhts_rebd_aspr" )
		end if
	end if 	
End Sub

'============================================================================
Sub hogaTbl_OnClick(lRow, lCol)
	
	Dim szPrc
	szPrc = hogaTbl.GetCellString(lRow, 0)
	Call Click_Hoga(szPrc)
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	Dim szType
	
	' ----------------------------------------------------------------------
	' 매도화면에서 잔고팝업 오픈 요청
	' ----------------------------------------------------------------------	
	if sEventName == "54020_BALANCE_OPEN" then
		' 계좌번호(8), 계좌일련번호(2), 탭구분
		Form.OpenFramePopup("mbfnp54020_p5", acc.total & "★" & acc.sequence & "★" & "1" , "")	
	
	' ----------------------------------------------------------------------
	' 정정/취소화면에서 미체결팝업 오픈 요청
	' ----------------------------------------------------------------------	
	elseif sEventName == "54020_CONTRACT_OPEN" then		
		' 계좌번호(8), 계좌일련번호(2), 탭구분
		Form.OpenFramePopup("mbfnp54020_p6", acc.total & "★" & acc.sequence & "★" & fmtabTbond.currenttab, "")		
	
	'자식 텝에서 호출
	elseif sEventName == "BODY_CALLBACK" then
		
		tData = Split(sParam, "★")
			
		if #tData > 0 then
			g_szGp = tData(0)
			g_szCd = tData(1)
		
			Request_Hoga()
			Form.triggerEvent("linkfmBond", "종류구분", g_szGp & "★" & g_szCd)
			Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szGp & "★" & g_szCd)
		end if

	elseIf sEventName == "SCREEN_MENU" Then			' 연결정보(상단 ...)
		If sParam == "SHA_SNS" Then					' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If

	elseif sEventName == "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "7" , "")
	'20220922 SWJ END
	else	
		if sEventName == "54020_BUYTYPE" then
			szType = Form.GetSharedData("BOND_BUYTYPE", false)
			Form.triggerEvent("linkfmBond", "54020_BUYTYPE", "")
		elseif sEventName == "54020_SELTYPE" then
			szType = Form.GetSharedData("BOND_SELTYPE", false)
			Form.triggerEvent("linkfmBond", "54020_SELTYPE", "")
		elseif sEventName == "54020_MODTYPE" then
			szType = Form.GetSharedData("BOND_MODTYPE", false)
			Form.triggerEvent("linkfmBond", "54020_MODTYPE", "")
		elseif sEventName == "54020_CNLTYPE" then
			szType = Form.GetSharedData("BOND_CNLTYPE", false)
			Form.triggerEvent("linkfmBond", "54020_CNLTYPE", "")
		end if
	
		if Trim(szType) == "" then
			szType = "0"
		end if
	end if

End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("BOND_BUYTYPE", "")
	Form.SetSharedData("BOND_SELTYPE", "")
	Form.SetSharedData("BOND_MODTYPE", "")
	Form.SetSharedData("BOND_CNLTYPE", "")
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szPrc
	
	szPrc = grdList.GetCellData("bd_cell0", lRow)
	Click_Hoga(szPrc)
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	' ----------------------------------------------------------------------
	' 잔고팝업, 미체결팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "54020_BALANCE" then'or sKeyName == "54020_CONTRACT" then
		if sRet <> "" then
		    '  전달내용/탭위치/종목코드/수량/매수일자/매수구분
			tData = Split(sRet, "★")
              g_szCd = tData(2)	          
			'Return_Change_ItemCode(tData(2))
			g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(3) & "★" & tData(4)  & "★" & tData(5)
			Form.SetSharedData(g_szCd, fn_OrgGubun(g_szGp))
			g_szFromTag = ""
			Form.SetItemCode(g_szCd)
			'Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, sKeyName & "_RETURN", tData(3))
		
		end if
	elseif sKeyName == "54020_CONTRACT" then
		if sRet <> "" then
		    ' 전달내용/탭위치/종목코드/수량/번호/가격/시장구분/매매구분/조건구분
			tData = Split(sRet, "★")
              g_szCd = tData(2)
	          
			  g_szGp = tData(6)'미체결팝업에서 시장구분값 받기 
			
			'수량, 주문번호, 주문유형, 가격, 주문조건코드
			g_szParamInitCode = g_szGp & "★" & g_szCd & "★" & tData(3) & "★" & tData(4)  & "★" & tData(7)  & "★" & tData(5)  & "★" & tData(8) 
			Form.SetSharedData(g_szCd, fn_OrgGubun(g_szGp))
			g_szFromTag = ""
			Form.SetItemCode(g_szCd)
			
		    
		end if
		
	elseIf sKeyName == "snsshare" Then			' 폼탭 초기화
		
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType == 2 Then
			Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		Else
			Form.triggerEvent("linkfmBond", "sharedata", g_szGp & "★" & g_szCd)			
		End If
		
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acc.caption
				nCnt = Cint(acc.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acc.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acc.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
		
	End If

End Sub

'============================================================================
Sub fmtabTbond_OnTabChanged(nCurrentTab)
	
	Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "INIT_CODE", g_szGp & "★" & g_szCd)	' 폼탭화면에 종목코드 던지기

    if nCurrentTab == 0 or nCurrentTab == 1 then
        if nCurrentTab == 0 then
			szType = Form.GetSharedData("BOND_BUYTYPE", false)
			Form.triggerEvent("linkfmBond", "54020_BUYTYPE", "")
		elseif nCurrentTab == 1 then
			szType = Form.GetSharedData("BOND_SELTYPE", false)
			Form.triggerEvent("linkfmBond", "54020_SELTYPE", "")
		end if
	
	else
		if g_szAfterOrg == "1" then	
		   Form.triggerEvent("fmtabTbond." & fmtabTbond.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption)	
		end if
	
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	Request_Hoga()
End Sub

'20220425 HWG START : 계좌비밀번호 입력 개선
'============================================================================
Sub btnPwd_OnClick()
	Form.openPopupAnimation("pwdcheckpopup",acc.caption,"","2")
End Sub
