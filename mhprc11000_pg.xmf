<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="11000" scrname="현재가_과표기준_날짜" version="2" writer="이은섭" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="BtnBackGround" btnimage="alpha.png" ly_vert="0,0,375,755,1" />
		<IMAGE name="imgBG" autosize="1" imgpath="popup_bg.9" ly_vert="0,392,375,315,1" />
		<LABEL name="LabelTitle" fontsize="2" caption="기간을 선택해주세요" halign="1" ly_vert="20,412,335,30,1" />
		<IMAGE name="imgClose" visible="0" imgpath="icon_close" margin="5,7,5,7" ly_vert="330,412,30,30,0" />
		<BUTTON name="btnOk" caption="확인" btnimage="btn_20.9" ly_vert="0,600,375,48,1" />
		<CONTAINER name="contPeriod" ly_vert="0,472,375,108,1" scroll_ly_vert="0,472,375,108,1" >
			<CONTROL_INFO>
				<LABEL name="LabelDate" fontstyle="01" caption="조회기간" paddinginfo="1,0,0,0" ly_vert="18,-48,200,20,1" />
				<RADIOGROUP name="RgDateType" fontsize="-2" buttonshape="1" buttonsnumber="4" ly_vert="18,0,335,44,1" >
					<RADIO_INFO>
						<RADIO no="0" text="1개월" radioimage="input_06.9.png" transfervalue="01" position="0,0,80,44" />
						<RADIO no="1" text="3개월" radioimage="input_06.9.png" transfervalue="02" position="85,0,80,44" />
						<RADIO no="2" text="6개월" radioimage="input_06.9.png" transfervalue="03" position="170,0,80,44" />
						<RADIO no="3" text="직접입력" radioimage="input_06.9.png" transfervalue="04" position="255,0,80,44" />
					</RADIO_INFO>
				</RADIOGROUP>
				<CALENDAR name="cldFromDate" fontsize="-2" dispmode="65537" eventtr="ohhts_1081_002r" ly_vert="18,54,150,44,1" />
				<CALENDAR name="cldToDate" fontsize="-2" dispmode="1398757700" eventtr="ohhts_1081_002r" ly_vert="203,54,150,44,1" />
				<LABEL name="Label8" fontsize="-2" caption="~" halign="1" ly_vert="179,54,16,44,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6989" _ulen="6239" >
Dim optionPeriodIndex,optionFromDate,optionToDate
Dim optionPeriodDirect

'============================================================================
Sub Form_OnFormInitBefore()
	optionPeriodDirect = false
End Sub

'============================================================================
Sub Form_OnFormInit()
	szLinkData = Form.GetOpenLinkData()
	if szLinkData <> "" then
		arrData = Split(szLinkData,"@")
		
		'기간구분/From일자/To일자
		'From일자는 익영업일로 고정
		'To일자는 익영업일 ~ 익영업일 + 3개월 이내 
		optionPeriodIndex = arrData(0)
		optionFromDate = arrData(1)
		optionToDate = arrData(2)
		
		'설정된 디폴트 값으로 조회구분 세팅(기간)
		SelectPeriodOption()
	
	else
		
		'화면링크데이터가 없으면 디폴트 데이터값 설정
		SetDefaultOption()
		
		'설정된 디폴트 값으로 조회구분 세팅(기간)
		SelectPeriodOption()
	
	end if
	

End Sub
'============================================================================
'
'============================================================================
Sub BtnBackGround_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
'
'============================================================================
Sub contPeriod_RgDateType_OnClick(nIndex)

	Change_optionPeriod(nIndex)	
End Sub

'============================================================================
' 조회기간(From 날짜) 직접입력 시
'============================================================================
Sub contPeriod_cldFromDate_OnEditComplete()
	'To일자
	sToDate = contPeriod.cldToDate.caption
	
	'사용자 선택일자
	sSelectDate = contPeriod.cldFromDate.caption
	
	'사용자 선택일자가 [조회일+ 1영업일 3개월 이후] 이거나 [From일자] 이전 인경우
	if sSelectDate > sToDate then
		
		contPeriod.cldFromDate.caption = sToDate
		optionFromDate = sToDate
			
		Form.ShowAlert("알림", "시작일이 종료일 이후입니다.")
		
	else
		optionFromDate = contPeriod.cldFromDate.caption
	end if
	
	optionToDate = contPeriod.cldToDate.caption
End Sub

'============================================================================
' 조회기간(To 날짜) 직접 입력 시
'============================================================================
Sub contPeriod_cldToDate_OnEditComplete()
	optionToDate = contPeriod.cldToDate.caption	
End Sub


'============================================================================
' 검색버튼 클릭이벤트(조회조건 설정 리턴)
'============================================================================
Sub btnOk_OnClick()
	
	sReturnData = optionPeriodIndex.."@"..optionFromDate.."@"..optionToDate
	Form.SendReturnToParent("PERIOD_SET" , sReturnData)
	Form.CloseForm()
	
End Sub
'============================================================================
' 닫기버튼 클릭이벤트
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' 조회조건(기간) 디폴트값 설정
'============================================================================
Function SetDefaultOption()
	
	'조회기간 디폴트값 설정(전일)
	optionPeriodIndex = 0
	
	optionToDate = Form.GetSharedData("&BIZ_DT", false) '영업일
	contPeriod.cldFromDate.caption = optionToDate
	contPeriod.cldToDate.caption = optionToDate
	szDate = CalcDate("m", -1)
	contPeriod.cldFromDate.caption = szDate
	optionFromDate = contPeriod.cldFromDate.caption

End Function

'============================================================================
' 조회조건(기간)에 따라 선택/미선택 표시
'============================================================================
Function SelectPeriodOption()

	'직접입력인 경우 사용자가 입력했던 To일자를 사용하기 위해 플래그 변경
	if optionPeriodIndex == "3" then
		optionPeriodDirect = true
		contPeriod.cldFromDate.caption = optionFromDate
		contPeriod.cldToDate.caption = optionToDate
	else
		optionPeriodDirect = false
	end if

	contPeriod.RgDateType.currentindex = optionPeriodIndex
	
End Function

'============================================================================
' 조회조건(기간) 변경 처리
'============================================================================
Function Change_optionPeriod(nIndex)
	
	optionPeriodIndex = nIndex

	if nIndex == 0 then '1개월
		contPeriod.cldFromDate.enable = "0"
		contPeriod.cldToDate.enable = "0"
		
		'달력컨트롤 숨김처리
		contPeriod.cldFromDate.visible = true
		contPeriod.Label8.visible = true
		contPeriod.cldToDate.visible = true
		
		contPeriod.cldToDate.caption = optionToDate
		contPeriod.cldFromDate.caption = CalcDate("m","-1")
		optionFromDate = contPeriod.cldFromDate.caption
	
	elseif nIndex == 1 then '3개월
		contPeriod.cldFromDate.enable = "0"
		contPeriod.cldToDate.enable = "0"
		
		'달력컨트롤 숨김처리
		contPeriod.cldFromDate.visible = true
		contPeriod.Label8.visible = true
		contPeriod.cldToDate.visible = true

		
		contPeriod.cldToDate.caption = optionToDate
		contPeriod.cldFromDate.caption = CalcDate("m",-3)
		optionFromDate = contPeriod.cldFromDate.caption

	elseif nIndex == 2 then  '6개월
		
		contPeriod.cldFromDate.enable = "0"
		contPeriod.cldToDate.enable = "0"
		
		'달력컨트롤 숨김처리
		contPeriod.cldFromDate.visible = true
		contPeriod.Label8.visible = true
		contPeriod.cldToDate.visible = true


		contPeriod.cldToDate.caption = optionToDate
		contPeriod.cldFromDate.caption = CalcDate("m",-6)
		optionFromDate = contPeriod.cldFromDate.caption

	elseif nIndex == 3 then  '직접입력
		
		contPeriod.cldFromDate.enable = "1"
		contPeriod.cldToDate.enable = "0"
		contPeriod.cldToDate.caption = optionToDate
		
		'달력컨트롤 보임처리
		contPeriod.cldFromDate.visible = true
		contPeriod.Label8.visible = true
		contPeriod.cldToDate.visible = true
	
		'직접입력으로 설정 후 다시 돌아온 경우에는 사용자가 입력했던
		'To일자 사용함. 그렇지 않은 경우에는 From일자와 동일한 일자 사용
		if optionPeriodDirect then
			'contPeriod.cldFromDate.caption = optionToDate
		else
			contPeriod.cldFromDate.caption = optionFromDate
			'optionToDate = optionFromDate
		end if
	end if
	
End Function

'============================================================================
' From일로부터 + @일/개월 가져오기
'============================================================================
Function CalcDate(sType,nDiff)

	sYear = contPeriod.cldToDate.calyear
	sMonth = contPeriod.cldToDate.calmonth
	sDay = contPeriod.cldToDate.calday
	
	sRsltDate = Replace(DateAdd (sType, nDiff,  sYear&"-"& sMonth &"-"& sDay), "-", "")
	return sRsltDate

End Function



	</SCRIPT_INFO>
</ROOT>