	<SCRIPT_INFO _len="16648" _ulen="15496" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_공통_선택화면
' 03. 작    성 : 2016.02.16 김보라
' 323 X 371
'-------------------------------------------------------------------------------------------
'============================================================================
'앱실행시첫화면("common.start_screen")
'종합화면("0"),관심종목("1"),주식현재가("2"),차트("3"),선물옵션현재가("4"),뉴스("5") - 초기값 "0"

'공인인증서로그인시첫화면("common.cert_start_screen") - 신규
'전체계좌조회("0"),이체("1"),입출금내역("2") - 초기값 "0"

'사이드종목변경버튼("common.side_modify") - 신규
'오른쪽("0"),왼쪽("1"),사용하지않음("2") - 초기값 "0"

'스킨설정("common.theme")
'화이트("white"),블랙("black") - 초기값 "white"

'글자크기("common.textsize") - 신규
'28("-2"),30("-1"),32("0"),34("1"),36("2") - 초기값 "0"

'현재가터치이동("common.curtouch_swing") - 신규
'관심종목일경우 관심그룹키("common.curtouch_swing_group") - 신규
'업종조회일경우 ("common.curtouch_swing_jisu") - 신규
'업종조회일경우 ("common.curtouch_swing_jisuitem") - 신규
'최근조회종목("0"),관심종목("1"),watching등록종목("2"),업종조회("3") - 초기값 "0"

'자동로그아웃("common.autologout")
'10분("10"),30분("30"),1시간("60"),2시간("120"),3시간("180"),10시간("600") - 초기값 "30"

'화면자동꺼짐방지("common.keep_light")boolean형
'사용하지않음("0"),사용("1") - 초기값 "1"

'관심종목동기화("common.interest_cloud") - 신규
'사용하지않음("0"),사용("1") - 초기값 "1"

'체결통보알림사용("alrim.chegyul")
'사용하지않음("0"),알림음사용("1"),진동+알림음사용("2") - 초기값 "1"

'Wathing알림방법("alrim.watching_view") - 신규
'팝업알림("0"),알림창알림("1") - 초기값 "0"
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sKey '전달받은키
Dim g_sScreenKey '앱실행시첫화면
Dim g_sCertScreenKey '공인인증서로그인시첫화면
Dim g_sSideChangeKey '사이드종목변경버튼
Dim g_sThemeKey '스킨설정
Dim g_sTextSizeKey '글자크기
Dim g_sCurTouchKey '현재가터치이동
Dim g_sGroupKey '관심종목그룹키
Dim g_sJisuKey '업종키
Dim g_sJisuItemKey '업종종목키
Dim g_sAutoLogoutKey '자동로그아웃
Dim g_sInterestCloudKey '관심종목동기화
Dim g_sChegyulKey '체결통보알림사용
Dim g_sWatchingViewKey 'Watching알림방법

'20210916 SWJ START
Dim g_sAppInitKey '시장종합에서 앱실행시 첫화면 설정
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sKey, sCtlName, sPropName)

	Dim sValue
	sValue = Form.GetEnvData(sKey)
	
	if sValue == null or Trim(sValue) == "" then
		if sKey == g_sThemeKey then
			sValue = "white"
		elseif sKey == g_sAutoLogoutKey then
			sValue = "30"
		elseif sKey == g_sChegyulKey then
			sValue = "1"
		else
			sValue = "0"
		end if
	end if
	
	if sKey == g_sThemeKey then
		if sValue == "white" then
			sValue = "0"
		else
			sValue = "1"
		end if
	elseif sKey == g_sAutoLogoutKey then
		if sValue == "10" then
			sValue = "0"
		elseif sValue == "30" then
			sValue = "1"
		elseif sValue == "60" then
			sValue = "2"
		elseif sValue == "120" then
			sValue = "3"
		elseif sValue == "180" then
			sValue = "4"
		else
			sValue = "5"
		end if	
	elseif sKey == g_sTextSizeKey then
		if sValue == "-2" then
			sValue = "0"
		elseif sValue == "-1" then
			sValue = "1"
		elseif sValue == "0" then
			sValue = "2"
		elseif sValue == "1" then
			sValue = "3"
		else
			sValue = "4"
		end if
	end if
	
	if sKey == g_sCurTouchKey then
		if sValue == "1" then
			Container0.Combo0.enable = true
			Container0.Combo1.enable = false
			Container0.Combo2.enable = false
		elseif sValue == "3" then
			Container0.Combo0.enable = false
			Container0.Combo1.enable = true
			Container0.Combo2.enable = true
		else
			Container0.Combo0.enable = false
			Container0.Combo1.enable = false
			Container0.Combo2.enable = false
		end if
	end if

	Form.SetCtlProp( sCtlName, sPropName, sValue )
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.GetCtlProp( sCtlName, sPropName )
	
	if sKey == g_sThemeKey then
		if sValue == "0" then
			sValue = "white"
		else
			sValue = "black"
		end if
	elseif sKey == g_sAutoLogoutKey then
		if sValue == "0" then
			sValue = "10"
		elseif sValue == "1" then
			sValue = "30"
		elseif sValue == "2" then
			sValue = "60"
		elseif sValue == "3" then
			sValue = "120"
		elseif sValue == "4" then
			sValue = "180"
		else
			sValue = "600" '20180910_01 KBC : 자동로그아웃시간 확대 6시간->10시간
		end if
	elseif sKey == g_sTextSizeKey then
		if sValue == "0" then
			sValue = "-2"
		elseif sValue == "1" then
			sValue = "-1"
		elseif sValue == "2" then
			sValue = "0"
		elseif sValue == "3" then
			sValue = "1"
		else
			sValue = "2"
		end if
	end if
	
	if sKey == g_sCurTouchKey then
		if sValue == "1" then
			if Container0.Combo0.caption == "" then
				Form.MsgBox( "알림", "선택할 관심그룹이 없습니다.", "", 6 )
				Exit Function
			end if
			
			Form.SetEnvData(1, g_sGroupKey, Container0.Combo0.cbkeydata)	
		elseif sValue == "3" then
			if Container0.Combo1.caption == "" or Container0.Combo2.caption == "" then
				Form.MsgBox( "알림", "선택할 업종이 없습니다.", "", 6 )
				Exit Function
			end if
		
			Form.SetEnvData(1, g_sJisuKey, Container0.Combo1.cbkeydata)
			Form.SetEnvData(1, g_sJisuItemKey, Container0.Combo2.cbkeydata)
		end if
	end if
	
	Form.SetEnvData(1, sKey, sValue)
	
	Form.SendReturnToParent("mhetc90000_p3" , sKey)
	
	Form.CloseForm()
	
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData, sText
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or Trim(sRevData) == "" then
		Exit Sub
	end if
	
	sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if sDeviceOS = "1" then
		Image4.visible = false
	else
		Image4.visible = true
	end if
	
	g_sKey = sRevData
	g_sScreenKey = "common.start_screen"
	g_sCertScreenKey = "common.cert_start_screen"
	g_sSideChangeKey = "common.side_modify"
	g_sThemeKey = "common.theme"
	g_sTextSizeKey = "common.textsize"
	g_sCurTouchKey = "common.curtouch_swing"
	g_sGroupKey = "common.curtouch_swing_group"
	g_sJisuKey = "common.curtouch_swing_jisu"
	g_sJisuItemKey = "common.curtouch_swing_jisuitem"
	g_sAutoLogoutKey = "common.autologout"
	g_sInterestCloudKey = "common.interest_cloud"
	g_sChegyulKey = "alrim.chegyul"
	g_sWatchingViewKey = "alrim.watching_view"
	g_sAppInitKey = "home_open_setting"		'20210916 SWJ START
	
	if g_sKey == g_sScreenKey then
		sText = "앱 실행 시 첫 화면"
		
		Container0.RadioLogin.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioLogin", "currentindex")
	elseif g_sKey == g_sCertScreenKey then
		sText = "공인인증서 로그인 시 첫 화면"
		
		Container0.RadioCert.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioCert", "currentindex")
	elseif g_sKey == g_sSideChangeKey then
		sText = "사이드 종목변경 버튼"
		
		Container0.RadioSide.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioSide", "currentindex")
	elseif g_sKey == g_sThemeKey then
		sText = "스킨설정"
		
		Container0.RadioTheme.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioTheme", "currentindex")
	elseif g_sKey == g_sTextSizeKey then
		sText = "글자크기"
		
		Container0.RadioText.visible = true
		Container0.lblText1.visible = true
		Container0.lblText2.visible = true
		Container0.lblText3.visible = true
		Container0.lblText4.visible = true
		Container0.lblText5.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioText", "currentindex")
	elseif g_sKey == g_sCurTouchKey then
		sText = "현재가 터치 이동"
		
		Container0.RadioTouch.visible = true
		Container0.Combo0.visible = true
		Container0.Combo1.visible = true
		Container0.Combo2.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioTouch", "currentindex")
		
		Dim sValue
		sValue = Form.GetEnvData(g_sInterestCloudKey)
		
		if sValue == null or Trim(sValue) == "" or sValue == "1" then '동기화
			DATAMANAGER.RequestTranData("ohhts_intr_006r") '관심그룹조회
		else '비동기화
			Dim sGroupID, sGroupName, sList, sGroupList, sTemp
			
			sList = Form.LoadConfigData("GWANSIM", "GROUP")
			
			if sList ~= null and Trim(sList) ~= "" then
				sGroupList = Split(sList, "♣")
				
				for i = 0 to #sGroupList-1
					sTemp = Split(sGroupList[i], "★")
					
					sGroupID = sTemp[0]
					sGroupName = sTemp[1]
					
					Container0.Combo0.cbadddatatext = sGroupID.."`"..sGroupName
				next
				
				Dim sValue
				sValue = Form.GetEnvData(g_sGroupKey)
				
				if sValue ~= null and Trim(sValue) ~= "" then
					Container0.Combo0.cbkeydata = sValue
				end if
			end if
		end if
		
		Dim sValue
		sValue = Form.GetEnvData(g_sJisuKey)
		
		if sValue ~= null and Trim(sValue) ~= "" then
			Container0.Combo1.cbkeydata = sValue
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_1511_001r" ) '업종조회
	elseif g_sKey == g_sAutoLogoutKey then
		sText = "자동 로그아웃"
		
		Container0.RadioLogout.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioLogout", "currentindex")
	elseif g_sKey == g_sChegyulKey then
		sText = "체결통보 알림 사용"
		
		Container0.RadioChegyul.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioChegyul", "currentindex")
	elseif g_sKey == g_sWatchingViewKey then
		sText = "Watching 알림 방법"
		
		Container0.RadioWatching.visible = true
		
		GetConfigData(g_sKey, "Container0.RadioWatching", "currentindex")
	
	'20210916 SWJ START
	elseif g_sKey == g_sAppInitKey then
		 sText = "앱 실행 시 첫 화면"
		 
		 Container0.RadioLogin.visible = true		
		 
		 g_sKey = g_sScreenKey
		 
		 GetConfigData(g_sKey, "Container0.RadioLogin", "currentindex")
	end if
	'20210916 SWJ END
	
	Container0.LabelTitle.caption = sText
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_intr_006r" then
		Dim sUserID
		sUserID = Form.GetSharedData("&USER_ID", false)
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, sUserID)
	elseif szTranID == "ohhts_1511_001r" then	
		DATAMANAGER.SetDataValue( 0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "U" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "1511" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , Container0.Combo1.cbkeydata )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_intr_006r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_intr_006r", "OutBlock1" )
		
		if nCnt > 0 then
			Dim sGroupID, sGroupName

			for i = 0 to nCnt-1
				sGroupID = DATAMANAGER.GetDataValue( 0, "ohhts_intr_006r", "OutBlock1", "FID_CNCN_ISSU_NEW_GRP_ID" , i )	'20230721 HSZ 필드명수정
				sGroupName = DATAMANAGER.GetDataValue( 0, "ohhts_intr_006r", "OutBlock1", "FID_CNCN_GRP_NAME" , i )
				
				Container0.Combo0.cbadddatatext = sGroupID.."`"..sGroupName '관심그룹설정
			next
			
			Dim sValue
			sValue = Form.GetEnvData(g_sGroupKey)
			
			if sValue ~= null and Trim(sValue) ~= "" then
				Container0.Combo0.cbkeydata = sValue
			end if
		end if
	elseif szTranID == "ohhts_1511_001r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_1511_001r", "OutBlock1" )

		if nCnt > 0 then
			Dim sCode, sName

			for i = 0 to nCnt-1
				sCode = DATAMANAGER.GetDataValue( 0, "ohhts_1511_001r", "OutBlock1", "FID_SHRN_ISCD" , i )
				sName = DATAMANAGER.GetDataValue( 0, "ohhts_1511_001r", "OutBlock1", "FID_KOR_ISNM" , i )
				
				Container0.Combo2.cbadddatatext = sCode.."`"..sName '업종설정
			next
		
			Dim sValue
			sValue = Form.GetEnvData(g_sJisuItemKey)
			
			if sValue ~= null and Trim(sValue) ~= "" then
				Container0.Combo2.cbkeydata = sValue
			end if
		end if
	end if
End Sub

'============================================================================
Sub Container0_RadioTouch_OnClick(nIndex)
	if nIndex == 1 then
		Container0.Combo0.enable = true
		Container0.Combo1.enable = false
		Container0.Combo2.enable = false
	elseif nIndex == 3 then
		Container0.Combo0.enable = false
		Container0.Combo1.enable = true
		Container0.Combo2.enable = true
	else
		Container0.Combo0.enable = false
		Container0.Combo1.enable = false
		Container0.Combo2.enable = false
	end if	
End Sub

'============================================================================
Sub Container0_Combo1_OnEditComplete(iIndex)
	Container0.Combo2.clear = true
	DATAMANAGER.RequestTranData( "ohhts_1511_001r" ) '업종조회
End Sub

'============================================================================
Sub Container0_ButtonOK_OnClick()
	if g_sKey == g_sScreenKey then
		
		SetConfigData(g_sKey, "Container0.RadioLogin", "currentindex")
	elseif g_sKey == g_sCertScreenKey then
		SetConfigData(g_sKey, "Container0.RadioCert", "currentindex")
	elseif g_sKey == g_sSideChangeKey then
		SetConfigData(g_sKey, "Container0.RadioSide", "currentindex")
	elseif g_sKey == g_sThemeKey then
		SetConfigData(g_sKey, "Container0.RadioTheme", "currentindex")
	elseif g_sKey == g_sTextSizeKey then
		SetConfigData(g_sKey, "Container0.RadioText", "currentindex")
	elseif g_sKey == g_sCurTouchKey then
		SetConfigData(g_sKey, "Container0.RadioTouch", "currentindex")
	elseif g_sKey == g_sAutoLogoutKey then
		SetConfigData(g_sKey, "Container0.RadioLogout", "currentindex")
	elseif g_sKey == g_sChegyulKey then
		SetConfigData(g_sKey, "Container0.RadioChegyul", "currentindex")
	elseif g_sKey == g_sWatchingViewKey then
		SetConfigData(g_sKey, "Container0.RadioWatching", "currentindex")
	end if
End Sub

