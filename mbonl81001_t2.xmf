'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szList			'계좌번호와 비밀번호
Dim szDsgtCls			'약정여부
Dim g_szPW			'비밀번호

Dim g_szOpenData		'계좌번호 ; 비밀번호 (예외계좌추가 팝업으로 보낼 데이터)
Dim g_nSelectCount	'선택한 셀의 개수
Dim g_nTRCount		'조회된 TR 개수
Dim g_sUserID			'사용자 ID
Dim	g_PlainRm 'v001
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	if szTranID == "obpds_srvc_412r" then	'지연이체 서비스 약정 조회
		DATAMANAGER.SetDataValue(0, "obpds_srvc_412r", "InBlock1", "SVCD" , 0 , "069"		 )	'서비스코드:지연이체서비스
		DATAMANAGER.SetDataValue(0, "obpds_srvc_412r", "InBlock1", "ACNO" , 0 , g_szList(0))	'계좌번호
		DATAMANAGER.RequestTranData("obpds_srvc_412r")
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_sUserID)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000")'기본 '200'  등록 '400'
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
	
'20160711	
'	if szTranID == "obpds_srvc_411a" then	'지연이체 서비스 약정 등록
'		if szDsgtCls == "Y" then			
'			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "PROS_CLS_CODE" 	, 0 , "D"		) '약정해지
'		else 
'			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "PROS_CLS_CODE"	, 0 , "I"		) '약정등록
'		end if
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVCD" 				, 0 , "069"		) '서비스코드:지연이체서비스
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "01"		) '고객단위:고객
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNO"				, 0 , g_szList(0)	) '계좌번호
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "CONT_CLS_CODE"		, 0 , "4"		) '접촉구분코드: 온라인
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNT_PWD" 			, 0 , g_szPW		) '계좌비밀번호
'		DATAMANAGER.RequestTranData("obpds_srvc_411a")
'	end if


End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v001
	grd0.SetCellData("bd_cell0", 0, 0)
	g_nSelectCount = 0
	
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_412r" then	'지연이체 서비스 약정 조회
		g_nTRCount =  DATAMANAGER.GetDataCount(0, "obpds_srvc_412r", "OutBlock1")-1
		
		for i=0 to g_nTRCount
		    szCode = DATAMANAGER.GetDataValue(0, "obpds_srvc_412r", "OutBlock1", "BANK_CODE" , i)
		    szName = Form.GetMetaData("은행코드", szCode)
		    grd0.SetCellData("bd_cell1", i, szName)	
		next	
		
		g_nTRCount = DATAMANAGER.GetDataCount( 0, "obpds_srvc_412r", "OutBlock1")
		for i = 0 to g_nTRCount - 1
			grd0.SetCellData("bd_cell0", i, 0)
			grd0.SetCellBgColor("bd_cell0", i, "38")
			grd0.SetCellBgColor("bd_cell1", i, "38")
			grd0.SetCellBgColor("bd_cell2", i, "38")
			grd0.SetCellBgColor("bd_cell3", i, "38")
			grd0.SetCellBgColor("bd_cell4", i, "38")
		next
		
		if DATAMANAGER.IsMoreNextData( "obpds_srvc_412r" ) == true then
			DATAMANAGER.RequestNextData( "obpds_srvc_412r" )
		end if
		g_nSelectCount = 0
		g_nSuccesCount = 0
	elseif szTranID == "obpds_srvc_411a" then
		'if g_nSuccesCount ~= 0 and g_nSuccesCount == g_nSelectCount then
			'g_nSelectCount = 0
			'g_nSuccesCount = 0
			Form.ShowAlert("알림", "예외계좌가 삭제되었습니다.")
			DATAMANAGER.RequestTranData("obpds_srvc_412r")			'완료후 재조회
		'end if
		DATAMANAGER.RequestTranData("obpds_srvc_412r")			'버퍼로 인해 처리만 되고 팝업창이 안뜨고 재조회도 안되는 경우 대비
	elseif szTranID == "obcsb_oimf_638r" then
		if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "0" then	'보안카드
			Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "1" then	'부가정보
			Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "2" then	'보안매체없음
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "3" then	'OTP
			Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "4" then	'mOTP v002
		    Form.OpenPopup("mhetc90060_motp" , "motp_success" , sPosInfo)
		else			'오류
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if
	end if
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName <> "예외계좌등록" then
		Exit Sub
	end if

	g_szList = Split(sParam, "★")
		
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
		
'	g_szPW = Form.GetEncData(g_szList(1)) 'v001
	'v001
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPW = g_szList(1) 'v001
	Else
		g_szPW = Form.GetEncData(g_szList(1)) 'v001
	End If
	
	
	'지연이체 서비스 약정 조회
	Call TR_Inquiry("obpds_srvc_412r")	
End Sub 
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell0" then
		if grd0.GetCellData("bd_cell0", lRow) == "0" then
			grd0.SetCellBgColor("bd_cell0", lRow, "38")
			grd0.SetCellBgColor("bd_cell1", lRow, "38")
			grd0.SetCellBgColor("bd_cell2", lRow, "38")
			grd0.SetCellBgColor("bd_cell3", lRow, "38")
			grd0.SetCellBgColor("bd_cell4", lRow, "38")
			g_nSelectCount = g_nSelectCount - 1
		elseif grd0.GetCellData("bd_cell0", lRow) == "1" then
			grd0.SetCellBgColor("bd_cell0", lRow, "44")		
			grd0.SetCellBgColor("bd_cell1", lRow, "44")
			grd0.SetCellBgColor("bd_cell2", lRow, "44")
			grd0.SetCellBgColor("bd_cell3", lRow, "44")
			grd0.SetCellBgColor("bd_cell4", lRow, "44")
			g_nSelectCount = g_nSelectCount + 1
		end if
	end if
	
	if g_nSelectCount > 99 then
		Form.ShowAlert( "알림", "최대 100건씩 처리 가능합니다.")
		for i = 0 to grd0.rowcount 
			if grd0.GetCellData("bd_cell0", i) ~= "1" then
				grd0.SetCellEnable( "bd_cell0", i, false)
			end if
		next
		Exit Sub
	end if
End Sub

'============================================================================
' 예외계좌추가 + 
'============================================================================
Sub btn0_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szPW== "" or TopPW == "" then		'비밀번호 입력요구창
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Sub
	else
		g_szOpenData =  g_szList(0) & "★" & g_szPW & "★" & "1"
		Form.OpenPopup("mbonl81001_p1.xmf" , g_szOpenData ,"")
	end if	
End Sub

'============================================================================
' 예외계좌삭제 -
'============================================================================
Sub btn1_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szPW== "" or TopPW == "" then		'비밀번호 입력요구창
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Sub
	else
		if g_nSelectCount == 0 then
			Form.MsgBox("Meritz", "삭제할 계좌를 선택하여 주십시오.", 0, 6)
			Exit Sub
		end if
		Form.OpenFramePopup("mhetc90060_p8" , "bank_update" , "")
	end if
End Sub 
'============================================================================
Function SendDel()	

	Dim nRow
	nRow = 0
	for i = 0 to g_nTRCount - 1
		if grd0.GetCellData("bd_cell0", i) == "1" then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "PROS_CLS_CODE"	 , nRow ,"A"		    				 	)	'처리구분코드(A:예외계좌삭제)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVCD"	 		 , nRow ,"069"		    			 	)	'서비스코드
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVC_MANG_UNIT_CODE", nRow ,"01"		    				 	)	'01: 고객
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "CONT_CLS_CODE"	 , nRow ,"4"		    				 	)	'4 : 온라인
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNO"	  	 	 , nRow ,g_szList(0)				 	)	'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNT_PWD"	 	 , nRow ,g_szPW					 	)	'비밀번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "TACT_BANK_ACNO"	 , nRow ,grd0.GetCellData("bd_cell2", i) )	'계좌번호
			nRow = nRow + 1
		end if
		'DATAMANAGER.RequestTranData("obpds_srvc_411a")	
	next
	DATAMANAGER.RequestTranData("obpds_srvc_411a")	
	'Call TR_Inquiry("obpds_srvc_412r")
End Function 
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obpds_srvc_412r")
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obpds_srvc_412r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_412r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obpds_srvc_411a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_411a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		g_nSuccesCount = 0
	elseif szTranID == "obcsb_oimf_638r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_638r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
End Sub 

'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'Call TR_Inquiry("obpds_srvc_412r")
	
	If sKeyName == "예외계좌추가" then
	
	'Form.MsgBox("Meritz", sKeyName, 0, 6)
'	   If sRet <> "" then
'		 if sRet = "succ" then
'			'지연이체 서비스 약정 조회
'			Call TR_Inquiry("obpds_srvc_412r")	
'		 end if
'	   End If   
	   Call TR_Inquiry("obpds_srvc_412r")
	end if
	
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공 -> 보안매체조회 및 인증
			Call TR_Inquiry("obcsb_oimf_638r")	
		else
			Form.CloseForm( )
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
