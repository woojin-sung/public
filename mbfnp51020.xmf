		<ACCOUNT name="acnt01" bgcolor="052:255255255" itemcodetype="100,104,106,109,110,118,123,128,130,131,132,138,139,140,200" etcfunctions="" ly_vert="20,42,335,44,1" />
		<FORMTAB name="fmtab0" tabcount="2" tabwidthtype="1" tabheadheight="48" autosave="1" ly_vert="0,96,375,511,1" >
			<PAGE name="page003363" caption="이체 신청" linkfile="mbfnp51020_t2" loadingtype="1" />
			<PAGE name="page000098" caption="신청 내역" linkfile="mbfnp51020_t1" loadingtype="1" />
		</FORMTAB>
		<LABEL name="LblTitle" fontsize="4" caption="펀드자동이체" paddinginfo="1,0,0,0" ly_vert="40,6,222,30,1" />
		<IMAGE name="ImgInfo" autosize="1" imgpath="icon_notice" ly_vert="330,8,22,22,1" />
		<IMAGE name="ImgClose" autosize="1" imgpath="icon_arrow_left_on" ly_vert="6,7,25,25,1" />
