	<SCRIPT_INFO _len="4224" _ulen="3998" >
'============================================================================
' 01.화면명 	: 펀드자동이체
' 02.화면설명	: 펀드자동이체
' 03.작성	: 2016. 03. 10. 유창재
' 04.수정     : 2020.09.15 : 비밀번호 메모리 평문 노출 취약점 조치 v0001
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData			'데이터
Dim g_nfmtabIndex
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.setMaintainingRatio("1")
	ImgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_nfmtabIndex	= 0
	
	'3: 폐쇄계좌, 4:해지계좌 제외
	acnt01.statusexcept = "3:4"
	
	g_szData		= acnt01.total & "★" & acnt01.sequence
	
	if CInt(fmtab0.currenttab) == 0 then
		Form.triggerEvent("fmtab0."&fmtab0.currenttabpageid, "mbfnp51020_t2", g_szData)
	elseif CInt(fmtab0.currenttab) == 1 then
		Form.triggerEvent("fmtab0."&fmtab0.currenttabpageid, "mbfnp51020_t1", g_szData)
	end if
	
	Form.OpenPopup("mbfnp51020_p5", "", "")
End Sub



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	If sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		
		If sParam = "POPUP1" Then								' 잔고평가
			Form.OpenDialog("51010" , "4", "")
			
		ElseIf sParam = "SHA_SNS" Then							' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "snsshare" Then   ' SNS공유
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then          ' 이미지공유
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			   
			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else              ' 현재가공유
			Form.triggerEvent("linkfmHoga", "sharedata", "")   
		End If
	
	elseif sKeyName == "mbfnp51020_p5" then
		
		if sRet == "CANCEL" then
			Form.CloseForm()
		end if
		
	End If
 
End Sub


'============================================================================
'						CONTROL 함수
'============================================================================
' 닫기
'============================================================================


'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)	
	g_nfmtabIndex = nCurrentTab
	
	if g_nfmtabIndex == 0 then
		Form.triggerEvent("fmtab0."&fmtab0.currenttabpageid, "mbfnp51020_t2", g_szData)
	else
		Form.triggerEvent("fmtab0."&fmtab0.currenttabpageid, "mbfnp51020_t1", g_szData)
	end if
	
End Sub

'============================================================================
Sub acnt01_ChangeAccount()
	g_szData = acnt01.total & "★" & acnt01.sequence
	
	if g_nfmtabIndex == 0 then
		Form.triggerEvent("fmtab0."&fmtab0.currenttabpageid, "mbfnp51020_t2", g_szData)
	else
		Form.triggerEvent("fmtab0."&fmtab0.currenttabpageid, "mbfnp51020_t1", g_szData)
	end if
	
End Sub
'============================================================================
' INFO 클릭
'============================================================================
Sub ImgInfo_OnClick()
	Form.OpenPopup("mbfnp51020_p7", "", "")
End Sub
'============================================================================
Sub ImgClose_OnClick()
	'Form.CloseForm()
    Form.openPrevScreen()
End Sub

	</SCRIPT_INFO>
</ROOT>