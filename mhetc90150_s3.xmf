'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	if szTranID == "obaci_nmet_011r" then
		szProsClsCode = ""
		szRsltCode    = ""
		
		szProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		szRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If szProsClsCode == "5" and TRIM(szRsltCode) <> "00" Then
			
			sReturnMsg = ReturnPwdErrorMsg(szRsltCode)
			
			Form.MsgBox("안내", "유효하지 않은 비밀번호 입니다.\n".. sReturnMsg, "", 0)
			
			Form.SetSharedData("CLOUD_CERT_ORIGINAL_PWD" , Container0.EditReal.caption2)
			
			Container0.EdtPwReal.caption = ""
			nCnt = 0
			PasswordFail()
			
		Else '비밀번호 입력 성공시
			
			Call PasswordInsert()
			
			'다음 화면에서 비번 재검증 위해 set
			Form.SetSharedData("CLOUD_CERT_PWDAuth",  Container0.EditReal.caption2 )
			
			if g_sScrPoint == "new" then
				'비번 재입력 팝업
				Form.OpenPopup( "mhetc90150_s4" , "" , "")
				
			elseif g_sScrPoint == "UploadToCloud" then

				Form.SetSharedData("CLOUD_CERT_LOCAL_PWD", g_sCloudCertLocalPwd)
				Form.SetSharedData("CLOUD_CERT_INDEX" , g_sCloudCertIndex)
				
				'비번 재입력 팝업
				Form.OpenPopup( "mhetc90150_s4" , "UploadToCloud" , "")
			end if
		End If
	
	elseif szTranID == "obaci_acct_239r" then
	
		'Array이지만 하나만 받아서 쓰자
		'비밀번호 정합성 체크 시 맨 위에 계좌번호로 체크해도
		' 업무적으로 문제 없다고 확인함
		g_sCloudAcno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNO" , 0)
		
		Form.SetSharedData( "CLOUD_CERT_ACNO" ,g_sCloudAcno)
		
		DATAMANAGER.RequestTranData("obaci_nmet_011r") 
	
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obaci_nmet_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "5")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_sCloudAcno )   '20230622 jsi 계좌번호 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , Container0.EditReal.caption2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     , 0 , g_ClphNo    ) '20230623 jsi 휴대폰 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WRPL_TELNO"     , 0 , g_WorkNo    ) '20230622 jsi 직장전화 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OWHS_TELNO"     , 0 , g_HomeNo    ) '20230622 jsi 자택전화 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0 , g_sCloudRcnoPip   )
		
	elseif szTranID == "obacp_comm_004r" then  '20230622 jsi obacp_comm_004r 연락처 정보 조회 전 세팅 /'비로그인 시에는 meritz로 세팅 되기 때문에 헤더값세팅

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"   , 0 , g_sCloudAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , "meritz"   )  
		
	elseif szTranID == "obcpp_pcrt_173a" then
		DATAMANAGER.SetUserID( g_sCloudID )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "USER_ID" , 0 , g_sCloudID )
		
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "CRPT_YN"  , 0 , "Y"   )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "RCNO_PIP" , 0 , g_sAsctRcno )
		
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "USER_NAME" , 0 , g_sCloudCustName )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "CSNO" , 0 , g_sCSNO)
	
	elseif szTranID == "obcsb_efif_011r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_011r", "InBlock1", "RCNO_PIP" , 0 , g_sCloudRcnoPip )
	
	elseif szTranID == "obcsb_acif_005r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_005r", "InBlock1", "PROS_CLS_CODE",  0, "4")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_005r", "InBlock1", "RCNO_PIP"	 ,  0, g_sCloudRcnoPip)
		
	elseif szTranID == "obcpp_logn_003a" then
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_003a", "InBlock1", "USER_ID" , 0 , g_sCloudID )
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_003a", "InBlock1", "PBCR_PWD_MSTK_TMNU" , 0 , "0007" ) '20160527_02 KBC : 인증서 비밀번호오류횟수초기화 "0" -> "0007"로 수정
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_003a", "InBlock1", "SUCS_YN" , 0 , "Y" )
	
	elseif szTranID == "obaci_acct_239r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"   		 , 0 , g_sCloudID )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_STAT_CODE"   , 0 , "1"   )
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub
'============================================================================
Sub Container0_BtnRegi_OnClick()
	Form.OpenPopup("mpopup_auth","CommonAuthPopup","")
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	if g_nextpage then
			
		if g_sScrPoint == "ChangePwd" then
			Form.SetSharedData("CLOUD_CERT_ORIGINAL_PWD", Container0.EditReal.caption2)
			Form.OpenPopup("mhetc90153_p1" , "ChangePwd" & "★" & g_sCloudCertID & "★" & g_sCloudCertDN , "")
			
		elseif g_sScrPoint == "DownloadToLocal" then
		
			Form.SetSharedData("CLOUD_CERT_ORIGINAL_PWD", Container0.EditReal.caption2)
			Form.SetSharedData("CLOUD_CERT_INDEX" , g_sCloudCertIndex)
			Form.OpenPopup("mhetc90153_s1" , "" , "")	
		
		end if
		
		Form.SendReturnToParent("mhetc90150_s3" , g_sScrPoint)
		
		exit sub
	end if
	
	Form.SendReturnToParent("mhetc90150_s3" , "cancel")

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID == "obacp_comm_004r" then 
	    g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
	    g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
	    g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
	    g_sCloudRcnoPip = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RCNO_PIP" 		, 0)  '실명확인번호
	    
	    Form.SetSharedData("CLOUD_CERT_PHONENUM", g_ClphNo)
	    
	    if g_sCloudAcno <> "" then
		    DATAMANAGER.RequestTranData("obaci_nmet_011r") 
	    else
		    DATAMANAGER.RequestTranData("obaci_acct_239r")
	    end if
	    
	end if
	
	if szTranID == "obcsb_efif_011r" then
		g_sAsctRcno = DATAMANAGER.GetDataValue( 0, "obcsb_efif_011r", "OutBlock1", "ASCT_PSPR_NO_PIP", 0 )

		g_sRcnoPip = DATAMANAGER.GetDataValue(0, "obcsb_efif_011r", "OutBlock1", "RCNO_PIP" , 0)
		
		DATAMANAGER.RequestTranData( "obcsb_acif_005r" ) 
	end if
	
	if szTranID == "obcsb_acif_005r" then
		g_sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_005r", "OutBlock1", "CSNO", 0 )
		
		DATAMANAGER.RequestTranData("obcpp_pcrt_173a") 
	end if
	
	if szTranID == "obcpp_pcrt_173a" then
		DATAMANAGER.RequestTranData( "obcpp_logn_003a" ) '인증접속로그
	end if 
	
	if szTranID == "obcpp_logn_003a" then	
		Form.OpenPopup("mhetc90150_p2", "register", "")
	end if
End Sub

'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)

	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")
	
	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		
		if #szItem > 2 then
			Form.MsgBox("안내", szItem(3), "", 0)
		else
			Form.MsgBox("안내", sErrorMsg, "", 0)
		end if
		
		'개발중 에러코드 찾기 편하게 편의상 남긴다.
		'(나중에 지운다. 못지워도 큰 문제없고)
		Form.SaveConfigData("CLOUD_CERT_ERRORCODE", "mhetc90150_s3" & "★" & szItem(2), szItem(3))
		
		exit sub
	end if		
	
	'PIN 인증 완료
	if sCommand = "CLOUD_REQ_CHECK_PASSWD_90150" then
	
		if g_sScrPoint == "RemoveCloudCert" then
			Form.requestCertCommand("CLOUD_REQ_CERT_DELETE", g_sCloudCertID , "90150") 
			
		elseif g_sScrPoint == "RenewCloudCert" then
			sPinPwd = Container0.EditReal.caption2
			
			sInput = g_sCloudCertID &  "★"  & g_sCloudCertSerial &  "★"  & sPinPwd
			Form.requestCertCommand("CLOUD_REQ_CERT_UPDATE", sInput , "90150") 
		
		elseif g_sScrPoint == "register" then
			
			sInput = g_sCloudCertID &  "★"  & Container0.EditReal.caption2 &  "★"  & g_sCloudID
			Form.requestCertCommand("CLOUD_REQ_SIGNDATA_LOGIN", sInput , "90150") 
			
		else
			g_nextpage = true
			Form.CloseForm()
		end if

	end if
	
	'타기관 인증서 등록
	if sCommand = "CLOUD_REQ_SIGNDATA_LOGIN_90150" then
	
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "UI_R_VAL" , 0 , szItem(3) )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" , 0 , szItem(4) )
			
		DATAMANAGER.RequestTranData("obcsb_efif_011r") 
	end if
	
	'인증서 삭제
	if sCommand = "CLOUD_REQ_CERT_DELETE_90150" then
		Form.OpenPopup("mhetc90150_p2" , "RemoveCloudCert" , "")
	end if
	
	'인증서 갱신
	if sCommand = "CLOUD_REQ_CERT_UPDATE_90150" then
		Form.OpenPopup("mhetc90150_p2" , "RenewCloudCert" , "")
	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90150_p2" then
		Form.CloseForm()
	end if
	
	if sKeyName == "mhetc90150_s4" then
		if sRet == "retry" then
			'비밀번호 입력키패드 Show
			Form.SetTimerEvent2(1, 1, 0.6)
		else
			Form.CloseForm()
		end if
	end if
End Sub
'============================================================================
Function ReturnPwdErrorMsg(sErrCode)

	Select Case sErrCode
	
	Case "06" '4-8 자리체크
		sErrMsg = "( 4 ~ 8자리 가능 )"
	Case "01"
		sErrMsg = "(연속된 4자리 숫자)"
	Case "02"
		sErrMsg = "(동일한 숫자)"
	Case "03"
		sErrMsg = "(휴대폰번호와 4자리 이상 일치)"
	Case "04"
		sErrMsg = "(자택번호와 4자리 이상 일치)"
	Case "05"
		sErrMsg = "(직장번호와 4자리 이상 일치)"
	Case "07"
		sErrMsg = "(실명확인번호와 4자리 이상 일치)"
	Case "08"
		sErrMsg = "(계좌번호와 4자리 이상 일치)"
	Case Else
		sErrMsg = ""
	End Select
	
	return sErrMsg
	
End Function
