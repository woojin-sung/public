		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 2	
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 3
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false	
		Container0.Pwdbasic2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false
	Case 4
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true	
		Container0.PwdInsert3.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false	
		Container0.Pwdbasic2.visible = false	
		Container0.Pwdbasic3.visible = false		
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 5
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true	
		Container0.PwdInsert3.visible = true	
		Container0.PwdInsert4.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false	
		Container0.Pwdbasic2.visible = false	
		Container0.Pwdbasic3.visible = false	
		Container0.Pwdbasic4.visible = false		
