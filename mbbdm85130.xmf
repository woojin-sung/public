Function Confirm_CFD_Init_Data()  'v0001
	'G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
	Form.SetSharedData("BDM_CFD_CtcnChkAll"      , ""  )  'CFD 전체약관
	Form.SetSharedData("BDM_CFD_CtcnChk1"        , ""  )  '장외파생상품거래 기본계약서(위험고지 포함)
	Form.SetSharedData("BDM_CFD_CtcnChk2"        , ""  )  '장외파생상품 담보계약서
	Form.SetSharedData("BDM_CFD_CtcnChk3"        , ""  )  '장외파생상품 투자를 위한 전문투자자 대우 확인서
	Form.SetSharedData("BDM_CFD_CtcnChk4"        , ""  )  '개인전문투자자에 대한 보호제도 미적용 확인서
	Form.SetSharedData("BDM_CFD_CtcnChk5"        , ""  )	'v0005 금융거래 정보제공 동의서
	
End Function 
'============================================================================
Function Confirm_CFD_Set_Data()  'v0001
'	G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
	Form.SetSharedData("BDM_CFD_CtcnChkAll"     , g_BDM_CFD_CtcnChkAll        )  'CFD 전체약관
	Form.SetSharedData("BDM_CFD_CtcnChk1"       , g_BDM_CFD_CtcnChk1          )  '장외파생상품거래 기본계약서(위험고지 포함)
	Form.SetSharedData("BDM_CFD_CtcnChk2"       , g_BDM_CFD_CtcnChk2          )  '장외파생상품 담보계약서
	Form.SetSharedData("BDM_CFD_CtcnChk3"       , g_BDM_CFD_CtcnChk3          )  '장외파생상품 투자를 위한 전문투자자 대우 확인서
	Form.SetSharedData("BDM_CFD_CtcnChk4"       , g_BDM_CFD_CtcnChk4          )  '개인전문투자자에 대한 보호제도 미적용 확인서
	Form.SetSharedData("BDM_CFD_CtcnChk5"       , g_BDM_CFD_CtcnChk5          )	'v0005 금융거래 정보제공 동의서
	
End Function
