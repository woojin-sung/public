Function First_Step2_Get_Data()  'v0001
'	'2단계진입 설정정보 ----------------------------------------
	g_BDM_ABLE_YN				= Form.GetSharedData("BDM_ABLE_YN"			, false)	'개별추가가능여부
	g_BDM_OVRL_ACNT_OPNG_YN	= Form.GetSharedData("BDM_OVRL_ACNT_OPNG_YN"	, false)	'종합개설가능여부(최근30일내종합신규개설여부)	Y.불가 N.가능
