Function G_STEP2_2_FILE_Get_Data()  'v0004
'	'G_STEP2_2_FILE 설정정보 ----------------------------------------
	g_BDM_CtcnChkAll	= Form.GetSharedData("BDM_CtcnChkAll" , false)	'전체약관
	g_BDM_CtcnChk1	= Form.GetSharedData("BDM_CtcnChk1"   , false)	'계좌개설/서비스기본약관
	g_BDM_CtcnChk2	= Form.GetSharedData("BDM_CtcnChk2"   , false)	'금융거래필수안내/위험고지 확인
	g_BDM_CtcnChk100	= Form.GetSharedData("BDM_CtcnChk100" , false)	'종합매매계좌 주요약관/설명서
	g_BDM_CtcnChk118	= Form.GetSharedData("BDM_CtcnChk118" , false)	'CMA계좌 주요약관/설명서
	g_BDM_CtcnChk101	= Form.GetSharedData("BDM_CtcnChk101" , false)	'선물옵션계좌 주요약관/설명서
	g_BDM_CtcnChk135	= Form.GetSharedData("BDM_CtcnChk135" , false)	'해외파생계좌 주요약관/설명서
	g_BDM_CtcnChkMndt	= Form.GetSharedData("BDM_CtcnChkMndt", false)	'개인(신용)정보 처리 필수 동의서
	g_BDM_CtcnChkSlct	= Form.GetSharedData("BDM_CtcnChkSlct", false)	'개인(신용)정보 처리 선택 동의서	
	g_BDM_CtcnChkCFD	= Form.GetSharedData("BDM_CtcnChkCFD", false)		'CFD계좌 주요약관/설명서
	'v0004 
	g_BDM_MISA_CtcnChk1 = Form.GetSharedData("BDM_MISA_CtcnChk1", false)	'중개형ISA 주요약관/설명서
	g_BDM_ISA_ACNT_OPNG_CLCD	= Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"		, false)	'ISA계좌개설구분코드(1:신규/2:이수)
	g_BDM_137_CtcnChk1 = Form.GetSharedData("BDM_137_CtcnChk1"		, false)	' v0005 해외CFD계좌 약관/거래설명서(위험고지)
	g_BDM_BNK_MNY_OPNG_YN = Form.GetSharedData("BDM_BNK_MNY_OPNG_YN" , false)  'v0008 단기다수개설여부
	
End Function
'============================================================================
Function G_STEP2_4_5_FILE_Get_Data_v0007()  'v0007
	'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 ----------------------------------------
    g_BDM_DMST_CFD_ACNT_APLT_YN1  = Form.GetSharedData("BDM_DMST_CFD_ACNT_APLT_YN1"           , false)		'국내CFD 계좌신청여부(일반)
    g_BDM_DMST_CFD_ACNT_APLT_YN2  = Form.GetSharedData("BDM_DMST_CFD_ACNT_APLT_YN2"           , false)		'국내CFD 계좌신청여부(안심)
    g_BDM_OVRS_CFD_ACNT_APLT_YN1  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN1"           , false)		'해외CFD 계좌신청여부(미국/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN2  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN2"           , false)		'해외CFD 계좌신청여부(미국/안심)
    g_BDM_OVRS_CFD_ACNT_APLT_YN3  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN3"           , false)		'해외CFD 계좌신청여부(중국/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN4  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN4"           , false)	 	'해외CFD 계좌신청여부(중국/안심)	
    g_BDM_OVRS_CFD_ACNT_APLT_YN5  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN5"           , false)		'해외CFD 계좌신청여부(홍콩/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN6  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN6"           , false)	 	'해외CFD 계좌신청여부(홍콩/안심)
    g_BDM_OVRS_CFD_ACNT_APLT_YN7  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN7"           , false)		'해외CFD 계좌신청여부(일본/일반)
    g_BDM_OVRS_CFD_ACNT_APLT_YN8  = Form.GetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN8"           , false)		'해외CFD 계좌신청여부(일본/안심)   
End Function


'============================================================================
Sub Form_OnFormInit()
	'개발까지만 잠시 막아둠
'	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	'OSType 1.안드로이드 2.IOS 
	g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)
	
	g_ChkDate = Form.GetSharedData("&HOST_DATE",0)	'v0011
	g_chkYear = Left(g_ChkDate,4) 'v0011
	
	szTheme = Form.GetEnvData("common.theme")
	
	'g_nPrevFlag = 0 '2021-08-05 ksj 다음화면에서 넘어온경우 초기 플래그 셋팅
	
	g_bDraw0 = false
	
	ContMain.Image0.SetStatus("normal")
	ContMain.imgUnderA.SetStatus("normal")
	ContMain.imgUnderB.SetStatus("normal")
	ContMain.imgUnderC.SetStatus("normal")
	ContMain.imgUnderD.SetStatus("normal")
	ContMain.imgUnderE.SetStatus("normal")
	ContMain.imgUnderF.SetStatus("normal")
	ContMain.imgUnderG.SetStatus("normal")
	ContMain.imgUnderH.SetStatus("normal")
	ContMain.imgUnderI.SetStatus("normal")
	ContMain.imgUnderJ.SetStatus("normal")
	ContMain.imgUnderK.SetStatus("normal")
	
	btnOK.enable = false
	
	'OS별 타이틀 이미지 위치 조정
	If g_sz_OSType == "2" Or g_sz_OSType == 2 Then
		ContMain.Image1.left = 7
	End If
	
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		 = "269" 
	prodFlag =0		 '상품선택구분
	
	'공유변수 데이터GET JMY
	User_SharedData_Get()
	
	'주민등록번호 검사
	If Len(g_BDM_RCNO_PIP) <= 0 then
		ShowAlert "알림", "고객 정보를 정상적으로 읽지 못했습니다. 본인확인 절차로 돌아가십시오."
		Exit Sub
	End If
	
	'v0011
	if g_chkYear == "2022" then
		ContMain.Label0.caption = "슈퍼365 (국내/해외주식 + RP자동투자)"
	end if
	
	sRevData = Form.GetOpenLinkData()
	'다음화면에서 넘어온 경우
	if sRevData == "StepBack" then 
		If g_SAYN == "Y" Then
			g_SAYN = "N"
			Draw0()
		End If
		
		If g_STOCKYN == "Y" Then
			g_STOCKYN = "N" 
			DrawA()
		End If
	
		'CMAPlus/CMARp 신청여부
		If g_CMAYN == "Y" Then
			g_CMAYN = "N"
			DrawB()
		End If
	
		'종합매매-금융상품 신청여부
		If g_FSTOCKYN == "Y" Then
			g_FSTOCKYN = "N"
			DrawC()
		End If
	
		'선물옵션 신청여부 
		If g_OPTNYN == "Y" Then
			g_OPTNYN = "N"
			DrawD()
		End If
		
		'해외파생 신청여부
		If g_OVDVYN == "Y" Then
			g_OVDVYN = "N"
			DrawE()
		End If
			
		'ISA 신청여부
		'v0004 중개형 ISA 추가
		If g_ISAYN == "Y" Then
			g_ISAYN = "N"
			if g_ISA_PROD_TYPE == "2" Then
				DrawF()	'일임형 ISA
			else
				DrawI()	'중개형 ISA
			end if
			
		End If	
		
		'국내 CFD 신청여부
		'g_nPrevFlag = 1 '2021-08-05 ksj 다음화면에서 넘어온경우 플래그 1로 설정
		if g_CFDYN == "Y" Then
			g_CFDYN = "N"
			DrawG()
		End if
		
		'v0004 해외 CFD 
		'국내 CFD 신청여부
		if g_ACFDYN == "Y" Then
			g_ACFDYN = "N"
			DrawH()
		End if
		
		'연금저축 신청여부
		if g_PNSNYN == "Y" Then
			g_PNSNYN = "N"
			DrawK()
		End If
		
		'Wrap 신청여부
		If g_WRAPYN == "Y" Then
			g_WRAPYN = "N"
			DrawJ()
		End If
	else
	
		g_STOCKYN	="N"	 '종합매매(주식+금융상품)
		g_CMAYN		="N"	 'CMA
		g_FSTOCKYN	="N"	 '종합매매(금융상품전용)
		g_OPTNYN		="N"	 '선물옵션
		g_OVDVYN		="N"	 '해외파생
		g_ISAYN		="N"	 '일임형ISA
		g_CFDYN		="N"	 '국내 CFD 	
		'v0004 해외 CFD / 중개형 ISA 추가
		g_ACFDYN		="N"	 '해외 CFD 	
		g_ISA_PROD_TYPE	=""	 'ISA type
		'연금저축, 랩 추가
		g_PNSNYN		= "N"
		g_WRAPYN		= "N"
		g_SAYN		= "N"
	
		DATAMANAGER.RequestTranData("obcsb_acif_809r") '비대면계좌개설  기존고객정보조회
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_809r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_809r" , "InBlock1" , "RCNO_PIP" , 0 , g_BDM_RCNO_PIP ) 'JMY g_RSNO)  
		
	elseif  szTranID == "obaci_acct_072r" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_072r", "InBlock1", "RCNO_PIP"	 	 , 0	  , g_BDM_RCNO_PIP	)
		DATAMANAGER.SetDataValue(0, "obaci_acct_072r", "InBlock1", "WHOL_CPNO" 		 , 0   , g_BDM_HP1..g_BDM_HP2..g_BDM_HP3	)
		DATAMANAGER.SetDataValue(0, "obaci_acct_072r", "InBlock1", "REG_UNIQ_NO"		 , 0   , g_BDM_REG_UNIQ_NO 	)
		DATAMANAGER.SetDataValue(0, "obaci_acct_072r", "InBlock1", "REG_STAG_CLS_CODE" , 0   , "2"		 	 	)	'2단계
		DATAMANAGER.SetDataValue(0, "obaci_acct_072r", "InBlock1", "IQRY_CLS_CODE"     , 0   , "2"			 	)	'단계별조회
	
	
	elseif  szTranID == "obaci_acct_185r" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r" , "InBlock1" , "RCNO_PIP" , 0 , g_BDM_RCNO_PIP )
	
	elseif  szTranID == "obcsb_acif_801r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_801r" , "InBlock1" , "RCNO_PIP" , 0 , g_BDM_RCNO_PIP)
	elseif  szTranID == "obcsb_nice_030r" then
	
		DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CRIN_IQRY_CLCD" 	, 0, "TR01"	)
		DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "BSWR_CLS_CODE" 	, 0, "1"		)
		DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_TYPE_CODE" 	, 0, "01"	)
		DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, g_BDM_RCNO_PIP)
		DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "CSNM"			, 0, g_sUserName)
	
	elseif szTranID == "obaci_nmet_016r" Then	'비대면용 보유계좌 체크
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP" 		, 0, g_BDM_RCNO_PIP)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_CLS_CODE" 		, 0, "3")			'SA계좌
	
	'단기다수대상자 여부 체크
	ElseIf szTranID == "obaci_acct_091r" Then
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE", 0, "3"            )  '3.단기다수계좌/대포통장 명의인 조회
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"     , 0, "1"            )  '1.개인
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0, g_BDM_RCNO_PIP )  '암호화주민번호

	'단기다수계좌/대포통장 명의인 확인
    ElseIf szTranID == "obaci_acct_091r_1" Then
	    Dim szLnkdTlmsMnno
	    szLnkdTlmsMnno = DATAMANAGER.GetDataValue( 0, "obaci_acct_091r", "OutBlock1", "LNKD_TLMS_MNNO", 0)
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE", 0, "4"                    )  '4.단기다수계좌/대포통장 명의인 확인
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"     , 0, "1"                    )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"    , 0,  szLnkdTlmsMnno )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0, g_BDM_RCNO_PIP         )  '암호화주민번호
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_809r" then
		g_bold = DATAMANAGER.GetDataValue(0, "obcsb_acif_809r", "OutBlock1", "EXSN_CUST_YN", 0)	'기존고객여부
		'Form.ShowAlert(g_bold, g_bold)
		If g_bold == "N" Then '★신규고객 (기존고객 - 정상 종합계좌 미보유 고객과 동일)
			g_bNewYN = "Y"  '신규 종합계좌
			DATAMANAGER.RequestTranData("obaci_acct_072r")
		
		ElseIf g_bold == "Y" Then '★기존고객
			DATAMANAGER.RequestTranData("obaci_acct_185r")
		End If	
			
	elseif szTranID == "obaci_acct_072r" then '비대면계좌개설 이어가기 조회
		
		tmpRegNO = DATAMANAGER.GetDataValue(0, "obaci_acct_072r" , "OutBlock3" , "REG_UNIQ_NO" , 0)
		If tmpRegNO == "" or tmpRegNO == null Then '2단계 내역
			'처리X
		else
			
			g_OvtrJoinapltYn              = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock5" ,"OVTR_JOIN_APLT_YN", 0)
			g_OvtrFnprjoinapltYn          = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock5" ,"OVTR_FNPR_JOIN_APLT_YN", 0)
			g_CmaRpjoinapltYn             = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock5" ,"CMA_RP_JOIN_APLT_YN", 0)
			g_IsaAcntapltYn               = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock5" ,"ISA_ACNT_APLT_YN", 0)
			g_FutsOptnAcntApltYn		  = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock5" ,"FUTS_OPTN_ACNT_APLT_YN", 0) 'v0001
			g_OvdvAcntApltYn			  = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock5" ,"OVDV_ACNT_APLT_YN", 0) 

			g_BDM_ABLE_YN            = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1" ,"APLT_ABLE_YN"     , 0)	'신청가능여부(개별추가능여부)
			g_BDM_OVRL_ACNT_OPNG_YN  = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1" ,"OVRL_ACNT_OPNG_YN", 0)	'종합계좌개설여부(최근30일내종합개설여부)
			g_BDM_PFIN_YN			  = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1" ,"UI_PFIN_YN", 0)	'전문투자자 등록 여부
			g_BDM_PRSN_PFIN_YN	  = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1" ,"PRSN_PFIN_YN", 0)	'개인 전문투자자 여부	'ksj 2021-07-23
			g_BDM_PFIN_CLS_CODE	  = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1" ,"PFIN_CLS_CODE", 0)	'전문투자자 구분 코드 'ksj 2021-07-23
			
			'  상품선택
			'****************************************************************************************
			'****************************************************************************************
			'종합매매 신청여부"obaci_acct_072r", "OutBlock5", ""
			If g_OvtrJoinapltYn == "Y" Then
				DrawA()
			End If
		
			'CMAPlus/CMARp 신청여부
			'If g_CmaplusjoinapltYn == "Y" or g_CmarpjoinapltYn == "Y" Then
			If g_CmarpjoinapltYn == "Y" Then
				DrawB()
			End If
		
			'종합매매-금융상품 신청여부
			If g_OvtrfnprjoinapltYn == "Y" Then
				DrawC()
			End If
		
			'선물옵션 신청여부 
			If g_FutsOptnAcntApltYn == "Y" Then
				DrawD()
			End If
			
			'해외파생 신청여부
			If g_OvdvAcntApltYn == "Y" Then
				DrawE()
			End If
				
			'ISA 신청여부
			If g_IsaacntapltYn == "Y" Then
				DrawF()
			End If
			
		end if		

	
	elseif szTranID == "obaci_acct_185r" then
		If DATAMANAGER.IsMoreNextData( "obaci_acct_185r" ) == True then
			DATAMANAGER.RequestNextData( "obaci_acct_185r" )
			
		ElseIf DATAMANAGER.IsMoreNextData("obaci_acct_185r" ) == False then
			g_OldAcnoCnt = DATAMANAGER.GetDataCount(0, "obaci_acct_185r" , "OutBlock1")
	
			if g_OldAcnoCnt > 0 then
				g_CSNO = DATAMANAGER.GetDataValue(0, "obcsb_acif_809r", "OutBlock1", "CSNO", 0)
			
			else
				g_bNewYN = "Y"  '신규 종합계좌
			end if
	
			DATAMANAGER.RequestTranData("obaci_acct_072r")
		end if
		
		
	elseif szTranID == "obcsb_acif_801r" then
		
		If g_OPTNYN == "Y" or g_OVDVYN == "Y" or g_CFDYN == "Y" or g_ACFDYN == "Y" Then '선물옵션,해외파생 선택시  'CFD(국내)추가	'v0004CFD(해외)추가
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "1")
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "RCNO_PIP" 		, 0, g_BDM_RCNO_PIP)
			DATAMANAGER.RequestTranData("obcsb_nice_030r")
		
		else
			'약관동의화면 호출 후 현재화면 닫기
			
			g_Opng_File = "mbbdm85131"	'오픈할화면
			g_Send_Data = ""			'인자정보
			'Form.CloseForm()
		    'JMY Sta ---------------------------------------
'			if g_sz_OSType == "1"  or g_sz_OSType == 1 then
'				NextStep()
'				Form.SetTimerEvent2("9999", 1, 0.1)	'화면닫기
'			elseif g_sz_OSType == "2"  or g_sz_OSType == 2 then 
'				Form.CloseForm()
'			end if
			
			NextStep()
			'Fin Sta ---------------------------------------
		end if
	
	elseif szTranID == "obcsb_nice_030r" then
		g_SdrcSrno_1	= DATAMANAGER.GetDataValue(0,  "obcsb_nice_030r" , "OutBlock2" , "SDRC_SRNO" , 0 )
		s_RsltCls_1	= DATAMANAGER.GetDataValue(0,  "obcsb_nice_030r" , "OutBlock1" , "RSLT_CLS"  , 0 )
		s_BdcrClcd_1 = DATAMANAGER.GetDataValue(0,  "obcsb_nice_030r" , "OutBlock3" , "BDCR_CLCD"  , 0 )

		If s_RsltCls_1 == "3" Or s_RsltCls_1 == "0" Then
			If s_BdcrClcd_1 == "N" Then
				'약관동의화면 호출 후 현재화면 닫기
				g_Opng_File = "mbbdm85131"	'오픈할화면
				g_Send_Data = ""			'인자정보
				'Form.CloseForm()
			    'JMY Sta ---------------------------------------
'				if g_sz_OSType == "1"  or g_sz_OSType == 1 then
'					NextStep()
'					Form.SetTimerEvent2("9999", 1, 0.1)	'화면닫기
'				elseif g_sz_OSType == "2"  or g_sz_OSType == 2 then 
'					Form.CloseForm()
'				end if
				
				NextStep()
				'Fin Sta ---------------------------------------
			Else
				ShowAlert "알림", "선물옵션/해외파생/CFD 계좌 개설이 불가능합니다.(신용불량)"
				Exit Sub
			End If
		Else
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock1", "SDRC_CLS_CODE" 	, 0, "2")
			DATAMANAGER.SetDataValue(0, "obcsb_nice_030r", "InBlock2", "SDRC_SRNO"		, 0, g_SdrcSrno_1) '주식거래 가능한 종합매매계좌
			DATAMANAGER.RequestTranData("obcsb_nice_030r")
		End If
	
	elseif szTranID == "obaci_nmet_016r" Then	'비대면용 보유계좌 체크
		Dim nCnt
		nCnt = DATAMANAGER.GetDataValue(0,  szTranID , "OutBlock2" , "IQRY_CSNU" , 0 )
		'v0012 SA 계좌가 존재해도 N개 개설 가능 
		'SA계좌가 있을 경우 안내문구 팝업(개설불가)
		'If CInt(nCnt) > 0 Then
		'	Form.OpenPopup("mbbdm85130_p12" , "" , "")
		
		'없으면 이후 절차 진행
		'Else
		''단기다수대상자 여부 체크
		'	DATAMANAGER.RequestTranData( "obaci_acct_091r" )	
		'End If
		'단기다수대상자 여부 체크
		DATAMANAGER.RequestTranData( "obaci_acct_091r" )
		
	'단기다수계좌/대포통장 명의인 조회
    ElseIf szTranID == "obaci_acct_091r" Then
'        edt091TlmsNo1.caption = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "LNKD_TLMS_MNNO", 0)
        strCode               = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
        'Form.ShowAlert(szTranID, strCode)
        If strCode == "1" Or strCode ==  1 Then  '전문전송완료
            '단기다수계좌/대포통장 명의인 확인 타이머실행
            g_nCnt_091_1 = 0
            Form.SetTimerEvent(3, 1, 1)
        Else
            Form.ShowAlert("오류", "계좌개설 진행이 불가합니다.(단기다수개설자 조회 오류)")    
            Exit Sub
        End If

	'단기다수계좌/대포통장 명의인 확인
    ElseIf szTranID == "obaci_acct_091r_1" Then
        strCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)
        'Form.ShowAlert(szTranID, strCode)
        If strCode == "2" Or strCode == 2 Then  '조회완료
            '단기다수계좌개설여부
            BNK_MNY_OPNG_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_MNY_ACNT_OPNG_CHD_YN", 0)
		   If BNK_MNY_OPNG_YN == "Y" Then
'			   Form.ShowAlert("안내", "최근 20영업일 이내 계좌개설 이력이 있어\n계좌개설이 불가능합니다.")
			   Form.MsgBox("안내", "최근 20영업일 이내 계좌개설 이력이 있어\n계좌개설이 불가능합니다.", "", 0)
		   Else
			   '슈퍼365 + 국내/해외CFD 개설
				If g_CFDYN == "Y" Or g_ACFDYN == "Y" Then
					f_Check_CFDTarMarket()
				Else
					Form.SetSharedData("BDM_REG_SRNO", "")
					Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")
					Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
					Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")
					g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
					g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
					g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)			'해외CFD목표시장일련번호
					g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부			
					DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
				End If
            End If
        Else
            '단기다수계좌/대포통장 명의인 확인 타이머실행
            Form.SetTimerEvent(3, 1, 1)
        End If
	end if
End Sub

Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szTranID == "obcsb_nice_030r" Then
		'2021.11.30 KSJ : obcsb_nice_030r 오류메시지 설정
		Form.ShowAlert("오류", szErrMsg.."\n영업점 또는 고객지원센터로 문의해주세요.")    
	Else
		'v0003
		If Trim(sSubmsg) ~= null And Trim(sSubmsg) ~= "" Then
			strMsg2 = szErrMsg.."("..Trim(sSubmsg)..")"
			strMsg = szErrMsg.."\n"..Trim(sSubmsg)
		Else
			strMsg2 = szErrMsg
			strMsg = szErrMsg
		End If
		
		Form.ShowAlert("오류", strMsg2)
	End If
End Sub

