'============================================================================
' 화면종료
'============================================================================
Sub Form_OnFormClose()

	if g_Opng_File ~= "" or g_Opng_File ~= null then
		if g_Opng_File == g_BDM_FRST_MAPID then
			'진입점으로 돌아가능 경우, 공유변수 초기화
			User_SharedData_Set("Init")
		else
			User_SharedData_Set()
		end if
		
		'Form.OpenPopup(g_Opng_File, g_Send_Data , "")
	end if	
End Sub
'============================================================================
Function PrevStep()	 'JMY
	if g_Opng_File ~= "" or g_Opng_File ~= null then
		'공유변수 설정
		User_SharedData_Set("Init")
		
		Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
	end if
End Function

'============================================================================
Function NextStep()	 'JMY
	if g_Opng_File ~= "" or g_Opng_File ~= null then
		'공유변수 설정
		User_SharedData_Set()
		
		Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
	end if
End Function

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CFD_MSG_RESULT" then
		if sRet == "ok" then
			Form.CloseForm()
			User_SharedData_Set("Init")
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			Form.OpenScreen("94000", "")
		end if
	
	elseif sKeyName == "MOVE_85100" Then
		Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
		g_Opng_File	= g_BDM_FRST_MAPID	'오픈할화면
		g_Send_Data	= ""					'인자정보
		
		PrevStep()
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID == 3 Or sTimerID == "3" Then
        '정보송신 타이머종료
        Form.SetTimerEvent(3, 0, 1)

        '송신유효횟수 설정
        g_nCnt_091_1 = CInt(g_nCnt_091_1) + 1

        '송신유효횟수 초과 체크
        If CInt(g_nCnt_091_1) > 7 Then
            Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")
            Exit Sub
        End If

        '단기다수대상 여부 체크
        DATAMANAGER.RequestTranData( "obaci_acct_091r_1" )
    End If
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ContMain.Image1.setMaintainingRatio("1")
	ContMain.Image3.setMaintainingRatio("1")
	ContMain.imgTooltip.setMaintainingRatio("1")
End Sub

'============================================================================
Sub ContMain_imgTooltip_OnClick()
	Dim szText
	szText = "슈퍼365계좌와 동시 개설시 관리점 지정이\n불가하며, 디지털금융센터에서 관리됩니다."
	If g_sz_OSType == "1" Then
		ContMain.imgTooltip.openTooltip(szText, 300, 50, 2)
	Else
		ContMain.imgTooltip.openTooltip(szText, 300, 80, 2)
	End If
End Sub

