'============================================================================
'상품선택팝업 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName =="상품선택취소" then
		if prodFlag =="A" then
			'기체크 여부와 상관없이g_STOCKYN N로 만들기위해 선택여부 Y 초기화 후 DRAW 함수 호출(이하동일)
			g_STOCKYN = "Y" 
			DrawA()
		elseif prodFlag =="B" then
			g_CMAYN = "Y"
			DrawB()
		elseif prodFlag =="C" then
			g_FSTOCKYN = "Y"
			DrawC()
		elseif prodFlag =="D" then
			g_OPTNYN = "Y"
			DrawD()
		elseif prodFlag =="E" then
			g_OVDVYN = "Y"
			DrawE()
		elseif prodFlag =="F" then
			g_ISAYN = "Y"
			DrawF()	
		elseif prodFlag =="G" then
			g_CFDYN = "Y"
			DrawG()
		'v0004 해외 CFD / 중개형 ISA 추가
		elseif prodFlag =="H" then
			g_ACFDYN = "Y"
			DrawH()
		elseif prodFlag =="I" then
			g_ISAYN = "Y"
			DrawI()	
		end if
		
	elseif sKeyName =="상품선택완료" then
		if prodFlag =="A" then
			'기체크 여부와 상관없이g_STOCKYN Y로 만들기위해 선택여부 N 초기화 후 DRAW 함수 호출(이하동일)
			g_STOCKYN = "N" 
			DrawA()
		elseif prodFlag =="B" then
			g_CMAYN = "N"
			DrawB()
		elseif prodFlag =="C" then
			g_FSTOCKYN = "N"
			DrawC()
		elseif prodFlag =="D" then
			g_OPTNYN = "N"
			DrawD()
		elseif prodFlag =="E" then
			g_OVDVYN = "N"
			DrawE()
		elseif prodFlag =="F" then
			g_ISAYN = "N"
			DrawF()	
		elseif prodFlag =="G" then
			g_CFDYN = "N"
			DrawG()	
		'v0004 해외 CFD / 중개형 ISA 추가
		elseif prodFlag =="H" then
			g_ACFDYN = "N"
			DrawH()
		elseif prodFlag =="I" then
			g_ISAYN = "N"
			DrawI()	
		end if
	      
	
	elseif sKeyName == "mbbdm85100_p9_end" then
		if sRet == "ok" then
			
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			g_Opng_File	= g_BDM_FRST_MAPID	'오픈할화면
			g_Send_Data	= ""					'인자정보
			'Form.CloseForm()
			'JMY Sta -------------------------------------------
'			if g_sz_OSType == "1"  or g_sz_OSType == 1 then
'				PrevStep()
'				Form.SetTimerEvent2("9999", 1, 0.1)	'화면닫기
'			elseif g_sz_OSType == "2"  or g_sz_OSType == 2 then 
'				Form.CloseForm()
'			end if

			PrevStep()
			'JMY Fin -------------------------------------------
		end if	
	'2021-07-14 KSJ : CFD 상품 개설 선택시 목표시장 팝업 호출
	'확인버튼 외 클릭시 다시 g_CFDYN N로 만들기위해 선택여부 Y 초기화 후 DRAW 함수 호출(이하동일)
	elseif sKeyName == "MBBDM85130_P8" then
		'v0004 sta
		if sRet == "ok" then
			g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)			'국내CFD목표시장등록일련번호	
			g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)			'국내CFD목표시장부적합여부
			g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)			'해외CFD목표시장등록일련번호
			g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)			'해외CFD목표시장부적합여부
			
			DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
		else
			Form.SetSharedData("BDM_REG_SRNO", "")
			Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")
			Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
			Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")
				     
			g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
			g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
			g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)			'해외CFD목표시장일련번호
			g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부			
			
			g_CFDYN = "Y"
			DrawG()
			g_ACFDYN = "Y"
			DrawH()
		end if
		'v0004 fin
	
	'랩 개설안내 리턴
	ElseIf sKeyName == "mbbdm85131_p5" Then
		'예 버튼 눌렀을시는 화면 잔류이므로 따로 처리 x
		'다음에 개설하기만 리턴 처리
		If sRet == "QUIT" Then
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			
			g_Opng_File	= g_BDM_FRST_MAPID	'오픈할화면
			g_Send_Data	= ""					'인자정보

			PrevStep()
		End If
	
	'슈퍼365 보유 안내 리턴
	ElseIf sKeyName == "mbbdm85130_p12" Then
		'다음에 개설하기 > 계좌개설 초기화면으로 이동 
		'예 > 화면에 잔류 및 슈퍼365 선택 해제
		If sRet == "QUIT" Then
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			
			g_Opng_File	= g_BDM_FRST_MAPID	'오픈할화면
			g_Send_Data	= ""					'인자정보

			PrevStep()
		ElseIf sRet == "OK" Then
			Draw0()
		End If
	end if
End Sub

'============================================================================
' 신청버튼 활성화 체크
'============================================================================
Sub Check_bnkOK()
	If g_CMAYN == "Y" or g_STOCKYN == "Y" or g_FSTOCKYN == "Y" or g_ISAYN == "Y" or g_OPTNYN == "Y" or g_OVDVYN == "Y" or g_CFDYN == "Y" or g_ACFDYN == "Y" or g_WRAPYN == "Y" or g_PNSNYN == "Y" or g_SAYN == "Y" then 
		btnOK.enable		= true
		btnOK.btnimage	= "btn_20.9"
		btnOK.fgcolor		= "273"
	else
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	end if
End Sub
'============================================================================
' 최종업무신청
'============================================================================
Sub btnOK_OnClick()
	'v0004 sta 목표시장 비교 로직 상품 선택 > 다음버튼 선택시 진행으로 변경	
	If g_CFDYN == "Y" Or g_ACFDYN == "Y" Then
		
		'v0012
		'SA계좌 개설시 보유여부 체크
		If g_SAYN == "Y" Then
			'비대면용 보유계좌 체크
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			Exit Sub
		End If
		
		f_Check_CFDTarMarket()
	Else
		'랩 개설시 체크
		If g_WRAPYN == "Y" Then
		'신규고객 + 종합계좌나 CMA 계좌 미개설시
			If g_bold == "N" And g_STOCKYN == "N" And g_CMAYN == "N" Then
				'랩 계좌 개설안내 팝업 오픈
				Form.OpenPopup("mbbdm85131_p5", "NEW", "")
				Exit Sub
			End If
		End If
		
		'v0012
		'SA계좌 개설시 보유여부 체크
		If g_SAYN == "Y" Then
			'비대면용 보유계좌 체크
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			Exit Sub
		End If
		
		Form.SetSharedData("BDM_REG_SRNO", "")
		Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")
		Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
		Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")
		g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
		g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
		g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)			'해외CFD목표시장일련번호
		g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부			
		DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
	End if
	'v0004 fin
End Sub
'============================================================================
'v0004 f_Check_TarMarket() : CFD목표시장 팝업 체크 
'============================================================================
Function f_Check_CFDTarMarket()
	Dim szCusType
	szCusType = f_SetCusType()	
	'v0003 당연전문투자자는 목표시장비교 Skip
	If g_BDM_PFIN_YN == "Y" then	'전문투자자 등록 여부
		If g_BDM_PFIN_CLS_CODE == "1" Then
			Form.SetSharedData("BDM_REG_SRNO", "")
			Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")
			Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
			Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")				     
			g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
			g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
			g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
			g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부			
			DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
		Else
			g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
			g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
			g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
			g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부

			'CFD 상품 개설 선택시 목표시장 팝업 호출
			If g_CFDYN == "Y" And g_ACFDYN == "Y" Then
				If g_BDM_REG_SRNO == "" Or g_BDM_ACFD_REG_SRNO == "" Then
					Form.OpenPopupAnimation("mbbdm85130_p8", "136".."★"..szCusType.."★".."2", "","2")	'상품코드+ 고객유형 + 처리횟수
				Else
					DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
				End If
			Else
				If g_CFDYN == "Y" Then
					'Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
					'Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")	
					'g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
					'g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부	
					Form.SetSharedData("BDM_REG_SRNO", "")
					Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")	
					g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
					g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부					
					If g_BDM_REG_SRNO == "" Then
						Form.OpenPopupAnimation("mbbdm85130_p8", "136".."★"..szCusType.."★".."1", "","2")
					Else
						DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
					End If
				ElseIf g_ACFDYN == "Y" Then				
					'Form.SetSharedData("BDM_REG_SRNO", "")
					'Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")	
					'g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
					'g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
					Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
					Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")	
					g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
					g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부						
					If g_BDM_ACFD_REG_SRNO == "" Then
						Form.OpenPopupAnimation("mbbdm85130_p8", "137".."★"..szCusType.."★".."1", "","2")
					Else
						DATAMANAGER.RequestTranData("obcsb_acif_801r") 'v0001
					End If				
				End If
			End if
		End If 
	Else
		'계좌 보유 고객인경우 아닌경우 모두 전문투자자 안내페이지로 이동
		Form.MsgBox("안내", "CFD 계좌는 당사에 전문투자자로 등록이 되어있어야 개설이 가능합니다.\n\n전문투자자 지정 심사 안내페이지로 이동하시겠습니까?\n(계좌개설 신청은 중단됩니다.)", "CFD_MSG_RESULT", 2)
	End If
End Function
'============================================================================
'v0004 f_SetCusType : 투자자타입 리턴
'============================================================================
Function f_SetCusType()	
	Dim szCusType
	If g_BDM_PRSN_PFIN_YN == "Y" Then
		szCusType =  "1"   '개인전문투자자
	Else
		'v0003 당연/전환가능/일반 체크 변경
		If g_BDM_PFIN_YN = "Y" Then
		    If g_BDM_PFIN_CLS_CODE == "1" Then
		         szCusType =  "3"   '당연
		    Else
		         szCusType =  "2"   '전환가능
		    End If
		Else
		    szCusType =  "0"   '일반
		End If
	End If
	return szCusType
End Function

