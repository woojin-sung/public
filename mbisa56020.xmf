' 01. 화 면 명 : ISA 입출금/고 내역
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
' 2016-06-13 ESKIM : 계약번호 없을시 메세지 팝업 요청(노희범 차장님)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'조회
Sub RequestData(nIndex)
	'폼탭 변경시에는 계약상태를 조회하지 않음
	If nIndex = 0 then
		tbl0.SetCellString( 0 , 1 , "")		'계약상태 Clear
		DATAMANAGER.RequestTranData( "obwat_mgmt_271r" )	'계약상태 조회
	End If
	
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "RECEIVE", "")
End Sub

'============================================================================
'계약상태 Display
Sub SetCnrcStat(szTranID)
	Dim sCode, sCnrcStat
	sCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_STAT_CLCD" , 0 )

	Select Case sCode
		Case "01"
			sCnrcStat = "운용불가"
		Case "02"
			sCnrcStat = "정상"
		Case "03"
			sCnrcStat = "청산진행"
		Case "04"
			sCnrcStat = "청산완료"
		Case "05"
			sCnrcStat = "계약해지"
		Case "06"
			sCnrcStat = "계약취소"
		Case "07"
			sCnrcStat = "승인대기"
		Case "08"
			sCnrcStat = "거부"
	End Select
	
	tbl0.SetCellString( 0 , 1 , sCnrcStat)
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call acnt0_ChangeAccount()
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call RequestData(0)	'조회
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	'계좌번호 변경시 계약번호 TR 태운 후 조회하기 때문에 Clear 시간차 발생, 이에 계약상태 Clear 먼저함
	tbl0.SetCellString( 0 , 1 , "")
	cmbSeq.clear = 1								'계약번호 초기화
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
End Sub

'============================================================================
Sub cmbSeq_OnEditComplete(iIndex)
	Call RequestData(0)	'조회
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Call RequestData(0)	'조회
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)	
	Call RequestData(1)	'조회
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , cmbSeq.caption )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계약번호
	If szTranID == "obwat_ctad_011r" then
		Dim i, nCnt	

		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )

		'2016-06-13 ESKIM : 계약번호 없을시 메세지 팝업 요청(노희범 차장님)
		If nCnt == 0 then
			Form.ShowAlert("알림", "ISA 계약이 존재하지 않습니다.")
		End If
		
		For i = 0 To nCnt - 1
			cmbSeq.cbadddatatext = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_NO" , i )		'계약번호
		Next

		cmbSeq.SetCurSel( 0 )	
		Call RequestData(0)	'조회
	End If
	
	'계약상태
	If szTranID == "obwat_mgmt_271r" then
		Call SetCnrcStat(szTranID)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

