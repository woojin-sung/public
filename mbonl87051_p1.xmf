'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_PreEngName
	g_PreEngName = ""
Dim	g_NewEngName
	g_NewEngName = ""
Dim	g_ProsCls
Dim	g_Acno
Dim	g_AcntPwd
