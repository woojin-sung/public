	g_OvrsTxpmChdYn = ""
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_Acno = Form.GetSharedData("87051_ACNO", false)
	g_AcntPwd = Form.GetSharedData("87051_ACNT_PWD", false)
	
	'v0001
'	g_sRevData = Split ( Form.GetOpenLinkData() , "★" , 0 , 0 )
'	
'	g_ProsCls 			= g_sRevData[0]
'	g_PreEngName 			= g_sRevData[1]
'	g_NtntCtcd 			= g_sRevData[2]
'	g_RsdcNtnlTxrtCode 	= g_sRevData[3]
'	g_LscClcd 			= g_sRevData[4]
'	g_Brdt 				= g_sRevData[5]
'	g_WdngDate 			= g_sRevData[6]
'	g_BrthCtcd 			= g_sRevData[7]
'	g_AmrcYn 			= g_sRevData[8]
'	g_AmlBstpLrdvCode 	= g_sRevData[9]
'	g_AmlBstpSmdvCode 	= g_sRevData[10]
'	g_Giin				= g_sRevData[11]
'	g_Lstn_yn 			= g_sRevData[12]
'	g_OvrsTxpmChdYn 		= g_sRevData[13]

'	If Trim(g_PreEngName) <> "" Then
'		Edit1.caption = g_PreEngName
'	Else
'		Edit1.caption = "미등록"
'	End If

	DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_Acno)	
	DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNT_PWD" , 0 , g_AcntPwd)
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
	
End Sub
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	'Form.SendReturnToParent("NewEngName", Trim(g_PreEngName) & "★" & "Cancle")  
	Form.SendReturnToParent("NewEngName", "Cancle")  
	Form.CloseForm()
End Sub
'============================================================================
' btnCancel_OnClick - 취소버튼
'============================================================================
Sub btnCancel_OnClick()
	'Form.SendReturnToParent("NewEngName", Trim(g_PreEngName) & "★" & "Cancle")  
	Form.SendReturnToParent("NewEngName", "Cancle")  
	Form.CloseForm()
End Sub
'============================================================================
Sub btnModify_OnClick()
	If Trim(g_NewEngName) <> "" Then
		If g_ProsCls = "U" Then
			If Trim(g_PreEngName) == Trim(g_NewEngName) Then
				Form.ShowAlert( "알림" , "변경 전/후가 같은 영문명입니다.")
				Exit Sub
			End If
		End If
		
'		Form.SendReturnToParent("NewEngName", Trim(g_NewEngName) & "★" & "Ok")  
'		Form.CloseForm()

		DATAMANAGER.ClearInputData(0, "obcsb_acif_002u")
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "ACNO" 					, 0 , g_Acno)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "ACNT_PWD" 				, 0 , g_AcntPwd)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "CUST_ENG_NAME" 			, 0 , Trim(g_NewEngName))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "NTNT_CTCD" 			, 0 , Trim(g_NtntCtcd))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "RSDC_NTNL_TXRT_CODE"	, 0 , Trim(g_RsdcNtnlTxrtCode))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "LSC_CLCD"				, 0 , Trim(g_LscClcd))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "BRDT"					, 0 , Trim(g_Brdt))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "WDNG_DATE"				, 0 , Trim(g_WdngDate))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "BRTH_CTCD"				, 0 , Trim(g_BrthCtcd))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "AMRC_YN"				, 0 , Trim(g_AmrcYn))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "AML_BSTP_LRDV_CODE"		, 0 , Trim(g_AmlBstpLrdvCode))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "AML_BSTP_SMDV_CODE"		, 0 , Trim(g_AmlBstpSmdvCode))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "GIIN"					, 0 , Trim(g_Giin))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "LSTN_YN"				, 0 , Trim(g_Lstn_yn))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002u" , "InBlock1" , "OVRS_TXPM_CHD_YN"		, 0 , Trim(g_OvrsTxpmChdYn))
		DATAMANAGER.RequestTranData("obcsb_acif_002u")		
	Else
		Form.ShowAlert( "알림" , "변경할 영문명을 확인해주세요.")
		Exit Sub
	End If
End Sub
'============================================================================
Sub Edit0_OnEditComplete()
	g_NewEngName = Edit0.caption
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_acif_002u" Then
		'Form.SendReturnToParent("NewEngName", Trim(g_NewEngName) & "★" & "Ok")  
		Form.SendReturnToParent("NewEngName", "Ok")  
		Form.CloseForm()
		
	'v0001 obcsb_acif_000r 추가
	ElseIf szTranID == "obcsb_acif_000r" Then 
		g_PreEngName	 		= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_ENG_NAME" , 0)
		g_NtntCtcd 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "NTNT_CTCD" , 0)
		g_RsdcNtnlTxrtCode	= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RSDC_NTNL_TXRT_CODE" , 0)
		g_LscClcd 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "SLCN_CLS_CODE" , 0)
		g_Brdt 				= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "BRDT" , 0)
		g_WdngDate 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "WDNG_DATE" , 0)
		g_BrthCtcd 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "BRTH_CTCD" , 0)
		g_AmrcYn 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "AMRC_YN" , 0)
		g_AmlBstpLrdvCode 	= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "AML_BSTP_LRDV_CODE" , 0)
		g_AmlBstpSmdvCode 	= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "AML_BSTP_SMDV_CODE" , 0)
		g_Giin 				= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "GIIN" , 0)
		g_Lstn_yn 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "LSTN_YN" , 0)
		g_OvrsTxpmChdYn 		= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "OVRS_TXPM_CHD_YN" , 0)
		
		If Trim(g_PreEngName) <> "" Then
			Edit1.caption = g_PreEngName
		Else
			Edit1.caption = "미등록"
		End If
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "obcsb_acif_002u" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Exit Sub
	End If
End Sub 

