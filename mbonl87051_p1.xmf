	g_AmlBstpLrdvCode = ""
Dim	g_AmlBstpSmdvCode		'AML업종소분류코드
	g_AmlBstpSmdvCode = ""
Dim	g_Giin				'GIIN
	g_Giin = ""	
Dim	g_Lstn_yn			'상장여부
	g_Lstn_yn = ""
