'============================================================================
' 01.화면명 		: 펀드매매
' 02.화면설명		: 펀드매매_신청현황/취소탭
' 03.작성		: 2016.02.19
' 04.수정		: 2020.09.15 비밀번호 메모리 평문 노출 취약점 조치 v001
'			: 21.07.07 JHY    : 고난도 업무제어 펀드건 (고난도금융투자상품에 대한 내용 추가) v002
'			: 22.06.21 임동군 : 정액매도시 신청금액이 조회되지 않는 오류 개선 v003
'                                               : 집합투자증권 매도방식구분코드 추가 v003
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
'dim	g_szPasswd	'계좌비밀번호
dim	g_szAlertTitle	'알림타이틀

g_szFullAcnt	=""
'g_szPasswd	=""
g_szAlertTitle	=	"알림"


Dim g_plain_rm  		'v0002 메모리평문적용여부

dim	g_szRmndSrno	'잔고번호
dim	g_szReqDate	'신청일자
dim	g_szOrdno	'주문번호

	
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grdT401.setUseCardView(true, 15, "input_03_n.9")
	
	g_szFullAcnt	= cmbAccount.total & cmbAccount.sequence
	
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	
	if cmbAccount.caption <> "" and cmbAccount.caption <> null then 
		DATAMANAGER.RequestTranData("obsai_deal_070r")
	end if
End Sub


'============================================================================
'grdT401_OnClickUp
'============================================================================
Sub grdT401_OnClickUp(lRow, szCellID)
	dim	szProsYN
	dim	szFundName	'펀드명
	dim	szAplDate	'기준가적용일
	dim	szDealDate	'결제일
	dim	szBuySell	'매매구분
	dim	szReqQty		'신청좌수
	dim	szReqAmt		'신청금액
	dim	szCarefulYN	'고난도 금융투자상품 숙려대상 ' 21.07.07 JHY v002
	dim	szIiscSelnFormClsCode	'집합투자증권 매도방식구분코드 v003
	
	'21.07.07 JHY START
	'v002
	szFundName	=	grdT401.GetCellData("bd_cell2", lRow)		'펀드명
	g_szOrdno	=	grdT401.GetCellData("bd_cell7", lRow)		'주문번호
	g_szReqDate	=	grdT401.GetCellData("bd_cell0", lRow)		'신청일자
	szAplDate	=	grdT401.GetCellData("bd_cell5", lRow)		'기준가적용일
	szDealDate	=	grdT401.GetCellData("bd_cell12", lRow)		'결제일
	szBuySell	=	grdT401.GetCellData("bd_cell9", lRow)		'매매구분
	szReqQtyAmt	=	grdT401.GetCellData("bd_cell10", lRow)		'신청좌수/금액
	'szReqAmt	=	grdT401.GetCellData("bd_cell11", lRow)		'신청금액
	g_szRmndSrno	=	grdT401.GetCellData("bd_cell8", lRow)		'잔고번호
	szCarefulYN	=	grdT401.GetCellData("bd_CarefulYN", lRow)	'고난도 금융투자상품 숙려대상 ' 21.07.07 JHY
	'21.07.07 JHY END
	szIiscSelnFormClsCode = grdT401.GetCellData("bd_SelnForm", lRow)	'v003

	if	szCellID	=	"bd_Cancel"	then
		szProsYN	=	grdT401.GetCellData("bd_cell3", lRow)
		
		if	szProsYN	=	"Y"	then
			'주문취소확인팝업 오픈
			Form.openPopupAnimation("mbfnp51030_p1" ,  szFundName & "★" & g_szOrdno & "★" & g_szReqDate & "★" 
										& szAplDate & "★" & szDealDate & "★" & szBuySell & "★" 
										& szReqQtyAmt& "★" & g_szRmndSrno   & "★" 
										& g_szFullAcnt & "★" & szIiscSelnFormClsCode ,"","2") 'v003(매도방식추가)
'
		elseif	szProsYN	=	"N"	then
			Form.ShowAlert(g_szAlertTitle, "해당상품은 매매취소가 불가합니다.")
		else
		end if
	
	'21.07.12 JHY START
	'v002
	elseif szCellId = "bd_cell132" then	'	elseif szCellID == "bd_CarefulBTN" then
		'숙려중 클릭시
		if szCarefulYN == "Y" and grdT401.GetCellData("bd_cell132", i) = "숙려중" then
			'숙려투자의사표시 화면으로 이동!
			Form.OpenScreen("55007" , "")
		else
			Exit Sub
		end if
	'21.07.12 JHY END
	end	if
End Sub

'============================================================================
' grdT401_OnScrollEnd() : 연속조회
'============================================================================
Sub grdT401_OnScrollEnd()
	if  DATAMANAGER.IsMoreNextData( "obsai_deal_070r" ) == true then 
		DATAMANAGER.RequestNextData( "obsai_deal_070r" )
	end if	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_szFullAcnt	= cmbAccount.total & cmbAccount.sequence
	
	if	szTranID	=	"obsai_deal_070r"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
		
	elseif	szTranID	=	"obsai_deal_070a"	then
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "CONT_CLS_CODE", 0, "4")
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ASNO", 0, mid(g_szFullAcnt, 9, 2))
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "RMND_SRNO"	, 0, g_szRmndSrno)
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ODER_DATE"	, 0, g_szReqDate )
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "OM_ODER_SRNO", 0, g_szOrdno)
		
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obsai_deal_070a", "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, "obsai_deal_070a", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
		
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if	szTranID	=	"obsai_deal_070r"	then
		dim	szDataCnt
		dim	szOrgBuySell
		dim	szDealAmt,	szDealQty
		
		szDataCnt=""
		szOrgBuySell=""
		szDealAmt=""
		szDealQty=""
		szSelnClsCode="" 'v003
		
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "obsai_deal_070r", "OutBlock1")
		
		for	i=0	to	szDataCnt - 1
			szOrgBuySell	=	DATAMANAGER.GetDataValue(0, "obsai_deal_070r", "OutBlock1", "DEAL_CLS_CODE", i)
			szDealAmt	        =	DATAMANAGER.GetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i)
			szDealQty	        =	DATAMANAGER.GetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_QTY", i)
			szSelnClsCode  =       DATAMANAGER.GetDataValue(0,"obsai_deal_070r", "OutBlock1", "IISC_SELN_FORM_CLS_CODE", i) 'v003
	
			if	szOrgBuySell	=	"2"		then		'매수
				DATAMANAGER.SetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i, szDealAmt)
			else
				IF szSelnClsCode = "01" THEN '정액매도 v003
				    DATAMANAGER.SetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i, szDealAmt)
				ELSE
				    DATAMANAGER.SetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i, szDealQty)
				END IF
			end	if
		next	
		
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n070Cnt, szDataCnt
	dim	szOrgBuySell	,	szTrsBuySell
	dim	szOrgCancel	,	szTrsCancel
	dim	szOrgHourCode	,	szTrsHourCode
	
	dim  nMulti
	
	szOrgBuySell	=""
	szTrsBuySell	=""
	szOrgCancel	=""
	szTrsCancel	=""
	szOrgHourCode	=""
	szTrsHourCode =""
	
	
	if	szTranID	=	"obsai_deal_070r"	then
	
		n070Cnt 	=	grdT401.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "obsai_deal_070r", "OutBlock1")
		nMulti =  ( n070Cnt / szDataCnt ) - 1
	
		if int(n070Cnt) = 0 then
			lblNoData.visible = 1
			grdT401.visible = 0
			
			Exit Sub
			
		else
			lblNoData.visible = 0
			grdT401.visible = 1
				
			for	i=0+(nMulti * szDataCnt) to	n070Cnt-1
			
				szOrgBuySell 		=	grdT401.GetCellData("bd_cell9", i)
				szOrgCancel 	 	=	grdT401.GetCellData("bd_cell1", i)
				szOrgHourCode		=	grdT401.GetCellData("bd_cell13", i)
	
				'1. 매매구분코드
				szTrsBuySell	=	Form.GetMetaData("매매구분코드", szOrgBuySell)
				
				'2. 취소구분코드
				if	szOrgCancel	=	"Y"	then
					szTrsCancel	=	"취소"
				else
					szTrsCancel	=	"정상"
				end if
				
				grdT401.SetCellData("bd_text1", i, "주문구분")
				grdT401.SetCellData("bd_text2", i, "잔고번호")
				grdT401.SetCellData("bd_text3", i, "주문금액(좌)")
				grdT401.SetCellData("bd_text4", i, "주문신청일")
				grdT401.SetCellData("bd_text5", i, "결제예정일")
				grdT401.SetCellData("bd_text6", i, "거래상태")
				
				
				'2-1 취소 구분에 따라 색상변경
				'버튼 폰트색		
				grdT401.SetCellData("bd_Cancel", i, "취소하기")
				
				if	szOrgCancel	=	"Y"	then		'취소
					grdT401.SetCellFgColor("bd_Cancel", i, "27")
				else								'정상
					grdT401.SetCellFgColor("bd_Cancel", i, "1")
				end	if
				
				
				
				
				
				'3. 시간코드
				if	szOrgHourCode	=	"01"	then
					szTrsHourCode	=	"15시"
				elseif		szOrgHourCode	=	"02"	then
					szTrsHourCode	=	"17시"
				elseif		szOrgHourCode	=	"03"	then
					szTrsHourCode	=	"13시"
				else
					szTrsHourCode	=	""
				end if
		
				grdT401.SetCellData("bd_cell9", i, szTrsBuySell)
				grdT401.SetCellData("bd_cell1", i, szTrsCancel)
				grdT401.SetCellData("bd_cell13", i, szTrsHourCode)
	
				'21.07.06 JHY STRAT
				'v002
				'숙려중인경우 기준가 적용일, 결제일 표시 안함
				Dim szCarefulYN
				szCarefulYN = grdT401.GetCellData("bd_CarefulYN", i)
				grdT401.SetCellData( "bd_CarefulBTN", i, "숙려내용확인")

				if szCarefulYN == "Y" then
					grdT401.SetCellData("bd_cell5", i, "")
					grdT401.SetCellData("bd_cell12", i, "")
		
'					grdT401.SetCellEnable( "bd_CarefulBTN", i, true)
					
					grdT401.SetCellFgColor("bd_Cancel", i, "27")
					grdT401.SetCellEnable( "bd_Cancel", i, false)
				
				else
'					grdT401.SetCellEnable( "bd_CarefulBTN", i, false)
				end if			
				'21.07.06 JHY END 
				
				
				'주문금액(좌)"
				szSelnForm 		=	grdT401.GetCellData("bd_SelnForm", i)	'01(원) / 02(좌)
				szAmtQty			=	grdT401.GetCellData("bd_cell10", i)
				
				grdT401.SetCellData("bd_cell10_2", i, szAmtQty)				
				if	szTrsBuySell	=	"매수"		then		'매수
					grdT401.SetCellData("bd_cell10_2", i, FormatNumber(szAmtQty, 0) & "원")
				else	'매도
					if szSelnForm = "01" then
						grdT401.SetCellData("bd_cell10_2", i, FormatNumber(szAmtQty, 0) & "원")
					else
						grdT401.SetCellData("bd_cell10_2", i, FormatNumber(szAmtQty, 0) & "좌")
					end if
				end if
				
				
				
				' 주문처리결과구분코드
				' 거래상태가 주문완료, 숙려중, 취소 일때는 취소하기 버튼 비활성화 처리
				Dim szRsltCd, szRsltCdNm
				szRsltCd = grdT401.GetCellData("bd_cell132", i)
		
				if szRsltCd = "01" then
					szRsltCdNm = "주문중"
					grdT401.SetCellEnable( "bd_Cancel", i, true)
					grdT401.SetCellFgColor("bd_Cancel", i, "1")
				elseif szRsltCd = "02" then
					szRsltCdNm = "주문완료"
					grdT401.SetCellEnable( "bd_Cancel", i, false)
					grdT401.SetCellFgColor("bd_Cancel", i, "27")
				elseif szRsltCd = "03" then
					szRsltCdNm = "숙려중"
					grdT401.SetCellEnable( "bd_Cancel", i, false)
					grdT401.SetCellFgColor("bd_Cancel", i, "27")
				elseif szRsltCd = "04" then
					szRsltCdNm = "취소"
					grdT401.SetCellEnable( "bd_Cancel", i, false)
					grdT401.SetCellFgColor("bd_Cancel", i, "27")
				end if
								
				grdT401.SetCellData("bd_cell132", i, szRsltCdNm)	'거래상태
				
			next

		end if
		
	elseif	szTranID	=	"obsai_deal_070a"	then
		Form.MsgBox("안내", "주문 취소가 완료되었습니다.", "", 0)
		
		DATAMANAGER.RequestTranData("obsai_deal_070r")
		
	end if
End Sub

'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'===============================================
	'********** 취소 팝업       ***********
	'===============================================
	if sKeyName == "mbfnp51030_p1" then
		if sRet == "cancel" then
			Dim sSendData
			sSendData = cmbAccount.total&cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
		
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				
				DATAMANAGER.RequestTranData( "obsai_deal_070a" )
			end if
		end if

	end	if

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	DATAMANAGER.RequestTranData("obsai_deal_070r")
End Sub

'============================================================================
Sub cmbBuySell_OnEditComplete(iIndex)
	if iIndex = 0 then
		imgArrow.left = 90
	else
		imgArrow.left = 60
	end if
	DATAMANAGER.RequestTranData("obsai_deal_070r")
End Sub

'============================================================================
Sub cmbStatus_OnEditComplete(iIndex)
	if iIndex = 0 then
		cmbStatus.left = 140
	else
		cmbStatus.left = 200
	end if
	DATAMANAGER.RequestTranData("obsai_deal_070r")
End Sub

'============================================================================
Sub cmbPridGb_OnEditComplete(iIndex)
	if iIndex == 0 then
		cmbPridGb.left = 290
	else
		cmbPridGb.left = 280
	end if
	
	f_SetFromToDate(iIndex)

	DATAMANAGER.RequestTranData( "obsai_deal_070r" )
End Sub

'============================================================================
Function f_SetFromToDate(nIndex)
	sHostDate = cldT4EndDate.caption
	sTempHostDate = LEFT(sHostDate,4) & "-" & RIGHT(LEFT(sHostDate,6),2) & "-" & RIGHT(sHostDate,2)

	Select Case nIndex
		Case 0	'0:당일
			cldT4StartDate.caption = cldT4EndDate.caption
	
		Case 1	'1주일
			cldT4StartDate.caption = Replace(DateAdd("d",-7,sTempHostDate), "-", "")
			
		Case 2	'1개월
			cldT4StartDate.caption = Replace(DateAdd("m",-1,sTempHostDate), "-", "")
			
		Case 3	'3개월
			cldT4StartDate.caption = Replace(DateAdd("m",-3,sTempHostDate), "-", "")		
			
	End Select
End Function

'============================================================================
Sub cldT4StartDate_OnEditComplete()
	DATAMANAGER.RequestTranData( "obsai_deal_070r" )
End Sub

'============================================================================
Sub cldT4EndDate_OnEditComplete()
	DATAMANAGER.RequestTranData( "obsai_deal_070r" )
End Sub

