'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 체결내역
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
' 2016-06-13 ESKIM : 계약번호 없을시 메세지 팝업 요청(노희범 차장님)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bInitOK
g_bInitOK = False

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If acnt0.caption = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If cmbSeq.caption = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Sub CheckCalendar()
	Dim sSDate, sFDate
	sSDate = cldStart.calyear &"-"& cldStart.calmonth &"-"& cldStart.calday
	sFDate = cldFinish.calyear &"-"& cldFinish.calmonth &"-"& cldFinish.calday
	
	If DateDiff("d", sSDate, sFDate) > 90 then
		Form.MsgBox( "알림", "조회구간은 3개월 이내로 가능합니다.", "", 6 )
		return False
	End If
	
	return True
End Sub

'============================================================================
'조회
Sub RequestData(nIndex)
	grd0.rowcount = 0		'Clear Data
	
	'계좌번호/계약번호 변경시, 조회버튼 클릭시에만 계약상태 조회
	If nIndex == 0 then
		tbl0.SetCellString( 0 , 1 , "")		'계약상태 Clear
		If Account_Check() == True then		'계좌체크
			DATAMANAGER.RequestTranData( "obwat_mgmt_271r" )	'계약상태 조회
		End If
	End If
	
	If Account_Check() == True then			'계좌체크
		If CheckCalendar() == True then		'기간체크
			DATAMANAGER.RequestTranData( "obwat_ctcs_037r" )	'계약종합정보_매매내역 조회
		End If
	End If
End Sub

'============================================================================
'개별운용계좌 Display
Sub SetGridData(szTranID)
	Dim i, sACNO
	
	For i = 0 to grd0.rowcount-1
		sACNO = grd0.GetCellData( "bd_cell10" , i ) & grd0.GetCellData( "bd_cell12" , i )
		grd0.SetCellData( "bd_cell2", i, sACNO)
	Next
End Sub

'============================================================================
'계약상태 Display
Sub SetCnrcStat(szTranID)
	Dim sCode, sCnrcStat
	sCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_STAT_CLCD" , 0 )

	Select Case sCode
		Case "01"
			sCnrcStat = "운용불가"
		Case "02"
			sCnrcStat = "정상"
		Case "03"
			sCnrcStat = "청산진행"
		Case "04"
			sCnrcStat = "청산완료"
		Case "05"
			sCnrcStat = "계약해지"
		Case "06"
			sCnrcStat = "계약취소"
		Case "07"
			sCnrcStat = "승인대기"
		Case "08"
			sCnrcStat = "거부"
	End Select
	
	tbl0.SetCellString( 0 , 0 , sCnrcStat)
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call cmbPeriod_OnEditComplete(3)	'디폴트 3개월
	Call acnt0_ChangeAccount()
	g_bInitOK = True
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call RequestData(0)	'조회
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	'계좌번호 변경시 계약번호 TR 태운 후 조회하기 때문에 Clear 시간차 발생, 이에 계약상태 Clear 먼저함
	tbl0.SetCellString( 0 , 1 , "")					
	cmbSeq.clear = 1								'계약번호 초기화
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
End Sub

'============================================================================
Sub cmbSeq_OnEditComplete(iIndex)
	Call RequestData(0)	'조회
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Call RequestData(0)	'조회
End Sub

'============================================================================
Sub cmbGubn_OnEditComplete(iIndex)
	Call RequestData(1)	'조회
End Sub

'============================================================================
Sub cldStart_OnEditComplete()
	Call RequestData(1)	'조회
End Sub

'============================================================================
Sub cldFinish_OnEditComplete()
	Call RequestData(1)	'조회
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	cldFinish.caption = cldToday.caption
	
	Select Case iIndex
		Case 0	'당일
			cldStart.caption = cldToday.caption	
		Case 1	'1주일
			cldStart.caption = Replace(DateAdd ("d", -7, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
		Case 2	'1개월
			cldStart.caption = Replace(DateAdd ("d", -30, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
		Case 3	'3개월
			cldStart.caption = Replace(DateAdd ("d", -90, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
	End Select
	
	If g_bInitOK == True then
		Call RequestData(1)	'조회
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctcs_037r" or szTranID == "obwat_mgmt_271r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , cmbSeq.caption )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계약번호조회
	If szTranID == "obwat_ctad_011r" then
		Dim i, nCnt	

		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )

		'2016-06-13 ESKIM : 계약번호 없을시 메세지 팝업 요청(노희범 차장님)
		If nCnt == 0 then
			Form.ShowAlert("알림", "ISA 계약이 존재하지 않습니다.")
		End If
		
		For i = 0 To nCnt - 1
			cmbSeq.cbadddatatext = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_NO" , i )		'계약번호
		Next

		cmbSeq.SetCurSel( 0 )	
		Call RequestData(0)	'조회
	End If
	
	'계약평가현황
	If szTranID == "obwat_mgmt_271r" then
		Call SetCnrcStat(szTranID)	'계약상태 Display
	End If
	
	'계약종합정보_매매내역
	If szTranID == "obwat_ctcs_037r" then
		SetGridData(szTranID)		'개별운용계좌 Display
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub
