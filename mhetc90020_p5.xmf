Sub contBtm_edtID_OnClick()
	contBtm.LblTop.top = 400
	contBtm.SetScrollAutoSize()
	contBtm.scroll_pos = 50
	
	' 1 : 안드로이드, 2 : IOS
     if "1" == Form.GetSharedData("&OS_TYPE", false) then
	     BtnAlpha.left = 0
     end if
     
End Sub

