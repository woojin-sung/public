'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obacp_comm_039u" then
		
		'20170828 LES START - UESRID헤더값 세팅
		DATAMANAGER.SetUserID("meritz")
		'20170828 LES END
		
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNOP", 0, GetRCNO())	'실명확인번호 'v004
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, GetRCNO())	'실명확인번호 'v004
		
		'v0003 비밀번호 컨트롤직접매핑->스크립트로 변경
		if g_plain_rm == "1" then  'MTS메모리평문 적용상태일때
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contBtm.edtPW0.caption)
		else  'MTS메모리평문 미적용상태일때
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(contBtm.edtPW0.caption) )
		end if
	end if 

	if szTranID = "obcsb_oimf_520r" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO", 0, GetRCNO())	'실명확인번호 'v004
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, GetRCNO())	'실명확인번호 'v004
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, gRcnoPip )	'실명확인번호 'v009
	end if 
	
	
     'v0003 비밀번호 유효성 검증체크
	if szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "4" )	 'MTS_ID가입시,ID비밀번호유효성체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , contBtm.edtAcnt.caption )  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , contBtm.edtID.caption   )  'ID
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , contBtm.edtPW1.caption2 )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , contBtm.edtPW2.caption2 )  '확인비밀번호
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , GetRCNO()               )  '실명확인번호	'v004
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"		 , 0 , GetRCNO()               )  '실명확인번호	'v004
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo                )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo                )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo                )  '자택전화
     end if
		
	'ID등록요청
	if szTranID == "obcsb_efif_060a" then
		if CInt(rdoGubn.currentindex) == 1 Then 	' 법인인경우
			szCustClsCode = "2"
		Else								' 개인인 경우
			szCustClsCode = "1"
		End If
		
		DATAMANAGER.SetUserID("meritz")		'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0 , contBtm.edtAcnt.caption	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , contBtm.edtPW0.caption		)
		'v008 DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" 		, 0 , edtForeign.caption	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" 	, 0 , szCustClsCode			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 		, 0 , contBtm.edtID.caption		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" 		, 0 , contBtm.edtPW1.caption		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , g_060aProsClsCode		)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계좌비밀번호 확인 
	if szTranID == "obacp_comm_039u" then
		g_sAcntPwChk = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		if g_sAcntPwChk == "1" then
			g_sAcntPwChk = "Y"
			g_birthChk   = "Y"
		else
			g_sAcntPwChk = "N"
			g_birthChk   = "N"
		end if
		
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			Form.MsgBox( "알림", sSubMsg, "", 6 )
		end if			
	end if
	
	'사용자 ID 중복확인 
	if szTranID == "obcsb_efif_220r" then
		g_sIDDupChk = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_ABLE_YN" , 0)
		if g_sIDDupChk == "Y" then
			Form.MsgBox( "알림", "사용 가능한 아이디 입니다.", "", 6 )
		elseif g_sIDDupChk == "N" then
			Form.MsgBox( "알림", "입력하신 ID는 이미 사용중입니다.", "", 6 )
		end if
	end if
	
	'ID 비밀번호 유효성 검사 
	if szTranID == "obacp_comm_004r" then
		'v0003 고객연락처설정
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화

		'v0003 MTS메모리평문 적용일 경우, 서비스단에서 체크
		if g_plain_rm == "1" then
			DATAMANAGER.RequestTranData("obacp_comm_058r")	'비밀번호 유효성 검증체크
		else	
			if IsValidPswd() == True then
				DATAMANAGER.RequestTranData("obcsb_efif_005r")	'은행개설여부
			end if
		end if		
	end if

	'v0003 비밀번호 유효성 검증체크
	if szTranID == "obacp_comm_058r" then
		DATAMANAGER.RequestTranData("obcsb_efif_005r")	'은행개설여부
     end if
		
	'은행개설여부
	if szTranID == "obcsb_efif_005r" then
		Dim sBankYN
		sBankYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "UI_BANK_OPNG_YN" , 0)
		
		if g_szList(0) = "은행" and sBankYN == "N" then
			Form.MsgBox( "알림", "지점개설계좌 ID등록을 선택하여 등록을 진행하시기 바랍니다.", "close", 6 )
		elseif g_szList(0) = "지점" and sBankYN == "Y" then
			Form.MsgBox( "알림", "은행개설계좌 ID등록을 선택하여 등록을 진행하시기 바랍니다.", "close", 6 )
		'20160610 START NOHES 문구 수정	
		elseif Trim(g_szList(0)) = "지점/모바일" and sBankYN == "Y" then
			Form.MsgBox( "알림", "은행개설계좌 ID등록을 선택하여 등록을 진행하시기 바랍니다.", "close", 6 )
		'20160610 END
		else
			DATAMANAGER.RequestTranData("obcsb_acif_000r")	'고객정보조회(HTS 약정여부 확인을 위해 고객번호를 가져옴)
		end if
	end if
	
	'고객정보조회
	if szTranID == "obcsb_acif_000r" then	
		Dim sCSNO
		sCSNO = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CSNO" , 0)			'고객번호
		gRcnoPip = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RCNO_PIP" , 0)	'주민번호 v009
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO", 0, sCSNO )		'고객번호 셋팅
		'v0003 계좌단위 HTS약정인경우 다건조회오류발생있어 계좌번호 매핑해줌
		'v007 법인인 경우만 계좌번호 셋팅
		if CInt(rdoGubn.currentindex) == 2 Then 	' 법인인경우
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO", 0, contBtm.edtAcnt.caption )
		End If

		DATAMANAGER.RequestTranData("obpds_srvc_323r")								'HTS 약정여부 확인
	end if
	
	'HTS 약정여부 확인
	if szTranID == "obpds_srvc_323r" then	
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APRV_YN" , 0) == "N" then	'N:정상약정
			if Trim(g_szList(0)) = "은행" then
				'v0001 주석처리 (obcsb_acif_557a_1 call 후 moveNextPage call)
				'Call MoveNextPage("")		'다음 페이지로
				'DATAMANAGER.RequestTranData("obcsb_acif_557a")	'고객신용정보관리(공통)
				
				'공통화면 호출로 변경
				Dim sAcno 
				sAcno = contBtm.edtAcnt.caption
				Form.OpenFramePopup("mbonl81020" ,  "018;" & sAcno , sPosInfo)
			elseif Trim(g_szList(0)) = "지점" then
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")	'보안매체종류 조회
			'20160610 NOHES START 지점에서 지점/모바일로 문구 수정
			elseif Trim(g_szList(0)) = "지점/모바일" then
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			'20160610 NOHES END
			end if
		else
			Form.MsgBox( "알림", "약정여부를 확인하시고 다시 등록하시기 바랍니다.", "close", 6 )
		end if
	end if
	
	'보안매체종류 조회
	if szTranID == "obcsb_oimf_520r" then	
		Dim sResult
		'0: 보안카드 / 1: 부가정보 / 2: otp,보안카드,부가정보 없음 / 3: otp / 9: 기타오류
		sResult = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0)
		'보안카드, OTP
		if sResult == "0" or sResult == "3" then		
			Call MoveNextPage(sResult)		'다음 페이지로
		'부가정보인 경우, 보안매체 없음과 동일하게 처리함(전요셉 과장 요청)
		elseif sResult == "1" or sResult == "2" then 
			if CInt(rdoGubn.currentindex) == 2 Then '법인인경우 기존 팝업 
				Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			else
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			end if
		else 
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if		
	end if
	
	'ID 등록요청
	if szTranID == "obcsb_efif_060a" then	
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SUCS_YN" , 0) == "Y" then
			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 6 )
		else 
			Form.MsgBox( "알림", "ID등록이 실패하였습니다. 해당 영업점 또는 고객지원센터(1588-3400)로 문의 바랍니다.", "", 6 )
		end if
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	' 20180717 HAMWG START : 서비스에러메시지 안내팝업 조건수정
	'if szTranID == "obacp_comm_039u" or szTranID == "obcsb_efif_220r" then
	'v010 : ID 등록 시 주문내역 존재 체크 
	
	if szTranID == "obcsb_efif_060a" and (szErrCode == 6049 or szErrCode == "6049") then	
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox( "알림", szErrMsg.."\n("..sSubMsg..")\n".."주문 취소 후 다시 ID등록을 진행하시기 바랍니다.", "", 6 )
	else
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.."("..sSubMsg..")"
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
	'end if
	' 20180717 HAMWG END
End Sub

