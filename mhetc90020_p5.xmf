'============================================================================
Sub Form_OnFormInit()
	Dim szList
	g_birthChk = "N"
	g_sAcntPwChk = "N"		'계좌비밀번호 확인
	g_sIDDupChk = "N"			'ID 중복 확인
	g_sRetData = "cancel"
	g_sPopupFileName = "mhetc90060_p8"		'공인인증서_추가인증
	
	'v0003 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'v0003 Defualt-주민번호용Aria키값 변경에 따른 API호출 삭제 
	'if g_plain_rm == "1" then
	'	'주민번호용 Aria키값으로 암호화하도록 설정(SetAriaNoBank())(Defualt-이체용Aria키값(SetAriaBank()))
	'     contBtm.edtPW1.SetAriaNoBank()
	'     contBtm.edtPW2.SetAriaNoBank()
	'end if
	
	g_sSendData = Form.GetOpenLinkData()
	g_TmpData = Form.GetOpenLinkData() 'v011
	g_szList = Split(g_sSendData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
'	Form.SetScreenName(g_szList(0) & "개설계좌 ID등록")
	Form.SetScreenName("ID등록")
	
	lbl2.caption = "계좌번호 찾기 >"
	edtBirth.setApplyLabel			("생년월일", 			-1, 268, "left", false)
	edtForeign.setApplyLabel		("실명확인번호",		-1, 268, "left", false)
	edtLicens.setApplyLabel		("사업자등록번호", 	-1, 268, "left", false)
	contBtm.edtAcnt.setApplyLabel	("계좌번호", 			-1, 268, "left", false)
	contBtm.edtPW0.setApplyLabel	("계좌비밀번호", 		-1, 268, "left", false)
	contBtm.edtID.setApplyLabel		("ID", 				-1, 268, "left", false)
	contBtm.edtPW1.setApplyLabel	("ID비밀번호", 		-1, 268, "left", false)
	contBtm.edtPW2.setApplyLabel	("ID비밀번호 확인", 	-1, 268, "left", false)
	
	contBtm.btnID.bringFront("1")
	
	contBtm.edtID.SetUseAutoScroll(true)
	contBtm.edtPW1.SetUseAutoScroll(true)
	contBtm.edtPW2.SetUseAutoScroll(true)
	
	Call rdoGubn_OnClick(0)
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SendReturnToParent( "mhetc90020_p5" , g_sRetData )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'Form.ShowAlert(sKeyName, sRet)
	If sKeyName == "mhetc90060_motp" Then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData("obcsb_efif_060a")	'ID 등록요청
		End If
	Elseif sKeyName == g_sPopupFileName then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
	
	if sKeyName= "mbonl81020"	then	
		if sRet == "ok" then
			Call MoveNextPage("")		'다음 페이지로
		end if 
	end if
	
	' 계좌번호찾기 완료
	if sKeyName == "mbonl85001" then
		
		if len(sRet) > 8 then
			Dim sAcntArr
			sAcntArr = split(sRet, "-")
			
			contBtm.edtAcnt.caption = sAcntArr(0)
		else
			contBtm.edtAcnt.caption = sRet
		end if
		
    end if
    
 	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if    
    
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'은행개설여부 및 HTS 약정여부 확인 오류 메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		g_sRetData = "ok"
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	end if
End Sub

'============================================================================
'내국인/외국인/법인 선택에 따른 CONTAINER SWITCH
Sub rdoGubn_OnClick(nIndex)
	edtBirth.visible		= False
	edtForeign.visible	= False
	edtLicens.visible		= False
	lbl1.visible			= False
	
	'내국인
	if nIndex == 0 then
		edtBirth.visible		= True
		Button0.top			= 158
		lbl2.top				= 163
		contBtm.top			= 180
		
	'외국인
	elseif nIndex == 1 then
		edtForeign.visible	= True
		lbl1.visible			= True
		Button0.top			= 168
		lbl2.top				= 173
		contBtm.top			= 190
		
	'법인
	elseif nIndex == 2 then
		edtLicens.visible		= True
		Button0.top			= 158
		lbl2.top				= 163
		contBtm.top			= 180
	end if
End Sub

