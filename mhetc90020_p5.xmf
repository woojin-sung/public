	<SCRIPT_INFO _len="33544" _ulen="28518" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 은행/지점 개설계좌 ID등록_필수정보입력
' 02. 화면설명 : 
' 03. 작    성 : 2016.03.07 김은숙
' 04. 수    정 : 2018.09.10 김유경 : 은행개설계좌 ID 등록시 개인신용정보제공동의 위치 변경
'			  현재: *개인신용정보 제공동의(A)(단말에 저장)>ID등록정보 입력(B)>필수정보입력(C)>부가질문 입력(D)>*개인신용정보 제공동의(E) 처리
'			  개선: ID등록정보 입력(B) 처리 직전에 *개인신용정보 제공동의(A) 처리 선행
'			 : 2019.04.23 조승행 : 개인신용정보처리 동의서 항목 변경 관련 개발 v0002
' 2020.09.14 : 정민영 : v0003 : [T2008250015] 메모리취약점 보완
' 2020.10.27 : 권오상 : v004 : T2008250015 : 실명확인번호 암호화 처리'
' 2021.05.27 : 신용정보동의 공통팝업 처리 obcsb_efif_060a IO 변경분 적용
' 2021.07.05 : 정민영 : obcsb_efif_005r IO 재매핑
' 2022.06.02 : 권오상 : v007 : obpds_srvc_323r 계좌번호 설정 변경(법인인 경우만 계좌번호 셋팅)
'                       개인인 경우 hts약정시 등록된 계좌번호로만 약정 확인되는 현상 수정.
' 2023.11.07 : 양현정 : v008 : obcsb_efif_060a. 없는 io매핑 삭제
' 2023.12.01 : 전상일 : v009 : 보안매체 가져오는 rcno_pip  수정
' 2023.12.21 : 전상일 : v010 : ID 등록 시 주문내역 존재 체크 
' 2024.06.19 : 전상일 : v011 : 쉐어드데이터 초기화 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData		'Form Close시 리턴값("ok" / "cancel")
Dim g_sPopupFileName	'다음 버튼 클릭시 팝업화면 파일명
Dim g_sAcntPwChk		'계좌비밀번호 확인 ("Y" : 성공, False : 실패)
Dim g_sIDDupChk		'ID 중복 확인 ("Y" : 성공, False : 실패)
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array
Dim g_plain_rm         'v0003 MTS메모리평문적용여부
Dim g_HomeNo           'v0003 자택전화번호
Dim g_ClphNo			'v0003 휴대전화번호
Dim g_WorkNo			'v0003 직장전화번호
Dim g_sSendDataTmp		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_060aProsClsCode
Dim g_RcnoPip          'v009
Dim g_TmpData		     'v011
Dim g_birthChk        '생년월일 확인 ("Y" : 성공, False : 실패)
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'내국인/외국인/법인 선택에 따른 실명번호
Function GetRCNO()
	Dim sRCNO
	
	if rdoGubn.currentindex == "0" then		'내국인
		sRCNO = edtBirth.caption
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		sRCNO = edtForeign.caption
	else									'법인
		sRCNO = edtLicens.caption
	end if
	
	return sRCNO
End Function

'============================================================================
'다음 버튼 클릭시 필수정보 입력 여부 확인
Function ValidatCheck()
	if rdoGubn.currentindex == "0" then		'내국인
		if Len(edtBirth.caption) < 6 then
			Form.MsgBox( "알림", "생년월일을 입력해 주세요.", "", 6 )
			return False
		end if
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		if edtForeign.caption == "" then
			Form.MsgBox( "알림", "실명확인번호를 입력해 주세요.", "", 6 )
			return False
		end if
	else									'법인
		if edtLicens.caption == "" then
			Form.MsgBox( "알림", "사업자등록번호를 입력해 주세요.", "", 6 )
			return False
		end if
	end if
	
	if Len(contBtm.edtAcnt.caption) < 8 then
		Form.MsgBox( "알림", "계좌번호를 입력해 주세요.", "", 6 )
		return False
	end if
	
	if g_sAcntPwChk == "N" then
		Form.MsgBox( "알림", "계좌비밀번호 확인을 해주세요.", "", 6 )
		return False
	end if
	
	if g_sIDDupChk == "N" then
		Form.MsgBox( "알림", "사용자 ID 중복확인을 해주세요.", "", 6 )
		return False
	end if
	
	'v011
	if g_birthChk == "N" then
		Form.MsgBox( "알림", "생년월일 또는 실명번호를 확인해주세요.", "", 6 )
		return False
	end if
	
	'v0003 'MTS메모리평문 미적용상태일때만 체크
	if g_plain_rm ~= "1" then
		if Str_Chk(contBtm.edtPW1.caption, "PW") == False then		'영문+숫자+특수문자 혼합 필수 , 8~12자리 
			Form.MsgBox("알림", "비밀번호가 영문+숫자+특수문자 조합이 아니거나 자릿수 8~12 자리가 아닙니다.", 0, 6)
			contBtm.edtPW1.caption = ""
			contBtm.edtPW2.caption = ""
			return False
		end if
	
		if contBtm.edtPW1.caption <> contBtm.edtPW2.caption then
			Form.MsgBox("알림", "비밀번호와 비밀번호확인이 일치하지 않습니다.", 0, 6)
			return False
		end if	
	end if

	return True
End Function

'============================================================================
'비밀번호 유효성 검사
Function IsValidPswd()

	Dim sJuminNum, sRcnoPip
'	sJuminNum = DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "RCNO" , 0) 'v004
	sRcnoPip = DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "RCNO_PIP" , 0) 'v004
	
	for i = 1 to Len(contBtm.edtPW1.caption) - 3		'주민등록번호와 비교
		Dim szEdit, szJoomin
		szEdit = mid( contBtm.edtPW1.caption , i , 4)
		for j = 1 to Len( sJuminNum ) - 3
			szJoomin = mid( sJuminNum , j , 4 )
			if szEdit == szJoomin then
				Form.MsgBox( "알림" , "유효하지 않은 비밀번호입니다.", 0, 6 )
				contBtm.edtPW1.caption = ""
				contBtm.edtPW2.caption = ""
				return False
			end if
		next
	next
		
	for i = 1 to Len(contBtm.edtPW1.caption) - 3 ' 연속된 3자리 숫자, 동일 숫자
		if Asc(mid( contBtm.edtPW1.caption, i, 1 )) = Asc(mid(contBtm.edtPW1.caption,i+1,1)) + 1 and Asc(mid(contBtm.edtPW1.caption,i+1,1)) = Asc(mid(contBtm.edtPW1.caption,i+2,1)) + 1 then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			contBtm.edtPW1.caption = ""
			contBtm.edtPW2.caption = ""
			return False
		elseif Asc(mid(contBtm.edtPW1.caption,i,1)) = Asc(mid(contBtm.edtPW1.caption,i+1,1)) - 1 and Asc(mid(contBtm.edtPW1.caption,i+1,1)) = Asc(mid(contBtm.edtPW1.caption,i+2,1)) - 1 then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			contBtm.edtPW1.caption = ""
			contBtm.edtPW2.caption = ""
			return False
		elseif Asc(mid(contBtm.edtPW1.caption,i,1)) = Asc(mid(contBtm.edtPW1.caption,i+1,1)) and Asc(mid(contBtm.edtPW1.caption,i+1,1)) = Asc(mid(contBtm.edtPW1.caption,i+2,1)) then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			contBtm.edtPW1.caption = ""
			contBtm.edtPW2.caption = ""
			return False
		end if
	next
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) > 4 then
		for i = 1 to Len(contBtm.edtPW1.caption) - 3		'휴대폰번호와 비교
			Dim szPhone
			szEdit = mid(contBtm.edtPW1.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) - 3
				szPhone = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0),j,4)
				if szEdit == szPhone then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(휴대폰번호와 4자리 이상 일치)", 0, 6)
					contBtm.edtPW1.caption = ""
					contBtm.edtPW2.caption = ""
					return False
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) > 4 then
		for i = 1 to Len(contBtm.edtPW1.caption) - 3		'자택번호와 비교
			Dim szHome
			szEdit = mid(contBtm.edtPW1.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) - 3
				szHome = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0),j,4)
				if szEdit == szHome then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(자택번호와 4자리 이상 일치)", 0, 6)
					contBtm.edtPW1.caption = ""
					contBtm.edtPW2.caption = ""
					return False
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) > 4 then
		for i = 1 to Len(contBtm.edtPW1.caption) - 3		'직장번호와 비교
			Dim szWorkTel
			szEdit = mid(contBtm.edtPW1.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) - 3
				szWorkTel = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0),j,4)
				if szEdit == szWorkTel then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(직장번호와 4자리 이상 일치)", 0, 6)
					contBtm.edtPW1.caption = ""
					contBtm.edtPW2.caption = ""
					return False
				end if
			next
		next
	end if
	
	if Len(contBtm.edtID.caption) > 4 then
		for i = 1 to Len(contBtm.edtPW1.caption) - 3		'로그인 아이디와 비교
			Dim szEdit, szLoginID
			szEdit = mid(contBtm.edtPW1.caption,i,4)
			for j = 1 to Len(contBtm.edtID.caption) - 3
				szLoginID = mid((contBtm.edtID.caption),j,4)
				if szEdit == szLoginID then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인ID와 4자리 이상 일치)", 0, 6)
					contBtm.edtPW1.caption = ""
					contBtm.edtPW2.caption = ""
					return False
				end if
			next
		next
	end if
	
	return True
End Function

'============================================================================
'Str_Chk(str) : 입력 비밀번호 유효성 체크
'sGubn = "ID":ID 유효성 체크 / "PW" : 비밀번호 유효성 체크
'============================================================================
'한글 입력, 기럭지 체크
'리턴 : 영+숫, 기럭지 8 ~ 12 = True
'       한글, 기럭지 꽝 	= False
Function Str_Chk(str, sGubn)	
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크 '20150309_01 KBC
    
	chk_n = 0
	chk_c = 0
	chk_t = 0
    
	Dim nMinLen 
	if sGubn == "PW" then		'8~12자리
		nMinLen = 8
	elseif sGubn == "ID" then	'6~12자리
	    nMinLen = 6
	end if
    
    if Len(str) < nMinLen or 12 < Len(str) then
		return False
	end if
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
	    
	    if nAscii < 0 then			'한글 일때
		    return False			'한글 기럭지 2
		else						'영, 숫, 특 일때    '20130125 lkm 영문+숫자 혼합 규칙 → 영문+숫자(필수), 특수문자(선택) 가능 으로 변경 
		    '48~57 : 0~9
		    '65~90 : A~Z
		    '97~122: a~z
		    '
		    If nAscii >=48 and nAscii <=57 Then 
			    chk_n = 1 	
			Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
			    chk_c = 1 
		    '20150309_01 KBC START
		    '특수문자 확인 부분
		    Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
			    chk_t = 1 
		    '20150309_01 KBC END
		    End if 		    
		end if
	Next
    
	if sGubn == "PW" then
		If ((chk_n + chk_c + chk_t) < 3) Then  '20150309_01 KBC
			return False
		End if
	elseif sGubn == "ID" then	'특수문자사용 불가
		If chk_t == 1 Then  
			return False
		End if
	end if
	
	return True
End Function

'============================================================================
'다음 페이지로
'sGubn : 지점개설계좌ID등록인 경우 보안매체종류, 은행개설계좌ID등록인 경우 ""
Sub MoveNextPage(sGubn)
	mOTPYN = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0)
	'외국인인 경우 추가인증 건너뜀
	if rdoGubn.currentindex == "1" then	
		if g_szList(0) == "은행" then
			g_060aProsClsCode = "1"
			g_sPopupFileName = "mhetc90020_p7" 
		'20160610 NOHES 문구수정
		elseif Trim(g_szList(0)) == "지점/모바일" or g_szList(0) == "지점" then
			if sGubn == "3" then		'OTP
				If mOTPYN == "M" Then
					g_sPopupFileName = "mhetc90060_motp" 
				Else
					g_sPopupFileName = "mhetc90060_pb" 
				End If
			elseif sGubn == "0" then	'보안카드
				g_sPopupFileName = "mhetc90060_p9" 
			end if
		end if	
	end if	
	'v011
	g_sSendData = ""
	g_sSendData = g_TmpData
	g_sSendData = g_sSendData + (CInt(rdoGubn.currentindex)+1) + "★"
	g_sSendData = g_sSendData + GetRCNO() + "★"
	g_sSendData = g_sSendData + contBtm.edtAcnt.caption + "★"
	'v0003 메모리평문적용인경우, caption API return값이 암호화된 정보이므로 암호화없이 그대로 넘겨줌
	if g_plain_rm == "1" then
		g_sSendData = g_sSendData + contBtm.edtPW0.caption + "★"
	else
		g_sSendData = g_sSendData + Form.GetEncData(contBtm.edtPW0.caption) + "★"
	end if
	g_sSendData = g_sSendData + contBtm.edtID.caption + "★"
	'v0003 메모리평문적용인경우, caption API return값이 암호화된 정보이므로 암호화없이 그대로 넘겨줌
	if g_plain_rm == "1" then
		g_sSendData = g_sSendData + contBtm.edtPW1.caption + "★"
	else
		g_sSendData = g_sSendData + Form.GetEncData(contBtm.edtPW1.caption) + "★"
	end if
	
	If mOTPYN == "M" Then
		g_060aProsClsCode = "2"
		Form.SetSharedData("IdRegPros", "Y" )
		Form.SetSharedData("IdRegProsAcno", contBtm.edtAcnt.caption )
		g_sSendData = g_sSendData + mOTPYN + "★"
	Else
		g_sSendData = g_sSendData + sGubn + "★"
	End If
	
	If g_sPopupFileName == "mhetc90060_motp" Then
		g_sSendDataTmp = g_sSendData
		g_sSendData = "motp_success"
		Form.OpenPopup( g_sPopupFileName , g_sSendData , sPosInfo)
	Else
		Form.OpenFramePopup( g_sPopupFileName , g_sSendData , sPosInfo)
	End If
	
	
End Sub

