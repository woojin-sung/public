'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCode, g_szAction
g_szCode = ""
g_szAction = "ADD" 

Dim g_szRow
Dim g_szGroupID, g_szGroupName

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)	

Dim g_bInsertExcept
g_bInsertExcept = false

Dim g_szTitle
g_szTitle = "알림"

Dim g_nChkRow	'체크한 그룹의 행
g_nChkRow = -1

'20240221 START
Dim g_nIndex
g_nIndex = -1

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 
'============================================================================
Function InsertItem()

	DATAMANAGER.RequestTranData("ohhts_intr_102r") ' 추가		

End Function

'============================================================================
' Insert_GrdList : grdList에 종목 추가
'============================================================================
Function Insert_GrdList()
     
     '맨위/맨아래 위치에 추가 
	k = 0 '맨 위 추가 (T) - 기본
	if Trim(g_szCode) <> "" then
		if rgTopButtom.currentindex == "1" then '맨 아래 추가(B)
			grdList.insertrow = grdList.rowcount
		end if 
		grdList.insertrow = k
		grdList.SetCellData("bd_memo", k, "")
		grdList.SetCellData("bd_code", k, g_szCode)
		
		szMk = Form.GetItemCodeInfo(g_szCode, "market")
		grdList.SetCellData("bd_mk", k, szMk)
		
		szName = Form.GetItemCodeInfo(g_szCode, "name")
		grdList.SetCellData("bd_name", k, szName)
	end if
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	Dim szData, arrData 

	szData = Form.GetOpenLinkData()	
	if Trim(szData) = "" then
	    Exit sub
	End if
	
	'ADD or GROUP_ADD2
	'관심종목 삭제 로직 추가 - 기존화면에서는 종목코드만 넘겨줌
	szInstr = CInt(Instr(szData, "★"))
	
	'추가로직
	if szInstr > 0 then	
		arrData = Split(szData, "★")	
		
		'종목코드
		g_szCode = arrData(0)		
		
		'동작구분
		g_szAction = arrData(1)
		
		'20240221 START
		'처리행
		g_nIndex = arrData(2)
		
	
	'기존로직
	else					
		ImgClose.imgpath = "alpha128"
		g_szCode = szData
		g_szAction = "ADD"
	end if
	
	
	DATAMANAGER.RequestTranData("ohhts_intr_006r")	

End Sub

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		g_szGroupID = "" 
		g_szGroupName = ""	
		grdGroup.rowcount = 0	' 그룹그리드 초기화	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, g_szUserId)	' USER ID
	
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_007r")
		
		grdList.rowcount = 0	' 종목그리드 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, g_szUserId)	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGroupID)	
		

	elseif szTranID == "ohhts_intr_008r" then

		DATAMANAGER.ClearInputData(false, "ohhts_intr_008r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_008r")
		
		'종목추가, 빈칸적용시
		
		'FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_USER_ID",     0, g_szUserId)		
		
		'FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		
		'FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_MOD_YN",      0, "0")				
		
		'FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")				
		
		For i = 0 to grdGroup.rowcount - 1
			
			' FID관심종목그룹ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", i, grdGroup.GetCellData("bd_code", i))
			
			' FID관심그룹명
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_GRP_NAME",    i, grdGroup.GetCellData("bd_name2", i))	'20230608 KKM 관심종목수 제외
			
			' FID종목수정여부
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", i, "0")			' 수정안함: 0, 수정:1
		Next	
    
    '특정 관심그룹에 해당 관심종목 추가
	elseif szTranID == "ohhts_intr_102r" then  
		DATAMANAGER.ClearInputData(false, "ohhts_intr_102r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_102r")	
		
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_USER_ID",     0, g_szUserId)	' USER ID
		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	

		'추가 종목만 input		
		' FID코드구분코드
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CODE_CLS_CODE", 0, "1")		' 종목		
		
		'szGubun 세팅(OV: 해외주식, KR: 그 외)
		if CInt(Instr(g_szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
			
			tCode = Split(g_szCode, "@")
			
			if UBOUND(tCode) < 1 then
				
			else
				szMk  = tCode[0]
				if Trim(szMk) == "" then
					szMk = "" 
				else
					nMkLen = Form.getLen(szMk)
					if nMkLen = 2 then
						szGubun = "OV" '해외주식(마켓구분 2자리)
					else
						szGubun = "KR"
					end if
				end if			
			End if
		else
			szGubun = "KR"
		end if 
		
		if szGubun == "OV" then
			
			'FID관심종목코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0, tCode[1])		
			
			'FID입력시장구분코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", 0, szMk) 'tCode[0] 그대로 사용
			
			'FID관심국가구분코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CNCN_GRP_NTNL_CLS_CODE", 0, szGubun) 
		else
			szMk   = Form.GetItemCodeInfo(g_szCode, "market")
			szMk   = Change_EtcMarket(szMk)	
			
			'FID관심종목코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0, g_szCode)		
			
			'FID입력시장구분코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", 0, szMk)
			
			'FID관심국가구분코드		
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CNCN_GRP_NTNL_CLS_CODE", 0, szGubun)
		end if 
		
		'FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock3", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGroupID)
		
		'FID 구분
		if rgTopButtom.currentindex == "0" then
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock4", "FID_CLS", 0, "T")
		else
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock4", "FID_CLS", 0, "B")
		end if 
				
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ohhts_intr_006r" Then  '  그룹조회
		grdGroup.selectrow = 0		
	     
	     '관심종목수 표기(빈칸포함)
		For i = 0 to grdGroup.rowcount-1
			szName = grdGroup.GetCellData("bd_name2",  i) & "(" & CInt(grdGroup.GetCellData("bd_count", i)) & ")"
			grdGroup.SetCellData("bd_name",  i, szName)
		Next	
		
		grdGroup_OnClickUp(0, "bd_name")
	
	ElseIf szTranID = "ohhts_intr_007r" Then '해당 그룹에 등록된 종목조회 
		if g_bInsertExcept <> true then
			Insert_GrdList() ' 미리 관심종목 추가하고 추가하기버튼 클릭후 저장
			
		else
			g_bInsertExcept = false 'ohhts_intr_102r TR 처리 후 이미 추가됨 
			
			'20240221 START
			Form.SendReturnToParent("GWAN_ADD_COMPLETE" , g_nIndex)
			
			Form.Toast(2, "[" &g_szGroupName & "] 그룹에 추가되었습니다.", true)
			Form.CloseForm()
			
		end if
		
	ElseIf szTranID = "ohhts_intr_008r" then '그룹추가

		Form.SetCtlProp("#edtChange", "caption", "1")	' 그룹변경을 알리기 위해..	

		grdList.rowcount = 0
		Insert_GrdList()
		
		
	ElseIf szTranID = "ohhts_intr_102r" Then '종목 등록 후 해당 그룹의 관심종목조회
	
		'종목추가는 이미 되었으니 제외
		g_bInsertExcept = true
		
		' 관심종목 종목 조회		
		DATAMANAGER.RequestTranData("ohhts_intr_007r")	
		
	End If
	
	'편집시 ID가 메인화면과 연동안되는부분 때문에 추가
	If szTranID == "ohhts_intr_006r" or szTranID == "ohhts_intr_008r" or szTranID == "ohhts_intr_009r" or szTranID == "ohhts_intr_102r" Then	
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) 		
	End if 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnSave_OnClick()
	nRow = Cint(grdList.rowcount)
	if nRow > 99 then
		Form.MsgBox(g_szTitle, "종목 추가는 최대 100개 까지만\n가능합니다.", 1)
	else
		InsertItem()
	end if 
End Sub

'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)
	if Cint(g_nChkRow) = -1 then	'그룹선택 1개만 가능
		g_nChkRow = lRow
		grdGroup.SetCellData("bd_mark", g_nChkRow, "1")	
	else
		grdGroup.SetCellData("bd_mark", g_nChkRow, "0")	
		g_nChkRow = lRow
		grdGroup.SetCellData("bd_mark", g_nChkRow, "1")	
	end if
	
	g_szRow = lRow
	g_szGroupID   = grdGroup.GetCellData( "bd_code", lRow )
	g_szGroupName = grdGroup.GetCellData( "bd_name2", lRow ) '관심종목수 제외
	
	grdList.rowcount = 0		
	
	'관심종목 종목 조회
	DATAMANAGER.RequestTranData("ohhts_intr_007r")	
		
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "GW_SET2" then
		
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
			
		
	' 그룹 추가
	elseif sKeyName == "GROUP_ADD" then	

		if sRet == "" then
			Exit Sub
		end if 
		
		tData = Split(sRet, "★")		
		
		' 관심그룹 맨 위 추가
		if tData(2) == "T" then  
			g_szRow = 0     		
		
		' 관심그룹 맨 아래 추가
		else
			g_szRow = grdGroup.rowcount	  		
		end if 

		grdGroup.SetCellData("bd_mark", g_nChkRow, "0")
		
		g_szGroupID = tData(0)
		g_szGroupName = tData(1)
		grdGroup.insertrow = g_szRow
		grdGroup.SetCellData("bd_count", g_szRow, 0)		
		grdGroup.SetCellData("bd_code", g_szRow, tData(0))
		grdGroup.SetCellData("bd_name", g_szRow, tData(1) & "(0)")  '관심종목수 포함
		grdGroup.SetCellData("bd_name2", g_szRow, tData(1))
		
		grdGroup.selectrow = g_szRow
		grdGroup.SetCellData("bd_mark", g_szRow, "1")
		g_nChkRow = g_szRow
		
		grdGroup.toprow = g_szRow

		'관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_008r")
	
	end if
	
End Sub


'============================================================================
'그룹추가 버튼 클릭시 팝업
'============================================================================
Sub btnAddgroup_OnClick()

	Dim szCode, szChk
	Dim nRow
	
	nRow = CInt(grdGroup.rowcount)-1

	if nRow == 199 then
		Form.ShowAlert(g_szTitle, "그룹 추가는 최대 200개 까지만\n 가능합니다.")
		Exit Sub
	end if
	
	' 관심그룹 명칭 초기 설정위해.. 코드로 정한다. 
	if nRow < 0 then
		szCode = "000"
	else
		
		'관심그룹 생성 시, 순차적으로 확인해서 코드 빠졌을 때 채워넣으면서 만든다.
		'그룹이 10개 이상인 경우에 szCd == szCode 처리 못해서 CStr 처리함.
		For i = 0 to 199
			if Len(i) == 1 then
				szCode = "00" & i
			elseif Len(i) == 2 then
				szCode = "0" & i
			else
				szCode = CStr(i)
			end if
			
			For j = 0 to nRow		
				szCd = grdGroup.GetCellData("bd_code", j)
				if szCd == szCode then					
					szChk = "0"
					Exit For
				else 
					szChk = "1"
				end if
			Next
			if szChk == "1" then
				Exit For
			end if	
		Next
		
	end if

	Form.OpenPopup("nrshidx50600_p3" , "GROUP_ADD★" & szCode & "★", "") '관심그룹추가
	
End Sub


'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

