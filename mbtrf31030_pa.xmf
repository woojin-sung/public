'============================================================================
' 화 면 명 : 선물옵션주문_미체결팝업
' 화면설명 : 선물옵션주문 정정/취소화면에서 미체결버튼 클릭시 오픈
' 작    성 : 2016.02.02 ~ 2016.  .       ssang
'============================================================================
' 20240412 HSZ 코스닥글로벌지수 추가 (KF)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_Tab


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	
	Form.SetScreenName("선물옵션미체결")	

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_Tab      = tData(2)

		DATAMANAGER.RequestTranData("obtrf_cntg_102r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szDate
	
	' ----------------------------------------------------------------------
	' 장내파생 계좌별 주문체결 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_cntg_102r" then
		grdList.rowcount = 0
		DATAMANAGER.ClearInputData(0, "obtrf_cntg_102r")
		szDate = Form.GetSharedData( "&HOST_DATE", false )
		
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "ACNO" 			, 0, g_szAcnt)	' 계좌번호
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)	' 계좌일련번호
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "IQRY_FIN_DATE"	, 0, szDate)		' 조회종료일자
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "IQRY_STA_DATE"	, 0, szDate)		' 조회시작일자
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "FTOP_TYPE_CODE" 	, 0, "0")		' 장내파생유형코드(0:전체, 1:선물, 2:콜옵션, 3:풋옵션)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "DEAL_CLS_CODE"	, 0, "%")		' 매매구분코드(0:전체, 1:매수, 2:매도)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "CNTG_FIN_CLS_CODE", 0, "2")		' 체결종료구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_102r", "InBlock1", "SORT_SEQ"		, 0, "2") 		' 정렬순서(2:역순, 1:주문순)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData

	' ----------------------------------------------------------------------
	' 장내파생 계좌별 주문체결 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_cntg_102r" then
		For i = 0 To grdList.rowcount - 1
			'매매구분
			szData = grdList.GetCellData( "bd_Gbn", i)
			Select Case szData
				Case "1" grdList.SetCellData("bd_GbnNm", i, "매도")
						grdList.SetCellFgColor("bd_GbnNm", i, "11")
				Case "2" grdList.SetCellData("bd_GbnNm", i, "매수")
						grdList.SetCellFgColor("bd_GbnNm", i, "10")
				Case "3" grdList.SetCellData("bd_GbnNm", i, "매수청산")
				Case "4" grdList.SetCellData("bd_GbnNm", i, "매도청산")
				Case "5" grdList.SetCellData("bd_GbnNm", i, "권리행사")
				Case "6" grdList.SetCellData("bd_GbnNm", i, "의무배정")
				Case "7" grdList.SetCellData("bd_GbnNm", i, "행사포기")
				Case "8" grdList.SetCellData("bd_GbnNm", i, "의무면제")
				Case "A" grdList.SetCellData("bd_GbnNm", i, "인수대금")
				Case "B" grdList.SetCellData("bd_GbnNm", i, "인도대금")
				Case "C" grdList.SetCellData("bd_GbnNm", i, "단주행사")
				Case "D" grdList.SetCellData("bd_GbnNm", i, "단주배정")
				Case "0" grdList.SetCellData("bd_GbnNm", i, "상계")
			End Select
			
			'주문유형
			szData = grdList.GetCellData( "bd_Type", i)
			Select Case szData
				Case "1" grdList.SetCellData("bd_TypeNm", i, "시장가")
				Case "2" grdList.SetCellData("bd_TypeNm", i, "지정가")
				Case "3" grdList.SetCellData("bd_TypeNm", i, "경쟁대량(현물만 해당)")
				Case "I" grdList.SetCellData("bd_TypeNm", i, "조건부지정가")
				Case "X" grdList.SetCellData("bd_TypeNm", i, "최유리 지정가")
				Case "Y" grdList.SetCellData("bd_TypeNm", i, "최우선 지정가")
				Case "T" grdList.SetCellData("bd_TypeNm", i, "시장가(실시간 가격제한)")
				Case "W" grdList.SetCellData("bd_TypeNm", i, "최유리지정가(실시간 가격제한)")
				Case "J" grdList.SetCellData("bd_TypeNm", i, "지정가 전환")		
			End Select
		Next
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szData
	
	if lRow > -1 then
		szCd      = grdList.GetCellData("bd_Cd",       lRow)
		szCd = Mid(szCd, 2, Len(szCd))
		
		szMk = Form.GetItemCodeInfo(szCd, "market")
		
		' 지수선물/미니선물/옵션/미니옵션만 가능
		' 주식선물옵션도 가능하도록 추가(JF/JO) 2017.12.13
		'20180320 LES START - KRX300선물/코스닥150옵션 추가 (기존 미니선물이 포함되어있지 않아 미니선물도 추가)
		'20220915 LES START 상품선물 추가
		'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
		if Trim(szMk) == "CF" or Trim(szMk) == "FF" or Trim(szMk) == "F" or Trim(szMk) == "O" or Trim(szMk) == "MF" or Trim(szMk) == "MO" or Trim(szMk) == "JF" or Trim(szMk) == "JO" or Trim(szMk) == "XF" or Trim(szMk) == "KF" or Trim(szMk) == "QO" or Trim(szMk) == "WO" then	' 20190809_01 HWG : 위클리옵션추가		
			szQty     = grdList.GetCellData("bd_MicheQty", lRow)
			szOdrNo   = grdList.GetCellData("bd_OdrNo",    lRow)	
			szOdrType = grdList.GetCellData("bd_Type",     lRow)
			szOdrPrc  = grdList.GetCellData("bd_OdrPrc",   lRow)
			szClsCd   = grdList.GetCellData("bd_ClsCd",    lRow)
			
			' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
			szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
			
			Form.SendReturnToParent("31030_CONTRACT", szData)
			Form.CloseForm()
		else
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		end if
	end if	
End Sub

