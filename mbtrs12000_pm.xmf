	<SCRIPT_INFO _len="4438" _ulen="4084" >
Dim g_tData

'============================================================================
Sub Form_OnFormInit()
	Label0.setNeighbolCtlPos("imgInfo","right",0,"")
	
	Dim tData
	Dim szData
	szData = Form.GetOpenLinkData()

	if szData <> "" then
		tData = Split(szData, "★")
	
		if UBound(tData) > 0 then
			g_tData = tData
			
			lblQty.caption = g_tData(4)
			Dim szType
			szType = g_tData(7)
			
			if g_tData(4) == "0" then'수량이 0이면
				lblFee.caption = "원"
				lblTax.caption = "원"
				lblLastPrc.caption = "원"
			end if
			
			Select Case szType
				Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
					lblPrc.caption = "-원"
					lblOrderPrc.caption = "원"
					lblOrderPrc0.caption = "원"
					lblFee.caption = "원"
					lblTax.caption = "원"
					lblLastPrc.caption = "원"
				Case else
					lblPrc.caption = FormatNumber(g_tData(5),0).."원"
					lblOrderPrc.caption = FormatNumber(CInt(g_tData(4)) * CInt(g_tData(5)),0).."원"
					lblOrderPrc0.caption = FormatNumber(CInt(g_tData(4)) * CInt(g_tData(5)),0).."원"
					RequestData()
			End Select
		end if
	end if
End Sub

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	
	DATAMANAGER.ClearInputData(0, "obtrf_cntg_335r")
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "ACNO"             , 0, g_tData(0))	' 계좌번호
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "ASNO"             , 0, g_tData(1))	' 계좌일련번호
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "IQRY_CLS_CODE"    , 0, "1")			' 조회구분코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "FEE_MDIA_GRP_CODE", 0, "020")		' 수수료매체그룹코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "MKPL_CLS_CODE"    , 0, g_tData(2))	' 매매시장구분코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "DEAL_CLS_CODE"    , 0, g_tData(3))	' 매매구분코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "ODQT"             , 0, g_tData(4))	' 주문수량
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "FTOP_ODER_UNPR"   , 0, g_tData(5))	' 주문단가
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_335r", "InBlock1", "ISCD"             , 0, g_tData(6))	' 종목코드
			
	DATAMANAGER.RequestTranData("obtrf_cntg_335r")
End Function

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgInfo_OnClick()
	imgInfo.openToolTip("수량, 단가를 모두 입력한 경우만 조회되며, 주문화면에서는 제비용(수수료/세금)이 제외되어 조회돼요.",315,80,2)
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if "obtrf_cntg_335r" == szTranID then
		Dim szDEAL_FEE_AMT, szWTAX_AMT, szEXCL_AMT
		szDEAL_FEE_AMT = DATAMANAGER.GetDataValue( false, "obtrf_cntg_335r", "OutBlock1", "DEAL_FEE_AMT", 0)
		szWTAX_AMT = DATAMANAGER.GetDataValue( false, "obtrf_cntg_335r", "OutBlock1", "WTAX_AMT", 0)
		szEXCL_AMT = DATAMANAGER.GetDataValue( false, "obtrf_cntg_335r", "OutBlock1", "EXCL_AMT", 0)
		
		if szDEAL_FEE_AMT == "" then
			szDEAL_FEE_AMT = "0"
		end if
		if szWTAX_AMT == "" then
			szWTAX_AMT = "0"
		end if
		if szEXCL_AMT == "" then
			szEXCL_AMT = "0"
		end if
		
		lblFee.caption = FormatNumber(szDEAL_FEE_AMT,0).."원"
		lblTax.caption = FormatNumber(szWTAX_AMT,0).."원"
		lblLastPrc.caption = FormatNumber(szEXCL_AMT,0).."원"
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	imgInfo0.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub imgInfo0_OnClick()
	imgInfo0.openToolTip("종목별 합산되어 정산되므로, 최종 정산금액은 현재 조회되는 금액과 상이 할 수 있어요.",315,80,2)
End Sub

