'============================================================================
' Form_OnFormInit() 
'============================================================================
Sub Form_OnFormInit()
	Form.triggerEvent("fmtabChange." & fmtabChange.currenttabpageid, "changeTab", szState)
End Sub

'============================================================================
' fmtabChange_OnTabChanged(nCurrentTab) : 탭 변경 이벤트 트리거
'============================================================================
Sub fmtabChange_OnTabChanged(nCurrentTab)
	Form.triggerEvent("fmtabChange." & fmtabChange.currenttabpageid, "changeTab", szState)
End Sub


