'============================================================================
' 01.화면명 	: 다른 금융기관 이체결과 조회
' 02.화면설명	: 다른 금융기관 이체결과 조회
' 03.작성	: 2020.11.03. 장원혁
'============================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
'============================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szUserID   '사용자ID     v001
Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
Dim g_recv_data  '수신데이터   v001
'============================================================================

Sub Form_OnFormInit()

    RadioGroup.currentindex = 0
    
'    DATAMANAGER.SetDataValue(0, "obtss_opnf_008r" , "InBlock1" , "PROS_CLS_CODE"      , 0 , "1") ' 1 : 전체 (출금미동의 포함)
'    DATAMANAGER.SetDataValue(0, "obtss_opnf_008r" , "InBlock1" , "ELFN_ID"            , 0 , Form.GetSharedData("&USER_ID", false )) 
'    'DATAMANAGER.SetDataValue(0, "obtss_opnf_008r" , "InBlock1" , "SNMS_YN"            , 0 , "Y")
'    DATAMANAGER.RequestTranData("obtss_opnf_008r")   
        
	'v001
	g_szUserID = Form.GetSharedData("&USER_ID", false )
    
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false)	 = "Y" THEN
	    DATAMANAGER.RequestTranData( "obtss_opnf_008r" ) '오픈뱅킹_타행계좌내역조회
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
End Sub


'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtss_opnf_008r" then	'오픈뱅킹_타행계좌내역조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE"     , 0 , "1" ) ' 1 : 전체 (출금미동의 포함)
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID"           , 0 , g_szUserID) 'acno랑 둘중하나만
		'DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN"           , 0 , "N") 
	end if
	
	'v001
	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
	end if
	
     'v001
	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obtss_opnf_008r" Then
    
        For i = 0 To DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock1") - 1 
            BANK_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_CODE" , i)
            BANK_NAME = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_NAME" , i)
            BANK_ACNO = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_ACNO" , i)
	    
            Form.SetCtlProp("CmbOtcoAcnt","cbadddatatext", BANK_NAME &" " & BANK_ACNO)
            Form.SetCtlProp("CmbBankCode","cbadddatatext", BANK_CODE)
            Form.SetCtlProp("CmbBankAcnt","cbadddatatext", BANK_ACNO)
	    
        Next
        
        If DATAMANAGER.IsMoreNextData(szTranID) = True Then
            DATAMANAGER.RequestNextData("obtss_opnf_008r")
        Else
	
            Dim linkData
            Dim szData
            linkData = Form.GetOpenLinkData()
	    
            szData = Split(linkData, "★")
            If UBOUND(szData) >= 1 then
                CmbOtcoAcnt.caption = szData(3) & " " & szData(2)
                CmbBankCode.caption = szData(1)
                CmbBankAcnt.caption = szData(2)
            End If
	    
            Iqry_Process()
        End If
	elseif szTranID == "obtss_opnf_047r" then	'v001
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부

	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
	    
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If
	    
	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
        '다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then
			
			Form_Enable(False)
		Else
		
		    DATAMANAGER.RequestTranData( "obtss_opnf_008r" )
	    End If
	elseif szTranID == "obtss_opnf_048a" then	'v001
	
		DATAMANAGER.RequestTranData( "obtss_opnf_008r" )	
    End If
    
    If szTranID = "obtss_opnf_023r" Then
	    
	     szCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_023r", "OutBlock1")
			
		for i = 0 to szCount
			szAcnm = TRIM(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_NAME" , i)) & " " & TRIM(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MNRC_BANK_ACNO" , i)) 
		
			Grid0.SetCellData("bd_acnm", i, szAcnm)
			
		next
    
        If DATAMANAGER.IsMoreNextData(szTranID) = True Then
            DATAMANAGER.RequestNextData(szTranID)
        End If
	
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID = "obtss_opnf_008r" Then 
	
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("약정계좌 조회 오류" , szErrMsg , "", 6)	
        Else
            Form.MsgBox("약정계좌 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If
	
	End If
	
	If szTranID = "obtss_opnf_023r" Then 
	
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("이체결과 조회 오류" , szErrMsg , "", 6)	
        Else
            Form.MsgBox("이체결과 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If
	
	End If
	
End Sub

'============================================================================
Sub CmbOtcoAcnt_OnEditComplete(iIndex)
	CmbBankCode.currentindex = iIndex
	CmbBankAcnt.currentindex = iIndex
	Grid0.rowcount = 0
	Iqry_Process()	
End Sub


'============================================================================
Sub CmbPeriod_OnEditComplete(iIndex)

    If iIndex = 0 Or iIndex = "0" Then '오늘
        ClnFinDate.caption = Today.caption
        ClnStaDate.caption = Today.caption
    ElseIf iIndex = 1 Or iIndex = "1" Then '1주일
        ClnFinDate.caption = Today.caption
        ClnStaDate.caption = Today.caption
        Form.SetCtlProp("ClnStaDate", "addday", -7)
    ElseIf iIndex = 2 Or iIndex = "2" Then '1개월
        ClnFinDate.caption = Today.caption
        ClnStaDate.caption = Today.caption
    
        If ClnStaDate.calmonth = "1" Or ClnStaDate.calmonth = 1 Then '1월
            Form.SetCtlProp("ClnStaDate", "addday", -31)
        ElseIf ClnStaDate.calmonth = "2" Or ClnStaDate.calmonth = 2 Then '2월
            If (CDBL(ClnStaDate.calyear) % 4 = 0 And CDBL(ClnStaDate.calyear) % 100 <> 0) OR (CDBL(ClnStaDate.calyear) % 400 = 0) Then '윤년
                Form.SetCtlProp("ClnStaDate", "addday", -29)
            Else
                Form.SetCtlProp("ClnStaDate", "addday", -28)
            End If
        ElseIf ClnStaDate.calmonth = "3" Or ClnStaDate.calmonth = 3 Then '3월
            Form.SetCtlProp("ClnStaDate", "addday", -31)
        ElseIf ClnStaDate.calmonth = "4" Or ClnStaDate.calmonth = 4 Then '4월
            Form.SetCtlProp("ClnStaDate", "addday", -30)
        ElseIf ClnStaDate.calmonth = "5" Or ClnStaDate.calmonth = 5 Then '5월
            Form.SetCtlProp("ClnStaDate", "addday", -31)
        ElseIf ClnStaDate.calmonth = "6" Or ClnStaDate.calmonth = 6 Then '6월
            Form.SetCtlProp("ClnStaDate", "addday", -30)
        ElseIf ClnStaDate.calmonth = "7" Or ClnStaDate.calmonth = 7 Then '7월
            Form.SetCtlProp("ClnStaDate", "addday", -31)    
        ElseIf ClnStaDate.calmonth = "8" Or ClnStaDate.calmonth = 8 Then '8월
            Form.SetCtlProp("ClnStaDate", "addday", -31)
        ElseIf ClnStaDate.calmonth = "9" Or ClnStaDate.calmonth = 9 Then '9월
            Form.SetCtlProp("ClnStaDate", "addday", -30)
        ElseIf ClnStaDate.calmonth = "10" Or ClnStaDate.calmonth = 10 Then '10월
            Form.SetCtlProp("ClnStaDate", "addday", -31)
        ElseIf ClnStaDate.calmonth = "11" Or ClnStaDate.calmonth = 11 Then '11월
            Form.SetCtlProp("ClnStaDate", "addday", -30)
        ElseIf ClnStaDate.calmonth = "12" Or ClnStaDate.calmonth = 12 Then '12월
            Form.SetCtlProp("ClnStaDate", "addday", -31)
        End If
    End If
    
    Iqry_Process()
    
End Sub

'============================================================================
Sub ClnStaDate_OnEditComplete()
	Iqry_Process()
End Sub

'============================================================================
Sub ClnFinDate_OnEditComplete()
	Iqry_Process()
End Sub

'============================================================================
Sub RadioGroup_OnClick(nIndex)
	Iqry_Process()
End Sub

'============================================================================
Sub BtnRefresh_OnClick()
	Iqry_Process()
End Sub

'============================================================================
Sub Iqry_Process()

    If RadioGroup.currentindex = 0 Or RadioGroup.currentindex = "0" Then
        SORT_CLS_CODE = "D" 'descending 
    ElseIf RadioGroup.currentindex = 1 Or RadioGroup.currentindex = "1" Then
        SORT_CLS_CODE = "A" 'ascending
    Else
        Exit Sub
    End If

    DATAMANAGER.SetDataValue(0 , "obtss_opnf_023r" , "InBlock1" , "ELFN_ID"           , 0 , Form.GetSharedData("&USER_ID", false ))
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_023r" , "InBlock1" , "IQRY_STA_DATE"     , 0 , ClnStaDate.caption)
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_023r" , "InBlock1" , "IQRY_FIN_DATE"     , 0 , ClnFinDate.caption)
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_023r" , "InBlock1" , "OPN_SORT_CLS_CODE" , 0 , SORT_CLS_CODE)
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_023r" , "InBlock1" , "BANK_CODE"         , 0 , CmbBankCode.caption)
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_023r" , "InBlock1" , "BANK_ACNO"         , 0 , CmbBankAcnt.caption)
    DATAMANAGER.RequestTranData("obtss_opnf_023r")
   
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	If szCellID = "bd_cell1" Then
	    RSLT_MSG = TRIM(Grid0.GetCellData(szCellID, lRow))
	    If RSLT_MSG <> "정상" Then
	        ErrMsg = Grid0.GetCellData("bd_cell8", lRow)
	        Form.MsgBox("알림" , ErrMsg , "", 6)	
	    End If
	End If
End Sub



'v001
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "mbbnk62000_p1" then
	     
		If sRet == "Y" then 'Y:재동의 N:취소
		
			Form_Enable(True)
			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
			
				Form_Enable(True)
				
				DATAMANAGER.RequestTranData( "obtss_opnf_008r" )
			Else
			
				Form_Enable(False)
			End If
		End If
	End If
     
End Sub


'v001
'============================================================================
' Form_Enable
'============================================================================
Function Form_Enable(EnableYn)
    if EnableYn = True then
    
		CmbOtcoAcnt.enable   = True	'계좌
		BtnRefresh.enable    = True	'계좌 조회
		ClnStaDate.enable    = True	'조회시작일자
		ClnFinDate.enable    = True	'조회종료일자
		CmbPeriod.enable     = True	'일자구분
		RadioGroup.enable    = True	'조회구분
		Grid0enable          = True	'그리드
				
    elseif EnableYn = False then
    
		CmbOtcoAcnt.enable   = False	'계좌
		BtnRefresh.enable    = False	'계좌 조회
		ClnStaDate.enable    = False	'조회시작일자
		ClnFinDate.enable    = False	'조회종료일자
		CmbPeriod.enable     = False	'일자구분
		RadioGroup.enable    = False	'조회구분
		Grid0enable          = False	'그리드
    end if
End Function

