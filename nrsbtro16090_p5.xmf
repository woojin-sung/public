	<SCRIPT_INFO _len="3228" _ulen="3058" >
'============================================================================
' 화 면 명 : 실시간시세 신청내역_기간
' 화면설명 : 실시간시세 신청내역의 기간선택 팝업창
' 작    성 : 2024.04.24 
'============================================================================

Dim g_szDate
g_szDate = "%"

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
'msgbox 	szData	
	if szData <> "" then
		cldFromDate.caption = Left(szData, 8)
		cldToDate.caption = MID(szData, 9, 8)
		RgDateType.currentindex = CInt(Right(szData, 1))
	else		
	end if

End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("DATE_SET", cldFromDate.caption & " ~ " & cldToDate.caption)
End Sub

'============================================================================
Sub RgDateType_OnClick(nIndex)
	if nIndex == 0 then      '당일
		cldFromDate.enable = "0"
		cldToDate.enable = "0"
		cldFromDate.caption = Left(Form.calcDateTime( nYear, nMonth, 0, nHour, nMinute, nSecond ), 8)		
		cldToDate.caption = Left(Form.calcDateTime( nYear,nMonth, nDay, nHour, nMinute, nSecond ), 8)		
	elseif nIndex == 1 then  '1주일
		cldFromDate.enable = "0"
		cldToDate.enable = "0"
		cldFromDate.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)		
		cldToDate.caption = Left(Form.calcDateTime( nYear,nMonth, nDay, nHour, nMinute, nSecond ), 8)		
	elseif nIndex == 2 then  '1개월
		cldFromDate.enable = "0"
		cldToDate.enable = "0"
		cldFromDate.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)		
		cldToDate.caption = Left(Form.calcDateTime( nYear,nMonth, nDay, nHour, nMinute, nSecond ), 8)		
	elseif nIndex == 3 then  '직접입력
		cldFromDate.enable = "1"		
		cldToDate.enable = "1"		
	end if

End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
'	if  CInt(cldFromDate.caption) > CInt(cldToDate.caption) then
'msgbox "종료날짜가 시작날짜보도 과거입니다."			
'	end if 
	'매매유형선택 알림
	Form.SendReturnToParent("DATE_SET", cldFromDate.caption & cldToDate.caption & RgDateType.currentindex)
	Form.CloseForm()	
End Sub

'============================================================================
Sub cldFromDate_OnEditComplete()
	'RgDateType.currentindex = 2
	if CDbl(cldFromDate.caption) > CDbl(cldToDate.caption ) then
		Form.ShowAlert("알림", "종료일이 시작일 이전입니다.")	
		btnSave.enable = false
	else
		btnSave.enable = true
	end if 
End Sub

'============================================================================
Sub cldToDate_OnEditComplete()
	'RgDateType.currentindex = 2
	cldFromDate_OnEditComplete()
End Sub

	</SCRIPT_INFO>
</ROOT>