		<IMAGE name="imgBG" autosize="1" imgpath="popup_bg.9" ly_vert="0,472,375,284,1" />
		<BUTTON name="btnSave" caption="확인" fontsize="1" btnimage="btn_20.9" ly_vert="0,696,377,60,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="선택해 주세요." bgcolor="092:185046046" halign="1" ly_vert="0,473,375,70,1" />
		<RADIOGROUP name="RgDateType" fontsize="-2" buttonshape="1" buttonsnumber="4" ly_vert="20,567,337,44,1" >
			<RADIO_INFO>
				<RADIO no="0" text="당일" radioimage="input_06.9.png" transfervalue="01" position="0,0,80,44" />
				<RADIO no="1" text="1주일" radioimage="input_06.9.png" transfervalue="02" position="84,0,80,44" />
				<RADIO no="2" text="1개월" radioimage="input_06.9.png" transfervalue="03" position="168,0,80,44" />
				<RADIO no="3" text="직접입력" radioimage="input_06.9.png" transfervalue="04" position="252,0,81,44" />
			</RADIO_INFO>
