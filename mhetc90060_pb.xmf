'============================================================================
Sub Table3_OnClick(lRow , lColumn)
	
	'모파일OTP 발급
	if lRow == 4 then
		Dim Meritz_OTP_RCNOPIP
		Form.SetSharedData( "mOTP_IntoClcd"	, "MTS" )
		Meritz_OTP_RCNOPIP = Form.GetSharedData("Meritz_OTP_RCNOPIP", false)
		
		'20230803 SWJ START : 쉐어드 변수 초기화 후, 다음 스텝으로 갈 때 변수 재설정 해준다
		if g_sl_ms <> "" then
			Form.SetSharedData("MeritzAuth_Security", g_sl_ms)
		end if
		
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity", "Y")
		end if
		'20230803 SWJ END
		
		Form.SetSharedData("BDM_RCNO_PIP", Meritz_OTP_RCNOPIP)

		Form.OpenNextPopup("mbotp86100", "", "")
	end if
	
End Sub

