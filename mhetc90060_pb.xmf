	<SCRIPT_INFO _len="28348" _ulen="24484" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_일반/스마트OTP
' 03. 작    성 : 2016.01.13 김보라
' 04. 수    정 : 2018.04.02 윤유정 : TZ OTP 도입에 따른 화면 문구수정 v0001
'			   2019.12.18 김유경 : TZ OTP 서비스 종료에 따른 화면 문구수정 ( 스마트/TZ OTP -> 스마트 OTP )
' 2020.09.16 : 정민영 : v0003 : [T2008250015] 메모리취약점 보완
' 2020.11.19 : 정민영 : v0004 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_520r,522a,523a IO 변경분 반영
' 2020.12.15 : 성우진 : v0004 : [T2010080018] 인증서 발급/등록 프로세스 변경(개인고객의 경우 보안인증 과정없이 인증서 발급 가능한 프로세스 추가)
' 2021.05.27 : 정민영 : v0005 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
' 2023.06.09 : 전상일 : v0006 : 인증서 보안카드 사설인증 추가
' 2023.11.07 : 양현정 : v0007 : obcsb_efif_060a 없는 io매핑삭제
' 2023.12.21 : 전상일 : v0008 : ID 등록 시 주문내역 존재 체크 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID, g_nOTPCnt, g_sSmartYN '사용자ID, OTP인증처리횟수, SmartOTP여부값

'-------------------------------------------------------
Dim g_sSendData	'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList		'g_sSendData Split Array
Dim g_nLinkGubn	'1:지점개설계좌ID등록 화면에서 팝업, 2:ID비밀번호재설정 화면에서 팝업, 0:그외 화면에서 팝업, 9:타기관OTP등록화면에서 팝업 
Dim g_plain_rm  	'v0003 메모리평문적용여부

'지점개설계좌ID등록 화면에서 팝업한 경우(g_nLinkGubn = 1)
'g_szList(0)  : "은행" / "지점" / "지점/모바일" '20160610 추가
'g_szList(1)  : [은행만 사용] 개인정보필수동의_수집/이용
'g_szList(2)  : [은행만 사용] 개인정보필수동의_조회
'g_szList(3)  : [은행만 사용] 개인정보필수동의_업무위탁
'g_szList(4)  : [은행만 사용] 개인정보필수동의_제공
'g_szList(5)  : [은행만 사용] 개인정보필수동의_고유식별정보의 처리
'g_szList(6)  : [은행만 사용] 개인정보필수동의_민감정보의 처리
'g_szList(7)  : [은행/지점 공통] 필수정보입력_고객구분("1":내국인/"2":외국인/"3":법인)
'g_szList(8)  : [은행/지점 공통] 필수정보입력_고객식별번호
'g_szList(9)  : [은행/지점 공통] 필수정보입력_계좌번호
'g_szList(10) : [은행/지점 공통] 필수정보입력_계좌비밀번호
'v0003 => MTS메모리평문 적용/미적용 상관없이 암호화된 정보로 넘어와야함(연계화면 변동시 확인필수!)
'g_szList(11) : [은행/지점 공통] 필수정보입력_사용자ID
'g_szList(12) : [은행/지점 공통] 필수정보입력_ID비밀번호
'v0003 => MTS메모리평문 적용/미적용 상관없이 암호화된 정보로 넘어와야함(연계화면 변동시 확인필수!)
'g_szList(13) : [지점만 사용] 보안매체종류("0":보안카드/"3":OTP)

'ID비밀번호재설정 화면에서 팝업(g_nLinkGubn = 2)
'g_szList(0) : "ChangePswd"
'g_szList(1) : 사용자ID
'g_szList(2) : 계좌번호
'g_szList(3) : 신규비밀번호

'타기관OTP등록화면에서 팝업(g_nLinkGubn = 9)
'g_szList(0) : "MeritzOTP"
'g_szList(1) :  계좌번호

'20161115 NOHES START 금융결제원 스마트OTP
Dim g_szBSWR_CLCD 
Dim g_szTRAN_CRPT
Dim g_szDTL_CNTT
Dim g_RszBSWR_CLCD		'스마트OTP 리턴받은 데이터
Dim g_szChk
Dim g_szSMARTOTP							'obcsb_oimf_520r  SMART OTP 여부
Dim g_rcnoPip
'20161115 NOHES END

'20230803 SWJ START
Dim g_sl_ms
Dim g_sSecurity
g_sl_ms = ""
g_sSecurity = ""
'20230803 SWJ END

Dim g_IDRegAcno
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	EditInput1.certname = "OTP번호 입력"
	EditPin.certname = "PIN번호 입력"
	Form.SetScreenName( "보안매체 인증" )
	BtnRetry.caption = "데이터통신 장애 등 비상시 스마트 OTP 수동 입력 >"
	BtnApp.caption = "    스마트OTP 공동앱 설치 >"
	
	g_sSmartYN = "N"
	g_nOTPCnt = 0
	g_sRetData = "cancel"

	g_nLinkGubn = 0
	g_szBSWR_CLCD = "1"	'20161115 NOHES 금결원 smartOTP
	
	'v0003 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	if g_plain_rm == "1" then
	     '화면 마스킹표시/평문데이터로 설정(컨트롤속성-일반비밀번호사용 적용필수)
		EditInput1.SetEncExcept()
	end if 

	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")		

	g_szChk = "1"
	'그외 화면에서 팝업시
	if UBOUND(g_szList) < 1 then	
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		if g_sUserID ~= null and g_sUserID ~= "" then
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		end if
		
	else
		'ID비밀번호 재설정 화면에서 팝업시
		if g_szList(0) == "ChangePswd" then
			g_nLinkGubn = 2
			g_sUserID = g_szList(1)
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		'사설인증등록 화면에서 팝업시
		elseif g_szList(0) == "MeritzAuth" then
			g_nLinkGubn = 3
			g_rcnoPip = Form.GetSharedData("Meritz_OTP_RCNOPIP",false)
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		'타기관OTP등록 화면에서 팝업시
		elseif g_szList(0) == "MeritzOTP" then
			g_nLinkGubn = 9
			g_IDRegAcno = g_szList(1)
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회		
		'지점개설계좌ID 화면에서 팝업시
		else
			g_nLinkGubn = 1
			'20160610 NOHES 팝업창이름 변경
			Form.SetScreenName( g_szList(0).."개설계좌 ID등록")
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		end if
	End if

	' 20230613 MOTP / OTP 분기처리 START ----------------------------------------
	Dim l_ms
	l_ms = Form.GetSharedData("MeritzAuth_Security", true)		'20230803 SWJ START(true로 바꿈)
	g_sSecurity = Form.GetSharedData("CommonNoSecurity", true )	'20230803 SWJ START(간편인증 외 타 업무화면 구분 용도)		
	szCONO    = Form.GetSharedData("&LOGIN_CUST_CLS_CODE", false) '1: 개인, 2: 법인
	
	'if l_ms == "MOTP" or l_ms == "OTP" or g_szList(0) == "MeritzAuth" or g_szList(0) == "MeritzOTP" then '20240320 타기관OTP등록 화면에서 팝업시 "MeritzOTP" 추가
	if (szCONO <> "2") and (l_ms == "MOTP" or l_ms == "OTP" or g_szList(0) == "MeritzAuth" or g_szList(0) == "MeritzOTP") then '20240320 타기관OTP등록 화면에서 팝업시 "MeritzOTP" 추가, 법인이 아닐 경우
		Table3.SetCellString(4, 0, "모바일OTP 발급 >")
		Table3.visible = True
		Label2.visible = False
		Label5.visible = False
		Label7.visible = False
		Label6.visible = False
		ButtonPhone.visible = False
		ButtonPhone.enable = False
		g_sl_ms = l_ms									'20230803 SWJ START(쉐어드세팅 위해 글로별 변수에 담기)
	else
		'20201215 SWJ START : 개인고객은 라벨 및 버튼이 추가되는 화면으로 변경(휴대폰 본인인증)
		szBtnAble = Form.GetOpenLinkData()
		
		if szBtnAble == "individual_check" then
			Label7.visible = True
			Label6.visible = True
			ButtonPhone.visible = True
			ButtonPhone.enable = True
		else
			Label7.visible = False
			Label6.visible = False
			ButtonPhone.visible = False
			ButtonPhone.enable = False
		end if
		'20201215 SWJ END
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p5" then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		if g_nLinkGubn == 1 then		'지점개설계좌ID 화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO" , 0 , g_szList(9) )
		elseif g_nLinkGubn == 3 then	'사설인증화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "2" ) 'rcno_pip
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP" , 0 , g_rcnoPip )
		elseif g_nLinkGubn == 9 then	 '타기관OTP등록화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO" , 0 , g_IDRegAcno )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) 	'전자금융ID
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		end if
	end if
	
	if szTranID == "obcsb_oimf_522a" then
		if g_nLinkGubn == 1 then		'지점개설계좌ID 화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ACNO" , 0 , g_szList(9) )
		elseif g_nLinkGubn == 3 then	'사설인증화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "INPUT_CLS" , 0 , "1" ) 'rcno_pip
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "RCNO_PIP" , 0 , g_rcnoPip )
		elseif g_nLinkGubn == 9 then	 '타기관OTP등록화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ACNO" , 0 , g_IDRegAcno )				
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "INPUT_CLS" , 0 , "2" ) 	'전자금융ID
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		end if
		
		'v0003 값은 평문으로 전송(인증번호는 암호화없이 전문전송)
		'MTS메모리평문적용(g_plain_rm == "1")시에는 OnFormInit()에서 평문데이터로 설정하므로 caption으로 전송가능
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "OTP_RSPN_VAL" , 0 , EditInput1.caption )
		if g_nOTPCnt == 0 then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRNM_RSLT_YN" , 0 , "N" )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRNM_RSLT_YN" , 0 , "Y" )
		end if
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "OTP_TLMS_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "STND_DATE" , 0 , LabelDATE.caption )
		'20161115 NOHES START 금결원 SmartOTP도입
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_522a" , "InBlock1" , "ATHN_BSWR_CLCD" , 0 , g_szBSWR_CLCD)
		if g_szBSWR_CLCD == "2" then
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_522a" , "InBlock1" , "TRAN_CRPT" , 0 , g_szTRAN_CRPT)
		end if
		'20161115 NOHES END
		
	end if
	
	if szTranID == "obcsb_oimf_523a" then
		if g_nLinkGubn == 1 then		'지점개설계좌ID 화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "3" )	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ACNO" , 0 , g_szList(9) )
		elseif g_nLinkGubn == 3 then	'사설인증화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "1" ) 'rcno_pip
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "RCNO_PIP" , 0 , g_rcnoPip )
		elseif g_nLinkGubn == 9 then	 '타기관OTP등록화면에서 팝업시
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ACNO" , 0 , g_IDRegAcno )			
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "2" )	'전자금융ID
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		end if			
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , g_sSmartYN )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "OTP_TLMS_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "STND_DATE" , 0 , LabelDATE.caption )
		
		'20161115 NOHES START 금결원 SmartOTP도입
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_523a" , "InBlock1" , "ATHN_BSWR_CLCD" , 0 , g_szBSWR_CLCD)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_523a" , "InBlock1" , "TR_DTL_CNTT" , 0 , g_szDTL_CNTT)
		'20161115 NOHES END
	end if
	
	'ID등록요청
	if szTranID == "obcsb_efif_060a" then	
		DATAMANAGER.SetUserID("meritz")		'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(9) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(10) )
		'v0007 DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" , 0 , g_szList(8) )  'v0004 RCNO->RCNO_PIP mhetc90020_p5에서 암호화된정보로 넘어옴
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" , 0 , g_szList(7) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(11) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" , 0 , g_szList(12) )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		'SMART OTP 여부		 Y: smart OTP 
		g_szSMARTOTP = DATAMANAGER.GetDataValue(0, "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0 )
		
		
		if sRSLT_CLS == "3" then 'OTP
			if sSCRC_STAT_CODE == "0" then '정상
				ButtonOK.enable = true
				
				'20161115 NOHES START 스마트OTP 연동 데이터
				if g_szSMARTOTP == "Y" Then
					g_RszBSWR_CLCD = Form.GetSharedData("SOTP_ATHN_BSWR_CLCD", 1 )
					
					if g_RszBSWR_CLCD == "2" then
						g_szBSWR_CLCD = "2"
						g_szDTL_CNTT = Form.GetSharedData("SOTP_TR_DTL_CNTT",1 )
					end if
				else
					g_RszBSWR_CLCD = "1"
					g_szBSWR_CLCD = "1"
					g_szDTL_CNTT = ""
				end if
				
				'20161115 NOHES END
			
				DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) '일반/스마트OTP여부조회
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
	elseif szTranID == "obcsb_oimf_523a" then
		Dim sUI_SMRT_OTP_YN, sPROS_YN, sOTP_TLMS_SRNO, sSTND_DATE, sPIN_NO
		
		'N:스마트OTP아님 Y:스마트OTP
		sUI_SMRT_OTP_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "UI_SMRT_OTP_YN" , 0 )
		'N:전문미수신/전문수신완료
		sPROS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "PROS_YN" , 0 ) 
		sOTP_TLMS_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "OTP_TLMS_SRNO" , 0 ) 
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "STND_DATE" , 0 ) 
		sPIN_NO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "PIN_NO" , 0 ) 

		if Len(Trim(sOTP_TLMS_SRNO)) > 7 then '전문일련번호
			LabelSRNO.caption = sOTP_TLMS_SRNO
		end if
	
		if Len(Trim(sSTND_DATE)) == 8 then '기준일자
			LabelDATE.caption = sSTND_DATE
		end if
			
		if sUI_SMRT_OTP_YN == "Y" and sPROS_YN == "N" then '스마트OTP/전문미수신
			'20161115 NOHES 금결원 smartOTP
			g_szTRAN_CRPT = DATAMANAGER.GetDataValue(0, "obcsb_oimf_523a" , "OutBlock1" , "TRAN_CRPT" , 0)
			
			if g_sSmartYN == "Y" then
				Form.MsgBox( "알림", "PIN번호를 재조회하시기 바랍니다.", "", 6 )
			else
				g_sSmartYN = "Y"
				
				'20161115 NOHES START 금결원 스마트OTP 도입
				Table1.visible = true
				EditInput1.visible = true
				Label0.visible = true
				
				BtnRetry.visible = true
				if g_szChk == "1"	Then
					EditInput1.top = 86
					BtnApp.visible = true
					Image0.visible = true
				end if
				'20161115 NOHES END
				
				DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) 'PIN번호조회
			end if	
		elseif sUI_SMRT_OTP_YN == "Y" and sPROS_YN == "Y" then '스마트OTP/전문수신완료
			EditPin.caption = sPIN_NO
		end if
		
		Table0.visible = true
		EditInput1.visible = true
		
	elseif szTranID == "obcsb_oimf_522a" then
		Dim sOTP_TLMS_SRNO, sSTND_DATE, sOTP_RSPN_CODE, sRSLT_CLS, sOTP_PWD_MSTK_TMNU
		
		sOTP_TLMS_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_TLMS_SRNO" , 0 )
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "STND_DATE" , 0 )
		'0000:정상 나머지:오류
		sOTP_RSPN_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_RSPN_CODE" , 0 )
		'결과구분 0:정상 그외에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "RSLT_CLS" , 0 )
		'OTP오류횟수
		sOTP_PWD_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_PWD_MSTK_TMNU" , 0 )
				
		if Len(Trim(sOTP_TLMS_SRNO)) > 7 then '전문일련번호
			LabelSRNO.caption = sOTP_TLMS_SRNO
		end if
	
		if Len(Trim(sSTND_DATE)) == 8 then '기준일자
			LabelDATE.caption = sSTND_DATE
		end if
	
		if g_nOTPCnt == 0 then
			g_nOTPCnt = g_nOTPCnt+1
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			Exit Sub
		end if
		
		Dim sCode 
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "3021" then 'OTP 코드 체크(3021)
			g_nOTPCnt = g_nOTPCnt+1
			if g_nOTPCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			else
				g_nOTPCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
				Exit Sub
			end if
		end if
	
		if sOTP_RSPN_CODE == "0000" then 'OTP응답코드
			if sRSLT_CLS == "0" then '정상
				if CInt(sOTP_PWD_MSTK_TMNU) > 5 then '에러	
					Form.MsgBox( "알림", "OTP 입력 오류 횟수 초과입니다.", "", 6 )
				else
					'지점개설계좌ID 화면에서 팝업한 경우
					if g_nLinkGubn == 1 then		
						DATAMANAGER.RequestTranData("obcsb_efif_060a")	'ID 등록요청
						
					'ID비밀번호재설정 화면에서 팝업시
					'elseif g_nLinkGubn == 2 then	
					'	Form.OpenFramePopup( "mhetc90060_p5" , g_sSendData , sPosInfo)	'공인인증서 인증 화면 팝업
					
					'그외 화면에서 팝업시
					else
						g_sRetData = "ok"
						Form.CloseForm( )
					end if
				end if
			else
				Dim sMsg, sSubMsg 
				sMsg = DATAMANAGER.GetDataMsgText( szTranID )
				sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
				Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
			end if
		elseif sOTP_RSPN_CODE == "4000" then '20160531 NOHES OTP unsync 응답시 예외처리
			Exit Sub
		'16-03-11 YCJ 추가
		else
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )

		end if
	end if
	
	'ID 등록요청
	if szTranID == "obcsb_efif_060a" then	
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SUCS_YN" , 0) == "Y" then
			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 6 )
		else
			Form.MsgBox( "알림", "ID등록이 실패하였습니다. 해당 영업점 또는 고객지원센터(1588-3400)로 문의 바랍니다.", "", 6 )
		end if
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_oimf_523a" then
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obcsb_oimf_522a" then
		if szErrCode ~= "3021" and szErrCode ~= "9221" then
			Form.MsgBox( "알림", "입력 에러입니다. 다시 입력하십시오.", "", 6 )
			Exit Sub
		elseif szErrCode == "3021" then
			g_nOTPCnt = g_nOTPCnt+1
			if g_nOTPCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			else
				g_nOTPCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
			end if 
		else
			Form.ShowAlert( "알림", szErrMsg)
			Exit Sub
		end if
	end if
	
	'v0008
	if szTranID == "obcsb_efif_060a" and (szErrCode == 6049 or szErrCode == "6049") then	
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox( "알림", szErrMsg.."\n("..sSubMsg..")\n".."주문 취소 후 다시 ID등록을 진행하시기 바랍니다.", "", 6 )
	else
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.."("..sSubMsg..")"
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub
 
'============================================================================
Sub ButtonRequest_OnClick()
	g_sSmartYN = "N"
	
	LabelSRNO.caption = ""
	LabelDATE.caption = ""
	DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) 'PIN번호조회
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if EditInput1.caption == null or EditInput1.caption == "" then
		Form.MsgBox( "알림", "OTP 카드 비밀번호를 입력해주세요.", "", 6 )
	else
		if g_sSmartYN == "Y" then 
			'20161115 NOHES START 'SmartOTP인경우 PIN번호확인(비상시에만)
			if g_szBSWR_CLCD == "9" And ( EditPin.caption == null or EditPin.caption == "") then
'			if EditPin.caption == null or EditPin.caption == "" then	
			'20161115 NOHES END			
				Form.MsgBox( "알림", "PIN번호를 재조회해주세요.", "", 6 )	
			else
				g_nOTPCnt = 0
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			end if
		else
			g_nOTPCnt = 0
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
		end if
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SendReturnToParent( "mhetc90060_pb" , g_sRetData )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		g_sRetData = "ok"
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	elseif sKeyName == "KFTC_OTP" then
		if sRet == "ok" then
			nDev = Form.GetSharedData("&SERVER_MODE", 0 )
			if nDev == "1" then
				bRtn = Form.runStoreApp("com.kftc.smartotp", "http://otptest.kftc.or.kr:8080/smartotp")	
			else
				bRtn = Form.runStoreApp("com.kftc.smartotp", "market://details?id=com.kftc.smartotp")
			end if		
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Table0.visible = false
	Table1.visible = false
	Table2.visible = false
End Sub

'20161115 NOHES START 비상시 스마트 OTP 입력
'============================================================================
Sub BtnRetry_OnClick()
	if g_szChk == "1" Then
		EditPin.top = 86
		ButtonRequest.top = 86
		
		Label0.top = 144
		EditInput1.top = 139
		
		BtnRetry.top = 200
		
		Image0.visible = False
		BtnApp.visible = False
		
		EditPin.visible = true
		ButtonRequest.visible = true
		Table2.visible = True
		
		g_sSmartYN = "N"
		g_nOTPCnt =0
		
		g_szBSWR_CLCD = "9"
		g_szTRAN_CRPT = ""
		g_szChk = "0"
		DATAMANAGER.RequestTranData("obcsb_oimf_523a")
		BtnRetry.caption = "스마트 OTP 수동입력 해제" 'v0001

	else 		
		Label0.top = 91
		EditInput1.top = 86
		
		BtnRetry.top = 160
	
	
		EditPin.visible = false
		ButtonRequest.visible = false
		Table2.visible = false

		Image0.visible = true
		BtnApp.visible = true

		g_sSmartYN = "N"
		g_nOTPCnt =0
		
		if g_RszBSWR_CLCD == "2" Then
			g_szBSWR_CLCD = "2"
		else
			g_szBSWR_CLCD = "1"
		end if
		g_szTRAN_CRPT = ""
		g_szChk = "1"
		DATAMANAGER.RequestTranData("obcsb_oimf_523a")
		BtnRetry.caption = "데이터통신 장애 등 비상시 스마트 OTP 수동 입력 >" 'v0001
	
	end if
	
End Sub

'============================================================================
Sub BtnApp_OnClick()
	'테스트용 인증 스킵 체크 
	nDev = Form.GetSharedData("&SERVER_MODE", 0 )
	
	Dim sTemp
	sTemp = ""
	if  Form.GetSharedData("&OS_TYPE", false ) == "2" then'iOS("2")Android("1")
		sTemp = "IOS는 금융결제원(KFTC)스마트OTP앱을 지원하지 않습니다.\n"
	else
		if nDev == "1" then
			bRtn = Form.runStoreApp("com.kftc.smartotp", "")	
		else
			bRtn = Form.runStoreApp("com.kftc.smartotp", "")
		end if
	end if
	
	'bRtn = "" 함수정의 없음, 'bRtn = "0" 설치 안됨, 'bRtn = "1" 설치 됨
	if bRtn <> "1" then
		if Trim(bRtn) == "" Then
			Form.MsgBox("알림", sTemp&"Google play 스토어에서 금융결제원(KFTC) '스마트OTP 공동앱'을 다운받으신 후 실행해주시기 바랍니다.")
		elseif bRtn == 0 or bRtn == "0" Then
			Form.MsgBox("알림", "금융결제원(KFTC) 스마트OTP 공동앱을 설치하시겠습니까?", "KFTC_OTP", "1")
		end if
	end if	
End Sub

'============================================================================
Sub Image0_OnClick()
	Call BtnApp_OnClick()
End Sub

