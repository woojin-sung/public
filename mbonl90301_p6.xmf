'============================================================================
Sub BtnCheck_OnClick()
	szUserID = Form.GetSharedData("&USER_ID" , false)
	szDate = Form.GetSharedData("&HOST_DATE",0)
	
	'key값 : ID + _BondSellNotice , value : 날짜
	Form.SaveConfigData("NoticeSetting", szUserID & "_BondSellNotice", szDate)
	Form.CloseForm()
End Sub

