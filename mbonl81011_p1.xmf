<ROOT>
	<MAP_INFO scrno="81011" scrname="계좌미보유_투자성향진단_완료팝업" version="2" writer="장원혁" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="btnOk" caption="확인" fontsize="4" btnimage="btn_20.9" ly_vert="0,587,375,60,1" />
		<LABEL name="Label3" fontsize="8" fontstyle="01" caption="투자성향 진단이
완료되었습니다." halign="1" multiline="1" ly_vert="20,195,335,58,1" />
		<IMAGE name="Image0" autosize="1" imgpath="icon_ok.png" ly_vert="153,105,70,70,1" />
		<IMAGE name="ImgValid" visible="0" autosize="1" imgpath="icon_invest_1.png" ly_vert="122,293,130,94,0" />
		<LABEL name="lblText1" visible="0" caption="고객님의 투자성향은" ly_vert="34,402,146,32,0" />
		<LABEL name="lblGradeName" visible="0" fgcolor="006:213049051" halign="1" ly_vert="184,402,95,32,0" />
		<LABEL name="lblText2" visible="0" caption="입니다." ly_vert="271,402,57,32,0" />
