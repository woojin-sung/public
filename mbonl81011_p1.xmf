	<SCRIPT_INFO _len="1909" _ulen="1785" >
'============================================================================
' 01.화면명 	: 계좌미보유고객용_투자성향진단_완료팝업
' 02.화면설명	: 
' 03.작성	: 2021.06.04
' 04.수정	: 
'============================================================================

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
    Dim szOpenData
    szOpenData = Form.GetOpenLinkData()   
    
    if szOpenData <> "" then
	    ImgValid.visible = true
	    lblText1.visible = true
	    lblGradeName.visible = true
	    lblText2.visible = true	 
	    
	    lblGradeName.caption = szOpenData
	    
	    if szOpenData == "고수익지향형" then
		    ImgValid.imgpath = "icon_invest_grade_5.png"
	    
	    elseif szOpenData == "성장지향형" then
		    ImgValid.imgpath = "icon_invest_grade_4.png"
		    
	    elseif szOpenData == "중립형" then
		    ImgValid.imgpath = "icon_invest_grade_3.png"
		    
	    elseif szOpenData == "안정지향형" then
		    ImgValid.imgpath = "icon_invest_grade_2.png"
		    
	    elseif szOpenData == "이자소득형" then
		    ImgValid.imgpath = "icon_invest_grade_1.png"
	    
	    else
		    ImgValid.imgpath = "icon_error.png"
		    lblGradeName.caption = "정보미제공"
	    end if
    end if
End Sub

'============================================================================
' btnOk_OnClick() : 팝업닫기
'============================================================================
Sub btnOk_OnClick()
    Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>