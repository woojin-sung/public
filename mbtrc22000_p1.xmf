		<BUTTON name="BtnMod" caption="확인" bgcolor="289:255255255" bgcolor2="233:102101101" fontsize="2" btnimage="btn_26.9" ly_vert="-3,597,381,50,1" />
		<LABEL name="Label1" fontstyle="01" caption="거래일자" ly_vert="16,475,100,32,1" />
