Sub Container0_FormTab0_OnTabChanged(nCurrentTab)
	Dim szTemp
	if nCurrentTab == 0 then  '1일
'Container0.Table0.SetCellString(0, 0, "전일 마감환율") 'for TEST
'Container0.Table0.SetCellString(0, 0, "실시간 환율") 'for TEST
