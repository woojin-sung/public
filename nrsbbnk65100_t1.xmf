Sub Container0_ImgSelect_OnClick()
	Container0_lblCRCD_OnClick()
End Sub

'============================================================================
Sub Container0_ImgCRCD_OnClick()
	Container0_lblCRCD_OnClick()
End Sub

'============================================================================
Sub Container0_lblCRCD_OnClick()
	Form.OpenPopupAnimation("nrsbbnk65100_p1", Container0.lblCRCD.caption,  "",  2)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CDRD_SET" then
		if sRet <> "" then
			Container0.lblCRCD.caption = sRet
			'통화변경 후 설정
			ChangeCRCD(Container0.lblCRCD.caption)			
			ExeQuery()
		end if 
	end if 
End Sub
