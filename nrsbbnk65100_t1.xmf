	<SCRIPT_INFO _len="19402" _ulen="18488" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환전환율
' 02. 화면설명 : 환율조회의 환전화율탭
' 03. 작    성 : 2024.05.31
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

dim g_szToday
dim g_szSelect
g_szSelect = 0
dim g_szOsType

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
function ChangeCRCD(szCRCD)
	Select Case szCRCD
		Case "USD"		
			Container0.ImgCRCD.imgpath = "flag_us2.png" 
			Container0.lblBuy.caption = "달러 살 때"
			Container0.lblSell.caption = "달러 팔 때"
			g_szSelect = 0
		Case "JPY"		
			Container0.ImgCRCD.imgpath = "flag_jp2.png" 
			Container0.lblBuy.caption = "엔 살 때"
			Container0.lblSell.caption = "엔 팔 때"										
			g_szSelect = 1
		Case "CNY"				
			Container0.ImgCRCD.imgpath = "flag_chn.png" 
			Container0.lblBuy.caption = "위안 살 때"
			Container0.lblSell.caption = "위안 팔 때"										
			g_szSelect = 2
		Case "HKD"				
			Container0.ImgCRCD.imgpath = "flag_hk.png" 
			Container0.lblBuy.caption = "홍콩 달러 살 때"
			Container0.lblSell.caption = "홍콩 달러 팔 때"										
			g_szSelect = 3
		Case "EUR"	
			Container0.ImgCRCD.imgpath = "flag_eu.png" 
			Container0.lblBuy.caption = "유로 살 때"
			Container0.lblSell.caption = "유로 팔 때"										
			g_szSelect = 4
		Case "CHF"	
			Container0.ImgCRCD.imgpath = "flag_swi.png" 
			Container0.lblBuy.caption = "프랑 살 때"
			Container0.lblSell.caption = "프랑 팔 때"										
			g_szSelect = 5
		Case "AUD"		
			Container0.ImgCRCD.imgpath = "flag_aus.png" 
			Container0.lblBuy.caption = "호주 달러 살 때"
			Container0.lblSell.caption = "호주 달러 팔 때"										
			g_szSelect = 6
		Case "CAD"
			Container0.ImgCRCD.imgpath = "flag_can.png" 
			Container0.lblBuy.caption = "캐나다 달러 살 때"
			Container0.lblSell.caption = "캐나다 달러 팔 때"										
			g_szSelect = 7
		Case "SGD"	
			Container0.ImgCRCD.imgpath = "flag_sgp.png" 
			Container0.lblBuy.caption = "싱가포르 달러 살 때"
			Container0.lblSell.caption = "싱가포르 달러 팔 때"										
			g_szSelect = 8
	End Select
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	Container0.ImgCRCD.setMaintainingRatio("1")
	Container0.ImgSelect.setMaintainingRatio("1")	
	Container0.ImgRefresh.setMaintainingRatio("1")
	Container0.Image0.setMaintainingRatio("1")
	
	Container0.ChartExToday.SetChartType("simpleline")  '1일
	Container0.ChartExFromTo.SetChartType("simpleline")
	Container0.ChartExBefore.SetChartType("simpleline")
	
	 'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
	Container0.ChartExToday.SetMarketCategory("1") '1일		  
	Container0.ChartExFromTo.SetMarketCategory("1") 		  
	Container0.ChartExBefore.SetMarketCategory("1") '1일(전일)		  
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Container0.Change0.SetSignPos(2) ' 0 : 원래대로, 1 : 좌측부호, 2 : 우측부호	
	'컨테이너 스크롤삭제
	Container0.setScrollBarVisible("0") 

	Container0.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 10) '활성화/비활성화/여백
	Container0.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상	

	Container0.FormTab0.insertPage( Container0.FormTab0.tabcount, "page1", "page1", "empty", "0", "1일")
	Container0.FormTab0.insertPage( Container0.FormTab0.tabcount, "page2", "page2", "empty", "0", "1개월")
	Container0.FormTab0.insertPage( Container0.FormTab0.tabcount, "page3", "page3", "empty", "0", "3개월")
	Container0.FormTab0.insertPage( Container0.FormTab0.tabcount, "page4", "page4", "empty", "0", "6개월")
	Container0.FormTab0.currenttab = 0
	Container0_FormTab0_OnTabChanged(0)
	
	'======================================================
	'*********************LES START************************
	'======================================================
	'0:틱, 1:분, 2:일자
	 Container0.ChartExToday.SetPeriodType(1)	'1일
'	 Container0.ChartExFromTo.SetPeriodType(2)	
'	 Container0.ChartExBefore.SetPeriodType(1)	'1일(전일)
	'======================================================
	'*********************LES END**************************
	'======================================================	
	g_szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	if szScrNo == "65000" or szScrNo == "65010" then
		if g_szOsType == "2" then
			Container0.height = 550
		else
			Container0.height = 650
		end if
		
		Container0.SetScrollAutoSize()
	end if
	ExeQuery()
	'Container0_ImgRefresh_OnClick()
'	Form.SetTimerEvent(1, 1, 60)	 

End Sub

'============================================================================
Sub Form_OnFormClose()
'	Form.SetTimerEvent(1, 0, 60) '타이머끄기
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'Container0_ImgRefresh_OnClick()
	ExeQuery()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INFO_REFRESH" then
		'Container0_ImgRefresh_OnClick()
		if sParam <> "" then
			Container0.lblCRCD.caption = sParam
			'통화변경 후 설정
			ChangeCRCD(Container0.lblCRCD.caption)			
		end if 
		ExeQuery()
'		Form.SetTimerEvent(1, 1, 60)
	 end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	'환율 등락폭 조회
	if szTranID = "obtsd_fbnk_234r" then 	
		DATAMANAGER.ClearInputData(0, sTranID)
		DATAMANAGER.ClearOutputData(0, sTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TR_DATE", 0, g_szToday)		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRCD", 0, Trim(Container0.lblCRCD.caption))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, "287")
	'기간별 환율
	elseif szTranID = "obtsd_fbnk_230r" then 
		Dim sTemp
		sTemp = CStr(CInt(Container0.FormTab0.currenttab) + 1)
		
		if Cint(Container0.FormTab0.currenttab) == 0 then
			Container0.ChartExToday.SetPeriodType(1)
		else
			Container0.ChartExToday.SetPeriodType(2)
		end if
		
		Container0.grd1.setClear()
		Container0.grd3.setClear()
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0, sTemp)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRCD", 0, Trim(Container0.lblCRCD.caption))	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TR_DATE", 0,  g_szToday)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, "287")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'차트위 데이터 설정 
	if szTranID == "obtsd_fbnk_234r" then 
		Dim szGubun, szTime, szDate, szSign
		szGubun = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "IF_EXRT_CLS_CODE", 0)

'		'환율상태 E : 마감, S : 개시중, N : 개시전)
'		'1일 9:00 ~ 15:30 실시간 환율, 15:30 이후 1일 마감환율, 09:00 이전 전일 마감환율   ????
'		if szGubun == "N" then
'			Container0.Table0.SetCellString(0, 0, "전일 마감환율")
'			Container0.ImgRefresh.left = 328	
'		elseif szGubun == "E" then
'			Container0.Table0.SetCellString(0, 0, "당일 마감환율")
'			Container0.ImgRefresh.left = 328
'		else'if szGubun == "S" then
'			Container0.Table0.SetCellString(0, 0, "실시간 환율")
'			Container0.ImgRefresh.left = 324			
'		end if 

		szExrt1 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_STND_EXRT1", 0))
		szExrt3 = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_STND_EXRT3", 0))
		szRate = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RATE", 0))
		
		Container0.Table1.SetCellString(0, 0, szExrt1)
		Container0.Table1.SetCellString(2, 1, szExrt3)
		Container0.Table1.SetCellString(2, 2, szRate)

		'대비부호
		szSign = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "IF_SIGN", 0))
		Container0.Change0.changesign = szSign

		if szSign == "+" then
			Container0.Table1.SetCellFgColor(2, 1, "1") 
			Container0.Table1.SetCellFgColor(2, 2, "1") '상승
			Container0.Change0.changesign = 2
		elseif szSign == "-" then
			Container0.Table1.SetCellFgColor(2, 1, "2") '하락
			Container0.Table1.SetCellFgColor(2, 2, "2") 
			Container0.Change0.changesign = 5
		else
			Container0.Table1.SetCellFgColor(2, 1, "3") '보합
			Container0.Table1.SetCellFgColor(2, 2, "3") 
			Container0.Change0.changesign = 0
		end if 
		'대비값이 0인 경우 보합
		if CDbl(Container0.Table1.GetCellString(2, 1)) == 0 then
			Container0.Table1.SetCellFgColor(2, 1, "3") '보합
			Container0.Table1.SetCellFgColor(2, 2, "3") 
			Container0.Change0.changesign = 0
		end if 
		
		'시간 
		szTime = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROS_HOUR", 0)
		szDate = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TR_DATE", 0)

		if szTime == "" and szDate == "" then
			Container0.Table1.SetCellString(0, 0, "0")
			Container0.Table1.SetCellString(2, 1, "0")
			Container0.Table1.SetCellString(2, 2, "0")
			
			Container0.lblBuyAmt.caption = "0"
			Container0.lblSellAmt.caption =  "0"
			
			Container0.Table1.SetCellFgColor(2, 1, "3") '보합
			Container0.Table1.SetCellFgColor(2, 2, "3") 
			Container0.Change0.changesign = 0
		
			if g_szOsType == "2" then
				Form.Toast(2, "                    환율 업데이트 중이에요.                    \n                 잠시 후 다시 조회해주세요.                    ", true)
			else
				Form.Toast(2, "                    환율 업데이트 중이에요.                    \n잠시 후 다시 조회해주세요.", true)
			end if
		else
			Container0.Table0.SetCellString(1, 0, Right(szDate, 6) .. szTime) 
		end if
		
		'매입환율 / 매도환율
		Container0.lblBuyAmt.caption = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TLTR_BYRT", 0)
		Container0.lblSellAmt.caption =  DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TLTR_SLRT", 0)
		
		
		DATAMANAGER.RequestTranData("obtsd_fbnk_230r")
	'기간별 환율
	elseif szTranID == "obtsd_fbnk_230r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount(false, szTranID , "OutBlock2")
		if nCount > 0 then
			if CInt(Container0.FormTab0.currenttab) == 0 then '1일
				nCount = 1 '1일
				Container0.grd1.height = 35*(1)
				if Container0.Table0.GetCellString(0, 0) == "전일 마감환율" then
'					Container0.grd1.left = 500
'					Container0.grd3.left = 9
'					Container0.grd1.visible = false
'					Container0.grd3.visible = true
					Container0.grd3.rowcount = nCount
					Container0.grd3.SetCellData("bd_date", i, g_szToday)
					Container0.grd3.SetCellData("bd_popup", i, ">" )
					Container0.grd3.SetCellFgColor("bd_popup", i, "26")
					Container0.grd3.SetCellData("bd_real", i, "-")
					Container0.grd3.SetCellData("bd_buy", i, "-")
					Container0.grd3.SetCellData("bd_sell", i, "-")
					Container0.grd3.SetCellData("bd_annc", i, "-")
					
'					Container0.ChartExToday.left = 500
'					Container0.ChartExFromTo.left = 500
'					Container0.ChartExBefore.left = 15						
'					Container0.ChartExToday.visible = false
'					Container0.ChartExFromTo.visible = false
'					Container0.ChartExBefore.visible = true
					Container0.SetScrollAutoSize()
					Exit Sub
				else
'					Container0.ChartExToday.left = 15
'					Container0.ChartExFromTo.left = 500
'					Container0.ChartExBefore.left = 500	
'					Container0.ChartExToday.visible = true
'					Container0.ChartExFromTo.visible = false
'					Container0.ChartExBefore.visible = false					
				end if
			else
'				Container0.ChartExToday.left = 500	
'				Container0.ChartExFromTo.left = 15
'				Container0.ChartExBefore.left = 500
'				Container0.ChartExToday.visible = false
'				Container0.ChartExFromTo.visible = true
'				Container0.ChartExBefore.visible = false					
				
				if CInt(Container0.FormTab0.currenttab) == 1 then   '1개월
					'nCount = 30
				elseif CInt(Container0.FormTab0.currenttab) == 2 then '3개월
					'nCount = 90
				elseif CInt(Container0.FormTab0.currenttab) == 3 then '6개월
					'nCount = 180
				end if 				
			end if 
			'Container0.grd1.height = 35*(nCount+1)
			if g_szOsType == "2" then
				Container0.grd1.height = 35*(8)
			else
				Container0.grd1.height = 35*(9) +10
			end if 
			Container0.grd1.rowcount = nCount
			for i = 0 to nCount-1
				Container0.grd1.SetCellData("bd_date", i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "TR_DATE", i) )
				Container0.grd1.SetCellData("bd_popup", i, ">" )
				Container0.grd1.SetCellFgColor("bd_popup", i, "26")
				Container0.grd1.SetCellData("bd_real", i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "STND_EXRT", i))
				Container0.grd1.SetCellData("bd_buy", i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "TLTR_BYRT", i))
				Container0.grd1.SetCellData("bd_sell", i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "TLTR_SLRT", i))
				Container0.grd1.SetCellData("bd_annc", i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "DEAL_STND_EXRT", i))				
			next
			Container0.SetScrollAutoSize()

		end if 
		Container0.ImgRefresh.visible = true
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Container0.ImgRefresh.visible = true
	
	if szTranID == "obtsd_fbnk_234r" then 	
		Container0.Table1.SetCellString(0, 0, "0")
		Container0.Table1.SetCellString(2, 1, "0")
		Container0.Table1.SetCellString(2, 2, "0")
		
		Container0.lblBuyAmt.caption = "0"
		Container0.lblSellAmt.caption =  "0"
		
		Container0.Table1.SetCellFgColor(2, 1, "3") '보합
		Container0.Table1.SetCellFgColor(2, 2, "3") 
		Container0.Change0.changesign = 0
		
		Container0.ChartExToday.clear = "0"
		Container0.grd1.setClear()
		Container0.grd3.setClear()
		
		if g_szOsType == "2" then
			Form.Toast(2, "                    환율 업데이트 중이에요.                    \n                 잠시 후 다시 조회해주세요.                    ", true)
		else
			Form.Toast(2, "                    환율 업데이트 중이에요.                    \n잠시 후 다시 조회해주세요.", true)
		end if
	end if
End Sub

'============================================================================
Sub Container0_grd1_OnClickUp(lRow, szCellID)	
	'"일자 >" 클릭시 시간대별 환율조회
	if szCellID == "bd_popup" or szCellID == "bd_date" then
		Form.OpenPopupAnimation("nrsbbnk65100_p2", Container0.lblCRCD.caption.."★"..Container0.grd1.GetCellData("bd_date", lRow),  "2")
	end if 
End Sub

'============================================================================
Sub Container0_grd3_OnClickUp(lRow, szCellID)	
	'"일자 >" 클릭시 시간대별 환율조회
	if szCellID == "bd_popup" or szCellID == "bd_date" then
		Form.OpenPopupAnimation("nrsbbnk65100_p2", Container0.lblCRCD.caption.."★"..Container0.grd3.GetCellData("bd_date", lRow),  "2")
	end if 
End Sub

'환전신청
'============================================================================
Sub Container0_Button0_OnClick()
	Form.OpenScreen("65000" , "매수통화`"..Trim(Container0.lblCRCD.Caption).."`65100")
End Sub

'============================================================================
Sub Container0_ImgRefresh_OnClick()
	Container0.ImgRefresh.visible = false
	ExeQuery()
End Sub

Function ExeQuery()
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )	
	DATAMANAGER.RequestTranData("obtsd_fbnk_234r")
	'DATAMANAGER.RequestTranData("obtsd_fbnk_230r")
End Function

'============================================================================
Sub Container0_Table0_OnClick(lRow , lColumn)
	Container0_ImgRefresh_OnClick()
End Sub

