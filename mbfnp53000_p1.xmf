'============================================================================
' 01. 화 면 명 : ELS/DLS청약_청약신청팝업
' 02. 화면설명 : ELS/DLS청약_청약신청팝업
' 03. 작    성 : 2016. 03. 05. 유창재
' 04. 수    정 : 2020. 09. 16. 성주혁 MTS 메모리 보안 v0001
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
Dim g_szPW			'비밀번호
Dim g_Chk0			'투자설명서 확인 여부
Dim g_ngoMoney		'청약금액
Dim g_nAmount			'청약주수
Dim g_szYesorNo		'청약취소여부
Dim g_szAbleMoney		'출금가능액 청약단가 단위
Dim plain_rm			'메모리평문 적용유무 
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Setpass() : 청약 신청 함수
'============================================================================
Function Setpass()
	
	g_nAmount = g_ngoMoney/tbl0.GetCellString( 3, 1)
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "ACNO" , 0 , acnt0.total)			'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "ASNO" , 0 , acnt0.sequence)		'일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)			'비밀번호

	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_DATE" , 0 ,g_szList(5))			'청약일자
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_ISSU_SRNO" , 0 , g_szList(2))	'청약종목일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_APLT_SRNO" , 0 , "0" )			'청약신청일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_STCN" , 0 , g_nAmount)				'청약주수
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "CNCL_YN" , 0 , g_szYesorNo)				'취소여부

	DATAMANAGER.RequestTranData( "obibk_pssb_021a" )
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	
	Form.SetScreenName( "ELS/DLS청약신청" )
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	g_Chk0 = 0
	g_ngoMoney = 0
	
	tbl0.SetCellString( 0 , 1, g_szList(0))			'청약종목
	tbl0.SetCellString( 2 , 1, g_szList(4))			'청약최소금액(청약단가금액)
	tbl0.SetCellString( 3 , 1, g_szList(7))			'청약단가
	
	DATAMANAGER.RequestTranData( "obibk_pssb_001r" )
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obibk_pssb_023r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "ACNO" , 0 , acnt0.total )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "ASNO" , 0 , acnt0.sequence )			'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "SBSC_DATE" , 0 , g_szList(1) )		'청약일자(당일날짜)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , g_szList(2) )	'청약종목일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "ABLE_AMT" , 0 , tbl0.GetCellString( 1, 1) )	'가능금액(출금가능금액)
		
	elseif szTranID == "obibk_pssb_001r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ACNO" , 0 , acnt0.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ASNO" , 0 , acnt0.sequence )	'일련번호
		
	elseif szTranID == "obibk_pssb_029r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "APLT_DATE" , 0 , g_szList(1) )		'신청일자(당일날자)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ACNO" , 0 , acnt0.total )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ASNO" , 0 , acnt0.sequence )			'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "SBSC_ISSU_CLS_CODE" , 0 , g_szList(6) )	'청약종목구분코드
	
	elseif szTranID == "obcsb_oimf_625r" then			'보안매체 확인을 위한 TR
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = acnt0.total
		sACNO_PWD = g_szPW
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
	
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()
	
	'v0001
	'AS-IS
	'g_szPW = Form.GetEncData( edtPW.caption ) 
	
	'To-Be
	if plain_rm =="1" then
		g_szPW = edtPW.caption
	else
     	g_szPW = Form.GetEncData( edtPW.caption ) 
	end if
	
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ACNT_PWD" , 0 , g_szPW )
	DATAMANAGER.RequestTranData( "obibk_pssb_001r" )
	
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	
'	DATAMANAGER.RequestTranData( "obibk_pssb_023r" )
	DATAMANAGER.RequestTranData( "obibk_pssb_001r" )
	
End Sub
'============================================================================
' rdoMoney_OnClick(nIndex) : 라디오 버튼 선택에 따른 청약금액 선택
'============================================================================
Sub rdoMoney_OnClick(nIndex)
	
	Select Case nIndex
		Case 0		'1억
			g_ngoMoney = g_ngoMoney + 100000000
			edtMoney.caption = g_ngoMoney
'			edtMoney.enable = false
		Case 1		'1천만원
			g_ngoMoney = g_ngoMoney + 10000000
			edtMoney.caption = g_ngoMoney
'			edtMoney.enable = false
		Case 2		'100만원
			g_ngoMoney = g_ngoMoney + 1000000
			edtMoney.caption = g_ngoMoney
'			edtMoney.enable = false
		Case 3		'50만원
			g_ngoMoney = g_ngoMoney + 500000
			edtMoney.caption = g_ngoMoney
'			edtMoney.enable = false
		Case 4		'10만원
			g_ngoMoney = g_ngoMoney + 100000
			edtMoney.caption = g_ngoMoney
'			edtMoney.enable = false
		Case 5		'정정
			g_ngoMoney = 0
			edtMoney.caption = ""
			edtMoney.enable = true
			edtMoney.SetShowKeypad( true )
	End Select

End Sub
'============================================================================
' btnOK_OnClick()
'============================================================================
Sub btnOK_OnClick()
	Dim szData
	
	if CDbl(edtMoney.caption) < CDBL(tbl0.GetCellString( 2, 1)) then
		Form.ShowAlert( "알림", "청약최소금액을 확인하십시오.")
		Exit Sub
	elseif CDBL(tbl0.GetCellString( 1, 1)) < CDBL(edtMoney.caption) then
		Form.ShowAlert( "알림", "출금가능금액을 확인하십시오.")
		Exit Sub
	end if
	
	
	if g_Chk0 == 1 then		'투자성향진단 화면 호출   화면번호,계좌번호,일련번호,종목코드,비밀번호
		szData = "53000" & "★" & acnt0.total & "★" & acnt0.sequence & "★" & g_szList(3) & "★" & edtPW.caption
		
		if g_szPW == "" or g_szPW == Null then
			Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")
			Exit Sub
		elseif edtMoney.caption == "" then
			Form.ShowAlert( "알림", "청약금액을 입력해주세요.")
			Exit Sub
		else
			Form.OpenFramePopup( "mbonl81010_p1" , szData , sPosInfo)
		end if
	else
		Form.ShowAlert( "알림", "투자설명서를 확인하여 주십시오.")
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "KYCCHK_RETURN" then
		if sRet == "Y" then
'			Setpass()			'청약신청 테스트용
			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
		end if
	elseif sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb"or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'청약신청
			Setpass()
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obibk_pssb_001r" then
	
		DATAMANAGER.RequestTranData( "obibk_pssb_023r" )
		DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
	elseif szTranID == "obibk_pssb_029r" then
		g_szYesorNo = DATAMANAGER.GetDataValue( 0, "obibk_pssb_029r", "OutBlock1", "CNCL_YN" , 0)			'취소여부
	
	elseif szTranID == "obibk_pssb_021a" then
		Form.ShowAlert( "알림", "정상처리 되었습니다.")
		Form.SendReturnToParent( "mbfnp53000_p1" , "Ok")
		Form.CloseForm()
		
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'모바일OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
	
End Sub
'============================================================================
' btnNotice_OnClick()
'============================================================================
Sub btnNotice_OnClick()
	Dim szFileName, nType
	
	szFileName = "IBK"&g_szList(5)&CDbl(g_szList(2))&".pdf"
	
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/ocw/"& szFileName, "")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.255.202.106/include/ocw/"& szFileName, "")	'테스트계주소
	end if
	
	chk0.checkstate = 1
	g_Chk0 = 1
End Sub
'============================================================================
' edtMoney_OnEditComplete()
'============================================================================
Sub edtMoney_OnEditComplete()
	
	g_ngoMoney = g_ngoMoney + edtMoney.caption
	
	g_nAmount = g_ngoMoney/tbl0.GetCellString( 3, 1)
	
	if g_nAmount <> Int(g_nAmount) then			'청약금액이 단가 단위와 맞지 않을때 오류 메세지 호출 후 변경안됨
		Form.ShowAlert( "알림" , "단가를 확인하시기 바랍니다.")
		edtMoney.caption = ""
		g_ngoMoney = 0
		Exit Sub
	end if	
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obibk_pssb_021a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obibk_pssb_021a" )
		if Trim(szSubErr) <> "" and Trim(szSubErr) <> Null then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림", szErrMsg)
		end if
		Form.CloseForm()			'에러시 폼 종료 해달라는 요청을 받음
	end if
	
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", acnt0.total &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
