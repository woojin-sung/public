Dim g_OSType
g_OSType = ""

Dim g_Open
g_Open = ""

'============================================================================
Sub Form_OnFormInitBefore()
	'Cont0.Image12.SetMaintainingRatio("1")
	'Cont0.Image13.SetMaintainingRatio("1")
	'Cont0.imgClose.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()

	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	g_OSType = s_OSTYPE	

	g_RcnoPIP	= Form.GetSharedData("&JUMIN_NUM", false )
	g_CustTermID	=	Trim(Form.GetDeviceID())
	g_OSClcd		=	Form.GetSharedData("&OS_TYPE", false)
	g_OSVrsn		=	Form.GetSharedData("&OS_VERSION", false)
	g_CustTermName	=	Form.GetDeviceModel()

	DATAMANAGER.RequestTranData("obcsb_oimf_172r")
	Form.SetTimerEvent2( 0, 1, 0.2)
End Sub

'============================================================================
' 타기관 OTP 이용등록
'============================================================================
Sub Cont0_Button1_OnClick()

	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )		
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		'타기관 OTP 목록 조회
		'Form.OpenNextPopup( "nrsotp86000.xmf", "", "" )
		Form.OpenNextPopup( "mbotp86000.xmf", "", "" )
	else
'		'안내
'		if g_OSType == "2" then
'			Form.OpenNextPopup( "mbotp86300.xmf", "POPUP_ALL_CLOSE", "" ) 
'		else
'			Form.OpenNextPopup( "mbotp86300.xmf", "", "" )
'		end if
		
		'g_Open = "86300"
		Form.OpenPopup("mbotp86300","","")	'20240311 KKM 수정			
	end if
End Sub

'============================================================================
' OTP 관리
'============================================================================
Sub Cont0_Button2_OnClick()

	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )		
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Form.OpenNextPopup( "mbonl86000.xmf" , "" , "" )
	else	
'		if g_OSType == "2" then
'			Form.OpenScreen("86000", "POPUP_ALL_CLOSE")
'		else
'			Form.OpenScreen("86000", "")
'		end if
'		Form.CloseForm( )	
		
		g_Open = "86000"
		Form.OpenPopup("mhetc90021","","")		
	end if
End Sub

'============================================================================
Sub Cont0_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'msgbox sKeyName & " :: " & sRet
	if sKeyName == "Login_Type" then
		if Cint(sRet) > 1 then
			if g_Open == "86000" then
				Form.OpenNextPopup( "mbonl86000.xmf" , "" , "" )
			end if	
		end if 
	end if 
End Sub

'============================================================================
Sub Cont0_Image0_OnClick()
	Form.CloseForm()	
End Sub

