	<SCRIPT_INFO _len="2008" _ulen="1870" >
dim	g_szRet	'리턴값

g_szRet = "close"

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	if szOpenData <> "" and szOpenData <> null then
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		'종목명 긴 경우, 멀티라인 2줄까지만 출력되도록..
		if Len(tData(1)) > 40 then
			lblFndName.fontsize = -2
		else
			lblFndName.fontsize = 0
		end if
		lblFndName.caption 		= tData(1)	'상품명


		tblInfo.SetCellString( 1, 1, "["&szProdText&"] "&Left(tData(0),4)&"-"&Mid(tData(0),5,4)&"-"&Right(tData(0),2)) 	'신청계좌


		szSellType	= tData(5)
		if szSellType = "01" then	'금액매도
			lblSellAmt.mask="0,0,,원,0,,0,1,0,0,0"
		else	'좌수매도/전액매도
			lblSellAmt.mask="0,0,,좌,0,,0,1,0,0,0"
		end if
		lblSellAmt.caption = tData(2)	'매도금액(좌수)
		
		
		tblInfo.SetCellString( 3, 1, tData(3)) '기준가적용일
		tblInfo.SetCellString( 4, 1, tData(4)) '결제예정일
		
	end if
	
End Sub

'============================================================================
Sub btnList_OnClick()
	'주문내역
'	Form.OpenPopup( "mbfnp51030" , "" , "")
	Form.OpenScreen("51030" , "")
	Form.CloseForm()
	Exit Sub
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51012_p2" ,  g_szRet)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

