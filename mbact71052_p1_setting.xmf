<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="71052" scrname="고객자산평가_보유자산만보이기팝업" version="2" writer="정민영" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBg" autosize="1" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgMain" imgpath="popup_bg.9" ly_vert="0,430,375,302,1" />
		<LABEL name="Label1" bgcolor="320:246247248" transmode="0" ly_vert="1000,462,335,50,1" />
		<BUTTON name="btnOK" caption="확인" fontsize="2" btnimage="btn_20.9" ly_vert="0,597,375,50,1" />
		<LABEL name="lblAllText" fontsize="2" fontstyle="01" caption="자산 탭 설정" paddinginfo="1,0,0,0" ly_vert="20,449,326,35,1" />
		<IMAGE name="Image0" imgpath="bg_infobox.9" ly_vert="20,487,335,50,1" />
		<LABEL name="Label0" caption="보유 자산 탭만 보기" paddinginfo="1,0,0,0" ly_vert="40,496,230,32,1" />
		<BUTTON name="btnSwitch" fontsize="-2" ly_vert="279,502,55,20,1" />
		<LABEL name="Label2" fgcolor="146:124124124" fontsize="-2" caption="ON으로 설정 시, 보유잔고의 상품탭만 조회됩니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,554,335,40,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="991" _ulen="991" >

'============================================================================
Sub Form_OnFormInit()
'	btnSwitch.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	btnSwitch.setApplySwitch("OFF", "ON", "294", "200", "270", "289")
	szExistYn = Form.LoadConfigData("mbact71052_p1", "SHOW_EXIST_ONLY_YN")
	if szExistYn == "" or szExistYn == null then
		szExistYn = "Y"
	end if
	
	if szExistYn == "Y" then
		btnSwitch.switchindex = 1
	else
		btnSwitch.switchindex = 0
	end if
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	if CInt(btnSwitch.switchindex) == 0 then
		Form.SaveConfigData("mbact71052_p1", "SHOW_EXIST_ONLY_YN", "N")
	else
		Form.SaveConfigData("mbact71052_p1", "SHOW_EXIST_ONLY_YN", "Y")
	end if
	
	Form.SendReturnToParent("mbact71052_p1_setting" , "")
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>