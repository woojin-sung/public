'============================================================================
' 설문 답안 초기화
'============================================================================
Function ClearCheckAnswer(szQNum)
	Dim nQNum
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1

	Select case nQNum
		case 1, 2, 3, 4
		    for j = 0 to  g_tAnswerCnt[nTIdx]
			   Form.SetCtlProp("ContBody.Cont0.ImgQ" & nQNum & "A" & j, "imgpath", unCheckImgPath)
		    next
		case 5, 6
		    for j = 0 to g_tAnswerCnt[nTIdx]
			   Form.SetCtlProp("ContBody.Cont0.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
		    next		
    End Select
    
End Function

'============================================================================
' 선택된 설문 답안 화면에 표시
'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum, nAnswerNum
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1
	nAnswerNum = CDbl(szAnswerNum)
	
    Dim tQuestionTop '선택 문항 top으로 옮겨주도록 클릭했을때 이동할 top을 가지고 있는 테이블
'    tQuestionTop =  Array("0", "227", "475", "705", "1320", "1563")
    'tQuestionTop =  Array("0", "475", "705", "1320", "1563", "1563")
    tQuestionTop =  Array("0", "475", "705", "1200", "1200", "1200")
    
    if tQuestionTop <> NULL then
	    Dim nScrollPos
	    nScrollPos = CDbl(tQuestionTop[nTIdx])
    
	    ContBody.Cont0.scroll_pos = nScrollPos
    end if
	
	Select case nQNum
		case 1, 2, 3, 4
		    for j = 0 to g_tAnswerCnt[nTIdx]	'nAnswerCnt
				nAnswerCnt = g_tAnswerCnt[j]
				
			    if j == nAnswerNum then
				    Form.SetCtlProp("ContBody.Cont0.ImgQ" & nQNum & "A" & j, "imgpath", CheckImgPath)
			    else
				    Form.SetCtlProp("ContBody.Cont0.ImgQ" & nQNum & "A" & j, "imgpath", unCheckImgPath)
			    end if
		    next
		case 5, 6
		    for j = 0 to g_tAnswerCnt[nTIdx]	'nAnswerCnt
				nAnswerCnt = g_tAnswerCnt[j]
				
			    if j == nAnswerNum then
				    Form.SetCtlProp("ContBody.Cont0.ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("ContBody.Cont0.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next		
    End Select

    Form.SetCtlProp("ContBody.Cont0.RadioQrg" & nQNum, "currentindex", nAnswerNum )    
End Function

