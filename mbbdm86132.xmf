'============================================================================

'전역변수 설정
Dim g_szRet				' Return 값
Dim g_szACNO '계좌번호
Dim g_szASNO '계좌일련번호
Dim g_szOsType
Dim g_nTooltip_Top

Dim g_szRet					'Return 값
Dim g_BDM_REG_UNIQ_NO			'등록고유번호 : 비대면계좌개설(YYYYMMDD+N+일련번호4자리), 비대면업무신청(YYYYMMDD+B+일련번호4자리)
Dim g_GOAL_MRKT_INFO_CLS_CODE	'목표시장정보구분코드
Dim g_szISCD					'v0004 상품코드
Dim g_nRegistCnt				'v0004 등록횟수


Dim unPressedImgPath 
Dim PressedImgPath

Dim unCheckImgPath 
Dim CheckImgPath

Dim g_tAnswerCnt
g_tAnswerCnt = Array("4", "4", "3", "5", "5", "2")' 각 문항 답변 갯수


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			'21.07.28 JHY START : 예외처리 추가
			'v006
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return
				end if
				
			else
				return
			end if
			'21.07.28 JHY END
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'f_SetSurvey(): 설문 셋팅
'============================================================================
Function f_SetSurvey(szTranID)
	Dim nDataCnt		'DATACOUNT
	Dim szQuestion	'문항내용
	Dim nQNum		'질문항
	Dim nItemNo		'아이템번호
	
	nDataCnt = tonumber(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1"))
	
	Dim szOsType
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	For i = 0 to nDataCnt - 1 
		nQNum = tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "QUES_QSIT_NO", i))
		nItemNo = tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ITEM_NO_VAL", i))
		szQuestion = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "GOAL_MRKT_QUES_QSIT_CNTT" , i))
		
		if szOsType == "1" then
			szQuestion = replace(szQuestion, "☆", "\n")
		else
			szQuestion = replace(szQuestion, "☆", "\r\n")
		end if
		
		if nItemNo == 0 then
			Form.SetCtlProp("ContBody.Cont0.LabelQ" & tostring(nQNum), "caption", nQNum & ". " &szQuestion)
		else
			Dim tLabelID
			tLabelID = Array("a", "b", "c","d", "e")
			
			Select Case nQNum
				Case 1
					Form.SetCtlProp("ContBody.Cont0.LblQ1A"& (nItemNo-1), "caption", szQuestion)
					ContBody.Cont0.RadioQrg1.SetRadioCaption(nItemNo-1, szQuestion)
				Case 2, 3 , 4
					Form.SetCtlProp("ContBody.Cont0.lbl"& tostring(nQNum) & tLabelID(nItemNo-1), "caption", szQuestion)
				Case 5
					Form.SetCtlProp("ContBody.Cont0.LblQ5A"& (nItemNo-1), "caption", szQuestion)
					ContBody.Cont0.RadioQrg5.SetRadioCaption(nItemNo-1, szQuestion)
				Case 6 
					Form.SetCtlProp("ContBody.Cont0.LblQ6A"& (nItemNo-1), "caption", szQuestion)
					ContBody.Cont0.RadioQrg6.SetRadioCaption(nItemNo-1, szQuestion)
			End Select
		end if
	Next
	
	'스타일 들어가는 설문항목들 적용
	ContBody.Cont0.lbl4a.changeTextAttr(0, 5, 343, -2, true)
	ContBody.Cont0.lbl4b.changeTextAttr(0, 5, 344, -2, true)
	ContBody.Cont0.lbl4c.changeTextAttr(0, 3, 344, -2, true)
	ContBody.Cont0.lbl4d.changeTextAttr(0, 5, 326, -2, true)
	ContBody.Cont0.lbl4e.changeTextAttr(0, 6, 326, -2, true)
	
	Dim nLen1
	nLen1 = ContBody.Cont0.LblQ1A0.getLen(ContBody.Cont0.LblQ1A0.caption)
	ContBody.Cont0.LblQ1A0.changeTextAttr(17, nLen1 - 17, 146, -2, false)
	
	nLen1 = ContBody.Cont0.LblQ1A1.getLen(ContBody.Cont0.LblQ1A1.caption)
	ContBody.Cont0.LblQ1A1.changeTextAttr(7, nLen1 - 7, 146, -2, false)
	
	nLen1 = ContBody.Cont0.LblQ1A2.getLen(ContBody.Cont0.LblQ1A2.caption)
	ContBody.Cont0.LblQ1A2.changeTextAttr(15, nLen1 - 15, 146, -2, false)
	
	nLen1 = ContBody.Cont0.LblQ1A3.getLen(ContBody.Cont0.LblQ1A3.caption)
	ContBody.Cont0.LblQ1A3.changeTextAttr(21, nLen1 - 21, 146, -2, false)
	
	Dim nLen2a
	nLen2a = ContBody.Cont0.lbl2a.getLen(ContBody.Cont0.lbl2a.caption)
	ContBody.Cont0.lbl2a.changeTextAttr(9, nLen2a - 9, 146, -2, false)
	
	Dim nLen2b
	nLen2b = ContBody.Cont0.lbl2b.getLen(ContBody.Cont0.lbl2b.caption)
	ContBody.Cont0.lbl2b.changeTextAttr(5, nLen2b - 5, 146, -2, false)
	
	Dim nLen2c
	nLen2c = ContBody.Cont0.lbl2c.getLen(ContBody.Cont0.lbl2c.caption)
	ContBody.Cont0.lbl2c.changeTextAttr(5, nLen2c - 5, 146, -2, false)
	
	Dim nLen2d
	nLen2d = ContBody.Cont0.lbl2d.getLen(ContBody.Cont0.lbl2d.caption)
	ContBody.Cont0.lbl2d.changeTextAttr(9, nLen2d - 9, 146, -2, false)
End Function
'============================================================================
'f_RegistSurvey(): 설문답변 등록
'============================================================================
Function f_RegistSurvey(szTranID)	
	Dim nBtnNum		'라디오 버든 수
	Dim nCurIdx		'선택된 인덱스
	Dim szQContent	'설문문항내용(lbl)
	Dim szRdoYN		'선택여부

	Dim nDataIdx
	nDataIdx = 0
	
	For i = 1 to 6
		Dim tRdoNumber
		tRdoNumber = Array("4", "4", "3", "5", "5", "2")
		nBtnNum = tonumber(tRdoNumber(i-1))
		For j = 0 to nBtnNum
			
			'설문문항내용 가져오기
			if j == 0 then
				szQContent = Form.GetCtlProp( "ContBody.Cont0.LabelQ" & i, "caption")
			else
				Select Case nQNum
					Case 1
						szQContent = ContBody.Cont0.RadioQrg1.GetRadioCaption( j - 1 )
					Case 2, 3 , 4
						Dim tLabelID
						tLabelID = Array("a", "b", "c","d", "e")	
						szQContent = Form.GetCtlProp( "ContBody.Cont0.lbl" & tostring(i) & tostring(tLabelID(j-1)), "caption")
					Case 5
						szQContent = ContBody.Cont0.RadioQrg5.GetRadioCaption( j - 1 )
					Case 6					
						szQContent = ContBody.Cont0.RadioQrg6.GetRadioCaption( j - 1 )
				End Select
			end if
			
			'선택여부 가져오기
			nCurIdx = tonumber(Form.GetCtlProp( "ContBody.Cont0.RadioQrg" & i, "currentindex" ))
			
			if nCurIdx + 1 == j then
				szRdoYN = "Y"
			else
				szRdoYN = "N"
			end if

			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "QUES_QSIT_NO" , nDataIdx , i )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "ITEM_NO_VAL" , nDataIdx , j )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RSPN_SLCT_YN" , nDataIdx, szRdoYN )
			nDataIdx = nDataIdx + 1
		Next
	Next
End Function
'============================================================================
'f_ChkAnswer: 설문응답 체크
'============================================================================
Function f_ChkAnswer()
	For i = 1 to 6
		Dim szCurIdx
		szCurIdx = tostring(Form.GetCtlProp( "ContBody.Cont0.RadioQrg" & i, "currentindex" ))
		if szCurIdx == "-1" then
			Form.ShowAlert( "알림" , i & "번 문항에 답을 하지 않았습니다." )
			return False
		end if
	Next
	
	return True
End Function
'============================================================================
'f_SetPFIN: 고객유형 체크
'============================================================================
Function f_SetPFIN(szPRSN_PFIN_CODE)
	if szPRSN_PFIN_CODE == "1" then
		ContBody.Cont0.RadioQrg1.currentindex = 1
		ContBody.Cont0.RadioQrg1.currentindex = 1
		
		ContBody_Cont0_RadioQrg1_OnClick(szPRSN_PFIN_CODE)
	end if
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()    
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		ContBody.Cont0.setScrollBarVisible("2")
	end if
	
	g_szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
    unCheckImgPath = "checkmenu_n.png"
    CheckImgPath   = "checkmenu_o.png"
    
    unPressedImgPath = "input_03_n.9.png"
    PressedImgPath   = "input_03_o.9.png"
    
    ContBody.lblLine.bgcolor = "342"
    
    ContBody.LabelInfoSub1.setNeighborCtlPos("ContBody.imgTooltip", "right", 8, "")
    
    ClearCheckAnswer("1")
    ClearCheckAnswer("2")
    ClearCheckAnswer("3")
    ClearCheckAnswer("4")
    ClearCheckAnswer("5")
    ClearCheckAnswer("6")
    
    g_BDM_REG_UNIQ_NO = Form.GetSharedData("BDM_REG_UNIQ_NO"        , False)  '등록고유번호
    
	g_szRet = "no"
	ContBody.Cont0.SetScrollAutoSize()
	
	Dim szData
	szData = Form.GetOpenLinkData()
	
	'test
	szData = "136".."★".."1".."★".."2"
	
'	g_szACNO = getListItem(szData, 0)	
'	g_szASNO = getListItem(szData, 1)	

	Dim szCusType
	g_szISCD = getListItem(szData, 0)	'상품코드
	szCusType = getListItem(szData, 1)	'고객유형
	g_nRegistCnt = CDbl(getListItem(szData, 2))	'등록 TR 돌리는 횟수
	
	ContBody.Cont0.RadioQrg1.currentindex = szCusType
	ContBody_Cont0_RadioQrg1_OnClick(szCusType)
	
	DATAMANAGER.RequestTranData( "obcsb_acif_831r" )
End Sub
'============================================================================
'Form_OnPopupReturn()
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbbdm86132_p1" Then
		'v0004 sta
		If sRet == "ok" Then
			g_szRet = "ok"
		Else
			g_szRet = "no"								
			Form.SetSharedData( "BDM_REG_SRNO" 				, "" )	'국내등록일련번호
			Form.SetSharedData( "BDM_GOAL_MRKT_UNFIT_YN" 		, "" )	'국내목표시장부적합여부 '(Y.목표시장부적합 N.정상)
			Form.SetSharedData( "BDM_ACFD_REG_SRNO" 			, ""	 )	'해외등록일련번호
			Form.SetSharedData( "BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, ""	 )	'해외목표시장부적합여부 '(Y.목표시장부적합 N.정상)
		End If
		'v0004 fin
		Form.CloseForm()
	end if
End Sub
'============================================================================
'Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbdm86132" , g_szRet)
End Sub
