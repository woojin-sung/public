			ButtonOK.btnimage = "btn_27.9"
		Else 
			ButtonOK.btnimage = "btn_21.9"
		End If
		ButtonOK.fgcolor = "269"
		
		DATAMANAGER.RequestTranData( "obaci_acct_266a" )
	end if
End Sub

