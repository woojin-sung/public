'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================


'============================================================================
Sub Form_OnFormInit()
	Cont0.Container2Step.Edit0.imagefilepth = "login_input.9.png"
	
	'2021.04.19. 김유경. 직종->대분류 변경
	'Cont0.Combo0.setApplyLabel("직종" , 0 , 76 , "left" , True )
	Cont0.Combo0.setApplyLabel("대분류" , 0 , 268 , "left" , True )
	
	'20210216 WHG
	Cont0.ButtonSearch.bringFront("0")
End Sub
'============================================================================
' Tab0_OnTabChanged
'============================================================================

'============================================================================
' imgClose_OnClick
'============================================================================
Sub Cont0_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()	
End Sub


'============================================================================
Sub Cont0_Container1Step_ButtonSearch_OnClick()

	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_LRDV_CODE" , 0 , "%")
	DATAMANAGER.RequestTranData("obcmm_kcdd_032r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranMessage(szTranID, szMsgCode, szMessage, szSubMessage)
	if szTranID == "obcmm_kcdd_032r" then
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcmm_kcdd_032r", "OutBlock1" ))

			Form.ShowAlert("		nCnt", nCnt)
		if nCnt > 0 then
			for i=0 to nCnt-1
				strCode = DATAMANAGER.GetDataValue( 0, "obcmm_kcdd_032r", "OutBlock1", "AML_OCKN_LRDV_CODE", i )
				Form.ShowAlert("strCode1", strCode)
				if strCode = "01" then
					strName = "관리자"
				elseif strCode = "02" then
					strName = "전문가 및 관련 종사자"
				elseif strCode = "03" then
					strName = "사무 종사자"
				elseif strCode = "04" then
					strName = "서비스 종사자"
				elseif strCode = "05" then
					strName = "판매 종사자"
				elseif strCode = "06" then
					strName = "농림어업 숙련 종사자"
				elseif strCode = "07" then
					strName = "기능원 및 관련 기능 종사자"
				elseif strCode = "08" then
					strName = "장치, 기계조작 및 조립종사자"
				elseif strCode = "09" then
					strName = "단순노무 종사자"
				elseif strCode = "OA" then
					strName = "군인"
				end if
				DATAMANAGER.SetDataValue 0, "obcmm_kcdd_032r", "OutBlock1", "AML_OCKN_EXPL", i, strName				
			next
		end if
		
		If DATAMANAGER.IsMoreNextData(szTranID) == true Then
			g_isNextFlag = true
		Else
			g_isNextFlag = False
		End If
	end if

End Sub

'============================================================================
Sub Cont0_Container1Step_Grid0_OnScrollEnd()
	If g_isNextFlag == true Then
		DATAMANAGER.RequestNextData("obcmm_kcdd_032r")
	End If
End Sub

'============================================================================
Sub Cont0_Container1Step_Table0_OnClick(lRow , lColumn)
	Cont0.Combo0.caption = Cont0.Container1Step.Table0.GetCellString( lRow, 1)
	Cont0.Container1Step.visible = False
	Cont0.Container2Step.visible = True
	Cont0.Container2Step.left    = 0
	
	Dim strCode
	strCode =  ""
	
	If lRow = 0 then
		strCode = "01"
	ElseIf lRow = 1 then
		strCode = "02"
	ElseIf lRow = 2 then
		strCode = "03"	
	ElseIf lRow = 3 then
		strCode = "04"	
	ElseIf lRow = 4 then
		strCode = "05"	
	ElseIf lRow = 5 then
		strCode = "06"	
	ElseIf lRow = 6 then
		strCode = "07"	
	ElseIf lRow = 7 then
		strCode = "08"	
	ElseIf lRow = 8 then
		strCode = "09"	
	ElseIf lRow = 9 then
		strCode = "OA"	
	End If 
	
	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_LRDV_CODE" , 0 , strCode )
	DATAMANAGER.RequestTranData("obcmm_kcdd_032r")
	
End Sub


'============================================================================
Sub Cont0_ButtonSearch_OnClick()
	Cont0.Container1Step.visible = True
	Cont0.Container2Step.visible = False
	Cont0.Container2Step.left    = 384
	Cont0.Combo0.caption         = "직종명을 선택해주세요."
End Sub

'============================================================================
Sub Cont0_Container2Step_Edit0_OnClick()
	Cont0.Container2Step.Label2.visible = False
End Sub

'============================================================================
Sub Cont0_Container2Step_Label2_OnClick()
	Cont0.Container2Step.Label2.visible = False
End Sub
'============================================================================
Sub Cont0_Container2Step_Edit0_OnEditComplete()
	If LEN(TRIM(Cont0.Container2Step.Edit0.caption)) = 0 Then
		Cont0.Container2Step.Label2.visible = True
	Else 
		Cont0.Container2Step.Label2.visible = False
	End If 
	
	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_LRDV_CODE" , 0 , strCode )
	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_NAME"      , 0 , Cont0.Container2Step.Edit0.caption)
	DATAMANAGER.RequestTranData("obcmm_kcdd_032r")
	
End Sub

'============================================================================
Sub Cont0_Container2Step_Grid0_OnClickUp(lRow, szCellID)

	sName = Cont0.Container2Step.Grid0.GetCellData("bd_cell0", lRow)
	lLrdv = Cont0.Container2Step.Grid0.GetCellData("bd_cell1", lRow)
	lSmdv = Cont0.Container2Step.Grid0.GetCellData("bd_cell2", lRow)
	
	Form.SetSharedData("13010_OCCU_NAME" , sName)
	Form.SetSharedData("13010_OCCU_LRDV" , lLrdv)
	Form.SetSharedData("13010_OCCU_SMDV" , lSmdv)
	
	Form.SendReturnToParent("mbbdm85151_p1" , sName)	

	Form.CloseForm()

End Sub


