'============================================================================
Sub Form_OnFormInit()
	
	acctItemType = Form.GetOpenLinkData()
	
	if acctItemType <> "" then
		Account0.itemcodetype = acctItemType
	end if
	
	
End Sub

'============================================================================
Sub btnSetting_OnClick()
	selectAccnt = Account0.caption
	Form.SendReturnToParent("AvgBuyPrice_Accnt_Select" , selectAccnt)
	Form.CloseForm()
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub
