'============================================================================
'20240502 SWJ START : 클라우드인증서 인증내역
'============================================================================
Dim g_sUseDate
g_sUseDate = ""

Dim g_sCompany
g_sCompany = ""

Dim g_sServiceName
g_sServiceName = ""

Dim g_sOsGubun
g_sOsGubun = ""

Dim g_sRegisterDate
g_sRegisterDate = ""

Dim g_sDeviceModel
g_sDeviceModel = ""

Dim g_sRetUseCnt
g_sRetUseCnt = 0

Dim g_sRetDeviceCnt
g_sRetDeviceCnt = 0

Dim g_sEachUseList
g_sEachUseList = Array()

Dim g_sEachDeviceList
g_sEachDeviceList = Array()

Dim tbl_Device
tbl_Device = Array()

Dim g_sTmpEachUseList
g_sTmpEachUseList = Array()

Dim gPannelIndex
gPannelIndex = 0

Dim g_bUseListFlag
g_bUseListFlag = False

Dim g_bDeviceListFlag
g_bDeviceListFlag = False

Dim g_bByeCloud
g_bByeCloud = False

Dim g_sCloudCertID
g_sCloudCertID = ""

Dim g_nIndex
g_nIndex = 0

Dim g_nNextRequest
g_nNextRequest = 0

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	imgNotice.setMaintainingRatio("1")
	contSearch.ImgMenu.setMaintainingRatio("1")	
	contSearch.ImgComboDown.setMaintainingRatio("1")	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_sCloudCertID = Form.GetOpenLinkData()
	
	Form.SetTimerEvent2(1, 1, 0.1)
	
	Pannel0.rowcount = 0
	
	contSearch.bgcolor = "320"
	
	contSearch_cmb0_OnEditComplete(0)
	
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) == 1 then
		'클라우드 인증서 목록이 있는지 확인하는 함수
		'(함수의 목적과 달리 연결 여부를 판단하려고 호출)
		'(일단 무언가를 호출해야 CLOUD_EVENT_ACQUIREUSERINFO 이벤트가 발생)
		
		Form.SetTimerEvent2(1, 0, 0.1)
		Form.requestCertCommand("CLOUD_REQ_DEVICE_LIST", "", "90154") 
		Form.requestCertCommand("CLOUD_REQ_USE_LIST", g_sCloudCertID , "90154")
	end if
End Sub
'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	
	
	'Form.ShowAlert(sCommand, sResult)
	
	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("안내" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if		
	
	if sCommand == "CLOUD_EVENT_ACQUIREUSERINFO" then
		CertListUI("No")
		
		'클라우드 정상 탈퇴 시
		'기기 인증 "CLOUDCERT_DEVICE_AUTH" 리턴 쪽에서
		'한번 더 조회시켜서 이 곳에서 리턴 받게 됨
		if g_bByeCloud = True then
			Form.OpenPopup("mhetc90150_p2" , "WithDrawal" , "")
		end if
	
	end if
	
	'응답 순서
	'처리코드, 처리메시지, rowCount, (디바이스ID, OS구분, 서비스명, 등록일시, 최종사용일시, OS버전, H/W모델명)
	'위 괄호 부분은 하트로 Array처럼 엮임
	if sCommand == "CLOUD_REQ_DEVICE_LIST_90154" then
		if #szItem > 2 then
			g_sRetDeviceCnt = Cint(szItem(2))
			
			for i = 0 to g_sRetDeviceCnt - 1
				g_sEachDeviceList(i) = szItem(i+3) 
			next
		end if
		
		g_bDeviceListFlag = True
		
	end if
	
	'응답 순서
	'처리코드, 처리메시지, rowCount, (행위명, 일자, 금융사명, 서비스명, OS구분)
	'위 괄호 부분은 하트로 Array처럼 엮임
	
	'코스콤에서 주는 데이터는 최대 100개라고 함
	if sCommand == "CLOUD_REQ_USE_LIST_90154" then	
		if #szItem > 2 then
			
			Dim sTmpEachUseList
			sTmpEachUseList = Array()
			
			g_sRetUseCnt = Cint(szItem(2))
			
			for i = 0 to g_sRetUseCnt - 1
			
				g_sTmpEachUseList(i) = szItem(i+3) 
			
			next	
		end if
		
		g_bUseListFlag = True
	
	end if
	
	if sCommand = "CLOUD_EVENT_PHONE_PROOF" then
		
		Form.openPopupAnimation("mhetc90303", sInput ,"","2") '클라우드 기기인증
		
		g_bByeCloud = True

	end if
	
	'연결 해제
	if sCommand = "CLOUD_REQ_DEVICE_DELETE_90154" then
		'단말 목록 재조회
		Form.SetTimerEvent2(1, 1, 0.1)
		
		Form.MsgBox("안내", "자동 연결이 해제 되었습니다.", "", 0)
	end if
	
	'한번만 UI 호출하기 위함
	if g_bDeviceListFlag and g_bUseListFlag then
		CertListUI("Yes")
		g_bUseListFlag = false
		g_bDeviceListFlag = false
	end if
	
End Sub
'============================================================================
Function CertListUI(sParam)
	
	if sParam == "Yes" then
		Pannel0.visible = True
		lbNoticeMsg.visible = False
		imgNotice.visible = False
		
		Dim sEachUseList
		
		for i = 0 to g_sRetUseCnt - 1
			
			g_sTmpEachUseList(i) = szItem(i+3) 
				
			sEachUseArray = Split(g_sTmpEachUseList(i) , "♥")
			
			if Ubound(sEachUseArray) > 0 then
					
				'화면에서 표기된 날짜에 대해 조회하기 위해
				'g_sEachUseList()에 대상 정보만 다시 담는다.
				nUselistDate = tonumber(Left(sEachUseArray(1), 8))
					
				if nUselistDate >= tonumber(contSearch.CalStart.caption) and nUselistDate <= tonumber(contSearch.CalEnd.caption) then
						
					g_sEachUseList(g_nIndex) = 	g_sTmpEachUseList(i)
					g_nIndex = g_nIndex + 1 
					
				end if
			end if
		next	
		
		Pannel0.rowcount = g_nIndex
		
		for nIndex = 0 to g_nIndex - 1
			
			sEachUseList = Split(g_sEachUseList(nIndex) , "♥")
			
			Pannel0.setPropCardCell("imgpath","Image0", nIndex, "bg_infobox_n.9")
			Pannel0.setPropCardCell("btnimage","Button0", nIndex, "btn_line2.9")
					
			Pannel0.setPropCardCell("maxlinecnt","LblQuestion0", nIndex , "1^-4")
			Pannel0.setPropCardCell("maxlinecnt","LblQuestion1", nIndex , "1^-4")
			Pannel0.setPropCardCell("maxlinecnt","LblQuestion6", nIndex , "1^-4")
			Pannel0.setPropCardCell("maxlinecnt","LblQuestion4", nIndex , "1^-4")
			Pannel0.setPropCardCell("maxlinecnt","LblQuestion5", nIndex , "1^-4")
					
			sdateData = Left(sEachUseList(1), 4) & "-" & MID(sEachUseList(1), 5, 2) & "-" & MID(sEachUseList(1),7, 2)
			stimeData = MID(sEachUseList(1), 9, 2) & ":" &  MID(sEachUseList(1), 11, 2) & ":" & Right(sEachUseList(1), 2)
					
			'이용시간
			Pannel0.SetCellValue("LblQuestion0", nIndex, sdateData & " " & stimeData)
					
			sTempCn = Split(sEachUseList(5), ",")
					
			if Ubound(sTempCn) > 0 then
						
				sCnData = Replace(sTempCn(0) , "cn=", "")
						
				if sCnData <> "" then
					'이름
					Pannel0.SetCellValue("LblQuestion", nIndex, sCnData)
				end if
			end if
					
			'이용기관
			Pannel0.SetCellValue("LblQuestion1", nIndex, sEachUseList(2))	
					
			'이용매체
			Pannel0.SetCellValue("LblQuestion6", nIndex, sEachUseList(3))	
					
			'이용내역
			Pannel0.SetCellValue("LblQuestion4", nIndex, sEachUseList(0))	
					
			'OS
			Pannel0.SetCellValue("LblQuestion5", nIndex, sEachUseList(4))	
					
			'단말ID 저장
			tbl_Device(nIndex) = sEachUseList(0)		
		next
		
	else
		Pannel0.visible = False
		lbNoticeMsg.visible = True
		imgNotice.visible = True
	end if
	
End Function
'============================================================================


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	'서비스 탈퇴 시
	'기기인증 후 리턴
	if sKeyName == "CLOUDCERT_DEVICE_AUTH" then
		Form.SetTimerEvent2(1, 1, 0.1)
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ByeCloud" then
		if sRet == "ok" then
			Form.requestCertCommand("CLOUD_REQ_DELETE_ACCOUNT", "", "90154")
		end if
	end if
	
	if sKeyName == "DisconnectCloud" then
		if sRet == "ok" then
			Form.requestCertCommand("CLOUD_REQ_DEVICE_DELETE", tbl_Device(Cint(nIndex)), "90154") 	
		end if
	end if
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	'연결해제
	if sCellID == "Button0" then
		Form.MsgBox("안내", "선택한 기기의 연결을\n해제하시겠습니까?", "DisconnectCloud", 7, "연결 해제", "취소")
	end if
End Sub
'============================================================================
Sub contSearch_ImgComboDown_OnClick()
	contSearch.cmb0.openlist()
End Sub

'============================================================================
Sub contSearch_cmb0_OnEditComplete(iIndex)
	
	sHostDate = Form.GetSharedData("&HOST_DATE", false)
	contSearch.CalStart.caption = sHostDate
	
	if iIndex == 0 then
		contSearch.CalStart.addday = -7
	elseif iIndex == 1 then
		contSearch.CalStart.addday = -30
	else
		contSearch.CalStart.addday = -90
	end if
	
	contSearch.CalEnd.caption = sHostDate
	sStartDate = contSearch.CalStart.caption
	
	contSearch.LblDate.caption = DateSetting(sStartDate, sHostDate)
	
	ClearAndRequest()
End Sub

'============================================================================
Sub contSearch_BtnStartDate_OnClick()
	'"1"은 그냥 넣어줌 메인에서 타입에 대한 로직 없음
	contSearch.CalStart.showcalendar = "1"
End Sub
'============================================================================
Sub contSearch_BtnEndDate_OnClick()
	'"1"은 그냥 넣어줌 메인에서 타입에 대한 로직 없음
	contSearch.CalEnd.showcalendar = "1"
End Sub

'============================================================================
Sub contSearch_CalStart_OnEditComplete()
	contSearch.LblDate.caption = DateSetting(contSearch.CalStart.caption, contSearch.CalEnd.caption)
	
	ClearAndRequest()
End Sub

'============================================================================
Sub contSearch_CalEnd_OnEditComplete()
	contSearch.LblDate.caption = DateSetting(contSearch.CalStart.caption, contSearch.CalEnd.caption)
	
	ClearAndRequest()
End Sub
'============================================================================
Function DateSetting(sStartDate, sEndDate)
	
	if sStartDate == "" or sEndDate == "" then
		return ""
	end if
	
	sStart = Mid(sStartDate,3,2) & Mid(sStartDate,5,2) & Right(sStartDate, 2)
	sEnd   = Mid(sEndDate,3,2) & Mid(sEndDate,5,2) & Right(sEndDate, 2)
	
	return sStart & sEnd
	
End Function
'============================================================================
Function ClearAndRequest()

	Pannel0.rowcount = 0
	g_nIndex = 0
	Form.SetTimerEvent2(1, 1, 0.1)
	
End Function
'============================================================================
Sub Pannel0_OnScrollEnd()
	
End Sub

	</SCRIPT_INFO>
