	<SCRIPT_INFO _len="8763" _ulen="8291" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_이체완료
' 02. 화면설명 : 이체확인 팝업
' 03. 작    성 : 16.03.02
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt '이체출금계좌
Dim g_szBank
Dim g_szRAcnt
Dim g_szAmnt
Dim g_szMyTip
Dim g_szRecvTip
Dim g_szRName
Dim g_szCom
'---------------------------------
Dim g_ExitType	'0:Clear 종료 , 1,2:이체완료화면
Dim g_szText		'단건일 경우 추가 메세지
'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Dim nCnt, nCntTotal, nTrCnt, nCntErr
	g_ExitType = 0
	nCntTotal = 0
	g_szAcnt = ""
	
	Label3.visible =1
	nTrCnt = Form.GetSharedData("61010_DELAY", true )
	arrCnt = Split(nTrCnt, "/")
	If Ubound(arrCnt) > 0 then
		nCntQuick = arrCnt(1) - arrCnt(2) - arrCnt(0)
		nCntTotal = arrCnt(1)
		nCntDelay = arrCnt(0)
		nCntErr = arrCnt(2)
		
		Table0.SetCellString( 0, 1, nCntTotal )'lblTotal.caption =  
		Table0.SetCellString( 0, 5, nCntDelay)'lblD.caption = 
		Table0.SetCellString( 0, 3, nCntQuick) 'nCntQuick
		Table0.SetCellString( 0, 7, nCntErr) 'nCntQuick
		
		if(nCntErr == "0" and nCntDelay =="0" ) then
			Label3.visible =0
		elseif (nCntErr <> "0" and nCntDelay <>"0") then
			Label3.visible =1
		elseif (nCntErr <> "0") then
			Label3.caption = "실패내역존재, 결과내역 확인요망"

		elseif (nCntDelay <> "0") then
			Label3.caption = "지연이체내역존재, 결과내역 확인요망"
		end if
	End If 
	szData = Form.GetOpenLinkData()
	
	if szData <> "" then
		arrData = Split(Trim(szData), "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시♥+'받는분'코드
'		Form.ShowAlert("Ubound(arrData)", Ubound(arrData))
		g_szAcnt = arrData(0)
		If Ubound(arrData) > 0 and Ubound(arrData) < 16 then
			g_szAcnt = arrData(0)'이체출금계좌
			g_szBank = arrData(1)
			g_szRAcnt = arrData(2)
			g_szAmnt = arrData(3)
			g_szMyTip = arrData(4)
			g_szRecvTip = arrData(5)
			g_szRName = arrData(6)
			g_szCom = arrData(7)
			g_szText = arrData(8)
			
			if g_szCom == "287" then
				contSingle.Table1.SetCellMaskInfo( 1, 2, "1,0,,,1,####-####-##,0,1,1")
			end if
			contSingle.Table1.SetCellString( 1, 0, g_szBank)
			contSingle.Table1.SetCellString( 1, 1, g_szRName)
			contSingle.Table1.SetCellString( 1, 2, g_szRAcnt) 
			contSingle.Table1.SetCellString( 2, 0, g_szAmnt)
			contSingle.Table1.SetCellString( 2, 1, g_szText)
			if g_szText <>"정상처리되었습니다." then
				contSingle.Table1.SetCellFgColor(2, 1, "10")
			end if
			contSingle.visible = True
			contMulti.visible = False
		    
		Else '다건 >>(1) g_szData  &"♥"& g_szFee  &"♥"& g_szCom &"♥"& g_szBrcd + 받는분'메세지 "|" >> (2)...
			arrMultiData = Split(Trim(szData), "|")
			nMultiCnt = Ubound(arrMultiData)
			Dim tData
			for i = 0 to nMultiCnt -1 
				tData = Split(Trim(arrMultiData(i)), "♥") 
				If Ubound(tData) > 0 then
					'nCnt = contMulti.Grid0.rowcount-1
					contMulti.Grid0.AddRow( )
					contMulti.Grid0.SetCellData( "bd_cell0", i, tData(1) )
					
					contMulti.Grid0.SetCellData( "bd_cell4", i, tData(9) )
					contMulti.Grid0.SetCellData( "bd_cell5", i, tData(3) )
					contMulti.Grid0.SetCellFgColor( "bd_cell5", i, "10" )
					'contMulti.Grid0.SetCellFgColor( "bd_cell1", i, "10" )
					contMulti.Grid0.SetCellData( "bd_cell1", i, tData(10) )
					if tData(10) <>"정상처리되었습니다." then
						contMulti.Grid0.SetCellFgColor( "bd_cell1", i, "10" )
					end if
					if tData(7) == "287" then
						Dim TempAcc
						TempAcc = Left(tData(2), 4)&"-"&Mid(tData(2), 5, 4)&"-"&Right(tData(2) , 2)
						contMulti.Grid0.SetCellData( "bd_cell2", i, TempAcc )
					else
						contMulti.Grid0.SetCellData( "bd_cell2", i, tData(2) )
					end if
'					if g_szCom == "287" then
'						contMulti.Grid0.SetCellIDMaskInfo( "bd_cell2", "1,0,,,1,####-####-##,0,1,1")
'					end if
					contSingle.visible = False
					contSingle.Label2.visible = False
					contMulti.visible = True  
				End If
			next   
		End If  
	end if  
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnScreen_OnClick()
    
	if Table0.GetCellString( 0, 3 ) <> "0" then
	   'Form.OpenScreen("mbbnk61010" , "이체완료"&"★"& "1" &"★"& g_szAcnt )
'		Form.SendReturnToParent("61010_pa" ,  "1" )
		g_ExitType = 1
	   'Form.triggerEvent("#", "61010_COMP", "이체완료"&"★"& "1" &"★"& g_szAcnt)
	   'Form.ShowAlert("결과", "1")
	elseif Table0.GetCellString( 0, 3 ) == "0" and Table0.GetCellString( 0, 5 ) == "0" then
		g_ExitType = 1                
	
	elseif Table0.GetCellString( 0, 3 ) == "0" and Table0.GetCellString( 0, 5 ) <> "0" then
'		g_ExitType = 1
		g_ExitType = 2
'		Form.SendReturnToParent("61010_pa" ,  "2" )
	   'Form.ShowAlert("결과", "2")
	end if  
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "빠른이체명" then	
	  If Trim(sRet) <> "" then
	    szName = Trim(sRet)
	    
	   
	    DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "CSNO" , 0 , "")	'고객번호
	    DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "PROS_CLS_CODE" , 0 , "I")	'등록삭제구분
	    DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "MNRC_ACNO" , 0 , g_szRAcnt)	'입금계좌번호
	    DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "MNRC_BANK_CODE", 0 , g_szCom)	'은행코드
		
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ACNO" , 0 , Left(g_szAcnt, 8))	'계좌번호
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ASNO", 0 , Right(g_szAcnt, 2))	'계좌일련번호
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "TR_AMT", 0 , g_szAmnt)
		
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ACNT_BNKB_EXRS_CNTT" , 0 , g_szMyTip)	'계좌표시
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "MNRC_ACNT_BNKB_EXRS_CNTT" , 0 , g_szRecvTip)	'입금계좌표시
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "FAST_TACT_NAME", 0 , szName)	'빠른이체명(별칭)

		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "RMT_NAME" , 0 , g_szRName)	'은행계좌명(수취인계좌명)		
		
		DATAMANAGER.RequestTranData("obtss_elbs_200a")
	 End If	
	End If	
End Sub

'============================================================================
Sub contSingle_btnOften_OnClick()
	'Form.SendReturnToParent("61010_pa" ,  "REG" )
	szIDNO = Form.GetSharedData("&JUMIN_NUM", false )
	sOpenData = "link" &"★"& szIDNO &"★"& "" &"★"& g_szBank &"★"& g_szRAcnt &"★"& g_szRName &"★"& "" &"★"& g_szCom &"★"& "" &"★"& g_szAcnt
	Form.OpenPopup("mbbnk61080_p1" , sOpenData , "")
End Sub

'============================================================================
Sub contSingle_btnQuick_OnClick()
	Form.OpenPopup("mbbnk61010_pc" , "" , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	msg = DATAMANAGER.GetDataMsgText( szTranID )
    
    Form.Toast( 0, msg, 0 )
End Sub



'============================================================================
Sub Form_OnFormClose()
	
	if g_ExitType == 1 then
		Form.SendReturnToParent("61010_pa" ,  "1" )
	elseif g_ExitType == 2 then
		Form.SendReturnToParent("61010_pa" ,  "2" )
	else
		Form.SendReturnToParent("61010_pa" , "reset")
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg ~= "" or szErrMsg ~= null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	if szTranID == "obtss_elbs_200a" then
		Form.ShowAlert( "알림", szErrMsg)
	end if
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtss_elbs_200a" trcode="obtss_elbs_200a" compress="1" encryption="1" inputcheck="1" digitalsign="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtss_elbs_200a" title="소액결제_빠른이체 등록 및 해지" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="585" _ulen="435" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
REG_SRNO^등록일련번호^11^0^7^0^0^0^0
FAST_TACT_NAME^빠른이체명^40^0^0^0^0^0^0
DRNG_ACNO^출금계좌번호^8^0^0^0^0^0^0
DRNG_ASNO^출금계좌일련번호^2^0^0^0^0^0^0
TR_AMT^거래금액^19^0^7^0^0^0^0
MNRC_BANK_CODE^입금은행코드^3^0^0^0^0^0^0
MNRC_ACNO^입금계좌번호^20^0^0^0^0^0^0
DRNG_ACNT_BNKB_EXRS_CNTT^출금계좌통장표시내용^40^0^0^0^0^0^0
MNRC_ACNT_BNKB_EXRS_CNTT^입금계좌통장표시내용^40^0^0^0^0^0^0
RMT_NAME^수취인명^40^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="50" _ulen="38" >

REG_SRNO^등록일련번호^11^0^7^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
