'============================================================================
' 화 면 명 : 외화이체 유의사항
'============================================================================

'============================================================================
Sub Form_OnFormInit()
	Container0.Label1.caption = "(뱅킹/대출 > 이체 > 이체정보 > 이체계좌관리 > 타금융내계좌)"
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	End If
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
    If sKey == "&LOGIN_AUTH" Then       
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    End If
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
