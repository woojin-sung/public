	<SCRIPT_INFO _len="10885" _ulen="9639" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 경고안내
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SecType		' 신용구분
Dim 	g_szOrd_SecDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부
Dim 	g_szErrMsg			' 경고메세지

'20200824 LES START 제도개선
Dim g_WarnClsCode			'경고구분코드
Dim gScrNo				'부모화면번호


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

	If g_nOrd_ChkAll = "1" Then
		If g_nIndex = 2 Then
			g_nOrd_Qty = "잔량"
		ElseIf g_nIndex = 3 Then
			g_nOrd_Qty = "전부"
		End If
	else
		g_nOrd_Qty = FormatNumber(g_nOrd_Qty,0).."주"
	End If
	
	If g_szOrder_MarketType = "W" Then	'ELW
		If g_nIndex = "0" Then
			lblTitle.caption = "ELW매수주문"
		ElseIf g_nIndex = "1" Then
			lblTitle.caption = "ELW매도주문"
		ElseIf g_nIndex = "2" Then
			lblTitle.caption = "ELW정정주문"
		ElseIf g_nIndex = "11" Then
			lblTitle.caption = "(예약)ELW매수주문"
		ElseIf g_nIndex = "12" Then
			lblTitle.caption = "(예약)ELW매도주문"
		End If
	End If
	
	If g_szOrd_Security = "1" Then'신용
		If g_nIndex = "0" Then
			lblTitle.caption = "신용매수주문"
		ElseIf g_nIndex = "1" Then
			lblTitle.caption = "신용매도주문"
		ElseIf g_nIndex = "2" Then
			'20230720 htw start text 변경
			lblTitle.caption = "정정주문"
			'20230720 htw start text 변경
		ElseIf g_nIndex = "11" Then
			lblTitle.caption = "(예약)신용매수주문"
		ElseIf g_nIndex = "12" Then
			lblTitle.caption = "(예약)신용매도주문"
		End If
	'20230720 htw start 대출매도 추가
	elseIf g_szOrd_Security = "2" Then''대출
		If g_nIndex = "1" Then'매도
			lblTitle.caption = "대출매도주문"
		end if
	'20230720 htw end 대출매도 추가
	End If
	
	
	'20200824 LES START 제도개선
	if gScrNo = "12000" or gScrNo = "12010" or gScrNo = "12020" then
		
		'20201117 LES START 제도개선
		lbl0.caption = Get_Warn_CLS_Name(g_WarnClsCode) & " 안내"
		
		Select Case g_WarnClsCode
			Case "3","6","9","c","f"
			'20230619 htw start 디자인 변경으로 인한 위치 값 변경
				imgMain.top = 296 - 72
				lbl0.top = 296 - 72
				lblTitle.top = 340 - 72
				lblMsg.top = 374 - 72
				lblMsg.height = 120
				
			Case "4","7","a","d","g"
				imgMain.top = 296 - 72
				lbl0.top = 296 - 72
				lblTitle.top = 340 - 72
				lblMsg.top = 374 - 72
				lblMsg.height = 120
			'20230619 htw end 디자인 변경으로 인한 위치 값 변경
		End Select
	
'		if g_WarnClsCode = "3" then
'			lbl0.caption = "투자유의 안내"
'			
'			lbl0.top = 56'lbl0.top - 18
'			lblMsg.top = 84'lblMsg.top - 18
'			lblMsg.height = 120'lblMsg.height + 18
'			
'		elseif g_WarnClsCode = "4" then
'			lbl0.caption = "투자유의/경고 안내"
'			
'			lbl0.top = 56'lbl0.top - 18
'			lblMsg.top = 84'lblMsg.top - 18
'			lblMsg.height = 120'lblMsg.height + 18
'			
'		else
'			lbl0.caption = "경고 안내"
'		end if
		
		'20201117 LES END
		
	end if
	'20200824 LES END
	
	
	lblMsg.caption = g_szErrMsg	
	
	Dim szStr1,szStr2,szStr3
	szStr1 = left(g_szOrder_Acc,4)
	szStr2 = mid(g_szOrder_Acc,5,4)
	szStr3 = right(g_szOrder_Acc,2)
	
	tbl0.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName	)
	tbl0.SetCellString( 1, 1, g_szOrd_ItmName 	)
	tbl0.SetCellString( 2, 1, g_nOrd_Qty			)
	if Trim(g_nOrd_Price) <> "" then	
		tbl0.SetCellString( 3, 1, FormatNumber(g_nOrd_Price,0).."원")
	end if

End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	if szData <> "" then
		arrData = Split(szData,"|")
	
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if	
		
		g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 11:예약매수, 12:예약매도, 14:예약취소)
		g_szOrder_MarketType	= arrData( 1)	' 주문종류 ( J:주식, W:ELW )
		g_szOrder_Acc			= arrData( 2)	' 계좌번호
		g_szOrder_AccName		= arrData( 3)	' 고객명
		g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
		g_szOrd_ItmName 		= arrData( 5)	' 종목명
		g_szOrd_OrdType  		= arrData( 6)	' 주문구분
		g_szOrd_Security 		= arrData( 7)	' 현금/신용
		g_szOrd_SecType 		= arrData( 8)	' 신용구분
		g_szOrd_SecDate 		= arrData( 9)	' 대출일자
		g_nOrd_Qty   			= arrData(10)	' 주문수량
		g_nOrd_Price 			= arrData(11)	' 주문가격
		g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
		g_nOrd_ChkAll 		= arrData(13)	' 잔량전부
		g_szErrMsg	 		= arrData(14)	' 경고메세지
		
		'20200824 LES START 제도개선
		'주식주문/예약주문/호가주문 화면에서 주문냈을 경우에만 탐.
		gScrNo = Form.GetSharedData( "&SCREEN_NO" , false )
		
		if gScrNo = "12000" or gScrNo = "12010" or gScrNo = "12020" then
			g_WarnClsCode 	= arrData(15) '경고구분코드	 
		end if
		'20200824 LES END
		
		
		if gScrNo = "12000" then
			Dim szColor
			szColor = "4"
			
			if CInt(g_nIndex) == 0 or CInt(g_nIndex) == 11 then
				szColor = "290"
			elseif CInt(g_nIndex) == 1 or CInt(g_nIndex) == 12 then
				szColor = "291"
			elseif CInt(g_nIndex) == 2 then
				szColor = "292"
			elseif CInt(g_nIndex) == 3 or CInt(g_nIndex) == 14 then
				szColor = "293"
			end if
			tbl0.SetCellFgColor(3, 1, szColor)
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	If g_nIndex = "0" Then
		lblTitle.caption = "현금매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_etc10.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "1" Then
		lblTitle.caption = "현금매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_etc11.9"
		btnOrder.caption="매도"
	
	ElseIf g_nIndex = "2" Then
		'20230720 htw start text 변경
		lblTitle.caption = "정정주문"
		'20230720 htw end text 변경
		lblTitle.bgcolor = "93"
		tbl0.SetCellFgColor( 4, 0, "8" )
		tbl0.SetCellFgColor( 4, 1, "8" )
		btnOrder.btnimage = "btn_etc17.9"
		btnOrder.caption="정정"
		
	ElseIf g_nIndex = "11" Then
		lblTitle.caption = "(예약)현금매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_etc10.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "12" Then
		lblTitle.caption = "(예약)현금매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_etc11.9"
		btnOrder.caption="매도"
	
	ElseIf g_nIndex = "14" Then
		lblTitle.caption = "(예약)현금취소주문"
		lblTitle.bgcolor = "93"
		tbl0.SetCellFgColor( 4, 0, "9" )
		tbl0.SetCellFgColor( 4, 1, "9" )
		btnOrder.btnimage = "btn_etc18.9"
		btnOrder.caption="취소"
		
	End If	

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub


'============================================================================
Sub btnOrder_OnClick()
	SendOrder()
End Sub

'============================================================================
'20201117 LES START
'============================================================================
Function Get_Warn_CLS_Name(clsCode)
	
	Select Case clsCode
		Case "1"
			return "경고"
			'Get_Warn_CLS_Name = "경고"
		Case "2"
			return "보류"
			'Get_Warn_CLS_Name = "보류"
		Case "3"
			return "투자유의"
			'Get_Warn_CLS_Name = "투자유의"
		Case "4"
			return "투자유의/경고"
			'Get_Warn_CLS_Name = "투자유의/경고"
		Case "5"
			return "투자유의/보류"
			'Get_Warn_CLS_Name = "투자유의/보류"
		Case "6"
			return "단기과열종목"
			'Get_Warn_CLS_Name = "단기과열종목"
		Case "7"
			return "단기과열종목/경고"
			'Get_Warn_CLS_Name = "단기과열종목/경고"
		Case "8"
			return "단기과열종목/보류"
			'Get_Warn_CLS_Name = "단기과열종목/보류"
		Case "9"
			return "투자경고"
			'Get_Warn_CLS_Name = "투자경고"
		Case "a"
			return "투자경고/경고"
			'Get_Warn_CLS_Name = "투자경고/경고"
		Case "b"
			return "투자경고/보류"
			'Get_Warn_CLS_Name = "투자경고/보류"
		Case "c"
			return "투자위험"
			'Get_Warn_CLS_Name = "투자위험"
		Case "d"
			return "투자위험/경고"
			'Get_Warn_CLS_Name = "투자위험/경고"
		Case "e"
			return "투자위험/보류"
			'Get_Warn_CLS_Name = "투자위험/보류"
		Case "f"
			return "정리매매"
			'Get_Warn_CLS_Name = "정리매매"
		Case "g"
			return "정리매매/경고"
			'Get_Warn_CLS_Name = "정리매매/경고"
		Case "h"
			return "정리매매/보류"
			'Get_Warn_CLS_Name = "정리매매/보류"
		Case Else
			return "경고"
			'Get_Warn_CLS_Name = "경고"
	End Select
	
	
	
End Function



'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>