'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetMarketCategory("1")		   'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
	ChartEx0.SetLoadChart("jisu")
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	rdoPeriod01.SetRadioCaption( 2, szMin0.."분" )
	rdoPeriod01.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END
End Sub

'============================================================================
'Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szIndexCode	= Form.GetSharedData("42000INITCODE" , 0)
	
	g_flagMin = false
	g_flagTic = false
	g_flagLine = false
	g_flagWeek = false
	g_flagInit = true
	
	SetChart()
	
'	g_szChrtType = "D" '일
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
'	g_szMinType = "1"
'	g_szTicType = "1"
'	PeriodSet(g_szChrtType)
	RequestData()
End Sub

'============================================================================
'rdoPeriod01_OnClick
'============================================================================
Sub rdoPeriod01_OnClick(nIndex)
	if nIndex == 0 then  '일
		g_szChrtType = "D"
		g_flagWeek = false
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then  '주
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false   then
			sTemp = rdoPeriod01.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
			else
				g_szChrtType = "W"
			end if
			
			g_flagWeek = true
			PeriodSet(g_szChrtType)
			
		else
			sTemp = rdoPeriod01.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_p3.xmf", sTemp, "" )
			
		end if
		'-----------------------------------------------------
'		if g_flagWeek = true   then
'			if g_szChrtType = "W" then
'				g_szChrtType = "M"
'				g_flagWeek = false
'				rdoPeriod01.SetRadioCaption( 1, "월" )
'			else
'				g_szChrtType = "W"
'			end if
'		else
'			if g_szChrtType = "M" then
'				g_szChrtType = "W"
'				g_flagWeek = true
'				rdoPeriod01.SetRadioCaption( 1, "주" )
'			else
'				g_szChrtType = "M"
'			end if
'		end if	
'				
'		PeriodSet(g_szChrtType)
		'-----------------------------------------------------
	elseif nIndex == 2 then  '분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin = false then
			g_flagMin = true
			tmpMin = split(rdoPeriod01.GetRadioCaption(2),"분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
			
		else
			'g_flagMin = false
			Form.OpenPopup( "mhcht13000_p1" , g_szMinType , "" )
			
		end if
		
	elseif nIndex == 3 then  '틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"
		
		if g_flagTic = false then
			g_flagTic = true
			tmpTic = split(rdoPeriod01.GetRadioCaption(3),"틱")
			g_szTicType = tmpTic[0]
			
			PeriodSet(g_szChrtType)
			
		else
			Form.OpenPopup( "mhcht13000_p2" , g_szTicType , "" )
			'g_flagTic = false
			
		end if
	end if
	
End Sub

