'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szRealCode
	
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
	DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szIndexCode)	
	DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
	
	g_flagInit = false 
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "42000ITEMCODE" then
		if g_szIndexCode = sParam and g_flagInit = false then
			exit Sub
		end if
		
		g_szIndexCode	= sParam
		RequestData()
	end if 
End Sub

'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "Chart_Min" then
		g_szMinType = sRet
		rdoPeriod01.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(rdoPeriod01.GetRadioCaption(2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName = "Chart_Tic" then
		g_szTicType = sRet		
		rdoPeriod01.SetRadioCaption( 3, g_szTicType )
		tmpTic = split(rdoPeriod01.GetRadioCaption(3),"틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		
		rdoPeriod01.SetRadioCaption( 1, sRet )
		PeriodSet(g_szChrtType)	
	end if
End Sub

'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szIndexCode		= Cstr(Trim(Data[0]))             '코드
	g_sPeriodType		= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod		= Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh			= Cstr(Trim(Data[3]))
	
	'20221117 LES START 차세대 업종코드 변경
	'차세대 이전 업종코드로 저장되어 있는 차트 데이터일 경우
	'업종코드 변환 및 차트에 저장되어있는 업종코드도 변경하는 함수 호출
	nCodeLen = Form.getLen(g_szIndexCode)
	
	if nCodeLen < 6 then
		g_szIndexCode = Form.ConvertUpjongCode(g_szIndexCode)
		ChartEx0.SetChangeNewCode(g_szIndexCode)	
	end if
	
	'20221117 LES END
	
	radioIndex = ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		rdoPeriod01.SetRadioCaption( 3, sTic.."틱" )
		rdoPeriod01.SetRadioCaption( 2, sMin.."분" )
		
	else
		'PENTA13 START => 2023.08.07(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				rdoPeriod01.SetRadioCaption( radioIndex, g_sPeriod.."틱")
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				rdoPeriod01.SetRadioCaption( radioIndex, g_sPeriod.."분")
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
			
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				rdoPeriod01.SetRadioCaption( radioIndex, "주")
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				rdoPeriod01.SetRadioCaption( radioIndex, "월")
		
		end Select
		'PENTA13 END
	end if
	
	'PENTA13 START => 2023.07.13(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		rdoPeriod01.currentindex = radioIndex
	else
		rdoPeriod01.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		rdoPeriod01.enable = 1
	end if
	'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szIndexCode , "market")
	Form.SetItemCode(g_szIndexCode)	
	RequestData()		
end function

'============================================================================
'PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		Exit function
	end if

	if nIndex < 1 then
		Exit function
	end if

	Data = split(sData, ";")
	
	g_sPeriodType   = Cstr(Trim(Data[2]))
	g_sPeriod       = Cstr(Trim(Data[3]))
     
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then		'틱
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			rdoPeriod01.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else								'분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			rdoPeriod01.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			rdoPeriod01.SetRadioCaption( g_TempIndex, "주" )
			
		else								'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			rdoPeriod01.SetRadioCaption( g_TempIndex, "월" )
		
		end if
		
	end if
	
	rdoPeriod01.setCurIndexSilent(g_TempIndex)

	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		rdoPeriod01.enable = 0
	end if

end function
'PENTA13 END
'============================================================================
Sub ChartEx0_OnScrollEnd()
	if g_sPeriodType = "1"	then				'분
		DATAMANAGER.RequestNextData("ohhts_5020_002r")
	
	elseif g_sPeriodType =	"0"	then			'틱
		DATAMANAGER.RequestNextData("ohhts_5020_003r")
		
	else
		DATAMANAGER.RequestNextData("ohhts_5020_001r")
		
	end if
End Sub

'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
   if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   'Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
		Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )
	   next
	   
   end if
end function

'============================================================================
Sub Form_OnFormClose()
	Form.SetEnvData( 1,"42000_CHARTSET" 			, g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"42000_CHARTSETMINTICK" 	, g_szMinType.."^"..g_szTicType )

	ChartEx0.SetSaveChart("1")
End Sub
'============================================================================
Sub BtnLine_OnClick()
	if g_flagLine = false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath = "btn_chart01_o.9.png"
		
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath = "btn_chart01_n.9.png"
		
	end if
End Sub
