Sub edtPwd_OnEditComplete()
	if edtPwd.caption == "" then
		Exit Sub
	end if
	
	'계좌비밀번호 검증
	DATAMANAGER.RequestTranData( "obacp_opop_066r" )
End Sub

'============================================================================
Sub contAgree_btnNext_OnClick()

    DATAMANAGER.RequestTranData( "obaci_acct_156r" )

End Sub

'============================================================================
Sub contSelect_grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_check" Then
		g_nSelectIndex = lRow
		
		'하나만 선택되어야 하므로 나머지 체크 전부 해제
		For i = 0 to CInt(contSelect.grdList.rowcount)
			If i <> g_nSelectIndex Then
				contSelect.grdList.SetCellData("bd_check", i, "0")
			End If
		Next
		
		f_CheckAcntSelect()
	End If
End Sub

'============================================================================
Sub contSelect_btnNext_OnClick()
	If g_nSelectIndex <> -1 Then
		contSelect.visible = false
		contInput.visible = true
		
		f_SetInputArea()
	End If
End Sub

'============================================================================
Sub contInput_btnOrg_OnClick()
	'금융기관 선택 팝업 오픈
	Form.OpenPopupAnimation( "mbonl93102_p4" , "" , "" , "2" )
End Sub

'============================================================================
Sub contInput_btnNext_OnClick()
	'정보입력 영역 다음 버튼
	contInput.visible = false
	contConfirm.visible = true
	
	f_SetConfirmArea()
End Sub

'============================================================================
Sub contConfirm_btnNext_OnClick()

	'정보확인 영역 다음 버튼
	'인증 절차 후 실행 서비스 호출
	Dim szCertUseType 
	'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
	szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
	
	If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
	    Form.OpenFramePopup( "mhetc90060_px" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
	Else
	    Form.OpenFramePopup( "mhetc90060_p5" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
	End If

End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
    	edtPwd.caption = ""
	f_InitScreen()
End Sub

'============================================================================
Sub contAgree_btnAgreeAll_OnClick()
	If g_bAgree1 and g_bAgree2 Then
		'전부 동의 상태일 경우 체크 해제
		g_bAgree1 = false
		g_bAgree2 = false
		
		contAgree.imgAgree1.imgpath = "check_off.png"
		contAgree.imgAgree2.imgpath = "check_off.png"
	Else
		'한번에 확인 및 동의 시 차례대로 약관 띄움
		'mbonl93102_p3 > mbonl93102_p2
		'g_bAgreeAll = true
		
		'금융거래정보 제공 동의 등 팝업
		Form.OpenFramePopup("mbonl93102_p2" , "", "")		
		Form.OpenFramePopup("mbonl93102_p3" , "", "") 
	End If
	
	f_CheckAgreeNext()
End Sub

