    (기관명 오류 선택시 접수거부 처리 될 수 있습니다.)" valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="30,233,331,40,1" />
				<GRID name="GridInfo" colcount="2" ly_vert="21,139,333,37,1" ver="1" >
					<CONTROL_INFO>
						<LABEL name="bd_cell0" autofontsize="1" />
						<LABEL name="bd_cell1" autofontsize="1" />
					</CONTROL_INFO>
					<DEFAULTINFO usetopheader="0" border="0000" inlinecolor="025:255255255" />
					<COLINFO ly_vert_width="170,170" ly_vert_visible="0,0" >
						<COLUMN colcount="1" >
							<SUBCOLINFO ly_vert_width="170" ly_vert_visible="0" />
							<BODY rowcount="1" >
								<ROWINFO ly_vert_height="38" />
								<CELLINFO>
									<CELL name="bd_cell0" cell_ly="0,0,0,0" line="0,0" >
										<STATECOMP_INFO desttype="1" />
									</CELL>
								</CELLINFO>
							</BODY>
						</COLUMN>
						<COLUMN colcount="1" >
							<SUBCOLINFO ly_vert_width="170" ly_vert_visible="0" />
							<BODY rowcount="1" >
								<ROWINFO ly_vert_height="38" />
								<CELLINFO>
									<CELL name="bd_cell1" cell_ly="0,0,0,0" line="0,0" >
										<STATECOMP_INFO desttype="1" />
									</CELL>
								</CELLINFO>
							</BODY>
						</COLUMN>
					</COLINFO>
					<UPDATETR_INFO/>
					<UPDATEBC_INFO keycellid="bd_cell0" rangecellid="bd_cell0" hlcolorcellid="bd_cell0" />
				</GRID>
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="28819" _ulen="26081" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 연금저축 타사에서 가져오기
' 02. 화면설명 : 
' 03. 이    력 : 2024.01.25 : 고승연 : v0002 : 연금저축 계좌목록 조회 수정
'                2024.03.04 : 고승연 : v0003 : 계좌정보 조회 수정
'-------------------------------------------------------------------------------------------

Dim g_bAgree1						'약관동의 여부1
Dim g_bAgree2						'약관동의 여부2
Dim g_bNextFlag					'타사연금저축 연속조회 플래그
Dim g_szLnkdTlmsMnno				'연계전문번호
Dim g_nSelectIndex				'타사연금저축계좌 선택 인덱스
Dim g_szRnmcYn					'받을 계좌 실명확인여부
Dim g_szOtherAcnt					'연금기관 계좌번호
Dim g_szOtherCode					'연금기관코드
Dim g_szOtherClsCode				'연금이전기관구분코드
Dim g_OpenBDMScreenYN               '비대면계좌개설 화면 오픈 여부
'Dim g_bAgreeAll					'약관 및 유의사항 연속동의 플래그

Dim g_DeviceOS	'v0002
Dim g_sCsno		'v0002
Dim g_sElfnId		'v0002

'============================================================================
Sub Form_OnFormInit()
	
	'v0002
    g_DeviceOS = Form.GetSharedData("&OS_TYPE", FALSE) '1.안드로이드 2.iOS
    g_sCsno = Form.GetSharedData("&CUST_NUM", FALSE)
    g_sElfnId = Form.GetSharedData("&USER_ID", FALSE)
    
	'그리드 카드 배경 설정
	contSelect.grdList.setUseCardView(true, 10, "input_03_n.9.png")

	edtPwd.caption = ""
	f_InitScreen()
	
	'연금저축계좌 조회
	Dim szAcntNum
	szAcntNum = acnt.total
	if szAcntNum <> "" and szAcntNum <> null then
		cmbAcnt.clear = "1"
		g_OpenBDMScreenYN = "Y"
		'v0002
		DATAMANAGER.RequestTranData( "obaci_acct_277r" )
	else
		Form.ShowAlert( "오류", "연금계좌 조회 오류" )
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	'연금저축 유의사항 팝업 리턴
	If sKeyName == "mbonl93102_p2" Then
		If sRet == "Agree" Then
			g_bAgree2 = true
			contAgree.imgAgree2.imgpath = "check_on.png"
		End If
		
		f_CheckAgreeNext()
			
		'전체동의 누르는 케이스
		'If g_bAgreeAll Then
			'g_bAgreeAll = false
		'End If
	
	'금융거래정보 제공 동의 팝업
	ElseIf sKeyName == "mbonl93102_p3" Then
		If sRet == "Agree" Then
			g_bAgree1 = true
			contAgree.imgAgree1.imgpath = "check_on.png"
		End If
		
		f_CheckAgreeNext()
			
		'전체동의 누르는 케이스
		'If g_bAgreeAll Then
			'연금저축 유의사항 팝업
			'Form.OpenFramePopup("mbonl93102_p2" , "", "")
		'End If
	
	'금융기관 선택 팝업 리턴
	ElseIf sKeyName == "mbonl93102_p4" Then
		If sRet <> "" and sRet <> null Then
			Dim tData
			tData = Split(sRet, "★")
			
			'선택한 금융기관 세팅 및 필요한 데이터 저장
			contInput.cmbOrg.caption = tData[0]
			
			g_szOtherCode = tData[1]
			g_szOtherClsCode = tData[2]
			
			'contInput에서는 기관만 선택하면 다음버튼 활성화(나머지 항목들은 디폴트 선택값이 있음)
			contInput.btnNext.enable = true
		End If
	
	'공동인증 및 바이오인증 완료
	ElseIf sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" Then
			'신연금저축이수신청
			DATAMANAGER.RequestTranData( "obaci_acct_153a" )
		End If
		
	'간편인증 완료
	ElseIf sKeyName == "mhetc90060_px" Then 
		If sRet == "ok" Then
			'신연금저축이수신청
			DATAMANAGER.RequestTranData( "obaci_acct_153a" )
		End If
	
	'완료팝업화면 리턴
	ElseIf sKeyName == "mbonl93102_p5" Then
		'화면 초기화 후 연금저축계좌 조회
		edtPwd.caption = ""
		
         cmbAcnt.visible = True
         edtPwd.visible = True
		
		f_InitScreen()
		
		Dim szAcntNum
		szAcntNum = acnt.total
		if szAcntNum <> "" and szAcntNum <> null then
			cmbAcnt.clear = "1"
			g_OpenBDMScreenYN = "N"
			'DATAMANAGER.RequestTranData( "obaci_acct_144r" )
			DATAMANAGER.RequestTranData( "obaci_acct_277r" )
		else
			Form.ShowAlert( "오류", "연금계좌 조회 오류" )
		end if
	
	'연금저축계좌없음 팝업 리턴
	ElseIf sKeyName == "mbonl93102_p6" Then
		If sRet == "Quit" Then
			Form.OpenPrevScreen()
		ElseIf sRet == "OpenAcnt" Then
			'Form.OpenScreen("85100" , "")	'비대면 계좌개설 화면 이동
			Form.LogOut(0,1)
			Form.OpenPopup("mbbdm85100.xmf" , "" , "")
		End If
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'obaci_acct_275r 재조회 타이머
	sTimerID = CInt(sTimerID)
	If sTimerID == 1000 Then
		Form.SetTimerEvent(1000, 0, 1.5)
		
		'전체금융기관연금저축계좌 조회(연속조회)
		DATAMANAGER.RequestTranData( "obaci_acct_275r" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno, szAsno
	szAcno = Left(cmbAcnt.cbkeydata, 8)
	szAsno = Right(cmbAcnt.cbkeydata, 2)

	'연금저축계좌 조회
	If szTranID == "obaci_acct_144r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "0" )
		
	'계좌비밀번호 검증
	ElseIf szTranID == "obacp_opop_066r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , szAcno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , szAsno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , edtPwd.caption )
	
	'전체금융기관연금저축계좌 조회
	ElseIf szTranID == "obaci_acct_275r" Then
		'경우에 따라 연속조회
		If g_bNextFlag Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , szAcno )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "2" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_TLMS_MNNO" , 0 , g_szLnkdTlmsMnno )
		'최초조회
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , szAcno )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_TLMS_MNNO" , 0 , "" )
		End If
	
	'신연금저축이수신청
	ElseIf szTranID == "obaci_acct_153a" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , szAcno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , szAsno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PNSN_TACT_PROS_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACPT_DATE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SRNO" , 0 , 0 )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RCTF_YN" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PNSN_MOVE_ISTU_CLS_CODE" , 0 , g_szOtherClsCode )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PNSN_OTCO_TCTR_ISTU_CODE" , 0 , g_szOtherCode )
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "OTCO_ACNO" , 0 , g_szOtherAcnt )
		If contInput.cmbSignDate.currentindex == "0" or contInput.cmbSignDate.currentindex == 0 Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "JOIN_DATE_CLCD" , 0 , "2" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "JOIN_DATE_CLCD" , 0 , "1" )
		End If
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RFND_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RFND_ASNO" , 0 , "" )
		Dim szType
		szType = contSelect.grdList.GetCellData("bd_type", g_nSelectIndex)
		If Trim(szType) == "연금저축" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PNSN_SVNG_ACNT_TPCD" , 0 , "1" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PNSN_SVNG_ACNT_TPCD" , 0 , "2" )
		End If
		If contInput.rdoConfirmMthd.currentindex == "0" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "TACT_INTN_CNFR_MTHD" , 0 , "1" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "TACT_INTN_CNFR_MTHD" , 0 , "2" )
		End If
		If g_szRnmcYn == "Y" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RNMC_YN" , 0 , "1" )
		ElseIf g_szRnmcYn == "N" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RNMC_YN" , 0 , "2" )
		End If
		
	'v0002
	'연금저축계좌 목록 조회
	ELSEIF szTranID == "obaci_acct_277r" THEN
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , g_sCsno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_sElfnId )
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'연금저축계좌 조회
	If szTranID == "obaci_acct_144r" then
		
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		
		Dim szAcno, szAsno, szStatCode, szCustName
		szCustName = Form.GetSharedData( "&USER_NAME", false )
		for i = 0 to nCnt - 1
			szAcno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ACNO" , i )
			szAsno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ASNO" , i )
			szStatCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PNSN_TACT_ACNT_STAT_CODE" , i )
			
			'조회된 계좌들중 szStatCode가 "00"인 계좌만 콤보에 세팅
			If szStatCode == "00" Then
				cmbAcnt.cbadddatatext = szAcno .. szAsno .. "`" .. "[연금저축] " .. Left(szAcno, 4) .. "-" .. Right(szAcno, 4) .. "-" .. szAsno .. " " .. szCustName
			End If
		next
		
		'다음조회 데이터들이 있다면 연속해서 조회
		if DATAMANAGER.IsMoreNextData(szTranID) then
			DATAMANAGER.RequestNextData(szTranID)
			Exit Sub
		end if		
		
		'계좌조회 후 비밀번호 관련 초기화
		edtPwd.caption = ""
		g_bPwd = false
		
		'조회된 계좌가 없을 경우 안내문구 팝업
		Dim szTemp
		szTemp = cmbAcnt.caption		'하나라도 해당되는 계좌가 있으면 caption으로 나올듯
		If szTemp == "" or szTemp == null Then
		
			edtPwd.enable = False		
		
		    If g_OpenBDMScreenYN == "Y" Then
		        Form.OpenPopup("mbonl93102_p6" , "", "")
		    End If
		    
		End If
	
	'v0002
	'이수가능계좌 조회
	ELSEIF szTranID == "obaci_acct_277r" THEN
		
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		
		Dim szAcno, szAsno, szStatCode, szCustName
		
		FOR i = 0 TO nCnt - 1
			szAcno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ACNO" , i )
			szAsno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ASNO" , i )
			szCustName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CSNM" , i )
	
			cmbAcnt.cbadddatatext = szAcno .. szAsno .. "`" .. "[연금저축] " .. LEFT(szAcno, 4) .. "-" .. RIGHT(szAcno, 4) .. "-" .. szAsno .. " " .. szCustName
		NEXT
		
		'다음조회 데이터들이 있다면 연속해서 조회
		IF DATAMANAGER.IsMoreNextData(szTranID) THEN
			DATAMANAGER.RequestNextData(szTranID)
			EXIT SUB
		END IF
		
		'계좌조회 후 비밀번호 관련 초기화
		edtPwd.caption = ""
		g_bPwd = FALSE
		
		'조회된 계좌가 없을 경우 안내문구 팝업
		Dim szTemp
		szTemp = cmbAcnt.caption		'하나라도 해당되는 계좌가 있으면 caption으로 나올듯
		IF szTemp == "" OR szTemp == NULL THEN
		
			edtPwd.enable = FALSE
		
		    IF g_OpenBDMScreenYN == "Y" THEN
		        Form.OpenPopup("mbonl93102_p6" , "", "")
		    END IF
		    
		END IF
		
	'계좌비밀번호 검증
	ElseIf szTranID == "obacp_opop_066r" Then
		'계좌비밀번호 정상입력
		f_InitScreen()
		
		'약관 영역 보여줌
		contAgree.visible = true
		contAgree.btnAlpha.visible = false
	
	'전체금융기관연금저축계좌 조회
	ElseIf szTranID == "obaci_acct_275r" Then
		Dim szUISplmYn		'UI추가여부
		szUISplmYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "UI_SPLM_YN" , 0 )
		
		Dim nRow, nCnt
		nRow = contSelect.grdList.rowcount
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" )
'			Form.ShowAlert("nCnt", nCnt)
		If nCnt > 0 Then
			Dim szOrgName, szAcnt, szAcntType, szLimit, szRegDate, szExpDate, szUnsign
			For i = 0 to nCnt - 1
				'점포명
				szOrgName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_REG_SHOP_NAME" , i )
				'계좌번호
				szAcnt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_ACNO" , i )
				'계좌유형
				szAcntType = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_ACNT_PRNM" , i )
				'납입한도
				szLimit = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_JOIN_AMT" , i )
				'가입일
				szRegDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_SVNG_NEW_DATE" , i )
				'만기일
				szExpDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_MTRT_DATE" , i )
				'해지일
				szUnsign = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_CANC_DATE" , i )
				
				contSelect.grdList.AddRow()
				
				contSelect.grdList.SetCellData("bd_cell8", nRow + i, "계좌번호")
				contSelect.grdList.SetCellData("bd_cell11", nRow + i, "계좌유형")
				contSelect.grdList.SetCellData("bd_cell16", nRow + i, "납입한도")
				contSelect.grdList.SetCellData("bd_cell18", nRow + i, "가입일")
				contSelect.grdList.SetCellData("bd_cell21", nRow + i, "만기일")
				'contSelect.grdList.SetCellData("bd_cell26", nRow + i, "해지일")
				
				contSelect.grdList.SetCellData("bd_title", nRow + i, Trim(szOrgName))
				contSelect.grdList.SetCellData("bd_acnt", nRow + i, szAcnt)
				contSelect.grdList.SetCellData("bd_type", nRow + i, szAcntType)
				contSelect.grdList.SetCellData("bd_limit", nRow + i, szLimit)
				contSelect.grdList.SetCellData("bd_regdate", nRow + i, szRegDate)
				contSelect.grdList.SetCellData("bd_expdate", nRow + i, szExpDate)
				'If szUnsign == "" or szUnsign == null or szUnsign == "00000000" Then
					'contSelect.grdList.SetCellData("bd_unregdate", nRow + i, "")
				'Else
					'contSelect.grdList.SetCellData("bd_unregdate", nRow + i, szUnsign)
				'End If
				
				'금융기관명에 메리츠증권이 들어가 있거나
				'해지일이 00000000이 아닐경우 선택 영역 비활성화
				If InStr(Trim(szOrgName), "메리츠증권") <> 0 Then
					contSelect.grdList.SetCellEnable("bd_check", nRow + i, false)
				End If
				
				If Trim(szOrgName) == "" Or Trim(szOrgName) == Null Then
				    contSelect.grdList.SetCellEnable("bd_check", nRow + i, false)
				End If
				
				If szUnsign <> "00000000" Then
					contSelect.grdList.SetCellEnable("bd_check", nRow + i, false)
				End If
			Next
		End If
		
		If szUISplmYn == "0" Then
			g_bNextFlag = false
	         contSelect.BtnTransParent.visible = False
              cmbAcnt.enable = True
              edtPwd.enable = True
		ElseIf szUISplmYn == "1" Then
			g_bNextFlag = true
			
			'연계전문번호 가져온 후 다시 조회(연속조회)
			g_szLnkdTlmsMnno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LNKD_TLMS_MNNO" , 0 )
			
			'전체금융기관연금저축계좌 조회(연속조회)
'			DATAMANAGER.RequestTranData( "obaci_acct_275r" )
			
			'타이머를 이용해 1초이상 대기 후 재조회
			Form.SetTimerEvent(1000, 1, 1.5)
		Else
		    cmbAcnt.enable = True
		    edtPwd.enable = True
		End If 
	
	ElseIf szTranID == "obaci_acct_156r" Then
	
        cmbAcnt.enable = False
        edtPwd.enable = False	
          
        cmbAcnt.visible = False
        edtPwd.visible = False
	
	    '약관 영역 다음 버튼
	    contAgree.visible = false
	    contSelect.visible = true
	    '전체금융기관연금저축계좌 조회
	    DATAMANAGER.RequestTranData( "obaci_acct_275r" )	
	
	'신연금저축이수신청
	ElseIf szTranID == "obaci_acct_153a" Then
		'이전받는계좌 / 이전하는계좌기관명 / 이전하는계좌번호
		Dim szSendData
		szSendData = cmbAcnt.cbkeydata & "★" & contInput.cmbOrg.caption & "★" & g_szOtherAcnt
		
		'완료팝업 오픈
		Form.OpenPopup( "mbonl93102_p5" , szSendData , "" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'TR 오류 메시지처리
	If szTranID == "obaci_acct_144r" then
		Form.MsgBox( "오류" , "연금계좌 조회 오류" , "" , 6 )
		edtPwd.caption = ""
		
	'v0002
	ELSEIF szTranID == "obaci_acct_277r" then
		Form.MsgBox( "오류" , "연금계좌 조회 오류" , "" , 6 )
		edtPwd.caption = ""
		
	ElseIf szTranID == "obacp_opop_066r" Then
	
		edtPwd.caption = ""
		f_InitScreen()
		If szSubMsg <> "" and szSubMsg <> null Then
			Form.ShowAlert("오류", szErrMsg & "\n(" & szSubMsg & ")")
		Else
			Form.ShowAlert("오류", szErrMsg)
		End If		
		
    ElseIf szTranID == "obaci_acct_275r" Then
    
        cmbAcnt.enable = True
        edtPwd.enable = True
	    If szSubMsg <> "" and szSubMsg <> null Then
			Form.ShowAlert("오류", szErrMsg & "\n(" & szSubMsg & ")")
		Else
			Form.ShowAlert("오류", szErrMsg)
		End If	
		
    ElseIf szTranID == "obaci_acct_153a" Then
		
		If szErrCode == "9513" Then
              Form.ShowAlert("알림", szErrMsg & "\n(거래영업점 또는 고객센터(1588-3400)에 문의 바랍니다)")
		ElseIf szErrCode == "2790" Then	      
			Form.ShowAlert("알림", szErrMsg & "\n(" & szSubMsg & ")")	     
		ElseIf szSubMsg <> "" and szSubMsg <> null Then
			Form.ShowAlert("오류", szErrMsg & "\n(" & szSubMsg & ")")
		Else
			Form.ShowAlert("오류", szErrMsg)
		End If		
		
    ElseIf szTranID == "obaci_acct_156r" Then
		
		If szErrCode == "2790" Then	      
			Form.ShowAlert("알림", szErrMsg & "\n(" & szSubMsg & ")")	     
		ElseIf szSubMsg <> "" and szSubMsg <> null Then
			Form.ShowAlert("오류", szErrMsg & "\n(" & szSubMsg & ")")
		Else
			Form.ShowAlert("오류", szErrMsg)
		End If	
		
	Else
	
		If szSubMsg <> "" and szSubMsg <> null Then
			Form.ShowAlert("오류", szErrMsg & "\n(" & szSubMsg & ")")
		Else
			Form.ShowAlert("오류", szErrMsg)
		End If
		
	End If
	
	'테스트용
'	Form.ShowAlert(szTranID, szErrMsg)
End Sub

'============================================================================
' 약관 단계 다음버튼 활성화 판단
'============================================================================
Function f_CheckAgreeNext()
	If g_bAgree1 and g_bAgree2 Then
		contAgree.imgChkAll.imgpath = "check_square_on.png"
		contAgree.btnNext.enable = true
	Else
		contAgree.imgChkAll.imgpath = "check_square_off.png"
		contAgree.btnNext.enable = false
	End If
End Function

'============================================================================
' 화면 초기화
'============================================================================
Function f_InitScreen()
	g_bAgree1 = false
	g_bAgree2 = false
	g_bNextFlag = false
	'g_bAgreeAll = false
	g_nSelectIndex = -1
	g_szLnkdTlmsMnno = ""
	g_szRnmcYn = ""
	
	g_szOtherAcnt = ""
	g_szOtherCode = ""
	g_szOtherClsCode = ""
	
	contAgree.visible = true
	contSelect.visible = false
	contInput.visible = false
	contConfirm.visible = false
	
	contAgree.btnAlpha.visible = true
	
	contSelect.grdList.SetClear()
	contSelect.BtnTransParent.visible = True
	contSelect.btnNext.enable = False
	
	contAgree.imgChkAll.imgpath = "check_square_off.png"
	contAgree.imgAgree1.imgpath = "check_off.png"
	contAgree.imgAgree2.imgpath = "check_off.png"
	contAgree.btnNext.enable = False
	
	contInput.cmbOrg.caption = "금융기관"
	contInput.lblType.caption = ""
	contInput.GridInfo.SetCellData("bd_cell0", 0, "")
	contInput.GridInfo.SetCellData("bd_cell1", 0, "")

	contInput.cmbSignDate.currentindex = "0"
	contInput.rdoConfirmMthd.currentindex = "0"
	contInput.btnNext.enable = False
	
	contConfirm.tblData1.SetCellString(0, 1, "")
	contConfirm.tblData1.SetCellString(1, 1, "")
	
	contConfirm.tblData2.SetCellString(0, 1, "")
	contConfirm.tblData2.SetCellString(1, 1, "")
	contConfirm.tblData2.SetCellString(2, 1, "")
	contConfirm.tblData2.SetCellString(3, 1, "")
End Function 

'============================================================================
' 타사 연금계좌가 선택되어 있는지 체크
'============================================================================
Function f_CheckAcntSelect()
	Dim bSelect
	bSelect = false
	For i = 0 to CInt(contSelect.grdList.rowcount)
		Dim szCheck
		szCheck = contSelect.grdList.GetCellData("bd_check", i)
		If szCheck == "1" Then
			bSelect = true
		End If
	Next
	
	'선택된 항목이 있으면 다음 버튼 활성화
	If bSelect Then
		contSelect.btnNext.enable = true
	Else
		contSelect.btnNext.enable = false
		
		g_nSelectIndex = -1
	End If
End Function

'============================================================================
' 타사연금계좌 정보입력영역 세팅
'============================================================================
Function f_SetInputArea()
	Dim szOrgName, szAcnt, szType
	szOrgName = Trim(contSelect.grdList.GetCellData("bd_title", g_nSelectIndex))
	szAcnt = contSelect.grdList.GetCellData("bd_acnt", g_nSelectIndex)
	szType = contSelect.grdList.GetCellData("bd_type", g_nSelectIndex)
	
	contInput.lblType.caption = szType
	'contInput.tblInfo.SetCellString(0, 0, szOrgName)
	'contInput.tblInfo.SetCellString(0, 1, szAcnt)
	contInput.GridInfo.SetCellData("bd_cell0" , 0 , Trim(szOrgName))
	contInput.GridInfo.SetCellData("bd_cell1" , 0 , szAcnt)
	
	g_szOtherAcnt = szAcnt
End Function

'============================================================================
' 타사연금계좌 신청확인영역 세팅
'============================================================================
Function f_SetConfirmArea()
	Dim szAcnt, szMaskAcnt
	szAcnt = cmbAcnt.cbkeydata
	szMaskAcnt = Left(szAcnt, 4) & "-" & Mid(szAcnt, 5, 4) & "-" & Right(szAcnt, 2)
	
	'신청정보
	'이전받을 계좌번호
	contConfirm.tblData1.SetCellString(0, 1, szMaskAcnt)		
	
	'이전의사 확인방법
	If contInput.rdoConfirmMthd.currentindex == "0" Then
		contConfirm.tblData1.SetCellString(1, 1, "전화통화")		
	ElseIf contInput.rdoConfirmMthd.currentindex == "1" Then
		contConfirm.tblData1.SetCellString(1, 1, "이전 금융기관 방문")
	End If
	
	'가져올 계좌 정보
	contConfirm.tblData2.SetCellString(0, 1, contInput.cmbOrg.caption)		'금융기관
	
	contConfirm.tblData2.SetCellString(1, 1, g_szOtherAcnt)		'계좌번호
	
	Dim szType
	szType = contSelect.grdList.GetCellData("bd_type", g_nSelectIndex)
	contConfirm.tblData2.SetCellString(2, 1, szType)				'계좌유형
	
	Dim szRegDate												'가입일
	Dim szGrdAcnt, szGrdAsno, szGrdDate, szRnmcYn
	For i = 0 to CInt(grdData.rowcount) - 1 
		szGrdAcnt = grdData.GetCellData("bd_ACNT", i)
		szGrdAsno = grdData.GetCellData("bd_ASNO", i)
		szGrdDate = grdData.GetCellData("bd_OPNG_DATE", i)
		szRnmcYn = grdData.GetCellData("bd_RNMC_YN", i)
		If szAcnt == szGrdAcnt & szGrdAsno Then
			szRegDate = szGrdDate
			
			g_szRnmcYn = szRnmcYn
		End If
	Next	
	If contInput.cmbSignDate.currentindex == "0" Then
		contConfirm.tblData2.SetCellString(3, 1, "이체하는 계좌의 가입일")
	Else
		szRegDate = Left(szRegDate, 4) & "." & Mid(szRegDate, 5, 2) & "." & Right(szRegDate, 2)
		contConfirm.tblData2.SetCellString(3, 1, "이체받는 계좌의 가입일\n" & "(" & szRegDate & ")" )
	End If
	
	'따로 체크할 데이터 없으므로 바로 하단버튼 활성화
	contConfirm.btnNext.enable = true
End Function

