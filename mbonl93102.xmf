Sub contAgree_lblAgree1_OnClick()
	If g_bAgree1 Then
		g_bAgree1 = false
		contAgree.imgAgree1.imgpath = "check_off.png"
		
		f_CheckAgreeNext()
	Else
		'금융거래정보 제공 동의 팝업
		Form.OpenFramePopup("mbonl93102_p3" , "", "")
	End If
End Sub

'============================================================================
Sub contAgree_lblAgree2_OnClick()
	If g_bAgree2 Then
		g_bAgree2 = false
		contAgree.imgAgree2.imgpath = "check_off.png"
		
		f_CheckAgreeNext()
	Else
		'연금저축 유의사항 팝업
		Form.OpenFramePopup("mbonl93102_p2" , "", "")
	End If
End Sub

