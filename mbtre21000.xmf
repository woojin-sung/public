'============================================================================
' 01. 화 면 명 : CFD 권리예정내역 조회
' 02. 화면설명 : CFD 권리예정내역 조회
' 03. 작    성 : 2021. 07. 21. KSJ
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tItemCodeInfo 	'종목정보 배열
Dim g_szItemCode		'종목코드
Dim g_szItemSym		'종목거래소심볼
Dim g_szNationCode	'종목국가코드

Dim g_szPlain_rm		'메모리 평문적용 여부


Dim g_nSRow	'확정 선택한 Row
Dim g_nCRow	'취소 선택한 Row 

Dim g_bBtnClickYN 'btnReturnIncuiry 클릭여부
Dim g_AcntNaionCode

g_tItemCodeInfo = {}
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "EditPW", "caption" )
	
	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	
'============================================================================
' 탭 구분에 따른 서비스 ID 얻기
'============================================================================
Function f_GetTranID()    
	Dim szGetTranID 
    If TabSelect.currenttab == 1 or TabSelect.currenttab == "1" Then
	    szGetTranID = "obtre_brng_110r"	' 
	Else
		If g_szItemCode ~= null and g_szItemCode ~= "" Then
			szGetTranID = "obtre_comm_550r"
		End If
		
    End If
    
    return szGetTranID
End Function
'============================================================================
' Clear
'============================================================================
Function f_Clear()    
	If TabSelect.currenttab == 0 or TabSelect.currenttab == "0" Then
		f_InitCodeInfo()
		
		TabSelect.page0.cmbGubun.cbkeydata = "1"
		TabSelect.page0.ItemCode0.code = "empty"
		TabSelect.page0.lblRate.caption = 0
		TabSelect.page0.lblRate.visible = false
		TabSelect.page0.edtTotalWon.caption = ""
		
		edtBPrice.caption = ""
		edtAmount.caption = ""
		edtTotalM.caption = ""
		g_bBtnClickYN = false
	Else
		TabSelect.page1.tblSettle.SetCellString( 1, 1, "" )
		TabSelect.page1.tblSettle.SetCellString( 1, 3, "" )
		TabSelect.page1.tblSettle.SetCellString( 2, 1, "" )
		TabSelect.page1.tblSettle.SetCellString( 2, 3, "" )
		TabSelect.page1.grd0.SetClear()
		TabSelect.page1.btnSettle.enable = false	'2021-09-14 KSJ 확정버튼 기본설정
	End If
End Function
'============================================================================
' SetVisble
'============================================================================
Function f_SetVisble()    
	If TabSelect.currenttab == 0 or TabSelect.currenttab == "0" Then
		edtBPrice.visible = true
		edtAmount.visible = true
		edtTotalM.visible = true
	Else
		edtBPrice.visible = false
		edtAmount.visible = false
		edtTotalM.visible = false
	End If
End Function
'============================================================================
' Sum_Qty
'============================================================================
Function f_Sum_Qty(szData)
	if tonumber(Len(szData)) < 9 then
		lblHideAmount.caption = edtAmount.caption
	else
		edtAmount.caption = lblHideAmount.caption
	end if
End Function

'============================================================================
' f_RequestAccountEx : 해당 계좌 거래가능 거래소 조회
'============================================================================
Function f_RequestAccountEx()
	if acnt0.total ~= "" and acnt0.sequence ~= "" then
		DATAMANAGER.RequestTranData("obtre_comm_017r")
		DATAMANAGER.RequestTranData("obtre_comm_511r")
	end if
End Function

'============================================================================
' f_InitCodeInfo : 종목정보 초기화
'============================================================================
Function f_InitCodeInfo()
	g_tItemCodeInfo = {}
	g_szItemCode = ""
	g_szItemSym = ""
	g_szNationCode = ""
End Function

'============================================================================
' f_SetCodeInfo : 종목정보 SET
'============================================================================
Function f_SetCodeInfo(szCodeInfo, szSplitType)
	if szCodeInfo <> "" and szSplitType <> "" then
		g_tItemCodeInfo = split(szCodeInfo, szSplitType)
		
		if szSplitType == "@" then '종목컨트롤에서 넘어온 종목정보(시장@코드 형식)
			g_szItemCode = g_tItemCodeInfo(1)
			g_szItemSym = g_tItemCodeInfo(0)
			
		elseif szSplitType == "." then '잔고팝업에서 넘어온 종목정보(코드.시장 형식)
			g_szItemCode = g_tItemCodeInfo(0)
			g_szItemSym = g_tItemCodeInfo(1)
		end if 
	end if
End Function
'============================================================================
' f_GetNationCode(szSym) : 거래소별 벤더 값 반환
'============================================================================
Function f_GetExCode(szSym)
	Dim szReturnValue
	szReturnValue = ""
	if szSym == "NY" then '뉴욕
		szReturnValue = "0321"
	elseif szSym == "OQ" then '나스닥
		szReturnValue = "0537"
	elseif szSym == "AX" then '아멕스
		szReturnValue = "0066"
	elseif szSym == "SH" then '상해
		szReturnValue = "0215"
	elseif szSym == "SZ" then '심천
		szReturnValue = "0214"
	elseif szSym == "HK" then '홍콩
		szReturnValue = "0104"
	elseif szSym == "JP" then '일본
		szReturnValue = "0106"
	end if	
	
	return szReturnValue
End Function

'============================================================================
' f_GetNationSym(szNationCode) : 국가 심볼 값 반환
'============================================================================
Function f_GetNationSym(szNationCode)
	Dim szReturnValue
	
	if szNationCode == "840" then '미국
		szReturnValue = "US"
	elseif szNationCode == "156" then '중국
		szReturnValue = "CH"
	elseif szNationCode == "344" then '홍콩
		szReturnValue = "HK"
	elseif szNationCode == "392" then '일본
		szReturnValue = "JP"
	end if
	
	return szReturnValue
End Function

'============================================================================
' f_GetNationNm(szNationSym) : 국가 심볼을 한글 명으로 반환
'============================================================================
Function f_GetNationNm(szNationSym)
	Dim szReturnValue
	
	if szNationSym == "US" then '미국
		szReturnValue = "미국"
	elseif szNationSym == "CH" then '중국
		szReturnValue = "중국"
	elseif szNationSym == "HK" then '홍콩
		szReturnValue = "홍콩"
	elseif szNationSym == "JP" then '일본
		szReturnValue = "일본"
	end if
	
	return szReturnValue
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD차입/상환 신청" )

	g_AcntNaionCode = "" '계좌 거래가능 거래소
	
	f_InitCodeInfo()
	f_Clear() 
	f_SetVisble()
	TabSelect.page0.cmbGubun.currentindex = "0"
	f_RequestAccountEx()'선택계좌 거래 가능 거래소 조회
	
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
End Sub
'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sRet = "ok" Then 
		If sKeyName == "21000_settle" Then
			DATAMANAGER.RequestTranData( "obtre_brng_107u" )
		ElseIf sKeyName == "21000_cancel" Then
			TabSelect.page1.grd0.SetCellEnable( "bd_cell0", g_nCRow, "false" )
			DATAMANAGER.RequestTranData( "obtre_brng_108u" )
		ElseIf sKeyName == "21000_application" Then
			DATAMANAGER.RequestTranData( "obtre_brng_101c" )
		End if 	
	End If
End Sub
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "MBTRE21000_P1" Then
		If sRet == "ok" Then
			If TabSelect.page0.cmbGubun.currentindex == "0" Then
				g_bBtnClickYN = true
				TabSelect.page0.cmbGubun.currentindex = "1"
			Else
				g_bBtnClickYN = false
			End If
			
			f_InitCodeInfo()
			
			dim szFullCode '종목정보 코드.거래소 형식
			szFullCode = Form.GetSharedData("mbtre21000_p1_ISCD", true )
			
			if szFullCode ~= "" and szFullCode ~= null then
				f_SetCodeInfo(szFullCode, ".")
				
				TabSelect.page0.ItemCode0.code = g_szItemSym & "@" & g_szItemCode
				edtAmount.caption = tonumber(Form.GetSharedData("mbtre21000_p1_ABLE_QTY", true ))
	'			
				DATAMANAGER.RequestTranData( "obtre_comm_550r" )
				DATAMANAGER.RequestTranData( "obtre_comm_511r" )
			end if
			
		Else
			f_Clear()
		End If
	End If
End Sub

'============================================================================
' acnt0_ChangeAccount() : 계좌변경
'============================================================================
Sub acnt0_ChangeAccount()
	f_Clear()
	EditPW.caption = ""
	g_nSRow = -1
	g_nCRow = -1
	TabSelect.page0.cmbMktType.clear = true
	
	f_RequestAccountEx()
End Sub
'============================================================================
' EditPW_OnEditComplete() : 비밀번호 입력
'============================================================================
Sub EditPW_OnEditComplete()
	DATAMANAGER.RequestTranData( f_GetTranID()  )
	
End Sub
'============================================================================
' TabSelect_OnTabChanged() : 탭변경
'============================================================================
Sub TabSelect_OnTabChanged(nCurrentTab)
	f_Clear()
	f_SetVisble()
	TabSelect.page0.cmbGubun.currentindex = "0"
	g_nSRow = -1
	g_nCRow = -1
	
	If EditPW.caption ~= null and EditPW.caption ~= "" Then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	End If
End Sub

'============================================================================
' 신청
'============================================================================
'============================================================================
' Form_OnCommonDialogReturn()
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	'종목컨트롤 종목 선택시
	if sDlgName == "SEARCH" then
		if sReturn1 <> "" then
			f_InitCodeInfo()
			f_SetCodeInfo(sReturn1, "@")
			
			DATAMANAGER.RequestTranData( "obtre_comm_550r" )
			
		else
			f_Clear()
		end if
	end if
End Sub
'============================================================================
'edtAmount_OnEditComplete() : 수량입력
'============================================================================
Sub edtAmount_OnEditComplete()
	Dim szData, nAmount, nBPrice
	szData = edtAmount.caption
	f_Sum_Qty(szData)
	
	nAmount = tonumber(edtAmount.caption)
	nBPrice = tonumber(edtBPrice.caption)
	nRate   = tonumber(TabSelect.page0.edtExRate.caption)
	If nBPrice ~= null and nBPrice ~= 0 and nAmount ~= null and nAmount ~= 0 Then
		edtTotalM.caption = nAmount*nBPrice
		
		if nRate > 0 then
			TabSelect.page0.edtTotalWon.caption = nAmount*nBPrice*nRate 
		end if
	End If
End Sub
'============================================================================
'edtAmount_OnEditChar() : 수량입력
'============================================================================
Sub edtAmount_OnEditChar(CharCode)
	Dim szData
	szData = edtAmount.caption
	f_Sum_Qty(szData)
End Sub
'============================================================================
'btnOK_OnClick() : 신청 선택
'============================================================================
Sub TabSelect_page0_btnOK_OnClick()
	if f_GetPWCkeck() then
		Exit Sub
	end if
	
	If g_szItemCode == "" Then
		Form.ShowAlert("알림", "종목을 선택해 주세요.")
		Exit Sub
	End if
	
	If CInt(edtAmount.caption) < 1 Then
		Form.ShowAlert("알림", "신청수량을 입력해 주세요.")
		Exit Sub
	End if
	
	Dim szApltClcd
	szApltClcd = TabSelect.page0.cmbGubun.caption
	
	Form.MsgBox("알림", szApltClcd & " 하시겠습니까?", "21000_application", 1)
End Sub
'============================================================================
'btnReturnIncuiry_OnClick() : 상환가능 잔고 조회
'============================================================================
Sub TabSelect_page0_btnReturnIncuiry_OnClick()
	if f_GetPWCkeck() then
		Exit Sub
	end if
	
	Form.SetSharedData("mbtre21000_ACNO" , acnt0.total)
	Form.SetSharedData("mbtre21000_ASNO" , acnt0.sequence)
	Form.SetSharedData("mbtre21000_ACNT_PWD" , EditPW.caption)
	Form.OpenPopupAnimation("mbtre21000_p1", "", "","2")		
End Sub
'============================================================================
'cmbGubun_OnEditComplete() : 신청 구분 선택
'============================================================================
Sub TabSelect_page0_cmbGubun_OnEditComplete(iIndex)
	If g_bBtnClickYN == true Then
		g_bBtnClickYN = false
		Exit Sub
	Else
		f_Clear()
	End If
	If iIndex = 1 Then
		if f_GetPWCkeck() then
			TabSelect.page0.cmbGubun.currentindex = "0"
			Exit Sub
		end if
	
		Form.SetSharedData("mbtre21000_ACNO" , acnt0.total)
		Form.SetSharedData("mbtre21000_ASNO" , acnt0.sequence)
		Form.SetSharedData("mbtre21000_ACNT_PWD" , EditPW.caption)
		Form.OpenPopupAnimation("mbtre21000_p1", "", "","2")	
	End If
End Sub


'============================================================================
' 조회/확정/취소
'============================================================================
'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub TabSelect_page1_grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_brng_110r") == True Then
		DATAMANAGER.RequestNextData("obtre_brng_110r")
	End If
End Sub
'============================================================================
' grd0_OnClickUp() : 확정 Setting
'============================================================================
Sub TabSelect_page1_grd0_OnClickUp(lRow, szCellID)
	'취소선택
	If szCellID == "bd_cell0" Then
		if f_GetPWCkeck() then
			Exit Sub
		end if
		Form.MsgBox("알림", "취소처리하시겠습니까", "21000_cancel", 1)
		g_nCRow = lRow
		
	'2021-09-14 KSJ 체크선택 , 확정버튼 활성화/비활성화
	Else 
		Dim szEnableState
		szEnableState = TabSelect.page1.grd0.GetCellEnable( "bd_cell16", lRow )
		If szEnableState == "1" Then
			Dim szCheckState 
			szCheckState = TabSelect.page1.grd0.GetCellData( "bd_cell16", lRow ) '체크상태
			
			'체크버튼 셀 눌렀을때 동작 재정의
			If szCellID == "bd_cell16" Then 
				If szCheckState == "1" Then	' uncheck >> check
					szCheckState = "0"		
				Else 					' check >> uncheck			
					szCheckState = "1"
				End If
			End If
			
			' check >> uncheck
			If szCheckState == "1" Then 
				TabSelect.page1.tblSettle.SetCellString( 1, 1, "" )	
				TabSelect.page1.tblSettle.SetCellString( 1, 3, "" )	
				TabSelect.page1.tblSettle.SetCellString( 2, 1, "" )	
				TabSelect.page1.tblSettle.SetCellString( 2, 3, "" )	
				g_nSRow = -1
				TabSelect.page1.btnSettle.enable = false
				TabSelect.page1.grd0.SetCellData( "bd_cell16",lRow, 0)
			' uncheck >> check	
			Else 
				If g_nSRow ~= lRow Then
					TabSelect.page1.grd0.SetCellData( "bd_cell16", g_nSRow, 0)
					TabSelect.page1.grd0.SetCellData( "bd_cell16", lRow, 1)
				End If
				TabSelect.page1.tblSettle.SetCellString( 1, 1, TabSelect.page1.grd0.GetCellData( "bd_cell5", lRow ) )	'가능여부
				TabSelect.page1.tblSettle.SetCellString( 1, 3, TabSelect.page1.grd0.GetCellData( "bd_cell7", lRow ) )	'가능수량
				TabSelect.page1.tblSettle.SetCellString( 2, 1, TabSelect.page1.grd0.GetCellData( "bd_cell8", lRow ) )	'리콜가능성높은종목
				TabSelect.page1.tblSettle.SetCellString( 2, 3, TabSelect.page1.grd0.GetCellData( "bd_cell11", lRow ) )	'수수료율
				g_nSRow = lRow
				TabSelect.page1.btnSettle.enable = true
			End If
		End If
	End If
End Sub
'============================================================================
' btnSettle_OnClick() : 확정 선택
'============================================================================
Sub TabSelect_page1_btnSettle_OnClick()
	if f_GetPWCkeck() then
		Exit Sub
	end if
	
	Dim szApltSrno, szApltDate
	szApltSrno = ""
	szApltDate = ""
	
	If g_nSRow ~= -1 Then
		szApltSrno = TabSelect.page1.grd0.GetCellData( "bd_cell13", g_nSRow ) '신청일련번호
		szApltDate = TabSelect.page1.grd0.GetCellData( "bd_cell12", g_nSRow ) '신청일자
	End If
	if szApltDate == "" or szApltSrno == "" then
		Form.ShowAlert( "알림", "확정대상을 선택해 주세요.")
		Exit Sub
	end if 
	
	Form.MsgBox("알림", "확정처리 하시겠습니까?", "21000_settle", 1)
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_Clear() 
	f_SetVisble()
	TabSelect.page0.cmbGubun.currentindex = "0"
	g_nSRow = -1
	g_nCRow = -1
	
	If EditPW.caption ~= null and EditPW.caption ~= "" Then
		DATAMANAGER.RequestTranData( f_GetTranID()  )
	End If
End Sub

'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)  	
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = EditPW.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(EditPW.caption)
	end if	
	
	'계좌 거래 가능 거래소 조회
	if szTranID == "obtre_comm_017r" or szTranID == "obtre_comm_511r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		
	'종목 데이터 조회
	elseIf szTranID == "obtre_comm_550r" Then
		Dim szExCode
		szExCode = f_GetExCode(g_szItemSym)
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OVRS_STCK_SYMB_ISCD" , 0 , g_szItemCode )'종목코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OVRS_EXCH_VNDR_IDNO" , 0 , szExCode )'거래소
		
	'신청
	Elseif szTranID == "obtre_brng_101c" Then
			dim szNationSym, szISCD
			if g_szNationCode <> "" and g_szNationCode <> null then
				szNationSym = f_GetNationSym(g_szNationCode)
			end if
			
			if g_szItemCode <> "" and g_szItemSym <> "" then
				szISCD = g_szItemCode & "." & g_szItemSym
			end if
			
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 					, 0 , acnt0.total						)'Left(cmb0.caption , 8))'계좌번호
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 					, 0 , acnt0.sequence					)'Right(cmb0.caption , 2))'계좌일련번호
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" 				, 0 , szACNT_PWD						)'비밀번호
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BRNG_RDMP_APLT_CLCD"	, 0 , TabSelect.page0.cmbGubun.cbkeydata	)'차입상환신청구분
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 					, 0 , szISCD 							)'종목코드(코드.거래소)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "APLT_OQTY" 				, 0 , edtAmount.caption				)'신청수량
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_EXCH_CODE" 			, 0 , szNationSym 					)'국가 심볼
			
	ElseIf szTranID == "obtre_brng_110r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , szACNT_PWD)							'비밀번호
	'확정/취소
	ElseIf szTranID == "obtre_brng_107u" or szTranID == "obtre_brng_108u" Then	
		Dim szApltSrno, szApltDate, nRow
		if szTranID == "obtre_brng_107u" Then
			nRow = g_nSRow
		Else
			nRow = g_nCRow
		End If
		
		szApltSrno = TabSelect.page1.grd0.GetCellData( "bd_cell13", nRow ) '신청일련번호
		szApltDate = TabSelect.page1.grd0.GetCellData( "bd_cell12", nRow ) '신청일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , szACNT_PWD)							'비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_BRNG_RDMP_APLT_SRNO" , 0 , tonumber(szApltSrno) )	'신청일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_BRNG_RDMP_APLT_DATE" , 0 , szApltDate )			'신청일자
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
'매크로 사용된 TR 사용시 Form.GetMetaData(코드치환Section, 코드 TR)
'sData = Form.GetMetaData( "현물반대매매사유코드", "01" )
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_comm_017r" then
		'계좌 거래가능 국가 코드
		g_AcntNaionCode = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CTCD", 0 ))
'		Form.ShowAlert(szTranID, g_AcntNaionCode)
	
	elseif szTranID == "obtre_comm_511r" then
		Dim nTranCnt, szComboList
		nTranCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		szComboList = ""
		
		for i=0 to nTranCnt-1
			dim szCode, szName
			szCode = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CFD_EXCH_CODE", i ))
			szName = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CFD_EXCH_NAME", i ))
			
			if szComboList == "" then
				szComboList = szCode & "`" & szName
			else
				szComboList = szComboList & "\r\n" & szCode & "`" & szName
			end if
			
		next
		
		if szComboList <> "" then
			TabSelect.page0.cmbMktType.cbinputdatatext = szComboList
		end if
		
	elseIf szTranID = "obtre_comm_550r" Then
		'종목 국가 코드
		g_szNationCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CTCD" , 0)
		TabSelect.page0.edtExRate.caption = tonumber(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DEAL_STND_EXRT" , 0))
'		Form.ShowAlert(g_AcntNaionCode, g_szNationCode)
		
		TabSelect.page0.lblRate.visible = true
		
		if g_szNationCode == g_AcntNaionCode then'계좌 가능 국가와 검색 종목 국가가 일치 할 시
			Dim nBPrice, nExRate, nAmount
			nBPrice = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPR" , 0) '전일종가	
			edtBPrice.caption = nBPrice
			
			nExRate = CDbl(TabSelect.page0.edtExRate.caption) '환율
			nAmount = tonumber(edtAmount.caption)
			
			If nBPrice ~= null and nBPrice ~= 0 and nAmount ~= null and nAmount ~= 0 Then
				edtTotalM.caption = nAmount*nBPrice
				
				if nExRate > 0 then
					TabSelect.page0.edtTotalWon.caption = nAmount*nBPrice*nExRate
				end if
			End If
			
		else
			Form.ShowAlert("종목오류", "해당 종목은 신청 불가합니다.(시장 불일치)")
			f_Clear()
			
		end if
		
	ElseIf szTranID == "obtre_brng_110r" Then
		If tonumber(TabSelect.page1.grd0.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = TabSelect.page1.grd0.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1	
				Dim szData0, szData1, szData2, szData3, szData4, szNation
				szData0 = Form.GetMetaData( "차입상환신청구분코드", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "BRNG_RDMP_APLT_CLCD" , i) )
				szData1 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ABLE_PRHB_YN" , i)	
				szData2 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RCL_TN_ISSU_YN" , i)
				szData3 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CCLS_YN" , i)
				szData4 = Form.GetMetaData( "차입상환신청상태코드", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "BRNG_RDMP_APLT_STAT_CODE" , i) )
				szData5 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CTCD" , i)
				szNation = f_GetNationNm(f_GetNationSym(szData5))
				
				TabSelect.page1.grd0.SetCellData( "bd_cell1", nRowCnt+i , szData0)	'차입상환신청구분명
				TabSelect.page1.grd0.SetCellData( "bd_cell5", nRowCnt+i , f_DataReurn110r(szData1, "가능", "불가"))	'가능불가여부
				TabSelect.page1.grd0.SetCellData( "bd_cell8", nRowCnt+i , f_DataReurn110r(szData2, "대상", ""))	'리콜주의종목
				TabSelect.page1.grd0.SetCellData( "bd_cell9", nRowCnt+i , f_DataReurn110r(szData3, "확정", ""))	'확정여부
				TabSelect.page1.grd0.SetCellData( "bd_cell4", nRowCnt+i , szData4)	'신청상태
				TabSelect.page1.grd0.SetCellData( "bd_nation", nRowCnt+i , szNation)	'국가명
				
				'취소가능여부 설정
				Dim szCnclAblYn  
				szCnclAblYn = DATAMANAGER.GetDataValue( 0 ,"obtre_brng_110r", "OutBlock1", "CNCL_ABLE_YN" , i )	'취소가능여부
				TabSelect.page1.grd0.SetCellEnable( "bd_cell0", nRowCnt+i, f_DataReurn110r(szCnclAblYn, true, false) )
				TabSelect.page1.grd0.SetCellData( "bd_cell0", nRowCnt+i , f_DataReurn110r(szCnclAblYn, "취소", ""))	
				
				'2021-09-14 KSJ 체크박스 추가 요청(전요셉) : 차입신청이 관리자승인상태인 경우 > 체크박스 활성화/비활성화
				Dim szApltClcd, szStatCd
				szApltClcd = TabSelect.page1.grd0.GetCellData( "bd_cell15", nRowCnt+i ) '신청구분
				szStatCd = tostring(TabSelect.page1.grd0.GetCellData( "bd_cell14", nRowCnt+i )) '신청상태
				
				'차입신청이 관리자승인상태인 경우
				If ( szApltClcd = "1" and szStatCd = "02" ) Then
					TabSelect.page1.grd0.SetCellEnable( "bd_cell16", nRowCnt+i, true)
				Else '관리자승인 상태 외 기존 데이터 초기화 
					TabSelect.page1.grd0.SetCellEnable( "bd_cell16", nRowCnt+i, false)
				End If
			Next
	    End If
	ElseIf szTranID == "obtre_brng_107u" Then
		f_Clear()
		g_nSRow = -1	'2021-09-14 KSJ 변수 초기화
		DATAMANAGER.RequestTranData( "obtre_brng_110r" )
	ElseIf szTranID == "obtre_brng_108u" Then	
		f_Clear()
		g_nCRow = -1 '2021-09-14 KSJ 변수 초기화
		DATAMANAGER.RequestTranData( "obtre_brng_110r" )
	ElseIf szTranID == "obtre_brng_101c" Then	
		f_Clear()
		TabSelect.page0.cmbGubun.currentindex = "0"
		Form.ShowAlert("알림", "신청 완료되었습니다.")
		
		'2021.10.01 아이티젠 김성수 추가> 전요셉 차장 개선요청
	'START
		TabSelect.currenttab = "1"
		f_SetVisble()
		
		If EditPW.caption ~= null and EditPW.caption ~= "" Then
			DATAMANAGER.RequestTranData( f_GetTranID() )
		End If
	'END
	End If
End Sub

'obtrc_brng_110r 치환 매크로 기능
Function f_DataReurn110r(szData, szDataY, szDataN)
	
	'20211001 아이티젠 김성수 수정 > szData 값이 Y 또는 N 또는 공백으로 떨어짐
	'따라서 세 가지로 분기 처리
	Dim szReturnValue
	
	If szData == "Y" Then
		szReturnValue = szDataY
	Elseif szData == "N" Then
		szReturnValue = szDataN
	Else
		szReturnValue = ""
	End If
	
	return szReturnValue
	
End Function
'============================================================================
' DATAMANAGER_OnReceiveTranError()
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg ~= null and Trim(szSubMsg) ~= "" then
		szErrMsg = szErrMsg.."("..szSubMsg..")"
	end if
	
	if szTranID == "obtre_brng_107u" or szTranID == "obtre_brng_108u" or szTranID == "obtre_brng_101c" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

