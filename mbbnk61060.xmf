	<SCRIPT_INFO _len="9185" _ulen="8829" >
'============================================================================
' 01. 화 면 명 : 입출금내역
' 02. 화면설명 : 입출금내역
' 03. 작    성 : 2016. 02. 24. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_ComboIndex	'콤보선택 Index값
Dim g_GridCnt

Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTr() : TR 입력값 세팅, 조회 요청
'============================================================================
Function SetTr()
	g_GridCnt = 0
	
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "ACNO"          , 0 , acnt0.total)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "ASNO"          , 0 , acnt0.sequence)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "IQRY_STA_DATE" , 0 , cld0.caption)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "IQRY_FIN_DATE" , 0 , cld1.caption)
	
	DATAMANAGER.RequestTranData( "obrtp_tran_008r" )
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	szOpen = Form.GetOpenLinkData()
	tData =  split(szOpen,"★")
	if UBOUND(tData) > 0 then
		acnt0.caption = tData[0]
	end if
	
	SetTr()
	
End Sub
'============================================================================
' cmb0_OnEditComplete(iIndex)
'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	Dim ToYear
	Dim ToMonth
	Dim ToDay
	
	ToYear  = Left(cld1.caption, 4)
	ToMonth = Mid (cld1.caption, 5, 2)
	ToDay   = Mid (cld1.caption, 7, 2)
	
	g_ComboIndex = iIndex
	'ComboIndex에 따라 조회 기간 설정
	Select Case g_ComboIndex
		Case 0
			cld1.caption = cldToday.caption
			cld0.caption = cld1.caption
		Case 1
			cld1.caption = cldToday.caption
'			cld0.caption = ((ToYear*10000) + (ToMonth*100) + (ToDay - 7))
			cld0.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)
		Case 2
			cld1.caption = cldToday.caption
'			cld0.caption = ((ToYear*10000) + ((ToMonth-1)*100) + ToDay)
			cld0.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)
		Case 3
			cld1.caption = cldToday.caption
'			cld0.caption = ((ToYear*10000) + ((ToMonth-3)*100) + (ToDay - 7))
			cld0.caption = Left(Form.calcDateTime( nYear, -3, nDay, nHour, nMinute, nSecond ), 8)
	End Select
	
	SetTr()
	
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	
	SetTr()
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obrtp_tran_008r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obrtp_tran_008r", "OutBlock1")
		
			grd0.SetCellData( "bd_cell_mdfy" , i+g_GridCnt, "수정")
			if DATAMANAGER.GetDataValue( 0 , "obrtp_tran_008r", "OutBlock1", "MNRC_AMT" , i) == "0000000000000000000" then			'입출금 구분을 위한 조건
				grd0.SetCellData( "bd_cell1" , i+g_GridCnt, "출금")
				grd0.SetCellFgColor( "bd_cell1" , i+g_GridCnt, "11")
				grd0.SetCellData( "bd_cell2" , i+g_GridCnt, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_008r", "OutBlock1", "DRNG_AMT" , i))
				grd0.SetCellFgColor( "bd_cell2" , i+g_GridCnt, "11")
			else
				grd0.SetCellData( "bd_cell1" , i+g_GridCnt, "입금")
				grd0.SetCellFgColor( "bd_cell1" , i+g_GridCnt, "10")
				grd0.SetCellData( "bd_cell2" , i+g_GridCnt, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_008r", "OutBlock1", "MNRC_AMT" , i))
				grd0.SetCellFgColor( "bd_cell2" , i+g_GridCnt, "10")
			end if
		next
	end if
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	Dim rmtName
	
	if szCellID = "bd_cell_mdfy" then
		szData = acnt0.total & "★" & acnt0.sequence & "★" & grd0.GetCellData( "bd_cell0" , lRow) & "★" & grd0.GetCellData( "bd_cell_tr_srno" , lRow) &"★" &
		grd0.GetCellData( "bd_cell5" , lRow)	
		
		'Form.OpenDialog( "mbbnk61060_p2" , szData , "")
		Form.OpenPopup( "mbbnk61060_p2" , szData , "")
		Exit Sub
	end if
	
	
	if grd1.GetCellData( "bd_cell5" , lRow) <> "" then
		rmtName = grd1.GetCellData( "bd_cell5" , lRow)
	else
		rmtName = grd1.GetCellData( "bd_cell6" , lRow)
	end if
	
	szData = grd0.GetCellData( "bd_cell0" , lRow)&grd0.GetCellData( "bd_cell8" , lRow) & "★" & acnt0.total&"-"&acnt0.sequence & "★" & grd0.GetCellData( "bd_cell4" , lRow) & "★" &
	grd0.GetCellData( "bd_cell1" , lRow) & "★" & grd0.GetCellData( "bd_cell2" , lRow) & "★" & grd1.GetCellData( "bd_cell0" , lRow) & "★" &
	grd1.GetCellData( "bd_cell4" , lRow) & "★" & rmtName & "★" & grd1.GetCellData( "bd_cell1" , lRow) & "★" &
	grd1.GetCellData( "bd_cell2" , lRow) & "★" & grd1.GetCellData( "bd_cell3" , lRow)
	
	'szData = acnt0.total & "●" & acnt0.sequence & "●" & grd0.GetCellData( "bd_cell0" , lRow) & "●" &  CDbl(grd1.GetCellData( "bd_cell3" , lRow))
	Form.OpenFramePopup( "mbbnk61060_p1" , szData , "")
	'Form.MsgBox("", szData, 0, 6)
	'Form.ShowAlert( "알림", szData)
	'Form.OpenFramePopup( "mbact71040_p1" , szData , "")
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	g_GridCnt = grd0.rowcount
	DATAMANAGER.RequestNextData( "obrtp_tran_008r" )	
End Sub
'============================================================================
' cld0_OnEditComplete()
'============================================================================
Sub cld0_OnEditComplete()

	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "조회 일자가 잘못 입력되었습니다.")
		cld0.caption = cldToday.caption
'		Exit Sub
	end if
	SetTr()
End Sub
'============================================================================
' cld1_OnEditComplete()
'============================================================================
Sub cld1_OnEditComplete()

	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "조회 일자가 잘못 입력되었습니다.")
		cld1.caption = cldToday.caption
'		Exit Sub
	elseif cld1.caption > cldToday.caption then
		Form.ShowAlert( "알림", "조회 일자가 잘못 입력되었습니다.")
		cld1.caption = cldToday.caption
'		Exit Sub
	end if
	SetTr()
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	SetTr()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	If sEventName = "SCREEN_MENU" Then       ' 연결정보(상단 ...)
	
		If sParam = "SHA_SNS" Then        ' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
	End If

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "snsshare" Then   ' SNS공유
		g_nSNSType = Cint(sRet)
	
		If g_nSNSType = 2 Then          ' 이미지공유
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			   
			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else              ' 현재가공유
			Form.triggerEvent("linkfmHoga", "sharedata", "")   
		End If
	
	End If
	
	if sKeyName = "내통장수정" Then
		if sRet = "ok" Then
			SetTr()
		end if
	End if 
 
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	SetTr()
	
End Sub

