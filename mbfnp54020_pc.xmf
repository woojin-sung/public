Dim g_szAcnt, g_szAcntCd, g_szFullCd, g_szMk,g_szNowPrc, g_szUnit, g_szHigh, g_szLow, g_szGubun, g_szInner, g_szType, g_szPrc, g_szOrderTrType
Dim g_szCd, g_szMkCd
'============================================================================
Sub Form_OnFormInit()

	'20230713 htw start 주문가격 에디트 투명설정
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	if szDeviceOS == "2" then
		edtPrc.SetOnOffImage("alpha","alpha")
		edtPrc.imagefilepth = "alpha"
	end if
	'20230713 htw end 주문가격 에디트 투명설정

	imgBg.imgpath       = "alpha128"
	Dim szOpen
	Dim tData
	szOpen = Form.GetOpenLinkData()
	if Trim(szOpen) == "" then
		Exit Sub
	end if
'	Form.ShowAlert("주문가능", szOpen)
	tData = Split(szOpen, "★")

	if UBound(tData) > 0 then
'		szData = Form.GetCtlProp("#acc", "total") & "★" & Form.GetCtlProp("#acc", "sequence") & "★" & g_szCd & "★" & szPrc & "★" & cmbMkt.cbkeydata
		'0=계좌 1=계좌 2=종목코드 3=입력가격 4=시장콤보
		g_szAcnt   	= tData(0)
		g_szAcntCd 	= tData(1)
		g_szFullCd 	= tData(2)
'		
		g_szInner 	= Form.GetItemCodeInfo(g_szFullCd, "innermarket")
'		
		g_szNowPrc	= tData(3)
		edtPrc.caption = g_szNowPrc
		
		g_szMkCd		= tData(4)
		g_szMk 		= tData(5)
		
		g_szPrc = tData(3)
		call Check_OrderQty()
'		if Trim(tData(11)) <> "" then
'			g_szPrc = tData(11)
'		else
'			g_szPrc = tData(13)
'		end if
	end if
		
End Sub
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szPrc
	g_szPrc = edtPrc.caption
	' ----------------------------------------------------------------------
	' 주문가능금액 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_420r" or szTranID == "obtrs_comn_420r_1" then
	    DATAMANAGER.ClearInputData(0, szTranID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, g_szAcnt)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, g_szAcntCd)		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, g_szFullCd)		' 종목코드
		'20160601 NOHES_I/O변경 ODER_PRC -> BOND_ODER_UNPR
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BOND_ODER_UNPR"		, 0, g_szPrc)	' 주문가격
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BOND_MKPL_CLS_CODE" 	, 0, g_szMkCd ) 	
		if szTranID == "obtrs_comn_420r" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 	, "2" )	'현금가능
		elseif szTranID == "obtrs_comn_420r_1" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 	, "1" )	'최대가능
		end if
	elseif szTranID == "ohhts_7052_001r" then
		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMkCd)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szFullCd)
		
	end if

End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	if szTranID == "obtrs_comn_420r" then
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub btnPlus_OnClick() 
	'20160602 NOHES START 채권 틱단위
	Dim szPlus
	
	If Trim(g_szFullCd) == "" Then
		szPlus = "1" 
	Else
		szPlus = Form.GetItemCodeInfo(g_szFullCd, "bondunit")
	End If
	
	'20160602 NOHES END
	Dim szPrc
	szPrc  = edtPrc.caption

	if Trim(szPrc) == "" then
		'현재가 조회수행
		Request_Price()
	else
		Call Calc_Price(0, szPlus)
	end if
	
End Sub

'============================================================================
Sub btnMinus_OnClick()
	'20160602 NOHES START 채권 틱단위
	Dim szMinus
	
	If Trim(g_szFullCd) == "" Then
		szMinus = "1"
	Else
		szMinus = Form.GetItemCodeInfo(g_szFullCd, "bondunit")
	End If
	'20160602 NOHES END
	Dim szPrc
	szPrc  = edtPrc.caption

	if Trim(szPrc) == "" then
		'현재가 조회수행
		Request_Price()
	else
		Call Calc_Price(1, szMinus)
	end if
	
End Sub

'============================================================================
' 20160602 틱단위 수정
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn, szPM)
	Dim szPrc, szUnit
'	szUnit = "1"
	If Trim(szPM) == "" or Trim(szPM) == " " or Trim(szPM) == "0" Then
		szUnit = "1"
	Else
		szUnit = Trim(szPM)
	End If
	
	szPrc  = edtPrc.caption
	
	CDbl decP2
	
	'20230122_01 HWG START : 거래소차세대 대응
	decP2 = Round(Cdbl(FormatNumber(szPrc, 2)) Mod Cdbl(FormatNumber(szPM, 2)),2) 'Round(CDbl(szPrc) Mod CDbl(szUnit), 2)
	'20230122_01 HWG END
	
	if Trim(szPrc) <> "" then
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then	
			szPrc = CDbl(szPrc) + CDbl(szUnit) - decP2
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > 0 then'else
				If decP2 > 0 Then
					szPrc = CDbl(szPrc) - decP2
				Else
					szPrc = CDbl(szPrc) - CDbl(szUnit) - decP2
				End If
			end if
		end if
		
		edtPrc.caption = szPrc
		Call Check_OrderQty()	'최대수량 조회
	end if
	
End Function


'============================================================================
' Request_Data
'============================================================================
Function Request_Price()
	DATAMANAGER.RequestTranData("ohhts_7052_001r")
End Function

'============================================================================
Sub edtPrc_OnEditComplete()
	g_szPrc = edtPrc.caption
	call Check_OrderQty()
End Sub

'============================================================================
Sub tblAble_OnClick(lRow , lColumn)
	szData = edtPrc.caption.."★"..tblAble.GetCellString(lRow, lColumn)
	
	if lRow = 1 and lColumn = 2 then
		Form.SendReturnToParent("Able_Popup" , szData)
		Form.CloseForm()
	elseif lRow = 3 and lColumn = 2 then
		Form.SendReturnToParent("Able_Popup" , szData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Check_OrderQty()
	DATAMANAGER.RequestTranData("obtrs_comn_420r")
	DATAMANAGER.RequestTranData("obtrs_comn_420r_1")
End Sub 

'============================================================================
Sub bntPrc_OnClick()
	if g_szMk == Null or g_szMk == "" then
		Form.ShowAlert( "알림", "시장구분 코드가 존재하지 않습니다.")
		Exit Sub
	end if
	szData = "0★" & edtPrc.caption  & "★" & g_szMk & "★" & g_szFullCd
	Form.OpenPopup("mbfnp54020_p8", szData, "")  
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "PRC_POPUP" then
	   edtPrc.caption = sRet
	   call Check_OrderQty()
	end if
End Sub

