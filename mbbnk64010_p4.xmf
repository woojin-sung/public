			<TRAN tranid="obpds_srvc_182r" trcode="obpds_srvc_182r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obacp_comm_063r" trcode="obacp_comm_063r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obrtp_tact_102r" trcode="obrtp_tact_102r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obrtp_tact_101a" trcode="obrtp_tact_101a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obrtp_tact_101a_2" trcode="obrtp_tact_101a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obrtp_tact_004a" trcode="obrtp_tact_004a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obrtp_tact_005a" trcode="obrtp_tact_005a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obrtp_tran_040r" title="최근이체계좌 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="87" _ulen="67" >

ACNO^계좌번호^8^0^0^0^0^0^0
CRNC_CLS_CODE^통화구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="50" inout="out" _len="375" _ulen="295" >

FILE_NAME^파일명^40^0^0^0^0^0^0
BANK_NAME^은행명^40^0^0^0^0^0^0
