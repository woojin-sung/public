'============================================================================
' 화 면 명 : 외화이체 계좌선택팝업
'============================================================================
' obrtp_tact_004a는 obrtp_tact_101a로 교체해야 하는데 시간없어서 못함.. 2023.12.12 JWH
' 신지환 2024.01.22 v002 자주쓰는계좌 등록 안 된 경우 바로가기 버튼 추가 (개인&법인) / 타금융 내계좌 등록 안된 경우 바로가기 버튼 추가 (개인)

Dim g_szSeparator
Dim g_szCustNo '고객번호
Dim g_szUserID '고객아이디
Dim g_szUserNm '고객명

Dim g_curAlias
Dim g_szAlias

Dim g_nRecentIndex
Dim g_nOftenIndex
Dim g_nMyIndex
Dim g_szCustClsCode 'JWH 20240201

'============================================================================
Sub Form_OnFormInitBefore()
    grdRecent.setMaintainingRatio( "bd_logo" , 0, "1")
	
    grdOften.setMaintainingRatio( "bd_logo" , 0, "1")
    grdOften.setMaintainingRatio( "bd_edit" , 0, "1")
    grdOften.setMaintainingRatio( "bd_edit1" , 0, "1")
    grdOften.rowmove = "2"	'2.상하 + 좌 드래그 | 3.좌드래그    
    grdOften.setDragImage("edit_guide_01.png")
    grdOften.setDragImageOption(true,0)
    
    grdMyAcnt.setMaintainingRatio( "bd_logo" , 0, "1")
    grdMyAcnt.setMaintainingRatio( "bd_edit" , 0, "1")
    grdMyAcnt.setMaintainingRatio( "bd_edit1" , 0, "1")
    
End Sub

'============================================================================
Sub Form_OnFormInit()

    grdOften.SetUseLoadFast(True)      '이미지세팅 속도 개선
    grdOften.SetUseNewDragMotion(True) '드래그 끊김방지
    grdOften.changeDragStartOffset(True) '드래그 시작위치 조정
    grdOften.changeDragScrollSpeed(8)    '드래그 속도
	
    If Trim(acntList.total) == "" Then
        Form.MsgBox( "알림", "출금계좌가 없습니다.", "ACNT_NO_CLOSE", 0 )
        Exit Sub
    End If
    
    g_OSType = Form.GetSharedData("&OS_TYPE", false )
    
    If g_OSType == "1" Then '안드로이드
        grdOften.SetVisibleCol(4, "0")
        grdRecent.SetVisibleCol(6, "0")
        grdMyAcnt.SetVisibleCol(3, "0")
    Else
        grdOften.SetVisibleCol(3, "0")
        grdRecent.SetVisibleCol(5, "0")
        grdMyAcnt.SetVisibleCol(2, "0")
    End If
    g_AllResetCnt = 0

    g_szCustNo = Form.GetSharedData("&CUST_NUM", false ) '고객번호
    g_szUserID = Form.GetSharedData("&USER_ID", false) '고객아이디
    g_szUserNm = Form.GetSharedData("&USER_NAME", false) '고객명

    f_InitValue()
	
    DATAMANAGER.RequestTranData("obrtp_tran_040r")
    DATAMANAGER.RequestTranData("obrtp_tact_102r")
    DATAMANAGER.RequestTranData("obpds_srvc_182r")
    
    szOpenLinkData = Split(Form.GetOpenLinkData(), "★")
    
    If Ubound(szOpenLinkData) < 1 Then
        Exit Sub
    End If	

    If szOpenLinkData(0) = "2" then	'메리츠증권 선택, 입력란 선택시 : 계좌선택 > 내계좌 > 메리츠 탭 우선 제공
        tabAcnt.currenttab = 2
        tabAcnt_OnTabChanged(2)
    Else
        tabAcnt.currenttab = 0
        tabAcnt_OnTabChanged(0)
    End if
    
    g_szCustClsCode = szOpenLinkData(1)
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'
    If sKeyName == "mbbnk61140_fin" Then 'JWH 20240205
        Form.SendReturnToParent(sKeyName , "ok")
        Form.CloseForm()
    End If

    If sKeyName == "POPUP_TEXT" Then    
        g_szAlias = sRet
        If g_curAlias = "OFTEN" Then
            DATAMANAGER.RequestTranData("obrtp_tact_101a") '자주쓰는계좌 별명 변경
        ElseIf g_curAlias = "MY" Then
            DATAMANAGER.RequestTranData("obrtp_tact_004a") '타금융내계좌 별명 변경
        End If
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    szACNO = acntList.total
    szASNO = acntList.sequence

	If szTranID == "obrtp_tran_040r" Then '최근이체계좌 조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"          , 0 , szACNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "2"   ) '% 전체, 1 원화 2 외화
	
    ElseIf szTranID == "obrtp_tact_102r" Then '자주쓰는계좌 조회
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"          , 0 , "01"       ) '업무구분코드	'01 자주 02 약정 03 오뱅
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE"      , 0 , "2"        ) '통화구분코드	'1:원화, 2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"               , 0 , szACNO     ) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ASNO"               , 0 , szASNO     ) '계좌순번

    ElseIf szTranID == "obpds_srvc_182r" Then '내계좌 조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_CLS_CODE"      , 0 , "1"        ) '조회구분코드 '1:내계좌목록조회
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_CSNU"          , 0 , "0"        )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"               , 0 , szACNO     ) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ASNO"               , 0 , szASNO     ) '계좌순번

    ElseIf szTranID == "obacp_comm_063r" Then '약정계좌 조회
    
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ELFN_ID"            , 0 , g_szUserID  )
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "WNCR_FRCR_CLS_CODE" , 0 , "2"         )	'원화외화구분코드	'2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"               , 0 , szACNO      ) '계좌번호
	
    ElseIf szTranID == "obrtp_tact_101a" Then '자주쓰는계좌 별명 처리
		
        szSRNO  = grdOften.GetCellData("bd_srno"  , g_nOftenIndex)
        szAlias = grdOften.GetCellData("bd_alias" , g_nOftenIndex)
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE"  , 0 , "3"       )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"           , 0 , g_szCustNo) 
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"      , 0 , "01"      ) '업무구분코드	'01 자주 02 약정
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE"  , 0 , "2"       ) '통화구분코드	'1:원화, 2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_SRNO"      , 0 , szSRNO    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "USER_NAME"      , 0 , g_szAlias )	'수정한 별명
	
    ElseIf szTranID == "obrtp_tact_101a_2" Then '자주쓰는계좌 삭제
    
        szCnftAcno = grdOften.GetCellData("bd_cnftacno" , g_nOftenIndex)
        szCnftAsno = grdOften.GetCellData("bd_cnftasno" , g_nOftenIndex)
        szBankCode = grdOften.GetCellData("bd_code"     , g_nOftenIndex)
        szBankAcno = grdOften.GetCellData("bd_acno"     , g_nOftenIndex)
        szBicCode  = grdOften.GetCellData("bd_biccode"  , g_nOftenIndex)

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE" , 0 , "5"       )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"          , 0 , g_szCustNo)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01"      ) '업무구분코드	'01 자주 02 약정
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "2"       ) '통화구분코드	'1:원화, 2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_SRNO"     , 0 , 0         )
	
        If Trim(szBankCode) == "287" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "1"       )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"          , 0 , szCnftAcno)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"          , 0 , szCnftAsno)
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "2"       )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_CODE"          , 0 , szBankCode)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"      , 0 , szBankAcno)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BIC_CODE"           , 0 , szBicCode )
        End If    
	
    Elseif szTranID == "obrtp_tact_005a" then	'자주쓰는계좌 순서 변경
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"               , 0 , g_szCustNo)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"          , 0 , "01"      ) '업무구분코드	'01 자주 02 약정
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE"      , 0 , "2"       ) '통화구분코드	'1:원화, 2:외화

        For i = 0 to CInt(grdOften.rowcount) - 1			
            szAcno     = grdOften.GetCellData("bd_acno"     , i)
            szBankAcnm = grdOften.GetCellData("bd_bankacnm" , i)
            szCnftAcno = grdOften.GetCellData("bd_cnftacno" , i)
            szCnftAsno = grdOften.GetCellData("bd_cnftasno" , i)
            szBankCode = grdOften.GetCellData("bd_code"     , i)
            szBicCode  = grdOften.GetCellData("bd_biccode"  , i)
            szUserName = grdOften.GetCellData("bd_alias"    , i)
            nIqrySrno  = grdOften.GetCellData("bd_srno"     , i)
	    
            If Trim(szBankCode) = "287" Then
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ONCO_OTCO_CLS_CODE" , i , "1"   )
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ACNO"               , i , szAcno)
            Else
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ONCO_OTCO_CLS_CODE" , i , "2"       )
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BANK_CODE"          , i , szBankCode)
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BANK_USE_ACNO"      , i , szAcno    )
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BANK_ACNM"          , i , szBankAcnm)		
            End If
			
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BIC_CODE"  , i , szBicCode )
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "USER_NAME" , i , szUserName)	
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "CNFT_ACNO" , i , szCnftAcno)
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "CNFT_ASNO" , i , szCnftAsno)
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "SRNO"      , i , nIqrySrno )		
			 
        Next
		
    ElseIf szTranID == "obrtp_tact_004a" Then '타금융 내계좌 별명 처리
		
		szBicCode = grdMyAcnt.GetCellData("bd_biccode", g_nMyIndex)
		szAcNo    = grdMyAcnt.GetCellData("bd_acno"   , g_nMyIndex)
		szAlias   = grdMyAcnt.GetCellData("bd_alias"  , g_nMyIndex)

		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"      , 0 , "U"       )'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO"               , 0 , g_szCustNo)'고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD"          , 0 , "02"      )'02.약정			
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE"      , 0 , "2"       )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BIC_CODE"           , 0 , szBicCode )'BIC코드			
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_USE_ACNO"      , 0 , szAcNo    )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "USER_NAME"          , 0 , g_szAlias )
		
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    If szTranID == "obrtp_tran_040r" Then '최근이체계좌 조회
    
        nCnt = grdRecent.rowcount
        For i = 0 To nCnt - 1
	
            szBankName = grdRecent.GetCellData("bd_bankname" , i)
            szAcno     = grdRecent.GetCellData("bd_acno"     , i)
            szRmtName  = grdRecent.GetCellData("bd_rmtname"  , i)
            szBankCode = grdRecent.GetCellData("bd_code"     , i)
            szBicCode  = grdRecent.GetCellData("bd_biccode"  , i)
	    
            grdRecent.SetCellData("bd_bank" , i , szBankName.." "..szAcno   )
            grdRecent.SetCellData("bd_name" , i , szRmtName                 )
            grdRecent.SetCellData("bd_logo" , i , "bank"..szBankCode..".png")
			
            grdRecent.setMaintainingRatio("bd_logo"    , i , "1")
	    
            grdRecent.SetCellMaxLineCount("bd_name", 1)
        Next
	
        lblRecentTotal.caption = grdRecent.rowcount.."개의 최근 이체 내역이 있어요."

    ElseIf szTranID == "obrtp_tact_102r" Then '자주쓰는계좌 조회
    
        If DATAMANAGER.IsMoreNextData(szTranID) == True Then
            DATAMANAGER.RequestNextData(szTranID)
            Exit Sub
        End If
    
        nCnt = grdOften.rowcount

        If CInt(nCnt) > 100 Then
            grdOften.rowmove = "3"	'2.상하 + 좌 드래그 | 3.좌드래그
            grdOften.setDragImage("edit_guide_02.png")
            grdOften.setDragImageOption(False,0)
        Else
            grdOften.rowmove = "2"	'2.상하 + 좌 드래그 | 3.좌드래그
            grdOften.setDragImage("edit_guide_01.png")
            grdOften.setDragImageOption(True,0)
        End If
	
        For i = 0 To nCnt - 1
	
            szBankName = grdOften.GetCellData("bd_bankname" , i)
            szAcno     = grdOften.GetCellData("bd_acno"     , i)
            szBankAcnm = grdOften.GetCellData("bd_bankacnm" , i)
            szCnftAcnm = grdOften.GetCellData("bd_cnftacnm" , i)
            szCnftAcno = grdOften.GetCellData("bd_cnftacno" , i)
            szCnftAsno = grdOften.GetCellData("bd_cnftasno" , i)
            szBankCode = grdOften.GetCellData("bd_code"     , i)
            szBicCode  = grdOften.GetCellData("bd_biccode"  , i)

            If Trim(szBankCode) == "" Or Trim(szBankCode) == "287" Then
                grdOften.SetCellData("bd_bank" , i , szBankName .. " " .. szCnftAcno..szCnftAsno)
                grdOften.SetCellData("bd_name" , i , szCnftAcnm)
                grdOften.SetCellData("bd_acno" , i , szCnftAcno..szCnftAsno)
		
            Else
                grdOften.SetCellData("bd_bank" , i , szBankName .. " " .. szAcno)
                grdOften.SetCellData("bd_name" , i , szBankAcnm)
		
            End If
		
            grdOften.setMaintainingRatio( "bd_logo" , i , "1")
            grdOften.SetCellData("bd_logo" , i , "bank"..szBankCode..".png")
		
            grdOften.SetCellMaxLineCount("bd_name" , 1)
            grdOften.SetCellMaxLineCount("bd_alias", 1)
        Next

        lblOftenTotal.caption = grdOften.rowcount.."개의 자주 쓰는 계좌가 있어요."
	
	
    ElseIf szTranID == "obpds_srvc_182r" Then '내계좌 조회
    
        nCnt = grdMyAcnt.rowcount
        For i = 0 To nCnt - 1
	
            szBankName = grdMyAcnt.GetCellData("bd_bankname" , i)
            szAcno     = grdMyAcnt.GetCellData("bd_acno"     , i)
            szAsno     = grdMyAcnt.GetCellData("bd_asno"     , i)
            szPrnm     = grdMyAcnt.GetCellData("bd_prnm"     , i)

            grdMyAcnt.setMaintainingRatio( "bd_logo" , i , "1")
	    
            grdMyAcnt.SetCellData( "bd_name" , i , szPrnm                                      )
            grdMyAcnt.SetCellData( "bd_logo" , i , "bank287.png"                                    )
            grdMyAcnt.SetCellData( "bd_bank" , i , Left(szAcno,4).."-"..Right(szAcno,4).."-"..szAsno)

            grdMyAcnt.SetCellData("bd_edit"  , i , "alpha.png")
            grdMyAcnt.SetCellData("bd_edit1" , i , "alpha.png")

            grdMyAcnt.SetCellMaxLineCount("bd_name", 1)
            grdMyAcnt.SetCellMaxLineCount("bd_alias", 1)
        Next

    ElseIf szTranID == "obacp_comm_063r" Then '약정계좌 조회

        nCnt = grdMyAcnt.rowcount
        For i = 0 To nCnt - 1
	
            szBankName = grdMyAcnt.GetCellData("bd_bankname" , i)
            szAcno     = grdMyAcnt.GetCellData("bd_acno"     , i)
            szBankCode = grdMyAcnt.GetCellData("bd_code"     , i)
            szBicCode  = grdMyAcnt.GetCellData("bd_biccode"  , i)
            szACNT_EXPL     = grdMyAcnt.GetCellData("bd_acntexpl"     , i)
	    	    
            grdMyAcnt.setMaintainingRatio("bd_logo" , i , "1")
	    
            grdMyAcnt.SetCellData("bd_name" , i , szACNT_EXPL               )
            grdMyAcnt.SetCellData("bd_logo" , i , "bank"..szBankCode..".png")
            grdMyAcnt.SetCellData("bd_bank" , i , szBankName.." "..szAcno   )

            grdMyAcnt.SetCellData("bd_edit"  , i , "icon_pencil.png")
            grdMyAcnt.SetCellData("bd_edit1" , i , "icon_pencil.png")

            grdMyAcnt.SetCellMaxLineCount("bd_name", 1)
            grdMyAcnt.SetCellMaxLineCount("bd_alias", 1)
        Next

        If tabAcnt.currenttab == "2" Or Cdbl(tabAcnt.currenttab) == 2 Then
	
            If Cdbl(grdMyAcnt.rowcount) == 0 And g_szCustClsCode == "1" Then 'JWH 20240201

                lblGuide1.visible = "1" 'v002
                lblGuide2.visible = "1"
                lblMove.visible = "1"
	    
                lblGuide1.caption = "본인명의 계좌 약정 등록 후 간편하게"
                lblGuide2.caption = "이용할 수 있어요."
                lblMove.caption = "계좌 등록 하러가기 >"
            Else

                lblGuide1.visible = "0"
                lblGuide2.visible = "0"
                lblMove.visible = "0"
	    
            End If

        End If
	
    ElseIf szTranID == "obrtp_tran_041a" Then '최근이체계좌삭제
        Form.Toast(0, "최근 계좌 목록에서 삭제되었습니다.", 0)
        grdRecent.SetDeleteRow(g_nRecentIndex)

    ElseIf szTranID == "obrtp_tact_101a" Then '자주쓰는계좌별명변경
        grdOften.SetCellData("bd_alias" , g_nOftenIndex , g_szAlias)
		
    ElseIf szTranID == "obrtp_tact_101a_2" Then	'자주쓰는계좌삭제
        Form.Toast(0, "자주쓰는 목록에서 삭제되었습니다.", 0)
        grdOften.SetDeleteRow(g_nOftenIndex)
		
    ElseIf szTranID == "obrtp_tact_004a" Then '타금융내계좌 별명변경
        grdMyAcnt.SetCellData("bd_alias" , g_nMyIndex, g_szAlias)
    End if
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr <> "" And szSubErr <> Null Then
        szErrMsg = szErrMsg .. "\n" .. szSubErr
    End If
	
    If szTranID == "obrtp_tran_041a" Then
        Form.Toast(0, szSubErr , 0)
        DATAMANAGER.RequestTranData("obrtp_tran_040r")
    End If	 
    
    If szTranID == "obrtp_tact_101a" Or szTranID == "obrtp_tact_101a_2" Then '자주쓰는계좌 별명변경 / 삭제
        Form.Toast(0, szSubErr , 0)
        DATAMANAGER.RequestTranData("obrtp_tact_102r")
    End If	 
    
    If szTranID == "obrtp_tact_005a" Then '자주쓰는계좌 순서변경
        Form.Toast(0, szSubErr , 0)
        DATAMANAGER.RequestTranData("obrtp_tact_102r")
    End If
    
    If szTranID == "obrtp_tact_004a" Then '타금융내계좌 별명변경
        Form.Toast(0, szSubErr , 0)
        DATAMANAGER.RequestTranData("obacp_comm_063r")
    End If
    
End Sub

'============================================================================
Sub rdoMyAcnt_OnClick(nIndex) '내 계좌 메리츠증권/타금융계좌 라디오 선택

    grdMyAcnt.SetClear()
    If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
         lblGuide1.visible = "0" 'v002
         lblGuide2.visible = "0"
         lblMove.visible = "0"

		DATAMANAGER.RequestTranData("obpds_srvc_182r")
    Else
        DATAMANAGER.RequestTranData("obacp_comm_063r")
    End If
    
End Sub

'============================================================================
Sub grdRecent_OnClickUp(lRow, szCellID) '최근 계좌 그리드 선택

    szBankCode = grdRecent.GetCellData("bd_code", lRow)
    szBankAcno = grdRecent.GetCellData("bd_acno", lRow)
    szBankName = grdRecent.GetCellData("bd_bankname", lRow)
    szBicCode  = grdRecent.GetCellData("bd_biccode", lRow)
	
	szCurrencyCode = Form.GetSharedData("64010_CurrencyCode")
	
	if Form.GetSharedData("64010_OutTransYN") == "N" and szBankCode <> "287" then	'타행불가통화인 경우
		
		Form.MsgBox("알림", "["..szCurrencyCode.."] 타행 이체는 영업점을\n통해 이체 가능합니다.", "", 6)
		Exit Sub
	elseif Form.GetSharedData("64010_OutTransYN") == "Y" and szCurrencyCode = "CNY" and szBankCode <> "287" and szBankCode <> "004" then '2023-12-07 CNY 제외
		
		Form.MsgBox("알림", "["..szCurrencyCode.."] 타행 이체는 국민은행 또는 \n영업점을 통해 이체 가능합니다.", "", 6)
		Exit Sub
		
    Else		
        sPosInfo = szBankCode & "★" & szBankAcno & "★" & szBankName & "★" & szBicCode & "★" & "B"
        Form.SendReturnToParent("mbbnk64010_p4", sPosInfo )
        Form.CloseForm()
    End If
    
End Sub

'============================================================================
Sub grdRecent_OnDeleteRow(lRow) '최근외화이체 삭제

    g_nRecentIndex = Cint(lRow)
    
    szBankAcno = grdRecent.GetCellData("bd_acno"     , lRow)
    szBankCode = grdRecent.GetCellData("bd_code"     , lRow)

    DATAMANAGER.SetDataValue(0, "obrtp_tran_041a" , "InBlock1" , "MNRC_ACNO"     , 0 , szBankAcno    )	'입금계좌
    DATAMANAGER.SetDataValue(0, "obrtp_tran_041a" , "InBlock1" , "CRNC_CLS_CODE" , 0 , "2"           )	'통화구분코드(2:외화)
    DATAMANAGER.SetDataValue(0, "obrtp_tran_041a" , "InBlock1" , "BANK_CODE"     , 0 , szBankCode    )	'은행코드
    DATAMANAGER.SetDataValue(0, "obrtp_tran_041a" , "InBlock1" , "ACNO"          , 0 , acntList.total)
	
    DATAMANAGER.RequestTranData("obrtp_tran_041a")
	
End Sub

'============================================================================ 
Sub grdOften_OnClickUp(lRow, szCellID) ' 자주 쓰는계좌 그리드 선택

    If szCellID == "bd_alias" Then '계좌별명영역 터치하면 아무일 안생기게 함. 일단 이유를 몰라서 안지우고 냅둠 2023.12.12 JWH
        Exit Sub
    End If

    g_nOftenIndex = CInt(lRow)

    If szCellID == "bd_edit" Or szCellID == "bd_edit1" Or szCellID == "bd_cell0" Or szCellID == "bd_cell5" Or szCellID == "bd_cell7" Or szCellID == "bd_cell6" Then '별명 수정(화면 닫힘 이슈로 터치영역 추가)
        g_curAlias = "OFTEN"
        szAlias = grdOften.GetCellData("bd_alias", lRow)
        Form.OpenPopupAnimation("textkeypadpopup", "계좌별명☆"..szAlias.."☆최대 10글자 입력 가능☆1☆20" , "","2")
        Exit Sub
    End If
    
    szBankCode = grdOften.GetCellData("bd_code"     , lRow)
    szBankAcno = grdOften.GetCellData("bd_acno"     , lRow)
    szBankName = grdOften.GetCellData("bd_bankname" , lRow)
    szBicCode  = grdOften.GetCellData("bd_biccode"  , lRow)

    szCurrencyCode = Form.GetSharedData("64010_CurrencyCode")

    If Form.GetSharedData("64010_OutTransYN") == "N" and szBankCode <> "287" then	'타행불가통화인 경우
        Form.MsgBox("알림", "["..szCurrencyCode.."] 타행 이체는 영업점을\n통해 이체 가능합니다.", "", 6)
        Exit Sub
    ElseIf Form.GetSharedData("64010_OutTransYN") == "Y" and szCurrencyCode = "CNY" and szBankCode <> "287" and szBankCode <> "004" then '2023-12-07 CNY 제외		
        Form.MsgBox("알림", "["..szCurrencyCode.."] 타행 이체는 국민은행 또는 \n영업점을 통해 이체 가능합니다.", "", 6)
        Exit Sub
    Else
        sPosInfo = szBankCode & "★" & szBankAcno & "★" & szBankName & "★" & szBicCode & "★" & "B"
        Form.SendReturnToParent("mbbnk64010_p4", sPosInfo )
        Form.CloseForm()
    End If

End Sub

'============================================================================
Sub grdOften_OnDeleteRow(lRow) '자주쓰는계좌 삭제

    g_nOftenIndex = Cint(lRow)	
    DATAMANAGER.RequestTranData("obrtp_tact_101a_2")	
    
End Sub

'============================================================================
Sub grdOften_OnDropRow() '자주쓰는계좌 순서 변경
	
    If CInt(grdOften.rowcount) > 1 Then
        DATAMANAGER.RequestTranData("obrtp_tact_005a") 
    End If
End Sub

'============================================================================
Sub grdMyAcnt_OnClickUp(lRow, szCellID) '내 계좌 그리드 선택

    If szCellID == "bd_alias" Then
        Exit Sub
    End If

    g_nMyIndex = CInt(lRow)

    If CInt(rdoMyAcnt.currentindex) == 1 and (szCellID == "bd_edit" Or szCellID == "bd_edit1" Or szCellID == "bd_cell7" Or szCellID == "bd_cell8") Then '내계좌 > 타금융 별명 수정'(화면 닫힘 이슈로 터치영역 추가)
        g_curAlias = "MY"
        szAlias = grdMyAcnt.GetCellData("bd_alias", lRow)
        Form.OpenPopupAnimation("textkeypadpopup", "계좌별명☆"..szAlias.."☆최대 10글자 입력 가능☆1☆20" , "","2")
        Exit Sub
    End If

    If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
        szBankCode = "287"
        szBankAcno = grdMyAcnt.GetCellData("bd_acno" , lRow)..grdMyAcnt.GetCellData("bd_asno" , lRow)
        szBankName = "메리츠증권"
        szBicCode  = "KFBCKRSE"
    Else
        szBankCode = grdMyAcnt.GetCellData("bd_code"     , lRow)
        szBankAcno = grdMyAcnt.GetCellData("bd_acno"     , lRow)
        szBankName = grdMyAcnt.GetCellData("bd_bankname" , lRow)
        szBicCode  = grdMyAcnt.GetCellData("bd_biccode"  , lRow)	
    End If
	
    szCurrencyCode = Form.GetSharedData("64010_CurrencyCode")
	
    if Form.GetSharedData("64010_OutTransYN") == "N" and szBankCode <> "287" then	'타행불가통화인 경우
        Form.MsgBox("알림", "["..szCurrencyCode.."] 타행 이체는 영업점을\n통해 이체 가능합니다.", "", 6)
        Exit Sub
    ElseIf Form.GetSharedData("64010_OutTransYN") == "Y" and szCurrencyCode = "CNY" and szBankCode <> "287" and szBankCode <> "004" then '2023-12-07 CNY 제외
        Form.MsgBox("알림", "["..szCurrencyCode.."] 타행 이체는 국민은행 또는 \n영업점을 통해 이체 가능합니다.", "", 6)
        Exit Sub
    Else	
        sPosInfo = szBankCode & "★" & szBankAcno & "★" & szBankName & "★" & szBicCode & "★" & "B"
        Form.SendReturnToParent("mbbnk64010_p4", sPosInfo )
        Form.CloseForm()
    End If

End Sub

'============================================================================
Sub tabAcnt_OnTabChanged(nCurrentTab)

    If nCurrentTab == 0 Then

        grdRecent.visible = "1"
        grdOften.visible = "0"
        grdMyAcnt.visible = "0"
        rdoMyAcnt.visible = "0"
        lblMyAcntLine.visible = "0"
        lblRecentTotal.visible = "1"
        lblRecentTotal.caption = grdRecent.rowcount.."개의 최근 이체 내역이 있어요."
        lblOftenTotal.visible = "0"
        lblGuide1.visible = "0"
        lblGuide2.visible = "0"
        lblMove.visible = "0"

        grdRecent.rowmove = "3"	'좌 드래그
        grdRecent.setDragImage("edit_guide_02.png")
        grdRecent.setDragImageOption(False, 0)
		
        DATAMANAGER.RequestTranData("obrtp_tran_040r")
	
    Elseif nCurrentTab == 1 Then
    
        grdRecent.visible = "0"
        grdOften.visible = "1"
        grdMyAcnt.visible = "0"
        rdoMyAcnt.visible = "0"
        lblMyAcntLine.visible = "0"
        lblRecentTotal.visible = "0"
        lblOftenTotal.visible = "1"
        lblOftenTotal.caption = grdOften.rowcount.."개의 자주 쓰는 계좌가 있어요."

        DATAMANAGER.RequestTranData("obrtp_tact_102r")
	
        If Cdbl(grdOften.rowcount) == 0 Then
            lblGuide1.visible = "1"
            lblGuide2.visible = "1"
            lblMove.visible = "1"
	    
            lblGuide1.caption = "자주쓰는계좌를 미리 등록한 후 간편하게"
            lblGuide2.caption = "이용할 수 있어요."
            lblMove.caption = "계좌 등록 하러가기 >"
        Else
            lblGuide1.visible = "0"
            lblGuide2.visible = "0"
            lblMove.visible = "0"	
        End If

		
    ElseIf nCurrentTab == 2 Then
        grdRecent.visible = "0"
        grdOften.visible = "0"
        grdMyAcnt.visible = "1"
        rdoMyAcnt.visible = "1"
        rdoMyAcnt.currentindex = "0"
        lblMyAcntLine.visible = "1"
        lblRecentTotal.visible = "0"
        lblOftenTotal.visible = "0"
        lblGuide1.visible = "0"
        lblGuide2.visible = "0"
        lblMove.visible = "0"
        DATAMANAGER.RequestTranData("obpds_srvc_182r")
    End If
	
End Sub

'============================================================================
Sub grdMyAcnt_OnScrollEnd()

    If CInt(rdoMyAcnt.currentindex) == 0 Then ' 메리츠증권
        szNext = DATAMANAGER.IsMoreNextData("obpds_srvc_182r")
        If szNext == "1" Or szNext == True Then
            DATAMANAGER.RequestNextData("obpds_srvc_182r")
        End If
    Else
        szNext = DATAMANAGER.IsMoreNextData("obacp_comm_063r")
        If szNext == "1" Or szNext == True Then
            DATAMANAGER.RequestNextData("obacp_comm_063r")
        End If
    End If
    
End Sub

'============================================================================
Sub grdRecent_OnScrollEnd()

    szNext = DATAMANAGER.IsMoreNextData("obrtp_tran_040r")
	
    If szNext == "1" Or szNext == True Then
        DATAMANAGER.RequestNextData("obrtp_tran_040r")
    End If
    
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub f_InitValue()

    g_szBankCode = "287"
    g_szBankName = "메리츠증권"
    g_szBankAcno = ""
    g_szBankAcntNm = ""
    
    g_nRecentIndex = 0
    g_nOftenIndex  = 0
    g_nMyIndex     = 0 
    
    g_szAlias = ""
	
    g_szSeparator = "★"
		
    grdRecent.SetClear()
    grdOften.SetClear()
    grdMyAcnt.SetClear()

End Sub
'============================================================================
Sub lblMove_OnClick()
    If tabAcnt.currenttab == "1" Or Cdbl(tabAcnt.currenttab) == 1 Then
        Form.OpenFramePopup("mbbnk61140" , "0" .. "★" .. "1" , "")
    ElseIf tabAcnt.currenttab == "2" Or Cdbl(tabAcnt.currenttab) == 2 Then
        Form.OpenFramePopup("mbbnk61140", "1" .. "★" .. "1", "")
    Else
        Form.MsgBox("알림", "계좌를 등록할 수 없습니다.", "", 0)
        Exit Sub
    End If
End Sub


