	<SCRIPT_INFO _len="932" _ulen="816" >
'--===========================================================================
' 01. 화 면 명 : 당사 대체출고_안내사항 팝업
' 02. 화면설명 : 당사 대체출고_안내사항 팝업
' 03. 작    성 : 2022.03.29 김수진 
' 04. 수    정 : 
'--===========================================================================

'============================================================================
Sub Form_OnFormInit()

	Dim szOpenData
	szOpenData = Form.GetopenLinkData()

	if szOpenData <> "" Then
		If szOpenData == "3" Then
			Form.SetScreenName("당사대체출고 유의사항")
			cont0.tblInfo3.visible = True
		Else
			Form.SetScreenName("타사대체출고 유의사항")
			cont0.tblInfoH.visible = True
		End If
		cont0.SetScrollAutoSize()
	End If
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub


	</SCRIPT_INFO>
