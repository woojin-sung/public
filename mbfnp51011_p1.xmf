						<CELL cell_ly="0,0,0,0" valign="0" line="0,0" caption="ㆍ" impidxs="" />
						<CELL cell_ly="1,0,1,0" line="0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" valign="0" line="0,0" caption="ㆍ" impidxs="" />
						<CELL cell_ly="1,1,1,1" line="0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" valign="0" line="0,0" caption="ㆍ" impidxs="" />
						<CELL cell_ly="1,2,1,2" line="0,0" impidxs="" />
						<CELL cell_ly="0,3,0,3" valign="0" line="0,0" caption="ㆍ" impidxs="" />
