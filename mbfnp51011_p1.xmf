	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fontsize="2" fontstyle="01" caption="유의사항" bgcolor="064:188030030" halign="1" ly_vert="0,0,375,50,1" />
		<IMAGE name="imgClose" autosize="1" imgpath="icon_main_11" ly_vert="331,13,24,24,1" />
		<CONTAINER name="Container0" vscroll="1" ly_vert="0,50,375,547,1" scroll_ly_vert="0,50,375,547,1" >
			<CONTROL_INFO>
				<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="8" outline="0000" designorder="1" ly_vert="10,10,45,582,1" >
