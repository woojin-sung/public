'============================================================================
Dim g_rtChk
g_rtChk  = ""

'============================================================================
Sub Form_OnFormInitBefore()
	Combo0.bgimagetype = "1"
	Combo1.bgimagetype = "1"
End Sub

'============================================================================
Sub Form_OnFormInit()
	f_EventPopup()
	Dim szCombo0
	szCombo0 = Form.GetEnvData("16052_COMBO0")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Form.SetCtlProp("Combo0",  "cbkeydata", szCombo0)
	end if
	
	DATAMANAGER.RequestTranData("ohhts_6223_010r")
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData("ohhts_exst_ictg")
	
	if szTranID == "ohhts_6223_010r" then 
		Grid0.SetClear( )
		
	elseif szTranID == "ohhts_6223_001r" then
		Dim szCombo0, szCombo1, szAdrCd
		szCombo0 = Combo0.cbkeydata
		szCombo1 = Combo1.cbkeydata
		
		szAdrCd = ""
		if szCombo1 == "" then 
			szAdrCd = szCombo0
		else 
			szAdrCd = szCombo1
		end if
		g_rtChk = Form.GetSharedData( "REALTIME_OQ", false )
		
		DATAMANAGER.SetDataValue(false, "ohhts_6223_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV")
		DATAMANAGER.SetDataValue(false, "ohhts_6223_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62230")
		DATAMANAGER.SetDataValue(false, "ohhts_6223_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk)
		DATAMANAGER.SetDataValue(false, "ohhts_6223_001r", "InBlock1", "FIDX_INPUT_ADR_CODE" , 0 , szAdrCd)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6223_010r" then
		Combo0_Setting()
		DATAMANAGER.RequestTranData("ohhts_6223_001r" ) 
	end if
	Dim nCount
	nCount = CInt(DATAMANAGER.GetDataCount(0, "ohhts_6223_001r", "OutBlock1"))
	for i = 0 to nCount-1
		sCode = Grid0.GetCellData("bd_cell5", i)		
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , 0 , sCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_ictg" )
	next	

End Sub


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	Dim sCode, sIsCd, listlocation, nYPos, szData, sExid, sProCode, sName
	sCode = Grid0.GetCellData("bd_cell1", lRow)
	sIsCd = Grid0.GetCellData("bd_cell5", lRow)
	sCode = sCode.."@"..sIsCd
	sExid = Form.GetItemCodeInfo(sCode, "exchid") '국가구분 코드
	sProCode = Grid0.GetCellData("bd_cell5", lRow)
	sName = Grid0.GetCellData("bd_cell0", lRow)

	if sCode <> null and sCode <> ""	then
		listlocation = split(Grid0.location, ":")
		nYPos = Int(listLocation[1])
		szData = sCode.."^"..sProCode.."^"..sName.."^".."".."^"..sExid.."^"..nYPos
		Form.OpenPopup("mhtro16052_p1" , szData , "")
	end if
End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo1",  "cbkeydata" ) 
	Form.SetEnvData(1, "16052_COMBO1", szComboData)
	
	DATAMANAGER.RequestTranData( "ohhts_6223_001r" ) 
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)

	Combo1.clear = true
	Dim nRowCount , keyData
	nRowCount = Grid1.rowcount
	Combo1.cbadddatatext = "`전체"
	
	keyData = Combo0.cbkeydata
	Dim szCode, szSect
	for i = 0 to nRowCount-1
		szCode = Grid1.GetCellData("Code", i)
		szSect = Grid1.GetCellData("Sect", i)
		szComboCode = Left(szCode,3)
		if keyData == szComboCode then
			Combo1.cbadddatatext = szCode.."`"..szSect
		end if
	next
	
	DATAMANAGER.RequestTranData( "ohhts_6223_001r" ) 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData( "ohhts_6223_001r" ) 
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.OpenPopup("mhtro16052_p2", "" , "I")
End Sub


' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
    '20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

'============================================================================
Function Combo0_Setting()
	Combo0.clear = true
	Dim nRowCount, szComboName

	nRowCount = Grid1.rowcount
	Combo0.cbadddatatext = "`전체"		
		
	szComboName = ""
	for i = 0 to nRowCount-1
		Dim szCode, szName
		szCode = Grid1.GetCellData("Code", i)
		szName = Grid1.GetCellData("Name", i)
		
		if szComboName <> szName then
			Dim szComboCode
			szComboCode = ""

			szComboCode = Left(szCode,3)
			if szKey <> szComboCode then
				Combo0.cbadddatatext = szComboCode.."`"..szName
			end if
			szComboName = szName
		end if
	next
	
	Combo1_Setting()
	
end function 

'============================================================================
Function Combo1_Setting()
	Combo1.clear = true
	
	Dim nRowCount
	nRowCount = Grid1.rowcount
	
	szComboCap = Combo0.caption
	if szComboCap == "전체" then
		Combo1.cbadddatatext = "`전체"
	end if
end function 

'============================================================================
Sub Grid0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ohhts_6223_001r") then 
		DATAMANAGER.RequestNextData("ohhts_6223_001r")
	end if
End Sub

