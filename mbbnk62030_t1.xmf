				<LABEL name="LblCost" fontsize="-1" mask="0,0,, 원,0,,0,1,1,0,0" halign="2" multiline="1" ly_vert="133,33,204,30,1" />
			</CONTROL_INFO>
			<CARD_INFO cardheight="72" >
				<CELL name="LblPRNM" />
				<CELL name="ImgCopy" />
				<CELL name="ImgDetail" />
				<CELL name="ImgRefresh" />
				<CELL name="LblDetail" />
				<CELL name="LblLine" />
				<CELL name="LblPRNM0" />
				<CELL name="LblCost" />
			</CARD_INFO>
		</PANNEL>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="15798" _ulen="14946" >
'===========================================================================
' 화 면 명: 다른 금융기관 계좌조회_ALL
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정: 2021.12.08 장원혁 오픈뱅킹 재동의 프로세스 추가
'===========================================================================
'20240611 SWJ START 
'계좌 복사 기능 추가 및 UI 일부 변경
' 계좌 복사 이미지를 가변적인 크기에 맞게 위치시켜야해서(은행계좌 + 계좌번호 길이가 가변적)
' 눈에 보이는 컨트롤만 판넬을 추가하여 변경하였음
' 실제 데이터를 내부에서 필요한 경우가 있으므로 이 땐 그리드를 이용하므로 삭제하면 안된다.
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim g_szi		
Dim g_szj		
Dim g_szx		'Refresh Num
Dim g_szTotAmt   	'총 잔액
Dim g_szNo		'넘버
Dim g_szOpnC		'오픈뱅킹코드
Dim g_szPgNm		'프로그램명
Dim g_szNextYn	'Next 여부 0:next(x) 1:next(o)

Dim LdgrBal     	'잔액
Dim OpngDate    	'계좌개설일자
Dim MtrtDate		'만기일
Dim LastTrDate	'최종입출금일
Dim nCount		'카운트
Dim LdgrBal_rf  	'Refresh 잔액

Dim TrDate  
Dim ApiTlmsClcd  
Dim OpnOtsdTrNo
Dim RpttCsnu
Dim g_SetRmndAmt 'v001

'20240611 SWJ START
Dim g_sOSType
g_sOSType = ""
'20240611 SWJ END
'============================================================================
' SetTr() : TR 입력값 세팅, 조회 요청
'============================================================================
Function SetTr()
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" )
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , g_szOpnC ) 
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID", 0 , g_szID) 'acno랑 둘중하나만
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN", 0 , "Y") 

	DATAMANAGER.RequestTranData("obtss_opnf_008r")
	
End Function
	
'===========================================================================
' Form_OnFormInit()
'===========================================================================
Sub Form_OnFormInit()

	g_szNo = 0
	g_szTotAmt = 0
	nCount = 0
	g_szNextYn = 0 
	g_szi = 0
	g_szj = 1
	g_szx = 0
	LdgrBal_rf = 0
	
	g_szID = Form.GetSharedData("&USER_ID", false )
	TrDate = Form.GetSharedData("&HOST_DATE", false )
	
	'20240611 SWJ START
	g_sOSType = Form.GetSharedData("&OS_TYPE", false)
	
	Pannel0.rowcount = 0
	'20240611 SWJ END
	
End Sub


Sub Form_OnTriggerEvent(sEventName, sParam)
    
    g_SetRmndAmt = Form.GetSharedData("62030_SETRMNDAMT" , True) 'v001
    
	if sEventName = "mbbnk62030_t1" then
		if sParam = "0" then 		'입출금
			g_szOpnC = "1"
			Label1.visible = true
			g_szPgNm = "mbbnk62030_t1"
		elseif sParam = "1" then	'종합계좌
			g_szOpnC = "T"
			Label1.visible = true
			g_szPgNm = "mbbnk62030_t2"
		elseif sParam = "2" then 	'예적금
			g_szOpnC = "2"
			Label1.visible = false
			g_szPgNm = "mbbnk62030_t3"
		else 					'수익증권
			g_szOpnC = "6"
			Label1.visible = false
			g_szPgNm = "mbbnk62030_t4"
		end if
	end if
	
	g_szTotAmt = 0
	g_szNo = 0
			
	SetTr()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)


	if szTranID == "obtss_opnf_008r" then
		
		g_szNextYn = DATAMANAGER.IsMoreNextData( szTranID )
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
		
		if nCount = 0 then 
			Form.MsgBox("알림", "등록된 계좌가 없습니다", 0)	
		else
			g_szCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
			
			'20240611 SWJ START
			Pannel0.rowcount = Cint(g_szCount)
			'20240611 SWJ END
			
			for i = 0 to g_szCount - 1
				szAcnm = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_NAME" , i) & " " & DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_ACNO" , i) 
			
				Grid.SetCellData("bd2_prnm", g_szi, szAcnm)
				
				'20240611 SWJ START
'				Grid.setmaintainingratio("bd_arrow", g_szi, "1")
'				Grid.setmaintainingratio("bd_refresh", g_szi, "1")
'				Grid.setmaintainingratio("bd_copy", g_szi, "5")
'				Grid.SetCellData("bd_cell41", g_szi, "상세")
				
				sLenBankName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_NAME" , i)
				sLenACNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_ACNO" , i)
				
				szPRNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PRNM" , i)
				
				Pannel0.setPropCardCell("maxlinecnt", "LblPRNM" ,g_szi, "1^-1")
				Pannel0.setPropCardCell("caption", "LblPRNM" ,g_szi, szAcnm)
				
				Pannel0.setPropCardCell("maxlinecnt", "LblPRNM0" ,g_szi, 1^-4)
				Pannel0.setPropCardCell("caption", "LblPRNM0" ,g_szi, szPRNM)
				
				nAOSWidth = Form.getTextWidth(szAcnm, 0, false, false)
				niOSWidth1 = Form.getTextWidth(sLenBankName, 0, false, false)
				niOSWidth2 = Form.getTextWidth(sLenACNO, 0, false, false)
				
				niOSWidth = Cint(niOSWidth1) + Cint(niOSWidth2)
				
				'Form.ShowAlert(nAOSWidth, niOSWidth)
				
				Pannel0.setPropCardCell("maintainratio","ImgCopy", g_szi, "1")
				Pannel0.setPropCardCell("imgpath","ImgCopy", g_szi, "icon_copy_gray")
				
				Pannel0.setPropCardCell("maintainratio","ImgDetail", g_szi, "1")
				Pannel0.setPropCardCell("imgpath","ImgDetail", g_szi, "icon_arrow")
				
				Pannel0.setPropCardCell("maintainratio","ImgRefresh", g_szi, "1")
				Pannel0.setPropCardCell("imgpath","ImgRefresh", g_szi, "icon_refresh_left")

				'앱을 못나가니까 일단 이렇게..
				'iOS 앱 향후 확인 필요
				if g_sOSType == "2" then
					
					if Cint(niOSWidth) > 150 and Cint(niOSWidth) < 160 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(niOSWidth) + 18 )
					
					elseif Cint(niOSWidth) >= 160 and Cint(niOSWidth) < 170 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(niOSWidth) + 16 )
					
					elseif Cint(niOSWidth) >= 170 and Cint(niOSWidth) < 180 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(niOSWidth) + 14 )
					
					elseif Cint(niOSWidth) >= 180 and Cint(niOSWidth) < 190 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(niOSWidth) + 13 )
					
					elseif Cint(niOSWidth) >= 190 and Cint(niOSWidth) < 200 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(niOSWidth) + 9 )
					
					elseif Cint(niOSWidth) >= 200 and Cint(niOSWidth) < 210 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(niOSWidth) )
					
					elseif Cint(niOSWidth) <= 150 then
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi , Cint(niOSWidth) + 19 )
					else
						Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi , Cint(niOSWidth) - 3 )
					end if
					
				else
					Pannel0.setPropCardCell("left", "ImgCopy" ,g_szi ,Cint(nAOSWidth) + 17)
				end if
				'20240611 SWJ END
				
				g_szi = g_szi + 1
			next
			
			ApiTlmsClcd 	= DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "API_TLMS_CLCD", 0)
			OpnOtsdTrNo	= DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "OPN_OTSD_TR_UNIQ_NO", 0)
			RpttCsnu 	= 1
			
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "TR_DATE"   			 , 0 , TrDate)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "API_TLMS_CLCD"  		 , 0 , ApiTlmsClcd)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "OPN_OTSD_TR_UNIQ_NO"	 , 0 , OpnOtsdTrNo)
			'DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "RPTT_CSNU"			 , 0 , RpttCsnu)
			
			DATAMANAGER.RequestTranData("obtss_opnf_034r")
		end if
	elseif szTranID == "obtss_opnf_034r" then  
		
		LdgrBal	= DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", 	"OutBlock1", "LDGR_BAL"		, 0)	 '잔액
		OpngDate	= DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", 	"OutBlock1", "ACNT_OPNG_DATE"	, 0)	 '계좌개설일자
		MtrtDate	= DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", 	"OutBlock1", "MTRT_DATE"		, 0)	 '만기일
		LastTrDate = DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", "OutBlock1", "LAST_TR_DATE"		, 0)	 '최종입출금일

	     If g_SetRmndAmt == "N" Then 'v001
		    Grid.SetCellData("bd3_cell1", g_szNo, 0)
		    Grid.SetCellData("bd_cell25", g_szNo, OpngDate)
		    Grid.SetCellData("bd_cell29", g_szNo, MtrtDate)
		    Grid.SetCellData("bd_cell33", g_szNo, LastTrDate)
		Else		
		    Grid.SetCellData("bd3_cell1", g_szNo, LdgrBal)
		    Grid.SetCellData("bd_cell25", g_szNo, OpngDate)
		    Grid.SetCellData("bd_cell29", g_szNo, MtrtDate)
		    Grid.SetCellData("bd_cell33", g_szNo, LastTrDate)		
	     End If	
		
		'20240611 SWJ START		
		Pannel0.setPropCardCell("maxlinecnt", "LblCost" ,g_szNo, 1^-3)
		Pannel0.setPropCardCell("caption", "LblCost" ,g_szNo, LdgrBal)
		'20240611 SWJ END
						
		if g_szCount <> g_szj then		
			OpnOtsdTrNo = DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "OPN_OTSD_TR_UNIQ_NO", g_szj)
			
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "TR_DATE"   			 , 0 , TrDate)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "API_TLMS_CLCD"  		 , 0 , ApiTlmsClcd)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "OPN_OTSD_TR_UNIQ_NO"	 , 0 , OpnOtsdTrNo)
			'DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "RPTT_CSNU"			 , 0 , RpttCsnu)
						
			DATAMANAGER.RequestTranData("obtss_opnf_034r")
			'g_szTotAmt = LdgrBal + g_szTotAmt
			
			g_szj = g_szj + 1
			g_szNo = g_szNo + 1
		else
			g_szNo = g_szNo + 1
			g_szj = 1
			'lblTotAmt.caption = g_szTotAmt
			'LdgrBal = 0
			
		end if
			
		'총 잔액 합산
		If g_SetRmndAmt == "N" Then 'v001
		    lblTotAmt.caption = 0
		Else
		    g_szTotAmt = LdgrBal + g_szTotAmt
		    lblTotAmt.caption = g_szTotAmt	
		End If

		
	elseif szTranID == "obtss_opnf_007r" then
	
	     If g_SetRmndAmt == "N" Then 'v001
	         Exit Sub
	     End If	
	
		LdgrBal	= DATAMANAGER.GetDataValue(0,"obtss_opnf_007r", 	"OutBlock1", "LDGR_BAL" , 0)	 '잔액
		
		Grid.SetCellData("bd3_cell1", g_szx, LdgrBal)
		
		'20240611 SWJ START		
		Pannel0.setPropCardCell("maxlinecnt", "LblCost" ,g_szx, 1^-3)
		Pannel0.setPropCardCell("caption", "LblCost" ,g_szx, LdgrBal)
		'20240611 SWJ END
		
		lblTotAmt.caption = lblTotAmt.caption + LdgrBal - LdgrBal_rf
		
	end if	
	
End Sub


'============================================================================
Sub Grid_OnClickUp(lRow, szCellID)
	
	'20240611 SWJ START : cellID 변경 및 추가 (bd_cell40 -> bd_refresh)
	if szCellID = "bd_refresh" then
	     
		g_szx 	  = lRow
		Acno       = Grid.getCellData("bd_cell5" , lRow)
		AcCd       = Grid.getCellData("bd_cell21", lRow)
		
		if LdgrBal_rf ~= "" then
			LdgrBal_rf = Grid.getCellData("bd3_cell1", lRow)
		else 
			LdgrBal_rf = 0
		end if
		
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "ELFN_ID" , 0 ,  g_szID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "BANK_CODE" , 0 ,  AcCd )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "BANK_ACNO" , 0 ,  Acno )
		
		DATAMANAGER.RequestTranData("obtss_opnf_007r")
	
	elseif szCellID = "bd_copy" then
		
		sAcno       = Grid.getCellData("bd_cell5" , lRow)
		
		Form.setClipboardText(sAcno)  '클립보드에 복사
		
		if g_sOSType == "2" then
			Form.Toast(0, "클립보드에 복사되었어요.", 0.2)
		end if
		
	'20240611 SWJ END
	else
		'전달 항목
		'1.계좌번호 2.계좌별명 3.계좌개설일 4.만기일 5.최종입출금일 6.출금계좌동의 7.금융기관명 8.뱅킹코드
		Dim Acno
		Dim AcAlas
		Dim AcOpenD
		Dim AcCloD
		Dim AcCurrTrD
		Dim AcAgr
		Dim AcNm
		Dim AcCd
		
		Acno       = Grid.getCellData("bd_cell5" , lRow)
		AcAlas	  = Grid.getCellData("bd_cell9" , lRow)
		AcOpenD	  = Grid.getCellData("bd_cell25", lRow)
		AcCloD	  = Grid.getCellData("bd_cell29", lRow)
		AcCurrTrD  = Grid.getCellData("bd_cell33", lRow)
		AcAgr	  = Grid.getCellData("bd_cell13", lRow)
		AcNm       = Grid.getCellData("bd_cell17", lRow)
		AcCd       = Grid.getCellData("bd_cell21", lRow)
		
		Form.OpenPopup( "mbbnk62030_p1" , Acno & "★" & AcAlas & "★" & AcOpenD & "★" & AcCloD & "★" & AcCurrTrD & "★" & AcAgr & "★" & g_szPgNm & "★" & AcNm & "★" & AcCd)
	end if
	
End Sub


'============================================================================
Sub Form_OnFormInitBefore()

	Dim szData
	szData = Form.GetOpenLinkData()
	g_szList = Split(szData, "★")

	if UBOUND(g_szList) < 1 THEN
		EXIT SUB
	END IF

	EdtAc.caption = g_szList(0)
	EdtAcAl.caption = g_szList(1)
	EdtAcOpenD.caption = g_szList(2)
	EdtCloD.caption = g_szList(3)
	EdtCurrTrD.caption = g_szList(4)
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	Dim SubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if SubMsg = "" then
		Form.MsgBox("알림", szErrMsg, 0)	
	else
		Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
	end if
	
	if szTranID == "obtss_opnf_034r" then  
		
		if g_szCount <> g_szj then		
			OpnOtsdTrNo = DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "OPN_OTSD_TR_UNIQ_NO", g_szj)
			
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "TR_DATE"   			 , 0 , TrDate)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "API_TLMS_CLCD"  		 , 0 , ApiTlmsClcd)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "OPN_OTSD_TR_UNIQ_NO"	 , 0 , OpnOtsdTrNo)
						
			DATAMANAGER.RequestTranData("obtss_opnf_034r")
			
			g_szj = g_szj + 1
			g_szNo = g_szNo + 1
		end if
	end if	
	
End Sub




'============================================================================
'20240611 SWJ START
'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	if sCellID == "ImgCopy" or sCellID == "LblPRNM" then
		
		sAcno       = Grid.getCellData("bd_cell5" , lRow)
		
		Form.setClipboardText(sAcno)  '클립보드에 복사
		
		if g_sOSType == "2" then
			Form.Toast(0, "클립보드에 복사되었어요.", 0.2)
		end if
		
	elseif sCellID == "ImgRefresh" then
		g_szx 	  = lRow
		Acno       = Grid.getCellData("bd_cell5" , lRow)
		AcCd       = Grid.getCellData("bd_cell21", lRow)
		
		if LdgrBal_rf ~= "" then
			LdgrBal_rf = Grid.getCellData("bd3_cell1", lRow)
		else 
			LdgrBal_rf = 0
		end if
		
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "ELFN_ID" , 0 ,  g_szID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "BANK_CODE" , 0 ,  AcCd )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_007r", "InBlock1", "BANK_ACNO" , 0 ,  Acno )
		
		DATAMANAGER.RequestTranData("obtss_opnf_007r")
	else
		'전달 항목
		'1.계좌번호 2.계좌별명 3.계좌개설일 4.만기일 5.최종입출금일 6.출금계좌동의 7.금융기관명 8.뱅킹코드
		Dim Acno
		Dim AcAlas
		Dim AcOpenD
		Dim AcCloD
		Dim AcCurrTrD
		Dim AcAgr
		Dim AcNm
		Dim AcCd
		
		Acno       = Grid.getCellData("bd_cell5" , lRow)
		AcAlas	  = Grid.getCellData("bd_cell9" , lRow)
		AcOpenD	  = Grid.getCellData("bd_cell25", lRow)
		AcCloD	  = Grid.getCellData("bd_cell29", lRow)
		AcCurrTrD  = Grid.getCellData("bd_cell33", lRow)
		AcAgr	  = Grid.getCellData("bd_cell13", lRow)
		AcNm       = Grid.getCellData("bd_cell17", lRow)
		AcCd       = Grid.getCellData("bd_cell21", lRow)
		
		Form.OpenPopup( "mbbnk62030_p1" , Acno & "★" & AcAlas & "★" & AcOpenD & "★" & AcCloD & "★" & AcCurrTrD & "★" & AcAgr & "★" & g_szPgNm & "★" & AcNm & "★" & AcCd)
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtss_opnf_008r" trcode="obtss_opnf_008r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_034r" trcode="obtss_opnf_034r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_007r" trcode="obtss_opnf_007r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
