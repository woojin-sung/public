'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	grdDepositDS.SetCellData( "bd_cell0", 0, "해외결제일자" )
	grdDepositDS.SetCellData( "bd_cell6", 0, "외화예수금" )
	grdDepositDS.SetCellData( "bd_cell12", 0, "해외정산금" )
	grdDepositDS.SetCellData( "bd_cell18", 0, "해외매수정산금" )
	grdDepositDS.SetCellData( "bd_cell24", 0, "해외매도정산금" )
	
	'DATAMANAGER.RequestTranData( "obtro_oder_208r" )
	DATAMANAGER.RequestTranData( "obtro_oder_266r" )
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtro_oder_208r" or szTranID == "obacb_balc_138r" or szTranID == "obtro_oder_266r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")									'계좌비밀번호
	End If	
	If szTranID == "obacb_balc_138r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")									'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CRCD" , 0 ,  cmbCurCode.cbkeydata )					'통화코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , "" )					'해외주식시장거래구분코드
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'If szTranID == "obtro_oder_208r" Then
	If szTranID == "obtro_oder_266r" Then
		DATAMANAGER.RequestTranData( "obacb_balc_138r" )
	End If
End Sub

'============================================================================
' grdDeposit_OnScrollEnd() : NextData 조회
'============================================================================
Sub grdDeposit_OnScrollEnd()
	'If DATAMANAGER.IsMoreNextData( "obtro_oder_208r" ) == True Then
	If DATAMANAGER.IsMoreNextData( "obtro_oder_266r" ) == True Then
		DATAMANAGER.RequestNextData( "obtro_oder_266r" )
	End If
End Sub
'============================================================================
' acnt0_ChangeAccount() : 계좌변경
'============================================================================
Sub acnt0_ChangeAccount()
	DATAMANAGER.RequestTranData( "obacb_balc_138r" )
	'DATAMANAGER.RequestTranData( "obtro_oder_208r" )
	DATAMANAGER.RequestTranData( "obtro_oder_266r" )
End Sub
'============================================================================
' cmbCurCode_OnEditComplete() : 통화변경
'============================================================================
Sub cmbCurCode_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData( "obacb_balc_138r" )
End Sub
'============================================================================
' btnSearch_OnClick() : 재조회
'============================================================================
Sub btnSearch_OnClick()
	'DATAMANAGER.RequestTranData( "obtro_oder_208r" )
	DATAMANAGER.RequestTranData( "obtro_oder_266r" )
End Sub

