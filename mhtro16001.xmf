	<SCRIPT_INFO _len="12624" _ulen="11842" >
 '===========================================================================
' 01. 업무구분 : 해외주식 체결추이
' 02. 화면 : 
' 03. 화면설명 : 
' 04. 작성자 : 이명구
' 05. 작성일 : 2021.02.15
' 06. 수정이력 :
'===========================================================================
'[[ 전역변수 ]]
Dim g_sCode
Dim g_rtChk
Dim g_tKey_Flag '시간별 NextKey 구분
Dim g_dKey_Flag '일별 NextKey 구분
g_tKey_Flag = false
g_dKey_Flag = false
Dim g_szScreenNo
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if "&ITEM_CODE" == sKey then		
		g_sCode = sValue
		Tab0_OnTabChanged()
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()

	'-----------------------------------------------------------------------------
	'20240626 LES START - 상단 돋보기버튼 눌렀을때, 메인쪽에서 "TITLE_CLICK" 으로 내려줄수 있도록
	'-----------------------------------------------------------------------------
	Form.setSearchTypeClick("1")
	
	
	Dim sItemCode
	sItemCode = Form.GetOpenLinkData()
	g_sCode = sItemCode
	
	Grid0.SetVisibleCol( 4, false )
	Grid0.SetVisibleCol( 1, false)
	Grid1.SetVisibleCol( 3, false )
	
	Tab0_OnTabChanged()
	
	g_szScreenNo = Form.GetSharedData("&SCREEN_NO", false )
	if g_szScreenNo == "16000" then
		Grid0.height = 565
		Grid1.height = 565
	elseif  g_szScreenNo == "16001" then
		Grid0.height = 525
		Grid1.height = 525
	end if

	
	Form.SetInterestTitle("N")		'비활성화로 기본 세팅 20230722 HSZ
	
	'20240626 LES START
	Form.requestIntrItemList("00")
	'20240626 LES END
	
	
End Sub


'[[ DATAMANAGER 조회 BEFORE ]]
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Dim sExid, sCode, sTemp

	sTemp = split(g_sCode, "@")
	sExid = sTemp[0] '시장구분
	sCode = sTemp[1] '종목코드 
	g_rtChk = Form.GetSharedData( "REALTIME_"..sExid, false )
	
	DATAMANAGER.CancelRealData( "ohhts_exst_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_exst_cnta" ) '20220404 HSZ 애프터마켓 실시간체결 추가
	DATAMANAGER.CancelRealData( "ohhts_exst_cntd" ) '20221213_01 KBC 해외주식주간거래
	
	if szTranID == "ohhts_6000_003r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) '시장분류 
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode ) '종목코드
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sExid) '시장구분'
		DATAMANAGER.SetDataValue( false, "ohhts_6000_003r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk) '실시간 구분 코드
		
	elseif szTranID == "ohhts_6000_005r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6000_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_005r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_005r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sExid)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_005r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk) '실시간 구분 코드
	end if
end Sub

'[[ DATAMANAGER 조회 Complete ]]
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	Dim nRowCnt, szDate, nCount, i
	
	if szTranID == "ohhts_6000_003r" then
		if tonumber(Grid0.rowcount) > g_nMaxCount then
			Grid0.rowcount = g_nMaxCount
		end if
	elseif szTranID == "ohhts_6000_005r" then
		nCount = DATAMANAGER.GetDataCount(false, "ohhts_6000_005r", "OutBlock1")
		nRowCnt = Grid1.rowcount
		if g_dKey_Flag == true then 
			for i = nRowCnt - nCount to nRowCnt - 1
				'날짜 형식 변환 - 20150101 => 15/01/01
				szDate = Grid1.GetCellData( "bd_cell0", i ) 
				szDate = Right(szDate, 6)
				Grid1.SetCellData( "bd_cell0", i, Left(szDate, 2) .."/".. Mid(szDate,3, 2) .."/".. Right(szDate, 2) )
			next
		else 'NextKey가 False 일 경우
			for i = 0 to nCount - 1
				'날짜 형식 변환 - 20150101 => 15/01/01
				szDate = Grid1.GetCellData( "bd_cell0", i ) 
				szDate = Right(szDate, 6)
				Grid1.SetCellData( "bd_cell0", i, Left(szDate, 2) .."/".. Mid(szDate,3, 2) .."/".. Right(szDate, 2) )
			next
		end if
		
		if tonumber(Grid1.rowcount) > g_nMaxCount then
			Grid1.rowcount = g_nMaxCount
		end if
	end if
	
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	
	'20220404 HSZ START : 애프터마켓 실시간체결 추가
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cnta" )
	'20220404 HSZ END

	'20221213_01 KBC 해외주식주간거래
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
	
end Sub



'[[ 폼탭 변경시 ]]
'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)	
	nCurrentTab = CInt(Tab0.currenttab)
	if nCurrentTab == 0 then 
		Grid0.left = 0
		Grid1.left = 500
'		Grid0.visible = true
'		Grid1.visible = false
	else
		Grid0.left = 500
		Grid1.left = 0
'		Grid0.visible = false
'		Grid1.visible = true
	end if
	RequestData()
End Sub

'[[ 그리드 시간별 헤더 클릭 ]]
'============================================================================
Sub Grid0_OnHeaderClickUp(lRow, szCellID)
	if (szCellID == "th_cell0") then	
		Grid0.SetVisibleCol( 1, true )
		Grid0.SetVisibleCol( 0, false )
	elseif (szCellID == "th_cell1") then
		Grid0.SetVisibleCol( 0, true )
		Grid0.SetVisibleCol( 1, false )
	elseif (szCellID == "th_cell3")	then
		Grid0.SetVisibleCol( 3, false )
		Grid0.SetVisibleCol( 4, true )
	elseif (szCellID == "th_cell4")	then
		Grid0.SetVisibleCol( 3, true )
		Grid0.SetVisibleCol( 4, false )
	end if
end Sub

'[[ 시간별 스크롤 마지막 이벤트 ]]
'============================================================================
Sub Grid0_OnScrollEnd()
	if tonumber(Grid0.rowcount) < g_nMaxCount then
		g_tKey_Flag = DATAMANAGER.IsMoreNextData( "ohhts_6000_003r" )
		if g_tKey_Flag == "1" or g_tKey_Flag == true	then
			DATAMANAGER.RequestNextData( "ohhts_6000_003r" )
		end if
	end if
End Sub


'[[ 그리드 일별 헤더 클릭 ]]
'============================================================================
Sub Grid1_OnHeaderClickUp(lRow, szCellID)
	if (szCellID == "th_cell2") then
		Grid1.SetVisibleCol( 2, false )
		Grid1.SetVisibleCol( 3, true )
	elseif (szCellID == "th_cell3") then
		Grid1.SetVisibleCol( 2, true )
		Grid1.SetVisibleCol( 3, false )
	end if
end Sub

'[[ 일별 스크롤 마지막 이벤트 ]]
'============================================================================
Sub Grid1_OnScrollEnd( )
	if tonumber(Grid1.rowcount) < g_nMaxCount then
		g_dKey_Flag = DATAMANAGER.IsMoreNextData( "ohhts_6000_005r" )
		if g_dKey_Flag == "1" or g_dKey_Flag == true	then
			DATAMANAGER.RequestNextData( "ohhts_6000_005r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	'20220404 HSZ 애프터마켓 실시간체결 추가
	if szTranID == "ohhts_exst_cntg" or szTranID == "ohhts_exst_cnta" then '일자별 그리드 처리
		szDate = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDXR_KOREA_DATE" , 0 )
		szDate = Right(szDate, 6)
		Grid1.SetCellData( "bd_cell0", i, Left(szDate, 2) .."/".. Mid(szDate,3, 2) .."/".. Right(szDate, 2) )
	end if
End Sub


'============================================================================
Function RequestData()
	if g_sCode == "" then 
		g_sCode =  "OQ@AAPL" 
	end if
	
	f_FormStart(g_sCode)
end Function



'화면 클리어
'============================================================================
Function f_FormClear()
	g_nMaxCount = 300
	DATAMANAGER.ClearInputData( false, "ohhts_6000_003r" )
	DATAMANAGER.ClearOutputData( false, "ohhts_6000_003r" )
	DATAMANAGER.ClearInputData( false, "ohhts_6000_005r" )
	DATAMANAGER.ClearOutputData( false, "ohhts_6000_005r" )
	
	DATAMANAGER.CancelRealData( "ohhts_exst_cntg" )
	DATAMANAGER.ClearInputData( 1, "ohhts_exst_cntg" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_exst_cntg" )
	
	'20220404 HSZ START : 애프터마켓 실시간체결 추가
	DATAMANAGER.CancelRealData( "ohhts_exst_cnta" )
	DATAMANAGER.ClearInputData( 1, "ohhts_exst_cnta" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_exst_cnta" )
	'20220404 HSZ END
	
	'20221213_01 KBC 해외주식주간거래
	DATAMANAGER.CancelRealData( "ohhts_exst_cntd" )
	DATAMANAGER.ClearInputData( 1, "ohhts_exst_cntd" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_exst_cntd" )
	
	Grid0.SetClear()
end Function

'============================================================================
'화면 시작
'============================================================================
Function f_FormStart(szItemCode)
	if szItemCode <> "" then
		f_FormClear() '화면 클리어
		
		g_sCode = szItemCode		
		DATAMANAGER.RequestTranData("ohhts_6000_003r")  '시간별
		DATAMANAGER.RequestTranData("ohhts_6000_005r") '일별
	end if
end Function

'============================================================================
Sub Form_OnRefresh()
	RequestData()
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH" then
		Form_OnRefresh()
	' 상반바 우측 관심추가 버튼 클릭 시 
	elseif "REG_INTR" == sEventName then
		
		'---------------------------------------------------------------
		'20240626 LES START - 관심종목 등록팝업 변경
		'---------------------------------------------------------------
		'Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code, "" )
				
		if ItemCode0.code <> "" then
			
			isIntrItem = Form.isIntrItemList(ItemCode0.code)
			
			if isIntrItem = true then
				Form.OpenPopup("mhprc11000_pe", ItemCode0.code & "★"& "DEL","", "")
			else
				Form.OpenPopupAnimation("mhprc11000_pd", ItemCode0.code & "★"& "ADD","", "2")	'종목등록
			end if	
			
		end if
		'---------------------------------------------------------------
		'20240626 LES END
		'---------------------------------------------------------------
	
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	elseif "TITLE_CLICK" == sEventName then
		Form.OpenCommonDialog("SEARCH", "19", "")
	'20220922 SWJ END
	
	
	'20240626 LES START	
	'---------------------------------------------------------------
	' requestIntr 함수 호출 후 조회 완료 시 발생
	' 관심종목 등록이미지로 변경 못할 경우를 대비하여 다시 칠해준다.
	'---------------------------------------------------------------
	elseif sEventName == "REFRESH_INTR_ITEM" then
	
		if ItemCode0.code <> "" then
		
			isIntrItem = Form.isIntrItemList(ItemCode0.code)
		
			if isIntrItem = true then
				Form.SetInterestTitle("Y")	
			else
				Form.SetInterestTitle("N")	
			end if
		
		else
			Form.SetInterestTitle("N")	
		end if
	'20240626 LES END
	
	end if
	
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	'sReturn1 = 거래소코드★종목코드
	'name = 종목명 
	name = Form.GetItemCodeInfo(sReturn1, "name")
	
	Form.setOverStockItemCode(sReturn1.."★"..name)
	ItemCode0.code = sReturn1.."★"..name
	
	'20240626 LES START
	if ItemCode0.code <> "" then
		
		isIntrItem = Form.isIntrItemList(ItemCode0.code)
		
		if isIntrItem = true then
			Form.SetInterestTitle("Y")	
		else
			Form.SetInterestTitle("N")	
		end if
		
	else
		Form.SetInterestTitle("N")	
	end if
	'20240626 LES END
	
End Sub

'============================================================================
' 20240626 LES START 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "mhprc11000_save" then '관심등록 완료 후
	
		arrRet = split(sRet, "★")
		
		if arrRet(2) = "DEL" then
			Form.delIntrItemList(ItemCode0.code)
			Form.SetInterestTitle("N")	
		else
			Form.addIntrItemList(ItemCode0.code)
			Form.SetInterestTitle("Y")	
		end if
	
	end if
	
End Sub

