' 2020.09.25 : 정민영 : v0002 : [T2008250015] 메모리취약점 보완
'            ; 현재비밀번호 컨트롤속성 '일반비밀번호'->'계좌/거래비밀번호사용'으로 변경
' 2020.10.27 : 권오상 : v003 : T2008250015 : 실명확인번호 암호화 처리'
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szJuminNum		'실명확인번호
Dim g_bNewPW			'비밀번호 사용 가능 여부
Dim g_plain_rm  		'v0002 메모리평문적용여부
Dim g_HomeNo  		     'v0002 자택전화번호
Dim g_ClphNo			'v0002 휴대전화번호
Dim g_WorkNo			'v0002 직장전화번호
Dim g_RcnoPip			'v003 실명확인번호 암호화

Dim g_ATMT_ISNC_YN
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Pw_Check(szPW) : 비밀번호 조건 체크
'============================================================================
Function Pw_Check(szPW)
	
	if edtNewPW.caption <> edtNewPWChk.caption then
		Form.MsgBox("알림", "신규비밀번호와 비밀번호확인이 일치하지 않습니다.", 0, 6)
		edtNewPW.caption = ""
		edtNewPWChk.caption = ""
		Exit Function
	end if
	
	Str_Chk(edtNewPWChk.caption)
	
	if g_bNewPW == False then		'영문+숫자+특수문자 혼합 필수 , 8~12자리 
		Form.MsgBox("알림", "비밀번호가 영문+숫자+특수문자 조합이 아니거나 자릿수 8~12 자리가 아닙니다.", 0, 6)
		edtNewPW.caption = ""
		edtNewPWChk.caption = ""
		Exit Function
	end if

	if edtNewPW.caption == edtNowPW.caption then
		Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(기존 비밀번호와 동일)", 0, 6)
		edtNewPW.caption = ""
		edtNewPWChk.caption = ""
		Exit Function
	end if

	for i = 1 to Len(edtNewPWChk.caption) - 3		'주민등록번호와 비교
		Dim szEdit, szJoomin
		szEdit = mid( edtNewPWChk.caption , i , 4)
		for j = 1 to Len( g_szJuminNum ) - 3
			szJoomin = mid( g_szJuminNum , j , 4 )
			if szEdit == szJoomin then
				Form.MsgBox( "알림" , "유효하지 않은 비밀번호입니다.", 0, 6 )
				edtNewPW.caption = ""
				edtNewPWChk.caption = ""
				Exit Function
			end if
		next
	next
		
	for i = 1 to Len(edtNewPWChk.caption) - 3 ' 연속된 3자리 숫자, 동일 숫자
		if Asc(mid( edtNewPWChk.caption, i, 1 )) = Asc(mid(edtNewPWChk.caption,i+1,1)) + 1 and Asc(mid(edtNewPWChk.caption,i+1,1)) = Asc(mid(edtNewPWChk.caption,i+2,1)) + 1 then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			edtNewPW.caption = ""
			edtNewPWChk.caption = ""
			Exit Function
		elseif Asc(mid(edtNewPWChk.caption,i,1)) = Asc(mid(edtNewPWChk.caption,i+1,1)) - 1 and Asc(mid(edtNewPWChk.caption,i+1,1)) = Asc(mid(edtNewPWChk.caption,i+2,1)) - 1 then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			edtNewPW.caption = ""
			edtNewPWChk.caption = ""
			Exit Function
		elseif Asc(mid(edtNewPWChk.caption,i,1)) = Asc(mid(edtNewPWChk.caption,i+1,1)) and Asc(mid(edtNewPWChk.caption,i+1,1)) = Asc(mid(edtNewPWChk.caption,i+2,1)) then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			edtNewPW.caption = ""
			edtNewPWChk.caption = ""
			Exit Function
		end if
	next

'	if Len(cmbAcnt.caption) > 4 then
'		for i = 1 to Len(edtNewPWChk.caption) - 3		'계좌번호와 비교
'			Dim szAcnt
'			szEdit = mid(edtNewPWChk.caption,i,4)
'			for j = 1 to Len(cmbAcnt.caption) - 3
'				szAcnt = mid(cmbAcnt.caption,j,4)
'				if szEdit == szAcnt then
'					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(계좌번호와 4자리 이상 일치)", 0, 6)
'					edtNewPW.caption = ""
'					edtNewPWChk.caption = ""
'					Exit Function
'				end if
'			next
'		next
'	end if
'	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'휴대폰번호와 비교
			Dim szPhone
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) - 3
				szPhone = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0),j,4)
				if szEdit == szPhone then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(휴대폰번호와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'자택번호와 비교
			Dim szHome
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) - 3
				szHome = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0),j,4)
				if szEdit == szHome then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(자택번호와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'직장번호와 비교
			Dim szWorkTel
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) - 3
				szWorkTel = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0),j,4)
				if szEdit == szWorkTel then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(직장번호와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(Form.GetSharedData("&USER_ID", false )) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'로그인 아이디와 비교
			Dim szEdit, szLoginID
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(Form.GetSharedData("&USER_ID", false )) - 3
				szLoginID = mid((Form.GetSharedData("&USER_ID", false )),j,4)
				if szEdit == szLoginID then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인ID와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
'	if Len(Form.GetSharedData("&USER_PWD", false )) > 4 then

	'16-04-13 YCJ 고기화사원 요청 ID비밀번호 변경시 기존 ID와만 다르면 상관없음, 4자리 이상 동일 여부 판단 불필요 요청
'	if Len(edtNowPW.caption) > 4 then
'		for i = 1 to Len(edtNewPWChk.caption) - 3		'로그인 비밀번호와 비교
'			Dim szEdit, szLoginPW
'			szEdit = mid(edtNewPWChk.caption,i,4)
'				for j = 1 to Len(edtNowPW.caption) - 3
'				szLoginPW = mid((edtNowPW.caption),j,4)
''				for j = 1 to Len(Form.GetSharedData("&USER_PWD", false )) - 3
''				szJoomin = mid((Form.GetSharedData("&USER_PWD", false )),j,4)
'				if szEdit == szLoginPW then
'					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인 비밀번호와 4자리 이상 일치)", 0, 6)
'					edtNewPW.caption = ""
'					edtNewPWChk.caption = ""
'					Exit Function
'				end if
'			next
'		next
'	end if
	
	DATAMANAGER.RequestTranData("obcsb_efif_162r")
	
End Function
'============================================================================
' Str_Chk(str) : 입력 비밀번호 유효성 체크
'============================================================================

'한글 입력, 기럭지 체크
'리턴 : 영+숫, 기럭지 8 ~ 12 = True
'       한글, 기럭지 꽝 	= False
Function Str_Chk(str)	
	dim i						'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크 '20150309_01 KBC
    
	chk_n = 0
	chk_c = 0
	chk_t = 0
    
    if Len(str) < 8 or 12 < Len(str) then
		g_bNewPW = False
		exit Function
	end if
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
	    
	    if nAscii < 0 then			'한글 일때
		    g_bNewPW = False
		    exit Function			'한글 기럭지 2
		else						'영, 숫, 특 일때    '20130125 lkm 영문+숫자 혼합 규칙 → 영문+숫자(필수), 특수문자(선택) 가능 으로 변경 
		    '48~57 : 0~9
		    '65~90 : A~Z
		    '97~122: a~z
		    '
		    If nAscii >=48 and nAscii <=57 Then 
			    chk_n = 1 	
			Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
			    chk_c = 1 
		    '20150309_01 KBC START
		    '특수문자 확인 부분
		    Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
			    chk_t = 1 
		    '20150309_01 KBC END
		    End if 		    
		end if
	Next
    
	If ((chk_n + chk_c + chk_t) < 3) Then  '20150309_01 KBC
		g_bNewPW = False
		exit Function
	End if
	
	g_bNewPW = True
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	edtNowPW.certname = "ID비밀번호 입력"
	edtNewPW.certname = "ID비밀번호 입력"
	edtNewPWChk.certname = "ID비밀번호 입력"
	
	tbl1.SetCellString( 0, 1, Form.GetSharedData("&USER_ID", false ))
	
	edtNewPW.enable = False
	edtNewPWChk.enable = False

	DATAMANAGER.RequestTranData("obcsb_efif_000r")
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'v0002 Defualt-주민번호용Aria키값 변경에 따른 API호출 삭제 
	'if g_plain_rm == "1" then
	'	'주민번호용 Aria키값으로 암호화하도록 설정(SetAriaNoBank())(Defualt-이체용Aria키값(SetAriaBank()))
	'     edtNowPW.SetAriaNoBank()
	'     edtNewPW.SetAriaNoBank()
	'     edtNewPWChk.SetAriaNoBank()
	'end if
End Sub
'============================================================================
' edtNowPW_OnEditComplete() : 비밀번호 입력시 변경 비밀번호창 활성화
'============================================================================
Sub edtNowPW_OnEditComplete()
	'16-03-23 영업지원팀 박정숙 사원이 전요셉 과장님과 협의하여 8자리 이상 아니여도 입력가능하게 요청
	if Len(edtNowPW.caption) > 0 then'Len(edtNowPW.caption) >= 8 and Len(edtNowPW.caption) <= 12 then
		edtNewPW.enable = True
		edtNewPWChk.enable = True
	else
		edtNewPW.enable = False
		edtNewPWChk.enable = False
	end if
	
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_162r", "InBlock1", "ELFN_ID" , 0 , tbl1.GetCellString( 0, 1))
	'v0002
	If g_plain_rm == "1" Then	'MTS메모리평문 적용상태일때
	    DATAMANAGER.SetDataValue( 0, "obcsb_efif_162r", "InBlock1", "CONN_PWD" , 0 , edtNowPW.caption)
	Else  'MTS메모리평문 미적용상태일때
	    DATAMANAGER.SetDataValue( 0, "obcsb_efif_162r", "InBlock1", "CONN_PWD" , 0 , Form.GetEncData(edtNowPW.caption))
	End If
	
'	DATAMANAGER.RequestTranData("obcsb_efif_162r")
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	
	if g_ATMT_ISNC_YN == "Y" then
		Form.OpenPopup("mhetc90020_pj", "", "")
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData("obacp_comm_004r")
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obcsb_efif_200a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_efif_200a" )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , 0, 6)
	elseif szTranID == "obcsb_efif_162r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_efif_162r" )
		edtNowPW.caption = ""
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , 0, 6)
	elseif szTranID == "obacp_comm_058r" then  'v0002
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_comm_058r" )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , 0, 6)		
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obacp_comm_004r" then
		DATAMANAGER.SetDataValue( 0 , "obacp_comm_004r", "InBlock1", "ELFN_ID" , 0 , tbl1.GetCellString( 0, 1))
		
     'v0002 비밀번호 유효성 검증체크
	ElseIf szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "2" )	 '2.[MTS] HTSID비밀번호 변경시 체크(mbonl85010)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , ""  )  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , tbl1.GetCellString( 0, 1) )  'ID
		'비밀번호복호화하여 비교해야하므로 ARIA변환값으로 매핑(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDBF_PWD_PIP", 0 , edtNowPW.caption2    )  '현재비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , edtNewPW.caption2    )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , edtNewPWChk.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""	         )  '실명확인번호(서비스에서조회)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
	
	elseif szTranID = "obcsb_efif_000r" then
		Dim RCNO_PIP
		RCNO_PIP	= Form.GetSharedData("&JUMIN_NUM", false)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE",	0, "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP",		0, RCNO_PIP)
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obacp_comm_004r" then
		g_szJuminNum = DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "RCNO" , 0) 'v003
		g_RcnoPip = DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "RCNO_PIP" , 0) 'v003
		'v0002
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
		If g_plain_rm == "1" then
			DATAMANAGER.RequestTranData("obacp_comm_058r")
		Else
			Call Pw_Check(edtNewPW)		'비밀번호 적합성 검사 이후 ID와 비밀번호 체크
		End If

     'v0002 비밀번호 유효성 검증체크
	ElseIf szTranID == "obacp_comm_058r" then
		DATAMANAGER.RequestTranData("obcsb_efif_162r")

	elseif szTranID == "obcsb_efif_162r" then
		'HTSID와 비밀번호가 체크하게 되면 변경 실시
		if DATAMANAGER.GetDataValue( 0 , "obcsb_efif_162r", "OutBlock1", "SUCS_YN" , 0) == "Y" then
		
			DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "ELFN_ID" , 0 , tbl1.GetCellString( 0, 1))
'			DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "RCNO" , 0 , g_szJuminNum ) 'v003
			DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "RCNO_PIP" , 0 , g_RcnoPip ) 'v003
			'v0002
			If g_plain_rm == "1" Then	'MTS메모리평문 적용상태일때
				DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "MDBF_PWD" , 0 , edtNowPW.caption    )
				DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "MDAF_PWD" , 0 , edtNewPWChk.caption )
			Else  'MTS메모리평문 미적용상태일때
				DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "MDBF_PWD" , 0 , Form.GetEncData(edtNowPW.caption))
				DATAMANAGER.SetDataValue( 0, "obcsb_efif_200a", "InBlock1", "MDAF_PWD" , 0 , Form.GetEncData(edtNewPWChk.caption))
			End If
			
			DATAMANAGER.RequestTranData("obcsb_efif_200a")
		
		elseif DATAMANAGER.GetDataValue( 0 , "obcsb_efif_162r", "OutBlock1", "SUCS_YN" , 0) == "N" then
			Dim szErr, szSubErr
			
			szErr = DATAMANAGER.GetDataMsgText( szTranID )
			szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.ShowAlert( "알림", szErr.."("..szSubErr..")" )
		end if
	elseif szTranID == "obcsb_efif_200a" then
		Form.ShowAlert( "알림" , "수정이 완료되었습니다.(HTS 비밀번호)")
		edtNowPW.caption = ""
		edtNewPW.caption = ""
		edtNewPWChk.caption = ""
		g_szJuminNum = "" 'v0001. 변수 초기화
	elseif szTranID == "obcsb_efif_000r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		
		if nCnt > 0 then
			
			for i = 0 to nCnt - 1
				Dim USER_ID, ELFN_ID
				USER_ID = Form.GetSharedData("&USER_ID", false)
				ELFN_ID = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ELFN_ID", 	i)
				
				if USER_ID == ELFN_ID then
				
					if "Y" == DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ATMT_ISNC_YN", i) then
						g_ATMT_ISNC_YN = "Y"
						tbl1.SetCellString(1, 1, "자동 발급된 ID입니다.")
					else
						tbl1.SetCellString(1, 1, "")
					end if
					
				end if

			next

		end if
		
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90020_pj" then
		Form.OpenNextPopup("mhetc90024", "", "")
	end if
	
End Sub

