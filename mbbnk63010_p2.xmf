--===========================================================================
--===========================================================================

Dim g_szCustNo '고객번호

'============================================================================
Sub Form_OnFormInit()
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N") '안드로이드 뒤로가기 동작 비활성화
	g_szCustNo = Form.GetSharedData("&CUST_NUM", false ) '고객번호
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'간편이체 동의 처리
	if szTranID == "obpds_srvc_185a" then
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0, "1"  ) '4:조회 1:처리
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "CSNO" , 0, g_szCustNo  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "SVCD" , 0, "058"  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "SVC_SRNO" , 0, ""  )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'간편이체 동의 처리
    if szTranID == "obpds_srvc_185a" then
        Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화
        Form.SendReturnToParent("SIMPLE_SUCCESS" , "Y")
        Form.CloseForm()
    end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'간편이체 동의 처리
	if szTranID == "obpds_srvc_185a" then
		Form.MsgBox("알림", "간편이체약정등록 오류", "", 6)

		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화
		Form.SendReturnToParent("SIMPLE_SUCCESS" , "N") '간편이체약정실패
		Form.CloseForm()
		
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
'    본 화면은 배경을 터치해도 화면이 꺼지지 않음
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	DATAMANAGER.RequestTranData("obpds_srvc_185a")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

