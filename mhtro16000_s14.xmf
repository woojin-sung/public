'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	contMain.setEnableScroll(false)

	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	
	contMain.lblExpand.paddinginfo = "0,0,0,0"
	contMain.lblExpand.fgcolor = g_szTxtColor_Grey
	
	contMain.lblTypeInfo.paddinginfo = "0,0,0,0"
	contMain.lblTypeInfo.fgcolor = g_szTxtColor_Grey
	
	contMain.lblEmpty.paddinginfo = "0,0,0,0"
	contMain.lblEmpty.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty.visible = false
	
	contMain.lblSortInfo.paddinginfo = "0,0,0,0"
	contMain.lblSortInfo.fgcolor = g_szTxtColor_Grey
	
	contMain.lblDiv0.bgcolor = g_szLineColor3
End Function

'==============================================
' 해외주식 현재가(프리/정규) 조회
'==============================================
Function Request_Tran_ohhts_6000_001r()
	
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_szExidCd )	'마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_szOnlyCd )	'종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	'실시간 여부
	
	DATAMANAGER.RequestTranData("ohhts_6000_001r")
End Function

Function Process_Tran_ohhts_6000_001r()
	g_szTypeCd = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_BSTP_CLS_CODE", 0) 
	szTypeNm = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_BSTP_MDDV_NAME", 0) 
	contMain.lblTypeInfo.caption = "업종 : " & szTypeNm
	
	Request_Tran_ohhts_6230_002r()
End Function

Function Request_Tran_ohhts_6230_001r()
	
	DATAMANAGER.ClearInputData(false, "ohhts_6230_001r")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_001r", "InBlock1", "FID_CLCD"	, 0 , "1")
	DATAMANAGER.RequestTranData("ohhts_6230_001r")
End Function

Function Process_Tran_ohhts_6230_001r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "ohhts_6230_001r", "OutBlock1")
	
	if nDataCnt == "" or Cint(nDataCnt) == 0 then
		
		Exit Function
	end if
	
	for i = 0 to nDataCnt-1
		szTypeCd = DATAMANAGER.GetDataValue(false,"ohhts_6230_001r", "OutBlock1", "FIDX_BSTP_CLS_CODE"  , i)
		szTypeNm = DATAMANAGER.GetDataValue(false,"ohhts_6230_001r", "OutBlock1", "FIDX_BSTP_DIV_NAME"  , i)
		
		if g_szType == szTypeCd then
			g_szTypeCd = szTypeCd
			Exit for
		end if
	next
	
	if g_szTypeCd == "" and DATAMANAGER.IsMoreNextData("ohhts_6230_001r") == true then
		
		DATAMANAGER.RequestNextData("ohhts_6230_001r")
	else
		if g_szTypeCd == "" then 
			Exit Function
		end if
	
		Request_Tran_ohhts_6230_002r()
	end if
End Function

Function Request_Tran_ohhts_6230_002r()
	contMain.Pannel0.rowcount = 0
	
	DATAMANAGER.ClearInputData(false, "ohhts_6230_002r")

	
	sNtns = ""
	szExidCd = ""
	If g_szExidCd = "NY" Or g_szExidCd = "AX" Or g_szExidCd = "OQ" Then 			'미국 각 시장
	    sNtns = "US"
	ElseIf g_szExidCd = "SH" Or g_szExidCd = "SZ" Then 								'상해, 심천
	    sNtns = "CN"
	    szExidCd = g_szExidCd
	Else																			'일본, 홍콩 
	    sNtns = g_szExidCd
	    szExidCd = g_szExidCd
	End If

	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "OV")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE"		, 0 , "62300")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , g_rtChk)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_NTNL_CODE"			, 0 , sNtns)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE"			, 0 , szExidCd)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_BSTP_CODE"			, 0 , g_szTypeCd)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_DATE1"				, 0 , "1")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE"	, 0 , "2")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE4"	, 0 , "0")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_VOL1"				, 0 , "0")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_TR_PBMN"			, 0 , "0")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_PRC1"				, 0 , "0")
	
	DATAMANAGER.RequestTranData("ohhts_6230_002r")
	
End Function

Function Process_Tran_ohhts_6230_002r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "ohhts_6230_002r", "OutBlock1")

	if nDataCnt == "" or Cint(nDataCnt) == 0 then
		
		contMain.lblEmpty.visible = true
		contMain.lblTypeInfo.visible = false
		contMain.lblSortInfo.visible = false
		contMain.lblDiv0.top = 72
		
		Form.triggerEvent("#", "CHANGE_LAYOUT_S14", 147)
		Exit Function
	end if
	
	if Cint(nDataCnt) > 3 then
		nDataCnt = 3
	end if
	
	nReduce = (3-nDataCnt) * 70
	
	'contMain.Pannel0.height = 228 - nReduce
	contMain.lblDiv0.top = 290 
	Form.triggerEvent("#", "CHANGE_LAYOUT_S14", 345)

	contMain.lblEmpty.visible = false
	contMain.lblTypeInfo.visible = true
	contMain.lblSortInfo.visible = true
		
	for i = 0 to nDataCnt-1
		szData0 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FID_COND_MRKT_CLS_CODE"  , i)
		szData1 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_ISCD" , i)
		szData2 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_KOR_ISNM" , i)
		szData3 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_PRPR" , i)
		szData4 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_PRDY_CTRT", i)
		
		'msgbox szData0 .. "|" ..szData1 .. "|" ..szData2 .. "|" ..szData3 .. "|" ..szData4
		
		nIdx = contMain.Pannel0.addRow()
		
		szPrc = ""
		if szData3 <> "" then
			if szData0 = "AX" or szData0 = "NY" or szData0 = "OQ" then
				szPrc = FormatNumber(szData3,4)
			elseif szData0 = "JP" then
				szPrc = FormatNumber(szData3,1)
			elseif szData0 = "SH" or szData0 = "SZ" then
				szPrc = FormatNumber(szData3,3)
			elseif szData0 = "HK" then
				szPrc = FormatNumber(szData3,3)
			end if
		end if
		
		'현재가 & 수익률
		szPrcRate = szPrc & " | " & FormatNumber(szData4,2) & "%"
		
		szPrcRateAttr = "0"
	
		if Cdbl(szData4) > 0 then
			szPrcRateAttr = "43"
		elseif Cdbl(szData4) < 0 then
			szPrcRateAttr = "45"
		end if
		
		sGroupID = ""
		sFlagID = ""
		
		if szData0 = "AX" or szData0 = "NY" or szData0 = "OQ" then
			sGroupID = "CI_USD"
			sFlagID = "USA"
		elseif szData0 = "JP" then
			sGroupID = "CI_JPN"
			sFlagID = "JPN"
		elseif szData0 = "SH" or szData0 = "SZ" then
			sGroupID = "CI_CHN"
			sFlagID = "CHN"
		elseif szData0 = "HK" then
			sGroupID = "CI_HKG"
			sFlagID = "HKG"
		else
			sGroupID = "CI_KOR"
			sFlagID = "KOR"
		end if
		
		szImgNm = Form.getIconImg(sGroupID, szData1)
		
		if szImgNm = "" then
			szImgNm = Form.getIconImg("FLAG", sFlagID)
			
			if szImgNm = "" then
				szImgNm = "flag_general"
			end if
		end if

		DisplaySetting_Pannel(nIdx, szData1, szData0, szData2, szPrcRate, szPrcRateAttr, szImgNm) 
	next
End Function

Function DisplaySetting_Pannel(nIdx, szItemCd, szMktCd, szItemNm, szPrcRate, szPrcRateAttr, szImgNm) 
	'상단 라인표시
	if nIdx = 2 then
		contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szTxtColor_White)
	else
		contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor2)
	end if
	
	
	'종목 국가 국기이미지 
	contMain.Pannel0.setPropCardCell("maintainratio", "imgFlag", nIdx, "2")
	contMain.Pannel0.setPropCardCell("imgpath","imgFlag", nIdx, szImgNm)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","lblNum",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblNum",nIdx, g_szTxtColor_Normal)
	contMain.Pannel0.setPropCardCell("maxlinecnt","lblNum",nIdx, "1^-2")
	contMain.Pannel0.setPropCardCell("caption","lblNum",nIdx, nIdx+1&".")
	
	'종목명
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemName",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemName",nIdx, g_szTxtColor_Normal)
	contMain.Pannel0.setPropCardCell("maxlinecnt","lblItemName",nIdx, "1^-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemName",nIdx, szItemNm)
	
	'종목코드(시장조치)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemCode",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemCode",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("caption","lblItemCode",nIdx, szItemCd)
	
	'현재가(전일대비)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemPrc",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("caption","lblItemPrc",nIdx, szPrcRate)
	
	if szPrcRateAttr = "43" then
		contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Red)
	elseif szPrcRateAttr = "45" then
		contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Blue)
	else
		contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	end if


'	'(숨김)종목코드
	contMain.Pannel0.setPropCardCell("caption","lblHideData0",nIdx, szMktCd)
	contMain.Pannel0.setPropCardCell("caption","lblHideData1",nIdx, szItemCd)
	contMain.Pannel0.setPropCardCell("caption","lblHideData2",nIdx, szItemNm)
'
	contMain.Pannel0.setPropCardCell("paddinginfo","btnHyun",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnHyun",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnChart",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnChart",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnInfo",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnInfo",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder0",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder0",nIdx, g_szTxtColor_White)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder1",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder1",nIdx, g_szTxtColor_White)

	
End Function
Function Convert_NatCd(szExidCd)
	szResult = ""
	
	Select Case szExidCd
		Case "NY", "AX", "OQ" 
			szResult = "US"
		Case "SH", "SZ"
			szResult = "CN"
		Case "JP", "HK"
			szResult = szExidCd
'		Case Else
'			szResult = ""
	End Select
	
	return szResult
	
End Function

Function MovePopup(nidx, nGbn)
	
	szMktCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",nidx)
	szItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData1",nidx)
	szItemNm = contMain.Pannel0.getPropCardCell("caption","lblHideData2",nidx)
	szItemCd = szMktCd & "@" & szItemCd
	
	Form.SetSharedData( "&ITEM_CODE" , szItemCd )
	Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
	Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
	Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if nGbn == 0 then						' 현재가
				Form.triggerEvent("#", "RETURN_LAYOUT", "호가")				
			elseif nGbn == 1 then					' 차트
				Form.OpenScreen("16020", "")
			elseif nGbn == 2 then				
				Form.triggerEvent("#", "RETURN_LAYOUT", "종목정보")
			elseif nGbn == 3 then					' 매수
				Form.OpenScreen("16060", "0")
			elseif nGbn == 4 then					' 매도
				Form.OpenScreen("16060", "1")
			end if
	End Select

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'===============================================
' Form_OnTriggerEvent(종목코드 연동)
'===============================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		if instr(sParam, "@") > 0 then
			g_szItemCd = sParam
			g_szExidCd = ""
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 
			
			g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			
			Request_Tran_ohhts_6000_001r()
		end if
	
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "RETURN_LAYOUT" then
		Form.triggerEvent("#", "RETURN_LAYOUT", sRet)
	end if
End Sub

