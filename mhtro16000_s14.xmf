'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
' 진한색
Dim g_szLineColor
g_szLineColor = "347"
' 중간색
Dim g_szLineColor2
g_szLineColor2 = "256"
' 연한색
Dim g_szLineColor3
g_szLineColor3 = "320"

' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

'==============================================
' 기타 전역변수
'==============================================
Dim g_szItemCd 
Dim g_szExidCd
Dim g_szOnlyCd
Dim g_rtChk

Dim g_szType
g_szType = "하드웨어 및 장비"

Dim g_szTypeCd
g_szTypeCd = ""

Dim g_nExpandHeight 
g_nExpandHeight = 130	

Dim g_nFoldHeight
g_nFoldHeight = 70

Dim g_nPrev_Expand_Idx
g_nPrev_Expand_Idx = -1
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
