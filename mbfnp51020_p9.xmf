'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 펀드자동이체_신청_완료팝업
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'============================================================================
'							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	Img0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim sOpenData, sOpenArr
	sOpenData 	= Form.GetOpenLinkData()
	sOpenArr		= split(sOpenData, "@")

	if UBOUND(sOpenArr) < 1 then
		Form.ShowAlert("알림", "해지 신청 내역이 없습니다.")
		Form.CloseForm()
		Exit Sub
	else
		
		' 자동이체 해지
		if sOpenArr(0) == "해지" then
			Dim PRCD
			Label0.caption = "펀드자동이체 해지 신청이\n완료되었습니다."
			
			sOpenArr1 = split(sOpenArr(1), "★")
	
			Table0.SetCellString(3, 1, sOpenArr1(15))

			PRCD			= Form.GetAccountInfo(sOpenArr1(0)..sOpenArr1(1), "productcode")
				
			Table0.SetCellString(4, 1, "["..Form.GetMetaData("MTS상품코드", PRCD).."] "..MID(sOpenArr1(0),1,4) .. "-" .. MID(sOpenArr1(0),5,4).."-"..sOpenArr1(1))
			Table0.SetCellString(6, 1, sOpenArr1(3))
			
			if Len(sOpenArr1(6)) == 6 then
				Table0.SetCellMaskInfo(7, 1, "1,0,,,1,####.## ~ ####.##,0,1,1,0,0")
			elseif Len(sOpenArr1(6)) > 6 then
				Table0.SetCellMaskInfo(7, 1, "1,0,,,1,####.##.## ~ ####.##.##,0,1,1,0,0")
			end if
			
			Table0.SetCellString(7, 1, sOpenArr1(6)..sOpenArr1(7))
			Table0.SetCellString(8, 1, sOpenArr1(8))
			
			Dim BANK_ACNO
			' 메리츠
			if sOpenArr1(10) == "1" then
				PRCD			= Form.GetAccountInfo(sOpenArr1(11)..sOpenArr1(12), "productcode")
				BANK_ACNO	= "["..Form.GetMetaData("MTS상품코드", PRCD).."] "..MID(sOpenArr1(11),1,4) .. "-" .. MID(sOpenArr1(11),5,4).."-"..sOpenArr1(12)
			'타사
			else
				BANK_ACNO = "["..Form.GetMetaData("은행코드", sOpenArr1(13)).."] "..sOpenArr1(14)
			end if
			
			Table0.SetCellString(5, 1, BANK_ACNO)
			
		' 자동이체 신청
		elseif sOpenArr(0) == "신청" then
			Label0.caption = "펀드자동이체 신청이\n완료되었습니다."
			
			sOpenArr1 = split(sOpenArr(1), "★")
	
			Dim PRCD, BANK_ACNO
			PRCD			= Form.GetAccountInfo(sOpenArr1(0)..sOpenArr1(1), "productcode")
			BANK_ACNO	= "["..Form.GetMetaData("MTS상품코드", PRCD).."] "..MID(sOpenArr1(0),1,4) .. "-" .. MID(sOpenArr1(0),5,4).."-"..sOpenArr1(1)
			
			Table0.SetCellString(3, 1, sOpenArr1(4))
			Table0.SetCellString(4, 1, BANK_ACNO)
			Table0.SetCellString(5, 1, sOpenArr1(5))
			Table0.SetCellString(6, 1, sOpenArr1(6))
			

			if Len(sOpenArr1(7)) == 12 then
				Table0.SetCellMaskInfo(7, 1, "1,0,,,1,####.## ~ ####.##,0,0,0,0,0")
			elseif Len(sOpenArr1(7)) > 12 then
				Table0.SetCellMaskInfo(7, 1, "1,0,,,1,####.##.## ~ ####.##.##,0,0,0,0,0")
			end if
			
			Table0.SetCellString(7, 1, sOpenArr1(7))
			Table0.SetCellString(8, 1, sOpenArr1(8))
		end if

	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SendReturnToParent("mbfnp51020_p9", "OK")
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>