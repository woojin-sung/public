'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub Container0_EditReal_OnEditChar(CharCode)
	
	Select Case CharCode
	
	Case "0"
		
		'입력값 6초과할 때 초과 카운팅 방지
		if nCnt = 6 then
			nCnt = 6
		else
			nCnt = nCnt + 1
		end if
		
		g_CountSave = nCnt
	Case "1"	
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt = 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
		
		g_CountSave = nCnt
	'취소, 입력완료일 때
	Case "2"
		nCnt = 0
	End Select

	PasswordInsert()
	
	'20240717 SWJ START: 입력완료 전에 완료 처리
	if nCnt = 6 then		
		'입력완료 호출 API
		Container0.EditReal.runSecKeypadFinish()
	end if
	'20240717 SWJ END

End Sub

'============================================================================
'고객에게 보여지는 에디트 위치 클릭시 키패드 활성화(에디트 위치에 버튼 올려서)
'============================================================================
Sub Container0_Button0_OnClick()
	Container0.EditReal.SetShowKeypad(True)
	
	'인증 에디트 초기화
	nCnt = 0
	PasswordInsert()
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	elseif sKeyName == "LOG_FORCE" then
		' IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_DeviceOS == "2" Then	'iOS("2")Android("1")
			if sRet == "ok" then			
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")		
			else
				if g_ScrNum == "10003" then
					'안드로이드는 여기서 폼닫기 해도 닫히는데
					'ios는 메뉴화면을 직접닫아줘야 닫아짐
					Form.triggerEvent("#","ios_formclose","")
				else
					Form.CloseForm()
				end if
			end if		
		else
			if sRet == "ok" then
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()			
			end if	
		end if
		
	elseif sKeyName == "MOTP_NEW" then
		
		if sRet == "cancel" then
			Form.CloseForm()
			exit sub
		end if
		
		'로그인을 한번이라도 했었는지 판단
		if g_sUserID == "" or g_sUserID == null then
			Form.SetSharedData("BDM_NMETBSWRGB", "009")
			Form.OpenNextPopup("mbbdm85200","", "")
		else
			if Cint(g_LoginType) > 1 then '로그인상태
				Form.OpenNextPopup("mbotp86100","", "")
			else
				'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
				'업무신청 화면으로 발급하도록 연결
				 Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
				 Form.SetSharedData("BDM_FRST_MAPID", "screen41000")
				 Form.SetSharedData("BDM_NMETBSWRGB", "009")
				 'V001
				 'Form.OpenNextPopup("mbbdm85110", "" , "" )
				 Form.OpenNextPopup("mbbdm86130", "" , "" )
				
			end if
		end if
	end if
End Sub

'============================================================================
Sub Container0_EditReal_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if g_DeviceOS == "2"  then
			Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
		elseif g_DeviceOS == "1" then
			Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
		end if
		
	elseif nCnt = 6 then
		
		'''''''''''''''''''''간편인증 비밀번호 설정 불가 Case 서비스 호출''''''''''''''''''''''''''
		DATAMANAGER.RequestTranData("obacp_comm_004r")   '20230622 jsi 비밀번호 검증 전 연락처 조회 호출
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		nCnt = 0
	end if
End Sub

'============================================================================
'20220701 SWJ START : 이미지 찌그러짐 방지
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.Pwdbasic0.setMaintainingRatio("1")
	Container0.Pwdbasic1.setMaintainingRatio("1")
	Container0.Pwdbasic2.setMaintainingRatio("1")
	Container0.Pwdbasic3.setMaintainingRatio("1")
	Container0.Pwdbasic4.setMaintainingRatio("1")
	Container0.Pwdbasic5.setMaintainingRatio("1")
	Container0.Pwdinsert0.setMaintainingRatio("1")
	Container0.Pwdinsert1.setMaintainingRatio("1")
	Container0.Pwdinsert2.setMaintainingRatio("1")
	Container0.Pwdinsert3.setMaintainingRatio("1")
	Container0.Pwdinsert4.setMaintainingRatio("1")
	Container0.Pwdinsert5.setMaintainingRatio("1")
	Container0.PwdFail0.setMaintainingRatio("1")
	Container0.PwdFail1.setMaintainingRatio("1")
	Container0.PwdFail2.setMaintainingRatio("1")
	Container0.PwdFail3.setMaintainingRatio("1")
	Container0.PwdFail4.setMaintainingRatio("1")
	Container0.PwdFail5.setMaintainingRatio("1")
	
	Container0.ImgClose.setMaintainingRatio("1")
	Container0.ImgRegi.setMaintainingRatio("1")
End Sub
'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	if szTranID == "obaci_nmet_011r" then
		szProsClsCode = ""
		szRsltCode    = ""
		
		szProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		szRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If szProsClsCode == "5" and TRIM(szRsltCode) <> "00" Then
			
			Form.OpenPopup("mpopup_auth3", szRsltCode , "" )
			
			Container0.EdtPwReal.caption = ""
			nCnt = 0
			PasswordFail()
			
		Else '비밀번호 입력 성공시
			
			Call PasswordInsert()
			
			'다음 화면에서 비번 재검증 위해 set
			Form.SetSharedData("Meritz_OTP_PWDAuth",  Container0.EditReal.caption2)
			
			g_nextpage = true
			Form.CloseForm()
			'Form.SetTimerEvent2(2, 1, 0.5) '비번 재입력화면으로 넘어감
		End If
	
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obaci_nmet_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "5")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , g_otpACNO )   '20230622 jsi 계좌번호 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , Container0.EditReal.caption2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     , 0 , g_ClphNo    ) '20230623 jsi 휴대폰 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WRPL_TELNO"     , 0 , g_WorkNo    ) '20230622 jsi 직장전화 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OWHS_TELNO"     , 0 , g_HomeNo    ) '20230622 jsi 자택전화 추가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0 , g_RcnoPip   )
	elseif szTranID == "obacp_comm_004r" then  '20230622 jsi obacp_comm_004r 연락처 정보 조회 전 세팅 /'비로그인 시에는 meritz로 세팅 되기 때문에 헤더값세팅
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"   , 0 , g_otpACNO )
		
		if Cint(g_LoginType) > 1 then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , g_sUserID)  
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , "meritz")  
		end if
		
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub
'============================================================================
Sub Container0_ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_BtnRegi_OnClick()
	Form.OpenPopup("mpopup_auth","CommonAuthPopup","")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mpopup_auth" then
		if sRet == "register" then
			g_closeflag = "3"
			Form.CloseForm()
		end if
'	elseif sKeyName == "mhetc90190_s4" then
'		if sRet == "nextpage" then
'			g_closeflag = "0"
'			Form.CloseForm()
'		elseif sRet == "1" or sRet == "2" then
'			g_closeflag = sRet
'			Form.CloseForm()
'		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	 Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	 
	if g_closeflag == "0" then
		Form.OpenPopup("mhetc90190_p2" , "0" , "")
	elseif g_closeflag == "1" or g_closeflag == "2" then
		Form.OpenPopup("mhetc90190_s5" , g_closeflag , "")
	elseif g_closeflag == "3" then
		Form.OpenPopup("mhetc90190_s1","","")	
	end if
	
	if g_nextpage then
		'비번 재입력 팝업
		Form.OpenPopup( "mhetc90190_s4" , g_ScrPoint , "")
	end if
End Sub

'============================================================================
'로그인 시킬 때 로그인 창에서 던짐 (발급할 때 중간에 창이 안닫힘)
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&ATON_REGI" and Cint(sValue) == 6 then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    '20230622 jsi 연락처 조회 후 검증 로직 추가
    if szTranID == "obacp_comm_004r" then 
	    g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
	    g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
	    g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
	    DATAMANAGER.RequestTranData("obaci_nmet_011r")   '20230622 jsi 비밀번호 검증 조회 호출
	end if
End Sub

