'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_szUserID	'사용자ID

g_szUserID	=	""
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szUserID	=		Form.GetSharedData("&USER_ID", 0 )
	
	
	if	g_szUserID	<> null		then
		DATAMANAGER.RequestTranData("ooase_user_100r")
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"ooase_user_100r"	then
		DATAMANAGER.SetDataValue(0,"ooase_user_100r", "InBlock1", "ELFN_ID", 0, g_szUserID)
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim	bIsMore
	
	bIsMore	=	false

	if	szTranID	=	"ooase_user_100r"	then
		bIsMore	=	DATAMANAGER.IsMoreNextData("ooase_user_100r")
	
		if	bIsMore	=	true		then
			DATAMANAGER.SetDataValue(0,"ooase_user_100r", "InBlock1", "ELFN_ID", 0, g_szUserID)
			DATAMANAGER.RequestNextData("ooase_user_100r")
		end	if
	end	if
	
End Sub


'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
'btnCloseBot_OnClick
'============================================================================
Sub btnCloseBot_OnClick()
	Dim	szOutdata	'리턴할데이터
	Dim	szCnt		'그리드카운트
	Dim	szAcno, szAsno, szRegYN
	
	szOutdata	=	""
	szAcno		=	""
	szAsno		=	""
	szRegYN		=	""
	
	szCnt 	=	grdAcnt01.rowcount 
	szOutdata	=	szCnt 
	
	
	for	i = 0 	to		szCnt - 1 
		szAcno		=	""
		szAsno		=	""
		szRegYN		=	""
	
		szAcno	=	grdAcnt01.GetCellData("bd_acno", i)
		szAsno	=	grdAcnt01.GetCellData("bd_asno", i)
		szRegYN	=	grdAcnt01.GetCellData("bd_regyn", i)
		
		if	trim(szRegYN)				=	"1"	then		'체크한경우
			szRegYN	=	"1"
		elseif	trim(szRegYN)			=	"0"	then		'체크안한경우
			szRegYN	=	"0"
		elseif	trim(szRegYN)			=	"Y"	then		'캔슬일경우
			szRegYN	=	"0"
		elseif	trim(szRegYN)			=	"N"	then		'등록되어있는경우
			szRegYN	=	"1"
		elseif	len(trim(szRegYN))	=	0	then		'미체크시
			szRegYN	=	"0"
		end	if
		
		szOutdata	=	szOutdata & "★" & szAcno & "★" & szAsno & "★" & szRegYN
	next
	
	Form.SendReturnToParent("mhprc11020_pc", szOutdata)
	Form.CloseForm()
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert(szTranID, szErrMsg)
End Sub

'===========================================================================
'szTranID
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim	szDataCnt
	dim	szOrg, szTrs

	szDataCnt	=	"0"
	szOrg	=	""
	szTrs	=	""
	
	if	szTranID		=	"ooase_user_100r"	then
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "ooase_user_100r" , "OutBlock1")
	
		'등록해제시 체크박스 버튼 처리
		for	i = 0	to	szDataCnt - 1
			szOrg	=	DATAMANAGER.GetDataValue(0, "ooase_user_100r", "OutBlock1", "CANC_YN" , i)
			
			if	trim(szOrg)	=	"N"	then		'N-->등록되어있음
				szTrs	=	"1"
			else								'Y,공백 -->등록안되어있으므로 미체크처리
				szTrs	=	"0"
			end if	
			
			DATAMANAGER.SetDataValue(0, "ooase_user_100r", "OutBlock1", "CANC_YN", i, szTrs)
		next
	end	if
End Sub



