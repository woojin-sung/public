'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn,nUnit)
	
	szQty = edtQty.caption
	
	'---------------------------------------------------------
	' (기존요건) 최대입력 가능 수량
	'---------------------------------------------------------
	if Trim(szQty) <> "" then
		if Len(szQty) > gMaxLen then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	
	'---------------------------------------------------------
	' 수량이 빈값인 경우 매매단위로 초기화
	'---------------------------------------------------------
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = CDbl(nUnit)
		else
			Exit Function
		end if
	
	'---------------------------------------------------------
	' 수량이 빈값이 아닌 경우
	'---------------------------------------------------------
	else
			
		'---------------------------------------------------------
		' [+]버튼 클릭
		'---------------------------------------------------------
		if nGbn == 0 then
			szQty = CDbl(szQty) + CDbl(nUnit)
			nResult = CDbl(szQty) Mod CDbl(nUnit)
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
			
		'---------------------------------------------------------
		' [-]버튼 클릭
		'---------------------------------------------------------
		elseif nGbn == 1 then
			
			if CDbl(szQty) == 0 then
				Exit Function
			else		
				szQty = szQty - CDbl(nUnit)
				nResult = CDbl(szQty) Mod CDbl(nUnit)
				
				'20240726
				if Cdbl(szQty) < 0 then
					szQty = 0
				end if
				
			end if
			
		end if
		
	end if
	
	'---------------------------------------------------------
	' 입력값 자리수 확인
	'---------------------------------------------------------
	if Len(szQty) <= gMaxLen then		
		if CStr(szQty) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szQty
		end if
	end if
	
	Calc_OrderPrice()
	
	
End Function

