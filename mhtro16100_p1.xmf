	<SCRIPT_INFO _len="73604" _ulen="67878" >
Dim gGubun
Dim gCode,gMarket
Dim gCredit
Dim g_szCurPrice,gHighPrice,gLowPrice
Dim gPrc,gQty
Dim gOrderGubun
Dim g_szCurrency
Dim g_szDecimal

Dim gCalcOrderPrice
Dim gCalcOrderPriceWon
Dim gExchangeRate
Dim g_szOrdSize
Dim gMarketCode
Dim gTickType
Dim gMaeMaeGubun
Dim gAcno
Dim gAsno
Dim gTotalYN


Dim g_szUnit

Dim g_szFocusIndex
Dim g_szFocusEditClear

Dim gQty10_Size,gQty100_Size,gQty1000_Size
gQty10_Size = 10
gQty100_Size = 100
gQty1000_Size = 1000

Dim gOsType
Dim gMaxLen
gMaxLen = 12

'============================================================================
Sub Form_OnFormInitBefore()

	'tblData.visible = true
	'tblData0.visible = true
	
	gOsType = Form.GetSharedData("&OS_TYPE", false )
	
	if gOsType == "1" then
		lblOrderPrice.paddinginfo = "10,0,10,2"
		lblOrderPriceWon.paddinginfo = "10,2,10,0"
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'==================================================
	' 컨트롤 설정
	'==================================================
	grdPrc.SetUseScriptImageCell("1") 'IOS 그리드 반복그림 관련 버그 수정

	'==================================================
	' 연결화면 링크값 세팅
	'==================================================
	' 0 : gGubun 				= 타이틀구분(단가/수량/금액)
	' 1 : gMarket 			= 시장구분(2자리)
	' 2 : gCode				= 종목코드
	' 3 : gCredit				= 현금/신용구분
	' 4 : g_szCurPrice 		= 현재가
	' 5 : gPrc				= 입력가격
	' 6 : gQty 				= 입력수량
	' 7 : gHighPrice 			= 상한가
	' 8 : gLowPrice 			= 하한가
	' 9 : gOrderGubun 		= 주문구분(시장가/지정가..)
	' 10 : g_szCurrency		= 통화구분
	' 11 : g_szDecimal		= 소수점자리수
	' 12 : gCalcOrderPrice 	= 주문금액(통화)
	' 13 : gCalcOrderPriceWon 	= 주문금액(원화)
	' 14 : gExchangeRate 		= 환율
	' 15 : g_szOrdSize		= 매매단위
	' 16 : gMarketCode		= 거래소코드(4자리)
	' 17 : gTickType			= 틱타입
	' 18 : gMaeMaeGubun		= 매수(BUY), 매도(SELL), 정정/취소
	' 19 : gAcno				= 계좌번호(8자리)
	' 20 : gAsno				= 계좌번호(2자리)
	' 21 : gTotalYN			= 통합증거금여부(Y/N)
	'==================================================
	
	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	gGubun 				= arrData(0)
	gMarket 				= arrData(1)
	gCode 				= arrData(2)
	gCredit 				= arrData(3)
	g_szCurPrice 			= arrData(4)
	gPrc 				= arrData(5)
	gQty 				= arrData(6)
	gHighPrice 			= arrData(7)
	gLowPrice 			= arrData(8)
	gOrderGubun 			= arrData(9)
	g_szCurrency 			= arrData(10)
	g_szDecimal 			= arrData(11)
	gCalcOrderPrice		= arrData(12)
	gCalcOrderPriceWon 	= arrData(13)
	gExchangeRate 		= arrData(14)
	g_szOrdSize			= arrData(15)
	gMarketCode			= arrData(16)
	gTickType			= arrData(17)
	gMaeMaeGubun			= arrData(18)
	gAcno				= arrData(19)
	gAsno				= arrData(20)
	gTotalYN				= arrData(21)
	
	g_szUnit				= GetHogaUnit(gMarketCode, g_szCurPrice, 0) 
	
	'==================================================
	' 시세데이터 조회(매도1호가/현재가/매수1호가 )
	'==================================================
	RequestSiseData(gMarket,gCode)
	
	'==================================================
	' 링크데이터 중 시세 데이터 세팅
	'==================================================
	SetSiseData()
	
	'==================================================
	' 타이틀 구분 세팅
	'==================================================
	SetTitle(gGubun)
	
	'==================================================
	' 타이틀 구분에 따른 퀵버튼 생성
	'==================================================
	SetMakeQuickButton(gGubun)
	
	'==================================================
	' 타이틀 구분에 따른 포커스 입력창 설정
	'==================================================
	SetFocusEdit(gGubun)
	
	'==================================================
	' 가격입력창/수량입력창/금액창 초기화
	'==================================================
	SetInitPrcEdit()
	SetInitQtyEdit()
	SetInitOrdPriceLabel()
	Calc_OrderPrice()
	
End Sub

'============================================================================
' 바탕클릭 이벤트
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' (공통) 가격입력창 가격SET
'============================================================================
Function SetPrice(sType,nPrc,nDecimalLen,sCurrency)
	
	szChk = Instr(Cstr(nPrc), ".")
	'lblTitle.caption = szChk .. "//" .. nDecimalLen .. "//" .. nPrc '.. "//".. sResult
	'================================================================
	'소수점(dot)이 있는 경우
	'================================================================
	if szChk > 0 then
		
		'------------------------------
		'소수점영역 길이
		'------------------------------
		szCha = CInt(Len(nPrc) - szChk)
		
		'-------------------------------------------------------
		'소수점영역의 길이가 국가별 소수점 자리수를 다 채운 경우
		'-------------------------------------------------------
		if szCha >= Cint(nDecimalLen) then
			 
			 if szCha == Cint(nDecimalLen) then
				 sResult = FormatNumber(nPrc,nDecimalLen).." " .. sCurrency
				 edtPrc.caption = sResult
			 else
				 exit Function
			 end if
		
		'-------------------------------------------------------	 
		' 소수점영역의 길이를 아직 다 안채운 경우
		'-------------------------------------------------------
		else
			
			'-------------------------------------------------------------------
			'자동으로 호가가격이 입력되는 경우(초기값 세팅/ 호가 +,- 버튼 클릭)
			'국가별 소수점 자리수로 가격을 다시 맞춰준다.
			'-------------------------------------------------------------------
			if sType == "AUTO" then
				
				sResult = FormatNumber(nPrc,nDecimalLen).." " .. sCurrency
				edtPrc.caption = sResult
			
			'-------------------------------------------------------------------
			'가격이 수동으로 입력되는 경우(키패드 입력)에는 입력받은대로 표시
			'-------------------------------------------------------------------
			else
				sResult = nPrc.." " .. sCurrency
				edtPrc.caption = sResult
			end if
			
		end if
	
	'================================================================
	' 소수점(dot)이 없는 경우
	'================================================================
	else
	
		if sType == "AUTO" then
			sResult = FormatNumber(nPrc,nDecimalLen) .." " .. sCurrency
			edtPrc.caption = sResult
		else
			sResult = FormatNumber(nPrc,0) .." " .. sCurrency
			edtPrc.caption = sResult
		end if
		
	end if
	
End Function
'============================================================================
' (공통) 가격입력창 가격GET
'============================================================================
Function GetPrice()
	
	sResult = replace(edtPrc.caption, " " .. g_szCurrency , "")
	sResult = replace(sResult, "," , "")
	
	return sResult

End Function
'============================================================================
' 타이틀 세팅
'============================================================================
Function SetTitle(sGubun)
	
	'-----------------------------------
	'sGubun 0:단가 / 1:수량 / 2:금액
	'-----------------------------------
	if sGubun == "0" then
		lblTitle.caption = "단가 입력"
	elseif sGubun == "1" then
		lblTitle.caption = "수량 입력"
	elseif sGubun == "2" then
		lblTitle.caption = "금액 입력"
	else
		lblTitle.caption = "입력"
	end if
	
End Function

'============================================================================
' 포커스 에디트 설정
'============================================================================
Function SetFocusEdit(sGubun)

	g_szFocusIndex = sGubun
	g_szFocusEditClear = false
	
	'-----------------------------------
	'sGubun 0:단가 / 1:수량 / 2:금액
	'-----------------------------------
	if sGubun == "0" then
	
		btnPMinus0.visible = true
		btnPMinus.visible = false
		btnPPlus0.visible = true
		btnPPlus.visible = false
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
		
		edtPrc.imagefilepth = "input_07_o.9"
		edtQty.imagefilepth = "input_07_n.9"
		'imgOrderPrc.imgpath = "input_06_n.9"
		
	elseif sGubun == "1" then
	
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = true
		btnQMinus.visible = false
		btnQPlus0.visible = true
		btnQPlus.visible = false
	
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_o.9"
		'imgOrderPrc.imgpath = "input_06_n.9"
		
	elseif sGubun == "2" then
	
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
	
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_n.9"
		'imgOrderPrc.imgpath = "input_06_o.9"
		
	end if
	
End Function


