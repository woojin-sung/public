'============================================================================
' 가격입력창 데이터 세팅
'============================================================================
Function SetInitPrcEdit()

	'------------------------------------------------------------------------------
	' 주문구분(gOrderGubun)이 지정가일 경우 넘어온 가격 세팅(없을 경우 현재가 세팅)
	'------------------------------------------------------------------------------
	if gOrderGubun == "01" or gOrderGubun == "31" or gOrderGubun == "32" or gOrderGubun == "32" or gOrderGubun == "35" or gOrderGubun == "36" then
	
		'--------------------------
		' 링크가격 입력
		'--------------------------
		if gPrc <> "" and Cdbl(gPrc) > 0 then
			SetPrice("AUTO",gPrc,g_szDecimal,g_szCurrency)
		else
			SetPrice("AUTO",g_szCurPrice,g_szDecimal,g_szCurrency)
		end if
	
	'--------------------------------------------------------------------
	' 주문구분(gOrderGubun)이 시장가일 경우 가격세팅X/가격입력창 비활성화
	'--------------------------------------------------------------------
	elseif gOrderGubun == "05" or gOrderGubun == "33" or gOrderGubun == "34" or gOrderGubun == "37" or gOrderGubun == "38"then
	
		'20240715 시장가유형일때는 공란으로
		'SetPrice("AUTO","",g_szDecimal,g_szCurrency)
		if gMaeMaeGubun == "BUY" then
			edtPrc.hintcaption = "매수가격"
		elseif gMaeMaeGubun == "SELL" then
			edtPrc.hintcaption = "매도가격"
		elseif gMaeMaeGubun == "MOD" then
			edtPrc.hintcaption = "정정가격"
		end if
		
		btnPMinus.enable = false
		btnPMinus0.enable = false
		
		btnPPlus.enable = false
		btnPPlus0.enable = false
		
		btnPrc.enable = false
		edtPrc.enable = false
		
	
	end if

End Function

'============================================================================
' 수량 입력창 데이터 세팅
'============================================================================
Function SetInitQtyEdit()
	
	'--------------------------
	' 링크수량 입력(수량이 빈값이면 0주로 초기화)
	'--------------------------
	if gQty == "" then
		gQty = "0"
	end if
	
	edtQty.caption = gQty
	
	'--------------------------
	'링크 매매단위 입력
	'--------------------------
	LabelUnit.caption = g_szOrdSize
	
	
	'--------------------------
	'정정/취소에서 호출된 경우 수량 변경 불가
	'--------------------------
	if gMaeMaeGubun == "MOD" then
		
		btnQMinus0.enable = false
		btnQMinus.enable = false
		btnQPlus0.enable = false
		btnQPlus.enable = false
		
		btnQty.enable = false
		edtQty.enable = false
		
	end if
	
End Function

