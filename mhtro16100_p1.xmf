'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	
	'-----------------------------------------------------------------------
	' 호가단위 초기화
	'-----------------------------------------------------------------------
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szCurPrice = "" or CDbl(g_szCurPrice) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szCurPrice)
		end if	
	end if
	
	szUnit = "1.000"
	
	'-----------------------------------------------------------------------
	' 틱타입 확인
	'-----------------------------------------------------------------------
	szTtype = Cint(gTickType)

	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	'-----------------------------------------------------------------------
	' 중국(상해/심천) 호가단위 설정
	'-----------------------------------------------------------------------
	if szMk == "0215" then '상해
		
		'20240613 LES START 틱단위 수정
		if szTtype = 2 then 'ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end if
		'20240613 LES END
		
	elseif szMk == "0214" then '심천
		
		'20240613 LES START 틱단위 수정
		if szTtype = 2 then 'ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end if
		'20240613 LES END
		
	'-----------------------------------------------------------------------
	' 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	'-----------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		
		'20240702 LES START - 1달러미만 종목 0.0001단위
		if szOrdPrc < 1.00 then
			szUnit = "0.0001" 
		else
			if szTtype == 1 then
				szUnit = "0.010"
				
			elseif szTtype == 2 then
				szUnit = "0.050"
				
			elseif szTtype == 3 then
				szUnit = "0.050"
				
			elseif szTtype == 4 then
				szUnit = "0.050"
				
			else
				szUnit = "0.010"
			end if
		end if
	
	'-----------------------------------------------------------------------
	' 홍콩 호가단위 설정, (홍콩ETF종목 호가단위 변경)
	'-----------------------------------------------------------------------
	elseif szMk == "0104" then '홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		'홍콩 ETF종목 호가단위 변경
		'type = 5 (ETF종목) 추가
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			end if
		
		else
			if nGbn == 0 then
				if szOrdPrc < 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc < 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc < 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc < 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc < 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc < 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc < 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc < 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc < 5000.00 then
					szUnit = "2.000"
		
				else 
					szUnit = "5.000"
		
				end if
			else
				if szOrdPrc <= 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc <= 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc <= 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc <= 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc <= 5000.00 then
					szUnit = "2.000"
		
				else
					szUnit = "5.000"
		
				end if
			
			end if
			
		end if
	
	'-----------------------------------------------------------------------
	' 해외주식 일본시장(도쿄거래소) 추가
	'-----------------------------------------------------------------------
	elseif szMk == "0106" then '도쿄
		if szTtype == 3 then
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc < 5000 then
					szUnit = "1"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc < 30000 then
					szUnit = "5"
					
				elseif szOrdPrc < 50000 then
					szUnit = "10"
		
				elseif szOrdPrc < 100000 then
					szUnit = "10"
		
				elseif szOrdPrc < 300000 then
					szUnit = "50"
		
				elseif szOrdPrc < 500000 then
					szUnit = "100"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "100"
				
