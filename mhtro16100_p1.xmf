	DATAMANAGER.RequestTranData("ohhts_6000_020r")
	
End Function
'============================================================================
Function RequestAfterMarketRealSiseData(sMarket,sCode)

	if sMarket <> "" and sCode <> "" then
		DATAMANAGER.CancelRealData("ohhts_exst_cnta")
		DATAMANAGER.ClearInputData(1, "ohhts_exst_cnta")
		
		DATAMANAGER.SetDataValue(1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD" , 0 , sMarket & "@" & sCode )
		DATAMANAGER.RequestRealData("ohhts_exst_cnta")
		
		DATAMANAGER.CancelRealData("ohhts_exst_aspr")
		DATAMANAGER.ClearInputData(1, "ohhts_exst_aspr")
		
		DATAMANAGER.SetDataValue(1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , sMarket & "@" & sCode )
		DATAMANAGER.RequestRealData("ohhts_exst_aspr")
		
	end if

End Function
