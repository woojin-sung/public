'============================================================================
' 타이틀 구분에 따른 퀵버튼 생성
'============================================================================
Function SetMakeQuickButton(sGubun)

	'----------------------------------------------------------------------------
	' 단가 (단가 퀵버튼의 경우 매도1호가/현재가/매수1호가 로 고정)
	'----------------------------------------------------------------------------
	if sGubun == "0" then
		
		contPrc.visible = true
		contQty.visible = false
		contOrderPrice.visible = false
		
		'단가입력 상태일 경우 00 => .(dot)으로 변환
		btnPlus00.caption = "."
	
	'----------------------------------------------------------------------------
	' 수량 (매매단위별로 퀵버튼 수량 가변적)
	'----------------------------------------------------------------------------
	elseif sGubun == "1" then
	
		'매매단위 < 10 인 경우 : +10 / +100 / +1000 / 최대가능
		'매매단위 >= 10 인 경우 : 매매단위*1 / 매매단위*2 / 매매단위*3 / 최대가능
		if CDbl(g_szOrdSize) >= 10 then
			contQty.btnQty10.caption = "+"..Cstr(g_szOrdSize * 1) .. "주"
			contQty.btnQty100.caption = "+"..Cstr(g_szOrdSize * 2) .. "주"
			contQty.btnQty1000.caption = "+"..Cstr(g_szOrdSize * 3) .. "주"
			
			gQty10_Size = g_szOrdSize * 1
			gQty100_Size = g_szOrdSize * 2
			gQty1000_Size = g_szOrdSize * 3
			
		else
			contQty.btnQty10.caption = "+10주"
			contQty.btnQty100.caption = "+100주"
			contQty.btnQty1000.caption = "+1000주"
		end if
	
		contPrc.visible = false
		contQty.visible = true
		contOrderPrice.visible = false
		
		'수량입력 상태일 경우 .(dot) => 00 으로 변환
		btnPlus00.caption = "00"
	
	'-------------------
	'금액
	'-------------------
	elseif sGubun == "2" then
	
		contPrc.visible = false
		contQty.visible = false
		contOrderPrice.visible = true
	
	end if
	
End Function

'============================================================================
' 키패드 버튼 입력 시 처리
'============================================================================
Function InputKeypad(sType, sKeypad)

	'----------------------------------------------------------------------
	'sType = "NUM" : 숫자(1~9) 버튼
	'----------------------------------------------------------------------
	'sType = "ZERO" : 숫자(0) 버튼
	'----------------------------------------------------------------------
	'sType = "DOT" : 소수점(.) 버튼
	'----------------------------------------------------------------------
	'sType = "QUICK" : 퀵버튼
	'
	'- 단가 : 매도1호가/현재가/매수1호가
	'- 수량 : +10 / +100 / +1000 or +매매단위*1 / +매매단위*2 / +매매단위*3
	'- 금액 : +10만 / +100만 / +500만
	'
	'----------------------------------------------------------------------
	'sType = "ABLE" : 가능수량 버튼
	'----------------------------------------------------------------------
	'sType = "CLEAR" : 클리어 버튼
	'----------------------------------------------------------------------
	'sType = "DELETE" : 삭제버튼
	'----------------------------------------------------------------------
	
	'======================================================================
	' 숫자(1~9) 키패드 입력
	'======================================================================
	if sType == "NUM" then
		
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
		if g_szFocusIndex == "0" then
		
			sData = GetPrice()
			
			'---------------------------------------------------
			'[키패드로 최초 입력 시]
			'키패드 최초 입력 시에는 입력되어있는 값 클리어
			'---------------------------------------------------
			if g_szFocusEditClear <> true then
				
				g_szFocusEditClear = true
				
				sData = sKeypad
				SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
			
			'---------------------------------------------------
			'[키패드로 최초 입력이 아닐시]
			''최초 클리어 이후에는 입력값 이어붙임
			'---------------------------------------------------
			else
				
				sData = sData & sKeypad
				
				'입력값 자리수 체크
				if Len(sData) > gMaxLen then
					return
				end if
			
				SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
				
			end if
			
		'---------------------------------------------------
		'[수량 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
		elseif g_szFocusIndex == "1" then
		
			sData = edtQty.caption
			
			if g_szFocusEditClear <> true then
				
				g_szFocusEditClear = true
				sData = sKeypad
				edtQty.caption = sData
				
			else
				
				sData = sData & sKeypad
			
				'입력값 자리수 체크
				if Len(sData) > gMaxLen then
					return
				end if
				
				edtQty.caption = sData
			
			end if
		
		end if
		
	
	'======================================================================
	' 숫자(0) 키패드 입력
	'======================================================================
	elseif sType == "ZERO" then
	
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
		if g_szFocusIndex == "0" then
			
			sData = GetPrice()
			
			if g_szFocusEditClear <> true then
			
				g_szFocusEditClear = true
				sData = sKeypad
				SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
			
			else
				
				sData = sData & sKeypad
			
				'입력값 자리수 체크
				if Len(sData) > gMaxLen then
					return
				end if
				
				SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
			
			end if
		
		
		'---------------------------------------------------
		'[수량 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
		elseif g_szFocusIndex == "1" then
		
			sData = edtQty.caption
		
			if g_szFocusEditClear <> true then
				
				g_szFocusEditClear = true
				sData = sKeypad
				edtQty.caption = sData
				
			else
			
				'입력값 자리수 체크
				if Len(sData & sKeypad) > gMaxLen then
					return
				end if
				
				'0이 입력되있는 경우에는 무시
				if sData <> "0" then
					sData = sData & sKeypad
					edtQty.caption = sData
				end if
			
			end if
		
		end if
	
	'======================================================================
	' 소수점(.) 키패드 입력
	'======================================================================
	elseif sType == "DOT" then
	
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우에만 동작
		'---------------------------------------------------
		if g_szFocusIndex == "0" then
		
			sData = GetPrice()
			
			'이미 소수점이 입력되어 있는 경우에는 입력 무시
			if Instr(sData,".") > 0 then
				return
			else
				
				if sData <> "" then
					
					sData = sData & sKeypad
					SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
				
				end if
				
			
			end if
		
		end if
		
	
	'======================================================================
	' 퀵입력 버튼 
	'======================================================================
	elseif sType == "QUICK" then
	
		if sKeypad == "QTY10" or sKeyPad == "QTY100" or sKeyPad == "QTY1000" then
			
			if g_szFocusEditClear <> true then
				g_szFocusEditClear = true
			end if
			
			sData = edtQty.caption
			
			if sData == "" then
				sData = "0"
			end if
			
			if sKeypad == "QTY10" then
				nAdd = gQty10_Size
			elseif sKeypad == "QTY100" then
				nAdd = gQty100_Size
			elseif sKeypad == "QTY1000" then
				nAdd = gQty1000_Size
			end if
			
			edtQty.caption = CInt(sData) + nAdd
			
		elseif sKeypad == "PRC_MAEDO1" or sKeypad == "PRC_MAESU1" or sKeypad == "PRC_CUR" then
		
			if g_szFocusEditClear <> true then
				g_szFocusEditClear = true
			end if
			
			if sKeypad == "PRC_MAEDO1" then
				sData = tblData.GetCellString(1, 0)
			elseif sKeypad == "PRC_CUR" then
				sData = tblData.GetCellString(1, 1)
			else
				sData = tblData.GetCellString(1, 2)
			end if
			
			SetPrice("AUTO",sData,g_szDecimal,g_szCurrency)
				
		end if
	
	
	'======================================================================
	' 가능수량 키패드 입력
	'======================================================================
	elseif sType == "ABLE" then
	
	'======================================================================
	' 가능수량 키패드 입력
	'======================================================================
	elseif sType == "CLEAR" then
	
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
		if g_szFocusIndex == "0" then
			
			sData = GetPrice()
			
			if g_szFocusEditClear <> true then
				g_szFocusEditClear = true
			end if
			
			sData = 0
			SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
		
		'---------------------------------------------------
		'[수량 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
		elseif g_szFocusIndex == "1" then
		
			sData = edtQty.caption
		
			if g_szFocusEditClear <> true then
				g_szFocusEditClear = true
			end if
			
			sData = 0
			edtQty.caption = sData
			
		end if
		
		
	'======================================================================
	' 삭제(<-) 키패드 입력
	'======================================================================
	elseif sType == "DELETE" then
	
		if g_szFocusIndex == "0" then
		
			if g_szFocusEditClear <> true then
				
				g_szFocusEditClear = true
				sData = 0
				SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
			
			else
				
				sData = GetPrice()
				nLen = Len(sData)
				sData = left(sData ,nLen - 1)
				SetPrice("MANAUAL",sData,g_szDecimal,g_szCurrency)
			
			end if
		
		elseif g_szFocusIndex == "1" then
		
			if g_szFocusEditClear <> true then
			
				g_szFocusEditClear = true
				sData = 0
				edtQty.caption = sData
				
			else
				
				sData = edtQty.caption
				nLen = Len(sData)
				sData = left(sData ,nLen - 1)
				edtQty.caption = sData
				
			end if
		
		end if
		
		
	end if
	
	
	'입력키패드 입력이 끝난 후 주문금액 계산
	Calc_OrderPrice()
	
End Function

