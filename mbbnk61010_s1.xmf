		<LABEL name="Label1" fontsize="-2" caption="번 앞 두자리" ly_vert="54,44,100,39,1" />
		<LABEL name="Label3" fgcolor="061:188030030" fontsize="-1" fontstyle="01" mask="0,0,[,],1,,0,0,0" ly_vert="20,107,50,39,1" import="0,1,7" />
