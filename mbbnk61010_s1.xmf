		<LABEL name="Label5" fgcolor="065:102102102" fontsize="-3" caption="공동(공인)인증서 비밀번호" ly_vert="5,196,165,39,1" />
		<EDIT name="Edit0" password="1" imetype="0" ly_vert="168,196,147,39,1" />
