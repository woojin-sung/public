'============================================================================
' 01. 화 면 명 : 권리예정내역
' 02. 화면설명 : 권리예정내역
' 03. 작    성 : 2022. 09. 20. 신극수
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData			'계좌번호,일련번호
Dim g_nTabIndex		'탭 Indexr
Dim g_gbn
Dim g_szScreenNo
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_nTabIndex = CInt(fmtab0.currenttab)
	'edtPW.visible = false
	edtPW.enable = false
	edtPW.visible= false 'v0001
	g_szData = acnt0.total & "★" & acnt0.sequence & "★" & ""
	Dim szScreenNo, szTab
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	'Form.MsgBox( "알림", g_szScreenNo, "", 6 )
	if g_szScreenNo == "83010" then
		imgInfo.visible = 1
		ImgMenu.left = 218
		lblTitle.caption = "유상청약 신청/조회"
		SetAcno()
		fmtab0.currenttab = 0
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약신청", g_szData )
		'fmtab0.deletePageIndex(2)
		'fmtab0.deletePageIndex(2)
		fmtab0.deletepage = "page004730" 
		fmtab0.deletepage = "page000243" 
		g_gbn = 1
'	elseif g_szScreenNo == "83000" then
'		imgInfo.visible = 1
'		ImgMenu.left = 248
'		lblTitle.caption = "보유주식권리(국내/해외)"
'		fmtab0.currenttab = 2
'		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "입출고", g_szData )
'		'fmtab0.deletePageIndex(0)
'		'fmtab0.deletePageIndex(0)
'		fmtab0.deletepage = "page001696" 
'		fmtab0.deletepage = "page005089" 
'		g_gbn = 2
	else
		imgInfo.visible = 1
		Select Case g_nTabIndex
		Case 0
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약신청", g_szData )
		Case 1
		    fmtab0.currenttab = 1
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약취소/내역", g_szData )
		Case 2
		    fmtab0.currenttab = 2
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "입출고", g_szData )
		Case 3
		    fmtab0.currenttab = 3
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "유상/매수청구", g_szData )
		end Select
		
	end if
	
	
	szOpen = Form.GetOpenLinkData()

	' ----------------------------------------------------------------------
	' 다른화면에서 화면오픈시
	' ----------------------------------------------------------------------	
	if szOpen <> "" then
		tData = Split(szOpen, "★")
		
		
		' 폼탭변경(0:청약신청, 1:청약취소/내역)
		if tData(0) = "0" then
			fmtab0.currenttab = 0
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약신청", g_szData )
		elseif tData(0) = "1" then
			fmtab0.currenttab = 1
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약취소/내역", g_szData )
		end if 
		'fmtab0.deletePageIndex(2)
		'fmtab0.deletePageIndex(2)
		fmtab0.deletepage = "page004730" 
		fmtab0.deletepage = "page000243" 
		g_gbn = 1
	end if 
		
	fmtab0.tabheadheight = 0
End Sub
'============================================================================
' SetAcno()
'============================================================================
Sub SetAcno()
	szCurAcc = Form.GetSharedData("ACNO_83010")

	nCnt = Cint(acnt0.accountcount)
	For i = 0 to nCnt - 1
		szCompAcc = acnt0.getAccountByIndex(i)
		
		if szCurAcc == szCompAcc then
			acnt0.currentindex = i
			g_szData = acnt0.total & "★" & acnt0.sequence & "★" & ""
			Exit For
		end if
	Next
End sub
'============================================================================
' fmtab0_OnTabChanged(nCurrentTab)
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	g_nTabIndex = nCurrentTab
	g_szData = acnt0.total & "★" & acnt0.sequence & "★" & edtPW.caption
	
	Select Case g_nTabIndex
		Case 0
			if g_gbn = 1 then
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약신청", g_szData )
			else 
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "입출고", g_szData )
			end if
		Case 1
		    fmtab0.currenttab = 1
			if g_gbn = 1 then
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약취소/내역", g_szData )
			else
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "유상/매수청구", g_szData )
			end if
	end Select
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()

	g_nTabIndex = CInt(fmtab0.currenttab)
	edtPW.caption = ""
	
	g_szData = acnt0.total & "★" & acnt0.sequence & "★" & ""
	
	Select Case g_nTabIndex
		Case 0
			if g_gbn = 1 then
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약신청", g_szData )
			else 
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "입출고", g_szData )
			end if
		Case 1
			if g_gbn = 1 then
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약취소/내역", g_szData )
			else
				Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "유상/매수청구", g_szData )
			end if
	end Select
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()
	
	g_szData = acnt0.total & "★" & acnt0.sequence & "★" & edtPW.caption
	
	Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약취소", g_szData )
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	fmtab0_OnTabChanged(g_nTabIndex)
	
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then '유의사항
		Form.OpenFramePopup("mbonl83010_p4", "", "")
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.OpenPrevScreen() 
End Sub

'============================================================================
Sub imgInfo_OnClick()
    'Form.OpenPopup("mbonl83000_p2" , "" , "")	
    Form.OpenPopup("mbonl83010_p6" , "" , "")	
End Sub

'20230907 KKM START 일반청약 메뉴의 화면들로 전환
'============================================================================
Sub lblTitle_OnClick()
	ImgMenu_OnClick()
End Sub

'============================================================================
Sub ImgMenu_OnClick()
	'ImgMenu.imgpath = "icon_arrow_up2.png"
	if g_szScreenNo == "83010" then
		Combo0.currentindex = 0
		Combo0.OpenList()	
	else
		Combo1.OpenList()	
	end if 
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 1 then   '반대의사/매수청구 신청
		Form.CloseForm()
		Form.OpenScreen("83140" , "")
	else ''유상청약 신청/조회
		ImgMenu.imgpath = "icon_arrow_down2.png"
	end if 
End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	if iIndex == 1 then  '보유CFD권리(국내/해외)
		Form.CloseForm()
		Form.OpenScreen("13402" , "")
	elseif iIndex == 2 then ' 전체권리일정조회(국내/해외)
		Form.CloseForm()
		Form.OpenScreen("16402" , "")
	else '보유주식권리(국내/해외)
		ImgMenu.imgpath = "icon_arrow_down2.png"
	end if 	
End Sub
'20230907 KKM END 

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")	
	ImgMenu.setMaintainingRatio("1")	
	imgInfo.setMaintainingRatio("1")	
End Sub

	</SCRIPT_INFO>
</ROOT>