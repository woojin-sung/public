		<EDIT name="edtPW" halign="1" password="2" imetype="1" maxlength="8" hintcaption="비밀번호" ly_vert="283,49,86,39,1" />
		<FORMTAB name="fmtab0" currenttab="3" tabcount="4" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="1,91,375,512,1" >
