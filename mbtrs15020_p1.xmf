'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 매매일지
' 02. 화면설명 : 매매일지 일별계좌수익률 차트
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'	계좌번호, 계좌일려번호, 시작일자, 종료일자, 시작년월, 종료년월, 당일평가금액, 일자구분
Dim g_szACNO, g_szASNO, g_szFromDay, g_szToDay, g_FromYear, g_ToYear, g_nVLTN_AMT, g_szType

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
' SetChartData()
'============================================================================
Function SetChartData(nCount)
	Dim szHeadName1, szHeadName2, szHeadName3 
	gTempDate = ""
	gTempData1 = ""
	gTempData2 = ""
	gTempData3 = ""

	szHeadName1 = grd0.GetCellTopCaption( "th_cell1" )

	If nCount = "0" Then
		szHeadName2 = grd0.GetCellTopCaption( "th_cell2" )
	ElseIf nCount = "1" Then
		szHeadName2 = grd0.GetCellTopCaption( "th_cell3" )
	ElseIf nCount = "2" Then
		szHeadName2 = grd0.GetCellTopCaption( "th_cell4" )
	End If

	for i = grd0.rowcount - 1 To 0 Step -1
		gTempDate = grd0.GetCellData( "bd_cell0" , i)&";"&gTempDate
		gTempData1 = grd0.GetCellData( "bd_cell1" , i)&";"&gTempData1
		
		If nCount = "0" Then
			gTempData2 = grd0.GetCellData( "bd_cell2" , i)&";"&gTempData2			
		ElseIf nCount = "1" Then
			gTempData2 = grd0.GetCellData( "bd_cell3" , i)&";"&gTempData2
		ElseIf nCount = "2" Then
			gTempData2 = grd0.GetCellData( "bd_cell4" , i)&";"&gTempData2
		End If		
	next
	
	ChartEx0.SetAccrueData("initdata="&gTempDate)
	ChartEx0.SetAccrueData("changetitle="&szHeadName1&";"&szHeadName2)		
	'ChartEx0.SetAccrueData("period=1=YYYYMMDD")
	ChartEx0.SetAccrueData("자료일자="&gTempDate)
	ChartEx0.SetAccrueData("data1="&gTempData1&"=2")
	ChartEx0.SetAccrueData("data2="&gTempData2&"=2")
	ChartEx0.SetAccrueData("repaintall");
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData

	szData 	= Form.GetOpenLinkData()
	
	If Trim(szData) = "" Then
		Exit Sub
	End If
	
	arrData = Split(szData, "|", -1, 1)
	
	If UBOUND(arrData) < 1 Then 'Data 없을때
		Exit Sub
	End If
	
	g_szACNO		= arrData(0)
	g_szASNO		= arrData(1)
	g_szFromDay	= arrData(2)
	g_szToDay	= arrData(3)
	g_FromYear	= arrData(4)
	g_ToYear		= arrData(5)
	g_nVLTN_AMT	= arrData(6)
	g_szType		= arrData(7)
	
	Form.SetScreenName( "일별수익률 차트")
	
	DATAMANAGER.RequestTranData( "ooase_erma_012r" )
	
	ChartEx0.SetAccrueName("누적거래량,KOSPI=1,1")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "ACNO" 			, 0 , g_szACNO 	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "ASNO" 			, 0 , g_szASNO 	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "STA_DATE" 		, 0 , g_szFromDay	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "FIN_DATE"		, 0 , g_szToDay 	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "STA_YYMM"		, 0 , g_FromYear 	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "FIN_YYMM"		, 0 , g_ToYear 	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "DATE_CLS_CODE"	, 0 , g_szType 	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "TDAY_VLTN_AMT"	, 0 , g_nVLTN_AMT	)
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "UI_CHCK_CLS" 	, 0 , "Y" 		)
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	For i = 0 To grd0.rowcount-1
		Dim nData
		nData = Round( CDbl(grd0.GetCellData( "bd_cell1", i )) / 1000000 , 2)
		
		grd0.SetCellData( "bd_cell1", i , nData)
	Next
	
	SetChartData( rdoMarket.currentindex )
End Sub

'============================================================================
Sub rdoMarket_OnClick(nIndex)	
	grd0.rowcount = 0
	
	DATAMANAGER.RequestTranData( "ooase_erma_012r" )
	
End Sub

'============================================================================
Sub ChartEx0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "ooase_erma_012r" )
End Sub

