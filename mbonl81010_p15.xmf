'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' getListItem(szInput, nIdx) : 해당하는 인덱스의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return ""
	else
		szList = split(szInput, "★")
		if szList <> "" then
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return ""
				end if
				
			else
				return ""
			end if
		else
			return ""
		end if 
	end if 
end function


''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
End Sub

'============================================================================
' imgClose_OnClick() : 화면 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnOK_OnClick()
'============================================================================
Sub btnOK_OnClick()
	if CDbl(rdoReason.currentindex) == -1 then
		Form.ShowAlert("알림", "재진단 사유를 선택해주세요")
		
	elseif CDbl(rdoReason.currentindex) == 2 and Len(edtReason.caption) <= 0 then
		Form.ShowAlert("알림", "기타 선택시 사유를 입력해주세요")
	else
		Dim szReasonCode, szReason
		szReasonCode = CDbl(rdoReason.currentindex) + 1
		szReason = edtReason.caption
		
		Form.SendReturnToParent("close_mbonl81010_p15" , szReasonCode & "★" & szReason )
		Form.CloseForm()
	end if
End Sub

'============================================================================
' btnCancel_OnClick()
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub rdoReason_OnClick(nIndex)
	' 기타 선택시 기타 선택 입력창 visible
	if CDbl(nIndex) == 2 then
		edtReason.enable = true
	else
		edtReason.enable = false
		edtReason.caption = ""
	end if
End Sub


	</SCRIPT_INFO>
</ROOT>