'===========================================================================
' 화  면  명 : 종목검색창_메인
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2015.04.22 이호철
' 수      정 : 2017.10.12 이재원
'===========================================================================
Dim g_tCmbData1
Dim g_tCmbData2
Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim g_szNext
g_tCmbData1 = "상해^심천^홍콩^뉴욕^아멕스^나스닥" '미/홍/중			
g_tCmbData2 = "도쿄^호치민^하노이" ' 일/베
g_nPage = 0
g_xPos  = ""
g_nIndex = 0
g_szNext = ""
'============================================================================
Sub Form_OnFormInit()
	Dim szCombo0
	Dim szCombo1
	
	szCombo0 = Form.GetEnvData("16030_S11_COMBO0")
	szCombo1 = Form.GetEnvData("16030_S11_COMBO1")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Form.SetCtlProp("Combo0",  "cbkeydata", szCombo0)
		SetControlNation()
	end if
	if szCombo1 <> nil and szCombo1 <> "" then
		Form.SetCtlProp("Combo1",  "cbkeydata", szCombo1)
	end if
	
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Combo1.bgimagetype = "1"
	
	DATAMANAGER.RequestTranData( "ohhts_6234_001r" ) 
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	DIm szMarket
	Dim szDelay
	
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	szCmb1 = Form.GetCtlProp( "Combo1",  "cbkeydata" ) 
	szDelay = ""
	
	if szCmb0 == "US" then
		if RadioGroup0.currentindex == "0" then
			szMarket = ""
		elseif RadioGroup0.currentindex == "1" then
			szMarket = "NY"
		elseif RadioGroup0.currentindex == "2" then
			szMarket = "AX"
		elseif RadioGroup0.currentindex == "3" then
			szMarket = "OQ"
		end if
		szDelay = Form.GetSharedData("REALTIME_NY", 0 ) '미국은 모두 동일하므로 뉴욕으로 통일
	elseif szCmb0 == "CN" then
		if RadioGroup1.currentindex == "0" then
			szMarket = "SH"
		elseif RadioGroup1.currentindex == "1" then
			szMarket = "SZ"
		end if
		szDelay = Form.GetSharedData("REALTIME_"..szMarket, 0 )
	else
		szMarket = szCmb0
		szDelay = Form.GetSharedData("REALTIME_"..szMarket, 0 )
	end if
	
	if szTranID == "ohhts_6234_001r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62340" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , szCmb0 )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , szMarket )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_BSTP_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , szCmb1 )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_VOL1" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_TR_PBMN" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_PRC1" , 0 , "" )

	end if 
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_6234_001r" then
		
		Dim nCount
		nCount    = CInt( DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ) )

		'Combo상태
		Dim szCmb1
		szCmb1 = Form.GetCtlProp( "Combo1",  "cbkeydata" )
		if szCmb1 == "0" or szCmb1 == "2" then
			Grid0.SetCellTopCaption("th_cell11", "순매수잔량" )
			Grid0.SetCellTopCaption("th_cell12", "순매수비율" )
		else
			Grid0.SetCellTopCaption("th_cell11", "순매도잔량" )
			Grid0.SetCellTopCaption("th_cell12", "순매도비율" )
		end if

		for i=0 to nCount-1
		
			Dim szNTBY, szNTBY_RATE, szNTSL, szNTSL_RATE
			szNTBY  		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_TOTAL_NTBY_ASPR_RSQN" , i)
			szNTBY_RATE	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_TOTAL_NTBY_ASPR_RSQN_RATE" , i)
			szNTSL  		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_TOTAL_NTSL_ASPR_RSQN" , i)
			szNTSL_RATE	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_TOTAL_NTSL_ASPR_RSQN_RATE" , i)

			' 순매수/매도 컬러 셋팅
			if szCmb1 == "0" or szCmb1 == "2" then
				Grid0.SetCellData("bd_cell15", g_nIndex + i, szNTBY)
				Grid0.SetCellData("bd_cell16", g_nIndex + i, szNTBY_RATE)
				Grid0.SetCellFgColor( "bd_cell15", g_nIndex + i, "1" )
			else
				Grid0.SetCellData("bd_cell15", g_nIndex + i, szNTSL)
				Grid0.SetCellData("bd_cell16", g_nIndex + i, szNTSL_RATE)
				Grid0.SetCellFgColor( "bd_cell15", g_nIndex + i, "2" )
			end if
			
			Dim szExid, szCode
			szExid  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
			szCode  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_ISCD" , i)

			Grid0.SetCellData("bd_cell7", g_nIndex + i, szExid.."@"..szCode)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , szExid.."@"..szCode )
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , szExid.."@"..szCode )
		next
		Grid0.keyall = "1"
'		DATAMANAGER.RequestRealData("ohhts_exst_cntg")
'		DATAMANAGER.RequestRealData("ohhts_exst_aspr")
		g_nIndex = CInt( Grid0.rowcount )
	end if
	
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_exst_aspr" then
		Dim szRealCode, nRealPrc, nChange, nSign, nRate
		szRealCode = DATAMANAGER.GetDataValue( 1, "ohhts_exst_aspr", "OutBlock1", "FIDXR_ISCD" , 0)
		nBuyT = CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_exst_aspr", "OutBlock1", "FIDXR_SHNU_ASPR_TOTAL_RSQN" , 0))
		nSelT = CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_exst_aspr", "OutBlock1", "FIDXR_SELN_ASPR_TOTAL_RSQN" , 0))

		for i=0 to g_nIndex-1
			Dim szCode, nPrc, szSign, nPoint
			szCode = Grid0.GetCellData("bd_cell7", i)
			nVolume = CDbl(Grid0.GetCellData("bd_cell8", i))
			nPoint = CInt(Grid0.GetCellData("bd_cell6", i))
			
			if szCode == szRealCode then
				
				Grid0.SetCellData("bd_cell15", i, nBuyT - nSelT)
				If nSelT <> 0 Then
					Grid0.SetCellData("bd_cell16", i, ( nBuyT / nSelT ) * 100)
				else
					Grid0.SetCellData("bd_cell16", i, 0)
				end If
				
				Exit Sub
			end if
		next
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S11_COMBO0", szComboData)
	
	SetControlNation()
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6234_001r" ) 
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo1",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S11_COMBO1", szComboData)
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6234_001r" ) 
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "ohhts_6234_001r" )
end Sub

'============================================================================
Function CInt(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Grid0_OnScrollEnd()
	'DATA값 (현재page / 전체page)
	Dim nTmpIndex
	Dim nPageTotal
	
	nTmpIndex  = CInt( Instr(1, g_xPos, "/") )
	nPageTotal = CInt( Mid(g_xPos, nTmpIndex+1, -1) )

	if g_nPage + 1 < nPageTotal then
		g_nPage = g_nPage + 1
		DATAMANAGER.RequestTranData( "ohhts_6234_001r" )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode
	Dim sKorname
	Dim sExid
	
	sCode 	= Grid0.GetCellData( "bd_cell11", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell0", lRow )
	sExid	= Grid0.GetCellData( "bd_cell6", lRow )
	
	if sCode <> "" then

		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sExid.."@"..sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")
		
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub SetControlNation()
	RadioGroup0.setCurIndexSilent("0")
	RadioGroup1.setCurIndexSilent("0")

	if Combo0.currentindex ==  "0" then
		RadioGroup0.visible = 1
		RadioGroup1.visible = 0
	elseif Combo0.currentindex ==  "1" then
		RadioGroup0.visible = 0
		RadioGroup1.visible = 1
	else
		RadioGroup0.visible = 0
		RadioGroup1.visible = 0
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	Form_OnRefresh()
End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	Form_OnRefresh()
End Sub
