'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szUserID
dim	g_szSelectedItem
dim	g_nMaxCnt
dim	g_szDelIns				'삭제인지 등록인지 판별하여 팝업출력체크	
dim	g_szItemCode,	g_szItemName	'종목검생창에서 가져온 코드, 이름

g_szUserID		= ""
g_szSelectedItem	= ""
g_szItemCode		= ""
g_szItemName		= ""
g_nMaxCnt		= 10			'Watching Max값
g_szDelIns		= "1"		'기본값 등록
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'checkReadyGrd	:	대기열에 존재하는지 체크
'============================================================================
Function checkReadyGrd(szInput)
		dim  nGrdCnt
		dim	bIsHit	'존재 flag
		
		nGrdCnt	=	grdReady01.rowcount				'Insert됐을시 값이 늘어나므로 계속 변경
		bIsHit	=	false
		
		'존재하는지 체크
		for	i = 0	to  nGrdCnt - 1
			nSavedItem	=	grdReady01.GetCellData("bd_code", i)
		
			if	trim(nSavedItem)	=  trim(szInput)	then		'존재하면 flag올림
				bIsHit	=	true
			end	if	
		next	
		
		return bIsHit
end function


'============================================================================
'SetWatchingList	:	설정된 값들을 Watching에 저장한다.
'============================================================================
Function	SetWatchingList()
	dim	nGrdCnt
	dim	szCode,	szName
	
	nGrdCnt 	=	0
	szCode	=	""
	szName	=	""
	
	nGrdCnt	=	grd01.rowcount
	
	DATAMANAGER.ClearInputData(0, "ohhts_watch_001")
	DATAMANAGER.SetDataValue(0, "ohhts_watch_001", "InBlock1", "FID_INPUT_WRTR_ID"  ,	0, g_szUserID)

	for	i = 0	to  nGrdCnt - 1
		szCode	=	grd01.GetCellData("bd_code", i)
		szName	=	grd01.GetCellData("bd_name", i)
		
	'	DATAMANAGER.SetDataValue(0, "ohhts_watch_001", "InBlock1", "FID_INPUT_WRTR_ID"  ,	0, g_szUserID)
		DATAMANAGER.SetDataValue(0, "ohhts_watch_001", "InBlock2", "FID_INPUT_RANK_SORT_CLS_CODE",	i, i+1)
		DATAMANAGER.SetDataValue(0, "ohhts_watch_001", "InBlock2", "FID_INPUT_OVRS_ISCD",	i, szCode)
		DATAMANAGER.SetDataValue(0, "ohhts_watch_001", "InBlock2", "FID_INPUT_SRCH_NAME",	i, szName)
	next

	DATAMANAGER.RequestTranData("ohhts_watch_001")
	 
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szLinkedData
	
	Form.SetScreenName("종목추가")
	lblMax01.caption	=	"최대 " & g_nMaxCnt & "개 종목 등록 가능합니다."
	grd01.rowmove = "1"
	
	szLinkedData	=	Form.GetOpenLinkData()
	
	if	len(trim(szLinkedData))	>	5	then
		g_szItemCode			=	szLinkedData
	else
		g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	end	if
		
	g_szItemName			=	Form.GetItemCodeInfo(g_szItemCode,	"name")
	ItemCode01.caption	=	g_szItemCode						'초기값	
		
	g_szUserID	=	Form.GetSharedData("&CUST_NUM", 0 )
	
	if	g_szUserID	<> null 	 and		len(trim(g_szUserID)) > 0	then
		DATAMANAGER.RequestTranData("ohhts_watch_003")	
	end	if

	if	acnt01.total	<>	null	 and  	len(trim(acnt01.total)) >	0	then
		DATAMANAGER.RequestTranData("obtrs_comn_411r")
	end	if
	
	
End Sub


'============================================================================
'grd01_OnClickUp
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	dim szCnt
	dim szItemName			'선택된 ITEM의 이름 

	g_szDelIns	=	"0"						'삭제플래그올림
	
	szCnt = grd01.rowcount
	
	if szCellID = "bd_del" then					' 삭제 기능 
		grd01.SetDeleteRow(lRow)
		
		if	g_szUserID	<> null 	 and		len(trim(g_szUserID)) > 0		then
			SetWatchingList()									'워칭리스트등록
		end if
	end if 
		
End Sub


'============================================================================
'acnt01_ChangeAccount
'============================================================================
Sub acnt01_ChangeAccount()
	DATAMANAGER.RequestTranData("obtrs_comn_411r")
End Sub


'============================================================================
'btnReg01_OnClick
'============================================================================
Sub btnReg01_OnClick()
	dim	nGrdCnt,	nSavedItem
	dim	nIdx
	dim	bIsIn

	nGrdCnt	=	0
	nIdx	 	= 	0
	nSavedItem	=""
	
	g_szDelIns	=	"1"			'등록플래그올림
	bIsIn		=	false		'등록되어있는 종목인지
	nGrdCnt	=	grd01.rowcount
	
	'1.	Max건 인지 체크
	if	CDbl(g_nMaxCnt)	<=	CDbl(nGrdCnt)	then
		Form.ShowAlert("알림", g_nMaxCnt & "건을 초과할 수 없습니다.")
		Exit	Sub
	end	if
	
	
	'2. 등록되어 있는지 체크
	for	i = 0	to  nGrdCnt - 1
		nSavedItem	=	grd01.GetCellData("bd_code", i)
	
		if	trim(nSavedItem)	=	trim(g_szItemCode)	then
			bIsIn = true
			Form.ShowAlert("알림", "이미 등록되어있는 종목입니다.")
			Exit	Sub
		end	if	
	next


	'3. 조건에 해당되지 않으면 INSERT 작업
	if	bIsIn =	false	then
		nIdx	 = grd01.rowcount
		grd01.insertrow	=	nIdx
	
	'Form.ShowAlert("test", nIdx &".."& g_szItemCode &".."& g_szItemName)
		grd01.SetCellData("bd_code", nIdx, g_szItemCode)
		grd01.SetCellData("bd_name", nIdx, g_szItemName)
	end	if
	
	if	g_szUserID	<> null 	 and		len(trim(g_szUserID)) > 0	then
		SetWatchingList()									'워칭리스트등록
	end if
End Sub


'============================================================================
'btnReg02_OnClick
'============================================================================
Sub btnReg02_OnClick()
	dim	nGrdCnt,	nSavedItem
	dim	nIdx
	dim	nMineCnt, szMineCd, szMineName, szTrsMineCd
	dim	bIsHit		'메인에존재하는가
	dim	bIsReadyHit	'대기열존재하는가
	dim	nHitCnt	'존재갯수
	dim	nReadyCnt '대기열갯수

	nGrdCnt		= 0
	nReadyCnt	= 0
	nIdx	 		= 0
	nSavedItem	= ""
	
	nMineCnt 	= 0
	szMineCd		= ""
	szTrsMineCd	= ""
	szMineName	= ""
	bIsHit	=	false
	nHitCnt	= 	0
	
	g_szDelIns	=	"1"			'등록플래그올림


	nMineCnt	=	grdMine01.rowcount
	nGrdCnt	=	grd01.rowcount
	
	grdReady01.SetClear()		'대기열삭제
	
	if	nMineCnt	=	"0"	then
		Form.ShowAlert("알림", "보유종목이 없습니다. 확인후 등록하시길 바랍니다.")
		exit	sub
	end	if
	
	'1. 등록되어 있는지 체크후 없으면 대기열에 INSERT
	for j = 0 to 	nMineCnt - 1
			
		szMineCd		=	grdMine01.GetCellData("bd_code", j)
		szMineName	=	grdMine01.GetCellData("bd_name", j)
			
		'2-1	비교가능대상으로 Convert
		if	len(szMineCd)	=	7	then
			szTrsMineCd	=	mid(szMineCd,2,6)		'A000660 에서 A제외
		else
			szTrsMineCd	=	szMineCd				'ETN 그대로 Q550016
		end if
			
			
		nGrdCnt	=	grd01.rowcount				'Insert됐을시 값이 늘어나므로 계속 변경
		bIsHit	=	false
		
		
		'2-2 Main에 존재하는지 체크
		for	i = 0	to  nGrdCnt - 1
			nSavedItem	=	grd01.GetCellData("bd_code", i)
		
			if	trim(nSavedItem)	=  trim(szTrsMineCd)	then		'존재하면 flag올림
				bIsHit	=	true
			end	if	
		next	
		
		
		'2-3	존재하지 않을시 입력 대기열에 있는지 확인후 삽입
		
		if	bIsHit	=	false	then				'존재하지 않을때 입력

			bIsReadyHit = checkReadyGrd(szTrsMineCd)	'대기열에 존재하는가
			
			if bIsReadyHit = false		then
				nIdx	 = grdReady01.rowcount
				grdReady01.insertrow	=	nIdx
				grdReady01.SetCellData("bd_code", nIdx, szTrsMineCd)
				grdReady01.SetCellData("bd_name", nIdx, szMineName)
			end	if
		end	if
		
	next
	
	'2. 현재 들어있는 COUNT와 대기열에 있는 COUNT가 MAX가 넘으면 팝업		
	nIdx	 	= grdReady01.rowcount
	nGrdCnt	=	grd01.rowcount

	
	if	CDbl(nIdx) + CDbl(nGrdCnt)	> g_nMaxCnt	then
		Form.OpenPopup("mhprc11020_pb", g_nMaxCnt , sPosInfo)
	else
	
		'3. 대기열 전부 main Insert
		for	i = 0 	to	nIdx - 1	
			nGrdCnt	 = grd01.rowcount
				
			szCode	=	grdReady01.GetCellData("bd_code", i)
			szName	=	grdReady01.GetCellData("bd_name", i)
					
			if	CDbl(nGrdCnt)	<	g_nMaxCnt	then		'MAX 넘지 않게만 입력
				grd01.insertrow	=	nGrdCnt
				grd01.SetCellData("bd_code", nGrdCnt, szCode)
				grd01.SetCellData("bd_name", nGrdCnt, szName)
				
				'20160817_01 LKM START
				szMk	 =  Form.GetItemCodeInfo(szCode, "market")
				szMk = f_ChkMarket(szMk, szCode)
				
				if Trim(szMk) == "" and Trim(szCode) <> "EMPTY" then
					grd01.SetCellFgColor("bd_code", i, "127")
					grd01.SetCellFgColor("bd_name", i, "127")		
				end if			
				
				'20160817_01 LKM END
				
			end	if
		next		
				
		'4. 실제 Watching 등록
		if	g_szUserID	<> null			then
			SetWatchingList()									'워칭리스트등록
		end if
	end	if
	


End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if	szTranID	=	"ohhts_watch_003"	then
		DATAMANAGER.SetDataValue(0, "ohhts_watch_003", "InBlock1", "FID_INPUT_WRTR_ID", 0, g_szUserID)
	elseif	szTranID	=	"ohhts_watch_004"	then
		DATAMANAGER.SetDataValue(0, "ohhts_watch_004", "InBlock1", "FID_INPUT_WRTR_ID", 0, g_szUserID)
	elseif	szTranID	=	"obtrs_comn_411r"	then
		DATAMANAGER.SetDataValue(0, "obtrs_comn_411r", "InBlock1", "ACNO", 0, acnt01.total)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_411r", "InBlock1", "ASNO", 0, acnt01.sequence)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_411r", "InBlock1", "IQRY_CLS_CODE", 0, "1")
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if	szTranID	=	"ohhts_watch_001"	then
		if	g_szDelIns	=	"1"	then			'등록일때만 팝업처리
			Form.ShowAlert("알림", "Watching종목으로 등록되었습니다.")
		end	if
		DATAMANAGER.RequestTranData("ohhts_watch_003")
		
	'20160817_01 LKM START-MTS미제공 종목 폰트색상 회색 적용
	elseif szTranID = "ohhts_watch_003"	then
		
		for i = 0 To grd01.rowcount-1
			szCd = grd01.GetCellData("bd_code", i)
			szMk	=  Form.GetItemCodeInfo(szCd, "market")
			szMk = f_ChkMarket(szMk, szCd)
			
			if Trim(szMk) == "" and Trim(szCd) <> "EMPTY" then
				grd01.SetCellFgColor("bd_code", i, "127")
				grd01.SetCellFgColor("bd_name", i, "127")		
			end if
		next
	'20160817_01 LKM END
	
	end	if
End Sub

'20160817_01 LKM START
'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "O", "MO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY"
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
End Function
'20160817_01 LKM END
'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'ItemCode01_OnEditComplete
'============================================================================
Sub ItemCode01_OnEditComplete(sCode)
	
	g_szItemCode		=	sCode
	g_szItemName		=	Form.GetItemCodeInfo(sCode,	"name")
	
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	SetWatchingList()
	Form.SendReturnToParent("REFRESH_11020" , sData)
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim	nReadyCnt		'대기열갯수
	dim	nMainCnt			'메인열갯수
	dim	nDelCnt			'지울갯수
	dim	nIdx				'Main Watching List Index
	dim	nDelIdx			'지워야할 Index
	dim	szCode, szName	'대기열 코드, 대기열 이름
	
	nReadyCnt	= 0
	nMainCnt		= 0
	nDelCnt		= 0
	nIdx			= 0
	nDelIdx		= 0
	szCode		= ""
	szName		= ""
	
	if	sKeyName	=	"mhprc11010_pb"	then
		if	sRet	=	"ok"	then
				
				nReadyCnt	=	grdReady01.rowcount			'대기열 갯수 가져옴
				nMainCnt		=	grd01.rowcount
				
				'1 지워야할 카운트 파악
				nDelCnt	=	(nMainCnt + nReadyCnt) - g_nMaxCnt
				
				if	nDelCnt	>=	g_nMaxCnt	then
					nDelCnt	=	nMainCnt
				end	if
				
						
				'2. 대기열이 전부 들어가도록 Main을 뒤에서 부터 지움
				nDelIdx	=	nMainCnt - 1 
				
				for	i = 0 to nDelCnt -1 
					grd01.SetDeleteRow(nDelIdx)
					nDelIdx = nDelIdx - 1
				next
				
				
				'3. 대기열 전부 main Insert
				for	i = 0 	to	nReadyCnt - 1	
					nIdx	 = grd01.rowcount
					
					szCode	=	grdReady01.GetCellData("bd_code", i)
					szName	=	grdReady01.GetCellData("bd_name", i)
					
					if	CDbl(nIdx)	<	g_nMaxCnt	then		'MAX 넘지 않게만 입력
						grd01.insertrow	=	nIdx
						grd01.SetCellData("bd_code", nIdx, szCode)
						grd01.SetCellData("bd_name", nIdx, szName)
					end	if
				next		
				
				
				'4. 실제 Watching 등록
				if	g_szUserID	<> null			then
					SetWatchingList()									'워칭리스트등록
				end if
		end	if
	end	if
	
End Sub



