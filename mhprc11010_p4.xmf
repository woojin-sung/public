'============================================================================
Sub Container0_btnOK_OnClick()
	If g_Opendata <> "HELP_POPUP" then '2021110 HSZ 
		Form.SaveConfigData("mhprc11011", "mhprc11010_p4", Container0.chk0.checkstate )
	end if '	20211110 HSZ 
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
'	2021110 HSZ START - 화면메뉴 오픈 추가
	g_Opendata = Form.GetOpenLinkData()
	if g_Opendata = "HELP_POPUP" then
		Container0.chk0.visible = false
	end if
'	20211110 HSZ END
End Sub

	</SCRIPT_INFO>
