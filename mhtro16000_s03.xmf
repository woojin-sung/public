'============================================================================
Sub contMain_imgTooltip0_OnClick()
	sText = "특정 자산의 비율이 100%를 초과할 수 있습니다.\n(롱숏전략형 펀드, 인버스/리버스 펀드, 공매도 전략을 추구하는 펀드 등)"
	contMain.imgTooltip0.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.imgTooltip0.openToolTip( sText, 350, 100, 2 )
	else
		contMain.imgTooltip0.openToolTip( sText, 300, 100, 2 )
	end if
	
	
End Sub
