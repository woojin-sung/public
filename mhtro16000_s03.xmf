Function Init_Control()
	g_nCommFontSize = Form.getEnvData("common.textsize")
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle1.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle1.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle2.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle2.paddinginfo = "0,0,0,0"
	
	contMain.lblLine1.bgcolor = g_szLineColor2
	contMain.lblDiv0.bgcolor = g_szLineColor3
	contMain.lblDiv1.bgcolor = g_szLineColor3
	contMain.lblDiv2.bgcolor = g_szLineColor3
	
	contMain.imgIcon0.setMaintainingRatio("1")
	contMain.imgIcon1.setMaintainingRatio("1")
	contMain.imgIcon2.setMaintainingRatio("1")
	contMain.imgIcon3.setMaintainingRatio("1")
	contMain.imgIcon4.setMaintainingRatio("1")
	
	contMain.lblExpand.fgcolor = g_szTxtColor_Grey
	contMain.lblExpand.paddinginfo = "0,0,0,0"
	
	contMain.lblEmpty.paddinginfo = "0,0,0,0"
	contMain.lblEmpty.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty.visible = false
	
	contMain.imgEmpty.imgpath = "icon_noti"
	contMain.imgEmpty.maintainratio = "1"
	contMain.imgEmpty.visible = false
	
	contMain.lblEmpty0.paddinginfo = "0,0,0,0"
	contMain.lblEmpty0.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty0.visible = false
	
	contMain.imgEmpty0.imgpath = "icon_noti"
	contMain.imgEmpty0.maintainratio = "1"
	contMain.imgEmpty0.visible = false
	
	contMain.lblEmpty1.paddinginfo = "0,0,0,0"
	contMain.lblEmpty1.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty1.visible = false
	
	contMain.imgEmpty1.imgpath = "icon_noti"
	contMain.imgEmpty1.maintainratio = "1"
	contMain.imgEmpty1.visible = false
	
	contMain.imgTooltip0.setMaintainingRatio("2")
	contMain.imgTooltip0.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("자산별 비중", 0, true, false)
	contMain.imgTooltip0.left = 20 + nTextWidth + 5
	
'	contMain.lblSubTitle0.setNeighborCtlPos("imgTooltip0", "right", 5, "자산별 비중")
	
'	szOsType = Form.GetSharedData("&OS_TYPE", false )
'	if szOsType = "1" then
'		contMain.ChartEx0.top = 69
'		contMain.ChartEx0.height = 40
'		
