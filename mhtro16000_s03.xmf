'		contMain.ChartEx3.height = 40
'		
'		contMain.ChartEx4.top = 229
'		contMain.ChartEx4.height = 40
'	end if
End Function

Function Clear_Data()
	contMain.ChartEx0.SetDataClear("")
	contMain.ChartEx1.SetDataClear("")
	contMain.ChartEx2.SetDataClear("")
	contMain.ChartEx3.SetDataClear("")
	contMain.ChartEx4.SetDataClear("")
'	contMain.ChartEx5.SetDataClear("")
'	contMain.ChartEx6.SetDataClear("")
	
	contMain.ChartEx0.visible = false
	contMain.ChartEx1.visible = false
	contMain.ChartEx2.visible = false
	contMain.ChartEx3.visible = false
	contMain.ChartEx4.visible = false
	contMain.ChartEx5.visible = false
	contMain.ChartEx6.visible = false

	for i = 0 to 4
		Form.SetCtlProp("contMain.imgIcon"..i, "visible", false)
		Form.SetCtlProp("contMain.lblItemNm"..i, "caption", "")
		contMain.tbl1.SetCellString(i+1, 2, "")
	next

End Function


Function RequestTranData_tbl0(szData0, szData1)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_006r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 ,szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 ,szData1)
	
	DATAMANAGER.RequestTranData("ohhts_metf_006r")
End Function

Function ResponseTranData_tbl0()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_006r", "OutBlock1")
	if Cint(nDataCnt) > 5 then
		nDataCnt = 5
	end if

	for i = 0 to nDataCnt-1
		szItem0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_OVRS_ISCD" , i)
		szItem1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FIDX_KOR_ISNM", i)
		szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_RLIM", i)
		szItem3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i)
		szItem4 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_Y1_ERT" , i)
		szItem5 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_LSTN_NTNL_CODE", i)
		
		szTranID = ""
		
		if szItem3 = "J" then
			szTranID = "ohhts_5010_001r"
		else
			szTranID = "ohhts_5041_001r"
		end if
		
		if i <> 0 then
			szTranID = szTranID&"_"&i
		end if
		
		sGroupID = ""
		if szItem3 = "AX" or szItem3 = "NY" or szItem3 = "OQ" then
			sGroupID = "CI_USD"
		elseif szItem3 = "JP" then
			sGroupID = "CI_JPN"
		elseif szItem3 = "SH" or szItem3 = "SZ" then
			sGroupID = "CI_CHN"
		elseif szItem3 = "HK" then
			sGroupID = "CI_HKG"
		else
			sGroupID = "CI_KOR"
		end if
		
		szImgNm = Form.getIconImg(sGroupID, szItem0)
		
		if szImgNm = "" then
			szImgNm = Form.getIconImg("FLAG", szItem5)
			
			if szImgNm = "" then
				szImgNm = "flag_general"
			end if
			
'			if szItem3 = "AX" or szItem3 = "NY" or szItem3 = "OQ" then
'				szImgNm = Form.getIconImg("FLAG", "USA")
'			elseif szItem3 = "JP" then
'				szImgNm = Form.getIconImg("FLAG", "JPN")
'			elseif szItem3 = "SH" or szItem3 = "SZ" then
'				szImgNm = Form.getIconImg("FLAG", "CHN")
'			elseif szItem3 = "HK" then
'				szImgNm = Form.getIconImg("FLAG", "HKG")
'			elseif szItem3 = "J" then
'				szImgNm = Form.getIconImg("FLAG", "KOR")
'			else
'				szImgNm = "flag_general"
'			end if
		end if
	
		Form.SetCtlProp("contMain.ChartEx"..i, "visible", true)
		Form.SetCtlProp("contMain.imgIcon"..i, "visible", true)
		Form.SetCtlProp("contMain.imgIcon"..i, "imgpath", szImgNm)
		
		RequestTranData_ChartEx0(szTranID, szItem0, szItem3)
		'contMain.tbl1.setCellMultiLine(i+1, 1, true)
'		contMain.tbl1.setCellMaxLineCount(i+1, 1, 1)
'		contMain.tbl1.SetCellString(i+1, 1, szItem1)
		
		Form.SetCtlProp("contMain.lblItemNm"&i, "paddinginfo", "10,0,3,0")
		Form.SetCtlProp("contMain.lblItemNm"&i, "maxlinecnt", "1^-4")
		Form.SetCtlProp("contMain.lblItemNm"&i, "caption", szItem1)
		
		Form.SetCtlProp("contMain.lblItemCd"&i, "caption", szItem0)
		Form.SetCtlProp("contMain.lblMktCd"&i, "caption", szItem3)
		
		contMain.tbl1.SetCellString(i+1, 2, szItem2)
	next
	
	nEmptyCnt = 5 - nDataCnt

	contMain.lblBlock0.top = 275 - (nEmptyCnt*40)
	contMain.lblBlock0.height = nEmptyCnt*40
	contMain.lblDiv1.top = 305 - (nEmptyCnt*40)
	
	if nDataCnt = 0 then
		g_nReduce1 = 338
		
'		contMain.lblEmpty.visible = true
'		contMain.imgEmpty.visible = true

		contMain.lblSubTitle0.visible = false
		
		contMain.lblExpand.visible = false
		contMain.lblLine1.visible = false
		contMain.tbl1.visible = false
		contMain.lblDiv1.visible = false
	else
		g_nReduce1 = nEmptyCnt*40
		
'		contMain.lblEmpty.visible = false
'		contMain.imgEmpty.visible = false
	end if 
	
	szItem5 = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_STND_DATE", 0)
	
	if szItem5 <> "" and cint(szItem5) <> 0  then
		szYear = left(szItem5,4)
		szMonth = mid(szItem5,5,2)
		szDay = right(szItem5,2)
		contMain.lblSubTitle0.caption = "구성종목 비중 ("&szYear&"."&szMonth&"."&szDay&"기준)"

		contMain.lblSubTitle0.changeTextAttr(0,7,334,0,true)
	
		contMain.lblSubTitle0.changeTextAttr(7,15,333,-6,true)
	end if
End Function


Function RequestTranData_ChartEx0(szTranID, szData0, szData1)
	
	DATAMANAGER.ClearInputData(0, szTranID)
	
	if szData1 <> "J" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , szData0 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , szData1)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_OVRS_ISCD" , 0 , szData0 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_COND_MRKT_CLS_CODE" , 0 , szData1)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, "1" )
		
		szDate = Form.GetSharedData("&HOST_DATE", false)
	
		szYear = left(szDate, 4)
		szMonth = mid(szDate, 5, 2) 
		szDay = right(szDate, 2)
		
		szYear = cint(szYear) - 1
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE1" ,0, szYear..szMonth..szDay )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE2" ,0, szDate)	
	else
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,szData1)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0,szData0)
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,szData1)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD" , 0,szData0)

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, "1" )

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 
		
		szDate = Form.GetSharedData("&HOST_DATE", false)
	
		szYear = left(szDate, 4)
		szMonth = mid(szDate, 5, 2) 
		szDay = right(szDate, 2)
		
		szYear = cint(szYear) - 1
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE1" ,0, szYear..szMonth..szDay )
		
	
	end if
	
	DATAMANAGER.RequestTranData(szTranID)
End Function



Function RequestTranData_ChartEx5(szData0, szData1)
	g_szData_Title_Cht5 = ""
	g_szData_Rate_Cht5 = ""
	g_szData_ColorSet = ""
	
	DATAMANAGER.ClearInputData(0, "ohhts_metf_014r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_014r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_014r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	
	DATAMANAGER.RequestTranData("ohhts_metf_014r")
End Function

Function ResponseTranData_ChartEx5()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_014r", "OutBlock2")
	g_szData_Title_Cht5 = ""
	g_szData_Rate_Cht5 = ""
	g_szData_ColorSet = ""
	
	szDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_014r", "OutBlock1", "FID_STND_DATE", 0)
	
	if szDate <> "" and cint(szDate) <> 0 then
		szYear = left(szDate,4)
		szMonth = mid(szDate,5,2)
		szDay = right(szDate,2)
		contMain.lblSubTitle1.caption = "섹터별 비중 ("&szYear&"."&szMonth&"."&szDay&"기준)"
		contMain.lblSubTitle1.changeTextAttr(0,6,334,0,true)
		contMain.lblSubTitle1.changeTextAttr(6,15,333,-6,true)
	end if
	
	if nDataCnt = 0 then
		contMain.lblEmpty0.visible = true
		contMain.imgEmpty0.visible = true
	else
		contMain.lblEmpty0.visible = false
		contMain.imgEmpty0.visible = false
	end if
	
	for i = 0 to nDataCnt-1
	
		
		szItem0 = DATAMANAGER.GetDataValue(0,"ohhts_metf_014r", "OutBlock2", "FIDX_ETF_SECT_DIV_CODE" , i)
		szItem1 = DATAMANAGER.GetDataValue(0,"ohhts_metf_014r", "OutBlock2", "FIDX_ETF_SECT_NAME" , i)
		szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_014r", "OutBlock2", "FID_RLIM", i)
		
		if i <> 0 then
			g_szData_Title_Cht5 = g_szData_Title_Cht5 & ";"
			g_szData_Rate_Cht5 = g_szData_Rate_Cht5 & ";"
		end if
		
		
		g_szData_Title_Cht5 = g_szData_Title_Cht5 & szItem1
		g_szData_Rate_Cht5 = g_szData_Rate_Cht5 & szItem2
		
		
		szColor = GetSectorRGB(szItem1)
		if i <> 0 then
			g_szData_ColorSet = g_szData_ColorSet & ";"
		end if
		g_szData_ColorSet = g_szData_ColorSet & szColor
	next
End Function

Function RequestTranData_ChartEx6(szData0, szData1)
	g_szData_Title_Cht6 = ""
	g_szData_Rate_Cht6 = ""
	
	DATAMANAGER.ClearInputData(0, "ohhts_metf_015r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_015r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_015r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	
	DATAMANAGER.RequestTranData("ohhts_metf_015r")
End Function


Function ResponseTranData_ChartEx6()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_015r", "OutBlock2")
	
	
	g_szData_Title_Cht6 = ""
	g_szData_Rate_Cht6 = ""
	
	szDate = DATAMANAGER.GetDataValue(0,"ohhts_metf_015r", "OutBlock1", "FID_STND_DATE", 0)
	
	if szDate <> "" and cint(szDate) <> 0 then
		szYear = left(szDate,4)
		szMonth = mid(szDate,5,2)
		szDay = right(szDate,2)

		contMain.lblSubTitle2.caption = "자산별 비중       ("&szYear&"."&szMonth&"."&szDay&"기준)"

		
		contMain.lblSubTitle2.changeTextAttr(0,6,334,0,true)
		contMain.lblSubTitle2.changeTextAttr(12,15,333,-6,true)
	end if
	
'	if nDataCnt = 0 then
'		contMain.lblEmpty1.visible = true
'		contMain.imgEmpty1.visible = true
'	else
'		contMain.lblEmpty1.visible = false
'		contMain.imgEmpty1.visible = false
'	end if

	for i = 0 to nDataCnt-1
		
		szItem1 = DATAMANAGER.GetDataValue(0,"ohhts_metf_015r", "OutBlock2", "FIDX_ETF_SECT_NAME" , i)
		szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_015r", "OutBlock2", "FID_RLIM", i)
		
		if i <> 0 then
			g_szData_Title_Cht6 = g_szData_Title_Cht6 & ";"
			g_szData_Rate_Cht6 = g_szData_Rate_Cht6 & ";"
		end if
		
		g_szData_Title_Cht6 = g_szData_Title_Cht6 & szItem1
		g_szData_Rate_Cht6 = g_szData_Rate_Cht6 & szItem2
		
		szColor = GetSectorRGB2(szItem1)
		if i <> 0 then
			g_szData_ColorSet2 = g_szData_ColorSet2 & ";"
		end if
		g_szData_ColorSet2 = g_szData_ColorSet2 & szColor
	next

End Function

'============================================================================
Function GetSectorRGB(sName)
	
	if sName == "IT" then
		return "246,248,168"
	elseif sName == "커뮤니케이션" or sName == "커뮤니케이션서비스" or sName == "정보통신" then
		return "254,226,196"
	elseif sName == "금융" then
		return "254,206,209"
	elseif sName == "헬스케어" then
		return "244,190,234"
	elseif sName == "에너지" then
		return "209,186,244"
	elseif sName == "소재" then
		return "185,181,241"
	elseif sName == "산업재" then
		return "168,177,229"
	elseif sName == "경기소비재" then
		return "128,188,245"
	elseif sName == "필수소비재" then
		return "121,211,225"
	elseif sName == "유틸리티" then
		return "136,232,209"
	elseif sName == "부동산" then
		return "186,245,192"
	else
		return "229,229,229"
	end if

End Function

Function GetSectorRGB2(sName)
	
	if sName == "채권" then
		return "246,248,168"
	elseif sName == "현금" then
		return "254,226,196"
	elseif sName == "주식" then
		return "254,206,209"
	elseif sName == "우선주" then
		return "244,190,234"
	elseif sName == "전환" then
		return "209,186,244"
'	elseif sName == "소재" then
'		return "185,181,241"
'	elseif sName == "산업재" then
'		return "168,177,229"
'	elseif sName == "경기소비재" then
'		return "128,188,245"
'	elseif sName == "필수소비재" then
'		return "121,211,225"
'	elseif sName == "유틸리티" then
'		return "136,232,209"
'	elseif sName == "부동산" then
'		return "186,245,192"
	else
		return "229,229,229"
	end if

End Function

Function Resize_Layout()
	if g_isEmpty_014r = false and g_isEmpty_015r = false then
		g_nReduce2 = g_nReduce1
		
		if Form.GetSharedData("&OS_TYPE", false) = "1" then
			contMain.lblSubTitle1.top 	= Form.calcUnResize(contMain.lblSubTitle1.top, 1) - g_nReduce1
			contMain.Image0.top 		= Form.calcUnResize(contMain.Image0.top, 1) - g_nReduce1
			contMain.ChartEx5.top 		= g_nChartEx5_Top - g_nReduce1
			contMain.imgEmpty0.top 	= Form.calcUnResize(contMain.imgEmpty0.top, 1) - g_nReduce1
			contMain.lblEmpty0.top 	= Form.calcUnResize(contMain.lblEmpty0.top, 1) - g_nReduce1
			
			contMain.lblDiv2.top 	= Form.calcUnResize(contMain.lblDiv2.top, 1) - g_nReduce1
			
			contMain.lblSubTitle2.top 	= Form.calcUnResize(contMain.lblSubTitle2.top, 1) - g_nReduce2
			contMain.imgTooltip0.top 	= Form.calcUnResize(contMain.imgTooltip0.top, 1) - g_nReduce2
			contMain.ChartEx6.top 		= g_nChartEx6_Top - g_nReduce2
			contMain.imgEmpty1.top 	= Form.calcUnResize(contMain.imgEmpty1.top, 1) - g_nReduce2
			contMain.lblEmpty1.top 	= Form.calcUnResize(contMain.lblEmpty1.top, 1) - g_nReduce2
			
			contMain.lblDiv0.top 	= Form.calcUnResize(contMain.lblDiv0.top, 1) - g_nReduce2
	
		else
			contMain.lblSubTitle1.top 	= contMain.lblSubTitle1.top - g_nReduce1
			contMain.Image0.top 		= contMain.Image0.top - g_nReduce1
			contMain.ChartEx5.top 		= g_nChartEx5_Top - g_nReduce1
			contMain.imgEmpty0.top 	= contMain.imgEmpty0.top - g_nReduce1
			contMain.lblEmpty0.top 	= contMain.lblEmpty0.top - g_nReduce1
			
			contMain.lblDiv2.top 	= contMain.lblDiv2.top - g_nReduce1
			
			contMain.lblSubTitle2.top 	= contMain.lblSubTitle2.top - g_nReduce2
			contMain.imgTooltip0.top 	= contMain.imgTooltip0.top - g_nReduce2 
			contMain.ChartEx6.top 		= g_nChartEx6_Top - g_nReduce2
			contMain.imgEmpty1.top 	= contMain.imgEmpty1.top - g_nReduce2
			contMain.lblEmpty1.top 	= contMain.lblEmpty1.top - g_nReduce2
			
			contMain.lblDiv0.top 	= contMain.lblDiv0.top - g_nReduce2
		end if
		
	elseif g_isEmpty_014r = true and g_isEmpty_015r = false then
		g_nReduce2 = g_nReduce1 + 238
		
		contMain.lblSubTitle1.visible 	= false
		contMain.Image0.visible 		= false
		contMain.ChartEx5.visible 		= false
		contMain.imgEmpty0.visible 	= false
		contMain.lblEmpty0.visible 	= false
		contMain.lblDiv2.visible 		= false
		
		if Form.GetSharedData("&OS_TYPE", false) = "1" then
			contMain.lblSubTitle2.top 	= Form.calcUnResize(contMain.lblSubTitle2.top, 1) - g_nReduce2
			contMain.imgTooltip0.top 	= Form.calcUnResize(contMain.imgTooltip0.top, 1) - g_nReduce2
			contMain.ChartEx6.top 		= g_nChartEx6_Top - g_nReduce2
			contMain.imgEmpty1.top 	= Form.calcUnResize(contMain.imgEmpty1.top, 1) - g_nReduce2
			contMain.lblEmpty1.top 	= Form.calcUnResize(contMain.lblEmpty1.top, 1) - g_nReduce2
			contMain.lblDiv0.top 	= Form.calcUnResize(contMain.lblDiv0.top, 1) - g_nReduce2
		else
			contMain.lblSubTitle2.top 	= contMain.lblSubTitle2.top - g_nReduce2
			contMain.imgTooltip0.top 	= contMain.imgTooltip0.top - g_nReduce2 
			contMain.ChartEx6.top 		= g_nChartEx6_Top - g_nReduce2
			contMain.imgEmpty1.top 	= contMain.imgEmpty1.top - g_nReduce2
			contMain.lblEmpty1.top 	= contMain.lblEmpty1.top - g_nReduce2
			contMain.lblDiv0.top 	= contMain.lblDiv0.top - g_nReduce2
		end if
		
	elseif g_isEmpty_014r = false and g_isEmpty_015r = true then
		g_nReduce2 = g_nReduce1 + 157
		
		if Form.GetSharedData("&OS_TYPE", false) = "1" then
			contMain.lblSubTitle1.top 	= Form.calcUnResize(contMain.lblSubTitle1.top, 1) - g_nReduce1
			contMain.Image0.top 		= Form.calcUnResize(contMain.Image0.top, 1) - g_nReduce1
			contMain.ChartEx5.top 		= g_nChartEx5_Top - g_nReduce1
			contMain.imgEmpty0.top 	= Form.calcUnResize(contMain.imgEmpty0.top, 1) - g_nReduce1
			contMain.lblEmpty0.top 	= Form.calcUnResize(contMain.lblEmpty0.top, 1) - g_nReduce1
			contMain.lblDiv2.top 		= Form.calcUnResize(contMain.lblDiv2.top, 1) - g_nReduce1
			
		else
			contMain.lblSubTitle1.top 	= contMain.lblSubTitle1.top - g_nReduce1
			contMain.Image0.top 		= contMain.Image0.top - g_nReduce1
			contMain.ChartEx5.top 		= g_nChartEx5_Top - g_nReduce1
			contMain.imgEmpty0.top 	= contMain.imgEmpty0.top - g_nReduce1
			contMain.lblEmpty0.top 	= contMain.lblEmpty0.top - g_nReduce1
			contMain.lblDiv2.top 		= contMain.lblDiv2.top - g_nReduce1
		end if
		
		contMain.lblSubTitle2.visible 	= false
		contMain.imgTooltip0.visible 	= false
		contMain.ChartEx6.visible 		= false
		contMain.imgEmpty1.visible 	= false
		contMain.lblEmpty1.visible 	= false
		contMain.lblDiv0.visible 		= false
	else 
		g_nReduce2 = g_nReduce1 + 395
	end if 
	
	g_isEmpty_014r = false
	g_isEmpty_015r = false
	
	Form.triggerEvent("#", "CHANGE_LAYOUT_S3", 735 - g_nReduce2)
End Function

Function MoveScreen(nGbn) 
	szItemCd = Form.GetCtlProp("contMain.lblItemCd"&nGbn, "caption")
	szMktCd = Form.GetCtlProp("contMain.lblMktCd"&nGbn, "caption")

	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			szItemCd = szMktCd & "@" & szItemCd
			
			szItemNm = Form.GetItemCodeInfo(szItemCd, "name")
			if szItemNm = "" or szItemNm = null then
				Form.Toast(2, "주식(국내/해외)만 현재가 연동이 가능합니다.", 0)
				exit Function
			end if
			
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )
			if g_szScreenNo <> "16000" and g_szScreenNo <> "16100" then
				if g_szScreenNo = "11000" then
					Form.OpenScreen("16000","")	
				elseif g_szScreenNo == "13100" then
					Form.OpenScreen("16100","")	
				end if
			end if
			'Form.OpenScreen("16000", szItemCd)	
			
	'			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", szItemCd)
		Case Else
			szItemNm = Form.GetItemCodeInfo(szItemCd, "name")
			if szItemNm = "" or szItemNm = null then
				Form.Toast(2, "주식(국내/해외)만 현재가 연동이 가능합니다.", 0)
				exit Function
			end if
			
			Form.OpenScreen("11000", szItemCd)

'			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", "J@"&szItemCd)
	End Select

End Function
