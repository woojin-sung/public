'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
	Init_Control()
	
	contMain.ChartEx0.SetChartType("line")
	contMain.ChartEx1.SetChartType("line")
	contMain.ChartEx2.SetChartType("line")
	contMain.ChartEx3.SetChartType("line")
	contMain.ChartEx4.SetChartType("line")
	contMain.ChartEx5.SetChartType("pie")
	
	contMain.ChartEx6.SetChartType("horizontalstack")

End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	contMain.ChartEx0.SetUseLineAnimation("1")
	contMain.ChartEx0.SetUseCircleAnimation("1")
	contMain.ChartEx0.SetLineColor("종가;153;153;153")
	
	contMain.ChartEx1.SetUseLineAnimation("1")
	contMain.ChartEx1.SetUseCircleAnimation("1")
	contMain.ChartEx1.SetLineColor("종가;153;153;153")
	
	contMain.ChartEx2.SetUseLineAnimation("1")
	contMain.ChartEx2.SetUseCircleAnimation("1")
	contMain.ChartEx2.SetLineColor("종가;153;153;153")
	
	contMain.ChartEx3.SetUseLineAnimation("1")
	contMain.ChartEx3.SetUseCircleAnimation("1")
	contMain.ChartEx3.SetLineColor("종가;153;153;153")
	
	contMain.ChartEx4.SetUseLineAnimation("1")
	contMain.ChartEx4.SetUseCircleAnimation("1")
	contMain.ChartEx4.SetLineColor("종가;153;153;153")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		if instr(sParam, "@") > 0 then
			Clear_Data()
			g_szItemCd = sParam
			g_szExidCd = ""
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 
			g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			
			RequestTranData_tbl0(g_szOnlyCd,g_szExidCd)
			RequestTranData_ChartEx5(g_szOnlyCd,g_szExidCd)
			RequestTranData_ChartEx6(g_szOnlyCd, g_szExidCd)
	
		else
			Clear_Data()
			g_szItemCd = sParam
			g_szExidCd = "J"
			g_szOnlyCd = sParam
			RequestTranData_tbl0(g_szItemCd,"J")
			RequestTranData_ChartEx5(g_szItemCd,"J")
			RequestTranData_ChartEx6(g_szItemCd,"J")
		end if
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_006r" then
		ResponseTranData_tbl0()
		
		g_is006r = true
		
		if g_is006r = true and g_is014r = true and g_is015r = true then
			g_is006r = false
			g_is014r = false
			g_is015r = false
			
			
			Resize_Layout()
		end if
	elseif szTranID = "ohhts_metf_014r" then
		ResponseTranData_ChartEx5()
		
		if g_szData_Title_Cht5 <> "" then
			contMain.ChartEx5.visible = true
			'타이틀 & 데이터(비중)
			szChartData = g_szData_Title_Cht5&"="&g_szData_Rate_Cht5
			
			'컬러타입
			szChartData = szChartData & "=" &"0"
			'정렬
			szChartData = szChartData & "=" &"right"
			'툴팁
			szChartData = szChartData & "=" &"N"
			'형식
			szChartData = szChartData & "="
			'텍스트 색상값
			szChartData = szChartData & "="
			szChartData = szChartData & "=" & g_szData_ColorSet
			'원 비율
			szChartData = szChartData & "=" & "0.5"
			'구분선 굵기
			szChartData = szChartData & "=" & "2"
			'해당값 이상만 그리기
			szChartData = szChartData & "=" & "0"
			'애니메이션 유무
			szChartData = szChartData & "=" & "false"
			'강조유무
			szChartData = szChartData & "=" & "true"
			'툴팁유무
			szChartData = szChartData & "=" & "false"
