'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode, listlocation, nYPos, szData, sExid, sProCode, sName, sExidCode
	sExid = (Grid0.GetCellData("bd_cell1", lRow))
	sProCode = Grid0.GetCellData("bd_cell6", lRow)
	sName = Grid0.GetCellData("bd_cell0", lRow)
	sExidCode = Transform_Code(sExid)
	if sExidCode <> null and sExidCode <> "" then
		sCode = sExidCode.."@"..sProCode
		if sCode <> null and sCode <> ""	then
			listlocation = split(Grid0.location, ":")
			nYPos = Int(listLocation[1])
			szData = sCode.."^"..sProCode.."^"..sName.."^".."".."^"..sExid.."^"..nYPos
			Form.OpenPopup("mhtro16052_p1" , szData , "")
		end if
	end if	
End Sub


'============================================================================
' 숫자를 거래소 ID로 변환
'============================================================================
Function Transform_Code(sValue)
	if sValue == "104"	then
		return "HKS"
	elseif sValue == "529"	then
		return "HSI"
	elseif sValue == "215"	then
		return "SHS"
	elseif sValue == "214"	then
		return "SZS"
	elseif sValue == "321"	then
		return "NYS"
	elseif sValue == "066"	or sValue == "66" then
		return "AMX"
	elseif sValue == "537"	then
		return "NAS"
	elseif sValue =="130"	then
		return "NAO"
	elseif sValue == "625"	then
		return "SPI"
	elseif sValue == "310"	then
		return "DJI"
	elseif sValue == "106"	then
		return "TSE"
	elseif sValue == "107"	then
		return "OSE"
	elseif sValue == "112"	then
		return "JSD"
	elseif sValue == "889"	then
		return "NII"
	elseif sValue == "538"	then
		return "NAI"
	elseif sValue == "770"	then
		return "HSX"
	elseif sValue == "771"	then
		return "HNX"
	else
		return ""
	end if
end function


