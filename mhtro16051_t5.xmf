Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim szNext

g_nPage = 1
g_xPos  = ""
g_nIndex = 0
szNext = ""
'============================================================================
Sub Form_OnFormInit()
	Combo0.bgimagetype = "1"
	
	DATAMANAGER.RequestTranData("gtsETFLeverageSearch")
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "gtsETFLeverageInquiry"	then
		Dim szCmb0
		szCmb0 = Combo0.cbkeydata
		DATAMANAGER.SetDataValue(false, "gtsETFLeverageInquiry", "inblock", "fdes" , 0 , szCmb0)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "gtsETFLeverageSearch"	then
		Dim nSecterCount
		Dim nCount
		
		nSecterCount = 1
		nCount = CInt(DATAMANAGER.GetDataCount( false, szTranID , "itemList" )) '데이터 개수

		nRowCount = Grid1.rowcount
		sJb = ""			'중복체크
		j = "0"
		for i = 0 to nRowCount
			if Grid1.GetCellData("Clss", i) <> Grid1.GetCellData("Clss", i+1) then
				if sJb <> null and sJb <> ""	then
					if sJb == Grid1.GetCellData("Clss", i+1)	then
						Grid1.SetCellData("Clss", i+1, "")
						Grid1.SetCellData("Gubun", i, j)
					else
						Grid1.SetCellData("Gubun", i, j)
						sJb = ""
						j = j + 1
					end if
				else
					Grid1.SetCellData("Gubun", i, j)
					sJb = ""
				end if
			else
				if sJb <> null and sJb <> ""	then
					sJb = Grid1.GetCellData("Clss", i)
					Grid1.SetCellData("Clss", i+1, "")
					Grid1.SetCellData("Gubun", i, j)
				else
					sJb = Grid1.GetCellData("Clss", i)
					Grid1.SetCellData("Clss", i+1, "")
					Grid1.SetCellData("Gubun", i, j)
				end if
			end if
		next
		
		for i=1 to nRowCount
			if Grid1.GetCellData("Clss", i-1) <> null and Grid1.GetCellData("Clss", i-1) <> ""	then
				Combo0.cbadddatatext =   Grid1.GetCellData("Clss", i - 1).."`".. Grid1.GetCellData("Clss", i - 1)
			end if
		next
		
		if Form.GetEnvData("16051_T5_COMBO0") <> null and Form.GetEnvData("16051_T5_COMBO0") <> ""	then
			Combo0.cbkeydata = Form.GetEnvData("16051_T5_COMBO0")
		end if
		
		g_nPage = 1
		DATAMANAGER.RequestTranData( "gtsETFLeverageInquiry" ) 
	elseif szTranID == "gtsETFLeverageInquiry"	then
		Dim nCount
		nCount    = CInt( DATAMANAGER.GetDataCount( false, szTranID , "itemList" ) )
		'DATA값 (현재page / 전체page)
'		g_xPos = DATAMANAGER.GetDataValue( false, szTranID , "itemInfo" , "xpos" , 0 )
'		szNext = DATAMANAGER.GetDataValue( false, szTranID , "itemInfo" , "nrec" , 0 )

		nRowCount = Grid0.rowcount
		for i=0 to nCount-1
			Dim nIndex
			nIndex = i * 2
			
			Grid0.insertrow = nRowCount + nIndex
			Dim sPName, sPLast, sPExid, nPDiff, sPCode, nPLevg, sPTvol, sPRate, sPSymb
			sPName = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "pnam" , i)
			sPLast = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "past" , i)
			sPExid = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "pxid" , i)
			nPDiff = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "piff" , i)
			sPCode = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "pymb" , i)
			nPLevg = _tonumber(DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "plevg" , i))
			sPTvol = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "pvol" , i)
			sPRate = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "pate" , i)

			Grid0.SetCellData("bd_cell0", nRowCount + nIndex, sPName)
			Grid0.SetCellData("bd_cell2", nRowCount + nIndex, sPLast)
			Grid0.SetCellData("bd_cell4", nRowCount + nIndex, nPDiff)
			Grid0.SetCellData("bd_cell1", nRowCount + nIndex, sPExid)
			Grid0.SetCellData("bd_cell6", nRowCount + nIndex, sPCode)
			Grid0.SetCellData("bd_cell8", nRowCount + nIndex, sPTvol)
			Grid0.SetCellData("bd_cell9", nRowCount + nIndex, sPRate)
	
'			현재가, 등락률 글자색, 대비부호 셋팅                                     
			nPDiff = _tonumber(nPDiff)
			if nPDiff > 0  then
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + nIndex, "1" ) 
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + nIndex, "1" )
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + nIndex, "1" ) 
				Grid0.SetCellData( "bd_cell3", nRowCount + nIndex, "2" ) '1
				
			elseif nPDiff < 0  then
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + nIndex, "2" )
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + nIndex, "2" )
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + nIndex, "2" ) 
				Grid0.SetCellData( "bd_cell3", nRowCount + nIndex, "5" ) '3
				
			else
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + nIndex, "3" )
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + nIndex, "3" ) 
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + nIndex, "3" ) '대비
				Grid0.SetCellData( "bd_cell3", nRowCount + nIndex, "0" ) '5
			end if
			
			'레버리지 셋팅                              
			if nPLevg > 0  then
				Grid0.SetCellData( "bd_cell7", nRowCount + nIndex, "+" .. tostring(nPLevg) )
			elseif nPLevg < 0  then
				Grid0.SetCellData( "bd_cell7", nRowCount + nIndex, (nPLevg) )
			else 
				Grid0.SetCellData( "bd_cell7", nRowCount + nIndex, "" )
			end if			
		
			nIndex = nIndex + 1
			Grid0.insertrow = nRowCount + nIndex
			Dim sName, sLast, sExid, nDiff, sCode, nLevg, sTvol, sRate, sSymb
			sName = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nnam" , i)
			sLast = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nast" , i)
			sExid = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nxid" , i)
			nDiff = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "niff" , i)
			sCode = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nymb" , i)
			nLevg = _tonumber(DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nlevg" , i))
			sTvol = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nvol" , i)
			sRate = DATAMANAGER.GetDataValue(false, "gtsETFLeverageInquiry", "itemList", "nate" , i)

			Grid0.SetCellData("bd_cell0", nRowCount + nIndex, sName)
			Grid0.SetCellData("bd_cell2", nRowCount + nIndex, sLast)
			Grid0.SetCellData("bd_cell4", nRowCount + nIndex, nDiff)
			Grid0.SetCellData("bd_cell1", nRowCount + nIndex, sExid)
			Grid0.SetCellData("bd_cell6", nRowCount + nIndex, sCode)
			Grid0.SetCellData("bd_cell8", nRowCount + nIndex, sTvol)
			Grid0.SetCellData("bd_cell9", nRowCount + nIndex, sRate)
	
'			현재가, 등락률 글자색, 대비부호 셋팅                                     
			nDiff = _tonumber(nDiff)
			if nDiff > 0  then
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + nIndex, "1" ) 
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + nIndex, "1" )
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + nIndex, "1" ) 
				Grid0.SetCellData( "bd_cell3", nRowCount + nIndex, "2" ) '1
				
			elseif nDiff < 0  then
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + nIndex, "2" )
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + nIndex, "2" )
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + nIndex, "2" ) 
				Grid0.SetCellData( "bd_cell3", nRowCount + nIndex, "5" ) '3
				
			else
				Grid0.SetCellFgColor( "bd_cell2", nRowCount + nIndex, "3" )
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + nIndex, "3" ) 
				Grid0.SetCellFgColor( "bd_cell9", nRowCount + nIndex, "3" ) '대비
				Grid0.SetCellData( "bd_cell3", nRowCount + nIndex, "0" ) '5
			end if
			
			'레버리지 셋팅                              
			if nLevg > 0  then
				Grid0.SetCellData( "bd_cell7", nRowCount + nIndex, "+" .. tostring(nLevg) )
			elseif nLevg < 0  then
				Grid0.SetCellData( "bd_cell7", nRowCount + nIndex, (nLevg) )
			else 
				Grid0.SetCellData( "bd_cell7", nRowCount + nIndex, "" )
			end if
		next
	end if
End Sub


Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Grid0.SetClear( )
	g_nPage  = 1
	g_nIndex = 0
	Form.SetEnvData(1, "16051_T5_COMBO0", Combo0.cbkeydata)
	DATAMANAGER.RequestTranData( "gtsETFLeverageInquiry" )
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub
