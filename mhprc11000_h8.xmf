Dim g_szItemCode, g_szItemMarket
Dim g_sztog1


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function Grid_Show()
	If rdoGubun.currentindex = "0" then
		grd0.SetVisibleCol( 1, 1 )
		grd0.SetVisibleCol( 2, 1 )
		grd0.SetVisibleCol( 3, 1 )
		grd0.SetVisibleCol( 4, 1 )
		grd0.SetVisibleCol( 5, 1 )
		grd0.SetVisibleCol( 6, 1 )
		grd0.SetVisibleCol( 7, 1 )
		grd0.SetVisibleCol( 8, 1 )
		grd0.SetVisibleCol( 9, 1 )
		grd0.SetVisibleCol( 10, 1 )
		grd0.SetVisibleCol( 11, 1 )
		grd0.SetVisibleCol( 12, 1 )
		grd0.SetVisibleCol( 13, 0 )
		grd0.SetVisibleCol( 14, 0 )
		grd0.SetVisibleCol( 15, 0 )
		grd0.SetVisibleCol( 16, 0 )
		grd0.SetVisibleCol( 17, 0 )
		grd0.SetVisibleCol( 18, 0 )
		grd0.SetVisibleCol( 19, 0 )
		grd0.SetVisibleCol( 20, 0 )
		grd0.SetVisibleCol( 21, 0 )
		grd0.SetVisibleCol( 22, 0 )
		grd0.SetVisibleCol( 23, 0 )
		grd0.SetVisibleCol( 24, 0 )

	Else
		grd0.SetVisibleCol( 1, 0 )
		grd0.SetVisibleCol( 2, 0 )
		grd0.SetVisibleCol( 3, 0 )
		grd0.SetVisibleCol( 4, 0 )
		grd0.SetVisibleCol( 5, 0 )
		grd0.SetVisibleCol( 6, 0 )
		grd0.SetVisibleCol( 7, 0 )
		grd0.SetVisibleCol( 8, 0 )
		grd0.SetVisibleCol( 9, 0 )
		grd0.SetVisibleCol(10, 0)
		grd0.SetVisibleCol( 11, 0 )
		grd0.SetVisibleCol( 12, 0)
		grd0.SetVisibleCol( 13, 1 )
		grd0.SetVisibleCol( 14, 1 )
		grd0.SetVisibleCol( 15, 1 )
		grd0.SetVisibleCol( 16, 1 )
		grd0.SetVisibleCol( 17, 1 )
		grd0.SetVisibleCol( 18, 1)
		grd0.SetVisibleCol( 19, 1 )
		grd0.SetVisibleCol( 20, 1 )
		grd0.SetVisibleCol( 21, 1 )
		grd0.SetVisibleCol( 22, 1 )
		grd0.SetVisibleCol( 23, 1 )
		grd0.SetVisibleCol( 24, 1 )		
		
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
'	DATAMANAGER.RequestTranData( "ohhts_1086_001r" )

End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		DATAMANAGER.RequestTranData( "ohhts_1086_001r" )
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		DATAMANAGER.RequestTranData( "ohhts_1086_001r" )
		
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "ohhts_1086_001r" then		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_SCTN_CLS_CODE"		, 0, 0 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_DATE2"				, 0, "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD"				, 0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCode

	if szTranID = "ohhts_1086_001r" then

		' 20190624 HWG START
		' 외국인계 데이터 추가
		if rdoGubun.currentindex = "0" then
			tbl0.SetCellString( 1, 0, DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_GLOB_TOTAL_NTBY_QTY", 0 ) )
			tbl0.SetCellString( 1, 1, DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_GLOB_NTBY_QTY", 0 ) )
			tbl0.SetCellString( 1, 2, DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_FRGN_NTBY_QTY", 0 ) )
			tbl0.SetCellString( 1, 3, DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_ORGN_NTBY_VOL", 0 ) )
			
			tbl0.SetCellAttrColor( 1, 0, DATAMANAGER.GetDataAttr( 0, szTranID , "OutBlock2", "FID_GLOB_TOTAL_NTBY_QTY", 0 ) )
			tbl0.SetCellAttrColor( 1, 1, DATAMANAGER.GetDataAttr( 0, szTranID , "OutBlock2", "FID_GLOB_NTBY_QTY", 0 ) )
			tbl0.SetCellAttrColor( 1, 2, DATAMANAGER.GetDataAttr( 0, szTranID , "OutBlock2", "FID_FRGN_NTBY_QTY", 0 ) )
			tbl0.SetCellAttrColor( 1, 3, DATAMANAGER.GetDataAttr( 0, szTranID , "OutBlock2", "FID_ORGN_NTBY_VOL", 0 ) )
		else	
			tbl0.SetCellString( 1, 0, Round(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_FRGN_GLOB_NTBY_TR_PBMN", 0 ) / 1000000, 5) )
			tbl0.SetCellString( 1, 1, Round(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_GLOB_NTBY_TR_PBMN", 0 ) / 1000000, 5) )
			tbl0.SetCellString( 1, 2, Round(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_FRGN_NTBY_TR_PBMN", 0 ) / 1000000, 5) )
			tbl0.SetCellString( 1, 3, Round(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_ORGN_NTBY_TR_PBMN", 0 ) / 1000000, 5) )
			
			tbl0.SetCellAttrColor( 1, 0, DATAMANAGER.GetDataAttr( 0, szTranID, "OutBlock2", "FID_FRGN_GLOB_NTBY_TR_PBMN", 0 ) )
			tbl0.SetCellAttrColor( 1, 1, DATAMANAGER.GetDataAttr( 0, szTranID, "OutBlock2", "FID_GLOB_NTBY_TR_PBMN", 0 ) )
			tbl0.SetCellAttrColor( 1, 2, DATAMANAGER.GetDataAttr( 0, szTranID, "OutBlock2", "FID_FRGN_NTBY_TR_PBMN", 0 ) )
			tbl0.SetCellAttrColor( 1, 3, DATAMANAGER.GetDataAttr( 0, szTranID, "OutBlock2", "FID_ORGN_NTBY_TR_PBMN", 0 ) )
		end if
		' 20190624 HWG END
		
		Grid_Show()
	end if
	
End Sub

'============================================================================
Sub rdoGubun_OnClick(nIndex)

	DATAMANAGER.RequestTranData( "ohhts_1086_001r" )
End Sub


