'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szState 		'설정/해지
Dim g_nChkCount		'그리드 체크개수
Dim g_nSelectRow		'선택한 그리드 Row

Dim g_Lnkd_Acno               '연계계좌계좌번호
DIm g_Lnkd_Asno               '연계계좌일련번호
Dim g_Lnkd_Prcd                '연계계좌PRCD
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	tblState.SetCellString( 0 , 1, "")
	tblState.SetCellString( 1 , 1, "")
	tblState.SetCellString( 2 , 1, 0)
	
	tblState2.SetCellString( 0 , 1, "")
	tblState2.SetCellString( 1 , 1, "")
	tblState2.SetCellString( 2 , 1, 0)
	tblState2.SetCellString( 3 , 1, 0)
	
	lblInfo3.visible = False 'CFD 안내문구
	lblInfo4.visible = False 'CFD 안내문구
				
	grdList.SetClear()
	g_nChkCount = 0
	g_nSelectRow = -1
End Function
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )

	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	
'===========================================================================
' 질권설정/해지금액합계 함수
'===========================================================================
Function f_SetPrcSum()
	Dim nNum
	nNum = 0
	
	for i = 0 to grdList.rowcount-1
		if grdList.GetCellData( "bd_check", i ) == "1" then
			nNum = nNum+CDbl(grdList.GetCellData( "bd_setprice", i ))
		end if
	next
	
	If g_szState == "set" Then
		tblState.SetCellString( 2, 1, nNum )
	Else
		tblState2.SetCellString( 3, 1, nNum )
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
f_ClearData()
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szState = ""
	f_ClearData()
	if sEventName == "changeTab" then
		'신청 : set, 해지 : cancel
		g_szState = sParam

		If g_szState == "set" Then
			tblState.visible = True
			tblState2.visible = False
			tblState.SetCellString( 3 , 0, "질권설정금액 합계")
			grdList.SetCellTopCaption( "th_setqty", "설정수량" )
			grdList.SetCellTopCaption( "th_setprice", "설정금액" )
			btnOK.caption = "대용질권 설정"
		Else
			tblState.visible = False
			tblState2.visible = True
			tblState2.SetCellString( 3 , 0, "질권해지금액 합계")
			grdList.SetCellTopCaption( "th_setqty", "해지수량" )
			grdList.SetCellTopCaption( "th_setprice", "해지금액" )
			btnOK.caption = "대용질권 해지"	
			
		End If
		'장내파생 대용 계좌 조회
		DATAMANAGER.RequestTranData( "obrtp_ftop_017r" )
	end if	
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	'장내파생 대용 계좌 조회
	DATAMANAGER.RequestTranData( "obrtp_ftop_017r" )
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbonl87055" Then
		If sRet == "ok" Then
			g_nChkCount = g_nChkCount + 1
			
			Dim nInputqty, nInputprc
			nInputqty = Form.GetSharedData("mbonl87055_t2_inputqty" , false)
			nInputprc = Form.GetSharedData("mbonl87055_t2_inputprc" , false)

			grdList.SetCellData( "bd_setqty", g_nSelectRow, nInputqty )
			grdList.SetCellData( "bd_setprice", g_nSelectRow, nInputprc )
		Else
			grdList.SetCellData( "bd_check", g_nSelectRow, "0" )
			grdList.SetCellData( "bd_setqty", g_nSelectRow, "" )
			grdList.SetCellData( "bd_setprice", g_nSelectRow, "" )
		End If
		g_nSelectRow = -1
		
		f_SetPrcSum()
	'공인인증 처리 완료 되면 '장내파생 대용 지정/해지 TR 호출
	ElseIf sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" then
			DATAMANAGER.RequestTranData( "obrtp_ftop_012a" )
		end if	
	ElseIf sKeyName == "mhetc90060_px" Then 'v001
		If sRet == "ok" Then  
			DATAMANAGER.RequestTranData( "obrtp_ftop_012a" )
		End If
	Elseif sKeyName == "AGREECHECK" then
		if sRet == "Y" then
			Form.OpenScreen("31003" , "")
		else

		end if 		
	End If
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	'장내파생 대용 계좌 조회
	DATAMANAGER.RequestTranData( "obrtp_ftop_017r" )
End Sub

'============================================================================
' grdList_OnClickUp(lRow, szCellID) : 종목선택
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)

	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		grdList.SetCellData("bd_check", lRow, "0")
		Exit Sub
	End If
	
	'체크박스 선택
	If szCellID == "bd_check" Then
	
		If grdList.GetCellData( "bd_check", lRow ) == "1" Then
		
			if grdList.GetCellData( "bd_cancYN", lRow ) == "N" Then
				Form.ShowAlert("알림", "기존 대용잔고가 존재합니다.\n기존 대용잔고를 먼저 해지하신후에 다시 해지하시기 바랍니다.")
				grdList.SetCellData("bd_check", lRow, "0")
				Exit Sub
			end if
		
		
			'대용가 0인 종목 예외처리
			Dim nPrice 
			nPrice =  CDbl(grdList.GetCellData( "bd_price", lRow ))	'대용가
			If nPrice == 0 Then
				Form.ShowAlert("알림", "대용가가 0인 종목은 대용지정할 수 없습니다.")
				grdList.SetCellData("bd_check", lRow, "0")
				Exit Sub
			End If
			
			if g_nChkCount > 30 then
				Form.MsgBox( "알림", "최대 30건까지 처리가능합니다", "", 6 )
				grdList.SetCellData("bd_check", lRow, "0")
				Exit sub
			end if
			
			g_nSelectRow = lRow
			Form.SetSharedData("mbonl87055_t2_name" , grdList.GetCellData( "bd_name", lRow ))
			Form.SetSharedData("mbonl87055_t2_price" , grdList.GetCellData( "bd_price", lRow ))
			Form.SetSharedData("mbonl87055_t2_ableqty" , grdList.GetCellData( "bd_ableqty", lRow ))
			Form.SetSharedData("mbonl87055_t2_type" , grdList.GetCellData( "bd_type", lRow )) '추가
			'대용질권 설정 팝업 호출
			Form.OpenFramePopup("mbonl87055_p1" , g_szState , "")
			
		Else
			g_nChkCount = g_nChkCount - 1
			grdList.SetCellData( "bd_setqty", lRow, "" )
			grdList.SetCellData( "bd_setprice", lRow, "" )
			
			f_SetPrcSum()
		End If
	End If
End Sub
'============================================================================
' grdList_OnScrollEnd()
'============================================================================
Sub grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obrtp_ftop_013r") == True Then
		DATAMANAGER.RequestNextData("obrtp_ftop_013r")
	End If
End Sub


'============================================================================
' btnOK_OnClick : 대용질권 지정/해지
'============================================================================
Sub btnOK_OnClick()

	'대용수수료 동의확인 START
	
	If g_Lnkd_Acno == null or g_Lnkd_Asno == null or  g_Lnkd_Acno == "" or g_Lnkd_Asno == ""  Then
		Form.ShowAlert( "알림", "선물옵션/CFD 계좌를 확인해주세요." )
		Exit Sub
	end if

	Dim syACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    syACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    syACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
 
	DATAMANAGER.SetDataValue( 0, "obtrc_acnt_001r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2"	             )
	DATAMANAGER.SetDataValue( 0, "obtrc_acnt_001r" , "InBlock1" , "ACNO"                  , 0 , g_Lnkd_Acno   )
	DATAMANAGER.SetDataValue( 0, "obtrc_acnt_001r" , "InBlock1" , "ASNO"                  , 0 , g_Lnkd_Asno  )
	DATAMANAGER.SetDataValue( 0, "obtrc_acnt_001r" , "InBlock1" , "ACNT_PWD"	         , 0 , syACNT_PWD  )

	DATAMANAGER.RequestTranData( "obtrc_acnt_001r" )

	'대용수수료 동의확인 END 이외 로직은 Complete로..
	
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("mbonl87055_t2_name" 		, true)
	Form.SetSharedData("mbonl87055_t2_price" 	, true)
	Form.SetSharedData("mbonl87055_t2_ableqty" 	, true)
	
	Form.SetSharedData("mbonl87055_t2_inputqty" 	, true)
	Form.SetSharedData("mbonl87055_t2_inputprc" 	, true)
End Sub


''****************************************************************************
''               		D  A  T  A  M  A  N  A  G  E  R               
''****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szProsClsCode	'처리구분 코드
	If g_szState == "set" Then
		szProsClsCode = "1"	'설정
	Else
		szProsClsCode = "3"	'해지
	End If 
	
	'장내파생 대용 계좌 조회
	If szTranID == "obrtp_ftop_017r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , cmbAcct.total	)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , cmbAcct.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD"	, 0 , ""			)
	'장내파생 대용 조회
	ElseIf szTranID == "obrtp_ftop_013r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , cmbAcct.total	)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , cmbAcct.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD"	, 0 , ""			)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , szProsClsCode 	)	
	
	'장내파생 대용 지정/해지
	ElseIf szTranID == "obrtp_ftop_012a" Then
		Dim szACNT_PWD 
		if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
		    szACNT_PWD = edtPswd.caption
		else  								'MTS메모리평문 미적용상태일때
		    szACNT_PWD = Form.GetEncData(edtPswd.caption)
		end if
	
		'InBlock1
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total		)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence 	)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" 	, 0 , szACNT_PWD 			)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FTOP_ACNO" 	, 0 , Left(tblState.GetCellString( 1, 1 ), 8)		)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FTOP_ASNO" 	, 0 , Right(tblState.GetCellString( 1, 1 ), 2) 	)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , szProsClsCode 		)
		
		Dim nIndex
		nIndex = 0
		'InBlock2
		For i = 0 to CDbl(grdList.rowcount)-1
			Dim szChkState
			szChkState = CStr(grdList.GetCellData( "bd_check", i ))
			If szChkState == "1" Then
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "PROS_CLS"				, nIndex, "1" )
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "ISCD" 				, nIndex, CStr(grdList.GetCellData( "bd_ISCD", i ))	)
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "QTY" 					, nIndex, CDbl(grdList.GetCellData( "bd_setqty", i ))	)
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "BYOV_DATE" 			, nIndex, CStr(grdList.GetCellData( "bd_date", i ))	)
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "OVRL_SPTX_CLS_CODE" 	, nIndex, CStr(grdList.GetCellData( "bd_code", i ))	)
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "SSPR" 				, nIndex, CDbl(grdList.GetCellData( "bd_price", i ))	)
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "SBSN_AMT" 			, nIndex, CDbl(grdList.GetCellData( "bd_setprice", i )) )
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "TRAN_SRNO" 			, nIndex, 0 )
				DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "APRV_RQST_QTY" 		, nIndex, 0 )
				nIndex = nIndex + 1
			End If
		Next
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'장내파생 대용 계좌 조회
	If szTranID == "obrtp_ftop_017r" Then	
		Dim szACNO, szASNO
		szACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LNKD_ACNO" , 0 )
		szASNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LNKD_ASNO" , 0 )
		
		g_Lnkd_Acno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LNKD_ACNO" , 0 )
		g_Lnkd_Asno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LNKD_ASNO" , 0 )
		
		If szACNO <> null or szASNO <> "" or szASNO <> null or szASNO <> "" Then
			tblState.SetCellString( 0 , 1, "등록")
			tblState.SetCellString( 1 , 1, "" )
			tblState.SetCellString( 1 , 1, szACNO..szASNO)
			tblState2.SetCellString( 0 , 1, "등록")
			tblState2.SetCellString( 1 , 1, "" )
			tblState2.SetCellString( 1 , 1, szACNO..szASNO)
			DATAMANAGER.RequestTranData( "obrtp_ftop_013r" )
		Else
			f_ClearData()
			tblState.SetCellString( 0 , 1, "미등록")
			tblState2.SetCellString( 0 , 1, "미등록")
			'tblState2.SetCellString( 2 , 1, 0)
		End If

	'장내파생 대용 지정/해지
	ElseIf szTranID == "obrtp_ftop_012a" Then
		f_ClearData()
		
		If g_szState == "set" Then
			Form.ShowAlert("알림", "대용질권 설정 완료되었습니다.")
		Else
			Form.ShowAlert("알림", "대용질권 해지 완료되었습니다.")
		End If
		
		'장내파생 대용 계좌 조회
		DATAMANAGER.RequestTranData( "obrtp_ftop_017r" )
		
	
	ElseIf szTranID == "obrtp_ftop_013r" Then
		
		DATAMANAGER.SetDataValue( 0, "obrtp_comn_009r" , "InBlock1" , "ACNO"		, 0 , g_Lnkd_Acno)
		DATAMANAGER.SetDataValue( 0, "obrtp_comn_009r" , "InBlock1" , "ASNO"		, 0 , g_Lnkd_Asno)

		DATAMANAGER.RequestTranData( "obrtp_comn_009r" )
		
		
	'선옵/CFD 계좌 정보
	ElseIf szTranID == "obrtp_comn_009r" Then
		g_Lnkd_Prcd =  DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PRCD" , 0 )
		
		For i = 0 to CDbl(grdList.rowcount)-1
			Dim szChkState
			szChkState = CStr(grdList.GetCellData( "bd_setYN", i ))
			
			If szChkState == "N"  AND g_Lnkd_Prcd  == "136"  Then
				grdList.SetCellData("bd_check", i, 0)
				grdList.SetCellEnable("bd_check", i, False)
			else
				grdList.SetCellEnable("bd_check", i, True)
			End If
		Next
		
		
		If g_szState == "set" Then			
			grdList.SetVisibleCol( 11, 0 )
			if g_Lnkd_Prcd == "136" Then
				grdList.SetVisibleCol( 10, 1 )
				
				lblInfo3.visible = False 'CFD 안내문구
				lblInfo4.visible = False 'CFD 안내문구
			else
				grdList.SetVisibleCol( 10, 0)
				
				lblInfo3.visible = False 'CFD 안내문구
				lblInfo4.visible = False 'CFD 안내문구
			end if
		Else	
			grdList.SetVisibleCol( 10, 0)
			if g_Lnkd_Prcd == "136" Then
				grdList.SetVisibleCol( 11, 1 )
				
				lblInfo3.visible = True 'CFD 안내문구
				lblInfo4.visible = True 'CFD 안내문구
			else
				grdList.SetVisibleCol( 11, 0)
				
				lblInfo3.visible = False 'CFD 안내문구
				lblInfo4.visible = False 'CFD 안내문구
			end if
		End If
		
	
	'동의여부
	ElseIf szTranID == "obtrc_acnt_001r" Then
		
		if DATAMANAGER.GetDataValue( 0, "obtrc_acnt_001r" , "OutBlock1", "PPP_YN" , 0 ) == "Y" AND  g_szState == "set" AND CDbl(tblState.GetCellString( 2, 1 )) > 0 then
			Form.OpenPopup("mbonl87055_p2" , "", "")
		else
			'계좌비밀번호 입력체크함수
			If f_GetPWCkeck() Then
				Exit Sub
			End If
			
			If g_szState == "set" Then
				If CDbl(tblState.GetCellString( 2, 1 )) == 0 Then
					Form.ShowAlert( "알림", "질권설정금액을 확인해주세요." )
					Exit Sub
				End If
			Else
				If CDbl(tblState2.GetCellString( 3, 1 )) == 0 Then
					Form.ShowAlert( "알림", "질권해지금액을 확인해주세요." )
					Exit Sub
				End If
			End If
			
			Dim szCertUseType 
			szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입
			
			If szCertUseType == "1" or szCertUseType == 1 Then '간편인증 v001
				Form.OpenFramePopup( "mhetc90060_px" , "" , mhetc90060_px)		'간편인증
			Else
				Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
			End If
			
		end if
		
	End If
	
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )

	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.."\n"..sSubMsg
	end if
	
	If szTranID == "obrtp_ftop_012a" Then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	ElseIf szTranID == "obrtp_ftop_017r" Then	'Fail나면 미등록으로 간주
		f_ClearData()
		tblState.SetCellString( 0 , 1, "미등록")
		tblState2.SetCellString( 0 , 1, "미등록")
		'tblState2.SetCellString( 2 , 1, 0)
		grdList.SetVisibleCol( 10, 0 )
	Else
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

