	<SCRIPT_INFO _len="4153" _ulen="4107" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 호가별탭(K-OTC)
' 03. 작    성 : 2018.08.09 HAMWG
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_szItemMarket, g_szgrdHeader
Dim g_sztog1

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

End Sub

'============================================================================
Sub Form_OnFormInit()
	RadioGroup0_OnClick(0)
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		If g_szItemMarket = "T" Then		
			if RadioGroup0.currentindex = "0" then
				DATAMANAGER.RequestTranData( "ohhts_1203_002r" )
			elseif RadioGroup0.currentindex = "1" then
				DATAMANAGER.RequestTranData( "ohhts_1203_003r" )
			else
				DATAMANAGER.RequestTranData( "ohhts_1203_002r" )
			end if
		End If
		
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If	
	
		g_szItemCode = sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		If g_szItemMarket = "T" Then		
			if RadioGroup0.currentindex = "0" then
				DATAMANAGER.RequestTranData( "ohhts_1203_002r" )
			elseif RadioGroup0.currentindex = "1" then
				DATAMANAGER.RequestTranData( "ohhts_1203_003r" )
			else
				DATAMANAGER.RequestTranData( "ohhts_1203_002r" )
			end if
		End If
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID = "ohhts_1203_002r" then

	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "T")	    
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_002r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szItemCode)
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_002r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE" , 0 , "0")
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_002r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , "2")  
	    
	elseif szTranID = "ohhts_1203_003r" then
	    
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "T")	    
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_003r", "InBlock2", "FID_INPUT_ISCD" , 0 , g_szItemCode)
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_003r", "InBlock2", "FID_INPUT_SCTN_CLS_CODE" , 0 , "1")
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1203_003r", "InBlock2", "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , "1")  
	 
	end if
End Sub



'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex = 0 then
		DATAMANAGER.RequestTranData( "ohhts_1203_002r" )
		Grid0.visible = True
		Grid1.visible = False
	else
		DATAMANAGER.RequestTranData( "ohhts_1203_003r" )
		Grid0.visible = False
		Grid1.visible = True
	end if
End Sub



