'============================================================================
Dim g_nNextDataCnt
Dim g_nStartRowNum
Dim g_szForminit
Dim g_szControlSet

Dim gLinKVndrCode
gLinKVndrCode = ""

'============================================================================

'============================================================================
Sub Form_OnFormInit()
	
	'----------------------------------------------------------------------------------------
	'20240719 START
	'----------------------------------------------------------------------------------------
	gLinKVndrCode = Form.GetOpenLinkData()
	'----------------------------------------------------------------------------------------
	'20240719 END
	'----------------------------------------------------------------------------------------

	g_nNextDataCnt = 0
	g_szForminit = "Y"
	Table0.visible = false
	
	DATAMANAGER.ClearInputData(0, "obtro_comn_001r")
	DATAMANAGER.SetDataValue(0, "obtro_comn_001r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , "%")
	DATAMANAGER.RequestTranData("obtro_comn_001r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_comn_001r" then
		tmpCnt = Clng(DATAMANAGER.GetDataCount(0, "obtro_comn_001r" , "OutBlock1"))
		
		for i = 0 to tmpCnt - 1
			cboMkt.cbadddatatext = DATAMANAGER.GetDataValue(0,  "obtro_comn_001r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", i) & "`" & DATAMANAGER.GetDataValue(0, "obtro_comn_001r", "OutBlock1", "OVRS_STCK_MRKT_NAME", i)
			'cboMkt.cbadddatatext = DATAMANAGER.GetDataValue(0,  "obtro_comn_001r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", i) & "`" & DATAMANAGER.GetDataValue(0,  "obtro_comn_001r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", i) & DATAMANAGER.GetDataValue(0, "obtro_comn_001r", "OutBlock1", "OVRS_STCK_MRKT_NAME", i)
						
			'g_nNextDataCnt = g_nNextDataCnt + 1
		next
		
		
		if DATAMANAGER.IsMoreNextData("obtro_comn_001r") == TRUE then
			DATAMANAGER.RequestNextData("obtro_comn_001r")
		else
		
			'----------------------------------------------------------------------------------------
			'20240719 START
			'----------------------------------------------------------------------------------------
			if gLinKVndrCode <> "" then
				
				'뉴욕/아멕스/나스닥
				if gLinKVndrCode == "0321" or gLinKVndrCode == "0066" or gLinKVndrCode == "0537" then
					
					cboMkt.cbkeydata = "01"
								
				'심천
				elseif gLinKVndrCode == "0214" then
					
					cboMkt.cbkeydata = "04"
				
				'상해
				elseif gLinKVndrCode == "0215" then
					
					cboMkt.cbkeydata = "03"
				
				'홍콩
				elseif gLinKVndrCode == "0104" then
					
					cboMkt.cbkeydata = "02"
				
				'일본
				elseif gLinKVndrCode == "0106" then
					
					cboMkt.cbkeydata = "05"
												
				end if
				
				cboMkt_OnEditComplete(Cint(cboMkt.currentindex))
			
			else
				cboMkt_OnEditComplete(Cint(cboMkt.currentindex))
			end if
			'----------------------------------------------------------------------------------------
			'20240719 END
			'----------------------------------------------------------------------------------------
		
		end if
	elseif szTranID == "obtro_comn_302r" then
		cboCrcd.clear = true
		
		tmpcrcd   = DATAMANAGER.GetDataValue(0, "obtro_comn_302r", "OutBlock1", "CRCD" , 0)
		tmpcrcdnm = Form.GetMetaData( "통화코드",  tmpcrcd)
		
		cboCrcd.cbadddatatext = tmpcrcd & "`" & tmpcrcdnm
		Table0.SetCellString(0, 0, "합계("& cboCrcd.cbkeydata &")")
		
		ControlSet()
		
		'if g_szForminit == "Y" then
		'	g_szForminit = "N"
		'else
		'	btnSearch_OnClick()
		'end if
		
	elseif szTranID == "obtro_acnt_151r" and g_szControlSet = "0" then
		tmpcnt = Cint(DATAMANAGER.GetDataCount(0, "obtro_acnt_151r", "OutBlock1"))
		tmpoderablecamt = Cdbl(DATAMANAGER.GetDataValue(0, "obtro_acnt_151r", "OutBlock2", "ODER_ABLE_CAMT", 0))
		
		for i = 0 to tmpcnt -1
			Grid0.SetCellData("bd_cell3", g_nStartRowNum + i, "0")
			stnd_deps_camt    = Cdbl(DATAMANAGER.GetDataValue(0,  "obtro_acnt_151r", "OutBlock1", "STND_DEPS_CAMT", i))
			stnd_evdn_camt    = Cdbl(DATAMANAGER.GetDataValue(0,  "obtro_acnt_151r", "OutBlock1", "STND_EVDN_CAMT", i))
			intg_marg_iqry_yn = DATAMANAGER.GetDataValue(0, "obtro_acnt_151r", "OutBlock2", "IF_INTG_MARG_IQRY_YN", 0)
			'양수는 증거금, 음수는 -제거후 재사용가능금액
			if intg_marg_iqry_yn == "Y" then
				if stnd_deps_camt == stnd_evdn_camt and stnd_deps_camt < 0 then
					Grid0.SetCellData("bd_cell2", g_nStartRowNum + i, 0)
					Grid0.SetCellData("bd_cell3", g_nStartRowNum + i, 0)
				else
					if Clng(stnd_evdn_camt) >= 0 then
						Grid0.SetCellData("bd_cell2", g_nStartRowNum + i, stnd_evdn_camt)
					else
						Grid0.SetCellData("bd_cell2", g_nStartRowNum + i, 0)
						Grid0.SetCellData("bd_cell3", g_nStartRowNum + i, stnd_evdn_camt)					
					end if
				end if
				
				Table0.SetCellString(0, 1, tmpoderablecamt)
			else
				camt = DATAMANAGER.GetDataValue(0, "obtro_acnt_151r", "OutBlock1", "CAMT", i)
				Grid0.SetCellData("bd_cell3", g_nStartRowNum + i, camt)				
			end if
		next
		
		g_nStartRowNum = g_nStartRowNum + tmpcnt
		
		if DATAMANAGER.IsMoreNextData("obtro_acnt_151r") == true then
			DATAMANAGER.RequestNextData("obtro_acnt_151r")
		end if
	elseif szTranID == "obtro_acnt_151r" and g_szControlSet = "1" then
		Grid0.SetClear()
		tmpflag = DATAMANAGER.GetDataValue(0, "obtro_acnt_151r", "OutBlock2", "IF_INTG_MARG_IQRY_YN", 0)
		
		if tmpflag == "Y" then
			lblMkt.visible = true
			cboMkt.visible = true
			lblCrcd.visible = true
			cboCrcd.visible = true
			
			Grid0.SetVisibleCol(5, true)
			
			Table0.SetCellString(0, 0, "합계("& cboCrcd.cbkeydata &")")
			Table0.SetCellString(0, 1, 0)
			Table0.visible = true
		else
			lblMkt.visible = false
			cboMkt.visible = false
			lblCrcd.visible = false
			cboCrcd.visible = false
			
			Grid0.SetVisibleCol(5, false)
			Table0.SetCellString(0, 0, "")
			Table0.SetCellString(0, 1, "")
			Table0.visible = false
		end if
		
		g_szControlSet = "0"
		btnSearch_OnClick()
	end if
End Sub



'============================================================================
Sub cboMkt_OnEditComplete(iIndex)
	
	DATAMANAGER.ClearInputData(0, "obtro_comn_302r")
	
	if trim(cboMkt.cbkeydata) <> "" then
		DATAMANAGER.SetDataValue(0, "obtro_comn_302r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , trim(cboMkt.cbkeydata))
		DATAMANAGER.RequestTranData("obtro_comn_302r")
	end if
	
End Sub



'============================================================================
Sub btnSearch_OnClick()
'	if edtPwd01.caption == "" then
'		Form.ShowAlert("알림", "비밀번호를 입력하세요.")
'		exit sub
'	end if
	
	g_nStartRowNum = 0
	g_szControlSet = "0"
	
	DATAMANAGER.ClearInputData(0,"obtro_acnt_151r" )
	
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "PROS_CLS_CODE", 0 , "2")
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "ACNO"		 , 0 , Left(acnt1.caption,8))
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "ASNO"		 , 0 , Right(acnt1.caption,2))
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "ACNT_PWD"	 , 0 , edtPwd01.caption )
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "CRCD"		 , 0 , cboCrcd.cbkeydata )
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , cboMkt.cbkeydata )
	
	DATAMANAGER.RequestTranData("obtro_acnt_151r")

End Sub

'============================================================================
Sub acnt1_ChangeAccount()
	edtPwd01.caption = ""
	Grid0.SetClear()
	Table0.SetCellString(0, 1, 0)
	
	ControlSet()
End Sub

'============================================================================
Sub cboCrcd_OnEditComplete(iIndex)
'	if edtPwd01.caption == "" then
'		Form.ShowAlert("알림", "비밀번호를 입력하세요.")
'		exit sub
'	end if

	
	DATAMANAGER.ClearInputData(0, "obtro_comn_302r")
	
	DATAMANAGER.SetDataValue(0, "obtro_comn_302r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , trim(cboMkt.cbkeydata))
	DATAMANAGER.RequestTranData("obtro_comn_302r")
End Sub


'============================================================================
Sub edtPwd01_OnEditComplete()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub ControlSet()
	g_szControlSet = "1"
	
	DATAMANAGER.ClearInputData(0,"obtro_acnt_151r" )
	
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "PROS_CLS_CODE", 0 , "2")
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "ACNO"		 , 0 , Left(acnt1.caption,8))
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "ASNO"		 , 0 , Right(acnt1.caption,2))
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "ACNT_PWD"	 , 0 , edtPwd01.caption )
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "CRCD"		 , 0 , "USD" )
	DATAMANAGER.SetDataValue(0, "obtro_acnt_151r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , "01" )
	
	DATAMANAGER.RequestTranData("obtro_acnt_151r")
End Sub


