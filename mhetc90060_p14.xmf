	<SCRIPT_INFO _len="930" _ulen="886" >
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.SendReturnToParent("mhetc90060_p14","")
	Form.CloseForm()
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_sRevData = Form.GetOpenLinkData()
	
	if g_sRevData == "new" then
		Button0.caption = "1회용 인증번호로 발급하기"
	elseif g_sRevData == "regi" then
		Button0.caption = "1회용 인증번호로 등록하기"
	end if
		
End Sub

'============================================================================
Sub Label1_OnClick()
	Form.SendCall("15883400")
End Sub

