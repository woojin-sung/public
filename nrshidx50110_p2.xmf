'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'===============================================
	' 뒤로가기 버튼 초기화
	'===============================================
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = g_szBackImg
	
	'===============================================
	' 타이틀 초기화
	'===============================================
	lblTitle.caption = g_szTitle
	lblTitle.paddinginfo = "0,0,0,0"
	
	'===============================================
	' 컨테이너 상단 초기설정
	'===============================================
	contMain.lblItemCnt.paddinginfo = "0,0,0,0"
	contMain.lblItemCnt.fgcolor = g_szTxtColor_Grey
	contMain.lblItemCnt.caption = "검색결과 0건"
	
	contMain.imgFilter.setMaintainingRatio("3")
	contMain.imgFilter.imgpath = g_szFilterImg
	
	contMain.lblFilter.paddinginfo = "0,0,0,0"
	contMain.lblFilter.maxlinecnt = "1"
	contMain.lblFilter.fgcolor = g_szTxtColor_Normal
	contMain.lblFilter.Caption = "필터"
	
	contMain.lblComp.paddinginfo = "0,0,0,0"
	contMain.lblComp.fgcolor = g_szTxtColor_White
	contMain.lblComp.imagefilepth = g_szCompImg_Normal
	
	btnClear.btnimage = "btn_21.9"
	btnSearch.btnimage = "btn_20.9"
	
	btnClear.fgcolor = g_szTxtColor_Normal
	btnSearch.fgcolor = g_szTxtColor_White
	
	contMain.lblLine0.bgcolor = g_szLineColor
	
	contMain.Pannel0.setDataNormal("1")
	
	btnClear.caption = "초기화"
	btnSearch.caption = "비교하기"
	
	btnClear.visible = false
	btnSearch.visible = false
	
	contMain.lblEmpty.paddinginfo = "0,0,0,0"
	contMain.lblEmpty.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty.top = 200
	contMain.lblEmpty.visible = false
	
	contMain.imgEmpty.maintainratio = "2"
	contMain.imgEmpty.imgpath = "icon_notice_3"
	contMain.imgEmpty.top = 150
	contMain.imgEmpty.visible = false
End Function

'===============================================
' 종목검색 서비스 호출 및 응답처리 
'===============================================

' ohhts_metf_002r 호출
Function RequestTranData_Search()
	DATAMANAGER.ClearInputData(0, "ohhts_metf_002r")
	
	if #g_arrInputData < 16 then
		exit Function
	end if
	
	if g_arrInputData(0) <> "" then
		arrTempData = split(g_arrInputData(0), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock1", "FID_INVT_REGN_NAME", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(1) <> "" then
		arrTempData = split(g_arrInputData(1), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock2", "FID_LSTN_NTNL_CODE", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(2) <> "" then
		arrTempData = split(g_arrInputData(2), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock3", "FID_UNAS_NAME" , i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(3) <> "" then
		arrTempData = split(g_arrInputData(3), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock4", "FID_LRDV_CODE_NAME", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(4) <> "" then
		arrTempData = split(g_arrInputData(4), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock5", "FID_MDDV_CODE_NAME", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(5) <> "" then
		arrTempData = split(g_arrInputData(5), "`")
		
		for i = 0 to #arrTempData-1
			szTempVal = arrTempData(i)
			if szTempVal = "BBB-- 이상" then
				szTempVal = "IG"
			elseif szTempVal = "BB+ 이하" then
				szTempVal = "HY"
			end if
		
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock6", "FID_SMDV_CODE_NAME", i , szTempVal)
		next
	end if
	
	if g_arrInputData(6) <> "" then
		arrTempData = split(g_arrInputData(6), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock7", "FID_INPUT_ASET_SCAL", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(7) <> "" then
		arrTempData = split(g_arrInputData(7), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock8", "FID_INPUT_LVRG", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(9) <> "" then
		arrTempData = split(g_arrInputData(9), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock10", "FIDX_MGCO_NAME", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(10) <> "" then
		arrTempData = split(g_arrInputData(10), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock11", "FIDX_INPUT_DVDN_CYCL", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(11) <> "" then
		arrTempData = split(g_arrInputData(11), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock12", "FID_INPUT_DVRT", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(12) <> "" then
		arrTempData = split(g_arrInputData(12), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock12", "FID_INPUT_DVRT2", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(13) <> "" then
		arrTempData = split(g_arrInputData(13), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock12", "FID_INPUT_ERT", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(14) <> "" then
		arrTempData = split(g_arrInputData(14), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_002r", "InBlock12", "FID_INPUT_ERT2", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(15) <> "" then
		arrTempData = split(g_arrInputData(15), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock12", "FID_INPUT_ERNN_PRD", i , arrTempData(i))
		next
	end if
	
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock13", "FIDX_INPUT_NTNL_CODE", 0 , g_szNationSet)
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock13", "FID_INPUT_RANK_SORT_CLS_CODE", 0 , g_szSortIdx)
	
	rtChk = Form.GetSharedData( "REALTIME_AX", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "AX")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 0 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_OQ", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 1 , "OQ")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 1 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_NY", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 2 , "NY")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 2 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_HK", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 3 , "HK")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 3 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_SH", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 4 , "SH")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 4 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_SZ", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 5 , "SZ")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 5 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_JP", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FID_INPUT_COND_MRKT_DIV_CODE", 6 , "JP")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_002r", "InBlock14", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 6 , rtChk)
	
	DATAMANAGER.RequestTranData("ohhts_metf_002r")
End Function

Function RequestNextTranData_Search()
	if DATAMANAGER.IsMoreNextData("ohhts_metf_002r") = true then
		DATAMANAGER.RequestNextData("ohhts_metf_002r") 
	end if
End Function

