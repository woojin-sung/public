Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_002r" then
		ResponseTranData_Search()
	elseif szTranID = "ohhts_metf_003r" then
		ResponseTranData_Search_Count()
	elseif szTranID = "ohhts_intr_006r" then
		ResponseTranData_Intr()
	end if
End Sub

'============================================================================
Sub contMain_Pannel0_OnClick(nIndex, sCellID)
	
	if sCellID <> "imgIntr" and sCellID <> "imgCompChk" and sCellID <> "btnHyun" and sCellID <> "btnChart" and sCellID <> "btnInfo" and sCellID <> "btnOrder0" and sCellID <> "btnOrder1" and sCellID <> "btnAlpha"then
		nTopRow = Cint(contMain.Pannel0.toprow)
		nGap = Cint(nIndex) - nTopRow
		
		nCurHeight = contMain.Pannel0.GetCardWHAt(nIndex)

		if g_nFoldHeight = nCurHeight then
			contMain.Pannel0.setPropCardCell("top","lblLine2", nIndex , g_nExpandHeight-1)
			contMain.Pannel0.SetCardWHAt(nIndex, g_nExpandHeight)
			
			if g_nPrev_Expand_Idx > -1 then
				if g_nPrev_Expand_Idx <> nIndex then
					contMain.Pannel0.setPropCardCell("top","lblLine2", g_nPrev_Expand_Idx , g_nFoldHeight-1)
					contMain.Pannel0.SetCardWHAt(g_nPrev_Expand_Idx, g_nFoldHeight)
				end if
			end if
			
			g_nPrev_Expand_Idx = nIndex
		
			if nGap > 5 then
				contMain.Pannel0.toprow = nTopRow + 2
			elseif nGap > 4 then
				contMain.Pannel0.toprow = nTopRow + 1
			end if
		else
			contMain.Pannel0.setPropCardCell("top","lblLine2", nIndex , g_nFoldHeight-1)
			contMain.Pannel0.SetCardWHAt(nIndex, g_nFoldHeight)
		end if
	
	else
		if (sCellID = "imgCompChk" or sCellID = "btnAlpha") and g_isCompChk = true then
			if nIndex = g_nCompChkIdx_1 then
				g_nCompChkIdx_1 = -1
				g_nCompChkCnt = g_nCompChkCnt - 1
'				btnClear.visible = false
'				btnSearch.visible = false
'				contMain.Pannel0.height = 662
				if g_nCompChkCnt <> 0 then
					btnClear.visible = true
					btnSearch.visible = true
					
					contMain.Pannel0.height = 602
				else
					btnClear.visible = false
					btnSearch.visible = false
					contMain.Pannel0.height = 662
				end if
				contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIndex, g_szChkImg_Normal)
			elseif nIndex = g_nCompChkIdx_2 then
				g_nCompChkIdx_2 = -1
				g_nCompChkCnt = g_nCompChkCnt - 1
'				btnClear.visible = false
'				btnSearch.visible = false
'				contMain.Pannel0.height = 662

				if g_nCompChkCnt <> 0 then
					btnClear.visible = true
					btnSearch.visible = true
					
					contMain.Pannel0.height = 602
				else
					btnClear.visible = false
					btnSearch.visible = false
					contMain.Pannel0.height = 662
				end if
				contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIndex, g_szChkImg_Normal)
			else
				if g_nCompChkCnt = 2 then
					Form.ShowAlert("안내", "2개 종목만 선택 가능합니다.")
				else
					g_nCompChkCnt = g_nCompChkCnt + 1
					if g_nCompChkIdx_1 = -1 then
						g_nCompChkIdx_1 = nIndex
					elseif g_nCompChkIdx_2 = -1 then
						g_nCompChkIdx_2 = nIndex
					end if
					
					if g_nCompChkCnt <> 0 then
						btnClear.visible = true
						btnSearch.visible = true
						
						contMain.Pannel0.height = 602
					else
						btnClear.visible = false
						btnSearch.visible = false
						contMain.Pannel0.height = 662
					end if
					
					contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIndex, g_szChkImg_Select)
				end if
			end if
		elseif (sCellID = "imgIntr" or sCellID = "btnAlpha") and g_isCompChk = false then
			
			g_szIntrItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",nIndex)
			g_szIntrIdx = nIndex
			
			szisIntr = Form.isIntrItemList(g_szIntrItemCd)
			
			if szisIntr = true then
				Form.OpenPopup("nrshidx50110_p4", g_szIntrItemCd& "★"& "DEL","", "")	'종목삭제
			else
				if CInt(g_szIntrGrpCnt) < 1 then
					g_szAction = "GROUP_ADD2"			
					Form.OpenPopup("nrshidx50110_p6", g_szAction & "★" & g_szIntrItemCd & "★", "")
				else
					Form.OpenPopupAnimation("nrshidx50110_p5", g_szIntrItemCd& "★"& "ADD","", "2")	'종목등록
				end if
			end if
		elseif sCellID = "btnHyun" then
			MovePopup(nIndex, 0)
		elseif sCellID = "btnChart" then
			MovePopup(nIndex, 1)
		elseif sCellID = "btnInfo" then
			MovePopup(nIndex, 2)
		elseif sCellID = "btnOrder0" then
			MovePopup(nIndex, 3)
		elseif sCellID = "btnOrder1" then
			MovePopup(nIndex, 4)	
		end if
	end if
End Sub

'============================================================================
Sub contMain_lblComp_OnClick()
	if g_nPrev_Expand_Idx > -1 then
		contMain.Pannel0.setPropCardCell("top","lblLine2", g_nPrev_Expand_Idx , g_nFoldHeight-1)
		contMain.Pannel0.SetCardWHAt(g_nPrev_Expand_Idx, g_nFoldHeight)
	end if
		
	
	
	if g_isCompChk = false then
		contMain.lblComp.imagefilepth = g_szCompImg_Select
		contMain.lblComp.fgcolor = g_szTxtColor_Red
		contMain.lblComp.caption = "비교해제"
		g_isCompChk = true
	else
		contMain.lblComp.imagefilepth = g_szCompImg_Normal
		contMain.lblComp.fgcolor = g_szTxtColor_White
		contMain.lblComp.caption = "종목비교"
		g_isCompChk = false
	end if
	
	DisplaySetting_IntrChk()
End Sub

'============================================================================
Sub contMain_btnFilter_OnClick()
	if g_szSaveFilterData1 = "" or g_szSaveFilterData1 = "★" or g_szSaveFilterData1 = "전체" or g_szSaveFilterData1 = "전체★" then
		g_szSaveFilterData1 = "전체★거래량 많은순"
	end if
	Form.OpenPopup("nrshidx50500_p1", "SCREENER★1★"&g_szFilterData1&"★"&g_szFilterData2&"★"&g_szSaveFilterData1 , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "50500_P1_RETURN_DATA_SCREENER" then
		arrOptionData = split(sRet, "★")
		
		g_szSaveFilterData1 = sRet
		
		g_szNationSet = "YNNNNN"
		if #arrOptionData > 0 then
			g_szNationSet = Make_NationSet(arrOptionData(0))
		end if
		
		g_szSortIdx = "0"
		if #arrOptionData > 1 then
			g_szSortIdx = Make_SortIndex(arrOptionData(1))
		end if
		
		arrTempData = split(arrOptionData(0), "`")
		szTempData = ""
		for i = 0 to #arrTempData-1
			if i = 0 then
				szTempData = arrTempData(i)
			else
				szTempData = szTempData & "·" &arrTempData(i)
			end if
		next
		
	
		
		contMain.lblFilter.fontsize = "-3"
		
		if g_szSaveFilterData1  = "전체★거래량 많은순" then
			contMain.lblFilter.maxlinecnt = "1"
			contMain.lblFilter.caption = "필터"
					
		elseif szTempData = "" and arrOptionData(1) = "" then
			contMain.lblFilter.maxlinecnt = "1"
			contMain.lblFilter.caption = "필터"
			g_szNationSet = ""
			g_szSortIdx = ""
		elseif szTempData = "" then
			contMain.lblFilter.maxlinecnt = "1"
			contMain.lblFilter.caption = arrOptionData(1)
			
		elseif arrOptionData(1) = "" then
			if szTempData = "전체" then
				szTempData = "필터"
			end if
		
			contMain.lblFilter.maxlinecnt = "1"
			contMain.lblFilter.caption = szTempData		
			
		else
			contMain.lblFilter.fontsize = "-2"
			contMain.lblFilter.maxlinecnt = "2"
			contMain.lblFilter.caption = szTempData & "\n" & arrOptionData(1)
		end if
		
		
		g_nCompChkIdx_1 = -1
		g_nCompChkIdx_2 = -1
		g_nCompChkCnt = 0
		
		contMain.lblComp.imagefilepth = g_szCompImg_Normal
		contMain.lblComp.fgcolor = g_szTxtColor_White
		contMain.lblComp.caption = "종목비교"
		g_isCompChk = false
		
		DisplaySetting_IntrChk()
	
		contMain.Pannel0.rowcount = 0
		RequestTranData_Search()
		RequestTranData_Search_Count()
	elseif sKeyName = "mhprc11000_save" then
		arrRet = split(sRet, "★")
		
		if arrRet(2) = "DEL" then
			Form.delIntrItemList(g_szIntrItemCd)
			contMain.Pannel0.setPropCardCell("imgpath","imgIntr", g_szIntrIdx, g_szIntrImg_Normal)
		else
			Form.addIntrItemList(g_szIntrItemCd)
			RequestTranData_Intr()
			contMain.Pannel0.setPropCardCell("imgpath","imgIntr", g_szIntrIdx, g_szIntrImg_Select)
		end if
		
	end if
End Sub

'============================================================================
Sub btnClear_OnClick()
	DisplaySetting_IntrChk()
End Sub

'============================================================================
Sub contMain_Pannel0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ohhts_metf_002r") = true then
		DATAMANAGER.RequestNextData("ohhts_metf_002r")
	end if
End Sub

'============================================================================
Sub btnSearch_OnClick()
	if g_nCompChkCnt <> 2 then
		Form.ShowAlert("안내", "비교할 종목을 선택해주세요.")
		Exit Sub
	end if
	'종목명★시장구분코드★종목코드★상장국가코드^종목명★시장구분코드★종목코드★상장국가코드
	szMktCd1 = contMain.Pannel0.getPropCardCell("caption","lblHideData1",g_nCompChkIdx_1)
	szItemCd1 = contMain.Pannel0.getPropCardCell("caption","lblHideData0",g_nCompChkIdx_1)
	szItemNm1 = contMain.Pannel0.getPropCardCell("caption","lblHideData2",g_nCompChkIdx_1)
	szNatCd1	= contMain.Pannel0.getPropCardCell("caption","lblHideData3",g_nCompChkIdx_1)
	if instr(szItemCd1, "@") > 0 then
		arrtemp = split(szItemCd1, "@")
		szItemCd1 = arrtemp(1)
	end if
	szData1 =szItemNm1& "★" & szMktCd1 & "★" & szItemCd1 & "★" & szNatCd1 
	
	szMktCd2 = contMain.Pannel0.getPropCardCell("caption","lblHideData1",g_nCompChkIdx_2)
	szItemCd2 = contMain.Pannel0.getPropCardCell("caption","lblHideData0",g_nCompChkIdx_2)
	
	szItemNm2 = contMain.Pannel0.getPropCardCell("caption","lblHideData2",g_nCompChkIdx_2)
	szNatCd2	= contMain.Pannel0.getPropCardCell("caption","lblHideData3",g_nCompChkIdx_2)
	if instr(szItemCd2, "@") > 0 then
		arrtemp = split(szItemCd2, "@")
		szItemCd2 = arrtemp(1)
	end if
	szData2 = szItemNm2& "★" & szMktCd2 & "★" & szItemCd2 & "★" & szNatCd2 
	
	Form.openPopupAnimation("nrshidx50150", szData1&"@"&szData2, "", "2")
	'Form.OpenPopup("nrshidx50150" , szData1&"@"&szData2 , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REFRESH_INTR_ITEM" then
	
		nRowCnt = Cint(contMain.Pannel0.rowcount)
		for i = 0 to nRowCnt-1
			szItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",i)
			
			isIntrItem = Form.isIntrItemList(szItemCd)
			
			contMain.Pannel0.setPropCardCell("maintainratio", "imgIntr", i, "3")
			if szIntrYN = true then
				contMain.Pannel0.setPropCardCell("imgpath","imgIntr", i, g_szIntrImg_Select)
			else
				contMain.Pannel0.setPropCardCell("imgpath","imgIntr", i, g_szIntrImg_Normal)
			end if
		next
	end if
End Sub
