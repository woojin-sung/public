		arrTempData = split(g_arrInputData(12), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock12", "FID_INPUT_DVRT2", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(13) <> "" then
		arrTempData = split(g_arrInputData(13), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock12", "FID_INPUT_ERT", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(14) <> "" then
		arrTempData = split(g_arrInputData(14), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock12", "FID_INPUT_ERT2", i , arrTempData(i))
		next
	end if
	
	if g_arrInputData(15) <> "" then
		arrTempData = split(g_arrInputData(15), "`")
		
		for i = 0 to #arrTempData-1
			DATAMANAGER.SetDataValue(0,"ohhts_metf_003r", "InBlock12", "FID_INPUT_ERNN_PRD", i , arrTempData(i))
		next
	end if
	
	DATAMANAGER.SetDataValue(0,"ohhts_metf_003r", "InBlock13", "FIDX_INPUT_NTNL_CODE", 0 , g_szNationSet)
	DATAMANAGER.SetDataValue(0,"ohhts_metf_003r", "InBlock13", "FID_INPUT_RANK_SORT_CLS_CODE", 0 , g_szSortIdx)
	
	DATAMANAGER.RequestTranData("ohhts_metf_003r")
End Function

Function ResponseTranData_Search_Count()
	nDataCnt = DATAMANAGER.GetDataValue(0, "ohhts_metf_003r", "OutBlock1", "FID_ISSU_CNT" , 0)
	
	if  Cint(nDataCnt) = 0  then

		contMain.lblEmpty.visible = true
		contMain.imgEmpty.visible = true
	else
		contMain.lblEmpty.visible = false
		contMain.imgEmpty.visible = false
	end if 
	
	contMain.lblItemCnt.caption = "검색결과 "&Cint(nDataCnt)&"건"
End Function

' ohhts_metf_002r 응답
Function ResponseTranData_Search()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_002r", "OutBlock1")
	for i = 0 to nDataCnt-1
		'종목코드
		szItem_Cd 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_OVRS_ISCD", i)
		'종목명
		szItem_Nm 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FIDX_KOR_ISNM", i)
		'현재가
		szItem_Prc 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_PRPR", i)
		
		szItem_1 	= DATAMANAGER.GetDataAttr (0, "ohhts_metf_002r", "OutBlock1", "FID_PRDY_VRSS_SIGN", i)
		szItem_2		= DATAMANAGER.GetDataAttr (0, "ohhts_metf_002r", "OutBlock1", "FID_PRDY_CLPR_VRSS", i)
		
		'전일대비율
		szItem_Rate_Attr	= DATAMANAGER.GetDataAttr(0, "ohhts_metf_002r", "OutBlock1", "FID_PRDY_CTRT", i)
		szItem_Rate 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_PRDY_CTRT", i)
		
		'거래량
		szItem_Vol 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_VOL", i)
		'총보수비율
		szItem_Pay		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_TOTAL_PAY_RATE", i)
		'NAV
		szItem_NAV 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FIDX_NAV", i)
		
		'거래정지여부
		szItem_Stop 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_TRHT_YN", i)
		'신규상장여부
		szItem_New 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_NEW_LSTN_YN", i)
		
		'상장국가코드
		szItem_NationCd 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_LSTN_NTNL_CODE", i)
		'입력시장구분코드
		szItem_MrktCd 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i)
		
		'배당수익률
		szItem_Alloc		= DATAMANAGER.GetDataValue(0, "ohhts_metf_002r", "OutBlock1", "FID_DVDN_ERT", i)
	
		nIdx = contMain.Pannel0.addRow()
		
		'종목코드 & 시장조치(거래정지/신규상장)
		szItemCd = szItem_Cd
		if g_isAlloc == true and cdbl(szItem_Alloc) <> 0 then
			szItemCd = szItemCd & " | " & "연배당률 " & FormatNumber(szItem_Alloc, 2) & "%"
		end if
		
		if szItem_Stop = "Y" then
			szItemCd = szItemCd & " | " & "거래정지"
		end if
		
		if szItem_New = "Y" then
			szItemCd = szItemCd & " | " & "신규상장"
		end if
		
		'현재가 & 수익률
		if szItem_MrktCd = "AX" or szItem_MrktCd = "NY" or szItem_MrktCd = "OQ" then
			szPrc = FormatNumber(szItem_Prc,4)
		elseif szItem_MrktCd = "JP" then
			szPrc = FormatNumber(szItem_Prc,1)
		elseif szItem_MrktCd = "SH" or szItem_MrktCd = "SZ" then
			szPrc = FormatNumber(szItem_Prc,3)
		elseif szItem_MrktCd = "HK" then
			szPrc = FormatNumber(szItem_Prc,3)
		else
			szPrc = FormatNumber(szItem_Prc,0)
		end if
		szPrcRate = szPrc & " | " & FormatNumber(szItem_Rate,2) & "%"
		
		szOsType = Form.GetSharedData("&OS_TYPE", false)
		if szOsType = "2" then
			if Cdbl(szItem_Rate) > 0 then
				szItem_Rate_Attr = "43"
			elseif Cdbl(szItem_Rate) < 0 then
				szItem_Rate_Attr = "45"
			else
				szItem_Rate_Attr = ""
			end if
		end if
		
		'보수율
		nItem_Pay = FormatNumber(szItem_Pay,4)
		szPayRate = ""
		if nItem_Pay = "0.0000" then
			szPayRate = "보수 -"
		else
			szPayRate = "보수 " &  nItem_Pay & "%"
		end if
		
		'NAV
		nNav = FormatNumber(szItem_NAV,2)
		szNav = ""
		if nNav = "0.00" then
			szNav = "NAV -"
		else
			szNav = "NAV " & FormatNumber(szItem_NAV,2)
		end if
		
		'거래량
		szVol = ""
		if Clng(szItem_Vol) = 0 then
			szVol = "거래량 -"
		else
			szVol = "거래량 " & FormatNumber(szItem_Vol, 0)
		end if
		
		
		'국기이미지
		szFlag = Form.getIconImg("FLAG", szItem_NationCd)
		if szFlag = "" then
			szFlag = "flag_general"
		end if

		'관심종목 포함여부
		szIntrCd = ""
		if szItem_NationCd = "KOR" then
			szIntrCd = szItem_Cd
		else
			szIntrCd = szItem_MrktCd&"@"&szItem_Cd
		end if

		isIntrItem = Form.isIntrItemList(szIntrCd)
	
		'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드
		DisplaySetting_Pannel(nIdx, szItemCd, szItem_Nm, szPrcRate, szItem_Rate_Attr, szFlag, szItem_Lvrg, isIntrItem, szPayRate, szNav, szVol, szIntrCd, szItem_MrktCd, szItem_Nm, szItem_NationCd) 
	next
	
	szidx = Form.GetSharedData("50110_ROW_INDEX", false)
	if g_isPrev = "1" and szidx <> "" then
		nRowCnt = contMain.Pannel0.rowcount
		nIdx = Cint(szidx)
		
		if Cint(nRowCnt) < nIdx+1 then
			RequestNextTranData_Search()
		else
			contMain.Pannel0.toprow = nIdx
			Form.GetSharedData("50110_ROW_INDEX", true)
			g_isPrev = "0"
		end if
	end if
End Function

'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드
Function DisplaySetting_Pannel(nIdx, szItemCd, szItemNm, szPrcRate, szPrcRateAttr, szFlag, szScale, szIntrYN, szData0, szData1, szData2, szHideData0, szHideData1, szHideData2, szHideData3) 
	'상단 라인표시
	contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor)
	
	'종목 국가 국기이미지 
	contMain.Pannel0.setPropCardCell("maintainratio", "imgFlag", nIdx, "2")
	contMain.Pannel0.setPropCardCell("imgpath","imgFlag", nIdx, szFlag)
	
	'관심종목 아이콘 (관심등록 여부 확인 후 표시 필요)
	contMain.Pannel0.setPropCardCell("maintainratio", "imgIntr", nIdx, "3")
	if szIntrYN = true then
		contMain.Pannel0.setPropCardCell("imgpath","imgIntr", nIdx, g_szIntrImg_Select)
	else
		contMain.Pannel0.setPropCardCell("imgpath","imgIntr", nIdx, g_szIntrImg_Normal)
	end if
	
	contMain.Pannel0.setPropCardCell("maintainratio", "imgCompChk", nIdx, "3")
	contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIdx, g_szChkImg_Normal)
		
	if g_isCompChk = false then
		contMain.Pannel0.setPropCardCell("visible","imgCompChk", nIdx, false)
		contMain.Pannel0.setPropCardCell("visible", "imgIntr", nIdx, true)
	else
		contMain.Pannel0.setPropCardCell("visible","imgCompChk", nIdx, true)
		contMain.Pannel0.setPropCardCell("visible", "imgIntr", nIdx, false)
	end if
		
	'종목명
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemName",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemName",nIdx, g_szTxtColor_Normal)
	contMain.Pannel0.setPropCardCell("maxlinecnt","lblItemName",nIdx, "1^-4")
	contMain.Pannel0.setPropCardCell("fontsize","lblItemName",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemName",nIdx, szItemNm)
	
	'종목코드(시장조치)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemCode",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemCode",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemCode",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemCode",nIdx, szItemCd)
	
	'현재가(전일대비)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemPrc",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemPrc",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemPrc",nIdx, szPrcRate)
	
	arrTemp = split(szPrcRate, "|")

'	if #arrTemp > 1 then
'		nLen_Prc = Form.getLen(arrTemp(0))
'		nLen_Rate = Form.getLen(arrTemp(1))
'	
'		contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc & "^1^333^-2^false^"&szPrcRate&"^2" )
'		
'		if szPrcRateAttr = "43" then
'			contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^290^-2^true^" & szPrcRate & "^2" )
'		elseif szPrcRateAttr = "45" then
'			contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^291^-2^true^" & szPrcRate & "^2" )
'		else
'			contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^333^-2^true^" & szPrcRate & "^2" )
'		end if
'	else	
		if trim(szPrcRateAttr) = "43" then
			contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Buy)
		elseif trim(szPrcRateAttr) = "45" then
			contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Sell)
		else
			contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
		end if
'	end if
	
	'보수
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData0",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData0",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData0",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData0",nIdx, szData0)
	
	'NAV
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData1",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData1",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData1",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData1",nIdx, szData1)
	
	'거래량
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData2",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData2",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData2",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData2",nIdx, szData2)
	
	'(숨김)종목코드
	contMain.Pannel0.setPropCardCell("caption","lblHideData0",nIdx, szHideData0)
	contMain.Pannel0.setPropCardCell("caption","lblHideData1",nIdx, szHideData1)
	contMain.Pannel0.setPropCardCell("caption","lblHideData2",nIdx, szHideData2)
	contMain.Pannel0.setPropCardCell("caption","lblHideData3",nIdx, szHideData3)
	
	'화면연동 버튼
	contMain.Pannel0.setPropCardCell("paddinginfo","btnHyun",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnHyun",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnChart",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnChart",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnInfo",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnInfo",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder0",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder0",nIdx, g_szTxtColor_White)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder1",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder1",nIdx, g_szTxtColor_White)
End Function

Function DisplaySetting_IntrChk()
	nDataCnt = Clng(contMain.Pannel0.rowcount)
	
	g_nCompChkIdx_1 = -1
	g_nCompChkIdx_2 = -1
	g_nCompChkCnt = 0
	
	btnClear.visible = false
	btnSearch.visible = false
	contMain.Pannel0.height = 662	
		
	for i = 0 to nDataCnt-1
		contMain.Pannel0.setPropCardCell("maintainratio", "imgCompChk", i, "3")
		contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", i, g_szChkImg_Normal)
	
		if g_isCompChk = false then
			contMain.Pannel0.setPropCardCell("visible","imgCompChk", i, false)
			contMain.Pannel0.setPropCardCell("visible", "imgIntr", i, true)
		else
			contMain.Pannel0.setPropCardCell("visible","imgCompChk", i, true)
			contMain.Pannel0.setPropCardCell("visible", "imgIntr", i, false)
		end if
	next 
End Function

Function RequestTranData_Intr()
	DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
	DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function


Function MovePopup(nidx, nGbn)
	szMktCd = contMain.Pannel0.getPropCardCell("caption","lblHideData1",nidx)
	szItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",nidx)
	szItemNm = contMain.Pannel0.getPropCardCell("caption","lblHideData2",nidx)
	
	Form.SetSharedData("50100_INDEX", "0")	
	Form.SetSharedData("50110_ROW_INDEX", nidx)
	Form.SetSharedData("50110_FILTER" , g_szSaveFilterData1)
	
	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			if nGbn == 0 then						' 현재가
				Form.OpenScreen("16000", szItemCd&"★ETF★1")				
			elseif nGbn == 1 then					' 차트
				Form.OpenScreen("16020", "")
			elseif nGbn == 2 then				
				Form.OpenScreen("16000", szItemCd&"★ETF★0")		
			elseif nGbn == 3 then					' 매수
				Form.OpenScreen("16060", "0")
			elseif nGbn == 4 then					' 매도
				Form.OpenScreen("16060", "1")
			end if
			
			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", szItemCd)
		Case Else
			if nGbn == 0 then							' 현재가
				Form.OpenScreen("11000", szItemCd&"★ETF★1")
			elseif nGbn == 1 then						' 차트
				Form.OpenScreen("13000", szItemCd)
			elseif nGbn == 2 then						' 뉴스
				Form.OpenScreen("11000", szItemCd&"★ETF★0")
			elseif nGbn == 3 then						' 매수
				Form.OpenScreen("12000", "스크리너★0" & "★" & szItemCd)
			elseif nGbn == 4 then						' 매도
				Form.OpenScreen("12000", "스크리너★1" & "★" & szItemCd)
			end if
			
			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", "J@"&szItemCd)
	End Select

End Function


Function Make_NationSet(szData)
	szResult = ""
	
	if instr(szData, "전체") > 0 then
		szResult = "YNNNNN"
	else
		szResult = "N"
		if instr(szData, "국내") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "미국") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "중국") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "홍콩") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "일본") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if szResult = "NNNNNN" then
			szResult = "YNNNNN"
		end if
	end if
	
	return szResult
End Function

Function Make_SortIndex(szData)
	szResult = "0"
	
	if szData = "상승률 높은순" then
		szResult = "1"
	elseif szData = "상승률 낮은순" then
		szResult = "2"	
	elseif szData = "거래량 많은순" then
		szResult = "3"
	elseif szData = "보수 낮은순" then
		szResult = "4"
	elseif szData = "거래량 적은순" then
		szResult = "5"
	elseif szData = "보수 높은순" then
		szResult = "6"
	elseif szData = "배당 낮은순" then
		szResult = "7"
	elseif szData = "배당 높은순" then
		szResult = "8"
	end if
	
	return szResult
End Function

