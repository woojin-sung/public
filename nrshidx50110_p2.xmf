'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
	
	Form.SaveConfigData("img_flag", "KOR", "flag_kor_round")
	Form.SaveConfigData("img_flag", "USA", "flag_us2")
	Form.SaveConfigData("img_flag", "CHN", "flag_chn")
	Form.SaveConfigData("img_flag", "JPN", "flag_jp2")
	Form.SaveConfigData("img_flag", "HKG", "flag_hk")
	
	'관심종목 리스트 조회
	Form.requestIntrItemList("00")
	RequestTranData_Intr()
	
	Dim szData
	szData = Form.GetOpenLinkData()
	g_arrInputData = split(szData, "★")

	if #g_arrInputData > 17 then
		g_isPrev = "1"
		
		if g_arrInputData(10) <> "" or g_arrInputData(11) <> "" or g_arrInputData(12) <> "" then
			g_isAlloc = true
			g_szFilterData2 = "상승률 낮은순`상승률 높은순`거래량 적은순`거래량 많은순`보수 낮은순`보수 높은순`배당 낮은순`배당 높은순"
		else
			g_isAlloc = false
			g_szFilterData2 = "상승률 낮은순`상승률 높은순`거래량 적은순`거래량 많은순`보수 낮은순`보수 높은순"
		end if 
		
		if g_arrInputData(17) = "1" then
			szFilter = Form.GetSharedData("50110_FILTER" , true)
			g_szSaveFilterData1 = szFilter
			
			if g_szSaveFilterData1 <> "" then
				arrOptionData = split(g_szSaveFilterData1, "★")
				
				g_szNationSet = "YNNNNN"
				if #arrOptionData > 0 then
					g_szNationSet = Make_NationSet(arrOptionData(0))
				end if
				
				g_szSortIdx = "0"
				if #arrOptionData > 1 then
					g_szSortIdx = Make_SortIndex(arrOptionData(1))
				end if
				
				arrTempData = split(arrOptionData(0), "`")
				szTempData = ""
				for i = 0 to #arrTempData-1
					if i = 0 then
						szTempData = arrTempData(i)
					else
						szTempData = szTempData & "·" &arrTempData(i)
					end if
				next
				
				contMain.lblFilter.fontsize = "-3"
				
				if g_szSaveFilterData1  = "전체★거래량 많은순" then
					contMain.lblFilter.maxlinecnt = "1"
					contMain.lblFilter.caption = "필터"
				
				elseif szTempData = "" and arrOptionData(1) = "" then
					contMain.lblFilter.maxlinecnt = "1"
					contMain.lblFilter.caption = "필터"
					g_szNationSet = ""
					g_szSortIdx = ""
				elseif szTempData = "" then
					contMain.lblFilter.maxlinecnt = "1"
					contMain.lblFilter.caption = arrOptionData(1)
					
				elseif arrOptionData(1) = "" then
					if szTempData = "전체" then
						szTempData = "필터"
					end if
				
					contMain.lblFilter.maxlinecnt = "1"
					contMain.lblFilter.caption = szTempData		
				else
					
					contMain.lblFilter.fontsize = "-2"
					contMain.lblFilter.maxlinecnt = "2"
					contMain.lblFilter.caption = szTempData & "\n" & arrOptionData(1)
				end if
			else
				contMain.lblFilter.fontsize = "-3"
				contMain.lblFilter.maxlinecnt = "1"
				contMain.lblFilter.caption = "필터"
				g_szNationSet = ""
				g_szSortIdx = ""
			end if
			
			contMain.Pannel0.rowcount = 0
			RequestTranData_Search()
			RequestTranData_Search_Count()
		else
			g_isPrev = "0"
			nCnt = g_arrInputData(16)
			contMain.lblItemCnt.caption = "검색결과 "&nCnt&"건"
			
			RequestTranData_Search()	
		end if
		
	end if
End Sub

