	<SCRIPT_INFO _len="5769" _ulen="5254" >

Dim g_szHndvMthdCode
Dim g_szPhoneNum, g_szPhoneInagTypeCode, g_szPhoneInagSrno		'알림톡/문자 정보
Dim g_szEmail, g_szEmailInagTypeCode, g_szEmailInagSrno		'이메일 정보

'============================================================================
Sub Form_OnFormInitBefore()
	imgAmtInfo.setMaintainingRatio("1")
	imgCtcnInfo.setMaintainingRatio("1")
	imgTooltip.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	btnNext.enable = false
	if Form.GetEnvData("common.theme") = "black" then
		btnNext.btnimage = "btn_27.9"
	else
		btnNext.btnimage = "btn_21.9"
	end if
	btnNext.fgcolor = "269"

	
	'등록된 휴대폰번호, 이메일 조회
	if acnt.caption <> "" and acnt.caption <> null then
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		Dim nCnt, nCnt1
		if DATAMANAGER.IsMoreNextData(szTranID) = True then
			DATAMANAGER.RequestNextData(szTranID)
		else
			'이메일 주소
			nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			for i = 0 to nCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    if strInagTypeCode2 = "21" then
					g_szEmail = strAddr
					g_szEmailInagTypeCode = strInagTypeCode2
					g_szEmailInagSrno = strInagSrno2
			    end if
			next 	
			'휴대폰 번호
			nCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			for i = 0 to nCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)
			    if strInagTypeCode3 = "13" then
				    g_szPhoneNum = strCustTelno
				    g_szPhoneInagTypeCode = strInagTypeCode3
				    g_szPhoneInagSrno = strInagSrno3
			    end if
			next
		end if
		
		'재조회 시 표시영역에 바뀐 정보 보여줌
		if CInt(rdoCtcn.currentindex) == 0 then
			tblCtcn.SetCellString(0, 0, g_szPhoneNum)
			lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
		elseif CInt(rdoCtcn.currentindex) == 1 then
			tblCtcn.SetCellString(0, 0, g_szEmail)
			lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
Sub rdoCtcn_OnClick(nIndex)
	tblCtcn.visible = true
	lblCtcnInfo.visible = true
	imgCtcnInfo.visible = true
	
	if nIndex == 0 then
		g_szHndvMthdCode = "04"
		
		tblCtcn.SetCellString(0, 0, g_szPhoneNum)
		lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
	else
		g_szHndvMthdCode = "02"
		
		tblCtcn.SetCellString(0, 0, g_szEmail)
		lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
	end if
	
	btnNext.enable = true
	
	btnNext.btnimage = "btn_20.9"
	btnNext.fgcolor = "273"
End Sub

'============================================================================
Sub tblCtcn_OnClick(lRow , lColumn)
	'연락처 정보 변경
	if lRow == 0 and lColumn == 1 then
		Form.OpenFramePopup("mbonl81000" , "" , "")
	end if
End Sub

'============================================================================
Sub imgTooltip_OnClick()
	imgTooltip.openToolTip("약관, 설명서 등 확인 서류를\n알림톡·문자 또는 이메일로 받을 수 있어요.", 300, 60, 1)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'연락처 변경
	if sKeyName == "mbonl81000" and sRet == "ok" then
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	end if
End Sub

'============================================================================
Sub btnNext_OnClick()
	Dim szRetData
	if g_szHndvMthdCode == "04" then
		szRetData = g_szHndvMthdCode & "★" & g_szPhoneNum & "★" & g_szPhoneInagSrno
	else
		szRetData = g_szHndvMthdCode & "★" & g_szEmail & "★" & g_szEmailInagSrno
	end if
	Form.SendReturnToParent("mbbnk63010_p13" , szRetData)
	Form.CloseForm()
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

