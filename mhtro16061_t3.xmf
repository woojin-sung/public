'============================================================================
Sub Form_OnFormInitBefore()
	Load_OrderSet()	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetCtlProp("cld0", "addday", "-3")
	DATAMANAGER.RequestTranData( "obtro_oder_114r" )
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno,szAsno, szAcpw
	szAcno = Form.GetTopCtlProp("acnt", 		"total")
	szAsno = Form.GetTopCtlProp("acnt", 		"sequence")
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcpw = Form.GetTopCtlProp("edtPwd", 	"caption")
	'MTS메모리평문제거 미적용상태일 때
	else	
		szAcpw = Form.GetTopCtlProp("edtPwd", 	"encdata")
	end if
	'20200910 SWJ END
	
	If szTranID = "obtro_oder_114r" Then
		DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ACNO" 		, 0 , szAcno 	)	' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ASNO" 		, 0 , szAsno 	)	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ACNT_PWD" 	, 0 , szAcpw	)	' 계좌비밀번호
	
	ElseIf szTranID = "obtro_oder_113a" Then		'예약취소
		DATAMANAGER.SetDataValue( 0, "obtro_oder_113a", "InBlock1", "ACNO"			, 0 , szAcno		)  	' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_113a", "InBlock1", "ASNO"			, 0 , szAsno 		)  	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_113a", "InBlock1", "ACNT_PWD"		, 0 , szAcpw 		)	' 계좌비밀번호
			
		DATAMANAGER.SetDataValue( 0, "obtro_oder_113a", "InBlock1", "ODER_RSEV_MST_DATE"	, 0 , g_szDate	)	' 주문예약마스터일자(8) - 2019.10.14
		DATAMANAGER.SetDataValue( 0, "obtro_oder_113a", "InBlock1", "ODER_RSEV_MST_NO"	, 0 , g_szOrdNo	)	' 주문예약마스터번호    - 2019.10.14
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtro_oder_114r" Then
		
		For i = 0 To grd0.rowcount -1 
			
'			szDecimal = grd0.GetCellData( "bd_cell7"	, i)
'			
'			szOdrPrc = grd0.GetCellData("bd_cell14", i)
'			szOdrPrc2 = Set_Unit(CDbl(szOdrPrc), szDecimal)
'			grd0.SetCellData("bd_cell14", i, szOdrPrc2)
			
			szType    = grd0.GetCellData( "bd_cell6"	, i)	'매매구분
			rSevType  = grd0.GetCellData( "bd_cell8"	, i)	'주문예약구분코드     - 2019.10.14
			hOurType  = grd0.GetCellData( "bd_cell18", i)	'주문예약시간구분코드 - 2019.10.14
			
			'20201124 LES START 해외주식 시장가매도
			szOrdType = grd0.GetCellData("bd_cell22", i)
			' 버튼 폰트색		
			grd0.SetCellData("bd_cell21", i, "취소")
			grd0.SetCellFgColor( "bd_cell21", i, "4")
			
			
			Select Case szOrdType
				Case "1"
					grd0.SetCellData("bd_cell12", i, "지정가")
				Case "2"
					grd0.SetCellData("bd_cell12", i, "시장가")
				Case "4"
					grd0.SetCellData("bd_cell12", i, "LOO")
				Case "5"
					grd0.SetCellData("bd_cell12", i, "LOC")
				Case "6"
					grd0.SetCellData("bd_cell12", i, "MOO")
				Case "7"
					grd0.SetCellData("bd_cell12", i, "MOC")
				Case "8"
					grd0.SetCellData("bd_cell12", i, "Limit VWAP")
				Case "9"
					grd0.SetCellData("bd_cell12", i, "Limit TWAP")
				Case "A"
					grd0.SetCellData("bd_cell12", i, "VWAP")
				Case "B"
					grd0.SetCellData("bd_cell12", i, "TWAP")
			End Select
			
			
			'20201124 LES END
			
			
			
			
			'주문종류
			Select Case szType
				Case "1"	
					
					'20201124 LES START 해외주식 시장가매도
					grd0.SetCellFgColor( "bd_cell2", i, "2" )
					
					'20201021 LES START 해외주식 매도상환
					szGubun = grd0.GetCellData("bd_cell15", i)
					
					if szGubun = "0251" then
						grd0.SetCellData( "bd_cell2", i, "예탁담보매도" )
					else
						grd0.SetCellData( "bd_cell2", i, "매도" )
					end if
					'20201021 LES END
					
					
				Case "2"	
					grd0.SetCellFgColor( "bd_cell2", i, "1" )
					grd0.SetCellData( "bd_cell2", i, "매수")
			End Select
			
			'주문예약구분코드 - 2019.10.14
			Select Case rSevType
				Case "1"
					grd0.SetCellData( "bd_cell8", i, "일반예약")
				Case "2" 
					grd0.SetCellData( "bd_cell8", i, "기간잔량")
				Case "3" 
					grd0.SetCellData( "bd_cell8", i, "기간예약")
				Case "4" 
					grd0.SetCellData( "bd_cell8", i, "특정일주문")
			End Select
			
			'주문예약시간구분코드 - 2019.10.14
			Select Case hOurType
				Case "0"
					grd0.SetCellData( "bd_cell18", i, "장개시")
				Case "1" 
					grd0.SetCellData( "bd_cell18", i, "장마감10분전")
				Case "2" 
					grd0.SetCellData( "bd_cell18", i, "장마감30분전")
				
				'20200911 LES START 예약시간 추가
				Case "3" 
					grd0.SetCellData( "bd_cell18", i, "장개시30분후")
				'20200911 LES END
				
				
			End Select
			
		Next
				
	ElseIf szTranID = "obtro_oder_113a" Then
		
		g_szTR = ""
			
		szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
		szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
		
		if Trim(szOrdCd) = "5620" then			' 정상주문
			Form.Toast(0, szOrdMsg, true)
			
			if g_szAfterInit = "1" then		' 주문후 초기화
				Init_InputControl()
			end if
		end if
		
		g_szPopupData = ""
		btnSearch_OnClick()		
		
	End If
End Sub

'============================================================================
Sub btnSearch_OnClick()
	If Check_Accout() = False Then
		Exit Sub
	End If
		
	DATAMANAGER.RequestTranData( "obtro_oder_114r" )
End Sub

'============================================================================


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "주문전송" Then
		OrderRequest()
	End If	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
'		Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
'		Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then	
		btnSearch_OnClick()
	
	'20160502 LKM START - 계좌변경 
	elseif sEventName = "ChangeAcnt" Then
		
		grd0.rowcount = 0	'기존내역 Clear
			
		If Check_Accout() = False Then
			Exit Sub
		End If
		
		btnSearch_OnClick()
	'20160502 LKM END
	End If
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	'20201124 LES START 해외주식 시장가 매도
	If szCellID == "bd_cell21" Then
		Call Check_Order(lRow)
	End If
End Sub


