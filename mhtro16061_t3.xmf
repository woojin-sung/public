	<SCRIPT_INFO _len="16064" _ulen="14376" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문의 주문내역 조회 화면
' 03. 작    성 : 2016.04.30 LJS
'     수    정 : 2019.10.14 이현우
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'*****************************************ㅋ***********************************
Dim gszSet_OrdChkPop  		'주문확인창표시
Dim g_szMarketType 		'주문종류 ( J:주식, W:ELW, T:프리보드 )
	g_szMarketType 	= "J"

'주문확인창 및 주문에 사용
Dim	g_szItmCode			'종목코드
Dim	g_szOrdNo			'원주문번호	
Dim 	g_szOrd_SecDate		'대출일자
Dim	g_szOrd_ChkAll		'잔량전부

Dim g_szWarnClsCode		'경고메시지코드
	g_szWarnClsCode	= "N"

Dim g_szPopupData			'주문확인창 데이터

Dim g_szTitle
g_szTitle = "알림"

Dim	g_szDate				'예약등록일자

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm = ""
	
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'	주문설정값 가져오기
'============================================================================
Function Load_OrderSet()
	'주문확인창 설정
	gszSet_OrdChkPop = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창	
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
End Function

'============================================================================
'	계좌번호/비밀번호 확인
'	내역조회는 비밀번호 없이 조회가능하도록 수정함. 20160502 LKM 
'	주문올릴때만 비밀번호 확인하도록 로직 수정
'============================================================================
Function Check_Accout()
'	20160502 LKM START
	Dim szAcctNo
	szAcctNo = Form.GetTopCtlProp("acnt", "caption")
	
    If Len(Trim(szAcctNo)) < 10 Then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If

	Check_Accout = True
	
'ORG
'	Dim szAcctNo, szAcpw
