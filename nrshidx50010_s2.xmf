<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50010" scrname="ETF(HOME)_투자가이드" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,193,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fontsize="2" fontstyle="01" caption="ETF 투자 첫걸음" bgcolor="029:255212175" ly_vert="20,30,250,23,1" />
		<LABEL name="Label1" fontsize="-2" caption="ETF 투자가 처음이신가요?
투자가이드에서 확인하세요." bgcolor="035:237246255" valign="0" multiline="1" ly_vert="20,63,250,50,1" />
		<BUTTON name="Button0" caption="투자가이드" fontsize="-2" ly_vert="20,119,163,44,1" />
		<BUTTON name="Button1" caption="자주하는 질문" fontsize="-2" ly_vert="193,119,163,44,1" />
		<IMAGE name="Image0" imgpath="icon_guidebook" ly_vert="275,30,80,80,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1684" _ulen="1588" >
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	' 이미지세팅
	'--------------------------------------------------------------
	Image0.setMaintainingRatio("1")
	Image0.imgpath = "icon_guidebook"

	'--------------------------------------------------------------
	' 라벨 설정 값
	'--------------------------------------------------------------
	Label0.paddinginfo = "0,0,0,0"
	Label1.paddinginfo = "0,0,0,0"
	
	Label1.fgcolor = 333
	Button0.fgcolor = 334
	Button1.fgcolor = 334
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		Label1.fontsize = - Cint((gsLargeFontsize * 2))
	
	end if	
	
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.triggerEvent("#", "SAVE_ETF_HOME_SCROLL", "")
	Form.OpenScreen("50200" , "0") '투자가이드
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.triggerEvent("#", "SAVE_ETF_HOME_SCROLL", "")
	Form.OpenScreen("50200" , "1") '자주하는 질문
End Sub

	</SCRIPT_INFO>
</ROOT>