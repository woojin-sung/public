	<SCRIPT_INFO _len="2850" _ulen="2638" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_기타금융상품_외화표시펀드
' 02. 화면설명 : 고객자산평가_상품별잔고_기타금융상품_외화표시펀드
' 03. 작    성 : 2016. 02. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szList
	
	if sEventName == "기타_외화표시펀드" then
	
		szList = Split(sParam,"○")
		
		if UBOUND(szList) < 1 then
			Exit Sub
		End if
		
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_079r", "InBlock1", "ACNO" , 0 , szList(0) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_079r", "InBlock1", "ACNT_PWD" , 0 , szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_079r", "InBlock1", "STND_DATE" , 0 , szList(2) )	'날짜
	end if
	
	g_nNextCount = 0
	DATAMANAGER.RequestTranData( "obacb_balc_079r" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_079r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_079r", "OutBlock2")-1
			g_nNextCount = g_nNextCount + 1
			szTemp = DATAMANAGER.GetDataValue( 0 , "obacb_balc_079r", "OutBlock2", "ACNO" , i) &
			DATAMANAGER.GetDataValue( 0 , "obacb_balc_079r", "OutBlock2", "UI_ACNT_PRNM" , i)
			grd0.SetCellData("bd_cell0", g_nNextCount - 1 , szTemp)
		next
	end if
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obacb_balc_079r" )
End Sub

