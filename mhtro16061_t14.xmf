'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szTitle
g_szTitle = "알림"

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
'	계좌번호/비밀번호 확인
'	내역조회는 비밀번호 없이 조회가능하도록 수정함. 	20160502 LKM 
'	주문올릴때만 비밀번호 확인하도록 로직 수정
'============================================================================
Function Check_Accout()

'20160502 LKM START

	Dim szAcctNo
	
	szAcctNo = Form.GetTopCtlProp("acnt", "caption")
    
    If Len(Trim(szAcctNo)) < 10 Then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If

	Check_Accout = True
	
End Function

'============================================================================
' 국가코드 => 국가명 가져오기
'============================================================================
Function GetCountryNameByCode(sCountryCode,sVndrCode)
	if sCountryCode = "01" then
		return "미국"
	elseif sCountryCode = "02" then
		return "홍콩"
	elseif sCountryCode = "03" then
'		return "상해"
		return "중국"
	elseif sCountryCode = "04" then
'		return "심천"
		return "중국"
	elseif sCountryCode = "05" then 
		return "일본"
	elseif sCountryCode = "06" then
		return "호주"
	elseif sCountryCode = "07" then
		return "싱가폴"
	elseif sCountryCode = "08" then
		return "영국"
	elseif sCountryCode = "09" then
		return "영국"
	elseif sCountryCode = "10" then
		return "독일"
	elseif sCountryCode = "11" then
		return "핀란드"
	elseif sCountryCode = "12" then
		return "프랑스"
	elseif sCountryCode = "13" then
		return "벨기에"
	elseif sCountryCode = "14" then
		return "네덜란드"
	elseif sCountryCode = "15" then
		return "포르투갈"
	elseif sCountryCode = "16" then
		return "그리스"
	elseif sCountryCode = "17" then
		return "아일랜드"
	elseif sCountryCode = "18" then
		return "이탈리아"
	elseif sCountryCode = "19" then
		return "스페인"
	elseif sCountryCode = "20" then
		return "오스트리아"
	elseif sCountryCode = "21" then
		return "캐나다"
	elseif sCountryCode = "23" then
		return "인도네시아"
	elseif sCountryCode = "24" then
		
		if sVndrCode == "XSTC" then 
			return "호치민"
		elseif sVndrCode == "HSTC" then
			return "하노이"
		end if
	
	elseif sCountryCode = "26" then
		return "스위스"
		
	else
		return ""
	end if 

End Function

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)
	
	
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function

