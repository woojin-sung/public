Sub lblMove_OnClick()
	Form.OpenScreen("16074" , "")
End Sub

'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	if szCellID = "th_cell8" then		' 종목명 -> 종목코드
	    grd0.SetVisibleCol(1, 0)
	    grd0.SetVisibleCol(2, 1)
	    
	elseif szCellID = "th_cell80" then	' 종목코드 -> 종목명 
	    grd0.SetVisibleCol(1, 1)
	    grd0.SetVisibleCol(2, 0)
	    
	end if
End Sub

