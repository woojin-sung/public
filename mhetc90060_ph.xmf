'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_휴대폰본인인증(개인고객)
' 03. 작    성 : 2020.10.29 성우진
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sUserID
Dim g_sACNO
Dim g_sSMSSeqNo 'SMS 일련번호
Dim g_nTryCnt 'SMS인증검증요청횟수
Dim sOpen     '화면오픈
Dim G_AGREE_FILE '개인정보수집이용제공동의풀팝업
'-----------------------------------------------------------------------

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================

'============================================================================
Sub Form_OnFormInit()
	G_AGREE_FILE = "mbonl81000_p6"
End Sub

'============================================================================
Sub Button0_OnClick()
	if Edit0.caption == null or Edit0.caption == "" or Edit1.caption == null or Edit1.caption =="" or Edit2.caption == null or Edit2.caption =="" then
		Form.MsgBox( "안내", "휴대폰 번호를 입력해주세요.", "", 6 )
	else
		g_nTryCnt = 0
		g_sSMSSeqNo = ""
		g_sSMSSeqNo1 = ""
		EditSMSNum.enable = true
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_613a" ) ''인증번호요청조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
	
	if szTranID == "obcsb_oimf_613a" then
		
		strRd = Combo0.currentindex
		
		if strRd == "0" then
			strRd_Key = "SKT"
		elseif strRd == "1" then
			strRd_Key = "KT "
		elseif strRd == "2" then
			strRd_Key = "LGT"
		elseif strRd == "3" then
			strRd_Key = "AL "
		elseif strRd == "4" then
			strRd_Key = "KAL"
		elseif strRd == "5" then
			strRd_Key = "LAL"
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , strRd_Key )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_ARCD" , 0 , Edit0.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_TONO" , 0 , Edit1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_SRNO" , 0 , Edit2.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "SVCD" , 0 , "000" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ACNO" , 0 , g_sACNO )
	
	elseif szTranID == "obcsb_oimf_615r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )	
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "SMS_ATHN_NO" , 0 , EditSMSNum.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "ACNO" , 0 , g_sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo1 )
	
	elseif szTranID == "obcsb_oimf_614a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "PROS_CLS" , 0 , "2" )
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "SMS_ATHN_NO" , 0 , EditSMSNum.caption )
	elseif szTranID == "obcsb_oimf_614a_1" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "PROS_CLS" , 0 , "1" )
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "SMS_ATHN_NO" , 0 , "" )
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_613a" then
		g_sSMSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_613a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
		Form.SetTimerEvent( 0 , 1, 1)
		
	elseif szTranID == "obcsb_oimf_614a" then
		g_sSMSSeqNo1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_614a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
		Form.SetTimerEvent( 1 , 1, 1)
		
	elseif szTranID == "obcsb_oimf_614a_1" then
		g_sSMSSeqNo1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_614a_1", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
	
	elseif szTranID == "obcsb_oimf_615r" then
		'Form.triggerEvent("#", "NextPhone", "")
		Form.SendReturnToParent("mhetc90060_opt","")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_oimf_614a_1" then
		if szErrCode == "3021" then
			Form.SetTimerEvent( 0 , 1, 1)
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
	
	elseif szTranID == "obcsb_oimf_615r" then
		 if szErrCode == "3021" then
			Form.SetTimerEvent( 1 , 1, 1)
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
		
	elseif szTranID == "obcsb_oimf_613a" then
		Form.ShowAlert( "알림", szErrMsg)
	end if
End Sub
'============================================================================
Sub ButtonOK_OnClick()
	
	if ChkButton0.chksilence == "0" then
		Form.MsgBox( "알림", "본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다.", "", 6 )
		Exit Sub
	else
		if EditSMSNum.caption == null or EditSMSNum.caption == "" then
			Form.MsgBox( "알림", "SMS 인증번호를 입력하세요.", "", 6 )
		else
			g_nTryCnt = 0
			DATAMANAGER.RequestTranData( "obcsb_oimf_614a" ) '613a인증확인요청
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0 , 0, 1)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 40 then			'4~50초 정도만 적용해놓음
			Form.ShowAlert( "알림", "본인인증확인에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_614a_1" ) '613a인증확인요청
	
	elseif sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent( 1 , 0, 1)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 40 then			'4~50초 정도만 적용해놓음
			Form.ShowAlert( "알림", "본인인증확인에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) '인증번호확인요청
	
	end if	
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub ButtonView_OnClick()
	Form.OpenFramePopup(G_AGREE_FILE , "" , "")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_AGREE_FILE then
		if sRet == "ok" then
			ChkButton0.chksilence = "1"
		end if
	end if
End Sub

'============================================================================
Sub Edit0_OnEditChar(CharCode)
	if #CharCode >=3 then
		Edit1.SetShowKeypad( true )
	end if
End Sub
'============================================================================
Sub Edit1_OnEditChar(CharCode)
	if #CharCode >=4 then
		Edit2.SetShowKeypad( true )
	end if
End Sub
