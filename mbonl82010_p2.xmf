		Dim szAllData
		szAllData = g_tAgreeUrl[0][1].."★"..g_tAgreeUrl[0][0].."★"..g_tAgreeUrl[0][2].."★"..g_tAgreeUrl[0][3].."★"..g_tAgreeUrl[0][4].."★".."1".."★".."0"
		
	     Form.OpenPopup( "mbonl82010_p4" ,  szAllData , "" )
