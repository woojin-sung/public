Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgAllAgree.setMaintainingRatio("1")
	imgUIChk1.setMaintainingRatio("1")
	imgUIChk2.setMaintainingRatio("1")
	imgUIChk3.setMaintainingRatio("1")
	imgUIChk4.setMaintainingRatio("1")
	imgChk1.setMaintainingRatio("1")
	imgChk2.setMaintainingRatio("1")
	imgChk3.setMaintainingRatio("1")
	imgChk4.setMaintainingRatio("1")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSub
	szSub = DATAMANAGER.GetDataMsgSubText( szTranID)
	
	if trim(szSub) <> "" then
		szErrMsg = szErrMsg.."\n"..szSub		
	end if
	
	Form.ShowAlert("알림", szErrMsg)
End Sub

