Dim g_tAgreeUrl 
Dim g_tAgreeState 
Dim g_szAct 
Dim g_nTryCnt
Dim g_szCRIN_IQRY_CLCD 
Dim g_szSDRC_SRNO
Dim g_szSDRC_CLS_CODE

dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러
Dim g_szStplYN
'============================================================================
Sub Form_OnFormInit()
	g_szUnCheckImg = "icon_check_off.png"
	g_szCheckImg = "icon_check_on.png"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"

	Dim sDev
	sDev = Form.GetSharedData("&SERVER_MODE", False )
	
	If sDev == "1" Or sDev == 1 Then
		g_tAgreeUrl = {
		    {"https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_04.pdf", "신용거래융자 핵심설명서",  "urlpath", "N", ""},
		    {"https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf", "신용거래설명서", "urlpath", "N", ""},
		    {"https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf",    "신용거래약관", "urlpath", "N", ""},
		    {"http://211.201.184.87/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf", "개인정보제공 및 활용동의", "urlpath", "N", ""}
		}
		
	Else '운영
		g_tAgreeUrl = {
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_04.pdf", "신용거래융자 핵심설명서",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf", "신용거래설명서", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf",    "신용거래약관", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf", "개인정보제공 및 활용동의", "urlpath", "N", ""}
		}
	End If
	
	g_tAgreeState = {"0", "0", "0", "0"}
	tOpenData = Form.GetOpenLinkData()
	tData1 = Split(tOpenData,"★")
	
	g_szAct = tData1[0]
	g_szStplYN = tData1[1]
	g_nTryCnt = 0
	g_szCRIN_IQRY_CLCD =   "TR01"
	g_szSDRC_SRNO = ""
	g_szSDRC_CLS_CODE = "1"
	
	if g_szStplYN == "Y" then
		imgUIChk4.visible = 0
		lblChkText4.visible = 0
		imgChk4.visible = 0
	end if
	
	Form.SetSharedData("mbonl82010_p2_Account" , g_szAct)

'	DATAMANAGER.RequestTranData("obcsb_acif_556r")
End Sub

'============================================================================
Sub chkAllAgree_OnChange(sCheckState)
	if sCheckState == "1" then
		chkAllAgree.chksilence = "0"
		
		Dim szAllData
		
		if g_szStplYN == "Y" then tCnt = 2
		else tCnt = 3 end if
		for i=0 to tCnt
			Dim szData
			if g_tAgreeState[i] == "0" then
				'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
				szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
				if szAllData == "" or szAllData == null then
					szAllData = szData
				else
					szAllData = szAllData.."☆"..szData
				end if
			end if
		next
    
		if #szAllData > 0 then
			Form.OpenPopup( "mbonl82010_p4" ,  szAllData , "" )
		end if
	else
		g_tAgreeState = {"0", "0", "0", "0"}
		
		f_AllAgreeCheck()
		
	end if
End Sub


'============================================================================
Sub imgAllAgree_OnClick()
	if chkAllAgree.checkstate == "1" then
		chkAllAgree.checkstate = "0"
		chkAllAgree_OnChange("0")
	else
		chkAllAgree.checkstate = "1"
		chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
Sub lblAllAgree_OnClick()
	if chkAllAgree.checkstate == "1" then
		chkAllAgree.checkstate = "0"
		chkAllAgree_OnChange("0")
	else
		chkAllAgree.checkstate = "1"
		chkAllAgree_OnChange("1")
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl82010_p4" then
	    if trim(sRet) ~= "" and trim(sRet) ~= nil and sRet ~= "close" then
			Dim tReturnData
			Dim nCnt
			
			tReturnData = Split(sRet, "☆")			 
			nCnt = #tReturnData
			for i = 0 to nCnt - 1
				Dim nIndex      
				nIndex = tonumber(tReturnData[i]) - 1
				g_tAgreeState[nIndex] = "1"
			next
			
			f_AllAgreeCheck()
	    end if	
	end if
	
End Sub


Function f_AllAgreeCheck()
	Dim nAll
	nAll = 0
	for i = 0 to #g_tAgreeState - 1
	
		Form.SetCtlProp("chkAgree"..i+1, "chksilence", g_tAgreeState[i])		
		
		if g_tAgreeState[i] == "1" then
			Form.SetCtlProp("imgUIChk"..i+1, "imgpath", g_szCheckImg)
			Form.SetCtlProp("lblChkText"..i+1, "fgcolor", g_szCheckFg)
		
			nAll = nAll + 1
		else
			Form.SetCtlProp("imgUIChk"..i+1, "imgpath", g_szUnCheckImg)
			Form.SetCtlProp("lblChkText"..i+1, "fgcolor", g_szUnCheckFg)
		end if
	next
	
	if g_szStplYN == "Y" then tCnt = 3
	else tCnt = 4 end if

	if nAll == tCnt then
		imgAllAgree.imgpath = g_szCheckImg
		lblAllAgree.fgcolor = g_szCheckFg
	
		chkAllAgree.chksilence = "1"
		btnOk.enable = "1"
	else
		imgAllAgree.imgpath = g_szUnCheckImg
		lblAllAgree.fgcolor = g_szUnCheckFg
	
		chkAllAgree.chksilence = "0"
		btnOk.enable = "0"
	end if

End Function

