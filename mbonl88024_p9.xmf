'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 대차거래 안내팝업
' 02. 화면설명 : 보유주식 수익 서비스 대차거래안내팝업
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

Dim  g_szTheme                  '테마구분  white/black

'============================================================================
'문구 색깔 변경..
'============================================================================
Function f_SetLabelColor()

	Dim nStaOffset, nLen
	
	'3 Line
	lbl1Line3.caption = "대여주식으로부터 발생된 대여 수수료를 받아"

	nStaOffset = lbl1Line3.getLen("대여주식으로부터 발생된 ")
	nLen       = lbl1Line3.getLen("대여 수수료를 받아")
	
	'lbl1Line3.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	lbl1Line3.changeTextAttr(nStaOffset, nLen, 289, -1, false)	
	
	'4 Line
	lbl1Line4.caption = "추가수익을 낼 수 있는 거래입니다."
	
	nStaOffset = lbl1Line4.getLen("추가수익을 ")
	nLen       = lbl1Line4.getLen("낼 수 있는 거래입니다.")	
	
	lbl1Line4.changeTextAttr(0, nStaOffset-1, 289, -1, false)
	'lbl1Line4.changeTextAttr(nStaOffset, nLen, 146, -1, false)	
	
	'5 Line
	lbl1Line5.caption = "대여주식은 대여주문화면에서 언제든지 매도가"
	
	nStaOffset = lbl1Line5.getLen("대여주식은 대여주문화면에서 ")
	nLen       = lbl1Line5.getLen("언제든지 매도")
	
	'lbl1Line5.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	lbl1Line5.changeTextAttr(nStaOffset, nLen, 289, -1, false)		
	
	'6 Line
	lbl1Line6.caption = "가능하며 대여된 주식을 언제든지 반환요청(상환)"
	
	nStaOffset = lbl1Line5.getLen("가능하며 대여된 주식을 ")
	nLen       = lbl1Line5.getLen("언제든지 반환요청")	
	
	lbl1Line6.changeTextAttr(nStaOffset, nLen, 289, -1, false)		
	
End Function

'============================================================================
Sub Form_OnFormInit()
	
	'안드로이드-백버튼 작동Y
	'부모창(mbonl88024) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

     '이미지설정
	'imgBg.imgpath       = "alpha128"
	imgExit.imgpath     = "icon_close"

	BtnContinue.imgpath = "btn_20.9"
	
	'라벨 색상 변경
	f_SetLabelColor()
	
End Sub


'============================================================================
Sub BtnContinue_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동N 원복(부모화면에서 호출했던 상태로)
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	'Form.SendReturnToParent("mbbdm85110_p2" , g_BDM_CLEAR_YN)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	imgExit_OnClick()
End Sub
'============================================================================
Sub imgBg_OnClick()
	imgExit_OnClick()
End Sub
'============================================================================
Sub imgExit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image2.setMaintainingRatio("1")

End Sub

