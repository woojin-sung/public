	<SCRIPT_INFO _len="8327" _ulen="7265" >
'============================================================================
' 01.화면명 	: 오픈뱅킹 다른금융기관 계좌등록_선택
' 02.화면설명	: 오픈뱅킹 다른금융기관 계좌등록_선택
' 03.작성	: 2020.10.07
'============================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
'============================================================================
Dim szData 
Dim szCust_Num

Dim opn_utlz_able_yn 		'오픈뱅킹이용가능여부
Dim otco_acnt_iqry_able_yn	'타사계좌조회가능여부
Dim g_Acdn_Cust_YN '사고등록고객여부

Dim Msg
Dim SubMsg

Dim g_szUserID   '사용자ID
Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
	g_Acdn_Cust_YN = ""
	
	Image0.imgpath = "openbank_01.png"
	Image1.imgpath = "openbank_02.png"
	
	'v001
	g_szUserID = Form.GetSharedData( "&USER_ID" , false )	'사용자ID
	
	'v001
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false) = "Y" THEN
	    DATAMANAGER.RequestTranData( "obtss_opnf_024r" ) '오픈뱅킹 이용가능고객여부 확인
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
	
	DATAMANAGER.RequestTranData("obcsb_scif_033r")
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtss_opnf_024r" then	'오픈뱅킹 이용가능고객여부 확인
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_024r", "InBlock1", "CSNO" , 0 , szCust_Num )
		'DATAMANAGER.SetDataValue( 0, "obtss_opnf_024r", "InBlock1", "CSNO" , 0 , "1000109991" )
	end if

	'v001
	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
	end if
	
     'v001
	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
	
	If szTranID == "obcsb_scif_033r" Then
	    DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO"    , 0 , ""        )
	    DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"    , 0 , ""        )
	    DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID" , 0 , g_szUserID)
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtss_opnf_024r" then	'오픈뱅킹 이용가능고객여부 확인
		opn_utlz_able_yn 		= DATAMANAGER.GetDataValue( 0, "obtss_opnf_024r", "OutBlock1", "OPN_UTLZ_ABLE_YN" 	 , 0 ) '오픈뱅킹이용가능여부
		otco_acnt_iqry_able_yn = DATAMANAGER.GetDataValue( 0, "obtss_opnf_024r", "OutBlock1", "OTCO_ACNT_IQRY_ABLE_YN" , 0 ) '타사계좌조회가능여부
		
		if opn_utlz_able_yn =="N" then 	      '오픈뱅킹이용가능여부
			LabelA.enable = False	'한번에불러오기
			LabelB.enable = False	'직접입력하기
		end if
		
		if otco_acnt_iqry_able_yn == "N" then '타사계좌조회가능여부
			LabelA.enable = False  '한번에불러오기
		end if
		
		if opn_utlz_able_yn =="N" or otco_acnt_iqry_able_yn == "N" then
			Msg 		= DATAMANAGER.GetDataMsgText( "obtss_opnf_024r" )
			SubMsg	= DATAMANAGER.GetDataMsgSubText( "obtss_opnf_024r" )
			
			if SubMsg == "" then
				Form.ShowAlert( "알림", Msg )
			else
				Form.ShowAlert( "알림", Msg.."("..SubMsg..")" )
			end if
		end if
	elseif szTranID == "obtss_opnf_047r" then	'v001
	
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부
	    
	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
	    
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If

	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
		'다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then	 
		 
			Form_Enable(False)
		Else
		    
			DATAMANAGER.RequestTranData( "obtss_opnf_024r" )
		End If
	elseif szTranID == "obtss_opnf_048a" then	'v001
	
		DATAMANAGER.RequestTranData( "obtss_opnf_024r" )  '오픈뱅킹 이용가능고객여부 확인	    
		
	ElseIf szTranID == "obcsb_scif_033r" Then
	
	    g_Acdn_Cust_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TRGT_YN" , 0)
	    If g_Acdn_Cust_YN == "Y" Then
            Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )
	    End If
		
	end if
	
End Sub

'============================================================================
Sub LabelA_OnClick()
	if opn_utlz_able_yn == "N" then
		Form.MsgBox( "알림", "오픈뱅킹 이용가능 고객이 아닙니다.", "", 6 )
		Exit Sub
	end if
	
	if otco_acnt_iqry_able_yn == "N" then
		Form.MsgBox( "알림", "한번에 불러오기 가능 고객이 아닙니다.", "", 6 )
		Exit Sub
	end if
	
    If g_Acdn_Cust_YN == "Y" Then
        Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )
        Exit Sub
    End If
	
	szData ="1"
	Form.OpenFramePopup("mbbnk62002" , szData , sPosInfo)
End Sub

'============================================================================

Sub LabelB_OnClick()
	if opn_utlz_able_yn == "N" then
		Form.MsgBox( "알림", "오픈뱅킹 이용가능 고객이 아닙니다.", "", 6 )
		Exit Sub
	end if
	
    If g_Acdn_Cust_YN == "Y" Then
        Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )
        Exit Sub
    End If
	
	szData ="2"
	Form.OpenFramePopup("mbbnk62002" , szData , sPosInfo)
End Sub

'v001
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "mbbnk62000_p1" then
	     
		If sRet == "Y" then 'Y:재동의 N:취소
		
			Form_Enable(True)
			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )  '오픈뱅킹_이용재동의여부관리
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
			
				Form_Enable(True)
				
				DATAMANAGER.RequestTranData( "obtss_opnf_024r" )  '오픈뱅킹 이용가능고객여부 확인
			Else
			
				Form_Enable(False)
			End If
		End If
	End If
     
End Sub


'v001
'============================================================================
' Form_Enable
'============================================================================
Function Form_Enable(EnableYn)
    if EnableYn = True then
    
		LabelA.enable = True	'한번에불러오기
		LabelB.enable = True	'직접입력하기
				
    elseif EnableYn = False then
    
		LabelA.enable = False	'한번에불러오기
		LabelB.enable = False	'직접입력하기
    end if
End Function

	</SCRIPT_INFO>
