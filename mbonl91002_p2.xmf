Dim temp_cnt 

tmp_cnt = 0
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.SetDataValue(0, "obcmp_momt_474r", "InBlock1", "CUST_CLS_CODE", 0, "%") '관리번호
	
	DATAMANAGER.RequestTranData("obcmp_momt_474r")
	
	tmp_cnt = 0
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	cnt = DATAMANAGER.GetDataCount(0, "obcmp_momt_474r", "OutBlock1")
	
	if cnt == 0 then
	Grid0.SetDeleteRow(0)
	end if

	
	for i = 0 to cnt-1
		
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "SRNO", i)
	Grid0.SetCellData("bd_cell0", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "TR_CNRP_MNNO", i)
	Grid0.SetCellData("bd_cell1", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "TR_CNRP_NAME", i)
	Grid0.SetCellData("bd_cell2", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "CUST_CLS_CODE", i)
	Grid0.SetCellData("bd_cell3", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "TR_CNRP_CUST_CLCD", i)
	Grid0.SetCellData("bd_cell4", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "ACNO" , i)
	Grid0.SetCellData("bd_cell5", tmp_cnt+i, tmp)

	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "WRPL_NAME", i)
	Grid0.SetCellData("bd_cell6", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "DPNM" , i)
	Grid0.SetCellData("bd_cell7", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "RMRK" , i)
	Grid0.SetCellData("bd_cell8", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "TR_CNRP_TELNO", i)
	Grid0.SetCellData("bd_cell9", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "TRGT_YN", i)
	Grid0.SetCellData("bd_cell10", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcmp_momt_474r", "OutBlock1", "ISTU_BSWR_ACMP_YN", i)
	Grid0.SetCellData("bd_cell11", tmp_cnt+i, tmp)
	
	next
End Sub


'============================================================================
Sub Button0_OnClick()
	nRow = 0
	DATAMANAGER.SetDataValue(0, "obcmp_momt_474r", "InBlock1", "TR_CNRP_NAME", 0, Edit1.Caption) '상대방 이름
	DATAMANAGER.RequestTranData("obcmp_momt_474r")
End Sub



'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	tmp = Grid0.selectrow
	
	srno = Grid0.GetCellData("bd_cell0",tmp)
	tr_cnrp_mnno = Grid0.GetCellData("bd_cell1",tmp)
	tr_cnrp_name = Grid0.GetCellData("bd_cell2",tmp)
	cust_cls_code = Grid0.GetCellData("bd_cell3",tmp)
	tr_cnrp_cust_clcd = Grid0.GetCellData("bd_cell4", tmp)
	acno = Grid0.GetCellData("bd_cell5",tmp)
	wrpl_name = Grid0.GetCellData("bd_cell6",tmp) '직장명
	dpnm = Grid0.GetCellData("bd_cell7",tmp) '부서명
	rmrk = Grid0.GetCellData("bd_cell8",tmp)
	tr_cnrp_telno = Grid0.GetCellData("bd_cell9",tmp)
	trgt_yn = Grid0.GetCellData("bd_cell10",tmp)
	istu_bswr_acmp_yn = Grid0.GetCellData("bd_cell11",tmp)
	
	Form.SetSharedData("srno", srno)
	Form.SetSharedData("tr_cnrp_mnno", tr_cnrp_mnno)
	Form.SetSharedData("tr_cnrp_name", tr_cnrp_name)
	Form.SetSharedData("cust_cls_code", cust_cls_code)
	Form.SetSharedData("tr_cnrp_cust_clcd", tr_cnrp_cust_clcd)
	Form.SetSharedData("acno", acno)
	Form.SetSharedData("wrpl_name", wrpl_name)
	Form.SetSharedData("dpnm", dpnm)
	Form.SetSharedData("rmrk", rmrk)
	Form.SetSharedData("tr_cnrp_telno", tr_cnrp_telno)
	Form.SetSharedData("trgt_yn", trgt_yn)
	Form.SetSharedData("istu_bswr_acmp_yn", istu_bswr_acmp_yn)	
	
	Form.SendReturnToParent("kim02_3" , 1)
	Form.CloseForm()
	
End Sub
'============================================================================
Sub Grid0_OnScrollEnd()
	tmp_cnt = tmp_cnt + 30
End Sub

