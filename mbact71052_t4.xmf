	<SCRIPT_INFO _len="6325" _ulen="5811" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_고객별자산
' 02. 화면설명 : 고객자산평가_고객별자산
' 03. 작    성 : 2016. 02. 04. 유창재
' 2021.07.05 : 정민영 : v0001 : obcsb_efif_005r IO재매핑
' 20230315 강희승 : 1. CFD -> 해외/국내CFD 분리 2. CMA/슈퍼365 삭제 3. 장외파생 -> ELS/DLS  v0002
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim nCellType			'토글 상태를 구분하기 위한 변수
Dim szTemp			'고객번호
Dim szACNO			'계좌번호
Dim szUSERID

Dim g_szAssest
'g_szAssest = Array("주식", "해외주식", "CFD", "채권", "CMA", "펀드", "ELS/DLS", "선물옵션", "외화/기타", "신용", "현금")
'v0002
g_szAssest = Array(" 주식", " 해외주식", " 국내CFD", " 해외CFD", " 채권", " 펀드", " ELS/DLS", " 선물옵션", " 기타", " 신용", " 원화예수금"," 외화예수금")
Dim g_szCellID
g_szCellID = Array("cell1_4", "cell13_4", "cell2_4  ", "cell3_4", "cell4_4", "cell5_4", "cell6_4", "cell7_4", "cell8_4", "cell9_4", "cell10_4")
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetInput(szData) : TR의 입력값 세팅
'============================================================================
Function SetInput(szData)

	DATAMANAGER.SetDataValue( 0 , "ooopc_cuma_043r", "InBlock1", "CSNO" , 0 , szData)

	DATAMANAGER.RequestTranData( "ooopc_cuma_043r" )
'	SetName()
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()		자산유형 출력값 세팅
'============================================================================
Sub Form_OnFormInit()
	szDate = right(Form.GetSharedData("&HOST_DATE" , false), 6)
	lblDate.caption = szDate

	nCellType = 0
	lbl0.visible = false
	lblline.visible = false
	grd0.SetVisibleCol( 2, false)
	
	szACNO = ""
	szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'20230329 HSZ START : 바 그래프 OS별 분기처리
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "2" then	'iOS - 테이블
		tblBar.visible = true
		grdBar.visible = false
	else						'안드 - 그리드
		tblBar.visible = false
		grdBar.visible = true
	end if
	'20230329 HSZ END
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "mbact71052_t4" then		'고객별자산
		szTemp = sParam
		Call SetInput(szTemp)	
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : ooopc_cuma_030r TR을 사용하여 사용자번호를 입력하여 계좌번호 출력
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	nOut16Cnt,	szIn16DataName,	szIn16DataVal
	nOut16Cnt	=	0   
	szIn16DataName	=	""   
	szIn16DataVal		=	""
	if szTranID == "ooopc_cuma_043r" then
		grd1.SetClear()
		'그리드 바그래프
		'rateArray = Array("UI_RLIM_RATE1", "UI_RLIM_RATE13", "UI_RLIM_RATE14", "UI_RLIM_RATE2", "UI_RLIM_RATE3", "UI_RLIM_RATE4", "UI_RLIM_RATE5", "UI_RLIM_RATE6", "UI_RLIM_RATE7", "UI_RLIM_RATE9","UI_RLIM_RATE8")
		'v0002
		rateArray = Array("UI_RLIM_RATE1", "UI_RLIM_RATE13", "UI_RLIM_RATE14","UI_RLIM_RATE17", "UI_RLIM_RATE2", "UI_RLIM_RATE4", "UI_RLIM_RATE5", "UI_RLIM_RATE6", "UI_RLIM_RATE15", "UI_RLIM_RATE9","UI_RLIM_RATE8","UI_RLIM_RATE16")
		colorIdx = Array("305", "306","307", "308", "309", "310", "311", "312", "313", "314", "315","316")
		barIdx = 0
		IdxNum = 0
		for	i = 0 to UBOUND(rateArray)
			rateData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , rateArray(i) , 0)
			
			if CDBL(rateData) > CInt(rateData) and CDBL(rateData)>0 then
				rateUp = CInt(rateData) +1
			elseif CDBL(rateData)<0 then
				rateUp = 0
			else
				rateUp = CInt(rateData)
			end if
			barStart = barIdx
			barEnd = barIdx + rateUp
			if barEnd > 105 and rateUp > 80 then						'올림처리하여, 100이 넘어갈 경우 뒤에 자산 표시가 안될 수 있음
				barEnd = barEnd - 10
			end if
			for j = barStart to barEnd+1
				if barStart == barEnd then
					exit for 
				end if
				grdBar.SetCellBgColor("bd_cell"&j, 0, colorIdx(i))
				tblBar.SetCellBgColor(0, j, colorIdx(i))				'20230329 HSZ : 테이블 그래프 추가
			next
			if rateUp > 0 then
				grdIdx.SetCellBgColor("bd_color"&IdxNum, 0, colorIdx(i))
				grdIdx.SetCellData("bd_name"&IdxNum, 0, g_szAssest(i))
				grdIdx.SetCellData("bd_rate"&IdxNum, 0, rateData)
				IdxNum = IdxNum+1
			end if
			barIdx = barEnd
		next
'		Form.ShowAlert("barIdx", barIdx)
'		if barIdx < 110 then
'			img2lft = 316+((110-barIdx)*3/2)
'			if img2lft > 323 then
'				img2lft = 323
'			end if
'			Image2.left = img2lft
'			Image1.left = 19+((110-barIdx)*3/2)
'			grdBar.left = 19+((110-barIdx)*3/2)
'		end if
	end if
	
	
End Sub
'
'============================================================================
Sub Form_OnRefresh()
'	DATAMANAGER.RequestTranData( "ooopc_cuma_043r" )
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image1.setMaintainingRatio("4")	'왼쪽정렬
	Image2.setMaintainingRatio("5")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub


	</SCRIPT_INFO>
