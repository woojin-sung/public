	<SCRIPT_INFO _len="10499" _ulen="10039" >
 '===========================================================================
' 01. 업무구분 : 해외주식현재가_체결
' 02. 화면 : 
' 03. 화면설명 : 
' 04. 작성자 : 이재원
' 05. 작성일 : 2017.10.10
' 06. 수정이력 :
'===========================================================================

'===========================================================================
' getGtsChartHistory Input 정의
' type : GPTICK : tick  GPINTR : 분  GPMDAY : 일  GPWEEK: 주  GPMONT:  월
' market : 거래소 아이디
' code : 심볼
' symd : 시작날짜
' xymd : 끝날짜
' count : 개수
' keyc : first:0,  next:1
' splt : ""
'===========================================================================
'[[ 전역변수 ]]
Dim g_sCode
Dim g_sKeyc
Dim g_sKeyv
Dim g_sType
Dim g_sDecimal

g_sKeyc = "0" 	' NextKey 구분
g_sKeyv = "" 	' NextKey
g_sType = "" 	' 일중, 일별 구분
g_sDecimal = ""

'============================================================================
' 거래소 ID 숫자로 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 홍콩
		return "104"
	elseif sValue == "HSI" then ' 항셍 지수
		return "529"
	elseif sValue == "SHS" then ' 상해
		return "215"
	elseif sValue == "SZS" then ' 심천거래소 종목
		return "214"
	elseif sValue == "NYS" then ' 뉴욕
		return "321"
	elseif sValue == "AMX" then ' 아멕스
		return "66"
	elseif sValue == "NAS" then ' 나스닥
		return "537"
	elseif sValue == "NAO" then ' 미국 OTCBB
		return "130"
	elseif sValue == "SPI" then ' S&P 지수
		return "625"
	elseif sValue == "DJI" then ' 다우존스 지수
		return "310"
	elseif sValue == "TSE" then ' 도쿄
		return "106"
	elseif sValue == "OSE" then ' 오사카거래소 종목
		return "107"
	elseif sValue == "JSD" then ' 자스닥거래소 종목
		return "112"
	elseif sValue == "NII" then ' 니케이 지수
		return "889"
	elseif sValue == "NAI" then ' 미국 나스닥 지수
		return "538"
	end if
end Function

'[[ Data Request 함수 ]]
Function RequestData()
	if (RadioGroup0.currentindex == "0") then		' 일중
		Grid0.visible = true
		Grid1.visible = false
		g_sType = "GPTICK"
	elseif (RadioGroup0.currentindex == "1") then		' 일별
		Grid0.visible = false
		Grid1.visible = true
		g_sType = "GPMDAY"
	end if
	
	DATAMANAGER.RequestTranData( "getGtsChartHistory" )
end Function

'[[ 폼 초기화 ]]
Sub Form_OnFormInit()
	
end Sub

'[[ 트리거 이벤트 발생 시]]
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RequestData" then
		g_sKeyc = "0"
		g_sKeyv = "" 
		g_sCode = sParam
'		Form.ShowAlert("sParam", sParam)
		RequestData()
	end if
end Sub

'[[ 그리드 일중 헤더 클릭 ]]
Sub Grid0_OnHeaderClickUp(lRow, szCellID)
	if (szCellID == "th_cell5") then
		Grid0.SetVisibleCol( 2, 1 )
		Grid0.SetVisibleCol( 3, 0 )
	elseif (szCellID == "th_cell3") then
		Grid0.SetVisibleCol( 2, 0 )
		Grid0.SetVisibleCol( 3, 1 )
	end if
end Sub

'[[ 그리드 일별 헤더 클릭 ]]
Sub Grid1_OnHeaderClickUp(lRow, szCellID)
	if (szCellID == "th_cell5") then
		Grid1.SetVisibleCol( 2, 1 )
		Grid1.SetVisibleCol( 3, 0 )
	elseif (szCellID == "th_cell3") then
		Grid1.SetVisibleCol( 2, 0 )
		Grid1.SetVisibleCol( 3, 1 )
	end if
end Sub

'[[ 라디오 버튼 일중/일별 ]]
Sub RadioGroup0_OnClick(nIndex)
	g_sKeyc = "0"
	g_sKeyv = ""
	RequestData()
end Sub

''[[ 일중 Next 조회 ]]
'function Grid0_OnScrollEnd()
'	DATAMANAGER.RequestNextData( "getGtsChartHistory" )
'end
'
''[[ 일별 Next 조회 ]]
'function Grid1_OnScrollEnd()
'	DATAMANAGER.RequestNextData( "getGtsChartHistory" )
'end

'[[ DATAMANAGER 조회 BEFORE ]]
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sCodeData
				
	Dim sMarket
	Dim sDate
	Dim sYear
	
	sCodeData = {}			' getGtsChartHistory 는 종목코드를 market와 code로 구분해서 인풋값을 올림
								' sCodeData[0] 마켓, sCodeData[1] 코드
	sMarket = ""
	if szTranID == "getGtsChartHistory" then
	
		DATAMANAGER.CancelRealData( "TRD" )
		
		Grid0.SetCellIDMaskInfo( "bd_cell2", "0,0,,,0,,-1,1,0" )
		Grid1.SetCellIDMaskInfo( "bd_cell2", "0,0,,,0,,-1,1,0" )
		
		
		sCodeData = Split( g_sCode, "@" )
		
		sMarket = Transform_Exid(sCodeData[0])
		sDate = Form.GetSharedData( "&HOST_DATE", false )
'		Dim tmp
'		tmp = Left(sDate, 4)
		sYear = Mid( sDate, 1, 4 )
'		sYear = tmp
		DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "type" , 0 , g_sType )
		DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "market" , 0 , sMarket )
		DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "code" , 0 , sCodeData[1] )
		DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "xymd" , 0 , sDate )
		DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "keyc" , 0 , g_sKeyc )
		DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "keyv" , 0 , g_sKeyv )
		 
		if (RadioGroup0.currentindex == "0") then		' 일중
			DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "count" , 0 , "30" )
			DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "symd" , 0 , "19000101" )
			DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "tday" , 0 , "0" )
		elseif (RadioGroup0.currentindex == "1") then		' 일별
			DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "count" , 0 , "90" )
			DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "symd" , 0 , "19000101" )
			DATAMANAGER.SetDataValue( 0, "getGtsChartHistory", "query", "tday" , 0 , "" )
		end if
		
		
'		Form.ShowAlert( "확인", g_sType .."\n".. sMarket .."\n".. sCodeData[2] .."\n19000101\n99991231\n50\n".. g_sKeyc )
	end if
end Sub

'[[ DATAMANAGER 조회 Complete ]]
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nDiff
	Dim nRowCnt
	Dim szColor
	Dim i
	Dim szDate
	
	nDiff = 0
	nRowCnt = 0
	szColor = ""
	szDate =  ""
	
	if szTranID == "getGtsChartHistory" then
		g_sKeyc = DATAMANAGER.GetDataValue( false, "getGtsChartHistory", "chartMaster", "keyc" , 0 )
		if g_sKeyc == "1" then
			g_sKeyv = DATAMANAGER.GetDataValue( false, "getGtsChartHistory", "chartMaster", "keyv" , 0)
		else
			g_sKeyv = ""
		end if
		
		g_sDecimal = DATAMANAGER.GetDataValue( 0, "getGtsChartHistory", "chartMaster", "zdiv" , 0 )
		
		if g_sDecimal <> nil and g_sDecimal <> "" then
			Grid0.SetCellIDMaskInfo( "bd_cell2", "0,0,,,0,," ..g_sDecimal.." ,1,0" )
			Grid1.SetCellIDMaskInfo( "bd_cell2", "0,0,,,0,," ..g_sDecimal.." ,1,0" )
		end if
		
		nRowCnt = Grid0.rowcount
		
		for i = 0 to nRowCnt - 1
			if RadioGroup0.currentindex == "0" then
			
				nDiff = tonumber( Grid0.GetCellData( "bd_cell3", i ) ) '등락률
				
				if nDiff > 0 then
					szColor = "1"
					Grid0.SetCellData( "bd_cell5", i, "2" )
				elseif nDiff < 0 then
					szColor = "2"
					Grid0.SetCellData( "bd_cell5", i, "5" )
				else
					szColor = "3"
					Grid0.SetCellData( "bd_cell5", i, "0" )
				end if
				
				Grid0.SetCellFgColor( "bd_cell1", i, szColor )
				Grid0.SetCellFgColor( "bd_cell2", i, szColor )
				Grid0.SetCellFgColor( "bd_cell3", i, szColor )
			elseif RadioGroup0.currentindex == "1" then
				sdiff =  Grid1.GetCellData( "bd_cell3", i )
				if sdiff <> nil and sdiff <> "" then
					nDiff  = tonumber( Grid1.GetCellData( "bd_cell3", i ) ) '등락률
				else
					nDiff = 0
				end if
				
				szDate = Grid1.GetCellData( "bd_cell6", i ) '2015/01/01 => 15/01/01  
				szDate = Left(szDate, 3)
				
				Grid1.SetCellData( "bd_cell0", i, Left(szDate, 2) .."/".. Mid(szDate,3, 2) .."/".. Right(szDate, 2) )
				
				if nDiff > 0 then
					szColor = "1"
					Grid1.SetCellData( "bd_cell5", i, "2" )
				elseif nDiff < 0 then
					szColor = "2"
					Grid1.SetCellData( "bd_cell5", i, "5" )
				else
					szColor = "3"
					Grid1.SetCellData( "bd_cell5", i, "0" )
				end if
				
				Grid1.SetCellFgColor( "bd_cell1", i, szColor )
				Grid1.SetCellFgColor( "bd_cell2", i, szColor )
				Grid1.SetCellFgColor( "bd_cell3", i, szColor )
			end if
		next
		Dim szRealCode
		szRealCode = ""
		szRealCode = DATAMANAGER.GetDataValue( false, "getGtsChartHistory", "chartMaster", "realcode" , 0 )
		DATAMANAGER.SetDataValue( 1, "TRD", "inblock", "codelist" , 0 , szRealCode )
		DATAMANAGER.RequestRealData( "TRD" )
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	Dim sTime
	Dim sClose
	Dim sSign
	Dim sDiff
	Dim sRate
	Dim sVol
	Dim szColor
	Dim i
	Dim sQtyp
	
	sTime = ""
	sClose = ""
	sSign = ""
	sDiff = ""
	sRate = ""
	sVol = ""
	szColor = "4"
	sQtyp = ""
	
	if szTranID == "TRD" then
		
		sQtyp	 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "qtyp" , 0 )
		if sQtyp == "1" then
			Exit Sub
		end if
	
		sClose	 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "last" , 0 )
		sSign	 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "sign" , 0 )
		sDiff	 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "diff" , 0 )
		sRate	 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "rate" , 0 )
		
		if sSign == "1" or sSign == "2" then
			szColor = "1"
		elseif sSign == "4" or sSign == "5" then
			szColor = "2"
		elseif sSign == "3" then
			szColor = "3"
		end if
		
		if RadioGroup0.currentindex == "0" then
			Grid0.insertrow = 0
			
			sTime	 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "xhms" , 0 )
			sVol		 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "evol" , 0 )
			
			Grid0.SetCellData( "bd_cell0", 0, sTime )
			Grid0.SetCellData( "bd_cell1", 0, sClose )
			Grid0.SetCellData( "bd_cell5", 0, sSign )
			Grid0.SetCellData( "bd_cell2", 0, sDiff )
			Grid0.SetCellData( "bd_cell3", 0, sRate )
			Grid0.SetCellData( "bd_cell4", 0, sVol )
			
			Grid0.SetCellFgColor( "bd_cell1", 0, szColor )
			Grid0.SetCellFgColor( "bd_cell2", 0, szColor )
			Grid0.SetCellFgColor( "bd_cell3", 0, szColor )
		elseif RadioGroup0.currentindex == "1" then
			sVol		 = DATAMANAGER.GetDataValue( 1, "TRD", "OutBlock", "tvol" , 0 )
	
			Grid1.SetCellData( "bd_cell1", 0, sClose )
			Grid1.SetCellData( "bd_cell5", 0, sSign )
			Grid1.SetCellData( "bd_cell2", 0, sDiff )
			Grid1.SetCellData( "bd_cell3", 0, sRate )
			Grid1.SetCellData( "bd_cell4", 0, sVol )
			
			Grid1.SetCellFgColor( "bd_cell1", 0, szColor )
			Grid1.SetCellFgColor( "bd_cell2", 0, szColor )
			Grid1.SetCellFgColor( "bd_cell3", 0, szColor )
		end if
	end if
end Sub

