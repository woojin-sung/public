Sub cmbAcnt_ChangeAccount()
	edtPassword.caption = ""
	'대출 고객정보 확인 조회 for 개인/법인
	'DATAMANAGER.RequestTranData("oblon_basc_102r")
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
	'Trigger Event
	callTriggerEvent(QUERY)
	
	if edtPassword.caption == null or edtPassword.caption == "" then
		BtnExecute.enable = "0"
	else
		BtnExecute.enable = "1"
	end if
End Sub
