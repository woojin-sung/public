'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mblon93500_p1" then
		RetVal = Split(sRet,"||") '0번은 재진단사유, 1번은 비고
		
		g_szApltReasClcd = RetVal(0)
		g_szRmrk         = RetVal(1)
		
		if g_szApltReasClcd == "0" and g_szRmrk = "" then
			Form.ShowAlert("알림", "재진단시 정확한 사유를 입력해주시기 바랍니다.")
			exit sub
		end if
		
		'Trigger Event
		f_ChangeTr()
	elseif sKeyName == "mbonl93503" then
		if sRet <> "Y" then
			Form.ShowAlert("알림", "부적정확인서를 발급하여야 진행하실 수 있습니다.")
			exit sub
		end if
		
		'DATAMANAGER.RequestTranData("oblon_basc_102r")
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	elseif sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			
			if UBOUND(tPwd) > 0 then
				edtPassword.pwdlen = tPwd(1)
				edtPassword.caption = tPwd(0)
				
				call edtPassword_OnEditComplete()
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ISNC_YN" then
		if sRet == "ok" then
			Form.MsgBox("알림", "부적정확인서를 발급합니다." , "kyc_report", 1)
		end if
	elseif sKeyName == "kyc_report" then
		if sRet == "ok" then
			setKycSharedData("mbonl93503")
			Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		else
			Form.ShowAlert("알림", "부적정확인서를 발급하여야 진행하실 수 있습니다.")
			exit sub
		end if
		
	elseif sKeyName == "oblon_basc_101a" then
		LinkForm.left = 375
		lblDim.visible = "0"
		btnPwd.visible = "1"
		edtPassword.visible = "1"
		
		
		g_szAnxtAprt_Yn = ""	
		g_nChangeCnt = 0
					
		'대출 고객정보 확인 조회 for 개인/법인 구분
		'DATAMANAGER.RequestTranData("oblon_basc_102r")
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	
	end if
End Sub
'============================================================================
' setKycSharedData : 파일 오픈 공유데이터 설정 : 대출KYC : 2021.03.17
'============================================================================
Function setKycSharedData(fileName)

	'MTS 메모리평문 적용유무 (0:미적용 / 1:적용)
	szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS 메모리평문 적용
	if szPlainRm = "1" Then
		szPwd = Form.GetCtlProp( "edtPassword", "caption" )	'비밀번호
	'MTS메모리평문 미적용
	else
		szPwd = Form.GetCtlProp( "edtPassword", "encdata" )
	end if
	
	if fileName = "mbonl93503" Then	
		'보고서는 Shared Memory로 통신한다.
		szAcno = Left(g_szAcno, 8)        '계좌번호
		szCsnm = cmbAcnt.accountname       '고객명
		szBswrdivcode = "16001"		'해외주식 대출약정'
		szLoanTypeCode = "00"	
		Form.SetSharedData( "mbonl93503_acno" 	  		, szAcno )
		Form.SetSharedData( "mbonl93503_acnopwd" 		, szPwd )
		Form.SetSharedData( "mbonl93503_csnm"             , szCsnm )
		Form.SetSharedData( "mbonl93503_loan_type_code"   , szLoanTypeCode )
		Form.SetSharedData( "mbonl93503_bswr_div_code"    , szBswrdivcode )
		Form.SetSharedData( "mbonl93503_cont_cls_code"    , "4" )
	end if
End Function 
'============================================================================
Sub btnOpenpopup_OnClick()
	Form.OpenPopup("mbonl93500_p2" , g_szData , "")
End Sub


Function f_ChangeTr()
'	Form.ShowAlert("g_szChangeData", g_szChangeData)
	DIm szCase
	szCase = ""
	
	g_tChangeData = Split(g_szChangeData, "★")
	for i = 0 to #g_tChangeData - 1
		if g_tChangeData[i] ~= null and g_tChangeData[i] ~= "" then
			Dim tIndex
			tIndex = Split(g_tChangeData[i], "☆")
			
			if g_szCustClsCode == "2" then				
				if tIndex[1] == null or tIndex[1] == "" or tIndex[1] ==  "-1" then
					Dim tTitle
					tTitle = {"대출용도를 선택해 주세요.", "자본금 규모를 입력해 주세요.", "부채현황을 입력해 주세요.", 
							 "당기 순이익을 입력해 주세요.", "변제계획을 선택해 주세요.", "신용공여 이해도를 선택해 주세요."}
						  
					Form.ShowAlert("안내", tTitle[i])
					
					return
				end if
			else
				'개인
				if i == 1 or i == 2 or i == 3 then
					if CInt(tIndex[1]) < 0 then
						szCase = "대출용도를 선택해 주세요."
					else
						szCase = ""
					end if
				else
					if CInt(tIndex[1]) < 0 then
						Dim tTitle
						tTitle = {"연령대", "대출용도-신용거래약정", "대출용도-대주거래약정", "대출용도-담보대출약정", "자산현황", 
							  "연간소득현황", "부채현황", "원리금 연체여부", "신용점수", "변제계획", "신용공여 이해도"}
							  
						Form.ShowAlert("", tTitle[i] & "을 선택해 주세요.")
						
						return
					end if				
				end if 
				
			end if 
		end if
	next	
	
	if szCase ~= null and szCase ~= "" then
		Form.ShowAlert("", szCase)
		szCase = ""
	else	
		DATAMANAGER.RequestTranData("oblon_basc_101a")
	end if
	
End Function 
