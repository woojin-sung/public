'============================================================================
' 화 면 명 : 
' 화면설명 : KYC메인
' 작    성 : 2021.03.15 : 이현우
'            2021.10.19 : v001. 당일 진단 회차가 2~3회의 경우 재진단사유 팝업
'============================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szEdtPwd
Dim g_szInputData		'다른폼에서 넘어온 데이터
Dim g_szCustClsCode	'개인/법인 여부 (1:개인, 2:법인)
Dim g_szPlainRm		'메모리평문 적용유무 (0:미적용 / 1:적용)
Dim g_szContClsCode    '접촉구분코드 (4:온라인)
Dim g_szAnxtAprt_Yn	'부적정여부(Y:부적정, N:적정)
'v001 START
Dim g_szApltReasClcd	'신청사유구분코드 0.없음 1.사실관계착오 2.오기 3.기타
Dim g_szRmrk			'비고
'v001 END
Dim QUERY
Dim EXECUTE
QUERY   = "1"		'질의문
EXECUTE = "2"		'입력
g_szApltReasClcd = "0"
g_szRmrk         = ""

'v001 START
Dim g_szPopupYN
Dim g_szIsncYN
g_szPopupYN = "N"
g_szIsncYN  = "N"
'v001 END

Dim g_nChangeCnt
Dim g_szChangeData
Dim g_tChangeData
Dim g_szCustName
'============================================================================
' 폼 초기화
'============================================================================
Sub Form_OnFormInit()
	g_szAnxtAprt_Yn = ""	
	g_nChangeCnt = 0
	g_szAcno = cmbAcnt.total				'계좌번호
	g_szAsno = cmbAcnt.sequence				'일련번호
	g_szContClsCode = "4"					'접촉구분(4:온라인)
	btnOpenpopup.visible = 0
	'LHR 수정
	if Len(edtPassword.caption) > 0 then
		edtPassword.caption = ""
	end if
	'타폼 링크데이터 처리
	g_szInputData = Form.GetOpenLinkData()
	splitData = Split(g_szInputData, "||")
	szAcno = splitData(0)	'계좌번호
	if Trim(szAcno) <> "" then
		g_szPopupYN = "Y"
	end if
	
	'LHR 수정
	if g_szPopupYN == "N" then
		BtnExecute.top = 512
		btnContinue.top = 512
		LinkForm.height = 565
	else
		BtnExecute.top = 557
		btnContinue.top = 557
		LinkForm.height = 607
	end if
	Form.SetSharedData("mbonl93500_g_szPopupYN" , g_szPopupYN)
	'LHR 수정
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	'대출 고객정보 확인 조회 for 개인/법인 구분
	'DATAMANAGER.RequestTranData("oblon_basc_102r")
End Sub
'============================================================================
' 폼 종료시 부모폼에 리턴
'============================================================================
Sub Form_OnFormClose()
	'부적정여부 Return to 담보대출신청_약정등록
	Form.SendReturnToParent( "mbonl93500" , g_szAnxtAprt_Yn )
End Sub
'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
     Dim szAct
     szAct = cmbAcnt.caption
     '대출 고객정보 확인 조회 for 개인/법인 구분
     if szTranID == "oblon_basc_102r" then		
		g_szAcno = cmbAcnt.total				'계좌번호
		g_szAsno = cmbAcnt.sequence				'일련번호
		DATAMANAGER.SetDataValue(0, "oblon_basc_102r", "InBlock1", "ACNO",     0, g_szAcno)
	End If
	
	'대출 고객정보 확인서 응답 등록
	if szTranID = "oblon_basc_101a" then
		DATAMANAGER.ClearInputData(0, szTranID )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "1" )	'Insert
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , cmbAcnt.total )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , g_szEdtPwd )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , g_szContClsCode )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CUST_RLTS_CODE" 		, 0 , "" )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PXPR_NAME" 			, 0 , "" )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BRDT" 				, 0 , "" )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CUST_RLTS_ETC_CNTT" 	, 0 , "" )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "COUN_EMPNO" 			, 0 , "" )
		
		'V001
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_REAS_CLCD"		, 0 , g_szApltReasClcd )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RMRK" 				, 0 , g_szRmrk )
		
		Dim DATA_CNT
		DATA_CNT = 0
		
		for i = 0 to #g_tChangeData - 1
			if g_tChangeData[i] ~= null and g_tChangeData[i] ~= "" then
				Dim tIndex		
				tIndex = Split(g_tChangeData[i], "☆")
				
				if g_szCustClsCode == "1" then
					if CInt(tIndex[1]) > -1 then
						Dim QUES_QSIT_NO
						QUES_QSIT_NO = Mid(tIndex[0], 5, #tIndex[0])
						
						DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "QUES_QSIT_NO" , DATA_CNT , QUES_QSIT_NO )
						DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ITEM_NO_VAL"  , DATA_CNT , CInt(tIndex[1])+1 )
						DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ITEM_CNTT" 	 , DATA_CNT , tIndex[2] )
						DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "RSPN_SLCT_YN" , DATA_CNT , "Y" )
						
						DATA_CNT = DATA_CNT + 1
					end if
				else
					'법인
					'LHR 수정
					Dim QUES_QSIT_NO
					Dim QUES_QSIT_TYPE
					QUES_QSIT_NO  = Mid(tIndex[0], 5, #tIndex[0])
					QUES_QSIT_TYPE= Mid(tIndex[0], 1, 3)
					
				    if QUES_QSIT_TYPE == "rdo" then
					    if CInt(tIndex[1]) > -1 then
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "QUES_QSIT_NO" , DATA_CNT , QUES_QSIT_NO )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ITEM_NO_VAL"  , DATA_CNT , CInt(tIndex[1])+1 )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ITEM_CNTT" 	, DATA_CNT , tIndex[2] )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "RSPN_SLCT_YN" , DATA_CNT , "Y" )
						    DATA_CNT = DATA_CNT + 1
					    end if
					else
					    'if CInt(tIndex[1]) > -1 then
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "QUES_QSIT_NO" , DATA_CNT , QUES_QSIT_NO )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ITEM_NO_VAL"  , DATA_CNT , "0" )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ITEM_CNTT" 	, DATA_CNT , tIndex[2] )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "TRGT_AMT" 	, DATA_CNT , tIndex[1] )
						    DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "RSPN_SLCT_YN" , DATA_CNT , "Y" )
						    DATA_CNT = DATA_CNT + 1
					    'end if
				    end if				
				end if 
			end if
		next	
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "PROS_CLS_CODE" , 0 , "I" 			 )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNO" 		   , 0 , Left( szAct, 8))
	end If	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'대출 고객정보 확인 조회 for 개인/법인
	If szTranID = "oblon_basc_102r" Then
		'개인/법인
		g_szCustClsCode = DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "CUST_CLS_CODE" , 0)	
		g_szAnxtAprt_Yn  = DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "ANXT_APRT_YN" , 0)
		g_nChangeCnt = CInt(DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "PROS_CSNU" , 0))
		
		if g_szAnxtAprt_Yn = "Y" then
			'lblResult.caption = "부적정"
			tblInfo.SetCellString(0, 1, "부적정")
			tblInfo.SetCellFgColor(0, 1, "290")
			lblKYC.caption = "부적정 입니다."
			lblKYC.changeTextAttr(0, 3, 290, 3, true)
			btnOpenpopup.visible = 1
		elseif g_szAnxtAprt_Yn = "N" then
			'lblResult.caption = "적정"
			tblInfo.SetCellString(0, 1, "적정")
			tblInfo.SetCellFgColor(0, 1, "291")
			lblKYC.caption = "적정 입니다."
			lblKYC.changeTextAttr(0, 2, 291, 3, true)
			btnOpenpopup.visible = 1
		else
			'lblResult.caption = g_szAnxtAprt_Yn
			tblInfo.SetCellString(0, 1, "-")
			tblInfo.SetCellFgColor(0, 1, "267")
			lblKYC.caption = "미등록상태 입니다."
			lblKYC.changeTextAttr(0, 5, 267, 3, true)
			btnOpenpopup.visible = 0
		end if
		
		If g_szCustClsCode = "1" Then '개인 
			LinkForm.linkfile = "mbonl93501.xmf"		'개인설문지
			LinkForm.enable = True
			'TriggerEvent
			callTriggerEvent(QUERY)
		else						   '법인
			LinkForm.linkfile = "mbonl93502.xmf"		'법인설문지
			LinkForm.enable = True
			'TriggerEvent
			callTriggerEvent(QUERY)
		End If
		
		if g_szPopupYN == "N" and g_szIsncYN == "Y" and DATAMANAGER.GetDataValue(0, "oblon_basc_102r", "OutBlock1", "ANXT_APRT_YN" , 0) == "Y" then
			g_szIsncYN = "N"
			Form.MsgBox("알림", "부적정확인서 발급 후 약정이 가능합니다." & Chr(13) &  "발급하시겠습니까?", "ISNC_YN", "1")
		end if
		
		Dim szStartDay
		Dim szEndDay
		
		szStartDay = trim(DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "REG_DATE" , 0))
		szEndDay   = trim(DATAMANAGER.GetDataValue( 0 , "oblon_basc_102r", "OutBlock1", "MTRT_DATE" , 0))

		Dim sBtnCaption 
		'sBtnCaption = "변경하기"
		
		'등록일
		if szStartDay == "" then
			'lblRegDate.caption = "-"
			tblInfo.SetCellString(1, 1, "-")
			sBtnCaption = "등록하기"
		else
			'lblRegDate.caption = szStartDay
			tblInfo.SetCellString(1, 1, szStartDay)
		end if
		
		'만기일
		if szEndDay == "" then
			'lblMtrtDate.caption = "-"
			tblInfo.SetCellString(2, 1, "-")
		else
			'lblMtrtDate.caption = szEndDay
			tblInfo.SetCellString(2, 1, szEndDay)
			
			'만기일이 지나면 재등록 
			Dim sDate
			sDate = Calendar0.calyear & Calendar0.calmonth & Calendar0.calday
			if CInt(szEndDay) < CInt(sDate) then
				sBtnCaption = "재등록하기"
			else
				sBtnCaption = "변경하기"
				if (g_szPopupYN == "Y") then '팝업이거나   
					if (szStartDay == sDate) then  '등록일이 오늘날짜가 아닌 경우 
						BtnExecute.left = -2
						BtnExecute.width = 190
						
						btnContinue.visible = 1
						btnContinue.enable = 1
						btnContinue.left = 183
						btnContinue.width = 194			
					end if 
				end if 
			end if 
		end if		
		
		BtnExecute.caption = sBtnCaption
		
	elseif szTranID == "oblon_basc_101a" then		
		g_szAnxtAprt_Yn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ANXT_APRT_YN" , 0)	
		'부적정여부를 공유메모리에 세팅
		
		if len(g_szAnxtAprt_Yn) > 0 Then    
		    if trim(g_szAnxtAprt_Yn) = "" then
			    Form.ShowAlert("알림", "부적정여부를 수신받지 못했습니다. IT에 연락해주세요.")
			    exit sub
		    end if
		    
		    g_szIsncYN = "Y"
	
		end If
		
		Form.MsgBox("알림", "신용공여 고객정보확인서\n등록이 완료되었습니다.", szTranID, 6)
	elseif szTranID == "obcsb_acif_000r" then
		g_szCustName = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_FULL_NAME", 0)
		lblName.caption = g_szCustName.."님의 적정성 판단 결과는"
		DATAMANAGER.RequestTranData("oblon_basc_102r")
	End If	

End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "oblon_basc_102r" then
		Form.MsgBox("알림", szErrMsg, "", 0)
		
		'Default 개인 설문지
		LinkForm.linkfile = "mbonl93501.xmf"
		LinkForm.enable = False
		Exit Sub
		
	else
		Dim szSubErrMsg
		szSubErrMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if trim(szSubErrMsg) <> "" then
			szErrMsg = szErrMsg & "\n" & szSubErrMsg
		end if
		Form.MsgBox("알림", szErrMsg , "", 0)
	end if
End Sub
'============================================================================
' Receive Trigger Event
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "ChangeData" then
		if sParam ~= null and sParam ~= "" then
			if len(g_szEdtPwd) < 4 Then
				Form.ShowAlert("알림", "비밀번호를 입력해주세요.")
				Exit Sub
			End If
		'	
		'	'v001
		
			g_szChangeData = sParam
			if g_nChangeCnt == 0 then
				g_szApltReasClcd = "0"
				g_szRmrk = ""
				
				'Trigger Event
				f_ChangeTr()
			else
				Form.OpenPopup("mbonl93500_p1.xmf" , "" , "")
			end if
		
		end if
	elseif sEventName == "CORRECT_PWD" then
		if nil ~= sParam and "" ~= sParam then
			edtPassword.encdata = sParam
			call edtPassword_OnEditComplete()
		end if
	end if 

End Sub
'============================================================================
' TriggerEvent
'============================================================================
Function callTriggerEvent(trigType)
	
	g_szAcno = cmbAcnt.total				'계좌번호
	g_szAsno = cmbAcnt.sequence				'일련번호
	
	'MTS 메모리평문 적용유무 (0:미적용 / 1:적용)
	g_szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS 메모리평문 적용
	if g_szPlainRm = "1" Then
		g_szEdtPwd = edtPassword.caption
	'MTS메모리평문 미적용
	else
		g_szEdtPwd = edtPassword.encdata
	end if
			
	g_szData = g_szAcno & "★" & g_szAsno & "★" & g_szEdtPwd & "★" & g_szCustClsCode & "★" &  g_szCustName
		
	'트리거타입에 따라 이벤트 처리
	Form.triggerEvent("LinkForm", "ACNT_INFO", g_szData)
End Function
