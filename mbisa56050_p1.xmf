	<SCRIPT_INFO _len="2118" _ulen="1950" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입진행상태조회_가입취소 비밀번호 입력
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
' 2020-09-23 : 신극수 : v0001 : [T2007220015] MTS 비밀번호 Edit 메모리평문제거
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub ImageClose_OnClick()
	Form.SendReturnToParent( "mbisa56050_p1" , "" )
	Form.CloseForm()
End Sub

'============================================================================
'확인
Sub btnOK_OnClick()
	If Len(edtPwd.caption) < 4 then
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
		Exit Sub
	End If
	
	Dim szPwd
	'v0001 sta
	'szPwd = Form.GetEncData(edtPwd.caption)
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", FALSE )
	
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then 
		szPwd = Form.GetCtlProp("edtPwd", "caption")
	'MTS메모리평문 미적용상태일때
	else
		szPwd = Form.GetCtlProp("edtPwd", "encdata")
	end if 
	
	'v0001 fin
	Form.SendReturnToParent( "mbisa56050_p1" , szPwd )
	Form.CloseForm()
End Sub

'============================================================================\
'닫기
Sub btnClose_OnClick()
	Call ImageClose_OnClick()
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obaci_mdia_010r" trcode="obaci_mdia_010r" inputcheck="1" useattr="0" >
