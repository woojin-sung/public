	<SCRIPT_INFO _len="17666" _ulen="16604" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap상품 목록 조회
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2023.05.08 : 고승연 : v0002 : [T2305030027] obwat_csad_021r IO 수정, 고객번호,조회구분 입력 추가
'                2023.12.08 : 고승연 : v0003 : [T2310260012] 상품등급 기준 변경 (5단계 -> 6단계)
'-------------------------------------------------------------------------------------------
'============================================================================
'유형조회 #mbwat61020
'|-> 검색 #mbwat61020_p1
'||-> 상품명검색
'|||-> 상품검색 #mbwat61020_p2
'|| |-> 계약하기 : 운용직원검색 #mbwat61020_p3
'||  |-> 운용역프로필 #mbwat61020_p4
'||   |-> 계약하기 : STEP-1 #mbwat61022
'||-> 운용역검색
'| |-> 운용역프로필 #mbwat61020_p4
'|  |-> 상품보기 : 상품검색 #mbwat61020_p2
'|  |-> 계약하기 : STEP-1 #mbwat61022
'|-> 상품정보 : #mbwat61020_p6
'||-> 계약하기 : 운용직원검색 #mbwat61020_p3
'|-> 계약하기 : 운용직원검색 #mbwat61020_p3
' |-> 운용역프로필 #mbwat61020_p4
'  |-> 계약하기 : STEP-1 #mbwat61022
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nLogin
Dim g_nIndex
Dim g_bSelect
Dim g_sSearch
Dim g_sSearchYn

Dim g_zCondVal_1
Dim g_zCondVal_2
Dim g_zCondVal_4
Dim g_zCondVal_5

Dim g_szCode
Dim g_sSpclYn
Dim g_sKycGrad
Dim g_sProsRslt
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
Sub Form_OnFormInitBefore()
	imgSearchIcon.setMaintainingRatio("1")
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
End Sub


'============================================================================
Sub btnSearch_OnClick()
	Form.OpenPopup("mbwat61020_p1" , acntList.total , "")
End Sub


'============================================================================
Sub Form_OnFormInit()
	g_nLogin = -1
	grdData.setUseCardView(true, 15, "btn_12_n.9")
	g_bSelect = false
	btnSearch0_OnClick()
	
	DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번
End Sub

Function f_SendRequestData()
	grdData.rowcount = 0
	lblNoData.visible = false
	TblNoData.visible = false
	DATAMANAGER.RequestTranData("obwat_csad_021r")
end function


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	if szTranID == "obwat_csad_021r" then
		'v0002
		if g_bSelect == true then
			DATAMANAGER.SetDataValue(0, "obwat_csad_021r", "InBlock1", "IQRY_CLS_CODE", 0 , "1")
		else
			DATAMANAGER.SetDataValue(0, "obwat_csad_021r", "InBlock1", "IQRY_CLS_CODE", 0 , "2")
		end if
	
		if chkMine.checkstate == true or chkMine.checkstate == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , acntList.total )
		end if
		
		Dim sCsno
		sCsno = Form.GetSharedData("&CUST_NUM", false)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO", 0 , sCsno) '고객번호		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_1_COND_VAL", 0 , g_zCondVal_1) '운용주체	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_2_COND_VAL", 0 , g_zCondVal_2) '위험등급	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_4_COND_VAL", 0 , g_zCondVal_4) '투자자산
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_5_COND_VAL", 0 , g_zCondVal_5) '자문사
	end if
End Sub

'============================================================================
Sub chkMine_OnChange(sCheckState)
	if sCheckState == "1" then
		chkMine.checkstate = "0"
		f_SetChkMine()
	else
		f_SendRequestData()
	end if
End Sub

Sub f_SetChkMine()
	Dim sLOGIN_TYPE
	sLOGIN_TYPE = Form.GetSharedData( "&LOGIN_TYPE", 0 )

	If sLOGIN_TYPE = "1" Then
		g_nLogin = 0
		Form.MsgBox("알림", "로그인이 필요한 메뉴입니다.\n로그인하시겠습니까?", "GOTOLOGIN", 1)
		Exit Sub
	else
		chkMine.checkstate = "1"
		f_SendRequestData()
	End If
End Sub

Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "GOTOLOGIN" Then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021", "", "")
		else
			g_nLogin = -1
			g_nIndex = -1
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Login_Type" then
		if sRet == "3" then
			if g_nLogin == 0 then
				chkMine.checkstate = "1"
				f_SendRequestData()
			elseif g_nLogin == 1 then
				acntList.ReloadAccount()
				
				Dim sCode, sGrpCode
				sCode = grdData.GetCellData("bd_PRD_CD", g_nIndex)
				sGrpCode = grdData.GetCellData("grpCode", g_nIndex)
				g_nIndex = -1
				
				if Len(sGrpCode) == 1 then '지점 운용형은 운용역 선택후 진행
					Form.OpenPopup("mbwat61020_p3" , acntList.total.."|"..sGrpCode.."|" , "") '운용역선택
				elseif Len(sGrpCode) > 1 then
					Dim sCsno
					sCsno = Form.GetSharedData("&CUST_NUM", false)
					DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , sCode )
					DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , acntList.total )
					DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "CSNO" , 0 , sCsno )
					DATAMANAGER.RequestTranData( "obwat_onln_003r" )
				end if
			end if
		else
			g_nLogin = -1
			g_nIndex = -1
		end if
		
	'내성향맞춤 해제 검색
	elseif sKeyName == "mbonl88060_p11" then		
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			f_SendRequestData()
		end if
		
	' 상세검색 조건 검색
	elseif sKeyName == "CONFIRM" then
		g_sSearch = sRet
		g_sSearchYn = "Y"
		
		Dim tData
		tData = Split(g_sSearch, "|")
		
		'운용주체 조건
		if tData(0) == "99" then
			g_zCondVal_1 = ""
		else
			g_zCondVal_1 = tData(0)
		end if
		
		'위험등급 조건
		if tData(1) == "99" then
			g_zCondVal_2 = ""
		else
			g_zCondVal_2 = tData(1)
		end if
		
		'자문사 조건
		if tData(2) == "99" then
			g_zCondVal_5 = ""
		else
			g_zCondVal_5 = tData(2)
		end if
		
		'투자자산 조건
		if tData(3) == "99" then
			g_zCondVal_4 = ""
		else
			g_zCondVal_4 = tData(3)
		end if
		
		f_SendRequestData()
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			Form.OpenPopup("mbwat61022" , g_szCode , "") '계약(가입)
		elseif sRet == "CANCEL_mbonl81010_p20" then
		
		end if
	end if
End Sub

'============================================================================
Sub lblMine_OnClick()
	if chkMine.checkstate == "0" then
		f_SetChkMine()
	elseif chkMine.checkstate == "1" then
		chkMine.checkstate = "0"
		f_SendRequestData()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_csad_021r" then
		Dim nCount, nIndex
		
		g_sSpclYn   = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock2", "KYC_SPCL_INVR_YN" , 0 )
		sRcmdCode   = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock2", "KYC_INVT_RCMD_CLS_CODE" , 0 )
		g_sKycGrad  = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock2", "WA_KYC_GRAD_CODE" , 0 )
		g_sProsRslt = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock2", "PROS_RSLT_CODE" , 0 )
		
		'사용자 투자성향 표시
		if g_sSpclYn == "Y" then
			Label1.caption = "전문투자자>"
			'Label1.fgcolor = "330"
		elseif g_sProsRslt == "31" then
			Label1.caption = "미등록 >"
			'Label1.fgcolor = "146"
		elseif g_sProsRslt == "32" then
			Label1.caption = "권유미희망 >"
			'Label1.fgcolor = "321"
		elseif g_sProsRslt == "33" then
			Label1.caption = "권유미희망 >"
			'Label1.fgcolor = "321"
		elseif g_sProsRslt == "34" then
			Label1.caption = "미등록 >"
			'Label1.fgcolor = "146"
		else
			if g_sKycGrad == "01" then
				Label1.caption = "고수익지향형 >"
				'Label1.fgcolor = "326"
			elseif g_sKycGrad == "02" then
				Label1.caption = "성장지향형 >"
				'Label1.fgcolor = "326"
			elseif g_sKycGrad == "03" then
				Label1.caption = "중립형 >"
				'Label1.fgcolor = "328"
			elseif g_sKycGrad == "04" then
				Label1.caption = "안정지향형 >"
				'Label1.fgcolor = "328"
			elseif g_sKycGrad == "05" then
				Label1.caption = "이자소득형 >"
				'Label1.fgcolor = "329"
			end if
		end if
		
		Label1.fgcolor = "146"
		
		nCount = DATAMANAGER.GetDataCount("0", szTranID , "OutBlock1")
		nIndex = CInt(grdData.rowcount)
		
		if nIndex == 0 then
			if g_sSearchYn = "Y" then
				lblNoData.visible = true
				TblNoData.visible = false
			else
				'성향맞춤으로 조회시
				if g_bSelect == true then
					lblNoData.visible = false
					TblNoData.visible = true
				else
					lblNoData.visible = true
					TblNoData.visible = false
				end if
			end if
		end if
		
		for i = (nIndex - nCount) to nIndex-1
			grdData.SetCellData("text0", i, "최소가입금액")
			grdData.SetCellData("text1", i, "투자대상")
			grdData.SetCellData("text2", i, "수수료")
			grdData.SetCellData("text3", i, "자문사")
			
			grdData.SetCellImage("info", i, "img_bgbox.9.png")
			grdData.SetCellData("info", i, "상품정보")
			grdData.SetCellImage("contract", i, "btn_01_n.9.png")
			grdData.SetCellData("contract", i, "계약하기")
			
			Dim sManageGbn
			sManageGbn = grdData.GetCellData("badge0", i) '운영구분
			
			if sManageGbn = "01" then
				grdData.SetCellData("badge0", i, "본사 운용형")
			elseif sManageGbn = "02" then
				grdData.SetCellData("badge0", i, "지점 운용형")
			elseif sManageGbn = "03" then
				grdData.SetCellData("badge0", i, "국내 자문형")
			elseif sManageGbn = "04" then
				grdData.SetCellData("badge0", i, "해외 자문형")
			end if
			
			grdData.SetCellImage("badge0", i, "img_bgcircle_grade_316.9.png")
			
			Dim sRiskGrade
			sRiskGrade = grdData.GetCellData("badge1", i) '상품위험등급
			
			'v0003
			if sRiskGrade = "01" then
				grdData.SetCellImage("badge1", i, "img_bgcircle_grade_372.9.png")
				grdData.SetCellFgColor("badge1", i, 273)
				grdData.SetCellData("badge1", i, "매우높은위험")
			elseif sRiskGrade = "02" then
				grdData.SetCellImage("badge1", i, "img_bgcircle_grade_373.9.png")
				grdData.SetCellFgColor("badge1", i, 144)
				grdData.SetCellData("badge1", i, "높은위험")			
			elseif sRiskGrade = "03" then
				grdData.SetCellImage("badge1", i, "img_bgcircle_grade_374.9.png")
				grdData.SetCellFgColor("badge1", i, 144)
				grdData.SetCellData("badge1", i, "다소높은위험")
			elseif sRiskGrade = "04" then
				grdData.SetCellImage("badge1", i, "img_bgcircle_grade_375.9.png")
				grdData.SetCellFgColor("badge1", i, 144)
				grdData.SetCellData("badge1", i, "보통위험")
			elseif sRiskGrade = "05" then
				grdData.SetCellImage("badge1", i, "img_bgcircle_grade_376.9.png")
				grdData.SetCellFgColor("badge1", i, 144)
				grdData.SetCellData("badge1", i, "낮은위험")
			elseif sRiskGrade = "06" then
				grdData.SetCellImage("badge1", i, "img_bgcircle_grade_377.9.png")
				grdData.SetCellFgColor("badge1", i, 273)
				grdData.SetCellData("badge1", i, "매우낮은위험")
			end if
			
			'grdData.SetCellFgColor("badge1", i, 16)
			
			Dim sHGDT_PROD_YN
			sHGDT_PROD_YN = grdData.GetCellData("badge2", i) '고난도 여부
			
			if sHGDT_PROD_YN = "Y" then
				grdData.SetCellImage("badge2", i, "img_bgcircle_grade_372.9.png")
				grdData.SetCellFgColor("badge2", i, 273)
				grdData.SetCellData("badge2", i, "고난도")
				'grdData.SetCellFgColor("badge2", i, 16)
			else
				grdData.SetCellData("badge2", i, "")
			end if
		next
		
		if DATAMANAGER.IsMoreNextData( szTranID ) then
			DATAMANAGER.RequestNextData( szTranID )
		else
			g_sSearchYn = "N"
			g_zCondVal_1 = ""
			g_zCondVal_2 = ""
			g_zCondVal_4 = ""
			g_zCondVal_5 = ""
		end if
	
	elseif szTranID == "obwat_onln_003r" then
		Dim sJoinYN
		sJoinYN = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "JOIN_ABLE_YN" , 0 )
		
		if sJoinYN == "Y" then
			g_szCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 )
			
'			Form.OpenPopup("mbwat61022" , g_szCode , "") '계약(가입)
			
			Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		else
			Dim sResultCode, sMsg
			sResultCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_RSLT_CODE" , 0 )
			sMsg = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_PRHB_DTL_CNTT" , 0 )
			
			Form.OpenPopup("mbwat61020_p9", sResultCode.."|"..sMsg, "")
		end if
	'23.05.22 금융상품일련번호 채번 추가
	elseif	szTranID	=	"obsap_acif_999a"	then
		dim szFnprJoinSrno
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		
		Form.SetSharedData("FNPR_JOIN_SRNO", szFnprJoinSrno)	
	end if
End Sub

'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	Dim sName, sCode, sGrpCode
	sName = grdData.GetCellData("name", lRow)
	sCode = grdData.GetCellData("bd_PRD_CD", lRow)
	sGrpCode = grdData.GetCellData("grpCode", lRow)
	
	if szCellID == "info" then
		Form.OpenPopup("mbwat61020_p6" , acntList.total.."|"..sGrpCode.."||"..sName , "") '상품정보 팝업
	elseif szCellID == "contract" then
		Dim sLOGIN_TYPE
		sLOGIN_TYPE = Form.GetSharedData( "&LOGIN_TYPE", 0 )
		
		If sLOGIN_TYPE = "1" Then
			g_nLogin = 1
			g_nIndex = lRow
			Form.MsgBox("알림", "로그인이 필요한 메뉴입니다.\n로그인하시겠습니까?", "GOTOLOGIN", 1)
			Exit Sub
		else
			if Len(sGrpCode) == 1 then '지점 운용형은 운용역 선택후 진행
				Form.OpenPopup("mbwat61020_p3" , acntList.total.."|"..sGrpCode.."|" , "") '운용역선택
			elseif Len(sGrpCode) > 1 then
				Dim sCsno
				sCsno = Form.GetSharedData("&CUST_NUM", false)
				
				DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , sCode )
				DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , acntList.total )
				DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "CSNO" , 0 , sCsno )
				DATAMANAGER.RequestTranData( "obwat_onln_003r" )
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then '유의사항
		Form.OpenFramePopup("mbwat61020_p8", "", "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "ReloadAccount" then
		acntList.ReloadAccount()
		Form.PostLinkData(sValue, acntList.total)
	end if
End Sub

'============================================================================
Sub btnSearch0_OnClick()
	g_bSelect = not(g_bSelect)
	
	if g_bSelect == true then
		Image0.imgpath = "checkmenu_o.png"
		f_SendRequestData()
	else
		Image0.imgpath = "checkmenu_n.png"
		if g_sSpclYn = "Y" then
			f_SendRequestData()
		else
			Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
		end if
	end if
End Sub

'============================================================================
Sub btnSearch1_OnClick()
	Dim sData
	Dim invtYn
	
	if g_bSelect == true then
		invtYn = "Y"
	else
		invtYn = "N"
	end if
				
	sData = g_sSpclYn.."|"..g_sKycGrad.."|"..g_sProsRslt.."|"..invtYn
	
	if g_bSelect == true then
		if g_sProsRslt = "31" or g_sProsRslt = "32" or g_sProsRslt = "33" or g_sProsRslt = "34" then
			Form.openPopupAnimation("mbwat61020_p11", "", "", "2")
		else
			Form.OpenFramePopup("mbwat61020_p12", sData, "")
		end if
	else
		Form.OpenFramePopup("mbwat61020_p12", sData, "")
	end if
	
	'Form.OpenPopup("mbwat61022_p3" , sData , "")
	
End Sub

'============================================================================
Sub TblNoData_OnClick(lRow, lCol)
	'투자성향진단하기 행을 선택할 경우
	if lRow == 5 then
		Form.OpenFramePopup( "mbonl81010" , "mbwat61020" , "")
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("FNPR_JOIN_SRNO", "")
end sub

