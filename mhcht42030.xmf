'****************************************************************************
Dim g_szIndexCode		'지수코드
Dim g_szChrtType
Dim g_szToday
Dim g_sPeriodType
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_flagInit
Dim g_flagLine
Dim g_nSNSType 		'1 카카오톡, 2 카카오톡 화면 공유, 3 트위터, 4 페이스북

g_szChrtType = "D" 	'일
'g_flagMinTic = true
g_flagInit =	true

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
