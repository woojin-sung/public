'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetMarketCategory("1")		   'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
	ChartEx0.SetLoadChart("jisu")
End Sub
'============================================================================
function setChart()
     szValue = Form.GetEnvData( "chart_setting" )
     szValueMinTick = Form.GetEnvData( "chart_settingmintick" )    
	
	if szValue = "" then
		Form.SetEnvData( "chart_settingmintick", "2^001" )
		g_sPeriod	= "001"
		g_sPeriodType	= "2"
		
	else
		temp = split(szValue, "^")
		g_sPeriodType	= temp[0]
		g_sPeriod 	= temp[1]
		
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")

		g_szMinType = temp1[0]
		g_szTicType = temp1[1]
		
	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "chart_min0" )
		szTic0 = Form.GetEnvData( "chart_tic0" )
		
'PENTA13 START => 2023.08.07(차트성능개선)
		if szMin0 <> "" and szMin0 <> 0 then
			'szMin0 = "1"
			g_szMinType = szMin0
			
		else
			g_szMinType = "1"
			szMin0 = "1"
			
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			'szTic0 = "1"
			g_szTicType = szTic0
			
		else
			g_szTicType = "1"
			szTic0 = "1"
			
		end if
'PENTA13 END
			
		rdoPeriod01.SetRadioCaption( 2, szMin0.."분" )	
		rdoPeriod01.SetRadioCaption( 3, szTic0.."틱" )
		' 20190404 HWG END
		     
	end if
	
	'분틱 셋팅	
	tmpIndex = null 
	if g_sPeriodType = "0" or g_sPeriodType = "1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			rdoPeriod01.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			rdoPeriod01.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
		
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			rdoPeriod01.SetRadioCaption( g_TempIndex, "주" )
			
'PENTA13 START => 2019.03.04
		elseif g_sPeriodType = "4" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			rdoPeriod01.SetRadioCaption( g_TempIndex, "월" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			rdoPeriod01.SetRadioCaption( g_TempIndex, "년" )
			
		end if
'PENTA13 END
	end if
	 
	rdoPeriod01.currentindex = g_TempIndex
	PeriodSet(sPeriodType)		'PENTA13 START => 2023.08.07(차트성능개선)
end function
'============================================================================
'Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	dim szLinkData

	'-----------------------------------------------------------
	'링크 Data
	'-----------------------------------------------------------
	szLinkData = Form.GetOpenLinkData()
		
	if len(szLinkData)  > 0	then
		g_szIndexCode	= szLinkData
		
	else
		g_szIndexCode	= Form.GetSharedData("42000INITCODE", 0)
		
		'20221117 LES START 거래소 차세대 업종코드 변경
		'g_szIndexCode = "0001"
		
		g_szIndexCode = Form.GetSharedData("&ITEM_UPJONG", 0)
		
		if g_szIndexCode == "" then
			g_szIndexCode = "KGG01P"
		end if
		'20221117 LES END
	
	end	if
	
	'-----------------------------------------------------------
	'종목검색
	'-----------------------------------------------------------
	
	Form.SetSearchType("9")
	
	'20221117 LES START
	'순서 변경 서치타입 세팅 후 호출해줘야함
	'전역변수명 잘못되어있어 수정 (g_szItemCode -> g_szIndexCode)
	'이전 업종코드(6자리 미만)일때 변환 함수 호출
	nCodeLen = Form.getLen(g_szIndexCode)
	
	if nCodeLen < 6 then
		g_szIndexCode = Form.ConvertUpjongCode(g_szIndexCode)
	end if
	
	Form.SetItemCode(g_szIndexCode)
	'20221117 LES END
	
	'-----------------------------------------------------------
	'차트관련
	'-----------------------------------------------------------
	g_flagMin = false
	g_flagTic = false
	g_flagLine = false
	g_flagWeek = false
	g_flagInit = true
	g_szChrtType = "D" 	'일
	
	g_szToday = Form.GetSharedData( "&HOST_DATE", 0 )
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )
	
	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if 	
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
		
	rdoPeriod01.SetRadioCaption( 2, szMin0.."분" )	
	rdoPeriod01.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END

'PENTA13 START => 2023.08.07(차트성능개선)
	setChart()

	'DATAMANAGER.RequestTranData("ohhts_1514_001r")
	'DATAMANAGER.RequestTranData("ohhts_1504_001r")
'PENTA13 END
	
	PeriodSet(g_szChrtType)
	RequestData()
End Sub

'============================================================================
'rdoPeriod01_OnClick
'============================================================================
Sub rdoPeriod01_OnClick(nIndex)
	if nIndex == 0 then  			'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then  		'주/월/년
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false then
				sTemp = rdoPeriod01.GetRadioCaption(1)
				if sTemp == "월" then
					g_szChrtType = "M"

				elseif sTemp == "년" then		'PENTA13 START => 2019.03.04
					g_szChrtType = "Y"

				else
					g_szChrtType = "W"
					
				end if
				
				g_flagWeek = true
				PeriodSet(g_szChrtType)
				
			else
				sTemp = rdoPeriod01.GetRadioCaption(1)
				Form.OpenPopup( "mhcht13000_p4.xmf", sTemp, "" )	'PENTA13 START => 2019.03.04
				
			end if
		'------------------------------------------------
'		if g_flagWeek == true   then
'			if g_szChrtType == "W" then
'				g_szChrtType = "M"
'				g_flagWeek = false
'				rdoPeriod01.SetRadioCaption( 1, "월" )
'			else
'				g_szChrtType = "W"
'			end if
'		else
'			if g_szChrtType == "M" then
'				g_szChrtType = "W"
'				g_flagWeek = true
'				rdoPeriod01.SetRadioCaption( 1, "주" )
'			else
'				g_szChrtType = "M"
'			end if
'		end if	
'		PeriodSet(g_szChrtType)
		'------------------------------------------------
'	elseif nIndex == 2 then  '월
'		g_szChrtType = "M"
'		PeriodSet(g_szChrtType)

	elseif nIndex == 2 then   '분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(rdoPeriod01.GetRadioCaption(2),"분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
			
		else
			If g_flagInit = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhcht13000_p1.xmf", g_szMinType, "" )
			End If
			
		end if
		
	elseif nIndex == 3 then   '틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"
		
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(rdoPeriod01.GetRadioCaption(3),"틱")
			g_szTicType = tmpTic[0]
			
			PeriodSet(g_szChrtType)
			
		else
			If g_flagInit = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhcht13000_p2.xmf", g_szTicType, "" )
			End If
			
		end if
	end if	
	
End Sub

