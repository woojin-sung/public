'============================================================================
'RequestData
'============================================================================
Function RequestData()
	PeriodSetChart(g_szChrtType)  '20230905 한국금융IT : 일주월분 차트 주기 설정

	if g_sPeriodType = "1" then					'분
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		
		'20221117 LES START - 과거데이터 포함여부 추가
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN", 0, "Y")
		
		szToday = Form.GetSharedData( "&HOST_DATE", 0 )
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_DATE1", 0, szToday)
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp)
		DATAMANAGER.RequestTranData("ohhts_5020_002r")
			
	elseif g_sPeriodType =	"0" then				'틱
		DATAMANAGER.SetDataValue(0, "ohhts_5020_003r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_003r", "InBlock2", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
			
		DATAMANAGER.SetDataValue(0, "ohhts_5020_003r", "InBlock2", "FID_INPUT_CNT1", 0, g_szTicType)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, "2")
		
		'20221117 LES START - 과거데이터 포함여부 추가
		DATAMANAGER.SetDataValue(0,  "ohhts_5020_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y")		
			
		DATAMANAGER.RequestTranData("ohhts_5020_003r")
		
	else
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, "U")
		szToday = Form.GetSharedData( "&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_DATE1", 0, szToday)
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR"	, 0, g_szChrtType)
			
		DATAMANAGER.RequestTranData("ohhts_5020_001r")
		
	end if
	
	DATAMANAGER.RequestTranData("ohhts_1514_001r")
	DATAMANAGER.RequestTranData("ohhts_1504_001r")
end function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
		
	elseif sPeriodType = "A" then
		g_sPeriod = g_szMinType
		'g_sPeriod = CInt(g_szMinType)
		g_sPeriodType = "1"
		
	elseif sPeriodType = "D" then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		
	elseif sPeriodType = "W" then 
		g_sPeriodType = "3"
		g_sPeriod = "1"
		
	elseif sPeriodType = "M" then 
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
	elseif sPeriodType = "Y" then	'PENTA13 START => 2019.03.04
		g_sPeriodType = "5"
		g_sPeriod = "1"

	end if
	
	sPeriod = CInt( g_sPeriod )
	
	if Len( sPeriod ) = 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod ) = 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
   
	RequestData()	
end function
'============================================================================
'20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType = "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
		
	elseif sPeriodType = "A" then
		g_sPeriod = g_szMinType
		'g_sPeriod = CInt(g_szMinType)
		g_sPeriodType = "1"
		
	elseif sPeriodType = "D" then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		
	elseif sPeriodType = "W" then 
		g_sPeriodType = "3"
		g_sPeriod = "1"
		
	elseif sPeriodType = "M" then 
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
	elseif sPeriodType = "Y" then
		g_sPeriodType = "5"
		g_sPeriod = "1"

	end if
	
	sPeriod = CInt( g_sPeriod )
	
	if Len( sPeriod ) = 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod ) = 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
end function
'20230905 한국금융IT END : 일주월분 차트 주기 설정
'============================================================================
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
