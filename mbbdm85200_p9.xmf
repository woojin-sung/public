'============================================================================
' 2012.06.22 : 정민영 : v0001 : 개선
'============================================================================


'============================================================================
Dim g_Flag
Dim sNmetBswrGb '비대면업무구분 (100.비대면계좌개설 000.비대면업무신청) 
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	sNmetBswrGb	= Form.GetSharedData("BDM_NMETBSWRGB"      , false ) '2021.05.04. 김유경
	recv_data = Form.GetOpenLinkData()
	
	tData = Split(recv_data, "★")
	
	if tData[0] = "from_mbbdm85183" then
		Table0.SetCellString( 2, 1, "  진행 중인 계좌개설건을" )
		Table0.SetCellString( 3, 1, "  삭제하시겠습니까?" )
		ButtonO.caption = "삭제"
	else
		If sNmetBswrGb == "300" Then '2021.05.04. 김유경
			Table0.SetCellString( 2, 1, "  모바일OTP신청을 중단하시겠습니까?" )
		Else		
			Table0.SetCellString( 2, 1, "  업무신청을 중단하시겠습니까?" )
		End If 
	end if
	
	
	
	ButtonC.fgcolor = 269
	Image2.imgpath = "alpha128.png"

End Sub
'============================================================================


'============================================================================
Sub ButtonO_OnClick()
	g_Flag = "ok"
	Form.CloseForm()
	'진입점 화면은 90022 이고 시장종합은 41000 입니다.
	'홈으로
End Sub

'============================================================================
Sub ButtonC_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Image2_OnClick()
	
	Form.CloseForm()	
End Sub

Sub Form_OnFormClose()
	if g_Flag = "ok" then
		Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
		Form.SetSharedData("&SCREEN_AUTH"      , "" )  'v0001 비대면화면 권한 프리
	else
		Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	end if
	if tData[0] = "from_mbbdm85183" then
		Form.SendReturnToParent("mbbdm85200_p9_end_mbbdm85183" , g_Flag)
	else
		Form.SetSharedData("BDM_NMETBSWRGB", "") '업무구분초기화 JMY
		Form.SendReturnToParent("mbbdm85200_p9_end" , g_Flag)
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	Form.CloseForm()
End Sub
