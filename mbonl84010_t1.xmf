	<SCRIPT_INFO _len="6374" _ulen="5672" >
'============================================================================
' 01.화면명 	: 온라인계좌개설_메인화면
' 02.화면설명	: 
' 03.작성	: 2016.01.14
' 04. 수    정 : 
' 2016-04-18 ESKIM : ISA 계좌개설 추가
' 2016-07-05 : 정민영 : "※ 모바일계좌개설(비대면계좌개설)~" 문구 색상변경 요청(By 영업지원팀_채화석) v0001
' 2020.03.16 : 정민영 : v0002 : [T2003040024] 종금영업종료 및 사명 변경 (Label1 초기문구변경(메리츠종금증권->메리츠증권))
' 2021.05.04 : 정민영 : v0003 : 비대면->MTS앱 통합에 따른 하단 비대면개설앱다운로드 이미지 숨김처리
'
'============================================================================
' v0003 문구변경
' 지점개설계좌 또는 모바일계좌개설(비대면계좌개설) APP 이용 개설계좌 보유
'  ->  지점개설계좌 또는 비대면계좌개설(모바일) 개설계좌 보유 고객
' 모바일계좌개설(비대면계좌개설) APP을 이용한 계좌개설은 입출금 제한 없음
' -> 비대면계좌개설 메뉴를 이용한 계좌개설은 입출금 제한 없음
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szCurrentTime 	'현재시간
dim	g_szToday		'오늘날짜
dim	g_szSelectedIdx	'선택된 버튼
dim	g_szAlertTitle	'알림타이틀

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************



'============================================================================
'ImageTotalAcc_OnClick
'============================================================================
Sub ImageTotalAcc_OnClick()
	DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
	g_szSelectedIdx = "1"
End Sub

'============================================================================
'ImageCMAAcc_OnClick
'============================================================================
Sub ImageCMAAcc_OnClick()
	DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
	g_szSelectedIdx = "3"
End Sub

'============================================================================
'ImageISAAcc_OnClick
'============================================================================
'2016-04-18 ESKIM : ISA 계좌 개설 추가
Sub ImageISAAcc_OnClick()
	DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
	g_szSelectedIdx = "5"
End Sub

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szToday = Form.GetSharedData("&HOST_DATE", 0)
	g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)
	g_szSelectedIdx = "0"
End Sub


'============================================================================
'Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obcpp_bsdy_017r" then
		DATAMANAGER.SetDataValue(0, "obcpp_bsdy_017r", "InBlock1", "MANG_DATE", 0, g_szToday)
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	dim szOutWorkDate			'영업일
	dim szOutWorkTime			'영업시간
	
	''''''''''''''''''''''''''
	'1 영업일인지 조회
	'2 영업시간인지 조회
	''''''''''''''''''''''''''
	
	if szTranID = "obcpp_bsdy_017r" then
	
		szOutWorkDate = DATAMANAGER.GetDataValue(0, "obcpp_bsdy_017r", "OutBlock1", "MANG_DATE", 0)
		g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)

		if g_szToday = szOutWorkDate	then
				szOutWorkTime = left(g_szCurrentTime, 6)
			if	szOutWorkTime >= "080000" and 	szOutWorkTime <= "160000" then
				Form.triggerEvent("#", "OPENACC_MAIN", g_szSelectedIdx )
			else
				Form.ShowAlert(g_szAlertTitle, "온라인 계좌 개설이 가능한 시간은 평일 08:00 ~ 16:00 입니다.")
			end if 
		else
			Form.ShowAlert(g_szAlertTitle, "계좌개설 가능 영업일이 아닙니다.")
		end if 
	end if

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'tbl01_OnClick
'============================================================================
Sub tbl01_OnClick(lRow , lColumn)
	if	lRow		=	0	or	lRow		=	1	then
		ImageTotalAcc_OnClick()
	elseif	lRow		=	2	or	lRow		=	3	then
		ImageCMAAcc_OnClick()
	elseif	lRow		=	4	or	lRow		=	5	then		'2016-04-18 ESKIM : ISA 계좌 개설 추가
		ImageISAAcc_OnClick()
	end	if
End Sub


