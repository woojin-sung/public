	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcpp_bsdy_017r" trcode="obcpp_bsdy_017r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="CLND_CLS_CODE" idx="0" defconst="C001" />
