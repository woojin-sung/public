'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 계약평가_자산별평가
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If Form.GetCtlProp("#acnt0", "total") = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Form.GetCtlProp("#cmbSeq", "caption") = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Function RequestData()
	grd0.rowcount = 0		'Clear Data
	
	If Account_Check() == True then
		DATAMANAGER.RequestTranData( "obwat_mgmt_271r" )	'계약평가현황 조회
	End If
End Function

'============================================================================
'코드 치환
Sub SetGridData(szTranID)
	Dim i, sCode, sText
	
	For i = 0 to grd0.rowcount-1
		sCode = grd0.GetCellData( "bd_cell0" , i ) 
		Select Case sCode
			Case "01"
				sText = "주식"
			Case "02"
				sText = "채권"
			Case "03"
				sText = "집합투자증권"
			Case "04"
				sText = "RP"
			Case "05"
				sText = "선물옵션"
			Case "06"
				sText = "발행어음"
			Case "07"
				sText = "예금"
			Case "08"
				sText = "장외파생"
			Case "00"
				sText = "예수금"
		End Select
		
		grd0.SetCellData( "bd_cell0", i, sText)		'구분
	Next
End Sub

'============================================================================
'합계 계산(FootHeader에서 합계 기능 지원하지 않아 스크립트로 계산)
Sub CalSum()
	Dim i, nAmt, nTotalAmt
	
	grd0.AddRow( )
	grd0.SetCellData( "bd_cell0", grd0.rowcount-1, "합계" )
'	For i = 0 to 4 
'		grd0.SetCellBgColor( "bd_cell" & i, grd0.rowcount-1, "100" )
'	Next
	
	'평가금액
	nTotalAmt = 0
	For i = 0 to grd0.rowcount-2
		nAmt = CDbl(grd0.GetCellData( "bd_cell1" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	grd0.SetCellData( "bd_cell1", grd0.rowcount-1, nTotalAmt )
	
	'매입금액
	nTotalAmt = 0
	For i = 0 to grd0.rowcount-2
		nAmt = CDbl(grd0.GetCellData( "bd_cell2" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	grd0.SetCellData( "bd_cell2", grd0.rowcount-1, nTotalAmt )
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" Then
		RequestData()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#cmbSeq", "caption")
	
	If szTranID = "obwat_mgmt_271r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , szASNO )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obwat_mgmt_271r" Then
		Call SetGridData(szTranID)		'코드 치환
		Call CalSum()					'합계
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub
