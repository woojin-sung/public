'============================================================================
' 화 면 명 : 관심종목_스타일2(해외)
' 화면설명 : 관심종목_스타일2에서 해외지수 선택시 조회
' 작    성 : 2016.01.05 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk

Dim g_szGwanData
g_szGwanData = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Init_tblInfo
'============================================================================
Function Init_tblInfo()
	tblInfo.SetCellString(0, 0, "")
	tblInfo.SetCellString(1, 0, "")
	tblInfo.SetCellString(3, 1, "")
	
	ChartEx0.SetDataClear()
End Function

'============================================================================
' Set_ChartType
'============================================================================
Function Set_ChartType()
	ChartEx0.setMarketCategory(1)	
		
	if g_szMk == "EN" then
		ChartEx0.setDecimal("4")	' 소수점 4자리
	else
		ChartEx0.setDecimal("2")	' 소수점 2자리
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")
End Sub


'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 스타일2화면에서 트리거 받음
	if sEventName == "JMCODE" then
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg")			' 해외선물 체결 자동갱신
		DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")			' 해외지수/종목 체결 자동갱신
		DATAMANAGER.CancelRealData("ohhts_exrt_cntg")			' 환율 체결 자동갱신
		
		Init_tblInfo()
	
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")
			tblInfo.SetCellString(0, 0, tData(0))
			tblInfo.SetCellString(1, 0, tData(2))
			
			g_szCd = tData(0)
			g_szMk = tData(1)
			
			' 기본 세팅후 주기 가져오기
			szCycle = gf_GetForeignCycle(tData(0))
			tblInfo.SetCellString(3, 1, szCycle)
			
			Set_ChartType()
			DATAMANAGER.RequestTranData("ohhts_5040_001r")	' 해외조회(차트)
		end if
		
		g_szGwanData = Form.GetSharedData("PRE_GWAN_GRID_POS", true )
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")			' 해외선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")			' 해외지수/종목 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")			' 환율 체결 자동갱신
End Sub
		
'============================================================================
'해외 지수/종목 주기를 리턴해준다 . ( 종가 또는 지연)
'============================================================================
Function gf_GetForeignCycle(szCode)
	Select Case szCode  
		Case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "USI@SOXX" '미국
			return "종가"  
		Case  "CME@ND",  "CME@NQ", "CME@ES"		', "USI@RUT" '미국 PSM3 러셀2000지수 삭제 "CME@SP" '20220126 HSZ S&P500선물 삭제
			return"지연(15분)"
		Case "HSI@HSCE", "SHS@000001", "SHS@000002", "SHS@000003","SZS@399107", "SZS@399108", "HSI@HSI"  '아시아
	    		return "지연(15분)"  
		Case "TWS@TI01","NII@NI225" 	'아시아
			return "지연(20분)"    	    
		Case "ILI@TA100" 				'아시아
			return "종가"  
		Case "NLI@AEX", "PAS@CAC40"   	'유럽(네덜란드 AEX, 프랑스 CAC 40)
			return "종가"
		Case "TRI@ISE100"   			'유럽(터키 ISE100)
			return "지연(15분)"	    
		Case "AUI@AORD" 				'미주/오세아니아주 
			return "지연(20분)"   
		Case "JPYKRWCOMP","CNYKRWCOMP" 	'원화포함 환율   "USDKRWSMBS", 
			return "지연(5분)"   
		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP"  '원화가 없는 이종통화환율 실시간 	
			return "실시간" 	
	End Select
End Function

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 해외조회(차트)
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_5040_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 해외조회(차트)
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_5040_001r" then
		if g_szMk == "N" then				' 대표지수/국가별업종지수(N)
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
		elseif g_szMk == "FN" then			' CME선물/상품선물(FN)
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg")	
		elseif g_szMk == "EN" then			' 세계환율(EN)
			DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 해외지수/종목 체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_ovrs_nmix" then
		DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 해외선물 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_nfut_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 환율 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_exrt_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", 0, g_szCd)		
	end if
End Sub

'============================================================================
' btnChart_OnClick
'============================================================================
Sub btnChart_OnClick()
	Form.OpenScreen("42050" , g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub



