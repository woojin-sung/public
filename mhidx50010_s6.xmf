	<SCRIPT_INFO _len="3772" _ulen="3524" >
'============================================================================
' 01. 화 면 명 : HOME_시장지표
' 02. 화면설명 : 시장지표
' 03. 작    성 : 
'============================================================================
Dim g_szSpData
Dim nRow
Dim g_szOsType
'============================================================================
Sub Form_OnFormInit()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	g_szOsType = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
		
	if g_szOsType = "2" then	'OS별 패딩차이
		InsertTab1()
	else	
		InsertTab2()
	end if
	
	lblTitle.fgcolor = 334 
	
	linkfm.gesture = true
	
	'탭 세팅
	nTab = Form.GetSharedData("mhidx50010_s6", true )
	if Trim(nTab) = "" then
		nTab = 0
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Sub


'============================================================================
Sub InsertTab1()
	FormTab0.insertPage( 0, "page0", "page0", "empty", "0", " 환율 ")
	FormTab0.insertPage( 1, "page1", "page1", "empty", "0", " 귀금속 ")
	FormTab0.insertPage( 2, "page2", "page2", "empty", "0", " 비철금속 ")	'20231214 HSZ: 하락률 추가
	FormTab0.insertPage( 3, "page3", "page3", "empty", "0", " 곡물 ")
	FormTab0.insertPage( 4, "page4", "page4", "empty", "0", "  원유  ")	
End Sub
'============================================================================
Sub InsertTab2()
	FormTab0.insertPage( 0, "page0", "page0", "empty", "0", "환율")
	FormTab0.insertPage( 1, "page1", "page1", "empty", "0", "귀금속")
	FormTab0.insertPage( 2, "page2", "page2", "empty", "0", "비철금속")  '20231214 HSZ: 하락률 추가
	FormTab0.insertPage( 3, "page3", "page3", "empty", "0", "곡물")
	FormTab0.insertPage( 4, "page4", "page4", "empty", "0", "원유")	
End Sub

'============================================================================
Sub lblMore0_OnClick()
	nTab = CInt(FormTab0.currenttab)
	Form.SetSharedData( "mhidx50010_s6" ,nTab)
	
	Select Case nTab
	Case 0
		Form.OpenScreen("42040" , "환율")
	Case 1
		Form.OpenScreen("42040" , "해외상품선물★0")
	Case 2
		Form.OpenScreen("42040" , "해외상품선물★1")
	Case 3
		Form.OpenScreen("42040" , "해외상품선물★2")
	Case 4
		Form.OpenScreen("42040" , "해외상품선물★3")
	End Select
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.triggerEvent("linkfm", "TAB_CHANGE", nCurrentTab)
	    
End Sub

'스와이프 기능 추가
'============================================================================
Sub linkfm_OnGestureEvent(sEvent)
	if sEvent == "RtoL" then
		btnNext()
		
	elseif sEvent == "LtoR" then
		btnPrev()
	end if
	
End Sub

'============================================================================
Function btnPrev()
	Dim nTab
	
	nCurTab = CInt(FormTab0.currenttab)
	if nCurTab == 0 then
		nTab = 0		
	else
		nTab = nCurTab - 1		
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Function

'============================================================================
Function btnNext()
	Dim nTab
	
	nCurTab = CInt(FormTab0.currenttab)
	nTabCnt = CInt(FormTab0.tabcount)
	
	if nCurTab == nTabCnt then
		nTab = nTabCnt		
	else
		nTab = nCurTab + 1		
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Function

'============================================================================
Sub Form_OnRefresh()
	nTab = FormTab0.currenttab
	call FormTab0_OnTabChanged(nTab)
End Sub

