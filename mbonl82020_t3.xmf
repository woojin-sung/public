'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_예탁담보대출신청
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sAcc '계좌번호
Dim g_nNextFlag
Dim G_QTYPRC_FILE '대출신청금액설정풀팝업
Dim G_PW_CERT_FILE '공인인증서비밀번호입력풀팝업
Dim g_OpenType	'화면 처음 오픈시 팝업 제거 위한변수
Dim G_CALCU_FILE '대출이자가계산풀팝업
Dim G_NOTI_FILE  '대출유의사항안내풀팝업
Dim G_NNPR_CORP_YN '비영리법인여부

Dim g_NICE_TR_CODE
Dim g_NICE_TR_SRNO
Dim g_Timer_TRY_CNT 
Dim g_PROS_CLS'1.조회 2.처리

'===========================================================================
' 16-03-24 YCJ 추가
'===========================================================================


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 속성 초기화함수
'===========================================================================
Function SetControlViewClear()
	g_nNextFlag = false
	
	Table0.SetCellString( 0, 1, "" )
	Table0.SetCellString( 1, 1, "" )
	Table0.SetCellString( 2, 1, "" )
	Table0.SetCellString( 3, 1, "" )
	
	for i = 0 to Grid0.rowcount-1
		Grid0.SetCellData( "bd_check", i, "0" )
	next
	Grid0.rowcount = "0"
End Function	

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'===========================================================================
' 대출신청금액합계 함수
'===========================================================================
Function SetPrcSum()
	Dim nNum
	nNum = 0
	
	for i = 0 to Grid0.rowcount-1
		if Grid0.GetCellData( "bd_check", i ) == "1" then
			nNum = nNum+GetTonumber(Grid0.GetCellData( "bd_inputprc", i ))
		end if
	next
	
	Table0.SetCellString( 3, 1, nNum )
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sAcc = ""
	g_nNextFlag = false
	G_PW_CERT_FILE = "mhetc90060_p5"
	G_QTYPRC_FILE = "mbonl82020_p3"
	G_CALCU_FILE = "mbonl82020_p4"	
	G_NOTI_FILE = "mbonl82020_p7"	'20160725 팝업추가
	
	G_NNPR_CORP_YN = "N"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		'비밀번호없이 조회되도록 요청하여 주석처리 -> 16-03-22 전요셉과장님이 비밀번호 없으면 조회 하지 않게 요청
		
'		if GetPWCkeck() then
'			Exit Sub
'		end if

'		if Form.GetCtlProp( "#EditPW1", "caption" ) == "" then
'			Exit Sub
'		end if

		g_sAcc = sParam
		
		'SetControlViewClear()	
		'DATAMANAGER.RequestTranData( "oblon_pros_810r" ) '대출가능금액조회
		g_PROS_CLS = "1"
		NICE_LN01_CALL()
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhetc90060_p8"then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == G_PW_CERT_FILE then
		if sRet ~= "cancel" then				
			g_PROS_CLS = "2"
			NICE_LN01_CALL()
			'DATAMANAGER.RequestTranData( "oblon_pros_910a" ) '대출신청
		end if 
	elseif sKeyName == G_QTYPRC_FILE then	
		if sRet == "ok" then
			Dim row, inputqty, inputprc
			row = Form.GetSharedData("mbonl82020_p3_row" , false)
			row = GetTonumber(row)
			inputqty = Form.GetSharedData("mbonl82020_p2_inputqty" , false)
			inputprc = Form.GetSharedData("mbonl82020_p2_inputprc" , false)
			
			Grid0.SetCellData( "bd_inputqty", row, inputqty )
			Grid0.SetCellData( "bd_inputprc", row, inputprc )
		else
			Dim row
			row = Form.GetSharedData("mbonl82020_p3_row" , false)
			row = GetTonumber(row)
			
			Grid0.SetCellData( "bd_check", row, "0" )
			Grid0.SetCellData( "bd_inputqty", row, "" )
			Grid0.SetCellData( "bd_inputprc", row, "" )
		end if
		
		SetPrcSum()
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	'sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
	'MTS메모리보안
	'sACNT_PWD = Form.GetEncData(sACNT_PWD)
	Dim plain_rm
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	if plain_rm == "1" then
		sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
	else
		sACNT_PWD = Form.GetCtlProp( "#EditPW1", "encdata" )
	end if
	
	if szTranID == "oblon_pros_810r" then
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_810r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "oblon_pros_910a" then
		Dim nIndex
		nIndex = 0
		DATAMANAGER.ClearInputData( 0, szTranID )
		
		DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		
		for i = 0 to Grid0.rowcount-1
			if Grid0.GetCellData( "bd_check", i ) == "1" then
				Dim typecode, code, intrt, inputqty, inputprc, mtrtdate, byovdate, txtncode, srno, acno, asno
				typecode = Grid0.GetCellData( "bd_typecode", i )
				code = Grid0.GetCellData( "bd_code", i )
				intrt = Grid0.GetCellData( "bd_intrt", i )
				inputqty = Grid0.GetCellData( "bd_inputqty", i )
				inputprc = Grid0.GetCellData( "bd_inputprc", i )
				mtrtdate = Grid0.GetCellData( "bd_mtrtdate", i )
				byovdate = Grid0.GetCellData( "bd_byovdate", i )
				txtncode = Grid0.GetCellData( "bd_txtncode", i )
				srno = Grid0.GetCellData( "bd_srno", i )
				acno = Grid0.GetCellData( "bd_acno", i )
				asno = Grid0.GetCellData( "bd_asno", i )
				
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "ASNO" , nIndex , Right(g_sAcc, 2) )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "LOAN_DTL_TYPE_CODE" , nIndex , typecode )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "ISCD" , nIndex , code )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "PROS_CLS_CODE" , nIndex , "1" )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "LOAN_INTRT" , nIndex , intrt )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "LOAN_QTY" , nIndex , inputqty )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "LOAN_AMT" , nIndex , inputprc )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "MTRT_DATE" , nIndex , mtrtdate )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "BYOV_DATE" , nIndex , byovdate )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "OVRL_TXTN_TYPE_CODE" , nIndex , txtncode )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "RMND_SRNO" , nIndex , srno )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "IISC_ACNO" , nIndex , acno )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_910a", "InBlock2", "IISC_ASNO" , nIndex , asno )
				
				nIndex = nIndex+1
			end if
		next
	elseif szTranID == "oblon_nice_001r" then
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "NICE_TR_CLCD" , 0 , "2P001")
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "ACNO" 		 , 0 , Left(g_sAcc, 8))
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "oblon_pros_810r" then
		g_nNextFlag = DATAMANAGER.IsMoreNextData( szTranID )
		G_NNPR_CORP_YN = DATAMANAGER.GetDataValue(0, "oblon_pros_810r", "OutBlock2", "UI_NNPR_CORP_YN" , 0)
		
		if (g_nNextFlag == "0" or g_nNextFlag == false) and  G_NNPR_CORP_YN == "Y" then
			Form.MsgBox( "알림","비영리법인의 경우 해당 영업점으로 신청 바랍니다.", 6 )
		end if
		
		Table0.SetCellString( 3, 1, "0" )
		
		for i = 0 to Grid0.rowcount - 1
			if Grid0.GetCellData("bd_typecode", i) = "0251" then
				tmpstr = CDBL(Grid0.GetCellData("bd_clpr", i))
				tmpstr = tmpstr * 100
				if tmpstr < 100 then
					tmpstr = "0"&CStr(CLng(tmpstr))
				else
					tmpstr = CStr(CLng(tmpstr))
				end if
				tmpstr = Left(tmpstr,LEN(tmpstr)-2) & "." & Right(tmpstr, 2)
				Grid0.SetCellData("bd_clpr", i, tmpstr)
			else
				tmpstr = FormatNumber(Grid0.GetCellData("bd_clpr", i), 0)
				'tmpstr = Cint(Grid0.GetCellData("bd_clpr", i))
				Grid0.SetCellData("bd_clpr", i, tmpstr)
			end if
		next
	elseif szTranID == "oblon_nice_001r" then
		tmpRSLT_CLS = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock1", "RSLT_CLS", 0)
		if tmpRSLT_CLS == "1" then
			g_NICE_TR_SRNO = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock2", "SDRC_SRNO", 0)
			g_Timer_TRY_CNT = 0
			
			Form.SetTimerEvent(1, 1, 1)
		elseif tmpRSLT_CLS == "0" or tmpRSLT_CLS == "3" then
			Form.SetTimerEvent(1, 0, 1)
			
			if DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock3", "PROS_ABLE_YN", 0) == "Y" then
				if g_PROS_CLS = "1" then
					SetControlViewClear()	
					DATAMANAGER.RequestTranData( "oblon_pros_810r" ) '대출가능금액조회
				else
					DATAMANAGER.RequestTranData( "oblon_pros_910a" ) '대출신청
				end if
				
				ButtonOK.enable = true
			else
				ButtonOK.enable = false
				Dim szErrMsg
				Dim szSub
				szErrMsg = chr(34)&"여신거래 안심차단"&chr(34)&" 서비스 이용 중이므로,"&chr(10)&"대출거래가 제한됩니다."
				szSub = DATAMANAGER.GetDataMsgSubText( szTranID)

				Form.ShowAlert("알림", szErrMsg)
			end if
		end if
	elseif szTranID == "oblon_pros_910a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		SetControlViewClear()	
		DATAMANAGER.RequestTranData( "oblon_pros_810r" ) '대출가능금액조회
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "oblon_pros_910a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "oblon_nice_001r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
		ButtonOK.enable = false
	end if
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim nCheckCnt
	
	if szCellID == "bd_check" then
		
		if Grid0.GetCellData( "bd_check", lRow ) == "1" then			
			sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
			if Len(sACNT_PWD) == 0 then
				Form.MsgBox( "알림", "비밀번호를 입력하세요", "", 6 )
				Grid0.SetCellData( "bd_check", lRow,"0" )
				Exit Sub
			end if
			
			nCheckCnt = 0

			for i = 0 to Grid0.rowcount - 1
				if Grid0.GetCellData( "bd_check", i ) == "1" then
					nCheckCnt = nCheckCnt + 1
				end if
			next
			
			if nCheckCnt > 30 then
				Form.MsgBox( "알림", "최대 30건까지 처리가능합니다", "", 6 )
				Grid0.SetCellData("bd_check", lRow, "0")
				exit sub
			end if
			
			Form.SetSharedData("mbonl82020_p3_row" , lRow)
			Form.SetSharedData("mbonl82020_p3_name" , Grid0.GetCellData( "bd_name", lRow ))
			Form.SetSharedData("mbonl82020_p3_clpr" , Grid0.GetCellData( "bd_clpr", lRow ))
			Form.SetSharedData("mbonl82020_p3_ableqty" , Grid0.GetCellData( "bd_ableqty", lRow ))
			Form.SetSharedData("mbonl82020_p3_ableprc" , Grid0.GetCellData( "bd_ableprc", lRow ))
			Form.SetSharedData("mbonl82020_p3_code" , Grid0.GetCellData( "bd_code", lRow ))
			Form.SetSharedData("mbonl82020_p3_unit" , Grid0.GetCellData( "bd_unit", lRow ))
			Form.SetSharedData("mbonl82020_p3_typecode" , Grid0.GetCellData( "bd_typecode", lRow ))
			
			Form.OpenFramePopup(G_QTYPRC_FILE , g_sAcc , "") '대출신청금액설정	
		else
			Grid0.SetCellData( "bd_inputqty", lRow, "" )
			Grid0.SetCellData( "bd_inputprc", lRow, "" )
			
			SetPrcSum()
		end if
	end if
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if g_nNextFlag == "1" or g_nNextFlag == true then
		DATAMANAGER.RequestNextData( "oblon_pros_810r" ) '대출가능금액조회
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	if GetTonumber(Table0.GetCellString( 3, 1 )) == 0 then
		Form.MsgBox( "알림", "대출신청금액을 확인해주세요.", "", 6 )	
		Exit Sub
	end if
	
	if GetTonumber(Table0.GetCellString( 3, 1 )) > GetTonumber(Table0.GetCellString( 2, 1 )) then
		Form.MsgBox( "알림", "대출가능금액을 확인해주세요.", "", 6 )	
		Exit Sub
	end if
	
	if G_NNPR_CORP_YN == "Y" then
		Form.MsgBox( "알림","비영리법인의 경우 해당 영업점으로 신청 바랍니다.", 6 )
		Exit Sub
	end if
	
	Dim nCnt, nCheckCnt
	nCnt = GetTonumber(Grid0.rowcount)
	nCheckCnt = 0
	
	if nCnt > 0 then
		for i = 0 to nCnt-1
			if Grid0.GetCellData( "bd_check", i ) == "1" then
				nCheckCnt = nCheckCnt+1
			end if
		next
	end if
	
	if nCheckCnt == 0 then
		Form.MsgBox( "알림", "대출신청 종목을 선택해주세요.", "", 6 )
		Exit Sub
    elseif nCheckCnt > 30 then
	     Form.MsgBox( "알림", "최대 30건까지 처리가능합니다. 입력 : " & nCheckCnt & "건", "", 6 )
		Exit Sub
	end if
	
	'16-03-24 YCJ 추가인증 과정 추가 부분
	Form.SetSharedData( "CERT_ACNO" , Left(g_sAcc , 8) )
	
	Dim szTemp, InputCount, szTemp1, szDAccName
	InputCount = 0
	szTemp = ""
	szTemp1 = ""
	szDAccName = Form.GetCtlProp( "#Account1", "accountname")

	for i = 0 to Grid0.rowcount - 1
		if Grid0.GetCellData( "bd_check" , i) == "1" then
			InputCount = InputCount + 1
			szTemp1 = szTemp1 & "★" & Grid0.GetCellData( "bd_name", i) & "★" & szDAccName & "★" & Grid0.GetCellData( "bd_inputprc", i)
		end if
	next
	szTemp = szTemp & InputCount & szTemp1
	
	Dim szData
	szData = "deposit_loan" & "★" & szTemp
	Form.OpenFramePopup( "mhetc90060_p8" , szData , sPosInfo)		'16-03-24 YCJ 전요셉과장님이 추가인증 요청
	
'	Form.OpenFramePopup(G_PW_CERT_FILE , "" , "") '공인인증비밀번호검증
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("mbonl82020_p3_row" , "")
	Form.SetSharedData("mbonl82020_p3_name" , "")
	Form.SetSharedData("mbonl82020_p3_clpr" , "")
	Form.SetSharedData("mbonl82020_p3_ableqty" , "")
	Form.SetSharedData("mbonl82020_p3_ableprc" , "")
	Form.SetSharedData("mbonl82020_p3_code" , "")
	Form.SetSharedData("mbonl82020_p3_unit" , "")
	Form.SetSharedData("mbonl82020_p3_typecode" , "")
	Form.SetSharedData("mbonl82020_p2_inputqty" , "")
	Form.SetSharedData("mbonl82020_p2_inputprc" , "")
End Sub

'============================================================================
Sub ButtonInfo_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	Dim sSendData
	sSendData = g_sAcc..";"..Form.GetCtlProp( "#EditPW1", "caption" )..";"..Form.GetCtlProp( "#EditPW1", "pwdlen" )
	Form.OpenFramePopup(G_CALCU_FILE , sSendData , "")
End Sub

'20160725 유의사항 버튼 추가
'============================================================================
Sub ButtonNoti_OnClick()
	Form.OpenFramePopup(G_NOTI_FILE , "" , "")
End Sub

