'============================================================================
Sub NICE_LN01_CALL()
	g_NICE_TR_CODE = "LN01"
	g_NICE_TR_SRNO = 0
	g_Timer_TRY_CNT = 0
	'Form.SetTimerEvent( 1, 1, 1 )
	DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "SDRC_CLS_CODE", 0 , "1")
	DATAMANAGER.RequestTranData("oblon_nice_001r")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'Form.ShowAlert("Form_OnTimerEvent" , sTimerID)
	if Cint(sTimerID) = 1 then
		g_Timer_TRY_CNT = g_Timer_TRY_CNT + 1
		
		if g_Timer_TRY_CNT > 6 then
			'Form.clearWaitCursor()
			Form.SetTimerEvent(1, 0, 1)
			
			Form.MsgBox("알림", "여신거래 안심차단 정보 조회 지연중입니다.\n 다시 조회하시겠습니까?", "LN01", 1)
		else
			DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "SDRC_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock2", "SDRC_SRNO"	 , 0 , g_NICE_TR_SRNO)
			DATAMANAGER.RequestTranData("oblon_nice_001r")
		end if
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LN01" then
		if sRet == "ok" then
			NICE_LN01_CALL()
		end if
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="oblon_pros_810r" trcode="oblon_pros_810r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="oblon_pros_910a" trcode="oblon_pros_910a" compress="1" encryption="1" timeout="120" inputcheck="1" digitalsign="1" useattr="0" />
			<TRAN tranid="oblon_nice_001r" trcode="oblon_nice_001r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="oblon_pros_810r" title="oblon_pros_810r" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="216" _ulen="160" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌 비밀번호^68^0^0^0^0^0^0
LOAN_DTL_TYPE_CODE^대출상세유형코드^4^0^0^0^0^0^0
ISCD^종목코드^12^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="30" inout="out" _len="1022" _ulen="784" >

