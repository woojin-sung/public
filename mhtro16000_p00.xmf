<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="16000" scrname="현재가메인팝업" version="2" writer="이호철" />
	<FORM_INFO name="Form" ly_vert="0,0,540,922,1" />
	<CONTROL_INFO>
		<LINKFORM name="LinkForm0" ly_vert="1,85,540,837,1" />
		<LABEL name="LblBackground" bgcolor="089:106132185" ly_vert="0,0,540,85,1" />
		<LABEL name="Label0" fgcolor="116:000119067" fontsize="2" caption="해외주식" ly_vert="82,5,136,38,1" />
		<LABEL name="Label1" fgcolor="116:000119067" caption="종목선택" ly_vert="82,45,180,38,1" />
		<IMAGE name="Image0" imgpath="icon_chart_setting_refresh" ly_vert="480,22,40,40,1" />
		<IMAGE name="ImgBefore" imgpath="icon_pagerslidingtap_prev" ly_vert="13,27,20,30,1" />
		<BUTTON name="BtnBefore" btnimage="alpha" ly_vert="0,5,78,78,1" />
		<BUTTON name="BtnRefresh" btnimage="alpha.9" ly_vert="455,5,78,78,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="970" _ulen="904" >
'===========================================================================
' 화  면  명 : 종목검색창_메인
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2015.04.22 이호철
' 수      정 : 2017.10.12 이재원
'===========================================================================
Sub BtnBefore_OnClick()
	Form.CloseForm( )
end Sub

'============================================================================
Sub BtnRefresh_OnClick()
	Form.TriggerEvent( "LinkForm0", "SCREEN_REFRESH", "OK" )
end Sub

'============================================================================
Sub Form_OnFormInit()
	Dim sTemp
	sTemp = Form.GetOpenLinkData( )
	Label0.caption = "해외주식"
	
	if sTemp == "GMP_CURRENT" then
		Label1.caption = "현재가"
		LinkForm0.linkfile = "mhtro_1200000"
	elseif sTemp == "GMP_CURRENT_CHART" then
		Label1.caption = "차트"
		LinkForm0.linkfile = "mhtro_1220000"
	end if
end Sub










	</SCRIPT_INFO>
</ROOT>