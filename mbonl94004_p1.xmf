	<SCRIPT_INFO _len="3386" _ulen="3272" >
'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 
' 04. 수    정 : 
'
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.imgCheck.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_OSType	= Form.GetSharedData("&OS_TYPE", false)

	if g_OSType = "1" then	'AND
		Container0.Label0.changeTextAttr(50, 5, 6, -2, false)
		
		
		Container0.top = 234
		
	else	'IOS
		Container0.Label0.changeTextAttr(50, 7, 6, -2, false)
		
		'IOS 에서 하단에 여백이 생겨서 컨테이너 내려줌.
		Container0.top = 252
		
	end if
	
	Container0.ChkButton0.chksilence = "0"
	Container0.imgCheck.imgpath = "checkmenu_n.png"
End Sub

'============================================================================
' Container0_btnOK_OnClick() : 팝업 닫기
'============================================================================
Sub Container0_btnOK_OnClick()
	if tonumber(Container0.ChkButton0.checkstate) == 0 then
		Form.ShowAlert("알림", "안내 확인 체크가 되지 않았습니다.")
	else
		Form.SendReturnToParent("close_mbonl94004_p1" , "")
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
' Container0_btnCancel_OnClick() : 팝업닫기
'============================================================================
Sub Container0_btnCancel_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' imgBg_OnClick() : 팝업닫기
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub Container0_imgCheck_OnClick()
	if CInt(Container0.ChkButton0.checkstate) == 1 then
		f_SetCheckState(false)
	else
		f_SetCheckState(true)
	end if
End Sub

'============================================================================
Function f_SetCheckState(bValue)
	if bValue == true then
		Container0.ChkButton0.chksilence = "1"
		Container0.imgCheck.imgpath = "checkmenu_o.png"
	else
		Container0.ChkButton0.chksilence = "0"
		Container0.imgCheck.imgpath = "checkmenu_n.png"
	end if
End Function


'============================================================================
Sub Container0_lblCheckMsg_OnClick()
	Container0_imgCheck_OnClick()
End Sub

	</SCRIPT_INFO>
