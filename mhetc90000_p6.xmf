'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_개인_메모추가
' 03. 작    성 : 2016.02.16 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sType '처리구분값
Dim g_sGubun '종목/일반메모구분값

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData 
	sRevData = Form.GetOpenLinkData( )
	
	if sRevData == null or Trim(sRevData) == "" then
		Exit Sub
	end if
	
	g_sGubun = sRevData
	g_sType = ""
	
	if g_sGubun == "1" then
		lblTitle.caption = "일반메모 추가"
		'Form.SetScreenName("일반메모 추가")
		
		EditTitle.visible = true
		Table0.SetCellString( 0, 0, "제목" )
	elseif g_sGubun == "2" then
		lblTitle.caption = "종목메모 추가"
		'Form.SetScreenName("종목메모 추가")
		
		ItemCode0.visible = true
		Table0.SetCellString( 0, 0, "종목명" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	if szTranID == "ohhts_memo_013r" then
		DATAMANAGER.ClearInputData( 0, szTranID )
		
		Dim sUserID 
		sUserID = Form.GetSharedData("&USER_ID", false )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" , 0 , sUserID )
		'일반1,종목2
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" , 0 , g_sGubun ) 
		'입력검색1,전체검색2,추가3,수정4,선택삭제5,전체삭제9
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" , 0 , g_sType )
		'종목코드1,내용2/제목1,내용2,내용+제목3
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" , 0 , "1" )
		
		if g_sGubun == "1" then
			Dim sDate, sTime, title, clscode
			sDate = Form.GetSharedData("&HOST_DATE", false )
			sTime = Form.GetSharedData("&HOST_TIME", false )
				
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MOD_YMDH" , 0 , sDate..sTime )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_TITL" , 0 , EditTitle.caption )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_GNRL_CNTT" , 0 , EditText.caption )	
		elseif g_sGubun == "2" then
			Dim sCode, sMarket, sName
			sCode = ItemCode0.code
			sName = Form.GetItemCodeInfo(sCode, "name")
			sMarket = Form.GetItemCodeInfo(sCode, "market")
	
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" , 0 , sCode )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" , 0 , sName )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_ISSU_MEMO_CNTT" , 0 , EditText.caption )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , sMarket )
		end if
	end if
	' 20210622 HWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Form.SendReturnToParent( "mhetc90000_p6" , "" )
	Form.CloseForm()
End Sub

'============================================================================
' 추가
'============================================================================
Sub ButtonAdd_OnClick()
	if g_sGubun == "1" then
		if EditTitle.caption == "" then
			Form.MsgBox( "알림", "제목을 입력해주세요.", "", 6 )
			Exit Sub
		end if
	end if
	
	if EditText.caption = "" then
		Form.MsgBox( "알림", "내용을 입력해주세요.", "", 6 )
		Exit Sub
	end if
	
	g_sType = "3"
	
	DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '추가	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
End Sub

'============================================================================
' 취소
'============================================================================
Sub ButtonDel_OnClick()
	Form.CloseForm()
End Sub

