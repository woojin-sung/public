	<SCRIPT_INFO _len="2309" _ulen="2041" >
dim	g_szRet	'리턴값

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	'0 계좌번호
	'1 주문접수번호
	'2 종목코드
	'3 종목명
	'4 상품코드		
	'5 계좌번호
	'6 계좌일련번호
	'7 계좌명
	'8 채권분류명
	'9 매수금액
	'10 매수수익률
	'11 매수일자
	'12 만기일자
	'13 거래일자
	'14 거래일련번호
	'15 정산금액
	
	if szOpenData <> "" and szOpenData <> null then
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		'계좌번호
		lblTableData1.caption 		= "[" & szProdText & "] " & 
									Left(tData(0),4) & "-" & 
									Mid(tData(0),5,4) & "-" & 
									Right(tData(0),2)
		
		'상품명
		lblTableData2.caption 		= tData(3)
			
		'종목명 긴 경우, 멀티라인 2줄까지만 출력되도록..
		if Len(tData(1)) > 40 then
			lblTableData2.fontsize = -2
		else
			lblTableData2.fontsize = 0
		end if
		
		'상품분류
		lblTableData3.caption 		= tData(8)
		'매수금액
		lblTableData4.caption 		= tData(9)
		'매수수익률
		lblTableData5.caption 		= tData(10)
		'매수일
		lblTableData6.caption 		= tData(11)
		'만기일
		lblTableData7.caption 		= tData(12)
		
	end if
	
End Sub

'============================================================================
Sub btnList_OnClick()
	g_szRet = "ALL_CLOSE"
	
	'채권 주문내역 탭으로 이동
'	Form.OpenNextPopup("mbonl90301", "1", "")
	Form.OpenScreen(54140, "1")	
End Sub

'============================================================================
Sub btnOk_OnClick()
	g_szRet = "ALL_CLOSE"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl90201_p5" ,  g_szRet)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	g_szRet = "ALL_CLOSE"
	Form.CloseForm()
End Sub


	</SCRIPT_INFO>
