'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 
' 04. 수    정 : 
' 2021.11.04 	: 김수진	: v0001	: 동일인 계좌간 대체출금 개선건 적용  : 외화당사대체 출금은 동인인 계좌에 한해서만 출금 가능
'							: 상대 계좌 당사 동일명의 계좌일 경우 : 금융사기문진, 보안매체, 전자서명 생략 및 간편이체한도 미적용 
' 2022.08.23 : 장원혁 : v0002 : 다드림계좌 수정
'--===========================================================================
Dim g_nNextIdx
Dim g_ACNM

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function Clear_Data() ' Clear_Data() : 초기화
    GrdRmnd.rowcount = 0
    EdtPswd.caption = ""
    EdtCrcd.caption = ""
    EdtCrcdName.caption = ""
    EdtAllMoney.caption = ""
    EdtTrAmt.caption = ""
    EdtCnftAcnt.caption = ""
    EdtCnftCustName.caption = ""
    EdtMnrcAcntPrnm.caption = ""
    g_nNextIdx = 0
    g_ACNM = ""
End Function

'============================================================================
Function CheckInputData() ' CheckInputData() : 입력 데이터 유효성 확인
	Dim szPrcdType
	szPrcdType = CmbAcnt.itemcodetype	

	if Len(Trim(CmbAcnt.caption)) <> 10 then
		Form.ShowAlert("알림", " 계좌번호를 확인해주세요.")
		return false
	
	elseif (EdtPswd.caption == NULL or EdtPswd.caption == "") then
		Form.ShowAlert("알림", "비밀번호가 입력되지 않았습니다.")
		return false
	
	elseif (EdtCrcd.caption == NULL or EdtCrcd.caption == "") or (EdtCrcdName.caption == NULL or EdtCrcdName.caption == "") then
		Form.ShowAlert("알림", "대체할 통화가 선택되지 않았습니다.")
		return false
		
	elseif CDbl(EdtTrAmt.caption) == 0 then
		Form.ShowAlert("알림", "대체금액을 확인해주세요")
		return false
		
	elseif CDbl(EdtTrAmt.caption) > CDbl(EdtAllMoney.caption) then
		Form.ShowAlert("알림", "대체금액이 출금가능금액보다 클 수 없습니다. 대체금액을 확인해주세요")
		return false
		
	elseif EdtCnftAcnt.caption == NULL or EdtCnftAcnt.caption == "" then
		Form.ShowAlert("알림", "입금계좌를 확인해주세요")
		return false
		
	elseif EdtMnrcAcntPrnm.caption == NULL or EdtMnrcAcntPrnm.caption == "" Then
		Form.ShowAlert("알림", "수취인 정보가 확인되지 않았습니다. 계좌를 확인해주세요")
		return false
		
	elseif Trim(CmbAcnt.caption) == Trim(EdtCnftAcnt.caption) then
		Form.ShowAlert("알림", "동일 계좌간의 이체는 불가합니다. 계좌를 확인해주세요")
		return false	
	end if
	
	return True
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()     

    Clear_Data()

    if CmbAcnt.caption <> NULL and CmbAcnt.caption <> "" then

	    szPrcdType = CmbAcnt.itemcodetype
	    
	    If szPrcdType == "119" Then
		    DATAMANAGER.RequestTranData("obwat_ctcs_055r")
	    Else
		    DATAMANAGER.RequestTranData("obrtd_fcur_001r")
	    End If
	    
    End If
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
    If sKeyName == "MNRC_ACNT" Then
        EdtCnftAcnt.caption = sRet
        DATAMANAGER.RequestTranData("obpds_srvc_182r")
    End If
	
	If sKeyName == "Clear" Then '처리완료 후 팝업종료
	
		Clear_Data()

	    If CmbAcnt.caption <> NULL and CmbAcnt.caption <> "" then
	    
		    szPrcdType = CmbAcnt.itemcodetype
		    
		    If szPrcdType == "119" Then
			    DATAMANAGER.RequestTranData("obwat_ctcs_055r")
		    Else
			    DATAMANAGER.RequestTranData("obrtd_fcur_001r")
		    End If
	    End If
	    
	End If

End Sub

'============================================================================
Sub GrdRmnd_OnClickUp(lRow, szCellID) '  GrdRmnd_OnClickUp(lRow, szCellID) : 선택 잔고 클릭시, 해당 정보 세팅
    CRCD      = GrdRmnd.GetCellData("bd_cell1", lRow)
    FRCR_NAME = Form.GetMetaData("통화코드", CRCD)
    FRCR_RMND = GrdRmnd.GetCellData("bd_cell2", lRow)
    
    EdtCrcd.caption     = CRCD
    EdtCrcdName.caption = FRCR_NAME
    EdtAllMoney.caption = FRCR_RMND
End Sub

'============================================================================
Sub BtnWhole_OnClick() 'BtnWhole_OnClick() : 출금가능금액 대체금액 에디트 입력
	EdtTrAmt.caption = EdtAllMoney.caption
End Sub

'============================================================================
Sub BtnMod_OnClick() ' BtnMod_OnClick() : 대체금액 에디트 초기화
    EdtTrAmt.caption = 0
End Sub

'============================================================================
Sub BtnMyAcntList_OnClick()
    Form.OpenPopup("mbbnk61090_p6" , CmbAcnt.caption , "")
End Sub

'============================================================================
Sub EdtCnftAcnt_OnEditChar(CharCode)
	EdtMnrcAcntPrnm.caption = ""
End Sub

'============================================================================
Sub EdtCnftAcnt_OnEditComplete() ' EdtCnftAcnt_OnEditComplete() : 수취인 조회
    DATAMANAGER.RequestTranData("obpds_srvc_182r")
End Sub

'============================================================================
Sub BtnWithDraw_OnClick() ' BtnWithDraw_OnClick() : 출금 버튼 클릭시, 확인 팝업 오픈

	If CheckInputData() == False Then
		Exit Sub
	End If
	
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	'MTS메모리평문 적용상태일때
	If plain_rm == "1" then
		sAccountPassword = EdtPswd.caption
	Else
		sAccountPassword = Form.GetEncData(EdtPswd.caption)	
	End If
	
    szSendData = CmbAcnt.caption & "★" & g_ACNM & "★" & EdtCnftAcnt.caption & "★" & EdtMnrcAcntPrnm.caption & "★" & EdtCrcd.caption & "★" & EdtCrcdName.caption & "★" & EdtTrAmt.caption & "★" & sAccountPassword

     Form.OpenFramePopup("mbbnk61090_p2" , szSendData , sPosInfo)
     'v0001 fin
End Sub

'============================================================================
Sub btnInfo_OnClick()
	Form.OpenPopup("mbbnk61090_p5" , "" , "") ' btnInfo_OnClick() : 안내사항 팝업 오픈
End Sub

'============================================================================
Sub CmbAcnt_ChangeAccount() 

	Clear_Data()
	
    szPrcdType = CmbAcnt.itemcodetype
    
    if szPrcdType == "119" or szPrcdType == "133" then
	    DATAMANAGER.RequestTranData("obwat_ctcs_055r")
    else
	    DATAMANAGER.RequestTranData("obrtd_fcur_001r")
    end if

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	szACNO  = Left(CmbAcnt.caption,8)
	szASNO  = Right(CmbAcnt.caption,2)
	szCnftACNO = Left(EdtCnftAcnt.caption,8)
	szCnftASNO = Right(EdtCnftAcnt.caption,2)
	szToday = Calendar0.caption

	If szTranID == "obrtd_fcur_001r" Then
	
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ACNO" , 0 , szACNO)
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ASNO" , 0 , szASNO)
		
	End If

	If szTranID == "obwat_ctcs_055r" Then
		
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ACNO"      , 0 , szACNO)
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ASNO"      , 0 , szASNO)
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "PROS_DATE" , 0 , szToday)
		
	End If
	
    If szTranID == "obpds_srvc_182r" Then
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CSNU"     , 0 , 0)	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"          , 0 , szACNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"          , 0 , szASNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "CNFT_ACNO"     , 0 , szCnftACNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "CNFT_ASNO"     , 0 , szCnftASNO)
    End If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID == "obrtd_fcur_001r" Then
    
	    DATACNT = CDbl(DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock1"))
	    GrdRmnd.rowcount = DATACNT

	    For i = 0 To DATACNT - 1
		    CRCD               = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CRCD"                         , i) ' 통화코드
		    FRCR_WTMN_ABLE_AMT = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ATMT_INVT_VLTN_ADUP_FRCR_AMT" , i) ' 자동투자평가합계외화금액
		    
		    GrdRmnd.SetCellData("bd_cell0", g_nNextIdx , i+1)
		    GrdRmnd.SetCellData("bd_cell1", g_nNextIdx , CRCD              )
		    GrdRmnd.SetCellData("bd_cell2", g_nNextIdx , FRCR_WTMN_ABLE_AMT)
		    
		    g_nNextIdx = g_nNextIdx + 1
	    Next
	    
	    If  DATAMANAGER.IsMoreNextData( szTranID ) == True Then
		    DATAMANAGER.RequestNextData( szTranID )
	    End If
	    
    End If	    

    If szTranID == "obwat_ctcs_055r" Then
    
	    DATACNT = CDbl(DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock1"))
	    GrdRmnd.rowcount = DATACNT
	    
	    For i = 0 To DATACNT - 1
		    CRCD               = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CRCD"               , i) ' 통화코드
		    FRCR_WTMN_ABLE_AMT = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "DRNG_ABLE_FRCR_AMT" , i) ' 출금가능외화금액
		    
		    GrdRmnd.SetCellData("bd_cell0", g_nNextIdx , i+1)
		    GrdRmnd.SetCellData("bd_cell1", g_nNextIdx , CRCD              )
		    GrdRmnd.SetCellData("bd_cell2", g_nNextIdx , FRCR_WTMN_ABLE_AMT)
		    
		    g_nNextIdx = g_nNextIdx + 1
	    Next
	    
	    If  DATAMANAGER.IsMoreNextData( szTranID ) == True Then 
		    DATAMANAGER.RequestNextData( szTranID )
	    End If
	    
    End If
    
    If szTranID == "obpds_srvc_182r" Then
    
        If DATAMANAGER.GetDataMsgCode(szTranID) == "3070" Then '수취계좌 조회 오류입니다
            szMsgCntt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "RSPN_MSG_CNTT" , 0)
            Form.MsgBox("알림" , szMsgCntt , "RSPN_MSG" , 0)
            Exit Sub
        End If
	
        g_ACNM = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "ACNM" , 0)    
        szPrnm = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "PRNM" , 0)	
	
        EdtMnrcAcntPrnm.caption = g_ACNM & "-" & szPrnm	
	
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szSubMsg <> Null And szSubMsg <> "" Then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	Else
		Form.ShowAlert( "알림", szErrMsg )
	End If	

End Sub


	</SCRIPT_INFO>
