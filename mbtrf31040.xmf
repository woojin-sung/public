'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
	if szTranID == "obtrf_cntg_121r" then
		szAcnt = acnt.caption
		if Trim(szAcnt) = "" then
			exit sub
		end if
	end if
	'20231123 HSZ END
	
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
	end if

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
	if sEventName == "SCREEN_MENU" then	
		if sParam == "POPUP1" then			' 예수금
			Form.OpenPopup("mbtrf31030_pc", acnt.total & "★" & acnt.sequence, "")
		elseif sParam == "POPUP2" then		' 주문가능
			Form.OpenPopup("mbtrf31030_pd", acnt.total & "★" & acnt.sequence & "★" & g_szCode & "★" & cont.lblHyun.caption, "")	
		end if		
	
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "4", "")		' 선물옵션
	'20220922 SWJ END
	end if

End Sub

