'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'현재가
	if szTranID == "ohhts_4030_001r" then
	
		DATAMANAGER.CancelRealData("ohhts_futs_aspr")  '선물 호가 자동갱신
		DATAMANAGER.CancelRealData("ohhts_futs_cntg")  '선물 체결 자동갱신 
		DATAMANAGER.CancelRealData("ohhts_optn_aspr")  '옵션 호가 자동갱신
		DATAMANAGER.CancelRealData("ohhts_optn_cntg")  '옵션 체결 자동갱신
	
		DATAMANAGER.SetDataValue( 0, "ohhts_4030_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_4030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_4030_001r", "InBlock2", "FID_INPUT_ISCD"				, 0 , g_szCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_4030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szMarket )

	end if

	'미채결
	if szTranID == "obtrf_cntg_121r" then
		
		InitAccount()
		
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_121r", "InBlock1", "ACNO", 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_121r", "InBlock1", "ASNO", 0 , acnt.sequence )

		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_121r", "InBlock2", "DEAL_CLS_CODE", 	0 , "%" )  	'매매구분코드
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_121r", "InBlock2", "IQRY_CLS_CODE", 	0 , "0" ) 	'조회구분코드
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_121r", "InBlock2", "DATA_CLS",		0 , "0" ) 	'데이터구분
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_121r", "InBlock2", "UNAS_CNFG_CLCD",	0 , "0" ) 	'기초자산구성구분코드

	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	'현재가
	if szTranID == "ohhts_4030_001r" then

		'현재가, 상한가, 하한가, 전일종가
		g_szCurrPrice = DATAMANAGER.GetDataValue(0, "ohhts_4030_001r", "OutBlock2", "FID_PRPR" , 0)
		g_szHighPrice = DATAMANAGER.GetDataValue(0, "ohhts_4030_001r", "OutBlock2", "FID_MXPR2" , 0)
		g_szLowPrice  = DATAMANAGER.GetDataValue(0, "ohhts_4030_001r", "OutBlock2", "FID_LLAM2" , 0)
		g_szJunPrice  = DATAMANAGER.GetDataValue(0, "ohhts_4030_001r", "OutBlock2", "FID_PRDY_CLPR2" , 0)

		g_szCurrPrice	= _tonumber(g_szCurrPrice)
		g_szHighPrice	= _tonumber(g_szHighPrice)
		g_szLowPrice 	= _tonumber(g_szLowPrice)
		g_szJunPrice 	= _tonumber(g_szJunPrice)

	end if

	'미체결
	if szTranID == "obtrf_cntg_121r" then
	
		Dim _rowCnt, _szAcno, _szAsno, _szSvcId, _szStockCode
		_rowCnt = DATAMANAGER.GetDataCount( 0, "obtrf_cntg_121r", "OutBlock1" )
		
		Dim tData()
		For i = 0 to _rowCnt -1
			
			'종목코드 체크
			_szAcno 		= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "ACNO", i) '계좌번호
			_szAsno 		= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "ASNO", i) '계좌일련번호
			_szStockCode 	= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "ISCD", i)	'종목코드

			'계좌, 종목코드 체크
			if (acnt.total == _szAcno) and 
			    (acnt.sequence == _szAsno) and
				(_szStockCode == tostring("K"&g_szCode)) 
			then 
				tData = {}
				tData = InitOrderData(tData)

				tData.Qty 			= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "NCNT_QTY", i)			' 미체결수량
				tData.Price 			= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "FTOP_ODER_UNPR" , i)	' 가격
				tData.OrderNo 		= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "ODER_NO", i)			' 주문번호
				tData.OrgOrderNo 		= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "ORGL_ODER_NO", i)		' 원주문번호
				tData.ucTradingType	= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "DEAL_CLS_CODE", i) 	' 매매구분 코드(1:매도, 2:매수)
				tData.ucOrderType		= DATAMANAGER.GetDataValue(0, "obtrf_cntg_121r", "OutBlock1", "RCTF_CNCL_CLS_CODE", i)	' 정정취소구분코드 (1:신규, 2:정정, 3:취소)
				tData.szStatus 		= G_ORD_RS_STS_JUPSU '정상
				
				tData.Qty = _tonumber(tData.Qty)
				tData.Price = _topricestring(_tonumber(tData.Price))
				tData.OrderNo = _tonumber(tData.OrderNo)
				tData.OrgOrderNo = _tonumber(tData.OrgOrderNo)
				
				if tData.ucOrderType == "1" or 
					tData.ucOrderType == "2" then
					InsertOrderTable(tData)
				end if
				
			end if
		Next
		
		'''''
		'''''imsi_data_insert()
	end if

	'주문
	if szTranID == "obtrf_oder_101c" then
		
		Dim szWarnCode, szWarnMsg
		szWarnCode 	= DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "OutBlock1", "WARN_CLS_CODE", 0)
		szWarnMsg 	= DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "OutBlock1", "WARN_MSG_CNTT", 0)
		
		'''Form.ShowAlert("주문-OnReceiveTranData", szWarnCode.." "..szWarnMsg)
		
		if szWarnCode == "1" or szWarnCode == "2" then
			g_szWarningCode = szWarnCode
			g_szWarningMessg = szWarnMsg
		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'현재가
	if szTranID == "ohhts_4030_001r" then
		
		'20180323 LES START - 코스닥150옵션/KRX300선물 추가
		' 20240412 HSZ 코스닥글로벌지수 추가 
		if g_szMarket == "F" or g_szMarket == "MF" or g_szMarket == "XF" or g_szMarket == "KF" then
			DATAMANAGER.RequestRealData( "ohhts_futs_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			
		elseif g_szMarket == "O" or g_szMarket == "MO" or g_szMarket == "QO" or g_szMarket == "WO" then	' 20190809_01 HWG : 위클리옵션추가
			DATAMANAGER.RequestRealData( "ohhts_optn_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
		
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_cntg_infr" )
		DATAMANAGER.RequestRealData( "ohhts_cntg_rslt" )
		
	end if
	
	' 미채결
	if szTranID == "obtrf_cntg_121r" then
		
		RefreshHogaTable()

	end if
	
	'주문
	if szTranID == "obtrf_oder_101c" then
	
		'-----------------------------
		' 경고 팝업 호출
		'-----------------------------
		if g_szWarningCode == "1" then
			Confirm_Popup( g_szOrderType, g_szModCnlType )
			
		elseif g_szWarningCode == "2" then
			Form.ShowAlert(g_szTitle, g_szWarningMessg)
			
			g_szWarningCode = ""
			g_szWarningMessg = ""
			
		else
			g_szWarningCode = ""
			g_szWarningMessg = ""
	
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
			
			if Trim(szOrdCd) == "0001" then			' 정상주문
				
				'---------------------------------------
				'주문을 넣자마자 배열에 담는다. BEGIN
				'---------------------------------------
				Dim szClsCode, szPrice, szQty, szSrno, szOderNo
				szClsCode = DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "InBlock1", "SVC_CLS_CODE", 0)
				szPrice = DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "InBlock1", "FTOP_ODER_UNPR", 0)
				szQty = DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODQT", 0)
				szSrno = DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "InBlock1", "PROS_SRNO", 0) 
				szOderNo = DATAMANAGER.GetDataValue(0, "obtrf_oder_101c", "OutBlock1", "ODER_NO", 0) 
				
				if szClsCode == "101" then
					szClsCode = "1"
				elseif szClsCode == "102" then
					szClsCode = "2"
				end if
				
				Dim tData()
				
				tData = {}
				tData = InitOrderData(tData)

				tData.ProsOrderNo		= szSrno		' 처리일련번호
				tData.Qty 			= szQty		' 수량
				tData.Price 			= szPrice	' 가격
				tData.OrderNo 		= szOderNo	' 주문번호
				tData.OrgOrderNo 		= ""			' 원주문번호
				tData.ucTradingType	= szClsCode 	' 매매구분(매도:1,매수:2)
				tData.ucOrderType		= "1"		' 신규:1, 정정:2, 취소:3
				tData.szStatus 		= G_ORD_RS_STS_JUPSU '정상
				
				tData.Qty = _tonumber(tData.Qty)
				tData.Price = _topricestring(_tonumber(tData.Price))
				tData.OrderNo = _tonumber(tData.OrderNo)
				tData.OrgOrderNo = _tonumber(tData.OrgOrderNo)
				InsertOrderTable(tData)
				'---------------------------------------
				'주문을 넣자마자 배열에 담는다. END
				'---------------------------------------

				'접수알림 메시지
				Form.Toast(0, szOrdMsg, true)
				
			end if			

		end if
		
		' 버튼처리
		BtnShow("", false)

	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	if szTranID == "ohhts_futs_aspr" then
		DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", 0 , g_szCode )
	end if

	if szTranID == "ohhts_futs_cntg" then
		DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", 0 , g_szCode )
	end if

	if szTranID == "ohhts_optn_aspr" then
		DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", 0 , g_szCode )
	end if

	if szTranID == "ohhts_optn_cntg" then
		DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", 0 , g_szCode )
	end if

	if szTranID == "ohhts_cntg_infr" then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", 0)
		DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_USER_ID", 0, szUserID)
	end if

	if szTranID == "ohhts_cntg_rslt" then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", 0)
		DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_USER_ID", 0, szUserID)
	end if

End Sub

'======================================
' Form_OnPopupReturn
'======================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	'기타매도
	if sKeyName == "SEL_OTHER_PRC" then
		g_szPrice = _topricestring(_tonumber(sRet))
		HogaCellClick(G_SCODE_MAEDO, G_SCODE_ORDER)

	'기타매수
	elseif sKeyName == "BUY_OTHER_PRC" then
		g_szPrice = _topricestring(_tonumber(sRet))
		HogaCellClick(G_SCODE_MAESU, G_SCODE_ORDER)

	'주문확인
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			g_szWarningYN = "N"
			HogaCellProc()
		end if

	'경고안내
	elseif sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarningYN = "Y"
			HogaCellProc()
		end if

	'수량팝업
	elseif sKeyName == "RETURN_QTY" then
		edtQty.caption = sRet
		InitWarning()
		
		if g_bBtnFlag == true then
			g_bBtnFlag = false
			BtnShow("", false)
			RefreshHogaTable()
			return
		end if
		
	'잔고팝업, 미체결팝업에서 리턴
	elseif sKeyName == "31030_BALANCE" or sKeyName == "31030_CONTRACT" then
		Dim szChk

		if sRet <> "" then
			tData = Split(sRet, "★")

			g_szCode = tData(2)
			szMarket = Form.GetItemCodeInfo(g_szCode, "market" )
			
			'20220915 LES START : 상품선옵 종목세팅 X
			'20180102 HAMWG START : 주식선옵 종목세팅 X 
			'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
			if szMarket == "JF" or szMarket == "JO" or szMarket == "CF" or szMarket == "FF" then
				Form.ShowAlert("알림", "선택상품은 호가주문에서 거래되지 않는 상품입니다.")
				g_szCode = Form.GetSharedData("&ITEM_K200_FUTOPT", 0)  ' KOSPI200 최근조회종목
				
				Form.SetItemCode(g_szCode)	' 종목코드 설정
			else
				Form.SetItemCode(g_szCode)	' 종목코드 설정
				if tData(3) <> "" then
					if sKeyName == "31030_BALANCE" then
						edtQty.caption = tData(3)
					
					elseif sKeyName == "31030_CONTRACT" then
						tList = Split(tData(3), "♥")
						edtQty.caption = tList(1)
					
					end if
				end if
			end if
			'20180102 HAMWG END
		end if
		
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				edtPwd_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
		
	end if

End Sub

'----------------------------------------------------------------------------
'서비스 아이디 체크
'TTRODP11301:확인-REALRECV_CONF
'TTRODP11311:확인
'TTRODP11321:신규주문거부-REALRECV_REJECT
'TTRODP11303:IOC/FOK 주문등의 자동취소-REALRECV_CANCEL
'============================================================================
Function CheckServiceId(svcId)
	
	if svcId == "TTRODP11301" then
		return true
	elseif svcId == "TTRODP11311" then
		return true
	elseif svcId == "TTRODP11321" then
		return false
	elseif svcId == "TTRODP11303" then
		return false
	end if

	return false
	
End Function

'----------------------------------------------------------------------------
' 종목코드 비교
'============================================================================
Function CompareCode(aSvrCode, aCurrCode)
	
	if Left(Right(aSvrCode, 9),8) == aCurrCode then
		return true
	end if
	
	return false
	
End Function

'----------------------------------------------------------------------------
' 미채결 내역에 해당 오더가 있는가?
' szOrderNo : 주문번호
' szType : 0-접수-정상, 1-체결-역전건
'============================================================================
Function GetExistCheck(szOrderNo, szType)

	for i=0 to #g_tOrderTable-1
		if g_tOrderTable[i].OrderNo == szOrderNo and 
			g_tOrderTable[i].szStatus == szType then
			return true
		end if
	next

	return false

End Function

'----------------------------------------------------------------------------
' 실시간
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	
	' ----------------------
	' 실시간 호가-선물,옵션
	' ----------------------
	if (szTranID == "ohhts_futs_cntg" or szTranID == "ohhts_optn_cntg") then
		
		'실시간 현재가, 상한가, 하한가
		g_szCurrPrice = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_PRPR2" , 0)
		g_szHighPrice = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_RLTM_MXPR" , 0)
		g_szLowPrice  = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_RLTM_LLAM" , 0)
		
	end if

	' ----------------------
	' 주문-접수
	' ----------------------
	if szTranID == "ohhts_cntg_infr" then

'''		for j=0 to #g_tOrderTable-1
'''			Form.ShowAlert("접수결과BGN", (#g_tOrderTable).."/"..(j)..":"..g_tOrderTable[j].szStatus..":::"..g_tOrderTable[j].OrderNo.." "..g_tOrderTable[j].OrgOrderNo.." "..g_tOrderTable[j].Price)
'''		next

		Dim _rowCnt, _szAcno, _szAsno, _szSvcId, _szStockCode
		_rowCnt = DATAMANAGER.GetDataCount(1, "ohhts_cntg_infr", "OutBlock1")

		Dim tData()
		For i=0 to _rowCnt -1
			
			_szAcno		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ACNO", i) 		'계좌번호
			_szAsno 		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ASNO", i) 		'계좌일련번호
			_szSvcId 	= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_SVC_ID", i) 		'서비스아이디
			_szStockCode 	= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_STND_ISCD", i)	'종목코드
			
			''''Form.ShowAlert("T1>"..i, "-->".._szSvcId.." ".._szStockCode.."<->"..g_szCode)
			
			'계좌, 종목코드 체크
			if (acnt.total == _szAcno) and 
			   (acnt.sequence == _szAsno) and
			   (CompareCode(_szStockCode, g_szCode) == true)
			then 

				tData = {}
				tData = InitOrderData(tData)

				tData.ProsOrderNo		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_PROS_SRNO", i) 		' 처리일련번호
				tData.Qty 			= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_TLMS_ASPR_QTY", i)		' 수량
				tData.Price 			= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ASPR_PRC", i)			' 가격
				tData.OrderNo 		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ODER_NO", i)			' 주문번호
				tData.OrgOrderNo 		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ORGL_ODER_NO", i)		' 원주문번호
				tData.ucTradingType	= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_DEAL_CLS_CODE", i) 	' 매매구분(매도:1,매수:2)
				tData.ucOrderType		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_RCTF_CNCL_CLS_CODE", i)	' 신규:1, 정정:2, 취소:3
				tData.szStatus 		= G_ORD_RS_STS_JUPSU '정상
				
				tData.Qty = _tonumber(tData.Qty)
				tData.Price = _topricestring(_tonumber(tData.Price))
				tData.OrderNo = _tonumber(tData.OrderNo)
				tData.OrgOrderNo = _tonumber(tData.OrgOrderNo)

				'정상주문
				if CheckServiceId(_szSvcId) == true then
					
					''''Form.ShowAlert("접수Receive:>"..i, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
	
					'----------
					'단건
					'----------
					'신규
					'(1/1) 5 240.90  100046 0
					
					'정정
					'(1/2) 5 240.95  100047 100046
					
					'취소
					'(1/3) 5 0.00    100048 100047
					'----------
					'다건
					'----------
					'취소
					'(1/3) 5 0.00 100051  100050
					'(1/3) 5 0.00 100052  100049
	
					'===============
					'신규주문건-주문클릭할때 배열에 넣는것으로 변경하여, 접수때 배열넣을 필요 없음
					'===============
					if tData.ucOrderType == "1" then
						' 체결건에 있으면 바로 지움
						if GetExistCheck(tData.OrderNo, G_ORD_RS_STS_CHAEKEUL) == true then
							DeleteOrderTable(tData.OrderNo)
							'''Form.ShowAlert("접수Receive:-T2>"..i, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
						' 미체결 리스트에 등록
						else
							DeleteOrderTable(tData.OrderNo)
							InsertOrderTable(tData)
							'''Form.ShowAlert("접수Receive:-T2>"..i, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
						end if
					'===============
					'정정주문건
					'===============
					elseif tData.ucOrderType == "2" then
					
						'20230726 SWJ START : 순서 변경 (원래 insert -> delete 순서였음)
						'원주문데이터를 삭제하지 않은 상태에서 쌓아서
						'2번째 정정부터 원주문이 clear 되지 않았음
						' 미체결 배열에서 원주문번호 데이타를 삭제.
						DeleteOrderTable(tData.OrgOrderNo)
						
						' 정정주문내역을 미체결 내역에 삽입.
						InsertOrderTable(tData)
						'20230726 SWJ END
						
						'''Form.ShowAlert("접수Receive:-정정-T3>"..i, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
	
					'===============
					'취소주문건
					'===============
					elseif tData.ucOrderType == "3" then
						
						'미체결 리스트에서 검색
						for j=0 to #g_tOrderTable-1
							if g_tOrderTable[j].OrderNo == tData.OrgOrderNo then
								
								'전량취소
								if g_tOrderTable[j].Qty == tData.Qty then
									DeleteOrderTable(tData.OrgOrderNo)
									'''Form.ShowAlert("접수Receive:-전량취소T-40>"..j, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
								'부분취소
								else
									g_tOrderTable[j].Qty = Cint(g_tOrderTable[j].Qty) - Cint(tData.Qty)
									'''Form.ShowAlert("접수Receive:-부분취소T-41>"..j, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
								end if
							end if
						next
					end if
				'거부
				else
					'주문클릭할때 넣은 배열을 Clear 처리함
					DeleteOrderTable(tData.OrderNo)
				
				end if
			end if
		Next

'''		if (CheckServiceId(_szSvcId) == false) then
'''			if _szSvcId == "TTRODP11321" then
'''				Form.ShowAlert("[알림]", "[".._szSvcId.."]신규주문거부")
'''			elseif _szSvcId == "TTRODP11303" then
'''				Form.ShowAlert("[알림]", "[".._szSvcId.."]자동취소")
'''			else
'''				Form.ShowAlert("[알림]", "[".._szSvcId.."]주문거부")
'''			end if
'''
'''		end if


'''		for j=0 to #g_tOrderTable-1
'''			Form.ShowAlert("접수결과END", (#g_tOrderTable).."/"..(j)..":"..g_tOrderTable[j].szStatus..":::"..g_tOrderTable[j].OrderNo.." "..g_tOrderTable[j].OrgOrderNo.." "..g_tOrderTable[j].Price)
'''		next

	end if

	' ----------------------
	' 주문-체결
	' ----------------------
	if szTranID == "ohhts_cntg_rslt" then

'''		for j=0 to #g_tOrderTable-1
'''			Form.ShowAlert("체결결과BGN", (#g_tOrderTable).."/"..(j)..":"..g_tOrderTable[j].szStatus..":::"..g_tOrderTable[j].OrderNo.." "..g_tOrderTable[j].OrgOrderNo.." "..g_tOrderTable[j].Price)
'''		next

		Dim _rowCnt, _szAcno, _szAsno, _szSvcId, _szStockCode
		_rowCnt = DATAMANAGER.GetDataCount(1, "ohhts_cntg_rslt", "OutBlock1")
		
		Dim tData()
		For i=0 to _rowCnt -1

			_szAcno		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_ACNO", i) '계좌번호
			_szAsno		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_ASNO", i) '계좌일련번호
			_szSvcId 	= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_SVC_ID", i) 	'서비스아이디
			_szStockCode 	= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_STND_ISCD", i)	'종목코드
			
			'''Form.ShowAlert("K1>", i..":".._szSvcId.."<->".._szStockCode.."<->"..g_szCode)
			
			'계좌, 종목코드 체크
			if (acnt.total == _szAcno) and 
			   (acnt.sequence == _szAsno) and
			   (CompareCode(_szStockCode, g_szCode) == true)
			then

				tData = {}
				tData = InitOrderData(tData)

				tData.ProsOrderNo		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_PROS_SRNO", i) 	' 처리일련번호
				tData.Qty 			= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_CNTG_QTY", i)		' 수량
				tData.Price 			= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_CNTG_PRC", i)		' 가격
				tData.OrderNo 		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_ODER_NO", i)		' 주문번호
				tData.OrgOrderNo 		= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_ORGL_ODER_NO", i)	' 원주문번호
				tData.ucTradingType	= DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_DEAL_CLS_CODE", i) ' 매매구분(매도:1,매수:2)
				tData.szStatus 		= G_ORD_RS_STS_CHAEKEUL '체결

				tData.Qty = _tonumber(tData.Qty)
				tData.Price = _topricestring(_tonumber(tData.Price))
				tData.OrderNo = _tonumber(tData.OrderNo)
				tData.OrgOrderNo = _tonumber(tData.OrgOrderNo)
				
				'''Form.ShowAlert("체결Rcv:>", (i)..")-->("..tData.ucTradingType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
				
				' 미체결내역에 있음 -> 털어냄
				if GetExistCheck(tData.OrderNo, G_ORD_RS_STS_JUPSU) == true then
				
					'미체결 리스트에서 검색
					for j=0 to #g_tOrderTable-1
						if g_tOrderTable[j].OrderNo == tData.OrderNo then
							
							' 전량체결
							if g_tOrderTable[j].Qty == tData.Qty then
								DeleteOrderTable(tData.OrderNo)
								'''Form.ShowAlert("체결Receive:-전량체결>"..j, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
								
							' 부분체결
							else
								g_tOrderTable[j].Qty = Cint(g_tOrderTable[j].Qty) - Cint(tData.Qty)
								'''Form.ShowAlert("체결Receive:-부분체결>"..j, "-->("..tData.ucTradingType.."/"..tData.ucOrderType..") "..tData.Qty.." "..tData.Price .." "..tData.OrderNo.." "..tData.OrgOrderNo)
								
							end if
						end if
					next
				' 미체결내역에 없음 -> 미체결내역에 체결건으로 삽입
				else
					InsertOrderTable(tData)
					
				end if
				
			end if
		Next

'''		if (CheckServiceId(_szSvcId) == false) then
'''			if _szSvcId == "TTRODP11321" then
'''				Form.ShowAlert("[알림]", "[".._szSvcId.."]신규주문거부")
'''			elseif _szSvcId == "TTRODP11303" then
'''				Form.ShowAlert("[알림]", "[".._szSvcId.."]자동취소")
'''			else
'''				Form.ShowAlert("[알림]", "[".._szSvcId.."]주문거부")
'''			end if
'''
'''		end if

'''		for j=0 to #g_tOrderTable-1
'''			Form.ShowAlert("체결결과END", (#g_tOrderTable).."/"..(j)..":"..g_tOrderTable[j].szStatus..":::"..g_tOrderTable[j].OrderNo.." "..g_tOrderTable[j].OrgOrderNo.." "..g_tOrderTable[j].Price)
'''		next

	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

	if (szTranID == "ohhts_futs_aspr" or
		szTranID == "ohhts_optn_aspr" or 
		szTranID == "ohhts_futs_cntg" or 
		szTranID == "ohhts_optn_cntg") then
		
		'버튼이 활성화 상태이면 멈춤
		if g_bBtnFlag <> true then
			RefreshHogaTable()
		end if

	end if

	' ----------------------
	' 주문-접수
	' ----------------------
	if szTranID == "ohhts_cntg_infr" then
		RefreshHogaTable()
		
	end if

	' ----------------------
	' 주문-체결
	' ----------------------
	if szTranID == "ohhts_cntg_rslt" then
		RefreshHogaTable()

	end if

End Sub

'============================================================================
Sub TableBot_OnClick(lRow , lColumn)

	if lColumn == 0 then
		if TableBot.GetCellString( lRow, lColumn ) == "" then
			return
		end if
	
		if g_bBtnFlag == true then
			g_bBtnFlag = false
			BtnShow("", false)
			RefreshHogaTable()
			return
		end if
		
		g_bBtnFlag = true
		
		BtnSelClsAll.top = 525
		BtnSelClsAll.visible = True
		BtnBuyClsAll.visible = False

	elseif lColumn == 4 then
		if TableBot.GetCellString( lRow, lColumn ) == "" then
			return
		end if

		if g_bBtnFlag == true then
			g_bBtnFlag = false
			BtnShow("", false)
			RefreshHogaTable()
			return
		end if

		g_bBtnFlag = true
		
		BtnBuyClsAll.top = 525
		BtnSelClsAll.visible = False
		BtnBuyClsAll.visible = True
	else
		if g_bBtnFlag == true then
			BtnSelClsAll.visible = False
			BtnBuyClsAll.visible = False
		end if
	
	End if

End Sub

