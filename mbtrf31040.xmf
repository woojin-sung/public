' ---------------------------------------------------------------------------
'매도/매수 셀 텍스트 ( 정정 )
'============================================================================
Function SetCellText(bFlag)

	Dim nRowCnt
	nRowCnt = 10

	if bFlag == true then
		for i=0 to nRowCnt-1
			if i ~= _tonumber(g_szRow) and _topricestring(_tonumber(cont.HogaTbl.GetCellString(i, 2))) ~= "" then
					cont.HogaTbl.SetCellString(i, _tonumber(g_szCol), "정정")
			end if
		Next
		
	else
		for i=0 to nRowCnt-1
			cont.HogaTbl.SetCellString(i, 0, "")
			cont.HogaTbl.SetCellString(i, 4, "")
		Next
		
	end if

End Function

' ---------------------------------------------------------------------------
'버튼 제어( 매도/매수 취소 또는 추가주문 )
'============================================================================
Function BtnShow(aOrderType, aFlag)

	BtnSelClsAll.visible = False
	BtnBuyClsAll.visible = False

	if aFlag == true then
		'매도
		if aOrderType ==  G_SCODE_MAEDO then
			contSel.top = 350
			contSel.visible = True
			contBuy.visible = False
			
		elseif aOrderType ==  G_SCODE_MAESU then
			contBuy.top = 202
	
			contSel.visible = False
			contBuy.visible = True
			
		end if
		
	else 
		contSel.visible = False
		contBuy.visible = False
		
	end if
	
End Function

' ---------------------------------------------------------------------------
'취소 
'aOrderType : 매도/매수
'aFlag : true:전체, false:선택한 호가
'============================================================================
Function BtnCancel(aOrderType, aFlag)

	if Check_Validation(G_SCODE_CANCEL) == false then
		BtnShow("", false)
		return
	end if

	g_tModCnlTable = {}
	
	'전체취소
	if aFlag == true then
		for i=0 to #g_tOrderTable-1
			'매수 or 매도 전체 copy
			if g_tOrderTable[i].ucTradingType == aOrderType then
				Dim bExistOrderTable
				Dim tData()
				bExistOrderTable, tData = GetOrderTable(g_tOrderTable[i].OrderNo)
				
				if bExistOrderTable == true then
					InsertModCnlTable(tData)
				end if
			end if
		Next
	'선택취소
	else
		for i=0 to #g_tOrderTable-1
			'매도 or 매도 중 선택한 가격만 Copy
			if g_tOrderTable[i].ucTradingType == aOrderType and
				g_tOrderTable[i].Price == g_szPrice 
			then
				Dim bExistOrderTable
				Dim tData()
				bExistOrderTable, tData = GetOrderTable(g_tOrderTable[i].OrderNo)
				
				if bExistOrderTable == true then
					InsertModCnlTable(tData)
				end if
			end if
		Next
	end if

	BtnShow("", false)
	RefreshHogaTable()
	
	' 매도/매수 취소확인창
	Confirm_Popup(aOrderType, G_SCODE_CANCEL)
	
End Function

