'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	InitLocalGlobalVariable()
	InitControl()
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
	' ----------------------------------------------
	' 다른화면에서 화면오픈시 or 최근조회종목 BEGIN
	' ----------------------------------------------
	Dim szOpen
	szOpen = Form.GetOpenLinkData()
	
	if szOpen <> "" then
		tData = Split(szOpen, "★")
		
		if UBOUND(tData) < 1 then
		   Exit sub
		End if
	
		g_szCode = tData(0)
		g_szMarket = Form.GetMarketGubun(g_szCode)
	else
		g_szCode = Form.GetSharedData("&ITEM_FUTOPT", 0)  ' 최근조회종목
		g_szMarket = Form.GetItemCodeInfo(g_szCode, "market" )
	end if
	
	'20220915 LES START : 상품선옵 종목세팅 X
	'20180102 HAMWG START : 주식선옵 종목세팅 X 
	'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
	if g_szMarket = "JF" or g_szMarket = "JO" or g_szMarket = "CF" or g_szMarket = "FF" then
		g_szCode = Form.GetSharedData("&ITEM_K200_FUTOPT", 0)  ' KOSPI200 최근조회종목
		g_szMarket = Form.GetItemCodeInfo(g_szCode, "market" )
	end if
	'20180102 HAMWG END
	
	' ----------------------------------------------
	' 다른화면에서 화면오픈시 or 최근조회종목 END
	' ----------------------------------------------
	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
'	if acnt.total == "" then
'		Form.ShowAlert(g_szTitle, "조회 가능한 계좌가 없습니다.")
'	end if
	
	g_bInitAfter = true
	
	' 종목컨트롤
	Form.SetSearchType ("4")
	Form.SetItemCode(g_szCode)	' 최초 화면진입시 종목코드 설정

End Sub

'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)

''''Form.ShowAlert("", "OnLinkData=>"..sKey.." "..sValue.."->"..g_bInitAfter)

	if sKey == "ITEMCODE" then
	
		if g_bInitAfter == true then
		
			g_szCode = sValue
			g_szMarket = Form.GetItemCodeInfo(g_szCode, "market" )
			
			'20220915 LES START : 상품선옵 종목세팅 X
			'20180102 HAMWG START : 주식선옵 종목세팅 X 
			'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
			if g_szMarket = "JF" or g_szMarket = "JO" or g_szMarket = "CF" or g_szMarket = "FF" then
				Form.ShowAlert("알림", "선택상품은 호가주문에서 거래되지 않는 상품입니다.")
				g_szCode = Form.GetSharedData("&ITEM_K200_FUTOPT", 0)  ' KOSPI200 최근조회종목
				g_szMarket = Form.GetItemCodeInfo(g_szCode, "market" )
				Form.SetItemCode(g_szCode)	' 최초 화면진입시 종목코드 설정
			end if
			'20180102 HAMWG END
			
			
			DATAMANAGER.RequestTranData( "ohhts_4030_001r" ) '현재가 조회
			DATAMANAGER.RequestTranData( "obtrf_cntg_121r" ) '미채결 조회
			
		end if

	end	if

End Sub

'========================================================================================
' 호가테이블 클릭 처리
' szOrderType  : 1 매도, 2 매수
' szModCnlType : 0 매도/매수, 1 매도, 2 매수, 3 정정, 4 취소
'========================================================================================
Sub cont_HogaTbl_OnClick(lRow, lCol)

	InitWarning()
	g_szRow	= lRow
	g_szCol	= lCol
	
	'Form.ShowAlert(sTitle, g_bBtnFlag)
	if g_bBtnFlag == true then
		g_bBtnFlag = false
		BtnShow("", false)
		
		if lCol ~= 0 and lCol ~= 4 then
			SetCellText(false)
			RefreshHogaTable()
			InitOrderVariable()
			return
		end if
		
	end if

	Dim szData, szPrice
	szData = cont.HogaTbl.GetCellString(lRow, lCol)
	szPrice = _topricestring(_tonumber(cont.HogaTbl.GetCellString(lRow, 2)))

	if szPrice == "0.00" then
		return
	end if

	' 매도영역
	if lCol == 0 then
	
		'빈셀 클릭
		if szData == "" then
			
			g_bBtnFlag = false
			g_szPrice = szPrice
			
			HogaCellClick(G_SCODE_MAEDO, G_SCODE_ORDER)

		'정정 클릭
		elseif szData == "정정" then
			
			g_bBtnFlag = false
			g_szModPrice	= szPrice
			
			HogaCellClick(G_SCODE_MAEDO, G_SCODE_MODIFY)
			
		'미체결 클릭
		else
			
			g_bBtnFlag = true
			g_szPrice = szPrice
			
			BtnShow(G_SCODE_MAEDO, true)
			SetCellText(true)
			
		end if
		
	' 매수영역
	elseif lCol == 4 then
	
		'빈셀 클릭
		if szData == "" then
			
			g_bBtnFlag = false
			g_szPrice = szPrice
			
			HogaCellClick(G_SCODE_MAESU, G_SCODE_ORDER)

		'정정 클릭
		elseif szData == "정정" then

			g_bBtnFlag = false
			g_szModPrice	= szPrice
			
			HogaCellClick(G_SCODE_MAESU, G_SCODE_MODIFY)

		'미체결 클릭
		else
			g_bBtnFlag = true
			g_szPrice = szPrice
			
			BtnShow(G_SCODE_MAESU, true)
			SetCellText(true)
			
		end if

	end if
	
End Sub

