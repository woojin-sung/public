	<SCRIPT_INFO _len="74371" _ulen="67717" >
'============================================================================
' 화 면 명 : 선옵호가주문
' 화면설명 : 선옵호가주문
' 작    성 : 2016.2.2 하원만
'============================================================================
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
' 20240412 HSZ 코스닥글로벌지수 추가 (KF)
' 20240716 HSZ : 버튼텍스트 변경 - 일괄취소 ->매도취소, 매수취소
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'--------------------------------------------
'주문의 유형
'--------------------------------------------
Dim G_SCODE_ORDER
Dim G_SCODE_MAEDO
Dim G_SCODE_MAESU
Dim G_SCODE_MODIFY
Dim G_SCODE_CANCEL

G_SCODE_ORDER 	= "0"  ' 주문(매수/매도)
G_SCODE_MAEDO 	= "1"  ' 매도
G_SCODE_MAESU 	= "2"  ' 매수
G_SCODE_MODIFY	= "3"  ' 정정
G_SCODE_CANCEL	= "4"  ' 취소

Dim g_szTitle
g_szTitle = "알림"

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

'--------------------------------------------
'주문처리결과 데이타의 유형
'--------------------------------------------
'주문 후 접수->체결순으로 오는것이 정상인데
'체결이 먼저 도착하는 경우가 있음
'이때 채결이 먼저온경우는 임시로 담고 있다가
'접수가 올때 미체결에 담지 않고 바로 Clear 처리함

Dim G_ORD_RS_STS_JUPSU '접수-정상건
Dim G_ORD_RS_STS_CHAEKEUL '체결-역전건

G_ORD_RS_STS_JUPSU 	= "0" 	' 접수-정상건
G_ORD_RS_STS_CHAEKEUL 	= "1" 	' 체결-역전건

'1 매도(SEL), 2 매수(BUY)
Dim g_szCode			' 종목코드
Dim g_szMarket		' 시장구분 (F : 선물, O : 옵션)
Dim g_bInitAfter		' 화면초기화 완료 여부

Dim g_szCurrPrice		' 현재가		-기타매수매도 팝업전달용
Dim g_szHighPrice		' 상한가		-기타매수매도 팝업전달용
Dim g_szLowPrice		' 하한가		-기타매수매도 팝업전달용
Dim g_szJunPrice		' 전일종가	-기타매수매도 팝업전달용

Dim g_bBtnFlag		' 버튼 제어 플래그
Dim g_tOrderTable()	' 미체결 주문을 담고있는 테이블
Dim g_tModCnlTable()	' 정정 or 취소할 Order를 담고있는 임시 테이블

Dim g_szRow			' 호가테이블 클릭 Row
Dim g_szCol			' 호가테이블 클릭 Col
Dim g_szPrice			' 호가테이블 클릭 가격
Dim g_szModPrice		' 호가테이블 정정 클릭 가격

Dim g_szOrderType 	' 주문유형(1:매도, 2:매수)
Dim g_szModCnlType	' 작업유형(0:주문, 3:정정, 4:취소, 5:경고)

Dim g_nTrSeqNo      	' TR순번

Dim g_szWarningYN      ' 경고 주문여부
Dim g_szWarningCode	' 경고 코드
Dim g_szWarningMessg	' 경고 메세지

Dim g_szTitle
g_szTitle = "알림"

' 계좌비밀번호 저장여부
Dim g_szSavePwd 
g_szSavePwd  = "0"


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 전역변수 초기화
'============================================================================
function InitLocalGlobalVariable()

	g_szCode			= ""
	g_szMarket		= ""
	g_bInitAfter		= false
	g_bBtnFlag		= false

	g_szCurrPrice		= 0		' 현재가-기타매수매도 팝업전달용
	g_szHighPrice		= 0		' 상한가-기타매수매도 팝업전달용
	g_szLowPrice		= 0		' 하한가-기타매수매도 팝업전달용
	g_szJunPrice		= 0		' 전일종가-기타매수매도 팝업전달용

	g_tOrderTable 	= {}		' 미체결 주문 정보 리스트 테이블
	g_tModCnlTable 	= {}		' 정정 or 취소할 Order를 담고있는 임시 테이블

	InitOrderVariable()

	g_szOrderType		= ""
	g_szModCnlType	= ""
	g_nTrSeqNo		= 0

end Function

'============================================================================
' 주문시 경고메세지를 담고있을 변수
'============================================================================
function InitWarning()

	g_szWarningYN = "N"
	g_szWarningCode = ""
	g_szWarningMessg = ""

end Function

'============================================================================
' 호가 클릭 클릭한 Row의 값을 담고있을 변수
'============================================================================
function InitOrderVariable()

	g_szRow = ""
	g_szCol = ""
	g_szPrice = ""
	g_szModPrice = ""

	InitWarning()

end Function

'============================================================================
' 화면 컨트롤 초기화
'============================================================================
function InitControl()

	edtQty.caption = ""
	'edtPwd.caption = ""
	
end Function

'============================================================================
'계좌변경시 초기화
'============================================================================
function InitAccount()
	
	g_tOrderTable = {}
	g_tModCnlTable = {}
	
end Function

'============================================================================
' 주문 TR 전송
'============================================================================
function RequestOrder(szModCnlType)

	Dim bValid
	bValid = Check_Validation(szModCnlType)

	if not bValid then 
		InitOrderVariable(); 
		return 
	end if

	'-------------------
	'''TEST 출력 BEGIN...
	'-------------------
'	if szModCnlType == "1" or szModCnlType == "2" then
'		Form.ShowAlert(sTitle, "--->>>:10"..szModCnlType ..(",K"..g_szCode) .. "," .. acnt.total .. "-" .. acnt.sequence .. "," ..g_szPrice)
'	elseif szModCnlType == "3" or szModCnlType == "4" then
'		if #g_tModCnlTable == 1 then
'			Form.ShowAlert(sTitle, "-Single-->>>:10"..szModCnlType ..(",K"..g_szCode) .. "," .. acnt.total .. "-" .. acnt.sequence .. "," ..g_szPrice.." "..g_tModCnlTable[0].OrderNo.." "..g_tModCnlTable[0].Qty)
'		else
'			for i=0 to #g_tModCnlTable-1
'				Form.ShowAlert(sTitle, "-Multi-->>>:10"..szModCnlType ..(",K"..g_szCode) .. "," .. acnt.total .. "-" .. acnt.sequence .. "," ..g_szPrice.." "..g_tModCnlTable[i].OrderNo.." "..g_tModCnlTable[i].Qty)
'			Next
'		end if
'	end if
	'-------------------
	'''TEST 출력 END...
	'-------------------

	' 매도 매수는 단건처리
	if szModCnlType == "1" or szModCnlType == "2" then

		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "SVC_CLS_CODE" ,0, ("10"..szModCnlType) )	' 서비스구분(101:매도,102:매수,103:정정,104:취소)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNO",0, acnt.total) 					' 계좌번호
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ASNO",0, acnt.sequence) 				' 일련번호
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNT_PWD",0, edtPwd.caption) 			' 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNT_PWD",0, edtPwd.encdata) 			' 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ISCD",0, ("K"..g_szCode)) 				' 종목코드(선물,옵션은 앞에 K붙임)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODER_COND_CLS_CODE",0, "0") 			' 주문조건구분코드(지정가)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "FTOP_ODER_UNPR",0, g_szPrice) 			' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ASPR_TYPE_CODE",0, "2") 				' 호가유형코드(지정가)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODQT",0, edtQty.caption)  				' 수량
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "PGM_ASPR_CLS_CODE",0, "00") 			' 프로그램호가구분코드(00으로 FIX)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "WARN_CNFR_YN" ,0, g_szWarningYN)  		' 경고확인여부-확인전
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODER_OCRN_TYPE_CODE" ,0, "01") 			' 주문발생유형코드(01:일반주문,13:자동주문)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "PROS_SRNO",0, GetTrSeqNo()) 			' 처리일련번호
		DATAMANAGER.RequestTranData( "obtrf_oder_101c" )

	' 정정 취소
	elseif szModCnlType == "3" or szModCnlType == "4" then
	
		' 단건처리
		if #g_tModCnlTable == 1 then
		
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "SVC_CLS_CODE" ,0, ("10"..szModCnlType) )		' 서비스구분(101:매도,102:매수,103:정정,104:취소)
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNO",0, acnt.total) 						' 계좌번호
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ASNO",0, acnt.sequence) 					' 일련번호
			
			'20200910 SWJ START
			'MTS메모리평문제거 적용상태일 때
			if plain_rm == "1" then
				DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNT_PWD",0, edtPwd.caption) 				' 비밀번호
			else
				DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ACNT_PWD",0, edtPwd.encdata) 				' 비밀번호
			end if
			'20200910 SWJ END
			
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ISCD",0, ("K"..g_szCode)) 					' 종목코드(선물,옵션은 앞에 K붙임)
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODER_COND_CLS_CODE",0, "0") 				' 주문조건구분코드(지정가)
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "FTOP_ODER_UNPR",0, g_szModPrice) 			' 주문단가 --> 정정단가
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ASPR_TYPE_CODE",0, "2") 					' 호가유형코드(지정가)
			'DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODQT",0, edtQty.caption)  				' 수량
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODQT",0, g_tModCnlTable[0].Qty)  			' 수량
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "PGM_ASPR_CLS_CODE",0, "00") 				' 프로그램호가구분코드(00으로 FIX)
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "WARN_CNFR_YN" ,0, "Y")  					' 경고확인여부-확인후
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ORGL_ODER_NO" ,0, g_tModCnlTable[0].OrderNo)	' 원주문번호
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "WHOL_RCTF_CNCL_YN",0, "N")					' 전체정정취소여부(N으로 FIX)
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "ODER_OCRN_TYPE_CODE" ,0, "01") 				' 주문발생유형코드(01:일반주문,13:자동주문)
			DATAMANAGER.SetDataValue(0, "obtrf_oder_101c", "InBlock1", "PROS_SRNO",0, GetTrSeqNo()) 				' 처리일련번호
			DATAMANAGER.RequestTranData( "obtrf_oder_101c" )

		' 다건 처리
		elseif #g_tModCnlTable > 1 then

			for i=0 to #g_tModCnlTable-1
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "SVC_CLS_CODE", i, ("10"..szModCnlType)) 		' 서비스구분
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ACNO", i, acnt.total) 					' 계좌번호
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ASNO", i, acnt.sequence) 					' 계좌일련번호
				
				'20200910 SWJ START
				'MTS메모리평문제거 적용상태일 때
				if plain_rm == "1" then
					DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ACNT_PWD", i, edtPwd.caption) 				' 비밀번호
				'MTS메모리평문제거 미적용상태일 때
				else
					DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ACNT_PWD", i, edtPwd.encdata) 				' 비밀번호
				end if
				'20200910 SWJ END
				
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ISCD", i, ("K"..g_szCode)) 				' 종목코드(선물,옵션은 앞에 K붙임)
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "FTOP_ODER_UNPR", i, g_szModPrice) 			' 주문단가 --> 정정단가
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ODQT", i, g_tModCnlTable[i].Qty) 			' 취소, 정정 수량
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "PGM_ASPR_CLS_CODE", i, "00") 				' 프로그램호가구분코드(00으로 FIX)
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ORGL_ODER_NO", i, g_tModCnlTable[i].OrderNo) ' 원주문번호
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ASPR_TYPE_CODE", i, "2") 					' 호가유형코드
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "ODER_COND_CLS_CODE", i, "0") 				' 주문조건코드
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "WHOL_RCTF_CNCL_YN", i, "Y") 				' 전체정정취소여부
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "PROS_SRNO", i, GetTrSeqNo()) 			' 처리일련번호
				DATAMANAGER.SetDataValue(0, "obtrf_oder_201c", "InBlock2", "WARN_CNFR_YN" ,0, "Y")  					' 경고확인여부-확인후
			next

			DATAMANAGER.RequestTranData( "obtrf_oder_201c" )
		end if
	
	end if

end function

'======================================
' 호가주문은 20001부터 시작.
'======================================
function GetTrSeqNo()
	
	if g_nTrSeqNo == nil then
		g_nTrSeqNo = 20001
	end if
	
	g_nTrSeqNo = g_nTrSeqNo + 1
	
	if g_nTrSeqNo >= 30000 then
		g_nTrSeqNo = 20001
		
	end if
	
	return g_nTrSeqNo
	
End Function

'======================================
' trim 재정의
'======================================
function _trim(szStr)
	if szStr == nil then
		return ""
	else
		return Trim(szStr)
	end if
	
End Function

'======================================
' topricestring (선옵 가격을 소수점 2자리로 저장)
'======================================
function _topricestring(dPrice)

	if tostring(dPrice) == "" then 
		return "0.00" 
	end if
	
	Dim tData, szData1, szData2
	
	tData = Split(_trim(tostring(dPrice)), ".")
	szData1 = tData[0]
	szData2 = #tData == 1 and "00" or tData[1]

	if Len(szData2) == 1 then
		szData2 = szData2 .. "0"
	elseif Len(szData2) == 0 then
		szData2 = "00"
	end if
	
	return szData1 .. "." .. szData2

End Function

'======================================
' tonumber 재정의
'======================================
function _tonumber(szStr)

	if not tonumber(szStr) then
		return 0
	else
		return tonumber(szStr)
	end if
	
End Function

'======================================
' 취소수량 구하기
'======================================
Function GetTotalQty(aOrderType)

	Dim iQty
	iQty = 0
	
	for i=0 to #g_tModCnlTable-1
		if g_tModCnlTable[i].ucTradingType == aOrderType then
		   iQty = iQty + _tonumber(g_tModCnlTable[i].Qty)
		end if
	next
	
	return iQty

End Function

'======================================
' InitOrderData
'======================================
Function InitOrderData(tOrderData)

	tOrderData.ProsOrderNo = ""		' 처리일련번호
	tOrderData.Qty = ""			' 수량
	tOrderData.Price = ""			' 가격
	tOrderData.OrderNo = ""		' 주문번호
	tOrderData.OrgOrderNo = ""		' 원주문번호
	tOrderData.ucTradingType = ""	' 매도:1, 매수:2
	tOrderData.ucOrderType	= ""		' 신규:1, 정정:2, 취소:3
	tOrderData.szStatus = ""		' 체결 역전 구분 (0:정상, 1:역전)
	return tOrderData

End Function

'======================================
' InsertOrderTable
'======================================
Function InsertOrderTable(tOrderData)
	for i=0 to #g_tOrderTable-1
		if g_tOrderTable[i].OrderNo == "" then
			g_tOrderTable[i] = tOrderData
			return
		end if
	next
	
	g_tOrderTable[#g_tOrderTable] = tOrderData
End Function

'======================================
' InsertModCnlTable
'======================================
Function InsertModCnlTable(tOrderData)
	for i=0 to #g_tModCnlTable-1
		if g_tModCnlTable[i].OrderNo == "" then
			g_tModCnlTable[i] = tOrderData
			return
		end if
	next
	g_tModCnlTable[#g_tModCnlTable] = tOrderData
End Function

'======================================
' SetOrderTable
'======================================
Function SetOrderTable(tOrderData)
	for i=0 to #g_tOrderTable-1
		if g_tOrderTable[i].OrderNo == tOrderData.OrderNo then
			g_tOrderTable[i] = tOrderData
			return
		end if
	next
End Function

'======================================
' GetOrderTable
'======================================
Function GetOrderTable(szOrdNo)
	for i=0 to #g_tOrderTable-1
		if g_tOrderTable[i].OrderNo == szOrdNo then
			return true, g_tOrderTable[i]
		end if
	next
	
	Dim tData()
	return false, InitOrderData(tData)
End Function

'======================================
' DeleteOrderTable
'======================================
Function DeleteOrderTable(szOrderNo)
	for i=0 to #g_tOrderTable-1
		if g_tOrderTable[i].OrderNo == szOrderNo then
			'''Form.ShowAlert(sTitle, "DeleteOk:"..g_tOrderTable[i].OrderNo)
			
			Dim tData()
			tData = {}
		
			g_tOrderTable[i] = InitOrderData(tData)
			return
		end if
	next
End Function

'======================================
' Check_Validation
'======================================
Function Check_Validation(szType)
	
	If Trim(g_szCode) == "" Then
		Form.ShowAlert(g_szTitle, "종목코드가 없습니다. 확인 후 다시 입력하십시오.")
		return False
	end If

	If Len(acnt.total & acnt.sequence) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인 후 다시 입력하십시오.")
		return False
	End If
	
	If Trim(edtPwd.caption) == "" Then
		Form.ShowAlert(g_szTitle, "비밀번호를 확인 후 다시 입력하십시오.")
		return False
	end If
	
	'정정/취소는 수량 입력 체크 안함(부분정정, 부분취소 없음)
	if szType ~= G_SCODE_MODIFY and szType ~= G_SCODE_CANCEL then
		If Trim(edtQty.caption) == "" Then
			Form.ShowAlert(g_szTitle, "수량을 입력하십시오.")
			return False
		end If
	end if
	
	return True
	
End Function

'============================================================================
' 호가별 주문테이블 화면에 표시
'============================================================================
function RefreshHogaTable()

	'호가별 합계산
	Dim szPrice
	for i=0 to 9
	
		szPrice = cont.HogaTbl.GetCellString(i, 2)

		if szPrice <> "" then
			
			Dim subSelCnt, subSelQty
			Dim subBuyCnt, subBuyQty
			
			subSelCnt = 0
			subSelQty = 0
			subBuyCnt = 0
			subBuyQty = 0
			
			for j=0 to #g_tOrderTable-1
				if _tonumber(g_tOrderTable[j].Price) == _tonumber(szPrice) then
					
					'매도
					if g_tOrderTable[j].ucTradingType == G_SCODE_MAEDO then
						subSelCnt = subSelCnt + 1
						subSelQty = subSelQty + g_tOrderTable[j].Qty
					'매수
					elseif g_tOrderTable[j].ucTradingType == G_SCODE_MAESU then
						subBuyCnt = subBuyCnt + 1
						subBuyQty = subBuyQty + g_tOrderTable[j].Qty
					end if
				end if
			next

			'매도
			if subSelCnt > 0 then
				cont.HogaTbl.SetCellString(i, 0, subSelQty .. "(" .. subSelCnt .. ")")
			else
				cont.HogaTbl.SetCellString(i, 0, "")
			end if
			
			'매수
			cont.HogaTbl.SetCellString(i, 4, "")
			if subBuyCnt > 0 then
				cont.HogaTbl.SetCellString(i, 4, subBuyQty .. "(" .. subBuyCnt .. ")")
			else
				cont.HogaTbl.SetCellString(i, 4, "")
			end if
		end if		
	Next

	Dim totSelCnt, totSelQty
	Dim totBuyCnt, totBuyQty
	totSelCnt = 0
	totSelQty = 0
	totBuyCnt = 0
	totBuyQty = 0

	'미체결 합계산
	for j=0 to #g_tOrderTable-1

		'매도
		if g_tOrderTable[j].ucTradingType == G_SCODE_MAEDO then
			totSelCnt = totSelCnt + 1
			totSelQty = totSelQty + g_tOrderTable[j].Qty
		'매수
		elseif g_tOrderTable[j].ucTradingType == G_SCODE_MAESU then
			totBuyCnt = totBuyCnt + 1
			totBuyQty = totBuyQty + g_tOrderTable[j].Qty

		end if
	next

	if totSelCnt > 0 then
		TableBot.SetCellString(0, 0, totSelQty .. "(" .. totSelCnt .. ")")
	else
		TableBot.SetCellString(0, 0, "")
	end if

	if totBuyCnt > 0 then
		TableBot.SetCellString(0, 4, totBuyQty .. "(" .. totBuyCnt .. ")")
	else
		TableBot.SetCellString(0, 4, "")
	end if

end Function

'=======================================================================
' szOrderType  : 주문유형(1:매도, 2:매수)
' szModCnlType : 작업유형(0:주문, 3:정정, 4:취소, 5:경고)
'=======================================================================
Function Confirm_Popup(szOrderType, szModCnlType)

	''''Form.ShowAlert(sTitle, g_szWarningCode.." "..g_szWarningMessg)

	g_szOrderType = szOrderType
	g_szModCnlType = szModCnlType

	Dim szData
	szData = ""
	szData = szData & "|" & acnt.total & acnt.sequence			' 계좌번호
	szData = szData & "|" & acnt.accountname						' 계좌명
	szData = szData & "|" & g_szCode							' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCode, "name")	' 종목명
	szData = szData & "|보통"									' 주문구분
	
	'정정가격
	if szModCnlType == G_SCODE_MODIFY then
		szData = szData & "|" & g_szModPrice
	'주문가격
	else
		szData = szData & "|" & g_szPrice
	end if
	
	'정정/취소수량 계산
	if szModCnlType == G_SCODE_MODIFY or szModCnlType == G_SCODE_CANCEL then
		szData = szData & "|" & GetTotalQty(szOrderType)
	'주문수량
	else
		szData = szData & "|" & edtQty.caption
	end if

	' ----------------------------------------------------------------------
	' 매도주문
	' ----------------------------------------------------------------------	
	if szOrderType == G_SCODE_MAEDO and szModCnlType == G_SCODE_ORDER then
		szData = "1"	& szData									' 매매구분(0:매수, 1:매도, 2:정정, 3:취소))
		
		if g_szWarningCode == "" then
			szData = szData & "|" & ""							' 원주문번호
			Form.OpenPopup("mbtrf31050_p3", szData , "")			' 주문확인팝업 오픈
		else
			szData = szData & "|999999" & ""					' 원주문번호
			szData = szData & "|"& g_szWarningMessg & ""			' 경고메세지
			Form.OpenPopup("mbtrf31050_p6", szData , "")			' 주문확인팝업 오픈
			g_szWarningCode = ""
		end if

	' ----------------------------------------------------------------------
	' 매수주문
	' ----------------------------------------------------------------------	
	elseif szOrderType == G_SCODE_MAESU and szModCnlType == G_SCODE_ORDER then
		szData = "0"	& szData									' 매매구분(0:매수, 1:매도, 2:정정, 3:취소))
		
		if g_szWarningCode == "" then
			szData = szData & "|" & ""							' 원주문번호
			Form.OpenPopup("mbtrf31050_p2", szData , "")			' 주문확인팝업 오픈
		else
			szData = szData & "|999999" & ""					' 원주문번호
			szData = szData & "|"& g_szWarningMessg & ""			' 경고메세지
			Form.OpenPopup("mbtrf31050_p6", szData , "")			' 주문확인팝업 오픈
			g_szWarningCode = ""
		end if

	' ----------------------------------------------------------------------
	' 정정
	' ----------------------------------------------------------------------	
	elseif szModCnlType == G_SCODE_MODIFY then
		szData = "2"	& szData			' 매매구분(0:매수, 1:매도, 2:정정, 3:취소))

		if #g_tModCnlTable == 0 then
			Form.ShowAlert(g_szTitle, "정정 대상이 없습니다.")
		elseif #g_tModCnlTable == 1 then
			szData = szData & "|"& g_tModCnlTable[0].OrderNo & ""	' 원주문번호
			Form.OpenPopup("mbtrf31050_p4", szData , "")			' 주문확인팝업 오픈
		elseif #g_tModCnlTable > 1 then
			szData = szData & "|999999" & ""					' 원주문번호
			Form.OpenPopup("mbtrf31050_p4", szData , "")			' 주문확인팝업 오픈
		end if

	' ----------------------------------------------------------------------
	' 취소
	' ----------------------------------------------------------------------	
	elseif szModCnlType == G_SCODE_CANCEL then		
		szData = "3"	& szData			' 매매구분(0:매수, 1:매도, 2:정정, 3:취소))
		
		if #g_tModCnlTable == 0 then
			Form.ShowAlert(g_szTitle, "취소 대상이 없습니다.")
		elseif #g_tModCnlTable == 1 then
			szData = szData & "|"& g_tModCnlTable[0].OrderNo & ""	' 원주문번호
			Form.OpenPopup("mbtrf31050_p5", szData , "")			' 주문확인팝업 오픈
		elseif #g_tModCnlTable > 1 then
			szData = szData & "|999999" & ""					' 원주문번호
			Form.OpenPopup("mbtrf31050_p5", szData , "")			' 주문확인팝업 오픈
		end if

	end if

End Function

'============================================================================
' 팝업오픈
'============================================================================
Function Open_Popup(sEventName)
	' ----------------------------------------------------------------------
	' 잔고팝업
	' ----------------------------------------------------------------------	
	if sEventName == "BALANCE_OPEN" then
		
		' 계좌번호(8), 계좌일련번호(2), 탭구분
		Form.OpenFramePopup("mbtrf31030_pb", acnt.total & "★" & acnt.sequence & "★" & "0", "")	
	' ----------------------------------------------------------------------
	' 미체결팝업
	' ----------------------------------------------------------------------	
	elseif sEventName == "CONTRACT_OPEN" then		
		
		' 계좌번호(8), 계좌일련번호(2), 탭구분
		Form.OpenFramePopup("mbtrf31030_pa", acnt.total & "★" & acnt.sequence & "★" & "0", "")
	' ----------------------------------------------------------------------
	' 기타매도
	' ----------------------------------------------------------------------	
	elseif sEventName == "OTHER_SEL_OPEN" then		
		
		if Check_Validation("1") <> false then
			Dim szParam
			szParam = g_szMarket .."★"..  g_szCode .."★"..  g_szCurrPrice .."★".. g_szHighPrice .."★".. g_szLowPrice .."★".. g_szJunPrice
			Form.OpenFramePopup("mbtrf31040_p1", szParam, "")
		end if
		
	' ----------------------------------------------------------------------
	' 기타매수
	' ----------------------------------------------------------------------	
	elseif sEventName == "OTHER_BUY_OPEN" then		
		if Check_Validation("1") <> false then
			Dim szParam
			szParam = g_szMarket .."★"..  g_szCode .."★"..  g_szCurrPrice .."★".. g_szHighPrice .."★".. g_szLowPrice .."★".. g_szJunPrice
			Form.OpenFramePopup("mbtrf31040_p2", szParam, "")
		end if
		
	End if
	
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)

	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) == 1 or Len(szQty) == 2 then
			nUnit = 1
		else
			For i = 0 to (Len(szQty)-1)-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CInt(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CInt(szQty) + nUnit
		elseif nGbn == 1 then
			if CInt(szQty) == 0 then
				Exit Function
			else
				szQty = CInt(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
	
End Function

'========================================================================================
' 호가테이블 클릭 처리
' szOrderType  : 1 매도, 2 매수
' szModCnlType : 0 매도/매수, 1 매도, 2 매수, 3 정정, 4 취소
'========================================================================================
function HogaCellClick(szOrderType, szModCnlType)

''''Form.ShowAlert(szOrderType, szModCnlType)

	' 입력값 체크
	if not Check_Validation(szModCnlType) then 
		
		BtnShow("", false)
		RefreshHogaTable()

		InitOrderVariable(); 
		return
		
	end if

	' 정정이나 취소이면 테이블 Copy
	if szModCnlType == G_SCODE_MODIFY then

		g_tModCnlTable = {}
		for i=0 to #g_tOrderTable-1
			
			'매수
			if g_tOrderTable[i].ucTradingType == szOrderType and
				g_tOrderTable[i].Price == g_szPrice 
			then
				Dim bExistOrderTable
				Dim tData()
				bExistOrderTable, tData = GetOrderTable(g_tOrderTable[i].OrderNo)
				
				if bExistOrderTable == true then
					InsertModCnlTable(tData)
				end if
			end if
		next

		BtnShow("", false)
		RefreshHogaTable()

	end if
	
	' 확인창 처리
	Confirm_Popup(szOrderType, szModCnlType)
	
End Function

'========================================================================================
' 호가테이블 클릭 처리
' szOrderType  : 주문유형(1:매도, 2:매수)
' szModCnlType : 작업유형(0:주문, 3:정정, 4:취소, 5:경고)
'========================================================================================
function HogaCellProc()

	if g_szModCnlType == G_SCODE_ORDER then			' 매도/매수

		RequestOrder(g_szOrderType)

	elseif g_szModCnlType == G_SCODE_MODIFY then		' 정정

		if #g_tModCnlTable == 0 then
			Form.ShowAlert(g_szTitle, "정정 대상이 없습니다.")
		
		elseif #g_tModCnlTable > 0 then
			RequestOrder(G_SCODE_MODIFY)
			
		end if

	elseif g_szModCnlType == G_SCODE_CANCEL then		' 취소

		if #g_tModCnlTable == 0 then
			Form.ShowAlert(g_szTitle, "취소 대상이 없습니다.")
		
		elseif #g_tModCnlTable > 0 then
			RequestOrder(G_SCODE_CANCEL)
			
		end if
		
	else
		InitOrderVariable()
		BtnShow("", false)
	end if

end Function

