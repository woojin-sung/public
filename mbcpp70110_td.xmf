--===========================================================================
--===========================================================================
Dim g_pid
Dim g_pgrade
'============================================================================
Sub Form_OnFormInitBefore()
	
	g_pid =Form.GetSharedData("Shared_PID", false )
	g_pgrade = Form.GetSharedData("Shared_GRADE", false )
	
		
	DATAMANAGER.SetDataValue(0,  "obcpp_rbit_017r", "InBlock1", "PRTF_ID", 0 , g_pid)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_017r", "InBlock1", "IQRY_CLS_CODE" , 0 , "3")
	DATAMANAGER.RequestTranData("obcpp_rbit_017r")
	
	
	DATAMANAGER.SetDataValue(0,  "obcpp_rbit_201r", "InBlock1", "INP_RISK_GRAD_CODE", 0 , g_pgrade)
	
	DATAMANAGER.RequestTranData("obcpp_rbit_201r")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	
	if szTranID = "obcpp_rbit_017r" then
	
		for i = 0 to Grid0.rowcount-1
			
		
		temp1 = Grid0.GetCellData("bd_cell8", i)
		temp1 = Cint(temp1)
		Grid0.SetCellData("bd_cell8", i, Change_to_Star(temp1))
		
		temp2 = Grid0.GetCellData("bd_cell1", i)
		Grid0.SetCellData("bd_cell1", i, Change_to_name(temp2))
		
		
	
		next
	end if 
	
	
	if szTranID = "obcpp_rbit_201r" then
	
		for i = 0 to Grid1.rowcount-1
		
			temp1 = Grid1.GetCellData("bd_cell1", i)
			Grid1.SetCellData("bd_cell1", i, Cal_grade(temp1))
		

			temp2 = Grid1.GetCellData("bd_cell3", i)
			Grid1.SetCellData("bd_cell3", i, Change_to_nation(temp2))
			
			next
		end if 
	
	
End Sub


'============================================================================
Function Change_to_nation(code)

	name =""
	if code = "1" then
			name = "국내"
	
	elseif code = "2" then
			name = "해외"
	
	else
			name = code
	
	end if

	Change_to_nation = name	

End Function

'============================================================================
Function Change_to_Star(score)

	star =""
	if score = 1 then
			star = "★☆☆☆☆"
	elseif score = 2 then
			star = "★★☆☆☆"
	
	elseif score = 3 then
			star = "★★★☆☆"
	
	elseif score = 4 then
			star = "★★★★☆"
	
	elseif score = 5 then
			star = "★★★★★"
	
	end if

	Change_to_Star = star	

End Function
'============================================================================

Function Change_to_name(ID)

	name =""
	if ID = "S119" then
			name = "이학록"
	elseif ID = "S116" then
			name = "신재영"
	
	elseif ID = "S121" then
			name = "윤형빈"
	
	elseif ID = "S118" then
			name = "이강욱"
	
	elseif ID = "S117" then
			name = "조승행"
	else 
	name = ID
	
	end if

	Change_to_name = name	

End Function

'============================================================================
	Function Cal_grade(grade)
					
			temp=""
			
			if Cint(grade)= 1  then
				temp="초저위험"
			
			elseif Cint(grade)= 2 then
				temp="초저위험+"
					
			elseif Cint(grade)= 3 then
				temp="저위험"
				
			elseif Cint(grade)= 4 then
				temp="저위험+"
				 	
			elseif Cint(grade)= 5 then
				temp="중위험"
					
			elseif Cint(grade)= 6 then
				temp="중위험+"
					
			elseif Cint(grade)= 7 then
				temp="고위험"
				 	
			elseif Cint(grade)= 8 then
				temp="고위험+"
					
			elseif Cint(grade)= 9 then
				temp="초고위험"
					
			elseif Cint(grade)=10 then
				temp="초고위험+"
			
			else  temp=grade
			
		Cal_grade= temp 	
		
			
	end if

End Function 
'============================================================================
Sub Grid1_OnClickUp(lRow, szCellID)
	
	if lRow = 0 then
		g_p_id	 =DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r", "OutBlock1", "PRTF_ID" ,0)
		g_p_grade =DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r", "OutBlock1", "INP_RISK_GRAD_CODE" ,0)
			
		Form.SetSharedData("Shared_PID",	g_p_id)
		Form.SetSharedData("Shared_GRADE",g_p_grade)
		Form.OpenFramePopup("mbcpp70110.xmf","","")
	
	elseif lRow = 1 then
		
		g_p_id	 =DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r", "OutBlock1", "PRTF_ID" ,1)
		g_p_grade =DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r", "OutBlock1", "INP_RISK_GRAD_CODE" ,1)
			
		Form.SetSharedData("Shared_PID",	g_p_id)
		Form.SetSharedData("Shared_GRADE",g_p_grade)
		Form.OpenFramePopup("mbcpp70110.xmf","","")
	
	elseif lRow = 2 then
		g_p_id	 =DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r", "OutBlock1", "PRTF_ID" ,2)
		g_p_grade =DATAMANAGER.GetDataValue(0, "obcpp_rbit_201r", "OutBlock1", "INP_RISK_GRAD_CODE" ,2)
			
		Form.SetSharedData("Shared_PID",	g_p_id)
		Form.SetSharedData("Shared_GRADE",g_p_grade)
		Form.OpenFramePopup("mbcpp70110.xmf","","")
		
	end if 
	
	
	
	
End Sub

