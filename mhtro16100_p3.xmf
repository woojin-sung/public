'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_nCount
g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	
Dim	g_nOrd_Decimal		' 가격자릿수
Dim	g_nOrd_Currency		' 통화기호

Dim g_nOrd_res_Type 		' 예약주문유형
Dim g_nOrd_res_Period		' 예약주문기간	
Dim g_nOrd_res_Time		' 예약주문시간

Dim g_OsType

'============================================================================
Sub Form_OnFormInitBefore()

	g_OsType = Form.GetSharedData("&OS_TYPE", false)

	'-----------------------------------------------------------
	' 컨트롤 설정
	'-----------------------------------------------------------
	imgInfo.setMaintainingRatio("1")
	
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	'-----------------------------------------------------------
	' 공통(일반/예약주문)
	'-----------------------------------------------------------
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
	g_nOrd_Currency		= arrData(12)	' 통화
	
	'-----------------------------------------------------------
	' 예약주문(주문유형,주문시간 문구추가)
	'-----------------------------------------------------------
	if g_nIndex == "10" then
		
		g_nOrd_res_Type 	= arrData(13) '예약주문유형
		g_nOrd_res_Period	= arrData(14) '예약주문기간
		g_nOrd_res_Time 	= arrData(15) '예약주문시간
		
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		imgInfo.left = 108
		
		if g_OsType == "1" then
			imgInfo.top = 547
		else
			imgInfo.top = 543
		end if
	
	else
	
		if g_OsType == "1" then
			imgInfo.top = 547
		else
			imgInfo.top = 544
		end if
		
	end if

	'--------------------------------------------------------------
	'데이터 세팅
	'--------------------------------------------------------------
    Set_Data(g_nIndex)
    
End Sub

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    If g_nOrd_ChkAll = "1" Then
		g_nOrd_Price = "잔량"
    End If
    
    '===========================================================
    ' 예약주문(주문유형,주문시간 문구추가)
    '===========================================================
    if nIndex == "10" then
		
		'-----------------------------------------------------------
		' 예약주문 테이블 보임처리/일반주문 테이블 숨김처리
		'-----------------------------------------------------------
		Label0.left = 85
		lblMaesu1Title.left = 180
		
		imgMain.top = 196
		imgMain.height = 541
		
		Image0.top = 290
		Image0.height = 286
		
		Label0.top = 200
		lblMaesu1Title.top = 200
		Label3.top = 260
		
		tblMaesu0.top = 310
		
		if g_OsType == "1" then
			imgInfo.top = 545
		else
			imgInfo.top = 543
		end if
		
		tblMaesu0.visible = true
		tblMaesu1.visible = false
		
		'-----------------------------------------------------------
		' 타이틀변경
		'-----------------------------------------------------------
		Label0.caption = "예약 매수"
		
		'-----------------------------------------------------------
		' 계좌번호/고객명
		'-----------------------------------------------------------
		szStr1 = left(g_szOrder_Acc,4)
		szStr2 = mid(g_szOrder_Acc,5,4)
		szStr3 = right(g_szOrder_Acc,2)
		tblMaesu0.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
				
		'-----------------------------------------------------------
		' 종목코드/종목명
		'-----------------------------------------------------------
		tblMaesu0.SetCellString( 1, 1, g_szOrd_ItmCode	)
		
		'tblMaesu0.SetCellString( 2, 1, g_szOrd_ItmName 	)
		LabelItemName.top = 355
		if g_OsType == "1" then
			LabelItemName.paddinginfo = "0,2,10,0"
		else
			LabelItemName.paddinginfo = "0,0,8,0"
		end if
		LabelItemName.maxlinecnt = "2^-8"
		LabelItemName.caption = g_szOrd_ItmName
		
		'-----------------------------------------------------------
		' 주문구분
		'-----------------------------------------------------------
		tblMaesu0.SetCellString( 3, 1, g_szOrd_OrdType 	)
		
		'-----------------------------------------------------------
		' 예약유형
		'-----------------------------------------------------------
		tblMaesu0.SetCellString( 4, 1, g_nOrd_res_Type 	)
		
		'-----------------------------------------------------------
		' 예약기간
		'-----------------------------------------------------------
		tblMaesu0.SetCellString( 5, 1, g_nOrd_res_Period	)
		
		'-----------------------------------------------------------
		' 예약시간
		'-----------------------------------------------------------
		tblMaesu0.SetCellString( 6, 1, g_nOrd_res_Time	)
		
		'-----------------------------------------------------------
		' 수량
		'-----------------------------------------------------------
		tblMaesu0.SetCellString( 7, 1, g_nOrd_Qty		)
		
		'-----------------------------------------------------------
		' 단가(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sMask = "0,0,,".. " "..g_nOrd_Currency ..",0,,"..g_nOrd_Decimal..",1,1,2,0"
		tblMaesu0.SetCellMaskInfo( 8, 1, sMask )
		tblMaesu0.SetCellString( 8, 1, g_nOrd_Price )	
		
		'-----------------------------------------------------------
		' 주문금액(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sTotalPrice = g_nOrd_Price * g_nOrd_Qty
		tblMaesu0.SetCellMaskInfo( 9, 1, sMask )
		tblMaesu0.SetCellString( 9, 1, sTotalPrice )	
    
    
    '===========================================================
    ' 일반주문
    '===========================================================
    else
		
		'-----------------------------------------------------------
		' 일반주문 테이블 보임처리/예약주문 테이블 숨김처리
		'-----------------------------------------------------------
		tblMaesu0.visible = false
		tblMaesu1.visible = true
		
		'-----------------------------------------------------------
		' 계좌번호/고객명
		'-----------------------------------------------------------
		szStr1 = left(g_szOrder_Acc,4)
		szStr2 = mid(g_szOrder_Acc,5,4)
		szStr3 = right(g_szOrder_Acc,2)
		tblMaesu1.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
		
		'-----------------------------------------------------------
		' 종목코드/종목명
		'-----------------------------------------------------------
		tblMaesu1.SetCellString( 1, 1, g_szOrd_ItmCode)
		
		'tblMaesu1.SetCellString( 2, 1, g_szOrd_ItmName)
		if g_OsType == "1" then
			LabelItemName.paddinginfo = "0,2,10,0"
		else
			LabelItemName.paddinginfo = "0,0,8,0"
		end if
		LabelItemName.maxlinecnt = "2^-8"
		LabelItemName.caption = g_szOrd_ItmName
		
		'-----------------------------------------------------------
		' 주문구분
		'-----------------------------------------------------------
		tblMaesu1.SetCellString( 3, 1, g_szOrd_OrdType)
		
		'-----------------------------------------------------------
		' 수량
		'-----------------------------------------------------------
		tblMaesu1.SetCellString( 4, 1, g_nOrd_Qty)
		
		'-----------------------------------------------------------
		' 단가(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sMask = "0,0,,".. " "..g_nOrd_Currency ..",0,,"..g_nOrd_Decimal..",1,1,2,0"
		tblMaesu1.SetCellMaskInfo( 5, 1, sMask )
		tblMaesu1.SetCellString( 5, 1, g_nOrd_Price )	
		
		'-----------------------------------------------------------
		' 주문금액(시장별 소수점처리 및 통화처리)
		'-----------------------------------------------------------
		sTotalPrice = g_nOrd_Price * g_nOrd_Qty
		tblMaesu1.SetCellMaskInfo( 6, 1, sMask )
		tblMaesu1.SetCellString( 6, 1, sTotalPrice )	
    
    end if

End Function

'============================================================================
Function SendOrder()
    
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
	    
    End If
    
End Function
'============================================================================
Sub btnMaesu1Close_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub btnMaesu1_OnClick()
	SendOrder()
End Sub
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub imgInfo_OnClick()
	sText = "수수료 및 세금이 제외된 금액입니다.\n체결 후 해외손익 화면에서 수수료 및 세금을 확인 할 수 있어요."
	imgInfo.openToolTip(sText, 300, 80, 0)
End Sub

	</SCRIPT_INFO>
</ROOT>