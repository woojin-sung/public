	<SCRIPT_INFO _len="5972" _ulen="5634" >
'***************************************************
'               전역 변수
'***************************************************
Dim gOsType
Dim gTotalRows
'***************************************************
'               공용 함수
'***************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub

'***************************************************
'               개별 함수
'***************************************************
'===============================================
' Init_Control(szCbn) 
'===============================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	'topbar 색칠
	lblTopDivider.bgcolor = 320 '#F6F7F8 (RGB 246,247,248)
	
	'imgNotice 설정
	imgNotice.setMaintainingRatio("1")
	imgNotice.imgpath = "icon_notice_3"
	
	'20240521_01 HWG START : TAX365화면 웹연동 오류 수정
	Form.SetTimerEvent2(1, 1, 0.5)
	' 데이터 가져오기
	'DATAMANAGER.RequestTranData("ooopc_rprt_002r")
	'20240521_01 HWG END
End Function
'============================================================================
'클릭하면 웹뷰 띄우기
Sub pnl0_OnClick(nIndex, sCellID)
	Form.OpenPopup("nrshidx50910_s1", pnl0.getPropCardCell("caption", "lblUrl", nIndex), "")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	gOsType = Form.GetSharedData("&OS_TYPE", false)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "ooopc_rprt_002r" Then
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_GRP_ID" 				, 0 , "bascGrp")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_ID" 					, 0 , "MoWbTaxT")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_CNTT_DIV_CODE" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_CNTT_WRTR_NAME" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_CNTT_TITL_NAME" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "STA_DATE" 				, 0 , "00000000")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "FIN_DATE" 				, 0 , "99999999")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "ooopc_rprt_002r" Then
'		들어오는 데이터 개수 설정
		gTotalRows = DATAMANAGER.GetDataCount(0, "ooopc_rprt_002r", "OutBlock1")
		
'		수신일정데이터가 0개면 없다고 표시
		If gTotalRows == 0 Then
			LabelGuideText.visible = true
			imgNotice.visible = true
			Exit Sub
		End If
		
'		마지막 줄을 제외하고 Divider 선 색칠 (238, 239, 240)
'		For i = 0 to gTotalRows - 2
'			If i <> totalrow Then
'				pnl0.setPropCardCell("bgcolor", "lblDivider", i, 90)
'			End If
'		Next

		pnl0.rowcount = gTotalRows		
'		pnl0의 모든 행 설정
		For i = 0 to gTotalRows - 1
'			Divider 선 색칠 (238, 239, 240)
			If i <> totalrow Then
				pnl0.setPropCardCell("bgcolor", "lblDivider", i, 90)
			End If
			
			pnl0.setPropCardCell("maxlinecnt", "lblTitle", i, "2^-2")
			sTitle = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TITL_NAME", i)
			
			sThumPath = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_SPLM_ITEM_VAL13", i)
			sContentsUrl = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TURN_NO", i)
			
			If sContentsUrl <> "" Then
				sContentsUrl = GetTotalUrlPath("contents", sContentsUrl)
			Else
				sContentsUrl = ""
			End If
			
			If sThumPath <> "" Then
				sThumPath = GetTotalUrlPath("image", sThumPath)
			Else
				sThumPath = ""
			End If
			
			pnl0.SetPropCardCell("caption", "lblTitle", i, sTitle)
			pnl0.SetPropCardCell("caption", "lblUrl", i, sContentsUrl)
			
			pnl0.SetPropCardCell("maintainratio", "imgThumb", i, "1")
			If gOsType == "1" Then 'Android
				pnl0.SetPropCardCell("imgurl", "imgThumb", i, sThumPath)
			Else
				pnl0.SetPropCardCell("imagetarget", "imgThumb" , i, 2)
				pnl0.SetPropCardCell("imgurl", "imgThumb" , i, sThumPath)
			End If
			
		next
	End If
End Sub

'============================================================================
' 썸네일 및 본문 URL 가져오기
'============================================================================
Function GetTotalUrlPath(sGubun,sPath)
	szMode = Form.GetSharedData("&SERVER_MODE", false) '0: 운영계, 1: 테스트계
	'-------------------------
	' 본문 링크 주소
	'-------------------------
	if sGubun = "contents" then
		if CInt(szMode) == 0 then '운영계 주소
			szUrl = "https://home.imeritz.com/bbs/mwCtn1.do?bbsId=MoWbTaxT&bbsCnttTurnNo="..Cint(sPath)	
		elseif CInt(szMode) == 1 then '테스트계 주소
			szUrl = "https://testhome.imeritz.com/bbs/mwCtn1.do?bbsId=MoWbTaxT&bbsCnttTurnNo="..Cint(sPath)
		End If
	'-------------------------
	' 썸네일 링크 주소
	'-------------------------
	Else
		if CInt(szMode) == 0 then '운영계 주소
			szUrl = "https://home.imeritz.com"..sPath
		elseif CInt(szMode) == 1 then '테스트계 주소
			szUrl = "https://testhome.imeritz.com"..sPath
		End If
	End If
	
	return szUrl
	
End Function

'20240521_01 HWG START : TAX365화면 웹연동 오류 수정	
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	
	if Cint(sTimerID) == 1 then
		DATAMANAGER.RequestTranData("ooopc_rprt_002r")
	end if
End Sub
'20240521_01 HWG END

