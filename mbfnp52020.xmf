'============================================================================
' 01.화면명  : 발행어음CMA잔고
' 02.화면설명: 발행어음CMA잔고현황 조회
' 03.작성	 : 2015.1.15
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_accNo
Dim g_asoNo
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	contTop.accCma.accproductname = ""
	
	Dim szData, szList
	szData = Form.GetOpenLinkData()
	
	if szData <> "" and szData <> "" then
		g_accNo, g_asoNo = left(szData, 8), right(szData, 2)

		DATAMANAGER.RequestTranData( "obsan_deal_232r" )
	end if
	
End Sub


'============================================================================
Sub contTop_accCma_ChangeAccount()
	grdCma.SetClear( )
	
    
    DATAMANAGER.RequestTranData( "obsan_deal_232r" )
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obsan_deal_232r" then
	   szRsv = DATAMANAGER.GetDataValue( 0 , "obsan_deal_232r", "OutBlock2", "RSEV_YN" , 0 )
	   nCnt = DATAMANAGER.GetDataCount( 0 , "obsan_deal_232r", "OutBlock2" )
	   For i = 0 to nCnt -1	    
	       Select Case szRsv
			    Case "N" 'NULL
				    grdCma.SetCellData( "bd_cell15",  i , " ")
			    Case "Y" '신청
				    grdCma.SetCellData( "bd_cell15",  i , "신청")
			    Case "R" '재발행
				    grdCma.SetCellData( "bd_cell15",  i , "재발행")
			End Select	    	    
	    Next 	   
 	end if
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obsan_deal_232r" then
	   g_accNo = contTop.accCma.total
       g_asoNo = contTop.accCma.sequence

	   DATAMANAGER.SetDataValue( 0, "obsan_deal_232r", "InBlock1", "ACNO", 0 , g_accNo )
	   DATAMANAGER.SetDataValue( 0, "obsan_deal_232r", "InBlock1", "ASNO", 0 , g_asoNo )
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		
		If sParam = "SHA_SNS" Then							' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
		
		If Trim(sParam) == "CAUTION_CALL" Then
		    Form.OpenPopup("mbfnp52020_p1.xmf" , "" , "")
		End If
	
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "snsshare" Then   ' SNS공유
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then          ' 이미지공유
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			   
			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else              ' 현재가공유
			Form.triggerEvent("linkfmHoga", "sharedata", "")   
		End If
	
	End If
 
End Sub

'============================================================================
Sub Form_OnRefresh()
	contTop_accCma_ChangeAccount()
End Sub

'============================================================================


	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obsan_deal_232r" trcode="obsan_deal_232r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obsan_deal_232r" title="CMA 잔고현황" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="126" _ulen="94" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="418" _ulen="322" >

TFAM^예수금^19^0^7^0^0^0^0
VLTN_AMT^평가금액^19^0^7^0^0^0^0
DRNG_ABLE_AMT^출금가능금액^19^0^7^0^0^0^0
CODE_NAME^코드명^200^0^0^0^0^0^0
