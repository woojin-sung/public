	<SCRIPT_INFO _len="3203" _ulen="3106" >
Dim g_CloseGB

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
	End If
	
	'바로출금서비스 약정현황 조회
	if acnt.caption <> "" and acnt.caption <> null then
		DATAMANAGER.RequestTranData( "obpds_srvc_436r" )
	end if
	
	'test
'	nCnt = 1
'	tblData.height = 30 * (nCnt + 3)
'	imgBg.height = 30 * (nCnt + 3) + 90
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'바로출금서비스 약정현황 조회
	if szTranID == "obpds_srvc_436r" then
		Dim szCustNum
		szCustNum = Form.GetSharedData("&CUST_NUM", false)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD" , 0 , "093")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'바로출금서비스 약정현황 조회
	if szTranID == "obpds_srvc_436r" then
		Dim szAcno, szAsno, szStplAmt, szHndvMthdCode
		szAcno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNO" , 0)
		szAsno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ASNO" , 0)
		szStplAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STPL_AMT" , 0)
		szHndvMthdCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "HNDV_MTHD_CODE" , 0)
		
		tblData.SetCellString(0, 1, szAcno & szAsno)
		tblData.SetCellString(1, 1, szStplAmt)
		if szHndvMthdCode == "04" then
			tblData.SetCellString(2, 1, "알림톡·문자")
		else
			tblData.SetCellString(2, 1, "이메일")
		end if
		
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
		if nCnt > 0 then
			tblData.height = 30 * (nCnt + 3)
			imgBg.height = 30 * (nCnt + 3) + 90
			
			Dim szAcno, szAsno
			for i = 0 to nCnt - 1
				szAcno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ACNO" , i)
				szAsno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ASNO" , i)
				
				tblData.SetCellString(i+3, 1, szAcno & szAsno)
			next
		end if
	end if
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_CloseGB = "1"
	'Form.SendReturnToParent("mbonl88032_p3" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub btnMove_OnClick()
	g_CloseGB = "2"
	Form.CloseForm()
	'Form.OpenScreen("63010" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
'	if g_CloseGB == "2" then
'		Form.OpenScreen("63010" , "")
'	end if

	Form.SendReturnToParent("mbonl88032_p3" , g_CloseGB)
End Sub

