	<SCRIPT_INFO _len="8309" _ulen="7625" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szSavePwd
dim g_sPlain_rm
dim g_pros_cls_code

'============================================================================
Sub Form_OnFormInit()
	f_InitUI()
	btnPwd.bringfront("1")
End Sub

'============================================================================
Sub btnPwd_OnClick()
	ChkButton0.checkstate = "0" 
	ChkButton0.visible = true
	ChkButton0.enable = false
	btnChange.enable = false
	
	if cmbAccount.caption = null or cmbAccount.caption = "" then
		Form.ShowAlert("알림", "선택할 수 있는 계좌가 없습니다.")
		Exit Sub
	end if
	
	Form.openPopupAnimation("pwdcheckpopup",cmbAccount.caption,"","2")
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	f_InitUI()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				edtPassword_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPassword.caption = ""
			else
				szCurAcc = cmbAccount.caption
				nCnt = Cint(cmbAccount.accountcount)
				
				For i = 0 to nCnt - 1
					szCompAcc = cmbAccount.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						cmbAccount.currentindex = i
						Exit For
					end if
				Next
				
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if
	end if
End Sub

'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Sub f_InitUI()
	Label1.caption = ""
	ChkButton0.checkstate = "0" 
	ChkButton0.visible = true
	ChkButton0.enable = false
	btnChange.enable = false
	
	if cmbAccount.caption <> null and cmbAccount.caption <> "" and edtPassword.caption <> null and edtPassword.caption <> "" then
		DATAMANAGER.RequestTranData("obtre_acnt_101r") '해외CFD 안심 계좌 동의 여부 조회, 외화자동매수 신청 여부 조회
	end if
End Sub

Sub edtPassword_OnEditComplete()
        f_InitUI()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_sPlain_rm = Form.GetSharedData("&PLAIN_RM" , false) '암호화 여부
	dim szPwd
	szPwd = ""
	'패스워드 암호화여부
	If g_sPlain_rm = "1" Then
		szPwd = edtPassword.caption
	Else
		szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If
	
	if szTranID == "obtre_acnt_101r" then  '해외CFD 안심 계좌 동의 여부 조회, 외화자동매수 신청 여부 조회

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)

	elseif szTranID == "obtre_acnt_105a" then ' 해외CFD 안심계좌 외화자동매수 신청/해지

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
		
		if g_pros_cls_code == "U" then       '등록
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , g_pros_cls_code)
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FRCR_ATBY_APLT_YN" , 0 , "Y")
		elseif g_pros_cls_code == "D" then '해지
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , g_pros_cls_code)
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FRCR_ATBY_APLT_YN" , 0 , "N")
                end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtre_acnt_101r" then  '해외CFD 안심 계좌 동의 여부 조회, 외화자동매수 신청 여부 조회
	
		if DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FRCR_ATBY_APLT_YN" , 0 ) = "Y" then
		    Label1.caption = "등록"
		    btnChange.caption = "해지"
		    g_pros_cls_code = "D"
		    ChkButton0.visible = false
		    ChkButton0.enable = false
		    btnChange.enable = cmbAccount.caption <> null and cmbAccount.caption <> "" and edtPassword.caption <> null and edtPassword.caption <> ""
		else 
		    Label1.caption = "미등록"
		    btnChange.caption = "등록"
		    g_pros_cls_code = "U"
		    ChkButton0.visible = true
		    ChkButton0.enable = cmbAccount.caption <> null and cmbAccount.caption <> "" and edtPassword.caption <> null and edtPassword.caption <> ""
	        end if
		
	elseif szTranID == "obtre_acnt_105a" then ' 해외CFD 안심계좌 외화자동매수 신청/해지

                if g_pros_cls_code == "U" then       '등록
		    Form.ShowAlert( "알림" , "해외CFD 안심계좌\n외화자동매수 신청 완료되었습니다.")
		    f_InitUI()
		elseif g_pros_cls_code == "D" then '해지
		    Form.ShowAlert( "알림" , "해외CFD 안심계좌\n외화자동매수 해지 완료되었습니다.")
		    f_InitUI()
                end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null or Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrMsg)
	end if
End Sub

'============================================================================
Sub btnChange_OnClick()

	if edtPassword.caption = "" or edtPassword.caption == null then
		Form.MsgBox("알림", "비밀번호를 입력해주세요.", "", 0)
		Exit Sub
	end if
	
	If Label1.caption == "" Then
	        Form.ShowAlert( "알림" , "신청 상태를 먼저 조회해 주세요.")
                Exit Sub
	End If

        if g_pros_cls_code == "U" then       '등록
	    If ChkButton0.checkstate == "0" Then
	            Form.ShowAlert( "알림" , "유의사항 내용을 확인 바랍니다.")
                    Exit Sub
	    End If	
	End If
	
        if g_pros_cls_code == "U" then       '등록
	    Form.MsgBox("알림", "해외CFD 안심계좌\n외화자동매수 신청하시겠습니까?", "BTN_CHANGE_GROUP", 1)
	elseif g_pros_cls_code == "D" then '해지
	    Form.MsgBox("알림", "해외CFD 안심계좌\n외화자동매수 해지하시겠습니까?", "BTN_CHANGE_GROUP", 1)
        end if

End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)

        if g_pros_cls_code == "U" then       '등록
	    if Cint(sCheckState) = 0 then
		btnChange.enable = false
	    else
		btnChange.enable = cmbAccount.caption <> null and cmbAccount.caption <> "" and edtPassword.caption <> null and edtPassword.caption <> ""
	    end if
	End If

End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "BTN_CHANGE_GROUP" then	
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData("obtre_acnt_105a") '해외CFD 안심계좌 외화자동매수 신청/해지
		End If
	end if
End Sub

	</SCRIPT_INFO>
