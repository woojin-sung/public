			<TRAN tranid="obtre_acnt_105a" trcode="obtre_acnt_105a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtre_acnt_101r" title="해외CFD_계좌 안심동의 여부 조?" realdata="0" dessvr="9" >
