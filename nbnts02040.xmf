'============================================================================
' 펀드코드 돋보기 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "FUNDINFO" then
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
		end if 
	end if
	
	
End Sub
'============================================================================
' 초기화
'============================================================================
Sub btnErase_OnClick()
	
	CalStaDate.caption = Form.GetSharedData("&HOST_DATE", false )
	CalFinDate.caption = Form.GetSharedData("&HOST_DATE", false )
	CmbOvrs.caption = "전체"
	CmbOvrs.cbkeydata = "%"
	CmbExch.caption = "전체"
	CmbExch.cbkeydata = "%"
	
	'20210713 SWJ START : 스크립트 오류 수정
	edtFundCd.caption = ""
	'20210713 SWJ END
	
	DATAMANAGER.RequestTranData("obtro_oder_306r")
End Sub
