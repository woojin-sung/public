		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "OVRS_STCK_EXCH_IDNO"		 , 0 , CmbExch.cbkeydata )
		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "ISCD"					 , 0 , "%")
		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "OVRS_STCK_PROD_TR_CLS_CODE", 0 , "%")
