		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "FNCD"					 , 0 , edtFundCd.caption)
		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "CRCD"					 , 0 , "%" )
