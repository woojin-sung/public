'===========================================================================
' 2024.03.20 : 장시방 : v001 : 스위스 시장코드, 내부거래소코드 추가
'===========================================================================
Dim g_szItemCode '종목코드
Dim g_szQty '청산가능수량
Dim g_szFncd
Dim g_szACNO
Dim g_szASNO
'============================================================================
Sub Form_OnFormInitBefore()
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	g_szFncd = edtFundCd.caption
End Sub
'============================================================================
Sub Form_OnFormInit()
	
	If len(trim(g_szFncd)) > 0 Then
		DATAMANAGER.RequestTranData( "obtro_oder_306r" )
	End If
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obtro_oder_306r" then 
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		
		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "STA_DATE"				 , 0 , CalStaDate.caption)
		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "FIN_DATE"				 , 0 , CalFinDate.caption)
		DATAMANAGER.SetDataValue( false, "obtro_oder_306r", "InBlock1", "PROD_PSTN_CLS_CODE"		 , 0 , "%")
