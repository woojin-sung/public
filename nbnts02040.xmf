End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obtro_oder_306r" then
		Dim nCount, nIndex
		
		nCount = DATAMANAGER.GetDataCount( false, "obtro_oder_306r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount step 1
				dim szSide, szOvrs
				
				szSide	= DATAMANAGER.GetDataValue( false, "obtro_oder_306r", "OutBlock1", "OVRS_STCK_PROD_TR_CLS_CODE"	, i ) '매매구분
				szOvrs 	= DATAMANAGER.GetDataValue( false, "obtro_oder_306r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"	, i ) '시장
				
				'매매 구분				
				if szSide = "01" then
					grdData.SetCellData("side", nIndex+i, "On 매도")
					grdData.SetCellFgColor("side", nIndex+i, "2")
				elseif szSide = "02" then
					grdData.SetCellData("side", nIndex+i, "On 매수")
					grdData.SetCellFgColor("side", nIndex+i, "1")
				elseif szSide = "03" then
					grdData.SetCellData("side", nIndex+i, "Off 매도")
					grdData.SetCellFgColor("side", nIndex+i, "2")
				elseif szSide = "04" then
					grdData.SetCellData("side", nIndex+i, "Off 매수")
					grdData.SetCellFgColor("side", nIndex+i, "1")
				end if				
				
				'시장 구분
				if szOvrs = "01" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "미국")
				elseif szOvrs = "02" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "홍콩")
				elseif szOvrs = "03" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "중국")
				elseif szOvrs = "04" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "중국")
				elseif szOvrs = "05" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "일본")
				elseif szOvrs = "07" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "싱가포르")
				elseif szOvrs = "08" then '2020.11.05 유로국가 추가
					grdData.SetCellData("ovrsmrkt", nIndex+i, "영국")			
				elseif szOvrs = "09" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "영국")			
				elseif szOvrs = "10" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "독일")			
				elseif szOvrs = "11" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "핀란드")
				elseif szOvrs = "12" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "프랑스")			
				elseif szOvrs = "13" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "벨기에")			
				elseif szOvrs = "14" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "네덜란드")
				elseif szOvrs = "15" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "포르투갈")
				elseif szOvrs = "16" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "그리스")
				elseif szOvrs = "17" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "아일랜드")
				elseif szOvrs = "18" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "이탈리아")
				elseif szOvrs = "19" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "스페인")			
				elseif szOvrs = "20" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "오스트리아")					
				elseif szOvrs = "21" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "캐나다")
				elseif szOvrs = "23" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "인도네시아")
				elseif szOvrs = "24" then '2020.11.26 베트남 추가
					grdData.SetCellData("ovrsmrkt", nIndex+i, "베트남")				
				elseif szOvrs = "25" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "베트남")
				elseif szOvrs = "26" then
					grdData.SetCellData("ovrsmrkt", nIndex+i, "스위스") 'v001	
				else
				end if
				
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
'	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		
'	if Trim(szSubMsg) <> "" then
'		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
'	else
'		Form.ShowAlert("알림", szErrMsg)
'	end if

	if szTranID == "obtro_oder_306r" then
		'데이터 없음
		if szErrCode = "5820" then
			grdData.SetClear()
		end if
		Form.SetTimerEvent(0, 0, 5)
	end if
End Sub


