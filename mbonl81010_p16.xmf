'============================================================================
' 01.화면명 	: 제공방싱선택 공통팝업
' 02.화면설명	: 제공방싱선택 공통팝업
' 03.작성	: 2022.03.16 
' 04.수정	: 2022.03.23 : KSJ : v0001 : 선택한 제공방식 타입 SharedData 저장 (펀드매매>신규매수에서 사용)
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Dim gAcno
Dim gFnprJoinSrno
Dim strInagTypeCode2
Dim strInagTypeCode3
Dim strInagSrno2
Dim strInagSrno3
Dim strAddr 
Dim strCustTelno
Dim gLoanYN
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	szLinkedData = Form.GetOpenLinkData( )

	'계좌번호 금융상품가입일련번호 
	g_szList = Split(szLinkedData,"★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
		
	gAcno          = ""
	gFnprJoinSrno  = ""
	gLoanYN		 = ""
	
     gAcno          = g_szList(0)
	gFnprJoinSrno  = g_szList(1)
	gLoanYN        = Form.GetSharedData("mbonl81010_p16_LOAN_YN", TRUE )
	
	DATAMANAGER.SetDataValue( 0 , "obcsb_acif_140r", "InBlock1", "ACNO" , 0 , gAcno)
	DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	
End Sub

'============================================================================
' imgClose_OnClick() : 화면 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("ok_mbonl81010_p16" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub btn1_OnClick()
	If RadioGroup0.currentindex == "-1" or RadioGroup0.currentindex == -1 Then 
		Form.ShowAlert( "알림", "서류제공방식을 확인하세요.")
		Exit Sub
	End If 
	
	If RadioGroup0.currentindex == "0" or RadioGroup0.currentindex == 0 Then  '알림톡/문자
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , Edit6.Caption)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , Edit5.Caption)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , Edit0.Caption)
	Else                                                                       '이메일
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , Edit3.Caption)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , Edit4.Caption)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , Edit1.Caption)
	End If 
	
	DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , gFnprJoinSrno)
	DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	DATAMANAGER.RequestTranData( "obcsb_acad_122a" )		
	
End Sub

'============================================================================
Sub btn0_OnClick()
	Form.SendReturnToParent("ok_mbonl81010_p16" , "")
	Form.CloseForm()	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, iCnt1
	If szTranID == "obcsb_acif_140r" then
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
				    Edit1.Caption = strAddr
				    Edit3.Caption = strInagTypeCode2
				    Edit4.Caption = strInagSrno2
			    End If
			Next 	
			
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    Edit0.Caption = strCustTelno
				    Edit6.Caption = strInagTypeCode3
				    Edit5.Caption = strInagSrno3
			    End If
			Next 
			
		End If 
     ElseIf szTranID == "obcsb_acad_122a" then
	     'v0001 sta
		If RadioGroup0.currentindex == "0" or RadioGroup0.currentindex == 0 Then  '알림톡/문자	
			Form.SetSharedData( "MBONL81010_P16_SELECT", Edit6.Caption ) 
		Else                                                                       '이메일
			Form.SetSharedData( "MBONL81010_P16_SELECT", Edit3.Caption	)
		End If 		
		'v0001 fin
	     if gLoanYN ~= "Y" then
		     Form.ShowAlert( "알림", "처리완료되었습니다.")
	     end if
	     
		Form.SendReturnToParent("ok_mbonl81010_p16" , "OK")
		Form.CloseForm()	   
	End If 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obcsb_acad_122a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_acad_122a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")	
	elseif szTranID == "obcsb_acif_140r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_acif_140r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")	
	end if
End Sub 
