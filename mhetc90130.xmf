'============================================================================
'블록체인 공동인증 메인트리거
'============================================================================
Sub Form_OnTriggerEventKofia(sEventName, sParam)

	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	
	if #sRet > 2 then
		sErrorCode = sRet[0]
		sErrorMsg = sRet[1]
		sOutput = Form.KBase64Decoding(sRet[2])
	else
		exit sub
	end if
	
	'공동앱 앱버전 체크
	if sEventName == "MAIN_BCHAIN_103" and sErrorCode <> "1000" then
		sRet = Split(sOutput, "★")
		g_sAppVersion		= sRet[3]
		
		nServerVer = 0
		sServerVer = split(g_sMinVersion, ".")
			
		nClientVer = 0
		sClientVer = split(g_sAppVersion, ".")
			
		if #sServerVer >= 3 and #sClientVer >= 3 then
			nServerVer = sServerVer[0]*100000 + sServerVer[1]*1000 + sServerVer[2]*10
			nClientVer = sClientVer[0]*100000 + sClientVer[1]*1000 + sClientVer[2]*10
		end if
		
		'---현재버전이 최소버전보다 낮을 경우 반드시 업데이트----
		if CLng(nClientVer) < CLng(nServerVer) then
			Form.MsgBox( "알림", "금융투자협회 공동앱 업데이트를 진행합니다.", "BCHAIN_UPDATE", 1 )
			exit sub
		end if
		
		if g_sType == "bc_mod" then
			'인증서 관리 본인확인 
			Form.OpenFramePopup("mhetc90130_p2", "bc_mod", "")
			exit sub
		end if
	end if
	
	if sErrorCode == "0000" then
			
		'---------------------------------------------------------------
		'인증서 등록 응답 : BCHAIN_101 -> 인증서발급요청 -> BCHAIN_102 -> 인증서상태변경요청(VALID) -> 완료
		if sEventName == "MAIN_BCHAIN_101" then 
		
			'인증서발급요청
			'sOutput => sAlias★sDn★sSignature(CSR:인증서발급요청문)
			Request_obcsb_padc_020a("N", "2", sOutput) 
	
		'---------------------------------------------------------------
		'인증서 저장 응답
		elseif sEventName == "MAIN_BCHAIN_102" then 					
		
			'인증서상태변경요청(VALID)
			'sOutput => sAlias★sDn★sResponse(미사용)
			Request_obcsb_padc_020a("M", "1", sOutput) 
		
		'---------------------------------------------------------------
		'인증서 정보 응답 : BCHAIN_103 -> 완료
		elseif sEventName == "MAIN_BCHAIN_103" then 	
		
			sRet = Split(sOutput, "★")
			g_sKofiaAlias		= sRet[0]
			g_sKofiaDN		= sRet[1]
			g_sExpiredDate 	= sRet[2]
			g_sAppVersion		= sRet[3]
			
			'등록/재등록 시, 단말에 인증서 있는경우
			if g_sType = "bc_new" then
				sText = "휴대폰에 이미 '" &  g_sKofiaAlias & "' (으)로 공동인증이 등록되어 있습니다.\n기존 등록된 내용을 삭제하고 신규등록을 진행 하시겠습니까?"
				Form.MsgBox( "알림", sText , "REGISTER_MSG1", 1 )
				
			elseif g_sType = "bc_renewal" then
				'인증서갱신요청
				nCurDate = Form.GetSharedData("&HOST_DATE", false)
				
				ReExpiredDate = left(g_sExpiredDate,4)&"-"&mid(g_sExpiredDate,5,2)&"-"&right(g_sExpiredDate,2)
				ReCurDate = left(nCurDate,4)&"-"&mid(nCurDate,5,2)&"-"&right(nCurDate,2)

				If DateDiff("d",ReCurDate,ReExpiredDate) <= 30 Then '만료 30일전부터 안내
					sText = "'" &  g_sKofiaAlias & "' 공동인증 갱신을 진행합니다. 갱신을 진행하시면 기존 등록된 공동인증은 자동으로 해지됩니다.\n기존 등록된 내용을 삭제하고 갱신을 진행 하시겠습니까?"
					Form.MsgBox( "알림", sText , "RENEWAL_MSG1", 1 )
					
				else
					sText = "인증기간 갱신은 만료 30일전부터 가능합니다."
					Form.MsgBox( "알림", sText , "", 0 )
				End if
			end if
		'---------------------------------------------------------------
		'인증서 해지 : BCHAIN_104 -> 완료			
		elseif sEventName == "MAIN_BCHAIN_104" then
			'해지완료 -> 인증서 등록(재등록)
			Request_obcsb_padc_020a("N", "1", "") 
			
		'---------------------------------------------------------------
		'인증서 갱신 : BCHAIN_105 -> 완료			
		elseif sEventName == "MAIN_BCHAIN_105" then
			'인증서갱신요청
			'sOutput => sAlias★sDn★sSignature(CSR:인증서발급요청문)
			Request_obcsb_padc_020a("R", "1", sOutput)
				
		end if 'sEventName 분기처리 if문 END
	else
		'---------------------------------------------------------------
		if instr(sEventName, "MAIN_") > 0 Then
			if sErrorCode == "2002" then
				'등록/재등록 시, 단말에 인증서 없는경우
				if g_sType == "bc_new" then
					g_bReRegister = False '공동인증서 등록
					Form.OpenFramePopup("mhetc90130_p2", "bc_new", "")
				
				elseif g_sType == "bc_renewal" then
					sText = "등록된 공동인증이 없습니다. 공동인증 등록을 진행해주세요"
				
					Form.MsgBox( "알림", sText , "", 1 )
				end if
			
			'---------------------------------------------------------------
			elseif sErrorCode == "6002" then
			
				'사용자취소 메시지박스 처리 안함
			
			'---------------------------------------------------------------
			'비밀번호 5회오류 : 6001오류수신 -> 인증서정지요청 -> 완료
			elseif sErrorCode == "6001" then
			
			'인증서정지요청(SUSPENSION)
			'sOutput => sAlias★sDn★sResponse(미사용)
			Request_obcsb_padc_020a("M", "2", sOutput) 'SUSPENSION
			
			'---------------------------------------------------------------
			else
				ShowAlertErrorMsg(sErrorCode)
			end if
		end if
	end if
	
End Sub

'============================================================================
'본인확인 정상처리 여부확인 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "bc_register" then
		sParam = Split(sRet, "★")
		state 	 	= sParam(0) 	'[처리상태] ok:완료 error: 오류
		g_sUserID 	= sParam(1) 	'사용자 아이디
		
		if state == "ok" then 
			'재등록 시, 기존 인증서 해지후 등록
			if g_bReRegister == True then
				Request_obcsb_padc_020a("M", "3", g_sKofiaAlias & "★" & g_sKofiaDN)
			else
				Request_obcsb_padc_020a("N", "1", "")
			end if
			
		elseif state =="error" then		
			Form.ShowAlert("", "인증실패")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'=======================================================================================================
	'블록체인 공동인증	
	'=======================================================================================================

	if szTranID == "obcsb_padc_020a" then
	
		ERR_NO 				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_NO" 				,0) '에러번호
		ERR_INFO 			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_INFO" 			,0) '에러정보
		RSLT_INFO  			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "RSLT_INFO" 			,0) '결과정보
		DN_DATA   			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_DATA" 				,0) 'DN데이터
		UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_SNTN" 		,0) '공동인증서문장
		DN_BYNM				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_BYNM" 				,0) 'DN별칭
		UNIN_NTAT_STAT_CNTT 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_STAT_CNTT" 	,0) '공동인증서상태내용

		if CInt(ERR_NO) <> 0 then '정상
			if CInt(ERR_NO) == 2011 then
				Form.MsgBox( "알림", "[TR]" & RSLT_INFO & "(" & ERR_INFO & ")", "", 0 )
				exit sub
			end if
		end if
		
		g_sKofiaDN = DN_DATA
				
		'DN조회응답
		if g_sStage020 = "N1" then
			if g_sType == "bc_new" then
				Request_obcsb_padc_021r("S", "1", DN_DATA) '공동인증 Alias List조회
			end if
			
		'인증서발급요청응답
		elseif g_sStage020 = "N2" then
			'params => Alias★Certificate(인증서)
			Form.requestKofiaAuth("BCHAIN_102", DN_BYNM & "★" & UNIN_NTAT_SNTN, "MAIN") 
			
		'인증서갱신요청응답
		elseif g_sStage020 = "R1" then
			'params => Alias★Certificate(인증서)
			Form.requestKofiaAuth("BCHAIN_102", DN_BYNM & "★" & UNIN_NTAT_SNTN, "MAIN")
		
		'인증서상태변경요청(VALID)
		elseif g_sStage020 = "M1" then
			Form.MsgBox( "알림", "공동인증 등록이 완료되었습니다.", "", 0 )
			
		'인증서상태변경요청(SUSPENSION)
		elseif g_sStage020 = "M2" then
			Form.MsgBox( "알림", "인증 비밀번호 오류 횟수(5회)를 초과하였습니다. 인증 재등록이 필요합니다.", "", 0 )
		
		'인증서해지요청(REVOKE)
		elseif g_sStage020 = "M3" then
			'공동인증서 재등록시, 기존 인증서 해지 후 등록요청을 진행
			'params => Alias★Dn
			Form.requestKofiaAuth("BCHAIN_104", DN_BYNM & "★" & DN_DATA, "MAIN")	
		end if
	'else '오류
		
			'RSLT_INFO : 기간계 정의 메시지
			'ERR_INFO : 금투협 블록체인 정의 메시지
		'	Form.MsgBox( "알림", "[TR]" & RSLT_INFO & "(" & ERR_INFO & ")", "", 0 )
	
		'end if
		
	elseif szTranID == "obcsb_padc_021r" then
		ERR_NO 				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_NO" 				,0) '에러번호
		ERR_INFO 			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_INFO" 			,0) '에러정보
		RSLT_INFO  			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "RSLT_INFO" 			,0) '결과정보
		UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_SNTN" 		,0) '공동인증서문장
		UNIN_NTAT_STAT_CNTT 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_STAT_CNTT" 	,0) '공동인증서상태내용
		DN_DATA			 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_DATA" 				,0) 'DN데이터
		UI_ABRV_SGNT_OPBL_KEY	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UI_ABRV_SGNT_OPBL_KEY" 	,0) '축약서명공개키
		UI_ELCT_SGNT_DATA_CNTT	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UI_ELCT_SGNT_DATA_CNTT" ,0) '전자서명데이터
		DN_BYNM			 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_BYNM" 				,0) 'Alias
		MTRT_DATE		 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "MTRT_DATE" 			,0) '만기일자
		
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
		
		if CInt(ERR_NO) <> 0 then '정상
			if CInt(ERR_NO) <> 2001 then
				Form.MsgBox( "알림", "[TR]" & ERR_NO & " | " & RSLT_INFO & "(" & ERR_INFO & ")", "", 0 )
				exit Sub
			end if
		end if
			
		'Alias List조회응답
		if g_sStage021 = "S1" then 
			g_sKofiaAliasList = ""
					' [참고]
			' ISSUE      : 인증서가 발급된 상태(유효한 상태는 아님)
			' VALID      : 유효한 상태(발급 후 공동인증 앱에 저장이 완료된 이후)
			' SUSPENSION : 효력정지 상태(공동인증앱 인증 5회 실패 시)
			' REVOKE     : 인증서가 폐기된 상태(인증서 해지 신청 시)
			For i = 0 to nCnt -1 
				UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "UNIN_NTAT_SNTN" 		,i) '공동인증서문장
				DN_BYNM				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "DN_BYNM" 				,i) 'DN별칭
				UNIN_NTAT_STAT_CNTT	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "UNIN_NTAT_STAT_CNTT"	,i) '공동인증서상태		
				
				'등록 시, 인증서상태를 보고 공동앱에 Alias List 넘기자
				if UNIN_NTAT_STAT_CNTT == "VALID" or UNIN_NTAT_STAT_CNTT == "ISSUE" then
				
					if Len(g_sKofiaAliasList) == 0 then
						g_sKofiaAliasList = DN_BYNM & "▣" & UNIN_NTAT_STAT_CNTT
					else
						g_sKofiaAliasList = g_sKofiaAliasList &  "★" & DN_BYNM & "▣" & UNIN_NTAT_STAT_CNTT
					end if
					
				end if		
			Next
				
			'공동인증 등록/재등록
			if g_sType = "bc_new" then
				Form.requestKofiaAuth("BCHAIN_101", g_sKofiaDN & "★" & g_sKofiaAliasList, "MAIN")
			end if
				
		elseif g_sStage021 == "V1" then
			'공동앱 최소버전
			g_sMinVersion = DATAMANAGER.GetDataValue(0, "obcsb_padc_021r", "OutBlock1", "VRSN_ID" , 0)
				
			Form.requestKofiaAuth("BCHAIN_103", "", "MAIN")
		end if
	end if
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID == "obcsb_padc_020a" then
		if szErrCode == "5806" then
			if g_sType = "bc_new" then
				Request_obcsb_padc_020a("N", "1", "")
				exit sub
			end if
		end if
	end if
	
	sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if Len(sSubMsg) > 1 then
		Form.MsgBox( "알림", "[TR]" & szErrMsg & "\n" & "(" & sSubMsg & ")", "BCHAIN", 0 )
	else
		Form.MsgBox( "알림", "[TR]" & szErrMsg , "BCHAIN", 0 )
	end if

End Sub


'============================================================================
Sub ShowAlertErrorMsg(sErrorCode)	'연계앱 오류시 오류 메시지박스

	sErrorMsg =""

	Select Case sErrorCode
		Case "1000"
		sErrorMsg = "공동인증 앱(CHAIN-ID)와 연결에 실패하였습니다.\n다시 시도해주시기 바랍니다."
		Case "1001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKeyStore/KeyChain 접근 실패"
		Case "1002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKey 생성 실패"
		Case "1003"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKey 저장 실패"
		Case "1004"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKey 불러오기 실패"
		Case "2001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 저장 실패"
		Case "2002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서를 찾을 수 없음"
		Case "2003"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 기한 만료"
		Case "2004"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n일치하는 인증서 없음"
		Case "2005"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 삭제 실패"
		Case "2006"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 정보 변경 실패"
		Case "3001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nBase64 encoding 실패"
		Case "3002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nJSON 데이터 생성 실패"
		Case "3003"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nBase64 decoding 실패"
		Case "3004"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nJSON 데이터 파싱 실패"
		Case "3101"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nParameter 부족"
		Case "4001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nInvalid Key"
		Case "4101"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n암호화 실패"
		Case "4201"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n복호화 실패"
		Case "5001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nSign 실패"
		Case "5002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 생성 실패"
		Case "6001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n비밀번호 5회 오류"
		Case "6002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n사용자 취소"
		Case "9999"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n알 수 없는 오류"
		
	End Select
	
	if Len(sErrorMsg) > 0 then
		Form.MsgBox("알림", sErrorMsg, "", 0)
	end if
	
End Sub

