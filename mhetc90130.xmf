	<SCRIPT_INFO _len="34906" _ulen="29632" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 블록체인 공동인증 메인
' 02. 화면설명 : 블록체인 공동인증 메인
' 03. 작    성 : 2017.07.11  HAMWG
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sUserID			'사용자 ID
Dim g_sType			'서비스 타입

Dim g_sKofiaDN		'변경대상 인증서DN
Dim g_sKofiaAlias		'현재단말 Alias
Dim g_sKofiaAliasList	'현재까지 발급받은 alias list (Alias1▣상태1★Alias2▣상태2★Alias3▣상태3 ...)
Dim g_sExpiredDate	'공동인증서 만기일자
Dim g_sAppVersion		'공동앱 앱버전
Dim g_sMinVersion		'공동앱 최소버전

Dim g_bReRegister		'인증서 재등록여부

Dim g_sReturn			'공동인증 팝업 리턴값

Dim g_sStage020		'obcsb_padc_020a 세부단계
Dim g_sStage021		'obcsb_padc_021r 세부단계

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Sub Request_obcsb_padc_020a(sPros, sStage, sOutput)
	szTranID = "obcsb_padc_020a"	
	
	UNIN_ATHN_PROS_CLCD 		= "" '공동인증처리구분코드
	UNIN_ATHN_PRGS_STAG_CODE	= "" '공동인증진행단계코드
	ELFN_ID					= "" '전자금융ID
	RCNO_PIP					= "" '실명확인번호PIP
	ACNO						= "" '계좌번호
	ACNT_PWD					= "" '계좌비밀번호
	DN_DATA					= "" 'DN데이터
	UNIN_NTAT_RQST_SNTN		= "" '공동인증서요청문장
	DN_BYNM					= "" 'DN별칭
	UNIN_NTAT_STAT_CNTT		= "" '공동인증서상태내용
	UNIN_NTAT_SNTN			= "" '공동인증서문장
	IPAD						= "" 'IP주소
	PORT_NO					= "" '포트번호
	RCNO						= "" '실명확인번호
	TERM_ID					= "" '단말ID
	
	g_sStage020 = sPros & sStage
	
	'공통
	UNIN_ATHN_PROS_CLCD		= sPros
	UNIN_ATHN_PRGS_STAG_CODE	= sStage
	ELFN_ID					= g_sUserID 
	TERM_ID					= Form.GetDeviceID()
	
	'---------------------------------------------------------------
	'DN조회
	if sPros == "N" and sStage == "1" then
		g_sKofiaDN 				= ""

	'---------------------------------------------------------------
	'인증서발급요청
	elseif sPros == "N" and sStage == "2" then
	
		'sOutput => sAlias★sDn★sSignature(CSR:인증서발급요청문)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 3 then
			DN_BYNM 				= sParam[0]
			DN_DATA 				= sParam[1]
			UNIN_NTAT_RQST_SNTN 	= sParam[2]
		end if	

	'---------------------------------------------------------------
	'인증서갱신요청
	elseif sPros == "R" and sStage == "1" then
	
		'sOutput => sAlias★sDn★sSignature(CSR:인증서발급요청문)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 3 then
			DN_BYNM 				= sParam[0]
			DN_DATA 				= sParam[1]
			UNIN_NTAT_RQST_SNTN 	= sParam[2]
		end if	

	'---------------------------------------------------------------
	'인증서상태변경요청
	elseif sPros == "M" and sStage == "1" then
			
		UNIN_ATHN_PRGS_STAG_CODE	= ""
		UNIN_NTAT_STAT_CNTT		= "VALID"	
	
		'sOutput => sAlias★sDn★sResponse(미사용)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 2 then
			DN_BYNM 				= sParam[0]
			DN_DATA 				= sParam[1]
		end if		

	'---------------------------------------------------------------
	'인증서정지(5회오류시)
	elseif sPros == "M" and sStage == "2" then
	
		UNIN_ATHN_PRGS_STAG_CODE	= ""
		UNIN_NTAT_STAT_CNTT		= "SUSPENSION"
		
		'sOutput => sAlias★sDn★sResponse(미사용)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 2 then
			DN_BYNM = sParam[0]
			DN_DATA = sParam[1]
		end if	
		
	'---------------------------------------------------------------
	'인증서해지 (재등록 시, 기존인증서 해지)
	elseif sPros == "M" and sStage == "3" then
	
		UNIN_ATHN_PRGS_STAG_CODE	= ""
		UNIN_NTAT_STAT_CNTT		= "REVOKE"
		
		'sOutput => sAlias★sDn★sResponse(미사용)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 2 then
			DN_BYNM = sParam[0]
			DN_DATA = sParam[1]
		end if		
		
	'---------------------------------------------------------------
	else
		Form.MsgBox( "알림", "공동인증 관리서비스 입력값이 존재하지 않습니다.", "", 0 )
		exit sub
	end if

	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_ATHN_PROS_CLCD"		, 0 , UNIN_ATHN_PROS_CLCD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_ATHN_PRGS_STAG_CODE"	, 0 , UNIN_ATHN_PRGS_STAG_CODE)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID"					, 0 , ELFN_ID)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO_PIP"					, 0 , RCNO_PIP)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"						, 0 , ACNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"					, 0 , ACNT_PWD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_DATA"					, 0 , DN_DATA)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_RQST_SNTN"		, 0 , UNIN_NTAT_RQST_SNTN)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_BYNM"					, 0 , DN_BYNM)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_STAT_CNTT"		, 0 , UNIN_NTAT_STAT_CNTT)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_SNTN"				, 0 , UNIN_NTAT_SNTN)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IPAD"						, 0 , IPAD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PORT_NO"					, 0 , PORT_NO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO"						, 0 , RCNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TERM_ID"					, 0 , TERM_ID)
	
	DATAMANAGER.RequestTranData( szTranID )
End Sub

'============================================================================
Sub Request_obcsb_padc_021r(sPros, sStage, sOutput)			
	szTranID = "obcsb_padc_021r"
	
	UNIN_ATHN_PROS_CLCD 	= "" '공동인증처리구분코드
	UNIN_NTAT_SNTN		= "" '공동인증서문장
	ELFN_ID				= "" '전자금융ID
	ACNO					= "" '계좌번호
	DN_DATA				= "" 'DN데이터
	RCNO					= "" '실명확인번호
	TERM_ID				= "" '단말ID
	DN_BYNM				= "" 'DN별칭
	UI_ELCT_SGNT_DATA_CNTT	= "" 'UI전자서명내용 (ex-length : 2402 byte)
	
	g_sStage021 = sPros&sStage
	
	'공통
	ELFN_ID				= g_sUserID
	UNIN_ATHN_PROS_CLCD	= sPros
	TERM_ID				= Form.GetDeviceID()

	'---------------------------------------------------------------
	'인증서 Alist List조회
	if sPros == "S" and sStage == "1" then
		g_sKofiaAliasList	= ""
		
		'sOutput => DN
		DN_DATA			= sOutput
		
	'---------------------------------------------------------------
	'로그인서명검증(loopchain api : verify_signature)
	elseif sPros == "U" and sStage == "1" then
	
		'sOutput => sAlias(미사용)★sDn(미사용)★sSignature(전자서명값)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 3 then
			UI_ELCT_SGNT_DATA_CNTT = sParam[2] '로그인서명값
		end if

	'---------------------------------------------------------------
	'인증서관리업무 로그인서명검증(loopchain api : verify_signature)
	elseif sPros == "U" and sStage == "2" then
	
		'sOutput => sAlias(미사용)★sDn(미사용)★sSignature(전자서명값)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 3 then
			UI_ELCT_SGNT_DATA_CNTT = sParam[2] '인증서관리업무 로그인서명값
		end if
		
	'---------------------------------------------------------------
	'풀서명검증(loopchain api : verify_signature)
	elseif sPros == "F" and sStage == "1" then
	
		'sOutput => sAlias(미사용)★sDn(미사용)★sSignature(전자서명값)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 3 then
			UI_ELCT_SGNT_DATA_CNTT = sParam[2] '전자서명값
		end if
	'---------------------------------------------------------------
	'공동앱버전 조회
	elseif sPros == "V" and sStage == "1" then

	'---------------------------------------------------------------
	else
		Form.MsgBox( "알림", "공동인증 조회서비스 입력값이 존재하지 않습니다.", "", 0 )
		exit sub		
	end if

	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_ATHN_PROS_CLCD"	, 0 , UNIN_ATHN_PROS_CLCD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_SNTN"			, 0 , UNIN_NTAT_SNTN)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID"				, 0 , ELFN_ID)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"					, 0 , ACNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_DATA"				, 0 , DN_DATA)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO"					, 0 , RCNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TERM_ID"				, 0 , TERM_ID)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_BYNM"				, 0 , DN_BYNM)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UI_ELCT_SGNT_DATA_CNTT"	, 0 , UI_ELCT_SGNT_DATA_CNTT)
	
	DATAMANAGER.RequestTranData( szTranID )	
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sUserID 	= ""
	g_sType 	 	= ""
	g_bReRegister = False
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	'---------------------------------------------------------------
	'공동인증 등록/재등록 - 로그아웃으로 상태변경
	if sKeyName == "LOGOUT_MSG1" then
		if sRet == "ok" then
			'로그아웃실행(0:문구없음,1문구있음)
			Form.LogOut(0, 1)					
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "", 6 )
		end if
		
	'---------------------------------------------------------------
	'공동인증 관리 - 로그인으로 상태변경	
	elseif sKeyName == "LOGIN_MSG1" then
		if sRet == "ok" then
			Form.OpenScreen("90020" , "")
		end if
		
	'---------------------------------------------------------------
	'공동인증 등록/재등록 - 단말에 공동인증서 존재할 경우 등록의사 결정	
	elseif sKeyName = "REGISTER_MSG1" then
		if sRet == "ok" then
			g_bReRegister = True '공동인증서 재등록
			Form.OpenFramePopup("mhetc90130_p2", "bc_new", "")
		else
			g_bReRegister = False '공동인증서 재등록
		end if
		
	'---------------------------------------------------------------
	'공동인증 갱신 - 단말에 공동인증서 존재할 경우 등록의사 결정	
	elseif sKeyName = "RENEWAL_MSG1" then
		if sRet == "ok" then
			Form.requestKofiaAuth("BCHAIN_105", g_sKofiaAlias & "★" & g_sKofiaDN, "MAIN")
		end if
	'---------------------------------------------------------------
	'공동앱(CHAIN-ID) 업데이트
	elseif sKeyName == "BCHAIN_UPDATE" Then
		if sRet == "ok" then
			Form.setKofiaAuthInstalled()	'금투협 공동앱설치
		end if
	end if
End Sub

'============================================================================
'블록체인 공동인증 등록/재등록 클릭
'============================================================================
Sub Image2_OnClick() 
	g_sType = "bc_new" '등록/재등록
	
	'---------------------------------------------------------------
	'로그인 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	if CInt(sLOGIN_TYPE) > 1 then 
		sText = "공동인증 등록을 위하여 로그아웃을 진행하시겠습니까?"
		Form.MsgBox("공동인증 안내", sText, "LOGOUT_MSG1", 1)
		exit sub
	end if
	
	'-------------------------------------------------------------------
	'지원기기 체크 START
	nSDK = CDbl(Form.getSharedData("&SDK_VERSION", false))
	
	'iOS("2")Android("1")
	if Form.GetSharedData("&OS_TYPE", false ) == "1" Then
		if nSDK < 19 then	'4.4(킷캣)이상부터 지원
			Form.MsgBox ("알림", "공동인증은 안드로이드 OS 4.4 이상부터 지원합니다.", "", 0)
			exit sub
		end if
	else
		if nSDK < 8 then	'8.0이상부터 지원
			Form.MsgBox ("알림", "공동인증은 iOS 8.0 이상부터 지원합니다.", "", 0)
			exit sub
		end if
	end if
	'-------------------------------------------------------------------
	'---------------------------------------------------------------
	'공동앱 설치여부 체크
	sRet = Form.getKofiaAuthInstalled()
	
	if sRet = "0" then 				'0 : 설치안됨, 1 : 설치됨
		Form.setKofiaAuthInstalled()	'공동앱 설치
		return
	elseif sRet = "1" then 
		Request_obcsb_padc_021r("V", "1", "")
	end if
'	'---------------------------------------------------------------
'	'로그인 체크
'	Dim sLOGIN_TYPE  
'	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
'	
'	if CInt(sLOGIN_TYPE) > 1 then 
