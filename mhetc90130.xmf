'		Form.MsgBox("공동인증 안내", sText, "LOGOUT_MSG1", 1)
'	else
'		'저장된 인증서정보조회
'		Form.requestKofiaAuth("BCHAIN_103", "", "MAIN")		
'	end if
End Sub

