'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFileName	'설정파일
dim	g_szNames		'설정Key
dim	g_szValues		'설정값
dim 	g_szCodes		'실제Input값

'g_szNames	= Array("41000_WONDOLLAR", "41000_WONYEN", "41000_WONWIAN", "41000_DOLLAREURO", "41000_YENDOLLAR", "41000_YENEURO", "41000_DOLLARPOUND" )
g_szNames	= Array("41000_WONDOLLAR", "41000_WONYEN", "41000_WONWIAN", "41000_YENDOLLAR", "41000_YENEURO" )
g_szValues	= Array()
'g_szCodes	= Array("USDKRWSMBS", "JPYKRWCOMP", "CNYKRWCOMP", "EURUSDCOMP", "USDJPYCOMP", "EURJPYCOMP", "GBPUSDCOMP")
g_szCodes	= Array("USDKRWSMBS", "JPYKRWCOMP", "CNYKRWCOMP", "USDJPYCOMP", "EURJPYCOMP")


g_szFileName = "41000ITEMS.ini"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function LoadSetting()

	for	i	=	0	to	Ubound(g_szNames)
		g_szValues(i)	=	Form.LoadConfigData(g_szFileName, g_szNames(i)	)
	Next
	
'	for	i	=	0	to	Ubound(g_szNames)
'		Form.ShowAlert(i, g_szValues(i))
'	Next
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	call	 LoadSetting()
	DATAMANAGER.RequestTranData("ohhts_1684_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim	nIdx
	nIdx	=	0
	
	DATAMANAGER.ClearInputData(0, "ohhts_1684_001r")
	for	i = 0	to	Ubound(g_szNames)
		if	g_szValues(i)	=	"1"	then
		    DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , nIdx , "EN" )
		    DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , nIdx , g_szCodes(i) )
		    
		    nIdx	=	nIdx + 1
		end if	
	next
End Sub



