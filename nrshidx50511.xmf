	<SCRIPT_INFO _len="57070" _ulen="52064" >
Dim gOsType
Dim g_nIndex
Dim g_tabIndex

Dim gFoldPannelHeight		'펼쳐보기 시 판넬 행높이
Dim gUnFoldPannelHeight	'평상 시 판넬 행높이

Dim gETF_SUPER_HIS_KEY
gETF_SUPER_HIS_KEY = "ETF_SUPER_HISTORY"

Dim gFilterNationCode
Dim gFilterPeriodIndex
Dim gFilterPeriodFromDate
Dim gFilterPeriodToDate
gFilterNationCode = "" 
gFilterPeriodIndex = "" 
gFilterPeriodFromDate = "" 
gFilterPeriodToDate = ""

Dim gExSelectIndex
gExSelectIndex = -1

Dim gOvrsMarketList()
gOvrsMarketList = {"AX","NY","OQ","SZ","SH","HK","JP"}

Dim gContUpPos			'위로 스크롤 시 컨테이너 top값
Dim gContDownPos			'아래로 스크롤 시 컨테이너 top값
gContUpPos = 47
gContDownPos = 160

'============================================================================
Sub Form_OnFormInitBefore()

	g_nIndex = 0
	g_tabIndex = 0
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	contBody.Image0.setMaintainingRatio("1")
	contBody.Image1.setMaintainingRatio("1")
	contTitle.ImageNotice.setMaintainingRatio("1")
	contTitle.ImgBackPress.setMaintainingRatio("2")
	
	contHeader.Label0.paddinginfo = "0,0,0,0"
	contHeader.Label1.paddinginfo = "0,0,0,0"
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	gFilterNationCode = "Y@N@N@N@N@N"
	gFilterPeriodIndex = 0
	gFilterPeriodFromDate = "" 
	gFilterPeriodToDate = ""
	
	if gOsType == "1" then
		contBody.FormTab0.left = 10
		contBody.FormTab0.width = 345
	end if

	'----------------------------------------------------------------
	'행 펼쳤을때/접혔을때 높이값 설정
	'----------------------------------------------------------------
	if gOsType == "1" then
		gFoldPannelHeight = 131
		gUnFoldPannelHeight = 60
	else
		gFoldPannelHeight = 132
		gUnFoldPannelHeight = 60
	end if
	
	gWidePannelIndex = -1
	
	'----------------------------------------------------------------
	'(라벨)카테고리명/필터 패딩값 조정
	'----------------------------------------------------------------
	contBody.LabelCategory.paddinginfo = "0,0,0,0"
	contBody.LabelFilter.paddinginfo = "0,0,0,0"
	contBody.LabelCategory.fgcolor = 333
	
	'----------------------------------------------------------------
	' ETF홈화면에서 선택한 조회구분(디폴트 0)
	'----------------------------------------------------------------
	g_tabIndex = Cint(Form.GetOpenLinkData())
	
	'----------------------------------------------------------------
	' 이전 설정값 세팅
	'----------------------------------------------------------------
	ApplyExCondData()
	
	'----------------------------------------------------------------
	' 조회구분 탭 생성(상승/하락/거래량....)
	'----------------------------------------------------------------
	InsertFormTabPage()
	
	'----------------------------------------------------------------
	'iOS전용(판넬 데이터 업데이트 중, 다른 처리 들어왔을 시 미처리 방지)
	'----------------------------------------------------------------
	contBody.Pannel0.setDataNormal(true)
	
	'----------------------------------------------------------------
	' 화면진입 후 첫 스크롤 시, fixTopAreaWhenScrolling 자연스럽게
	'----------------------------------------------------------------
	contBody.gesture = true
	
End Sub

'============================================================================
' UI설정
'============================================================================
Sub SettingUI(nRowCnt)
	
	'----------------------------------------------------------------
	' 조회데이터 존재/미존재 시 UI처리
	'----------------------------------------------------------------
	if nRowCnt == 0 then
	
		contBody.imgNotice.visible = true
		contBody.LabelGuideText.visible = true
		contBody.Pannel0.visible = false
	
	else
	
		contBody.imgNotice.visible = false
		contBody.LabelGuideText.visible = false
		contBody.Pannel0.visible = true
		
	end if


	'------------------------------
	'공통
	'------------------------------
	'행개수 설정
	contBody.Pannel0.rowcount = nRowCnt 
		
	'글자색상/최대라인/패딩값 조정
	for i = 0 to nRowCnt -1
	
		contBody.Pannel0.setPropCardCell("fgcolor","LabelCode"	,		i,"333")	'회색
		contBody.Pannel0.setPropCardCell("fgcolor","LabelGubun",		i,"333")	'회색
		contBody.Pannel0.setPropCardCell("fgcolor","LabelGubunData",	i,"333")	'회색
		
		'컨트롤 속성에 멀티라인이 체크되있어야 적용됨.
		contBody.Pannel0.setPropCardCell("maxlinecnt","LabelName",i,"1^-4") 
		
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelNo",			i,"0,0,0,0") 
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelCode",			i,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelName",			i,"0,0,0,0") 
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelGubun",		i,"0,0,0,0") 
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelGubunData",	i,"0,0,0,0") 
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHyun",			i,"0,0,0,0") 
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelDebi",			i,"0,0,0,0") 
		
	next
	
	contBody.Pannel0.setPropCardCell("width","LabelSeperator",nRowCnt -1, "0" )	'마지막행구분선은 숨김처리

End Sub

'============================================================================
' 상단 폼탭 페이지 생성
'============================================================================
Sub InsertFormTabPage()
	
	'활성화/비활성화/여백
	contBody.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5)   
	
	'활성화/비활성화 폰트색상
	contBody.FormTab0.setTabHeaderFgColor("28" , "321") 								   

	'페이지생성
	if gOsType == "1" then
		contBody.FormTab0.insertPage( 0, "page0", "page0", "nrsempty", "0", "상승")
		contBody.FormTab0.insertPage( 1, "page1", "page1", "nrsempty", "0", "하락")
		contBody.FormTab0.insertPage( 2, "page2", "page2", "nrsempty", "0", "거래량")	
		contBody.FormTab0.insertPage( 3, "page3", "page3", "nrsempty", "0", "시가총액")
		contBody.FormTab0.insertPage( 4, "page4", "page4", "nrsempty", "0", "배당률")	
		contBody.FormTab0.insertPage( 5, "page5", "page5", "nrsempty", "0", "신규상장")
		contBody.FormTab0.insertPage( 6, "page6", "page6", "nrsempty", "0", "순매수")
		contBody.FormTab0.insertPage( 7, "page7", "page7", "nrsempty", "0", "순매도")
	else
		contBody.FormTab0.insertPage( 0, "page0", "page0", "nrsempty", "0", " 상승 ")
		contBody.FormTab0.insertPage( 1, "page1", "page1", "nrsempty", "0", " 하락 ")
		contBody.FormTab0.insertPage( 2, "page2", "page2", "nrsempty", "0", " 거래량 ")	
		contBody.FormTab0.insertPage( 3, "page3", "page3", "nrsempty", "0", " 시가총액 ")
		contBody.FormTab0.insertPage( 4, "page4", "page4", "nrsempty", "0", "  배당률  ")	
		contBody.FormTab0.insertPage( 5, "page5", "page5", "nrsempty", "0", "신규상장")
		contBody.FormTab0.insertPage( 6, "page6", "page6", "nrsempty", "0", " 순매수 ")
		contBody.FormTab0.insertPage( 7, "page7", "page7", "nrsempty", "0", " 순매도 ")
	end if
	
	'초기페이지 지정
	contBody.FormTab0.currenttab = g_tabIndex
	contBody_FormTab0_OnTabChanged(g_tabIndex)
	
End Sub

'============================================================================
' (라벨용)선택 카테고리 한글명 가져오기
'============================================================================
Function GetCategoryNameForLabel(nCurrentTab)

	nTab = Cint(nCurrentTab)
	
	Select Case nTab
		Case 0
			return "상승률 높은 순" 
		Case 1
			return "하락률 높은 순" 
		Case 2
			return "거래량 많은 순"
		Case 3
			return "시가총액 높은 순"
		Case 4
			return "배당률 높은 순"
		Case 5
			return "최근 1개월 신규상장 종목"
		Case 6
			return "순매수 많은 순(추정)"
		Case 7
			return "순매도 많은 순(추정)"
	End Select

End Function
'============================================================================
' (판넬용)선택 카테고리 한글명 가져오기
'============================================================================
Function GetCategoryNameForPannel()

	'상승,하락,신규상장인 경우에는 추가로 보여주는 데이터 없음.
	nTab = Cint(contBody.FormTab0.currenttab)
	
	Select Case nTab
		Case 0
			return "" '상승
		Case 1
			return "" '하락
		Case 2
			return "거래량"
		Case 3
			return "시가총액"
		Case 4
			return "배당률"
		Case 5
			return "" '신규상장
		Case 6
			return "순매수"
		Case 7
			return "순매도"
	End Select

End Function

'============================================================================
' (판넬용)선택 카테고리 데이터가져오기
'============================================================================
Function GetCategoryDataForPannel(nIndex)

	'20240327
	'상승,하락,신규상장인 경우에는 추가로 보여주는 데이터 없음.
	nTab = Cint(contBody.FormTab0.currenttab)
	szData = ""
	
	Select Case nTab
		Case 0 '상승
		
		Case 1 '하락
		
		Case 2 '거래량
			contBody.Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,거래량 ,,0,,0,1,0")
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_VOL" , nIndex)
		
		Case 3 '시가총액
			contBody.Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,시가총액 ,억원,0,,0,1,0")
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_AVLS" , nIndex)
			
			if szData <> "" then
				szData = Round(Cdbl(szData/100000000),0)
			end if
		
		Case 4 '배당률
			contBody.Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,배당률 ,%,0,,2,1,0")
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_DVDN_ERT" , nIndex) '.."%"
		
		Case 5 '신규상장
		
		Case 6 '순매수
			contBody.Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,순매수 ,,0,,0,1,0")
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_TOTAL_SHNU_QTY" , nIndex)
		
		Case 7 '순매도
			contBody.Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,순매도 ,,0,,0,1,0")
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_TOTAL_SELN_QTY" , nIndex)
			
	End Select
	
	return szData

End Function

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_metf_018r" then
		
		'nCnt = 조회데이터 수(최대 5개까지만 보여주므로 5개이상일 경우 상위 5개까지만 보여줌)
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_018r", "OutBlock1")
		
		if g_nIndex + nCnt > 100 then
			nCnt = 100 - g_nIndex
		end if
		
		'데이터개수에 따라 UI설정
		SettingUI(g_nIndex + nCnt )
				
		'판넬에 데이터 삽입
		for nIndex = 0 to nCnt -1
		
			'sFlag = 국가구분
			'sName = 종목명
			'sCode = 종목코드(티커)
			'sHyun = 현재가
			'sDebi = 등락률
			
			sName = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FIDX_KOR_ISNM" 		,nIndex)
			sCode = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_OVRS_ISCD" 		,nIndex)
			sHyun = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_PRPR" 		,nIndex)
			sDebi = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_PRDY_CTRT" 		,nIndex)
			sNation 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_LSTN_NTNL_CODE" 			, nIndex)
			sMarket  = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, nIndex)
			
			sNew		= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_NEW_LSTN_YN" , nIndex)
			sTrht	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_TRHT_YN", nIndex)
			sSign 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_PRDY_VRSS_SIGN" 			, nIndex)
			
			ChangeControlPosAndRowHeight(1,nIndex)
			
			sNationFlagName = GetNationFlagName(sNation)
			contBody.Pannel0.setPropCardCell("maintainratio","ImageFlag",nIndex,"1")
			contBody.Pannel0.setPropCardCell("imgpath","ImageFlag",nIndex,sNationFlagName)
			
			sGubun = GetCategoryNameForPannel()
			sGubunData = GetCategoryDataForPannel(nIndex)
			
			contBody.Pannel0.SetCellValue("LabelNo"	,		g_nIndex + nIndex,	g_nIndex + nIndex+1 .. ".")
			contBody.Pannel0.SetCellValue("LabelName",		g_nIndex + nIndex,	sName)
			contBody.Pannel0.SetCellValue("LabelCode",		g_nIndex + nIndex,	sCode)
			
			'--------------------------
			'현재가
			'--------------------------
			nDecimalLen = GetNationDecimalLen(sNation)
			sHyun = FormatNumber(sHyun,nDecimalLen)
			contBody.Pannel0.SetCellValue("LabelHyun",		g_nIndex + nIndex,	sHyun.." | "..sDebi.."%")
			
			'등락률(현재가 라벨과 통합)
			'contBody.Pannel0.SetCellValue("LabelDebi",		g_nIndex + nIndex,	sDebi)
			
			contBody.Pannel0.SetCellValue("LabelGubun",		g_nIndex + nIndex,	sGubun)
			contBody.Pannel0.SetCellValue("LabelGubunData",	g_nIndex + nIndex,	sGubunData)
			contBody.Pannel0.SetCellValue("LabelBodyTicker",	g_nIndex + nIndex,	sCode)
			contBody.Pannel0.SetCellValue("LabelBodyMarket",	g_nIndex + nIndex,	sMarket)
			
			'--------------------------
			'현재가/등락률 색상표시
			'--------------------------
			if sSign == "2" then '상승
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",nIndex,"290")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",nIndex,"290")
			elseif sSign == "5" then '하락
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",nIndex,"291")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",nIndex,"291")
			else '보합
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",nIndex,"333")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",nIndex,"333")
			end if

			Select Case sBuho
				Case "1", "2" '상한/상승
					contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",g_nIndex + nIndex,"10")
				Case "4", "5" '하한/하락
					contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",g_nIndex + nIndex,"11")
				Case Else '보합
					contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",g_nIndex + nIndex,"12")
			End Select
			
			
			'--------------------------
			'거래정지
			'--------------------------
			if sTrht == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",g_nIndex + nIndex)
				sText = sText .. " | " .. "거래정지"
				contBody.Pannel0.SetCellValue("LabelCode",g_nIndex + nIndex,sText)
			end if
			
			'--------------------------
			'신규상장 여부
			'--------------------------
			if sNew == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",g_nIndex + nIndex)
				sText = sText .. " | " .. "신규상장"
				contBody.Pannel0.SetCellValue("LabelCode",g_nIndex + nIndex,sText)
			end if
			
		next
		
		'------------------------------------------------------------------------------
		'이전 선택행 인덱스값 존재 시 이전행 인덱스가 나올떄까지 자동 재조회 후 자동이동
		'------------------------------------------------------------------------------
		if gExSelectIndex <> "-1" then
			nRow = Cint(contBody.Pannel0.rowcount)
			nIndex = Cint(gExSelectIndex)
			
			'아직 선택행만큼 행수가 생기지 않았으면 재조회
			'선택행만큼 행수가 생겼으면 해당위치로 이동 후 gExSelectIndex 초기화
			'연속조회 끝까지 선택행이 안나오면 그냥 초기화
			if nRow >= nIndex then
				
				'20240424 안드로이드 앱 수정 후 배포해야됨
				'(안드로이드 전용) 안드로이드가 스크롤이 생성되기전에 toprow가 호출되어
				'ScrollNoTop에서 호출되는 fixTopAreaWhenScrolling가 호출이 안됨.
				'안드로이드만 이부분에서 플래그값 바꾸는 용도로 호출
				if gOsType == "1" then
					contBody.fixTopAreaWhenScrolling("1", gContUpPos, "Up")	
				end if
			
				contBody.Pannel0.toprow = nIndex
				gExSelectIndex = "-1"
				
				
			else
				
				if DATAMANAGER.IsMoreNextData("ohhts_metf_018r") then
					gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
					DATAMANAGER.RequestNextData("ohhts_metf_018r")
				else
					gExSelectIndex = "-1"
				end if
				
			end if
			
			
		end if
		'------------------------------------------------------------------------------
		'
		'------------------------------------------------------------------------------	
		
		

	end if
	
End Sub

'============================================================================
Sub contBody_Pannel0_OnScrollEnd()
	
	if DATAMANAGER.IsMoreNextData("ohhts_metf_018r") then
		g_nIndex = _tonumber( contBody.Pannel0.rowcount )	
		DATAMANAGER.RequestNextData( "ohhts_metf_018r" )	
	end if 
	
End Sub


