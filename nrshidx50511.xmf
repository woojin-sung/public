'============================================================================
' 국가코드별 국기이미지 명
'============================================================================
Function GetNationFlagName(sNation)
	
	if sNation == "USA" then
		return "flag_us2"
	elseif sNation =="KOR" then
		return "flag_kor_round"
	elseif sNation =="HKG" then
		return "flag_hk"
	elseif sNation =="CHN" then
		return "flag_chn"
	elseif sNation =="JPN" then
		return "flag_jp2"
	else
		return "flag_general"
	end if

End Function

'============================================================================
' 선택행 링크영역 펼치기
'============================================================================
Function foldBottomLinkArea(nIndex,nHeight)
	
	'20240327
	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	'gFoldPannelHeight = 132
	contBody.Pannel0.setPropCardCell("top","ImageBottomLinkBG"	,nIndex	,gFoldPannelHeight - 70) 
	contBody.Pannel0.setPropCardCell("top","ButtonLink0"		,nIndex	,gFoldPannelHeight - 56)
	contBody.Pannel0.setPropCardCell("top","ButtonLink1"		,nIndex	,gFoldPannelHeight - 56)
	contBody.Pannel0.setPropCardCell("top","ButtonLink2"		,nIndex	,gFoldPannelHeight - 56)
	contBody.Pannel0.setPropCardCell("top","ButtonLink3"		,nIndex	,gFoldPannelHeight - 56)
	contBody.Pannel0.setPropCardCell("top","ButtonLink4"		,nIndex	,gFoldPannelHeight - 56)
	contBody.Pannel0.setPropCardCell("top","LabelSeperator"	,nIndex	,gFoldPannelHeight - 1)
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"1")
	
	if gOsType == "1" then
		CheckRowVisibleAfterFoldForAndroid(nIndex)
	else
		CheckRowVisibleAfterFoldForiOS(nIndex)
	end if
	
End Function

'============================================================================
' 선택행 링크영역 접기
'============================================================================
Function unfoldBottomLinkArea(nIndex,nHeight)

	'20240327
	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,gUnFoldPannelHeight-1)
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
End Function

'============================================================================
' 판넬클릭 시, 링크버튼 + 관심종목 버튼 클릭 여부 확인
'============================================================================
Function isLinkButton(sCellID)
	
	if sCellID == "ButtonLink0" or sCellID == "ButtonLink1" or sCellID == "ButtonLink2" or sCellID == "ButtonLink3" or sCellID == "ButtonLink4" then
		return true
	else
		return false
	end if

End Function

'20240327
'============================================================================
' 현재 선택한 조회구분(상승/하락...) 이 추가 데이터 보여주는 구분인지 여부
' 추가데이터 여부에 따라서 판넬 행 구성이 달라짐.
'============================================================================
Function IsShowAddData()
	
	nTab = Cint(contBody.FormTab0.currenttab)
	
	'상승/하락/신규사장 추가데이터 안보여줌
	if nTab == 0 or nTab == 1 or nTab == 5 then
		return false
	else
		return true
	end if

End Function

'============================================================================
' 데이터행 높이 및 컨트롤 위치 조정
' sType 1:(기본)접힌상태 2:펼침상태
'============================================================================
Function ChangeControlPosAndRowHeight(nType,nIndex)

	if nType == 1 then
	
		'링크영역 컨트롤 숨김처리
		contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
		'종목명
		contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelName",	nIndex,	"0,0,0,0")
		contBody.Pannel0.setPropCardCell("fontsize"	,	"LabelName",	nIndex,	"-2")
		contBody.Pannel0.setPropCardCell("maxlinecnt"	,	"LabelName",	nIndex,	"1^-4")
		
		'종목코드(티커)
		contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelCode",	nIndex,	"0,0,0,0")
		
		'현재가
		contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelHyun",	nIndex,	"0,0,0,0")
			
		'등락률
		contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelDebi",	nIndex,	"0,0,0,0")
		
		'20240327
		'추가데이터 생성 여부
		if IsShowAddData() then
		
			'카테고리 구분
			contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelGubun",	nIndex,	"0,0,0,0")
			contBody.Pannel0.setPropCardCell("left",			"LabelGubun",	nIndex,	"214")
			contBody.Pannel0.setPropCardCell("top",			"LabelGubun",	nIndex,	"54")
			
			'카테고리 데이터
			contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelGubunData",	nIndex,	"0,0,0,0")
			contBody.Pannel0.setPropCardCell("left",			"LabelGubunData",	nIndex,	"104")
			contBody.Pannel0.setPropCardCell("width",		"LabelGubunData",	nIndex,	"250")
			contBody.Pannel0.setPropCardCell("top",			"LabelGubunData",	nIndex,	"54")
			
			'구분선
			contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex, gUnFoldPannelHeight-1 )
			
			'행높이
			contBody.Pannel0.SetCardWHAt(nIndex,gUnFoldPannelHeight)
			
		else
		
			'카테고리 구분
			contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelGubun",	nIndex,	"0,0,0,0")
		
			'카테고리 데이터
			contBody.Pannel0.setPropCardCell("paddinginfo",	"LabelGubunData",	nIndex,	"0,0,0,0")
		
			'구분선
			contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex, gUnFoldPannelHeight-1 )
			
			'행높이
			contBody.Pannel0.SetCardWHAt(nIndex,gUnFoldPannelHeight)
			
		end if
		
	else
		contBody.Pannel0.SetCardWHAt(nIndex,gFoldPannelHeight)
	end if

End Function
'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)

		'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
		
			gWidePannelIndex = nIndex
			foldBottomLinkArea(nIndex,gFoldPannelHeight)
			
			'마지막행 클릭 시 스크롤 자동 이동
			if nIndex == 4 then
				contBody.Pannel0.toprow = nIndex
			end if
				
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			if isLinkButton(sCellID) then
				
				'화면링크버튼 클릭 시, 히스토리 리스트에 쌓는다.
				if sCellID == "ButtonLink0" then '현재가
					
					SetHistory("set",nIndex)
					MoveScreen("hyun",nIndex)
				
				elseif sCellID == "ButtonLink1" then '차트
				
					SetHistory("set",nIndex)
					MoveScreen("chart",nIndex)
				
				elseif sCellID == "ButtonLink2" then '종목정보
				
					SetHistory("set",nIndex)
					MoveScreen("info",nIndex)
				
				elseif sCellID == "ButtonLink3" then '매수
				
					SetHistory("set",nIndex)
					MoveScreen("mesu",nIndex)
				
				elseif sCellID == "ButtonLink4" then '매도
				
					SetHistory("set",nIndex)
					MoveScreen("medo",nIndex)
					
				end if
				
				
			'링크버튼 외 영역 클릭 시(접혀도 되는 경우임)
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
					
					'마지막행 클릭 시 스크롤 자동 이동
					if nIndex == 4 then
						contBody.Pannel0.toprow = nIndex
					end if
				
				end if
			
			
			end if
			
		end if
		
		
	
End Sub

'============================================================================
Function SetHistory(sGubun,nIndex)

	szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
	szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
	sData = szMk .. "@" .. szItemCode
	
	Form.manageTotalSearch(gETF_SUPER_HIS_KEY, sGubun, sData)
	
	'테스트확인용
	'test = Form.manageTotalSearch(gETF_SUPER_HIS_KEY, "get", "")
	'Form.ShowAlert("test", test)

End Function

'============================================================================
' 이전 검색 조건값 적용
'============================================================================
Function ApplyExCondData()

	'---------------------------------------------------------------
	'저장 검색조건 리스트
	'---------------------------------------------------------------
	'조회구분 			: contBody.FormTab0.currenttab / ETF_RANKING_GUBUN
	'필터조건값
	'- 국가 				: gFilterNationCode (초기값 Y@N@N@N@N@N) / ETF_RANKING_FILTER_NATION
	'- 조회기간구분 		: gFilterPeriodIndex (초기값 0) / ETF_RANKING_FILTER_INDEX
	'- From일자 			: gFilterPeriodFromDate (초기값 빈값) / ETF_RANKING_FILTER_FROM
	'- To일자 			: gFilterPeriodToDate (초기값 빈값) / ETF_RANKING_FILTER_TO
	'- 선택종목 인덱스	: nIndex / ETF_RANKING_SELECT_INDEX
	'---------------------------------------------------------------
	
	'----------------------------------------------------------------------------
	'이전값 가져오기
	'----------------------------------------------------------------------------
	sSearchGubun 		 	= Form.GetSharedData("ETF_RANKING_GUBUN"			, false )
	sFilterNationCode  	= Form.GetSharedData("ETF_RANKING_FILTER_NATION"	, false )
	sFilterPeriodIndex  	= Form.GetSharedData("ETF_RANKING_FILTER_INDEX"	, false )
	sFilterPeriodFrom  	= Form.GetSharedData("ETF_RANKING_FILTER_FROM"	, false )
	sFilterPeriodTo	 	= Form.GetSharedData("ETF_RANKING_FILTER_TO"		, false )
	nIndex 			 	= Form.GetSharedData("ETF_RANKING_SELECT_INDEX"	, false )
	
	'----------------------------------------------------------------------------
	'이전값 메모리영역 데이터 클리어
	'----------------------------------------------------------------------------
	Form.SetSharedData("ETF_RANKING_GUBUN" 			, "")
	Form.SetSharedData("ETF_RANKING_FILTER_NATION" 	, "")
	Form.SetSharedData("ETF_RANKING_FILTER_INDEX" 	, "")
	Form.SetSharedData("ETF_RANKING_FILTER_FROM" 		, "")
	Form.SetSharedData("ETF_RANKING_FILTER_TO" 		, "")
	Form.SetSharedData("ETF_RANKING_SELECT_INDEX" 	, "")
	
	'----------------------------------------------------------------------------
	'이전값 세팅
	'----------------------------------------------------------------------------
	
	'----------------------------------------------------------------------------
	'1) 조회구분
	'----------------------------------------------------------------------------
	if g_tabIndex == 0 then
		if sSearchGubun <> "" then
			g_tabIndex = Cint(sSearchGubun)
		end if
	end if
	
	
	'----------------------------------------------------------------------------
	'2) 필터 국가
	'----------------------------------------------------------------------------
	gFilterNationCode = sFilterNationCode
	
	if gFilterNationCode == "" then
		gFilterNationCode = "Y@N@N@N@N@N"
	end if
	
	'----------------------------------------------------------------------------
	'3) 조회기간 인덱스 
	'----------------------------------------------------------------------------
	gFilterPeriodIndex = sFilterPeriodIndex
	
	if gFilterPeriodIndex == "" then
		gFilterPeriodIndex = 0
	end if
	
	'----------------------------------------------------------------------------
	'4) From일자
	'----------------------------------------------------------------------------
	gFilterPeriodFromDate = sFilterPeriodFrom
	
	
	'----------------------------------------------------------------------------
	'5) To일자
	'----------------------------------------------------------------------------
	gFilterPeriodToDate = sFilterPeriodTo
	
	'----------------------------------------------------------------------------
	'6) 선택행
	'----------------------------------------------------------------------------
	'5)선택행
	gExSelectIndex = nIndex
	if nIndex == "" then
		gExSelectIndex = "-1"
	end if
	
	'Form.ShowAlert("test", "조회구분 : ".. g_tabIndex.."\n".. "필터국가 : " .. gFilterNationCode.."\n".. "필터기간 : " .. gFilterPeriodIndex.."\n".."필터From : ".. gFilterPeriodFromDate.."\n".. "필터To : " .. gFilterPeriodToDate.."\n".. "선택행 : " .. gExSelectIndex)
	

End Function

'============================================================================
' 현재 검색 조건값 저장
'============================================================================
Function SaveCurCondData(nIndex)
	
	'---------------------------------------------------------------
	'저장 검색조건 리스트
	'---------------------------------------------------------------
	'조회구분 			: contBody.FormTab0.currenttab / ETF_RANKING_GUBUN
	'필터조건값
	'- 국가 				: gFilterNationCode (초기값 Y@N@N@N@N@N) / ETF_RANKING_FILTER_NATION
	'- 조회기간구분 		: gFilterPeriodIndex (초기값 0) / ETF_RANKING_FILTER_INDEX
	'- From일자 			: gFilterPeriodFromDate (초기값 빈값) / ETF_RANKING_FILTER_FROM
	'- To일자 			: gFilterPeriodToDate (초기값 빈값) / ETF_RANKING_FILTER_TO
	'- 선택종목 인덱스	: nIndex / ETF_RANKING_SELECT_INDEX
	'---------------------------------------------------------------
	
	'------------------------------------------
	' 조회구분(상승/하락/거래량/시가총액....)
	'------------------------------------------
	sSearchGubun 	= contBody.FormTab0.currenttab
	Form.SetSharedData("ETF_RANKING_GUBUN" , sSearchGubun)
	
	'------------------------------------------
	' 필터 국가
	'------------------------------------------
	sFilterNationCode = gFilterNationCode
	Form.SetSharedData("ETF_RANKING_FILTER_NATION" , sFilterNationCode)
	
	'------------------------------------------
	' 필터 조회기간구분
	'------------------------------------------
	sFilterPeriodIndex = Cstr(gFilterPeriodIndex)
	Form.SetSharedData("ETF_RANKING_FILTER_INDEX" , sFilterPeriodIndex)
	
	'------------------------------------------
	' 필터 From일자 
	'------------------------------------------
	Form.SetSharedData("ETF_RANKING_FILTER_FROM" , Cstr(gFilterPeriodFromDate))
	
	'------------------------------------------
	' 필터 To일자 
	'------------------------------------------
	Form.SetSharedData("ETF_RANKING_FILTER_TO" , Cstr(gFilterPeriodToDate))
	
	'------------------------------------------
	' 선택행 
	'------------------------------------------
	Form.SetSharedData("ETF_RANKING_SELECT_INDEX" , Cstr(nIndex))
	
	
End Function

'============================================================================
' 링크버튼 화면이동 이벤트
'============================================================================
Function MoveScreen(sType,nIndex)

	'화면이동 전 현재설정 값 저장
	SaveCurCondData(nIndex)

	'---------------------------------------------------------
	'현재가 > 호가
	'---------------------------------------------------------
	if sType == "hyun" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."1")
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
			end if
			
		end if
	
	'---------------------------------------------------------
	'차트
	'---------------------------------------------------------
	elseif sType == "chart" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("13000" , szItemCode)
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16020", "")	
			end if
			
		end if
	
	'---------------------------------------------------------
	' 현재가 > 종목정보
	'---------------------------------------------------------
	elseif sType == "info" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."0")
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."0")
			end if
			
		end if
	
	'---------------------------------------------------------
	' 주문(매수)
	'---------------------------------------------------------
	elseif sType == "mesu" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			
			Form.OpenScreen("12000" , "기타".."★".."0".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "0") '매수	
			end if
			
		
		end if
	
	'---------------------------------------------------------
	' 주문(매도)
	'---------------------------------------------------------
	elseif sType == "medo" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
		
			Form.OpenScreen("12000" , "기타".."★".."1".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "1") '매도	
			end if
		
		end if
	
	end if

End Function

'============================================================================
Sub contBody_Pannel0_OnClick(nIndex, sCellID)

	'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
		
			gWidePannelIndex = nIndex
			foldBottomLinkArea(nIndex,gFoldPannelHeight)
			
			'마지막행 클릭 시 스크롤 자동 이동
			if nIndex == 99 then
				contBody.Pannel0.toprow = nIndex
			end if
				
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			if isLinkButton(sCellID) then
				
				'화면링크버튼 클릭 시, 히스토리 리스트에 쌓는다.
				if sCellID == "ButtonLink0" then '현재가
					
					SetHistory("set",nIndex)
					MoveScreen("hyun",nIndex)
				
				elseif sCellID == "ButtonLink1" then '차트
				
					SetHistory("set",nIndex)
					MoveScreen("chart",nIndex)
				
				elseif sCellID == "ButtonLink2" then '종목정보
				
					SetHistory("set",nIndex)
					MoveScreen("info",nIndex)
				
				elseif sCellID == "ButtonLink3" then '매수
				
					SetHistory("set",nIndex)
					MoveScreen("mesu",nIndex)
				
				elseif sCellID == "ButtonLink4" then '매도
				
					SetHistory("set",nIndex)
					MoveScreen("medo",nIndex)
					
				end if
				
				
			'링크버튼 외 영역 클릭 시(접혀도 되는 경우임)
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
					
					'마지막행 클릭 시 스크롤 자동 이동
					if nIndex == 99 then
						contBody.Pannel0.toprow = nIndex
					end if
				
				end if
			
			
			end if
			
		end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "FILTER_SET_COMPLETE" then
		
		'국가구분★조회기간인덱스★From일자★To일자
		'Form.ShowAlert("sRet", sRet)
		arrData = Split(sRet,"★")
		gFilterNationCode = arrData(0)
		gFilterPeriodIndex = arrData(1)
		gFilterPeriodFromDate = arrData(2)
		gFilterPeriodToDate = arrData(3)
		
		RequestData("ohhts_metf_018r")
		
	end if
End Sub
'============================================================================
Function RequestData(szTranID)
	
	if szTranID == "ohhts_metf_018r" then
	
		g_nIndex = 0
	
		'------------------------------------------------------------------------------------------
		'(필터> 국가구분) sTransNationCode => 화면에서는 Y@N@N... 이런식으로 관리 서비스에 올릴때는 YNN 형식으로 올려줘야함.
		'------------------------------------------------------------------------------------------
		sTransNationCode = replace(gFilterNationCode,"@","")
	
		nTab = CInt(contBody.FormTab0.currenttab)
		
		'(예외처리)선택한 탭이 [시가총액:3] [배당률:4] [신규상장:5] 탭인 경우 조회기간을 무조건 당일날짜로 올림.
		'다른탭에서 선택한 조회기간 설정값을 유지해주기 위해, 전역변수를 변경하지 않고 서비스에 올리는 값만 변경해줌.
		if nTab == 3 or nTab == 4 or nTab == 5 then
			
			sToday = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
			
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_CLS_CODE" 	, 0 , nTab)
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FIDX_INPUT_NTNL_CODE"	, 0 , sTransNationCode)
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_DATE1"		, 0 , sToday)
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_DATE2"		, 0 , sToday)
			
			'20240711_01 HWG START : ETF 순위 상승/하락 조회기준일자 변경
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE", 0 , "0")
			'20240711_01 HWG END
		else
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_CLS_CODE" 	, 0 , nTab)
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FIDX_INPUT_NTNL_CODE"	, 0 , sTransNationCode)
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_DATE1"		, 0 , gFilterPeriodFromDate)
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_DATE2"		, 0 , gFilterPeriodToDate)
			
			'20240711_01 HWG START : ETF 순위 상승/하락 조회기준일자 변경
			'[상승:0] [하락:1] 탭인 경우 1개월(1)/3개월(3)은 구분코드로 올림
			'이외에는 0으로 올림
			if nTab == 0 or nTab == 1 then
				if gFilterPeriodIndex == 1 or gFilterPeriodIndex == "1" then
					DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE", 0 , "1")
				elseif gFilterPeriodIndex == 2 or gFilterPeriodIndex == "2" then
					DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE", 0 , "3")
				else
					DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE", 0 , "0")
				end if
			else
				DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE", 0 , "0")
			end if
			'20240711_01 HWG END
		end if
		
		
		for i = 0 to #gOvrsMarketList - 1 
			
			'0:지연 / 1:실시간
			sRealSiseYN = GetRealTimeSiseYN(gOvrsMarketList[i])
			
			if sRealSiseYN == "" then
				sRealSiseYN = "0"
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , i , gOvrsMarketList[i])
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , i , sRealSiseYN)
			
		next
		
		
		
		DATAMANAGER.RequestTranData("ohhts_metf_018r")
		
		SetFilterText()
		
	end if
	
End Function
'============================================================================
Function SetFilterText()

	'-------------------------------------------------
	' 국가필터값 텍스트 추출
	'-------------------------------------------------
	sNationFilterText = ""
	if gFilterNationCode == "" then
		sNationFilterText = "필터"
	else
	
		arrNationFlag = Split(gFilterNationCode,"@")
		
		for i = 0 to #arrNationFlag - 1
			
			if i == 0 then
				
				sFlag = arrNationFlag(0)
				
				if sFlag == "Y" then
					sNationFilterText = "전체"
					exit for
				end if
				
			else
				
				sFlag = arrNationFlag(i)
				
				if sFlag = "Y" then
					
					if i == 1 then
						if sNationFilterText == "" then
							sNationFilterText = "국내"
						else
							sNationFilterText = sNationFilterText.."·국내"
						end if
					elseif i == 2 then
						if sNationFilterText == "" then
							sNationFilterText = "미국"
						else
							sNationFilterText = sNationFilterText.."·미국"
						end if
					elseif i == 3 then
						if sNationFilterText == "" then
							sNationFilterText = "중국"
						else
							sNationFilterText = sNationFilterText.."·중국"
						end if
					elseif i == 4 then
						if sNationFilterText == "" then
							sNationFilterText = "홍콩"
						else
							sNationFilterText = sNationFilterText.."·홍콩"
						end if
					elseif i == 5 then
						if sNationFilterText == "" then
							sNationFilterText = "일본"
						else
							sNationFilterText = sNationFilterText.."·일본"
						end if
					end if
				
				end if
			
			end if
		
		next
		
	
	end if
	
	'-------------------------------------------------
	' 조회기간 필터 텍스트 추출
	'-------------------------------------------------
	sPeriodFilterText = ""
	if gFilterPeriodIndex == 0 or gFilterPeriodIndex == "0" then
		sPeriodFilterText = "당일"
	elseif gFilterPeriodIndex == 1 or gFilterPeriodIndex == "1" then
		sPeriodFilterText = "1개월"
	elseif gFilterPeriodIndex == 2 or gFilterPeriodIndex == "2" then
		sPeriodFilterText = "3개월"
	elseif gFilterPeriodIndex == 3 or gFilterPeriodIndex == "3" then
	
		sTransFromDate = Left(gFilterPeriodFromDate,4) .. "/" .. Mid(gFilterPeriodFromDate,5,2) .. "/" .. Right(gFilterPeriodFromDate,2)
		sTransToDate = Left(gFilterPeriodToDate,4) .. "/" .. Mid(gFilterPeriodToDate,5,2) .. "/" .. Right(gFilterPeriodToDate,2)
		sPeriodFilterText = sTransFromDate .. "~" .. sTransToDate
		
	end if
	
	
	'-------------------------------------------------
	' 세팅
	'-------------------------------------------------
	
	'--------------------------------
	'조회기간이 직접입력
	'--------------------------------
	if gFilterPeriodIndex == 3 or gFilterPeriodIndex == "3" then
		
		'(예외처리)선택한 탭이 [시가총액:3] [배당률:4] [신규상장:5] 탭인 경우 
		'필터에서 조회기간 선택 불가하므로 기간은 표시안해준다.
		nTab = CInt(contBody.FormTab0.currenttab)
		
		if nTab == 3 or nTab == 4 or nTab == 5 then
			contBody.LabelFilter.fontsize = -2
			contBody.LabelFilter.SetMaxLineCount(1)
			contBody.LabelFilter.caption = sNationFilterText
		else
			contBody.LabelFilter.fontsize = -2
			contBody.LabelFilter.SetMaxLineCount(2)
			contBody.LabelFilter.caption = sNationFilterText.."\n"..sPeriodFilterText
		end if
	
	'--------------------------------
	'조회기간이 직접입력이 아닌 경우
	'--------------------------------
	else
		
		'디폴트 필터값
		if sNationFilterText == "전체" and sPeriodFilterText == "당일" then
			
			contBody.LabelFilter.fontsize = -2
			contBody.LabelFilter.SetMaxLineCount(1)
			contBody.LabelFilter.caption = "필터"
		
		'필터조건이 변경되었을 경우
		else
			
			contBody.LabelFilter.fontsize = -2
			contBody.LabelFilter.SetMaxLineCount(1)
			
			'(예외처리)선택한 탭이 [시가총액:3] [배당률:4] [신규상장:5] 탭인 경우 
			'필터에서 조회기간 선택 불가하므로 기간은 표시안해준다.
			nTab = CInt(contBody.FormTab0.currenttab)
			if nTab == 3 or nTab == 4 or nTab == 5 then
				contBody.LabelFilter.caption = sNationFilterText
			else
				contBody.LabelFilter.caption = sNationFilterText.."·"..sPeriodFilterText
			end if
			
		end if
		
		
	end if
	
	

End Function

