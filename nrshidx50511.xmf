'============================================================================
Function GetRealTimeSiseYN(sMarketCode)
	
	szRealAble = Form.GetSharedData( "REALTIME_"&sMarketCode, false )
	return szRealAble
	
End Function


'============================================================================
Sub contTitle_ImageNotice_OnClick()
	Form.OpenPopup("nrshidx50511_p2" , "" , "")
End Sub

'============================================================================
Sub contBody_FormTab0_OnTabChanged(nCurrentTab)
	
	'판넬 데이터행 인덱스값 초기화
	g_nIndex = 0
	
	'(라벨)카테고리명 변경
	sLabelCategoryName = GetCategoryNameForLabel(nCurrentTab)
	contBody.LabelCategory.caption = sLabelCategoryName	
	
	'스크롤 도중 탭 변경 시, 
	'화면에 보여지는 행의 데이터가 업데이트 안되는 현상방지
	'탭변경 시에는 무조건 맨처음행으로 보낸다.
	contBody.Pannel0.toprow = 0
	
	'20240327
	'----------------------------------------------------------------
	'행 펼쳤을때/접혔을때 높이값 설정
	'----------------------------------------------------------------
	if nCurrentTab == 0 or nCurrentTab == 1 or nCurrentTab == 5 then
	
		if gOsType == "1" then
			gFoldPannelHeight = 131
			gUnFoldPannelHeight = 60
		else
			gFoldPannelHeight = 132
			gUnFoldPannelHeight = 60
		end if
		
	else
		
		if gOsType == "1" then
			gFoldPannelHeight = 153
			gUnFoldPannelHeight = 82
		else
			gFoldPannelHeight = 154
			gUnFoldPannelHeight = 82
		end if
		
	end if

	
	RequestData("ohhts_metf_018r")
	
End Sub

'============================================================================
'스크롤 위치가 TOP이 아닌 경우
'============================================================================
Sub contBody_Pannel0_OnScrollNoTop()
	contBody.fixTopAreaWhenScrolling("1", gContUpPos, "Up")
	
	'20240429
	if gOsType == "2" then
		contBody.Pannel0.setScrollSpeed(True, 0)
	end if
	
End Sub
'============================================================================
'스크롤 위치가 TOP인 경우
'============================================================================
Sub contBody_Pannel0_OnScrollTop()
	contBody.fixTopAreaWhenScrolling("1", gContDownPos, "Down")
End Sub

'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 시작됐을 때
'============================================================================
Sub contBody_OnAnimationStart(sParam,sParam2)
	
	'Up Swipe
	if sParam == "Up" then
		
		'기존사이즈 + 숨겨지는 영역 사이즈
		contBody.height = 542 + 113
		
		if sParam2 == "Yes" then
			contBody.Pannel0.height = 428 + 113
		end if
		
	end if
	
End Sub
'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 완료됐을 때
'============================================================================
Sub contBody_OnAnimationComplete(sParam)
	
	'Down Swipe
	if sParam == "Down" then
		
		'기존사이즈 
		contBody.height = 542
		contBody.Pannel0.height = 428
			
	end if
	
End Sub
'============================================================================
' 국가코드별 소수점자리 수
'============================================================================
Function GetNationDecimalLen(sNation)
	
	if sNation == "USA" then
		return 4
	elseif sNation =="KOR" then
		return 0
	elseif sNation =="HKG" then
		return 3
	elseif sNation =="CHN" then
		return 3
	elseif sNation =="JPN" then
		return 1
	else
		return 4
	end if
	
End Function

'============================================================================
' iOS 전용
'============================================================================
Function CheckRowVisibleAfterFoldForiOS(nIndex)

	'------------------------------------------------------------------------------
	' 연결화면 영역 펼칠 때, 화면상에 안보여지는 위치에 있으면 
	' 터치한 행의 Y좌표값이 600이상일때는 행이 펼쳐지면 화면상에서 안보이므로
	' 임의로 toprow를 조정해줌(펼쳐있을때
	'------------------------------------------------------------------------------
	nTab = Cint(contBody.FormTab0.currenttab)
	LocationInfo = contBody.Pannel0.GetCardLocation(nIndex)
	
	if LocationInfo <> "" then
		
		arrLocation = Split(LocationInfo,":")
		
		if #arrLocation > 1 then
			
			nYPos = Cint(arrLocation(1))
			nContTop = Cint(contBody.top)
			
			
			'-----------------------------
			'리스트가 접혀있을때
			'-----------------------------
			if nContTop > 150 then
				
				if nYPos > 600 then
				
					'------------------------------------------------
					' 상승/하락/신규상장 (추가정보를 안보여주는 경우)
					'------------------------------------------------
					if nTab == 0 or nTab == 1 or nTab == 5 then
						contBody.Pannel0.toprow = nIndex - 5
					else
						contBody.Pannel0.toprow = nIndex - 3
					end if
				
				end if
			
			'-----------------------------
			'리스트가 펼쳐져 있을때
			'-----------------------------
			else
				
				if nYPos > 600 then
				
					'------------------------------------------------
					' 상승/하락/신규상장 (추가정보를 안보여주는 경우)
					'------------------------------------------------
					if nTab == 0 or nTab == 1 or nTab == 5 then
						contBody.Pannel0.toprow = nIndex - 6
					else
						contBody.Pannel0.toprow = nIndex - 4
					end if
					
				end if
			
			end if
			
		end if
		
	end if
	
End Function

'============================================================================
' 안드로이드 전용
'============================================================================
Function CheckRowVisibleAfterFoldForAndroid(nIndex)
	
	nContTop = Cint(contBody.top)
	nTab = Cint(contBody.FormTab0.currenttab)
	nCurTopRow = Cint(contBody.Pannel0.toprow)
	nDiffRow = Cint(nIndex - nCurTopRow)
	
	'-----------------------------
	'리스트가 접혀있을때
	'-----------------------------
	if nContTop > 150 then
	
		
	
			'------------------------------------------------
			' 상승/하락/신규상장 (추가정보를 안보여주는 경우)
			'------------------------------------------------
			if nTab == 0 or nTab == 1 or nTab == 5 then
				
				if nDiffRow > 5 then
					
					if nDiffRow > 6 then
						contBody.Pannel0.toprow = nCurTopRow + 2
					else
						contBody.Pannel0.toprow = nCurTopRow + 1
					end if
					
				end if
				
			else
				
				if nDiffRow > 3 then
					
					if nDiffRow > 4 then
						contBody.Pannel0.toprow = nCurTopRow + 2
					else
						contBody.Pannel0.toprow = nCurTopRow + 1
					end if
					
				end if
				
			end if
		
		
	'-----------------------------
	'리스트가 펼쳐져 있을때
	'-----------------------------
	else
	
		'------------------------------------------------
		' 상승/하락/신규상장 (추가정보를 안보여주는 경우)
		'------------------------------------------------
		if nTab == 0 or nTab == 1 or nTab == 5 then
		
			if nDiffRow > 7 then
				
				if nDiffRow > 8 then
					contBody.Pannel0.toprow = nCurTopRow + 2
				else
					contBody.Pannel0.toprow = nCurTopRow + 1
				end if
				
			end if
				
		else
			
			if nDiffRow > 4 then
			
				if nDiffRow > 5 then
					contBody.Pannel0.toprow = nCurTopRow + 2
				else
					contBody.Pannel0.toprow = nCurTopRow + 1
				end if
				
			end if
		
		end if
	
	end if


End Function

'============================================================================
'(iOS 전용) 스크롤링 속도 원복 20240429
'============================================================================
Sub contBody_Pannel0_OnVisibleRow(nEventStartRow, nEventEndRow)
	
	if gOsType == "2" then
		contBody.Pannel0.setScrollSpeed(False, 0)
	end if
	
End Sub

