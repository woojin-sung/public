Sub contBody_LabelFilter_OnClick()
	
	'sOpenData
	'국가선택값★조회기간인덱스★From일자★To일자★조회구분 인덱스(거래량/시가총액....)
	'EX) N@Y@Y@Y@Y@N★1★20240224★20240227
	sSearchGubun 	= contBody.FormTab0.currenttab
