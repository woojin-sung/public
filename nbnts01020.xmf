'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵 잔고평가
' 02. 화면설명 : 선옵 잔고평가
' 03. 작    성 : 2016.04.30 LJS
'			   2020.05.06 LHW - 고유MTS 리팩토링
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북
Dim g_szTitle
g_szTitle = "알림"
Dim g_szQty '청산가능수량
Dim g_szFncd
Dim g_szACNO
Dim g_szASNO
'============================================================================
Sub Form_OnFormInitBefore()
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	g_szFncd = edtFundCd.caption
End Sub

'============================================================================
Sub Form_OnFormInit()
	'펀드코드 계좌조회
	if len(trim(g_szFncd)) > 0 Then
		btnSearch0_OnClick()
	end if
End Sub

'============================================================================
Sub btnSearch0_OnClick()
	g_szFncd = edtFundCd.caption
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	end if
	
	If szTranID = "obtrf_cntg_825r" Then
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_825r", "InBlock1", "ACNO"			, 0 , g_szACNO 	)
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_825r", "InBlock1", "ASNO"			, 0 , g_szASNO 	)
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_825r", "InBlock1", "DATA_CLS"		, 0 , "0" 	)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		
		if len(trim(g_szACNO)) > 0 Then
			'야간선옵 실시간잔고조회(MTS)
			DATAMANAGER.RequestTranData("obtrf_cntg_825r")
		else
			grd2.SetClear()
			Form.ShowAlert("알림", "펀드코드를 확인하세요.")
		End If
	end if
	
	If szTranID = "obtrf_cntg_825r" Then
		
		For i = 0 To grd2.rowcount - 1 
			Dim nCLPR, nPRPR
			Dim szData
			
			szData = grd2.GetCellData( "bd_cell12", i )
			
			Select Case szData
				Case "1" grd2.SetCellData("bd_cell2", i, "매도")
						grd2.SetCellFgColor("bd_cell2", i, "11")
				Case "2" grd2.SetCellData("bd_cell2", i, "매수")
						grd2.SetCellFgColor("bd_cell2", i, "10")
			End Select
			
			
			'전일대비
			nCLPR = CDbl( grd2.GetCellData( "bd_cell10", i ) )		'종가
			nPRPR = CDbl( grd2.GetCellData( "bd_cell8" , i ) )		'현재가
			
			grd2.SetCellData("bd_cell9", i, nPRPR - nCLPR)
		Next
	End If
	
End Sub



'============================================================================
Sub grd2_OnClickUp(lRow, szCellID)
	Dim szItemCode, szQty, szItemMarket

	szItemCode = grd2.GetCellData("bd_cell11", lRow)

	If Left( Trim(szItemCode), 1 ) = "K" Then
		g_szItemCode	= Right( Trim(szItemCode), Len(Trim(szItemCode)) - 1)
	Else
		g_szItemCode	= szItemCode
	End If
	
	szItemMarket 	= Form.GetItemCodeInfo(g_szItemCode, "market_night")

	' 지수선물/미니선물/옵션/미니옵션/위클리옵션 만 가능
	If Trim(szItemMarket) = "F"  or Trim(szItemMarket) = "O" or 
	   Trim(szItemMarket) = "MF" or Trim(szItemMarket) = "MO" or
	   Trim(szItemMarket) = "JF" or Trim(szItemMarket) = "JO" or
	   Trim(szItemMarket) = "XF" or Trim(szItemMarket) = "QO" or '2018.04.06 KRX300선물, KSQ150옵션 추가 XF(KRX300) QO(KSQ150) 
	   Trim(szItemMarket) = "WO" 						   or '2019.09.20 위클리옵션 추가 WO
	   '2020.05.06 야간 선옵 추가 
	   Trim(szItemMarket) = "CM" or Trim(szItemMarket) = "EO" or
	   Trim(szItemMarket) = "EM" or Trim(szItemMarket) = "CD" or Trim(szItemMarket) = "KF" Then		' 20240412 HSZ START : 코스닥글로벌지수 추가(KF)
	   
	   
		listLocation =  Split(grd2.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
	
		sPopupType = "2"
		
		szQty      = grd2.GetCellData("bd_cell3" , lRow)
	
		' 전달내용/탭위치/종목코드/수량
		' 전달내용, 탭위치는 리턴받아서 처리함.	
		g_szData = g_szItemCode & "★" & szQty 
	
		'2020.04.06 - 팝업 임시 주석
		Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")	
	Else
		Form.ShowAlert(g_szTitle, "선택상품은 고유MTS에서 거래되지 않는 상품입니다.")
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mbtrs32000" Then
		Dim arrData
	
		arrData = Split(sRet,"|")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if
		
		If acnt0.caption <> arrData(0) Then
			acnt0.caption = arrData(0)
		Else
			btnSearch_OnClick()
		End If
		
	ElseIf sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("34000" , g_szItemCode & "★" & "0") 
			
		elseif 	szListItems(1)	=	"1"	then		'매수
			Form.OpenScreen("01000" , "잔고" & "★" & "0" & "★" & g_szData ) 
		elseif 	szListItems(1)	=	"2"	then		'매도
			Form.OpenScreen("01000" , "잔고" & "★" & "1" & "★" & g_szData ) 
		end if
		
		g_szData = ""
	end if 
	
	if sKeyName = "FUNDINFO" then
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
		end if 
	end if
End Sub

'============================================================================



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrf32000_h0" , szData , "" )		
		
	ElseIf sEventName = "SCREEN_MENU" Then
		Dim szCode
		szCode = Form.GetSharedData("&ITEM_FUTOPT", 0)		' 최근조회종목
		
		If sParam = "POPUP_MAESU" then
			Form.OpenScreen("31030" , "기타" & "★" & "0" & "★" & szCode )
			
		elseif sParam = "POPUP_MAEDO" then
			Form.OpenScreen("31030" , "기타" & "★" & "1" & "★" & szCode )
			
		elseif sParam = "SET_GRIDCOL" then
			grd0.showconfig("컬럼 순서 변경")
			
		end if
	End If
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch0_OnClick()
End Sub

'============================================================================
' 펀드코드 변경시 
'============================================================================
Sub edtFundCd_OnEditComplete()
	g_szFncd = edtFundCd.caption	
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub
'============================================================================
' 돋보기
'============================================================================
Sub btnFncd_OnClick()
	Form.OpenFramePopup("nhnts00001_p1" , "", "")
End Sub
'============================================================================
' 연속조회
'============================================================================
Sub grd2_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtrf_cntg_825r") = true then
		DATAMANAGER.RequestNextData( "obtrf_cntg_825r" )
	end if
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obfnp_fnmt_011r" trcode="obfnp_fnmt_011r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrf_cntg_825r" trcode="obtrf_cntg_825r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
