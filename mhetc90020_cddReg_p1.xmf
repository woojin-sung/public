'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객정보입력
' 02. 화면설명 : 고객정보입력_직종선택
' 03. 작    성 : 2016.02.29 노은솔
' 04. 수    정 : 2017.09.07 윤유정 : 대분류 자동셋팅 제거 v0001
'              : 2018.09.13 윤유정 : 그리드 멈춤 높이 수정(그리드 바디 높이 축소) v0002
'-------------------------------------------------------------------------------------------
Dim	g_lCellID
Dim	g_lRow
	g_lRow = -1
Dim g_sRetData
Dim g_isNextFlag
'============================================================================
Sub BtnOK_OnClick()
	If g_lRow < 0 Then
		ShowAlert("확인", "국가를 선택하여주시기 바랍니다.")
		Exit Sub
	End If
	
	sName = Grid0.GetCellData("bd_cell0", g_lRow)
	lLrdv = Grid0.GetCellData("bd_cell1", g_lRow)	
	
	Form.SetSharedData("cddReg_CODE_NAME" , sName)
	Form.SetSharedData("cddReg_CODE"      , lLrdv)		
	Form.SendReturnToParent("mhetc90020_cddReg_p1" , sName)	

	Form.CloseForm()
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	If g_lRow >= 0 Then
		nIndex = g_lRow%2
		If nIndex = 0 Then
			Grid0.SetCellFgColor("bd_cell0",g_lRow,"4")				
		Else
			Grid0.SetCellFgColor("bd_cell0",g_lRow,"4")		
		End If
	End If
	Grid0.SetCellFgColor(szCellID,lRow,"10")
	
	g_lRow = lRow

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranMessage(szTranID, szMsgCode, szMessage, szSubMessage)
	if szTranID == "obcpp_code_002r" then
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcpp_code_002r", "OutBlock1" ))
		
		If DATAMANAGER.IsMoreNextData(szTranID) == true Then
			g_isNextFlag = true
		Else
			g_isNextFlag = False
		End If
	end if

End Sub


'============================================================================
Sub Grid0_OnScrollEnd()
	If g_isNextFlag == true Then
		DATAMANAGER.RequestNextData("obcpp_code_002r")		
	End If
End Sub

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "IQRY_CLS_CODE" 			, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "META_TERM_PHSC_NAME" 		, 0 , "국가코드")
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "CODE_VALD_VAL_KOR_NAME" 	, 0 , Edit0.caption)
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "CODE_VALD_VAL" 			, 0 , "")
	
	DATAMANAGER.RequestTranData("obcpp_code_002r")
End Sub

Sub Edit0_OnEditComplete()
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "IQRY_CLS_CODE" 			, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "META_TERM_PHSC_NAME" 		, 0 , "국가코드")
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "CODE_VALD_VAL_KOR_NAME" 	, 0 , Edit0.caption)
	DATAMANAGER.SetDataValue(0, "obcpp_code_002r", "InBlock1", "CODE_VALD_VAL" 			, 0 , "")
	
	DATAMANAGER.RequestTranData("obcpp_code_002r")
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()	
End Sub


