'============================================================================
Sub btnAdd_OnClick()
	dim szTB
	if rgTopButtom.currentindex == "0" then
		szTB = "T"
	else
		szTB = "B"
	end if
	Form.SendReturnToParent( "DUPLICATE" , szTB )
	Form.CloseForm( )
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm( )
End Sub

