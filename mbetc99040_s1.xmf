'============================================================================
Sub Form_OnFormInit()



Grid0.SetVisibleCol(2, 0)
Grid0.SetVisibleCol(1, 0)

DATAMANAGER.SetDataValue(0, "obcpp_intr_755r", "InBlock1", "INP_MEMB_SRNO", 0 , 1)
DATAMANAGER.SetDataValue(0, "obcpp_intr_755r", "InBlock1", "INP_CLS_CODE", 0 , 0)

DATAMANAGER.RequestTranData("obcpp_intr_755r")

Label0.visible = 0
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_755r" ,"OutBlock1") 
	
	if cnt == 0 then
     Label0.visible = 1
    ' Grid0.SetDeleteRow(0)
     end if
	
	
	for i=0 to cnt
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "BRNM", i) '지점명
	Grid0.SetCellData("bd_cell1", i, tmp)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "BRNC_ADDR", i) '지점주소
	Grid0.SetCellData("bd_cell6", i, tmp) 
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "PROS_DATE", i) '처리일자
	Grid0.SetCellData("bd_cell7", i, tmp) 
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "PROS_HOUR", i) '처리시간
	Grid0.SetCellData("bd_cell8", i, tmp) 
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "RSNS_EMPNO", i) '담당직원
	Grid0.SetCellData("bd_cell9", i, tmp)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "PRTF_ID", i) '포트폴리오ID
	Grid0.SetCellData("bd_cell11", i, tmp)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_755r", "OutBlock1", "INP_RSEV_SRNO", i) '예약일련번호
	Grid0.SetCellData("bd_cell17", i, tmp)
	
	
	
	
	Grid0.SetCellData("bd_cell0", i, "지점명")
	Grid0.SetCellData("bd_cell2", i, "지점주소")
	Grid0.SetCellData("bd_cell3", i, "예약날짜")
	Grid0.SetCellData("bd_cell4", i, "예약시간")
	Grid0.SetCellData("bd_cell5", i, "담당직원")
	Grid0.SetCellData("bd_cell10", i, "예약수정 및 취소")
	Grid0.SetCellFgColor("bd_cell10", i, "90")
	
	
	
	next
	
	
	
	
	
	
	
	
	
End Sub

'============================================================================


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

tmp = Grid0.selectrow
'prtf_id = Grid0.GetCellData("bd_cell14",tmp)
rv_data = Grid0.GetCellData("bd_cell1",tmp)&"●"&Grid0.GetCellData("bd_cell6",tmp)&"●"&Grid0.GetCellData("bd_cell7",tmp)&"●"&Grid0.GetCellData("bd_cell8",tmp)&"●"&Grid0.GetCellData("bd_cell9",tmp)&"●"&Grid0.GetCellData("bd_cell11",tmp)&"●"&Grid0.GetCellData("bd_cell17",tmp)

 if szCellID == "bd_cell10" then 

 'Form.MsgBox("테스트", prtf_id, "", "")
 
 Form.OpenPopup("mbetc99040_s3" , rv_data , "")
 
 end if


	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

  if sKeyName =="mbetc99040_s3" then
  
   flag = cStr(sRet)
   
	   if flag == "1" then
  
	  DATAMANAGER.SetDataValue(0, "obcpp_intr_755r", "InBlock1", "INP_MEMB_SRNO", 0 , 1)
	  DATAMANAGER.SetDataValue(0, "obcpp_intr_755r", "InBlock1", "INP_CLS_CODE", 0 , 0)
      DATAMANAGER.RequestTranData("obcpp_intr_755r")
      
      end if

end if
  
	
End Sub

