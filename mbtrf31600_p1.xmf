'--===========================================================================
' 01. 화 면 명 : 국내 파생상품 거래내역 조회
' 02. 화면설명 : 국내 파생상품 거래내역 조회
' 03. 작    성 : 2023-12-20 YJH
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	Container0.Grid0.SetClear()

	Container0.tblIncome.SetCellString( 0 , 1, "")	'총 양도소득
	Container0.tblIncome.SetCellString( 1 , 1, "")	'총 비용
	Container0.tblIncome.SetCellString( 2 , 1, "")	'순양도소득
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
        Form.SetScreenName( "파생상품 거래내역 조회" )
	
	f_ClearData()
	
	szFromDate = Form.GetSharedData("mbtrf31600_cldFrom" , false)
	szToDate = Form.GetSharedData("mbtrf31600_cldTo" , false)
	
	cldFrom.caption = szFromDate
	cldTo.caption = szToDate
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_502r" ) '국내 파생상품 거래내역 조회
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	f_ClearData()
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_502r" ) '국내 파생상품 거래내역 조회
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'국내 파생상품 거래내역 조회
	If szTranID == "obtrf_cntg_502r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total         )    '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence )    '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" 	, 0 , ""                          )     '계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" 	, 0 , cldFrom.caption      )    '시작일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" 	, 0 , cldTo.caption         )     '종료일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 		, 0 , "%"                        )     '종목코드
		
		If Container0.ChkButton0.checkstate == 1 or Container0.ChkButton0.checkstate == "1" then
	        	szValCLCD = "1" '청산거래만 보기
	        Else
	        	szValCLCD = "2" '신규거래도 포함해서 보기
	        End if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "VAL_CLCD" 	, 0 , szValCLCD            )     '값구분코드
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'국내 파생상품 거래내역 조회
	If szTranID == "obtrf_cntg_502r" Then
		If tonumber(Container0.Grid0.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" ))
			nRowCnt = Container0.Grid0.rowcount - nDataCnt
		
			For i = 0 to nDataCnt - 1
				szDealClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "DEAL_CLS_CODE" , i )
				szRmndDealClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RMND_DEAL_CLS_CODE" , i )
		
				Select Case szDealClsCode
					Case "1"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "매도")
					Case "2"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "매수")
					Case "3"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "매수청산") '선물옵션에서 사용하는 구분
					Case "4"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "매도청산") '선물옵션에서 사용하는 구분
					Case "5"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "권리행사") '선물옵션에서 사용하는 구분
					Case "6"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "의무배정") '선물옵션에서 사용하는 구분
					Case "7"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "행사포기") '선물옵션에서 사용하는 구분
					Case "8"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "의무면제") '선물옵션에서 사용하는 구분
					Case "9"
						Container0.Grid0.SetCellData("bd_cell4", nRowCnt + i, "기타") '선물옵션에서 사용하는 구분
				End Select
				
				Select Case szRmndDealClsCode
					Case "1"
						Container0.Grid0.SetCellData("bd_cell12", nRowCnt + i, "매도")
					Case "2"
						Container0.Grid0.SetCellData("bd_cell12", nRowCnt + i, "매수")
				End Select
			Next
		End if
	End if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub

