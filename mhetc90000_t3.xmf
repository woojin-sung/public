'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obcsb_acif_900r" then
		sUserID = Form.GetSharedData("&USER_ID", false)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_900r", "InBlock1", "ELFN_ID", 0 , sUserID)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_acif_900r" then
		g_sSMSYN = DATAMANAGER.GetDataValue(0, "obcsb_acif_900r", "OutBlock1", "PBLT_SMS_RCMS_YN" , 0)
		
		if g_sSMSYN = "N" then
			Cont0.btnMarketingPushKey.left = 1000
			Cont0.btnMarketingPushKey2.left = 303
			
			sIndex = Cont0.btnMarketingPushKey.switchindex
			
			if g_sOSTYPE = "2" then
				Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
				Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286,286) 
				
				Cont0.btnMarketingPushKey2.switchindex = sIndex
				Cont0.btnMarketingPushKey.switchindex = sIndex
			else
				Cont0.btnMarketingPushKey2.switchindex = sIndex
			end if
		else
			sPushKey = Cont0.btnPushKey.switchindex
			if sPushKey == "0" then
				Cont0.btnMarketingPushKey.left = 1000
				Cont0.btnMarketingPushKey2.left = 303
				
				sIndex = Cont0.btnMarketingPushKey.switchindex
		
				if g_sOSTYPE = "2" then
					Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
					Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286, 286) 
					
					Cont0.btnMarketingPushKey2.switchindex = sIndex
					Cont0.btnMarketingPushKey.switchindex = sIndex
				else
					Cont0.btnMarketingPushKey2.switchindex = sIndex
				end if
			else
				Cont0.btnMarketingPushKey.left = 303
				Cont0.btnMarketingPushKey2.left = 1000
				
				sIndex = Cont0.btnMarketingPushKey.switchindex
				
				if g_sOSTYPE = "2" then
					Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
					Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286, 286) 
					
					Cont0.btnMarketingPushKey2.switchindex = sIndex
					Cont0.btnMarketingPushKey.switchindex = sIndex
				else
					Cont0.btnMarketingPushKey2.switchindex = sIndex
				end if
			end if
		end if
	end if
End Sub

'============================================================================
Sub Cont0_btnPushKeyAlpha_OnClick()
	Form.MsgBox("알림", "푸시 알림 설정을 해지하시면\n실시간 안내 메시지를 받으실 수 없습니다.\n알림설정을 해지 하겠습니까?", "pushKey", 2)
End Sub
'============================================================================
Sub Cont0_btnMarketingPushKeyAlpha_OnClick()

	if Cont0.btnPushKey.switchindex == "0" then
		exit Sub
	end if
	
	if g_sSMSYN = "N" then
		sPositive = "개인신용정보동의 바로가기"
		if Form.GetSharedData("&OS_TYPE", false) == "1" then
			sPositive = "개인신용정보동의\n바로가기"
		end if
		Form.MsgBox("알림", "개인(신용)정보동의 > 문자(SMS,PUSH) 동의 및 푸시 알리미 설정 후 이용 가능합니다.", "marketingKey2", 7, sPositive, "닫기")
	else
		if Cont0.btnMarketingPushKey.switchindex = "1" then
			Form.MsgBox("알림", "스마트톡 알림 설정을 해지하시면\n광고/이벤트 안내메시지를 받으실 수\n없으며 일반/체결 안내메시지는\n받을 수 있습니다.\n\n알림설정을 해지 하겠습니까?", "marketingKey", 2)
		else
			Cont0.btnMarketingPushKey.switchindex = "1"
			
			SetConfigData(g_sMarketingPushKey, 8, 1)	
			GetConfigData(g_sMarketingPushKey, 8, 1)	
		end if
	end if

End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "pushKey" then
		
		if sRet = "ok" then
			Cont0.btnPushKey.switchindex = "0"
		end if
		
		SetConfigData(g_sPushKey, 1, 1)	
		GetConfigData(g_sPushKey, 1, 1)	
	elseif sKeyName = "marketingKey" then
		
		if sRet = "ok" then
			Cont0.btnMarketingPushKey.switchindex = "0"
		end if
		
		SetConfigData(g_sMarketingPushKey, 8, 1)	
		GetConfigData(g_sMarketingPushKey, 8, 1)	
		
	elseif sKeyName = "marketingKey2" then
		if sRet = "ok" then
			Form.OpenScreen("81020" , "탭이동;1")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Cont0.Image10.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Cont0_Image10_OnClick()
	sText = "- 스마트톡은 앱을 통해 광고/이벤트 정보를 수신하는 서비스 입니다.\n- 개인(신용)정보동의 > 문자(SMS,PUSH) 동의 및 푸시 알리미 설정 후 이용 가능합니다."
	Cont0.Image10.openToolTip(sText,340,170,2)
End Sub
