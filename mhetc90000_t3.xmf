	<SCRIPT_INFO _len="20917" _ulen="18899" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_알림
' 03. 작    성 : 2016.02.16 김보라
' 20230516 KKM 스위치 버튼 추가
'-------------------------------------------------------------------------------------------
'============================================================================
'시스템중단,상품등안내Push("alarm.push")
'사용하지않음("0"),사용("1") - 초기값 "1"

'Push알림시진동사용("alarm.push_vibration") - 신규
'사용하지않음("0"),사용("1") - 초기값 "1"

'체결통보알림사용("alrim.chegyul")
'사용하지않음("0"),알림음사용("1"),진동+알림음사용("2") - 초기값 "1"

'장운영알림사용("alrim.market")
'사용하지않음("0"),사용("1") - 초기값 "1"

'장운영알림진동사용("alrim.market_vibration") - 신규
'사용하지않음("0"),사용("1") - 초기값 "1"

'Wathing알림방법("alrim.watching_view") - 신규
'팝업알림("0"),알림창알림("1") - 초기값 "0"
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sPushKey '시스템중단,상품등안내Push
Dim g_sPushVibKey 'Push알림시진동사용
Dim g_sChegyulKey '체결통보알림사용
Dim g_sAlrimMarketKey '장운영알림사용
Dim g_sAlrimMarketVibKey '장운영알림진동사용
Dim G_SCREENCHOICE_FILE '선택화면팝업
Dim g_sWatchingViewKey 'Watching알림방법

'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
Dim g_sMarketingPushKey '스마트톡사용	
Dim g_sSMSYN '마케팅동의여부
Dim g_sOSTYPE 
'20230901_01 HWG END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sKey, nRow, nCol)
	Dim sValue
	sValue = Form.GetEnvData(sKey)

	if sValue == null or Trim(sValue) == "" then
		if sKey == g_sWatchingViewKey then
			sValue = "0"
		else
			sValue = "1" '기본값 On
		end if
	end if
	
	if sKey == g_sChegyulKey then 
		if sValue == "0" then 
			sValue = "미사용"
		elseif sValue == "1" then 
			sValue = "알림음"
		elseif sValue == "2" then 
			sValue = "진동+알림음"
		else
			sValue = "진동"
		end if
	elseif sKey == g_sWatchingViewKey then
		if sValue == "0" then 
			sValue = "팝업 알림"
		else
			sValue = "알림창 알림"
		end if
	else
		'20230517 KKM START 스위치 버튼을 변경
		if sKey == g_sPushKey then 
			Cont0.btnPushKey.switchindex =  sValue
			
			'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
			if sValue = "0" or sValue = 0  then
				' 푸시알리미 미사용 (안내팝업 버튼 불필요)
				Cont0.btnPushKeyAlpha.left = 1000
				Cont0.btnPushKeyAlpha.visible = false
			else
				' 푸시알리미 사용 (안내팝업 버튼 필요)
				Cont0.btnPushKeyAlpha.left = 302
				Cont0.btnPushKeyAlpha.visible = true
			end if
			
			' 푸시알리미 설정에 따라 스마트톡 컨트롤 활성화 여부 결정
			if sValue = "0" then
				Cont0.btnMarketingPushKey.left = 1000
				Cont0.btnMarketingPushKey2.left = 303
				
				sIndex = Cont0.btnMarketingPushKey.switchindex
				
				if g_sOSTYPE = "2" then
					Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
					Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286, 286) 
					
					Cont0.btnMarketingPushKey2.switchindex = sIndex
					Cont0.btnMarketingPushKey.switchindex = sIndex
				else 
					Cont0.btnMarketingPushKey2.switchindex = sIndex
				end if

			else
				if g_sSMSYN ="Y" then
					Cont0.btnMarketingPushKey.left = 303
					Cont0.btnMarketingPushKey2.left = 1000
					
					sIndex = Cont0.btnMarketingPushKey.switchindex
					
					if g_sOSTYPE = "2" then
						Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
						Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286, 286) 
						
						Cont0.btnMarketingPushKey2.switchindex = sIndex
						Cont0.btnMarketingPushKey.switchindex = sIndex
					else 
						Cont0.btnMarketingPushKey2.switchindex = sIndex
					end if
				else
					Cont0.btnMarketingPushKey.left = 1000
					Cont0.btnMarketingPushKey2.left = 303
					
					sIndex = Cont0.btnMarketingPushKey.switchindex
					
					if g_sOSTYPE = "2" then
						Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
						Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286, 286) 
						
						Cont0.btnMarketingPushKey2.switchindex = sIndex
						Cont0.btnMarketingPushKey.switchindex = sIndex
					else 
						Cont0.btnMarketingPushKey2.switchindex = sIndex
					end if
				end if
			end if
			'20230901_01 HWG END
			
			Exit Function
		elseif sKey == g_sPushVibKey then 
			Cont0.btnPushVibKey.switchindex =  sValue  
			Exit Function
		elseif sKey == g_sAlrimMarketKey then 
			Cont0.btnAlrimMarketKey.switchindex =  sValue  
			Exit Function
		elseif sKey == g_sAlrimMarketVibKey then 
			Cont0.btnAlrimMarketVibKey.switchindex =  sValue  
			Exit Function
		'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
		elseif  sKey == g_sMarketingPushKey then
			Cont0.btnMarketingPushKey2.switchindex = sValue
			Cont0.btnMarketingPushKey.switchindex =  sValue  
			Exit Function
		'20230901_01 HWG END
		end if 
		'20230517 KKM END 
		if sValue == "1" then 'On
			sValue = "사용"
		else 'Off
			sValue = "미사용"
		end if

	end if

	Cont0.Table0.SetCellString( nRow, nCol, sValue )
	'20230517 KKM START 스위치 버튼을 변경
	Cont0.Table0.SetCellFgColor( nRow, nCol, "12" )
'	if sValue == "미사용" then
'		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
'	else
'		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
'	end if
	'20230517 KKM END 

	
End Function

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sKey, nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sKey == g_sChegyulKey then
		if sValue == "미사용" then 
			sValue = "0"
		elseif sValue == "알림음" then 
			sValue = "1"
		else
			sValue = "2"
		end if
	elseif sKey == g_sWatchingViewKey then
		if sValue == "팝업 알림" then 
			sValue = "0"
		else
			sValue = "1"
		end if
	'20230517 KKM START 스위치 버튼을 변경		
	elseif sKey == g_sPushKey then 
		sValue = Cont0.btnPushKey.switchindex
	elseif sKey == g_sPushVibKey then 
		sValue = Cont0.btnPushVibKey.switchindex
	elseif sKey == g_sAlrimMarketKey then 
		sValue = Cont0.btnAlrimMarketKey.switchindex
	elseif sKey == g_sAlrimMarketVibKey then 
		sValue = Cont0.btnAlrimMarketVibKey.switchindex
	'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
	elseif  sKey == g_sMarketingPushKey then
		sValue = Cont0.btnMarketingPushKey.switchindex 

		if Cont0.btnMarketingPushKey.enable then
'			sDate = Form.GetSharedData( "&HOST_DATE", false )
'			sTime = Form.GetSharedData( "&HOST_TIME", false )
'			
'			sDateTime = left(sDate, 4) ..  "." .. mid(sDate, 5, 2) ..  "." .. right(sDate, 2) ..  "  " .. left(sTime, 2) ..  ":" .. mid(sTime, 3, 2) ..  ":" .. right(sTime, 2)
			
			if sValue = "1" then
				Form.Toast(0, "광고/이벤트 알림 수신이 동의처리 되었습니다.", true)
			else
				Form.Toast(0, "광고/이벤트 알림 수신이 거부처리 되었습니다.", true)
			end if
		end if
	'20230901_01 HWG END
	'20230517 KKM END 
	else	
		if sValue == "사용" then
			sValue = "0"
		else
			sValue = "1"
		end if
		
	end if
	
	Form.SetEnvData(1, sKey, sValue)
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	'20230516 KKM START 스위치 버튼 
	Cont0.btnPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnPushVibKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnAlrimMarketKey.SetApplySwitch( "", "", 269, 261, 286, 289) 		
	Cont0.btnAlrimMarketVibKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
	'20230516 KKM END
	
	'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
	Cont0.btnMarketingPushKey.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnMarketingPushKey2.SetApplySwitch( "", "", 269, 261, 286, 286) 
	
	Cont0.btnPushKeyAlpha.bringFront("1")
	Cont0.btnMarketingPushKeyAlpha.bringFront("1")
	Cont0.Label4.setNeighborCtlPos("Image10", "right", 8, "스마트톡")
	
	g_sOSTYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	if g_sOSTYPE = "2" then
		Cont0.btnMarketingPushKey2.enable = false
	end if
	'20230901_01 HWG END
	
	g_sPushKey = "alarm.push"
	g_sPushVibKey = "alarm.push_vibration"
	g_sChegyulKey = "alrim.chegyul"
	g_sAlrimMarketKey = "alrim.market"
	g_sAlrimMarketVibKey = "alrim.market_vibration"
	G_SCREENCHOICE_FILE = "mhetc90000_p3"
	g_sWatchingViewKey = "alrim.watching_view"
	g_sMarketingPushKey = "alarm.push.marketing"	'20230901_01 HWG : 마케팅 푸시 시스템 신규구축
	
	'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
	GetConfigData(g_sPushKey, 1, 1)
	GetConfigData(g_sPushVibKey, 2, 1)
	GetConfigData(g_sMarketingPushKey, 8, 1)
	GetConfigData(g_sChegyulKey, 12, 1)
	GetConfigData(g_sAlrimMarketKey, 14, 1)
	GetConfigData(g_sAlrimMarketVibKey, 16, 1)
	'20230901_01 HWG END

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_SCREENCHOICE_FILE then
		if sRet == g_sChegyulKey then
			GetConfigData(g_sChegyulKey, 12, 1)
		end if
	end if
End Sub

'============================================================================
Sub Cont0_Table0_OnClick(lRow , lColumn)
'Form.ShowAlert(   "행열찾기  " & lRow & " :: " & lColumn)
	'색상있는 영역 클릭시에만 이벤트 처리
	If lColumn > 0 Then
		if lRow == 1 then '시스템중단,상품등안내Push
			SetConfigData(g_sPushKey, 1, 1)
			GetConfigData(g_sPushKey, 1, 1)
		'20230517 KKM END 
'		elseif lRow == 7 then 'Push알림시진동사용
'			SetConfigData(g_sPushVibKey, 7, 1)
'			GetConfigData(g_sPushVibKey, 7, 1)
		elseif lRow == 2 then 'Push알림시진동사용
			SetConfigData(g_sPushVibKey, 2, 1)
			GetConfigData(g_sPushVibKey, 2, 1)
			
		'20230901_01 HWG START : 마케팅 푸시 시스템 신규구축
		elseif lRow == 12 then '체결통보알림사용
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sChegyulKey , "")
'		elseif lRow == 13 then '장운영알림사용
		elseif lRow == 14 or lRow == 15 then '장운영알림사용
'			SetConfigData(g_sAlrimMarketKey, 13, 1)
'			GetConfigData(g_sAlrimMarketKey, 13, 1)
			SetConfigData(g_sAlrimMarketKey, 14, 1)
			GetConfigData(g_sAlrimMarketKey, 14, 1)
'		elseif lRow == 14 then '장운영알림진동사용
		elseif lRow == 16 then '장운영알림진동사용
''			SetConfigData(g_sAlrimMarketVibKey, 14, 1)
'			GetConfigData(g_sAlrimMarketVibKey, 14, 1)
			SetConfigData(g_sAlrimMarketVibKey, 16, 1)
			GetConfigData(g_sAlrimMarketVibKey, 16, 1)
		'20230901_01 HWG END
		
		'20230517 KKM END 	
		elseif lRow == 3 or lRow == 4 then '체결 Push 설정
			'알리미 약정 화면 이동
			
			Form.OpenScreen("87000" , "")
		elseif lRow == 5 or lRow == 6 then 'Watching Push 설정
			'Watching 화면 이동
			
			Form.OpenScreen("11020" , "")	
		end if
	End If
End Sub

