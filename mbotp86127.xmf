'--===========================================================================
'--===========================================================================

Dim g_MsboVrsn
Dim g_MOTPSrno
Dim g_MSBMotpSrno

'============================================================================
Sub Form_OnFormInit()

	EdtPinNo.SetApplyLabel("모바일OTP 비밀번호", 0, 76, "left", true)
	BtnNext.btnimage			= "btn_05.9"
	g_MsboVrsn = ""
	g_MOTPSrno = ""
	
	Form.OpenFramePopup("mhetc90060_p8" , "motp" , "")

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obaci_acct_185r" Then
   
		For i = 0 To DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1") - 1

			ACNO = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO"  , i)
			Form.SetCtlProp("CmbAcnt", "cbadddatatext", ACNO )
	    
		Next
	    
		Form.requestMOTP("MOTP_GET_VERSION" , "" , "86127")

	End If

	If szTranID = "obcsb_oimf_170a" Then
		If Len(g_MSBMotpSrno) > 0 Then
			Form.requestMOTP("MOTP_DISCARD", g_MSBMotpSrno, "86127") ' 단말에 있는 mOTP 폐기처리
		Else
			Form.requestMOTP("MOTP_DISCARD", g_MOTPSrno, "86127") ' 단말에 있는 mOTP 폐기처리
		End If
	End If
	
	If szTranID = "obcsb_oimf_172r" Then
	
		If DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MOTP_SRNO" , 0) == "" Then
			Form.MsgBox("OTP 정보 조회 오류" , "발급된 OTP정보가 존재하지 않습니다." , "", 6)
			BtnNext.caption = "닫  기"
		Else
			g_MOTPSrno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MOTP_SRNO" , 0)
			Form.requestMOTP("MOTP_GETINFO" , "" , "86127")
			BtnNext.enable = True
			EdtPinNo.enable = True
		End If
	
	End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID = "obcsb_oimf_170a" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("OTP 폐기 오류" , szErrMsg , "", 6)	
        Else
            Form.MsgBox("OTP 폐기 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If	    	    
	End If	
	
	If szTranID = "obcsb_oimf_172r" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.MsgBox("OTP 정보 조회 오류" , szErrMsg , "", 6)	
        Else
            Form.MsgBox("OTP 정보 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If	    	    
	End If	
	
End Sub


'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
'Form.ShowAlert(sEventName, sParam)

	tmpList = Split(sParam, "★")
	If sEventName == "MOTP_GET_VERSION_RETURN_86127" Then
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
			
              DATAMANAGER.SetDataValue(0 , "obcsb_oimf_172r" , "InBlock1" , "ACNO"     , 0 , CmbAcnt.caption)
              DATAMANAGER.SetDataValue(0 , "obcsb_oimf_172r" , "InBlock1" , "RCNO_PIP" , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
              DATAMANAGER.RequestTranData("obcsb_oimf_172r")			
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If        
    
    End If
    
	If sEventName == "MOTP_DISCARD_RETURN_86127" OR sEventName == "MOTP_DISCARD_RETURN86127" Then
		If tmpList[0] == "00000" Then
			Form.OpenNextPopup("mbotp86128" , "" , "")
		Else
			Form.ShowAlert("알림", "폐기 중 오류발생(" & tmpList[1] & ")")
		End If
	End If

	If sEventName == "MOTP_GETINFO_RETURN_86127" Then
		If tmpList[0] == "00000" Then
			g_MSBMotpSrno = tmpList[2]
		End If
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    If sKeyName == "CLOSE_YN" Then
        If sRet == "Y" Then
            Form.CloseForm()
        End If
    End If
    
	If sKeyName == "mhetc90060_p8" Then
		If sRet == "ok" Then
			DATAMANAGER.SetDataValue(0 , "obaci_acct_185r", "InBlock1" , "RCNO"     , 0 , "NMET")
			DATAMANAGER.SetDataValue(0 , "obaci_acct_185r", "InBlock1" , "RCNO_PIP" , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
			DATAMANAGER.RequestTranData("obaci_acct_185r")
		Else
			Form.ShowAlert("알림", "추가 인증이 완료되지 않았습니다.")
			Form.CloseForm()
		End If
	End If

End Sub


'============================================================================
Sub BtnNext_OnClick()
    
	If BtnNext.caption == "닫  기" Then
		Form.CloseForm()
	Else
		DATAMANAGER.RequestTranData("obcsb_oimf_170a")
	End If
    
End Sub

'============================================================================
Sub Image0_OnClick()
'	Form.OpenScreen("41000", "")
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_oimf_170a" Then
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "PROS_CLS_CODE"       , 0 , "D")
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "CSNO"                , 0 , ""                                      ) '서비스에서 구함
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ACNO"                , 0 , Left(CmbAcnt.caption,8)                 )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ACNT_PWD"            , 0 , ""                                      )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "MSBO_VRSN"           , 0 , g_MsboVrsn                              )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "CUST_TERM_ID"        , 0 , Form.GetDeviceID()                      )    
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "RCNO_PIP"            , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "MOTP_ATHN_DATA_CNTT" , 0 , EdtPinNo.caption                        )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "OS_CLCD"             , 0 , Form.GetSharedData("&OS_TYPE", False)   )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "OS_VRSN"             , 0 , Form.GetSharedData("&OS_VERSION", False))    
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "CUST_TERM_NAME"      , 0 , Form.GetDeviceModel()                   )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "MOTP_DNDL_YN"        , 0 , "N"                                     )        
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "MOTP_SRNO"           , 0 , g_MOTPSrno                              )
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "APLT_DATE"           , 0 , ""                                      ) '미사용
            DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "APLT_SRNO"           , 0 , 0                                       ) '미사용
	End If
End Sub

