'============================================================================
' 01.화면명 	: 해외지수
' 02.화면설명	: 해외지수_주요지수탭
' 03.작성	: 2016.01.05
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szNames		'설정Key
dim	g_szValues		'설정값
dim 	g_szCodes		'실제Input값
dim  g_szFutCode
		
dim g_szDate140r
dim g_szCode140r

g_szNames	= Array("41000_GOLD", "41000_WTI")
g_szValues	= g_szNames	'Array()
g_szCodes	= Array("COM@GC", "NYM@CL")
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'TR_Query()
'============================================================================
Function TR_Query()

	DATAMANAGER.RequestTranData("ohhts_1682_001r")
	DATAMANAGER.RequestTranData("ohhts_1682_001r_1")
	DATAMANAGER.RequestTranData("obfni_rmss_140r")
	DATAMANAGER.RequestTranData("ohhts_0510_001r")

end Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grd00.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd01.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd02.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd03.setUseCardView(true, 10, "img_bgbox_line1.9.png")

'	grd00.SetCellData("bd_name", 0, "금")
	grd01.SetCellData("bd_name", 0, "국고채")
	grd02.SetCellData("bd_name", 0, "선물")
'	grd03.SetCellData("bd_name", 0, "WTI")

	grd00.scrollenable = "0"
	grd01.scrollenable = "0"
	grd02.scrollenable = "0"
	grd03.scrollenable = "0"
	TR_Query()
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim	nIdx
	if szTranID = "ohhts_1682_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1682_001r")
		for	i = 0	to	1
			DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "FN" )
			DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_szCodes(i))
		next
	
	elseif szTranID = "ohhts_1682_001r_1" then
		DATAMANAGER.ClearInputData(0, "ohhts_1682_001r_1")
		DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "FN" )
		DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_1", "InBlock1", "FID_INPUT_ISCD" , 0 , "NYM@CL" )
	
	elseif	szTranID	=	"obfni_rmss_140r"	then
		DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", 	"InBlock1", "OVRS_PRMR_NMIX_CLCD", 0, "4")	'국고채
	
	elseif szTranID = "ohhts_1500_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "F")	'선물
		DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD",0, g_szFutCode)
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	dim ncnt1682
	dim szRealCode
	
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")

	if 		szTranID = "ohhts_1682_001r" then 
		ncnt1682 = DATAMANAGER.GetDataCount(0, "ohhts_1682_001r" , "OutBlock1")
		for i = 0 to ncnt1682 - 1
		  szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_ISCD", i )
		  DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", i, szRealCode) 
		Next	    
		DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
		
	elseif	szTranID	=	"ohhts_0510_001r"	then
		g_szFutCode = TRIM(DATAMANAGER.GetDataValue(0, "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD", 0))
		if g_szFutCode	<>	""	then
			DATAMANAGER.RequestTranData("ohhts_1500_001r")
		end if

	elseif 	szTranID = "ohhts_1500_001r" then 
		DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szFutCode)
		DATAMANAGER.RequestRealData("ohhts_futs_cntg")
		
	elseif	szTranID	=	"obfni_rmss_140r"	then
		szPrpr = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0)
		szSign = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0)
		szVrss = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0)
		szCtrt = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_CTRT" , 0)
		g_szDate140r = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , 0)
		g_szCode140r = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_ISCD", 0)

		grd01.SetCellData("bd_pr", 0, szPrpr)
		grd01.SetCellData("bd_debi", 0, szSign)
		grd01.SetCellData("bd_prdy", 0, szVrss)
		grd01.SetCellData("bd_ctrt", 0, szCtrt)
		
		if szSign  == "1" or szSign == "2" then 
			szColor = "10"
		elseif szSign  == "4" or szSign == "5" then 
			szColor = "11"
		else
			szColor = "12"
		end if
		
		grd01.SetCellFgColor( "bd_pr", 0, szColor )	
		grd01.SetCellFgColor( "bd_prdy", 0, szColor )	
		grd01.SetCellFgColor( "bd_ctrt", 0, szColor )
	end if 	
	
	grd00.rowcount = 1
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Form.bgcolor = "320"
End Sub

'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	Form.OpenFramePopup("mhidx42040_p1" , g_szCode140r & "★" &  "RATE" & "★" & "국고채" & "★" & g_szDate140r , "")
End Sub

'============================================================================
Sub grd00_OnClickUp(lRow, szCellID)
	call grd_OnClickUp(0, "bd_cell0")
End Sub

'============================================================================
Sub grd03_OnClickUp(lRow, szCellID)
	call grd_OnClickUp(1, "bd_cell0")
End Sub

'============================================================================
Sub grd02_OnClickUp(lRow, szCellID)
	szName 	= grd02.GetCellData("bd_name", 0)
	
	Form.OpenFramePopup("mhidx42040_p1" , g_szFutCode & "★" &  "F" & "★" & szName , "")
End Sub
'============================================================================
Sub grd_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd.GetCellData( "bd_cell0", lRow )
	szMarket = grd.GetCellData( "bd_cell1", lRow )
	szName	= grd.GetCellData( "bd_cell2", lRow )
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "Reload_Data" then
		TR_Query()
	end if	
End Sub

