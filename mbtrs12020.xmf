'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName

	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'20190207 LES START - 최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 
		
		end if
		
		For i = 0 to szLen
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			
			if szMk <> "T" then
				Form.setItemCode(tList(i))
				exit Function
			end if
		Next
		'20190207 LES END
	else
		Form.setItemCode("008560")
	end if
End Function
