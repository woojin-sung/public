'============================================================================


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "11000_p1_Close" Then
		If Trim(sRet) <> "종목없음" Then
			'20220203 SWJ START : 최근조회종목에서 주문창 연동시, 호가창 안바뀌는 현상 수정
'			g_szCd = sRet
'			g_szMk = Form.GetItemCodeInfo( g_szCd , "market")			

			Form.SetItemCode(sRet)
			'20220203 SWJ END
		End If
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				edtPwd_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
	
	
	'--------------------------------
	'20240617 HSZ START - 해외/국내 종목선택창 통합
	'--------------------------------
	elseif sKeyName == "DLG_SELECT" then
		
		'--------------------------------
		'sRet = 138040★메리츠금융지주★KRX
		'--------------------------------		
		Dim arrRetData, sItemCd
		arrRetData = Split(sRet,"★")
		
		if #arrRetData > 2 then
			sItemCd = arrRetData(0)
			Form.SetItemCode(sItemCd)
		End if	
		
	'--------------------------------
	'20240617 HSZ END
	'--------------------------------
		
	end if
	
End Sub

