Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)

	'20240617 HSZ START - 해외/국내 종목선택창 통합
'	' 종목컨트롤에서 리턴
'	if sDlgName == "SEARCH" then
'		if Trim(sReturn1) <> "" then		
'			'20180906 LES START KOTC상품추가
'			szMk = Form.GetItemCodeInfo(sReturn1, "market")
'			if szMk = "T" then
'			else
'				Check_ELW(sReturn1)									' ELW종목 여부
'				'Request_Hoga()
'				
'				nTab = fmTab.currenttab
'				if nTab = 0 then
'					szType = Form.GetSharedData("STOCK_BUYTYPE", false)
