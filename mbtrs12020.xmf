'======================================
' Form_OnFormInit
'======================================
Sub Form_OnFormInit()

	'-----------------------------------------------------------------------------
	' 20240617 HSZ START - 상단 돋보기버튼 눌렀을때, 메인쪽에서 "TITLE_CLICK" 으로 내려줄수 있도록
	'-----------------------------------------------------------------------------
	Form.setSearchTypeClick("1")
	
	Dim szCd
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	Load_OrderSet()
	
	'10호가창 중간위치
	contHoga.scroll_pos = "vcenter"
	
	'20180720 LES START - KOTC시장 추가
	'20180823 LES START - 예약주문 KOTC추가 보류
	' 종목컨트롤
	'Form.SetSearchType ("1:2:3:5:6:15")
	'Form.SetSearchType ("1:2:3:5:6")
	Form.SetSearchType ("29:1:5:6:3")		'20220922 SWJ START : 최근조회 탭 추가
	'20180720 LES END
	
'	g_nfmTab = CDbl( Form.LoadConfigData( "mhprc12020", "frmTab" ) )
'	fmTab.currenttab = g_nfmTab
'	fmTab_OnTabChanged( g_nfmTab )

	' 다른화면에서 화면오픈시 or 최근조회종목  -------------------------------
	szOpen = Form.GetOpenLinkData()
	
	if szOpen <> "" then
		tData = Split(szOpen, "★")
	
		szCd = tData(0)
		
		' 폼탭변경(0:매수, 1:매도, 2:정정, 3:취소)
		if Trim(tData(1)) = "" then
			fmTab.currenttab = "0"
		else
			fmTab.currenttab = tData(1)
		end if
	else
		szCd = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	end if
	' -----------------------------------------------------------------------
	
	'20180823 LES START - KOTC 예약주문 추가 보류
	szMk = Form.GetItemCodeInfo(szCd, "market")
	
	if szMk = "T" then
		Form.Toast(0,"K-OTC 종목은 예약주문 사용이 불가능합니다." , 1)
		Exit Sub
	end if
	'20180823 LES END
	
	
	Form.SetItemCode(szCd)						' 최초 화면진입시 종목코드 설정
	
	Check_ELW(szCd)									' ELW종목 여부
	
	fmTab_OnTabChanged( CInt(fmTab.currenttab ) )
	
	'Form.triggerEvent("linkfm", "INIT_CODE", szCd)	' 링크화면에 종목코드 던지기
'	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", szCd)	' 폼탭화면에 종목코드 던지기
	
	'Request_Hoga()
	'Change_HOGA_Request(szCd, "0")
End Sub

'======================================
' Form_OnLinkData
'======================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		'g_szCd = sValue
		
		'20221005_01 HWG START : 거래소 차세대 대응
		'20180906 LES START KOTC상품추가
'		szMk = Form.GetItemCodeInfo(sValue, "market")
'		if szMk = "T" then
'			Form.Toast(0,"K-OTC 종목은 예약주문 사용이 불가능합니다." , 1)
'			
'			szOSType = Form.GetSharedData("&OS_TYPE", false )
'			
'			if szOSType = "1" then
'				szRecent = Form.GetRecentHistory("1")
'				Load_RecentList(szRecent)
'			end if
'			
'			Exit Sub
'		end if
		'20180906 LES END
		'20221005_01 HWG END
		
		Check_ELW(sValue)									' ELW종목 여부
		'Request_Hoga()
		
		nTab = fmTab.currenttab
		if nTab = 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif nTab = 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif nTab = 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif nTab = 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
		if Trim(szType) = "" or szType = null then
			szType = "0"
		end if

		if sValue <> g_szCd then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		end if

		Change_HOGA_Request(sValue, szType)
	elseif sKey = "&ACR_ITEM" then
	
		'20180823 LES START - KOTC 예약주문 추가 보류
		szMk = Form.GetItemCodeInfo(sValue, "market")
	
		if szMk = "T" then
			Form.Toast(0,"K-OTC 종목은 예약주문 사용이 불가능합니다." , 1)
			Exit Sub
		end if
		'20180823 LES END
	
	
	
		Form.SetItemCode(sValue)
		
		'g_szCd = sValue
		
		Check_ELW(sValue)									' ELW종목 여부
		'Request_Hoga()
		
		nTab = fmTab.currenttab
		if nTab = 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif nTab = 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif nTab = 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif nTab = 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
		if Trim(szType) = "" or szType = null then
			szType = "0"
		end if

		if sValue <> g_szCd then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		end if

		Change_HOGA_Request(sValue, szType)
	end	if	
End Sub

