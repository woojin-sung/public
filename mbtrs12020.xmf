'======================================
' Form_OnTriggerEvent
'======================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szType
	
	if sEventName = "12000_BUYTYPE" then
		szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		Form.triggerEvent("linkfm", "12000_BUYTYPE", "")
	elseif sEventName = "12000_SELTYPE" then
		szType = Form.GetSharedData("STOCK_SELTYPE", false)
		Form.triggerEvent("linkfm", "12000_SELTYPE", "")
	elseif sEventName = "12000_MODTYPE" then
		szType = Form.GetSharedData("STOCK_MODTYPE", false)
		Form.triggerEvent("linkfm", "12000_MODTYPE", "")
	elseif sEventName = "12000_CNLTYPE" then
		szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		Form.triggerEvent("linkfm", "12000_CNLTYPE", "")
	elseif sEventName = "BALANCE_SELL" then
		fmTab.currenttab = "0"
		Form.triggerEvent("fmTab.page001992", szEventName, sParam)
		
	ElseIf sEventName = "TITLE_CLICK" Then
'		'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
'		'Form.OpenPopup("mhprc11000_p1" , "" , "")
'		'20221005_01 HWG START : 거래소 차세대 대응
'		Form.OpenCommonDialog("SEARCH", "29:1:5:6:3", "MAIN")
'		'20221005_01 HWG END
'		'20220922 SWJ END

		'20240617 HSZ START - 해외/국내 종목선택창 통합
		Form.OpenPopup("msearchdialog", "종목검색★40:41:42:43:44:45:46:47:48★INTG_DLG_HISTORY★KRX★16061", "")
		'20240617 HSZ END
		
	ElseIf sEventName = "SCREEN_MENU" Then							' 연결메뉴(상단 ...)
		
		If sParam = "POP_UP1" Then									' 투자의견
			' 종목코드
			szCd = Change_ItemCode()
			Form.OpenScreen("11000" , szCd & "★투자의견" )
			
		ElseIf sParam = "POP_UP2" Then								' 예수금			
			Form.OpenPopup("mbtrs12000_pe", acnt.total & "★" & acnt.sequence, "")
			
		ElseIf sParam = "POP_UP3" Then								' 주문가능
			' 종목코드
			szCd = Change_ItemCode()
	
			if Trim(lblPrc.caption) == "" then
				Form.OpenPopup("mbtrs12000_pf", acnt.total & "★" & acnt.sequence & "★" & szCd & "★" & lblHyun.caption, "")	
			else
				Form.OpenPopup("mbtrs12000_pf", acnt.total & "★" & acnt.sequence & "★" & szCd & "★" & lblPrc.caption, "")	
			end if
			
		ElseIf sParam = "POP_UP4" Then								' 예약주문 유의사항
			Form.OpenPopup("mbtrs12020_p1" , "" , "")
		End If
		
	End If

	if Trim(szType) = "" or szType = null then
		szType = "0"
	end if

	Change_HOGA_Request(g_szCd, szType)
End Sub

'======================================
' fmTab_OnTabChanged
'======================================
Sub fmTab_OnTabChanged(nCurrentTab)

	Dim szType
	
	lblPrc.caption = ""
	g_nfmTab = nCurrentTab
	
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", g_szCd)	' 폼탭화면에 종목코드 던지기
	
	if nCurrentTab = 0 or nCurrentTab = 1 then
		tblOldHigh.visible = true
		tblOldLow.visible  = true
		contHoga.visible	 = true

		if nCurrentTab = 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
			Form.triggerEvent("linkfm", "12000_BUYTYPE", "")
		elseif nCurrentTab = 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
			Form.triggerEvent("linkfm", "12000_SELTYPE", "")
		end if
	else
		tblOldHigh.visible = false
		tblOldLow.visible  = false
		contHoga.visible	 = false
		
		if nCurrentTab = 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
			Form.triggerEvent("linkfm", "12000_MODTYPE", "")
		elseif nCurrentTab = 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
			Form.triggerEvent("linkfm", "12000_CNLTYPE", "")
		end if	
	end if
	
	if Trim(szType) = "" or szType = null then
		szType = "0"
	end if
	
	'Change_HOGA_Request(szType)
	Change_HOGA_Request(g_szCd, szType)
	Return_AutoPrice()
End Sub

'======================================
' DATAMANAGER_OnSendTranBefore
'======================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 주문(현재가)_ 주식/ELW
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_2020_001r" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "12000_HOGA", "")
			
		DATAMANAGER.ClearInputData(0, "ohhts_2020_001r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_2020_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_2020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		
	' ----------------------------------------------------------------------
	' 예약주문용 TR(주식용)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_0800_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_0800_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMk )	' 시장분류코드
		DATAMANAGER.SetDataValue(0, "ohhts_0800_001r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szCd )	' 종목코드
	end if	
End Sub

'======================================
' DATAMANAGER_OnReceiveTranComplete
'======================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_2020_001r" then			
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		
		if g_szMk = "W" then		
			DATAMANAGER.RequestRealData("ohhts_elw_aspr")
		
		'20180720 LES START
		elseif g_szMk = "T" then
			
			DATAMANAGER.RequestRealData("ohhts_frbr_aspr")
		'20180720 LES START
		
		else
			DATAMANAGER.RequestRealData("ohhts_stck_aspr")
		end if
		
		
    end if
    
    Return_AutoPrice()
End Sub

'======================================
' DATAMANAGER_OnSendRealBefore
'======================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 주식체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_stck_incg" then '20220214 HSZ 시세속도 개선 (cntg->incg)
		
		DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주식호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_stck_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_elw_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		
	
	'20180720 LES START - KOTC시장 추가
	elseif szTranID = "ohhts_frbr_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	
	elseif szTranID = "ohhts_frbr_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	'20180720 LES END
		
	end if
End Sub

