Sub Form_OnFormClose()
	Form.SetSharedData("STOCK_BUYTYPE", "")
	Form.SetSharedData("STOCK_SELTYPE", "")
	
'	Form.SaveConfigData("mhprc12020", "frmTab", g_nfmTab)
