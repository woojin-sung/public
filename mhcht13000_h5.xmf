	<SCRIPT_INFO _len="1967" _ulen="1899" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 추가증거금 청산주문
' 02. 화면설명 : 추가증거금 청산주문 팝업화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
g_szType = {"주", "월", "년"}	'PENTA13 START => 2019.03.04

Dim g_szData
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szData = Form.GetOpenLinkData()
	
	for i = 0 to Grid0.rowcount-1
		if g_szType[i] = null or g_szType[i] = "" then
			g_szType[i] = "120"
		end if
		Grid0.SetCellData( "bd_cell0", i, g_szType[i])
		if g_szData == g_szType[i] then
			Grid0.selectrow = i
		end if	
	next
	
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	sData = Grid0.GetCellData( szCellID, lRow)
	Form.SendReturnToParent( "Chart_WEEK" , sData )
	Form.CloseForm( )
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "Chart_WEEK" , g_szData )
	Form.CloseForm( )	
End Sub



