	<SCRIPT_INFO _len="10130" _ulen="9418" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵체결내역
' 02. 화면설명 : 선옵체결내역
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szACNO, g_szASNO
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북
Dim g_szTitle
g_szTitle = "알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

End Sub

'============================================================================
Sub Form_OnFormInit()
	'cldFrom.caption = Form.GetSharedData("&NGHT_BIZ_DT", false )
	'cldTo.caption   = Form.GetSharedData("&NGHT_BIZ_DT", false )
	Dim night_date 
	night_date = Form.GetSharedData("&NGHT_BIZ_DT",  false )

	cldFrom.caption = night_date
	cldTo.caption   = night_date

	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno, szAsno
	
	szAcno = acnt0.total
	szAsno = acnt0.sequence

	DATAMANAGER.SetDataValue( 0, "obtrf_cntg_812r", "InBlock1", "ACNO" 			, 0 , szAcno	)
	DATAMANAGER.SetDataValue( 0, "obtrf_cntg_812r", "InBlock1", "ASNO" 			, 0 , szAsno 	)
	DATAMANAGER.SetDataValue( 0, "obtrf_cntg_812r", "InBlock1", "FTOP_TYPE_CODE" 	, 0 , "0" 	) '0:전체, 1:선물, 2:콜옵션, 3:풋옵션
	DATAMANAGER.SetDataValue( 0, "obtrf_cntg_812r", "InBlock1", "SORT_SEQ"		, 0 , "2" 	) '2:역순, 1:주문순
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	
	For iCnt = 0 To grd0.rowcount - 1
		
		'매매구분
		szData = grd0.GetCellData( "bd_cell20", iCnt)
		Select Case szData
			Case "1" grd0.SetCellData("bd_cell2", iCnt, "매도")
					grd0.SetCellFgColor("bd_cell2", iCnt, "11")
			Case "2" grd0.SetCellData("bd_cell2", iCnt, "매수")
					grd0.SetCellFgColor("bd_cell2", iCnt, "10")
			Case "3" grd0.SetCellData("bd_cell2", iCnt, "매수청산")
					grd0.SetCellFgColor("bd_cell2", iCnt, "10")
			Case "4" grd0.SetCellData("bd_cell2", iCnt, "매도청산")
					grd0.SetCellFgColor("bd_cell2", iCnt, "11")
			Case "5" grd0.SetCellData("bd_cell2", iCnt, "권리행사")
			Case "6" grd0.SetCellData("bd_cell2", iCnt, "의무배정")
			Case "7" grd0.SetCellData("bd_cell2", iCnt, "행사포기")
			Case "8" grd0.SetCellData("bd_cell2", iCnt, "의무면제")
			Case "A" grd0.SetCellData("bd_cell2", iCnt, "인수대금")
			Case "B" grd0.SetCellData("bd_cell2", iCnt, "인도대금")
			Case "C" grd0.SetCellData("bd_cell2", iCnt, "단주행사")
			Case "D" grd0.SetCellData("bd_cell2", iCnt, "단주배정")
			Case "0" grd0.SetCellData("bd_cell2", iCnt, "상계")
		End Select
		
		'주문유형
		szData = grd0.GetCellData( "bd_cell15", iCnt)
		Select Case szData
			Case "1" grd0.SetCellData("bd_cell3", iCnt, "시장가")
			Case "2" grd0.SetCellData("bd_cell3", iCnt, "지정가")
			Case "3" grd0.SetCellData("bd_cell3", iCnt, "경쟁대량(현물만 해당)")
			Case "I" grd0.SetCellData("bd_cell3", iCnt, "조건부지정가")
			Case "X" grd0.SetCellData("bd_cell3", iCnt, "최유리 지정가")
			Case "Y" grd0.SetCellData("bd_cell3", iCnt, "최우선 지정가")
			Case "T" grd0.SetCellData("bd_cell3", iCnt, "시장가(실시간 가격제한)")
			Case "W" grd0.SetCellData("bd_cell3", iCnt, "최유리지정가(실시간 가격제한)")
			Case "J" grd0.SetCellData("bd_cell3", iCnt, "지정가 전환")		
		End Select
		
		'정정/취소
'		szData = Form.GetMetaData("정정취소구분코드", grd0.GetCellData( "bd_cell18", iCnt) )		
'		grd0.SetCellData("bd_cell16", iCnt, szData)
		
		szData2 = grd0.GetCellData( "bd_cell19", iCnt)
		Select Case szData2
			Case "1"	grd0.SetCellData("bd_cell16", iCnt, "정상")
			Case "2"	grd0.SetCellData("bd_cell16", iCnt, "정정접수")
			Case "3"	grd0.SetCellData("bd_cell16", iCnt, "정정확인")
			Case "4"	grd0.SetCellData("bd_cell16", iCnt, "취소접수")
			Case "5"	grd0.SetCellData("bd_cell16", iCnt, "취소확인")
		End Select
		
		'거부사유
		if len(trim(grd0.GetCellData("bd_cell12", iCnt))) > 0 then
			szData = Form.GetMetaData("주문거부사유코드", grd0.GetCellData( "bd_cell12", iCnt) )
			grd0.SetCellData("bd_cell13", iCnt, szData)
			'Form.ShowAlert(grd0.GetCellData("bd_cell12", iCnt), "1")
			
		else
			szData = grd0.GetCellData( "bd_cell21", iCnt)
			grd0.SetCellData("bd_cell13", iCnt, szData)
		end if
		
		
	Next
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrf_cntg_812r" )
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
Dim szItemCode, szItemMarket, szQty, szGbn, szData

	szItemCode = grd0.GetCellData("bd_cell14", lRow)

	If Left( Trim(szItemCode), 1 ) = "K" Then
		g_szItemCode	= Right( Trim(szItemCode), Len(Trim(szItemCode)) - 1)
	Else
		g_szItemCode	= szItemCode
	End If
	
	szItemMarket 	= Form.GetItemCodeInfo(g_szItemCode, "market_night")
	
	
	
	' 지수선물/미니선물/옵션/미니옵션만 가능, 위클리(EW)추가
	if Trim(szItemMarket) == "CM" or Trim(szItemMarket) == "EO" or Trim(szItemMarket) == "EM" or Trim(szItemMarket) == "EW" then
	   Dim szOdrNo, szQty, szOdrType, szOdrPrc, szClsCd
	   
		listLocation =  Split(grd0.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
	
		sPopupType = "4"
		
						
		szOdrNo   = grd0.GetCellData("bd_cell1", lRow)	
		szQty	 = grd0.GetCellData("bd_cell8" , lRow)		
		szOdrType = grd0.GetCellData("bd_cell15", lRow)
		szOdrPrc  = grd0.GetCellData("bd_cell4" , lRow)
		szClsCd   = grd0.GetCellData("bd_cell9" , lRow)
		
	
		' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
		' 전달내용, 탭위치는 리턴받아서 처리함.	
		g_szData = g_szItemCode & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
	
		If CInt( szQty ) > 0 Then
			Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "미체결수량: " & CInt( szQty ) & "★" & "정정" & "★" & "취소" & "★" & "" & "★" & "")	
		End If
	Else
		Form.ShowAlert(g_szTitle, "선택상품은 MTS에서 거래되지 않는 상품입니다.")
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	If sKeyName = "mbtrs35056" Then
		Dim arrData
	
		arrData = Split(sRet,"|")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if
		
		rdoCNTG.currentindex 	= arrData(1)
		rdoMedosu.currentindex	= arrData(2)
		cldFrom.caption		= arrData(3)
		cldTo.caption			= arrData(4)
		
		If acnt0.caption <> arrData(0) Then
			acnt0.caption = arrData(0)
		Else
			btnSearch_OnClick()
		End If
		
	ElseIf sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
'		Form.ShowAlert("g_szData", g_szData)
		
		if	szListItems(1)	=	"0"	then			'현재가
'			Form.OpenScreen("31000" , g_szItemCode & "★" & "0") 
			
		elseif 	szListItems(1)	=	"1"	then		'정정
			Form.OpenScreen("41030" , "미체결" & "★" & "2" & "★" & g_szData ) 
		elseif 	szListItems(1)	=	"2"	then		'취소
			Form.OpenScreen("41030" , "미체결" & "★" & "3" & "★" & g_szData ) 
		end if
		
		g_szData = ""
		
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		End If
		
	End If
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert( szErrCode , szErrMsg )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	szData = rdoCNTG.currentindex & "|" & rdoMedosu.currentindex  & "|" & cldFrom.caption  & "|" & cldTo.caption


	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrf35056_h0" , szData , "" )
		
	ElseIf sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "1", "")
			
		End If
	End If
	
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	btnSearch_OnClick()	
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
	
End Sub

