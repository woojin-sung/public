'============================================================================
' 화 면 명 : 관심종목_스타일2(채권)
' 화면설명 : 관심종목_스타일2에서 채권상품 선택시 조회
' 작    성 : 2016.01.05 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk

Dim g_szGwanData
g_szGwanData = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Init_tblInfo
'============================================================================
Function Init_tblInfo()
	tblInfo.SetCellString(0, 0, "")
	tblInfo.SetCellString(1, 0, "")
	
	For i = 3 to tblInfo.rowcount-1
		tblInfo.SetCellString(i, 1, "")
		tblInfo.SetCellString(i, 2, "")
	Next
End Function

'============================================================================
' gf_tonumber
'============================================================================
function gf_tonumber(szData)
	return tonumber(szData) or 0
end function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 스타일2화면에서 트리거 받음
	if sEventName == "JMCODE" then
		DATAMANAGER.CancelRealData("ohhts_smbd_cntg")			'  자동갱신 취소
		DATAMANAGER.CancelRealData("ohhts_smbd_cntg_1")		'  자동갱신 취소
		
		Init_tblInfo()
	
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")
			tblInfo.SetCellString(0, 0, tData(0))		' 종목코드
			tblInfo.SetCellString(1, 0, tData(2))		' 종목명
			
			g_szCd = tData(0)	
			g_szMk = tData(1)	
			
			' 기본 세팅후 조회
			DATAMANAGER.RequestTranData("ohhts_7052_001r")	' 채권현재가
			DATAMANAGER.RequestTranData("ohhts_7052_003r")	' 채권현재가(차트)
		end if
		
		g_szGwanData = Form.GetSharedData("PRE_GWAN_GRID_POS", true )
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg")			'  자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg_1")		'  자동갱신 취소
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	' ----------------------------------------------------------------------
	' 채권현재가
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_7052_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
	' ----------------------------------------------------------------------
	' 채권현재가(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_003r" then
		DATAMANAGER.SetDataValue(0, "ohhts_7052_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_003r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 채권현재가
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_7052_001r" then
		' 발행가격
		szData = DATAMANAGER.GetDataValue(0, "ohhts_7052_001r", "OutBlock1", "FID_PBLC_PRC", 0)
		
		szAmt = gf_tonumber(szData)
		
		if szAmt == "" then
			szAmt = 0
		else
			szAmt = CInt(szAmt) / 10000	
		end if
		
		tblInfo.SetCellString(3, 1, szAmt)

		DATAMANAGER.RequestRealData("ohhts_smbd_cntg")	
	' ----------------------------------------------------------------------
	' 채권현재가(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_003r" then		
		DATAMANAGER.RequestRealData("ohhts_smbd_cntg_1")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 채권 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_smbd_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_smbd_cntg", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 채권 자동갱신(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_smbd_cntg_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_smbd_cntg_1", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd)		
	end if
End Sub

''============================================================================
'' btnHyun_OnClick
''============================================================================
'Sub btnHyun_OnClick()
'	Form.OpenScreen("" , g_szCd)
'End Sub

'============================================================================
' btnChart_OnClick
' 20160602 NOHES 차트현재가 화면과 연동되어 있음. 현재가 버튼으로 변경
'============================================================================
Sub btnChart_OnClick()
	Form.OpenScreen("54010" , "관심종목★" & g_szCd & "★4")
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

'============================================================================
' btnBuy_OnClick
'============================================================================
Sub btnBuy_OnClick()
	Form.OpenScreen("54020" , "관심종목★0" & "★" & g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

'============================================================================
' btnSell_OnClick
'==========================================================================
Sub btnSell_OnClick()
	Form.OpenScreen("54020" , "관심종목★1" & "★" & g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

