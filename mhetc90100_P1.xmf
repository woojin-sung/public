	<SCRIPT_INFO _len="3249" _ulen="3249" >
Dim g_nFontSize,g_szTitle,g_szDate,g_szURL	
Dim g_nIndex
'============================================================================
Sub Form_OnFormInit()
	
	Label0.caption = g_szTitle
	Label1.caption = g_szDate
	WebView0.urlpath = g_szURL
	
'	szValue = Form.GetSharedData( "&HOST_DATE", false  )
'	DATAMANAGER.SetDataValue(0, "ohhts_note_003r", "InBlock1", "FID_INPUT_DATE", 0 , szValue )
'	DATAMANAGER.RequestTranData("ohhts_note_003r")
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	'DATAMANAGER.RequestNextData( "ohhts_note_003r")
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szTitle		= arrData(0)
	g_szDate			= arrData(1)
	g_szURL			= arrData(2)
	
End Sub

'============================================================================
Sub btnZoomIn_OnClick()
	if g_nFontSize = 0 then
		WebView0.fontsize = 1
		g_nFontSize = 1
	elseif g_nFontSize = 1 then
		WebView0.fontsize = 2
		g_nFontSize = 2
	elseif g_nFontSize = -2 then
		WebView0.fontsize = -1
		g_nFontSize = -1
	elseif g_nFontSize = -1 then 
		WebView0.fontsize = 0
		g_nFontSize = 0
	else 
		WebView0.fontsize = 2
		g_nFontSize = 2
	end if	
End Sub

'============================================================================
Sub btnZoomOut_OnClick()
	if g_nFontSize = 0 then
		WebView0.fontsize = -1
		g_nFontSize = -1
	elseif g_nFontSize = -1 then
		WebView0.fontsize = -2
		g_nFontSize = -2
	elseif g_nFontSize = 2 then
		WebView0.fontsize = 1
		g_nFontSize = 1
	elseif g_nFontSize = 1 then 
		WebView0.fontsize = 0
		g_nFontSize = 0
	else
		WebView0.fontsize = -2
		g_nFontSize = -2
	end if	
End Sub

'============================================================================
Sub Button0_OnClick()
	g_nIndex = g_nIndex - 1
	if g_nIndex < 0 then
		g_nIndex = 0
	else
		Label0.caption = Grid0.GetCellData("bd_cell0", g_nIndex)
		Label1.caption = Grid0.GetCellData("bd_cell1", g_nIndex)
		WebView0.urlpath = Grid0.GetCellData("bd_cell2", g_nIndex)
		
	end if
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Button2_OnClick()
	g_nIndex = g_nIndex + 1
	if g_nIndex >= Grid0.rowcount then
		g_nIndex = Grid0.rowcount - 1
	else
		Label0.caption = Grid0.GetCellData("bd_cell0", g_nIndex)
		Label1.caption = Grid0.GetCellData("bd_cell1", g_nIndex)
		WebView0.urlpath = Grid0.GetCellData("bd_cell2", g_nIndex)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_note_003r" then
		for i = 0 to Grid0.rowcount - 1
			sData = Grid0.GetCellData("bd_cell2", i )
			if sData ==  g_szURL then
				g_nIndex = i
			end if
		next	
	end if	
End Sub

