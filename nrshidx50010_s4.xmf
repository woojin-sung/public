'============================================================================
Sub Form_OnFormInitBefore()
	
	Image0.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	LabelScreenTitle.paddinginfo = "0,0,0,0"

	LabelTitle0.paddinginfo = "0,0,0,0"
	LabelDate0.paddinginfo = "0,0,0,0"
	LabelName0.paddinginfo = "0,0,0,0"
	
	LabelTitle1.paddinginfo = "0,0,0,0"
	LabelDate1.paddinginfo = "0,0,0,0"
	LabelName1.paddinginfo = "0,0,0,0"
	
	LabelTitle2.paddinginfo = "0,0,0,0"
	LabelDate2.paddinginfo = "0,0,0,0"
	LabelName2.paddinginfo = "0,0,0,0"
	
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	Image3.setMaintainingRatio("1")
	
	Image1.imgpath = "icon_report"
	Image2.imgpath = "icon_report"
	Image3.imgpath = "icon_report"
	
	
	DATAMANAGER.RequestTranData("ooopc_rprt_003r")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "ooopc_rprt_003r"  then
		
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_GRP_ID" 				, 0 , "bascGrp")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_ID" 					, 0 , "sih02")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_CNTT_DIV_CODE" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_CNTT_WRTR_NAME" 		, 0 , "%")
		'DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_CNTT_TITL_NAME" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_CNTT_TITL_NAME" 		, 0 , "ETF")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "STA_DATE" 				, 0 , "00000000")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "FIN_DATE" 				, 0 , "99999999")
		'DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_CNTT_SPLM_ITEM_VAL11" 	, 0 , "Meritz Bi-Weekly")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "BBS_CNTT_SPLM_ITEM_VAL11" 	, 0 , "")
		
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_003r", "InBlock1", "IQRY_CLS_CODE" 			, 0 , "1")
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ooopc_rprt_003r"  then
		
		nCnt = DATAMANAGER.GetDataCount(0, "ooopc_rprt_003r", "OutBlock1")
		
		if nCnt > 3 then
			nCnt = 3
		end if
		
		for i = 0 to nCnt - 1
		
			sTitle 	= DATAMANAGER.GetDataValue(0, "ooopc_rprt_003r", "OutBlock1", "BBS_CNTT_TITL_NAME" , i)
			sDate 	= DATAMANAGER.GetDataValue(0, "ooopc_rprt_003r", "OutBlock1", "BBS_CNTT_WRTN_YMDH" , i) 
			sDate 	= Left(sDate,10)
			
			sName	 = DATAMANAGER.GetDataValue(0, "ooopc_rprt_003r", "OutBlock1", "BBS_CNTT_WRTR_NAME" , i) 
			sFileName = DATAMANAGER.GetDataValue(0, "ooopc_rprt_003r", "OutBlock1", "BBS_ATCH_ORTX_FILE_NAME" , i)
			sSeqNo 	 = DATAMANAGER.GetDataValue(0, "ooopc_rprt_003r", "OutBlock1", "BBS_CNTT_TURN_NO" , i)
			
			if i == 0 then
			
				LabelTitle0.visible = true
				LabelDate0.visible = true
				LabelName0.visible = true
				Image1.visible = true
				
				'LabelTitle0.SetMaxLineCount(2)
				LabelTitle0.maxlinecnt="2^-2"
				LabelTitle0.caption = sTitle
				LabelDate0.caption = Replace(sDate,"/",".")
				LabelName0.caption = sName
				LabelFileName0.caption = sFileName
				LabelSeqNo0.caption = sSeqNo
				
			elseif i == 1 then
			
				separator0.visible = true
				LabelTitle1.visible = true
				LabelDate1.visible = true
				LabelName1.visible = true
				Image2.visible = true
			
				'LabelTitle1.SetMaxLineCount(1)
				LabelTitle1.maxlinecnt="2^-2"
				LabelTitle1.caption = sTitle
				LabelDate1.caption = Replace(sDate,"/",".")
				LabelName1.caption = sName
				LabelFileName1.caption = sFileName
				LabelSeqNo1.caption = sSeqNo
			
			elseif i == 2 then
				
				separator1.visible = true
				LabelTitle2.visible = true
				LabelDate2.visible = true
				LabelName2.visible = true
				Image3.visible = true
			
				'LabelTitle2.SetMaxLineCount(1)
				LabelTitle2.maxlinecnt="2^-2"
				LabelTitle2.caption = sTitle
				LabelDate2.caption = Replace(sDate,"/",".")
				LabelName2.caption = sName
				LabelFileName2.caption = sFileName
				LabelSeqNo2.caption = sSeqNo
				
			end if
		
		next
		
	
	end if
	
End Sub

'============================================================================
' 첫번째 PDF 오픈
'============================================================================
Sub Image1_OnClick()

	sFileName = LabelFileName0.caption
	OpenPdfViewer(sFileName)
	
End Sub

'============================================================================
Sub LabelTitle0_OnClick()

	sFileName = LabelFileName0.caption
	OpenPdfViewer(sFileName)
	
	'szTitle 		= LabelTitle0.caption
	'szDate 		= LabelDate0.caption
	'szName		= LabelName0.caption
	'szFileName 	= LabelFileName0.caption
	'szSeq 		= LabelSeqNo0.caption
	'	
	'szSendData = szTitle .. "★" .. szDate.."  "..szName .. "★" .. szFileName .. "★" .. szSeq
	'MoveScreen("summary",szSendData)
	
End Sub

'============================================================================
' 두번째 PDF 오픈
'============================================================================
Sub Image2_OnClick()
	
	sFileName = LabelFileName1.caption
	OpenPdfViewer(sFileName)
	
End Sub

'============================================================================
Sub LabelTitle1_OnClick()

	sFileName = LabelFileName1.caption
	OpenPdfViewer(sFileName)
	
	'szTitle 		= LabelTitle1.caption
	'szDate 		= LabelDate1.caption
	'szName		= LabelName1.caption
	'szFileName 	= LabelFileName1.caption
	'szSeq 		= LabelSeqNo1.caption
		
	'szSendData = szTitle .. "★" .. szDate.."  "..szName .. "★" .. szFileName .. "★" .. szSeq
	'MoveScreen("summary",szSendData)
	
End Sub

'============================================================================
