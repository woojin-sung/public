'============================================================================
Sub Image3_OnClick()

	sFileName = LabelFileName2.caption
	OpenPdfViewer(sFileName)
	
End Sub

'============================================================================
Sub LabelTitle2_OnClick()

	sFileName = LabelFileName2.caption
	OpenPdfViewer(sFileName)
	
	'szTitle 		= LabelTitle2.caption
	'szDate 		= LabelDate2.caption
	'szName		= LabelName2.caption
	'szFileName 	= LabelFileName2.caption
	'szSeq 		= LabelSeqNo2.caption
	'	
	'szSendData = szTitle .. "★" .. szDate.."  "..szName .. "★" .. szFileName .. "★" .. szSeq
	'MoveScreen("summary",szSendData)
	
End Sub

'============================================================================
Function OpenPdfViewer(sFileName)

	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if CInt(szMode) == 0 then
		szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"		'운영계 주소
	elseif CInt(szMode) == 1 then
		szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
	end if
	
	sFileUrl = Trim(szUrl) & "/" & sFileName
	Form.OpenPdfViewer(sFileUrl, "ETF 리포트")

End Function

'============================================================================
Sub lbl1_OnClick()
	
	MoveScreen("more","")
	
End Sub

'============================================================================
Sub Image0_OnClick()

	MoveScreen("more","")
	
End Sub

'============================================================================
Function MoveScreen(sGubun,sOpenData)
	
	if sGubun == "more" then
		Form.triggerEvent("#", "SAVE_ETF_HOME_SCROLL", "")
		Form.OpenScreen("50400" , sOpenData)
	
	elseif sGubun == "summary" then
		
		Form.OpenPopup("nrshidx50410", sOpenData, "")

	end if
	
	

End Function



