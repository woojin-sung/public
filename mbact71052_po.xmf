Dim g_tData
Dim g_szCode

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("11", szOpenData)
		
		'종목명, 평가금액, 평가손익, 수익률, 잔고구분, 잔고수량, 매입단가, 매수일, 만기일, 대출금, 대출일, 대출만기일
		g_tData = Split(szOpenData, "☆")
		
		lblName.caption = g_tData[0]
		
		tbl0.SetCellString(0, 2, g_tData[1])
		
		tbl3.SetCellString(0, 1, g_tData[2])
		'msgbox g_tData[3]
		'msgbox g_tData[4]
		
		if g_tData[3] ="" then 
		else
			tbl2.SetCellString(0, 1, g_tData[3])
		end if
		
		if g_tData[4] = "0000.00000" then 
		else
			tbl2.SetCellString(1, 1, FormatNumber(g_tData[4],2) .."%") 
		end if
		
		tbl1.SetCellString(0, 1, g_tData[5] .." "..g_tData[8])
		tbl1.SetCellString(1, 1, g_tData[6] .." "..g_tData[8])
		tbl1.SetCellString(2, 1, g_tData[7] .." "..g_tData[8])
		'평가손익, 수익률 마스킹 처리
		'If CDbl(g_tData[2]) > 0 Then
		'	tbl1.SetCellString(0, 1, "+" & FormatNumber(g_tData[2], 0))
		'	tbl1.SetCellFgColor(0, 1, "1")
		'ElseIf CDbl(g_tData[2]) < 0 Then	
		'	tbl1.SetCellString(0, 1, FormatNumber(g_tData[2], 0))
		'	tbl1.SetCellFgColor(0, 1, "2")
		'Else
		'	tbl1.SetCellString(0, 1, FormatNumber(g_tData[2], 0))
		'End If
		
		'If CDbl(g_tData[3]) > 0 Then
		'	tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[3], 2))
		'	tbl1.SetCellFgColor(1, 1, "1")
		'ElseIf CDbl(g_tData[3]) < 0 Then	
		'	tbl1.SetCellString(1, 1, FormatNumber(g_tData[3], 2))
		'	tbl1.SetCellFgColor(1, 1, "2")
		'Else
		'	tbl1.SetCellString(1, 1, FormatNumber(g_tData[3], 2))
		'End If
'		tbl1.SetCellString(1, 1, g_tData[3])
		
		
		'tbl3.SetCellString(0, 1, g_tData[4])
		'tbl3.SetCellString(1, 1, g_tData[5])
		'tbl3.SetCellString(2, 1, g_tData[6])
		'tbl3.SetCellString(3, 1, g_tData[7])
		'tbl3.SetCellString(4, 1, g_tData[8])
		
		'If CInt(g_tData[9]) <> 0 Then
		'	tbl2.SetCellString(0, 1, FormatNumber(g_tData[9], 0) & "원")
		'	tbl2.SetCellString(1, 1, g_tData[10])
		'	tbl2.SetCellString(2, 1, g_tData[11])
		'Else
		'	tbl2.SetCellString(0, 1, "-")
		'	tbl2.SetCellString(1, 1, "-")
		'	tbl2.SetCellString(2, 1, "-")
		'End If
	End If
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

Sub imgHelp_OnClick()
	imgHelp.openToolTip("    USD RP로 자동 투자된 금액이에요.\n    - 16:00에 USD RP로 자동 매수 후,\n      다음날 00:20에 일괄 매도됩니다.\n      (해외주식 주문 금액 제외)", 275, 100, 2)
End Sub

Sub Form_OnFormInitBefore()
	imgHelp.SetMaintainingRatio("1")
End Sub

