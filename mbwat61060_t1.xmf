'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경 (계약정보)
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2022.10.24 : 고승연 : v0002 : 계좌일련번호 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bRequest
Dim g_sAcnoDeposit	'선택_약정계좌번호
Dim g_sAsnoDeposit	'선택_약정계좌일련번호
Dim g_sLNKD_ACNO		'약정계좌번호
Dim g_sLNKD_ASNO		'약정계좌일련번호
Dim g_lnkdIndx

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	cont.btnSwitch.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	cont.acntDepositAcnt.SetBgImg("combo_04.9")
	
	f_SetClear()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "Clear" then
		f_SetClear()
		
	elseif sEventName == "Request" then
		if sParam <> null and sParam <> "" then
			g_bRequest = true
			
			Dim tData
			tData = Split(sParam, "|")
			
			cont.btnSwitch.switchindex = 0
			cont.cmbReport.currentindex = 0
			cont.acntDepositAcnt.currentindex = 0
			
			cont.tblInfo.visible = true
			cont.btnSwitch.visible = true
			cont.cmbReport.visible = true
			cont.acntDepositAcnt.visible = true
			
			if tData(0) == null or tData(0) == "" or tData(1) == null or tData(1) == "" or tData(2) == null or tData(2) == "" then
				Exit Sub
			end if
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_023r", "InBlock1", "WA_ACNO" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_023r", "InBlock1", "WA_CNRC_NO" , 0 , tData(2) )
			
			DATAMANAGER.RequestTranData( "obwat_ctad_023r" )

			Dim g_sCsno
			g_sCsno = Form.GetSharedData("&CUST_NUM", false)
			
			' 입금받을 계좌 조회
			DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "3" )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "ACNO" , 0 , tData(0) )
			DATAMANAGER.RequestTranData( "obwat_onln_004r" )
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_ACNO" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_CNRC_NO" , 0 , tData(2) )
			
		end if
		
	elseif sEventName == "PwCheck" then
		Dim sWA_CNRC_EXTS_YN
		sWA_CNRC_EXTS_YN = cont.btnSwitch.switchindex = "1" and "Y" or "N"
		
		DATAMANAGER.SetEventFlag( "obwat_ctad_013a", "U" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "PWD" , 0 , sParam )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_CNRC_EXTS_YN" , 0 , sWA_CNRC_EXTS_YN )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "SNML_INAG_TYPE_CODE" , 0 , cont.cmbReport.cbkeydata )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "LNKD_ACNO" , 0 , g_sLNKD_ACNO )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "LNKD_ASNO" , 0 , g_sLNKD_ASNO )
'		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "RSEV_YN" , 0 , "Y" )
		
		DATAMANAGER.RequestTranData( "obwat_ctad_013a" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_ctad_023r" then
		sWA_CNRC_EXTS_YN		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_CNRC_EXTS_YN" , 0 )
		sSNML_INAG_TYPE_CODE	= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "SNML_INAG_TYPE_CODE" , 0 )
		g_sLNKD_ACNO			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "LNKD_ACNO" , 0 )
		g_sLNKD_ASNO			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "LNKD_ASNO" , 0 )
		sWA_PRCD				= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_PRCD" , 0 )
		
		if sWA_CNRC_EXTS_YN == "Y" then
			cont.btnSwitch.switchindex = 1
		end if
		
		cont.cmbReport.cbkeydata = sSNML_INAG_TYPE_CODE
		'cont.acntDepositAcnt.caption = g_sLNKD_ACNO..g_sLNKD_ASNO
		
		sWA_MGRI_EMPNO				= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_MGRI_EMPNO" , 0 )
		sRCMD_EMPNO					= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "RCMD_EMPNO" , 0 )
		sMNGR_EMPNO					= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "MNGR_EMPNO" , 0 )
		sASET_RE_DSTR_PRIR_NTFY_CLCD	= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 )
		sLOAN_ABLE_YN					= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "LOAN_ABLE_YN" , 0 )
		sCRDT_GVNG_AMT_RATE			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "CRDT_GVNG_AMT_RATE" , 0 )
		sWA_CRDT_CLCD					= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_CRDT_CLCD" , 0 )
		
		if sCRDT_GVNG_AMT_RATE <> null and sCRDT_GVNG_AMT_RATE <> "" then
			sCRDT_GVNG_AMT_RATE = tostring(tonumber(sCRDT_GVNG_AMT_RATE) * 10000)
		end if
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_PRCD" , 0 , sWA_PRCD )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_MGRI_EMPNO" , 0 , sWA_MGRI_EMPNO )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "RCMD_EMPNO" , 0 , sRCMD_EMPNO )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "MNGR_EMPNO" , 0 , sMNGR_EMPNO )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 , sASET_RE_DSTR_PRIR_NTFY_CLCD )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "LOAN_ABLE_YN" , 0 , sLOAN_ABLE_YN )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "CRDT_GVNG_AMT_RATE" , 0 , sCRDT_GVNG_AMT_RATE / 10000 )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_CRDT_CLCD" , 0 , sWA_CRDT_CLCD )
	
	elseif szTranID == "obwat_ctad_013a" then
		Form.MsgBox("알림", "계좌정보가 변경되었습니다.", "", 8, "확인", "")
		Form.triggerEvent("#", "Request", "")
	elseif szTranID == "obwat_onln_004r" then
		Dim nCount, bImpossible
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		bImpossible = true
		
		cont.cmbAcntDeposit.clear = 0
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sPrcdName
				sAcnt = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCsnm = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				if Trim(sAcnt) == Trim(g_sLNKD_ACNO) and Trim(sAsno) == Trim(g_sLNKD_ASNO) then
					g_lnkdIndx = i
				end if
				
				cont.cmbAcntDeposit.cbadddatatext = sAcnt..sAsno.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.." "..sCsnm
			next
		end if
		
		cont.cmbAcntDeposit.currentindex = g_lnkdIndx
		
	end if
End Sub


'============================================================================
Sub cont_cmbAcntDeposit_OnEditComplete(iIndex)
	g_sLNKD_ACNO = Left(cont.cmbAcntDeposit.cbkeydata, 8)
	g_sLNKD_ASNO = Right(cont.cmbAcntDeposit.cbkeydata, 2)
End Sub

'============================================================================
Sub cont_btnTrans_OnClick()
	if (g_bRequest) then
		sWA_ACNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_ACNO" , 0 )
		sWA_CNRC_NO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_CNRC_NO" , 0 )
		
		if sWA_ACNO == null or sWA_ACNO == "" or sWA_CNRC_NO == null or sWA_CNRC_NO == "" then
			Exit Sub
		end if
		
		Form.triggerEvent("#", "PwCheck", "")
	else
		Form.MsgBox("알림", "계약번호를 선택해주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg

	if szTranID == "obwat_ctad_013a" then
		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox( "알림", "서비스신청이 불가합니다.\n" & sSubmsg, "", 0 )
	end if
End Sub

Sub f_SetClear()
	g_bRequest = false
	
	cont.tblInfo.visible = false
	cont.btnSwitch.visible = false
	cont.cmbReport.visible = false
	cont.acntDepositAcnt.visible = false
End Sub

'============================================================================
Sub cont_btnReport_OnClick()
	'Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	
'	Dim sPlain_rm, sData
'	sPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
'	sData = g_sLNKD_ACNO.."|"
'	
