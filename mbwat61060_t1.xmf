	sData = g_sLNKD_ACNO.."|"..""
	Form.OpenPopupAnimation("mbwat61022_p9" , sData ,"POPUP_REPORT","2")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("POPUP_REPORT" , g_szData)
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "POPUP_REPORT" then '투자일임보고서 제공
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			cont.cmbReport.cbkeydata = tData(1)
		end if
	end if
End Sub

