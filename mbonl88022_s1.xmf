'============================================================================
' 화 면 명 : 대차중개약정 처리(신청/변경/해지)
'============================================================================


Dim g_szPwd					'계좌 비밀번호
Dim g_szPhoneNum, g_szPhoneInagTypeCode, g_szPhoneInagSrno		'알림톡/문자 정보
Dim g_szEmail, g_szEmailInagTypeCode, g_szEmailInagSrno		'이메일 정보
Dim g_szFnprJoinSrno			'금융상품가입일련번호
Dim g_szSvcSrno				'서비스 일련번호
Dim g_szRegAcno, g_szRegAsno	'약정체결한 계좌번호(변경/해지처리시 사용)
Dim g_szINFR	'통보방법구분코드	(변경처리시 사용)
Dim g_szHNDV	'교부방법구분코드	(변경처리시 컨트롤 셋팅만 해주기 위함)
Dim g_szProcType	'R:신청/C:변경/D:해지

Dim g_nNextIdx
Dim g_nGridIndex

Dim g_szCustNum				'고객번호
Dim g_szOSType
Dim g_szScreenNo

Dim g_szMsgCode	'약정불가 코드
Dim g_szMsgData	'약정불가 메시지

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
	
	contReg.imgTooltip.setMaintainingRatio("1")	
	
	contReg.contNoti.iconNotiTalk.setMaintainingRatio("1")	
'	contReg.contNoti.iconOnline.setMaintainingRatio("1")
	
	contReg.contCtcn.imgCtcnInfo.setMaintainingRatio("1")
	contReg.contCtcn.iconTalk.setMaintainingRatio("1")	
	contReg.contCtcn.iconEmail.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()	
	g_szCustNum = Form.GetSharedData("&CUST_NUM", false)
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)	'iOS("2")Android("1")
	g_szScreenNo = Form.GetSharedData("&SCREEN_NO" , false)
	
	contReg.btnReg.enable = false
	contReg.btnReg.btnimage = "btn_21.9"
	contReg.btnReg.fgcolor = "269"	
	
	'등록된 휴대폰번호, 이메일 조회..
	if acnt.caption <> "" and acnt.caption <> null then
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	else
		contInit.lblAlert.visible = true
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "list" then		
		acnt.visible = false
		contInit.visible = false
		contReg.visible = false
		contCancel.visible = true
		
		lblTitle.caption = "대차중개약정 신청내역"
		
		'대차중개 약정내역 조회
		g_nNextIdx = 0
		g_nGridIndex = 0 
		contCancel.Pannel0.rowcount = 0
		DATAMANAGER.RequestTranData( "obpds_srvc_568r" )
		
	elseif sEventName == "reg" then	
		''대차중개약정 신청
		g_szProcType = "R"
		
		lblTitle.caption = "대차중개약정 신청"
		
		acnt.visible = true
		contInit.visible = false
		contReg.visible = true	
		contCancel.visible = false
		
		contReg.btnReg.caption = "서비스 신청하기"
			
		'대차중개약정 가능여부
		if acnt.caption <> "" and acnt.caption <> null then
			DATAMANAGER.RequestTranData( "obpds_srvc_668r" )
		end if		
		
	else	'init
		g_szProcType = "R"
		
		lblTitle.caption = "대차중개약정 신청"
		
		acnt.visible = true
		
		'선택계좌 1개인 경우는 신청화면으로, 아니면.. 계좌선택 바텀 팝업 
		if Cint(acnt.accountcount) == 1 then
			contInit.visible = false
			contReg.visible = true
			contCancel.visible = false		
				
			'대차중개약정 가능여부
			if acnt.caption <> "" and acnt.caption <> null then
				DATAMANAGER.RequestTranData( "obpds_srvc_668r" )
			end if
			
		else
			contInit.visible = true
			contReg.visible = false
			contCancel.visible = false		
			
			if Cint(acnt.accountcount) == 0 then
				'"선택할 수 있는 계좌가 없습니다" <<-- 화면에 문구 노출 안함.
			else
				contInit.lblAlert.caption = "신청할 계좌를 선택해주세요."
				
				'계좌선택 바텀 팝업
				'acnt.OpenList()
				CheckAppVersion()
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'약관팝업 리턴
	if sKeyName == "mbonl88022_p2" then
		if sRet == "ok" then			
			'약관 정상확인 후 계좌비밀번호 체크
			Form.openPopupAnimation( "pwdcheckpopup", acnt.caption & "☆2", "", "2" )
		end if
	
	'계좌 비밀번호 팝업 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tPwd
		tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
		
		if UBOUND(tPwd) > 0 then
			g_szPwd = tPwd(0)
			
			if g_szProcType == "D" then	'해지
				DATAMANAGER.RequestTranData( "obpds_srvc_168a_1" )		
				
			elseif g_szProcType == "C" then	'변경
				DATAMANAGER.RequestTranData( "obpds_srvc_168a_2" )
				
			elseif g_szProcType == "R" then	'신청
				'금융상품가입일련번호 채번
				DATAMANAGER.RequestTranData( "obsap_acif_999a" )	
			end if
		end if

	'연락처 변경
	elseif sKeyName == "mbonl81000" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		elseif sRet == "cancel" then
			if g_szMsgCode == "0006" then
				'온라인 직접조회 강제로 선택되도록!
				f_SetNotiToggleUI(1)
				
				if g_szProcType = "C" then
					'변경하기 버튼 상태 비활성화
					contReg.btnReg.enable = false
					contReg.btnReg.btnimage = "btn_21.9"
					contReg.btnReg.fgcolor = "269"
				end if
				
				Exit Sub
			end if
		end if
	
	'약정완료팝업
	elseif sKeyName == "mbonl88022_p3" then
		'메뉴트리로 이동
		Go_MenuTree()
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CANCEL_CONFIRM" and sRet == "ok" then		
		Form.openPopupAnimation( "pwdcheckpopup", g_szRegAcno..g_szRegAsno & "☆2", "", "2" )
	
	elseif sKeyName == "CHANGE_COMPLETE" then
		'메뉴트리로 이동
		Go_MenuTree()
		
	elseif sKeyName == "CANCEL_COMPLETE" then
		'메뉴트리로 이동
		Go_MenuTree()
				
	elseif sKeyName == "ABLE_CHECK_CASE_1" then
		if sRet == "no" then
			'팝업 오류메시지 화면에 출력.
			if g_szMsgCode == "0001" then
				contInit.lblAlert.caption = "실명 미확인 계좌는\n대차중개 약정이 불가합니다.\n다른 계좌를 선택해주세요."
				contInit.lblAlert.visible = true
			else
				contInit.lblAlert.caption = g_szMsgData
				contInit.lblAlert.visible = true
			end if
		elseif sRet == "ok" then
			'고객지원센터 화면으로 이동
			Form.OpenScreen("89020", "")
		end if
		
'	elseif sKeyName == "ABLE_CHECK_CASE_2" then
'		if sRet == "no" then
'			'안내 화면으로 이동
'			Form.SendReturnToParent("mbonl88022_s1" , "close")
'			Form.CloseForm()
'		elseif sRet == "ok" then
'			'고객지원센터 화면으로 이동
'			Form.OpenScreen("89020", "")
'		end if
		
	elseif sKeyName == "ABLE_CHECK_CASE_3" then
		if sRet == "close" then
			'팝업 오류메시지 화면에 출력.
			contInit.lblAlert.caption = g_szMsgData
			contInit.lblAlert.visible = true
		end if
		
	elseif sKeyName == "ABLE_CHECK_CASE_4" then
		if sRet == "close" then
			'안내 화면으로 이동
			Form.triggerEvent("#", "init", "")
		end if
	
	elseif sKeyName == "ABLE_CHECK_CASE_5" then
		if sRet == "no" then
			'온라인 직접조회 강제로 선택되도록!
			f_SetNotiToggleUI(1)
			
			if g_szProcType = "C" then
				'변경하기 버튼 상태 비활성화
				contReg.btnReg.enable = false
				contReg.btnReg.btnimage = "btn_21.9"
				contReg.btnReg.fgcolor = "269"
			end if
			
			Exit Sub
		elseif sRet == "ok" then
			'고객연락처변경 화면으로 이동
			Form.OpenFramePopup("mbonl81000" , "" , "")
		end if
	
	elseif sKeyName == "ABLE_CHECK_CASE_6" then
		if sRet == "no" then
			Exit Sub
		elseif sRet == "ok" then
			'반환신청 및 취소 화면으로 이동
			Form.OpenFramePopup("mbonl92010" , "" , "")
'			Form.OpenScreen("92010", "")
		end if
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		if g_szCtcnFlag == "talk" then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "04")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , g_szPhoneInagTypeCode)	'"13"
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UI_CUST_TEL_NO" , 0 , g_szPhoneNum)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_SRNO" , 0 , g_szPhoneInagSrno)
		elseif g_szCtcnFlag == "email" then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "02")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , g_szEmailInagTypeCode)	'"21"
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ADDR" , 0 , g_szEmail)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_SRNO" , 0 , g_szEmailInagSrno)
		end if
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
	
	'대차중개 약정신청
	elseif szTranID == "obpds_srvc_168a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "I" )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , g_szCustNum 			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" , 0 , "068"   			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , acnt.total   )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , acnt.sequence  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szPwd 	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4" 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03")	

		if g_szNotiFlag == "Notitalk" then	'SMS(알림톡/문자)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INFR_MTHD_CLCD" , 0 , "1" )
		Elseif g_szNotiFlag == "Online" then '온라인 직접조회
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INFR_MTHD_CLCD" , 0 , "2" )
		End If
		
	'대차중개 약정해지
	elseif szTranID == "obpds_srvc_168a_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "D" )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , g_szCustNum 			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" , 0 , "068"   			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szRegAcno   )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szRegAsno  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szPwd 	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4" 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03")		
		
	'대차중개 약정변경
	elseif szTranID == "obpds_srvc_168a_2" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "U" )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , g_szCustNum 			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" , 0 , "068"   			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szRegAcno   )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szRegAsno  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szPwd 	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4" 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03")
		
		if g_szNotiFlag == "Notitalk" then	'SMS(알림톡/문자)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INFR_MTHD_CLCD" , 0 , "1" )
		Elseif g_szNotiFlag == "Online" then '온라인 직접조회
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INFR_MTHD_CLCD" , 0 , "2" )
		End If
			
	'계약서류 교부처리
	elseif szTranID == "obcsb_dbif_322a" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSWR_LRDV_CODE" , 0 , "017")		'001:계좌개설 / 017:서비스약정
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "FNPR_JOIN_DETL_SRNO" , 0 , "00001")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "ISCD" , 0 , "068")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "CNRC_DOCU_KEY_VAL" , 0 , g_szCustNum & "$" & "068" & "$" & g_szSvcSrno )
	
	'대차중개 약정내역 조회
	elseif szTranID == "obpds_srvc_568r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "2" 			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , g_szCustNum 			)
		
	'대차중개약정 가능여부 조회
	elseif szTranID == "obpds_srvc_668r" then
		if g_szProcType == "C" then	'변경
			szQryClsCode = "U"
		else
			szQryClsCode = "I"
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"          , 0 , acnt.total     )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"          , 0 , acnt.sequence  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , szQryClsCode   )		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		Dim nCnt, nCnt1
		if DATAMANAGER.IsMoreNextData(szTranID) = True then
			DATAMANAGER.RequestNextData(szTranID)
		else
			'이메일 주소
			nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			for i = 0 to nCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    if strInagTypeCode2 = "21" then
					g_szEmail = strAddr
					g_szEmailInagTypeCode = strInagTypeCode2
					g_szEmailInagSrno = strInagSrno2
			    end if
			next 	
			'휴대폰 번호
			nCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			for i = 0 to nCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)
			    if strInagTypeCode3 = "13" then
				    g_szPhoneNum = strCustTelno
				    g_szPhoneInagTypeCode = strInagTypeCode3
				    g_szPhoneInagSrno = strInagSrno3
			    end if
			next
		end if

		'재조회 시 표시영역에 바뀐 정보 보여줌
		if g_szCtcnFlag == "talk" then
			contReg.contCtcn.tblCtcn.SetCellString(0, 0, g_szPhoneNum)
			contReg.contCtcn.lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
		elseif g_szCtcnFlag == "email" then
			contReg.contCtcn.tblCtcn.SetCellString(0, 0, g_szEmail)
			contReg.contCtcn.lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
		end if
	
	'금융상품가입일련번호 채번
	elseif szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO"  , 0)
		
		'가입계약서류 제공방식 관리
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		'대차중개 약정신청
		DATAMANAGER.RequestTranData( "obpds_srvc_168a" )
	
	'대차중개 약정신청
	elseif szTranID == "obpds_srvc_168a" then
		g_szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO"  , 0)
		
		'계약서류 교부처리
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )
		
	'계약서류 교부처리
	elseif szTranID == "obcsb_dbif_322a" then
		dim szGubun1, szGubun2
		
		if g_szNotiFlag == "Notitalk" then
			szGubun1 = "알림톡·문자"
		Elseif g_szNotiFlag == "Online" then
			szGubun1 = "온라인 직접조회"
		End If
		
		if g_szCtcnFlag == "talk" then
			szGubun2 = "알림톡·문자"
		elseif g_szCtcnFlag == "email" then
			szGubun2 = "이메일"
		end if
	
		'완료화면 오픈
		Form.OpenPopup("mbonl88022_p3" , acnt.caption & "★" & szGubun1 & "★" & szGubun2 , sPosInfo)
	
	'대차중개 약정현황 조회
	elseif szTranID == "obpds_srvc_568r" then
		nCnt = Cint(DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock2"))		
		contCancel.Pannel0.rowcount = g_nNextIdx + nCnt

		If Cint(nCnt) = 0 then
			'신청내역이 없으면, 등록화면으로.
			contCancel.visible = false
			acnt.visible = true
			contReg.visible = true
			Exit Sub
			
		Elseif Cint(acnt.accountcount) > Cint(nCnt) then
			'신청내역이 있고, '신청 가능 계좌가 있는 경우 추가 버튼 보여짐
			contReg.visible = false
			contCancel.visible = true
			
			contCancel.contAdd.visible = true
			if nCnt < 4 then
				contCancel.contAdd.top = nCnt * (155 + 10)	'nCnt * (판넬 높이)
			else
				contCancel.contAdd.top = Cint(contCancel.Pannel0.height) + 15	'(판넬 높이) +  15
			end if

			contCancel.lblBlank.visible = true		'lblBlank는.. contAdd 하단에 여백주기 위함.
			contCancel.lblBlank.top = Cint(contCancel.contAdd.top) + Cint(contCancel.contAdd.height)
			
			contCancel.SetScrollAutoSize()
			
		Else
			'신청내역이 있고, '신청 가능 계좌가 없는 경우 숨김
			contReg.visible = false
			contCancel.visible = true
			contCancel.contAdd.visible = false
			
		End if
    
    
		For i = 0 To nCnt - 1
		    szCSNO            = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CSNO", i)
		    szSVCD            = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "SVCD", i)
		    szSVC_SRNO        = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "SVC_SRNO", i)
		    szACNO            = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "ACNO", i)
		    szASNO            = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "ASNO", i)
		    szCONT_CLS_CODE   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CONT_CLS_CODE", i)
		    szINFR_MTHD_CLCD  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "INFR_MTHD_CLCD", i)
		    szHNDV_MTHD_CODE  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "HNDV_MTHD_CODE", i)

			if szINFR_MTHD_CLCD == "1" then
				szINFR_MTHD_CLCD_NM = "알림톡·문자"
			elseif szINFR_MTHD_CLCD == "2" then
				szINFR_MTHD_CLCD_NM = "온라인 직접조회"
			else
				szINFR_MTHD_CLCD_NM = "-"
			end if
			
			if szHNDV_MTHD_CODE == "04" then
				szHNDV_MTHD_CODE_NM = "알림톡·문자"
			elseif szHNDV_MTHD_CODE == "02" then
				szHNDV_MTHD_CODE_NM = "이메일"
			else
				szHNDV_MTHD_CODE_NM = "-"
			end if
			
			contCancel.Pannel0.SetCellValue( "lblData1", g_nNextIdx + i, szACNO .. szASNO ) 		'신청계좌
			contCancel.Pannel0.SetCellValue( "lblData4", g_nNextIdx + i, szINFR_MTHD_CLCD )		'대차거래 통보 방법 코드
			contCancel.Pannel0.SetCellValue( "lblData2", g_nNextIdx + i, szINFR_MTHD_CLCD_NM ) 	'대차거래 통보 방법 한글명
			contCancel.Pannel0.SetCellValue( "lblData5", g_nNextIdx + i, szHNDV_MTHD_CODE )		'계약서류 제공 방식 코드
			contCancel.Pannel0.SetCellValue( "lblData3", g_nNextIdx + i, szHNDV_MTHD_CODE_NM ) 	'계약서류 제공 방식 한글명

			g_nGridIndex = CInt(g_nGridIndex) + 1
		Next

		g_nNextIdx = g_nNextIdx + nCnt
		
	'대차중개 약정해지
	elseif szTranID == "obpds_srvc_168a_1" then
		Form.MsgBox("알림", "대차중개 약정이 해지되었습니다.", "CANCEL_COMPLETE", 6)
		
	'대차중개 약정변경
	elseif szTranID == "obpds_srvc_168a_2" then
		Form.MsgBox("알림", "대차중개 약정이 변경되었습니다.", "CHANGE_COMPLETE", 6)
				
	'대차중개약정 가능여부 조회
	elseif szTranID == "obpds_srvc_668r" then		
		g_szMsgCode  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_4_MSTK_CODE"             , 0)	'UI4오류코드
		g_szMsgData  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MSG_DATA"                   , 0)	'메시지데이터
		
		szApltAbleYN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APLT_ABLE_YN"               , 0)	'신청가능여부
		szInfr_YN    = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSWR_SUPT_TEAM_INFR_YN"  , 0)	'고객지원센터 팝업여부

		'신청불가 상태
		If szApltAbleYN == "N" then
			contInit.visible = true
			contReg.visible = false
			contCancel.visible = false
			
			'휴대폰 미등록 계좌 : 신청가능 상태에서, 대차거래통보방법 알림톡 선택시 체크
			If g_szMsgCode == "0006" then
				
				'신청가능 상태
				contInit.visible = false
				contReg.visible = true
				contCancel.visible = false
					
				if g_szProcType == "R" then
					f_SetNotiToggleUI(-1)
					f_SetToggleUI(-1)
				end if
				
				Exit Sub
			End if
			
			
			'안내팝업 버튼 : 확인|고객지원센터
			if szInfr_YN = "Y" then	
			
				'실명미확인계좌 or 증거금미징수계좌 or (사고계좌 or 질권압류계좌)
				if g_szMsgCode == "0001" or g_szMsgCode == "0004" or g_szMsgCode == "0005" then
				
					'[확인] 선택시, 팝업 닫히는 경우 (팝업 오류메시지 화면에 출력)
					Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_1", "7", "고객지원센터", "확인")
					Exit Sub
					
'				'실명미확인계좌
'				elseif g_szMsgCode == "0001" then
'				
'					'[확인] 선택시, 안내 화면으로 이동
'					Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_2", "7", "고객지원센터", "확인")
'					Exit Sub

				else
				
					'[확인] 선택시, 팝업 닫히는 경우 (팝업 오류메시지 화면에 출력)
					Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_1", "7", "고객지원센터", "확인")
					Exit Sub
					
				end if

			'안내팝업 버튼 : 확인
			else
			
				'비거주외국인
				if g_szMsgCode == "0002" then
				
					'[확인] 선택시, 안내 화면으로 이동
					Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_4", "6")
					Exit Sub
				
				'약정완료된계좌
				elseif g_szMsgCode == "0003" then
				
					'[확인] 선택시, 팝업 닫히는 경우 (팝업 오류메시지 화면에 출력)
					Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_3", "6")
					Exit Sub
					
				else
				
					'[확인] 선택시, 팝업 닫히는 경우 (팝업 오류메시지 화면에 출력)
					Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_3", "6")
					Exit Sub
					
				end if
				
			end if
		
		
		'신청가능
		Else
		
			'신청가능 상태
			contInit.visible = false
			contReg.visible = true
			contCancel.visible = false
				
			if g_szProcType == "R" then
				f_SetNotiToggleUI(-1)
				f_SetToggleUI(-1)
			end if
			
		End If		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )	
	If sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	End if

	if szTranID == "obpds_srvc_168a" or szTranID == "obpds_srvc_168a_1" or szTranID == "obpds_srvc_168a_2" then	'신청 or 변경 or 해지
		If szErrCode = "7951" Then '해당 상품에 제공되는 서비스가 아닙니다.
			Form.MsgBox( "알림", "종합매매,WRAP(종합매매)계좌만 가능합니다.", "", 0 )  'v0001
			
		Elseif szErrCode = "4482" Then '기약정된 경우, [확인] 버튼 선택시 obpds_srvc_668r 랑 맞춤.
			g_szMsgData = szErrMsg
			Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_3", "6")
			
		Elseif szErrCode = "5237" Then '대차잔고존재시 해지처리불가
			g_szMsgData = "대여중인 종목이 존재하여 해지 불가합니다.\n대여 종목 반환 후 해지 신청해주세요."
			Form.MsgBox("알림", g_szMsgData, "ABLE_CHECK_CASE_6", "7", "반환 신청", "취소")
			
		Else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
			
		End If
		
	Else	''If szTranID == "obpds_srvc_568r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
		
	End if
End Sub

'============================================================================
Sub f_SetBtnEnable(nIndex)
	if g_szProcType == "C" then	
		If nIndex = 0 Then 'SMS(알림톡/문자)
			if g_szINFR == "1" then	'SMS(알림톡/문자)
				contReg.btnReg.enable = false
				contReg.btnReg.btnimage = "btn_21.9"
				contReg.btnReg.fgcolor = "269"
			elseif g_szINFR == "2" then	'온라인직접조회
				contReg.btnReg.enable = true
				contReg.btnReg.btnimage = "btn_20.9"
				contReg.btnReg.fgcolor = "273"			
			end if
		elseIf nIndex = 1 Then	'온라인직접조회
			if g_szINFR == "2" then	'온라인직접조회
				contReg.btnReg.enable = false
				contReg.btnReg.btnimage = "btn_21.9"
				contReg.btnReg.fgcolor = "269"
			elseif g_szINFR == "1" then	'SMS(알림톡/문자)
				contReg.btnReg.enable = true
				contReg.btnReg.btnimage = "btn_20.9"
				contReg.btnReg.fgcolor = "273"
			end if
		end if
	end if
End Sub

'============================================================================
Sub contReg_contCtcn_lblTalk_OnClick()
	f_SetToggleUI(0)
End Sub

'============================================================================
Sub contReg_contCtcn_lblEmail_OnClick()
	f_SetToggleUI(1)
End Sub

'============================================================================
'f_SetToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1

	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러

	if nFlag == 0 then '알림,톡
		contReg.contCtcn.iconTalk.SetAlpha(0)	'알림톡	'0:선택/1:미선택
		contReg.contCtcn.iconEmail.SetAlpha(1)	'이메일
		contReg.contCtcn.imgTalk.imgpath = szToggleImg1
		contReg.contCtcn.imgEmail.imgpath = szToggleImg0
		contReg.contCtcn.lblTalk.fgcolor = szToggleColor1
		contReg.contCtcn.lblTalk.fontstyle = "01"
		contReg.contCtcn.lblEmail.fgcolor = szToggleColor0
		contReg.contCtcn.lblEmail.fontstyle = "00"
	
		contReg.contCtcn.tblCtcn.SetCellString(0, 0, g_szPhoneNum)
		contReg.contCtcn.lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
		
		g_szCtcnFlag = "talk"
	elseif nFlag == 1 then '이메일
		contReg.contCtcn.iconTalk.SetAlpha(1)
		contReg.contCtcn.iconEmail.SetAlpha(0)
		contReg.contCtcn.imgTalk.imgpath = szToggleImg0
		contReg.contCtcn.imgEmail.imgpath = szToggleImg1
		contReg.contCtcn.lblTalk.fgcolor = szToggleColor0
		contReg.contCtcn.lblTalk.fontstyle = "00"
		contReg.contCtcn.lblEmail.fgcolor = szToggleColor1
		contReg.contCtcn.lblEmail.fontstyle = "01"
		
		contReg.contCtcn.tblCtcn.SetCellString(0, 0, g_szEmail)
		contReg.contCtcn.lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
		
		g_szCtcnFlag = "email"
	else
		contReg.contCtcn.iconTalk.SetAlpha(1)
		contReg.contCtcn.iconEmail.SetAlpha(1)
		contReg.contCtcn.imgTalk.imgpath = szToggleImg0
		contReg.contCtcn.imgEmail.imgpath = szToggleImg0
		contReg.contCtcn.lblTalk.fgcolor = szToggleColor0
		contReg.contCtcn.lblTalk.fontstyle = "00"
		contReg.contCtcn.lblEmail.fgcolor = szToggleColor0
		contReg.contCtcn.lblEmail.fontstyle = "00"
		
		contReg.contCtcn.tblCtcn.SetCellString(0, 0, "")
		contReg.contCtcn.lblCtcnInfo.caption = ""
		
		g_szCtcnFlag = ""
		Exit Function
	end if
	
	contReg.contCtcn.tblCtcn.visible = true
	contReg.contCtcn.lblCtcnInfo.visible = true
	contReg.contCtcn.imgCtcnInfo.visible = true


	'변경일때는 계약서류제공방식 확인 단계 생략하므로 버튼 활성화 되지 않음.
	if g_szProcType == "C" then
		'do nothing
	Else
		contReg.btnReg.enable = true	
		contReg.btnReg.btnimage = "btn_20.9"
		contReg.btnReg.fgcolor = "273"
	End If
End Function

'============================================================================
Sub contReg_contNoti_lblNotiTalk_OnClick()
	f_SetNotiToggleUI(0)
	f_SetBtnEnable(0)
	
	if g_szMsgCode == "0006" then
		Form.MsgBox("안내", "휴대폰 미등록 계좌는\n대차중개약정이 불가능합니다.\n휴대폰 정보 등록 후 이용해주세요.", "ABLE_CHECK_CASE_5", "7", "등록하기", "확인")
		Exit Sub
	End If
End Sub

'============================================================================
Sub contReg_contNoti_lblOnline_OnClick()
	f_SetNotiToggleUI(1)
	f_SetBtnEnable(1)
End Sub

'============================================================================
'f_SetNotiToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetNotiToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1

	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러

	if nFlag == 0 then '알림,톡
		contReg.contNoti.iconNotTalk.SetAlpha(0)	'알림톡	'0:선택/1:미선택
'		contReg.contNoti.iconOnline.SetAlpha(1)	'이메일
		contReg.contNoti.imgNotiTalk.imgpath = szToggleImg1
		contReg.contNoti.imgOnline.imgpath = szToggleImg0
		contReg.contNoti.lblNotiTalk.fgcolor = szToggleColor1
		contReg.contNoti.lblNotiTalk.fontstyle = "01"
		contReg.contNoti.lblOnline.fgcolor = szToggleColor0
		contReg.contNoti.lblOnline.fontstyle = "00"
	
		g_szNotiFlag = "Notitalk"
	elseif nFlag == 1 then '온라인 직접조회	
		contReg.contNoti.iconNotTalk.SetAlpha(1)
'		contReg.contNoti.iconOnline.SetAlpha(0)
		contReg.contNoti.imgNotiTalk.imgpath = szToggleImg0
		contReg.contNoti.imgOnline.imgpath = szToggleImg1
		contReg.contNoti.lblNotiTalk.fgcolor = szToggleColor0
		contReg.contNoti.lblNotiTalk.fontstyle = "00"
		contReg.contNoti.lblOnline.fgcolor = szToggleColor1
		contReg.contNoti.lblOnline.fontstyle = "01"
		
		g_szNotiFlag = "Online"
	else
		contReg.contNoti.iconNotiTalk.SetAlpha(1)
'		contReg.contNoti.iconOnline.SetAlpha(1)
		contReg.contNoti.imgNotiTalk.imgpath = szToggleImg0
		contReg.contNoti.imgOnline.imgpath = szToggleImg0
		contReg.contNoti.lblNotiTalk.fgcolor = szToggleColor0
		contReg.contNoti.lblNotiTalk.fontstyle = "00"
		contReg.contNoti.lblOnline.fgcolor = szToggleColor0
		contReg.contNoti.lblOnline.fontstyle = "00"
		
		g_szNotiFlag = ""
		Exit Function
	end if
	
End Function

'============================================================================
Sub contReg_contCtcn_tblCtcn_OnClick(lRow , lColumn)
	'연락처 정보 변경
	if lRow == 0 and lColumn == 1 then
		Form.OpenFramePopup("mbonl81000" , "" , "")
	end if
End Sub

'============================================================================
Sub contReg_btnReg_OnClick()	
	'통보방법
	if g_szNotiFlag == "" then
		Form.MsgBox("알림", "통보방법을 선택해주세요.", "", 0)
		Exit Sub
	End If

	'변경일때는 계약서류제공방식 확인 단계 생략
	if g_szProcType == "C" then
		'do nothing
	Else
		if g_szCtcnFlag == "" or g_szCtcnFlag == null then
			Form.MsgBox("알림", "서류 제공방식을 선택해주세요.", "", 0)
			Exit Sub
		Else
			dim szData
			szData = contReg.contCtcn.tblCtcn.GetCellString( 0, 0 )
			if szData == "" or szData == null then
				if g_szCtcnFlag == "talk" then
					Form.MsgBox("알림", "핸드폰 번호를 등록해 주세요.", "", 0)
				elseif g_szCtcnFlag == "email" then
					Form.MsgBox("알림", "이메일 주소를 등록해 주세요.", "", 0)
				else
					Form.MsgBox("알림", "핸드폰 번호 혹은 이메일 주소를 확인해 주세요.", "", 0)
				end if
				Exit Sub
			end if
		End If
	End If


	'변경일때는 약관 확인 단계 생략
	if g_szProcType == "C" then
		'계좌비밀번호 체크
		Form.openPopupAnimation( "pwdcheckpopup", g_szRegAcno..g_szRegAsno & "☆2", "", "2" )		
	else
		'약관팝업
		Form.OpenPopup("mbonl88022_p2", "", "")
	end if
End Sub

'============================================================================
Sub contReg_imgTooltip_OnClick()
	contReg.imgTooltip.openToolTip("약관, 설명서 등 확인 서류를\n알림톡·문자 또는 이메일로 받을 수 있어요.", 300, 60, 1)
End Sub

'============================================================================
Sub contCancel_Pannel0_OnClick(nIndex, sCellID)
	g_szRegAcno = LEFT(contCancel.Pannel0.GetCellValue("lblData1", nIndex), 8)					'계좌번호
	g_szRegAsno = RIGHT(contCancel.Pannel0.GetCellValue("lblData1", nIndex), 2)					'계좌순번
	g_szINFR = contCancel.Pannel0.GetCellValue("lblData4", nIndex)					'통보방법구분코드
	g_szHNDV = contCancel.Pannel0.GetCellValue("lblData5", nIndex)					'계약서류제공방식구분코드

	If sCellID == "btnCancel" then	
		'대차중개약정 해지
		g_szProcType = "D"
		
		Form.MsgBox("알림", "대차중개 약정을\n해지하시겠습니까?", "CANCEL_CONFIRM", 7, "확인", "취소")
		
	ElseIf sCellID == "btnChange" then
		'대차중개약정 변경
		g_szProcType = "C"
		
		lblTitle.caption = "대차중개약정 신청"
		contCancel.visible = false
		acnt.visible = true
		contReg.visible = true
		
		'계좌번호 ----------------------
		acnt.caption = g_szRegAcno .. g_szRegAsno
		acnt.enable = false
		'계좌번호 ----------------------

		'대차거래 통보 방법 ----------------------
		if g_szINFR == "1" then	'SMS(알림톡/문자)
			f_SetNotiToggleUI(0)
		elseif g_szINFR == "2" then	'온라인직접조회
			f_SetNotiToggleUI(1)
		else
			f_SetNotiToggleUI(-1)
		end if
		'대차거래 통보 방법 ----------------------

		'계약서류 제공 방식 ----------------------
		if g_szHNDV == "04" then	'알림톡/문자
			f_SetToggleUI(0)
		elseif g_szHNDV == "02" then	'이메일
			f_SetToggleUI(1)
		else
			f_SetToggleUI(-1)
		end if
		contReg.btnCtcnBlock.visible = true	'계약서류제공방식 수정 안되도록 하기 위함.
		contReg.btnCtcnBlock.left = 0
		'계약서류 제공 방식 ----------------------
		
		contReg.btnReg.caption = "변경하기"
	End if
End Sub

'============================================================================
Sub contCancel_contAdd_btnAdd_OnClick()	
	''대차중개약정 신청
	g_szProcType = "R"
	
	lblTitle.caption = "대차중개약정 신청"
	
	acnt.visible = true
	acnt.enable = true
	contInit.visible = true
	contReg.visible = false
	contCancel.visible = false
			
	contInit.lblAlert.caption = "신청할 계좌를 선택해주세요."
	
	'계좌선택 바텀 팝업
	'acnt.OpenList()
	CheckAppVersion()
End Sub

'============================================================================
Sub init_contReg()
	'대차거래통보방법 초기화
	f_SetNotiToggleUI(-1)
	
	'계약서류제공방식 초기화
	f_SetToggleUI(-1)
	contReg.btnCtcnBlock.visible = false	
	contReg.btnCtcnBlock.left = 375
	contReg.contCtcn.tblCtcn.visible = false
	contReg.contCtcn.lblCtcnInfo.visible = false
	contReg.contCtcn.imgCtcnInfo.visible = false
	
	'등록버튼 초기화
	contReg.btnReg.enable = false
	contReg.btnReg.btnimage = "btn_21.9"
	contReg.btnReg.fgcolor = "269"		
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	'입력항목 초기화
	init_contReg()
	
	'대차중개약정 가능여부
	if acnt.caption <> "" and acnt.caption <> null then
		DATAMANAGER.RequestTranData( "obpds_srvc_668r" )
	end if	
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.OpenPopup("mbonl88022_p4" , "" , "")
End Sub

'============================================================================
Sub imgBack_OnClick()
	'안내 화면으로 이동
	Form.triggerEvent("#", "init", "")
End Sub

'============================================================================
Sub Go_MenuTree()
	'메뉴트리로 이동
	if g_szScreenNo == "88022" then
		if g_szOSType == "1" then
			Form.OpenMainMenuWithIndex("3","2","2")
		else
			Form.OpenMainMenuWithIndex("3","2","19")
		end if
	elseif g_szScreenNo == "88033" then
		if g_szOSType == "1" then
			Form.OpenMainMenuWithIndex("1","0","0")
		else
			Form.OpenMainMenuWithIndex("1","0","0")
		end if
	end if
End Sub

'============================================================================
Function CheckAppVersion()
	sAppVer = Form.GetSharedData("&APP_VERSION", false )
	aAppVer = Split(sAppVer, ".")
	
	aLen = #aAppVer
	
	if aLen = 3 then
		nAppVer = (Cint(aAppVer(0)) * 1000) + (Cint(aAppVer(1)) * 100) + aAppVer(2)

		szOsType = Form.GetSharedData("&OS_TYPE", false)
		if szOsType = "1" then
			if nAppVer < 2403 then
				acnt_ChangeAccount()
			else
				acnt.OpenList()
			end if
		elseif szOsType = "2" then
			if nAppVer < 2542 then
				acnt_ChangeAccount()
			else
				acnt.OpenList()
			end if
		end if
	end if
End Function

