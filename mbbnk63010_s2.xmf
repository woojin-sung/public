'============================================================================
Sub Form_OnFormInit() ' OnFormInit
	
    Form.removeWaitCursor()
    
    contAmt.top = "40"
    contAmt.contDirectTrans.top = "20"
    contAmt.contDirectTrans.imgBgAcpt.top = "0"

    btnAlpha.visible = "1"
    lblLimit.enable = False
    
    contMany.contTrans.setScrollBarVisible("2")
    contResultManyY.contTrans.setScrollBarVisible("2")
    
    g_szACNO = ""
    g_szASNO = ""
    g_szPRCD = ""
    g_szPRNM = "" 
    g_CnftAcnm = ""
    g_nDrngAbleAmt = 0
    g_nLoanAbleAmt = 0
    g_szLoanStplYN = "N"
    g_nVoiceCnt = 1
    g_nTransCnt = 1
    g_szSeparator = "★"
    g_szSapeYN = ""
    g_szOftnAcntYN = ""
    g_szBrcd = ""
    g_szDirect = ""
    g_szTransLastStep = "0"
    g_szRcvn_iqry_tmnu = 0
    g_szTact_rpcs_tmnu = 0
    g_szAddFlag = "0"
    g_szUserNm        = Form.GetSharedData("&USER_NAME" , False) '고객명
    g_szUserID        = Form.GetSharedData("&USER_ID"   , False) '고객아이디
    g_szCustNum       = Form.GetSharedData("&CUST_NUM"  , False) '고객번호
    g_CustClsCode     = Form.GetSharedData("MBBNK63010_CUST_CLS_CODE", False)	
    g_MnrcAcntSlctCls = Form.GetSharedData("MNRC_ACNT_SLCT_CLS"      , True) 'JWH 20240124 SharedData 매번 초기화 필요 (True)
    g_szCertUserType  = Form.GetSharedData("&CERT_USE_TYPE", 0 )
    g_szPoupText = ""
    g_nTranIndex = 0
	
    g_szOftenAcntYN1 = "N"
    g_szOftenAcntYN2 = "N"
    g_szOftenAcntYN3 = "N"
    g_szOftenAcntYN4 = "N"
    g_szOftenAcntYN5 = "N"
	
    g_szBaroSvcYn = "0"
    g_szHndvMthdCode = ""
    g_szContact = ""		
    g_szContInagSrno = ""	
    g_szFnprJoinSrno = ""
    g_szSvcSrno = ""
	
    szAcntInfo = Form.GetSharedData("63010_ACNT_INFO" , False) '출금계좌정보
    If szAcntInfo <> Null And szAcntInfo <> "" Then '출금계좌번호가 세팅되어 있으면
        arrAcntInfo = Split(szAcntInfo, g_szSeparator)
        g_szACNO = arrAcntInfo(0)
        g_szASNO = arrAcntInfo(1)
        g_szPRCD = arrAcntInfo(2)  
        g_szPRNM = arrAcntInfo(3)
        g_nDrngAbleAmt = arrAcntInfo(4)
    End If

    szData = Form.GetOpenLinkData()

    If szData <> "" And szData <> Null Then '수취계좌정보가 있을 경우 If Sta
    
        arrTransInfo = Split(szData, "♥")
        g_nTranIndex = Cdbl(arrTransInfo(0))
        g_szTransInfo1 = arrTransInfo(1)
        g_szTransInfo2 = arrTransInfo(2)
        g_szTransInfo3 = arrTransInfo(3)
        g_szTransInfo4 = arrTransInfo(4)
        g_szTransInfo5 = arrTransInfo(5)
		
        If arrTransInfo(6) <> null and arrTransInfo(6) <> "" Then '접수건 바로이동으로 진입 시 If Sta
	
            If arrTransInfo(6) == "DirectTrans" Then
                g_szDirect = "Y"
				
                contAmt.visible = "0"
                lblLimit.visible = "0"
                lblLimitLine.visible = "0"
				
                If g_nTranIndex > 1 Then
                    contMany.visible = "1"
                Else
					contOne.visible = "1"
                End If
				
                f_SetDataConfirm()
				
            End If
			
            btnAlpha.visible = "0"
     
        Else '정상 경로로 진입 시

            If g_nTranIndex > 1 Then '다건이체일 때 If Sta
	    
                contAmt.imgArrow.visible = False '출금계좌를 변경할 수 없음
                contAmt.lblAbleAmt.left = 184 '화살표 위치만큼 금액 필드를 오른쪽으로 옮김 	    
	    
                contAmt.contDirectTrans.visible = "1"
                If (g_nTranIndex-1) == 1 Then
                    contAmt.contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_1.png"
                ElseIf (g_nTranIndex-1) == 2 Then
                    contAmt.contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_2.png"
                ElseIf (g_nTranIndex-1) == 3 Then
                    contAmt.contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_3.png"
                ElseIf (g_nTranIndex-1) == 4 Then
                    contAmt.contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_4.png"
                End If
		
                DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
        
            Else '단건이체
	    
                contAmt.imgArrow.visible = True
                contAmt.lblAbleAmt.left = 160
		
                g_szACNO = acntList.total    'v003
                g_szASNO = acntList.sequence 'v003
                DATAMANAGER.RequestTranData( "obacp_comm_064r" )
		
            End If '다건이체일 때 If Fin
	    
        End If '접수건 바로이동으로 진입 시 If Fin

    End If '수취계좌정보가 있을 경우 If Fin

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    If sKeyName == "mbbnk63010_p4" Then
    
        g_szACNO = Left(sRet,8)
        g_szASNO = Mid(sRet, 9, 2)
		
        acntList.caption = g_szACNO .. g_szASNO '안드로이드에서는 계좌 업데이트해도 타 화면 연동 안됨
        DATAMANAGER.RequestTranData("obacp_comm_064r")
		
    ElseIf sKeyName == "mbbnk63010_p5" Then
    
        If sRet == "ok" Then
            DATAMANAGER.RequestTranData("obtss_comm_502a")
        Else
            f_SetDataConfirm()
        End If
	
    ElseIf sKeyName == "mbbnk63010_p6" Then
    
        Form.SendReturnToParent("mbbnk63010_s2" , "AllReset")
        Form.CloseForm()
		
    ElseIf sKeyName == "mbbnk63010_p8" Then
	
        If sRet <> "" And sRet <> Null Then
            g_szAlias = sRet
        Else
            g_szAlias = ""
        End If
        DATAMANAGER.RequestTranData("obrtp_tact_101a")
		
    ElseIf sKeyName == "CORRECT_PWD" Then '계좌비밀번호
    
        szData = Split(sRet, g_szSeparator)
        If szData(0) <> "" then
            g_szPwd = szData(0)
            DATAMANAGER.RequestTranData("obcsb_oimf_638r_1")
        Else
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지
        End If

    ElseIf sKeyName == "mbbnk61010_p9" Then

        DATAMANAGER.RequestTranData("obcsb_oimf_638r_1")

    ElseIf sKeyName == "mhetc90060_p8" Then '추가인증
    
        If sRet == "ok" Then '추가인증성공
			
            '바로출금서비스 약정하면서 이체하는 경우
            If g_szBaroSvcYn == "1" Or g_szBaroSvcYn == "2" Then
                if g_szMdiaSkipYn == "Y" then
                    f_CheckBioCert() '전자서명처리만 한다
                    Exit Sub
                End If
            End if
			
            Select Case g_szGubunCode
                Case "1"
                    Form.MsgBox("알림" , "부가정보만 존재할경우 처리가 불가능합니다." , "" , 6)
                Case "2"	
                    'v004 메시지박스 주석처리
                    'Form.MsgBox("알림" , "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다." , "" , 6)
                    RegisterOTP() 'v004 추가
                Case "9"
                    Form.MsgBox("알림" , "기타오류가 발생했습니다." , "" , 6)
                Case "0"
                    '공인인증서_보안카드화면
                    Form.OpenPopupAnimation("seccardcheckpopup" , " " , "" , "2")
                Case "3"
                    f_OTP_Tr_Auth_Msg_Create() '토큰형OTP/스마트OTP Input값 입력  
                    Form.OpenPopupAnimation("otpcheckpopup" , " " , "" , "2") '공인인증서_일반/스마트OTP
                Case "4"    
                    Form.OpenPopupAnimation("otpcheckpopup" , " " , "" , "2") '공인인증서_mOTP    
            End Select
        Else
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지
        End If

    ElseIf sKeyName == "보안카드" Or sKeyName == "OTP" Then
    
        If sRet == "Success" Then
            f_CheckBioCert()
        Else
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지
        End If

    ElseIf sKeyName == "mhetc90060_p5" Or sKeyName == "mhetc90060_px" Then
    
        szData = Split(sRet, ";")
        If szData(0) == "ok" or sRet == "ok" Then
            If g_szBaroSvcYn == "1" Then '바로출금 서비스 약정 후 이체 실행
                DATAMANAGER.RequestTranData("obsap_acif_999a") '금융상품가입일련번호 채번
            Else
                f_RequestTransfer()
            End If
        Else
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지
        End If
		
    ElseIf sKeyName == "POPUP_TEXT" Then
    
        If Trim(sRet) == "" Then
            return
        End If
		
        If g_szPoupText == "MyMemoOne" Then
	
            szMyMemo = Trim(sRet)
            szYourMemo = contOne.tblMemo.GetCellString(1, 1)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 1)
            contOne.tblMemo.SetCellString(0, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "MyMemoMany1" Then
	
            szMyMemo = Trim(sRet)
            szYourMemo = contMany.contTrans.contTrans1.tblTrans0.GetCellString(1, 1)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 1)
            contMany.contTrans.contTrans1.tblTrans0.SetCellString(0, 1, Trim(sRet))

        ElseIf g_szPoupText == "MyMemoMany2" Then
	
            szMyMemo = Trim(sRet)
            szYourMemo = contMany.contTrans.contTrans2.tblTrans0.GetCellString(1, 1)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 2)
            contMany.contTrans.contTrans2.tblTrans0.SetCellString(0, 1, Trim(sRet))
			
        Elseif g_szPoupText == "MyMemoMany3" Then
	
            szMyMemo = Trim(sRet)
            szYourMemo = contMany.contTrans.contTrans3.tblTrans0.GetCellString(1, 1)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 3)
            contMany.contTrans.contTrans3.tblTrans0.SetCellString(0, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "MyMemoMany4" Then
	
            szMyMemo = Trim(sRet)
            szYourMemo = contMany.contTrans.contTrans4.tblTrans0.GetCellString(1, 1)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 4)
            contMany.contTrans.contTrans4.tblTrans0.SetCellString(0, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "MyMemoMany5" Then
	
            szMyMemo = Trim(sRet)
            szYourMemo = contMany.contTrans.contTrans5.tblTrans0.GetCellString(1, 1)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 5)
            contMany.contTrans.contTrans5.tblTrans0.SetCellString(0, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "YourMemoOne" Then
		
            szMyMemo = contOne.tblMemo.GetCellString(0, 1)
            szYourMemo = Trim(sRet)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 1)
            contOne.tblMemo.SetCellString(1, 1, Trim(sRet)) 
			
        ElseIf g_szPoupText == "YourMemoMany1" Then
	
            szMyMemo = contMany.contTrans.contTrans1.tblTrans0.GetCellString(0, 1)
            szYourMemo = Trim(sRet)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 1)
            contMany.contTrans.contTrans1.tblTrans0.SetCellString(1, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "YourMemoMany2" Then
	
            szMyMemo = contMany.contTrans.contTrans2.tblTrans0.GetCellString(0, 1)
            szYourMemo = Trim(sRet)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 2)
            contMany.contTrans.contTrans2.tblTrans0.SetCellString(1, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "YourMemoMany3" Then
	
            szMyMemo = contMany.contTrans.contTrans3.tblTrans0.GetCellString(0, 1)
            szYourMemo = Trim(sRet)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 3)
            contMany.contTrans.contTrans3.tblTrans0.SetCellString(1, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "YourMemoMany4" Then
	
            szMyMemo = contMany.contTrans.contTrans4.tblTrans0.GetCellString(0, 1)
            szYourMemo = Trim(sRet)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 4)
            contMany.contTrans.contTrans4.tblTrans0.SetCellString(1, 1, Trim(sRet))
			
        ElseIf g_szPoupText == "YourMemoMany5" Then
	
            szMyMemo = contMany.contTrans.contTrans5.tblTrans0.GetCellString(0, 1)
            szYourMemo = Trim(sRet)
            f_SetTransInfoMemoMod(szMyMemo , szYourMemo , 5)
            contMany.contTrans.contTrans5.tblTrans0.SetCellString(1, 1, Trim(sRet))
			
        End If

    ElseIf sKeyName == "mbbnk63010_p16" And sRet == "ok" Then '바로출금서비스 미약정 확인 팝업 리턴

        Form.OpenPopupAnimation("mbbnk63010_p13" , "" , "", "2") '바로출금서비스 신청 팝업

    ElseIf sKeyName == "mbbnk63010_p13" And sRet <> "" And sRet <> Null Then '바로출금서비스 신청 팝업 리턴
    
        tRet = Split(sRet, g_szSeparator)
		
        '약정에 필요한 데이터 받아옴(계약서류 통보처 관련)
        g_szHndvMthdCode = tRet(0)
        g_szContact = tRet(1)
        g_szContInagSrno = tRet(2)

        Form.OpenPopupAnimation("mbbnk63010_p14" , "" , "", "2") '바로출금서비스 약관 팝업

    Elseif sKeyName == "mbbnk63010_p14" And sRet == "ok" Then '바로출금서비스 약관 팝업 리턴
		
        g_szBaroSvcYn = "1"
        f_CheckTrans()

    ElseIf sKeyName == "mbbnk63010_p15" And sRet == "ok" Then '바로출금서비스 확인 팝업 리턴(기약정 상태)
    
        g_szBaroSvcYn = "2"
        f_CheckTrans()

    End If
    
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

    If sKeyName == "isReset" Then
    
        If sRet == "ok" Then
            Form.SendReturnToParent("mbbnk63010_s2" , "AllReset")
            Form.CloseForm()
        End If
	
    ElseIf sKeyName == "EXCEPT_TRANS" Then '출금불가 건 삭제 (2건->1건 변경 시 단건이체 화면으로 전환)
	
        If sRet == "ok" Then
	
            If g_szProsAbleYn5 == "N" Then
                g_nTranIndex = g_nTranIndex - 1
                f_DeleteTransInfoItem(5)
                f_ResetDataConfirmPage()
            End If

            If g_szProsAbleYn4 == "N" Then
                g_nTranIndex = g_nTranIndex - 1
                f_DeleteTransInfoItem(4)
                f_ResetDataConfirmPage()
            End If

            If g_szProsAbleYn3 == "N" Then
                g_nTranIndex = g_nTranIndex - 1
                f_DeleteTransInfoItem(3)
                f_ResetDataConfirmPage()
            End If

            If g_szProsAbleYn2 == "N" Then
                g_nTranIndex = g_nTranIndex - 1
                f_DeleteTransInfoItem(2)
                f_ResetDataConfirmPage()
            End If
		
            If g_szProsAbleYn1 == "N" Then
                g_nTranIndex = g_nTranIndex - 1
                f_DeleteTransInfoItem(1)
                f_ResetDataConfirmPage()
            End If
	    
        Else
	
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지
	    
        End If
		
    ElseIf sKeyName == "SAME_TRANS" Then
    
        If sRet == "ok" Then
	
            g_szRcvn_iqry_tmnu = 0
            DATAMANAGER.RequestTranData("obtss_elbs_121r") '타행이체 수취조회 전문발송
	    
        End If
    End If
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
     
    If Trim(sTimerID) == "1" Then '수취조회
    
        Form.SetTimerEvent2(1,0,0)
        DATAMANAGER.RequestTranData( "obtss_elbs_221r" )

    ElseIf Trim(sTimerID) == "2" Then '타행이체 실행
    
        Form.SetTimerEvent2(2,0,0)
        DATAMANAGER.RequestTranData( "obtss_elbs_231r" )

    ElseIf Trim(sTimerID) == "9999" Then 'remove
    
        Form.removeWaitCursor()
        Form.SetTimerEvent(9999,0,1)
		
    End If

End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()

    szBackPressEnable = Form.GetSharedData("&BACK_PRESS_ENABLE", False) '뒤로가기 버튼 활성화상태 체크 (다건이체 접수 창에서 비활성화)
    If szBackPressEnable == "N" And g_szTransLastStep == "0" Then '다건이체접수화면에서 안드로이드 뒤로가기를 눌렀으면
        Form.MsgBox("알림", "취소 후 내용은 저장되지 않습니다.\n처음화면으로 이동하시겠습니까?", "isReset", 1)
    Else
        Form.CloseForm()
    End If
    
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    End If
    
'    If sKey == "&CommonNoSecurity" Then 'v004
'        If Cint(sValue) == 6 And g_szInTactProcessYn == "Y" Then '보안매체 발급팝업에서 정상처리됐으면
'            btnAlpha.visible = "1"  '오동작방지 (1.화면 터치 못하게 막음)
'            f_CheckBioCert() '전자서명인증 시작
'            g_szInTactProcessYn = "N"
'        End If	    	
'    End If

End Sub

'============================================================================ 
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    '출금계좌정보 조회 (출금가능금액 포함)
    If szTranID == "obacp_comm_064r" Or szTranID == "obacp_comm_064r_1" Or szTranID == "obacp_comm_064r_2" Then 
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CSNU" , 0 , 1         )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"   , 0 , g_szUserID)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"      , 0 , g_szACNO  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"      , 0 , g_szASNO  )

    ElseIf szTranID == "obrtp_drab_001r" Then '출금가능금액조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO" , 0 , g_szACNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO" , 0 , g_szASNO)

    ElseIf szTranID == "obtss_comm_502a" Then '보이스피싱 피해예방 로그생성
    
        szTransInfo = f_GetTransInfoItem(g_nVoiceCnt)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "DRNG_ACNO"     , 0,  g_szACNO       )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "DRNG_ASNO"     , 0,  g_szASNO       )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_BANK_CODE", 0,  arrTransInfo(0))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RMT_NAME"      , 0,  arrTransInfo(3))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CRCD"          , 0,  "KRW"          )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CHECK_AMT"     , 0,  0              )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FRCR_TR_AMT"   , 0,  arrTransInfo(4))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PRTR_DTL_CNTT" , 0,  "MTS다건이체"  )	
	
        If Trim(arrTransInfo(0)) == "287" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ACNO" , 0 , Left (arrTransInfo(1), 8))
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ASNO" , 0 , Right(arrTransInfo(1), 2))
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ACNO" , 0 , arrTransInfo(1))
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ASNO" , 0 , ""             )
        End If

    ElseIf szTranID == "obtss_elbs_121r" Then '타행이체 수취조회 전문발송 (당행도 가능)
    
        szTransInfo = f_GetTransInfoItem(g_nTranIndex)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_BANK_CODE"     , 0 , arrTransInfo(0)) '입금은행코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "JOB_TRNO"           , 0 , "031"          ) '작업단말번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ACNO"          , 0 , arrTransInfo(1)) '입금계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_AMT"             , 0 , arrTransInfo(4)) '거래금액
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "DRNG_ACNO"          , 0 , g_szACNO       ) '출금계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PROD_CLS_CODE" , 0 , g_szASNO       ) '계좌상품구분코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PWD"                , 0 , ""             ) '비밀번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RMRK"               , 0 , "N"            ) '비고  ( N:비밀번호 스킵 )
		
        Form.addWaitCursor()
    
    ElseIf szTranID == "obtss_elbs_221r" Then '타행이체 수취조회 응답수신 (타행만 호출)
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_BANK_CLS_CODE"  , 0 , g_szLNKD_BANK_CLS_CODE )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_DATE"             , 0 , g_szTR_DATE            )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "OTSD_TR_UNIQ_NO"     , 0 , g_szOTSD_TR_UNIQ_NO    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_LNKD_ISTU_CODE" , 0 , g_szTACT_LNKD_ISTU_CODE)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_STND_TR_CODE"   , 0 , g_szTACT_STND_TR_CODE  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_TLMS_MNNO"      , 0 , g_szLNKD_TLMS_MNNO     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RPCS_TMNU"           , 0 , g_szRcvn_iqry_tmnu     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ACNO"           , 0 , g_szACNO               ) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "ACNT_PROD_CLS_CODE"  , 0 , g_szASNO               ) '계좌일련번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "PWD"                 , 0 , ""                     ) '비밀번호

    Elseif szTranID == "obrtp_tact_011r" Then '출금가능여부 최종체크 v003
    
        btnAlpha.visible = "1" '오동작방지    
    
        DATAMANAGER.ClearInputData(0 , szTranID)
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO" , 0 , g_szACNO) '출금 종합계좌
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO" , 0 , g_szASNO) '출금 계좌일련번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RMRK" , 0 , ""      ) '비고
	
        If Trim(g_szPRCD) = "200" And (g_szBaroSvcYn == "1" Or g_szBaroSvcYn == "2") Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS" , 0 , "2") '바로출금서비스 이용
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS" , 0 , "1") '일반출금
        End If
	
        If g_nTranIndex >= 1 Then
	
            szTransInfo = f_GetTransInfoItem(1) 'TransInfo Index는 1부터 시작
            arrTransInfo = Split(szTransInfo, g_szSeparator)
	    
            If g_nTranIndex == 1 Then
                szMemo = contOne.tblMemo.GetCellString(1, 1)
            Else
                szMemo = contMany.contTrans.contTrans1.tblTrans0.GetCellString(1, 1)
            End If	
	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 0 , arrTransInfo(0)) '입금은행코드
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"      , 0 , arrTransInfo(1)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_AMT"         , 0 , arrTransInfo(4)) '입금금액	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_EXPL"        , 0 , szMemo         ) '통장내용	    
	    
        End If
	
        If g_nTranIndex >= 2 Then
	
            szTransInfo = f_GetTransInfoItem(2) 'TransInfo Index는 1부터 시작
            arrTransInfo = Split(szTransInfo, g_szSeparator)
	    
            szMemo = contMany.contTrans.contTrans2.tblTrans0.GetCellString(1, 1)
	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 1 , arrTransInfo(0)) '입금은행코드
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"      , 1 , arrTransInfo(1)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_AMT"         , 1 , arrTransInfo(4)) '입금금액	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_EXPL"        , 1 , szMemo         ) '통장내용	    
	    
        End If	
	
        If g_nTranIndex >= 3 Then
	
            szTransInfo = f_GetTransInfoItem(3) 'TransInfo Index는 1부터 시작
            arrTransInfo = Split(szTransInfo, g_szSeparator)
	    
            szMemo = contMany.contTrans.contTrans3.tblTrans0.GetCellString(1, 1)
	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 2 , arrTransInfo(0)) '입금은행코드
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"      , 2 , arrTransInfo(1)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_AMT"         , 2 , arrTransInfo(4)) '입금금액	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_EXPL"        , 2 , szMemo         ) '통장내용	    
	    
        End If
	
        If g_nTranIndex >= 4 Then
	
            szTransInfo = f_GetTransInfoItem(4) 'TransInfo Index는 1부터 시작
            arrTransInfo = Split(szTransInfo, g_szSeparator)
	    
            szMemo = contMany.contTrans.contTrans4.tblTrans0.GetCellString(1, 1)
	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 3 , arrTransInfo(0)) '입금은행코드
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"      , 3 , arrTransInfo(1)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_AMT"         , 3 , arrTransInfo(4)) '입금금액	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_EXPL"        , 3 , szMemo         ) '통장내용	    
	    
        End If		
	
        If g_nTranIndex >= 5 Then
	
            szTransInfo = f_GetTransInfoItem(5) 'TransInfo Index는 1부터 시작
            arrTransInfo = Split(szTransInfo, g_szSeparator)
	    
            szMemo = contMany.contTrans.contTrans5.tblTrans0.GetCellString(1, 1)
	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 4 , arrTransInfo(0)) '입금은행코드
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"      , 4 , arrTransInfo(1)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_AMT"         , 4 , arrTransInfo(4)) '입금금액	    
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_EXPL"        , 4 , szMemo         ) '통장내용	    
	    
        End If	

    Elseif szTranID == "obcsb_oimf_638r_1" Then '전자금융사기예방 고객조회

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"          , 0 , g_szUserID        )'사용자ID
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID()) 'UI단말식별키
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"             , 0 , g_szACNO          )
	
        If Trim(g_szPRCD) = "200" And (g_szBaroSvcYn == "1" Or g_szBaroSvcYn == "2") Then
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS" , 0 , "2")	'바로출금서비스 이용하는 경우
        Else
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS" , 0 , "1")	'기존
        End If
		
        If g_szCertUserType == "1" Then
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
        ElseIf g_szCertUserType == "3" Or g_szCertUserType == "4" Then
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
        ElseIf g_szCertUserType == "5" Then 'v002
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "205")	'205 사설인증 로그인 이체
        Else
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
        End If
		
        If g_nTranIndex > 1 Then
	
            For i = 0 To Cdbl(g_nTranIndex) - 1 
                szTransInfo = f_GetTransInfoItem(i+1)
                arrTransInfo = Split(szTransInfo, g_szSeparator)

                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ACNO"      , i , g_szACNO       )
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ASNO"      , i , g_szASNO       )
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , i , arrTransInfo(0))
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_AMT"       , i , arrTransInfo(4))
		
                If arrTransInfo(0) == "287" Then
                    DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2", "TACT_CLS_CODE" , i ,"01"                      )'대체출금
                    DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2", "MNRC_ACNO"     , i , Left(arrTransInfo(1), 8) )
                    DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2", "MNRC_ASNO"     , i , Right(arrTransInfo(1), 2))
                Else
                    DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2", "TACT_CLS_CODE" , i , "03"           )'이체출금
                    DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2", "MNRC_ACNO"     , i , arrTransInfo(1))
                    DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2", "MNRC_ASNO"     , i , ""             )
                End If

            Next
        Else
	
            szTransInfo = f_GetTransInfoItem(g_nTranIndex)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ACNO"      , 0 , g_szACNO       )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ASNO"      , 0 , g_szASNO       )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 0 , arrTransInfo(0))
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_AMT"       , 0 , arrTransInfo(4))
	    
            If arrTransInfo(0) == "287" Then
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_CLS_CODE" , 0 , "01"                     )'대체출금
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"     , 0 , Left(arrTransInfo(1), 8) )
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ASNO"     , 0 , Right(arrTransInfo(1), 2))
            Else
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_CLS_CODE" , 0 , "03"           )'이체출금
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"     , 0 , arrTransInfo(1))
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ASNO"     , 0 , ""             )
            End If

        End If

    ElseIf szTranID == "obrtd_drng_004a" Then '당행 이체 실행
    
        szTransInfo = f_GetTransInfoItem(g_nTransCnt)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"          , 0 , g_szACNO                             )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"          , 0 , g_szASNO                             )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PWD"      , 0 , g_szPwd                              )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "AMDR"          , 0 , arrTransInfo(4)                      )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CASH_DRNG_AMT" , 0 , arrTransInfo(4)                      )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RSEV_YN"       , 0 , "N"                                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RCPY_DATE"     , 0 , Form.GetSharedData("&BIZ_DT" , False))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SMCD"          , 0 , "003020"                             )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_CLS_CODE" , 0 , "01"                                 )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TRMD_CLS_CODE" , 0 , "17"                                 ) 
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_ACNO"     , 0 , Left(arrTransInfo(1),8)              )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_ASNO"     , 0 , Right(arrTransInfo(1),2)             )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_EXPL"       , 0 , arrTransInfo(6)                      )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_TR_EXPL"  , 0 , arrTransInfo(7)                      )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "BNKB_GRP_NO"   , 0 , g_szCertUserType & g_szMdiaSkipYn    )

    ElseIf szTranID == "obtss_elbs_131u" Then '타행 이체 실행 접수
    
        szTransInfo = f_GetTransInfoItem(g_nTransCnt) 
        arrTransInfo = Split(szTransInfo, g_szSeparator)

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_BANK_CODE"           , 0 , arrTransInfo(0)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "JOB_TRNO"                 , 0 , "031"                            )'단말
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ACNO"                , 0 , arrTransInfo(1)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_AMT"                   , 0 , arrTransInfo(4)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "DRNG_ACNO"                , 0 , g_szACNO                         )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PROD_CLS_CODE"       , 0 , g_szASNO                         )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PWD"                      , 0 , g_szPwd                          )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RMT_NAME"                 , 0 , arrTransInfo(3)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FEE"                      , 0 , arrTransInfo(5)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "STDL_CNFT_BRCD"           , 0 , arrTransInfo(8)                  )'지점코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "DRNG_ACNT_BNKB_EXRS_CNTT" , 0 , arrTransInfo(6)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PMPP_INFO_CNTT"           , 0 , arrTransInfo(7)                  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RMRK"                     , 0 , g_szCertUserType & g_szMdiaSkipYn)
	
    ElseIf szTranID == "obtss_elbs_231r" Then '타행 이체 실행 수신
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_BANK_CLS_CODE"  , 0 , g_szLNKD_BANK_CLS_CODE )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_DATE"             , 0 , g_szTR_DATE            )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "OTSD_TR_UNIQ_NO"     , 0 , g_szOTSD_TR_UNIQ_NO    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_LNKD_ISTU_CODE" , 0 , g_szTACT_LNKD_ISTU_CODE)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_STND_TR_CODE"   , 0 , g_szTACT_STND_TR_CODE  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_TLMS_MNNO"      , 0 , g_szLNKD_TLMS_MNNO     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RPCS_TMNU"           , 0 , g_szTact_rpcs_tmnu     )

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ACNO"          , 0 , g_szACNO) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "ACNT_PROD_CLS_CODE" , 0 , g_szASNO) '계좌일련번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "PWD"                , 0 , g_szPwd ) '비밀번호
	
    ElseIf szTranID == "obrtp_drab_001r_1" Then '이체 완료 후 출금가능금액조회
    
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , g_szACNO )
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" , 0 , g_szASNO )

    ElseIf szTranID == "obrtp_tact_101a" Then '자주쓰는계좌 등록 처리
	
        szTransInfo = f_GetTransInfoItem(g_nOftenIndex)
        arrTransInfo = Split(szTransInfo, g_szSeparator)

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE" , 0 , "1"            ) '1.등록
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"          , 0 , g_szCustNum    ) '고객번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01"           ) '01.자주쓰는계좌
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "1"            ) '1.원화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_SRNO"     , 0 , 0              ) '조회일련번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"          , 0 , g_szACNO       ) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_CODE"     , 0 , arrTransInfo(0)) '입금은행코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_ACNM"     , 0 , arrTransInfo(3)) '수취인명(계좌명)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "USER_NAME"     , 0 , ""             ) '사용자명(계좌별명 변경 시에만 사용)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRCD"          , 0 , "KRW"          ) '통화코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BIC_CODE"      , 0 , ""             ) 'BIC코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "DATA_SRNO"     , 0 , 0              ) '미사용
		
        If Trim(arrTransInfo(0)) == "287" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" ,	0 , "1"                     ) '1. 당사
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"      , 0 , ""                      ) '입금계좌번호(타행)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"          , 0 , MID(arrTransInfo(1),1,8)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"          , 0 , MID(arrTransInfo(1),9,2)) '입금계좌일련번호
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" ,	0 , "2"            ) '2. 타사
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"      , 0 , arrTransInfo(1)) '입금계좌번호(타행)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"          , 0 , ""             ) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"          , 0 , ""             ) '입금계좌일련번호
        End If	

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "USER_NAME" , 0 , g_szAlias) '사용자명(계좌별칭)
	
    ElseIf szTranID == "obrtp_tact_101a_1" Then '자주쓰는계좌 삭제 처리
		
        szTransInfo = f_GetTransInfoItem(g_nOftenIndex)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE" , 0 , "5"            ) '5.삭제
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"          , 0 , g_szCustNum    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01"           )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "1"            ) '1.원화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_SRNO"     , 0 , 0              ) '조회일련번호 - 서비스 내에서 조회
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"          , 0 , g_szACNO       ) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_CODE"     , 0 , arrTransInfo(0)) '입금은행코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_ACNM"     , 0 , arrTransInfo(3)) '수취인명(계좌명)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "USER_NAME"     , 0 , ""             ) '사용자명(계좌별명 변경 시에만 사용)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRCD"          , 0 , "KRW"          ) '통화코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BIC_CODE"      , 0 , ""             ) 'BIC코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "DATA_SRNO"     , 0 , 0              ) '미사용
		
        If Trim(arrTransInfo(0)) == "287" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" ,	0 , "1"                     ) '1. 당사
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"      , 0 , ""                      ) '입금계좌번호(타행)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"          , 0 , MID(arrTransInfo(1),1,8)) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"          , 0 , MID(arrTransInfo(1),9,2)) '입금계좌일련번호
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" ,	0 , "2"            ) '2. 타사
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"      , 0 , arrTransInfo(1)) '입금계좌번호(타행)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"          , 0 , ""             ) '입금계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"          , 0 , ""             ) '입금계좌일련번호
        End If	

    ElseIf szTranID == "obrtp_tact_009r" Then '출금가능여부확인
	    
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , g_szACNO)
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , g_szASNO)
		
        For i=0 To Cdbl(g_nTranIndex) - 1 
            szTransInfo = f_GetTransInfoItem(i+1)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            If i == Cdbl(g_nTranIndex) - 1 Then
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_BANK_CODE" , 0 , arrTransInfo(0))
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MNRC_ACNO"      , 0 , arrTransInfo(1))
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_AMT"         , 0 , arrTransInfo(4))
            Else
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , i , arrTransInfo(0))
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"      , i , arrTransInfo(1))
                DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TR_AMT"         , i , arrTransInfo(4))
            End If
        Next
	
    ElseIf szTranID == "obcsb_acad_122a" Then '가입계약서류 제공방식 관리
    
        If g_szHndvMthdCode == "04" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "04"            )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , "13"            )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "UI_CUST_TEL_NO" , 0 , g_szContact     )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "INAG_SRNO"      , 0 , g_szContInagSrno)
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "02"            )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , "21"            )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ADDR"           , 0 , g_szContact     )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "INAG_SRNO"      , 0 , g_szContInagSrno)
        End If
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE"  , 0 , "1"             )

    ElseIf szTranID == "obpds_srvc_435a" Then '바로출금서비스 약정신청
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1"              )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CSNO"          , 0 , Trim(g_szCustNum))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVCD"          , 0 , "093"            )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"          , 0 , g_szACNO         )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"          , 0 , g_szASNO         )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PWD"      , 0 , g_szPwd          )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"              )

    ElseIf szTranID == "obcsb_dbif_322a" Then '계약서류 교부처리
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"                , 0 , g_szACNO                                           )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FNPR_JOIN_SRNO"      , 0 , g_szFnprJoinSrno                                   )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "BSWR_LRDV_CODE"      , 0 , "017"                                              )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "FNPR_JOIN_DETL_SRNO" , 0 , "00001"                                            )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "ISCD"                , 0 , "093"                                              )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "BSWR_DIV_CODE"       , 0 , "02093"                                            )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "CNRC_DOCU_KEY_VAL"   , 0 , Trim(g_szCustNum) & "$" & "093" & "$" & g_szSvcSrno)
	
	
    ElseIf szTranID == "obpds_srvc_439r" Then 'JWH 20240124 은행이체약정여부

        szTransInfo = f_GetTransInfoItem(1)
        arrTransInfo = Split(szTransInfo, g_szSeparator)

        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"          , 0 , g_szACNO)
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BANK_CODE"     , 0 , arrTransInfo(0))
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BANK_USE_ACNO" , 0 , arrTransInfo(1))
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "1") '1.원화

    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    If szTranID = "obacp_comm_064r" Then '출금계좌번호조회 (1건만)
	     
        nCnt = Cdbl(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		
        If nCnt > 0 Then

            g_szACNO       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "ACNO"              , 0)
            g_szASNO       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "ASNO"              , 0)
            g_szPRCD       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "PRCD"              , 0)	     
            g_szPRNM       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "PRNM"              , 0)
            g_nDrngAbleAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "DRNG_ABLE_AMT"     , 0) '출금가능금액
            g_nLoanAbleAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "SELN_ASCR_AMT"     , 0) '매도담보대출가능금액
            g_szLoanStplYN = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "SELN_ASCR_STPL_YN" , 0) '매도담보대출약정여부
            g_szLoanRate   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1", "LOAN_INTRT"        , 0) '매도담보대출이자율
	     
            f_SetAccountText()
		    
        Else
	
            Form.MsgBox("알림", "선택 가능한 출금계좌가 없습니다" , "", 0)
            Form.CloseForm()
	    
        End If

        'JWH 20240124 처음 선택되어있던 종합계좌와 선택한 종합계좌가 다를 때 (출금계좌변경은 단건이체만 가능하므로 방어로직 추가)     
        If g_nTranIndex == 1 Then
	
            szTransInfo = f_GetTransInfoItem(g_nTranIndex)
            arrTransInfo = Split(szTransInfo, g_szSeparator)

            '법인고객이 타금융내계좌 그리드 선택해서 이체 시도할 경우 종합계좌와 약정여부 비교한다
            If Trim(arrTransInfo(0)) <> "287" And g_CustClsCode <> "1" And g_MnrcAcntSlctCls == "4" Then
                DATAMANAGER.RequestTranData("obpds_srvc_439r") '	    
            End If
            
        End If
	
    ElseIf szTranID == "obacp_comm_064r_2" Then '바로출금서비스 이용 시 출금가능금액 더블체크
    
        '바로출금서비스 이용 시 이체 실행시점에서 출금가능금액에 변동이 생겼는지를 체크 (약정은 완료)
        nDrngAbleAmt = Cdbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "DRNG_ABLE_AMT" , 0))
        nLoanAbleAmt = Cdbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "SELN_ASCR_AMT" , 0))
		
        If Cdbl(g_nDrngAbleAmt) + Cdbl(g_nLoanAbleAmt) <> Cdbl(nDrngAbleAmt) + Cdbl(nLoanAbleAmt) Then
	
            szErrMsg = "출금가능금액이 변경되었습니다. 잔고 확인 후 바로출금(매도담보대출) 이용금액을 다시 확인해주세요."
            f_SetResultInfoFail("N" , szErrMsg)

        Else
	
            szTransInfo = f_GetTransInfoItem(g_nTransCnt)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            If arrTransInfo(0) == "287" Then
                DATAMANAGER.RequestTranData("obrtd_drng_004a")
            Else
                g_szTact_rpcs_tmnu = 0
                DATAMANAGER.RequestTranData("obtss_elbs_131u")
            End If
	    
        End If

	
	ElseIf szTranID == "obtss_comm_502a" Then '보이스피싱 피해예방 로그생성
	
        If g_nTranIndex > g_nVoiceCnt Then
            g_nVoiceCnt = g_nVoiceCnt + 1
            DATAMANAGER.RequestTranData("obtss_comm_502a")
        Else
            Form.OpenPopup("mbbnk63010_p6" , "" , "")
        End If

    ElseIf szTranID == "obtss_elbs_121r" Then '타행이체 수취조회 전문발송
	
        If DATAMANAGER.GetDataMsgCode(szTranID) == "6617" Then  '처리 대기중입니다.
	
            g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_BANK_CLS_CODE"  , 0)
            g_szTR_DATE             = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TR_DATE"             , 0)
            g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "OTSD_TR_UNIQ_NO"     , 0)
            g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_LNKD_ISTU_CODE" , 0)
            g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_STND_TR_CODE"   , 0)
            g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_TLMS_MNNO"      , 0)

            Form.SetTimerEvent2(1,1,0.5) '처음은 0.5초 후 조회
            g_szMNRC_ACNT_DSGT_YN = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MNRC_ACNT_DSGT_YN" , 0) '입금계좌지정여부
            Exit Sub
	    
        Else
		
            szTransInfo = f_GetTransInfoItem(g_nTranIndex)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            If arrTransInfo(0) == "287" Then
	    
                szDELY_TACT_CLSN_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DELY_TACT_CLSN_YN", 0)
		
                If szDELY_TACT_CLSN_YN == "Y" Then
                    Form.MsgBox("알림", "지연이체 가능시간이 아닙니다." , "" , 6)
                    return
                End If
		
                g_CnftAcnm = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNM" , 0)
				
                f_SetTransInfoFee(0)
				
                szTempTransInfo = f_GetTransInfoItem(1)
                arrTempTransInfo = Split(szTempTransInfo, g_szSeparator)
				
                '슈퍼365 계좌이고, 이체금액이 출금가능보다 크고, 이체금액이 출금가능 + 대출가능금액 내이고, 단건이체인 경우
                If Trim(g_szPRCD) = "200" And Cdbl(g_nDrngAbleAmt) < Cdbl(arrTempTransInfo(4)) + Cdbl(arrTempTransInfo(5)) And Cdbl(arrTempTransInfo(4)) + Cdbl(arrTempTransInfo(5)) <= (Cdbl(g_nDrngAbleAmt) + Cdbl(g_nLoanAbleAmt)) And g_nTranIndex == 1 Then				    

                    szSendData = arrTempTransInfo(4) & g_szSeparator & g_nDrngAbleAmt & g_szSeparator & g_nLoanAbleamt & g_szSeparator & g_szLoanRate & g_szSeparator & "0"

                    If Trim(g_szLoanStplYN) = "Y" Then '바로출금서비스 약정이 되어있음
                        Form.OpenPopupAnimation("mbbnk63010_p15" , szSendData , "" , "2") '부족금액 알림
                    Else '미약정
                        Form.OpenPopupAnimation("mbbnk63010_p16" , szSendData , "" , "2") '부족금액 알림 & 서비스신청 유도
                    End If
                Else 'v003 일반출금 시에 출금가능금액 한번 더 조회
