Sub contOne_btnAddTrans_OnClick() ' 추가이체 버튼 단건

    If g_nTranIndex == 5 Then
        Form.MsgBox("알림", "추가이체는 5건까지 가능합니다.", "", 6)
        return
    End If
	
    Form.SetSharedData("63010_ACNT_INFO" , g_szACNO..g_szSeparator..g_szASNO..g_szSeparator..g_szPRCD..g_szSeparator..g_szPRNM..g_szSeparator..g_nDrngAbleAmt)

    szData = g_nTranIndex   .. "♥" ..
             g_szTransInfo1 .. "♥" ..
             g_szTransInfo2 .. "♥" ..
             g_szTransInfo3 .. "♥" ..
             g_szTransInfo4 .. "♥" ..
             g_szTransInfo5
			
    Form.SendReturnToParent("mbbnk63010_s2_AddTrans" , szData)
    Form.CloseForm()
    
End Sub

'============================================================================
Sub contOne_btnTrans_OnClick() ' 보내기 버튼 단건
    DATAMANAGER.RequestTranData("obrtp_tact_011r") 'v003 obrtp_comn_025r 서비스 통합
End Sub

