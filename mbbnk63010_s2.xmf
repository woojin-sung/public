    Form.shareSNS(szText)
End Sub

'============================================================================
Sub f_DeleteTransInfoItem(nIndex)

    If nIndex == 5 Then
        f_SetTransInfoItem("", 5)
    Else
        For i=nIndex + 1 To 5
            szData = f_GetTransInfoItem(i)
            f_SetTransInfoItem(szData, i-1)
        Next
    End If
	
    f_ResetDataConfirmPage()
	
End Sub

'============================================================================
Sub f_ResetDataConfirmPage()

	contMany.visible = "0"
	contOne.visible = "0"
	contMany.contTrans.contTrans1.visible = "0"
	contMany.contTrans.contTrans2.visible = "0"
	contMany.contTrans.contTrans3.visible = "0"
	contMany.contTrans.contTrans4.visible = "0"
	contMany.contTrans.contTrans5.visible = "0"
	
	contMany.contTrans.contTrans1.top = 0
	contMany.contTrans.contTrans2.top = 0
	contMany.contTrans.contTrans3.top = 0
	contMany.contTrans.contTrans4.top = 0
	contMany.contTrans.contTrans5.top = 0
	
	f_SetDataConfirm() '이체확인페이지
	
End Sub

