'============================================================================
Sub f_SetTransInfoMemo(szMyMemo, szYourMemo)

    szTransInfo = f_GetTransInfoItem(g_nTranIndex)
    arrTransInfo = Split(szTransInfo, g_szSeparator)
    szData = szTransInfo .. g_szSeparator .. arrTransInfo(3) .. g_szSeparator .. g_szUserNm
    f_SetTransInfoItem(szData, g_nTranIndex)

End Sub

