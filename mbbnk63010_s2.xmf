		DATAMANAGER.RequestTranData("obcsb_acad_122a") '가입계약서류 제공방식 관리

    ElseIf szTranID == "obcsb_acad_122a" Then '가입계약서류 제공방식 관리
		
		DATAMANAGER.RequestTranData("obpds_srvc_435a") '바로출금서비스 약정신청

    ElseIf szTranID == "obpds_srvc_435a" Then '바로출금서비스 약정신청
    
        g_szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO"  , 0)
        DATAMANAGER.RequestTranData("obcsb_dbif_322a") '계약서류 교부처리
 
    ElseIf szTranID == "obcsb_dbif_322a" Then '계약서류 교부처리

        f_RequestTransfer() '바로출금약정 완료, 이 시점에서 이체 실행
	
    ElseIf szTranID == "obrtp_tact_011r" Then 'v003
    
        g_szSTPL_STAT_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STPL_STAT_CLS_CODE"  , 0)
	
        g_szProsAbleYn1 = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "PROS_ABLE_YN" , 0)
        g_szProsAbleYn2 = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "PROS_ABLE_YN" , 1)
        g_szProsAbleYn3 = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "PROS_ABLE_YN" , 2)
        g_szProsAbleYn4 = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "PROS_ABLE_YN" , 3)
        g_szProsAbleYn5 = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "PROS_ABLE_YN" , 4)

        szErrMsg = Trim(DATAMANAGER.GetDataMsgText(szTranID))    '주메시지
        szSubErr = Trim(DATAMANAGER.GetDataMsgSubText(szTranID)) '서브메시지 	
	
        If g_szSTPL_STAT_CLS_CODE == "00" Then '00: 진행가능
	
            szData = g_szACNO .. g_szASNO .. "☆" .. "0"
            Form.openPopupAnimation("pwdcheckpopup" , szData , "" , "2")  '계좌비밀번호 입력 팝업	
	
        ElseIf g_szSTPL_STAT_CLS_CODE == "02" Then '02: 지연이체접수시간 초과	
	
            If g_nTranIndex == 1 And g_szProsAbleYn1 == "N" Then
                Form.MsgBox("알림" , "지연이체 가능시간이 아닙니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 2 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" Then
                Form.MsgBox("알림" , "지연이체 가능시간이 아닙니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 3 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" And g_szProsAbleYn3 =="N" Then
                Form.MsgBox("알림" , "지연이체 가능시간이 아닙니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 4 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" And g_szProsAbleYn3 =="N" And g_szProsAbleYn4 =="N" Then
                Form.MsgBox("알림" , "지연이체 가능시간이 아닙니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 5 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" And g_szProsAbleYn3 =="N" And g_szProsAbleYn4 =="N" And g_szProsAbleYn5 =="N" Then
                Form.MsgBox("알림" , "지연이체 가능시간이 아닙니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex > 1 And (g_szProsAbleYn1 =="N" or g_szProsAbleYn2 =="N" or g_szProsAbleYn3 =="N" or g_szProsAbleYn4 =="N" or g_szProsAbleYn5 =="N") Then
                Form.MsgBox("알림" , "지연이체 가능시간이 아닙니다.\n지연이체 대상은 제외하고 이체하시겠습니까?" , "EXCEPT_TRANS" , 1)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            End If	

        ElseIf g_szSTPL_STAT_CLS_CODE == "08" Then '08: 출금가능금액 초과
	
            Form.MsgBox("알림", "출금가능금액이 부족합니다.", "", 6)	
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지	    	    
	    
        ElseIf g_szSTPL_STAT_CLS_CODE == "09" Then '09: 부적절한 통장문구 (v003 기존 obrtp_comn_025r 체크로직 통합)
	
            If g_nTranIndex == 1 And g_szProsAbleYn1 == "N" Then
                Form.MsgBox("알림", "\'받는분에게 표기\' 내용에 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 2 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" Then
                Form.MsgBox("알림", "\'받는분에게 표기\' 내용에 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 3 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" And g_szProsAbleYn3 =="N" Then
                Form.MsgBox("알림", "\'받는분에게 표기\' 내용에 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 4 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" And g_szProsAbleYn3 =="N" And g_szProsAbleYn4 =="N" Then
                Form.MsgBox("알림", "\'받는분에게 표기\' 내용에 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex == 5 And g_szProsAbleYn1 =="N" And g_szProsAbleYn2 =="N" And g_szProsAbleYn3 =="N" And g_szProsAbleYn4 =="N" And g_szProsAbleYn5 =="N" Then
                Form.MsgBox("알림", "\'받는분에게 표기\' 내용에 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            ElseIf g_nTranIndex > 1 And (g_szProsAbleYn1 =="N" or g_szProsAbleYn2 =="N" or g_szProsAbleYn3 =="N" or g_szProsAbleYn4 =="N" or g_szProsAbleYn5 =="N" ) Then
                Form.MsgBox("알림", "\'받는분에게 표기\' 내용에 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.\n해당 건은 제외하고 이체하시겠습니까?", "EXCEPT_TRANS", 1)
                Form.removeWaitCursor()
                btnAlpha.visible = "0" '오동작방지
            End If
	
        Else '기타불가
	
            If Trim(szSubErr) == "" Then
                Form.MsgBox("알림", szErrMsg , "" , 6)
            Else
                Form.MsgBox("알림", szErrMsg.."\n("..Trim(szSubErr)..")" , "" , 6)
            End If
	    
            Form.removeWaitCursor()
            btnAlpha.visible = "0" '오동작방지	    
	    
        End If
	
    ElseIf szTranID == "obacp_comm_064r_1" Then 'v003 확인페이지 넘어가기 전 출금가능금액 마지막으로 확인 (바로출금서비스 제외)
    
        g_nDrngAbleAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "DRNG_ABLE_AMT" , 0)
        f_CheckTrans()	'이체 최종체크
		
    ElseIf szTranID == "obpds_srvc_439r" Then 'JWH 20240124 법인고객의 은행이체약정여부
    
        szStplYn = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "STPL_YN" , 0)
	
        If szStplYn <> "Y" Then
            Form.MsgBox("알림", "출금계좌의 등록된 은행이체 계좌가 아닙니다. 다시 확인하시기 바랍니다.", "", 1)
            Form.SendReturnToParent("mbbnk63010_s2_STPL_FAIL" , g_szACNO)
            Form.CloseForm()	    
        End If
	
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText(szTranID))
	
    If szSubErr <> "" And szSubErr <> Null Then
        szErrMsg = szErrMsg .. "\n" .. szSubErr
    End If

    If szTranID == "obtss_elbs_121r" Or szTranID == "obtss_elbs_221r" Then '타행이체 수취조회 전문발송, 수신
    
        Form.MsgBox( "알림", szErrMsg, "", 6 )
        Form.SetTimerEvent(9999, 1, 1)

    ElseIf szTranID == "obcsb_oimf_638r_1" Then
    
        If szErrCode = "9150" Then
            Form.MsgBox("알림" , szErrMsg , "" , 6)
        End If
	
        Form.removeWaitCursor()
        btnAlpha.visible = "0" '오동작방지

    ElseIf szTranID == "obrtd_drng_004a" Or szTranID == "obtss_elbs_131u" Or szTranID == "obtss_elbs_231r" Then '이체오류
    
        If g_nTranIndex > 1 Then '다건이체
            If g_nTranIndex = g_nTransCnt then
                f_SetTransInfoResult(g_nTransCnt, "N", szErrMsg, "N")
                f_SetResultInfoSuccess("N", szErrMsg) '다건이체결과 표기 (성공+실패 모두 표기)
            ElseIf g_nTranIndex > g_nTransCnt Then
                f_SetTransInfoResult(g_nTransCnt, "N", szErrMsg, "N")
                g_nTransCnt = g_nTransCnt + 1
                f_RequestTransfer()
            End If
        Else '단건이체
            If Trim(g_szPRCD) == "200" And g_szBaroSvcYn == "1" Then '바로출금약정은 성공하였으나 이체는 실패
                f_SetResultInfoFail("Y" , szErrMsg) '결과화면에 약정신청내역 링크 보여줌
            Else '바로출금약정을 맺지 않음
                f_SetResultInfoFail("N" , szErrMsg) '결과화면에 약정신청내역 링크 안보여줌
            End If
        End If
		
    ElseIf szTranID == "obrtp_tact_101a" Or szTranID == "obrtp_tact_101a_1" Then
    
		Form.MsgBox("알림" , szErrMsg , "" , 6)
		
    ElseIf szTranID == "obrtp_tact_009r" Then '출금가능여부확인
    
		Form.MsgBox("알림" , szErrMsg , "" , 6)
		
    ElseIf szTranID == "obrtp_tact_011r" Then 'v003 최종출금가능여부확인
    
        Form.MsgBox( "알림", szErrMsg, "", 6 )
        Form.removeWaitCursor()
        btnAlpha.visible = "0" '오동작방지		
		
    ElseIf szTranID == "obacp_comm_064r" Then
    
        Form.MsgBox("알림", "선택 가능한 출금계좌가 없습니다." , "" , 0)
        Form.CloseForm()
	
    ElseIf szTranID == "obacp_comm_064r_1" Or szTranID == "obacp_comm_064r_2" Then 'v003
    
        Form.MsgBox("알림", "출금계좌정보 조회 오류입니다." , "" , 0)
        Form.CloseForm()
	
    ElseIf szTranID == "obsap_acif_999a" Or  szTranID == "obcsb_acad_122a" Or szTranID == "obpds_srvc_435a" Then '바로출금약정 & 계약서류처리 오류
    
        f_SetResultInfoFail("N" , szErrMsg) '약정등록에 실패했으므로 신청내역링크 노출하지 않음(obcsb_dbif_322a는 계약서류교부 TR이므로 오류처리하지 않는다)
	
    End If
	
End Sub

'============================================================================
Sub f_SetAccountText() ' 출금계좌정보 Set

    szACNOL = Left(g_szACNO,4)
    szACNOR = Right(g_szACNO,4)
    szPRNM = g_szPRNM
    szUSERNM = g_szUserNm 
	
    contAmt.lblAcnt.caption = szACNOL.."-"..szACNOR.."-"..g_szASNO
    contAmt.lblAbleAmt.caption = FormatNumber(CDBL(g_nDrngAbleAmt), 0, 0, 0, -1) .. "원"
	
    acntList.caption = g_szACNO .. g_szASNO
	
    szTransInfo = f_GetTransInfoItem(g_nTranIndex)
    arrTransInfo = Split(szTransInfo, g_szSeparator)
	
    If Trim(arrTransInfo(3)) == "9432_TAX" Then '지로가상계좌는 수취인명 보여주지 않음
	
        If arrTransInfo(0) == "287" Then
            contAmt.lblRecAcnt.caption = arrTransInfo(2).." "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2)
        Else
            contAmt.lblRecAcnt.caption = arrTransInfo(2).." "..arrTransInfo(1)
        End If
	    
    Else '그 외 계좌 수취인명 보여줌
    
        If arrTransInfo(0) == "287" Then
            contAmt.lblRecAcnt.caption = arrTransInfo(2).." "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2).."\n"..arrTransInfo(3)
        Else
            contAmt.lblRecAcnt.caption = arrTransInfo(2).." "..arrTransInfo(1).."\n"..arrTransInfo(3)
        End If
    
    End If
	
    If Trim(g_szPRCD) = "200" And Trim(g_szLoanStplYN) = "Y" And Cdbl(g_nLoanAbleAmt) > 0 And g_nTranIndex < 2 Then '매도담보대출약정이 되어있는 슈퍼365
    
        contAmt.imgBg.height   = 100
        contAmt.lblRecAcnt.top = 171	
        contAmt.lblBorderLine.visible = "1"	
	
        contAmt.lblSuperCaption.visible = "1"	
        contAmt.lblSuperAmt.visible     = "1"
        contAmt.lblTotalCaption.visible = "1"
        contAmt.lblTotalAmt.visible     = "1"
		
        contAmt.lblSuperAmt.caption = g_nLoanAbleAmt
        contAmt.lblTotalAmt.caption = Cdbl(g_nDrngAbleAmt) + Cdbl(g_nLoanAbleAmt)
	
    Else
    
        contAmt.imgBg.height   = 42    
        contAmt.lblRecAcnt.top = 144	
        contAmt.lblBorderLine.visible = "0"
	
        contAmt.lblSuperCaption.visible = "0"	
        contAmt.lblSuperAmt.visible     = "0"
        contAmt.lblTotalCaption.visible = "0"	
        contAmt.lblTotalAmt.visible     = "0"

    End If
	
    contAmt.edtAmt.caption = ""
    contAmt.lblOver.visible     = "0"
    contAmt.ImgPrcreset.visible = "0"
    contAmt.btnConfirm.enable   = "0"
    btnAlpha.visible            = "0"
    contAmt.btnConfirm.enable = "1"
    lblLimit.enable = True
	
End Sub

'============================================================================
Sub contAmt_ImgPrcreset_OnClick()

    contAmt.edtAmt.caption = ""
    f_CheckAbleAmt()
    
End Sub

'============================================================================
Sub f_AppendAmt(szAmt)

    If (Cdbl(contAmt.edtAmt.caption..szAmt) >= 100000000000) Then
        return
    End If

    contAmt.edtAmt.caption = contAmt.edtAmt.caption..szAmt
    f_CheckAbleAmt()
    
End Sub

'============================================================================
Sub f_AddAmt(szAmt)

    If (Cdbl(contAmt.edtAmt.caption) + Cdbl(szAmt) >= 100000000000) Then
        return
    End If

    contAmt.edtAmt.caption = Cdbl(contAmt.edtAmt.caption) + Cdbl(szAmt)
    f_CheckAbleAmt()
    
End Sub

'============================================================================
Sub f_CheckBioCert() '인증 팝업 호출

    If g_szCertUserType == "1" Then '간편비번 only
        Form.OpenPopup("mhetc90060_px", "", "")
        Exit Sub
    End If

    If g_szCertUserType == "0" Or g_szCertUserType == "3" Or g_szCertUserType == "4" Or g_szCertUserType == "5" Then '바이오, 공동인증, 사설인증
    
        szBIO_TR_CODE = "1"        '바이오거래유형코드   0: 인증 1: 서명 
        szATHN_USAG_CLS_CODE = "0" '서명데이터 생성여부
		
        szTransInfo = f_GetTransInfoItem(g_nTranIndex)
        arrTransInfo = Split(szTransInfo, g_szSeparator)

        szTRMsg = "이체예정내역\n" & "입금기관:" & arrTransInfo(2) & "\n" & "입금계좌:" & arrTransInfo(0) & "\n" & "예금주명:" & arrTransInfo(3) & "\n" & "이체금액:" & FormatNumber(CDbl(arrTransInfo(4)), 0, 0, 0, -1) & "원\n" 
		
        If g_nTranIndex > 1 Then
	
            szTotalAmt = 0
            For i=1 to g_nTranIndex
                szTransInfo = f_GetTransInfoItem(i)
                arrTransInfo = Split(szTransInfo, g_szSeparator)
                szTotalAmt = szTotalAmt + arrTransInfo(4)
            Next
	    
            szTRMsg = szTRMsg & "외 " & g_nTranIndex -1 & " 건\n"
            szTRMsg = szTRMsg & "총금액 : " & FormatNumber(szTotalAmt, 0, 0, 0, -1) & " 원\n"
	    
        End If

        If g_szCertUserType = "3" Then '바이오
            szData = "BIO_trType★"& szBIO_TR_CODE  &"★"&  szTRMsg &"★"& szATHN_USAG_CLS_CODE 
        ElseIf g_szCertUserType = "4" Then '바이오
            szData = "BCHAIN_trType★"& szBIO_TR_CODE  &"★"&  szTRMsg &"★"& szATHN_USAG_CLS_CODE 
        ElseIf g_szCertUserType = "5" Then '사설인증
            szData = "ATON_trType★"& szTRMsg 	
        Else
            szData = ""
        End If
	
        Form.OpenFramePopup("mhetc90060_p5" , szData , "")
        Exit Sub
	
    End If 
    
End Sub

'============================================================================
Sub f_RequestTransfer() ' 이체 서비스 호출

    btnAlpha.visible = "1"
	
    
    If g_szPRCD == "200" And (g_szBaroSvcYn == "1" Or g_szBaroSvcYn == "2") Then
    
        DATAMANAGER.RequestTranData("obacp_comm_064r_2") '바로출금서비스 이체는 출금가능금액 변동 여부를 체크  (인증은 이미 다 끝남)

    Else
    
        szTransInfo = f_GetTransInfoItem(g_nTransCnt)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        If arrTransInfo(0) == "287" Then
	
            DATAMANAGER.RequestTranData("obrtd_drng_004a")
	    
        Else
	
            g_szTact_rpcs_tmnu = 0
            DATAMANAGER.RequestTranData("obtss_elbs_131u")
	    
        End If
	
    End If
	
End Sub

'============================================================================
Sub f_SetResultInfoSuccess() ' 이체 완료 세팅 성공

    DATAMANAGER.RequestTranData("obrtp_drab_001r_1") '출금가능금액조회
	
    Label3.visible       = "0"
    imgBack.visible      = "0"
    lblLimit.visible     = "0"
    lblCancel.visible    = "0"
    lblLimitLine.visible = "0"
    btnBack.visible      = "0"
	
    If g_nTranIndex > 1 Then
        szTotalAmt = 0
        szTotalFee = 0
        szTotalCnt = 0
        szDelayCnt = 0
		
        For i=1 to g_nTranIndex
            szTransInfo = f_GetTransInfoItem(i)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
            If arrTransInfo(9) == "Y" Then
                szTotalAmt = szTotalAmt + arrTransInfo(4)
                szTotalFee = szTotalFee + arrTransInfo(5)
                szTotalCnt = szTotalCnt + 1
            End If
            If arrTransInfo(11) == "Y" Then
                szDelayCnt = szDelayCnt + 1
            End If
        Next
		
        If szTotalCnt == 0 Then
	
            contResultManyY.imgResult.imgpath = "icon_tact_caution.png" '이체불가
            contResultManyY.lblTransInfo1.caption = "총 "..g_nTranIndex.." 건"
            contResultManyY.lblTransInfo2.caption = "이체가 처리 되지 않았어요."
            contResultManyY.lblTransInfo1.changeTextAttr(2, Len(g_nTranIndex), 4, 6, True)
            contResultManyY.imgNameBg.visible = "0"
            contResultManyY.tblTrans.visible = "0"
