'============================================================================
Sub f_OTP_Tr_Auth_Msg_Create()

    'arrOtpAuthInfo(0) '은행코드
    'arrOtpAuthInfo(1) '계좌번호
    'arrOtpAuthInfo(2) '입금기관
    'arrOtpAuthInfo(3) '수취인명
    'arrOtpAuthInfo(4) '금액
    'arrOtpAuthInfo(5) '수수료

    szOtpTrAuthMsgCntt = "" '초기화

    If g_nTranIndex >= 1 Then
        szOtpAuthInfo = f_GetTransInfoItem(1)
        arrOtpAuthInfo = Split(szOtpAuthInfo, g_szSeparator)
        '입금은행명#입금계좌#수취인명#금액#
        szOtpTrAuthMsgCntt = szOtpTrAuthMsgCntt .. arrOtpAuthInfo(2) .. "#" .. arrOtpAuthInfo(1) .. "#" .. arrOtpAuthInfo(3) .. "#" .. FormatNumber(CDBL(arrOtpAuthInfo(4)), 0, 0, 0, -1) & "원#"
    End If
    
    If g_nTranIndex >= 2 Then
        szOtpAuthInfo = f_GetTransInfoItem(2)
        arrOtpAuthInfo = Split(szOtpAuthInfo, g_szSeparator)
        '입금은행명#입금계좌#수취인명#금액#
        szOtpTrAuthMsgCntt = szOtpTrAuthMsgCntt .. arrOtpAuthInfo(2) .. "#" .. arrOtpAuthInfo(1) .. "#" .. arrOtpAuthInfo(3) .. "#" .. FormatNumber(CDBL(arrOtpAuthInfo(4)), 0, 0, 0, -1) & "원#"
    End If
    
    If g_nTranIndex >= 3 Then
        szOtpAuthInfo = f_GetTransInfoItem(3)
        arrOtpAuthInfo = Split(szOtpAuthInfo, g_szSeparator)
        '입금은행명#입금계좌#수취인명#금액#
        szOtpTrAuthMsgCntt = szOtpTrAuthMsgCntt .. arrOtpAuthInfo(2) .. "#" .. arrOtpAuthInfo(1) .. "#" .. arrOtpAuthInfo(3) .. "#" .. FormatNumber(CDBL(arrOtpAuthInfo(4)), 0, 0, 0, -1) & "원#"
    End If
    
    If g_nTranIndex >= 4 Then
        szOtpAuthInfo = f_GetTransInfoItem(4)
        arrOtpAuthInfo = Split(szOtpAuthInfo, g_szSeparator)
        '입금은행명#입금계좌#수취인명#금액#
        szOtpTrAuthMsgCntt = szOtpTrAuthMsgCntt .. arrOtpAuthInfo(2) .. "#" .. arrOtpAuthInfo(1) .. "#" .. arrOtpAuthInfo(3) .. "#" .. FormatNumber(CDBL(arrOtpAuthInfo(4)), 0, 0, 0, -1) & "원#"
    End If
    
    If g_nTranIndex >= 5 Then
        szOtpAuthInfo = f_GetTransInfoItem(5)
        arrOtpAuthInfo = Split(szOtpAuthInfo, g_szSeparator)
        '입금은행명#입금계좌#수취인명#금액#
        szOtpTrAuthMsgCntt = szOtpTrAuthMsgCntt .. arrOtpAuthInfo(2) .. "#" .. arrOtpAuthInfo(1) .. "#" .. arrOtpAuthInfo(3) .. "#" .. FormatNumber(CDBL(arrOtpAuthInfo(4)), 0, 0, 0, -1) & "원#"
    End If
    
    Form.SetSharedData("OTP_TR_AUTH_MSG" , szOtpTrAuthMsgCntt)
    
End Sub

