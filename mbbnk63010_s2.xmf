                contResultManyY.contTrans.contTrans1.tblInfo.SetCellString(3, 0, "")
                contResultManyY.contTrans.contTrans1.tblInfo.SetCellString(3, 1, "")
                contResultManyY.contTrans.contTrans1.tblInfo.SetCellString(4, 0, "")
                contResultManyY.contTrans.contTrans1.tblInfo.SetCellString(4, 1, "")
            End If
			
            contResultManyY.contTrans.contTrans1.visible = "1"
        End If
		
        If g_szCertUserType == "0" And g_szRegYn == "N" And g_CustClsCode == "1" Then
	
            If g_nTranIndex == 1 Then '단건일 때
                contResultManyY.contTrans.contReg.top = "222"
            Else
                contResultManyY.contTrans.contReg.top = (g_nTranIndex*182)+30
            End If
	    
            contResultManyY.contTrans.contReg.visible = "1"
	    
        End If
		
        contMany.visible = "0"
        contResultManyY.visible = "1"
        contOne.visible = "0"
        contResultOneY.visible = "0"
		
        contResultManyY.contTrans.SetScrollAutoSize()
	
	Else '단건이체
	
        szTransInfo = f_GetTransInfoItem(g_nTransCnt)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        If arrTransInfo(9) == "Y" Then
	
            contResultOneY.contInfo.imgStar.visible = "1"
		    
            If arrTransInfo(8) == "Y" Then '자주쓰는계좌
                g_szOftenAcntYN1 = "Y"
                contResultOneY.contInfo.imgStar.imgpath = "icon_star_yellow.png"
            Else
                contResultOneY.contInfo.imgStar.imgpath = "icon_star_gray.png"
            End If
        Else
            contResultOneY.contInfo.imgStar.visible = "0"
        End If

        contResultOneY.tblTrans.SetCellString(0, 1, Left(g_szACNO,4).."-"..Right(g_szACNO,4).."-"..g_szASNO) 

        contResultOneY.contInfo.imgLogoOneY.imgpath = "bank"..arrTransInfo(0)..".png"
        contResultOneY.contInfo.lblNameOneY.caption = arrTransInfo(3)
	
        If arrTransInfo(0) == "287" Then
            contResultOneY.contInfo.tblInfo.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2) )
        Else
            contResultOneY.contInfo.tblInfo.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1) )
        End If
		
        contResultOneY.contInfo.tblInfo.SetCellString(1, 1, arrTransInfo(4) )
	
        If arrTransInfo(5) == "0" Then
            contResultOneY.contInfo.tblInfo.SetCellString(2, 1, "무료" )
        Else
            contResultOneY.contInfo.tblInfo.SetCellString(2, 1, FormatNumber(arrTransInfo(5),0).."원" )
        End If
	
        contResultOneY.contInfo.tblInfo.SetCellString(3, 1, arrTransInfo(6) )
        contResultOneY.contInfo.tblInfo.SetCellString(4, 1, arrTransInfo(7) )

        contResultOneY.lblTransInfo1.height = 21

        If arrTransInfo(11) == "Y" Then '지연이체 여부
            contResultOneY.contInfo.imgStar.left = "297"
            contResultOneY.contInfo.imgShare.visible = "0"
            contResultOneY.contInfo.imgDelayBg.visible = "1"
            contResultOneY.contInfo.lblDelayText.visible = "1"
            contResultOneY.contInfo.lblDelayMove.visible = "1"
            contResultOneY.contInfo.tblInfo.SetCellString(3, 0, "")
            contResultOneY.contInfo.tblInfo.SetCellString(3, 1, "")
            contResultOneY.contInfo.tblInfo.SetCellString(4, 0, "")
            contResultOneY.contInfo.tblInfo.SetCellString(4, 1, "")
            contResultOneY.lblTransInfo1.caption = arrTransInfo(3).." 님에게"
            contResultOneY.lblTransInfo2.caption = FormatNumber(arrTransInfo(4),0).." 원이 이체(접수)되었어요."
        Else
            contResultOneY.lblTransInfo1.caption = arrTransInfo(3).." 님에게"
            contResultOneY.lblTransInfo2.caption = FormatNumber(arrTransInfo(4),0).." 원이 이체되었어요."
        End If

        nText1Len = contResultOneY.lblTransInfo1.getLen(contResultOneY.lblTransInfo1.caption)
        contResultOneY.lblTransInfo1.changeTextAttr(0, (nText1Len-4), 4, 6, true)
        contResultOneY.lblTransInfo2.changeTextAttr(0, Len(FormatNumber(arrTransInfo(4),0)), 4, 6, true)

        If Trim(g_szPRCD) = "200" And g_szBaroSvcYn == "1" Then '신규약정 고객 바로출금 시
            contResultOneY.contReg.visible = False '이용기기등록유도(단건)
            contResultOneY.tblBaroReg.visible = True '대출잔고조회이동(단건)	 
        ElseIf Trim(g_szPRCD) = "200" And g_szBaroSvcYn == "2" Then '기존약정 고객 바로출금 시
            contResultOneY.contReg.visible = False '이용기기등록유도(단건)
            contResultOneY.tblBaroReg.visible = True '대출잔고조회이동(단건)
        ElseIf g_szCertUserType == "0" And g_szRegYn == "N" And g_CustClsCode == "1" Then
            contResultOneY.contReg.visible = True '이용기기등록유도(단건)
            contResultOneY.tblBaroReg.visible = False '대출잔고조회이동(단건)
        Else
            contResultOneY.contReg.visible = False '이용기기등록유도(단건)
            contResultOneY.tblBaroReg.visible = False '대출잔고조회이동(단건)	 
        End If
		
        g_szBaroSvcYn = "0"
        g_szHndvMthdCode = ""
        g_szContact = ""		
        g_szContInagSrno = ""	
        g_szFnprJoinSrno = ""
        g_szSvcSrno = ""
		
        contMany.visible = "0"
        contResultManyY.visible = "0"
        contOne.visible = "0"
        contResultOneY.visible = "1"
		
    End If	
    
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화
    g_szTransLastStep = "1"
    btnAlpha.visible = "0"
    Form.removeWaitCursor() '오동작방지
	
End Sub

'============================================================================ 
Sub f_SetResultInfoFail(szBaroStplYN , szErrMsg) '이체 완료 세팅 실패 (단건일 때만 호출하는 함수)

    Label3.visible = "0"
    imgBack.visible = "0"
    lblLimit.visible = "0"
    lblCancel.visible = "0"
    lblLimitLine.visible = "0"
    btnBack.visible = "0"

    If g_nTranIndex > 1 then
        'DO NOTHING
    Else
        szTransInfo = f_GetTransInfoItem(g_nTransCnt)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        contResultOneN.lblNameOneN.caption = arrTransInfo(3)
        contResultOneN.imgLogoOneN.imgpath = "bank"..arrTransInfo(0)..".png"
		
        nStartIndex = InStr( szErrMsg, "(" )
        nLen = Len( szErrMsg)
        If nStartIndex > 0 then
            szSubErrMsg = Right( szErrMsg, nLen-nStartIndex+1)
            szErrMsg = Left(szErrMsg, nStartIndex-1)
            contResultOneN.lblMsg.caption = szErrMsg..szSubErrMsg
            contResultOneN.lblMsg.height = 46
            contResultOneN.imgBg.height = 150
        Else
            contResultOneN.lblMsg.caption = szErrMsg
            contResultOneN.lblMsg.height = 31
        End If
		
        If arrTransInfo(0) == "287" then
            contResultOneN.tblInfo.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2) )
        Else
            contResultOneN.tblInfo.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1) )
        End If
        contResultOneN.tblInfo.SetCellString(1, 1, arrTransInfo(4) )
		
        contOne.visible = "0"
        contResultOneN.visible = "1"
		
        If szBaroStplYN == "Y" Then '약정신청내역 바로가기
            contResultOneN.tblBaroRegSucc.visible = True
        Else
            contResultOneN.tblBaroRegSucc.visible = False
        End If
		
    End If
	
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화
    g_szTransLastStep = "1"
    btnAlpha.visible = "0"
    Form.removeWaitCursor() '오동작방지
	
End Sub

'============================================================================
Sub f_SetTransInfoItem(szData, nIndex) ' 이체 정보 Set

    If nIndex == 1 Then
        g_szTransInfo1 = szData
    ElseIf nIndex == 2 Then
        g_szTransInfo2 = szData
    ElseIf nIndex == 3 Then
        g_szTransInfo3 = szData
    ElseIf nIndex == 4 Then
        g_szTransInfo4 = szData
    ElseIf nIndex == 5 Then
        g_szTransInfo5 = szData
    End If

End Sub

'============================================================================
Function f_GetTransInfoItem(nIndex) ' 이체 정보 Get

    If nIndex == 1 Then
        Return g_szTransInfo1
    ElseIf nIndex == 2 Then
        Return g_szTransInfo2
    ElseIf nIndex == 3 Then
        Return g_szTransInfo3
    ElseIf nIndex == 4 Then
        Return g_szTransInfo4
    ElseIf nIndex == 5 Then
        Return g_szTransInfo5
    End If
    
End Function

'============================================================================
Sub contAmt_btnBack_OnClick()

    contAmt.edtAmt.caption = Mid(contAmt.edtAmt.caption,1,Len(contAmt.edtAmt.caption)-1)
    f_CheckAbleAmt()
    
End Sub

'============================================================================
Sub contAmt_btnAll_OnClick()

    szTransInfo = f_GetTransInfoItem(g_nTranIndex)
    arrTransInfo = Split(szTransInfo, g_szSeparator)

    If Cdbl(g_nDrngAbleAmt) - Cdbl(arrTransInfo(5)) > 0 Then
        contAmt.edtAmt.caption = Cdbl(g_nDrngAbleAmt) - Cdbl(arrTransInfo(5))
    Else
        contAmt.edtAmt.caption = "0"
    End If
    
    f_CheckAbleAmt()
    
End Sub

'============================================================================
Sub f_CheckAbleAmt()
	
	'슈퍼365 + 매도담보대출가능금액이 있는 경우 
	If Trim(g_szPRCD) = "200" And Cdbl(g_nLoanAbleAmt) > 0 Then

		If Cdbl(g_nDrngAbleAmt) + Cdbl(g_nLoanAbleAmt) < Cdbl(contAmt.edtAmt.caption) + Cdbl(arrTransInfo(5)) Then
			contAmt.lblOver.visible   = "1"
			contAmt.btnConfirm.enable = "0"
		Else
			contAmt.lblOver.visible   = "0"
			contAmt.btnConfirm.enable = "1"
		End If
    Else
        If Cdbl(g_nDrngAbleAmt) < Cdbl(contAmt.edtAmt.caption) + Cdbl(arrTransInfo(5)) Then
            contAmt.lblOver.visible = "1"
            contAmt.btnConfirm.enable = "0"
        Else
            contAmt.lblOver.visible = "0"
            contAmt.btnConfirm.enable = "1"
        End If
    
    End If
    
    If contAmt.edtAmt.caption == "" Then
        contAmt.ImgPrcreset.visible = "0"
        contAmt.btnConfirm.enable   = "0"
    Else
        contAmt.ImgPrcreset.visible = "1" '금액클리어 버튼
    End If
	
End Sub

'============================================================================
Sub contAmt_btnAcnt_OnClick()
    If g_nTranIndex == 1 Then '출금계좌선택은 단건이체 시에만 허용
        szACNO = acntList.total
        szASNO = acntList.sequence
        Form.OpenPopupAnimation("mbbnk63010_p4", szACNO .. szASNO , "" , "2")
    End If
End Sub

'============================================================================
Sub contAmt_btnConfirm_OnClick()

    If Trim(contAmt.edtAmt.caption) == "" Or Trim(contAmt.edtAmt.caption) == "0" Then
        Form.MsgBox( "알림", "이체금액을 입력하십시요.", "", 6 )
        return
    End If

    nDrngAmt = Cdbl(contAmt.edtAmt.caption)
    f_SetTransInfoAmt(nDrngAmt)	

    nTrAmt = 0
	     
    For i = 1 To Cdbl(g_nTranIndex)
        szTransInfo = f_GetTransInfoItem(i)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
        nTrAmt = nTrAmt +  Cdbl(arrTransInfo(4)) +Cdbl(arrTransInfo(5))
    Next
			
    '슈퍼365 계좌이고, 단건이체인 경우 (바로출금이 가능한 경우)
    If Trim(g_szPRCD) == "200" And g_nTranIndex == 1 Then
        If Cdbl(nTrAmt) > Cdbl(g_nDrngAbleAmt) + Cdbl(g_nLoanAbleAmt) Then
            Form.MsgBox( "알림", "출금가능금액이 부족합니다." , "" , 6)
            return
        End If
    Else '바로출금 불가한 경우
        If Cdbl(nTrAmt) > Cdbl(g_nDrngAbleAmt) Then
            If g_nTranIndex == 1 Then
                Form.MsgBox( "알림", "출금가능금액이 부족합니다." , "" , 6)
                return				
            Else
                Form.MsgBox("알림", "접수금액이 출금가능금액을 초과합니다" , "", 6)
                return		      
            End If
        End If 
    End If

    DATAMANAGER.RequestTranData("obrtp_tact_009r") '출금가능여부확인
	
End Sub

'============================================================================
Sub f_CheckTrans() ' 이체 확인 전 조건 체크 (이체확인페이지 넘어오기 전 무조건 이 함수 거쳐야 함)

    szTransInfo = f_GetTransInfoItem(g_nTranIndex)
    arrTransInfo = Split(szTransInfo, g_szSeparator)

    f_SetTransInfoMemo(arrTransInfo(3) , g_szUserNm)
    f_SetTransInfoOften(g_szOftnAcntYN)
    
    nTrAmt = 0
	     
    For i = 1 To Cdbl(g_nTranIndex) 'v003
        szTransInfo = f_GetTransInfoItem(i)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
        nTrAmt = nTrAmt + Cdbl(arrTransInfo(4)) +Cdbl(arrTransInfo(5)) '출금요청금액 + 수수료
    Next
	
    '출금계좌와 입금계좌가 같을경우
    If arrTransInfo(1) == g_szACNO..g_szASNO Then
        Form.MsgBox("알림", "출금계좌번호와 입금계좌번호가 같습니다.", "", 6)
        return
    End If
    
    If g_szBaroSvcYn == "1" Or g_szBaroSvcYn == "2" Then '바로출금서비스 이용하지 않을 경우 출금가능금액 이내 출금 허용
        'DO NOTHING (바로출금서비스 이용)
    Else 'v003 일반인출 시 출금가능금액 최종체크
        If Cdbl(g_nDrngAbleAmt) < Cdbl(nTrAmt) Then
            Form.MsgBox("알림", "출금가능금액이 부족합니다.", "", 6)
            return	
        End If
    End If
	
    '보이스 피싱 300만원 이상 타사 또는 당사타명의 일경우 체크
    If Cdbl(contAmt.edtAmt.caption) >= 3000000 Then
        If g_szSapeYN <> "Y" Then
            Form.OpenPopup("mbbnk63010_p5" , "" , "")
            return
        End If
    End If
	
    f_SetDataConfirm()
	
End Sub

'============================================================================
Sub f_SetDataConfirm() ' 이체 확인 페이지 Set

    If g_nTranIndex > 1 Then '다건이체
        szTotalAmt = 0
        szTotalFee = 0
        For i=1 To g_nTranIndex
            szTransInfo = f_GetTransInfoItem(i)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
            szTotalAmt = szTotalAmt + arrTransInfo(4)
            szTotalFee = szTotalFee + arrTransInfo(5)
        Next
		
        contMany.lblTransInfo1.caption = "총 "..g_nTranIndex.." 건"
        contMany.lblTransInfo2.caption = FormatNumber(Cdbl(szTotalAmt),0).." 원을 보내시겠어요?"
		
        contMany.lblTransInfo1.changeTextAttr(2, Len(g_nTranIndex), 4, 6, true)
        contMany.lblTransInfo2.changeTextAttr(0, Len(FormatNumber(Cdbl(szTotalAmt),0)), 4, 6, true)
		
        contMany.tblTrans.SetCellString(0, 1, Left(g_szACNO,4).."-"..Right(g_szACNO,4).."-"..g_szASNO) 

        If Cdbl(szTotalFee) == 0 Then
            contMany.tblTrans.SetCellString(1, 1, "무료")
        Else
            contMany.tblTrans.SetCellString(1, 1, FormatNumber(Cdbl(szTotalFee),0).."원")
        End If
		
        If g_nTranIndex == 5 Then
            szTransInfo = f_GetTransInfoItem(5)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            contMany.contTrans.contTrans5.imgLogo5.imgpath = "bank"..arrTransInfo(0)..".png"
            contMany.contTrans.contTrans5.lblName5.caption = arrTransInfo(3)
			
            If arrTransInfo(0) == "287" Then
                contMany.contTrans.contTrans5.tblTrans5.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
            Else
                contMany.contTrans.contTrans5.tblTrans5.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1))
            End If

            contMany.contTrans.contTrans5.tblTrans5.SetCellString(1, 1, arrTransInfo(4))
	    
            If arrTransInfo(5) == "0" Then
                contMany.contTrans.contTrans5.tblTrans5.SetCellString(2, 1, "무료")
            Else
                contMany.contTrans.contTrans5.tblTrans5.SetCellString(2, 1, FormatNumber(Cdbl(arrTransInfo(5)),0).."원")
            End If

			
            If arrTransInfo(6) <> "" And arrTransInfo(6) <> Null Then '내통장에 표기
                contMany.contTrans.contTrans5.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
            Else
                contMany.contTrans.contTrans5.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
            End If
			
            If arrTransInfo(7) <> "" And arrTransInfo(7) <> Null Then '받는분에게 표기
                contMany.contTrans.contTrans5.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
            Else
                contMany.contTrans.contTrans5.tblTrans0.SetCellString(1, 1, g_szUserNm)
            End If
			
            contMany.contTrans.contTrans5.Label6.top = 1
            contMany.contTrans.contTrans5.top = "796" 
            contMany.contTrans.contTrans5.visible = "1"
	    
        End If
		
        If g_nTranIndex >= 4 Then
	
            szTransInfo = f_GetTransInfoItem(4)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            contMany.contTrans.contTrans4.imgLogo4.imgpath = "bank"..arrTransInfo(0)..".png"
            contMany.contTrans.contTrans4.lblName4.caption = arrTransInfo(3)
			
            If arrTransInfo(0) == "287" Then
                contMany.contTrans.contTrans4.tblTrans4.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
            Else
                contMany.contTrans.contTrans4.tblTrans4.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1))
            End If
			
            contMany.contTrans.contTrans4.tblTrans4.SetCellString(1, 1, arrTransInfo(4))
            If arrTransInfo(5) == "0" Then
                contMany.contTrans.contTrans4.tblTrans4.SetCellString(2, 1, "무료")
            Else
                contMany.contTrans.contTrans4.tblTrans4.SetCellString(2, 1, FormatNumber(Cdbl(arrTransInfo(5)),0).."원")
            End If

			
            If arrTransInfo(6) <> "" And arrTransInfo(6) <> Null Then '내통장에 표기
                contMany.contTrans.contTrans4.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
            Else
                contMany.contTrans.contTrans4.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
            End If
			
            If arrTransInfo(7) <> "" And arrTransInfo(7) <> Null Then '받는분에게 표기
                contMany.contTrans.contTrans4.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
            Else
                contMany.contTrans.contTrans4.tblTrans0.SetCellString(1, 1, g_szUserNm)
            End If

            contMany.contTrans.contTrans4.Label6.top = 1
            contMany.contTrans.contTrans4.top = "597"
            contMany.contTrans.contTrans4.visible = "1"
	    
        End If
		
        If g_nTranIndex >= 3 Then
	
            szTransInfo = f_GetTransInfoItem(3)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            contMany.contTrans.contTrans3.imgLogo3.imgpath = "bank"..arrTransInfo(0)..".png"
            contMany.contTrans.contTrans3.lblName3.caption = arrTransInfo(3)  
			
            If arrTransInfo(0) == "287" Then
                contMany.contTrans.contTrans3.tblTrans3.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
            Else
                contMany.contTrans.contTrans3.tblTrans3.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1))
            End If
			
            contMany.contTrans.contTrans3.tblTrans3.SetCellString(1, 1, arrTransInfo(4))
            If arrTransInfo(5) == "0" Then
                contMany.contTrans.contTrans3.tblTrans3.SetCellString(2, 1, "무료")
            Else
                contMany.contTrans.contTrans3.tblTrans3.SetCellString(2, 1, FormatNumber(Cdbl(arrTransInfo(5)),0).."원")
            End If

            If arrTransInfo(6) <> "" And arrTransInfo(6) <> Null Then '내통장에 표기
                contMany.contTrans.contTrans3.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
            Else
                contMany.contTrans.contTrans3.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
            End If
			
            If arrTransInfo(7) <> "" And arrTransInfo(7) <> Null Then '받는분에게 표기
                contMany.contTrans.contTrans3.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
            Else
                contMany.contTrans.contTrans3.tblTrans0.SetCellString(1, 1, g_szUserNm)
            End If
			
            contMany.contTrans.contTrans3.lblBordor3.top = 1
            contMany.contTrans.contTrans3.top = "398"
            contMany.contTrans.contTrans3.visible = "1"
	    
        End If
		
        If g_nTranIndex >= 2 Then
	
            szTransInfo = f_GetTransInfoItem(2)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            contMany.contTrans.contTrans2.imgLogo2.imgpath = "bank"..arrTransInfo(0)..".png"
            contMany.contTrans.contTrans2.lblName2.caption = arrTransInfo(3)
			
            If arrTransInfo(0) == "287" Then
                contMany.contTrans.contTrans2.tblTrans2.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
            Else
                contMany.contTrans.contTrans2.tblTrans2.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1))
            End If
			
            contMany.contTrans.contTrans2.tblTrans2.SetCellString(1, 1, arrTransInfo(4))
	    
            If arrTransInfo(5) == "0" Then
                contMany.contTrans.contTrans2.tblTrans2.SetCellString(2, 1, "무료")
            Else
                contMany.contTrans.contTrans2.tblTrans2.SetCellString(2, 1, FormatNumber(Cdbl(arrTransInfo(5)),0).."원")
            End If

            If arrTransInfo(6) <> "" And arrTransInfo(6) <> Null Then '내통장에 표기
                contMany.contTrans.contTrans2.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
            Else
                contMany.contTrans.contTrans2.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
            End If
			
            If arrTransInfo(7) <> "" And arrTransInfo(7) <> Null Then '받는분에게 표기
                contMany.contTrans.contTrans2.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
            Else
                contMany.contTrans.contTrans2.tblTrans0.SetCellString(1, 1, g_szUserNm)
            End If
			
            contMany.contTrans.contTrans2.lblBordor2.top = 1
            contMany.contTrans.contTrans2.top = "199"
            contMany.contTrans.contTrans2.visible = "1"
	    
        End If
	
        If g_nTranIndex >= 1 Then
	
            szTransInfo = f_GetTransInfoItem(1)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            contMany.contTrans.contTrans1.imgLogo1.imgpath = "bank"..arrTransInfo(0)..".png"
            contMany.contTrans.contTrans1.lblName1.caption = arrTransInfo(3)
			
            If arrTransInfo(0) == "287" Then
                contMany.contTrans.contTrans1.tblTrans1.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
            Else
                contMany.contTrans.contTrans1.tblTrans1.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1))
            End If
			
            contMany.contTrans.contTrans1.tblTrans1.SetCellString(1, 1, arrTransInfo(4))
            If arrTransInfo(5) == "0" Then
                contMany.contTrans.contTrans1.tblTrans1.SetCellString(2, 1, "무료")
            Else
                contMany.contTrans.contTrans1.tblTrans1.SetCellString(2, 1, FormatNumber(Cdbl(arrTransInfo(5)),0).."원")
            End If

            If arrTransInfo(6) <> "" And arrTransInfo(6) <> Null Then '내통장에 표기
                contMany.contTrans.contTrans1.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
            Else
                contMany.contTrans.contTrans1.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
            End If
			
            If arrTransInfo(7) <> "" And arrTransInfo(7) <> Null Then '받는분에게 표기
                contMany.contTrans.contTrans1.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
            Else
                contMany.contTrans.contTrans1.tblTrans0.SetCellString(1, 1, g_szUserNm)
            End If

            contMany.contTrans.contTrans1.top = "0"
            contMany.contTrans.contTrans1.visible = "1"
        End If

        contAmt.visible = "0"
        contMany.visible = "1"
        contAmt.visible = "0"
        contOne.visible = "0"
		
        lblLimit.visible = "0"
        lblLimitLine.visible = "0"
        lblCancel.visible = "1"
        lblCancel.caption = "전체취소"
        btnBack.visible = "0" 
		
        imgBack.visible = "0"
        Form.SetSharedData("&BACK_PRESS_ENABLE" , "N") '안드로이드 뒤로가기 동작 비활성화
		
        contMany.contTrans.SetScrollAutoSize()
		
    Else '단건이체
    
        szTransInfo = f_GetTransInfoItem(g_nTranIndex)
        arrTransInfo = Split(szTransInfo, g_szSeparator)

        contOne.tblTrans.SetCellString(0, 1, Left(g_szACNO,4).."-"..Right(g_szACNO,4).."-"..g_szASNO)
	
        If arrTransInfo(5) == "0" Then
            contOne.tblTrans.SetCellString(1, 1, "무료")
        Else
            contOne.tblTrans.SetCellString(1, 1, FormatNumber(Cdbl(arrTransInfo(5)),0).."원")
        End If

		
        If arrTransInfo(6) <> "" And arrTransInfo(6) <> Null Then '내통장에 표기
            contOne.tblMemo.SetCellString(0, 1, arrTransInfo(6)) 
        Else
            contOne.tblMemo.SetCellString(0, 1, arrTransInfo(3)) 
        End If
		
        If arrTransInfo(7) <> "" And arrTransInfo(7) <> Null Then '받는분에게 표기
			contOne.tblMemo.SetCellString(1, 1, arrTransInfo(7))
        Else
			contOne.tblMemo.SetCellString(1, 1, g_szUserNm)
        End If
		
        contOne.lblTransInfo1.height = 21
        contOne.lblTransInfo1.caption = arrTransInfo(3).." 님에게"
        contOne.lblTransInfo2.caption = FormatNumber(Cdbl(arrTransInfo(4)),0).." 원을 보내시겠어요?"
        contOne.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
		
        nText1Len = contOne.lblTransInfo1.getLen(contOne.lblTransInfo1.caption)
        contOne.lblTransInfo1.changeTextAttr(0, (nText1Len-4), 4, 6, true)
        contOne.lblTransInfo2.changeTextAttr(0, Len(FormatNumber(arrTransInfo(4),0)), 4, 6, true)
		
        If arrTransInfo(0) == "287" Then
            contOne.lblBankNameOne.caption = "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2)
        Else
            contOne.lblBankNameOne.caption = arrTransInfo(2).." "..arrTransInfo(1)
        End If
		
		
        '바로출금서비스 이용 시 추가이체 안되므로 버튼 조정
        If Trim(g_szPRCD) = "200" And (g_szBaroSvcYn == "1" Or g_szBaroSvcYn == "2") Then
            contOne.btnAddTrans.visible = False
            contOne.btnTrans.left = 25
            contOne.btnTrans.width = 325
        End If
		
        '최초에 다건이체로 이체확인창에 진입했다면, 나머지 이체 건을 취소해서 이체 건이 한 건만 남았더라도 안드로이드 취소버튼을 활성화하지 않는다
        'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") 
        lblCancel.caption = "취소"

        contAmt.visible = "0"
        contMany.visible = "0"
        contAmt.visible = "0"
        contOne.visible = "1"
		
        lblLimit.visible = "0"
        lblLimitLine.visible = "0"
        lblCancel.visible = "1"
	
    End If
    
End Sub

