'============================================================================
Sub f_SetTransInfoResult(nIndex, szResult, szMessage, szDelay)

	szTransInfo = f_GetTransInfoItem(nIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	szData = szTransInfo..g_szSeparator..szResult..g_szSeparator..szMessage..g_szSeparator..szDelay
	f_SetTransInfoItem(szData, nIndex)
	
End Sub

