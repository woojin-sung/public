    szTransInfo = f_GetTransInfoItem(g_nTranIndex)
    arrTransInfo = Split(szTransInfo, g_szSeparator)
    szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator..arrTransInfo(3)..g_szSeparator..nDrngAmt
    f_SetTransInfoItem(szData, g_nTranIndex)
	
End Sub

