            If Trim(g_szPRCD) = "200" And Cdbl(g_nDrngAbleAmt) < Cdbl(arrTempTransInfo(4)) + Cdbl(arrTempTransInfo(5)) And Cdbl(arrTempTransInfo(4)) + Cdbl(arrTempTransInfo(5)) <= Cdbl(g_nDrngAbleAmt) + Cdbl(g_nLoanAbleAmt) And g_nTranIndex == 1 Then				    

