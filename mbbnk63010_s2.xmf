Dim g_szD1_TACT_LIMT_AMT	

Dim g_szBaroSvcYn    '바로출금서비스 여부("0": 기존 이체, "1": 바로출금서비스 약정을 하면서 이체, "2": 기약정 상태에서 바로출금서비스로 이체)
Dim g_szHndvMthdCode '계약서류 제공방식 코드
Dim g_szContact      '통보처(휴대폰번호 또는 이메일)
Dim g_szContInagSrno '통보처 일련번호
Dim g_szFnprJoinSrno '금융상품가입일련번호
