			<PAGE name="page0" caption="계약정보" linkfile="mbwat61060_t1" />
			<PAGE name="page1" caption="운용지침" linkfile="mbwat61060_t2" />
		</FORMTAB>
		<EDIT name="edtPwd" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" ly_vert="400,5,76,40,1" />
		<LABEL name="lblNoData" visible="0" fgcolor="146:124124124" caption="랩계약이 존재하지 않습니다." halign="1" ly_vert="30,152,315,20,0" />
		<COMBO name="cmbAcnt" ly_vert="6,5,361,39,1" />
