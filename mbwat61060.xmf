	<SCRIPT_INFO _len="5342" _ulen="5158" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2022.10.24 : 고승연 : v0002 : 계좌일련번호 추가
'                2023.01.05 : 고승연 : v0003 : [T2301130023] 비밀번호 체크 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sCsno		'고객번호
Dim g_sAcno		'계좌번호
Dim g_sAsno		'계좌일련번호
Dim g_sCnrcNo		'계약번호

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	edtPwd.caption = ""
	g_sCsno = Form.GetSharedData("&CUST_NUM", false)
	
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
	DATAMANAGER.RequestTranData( "obwat_onln_004r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_004r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sCnrcNo, sPrcdName
				sAcnt	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCnrcNo	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CNRC_NO" , i )
				sCsnm	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				sPrnm	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "WA_PRNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				cmbAcnt.cbadddatatext = sAcnt..sAsno..sCnrcNo.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.."-"..sCnrcNo.." "..sCsnm
				cmbPrnm.cbadddatatext = sAcnt..sCnrcNo.."`"..sPrnm
			next
			
			cmbAcnt.currentindex = 0
			g_sAcno = Left(cmbAcnt.cbkeydata, 8)
			g_sAsno = Mid(cmbAcnt.cbkeydata, 9, 2)			'v0003 
			g_sCnrcNo = Right(cmbAcnt.cbkeydata, 3)
				
			Dim sData
			sData = g_sAcno.."|"..g_sAsno.."|"..g_sCnrcNo
			Form.triggerEvent("fmtabInfo."..fmtabInfo.currenttabpageid, "Request", sData)
		else
			lblAcntNodata.visible = true
			lblNoData.visible = true
		end if
		

	end if
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
	g_sAcno = Left(cmbAcnt.cbkeydata, 8)
	g_sAsno = Mid(cmbAcnt.cbkeydata, 9, 2)			'v0003 
	g_sCnrcNo = Right(cmbAcnt.cbkeydata, 3)
	
	cmbPrnm.currentindex = iIndex
	
	Dim sWaPrnm
	sWaPrnm = cmbPrnm.caption
	lblPrnm.caption = sWaPrnm
	
	Dim sData
	sData = g_sAcno.."|"..g_sAsno.."|"..g_sCnrcNo
	Form.triggerEvent("fmtabInfo."..fmtabInfo.currenttabpageid, "Request", sData)
End Sub

'============================================================================
Sub fmtabInfo_OnTabChanged(nCurrentTab)
	cmbAcnt.currentindex = cmbAcnt.currentindex
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "PwCheck" then
		'v0003
		Form.openPopupAnimation("pwdcheckpopup", g_sAcno & g_sAsno & "☆0" ,"","2")
		
	elseif sEventName == "Request" then
		cmbAcnt.currentindex = cmbAcnt.currentindex
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				
				Dim sPlain_rm, sPwd
				sPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
				
				if sPlain_rm == "1" then 'MTS메모리평문 적용상태일때
					sPwd = edtPwd.caption
				else 'MTS메모리평문 미적용상태일때
					sPwd = Form.GetEncData(edtPwd.caption)
				end if
				
				Form.triggerEvent("fmtabInfo."..fmtabInfo.currenttabpageid, "PwCheck", sPwd)
			end if
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

