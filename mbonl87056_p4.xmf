--===========================================================================
--===========================================================================
Dim g_MargGradCode
Dim g_sPwd

Dim gAcno
Dim gAsno

'============================================================================
Sub Form_OnFormInit()
	'오픈데이터
'	dim szOpenData
'	szOpenData = Form.GetOpenLinkData()
'	if szOpenData <> "" and szOpenData <> null then
'		g_sPwd = szOpenData
'	end if
	
	szLinkedData = Form.GetOpenLinkData( )

	'계좌번호 계좌비밀번호 
	g_szList = Split(szLinkedData,"★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
		
	gAcno          = ""
	gAsno          = ""
	gAcntPwd		 = ""
	
	gAcno          = g_szList(0)
	gAsno          = g_szList(1)	
	g_sPwd         = g_szList(2)

	cmbAccount.caption = gAcno&gAsno

	'화면 타이틀
	Form.SetScreenName("위탁증거금 등급 변경")
	'iOS 에디트 이미지 이슈 처리
	Dim szOSType
	szOsType = Form.GetSharedData( "&OS_TYPE", False )'1.안드로이드 2.iOS
	If szOsType == "2" Then
		editNow.SetOnOffImage("input_01_o.9.png","input_01_n.9.png")	'select/normal 이미지 설정
		editNow.imagefilepth = "input_01_n.9.png"
		editAfter.SetOnOffImage("input_01_o.9.png","input_01_n.9.png")	'select/normal 이미지 설정
		editAfter.imagefilepth = "input_01_n.9.png"'최초 이미지 설정

	End If

	'등급 조회
	if cmbAccount.total <> "" and cmbAccount.total <> null then
		g_MargGradCode = ""
		DATAMANAGER.RequestTranData( "obacp_comm_008r" )
	end if
End Sub

'============================================================================
Sub btnOk_OnClick()
	if cmbAccount.total <> "" and cmbAccount.total <> null then
		'등급 변경 신청
		DATAMANAGER.RequestTranData("obaci_acct_029a")
	else
		Form.ShowAlert("알림", "계좌번호를 확인해 주세요.")
	end if
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_comm_008r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
	elseif szTranID == "obaci_acct_029a" then
		If Trim(g_MargGradCode) <> "4" Then
			DATAMANAGER.ClearInputData(0, szTranID)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE"  , 0 , "4")	'4.온라인
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , cmbAccount.total)	
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"           , 0 , cmbAccount.sequence)	
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD"       , 0 , g_sPwd)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MARG_GRAD_CODE" , 0 , "4") '4.100%징수(수수료포함)
		Else
			Form.ShowAlert( "알림" , "변경할 등급을 확인해주세요.")
			Exit Sub
		End If
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_comm_008r" then
		g_MargGradCode = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "MARG_GRAD_CODE", 0 ))
		'등급코드를 텍스트로 치환
		If g_MargGradCode = "1" Then
			editNow.caption = "40%징수"
		ElseIf g_MargGradCode = "3" Then
			editNow.caption = "100%징수(수수료미포함)"
		ElseIf g_MargGradCode = "4" Then
			editNow.caption = "100%징수(수수료포함)"
		ElseIf g_MargGradCode = "5" Then
			editNow.caption = "요주의"						
		ElseIf g_MargGradCode = "6" Then
			editNow.caption = "기본(종목별차등)"
		ElseIf g_MargGradCode = "7" Then
			editNow.caption = "특별증거금(우대)"
		ElseIf g_MargGradCode = "8" Then
			editNow.caption = "30%일괄적용"			
		End If
	elseif szTranID == "obaci_acct_029a" then
		Form.SendReturnToParent("mbonl87056_p4", "ok")  
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> "" or szSubErr <> null then
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrMsg)
	end if
End Sub

'============================================================================
Sub btnSearch_OnClick()
	'재조회 버튼
	if cmbAccount.total <> "" and cmbAccount.total <> null then
		DATAMANAGER.RequestTranData( "obacp_comm_008r" )
	end if
End Sub



