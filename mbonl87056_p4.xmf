		<IMAGE name="Image1" imgpath="img_bgbox.9.png" ly_vert="10,110,355,115,1" />
		<LABEL name="Label1" fontsize="-2" caption="증거금 100%(수수료포함) 계좌만 소수점 거래가 가능해요." halign="1" ly_vert="10,58,355,32,1" />
		<BUTTON name="btnOk" caption="증거금변경" btnimage="btn_26.9" ly_vert="188,557,191,50,1" />
