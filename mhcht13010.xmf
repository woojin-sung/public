'============================================================================
Sub Form_OnRefresh()
	ChartEx0.setRequestCompareData("0")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	for i = 0 to 4 
		if g_arrItem[i] = "" then
			Exit Sub
		else
			tmpItem = g_arrItem[i]
		end if
		
		If g_szItemMarket = "W" Then
			DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , tmpItem )
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
			
		'20180712 HAMWG START : K-OTC MTS 도입
		ElseIf g_szItemMarket = "T" Then
			DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , tmpItem )
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
		
		Else
			DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , tmpItem )
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		End If
	next
End Sub

'============================================================================
'PENTA13 START => 2023.08.28(차트성능개선)
Sub Combo1_OnEditComplete(iIndex)
	
	'20230830 LES START
	tmpData = g_minPeriod[iIndex]
	tmpMin = split(tmpData,"분")
	g_szMinType = tmpMin[0]
	RadioGroup0.SetRadioCaption( 3, g_szMinType & "분" )
			
	PeriodSet(g_szChrtType)
	'20230830 LES END

End Sub
'PENTA13 END
'=======================================================================================
'20230830 LES START - (분) 사용자 설정 주기에 따라 콤보박스 세팅
'=======================================================================================
Function SetPeriod_Combo(sType)
	
	'=============================
	' 분차트
	'=============================
	if sType == "min" then
		
		'---------------------------------------------
		' 지역변수 초기화
		'---------------------------------------------
		Dim szMinPeriodList, nCurComboIndex
		szMinPeriodList = ""
		nCurComboIndex = 0
		
		tmpMin = split(RadioGroup0.GetRadioCaption(3),"분")
		g_szMinType = tmpMin[0]
	
		'---------------------------------------------
		' 사용자 설정 분 주기 GET
		'---------------------------------------------
		for i = 0 to 7
		
			sMin	= Form.GetEnvData( "chart_min"..i )	'분차트
			
			if sMin ~= "" then
				g_minPeriod[i] = sMin
				
				if szMinPeriodList == "" then
					szMinPeriodList = i & "`" & sMin & "분"
				else
					szMinPeriodList = szMinPeriodList & "\r\n" & i & "`" & sMin & "분"
				end if
				
			end if
			
			'현재 선택한 주기로 콤보박스 currentIndex 이동
			if g_szMinType == g_minPeriod[i] then
				nCurComboIndex = i
			end if	
			
		next
		
		'------------------------------------------------
		' 사용자 설정 분 주기가 없는 경우 디폴트 주기 GET
		'------------------------------------------------
		if szMinPeriodList == "" then
		
			for i = 0 to 7
			
				sMin = g_minPeriod[i]
				
				if szMinPeriodList == "" then
					szMinPeriodList = i & "`" & sMin & "분"
				else
					szMinPeriodList = szMinPeriodList & "\r\n" & i & "`" & sMin & "분"
				end if
			
			next
		
		end if
		
		
		'---------------------------------------------
		' 사용자 설정 분 주기 SET
		'---------------------------------------------
		Combo1.cbinputdatatext = szMinPeriodList
		Combo1.currentindex = nCurComboIndex
		Combo1.OpenList()	
		
	end if

End Function
'=======================================================================================
'20230830 LES END
