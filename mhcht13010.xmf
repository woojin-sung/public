'============================================================================
Sub ChartEx0_OnRequestData(nIndex, sData)
	Data = split(sData, ";")
	
	g_szItemCode      = tostring(Trim(Data[0]))
	g_szItemMarket    = tostring(Trim(Data[3]))

	nIndex = tonumber(nIndex)

	RequestData()

end Sub  

'============================================================================
Sub Form_OnFormClose()
'	ChartEx0.SetSaveChart("compare")
	Form.SetSharedData( "&ITEM_STOCK" , g_arrItem[0])
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_ORIENTATION" Then
		sData = RadioGroup0.currentindex.."^"..RadioGroup0.GetRadioCaption( RadioGroup0.currentindex)
		Form.OpenPopup( "mhcht13010_h1" , sData , "" )
		
	' 연결정보
	elseIf sEventName = "SCREEN_MENU" Then								
		If sParam = "REG_INTR" Then									' 관심종목등록
			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			
		ElseIf sParam = "REG_WATCHING" Then							' Watching종목등록
			Form.OpenFramePopup("mhprc11020_p1" , g_szItemCode , "")
	
		ElseIf sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
		
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)

	end if
End Sub

