Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  '일
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then  '주
		g_flagMin = false
		g_szChrtType = "W"
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 2 then  '월
		g_flagMin = false
		g_szChrtType = "M"
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 3 then   '분
		g_szChrtType = "A"
		tmpMin = Split(RadioGroup0.GetRadioCaption( nIndex ), "분")
		g_szMinType = tmpMin[0]
		
		if g_flagMin = false then
			g_flagMin = true
			PeriodSet(g_szChrtType)
		else
'PENTA13 START => 2023.08.28(차트성능개선)
			'20230830 LES START
			SetPeriod_Combo("min")	
			'20230830 LES END
					
'			sTemp = RadioGroup0.GetRadioCaption(3)
'			if sTemp = "1분" then
'				Combo1.currentindex = 0
'			elseif sTemp = "3분" then
'				Combo1.currentindex = 1
'			elseif sTemp = "5분" then
'				Combo1.currentindex = 2
'			elseif sTemp = "10분" then
'				Combo1.currentindex = 3
'			elseif sTemp = "15분" then
'				Combo1.currentindex = 4
'			elseif sTemp = "30분" then
'				Combo1.currentindex = 5
'			elseif sTemp = "60분" then
'				Combo1.currentindex = 6
'			elseif sTemp = "120분" then
'				Combo1.currentindex = 7
'			end if
'			
'			Combo1.OpenList()
'PENTA13 ORGSRC
			'Form.OpenPopup( "mhcht13000_p1.xmf" , g_szMinType , "" )
'PENTA13 END
		end if
			
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'PENTA13 START => 2023.08.28(차트성능개선)
'	if sKeyName == "Chart_Min" then
'		sMin = Split(sRet,"분")
'		RadioGroup0.SetRadioCaption( 3, sRet)
'		g_szMinType = sMin[0]
'		PeriodSet(g_szChrtType)
'PENTA13 END
		
	if sKeyName == "CompOption" then
		g_intItemCnt = Form.GetEnvData( "comp_itemCnt" )
		tmpItem =  Form.GetEnvData( "comp_itemList" )
		tmpCheck = Form.GetEnvData( "comp_itmeCheck" )
		
		if g_intItemCnt = "" then
			Exit Sub		
		end if
		
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")

		ChartEx0.SetDataClear("1")
		
		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" then
				g_szItemCode = g_arrItem[i]
				g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market") 
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				
				ChartEx0.SetCurCodeName(g_szItemMarket..";"..g_szItemCode..";"..outStrName)
				ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..g_szItemMarket)
			end if

		next
		
		ChartEx0.setRequestCompareData("1")

'	elseif sKeyName = "snsshare" Then   ' SNS공유
'		  g_nSNSType = Cint(sRet)
'		  
'		  If g_nSNSType = 2 Then          ' 이미지공유
'			  Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
'		  Else              ' 현재가공유
'			  Form.triggerEvent("linkfmHoga", "sharedata", "")   
'		  End If

	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
		
	elseif sKeyName = "OrientaitonClose" then
		g_intItemCnt = Form.GetEnvData( "comp_itemCnt" )
		tmpItem =  Form.GetEnvData( "comp_itemList" )
		tmpCheck = Form.GetEnvData("comp_itmeCheck")
		
		if g_intItemCnt = "" then
			Exit Sub		
		end if
		
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")
		arrPeriod = split(sRet , "^")

		ChartEx0.SetDataClear("1")
		
		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" or arrCheck[i] = "" then
				g_szItemCode = g_arrItem[i]
				g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market") 
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				
				ChartEx0.SetCurCodeName(g_szItemMarket..";"..g_szItemCode..";"..outStrName)
				ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..g_szItemMarket)
			end if

		next
		
		if arrPeriod[0] = "3" then
			RadioGroup0.SetRadioCaption( arrPeriod[0], arrPeriod[1] )
		end if
		
		RadioGroup0.currentindex = CInt(arrPeriod[0])
		ChartEx0.setRequestCompareData("1")
		
	end if
End Sub
	
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
   if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   'Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
		Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )

	   next
   end if
end function

'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)
   if #Count == 1 then
	   Count = "000"..Count
   elseif #Count == 2 then
	   Count = "00"..Count
   elseif #Count == 3 then
	   Count = "0"..Count
   end if

	g_sChartCnt = Count
	
	RequestData()
end function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
'	Form.ShowAlert("", sIndex..":"..sPeriod)
	
	if sPeriodType= "A" then
	   g_sPeriod = CInt(g_szMinType)
	   g_sPeriodType = "1"
	   
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	   
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	   
	end if
	
	sPeriod = CInt( g_sPeriod)
	if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	' 조회TR 보내기
	ChartEx0.setRequestCompareData("0")
end function

