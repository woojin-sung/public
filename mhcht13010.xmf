Sub Form_OnFormInitBefore()
	ChartEx0.SetChartType("compare")
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_intItemCnt = Form.GetEnvData( "comp_itemCnt" )
	tmpItem =  Form.GetEnvData( "comp_itemList" )
	tmpCheck = Form.GetEnvData( "comp_itmeCheck" )
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 3, szMin0.."분" )
	' 20190404 HWG END
	
	if g_intItemCnt = "" then
		' 현재가 화면에서 조회한 최근 종목 불러 오기
		g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
		
		if g_szItemCode = "" or g_szItemCode = null then
			g_szItemCode = "138040"	' 메리츠금융지주		'PENTA13 START => 2023.08.09(차트성능개선)	
			'g_szItemCode = "008560"  ' 메리츠종금증권
	
		end if
		
		Form.SetEnvData( 1, "comp_itemCnt", "1" )
		Form.SetEnvData( 1, "comp_itemList", g_szItemCode.."^" )
		Form.SetEnvData( 1, "comp_itmeCheck", "".."^")
		
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market") 
		outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
		
		ChartEx0.SetCurCodeName(g_szItemMarket..";"..g_szItemCode..";"..outStrName)
		ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..g_szItemMarket)
			
	else
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")
	'	ChartEx0.SetDataClear("1")
	
		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" or arrCheck[i] = "" then
				g_szItemCode = g_arrItem[i]
				g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market") 
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				
				ChartEx0.SetCurCodeName(g_szItemMarket..";"..g_szItemCode..";"..outStrName)
				ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..g_szItemMarket)
				
			end if
	
		next
		
	end if

	ChartEx0.setRequestCompareData("1")
	
	Form.SetRealBundle("1")			'PENTA13 START => 2023.09.12(플랫폼개선)
End Sub

