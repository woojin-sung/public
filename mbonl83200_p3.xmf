'============================================================================

Dim g_Chk0 
Dim g_Chk1		'체크버튼0 체크상태
Dim g_Chk2		'체크버튼1 체크상태
dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러
dim g_FileName '문서명
Dim g_tData
Dim g_szAcnt
Dim g_tPwdData
'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
	
	imgAllAgree.setMaintainingRatio("1")
	imgUIChk1.setMaintainingRatio("1")
	imgUIChk2.setMaintainingRatio("1")
	imgChk1.setMaintainingRatio("1")
	imgChk2.setMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_szUnCheckImg = "check_line_n"
	g_szCheckImg = "check_line_o"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"
	
	dim szLinkData
	szLinkData = Form.GetOpenLinkData( )
	if szLinkData <> "" and szLinkData <> null then
		g_tData = Split(szLinkData , "★")
		
		g_FileName = "IBKTOB" & g_tData(1) & "01" & Cint(g_tData(2)) & ".pdf"
		
		g_szAcnt = g_tData(4)
	end if
	btnOkWide.visible = true
		
End Sub

'============================================================================
Sub btnOkWide_OnClick()
	Form.CloseForm( )
	Form.SendReturnToParent( "mbonl83200_p3_ok" , "" )
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl83010_p5" then
	    if trim(sRet) ~= "" and trim(sRet) ~= nil and sRet ~= "close" then
			f_AllAgreeCheck()
		elseif trim(sRet) ~= "" and trim(sRet) ~= nil and sRet = "close" then
			g_Chk1 = 0 '초기화
			g_Chk2 = 0 '초기화
			g_Chk3 = 0 '초기화
	    end if	
	end if
End Sub

'============================================================================
Function f_AllAgreeCheck()	
	if g_Chk0 = 1	then
		chk0.checkstate = 1
		Form.SetCtlProp("imgUIChk0", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblChkText0", "fgcolor", g_szCheckFg)
		Form.SetCtlProp("Label0", "fgcolor", g_szCheckFg)
	else 
		chk0.checkstate = 0
		Form.SetCtlProp("imgUIChk0", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblChkText0", "fgcolor", g_szUnCheckFg)
		Form.SetCtlProp("Label0", "fgcolor", g_szUnCheckFg)
	end if 
	if g_Chk1 = 1	then
		chk1.checkstate = 1
		Form.SetCtlProp("imgUIChk1", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblChkText1", "fgcolor", g_szCheckFg)
		Form.SetCtlProp("Image0", "imgpath", "icon_arrow6_r")
	else 
		chk1.checkstate = 0
		Form.SetCtlProp("imgUIChk1", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblChkText1", "fgcolor", g_szUnCheckFg)
		Form.SetCtlProp("Image0", "imgpath", "icon_menu_scroll_arrow_right.9.png")
	end if 
	if g_Chk2 = 1	then
		chk2.checkstate = 1
		Form.SetCtlProp("imgUIChk2", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblChkText2", "fgcolor", g_szCheckFg)
		Form.SetCtlProp("Label1", "fgcolor", g_szCheckFg)
		
		for i = 0 to 16
			Table0.SetCellFgColor( i, 0, g_szCheckFg )
			Table0.SetCellFgColor( i, 1, g_szCheckFg )
		next
	else
		chk2.checkstate = 0
		Form.SetCtlProp("imgUIChk2", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblChkText2", "fgcolor", g_szUnCheckFg)
		Form.SetCtlProp("Label1", "fgcolor", g_szUnCheckFg)
		
		for i = 0 to 16
			Table0.SetCellFgColor( i, 0, g_szUnCheckFg )
			Table0.SetCellFgColor( i, 1, g_szUnCheckFg )
		next
	end if 
	
	check_staus()
End Function


'============================================================================
Sub check_staus()
	'Form.MsgBox("알림", chk2.checkstate & chk1.checkstate, 0 , 6)
	if chk2.checkstate = "1" and chk1.checkstate = "1" and chk0.checkstate = "1" then

		chkAllAgree.checkstate = 1
		btnOkWide.enable = true
		Form.SetCtlProp("imgAllAgree", "imgpath", "checkmenu_o")
		Form.SetCtlProp("lblAllAgree", "fgcolor", g_szCheckFg)
	else 

		chkAllAgree.checkstate = 0
		btnOkWide.enable = false
		Form.SetCtlProp("imgAllAgree", "imgpath", "checkmenu_n")
		Form.SetCtlProp("lblAllAgree", "fgcolor", g_szUnCheckFg)
	end if 
	
	'g_Chk1 = 0 '초기화
	'g_Chk2 = 0 '초기화
End Sub

'============================================================================
Sub chk1_OnChange(sCheckState)
	dim szAllData
	if chk1.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		
		if Len(Trim(g_FileName)) > 0 Then

			nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
			if nType == "0" then
				g_tAgreeUrl = {{"https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"& g_FileName, "공개매수설명서", "urlpath", "N", ""}}
			elseif nType == "1" then
				g_tAgreeUrl = {{"https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"& g_FileName, "공개매수설명서", "urlpath", "N", ""}}
			end if
			
			
			i = 0
			'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
			szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
			
			if #szData > 0 then
				Form.OpenPopup( "mbonl83200_p7" ,  szData , "" )
			end if			
		else
			'파일없음
			Form.MsgBox("알림", "해당 종목은 투자설명서가 없습니다!.", 0 , 6)
			Exit Sub'v0002
		end if
		g_Chk1 = 1
	else
		g_Chk1 = 0
		f_AllAgreeCheck()
	end if 
	
End Sub
'============================================================================
Sub chk2_OnChange(sCheckState)
	if chk2.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		g_Chk2 = 1
	else
		g_Chk2 = 0
	end if 
	f_AllAgreeCheck()
End Sub

'============================================================================
Sub chk0_OnChange(sCheckState)
	if chk0.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		g_Chk0 = 1
	else
		g_Chk0 = 0
	end if 
	f_AllAgreeCheck()
End Sub
'============================================================================
Sub imgUIChk1_OnClick()
	chk1_OnChange("0")
End Sub

'============================================================================
Sub imgUIChk0_OnClick()
	chk0_OnChange("0")
End Sub

'============================================================================
Sub lblChkText0_OnClick()
	chk0_OnChange("0")
End Sub
'============================================================================
Sub lblChkText1_OnClick()
	chk1_OnChange("0")
End Sub
'============================================================================
Sub imgUIChk2_OnClick()
	chk2_OnChange("0")
End Sub

'============================================================================
Sub lblChkText2_OnClick()
	chk2_OnChange("0")
End Sub

'============================================================================
Sub lblAllAgree_OnClick()
	imgAllAgree_OnClick()
End Sub

'============================================================================
Sub imgAllAgree_OnClick()
	Dim szAllData
	if chkAllAgree.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		if Len(Trim(g_FileName)) > 0 Then

			nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
			if nType == "0" then
				g_tAgreeUrl = {{"https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"& g_FileName, "공개매수설명서", "urlpath", "N", ""}}
			elseif nType == "1" then
				g_tAgreeUrl = {{"https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"& g_FileName, "공개매수설명서", "urlpath", "N", ""}}
			end if
			
			i = 0
			'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
			szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"

		end if 
		
		if #szData > 0 then
			Form.OpenPopup( "mbonl83200_p7" ,  szData , "" )
		end if
	
		g_Chk1 = 1	
		g_Chk2 = 1	
		g_Chk0 = 1
	else
		g_Chk1 = 0
		g_Chk2 = 0	
		g_Chk0 = 0
		f_AllAgreeCheck()
	end if
End Sub

'============================================================================
Sub btnBGUP_OnClick()
	Form.CloseForm( )
End Sub

