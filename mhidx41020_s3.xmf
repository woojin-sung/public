Dim g_szItemCode
g_szItemCode	=""


'============================================================================
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	lbl01.setUseAutoScroll(True, 50, True)
	DATAMANAGER.RequestTranData("ohhts_news_001r")
	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"ohhts_news_001r"	then
		DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"			, 0 , "")
		DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_TITL",  0, "" )
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	If szTranID = "ohhts_news_001r" Then
		Dim nCnt, szTime
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_news_001r", "OutBlock1" )
		
		For i = 0 To nCnt - 1
			szTime = DATAMANAGER.GetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i )	
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i , Left(szTime, 4) )
		Next
		
	End If
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'20220124 SWJ START
'	for i = 0 to 17 
'		DATAMANAGER.CancelRealData("ohhts_news_real")
'	next
	'20220124 SWJ END
	
	if szTranID = "ohhts_news_001r" then
		
		For i = grd01.rowcount -1 To 0 Step -1
			Dim szNewsCorpCode
			szNewsCorpCode = grd01.GetCellData("bd_cell2", i)
			
			if szNewsCorpCode = "EY" Then
				grd01.SetDeleteRow( i )
			End If
		Next
		
		szNews1 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , 0)
		szNews2 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , 1)
		szNews3 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , 2)
		szNews4 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , 3)
		szNews5 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , 4)
		
		szNews = szNews1.."   |   "..szNews2.."   |   "..szNews3.."   |   "..szNews4.."   |   "..szNews5
		lbl01.setAutoScrollText(szNews)
		
'		for i = 0 to 17
'			Set_Real_Corp(i)
'		next

	end if 
End Sub

'============================================================================

'============================================================================
'20220124 SWJ START : 뉴스 제공업체 함수
'============================================================================
Function Set_Real_Corp(nidx)
	Select Case nidx
	
	Case 0
		'시황속보
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "n0")
	Case 1
		'공시정보
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "F0")
	Case 2
		'머니투데이
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "MT")
	Case 3
		'이투데이
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "SD")
	Case 4
		'인포스탁
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "IS")
	Case 5
		'매경뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "MK")
	Case 6
		'파이낸셜뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "FN")
	Case 7
		'연합뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YN")
	Case 8
		'뉴스핌
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "NP")
	Case 9
		'아시아경제
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "AE")
	Case 10
		'헤럴드경제
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "HE")
	Case 11
		'CEO스코어데일리
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "CD")
	Case 12
		'서울경제
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "SE")
	Case 13
		'컨슈머타임스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "CT")
	Case 14
		'팍스넷뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "PAX")
	Case 15
		'중국/홍콩
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YICHN")
	Case 16
		'미국
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YIUSA")
	Case 17
		'연합인포맥스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YIIFX")

		
	End Select
	
'	DATAMANAGER.RequestRealData("ohhts_news_real")

End Function

'============================================================================
'DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szTitle, szDate, szTime, szNewKey, szNewCorpName, szNewsCorpCode
	Dim	szDiv
	
	szDiv = DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_ITN_EXCP_CLCD" , 0 )
    szNewsCorpCode = DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_OFER_ENTP_CODE" , 0)	

    If  szDiv = "N" Then
	    Exit Sub
    End If
    
    '이데일리뉴스는 제외
    if 	szNewsCorpCode == "EY" then
	    Exit Sub
    End If
    
	    
	If g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD" , 0 )
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD2" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD3" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD4" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD5" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD6" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD7" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD8" , 0 ) Then
			Exit Sub
	End If

    
    szTitle		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_TITL", 0 )
    szDate		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_DATE", 0 )
    szTime		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_BSOP_HOUR", 0 )
    szNewKey		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_KEY", 0 )

    
    If 		szNewsCorpCode == "n0" then szNewCorpName = "시황속보"
    elseif 	szNewsCorpCode == "HK" then szNewCorpName = "한경뉴스"
    elseif 	szNewsCorpCode == "EY" then szNewCorpName = "이데일리뉴스"
    elseif 	szNewsCorpCode == "F0" then szNewCorpName = "공시정보"
    elseif 	szNewsCorpCode == "MT" then szNewCorpName = "머니투데이"
    elseif 	szNewsCorpCode == "SD" then szNewCorpName = "이투데이"
    elseif 	szNewsCorpCode == "IS" then szNewCorpName = "인포스탁"
    elseif 	szNewsCorpCode == "MK" then szNewCorpName = "매경뉴스"
    elseif 	szNewsCorpCode == "FN" then szNewCorpName = "파이낸셜뉴스"
    elseif 	szNewsCorpCode == "YN" then szNewCorpName = "연합뉴스"
    elseif 	szNewsCorpCode == "NP" then szNewCorpName = "뉴스핌"
    elseif 	szNewsCorpCode == "AE" then szNewCorpName = "아시아경제"
    elseif 	szNewsCorpCode == "HE" then szNewCorpName = "헤럴드경제"
    elseif 	szNewsCorpCode == "CD" then szNewCorpName = "CEO스코어데일리"
    '20161226 LES START - 서울경제, 컨슈머타임스 추가
    elseif 	szNewsCorpCode == "SE" then szNewCorpName = "서울경제"
    elseif 	szNewsCorpCode == "CT" then szNewCorpName = "컨슈머타임스"
    '20200909 SWJ START - 팍스넷뉴스 추가
    elseif 	szNewsCorpCode == "PAX" then szNewCorpName = "딜사이트"		'20221227 SWJ START : 팍스넷뉴스 사명변경
    '20171226 HAMWG START - 중국/홍콩, 미국 추가
    elseif 	szNewsCorpCode == "YICHN" then szNewCorpName = "중국/홍콩"
    elseif 	szNewsCorpCode == "YIUSA" then szNewCorpName = "미국"
    elseif 	szNewsCorpCode == "YIIFX" then szNewCorpName = "연합인포맥스"
    
    end if
    
    grd01.insertrow = 0
    
    grd01.SetCellData( "bd_cell7", 0, szTitle 		)	'제목
    grd01.SetCellData( "bd_cell3", 0, szDate 		)	'일자
    grd01.SetCellData( "bd_cell5", 0, Left(szTime,4) )	'시간
    grd01.SetCellData( "bd_cell11", 0, szNewCorpName 	)	'뉴스제공업체명
    grd01.SetCellData( "bd_cell1", 0, szNewKey 		)	'뉴스키
    grd01.SetCellData( "bd_cell2", 0, szNewsCorpCode )	'뉴스제공업체코드

    lbl01.setAutoScrollText(szTitle)

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'20220124 SWJ START
	for i = 0 to 17 
		DATAMANAGER.CancelRealData("ohhts_news_real")
	next
	'20220124 SWJ END

	if szTranID = "ohhts_news_001r" then
	
		if	szErrCode	=	"9900"	then		'데이터없을시
			grd01.SetClear()
		else
			szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
			Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
		end	if
	end	if
End Sub


'============================================================================
Sub lbl01_OnClick()
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szMsg, szCode, szName
	lRow = 0
	szTitle			= grd01.GetCellData( "bd_cell7", lRow )	' 제목			-- FID_TITL
	szDate			= grd01.GetCellData( "bd_cell3", lRow )	' 날짜   		-- FID_DATE
	szTime			= grd01.GetCellData( "bd_cell5", lRow )	' 시간    		-- FID_CNTG_HOUR
	szNewCorpName		= grd01.GetCellData( "bd_cell11", lRow )	' 뉴스제공업체명 	-- FID_KOR_ISNM
	szNewKey			= grd01.GetCellData( "bd_cell1", lRow )	' 뉴스키       	-- FID_NEWS_KEY
	szNewsCorpCode	= grd01.GetCellData( "bd_cell2", lRow )	' 뉴스제공업체코드-- FID_NEWS_OFER_ENTP_CODE
	szCode			= grd01.GetCellData( "bd_cell4", lRow )	' 종목코드
	szName			= Form.GetItemCodeInfo(szCode, "name")
	
	szMsg = szTitle & "|" & szDate & "|" & szTime & "|" & szNewCorpName & "|" & szNewKey & "|" & szNewsCorpCode & "|" &  szName
'	Form.OpenPopup( "mhprc11000_p6" , szMsg, "" )
	Form.triggerEvent("#", "HOME_SCROLL", "")
	Form.OpenScreen("44000" , "")
End Sub


'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_news_001r")
End Sub

