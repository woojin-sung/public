	<SCRIPT_INFO _len="8288" _ulen="7662" >
'--===========================================================================
' 01. 화 면 명 : 대용설정_대용등록
' 02. 화면설명 : 대용설정_대용등록
' 03. 작    성 : 2021.11.25 김수진 
' 04. 수    정 : 
'   2022.12.19 : 양현정 : v0001 prcd별 컨트롤 속성 변경 추가
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szState			'등록이지 해지인지
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	tblState.SetCellString( 0 , 1, "")
	cmbAcct2.caption = ""
	cmbAcct2.enable = false
	
	'v0001
	cmbAcctWrap.caption = ""		'Wrap계좌설정용
	cmbAcctWrap.enable = false
	cmbAcctCanc.caption = ""		'해지용
	cmbAcctCanc.enable = false	
End Function
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )

	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	f_ClearData()
	if sEventName == "changeTab" then
		'장내파생 연계 계좌 조회
		DATAMANAGER.RequestTranData( "obacp_opop_033r" )
	end if	
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	'장내파생 연계 계좌 조회
	DATAMANAGER.RequestTranData( "obacp_opop_033r" )
End Sub

'============================================================================
' btnOK_OnClick : 대용질권 지정/해지
'============================================================================
Sub btnOK_OnClick()
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	'장내파생 대용 계좌정보 관리
	DATAMANAGER.RequestTranData( "obaci_acct_033a" )	
End Sub
''****************************************************************************
''               		D  A  T  A  M  A  N  A  G  E  R               
''****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'장내파생 연계 계좌 조회
	If szTranID == "obacp_opop_033r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , cmbAcct.total	)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , cmbAcct.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "" )
	'장내파생 대용 계좌정보 관리
	ElseIf szTranID == "obaci_acct_033a" Then
		Dim szACNT_PWD 
		if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
		    szACNT_PWD = edtPswd.caption
		else  								'MTS메모리평문 미적용상태일때
		    szACNT_PWD = Form.GetEncData(edtPswd.caption)
		end if
	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"	 		)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , g_szState	 		)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total		)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence 	)		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" 	, 0 , szACNT_PWD 			)
		
		'v0001
		if g_szState == "2" then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_ACNO" 	, 0 , cmbAcctCanc.total	)
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_ASNO" 	, 0 , cmbAcctCanc.sequence 	)		
		elseif cmbAcct.itemcodetype == "120" then	
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_ACNO" 	, 0 , cmbAcctWrap.total	)
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_ASNO" 	, 0 , cmbAcctWrap.sequence 	)				
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_ACNO" 	, 0 , cmbAcct2.total		)
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_ASNO" 	, 0 , cmbAcct2.sequence 	)		
		end if

	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'장내파생 연계 계좌 조회
	If szTranID == "obacp_opop_033r" Then	
		Dim szMsgCode
		szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
		Dim szACNO, szASNO
		szACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LNKD_ACNO" , 0 )
		szASNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LNKD_ASNO" , 0 )
		
		'v0001
		cmbAcctCanc.visible = false
		cmbAcct2.visible = false
		cmbAcctWrap.visible = false		

		If szMsgCode == "5766" Then
			g_szState = "2"
			tblState.SetCellString( 0 , 1, "등록")
			
			'v0001
			'cmbAcct2.caption = szACNO..szASNO
			'cmbAcct2.enable = false
			cmbAcctCanc.caption = szACNO..szASNO
			cmbAcctCanc.enable = false
			cmbAcctCanc.visible = true

			btnOK.caption = "대용계좌 해지"
		ElseIf szMsgCode == "5820" Then
			g_szState = "1"
			tblState.SetCellString( 0 , 1, "미등록")
			
			'v0001
			if cmbAcct.itemcodetype == "120" then
				cmbAcctWrap.enable = true
				cmbAcctWrap.visible = true
			else
				cmbAcct2.enable = true
				cmbAcct2.visible = true
			end if
			btnOK.caption = "대용계좌 등록"
		Else
			f_ClearData()
			btnOK.enable = false
		End If
		
	'장내파생 대용 계좌정보 관리
	ElseIf szTranID == "obaci_acct_033a" Then
		f_ClearData()
		
		If g_szState == "1" Then
			Form.ShowAlert("알림", "대용계좌 등록 완료되었습니다.")
		Else
			Form.ShowAlert("알림", "대용계좌 해지 완료되었습니다.")
		End If
		
		'장내파생 연계 계좌 조회
		DATAMANAGER.RequestTranData( "obacp_opop_033r" )
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obaci_acct_033a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub






	</SCRIPT_INFO>
