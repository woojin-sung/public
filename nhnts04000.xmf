'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "REFRESH_MAIN"	then	
		
		'1. 세팅된값으로 위치 재계산
		call reassignItems(sRet)
		
		'2. 세팅된값 재표시
		call DisplaySettings()
		

		Form.triggerEvent("linkfm1Tile", szEventName, szParam)		'지수정보
		Form.triggerEvent("linkfm1Tile6row", szEventName, szParam)
		
		Form.triggerEvent("linkfm4Chng", szEventName, szParam)		'환율
		Form.triggerEvent("linkfm5Prod", szEventName, szParam)		'상품
		Form.triggerEvent("linkfm6Rate", szEventName, szParam)		'금리
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
	end if 
End Sub


'============================================================================
'btnEdit01_OnClick
'============================================================================
Sub cont01_btnEdit01_OnClick()
	Form.OpenFramePopup("mhidx41000_p1" , sOpenData , sPosInfo)
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if	sEventName	=	"SCREEN_MENU"		then
			
		if	trim(sParam)	==	"MARKET_SET"	then
			Form.OpenFramePopup("mhidx41000_p1" , sOpenData , sPosInfo)
		end	if
		if	trim(sParam)	==	"MARKET_ADD"	then
			Form.OpenFramePopup("mhidx41000_p2" , sOpenData , sPosInfo)
		end	if
		
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	end	if
End Sub


'============================================================================
'Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if	sKey	=	"&LOGIN"	then				'로그인전에는 실시간 못던지는 문제때문에 추가
		if	sValue	=	"login"	then
			Form_OnFormInit()
		end	if
	end	if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	
	'------------------------------------------------------------------
	' 20190814 HWG START : MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "+Iis3Vv/Cn5iCAAOFdirxCzaFWE=\n" '20200331 HWG START : 고유MTS
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if
			'20180912_01 KBC END
			
			exit sub
		end if
	end if
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단
