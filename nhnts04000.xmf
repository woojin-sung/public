'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

dim g_szInputFile		'읽어들일리스트세팅파일
dim g_szFileName		'지수, 환율, 금리, 상품 세부화일
dim g_szKeys			'읽어들일키값
dim g_szValues			'읽어들인세팅값
dim g_szLinkNames		'링크이름들
dim g_nTotalSize
dim g_szOrgList			'전체리스트순서및값

'파일에 저장된 KEY값
'g_szKeys		=	Array(	"41000P2_TILE6ROW", "41000P2_INVR", "41000P2_PROG", "41000P2_CHNG", 
'						"41000P2_PROD"  , "41000P2_RATE", "41000P2_TILE")
g_szKeys		=	Array(	"04000P2_TILE6ROW", "04000P2_GLOB"	)	'20200331 HWG : 고유MTS

'실제 링크폼명
'g_szLinkNames 	=	Array(	"cont01.linkfm1Tile6row"	,	"cont01.linkfm2Invr"		,	"cont01.linkfm3Prog"		,  "cont01.linkfm4Chng",	
'						"cont01.linkfm5Prod"		,	"cont01.linkfm6Rate" 	,	"cont01.linkfm1Tile"	)
g_szLinkNames 	=	Array(	"cont01.linkfm1Tile6row"	,	"cont01.linkfm7Glob"	)	'20200331 HWG : 고유MTS

g_szInputFile	= "04000P2ITEMS.ini"	'20200331 HWG : 고유MTS
g_szFileName 	= "04000ITEMS.ini"	'20200331 HWG : 고유MTS
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'reassignItems:	 변경된 값으로 재 할당
'============================================================================
Function	reassignItems(inList)

	dim szRefreshKeys()
	dim nListCnt
	
	dim nInitTopSize	'맨위 사이즈
	dim nTopval		'Top 값
	dim nPreHeight	'전아이템의 높이값
	dim nInterSize 	'중간 사이즈
	dim nItemIdx		'삽입될아이템순서

	'nInitTopSize 	= 10
	nInitTopSize	= 0	'20200331 HWG : 고유MTS
	nTopval 	   	= 0
	'nInterSize   	= 5 
	nInterSize   	= 0
	szItemIdx  	= 0 
	nPreHeight		= 0
	
	nListCnt	= getListItem(inList,0)		'리턴값으로 처리

	For i = 0 to nListCnt -1 
		szRefreshKeys(i)	=	getListItem(inList,(i*2)+1)
	next
	
	'1. TOP 값 초기화 
	For i = 0 to UBound(g_szKeys)
		cont01.Table0.SetCellString(i+1, 1, -1)
	Next 
	
	'2. '재정렬된 값중에서 해당하는 값만 세팅							
	For i = 0 to nListCnt -1 
		For	j = 0 to UBound(g_szKeys)					
			if	szRefreshKeys(i)	=	g_szKeys (j)	then
			
				if szItemIdx = 0	then								'첫 아이템 Init
					nTopval = nInitTopSize
					nPreHeight = cont01.Table0.GetCellString(j+1, 2)
				elseif szItemIdx = 1	then
					nTopval = nTopval + nPreHeight '+ 4	'20200331 HWG : 고유MTS					
				else 
					nTopval = nTopval + nPreHeight + nInterSize			'Top 값 계산
				end if 
						
				cont01.Table0.SetCellString(j+1, 1, nTopval)
				szItemIdx = szItemIdx + 1 								'아이템 카운트 증가
						
				nPreHeight = cont01.Table0.GetCellString(j+1, 2)
						
			end if 
		next
	next

end function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function LoadSettings()
	dim szVal
	dim nInitTopSize	'맨위 사이즈
	dim nInterSize 		'중간 사이즈
	dim nItemIdx		'삽입될아이템순서
	dim nTopval		'Top 값
	dim nPreHeight		'전아이템의 높이값
	dim nOnOff			'사용여부
	dim szSect			'구분값
	
	'nInitTopSize 	= 10
	nInitTopSize	=	0	'20200331 HWG : 고유MTS
	'nInterSize   	= 5
	nInterSize   	= 0
	szItemIdx  	= 0 
	nTopval 	   	= 0
	nPreHeight	= 0
	g_szValues = Array()
	
	
	'1. TOP 값 초기화 
	For i = 0 to UBound(g_szKeys)
		cont01.Table0.SetCellString(i+1, 1, -1)
	Next 
	
	
	'2. 세팅파일값을 테이블에 LOAD
	For i = 0 to UBound(g_szKeys)
		
		szVal = Form.LoadConfigData(g_szInputFile, g_szKeys(i))			'파일에서 value 읽어들임				
		cont01.Table0.SetCellString(i+1, 3, szVal)

		if szVal = "1"  then	   					'on 일때 top 높이계산 함
			
				if szItemIdx = 0	then								'첫 아이템 Init
					nTopval = nInitTopSize
					nPreHeight = cont01.Table0.GetCellString(i+1, 2)
				elseif szItemIdx = 1	then
					nTopval = nTopval + nPreHeight '+ 4	'20200331 HWG : 고유MTS
				else 
					nTopval = nTopval + nPreHeight + nInterSize			'Top 값 계산
				end if 
					
				cont01.Table0.SetCellString(i+1, 1, nTopval)
				szItemIdx = szItemIdx + 1 								'아이템 카운트 증가
					
				nPreHeight = cont01.Table0.GetCellString(i+1, 2)
			
		end if 
	 Next
	 
	 g_nTotalSize = nPreHeight + nTopval + 9
	 
	 
	
'TEST 출력용 
'	For j = 0 to UBound(g_szKeys)
'		Form.ShowAlert("output22",g_szKeys(j) & "=" & g_szValues(j)  & ",," & j )
'	Next

End Function


'============================================================================
'DisplaySettings() : 가져온 값으로 화면 아이템리스트 세팅 
'============================================================================
Function DisplaySettings()
	dim nTopCol			'테이블내 TOP값을 갖고 있는 Column
	dim nTemp
	
	nTopCol = 1
	for i = 0  to UBound(g_szKeys)
		nTemp = cont01.Table0.GetCellString(i+1, nTopCol)
	if nTemp >= "0" then
			Form.SetCtlProp(g_szLinkNames(i), "visible", true)
			Form.SetCtlProp(g_szLinkNames(i), "top", nTemp)
		else
			Form.SetCtlProp(g_szLinkNames(i), "visible", false)
			Form.SetCtlProp(g_szLinkNames(i), "enable", false)
			Form.SetCtlProp(g_szLinkNames(i), "top", 0)
						
			'빈공간 처리해야함 
		end if 
	next 
	
	'cont01.height = 1915 - g_nTotalSize

	cont01.SetScrollAutoSize()
	
End Function


