		<LABEL name="Label1" fontstyle="01" caption="현재 이메일주소" ly_vert="13,35,128,32,1" />
		<LABEL name="Label0" fontstyle="01" caption="변경할 이메일주소" ly_vert="13,86,139,32,1" />
		<EDIT name="edtEmailAddr1" enable="0" imetype="0" maxlength="200" recvdatafield="obtss_opnf_011a.OutBlock1.EMAIL_ADDR" ly_vert="175,30,166,39,1" import="0,1,2" />
		<EDIT name="edtEmailAddr2" imetype="3" maxlength="0" ly_vert="175,82,166,38,1" />
		<LABEL name="Label2" fgcolor="146:124124124" fontsize="-3" caption="* 오픈뱅킹 이용계좌의 금융거래정보제공사실 통보를 위한 정보로 " ly_vert="12,150,354,23,1" />
		<LABEL name="Label3" fgcolor="146:124124124" fontsize="-3" caption="  당사 고객정보는 변경되지 않으오니, 유의하시기 바랍니다." ly_vert="14,167,339,23,1" />
