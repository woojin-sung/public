'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("대체출고 처리내역 상세")
	
	dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		dim tData
		tData = Split(szOpenData, "★")
		'0:입고계좌정보
		'1:종목명
		'2:종목코드
		'3:수량
		'4:수수료
		'5:처리결과
		'6:최종결과코드
		'7:처리일시
		'8:관리지점명
		'9:종목유형코드
		dim szItemCd, szLastCd, szLast
		szItemCd = tData(2)
		szLastCd = tData(6)
		'수량 단위 SET
		if tData(9) == "03" then
			Table0.SetCellString(3, 2, "천원")
		else
			Table0.SetCellString(3, 2, "주")
		end if
		'처리상태 SET
		if szLastCd == "Y" then
			szLast = "완료"
		elseif szLastCd == "N" then
			szLast = "미완료"
		elseif szLastCd == "C" then
			szLast = "취소"
		end if
		'날짜
'		dim szDate
'		szDate = Form.GetSharedData("&HOST_DATE", false) & tData(7)
		Table0.SetCellString(0, 1, tData(0))
		Table0.SetCellString(1, 1, tData(2))
		Table0.SetCellString(2, 1, tData(1))
		Table0.SetCellString(3, 1, tData(3))
		Table0.SetCellString(4, 1, tData(4))
		Table0.SetCellString(5, 1, tData(5))
		Table0.SetCellString(6, 1, szLast )
		Table0.SetCellString(7, 1, tData(7))
		Table0.SetCellString(8, 1, tData(8))
		
		if tData(5) == "불능" then
			Table0.SetCellFgColor(5, 1, "10")
		end if
	end if
End Sub

'============================================================================


