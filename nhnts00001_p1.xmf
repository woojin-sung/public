'============================================================================
Sub Form_OnFormInit()

	szMangEmpno = "%"
	szProdDe = "%"
	Edit1.Caption = szMangEmpno
	Edit2.Caption = szProdDe
	
	Call uf_search()
End Sub
 
'============================================================================
Sub uf_search()
	DATAMANAGER.RequestTranData("obfnp_fnmt_010r")
End Sub

'============================================================================
Sub edtDeptCd_OnEditComplete()
	
	szDeptCd = edtDeptCd.Caption
	szDeptNm = Form.GetMetaData("부서코드", szDeptCd)
	if szDeptNm = "" then
	    if szDeptCd = "%" then
		    lblDeptNm.Caption = "전체"
	    else
		    lblDeptNm.Caption = "존재하지 않는 코드 값"
		end if
	else
		lblDeptNm.Caption = szDeptNm
	end if
	
	Call uf_search()
End Sub

'============================================================================
Sub edtFundNm_OnEditComplete()
	Call uf_search()
End Sub

'============================================================================
Sub edtFundCd_OnEditComplete()
	Call uf_search()
End Sub

'============================================================================
Sub cboMgriCd_OnEditComplete(iIndex)
	Call uf_search()
End Sub

'============================================================================
Sub cboMrbnCd_OnEditComplete(iIndex)
	Call uf_search()
End Sub

'============================================================================
Sub cboSmtnCd_OnEditComplete(iIndex)
	Call uf_search()
End Sub

'============================================================================
Sub cboAcngCd_OnEditComplete(iIndex)
	Call uf_search()
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	szFundCd = Grid0.GetCellData("bd_cell0", lRow)
	szFundNm = Grid0.GetCellData("bd_cell0", lRow)
	szAcngClsCode = Grid0.GetCellData("bd_cell9", lRow)
	
	Form.SendReturnToParent("FUNDINFO" , szFundCd & "★" & szFundNm & "★" &  szAcngClsCode)
	Form.CloseForm()
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.openDialog("nhnts00001_p2","","")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "DEPTINFO" then
		szDeptData = Split(sRet, "★")
		if UBound(szDeptData) > 0 then
			edtDeptCd.caption = szDeptData(0)
			edtDeptCd_OnEditComplete()
		end if
	end if
End Sub

