'============================================================================
' 01.화면명 	: 펀드정기입금이체
' 02.화면설명	: 펀드정기입금이체 상세정보 및 해지신청 팝업
' 03.작성	: 2016. 03. 11. 유창재
'============================================================================

 
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData		'082r TR Input 값
Dim g_szList		'
Dim g_szMeritz	'메리츠 여부
Dim g_szBankCode	'은행코드
Dim g_szBankName	'은행명
Dim g_szStartDate	'이체시작일
Dim g_szFinalDate	'이체종료일
Dim g_szName		'예금자명
Dim g_szAcnt		'출금계좌번호
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	if g_szList(10) == "보기" then
	     
		lblMemo.caption = "정기입금 상세정보"
		Label0.visible = True
		Label0.caption = "정기입금 정보 변경요청은 영업점 및 고객센터(1588-3400)로 연락주시기 바랍니다."
		Label1.visible = False
		Label2.visible = False
		Label3.visible = False
		Label4.visible = False
		Label5.visible = False
		
		btnSave.visible = false
		btnCancel.visible = false
		btnOk.visible = true
	else
		lblMemo.caption = "정기입금 해지신청"
		Label1.visible = True
		Label2.visible = True
		Label3.visible = True
		Label4.visible = True
		Label5.visible = True
		Label1.caption = "위 내용을 해지하시겠습니까?"
		Label2.caption = "해지 후 출금계좌를"
		Label3.caption = "타명의로 신규신청 시"
		Label4.caption = "내점만 가능"
		Label5.caption = "하오니 유의하시기 바랍니다."
		
		
		Label0.visible = False
		lblMemo.caption = "정기입금 해지신청"
		btnOk.visible = false
	end if
		
	DATAMANAGER.RequestTranData( "obpds_srvc_082r" )
	
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obpds_srvc_082r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "CSNO" , 0 , g_szList(0) )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "SVCD" , 0 , g_szList(1) )	'서비스코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "SVC_SRNO" , 0 , g_szList(2) )	'서비스일련번호
	elseif szTranID == "obpds_srvc_038a" then	
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ACNO" , 0 , g_szList(4) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ASNO" , 0 , g_szList(5) )	'일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "CSNO" , 0 , g_szList(0) )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_AMT" , 0 , tbl0.GetCellString( 3, 1) )	'이체금액
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ACNT_PWD" , 0 , g_szList(6))	'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "RMND_SRNO" , 0 , g_szList(7) )	'펀드 잔고번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "SVC_SRNO" , 0 , g_szList(2) )	'서비스 일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_STA_DATE" , 0 , g_szStartDate )	'이체 시작일자
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_FIN_DATE" , 0 , g_szFinalDate )	'이체 종료일자
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_HOPE_DAY_CODE" , 0 , tbl0.GetCellString( 6, 1) )	'이체희망일
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "DPSR_NAME" , 0 , g_szName )	'예금자명
		
		if g_szMeritz == "1" then	'메리츠일때
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_ACNT_CLS_CODE" , 0 , "1")	'이체계좌 구분코드 -> 메리츠 : 1
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ACNO" , 0 , Left(g_szAcnt, 8) )	'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ASNO" , 0 , Right(g_szAcnt, 2) )	'일련번호
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_ACNT_CLS_CODE" , 0 , "2")	'이체계좌 구분코드 -> 타은행 : 2
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "BANK_CODE" , 0 , g_szBankCode )	'타행기관코드
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_BANK_ACNO" , 0 , szAcnt )	'타행계좌번호
		end if
	end if
	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obpds_srvc_082r" then
		g_szStartDate = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_STA_DATE" , 0)
		g_szFinalDate = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_FIN_DATE" , 0)
		g_szAcnt = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_BANK_ACNO" , 0)
		
		g_szMeritz = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_ACNT_CLS_CODE" , 0)
		g_szBankCode = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "BANK_CODE" , 0)
		g_szBankName = Form.GetMetaData( "은행코드", g_szBankCode)
		
		g_szName = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "DPSR_NAME" , 0)
		
		if g_szAcnt == "" then
			g_szAcnt = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_SCRT_ACNO" ,0) & 
				DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_SCRT_ASNO" ,0)
			tbl0.SetCellMaskInfo( 2, 1, "1,0,,,1,####-####-##,0,1,1")
		end if
		
		tbl0.SetCellString( 0, 1, g_szList(9)&" > 메리츠증권" )	'구분
		tbl0.SetCellString( 1, 1, g_szList(4)&g_szList(5) )	'입금계좌번호
		tbl0.SetCellString( 2, 1, g_szAcnt  )	'출금계좌번호
		lblisnm.caption = g_szList(3)
'		tbl0.SetCellString( 4, 1, g_szList(3) )	'펀드명
		tbl0.SetCellString( 5, 1, g_szStartDate&"~"&g_szFinalDate)
		tbl0.SetCellString( 7, 1, g_szList(8) )	'상태
		
'		if g_szList(8) == "해지" then
'			tbl0.SetCellString( 8, 0, "")
'			btnSave.caption = "확인"
'		end if

	elseif szTranID == "obpds_srvc_038a" then
		Form.ShowAlert( "알림", "해지가 완료되었습니다.")
		Form.SendReturnToParent( "OK" , sData)
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub btnSave_OnClick()
	
	if btnSave.caption == "해지" then
		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
'		DATAMANAGER.RequestTranData( "obpds_srvc_038a" )		'테스트용
	else
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) : 공인인증 확인후 처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			DATAMANAGER.RequestTranData( "obpds_srvc_038a" )
		end if
	end if
End Sub
'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

