<ROOT>
	<MAP_INFO scrno="65020" scrname="환전내역 메인" version="2" writer="조승행" />
	<FORM_INFO name="Form" ly_vert="0,0,375,702,1" />
	<CONTROL_INFO>
		<FORMTAB name="fmtab01" tabcount="2" tabwidthtype="1" tabheadheight="45" autosave="1" ly_vert="0,107,375,595,1" >
			<PAGE name="page0" caption="환전" linkfile="nrsbbnk65020_t1" loadingtype="1" />
			<PAGE name="page1" caption="목표환율환전" linkfile="nrsbbnk65020_t2" loadingtype="1" />
		</FORMTAB>
		<ACCOUNT name="acnt01" bgcolor="052:255255255" itemcodetype="100,119,135,137,200" etcfunctions="" accpwdctl="edtPwd01" delegate="1" ly_vert="10,53,355,46,1" />
		<EDIT name="edtPwd01" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" ly_vert="500,5,86,39,1" />
		<IMAGE name="ImgBackPress" autosize="1" imgpath="icon_main_01" ly_vert="6,11,39,24,1" />
		<LABEL name="lblTitle" fontsize="3" caption="환전내역" bgcolor="064:239059036" click="1" ly_vert="47,0,313,47,1" />
		<IMAGE name="imgMenu" autosize="1" ly_vert="150,16,39,15,1" />
		<COMBO name="cmbMenu" visible="0" initkeyindex="3" cbinputdatatext="<![CDATA[01`환율조회
02`환전신청
03`목표환율환전신청
04`환전내역]]>" ly_vert="400,50,111,32,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3933" _ulen="3891" >

'============================================================================
' 화 면 명 : 환전내역
'============================================================================

Dim g_szLinkData

' 화살표 이미지
Dim g_szArrowImg  
g_szArrowImg = "icon_arrow_down2"
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("2")
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	g_szLinkData = Form.GetOpenLinkData()
	lblTitle.paddinginfo = "0,0,0,0"
	
	nWidth = Form.GetTextWidth("환전신청", 3, false, false)
	imgMenu.maintainratio = "2" 
	imgMenu.imgpath = g_szArrowImg
	imgMenu.visible = true
	imgMenu.left = 47 + nWidth + 10
	
	Form.SetTimerEvent2(1, 1, 0.2)
'	if szLinkData = "0" then
'		fmtab01.currenttabpageid = "page0"
'	elseif LinkData = "1" then
'		fmtab01.currenttabpageid = "page1"
'	end if
'	
'	acnt01_ChangeAccount()
End Sub

'============================================================================
Sub acnt01_ChangeAccount()
	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "ACNTINFO_CHG", left(acnt01.caption,8) & "★" & mid(acnt01.caption,9,2))
End Sub

'============================================================================
Sub fmtab01_OnTabChanged(nCurrentTab)
	if	acnt01.caption	<>	null		and	len(acnt01.caption)	> 6	then
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "ACNTINFO_CHG", left(acnt01.caption,8) & "★" & mid(acnt01.caption,9,2))
	end	if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.OpenPrevScreen()
End Sub

'============================================================================
Sub imgMenu_OnClick()
	cmbMenu.currentindex = 3
	cmbMenu.OpenList()	
End Sub

'============================================================================

'============================================================================
Sub lblTitle_OnClick()
	cmbMenu.openList("")
End Sub

'============================================================================
Sub cmbMenu_OnEditComplete(iIndex)
	if iIndex == 0 then
		Form.OpenScreen("65100", "")
	elseif iIndex == 1 then
		Form.OpenScreen("65000", "")
	elseif iIndex == 2 then
		Form.OpenScreen("65010", "")
	elseif iIndex == 3 then
'		Form.OpenScreen("65020", "")
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHECK_PWD" then
		Form.openPopupAnimation("pwdcheckpopup", acnt01.caption & "☆0" ,"","2")

	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd01.pwdlen = tData(1)
				edtPwd01.caption = tData(0)
				
				
				szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )
			
				If szCertUserType == "1" Or szCertUserType == 1 Then 
				    Form.OpenFramePopup( "mhetc90060_px" , "" , "")
				Else
					Form.OpenFramePopup("mhetc90060_p5" , "" , "")
				End if
				
			end if
		end if
		
	elseif sKeyName = "mhetc90060_p5" or sKeyName = "mhetc90060_px" then
		if sRet == "ok" then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "CORRECT_PWD", edtPwd01.caption)
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if Cint(sTimerID) == 1 then
		Form.SetTimerEvent2(Cint(sTimerID), 0, 0)
		
		if g_szLinkData = "0" then
			fmtab01.currenttabpageid = "page0"
		elseif g_szLinkData = "1" then
			fmtab01.currenttabpageid = "page1"
		end if
		
		acnt01_ChangeAccount()
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>