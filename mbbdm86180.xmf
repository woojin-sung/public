	ImgF.setMaintainingRatio("5")
	Image0.setMaintainingRatio("1")
	Container1Step.Image1.setMaintainingRatio("1")
	
	Container1Step.PwdFail0.setMaintainingRatio("1")
	Container1Step.PwdFail1.setMaintainingRatio("1")
	Container1Step.PwdFail2.setMaintainingRatio("1")
	Container1Step.PwdFail3.setMaintainingRatio("1")
	Container1Step.Pwdbasic0.setMaintainingRatio("1")		
	Container1Step.Pwdbasic1.setMaintainingRatio("1")		
	Container1Step.Pwdbasic2.setMaintainingRatio("1")		
	Container1Step.Pwdbasic3.setMaintainingRatio("1")		
	Container1Step.PwdInsert0.setMaintainingRatio("1")	
	Container1Step.PwdInsert1.setMaintainingRatio("1")	
	Container1Step.PwdInsert2.setMaintainingRatio("1")	
	Container1Step.PwdInsert3.setMaintainingRatio("1")	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Image0_OnClick()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ABORT" and sRet == "ok" then
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
		
'		Form.CloseForm()
		
		Form.OpenNextPopup("mbbdm85100", "", "")
	elseif sKeyName == "PrgsExit" then	
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
		
'		Form.CloseForm()		
		Form.OpenNextPopup("mbbdm85100", "", "")	
	end if
End Sub

