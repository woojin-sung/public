'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 계좌비밀번호 입력
' 02. 화면설명 : 계좌비밀번호 입력
' 03. 작    성 : 2021.01.22 김유경
' 04. 수    정 :  
'-------------------------------------------------------------------------------------------
'****************************************************************************
' EdtPwReal : 실제 비밀번호 인증 과정 구현하는 에디트
' EdtPwFake : 사용자에게 보여지는 비밀번호입력 에디트 
'****************************************************************************

Dim nCnt

Dim gWRPL_TELNO
Dim gCLPH_TELNO
Dim gOWHS_TELNO

Dim CloseFlag
CloseFlag = 0

Dim g_OsType

Dim gRCNO
Dim gRegUniqNo
Dim gPW_PIP
Dim gCNFR_PW_PIP

Dim g_CharFlag 'iOS의 경우 키패드의 취소와 입력완료를 구분할 수 없어서 Flag 값으로 구분
Dim g_CountSave

Dim gPageID
	gPageID = "2"

'************************* 참고 ********************************************
'취소버튼과 입력완료 버튼이 OnEditChar에 동일하게 "2"로 떨어집니다.
'입력완료의 경우에만 OnEditComplete()을 탑니다.
'***************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	g_OsType = Form.GetSharedData("&OS_TYPE", False)

	nCnt = 0	
	
	Container1Step.Button0.imagefilepth   = "alpha"
	Container1Step.Image0.imagefilepth    = "icon_top_back_light"
	
	Container1Step.EdtPwReal.SetApplyLabel("숫자입력"	,0 , 76 , "left" , true) '호출해야 정상작동
	Form.SetTimerEvent2(1, 1, 0.5) '1초뒤 보안키패드 활성화
	
	'휴대폰번호
	HP1 = Form.GetSharedData("BDM_HP1" , false )
	HP2 = Form.GetSharedData("BDM_HP2" , false )
	HP3 = Form.GetSharedData("BDM_HP3" , false )
	gCLPH_TELNO = HP1 & HP2 & HP3
	
	gWRPL_TELNO = Form.GetSharedData("BDM_WRPLNUM", false )
	gOWHS_TELNO = Form.GetSharedData("BDM_OWHSNUM", false )
	
	gWRPL_TELNO = replace(gWRPL_TELNO,"-","")
	gOWHS_TELNO = replace(gOWHS_TELNO,"-","")
	
	gRCNO = Form.GetSharedData("BDM_RCNO_PIP"  , false ) '주민등록번호
	gRegUniqNo  = Form.GetSharedData("BDM_REG_UNIQ_NO" , false ) '등록고유번호
	
	gPW_PIP     = Form.GetSharedData("BDM_PW_PIP"      , false ) '비밀번호
	gCNFR_PW_PIP= Form.GetSharedData("BDM_CNFR_PW_PIP" , false ) '비밀번호확인
	
'	If g_OsType == "2" Then
'		Container1Step.EdtPwReal.setHideCancel(true) 'iOS 취소버튼 제거
'	End If

	'20230421 이어가기 상태 조회용으로 추가함
	DATAMANAGER.RequestTranData("obaci_acct_058r")

End Sub

'============================================================================
Sub Container1Step_EdtPwReal_OnEditComplete()

	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
		
	end if
	
	'비밀번호 재입력
	Form.SetSharedData("BDM_PW_PIP", Container1Step.EdtPwReal.caption ) '비밀번호
	Form.SetSharedData("BDM_PW_PIP_ARIA", Container1Step.EdtPwReal.caption2 ) '비밀번호
			
	DATAMANAGER.RequestTranData("obaci_nmet_011r") '키패드 입력완료 시 검증 TR Call
End Sub
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_nmet_011r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , Container1Step.EdtPwReal.caption2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WRPL_TELNO"     , 0 , gWRPL_TELNO)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     , 0 , gCLPH_TELNO)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OWHS_TELNO"     , 0 , gOWHS_TELNO)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0 , gRCNO      )
	elseIf szTranID = "obaci_acct_058r" Then	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , gRCNO      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , gRegUniqNo	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , gPageID	)	
	End If
End Sub 

'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim gProsClsCode , gRsltCode
	
	If szTranID = "obaci_nmet_011r" Then
		gProsClsCode = ""
		gRsltCode    = ""
		
		gProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		gRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If gProsClsCode == "1" and TRIM(gRsltCode) <> "00" Then
			
			Form.OpenPopup("mbbdm86180_p1", gRsltCode , "" )
			'Container1Step.EdtPwReal.caption = ""
			'nCnt = 0
			'PasswordFail()
			'Form.SetTimerEvent2(3, 1, 0.5) '2021.03.31. 오류 시 키패드
			
		Else '비밀번호 입력 성공시
			
			Call PasswordInsert()
			
			Form.SetTimerEvent2(2, 1, 0.5) '1초뒤 화면 넘어감
	
		End If
	elseIf szTranID = "obaci_acct_058r" Then	
		sPrgsYn		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "PRGS_YN"  	  , 0)
		
		'20230421 이어가기 비정상 종료처리 추가
		if sPrgsYn == "N" then
			Form.MsgBox("안내", "이미 개설이 완료되었거나\n취소가 된 경우에는\n이어하기가 불가합니다.", "PrgsExit", 6)
			Exit Sub
		end if		
	End If
End Sub 

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	if len(trim(szSubErr)) == 0 then
		Form.ShowAlert("알림", szErrMsg)
	else
		Form.ShowAlert("알림", szErrMsg.."("..szSubErr..")" )
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	If sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.5)
	
		Container1Step.EdtPwReal.SetShowKeypad(True)
		
	ElseIf sTimerID == "2" or sTimerID == 2 then 
		
		Form.SetTimerEvent2(sTimerID, 0, 0.5)
				
		CloseFlag = 1
		Form.OpenNextPopup("mbbdm86181" , "" , "" )
		
	ElseIf sTimerID == "3" or sTimerID == 3 then
		Form.SetTimerEvent2(sTimerID, 0, 0.5)
			
		Container1Step.EdtPwReal.SetShowKeypad(True)
	End If
	
End Sub

'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub Container1Step_EdtPwReal_OnEditChar(CharCode)

	Select Case CharCode
	
	Case "0"
		
		'입력값 4초과할 때 초과 카운팅 방지
		if nCnt == 4 then
			nCnt = 4
		else
			nCnt = nCnt + 1
		end if
		
	Case "1"
		
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt == 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
	Case "2" '취소/입력완료
		nCnt = 0
	End Select

	PasswordInsert()	
End Sub

'============================================================================
'사용자에게 보여지는 패스워드 모양 삽입 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag = "N" then
		nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case nCnt
	
	Case 0
		Container1Step.Pwdbasic0.visible = true	
		Container1Step.Pwdbasic1.visible = true	
		Container1Step.Pwdbasic2.visible = true	
		Container1Step.Pwdbasic3.visible = true	

		Container1Step.PwdInsert0.visible = false	
		Container1Step.PwdInsert1.visible = false	
		Container1Step.PwdInsert2.visible = false	
		Container1Step.PwdInsert3.visible = false	

	Case 1
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = true	
		Container1Step.Pwdbasic2.visible = true	
		Container1Step.Pwdbasic3.visible = true	

		Container1Step.PwdInsert0.visible = true
		Container1Step.PwdInsert1.visible = false	
		Container1Step.PwdInsert2.visible = false	
		Container1Step.PwdInsert3.visible = false		
	Case 2	
		Container1Step.PwdInsert0.visible = true	
		Container1Step.PwdInsert1.visible = true
		Container1Step.Pwdbasic2.visible = true	
		Container1Step.Pwdbasic3.visible = true	
		
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = false
		Container1Step.PwdInsert2.visible = false	
		Container1Step.PwdInsert3.visible = false	
	Case 3
		Container1Step.PwdInsert0.visible = true	
		Container1Step.PwdInsert1.visible = true	
		Container1Step.PwdInsert2.visible = true
		Container1Step.Pwdbasic3.visible = true	
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = false	
		Container1Step.Pwdbasic2.visible = false	
		Container1Step.PwdInsert3.visible = false
	Case 4
		Container1Step.PwdInsert0.visible = true	
		Container1Step.PwdInsert1.visible = true	
		Container1Step.PwdInsert2.visible = true	
		Container1Step.PwdInsert3.visible = true
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = false	
		Container1Step.Pwdbasic2.visible = false	
		Container1Step.Pwdbasic3.visible = false		
	Case else
		Form.ShowAlert("알림", "4자리를 입력해주세요.")
	End Select
	
	Container1Step.PwdFail0.visible = false
	Container1Step.PwdFail1.visible = false
	Container1Step.PwdFail2.visible = false
	Container1Step.PwdFail3.visible = false
End Function

'============================================================================
Sub Container1Step_Button0_OnClick()
	Container1Step.EdtPwReal.SetShowKeypad(True)
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.MsgBox("알림", "계좌개설을 중단하시겠습니까?\n진행 중인 계좌개설은 추후 '이어가기'로 이어서 진행하실 수 있습니다.", "ABORT", 7, "예", "아니오")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbbdm86180_p1_end" Then
		Container1Step.EdtPwReal.caption = ""
		nCnt = 0
		'PasswordFail()	
		PasswordInsert()
		Container1Step.EdtPwReal.SetShowKeypad(True)
	End If
End Sub

'============================================================================
Sub Container1Step_Image1_OnClick()
	Form.OpenPopup("mbbdm86180_p2", "" , "" )
End Sub

'============================================================================
'인증 실패 UI
'============================================================================
Function PasswordFail()
	Container1Step.PwdFail0.visible = True
	Container1Step.PwdFail1.visible = True
	Container1Step.PwdFail2.visible = True
	Container1Step.PwdFail3.visible = True
	Container1Step.Pwdbasic0.visible = false		
	Container1Step.Pwdbasic1.visible = false		
	Container1Step.Pwdbasic2.visible = false		
	Container1Step.Pwdbasic3.visible = false		
	Container1Step.PwdInsert0.visible = false	
	Container1Step.PwdInsert1.visible = false	
	Container1Step.PwdInsert2.visible = false	
	Container1Step.PwdInsert3.visible = false	
End Function

'============================================================================
