'============================================================================
Sub edtMoney_OnEditComplete()
	f_BtnSet()

	if edtMoney.caption == "" then
	
	elseif Int(edtMoney.caption) < 1000 then
		Form.ShowAlert("알림", "1,000원 이상 입력해주세요.")
		edtMoney.caption = ""
		edtMoney.SetShowKeypad(true)
		Exit Sub
		
	else
		edtMoney.halign = 2
	end if

	f_btnSaveEnable()
End Sub

