'============================================================================
'							사용자 함수
'============================================================================
' 출금계좌 세팅 함수
'============================================================================
Sub f_SetRecieveText()
	
	if g_szBankCode == "287" then
		g_TACT_ACNT_CLS_CODE = 1
		
		cmbMeritz.visible	= true
		cmbOther.visible	= false
		Image2.visible	= false
		acntList.visible	= true
'		acntList.caption	= g_szBankAcno
		LblAcnt.visible	= false
'		Form.MsgBox("알림" , "메리츠증권 계좌를 등록하는 경우 출금유형 '메리츠증권'을 선택하시기 바랍니다." , "", 0)
	else
		g_TACT_ACNT_CLS_CODE = 2
		
		cmbMeritz.visible	= false
		cmbOther.visible	= true
		Image2.visible	= true
		acntList.visible	= false
		LblAcnt.visible	= true
		LblAcnt.caption	= g_szBankAcno.."  "..g_szBankAcntNm
	end if
	
    imgLogo.imgpath		= "bank"..g_szBankCode..".png"
    LblBnkNm.caption		= g_szBankName
End Sub

'============================================================================
' 화면 리셋 함수
'============================================================================
Sub f_resetCtl()
	
	' 이체금액 리셋
	edtMoney.caption = "" 
	f_BtnSet()
	
	' 자동이체기간 리셋
	cmbSortGb.currentindex = 0
	
	' 자동이체일 리셋
	cmbMeritz.currentindex	= "-1"
	cmbOther.currentindex	= "-1"
	cmbMeritz.caption		= "이체일을 지정해주세요."
	cmbOther.caption		= "이체일을 지정해주세요."
	
	' 신청버튼 비활성화
	btnSave.enable = false
End Sub

'============================================================================
' 이체금액버튼 세팅 함수
'============================================================================
Sub f_BtnSet(idx)

	if idx == "" or idx == null then
		edtMoney.halign = 0
	else
		edtMoney.halign = 2
	end if
	
	Dim szImgNm, szLblNm

	for i = 0 to 4
		szImgNm = "RdoBtn" & i
		szLblNm = "RdoLbl" & i

		' 비활성화 ---
		Form.SetCtlProp(szImgNm, "imgpath",	"btn_line2_n.9")
		Form.SetCtlProp(szLblNm, "fgcolor", 	"321")
		Form.SetCtlProp(szLblNm, "fontbold",	false)
		
		' 활성화 ---
		if i == idx then			
			Form.SetCtlProp(szImgNm, "imgpath",	"btn_line2_o.9")
			Form.SetCtlProp(szLblNm, "fgcolor", 	"144")
			Form.SetCtlProp(szLblNm, "fontbold",	true)
		end if
		
	next

	f_btnSaveEnable()
End Sub

'============================================================================
' 신청버튼 활성화/비활성화
'============================================================================
Sub f_btnSaveEnable()
	Dim retrnVal
	retrnVal = true
	
	if edtMoney.caption == "" or CInt(edtMoney.caption) < 1000 then
		retrnVal = false
	end if
	
	if g_TACT_ACNT_CLS_CODE == 1 and CInt(cmbMeritz.currentindex) == -1 then
		retrnVal = false
	elseif g_TACT_ACNT_CLS_CODE == 2 and CInt(cmbOther.currentindex) == -1 then
		retrnVal = false	
	end if
	
	if g_szKycRetVal = FALSE THEN 
		retrnVal = false
	END IF
	
	btnSave.enable = retrnVal
End Sub

'============================================================================
' 
'============================================================================
Sub BioSgntDataInsert(szMsg)
	szTranID = "obpds_srvc_416a"
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 					, 0, g_szCustNum)			
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 					, 0, "012")
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BCDT_CLS_CODE" 			, 0, "3")				'단말운영체제	: 1.안드로이드 2.아이폰 9.기타
'	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATCH_FILD_SIZE" 			, 0, STRING(LEN(szMsg)))	'단말ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RMND_SRNO" 				, 0, g_szList(2))			'서비스코드	: 001 고정
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_ELCT_SGNT_DATA"	, 0, szMsg)				'인증타입	: S.자사인증 D.교차인증 C.호환인증
	
	DATAMANAGER.RequestTranData(szTranID)	
End Sub

'============================================================================
' 신청 전 적합성 체크
'============================================================================
Sub f_bCheckBeforeReg()
	
	if g_TACT_ACNT_CLS_CODE == 1 then
	
		If acntList.itemcodetype == "118" or acntList.itemcodetype == "123" then
			' CMA 계좌(118, 123)는 정상적으로 등록 가능
		else
			' CMA 계좌가 아닌 경우 오류 처리
			Form.ShowAlert( "알림", "CMA 계좌만 출금계좌로 선택 가능합니다.")
			Exit Sub
		End If
		
	end if
	
	if g_TACT_ACNT_CLS_CODE == 2 then

		if LblBnkNm.caption == "" then 
			Form.ShowAlert( "알림", "출금은행을 선택해 주세요.")
			Exit Sub
		elseif LblAcnt.caption == "" then
			Form.ShowAlert( "알림", "계좌를 확인해 주십시오.")
			Exit Sub
		end if
		
	end if

	if edtMoney.caption == "" or CInt(edtMoney.caption) < 1000 then
		Form.ShowAlert( "알림", "이체금액을 확인해 주세요.")
		Exit Sub
	end if	
	
	' 자동이체 기간 체크
	if (cld0.calyear == cld1.calyear) and (cld0.calmonth == cld1.calmonth) then 
		Form.ShowAlert( "알림", "이체기간이 한달 미만입니다.")
		Exit Sub
	end if
	
	if g_TACT_ACNT_CLS_CODE == 1 and CInt(cmbMeritz.currentindex) == -1 then
		Form.ShowAlert( "알림", "자동이체일을 선택해 주세요.")
		Exit Sub
	elseif g_TACT_ACNT_CLS_CODE == 2 and CInt(cmbOther.currentindex) == -1 then
		Form.ShowAlert( "알림", "자동이체일을 선택해 주세요.")
		Exit Sub
	end if
	
	return true
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

