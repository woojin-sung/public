'============================================================================
' 01.화면명 	: 펀드정기입금이체
' 02.화면설명	: 펀드정기입금이체 상세정보 및 해지신청 팝업
' 03.작성	: 2016. 03. 10. 유창재
' 04.수정     : v0001 : 타은행/증권사 선택시 개인정보 제공동의 팝업 추가
'			: v0002: 펀드정기입금이체 신청 시 투자설명서 교부 요청
'             : v0003 : 장원혁_타은행/증권사 정기이체입금 신청 시 메리츠증권 선택 못하도록 제어
'             : v0004 : 장원혁_개인신용정보 처리 동의서 변경에 따른 개발
'             : v0005 : 정효영_간이투자설명서, 핵심상품설명서 추가
'			  v0006 : 2022.01.11 : 정우희 오스템임플란트 팝업창 추가
'	      : v0007 : 전상일_고객구분에 따른 실명확인번호 입력 변경
'             : v0008 : 임동군 2022.08.02  투설/간투설/핵심설명서 다시볼 수 있도록 체크 활설/비활성화 기능 살림
'             : v0009 : 정우희 2024.07.23  자동이체약정 적합(적정)성 원칙 적용
'===========================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szBankCode		'은행코드
Dim g_szBankName		'은행명
Dim g_szBankAcno
Dim g_szBankAcntNm

Dim g_TACT_ACNT_CLS_CODE
Dim g_szToday			'당일날짜

Dim g_szData			'
Dim g_szList
Dim g_szAcnt			'계좌번호
Dim g_szAsno			'계좌일련번호
Dim g_szPW			'비밀번호
Dim g_szRmndSrno		'잔고일련번호
Dim g_szIscd			'펀드코드
Dim g_szKOR_ISNM		'한글종목명
Dim g_szCustNum		'고객번호
Dim g_szBrdt			'생년월일
Dim g_DPSR_RRNO		'예금자주민등록번호
Dim g_szUserID		'금융ID
Dim g_szCertUserType	'로그인type 1:간편 3:바이오
Dim g_szINVT_FILE		'투자설명서 파일명

Dim g_szCORE_FILE '21.09.23 추가 : 간이설명서 파일명 (v0005)
Dim g_szPROD_FILE '21.09.23 추가 : UI상품첨부파일원본명 (v0005)

Dim g_szKycRetVal
'============================================================================
'								FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.setMaintainingRatio("1")
	'ImgInfo.setMaintainingRatio("1")
	ImgLogo.setMaintainingRatio("1")
	
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	
	if g_szCertUserType == "4" then
		Form.ShowAlert( "알림", "공동인증은 출금동의자료 미제공으로 처리불가합니다.")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szKycRetVal = FALSE
	g_szBankCode		= "287"
	g_szBankName		= "메리츠증권"
	g_szBankAcno		= ""
	g_szBankAcntNm	= ""

	cmbMeritz.currentindex	= "-1"
	cmbOther.currentindex	= "-1"
	cmbMeritz.caption		= "이체일을 지정해주세요."
	cmbOther.caption		= "이체일을 지정해주세요."
	
	Form.removeWaitCursor()
	cmbSortGb.currentindex = 0

	g_TACT_ACNT_CLS_CODE	= 1
	g_szToday 			= cld0.caption

	g_szData				= Form.GetOpenLinkData()
	g_szList				= Split(g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	'계좌번호, 일련번호, 잔고일련번호, 펀드코드, 한글 종목명
	g_szAcnt		= g_szList(0)
	g_szAsno		= g_szList(1)
	g_szRmndSrno	= g_szList(2)
	g_szIscd		= g_szList(3) 'v0002
	g_szKOR_ISNM	= g_szList(4) 'v0002
	g_szUserID = Form.GetSharedData("&USER_ID", false)

	'v0006
	DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD",				0, TRIM(g_szIscd))
	DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD",		0, "02")		'추가매수
	DATAMANAGER.RequestTranData("obsai_deal_701r")
	
	DATAMANAGER.SetDataValue(0, "obpds_srvc_070r", "InBlock1", "ACNO", 				0, g_szAcnt)	'계좌번호
	DATAMANAGER.RequestTranData("obpds_srvc_070r")
	
	'v0009
	Form.OpenPopup("mbonl81010_p1" , "51020★0★" & g_szAcnt & "★" &  g_szAsno & "★" &  g_szIscd)	
	
End Sub

'==========================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    ImgClose_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList
	Dim szTempData
	
	Form.removeWaitCursor()

	' 출금계좌 리턴
	if sKeyName == "mbbnk63010_p3" then
		arrBankInfo = Split(sRet, "★")
		
		if UBOUND(arrBankInfo) < 1 then
		    Exit Sub
	    end if
	    
		g_szBankCode		= arrBankInfo(0)
		g_szBankAcno		= arrBankInfo(1)
		g_szBankName		= arrBankInfo(2)
		g_szBankAcntNm	= arrBankInfo(3)

		f_resetCtl()
		f_SetRecieveText()
	
	' 설명서 / 확인사항 리턴
	elseif sKeyName == "mbfnp51020_p8" then

		if sRet == "ok" then	'개인정보동의확인
			Form.SetTimerEvent2(1, 1, 0.5)
		end if
		
	'계좌 비밀번호 입력 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tData
		tData = Split(sRet, "★")
		
		if UBOUND(tData) > 0 Then
			g_szPW = tData[0]
			
			sTRAN_CNTT 			= ""
			sBIO_TR_CODE 			= "1"
			sATHN_USAG_CLS_CODE	= "1"
			sData				= ""
			
			if g_szCertUserType == "3" OR g_szCertUserType == "5" then
			
				if g_TACT_ACNT_CLS_CODE == 1 then	'메리츠일때
					sTRAN_CNTT = "정기입금이체예정내역\n" & "출금기관: " & "메리츠증권" & "\n" & "출금계좌: " & acntList.total & acntList.sequence & "\n" & "예금주명: " & acntList.accountname & "\n" & "이체금액: " & FormatNumber(CDbl(edtMoney.caption), 0, 0, 0, -1) & "원\n"
				else
					sTRAN_CNTT = "정기입금이체예정내역\n" & "출금기관: " & g_szBankName & "\n" & "출금계좌: " & g_szBankAcno & "\n" & "예금주명: " & g_szBankAcntNm & "\n" & "예금주생년월일: " & g_szBrdt & "\n" & "이체금액: " & FormatNumber(CDbl(edtMoney.caption), 0, 0, 0, -1) & "원\n"
				end if
				
				if g_szCertUserType == "5" then
					sData = "ATON_trType★" & sTRAN_CNTT
				else
					sData = "BIO_trType★" & sBIO_TR_CODE & "★" & sTRAN_CNTT & "★" & sATHN_USAG_CLS_CODE
				end if
				
			end if

		     Form.OpenFramePopup("mhetc90060_p5", sData, sPosInfo) 'v0004 공인인증 개인정보수집동의를 앞단에서 처리
		end if
		
	elseif sKeyName == "mhetc90060_p5" then
	
		if g_szCertUserType == "3" then
			szTempData = Split(sRet, ";")
			
			if szTempData(0) == "ok" then    
				szTmpMsg = MID(sRet, 5, LEN(sRet) - 4)

				BioSgntDataInsert(szTmpMsg)
			end if
			
		else
		
			if sRet ~= "cancel" then
				DATAMANAGER.RequestTranData("obpds_srvc_417r")
			end if
			
		end if
		
		Exit Sub

	' 자동이체신청 완료 리턴
	elseif sKeyName == "mbfnp51020_p9" then

		if sRet == "OK" then
			Form.SendReturnToParent("mbfnp51020_p3", "CONPLETE")
			Form.CloseForm()
		end if
	'v0009
	elseif sKeyName = 	"KYCCHK_RETURN" then	
		IF sRet = "N"	THEN
			g_szKycRetVal = FALSE
		ELSEIF sRet = "Y"	THEN
			g_szKycRetVal = TRUE
		END IF
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 0.5)
		
'		Dim AcntNo
'
'		if g_TACT_ACNT_CLS_CODE == 1 then	'메리츠일때
'			AcntNo = acntList.caption
'		else
'			AcntNo = g_szBankAcno
'		end if
		
		Form.openPopupAnimation("pwdcheckpopup", g_szAcnt&g_szList(1) & "☆" & "0", "", "2")
	end if
	
End Sub

'============================================================================
'							DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "ooopc_cuma_019r" then
		DATAMANAGER.SetDataValue( 0 , "ooopc_cuma_019r", "InBlock1", "CSNO" , 0 , g_szCustNum)
	
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_szAcnt)
	
	elseif szTranID == "obpds_srvc_417r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "ACNO" , 0 , g_szAcnt)									'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "ASNO" , 0 , g_szList(1))									'일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "CSNO" , 0 , g_szCustNum)									'고객번호
		
		if g_szCertUserType == "5" then	'사설인증
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "SVCD" , 0 , "412")									'사설인증 임시
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "SVCD" , 0 , "012")									'서비스코드(정기입금이체)
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_AMT" , 		0 , edtMoney.caption)					'이체금액
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "RMND_SRNO" , 		0 , g_szList(2) )						'펀드 잔고번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "RQST_ISTU_NAME" ,	0 , "메리츠증권" )					'요청기관명
		
		if g_TACT_ACNT_CLS_CODE == 1 then	'메리츠일때
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_ACNT_CLS_CODE" , 	0 , g_TACT_ACNT_CLS_CODE)		'이체계좌 구분코드 -> 메리츠 : 1
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_HOPE_DAY_CODE" , 	0 , cmbMeritz.cbkeydata)		'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_SCRT_ACNO" , 		0 , acntList.total )			'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_SCRT_ASNO" , 		0 , acntList.sequence )		'일련번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "BANK_NAME" , 			0 , "메리츠증권" )			'은행명
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_HOPE_DAY_CODE" , 	0 , cmbOther.cbkeydata )		'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "BANK_CODE" , 			0 , g_szBankCode)				'타행기관코드
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "TACT_BANK_ACNO" , 		0 , g_szBankAcno)				'타행계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "DPSR_RRNO" , 			0 , g_szBrdt )				'예금자 주민등록번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_417r", "InBlock1", "BANK_NAME" , 			0 , g_szBankName)				'은행명
		end if
	
	elseif szTranID == "obpds_srvc_038a" then
		Dim sAGRM_RQCL_DOCU_CLCD
		sAGRM_RQCL_DOCU_CLCD = Form.GetSharedData("AGRM_RQCL_DOCU_CLCD_51010", true)
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 	0 , sAGRM_RQCL_DOCU_CLCD)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "PROS_CLS_CODE" , 		0 , "I")							'처리구분코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "CONT_CLS_CODE" , 		0 , "4")							'접촉구분코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "NXET_TIMS_ATMT_APLT_YN",	0 , "N")							'다음회차자동신청여부
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ACNO" , 				0 , g_szAcnt)						'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ASNO" , 				0 , g_szList(1))					'일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "CSNO" , 				0 , g_szCustNum)					'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_AMT" , 			0 , edtMoney.caption)				'이체금액
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ACNT_PWD" , 			0 , g_szPW)						'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "RMND_SRNO" , 			0 , g_szList(2) )					'펀드 잔고번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "SVCD"      , 			0 , "012") 						'서비스코드 JWH
		
		Dim aplt_day
		if g_TACT_ACNT_CLS_CODE = 1 then 
			aplt_day = REPLACE(cmbMeritz.caption,"일","")
		else 
			aplt_day = REPLACE(cmbOther.caption,"일","")
		end if 
		
		if len(aplt_day) = 1 then
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_STA_DATE" ,	 	0 , MID(cld0.caption,1,6) .. "0" .. aplt_day ) 						'서비스코드 JWH
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_FIN_DATE" ,	 	0 , MID(cld1.caption,1,6) .. "0" .. aplt_day ) 						'서비스코드 JWH
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_STA_DATE" ,	 	0 , MID(cld0.caption,1,6) ..  aplt_day ) 						'서비스코드 JWH
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_FIN_DATE" ,	 	0 , MID(cld1.caption,1,6) ..  aplt_day ) 						'서비스코드 JWH	
		end if
		
		if g_TACT_ACNT_CLS_CODE == 1 then	'메리츠일때
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_ACNT_CLS_CODE" , 	0 , g_TACT_ACNT_CLS_CODE)		'이체계좌 구분코드 -> 메리츠 : 1
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_HOPE_DAY_CODE" , 	0 , cmbMeritz.cbkeydata)		'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ACNO" , 		0 , acntList.total )			'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ASNO" , 		0 , acntList.sequence )		'일련번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_BANK_ACNO" , 		0 , "" )						'타행계좌번호 JWH
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_ACNT_CLS_CODE" , 	0 , g_TACT_ACNT_CLS_CODE)		'이체계좌 구분코드 -> 타행
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_HOPE_DAY_CODE" , 	0 , cmbOther.cbkeydata )		'이체희망일
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "BANK_CODE" , 			0 , g_szBankCode)				'타행기관코드
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_BANK_ACNO" , 		0 , g_szBankAcno)				'타행계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "DPSR_RRNO" , 			0 , g_DPSR_RRNO )				'예금자 주민등록번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "DPSR_NAME" , 			0 , g_szBankAcntNm)			'예금자명
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ACNO" , 		0 , "" )						'계좌번호 JWH
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ASNO" , 		0 , "" )						'일련번호 JWH
		    
'		    If ChkSumm.checkstate == "1" And ChkDtl.checkstate <> "1" Then
'		        DATAMANAGER.SetDataValue( 0, "obpds_srvc_038a" , "InBlock1" , "AGRM_RQCL_DOCU_CLCD" , 0 , "1")
'		    ElseIf ChkSumm.checkstate <> "1" And ChkDtl.checkstate == "1" Then
'		        DATAMANAGER.SetDataValue( 0, "obpds_srvc_038a" , "InBlock1" , "AGRM_RQCL_DOCU_CLCD" , 0 , "2")
'		    ElseIf ChkSumm.checkstate == "1" And ChkDtl.checkstate == "1" Then
'		        DATAMANAGER.SetDataValue( 0, "obpds_srvc_038a" , "InBlock1" , "AGRM_RQCL_DOCU_CLCD" , 0 , "3")
'		    End If
		    
		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim g_szCMSAble
	Dim g_szAbleAmt

	if szTranID == "obsai_deal_701r" then
		 g_szFND_DEAL_RSTC_CLCD	= DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "FND_DEAL_RSTC_CLCD",	0)	'펀드매매제한구분코드
		 g_szTN_INFORM_YN			= DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "TN_INFORM_YN", 			0)	'주의알림여부
		 g_szDEAL_ABLE_YN			= DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "DEAL_ABLE_YN",			0)	'매매제한여부
		 
		 if g_szTN_INFORM_YN = "Y" then
		 
			 if g_szFND_DEAL_RSTC_CLCD = "001" then
				 Form.ShowAlert("알림", "선택하신 펀드는 오스템임플란트 주식(2022.01.03일자 거래정지)을 편입하고 있습니다. 오스템임플란트 주식을 편입한 펀드의 경우, 운용사에서 공정가치 재평가 후 자산 상각을 진행하여 기준가에 반영하였으나 향후 추가 상각될 가능성이 있습니다. 이와 관련하여 편입비율 변동 및 추가 위험에 노출될 수 있으니 투자시 유의하시기 바랍니다. 자세한 사항은 거래 영업점 또는 고객센터(1588-3400)로 문의하시기 바랍니다.")
			 elseif g_szFND_DEAL_RSTC_CLCD = "002" then
				 Form.ShowAlert("알림", "선택하신 펀드는 주요 투자 지역(러시아)의 지정학적 리스크 확대 및 투자자산의 유동성 제한에 따라 환매 연기 조치 되었습니다. 이에 따라 적립식 매수를 포함한 매수신청이 제한됨을 안내드립니다.")	 
			 end if
			 
		 end if

	elseif szTranID == "obpds_srvc_070r" then
		g_szCustNum = DATAMANAGER.GetDataValue(0, "obpds_srvc_070r", "OutBlock1", "CSNO", 0)

		DATAMANAGER.RequestTranData("ooopc_cuma_019r")
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	
	elseif szTranID == "ooopc_cuma_019r" then
		g_szBrdt = DATAMANAGER.GetDataValue(0, "ooopc_cuma_019r", "OutBlock1", "BRDT", 0)
	
	elseif szTranID == "obcsb_acif_000r" then
		g_DPSR_RRNO = MID(DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "BRDT", 0),3,6)
	
	'16-04-12 YCJ 정기이체동의 전자서명내역 등록 - 박영택 과장님 추가
	elseif szTranID == "obpds_srvc_416a" or szTranID == "obpds_srvc_417r" then
		DATAMANAGER.RequestTranData( "obpds_srvc_038a" )
	
	'이체신청완료시
	elseif szTranID == "obpds_srvc_038a" then
		Dim szData, ACNT, TACT_HOPE_DAY_CODE
		
		if g_TACT_ACNT_CLS_CODE == 1 then	'메리츠일때
			Dim PRCD
			PRCD					= Form.GetAccountInfo(acntList.total..acntList.sequence, "productcode")
			ACNT 				= "["..Form.GetMetaData("MTS상품코드", PRCD).."] "..MID(acntList.total,1,4).."-"..MID(acntList.total,5,4).."-"..acntList.sequence
			TACT_HOPE_DAY_CODE 	= cmbMeritz.cbkeydata
		else
			ACNT					= "["..g_szBankName.."] "..g_szBankAcno
			TACT_HOPE_DAY_CODE	= cmbOther.cbkeydata
		end if
		
		'계좌번호, 일련번호, 잔고일련번호, 펀드코드, 한글 종목명
		szData = "신청@"..g_szData & "★" & ACNT & "★" & edtMoney.caption & "★" & MID(cld0.caption,1,6) & MID(cld1.caption,1,6) & "★" & TACT_HOPE_DAY_CODE
		
		Form.OpenPopup("mbfnp51020_p9", szData, "")
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim ErrSub

	if szTranID == "obpds_srvc_038a" then
		ErrSub = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_038a" )
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	elseif szTranID == "obpds_srvc_417r" then
		ErrSub = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_417r" )
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	elseif szTranID == "obpds_srvc_416a" then
		ErrSub = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_416a" )
		Form.ShowAlert( "알림", szErrMsg & "(" & ErrSub & ")")
	end if
	
End Sub

