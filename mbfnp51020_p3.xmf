'============================================================================
' 자동이체기간 시작
'============================================================================
Sub cld0_OnEditComplete()
	
	if cld0.caption > cld1.caption or cld0.caption < g_szToday then
		Form.ShowAlert( "알림", "날짜를 확인하여 주십시오.")
		cld0.caption = g_szToday
		Exit Sub
	end if
	
End Sub

'============================================================================
' 자동이체기간 끝
'============================================================================
Sub cld1_OnEditComplete()
	
	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "날짜를 확인하여 주십시오.")
		cld1.caption = g_szToday
		Exit Sub
	end if
	
End Sub

'============================================================================
' 자동이체기간(1 ~ 5년)
'============================================================================
Sub cmbSortGb_OnEditComplete(iIndex)
	
	Select Case iIndex
		Case 0
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, nDay, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 1, -1, nDay, nHour, nMinute, nSecond ), 8)	'1년
		Case 1
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, nDay, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 2, -1, nDay, nHour, nMinute, nSecond ), 8)	'2년
		Case 2
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, nDay, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 3, -1, nDay, nHour, nMinute, nSecond ), 8)	'3년
		Case 3
			cld0.caption = Left(Form.calcDateTime( nYear , nMonth, nDay, nHour, nMinute, nSecond ), 8)
			cld1.caption = Left(Form.calcDateTime( 5, -1, nDay, nHour, nMinute, nSecond ), 8)	'5년
	End Select
	
End Sub

'============================================================================
' 메리츠계좌 자동이체일
'============================================================================
Sub cmbMeritz_OnEditComplete(iIndex)

	if iIndex ~= -1 then
		cmbMeritz.fgcolor = 144
	else
		cmbMeritz.fgcolor = 357
	end if
	
	f_btnSaveEnable()
End Sub

'============================================================================
' 타사계좌 자동이체일
'============================================================================
Sub cmbOther_OnEditComplete(iIndex)

	if iIndex ~= -1 then
		cmbOther.fgcolor = 144
	else
		cmbOther.fgcolor = 357
	end if
	
	f_btnSaveEnable()
End Sub

