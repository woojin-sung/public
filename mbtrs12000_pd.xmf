		<IMAGE name="imgTitle" autosize="1" imgpath="pop_header.9.png" ly_vert="0,0,309,55,1" />
		<LABEL name="lblText" caption="『자본시장과 금융투자업에 관한 법률 제46조 2(적합성의 원칙)』에 따라 고객님의 투자 목적 및 투자성향에 적합한 투자를 위해 워런트 상품에 투자할 시 투자성향진단 및 ELW 거래 약정 등록, 금융투자협회가 인정하는 교육이수 확인을 통해 거래가 가능합니다.
 고객님은 교육 대상자이므로 교육 이수 후 ELW거래를 재 신청하여 주시기 바랍니다." bgcolor="038:255255255" transmode="0" multiline="1" ly_vert="6,61,298,214,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="워런트 거래 신청 안내" bgcolor="064:197070070" halign="1" ly_vert="0,0,309,55,1" />
		<BUTTON name="btnClose" btnimage="alpha" ly_vert="254,5,45,45,1" />
		<IMAGE name="imgClose" autosize="1" imgpath="ic_pop_close.png" ly_vert="265,15,24,24,1" />
		<IMAGE name="imgEdu" imgpath="btn_pop2_n.9.png" ly_vert="0,290,309,45,1" />
		<LABEL name="lblEdu" fgcolor="128:188030030" fontsize="-1" caption="*금융투자협회 홈페이지에서 ELW교육을 이수하시기 바랍니다." multiline="1" ly_vert="0,290,309,45,1" />
	</CONTROL_INFO>
