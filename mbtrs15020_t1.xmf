'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 매매일지
' 02. 화면설명 : 매매일지 기간별 매매일지탭화면
' 03. 작    성 : 2016.04.30 LJS
'			   2022.07.29 이학록 v001. 기간별 매매일지 기능 추가 및 양식 변경, 가로 제거
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function RequestData()
	'DATAMANAGER.RequestTranData( "obtrs_cntg_534r" )
	'DATAMANAGER.RequestTranData( "obtrs_cntg_529r" )
	
	DATAMANAGER.RequestTranData( "obtrs_cntg_537r" )
	DATAMANAGER.RequestTranData( "obtrs_cntg_538r" )

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************acnt.total & "★" & acnt.sequence

'============================================================================
Sub Form_OnFormInitBefore()
	Dim bChkValue
	bChkValue = Form.LoadConfigData("mbtrs15020", "T1_ChkView")
	
	chkGrid.checkstate = bChkValue	
	
	chkGrid_OnChange( bChkValue )
	
	cboPrd_OnEditComplete(0)

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID) 
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
'	if szTranID = "obtrs_cntg_534r" then
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "IQRY_CLS_CODE"	, 0, "1"    )		'조회구분코드
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ACNO"			, 0, szACNO )		'계좌번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ASNO"			, 0, szASNO )		'계좌일련번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ETC_EXPN_INCU_YN", 0, "N" )		'기타비용포함여부
'		
'	elseif szTranID = "obtrs_cntg_529r" then
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_529r", "InBlock1", "ACNO"			, 0, szACNO )		'계좌번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_529r", "InBlock1", "ASNO"			, 0, szASNO )		'계좌일련번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_529r", "InBlock1", "ETC_EXPN_INCU_YN", 0, "N" )		'기타비용포함여부
'	end if
	
	if szTranID = "obtrs_cntg_537r" then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "ASNO" , 0 , szASNO )
		if chkGrid.checkstate = "1" then
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N" )
		end if
	elseif szTranID = "obtrs_cntg_538r" then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "ASNO" , 0 , szASNO )
		if chkGrid.checkstate = "1" then
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N" )
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" then
		RequestData()
	
'	ElseIf sEventName = "CHANGE_ORIENTATION" Then
'		Form.SetSharedData("15020_CldFrom"	, cldFrom.caption	)
'		Form.SetSharedData("15020_CldTo" 	, cldTo.caption	)
'		Form.SetSharedData("15020_chkGrid" 	, chkGrid.checkstate )
'		
'		Form.OpenPopup( "mbtrs15020_h1" , "" , "" )
	
	End If
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs15020", "T1_ChkView", chkGrid.checkstate )
End Sub


'============================================================================
Sub chkGrid_OnChange(sCheckState)
'	If sCheckState = "1" Then
'		grd1.visible = true
'		grd2.visible = false
'	Else
'		grd1.visible = false
'		grd2.visible = true
'	End If
	RequestData()
	
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbtrs15020" Then
		Dim szForm, szTo, szACCNO, szOldACCNO
		szForm 	= Form.GetSharedData( "15020_CldFrom"	, true  )
		szTo		= Form.GetSharedData( "15020_CldTo"		, true  )
		szACCNO	= Form.GetSharedData( "15020_ACCNO"		, true  )
		chkGrid.checkstate = Form.GetSharedData( "15020_chkGrid"	, true  )
		szOldACCNO = Form.GetCtlProp("#acnt0", "caption")
		
		If szOldACCNO <> szACCNO Then
			Form.SetCtlProp( "#acnt0", "caption", szACCNO )
		End If
		
		cldFrom.caption 	= szForm
		cldTo.caption		= szTo
		
		RequestData()
		
	End If
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	chkGrid.checkstate = "1"
	
	'v001
	'RequestData()
	cboPrd_OnEditComplete(0)
	
	'grd1.visible = false
	'grd2.visible = false
End Sub
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell12" then
		szTrDate = Grid0.GetCellData( "bd_cell0", lRow )
		Form.OpenFramePopup( "mbtrs15020_p2.xmf" , szTrDate+"!"+" "+"!"+chkGrid.checkstate, "" )
	end if
End Sub



'v001
'============================================================================
Sub cboPrd_OnEditComplete(iIndex)
	cldTo.todaymode = 1
	cldFrom.todaymode = 1
	
	if iIndex == 0 then		'당일
		'cldTo.todaymode = 1
		'cldFrom.todaymode = 1
	elseif iIndex == 1 then	'1주일
		cldFrom.addday = -7
	elseif iIndex == 2 then	'당월
		cldFrom.caption = mid(cldTo.caption, 1, 6) & "01"
	elseif iIndex == 3 then	'1개월
		cldFrom.addday = -30
	elseif iIndex == 4 then	'3개월
		cldFrom.addday = -30*3
	elseif iIndex == 5 then	'6개월
		cldFrom.addday = -30*6
	end if
	
	RequestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrs_cntg_538r" then
		for i = 0 to Grid0.rowcount - 1
			Grid0.setcellImage("bd_cell12", i, "btn_14_n.9")
			Grid0.SetCellData("bd_cell12", i, "상 세")
			Grid0.SetCellAttrColor("bd_cell12", i, "235")
			Grid0.SetCellFgColor("bd_cell12", i, "235")
		next
	end if
End Sub

