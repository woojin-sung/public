	<SCRIPT_INFO _len="4285" _ulen="3931" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 채권주문_매도확인창
' 02. 화면설명 : 채권주문 주문확인창
' 03. 작    성 : 2016.02.01 test3
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
'Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_MktType		' 시장구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SmtType		' 소액매매구분
Dim 	g_szOrd_OrdDate		' 매수일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim     g_nOrd_ChkTax           ' 과세구분 
'Dim 	g_nOrd_ChkAll			' 잔량전부	


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data()

	tblMaedo.SetCellString( 0, 1, g_szOrder_Acc.." "..g_szOrder_AccName 	)
'	tblMaedo.SetCellString( 0, 2, g_szOrder_AccName 	)
'	tblMaedo.SetCellString( 1, 1, g_szOrd_ItmCode	)
	tblMaedo.SetCellString( 1, 1, g_szOrd_ItmName 	)
	tblMaedo.SetCellString( 2, 1, g_szOrd_MktType	)
	tblMaedo.SetCellString( 4, 1, g_nOrd_Price		)
	tblMaedo.SetCellString( 3, 1, g_nOrd_Qty		)	
'	tblMaedo.SetCellString( 5, 1, g_szOrd_SmtType		)
	tblMaedo.SetCellString( 5, 1, g_szOrd_OrdDate )
	tblMaedo.SetCellString( 6, 1, g_nOrd_ChkTax )
	
	nOrd_Price = CDbl(g_nOrd_Price * 100)
	nOrdAmt = CDbl(nOrd_Price * g_nOrd_Qty / 1000)
	tblMaedo.SetCellString( 7, 1, nOrdAmt )
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	

	g_szOrder_MarketType	= arrData( 1)	' 시장종류 
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_SmtType  		= arrData( 6)	' 소액매매구분
	g_szOrd_SmtData 		= arrData( 7)	' 소액매매구분값
	g_szOrd_MktType 		= arrData( 8)	' 시장구분
	g_szOrd_OrdDate 		= arrData( 9)	' 매수일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkTax 		    = arrData(13)	' 과세구분
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	if Trim(szData) = "" then
		exit sub
	end if
	if Trim(g_szOrd_SmtType) = "동시매매" then
		g_szOrd_MktType = "소액시장(단일가)"
	end if
    Call Set_Data()
    
End Sub

'============================================================================
Sub btnSell_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )
End Sub

	</SCRIPT_INFO>
</ROOT>