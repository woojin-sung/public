'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 종목정보 팝업
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szItemName, g_szInnerMarket
Dim b_SaveFg
Dim g_SendItemCode
Dim g_szScreenNo	'CFD화면 추가
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function Set_Table()
	Dim nROE, nDebtrate, nNetincome, szScalecode
	Dim nTraceindex, szPublishname, szManagername
	Dim nMagnirate, szTaxtype, szBasename, szLpcode, szLpenddate, szExpireddate, nEventprice
	Dim szLaunchdate, szEnddate, nEtfkind, szetpgroup, szTaxtypecd
		
	nROE			= Form.GetItemCodeInfo( g_szItemCode, "roe"			)	'자기자본이익율
	nDebtrate	= Form.GetItemCodeInfo( g_szItemCode, "debtrate" 		)	'부채비율
	nNetincome	= Form.GetItemCodeInfo( g_szItemCode, "netincome" 	)	'당기순이익
	nTraceindex	= Form.GetItemCodeInfo( g_szItemCode, "traceindex" 	)	'추적지수
	szPublishname	= Form.GetItemCodeInfo( g_szItemCode, "publishname" 	)	'발행사
	szManagername	= Form.GetItemCodeInfo( g_szItemCode, "managername" 	)	'운영사
	nMagnirate	= Form.GetItemCodeInfo( g_szItemCode, "magnirate" 	)	'배율
	szBasename	= Form.GetItemCodeInfo( g_szItemCode, "basename" 		)	'기초자산명
	szLpcode		= Form.GetItemCodeInfo( g_szItemCode, "lpcode" 		)	'LP코드
	szLpenddate	= Form.GetItemCodeInfo( g_szItemCode, "lpenddate" 	)	'LP종료일
	szExpireddate	= Form.GetItemCodeInfo( g_szItemCode, "expireddate" 	)	'최종거래일
	nEventprice	= Form.GetItemCodeInfo( g_szItemCode, "eventprice" 	)	'행사가
	nTaxprice	= Form.GetItemCodeInfo( g_szItemCode, "taxprice"		)	'과표기준가격
	szTaxtypecd	= Form.GetItemCodeInfo( g_szItemCode, "taxtype"		)	'과표유형기준
	szLaunchdate	= Form.GetItemCodeInfo( g_szItemCode, "launchdate"	)	'상장일자
	szEnddate	= Form.GetItemCodeInfo( g_szItemCode, "enddate"		)	'만기일자
'	nEtfkind		= Form.GetItemCodeInfo( g_szItemCode, "etfkind"		)	'ETF상품유형에 따른 구분코드 (2,3이 아니면 면세)  사용안함.
	szetpgroup	= Form.GetItemCodeInfo( g_szItemCode, "etpgroup"		)	'기초자산구분 이름 가져오기	
	
	szLpName		= Form.GetItemCodeInfo( szLpcode	, "lpname" 		)	'LP명
	
	'시가총액규모 (0:제외, 1:대, 2:주, 3:소)
	Select Case Form.GetItemCodeInfo( g_szItemCode, "scalecode" )
		Case "0"	szScalecode = "제외"
		Case "1"	szScalecode = "대형주"
		Case "2"	szScalecode = "중형주"
		Case "3"	szScalecode = "소형주"
		Case Else szScalecode = ""
	End Select
	
	'과세유형(0:해당없음 1:증권거래세 2:배당소득세(보유기관과세) 3:증권거래세(회사형ETF)
	Select Case Form.GetItemCodeInfo( g_szItemCode, "taxtype" )	
		Case "0"	szTaxtype = "해당없음"
		Case "1"	szTaxtype = "증권거래세"
'		Case "2"	szTaxtype = "배당소득세(보유기관과세)"
		Case "2"	szTaxtype = "배당소득세"
'		Case "3"	szTaxtype = "증권거래세(회사형ETF)"
		Case "3"	szTaxtype = "증권거래세"
		Case Else szTaxtype = ""
	End Select
	
	If contInfo.tblStock.visible = True Or contInfo.tblStock.visible = "1" Then
		'20170717_02 KBC START
		if g_szInnerMarket = "001" Then		
			contInfo.tblStock.SetCellString(0, 3, "거래소")
			
			Select Case Form.GetItemCodeInfo( g_szItemCode, "scalecode" )
				Case "0"	szScalecode = "제외"
				Case "1"	szScalecode = "대형주"
				Case "2"	szScalecode = "중형주"
				Case "3"	szScalecode = "소형주"
				Case Else szScalecode = ""
			End Select			
			
		elseif g_szInnerMarket = "002" Then		
			contInfo.tblStock.SetCellString(0, 3, "코스닥")
			
			Select Case Form.GetItemCodeInfo( g_szItemCode, "scalecode" )
				Case "0"	szScalecode = "제외"
				Case "1"	szScalecode = "KSQ100"
				Case "2"	szScalecode = "KSQmid300"
				Case "3"	szScalecode = "KSQsmall"
				Case Else szScalecode = ""
			End Select
		else
			contInfo.tblStock.SetCellString(0, 3, "")
			szScalecode = ""
		end if
		
		'contInfo.tblStock.SetCellString(0, 3, "거래소"		)
		'20170717_02 KBC END		
		
		contInfo.tblStock.SetCellString(0, 5, szScalecode		)	'시가총액규모
		contInfo.tblStock.SetCellString(4, 1, nNetincome		)	'당기순이익
		contInfo.tblStock.SetCellString(3, 4, nROE			)	'자기자본이익율
		contInfo.tblStock.SetCellString(4, 4, nDebtrate		)	'부채비율
		
	ElseIf contInfo.tblETF.visible = True Or contInfo.tblETF.visible = "1" Then
		contInfo.tblETF.SetCellString( 1, 1, szetpgroup 		)	'기초자산명
		contInfo.tblETF.SetCellString( 2, 1, nTraceindex		)	'추적지수
		contInfo.tblETF.SetCellString( 3, 1, szManagername	)	'운영사		
		contInfo.tblETF.SetCellString( 2, 3, nMagnirate 		)	'배율

		If szTaxtypecd = "2" Or szTaxtypecd = "3" Then
			contInfo.tblETF.SetCellString( 4, 1, szTaxtype 		)	'과세유형
			contInfo.tblETF.SetCellString( 4, 3, nTaxprice		)	'과세			
			contInfo.tblETF.SetCellMaskInfo( 4, 3, "0,0,,,1,,2,1,1")			
		Else			
			If szTaxtype <> "" and szTaxtype <> null Then
				contInfo.tblETF.SetCellString( 4, 1, szTaxtype & " 면제"	)	'과세유형
			End If
			
			contInfo.tblETF.SetCellString( 4, 3, " 면제"		)	'과세		
			contInfo.tblETF.SetCellMaskInfo( 4, 3, "1,0,,,1,,2,0,1")
		End If
		
	ElseIf contInfo.tblELW.visible = True Or contInfo.tblELW.visible = "1" Then
		contInfo.tblELW.SetCellString( 1, 1, szBasename 	)	'기초자산명
		contInfo.tblELW.SetCellString( 2, 1, szPublishname 	)	'발행사
		contInfo.tblELW.SetCellString( 3, 1, szLpenddate 	)	'LP종료일
		contInfo.tblELW.SetCellString( 4, 1, szExpireddate 	)	'최종거래일
		
		contInfo.tblELW.SetCellString( 2, 3, szLpName 		)	'LP코드
		contInfo.tblELW.SetCellString( 4, 3, nEventprice 	)	'행사가
	
	ElseIf contInfo.tblKONEX.visible = True Or contInfo.tblKONEX.visible = "1" Then
		contInfo.tblKONEX.SetCellString( 4, 1, nNetincome 	)	'당기순이익
		contInfo.tblKONEX.SetCellString( 3, 3, nROE 		)	'자기자본이익율
		contInfo.tblKONEX.SetCellString( 4, 3, nDebtrate 	)	'부채비율
		
	ElseIf contInfo.tblETN.visible = True Or contInfo.tblETN.visible = "1" Then
		contInfo.tblETN.SetCellString( 1, 1, szetpgroup 	)	'기초자산명
		contInfo.tblETN.SetCellString( 2, 1, nTraceindex	)	'추적지수
		contInfo.tblETN.SetCellString( 3, 1, szPublishname 	)	'발행사
		contInfo.tblETN.SetCellString( 4, 1, szLaunchdate	)	'상장일자
		
		contInfo.tblETN.SetCellString( 2, 3, nMagnirate 	)	'배율
		contInfo.tblETN.SetCellString( 4, 3, szEnddate	 	)	'만기일자
			
	End If

End Function


Function Set_Grid()
	Dim szData, arrData, nCnt		
	
	'20160427 LKM START
'	Dim szScreenNo
'	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	'20160427 LKM END
	
	If g_szScreenNo = "12030" Then
		szData = Form.GetRecentHistory( "1:3:4" )
	'20210823 HSZ START : CFD현재가,주문화면 추가
	ElseIf g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		szData = Form.GetRecentHistory("40")
	'20210823 HSZ END
	Else
		szData = Form.GetRecentHistory( "1:3:4:5" )
	End If
	
	arrData = Split(szData,"`")
	
	if UBOUND(arrData) < 1 then
		If Trim(szData) <> "" Then
			szItemName = Form.GetItemCodeInfo( szData , "name")
			
			contInfo.grd0.insertrow = 0
			
			contInfo.grd0.SetCellData( "bd_cell0" , 0, szData )
			contInfo.grd0.SetCellData( "bd_cell1" , 0, szItemName )
		End If
	Else
	
		For i = #arrData - 1 To 0 Step -1
			Dim szItemCode, szItemName
			szItemCode = arrData(i)
			
			If Trim(szItemCode) <> "" Then
				szItemName = Form.GetItemCodeInfo( szItemCode , "name")
				
				contInfo.grd0.insertrow = 0
				
				contInfo.grd0.SetCellData( "bd_cell0" , 0, szItemCode )
				contInfo.grd0.SetCellData( "bd_cell1" , 0, szItemName )
			End If
		Next
	End If
	
End Function

Function Init( nIdx )
	If nIdx = 0 Then
	
		contInfo.tblStock.visible	= False
		contInfo.tblETF.visible	= False
		contInfo.tblKONEX.visible	= False
		contInfo.tblELW.visible 	= False
		contInfo.tblETN.visible 	= False
		contInfo.tblKOTC.visible 	= False	'20180712 HAMWG : K-OTC MTS 도입

		If g_szItemMarket = "J" Then									'주식
			
			If g_szInnerMarket = "013" Then								'ETF
				contInfo.tblETF.visible	= True
				contInfo.tblETF.SetCellString( 0, 1, g_szItemName)
			
			ElseIf g_szInnerMarket = "033" Then							'KONEX
				contInfo.tblKONEX.visible	= True
				contInfo.tblKONEX.SetCellString( 0, 1, g_szItemName)
			Else														'주식
				contInfo.tblStock.visible	= True
				contInfo.tblStock.SetCellString( 0, 0, g_szItemName)
			End If
		
		ElseIf g_szItemMarket = "Q" Then 								'ETN
			contInfo.tblETN.visible 		= True
			contInfo.tblETN.SetCellString( 0, 1, g_szItemName)
		
		ElseIf g_szItemMarket = "W" Then 								'ELW
			contInfo.tblELW.visible 		= True
			contInfo.tblELW.SetCellString( 0, 1, g_szItemName)
			
		'20180712 HAMWG START : K-OTC MTS 도입
		ElseIf g_szItemMarket = "T" Then 								'KOTC
			contInfo.tblKOTC.visible 		= True
			contInfo.tblKOTC.SetCellString( 0, 1, g_szItemName)
		'20180712 HAMWG END
		
		End If
		
		contInfo.Image0.visible		= true
		contInfo.btnReport.visible		= true
		contInfo.btnMemoSave.visible	= true		
		contInfo.edtMemo.visible		= true
		
		contInfo.grd0.visible			= false		
		contInfo.btnDeleteAll.visible	= false
	Else
		'20211029 아이티젠(김성수) 현재가 개선 START
		contInfo.scroll_pos = "top"
		contInfo.btnClose0.height = "83"
		contInfo.SetScrollAutoSize()
		'20211029 아이티젠(김성수) 현재가 개선 End
		
		contInfo.tblStock.visible		= false
		contInfo.tblELW.visible		= false
		contInfo.tblETF.visible		= false
		contInfo.tblETN.visible		= false
		contInfo.tblKONEX.visible		= false
		contInfo.tblKOTC.visible 		= false	'20180712 HAMWG : K-OTC MTS 도입
		
		contInfo.edtMemo.visible		= false
		contInfo.Image0.visible		= false
		contInfo.btnReport.visible		= false
		contInfo.btnMemoSave.visible	= false		
		contInfo.edtMemo.visible		= false
		
		contInfo.grd0.visible			= true
		contInfo.btnDeleteAll.visible	= true
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	
	'20210823 HSZ START : CFD현재가,주문화면 추가
	If g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		g_szItemCode   =  Form.GetSharedData( "&ITEM_STOCK_CFD", 0 )
	'20210823 HSZ END
	Else
		g_szItemCode   =  Form.GetSharedData( "&ITEM_STOCK", 0 )
	End if
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")
	g_szInnerMarket= Form.GetItemCodeInfo(g_szItemCode, "innermarket")


End Sub

'============================================================================
Sub Form_OnFormInit()
	b_SaveFg = false
	
	contInfo.tblStock.left = 6
	contInfo.tblETF.left 	= 6
	contInfo.tblETN.left 	= 6
	contInfo.tblELW.left 	= 6
	contInfo.tblKONEX.left	= 6
	contInfo.tblKOTC.left	= 6	'20180712 HAMWG : K-OTC MTS 도입

	contInfo.tblStock.top	= 48
	contInfo.tblETF.top 	= 48	
	contInfo.tblETN.top	= 48
	contInfo.tblELW.top 	= 48
	contInfo.tblKONEX.top	= 48
	contInfo.tblKOTC.top	= 48	'20180712 HAMWG : K-OTC MTS 도입
	
	Init( 0 )
	Set_Table()
	Set_Grid()

	DATAMANAGER.RequestTranData( "ohhts_memo_013r" )	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	If szTranID = "ohhts_memo_013r" Then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false )
	
		If b_SaveFg = false Then
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" 		, 0 , g_szItemCode )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" 			, 0 , "" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , g_szItemMarket )
		
		Else
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
			
			If Trim(contInfo.edtMemo.caption) = "" Then
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "5" )
			Else
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "3" )
			End If
			
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" 		, 0 , g_szItemCode )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" 			, 0 , g_szItemName )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , g_szItemMarket )
		
		End If
		
	ElseIf szTranID = "ohhts_1001_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)
		
	End If
	' 20210622 HWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	If szTranID = "ohhts_memo_013r" Then
		If b_SaveFg = True Then
			b_SaveFg = False
			DATAMANAGER.RequestTranData( "ohhts_memo_013r" )
		End If
	' 20210622 HWG END
	ElseIf szTranID = "ohhts_1001_001r" Then
		
	End If	
	
End Sub

'============================================================================
Sub contInfo_btnClose0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contInfo_btnDeleteAll_OnClick()
	'20231130 HSZ START: 최근조회 삭제 시, 세팅했던 타입만 지정하여 삭제
'	Form.DelAllHistory()
	If g_szScreenNo = "12030" Then
		szData = Form.delRecentHistoryType( "1:3:4" )
	ElseIf g_szScreenNo = "13100" or g_szScreenNo = "13200" then	'CFD현재가/주문
		szData = Form.delRecentHistoryType("40")
	Else
		szData = Form.delRecentHistoryType( "1:3:4:5" )
	End If
	'20231130 HSZ END
	
	contInfo.grd0.rowcount = 0
End Sub

'============================================================================
Sub contInfo_grd0_OnClickUp(lRow, szCellID)
	If szCellID = "bd_cell2" Then
		Dim szItemCode
		
		szItemCode = contInfo.grd0.GetCellData( "bd_cell0", lRow)
		Form.DelRecentHistory( szItemCode )
		
		contInfo.grd0.rowcount = 0
		
		Set_Grid()
		
	Else
		g_SendItemCode = contInfo.grd0.GetCellData( "bd_cell0", lRow)
		Form.CloseForm()
	End If
End Sub

''============================================================================
'Sub contInfo_rdoType_OnClick(nIndex)
'	Init( Cint(nIndex) )
'
'End Sub

'============================================================================
Sub Form_OnFormClose()
	If g_SendItemCode = "" Or g_SendItemCode = null Then
		Form.SendReturnToParent("11000_p1_Close" , "종목없음" )
	Else
		Form.SendReturnToParent("11000_p1_Close" , g_SendItemCode )
	End If
End Sub

'============================================================================
Sub contInfo_btnMemoSave_OnClick()
	If Trim(contInfo.edtMemo.caption) = "" Then
'		Form.ShowAlert("알림", "저장할 메모내용이 없습니다.")
'		Exit Sub
		
		Form.SetMemoVisible("0")
	Else
		Form.SetMemoVisible("1")
	End If
	
	b_SaveFg = True
	DATAMANAGER.RequestTranData( "ohhts_memo_013r" )	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
End Sub

'============================================================================
Sub contInfo_btnReport_OnClick()
	Form.OpenFramePopup("mhprc11000_p4" , g_szItemCode & "|" & g_szItemMarket & "|" &  g_szItemName , sPosInfo)	
End Sub

