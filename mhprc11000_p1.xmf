	contInfo.btnClose0.height = 217
	contInfo.SetScrollAutoSize()
	contInfo.scroll_pos = 130
	
End Sub

'============================================================================
Sub contInfo_edtMemo_OnEditComplete()
	contInfo.scroll_pos = "top"
	contInfo.btnClose0.height = 83
	contInfo.SetScrollAutoSize()
	
End Sub
