'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "getGtsHogaDetail"	then
		Dim nClose, nLow, nHigh, nOpen, nPask, nPbid, nUppe, nLowp
		nClose = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "last" , 0)
		nLow = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "low" , 0)
		nHigh = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "high" , 0)
		nOpen = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "open" , 0)
		nPask = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "pask" , 0)
		nPbid = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "pbid" , 0)
		nUppe = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "uppe" , 0)
		nLowp = DATAMANAGER.GetDataValue(false, "getGtsHogaDetail", "price", "lowp" , 0)
		
		if nClose < nLow	then
			Container0.Table0.SetCellFgColor(2, 1, "1")
		elseif nClose > nLow	then
			Container0.Table0.SetCellFgColor(2, 1, "2")
		else
			Container0.Table0.SetCellFgColor(2, 1, "3")
		end if
		if nClose < nHigh	then
			Container0.Table0.SetCellFgColor(1, 1, "1")
		elseif nClose > nHigh	then
			Container0.Table0.SetCellFgColor(1, 1, "2")
		else
			Container0.Table0.SetCellFgColor(1, 1, "3")
		end if
		if nClose < nOpen	then
			
			Container0.Table0.SetCellFgColor(0, 1, "1")
		elseif nClose > nOpen	then
			
			Container0.Table0.SetCellFgColor(0, 1, "2")
		else
			
			Container0.Table0.SetCellFgColor(0, 1, "3")
		end if

		if nClose < nUppe	then
			Container0.Table0.SetCellFgColor(0, 4, "1")
		elseif nClose > nUppe	then
			Container0.Table0.SetCellFgColor(0, 4, "2")
		else
			Container0.Table0.SetCellFgColor(0, 4, "3")
		end if
		if nClose < nLowp	then
			Container0.Table0.SetCellFgColor(1, 4, "1")
		elseif nClose > nLowp	then
			Container0.Table0.SetCellFgColor(1, 4, "2")
		else
			Container0.Table0.SetCellFgColor(1, 4, "3")
		end if
	end if
End Sub

'============================================================================
' 숫자를 거래소 ID로 변환
'============================================================================
Function Transform_Code(sValue)
	if sValue == "HKS"	then
		return "104"
	elseif sValue == "HSI"	then
		return "529"
	elseif sValue == "SHS"	then
		return "215"
	elseif sValue == "SZS"	then
		return "214"
	elseif sValue == "NYS"	then
		return "312"
	elseif sValue == "AMX"	then
		return "66"
	elseif sValue == "NAS"	then
		return "537"
	elseif sValue =="NAO"	then
		return "130"
	elseif sValue == "SPI"	then
		return "625"
	elseif sValue == "DJI"	then
		return "310"
	elseif sValue == "TSE"	then
		return "106"
	elseif sValue == "OSE"	then
		return "107"
	elseif sValue == "JSD"	then
		return "112"
	elseif sValue == "NII"	then
		return "889"
	elseif sValue == "NAI"	then
		return "538"
	elseif sValue == "HSX"	then
		return "770"
	elseif sValue == "HNX"	then
		return "771"
	end if
end function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CLOSE_FORM"	then
		Form.CloseForm( )
	end if 
End Sub

