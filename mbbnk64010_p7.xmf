	'특수문자체크 : "/  -  ?  :  (  )  ,  .  ‘  +" 만 가능!!
	Str_Chk(contA.lblNm2.caption)

	if g_bEngNm = False then
		g_szResult = "N"	
		g_szEngRmtName = contA.lblNm2.caption
		
		Form.MsgBox("알림", "해당 특수 문자만 입력 가능합니다.\n/  -  ?  :  (  )  ,  .  ‘  +", "", 6)
'		contA.btnOK.btnimage = "btn_15.9"
'		contA.btnOK.enable = false
		Exit Sub
	else
		'정상
		
		'V001 본인인 경우에만 이 pop으로 호출되므로.. 굳이 추가체크하지 않음.
		' 특수문자 체크는 Str_Chk 에서 수행하므로... 이 부분 skip..
		'if g_szScreenNo == "61140" and g_szIF_KOR_USE_INFO == "Y" then'이체계좌관리
		'	DATAMANAGER.RequestTranData( "obpds_srvc_186r" )
		'else
			g_szResult = "Y"
			g_szEngRmtName = contA.lblNm2.caption
			
			Form.CloseForm()
		'end if
	End If
End Sub

'============================================================================
Sub contA_ImgPrcreset_OnClick()
	'영문키패드
	'Form.OpenPopupAnimation("textkeypadpopup", "받는분 확인☆☆받는 분 영문명 입력☆1☆11" , "","2")
	Form.OpenPopupAnimation("textkeypadpopup", "받는분 확인☆☆받는 분 영문명 입력☆1☆30" , "","2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "POPUP_TEXT" then	'영문키패드
		If Trim(sRet) == "" Then
			return
		else
			contA.lblNm2.caption = sRet
			Str_Chk(contA.lblNm2.caption)
			
			if g_bEngNm = False then
				Form.MsgBox("알림", "해당 특수 문자만 입력 가능합니다.\n/  -  ?  :  (  )  ,  .  ‘  +", "", 6)
					
		'		contA.btnOK.btnimage = "btn_15.9"
		'		contA.btnOK.enable = false
				Exit Sub
			else
				'정상
				g_szResult = "Y"	
				g_szEngRmtName = sRet
			End If
		End If
	end if
End Sub

'============================================================================
' Str_Chk(str) : 입력된 영문명 유효성 체크
'============================================================================
Function Str_Chk(str)	
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수문자 체크(입력 가능)
	dim chk_t2						'특수문자 체크(입력 불가능)
    
	chk_n = 0
	chk_c = 0
	chk_t = 0
	chk_t2 = 0
    
	g_bEngNm = False

	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
    
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
	    '
	    ''입력가능한 특수문자
	    '' Space : 32
	    '' / : 47
	    '' - : 45
	    '' ? : 63
	    '' : : 58
	    '' ( : 40
	    '' ) : 41
	    '' , : 44
	    '' . : 46
	    '' ` : 39
	    '' + : 43
	    If   (nAscii >=48 and nAscii <=57) Then
		    '숫자 통과!
		    chk_n = 1 
		
	    ElseIf   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    '영문 대/소문자 통과!
		    chk_c = 1 
		
	    Elseif   (nAscii = 32 or nAscii = 47 or nAscii = 45 or nAscii = 63 or nAscii = 58 or nAscii = 40 or nAscii = 41 or nAscii = 44 or nAscii = 46 or nAscii = 43) then
		    '입력가능한 특수문자 통과!
		    chk_t =  1
	    
	    Elseif	(g_szOsType = "1" and nAscii = 39) then
		    '입력가능한 특수문자 통과! (특수문자 '가 OS별로 Ascii가 달라서 분기처리함)
		    chk_t =  1
	    
	    Elseif	(g_szOsType = "2" and (nAscii = -104 or nAscii = -128 or nAscii = -30 or nAscii = -103 or nAscii = 39)) then
		    	

		    '입력가능한 특수문자 통과! (특수문자 '가 OS별로 Ascii가 달라서 분기처리함)
		    chk_t =  1
		    
	    Else
		    '그 외 문자는 불가!!!
		    chk_t2 =  1

	    End if
	Next

	If  (chk_t2 = 1) Then	'입력 불가능한 특수문자가 들어온 경우 Stop!!!
		g_bEngNm = False
		Exit Function
	End if

	g_bEngNm = True
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	If szTranID == "obtsd_fbnk_121r" then
		if g_szBankCode = "287" then
			szTACT_LNKD_ISTU_CODE = "287"
		else
			szTACT_LNKD_ISTU_CODE = "702"
		end if
		
		'V001
		if g_szScreenNo == "61140" then'이체계좌관리
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "PROS_CLS_CODE"      , 0 , "3")	'처리구분코드 (3.약정에서 수취조회)
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "PROS_CLS_CODE"      , 0 , "1")	'처리구분코드 (1.수취조회)
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ACNO"                    , 0 , g_szACNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ASNO"                    , 0 , g_szASNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "TACT_LNKD_ISTU_CODE"     , 0 , szTACT_LNKD_ISTU_CODE)	'이체연계기관코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BANK_CODE"               , 0 , g_szBankCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BANK_ACNO"               , 0 , g_szBankAcno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CRCD"                    , 0 , g_szCurrencyCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "FRCR_TR_AMT"             , 0 , g_nSendAmt)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "RRNO"                    , 0 , Form.GetSharedData("&RET_RSNO", False))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BIC_CODE"                , 0 , g_szBicCode)				
	elseIf szTranID == "obpds_srvc_186r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "PROS_CLS_CODE"                , 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CSNO"            		    , 0 , Form.GetSharedData("61140_Csno", False))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CUST_ENG_NAME"                , 0 , g_121InputName)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID == "obtsd_fbnk_121r" then	
		szAPLT_SRNO 				= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "APLT_SRNO" , 0)
		szENG_RMT_NAME 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ENG_RMT_NAME" , 0)		'영문수취인명
		szCUST_ENG_NAME 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_ENG_NAME" , 0)		'고객영문명
	
		szRSPN_CODE	 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" , 0)			'응답코드
		szRSPN_MSG_CNTT 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" , 0)		'응답메시지내용
		
		szSELF_ACNT_YN 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SELF_ACNT_YN" , 0)		'본인계좌여부
		szIF_KOR_USE_INFO 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_KOR_USE_INFO" , 0)		'IF한글사용정보
		szFEE 					= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FEE" , 0)				'수수료
		szSELF_ACNT_YN			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SELF_ACNT_YN" , 0)		'본인계좌여부
		
		g_szENG_RMT_NAME = szENG_RMT_NAME
		g_szIF_KOR_USE_INFO = szIF_KOR_USE_INFO
		Form.SetSharedData("64010_Fee", cint(szFEE))

		Dim sCode 
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "3070" then '잘못된 계좌 입력시 에러!
			if szRSPN_CODE = "0012" then '외화 입금이 불가한 계좌입니다.\n받는 계좌를 다시 확인해주세요.
				Form.MsgBox("알림", szRSPN_MSG_CNTT, "", 6)
				
				g_szResult = "N"
				Form.CloseForm()
				Exit Sub			
			else
				g_szResult = "N"
				g_szEngRmtName = szENG_RMT_NAME
				
				contB.visible = true
				contB.lblName.caption = szENG_RMT_NAME
				contB.lblResult2.caption = szRSPN_MSG_CNTT
				contB.lblResult2.fgcolor = "6"
				
				Exit Sub			
			end if
		end if
		
		if g_szScreenNo == "61140" then'이체계좌관리

			if szSELF_ACNT_YN == "N" then 'or szSELF_ACNT_YN = "S" then
				Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "61140_CLOSE_MSG", 6)
				Exit Sub
			end if

			if szIF_KOR_USE_INFO = "Y" then'명의가 한글
				g_szResult = "N"
				g_szEngRmtName = szCUST_ENG_NAME
				g_121InputName = szCUST_ENG_NAME
				
				contA.visible = true
				contA.imgNm1.imgpath = "bg_infobox.9.png"
				contA.lblNm1.caption = szENG_RMT_NAME
				contA.imgNm2.imgpath = "btn_line_n.9.png"
				contA.lblNm2.caption = szCUST_ENG_NAME
				contA.ImgPrcreset.visible = true
				contA.lblResult.caption = "수취 조회 결과는 영문명으로 변경 후 진행됩니다."
				
'				Exit Sub
				
			elseif szIF_KOR_USE_INFO = "N" then	'정상
				g_szResult = "Y"
				g_szEngRmtName = szENG_RMT_NAME
				g_121InputName = szENG_RMT_NAME
				
'				contB.visible = true
'				contB.lblName.caption = szENG_RMT_NAME
				contA.visible = true
				contA.imgNm1.imgpath = "bg_infobox.9.png"
				contA.lblNm1.caption = szENG_RMT_NAME
				contA.imgNm2.imgpath = "btn_line_n.9.png"
				contA.lblNm2.caption = szENG_RMT_NAME
				contA.ImgPrcreset.visible = true
				
				DATAMANAGER.RequestTranData( "obpds_srvc_186r" )
				
'				Exit Sub
			end if		
			
		else
			if szSELF_ACNT_YN = "Y" or szSELF_ACNT_YN = "S" then	'정상
				
				if szIF_KOR_USE_INFO = "Y" then	'이체 불가
					g_szResult = "N"
					g_szEngRmtName = szCUST_ENG_NAME
					
					contA.visible = true
					contA.imgNm1.imgpath = "bg_infobox.9.png"
					contA.lblNm1.caption = szENG_RMT_NAME
					contA.imgNm2.imgpath = "btn_line_n.9.png"
					contA.lblNm2.caption = szCUST_ENG_NAME
					contA.ImgPrcreset.visible = true
					contA.lblResult.caption = "수취 조회 결과는 영문명으로 변경 후 진행됩니다."
					
					Exit Sub
					
				elseif szIF_KOR_USE_INFO = "N" then	'정상
					g_szResult = "Y"
					g_szEngRmtName = szENG_RMT_NAME
					
					contB.visible = true
					contB.lblName.caption = szENG_RMT_NAME
					contB.lblResult2.caption = "본인 확인이 완료되었습니다."
					
					Exit Sub
					
				end if			
				
			elseif szSELF_ACNT_YN = "N" then	'이체 불가
				g_szResult = "N"
				g_szEngRmtName = szENG_RMT_NAME
				
				contB.visible = true
				contB.lblName.caption = szENG_RMT_NAME
				contB.lblResult2.caption = "본인명의 계좌로만 이체 가능합니다."
				contB.lblResult2.fgcolor = "6"
				
				Exit Sub
				
			end if
		end if
		
	ElseIf szTranID == "obpds_srvc_186r" then	'이체계좌관리화면용 TR
		szIF_SPEC_LETT_USE_INFO = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "IF_SPEC_LETT_USE_INFO" , 0 )
		
		if szIF_SPEC_LETT_USE_INFO == "Y" then
			g_szResult = "N"
			Form.MsgBox("알림", "해당 특수 문자만 입력 가능합니다.\n/  -  ?  :  (  )  ,  .  ‘  +", "", 6)
		else
			g_szResult = "Y"	
			g_szEngRmtName = contA.lblNm2.caption
		
			if g_szIF_KOR_USE_INFO == "Y" then
				Form.CloseForm()
			else
				contA.lblResult.caption = "본인 확인이 완료되었습니다."
			end if
		end if
	End If	
End Sub

