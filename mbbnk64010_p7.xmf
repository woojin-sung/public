'============================================================================
' 화 면 명 : 외화이체 수취인조회
'============================================================================
' V001 2024-02-01 이체계좌관리-외화이체계좌등록인 경우 처리구분값 수정
'============================================================================

Dim g_szResult	'이체가능상태인지 아닌지

Dim g_szACNO
Dim g_szASNO
Dim g_szBankCode
Dim g_szBankAcno
Dim g_szBicCode
Dim g_szCurrencyCode
Dim g_nSendAmt

Dim g_szEngRmtName	'수취인 영문명
Dim g_szCsno,g_szENG_RMT_NAME
Dim g_121InputName, g_szIF_KOR_USE_INFO

Dim g_szScreenNo
Dim g_szOsType

'============================================================================
Sub Form_OnFormInit()
	g_szScreenNo = Form.GetSharedData("&SCREEN_NO" , false)
	g_szOsType   = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	f_InitValue()
	
	szData = Form.GetOpenLinkData( )
	
	if szData ~= "" and szData ~= "" then
		tOpenData = Split(szData, "★")
	
		'출금계좌번호★출금계좌순번★입금은행코드★입금은행계좌★입금은행BIC코드★통화코드★출금액
		g_szACNO			= tOpenData[0]
		g_szASNO			= tOpenData[1]
		g_szBankCode		= tOpenData[2]
		g_szBankAcno		= tOpenData[3]
		g_szBicCode		= tOpenData[4]
		g_szCurrencyCode	= tOpenData[5]
		g_nSendAmt        = tOpenData[6]
		g_szCsno = Form.GetSharedData("61140_Csno", false )
		
		DATAMANAGER.RequestTranData("obtsd_fbnk_121r")	'외화송금 예금주명조회		
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("64010_EngRmtName", g_szEngRmtName)	'고객영문명
	
	Form.SendReturnToParent( "mbbnk64010_p7" , g_szResult)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	g_szResult = "Cancel"
	g_szEngRmtName = ""
	
	Form.CloseForm()
End Sub

'============================================================================
Sub f_InitValue()
	g_szResult = "N"	
	g_szEngRmtName = ""
End Sub

'============================================================================
