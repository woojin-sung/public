Sub contB_btnOK2_OnClick()
'	'정상
'	g_szResult = "Y"
'	g_szEngRmtName = contB.lblName.caption
	if g_szScreenNo == "61140" then
		g_szEngRmtName = contB.lblName.caption
	end if
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
    If szSubErr == "" Then
        Form.MsgBox( "알림", szErrMsg, "", 6 )
    Else
        'Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )		
		Form.MsgBox( "알림", szSubErr, "", 6 )
    End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "61140_CLOSE_MSG" then
		g_szResult = "Cancel"
		g_szEngRmtName = ""
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	g_szResult = "Cancel"
	g_szEngRmtName = ""
	Form.CloseForm()
End Sub

