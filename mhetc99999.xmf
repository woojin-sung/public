	<SCRIPT_INFO _len="4819" _ulen="4623" >
Dim g_mSBVer, g_OTPKEY1, g_OTPKEY2, g_TFserialNum

'============================================================================
Sub Form_OnFormInit()

	g_OTPKEY1 = "00000000000000000000000000000000746A13FAAD0809671166D3D07FC130F6"
	g_OTPKEY2 = "000000000000000000000000000000004CA9BFD838FA2C8393006255441A2EEE"
	g_TFserialNum = "512001000000001"
	
	Table0.visible = false
	
End Sub
'============================================================================
Sub Button2_OnClick()
	Form.requestMOTP("MOTP_GETINFO", "" , "99999")
End Sub
'============================================================================
Sub Button3_OnClick()
	szData = g_TFserialNum & "★" & g_OTPKEY1 & "★" & g_OTPKEY2
	Form.requestMOTP("MOTP_ISSUE",szData,"99999")
End Sub

'============================================================================
Sub Button4_OnClick()
	Form.requestMOTP("MOTP_DISCARD", g_TFserialNum , "99999")
End Sub
'============================================================================
Sub Button5_OnClick()
	'Form.requestMOTP("MOTP_REQ_OTP", "" , "99999")
	szData = "512001000000001" & "★" & "02010" & "★" & "20D34A4DD02CC1F1249C0453D8BB4967" & "★" & "2CF24DBA5FB0A30E26E83B2AC5B9E29E1B161E5C1FA7425E73043362938B9824"
	Form.requestMOTP("MOTP_REQ_OTP", szData , "99999")
	
End Sub

'============================================================================
Sub Button6_OnClick()
	Form.requestMOTP("MOTP_GET_VERSION", "" , "99999")
End Sub

'============================================================================
Sub Button7_OnClick()
	'Form.requestMOTP("MOTP_REQ_OTP_ENC", "" , "99999")
	szData = "512001000000001" & "★" & "02010" & "★" & "20D34A4DD02CC1F1249C0453D8BB4967" & "★" & "2CF24DBA5FB0A30E26E83B2AC5B9E29E1B161E5C1FA7425E73043362938B9824"
	Form.requestMOTP("MOTP_REQ_OTP_ENC", szData , "99999")
End Sub

'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
	
	Select Case sEventName
	
		Case "MOTP_GETINFO_RETURN_99999"
			Form.ShowAlert(sEventName, sParam)
		Case "MOTP_ISSUE_RETURN_99999"
			Form.ShowAlert(sEventName, sParam)
		Case "MOTP_DISCARD_RETURN_99999"
			Form.ShowAlert(sEventName, sParam)
		Case "MOTP_REQ_OTP_RETURN_99999"
			Form.ShowAlert(sEventName, sParam)
		Case "MOTP_GET_VERSION_RETURN_99999"
			Form.ShowAlert(sEventName, sParam)
		Case "MOTP_REQ_OTP_ENC_RETURN_99999"
			Form.ShowAlert(sEventName, sParam)
			
	End Select
		
End Sub




'============================================================================
Sub Button0_OnClick()
	Form.runInziCamera()
End Sub

'============================================================================
Sub Button1_OnClick()

	if Button1.caption = "OCR데이터 삭제" then
	
		Button1.caption = "OCR데이터 확인"
		Table0.visible = false
		
	else
		g_IdCardType 		= Form.GetSharedData("&RET_CARD_TYPE", 0)
		g_NAME		    	= Form.GetSharedData("&RET_NAME", 0)				'이름
		g_RCNO 		    	= Form.GetSharedData("&RET_JUMIN_NUM", 0 )		'암호화된 실명확인번호
		g_ISSU_DATE	    	= Form.GetSharedData("&RET_ISSU_DATE", 0)			'발급일자
	
		ImgMskData 	    	= Form.GetSharedData("&RET_MASK_IMAGE_ENC" , 0)	'주민번호 마스킹이미지 
		g_ImgData  	    	= Form.GetSharedData("&RET_IMAGE_ENC", 0)			'주민번호 마스킹없는이미지

		g_FEATURE 	  	= Form.GetSharedData("&RET_FEATURE"		, 0 ) 	'특징점데이터
		g_FEATURE_SCORE 	= Form.GetSharedData("&RET_FEATURE_SCORE"	, 0 ) 	'특징점 점수
		g_FEATURE_LEN   	= Form.GetSharedData("&RET_FEATURE_LEN"	, 0 ) 	'특징점데이터 길이
		g_SERIAL    	  	= Form.GetSharedData("&RET_SERIAL"			, 0 ) 	'발급번호
		g_LISENCE_NUM   	= Form.GetSharedData("&RET_LICENSE_NUM"	, 0 ) 	'신분증번호
		g_RCNO_7		  	= Form.GetSharedData("&RET_JUMIN_NUM_BACK"	, 0 ) 	'실명확인번호 뒷 7자리
		g_ImgDataLen 	  	= LEN(g_ImgData)
	
		Table0.SetCellString(1, 1, g_IdCardType)
		Table0.SetCellString(2, 1, g_NAME)
		Table0.SetCellString(3, 1, g_RCNO)
	
		Table0.SetCellString(4, 1, g_ISSU_DATE)
		Table0.SetCellString(5, 1, g_FEATURE_LEN)
		Table0.SetCellString(6, 1, g_LISENCE_NUM)
		Table0.SetCellString(7, 1, g_RCNO_7)
		Table0.SetCellString(8, 1, g_ImgDataLen)
	
		Button1.caption = "OCR데이터 삭제"
		Table0.visible = true
		
	end if
	
	
	
	
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "OCRCOMPLETE" then
		if sParam == "1" then
			ImgMskData 	    = Form.GetSharedData("&RET_MASK_IMAGE_ENC" , 0)
			Image0.SetImageDataEnc(ImgMskData)
		end if
	
	end if
	
End Sub



'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
