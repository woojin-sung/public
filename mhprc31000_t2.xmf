	<SCRIPT_INFO _len="29785" _ulen="28295" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 기본탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------
'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_ItemMarket, g_szgrdHeader1, g_szgrdHeader2
Dim g_prod		'20220915 HSZ 상품선물 추가
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) = 0 Then
		g_szItemMarket = "F"			
	end if
	'20160705 NOHES END

End Sub

'============================================================================
Sub Form_OnFormInit()
	contOpt.left = 0
	
	If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
		contFut.visible = True
		contOpt.visible = False
		contCfu.visible = False
	Elseif g_szItemMarket = "CF" or g_szItemMarket = "FF" then	'20220915 HSZ 상품선물 추가		'20221111 SWJ START : 거래소 차세대 (CF -> CF,FF)
		contFut.visible = False
		contOpt.visible = False
		contCfu.visible = True
	Else
		contFut.visible = False
		contOpt.visible = True
		contCfu.visible = False
	End If
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
	
		szBase = Form.GetItemCodeInfo( g_szItemCode , "basecode")
		
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START: 코스닥글로벌지수 추가
			contFut.visible = True
			contOpt.visible = False
			contCfu.visible = False
		Elseif g_szItemMarket = "CF" or g_szItemMarket = "FF" then	'20220915 HSZ 상품선물 추가			'20221111 SWJ START : 거래소 차세대 (CF -> CF,FF)
			contFut.visible = False
			contOpt.visible = False
			contCfu.visible = True
			DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
		Else
			contFut.visible = False
			contOpt.visible = True
			contCfu.visible = False
		End If
		
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_3050_005r" )
	end	if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCode
	
	If szTranID = "ohhts_3050_001r" Then
		DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_pric_extd" )
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3050_005r" Then
		
		'20180308_01 KBC START : KRX300 & KSQ150상품추가 (변경)
		' 20240412 HSZ START: 코스닥글로벌지수 추가	- cancel 분기처리 삭제 (무조건 cancel하고 날리기)
'		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then
'			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
			DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
'		Else
			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
			DATAMANAGER.CancelRealData( "ohhts_nmix_cntg_1" )
'		End If
	
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then
			'(A),(B)만 보임
			
			'---(D)---
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "F2G01P" 	) '선물지수				    '20221111 SWJ START: 2701 -> F2G01P			
			
			'---(B)(C)---
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "KGG01P" 	) '코스피지수(종합주가지수)		'20221111 SWJ START: 0001 -> KGG01P
			
			sInnnerMrktTp = Form.GetItemCodeInfo( g_szItemCode , "innermarket")

			if sInnnerMrktTp == "041" or sInnnerMrktTp == "042" then 
				'---(D)---
				'KRX300선물, 선물스프레드
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "X3G01P" 	) 'KRX300지수					'20221111 SWJ START: 3300 -> X3G01P
				
				'---(B)(C)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "KGG01P" 	) '코스피지수(종합주가지수)		'20221111 SWJ START: 0001 -> KGG01P
				
			elseif sInnnerMrktTp == "043" or sInnnerMrktTp == "044" then
				'---(D)---
				'코스닥150선물, 선물스프레드
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "Q5G01P" 	) '코스닥150지수				'20221111 SWJ START : 1203 -> Q5G01P
				
				'---(B)(C)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "QGG01P" 	) '코스닥지수					'20221111 SWJ START : 1001 -> QGG01P
			
			' 20240412 HSZ START: 코스닥글로벌지수 추가
			' iOS -> 060, 061 / 안드 -> 062, 063
			elseif sInnnerMrktTp == "060" or sInnnerMrktTp == "061" or sInnnerMrktTp == "062" or sInnnerMrktTp == "063" then
				'---(D)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "Q5G11P" 	) '코스닥글로벌지수
				
				'---(B)(C)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "QGG01P" 	) '코스닥지수	
			' 20240412 HSZ END
			end if
					
		Else
			'(C),(D)만 보임
			
			If g_szItemMarket = "O" or g_szItemMarket = "WO" Then	' 20190809_01 HWG : 위클리옵션추가
				szCode = Form.GetFutureCode(0, false, true)
				
				'---(D)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "F" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , szCode 	)
				
				'---(B)(C)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)			
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "K2G01P" 	) '코스피200지수				'20221111 SWJ START : 2029 -> K2G01P			
				
			ElseIf g_szItemMarket = "MO" Then
				szCode = Form.GetFutureCode(0, true, true)
				
				'---(D)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "MF" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , szCode 	)
	
				'---(B)(C)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)			
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "K2G01P" 	) '코스피200지수				'20221111 SWJ START : 2029 -> K2G01P				
				
				
			ElseIf g_szItemMarket = "QO" Then
				szCode = Form.GetFutureCodeNew(0, 3, true) '0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
				
				'---(D)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "F" 	)
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , szCode 	)

				'---(B)(C)---
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)			
				DATAMANAGER.SetDataValue( 0, "ohhts_3050_005r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , "Q5G01P" 	) '코스닥150지수				'20221111 SWJ START : 1203 -> Q5G01P
			End If

		End If
		'20180308_01 KBC END
	ElseIf szTranID = "ohhts_3080_001r" Then
		DATAMANAGER.CancelRealData( "ohhts_cfut_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_unas_cntg" )
		DATAMANAGER.SetDataValue(0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket )	'20221111 SWJ START : "CF"에서 변수로 수정("FF"도 있어서)
		DATAMANAGER.SetDataValue(0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szItemCode )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szItemCode, szCode
	szItemCode = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	DATAMANAGER.ClearInputData(1, szTranID)	' 20240520
	
	If szTranID = "ohhts_futs_cntg" Then
		'---(D)---
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ : 코스닥글로벌지수 추가
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	) 'tblFut1 누적거래대금
		Else
			If g_szItemMarket = "O" or g_szItemMarket = "WO" Then	' 20190809_01 HWG : 위클리옵션추가
				szCode = Form.GetFutureCode(0, false, true)
				
			'20180308_01 KBC START : KRX300 & KSQ150상품추가 (변경)
			ElseIf g_szItemMarket = "MO" Then
				szCode = Form.GetFutureCode(0, true, true) '미니선물
				
			ElseIf g_szItemMarket = "QO" Then
				szCode = Form.GetFutureCodeNew(0, 3, true) '0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
			'20180308_01 KBC END
			
	'		 20240412 HSZ START : 코스닥글로벌지수 추가
			ElseIf g_szItemMarket = "KF" then
				szCode = Form.GetFutureCodeNew(0, 4, true)
			'20240415 HSZ END
			
			End If
			
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szCode 	) 'tblOpt1 (D)
		End If
	
	ElseIf szTranID = "ohhts_optn_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
	
	'20180308_01 KBC START : KRX300 & KSQ150상품추가
	ElseIf szTranID = "ohhts_nmix_cntg" Then 
		sInnnerMrktTp = Form.GetItemCodeInfo( g_szItemCode , "innermarket")
	
		'선물테이블사용 (tblFut2 종합주가지수)
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then	' 20240412 HSZ : 코스닥글로벌지수 추가
			' iOS -> 060, 061 / 안드 -> 062, 063
			'---(B)---
			if sInnnerMrktTp == "043" or sInnnerMrktTp == "044" or sInnnerMrktTp == "060" or sInnnerMrktTp == "061" or sInnnerMrktTp == "062" or sInnnerMrktTp == "063" then 		' 20240412 HSZ START: 코스닥글로벌지수 추가 '코스닥150지수
				DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "QGG01P"		) '코스닥지수			'20221111 SWJ START : 1001 -> QGG01P
			else
				DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "KGG01P"		) '코스피지수			'20221111 SWJ START : 0001 -> KGG01P
			end if
		
		'옵션테이블사용 (tblOpt1상단 KOSPI200, KRX300, KOSDAT150)
		Else	
			'---(C)---
			'KRX300은 옵션없음
			if g_szItemMarket == "QO" then
				DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "Q5G01P"		) '코스닥150지수		'20221111 SWJ START : 1203 -> Q5G01P
			else
				DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "K2G01P"		) '코스피200지수		'20221111 SWJ START : 2029 -> K2G01P
			end if
		End If
	
	ElseIf szTranID = "ohhts_nmix_cntg_1" Then '선물테이블사용(tblFut2 상단 KOSPI200, KRX300, KOSDAQ150)
		sInnnerMrktTp = Form.GetItemCodeInfo( g_szItemCode , "innermarket")

		'---(A)---
		if sInnnerMrktTp == "041" or sInnnerMrktTp == "042" then 
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "X3G01P"		) 'KRX300지수			'20221111 SWJ START: 3300 -> X3G01P
		elseif sInnnerMrktTp == "043" or sInnnerMrktTp == "044" then
			'코스닥150선물, 선물스프레드
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "Q5G01P"		) '코스닥150지수		'20221111 SWJ START : 1203 -> Q5G01P
		' 20240412 HSZ START: 코스닥글로벌지수 추가
		' iOS -> 060, 061 / 안드 -> 062, 063
		elseif sInnnerMrktTp == "060" or sInnnerMrktTp == "061" or sInnnerMrktTp == "062" or sInnnerMrktTp == "063" then 		
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "QGG11P"		)
		' 20240412 HSZ END	
		else
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "K2G01P"		) '코스피200지수		'20221111 SWJ START : 2029 -> K2G01P
		end if
	'20180308_01 KBC END
	    
	    
	ElseIf szTranID = "ohhts_pric_extd" Then
	    DATAMANAGER.SetDataValue( 1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD"		, 0 , szItemCode	)
	    
	'20220915 HSZ START 상품선물 추가
	ElseIf szTranID = "ohhts_cfut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_unas_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_unas_cntg", "InBlock1", "FIDR_PROD_NO" , 0 , g_prod )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ohhts_3050_001r" Then	
	
	    If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ : 코스닥글로벌지수 추가
		    Dim nUNAS_PRDY_VRSS
		    nUNAS_PRDY_VRSS = CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_PRDY_VRSS" , 0	) )
		    
		    '20180308_01 KBC START : KRX300 & KSQ150상품추가
		    sUnasIscd = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD", 0	)

			if sUnasIscd = "Q5G01P" then  			' 20240412 HSZ : 기존 오류 수정
				'코스닥150
				contFut.tblFut2.SetCellString( 0, 0, "KOSDAQ 150" )
				contFut.tblFut2.SetCellString( 1, 0, "KOSDAQ 종합" )
			
			elseif sUnasIscd = "QGG11P" then  		' 20240412 HSZ START : 코스닥글로벌지수 추가
				'코스닥글로벌
				contFut.tblFut2.SetCellString( 0, 0, "코스닥글로벌" )
				contFut.tblFut2.SetCellString( 1, 0, "KOSDAQ 종합" )
				
			elseif sUnasIscd = "X3G01P" then 		' 20240412 HSZ : 기존 오류 수정
				'KRX300
				contFut.tblFut2.SetCellString( 0, 0, "KRX 300" )
				contFut.tblFut2.SetCellString( 1, 0, "종합주가지수" )
			
			else
				contFut.tblFut2.SetCellString( 0, 0, "KOSPI 200" )
				contFut.tblFut2.SetCellString( 1, 0, "종합주가지수" )
			end if
		    '20180308_01 KBC END
		    
		    '---(A)---
		    contFut.tblFut2.SetCellString( 0, 1, DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_PRPR"			, 0	) )
		    contFut.tblFut2.SetCellString( 0, 2, DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_PRDY_VRSS_SIGN"	, 0 	) )
		    contFut.tblFut2.SetCellString( 0, 3, DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_PRDY_VRSS"		, 0	) )
		    contFut.tblFut2.SetCellString( 0, 4, DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_PRDY_CTRT"		, 0	) )
		    
			If nUNAS_PRDY_VRSS > 0 Then
				contFut.tblFut2.SetCellFgColor( 0, 1, "10" )
				contFut.tblFut2.SetCellFgColor( 0, 3, "10" )
				contFut.tblFut2.SetCellFgColor( 0, 4, "10" )
			ElseIf nUNAS_PRDY_VRSS < 0 Then
				contFut.tblFut2.SetCellFgColor( 0, 1, "11" )
				contFut.tblFut2.SetCellFgColor( 0, 3, "11" )
				contFut.tblFut2.SetCellFgColor( 0, 4, "11" )
			Else
				contFut.tblFut2.SetCellFgColor( 0, 1, "12" )
				contFut.tblFut2.SetCellFgColor( 0, 3, "12" )
				contFut.tblFut2.SetCellFgColor( 0, 4, "12" )
			End If

			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		Else
			Dim szUplnStag, szLslmStag
			szUplnStag = Trim(DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_PRCLMT_EXT_UPLM_STAG" ,0 ))	'상한가단계
			szLslmStag = Trim(DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_PRCLMT_EXT_LSLM_STAG" ,0 ))	'하한가단계
			
		    '20180308_01 KBC START : KRX300 & KSQ150상품추가
		    sUnasIscd = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD", 0	)
		    	
			if sUnasIscd = "Q5G01P" then 			' 20240412 HSZ : 기존 오류 수정
				'코스닥150
				contOpt.tblOpt1.SetCellString( 0, 0, "KOSDAQ 150" )
				
			elseif sUnasIscd = "QGG11P" then  		' 20240412 HSZ START : 코스닥글로벌지수 추가
				'코스닥글로벌
				contOpt.tblOpt1.SetCellString( 0, 0, "코스닥글로벌" )
				DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
				
			elseif sUnasIscd = "X3G01P" then 		' 20240412 HSZ : 기존 오류 수정
				'KRX300
				contOpt.tblOpt1.SetCellString( 0, 0, "KRX 300" )
			else
				contOpt.tblOpt1.SetCellString( 0, 0, "KOSPI 200" )
			end if
		    '20180308_01 KBC END			
			
			If right(szUplnStag,1) ="1" Then 
			    contOpt.tblOpt2.SetCellString( 0 , 0, "상한가(1단계)" )
			Elseif right(szUplnStag,1) ="2" Then 
			    contOpt.tblOpt2.SetCellString( 0 , 0 , "상한가(2단계)" )
			Elseif right(szUplnStag,1) ="3" Then  
			    contOpt.tblOpt2.SetCellString( 0 , 0 , "상한가(3단계)" )
			Else
			    contOpt.tblOpt2.SetCellString( 0 , 0 , "상한가" )	    
			End if 
			
			If right(szLslmStag,1) ="1" Then 
			    contOpt.tblOpt2.SetCellString( 0 ,2, "하한가(1단계)" )
			Elseif right(szLslmStag,1) ="2" Then 
			    contOpt.tblOpt2.SetCellString( 0, 2, "하한가(2단계)" )
			Elseif right(szLslmStag,1) ="3" Then  
			    contOpt.tblOpt2.SetCellString( 0, 2, "하한가(3단계)" )
			Else
			    contOpt.tblOpt2.SetCellString( 0, 2 , "하한가" )
			End if	
			
			DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
		End If
	    
	    DATAMANAGER.RequestRealData( "ohhts_pric_extd" )
	
	ElseIf szTranID = "ohhts_3050_005r" Then	
		Dim nPRDY_VRSS1, nPRDY_VRSS2
		nPRDY_VRSS2	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3050_005r", "OutBlock1", "FID_PRDY_VRSS2" , 0 ) )
		nPRDY_VRSS1	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3050_005r", "OutBlock2", "FID_PRDY_VRSS2" , 0 ) )
		
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ : 코스닥글로벌지수 추가
'			If nPRDY_VRSS2 < 0 Then
'				contFut.tblFut2.SetCellFgColor( 1, 1, "10" )
'				contFut.tblFut2.SetCellFgColor( 1, 3, "10" )
'				contFut.tblFut2.SetCellFgColor( 1, 4, "10" )
'			ElseIf nPRDY_VRSS2 > 0 Then
'				contFut.tblFut2.SetCellFgColor( 1, 1, "11" )
'				contFut.tblFut2.SetCellFgColor( 1, 3, "11" )
'				contFut.tblFut2.SetCellFgColor( 1, 4, "11" )
'			Else
'				contFut.tblFut2.SetCellFgColor( 1, 1, "12" )
'				contFut.tblFut2.SetCellFgColor( 1, 3, "12" )
'				contFut.tblFut2.SetCellFgColor( 1, 4, "12" )
'			End If

			DATAMANAGER.RequestRealData( "ohhts_nmix_cntg_1" )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )		'20240520 HSZ
		Else			
			If nPRDY_VRSS1 > 0 Then
				contOpt.tblOpt1.SetCellFgColor( 0, 1, "10" )
				contOpt.tblOpt1.SetCellFgColor( 0, 3, "10" )
				contOpt.tblOpt1.SetCellFgColor( 0, 4, "10" )
			ElseIf nPRDY_VRSS1 < 0 Then
				contOpt.tblOpt1.SetCellFgColor( 0, 1, "11" )
				contOpt.tblOpt1.SetCellFgColor( 0, 3, "11" )
				contOpt.tblOpt1.SetCellFgColor( 0, 4, "11" )
			Else
				contOpt.tblOpt1.SetCellFgColor( 0, 1, "12" )
				contOpt.tblOpt1.SetCellFgColor( 0, 3, "12" )
				contOpt.tblOpt1.SetCellFgColor( 0, 4, "12" )
			End If
		
			If nPRDY_VRSS2 > 0 Then
				contOpt.tblOpt1.SetCellFgColor( 1, 1, "10" )
				contOpt.tblOpt1.SetCellFgColor( 1, 3, "10" )
				contOpt.tblOpt1.SetCellFgColor( 1, 4, "10" )
			ElseIf nPRDY_VRSS2 < 0 Then
				contOpt.tblOpt1.SetCellFgColor( 1, 1, "11" )
				contOpt.tblOpt1.SetCellFgColor( 1, 3, "11" )
				contOpt.tblOpt1.SetCellFgColor( 1, 4, "11" )
			Else
				contOpt.tblOpt1.SetCellFgColor( 1, 1, "12" )
				contOpt.tblOpt1.SetCellFgColor( 1, 3, "12" )
				contOpt.tblOpt1.SetCellFgColor( 1, 4, "12" )
			End If
			
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			
		End If		
		
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
		
	ElseIf szTranID = "ohhts_3080_001r" Then		'20220926 HSZ 상품선물 추가
		g_prod = DATAMANAGER.GetDataValue(0, "ohhts_3080_001r" , "OutBlock1" , "FID_PROD_CODE" , 0)
		DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_unas_cntg" )
		
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	If szTranID = "ohhts_3050_001r" Then	
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
			Dim nACML_TR_PBMN
			nACML_TR_PBMN = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_ACML_TR_PBMN" , 0 )
			DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_ACML_TR_PBMN" , 0 , Round( nACML_TR_PBMN / 100000 ) )
		End If
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	If szTranID = "ohhts_futs_cntg" Then
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
			Dim nACML_TR_PBMN
			nACML_TR_PBMN = DATAMANAGER.GetDataValue( 1, "ohhts_futs_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 )
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 , Round( nACML_TR_PBMN / 100000 ) )
			
		End If
	'20220913 HSZ START 상품선물 추가
	ElseIf szTranID = "ohhts_cfut_cntg" Then
		nStplQtyIcdc	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_OTST_STPL_QTY_ICDC" , 0 ) )
		nStplQty	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_OTST_STPL_QTY" , 0 ) ) 
		nStplRate =  nStplQtyIcdc / nStplQty * 100
		
		nAcmlPbmn = CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 ) ) / 1000
		
		contCfu.tblCfu1.SetCellString(1, 4, nStplRate)
		contCfu.tblCfu2.SetCellString(0, 1, nAcmlPbmn)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	
    If szTranID = "ohhts_pric_extd" Then 
	    Dim szUplnStag, szLslmStag
	    
	    '상하한가 단계표시
	    szUplnStag = Trim(DATAMANAGER.GetDataValue( 0, "ohhts_pric_extd", "OutBlock1", "FIDR_PRCLMT_EXT_UPLM_STAG" , 0 ))	'상한가단계
	    szLslmStag = Trim(DATAMANAGER.GetDataValue( 0, "ohhts_pric_extd", "OutBlock1", "FIDR_PRCLMT_EXT_LSLM_STAG" ,0 ))	'하한가단계 
 
 	    If right(szUplnStag,1) ="1" Then 
		    contOpt.tblOpt2.SetCellString( 0 , 0, "상한가(1단계)" )
	    Elseif right(szUplnStag,1) ="2" Then 
		    contOpt.tblOpt2.SetCellString( 0 , 0 , "상한가(2단계)" )
	    Elseif right(szUplnStag,1) ="3" Then  
		    contOpt.tblOpt2.SetCellString( 0 , 0 , "상한가(3단계)" )
	    Else
		    contOpt.tblOpt2.SetCellString( 0 , 0 , "상한가" )	    
	    End if 
	    
	    If right(szLslmStag,1) ="1" Then 
		    contOpt.tblOpt2.SetCellString( 0, 2, "하한가(1단계)" )
	    Elseif right(szLslmStag,1) ="2" Then 
		    contOpt.tblOpt2.SetCellString( 0, 2 , "하한가(2단계)" )
	    Elseif right(szLslmStag,1) ="3" Then  
		    contOpt.tblOpt2.SetCellString( 0, 2 , "하한가(3단계)" )
	    Else
		    contOpt.tblOpt2.SetCellString( 0, 2 , "하한가" )	    
	    End if    

	ElseIf szTranID = "ohhts_nmix_cntg" Then
		Dim nPRDY_VRSS2
		nPRDY_VRSS2	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0 ) )
		
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
			If nPRDY_VRSS2 > 0 Then
				contFut.tblFut2.SetCellFgColor( 1, 1, "10" )
				contFut.tblFut2.SetCellFgColor( 1, 3, "10" )
				contFut.tblFut2.SetCellFgColor( 1, 4, "10" )
			ElseIf nPRDY_VRSS2 < 0 Then
				contFut.tblFut2.SetCellFgColor( 1, 1, "11" )
				contFut.tblFut2.SetCellFgColor( 1, 3, "11" )
				contFut.tblFut2.SetCellFgColor( 1, 4, "11" )
			Else
				contFut.tblFut2.SetCellFgColor( 1, 1, "12" )
				contFut.tblFut2.SetCellFgColor( 1, 3, "12" )
				contFut.tblFut2.SetCellFgColor( 1, 4, "12" )
			End If
		Else
			If nPRDY_VRSS2 > 0 Then
				contOpt.tblOpt1.SetCellFgColor( 0, 1, "10" )
				contOpt.tblOpt1.SetCellFgColor( 0, 3, "10" )
				contOpt.tblOpt1.SetCellFgColor( 0, 4, "10" )
			ElseIf nPRDY_VRSS2 < 0 Then
				contOpt.tblOpt1.SetCellFgColor( 0, 1, "11" )
				contOpt.tblOpt1.SetCellFgColor( 0, 3, "11" )
				contOpt.tblOpt1.SetCellFgColor( 0, 4, "11" )
			Else
				contOpt.tblOpt1.SetCellFgColor( 0, 1, "12" )
				contOpt.tblOpt1.SetCellFgColor( 0, 3, "12" )
				contOpt.tblOpt1.SetCellFgColor( 0, 4, "12" )
			End If		
		End If
	
	ElseIf szTranID = "ohhts_nmix_cntg_1" Then 
		Dim nPRDY_VRSS2
		nPRDY_VRSS2	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_PRDY_VRSS2" , 0 ) )
		
		If nPRDY_VRSS2 > 0 Then
			contFut.tblFut2.SetCellFgColor( 0, 1, "10" )
			contFut.tblFut2.SetCellFgColor( 0, 3, "10" )
			contFut.tblFut2.SetCellFgColor( 0, 4, "10" )
		ElseIf nPRDY_VRSS2 < 0 Then
			contFut.tblFut2.SetCellFgColor( 0, 1, "11" )
			contFut.tblFut2.SetCellFgColor( 0, 3, "11" )
			contFut.tblFut2.SetCellFgColor( 0, 4, "11" )
		Else
			contFut.tblFut2.SetCellFgColor( 0, 1, "12" )
			contFut.tblFut2.SetCellFgColor( 0, 3, "12" )
			contFut.tblFut2.SetCellFgColor( 0, 4, "12" )
		End If
	
	ElseIf szTranID = "ohhts_futs_cntg" Then
		Dim nPRDY_VRSS2
		nPRDY_VRSS2	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_futs_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0 ) )
	
		If nPRDY_VRSS2 > 0 Then
			contOpt.tblOpt1.SetCellFgColor( 1, 1, "10" )
			contOpt.tblOpt1.SetCellFgColor( 1, 3, "10" )
			contOpt.tblOpt1.SetCellFgColor( 1, 4, "10" )
		ElseIf nPRDY_VRSS2 < 0 Then
			contOpt.tblOpt1.SetCellFgColor( 1, 1, "11" )
			contOpt.tblOpt1.SetCellFgColor( 1, 3, "11" )
			contOpt.tblOpt1.SetCellFgColor( 1, 4, "11" )
		Else
			contOpt.tblOpt1.SetCellFgColor( 1, 1, "12" )
			contOpt.tblOpt1.SetCellFgColor( 1, 3, "12" )
			contOpt.tblOpt1.SetCellFgColor( 1, 4, "12" )
		End If

	'20220913 HSZ START 상품선물 추가
'	ElseIf szTranID = "ohhts_cfut_cntg" Then
'		nStplQtyIcdc	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_OTST_STPL_QTY_ICDC" , 0 ) )
'		nStplQty	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_OTST_STPL_QTY" , 0 ) )
'		nStplRate = nStplQtyIcdc / (nStplQty * 100)
'		
'		nAcmlPbmn = CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 ) ) / 1000
'		
'		contCfu.tblCfu1.SetCellString(1, 3, nStplRate)
'		contCfu.tblCfu2.SetCellString(0, 1, nAcmlPbmn)

	End if 
    
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
		'20220913 HSZ START 상품선물 추가
		if g_szItemMarket = "CF" or g_szItemMarket = "FF" then		'20221111 SWJ START : 거래소 차세대 (CF -> CF,FF)
			DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
		end if
		'20220913 HSZ END
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_3050_005r" )
	End If
End Sub

