'============================================================================
Sub Form_OnFormInit()
	

	DATAMANAGER.RequestTranData( "obibk_pssm_003r" )
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Form_OnFormInit()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nDataCount			'데이터 개수
	Dim szIssuCode			'청약종목구분코드
	Dim szGradeCode			'위험등급코드
	Dim szProtectYN			'보장여부
	
	if szTranID == "obibk_pssm_003r" then
		if DATAMANAGER.GetDataMsgCode( szTranID ) == "5820" then
			'Form.MsgBox( "알림", DATAMANAGER.GetDataMsgText( szTranID ), "", 6 )
			Form.MsgBox( "알림", DATAMANAGER.GetDataMsgSubText(szTranID), "", 6 )
			exit sub
		end if
	
		nDataCount = DATAMANAGER.GetDataCount( 0 , "obibk_pssm_003r", "OutBlock1") - 1
		for i = 0 to nDataCount
			Seting( i )
			
			'szIssuCode = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_042r", "OutBlock1", "PROD_CLS_CODE" , i)			'상품코드
			'szGradeCode = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_042r", "OutBlock1", "KYC_PROD_GRAD_CODE" , i)	'위험도Code
			'szProtectYN = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_042r", "OutBlock1", "PRNC_GUAR_YN" , i)			'보장여부
			'GradeCheck( i, szIssuCode, szGradeCode, szProtectYN)
		next
	end if
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData, szData1, g_szFileName, g_szUrl
	
	'종목코드, 시작일, 현재일, 청약일자, 청약종목일련번호
'	szData = grd0.GetCellData( "bd_cell8", lRow) & "★" & grd0.GetCellData( "cell3_4", lRow) & "★" &  cld0.caption & "★" &  
'			grd0.GetCellData( "bd_cell9", lRow) & "★" & grd0.GetCellData( "bd_cell10", lRow)

	
	szData1 = grd0.GetCellData( "bd_cell_sbsc_date", lRow) & "★" & grd0.GetCellData( "bd_cell_sbsc_srno", lRow) 
	
	if szCellID == "bd_cell_view" then
		Form.OpenFramePopup( "mbonl83110_p1" , szData1 , sPosInfo)
	end if
	
	
	if szCellID == "cell3_7"  OR  szCellID == "cell4_7" then
		if grd0.GetCellData( "bd_cell_able_yn", lRow) == "Y" THEN
			grd0.GetCellData( "bd_cell_sbsc_date", lRow) 
			Form.OpenFramePopup( "mbonl83130_p1" , szData1 , sPosInfo)
		end if 
	end if
	
	
End Sub



