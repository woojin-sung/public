'============================================================================
' 01. 화 면 명 : ELS/DLS청약_청약완료상품탭
' 02. 화면설명 : ELS/DLS청약_청약완료상품탭
' 03. 작    성 : 2016. 03. 05. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Seting(nIndex) : 그리드 값 세팅
'============================================================================
Function Seting(nIndex)
Dim tmp_time

	tmpSbscDate = DATAMANAGER.GetDataValue( 0 , "obibk_pssm_003r", "OutBlock1", "SBSC_DATE" , nIndex)
	tmpSbscSrno = DATAMANAGER.GetDataValue( 0 , "obibk_pssm_003r", "OutBlock1", "SBSC_ISSU_SRNO" , nIndex)
	tmpIscd = Left(tmpSbscDate, 4) & "-" & MID(tmpSbscDate, 5,2) & " (" & CINT(tmpSbscSrno) & ")"
	grd0.SetCellData( "cell1_1", nIndex, tmpIscd)
	
	
	
'	grd0.SetCellData( "cell2_3" , nIndex, "/")
	grd0.SetCellData( "cell2_1" , nIndex, "청약기간 :")
	grd0.SetCellData( "cell2_3" , nIndex, "~")
	'grd0.SetCellFgColor( "cell2_1" , nIndex, "61")
	'grd0.SetCellFgColor( "cell2_4" , nIndex, "61")
'	grd0.SetCellData( "bd_cell19" , nIndex, "상세\r\n보기")
	grd0.SetCellData( "cell2_8" , nIndex, "기준가")
	grd0.SetCellFgColor( "cell2_8" , nIndex, "61")
	grd0.SetCellData( "cell3_8" , nIndex, "조회")
	grd0.SetCellFgColor( "cell3_8" , nIndex, "61")
	
	grd0.SetCellData( "cell3_1" , nIndex, "환불일자 :")
'	grd0.SetCellData( "cell3_3" , nIndex, ":")
	'grd0.SetCellData( "cell3_5" , nIndex, "~")
	grd0.SetCellData( "cell4_1" , nIndex, "공  모  가 :")
	'grd0.SetCellData( "cell4_2" , nIndex, "123000") ' for test
	grd0.SetCellData( "cell4_3" , nIndex, "증거금율 :")
	'grd0.SetCellData( "cell4_5" , nIndex, "50")   ' for test
	grd0.SetCellData( "cell5_1" , nIndex, "청약시간 :")
	
	'grd0.SetCellData( "cell5_3" , nIndex, "~")
	
	'tmp_time = "08:00" &  " ~ " & "16:00"
	szStaTime = DATAMANAGER.GetDataValue( 0 , "obibk_pssm_003r", "OutBlock1", "SBSC_STA_HOUR" , nIndex)
	szFinTime = DATAMANAGER.GetDataValue( 0 , "obibk_pssm_003r", "OutBlock1", "SBSC_FIN_HOUR" , nIndex)
	tmp_time = Left(szStaTime,2) & ":" & MID(szStaTime,3, 2) & " ~ "
	tmp_time = tmp_time & Left(szFinTime,2) & ":" & MID(szFinTime,3, 2)
	
	'ShowAlert("time", tmp_time)
			
	grd0.SetCellData( "cell5_2" , nIndex,  tmp_time)' for test
	
	grd0.SetCellData( "cell3_7" , nIndex,  "추납")' for test
	grd0.SetCellData( "cell4_7" , nIndex,  "신청")' for test
	grd0.SetCellFgColor( "cell3_7" , nIndex, "61")
	grd0.SetCellFgColor( "cell4_7" , nIndex, "61")
	
	
	ableYn = DATAMANAGER.GetDataValue( 0 , "obibk_pssm_003r", "OutBlock1", "SPLM_PAYM_ABLE_YN" , nIndex)
	'ShowAlert(ableYn)
	
	if ableYn <> "Y" then
		'grd0.SetCellData( "cell3_7" , nIndex,  "추납")' for test
		'grd0.SetCellData( "cell4_7" , nIndex,  "신청")' for test
		grd0.SetCellFgColor( "cell3_7" , nIndex, "26")
		grd0.SetCellFgColor( "cell4_7" , nIndex, "26")
	end if 
	'grd0.SetCellData( "cell5_4" , nIndex, "1600")' for test
'	grd0.SetCellData( "cell4_3" , nIndex, ":")
	
End Function

