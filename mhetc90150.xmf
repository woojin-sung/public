End Sub

'============================================================================
Sub Form_OnFormClose()
	sLoginID = Form.GetSharedData( "&USER_ID", 0 )
	sFlag	= Form.GetOpenLinkData()				'로그인>인증센터>메리츠간편인증을 통해서 화면 오픈시 sFlag = Y
												'공지사항을 통해서 화면 오픈시 sFlag = P
'	if Trim(sLoginID) == "" then
'		if sFlag <> "Y" then						' 최초 1회 로그인 필요 O + 바이오정보 등록(로그인화면)으로 열렸을 시
'			if sFlag == "P" then					' 최초 1회 로그인 필요 O + 공지사항에서 이동하였을 시
'			else
'				Form.OpenPopup("mhetc90021" , "")		'20180911_01 KBC : 바이오인증 인증방식 추가
'			end if
'		end if
'	
'	else
'		if sFlag <> "Y" and g_complete = "Y" then	' 최초 1회 로그인 필요 X + 바이오정보 등록(로그인화면)으로 열렸을 시 
'			if sFlag == "P" then					' 최초 1회 로그인 필요 X + 공지사항에서 이동하였을 시
'			else
'				Form.OpenPopup("mhetc90021" , "")		'20180911_01 KBC : 바이오인증 인증방식 추가
'			end if
'		end if
'	end if
	
	if sFlag == "Y" then
		Form.SendReturnToParent("FORM_CLOSE" , "") '20220805_01 KBC : 로그인개선
	end if
	
	
	Form.SendReturnToParent("BTN_IMAGE_ENABLE" , "")
End Sub

'============================================================================
Sub Table1_OnClick(lRow , lColumn)
	
	g_sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	if CInt(g_sLOGIN_TYPE) > 1 then '로그인상태
		
		Dim sText
		sText = "인증서 업무를 위하여 로그아웃을 진행하시겠습니까?"	
		Form.MsgBox( "안내", sText, "LOGOUT_MSG", 1 )
		
		g_sSaveRow = lRow
		exit sub
	end if	
	
	Select Case lRow
	
	'클라우드 인증서 발급/재발급
	Case	 0,1,2
		'클라우드 연결 필요
		if g_bNeedConnect then
			'클라우드 연결화면 진입시점 판단 용도
			Form.SetSharedData("CLOUD_CONNECT_IS_FROM" , "new")
			
			Form.OpenNextPopup("mhetc90302" , "" , "")	
		else
			Form.OpenNextPopup("mhetc90150_s1", "new", "")
		end if
		
	'타기관 클라우드 인증서 등록
	Case 3,4,5
		'클라우드 연결 필요
		if g_bNeedConnect then
			'클라우드 연결화면 진입시점 판단 용도
			Form.SetSharedData("CLOUD_CONNECT_IS_FROM" , "regi")
			
			Form.OpenNextPopup("mhetc90302" , "" , "")	
		else
			Form.OpenNextPopup("mhetc90150_s1", "regi", "")
		end if
		
	'공동인증서 클라우드에 보관
	Case 6,7,8
		
		'클라우드 연결 필요
		if g_bNeedConnect then
			Form.OpenNextPopup("mhetc90302" , "" , "")	
		else
			Form.OpenPopup("mhetc90152" , "" , "")
		end if
		
	'클라우드인증서 관리
	Case 9,10,11
		
		'클라우드 연결 필요
		if g_bNeedConnect then
			Form.OpenNextPopup("mhetc90302" , "" , "")	
		else
			Form.OpenPopup("mhetc90153" , "" , "")
		end if
		
	'클라우드 연결 관리
	Case 12,13,14
		
		'클라우드 연결 필요
		if g_bNeedConnect then
			Form.OpenNextPopup("mhetc90302" , "" , "")	
		else
			Form.OpenPopup("mhetc90154" , "" , "")
		end if
		
	End Select
	
End Sub
'============================================================================
Sub Image0_OnClick()
	Table1_OnClick(0 , lColumn)
End Sub
'============================================================================
Sub Image1_OnClick()
	Table1_OnClick(3 , lColumn)
End Sub
'============================================================================
Sub Image2_OnClick()
	Table1_OnClick(6 , lColumn)
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOG_FORCE" then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021" , "" , "")	
		else
			Form.CloseForm()			
		end if
	elseif sKeyName == "BioRegister" then
		Form.OpenFramePopup("mhetc90060_py" , "mhetc90190" , "")
		
	elseif sKeyName == "E4106" then
		if sRet == "ok" then
		else
			Form.CloseForm()
		end if
	elseif sKeyName == "E3201" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s1" , "" , "")
		end if
	end if
	
	if sKeyName == "LOGOUT_MSG" then
	
		if sRet == "ok" then
			
			'(1param(0:문구없음,1문구있음), 
		     '2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
		      Form.LogOut(0, 1) 
		      
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "LOGOUT_MSG_NEW", 6 )
		end if
		
	elseif sKeyName == "LOGOUT_MSG_NEW" then
		Table1_OnClick(g_sSaveRow , lColumn)
	end if
End Sub
'============================================================================
Sub Form_OnFormInit()
	
	g_sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	Form.SetTimerEvent2(1, 1, 0.2)
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) == 1 then
		'클라우드 인증서 목록이 있는지 확인하는 함수
		'(함수의 목적과 달리 연결 여부를 판단하려고 호출)
		'(일단 무언가를 호출해야 CLOUD_EVENT_ACQUIREUSERINFO 이벤트가 발생)
		
		Form.SetTimerEvent2(1, 0, 0.2)
		Form.requestCertCommand("CLOUD_REQ_DEVICE_LIST", "", "90150") 
		Form.requestCertCommand("CLOUD_REQ_USE_LIST", "", "90150")
		
	elseif Cint(sTimerID) == 2 then
		Form.SetTimerEvent2(2, 0, 0.2)
		Form.OpenPopup("mhetc90154" , "" , "")
	end if
End Sub
'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg
	Dim sCertArray
	sCertArray = Array()
	
	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	
	
	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("안내" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if		
	
	'클라우드 연결 여부 확인
	'연결이 필요하면 이벤트 발생, 뭔가 연결되어 있으면 미발생
	if sCommand == "CLOUD_EVENT_ACQUIREUSERINFO" then
		g_bNeedConnect = True
	end if
	
'	'응답 순서
'	'처리코드, 처리메시지, rowCount, (디바이스ID, OS구분, 서비스명, 등록일)
'	'위 괄호 부분은 하트로 Array처럼 엮임
'	if sCommand == "CLOUD_REQ_DEVICE_LIST_90150" then
'		
'		Form.SaveConfigData("CLOUD_CERT", "REQ_DEVICE_LIST_COUNT", szItem(2))
'		
'		if #szItem > 2 then
'			for i = 0 to #szItem - 1
'				Form.SaveConfigData("CLOUD_CERT", "REQ_DEVICE_LIST" & i, szItem(i + 3))	
'			next
'		end if
'		
'	end if
'	
'	'응답 순서
'	'처리코드, 처리메시지, rowCount, (행위명, 일자, 금융사명, 서비스명, OS구분)
'	'위 괄호 부분은 하트로 Array처럼 엮임
'	if sCommand == "CLOUD_REQ_USE_LIST_90150" then	
'		if #szItem > 2 then
'		
'			Form.SaveConfigData("CLOUD_CERT", "REQ_USE_LIST_COUNT", szItem(2))
'			
'			for i = 0 to #szItem - 1
'				Form.SaveConfigData("CLOUD_CERT", "REQ_USE_LIST" & i, szItem(i + 3))	
'			next
'		end if
'
'	end if
	
End Sub



