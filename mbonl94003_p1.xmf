<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="94003" scrname="전환(분류)신청" version="2" writer="장원혁" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="lblTitle" fontsize="4" fontstyle="01" caption="전문투자자 분류(전환) 신청" halign="1" ly_vert="0,0,375,60,1" />
		<IMAGE name="imgBack" autosize="1" imgpath="icon_top_back_light" ly_vert="21,19,24,24,1" />
		<BUTTON name="btnBack" btnimage="alpha" ly_vert="18,10,40,40,1" />
		<CONTAINER name="Container0" scroll_pos="0,0" ly_vert="0,60,375,523,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<TABLE name="tblDesc" insidelinecolor="102:255255255" colcount="2" rowcount="4" outline="0000" transmode="1" designorder="1" ly_vert="15,30,345,261,1" >
					<COL_INFO ly_vert_width="20,325" />
					<ROW_INFO ly_vert_height="71,57,57,76" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" valign="0" halign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" valign="0" halign="0" line="0,0" caption="전문투자자란 금융투자상품에 관한 전문지식을 보유
하고 소유자산규모, 투자경험, 소득수준, 보유자격증
등에 비추어 투자에 따른 위험감수능력이 충분히 있는
투자자를 말합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,1" valign="0" halign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,1,1,1" valign="0" halign="0" line="0,0" caption="또한 본 신청으로 전문투자자로 전환하시게 되면
일반금융소비자에 대한 보호법령 [적합성 원칙, 적정성
원칙, 설명의무] 및 관련규정이 적용되지 않게 됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" valign="0" halign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,2,1,2" valign="0" halign="0" line="0,0" caption="따라서 향후 당사에서 위와 같은 보호규정 및 이에 따른
절차 등이 귀하에게는 적용되지 않으며 이로 인하여
발생하는 손익은 귀하에게 귀속됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" valign="0" halign="0" line="0,1" caption="·" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,3,1,3" valign="0" halign="0" line="0,1" caption="전문투자자로 전환 후에도 일반투자자로 전환을
요청하실 경우에는 언제든지 일반투자자로 전환이
가능하며, 일반투자자로 전환 후에는 일반금융소비자와
동일한 대우를 받으실 수 있습니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="lblDescText" fontstyle="01" caption="개인 전문투자자 분류(전환) 위험설명" ly_vert="20,0,335,20,1" />
				<CHKBUTTON name="chkAgree1" fontsize="-2" ly_vert="20,305,20,20,1" />
				<CHKBUTTON name="chkAgree2" fontsize="-2" ly_vert="20,348,20,20,1" />
				<CHKBUTTON name="chkAgree3" fontsize="-2" chkcaption="전문투자자 전환 후 전문투자자와 같은 대우를 받지 않겠다는 의사를 표시하기 전까지는 전문투자자로 대우 받으며, 일반투자자로 전환을 원하는 경우 일반투자자로 전환할 수 있음을 확인합니다." unchkcaption="전문투자자 전환 후 전문투자자와 같은 대우를 받지 않겠다는 의사를 표시하기 전까지는 전문투자자로 대우 받으며, 일반투자자로 전환을 원하는 경우 일반투자자로 전환할 수 있음을 확인합니다." ly_vert="20,419,20,20,1" />
				<CHKBUTTON name="chkAgree4" fontsize="-2" chkcaption="본인의 자발적인 의사에 따른 전문투자자로 전환임을 확인합니다." unchkcaption="본인의 자발적인 의사에 따른 전문투자자로 전환임을 확인합니다." ly_vert="20,490,20,20,1" />
				<LABEL name="lblChk1" fontsize="-2" caption="전문투자자 전환에 따른 위험을 충분히 인지하였음을 확인합니다." valign="0" multiline="1" ly_vert="40,305,315,38,1" />
				<LABEL name="lblChk2" fontsize="-2" caption="전문투자자 전환 전 개설된 계좌 및 체결된 기타 약정 (ELW, 해외ETP 등)에 대하여 전문금융소비자 전환이후 투자권유 등의 경우에도 전문투자자로서의 대우가 적용됩니다" valign="0" multiline="1" ly_vert="40,348,315,66,1" />
				<LABEL name="lblChk3" fontsize="-2" caption="전문투자자 전환 후 전문투자자와 같은 대우를 받지 않겠다는 의사를 표시하기 전까지는 전문투자자로 대우 받으며, 일반투자자로 전환을 원하는 경우 일반투자자로 전환할 수 있음을 확인합니다." valign="0" multiline="1" ly_vert="40,419,315,66,1" />
				<LABEL name="lblChk4" fontsize="-2" caption="본인의 자발적인 의사에 따른 전문투자자로 전환임을 확인합니다." valign="0" multiline="1" ly_vert="40,490,315,38,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<BUTTON name="btnOk" caption="확인" fontstyle="01" btnimage="btn_01.9" ly_vert="20,588,335,39,1" />
