'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
g_szType = {"1", "3", "5", "10",  "20", "30", "60" , "120"}
Dim g_szData
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_szData = Form.GetOpenLinkData()
	
	
	Load_Ini()
	
	for i = 0 to Grid0.rowcount-1
		if g_szType[i] = null or g_szType[i] = "" then
			g_szType[i] = "120"
		end if
		Grid0.SetCellData( "bd_cell0", i, g_szType[i].."틱")
		if g_szData == g_szType[i] then
			Grid0.selectrow = i
		end if	
	next
	
	
	
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	sData = Grid0.GetCellData( szCellID, lRow)
	Form.SendReturnToParent( "Chart_Tic" , sData )
	Form.CloseForm( )
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "Chart_Tic" , g_szData.."틱" )
	Form.CloseForm( )	
End Sub



