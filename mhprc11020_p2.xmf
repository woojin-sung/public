' 투자정보 T	/	a:리서치리포트
'			/	b:뉴스/공시			--> 삭제
'			/	c:기관,외국인순매수
' 지수 I		/	a: KOSPI, KOSDAQ 지수
'			/	b:중국시장지수
'			/	c:홍콩시장지수
'			/	d:일본시장지수
'			/	e:원/달러 환율정보
'			/	f:미국시장 마감지수
' 시황 S		/	a:미국시장 시황
'			/	b:국내 시황
'
' 계좌평가 A  /   a: 계좌평가  -- 따로처리
'----------------------------------------------------------------------------


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szUserID
dim	g_szCustNum
dim	g_sz1stSect	'대분류	총14개
dim	g_sz2ndSect	'중분류	총14개
dim	g_szNameIdx	'세팅값 설정될 row값
dim	g_nTotalSectCnt	'분류값 

dim	g_szAcntList		'계좌리스트		--팝업통해리턴
dim	g_szAsnoList		'일련번호리스트	--팝업통해리턴
dim	g_szCanYNList		'ooase_user_001a에 들어갈 값	입력은 리턴받은 순서에 따라 input 세팅
dim	g_szProcList		'ooase_user_001a에 들어갈 값	기존데이터가 있으면 U, 없으면 I 세팅
dim	g_szAcntEvalIdx	'계좌평가 Index
dim	g_nAcntResetIdx	'계좌평가 reset index	
dim	g_nAcntMAX		'계좌평가 TRMAX INPUT

g_szAcntEvalIdx	="32"
g_nTotalSectCnt	= 14
g_nAcntResetIdx	= 0
g_nAcntMAX	=	30
'--------- INIT--------------------------------------------------------------
g_szUserID		= ""
g_szCustNum		= ""
g_sz1stSect		= Array("J", "J", "J", "J",				'종목
					   "T", "T", 						'투자정보
					   "I", "I", "I", "I", "I", "I",	'지수
					   "S", "S")						'시황
g_sz2ndSect		= Array("b", "c", "d",	"a",				'종목
					   "a", "c",						'투자정보
					   "a", "b", "c", "d", "e", "f",	'지수
					   "a", "b")						'시황
g_szNameIdx		= Array("1", "3", "5", "7",
					   "9", "11",
					   "14","16","18","20","22","24",
					   "27","29")
					   
g_szAcntList	=	Array()
g_szAsnoList	=	Array()	
g_szCanYNList	=	Array()
g_szProcList	=	Array()
'--------- INIT--------------------------------------------------------------


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ResetAcntEval:	계좌평가를 초기화시킨다
'============================================================================
Function ResetAcntEval()
		Dim	n100Cnt
		Dim	nLoopCnt
		Dim	nTotalCnt		'처리해야할갯수
		Dim	nLeftCnt			'남은갯수
		
		n100Cnt	=	""
		nLoopCnt	=	""
		
		n100Cnt	=	cont01.grdWatchAcnt01.rowcount
		nTotalCnt	=	CDbl(n100Cnt)					'총 처리해야할 갯수
		nLeftCnt		=	CDbl(n100Cnt)					'처리해야할갯수
		
		'List에 초기화 값넣음
		for j =0 	to	n100Cnt	- 1
			g_szAcntList(j)	=	cont01.grdWatchAcnt01.GetCellData("bd_acno", j)				 		
			g_szAsnoList(j)	=	cont01.grdWatchAcnt01.GetCellData("bd_asno", j)
			g_szCanYNList(j)	=	cont01.grdWatchAcnt01.GetCellData("bd_canc_yn", j)
				
				if	len(trim(g_szCanYNList(j)))	= 0	then		'데이터없으면
					g_szProcList(j)	=	"I"
				else
					g_szProcList(j)	=	"U"
				end	if
		next
		
		'몇번에 걸쳐서 넣을지 계산
		if	CInt(n100Cnt)	mod	CInt(g_nAcntMAX)	> 0 then
			nLoopCnt	=	CInt( CInt(n100Cnt)	/ CInt(g_nAcntMAX)) + 1
		end	if
		
		
		for	j =0 	to	nLoopCnt	-1	
		

			'1. INPUT 클리어
			DATAMANAGER.ClearInputData(0, "ooase_user_001a")
		
		
			'2. COUNT
			'처리해야할 건수가 MAX보다 크면 MAX값을 넣는다.
			if	nLeftCnt	>	g_nAcntMAX	then
				n100Cnt	=	g_nAcntMAX
			else
				n100Cnt	=	nLeftCnt
			end	if
			
			
			'3. INPUT에 데이터 채워넣음
			for	i = 0  	to n100Cnt -1
				DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "PROS_CLS_CODE", i, g_szProcList(g_nAcntResetIdx))
				DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "ACNO", i, g_szAcntList(g_nAcntResetIdx))
				DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "ASNO", i, g_szAsnoList(g_nAcntResetIdx))
				DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "CYCL_CLCD", i, "0")	'미사용
				DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "CANC_YN", i, "Y")
				DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "ELFN_ID", i, g_szUserID)
				
				g_nAcntResetIdx	=	g_nAcntResetIdx + 1
			next
				
			'4. 등록TR 전송
			if	g_nAcntResetIdx	>	0	then
				DATAMANAGER.RequestTranData("ooase_user_001a")
			end	if
			
			
			'5.처리된 갯수 제외
			nLeftCnt	=	nLeftCnt	-	n100Cnt
			
		next
			
		'6. 접근할 INDEX 리셋
		g_nAcntResetIdx	=	0
End	Function



'============================================================================
' SetFgColor: 글자색상함수
'============================================================================
Function SetFgColor(nRow, nCol)
	Dim sValue
	sValue = cont01.tblMain01.GetCellString( nRow, nCol )
	
	if sValue == "미사용" then
		cont01.tblMain01.SetCellFgColor( nRow, nCol, "4" )
	else
		cont01.tblMain01.SetCellFgColor( nRow, nCol, "128" )
	end if
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'GetItemName: 분류당 키값에 따른 Value값을 돌려준다.
'============================================================================
Function GetItemName(sz1stSect,	sz2ndSect, szVal)
	dim	retVal	
	
	retVal	=	""
	
	if	sz1stSect	=	"J"	then
		if	sz2ndSect	=	"a"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"시가"
			elseif	szVal	=	"2"	then
				retVal	=	"종가"
			elseif	szVal	=	"3"	then
				retVal	=	"시가+종가"
			elseif	szVal	=	"4"	then
				retVal	=	"시간별"	
			end	if

		elseif	sz2ndSect	=	"b"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"5일 신고가"
			elseif	szVal	=	"2"	then
				retVal	=	"20일 신고가"
			elseif	szVal	=	"3"	then
				retVal	=	"60일 신고가"
			end	if	
		elseif	sz2ndSect	=	"c"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"5일 신저가"
			elseif	szVal	=	"2"	then
				retVal	=	"20일 신저가"
			elseif	szVal	=	"3"	then
				retVal	=	"60일 신저가"
			end	if	
		elseif	sz2ndSect	=	"d"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"± 3%"
			elseif	szVal	=	"2"	then
				retVal	=	"± 5%"
			elseif	szVal	=	"3"	then
				retVal	=	"± 10%"
			elseif	szVal	=	"4"	then
				retVal	=	"± 20%"	
			elseif	szVal	=	"5"	then
				retVal	=	"상/하한가"	
			end	if
		end	if
	elseif	sz1stSect	=	"T"	then
		if	sz2ndSect	=	"a"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"사용"
			end	if
		elseif	sz2ndSect	=	"b"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"전체"
			end	if
		elseif	sz2ndSect	=	"c"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"당일추정"
			elseif	szVal	=	"2"	then
				retVal	=	"당일확정"
			elseif	szVal	=	"3"	then
				retVal	=	"당일(추정+확정)"	
			end	if
	
		end	if
	elseif	sz1stSect	=	"I"	then
		if	sz2ndSect	=	"a"	 or	sz2ndSect	=	"b"  or
			sz2ndSect	=	"c"	 or	sz2ndSect	=	"d"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"시가"
			elseif	szVal	=	"2"	then
				retVal	=	"종가"
			elseif	szVal	=	"3"	then
				retVal	=	"시가+종가"
			elseif	szVal	=	"4"	then
				retVal	=	"시간별"	
			end	if
		elseif	sz2ndSect	=	"e"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"9시"
			elseif	szVal	=	"2"	then
				retVal	=	"15시"
			elseif	szVal	=	"3"	then
				retVal	=	"시간별(9-15)"
			end	if
					
		elseif	sz2ndSect	=	"f"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"사용"
			end	if
		end	if
	elseif	sz1stSect	=	"S"	then
		if	sz2ndSect	=	"a"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"사용"
			end	if
		elseif	sz2ndSect	=	"b"	then
			if	szVal	=	"0"	then
				retVal	=	"미사용"
			elseif	szVal	=	"1"	then
				retVal	=	"사용"
			end	if
	
		end	if
	end	if
	
	return	retVal
End Function

'============================================================================
'ShowItems: 설정된 값을 해당셀에 보여준다.
'============================================================================
Function	ShowItems()
	dim	szVal, szName
	dim	szPeriod, sz100Cnt, szCanYN, szPeriod
	dim	szTempGrp	'그룹명저장하기위함
	dim	bIsAcnt		'row에 acnt가 있는가
	dim	szAcntIdx	'계좌평가 Index
	
	szVal	=	""
	szName	=	"미사용"
	szPeriod	=	"0"		'계좌평가 수익률은 '미사용'으로 초기화
	szCanYN	=    ""		'계좌등록여부
	szTempGrp	=""
	bIsAcnt	=	false
	szAcntIdx	=	0
	'-------------------------
	'계좌평가 제외한 조건 표시
	'-------------------------
	For	i = 0 	to	UBound(g_sz1stSect) 
		szVal 	= 	GetValue(g_sz1stSect(i), g_sz2ndSect(i))				'DB에 저장된값 가져옴
		szName	=	GetItemName(g_sz1stSect(i), g_sz2ndSect(i),  trim(szVal)) 
		
		cont01.tblMain01.SetCellString(g_szNameIdx(i), 1, szName)
		SetFgColor(g_szNameIdx(i),1)
	Next
	
	'-------------------------
	'계좌평가
	'-------------------------
	sz100Cnt	=	cont01.grdWatchAcnt01.rowcount

	szName	=	"미사용"
	
	for	i = 0 	to	sz100Cnt	- 1
		szCanYN	=	cont01.grdWatchAcnt01.GetCellData("bd_canc_yn", i)

		'if	trim(szCanYN)	<>	NULL		and	trim(szCanYN)	<> 	"Y"	then			'CANCEL값이 NULL 아니고, 등록취소가 아니면 세팅됨
		if	len(trim(szCanYN)) 	>	0	then								'전체 해지처리되고 구분만 있어도세팅될수 있게처리
			szPeriod	=	cont01.grdWatchAcnt01.GetCellData("bd_cycle", i)
			
			if	szPeriod	=	"1"	then
				szName	=	"장마감후"
			elseif	szPeriod	=	"2"	then
				szName	=	"매월말"
			elseif	szPeriod	=	"3"	then
				szName	=	"매주"
			else
				szName	=	"미사용"
			end if
		end	if

	next	

	'알림설정메인에 세팅
	cont01.tblMain01.SetCellString(CInt(g_szAcntEvalIdx), 1, szName)
	SetFgColor(CInt(g_szAcntEvalIdx), 1)
	
	'설정 그리드에 추가
	szCnt	=	cont01.grdWatch004.rowcount
	
	if	szPeriod	=	"2"	then				'월
		szPeriod	=	"3"			''' 콤보 index값
	elseif	szPeriod	=	"3"	then			'주
		szPeriod	=	"2"			''' 콤보 index값
	elseif	szPeriod	=	"1"	then			'일
		szPeriod	=	"1"			''' 콤보 index값
	else	
		szPeriod	=	"0"			''' 콤보 index값
	end if
	
	For i = 0 to sz100Cnt -1 
		szTempGrp = cont01.grdWatch004.GetCellData("bd_grp", i)
		
		if	szTempGrp	=	"A"		then		'계좌평가 있으면 
			bIsAcnt		= true
			szAcntIdx	=	i
		end	if
	next
	
	if	bIsAcnt	=	false		then
		cont01.grdWatch004.insertrow	=	szCnt
		szAcntIdx	=	szCnt
	end	if
	
	cont01.grdWatch004.SetCellData("bd_grp", szAcntIdx,  "A")
	cont01.grdWatch004.SetCellData("bd_itm", szAcntIdx, "a")
	cont01.grdWatch004.SetCellData("bd_val", szAcntIdx, szPeriod)

End Function


'============================================================================
'GetValue:	DB에 저장된 값을 가져온다.
'============================================================================
Function	GetValue( sz1stSect,	sz2ndSect)
	dim szCnt
	dim	szGrp
	dim	szItm
	dim	szVal
	dim	szSum		
	
	szCnt	=	0
	szGrp	=	""
	szItm	=	""
	szVal	=	""
	szSum	=	"0"
	
	szCnt	=	cont01.grdWatch004.rowcount

	for	i =	0	to	szCnt -1 
		szGrp	=	cont01.grdWatch004.GetCellData("bd_grp", i)
		szItm	=	cont01.grdWatch004.GetCellData("bd_itm", i)
		szVal	=	cont01.grdWatch004.GetCellData("bd_val", i)


		if	sz1stSect	=		szGrp	then
			if	sz2ndSect	=	szItm	then
				szSum	=  szSum + szVal
			end	if
		end	if
	next
 	
	return	szSum	
End Function


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("Watching 알림설정")
	
	g_szCustNum	=		Form.GetSharedData("&CUST_NUM", 0 )
	g_szUserID	=		Form.GetSharedData("&USER_ID", 0 )

	if	g_szUserID	<> null		then
		DATAMANAGER.RequestTranData("ohhts_watch_004")	
	end	if

End Sub


