		elseif lRow = 27 then  '미국시장시황
			szVal	=	GetValue("S","a")
			Form.OpenPopup("mhprc11020_pa.xmf" , "12" & "★" & szVal, sPosInfo)
		elseif lRow = 29 then  '국내시황
			szVal	=	GetValue("S","b")
			Form.OpenPopup("mhprc11020_pa.xmf" , "13" & "★" & szVal, sPosInfo)
		elseif lRow = CInt(g_szAcntEvalIdx)	then  '계좌평가수익율
			szVal	=	GetValue("A","a")
			Form.OpenPopup("mhprc11020_pa.xmf" , "14" & "★" & szVal, sPosInfo)
		end if 
	
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if	sKeyName	=	"ALARMSET_11020"	then
			DATAMANAGER.RequestTranData("ohhts_watch_004")
			'DATAMANAGER.RequestTranData("ooase_user_100r")
	
			cmbSetting.cbkeydata = "03"
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"ohhts_watch_004"	then								'워칭조건값조회(계좌평가별도)
		DATAMANAGER.SetDataValue(0,"ohhts_watch_004", "InBlock1", "FID_INPUT_WRTR_ID" , 0, g_szCustNum)
	elseif		szTranID	=	"obcsb_efif_021r"	then	
		DATAMANAGER.SetDataValue(0,"obcsb_efif_021r", "InBlock1", "ELFN_ID", 0, g_szUserID)
	elseif		szTranID =	"ooase_user_100r"	then						'워칭조건값조회(계좌평가)
		DATAMANAGER.SetDataValue(0,"ooase_user_100r", "InBlock1", "ELFN_ID", 0, g_szUserID)
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	nCnt,	nGrdCnt
	dim	szSect
	dim	bIsmore	
	
	dim	szGrpVal
	dim	szItemVal
	
	nCnt		=	0
	szSect	=	""
	bIsmore	=	false
	szGrpVal	=""
	szItemVal=""
	
	'------------------------	
	'워칭조건값조회
	'------------------------	
	if	szTranID	=	"ohhts_watch_004"	then
		nCnt	=	DATAMANAGER.GetDataCount(0, "ohhts_watch_004", "OutBlock1")
		
		'뉴스공시 삭제됨으로써 DATA자체 걸러냄
		
		for i = 0	to	nCnt	 - 1
			szGrpVal 	= DATAMANAGER.GetDataValue(0, "ohhts_watch_004", "OutBlock1", "FID_CLS01", i)
			szItemVal	= DATAMANAGER.GetDataValue(0, "ohhts_watch_004", "OutBlock1", "FID_SGNL_OCRN", i)	
			
			if	trim(szGrpVal)	=	"T"	and		trim(szItemVal)	=	"b"	then
				cont01.grdWatch004.SetDeleteRow(i)
			end	if
		next
		
		nCnt	= cont01.grdWatch004.rowcount
		
		DATAMANAGER.RequestTranData("ooase_user_100r")		'계좌평과는 별도이므로 따로 TR조회

		
	'------------------------	
	'워칭조건값등록(선택콤보에따른 세팅)
	'------------------------		
	elseif	szTranID	=	"ohhts_watch_002_1"	then		
		szSect	=	cmbSetting.currentindex
			'1. 시세및 지수정보
			'		현재가(시간별),	KOSPI/KOSDAQ지수(시간별)
			'		미국시장(마감지수 사용)
			'2. 투자정보 전송
			'		신고가(20일)		신저가(20일)
			'		급등/급락(+- 5%)	미국시장시황(사용)
			'		국내시장시황(사용)리서치리포트(사용)
			'		뉴스/시황(전체 뉴스/공시 알림)--->뉴스 시황 삭제, 오택경차장님 160324
			'3. 사용자설정
			'   		자동설정변경
	
		if	szSect	=	"0"	then
			DATAMANAGER.ClearInputData(0, "ohhts_watch_002")
			cont01.grdWatch004.SetClear()
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock1", "FID_INPUT_WRTR_ID", 0, g_szCustNum)
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS", 0, "J")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1", 0, "a")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE", 0, "4")
	
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS", 1, "I")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1", 1, "a")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE", 1, "4")
			
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS", 2, "S")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1", 2, "a")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE", 2, "1")
			
			DATAMANAGER.RequestTranData("ohhts_watch_002")
			
		elseif	szSect	=	"1"	then
			DATAMANAGER.ClearInputData(0, "ohhts_watch_002")
			cont01.grdWatch004.SetClear()
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock1", "FID_INPUT_WRTR_ID"	, 0, g_szCustNum)
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS"		, 0, "J")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1"		, 0, "b")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE"	, 0, "2")
	
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS"		, 1, "J")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1"		, 1, "c")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE"	, 1, "2")
			
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS"		, 2, "J")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1"		, 2, "d")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE"	, 2, "2")
			
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS"		, 3, "S")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1"		, 3, "a")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE"	, 3, "1")
					
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS"		, 4, "S")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1"		, 4, "b")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE"	, 4, "1")
					
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS"		, 5, "T")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1"		, 5, "a")
			DATAMANAGER.SetDataValue(0, "ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE"	, 5, "1")
			
			
			DATAMANAGER.RequestTranData("ohhts_watch_002")
		else
			DATAMANAGER.RequestTranData("ohhts_watch_004") '세팅후 재조회
		end	if
		
	'------------------------	
	'워칭조건값등록(초기화)
	'------------------------	
	elseif	szTranID	=	"ohhts_watch_002"		then
		DATAMANAGER.RequestTranData("ohhts_watch_004") 	 '세팅후 재조회
		
	'------------------------	
	'워칭조건값조회(계좌평가)	
	'------------------------	
	elseif	szTranID	=	"ooase_user_100r"		then		
	
		bIsmore	=	DATAMANAGER.IsMoreNextData("ooase_user_100r")
			
		if	bIsmore	=	true		then
			DATAMANAGER.RequestNextData("ooase_user_100r")		'데이터 MAX 30건. 30건넘으면 연속조회처리
		else
			ShowItems()										'설정된 값에 따라 보여주는 내용 세팅
		end	if
	

	'------------------------	
	'워칭조건값등록(계좌평가)	- 리셋
	'------------------------	
	elseif	szTranID	=	"ooase_user_001a"		then		
		DATAMANAGER.RequestNextData("ooase_user_100r")		
	end	if
End Sub

'============================================================================
'cmbSetting_OnEditComplete
'============================================================================
Sub cmbSetting_OnEditComplete(iIndex)
	if	iIndex	<>	2	then
		DATAMANAGER.ClearInputData(0, "ohhts_watch_002_1")
		DATAMANAGER.SetDataValue(0, "ohhts_watch_002_1", "InBlock1", "FID_INPUT_WRTR_ID", 0, g_szCustNum)
		DATAMANAGER.RequestTranData("ohhts_watch_002_1")
	end	if
		
	ResetAcntEval()
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub

