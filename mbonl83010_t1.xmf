		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "JOB_CLS_CODE" , 0 , "2" )'2: 취소
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "RSEV_YN" , 0 , "Y" )'
		
