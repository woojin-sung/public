'============================================================================
' 01. 화 면 명 : 유상청약신청_신청
' 02. 화면설명 : 유상청약신청_신청
' 03. 작    성 : 2016. 01. 20. 유창재
' 04. 수    정 : 2020. 09. 16. 성주혁 MTS 메모리 보안 v0001
' 2022.03.21 : v0002 : 신극수 : [T2203160012] 비상장종목 유상청약 시 투자설명서 교부 제외  
'============================================================================
'
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'입력받은 데이터 구분
Dim g_Chk0		'체크버튼0 체크상태
Dim g_Chk1		'체크버튼1 체크상태
Dim g_Chk2		'체크버튼2 체크상태
Dim g_szPW		'암호화 비밀번호
Dim plain_rm		'메모리평문 적용유무 v0001
Dim g_INVT_RFP_CRTN_YN 'v0002
Dim g_Sbsc_Amt
Dim g_Excs_Sbsc_Amt
Dim g_szData
Dim g_szRsevYn
Dim g_tData
dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러
dim g_szOsType '1.안드로이드 2.iOS
Dim sACNO
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szUnCheckImg = "icon_check_off.png"
	g_szCheckImg = "icon_check_on.png"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"
	
	g_InputType = 0
	g_Sbsc_Amt = 0
	g_Excs_Sbsc_Amt = 0
	
	Form.Form.SetScreenName("유상청약신청")

	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )

	
'	edt0.visible = False	
'	edt1.visible = False
	
	g_Chk0 = 0
	g_Chk1 = 0
	g_Chk2 = 0
	
	g_szData = Form.GetOpenLinkData()
	'Form.ShowAlert( "알림" , g_szData )
	'g_szList(0) :계좌번호★
	'g_szList(1) :계좌일련번호★
	'g_szList(2) :권리구분코드★
	'g_szList(3) :종목명★ 0
	
	'g_szList(4) :청약단가★ 1
	'g_szList(5) :청약가능금액★ 2
	'g_szList(6) :본배정수량★ 3
	
	'g_szList(7) :초과배정수량★ 4
	'g_szList(8) :문서명★5
	'g_szList(9) :종목코드★6
	
	'g_szList(10):권리기준일자★7
	'g_szList(11):총배정수량★8
	'g_szList(12):배정금액★ 9
	
	'g_szList(13):초과배정수량★ 10
	'g_szList(14):초과배정금액★ 11
	'g_szList(15):투자설명서★ 12
	
	'g_szList(16):총청약금액★ 16
	'g_szList(17):신청구분★
	
	'g_szList(18):청약수량★
	'g_szList(19):청약금액★
	'g_szList(20):초과청약수량★
	'g_szList(21):초과청약금액★
	g_szList	 = Split(g_szData , "★")

	sACNO = g_szList(0)
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	tbl0.SetCellString( 0 , 0, g_szList(3) ) '종목명
	tbl0.SetCellString( 1 , 2, g_szList(11) ) '총배정수량
	tbl0.SetCellString( 2 , 2, g_szList(4) ) '청약단가
	tbl0.SetCellString( 3 , 2, g_szList(16) ) '총청약금액

	if g_szList(17) = "Y" then ' 예약청약
		tbl2.SetCellString( 1 , 2, "예약신청" ) '신청구분
		if g_szList(2) = "25" then '채권청약
			tbl2.SetCellString( 1 , 2, "채권예약신청" ) '신청구분
		end if
		if trim(g_szList(18)) <> "" then
			if Cint(g_szList(18)) > 0 then
				btn0.enable = false
			end if 
		end if 
	elseif g_szList(17) = "N" then '일반청약
		tbl2.SetCellString( 1 , 2, "청약신청" ) '신청구분
		if g_szList(2) = "25" then '채권청약
			tbl2.SetCellString( 1 , 2, "채권청약신청" ) '신청구분
		end if
		if trim(g_szList(18)) <> "" then
			if Cint(g_szList(18)) > 0 then
				btn0.enable = false
			end if 
		end if 
	elseif g_szList(17) = "A" then '예약청약취소
		btn0.caption = "취소하기"
		btn0.enable = true
		edt0.enable = False
		edt1.enable = False
	elseif g_szList(17) = "X" then '일반청약 취소
		btn0.caption = "취소하기"
		btn0.enable = true
		edt0.enable = False
		edt1.enable = False
	end if 
	
	tbl2.SetCellString( 2 , 2, g_szList(6) ) '배정수량
	tbl2.SetCellString( 5 , 2, g_szList(7) ) '초과배정수량
	tbl2.SetCellString( 8 , 2, g_szList(5) ) '청약가능금액
	
	edt0.caption = g_szList(18)
	edt1.caption = g_szList(20)
	if trim(g_szList(18)) <> "" then
		if Cint(g_szList(18)) > 0 then
			call edt0_OnEditComplete()
		else
			call make_zero()
		end if 
	end if 
	g_szRsevYn = g_szList(17) '예약청약여부
End Sub
