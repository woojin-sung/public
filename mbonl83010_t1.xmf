' btn1_OnClick() : 투자설명서 다운로드 버튼시
'============================================================================

''============================================================================
'' Form_OnTriggerEvent(sEventName, sParam) : 계좌번호, 구분코드, 비밀번호 입력받음
''============================================================================
'Sub Form_OnTriggerEvent(sEventName, sParam)
'	
'End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 보안매체 처리하기 위한 TR 입력
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO_PWD ', sACNO 
		
		sDeviceID = Form.GetDeviceID()
		'sACNO = g_szList(0)
		
		'v0001
		'AS-IS
		'sACNO_PWD = Form.GetEncData(g_szList(2))
		
		'TO-BE
		'obcsb_oimf_625r 에 pw전달하지 않아도됨. 기존 g_szList(2)는 rght_type_code로, 잘못된 값 전달중이었음. 삭제처리.
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		'DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	ELSEIf szTranID == "obrgt_stsb_201a" Then

	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szVolume
	
	if szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	elseif szTranID == "obrgt_stsb_201a" or szTranID == "obrgt_stsb_101a" then			'유상청약 처리후
		Form.ShowAlert( "알림" , "청약이 취소 되었어요." )
		'Form.CloseForm()					'청약신청이 끝나면 화면 종료
		Form.SetSharedData("ACNO_83010", g_szList(0)..g_szList(1))
		Form.OpenScreen( "83010" , "")
	end if
End Sub
	
'============================================================================
' make_zero() : 셀에 에디트 입력값 세팅
'============================================================================
Sub make_zero()
	Subs_res = 0
	tbl2.SetCellString( 9, 2, Subs_res)'수량 초기화
	tbl2.SetCellString( 10, 2, Subs_res)'금액 초기화
End sub
'============================================================================
' tbl0_OnClick(lRow , lColumn) : 버튼 클릭시 에디트창 활성화
'============================================================================

'============================================================================
' edt0_OnEditComplete() : 셀에 에디트 입력값 세팅
'============================================================================
Sub edt0_OnEditComplete()
	Dim nnSubs_AMT			'본청약 금액
	Dim nSubs_Amount		'수량 합계
	Dim nSubs_res			'초기화
	Dim nSubs_money		'총청약금액
	
	if edt0.caption == "" then
		edt0.caption = 0
	end if

	if Cint(edt0.caption) > Cint(g_szList(6)) then
		Form.ShowAlert( "알림" , "신청수량이 청약가능수량보다 큽니다" )
		edt0.caption = 0
	end if 
	
	Subs_res = 0
	tbl2.SetCellString( 9, 2, Subs_res)'수량 초기화
	tbl2.SetCellString( 10, 2, Subs_res)'금액 초기화
		
	if tbl0.GetCellString( 2 , 2) <> "" then '청약단가
		if edt0.caption <> "" then 
			nnSubs_AMT = edt0.caption * tbl0.GetCellString( 2 , 2)		'본청약금액 = 본청약수량*청약단가
		else
			nnSubs_AMT =  0
		end if
	else
		nnSubs_AMT = edt0.caption * 0
	end if
	
	g_Sbsc_Amt = nnSubs_AMT
	
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "SBSC_AMT" , 0 , nnSubs_AMT)			'청약금액
	
	Call Calc_stsb_Amt()
End Sub
'============================================================================
' edt1_OnEditComplete() : 셀에 에디트 입력값 세팅
'============================================================================
Sub edt1_OnEditComplete()
	Dim nnSubs_AMT			'초과청약금액
	Dim nSubs_Amount		'수량 합계
	Dim nSubs_res			'초기화
	Dim nSubs_money		'총청약금액
	
	if edt1.caption == "" then
		edt1.caption = 0
	end if
	
	if Cint(edt0.caption) <> Cint(g_szList(6)) then
		Form.ShowAlert( "알림" , "청약가능수량 전량 입력 후,"&chr(13)&"(초과)신청수량 입력이 가능합니다." )
		edt1.caption = 0
	end if 
		

	if Cint(edt1.caption) > Cint(g_szList(7)) then
		Form.ShowAlert( "알림" , "신청수량이 (초과)청약가능수량보다 큽니다" )
		edt1.caption = 0
	end if 
	
	Subs_res = 0
	tbl2.SetCellString( 9, 2, Subs_res)'수량 초기화
	tbl2.SetCellString( 10, 2, Subs_res)'금액 초기화
	
	if tbl0.GetCellString( 2 , 2) <> "" then '청약단가
		if edt1.caption <> "" then 
			nSubs_AMT = edt1.caption * tbl0.GetCellString( 2 , 2)		'초과청약금액 = 초과청약수량*청약단가
		else
			nSubs_AMT =  0
		end if
	else
		nSubs_AMT = edt1.caption * 0
	end if
	
	g_Excs_Sbsc_Amt = nSubs_AMT
	
	tbl1.SetCellString( 0, 1, nSubs_AMT)
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_SBSC_AMT" , 0 , nSubs_AMT)		'초과청약금액
	
	Call Calc_stsb_Amt()
End Sub
'============================================================================
' Calc_stsb_Amt()
'============================================================================
Sub Calc_stsb_Amt()
	Subs_Amount = edt0.caption + edt1.caption

	if Cint(Subs_Amount) > 0 then
		tbl2.SetCellString( 9, 2, Subs_Amount)
		btn0.enable 	= True

	else
		tbl2.SetCellString( 9, 2, 0)
		btn0.enable = False

	end if 
	if tbl0.GetCellString( 2 , 2) <> "" then '청약단가
		if edt0.caption <> "" then
			tmp_0 = edt0.caption
		else
			tmp_0 = 0
		end if
		
		if edt1.caption <> "" then
			tmp_1 = edt1.caption
		else
			tmp_1 = 0
		end if
		
		nSubs_money = (tmp_0 + tmp_1) * tbl0.GetCellString( 2 , 2)
	else
		nSubs_money = 0
	end if
	tbl2.SetCellString( 10, 2, nSubs_money)
End Sub
