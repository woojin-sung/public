' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim subMsg

	if szTranID == "obrgt_stsb_201a" or szTranID == "obrgt_stsb_101a" then
		subMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox("알림", szErrMsg&"\n("&subMsg&")", 0, 6)
	end if
	
End Sub
