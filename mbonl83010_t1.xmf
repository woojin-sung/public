	'g_szList(3) :종목명★ 0
	
	'g_szList(4) :청약단가★ 1
	'g_szList(5) :청약가능금액★ 2
	'g_szList(6) :본배정수량★ 3
	
	'g_szList(7) :초과배정수량★ 4
	'g_szList(8) :문서명★5
	'g_szList(9) :종목코드★6
	
	'g_szList(10):권리기준일자★7
	'g_szList(11):총배정수량★8
	'g_szList(12):배정금액★ 9
	
	'g_szList(13):초과배정수량★ 10
	'g_szList(14):초과배정금액★ 11
	'g_szList(15):투자설명서★ 12
	
	'g_szList(16):총청약금액★ 16
	'g_szList(17):신청구분★
	
	'g_szList(18):청약수량★
	'g_szList(19):청약금액★
	'g_szList(20):초과청약수량★
	'g_szList(21):초과청약금액★
	
	'g_szList(17)~g_szList(20) 추가
	'g_szData = g_szData& "★" & edt0.caption & "★" & g_Sbsc_Amt & "★" & edt1.caption & "★" & g_Excs_Sbsc_Amt
	g_szData = g_szList(0) & "★" & g_szList(1)  & "★" & g_szList(2)  & "★" & g_szList(3) & "★" & 
	           g_szList(4) & "★" & g_szList(5)  & "★" & g_szList(6)  & "★" & 
			  g_szList(7) & "★" & g_szList(8)  & "★" & g_szList(9)  & "★" & 
			  g_szList(10)& "★" & g_szList(11) & "★" & g_szList(12) & "★" & 
			  g_szList(13)& "★" & g_szList(14) & "★" & g_szList(15) & "★" & 
			  g_szList(16)& "★" & g_szList(17) & "★" & 
			  edt0.caption & "★" & g_Sbsc_Amt & "★" & edt1.caption & "★" & g_Excs_Sbsc_Amt
			  
	
	
	if g_szList(17) = "Y" or g_szList(17) = "N" then ' 예약청약 or 일반청약
		if edt0.caption = "" then
			Form.MsgBox( "알림", "청약수량을 입력하세요", "", 6 )
			exit sub
		end if 
		if Cint(edt0.caption) = 0 then
			Form.MsgBox( "알림", "청약수량을 입력하세요", "", 6 )
			exit sub
		end if 
		'Form.openPopupAnimation("mbonl83010_p1",g_szData, "","2")
		'Form.MsgBox("알림", g_szData, 0, 6)
		Form.openPopup("mbonl83010_p1",g_szData, "")
		'Form.OpenFramePopup("mbonl83010_p1" , g_szData , sPosInfo)
	elseif g_szList(17) = "A" or g_szList(17) = "X" then '예약청약취소 or 일반청약 취소
		Form.MsgBox("알림", "청약취소 하시겠습니까?", "deleteokcancel", 1)
		
	end if 
End Sub
