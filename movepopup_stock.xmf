Dim g_szItemCode,g_szItemMarket
Dim g_szSelectedItem

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()

'	szMk = "J"
'	szCd = "005930"
	
'	Request_113r()
'	Request_001r()
'	Request_002r()
	

	
End Sub

'============================================================================
Sub Request_113r() '대표시장
	
	DATAMANAGER.SetDataValue(0, "ohhts_1001_113r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , szMk)
	DATAMANAGER.SetDataValue(0, "ohhts_1001_113r", "InBlock1", "FID_INPUT_ISCD", 0 , szCd)
	DATAMANAGER.RequestTranData("ohhts_1001_113r")

End Sub
'============================================================================
Sub Request_001r()

	DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , szMk)
	DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCd)
	DATAMANAGER.RequestTranData("ohhts_1001_001r")

End Sub

'============================================================================
Sub Request_002r() '기관/외인 데이터
	
	DATAMANAGER.SetDataValue(0, "ohhts_1086_002r", "InBlock1", "FID_INPUT_ISCD", 0 , szCd)
	DATAMANAGER.RequestTranData("ohhts_1086_002r")

End Sub
'============================================================================
Sub Request_indexName()

	szIndexName  = Form.GetItemCodeInfo( szCd , "indexname")
	'Container0.Table0.SetCellString(0, 2, szIndexName)
	Container1.Button1.caption = "#" & szIndexName
End Sub


'============================================================================
Sub Request_Scale()
	
	scalecode =  Form.GetItemCodeInfo( szCd, "scalecode" )
		
	if scalecode == "0" or scalecode == 0 then
		szScalecode = "제외"
	elseif scalecode == "1" or scalecode == 1 then
		szScalecode = "대형주"
	elseif scalecode == "2" or scalecode == 2 then
		szScalecode = "중형주"
	elseif scalecode == "3" or scalecode == 3 then
		szScalecode = "소형주"
	else
		szScalecode = ""
	end if
	
	'Container0.Table0.SetCellString(0, 4, szScalecode)
	Container1.Button2.caption = "#" & szScalecode
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "ohhts_1001_113r" then
		szMk_Kor_Name = DATAMANAGER.GetDataValue(0, "ohhts_1001_113r", "OutBlock1", "FID_RPRS_MRKT_KOR_NAME" , 0)
		Container1.Button0.caption = "#" & szMk_Kor_Name
		
		if szMk_Kor_Name == "ETF" or szMk_Kor_Name =="ETN" or szMk_Kor_Name == "ELW" then
			Container1.Button0.visible = true
			Container1.Button1.visible = false
			Container1.Button2.visible = false
			
			
		elseif szMk_Kor_Name == "" then
			Container1.Button0.visible = false
			Container1.Button1.visible = false
			Container1.Button2.visible = false
			
		
		else
			Container1.Button0.visible = true
			Container1.Button1.visible = true
			Container1.Button2.visible = true
			
			
		
			
			Request_Scale()
			Request_indexName()
		end if
	
	elseif szTranID = "ohhts_1001_001r" then
	
		szBstp_Kor_Name = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_RPRS_BSTP_KOR_ISNM" , 0)
				
		
	end if
	
End Sub

'============================================================================
Sub Container1_FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 or nCurrentTab == "0" then
		Container1.page.caption = "●○○"
	elseif nCurrentTab == 1 or nCurrentTab == "1" then
		Container1.page.caption = "○●○"
	elseif nCurrentTab == 2 or nCurrentTab == "2" then
		Container1.page.caption = "○○●"
	end if
	
	Form.triggerEvent("FormTab0." & Container1.FormTab0.currenttabpageid, "INIT_CODE", g_szItemCode)
	
	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "SelectCode" then
		g_szItemCode = sParam
		g_szSelectedItem = sParam 
		Form.triggerEvent("FormTab0." & Container1.FormTab0.currenttabpageid, "INIT_CODE", sParam)
		
		
		'상단 업종/시장 조회
		szMk = Form.GetItemCodeInfo(sParam, "market")
		szCd = sParam
		'Form.ShowAlert(sParam, szMk)
'		if szMk == "F" or szMk == "O" or szMk == "MF" then
'			Container1.Button0.visible = false
'			Container1.Button1.visible = false
'			Container1.Button2.visible = false
'		else	
'			Container1.Button0.visible = true
'			Container1.Button1.visible = true
'			Container1.Button2.visible = true
			
			Request_113r()
			Request_001r()
			Request_002r()
		'end if
		
	end if
		
End Sub

'============================================================================
Sub Container1_Button3_OnClick() '현재가

	Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
	
End Sub

'============================================================================
Sub Container1_Button4_OnClick() '차트

	Form.OpenScreen("13000" , g_szSelectedItem) 

End Sub

'============================================================================
Sub Container1_Button5_OnClick() '뉴스

	Form.OpenScreen("44000" , g_szSelectedItem ) 

End Sub

'============================================================================
Sub Container1_Button6_OnClick() '매도

	Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem )


End Sub

'============================================================================
Sub Container1_Button7_OnClick() '매수

	Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem ) 

	
End Sub

