	<SCRIPT_INFO _len="3171" _ulen="3029" >
'============================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szFncd
'============================================================================
' 펀드코드 가져오기 컨트롤러 설정
'============================================================================
Sub Form_OnFormInitBefore()
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	g_szFncd = edtFundCd.caption
End Sub
'============================================================================
Sub Form_OnFormInit()

	if len(trim(g_szFncd)) > 0 Then			
		Call_Tran()
	End if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' 상단 해외주식자산 평가
	DATAMANAGER.SetDataValue( false, "obtro_oder_303r", "InBlock1", "FNCD"					, 0 , g_szFncd) 
	DATAMANAGER.SetDataValue( false, "obtro_oder_303r", "InBlock1", "PROD_PSTN_CLS_CODE"		, 0 , "1" )
End Sub
'============================================================================
Sub Call_Tran()
	
	' 상단 해외주식자산 평가
	DATAMANAGER.RequestTranData("obtro_oder_303r")

	if Cint(fmtab0.currenttab) = 0 then
		Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "REQUEST", g_szFncd)
	else
		Form.ShowAlert("Error", "유효하지않은 탭입니다.")
		exit sub
	end if

End Sub

'============================================================================
Sub btnSearch_OnClick()
	g_szFncd = edtFundCd.caption
	Call_Tran()
End Sub
'============================================================================
' 탭 변경시
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	Call_Tran()	
End Sub

'============================================================================
' 펀드코드 변경시 
'============================================================================
Sub edtFundCd_OnEditComplete()
	
	If Len(edtFundCd.caption) < 1 Then
		g_szFncd = ""
	End if
	
	g_szFncd = edtFundCd.caption
	Call_Tran()
End Sub
'============================================================================
' 돋보기 클릭
'============================================================================
Sub btnFncd_OnClick()
	Form.OpenFramePopup("nhnts00001_p1" , "", "")
End Sub
'============================================================================
' 돋보기 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "FUNDINFO" then
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
		end if 
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID == "obtro_oder_303r" then
		'데이터 없음
		if szErrCode = "5820" then
			' Set 0
			Table0.SetCellString(1, 1, 0)
			Table0.SetCellString(1, 3, 0)
			Table0.SetCellString(2, 1, 0)
			Table0.SetCellString(2, 3, 0)
		end if
	end if
End Sub
