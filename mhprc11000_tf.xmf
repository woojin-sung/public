'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 종합시세탭(K-OTC)
' 03. 작    성 : 2018.08.09 HAMWG
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_szItemMarket, g_szgrdHeader
Dim g_sztog1

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

End Sub

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then		
			DATAMANAGER.RequestTranData( "ohhts_1204_001r" )
		End If
		'20180712 HAMWG END
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If	
	
		g_szItemCode = sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then		
			DATAMANAGER.RequestTranData( "ohhts_1204_001r" )
		End If
		'20180712 HAMWG END
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID = "ohhts_1204_001r" then
		    
	    For i=0 to Grid0.rowcount-1 
		    szCd = Grid0.GetCellData("bd_cell0", i)
		    DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", i, szCd)
	    Next
	    
	    DATAMANAGER.CancelRealData("ohhts_frbr_cntg")
	    
	    nRankSort = Cint(Combo0.currentindex) + 1
	    nRdoIdx = Cint(RadioGroup0.currentindex)   
	    
	    szBlngClsCd = ""
	    if nRdoIdx = 0 then
		    szBlngClsCd = "0"
	    elseif nRdoIdx = 1 then
		    szBlngClsCd = "5"
	    elseif nRdoIdx = 2 then
		    szBlngClsCd = "4"
	    else
		    szBlngClsCd = "0"
	    end if

	    DATAMANAGER.SetDataValue( 0 , "ohhts_1204_001r" , "InBlock1" , "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "T")	    
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1204_001r" , "InBlock1" , "FID_INPUT_COND_SCR_DIV_CODE"  , 0 , "1204")
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1204_001r" , "InBlock1" , "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , nRankSort)
	    DATAMANAGER.SetDataValue( 0 , "ohhts_1204_001r" , "InBlock1" , "FID_INPUT_BLNG_CLS_CODE" , 0 , szBlngClsCd)   
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    if szTranID = "ohhts_1204_001r" then
		if g_szItemMarket = "T" then
		
		For i=0 to Grid0.rowcount-1 
		    szCd = Grid0.GetCellData("bd_cell0", i)
		    DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", i, szCd)
		Next
		
		DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		end if
    end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData( "ohhts_1204_001r" )
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	DATAMANAGER.RequestTranData( "ohhts_1204_001r" )
End Sub

