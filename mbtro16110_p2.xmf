'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 약관 동의 팝업
' 02. 화면설명 : 보유주식 수익 서비스 약관 동의 팝업
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

Dim g_sRetData 					'리턴데이터
Dim g_szTheme                  		'테마구분  white/black
dim g_szUnCheckImg, g_szCheckImg	'체크이미지
dim g_szUnCheckFg, g_szCheckFg		'체크 폰트 컬러
Dim g_ChkAll						'전체동의여부
Dim g_Chk1						'첫번째 약관
Dim g_Chk2						'두번째 약관

Dim g_bAllView					'전체보기 상태 여부

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	Select Case iIdx
		Case 1
			szTitle = "개인정보제공 및 활용동의"
		Case 2
			szTitle = "개인정보제공 및 활용동의"
	End Select
	return szTitle
End Function

'============================================================================
'f_sGetURL(iIdx) : 각 동의체크 별 안내팝업 URL 리턴
'============================================================================
Function f_sGetURL(iIdx)		
	dim sURLheader, sURL
	Select Case iIdx
		Case 1
			'"보유주식 수익 서비스 약관"
			If g_ServerMode == "1" Then	'개발기
				sURLheader = "http://211.201.184.87/include/resource/comm/ctcn/pdf/"
			Else
				sURLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "crinoferagrm14.pdf"
		Case 2
			'"보유주식 수익 서비스 핵심설명서"
			If g_ServerMode == "1" Then	'개발기
				sURLheader = "http://211.201.184.87/include/resource/comm/ctcn/pdf/"
			Else
				sURLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "crinoferagrm15.pdf"
	End Select
	
	return sURL
End Function

'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)
	'전체 동의
	if iIdx == 0 then
		szURL = f_sGetURL(1) & "★" & f_sGetURL(2)
		szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2)
		
		g_bAllView = true
		
		'팝업 호출
		if szURL <> "" then
			Form.OpenPopup("mbtro16110_p3" , szURL&"♥"&szTitle, "")
		end if		
	
	'개인신용정보 동의 개별 팝업 
	elseif iIdx == 1 Then
		szURL = f_sGetURL(1) & "★" & f_sGetURL(2)
		szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2)
		
		g_bAllView = false
		
		'팝업 호출
		if szURL <> "" then
			Form.OpenPopup("mbtro16110_p3" , szURL&"♥"&szTitle, "")
		end if
	
	'고객 유의사항 개별 팝업
	else
		g_bAllView = false
		
		'고객 유의사항 팝업
		Form.OpenPopup("mbtro16110_p5" , "" , "")
	end if
	
	Form.SetSharedData("mbtro16110_Agree_AllYn" , g_bAllView)
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()

	g_ChkAll = "0"	
	imgUIAllChk.imgpath = g_szUnCheckImg
	lblAllText.fgcolor  = g_szUnCheckFg			
	

	if g_Chk1 <> "1" then
		BtnContinue.enable = false
		if g_Chk2 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		
		Exit Function	
	end if
	
	if g_Chk2 <> "1" then
		BtnContinue.enable = false

		if g_Chk1 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function	
	end if	
	
	g_ChkAll = "1"	
	imgUIAllChk.imgpath = g_szCheckImg
	lblAllText.fgcolor  = g_szCheckFg			
	
	'신청가능
	BtnContinue.enable = true
	
	'BtnContinue.imgpath = "btn_01.9"
	
End Function

'============================================================================
'각 체크 별 기능 동작
'============================================================================
Function f_SetChkState(iIdx, bValue)

	'전체동의
	if iIdx == 0 then
	
		if bValue == true then	
		
			g_ChkAll = "1"	
			imgUIAllChk.imgpath = g_szCheckImg
			lblAllText.fgcolor  = g_szCheckFg			
		
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
			
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg			
		else
			g_ChkAll = "0"	
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg			
			
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
			
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg			
		end if	
	
	'약관동의
	elseif iIdx == 1 then
	
		if bValue == true then	
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
		else
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
		end if		
	
	'핵심설명서 동의
	elseif iIdx == 2 then
	
		if bValue == true then	
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg
		else
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg
		end if		
		
	end if
	
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()	
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	g_szUnCheckImg 	= "icon_chk_on.png"
	g_szCheckImg 		= "icon_chk_off.png"
	g_szUnCheckFg 	= "127"
	g_szCheckFg 		= "4"	
End Sub


'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동Y
	'부모창(mbonl88024) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

     '이미지설정
	'imgBg.imgpath       = "alpha128"
	'imgExit.imgpath     = "icon_close"
	'If g_szTheme = "black" Then
	'	BtnCancel.imgpath   = "btn_27.9"   
	'Else
	'	BtnCancel.imgpath   = "btn_27.9"  'white모드도 동일 
	'End If
	'BtnContinue.imgpath = "btn_09.9"

	'초기화..	
	f_SetChkState(0, false)	
	
	g_sRetData = "cancel"
	
	'신청가능
	BtnContinue.enable = false	

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	Form.ShowAlert(sKeyName, sRet)
	'약관팝업	
	if sKeyName == "mbtro16110_p3" then
'		if sRet == "AGREE" then		
'			f_SetChkState(1, true)
'		elseif sRet == "cancel" then	
'			f_SetChkState(1, false)
'		end if		

		If g_bAllView Then
			f_SetChkState(0, true)
		Else
			If sRet == "ok" Then
				f_SetChkState(1, true)
			Else
				f_SetChkState(1, false)
			End If
		End If
	
	'고객유의사항 팝업
	elseif sKeyName == "mbtro16110_p5" then
		f_SetChkState(2, true)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_168a" then 	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "029")	
	end if
End Sub

'============================================================================
Sub BtnContinue_OnClick()
	if g_Chk1 = "1" and g_Chk2 = "1" then
		g_sRetData = "ok"			
	else
		g_sRetData = "cancle"		
	end if 
	
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동N 원복(부모화면에서 호출했던 상태로)
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	Form.SendReturnToParent( "mbtro16110_p2" , g_sRetData )	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 약관 띄움
'============================================================================
Sub imgChk0_OnClick()	
	if CInt(g_Chk1) == 1 then
		f_SetChkState(1, false)
	else
		f_OpenChkPopup(1)
	end if		
End Sub

'============================================================================
' 핵심설명서 띄움
'============================================================================
Sub imgChk1_OnClick()	
	if CInt(g_Chk2) == 1 then
		f_SetChkState(2, false)
	else
		f_OpenChkPopup(2)
	end if	
End Sub

'============================================================================
' 필수약관에 모두 동의 클릭
'============================================================================
Sub btnAllChk_OnClick()
	if CInt(g_ChkAll) == 1 then
		f_SetChkState(0, false)		
	else
		f_OpenChkPopup(0)
	end if		
End Sub

