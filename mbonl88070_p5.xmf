<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="88070" scrname="발행어음_상품가이드" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="lblTitleMain" fontsize="3" fontstyle="01" paddinginfo="1,0,0,0" ly_vert="60,0,300,50,1" />
		<IMAGE name="imgInfo" autosize="1" imgpath="icon_notice" ly_vert="328,14,22,22,1" />
		<IMAGE name="imgBack" autosize="1" imgpath="icon_top_back_light" ly_vert="20,15,20,20,1" />
		<TAB name="Tab0" tabheadheight="48" tabwidthtype="1" tabcount="2" ly_vert="20,35,335,48,1" >
			<PAGE name="page005062" caption="발행어음안내" >
				<CONTROL_INFO/>
			</PAGE>
			<PAGE name="page005062" caption="가입안내" >
				<CONTROL_INFO/>
			</PAGE>
		</TAB>
		<CONTAINER name="contTab1" vscroll="1" scroll_pos="0,0" ly_vert="0,83,375,564,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblTitle1" fontsize="4" fontstyle="01" caption="발행어음이란?" paddinginfo="1,0,0,0" ly_vert="20,20,200,20,1" />
				<LABEL name="lblText1" fontsize="-2" caption="고객을 수취인으로 하고 회사를 지급인으로 하여 고객의 요청에 따라 1년 이내의 만기 및 약정수익률로 회사가 발행한 어음을 말합니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,53,335,60,1" />
				<IMAGE name="imgInfo1" autosize="1" imgpath="img_info" ly_vert="20,120,335,120,1" />
				<LABEL name="lblTitle2" fontsize="4" fontstyle="01" caption="발행어음의 특징" paddinginfo="1,0,0,0" ly_vert="20,355,200,20,1" />
				<LABEL name="lblText2" fontsize="-2" caption="증권사는 고객이 맡긴 돈을 다양하게 자산에 투자하고 약속한 기간이 지나면 고객에게 원금과 수익을 돌려줍니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,253,335,40,1" />
				<IMAGE name="imgCircle0" imgpath="img_bgcircle_issuednote_352.9" ly_vert="20,397,335,40,1" />
				<IMAGE name="imgJoin" autosize="1" imgpath="icon_title_join" ly_vert="123,407,20,20,1" />
				<LABEL name="lblCircleText0" fontsize="-2" fontstyle="01" caption="편리한 가입절차" paddinginfo="1,0,0,0" ly_vert="152,401,200,32,1" />
				<LABEL name="lblCircleSub0" fontsize="-3" caption="· 당사 영업점 및 MTS/HTS를 통해 편리하게 투자할 수
    있습니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,442,335,40,1" />
				<IMAGE name="imgCircle1" imgpath="img_bgcircle_issuednote_352.9" ly_vert="20,504,335,40,1" />
				<IMAGE name="imgCal" autosize="1" imgpath="icon_title_cal" ly_vert="123,514,20,20,1" />
				<LABEL name="lblCircleText1" fontsize="-2" fontstyle="01" caption="자유로운 가입기간" paddinginfo="1,0,0,0" ly_vert="152,508,200,32,1" />
				<LABEL name="lblCircleSub1" fontsize="-3" caption="· 예치기간 1년 이내에서 고객이 투자기간을 설정 가능한
    맞춤 상품입니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,549,335,40,1" />
				<IMAGE name="imgCircle2" imgpath="img_bgcircle_issuednote_352.9" ly_vert="20,609,335,40,1" />
				<IMAGE name="imgGraph" autosize="1" imgpath="icon_chart" ly_vert="123,619,20,20,1" />
				<LABEL name="lblCircleText2" fontsize="-2" fontstyle="01" caption="안정적인 수익제공" paddinginfo="1,0,0,0" ly_vert="152,613,200,32,1" />
				<LABEL name="lblCircleSub2" fontsize="-3" caption="· 발행사가 직접 발행하고 원리금을 지급하는 상품입니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,654,335,24,1" />
				<LABEL name="lblCircleSub3" fontsize="-3" caption="· 하루만 돈을 맡겨도 사전에 약속한 수익금을 지급합니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,680,335,24,1" />
				<IMAGE name="imgCircle3" imgpath="img_bgcircle_issuednote_352.9" ly_vert="20,724,335,40,1" />
				<IMAGE name="imgCoin" autosize="1" imgpath="icon_title_coin" ly_vert="123,734,20,20,1" />
				<LABEL name="lblCircleText3" fontsize="-2" fontstyle="01" caption="효율적인 자금관리" paddinginfo="1,0,0,0" ly_vert="152,728,200,32,1" />
				<LABEL name="lblCircleSub4" fontsize="-3" caption="· 고객이 원하는 투자기간, 투자금액, 투자유형을 설정할 수
    있어 자금관리를 효율적으로 할 수 있습니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,769,335,40,1" />
				<LABEL name="lblCircleSub5" fgcolor="326:228073065" fontsize="-2" caption="※ 발행어음은 예금자보호법에 따라 예금보험공사가
    보호하지 않습니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,829,335,40,1" />
				<LABEL name="lblTitle3" fontsize="4" fontstyle="01" caption="발행어음의 종류" paddinginfo="1,0,0,0" ly_vert="20,930,200,20,1" />
				<LABEL name="lblLine1" bgcolor="322:226228229" transmode="0" ly_vert="0,322,375,1,1" />
				<LABEL name="lblLine0" bgcolor="322:226228229" transmode="0" ly_vert="0,898,375,1,1" />
				<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="4" outline="0000" designorder="1" ly_vert="20,968,335,305,1" >
					<COL_INFO ly_vert_width="74,261" />
					<ROW_INFO ly_vert_height="90,90,90,35" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" caption="수시형" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" line="0,1" caption="하루를 맡겨도 고객이 매수한 약정수익률로
이자가 지급되는 수시입출금식 상품입니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,1" caption="약정형" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="0,1" caption="투자기간 365일 이내에서 고객이 원하는
만기일을 자유롭게 선택하는 상품이며,
만기일 이전 중도상환 시 중도상환수익률이
적용됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" line="1,0" caption="발행어음
CMA" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="CMA 계좌에서 예치된 투자예탁금을 매일
일정한 시간에 발행어음에 자동 투자하는
서비스를 제공하는 상품입니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
						<CELL cell_ly="1,3,1,3" line="0,0" impidxs="" />
					</CELL_INFO>
				</TABLE>
			</CONTROL_INFO>
		</CONTAINER>
		<CONTAINER name="contTab2" vscroll="1" scroll_pos="0,0" ly_vert="1000,103,375,544,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblTitle" fontsize="4" fontstyle="01" caption="발행어음 매매방법" paddinginfo="1,0,0,0" ly_vert="20,20,200,20,1" />
				<LABEL name="lblBg0" transmode="0" ly_vert="20,55,335,104,1" />
				<LABEL name="lblBg1" transmode="0" ly_vert="20,159,335,122,1" />
				<LABEL name="lblBg2" transmode="0" ly_vert="20,281,335,122,1" />
				<LABEL name="lblBg3" transmode="0" ly_vert="20,403,335,122,1" />
				<IMAGE name="imgTri0" autosize="1" imgpath="img_polygon_01" ly_vert="162,158,50,14,1" />
				<IMAGE name="imgTri1" autosize="1" imgpath="img_polygon_02" ly_vert="162,280,50,14,1" />
				<IMAGE name="imgTri2" autosize="1" imgpath="img_polygon_03" ly_vert="162,402,50,14,1" />
				<LABEL name="lblTitle0" fontstyle="01" caption="1단계" halign="1" ly_vert="20,68,335,20,1" />
				<LABEL name="lblText0" fontsize="-3" caption="- 영업점에 내점하여 가입 하실 수 있습니다." ly_vert="20,95,335,20,1" />
				<LABEL name="lblText3" fontsize="-3" caption="- 온라인채널(HTS, MTS)의 발행어음 메뉴로 진입합니다." ly_vert="20,115,335,20,1" />
				<LABEL name="lblTitle4" fontstyle="01" caption="2단계" halign="1" ly_vert="20,178,335,20,1" />
				<LABEL name="lblText4" fontsize="-3" caption="- 영업점에서 상담을 통한 발행어음 종목을 선택합니다." ly_vert="20,205,335,20,1" />
				<LABEL name="lblText5" fontsize="-3" caption="- 온라인채널(HTS, MTS)에서 투자할 종목을 직접 선택
   합니다." valign="0" multiline="1" ly_vert="20,227,335,40,1" />
				<LABEL name="lblText6" fontsize="-3" caption="- 거래하실 계좌를 선택하고, 투자기간고 매수금액을
   입력합니다." valign="0" multiline="1" ly_vert="20,325,335,40,1" />
				<LABEL name="lblText7" fontsize="-3" caption="- 예상이자와 만기지급금액(예정)을 확인합니다." ly_vert="20,362,335,20,1" />
				<LABEL name="lblTitle5" fontstyle="01" caption="3단계" halign="1" ly_vert="20,298,335,20,1" />
				<LABEL name="lblTitle6" fontstyle="01" caption="4단계" halign="1" ly_vert="20,423,335,20,1" />
				<LABEL name="lblText8" fontsize="-3" caption="- 만기일에 자동으로 상환 입금된 금액을 확인합니다." ly_vert="20,450,335,20,1" />
				<LABEL name="lblText9" fontsize="-3" caption="- 만기 이전에 출금을 원할 경우 발행어음 매도(중도상환)
   하여 당일 출금할 수 있습니다." valign="0" multiline="1" ly_vert="20,472,335,40,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1942" _ulen="1942" >

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
	contTab1.imgInfo1.setMaintainingRatio("1")
	contTab1.imgJoin.setMaintainingRatio("1")
	contTab1.imgCal.setMaintainingRatio("1")
	contTab1.imgGraph.setMaintainingRatio("1")
	contTab1.imgCoin.setMaintainingRatio("1")
	contTab2.imgTri0.setMaintainingRatio("1")
	contTab2.imgTri1.setMaintainingRatio("1")
	contTab2.imgTri2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contTab1.lblTitle1.setHighlight(332)
	contTab1.lblTitle2.setHighlight(332)
	contTab1.lblTitle3.setHighlight(332)
	
	contTab2.lblTitle.setHighlight(332)
	
	contTab1.lblCircleSub0.changeTextAttr(0, 1, 4, 5, false)
	contTab1.lblCircleSub1.changeTextAttr(0, 1, 4, 5, false)
	contTab1.lblCircleSub2.changeTextAttr(0, 1, 4, 5, false)
	contTab1.lblCircleSub3.changeTextAttr(0, 1, 4, 5, false)
	contTab1.lblCircleSub4.changeTextAttr(0, 1, 4, 5, false)
	
	contTab1.Table0.SetCellBgColor(0, 0, 353)
	contTab1.Table0.SetCellBgColor(1, 0, 354)
	contTab1.Table0.SetCellBgColor(2, 0, 355)
	
	contTab2.lblBg0.bgcolor = 353
	contTab2.lblBg1.bgcolor = 354
	contTab2.lblBg2.bgcolor = 355
	contTab2.lblBg3.bgcolor = 356
	
	contTab1.left = 0
	contTab2.left = 1000
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 then
		contTab1.left = 0
		contTab2.left = 1000
	else
		contTab1.left = 1000
		contTab2.left = 0
	end if
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.OpenFramePopup("mbonl88070_p6" , "" , "")
End Sub

