						<CELL cell_ly="0,3,0,3" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" caption="위해 가입자는 메리츠증권 또는 해외거래소에서 요청" fontsize="-3" impidxs="" />
