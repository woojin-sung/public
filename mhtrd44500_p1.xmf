						<CELL cell_ly="0,7,0,7" caption="(i)" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" caption="해외거래소 또는 기타 감사자들이 가입자의 기록 및 정보" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,8,0,8" fontsize="-2" impidxs="" />
