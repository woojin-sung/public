	<SCRIPT_INFO _len="3593" _ulen="3233" >
--===========================================================================
--===========================================================================

Dim g_szEngName		'구독자 영문이름
Dim g_szEngAddress	'구독자 영문주소
Dim g_szEngJob		'구독자 영문직업명
Dim g_szEngCompany	'구독자 영문회사명
Dim g_szEngWorkAddr	'구독자 영문회사주소

Dim g_szAgreeData			'이용계약 동의여부

Dim g_szAgree

g_szAgree = false
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("해외파생 실시간시세정보 이용계약")
	
	btnSubmit.enable = false
	
	Dim szOpenData, szSplitData
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> "" then
		szSplitData = Split(szOpenData, "★")
		
		g_szEngName = szSplitData[0]
		g_szEngAddress = szSplitData[1]			
		g_szAgreeData = szSplitData[2]
		edtName.caption = g_szEngName
		edtAddr.caption = g_szEngAddress
				
	end if
	
	Cont0.visible = true
	Cont1.visible = false
	Cont2.visible = false
	Cont3.visible = false
	
End Sub

'============================================================================
Sub chkAgree_OnChange(sCheckState)
	if sCheckState = "0" then
		btnSubmit.enable = false
		
		g_szAgree = "N"
	else
		btnSubmit.enable = true
		
		g_szAgree = "Y"
	end if
End Sub

'============================================================================
Sub btnSubmit_OnClick()
	Dim szSendData
	
	if Trim(edtName.caption) = "" then
		Form.ShowAlert("알림", "고객명을 기입해주세요.")
		Exit Sub
	end if
	
	if Trim(edtAddr.caption) = "" then
		Form.ShowAlert("알림", "자택주소를 기입해주세요.")
		Exit Sub
	end if
	
	'2019.12.05 - 주석처리
	'if Trim(edtOcp.caption) = "" then
	'	Form.ShowAlert("알림", "직업명을 기입해주세요.")
	'	Exit Sub
	'end if
	
	'if Trim(edtWorkName.caption) = "" then
	'	Form.ShowAlert("알림", "회사명을 기입해주세요.")
	'	Exit Sub
	'end if
	
	'if Trim(edtWorkAddr.caption) = "" then
	'	Form.ShowAlert("알림", "회사주소를 기입해주세요.")
	'	Exit Sub
	'end if
	
	'2019.12.05 - 주석처리
	'[0]:영문이름, [1]:영문주소, [2]:영문직업명, [3]:영문회사명, [4]:영문회사주소, [5]:동의여부
	'szSendData = edtName.caption & "★" & edtAddr.caption & "★" & edtOcp.caption & "★" & edtWorkName.caption & "★" & edtWorkAddr.caption & "★" & g_szAgree
	
	'[0]:영문이름, [1]:영문주소, [3]:동의여부
	szSendData = edtName.caption & "★" & edtAddr.caption & "★" & g_szAgree
	
	Form.SendReturnToParent("AGREE" , szSendData)
	
	
	Form.CloseForm()
End Sub
'==========================================

Sub btnPage1_OnClick()
	
	Cont0.top = 127
	Cont0.left = 5
	Cont0.visible = true
	Cont1.visible = false
	Cont2.visible = false
	Cont3.visible = false
	
End Sub


'============================================================================
Sub btnPage2_OnClick()
	
	Cont0.visible = false
	Cont1.top = 127
	Cont1.left = 5
	Cont1.visible = true
	Cont2.visible = false
	Cont3.visible = false
	
End Sub

'============================================================================
Sub btnPage3_OnClick()
	
	Cont0.visible = false
	Cont1.visible = false
	Cont2.top = 127
	Cont2.left = 5
	Cont2.visible = true
	Cont3.visible = false
	
End Sub
'============================================================================
Sub btnPage4_OnClick()
	
	Cont0.visible = false
	Cont1.visible = false	
	Cont2.visible = false	
	Cont3.top = 127
	Cont3.left = 5
	Cont3.visible = true
	
End Sub

	</SCRIPT_INFO>
</ROOT>