	<SCRIPT_INFO _len="11944" _ulen="11586" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 상품가입 의사표시 확정내역 조회
' 02. 화면설명 : 상품가입 의사표시 확정내역 조회
' 03. 작    성 : 2021.06.10 김유경
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPassWord

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'Cont0.grd0.SetClear()
	if sEventName == "내역조회" then
		g_szList = Split(sParam,"★")
	
		if UBOUND(g_szList) < 1 then
			Exit Sub
		end if
	end if
	
	if g_szList(2) <> "" then
		g_szPassWord = g_szList(2)
	else
		g_szPassWord = ""
	end if	
	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1"        )
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "STA_DATE" , 0 , Cont0.cld0.caption)
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "FIN_DATE" , 0 , Cont0.cld1.caption)
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "MANG_BRCD", 0 , "%"		       )
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ACNO"          , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "CAFU_TRGT_BSWR_CLCD", 0 , "%"   )	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "UI_CLS1" , 0 , "Y"   )	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "UI_CLS2" , 0 , "Y"   )	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "UI_CLS3" , 0 , "Y"   )	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "UI_CLS4" , 0 , "Y"   )	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "UI_CLS5" , 0 , "Y"   )	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ACNT_PWD", 0 , g_szList(2))	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ASNO"    , 0 , g_szList(1))
	DATAMANAGER.RequestTranData( "obcck_dsmg_606r" )
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcck_dsmg_606r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obcck_dsmg_606r", "OutBlock1") - 1
			'No
			Cont0.grd0.SetCellData("bd_cell3", i, i+1)
		
			'상품구분
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "01" then
				Cont0.grd0.SetCellData("bd_cell1", i, "집합투자증권")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "02" then
				Cont0.grd0.SetCellData("bd_cell1", i, "랩(가입)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "03" then
				Cont0.grd0.SetCellData("bd_cell1", i, "ISA")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "04" then
				Cont0.grd0.SetCellData("bd_cell1", i, "신탁")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "05" then
				Cont0.grd0.SetCellData("bd_cell1", i, "청약")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "06" then
				Cont0.grd0.SetCellData("bd_cell1", i, "파생결합증권")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "07" then
				Cont0.grd0.SetCellData("bd_cell1", i, "랩(전환)")
		     else 
				Cont0.grd0.SetCellData("bd_cell1", i, CAFU_TRGT_BSWR_CLCD)		     
		     end if
		
			'신청채널
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "010" then
				Cont0.grd0.SetCellData("bd_cell5", i, "창구")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "020" then
				Cont0.grd0.SetCellData("bd_cell5", i, "HTS")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "060" then
				Cont0.grd0.SetCellData("bd_cell5", i, "INTERNET(WTS)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "156" then
				Cont0.grd0.SetCellData("bd_cell5", i, "아이폰(NEW)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "157" then
				Cont0.grd0.SetCellData("bd_cell5", i, "안드로이드폰(NEW)")
			else
				Cont0.grd0.SetCellData("bd_cell5", i, CHAN_TYPE_CLS_CODE)
		     end if
			
			'의사표시여부(확정여부)
'			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CCLS_YN" , i) == "Y" then
'				Cont0.grd0.SetCellData("bd_cell6", i, "의사표시완료")
'			else
'				Cont0.grd0.SetCellData("bd_cell6", i, "")
'		     end if
			'의사표시여부->가입상태로 변경
			If DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "JOIN_STAT_CLCD" , i) == "1" Then
				Cont0.grd0.SetCellData("bd_cell6", i, "신청중")
			ElseIf DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "JOIN_STAT_CLCD" , i) == "2" Then
				Cont0.grd0.SetCellData("bd_cell6", i, "숙려중")
			ElseIf DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "JOIN_STAT_CLCD" , i) == "3" Then
				Cont0.grd0.SetCellData("bd_cell6", i, "정상")
			ElseIf DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "JOIN_STAT_CLCD" , i) == "4" Then
				Cont0.grd0.SetCellData("bd_cell6", i, "취소")
			ElseIf DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "JOIN_STAT_CLCD" , i) == "5" Then
				Cont0.grd0.SetCellData("bd_cell6", i, "가입의사확인중")
			Else
			     Cont0.grd0.SetCellData("bd_cell6", i, "")
			End If 
		     
			'의사표시채널
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "INTN_EXRS_CHAN_TYPE_CLS_CODE" , i) == "010" then
				Cont0.grd0.SetCellData("bd_cell9", i, "창구")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "INTN_EXRS_CHAN_TYPE_CLS_CODE" , i) == "020" then
				Cont0.grd0.SetCellData("bd_cell9", i, "HTS")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "INTN_EXRS_CHAN_TYPE_CLS_CODE" , i) == "060" then
				Cont0.grd0.SetCellData("bd_cell9", i, "INTERNET(WTS)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "INTN_EXRS_CHAN_TYPE_CLS_CODE" , i) == "156" then
				Cont0.grd0.SetCellData("bd_cell9", i, "아이폰(NEW)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "INTN_EXRS_CHAN_TYPE_CLS_CODE" , i) == "157" then
				Cont0.grd0.SetCellData("bd_cell9", i, "안드로이드폰(NEW)")
			else
				Cont0.grd0.SetCellData("bd_cell9", i, CHAN_TYPE_CLS_CODE)
		     end if
		     
			'숙려구분
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_CLS_CODE" , i) == "01" then
				Cont0.grd0.SetCellData("bd_cell11", i, "고난도")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_CLS_CODE" , i) == "02" then
				Cont0.grd0.SetCellData("bd_cell11", i, "적정성")
			End If 
			
		     '숙려대상
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_CODE" , i) == "01" then
				Cont0.grd0.SetCellData("bd_cell12", i, "일반투자자")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_CODE" , i) == "02" then
				Cont0.grd0.SetCellData("bd_cell12", i, "고령자")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_CODE" , i) == "03" then
				Cont0.grd0.SetCellData("bd_cell12", i, "부적합자")
			End If 
			SetFormatNuber(i)
		next
	end if 
End Sub 
''============================================================================
Function SetFormatNuber(i)
	gApltByovAmt = ""
	gApltByovAmt     = Cont0.grd0.GetCellData("bd_cell14", i) '신청금액
	
	if MID(gApltByovAmt,instr(gApltByovAmt,".")+1,2) = "00" then
		Cont0.grd0.SetCellData("bd_cell14", i, FormatNumber(gApltByovAmt,0))
	else
		Cont0.grd0.SetCellData("bd_cell14", i, FormatNumber(gApltByovAmt,2))
	end if
	

End Function
