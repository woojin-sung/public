Sub Form_OnFormInit()
	Dim ToYear
	Dim ToMonth
	Dim ToDay
	
	ToYear  = Left(Cont0.cld1.caption, 4)
	ToMonth = Mid (Cont0.cld1.caption, 5, 2)
	ToDay   = Mid (Cont0.cld1.caption, 7, 2)
	
	Cont0.cld0.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)
	
End Sub

