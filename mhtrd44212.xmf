'--===========================================================================
'--===========================================================================

Dim g_szThemeCode
Dim g_szExchCode
Dim g_szType
'============================================================================
Sub Form_OnFormInit()
	contTheme.visible = true
	contExch.visible = false
	
	grdList.subformname = "mhtrd44210_p1"
	grdList.subformindex = -1
	
	contTheme_rdoTheme_OnClick( cint(contTheme.rdoTheme.currentindex) )
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	grdList.SetClear()
	
	if nCurrentTab = 0 then
		contTheme.visible = true
		contExch.visible = false
		contTheme_rdoTheme_OnClick( cint(contTheme.rdoTheme.currentindex) )
		
		grdList.SetVisibleCol(0, true)
		grdList.SetVisibleCol(1, false)
	else
		contTheme.visible = false
		contExch.visible = true
		contExch_rdoExch_OnClick( cint(contExch.rdoExch.currentindex) )
		
		grdList.SetVisibleCol(0, false)
		grdList.SetVisibleCol(1, true)
	end if 
End Sub

'============================================================================
Sub contTheme_rdoTheme_OnClick(nIndex)
	Select Case nIndex
		Case 0 
			g_szThemeCode = "100"	'통화
		Case 1 
			g_szThemeCode = "300"	'지수
		Case 2 
			g_szThemeCode = "200"	'금리
		Case 3 
			g_szThemeCode = "420"	'금속
		Case 4 
			g_szThemeCode = "430"	'에너지
		Case 5 
			g_szThemeCode = "900"	'농/축산물
	End Select
	
	g_szType = "Theme"
	DATAMANAGER.RequestTranData("obtrd_comm_012r")
End Sub

'============================================================================
Sub contExch_rdoExch_OnClick(nIndex)
	Select Case nIndex
		Case 0 
			g_szExchCode = "CME" 'CME
		Case 1 
			g_szExchCode = "EUREX" 'EUREX
		Case 2 
			g_szExchCode = "HKEX" 'HKEX
		Case 3 
			g_szExchCode = "SGX" 'SGX
'		Case 4 20211222 HSZ 주석처리(OSE거래소 서비스 종료)
'			g_szExchCode = "OSE" 'OSE
	End Select
	
	g_szType = "Exch"
	DATAMANAGER.RequestTranData("obtrd_comm_012r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_comm_012r" then
		grdList.SetClear()
		
		if g_szType = "Theme" then
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "MTIT_CLCD" , 0, g_szThemeCode)
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "OVDV_EXCH_CODE" , 0, "A")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "PRTF_DETL_OVDV_EXCH_CODE" , 0, "A")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "FTOT_TPCD" , 0, "F")
			
		elseif g_szType = "Exch" then
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "MTIT_CLCD" , 0, "A")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "OVDV_EXCH_CODE" , 0, g_szExchCode)
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "PRTF_DETL_OVDV_EXCH_CODE" , 0, "A")
			DATAMANAGER.SetDataValue( false, "obtrd_comm_012r", "InBlock1", "FTOT_TPCD" , 0, "F")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_comm_012r" then
		Dim szTodayStart, szTodayEnd, szTomorrowStart, szTomorrowEnd
		Dim nCnt, nIndex
		Dim szTodayTime, szTomorrowTime
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtrd_comm_012r", "OutBlock1" )
		nIndex = Cint(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1
			szTodayStart = Left(DATAMANAGER.GetDataValue( false, "obtrd_comm_012r", "OutBlock1", "STA_HOUR" , i), 4)
			szTodayEnd = Left(DATAMANAGER.GetDataValue( false, "obtrd_comm_012r", "OutBlock1", "FIN_HOUR" , i), 4)
			szTomorrowStart = Left(DATAMANAGER.GetDataValue( false, "obtrd_comm_012r", "OutBlock1", "NXDY_TR_STA_HOUR" , i), 4)
			szTomorrowEnd = Left(DATAMANAGER.GetDataValue( false, "obtrd_comm_012r", "OutBlock1", "NXDY_TR_FIN_HOUR" , i), 4)
			
			if szTodayStart <> "" and szTodayEnd <> "" then
				szTodayTime = szTodayStart & szTodayEnd
				
				grdList.SetCellData("bd_cell2", nIndex+i, szTodayTime)
			end if	
			
			if szTomorrowStart <> "" and szTomorrowEnd <> "" then
				szTomorrowTime = szTomorrowStart & szTomorrowEnd
				
				grdList.SetCellData("bd_cell3", nIndex+i, szTomorrowTime)
			end if
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	 szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
  
	 if Trim(szSubMsg) <> "" then
		 Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	 else
		 Form.ShowAlert("알림", szErrMsg)
	 end if
End Sub 

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	szCode = grdList.GetCellData("bd_cell1", lRow)
	
	'품목코드를 종목코드로 변환
	szCode = Form.GetFirstMonth(szCode)
	
	if szCode = "" then
		Exit Sub
	end if
	
	listLocation =  Split(grdList.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	Move_Popup(szCode, nYPos, height)
End Sub

'============================================================================
' Move_Popup 
'============================================================================
Function Move_Popup(szCode, nYPos, height)
	szData = szCode & "★" & nYPos & "★" & height
	Screen_No(szData)
End Function

'============================================================================	
Function Screen_No(szScreen0)
	Form.OpenPopup("mhtrd44210_p1" , szScreen0, "")
End Function 

