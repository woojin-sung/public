'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCodes

g_szCodes		=	Array(	"COM@GC", "NYM@CL", "COM@SI", "SPT@DU" )	'금, WTI, 은, 두바이유
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'TR_Query()
'============================================================================
Function TR_Query()
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	DATAMANAGER.ClearInputData(1, "ohhts_nfut_cntg")
		    
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "FN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "FN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock3", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "FN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock4", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "FN" )
	
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szCodes(0) )
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock2", "FID_INPUT_ISCD" , 0 , g_szCodes(1) )
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock3", "FID_INPUT_ISCD" , 0 , g_szCodes(2) )
	DATAMANAGER.SetDataValue(0, "ohhts_1682_010r", "InBlock4", "FID_INPUT_ISCD" , 0 , g_szCodes(3) )
	
	DATAMANAGER.RequestTranData("ohhts_1682_010r" )

end Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
'	grd00.SetCellData("bd_name", 0, "원/달러")
'	grd01.SetCellData("bd_name", 0, "원/위안")
'	grd02.SetCellData("bd_name", 0, "원/엔")
'	grd03.SetCellData("bd_name", 0, "원/유로")
	
	grd00.scrollenable = "0"
	grd01.scrollenable = "0"
	grd02.scrollenable = "0"
	grd03.scrollenable = "0"
	
	TR_Query()
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1684
	dim szRealCode
	
	if szTranID = "ohhts_1682_010r" then 
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg")

		for i = 0 to 3
			DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", i, g_szCodes(i)) 
		Next	    
		
		grd00.rowcount = 1
		grd01.rowcount = 1
		grd02.rowcount = 1
		grd03.rowcount = 1
		DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
	end if 
End Sub

'============================================================================
'	조회 서비스 호출 후, fgcolor 세팅
'============================================================================
Function grd00_colorSetting(nVrssSign)
	Select Case nVrssSign
	Case 1, 2
		grd00.SetCellFgColor("bd_pr", 0, "10")
		grd00.SetCellFgColor("bd_debi", 0, "10")
		grd00.SetCellFgColor("bd_prdy", 0, "10")
		grd00.SetCellFgColor("bd_ctrt", 0, "10")

'		imgBg0.imgduplicate = "1"
'		imgBg0.imgpath = "img_bgbox_red.9.png"

	Case 4, 5
		grd00.SetCellFgColor("bd_pr", 0, "11")
		grd00.SetCellFgColor("bd_debi", 0, "11")
		grd00.SetCellFgColor("bd_prdy", 0, "11")
		grd00.SetCellFgColor("bd_ctrt", 0, "11")

'		imgBg0.imgduplicate = "1"
'		imgBg0.imgpath = "img_bgbox_blue.9.png"

	Case Else
		grd00.SetCellFgColor("bd_pr", 0, "12")
		grd00.SetCellFgColor("bd_debi", 0, "12")
		grd00.SetCellFgColor("bd_prdy", 0, "12")
		grd00.SetCellFgColor("bd_ctrt", 0, "12")

'		imgBg0.imgduplicate = "1"
'		imgBg0.imgpath = "img_bgbox_gray.9.png"
	End Select
End Function

