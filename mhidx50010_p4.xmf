'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Reload_Data" then
		TR_Query()
	end if		
End Sub

'============================================================================
Sub Button1_OnClick()
	szSymbol = grd00.GetCellData( "bd_code", 0 )
	szMarket = grd00.GetCellData( "bd_mkt", 0 )
	szName	= grd00.GetCellData( "bd_name", 0 )
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , "")
End Sub

