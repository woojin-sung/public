	szSymbol = grd03.GetCellData( "bd_code", 0 )
	szMarket = grd03.GetCellData( "bd_mkt", 0 )
	szName	= grd03.GetCellData( "bd_name", 0 )
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , "")
End Sub

