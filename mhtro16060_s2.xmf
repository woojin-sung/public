'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtQty_OnEditComplete()
	edtPrc.caption = ""
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	g_szSelQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		' 매도수량 자동입력
	g_szSelQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매도수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelQty) = "" then
		g_szSelQty = "0"		
	end if	
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn == 0 then
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
			
			'20201124 LES START 해외주식 시장가 매도
'			szType = Check_OrdType()
			szType = Check_PrcOrd() '20220524 아이티젠 김성수 추가
'			if szType <> "05" then
			if szType <> "시장가" then
'			if  then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if
			'20201124 LES END
			
		end if	
	end if
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	Dim szType '20220524 아이티젠 김성수 추가
	sCodeData = Split(g_szCd, "@")
	szData = "1"													' 매매구분
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
	szData = szData & "|" & sCodeData[1]								' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	
	'20201124 LES START 해외주식 시장가매도
'	szType = Check_OrdType()
'	if szType == "05" then
'		szType = "시장가"
'	else
'		szType = "지정가"
'	end if
	
	szType = Check_OrdName() '20220524 아이티젠 김성수 추가
	
	szData = szData & "|" & szType	 								' 주문구분
	'20201124 LES END
	
	'20201021 LES START 해외주식 매도상환
	szData = szData & "|" & rdoGbn.currentindex '"0"										' 현금
	'20201021 LES END
	
	
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtPrc.caption							' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & ""										' 전량전부
	szData = szData & "|" & g_szDecimal								' 가격자릿수
	
	'20201021 LES START 해외주식 매도상환
	'1)현금/신용 구분
	szData = szData & "|" & gLoanType
	
	'2)대출일자
	szData = szData & "|" & cldCredit0.caption
	'20201021 LES END
	
	
	' 20181022 HWG START : 해외주식 주문착오 방지
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		szData = szData & "|" & szWarn		' 경고메세지		
		Form.OpenPopup("mhtro16060_p7", szData , "")		
	else							' 주문확인팝업 오픈
		Form.OpenPopup("mhtro16060_p4", szData , "") 
	end if
	' 20181022 HWG END
	
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order() 
	g_szWarnFlag	= "N"	' 20181022 HWG : 해외주식 주문착오 방지
	
	
	'20201021 LES START 해외주식 매도상환
	'현금/대출 구분
	szCLS = rdoGbn.currentindex
	
	if szCLS == "0" or szCLS == 0 then
		DATAMANAGER.RequestTranData("obtro_oder_101a")
	else
		DATAMANAGER.RequestTranData("obtro_oder_150a")
	end if
	
		
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit	
	szLow  = g_szDnLimit
	
	GetHogaUnit(g_szMk, szPrc, nGbn)	'20180710 HAMWG : 호가단위 설정함수 변경
	
	szUnit = g_szUnit

	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if g_szLast == "" or CDbl(g_szLast) == 0 then
			szPrc = 0
		else
			szPrc = g_szLast
		end if
	else
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
			
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function

'20180710 HAMWG START : 호가단위 설정함수 변경
'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szLast = "" or CDbl(g_szLast) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szLast)
		end if	
	end if
	
	szUnit = "1.000"
	
	'20200310 LES START 홍콩 ETF종목 호가단위 변경
	szTtype = Cint(g_szTickType)
	
	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	if szMk == "0215" then '상해
		szUnit = "0.010"
		
	elseif szMk == "0214" then '심천
		szUnit = "0.010"
		
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		if szTtype == 1 then
