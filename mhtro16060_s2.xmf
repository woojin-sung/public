'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' Return_BalanceScreen : 잔고팝업에서 리턴된 값 적용
'============================================================================
Function Return_BalanceScreen(szRet)
	tData = Split(szRet, "★")

	if UBound(tData) > 0 then
	
		szMkCd = Transform_Exid(tData(3))
		Form.triggerEvent("#", "16060_BALANCE", szMkCd & "@" & tData(2) & "★" & tData(1))

		' 수량
		g_szQty = ""
		edtQty.caption = tData(4)	
		edtQty_OnEditComplete()
		g_szQty = tData(4)

		'20201124 LES START 해외주식 시장가매도
		cmbType.currentindex = "0"
		'20201124 LES END
		
		edtPrc.caption = ""
		edtPrc_OnEditComplete()
		
		'20201021 LES START 해외주식 매도상환
		'대출상세유형코드(6) / 대출일자(5) / 대출번호(7)
		gLoanType = tData(6)
			
		'gLoanType : 0000 = 일반종목
		if gLoanType <> "0000" then
			rdoGbn.currentindex = 1
			
			gLoanDate = tData(5)
			cldCredit0.caption = gLoanDate
			
			gLoanSrno = tData(7)
			
			if gLoanSrno == "0251" then
				cmbCredit0.currentindex = 0
			end if
			
		else
			rdoGbn.currentindex = 0
			
		end if
		'20201021 LES END
	end if
End Function		

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szSelQty == "1" then		' 보유잔고수량
		Request_Able()
	elseif g_szSelQty == "2" then
		edtQty.caption = g_szSelQtyCnt
		edtQty_OnEditComplete()
	end if
End Function

'============================================================================
' Request_Able
'============================================================================
Function Request_Able()
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
	DATAMANAGER.RequestTranData("obtro_oder_235r")				' 주문가능금액 조회	
End Function

'============================================================================
' 거래소코드 <- 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

