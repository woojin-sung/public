'============================================================================
' btnPrc_OnClick
'============================================================================
Sub btnPrc_OnClick()

		if Trim(edtPrc.caption) == "" then
		szPrc = ""
	else
		szChk = InStr(CStr(edtPrc.caption), ".")
	
		if CStr(szChk) == "0" then
			if g_szDecimal = "1" then
				szPrc = edtPrc.caption & ".0"	
			elseif g_szDecimal = "2" then
				szPrc = edtPrc.caption & ".00"	
			elseif g_szDecimal = "3" then
				szPrc = edtPrc.caption & ".000"	
			elseif g_szDecimal = "4" then
				szPrc = edtPrc.caption & ".0000"	
			end if 
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == "1" then 
				if g_szDecimal == "2" then
					szPrc = edtPrc.caption & "0"	
				elseif g_szDecimal == "3" then
					szPrc = edtPrc.caption & "00"	
				elseif g_szDecimal == "4" then
					szPrc = edtPrc.caption & "000"
				else 
					szPrc = edtPrc.caption
				end if 	
			elseif CStr(szCha) == "2" then 
				if g_szDecimal == "3" then
					szPrc = edtPrc.caption & "0"	
				elseif g_szDecimal == "4" then
					szPrc = edtPrc.caption & "00"
				else
					szPrc = edtPrc.caption
				end if	
			elseif CStr(szCha) == "3" then 
				if g_szDecimal == "4" then
					szPrc = edtPrc.caption & "0"
				else 
					szPrc = edtPrc.caption
				end if	
			else
				szPrc = edtPrc.caption
			end if
		end if
	end if
	
	'20180710 HAMWG : 호가단위 설정함수 변경(국가코드->거래소벤더코드 변경)
	Form.OpenPopup("mhtro16060_p2" , szPrc & "★" & g_szCd & "★" & g_szMk & "★" & g_szUnit & "★" & cmbType.currentindex & "★" & g_szUpLimit & "★" & g_szDnLimit & "★" & g_szDecimal & "★" & g_szTickType, "")
End Sub

'============================================================================
Sub rdoGbn_OnClick(nIndex)
	
	Call SetCtrlVisible()
	
End Sub

'============================================================================
Sub SetCtrlVisible()

	'현금
	if rdoGbn.currentindex == "0" or rdoGbn.currentindex == 0 then
		
		cmbCredit0.visible = false
		cldCredit0.visible = false
		
		Table1.visible = false
		Table0.visible = true
		
		chkRepay.visible = false
		
		btnSell.caption = "현금매도"
		
		btnOrdBal.height = 52
		btnOrdBal.top = 325
		
		btnSell.height = 52
		btnSell.top = 325
		
	
	'대출
	else
		cmbCredit0.visible = true
		cldCredit0.visible = true
		
		Table1.visible = true
		Table0.visible = false
		
		chkRepay.visible = true
		
		btnSell.caption = "신용매도"
		btnOrdBal.height = 42
		btnOrdBal.top = 335
		
		btnSell.height = 42
		btnSell.top = 335
		
		
		
	
	end if

End Sub

'============================================================================
' 20201124 LES START 해외주식 매도 시장가
'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	'20221213_01 KBC START 해외주식주간거래     
	sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
	
	if sDayYN == "Y" and Check_OrdType() <> "01" then
		if g_szMk == "0537" or g_szMk == "0321" or g_szMk == "0066" then
			Form.ShowAlert(g_szTitle, "주간거래는 지정가 주문만 가능합니다.")
		end if
	end if	
	'20221213_01 KBC END
	
	'20220524 아이티젠 김성수 START
	dim szOrdType, bPopYN
	szOrdType = Check_OrdType()
		
'	if iIndex = 0 then
	'지정가, LOO, LOC, Limit VWAP, Limit TWAP
	if szOrdType = "01" or szOrdType == "31" or szOrdType == "32" 
		or szOrdType == "35" or szOrdType == "36" then
		
		'지정가
		btnPrc.enable = true
		btnPPlus.enable = true
		btnPMinus.enable = true
		edtPrc.enable = true
		
	else
		'시장가, MOO, MOC
		if szOrdType == "05" or szOrdType == "33" or szOrdType == "34" 
			or szOrdType == "37" or szOrdType == "38" then
			btnPrc.enable = false
			btnPPlus.enable = false
			btnPMinus.enable = false
			edtPrc.enable = false
		
			edtPrc.caption =""
			edtPrc_OnEditComplete()
		end if
	end if
	
	'시장가
	if szOrdType == "05" then
		bPopYN = Form.GetEnvData("OrdNotice_16060")
			
		if bPopYN == "" or bPopYN == "0" then
			Form.OpenPopup("mhtro16060_p10" , "" , "")
		end if
	end if
	
	'VWAP, TWAP(Limit 포함)일 때 유의팝업 오픈
	if szOrdType == "35" or szOrdType == "36" or szOrdType == "37" or szOrdType == "38" then
		bPopYN = Form.GetEnvData("OrdNotice_16060_p12")
		if bPopYN == "" or bPopYN == "0" then
			Form.OpenPopup("mhtro16060_p12" , "" , "")
		end if
	end if
		
	'20220524 아이티젠 김성수 END
End Sub

'============================================================================
Function Check_OrdType()

	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	Select Case szIdx
		Case "0"
			return "01" '지정가
		Case "1"
			return "05" '시장가
		'20220524 START
		Case "2" 
			return "31" 'LOO
		Case "3"
			return "32" 'LOC
		Case "4"
			return "33" 'MOO
		Case "5"
			return "34" 'MOC
		Case "6"
			return "37" 'VWAP
		Case "7"
			return "38" 'TWAP
		Case "8"
			return "35" 'Limit VWAP
		Case "9"
			return "36" 'Limit TWAP
		'20220524 END
	End Select
End Function

'============================================================================
' Check_OrdCond 주문조건구분코드 20220524 아이티젠 김성수 추가
'============================================================================
Function Check_OrdCond()
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "0" '지정가
		Case "05"
			return "0" '시장가
		Case "31"
			return "2" 'LOO
		Case "32"
			return "7" 'LOC
		Case "33"
			return "2" 'MOO
		Case "34"
			return "7" 'MOC
		Case "35"
			return "0" 'Limit VWAP
		Case "36"
			return "0" 'Limit TWAP
		Case "37"
			return "0" 'VWAP
		Case "38"
			return "0" 'TWAP
	End Select
End Function

'============================================================================
' Check_OrdName 주문유형명 20220524 아이티젠 김성수 추가
'============================================================================
Function Check_OrdName()
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "지정가"
		Case "05"
			return "시장가"
		Case "31"
			return "LOO" 
		Case "32"
			return "LOC" 
		Case "33"
			return "MOO" 
		Case "34"
			return "MOC" 
		Case "35"
			return "Limit VWAP" 
		Case "36"
			return "Limit TWAP" 
		Case "37"
			return "VWAP" 
		Case "38"
			return "TWAP" 
	End Select
End Function

'============================================================================
' Check_PrcOrd 지정가/시장가 구분 20220524 아이티젠 김성수 추가
'============================================================================
Function Check_PrcOrd()
	Dim szIdx
	szIdx = Check_OrdType()
	
'	if szIdx == "01" or szIdx == "31" or szIdx == "32" or szIdx == "35" or szIdx == "36" then
	if szIdx == "05" or szIdx == "33" or szIdx == "34" or szIdx == "37" or szIdx == "38" then
		return "시장가"
	else
		return "지정가"
	end if
End Function

'============================================================================
' 시장에 따른 주문유형 변경(미국장만 시장가 추가)
'============================================================================
Function Set_TypeList(nGbn)
	if nGbn == "USA" then
'		return "00`지정가\r\n01`시장가"
		'20220524 아아티젠 김성수 수정
		return "00`지정가\r\n01`시장가\r\n31`LOO\r\n32`LOC\r\n33`MOO\r\n34`MOC\r\n37`VWAP\r\n38`TWAP\r\n35`Limit VWAP\r\n36`Limit TWAP"
	else 
		return "00`지정가\r\n"
	end if
End Function




'============================================================================
Sub chkRepay_OnChange(sCheckState)
	if sCheckState == "1" then
		Form.ShowAlert("안내", "전액상환방식을 선택시,\n매도금액의 97%는 융자금을 상환합니다.")
	end if
End Sub

