'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	
	'20201021 LES START 해외주식 매도상환
	Call SetCtrlVisible()
	'20201021 LES END
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	
	' ----------------------------------------------------------------------
	' 현재가 호가연동
	' ----------------------------------------------------------------------		
	if sEventName == "PRICE" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
		g_bPrcFlg = true
	elseif sEventName == "JANGO" then
		
		'20201021 LES START 해외주식 매도상환
		
		'매도매수구분/수량/대출일자/대출상세유형코드/대출일련번호
		szData = Split(sParam,"★")
		
		gLoanType = szData(3)
		
		'대출잔고인 경우
		if gLoanType <> "0000" then
		
			'대출유형
			rdoGbn.currentindex = 1
			
			'수량
			edtQty.caption = szData(1)
			edtQty_OnEditComplete()
			
			'대출일자
			cldCredit0.caption = szData(2)
			gLoanDate = szData(2)
			
			'대출일련번호
			gLoanSrno = szData(4)
			
		'일반잔고인 경우
		else
			edtQty.caption = szData(1)
			edtQty_OnEditComplete()
		
		end if
		'20201021 LES END
		
		'ORGNSRC
		'edtQty.caption = sParam
		'edtQty_OnEditComplete()
		
	' ----------------------------------------------------------------------
	' 호가테이블 클릭 호가연동
	' ----------------------------------------------------------------------	
	elseif sEventName == "HOGA" then
		
		'20201124 LES START 해외주식 시장가 매도
		szType = Check_OrdType()
		
		if szType <> "05" and szType <> "33" and szType <> "34" and szType <> "37" and szType <> "38" then		'20220524 SWJ START : 시장가 유형 추가 
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
		'20201124 LES END
		
	' ----------------------------------------------------------------------
	' 메인화면 이벤트처리 (종목변경/탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	elseif sEventName == "16060_InitCode" or sEventName == "16060_ChangeCode" or sEventName == "16060_ChangeTab" then	

		if g_szCd <> sParam then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")	' 거래소벤더코드
			
			
			'20201124 LES START 해외주식 시장가 매도
			'미국시장만 주문유형에 시장가 추가
			dim szList
			szList = Set_TypeList(g_szNg)
			cmbType.currentindex = "0"					' 0으로 변경해야 die안됨
			Form.SetCtlProp("cmbType", "clear", "")		' 콤보 리스트 클리어
			cmbType.cbinputdatatext = szList
			'20201124 LES END
			
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )

		if g_bRtnData == false then
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
			end if
		else
			g_bRtnData = false
		end if
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "16060_ChangeAcnt" then
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
		
	' 20171127 HAMWG END

	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
			
			Return_AutoQty()
		else
			'20221206_01 KBC START : 해외주식 미국PTP 종목과세관련 (잔고팝업 주문수량 오류 수정-영향도있으니 추후수정)
			'이전소스
			Init_InputControl()
			
'			if g_bRtnData2 == false then
'				Init_InputControl()
'			else
'				g_bRtnData2 = false
'			end if
			'20221206_01 KBC END
		end if
		'20170919 HAMWG END
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if	
	' 20181022 HWG END
	' ----------------------------------------------------------------------
	' PTP경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	'20221206_01 KBC START : 해외주식 미국PTP 종목과세관련
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if		
	'20221206_01 KBC END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	
	' ----------------------------------------------------------------------
	' 해외주식 잔고팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "16060_BALANCE" then
		if sRet == "" then
			Exit Sub
		end if
		
		g_bRtnData = true
		'g_bRtnData2 = true '20221206_01 KBC : 해외주식 미국PTP 종목과세관련 (잔고팝업 주문수량 오류 수정-영향도있으니 추후수정)
		
		Return_BalanceScreen(sRet)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'20201124 LES START 해외주식 시장가 매도
	'주문유형(지정가/시장가)
	szType = Check_OrdType()
	
	'주문단가
	Select Case szType
		Case "05"
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
	End Select
	'20201124 LES END
	
	' ----------------------------------------------------------------------
	' 주식 현금 매도주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_101a" then
		g_szTR = szTranID
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_101a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END	' 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									' 거래소코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "SELN_BYOV_CLCD"		, 0, "1")									' 매도/매수구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_CLS_CODE"		, 0, szType)									' 주문구분코드
'		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")									' 주문조건구분코드
		'20220524 아이티젠 김성수 수정
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, Check_OrdCond())							' 주문조건구분코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODQT"				, 0, edtQty.caption)							' 주문수량
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0, szPrc)									' 주문단가
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)							' 경고확인여부	' 20181022 HWG : 해외주식 주문착오 방지
	
	' ----------------------------------------------------------------------
	' 20201021 LES START 해외주식 매도상환
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_oder_150a" then
	
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ACNO" 		, 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ASNO" 		, 0 , Form.GetTopCtlProp("acnt", "sequence"))
		
		'DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ACNT_PWD"	, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))
		
		'20201021 LES START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ACNT_PWD", 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ACNT_PWD", 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20201021 LES END
				
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "OVRS_STCK_SYMB_ISCD" , 0 , sCodeData[1])
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "OVRS_EXCH_VNDR_IDNO" , 0 , g_szMk)
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "SELN_BYOV_CLCD" , 0 , "1")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ODER_CLS_CODE" , 0 , szType)
'		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ODER_COND_CLS_CODE" , 0 , "0")
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ODER_COND_CLS_CODE" , 0 , Check_OrdCond())
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ODQT" , 0 , edtQty.caption)
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "OVRS_STCK_ODER_PRC" , 0 , szPrc)
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "ODER_OCRN_TYPE_CODE" , 0 , "01")
		'DATAMANAGER.SetDataValue('bReal, "obtro_oder_150a", "InBlock1", "ODER_GRP_NO" , nIndex , szValue)
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "WARN_CNFR_YN" , 0 , g_szWarnFlag)
		'DATAMANAGER.SetDataValue('bReal, "obtro_oder_150a", "InBlock1", "PROS_SRNO" , nIndex , szValue)
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "LOAN_ODER_CLS_CODE" , 0 , cmbCredit0.cbkeydata)
		
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "SVC_CLS_CODE" , 0 , "203")
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "LOAN_DATE" , 0 , cldCredit0.caption)
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "LOAN_SRNO" , 0 , gLoanSrno )
		
		
		if chkRepay.checkstate == "1" then
			chkWhole = "Y"
		else
			chkWhole = "N"
		end if
				
		DATAMANAGER.SetDataValue(0, "obtro_oder_150a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" , 0 , chkWhole)
		
	
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_6000_001r" then
		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
	
	' ----------------------------------------------------------------------
	' 고시환율 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )
	
	' ----------------------------------------------------------------------
	' 주문가능금액 조회(100%)
	' ----------------------------------------------------------------------
	elseif szTranID == "obtro_oder_235r" then
		
		'20201021 LES START 해외주식 매도상환
		DATAMANAGER.ClearInputData(0, "obtro_oder_235r")
		
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.SetDataValue( 0, "obtro_oder_235r", "InBlock1", "ACNO"				, 0 , Form.GetTopCtlProp("acnt", "total"))	' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_235r", "InBlock1", "ASNO"				, 0 , Form.GetTopCtlProp("acnt", "sequence"))	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obtro_oder_235r", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "caption"))' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue( 0, "obtro_oder_235r", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obtro_oder_235r", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0 , sCodeData[1])						' 종목코드
		DATAMANAGER.SetDataValue( 0, "obtro_oder_235r", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0 , g_szMk)								' 거래소코드
	
	
	
		'20201021 LES START 해외주식 매도상환
		if rdoGbn.currentindex == 1 or rdoGbn.currentindex == "1" then
		
			if gLoanSrno == "" or gLoanSrno == 0 then
				szLoanSr = 1
			else
				szLoanSr = gLoanSrno	
			end if
			
			szLoanDate = cldCredit0.caption
			szLoanCd	  = "0251"
		
			DATAMANAGER.SetDataValue(0, "obtro_oder_235r", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , szLoanCd)
			DATAMANAGER.SetDataValue(0, "obtro_oder_235r", "InBlock1", "LOAN_DATE" 			, 0 , szLoanDate)
			DATAMANAGER.SetDataValue(0, "obtro_oder_235r", "InBlock1", "LOAN_SRNO" 			, 0 , szLoanSr)
		
		end if
		'20201021 LES END
	
	
	end if
	'20171204 HAMWG END
	
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' 해외주식 매도주문
	' ----------------------------------------------------------------------	
	Select Case szTranID
		Case "obtro_oder_101a", "obtro_oder_150a"
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
			'20221206_01 KBC START : 해외주식 미국PTP 종목과세관련
			elseif szWarnCd = "3" then
				szData = "1" & "|" & szWarnMsg	' 매매구분|메시지
				Form.OpenPopup("mhtro16060_p15", szData , "")	'OnPopupReturn -> "PTP주문경고"
			'20221206_01 KBC END				
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
				
				if Trim(szOrdCd) == "0001" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
				end if
			end if
			' 20181022 HWG END
		
'20221206_01 KBC : 해외주식 미국PTP 종목과세관련 (윗쪽 Case "obtro_oder_101a"와 통합)
'		'20201021 LES START 해외주식 매도상환
'		Case "obtro_oder_150a"
'			
'			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
'			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
'				
'			if szWarnCd = "0" then
'				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
'				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
'				g_szTR = ""
'				
'				if Trim(szOrdCd) == "0001" then			' 정상주문
'					Form.Toast(0, szOrdMsg, true)
'					
'					if g_szAfterInit == "1" then		' 주문후 초기화
'						Init_InputControl()
'					end if
'				end if
'				
'				
'			end if
'		
'		'20201021 LES END
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
		Case "ohhts_6000_001r"
			
			g_szLast		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 	, 0 )	' 현재가
			g_szUpLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" 	, 0 )))	' 상한가
			g_szDnLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" 	, 0 )))	' 하한가
'			g_szUnit		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ASPR_UNIT" 	, 0 )	' 호가단위
			g_szOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" , 0 )	' 매매단위
			g_szCur		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 	, 0 )	' 통화
			g_szDecimal 	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
			g_szKorName	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" 	, 0 )	' 한글종목명
			g_szTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_TICK_CLS" 	, 0 )	' 종목 틱타입
'			g_szKofx		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 		, 0 )	' 환율
			
			GetHogaUnit(g_szMk, g_szLast, 0)	'20180710 HAMWG : 호가단위 설정함수 변경
			
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
			edtPrc.mask = sMask
			
			Table0.SetCellMaskInfo(2, 1, sMask)
			Table0.SetCellString(2, 0, g_szCur)
			Table0.SetCellString(0, 1, g_szOrdSize)
			
			'20201021 LES START 해외주식 매도상환
			'Table1은 [대출]선택 시, 보여줄 테이블 (평상시에는 Table0)
			Table1.SetCellMaskInfo(2, 1, sMask)
			Table1.SetCellString(2, 0, g_szCur)
			Table1.SetCellString(0, 1, g_szOrdSize)
			'20201021 LES END
			
			
			DATAMANAGER.RequestTranData("obtro_comn_025r")
		Case "obtro_comn_025r"
			szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
			Table0.SetCellString(1, 1, Cdbl(szAnncExrt))
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(1, 1, Cdbl(szAnncExrt))
			'20201021 LES END
			
			
		Case "obtro_oder_235r"
			szAbleQty = DATAMANAGER.GetDataValue( 0, "obtro_oder_235r", "OutBlock1", "SELN_ABLE_QTY" , 0 )	' 주문가능수량
			edtQty.caption = szAbleQty
			edtQty_OnEditComplete()
	'20171204 HAMWG END
	End Select
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
' edtPrc_OnEditComplete
'============================================================================
Sub edtPrc_OnEditComplete()
	if edtQty.caption == "" or edtPrc.caption == "" then
		Table0.SetCellString(2, 1, "")
		Table0.SetCellString(3, 1, "")
		
		'20201021 LES START 해외주식 매도상환
		Table1.SetCellString(2, 1, "")
		Table1.SetCellString(3, 1, "")
		'20201021 LES END
		
	else	
		if edtQty.caption == "0" or edtPrc.caption == "0" then
			Table0.SetCellString(2, 1, "")
			Table0.SetCellString(3, 1, "")
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(2, 1, "")
			Table1.SetCellString(3, 1, "")
			'20201021 LES END
			
		else
			temp = Cdbl(edtPrc.caption) * Cdbl(edtQty.caption)
			Table0.SetCellString(2, 1, temp)
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(2, 1, temp)			
			'20201021 LES END
			
		
			temp2 = Cdbl(Table0.GetCellString(1, 1))
			temp3 = temp * temp2
			Table0.SetCellString(3, 1, Cdbl(temp3))
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(3, 1, Cdbl(temp3))			
			'20201021 LES END
			
			
		end if
	end if
End Sub

'============================================================================
' edtQty_OnEditComplete 
'============================================================================
Sub edtQty_OnEditComplete()
	if edtQty.caption == "" or edtPrc.caption == "" then
		Table0.SetCellString(2, 1, "")
		Table0.SetCellString(3, 1, "")
		
		'20201021 LES START 해외주식 매도상환
		Table1.SetCellString(2, 1, "")
		Table1.SetCellString(3, 1, "")
		'20201021 LES END
		
		
	else	
		if edtQty.caption == "0" or edtPrc.caption == "0" then
			Table0.SetCellString(2, 1, "")
			Table0.SetCellString(3, 1, "")
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(2, 1, "")
			Table1.SetCellString(3, 1, "")
			'20201021 LES END
			
		else
			temp = Cdbl(edtPrc.caption) * Cdbl(edtQty.caption)
			Table0.SetCellString(2, 1, temp)
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(2, 1, temp)			
			'20201021 LES END
		
			temp2 = Cdbl(Table0.GetCellString(1, 1))
			temp3 = temp * temp2
			Table0.SetCellString(3, 1, Cdbl(temp3))
			
			'20201021 LES START 해외주식 매도상환
			Table1.SetCellString(3, 1, Cdbl(temp3))			
			'20201021 LES END
			
		end if
	end if
End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	'계좌번호
	szAcnt   = Form.GetTopCtlProp("acnt", "total")
	szAcntCd = Form.GetTopCtlProp("acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if
	
	szPrice = edtPrc.caption
	    
	if edtPrc.caption = "0" or edtPrc.caption = "" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
		exit Sub
	end if	    
	
	' 계좌번호|계좌일련번호|종목코드|거래소벤더코드|매매구분(1매도, 2매수)|주문수량|주문단가|소숫점자릿수
	szData = szAcnt & "★" & szAcntCd & "★" & g_szCd & "★" & g_szMk & "★" & "2" & "★" & edtQty.caption & "★" & szPrice & "★" & g_szDecimal
	Form.OpenPopup("mhtro16060_pa" , szData , "")
End Sub

