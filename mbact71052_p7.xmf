	<SCRIPT_INFO _len="31027" _ulen="28983" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_기타금융상품
' 02. 화면설명 : 고객자산평가_상품별잔고_기타금융상품
' 03. 작    성 : 2016. 02. 03. 유창재
'		      : 2022.03.22 김유경 : v001. 예금자보호법 관련 안내 문구 추가 (상품구분이 외화채권인 경우에만 조회)
'              : 2023.11.09 김유경 : v002. 오류수정 (발행어음로직 주석처리)
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nCmbIndex	'콤보 Index값
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_sParam		'트리거 전달값
Dim g_test
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch(szTranID)
	
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_UNIT_CLS" , 0 , "1" )						'UI단위구분 1:종합계좌, 2:개별계좌
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , Left(g_szList(CDbl(g_nAllCount)), 8) )			'계좌번호
		
		if szTranID = "obacb_balc_146r" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASET_CLS_CODE" , 0 , cont0.cmb0.cbkeydata )'자산구분코드
		end if
		
		DATAMANAGER.RequestTranData( szTranID )
	
	else
		lblVisible()
		
	end if

End Function
'============================================================================
' InQuery(szTranID) : TR 입력, 조회
'============================================================================
Function InQuery(szTranID)

	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_UNIT_CLS" , 0 , "2" )						'UI단위구분 1:종합계좌, 2:개별계좌
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8) )			'계좌번호
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2))			'계좌번호
	
	if szTranID = "obacb_balc_146r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASET_CLS_CODE" , 0 , cont0.cmb0.cbkeydata )'자산구분코드
	end if
	
	DATAMANAGER.RequestTranData( szTranID )

	
End Function
'============================================================================
'lblVisible() : 잔고없는 경우 라벨 보임 처리
'============================================================================
Function lblVisible()
	if CInt(cont0.FormTab0.currenttab) = 0 then	'기타금융
		if CInt(g_nCmbIndex) == 12 then
			if CInt(cont0.grd2.rowcount) = 0 then
				cont0.grd2.left = 1000
				cont0.lblNone.visible = true
			else
				cont0.grd2.left = 13
				cont0.lblNone.visible = false
			end if
		else
			if CInt(cont0.grd1.rowcount) = 0 then
				cont0.grd1.left = 1000
				cont0.lblNone.visible = true
			else
				cont0.grd1.left = 13
				cont0.lblNone.visible = false
			end if
		end if
	else									'외화
		if CInt(cont0.grd3.rowcount) = 0 then
			cont0.grd3.left = 1000
			cont0.lblNone.visible = true
		else
			cont0.grd3.left = 13
			cont0.lblNone.visible = false
		end if
	end if

End Function 
'============================================================================
' GrdVisible(szTranID) : 그리드 보임 처리
'============================================================================
Function GrdVisible(nIndex, szFrom)

	if CInt(cont0.FormTab0.currenttab) == 0 then
		'기타상품 > 해외파생
		if CInt(nIndex) = 12 then	
			cont0.grd2.left = 13
			cont0.grd1.left = 1000
			cont0.grd3.left = 1000
			
			cont0.grd2.rowcount = 0
			
		else
			cont0.grd1.left = 13
			cont0.grd2.left = 1000
			cont0.grd3.left = 1000
			
			cont0.grd1.rowcount = 0
		end if
	'외화 탭
	else
		cont0.grd1.left = 1000
		cont0.grd2.left = 1000
		cont0.grd3.left = 13
		
		cont0.grd3.rowcount = 0

	end if
End Function

'============================================================================
' CleanGrd() : 모든 TR 연결 해제
'============================================================================
Function CleanTR()
	cont0.grd1.SetClear()
	cont0.grd2.SetClear()
	cont0.grd3.SetClear()
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_145r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_146r")
End Function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "mbact71052_p7" then	
		
		'트리거 전달값 세팅
		g_sParam = sParam
		g_szList = Split(g_sParam,"○")
				
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		'상단 카드뷰 평가금액 서비스 호출 후 자산조회
		call VltnAmt_Request()
	
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	if szTranID == "obacb_balc_154r" then
		
		call Asset_Request()
	
	'---------------------------------------------------------
	'기타상품 자산 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_146r" then
		
		nCnt = DATAMANAGER.GetDataCount( 0 , "obacb_balc_146r", "OutBlock1")
		
		for i = 0 to nCnt - 1
			
			'행생성
			cont0.grd1.AddRow()
			cont0.grd2.AddRow()
			
			'계좌번호
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ACNO" , i)	
			szTemp0 = left(szTemp0, 4).."-"..right(szTemp0, 4)
			szTemp0 = szTemp0.."-"..DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ASNO" , i)
			szTemp0 = szTemp0.."("..DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ACNT_PRNM" , i)..")"
			
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "PSTN_CLS_NAME" 	, i)		'잔고구분
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ISNM" 			, i)	 	'종목명
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "RMND_QTY" 		, i) 	'잔고수량
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "MTRT_DATE" 		, i)		'만기일
			
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "MKSC_CLS_NAME" 	, i)		'유가증권 구분명
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "PSTN_CLS_NAME" 	, i)		'포지션 구분명
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "VLTN_AMT" 		, i)		'평가금액
			
			szPrdtCode = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ASET_CLS_CODE" 		, i)		'자산구분코드
			
			'szData : 상세화면에 띄워줄 데이터들
			szData1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "VLTN_PRLS_AMT" 		, i)		'평가손익
			szData2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "BYOV_AMT" 		, i)			'매입금액
			szData3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ERT" 		, i)				'수익률
			szData4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "BYOV_DATE" 		, i)			'매수일
			szData5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "MTRT_DATE" 		, i)			'만기일
			
			szData6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "STPL_INRT" 		, i)			'약정이율
			szData7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "HLFW_RPRC_APLY_INRT" , i)		'중도매도이율
			szData8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "MTRT_AFT_APLY_INRT" , i)		'만기후이율
			
			szData9  = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "FCVL_AMT" , i)		'액면금액
			szData10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "CRCD" , i)			'통화코드
			
			szData11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "FRCR_BYOV_AMT" , i)		'외화매입금액
			szData12 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "FRCR_VLTN_AMT" , i)		'외화평가금액
			szData13 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "FRCR_PRFI_AMT" , i)		'외화평가손익
			szData14 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "HLDN_PRD_DYNU" , i)		'보유기간
			
			szData15 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ISCD" , i)		'종목코드
			
			szData16 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "APLY_MNRT" , i)		'적용금리
			szData17 = ""																			'발행금액(확인필요)
			szData18 = ""																			'발행금리(확인필요)
			szData19 = ""																			'매수단가(확인필요)
			
			'외화RP 매도 연계 관련 데이터
			szData20 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "BYOV_SRNO" , i)		'매수일련번호 
			szData21 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ACNO" , i) & DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "ASNO" , i)	'전체계좌번호
			
			'202308 발행어음 개발 추가
			szData22 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "UI_ITEM_NAME001" , i)	'발행어음번호 
			
			'20230920 현재가, 기준가 추가
			szData23 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_146r", "OutBlock1", "VLTN_UNPR" , i)
			
			'전체계좌 조회시
'			if g_szList(1) == "Y" then	
				cont0.grd1.SetCellData("bd_cell0", g_nNextCount, szTemp0)
				cont0.grd2.SetCellData("bd_cell0", g_nNextCount, szTemp0)
'			end if
			
			cont0.grd1.SetCellData("bd_cell1"	, g_nNextCount, szTemp5)
			cont0.grd2.SetCellData("bd_cell1"	, g_nNextCount, szTemp5)
			cont0.grd1.SetCellData("bd_cell5"	, g_nNextCount, szTemp7)
			cont0.grd2.SetCellData("bd_cell5"	, g_nNextCount, szTemp7)
			
			cont0.grd2.SetCellData("bd_pos"		, g_nNextCount, szTemp6)
			cont0.grd2.SetCellData("bd_cell4"	, g_nNextCount, szTemp2)
			cont0.grd2.SetCellData("bd_cell3"	, g_nNextCount, szTemp3)
			
			'기타상품 -> 해외파생
			if g_nCmbIndex = 12 then	
				if szTemp1 = "매수" then
					cont0.grd2.SetCellFgColor("bd_pos", g_nNextCount, "10")
				elseif szTemp1 = "매도" then
					cont0.grd2.SetCellFgColor("bd_pos", g_nNextCount, "11")
				end if
				cont0.grd1.SetCellData("bd_cell2", g_nNextCount, szTemp1 & " | " & szTemp2)
			else
				if szTemp1 = "매수" or szTemp1 = "매도" then
					szName = szTemp1 & " | " & szTemp2
					cont0.grd1.SetCellData("bd_cell2", g_nNextCount, szName)
					cont0.grd1.SetCellData("bd_cell3", g_nNextCount, FormatNumber(szTemp3, 0)&"주")
				'외화표시펀드/해외뮤추얼펀드/CD,CP,전단채/외화채권 잔고수량 입력
				elseIf szPrdtCode == "F" or szPrdtCode == "E" or szPrdtCode == "A" or szPrdtCode == "K" Then
					szName = szTemp2
					cont0.grd1.SetCellData("bd_cell2", g_nNextCount, szName)
					cont0.grd1.SetCellData("Data23", g_nNextCount, szTemp3)
					if szPrdtCode == "A" or szPrdtCode == "K" Then
						cont0.grd1.SetCellData("bd_cell3", g_nNextCount, "만기일 "..MID(szTemp4, 3, 2).."."..MID(szTemp4, 5, 2).."."..MID(szTemp4, 7, 2))
					end if
				'신탁, MMW, 기타해외상품	
				elseIf szPrdtCode == "9" or szPrdtCode == "C" or szPrdtCode == "B" Then
					szName = szTemp2
					cont0.grd1.SetCellData("bd_cell2", g_nNextCount, szName)
					if szPrdtCode == "C" then
						cont0.grd1.SetCellData("Data23", g_nNextCount, szTemp3)
					end if
				else
					szName = szTemp2
					cont0.grd1.SetCellData("bd_cell2", g_nNextCount, szName)
					cont0.grd1.SetCellData("bd_cell3", g_nNextCount, "만기일 "..MID(szTemp4, 3, 2).."."..MID(szTemp4, 5, 2).."."..MID(szTemp4, 7, 2))
'					cont0.grd1.SetCellIDMaskInfo("bd_cell3", "1,0,,,1,만기일 ##.##.##,0,1,0")
				end if
				
			end if
			
			cont0.grd1.SetCellData("PrdtCode", g_nNextCount, szPrdtCode)
			cont0.grd1.SetCellData("Data1", g_nNextCount, szData1)
			cont0.grd1.SetCellData("Data2", g_nNextCount, szData2)
			cont0.grd1.SetCellData("Data3", g_nNextCount, szData3)
			cont0.grd1.SetCellData("Data4", g_nNextCount, szData4)
			cont0.grd1.SetCellData("Data5", g_nNextCount, szData5)
			cont0.grd1.SetCellData("Data6", g_nNextCount, szData6)
			cont0.grd1.SetCellData("Data7", g_nNextCount, szData7)
			cont0.grd1.SetCellData("Data8", g_nNextCount, szData8)
			cont0.grd1.SetCellData("Data9", g_nNextCount, szData9)
			cont0.grd1.SetCellData("Data10", g_nNextCount, szData10)
			cont0.grd1.SetCellData("Data11", g_nNextCount, szData11)
			cont0.grd1.SetCellData("Data12", g_nNextCount, szData12)
			cont0.grd1.SetCellData("Data13", g_nNextCount, szData13)
			cont0.grd1.SetCellData("Data14", g_nNextCount, szData14)
			cont0.grd1.SetCellData("Data15", g_nNextCount, szData15)
			cont0.grd1.SetCellData("Data16", g_nNextCount, szData16)
			cont0.grd1.SetCellData("Data17", g_nNextCount, szData17)
			cont0.grd1.SetCellData("Data18", g_nNextCount, szData18)
			cont0.grd1.SetCellData("Data19", g_nNextCount, szData19)
			cont0.grd1.SetCellData("Data20", g_nNextCount, szTemp1)
			cont0.grd1.SetCellData("Data21", g_nNextCount, szData20)
			cont0.grd1.SetCellData("Data22", g_nNextCount, szData21)
			'cont0.grd1.SetCellData("Data23", g_nNextCount, szData22) 'v002
			cont0.grd1.SetCellData("Data24", g_nNextCount, szData23)
			
			g_nNextCount = g_nNextCount + 1
			
		next
		
		if  DATAMANAGER.IsMoreNextData( szTranID ) == True then 
			DATAMANAGER.RequestNextData( szTranID )
		else
		
			'전체조회시, 다음 종합계좌 조회
			if g_szList(1) == "Y" then	
				AllSearch(szTranID)
			else
				lblVisible()
			end if
		
		end if
	
	
	'---------------------------------------------------------
	'외화 자산 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_145r" then
		
		nCnt = DATAMANAGER.GetDataCount( 0 , "obacb_balc_145r", "OutBlock1")
		
		for i = 0 to nCnt- 1
			
			'행생성
			cont0.grd3.AddRow()
			
			'계좌번호
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "ACNO" , i)	
			szTemp0 = left(szTemp0, 4).."-"..right(szTemp0, 4)
			szTemp0 = szTemp0.."-"..DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "ASNO" , i)
			szTemp0 = szTemp0.."("..DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "ACNT_PRNM" , i)..")"
			
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "CRCD_KOR_NAME" , i)	'통화코드한글명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "FRCR_AMT" , i)		'외화금액
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "CRCD" , i)			'통화코드
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_145r", "OutBlock1", "VLTN_AMT" , i)		'평가금액
			
			
			'전체계좌 조회시
			if g_szList(1) == "Y" then	
				cont0.grd3.SetCellData("bd_acc", g_nNextCount, szTemp0)
			end if
			
			cont0.grd3.SetCellData("bd_name", g_nNextCount, szTemp1)
			cont0.grd3.SetCellData("bd_cell2", g_nNextCount, FormatNumber(szTemp2, 2).." "..szTemp3)
'			cont0.grd3.SetCellData("bd_cur", g_nNextCount, szTemp3)
			cont0.grd3.SetCellData("bd_vltn", g_nNextCount, szTemp4)
			
			g_nNextCount = g_nNextCount + 1
			
		next 
		
		if  DATAMANAGER.IsMoreNextData( szTranID ) == True then 
			DATAMANAGER.RequestNextData( szTranID )
		else
		
			'전체조회시, 다음 종합계좌 조회
			if g_szList(1) == "Y" then	
				AllSearch(szTranID)
			else
				lblVisible()
			end if
		
		end if
	
	
	'계좌번호로 ID연결여부 조회
	elseif szTranID == "obcsb_efif_264r" then
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ID_LNKN_YN" , 0)
		
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		Dim szPrdtCode
		szPrdtCode = cont0.grd1.GetCellData("PrdtCode", g_nSelectRow)
		
		f_SetPopupData(szPrdtCode, g_nSelectRow)
	end if
	
	
End Sub


'============================================================================
Sub cont0_cmb0_OnEditComplete(iIndex)
	cont0.lblcmb.caption = cont0.cmb0.caption
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
	g_nCmbIndex = iIndex
	
	CleanTR()
	GrdVisible( iIndex , " " )
	
	'해외파생
	if iIndex =  12	then		
		if g_szList(1) == "Y" then
			AllSearch( "obacb_balc_146r" )
		else
			InQuery("obacb_balc_146r")
		end if
		
	'Y:전체	그외:개별
	else		
		if g_szList(1) == "Y" then
			AllSearch( "obacb_balc_146r" )
		else
			InQuery("obacb_balc_146r")
		end if
		
		
	End if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
'	g_test = "30141840"
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
	
	cont0.FormTab0.setTabHeaderImage("img_bgcircle_darkblue.9" , "img_bgcircle_lightgray.9" , 10) '활성화/비활성화/여백
	cont0.FormTab0.setTabHeaderFgColor("200" , "295") '활성화/비활성화 폰트색상
		
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page1", "page1", "empty", "0", "기타상품")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page2", "page2", "empty", "0", "외화")
	cont0.FormTab0.currenttab = 0
	
	g_nAllCount = 0
	g_nCmbIndex = 0
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
	g_nNextCount = 0
End Sub 
'============================================================================
Sub cont0_FormTab0_OnTabChanged(nCurrentTab)
'	cont0.grd1.visible = false
'	cont0.grd2.visible = false
'	cont0.grd3.visible = false
	cont0.grd1.left = 1000
	cont0.grd2.left = 1000
	cont0.grd3.left = 1000		
	if nCurrentTab = 0 then
		cont0.lblTop.caption = "보유잔고"
		cont0.lblcmb.visible = true
		cont0.imgCmb.visible = true
		cont0.lblOpen.visible = false
		cont0.imgOpen.visible = false
		
	else
		cont0.lblTop.caption = "보유 외화"
		cont0.lblcmb.visible = false
		cont0.imgCmb.visible = false
		cont0.lblOpen.visible = true
		cont0.imgOpen.visible = true
		
	end if
	
	'상단 카드뷰 평가금액 서비스 호출 후 자산조회
	call VltnAmt_Request()
	
End Sub

'============================================================================
Sub cont0_lblOpen_OnClick()
	Form.OpenScreen("65000" , "")
End Sub

'============================================================================
Sub cont0_imgOpen_OnClick()
	Form.OpenScreen("65000" , "")
End Sub

'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "13")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Function Asset_Request()
	
	'--------------------------------------------------------------
	'기타상품 > 자산구분에 따른 그리드 설정
	'--------------------------------------------------------------
	GrdVisible( cont0.cmb0.currentindex , "Form_OnTriggerEvent" )
	
	'--------------------------------------------------------------
	'전체/개별 구분하여 서비스 호출
	'--------------------------------------------------------------
'	g_szList = Split(g_sParam,"○")
'			
'	if UBOUND(g_szList) < 1 then
'		Exit Function
'	End if
	
	'0:기타상품 1:외화
	if cont0.FormTab0.currenttab == 0 or cont0.FormTab0.currenttab == "0"  then
		szTranID = "obacb_balc_146r"
	else
		szTranID = "obacb_balc_145r"
	end if
	
	'--------------------------------------------------------------
	' 전역변수 초기화
	'--------------------------------------------------------------
	'대상계좌 개수 세팅
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 	
	
	'서비스 날리기전 인덱스 초기화
	g_nNextCount = 0
	
	
	'--------------------------------------------------------------
	'서비스 호출
	'--------------------------------------------------------------
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		AllSearch( szTranID )
	else
		InQuery(szTranID)
	end if


End Function

'============================================================================
Function f_SetPopupData(szCode, nIndex)
	'7`RP
	'8`발행어음
	'9`신탁
	'A`CD, CP/전단채
	'B`외화/기타해외상품
	'C`MMW
	'D`어음관리계좌
	'E`해외뮤추얼펀드
	'F`외화표시펀드
	'H`CMA(외화RP)->미표시
	'J`외화RP
	'K`외화채권
	'L`해외파생
	'E `해외뮤추얼펀드
	Dim szSendData, nSelect
	Dim szData1, szData2, szData3, szData4, szData5, szData6, szData7, szData8, szData9, szData10, szData11, szData12, szData13, szData14, szData15, szData16, szData17, szData18 
	
	nSelect = CInt(nIndex)
	
	Select Case CStr(szCode)
	
		Case "7"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data2", nSelect)
			szData4 = cont0.grd1.GetCellData("Data4", nSelect)
			szData5 = cont0.grd1.GetCellData("Data5", nSelect)
			szData6 = cont0.grd1.GetCellData("Data6", nSelect)
			szData7 = cont0.grd1.GetCellData("Data7", nSelect)
			szData8 = cont0.grd1.GetCellData("Data8", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6 & "☆" & szData7 & "☆" & szData8
		
		Case "8"
'			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
'			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
'			szData3 = cont0.grd1.GetCellData("Data2", nSelect)
'			szData4 = cont0.grd1.GetCellData("Data17", nSelect)
'			szData5 = cont0.grd1.GetCellData("Data4", nSelect)
'			szData6 = cont0.grd1.GetCellData("Data5", nSelect)
'			szData7 = cont0.grd1.GetCellData("Data16", nSelect)
'			szData8 = cont0.grd1.GetCellData("Data18", nSelect)
'			
'			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6 & "☆" & szData7 & "☆" & szData8
			
			'202308 발행어음 개발 추가
			szData1 = cont0.grd1.GetCellData("Data22", nSelect)
			szData2 = cont0.grd1.GetCellData("Data23", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2
		
		Case "9"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data2", nSelect)
			szData4 = cont0.grd1.GetCellData("Data1", nSelect)
			szData5 = cont0.grd1.GetCellData("Data3", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5
			
		Case "A"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data1", nSelect)
			szData4 = cont0.grd1.GetCellData("Data3", nSelect)
'			szData5 = cont0.grd1.GetCellData("bd_cell3", nSelect)
			szData5 = cont0.grd1.GetCellData("Data23", nSelect)
			szData6 = cont0.grd1.GetCellData("Data9", nSelect)
			szData7 = cont0.grd1.GetCellData("Data2", nSelect)
			szData8 = cont0.grd1.GetCellData("Data4", nSelect)
			szData9 = cont0.grd1.GetCellData("Data5", nSelect)
			szData10 = cont0.grd1.GetCellData("Data15", nSelect)		'종목코드(pick 상품 구분용)
			
			'20230920 현재가, 기준가 추가
			szData11 = cont0.grd1.GetCellData("Data24", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6 & "☆" & szData7 & "☆" & szData8 & "☆" & szData9 & "☆" & szData10 & "☆" & szData11
		
		Case "C"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data23", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3
		
		Case "E"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data2", nSelect)
			szData4 = cont0.grd1.GetCellData("Data3", nSelect)
			szData5 = cont0.grd1.GetCellData("Data23", nSelect)
			szData6 = cont0.grd1.GetCellData("Data10", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6
		
		Case "F"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data1", nSelect)
			szData4 = cont0.grd1.GetCellData("Data3", nSelect)
			szData5 = cont0.grd1.GetCellData("Data23", nSelect)
			szData6 = cont0.grd1.GetCellData("Data2", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6
		
		Case "J"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data2", nSelect)
			szData4 = cont0.grd1.GetCellData("Data1", nSelect)
			szData5 = cont0.grd1.GetCellData("Data6", nSelect)
			szData6 = cont0.grd1.GetCellData("Data11", nSelect)
			szData7 = cont0.grd1.GetCellData("Data12", nSelect)
			szData8 = cont0.grd1.GetCellData("Data13", nSelect)
			szData9 = cont0.grd1.GetCellData("Data4", nSelect)
			szData10 = cont0.grd1.GetCellData("Data5", nSelect)
			szData11 = cont0.grd1.GetCellData("Data14", nSelect)
			szData12 = cont0.grd1.GetCellData("Data15", nSelect)
			
			'외화RP매도 연계 데이터
			szData13 = cont0.grd1.GetCellData("Data22", nSelect)		'전체계좌번호
			szData14 = cont0.grd1.GetCellData("Data21", nSelect)		'매수일련번호
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6 & "☆" & szData7 & "☆" & szData8 & "☆" & szData9 & "☆" & szData10 & "☆" & szData11 & "☆" & szData12 & "☆" & szData13 & "☆" & szData14
		
		Case "K"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data2", nSelect)
'			szData4 = cont0.grd1.GetCellData("bd_cell3", nSelect)
			szData4 = cont0.grd1.GetCellData("Data23", nSelect)
			szData5 = cont0.grd1.GetCellData("Data10", nSelect)
			szData6 = cont0.grd1.GetCellData("Data4", nSelect)
			szData7 = cont0.grd1.GetCellData("Data5", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6 & "☆" & szData7
		
		Case "L"
			szData1 = cont0.grd1.GetCellData("bd_cell2", nSelect)
			szData2 = cont0.grd1.GetCellData("bd_cell5", nSelect)
			szData3 = cont0.grd1.GetCellData("Data1", nSelect)
			szData4 = cont0.grd1.GetCellData("Data20", nSelect)		'잔고구분(데이터확인필요)
			szData5 = cont0.grd1.GetCellData("bd_cell3", nSelect)
			szData6 = cont0.grd1.GetCellData("Data10", nSelect)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6
	End Select
	
'	Form.ShowAlert("szSendData" & szCode, szSendData)
	
	'위에서 데이터를 세팅해주는 상품만 팝업을 띄움
	If szCode == "7" Or szCode == "8" Or szCode == "9" Or szCode == "A" Or szCode == "C" Or szCode == "E" Or szCode == "F" Or szCode == "J" Or szCode == "K" Or szCode == "L" then
		Form.OpenPopupAnimation("mbact71052_pj", szSendData, "", "2")
	End If
End Function

'============================================================================
Sub cont0_grd1_OnClickUp(lRow, szCellID)
	Dim szPrdtCode, szTempAcnt
	szPrdtCode = cont0.grd1.GetCellData("PrdtCode", lRow)
	szTempAcnt = cont0.grd1.GetCellData("bd_cell0", lRow)
	
	szTempAcnt = Left(szTempAcnt, 12)
	szTempAcnt = Replace(szTempAcnt, "-", "")
	
	g_nSelectRow = lRow
	
	'계좌번호로 ID연결여부 조회
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_264r" , "InBlock1" , "ACNO" , 0 , Left(szTempAcnt, 8))
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_264r" , "InBlock1" , "ASNO" , 0 , Right(szTempAcnt, 2))
	DATAMANAGER.RequestTranData( "obcsb_efif_264r" )
	
'	f_SetPopupData(szPrdtCode, lRow)
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "71052_p7" and sValue == "refresh" then	'RP매도화면에서 주문완료 후 잔고 재조회
		call VltnAmt_Request()
	end if	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.imgOpen.setMaintaingRatio("1")
	cont0.imgCmb.setMaintaingRatio("1")
End Sub

'============================================================================
Sub cont0_lblcmb_OnClick()
	cont0.cmb0.openlist()
End Sub 

'============================================================================
Sub cont0_grd2_OnClickUp(lRow, szCellID)
	if IRow <> -1 then
		szCode = cont0.grd1.GetCellData("PrdtCode", lRow)
			szData1 = cont0.grd1.GetCellData("bd_cell2", lRow)	'종목명
			szData2 = cont0.grd1.GetCellData("bd_cell5", lRow)
			szData3 = cont0.grd1.GetCellData("Data1", lRow)
			szData4 = cont0.grd1.GetCellData("Data20", lRow)		'잔고구분
			szData5 = cont0.grd2.GetCellData("bd_cell3", lRow)	'주
			szData5 = FormatNumber(szData5, 0).."주"	
			szData6 = cont0.grd1.GetCellData("Data10", lRow)
			
			szSendData = szCode & "☆" & szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6

			Form.OpenPopupAnimation("mbact71052_pj", szSendData, "", "2")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "close" Then
		Form.triggerEvent("#", sKeyName, "")
	End If
End Sub

