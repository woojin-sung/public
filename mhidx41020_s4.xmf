	<SCRIPT_INFO _len="61216" _ulen="56040" >
'============================================================================
' 01. 화 면 명 : 메리츠TOP50
' 02. 화면설명 : 메리츠TOP50
' 03. 작    성 : 2016. 02. 15. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCode			'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START
Dim g_nHour			'시간
Dim g_nMinute			'분

'20211005 아이티젠(김성수) START
'시장종합 개편 추가
dim	g_szRSelect
g_szRSelect = "0"
'20211005 아이티젠(김성수) END

dim g_nProc
g_nProc = 0

dim g_tCode
g_tCode = {}

Dim g_nMaxCnt
g_nMaxCnt = 5

Dim g_szUserID

Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm

'g_tGSelect = {}
'g_tDefault = {"GW_WATCHING"}
'g_tKey     = {"AA"}
'g_tNm      = {"Watching종목"}

Dim g_szIndex

Dim g_szAppFirst
g_szAppFirst = "NO"
'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	dim szMk, szCd, szGubun
	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		szGubun = Trim(grdCode.GetCellData("bd_gubun", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
				grdMk.SetCellData("bd_gubun", 0, szGubun)
			end if
	
			For j = 0 to nRow2 - 1
				dim szMk2
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					grdMk.SetCellData("bd_gubun", j, szGubun)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
					grdMk.SetCellData("bd_gubun", j, szGubun)
				end if
			Next		
		end if
	Next
	
'	if CInt(grdCode.rowcount) > 0 then
'		if Cint(FormTab0.currenttab) == 0 then
			' 관심종목 데이터조회
			DATAMANAGER.RequestTranData( "ohhts_1020_004r" ) '전체라면 국내 후 해외조회)
'		end if	
'	else
'		f_SetGrdTileUI(0)
'	end if
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
	
End Function

'============================================================================
' f_SetGrdTileData(iIdx) : 그리드 데이터 SET
'============================================================================
Function f_SetGrdTileData(iIdx)
	dim szCode, szNo, szName, nPrc, szSym, nDebi, nRate
	
'	szNo 	= grd0.GetCellData( "bd_cell0", iIdx )
	nRate 	= CDbl(grd0.GetCellData( "bd_rate", iIdx ))
	szName 	= grd0.GetCellData( "bd_name", iIdx )
	nPrc  	= grd0.GetCellData( "bd_cur", iIdx )
	szSym  	= grd0.GetCellData( "bd_sign", iIdx )
	nDebi 	= grd0.GetCellData( "bd_debi", iIdx )
	szCode 	= grd0.GetCellData( "bd_code", iIdx )
	g_szIndex = ""

	Select Case iIdx
		Case 0
			cont0.grdtile0.SetCellData( "bd_name"	, 0, szName 	)
			cont0.grdtile0.SetCellData( "bd_prc"		, 0, nPrc 	)
			cont0.grdtile0.SetCellData( "bd_sym"		, 0, szSym 	)
			cont0.grdtile0.SetCellData( "bd_debi"	, 0, nDebi	)
			cont0.grdtile0.SetCellData( "bd_rate"	, 0, nRate 	)
			cont0.grdtile0.SetCellData( "bd_code"	, 0, szCode 	)
			
		Case 1
			cont0.grdtile1.SetCellData( "bd_name"	, 0, szName 	)
			cont0.grdtile1.SetCellData( "bd_prc"		, 0, nPrc 	)
			cont0.grdtile1.SetCellData( "bd_sym"		, 0, szSym 	)
			cont0.grdtile1.SetCellData( "bd_debi"	, 0, nDebi 	)
			cont0.grdtile1.SetCellData( "bd_rate"	, 0, nRate 	)
			cont0.grdtile1.SetCellData( "bd_code"	, 0, szCode 	)
		Case 2
			cont0.grdtile2.SetCellData( "bd_name"	, 0, szName 	)
			cont0.grdtile2.SetCellData( "bd_prc"		, 0, nPrc 	)
			cont0.grdtile2.SetCellData( "bd_sym"		, 0, szSym 	)
			cont0.grdtile2.SetCellData( "bd_debi"	, 0, nDebi 	)
			cont0.grdtile2.SetCellData( "bd_rate"	, 0, nRate 	)
			cont0.grdtile2.SetCellData( "bd_code"	, 0, szCode 	)
		Case 3
			cont0.grdtile3.SetCellData( "bd_name"	, 0, szName 	)
			cont0.grdtile3.SetCellData( "bd_prc"		, 0, nPrc 	)
			cont0.grdtile3.SetCellData( "bd_sym"		, 0, szSym 	)
			cont0.grdtile3.SetCellData( "bd_debi"	, 0, nDebi 	)
			cont0.grdtile3.SetCellData( "bd_rate"	, 0, nRate 	)
			cont0.grdtile3.SetCellData( "bd_code"	, 0, szCode 	)
		Case 4
			cont0.grdtile4.SetCellData( "bd_name"	, 0, szName 	)
			cont0.grdtile4.SetCellData( "bd_prc"		, 0, nPrc 	)
			cont0.grdtile4.SetCellData( "bd_sym"		, 0, szSym 	)
			cont0.grdtile4.SetCellData( "bd_debi"	, 0, nDebi 	)
			cont0.grdtile4.SetCellData( "bd_rate"	, 0, nRate 	)
			cont0.grdtile4.SetCellData( "bd_code"	, 0, szCode 	)
	End Select
	
	g_nProc = g_nProc + 1
	f_SetGrdTileColor(iIdx, nRate)
	
End Function
'============================================================================
' f_SetGrdTileColor(iIdx, nRate) : 그리드 데이터 컬러 SET
'============================================================================
Function f_SetGrdTileColor(iIdx, nRate)
	dim sColor
	
	if nRate <> null then
		if nRate > 0 then
			sColor = "10"
		elseif nRate < 0 then
			sColor = "11"
		else
			sColor = "13"
		end if
	end if

	Select Case iIdx
		Case 0
			cont0.grdtile0.SetCellFgColor( "bd_prc", 0, sColor )
			cont0.grdtile0.SetCellFgColor( "bd_debi", 0, sColor )
		Case 1
			cont0.grdtile1.SetCellFgColor( "bd_prc", 0, sColor )
			cont0.grdtile1.SetCellFgColor( "bd_debi", 0, sColor )
		Case 2
			cont0.grdtile2.SetCellFgColor( "bd_prc", 0, sColor )
			cont0.grdtile2.SetCellFgColor( "bd_debi", 0, sColor )
		Case 3
			cont0.grdtile3.SetCellFgColor( "bd_prc", 0, sColor )
			cont0.grdtile3.SetCellFgColor( "bd_debi", 0, sColor )
		Case 4
			cont0.grdtile4.SetCellFgColor( "bd_prc", 0, sColor )
			cont0.grdtile4.SetCellFgColor( "bd_debi", 0, sColor )
	End Select
End Function

'============================================================================
' f_SetGrdTileUI(nGrd0RowCnt) : grd0의 row 갯수 따라 타일 visible 및 위치 값 SET
'============================================================================
Function f_SetGrdTileUI(nGrd0RowCnt)
	dim g_nMaxCnt, nInitLeft, nTileW, nBlankW
	
	g_nMaxCnt 	= 5 '표시할 수 있는 최대 타일 갯수(현재는 5개)
	nInitLeft 	= 0'10 '기본 왼쪽 위치 값
	nTileW 		= CInt(cont0.grdtile0.width-10) '타일 하나의 넓이
	nBlankW 		= 20'5 '타일 사이의 공백 넓이
	
	for i=0 to g_nMaxCnt-1
		'grd0에 셋팅된 로우 수 만큼 visible 및 위치 설정
		if i < nGrd0RowCnt then 
			Form.SetCtlProp("cont0.grdtile" & i, "visible", "1")
			Form.SetCtlProp("cont0.grdtile" & i, "left", nInitLeft+(nTileW+nBlankW)*i )
		else
			Form.SetCtlProp("cont0.grdtile" & i, "visible", "0")
			Form.SetCtlProp("cont0.grdtile" & i, "left", nInitLeft )
		end if
	next
	'스크롤 마지막에 공백부분 만들어줄 컨트롤 위치 SET
	cont0.lblBlank.left = nInitLeft + (nTileW+nBlankW) * nGrd0RowCnt 
	'스크롤 범위 재설정
	cont0.setScrollAutoSize() 
End Function

'============================================================================
' f_OpenScreen(szCode) : 현재가 이동 함수
'============================================================================
Function f_OpenScreen(szCode, szMk, szKorname)
	if szCode = "" or szCode = null then
		Form.ShowAlert("안내", "종목 정보가 없습니다.")
		exit Function 
	end if
	
	Select Case szMk
		Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			Form.OpenScreen("11000", szCode)
			LblGuide.visible = false
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가	
			Form.OpenScreen("31000", szCode)		
			LblGuide.visible = false
		Case "U"						' 업종코드
			Form.OpenScreen("42000", "2" & "★" & szCode )	'20230922 HSZ: 업종현재가 이동
			LblGuide.visible = false
		Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
'			szData = nYPos & "★" & nheight & "★" & "3" & "★" & g_szSltMk & "★해외지수★해외차트★★★"
'			
'			Screen_No(szData, "42040", "", "42050")

			Form.OpenScreen("42040", szCode)		
			LblGuide.visible = false
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54010", "관심종목★" & szCode & "★" )
			LblGuide.visible = false
'		Case "U", "N", "EN", "FN"		' 업종코드(U) 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
'			LblGuide.visible = true
			
'		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"	
		Form.SetSharedData( "&ITEM_CODE" , szCode )
		Form.SetSharedData( "&ITEM_KORNAME" , szKorname )
		Form.SetSharedData( "&ITEM_OVERSTOCK", szCode.."★"..szKorname.."★".."", "" )	
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCode.."★"..szKorname.."★".."", "" )
		Form.OpenScreen("16000", "")
		LblGuide.visible = false
	End Select

End Function



'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 10) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	g_szUserID =  Form.GetSharedData("&USER_ID", false)
	Label1.fgcolor = 334

	g_nCount = 0
	cont0.grdtile0.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grdtile1.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grdtile2.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grdtile3.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grdtile4.setUseCardView(true, 10, "img_bgbox_gray.9")

	'0807 JJH deletepage -> insertpage로 수정
	'------------------------------------------------------------------------------------------
	Dim nCurTab
	nCurTab = Form.GetSharedData( "MY_STOCK", false  )
	if nCurTab == "" then
		nCurTab = 0
	end if

	DIm szRecentTab, szHoldTab
	
	szRecentTab = Form.LoadConfigData("GW_SET2", "RECENT")
	szHoldTab = Form.LoadConfigData("GW_SET2", "HOLD")
	'0808 설정값 없을 때 예외처리 추가
	if szRecentTab == "1" or szRecentTab == "" then
		FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "mhidx41020_s9", "0", "최근")
	end if
	if szHoldTab == "1" or szHoldTab == "" then
		FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "mhidx41020_s9", "0", "보유")
	end if
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "mhidx41020_s9", "0", "관심")
	
	if CInt(FormTab0.tabcount) - 1 < CInt(nCurTab) then
		nCurTab = 0
	end if
		
	FormTab0.currenttab = nCurTab
	
	if FormTab0.currenttabpageid <> "page3" then
		f_RequestItemData()
	else
		init_GWGroup()
'		imgGrp.visible = true
'		lblGroupNm.visible = true
	end if

	cont0.grdtile0.scrollenable = "0"
	cont0.grdtile1.scrollenable = "0"
	cont0.grdtile2.scrollenable = "0"
	cont0.grdtile3.scrollenable = "0"
	cont0.grdtile4.scrollenable = "0"
	
	cont0.setScrollBarVisible("0") 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	'0807 JJH "ohhts_intr_006r" 서비스 시작위치 변경
	'------------------------------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		If DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1") < 1 Then	
			imgGrp.visible = false
			lblGroupNm.visible = false
			cont0.visible = false
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
		else
			imgGrp.visible = true
			lblGroupNm.visible = true
		end if
	'------------------------------------------------------------------------------------------
		Call Insert_cmbGroup()		' 관심그룹을 그룹콤보에 넣기
		
		g_szAppFirst = "YES"
	' ----------------------------------------------------------------------
	' 관심종목 종목
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		dim nRow
		nRow = Cint(DATAMANAGER.GetDataCount( 0, "ohhts_intr_007r", "OutBlock1"))
		grdCode.rowcount = nRow
		grd0.SetClear()

		for i = nRow - 1 to  0 step -1
		
			dim szCode, szMk, szName, tCode, nMkLen, szGubun
			'0804 JJH grdCode에 스크립트로 데이터 삽입
		'----------------------------------------------------------------------------------------------------
			szMk = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_INPUT_MRKT_CLS_CODE" , i )
			szCode = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD" , i )
			szMemo = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_MEMO_CNTT" , i )
		'----------------------------------------------------------------------------------------------------
			szMk 	= Change_EtcMarket(szMk)			
			szName	= Form.GetItemCodeInfo(szCode, "name")
			
			if Trim(szName) == "" then
				szName = Form.GetItemCodeInfo(szMk & "@" & szCode, "name")
			end if
			
			if Form.GetItemCodeInfo(szMk & "@" & szCode, "market") == "OV" then
				szGubun = "OV"
			else
				szGubun = "KR"
			end if
			
			grdCode.SetCellData("bd_code", 	i, szCode)
			grdCode.SetCellData("bd_mk", 	i, szMk)
			grdCode.SetCellData("bd_name", 	i, szName)
			grdCode.SetCellData("bd_gubun", i, szGubun) 
			'JJH 0809 공백제거 추가
			if szCode == "EMPTY" or szCode == "" or szName == "" then
				grdCode.SetDeleteRow(i)
			end if
		next
		
		Call Save_grdMk()

	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then '국내
		
		g_nCount = 0
'		g_tCode = {}
		dim nCount
		nCount = grdCode.rowcount
		nRowcount = 0
		grd0.rowcount = 5
		
		for i = 0 to CInt(nCount) - 1
			if CInt(nCount) > 0 then
				
				szCd = grdCode.GetCellData("bd_code", i)
				szMk = grdCode.GetCellData("bd_mk", i)
				korname = grdCode.GetCellData("bd_name", i)			
				szbdGubun = grdCode.GetCellData("bd_gubun", i)
			
				if szbdGubun == "KR" then '국내인 경우
					For j = 0 to g_nMaxCnt - 1			
						dim nGridRow, code
						nGridRow = i	
						code = DATAMANAGER.GetDataValue( false, "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD" , j )  '종목코드
						
						if code == szCd and Trim(code) <> ""  then	'20230518 HSZ : 빈값체크로직 추가
'							
							szMarketNm = f_GetMarketName(szCd)
							
							sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRPR", j ) '현재가							
							diff		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , j ) '대비
							sign		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", j ) '대비부호
							rate		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_CTRT", j ) '대비율
							isnm		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISNM", j ) '종목명
							
							grd0.SetCellData( "bd_cur"  , i, sclose )	
							grd0.SetCellData( "bd_code" , i, szCd )
							grd0.SetCellData( "bd_name" , i, korname )		
							grd0.SetCellData( "bd_debi" , i, diff)
							grd0.SetCellData( "bd_rate" , i, rate )	
							grd0.SetCellData( "bd_sign" , i, sign )	
							grd0.SetCellData( "bd_market" , i, szMk )	
							
							g_nCount = g_nCount + 1
							exit for
						end if 
					Next
				end if
			end if
		Next		
		
		DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) '해외
			
	elseif szTranID == "ohhts_1030_002r" then	'해외(주간시세)
		Dim tItemData, nIndex, sCellBong, szMk, szFlag
		Dim nRequestCount1, nRequestCount2 
		nRequestCount1 = 0
		nRequestCount2 = 0
		
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")
'		DATAMANAGER.CancelRealData("ohhts_exst_cntd")	'20230109 HSZ 주간거래 실시간 해제
		
		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1030_002r", "OutBlock1" ) )
		
		For i = 0 to grdCode.rowcount - 1
			dim szCd, szMk, korname, szbdGubun
			
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			korname = grdCode.GetCellData("bd_name", i)			
			szbdGubun = grdCode.GetCellData("bd_gubun", i)
				
			if szbdGubun == "OV" then '해외인 경우 
			
				For j = 0 to nCount-1
				
					code = DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ISCD" , j ) 
					nDtclose	= Cdbl(DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j ))	'20230109 HSZ
					
					if code == szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가
						
						'20230109 HSZ START : 주간시세 적용 분기 구문
'						if g_szDaysise = "1" and nDtclose <> 0 then '주간시세 체크O & 주간시세 종목O
'							symbol		= szMk
'							korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )	
'							sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
'							diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS" , j )
'							sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS_SIGN" , j )
'							rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT" , j )
'							sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )
'							sDtclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j )

'							grd0.SetCellData( "bd_cur" , i, Decimal_Setting( sDtclose , sdecimal ) )
'						else
							symbol		= szMk
							korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
							sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
							diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS" , j )
							sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , j )
							rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_CTRT" , j )
							sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )
							
							grd0.SetCellData( "bd_cur" , i, Decimal_Setting( sclose , sdecimal ) )
'						end if
						'20230109 HSZ END
						
						grd0.SetCellData( "bd_code" ,i, szMk&"@"&szCd )
						grd0.SetCellData( "bd_name" , i, korname )
'						grd0.SetCellData( "bd_cur" , i, Decimal_Setting( sclose , sdecimal ) )	
						grd0.SetCellData( "bd_debi" , i, Decimal_Setting( diff , sdecimal ) )
						grd0.SetCellData( "bd_rate" , i, rate )
						grd0.SetCellData( "bd_sign" , i, sign )
						grd0.SetCellData( "bd_market" , i, szMk )
						
						g_nCount = g_nCount + 1
						' 시장별 실시간여부값
						szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
						
						
'						if szMk == "AX" or szMk == "NY" or szMk == "OQ" then
'							DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , nRequestCount1 , szMk&"@"&szCd)
'							nRequestCount1 = nRequestCount1 + 1
'						else
							DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount2 , szMk&"@"&szCd)
							nRequestCount2 = nRequestCount2 + 1
'						end if
						
						
						
					else
						' 오프라인 종목일경우 obsim_stsv_048r 에서 나온 현재가, 종목명 등을 사용
						if szOnline == "N" then

							grd0.SetCellData( "bd_code" , g_nCount, szMk&"@"&szCd )
							
						end if
					end if
				Next
			end if 
		Next
		grd0.keyall = "1"
		
		'최대 5 종목만 시세조회가 가능
		if g_nCount < 5 then
			grd0.rowcount = g_nCount
		else
			grd0.rowcount = 5
		end if 
		
		for i = 0 to grd0.rowcount - 1 
			f_SetGrdTileData(i)
		next
		
		f_SetGrdTileUI(CInt(grd0.rowcount))
		
		if Cint(grd0.rowcount) == 0 then
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			if FormTab0.currenttabpageid == "page2" then
				lbNoticeMsg.caption = "보유한 종목이 없어요."
			elseif FormTab0.currenttabpageid == "page3" then
				lbNoticeMsg.caption = "등록된 종목이 없어요."	
			end if
		else
			imgNotice.visible = false
			lbNoticeMsg.visible = false
		end if
		' 실시간을 위한 작업 ////////////////////////////////////////////// 
		'전체, 해외
		For j = 0 to grdMk.rowcount - 1
			szCd = grdMk.GetCellData("bd_code", j)
			szMk = grdMk.GetCellData("bd_mk", j)
			
			if szCd <> "" and szMk <> "" then
				tCode = Split(szCd, "★")
				
				For k = 0 to #tCode-1
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, tCode(k))

					if szMk <> "" then
						Set_Real_Input(szMk, k, tCode(k))
					end if
				Next
				
				Request_RealData(szMk)
			end if
		Next

	elseif szTranID == "obsim_stsv_047r" then  

		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
	
		if nCnt > 0 then				
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0 or szTranID == "obsim_stsv_072r" then
				grdCode.SetClear()
			end if 				
			For i = 0 to nCnt -1 
			
				szCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", i)
				grdCode.insertrow = nRow
				
				'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
				szMk = Form.GetItemCodeInfo(szCd, "market")
				select Case szMk
				Case "Q", "BN", "B"
				
				'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
				Case "J"
					szCutCd = szCd
				'20210608 SWJ END
				
				Case Else
					szCutCd = Mid(szCd, 2, Len(szCd))
					szMk = Form.GetItemCodeInfo(szCutCd, "market")
				End Select
				'20160729 NOHES END
				
				' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
				' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
				' ETN (mk) = Q, 채권(mk) = BN
		
				Select Case szMk
					Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가
						grdCode.SetCellData("bd_code", nRow, szCutCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					Case "Q", "BN", "B"
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
					Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
					'20160729 NOHES END
					Case Else
						if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
							grdCode.SetCellData("bd_code", nRow, szCutCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						else
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
						end if
				End Select
				' ////////////////////////////////////////////////////////////////////////////////////////////
				szMk = Change_EtcMarket(szMk)
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "KR") '국내
				
				nRow = nRow + 1
			Next
		end if
		'해외 보유종목		
	elseif szTranID == "obsim_stsv_048r" then

		nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1")
		if nCnt > 0 then
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				
			
			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ISCD", i)
				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "KOR_NAME", i)
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "OV") '해외
				
				nRow = nRow + 1
			Next				
		end if
		
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_048r" ) == True then '해외 보유종목 NEXT
			 g_nNextCount = grdCode.rowcount
			DATAMANAGER.RequestNextData( "obsim_stsv_048r" )
		else		
			' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
			Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
			Save_grdMk()	
		end if
				
	end if
	if szTranID == "obsim_stsv_047r" then '국내 보유종목  NEXT
		
	     g_nNextCount = grdCode.rowcount			    
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_047r" ) == True then 
			DATAMANAGER.RequestNextData( "obsim_stsv_047r" )
		else
			DATAMANAGER.RequestTranData( "obsim_stsv_048r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 보유종목 조회(국내/국내CFD/해외/해외CFD)
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_048r" then
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 0, g_szUserID)
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 국내 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1020_004r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1020_004r" )
		grd0.SetClear()
		
		j = 0

		For i = 0 to grdCode.rowcount-1
			if grdCode.GetCellData("bd_gubun", i) == "KR" then '국내인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
			
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j, szMk)
				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD",               j, szCd)
				j = j + 1
			end if 
		Next
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 해외 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1030_002r" then	
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		
		j = 0
		For i = 0 to grdCode.rowcount-1
		
		    if grdCode.GetCellData("bd_gubun", i) == "OV" then '해외인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				tCode = {}
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j , "OV" ) '해외주식			
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", j , szCd ) ' 종목코드
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", j , szMk ) '종목시장
				' 시장별 실시간여부값
				szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", j, szRealAble ) '실시간여부
'				f_SetGrdTileData(i)
				j = j + 1
			end if 
		Next
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_006r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",			0, g_szUserID)

	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, g_szUserID)	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGSID)		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "ohhts_intr_006r" and szErrCode == "9900" then
		exit Sub
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	dim nPrc, szCode, szRealCode, szRealCur
	
	if szTranID == "ohhts_frbr_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_frbr_cntg", "OutBlock1", "FIDR_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_frbr_cntg", "OutBlock1", "FIDR_PRPR", 0)
		
	elseif szTranID == "ohhts_stck_incg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_stck_incg", "OutBlock1", "RLTM_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_stck_incg", "OutBlock1", "RLTM_PRPR", 0)
	
	elseif szTranID == "ohhts_futs_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_futs_cntg", "OutBlock1", "FIDR_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_futs_cntg", "OutBlock1", "FIDR_PRPR2", 0)
	
	elseif szTranID == "ohhts_optn_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_optn_cntg", "OutBlock1", "FIDR_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_optn_cntg", "OutBlock1", "FIDR_PRPR2", 0)
	
	elseif szTranID == "ohhts_elw_cntg"  then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_elw_cntg", "OutBlock1", "FIDR_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_elw_cntg", "OutBlock1", "FIDR_PRPR", 0)
	
	elseif szTranID == "ohhts_sfut_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_sfut_cntg", "OutBlock1", "FIDR_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_sfut_cntg", "OutBlock1", "FIDR_PRPR", 0)
	
	elseif szTranID == "ohhts_sopt_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_sopt_cntg", "OutBlock1", "FIDR_SHRN_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_sopt_cntg", "OutBlock1", "FIDR_PRPR", 0)
		
	elseif szTranID == "ohhts_nmix_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_BSTP_CLS_CODE", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2", 0)
		
'		ShowAlert("",DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS2", 0))
	elseif szTranID == "ohhts_bond_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_bond_cntg", "OutBlock1", "FIDR_STND_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_bond_cntg", "OutBlock1", "FIDR_PRPR2", 0)
		
	elseif szTranID == "ohhts_ovrs_nmix" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_SYMB", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_PRPR2", 0)
	
	elseif szTranID == "ohhts_nfut_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_nfut_cntg", "OutBlock1", "FIDR_SYMB", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2", 0)
	
	elseif szTranID == "ohhts_exrt_cntg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_exrt_cntg", "OutBlock1", "FIDR_SYMB", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_exrt_cntg", "OutBlock1", "FIDR_EXRT_PRPR", 0)
		
	elseif szTranID == "ohhts_exst_ictg" then
		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_ISCD", 0)
		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_PRPR", 0)
		
'	elseif szTranID == "ohhts_exst_cntd" then
'		szRealCode	= DATAMANAGER.GetDataValue(1, "ohhts_exst_cntd", "OutBlock1", "FIDXR_ISCD", 0)
'		szRealCur	= DATAMANAGER.GetDataValue(1, "ohhts_exst_cntd", "OutBlock1", "FIDXR_PRPR", 0)
		
	end if
	
	for i = 0 to grd0.rowcount -1 
		szCode 	= grd0.GetCellData( "bd_code", i )
		nPrc  	= grd0.GetCellData( "bd_cur", i )
		
		if szCode == szRealCode then
			if nPrc <> CDbl(szRealCur) then
				g_szIndex = i
				Form.SetTimerEvent2("1", 1, 0.5)
'				f_SetGrdTileData(i)
			end if
		end if
	next
	
	
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList

	if g_szCode == "" then
		Exit Sub
	end if
	
	if sKeyName == "MOVEPOP_RETURN" then
		szList = Split(sRet , "★")
		
		Select Case szList(1)
			Case "0"		'현재가
				Form.OpenScreen("11000" , g_szCode & "★" & "0")
			Case "1" 	'차트
				Form.OpenScreen("13000" , g_szCode)
			Case "2" 	'관심등록
				Form.OpenPopup( "mhprc11000_pd" , g_szCode , sPosInfo)
			Case "3" 	'매수
				Form.OpenScreen("12000" , "관심종목" & "★" & "0" & "★" & g_szCode)
			Case "4" 	'매도
				Form.OpenScreen("12000" , "관심종목" & "★" & "1" & "★" & g_szCode)
		End Select
	
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
'0808 jjh onforminit 안의 insertPage를 다시 호출하므로 변경
	if FormTab0.currenttabpageid <> "page3" then
		f_RequestItemData()
	else
		init_GWGroup()
	end if
End Sub

'============================================================================
Sub lbl0_OnClick()
	Form.triggerEvent("#", "HOME_SCROLL", "")
	if FormTab0.currenttabpageid == "page1" then
		szLink = "BB"
	elseif FormTab0.currenttabpageid == "page2" then
		szLink = "CC"
	elseif FormTab0.currenttabpageid == "page3" then
		szLink = cmbGroup.cbkeydata
	end if
	
	Form.OpenScreen("11010" , "HOME★" & szLink)
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.triggerEvent("#", "HOME_SCROLL", "")
	if FormTab0.currenttabpageid == "page1" then
		szLink = "BB"
	elseif FormTab0.currenttabpageid == "page2" then
		szLink = "CC"
	elseif FormTab0.currenttabpageid == "page3" then
		szLink = "page" & cmbGroup.cbkeydata
	end if
	
	Form.OpenScreen("11010" , "HOME★" & szLink)
End Sub



