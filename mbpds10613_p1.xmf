<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrname="저축장려정보제공동의약관" version="2" writer="성주혁" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,0,375,560,1" />
		<BUTTON name="BtnCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,561,187,45,1" />
		<BUTTON name="BtnOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,561,188,45,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1864" _ulen="1798" >
'============================================================================
' 저축장려정보제공동의 이용약관
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet	'리턴값
g_szRet	=	"0"

Dim g_URLheader
Dim g_ServerMode

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
		g_URLheader = "http://testhome.imeritz.com/include/resource/htsdown/PDF/"
	Else
		g_URLheader = "http://home.imeritz.com/include/resource/htsdown/PDF/"
	End If
	WebView0.viewtype = 0
	WebView0.urlpath = g_URLheader & "mts_meritz_230908.pdf"
	
	Form.SetScreenName("금융거래정보 이용ㆍ제공 동의")
End Sub

'============================================================================
'BtnOK_OnClick
'============================================================================
Sub BtnOK_OnClick()
	g_szRet	=	"1"
	Form.CloseForm()
End Sub


'============================================================================
'BtnCancel_OnClick
'============================================================================
Sub BtnCancel_OnClick()
	g_szRet	=	"0"
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbpds10613_p1" , g_szRet)
End Sub



	</SCRIPT_INFO>
</ROOT>