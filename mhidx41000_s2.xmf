'============================================================================
'fmtab01_OnTabChanged
'============================================================================
Sub fmtab01_OnTabChanged(nCurrentTab)

	if	nCurrentTab	=	0	then
		lblChartTitle.left	=	400
	elseif	nCurrentTab	=	1	then
		lblChartTitle.left	=	269
		lblChartTitle.caption	=	"거래소(백만)"
	elseif	nCurrentTab	=	2	then
		lblChartTitle.left	=	269
		lblChartTitle.caption	=	"코스닥(백만)"
	elseif	nCurrentTab	=	3	then
		lblChartTitle.left	=	269
		lblChartTitle.caption	=	"선물(계약)"
		'Form.triggerEvent("fmtab01." & 	fmtab01.currenttabpageid, "CHGMARKET_41000", rdoMarket01.currentindex)
	end if
End Sub


'============================================================================
'rdoMarket01_OnClick
'============================================================================
Sub rdoMarket01_OnClick(nIndex)
	Form.triggerEvent("fmtab01." & 	fmtab01.currenttabpageid, "CHGMARKET_41000", nIndex)

End Sub

