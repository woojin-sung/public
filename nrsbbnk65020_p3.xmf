	g_szGubun = g_tGubun[3]	

	SetCheckFilter("1", "3")
End Sub

'============================================================================
Sub contMain_lblFilter1Gb4_OnClick()	
	g_szGubun = g_tGubun[4]
	
	SetCheckFilter("1", "4")
End Sub


' 환전현황
'============================================================================
