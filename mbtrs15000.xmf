'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet) 'v0001

	if sKeyName == "yesno" then
	
		if sRet == "ok" then
		
			Form.OpenScreen( "72040" , "")	'선옵예탁금
		
		end if
	
	end if
	
End Sub

'============================================================================
Sub btnMy_OnClick()
	'20230728 htw start 잔고탭에서 버튼 클릭 시 마이자산현황화면으로 이동
	Form.OpenScreen("71052","")
End Sub

function f_SetBtn()
	if CInt(fmtab0.currenttab) == 0 then
		btnMy.visible = true
		btnSearch.visible = false
	else
		btnMy.visible = false
		btnSearch.visible = true
	end if
end function

