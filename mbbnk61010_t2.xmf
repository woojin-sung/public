'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_이체결과
' 02. 화면설명 : 이체결과조회 탭화면
' 03. 작    성 : 16.03.03 테스트3
'-------------------------------------------------------------------------------------------
'20221111    김효준 : v008 : 이체종료안내추가
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szID         '사용자 아이디
Dim g_szAccount		'계좌번호
Dim g_szSubAccount	'일련번호
'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'===========================================================================

Sub Form_OnFormInit()
	Form.removeWaitCursor()
USE_YN_CHK() '종료체크 v008
	Grid0.SetClear( )
	Label0.caption = ""
	g_szID = Form.GetSharedData("&USER_ID", false )
 '   szAcnt = Form.GetCtlProp("#accTran", "caption")
'    If Len(szAcnt) < 10 Then
'	    Form.ShowAlert(g_szTitle, "계좌번호를 확인하십시오!")
'	    Exit Sub
'	Else 
'        Button0_OnClick()"bd_cell11"
'	End If
	'DATAMANAGER.RequestTranData("obcsb_efif_021r")
	DATAMANAGER.RequestTranData( "obtss_elbs_122r" )
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_efif_021r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )'주민번호(2)->아이디(1)로 구분설정

		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN", 0 , "N" )'평가수행여부 설정??
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "ELFN_ID", 0 , g_szID)
	ElseIf szTranID == "obtss_elbs_122r" then 
		
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_122r", "InBlock1", "SORT_CLS", 0, "02" )'최근거래내역순
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_122r", "InBlock1", "ACNO", 0, g_szAccount)'Form.GetCtlProp("#accTran", "total"))
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_122r", "InBlock1", "PROD_CLS_CODE", 0 , g_szSubAccount)'Form.GetCtlProp("#accTran", "sequence"))
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_122r", "InBlock1", "IQRY_STA_DATE", 0 , cld0.caption ) '시작일 = 현재일
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_122r", "InBlock1", "IQRY_FIN_DATE", 0 , cld0.caption ) '종료일 = 현재일
	End If  
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim Temp_Acc, szAcc '계좌번호 임시 저장변수
	
	If szTranId == "obcsb_efif_021r" then 
	nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_efif_021r" , "OutBlock1" )

	If nCnt > 0 then
		For i = 0 To nCnt-1
			szMyAcc = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "SELF_ACNT_YN", i)
			if szMyAcc == "Y" then
	       
				szAcno = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ACNO" , i )
				szAsno = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ASNO" , i )
				szAccNo = szAcno & szAsno
				szCustNm = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "CUST_ABWR_NAME", i)
				szProdNm = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "UI_INPR_NAME", i )
			end if
		Next
		Button0_OnClick()  
	End If   
	   
	  
	ElseIf szTranId == "obtss_elbs_122r" then	
    'nCCnt = DATAMANAGER.GetDataCount( 0, "obtss_elbs_122r" , "OutBlock1" )
		nCCnt = Grid0.rowcount
		Label0.caption = "총 "& nCCnt &" 건"
		For i = 0  to nCCnt -1
			if DATAMANAGER.GetDataValue( 0 , "obtss_elbs_122r", "OutBlock1", "OIWD_CLS_CODE", i) =="1" then
				Grid0.SetCellData( "bd_cell7", i, "출금거래" )
			else
				Grid0.SetCellData( "bd_cell7", i, "입금거래" )
			end if
			szCode = DATAMANAGER.GetDataValue( 0 ,"obtss_elbs_122r", "OutBlock1", "OPNG_RPRS_EXIN_CODE" , i)
			Temp_Acc = DATAMANAGER.GetDataValue( 0 , "obtss_elbs_122r", "OutBlock1", "RCVN_TRGT_ACNO" , i)
			if szCode == "287" then
				szAcc = Left(Temp_Acc, 4)&"-"&Mid(Temp_Acc, 5, 4)&"-"&Right(Temp_Acc,2)
				Grid0.SetCellData( "bd_cell11", i, szAcc )
			else
				Grid0.SetCellData( "bd_cell11", i, Temp_Acc )
			end if
			szName = Form.GetMetaData( "은행코드", szCode)
			Grid0.SetCellData( "bd_cell6", i,  szName )
			Grid0.SetCellData( "bd_cell0", i,  "거래일자" )
			Grid0.SetCellData( "bd_cell1", i,  "입금계좌" )
			Grid0.SetCellData( "bd_cell2", i,  "거래구분" )
			Grid0.SetCellData( "bd_cell3", i,  "이체금액" )
			Grid0.SetCellData( "bd_cell4", i,  "처리결과" )
			Grid0.SetCellFgColor( "bd_cell8", i,  "10" )
		Next
  	
	End If     
End Sub       
       
'============================================================================
Sub Button0_OnClick()
	DATAMANAGER.RequestTranData("obtss_elbs_122r")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName =="CHANGEACC" or  sEventName == "61010_RETURN"  then
		Form_OnFormInit()
	ElseIf sEventName == "AllAccount" then
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		
		g_szAccount = szList(0)
		g_szSubAccount = szList(1)
		'Form.ShowAlert("빠른이체", g_szAccount)
		Form_OnFormInit()
	
	End If
End Sub
'============================================================================
' (구)MTS 이체가능여부 조회
'============================================================================
Function USE_YN_CHK()
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "RMRK"   , 0 , "BANKCLSR" )
	DATAMANAGER.RequestTranData( "obrtp_comn_025r")
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "obrtp_comn_025r" then
	
		if szErrCode == "5841" then 'v008

		    osType = Form.GetSharedData("&OS_TYPE", false)
             appVer = Form.GetSharedData("&APP_VERSION", false )
             appVer = replace(appVer,".","")

		    if osType == "1" then
		        if Cint(appVer) < 226 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
		        end if
			    
		    elseif osType == "2" then
		        if Cint(appVer) < 2521 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
		        end if
		    end if

		end if
	end if	
	
End Sub

