	<SCRIPT_INFO _len="2951" _ulen="2875" >
'--===========================================================================
' 01. 화 면 명 : 지정신청심사
' 02. 화면설명 : 신분증 본인확인 안내
' 03. 작    성 : 
' 04. 수    정 : 
' 2022.04.13 : v0001 : KSJ : 신분증 등록 및 진위확인 개선
'--===========================================================================

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()	
	Dim szScrNo
	szScrNo = Form.GetSharedData("mbonl_SCREEN_NO", false)
	if szScrNo == "94004" then
		imgProcess.imgpath = "bcs_step03"
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "START_CAMERA" then
		Form.runInziCamera()
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgProcess.setMaintainingRatio("1")
	imgID.setMaintainingRatio("1")
	imgNotice.setMaintainingRatio("1")
	imgCheck1.setMaintainingRatio("1")
	imgCheck2.setMaintainingRatio("1")
	
	Image0.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	Image3.setMaintainingRatio("1")
	Image4.setMaintainingRatio("1")
End Sub

'============================================================================
Sub btnCardCert_OnClick()
	if g_BDM_CERT_METHOD == "1" then
		g_BDM_CERT_METHOD = ""
		
		imgBg1.imgpath = "btn_line_red_n.9"
		imgCheck1.imgpath = "checkmenu_n"
		
		imgBg2.imgpath = "btn_line_red_n.9"
		imgCheck2.imgpath = "checkmenu_n"	
		
		Form.triggerEvent("#", "CERT_METHOD", "")
	else
		g_BDM_CERT_METHOD = "1"
		
		imgBg1.imgpath = "btn_line_red_o.9"
		imgCheck1.imgpath = "checkmenu_o"
		
		imgBg2.imgpath = "btn_line_red_n.9"
		imgCheck2.imgpath = "checkmenu_n"
		
		Form.triggerEvent("#", "CERT_METHOD", "1")
	end if 
End Sub

'============================================================================
Sub btnMobileCert_OnClick()
	if g_BDM_CERT_METHOD == "2" then
		g_BDM_CERT_METHOD = ""
		
		imgBg1.imgpath = "btn_line_red_n.9"
		imgCheck1.imgpath = "checkmenu_n"
		
		imgBg2.imgpath = "btn_line_red_n.9"
		imgCheck2.imgpath = "checkmenu_n"	
		
		Form.triggerEvent("#", "CERT_METHOD", "")
	else
		g_BDM_CERT_METHOD = "2"
		
		imgBg1.imgpath = "btn_line_red_n.9"
		imgCheck1.imgpath = "checkmenu_n"
		
		imgBg2.imgpath = "btn_line_red_o.9"
		imgCheck2.imgpath = "checkmenu_o"
		
		Form.triggerEvent("#", "CERT_METHOD", "2")
	end if
End Sub

