		<TABLE name="tblText" insidelinecolor="102:255255255" colcount="1" rowcount="9" outline="0000" designorder="1" ly_vert="30,386,340,126,1" >
			<COL_INFO ly_vert_width="340" />
			<ROW_INFO ly_vert_height="14,14,14,14,14,14,14,14,14" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="  주민등록증 또는 (모바일)운전면허증만 가능합니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="  신분증 촬영시, 원본으로 촬영되어야 하며, 훼손, 구김," fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="  낙서, 이물질 등이 없어야 합니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,5,0,5" halign="0" line="0,0" caption="  흔들리거나, 빛반사 없이 초점을 맞추어 촬영해주세요." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,6,0,6" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,7,0,7" halign="0" line="0,0" caption="  모바일 운전면허증은 '모바일 신분증 앱'에 운전면허증" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,8,0,8" halign="0" line="0,0" caption="  을 등록하신 경우만 사용 가능합니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
