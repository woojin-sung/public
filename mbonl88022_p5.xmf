<ROOT>
	<MAP_INFO scrno="88022" scrname="대차중개약정_약관설명서(개별)" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="20,60,335,489,1" />
		<BUTTON name="ButtonOK" caption="확인" btnimage="btn_26.9.png" ly_vert="187,597,188,50,1" />
		<BUTTON name="ButtonCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_25.9.png" ly_vert="0,597,187,50,1" />
		<LABEL name="lblTitle" fontsize="4" fontstyle="01" halign="1" autofontsize="1" ly_vert="0,0,375,60,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1913" _ulen="1855" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_약관설명서
