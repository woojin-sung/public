	<SCRIPT_INFO _len="4888" _ulen="4442" >
'============================================================================
' 01. 화 면 명 : 선옵 가상체결증거금 조회 가계산 팝업
' 02. 화면설명 : 선옵 가상체결증거금 조회 가계산 팝업 테이블
' 03. 작    성 : 2016.01.12 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'일련번호

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
Function TR_Inquiry(szTranID)
	if szTranID == "obtrf_cntg_703c" then
		
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_703c", "InBlock1", "ACNO" , 0 , g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_703c", "InBlock1", "ASNO" , 0 , g_nAccountSerialNumber)		
		
		
		
		DATAMANAGER.RequestTranData("obtrf_cntg_703c")
	
	end if
	
	if szTranID == "obtrf_cntg_702r" then
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_702r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_702r", "InBlock1", "ASNO" , 0 , g_nAccountSerialNumber)		
		
			
		DATAMANAGER.RequestTranData("obtrf_cntg_702r")
	
	end if

End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("가상체결 증거금 가계산")
	
	Dim szTempCheckBalance
	szTempCheckBalance = Form.GetSharedData("GridImageBalanceNon", false )
	'가상체결금 계산 버튼 클릭 했을 때 넘어오는 값들 처리
	Dim szData
	szData = Form.GetOpenLinkData()
	'(계좌번호 ★ 일련번호) ☆ 가상잔고 갯수 ☆ (가상잔고총데이타("●"))
	Dim szList
	szList = Split(szData, "☆")
	
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	Dim szAccountList
	szAccountList = Split(szList(0), "★")	
	g_nAccountNumber = szAccountList(0)			'계좌번호
	g_nAccountSerialNumber = szAccountList(1)	'일련번호
	
	if szTempCheckBalance == "1" then	'가상잔고데이터가 없을 때 
		TR_Inquiry("obtrf_cntg_702r")	
		
	else	
'		'가상체결금 계산 버튼 클릭 했을 때 넘어오는 값들 처리
'		Dim szData
'		szData = Form.GetOpenLinkData()
'		'(계좌번호 ★ 일련번호) ☆ 가상잔고 갯수 ☆ (가상잔고총데이타("●"))
'		Dim szList
'		szList = Split(szData, "☆")
'		
'		if UBOUND(szList) < 1 then
'			exit sub
'		end if
'		
'		Dim szAccountList
'		szAccountList = Split(szList(0), "★")	
'		g_nAccountNumber = szAccountList(0)			'계좌번호
'		g_nAccountSerialNumber = szAccountList(1)	'일련번호
		
		Dim szImageCount
		szImageCount = szList(1)				'가상잔고 갯수
		
		
		Dim szImageAllData	
		szImageAllData = Split(szList(2), "●") 
			
		
		for i=0 to szImageCount-1
			Dim szImageData
			szImageData = Split(szImageAllData(i), "○")
			
			
			
			Dim szTempIscd, szTempDealCd, szTempQty, szTempPrc
			szTempIscd = Ucase(Trim(szImageData(0)))
			if szImageData(1) == "매도" then
				szTempDealCd = "1"
				
			else
				szTempDealCd = "2"
			end if
			szTempQty = szImageData(2)
			szTempPrc = szImageData(3)
			
			if szTempIscd <> "" and szTempDealCd <> "" and szTempQty <> "" and szTempPrc <> "" then		
				DATAMANAGER.SetDataValue(0, "obtrf_cntg_703c", "InBlock2", "ISCD" , i , szTempIscd)
				DATAMANAGER.SetDataValue(0,  "obtrf_cntg_703c", "InBlock2", "DEAL_CLS_CODE", i , szTempDealCd)
				DATAMANAGER.SetDataValue(0, "obtrf_cntg_703c", "InBlock2", "ODQT", i , szTempQty)
				DATAMANAGER.SetDataValue(0, "obtrf_cntg_703c", "InBlock2", "FTOP_ODER_UNPR" , i , szTempPrc)
				
			else
				Form.MsgBox("알림", "가상잔고 입력데이터를 확인하세요", "", 0)
			end if
			
		next
		
		TR_Inquiry("obtrf_cntg_703c")
		TR_Inquiry("obtrf_cntg_702r")
	
	end if
	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtrf_cntg_702r" then
		Form.MsgBox("알림", szErrMsg, "", 0)
	elseif szTranID == "obtrf_cntg_703c" then
		Form.MsgBox("알림", szErrMsg, "", 0)

	end if
End Sub

	</SCRIPT_INFO>
