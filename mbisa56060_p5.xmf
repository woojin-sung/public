	<SCRIPT_INFO _len="4043" _ulen="3643" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청_가입자유형 안내
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'              : 2020.12.07 김유경 : ISA 조특법 개정안 적용 v0001
'                                  : 일반형, 일반형_청년, 서민형, 서민형_청년 추가, 청년기준변경에 따른 로직 변경
'                                  : 비활성화 해도 선택되는 현상으로 컨트롤 변경 (rdo0 -> rdo1)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szList			'sSendData Split Array


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sSendData
	
	Form.SetScreenName("가입자유형 선택")
	
	sSendData = Form.GetOpenLinkData()
	g_szList = Split(sSendData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	cont0.rdo0.currentindex = g_szList(0)
	
	'만 30세 이상은 청년형 선택 불가 (CDbl(g_szList(1)) >= 30 )
	' -> 만 15세미만, 만 19세이상 선택 불가 v0001
	If CDbl(g_szList(1)) < 15 OR CDbl(g_szList(1)) >= 19 then	
		cont0.rdo0.enableindex	= "1,0"
		cont0.rdo0.enableindex	= "3,0"
		cont0.tblIndex1.SetCellFgColor( 0, 0, "110")	
		cont0.tblIndex3.SetCellFgColor( 0, 0, "110")	
	End If
			
End Sub

'============================================================================
'확인
Sub btnOK_OnClick()
	sIdx = cont0.rdo0.currentindex
	If CDbl(sIdx) < 0 then 
		Form.ShowAlert("알림", "가입자 유형을 선택해주세요.")
		Exit Sub
	End If
	
	Form.SendReturnToParent( "mbisa56060_p5" , sIdx )
	Form.CloseForm( )
End Sub

'============================================================================
' v0001. 로직 불필요. 주석처리
'============================================================================
'Sub cont0_rdo0_OnClick(nIndex)
'	If nIndex == 2 then
'		cont0.tbl0.SetCellString( 19, 2, "연령 : 만 " & CDbl(g_szList(1)) & "세" )
'	Else
'		cont0.tbl0.SetCellString( 19, 2, "" )
'	End If
'End Sub

'============================================================================
Sub cont0_tblIndex0_OnClick(lRow , lColumn)
	cont0.rdo0.currentindex = 0
	'cont0_rdo0_OnClick(0) ' v0001. 로직 불필요. 주석처리
End Sub

'============================================================================
Sub cont0_tblIndex1_OnClick(lRow , lColumn)

	'v0001. 나이제한 추가 (만 15세 이상 ~ 만 19세미만)
	If CDbl(g_szList(1)) >= 15 AND CDbl(g_szList(1)) < 19 then	
		cont0.rdo0.currentindex = 1
     End If
	'cont0_rdo0_OnClick(1) ' v0001. 로직 불필요. 주석처리
End Sub

'============================================================================
Sub cont0_tblIndex2_OnClick(lRow , lColumn)
	cont0.rdo0.currentindex = 2	
	'v0001. 로직 불필요. 주석처리
	'If CDbl(g_szList(1)) < 30 then 
		'cont0.rdo0.currentindex = 2
		'cont0_rdo0_OnClick(2)
	 'End If
End Sub

'============================================================================
Sub cont0_tblIndex3_OnClick(lRow , lColumn)
	'v0001. 나이제한 추가 (만 15세 이상 ~ 만 19세미만)
	If CDbl(g_szList(1)) >= 15 AND CDbl(g_szList(1)) < 19 then	
		cont0.rdo0.currentindex = 3
	End If
End Sub

