	<SCRIPT_INFO _len="8579" _ulen="8144" >
'해외/해외CFD 실시간시세 신청내역 조회

Dim g_szPlainRm
g_szPlainRm = ""			'MTS메모리평문 적용여부

Dim g_szOKType
g_szOKType = "1" '실시간시세신청

Dim g_szCSNo '고객번호
g_szCSNo = ""

Dim g_szUserId '사용자 아이디
g_szUserId = ""

'============================================================================
Sub Form_OnFormInitBefore()
	Container1.imgDate.setMaintainingRatio("1")		
	Container1.ImgFilter.setMaintainingRatio("1")		
	Container1.bgcolor = "246247248"
End Sub

'============================================================================
Sub Form_OnFormInit()
	'화면번호
	g_szScreenNum = Form.GetSharedData( "&SCREEN_NO" , false )	
	'고객번호
	g_szCSNo = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	'사용자ID
	g_szUserId = Form.GetSharedData("&USER_ID", false )
	
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용) - 2020.09.17
	g_szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	'신청내역-기간설정
	'cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
	'cldTo.caption = "99991231"
	cldFrom.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)		
	cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
	'신청기간 표기
	Container1.lbDate.caption = Right(cldFrom.caption, 6) & Right(cldTo.caption, 6)	
	
'msgbox cldFrom.caption .. ";;" .. cldTo.caption
	DATAMANAGER.RequestTranData("obtro_acnt_211r")

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "DATE_SET" then  '신청내역-기간 nrsmbtro16090_p5	
		if sRet <> "" and sRet <> null then	
			cldFrom.caption = Left(sRet, 8)
			cldTo.caption = Right(sRet, 8)
			Container1.lbDate.caption = Right(cldFrom.caption, 6) & Right(cldTo.caption, 6)
			
			DATAMANAGER.RequestTranData("obtro_acnt_211r")  '재조회
			
		end if 		
	elseif sKeyName == "OPTION_SET" then '신청내역-이용구분+시장구분 nrsmbtro16090_p6
		if sRet <> "" and sRet <> null then
			Dim tData
			tData = Split(sRet, "★")

			cmbGubun.cbkeydata = tData(0)
			cmbExch.cbkeydata = tData(1)
			Container1.lblFilter.caption = cmbGubun.caption & " · " & cmbExch.caption 
			
			DATAMANAGER.RequestTranData("obtro_acnt_211r")  '재조회
		end if 
		
	END if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	if szTranID = "obtro_acnt_211r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 			, 0 , g_szCSNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , cmbExch.cbkeydata )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "QTTN_REG_CLCD" 	, 0 , cmbGubun.cbkeydata)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE"         , 0 , cldFrom.caption 	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE"		 , 0 , cldTo.caption 	)
		'조회구분코드 - 1.해외주식가능계좌, 2. 해외CFD 가능계좌
		if g_szScreenNum == "16091" then 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 	0 , "2") '해외CFD
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 	0 , "1") 
		end if	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	if szTranID = "obtro_acnt_211r" then

		Dim nCnt, nRowIdx, szOvrsStckMrktTrClsCode, szQttnApltClcd, szRegPrdClcd,szQttnRegClcd, szApltDate, szAccount',szChanTypeClsCode
		Dim sTemp, sFontColor	
		
		sFontColor = 124  '디폴트(회색)
		
		nCnt = DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" )	
		Pannel0.rowcount = nCnt
		for i = 0 to nCnt - 1 step 1
			'nRowIdx = Container1.grdStatus.rowcount - nCnt + i
			
			szOvrsStckMrktTrClsCode = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i )
			szQttnRegClcd           = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "QTTN_REG_CLCD" , i )			
			szRegPrdClcd            = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "REG_PRD_CLCD" , i )
			szQttnApltClcd          = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "QTTN_APLT_CLCD" , i )
			szApltDate      		 = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "APLT_DATE" , i )
			szAccount       		 = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "ACNO" , i ) & DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "ASNO" , i ) 
			'szChanTypeClsCode       = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "CHAN_TYPE_CLS_CODE" , i )
			'신청일+이용여부
			Select Case szQttnRegClcd
				Case "0"
					Pannel0.SetCellValue( "lblDate1", i, Left(szApltDate, 4) &"-"& MID(szApltDate, 5, 2) &"-"& Right(szApltDate, 2) & " |  이용중")
					'sFontColor = 18
				Case "1"
					Pannel0.SetCellValue( "lblDate1", i, Left(szApltDate, 4) &"-"& MID(szApltDate, 5, 2) &"-"& Right(szApltDate, 2) & " |  해지")	
					'sFontColor = 124
					'sFontColor = 18
			End Select
			
			'국가
			Select Case szOvrsStckMrktTrClsCode
				Case "01"
					Pannel0.SetCellValue("lblName", i, "미국")
				Case "02"
					Pannel0.SetCellValue("lblName", i, "홍콩")
				Case "03"
					Pannel0.SetCellValue("lblName", i, "상해A")
				Case "04"
					Pannel0.SetCellValue("lblName", i, "상해A")
				Case "05"
					Pannel0.SetCellValue("lblName", i, "일본")
			End Select
			
			'이용기간
			sTemp = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "STA_DATE" , i ) '시작일
			szStaDate = Left(sTemp, 4) & "." & Mid(sTemp, 5, 2) & "." & Right(sTemp, 2)
			sTemp = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "FIN_DATE" , i ) '종료일 
			szFinDate = Left(sTemp, 4) & "." & Mid(sTemp, 5, 2) & "." & Right(sTemp, 2)
			Select Case szRegPrdClcd
				Case "1"
					Pannel0.SetCellValue("lblDate2", i, szStaDate &" ~ " & "자동연장")
				Case "2"
					Pannel0.SetCellValue("lblDate2", i, szStaDate &" ~ " & szFinDate)
				Case "3"
					Pannel0.SetCellValue("lblDate2", i, szStaDate &" ~ " & szFinDate)
			End Select
			
			'수수료
			sTemp = CDbl(DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "OVRS_QTTN_EXPN" , i )).. ""
			sTemp = sTemp & " " & DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "CRCD" , i ) 
'if i == 1 then 'for TEST
'	sTemp = "무료"
'end if 
			Pannel0.SetCellValue("lblFee", i, sTemp)
			
			'계좌
			'수수료가 무료이면 account가 보이지 않기
			Pannel0.SetCellValue("lblAccount", i, szAccount)
			if sTemp == "무료" then
				Pannel0.SetCellVisible("lbl2", i, 0) 
				Pannel0.SetCellVisible("lblAccount", i, 0) 
'				Pannel0.SetCellVisible("lblLine1", i, 0) 
'				Pannel0.SetCellVisible("lblLine2", i, 1) 
				Pannel0.SetPropCardCell( "top", "lblLine1", i, 100 )				
				Pannel0.SetCardWHAt( i, 101)				
			else
				Pannel0.SetCellVisible("lbl2", i, 1)
				Pannel0.SetCellVisible("lblAccount", i, 1)
'				Pannel0.SetCellVisible("lblLine1", i, 1)
'				Pannel0.SetCellVisible("lblLine2", i, 0)
				Pannel0.SetPropCardCell( "top", "lblLine1", i, 124 )				
				Pannel0.SetCardWHAt( i, 126)				
			end if 
			
			'글자색설정 이용중??
		next		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)	
	Form.ShowAlert( "알림", szErrMsg.."\n("..szSubErr..")" )	
End Sub

'============================================================================
Sub Container1_imgDate_OnClick()
	Container1_lbDate_OnClick()
End Sub

'============================================================================
Sub Container1_lbDate_OnClick()
	Form.OpenPopupAnimation("nrsmbtro16090_p5", cldFrom.caption&cldTo.caption,  "",  2)	
End Sub

'============================================================================
Sub Container1_ImgFilter_OnClick()
	Container1_lblFilter_OnClick()
End Sub

'============================================================================
Sub Container1_lblFilter_OnClick()
	Form.OpenPopupAnimation("nrsmbtro16090_p6",  cmbGubun.cbkeydata & "★"&cmbExch.cbkeydata,  "",  2)	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName		= "INFO_REFRESH" then
		DATAMANAGER.RequestTranData("obtro_acnt_211r")
	end if
End Sub

