g_OtpNextFlag = False

'============================================================================
Function funcAcnoList()
	DATAMANAGER.RequestTranData( "obaci_acct_185r" )
End Function

'============================================================================
Function funcCtrSetting()

	cntnInput.CmbAcnt.SetApplyLabel("종합계좌번호", 0, 268, "left", true, 80)
	cntnInput.CmbAcnt.cbtype = 5
	
	cntnInput.EdtPwd.SetApplyLabel("종합계좌 비밀번호", 0, 268, "left", true)
	cntnInput.EdtPwd.SetUseResultLabel(TRUE, 2)
	
	cntnInput.EdtOtpPwd.SetApplyLabel("모바일 OTP 비밀번호", 0, 268, "left", true)
	cntnInput.EdtOtpPwd.SetUseResultLabel(TRUE, 2)
	cntnInput.EdtOtpPwdCnfr.SetApplyLabel("모바일 OTP 비밀번호 확인", 0, 268, "left", true)
	cntnInput.EdtOtpPwdCnfr.SetUseResultLabel(TRUE, 2)
	fncOtpPwdInit(False)
	
	'안내사항 초기화
	cntnInput.imgGudeO.imgpath		= "icon_caret_down.png"
	cntnInput.lblGudeBg.bgcolor	= 271
	
	cntnInput.cntnGude.setHeightResize(0)
	For ix = 0 To 6
		For jx = 0 To 3
			cntnInput.cntnGude.Table0.SetCellBgColor(ix, jx, 272)
		Next
	Next

End Function

'============================================================================
Function funcTermInfo()
	g_CustTermID	=	Form.GetDeviceID()
	g_OSClcd		=	Form.GetSharedData("&OS_TYPE", false)
	g_OSVrsn		=	Form.GetSharedData("&OS_VERSION", false)
	g_CustTermName	=	Form.GetDeviceModel()
'	If g_OSClcd == "1" Then '안드로이드
'		Form.requestMOTP("MOTP_GET_VERSION"	, "" , "86101")
'		Form.requestMOTP("MOTP_GETINFO"		, "" , "86101")
'	End If
End Function

'============================================================================
Function funcBtnApltSet()
'Form.ShowAlert(g_EdtPwdYn, g_EdtOtpPwdYn)
	If g_EdtPwdYn == "Y" AND g_EdtOtpPwdYn == "Y" Then
'		If CInt(cntnInput.EdtPwd.pwdlen) < 4 Then
		bit = True
	Else
		bit = False
	End If

	BtnAplt.enable		= bit
	
	If bit == True Then
		BtnAplt.enable = True
		BtnAplt.btnimage	= "btn_20.9"
		BtnAplt.fgcolor		= 0
	Else
		'등록버튼 초기화
		
		If g_Theme == "white" Then
			BtnAplt.btnimage	= "btn_21.9"
		Else
			BtnAplt.btnimage	= "btn_27.9"
		End If
		BtnAplt.fgcolor		= 269
	End If

End Function

'============================================================================
Function fncOtpPwdInit(bClcd)
	cntnInput.EdtOtpPwd.caption = ""
	cntnInput.EdtOtpPwdCnfr.caption = ""
	cntnInput.EdtOtpPwd.enable = bClcd
	cntnInput.EdtOtpPwdCnfr.enable = bClcd

	funcBtnApltSet()
End Function

'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 
	Dim tmpList
'Form.ShowAlert( "debug", "EventName [" & sEventName & "], Param [" & sParam & "]" )
	If sEventName == "MOTP_GET_VERSION_RETURN_86101" Then ' M SafeBox 버전 정보 가져오기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
	End If
'Form.ShowAlert( "debug", g_MsboVrsn )
	If sEventName == "MOTP_ISSUE_RETURN_86101" Then 'M SafeBox에 MOTP정보 심기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			'Form.ShowAlert("jsi g_Csno", g_Csno)
			'Form.ShowAlert("jsi g_NewMotpSrno", g_NewMotpSrno)
			Form.regiPUSH(g_Csno) '비로그인 고객 대상 PUSH 서비스 등록
			Form.SetSharedData("BDM_OTP_SUPL_CO_CODE", "ATN")
			rslt_data = "86101" & "☆" & "모바일OTP 발급" & "☆" & "Y" & "☆" & g_ProsClcd & "☆" & "모바일OTP(메리츠)" & "☆" & g_NewMotpSrno
			
			'20230803 SWJ START : 쉐어드 변수 초기화 후, 다음 스텝으로 갈 때 변수 재설정 해준다
			if g_l_ms <> "" then
				Form.SetSharedData("MeritzAuth_Security", g_l_ms)
			end if
			
			if g_sSecurity == "Y" then
				Form.SetSharedData( "CommonNoSecurity", "Y")
			end if
			'20230803 SWJ END
			
			Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
		Else
			Form.ShowAlert("오류", "모바일 OTP 발급 오류\n"..tmpList[1])
			rslt_data = "86101" & "☆" & "모바일OTP 발급" & "☆" & "N" & "☆" & g_ProsClcd & "☆" & "오류" & "☆" & tmpList[1]
			Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
		End If
	End If

	If sEventName == "MOTP_GETINFO_RETURN_86101" Then
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MotpSrno = right(tmpList[2], 12)
		End If
	End If
End Sub

'OTP등록/해지시 전문수신조회 타이머
'============================================================================
Sub Form_OnTimerEvent(sTimerID) 'v0001

	if sTimerID == 1 OR sTimerID == "1" then
		Form.SetTimerEvent( 1, 0, 1 ) 'int nID, int bSet(1:ok,0:Cancel), int nSec
		DATAMANAGER.RequestTranData("obcsb_oimf_141a_1")
	End if

	If sTimerID == 2 Or sTimerID == "2" Then
		'Form.ShowAlert("jsi", "타이머 들어오나??")
		Form.SetTimerEvent( 2, 0, 1) 
		Form.clearWaitCursor()
		DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")	
	End If
	
	if sTimerID == 9999 OR sTimerID == "9999" then
		Form.SetTimerEvent2(9999, 0, 0.3)
		cntnInput.scroll_pos = 0
		cntnInput.SetScrollAutoSize()
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	
'	단말정보 취합
	funcTermInfo()
	
	g_IntoClcd	= Form.GetSharedData( "mOTP_IntoClcd", False )
	szAcno	= Form.GetSharedData( "BDM_NMET_ACNO", False )
	szData 	= Form.GetOpenLinkData()
	g_Theme 	= Form.GetEnvData("common.theme")
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		cntnInput.setScrollBarVisible("2")
	end if	

'test code
'If Len(szData) == 0 Then
''	g_IntoClcd	= "MTS"
'	g_IntoClcd = "NMET_ACNT"
'	g_IntoClcd = "NMET_BSWR"
'	szAcno	= "30003130"
'	szData 	= "R☆N☆☆☆☆3000065693☆"
'End If
	
	'Form.ShowAlert("86101", szData)
'Form.ShowAlert("86101", "szData = [" & szData & "]" & chr(10) & chr(13) & "g_IntoClcd = [" & g_IntoClcd & "]" & chr(10) & chr(13) & "szAcno = [" & szAcno & "]"  )

	g_szList = Split(szData, "☆")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if

'Form.ShowAlert("szData", szData & "][" & g_szList(0))

	g_ProsClcd = g_szList(0)
	If g_ProsClcd == "P" Then
		Label0.caption = "모바일 OTP 비밀번호 재설정"
		cntnInput.Label2.caption = "모바일 OTP 비밀번호 재설정"
		BtnAplt.caption = "재설정"
	ElseIf g_ProsClcd == "R" Then
	
		Label0.caption = "모바일 OTP 발급"
		cntnInput.Label2.caption = "모바일 OTP 비밀번호 설정"
		BtnAplt.caption = "발급"
		'v0002
		if UBOUND(g_szList) > 1 then
			'Form.ShowAlert("들어오나?" ,"ㅇㅇㅇ")
			g_DscdYn		= g_szList(1)
			g_OtpSrno		= g_szList(2)
			g_OtpSuplCoCode = g_szList(3)
			g_IsncIstuCode	= g_szList(4)
			g_Csno		= g_szList(5)
			If g_szList(6) <> null Then
				g_MOtpSrnoSvr	= g_szList(6)
			Else 
				g_MOtpSrnoSvr	=  " "
			End If
		else
			g_DscdYn		  = ""
			g_OtpSrno	  = ""
			g_OtpSuplCoCode = ""
			g_IsncIstuCode  = ""
			g_Csno		  = ""
			g_MOtpSrnoSvr   =  " "
			g_reInqFlag     = True
		End if
		
	End If
	
'	컨트롤 설정
	funcCtrSetting()

'	Form.MsgBox("debug", Form.GetSharedData( "&LOGIN_TYPE", false ), "debug", 0)

	If g_IntoClcd == "NMET_ACNT" Then
		'계좌번호 설정
		szFrAcno = Left (szAcno, 4)
		szRrAcno = Right(szAcno, 4)
		cntnInput.CmbAcnt.cbadddatatext = szFrAcno & "-" & szRrAcno
		cntnInput.CmbAcnt.caption = szFrAcno & "-" & szRrAcno
		cntnInput.CmbAcnt.fgcolor = 267
		cntnInput.CmbAcnt.enable = False
'
		g_tempAcc	= szFrAcno & szRrAcno
		g_RcnoPip	= Form.GetSharedData("BDM_RCNO_PIP", false ) '암호화로 내려옴.
		'v0003 계좌 콤보 선택 이후 처리로 수정
		DATAMANAGER.RequestTranData("obacp_comm_004r") '연락처 정보 GET
	Else
		If Len(Form.GetSharedData( "BDM_RCNO_PIP", FALSE )) > 0 Then
			g_RcnoPip	= Form.GetSharedData( "BDM_RCNO_PIP", FALSE )
		Else
			g_RcnoPip	= Form.GetSharedData("&JUMIN_NUM", false )
		End If

		cntnInput.CmbAcnt.caption = "종합계좌번호를 선택해주세요"
'		계좌리스트 조회
		funcAcnoList()
	End If

End Sub

'============================================================================
Sub Form_OnFormInitAfter()
'	If g_OSClcd <> "1" Then '아이폰
'		Form.requestMOTP("MOTP_GET_VERSION"	, "" , "86101")
'		Form.requestMOTP("MOTP_GETINFO"		, "" , "86101")
'	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	g_tempAcc = cntnInput.CmbAcnt.caption
	
	If szTranID == "obaci_acct_185r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		, 0, "NMET"	) '비대면유선업무 처리를 위한 플래그
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"	, 0, g_RcnoPip	)
	End If

	If szTranID == "obacp_opop_066r" Then '계좌비밀번호 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_tempAcc )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "ACNT_PWD", 0, cntnInput.EdtPwd.caption )
	End If
	
	If szTranID == "obacp_comm_004r" Then '고객연락처 조회
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_tempAcc )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , Form.GetSharedData("&USER_ID", false ))
	End If
	
	If szTranID == "obacp_comm_058r" Then 'OTP비밀번호 유효성 검사
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "7" 		 )	'[MTS] 계좌비밀번호 변경시 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , g_tempAcc )  '계좌번호
		If g_IntoClcd == "MTS" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , Form.GetSharedData("&USER_ID", false ))  'ID
		End If
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , cntnInput.EdtOtpPwd.caption2 )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , cntnInput.EdtOtpPwdCnfr.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""			)  '실명확인번호(서비스에서 조회)		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
	End If
	
	If szTranID == "obcsb_oimf_170a" Then 'OTP등록 처리'
'Form.ShowAlert( "debug", g_MsboVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"    	, 0, "I" )  '발급
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    			, 0, g_tempAcc )  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "ACNT_PWD"			, 0, cntnInput.EdtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MSBO_VRSN"			, 0, g_MsboVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "OS_CLCD"			, 0, g_OSClcd )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "OS_VRSN"			, 0, g_OSVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_NAME"		, 0, g_CustTermName )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_ID"		, 0, g_CustTermID )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_ATHN_DATA_CNTT"	, 0, cntnInput.EdtOtpPwdCnfr.caption )
		'v0001 START
		g_l_ms = Form.GetSharedData("MeritzAuth_Security", true)				'20230803 SWJ START(true로 바꿈) (변수는 글로벌로 바꿈)
		If Len(Trim(g_MOtpSrnoSvr)) > 1 and g_l_ms <> "MOTP" and g_l_ms <> "OTP" Then
			DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_SRNO"			, 0, g_MOtpSrnoSvr )
		End If
		'v0001 END
	End If
	
	If szTranID == "obcsb_oimf_173a" Then 'OTP 비밀번호 초기화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"    	, 0, "I" )  '초기화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    			, 0, g_tempAcc )  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "ACNT_PWD"			, 0, cntnInput.EdtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MSBO_VRSN"			, 0, g_MsboVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_SRNO"			, 0, g_MotpSrno )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_ID"		, 0, g_CustTermID )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_ATHN_DATA_CNTT"	, 0, cntnInput.EdtOtpPwdCnfr.caption )
	End If
	
	If szTranID == "obcsb_oimf_141a" Or szTranID == "obcsb_oimf_141a_1" Then '기등록 OTP 이용해지
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "APRV_YN" 			, 0 , g_AprvYn 				)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 			, 0 , g_tempAcc				)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" 			, 0 , cntnInput.EdtPwd.caption	)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OTP_CARD_SRNO" 		, 0 , g_OtpSrno				)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OTP_SUPL_CO_CODE" 	, 0 , g_OtpSuplCoCode		)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OTP_ISNC_ISTU_CODE" 	, 0 , g_IsncIstuCode			)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OTP_TLMS_SRNO"		, 0 , g_TlmsSrno			)
	End If
	'v0003
	If	szTranID == "obcsb_oimf_172r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPip )
	End If
	
	If	szTranID == "obcsb_oimf_160r" Then
		'v0003
		if g_OtpNextFlag = False then
			g_nNextCount = 0
			edtSTTNNO.caption = "001"
			edtSTNDDATE.caption = ""
			edtotp.caption = ""		
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APRV_YN" , 0 , "N")
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPip )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RQST_STA_STTN_NO", 0, edtSTTNNO.caption )
		end if
	End If
	
	If	szTranID == "obcsb_oimf_160r_1" Then		
	
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APRV_YN" , 0 , "Y")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPip )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RQST_STA_STTN_NO", 0, edtSTTNNO.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_TLMS_SRNO", 0, edtotp.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TLMS_PROS_DATE", 0, edtSTNDDATE.caption )
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obaci_acct_185r" Then
		if DATAMANAGER.IsMoreNextData( sTranID ) == True Then
			DATAMANAGER.RequestNextData( sTranID )
		Else
'			Form.SetCtlProp("cntnInput.CmbAcnt", "cbadddatatext", "종합계좌를 선택해 주세요." ) 
			For i = 0 To Grid0.rowcount -1
				szFrAcno = Left	(Grid0.GetCellData( "bd_cell0", i ), 4)
				szRrAcno = Right(Grid0.GetCellData( "bd_cell0", i ), 4)
				cntnInput.CmbAcnt.cbadddatatext = szFrAcno & "-" & szRrAcno
'				Form.SetCtlProp("cntnInput.CmbAcnt", "cbadddatatext", szFrAcno & "-" & szRrAcno )
			Next
			cntnInput.CmbAcnt.Setstatus("focus")
			cntnInput.CmbAcnt.caption = "종합계좌를 선택해주세요"
			cntnInput.CmbAcnt.fgcolor = 270
			DATAMANAGER.RequestTranData("obacp_comm_004r") '연락처 정보 GET
		End If
	End If
	
	If szTranID == "obacp_opop_066r" Then
'		cntnInput.EdtPwd.SetResultLabel("1", "complete", "비밀번호 일치 여부 체크 정상입니다.", "cntnInput")
		g_EdtPwdYn = "Y"
		fncOtpPwdInit(True)

		cntnInput.EdtOtpPwd.SetShowKeypad(true)
		Form.requestMOTP("MOTP_GET_VERSION"	, "" , "86101")
		Form.requestMOTP("MOTP_GETINFO"		, "" , "86101")
	End If
	
	If szTranID == "obacp_comm_004r" Then '고객연락처설정
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
		If g_IntoClcd == "NMET_ACNT" Then
			cntnInput.EdtPwd.SetShowKeypad(true)
		End If
		
		'v0003
		if g_reInqFlag = True Then
			DATAMANAGER.RequestTranData("obcsb_oimf_172r") '앞서 정보세팅이 안됐다면 존재하는지 확인 - OTP 정보 GET
		end if
	End If
	
	If szTranID == "obcsb_oimf_170a" Then
		g_NewOtpKey1	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MOTP_NO_1_KEY"	, 0)  '모바일OTP번호1키
		g_NewOtpKey2	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MOTP_NO_2_KEY"	, 0)  '모바일OTP번호2키
		g_NewMotpSrno	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MSBO_MOTP_SRNO"	, 0)  'MOBILESAFEBOX모바일OTP일련번호
		'Form.ShowAlert("jsi 170a g_NewMotpSrno", g_NewMotpSrno)
		szData = g_NewMotpSrno & "★" & g_NewOtpKey1 & "★" & g_NewOtpKey2
		Form.requestMOTP("MOTP_ISSUE" , szData , "86101")
	End If
	
	If szTranID == "obcsb_oimf_173a" Then
		rslt_data = "86101" & "☆" & "모바일OTP 비밀번호 재설정" & "☆" & "Y" & "☆" & g_ProsClcd & "☆" & "NULL" & "☆" & "NULL"
		Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
	End If

	If szTranID == "obcsb_oimf_141a" then
		g_AprvYn = "Y"
		If DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "OTP_RSPN_CODE", 0) == "" Then
			g_TlmsSrno	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_TLMS_SRNO"	, 0)
			Form.SetTimerEvent(1, 1, 1)
		end if
	End If
	
	If szTranID == "obcsb_oimf_141a_1" then
		temp = Form.GetMetaData( "OTP응답코드" , DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_RSPN_CODE" , 0))
		Form.SetTimerEvent(1, 0, 1)
		'v0004 정상처리된 경우에만 해지완료표시 및 재조회/정상처리 아닌경우 처리불가 팝업메시지
		rspnCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		If rspnCode == "0000" or rspnCode == "3999" then
'			Form.MsgBox( "알림", "OTP해지가 완료되었습니다.", 0, 6)
			DATAMANAGER.RequestTranData("obcsb_oimf_170a") '모바일 OTP 발급
		Else
			If rspnCode <> "3021" then  '3021.수신전문 조회 중 입니다.
				Form.ShowAlert( "알림" , "처리에 실패하였습니다.("..temp..")")
			End If
		End If
	End If
	
	If szTranID == "obacp_comm_058r" Then
		g_EdtOtpPwdYn = "Y"
		funcBtnApltSet()
	End If
	'v0003
	If szTranID == "obcsb_oimf_172r" Then
		AblePrhbYn		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "ABLE_PRHB_YN"		, 0 )
		PrhbReas			= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "UI_PRHB_REAS"		, 0 )
		g_Csno			= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "CSNO"			, 0 )
		
		g_MOtpSrnoSvr		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MOTP_SRNO"		, 0 )
		'g_CustTermIDSrvr  = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_TERM_ID"		, 0 )
		'g_MOtpMstkCsnu	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MOTP_ATHN_MSTK_CSNU", 0 )
		
		g_OtpSrno		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_CARD_SRNO"	, 0 )
		g_OtpStatCode		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_STAT_CODE"	, 0 )
		g_OtpSuplCoCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_SUPL_CO_CODE"	, 0 )
		g_IsncIstuCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_ISNC_ISTU_CODE"	, 0 )
		
		'실물OTP 폐기여부
		If Len(Trim(g_OtpSrno)) > 0 And (g_OtpStatCode == "01" OR g_OtpStatCode == "02") Then
			g_DscdYN = "N"
			DATAMANAGER.RequestTranData("obcsb_oimf_160r")
		Else
			g_DscdYN = "N"
		End If
	End If
	
	'v0003
	If szTranID == "obcsb_oimf_160r" Then
	
		g_szSTTN_NO 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "RQST_STA_STTN_NO" , 0)		'요청시작번호
		g_szSRNO 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_TLMS_SRNO" , 0)		'전문일련번호
		g_szSTND_DATE	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "TLMS_PROS_DATE" , 0)		'기준일자
		
		if Len(trim(g_szSRNO)) > 7 then			'전문일련번호
			edtotp.caption = g_szSRNO
		end if
		if Len(trim(g_szSTTN_NO)) == 3 then		'시작요청위치
			edtSTTNNO.caption = g_szSTTN_NO
		end if
		if Len(trim(g_szSTND_DATE)) == 8 then	'기준일자
			edtSTNDDATE.caption = g_szSTND_DATE
		end if	
		
		'if edtSTTNNO.caption == "001" then
			'Form.ShowAlert("jsi", "들어오나??")
		'	Form.SetTimerEvent( 2, 1, 1) 'V0004 타이머 1초 설정
		'	Form.addWaitCursor()
		'end if
		Form.SetTimerEvent( 2, 1, 1) 'V0004 타이머 1초 설정
		Form.addWaitCursor()
	End If
	
	If	szTranID == "obcsb_oimf_160r_1" Then
		g_nGrdCount = DATAMANAGER.GetDataCount( 0 , "obcsb_oimf_160r_1", "OutBlock1")
		for i = 0 to g_nGrdCount - 1
			g_nNextCount = g_nNextCount + 1
			
			if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UTLZ_REG_YN" , i) == "Y" and DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "OTP_RSPN_CODE" , 0) == "0000" then
			
				if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_CARD_SRNO" , i) == g_OtpSrno then				
					g_DscdYN = "Y"	'OTP폐기대상..
					
					g_OtpStatCode		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_STAT_CLS_CODE" , i)
					g_OtpSuplCoCode	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_SUPL_CO_CODE" , i)
					g_IsncIstuCode	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_ISNC_ISTU_CODE" , i)
					'v004 등록 건이 1건 초과하여 있을 수 없음
					exit sub
				end if
			end if
		Next		
		'등록 건으로 exit가 안되는 경우 nextkey 존재하면 다음조회 처리
		if DATAMANAGER.IsMoreNextData("obcsb_oimf_160r_1") == True then
			'v0003
			g_OtpNextFlag = True
			edtSTTNNO.caption = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "RQST_STA_STTN_NO", 0 )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "RQST_STA_STTN_NO"	, 0 , edtSTTNNO.caption )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "RCNO_PIP"		, 0 , g_RcnoPip )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "APRV_YN"		, 0 , "N" )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "CONT_CLS_CODE"	, 0 , "1" )
			DATAMANAGER.RequestTranData("obcsb_oimf_160r")
		end if
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID == "obacp_opop_066r" Then '계좌비밀번호
'		cntnInput.EdtPwd.SetResultLabel("1", "error", szErrMsg&"\n["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "cntnInput" )
		Form.OpenPopup("mbbdm85203.xmf", szErrMsg & "★(" & DATAMANAGER.GetDataMsgSubText(szTranID) & ")" )
		g_EdtPwdYn 	= "N"
		fncOtpPwdInit(False)
	End If
	
	If szTranID == "obacp_comm_058r" Then 'OTP비밀번호 유효성
		cntnInput.EdtOtpPwdCnfr.SetResultLabel("1", "error", szErrMsg&"("&DATAMANAGER.GetDataMsgSubText(szTranID)&")", "cntnInput" )
		g_EdtOtpPwdYn 	= "N"
		'등록버튼 초기화
		'funcBtnApltSet(False)
		fncOtpPwdInit(False)
		'funcBtnApltSet()
	End If
	
	If szTranID == "obcsb_oimf_170a" Then 'OTP 발급
		rslt_data = "86101" & "☆" & "모바일OTP 발급" & "☆" & "N" & "☆" & g_ProsClcd & "☆" & szErrMsg & "☆" & DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
	End If
	If szTranID == "obcsb_oimf_173a" Then 'OTP 비밀번호
		rslt_data = "86101" & "☆" & "모바일OTP 비밀번호 재설정" & "☆" & "N" & "☆" & g_ProsClcd & "☆" & szErrMsg & "☆" & DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
	End If
	If szTranID == "obcsb_oimf_141a_1" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_141a_1" )
		If szErrCode <> "3021" Then
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Else
			Form.SetTimerEvent(1, 1, 1)
		End If
	End If
End Sub

'============================================================================
Sub cntnInput_EdtPwd_OnEditComplete()
	If CInt(cntnInput.EdtPwd.pwdlen) < 4 Or CInt(cntnInput.EdtPwd.pwdlen) > 8  Then
		g_EdtPwdYn 	= "N"
		funcBtnApltSet()
		Exit Sub
	End If
	DATAMANAGER.RequestTranData("obacp_opop_066r") '계좌비밀번호 검증
End Sub

'============================================================================
Sub cntnInput_EdtOtpPwd_OnEditComplete()
	g_EdtOtpPwdYn 	= "N"
	funcBtnApltSet()
	cntnInput.EdtOtpPwdCnfr.SetShowKeypad(true)
End Sub

'============================================================================
Sub cntnInput_EdtOtpPwdCnfr_OnClick()
	If g_OSClcd <> "1" Then '아이폰은 에디트 위치를 자동으로 올려주지 않음.
		cntnInput.L1.top = 567 + 90
		cntnInput.SetScrollAutoSize()
		cntnInput.scroll_pos = 90
	End If
	g_EdtOtpPwdYn 	= "N"
	funcBtnApltSet()
End Sub

'============================================================================
Sub cntnInput_EdtOtpPwdCnfr_OnEditComplete()
	If g_OSClcd <> "1" Then
		cntnInput.L1.top = 567
		cntnInput.SetScrollAutoSize()
		cntnInput.scroll_pos = 0
	End If
	g_EdtOtpPwdYn 	= "N"
	funcBtnApltSet()
	DATAMANAGER.RequestTranData("obacp_comm_058r") 'OTP 비밀번호 유효성 검증
End Sub

'============================================================================
Sub BtnAplt_OnClick()
	If g_ProsClcd == "R" Then
		If	g_DscdYn == "Y" Then
			g_AprvYn = "N"
			DATAMANAGER.RequestTranData("obcsb_oimf_141a") '실물OTP 해지
		Else
			DATAMANAGER.RequestTranData("obcsb_oimf_170a") '모바일 OTP 발급
		End If
	ElseIf	g_ProsClcd == "P" Then
		DATAMANAGER.RequestTranData("obcsb_oimf_173a") '모바일 OTP 비밀번호 초기화
	End If
End Sub

'============================================================================
Sub cntnInput_btnGude_OnClick()

	If g_Flag == 0 Then
		cntnInput.L1.top = 567 + 100
		cntnInput.SetScrollAutoSize()
		cntnInput.cntnGude.setHeightResize(200)
'		cntnInput.vscroll = True
		cntnInput.scroll_pos = 100
		cntnInput.imgGudeO.imgpath = "icon_caret_up.png"

		g_Flag = 1
	Else
		cntnInput.cntnGude.setHeightResize(0)
		cntnInput.L1.top = 567
'		cntnInput.vscroll = False
		cntnInput.scroll_pos = 0
		cntnInput.SetScrollAutoSize()
		Form.SetTimerEvent2(9999, 1, 0.3)
		cntnInput.imgGudeO.imgpath = "icon_caret_down.png"
		
		g_Flag = 0
	End If	
End Sub

'============================================================================
Sub cntnInput_EdtOtpPwdCnfr_OnEditChar(CharCode)
	cntnInput.EdtOtpPwdCnfr.SetResultLabel("0", "complete", "", "cntnInput")
End Sub

'============================================================================
Sub Image0_OnClick()

	'Form.CloseForm()
	
	If g_IntoClcd == "MTS" Then
		Form.OpenScreen("87003" , "")
		Form.CloseForm()
	ElseIf g_IntoClcd == "NMET_ACNT" Then
		Form.OpenNextPopup( "mbotp86100.xmf", "", "" )
	Else
		Form.OpenScreen("41000" , "")
		Form.CloseForm()
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'Form.ShowAlert("RETURN_1", sKeyName)
'Form.ShowAlert("RETURN_2", sRet)
	If sKeyName == "rslt_ret" Then
		If sRet == "OK" Then
			Form.CloseForm()
		End If
	End If
End Sub

'============================================================================
Sub cntnInput_Label2_OnClick()
'	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	If g_PrntClosYN == "N" Then
		Form.SendReturnToParent( "mbotpmpop" , "cncl" )
	Else
		Form.SendReturnToParent( "mbotpmpop" , "ok" )
	End If
End Sub


'============================================================================
Sub cntnInput_CmbAcnt_OnEditComplete(iIndex)
	szFrAcno = Left	(cntnInput.CmbAcnt.caption, 4)
	szRrAcno = Right(cntnInput.CmbAcnt.caption, 4)
	Form.SetSharedData( "BDM_NMET_ACNO", szFrAcno & szRrAcno )
	g_tempAcc = szFrAcno & szRrAcno
	
	cntnInput.EdtPwd.SetShowKeypad(true)
	
	DATAMANAGER.RequestTranData("obacp_comm_004r") '연락처 정보 GET
End Sub


