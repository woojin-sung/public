	<SCRIPT_INFO _len="9583" _ulen="9297" >
'============================================================================
' 01. 화 면 명 : 시황브리핑_국내시황
' 02. 화면설명 : 시황브리핑_국내시황
' 03. 작    성 : 2016. 01. 12. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nMaketIndex
Dim g_tKR	'국내지수 선택
Dim g_tKRCode		'시장 코드
Dim g_szOptionCode	'선옵코드

g_tKR = {"코스피","코스닥","선물최근월"}
g_tKRCode = {"KGG01P","QGG01P"}			'22년 차세대 업종코드 하드코딩
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Function TableClear() : Table Clear
'============================================================================
Function TableClear()

	tbl0.SetCellString( 0, 0, "")
	tbl0.SetCellString( 0, 1, "")
	tbl0.SetCellString( 0, 2, "")
	tbl0.SetCellString( 0, 3, "")
	tbl0.SetCellString( 0, 4, "")
	tbl0.SetCellString( 1, 0, "")
	tbl0.SetCellString( 1, 1, "")
	tbl0.SetCellString( 1, 2, "")
	tbl0.SetCellString( 1, 3, "")
	tbl0.SetCellString( 1, 4, "")
	tbl0.SetCellString( 2, 0, "")
	tbl0.SetCellString( 2, 1, "")
	tbl0.SetCellString( 2, 2, "")
	tbl0.SetCellString( 2, 3, "")
	tbl0.SetCellString( 2, 4, "")
	
End Function
'============================================================================
' SetBC(szCode) : 국내지수 실시간 TR 연결 세팅
'============================================================================
Function SetBC(szCode)
	
	Select Case szCode
		Case g_tKRCode(0)
			'증감부호값으로 현재가 전일 대비 증감색 표시
			if DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
				tbl0.SetCellString( 0 , 1, -DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			else
				tbl0.SetCellString( 0 , 1, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			end if
			tbl0.SetCellString( 0 , 2, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
			tbl0.SetCellString( 0 , 3, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
		Case g_tKRCode(1)
			if DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
				tbl0.SetCellString( 1 , 1, -DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			else
				tbl0.SetCellString( 1 , 1, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			end if
			tbl0.SetCellString( 1 , 2, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
			tbl0.SetCellString( 1 , 3, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
'		Case g_tKRCode(2)
'			if DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
'				tbl0.SetCellString( 2 , 1, -DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
'			else
'				tbl0.SetCellString( 2 , 1, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
'			end if
'			tbl0.SetCellString( 2 , 2, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
'			tbl0.SetCellString( 2 , 3, DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
	End Select
	
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit() : 초기화면 세팅
'============================================================================
Sub Form_OnFormInit()

	g_nMaketIndex = 0

	TableClear()
	
	for i = 0 to 1
		tbl0.SetCellString( i , 0 , g_tKR(i) )
		
		DATAMANAGER.SetDataValue( 0 , "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "U" )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tKRCode(i) )
		
	next
	tbl0.SetCellString( 2 , 0 , g_tKR(2) )
	
	
	DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "KS" )
	DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
	
	DATAMANAGER.RequestTranData( "ohhts_0510_001r")
	DATAMANAGER.RequestTranData( "ohhts_1500_006r" )
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
	
End Sub
'============================================================================
' rdo0_OnClick(nIndex) : 라디오 선택에 따른 시황 표기
'============================================================================
Sub rdo0_OnClick(nIndex)
	web0.urlpath = "about:blank"
	g_nMaketIndex = nIndex
	
	if g_nMaketIndex == 0 then
		DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "KS" )
		DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
	else		'선물시장에서는 상관관계, 특징주 버튼 비활성화
		DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "KF" )
		DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1" )
		
		btn0.enable = False
		btn1.enable = False
	end if
	
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_0510_001r" then
		g_szOptionCode = DATAMANAGER.GetDataValue( 0 , "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD" , 0)
		
		DATAMANAGER.SetDataValue( 0 , "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 2 , "F" )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" , 2 , g_szOptionCode )
			
		DATAMANAGER.RequestTranData( "ohhts_1500_001r" )
		
	elseif szTranID == "ohhts_1500_001r" then
		for i = 0 to 2
			if DATAMANAGER.GetDataValue( 0 , "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i) == "5" then
				tbl0.SetCellString( i , 1 , -DATAMANAGER.GetDataValue( 0 , "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
			else
				tbl0.SetCellString( i , 1 , DATAMANAGER.GetDataValue( 0 , "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
			end if
			tbl0.SetCellString( i , 2 , DATAMANAGER.GetDataValue( 0 , "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i))
			tbl0.SetCellString( i , 3 , DATAMANAGER.GetDataValue( 0 , "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , i))
		next
		
		l = 0
		for j = 0 to 1
			for k = 0 to 3
				DATAMANAGER.SetDataValue( 1 , "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE" , l , g_tKRCode(j) )
				l = l + 1
			next
		next
	elseif szTranID == "ohhts_1500_006r" then
		for i = 0 to 2
			tbl0.SetCellString( i , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "ohhts_1500_006r", "OutBlock1", "FID_DATE" , 0) , 4) )
		next
	end if

	if szTranID == "ohhts_news_008r" then
		Dim szText
		Dim szTemp
		
		szText = ""
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_news_008r", "OutBlock1") - 1
			szTemp = DATAMANAGER.GetDataValue( 0, "ohhts_news_008r", "OutBlock1", "FID_NEWS_CNTT" , i)
			szText = szText & szTemp
		next
			web0.loaddata = "<html><body>"&szText&"</body></html>"
	end if
	
	DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szDiv
	
	if szTranID == "ohhts_nmix_cntg" then
		
		szDiv = DATAMANAGER.GetDataValue( 1 , "ohhts_nmix_cntg", "OutBlock1", "FIDR_BSTP_CLS_CODE" , 0)
		
		Call SetBC(szDiv)
		
	end if
	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	Dim szData
	
		szData = "KS" & "☆" & "2" & "☆" &"주식"
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
	
End Sub
'============================================================================
' btn1_OnClick()
'============================================================================
Sub btn1_OnClick()
	Dim szData
	
		szData = "KS" & "☆" & "3" & "☆" &"주식"
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
	if szTranID == "ohhts_nmix_cntg" then
		DATAMANAGER.GetDataValue( 1 , "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", g_szOptionCode)
	end if
	
End Sub


'============================================================================
Sub Form_OnRefresh()
	
	Form_OnFormInit()
	
End Sub

