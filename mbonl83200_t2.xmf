	<SCRIPT_INFO _len="7469" _ulen="7151" >
'============================================================================
' 01. 화 면 명 : 공개매수_취소탭
' 02. 화면설명 : 공개매수
' 03. 작    성 : 2023. 06. 12. 정지환
'============================================================================

Dim g_szPwd
Dim g_szClick
'============================================================================
Sub Form_OnFormInit()	
	grdMain.visible = false
'	imgEmpty.setMaintainingRatio("1")
	Calendar0.addday = -30
	f_SendRequestData()
	
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	imgEmpty.setMaintainingRatio("1")
End Sub
'============================================================================
Function f_SendRequestData()
	DATAMANAGER.RequestTranData( "obibk_tbal_002r" )
end function

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obibk_tbal_002r" then
	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" 		, 0 , Left(acntMain.caption,8))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" 		, 0 , Right(acntMain.caption,2))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PWD" 	, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "STA_DATE" 	, 0 , Calendar0.caption )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIN_DATE" 	, 0 , Calendar1.caption )
		
		
	elseif szTranID == "obibk_tbal_001a" then
		DATAMANAGER.SetEventFlag( szTranID, "A" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PROS_CLS_CODE" 			, 0 , "2" )	'
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" 					, 0 , Left(acntMain.caption,8))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" 					, 0 , Right(acntMain.caption,2))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ISCD" 					, 0 , grdMain.GetCellData("bd_Iscd", g_szClick) )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "TOB_SRNO" 				, 0 , grdMain.GetCellData("bd_TobSrno", g_szClick) )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "APLT_QTY" 				, 0 , grdMain.GetCellData("bd_Qty", g_szClick) )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PWD" 					, 0 , g_szPwd )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "CONT_CLS_CODE" 			, 0 , "4" )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obibk_tbal_002r" then
		dim nCnt
		
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		if nCnt == 0 then
			grdMain.visible = false
			lblEmpty.visible = true
			imgEmpty.visible = true
		else
			grdMain.visible = true
			lblEmpty.visible = false
			imgEmpty.visible = false
		end if
		
		for i = 0 to nCnt - 1
			dim szTrgtIsnm, szAcno, szAsno, szIscd
			
			szIscd 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ISCD" 			, i )	'공개매수자
			szTrgtIsnm 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "TRGT_STCK_ISNM"	, i )	'대상주식
			szAcno 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ACNO" 			, i )	'계좌번호
			szAsno 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ASNO" 			, i )	'계좌일련번호
			szClsnYn 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CLSN_YN" 		, i )	'마감여부
			szFinDate 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "APLT_FIN_DATE" 	, i )	'신청종료일자
			szToday 		= Form.GetSharedData("&HOST_DATE" , false)
			
			grdMain.SetCellData("bd_cell14", i, "공개매수자")
			grdMain.SetCellData("bd_cell15", i, "대상주식")
			grdMain.SetCellData("bd_cell16", i, "공개매수가격")
			grdMain.SetCellData("bd_cell19", i, "신청일")
			grdMain.SetCellData("bd_cell55", i, "신청수량")
			grdMain.SetCellData("bd_cell13", i, "결제일")
			grdMain.SetCellData("bd_cell31", i, "지급계좌")
			
			grdMain.SetCellData("bd_cell43", i, szTrgtIsnm & "(" & mid(szIscd ,2,6)& ")" )
			grdMain.SetCellData("bd_cell65", i, szAcno & szAsno)
'			szToday = 20230404
			if szClsnYn <> "N" then
				grdMain.SetCellImage("bd_cell110", i ,"alpha")
				grdMain.SetCellData("bd_cell110", i, "배정내역 〉")
				grdMain.SetCellFgColor("bd_cell110", i, "7" )
			else
				grdMain.SetCellImage("bd_cell110", i ,"btn_01_n.9.png")
				grdMain.SetCellData("bd_cell110", i, "취소하기")
				grdMain.SetCellFgColor("bd_cell110", i, "62" )
			end if
		next
	elseif szTranID == "obibk_tbal_001a" then
'		ShowAlert("", DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ERR_CNTT" 		, 0 ))
'		Form.ShowAlert("안내", "청약신청 취소가\n완료되었습니다." )
		Form.MsgBox("안내", "청약신청 취소가\n완료되었습니다.", "", 6)
		DATAMANAGER.RequestTranData( "obibk_tbal_002r" )
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	if szTranID <> "obibk_tbal_001a"then
		Form.ShowAlert( "알림" , szErrMsg)
	else
		Form.ShowAlert( "알림" ,szSubErr)
	end if
End Sub
'============================================================================
Sub grdMain_OnClickUp(lRow, szCellID)
	if szCellID = "bd_cell110" then
		if grdMain.GetCellData("bd_cell110", lRow ) == "취소하기" then
			g_szClick = lRow
			Form.MsgBox("안내", "공개매수 청약 신청을\n취소 하시겠습니까?", "Cancel_Click", 7, "청약취소", "닫기")
		else
			Dim szIscd, szTobSrno, szData
			
			szIscd		= grdMain.GetCellData("bd_Iscd", lRow) 
			szTobSrno	= grdMain.GetCellData("bd_TobSrno", lRow) 
			
			szData = szIscd & "★" & szTobSrno & "★" & acntMain.caption
			
			Form.OpenPopup( "mbonl83200_p5" , szData , "0")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Cancel_Click" and sRet == "ok" then
		Form.openPopupAnimation("pwdcheckpopup", acntMain.caption & "☆0" ,"","2")
	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" And sRet <> Null then
			Dim tPwdData
			tPwdData = Split(sRet, "★")
			
