'============================================================================
' 01.화면명 	: 미니팝업
' 02.화면설명	: 미니팝업
' 03.작성		: 2016.02.18
' 16.02.18	 KMC	: Onforminit 오류 수정, 5개 버튼 이미지 및 사이즈 세팅
' 16.03.03	 KMC	: 각버튼당 CloseForm 추가
' 16.03.07 	 KMC : 6자 이상일시 폰트사이즈 조절기능추가
' 21.08.26	 LHR : 현재가버튼에 차트 추가
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim IMAGE_NAME
Dim CONTANINER_NAME
Dim TYPE_MAX_COUNT
Dim IMAGE_ARROW_HEIGT

IMAGE_ARROW_HEIGT = 5
IMAGE_NAME = "Image0"
CONTANINER_NAME  = "Container"
TYPE_MAX_COUNT = 5

Dim ISCD
Dim g_sPopupType
Dim g_szGbn
Dim g_szItemCode
Dim g_szItemMarket
Dim g_szIndexName


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()	
	listInfo = Split ( Form.GetOpenLinkData() , "★" , 0 , 0 )
	
	if ( #listInfo == 1 ) then
		exit sub
	end if
	
	nYPos	 	= Int(listInfo[0])
	nHeight	 	= Int(listInfo[1])
	g_sPopupType	= listInfo[2]
	g_szGbn  	= listInfo[3]

	sShowConName = CONTANINER_NAME & g_sPopupType

	orientation =  Form.GetOrientation()
	
	nScreenHeight = 600 ' 임시로 잡음
	if orientation = 0 then
	else
		nScreenHeight = 375
	end if
	
	for i = 0 to TYPE_MAX_COUNT - 1
		Form.Log("i", i)
		sContanName = CONTANINER_NAME & i
		if sShowConName = sContanName then
			Form.SetCtlProp(sContanName, "visible" , "1")
			
			sConImageName = sContanName & "." & IMAGE_NAME 
			nConHeight = Int(Form.GetCtlProp(sContanName, "height"))
			
			nImageTop = Int(Form.GetCtlProp(sConImageName, "top"))
			nImageHeight = Int(Form.GetCtlProp(sConImageName, "height"))
			
			Button5.height = 40
			Button6.height = 49
			
			if nConHeight + nYPos + nHeight > nScreenHeight then ' 위로 떠야 하는 경우
				szTop = "4"
				
				'- 7 패딩 값, 삭제 금지
				Form.SetCtlProp(sContanName, "top" , nYPos - nConHeight + 5 )
'				Form.SetCtlProp(sConImageName , "top", nImageTop - IMAGE_ARROW_HEIGT)
				Form.SetCtlProp(sConImageName , "imgpath", "btn_link_bg2.9")
'				tblHoga.top = nYPos - nConHeight + 5 - 40 + 4
				Button5.top = nYPos - nConHeight + 5 - 40 + 5
				Button6.top = nYPos - nConHeight + 5 - 40 + 5 + 40 - 1
				
				if i = 4 then
					Button5.top = nYPos - nConHeight + 5 - 40 + 4
				end if
								
			else ' 아래로 떠야 하는 경우
				'szTop = "11"
				szTop = "10"
				
				Form.SetCtlProp(sContanName, "top" , nYPos + nHeight - 16 )
'				Form.SetCtlProp(sConImageName , "height", nImageHeight - IMAGE_ARROW_HEIGT)
				Form.SetCtlProp(sConImageName , "imgpath", "btn_link_bg.9")
'				tblHoga.top = nYPos + nHeight - 16 + nConHeight - 4 - 1
				Button5.top = nYPos + nHeight - 16 + 10 + 49 - 1
				Button6.top = nYPos + nHeight - 16 + 10 
								
				Button5.height = Button5.height + 1
				Button6.height = Button6.height + 1
				if i = 4 then
					Button5.top = nYPos + nHeight - 16 + nConHeight - 5
				end if
				
			end if
		
			if i = 2 or i = 3 then'주문에선 현재 이 case만 사용
'				tblHoga.visible = true
				Button5.visible = true
				Button6.visible = true
				Button5.width = 93
				Button6.width = 94
				Button5.left = 0
				Button6.left = 92
				
				Form.SetCtlProp("Button5", "caption"	, "현재가")
				Form.SetCtlProp("Button6", "caption"	, "차트")
				
				if nConHeight + nYPos + nHeight > nScreenHeight then ' 위로 떠야 하는 경우
					Button5.top = Form.GetCtlProp(sContanName, "top") + 5
					Button6.top = Form.GetCtlProp(sContanName, "top") + 5
				else
					Button5.top = Form.GetCtlProp(sContanName, "top") + 10
					Button6.top = Form.GetCtlProp(sContanName, "top") + 10
				end if
				
				Button5.height = 49
				Button6.height = 49

			elseif i = 4 then
'				tblHoga.visible = true
				Button5.visible = true
				Button6.visible = false
				Button5.left = Form.GetCtlProp(sContanName, "left")

				Button5.height = 40
				Form.SetCtlProp("Button5", "caption"	, "현재가")
			else
'				tblHoga.visible = false
				Button5.visible = false
				Button6.visible = false
			end if
			
			
			For j = 0 to 4
				szButton = sContanName& "." & "Button" & j
				
				' KMC 160307
				Form.SetCtlProp(szButton, "top"		, szTop)
				Form.SetCtlProp(szButton, "caption"	, listInfo[j+4])				
				
				szSize	=	0
				
				if j > 0 then
					szSize	=	len(listInfo[j+4])
					if	szSize	>= 18		then
						Form.SetCtlProp(szButton, "fontsize", "-3")
					end	if
				end	if
				' KMC 160307

				'If j > 0 Then			'KMC 160401 첫번째 버튼도 적용되도록 처리
					Select Case Trim(listInfo[j+4])
						Case "매수"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc10.9")
									Form.SetCtlProp(szButton, "fgcolor"	, "62")
						Case "매도"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc11.9")
									Form.SetCtlProp(szButton, "fgcolor"	, "62")
						Case "대용매도"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc11.9")
									Form.SetCtlProp(szButton, "fgcolor"	, "62")
						Case "정정"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc17.9")
									Form.SetCtlProp(szButton, "fgcolor"	, "62")
						Case "취소"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc18.9")
									Form.SetCtlProp(szButton, "fgcolor"	, "62")
						Case	"추가매수"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc10.9")
										Form.SetCtlProp(szButton, "fgcolor"	, "62")
						Case	"신규가입"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc10.9")
										Form.SetCtlProp(szButton, "fgcolor"	, "62")
										'20171117 HAMWG START : 펀드몰 개정 대응
										if ( #listInfo > 9 ) then
											if Trim(listInfo[8]) = "판매채널1" then
												Form.SetCtlProp(szButton, "caption"	, "영업점")
												Form.SetCtlProp(szButton, "enable"	, False)
											end if
										end if
										'20171117 HAMWG END
						Case Else	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc24.9")
									Form.SetCtlProp(szButton, "fgcolor"	, "4")
					End Select
				'End If
			Next
			
'			if #listInfo == 10 then
'				ISCD = listInfo[9]
'				
'				if ISCD <> "" then
'					if Left(ISCD, 1) = "A" Then
'						g_szItemCode = Right(ISCD, Len(ISCD) - 1)
'					else
'						g_szItemCode = g_szLinkData
'					end if
'					
'					g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
'
'					Request_Data(g_szType,g_szItemCode)
'				end if
'			end if
		else
			Form.SetCtlProp(sContanName, "visible" , "0")
		end if
	next
	
End Sub


