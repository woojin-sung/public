Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_elw_cntg"  )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_ovtp_cntg" )
End Sub
'============================================================================
' Request_Data
'============================================================================
Function Request_Data(szType,szCd)

	if szType <> g_szType then
		if szCd == g_szItemCode then				' 구분이 다르고, 종목코드가 같은경우
			if szType == "13" then			' 시간외단일가 선택시
				szTranID = "ohhts_1181_002r"
				g_szType = szType
			elseif g_szType == "13" then	' 기존 선택이 시간외 단일가일때
				szTranID = "ohhts_1001_001r"
				g_szType = szType
			end if
		end if
	else
		if szCd <> g_szItemCode then				' 구분이 같고, 종목코드가 다른경우
			if szType == "13" then			' 시간외단일가 선택상태일때
				szTranID = "ohhts_1181_002r"
				g_szItemCode = szCd
			else							' 시간외단일가외의 선택상태일때
				szTranID = "ohhts_1001_001r"
				g_szItemCode = szCd
			end if
		Else
			if szType == "13" then			' 시간외단일가 선택상태일때
				szTranID = "ohhts_1181_002r"
			else							' 시간외단일가외의 선택상태일때
				szTranID = "ohhts_1001_001r"
			end if

		end if
	end if
	
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szIndexName  = Form.GetItemCodeInfo( g_szItemCode , "indexname")
	
	DATAMANAGER.RequestTranData(szTranID)
End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'Table Clear
'	For i = 0 To 0
'		For j = 1 To 4
'			tblHoga.SetCellString( i, j, "")
'		Next	
'	Next
	
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_elw_cntg"  )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_ovtp_cntg" )
	
	If szTranID = "ohhts_1001_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0 , g_szItemMarket )
	
	ElseIf szTranID = "ohhts_1181_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode )
	
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	if szTranID = "ohhts_stck_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )

	elseif szTranID = "ohhts_frbr_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_ovtp_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
	
	elseif szTranID = "ohhts_marg_rate" then
		DATAMANAGER.SetDataValue( 1, "ohhts_marg_rate", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )
	
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_1001_001r" Then
		Dim	nMARG_RATE				'증거금율
		Dim 	nPrice					'전일대비

	
		g_szISSU_STAT_CLS_CODE 	= DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_ISSU_STAT_CLS_CODE" , 0 )
		nMARG_RATE				= CInt( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_MARG_RATE" , 0 ) )
		
		nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_PRDY_VRSS" , 0 )
				
		if g_szItemMarket = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
			
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szItemMarket = "T" then
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
			
		else
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_marg_rate" )
	
	ElseIf szTranID = "ohhts_1181_002r" Then
		DATAMANAGER.RequestRealData( "ohhts_ovtp_cntg" )
		
	End If
		
End Sub
'============================================================================
Sub Form_OnFormBeforeChangeScreen(sScreenNo, sOpenData)
	
End Sub

'============================================================================
Sub Button5_OnClick()
	if g_sPopupType = "2" then
		call Container2_Button0_OnClick()
	elseif g_sPopupType = "3" then
		call Container3_Button0_OnClick()
	elseif g_sPopupType = "4" then
		call Container4_Button0_OnClick()
	end if
End Sub

'============================================================================
Sub Button6_OnClick()
	if g_sPopupType = "2" or g_sPopupType = "3" or g_sPopupType = "4" then
		Form.SendReturnToParent( "MOVEPOP_RETURN" , g_szGbn & "★" & "6" & "★" & g_sPopupType)
		Form.CloseForm()
	end if
End Sub

