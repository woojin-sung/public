'============================================================================
Sub LabelFilter_OnClick()
	
	Dim szData
	szData = ""
	
	if gOrdGubun == "1" then
		szData = gNationGubun  & "★" & "2"
	elseif gOrdGubun == "2" then
		szData = gNationGubun  & "★" & "1"
	else
		szData = gNationGubun  & "★" & gOrdGubun 
	end if
	
	Form.OpenPopupAnimation("mhtro16100_p20", szData, "", "2")

End Sub

