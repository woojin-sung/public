End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	'------------------------------------------
	' 조회조건 필터 설정완료
	'------------------------------------------
	if sKeyName == "FILTER_SET_COMPLETE" then
		
		arrData = Split(sRet,"★")
		
		'-----------------------------
		'조회국가
		'-----------------------------
		szNationOption = arrData(0)
		gNationGubun  = szNationOption
				
		'-------------------------------------------------------
		' 매매구분
		' 필터설정 화면에서 매수 = 1 / 매도 = 2
		' 서비스조회 구분값은 매수 = 2 / 매도 = 1
		' 이므로 gOrdGubun의 값을 서비스 조회 구분값에 맞춰 세팅
		'-------------------------------------------------------
		szOrderGubunOption = arrData(1)
		
		if szOrderGubunOption == "1" then
			gOrdGubun = "2" 
		elseif szOrderGubunOption == "2" then
			gOrdGubun = "1" 
		else
			gOrdGubun  = szOrderGubunOption
		end if
		
		SetFilterText()
		RequestData()
		
	end if
	
End Sub

'============================================================================
' 선택한 필터값 라벨 세팅
'============================================================================
Function SetFilterText()

	'-------------------------------------------------
	' 국가필터값 텍스트 추출
	'-------------------------------------------------
	sNationFilterText = ""
	if gNationGubun  == "" then
		sNationFilterText = "전체"
	else
	
		arrNationFlag = Split(gNationGubun ,"@")
		
		for i = 0 to #arrNationFlag - 1
			
			if i == 0 then
				
				sFlag = arrNationFlag(0)
				
				if sFlag == "Y" then
					sNationFilterText = "전체"
					exit for
				end if
				
			else
				
				sFlag = arrNationFlag(i)
				
				if sFlag = "Y" then
					
					if i == 1 then
						if sNationFilterText == "" then
							sNationFilterText = "미국"
						else
							sNationFilterText = sNationFilterText.."·미국"
						end if
					elseif i == 2 then
						if sNationFilterText == "" then
							sNationFilterText = "중국"
						else
							sNationFilterText = sNationFilterText.."·중국"
						end if
					elseif i == 3 then
						if sNationFilterText == "" then
							sNationFilterText = "홍콩"
						else
							sNationFilterText = sNationFilterText.."·홍콩"
						end if
					elseif i == 4 then
						if sNationFilterText == "" then
							sNationFilterText = "일본"
						else
							sNationFilterText = sNationFilterText.."·일본"
						end if
			
					end if
				
				end if
			
			end if
		
		next
		
	
	end if
	
	'-------------------------------------------------
	' 정렬기준 필터 텍스트 추출
	' 실제로 필터설정 팝업에서 넘겨준 gOrdGubun 값은
	' 매수 = 1 / 매도 = 2 지만, 서비스 인풋데이터에 맞게
	' 변경한후여서 gOrdGubun = 1(매도) / 2(매수) 임.
	'-------------------------------------------------
	sFilterOrdGubunCode = ""
	if gOrdGubun  == 0 or gOrdGubun  == "0" then
		sFilterOrdGubunCode = "전체"
	elseif gOrdGubun  == 1 or gOrdGubun  == "1" then
		sFilterOrdGubunCode = "매도"
	elseif gOrdGubun  == 2 or gOrdGubun  == "2" then
		sFilterOrdGubunCode = "매수"
	end if
	
	
	'-------------------------------------------------
	' 세팅
	'-------------------------------------------------
	if sNationFilterText == "전체" and sFilterOrdGubunCode == "전체" then
			
			LabelFilter.fontsize = -2
			LabelFilter.SetMaxLineCount(1)
			LabelFilter.caption = "전체"
	else
			
			nCheckInstr = Instr(sNationFilterText,"·")
			
			if  nCheckInstr > 0 then
				LabelFilter.fontsize = -2
				LabelFilter.SetMaxLineCount(2)
				LabelFilter.caption = sFilterOrdGubunCode .." " .. "\n".. sNationFilterText
			else
				
				LabelFilter.fontsize = -2
				LabelFilter.SetMaxLineCount(1)
				LabelFilter.caption = sFilterOrdGubunCode .."·".. sNationFilterText
					
			end if
			
	end if
	
	
End Function

'============================================================================
' 주문체결 서비스 호출 전, gNationGubun값으로 인풋데이터 생성
'============================================================================
Function GetNationInputData()

	'전체@미국@중국@홍콩@일본
	'gNationGubun = Y@N@N@N@N
	Dim InputData
	InputData = ""
	
	if gNationGubun <> "" then
	
		arrNation = Split(gNationGubun,"@")
		
		for i = 0 to #arrNation - 1
		
			sData = arrNation(i)
			
			if sData == "Y" then
				
				if i == 0 then
					InputData = GetNationCode(i)
					exit for
				else
					
					if InputData == "" then
						InputData = GetNationCode(i)
					else
						InputData = InputData & "@" & GetNationCode(i)
					end if
				
				end if
			
			end if
			
		
		next
	
	end if
	
	return InputData

End Function
'============================================================================
Function GetNationCode(nIndex)
	
	'필터팝업의 조회국가 순서대로
	
	if nIndex == 0 then 		'전체
		return "000"
	elseif nIndex == 1 then 	'미국
		return "840"
	elseif nIndex == 2 then 	'중국
		return "156"
	elseif nIndex == 3 then 	'홍콩
		return "344"
	elseif nIndex == 4 then 	'일본
		return "392"
	end if

End Function

'============================================================================
' [전체 취소하기] 클릭 이벤트, 미체결내역 존재 시 활성화됨.
'============================================================================
Sub lblAllCancel_OnClick()
	Form.triggerEvent("#", "SEND_ALL_CANCEL", "")
End Sub

'============================================================================
' 주문일자 + 주문시간 머지 및 마스킹 처리
'============================================================================
Function GetOrderDateTime(sDate,sTime)

	if sDate <> "" and sTime <> "" then
		
		sYear = Left(sDate,4)
		sMonth = Mid(sDate,5,2)
		sDay = Right(sDate,2)
		sTransDate = sYear & "/" & sMonth & "/" & sDay
		
		sHour =  Left(sTime,2)
		sMin =  Mid(sTime,3,2)
		sSec = Right(sTime,2)
		sTransTime = sHour & ":" & sMin & ":" & sSec
		
		sMergeDate = sTransDate & " " & sTransTime
		
		return sMergeDate
		
	else
		return sDate & " " & sTime
	end if

End Function

'============================================================================
' 미체결내역이 모두 오프라인주문인지 여부
'============================================================================
Function CheckAllOffLineOrder()

	nRowCnt = Cint(Grid0.rowcount)
	bAllOffLineOrder = "YES"
	
	if nRowCnt > 0 then
		
		for i = 0 to nRowCnt - 1
			
			sOnline = Grid0.GetCellData("bd_online", i)
			
			if sOnline == "Y" then
				bAllOffLineOrder = "NO"
				Exit For
			end if
		
		next
	
	end if
	
	return bAllOffLineOrder

End Function

