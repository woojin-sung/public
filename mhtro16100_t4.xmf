		return "영국"
	elseif sCountryCode = "09" then
		return "영국"
	elseif sCountryCode = "10" then
		return "독일"
	elseif sCountryCode = "11" then
		return "핀란드"
	elseif sCountryCode = "12" then
		return "프랑스"
	elseif sCountryCode = "13" then
		return "벨기에"
	elseif sCountryCode = "14" then
		return "네덜란드"
	elseif sCountryCode = "15" then
		return "포르투갈"
	elseif sCountryCode = "16" then
		return "그리스"
	elseif sCountryCode = "17" then
		return "아일랜드"
	elseif sCountryCode = "18" then
		return "이탈리아"
	elseif sCountryCode = "19" then
		return "스페인"
	elseif sCountryCode = "20" then
		return "오스트리아"
	elseif sCountryCode = "21" then
		return "캐나다"
	elseif sCountryCode = "23" then
		return "인도네시아"
	elseif sCountryCode = "24" then
		
		if sVndrCode == "XSTC" then 
			return "호치민"
		elseif sVndrCode == "HSTC" then
			return "하노이"
		end if
	
	elseif sCountryCode = "26" then
		return "스위스"
		
	else
		return ""
	end if 

End Function

'============================================================================
' 주문유형코드 => 주문유형명 가져오기
'============================================================================
Function GetOrderNameByCode(sCode)
	
	if sCode == "1" then
		return "시장가"
	elseif sCode == "2" then
		return "지정가"
	elseif sCode == "4" then
		return "LOO"
	elseif sCode == "5" then
		return "LOC"
	elseif sCode == "6" then
		return "MOO"
	elseif sCode == "7" then
		return "MOC"
	elseif sCode == "8" then
		return "Limit VWAP"
	elseif sCode == "9" then
		return "Limit TWAP"
	elseif sCode == "A" then
		return "VWAP"
	elseif sCode == "B" then
		return "TWAP"
	else
		return ""
	end if

End Function

'============================================================================
' 주문상태코드 => 주문상태명 가져오기
'============================================================================
Function GetOrderStateNameByCode(sCode)

	if sCode == "0" then
		return "정상"
	elseif sCode == "1" then
		return "거부"
	elseif sCode == "2" then
		return "자동거부"
	elseif sCode == "3" then
		return "자동취소"
	elseif sCode == "4" then
		return "미접수"
	else
		return ""
	end if
	
End Function

'============================================================================
' 매매구분코드 => 매매구분명
'============================================================================
Function GetGubunNameByCode(sCode,sRctCode,nIndex)

	' 매매구분
	if sCode == "1" then
	
		Grid0.SetCellFgColor( "bd_ordergubun", nIndex, "2" )
		
		if sRctCode == "1" then
			return "매도정정"
		elseif sRctCode == "2" then
			return "매도취소"
		else
			return "매도"
		end if
		
	elseif sCode == "2" then
	
		Grid0.SetCellFgColor( "bd_ordergubun", nIndex, "1" )
		
		if sRctCode == "1" then
			return "매수정정"
		elseif sRctCode == "2" then
			return "매수취소"
		else
			return "매수"
		end if
		
	end if 

	
End Function

'============================================================================
' 미체결 종목 선택
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)


'	'-----------------------------------------------
'	'메인화면에 선택한 종목정보 던지기
'	'-----------------------------------------------
'	sVndrCode = Grid0.GetCellData("bd_vndrcode", lRow)
'	
'	sMarektCode = Transform_Exid(sVndrCode)
'	sCode = Grid0.GetCellData("bd_code", lRow) 
'	sName = Grid0.GetCellData("bd_name", lRow)
'	
'	szData = sMarektCode .. "@" .. sCode .. "★" .. sName
'	Form.triggerEvent("#", "SendChegyulItem", szData)
	
	'--------------------------------------------------
	'선택행에 미체결수량이 있으면 정정/취소탭으로 연동
	'단,오프라인주문일 경우에는 연동막음.얼럿메시지 보여줌.
	'--------------------------------------------------
	nMicheQty = Cint(Grid0.GetCellData("bd_micheqty", lRow))
	
	if nMicheQty > 0 then
	
		nOnline = Grid0.GetCellData("bd_online", lRow)
		
		if nOnline == "Y" then
		
			'-----------------------------------------------
			'메인화면에 선택한 종목정보 던지기
			'-----------------------------------------------
			sVndrCode = Grid0.GetCellData("bd_vndrcode", lRow)
		
			sMarektCode = Transform_Exid(sVndrCode)
			sCode = Grid0.GetCellData("bd_code", lRow) 
			sName = Grid0.GetCellData("bd_name", lRow)
		
			szData = sMarektCode .. "@" .. sCode .. "★" .. sName
			Form.triggerEvent("#", "SendChegyulItem", szData)
		
			'---------------------------------------------------
			'미체결 종목정보 전달
			'거래소코드★종목코드★주문가격★주문수량★주문번호
			'---------------------------------------------------
			sPrice = Grid0.GetCellData("bd_orderprice", lRow)
			sQty = Grid0.GetCellData("bd_micheqty", lRow)
			sOrdNo = Grid0.GetCellData("bd_orderno", lRow)
			
			szData = sVndrCode .. "★" .. sCode .. "★" .. sPrice .. "★" .. sQty .. "★" .. sOrdNo
			Form.triggerEvent("#", "SendMiChegyulItem", szData)
		
		
		else
		
			Form.MsgBox("안내", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요.", "CHECK_ONLINE", 6)
		
		end if
		
	end if
	
	
End Sub

