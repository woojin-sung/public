'============================================================================
Sub Form_OnFormInitBefore()
	
	'--------------------------------------------------
	' 컨트롤 설정
	'--------------------------------------------------
	imgRefresh.setMaintainingRatio("1")
	imgNodata.setMaintainingRatio("1")
	imgDownArrow.setMaintainingRatio("1")
	
	LabelFilter.paddinginfo = "0,0,0,0"
	
	Grid0.SetCellMaxLineCount("bd_reject",2)
	

End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------
	' 조회필터값 초기화
	'--------------------------------------------------
	gCheGubun 	= "0" 	     	'전체
	gNationGubun 	= "Y@N@N@N@N"		'전체
	gOrdGubun 	= "0" 	     	'전체
	
	
	'--------------------------------------------------
	' 호가테이블 숨기기
	'--------------------------------------------------
	Form.triggerEvent("#", "ChangeContHoga", "3")
	
	'--------------------------------------------------
	' 폼탭 헤더 생성
	'--------------------------------------------------
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") 								 '활성화/비활성화 폰트색상

	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "체결")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "미체결")

	FormTab0.currenttab = 0

	'--------------------------------------------------
	' 주문환경설정 값 Load
	'--------------------------------------------------
	'Load_OrderSet()
	
	'--------------------------------------------------
	' 미체결 내역 조회
	'--------------------------------------------------
	RequestData()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'============================================================================
	' 종목정보 연동
	'============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		'-----------------------------------------------------------------------
		'현재가★상한가★하한가★매매단위★통화★소수점자리수★한글종목명★틱타입
		'-----------------------------------------------------------------------
		'arrItemInfo = Split(sParam, "★")
		'
		'g_szCurPrice 	= arrItemInfo(0)
		'g_szUpLimit	= arrItemInfo(1)
		'g_szDnLimit	= arrItemInfo(2)
		'g_szOrdSize 	= arrItemInfo(3)
		'g_szCurrency	= arrItemInfo(4)
		'g_szDecimal	= arrItemInfo(5)
		'g_szKorName	= arrItemInfo(6)
		'g_szTickType	= arrItemInfo(7)
		'g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
	
		'-----------------------------------------------------------------------
		'가격입력창 소수점 자리수 세팅 / 통화기호 세팅
		'-----------------------------------------------------------------------
		'if g_szCurrency <> "" then
		'	sMask = "0,0,,".. " " .. g_szCurrency .. ",0,,"..g_szDecimal..",1,1,2,0"
		'else
		'	sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		'end if
		'
		'edtPrc.mask = sMask
		
		'-----------------------------------------------------------------------
		'수량입력창 매매단위 세팅
		'-----------------------------------------------------------------------
		'if g_szOrdSize <> "" then
		'	edtQty.hintcaption = Cint(g_szOrdSize).."주 단위"
		'end if
		
		'-----------------------------------------------------------------------
		'종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		'-----------------------------------------------------------------------
		'if g_szChangeInit == "1" then
		'	Init_InputControl()
		'end if
		
		'-----------------------------------------------------------------------
		'국가별 주문가능 주문유형 설정
		'-----------------------------------------------------------------------
		'SetOrderTypeList(g_szNg)
		
		'-----------------------------------------------------------------------
		'통화별 환율 조회
		'-----------------------------------------------------------------------
		'RequestExChangeRate()
	
	'============================================================================
	' 호가조회 완료(가격/수량 자동입력 요청)
	'============================================================================
	elseif sEventName == "HOGA_COMPLETE" then
	
			
	'============================================================================
	' 종목코드 초기화/종목코드 변경/탭 변경
	'============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		RequestData()
		
	'============================================================================
	' 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	'============================================================================	
	elseif sEventName == "ChangeAcnt" then
	
		RequestCombinedMargin()
		RequestData()
		
	'============================================================================
	' 약정 계좌 > 미약정 계좌로 변경 시 데이터 클리어를 위해 호출
	'============================================================================
	elseif sEventName == "ClearData" then
		
		RequestData()
	
	'============================================================================
	' 주문번호 연동 => 원주문번호만으로 주문가능? 주문일자 반드시 넣어줘야하면 무쓸모임
	'============================================================================
	elseif sEventName == "AFTER_ORGNO" then
	
	'============================================================================
	' 20240715 종목 미변경 시, 필요한 데이터만 재조회(매도가능수량/환율)
	'============================================================================
	elseif sEventName == "RefreshData" then
	
		RequestData()
		
	end if
	
End Sub

'============================================================================
' 통합증거금 약정여부 조회 서비스 호출
'============================================================================
Function RequestCombinedMargin()
	
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" 			, 0 , " ")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" 			, 0 , "081")
		
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "RMND_SRNO" 		, 0 , " ")
	
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
	

End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

		
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'==========================================================================
	'통합증거금 약정조회
	'==========================================================================
	if szTranID == "obpds_srvc_323r" then
	
		'------------------------------------------------------------------------------------
		'SVCD 값이 0이면, 통합증거금 미약정 계좌
		'------------------------------------------------------------------------------------
		szCnt = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVC_SRNO" , 0)
		
		if Cint(szCnt) <> 0 then
			gTotalYN = true
		else
			gTotalYN = false
		end if
	
	
	'==========================================================================
	' 미체결내역 조회
	'==========================================================================
	elseif szTranID == "obtro_oder_109r" then
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_109r") then
			DATAMANAGER.RequestNextData("obtro_oder_109r")
		else
			
			nDataCnt = Cint(Grid0.rowcount)
			
			if nDataCnt == 0 then
				imgNodata.left = 162
				lblNodata.left = 0
				imgNodata.visible = true
				lblNodata.visible = true
				
			else
				imgNodata.left = 500
				lblNodata.left = 500
				imgNodata.visible = false
				lblNodata.visible = false
			end if
			
			'------------------------------------------------------------
			' 종목명 최대라인수 설정
			'------------------------------------------------------------
			Grid0.SetCellMaxLineCount("bd_name",2)
		
			for i = 0 to Grid0.rowcount - 1
				
				
				'------------------------------------------------------------
				' 현금/대출 구분
				'------------------------------------------------------------
				sCashCredit = Grid0.GetCellData("bd_loantype", i)
				if sCashCredit == "0251" then
					Grid0.SetCellData("bd_cash", i, "대출")
				else
					Grid0.SetCellData("bd_cash", i, "현금")
				end if
				
				'------------------------------------------------------------
				'매매구분
				'------------------------------------------------------------
				sGubunCode = Grid0.GetCellData("bd_maemaegubun", i)
				sModeCancelCode = Grid0.GetCellData("bd_modcancelcode", i)
				sGubunName = GetGubunNameByCode(sGubunCode,sModeCancelCode,i)
				Grid0.SetCellData("bd_ordergubun", i, "| ".. sGubunName)
				
				'------------------------------------------------------------
				'시장구분
				'------------------------------------------------------------
				sCountryCode = Grid0.GetCellData("bd_marketgubun", i)
				sVndrCode = Grid0.GetCellData("bd_vndrcode", i)
				sCountryName = GetCountryNameByCode(sCountryCode,sVndrCode)
				Grid0.SetCellData("bd_marketgubun", i, sCountryName)
				
				'------------------------------------------------------------
				'주문구분
				'------------------------------------------------------------
				sOrderCode = Grid0.GetCellData("bd_ordercode", i)
				sOrderName = GetOrderNameByCode(sOrderCode)
				Grid0.SetCellData("bd_ordername", i, sOrderName)
				
				'------------------------------------------------------------
				'주문상태
				'------------------------------------------------------------
				sOrderStateCode = Grid0.GetCellData("bd_orderstatecode", i)
				sOrderStateName = GetOrderStateNameByCode(sOrderStateCode)
				Grid0.SetCellData("bd_orderstate", i, sOrderStateName)
				
				'------------------------------------------------------------
				'주문시간
				'------------------------------------------------------------
				sOrderDate = Grid0.GetCellData("bd_orderdate", i)
				sOrderTime = Grid0.GetCellData("bd_ordertime", i)
				sMergeDate = GetOrderDateTime(sOrderDate,sOrderTime)
				Grid0.SetCellData("bd_ordertime", i, sMergeDate)
			
			
			next
			
			'------------------------------------------------------------
			'[전체 취소하기] 버튼 활성화 조건 체크
			'[미체결] & 조회조건이 모두 [전체] & 미체결내역이 모두 [오프라인주문]이 아닌 경우에만 활성화
			'------------------------------------------------------------
			sNationInputData = GetNationInputData()
			sAllOffLineOrder = CheckAllOffLineOrder()
			
			if (gCheGubun == 2 or gCheGubun == "2") and (gOrdGubun == "0" or gOrdGubun == 0) and (sNationInputData == 000 or sNationInputData == "000") and sAllOffLineOrder == "NO" then
				
				if nDataCnt > 0 then
				
					lblAllCancel.visible = true
					
					'미체결건 건수가 5건 미만일 경우
					if nDataCnt < 5 then
					
						Grid0.height = 40 + nDataCnt * 53
						lblAllCancel.top = 45 + 40 + CInt(Grid0.rowcount) * 53
						
					else
					
						Grid0.height = 306
						lblAllCancel.top = 350
						
					end if
				
				else
				
					lblAllCancel.visible = false
					Grid0.height = 346
					
				end if
				
			else
				
				lblAllCancel.visible = false
				Grid0.height = 346
			
			end if
			'------------------------------------------------------------
		
		end if
		
	
	
	end if
	
End Sub

'============================================================================
' 서비스 오류처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
'
	'------------------------------------------------------------------
	' 해외ETP 미약정 고객
	'------------------------------------------------------------------
	if szErrCode == "6207" then
		
		Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
	
	'------------------------------------------------------------------
	' 대출주문 대출일자/대출일련번호 미입력 시
	'------------------------------------------------------------------
	elseif szErrCode == "1256" or szErrCode == "1258" then
		
		Form.ShowAlert("안내", "대출일자 선택 후 주문이 가능해요.\n잔고에서 매도할 종목 선택 후 매도를 진행해주세요.")
	
	'------------------------------------------------------------------
	' 그외
	'------------------------------------------------------------------
	else
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
	

End Sub

'============================================================================
' 메시지박스 리턴
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "ETP_MSG" then
		
		if sRet == "ok" then
			Form.OpenScreen("87050" , "")
		end if
	
	end if
	
End Sub

'============================================================================
' 단가/수량/금액 입력 키패드 링크데이터 생성
'============================================================================
Function GetLinkData(sGubun)

	'==================================================
	' 연결화면 링크값 세팅
	'==================================================
	' 0 : gGubun 				= 타이틀구분(단가/수량/금액)
	' 1 : gMarket 			= 시장구분(2자리)
	' 2 : gCode				= 종목코드
	' 3 : gCredit				= 현금/신용구분
	' 4 : gCurPrice 			= 현재가
	' 5 : gPrc				= 입력가격
	' 6 : gQty 				= 입력수량
	' 7 : gHighPrice 			= 상한가
	' 8 : gLowPrice 			= 하한가
	' 9 : gOrderGubun 		= 주문구분
	' 10 : gCurrency			= 통화구분
	' 11 : gDecimal			= 소수점자리수
	' 12 : gCalcOrderPrice 	= 주문금액(통화)
	' 13 : gCalcOrderPriceWon 	= 주문금액(원화)
	' 14 : gExchangeRate 		= 환율
	' 15 : g_szOrdSize		= 매매단위
	' 16 : gMarketCode		= 거래소코드(4자리)
	' 17 : gTickType			= 틱타입
	'==================================================
		
	sCodeData = Split(g_szCd, "@")
	szData = sGubun												' [0]타이틀구분
	szData = szData & "|" & sCodeData[0]								' [1]시장구분(2자리)
	szData = szData & "|" & sCodeData[1]								' [2]종목코드
	szData = szData & "|" & "0"										' [3]현금/신용구분
	szData = szData & "|" & g_szCurPrice								' [4]현재가
	szData = szData & "|" & edtPrc.caption							' [5]입력가격
	szData = szData & "|" & edtQty.caption							' [6]입력수량
	szData = szData & "|" & g_szUpLimit								' [7]상한가
	szData = szData & "|" & g_szDnLimit								' [8]하한가
	szData = szData & "|" & Check_OrdType()							' [9]주문구분
	szData = szData & "|" & g_szCurrency								' [10]통화기호
	szData = szData & "|" & g_szDecimal								' [11]소수점 자리수
	szData = szData & "|" & ""										' [12]주문금액(통화)
	szData = szData & "|" & ""										' [13]주문금액(원화)
	szData = szData & "|" & LabelExchangeRate.caption					' [14]환율
	szData = szData & "|" & g_szOrdSize								' [15]매매단위
	szData = szData & "|" & g_szMk									' [16]거래소코드(4자리)
	szData = szData & "|" & g_szTickType								' [17]틱타입
	
	return szData
	
End Function
'============================================================================
' 거래소코드(4자리) <- 거래명(2자리)
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	  ' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
' 미체결내역 조회
'============================================================================
Function RequestData()
	
	Grid0.rowcount = 0
	
	DATAMANAGER.ClearInputData(0, "obtro_oder_109r")
	
	szAcno = Form.GetTopCtlProp("acnt", "total")
	szAsno = Form.GetTopCtlProp("acnt", "sequence")
	
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "ACNO"				, 0 , szAcno )
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "ASNO"				, 0 , szAsno )
	
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "CNTG_CLS_CODE"		, 0 , gCheGubun )		' (가변)체결구분코드(0:전체, 1:체결, 2:미체결)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "SELN_BYOV_CLCD"		, 0 , gOrdGubun )		' (가변)매매구분코드(0:전체, 1:매도, 2:매수)
	
	sNationInputData = GetNationInputData()
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "UI_IQRY_COND_CNTT" 	, 0 , sNationInputData ) ' (가변)국가구분코드(000:전체/840:미국/156:중국/344:홍콩/392:일본/빈값:전체)
	
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "PROS_CLS" 			, 0 , "2")			' (고정)정렬구분(1:오름차순/2:내림차순)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_109r", "InBlock1", "DATA_CLS"			, 0 , "2" )			' (고정)상품구분(1:상품/2:위탁)
	
	DATAMANAGER.RequestTranData("obtro_oder_109r")
	
End Function

'============================================================================
' 국가코드 => 국가명 가져오기
'============================================================================
Function GetCountryNameByCode(sCountryCode,sVndrCode)

	if sCountryCode = "01" then
		return "미국"
	elseif sCountryCode = "02" then
		return "홍콩"
	elseif sCountryCode = "03" then
