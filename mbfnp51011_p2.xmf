'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 약관 동의 팝업
' 02. 화면설명 : 보유주식 수익 서비스 약관 동의 팝업
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

Dim g_sRetData 					'리턴데이터
Dim g_szTheme                  		'테마구분  white/black
dim g_szUnCheckImg, g_szCheckImg	'체크이미지
dim g_szUnCheckFg, g_szCheckFg		'체크 폰트 컬러
Dim g_ChkAll						'전체동의여부
Dim g_Chk1						'첫번째 약관
Dim g_Chk2						'두번째 약관
Dim g_Chk3						'세번째 약관
Dim g_Chk4						'네번째 약관

Dim g_szINVT_FILE
Dim g_szCORE_FILE
Dim g_szPROD_FILE
Dim g_szCO_FILE
Dim g_szVNTR_FILE
Dim g_szPfinCls		'전문투자자여부
Dim g_szHgdtProdYN	'고난도상품여부
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	Select Case iIdx
		Case 1
			szTitle = "투자설명서"
		Case 2
			szTitle = "간이투자설명서"
		Case 3
			szTitle = "핵심(요약)상품설명서"
		Case 4
			szTitle = "개인 전문투자자에 대한 보호제도 미적용 확인서"
	End Select
	return szTitle
End Function

'============================================================================
'f_sGetURL(iIdx) : 각 동의체크 별 안내팝업 URL 리턴
'============================================================================
Function f_sGetURL(iIdx)		
	dim sURLheader, sURL
	If g_ServerMode == "1" Then	'개발기
		sURLheader = "http://home.imeritz.com/include/ocw/"
	Else
		sURLheader = "http://home.imeritz.com/include/ocw/"
	End If	
	
	Select Case iIdx
		Case 1
			'"'투자설명서"
			sURL = sURLheader & g_szINVT_FILE	'"meritz_yk_51.pdf"
		Case 2
			'"간이설명서"
			sURL = sURLheader & g_szCORE_FILE	'"meritz_ts_51.pdf"
		Case 3
			'"핵심(요약)상품설명서"
			sURL = sURLheader & g_szPROD_FILE	'"meritz_ts_51.pdf"		
		Case 4
			'"개인 전문투자자에 대한 보호제도 미적용 확인서"
			If g_ServerMode == "1" Then	'개발기
				sURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_dna_protect_retail-pro-investor_confirmation.html"
			else '운영
				sURL = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_dna_protect_retail-pro-investor_confirmation.html"
			end if
	End Select
	
	return sURL
End Function

'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)
	if iIdx == 0 then
		if g_szPfinCls <> "Y" then
			szURL = f_sGetURL(1) & "★" & f_sGetURL(2) & "★" & f_sGetURL(3)
			szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2) & "★" & f_sGetURLTitle(3)
		else
			szURL = f_sGetURL(1) & "★" & f_sGetURL(2) & "★" & f_sGetURL(3) & "★" & f_sGetURL(4)
			szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2) & "★" & f_sGetURLTitle(3) & "★" & f_sGetURLTitle(4)
		end if
		
		'개인전문투자자에 대한 보호제도 미적용 확인서 항목 여부
		if szPfinYN == "Y" and szClsCode == "1" and g_szHgdtProdYN == "Y" then
			szData = "Y"
		else
			szData = "N"
		end if
		
		'팝업 호출
		if szURL <> "" then
			Form.OpenPopup("mbfnp51010_p23" , szURL&"♥"&szTitle&"♥"&"N"&"♥"&szData, "")
		end if		
	else
		Form.SetSharedData("OPEN_URL", f_sGetURL(iIdx) )
		Form.OpenFramePopup("mbfnp51010_p22" , f_sGetURLTitle(iIdx), "")	
	end if
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()

	g_ChkAll = "0"	
	imgUIAllChk.imgpath = g_szUnCheckImg
	lblAllText.fgcolor  = g_szUnCheckFg			
	

	if g_Chk1 <> "1" then
		BtnContinue.enable = false
		if g_Chk2 <> "1" or g_Chk3 <> "1" or g_Chk4 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function	
	end if
	
	if g_Chk2 <> "1" then
		BtnContinue.enable = false
		if g_Chk1 <> "1" or g_Chk3 <> "1" or g_Chk4 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function	
	end if	
	
	if g_Chk3 <> "1" then
		BtnContinue.enable = false
		if g_Chk1 <> "1" or g_Chk2 <> "1" or g_Chk4 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function	
	end if
	
	if g_szPfinCls == "Y" then
		if g_Chk4 <> "1" then
			BtnContinue.enable = false
			if g_Chk1 <> "1" or g_Chk2 <> "1" or g_Chk3 <> "1" then
				imgUIAllChk.imgpath = g_szUnCheckImg
				lblAllText.fgcolor  = g_szUnCheckFg	
			end if
			Exit Function	
		end if
	end if
	
	g_ChkAll = "1"	
	imgUIAllChk.imgpath = g_szCheckImg
	lblAllText.fgcolor  = g_szCheckFg			
	
	'신청가능
	BtnContinue.enable = true
	
	'BtnContinue.imgpath = "btn_01.9"
	
End Function

'============================================================================
'각 체크 별 기능 동작
'============================================================================
Function f_SetChkState(iIdx, bValue)

	'전체동의
	if iIdx == 0 then
	
		if bValue == true then	
		
			g_ChkAll = "1"	
			imgUIAllChk.imgpath = g_szCheckImg
			lblAllText.fgcolor  = g_szCheckFg			
		
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
			
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg			
			
			g_Chk3 = "1"	
			imgUIChk2.imgpath   = g_szCheckImg
			lblChkText2.fgcolor = g_szCheckFg			
			
			if g_szPfinCls == "Y" then
				g_Chk4 = "1"	
				imgUIChk3.imgpath   = g_szCheckImg
				lblChkText3.fgcolor = g_szCheckFg	
			end if
		else
			g_ChkAll = "0"	
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg			
			
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
			
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg		
			
			g_Chk3 = "0"	
			imgUIChk2.imgpath   = g_szUnCheckImg
			lblChkText2.fgcolor = g_szUnCheckFg			
			
			g_Chk4 = "0"	
			imgUIChk3.imgpath   = g_szUnCheckImg
			lblChkText3.fgcolor = g_szUnCheckFg	
		end if	
	
	'투자설명서 동의
	elseif iIdx == 1 then
	
		if bValue == true then	
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
		else
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
		end if		
	
	'간이투자설명서 동의
	elseif iIdx == 2 then
	
		if bValue == true then	
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg
		else
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg
		end if		
		
	'핵심(요약)상품설명서 동의
	elseif iIdx == 3 then
	
		if bValue == true then	
			g_Chk3 = "1"	
			imgUIChk2.imgpath   = g_szCheckImg
			lblChkText2.fgcolor = g_szCheckFg
		else
			g_Chk3 = "0"
			imgUIChk2.imgpath   = g_szUnCheckImg
			lblChkText2.fgcolor = g_szUnCheckFg
		end if		
		
	'"개인 전문투자자에 대한 보호제도 미적용 확인서"
	elseif iIdx == 4 then
	
		if bValue == true then	
			g_Chk4 = "1"	
			imgUIChk3.imgpath   = g_szCheckImg
			lblChkText3.fgcolor = g_szCheckFg
		else
			g_Chk4 = "0"
			imgUIChk3.imgpath   = g_szUnCheckImg
			lblChkText3.fgcolor = g_szUnCheckFg
		end if	
	end if
	
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()	
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	g_szUnCheckImg 	= "icon_chk_on.png"
	g_szCheckImg 		= "icon_chk_off.png"
	g_szUnCheckFg 	= "127"
	g_szCheckFg 		= "4"	
End Sub


'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동Y
	'부모창(mbonl88024) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_AcntNo 		= tData[0]
		g_AcntSeq 		= tData[1]
		g_szShortCd		= tData[2]
	
		DATAMANAGER.RequestTranData("obsim_idmn_080r")	'약관 파일목록조회
		DATAMANAGER.RequestTranData("obsim_idmn_018r")	
		
	end if
	
'	g_AcntNo 		= "18057949"	'tData[0]
'	g_AcntSeq 		= "11"		'tData[1]
'	g_szShortCd		= "203672"	'tData[2]
'		
'	DATAMANAGER.RequestTranData("obsim_idmn_080r")	'약관 파일목록조회

	'초기화..	
	f_SetChkState(0, false)	
	
	g_sRetData = "cancel"
	
	'신청가능
	BtnContinue.enable = false	

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbfnp51010_p22" then
		If sRet == "투자설명서" Then
			f_SetChkState(1, true)
		ElseIf sRet == "간이투자설명서" Then
			f_SetChkState(2, true)
		ElseIf sRet == "핵심(요약)상품설명서" Then
			f_SetChkState(3, true)
		ElseIf sRet == "개인 전문투자자에 대한 보호제도 미적용 확인서" Then
			f_SetChkState(4, true)
		End If

	elseif sKeyName == "mbfnp51010_p23" then	'전체동의
		if sRet == "AGREE" then		
			f_SetChkState(0, true)
		elseif sRet == "cancel" then	
			f_SetChkState(0, false)
		end if			
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID =	"obsim_idmn_080r" then
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "ISCD"				, 0, g_szShortCd	)
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "MFI_ATCH_FILE_CLCD" 	, 0, "%"			)
	elseif	szTranID	=	"obcsb_acif_791r"	then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_791r", "InBlock1", "ACNO"				, 0, g_AcntNo)
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	if	szTranID ==	"obsim_idmn_080r" then
		g_szINVT_FILE 	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_INVT_ATCH_FILE_ORTX_NAME", 0)	'투자설명서 파일명
		g_szCORE_FILE 	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CORE_ATCH_FILE_ORTX_NAME", 0)	'간이설명서 파일명
		g_szPROD_FILE		=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_PROD_ATCH_FILE_ORTX_NAME", 0)	'UI상품첨부파일원본명
		g_szCO_FILE	 	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CO_ATCH_FILE_ORTX_NAME", 0)		'벤처저축약관 파일명
		g_szVNTR_FILE 	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_VNTR_FILE_ORTX_NAME", 0)		'벤처핵심설명서 파일명		 	 
	elseif szTranID	=	"obcsb_acif_791r"	then				'펀드매매, ELS, DLS 일시
		szPfinYN	 	=	DATAMANAGER.GetDataValue(0,"obcsb_acif_791r", "OutBlock1", "UI_PFIN_YN", 0)		'전문투자자여부
		szClsCode 	=	DATAMANAGER.GetDataValue(0,"obcsb_acif_791r", "OutBlock1", "CUST_CLS_CODE", 0)	'고객구분코드
		
		if szPfinYN == "Y" and szClsCode == "1" and g_szHgdtProdYN == "Y" then
			Form.SetCtlProp("lblChkText3", "visible", true)
			Form.SetCtlProp("imgUIChk3", "visible", true)
			Form.SetCtlProp("imgChk3", "visible", true)
			
			g_Chk4 = "0"
			g_szPfinCls = "Y"
		else
			g_Chk4 = "1"
			g_szPfinCls = "N"
		end if
	elseif szTranID	=	"obsim_idmn_018r"	then			
		g_szHgdtProdYN	 	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_018r", "OutBlock5", "HGDT_PROD_YN", 0)		'고난도상품여부
		
		DATAMANAGER.RequestTranData("obcsb_acif_791r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub

'============================================================================
Sub BtnContinue_OnClick()
	'Form.OpenNextPopup("mbonl88024_p6", "88024", "")
	
	if g_Chk1 = "1" and g_Chk2 = "1" and g_Chk3 = "1" then
		g_sRetData = "ok"			
	else
		g_sRetData = "cancle"		
	end if 
	
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbfnp51011_p2" , g_sRetData )	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 투자설명서 띄움
'============================================================================
Sub imgChk0_OnClick()	
	if CInt(g_Chk1) == 1 then
		f_SetChkState(1, false)
	else
		f_OpenChkPopup(1)
	end if		
End Sub

'============================================================================
' 간이투자설명서 띄움
'============================================================================
Sub imgChk1_OnClick()	
	if CInt(g_Chk2) == 1 then
		f_SetChkState(2, false)
	else
		f_OpenChkPopup(2)
	end if	
End Sub

'============================================================================
' 핵심(요약)상품설명서 띄움
'============================================================================
Sub imgChk2_OnClick()	
	if CInt(g_Chk3) == 1 then
		f_SetChkState(3, false)
	else
		f_OpenChkPopup(3)
	end if	
End Sub

'============================================================================
' 개인 전문투자자에 대한 보호제도 미적용 확인서 띄움
'============================================================================
Sub imgChk3_OnClick()	
	if CInt(g_Chk4) == 1 then
		f_SetChkState(4, false)
	else
		f_OpenChkPopup(4)
	end if	
End Sub

'============================================================================
' 필수약관에 모두 동의 클릭
'============================================================================
Sub btnAllChk_OnClick()
	if CInt(g_ChkAll) == 1 then
		f_SetChkState(0, false)		
	else
		f_OpenChkPopup(0)
	end if		
End Sub

