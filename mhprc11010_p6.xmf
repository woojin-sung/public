Sub Form_OnFormInitBefore()
	Container0.ChartEx0.setChartType("minibong")
	
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> "" and szOpenData <> null then
		listInfo = Split ( szOpenData, "★" , 0 , 0 )
		
		if ( #listInfo == 1 ) then
			exit sub
		end if
		
		g_szRSelect	= listInfo[0] '0:현재가/1:예상가/2:단일가 구분
		g_szScreenNum = listInfo[1] 'CFD 화면 예외 처리에 사용
		g_szCode		= listInfo[2]
		g_nYPos	 	= Int(listInfo[3])
		g_nHeight	 = Int(listInfo[4])
		g_sPopupType	= listInfo[5]
		g_szMarket  	= listInfo[6]
		
		dim ostype
		ostype = Form.GetSharedData("&OS_TYPE", 0 )
		
'		if ostype == "2" then
'			Container0.top = 91
'		end if
		
		f_SetUI()
		f_RequestTran()
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1020_001r"
		or szTranID == "ohhts_1020_001r_1"
		or szTranID == "ohhts_1020_001r_2"then
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               0, g_szCode )
	
	elseif szTranID == "ohhts_5010_001r" then	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               0, g_szCode )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_ISCD",               0, g_szCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE",  0, "Y")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))	
	
	elseif szTranID == "ohhts_news_001r" then	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
		'20210622 LES START
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_NEW_INPUT_ISCD", 0 , g_szCode )
		'20210622 LES END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_1020_001r"
		or szTranID == "ohhts_1020_001r_1"
		or szTranID == "ohhts_1020_001r_2" then
		
		'시고저 SET START
		g_nPrePrc = CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_PRDY_CLPR", 0 ))
		
		dim nPrePrc
		nPrePrc = g_nPrePrc
		
		if nPrePrc <> "" or nPrePrc <> null then
			Dim nStartPrc, nHighPrc, nLowPrc
			Dim nStartRate, nHighRate, nLowRate
			
			if szTranID == "ohhts_1020_001r" or szTranID == "ohhts_1020_001r_1" then
				nStartPrc 	= CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_CPRC", 0 ))
				nHighPrc 	= CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_HPRC", 0 ))
				nLowPrc 		= CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_LPRC", 0 ))
			elseif szTranID == "ohhts_1020_001r_2" then '시간외
				nStartPrc 	= CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_OVTM_UNTP_OPRC", 0 ))
				nHighPrc 	= CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_OVTM_UNTP_HPRC", 0 ))
				nLowPrc 		= CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_OVTM_UNTP_LPRC", 0 ))
			end if
			
			if nPrePrc == 0 then
				nStartRate = 0
				nHighRate = 0
				nLowRate = 0
				
			else
				nStartRate = (nStartPrc/nPrePrc * 100) - 100
				nHighRate = (nHighPrc/nPrePrc * 100) - 100
				nLowRate = (nLowPrc/nPrePrc * 100) - 100
				
			end if
			
			Container0.Table1.SetCellString( 0, 2, FormatNumber(nStartRate,2) )
			Container0.Table1.SetCellString( 1, 2, FormatNumber(nHighRate,2) )
			Container0.Table1.SetCellString( 2, 2, FormatNumber(nLowRate,2) )
			
		end if
		'시고저 SET END
		
		'마진률 SET START
		Dim szState, nRate
		szState = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_ISSU_STAT_CLCD", 0 ))
		nRate = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_MARG_RATE", 0 ))
		
		g_szMargState = szState
		
		if szState <> "" and szState <> null then
			SetMarginRate( szState, nRate )
		end if
		'마진률 SET END
		
		Set_Real_Input(g_szMarket, 0, g_szCode)
		Real_RequestData()
		
	elseif szTranID == "ohhts_news_001r" then
		dim sTitle, sDate
		sTitle = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_TITL", 0 )
		
		sDate = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_DATE", 0 )
		sDate = RIGHT(sDate, 4)
		sDate = "[" & LEFT(sDate, 2) & "/" & RIGHT(sDate, 2) & "]"
		
		Container0.grdNews.SetCellData( "bd_cell0", 0, sTitle )
		Container0.grdNews.SetCellData( "bd_cell1", 0, sDate )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
'	 if szTranID == "ohhts_1020_001r" then
'		 DATAMANAGER.SetDataAttr( 0, szTranID , "OutBlock1", "FID_CNCN_PRDY_VRSS_VOL_RATE", 0, "0" )
'	 end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_stck_cntg" or szTranID == "ohhts_futs_cntg" or szTranID == "ohhts_optn_cntg" or szTranID == "ohhts_nmix_cntg" or
		szTranID == "ohhts_frbr_cntg" or szTranID == "ohhts_elw_cntg" or szTranID == "ohhts_bond_cntg" or szTranID == "ohhts_ovrs_nmix" or
		szTranID == "ohhts_nfut_cntg" or szTranID == "ohhts_exrt_cntg" or szTranID == "ohhts_sfut_cntg" or szTranID == "ohhts_sopt_cntg" or
		szTranID == "ohhts_ovtp_cntg" then
			
			dim nPrePrc
			nPrePrc = g_nPrePrc
			
			if nPrePrc <> "" or nPrePrc <> null then
				Dim nStartPrc, nHighPrc, nLowPrc
				Dim nStartRate, nHighRate, nLowRate
				
				if szTranID == "ohhts_stck_cntg" then
					
					nStartPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "RLTM_OPRC", 0 ))
					nHighPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "RLTM_HPRC", 0 ))
					nLowPrc 		= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "RLTM_LPRC", 0 ))
				
				elseif szTranID == "ohhts_frbr_cntg" or szTranID == "ohhts_elw_cntg" or szTranID == "ohhts_sfut_cntg" 
						or szTranID == "ohhts_sopt_cntg" or szTranID == "ohhts_ovtp_cntg" then
					
					nStartPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_OPRC", 0 ))
					nHighPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_HPRC", 0 ))
					nLowPrc 		= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_LPRC", 0 ))
					
				elseif szTranID == "ohhts_exrt_cntg" then
					
					nStartPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_EXRT_OPRC", 0 ))
					nHighPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_EXRT_HPRC", 0 ))
					nLowPrc 		= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_EXRT_LPRC", 0 ))
					
				elseif szTranID == "ohhts_futs_cntg" or szTranID == "ohhts_optn_cntg" or szTranID == "ohhts_nmix_cntg" or 
						szTranID == "ohhts_bond_cntg" or szTranID == "ohhts_ovrs_nmix" or szTranID == "ohhts_nfut_cntg" then
					
					nStartPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_OPRC2", 0 ))
					nHighPrc 	= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_HPRC2", 0 ))
					nLowPrc 		= CDbl(DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_LPRC2", 0 ))
				
				end if
				
				if nPrePrc == 0 then
					nStartRate = 0
					nHighRate = 0
					nLowRate = 0
				
				else
					nStartRate = (nStartPrc/nPrePrc * 100) - 100
					nHighRate = (nHighPrc/nPrePrc * 100) - 100
					nLowRate = (nLowPrc/nPrePrc * 100) - 100
					
				end if
				
'				Form.ShowAlert(szTranID, nStartRate & "/" & nHighRate & "/" & nLowRate )
				Container0.Table1.SetCellString( 0, 2, FormatNumber(nStartRate,2) )
				Container0.Table1.SetCellString( 1, 2, FormatNumber(nHighRate,2) )
				Container0.Table1.SetCellString( 2, 2, FormatNumber(nLowRate,2) )
				
			end if
			
			
	elseif szTranID == "ohhts_marg_rate" then
		'마진률 SET START
		Dim nRate
		nRate = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FIDR_MARG_RATE", 0 ))
		
		if szState <> "" and szState <> null then
			SetMarginRate( g_szMargState, nRate )
		end if
		'마진률 SET END
	end if
End Sub

'============================================================================
Sub Container0_lblMovePrc_OnClick()
	f_MovePrc()
End Sub

'============================================================================
Sub Container0_lblMoveChart_OnClick()
	f_MoveChart()
End Sub

'============================================================================
Sub Container0_lblMoveNews_OnClick()
	f_MoveNews()
End Sub

'============================================================================
Sub Container0_grdNews_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell0" or szCellID == "bd_cell1" then
		f_MoveNews()
	end if
End Sub

'============================================================================
Sub Container0_Button0_OnClick()
	f_MoveBtn0()
End Sub

'============================================================================
Sub Container0_Button1_OnClick()
	f_MoveBtn1()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	f_CancelRealData()
End Sub



