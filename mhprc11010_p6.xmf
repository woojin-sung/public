'============================================================================
' f_SaveGrdPos : 그리드 위치 저장
'============================================================================
Function f_SaveGrdPos() 
	szSaveData = Form.GetSharedData("PRE_GWAN_GRID_POS", true)
	szSaveData = g_szRSelect .. "|" .. szSaveData .. "|" .. g_nYPos .. "|" .. g_nHeight
	Form.SetSharedData("PRE_GWAN_GRID_POS" , szSaveData)
End Function

