'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCode, g_szMarket, g_szScreenNum, g_szRSelect
Dim g_ButtonScreen0, g_ButtonScreen1
Dim g_nPrePrc, g_szMargState '전일종가, 마진상태
Dim g_nYPos, g_nHeight

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_SetUI :  마켓 종류별 UI SET
'============================================================================
Function f_SetUI()
	Select Case g_szMarket
		Case "J", "Q", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW, ' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
			Container0.Button0.btnimage = "btn_etc11.9.png"
			Container0.Button1.btnimage = "btn_etc10.9.png"
			
			Container0.Button0.caption = "매도"
			Container0.Button1.caption = "매수"
			
			if g_szMarket == "F" or g_szMarket == "MF" or g_szMarket == "O"  
				or g_szMarket == "MO" or g_szMarket == "MF" or g_szMarket == "XF" 
				or g_szMarket == "WO" then
				
				Container0.ChartEx0.SetMarketCategory("3") 'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
				Container0.ChartEx0.setDecimal("2") ' 소수점 2자리
				
				Container0.grdNews.visible = false
			end if 
			
		Case "U"	' 업종코드
			Container0.ChartEx0.SetMarketCategory("1")		   'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
			Container0.ChartEx0.SetLoadChart("jisu")
			
			'현재가 버튼 안보임 처리
			Container0.Image1.visible = false
			Container0.lblMovePrc.visible = false
			
			Container0.Button0.btnimage = "btn_28.9"
			Container0.Button1.btnimage = "btn_28.9"
			
			Container0.Button0.caption = "지수상세"
			Container0.Button1.caption = "지수종목"
			
			Container0.Button0.fgcolor = "4"
			Container0.Button1.fgcolor = "4"
			
			Container0.grdNews.visible = false
			
		Case "N", "EN", "FN"				' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
			Container0.ChartEx0.SetMarketCategory("1")		   'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
			Container0.ChartEx0.SetLoadChart("global")
			
			'해외환율일때 소수점 4자리로 160422 KMC 추가
			if g_szMarket == "EN" then
				Container0.ChartEx0.setDecimal("4") ' 소수점 4자리
			else
				Container0.ChartEx0.setDecimal("2") ' 소수점 2자리
			end if
			
			'현재가 버튼 안보임 처리
			Container0.Image1.visible = false
			Container0.lblMovePrc.visible = false
			
			'차트 버튼 안보임 처리
			Container0.Image2.visible = false
			Container0.lblMoveChart.visible = false
			
			Container0.Button0.btnimage = "btn_28.9"
			Container0.Button1.btnimage = "btn_28.9"
			
			Container0.Button0.caption = "해외지수"
			Container0.Button1.caption = "해외차트"
			
			Container0.Button0.fgcolor = "4"
			Container0.Button1.fgcolor = "4"
			
			Container0.grdNews.visible = false
			
		Case "B" '채권
			Container0.Button0.btnimage = "btn_etc11.9.png"
			Container0.Button1.btnimage = "btn_etc10.9.png"
			
			Container0.Button0.caption = "매도"
			Container0.Button1.caption = "매수"
		
			'차트 버튼 안보임 처리
			Container0.Image2.visible = false
			Container0.lblMoveChart.visible = false
			
			Container0.grdNews.visible = false
	End Select
End Function

'============================================================================
' f_RequestTran : 조회 데이터 요청
'============================================================================
Function f_RequestTran()
	if g_szRSelect == "0" then '현재가
		DATAMANAGER.RequestTranData( "ohhts_1020_001r" )
	elseif g_szRSelect == "1" then '예상가
		DATAMANAGER.RequestTranData( "ohhts_1020_001r_1" )
	elseif g_szRSelect == "2" then '단일가
		DATAMANAGER.RequestTranData( "ohhts_1020_001r_2" )
	end if
	
	DATAMANAGER.RequestTranData( "ohhts_5010_001r" )
	DATAMANAGER.RequestTranData( "ohhts_news_001r" )
End Function

'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]
		Case "J", "Q"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(예상가)
'				DATAMANAGER.SetDataValue(1, "ohhts_antc_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)
			elseif g_szRSelect == "2" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 시간외단일호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			elseif g_szRSelect == "1" then
				DATAMANAGER.SetDataValue(1, "ohhts_futs_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 예상체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			end if 
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)				
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동				
			elseif g_szRSelect == "1" then	
				DATAMANAGER.SetDataValue(1, "ohhts_optn_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 예상체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동	
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			end if 
		' [[ 업종코드	]]
		Case "U"					
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_antg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 예상체결 자동갱신										
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
			end if 
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"					
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신
			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 시간외단일호가 자동갱신
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]
		Case "W"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신			
				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(예상가)
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"					
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_aspr", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]
		Case "FN"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외선물 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외선물 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]	
		Case "EN"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 
		' [[ 주식선물 ]]	 2018.01.02 CJH 추가
		Case "JF"		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_sfut_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 예상체결
			end if 
		' [[ 주식옵션 ]]	 2018.01.02 CJH 추가
		Case "JO"		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식옵션 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_sopt_antg", "InBlock1", nIdx, szCd)			' 주식옵션 예상체결
			end if
			
'		' [[ 주식선물/선물 스프레드, 주식옵션, 상품선물/금리선물/통화선물, 상품옵션, 코스피200 변동성지수 선물/선물스프레드, 섹터지수 선물/선물스프레드 ]]
'		Case "JF", "JO", "CF", "CO", "VF", "KF"
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 		
'			end if 
	End Select
	
	DATAMANAGER.SetDataValue(1, "ohhts_marg_rate", "InBlock1", "FIDR_SHRN_ISCD", 0, szCd)		'마진
	
End Function

'============================================================================
' Real_RequestData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Real_RequestData()
	Select Case g_szMarket
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]	
		Case "J", "Q"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then	
				DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' 주식호가 자동갱신(예상가)
			elseif g_szRSelect == "2" then
				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
			end if
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
			elseif g_szRSelect == "1" then
				DATAMANAGER.RequestRealData("ohhts_futs_antg")		' 선물 예상체결 자동갱신
			end if 
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)		
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
			elseif g_szRSelect == "1" then	
				DATAMANAGER.RequestRealData("ohhts_optn_antg")		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]				
		Case "U"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신			end if
			end if
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
			elseif g_szRSelect == "1" then
				DATAMANAGER.RequestRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]		
		Case "W"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
			elseif g_szRSelect == "1" then
				DATAMANAGER.RequestRealData("ohhts_elw_aspr")			' ELW호가 자동갱신
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]			
		Case "FN"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]				
		Case "EN"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if	
		' [[ 주식선물	]]	2018.01.02 CJH 추가		
		Case "JF"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_sfut_cntg")		' 주식선물 체결			
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_sfut_antg")		' 주식선물 예상체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_aspr")		' 옵션 호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발
			end if 
		' [[ 주식옵션	]]	2018.01.02 CJH 추가		
		Case "JO"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_sopt_cntg")		' 주식옵션 체결			
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_sopt_antg")		' 주식옵션 예상체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_aspr")		' 옵션 호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발
			end if 
			
'		' [[ 주식선물/선물 스프레드, 주식옵션, 상품선물/금리선물/통화선물, 상품옵션, 코스피200 변동성지수 선물/선물스프레드, 섹터지수 선물/선물스프레드 ]]
'		Case "JF", "JO", "CF", "CO", "VF", "KF"
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("")		' 
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("")		' 
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.RequestRealData("")		' 		
'			end if  			
	End Select
	
	DATAMANAGER.RequestRealData( "ohhts_marg_rate" )
	
End Function

'============================================================================
' f_CancelRealData : 실시간 연결 끊기
'============================================================================
Function f_CancelRealData()
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_stck_aspr")		' 주식호가 자동갱신(예상가)
	DATAMANAGER.CancelRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_futs_antg")		' 선물 예상체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_optn_antg")		' 옵션 예상체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_elw_aspr")			' ELW호가 자동갱신
	DATAMANAGER.CancelRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")		' 주식선물 체결			
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")		' 주식옵션 체결			
	DATAMANAGER.CancelRealData( "ohhts_marg_rate" )
End Function

'============================================================================
' SetMarginRate
'============================================================================
Function SetMarginRate( szStateCode, nMARG_RATE )
	'20210823 HSZ START : CFD현재가 화면 추가
'	if g_szScreenNo = "13100" or g_szScreenNo = "13200" then
'		exit function 
'	end if
	'20210823 HSZ END
	
	Dim 	szItemCodeInfo, nColorValue
	
	Select Case szStateCode
		Case "51"	
			szItemCodeInfo = "관" + nMARG_RATE + "%"		'관심종목
			nColorValue = 131
		Case "52"
			szItemCodeInfo = "위" + nMARG_RATE + "%"		'투자위험
			nColorValue = 131
		Case "53"		
			szItemCodeInfo = "경" + nMARG_RATE + "%"		'투자경고
			nColorValue = 131
		Case "54"
			szItemCodeInfo = "주" + nMARG_RATE + "%"		'투자주의
			nColorValue = 131
		Case "55"
			szItemCodeInfo = "신" + nMARG_RATE + "%"		'신용주문가능
			nColorValue = 133
		Case "56"
			szItemCodeInfo = "신" + nMARG_RATE + "%"		'신용초과
			nColorValue = 13
		Case "57"		
			szItemCodeInfo = "증" + nMARG_RATE + "%"		'증거금율
			nColorValue = 128
		Case "58"		
			szItemCodeInfo = "정" + nMARG_RATE + "%"		'거래정지
			nColorValue = 130
		Case "61"
			szItemCodeInfo = "정" + nMARG_RATE + "%"		'정리매매
			nColorValue = 130
		Case "63"
			szItemCodeInfo = "과" + nMARG_RATE + "%"		'단기과열
			nColorValue = 131
		Case "64"
			szItemCodeInfo = "환" + nMARG_RATE + "%"		'투자주의환기
			nColorValue = 131
		
		'20200831 LES START 제도개선
		Case "65"
			szItemCodeInfo = "유" + nMARG_RATE + "%"		'투자유의
			nColorValue = 131
		'20200831 LES END
			
	End Select
	
	Container0.Label1.caption = szItemCodeInfo
	Container0.Label1.fgcolor = nColorValue
	
	
End Function

'============================================================================
' f_MovePrc : 현재가 이동
'============================================================================
Function f_MovePrc()
	f_SaveGrdPos() 
	Select Case g_szMarket
		Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			if g_szScreenNum == "13101" then 'CFD 예외 처리
				Form.OpenScreen("13100", g_szCode)
			else
				Form.OpenScreen("11000", g_szCode)
			end if
			
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
			Form.OpenScreen("31000", g_szCode)		
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54010", "관심종목★" & g_szCode & "★" )
	End Select

End Function

'============================================================================
' f_MoveChart : 차트 이동
'============================================================================
Function f_MoveChart()
	f_SaveGrdPos() 
	
	Select Case g_szMarket
		Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			Form.OpenScreen("13000", g_szCode)
						
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
				Form.OpenScreen("31020", g_szCode)
		Case "U"						' 업종코드
				Form.OpenScreen("42030", g_szCode)
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54010", "관심종목★" & g_szCode & "★" )
	End Select
End Function

'============================================================================
' f_MoveNews : 뉴스 이동
'============================================================================
Function f_MoveNews()
	f_SaveGrdPos() 
	
	dim szSendCode
	szSendCode = ""
	
	Select Case g_szMarket
		Case "J", "Q", "T", "W" ' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			szSendCode = g_szCode
	End Select
	
	Form.OpenScreen("44000", szSendCode)' 뉴스
End Function

