'===========================================================================
' 2019.05.15 : 이현우 : 일본시장 추가
' 2020.04.17 : 이현우 : 고유MTS 개발
' 2024.03.20 : 장시방 : v001 : 스위스 시장코드 추가
'===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szFncd
Dim g_szSta_Date
Dim g_szFin_Date
Dim g_NextCnt
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName = "REQUEST" Then
		if sParam <> null then
			g_szFncd = sParam
			g_NextCnt = 0
			'펀드코드 계좌조회
			DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
		end if
	End if

End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	End If
	
	if szTranID = "obtro_oder_302r" then
		
		g_szSta_Date = Calendar0.caption
		g_szFin_Date = Calendar1.caption
		
		if rdoType.currentindex = "0" then
			g_szCntgType = "0"
		elseif rdoType.currentindex = "1" then
			g_szCntgType = "1"
		else
			g_szCntgType = "2"
		end if
		
		if rdoType2.currentindex = "0" then
			g_szDealType = "0"
		elseif rdoType2.currentindex = "1" then
			g_szDealType = "2"
		elseif rdoType2.currentindex = "2" then
			g_szDealType = "1"
		end if
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "ACNO" 					 , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "ASNO" 					 , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "ODER_STA_DATE" 			 , 0 , g_szSta_Date)
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "ODER_FIN_DATE" 			 , 0 , g_szFin_Date)
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , "00")
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "ISCD" 					 , 0 , "%")
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "CNTG_CLS_CODE"			 , 0 , g_szCntgType)
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "SELN_BYOV_CLCD"			 , 0 , g_szDealType)
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "SORT_CLS" 				 , 0 , "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_302r", "InBlock1", "DATA_CLS" 				 , 0 , "1")
		
	end if
End Sub
