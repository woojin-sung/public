'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		'해외주식 고유 일별체결내역 호출
		DATAMANAGER.RequestTranData("obtro_oder_302r")
	end if
	
	if szTranID = "obtro_oder_302r" then
		
		nCount = DATAMANAGER.GetDataCount( false, "obtro_oder_302r", "OutBlock1" )
		
		nIndex = tonumber(grd0.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount-1
			
				deal_cls_code   = grd0.GetCellData("bd_cell1", nIndex+i)
				deal_cls_name   = ""
				nation		  = grd0.GetCellData("bd_cell21", nIndex+i)
				oder_condition  = grd0.GetCellData("bd_cell8", nIndex+i)
				oder_prc		  = Cstr(grd0.GetCellData("bd_cell6", nIndex+i))
				cntg_prc		  = Cstr(grd0.GetCellData("bd_cell7", nIndex+i))
				rctf_cncl_cls_code = grd0.GetCellData("bd_cell12", nIndex+i)
				
				iscd			= grd0.GetCellData("bd_cell3", nIndex+i)
				exch			= right(iscd,2)
							
				if deal_cls_code = "1" then 					'매도
					deal_cls_name = "매도"
					grd0.SetCellFgColor("bd_cell1", nIndex+i, "11")
				elseif deal_cls_code = "2" then 				'매수
					deal_cls_name = "매수"
					grd0.SetCellFgColor("bd_cell1", nIndex+i, "10")			
				end if
				
				if rctf_cncl_cls_code = "1" then
					deal_cls_name = deal_cls_name & "정정"				
				elseif rctf_cncl_cls_code = "2" then
					deal_cls_name = deal_cls_name & "취소"
				else
					deal_cls_name = deal_cls_name
				end if
				
				grd0.SetCellData("bd_cell1", nIndex+i, deal_cls_name)
				
				if nation = "01" then
					grd0.SetCellData("bd_cell11", nIndex+i, "미국")
				elseif nation = "02" then
					grd0.SetCellData("bd_cell11", nIndex+i, "홍콩")
				elseif nation = "03" then
					grd0.SetCellData("bd_cell11", nIndex+i, "중국")
				elseif nation = "04" then
					grd0.SetCellData("bd_cell11", nIndex+i, "중국")
				elseif nation = "05" then
					grd0.SetCellData("bd_cell11", nIndex+i, "일본")
				elseif nation = "07" then
					grd0.SetCellData("bd_cell11", nIndex+i, "싱가포르")
				elseif nation = "08" then '2020.11.05 유로국가 추가
					grd0.SetCellData("bd_cell11", nIndex+i, "영국")			
				elseif nation = "09" then
					grd0.SetCellData("bd_cell11", nIndex+i, "영국")			
				elseif nation = "10" then
					grd0.SetCellData("bd_cell11", nIndex+i, "독일")			
				elseif nation = "11" then
					grd0.SetCellData("bd_cell11", nIndex+i, "핀란드")
				elseif nation = "12" then
					grd0.SetCellData("bd_cell11", nIndex+i, "프랑스")			
				elseif nation = "13" then
					grd0.SetCellData("bd_cell11", nIndex+i, "벨기에")			
				elseif nation = "14" then
					grd0.SetCellData("bd_cell11", nIndex+i, "네덜란드")
				elseif nation = "15" then
					grd0.SetCellData("bd_cell11", nIndex+i, "포르투갈")
				elseif nation = "16" then
					grd0.SetCellData("bd_cell11", nIndex+i, "그리스")
				elseif nation = "17" then
					grd0.SetCellData("bd_cell11", nIndex+i, "아일랜드")
				elseif nation = "18" then
					grd0.SetCellData("bd_cell11", nIndex+i, "이탈리아")
				elseif nation = "19" then
					grd0.SetCellData("bd_cell11", nIndex+i, "스페인")			
				elseif nation = "20" then
					grd0.SetCellData("bd_cell11", nIndex+i, "오스트리아")					
				elseif nation = "21" then
					grd0.SetCellData("bd_cell11", nIndex+i, "캐나다")
				elseif nation = "23" then
					grd0.SetCellData("bd_cell11", nIndex+i, "인도네시아")
				elseif nation = "24" then
					grd0.SetCellData("bd_cell11", nIndex+i, "베트남")
				elseif nation = "25" then
					grd0.SetCellData("bd_cell11", nIndex+i, "베트남")
				elseif nation = "26" then
					grd0.SetCellData("bd_cell11", nIndex+i, "스위스") 'v001
				end if
					
				grd0.SetCellData("bd_cell6", nIndex+i , FormatNumber(oder_prc,4))	
				grd0.SetCellData("bd_cell7", nIndex+i , FormatNumber(cntg_prc,4))			
	
				if oder_condition = "0" then
					grd0.SetCellData("bd_cell8", nIndex+i, "정상")
				elseif oder_condition = "1" then
					grd0.SetCellData("bd_cell8", nIndex+i, "거부")
				elseif oder_condition = "2" then
					grd0.SetCellData("bd_cell8", nIndex+i, "자동거부")
				elseif oder_condition = "3" then
					grd0.SetCellData("bd_cell8", nIndex+i, "자동취소(체결후)")
				elseif oder_condition = "4" then
					grd0.SetCellData("bd_cell8", nIndex+i, "미접수")
				end if
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
End Sub
'============================================================================
Sub grd0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obtro_oder_302r" ) then
		DATAMANAGER.RequestNextData( "obtro_oder_302r" )
	end if
End Sub
