Sub BtnNext_OnClick()
'	If chk_ContReg1Val() == False Then
'		ContMain.scroll_pos = 0
'		Exit Sub
'	End If
	
	'실제소유자 체크
	If ContMain.RadioGroup0.currentindex == "-1" or ContMain.RadioGroup0.currentindex == -1 Then
		ContMain.RadioGroup0.SetResultLabel("1", "error","실제소유자가 아닌 경우에는 계좌개설이 불가합니다.","ContMain")
		Exit Sub
	End If 
	
	If getDataAcntopngclcd == "1" Then '신규종합
		'해외납세자 구분
		If ContMain.RadioGroup1.currentindex == "-1" or ContMain.RadioGroup1.currentindex == -1 Then
			ContMain.RadioGroup1.SetResultLabel("1", "error","해외납세자는 가까운 영업점을 내방하시어\n 계좌 개설해 주시기 바랍니다.","ContMain")
			Exit Sub
		End If 
	End If 
	
	'***********************************************************************************
	'신규종합: 비밀번호 입력/재입력(mbbdm85160) 처리 후 3단계 완료처리(obaci_acct_049c)
	'개별추가: 3단계 완료처리(obaci_acct_049c)
	'***********************************************************************************
	Call AML_DATA_Setting()
	Call SetSharedData_Setting()
	
'	'getDataAcntopngclcd = "1" 	' >>>> test
'	If getDataAcntopngclcd == "1" Then '신규종합
'		
'		'20210308 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
'		CloseFlag = 1 '비밀번호 등록
'		Form.OpenNextPopup("mbbdm85160" , "" , "")
'		'Form.CloseForm()
'		'20210308 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
'		
'	ElseIf getDataAcntopngclcd == "2" Then '개별추가
'		'이어가기 내역 처리
'		'2021.04.05. 고객정보내역 입력값체크 obaci_acct_049c "B" 호출하면서 위치 변경 (before)
'		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 		, 0 , gPageID				     ) '등록단계구분코드
'		DATAMANAGER.RequestTranData("obaci_acct_049c")	
'	End If 
	
	'카카오뱅크 후속절차 처리
	DATAMANAGER.RequestTranData( "obaci_acct_301a" )
	
End Sub

