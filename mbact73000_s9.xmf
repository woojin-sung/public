Function SetFrame(sNewYN)
	If sNewYN == "2" Then '개별추가
		ContMain.CmbJob.top    = 295-80 'ContMain.CmbJob.top    - 80 'tmpCmbJobSize
		ContMain.LabelOccu.top = 400-80 'ContMain.LabelOccu.top - 80 'tmpCmbJobSize
		ContMain.BtnOccu.top   = 379-80 'ContMain.BtnOccu.top   - 80  'tmpCmbJobSize
