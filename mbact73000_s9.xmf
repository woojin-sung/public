'===========================================================================
' SetSharedData_Setting 고객정보 입력_고객확인의무 (mbbdm10051)
'===========================================================================
Function SetSharedData_Setting()

	Form.SetSharedData( "BDM_AMLPRODCODE"     , gAmlProdCode     ) 'AML상품코드
	Form.SetSharedData( "BDM_OCPTCODE"        , gOcptCode        ) '직업
	Form.SetSharedData( "BDM_AMLOCKNLRDVCODE" , gAmlOcknLrdvCode ) '직종대분류
	Form.SetSharedData( "BDM_AMLOCKNSMDVCODE" , gAmlOcknSmdvCode ) '직종소분류
	Form.SetSharedData( "BDM_EDDTROBJTCODE"   , gEddTrObjtCode   ) '거래목적
	Form.SetSharedData( "BDM_EDDTRFNDSORCCODE", gEddTrFndsSorcCode ) '자금의원천
	Form.SetSharedData( "BDM_AMLOcknName"     , gAmlOcknName     ) '직종명
	

End Function 

