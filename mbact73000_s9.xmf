Sub Image1_OnClick()
	Form.MsgBox("알림", "이용 등록을 중단하시겠습니까?\n(중단하시는 경우 처음부터 다시 진행 하셔야 합니다.)", "Exit", 1)
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID == "2" or sTimerID == 2 then
	
		Form.SetTimerEvent2(sTimerID, 0, 0.1)		
		
		'20210308 김유경 calcUnResize 로직 추가
		ContMain.scroll_pos = Cint(Form.calcUnResize(ContMain.CmbMoney.top ,"1" ))' - 60
		ContMain.CmbMoney.visible = true
		'20210308 김유경 calcUnResize 로직 추가
		
	ElseIf sTimerID == "3" or sTimerID == 3 then
		'Form.SetTimerEvent2(sTimerID, 0, 0.7)
		ContMain.SetScrollAutoSize()
		BtnNext.visible = True
		
	ElseIf sTimerID = "10" or sTimerID = 10 then
		Form.SetTimerEvent2(10, 0, 0.8)
		If sRevData <> "StepBack" then
			'2021.04.29. 김유경.선택된 후에는 자동으로 열리지 않도록 수정
			If Trim(ContMain.CmbJob.caption) == "직업을 선택해주세요." Then 
		
				ContMain.CmbJob.Setstatus("focus")
				Form.SetTimerEvent2(14, 1, 0.2)
			End If 
		End  If		

	ElseIf sTimerID = "11" or sTimerID = 11 then
		Form.SetTimerEvent2(11, 0, 0.5)
					
		ContMain.BtnOccu.visible   = True
		'ContMain.BtnOccu.enable    = False '2021.03.31
		ContMain.CmbOccu.visible   = True
		ContMain.LabelOccu.visible = False
		ContMain.Label4.visible    = true
		ContMain.Label5.visible    = true
		ContMain.Label6.visible    = true
		ContMain.CmbOccu.fgcolor   = 270
		ContMain.CmbOccu.caption   = "직종을 선택해주세요."
		'2021.04.28. 이중으로 펼쳐지지 않도록 Enable False/True
		ContMain.BtnOccu.enable = True
		ContMain.CmbOccu.enable = True
			
		'ContMain.BtnOccu.enable    = false '2021.04.23. 주석처리
		
		'2021.04.28. 김유경.선택된 후에는 자동으로 열리지 않도록 수정
		If Trim(ContMain.CmbOccu.caption) == "직종을 선택해주세요." Then 
			Form.SetTimerEvent2(15, 1, 0.7)
		End If 		
		
	ElseIf sTimerID = "12" or sTimerID = 12 then
		'ContMain.CmbOccu.Setstatus("normal")
		
		Form.SetTimerEvent2(12, 0, 0.5)
		ContMain.CmbPurpose.visible = true
		'2021.04.28. 김유경.선택된 후에는 자동으로 열리지 않도록 수정
		If Trim(ContMain.CmbPurpose.caption) == "거래목적을 선택해주세요." Then 
			Form.SetTimerEvent2(25, 1, 0.7)
		End If 		
						
	ElseIf sTimerID = "13" or sTimerID = 13 then
		Form.SetTimerEvent2(13, 0, 0.8)
		
		'20210308 김유경 calcUnResize 로직 추가
		ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top,"1")) + 150
		ContMain.SetScrollAutoSize()	
		'20210308 김유경 calcUnResize 로직 추가			
		
		'Form.SetTimerEvent2(2, 1, 0.1)
		
		'20210308 김유경 calcUnResize 로직 추가
		ContMain.scroll_pos = Cint(Form.calcUnResize(ContMain.CmbOccu.top ,"1" )) + 80 '0->80  2021.04.13. 김유경 2개씩 보이도록 수정
		ContMain.CmbMoney.visible = true
		'20210308 김유경 calcUnResize 로직 추가
		
		'2021.04.28. 김유경.선택된 후에는 자동으로 열리지 않도록 수정
		'If Trim(ContMain.CmbMoney.caption) == "자금의 원천을 선택해주세요." Then 
			Form.SetTimerEvent2(19, 1, 0.5)
		'End If 
	elseif sTimerID = "14" or sTimerID = 14 then
		Form.SetTimerEvent2(14, 0, 0.2)
		
		ContMain.CmbJob.openList()
	
	elseif sTimerID = "15" or sTimerID = 15 then
	
		Form.SetTimerEvent2(15, 0, 0.7)
		
		'2021.04.13 신규종합/개발추가 2개씩 보이는 로직 분기
		
		If gAcntOpngClcd == "2" Then '개별추가
			ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top ,"1")) + 84
			ContMain.SetScrollAutoSize()
			ContMain.scroll_pos  = Cint(Form.calcUnResize(ContMain.Label2.top ,"1"))  + 0
		Else '신규종합. 추가
			ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top ,"1")) +  154 '84 '84->154 2021.04.13. 김유경 2개씩 보이도록 수정
			ContMain.SetScrollAutoSize()
			ContMain.scroll_pos  = Cint(Form.calcUnResize(ContMain.Label2.top ,"1"))  + 80   '150 '0->80  2021.04.13. 김유경 2개씩 보이도록 수정		
		End If 
		
		Form.SetTimerEvent2(16, 1, 0.5)
		
	elseif sTimerID = "16" or sTimerID = 16 then
		Form.SetTimerEvent2(16, 0, 0.5)
		
		If sRevData <> "StepBack" then
			ContMain.CmbOccu.Setstatus("focus")
			Form.SetTimerEvent2(21, 1,0.5)
		End If
		
		
	elseif sTimerID = "17" or sTimerID = 17 then	
		Form.SetTimerEvent2(17, 0, 0.5)
		ContMain.CmbPurpose.Setstatus("focus")
		Form.SetTimerEvent2(18, 1, 0.5)
	elseif sTimerID = "18" or sTimerID = 18 then	
		Form.SetTimerEvent2(18, 0, 0.5)
		
		If sRevData <> "StepBack" then
			ContMain.CmbPurpose.openList()
		End If
		
	elseif sTimerID = "19" or sTimerID = 19 then	
		Form.SetTimerEvent2(19, 0, 0.5)	
		ContMain.CmbMoney.Setstatus("focus")
		Form.SetTimerEvent2(20, 1, 0.5)
		
		
	elseif sTimerID = "20" or sTimerID = 20 then	
		Form.SetTimerEvent2(20, 0, 0.5)			
		
		If sRevData <> "StepBack" then
			ContMain.CmbMoney.openList()
		End If
		
	elseif sTimerID = "21" or sTimerID = 21 then	
		Form.SetTimerEvent2(21, 0, 0.5)
		ContMain.BtnOccu.enable    = true
		ContMain_BtnOccu_OnClick()
	elseif sTimerID = "22" or sTimerID = 22 then
		Form.SetTimerEvent2(22, 0, 0.5)
		ContMain.CmbPurpose.Setstatus("focus")
		Form.SetTimerEvent2(23, 1, 0.5)
		
	elseif sTimerID = "23" or sTimerID = 23 then
		Form.SetTimerEvent2(23, 0, 0.5)
		'20210308 김유경 calcUnResize 로직 추가
		ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top,"1")) +150
		ContMain.SetScrollAutoSize()
		ContMain.scroll_pos = Cint(Form.calcUnResize(ContMain.CmbJob.top,"1"))' - 84
		Form.SetTimerEvent2(24, 1, 0.5)
		'20210308 김유경 calcUnResize 로직 추가
	
	elseif sTimerID = "24" or sTimerID = 24 then
		Form.SetTimerEvent2(24, 0, 0.5)
		If sRevData <> "StepBack" then
			ContMain.CmbPurpose.openList()
		End If
		
	elseif sTimerID = "25" or sTimerID = 25 then

		Form.SetTimerEvent2(25, 0, 0.5)
		sRet = ContMain.CmbOccu.caption
		'20210308 김유경 calcUnResize 로직 추가
		If Len(trim(sRet)) > 0 Then
			ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top,"1")) + 150 'UpSize
			ContMain.SetScrollAutoSize()
		
			'개별
			If gAcntOpngClcd == "2" Then 
				ContMain.scroll_pos = Cint(Form.calcUnResize(ContMain.CmbOccu.top,"1"))  
			else
				ContMain.scroll_pos = Cint(Form.calcUnResize(ContMain.CmbJob.top,"1"))  + 80    '0->80  2021.04.13. 김유경 2개씩 보이도록 수정
			end if
		End If
		'20210308 김유경 calcUnResize 로직 추가
		
		Form.SetTimerEvent2(17, 1, 0.5)
	
	End If
End Sub
			
