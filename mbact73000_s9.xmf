'============================================================================
Function AML_DATA_Setting()

	'AML_PROD_CODE(AML상품코드)-CMA 계좌 개설이 포함되어 있으면 '0004', 없으면 '0005'
	'오택경부장 확인 100종합개설이므로 0047(투자상품>중개>주식)으로 하라함.
	gAmlProdCode = "0047"
	
	'직업직종
	gAmlOcknName      = ContMain.CmbOccu.Caption
	gOcptCode 		= ContMain.CmbJob.cbkeydata	
	
	If Trim(gLRDV_CODE ) <> ""  Then 
		gAmlOcknLrdvCode 	= gLRDV_CODE
		gAmlOcknSmdvCode	= gSMDV_CODE	
	End If 
	
	'거래목적, 자금원천
	gEddTrObjtCode 		= ContMain.CmbPurpose.cbkeydata
	gEddTrFndsSorcCode 	= ContMain.CmbMoney.cbkeydata
	
End Function 



'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Image1_OnClick()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'화면 이탈 확인 메시지박스 리턴
	If sKeyName == "Exit" And sRet == "ok" Then
'		Form.CloseForm()
		Form.OpenNextPopup("mbact73000", "", "")
	
	'obaci_acct_301a 처리완료 메시지박스 리턴
	ElseIf sKeyName == "PROC_COMPLETE" Then
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
		
		'홈화면으로 이동
		'Form.OpenScreen( "41000", "" )
		Form.CloseForm()
	End If
End Sub

