Sub Container0_Image5_OnClick()
	'20230616 SWJ START
	Form.SendReturnToParent( "mhetc90060_motp" , "cancel")
	'20230616 SWJ END
	
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "MOTP_VERSION" then
		g_mSBVersion = sParam
		
	elseif sEventName == "MOTP_ALIAS" then
		if sParam == "NO_MOTP" then	
			g_Cnt = g_Cnt + 1
				
			if g_Cnt = 1 then				
				Form.MsgBox("알림", "모바일OTP가 발급된 정보가 없습니다.\n모바일OTP를 발급하시겠습니까?", "MOTP_NEW", 6 )
			end if

		else
			g_mOTPInfo = sParam	
			
			g_mOTPAlias = Right(g_mOTPInfo, 12)
			
			nCount = nCount + 1
			
		'비로그인으로 인증시도할 때 모바일OTP정보가 없으면
		'발급해야한다는 팝업을 바로 띄우기 위해 mhotp90060에서 forminit에서 바로 requestMOTP함
		'그렇게 되면 인증 버튼을 누르는 거까지 requestMOTP정보를 두번 호출하게 됨
		'그래서 마지막에 호출하는 부분만 174a를 태우기 위한 장치
			if nCount = 1 then
				Form.SetTimerEvent2(1, 1, 0.6)                     '0.1초뒤 보안키패드 활성화
			elseif nCount = 2 then       													   
				DATAMANAGER.RequestTranData("obcsb_oimf_174a")
				nCount = 1
			end if
		end if
	elseif sEventName == "MOTP_RETURN" then
		
		g_mOTPSerial = sParam
		
		DATAMANAGER.RequestTranData("obcsb_oimf_176a")
		
	elseif sEventName == "MOTP_SHOWKEYPAD" then
		Form.SetTimerEvent2(1,1,0.6)
	elseif sEventName == "MOTP_PWDCLEAR" then
		nCnt = 0
		PasswordInsert()
	end if
End Sub

'============================================================================
Sub Container0_Edit0_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if Container0.Edit0.caption <> "" and Container0.Edit0.caption <> null then
			if g_DeviceOS == "2"  then
				Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
			elseif g_DeviceOS == "1" then
				Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
			end if
			
			Container0.Edit0.caption = ""
			PasswordInsert()
		end if
		
	'20210517 SWJ START : 업무혁신실 수정요청 (입력완료 누르면 바로 인증되도록)
	elseif nCnt = 6 then
		if g_Success = 1 then
			if g_ScrNum == "10003" then
				Form.triggerEvent("#", "menu_entering", "")
			else
'				DATAMANAGER.RequestTranData("obcsb_oimf_174a")
				
				g_nOTPCnt = 0
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			end if
		end if
		nCnt = 0
	'20210517 SWJ END
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	szAppVer 	= Form.GetSharedData("&APP_VERSION", False)
	szAppVer 	= replace(szAppVer , "." , "")
	
	if Cint(szAppver) >= 252 then
		Form.SetSharedData("&IS_OPEN_MOTP", "")
	end if
	
	'20230612 KBC : 아래 소스 있으면 안됨. 인증화면 2번 실행됨
	'Form.SendReturnToParent("mhetc90060_motp" , g_sRetData)	'20230607 SWJ START 닫기버튼 눌렀을 때 cancel 보내도록
End Sub

