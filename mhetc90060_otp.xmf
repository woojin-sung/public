'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then 
		if g_IDRegYN == "Y" then 
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "3" ) '계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO"      , 0 , g_IDRegAcno )
		else
			'앱 설치하자마자 업무신청에서 모바일OTP 발급 후, 타매체에서 푸시로 인증할 때
			'ID값이 없어서 인증오류 생기는 현상 방지
			if g_sUserID == "" or g_sUserID == null then	
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"   , 0 , g_RcnoPip )
			else
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"   , 0 , g_sUserID )		
			end if		
		end if
		
	elseif szTranID == "obcsb_oimf_174a" then
		
		if szChannel == "PUSH_SUCC" then 			 '홈페이지/HTS/ARS
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_PROS_CLCD"  , 0 , "TIME")
		end if
		
		if szPopupYN == "motp_success" then            'MTS
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_PROS_CLCD"  , 0 , "TRTI")
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "RCNO_PIP"             , 0 , g_RcnoPip)
		
		if g_IDRegYN == "Y" then 
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "ACNO"            , 0 , g_IDRegAcno)
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "ELFN_ID"         , 0 , g_sUserID)
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "CSNO"                 , 0 , g_sCsNo)
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MSBO_VRSN"            , 0 , g_mSBVersion)
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_SRNO"            , 0 , g_mOTPAlias)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "CUST_TERM_ID"         , 0 , g_DeviceID)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_ATHN_TYPE_CLCD"  , 0 , "10")
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_ATHN_DATA_CNTT"  , 0 , Container0.Edit0.caption)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_TR_CNTT"         , 0 , "") 'UUID 확인(일단 안넣어도 되는 것으로 확인)
	
	elseif szTranID == "obcsb_oimf_176a" then
		
		if szChannel == "PUSH_SUCC" then '홈페이지/HTS/ARS
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_176a", "InBlock1", "MOTP_PROS_CLCD" , 0 , "NMBR")
		end if
		
		if szPopupYN == "motp_success" then 'MTS
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_176a", "InBlock1", "MOTP_PROS_CLCD" , 0 , "NBVR")
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "CSNO"           , 0 ,  g_sCsNo)
		
		if g_IDRegYN ~= "Y" then
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "ELFN_ID"   , 0 ,  g_sUserID)
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "MSBO_VRSN"      , 0 ,  g_mSBVersion)

		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "MOTP_SRNO"      , 0 ,  g_mOTPAlias)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "CUST_TERM_ID"   , 0 ,  g_DeviceID)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "MOTP_TR_NO"     , 0 ,  sTRNo)
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_176a", "InBlock1", "MOTP_PWD_PIP"   , 0 ,  g_mOTPSerial)
		
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO"           , 0 ,  g_IDRegAcno)
	
	elseif szTranID == "obcsb_oimf_523a" then
		if g_nOTPPreCnt == 0 then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , "N" )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , "Y" )
		end if

		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "3" ) '계좌번호
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ELFN_ID" , 0 , "meritz" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ACNO" , 0 , g_IDRegAcno )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "OTP_TLMS_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "STND_DATE" , 0 , LabelDATE.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , g_sAthnType )	'거래연동인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TR_DTL_CNTT" , 0 , g_sTrAuthMsg )	'거래연동인증
		
	elseif szTranID == "obcsb_oimf_522a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "INPUT_CLS" , 0 , "3" ) '계좌번호
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ELFN_ID" , 0 , "meritz" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ACNO" , 0 , g_IDRegAcno )
		'v0003 값은 평문으로 전송(인증번호는 암호화없이 전문전송)
		'MTS메모리평문적용(g_plain_rm == "1")시에는 OnFormInit()에서 평문데이터로 설정하므로 caption으로 전송가능
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "OTP_RSPN_VAL" , 0 , Container0.Edit0.caption )
		if g_nOTPCnt == 0 then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRNM_RSLT_YN" , 0 , "N" )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRNM_RSLT_YN" , 0 , "Y" )
		end if
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "OTP_TLMS_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "STND_DATE" , 0 , LabelDATE.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , g_sAthnType )	'거래연동인증
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRAN_CRPT" , 0 , g_sTranCrpt )	'거래연동인증
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSMRT_OTP_YN 
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS    = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "RSLT_CLS"      , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		sSMRT_OTP_YN = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN", 0 )
'		if sRSLT_CLS == "3" and sSMRT_OTP_YN == "M" then
'			g_Success = 1
'		else
'			'한 단말에서 다른 아이디로 로그인후 인증 시, inblock에 태우는 값이 달라져 발생할 수 있는 오류 방지용으로 else문을 추가로 넣음
'			'또한 푸시로 들어와서 인증시, 라이브러리 호출과 서비스 호출 시점 차이에 따라
'			'둘 중 하나를 먼저 호출하면 인증오류가 생기는 단말이 발생함(폰 마다 조금씩 다름)
'			'어쩔 수 없이 거의 동시에 호출하므로, 발급된 정보가 없습니다 메시지가 두번 뜨지 않도록 메시지 뜨는 횟수를 카운트(라이브러리 호출 부분에도 있음)
'			g_Cnt = g_Cnt + 1
'			
'			if g_Cnt = 1 then
'				Form.MsgBox("알림", "모바일OTP가 발급된 정보가 없습니다.\n모바일OTP를 발급하시겠습니까?", "MOTP_NEW", 6 )
'			end if
'		end if
'		
'		'ID등록 및 비밀번호변경 화면에서 고객번호와 주민번호 값 받아서
'		'174a, 176a 서비스에 태우기 위한 분기 처리
'		if g_IDRegYN == "Y" then
'			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
'		end if

		if sRSLT_CLS == "3" and sSMRT_OTP_YN <> "M" then
			g_Success = 1
			
			if sSCRC_STAT_CODE == "0" then '정상
				DATAMANAGER.RequestTranData( "obcsb_oimf_523a" )
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
		
		Form.SetTimerEvent2(1, 1, 0.6)
		
		
	elseif szTranID == "obcsb_oimf_174a" then
		
		sTRcntt  = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_CNTT" , 0 )
		sTRNo    = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_NO"   , 0 )
		sHourVal = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_HOUR_VAL", 0 )
		sMtsYN   = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_REG_YN", 0 )
		sErrCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_ERR_CODE", 0 )
		sErrCntt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_ERR_CNTT", 0 )
		
		if sErrCode == "000000" then
			
			szMData = "512"..g_mOTPAlias.."★".."02010".."★"..sHourVal.."★"..sTRcntt '기관코드(siteCode) 02010으로 고정
			
			if sMtsYN == "N" then		
				Form.MsgBox("알림", "거래정보가 존재하지 않습니다.", "", 6)
				
				PasswordFail()
			else
				if g_ScrNum == "10003" then
					Form.triggerEvent("#", "menu_entering2", szMData )
				else
					Form.requestMOTP("MOTP_REQ_OTP_ENC", szMData , "10001")
				end if
			end if	
			
		end if	
		
	elseif szTranID == "obcsb_oimf_176a" then
		sErrCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_176a", "OutBlock1", "MOTP_ERR_CODE", 0 )
		sErrCntt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_176a", "OutBlock1", "MOTP_ERR_CNTT", 0 )
		
		if sErrCode <> "000000" then
			PasswordFail()
			
			Form.MsgBox("알림", sErrCntt, "", 6)
		else
			g_sRetData = "ok"

			if szPopupYN == "motp_success" then
				Form.CloseForm()
				Form.SendReturnToParent( "mhetc90060_otp" , g_sRetData )
			else
				if g_ScrNum == "10003" then
					Form.triggerEvent("#", "AUTH_COMPLETE", "")
				else
					Form.OpenNextPopup("mhetc90060_motpS" , "" , "") '인증완료 창으로 전환
				end if
			end if
		end if
	
	elseif szTranID == "obcsb_acif_000r" then
		g_sCsNo   = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CSNO"    , 0 )
		g_RcnoPip = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "RCNO_PIP", 0 )
	
	elseif szTranID == "obcsb_oimf_523a" then
		Dim sUI_SMRT_OTP_YN, sPROS_YN, sOTP_TLMS_SRNO, sSTND_DATE, sPIN_NO
		
		'N:스마트OTP아님 Y:스마트OTP
		sUI_SMRT_OTP_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "UI_SMRT_OTP_YN" , 0 )
		'N:전문미수신/전문수신완료
		sPROS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "PROS_YN" , 0 ) 
		sOTP_TLMS_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "OTP_TLMS_SRNO" , 0 ) 
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "STND_DATE" , 0 ) 
		sPIN_NO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "PIN_NO" , 0 ) 
		
		if g_nOTPPreCnt == 0 then
			g_sTranCrpt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "TRAN_CRPT" , 0 ) 
		end if
		
		if Len(Trim(sOTP_TLMS_SRNO)) > 7 then '전문일련번호
			LabelSRNO.caption = sOTP_TLMS_SRNO
		end if
	
		if Len(Trim(sSTND_DATE)) == 8 then '기준일자
			LabelDATE.caption = sSTND_DATE
		end if
		
		if sUI_SMRT_OTP_YN <> "Y" then
			exit sub
		end if 
		
		if g_nOTPPreCnt == 0 then
			g_nOTPPreCnt = g_nOTPPreCnt+1
			DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) 'OTP사전정보전송
			Exit Sub
		end if
		
		Dim sCode 
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "3021" then 'OTP 코드 체크(3021)
			g_nOTPPreCnt = g_nOTPPreCnt+1
			if g_nOTPPreCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) 'OTP정보확인
			else
				g_nOTPPreCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
				Exit Sub
			end if
		elseif sCode == "0000" then
			'일반 OTP에서 필요한 부분인가 싶어서 일단 주석 처리
'			Container1.EditPin.caption = sPIN_NO
			
			Container0.Edit0.caption = sPIN_NO
		else
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
		end if
	
	elseif szTranID == "obcsb_oimf_522a" then
		Dim sOTP_TLMS_SRNO, sSTND_DATE, sOTP_RSPN_CODE, sRSLT_CLS, sOTP_PWD_MSTK_TMNU
		
		sOTP_TLMS_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_TLMS_SRNO" , 0 )
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "STND_DATE" , 0 )
		'0000:정상 나머지:오류
		sOTP_RSPN_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_RSPN_CODE" , 0 )
		'결과구분 0:정상 그외에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "RSLT_CLS" , 0 )
		'OTP오류횟수
		sOTP_PWD_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_PWD_MSTK_TMNU" , 0 )
				
		if Len(Trim(sOTP_TLMS_SRNO)) > 7 then '전문일련번호
			LabelSRNO.caption = sOTP_TLMS_SRNO
		end if
	
		if Len(Trim(sSTND_DATE)) == 8 then '기준일자
			LabelDATE.caption = sSTND_DATE
		end if
	
		if g_nOTPCnt == 0 then
			g_nOTPCnt = g_nOTPCnt+1
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			Exit Sub
		end if
		
		Dim sCode 
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "3021" then 'OTP 코드 체크(3021)
			g_nOTPCnt = g_nOTPCnt+1
			if g_nOTPCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			else
				g_nOTPCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
				Exit Sub
			end if
		end if
	
		if sOTP_RSPN_CODE == "0000" then 'OTP응답코드
			if sRSLT_CLS == "0" then '정상
				if CInt(sOTP_PWD_MSTK_TMNU) > 5 then '에러	
					Form.MsgBox( "알림", "OTP 입력 오류 횟수 초과입니다.", "", 6 )
				else
					g_sRetData = "ok"  'otp성공후 공인인증
					
					Form.CloseForm()
					Form.SendReturnToParent( "mhetc90060_otp" , g_sRetData )
				end if
			else
				Dim sMsg, sSubMsg 
				sMsg = DATAMANAGER.GetDataMsgText( szTranID )
				sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
				Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
				
				Container0.Edit0.caption = ""
				PasswordInsert()
			end if
		'20160601 최일규 추가 : OTP unsync 재조회시 SKIP
		elseif sOTP_RSPN_CODE == "4000" then
		     Exit Sub
		'16-03-11 YCJ 추가
		else
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
			
			Container0.Edit0.caption = ""
			PasswordInsert()
			
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_oimf_174a" then
		Dim sSubMsg
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID ) 
		
		szErrMsg = szErrMsg & "\n" & sSubMsg
		
		if szErrCode == "2430" then								'비밀번호 오류(5회가 아닌 경우)
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		elseif szErrCode == "8867" then							'비밀번호 오류(5회인 경우)
			
			Form.OpenNextPopup("mhetc90060_motpS" , "motp_error5" , "")
		'elseif szErrCode == "6660" then												
	'		Form.OpenNextPopup("mhetc90060_motpS" , "motp_error10" , "")	'비밀번호 오류(10회인 경우) 
																	'(근데 6660은 6회이상일때 부터 PIN 잠김오류로 떨어지는 코드임.
																	'권차장님이 현업부서와 확인 후 처리 방법 알려줄 예정(5회이상 10회미만까지 합쳐서)
		else
			Form.MsgBox( "알림" .. szTranID, szErrMsg, "", 6 )
		end if
		
		PasswordFail()
	elseif szTranID == "obcsb_oimf_176a" then
		Dim sSubMsg
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID ) 
					
		szErrMsg = szErrMsg & "\n" & sSubMsg
			
		Form.MsgBox( "알림" .. szTranID, szErrMsg, "", 6 )
		
		PasswordFail()
		
	else
		Dim sSubMsg
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID ) 
					
		szErrMsg = szErrMsg & "\n" & sSubMsg
		
		Form.MsgBox( "알림" .. szTranID, szErrMsg, "", 6 )
	end if
End Sub
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
'모바일OTP 화면번호10000번으로 (이것과 별개지만 참고로 푸시도 내려줄때 10000번으로 인식)
'호출받을 때 _10001(화면번호)로 받기

	if sEventName == "MOTP_GET_VERSION_RETURN_10001" then
		g_mSBValue = Split(sParam,"★")		'resultcode★resultMsg★mSBVersion

		g_mSBVersion = g_mSBValue(2)
		
		if g_mSBValue(0) <> "00000" then
			Form.MsgBox( "알림", g_mSBValue(1), "", 6 )
			PasswordFail()
		end if

	elseif sEventName == "MOTP_GETINFO_RETURN_10001" then

		g_mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		if Ubound(g_mOTPInfo) < 1 then
			exit sub
		else	
			if g_mOTPInfo(0) == "00000" then			
				if g_ScrNum <> "10003" then
					Form.SetTimerEvent2(2, 1, 0.6)                     '1초뒤 보안키패드 활성화
				end if
				
				g_mOTPAlias = Right(g_mOTPInfo[2], 12)
			else
				g_Cnt = g_Cnt + 1
				
				if g_Cnt = 1 then
					Form.MsgBox("알림", "모바일OTP가 발급된 정보가 없습니다.\n모바일OTP를 발급하시겠습니까?", "MOTP_NEW", 6 )
				end if
			end if
		end if
		'메인처리는 일련번호 다중처리 가능하게 되어있지만, 1개만 받는 것으로 생각
		'g_mOTPAlias = Split(g_mOTPInfo[2],"#")
			
	elseif sEventName == "MOTP_REQ_OTP_ENC_RETURN_10001" then
		g_mOTPData = Split(sParam,"★")

		if g_mOTPData(0) <> "00000" then
			Form.MsgBox( "알림", g_mOTPData(1), "", 6 )
			
			PasswordFail()
		else
			if Ubound(g_mOTPData) < 1 then
				exit sub
			else
				g_mOTPSerial = g_mOTPData(2)
			end if
			
			DATAMANAGER.RequestTranData("obcsb_oimf_176a")
		end if
		
	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	elseif sKeyName == "LOG_FORCE" then
		' IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_DeviceOS == "2" Then	'iOS("2")Android("1")
			if sRet == "ok" then			
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")		
			else
				if g_ScrNum == "10003" then
					'안드로이드는 여기서 폼닫기 해도 닫히는데
					'ios는 메뉴화면을 직접닫아줘야 닫아짐
					Form.triggerEvent("#","ios_formclose","")
				else
					Form.CloseForm()
				end if
			end if		
		else
			if sRet == "ok" then
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()			
			end if	
		end if
		
	elseif sKeyName == "MOTP_NEW" then
		
		if sRet == "cancel" then
			Form.SendReturnToParent( "mhetc90060_motp" , "cancel" )		'20230616 SWJ START
			Form.CloseForm()
			exit sub
		end if
		
		'로그인을 한번이라도 했었는지 판단
		if g_sUserID == "" or g_sUserID == null then
			Form.SetSharedData("BDM_NMETBSWRGB", "009")
			Form.OpenNextPopup("mbbdm85200","", "")
		else
			if Cint(g_LoginType) > 1 then '로그인상태
				Form.OpenNextPopup("mbotp86100","", "")
			else
				'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
				'업무신청 화면으로 발급하도록 연결
				 Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
				 Form.SetSharedData("BDM_FRST_MAPID", "screen41000")
				 Form.SetSharedData("BDM_NMETBSWRGB", "009")
				 'V001
				 'Form.OpenNextPopup("mbbdm85110", "" , "" )
				 Form.OpenNextPopup("mbbdm86130", "" , "" )
				
			end if
		end if
	end if
End Sub
