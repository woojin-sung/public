'============================================================================
' 2021.01.25 SWJ START : 모바일OTP인증화면 
' 2023.04.06 양현정 V001 : 화면mapid 수정
'============================================================================
Dim g_RcnoPip, g_sUserID, g_sCsNo
Dim g_mSBValue
Dim g_DeviceID , siteCode
Dim g_mOTPInfo
Dim sTRcntt, sTRNo, sHourVal
Dim sRSLT_CLS , sSMRT_OTP_YN
Dim g_mOTPData
Dim szChannel, szErrCntt
Dim g_mSBValue
Dim g_mOTPAlias, g_mOTPInfo, g_mOTPSerial
Dim g_mOTPData, g_mSBVersion, g_tempSBVer
Dim g_Success, nCnt, nSavePwd, g_DeviceOS, szPopupYN, g_LoginType
nCnt = 0
Dim nCount
nCount = 0
Dim g_Cnt
g_Cnt = 0
Dim szErrCode
Dim g_IDRegYN, g_IDRegAcno, g_CountSave

Dim g_nOTPPreCnt, g_sAthnType, g_sTrAuthMsg

g_sRetData = "cancel"
'============================================================================
Sub Form_OnFormInit()
	
	Container0.Edit0.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동
	
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_RcnoPip  = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
	g_sCsNo 	  = Form.GetSharedData("&CUST_NUM"  , false )	 '고객번호
	g_DeviceID = Form.GetDeviceID() 
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", 0 )
	
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO",true) '메뉴클릭시 팝업메뉴 화면번호 전달
	
	Form.SetSharedData("&MOTP_PUSH" , "PUSH_SUCC")	  '비로그인성으로 인증하는 경우는 무조건 타매체 인증이고
	                                                    'MTS에서 인증할때는 무조건 맵파일 호출이므로
							                         'MTS 내 인증은 szPopupYN 값으로 구분하자
	szPopupYN = Form.GetOpenLinkData() 
							 
	szChannel = Form.GetSharedData("&MOTP_PUSH" , True) 'Main에서 PUSH 이용매체(홈페이지/HTS/ARS) 구분
												  'True로 초기화 필수 (인증마다 매체 초기화)
	
    '모바일OTP 발급화면으로 넘어갈 시를 대비한 분기처리
	Form.SetSharedData("mOTP_IntoClcd", "MTS")
				
	'주민번호와 고객번호를 getshared 뒤지다가 안나오면 발급 시 set한 값 불러오도록 처리(ios쪽 처리때문)
	if g_RcnoPip == "" or g_RcnoPip == null then
		g_RcnoPip = Form.GetEnvData("login.session.juminnopip")
	end if
	'비로그인 상태로 진행할때를 대비
	if g_RcnoPip == "" or g_RcnoPip == null then
		g_RcnoPip = Form.GetSharedData("BDM_RCNO_PIP", false)
	end if
	
	if g_sCsNo == "" or g_sCsNo == null then
		g_sCsNo = Form.GetEnvData("login.session.custno")
	end if
	
	
	g_sAthnType = "2"		'거래연동인증
	g_sTrData = Form.GetSharedData("OTP_TR_MSG_1", false )
	g_sTrAuthMsg = Form.GetSharedData("OTP_TR_AUTH_MSG", true)
	g_nOTPCnt = 0
	g_nOTPPreCnt = 0

	'업무 중간중간 보안매체 인증해야할 때 motp_success로 구분하여 인증함(MTS 내에서)
	if szPopupYN == "otp_success" then	
		
		'ID등록 화면에서 모바일OTP 인증 시, ID가 없으므로 계좌번호로 대신 520r 서비스에서 분기처리
		'"Y"이면 ID등록 화면에서 인증하는 것 
		g_IDRegYN   = Form.GetSharedData("IdRegPros"    , true)	'SWJ START => 20240321 : True로 변경
		
		'계좌번호
		g_IDRegAcno = Form.GetSharedData("IdRegProsAcno", true)	'SWJ START => 20240321 : True로 변경
		
'		Form.ShowAlert("g_IDRegAcno", g_IDRegAcno)
		
	end if
	
	'푸시 팝업으로 뜰 때만 닫기버튼 보이기 위함
	if g_ScrNum == "10003" then
		Container0.Image5.visible = false
		Container0.Image5.enable = false
		Container0.Buttonok.top = 521
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	else
		'기종 관계없이 특정 단말에서 520r 서비스가 타이머 이벤트를 주지않으면
		'순서를 바꿔도 태워지지 않는 버그가 생김
		Form.SetTimerEvent2("9999", 1, 0.6)
	end if
	
'	if g_DeviceOS == "1" then
'		Form.requestMOTP("MOTP_GET_VERSION" , "" , "10001")     'mSB 버전값 획득위한 호출
'		Form.requestMOTP("MOTP_GETINFO"     , "" , "10001")     '등록된 OTP alias 존재하는지 확인
'	end if
End Sub
'============================================================================
Sub Form_OnFormInitAfter()
	'iOS에서 팝업으로 띄울 때 forminit에서 안타는 현상이 있어서 구분
'	if g_DeviceOS == "2" then
'		Form.requestMOTP("MOTP_GET_VERSION" , "" , "10001")     'mSB 버전값 획득위한 호출
'		Form.requestMOTP("MOTP_GETINFO"     , "" , "10001")     '등록된 OTP alias 존재하는지 확인		
'	end if
End Sub
'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.Edit0.caption == null or Container0.Edit0.caption == "" then
		Form.MsgBox( "알림", "모바일 OTP 비밀번호를 입력해주세요.", "", 6 )
	else	
		if g_Success = 1 then
			if g_ScrNum == "10003" then
				Form.triggerEvent("#", "menu_entering", "")
			else
'				DATAMANAGER.RequestTranData("obcsb_oimf_174a")
				
				g_nOTPCnt = 0
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
				
			end if
			
		end if
	end if
	
	nCnt = 0
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.Edit0.SetShowKeypad(True)
				
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.Edit0.SetShowKeypad(True)
				
	elseif sTimerID == "9999" or sTimerID == 9999 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
End Sub
