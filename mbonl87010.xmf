Sub Container0_tblState_OnClick(lRow , lColumn)
	if lRow == 1 and lColumn == 1 then
		Form.OpenFramePopup("mbonl87020" , szOpenData , sPosInfo)
	end if
End Sub

'============================================================================
' Container0_btnChange_OnClick
'============================================================================
Sub Container0_btnChange_OnClick()
	if Trim(Container0.tblView.GetCellString( Container0.rdoReportSendPlace.currentindex + 1, 2 )) == "" then	'거래내역통보처와 연락처 비교
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)	
	elseif Trim(Container0.tblView.GetCellString( Container0.rdoReportSendPlace.currentindex + 1, 2 )) == "" then	'우편물통보처와 연락처 비교
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)
	else
		If g_szTrInformIndex <> g_szTempRadio1 or g_szPostalIndex <> g_szTempRadio2 then
		    Call TR_Inquiry("obcsb_acad_003a")
		else
			Form.MsgBox("알림", "이미 등록되어있는 통보처 입니다.", "", 0)
		end if
	
	end if	
	btnSearch_OnClick()		'재조회
End Sub

'============================================================================
' btnChange_OnClick - 변경 클릭
'============================================================================
Sub btnChange_OnClick()
	'통보값 추가 관련으로 순서가 바뀌어서 조건문 수정
	If CInt(Container0.rdoReportSendPlace.currentindex) == 1 And Trim(Container0.tblView.GetCellString( 3, 2 )) == "" Then
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)	
	ElseIf CInt(Container0.rdoReportSendPlace.currentindex) == 2 And Trim(Container0.tblView.GetCellString( 1, 2 )) == "" Then
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)	
	ElseIf CInt(Container0.rdoReportSendPlace.currentindex) == 3 And Trim(Container0.tblView.GetCellString( 2, 2 )) == "" Then
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)	
	ElseIf CInt(Container0.rdoReportSendPlace.currentindex) == 4 And Trim(Container0.tblView.GetCellString( 4, 2 )) == "" Then
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)	
	
'	if Trim(Container0.tblView.GetCellString( Container0.rdoReportSendPlace.currentindex + 1, 2 )) == "" then	'거래내역통보처와 연락처 비교
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)	
	'v0001 컨트롤명 수정 rdoReportSendPlace > rdoMailSendPlace
	elseif Trim(Container0.tblView.GetCellString( Container0.rdoMailSendPlace.currentindex + 1, 2 )) == "" then	'우편물통보처와 연락처 비교 
		Form.MsgBox("알림", "선택하신 주소가 등록되어 있지 않습니다.", "", 0)
	else
		If g_szTrInformIndex <> g_szTempRadio1 or g_szPostalIndex <> g_szTempRadio2 then
		    Call TR_Inquiry("obcsb_acad_003a")
		else
			'20230802 모바일 우선통보 관련 내용 추가
			'통보처 변경은 안하지만 모바일 우선통보만 체크하고 변경할 수 있으므로 내용 추가
			Dim szChangeChk
			if Container0.chkMobile.checkstate == "1" then
				szChangeChk = "Y"
			else
				szChangeChk = "N"
			end if
			if g_szCustClsCode == "1" and (g_szMobileYn <> szChangeChk) then
				Call TR_Inquiry("obcsb_acad_003a")
			else
				Form.MsgBox("알림", "이미 등록되어있는 통보처 입니다.", "", 0)
			end if
		end if
	
	end if	
	btnSearch_OnClick()		'재조회
	
	edtPassword.caption = ""
	g_szPassword = ""
End Sub

