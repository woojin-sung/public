'============================================================================
Sub Container0_rdoMailSendPlace_OnClick(nIndex)
	g_szTempRadio2 = nIndex
	if nIndex == 0 then
		g_szMailType = "01"
	elseif nIndex == 1 then
		g_szMailType = "02"
	elseif nIndex == 2 then
		g_szMailType = "03"	
	else
	
	end if
End Sub



