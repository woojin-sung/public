'============================================================================
' 01. 화 면 명 : 잔고통보처변경
' 02. 화면설명 : 잔고통보처변경
' 03. 작    성 : 2016.01.20 ~ 최지희
' 04. 수    정 : 2019.05.21 윤유정 : 우편물통보처 변경 시 해당 통보처 주소등록여부 체크 v0001
' 2020.09.17 : 정민영 : v0002 : [T2008250015] 메모리취약점 보완
'            : 비밀번호컨트롤 속성 '일반비밀번호'->'계좌/거래비밀번호'변경
' 2023.06.20 : 통보처 변경 오류수정 (이메일)
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szNoticeType '발송물 통보처 유형 코드
Dim g_szNoticeSerial '발송물 통보처 일련번호
Dim g_szMailType '우편물 통보처 유형 코드
Dim g_szMailSerial  '우편물 통보처 일련번호
Dim g_szHtsYN 'HTS불원등록 약정상태 변수
Dim g_szJangoYN '잔고통보처 약정 상태 변수
Dim g_szCSNM  '고객명
Dim g_szPostalIndex '우편물 통보처 인덱스
Dim g_szTrInformIndex '거래내역 통보처 인덱스
Dim g_szFundRmndRcmsClsCode	'펀드잔고수신구분코드
Dim g_szCustClsCode	'고객구분코드
Dim g_szContClsCode	'접촉구분코드
Dim g_szProsClsCode	'처리구분코드
Dim g_szCsno	'고객번호
Dim szReport	'운용 보고서 통보처 유형코드
Dim szReportSerial	'운용 보고서 통보처 일련번호
Dim g_szAccountNumber	'계좌번호
Dim g_szPassword		'비밀번호
Dim g_szOpenData		'계좌번호 ; 비밀번호
Dim g_szTempAccountNumber	'계좌번호8자리
Dim g_szTempPassword
Dim g_szTempRadio1
Dim g_szTempRadio2
Dim g_plain_rm  		'v0002 메모리평문적용여부

Dim g_szMobileYn

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry() - tr명에 따라
'============================================================================
Function TR_Inquiry(szTranID)

	if szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "CONT_CLS_CODE" , 0, "4")	'접촉구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "PROS_CLS_CODE" , 0 , "5")	'처리구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obcsb_acad_002r")
	elseif szTranID == "obacp_opop_064r" then
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obacp_opop_064r")
	elseif szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_323r", "InBlock1", "ACNO", 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	elseif szTranID == "obcsb_acad_003a" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock4", "ACNO" , 0 , g_szAccountNumber)			'계좌번호		
		DATAMANAGER.RequestTranData("obcsb_acad_003a")
	end if
	
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcsb_acad_002r" then 	'고객연락처정보조회 tr
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "CONT_CLS_CODE" , 0, "4")	'접촉구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "PROS_CLS_CODE" , 0 , "5")	'처리구분코드
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
	end if
	
	if szTranID == "obcsb_acad_003a" then	'고객연락처정보처리 tr
		Dim szFundCode	'펀드잔고수신구분코드
		Dim szCSNOCode	'고객번호
		szFundCode = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "FUND_RMND_RCMS_CLS_CODE" , 0)
		szCSNOCode = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "CSNO" , 0)
		DATAMANAGER.SetDataValue(0,  "obcsb_acad_003a", "InBlock3", "SNML_INAG_TYPE_CODE", 0 , g_szNoticeType)	'발송물통보처유형코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "SNML_INAG_SRNO" , 0 , g_szNoticeSerial)		'발송물통보처일련번호
		DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "MAIL_INAG_TYPE_CODE" , 0 , g_szMailType)		'우편물통보처유형코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "MAIL_INAG_SRNO", 0 , g_szMailSerial)		'우편물통보처일련번호
		DATAMANAGER.SetDataValue(0,"obcsb_acad_003a", "InBlock3", "CUST_CLS_CODE" , 0 , "1")					'고객구분코드(개인=1)
		DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "FUND_RMND_RCMS_CLS_CODE" , 0 , g_szFundRmndRcmsClsCode)	'펀드잔고수신구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock4", "CONT_CLS_CODE" , 0 , "4")					'접촉구분코드
		DATAMANAGER.SetDataValue(0,  "obcsb_acad_003a", "InBlock4", "PROS_CLS_CODE", 0 , "2")					'처리구분코드
		DATAMANAGER.SetDataValue(0,  "obcsb_acad_003a", "InBlock4", "CSNO", 0 , g_szCsno)					'고객번호
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock4", "ACNT_PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock4", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
		
		'20230802 모바일 우선통보 관련 내용 추가
		if g_szCustClsCode == "1" then
			if Container0.chkMobile.checkstate == "1" then
				DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "MBL_PRTY_INFR_YN" , 0 , "Y")
			else
				DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "MBL_PRTY_INFR_YN" , 0 , "N")
			end if
		else
			DATAMANAGER.SetDataValue(0, "obcsb_acad_003a", "InBlock3", "MBL_PRTY_INFR_YN" , 0 , "")
		end if
	end if
	
	if szTranID == "obpds_srvc_344a" then	'통보처약정 일괄해지 및 정정 tr
		DATAMANAGER.SetDataValue(0, "obpds_srvc_344a", "InBlock1", "PROS_CLS_CODE", 0 , "2")					'처리구분코드(해지=2)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_344a", "InBlock1", "CSNO" , 0 , g_szCsno)					'고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_344a", "InBlock1", "CONT_CLS_CODE" , 0 , "4")					'접촉구분코드
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_344a", "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, "obpds_srvc_344a", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
	end if
	
'	
	
	if szTranID == "obpds_srvc_323r" then	'hts/wts용 서비스내역조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD"  , 0 , "048")	'서비스코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO", 0 , g_szCsno)					'고객번호
		
		if g_szJangoYN <> "" and g_szHtsYN <> "" then
			if g_szJangoYN == "Y" and g_szHtsYN == "Y" then
				g_szJangoYN = "N"
			end if
		end if
	end if
	
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acad_002r" then	'고객정보조회

		lblClose.caption = ""
		
		'20230802 모바일 우선통보 관련 내용 추가
		'개인/법인 구분
		g_szCustClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE" , 0)
		'개인일때만 모바일 우선통보 체크 노출 
		if g_szCustClsCode == "1" then
			Container0.chkMobile.visible = true
			Container0.imgTooltip1.visible = true
			
			'노출시킨 체크영역만큼 하위 컨트롤 위치 조정
			Container0.Label0.top = 69 + 36
			Container0.btnAddModi.top = 71 + 36
			Container0.tblView.top = 99 + 36
			Container0.Label2.top = 246 + 36
			Container0.Table1.top = 275 + 36
			Container0.rdoReportSendPlace.top = 351 + 36
			Container0.rdoMailSendPlace.top = 506 + 36
			Container0.Table0.top = 600 + 36
			
			Container0.SetScrollAutoSize()
			
			'기존값 세팅
			g_szMobileYn = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MBL_PRTY_INFR_YN" , 0)
			if g_szMobileYn == "Y" then
				Container0.chkMobile.checkstate = "1"
				
				'20230817 모바일 우선통보 동의 한 고객은 상태값을 보여주되 비활성화(변경 안됨)
				Container0.chkMobile.enable = false
			else
				Container0.chkMobile.checkstate = "0"
			end if
		else
			Container0.chkMobile.visible = false
			Container0.imgTooltip1.visible = false
		end if
		
		
		'//////현재 고객 통보처 상태 기억 /////////////

		g_szNoticeType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "SNML_INAG_TYPE_CODE" , 0)
		g_szNoticeSerial = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "SNML_INAG_SRNO" , 0)
		
		'g_szFundRmndRcmsClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "FUND_RMND_RCMS_CLS_CODE" , 0) '펀드잔고수신구분코드

		g_szMailType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MAIL_INAG_TYPE_CODE" , 0)
		g_szMailSerial = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MAIL_INAG_SRNO" , 0)
		
		'g_szCsno = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "CSNO" , 0)

		
		szReport = DATAMANAGER.GetDataValue(0,  "obcsb_acad_002r", "OutBlock5", "MGRI_RPRT_INAG_TYPE_CODE", 0)
		szReportSerial = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MGRI_RPRT_INAG_SRNO" , 0)

		
		'//////계좌별 통보처 등록 부분 ////////////////
		Dim szAccNoticeType	'발송물통보처유형코드
		Dim szAccMailType 	'우편물통보처유형코드
		szAccNoticeType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock7", "SNML_INAG_TYPE_CODE" , 0)
		szAccMailType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock9", "MAIL_INAG_TYPE_CODE" , 0)		

	
		if szAccNoticeType <> "" then
			Container0.rdoReportSendPlace.enable = false
		else
			Container0.rdoReportSendPlace.enable = true
		end if
		
	    
		if szAccMailType <> "" then
			Container0.rdoMailSendPlace.enable = false
		else
			Container0.rdoMailSendPlace.enable = true
		end if
		
		for i=1 to 3
			Container0.tblView.SetCellString(i ,1,"")
			Container0.tblView.SetCellString(i , 2,"")
		next 
			
		'//////고객 통보처 부분 셋팅////////////////
		for i=0 to DATAMANAGER.GetDataCount(0, "obcsb_acad_002r", "OutBlock1" )-1
			Dim szNotice	'통보처유형코드
			szNotice = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE", i)
			
			
			Dim nNoticeRow
			if szNotice == "01" then 	'자택
				nNoticeRow = 1
			elseif szNotice == "02" then	'회사
				nNoticeRow = 2
'			elseif szNotice == "03" then	'기타		'20221208 수정 요청 : 기타 삭제
'				nNoticeRow = 3
			elseif szNotice == "21" then	'이메일
				nNoticeRow = 3
			end if			
			
			'이 반복문은 상단 고객정보를 넣어주는 부분이라 새로운 내용 넣을 필요 없을듯
'			if szNotice == "13" then 		'알림톡
'				nNoticeRow = 1
'			elseif szNotice == "21" then	'이메일
'				nNoticeRow = 2
'			elseif szNotice == "01" then	'자택
'				nNoticeRow = 3
'			elseif szNotice == "02" then	'회사
'				nNoticeRow = 4
'			elseif szNotice == "23" then	'기타
'				nNoticeRow = 5
'			end if
			
			'Container0.tblView.SetCellString(nNoticeRow, 1, Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i ) ))
			Container0.tblView.SetCellString(nNoticeRow, 2, Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "ADDR" , i ) ))
		next
		
		
			'//////거래내역 통보처 라디오 세팅////////////////
		
		for i=0 to DATAMANAGER.GetDataCount(0, "obcsb_acad_002r", "OutBlock5" )-1
			Dim szNoticeType
			szNoticeType = ""
			szNoticeType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "SNML_INAG_TYPE_CODE" , i )
			Dim nTrInformIndex
			if szNoticeType == "" then
				nTrInformIndex = 0
			else						
				Select Case szNoticeType
				Case "13"
					nTrInformIndex = 0
				Case "21"
					nTrInformIndex = 1
				Case "01"
					nTrInformIndex = 2
				Case "02"
					nTrInformIndex = 3
				Case "03"
					nTrInformIndex = 4
				End Select				
			end if
			
			g_szTempRadio1 = nTrInformIndex
			
			Container0.rdoReportSendPlace.currentindex = nTrInformIndex
			g_szTrInformIndex = nTrInformIndex
		
			Dim szNoticeMailType
			szNoticeMailType = ""
			szNoticeMailType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MAIL_INAG_TYPE_CODE" , i )
			
			Dim nPostIndex			
			if szNoticeMailType == "" then
				nPostIndex = 0
			else
				Select Case szNoticeMailType
				Case "01"
					nPostIndex = 0
				Case "02"
					nPostIndex = 1
				Case "03"
					nPostIndex = 2
				End Select
			end if			
			Container0.rdoMailSendPlace.currentindex = nPostIndex
			g_szPostalIndex = nPostIndex			
			g_szTempRadio2 = nPostIndex

			
		next
		
		
		if DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "UI_ITEM_NAME2" , 0 ) == "통보희망" then
			g_szJangoYN = "N"
		else
			g_szJangoYN = "Y"
		end if
		
		
		'//////고객 통보처 2개 모두 비활성일 경우 변경 버튼 비활성 나머지는 활성////////////////
		if Container0.rdoReportSendPlace.enable == false and Container0.rdoMailSendPlace.enable == false then
			Container0.btnChange.enable = false
		else
			Container0.btnChange.enable = true
		end if
		
		TR_Inquiry("obacp_opop_064r")	
	end if
	
	
	if szTranID == "obacp_opop_064r" then	'종합계좌 기준 계좌 CONTROL 조회
		g_szCSNM = DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNM" , 0)	'고객명
		TR_Inquiry("obpds_srvc_323r")
	end if
	
	
	if szTranID == "obpds_srvc_323r" then	'hts-wts용서비스 내역
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "SVCD" , 0) <> "" then
			g_szHtsYN = "Y"
		else
			g_szHtsYN = "N"
		end if
		
		if g_szJangoYN <> "" and g_szHtsYN <> "" then
			if g_szJangoYN == "Y" and g_szHtsYN == "Y" then
				Container0.tblState.SetCellString( 1, 0, "HTS통보불원" )
				'Container0.edtState.caption = "HTS통보불원"
			elseif g_szJangoYN == "Y" and g_szHtsYN == "N" then
				Container0.tblState.SetCellString( 1, 0, "잔고통보불원" )
				'Container0.edtState.caption = "잔고통보불원"
			elseif g_szJangoYN == "N" and g_szHtsYN == "Y" then
				Container0.tblState.SetCellString( 1, 0, "HTS통보불원" )
				'Container0.edtState.caption = "HTS통보불원"
			elseif g_szJangoYN == "N" and g_szHtsYN == "N" then
				Container0.tblState.SetCellString( 1, 0, "통보희망" )
				'Container0.edtState.caption = "통보희망"
			end if
		end if
	end if
	
	
	if szTranID == "obcsb_acad_003a" then
		If g_szTrInformIndex <> Container0.rdoReportSendPlace.currentindex or g_szPostalIndex <> Container0.rdoMailSendPlace.currentindex then
		    Form.MsgBox("알림", "고객 통보처가 변경되었습니다.", "", 0)
'		    Container0.rdoReportSendPlace.currentindex = 5
'			Container0.rdoMailSendPlace.currentindex	= 3
		    Call TR_Inquiry("obcsb_acad_002r")
		else
			Call TR_Inquiry("obcsb_acad_002r")			
		end if
	end if
	
	
	if szTranID == "obpds_srvc_344a" then
		Call TR_Inquiry("obcsb_acad_002r")
	end if
End Sub



'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_acad_003a" then
		Form.MsgBox("알림", szErrMsg, "", 0)
	elseif szTranID == "obcsb_acad_002r" then
			Form.MsgBox("알림", szErrMsg, "", 0)
	end if 	
End Sub




'============================================================================
' btnSearch_OnClick - 조회(HTS불원여부, 고객연락처, 현재 통보처 조회)
'============================================================================
Sub btnSearch_OnClick()
	g_szTempRadio1 = ""
	g_szTempRadio2 = ""
	g_szTempPassword = ""
	TR_Inquiry("obcsb_acad_002r")
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	g_szNoticeType = "" 			'발송물 통보처 유형 코드
	g_szNoticeSerial = "" 			'발송물 통보처 일련번호
	g_szMailType = ""				'우편물 통보처 유형 코드
	g_szMailSerial= "" 			'우편물 통보처 일련번호
	g_szHtsYN = "N" 				'HTS불원등록 약정상태 변수
	g_szJangoYN = "N" 			'잔고통보처 약정 상태 변수
	g_szCSNM = "" 				'고객명
	g_szPostalIndex = 0 			'우편물 통보처 인덱스
	g_szTrInformIndex = 0 			'거래내역 통보처 인덱스	
	g_szContClsCode = ""			'접촉구분코드
	g_szProsClsCode = ""			'처리구분코드
	g_szFundRmndRcmsClsCode = ""	'펀드잔고수신구분코드	
	g_szCustClsCode = ""			'고객구분코드
	g_szContClsCode = "4"			'접촉구분코드
	g_szProsClsCode = "5"			'처리구분코드
	g_szCsno = ""					'고객번호
	g_szMobileYn = ""
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	g_szAccountNumber = cmbAccount.total	
	
	btnSearch_OnClick()	'조회
End Sub

