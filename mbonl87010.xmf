Sub Container0_rdoReportSendPlace_OnClick(nIndex)
	g_szTempRadio1 = nIndex
	if nIndex == 0 then
		g_szNoticeType = "13"
	elseif nIndex == 1 then
		g_szNoticeType = "21"
	elseif nIndex == 2 then
		g_szNoticeType = "01"
	elseif nIndex == 3 then
		g_szNoticeType = "02"
	elseif nIndex == 4 then
		g_szNoticeType = "03"
	else
	
	end if
	
End Sub


'============================================================================
