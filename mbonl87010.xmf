'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl87020" then	'불원등록에서 넘어옴
		if sRet == "ok" then	
			btnSearch_OnClick()	'재조회
		end if
	end if
	
	if sKeyName == "mbonl81000" then	'고객연락처변경에서 넘어옴
		if sRet == "ok" then
			btnSearch_OnClick()	'재조회
		end if

	end if
End Sub





'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_szAccountNumber = cmbAccount.total
	'v0002
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    g_szPassword = edtPassword.caption
	else  'MTS메모리평문 미적용상태일때
	    g_szPassword = Form.GetEncData(edtPassword.caption)
	end if	
	
	edtPassword.caption = ""
	'Container0.rdoReportSendPlace.currentindex = 4
	'Container0.rdoMailSendPlace.currentindex	= 3
	'btnSearch_OnClick()
	Form_OnFormInit()
		

End Sub


'============================================================================
'edtPassword_OnEditComplete
'============================================================================
Sub edtPassword_OnEditComplete()
	'v0002
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_szPassword = edtPassword.caption
		g_szTempPassword = edtPassword.caption  '암호화된 정보로 설정됨
	else  'MTS메모리평문 미적용상태일때
		g_szPassword = Form.GetEncData(edtPassword.caption)
		g_szTempPassword = edtPassword.caption  '미암호화된 정보로 설정됨
	end if

	Form_OnFormInit()
End Sub


