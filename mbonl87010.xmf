'============================================================================
' Container0_imgHomeChange_OnClick -  자택주소변경 클릭
'============================================================================
Sub Container0_imgHomeChange_OnClick()
	
	g_szTempAccountNumber = g_szAccountNumber
	
	'v0002 비밀번호 자릿수설정
	Dim pwdLen
	pwdLen = edtPassword.pwdlen
	If pwdLen = "" Or pwdLen == Null Then
	    pwdLen = 0
	End If

	'v0002 메모리평문적용여부에 따라 암호화/비암호화된 정보로 넘어가므로 연계화면 변경시 확인필수
	g_szTempPassword = edtPassword.caption
	g_szPassword = g_szTempPassword
	
	if g_szPassword == "" then
		Form.MsgBox("알림", "비밀번호를 입력하세요", "", 0)
	else
		'v0002 (평문적용)계좌번호;암호화비밀번호;1;비밀번호길이(Lx)
		If g_plain_rm == "1" Then 
			g_szOpenData =  g_szTempAccountNumber & ";" & g_szPassword & ";" & "1" & ";" & "L" & CStr(pwdLen)
		Else '(평문미적용)계좌번호;평문비밀번호;1	
			g_szOpenData =  g_szTempAccountNumber & ";" & g_szPassword & ";" & "1"
		End If
		Form.OpenFramePopup("mbonl81000" , g_szOpenData , sPosInfo)
	end if
End Sub


