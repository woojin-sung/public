	<SCRIPT_INFO _len="4716" _ulen="4208" >
'--===========================================================================
' 01. 화 면 명 : 타사투자경험잔고증명서제출
' 02. 화면설명 : 타사투자경험잔고증명서제출
' 03. 작    성 : 2022.04.15 KSJ
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szImg		'등록 이미지

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	contProcess.imgNo0.setMaintainingRatio("1")
	contProcess.imgNo1.setMaintainingRatio("1")
	contProcess.imgNo2.setMaintainingRatio("1")
End Sub


'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szImg = ""

	Dim szOpenData
	szOpenData = Trim(Form.GetOpenLinkData())
	If szOpenData <> null and szOpenData <> "" Then		
		Dim tData
		tData = Split(szOpenData, "★")
		If Ubound(tData) > 0 Then
			If tData[0] <> NULL and tData[0] <> "" Then
				If tData[0] == "0" Then
					lblTitle.caption = "타사 투자 경험 계좌확인서 제출"
					tblInfo.SetCellString( 2, 1, "'계좌확인서'")
					contProcess.tblNo.SetCellString( 1, 1, "신청용 계좌 확인서만 가능합니다.")
					
				End If
			End If
		
			If tData[1] <> NULL and tData[1] <> "" Then
				lblFirm.caption = Trim(tData[1])	'기관명 SET
				If  tData[2] <> NULL and tData[2] <> "" Then	
					g_szImg = tData[2]			'이미지 SET
					imgPicture.SetImageDataEnc(g_szImg)
					btnNext.enable = true
				End If
			End If
		End If
	End If
End Sub
'============================================================================
' Form_OnFormBackKeyPressed() : 화면닫기
'============================================================================
Sub Form_OnFormBackKeyPressed()	
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick() : 화면닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
' btnUpload() : 이미지 업로드
'============================================================================
Sub btnUpload_OnClick()
	Form.getGalleryImage()	
End Sub
'============================================================================
'  btnCam() : 재촬영
'============================================================================
Sub btnCam_OnClick()
	Form.runOsCamera()
End Sub

'============================================================================
' btnNext_OnClick() : 잔고증명서 제출
'============================================================================
Sub btnNext_OnClick()
	If g_szImg == null or g_szImg == "" Then
		Form.ShowAlert("알림", "제출할 이미지가 없습니다.")
		Exit Sub
	End If
	
	If Len(g_szImg) > 102400 then	'이미지 최대사이즈
		Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
		Exit Sub
	End If

	Form.SendReturnToParent("close_mbonl94002_p32" , g_szImg)
	Form.CloseForm()
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 이미지 선택 또는 촬영 후 트리거이벤트로 이미지 전달
	' 정상처리 시, 공유변수 통해 이미지 데이터 가져오기 
	' # 트리거 이벤트 명  : CAPTURECOMPLETE
	' # sParam            : 1 정상 / 0 비정상
	' # 캡쳐이미지        : &RET_CAPTURE_IMAGE
	if sEventName = "CAPTURECOMPLETE" then
'		if sParam = "1" then	'아이폰은 sPram 바로 데이터로 처리
			g_szImg = Form.GetSharedData("&RET_CAPTURE_IMAGE", true )
			if Len(g_szImg) < 102400 then	'이미지 최대사이즈 
				imgPicture.SetImageDataEnc(g_szImg)
				btnNext.enable = true
			Else
				Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
			end if	
'		end if
	end if 
End Sub

	</SCRIPT_INFO>
