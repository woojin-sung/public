'============================================================================
' 화 면 명 : 채권주문_잔고팝업
' 화면설명 : 채권주문 매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.01.30     test3
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function fn_CodeToName(szTitle, szCode)
 Select Case szTitle
  Case "Trade"
   Select Case szCode
    Case "1" return "매도"
    Case "2" return "매수"
    Case "3" return "매수청산"
    Case "4" return "매도청산"
    Case "5" return "권리행사"
    Case "6" return "의무배정"
    Case "7" return "행사포기"
    Case "8" return "의무면제"
    Case "A" return "인수대금"
    Case "B" return "인도대금"
    Case "C" return "단주행사"
    Case "D" return "단주배정"
    Case "0" return "상계"
   end Select 
  
  Case "MC"
   Select Case szCode
    Case "1" return "정상"
    Case "2" return "정정"
    Case "3" return "취소"
   end Select
end Select
End Function

'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	Dim szData, szReturnValue
	Dim szCode, szRtvl, szRctf, szAddTxt

	For i = 0 To grdList.rowcount -1  
		szData = grdList.GetCellData("bd_Gbn", i)
		szCode = grdList.GetCellData("bd_Type", i)
		szRctf = grdList.GetCellData("bd_Rctf", i)  '정정취소구분코드
		
		'매도
		if szData == "1" then
			grdList.SetCellFgColor("bd_Gbn", i, "11")
		'매수
		else 
			grdList.SetCellFgColor("bd_Gbn", i, "10")
		end if
		
		szReturnValue = Form.GetMetaData("매매구분코드", szData)
		szRtvl = Form.GetMetaData("채권매매시장구분코드", szCode)'''주문유형->시장구분&거래구분?(2.22)
		
		if tostring(szRctf) == "1" then
			grdList.SetCellData("bd_Gbn", i, szReturnValue)
		else
			szAddTxt = fn_CodeToName( "MC", szRctf )
			grdList.SetCellData("bd_Gbn", i, szReturnValue&szAddTxt)
		end if
		
		
		
		grdList.SetCellData("bd_Type", i, szRtvl)
		'grdList.SetCellData("bd_Ctype", i, szRtvl)
	Next	
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("미체결내역")
	
	szOpen = Form.GetOpenLinkData()
	g_szChk = "0"
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
	end if
	
	DATAMANAGER.RequestTranData( "obtrs_cntg_660r" )
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtrs_cntg_660r" Then
		DATAMANAGER.ClearInputData(0,"obtrs_cntg_660r" )	
		
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ASNO", 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ODER_TYPE_CLS_CODE", 0, "09") '채권주문유형
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "CNTG_CLS_CODE", 0, "2")
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtrs_cntg_660r" Then
	    If DATAMANAGER.IsMoreNextData( "obtrs_cntg_660r" ) = True then
	       DATAMANAGER.RequestNextData( "obtrs_cntg_660r" )
	    Else    
	       SetGridData()
	    End If   
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szNo, szData, szPrc, szMktNm, szMktCd, szType, szOpt 
	
	if lRow > -1 then
		szCd = grdList.GetCellData("bd_Cd", lRow)
		szQty= grdList.GetCellData("bd_Noqty", lRow)
		szNo = grdList.GetCellData("bd_No", lRow)	
		szPrc = grdList.GetCellData("bd_Oprice", lRow)	
        szMktNm = grdList.GetCellData("bd_Type", lRow)
	    if szMktNm == "일반시장" then
			szMktCd = "B"  '장내
		else
			szMktCd = "SB"  '소액
		end if
		szType = grdList.GetCellData("bd_Gbn", lRow)
		szOpt = grdList.GetCellData("bd_cell1", lRow)
		'  전달내용/탭위치/종목코드/수량/번호/가격/시장구분/매매구분/조건구분 (시장구분 이하 추가)
		'szData = "미체결" & "★" & g_szTab & "★" & szCd & "★" & szQty & "♥" & szNo & "♥" & szPrc 
        szData = "미체결" & "★" & g_szTab & "★" & szCd & "★" & szQty & "★" & szNo & "★" & szPrc & "★" & szMktCd & "★" & szType & "★" & szOpt
		Form.SendReturnToParent("54050_CONTRACT", szData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()	
	DATAMANAGER.RequestTranData( "obtrs_cntg_660r" )
	
End Sub





