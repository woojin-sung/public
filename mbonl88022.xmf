	<SCRIPT_INFO _len="3991" _ulen="3869" >

'============================================================================
' 화 면 명 : 대차중개약정 메인
'============================================================================

Dim g_szOSType
Dim g_szScreenNo

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	
	contMain.imgCheck1.setMaintainingRatio("1")
	contMain.imgCheck2.setMaintainingRatio("1")
	contMain.imgCheck3.setMaintainingRatio("1")
	contMain.imgCheck4.setMaintainingRatio("1")
	
	contMain.Image0.setMaintainingRatio("1")
	contMain.Image1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contMain.lblUpperBg.bgcolor = 397
	contMain.Label2.fgcolor = 398

	contMain.lblTitle1.setHighlight(396)
	contMain.lblTitle2.setHighlight(396)
	
	g_szScreenNo = Form.GetSharedData("&SCREEN_NO" , false)
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)	'iOS("2")Android("1")
	
	if g_szOSType == "1" then
		contMain.lblSubText1.ChangeTextAttr(4, 7, 4, -2, true)
		contMain.lblSubText2.ChangeTextAttr(18, 14, 4, -2, true)
		contMain.lblSubText4.ChangeTextAttr(6, 7, 4, -2, true)
		contMain.lblSubText4.ChangeTextAttr(20, 11, 4, -2, true)		
	else
		contMain.lblSubText1.ChangeTextAttr(4, 7, 4, -2, true)
		contMain.lblSubText2.ChangeTextAttr(18, 15, 4, -2, true)
		contMain.lblSubText4.ChangeTextAttr(6, 7, 4, -2, true)
		contMain.lblSubText4.ChangeTextAttr(20, 12, 4, -2, true)
	end if
	
'	imgInfo.visible = false
	contMain.lblMore.caption = "자세히 알아보기 >"
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		contMain.setScrollBarVisible("2")
	end if
	
	DATAMANAGER.RequestTranData( "obpds_srvc_568r" )	'대차중개약정내역조회
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	if szTranID == "obpds_srvc_568r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "2"	         )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"          , 0 , szCustNum	)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obpds_srvc_568r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
		if nCnt > 0 then
			btnNext.caption = "신청정보 보기"			
		else
			btnNext.caption = "대차중개약정 신청"			
		end if
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgText, szSubText
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.openPrevScreen()
End Sub

'============================================================================
Sub contMain_lblMore_OnClick()
	'자세히 알아보기 연결
	Form.OpenPopup("mbonl88022_p1" , "" , "")
End Sub

'============================================================================
Sub btnNext_OnClick()
	if btnNext.caption == "신청정보 보기" then	
		lnkMain.left = 0
		lnkMain.linkfile = "mbonl88022_s1"
		
		Form.triggerEvent("lnkMain", "list", "")
	else
		lnkMain.left = 0
		lnkMain.linkfile = "mbonl88022_s1"
		
		Form.triggerEvent("lnkMain", "init", "")
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "init" then
		lnkMain.left = 400
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
