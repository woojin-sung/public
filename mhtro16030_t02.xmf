'============================================================================
function _tonumber(data)
	return tonumber(data) or 0
end function

'============================================================================
' 거래소명 ID 숫자로 변환
'============================================================================
function TransformName_Exid(sValue)
	if sValue == "홍콩" then	' HKS
		return "104"
	elseif sValue == "항셍 지수" then ' HSI
		return "529"
	elseif sValue == "상해" then ' SHS
		return "215"
	elseif sValue == "심천" then ' SZS
		return "214"
	elseif sValue == "뉴욕" then ' NYS
		return "321"
	elseif sValue == "아멕스" then ' AMX
		return "66"
	elseif sValue == "나스닥" then ' NAS
		return "537"
	elseif sValue == "미국" then ' NAO
		return "990"
	elseif sValue == "S&P" then ' SPI
		return "625"
	elseif sValue == "다우존스" then ' DJI
		return "310"
	elseif sValue == "도쿄" then ' TSE
		return "106"
	elseif sValue == "오사카" then ' OSE 
		return "107"
	elseif sValue == "자스닥" then ' JSD
		return "112"
	elseif sValue == "니케이" then ' NII
		return "889"
	elseif sValue == "나스닥" then ' NAI (미국)
		return "538"
	elseif sValue == "호치민" then ' HSX
		return "770"
	elseif sValue == "하노이" then ' HNX
		return "771"
	end if
end function


'============================================================================
function Check_Button0_Enable()	
	Dim ChkBtn0
	Dim ChkBtn1
	Dim ChkBtn2
	Dim ChkBtn3
	Dim ChkBtn4
	
	ChkBtn0 = ChkButton0.checkstate
	ChkBtn1 = ChkButton1.checkstate
	ChkBtn2 = ChkButton2.checkstate
	ChkBtn3 = ChkButton3.checkstate
	ChkBtn4= ChkButton4.checkstate
	
	Button0.enable = 0
	
	' 체크박스 상태 확인
	if ChkBtn0 == "1" or ChkBtn1 == "1" or ChkBtn2 == "1" or ChkBtn3 == "1" or ChkBtn4 == "1"  then
		if _tonumber(Edit0.caption) >= 0 and _tonumber(Edit1.caption) >= 0 then
			Button0.enable = 1
		elseif _tonumber(Edit2.caption) >= 0 and _tonumber(Edit3.caption) >= 0 then
			Button0.enable = 1
		elseif _tonumber(Edit4.caption) >= 0 and _tonumber(Edit5.caption) >= 0 then
			Button0.enable = 1
		elseif _tonumber(Edit6.caption) >= 0 and _tonumber(Edit7.caption) >= 0 then
			Button0.enable = 1
		elseif _tonumber(Edit8.caption) >= 0 and _tonumber(Edit9.caption) >= 0 then
			Button0.enable = 1
		end if
	else
		Button0.enable = 0
	end if

end function

