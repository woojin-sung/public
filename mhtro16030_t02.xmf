Sub Form_OnFormInit()

	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Dim sExid
	Dim ChkBtn0, ChkBtn1, ChkBtn2, ChkBtn3, ChkBtn4
	Dim g_stpr, g_enpr
	Dim g_stsi, g_ensi
	Dim g_stvo, g_envo
	Dim g_step, g_enep
	Dim g_stpe, g_enpe
	
	sExid = Form.GetSharedData( "16030_SEARCH_EXID", 0 )
	ChkBtn0 = Form.GetSharedData( "16030_SEARCH_CHK0", 0 )
	ChkBtn1 = Form.GetSharedData( "16030_SEARCH_CHK1", 0 )
	ChkBtn2 = Form.GetSharedData( "16030_SEARCH_CHK2", 0 )
	ChkBtn3 = Form.GetSharedData( "16030_SEARCH_CHK3", 0 )
	ChkBtn4 = Form.GetSharedData( "16030_SEARCH_CHK4", 0 )
	g_stpr = Form.GetSharedData( "16030_SEARCH_STPR", 0 )
	g_enpr = Form.GetSharedData( "16030_SEARCH_ENPR", 0 )
	g_stsi = Form.GetSharedData( "16030_SEARCH_STSI", 0 )
	g_ensi = Form.GetSharedData( "16030_SEARCH_ENSI", 0 )
	g_stvo = Form.GetSharedData( "16030_SEARCH_STVO", 0 )
	g_envo = Form.GetSharedData( "16030_SEARCH_ENVO", 0 )
	g_step = Form.GetSharedData( "16030_SEARCH_STEP", 0 )
	g_enep = Form.GetSharedData( "16030_SEARCH_ENEP", 0 )
	g_stpe = Form.GetSharedData( "16030_SEARCH_STPE", 0 )
	g_enpe = Form.GetSharedData( "16030_SEARCH_ENPE", 0 )
		
	Combo0.cbkeydata = sExid
	ChkButton0.checkstate = ChkBtn0
	ChkButton1.checkstate = ChkBtn1
	ChkButton2.checkstate = ChkBtn2
	ChkButton3.checkstate = ChkBtn3
	ChkButton4.checkstate = ChkBtn4
	if ChkBtn0 == "1" then
		Edit0.caption = g_stpr
		Edit1.caption = g_enpr
	end if
	if ChkBtn1 == "1" then
		Edit2.caption = g_stsi
		Edit3.caption = g_ensi
	end if	
	if ChkBtn2 == "1" then
		Edit4.caption = g_stvo
		Edit5.caption = g_envo
	end if
	if ChkBtn3 == "1" then
		Edit6.caption = g_step
		Edit7.caption = g_enep
	end if
	if ChkBtn4 == "1" then
		Edit8.caption = g_stpe
		Edit9.caption = g_enpe
	end if
	SetControlNation()
end Sub

