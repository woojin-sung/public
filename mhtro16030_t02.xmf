'============================================================================
Sub Button0_OnClick()
	Dim result
	result = isValidationCheck()
	if result == true then
		' 검색	
		g_nation =  Combo0.cbkeydata '국가
		g_stpr =  Edit0.caption 	'현재가
		g_enpr =  Edit1.caption 
		g_stsi =  Edit2.caption 	'시가총액 
		g_ensi =  Edit3.caption 	
		g_stvo =  Edit4.caption 	'거래량(주)
		g_envo =  Edit5.caption 
		g_step =  Edit6.caption 	'EPS
		g_enep =  Edit7.caption 
		g_stpe =  Edit8.caption 	'PER
		g_enpe =  Edit9.caption 
		
		Dim ChkBtn0
		Dim ChkBtn1
		Dim ChkBtn2
		Dim ChkBtn3
		Dim ChkBtn4
		
		ChkBtn0 = ChkButton0.checkstate
		ChkBtn1 = ChkButton1.checkstate
		ChkBtn2 = ChkButton2.checkstate
		ChkBtn3 = ChkButton3.checkstate
		ChkBtn4= ChkButton4.checkstate
		
		Form.SetSharedData("16030_SEARCH_EXID", Combo0.cbkeydata)
		Form.SetSharedData("16030_SEARCH_CHK0", ChkBtn0)
		Form.SetSharedData("16030_SEARCH_STPR", g_stpr)
		Form.SetSharedData("16030_SEARCH_ENPR", g_enpr)
		Form.SetSharedData("16030_SEARCH_CHK1", ChkBtn1)
		Form.SetSharedData("16030_SEARCH_STSI", g_stsi)
		Form.SetSharedData("16030_SEARCH_ENSI", g_ensi)
		Form.SetSharedData("16030_SEARCH_CHK2", ChkBtn2)
		Form.SetSharedData("16030_SEARCH_STVO", g_stvo)
		Form.SetSharedData("16030_SEARCH_ENVO", g_envo)
		Form.SetSharedData("16030_SEARCH_CHK3", ChkBtn3)
		Form.SetSharedData("16030_SEARCH_STEP", g_step)
		Form.SetSharedData("16030_SEARCH_ENEP", g_enep)
		Form.SetSharedData("16030_SEARCH_CHK4", ChkBtn4)
		Form.SetSharedData("16030_SEARCH_STPE", g_stpe)
		Form.SetSharedData("16030_SEARCH_ENPE", g_enpe)		
		
	'	g_stpr = _tonumber( Edit0.caption )	'현재가
	'	g_enpr = _tonumber( Edit1.caption )
	'	g_stsi = _tonumber( Edit2.caption )	'시가총액
	'	g_ensi = _tonumber( Edit3.caption )	
	'	g_stvo = _tonumber( Edit4.caption )	'거래량(주)
	'	g_envo = _tonumber( Edit5.caption )
	'	g_step = _tonumber( Edit6.caption )	'EPS
	'	g_enep = _tonumber( Edit7.caption )
	'	g_stpe = _tonumber( Edit8.caption )	'PER
	'	g_enpe = _tonumber( Edit9.caption )
		
		if g_nation == "US" then
			if RadioGroup0.currentindex == "0" then
				g_market = ""
			elseif RadioGroup0.currentindex == "1" then
				g_market = "NY"
			elseif RadioGroup0.currentindex == "2" then
				g_market = "AX"
			elseif RadioGroup0.currentindex == "3" then
				g_market = "OQ"
			end if
		elseif g_nation == "CN" then
			if RadioGroup1.currentindex == "0" then
				g_market = "SH"
			elseif RadioGroup1.currentindex == "1" then
				g_market = "SZ"
			end if
		else
			g_market = ""
		end if
		
		sOpenData = g_nation
		sOpenData = sOpenData.."`"..g_market
		sOpenData = sOpenData.."`"..g_stpr
		sOpenData = sOpenData.."`"..g_enpr
		sOpenData = sOpenData.."`"..g_stsi
		sOpenData = sOpenData.."`"..g_ensi
		sOpenData = sOpenData.."`"..g_stvo
		sOpenData = sOpenData.."`"..g_envo
		sOpenData = sOpenData.."`"..g_step
		sOpenData = sOpenData.."`"..g_enep
		sOpenData = sOpenData.."`"..g_stpe
		sOpenData = sOpenData.."`"..g_enpe
		
		if sOpenData <> nil and sOpenData <> "" then
'			Form.OpenPopup("mhtro16030_s20" , sOpenData , "")
			Form.OpenScreen("16034", "mhtro16030_s20★"..sOpenData)
		end if
	end if	
end Sub

Sub isValidationCheck()
	Dim isChk1, isChk2, isChk3, isChk4, isChk5
	isChk1 = ChkButton0.checkstate
	isChk2 = ChkButton1.checkstate
	isChk3 = ChkButton2.checkstate
	isChk4 = ChkButton3.checkstate
	isChk5 = ChkButton4.checkstate
	
	Dim firstString, secondString
	Dim firstNum, secondNum
	if isChk1 == "1" then
		firstString = Edit0.caption
		secondString = Edit1.caption
		if firstString <> nil and firstString <> "" and firstString <> nil and firstString <> "" then
			firstNum = _tonumber( firstString )
			secondNum = _tonumber( secondString )
			if firstNum > secondNum then
				Form.ShowAlert("알림", "현재가 조건이 잘못되었습니다.")
				return false
			end if
		else
			Form.ShowAlert("알림", "현재가 조건이 입력되지 않았습니다.")
			return false
		end if		
	end if
	if isChk2 == "1" then
		firstString = Edit2.caption
		secondString = Edit3.caption
		if firstString <> nil and firstString <> "" and firstString <> nil and firstString <> "" then
			firstNum = _tonumber( firstString )
			secondNum = _tonumber( secondString )
			if firstNum > secondNum then
				Form.ShowAlert("알림", "시가총액 조건이 잘못되었습니다.")
				return false
			end if
		else
			Form.ShowAlert("알림", "시가총액 조건이 입력되지 않았습니다.")
			return false
		end if		
	end if
	if isChk3 == "1" then
		firstString = Edit4.caption
		secondString = Edit5.caption
		if firstString <> nil and firstString <> "" and firstString <> nil and firstString <> "" then
			firstNum = _tonumber( firstString )
			secondNum = _tonumber( secondString )
			if firstNum > secondNum then
				Form.ShowAlert("알림", "거래량(주) 조건이 잘못되었습니다.")
				return false
			end if
		else
			Form.ShowAlert("알림", "거래량(주) 조건이 입력되지 않았습니다.")
			return false
		end if		
	end if
	if isChk4 == "1" then
		firstString = Edit6.caption
		secondString = Edit7.caption
		if firstString <> nil and firstString <> "" and firstString <> nil and firstString <> "" then
			firstNum = _tonumber( firstString )
			secondNum = _tonumber( secondString )
			if firstNum > secondNum then
				Form.ShowAlert("알림", "EPS 조건이 잘못되었습니다.")
				return false
			end if
		else
			Form.ShowAlert("알림", "EPS 조건이 입력되지 않았습니다.")
			return false
		end if		
	end if
	if isChk5 == "1" then
		firstString = Edit8.caption
		secondString = Edit9.caption
		if firstString <> nil and firstString <> "" and firstString <> nil and firstString <> "" then
			firstNum = _tonumber( firstString )
			secondNum = _tonumber( secondString )
			if firstNum > secondNum then
				Form.ShowAlert("알림", "PER 조건이 잘못되었습니다.")
				return false
			end if
		else
			Form.ShowAlert("알림", "PER 조건이 입력되지 않았습니다.")
			return false
		end if		
	end if
	
	return true
end Sub

