Sub Edit0_OnEditComplete()
	Dim sTemp
	sTemp = Trim(CDbl(Edit0.caption))
	if sTemp <> Trim(Edit0.caption)	then
		Form.ShowAlert("알림", "숫자를 입력해주세요")
		Edit0.caption = ""
	else
		Edit0.caption = sTemp
	end if
	
	Check_Button0_Enable()
End Sub

