	<SCRIPT_INFO _len="2814" _ulen="2682" >
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"


'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" And szOpenData <> null Then
		
		arrData = Split(szOpenData, "`")
		
		if arrData(0) == "0" then
			Table0.visible = true
			Table1.visible = false
			Table2.visible = false
			
			for i = 1 to 13
				Table0.SetCellString(i-1, 1, arrData(i))
			next
			
			if arrData(5) == "외화매도" then
				Table0.SetCellFgColor(7, 1, g_szTxtColor_Blue)
				Table0.setPropTable("fontstyle", 7, 1, "01")
			elseif arrData(5) == "외화매수" then
				Table0.SetCellFgColor(8, 1, g_szTxtColor_Red)
				Table0.setPropTable("fontstyle", 8, 1, "01")
			end if
		elseif arrData(0) == "1" then
			Table0.visible = false
			Table1.visible = true
			Table2.visible = false
			
			for i = 1 to 15
				Table1.SetCellString(i-1, 1, arrData(i))
			next
			
			if arrData(5) == "외화매도" then
				Table1.SetCellFgColor(7, 1, g_szTxtColor_Blue)
				Table1.setPropTable("fontstyle", 7, 1, "01")
			elseif arrData(5) == "외화매수" then
				Table1.SetCellFgColor(8, 1, g_szTxtColor_Red)
				Table1.setPropTable("fontstyle", 8, 1, "01")
			end if
		elseif arrData(0) == "2" then
			Table0.visible = false
			Table1.visible = false
			Table2.visible = true
			
			for i = 1 to 17
				Table2.SetCellString(i-1, 1, arrData(i))
			next
			
			if arrData(12) == "미정" then
				Table2.SetCellFgColor(11, 1, g_szTxtColor_Grey)
			end if
			
			if arrData(13) == "미정" then
				Table2.SetCellFgColor(12, 1, g_szTxtColor_Grey)
			end if
			
			if arrData(14) == "미정" then
				Table2.SetCellFgColor(13, 1, g_szTxtColor_Grey)
			end if
			
			if arrData(4) == "외화매도" then
				if arrData(12) <> "미정" then
					Table2.SetCellFgColor(11, 1, g_szTxtColor_Blue)
					Table2.setPropTable("fontstyle", 11, 1, "01")
				end if
			elseif arrData(4) == "외화매수" then
				if arrData(13) <> "미정" then
					Table2.SetCellFgColor(12, 1, g_szTxtColor_Red)
					Table2.setPropTable("fontstyle", 12, 1, "01")
				end if
			end if
		end if
	else
		Exit Sub
	end if
	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>