	<SCRIPT_INFO _len="6258" _ulen="5848" >
'--===========================================================================
' 작성 : 2021.02.17. 장원혁...
' 2021.10.25 : 김수진 : v0001 : 중개형 ISA 추가
' 2023.01.18 : 강희승 : v0002 : 연금저축추가	T2210110004
' 2023.09.18 : 정우희 : v0003 : 펀드위험등급	노출 값 변경
'--===========================================================================
Dim	aFlag
Dim	ProductCnt
Dim	scrollIndex
Dim	Grade
Dim	RCNO_PIP

Dim	MBBDM86176_YN

Dim	GRADE_PRCD100
'v0002 sta
Dim	GRADE_PRCD131
'v0002 fin
Dim	GRADE_PRCD101
Dim	GRADE_PRCD135
'v0001 sta
Dim	GRADE_PRCD133
'v0001 fin
Dim	GRADE_PRCD200

Dim	g_Fund_Grade			 'v0003
Dim	g_Fund_Grade_Name		 'v0003
Dim	g_BDM_PRCD100			 '종합매매 가입여부
Dim	g_BDM_PRCD200			 '슈퍼365	가입여부
Dim	g_BDM_PRCD101			 '선물옵션 가입여부
Dim	g_BDM_PRCD135			 '해외파생 가입여부
'v0002 sta
Dim	g_BDM_PRCD131			 '연금저축 가입여부
'v0002 fin
'v0001 sta
Dim	BDM_PRCD133			'ISA 가입여부
Dim	g_BDM_ISA_PROD_TYPE	'ISA 타입	(중개형ISA	:3/	일임형	ISA:2)
'v0001 fin

Dim	g_KYC_GRAD			  '(고객적용)투자성향등급
Dim	g_APLY_KYC_GRAD		  '(종합매매)투자성향등급
Dim	g_APLY_PROD_GRAD	  'KYC상품등급코드
Dim	g_APLY_UNFIT_YN		  '부적합여부
'Dim g_APLY_DVPD_KYC_GRAD  '선물옵션투자성향등급코드
Dim	g_APLY_DVPD_PROD_GRAD '선물옵션상품등급코드
Dim	g_APLY_DVPD_UNFIT_YN  '선물옵션부적합여부



'============================================================================
Sub	Form_OnFormInit()
	Dim	szOpenData

	if Form.GetSharedData("&OS_TYPE", false) ==	"1"	then
		Container.setScrollBarVisible("2")
	end	if

	scrollIndex	= 1100
	ProductCnt = 0

	Container.Container1.LblInfr1.bgcolor =	272
	Container.Container1.LblInfr2.bgcolor =	271
	Container.ImgChk.imgpath = "check_square_off.png"

	Container.Container1.height	= 280
	Container.Container1.ContainerAccord.height	= 0
	Container.SetScrollAutoSize()
	aFlag =	0


	g_KYC_GRAD =	Form.GetSharedData("APRT_CUST_GRAD"	, false)  '(고객적용)투자성향등급

	szOpenData = Form.GetOpenLinkData()

	If g_KYC_GRAD = "03" Then
		g_PROD_GRAD = "04"
	ElseIf g_KYC_GRAD = "04" Then
		g_PROD_GRAD = "05"
	ElseIf g_KYC_GRAD = "05" Then
		g_PROD_GRAD = "06"
	Else
		g_PROD_GRAD = g_KYC_GRAD
	End If
	
	Container.Grid1.SetCellData("bd_cell1", 0, "투자성향 등급")
	Container.Grid1.SetCellData("bd_cell7", 0, "적합상품")
	Container.Grid1.SetCellData("bd_cell2", 0, Form.getMetaData("KYC투자성향등급코드", g_KYC_GRAD))
	Container.Grid1.SetCellData("bd_cell9", 0, Form.getMetaData("KYC상품등급코드", g_PROD_GRAD))
	
	Container.Grid2.rowcount = 0
	Container.Grid2.height   = 52

	If szOpenData <> "" And szOpenData <> null Then
		tData = NULL
		tData = Split(szOpenData, "@")

		For ix = 0 To Ubound(tData)
			If Trim(tData[ix]) <> "" And tData[ix] <> Null Then
				Container.Grid2.rowcount	= Container.Grid2.rowcount + 1
				Container.Grid2.height		= Container.Grid2.height + 40
				szTmp = Split(tData[ix], "$")
				Container.Grid2.SetCellData("bd_cell1", ix, szTmp[0]..szTmp[1])
				Container.Grid2.SetCellData("bd_cell2", ix, szTmp[2])
				Container.Grid2.SetCellData("bd_cell3", ix, Form.getMetaData("KYC상품등급코드", szTmp[3]))
			End If
		Next
		
		Container.lblPopup.top = Container.Grid2.top + Container.Grid2.height + 10
		Container.imgPopup.top = Container.Grid2.top + Container.Grid2.height + 5
		Container.btnPopup.top = Container.Grid2.top + Container.Grid2.height + 7
		Container.Container0.top = Container.Grid2.top + Container.Grid2.height + 30
		Container.Container1.top = Container.Container0.top + Container.Container0.height
		scrollIndex = scrollIndex + (50 * Container.Grid2.rowcount)
		Container.SetScrollAutoSize()
'		ScreenSet()

	else
		Form.ShowAlert("알림", "입력값이 없습니다.")
	end	if
End	Sub


'============================================================================
Sub	Form_OnTimerEvent(sTimerID)

	If trim(sTimerID) == "9999"	Then
		Form.SetTimerEvent2("9999",	0, 0.3)
		Container.Container1.height	= 280
		Container.scroll_pos = scrollIndex + 100
		Container.SetScrollAutoSize()
	End	If

End	Sub

'============================================================================
Sub	Container_Container1_BtnAccordion_OnClick()

	If aFlag ==	0 Then
		Container.Container1.height	= 450
		Container.Container1.ContainerAccord.setHeightResize(136)
		Container.SetScrollAutoSize()
		Container.scroll_pos = scrollIndex + 180
		Container.Container1.ImgArrow.imgpath =	"icon_caret_up.png"
		aFlag =	1
	Else
		Container.Container1.setHeightResize(350)
		Container.Container1.ContainerAccord.setHeightResize(0)
		Form.SetTimerEvent2("9999",	1, 0.3)
		Container.Container1.ImgArrow.imgpath =	"icon_caret_down.png"
		aFlag =	0
	End	If

End	Sub

'============================================================================
Sub	Form_OnFormClose()
	Form.SendReturnToParent("mbonl81010_unfit1" , g_sRetData)
End	Sub

'============================================================================
Sub	Form_OnFormBackKeyPressed()	 '안드로이드전용
	
End	Sub

'============================================================================
Sub	BtnCont_OnClick()
	Form.CloseForm()
End	Sub

'============================================================================
Sub	Form_OnPopupReturn(sKeyName, sRet)
End	Sub

'============================================================================
Sub	Container_BtnPopup_OnClick()
	Form.OpenPopup("mbbdm86175_p1.xmf" , ""	, "")
End	Sub

'============================================================================
Sub	DATAMANAGER_OnSendTranBefore(szTranID)
End	Sub

'============================================================================
Sub	DATAMANAGER_OnReceiveTranComplete(szTranID)
End	Sub

'============================================================================
Sub	DATAMANAGER_OnReceiveTranError(szTranID	, szErrCode	, szErrMsg)
End	Sub



'============================================================================
Sub BtnCont_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>