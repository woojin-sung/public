'	    Check_Accout = False
'	    Exit Function
'	End If
'	
'	If szAcpw = "" Then
'	    Form.ShowAlert( g_szTitle, "비밀번호를 확인후 다시 입력하십시오." )
'	    Check_Accout = False
'	    Exit Function
'	End If
'	Check_Accout = True
	'20160502 LKM END

	
	
End Function

'============================================================================
'	주문전송(주문확인창)
'============================================================================
Function Send_Order()	

	'주문전송
	If gszSet_OrdChkPop <> "0" Then	'주문입력확인창 사용시(주문설정) '20130715 scm start 주문고도화(주문확인창 방어로직)
	    Form.OpenPopup( "mbtrs12020_p7" , g_szPopupData , "")

	Else	'주문입력확인창 사용안함(주문설정) - 주문전송
		OrderRequest()

	End If   
    
End Function


'============================================================================
'<<<<주문전 확인사항>>>> 
'============================================================================
Function Check_Order(nRowIdx)
	Dim 	szAcctNo				'계좌번호
	Dim	szAcctName			'계좌명
	Dim 	szItmName			'종목명

	'계좌번호 확인 
    If Check_Accout() = False Then
	    Exit Function
    End If
    
    '20160502 LKM START - 비밀번호 체크 
    Dim szAcpw
    szAcpw	= Form.GetCtlProp("#edtPwd", "caption")
    If szAcpw = "" Then
	    Form.ShowAlert( g_szTitle, "비밀번호를 확인후 다시 입력하십시오." )
	    Exit Function
	End If
    '20160502 LKM END
    

	'계좌번호, 계좌명
	szAcctNo 	= Form.GetCtlProp("#acnt", "caption")
	szAcctName 	= Form.GetCtlProp("#acnt", "accountname")

	' 20180214 HAMWG START : 수익증권, 신주인수권 종목코드 세팅 변경(취소주문 오류)
	' 종목코드확인   
	g_szItmCode 	= grd0.GetCellData("bd_cell10", nRowIdx)
	g_szMarketType  = Form.GetItemCodeInfo( g_szItmCode , "market")
	
	if g_szMarketType <> "" then
		g_szItmCode 	= grd0.GetCellData("bd_cell10", nRowIdx)
	else
		g_szItmCode 	= grd0.GetCellData("bd_cell9", nRowIdx)
	end if
	' 20180214 HAMWG END

	'예약주문번호  
	g_szOrdNo = grd0.GetCellData("bd_cell1", nRowIdx)		

	'예약등록일자
	g_szDate = grd0.GetCellData( "bd_cell12", nRowIdx)
	
	' 종목명
	szItmName = grd0.GetCellData("bd_cell2", nRowIdx)

	'잔량전부(취소주문은 잔량 전부)
	g_szOrd_ChkAll = "1"

     
	'주문데이터    
	g_szPopupData = "14"										' 예약취소
	g_szPopupData = g_szPopupData & "|" & g_szMarketType			' 주문종류 ( J:주식, W:ELW )
	g_szPopupData = g_szPopupData & "|" & Trim(szAcctNo)			' 계좌번호
	g_szPopupData = g_szPopupData & "|" & szAcctName				' 고객명
	g_szPopupData = g_szPopupData & "|" & g_szItmCode				' 종목코드
	g_szPopupData = g_szPopupData & "|" & szItmName				' 종목명
	g_szPopupData = g_szPopupData & "|" & ""						' 주문구분
	g_szPopupData = g_szPopupData & "|" & ""						' 현금/신용
	g_szPopupData = g_szPopupData & "|" & ""						' 신용구분
	g_szPopupData = g_szPopupData & "|" & ""						' 대출일자
	g_szPopupData = g_szPopupData & "|" & ""						' 주문수량
	g_szPopupData = g_szPopupData & "|" & ""						' 주문가격
	g_szPopupData = g_szPopupData & "|" & g_szOrdNo				' 원주문번호
	g_szPopupData = g_szPopupData & "|" & g_szOrd_ChkAll			' 잔량전부

    
	Send_Order()	'주문전송

End Function

'============================================================================
''''''주문전송''''''
'============================================================================
Function OrderRequest()
    DATAMANAGER.RequestTranData( "obtrs_oder_510a" )	'정정/취소
    
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	Load_OrderSet()	
End Sub

'============================================================================
Sub Form_OnFormInit()

	Dim szAcpw
	szAcpw   = Form.GetCtlProp("#edtPwd", "caption")

	Form.SetCtlProp("cld1", "addday", "30")

	DATAMANAGER.RequestTranData( "obtrs_oder_511r" )

	'20200910 SWJ START
	'MTS메모리평문제거 적용유무
	'plain_rm = (0 : 미적용 / 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno,szAsno, szAcpw
	szAcno = Form.GetCtlProp("#acnt", "total")
	szAsno = Form.GetCtlProp("#acnt", "sequence")
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcpw = Form.GetCtlProp("#edtPwd"	, "caption")
	'MTS메모리평문제거 미적용상태일 때
	else
		szAcpw = Form.GetCtlProp("#edtPwd"	, "encdata")
	end if
	'20200910 SWJ END

	If szTranID = "obtrs_oder_511r" Then

		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_511r", "InBlock1", "ACNO"				, 0 , szAcno 		)	' 계좌1
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_511r", "InBlock1", "ASNO"				, 0 , szAsno 		)	' 계좌2
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_511r", "InBlock1", "ACNT_PWD"			, 0 , szAcpw		)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_511r", "InBlock1", "DEAL_CLS_CODE"		, 0 , "%" 		)	' 매매구분코드 1매도,2매수,%전체
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_511r", "InBlock1", "IQRY_CSNU"			, 0 , 30 		)	' 조회건수
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_511r", "InBlock1", "IQRY_CLS_CODE"		, 0 , "1" 		)	' 조회구분코드 1취소가능, 2전체
	
	
	'20160715 NOHES START 기간예약주문
	ElseIf szTranID = "obtrs_oder_510a" Then		'정정/취소
		Dim szItemCode
		
		'종목코드
	    If Left(g_szItmCode, 1) = "J" or Left(g_szItmCode, 1) = "F" Then
		    szItemCode = g_szItmCode
	    ElseIf g_szMarketType = "J" or g_szMarketType = "T" Then	'주식
		    szItemCode = "A" + g_szItmCode
		ElseIf g_szMarketType = "W" Then	'ELW
		    szItemCode = "J" + g_szItmCode
		Else
		    szItemCode = g_szItmCode
		End If
	    
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "SVCD" 				, 0 , "504" 			)	'서비스구분코드
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ACNO" 				, 0 , szAcno			)  	'계좌번호8
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ASNO" 				, 0 , szAsno 			)  	'계좌번호2
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ACNT_PWD"			, 0 , szAcpw 			)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ISCD" 				, 0 , szItemCode		)	'종목코드	    		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ADOD_TYPE_CODE"		, 0 , "" 			)	'예약주문 유형코드
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_UNPR" 			, 0 , ""			 	)	'주문가격
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_CLS_CODE" 		, 0 , "" 			)  	'주문구분코드		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "WARN_CNFR_YN" 		, 0 , g_szWarnClsCode	) 	'경고확인구분 '20140423 KBC 착오매매 제도개선
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0 , ""				)	'채널유형구분
		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_RSEV_MST_DATE"	, 0 , g_szDate				)	'예약등록일자
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_RSEV_MST_NO"	, 0 , g_szOrdNo			)	'채널유형구분
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
'	Dim szMsg, nRet
'	
'	If szTranID = "obtrs_oder_501a" Then
'		g_szWarnClsCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WARN_CLS_CODE"	, 0 ) '경고구분코드 (0.정상, 1.경고, 2.보류)
'		szMsg     	  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "UI_MSG_CNTT"		, 0 )
'		    
'		If g_szWarnClsCode = "2" Then
'			Form.Toast( 0, szMsg, True)
'		End If
'	End If		   
'		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtrs_oder_511r" Then
		
		For i = 0 To grd0.rowcount -1 
			Dim szISCD, szODER_CLS_CODE, szADOD_TYPE_CODE, szRSEV_TYPE_CODE, szCNCL_CLS_CODE
			
			szISCD			= grd0.GetCellData( "bd_cell9" , i)	'종목코드
			szODER_CLS_CODE	= grd0.GetCellData( "bd_cell18" , i)	'주문유형
			szADOD_TYPE_CODE	= grd0.GetCellData( "bd_cell8", i)	'매매구분
			szRSEV_TYPE_CODE	= grd0.GetCellData( "bd_cell19", i)	'예약구분
			szCNCL_CLS_CODE 	= grd0.GetCellData( "bd_cell20", i)  '취소구분
			szDEAL_CLS_CODE	= grd0.GetCellData( "bd_cellD1", i)
			
			'버튼 폰트색		
			grd0.SetCellData("bd_cell11", i, "취소")
			grd0.SetCellFgColor( "bd_cell11", i, "4")
			
			
			'종목코드
			grd0.SetCellData( "bd_cell10", i, Mid(szISCD, 2, 6 ) )
			
			'구분
			Select Case szODER_CLS_CODE
				Case "01"	grd0.SetCellData( "bd_cell15", i, "보통" )
				Case "05"	grd0.SetCellData( "bd_cell15", i, "시장가")
				Case "06"	grd0.SetCellData( "bd_cell15", i, "조건부지정가")
				Case "09"	grd0.SetCellData( "bd_cell15", i, "자기주식")
				Case "10"	grd0.SetCellData( "bd_cell15", i, "S-OPTION 자기주식")
				Case "11"	grd0.SetCellData( "bd_cell15", i, "금전신탁자기주식")
				Case "12"	grd0.SetCellData( "bd_cell15", i, "최유리 지정가")
				Case "13"	grd0.SetCellData( "bd_cell15", i, "최우선 지정가")
				Case "20"	grd0.SetCellData( "bd_cell15", i, "코넥스 경매매")
				Case "51"	grd0.SetCellData( "bd_cell15", i, "장중 대량매매")
				Case "52"	grd0.SetCellData( "bd_cell15", i, "장중 바스켓 매매")
				Case "53"	grd0.SetCellData( "bd_cell15", i, "장중 경쟁 대량매매")
				Case "61"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외종가")
				Case "62"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외대량")
				Case "63"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외 바스켓")
				Case "64"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외 경쟁 대량매매")
				Case "67"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외대량 자사주 신탁")
				Case "69"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외대량 자사주")
				Case "71"	grd0.SetCellData( "bd_cell15", i, "시간외 종가")
				Case "72"	grd0.SetCellData( "bd_cell15", i, "시간외 종가 대량매매")
				Case "77"	grd0.SetCellData( "bd_cell15", i, "금전신탁자기주식 시간외 대량매매")
				Case "79"	grd0.SetCellData( "bd_cell15", i, "자기주식 시간외 대량매매")
				Case "80"	grd0.SetCellData( "bd_cell15", i, "시간외 바스켓")
				Case "81"	grd0.SetCellData( "bd_cell15", i, "시간외 단일가")
				Case "X1"	grd0.SetCellData( "bd_cell15", i, "ECN")
			End Select		
			
			'주문종류
			Select Case szADOD_TYPE_CODE
				Case "01"	grd0.SetCellData( "bd_cell3", i, "현금매도" )
				Case "02"	grd0.SetCellData( "bd_cell3", i, "현금매수")
				Case "03"	grd0.SetCellData( "bd_cell3", i, "신용매도")
				Case "04"	grd0.SetCellData( "bd_cell3", i, "신용매수")
				Case "05"	grd0.SetCellData( "bd_cell3", i, "대주매수")
				Case "06"	grd0.SetCellData( "bd_cell3", i, "대주매도")
				Case "11"	grd0.SetCellData( "bd_cell3", i, "예탁담보")
				Case "12"	grd0.SetCellData( "bd_cell3", i, "소액담보")
				Case "13"	grd0.SetCellData( "bd_cell3", i, "대용매도")
			End Select		

			Select Case szDEAL_CLS_CODE
				Case "1"		grd0.SetCellFgColor( "bd_cell3", i, "11" )
				Case "2"		grd0.SetCellFgColor( "bd_cell3", i, "10" )
			End Select

			'예약구분
			Select Case szRSEV_TYPE_CODE
				Case "1"		grd0.SetCellData( "bd_cell13", i, "일반예약" )
				Case "2" 	grd0.SetCellData("bd_cell13", i, " 기간잔량" )
				Case "3" 	grd0.SetCellData("bd_cell13", i, "기간예약")
			End Select
			
			'취소구분
				
			If szCNCL_CLS_CODE = "01" Then
					grd0.SetCellData( "bd_cell6", i, "정상" )
					grd0.SetCellEnable( "bd_cell11", i, True )
			ElseIf 	szCNCL_CLS_CODE = "02" Then
					grd0.SetCellData( "bd_cell6", i, "취소")
					grd0.SetCellEnable( "bd_cell11", i, False )
			End If
			
		Next
				
	ElseIf szTranID = "obtrs_oder_510a" Then
		Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg
		
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		if szWarnCd = "1" then							' 경고
			g_szPopupData = g_szPopupData & "|" & szWarn	' 경고메세지		
			Form.OpenPopup("mbtrs12020_p8", szData , "")	' 경고팝업 오픈

		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
			
			if Trim(szOrdCd) = "5620" then			' 정상주문
				Form.Toast(0, szOrdMsg, true)
				
				if g_szAfterInit = "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				if g_szAfterOrg = "1" then			' 주문번호 연동
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					
					Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
				else
					Form.SetCtlProp("#edtOrgNo", "caption", "")
				end if
			end if
		end If
		
		g_szPopupData = ""
		btnSearch_OnClick()		
		
	End If
End Sub

'============================================================================
Sub btnSearch_OnClick()
	 
	If Check_Accout() = False Then
		Exit Sub
	End If
		
	DATAMANAGER.RequestTranData( "obtrs_oder_511r" )
	
End Sub

'============================================================================


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "주문전송" Then
		OrderRequest()
		
	End If
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	If szTranID = "obtrs_oder_510a" Then		
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
'			Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
'			Form.Toast(0, szErrMsg, true)
		end if
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_PASS" Then
		btnSearch_OnClick()
	
	'20160502 LKM START - 계좌변경 
	elseif sEventName = "CHANGE_ACCT" Then
		
		grd0.rowcount = 0	'기존내역 Clear
			
		If Check_Accout() = False Then
			Exit Sub
		End If
		
		btnSearch_OnClick()
	'20160502 LKM END
	End If
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	If szCellID == "bd_cell11" Then
		Call Check_Order(lRow)
	End If
End Sub

