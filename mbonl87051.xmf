	<SCRIPT_INFO _len="32719" _ulen="29721" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 해외주식 거래신청
' 02. 화면설명 : 해외주식 거래신청
' 03. 작    성 : 2017.12.20 윤유정
' 04. 수    정 : obcsb_acif_000r TR Call 87051_p1 으로 이동 v0001
'                법인고객 약정 불가능 체크
'              : 2018.02.26 윤유정 : 약관파일 URL 수정(변수 주석 해제) v0002
'              : 2019.04.30 장원혁 : 개인(신용)정보 제공 동의 항목 수정 (T1904100006) v0003
'                                    119 WRAP(종합매매) 계좌 선택 가능하도록 수정 (T1905220004) v0003
'			: 2020.03.31 김유경 : 약관 URL 변경 v0004
'			: 2020.09.16 권오상 : v005 : T2008250015 : 메모리평문 취약점 수정
'If g_PlainRm = "1" Then '보안모듈 적용
' 2021.05.22 : 정민영 : v006 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
' 2021.05.26 : 김수진 : 개인신용정보동의 공통팝업처리  obpds_srvc_045a PROS_DATE, PROS_SRNO
' 2021.07.19 : 정민영 : v008 : T2107090019 : 개인신용정보동의제도 개선
' 2022.08.12 : 양현정 : v009 : T2208100006 : 개인신용동의 팝업 띄우도록 함.
' 2023.10.04 : 강희승 : v010 : T2308250011 : 해외ETP 법인고객 메세지 미출력
' 2023.10.27 : 전상일 : v011 비밀번호 클리어 로직 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_Csno
Dim	g_Acno
Dim	g_Asno
Dim	g_nPassword
Dim	g_AprvYN 
	g_AprvYN = ""
Dim	g_SvcSrno 
	g_SvcSrno = 0 
Dim	g_CustEngName
	g_CustEngName = ""
Dim	g_ProsYn
	g_ProsYn = ""
Dim	g_NewEngName
	g_NewEngName = ""
Dim	g_URLheader 'v0002
Dim	g_ProsCls
	g_ProsCls = ""
Dim	g_CustClsCode 	  'v0001
	g_CustClsCode = ""
Dim	g_PlainRm  'v005
Dim g_szFnprJoinSrno		'금융상품일련번호
Dim g_szSvcSrno			'서비스일련번호
Dim szScreenNo 'v010        '화면번호
Dim g_FinCustomer 		'금융소비자 팝업 진행상태

'v0001 아래 obcsb_acif_000r OutBlock 변수 주석처리
'Dim	g_NtntCtcd			'국적국가
'	g_NtntCtcd = ""
'Dim	g_RsdcNtnlTxrtCode 	'거주국가
'	g_RsdcNtnlTxrtCode = ""
'Dim	g_LscClcd 			'양력구분 slcn_cls_code
'	g_LscClcd = ""
'Dim	g_Brdt				'생년월일
'	g_Brdt = ""
'Dim	g_WdngDate			'결혼 일자
'	g_WdngDate = ""
'Dim	g_BrthCtcd			'출생국가코드
'	g_BrthCtcd = ""
'Dim	g_AmrcYn				'미국인 여부
'	g_AmrcYn = ""
'Dim	g_AmlBstpLrdvCode		'AML업종대분류코드
'	g_AmlBstpLrdvCode = ""
'Dim	g_AmlBstpSmdvCode		'AML업종소분류코드
'	g_AmlBstpSmdvCode = ""
'Dim	g_Giin				'GIIN
'	g_Giin = ""	
'Dim	g_Lstn_yn			'상장여부
'	g_Lstn_yn = ""
'Dim	g_OvrsTxpmChdYn		'해외납세자여부
'	g_OvrsTxpmChdYn = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 컨트롤 초기화
'============================================================================
Function ClearCnt()
	g_AprvYN 			= ""
	g_SvcSrno 			= 0
	g_ProsCls 			= ""
	g_szSvcSrno			= ""
'	g_szFnprJoinSrno		= ""
'	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	'v0001
'	g_NtntCtcd 			= ""
'	g_RsdcNtnlTxrtCode	= ""
'	g_LscClcd 			= ""
'	g_Brdt 				= ""
'	g_WdngDate 			= ""
'	g_BrthCtcd 			= ""
'	g_AmrcYn 			= ""
'	g_AmlBstpLrdvCode 	= ""
'	g_AmlBstpSmdvCode 	= ""
'	g_Giin 				= ""	
'	g_Lstn_yn 			= ""
'	g_OvrsTxpmChdYn 		= ""
	
'	g_nPassword 			= Form.GetEncData(edtPassword.caption) 'v005
	'v005
	If g_PlainRm = "1" Then
		g_nPassword 	= edtPassword.caption
	Else
		g_nPassword 	= Form.GetEncData(edtPassword.caption)
	End If

	edtSrno.caption 		= ""
	
	tblState.SetCellString(0, 1, "")
	
	btnEnroll.enable 	= False
	btnEnroll.visible	= True
	btnCancle.enable	= False
	btnCancle.visible	= False
	
	btnProvision.enable = false
	btnModiTel.enable = false
	chkProvision.checkstate = "0"
	
	'약관체크박스
	ChkView0.chksilence = "0"
	ChkView1.chksilence = "0"
	ChkView2.chksilence = "0"
	ChkView3.chksilence = "0"
	g_CustClsCode = "" 'v0001
	
End Function
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	edtPassword.caption = "" 'v011 
	g_szFnprJoinSrno		= ""
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false ) 'v010
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )

	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	btnEnroll.enable 	= True     
	btnEnroll.visible	= True
	btnCancle.enable 	= False
	btnCancle.visible	= False
	
	'서류제공방식선택 추가
	btnProvision.enable = false
	btnModiTel.enable = false
	chkProvision.checkstate = "0"
		
	g_Acno 		= Left(cmbAccount.caption, 8)
	g_Asno 		= Right(cmbAccount.caption, 2)
'	g_nPassword 	= Form.GetEncData(edtPassword.caption) 'v005
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	'v005
	If g_PlainRm = "1" Then
		g_nPassword 	= edtPassword.caption
	Else
		g_nPassword 	= Form.GetEncData(edtPassword.caption)
	End If
	
	'계좌고객 정보 조회
	DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_Acno)
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub
'============================================================================
Sub edtPassword_OnEditComplete()
'	g_nPassword = Form.GetEncData(edtPassword.caption) 'v005
	'v005
	If g_PlainRm = "1" Then
		g_nPassword 	= edtPassword.caption
	Else
		g_nPassword 	= Form.GetEncData(edtPassword.caption)
	End If
	
'	if g_szFnprJoinSrno <> "" and g_szFnprJoinSrno <> null then
	'20230717 일련번호 없는 경우에만 채번되도록 함
	if trim(tblState.GetCellString(0, 1)) <> "약정" and len(trim(g_szFnprJoinSrno)) == 0 then 
		DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v007 금융상품 일련번호 GET	
	end if
'	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obacp_opop_064r" Then
		g_Csno		= DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		
		'고객 영문명 조회
		Table0.SetCellString(0, 1, "")
		ButtonView6.caption = "변경"
		
		DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNT_PWD" , 0 , g_nPassword)
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
		
		'해외주식 약정 내역 조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "082")	
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	
	ElseIf szTranID == "obcsb_acif_000r" Then
		
		g_CustClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_CLS_CODE" , 0)
		If g_CustClsCode = "2" and szScreenNo == "87051" Then 'v0001 법인고객 약정 불가능
			Form.ShowAlert( "알림" , "법인고객은 영업점 내점으로만 약정이 가능합니다.")
			Exit Sub
		Else
			g_CustEngName = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_ENG_NAME" , 0)
			
			'v0001
	'		g_NtntCtcd 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "NTNT_CTCD" , 0)
	'		g_RsdcNtnlTxrtCode	= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RSDC_NTNL_TXRT_CODE" , 0)
	'		g_LscClcd 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "SLCN_CLS_CODE" , 0)
	'		g_Brdt 				= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "BRDT" , 0)
	'		g_WdngDate 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "WDNG_DATE" , 0)
	'		g_BrthCtcd 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "BRTH_CTCD" , 0)
	'		g_AmrcYn 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "AMRC_YN" , 0)
	'		g_AmlBstpLrdvCode 	= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "AML_BSTP_LRDV_CODE" , 0)
	'		g_AmlBstpSmdvCode 	= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "AML_BSTP_SMDV_CODE" , 0)
	'		g_Giin 				= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "GIIN" , 0)
	'		g_Lstn_yn 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "LSTN_YN" , 0)
	'		g_OvrsTxpmChdYn 		= DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "OVRS_TXPM_CHD_YN" , 0)
			
			If Trim(g_CustEngName) <> "" Then
				ButtonView6.caption = "변경"
				Table0.SetCellString(0, 1, g_CustEngName)
			Else
				ButtonView6.caption = "등록"
			End If
		End If
	ElseIf szTranID == "obpds_srvc_323r" Then
		g_AprvYN		= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0)
		g_SvcSrno	= cdbl(edtSrno.caption)
		
		If g_AprvYN = "Y" and g_SvcSrno > 0 Then
			tblState.SetCellString(0, 1, "약정")
			btnEnroll.enable 	= False
			btnEnroll.visible	= False
			btnCancle.enable	= True
			btnCancle.visible	= True
			
			'서류제공방식선택 추가 
			btnProvision.enable = false
			btnModiTel.enable = false
			chkProvision.checkstate = "0"
			
			'약관체크박스
			ChkView0.chksilence = "1"
			ChkView1.chksilence = "1"
			ChkView2.chksilence = "1"
			ChkView3.chksilence = "1"
			
			g_FinCustomer = "Y"
			btnEnroll.enable = true
		ElseIf g_AprvYN = "N" and g_SvcSrno > 0 Then
			tblState.SetCellString(0, 1, "약정")
			btnEnroll.enable	= False
			btnEnroll.visible	= False
			btnCancle.enable	= True
			btnCancle.visible	= True
			
			'서류제공방식선택 추가 
			btnProvision.enable = false
			btnModiTel.enable = false
			chkProvision.checkstate = "0"
			
			'약관체크박스
			ChkView0.chksilence = "1"
			ChkView1.chksilence = "1"
			ChkView2.chksilence = "1"
			ChkView3.chksilence = "1"
			
			g_FinCustomer = "Y"
			btnEnroll.enable = true
		Else
			tblState.SetCellString(0, 1, "미약정")
			btnEnroll.enable	= True
			btnEnroll.visible	= True
			btnCancle.enable	= False
			btnCancle.visible	= False
			
			'서류제공방식선택 추가 
			btnProvision.enable = true
			btnModiTel.enable = true
			chkProvision.checkstate = "0"
			
			'약관체크박스
			ChkView0.chksilence = "0"
			ChkView1.chksilence = "0"
			ChkView2.chksilence = "0"
			ChkView3.chksilence = "0"
			
			btnEnroll.enable = false
			
		End If
	ElseIf szTranID == "obpds_srvc_045a" Then

		If g_ProsCls == "I" Then
			Form.SetSharedData( "PROS_DATE", "" )
			Form.SetSharedData( "PROS_SRNO", "" )
			Form.ShowAlert( "알림" , "등록이 완료되었습니다.")	
			
			'서비스일련번호
			g_szSvcSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO", 0)
			g_szSvcSrno = tonumber(g_szSvcSrno)
			g_szSvcSrno = tostring(g_szSvcSrno)
			
			'계약서류교부처리(계좌고객상품)
		    DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )
			
		ElseIf g_ProsCls == "D" Then
			Form.SetSharedData( "PROS_DATE", "" )
			Form.SetSharedData( "PROS_SRNO", "" )
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
		End If
		edtPassword.caption = ""
		ClearCnt()
		
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "082")	
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	
	ElseIf szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		'20230717 초기화추가
		chkProvision.checkstate = "0"		
		
		Form.SetSharedData("SPCL_CNFR_ACNO", cmbAccount.caption )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		
	ElseIf szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
	elseif szTranID == "obcsb_acif_199a" then 
		g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
	End If
End Sub
'============================================================================
Sub btnEnroll_OnClick()
	
	If g_CustClsCode == "2" Then 'v0001
		Form.MsgBox("알림", "법인고객은 영업점 내점으로만 약정이 가능합니다.", "", 0)
		Call ClearCnt()
		g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
		Exit Sub
	End If
	If ChkView0.chksilence == "0" Then
		Form.MsgBox("알림", "외화증권매매 거래계좌설정 약관 내용을 확인해주세요.", "", 0)
		Exit Sub
	End If
	If ChkView1.chksilence == "0" Then
		Form.MsgBox("알림", "외화증권거래 설명서 내용을 확인해주세요.", "", 0)
		Exit Sub
	End If
	If ChkView2.chksilence == "0" Then
		Form.MsgBox("알림", "해외주식 직접투자위험 유의사항 내용을 확인해주세요.", "", 0)
		Exit Sub
	End If
	'v008 업무시동의->이력체크 변경
'	If ChkView3.chksilence == "0" Then
'		Form.MsgBox("알림", "개인(신용)정보동의 내용을 확인해주세요.", "", 0)
'		Exit Sub
'	End If
	If Table0.GetCellString(0, 1) == "" Then
		Form.MsgBox("알림", "고객영문명을 확인해주세요.", "", 0)
		Exit Sub
	End If
	
	'서류제공방식선택 추가
	if chkProvision.checkstate == "0" then
		Form.ShowAlert( "알림" , "서류 제공방식을 선택하세요.")
		Exit Sub
	end if 
	
	If g_FinCustomer <> "Y" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		Exit Sub		
	End If
	If g_nPassword <> "" and Trim(edtPassword.caption) <> "" then
		If tblState.GetCellString(0, 1) == "미약정" Then		
			Dim sSendData 
			sSendData = "87051" & "★" & g_Acno & "★" & g_Asno & "★" & edtPassword.caption & "★" & "082" 
			
			Form.SetSharedData("mbonl81010_p16_LOAN_YN", "Y")	'Y로 넘기면 처리완료 팝업이 안뜸..
			Form.OpenPopup("mbonl81010_p1" , sSendData , "")
		Else
			Form.MsgBox("알림", "이미 등록된 약정입니다.", "", 0)
			g_nPassword = ""
			edtPassword.caption = ""
		End if
	Else
		Form.MsgBox("알림", "비밀번호를 확인해주세요.", "", 0)
		Exit Sub
	End If
End Sub
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_Acno = Left(cmbAccount.caption, 8)
	g_Asno = Right(cmbAccount.caption, 2)
	
	Call ClearCnt()
	g_szFnprJoinSrno = ""
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
	
	'계좌고객 정보 조회
	DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_Acno)
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	If szTranID == "obpds_srvc_323r" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Call ClearCnt()
		g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
	Else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'v008
		If g_ProsCls == "I" And CInt(szErrCode) == 6660 And Trim(szSubErr) == "개인신용정보동의 필수" Then
			'v009
			'Form.ShowAlert( "알림" , "[개인(신용)정보 처리 동의]화면에서 정보동의 후 거래신청이 가능합니다.")
			szLinkedData = g_Acno&"★"&g_Asno&"★"&g_nPassword
			Form.openPopupAnimation("mbonl87051_p2", szLinkedData, "", "2")
		Else
			if len(trim(szSubErr)) = 0 then
				Form.ShowAlert( "알림" , szErrMsg)
			else
				Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
			end if
		End If
	End If
	
End Sub

