'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	if edtPassword.caption == null or edtPassword.caption == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbonl82020_p6" Then
		If sRet == "외화증권매매 거래계좌설정 약관" Then
			ChkView0.chksilence = "1"			
		ElseIf sRet == "외화증권거래 설명서" Then
			ChkView1.chksilence = "1"			
		ElseIf sRet == "해외주식 직접투자위험 유의사항" Then
			ChkView2.chksilence = "1"
		ElseIf sRet == "개인(신용)정보동의(해외증권투자용)" Then
			ChkView3.chksilence = "1"
		End If
	ElseIf sKeyName = "KYCCHK_RETURN" Then
		If sRet == "Y" Then
			'처리일자, 처리일련번호
			Dim sProsDate, sProsSrno 
			sProsDate = Form.GetSharedData( "PROS_DATE", false )
			sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
			g_ProsCls = "I"
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE"		, 0 , "I")			'처리구분(I등록)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" 			, 0 , g_nPassword)	'계좌비밀번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" 				, 0 , g_Csno)			'고객번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNO" 				, 0 , g_Acno)			'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ASNO" 				, 0 , g_Asno)			'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" 				, 0 , "082")			'서비스 코드
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO"			, 0 , g_SvcSrno)		'서비스 일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")			'서비스 관리 단위코드(03상품)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_DATE", 0, sProsDate)	'처리일자
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_SRNO", 0, sProsSrno)	'처리일련번호
			
			DATAMANAGER.RequestTranData("obpds_srvc_045a")
		Else
'			Call ClearCnt()
		End If
	ElseIf sKeyName == "NewEngName" then
		DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNT_PWD" , 0 , g_nPassword)
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	ElseIf sKeyName == "mbonl81020" Then    'v0003
		if sRet == "ok" Then
		    ChkView3.chksilence = "1"
		End If
	
	'서류제공방식선택 추가
	Elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" then
			chkProvision.checkstate = "1"	
		else
			chkProvision.checkstate = "0"			
		end if		
	'v009
	ElseIf sKeyName == "mbonl87051_p2" Then 		
		'처리 서비스 다시 호출..
		If sRet == "ok" Then
	
			g_ProsCls = "I"
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE"		, 0 , "I")			'처리구분(I등록)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" 			, 0 , g_nPassword)	'계좌비밀번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" 				, 0 , g_Csno)			'고객번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNO" 				, 0 , g_Acno)			'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ASNO" 				, 0 , g_Asno)			'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" 				, 0 , "082")			'서비스 코드
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO"			, 0 , g_SvcSrno)		'서비스 일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")			'서비스 관리 단위코드(03상품)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
			
			DATAMANAGER.RequestTranData("obpds_srvc_045a")		
		
		end if
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
			btnEnroll.enable = true
'			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		elseif sRet == "CANCEL_mbonl81010_p20" then
			btnEnroll.enable = false
'			g_FinCustomer = "N"

			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if
		end if
	End If
End Sub

