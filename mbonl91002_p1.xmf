Sub Form_OnFormInit()
	
	step01code = "" 
	step02code = ""
	limt_exce_code = -1
	limt_exce_yn = -1
	real_num = Form.GetSharedData("real_num",false)
	tmp_real_num = real_num
	flag = 0
	reason_flag = 0
	
	Edit0.visible = "0"
	Label16.visible = "0"
	
	emp_num = Form.GetSharedData("emp_num", false )
	pro_date = Form.GetSharedData("pro_date", false)
	
	emp_part = Form.GetSharedData("emp_part", false)
	cur_date = Form.GetSharedData("cur_date", false)
	total_num = Form.GetSharedData("total_num", false)
	real_num = Form.GetSharedData("real_num", false)
	total_pro_amt = Form.GetSharedData("total_pro_amt", false)
	real_pro_amt = Form.GetSharedData("real_pro_amt", false)
	pro_pur = Form.GetSharedData("pro_pur", false)
	pro_type = Form.GetSharedData("pro_type", false)
	pro_content = Form.GetSharedData("pro_content", false)	
	aftr_rprn_reas = Form.GetSharedData("aftr_rprn_reas", false  )
	
	Grid0.SetCellData("bd_cell0", 0, "I")
	Grid0.SetCellData("bd_cell1", 0, pro_date)
	Grid0.SetCellData("bd_cell2", 0, emp_part)
	Grid0.SetCellData("bd_cell3", 0, cur_date)
	Grid0.SetCellData("bd_cell4", 0, emp_num)
	Grid0.SetCellData("bd_cell5", 0, total_pro_amt)
	Grid0.SetCellData("bd_cell6", 0, real_pro_amt)
	Grid0.SetCellData("bd_cell7", 0, total_num)
	Grid0.SetCellData("bd_cell8", 0, real_num)
	Grid0.SetCellData("bd_cell9", 0, pro_pur)
		
	if pro_type = "식사" then
		pro_type ="01"
	elseif pro_type ="선물" then
		pro_type ="02"
	elseif pro_type ="경조사" then
		pro_type ="03"
     elseif pro_type ="선물(농축산물)" then
		pro_type ="05"
	elseif pro_type ="경조사(화환,조화)" then
		pro_type ="06"
	else 	
		pro_type ="04" 
	end if
	
	Grid0.SetCellData("bd_cell10", 0, pro_type)
	
	
	Grid0.SetCellData("bd_cell11", 0, pro_content)
	
	Grid0.SetCellData("bd_cell12", 0, aftr_rprn_reas)
	
	Grid0.AddRow()

	
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "kim02_3" then	
		Label1112.caption = Form.GetSharedData("tr_cnrp_name", false )
		Label119.caption = Form.GetSharedData("wrpl_name", false )
		Label1110.caption = Form.GetSharedData("dpnm", false )
		Label116.caption = Form.GetSharedData("tr_cnrp_telno", false )
		each_pro_amt = Form.GetSharedData("real_pro_amt", false )
		each_pro_amt = round(Cint(each_pro_amt) / Cint(real_num))
		Label19.caption = each_pro_amt
		
		srno = Form.GetSharedData("srno", false )
		
		DATAMANAGER.SetDataValue(0, "obcmp_momt_470r", "InBlock1", "BNFT_OFER_DATE", 0, pro_date)
		
		DATAMANAGER.SetDataValue(0, "obcmp_momt_470r", "InBlock1", "SRNO", 0, srno)
		DATAMANAGER.SetDataValue(0, "obcmp_momt_470r", "InBlock1", "INPUT_EMPNO", 0, emp_num)
				
		DATAMANAGER.RequestTranData("obcmp_momt_470r")
		
		trgt_yn = Form.GetSharedData("trgt_yn", false)

	elseif sKeyName == "popup" then
		if sRet == "0" then
			Edit0.visible = "1"
			Label16.visible = "1"
			reason_flag = 1
		else 
			Label1112.caption = ""
			Label119.caption = ""
			Label1110.caption = ""
			Label116.caption= ""
			Label19.caption = ""	
			Label117.caption = ""
			Label118.caption = ""
			
		end if
		
	elseif sKeyName == "Clist1" or sKeyName == "Clist2" or sKeyName == "Clist3" then
		if sRet == "1" then
			if sKeyName == "Clist1" then
				step01code = Form.GetSharedData("Clist1_result", true)
				step02code = "0000"
			elseif sKeyName == "Clist2" then
				step01code = "0000"
				step02code = Form.GetSharedData("Clist2_result", true)
			elseif sKeyName == "Clist3" then
				step01code = "0000"
				step02code = Form.GetSharedData("Clist3_result", true)
			end if
			
			tmp_real_num = tmp_real_num - 1
			
			srno = Form.GetSharedData("srno", false)
			flag = 0
			
			for i = 0 to real_num - tmp_real_num - 1
				if srno == Grid1.GetCellData("bd_cell2", i) then
					flag = -1
				end if
			next
			
			if flag == 0 then 
				istu_bswr_acmp_yn = Form.GetSharedData("istu_bswr_acmp_yn", false)	
				
				Grid1.SetCellData("bd_cell0", real_num - tmp_real_num - 1, "I")
				Grid1.SetCellData("bd_cell1", real_num - tmp_real_num - 1, pro_date)
				Grid1.SetCellData("bd_cell2", real_num - tmp_real_num - 1, srno)
				Grid1.SetCellData("bd_cell3", real_num - tmp_real_num - 1, Label19.caption)
				Grid1.SetCellData("bd_cell4", real_num - tmp_real_num - 1, Label117.caption)
				
				Grid1.SetCellData("bd_cell5", real_num - tmp_real_num - 1, limt_exce_code)
	
					
				Grid1.SetCellData("bd_cell6", real_num - tmp_real_num - 1, step01code)
				Grid1.SetCellData("bd_cell7", real_num - tmp_real_num - 1, step02code)
				Grid1.SetCellData("bd_cell8", real_num - tmp_real_num - 1, trgt_yn)
				Grid1.SetCellData("bd_cell9", real_num - tmp_real_num - 1, istu_bswr_acmp_yn)
				Grid1.SetCellData("bd_cell11", real_num - tmp_real_num - 1, Edit0.caption)
				
				if cint(rcrd_cnt) > 0 then
					Grid1.SetCellData("bd_cell10", real_num - tmp_real_num - 1, "Y")
				else 
					Grid1.SetCellData("bd_cell10", real_num - tmp_real_num - 1, "N")
				end if
				
				
				
				Grid1.AddRow()
				
				if tmp_real_num <> 0 then
					Form.Toast(1, tmp_real_num & "명 남았습니다.", 0)
						
					Label1112.caption = ""
					Label119.caption = ""
					Label1110.caption = ""
					Label116.caption= ""
					Label19.caption = ""	
					Label117.caption = ""
					Label118.caption = ""
					
					Edit0.caption = ""
					Edit0.visible = "0"
					Label16.visible = "0"
					
				elseif tmp_real_num == 0 then
					'Form.Toast(1, "입력이 완료되었습니다.", 0)
					Label0.caption = "등          록"
				end if
			else 
				Form.Toast(1, "이미 입력한 사람입니다.", 0)
				Label1112.caption = ""
				Label119.caption = ""
				Label1110.caption = ""
				Label116.caption= ""
				Label19.caption = ""	
				Label117.caption = ""
				Label118.caption = ""	
			end if
		else
			Edit0.caption = ""
			if tmp_real_num <> 0 then
				Form.Toast(1, tmp_real_num & "명 남았습니다.", 0)
					
				Label1112.caption = ""
				Label119.caption = ""
				Label1110.caption = ""
				Label116.caption= ""
				Label19.caption = ""	
				Label117.caption = ""
				Label118.caption = ""
				
				Edit0.caption = ""
				Edit0.visible = "0"
				Label16.visible = "0"
				
			elseif tmp_real_num == 0 then
				'Form.Toast(1, "입력이 완료되었습니다.", 0)
				Label0.caption = "등          록"
			end if
		end if
		
	end if

End Sub
'============================================================================
'  등록
'============================================================================
Sub Button1_OnClick()
	temp_flag = 0
	if reason_flag == 1 and Edit0.caption == "" then
		Form.Toast(0, "사유를 입력해 주십시오.", 0)
	else
		'Form.MsgBox("reason_flag", reason_flag)
		'Form.MsgBox("Edit0.caption", Edit0.caption)
		if tmp_real_num <> 0 then
			'Form.MsgBox("tmp_real_num", tmp_real_num)
			if Label1112.caption <> "" then	
				if trgt_yn == "Y" then

					AmtOverFlag = "n"
					
					if pro_type == "식사" and each_pro_amt > 30000 then
						AmtOverFlag = "y"
					elseif pro_type == "선물" and each_pro_amt > 50000 then
						AmtOverFlag = "y"
					elseif pro_type == "경조사" and each_pro_amt > 50000 then
						AmtOverFlag = "y"
					elseif pro_type == "선물(농축산물)" and each_pro_amt > 100000 then
						AmtOverFlag = "y"
					elseif pro_type == "경조사(화환,조화)" and each_pro_amt > 100000 then
						AmtOverFlag = "y"
					else 
						AmtOverFlag = "n"
					end if
					
					if AmtOverFlag = "n" then 
					
						Form.OpenPopup("mbonl91002_p4.xmf" , "", "")
						
					elseif AmtOverFlag = "y" or pro_type == "기타" then
					
						Form.OpenPopup("mbonl91002_p5.xmf","","")
						
					end if
				else
					step01code = "0000"
					step02code = "0000"
					Form.OpenPopup("mbonl91002_p4.xmf" , "8989", "")
				end if
			else
				Form.Toast(1, "입력이 완료되지 않았습니다.", 0)
			end if
		else
			Form.Toast(1, "등록 되었습니다.", 0)
			
			DATAMANAGER.RequestTranData("obcmp_momt_469a")
			
			Form.SendReturnToParent("All_finish", 11)
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcmp_momt_470r" then
	
		pro_type = Form.GetSharedData("pro_type",false)
		
		if pro_type == "식사" and each_pro_amt < 30000 then
			each_pro_amt = 0
		elseif pro_type == "선물" and each_pro_amt < 50000 then
			each_pro_amt = 0
		elseif pro_type == "경조사" and each_pro_amt < 50000 then
			each_pro_amt = 0
		elseif pro_type == "선물(농축산물)" and each_pro_amt < 100000 then
			each_pro_amt = 0
		elseif pro_type == "경조사(화환,조화)" and each_pro_amt < 100000 then
			each_pro_amt = 0
		end if
		
		fy_each_pro_amt = DATAMANAGER.GetDataValue(0, "obcmp_momt_470r", "OutBlock1", "BNFT_ACML_OFER_AMT", 0) + each_pro_amt
		Label117.caption = fy_each_pro_amt
		
		
		if fy_each_pro_amt > 3000000 then
			if each_pro_amt > 1000000 then limt_exce_code = 3
				Label118.caption = "동시 한도초과"
				Form.Toast(0,"동시 한도 초과 되어 등록할 수 없습니다.",0)
			else limt_exce_code = 2
				Label118.caption = "연간 한도초과"
				Form.Toast(0,"연간 한도 초과 되어 등록할 수 없습니다.",0)
			end if
			Label1112.caption = ""
			Label119.caption = ""
			Label1110.caption = ""
			Label116.caption= ""
			Label19.caption = ""	
			Label117.caption = ""
			Label118.caption = ""
		elseif fy_each_pro_amt <= 3000000 then
			if each_pro_amt > 1000000 then limt_exce_code = 1
				Label118.caption = "1회 한도초과"
				Form.Toast(0,"1회 한도 초과 되어 등록할 수 없습니다.",0)
				Label1112.caption = ""
				Label119.caption = ""
				Label1110.caption = ""
				Label116.caption= ""
				Label19.caption = ""	
				Label117.caption = ""
				Label118.caption = ""
			elseif each_pro_amt <= 1000000 then
				limt_exce_code = 0
				Label118.caption = "정상"
			end if
		end if
			
		total_amt_1 = DATAMANAGER.GetDataValue(0,"obcmp_momt_470r", "OutBlock3", "UI_STPL_TOTAL_AMT1", 0)
		total_amt_2 = DATAMANAGER.GetDataValue(0,"obcmp_momt_470r", "OutBlock3", "UI_STPL_TOTAL_AMT2", 0)
		total_amt_3 = DATAMANAGER.GetDataValue(0,"obcmp_momt_470r", "OutBlock3", "UI_STPL_TOTAL_AMT3", 0)
		rcrd_cnt = DATAMANAGER.GetDataValue(0,"obcmp_momt_470r", "OutBlock2", "RCRD_CNT", 0)
				
		if cdbl(total_amt_1) + cdbl(total_amt_2) + cdbl(total_amt_3) = 0 then
			
			if Cint(rcrd_cnt) > 0 then
				Form.OpenPopup("mbonl91002_p3.xmf","","")
				reason_flag = 1
	
			elseif Cint(rcrd_cnt) == 0 then reason_flag = 0
			end if
		
		elseif cdbl(total_amt_1) + cdbl(total_amt_2) + cdbl(each_pro_amt) > 50000 then
			'Form.MsgBox("경고", "당일 동일 거래상대방에게 식사 및 선물로 5만원 이상 지출하실수 없습니다.")
			'Label1112.caption = ""
			'Label119.caption = ""
			'Label1110.caption = ""
			'Label116.caption= ""
			'Label19.caption = ""	
			'Label117.caption = ""
			'Label118.caption = ""
		elseif pro_type == "경조사" and cdbl(total_amt_1) + cdbl(total_amt_2) + cdbl(total_amt_3) + cdbl(each_pro_amt) > 100000 then
			'Form.MsgBox("경고", "당일 동일 거래상대방에게 모든 금품은 10만원 이상 지출하실수 없습니다.")
			'Label1112.caption = ""
			'Label119.caption = ""
			'Label1110.caption = ""
			'Label116.caption= ""
			'Label19.caption = ""	
			'Label117.caption = ""
			'Label118.caption = ""
		else 
			if Cint(rcrd_cnt) > 0 then
				Form.OpenPopup("mbonl91002_p3.xmf","","")
				reason_flag = 1
	
			elseif Cint(rcrd_cnt) == 0 then reason_flag = 0
			end if
		end if
	end if
End Sub

