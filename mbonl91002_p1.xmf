Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obcmp_momt_469a" then
		
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "PROS_CLS_CODE",	0, Grid0.GetCellData("bd_cell0",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_DATE",0, Grid0.GetCellData("bd_cell1",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_INPUT_BRCD", 0,Grid0.GetCellData("bd_cell2",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_INPUT_DATE", 0,Grid0.GetCellData("bd_cell3",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "INPUT_EMPNO", 0,Grid0.GetCellData("bd_cell4",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "TOTAL_AMT", 0,Grid0.GetCellData("bd_cell5",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_DSTR_BEF_AMT", 0,Grid0.GetCellData("bd_cell6",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "TOTAL_PRNU_CNT", 0,Grid0.GetCellData("bd_cell7",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "ATND_PRNU_CNT", 0,Grid0.GetCellData("bd_cell8",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_OBJT_CNTT", 0,Grid0.GetCellData("bd_cell9",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_TYPE", 0,Grid0.GetCellData("bd_cell10",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "BNFT_OFER_CNTT", 0,Grid0.GetCellData("bd_cell11",0))
		DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock1", "AFTR_RPRN_REAS", 0,Grid0.GetCellData("bd_cell12",0))
		for i = 0 to real_num - 1 
			
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "PROS_CLS_CODE", i, Grid1.GetCellData("bd_cell0",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "BNFT_OFER_DATE", i, Grid1.GetCellData("bd_cell1",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "SRNO", i, Grid1.GetCellData("bd_cell2",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "BNFT_OFER_AMT", i, Grid1.GetCellData("bd_cell3",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "BNFT_ACML_OFER_AMT", i, Grid1.GetCellData("bd_cell4",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "LIMT_SS_ALSN_YN", i, Grid1.GetCellData("bd_cell5",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "TLMS_TR_CODE_CNTT1", i, Grid1.GetCellData("bd_cell6",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "TLMS_TR_CODE_CNTT2", i, Grid1.GetCellData("bd_cell7",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "TRGT_YN", i, Grid1.GetCellData("bd_cell8",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "ISTU_BSWR_ACMP_YN", i, Grid1.GetCellData("bd_cell9",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "PRD_DPLC_YN" , i, Grid1.GetCellData("bd_cell10",i))
			DATAMANAGER.SetDataValue(0, "obcmp_momt_469a", "InBlock2", "PRD_DPLC_REAS", i, Grid1.GetCellData("bd_cell11",i))
		next		
	end if
End Sub
