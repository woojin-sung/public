	<SCRIPT_INFO _len="1407" _ulen="1337" >
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
Sub Form_OnFormInit()
	Dim szLinkedData
	
	szLinkedData = ""
	
	szLinkedData = Form.GetOpenLinkData()
	
	
	if getListItem(szLinkedData,0) <> "" then
		Table0.SetCellString( 0, 2, getListItem(szLinkedData,0)) ' 보유외화잔고
	end if
	
	if getListItem(szLinkedData,1) <> "" then
		Table0.SetCellString( 1, 2, getListItem(szLinkedData,1)) ' 최대 환전 가능 외화
	end if
	
	Table0.SetCellString( 0, 1, getListItem(szLinkedData,2)) ' 통화코드
	Table0.SetCellString( 1, 1, getListItem(szLinkedData,2)) ' 통화코드
	
	
	
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

