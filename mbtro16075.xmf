'===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szCsno
Dim g_szSvcdYn
'===========================================================================
' Form 초기화
'============================================================================
Sub Form_OnFormInit()
	
	'Initialize global values
	g_szAcno = cmbAcnt.total				'계좌번호
	g_szAsno = cmbAcnt.sequence				'일련번호
	g_szCsno = ""	
	g_szSvcdYn = ""
	
	'고객정보 요청 for CSNO
	DATAMANAGER.RequestTranData("obacp_comm_005r")
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'고객정보 요청 for CSNO
	if szTranID = "obacp_comm_005r" then
		DATAMANAGER.SetDataValue(0, "obacp_comm_005r", "InBlock1", "IQRY_CLS_CODE", 0 , "2")
		DATAMANAGER.SetDataValue(0, "obacp_comm_005r", "InBlock1", "ACNO", 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obacp_comm_005r", "InBlock1", "ASNO", 0 , g_szAsno)
	end if 
	
	'통합증거금 약정여부
	if szTranID = "obpds_srvc_158r" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "PROS_CLS_CODE", 0 , "1")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "CSNO", 0 , g_szCsno)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "SVCD", 0 , "081")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "ACNO", 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "ASNO", 0 , g_szAsno)
	end if 
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'고객정보 요청 for CSNO
	if szTranID = "obacp_comm_005r" then
		'고객번호
		g_szCsno = DATAMANAGER.GetDataValue(0, "obacp_comm_005r", "OutBlock1", "CSNO" , 0 )
		'통합증거금 약정여부
		DATAMANAGER.RequestTranData("obpds_srvc_158r")
	end if
	
	'통합증거금 약정여부
	if szTranID = "obpds_srvc_158r" Then
		g_szSvcdYn = DATAMANAGER.GetDataValue(0, "obpds_srvc_158r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0 )
		'Call MainLogic
		Call_Tran()
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'고객정보 요청 for CSNO
	if szTranID = "obacp_comm_005r" then
		Form.ShowAlert("안내", "고객정보를 가져올 수 없습니다.")
	end if
	
	'통합증거금 약정여부
	if szTranID = "obpds_srvc_158r" Then
		Form.ShowAlert("안내", "통합증거금 약정여부를 확인할 수 없습니다.")
	end if
End Sub

'===========================================================================
' TriggerEvent_CallTran
'============================================================================
Sub Call_Tran()

	g_szAcno = left(cmbAcnt.caption,8)
	g_szAsno = right(cmbAcnt.caption,2)	
	
	'계좌번호 & 일련번호 & 통합증거금 약정여부
	Form.triggerEvent("LinkForm", "SearchBalance", g_szAcno & "||" & g_szAsno & "||" & g_szSvcdYn)
End Sub
'============================================================================
' 조회버튼
'============================================================================
Sub btnSearch_OnClick()
	Call_Tran()
End Sub
'============================================================================
' 계좌변경
'============================================================================
Sub cmbAcnt_ChangeAccount()
	'고객정보 요청 for CSNO
	g_szAcno = cmbAcnt.total				'계좌번호
	g_szAsno = cmbAcnt.sequence				'일련번호
	DATAMANAGER.RequestTranData("obacp_comm_005r")
End Sub
