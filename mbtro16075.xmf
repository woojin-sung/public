	<CONTROL_INFO>
		<ACCOUNT name="cmbAcnt" itemcodetype="100,119,200" delegate="1" finaceexcept="1" benefitexcept="1" ly_vert="10,9,310,39,1" />
		<BUTTON name="btnSearch" btnimage="btn_refresh.9" ly_vert="326,9,39,39,1" />
