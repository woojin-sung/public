'============================================================================
' 01.화면명 	: 업종현재가
' 02.화면설명	: 업종현재가_메인탭
' 03.작성	: 2015.12.31
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szItemCode
dim	g_szMarket
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'setMarketType :	TR조회용 마켓구분가져옴
'============================================================================
Function	setMarketType( szInput )
	if	szInput	=	"0"	then
		g_szMarket	=	"K"
	elseif	szInput	=	"1"	then
		g_szMarket	=	"Q"
	elseif	szInput	=	"2"	then
		g_szMarket	=	"K2"
	elseif	szInput	=	"3"	then
		g_szMarket	=	"KR"
	elseif	szInput	=	"P"	then
		g_szMarket	=	"KN"
	else	
		g_szMarket	=	""
	end	if
End	Function


'============================================================================
'getIdxName	:	인덱스명 리턴
'============================================================================
Function	getIdxName( szInput )
	if	szInput	=	"0"	then
		return	"코스피"
	elseif	szInput	=	"1"	then
		return	"코스닥"
	elseif	szInput	=	"2"	then
		return	"코스피200"
	elseif	szInput	=	"3"	then
		return	"KRX100"
	elseif	szInput	=	"P"	then
		return	"코넥스"
	else
		return	" "
	end	if
End	Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szListItems
	dim szLinkData
	dim szTabIdx	'선택될 탭 인덱스

	szLinkData = Form.GetOpenLinkData()

	if len(szLinkData)  > 0	then
		szListItems = split(szLinkData, "★")
		szTabIdx			= szListItems(0)
		g_szItemCode 		= szListItems(1)
		temp				=	Form.GetItemCodeInfo(g_szItemCode, "indextype")
		setMarketType(temp)
		
		fmtab01.currenttab	= szTabIdx
	
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "42000ITEMCODE", g_szItemCode)
		
		'20240508 HSZ START: 해외주식고도화_HOME연동 추가
		nInstrUP = Instr(szLinkData, "UP")
		nInstrDOWN = Instr(szLinkData, "DOWN")
		
		if CInt(nInstrUP) > 0 or CInt(nInstrDOWN) > 0 then
			szHomeData = szListItems(2).. "★"..szListItems(3)
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "HOME_SORTING", szHomeData)
		
		elseif CInt(szTabIdx) = 2 then
			if UBound(szListItems) > 1 then
				Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "HOME_RDOIDX", szListItems(2))
			end if
		end if
		'20240508 HSZ END
			
	else
		g_szItemCode = Form.GetSharedData("&ITEM_UPJONG", 0)
		'20221213 jipark 이전 업종코드(6자리 미만)일때 변환 함수 호출
		nCodeLen = Form.getLen(g_szItemCode)
		if nCodeLen < 6 then
			g_szItemCode = Form.ConvertUpjongCode(g_szItemCode)
		end if
		'20221213 jipark
		temp		= Form.GetItemCodeInfo(g_szItemCode, "indextype")
		setMarketType(temp)
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "42000ITEMCODE", g_szItemCode)
	end if 
	
	Form.SetSearchType ("9")
	Form.SetItemCode(g_szItemCode)
	
	DATAMANAGER.RequestTranData("ohhts_1514_001r")
	DATAMANAGER.RequestTranData("ohhts_1504_001r")

End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "42000ITEMCODE", g_szItemCode)
	
	DATAMANAGER.RequestTranData("ohhts_1514_001r")
	DATAMANAGER.RequestTranData("ohhts_1504_001r")

End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if	szTranID	=	"ohhts_1514_001r"	then
		DATAMANAGER.ClearInputData(0, "ohhts_1514_001r")
		DATAMANAGER.SetDataValue(0,"ohhts_1514_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		DATAMANAGER.SetDataValue(0,"ohhts_1514_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
		
		DATAMANAGER.SetDataValue(0,"ohhts_1514_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		DATAMANAGER.SetDataValue(0,"ohhts_1514_001r", "InBlock2", "FID_INPUT_COND_SCR_DIV_CODE", 0, "1514")
		DATAMANAGER.SetDataValue(0,"ohhts_1514_001r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", 0, g_szMarket)
		
	elseif	szTranID	=	"ohhts_1504_001r"	then
		DATAMANAGER.ClearInputData(0, "ohhts_1504_001r")
		DATAMANAGER.SetDataValue(0,"ohhts_1504_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")
		DATAMANAGER.SetDataValue(0,"ohhts_1504_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim	szCode, szName, szIdxName, szIdxCode
	
	szCode	=""
	szName	=""
	szIdxName=""
	szIdxCode=""
	
	if	szTranID	=	"ohhts_1514_001r"	then
		DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szItemCode)
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
	elseif		szTranID	=	"ohhts_1504_001r"	then
		szCode = DATAMANAGER.GetDataValue(0, "ohhts_1504_001r", "OutBlock1", "FID_SHRN_ISCD", 0)
		szName = DATAMANAGER.GetDataValue(0, "ohhts_1504_001r", "OutBlock1", "FID_KOR_ISNM", 0)
		
		szIdxCode = Form.GetItemCodeInfo(szCode, "indextype")
		szIdxName	=	getIdxName(szIdxCode)
		
		'tbl01.SetCellString(0, 0, szIdxName & "\r\n" & szName)
		
		'2016.4.2 by HA.WM 수정
		tbl01.SetCellString(0, 0, szIdxName)
		tbl01.SetCellString(1, 1, szName)
	end if
End Sub


'============================================================================
'Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if	sKey	=	"ITEMCODE"		then
		g_szItemCode	=	sValue
		
		temp		=	Form.GetItemCodeInfo(sValue, "indextype")
		setMarketType(temp)
		
		Form.SetSharedData("42000INITCODE" , g_szItemCode)
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "42000ITEMCODE", g_szItemCode)
		
		DATAMANAGER.RequestTranData("ohhts_1514_001r")
		DATAMANAGER.RequestTranData("ohhts_1504_001r")

	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName = "42000INDEXTOM"	then
		if sParam = "0"	then
			g_szItemCode = "KGG01P"		'22년 차세대 업종코드 하드코딩
			g_szMarket	="K"
			Form.SetTitleCaption("코스피")
		elseif sParam = "1"	then
			g_szItemCode = "QGG01P"		'22년 차세대 업종코드 하드코딩
			g_szMarket	="Q"
			Form.SetTitleCaption("코스닥")
		elseif sParam = "2"	then
			g_szItemCode = "K2G01P"		'22년 차세대 업종코드 하드코딩
			g_szMarket	="K2"
			Form.SetTitleCaption("KOSPI200")
		elseif sParam = "3"	then
			g_szItemCode = "XGG01P"		'22년 차세대 업종코드 하드코딩
			g_szMarket	="KR"
			Form.SetTitleCaption("KRX100")
		else
			g_szItemCode = "KGG01P"		'22년 차세대 업종코드 하드코딩
			g_szMarket	="K"
			Form.SetTitleCaption("업종현재가")
		end if 
		
		DATAMANAGER.RequestTranData("ohhts_1514_001r")
		DATAMANAGER.RequestTranData("ohhts_1504_001r")
	elseif	sEventName	=	"42000_CHGITEM"	then
		Form.SetItemCode(sParam)
		g_szItemCode	=	sParam
	ElseIf sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If
		
	'20220922 SWJ START : 상단 바 종목명 클릭 시 종목선택 팝업 추가	
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "9", "")
	end if
	'20220922 SWJ END
End Sub


'============================================================================
'fmtab01_OnTabChanged
'============================================================================
Sub fmtab01_OnTabChanged(nCurrentTab)
		Form.SetSharedData("42000INITCODE" , g_szItemCode)
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "42000ITEMCODE", g_szItemCode)
End Sub


'============================================================================
'DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if	szTranID	=	"ohhts_nmix_cntg"	then
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szItemCode)
	end	if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Dim szFlag
		
			sName = tbl01.GetCellString(1, 1)
			sCurpirce = FormatNumber( tbl01.GetCellString(0, 1),  2)
			
			If CDbl(tbl01.GetCellString(0, 3)) > 0 Then
				szFlag	= "▲"			
			ElseIf CDbl(tbl01.GetCellString(0, 3)) < 0 Then
				szFlag	= "▼"
			Else
				szFlag	= ""
			End If
			
			sDiff    = FormatNumber( tbl01.GetCellString(0, 3),  2)		
			sRate     = FormatNumber( tbl01.GetCellString(0, 4),  2)
			sQuqn	 = FormatNumber( tbl01.GetCellString(1, 2),  0)
			szParam = sName.."\n"..sCurpirce.."\n ("..szFlag..sDiff.." / "..sRate.."% / "..sQuqn..")"
			
			Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", szParam)
		End If
	End if
End Sub

'============================================================================
'20220922 SWJ START : 상단 바 종목명 클릭 시 종목선택 팝업 추가
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub

