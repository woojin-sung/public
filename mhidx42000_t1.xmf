'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szItemCode	'선택된 종목코드
dim	g_szMarket	'선택된 시장코드
dim	g_nSorting	'정렬 세팅

g_szItemCode	=	""
g_szMarket	=	""
g_nSorting	=	-1
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Chk_RdoKey()
End Sub

'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1511
	dim szRealCode
	
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
	DATAMANAGER.CancelRealData("ohhts_up_rsfl")
	
	ncnt1511 = DATAMANAGER.GetDataCount(0, "ohhts_1511_001r" , "OutBlock1")

	if szTranID = "ohhts_1511_001r" then
		for i = 0 to ncnt1511 - 1
			szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1511_001r", "OutBlock1", "FID_SHRN_ISCD", i)
			DATAMANAGER.SetDataValue(1,"ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", i, szRealCode)
			DATAMANAGER.SetDataValue(1,"ohhts_up_rsfl", "InBlock1", "FIDR_BSTP_CLS_CODE", i, szRealCode)	
		next
		
		'20240508 HSZ START: 해외주식고도화_HOME연동 추가
		Select Case g_nSorting
		Case 0
			grdMain01T1.onSortingByScript("th_cell4", 4, 0)	'상승순
		Case 1
			grdMain01T1.onSortingByScript("th_cell4", 4, 1)	'하락순
		End Select
		'20240508 HSZ END
		
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
		DATAMANAGER.RequestRealData("ohhts_up_rsfl")
	end if 
End Sub


