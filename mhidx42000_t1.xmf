'============================================================================
'Chk_RdoKey 20160323 추가
'============================================================================
Function Chk_RdoKey()
	Dim szIdx
	
	szIdx = CStr(rdoMrkt01T1.currentindex)
	
	if	szIdx	=	"0"	then
		g_szMarket	="K"
	elseif	szIdx	=	"1"	then
		g_szMarket	="Q"
	elseif	szIdx	=	"2"	then
		g_szMarket	="K2"
	elseif	szIdx	=	"3"	then
		g_szMarket	="KR"
	else
		g_szMarket	=""
	end	if
	
	DATAMANAGER.RequestTranData("ohhts_1511_001r")
End Function

'============================================================================
'rdoMrkt01T1_OnClick
'============================================================================
Sub rdoMrkt01T1_OnClick(nIndex)
	Chk_RdoKey()
	
	Form.triggerEvent("#", "42000INDEXTOM", rdoMrkt01T1.currentindex)
End Sub


'============================================================================
'grdMain01T1_OnClickUp
'============================================================================
Sub grdMain01T1_OnClickUp(lRow, szCellID)
	g_szItemCode	=	grdMain01T1.GetCellData("bd_cell0", lRow)
	
	if	g_szItemCode	<>	NULL		and		len(g_szItemCode)		>	3		then
		Form.triggerEvent("#", "42000_CHGITEM", g_szItemCode)
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"ohhts_1511_001r"	then
		DATAMANAGER.ClearInputData(0, "ohhts_1511_001r")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "U")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0 , "1511")
		DATAMANAGER.SetDataValue(0, "ohhts_1511_001r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE",0 , g_szMarket)
	end	if
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'20240508 HSZ START: 해외주식고도화_HOME연동 추가
	if sEventName = "HOME_SORTING" then
		szTemp		= split(sParam, "★")
		nTab			= szTemp(0)
		szSorting	= szTemp(1)
		if szSorting = "UP" then
			g_nSorting = 0
		elseif szSorting = "DOWN" then
			g_nSorting = 1
		end if
		
		rdoMrkt01T1.currentindex = nTab
		Chk_RdoKey()
	end if
	'20240508 HSZ END	
End Sub

