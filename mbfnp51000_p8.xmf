Dim g_szRcmdClsCode	'투자자권유구분
Dim g_szMtrtDate		'KYC유효기간만기일자

Dim g_szID
Dim g_szOSType
Dim g_ServerMode
Dim g_szScreenNo
'Dim g_URLheader
'Dim g_szURL	'고객투자성향 다운로드 URL

Dim g_KycRslt

