'============================================================================
Sub Container1_imgRdo00_OnClick()
	Call Container0_imgRdo0_OnClick()
	
	'투자성향재진단 화면 연결
	'Form.OpenFramePopup("mbonl81010" , "" , sPosInfo)
End Sub

'============================================================================
Sub Container1_imgRdo10_OnClick()
	'투자자 성향별 적합한 금융투자상품 화면 연결
	Form.OpenPopup("mbfnp51000_p17" , g_szInvType , "")
End Sub

'============================================================================
Sub btnOK_OnClick()
	if g_szScreenNo == "51000" or g_szScreenNo == "51040" or (g_szScreenNo == "71052" AND g_szGb = "ADD") then
		if g_szGb = "NEW" then
			'신규매수
			Form.OpenPopup("mbfnp51010", g_szShortCd & "★" & g_szStndCd, sPosInfo)
		else'if g_szGb = "ADD" then
			'추가매수
			Form.OpenPopup("mbfnp51011", g_szShortCd & "★" & g_szStndCd & "★" & g_szRmndNo, sPosInfo)
		end if
	else
		'펀드이외 상품 선택된 경우!
		g_szRet = "NEXT_mbfnp51000_p8" 
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szRet = "CANCEL"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51000_p8" ,  g_szRet)
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	g_szRet = "GO_BACK"
    Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbfnp51010" or sKeyName == "mbfnp51011"  Then 	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			if sRet <> "GO_BACK" then
				Form.CloseForm()
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'투자성향 변경 후, 변경된 투자성향으로 재조회하기 위함
	if sKey == "Change_Invest_Type" and sValue == "refresh" then	
		DATAMANAGER.RequestTranData( "obcsb_acif_701r" )
	end if
End Sub

