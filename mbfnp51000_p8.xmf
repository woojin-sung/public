'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'고객투자성향 및 상품위험등급조회
	if	szTranID	=	"obcsb_acif_400r"	then
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0, g_szShortCd)
		
	elseif	szTranID	=	"obcsb_acif_701r"	then
		
		' 계좌번호 미전달시
		if g_szAccNo == "" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, Account0.total)
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		end if
		
	elseif	szTranID	=	"obcsb_acif_701r_1"	then
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	Dim szInvestGrd, szPrdtGrd, szSpecialYn, szAnxtAprtYn, tmp_GradeCode
	szInvestGrd = ""	
	szPrdtGrd = ""
	szSpecialYn = ""
	szAnxtAprtYn = ""
	tmp_GradeCode = ""
		
    '고객투자성향 및 상품위험등급조회
	If	szTranID	=	"obcsb_acif_400r"	then
		g_szInvType			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE"           , 0 )	'KYC투자성향등급코드
		g_szGradeCode			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_PROD_GRAD_CODE"           , 0 )	'KYC상품등급코드
'		szInvestGrd			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CUST_IVIC_GRAD_CNTT"           , 0 )	'고객투자성향등급내용
		szPrdtGrd        		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "INVT_PROD_RISK_GRAD_CNTT" , 0 )	'투자상품위험등급내용
		g_KYC_SPCL_INVR_YN	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_SPCL_INVR_YN" , 0 )	'KYC전문투자자여부
		g_szAnxtAprtYn		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ANXT_APRT_YN"          , 0 )	'부적정여부
		
		call setInvtGrad()
	Elseif	szTranID	=	"obcsb_acif_701r"	then	
		g_szRcmdClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KYC_INVT_RCMD_CLS_CODE" , 0) 'KYC투자권유구분코드
		g_szMtrtDate		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KYC_VALD_PRD_MTRT_DATE" , 0) '만기일자
		
		If g_szScreenNo == "51000" or g_szScreenNo == "51040" or g_szScreenNo == "71052" or g_szScreenNo == "51020" then
			Dim szOpenData
			szOpenData = Form.GetOpenLinkData( )		
			If szOpenData <> "" And szOpenData <> null Then
				tData = Split(szOpenData, "★")
				
				g_szAccNo		= tData[1]	'계좌번호
				g_szShortCd 		= tData[2]
				g_szStndCd 		= tData[3]
				g_szRmndNo		= tData[4]
				g_szGb			= tData[5]	'매수구분(NEW/ADD)
			end if
		end if
		'펀드찾기(51000) 화면 or 펀드잔고(51040) 화면 에서 오픈된 경우에만 상단에 빽버튼&타이틀 제공	
		If g_szScreenNo == "51000" or g_szScreenNo == "51040" or (g_szScreenNo == "71052" AND g_szGb = "ADD") then
		
			ImgBackPress.visible = True
			Label9.visible = True
			
			if g_szGb == "ADD" then
				Label9.caption = "추가매수"
			else
				Label9.caption = "펀드매수"
			end if
			
			DATAMANAGER.RequestTranData("obcsb_acif_400r")
'			Dim szOpenData
'			szOpenData = Form.GetOpenLinkData( )		
'			If szOpenData <> "" And szOpenData <> null Then
'				tData = Split(szOpenData, "★")
'				
'				g_szAccNo		= tData[1]	'계좌번호
'				g_szShortCd 		= tData[2]
'				g_szStndCd 		= tData[3]
'				g_szRmndNo		= tData[4]
'				g_szGb			= tData[5]	'매수구분(NEW/ADD)
'							
'				DATAMANAGER.RequestTranData("obcsb_acif_400r")
'			end if
			
		Else
			ImgBackPress.visible = false
			Label9.visible = false
			
			if g_szAccNo == "" And g_szShortCd == "" And g_szGradeCode == "" Then
				Form.ShowAlert("알림", "입력값이 없습니다.")
				Exit Sub
			end if
			
			'// 상품등급 공란이고, 계좌번호랑 종목코드 있는경우 상품등급 조회
			'// 상품등급 전달된 경우, 해당 상품등급 바로 보여줌!
			if (g_szGradeCode == "" or g_szGradeCode == NULL) then
				'// case1) 계좌번호 + 종목코드로 obcsb_acif_400r
				if (g_szAccNo <> "" And g_szAccNo <> null And g_szShortCd <> "" And g_szShortCd <> null) then
					DATAMANAGER.RequestTranData("obcsb_acif_400r")
				end if
			else
				'// case2) 계좌번호 + 상품등급으로 obcsb_acif_701r 
				if g_szAccNo <> "" And g_szAccNo <> null then
					DATAMANAGER.RequestTranData("obcsb_acif_701r_1")
				end if
			end if
		End if
	
	Elseif	szTranID	=	"obcsb_acif_701r_1"	then	
		g_szInvType			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE"           , 0 )	'KYC투자성향등급코드
		g_KYC_SPCL_INVR_YN	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_SPCL_INVR_YN" , 0 )	'KYC전문투자자여부
		g_szEnttInvType		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENTT_IVIC_GRCD"           , 0 )	'일임투자성향등급코드
		
		if Len(Trim(g_szInvType)) <= 0 Then
			g_szInvType = "00"
		end if
		
		if Len(Trim(g_szEnttInvType)) <= 0 Then
			g_szEnttInvType = "00"
		end if
		
		'투자위험도(투자자유형)
		if g_szGradeCode == "01" then
			szPrdtGrd = "1등급 매우높은위험(고수익지향형)"
			tmp_GradeCode = "01"
		elseif g_szGradeCode == "02" then
			szPrdtGrd = "2등급 높은위험(성장지향형)"
			tmp_GradeCode = "02"
		elseif g_szGradeCode == "03" then
			szPrdtGrd = "3등급 다소높은위험(성장지향형)"
			tmp_GradeCode = "02"
		elseif g_szGradeCode == "04" then
			szPrdtGrd = "4등급 보통위험(중립형)"
			tmp_GradeCode = "03"
		elseif g_szGradeCode == "05" then
			szPrdtGrd = "5등급 낮은위험(안정지향형)"
			tmp_GradeCode = "04"
		elseif g_szGradeCode == "06" then
			szPrdtGrd = "6등급 매우낮은위험(이자소득형)"
			tmp_GradeCode = "05"
		end if

		'WRAP/ISA 화면인 경우
		' 56110 : ISA 타사이전
		' 56120 : ISA 유형전환
		' 56060 : ISA 신규가입
		' 57020 : 비대면 WRAP 신규가입
		If g_szScreenNo == "56110" or g_szScreenNo == "56120" or g_szScreenNo == "56060" or g_szScreenNo == "57020" then
			g_szInvType = g_szEnttInvType
		End If
		
		'부적정여부(g_szAnxtAprtYn)	'고승연과장 추가 예정.
		'전문투자자인 경우
		if g_KYC_SPCL_INVR_YN == "Y" then
			g_szAnxtAprtYn = "N"
		'전문투자자가 아닌경우
		else
			'KYC투자성향등급 > 상품등급 인경우 부적정
			if g_szInvType > tmp_GradeCode then
				g_szAnxtAprtYn = "Y"
			else
				g_szAnxtAprtYn = "N"
			end if
		end if
		
		call setInvtGrad()
	Elseif	szTranID	=	"obcsb_acif_709a"	then	
		Container0.lblResult.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "INVT_INCL_OVRV_EXPL", 0 )
	End if

End Sub

'============================================================================
Sub setInvtGrad()
	btnOK.enable = True
	btnOK.visible = True
	btnRdo.enable = False
	btnRdo.visible = False
	
	g_szInvTypeNm = Form.GetMetaData("KYC투자성향등급코드", g_szInvType)
	Form.SetSharedData("BDM_APLY_KYC_GRAD", g_szInvType)	'(고객적용)투자성향등급

'	szKYC_GRAD_PROD_NAME = Form.GetMetaData("KYC상품등급코드", g_szGradeCode)
'	szPrdtGrd = szKYC_GRAD_PROD_NAME .. " (" .. int(g_KYC_PROD_GRAD).."등급)"
	
	'투자위험도(투자자유형)
	if g_szGradeCode == "01" then
		szPrdtGrd = "매우높은위험(1등급)"
	elseif g_szGradeCode == "02" then
		szPrdtGrd = "높은위험(2등급)"
	elseif g_szGradeCode == "03" then
		szPrdtGrd = "다소높은위험(3등급)"
	elseif g_szGradeCode == "04" then
		szPrdtGrd = "보통위험(4등급)"
	elseif g_szGradeCode == "05" then
		szPrdtGrd = "낮은위험(5등급)"
	elseif g_szGradeCode == "06" then
		szPrdtGrd = "매우낮은위험(6등급)"
	end if

	g_KycRslt = ""
	
	' KYC 미등록인 경우
	if g_szMtrtDate = "" or g_szMtrtDate = Null then
		g_KycRslt = "M1"
	' KYC 유효기간 만료인 경우
	elseif int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false)) then
		g_KycRslt = "M2"
	' 투자권유구분코드가 미제공인 경우
	elseif g_szRcmdClsCode = "2" or g_szRcmdClsCode = "4" then
		g_KycRslt = "R1"
	' 투자성향등급이 미제공인 경우
	elseif g_szInvTypeNm == "정보미제공" then
		g_KycRslt = "R2"
	end if
	
	'---------------------------------------------------
	'전문투자자
	'---------------------------------------------------	
	if g_KYC_SPCL_INVR_YN == "Y" then	
		Container0.visible = 0
		Container1.visible = 1
					
		Container1.Label10.caption = "고객님은 전문투자자로\n등록된 상태입니다."
		
		Container1.Table2.SetCellString(1, 1, "전문투자자")
		Container1.Table2.SetCellString(2, 1, szPrdtGrd)
		
		szResult = "고객님께서는 전문투자자로 등록되어 투자성향 진단이 면제되며, "
					.. "모든 위험등급의 상품을 거래하실 수 있습니다."
		
		Container1.lblResult.caption = szResult
		
		'투자성향재진단 숨김
		Container1.imgRdo00.visible = 0
		Container1.Icon10.visible = 0
		Container1.Label60.visible = 0
		
		'가입중단 숨김
		btnCancel.visible = 0
		btnOK.left = 0
		btnOK.width = 375
	
	elseif g_KycRslt == "M1" or g_KycRslt == "M2" or g_KycRslt == "R1" or g_KycRslt == "R2" then
	
		'---------------------------------------------------
		'미등록
		'---------------------------------------------------
		if g_KycRslt == "M1" then
		
			szInvtTypeNm = "미등록"
			szInvtType = "고객님의 투자성향은\n미등록 상태입니다."
			szResult = "고객님의 투자성향 정보가 등록되지 않아 해당 상품 가입이 불가합니다. 투자성향 등록 후 진행해 주세요."
			
			'투자성향재진단 숨김
			Container1.imgRdo00.visible = 0
			Container1.Icon10.visible = 0
			Container1.Label60.visible = 0
			
			btnRdo.enable = True
			btnRdo.visible = True
			btnOK.enable = False
			btnOK.visible = False
			
		'---------------------------------------------------
		'투자성향만료
		'---------------------------------------------------	
		elseif g_KycRslt == "M2" then
		
			szInvtTypeNm = "유효기간 종료"
			szInvtType = "고객님의 투자성향\n유효기간이 종료되었습니다."
			szResult = "고객님의 투자성향 유효기간이 경과되어 해당 상품 가입이 불가합니다. 투자성향 등록 후 진행해 주세요."
		
			'투자성향재진단 숨김
			Container1.imgRdo00.visible = 0
			Container1.Icon10.visible = 0
			Container1.Label60.visible = 0
			
			btnRdo.enable = True
			btnRdo.visible = True
			btnOK.enable = False
			btnOK.visible = False
			
		'---------------------------------------------------
		'정보미제공
		'---------------------------------------------------
		elseif g_KycRslt == "R1" or g_KycRslt == "R2" then
		
			szInvtTypeNm = "정보미제공"
			szInvtType = "고객님의 투자성향은\n정보미제공 상태입니다."
			szResult = "고객님은 투자권유 미희망 및 투자자정보 미제공을 선택하셨습니다."
					.. " 투자권유를 받지 않고 본인의 판단에 따라 투자하시게 되며 이와 관련하여 발생할 수 있는 모든 위험은 본인이 감수하"
					.. " 실 것임을 확인하셨습니다."	
		
		end if
		
		Container0.visible = 0
		Container1.visible = 1
		
		Container1.Table2.SetCellString(1, 1, szInvtTypeNm)
		Container1.Table2.SetCellString(2, 1, szPrdtGrd)
		
		Container1.Label10.caption = szInvtType
		Container1.lblResult.caption = szResult
	
	
'	'---------------------------------------------------
'	'미등록
'	'---------------------------------------------------	
'	elseif g_szMtrtDate = "" or g_szMtrtDate = Null then
'	
'		szInvtTypeNm = "미등록"
'		szInvtType = "고객님의 투자성향은\n미등록 상태입니다."
'		szResult = "고객님의 투자성향 정보가 등록되지 않아 해당 상품 가입이 불가합니다. 투자성향 등록 후 진행해 주세요."
'		
'		Container0.visible = 0
'		Container1.visible = 1
'		
'		Container1.Table2.SetCellString(1, 1, szInvtTypeNm)
'		Container1.Table2.SetCellString(2, 1, szPrdtGrd)
'		
'		Container1.Label10.caption = szInvtType
'		Container1.lblResult.caption = szResult
'	
'		'투자성향재진단 숨김
'		Container1.imgRdo00.visible = 0
'		Container1.Icon10.visible = 0
'		Container1.Label60.visible = 0
'		
'		btnRdo.enable = True
'		btnRdo.visible = True
'		btnOK.enable = False
'		btnOK.visible = False
'		
'	'---------------------------------------------------
'	'투자성향만료
'	'---------------------------------------------------	
'	elseif int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false)) then
'	
'		szInvtTypeNm = "유효기간 종료"
'		szInvtType = "고객님의 투자성향\n유효기간이 종료되었습니다."
'		szResult = "고객님의 투자성향 유효기간이 경과되어 해당 상품 가입이 불가합니다. 투자성향 등록 후 진행해 주세요."
'		
'		Container0.visible = 0
'		Container1.visible = 1
'		
'		Container1.Table2.SetCellString(1, 1, szInvtTypeNm)
'		Container1.Table2.SetCellString(2, 1, szPrdtGrd)
'		
'		Container1.Label10.caption = szInvtType
'		Container1.lblResult.caption = szResult
'		
'		'투자성향재진단 숨김
'		Container1.imgRdo00.visible = 0
'		Container1.Icon10.visible = 0
'		Container1.Label60.visible = 0
'		
'		btnRdo.enable = True
'		btnRdo.visible = True
'		btnOK.enable = False
'		btnOK.visible = False
'				
'	'---------------------------------------------------
'	'정보미제공
'	'---------------------------------------------------	
'	elseif g_szInvTypeNm == "정보미제공" then
'		
'		szInvtTypeNm = "정보미제공"
'		szInvtType = "고객님의 투자성향은\n정보미제공 상태입니다."
'		szResult = "고객님은 투자권유 미희망 및 투자자정보 미제공을 선택하셨습니다."
'				.. " 투자권유를 받지 않고 본인의 판단에 따라 투자하시게 되며 이와 관련하여 발생할 수 있는 모든 위험은 본인이 감수하"
'				.. " 실 것임을 확인하셨습니다."	
'		
'		Container0.visible = 0
'		Container1.visible = 1
'		
'		Container1.Table2.SetCellString(1, 1, szInvtTypeNm)
'		Container1.Table2.SetCellString(2, 1, szPrdtGrd)
'		
'		Container1.Label10.caption = szInvtType
'		Container1.lblResult.caption = szResult
'	
	'---------------------------------------------------
	'일반투자자
	'---------------------------------------------------	
	else
		Container0.visible = 1
		Container1.visible = 0

		if g_szAnxtAprtYn = "Y" then	'부적정여부
			Container0.Label1.caption = "고객님의 투자성향에\n적합하지 않은 상품입니다."
			Container0.Label1.changeTextAttr(11, 7, 10, 0, true)	
			Container0.Icon0.imgpath = "icon_notice_3.png"
		else			
			Container0.Label1.caption = "고객님의 투자성향에\n적합한 상품입니다."
			Container0.Label1.changeTextAttr(11, 3, 326, 0, true)	
			Container0.Icon0.imgpath = "icon_confirm.png"
		end if

		'---------------------------------------------------
		'일반투자자 : 고객투자성향
		'---------------------------------------------------
		g_szInvTypeNm = Form.GetMetaData("KYC투자성향등급코드", g_szInvType)
		
		if g_szInvType = "01" then	'고수익지향형
			Container0.ImgInvestGrade1.imgpath = "bg_risk1_o.9"
			Container0.lblInvt01.fgcolor = "16"
			
'			g_szURL = g_URLheader & "kycInvtGrade01.pdf"
			
		elseif g_szInvType = "02" then	'성장지향형
			Container0.ImgInvestGrade2.imgpath = "bg_risk2_o.9"
			Container0.lblInvt02.fgcolor = "4"
			
'			g_szURL = g_URLheader & "kycInvtGrade02.pdf"
			
		elseif g_szInvType = "03" then	'중립형
			Container0.ImgInvestGrade3.imgpath = "bg_risk4_o.9"
			Container0.lblInvt03.fgcolor = "4"
			
'			g_szURL = g_URLheader & "kycInvtGrade03.pdf"
			
		elseif g_szInvType = "04" then	'안정지향형
			Container0.ImgInvestGrade4.imgpath = "bg_risk5_o.9"
			Container0.lblInvt04.fgcolor = "4"
			
'			g_szURL = g_URLheader & "kycInvtGrade04.pdf"
			
		elseif g_szInvType = "05" then	'이자소득형
			Container0.ImgInvestGrade5.imgpath = "bg_risk6_o.9"
			Container0.lblInvt05.fgcolor = "16"
			
'			g_szURL = g_URLheader & "kycInvtGrade05.pdf"
			
		end if
		
		'투자성향설명 조회
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "PROS_CLS_CODE", 0, "S")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE", 0, g_szInvType)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "ENTR_YN", 0, "N")
		DATAMANAGER.RequestTranData("obcsb_acif_709a")
		
		'---------------------------------------------------
		'일반투자자 : 상품위험등급
		'---------------------------------------------------		
		if g_szGradeCode = "01" then		'1등급	'매우 높은 위험
			Container0.ImgGrade1.imgpath = "bg_line_riskrating1_6_o.9"
			Container0.lblGrade1.fgcolor = "16"
			
			Container0.ImgRiskGrade1.imgpath = "bg_risk1_o.9"
			Container0.lblRisk01.fgcolor = "16"
			
		elseif g_szGradeCode = "02" then	'2등급	'높은 위험
			Container0.ImgGrade2.imgpath = "bg_line_riskrating2_5_o.9"
			Container0.lblGrade2.fgcolor = "4"
			
			Container0.ImgRiskGrade2.imgpath = "bg_risk2_o.9"
			Container0.lblRisk02.fgcolor = "4"
			
		elseif g_szGradeCode = "03" then	'3등급	'다소 높은 위험
			Container0.ImgGrade3.imgpath = "bg_line_riskrating2_5_o.9"
			Container0.lblGrade3.fgcolor = "4"
			
			Container0.ImgRiskGrade3.imgpath = "bg_risk3_o.9"
			Container0.lblRisk03.fgcolor = "4"
			
		elseif g_szGradeCode = "04" then	'4등급	'보통 위험
			Container0.ImgGrade4.imgpath = "bg_line_riskrating2_5_o.9"
			Container0.lblGrade4.fgcolor = "4"
			
			Container0.ImgRiskGrade4.imgpath = "bg_risk4_o.9"
			Container0.lblRisk04.fgcolor = "4"
			
		elseif g_szGradeCode = "05" then	'5등급	'낮은 위험
			Container0.ImgGrade5.imgpath = "bg_line_riskrating2_5_o.9"
			Container0.lblGrade5.fgcolor = "4"
			
			Container0.ImgRiskGrade5.imgpath = "bg_risk5_o.9"
			Container0.lblRisk05.fgcolor = "4"
			
		elseif g_szGradeCode = "06" then	'6등급	'매우 낮은 위험
			Container0.ImgGrade6.imgpath = "bg_line_riskrating1_6_o.9"
			Container0.lblGrade6.fgcolor = "16"
			
			Container0.ImgRiskGrade6.imgpath = "bg_risk6_o.9"
			Container0.lblRisk06.fgcolor = "16"
			
		End if
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub

