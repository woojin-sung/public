Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	
	Container0.Icon0.setMaintainingRatio("1")
	Container0.Icon1.setMaintainingRatio("1")
	Container0.Icon2.setMaintainingRatio("1")
		
	Container1.Icon10.setMaintainingRatio("1")
	Container1.Icon20.setMaintainingRatio("1")
	Container1.imgTop.setMaintainingRatio("1")	
End Sub

