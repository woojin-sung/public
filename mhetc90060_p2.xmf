'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_가져오기풀팝업
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20201126 SWJ START : 공인인증서 '공인'글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.RequestCertCommand( "ReqCertNum", "", "" )
End Sub

'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	if sType == "RetCertNum" then
		if sParam1 == "Success" then
			if #sParam2 >= 12 then
				Edit0.caption = Left(sParam2,4)
				Edit1.caption = Mid(sParam2,5,4)
				Edit2.caption = Mid(sParam2,9,4)
			end if
		else
			Form.MsgBox( "알림22", sParam2, "", 6 )
		end if
	elseif sType == "RetCertFileImport" then
		if sParam1 == "Success" then
			Form.SendReturnToParent( "mhetc90060_p2" , "ok" )
			Form.CloseForm( )
		else
			'20170410 LES START - 에러코드 메세지 수정
			if InStr(sParam2,"PT115") == 0 then
				Form.MsgBox( "알림", sParam2, "", 6 )
			else
				Form.MsgBox("알림","[PT115] 인증서가 존재하지 않습니다.", "",6)
			end if
			'20170410 LES END 
		end if
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	'가져오기 실행
	Form.RequestCertCommand( "ReqCertFileImport", "", "" )
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm( )
End Sub






