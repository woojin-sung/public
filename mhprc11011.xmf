Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if Trim(sReturn1)  <> "" then
			edtGWAdd.caption = "1"	' 20160401 관심 타매체 실시간 연동(1:MTS에서 관심등록)
			Form.triggerEvent("linkfm0", "GW_ADD", sReturn1 & "★" & cmbGroup.caption)
		end if
	end if
End Sub
