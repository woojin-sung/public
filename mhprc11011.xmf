'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'20230728 HSZ START : 로그인 ID 비교로직 추가
	szLoginID = Form.GetSharedData("&USER_ID", false)
	Form.SetSharedData("11010_LoginID" , szLoginID)
	'20230728 HSZ END
	
	fmTab.setTabHeaderImage("tab_03_o.9", "tab_03_n.9", 0.1)
	fmTab.setTabHeaderFgColor(49, 110) 

	'OS별 위치 수정
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	
	if g_szDeviceOS == "2" then 			'아이폰 20230714 insertPage 시, 속도 느린 현상 조치
		fmTab.SetUsePageHeaderPos(false)	'insertpage 끝난 후, setTabheaderImage 한 번 더 호출해줘야함	  
     end if
	
	'차트관련 
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = true
	g_szChrtType = "D" '일
	g_szMinType = "1분"
	g_szTicType = "1틱"

	edtGWAdd.caption = "0"		' 20160401 관심 타매체 실시간 연동관련 에디트(1:MTS에서 관심등록)
	Change_Style("SET_BLANK")
	
	' //////////////////////////////////////////////////////////////////////
	' 관심 동기화
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////

	'20240524_01 KBC START : 해외주식 고도화 (이동삭제)
	'init_GWGroup() ' 관심그룹만 설정 
	'20240524_01 KBC END
	
	' 폼탭의 좌우스크롤 제어
'	fmTab0.currenttab = "1"
	linkfm0.gesture = true	'20231026 HSZ: 링크폼으로 교체(성능개선)
	Control_FmTab_Swipe()	

	'  조회 토글의 초기화 : 20160317 메인화면에만 미적용부분 추가
	g_szRSelect = Form.GetSharedData("GW_RSELECT", false)
	if g_szRSelect == "" then
		g_szRSelect = "0"
	end if	

	if g_szRSelect == "1" then
		imgToggle.imgpath = "toggle_3dots_03.9.png"
	elseif g_szRSelect == "2" then
		imgToggle.imgpath = "toggle_3dots_04.9.png"
	else
		imgToggle.imgpath = "toggle_3dots_02.9.png"	
	end if	

	Call f_SetPrcType(g_szRSelect)
	
	' //////////////////////////////////////////////////////////////////////	
	'20240524_01 KBC START : 해외주식 고도화
	Form.SaveConfigData("11010", "GW_MKT_TIME_CD", "")
	Form.SaveConfigData("11010", "GW_MKT_TIME_CD_MKT", "")
		
'	g_szDaytTime = Form.LoadConfigData("11010", "GW_DAYTIME")
'	
'	if g_szDaytTime == "" then
'		g_szDaytTime = "0"
'	end if		
'	
'	'해외주식 주간표기
'	if g_szDaytTime == "1" then '주간
'		imgToggleDayTime.imgpath = "checkmenu_o.png"	'20231201 HSZ: 이미지 변경	
'		btnToggleDayTime.fgcolor = 155
'	else
'		imgToggleDayTime.imgpath = "checkmenu_n.png"	'20231201 HSZ: 이미지 변경	
'		btnToggleDayTime.fgcolor = 127		
'	end if			
	'20240524_01 KBC END
	
	' 전체 장운영 알람 ----------------------------
	'DATAMANAGER.RequestRealData("ohhts_whol_mkop")	
	
	'관심 타매체 실시간 연동 ------------
	DATAMANAGER.RequestRealData("ohhts_intr_real")
	
	
	'11010.국내주식 관심종목
	'13101 국내CFD  관심종목

	'16010 해외주식 관심종목
	'16110 해외CFD  관심종목
	
	'11000 국내주식 현재가
	'13100 국내CFD 현재가
	
	'16000 해외주식 현재가
	'16100 해외CFD 현재가
	
	'12000 국내주식 주문
	'13200 국내CFD 주문

	'16060 해외주식 주문
	'16200 해외CFD 주문

	'13000 주식차트
	'16020 해외주식 차트
	
	
	'CFD 메뉴에서 관심종목 오픈시, 보유종목->주식 보유종목
	if g_szScreenNo = "13101" then 
		g_tNm      = {"최근조회", "CFD 보유종목"} 
		lblTitle.caption = "CFD관심종목"
	end if
	
	'20240524_01 KBC : 해외주식 고도화		
	if g_szScreenNo = "16010" then
		lblTitle.caption = "관심종목"
	elseif g_szScreenNo = "16110" then
		g_tNm      = {"최근조회", "CFD 보유종목"} 
		lblTitle.caption = "CFD관심종목"
		lblTitle.caption = "CFD관심종목"
	end if
	
	'HOME화면에서 요청 >>> 최근: HOME★BB, 보유: HOME★CC, (관심그룹X: HOME★page / 관심그룹O: HOME★page..그룹ID)
	szOpenData = Form.GetOpenLinkData()
	szOpenArray = ""
	g_szOpenData = ""
	if Instr(szOpenData, "HOME★") > 0 then
		szOpenArray = Split(szOpenData, "★")
		if Trim(szOpenArray(1)) == "" then
			g_szOpenData = "pageEMPTY" '등록된 관심그룹이 없을 경우
		else
			g_szOpenData = CStr(szOpenArray(1))
 		end if
	end if
	
	'20240524_01 KBC START : 해외주식 고도화
	DATAMANAGER.RequestTranData("obtro_comn_010r")
	'20240524_01 KBC END
	
	'20230802 HSZ START : 화면집계 서비스호출 추가 (동기화 사용여부)
	if g_szCloud = "0" then
		DATAMANAGER.RequestTranData("ohhts_open_001r")
	end if
	'20230802 HSZ END
End Sub

'============================================================================
'20240524_01 KBC : 해외주식 고도화
'============================================================================
Dim g_mrkt_pre		, g_mrkt_pre_idx
Dim g_mrkt_reg		, g_mrkt_reg_idx
Dim g_mrkt_aft		, g_mrkt_aft_idx
Dim g_mrkt_aft_end	, g_mrkt_aft_end_idx
Dim g_mrkt_day		, g_mrkt_day_idx
Dim g_mrkt_day_end	, g_mrkt_day_end_idx
Dim g_mrkt_holiday	, g_mrkt_holiday_idx


'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
'현재장운영코드         |      성조기이미지          | 디폴트 장운영 | 토글이미지                        |   성조기이미지        |   토글 장운영      | 토글이미지
'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
'005 AFTER 개시
g_mrkt_aft 			= Array("flag_us_mono.png"	, "정규"	, "999", "toggle_2dots_02.9.png", "", 		"flag_us2.png"		, "After"	, "005", "toggle_2dots_03.9.png", ""	)	'정규장 종료 코드는 서비스에 따로 없어서 999로 구분함
'006 AFTER 종료
g_mrkt_aft_end 		= Array("flag_us_mono.png"	, "정규"	, "999", "toggle_2dots_02.9.png", "", 		"flag_us_mono.png"	, "After"	, "006", "toggle_2dots_03.9.png", ""	)	'정규장 종료 코드는 서비스에 따로 없어서 999로 구분함

'001 주간 개시
g_mrkt_day 			= Array("flag_us2.png"		, "주간"	, "001", "toggle_2dots_02.9.png", "", 		"flag_us_mono.png"	, "정규"		, "999", "toggle_2dots_03.9.png", ""	)	'정규장 종료 코드는 서비스에 따로 없어서 999로 구분함
'002 주간 종료
g_mrkt_day_end 		= Array("flag_us_mono.png"	, "정규"	, "999", "toggle_2dots_02.9.png", "", 		"flag_us_mono.png"	, "주간"		, "002", "toggle_2dots_03.9.png", ""	)	'정규장 종료 코드는 서비스에 따로 없어서 999로 구분함

'003 PRE 개시
g_mrkt_pre 			= Array("flag_us2.png"		, "Pre"	, "003", "toggle_2dots_02.9.png", "", 		"flag_us_mono.png"	, "주간"		, "002", "toggle_2dots_03.9.png", ""	)
'004 정규 개시
g_mrkt_reg 			= Array("flag_us2.png"		, "정규"	, "004", "toggle_2dots_02.9.png", "", 		"flag_us_mono.png"	, "주간"		, "002", "toggle_2dots_03.9.png", ""	)

'000 휴장
g_mrkt_holiday 		= Array("flag_us_mono.png"	, "정규" , "999", "toggle_2dots_02.9.png", "", 		"flag_us_mono.png"	, "주간"		, "002", "toggle_2dots_03.9.png", ""	)	'정규장 종료 코드는 서비스에 따로 없어서 999로 구분함
'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

'============================================================================
Sub procUSAMarket(sParam)
	'-------------------------------------------
	' 장운영 시간 (서머타임 외)
	'-------------------------------------------
	'	005. 애프터마켓개시 	(06:00 ~ 07:00) 
	'	006. 애프터마켓종료 	(07:00 ~ 10:00)
	'	001. 주간장개시 		(10:00 ~ 17:30)
	'	002. 주간장종료 		(17:30 ~ 18:00)	
	'	003. 프리마켓개시 	(18:00 ~ 23:30)
	'	004. 정규장개시 		(23:30 ~ 06:00)

	'-------------------------------------------
	' 장상태	      	      디폴트		    토글
	'-------------------------------------------
	'	005. AFTER 개시	: 정규		<-> AFTER(실)
	'	006. AFTER 종료	: 정규		<-> AFTER
	'	001. 주간 개시	: 주간(실)	<-> 정규
	'	002. 주간 종료	: 주간		<-> 정규
	'	003. PRE 개시 	: PRE(실)	<-> 주간
	'	004. 정규장 개시	: 정규(실) 	<-> 주간
	'	000. 휴장		: 정규		<-> 주간
	'	013. 휴일
	'-------------------------------------------
	
'Form.Log("GWANSIM procUSAMarket : g_szUSAMrktTimeCd", sParam & ":"& g_szUSAMrktTimeCd)		
	
	if sParam == "INIT" then
		g_mrkt_pre_idx		= -1
		g_mrkt_reg_idx		= -1
		
		g_mrkt_aft_idx		= -1
		g_mrkt_aft_end_idx	= -1
		
		g_mrkt_day_idx		= -1
		g_mrkt_day_end_idx	= -1
		
		g_mrkt_holiday_idx	= -1
	end if
	
	if g_szUSAMrktTimeCd == "003" then	
		if g_mrkt_pre_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_pre(5)
			btnToggleDayTime.caption 	= g_mrkt_pre(6)
			szUSAMrktTimeInnerCd		= g_mrkt_pre(7)
			imgToggleDayTime.imgpath 	= g_mrkt_pre(8)
			g_mrkt_pre_idx 			= 1
		else
			imgFlag.imgpath 			= g_mrkt_pre(0)
			btnToggleDayTime.caption 	= g_mrkt_pre(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_pre(2)
			imgToggleDayTime.imgpath 	= g_mrkt_pre(3)
			g_mrkt_pre_idx 			= 0
		end if
		
	elseif g_szUSAMrktTimeCd == "004" then
		if g_mrkt_reg_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_reg(5)
			btnToggleDayTime.caption 	= g_mrkt_reg(6)
			szUSAMrktTimeInnerCd		= g_mrkt_reg(7)
			imgToggleDayTime.imgpath 	= g_mrkt_reg(8)
			g_mrkt_reg_idx 			= 1
		else
			imgFlag.imgpath 			= g_mrkt_reg(0)
			btnToggleDayTime.caption 	= g_mrkt_reg(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_reg(2)
			imgToggleDayTime.imgpath 	= g_mrkt_reg(3)
			g_mrkt_reg_idx 			= 0
		end if	
	
	elseif g_szUSAMrktTimeCd == "005" then
		if g_mrkt_aft_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_aft(5)
			btnToggleDayTime.caption 	= g_mrkt_aft(6)
			szUSAMrktTimeInnerCd		= g_mrkt_aft(7)
			imgToggleDayTime.imgpath 	= g_mrkt_aft(8)
			g_mrkt_aft_idx 			= 1
		else
			imgFlag.imgpath 			= g_mrkt_aft(0)
			btnToggleDayTime.caption 	= g_mrkt_aft(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_aft(2)
			imgToggleDayTime.imgpath 	= g_mrkt_aft(3)
			g_mrkt_aft_idx 			= 0
		end if	
	
	elseif g_szUSAMrktTimeCd == "006" then
		if g_mrkt_aft_end_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_aft_end(5)
			btnToggleDayTime.caption 	= g_mrkt_aft_end(6)
			szUSAMrktTimeInnerCd		= g_mrkt_aft_end(7)
			imgToggleDayTime.imgpath 	= g_mrkt_aft_end(8)
			g_mrkt_aft_end_idx 		= 1
		else
			imgFlag.imgpath 			= g_mrkt_aft_end(0)
			btnToggleDayTime.caption 	= g_mrkt_aft_end(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_aft_end(2)
			imgToggleDayTime.imgpath 	= g_mrkt_aft_end(3)
			g_mrkt_aft_end_idx 		= 0
		end if	
	
	elseif g_szUSAMrktTimeCd == "001" then
		if g_mrkt_day_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_day(5)
			btnToggleDayTime.caption 	= g_mrkt_day(6)
			szUSAMrktTimeInnerCd		= g_mrkt_day(7)
			imgToggleDayTime.imgpath 	= g_mrkt_day(8)
			g_mrkt_day_idx 			= 1
		else
			imgFlag.imgpath 			= g_mrkt_day(0)
			btnToggleDayTime.caption 	= g_mrkt_day(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_day(2)
			imgToggleDayTime.imgpath 	= g_mrkt_day(3)
			g_mrkt_day_idx 			= 0
		end if	

	elseif g_szUSAMrktTimeCd == "002" then
		if g_mrkt_day_end_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_day_end(5)
			btnToggleDayTime.caption 	= g_mrkt_day_end(6)
			szUSAMrktTimeInnerCd		= g_mrkt_day_end(7)
			imgToggleDayTime.imgpath 	= g_mrkt_day_end(8)
			g_mrkt_day_end_idx 		= 1
		else
			imgFlag.imgpath 			= g_mrkt_day_end(0)
			btnToggleDayTime.caption 	= g_mrkt_day_end(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_day_end(2)
			imgToggleDayTime.imgpath 	= g_mrkt_day_end(3)
			g_mrkt_day_end_idx 		= 0
		end if	
		
	elseif g_szUSAMrktTimeCd == "000" then
		if g_mrkt_holiday_idx == 0 then
			imgFlag.imgpath 			= g_mrkt_holiday(5)
			btnToggleDayTime.caption 	= g_mrkt_holiday(6)
			szUSAMrktTimeInnerCd		= g_mrkt_holiday(7)
			imgToggleDayTime.imgpath 	= g_mrkt_holiday(8)
			g_mrkt_holiday_idx 		= 1
		else
			imgFlag.imgpath 			= g_mrkt_holiday(0)
			btnToggleDayTime.caption 	= g_mrkt_holiday(1)
			szUSAMrktTimeInnerCd 		= g_mrkt_holiday(2)
			imgToggleDayTime.imgpath 	= g_mrkt_holiday(3)
			g_mrkt_holiday_idx 		= 0
		end if			

	end if
		
	'g_szUSAMrktTimeCd_Toggle : 관심종목 실제 시세조회 화면에서 사용 ( 보여질 장운영 시세에 맞춰서 변환된 코드)
	g_szUSAMrktTimeCd_Toggle = szUSAMrktTimeInnerCd
	
'Form.Log("GWANSIM procUSAMarket : g_szUSAMrktTimeCd_Toggle", sParam & ":" & g_szUSAMrktTimeCd_Toggle)

	Form.SaveConfigData("11010", "GW_MKT_TIME_CD"		, g_szUSAMrktTimeCd_Toggle)	'관심그리드에서 보여질 장구분 '설정 저장 (구 GW_DAYTIME), 시세조회화면에서 GW_LIST 수신 시 값을 사용함
	Form.SaveConfigData("11010", "GW_MKT_TIME_CD_MKT"	, g_szUSAMrktTimeCd)		'관심 사이드 팝업에서 장구분
End Sub


'============================================================================
' btnToggleDayTime_OnClick :  주간/주간이 아닌 경우 토글버튼
'============================================================================
Sub btnToggleDayTime_OnClick()
	Form.triggerEvent("linkfm0", "GW_SETTOPROW", "")	'20231026 HSZ: TOPROW 값 저장
	
	'20240524_01 KBC START : 해외주식 고도화
	procUSAMarket("Toggle")
	
	if CInt(fmTab.tabcount) > 0 then	
		edtListCnt.caption = "" ' 종목리스트 카운트 에디트 클리어
		Form.triggerEvent("linkfm0", "CLOSE_RIGHT", "")			'20231026 HSZ
		'Form.triggerEvent("linkfm0", "DAY_CHECK", sCheckState) 	'미사용
		Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex )
	end if 
	
'	if g_szDaytTime == "0" then
'		g_szDaytTime = "1"
'	elseif g_szDaytTime == "1" then
'		g_szDaytTime = "0"
'	end if	

'	f_SetDayTime(g_szDaytTime)	
	'20240524_01 KBC END
End Sub

Sub imgToggleDayTime_OnClick()
	btnToggleDayTime_OnClick()
End Sub

'============================================================================
' Form_OnLinkData : 20160404 로그인시 신호 받고 해당 ID로 관심요청
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&LOGIN" then
		if sValue == "login" then
			'20230728 HSZ START : 로그인 ID 비교로직 추가
			szBeforeID = Trim(Form.GetSharedData("11010_LoginID", false ))
			szAfterID = Trim(Form.GetSharedData("&USER_ID", false))

			if szBeforeID <> szAfterID then
				init_GWGroup()
				
				Form.SetSharedData("11010_LoginID" , szAfterID)
			end if
			'20230728 HSZ END	
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'MsgBox sKeyName & ":" & sRet & ":메인"

	' 환경설정 팝업 리턴 ---------------------------------------------------
	if sKeyName == "GW_SET" then
		if Trim(sRet) <> "" then
			if CInt(fmTab.tabcount) > 0 then
				' 폼탭의 좌우스크롤 제어
				Control_FmTab_Swipe()				
				Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex)			
			end if 
		end if
	' 편집 팝업 리턴	 -----------------------------------------------------
	elseif sKeyName == "GW_SET2" then
		'편집시 ID가 메인화면과 연동안되는부분 때문에 추가 //////
		Dim szvrsnID		
		szvrsnID = Form.GetSharedData("VRSN_ID", true)		
		if Trim(szvrsnID) <> "" then
			edtvrsnID.caption = szvrsnID
		end if

		if sRet == "0" then		' 0 : 종목편집 'mhprc11010_p13
			if (Trim(sRet)  <> "") and (CInt(fmTab.tabcount) > 0) then			
				edtListCnt.caption = sRet
				'관심종목수 0 이면 
				if CInt(edtListCnt.caption) > 0 then
					imgNotice.visible = false
					lbNoticeMsg.visible = false
					imgNotice.left = 572
					lbNoticeMsg.left = 487
				else
					imgNotice.visible = true
					lbNoticeMsg.visible = true
					imgNotice.left = 572
					lbNoticeMsg.left = 487
				end if 

			    '종목추가 창에서 선택된 최종그룹으로 설정
			    szSave = Form.GetEnvData("SELECT_GWGROUP")		    

				fmTab.currenttabpageid = "page"& szSave
				if g_szDeviceOS == "2" then 'iOS일 경우
					fmTab.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)
				end if

			     '관심그룹의 관심종목수 최신으로 업데이트
				g_OnlyUpdate = true
				DATAMANAGER.RequestTranData("ohhts_intr_006r")			    
			    
			    '관심종목 조회
				edtGWAdd.caption = "1"	' 20160401 관심 타매체 실시간 연동(1:MTS에서 관심등록)
				Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex)				
			end if		
			
		elseif sRet == "2" then    ' 2: 최근조회,보유종목삭제	
			Insert_cmbGroup()
			
		elseif sRet == "1" then    '1 : 그룹편집 'mhprc11010_p12
			init_GWGroup()
			f_SetPrcType(g_szRSelect)
		end if

	elseif sKeyName == "Chart_Min" then
		g_szMinType = sRet
		rdoChart.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(rdoChart.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		rdoChart.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(rdoChart.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]
		PeriodSet(g_szChrtType)
		
	elseif sKeyName = "snsshare" then			' SNS 리턴 
		if sRet == "2" then
			Dim szScreenNo, szFileName
			
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"

			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(sRet, "", "", szFileName)
		end if
		
	elseif sKeyName = "mhprc11010_p8_select" then '그룹팝업에서 리턴 
	     '특정그룹 선택
		if sRet == g_tKey[0] then			 
			fmTab.currenttabpageid = g_tPage[0]
		elseif sRet ==  g_tKey[1] then 
			fmTab.currenttabpageid =  g_tPage[1]
		else
			if fmTab.GetTabPageCaption("page"& sRet) <> "" then				
				fmTab.currenttabpageid = "page"& sRet
			end if 
		end if 
		if g_szDeviceOS == "2" then 'iOS일 경우
			fmTab.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)		
		end if 
	elseif sKeyName = "mhprc11010_p8_edit" then '그룹팝업에서 리턴
		'20230810 KKM START : 관심동기화 사용여부에 따른 분기처리
		If g_szCloud == "0" then	
			Form.OpenFramePopup("mhprc11010_p2" , "AddGroup", "") '편집 팝업 오픈
		else
			'편집 팝업 오픈	
			Form.OpenFramePopup("mhprc11010_p12" , "", "") 	
		end if 
		'20230810 KKM END		
		
	'그룹추가
	elseif sKeyName == "GROUP_ADD" then	' from :: mhprc11000_pf
		
		if sRet == "" then
			Exit Sub
		end if 
		tData = Split(sRet, "★")		
		if tData(2) == "T" then  
			g_szRow = 0    ' 관심그룹 맨 위 추가 		
		else
			g_szRow = grdGroup.rowcount	 ' 관심그룹 맨 아래 추가 		
		end if 

		g_szGroupID = tData(0)
		g_szGroupName = tData(1)
		grdGroup.insertrow = g_szRow
		grdGroup.SetCellData("bd_count", g_szRow, 0)		
		grdGroup.SetCellData("bd_code", g_szRow, tData(0))
		grdGroup.SetCellData("bd_name", g_szRow, tData(1))
		grdGroup.selectrow = g_szRow
		grdGroup.toprow = g_szRow
		
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_008r")
		else	
			' 로컬 저장된 관심그룹 저장하기
			Save_GWGroup()
			
			'20230822 관심동기화 ON과 OFF가 동일하게 처리됨.
			' 최초 관심그룹을 그룹콤보에 넣기
			Insert_cmbGroup()
			SetVisibleButton()
			
			'동적으로 관심그룹 폼탭구성(등록된 관심그룹이 있는 경우)
			fmTab.SetTabPageCaption("page000", "  " & grdGroup.GetCellData("bd_name", 0) & "  ")	
		end if
	end if

End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 가로팝업 전환
	' ----------------------------------------------------------------------
	if sEventName == "CHANGE_ORIENTATION" then
		Form.OpenPopup("mhprc11010_h0", g_szRSelect, "")
	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
	elseif sEventName == "SCREEN_MENU" then
		'스타일10(두줄), 스타일11(한줄),  스타일12(차트)
		if sParam == "SET_STYLE1" or sParam == "SET_STYLE2" or sParam == "SET_STYLE3" or sParam == "SET_STYLE4" or sParam == "SET_STYLE10" or sParam == "SET_STYLE11" or sParam == "SET_STYLE12" then
			
			Form.SetEnvData("1", "GW_STYLE", sParam)
			if CInt(fmTab.tabcount) > 0  then
				Form.triggerEvent("linkfm0", "STYLE", sParam)
				Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex)
			
				Change_Style(sParam)
				Change_StyleIcon(sParam)
			end if 
			
		elseif sParam == "SET_SCREEN" then
			Form.OpenPopupAnimation("mhprc11010_p10", "환경설정","", "2") '아래 팝업으로 변경
		elseIf sParam = "SHA_SNS" Then			' SNS 리턴 : SNS연동 추가(화면연동)
			Form.OpenDialog("sharesns1" , "0", "")
		elseif sParam = "HELP_POPUP" Then'20211019 HSZ 도움말 추가
			Form.OpenPopup( "mhprc11010_p4", "HELP_POPUP" , "")
		end if
	elseif sEventName == "SET_VISIBLE" then
		SetVisibleButton()	
		
	elseif sEventName == "GROUP_ADD2" then '최초그룹등록과 종목등록
		init_GWGroup()
		f_SetPrcType(g_szRSelect)
		
	elseif sEventName == "ADD" 		   '최근조회/보유종목에서 종목등록되었을 때
		or sEventName == "DEL" then   '최근조회/보유종목 이외에서 종목삭제되었을 때 관심그룹의 관심종목수 최신으로 업데이트하고 그룹내 종목도 재조회
	    '종목추가 창에서 선택된 최종그룹으로 설정
	    szSave = Form.GetEnvData("SELECT_GWGROUP")
    
	    if cmbGroup.cbkeydata <> szSave then
	       fmTab.currenttabpageid = "page"& szSave
		   if g_szDeviceOS == "2" then 'iOS일 경우
		      fmTab.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)
		   end if
	    end if 
	    
	    '관심그룹의 관심종목수 최신으로 업데이트
	    g_OnlyUpdate = true
		DATAMANAGER.RequestTranData("ohhts_intr_006r")			    
	    
	    '관심종목 조회
		edtGWAdd.caption = "1"	' 20160401 관심 타매체 실시간 연동(1:MTS에서 관심등록)
		Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex)	
		
	elseif  sEventName == "ADD2" or sEventName == "DEL2" 	then   
		'최근조회/보유종목 에서 종목삭제되었을 때 관심그룹의 관심종목수 최신으로 업데이트
	    g_OnlyUpdate = true
		DATAMANAGER.RequestTranData("ohhts_intr_006r")			    
		
	'20240524_01 KBC START : 해외주식 고도화		
	elseif sEventName == "GESTURE" then		
		if sParam == "ENABLE" then
			Control_FmTab_Swipe()
		else 
			linkfm0.gesture = false
		end if	
	'20240524_01 KBC END
	end if
	
End Sub

'============================================================================
' Form_OnRefresh : 관심을 첫화면으로 했을때 종목 재조회
'============================================================================
Sub Form_OnRefresh()
	'init_GWGroup()
	if CInt(fmTab.tabcount) > 0  then
		Form.triggerEvent("linkfm0", "CLOSE_RIGHT", "")	'20230727 HSZ
		Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex)
		SetVisibleButton() '20230809 HSZ 최근조회/보유종목 미사용시 버튼이 보이지 않는 현상 수정
	end if 
	
	'20240524_01 KBC START : 해외주식 고도화 (백그라운드->포그라운드 전환 시, 재등록해야 함)
	DATAMANAGER.CancelRealData("ohhts_exst_mko2")		
	DATAMANAGER.RequestTranData("obtro_comn_010r")
	'20240524_01 KBC END
	
End Sub

'============================================================================
' Form_OnFormClose : 20160401
'============================================================================
Sub Form_OnFormClose()
	' 전체 장운영 알람 ----------------------------
	'DATAMANAGER.CancelRealData("ohhts_whol_mkop")
	
	' 20160401 관심 타매체 실시간 연동 ------------
	DATAMANAGER.CancelRealData("ohhts_intr_real")	

	'20240524_01 KBC : 해외주식 고도화		
	DATAMANAGER.CancelRealData("ohhts_exst_mko2")		
End Sub


'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'관심그룹 조회
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
		grdGroup.rowcount = 0
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID	

	' 관심그룹  최초등록
	elseif szTranID == "ohhts_intr_008r" then
		DATAMANAGER.ClearInputData(false, "ohhts_intr_008r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_008r")
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_MOD_YN",      0, "0")				
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")	
		'최초등록
		' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", 0, grdGroup.GetCellData("bd_code", 0))
		' FID관심그룹명
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_GRP_NAME",  0, grdGroup.GetCellData("bd_name", 0))	
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", 0, "0")			' 수정안함: 0, 수정:1
	
	'20230802 HSZ START : 화면집계 서비스호출 추가
	elseif szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = CInt(szOSType) + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType)			'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "11015")				'하드코딩(미사용 화면번호)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "관심종목(동기화사용)")'하드코딩
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) 					'최근 로그인 아이디
	'20230802 HSZ END
	
	'20240524_01 KBC START : 해외주식 고도화
	elseif szTranID == "obtro_comn_010r" then
		DATAMANAGER.SetDataValue( 0, "obtro_comn_010r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0, "01") '미국 장운영조회	
	'20240524_01 KBC END
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' 전체 장운영 알람 자동갱신
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
		
	'관심 타매체 실시간 연동
	elseif szTranID == "ohhts_intr_real" then
		DATAMANAGER.SetDataValue(1, "ohhts_intr_real", "InBlock1", "FIDR_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	
	'20240524_01 KBC START : 해외주식 고도화
	elseif szTranID == "ohhts_exst_mko2" then
		DATAMANAGER.SetDataValue(1, "ohhts_exst_mko2", "InBlock1", "FIDR_OVRS_STCK_MRKT_CLS_CODE", 0, "*") '해외 장운영 실시간 등록
	'20240524_01 KBC END
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' 관심그룹 조회
	if szTranID == "ohhts_intr_006r" then
         ' 동기화 상태일때도 파일에는 계속저장
		Save_GWGroup()
		
		'각 관심그룹별 관심종목수 업데이트 
		if g_OnlyUpdate == true then

			SetVisibleButton()
			g_OnlyUpdate = false
		else
			'관심그룹 그룹콤보에 넣고 초기화
			Insert_cmbGroup()
		end if 
		
		Form.triggerEvent("linkfm0", "NEW_FIDVRSN", edtvrsnID.caption) '20240524_01 KBC : 해외주식 고도화 (HTS에서 종목편집 시, 재조회시 버전도 다시 가져와야함)
	
	'관심그룹  최초등록 후 
	elseif szTranID == "ohhts_intr_008r" then
		' 최초 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
		SetVisibleButton()
		
		'동적으로 관심그룹 폼탭구성(등록된 관심그룹이 있는 경우)
		fmTab.SetTabPageCaption("page000", "  " & grdGroup.GetCellData("bd_name", 0) & "  ")	
		
	'20240524_01 KBC START : 해외주식 고도화
	elseif szTranID == "obtro_comn_010r" then
		'장운영정보 조회
		sMkopClsCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "OVRS_MKOP_CLS_CODE" , 0)
		
'Form.Log("GWANSIM", "장운영 : " & sMkopClsCode)
'Form.ShowAlert("알림",  "장운영 " & sMkopClsCode)
szMCISeesionKey = Form.GetSharedData("&MCI_SESSION_KEY", False)
Label1.Caption = "장운영 조회 : " & sMkopClsCode& ", 세션키 : " & szMCISeesionKey

		if sMkopClsCode == "013" then
			'휴일
			sMkopClsCode = "000" '휴장하고 처리가 다르면 추가개발해야 함
		elseif sMkopClsCode == "999" then
			'원장에 장운영정보 없는경우 있다고 함. 그때 999로 내려옴
			sMkopClsCode = "004" '정규장으로 일단 처리				
		end if
		
		g_szUSAMrktTimeCd = sMkopClsCode
		procUSAMarket("INIT")
		
		'장운영조회후 관심종목 시세가 시작되어야 해서 변경
		linkfm0.linkfile = "mhprc11010_t00"	'기존 속성창에서 설정하는것을 지우고 스크립트로 처리함 (순차처리 필요)
		init_GWGroup() 					'관심그룹만 설정 (ohhts_intr_006r)
		
		'해외 장운영 실시간
		DATAMANAGER.RequestRealData("ohhts_exst_mko2")	

	'20240524_01 KBC END		
	
	end if
	
	'편집시 ID가 메인화면과 연동안되는부분 때문에 추가
	If szTranID == "ohhts_intr_006r" or szTranID == "ohhts_intr_008r" Then	
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) 		
	End if 	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	'20240524_01 KBC : 해외주식 고도화 (기존 장운영 미사용으로 삭제)
'	' ----------------------------------------------------------------------
'	' 전체 장운영 알람 자동갱신
'	' ----------------------------------------------------------------------
'	if szTranID == "ohhts_whol_mkop" then
'		edtMkopCd.caption = DATAMANAGER.GetDataValue(1, "ohhts_whol_mkop", "OutBlock1", "FIDR_MKOP_TRNM_CODE", 0)
'		edtMkopNm.caption = DATAMANAGER.GetDataValue(1, "ohhts_whol_mkop", "OutBlock1", "FIDR_MKOP_CLS_NAME",  0)
	
	' ----------------------------------------------------------------------
	' 20160401 관심 타매체 실시간 연동
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_real" then
		'Form.Log("GWANSIM ohhts_intr_real(R)", sMrktClsCode & ":" & sMkopClsCode)		
		'KBC : 현재 안내려옴. 필요 시 다시 확인해서 작업해야 함
		
		Dim szID, szReturn
		szID, szReturn = "", ""
		
		if g_szCloud == "1" then		' Server 저장시
			szID = Form.GetSharedData("&USER_ID", false)	' USER ID
			szReturn = DATAMANAGER.GetDataValue(1, "ohhts_intr_real", "OutBlock1", "FIDR_USER_ID", 0)
			
			if Trim(szID) == Trim(szReturn) then
				if Trim(edtGWAdd.caption) == "1" then
					edtGWAdd.caption = "0"
					Exit Sub
				else
					edtGWAdd.caption = "0"
					init_GWGroup()
				end if
			end if
		end if

	'20240524_01 KBC START : 해외주식 고도화			
	elseif szTranID == "ohhts_exst_mko2" then
		sMrktClsCode = DATAMANAGER.GetDataValue( 1, "ohhts_exst_mko2" , "OutBlock1" , "FIDR_OVRS_STCK_MRKT_CLS_CODE" , 0)
		sMkopClsCode = DATAMANAGER.GetDataValue( 1, "ohhts_exst_mko2" , "OutBlock1" , "FIDR_OVRS_MKOP_CLS_CODE" , 0)
		
Form.Log("GWANSIM", "장운영(R) : " & sMrktClsCode & ":" & sMkopClsCode)				
'Form.ShowAlert("알림",  "장운영(R) " & sMrktClsCode & ":" & sMkopClsCode)

		'미국
		if sMrktClsCode == "01" then
		
szMCISeesionKey = Form.GetSharedData("&MCI_SESSION_KEY", False)
Label1.Caption = "장운영 실시간 : " & sMkopClsCode& ", 세션키 : " & szMCISeesionKey


			'FIDR_OVRS_MKOP_CLS_CODE
			'		000.휴장
			'		001.주간개시
			'		002.주간종료
			'		003.PRE개시
			'		004.정규개시
			'		005.AFTER개시
			'		006.AFTER종료
			'		013.휴일

			if sMkopClsCode <> g_szUSAMrktTimeCd then '이전과 같으면 처리안함
		
				if sMkopClsCode == "001" then
					Form.Toast(0,"미국(주간)장 거래가 시작되었습니다.", 1)
				
				elseif sMkopClsCode == "003" then
					Form.Toast(0,"미국(Pre)장 거래가 시작되었습니다.", 1)
	
				elseif sMkopClsCode == "004" then
					Form.Toast(0,"미국(정규)장 거래가 시작되었습니다.", 1)
	
				elseif sMkopClsCode == "005" then
					Form.Toast(0,"미국(After)장 거래가 시작되었습니다.", 1)
								
				elseif sMkopClsCode == "000" or sMkopClsCode == "002" or sMkopClsCode == "006" then
					'No Action

				elseif sMkopClsCode == "013" then
					sMkopClsCode = "000" '휴장하고 처리가 다르면 추가개발해야 함

				elseif sMkopClsCode == "999" then
					sMkopClsCode = "004" '원장에 장운영정보 없는경우 있다고 함. 그때 999로 내려옴
					
				else
					Form.Toast(0,"미국 장운영구분 확인이 필요합니다.", 1) '약속된 값 이외의 값이 수신된 경우
					sMkopClsCode = "004" '만일 서비스 오류 시 정규장으로 처리함
				end if
	
				g_szUSAMrktTimeCd = sMkopClsCode
				procUSAMarket("INIT")
				
				'시세화면 리프래쉬  ---------------------------------------------------
				Form.triggerEvent("linkfm0", "GW_SETTOPROW", "")
				
				if CInt(fmTab.tabcount) > 0 then	
					edtListCnt.caption = "" ' 종목리스트 카운트 에디트 클리어
					Form.triggerEvent("linkfm0", "CLOSE_RIGHT", "")
					Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex )
				end if 
			end if
		end if
	'20240524_01 KBC END		
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "ohhts_intr_006r" then
		Form.ShowAlert("알림", szErrMsg)
		
	'20240524_01 KBC START : 해외주식 고도화
	'!!! 장운영 서비스가 오류나도 관심종목 조회는 될 수 있도록 처리 함. 국내까지 영향을 주면 안됨 !!!
	elseif szTranID == "obtro_comn_010r" then
		g_szUSAMrktTimeCd = "004" '정규장
		procUSAMarket("INIT")
		
		'장운영조회후 관심종목 시세가 시작되어야 해서 변경
		linkfm0.linkfile = "mhprc11010_t00" 	'기존 속성창에서 설정하는것을 지우고 스크립트로 처리함 (순차처리 필요)
		init_GWGroup() 					' 관심그룹만 설정 (ohhts_intr_006r)
		
		'해외 장운영 실시간
		DATAMANAGER.RequestRealData("ohhts_exst_mko2")	
	'20240524_01 KBC END			
	end if
End Sub

'============================================================================
' fmTab_OnTabChanged
'============================================================================
'230717 HSZ START
Sub fmTab_OnTabChanged(nCurrentTab)
	nPage = Cdbl(cmbGroup.currentindex)
	nCurrentPage = Cdbl(nCurrentTab)
	
	fmTab.currenttab = nCurrentTab
	Form.triggerEvent("linkfm0", "CLOSE_RIGHT", "")
	cmbGroup.currentindex = nCurrentTab
	
	'20240524_01 KBC START : 해외주식 고도화 (HTS에서 종목편집 시, 재조회시 버전도 다시 가져와야함)
	'관심그룹의 관심종목수 최신으로 업데이트
	g_OnlyUpdate = true
	DATAMANAGER.RequestTranData("ohhts_intr_006r") 
	'20240524_01 KBC EMD
End Sub
'============================================================================

'20230717 HSZ END
'============================================================================
' cmbGroup_OnEditComplete
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	Dim szStyle, szKey

	fmTab.currenttab = iIndex		'관심그룹폼탭도 동일하게  변경
	
	SetVisibleButton()
	edtListCnt.caption = ""		' 종목리스트 카운트 에디트 클리어
	
	' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
	Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
	if g_szFirst == "0" then
		'  스타일 초기화 ///////////////////////////////////////////////////////
		if Form.GetEnvData("GW_STYLE") == "" then
			szStyle = "SET_STYLE10" '스타일10(두줄)을 디폴트
		else
			szStyle = Form.GetEnvData("GW_STYLE")
		end if
		
		Change_Style(szStyle)
		Change_StyleIcon(szStyle)
		g_szFirst = "1"
		' //////////////////////////////////////////////////////////////////////
	else 
		szStyle = Form.GetEnvData("GW_STYLE")	
		Form.SetEnvData("1", "GW_STYLE", szStyle)
	end if
	
	szKey = cmbGroup.cbkeydata
	
	if CInt(fmTab.tabcount) > 0 then
		' Sub화면에 조회 요청	
		Form.triggerEvent("linkfm0", "STYLE", szStyle)	
		Form.triggerEvent("linkfm0", "GW_COUNT", grdGroup.rowcount) '관심그룹수를 서브화면에 보냄.	
		Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex )
	end if
End Sub

'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick()
	if Int(cmbGroup.currentindex) == 0 then
		cmbGroup.currentindex = cmbGroup.rowcount-1
	else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	end if
End Sub

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick()
	if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
		cmbGroup.currentindex = 0		
	else
		cmbGroup.currentindex = cmbGroup.currentindex + 1		
	end if
	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub
'============================================================================
' rdoChart_OnClick
'============================================================================
Sub rdoChart_OnClick(nIndex)
	if nIndex == 0 then  '일
		g_flagMin = false
		g_flagTic = false
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
	elseif nIndex == 1 then  '주/월
		g_flagMin = false
		g_flagTic = false
		if g_flagWeek == true   then
			if g_szChrtType == "W" then
				g_szChrtType = "M"
				g_flagWeek = false
				rdoChart.SetRadioCaption( 1, "월" )
			else
				g_szChrtType = "W"
			end if
		else
			if g_szChrtType == "M" then
				g_szChrtType = "W"
				g_flagWeek = true
				rdoChart.SetRadioCaption( 1, "주" )
			else
				g_szChrtType = "M"
			end if
		end if	
		PeriodSet(g_szChrtType)
	elseif nIndex == 2 then   '분
		g_flagTic = false
	
		g_szChrtType = "A"
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(rdoChart.GetRadioCaption( 2),"분")
			g_szMinType = tmpMin[0]
			PeriodSet(g_szChrtType)
		else
			'분 bottom popup
			sTemp = rdoChart.GetRadioCaption(2)
			if sTemp = "1분" then	
				Combo1.currentindex = 0
			elseif sTemp = "3분" then	
				Combo1.currentindex = 1
			elseif sTemp = "5분" then	
				Combo1.currentindex = 2
			elseif sTemp = "10분" then	
				Combo1.currentindex = 3
			elseif sTemp = "15분" then	
				Combo1.currentindex = 4
			elseif sTemp = "30분" then	
				Combo1.currentindex = 5
			elseif sTemp = "60분" then	
				Combo1.currentindex = 6						
			elseif sTemp = "120분" then	
				Combo1.currentindex = 7
			end if 	
			Combo1.OpenList()	
		end if
	elseif nIndex == 3 then   '틱
		g_flagMin = false
		
		g_szChrtType = "T"
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(rdoChart.GetRadioCaption( 3),"틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
		else
			'틱 bottom popup
			sTemp = rdoChart.GetRadioCaption(3)					
			if sTemp = "1틱" then	
				Combo2.currentindex = 0
			elseif sTemp = "3틱" then	
				Combo2.currentindex = 1
			elseif sTemp = "5틱" then	
				Combo2.currentindex = 2
			elseif sTemp = "10틱" then	
				Combo2.currentindex = 3
			elseif sTemp = "15틱" then	
				Combo2.currentindex = 4
			elseif sTemp = "30틱" then	
				Combo2.currentindex = 5
			elseif sTemp = "60틱" then	
				Combo2.currentindex = 6						
			elseif sTemp = "120틱" then	
				Combo2.currentindex = 7
			end if 	
			Combo2.OpenList()	
		end if
	end if	
End Sub	

'============================================================================
Sub Form_OnFormInitBefore()
	'------------------------------------------------------------------
	' MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(2,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(2,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	
'	if szDev == "1" then
'		Label1.visible = True
'	end if
	'------------------------------------------------------------------
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단	
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )
	
	'아이콘 이미지 
	ImgSetting.setMaintainingRatio("1")
	ImgBackPress.setMaintainingRatio("1")
	imgNotice.setMaintainingRatio("1")
	ImgOpenGroup.setMaintainingRatio("1")
	imgAddgroup.setMaintainingRatio("1")
	imgAddItem.setMaintainingRatio("1")
	imgEditItem.setMaintainingRatio("1")
	imgShareItem.setMaintainingRatio("1")	
	imgStyle0.setMaintainingRatio("1")
	'imgToggle.setMaintainingRatio("1")
	
	'20240524_01 KBC START : 해외주식 고도화
	'imgToggleDayTime.setMaintainingRatio("1") 
	imgFlag.setMaintainingRatio("1")
	'20240524_01 KBC END

End Sub

