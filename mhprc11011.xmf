Sub Combo1_OnEditComplete(iIndex)			
			
	if iIndex = 1 then  		
		g_szMinType = "3분"	
	elseif iIndex = 2 then  		
		g_szMinType = "5분"	
	elseif iIndex = 3 then  		
		g_szMinType = "10분"	
	elseif iIndex = 4 then  		
		g_szMinType = "15분"	
	elseif iIndex = 5 then  		
		g_szMinType = "30분"	
	elseif iIndex = 6 then  		
		g_szMinType = "60분"	
	elseif iIndex = 7 then  		
		g_szMinType = "120분"	
	else  		
		g_szMinType = "1분"	
	end 	if	
			
	rdoChart.SetRadioCaption( 2, g_szMinType)
	tmpMin = split(rdoChart.GetRadioCaption(2),"분")
	g_szMinType = tmpMin[0]
	
	PeriodSet(g_szChrtType)
End Sub			

