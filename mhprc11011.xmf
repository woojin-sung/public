'============================================================================
' Change_StyleIcon : 스타일 아이콘 이미지 적용
'============================================================================
Function Change_StyleIcon(sStyle)
	'기존 1,2,3,4 스타일을 추가된 스타일10(두줄), 스타일11(한줄), 스타일12(차트)로 변경
	if sStyle == "SET_STYLE1" then  		' 1 >> 10
		imgStyle.imgpath = g_tStyleImgNm(0) 
		LblStyle.caption = "두줄"
		imgStyle.visible = true
		imgStyle0.visible = false
	elseif sStyle == "SET_STYLE2" then 		' 2 >> 10
		imgStyle.imgpath = g_tStyleImgNm(0)
		imgStyle.visible = true
		imgStyle0.visible = false
		LblStyle.caption = "두줄"
	elseif sStyle == "SET_STYLE3" then
		imgStyle.imgpath = g_tStyleImgNm(2)	' 3 >> 12
		imgStyle.visible = true
		imgStyle0.visible = false
		LblStyle.caption = "차트"
	elseif sStyle == "SET_STYLE4" then		' 4 >> 10
		imgStyle.imgpath = g_tStyleImgNm(0)
		imgStyle.visible = true
		imgStyle0.visible = false
		LblStyle.caption = "두줄"		
	elseif sStyle == "SET_STYLE10" then
		imgStyle.imgpath = g_tStyleImgNm(0)
		imgStyle.visible = true
		imgStyle0.visible = false
		LblStyle.caption = "두줄"
	elseif sStyle == "SET_STYLE11" then
		imgStyle.imgpath = g_tStyleImgNm(1)
		imgStyle.visible = true
		imgStyle0.visible = false
		LblStyle.caption = "한줄"
	elseif sStyle == "SET_STYLE12" then
		imgStyle.imgpath = g_tStyleImgNm(2)
		imgStyle.visible = false
		imgStyle0.visible = true
		LblStyle.caption = "차트"
	end if
	btnStyle.visible = true
End Function

'============================================================================
' f_ShowGroupList : 관심그룹리스트 보이기
'============================================================================
Function f_ShowGroupList()
	dim nRowCnt, szSendData
	nRowCnt = CInt(grdGroup.rowcount)
	szSendData = ""
	
	if nRowCnt > 0 then
		for i=0 to nRowCnt-1
			dim sKey, sName, sStr
			sKey = grdGroup.GetCellData( "bd_code", i )
			sName = grdGroup.GetCellData( "bd_name", i )
			sStr = sKey & "`" & sName
			
			if szSendData == "" then
				szSendData = sStr
			else
				szSendData = szSendData & "‡" & sStr
			end if
		next
	end if
	
	'20211116 아이티젠 김성수 추가
	'종목편집 창에서 Env가 바뀌는 것때문에 현재 선택 그룹키 값을 저장
	Form.SetSharedData( "PresentSelectKey", cmbGroup.cbkeydata)
	
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	if g_Ostype = "2" then 
		Form.OpenPopup("mhprc11010_p8" , szSendData, "", "")
	else 
		Form.OpenPopup("mhprc11010_p8" , szSendData, "", "1")
	end if
	
End Function


