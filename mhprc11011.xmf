'============================================================================
' 화 면 명 : 관심종목 (375 X 602)
' 화면설명 : 관심종목
' 작    성 : 20230531 KKM
'============================================================================
'fmTab -> 그룹리스트. 탭헤더만 (안에는 empty)
'linkfm0-> 실제 그룹 내 데이터 로딩하는 탭. 	20231026 HSZ: fmTab0->linkfm0로 교체
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szFirst
g_szFirst = "0"

Dim g_szTitle
g_szTitle = "알림"

' 0현재/1예상/2단일 토글
Dim g_szRSelect 
g_szRSelect = "0"

'20240524_01 KBC START : 해외주식 고도화
Dim g_szUSAMrktTimeCd
g_szUSAMrktTimeCd = ""

Dim g_szUSAMrktTimeCd_Toggle
g_szUSAMrktTimeCd_Toggle = ""

'' 0주간X/1주간
'Dim g_szDaytTime 
'g_szDaytTime = "0"
'20240524_01 KBC END

'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

g_tGSelect = {}
g_tDefault = {"GW_RECENT", "GW_HOLDING"}
g_tKey     = {"BB", "CC"}
g_tNm      = {"최근조회", "보유종목"}
g_tPage    = {"page009370", "page001471"}

Dim g_szRecent, g_szHold
g_szRecent = "1"   '1 - 보이기, 0 - 안보이기
g_szHold = "1"

' 차트관련 ------------------------------------------------------------------
Dim g_szChrtType
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
' ---------------------------------------------------------------------------

' 20160404 앱 최초 등록확인(그룹 없음) ->편집 활성화
Dim g_szAppFirst
g_szAppFirst = "NO"

Dim g_szScreenNo 		'20210823 HSZ 국내CFD 화면 추가

Dim g_tStyleImgNm
g_tStyleImgNm = {"icon_style10.png", "icon_style11.png", "icon_chart.png" } ' 스타일 버튼이미지

Dim gGwanNum, maxGwanNum
Dim g_GwantList
g_GwantList = {}

Dim g_szOpenData		'20230208 HSZ 시장종합 개선
g_szOpenData = ""

Dim g_szDeviceOS

Dim g_szgrpList 		'cmbGroup의 입력값.
g_szgrpList = ""

Dim g_OnlyUpdate   	'관심그룹의 종목수 업데이트 006r
g_OnlyUpdate = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' init_GWGroup :  관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup()
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup()
		Insert_cmbGroup()		
	end if
End Function

'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect	
	
	'최근조회,보유종목
	'1 - 보이기, 0 - 안보이기
	g_szRecent = Form.LoadConfigData("GW_SET2", "RECENT")
	g_szHold = Form.LoadConfigData("GW_SET2", "HOLD")	
	
	if g_szRecent == "" then ' 예외처리
		g_szRecent = "1"
	end if 
	if g_szHold == "" then ' 예외처리
		g_szHold = "1"
	end if 
	
	'탭클리어 최초에는 없음
	'여러번의 관심그룹편집으로 관심그룹순서가 엉망이 될 수 있어 반드시 모든 관심그룹탭삭제
	sTemp = g_szgrpList
	tData = Split(sTemp, "\r\n")
	
	nTab = CDbl(fmTab.tabcount)
	if nTab > 0 then	'230717 탭페이지 삭제
		if g_szDeviceOS == "2" then		'iOS
			fmTab.setUseAnimation("0")
			fmTab.deleteAllPage()
		else
			fmTab.deleteAllPage()
			fmTab.setUseAnimation(false)
		end if
	end if
	
	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")	

	'HOME화면에서 이동한 경우
	if Trim(g_szOpenData) <> "" and g_szOpenData <> "pageEMPTY" then
		szSave = g_szOpenData
		g_szOpenData = ""
	end if
	
	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
	For i = 0 to #g_tDefault-1
		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
		
		if g_tGSelect[i] == "" or g_tGSelect[i] == null then
			g_tGSelect[i] = "1"
		end if
		
		if g_tKey[i] == g_tKey[0] then
			g_tGSelect[i] = g_szRecent
		elseif g_tKey[i] ==  g_tKey[1] then
			g_tGSelect[i] = g_szHold
		end if 
		
		' 해당그룹 Show시
		if g_tGSelect[i] == "1" then		
			if i == 0 then
				szgrpList = g_tKey[i] & "`" & g_tNm[i]			
				nIdx = 0
			else
				if szgrpList == "" then
					szgrpList = g_tKey[i] & "`" & g_tNm[i]
				else
					szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
				end if
				
				if nIdx >= 0 then
					nIdx = nIdx + 1
				else
					nIdx = 0
				end if			
			end if
			
			if szSave == g_tKey[i] then
				nSelect = nIdx
			end if

			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		end if
	NEXT
	
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------
	
	fmTab.visible = false
	
	nCheck = Cint(g_szRecent) + Cint(g_szHold)
	if nCheck == 0 then
		fmTab.deletepage =  g_tPage[0] '"page009370" '최근종목
		fmTab.deletepage = g_tPage[1] ' "page001471" '보유종목
	elseif nCheck == 1 then
		if g_szRecent == "1" then '최근종목
			fmTab.insertPage( 0, g_tPage[0], g_tPage[0], "empty", "1", g_tNm[0])
		elseif g_szHold == "1" then '보유종목
			fmTab.insertPage( 0, g_tPage[1], g_tPage[1], "empty", "1", g_tNm[1])
		end if 
	else'if nCheck == 2
		fmTab.insertPage( 0, g_tPage[0], g_tPage[0], "empty", "1", g_tNm[0])
		fmTab.insertPage( 1, g_tPage[1], g_tPage[1], "empty", "1", g_tNm[1])	
	end if 

	if Int(nRow) > 0 then
		g_szAppFirst = "NO"
		
		For i = 0 to nRow -1
			szKey = Trim(grdGroup.GetCellData("bd_code", i))
			szNm  = Trim(grdGroup.GetCellData("bd_name", i))

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if

			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
			
			if CInt(fmTab.tabcount) == 0 then
				fmTab.insertPage( fmTab.tabcount, "page"& szKey, "page"& szKey, "empty", "1", szNm)
			else	
				'동적으로 관심그룹 폼탭구성(등록된 관심그룹이 있는 경우)
			     '그룹명변경
				if szNm == Trim(fmTab.GetTabPageCaption("page"& szKey)) then					
					fmTab.SetTabPageCaption("page"& szKey, szNm)
				else
				 '그룹명추가			     
					fmTab.insertPage( fmTab.tabcount, "page"& szKey, "page"& szKey, "empty", "1", szNm)
				end if 
			end if 
		Next
	else	
		g_szAppFirst = "YES"
		if (Trim(fmTab.GetTabPageCaption("pageEMPTY")) <>"관심그룹") then
			fmTab.insertPage( fmTab.tabcount, "pageEMPTY", "pageEMPTY", "empty", "1", "관심그룹")
		end if 
		if szgrpList == "" then
			szgrpList = "EMPTY" & "`" & "관심그룹"
		else
			szgrpList = szgrpList & "\r\n" & "EMPTY" & "`" & "관심그룹"
		end if
	end if

	if g_szDeviceOS == "2" then '아이폰 20230714 insertPage 시, 속도 느린 현상 조치
		fmTab.setTabHeaderImage("tab_03_o.9", "tab_03_n.9", 0.1)
     end if
	
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	'초기값 셋팅
	If CStr(nSelect) == "-1" Then
		nSelect = 0 
	End If

	'등록된 관심그룹이 없는 경우 
	if Int(nRow) == 0 then
		if szSave == "" or szSave == "EMPTY" then '최종 저장된 그룹이 없을 경우 
			'최근종목 & 보유종목
			nSelect = Cint(g_szRecent) + Cint(g_szHold)
		end if 
	end if 

	if g_szOpenData == "pageEMPTY" then
		fmTab.currenttabpageid = g_szOpenData
		g_szOpenData = ""
		if g_szDeviceOS == "2" then 'iOS일 경우
			fmTab.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)
		end if 
	else
		cmbGroup.currentindex = CStr(nSelect)
		
		if g_szDeviceOS == "2" then		'iOS
			fmTab.currenttab = cmbGroup.currentindex	
			fmTab.SetUseAnimation("1")
		else		'안드 - currenttab 후 animation 켜기
			fmTab.currenttab = "0"
			fmTab.currenttab = CStr(nSelect)
			
			fmTab.SetUseAnimation(true)
		end if
	end if
	
	fmTab.visible = true
	
	g_szgrpList = szgrpList
	Form.triggerEvent("linkfm0", "GW_COUNT", grdGroup.rowcount) '관심그룹수를 서브화면에 보냄.
	
End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	Form.SaveConfigData("GWANSIM", "GROUP", "")
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

'============================================================================
' Control_FmTab_Swipe : 폼탭의 좌우스크롤 제어
'============================================================================
Function Control_FmTab_Swipe()
	' 좌우 스크롤시 관심그룹 변경 설정
	' 최초설정은 좌우스트롤 가능하도록 변경 -> 요청사항
	if Form.GetEnvData("GW_SWIPE") == "0" then
		fmTab.usepg = "0"
		linkfm0.gesture = false
	else
		fmTab.usepg = "1"
		linkfm0.gesture = true
	end if
End Function

'============================================================================
' Change_Style : 오른쪽 상단 편집과 차트 버튼부분
'============================================================================
Function Change_Style(szStyle)
	'스타일10(두줄), 스타일11(한줄)
	
	if szStyle == "SET_STYLE1" or szStyle == "SET_STYLE2" or szStyle == "SET_STYLE4" or szStyle == "SET_STYLE10" or szStyle == "SET_STYLE11" then '	20211115 HSZ START : 스타일4 추가 
		
		'20211019 아이티젠(김성수) 관심종목 개선 START
		btnToggle.visible = true
		imgToggle.visible = true
		
		'최근조회, 보유종목 예외처리 ////////////////////////////////////
		szKey = cmbGroup.cbkeydata
		f_SetPrcType(g_szRSelect)		
		
		rdoChart.visible = false
		imgWeek.visible  = false
		imgMin.visible   = false
		imgTick.visible  = false
		
		'20240524_01 KBC START : 해외주식 고도화
		btnToggleDayTime.visible = true
		imgToggleDayTime.visible = true
		imgFlag.visible  = true
		'20240524_01 KBC END		
	
	elseif szStyle == "SET_STYLE3" or szStyle == "SET_STYLE12" then '스타일12(차트)
		
		btnToggle.visible = false
		imgToggle.visible = false	
		
		rdoChart.visible = true
		imgWeek.visible  = true
		imgMin.visible   = true
		imgTick.visible  = true
		
		'20240524_01 KBC START : 해외주식 고도화
		btnToggleDayTime.visible = true
		imgToggleDayTime.visible = true
		imgFlag.visible  = true
		'20240524_01 KBC END			
	else
		
		btnToggle.visible = false
		imgToggle.visible = false		

		rdoChart.visible = false
		imgWeek.visible  = false
		imgMin.visible   = false
		imgTick.visible  = false
		
		'20240524_01 KBC START : 해외주식 고도화
		btnToggleDayTime.visible = false
		imgToggleDayTime.visible = false
		imgFlag.visible  = false
		'20240524_01 KBC END
	end if
	
End Function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
Function PeriodSet(sPeriodType)
	if sPeriodType= "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	elseif sPeriodType= "A" then
	   g_sPeriod = CInt(g_szMinType) * 60
	   g_sPeriodType = "1"
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	    g_sPeriod ="1"
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	    g_sPeriod ="1"
	end if
	
	sPeriod = CInt( g_sPeriod)	
	if Len( sPeriod )= 1 then
		g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
		g_sPeriod = "0"..g_sPeriod
	end if

	if sPeriodType= "T" then
		Form.triggerEvent("linkfm0", "SET_CHART", g_sPeriodType & "★" & g_sPeriod & "★" & g_szChrtType & "★" & g_szTicType)
	elseif sPeriodType= "A" then
		Form.triggerEvent("linkfm0", "SET_CHART", g_sPeriodType & "★" & g_sPeriod & "★" & g_szChrtType & "★" & g_szMinType)
	else
		Form.triggerEvent("linkfm0", "SET_CHART", g_sPeriodType & "★" & g_sPeriod & "★" & g_szChrtType & "★")
	end if
End Function


'============================================================================
'그룹추가, 종목추가,편집, SNS공유 버튼의  보임처리
'============================================================================
Function SetVisibleButton()
     ' 1.선택된 탭이 최근조회/보유종목이 아니고 등록된 관심그룹이 없는경우 
     '	그룹추가 버튼 활성화하고 종목추가/편집/공유 버튼 비활성화
     ' 2.선택된 탭이 등록된 관심그룹 탭인 경우 
     '   종목추가/편집/공유 버튼 활성화하고 그룹추가 비활성화.
	'lblGroupNm.caption = Trim(fmTab.GetTabPageCaption(fmTab.currenttabpageid)) ' 선택된 그룹명	
	imgNotice.visible = false
	lbNoticeMsg.visible = false
	imgNotice.left = 572
	lbNoticeMsg.left = 487 
	
	'최근조회, 보유종목, CFD보유종목	
	
	if fmTab.currenttabpageid == g_tPage[0] or fmTab.currenttabpageid == g_tPage[1] then	'최근조회/보유종목 탭일 경우 
		btnAddgroup.visible = false
		btnAddItem.visible = false
		btnEditItem.visible = false
		btnShareItem.visible = false
		imgAddgroup.visible = false
		imgAddItem.visible = false
		imgEditItem.visible = false
		imgShareItem.visible = false
		
	else	
		if CInt(grdGroup.rowcount) > 0 then '탭명이 "관심그룹"일 경우"
			btnAddgroup.visible = false
			btnAddItem.visible = true
			btnEditItem.visible = true
			btnShareItem.visible = true		
			imgAddgroup.visible = false
			imgAddItem.visible = true
			imgEditItem.visible = true
			imgShareItem.visible = true				
		else
			btnAddgroup.visible = true			
			btnAddItem.visible = false
			btnEditItem.visible = false
			btnShareItem.visible = false
			imgAddgroup.visible = true
			imgAddItem.visible = false
			imgEditItem.visible = false
			imgShareItem.visible = false					
		
		end if
	end if
	
	'20230810 KKM START : 관심동기화 사용여부에 따른 분기처리
	If g_szCloud == "0"  then
		'차트일 경우 종목추가,편집,공유 안보이게 수정
		szStyle = Form.GetEnvData("GW_STYLE") '
		if szStyle == "SET_STYLE12" or imgStyle.imgpath == g_tStyleImgNm(2) then		
			btnAddItem.visible = false
			btnEditItem.visible = false
			btnShareItem.visible = false		
			imgAddItem.visible = false
			imgEditItem.visible = false
			imgShareItem.visible = false
		end if 
	end if
	'20230810 KKM END	
	
end Function


'============================================================================
' f_SetPrcType : 토글버튼 이벤트 및 이미지 적용
'============================================================================
Function f_SetPrcType(nType)
	Dim nParam
	nParam = CInt(nType)
	
	g_szRSelect = CStr(nParam)
	Form.SetSharedData("GW_RSELECT", g_szRSelect) '설정 저장
	
	if nParam == 0 then
		btnToggle.caption = "현재가"
		imgToggle.imgpath = "toggle_3dots_02.9.png"
		
	elseif nParam == 1 then
		btnToggle.caption = "예상가"
		imgToggle.imgpath = "toggle_3dots_03.9.png"		
		
	elseif nParam == 2 then
		btnToggle.caption = "단일가"
		imgToggle.imgpath = "toggle_3dots_04.9.png"
		
	end if
	
	if CInt(fmTab.tabcount) > 0 then
		if g_szFirst <> "0" then
			edtListCnt.caption = "" ' 종목리스트 카운트 에디트 클리어	
			Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex )
		end if 
	end if 
	
End Function

