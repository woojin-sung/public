'============================================================================
'20231026 HSZ START: fmTab0->linkfm0으로 교체(성능개선)
Sub linkfm0_OnGestureEvent(sEvent)
	Form.triggerEvent("linkfm0", "CLOSE_RIGHT", "")
	
	if sEvent == "RtoL" then
		btnNext_OnClick()
	elseif sEvent == "LtoR" then
		btnPrev_OnClick()
	end if
	
	nCmbTab = Cdbl(cmbGroup.currentindex)
	fmTab.currenttab = nCmbTab
	
End Sub
'20231026 HSZ END
