'============================================================================
' btnStyle_OnClick : 스타일 버튼 클릭 이벤트
'============================================================================
Sub btnStyle_OnClick()
	Dim sNowStyle, sChangeStyle
	sNowStyle = Form.GetEnvData("GW_STYLE")
	
	'관심종목 스타일 10,11,12 추가 1,2,3,4 삭제
	if sNowStyle == "" or sNowStyle == null then
		sNowStyle = "SET_STYLE10" '디폴트
	end if
	
	if sNowStyle == "SET_STYLE1" then
		sChangeStyle = "SET_STYLE10"		
	elseif sNowStyle == "SET_STYLE2" then
		sChangeStyle = "SET_STYLE10"

	elseif sNowStyle == "SET_STYLE3" then
		sChangeStyle = "SET_STYLE10" 
	'20211115 HSZ START : 스타일4 추가 
	elseif sNowStyle == "SET_STYLE4" then
		sChangeStyle = "SET_STYLE10"		
	'20211115 HSZ END
	elseif sNowStyle == "SET_STYLE10" then
		sChangeStyle = "SET_STYLE11"
	elseif sNowStyle == "SET_STYLE11" then
		sChangeStyle = "SET_STYLE12"
	elseif sNowStyle == "SET_STYLE12" then
		sChangeStyle = "SET_STYLE10"
	end if
	
	Form.SetEnvData("1", "GW_STYLE", sChangeStyle)
	
	if CInt(fmTab.tabcount) > 0  then	
		Form.triggerEvent("linkfm0", "STYLE", sChangeStyle)
		Form.triggerEvent("linkfm0", "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption & "♥" & cbGubun.currentindex )
	end if 
	
	Call Change_Style(sChangeStyle)
	Call Change_StyleIcon(sChangeStyle)
	SetVisibleButton()  ' 20230810 KKM 관심동기화
	
End Sub

Sub imgStyle_OnClick()
	btnStyle_OnClick()
End Sub

