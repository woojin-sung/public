'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_prcs_id 		'승인프로세스ID
Dim g_aplt_date		'승인신청일자
Dim g_aplt_no			'승인신청번호
Dim g_aplt_no_temp	'승인신청번호_임시
Dim g_empno			'승인직원번호
Dim g_dpnm			'신청부서명
Dim g_name			'승인신청자명
Dim g_aprv_name		'승인자명
Dim g_prcs_name 		'승인신청업무명
Dim g_titl_cntt 		'승인신청제목
Dim g_aprv_aplt_expl	'승인신청설명
Dim g_flag			'승인/반려 플래그
'---------------------------	INIT			-------------------------------
	
	g_flag = 0
	
'----------------------------------------------------------------------------

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
