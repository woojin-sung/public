'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	
	g_szID 			= Form.GetSharedData("&USER_ID", false )	
	g_prcs_id 		= Form.GetSharedData("aprv_prcs_id", true )
	g_aplt_date		= Form.GetSharedData("aprt_aplt_date", true )
	g_aplt_no 		= Form.GetSharedData("aprv_aplt_no", true )
	g_aplt_no_temp	= Right(g_aplt_no,5)
	g_empno 			= Form.GetSharedData("aprv_empno", true )
	g_dpnm 			= Form.GetSharedData("aprv_dpnm", true )
	g_name 			= Form.GetSharedData("empl_name", true )
	g_prcs_name 		= Form.GetSharedData("aprv_prcs_name", true )	
	g_titl_cntt 		= Form.GetSharedData("aprv_aplt_titl_cntt", true )	
	g_aprv_aplt_expl 	= Form.GetSharedData("aprv_aplt_expl", true )	
	g_aprv_name 		= Form.GetSharedData("", false )
		
	
End Sub


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	Label3.caption 			= g_aplt_date
	Label4.caption 			= Cint(g_aplt_no_temp)
	Label8.caption 			= g_prcs_name
	Label10.caption 			= g_titl_cntt
	Label12.caption 			= g_dpnm
	Label15.caption 			= g_name
	Container0.Label5.caption 	= g_aprv_aplt_expl
	
	
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	Form.CloseForm()

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
	
	g_flag= 3
	Form.CloseForm()
End Sub


'============================================================================
'Button0_OnClick
'============================================================================
Sub Button0_OnClick() '승인
	g_flag = 1
	
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_PRCS_ID", 	0 , g_prcs_id)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_APLT_DATE", 	0 , g_aplt_date)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_APLT_NO", 	0 , g_aplt_no)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_EMPNO", 		0 , g_empno)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_CLS_CODE", 	0 , "01")
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "RMRK_CNTT", 		0 , "승인 완료 (MTS / 모바일 통합승인)")
		
	DATAMANAGER.RequestTranData("obcpp_aprv_060a")
	
	Form.Toast(0, "승인이 진행 중 입니다. 잠시 기다려주세요.", 400)
	
	
End Sub


'============================================================================
'Button1_OnClick
'============================================================================
Sub Button1_OnClick() '반려
	g_flag = 2
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_PRCS_ID", 	0 , g_prcs_id)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_APLT_DATE", 	0 , g_aplt_date)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_APLT_NO", 	0 , g_aplt_no)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_EMPNO", 		0 , g_empno)
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "APRV_CLS_CODE", 	0 , "03")
	DATAMANAGER.SetDataValue(0,"obcpp_aprv_060a", "InBlock1", "RMRK_CNTT", 		0 ,  "승인 반려 (MTS / 모바일 통합승인)")
	
	DATAMANAGER.RequestTranData("obcpp_aprv_060a")	
	
	Form.Toast(0, "반려가 진행 중 입니다. 잠시 기다려주세요." ,400)
	
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	
		if	g_flag = 0 then
			
			Form.SendReturnToParent("POPUP_CLOSE" , "0")
		
		elseif g_flag = 1 then
			Form.SendReturnToParent("POPUP_CLOSE" , "1")
				
		elseif g_flag = 2 then
			
			Form.SendReturnToParent("POPUP_CLOSE" , "2")
				
		else
			Form.SendReturnToParent("POPUP_CLOSE" , "3")
		
		end if
		
End Sub


'============================================================================
'Image1_OnClick
'============================================================================
Sub Image1_OnClick()
	g_flag = 0
	Form.CloseForm()
End Sub


