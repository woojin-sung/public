'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex = 0 then
		selection_score = 1
		selection_value = 1
	elseif nIndex = 1 then
		selection_score = 2
		selection_value = 2
	elseif nIndex = 2 then
		selection_score = 3
		selection_value = 3
	else
		selection_score = 4
		selection_value = 4
	end if
	


	Form.SetSharedData("Selection_Value", selection_value)
	Form.SetSharedData("Selection_Score", selection_score)

End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	if nIndex = 0 then
		projects_score = 1
		projects_value = 1
	elseif nIndex = 1 then
		projects_score = 2
		projects_value = 2
	elseif nIndex = 2 then
		projects_score = 3
		projects_value = 3
	else
		projects_score = 4
		projects_value = 4
	end if
	

	
	Form.SetSharedData("Projects_Value", projects_value)
	Form.SetSharedData("Projects_Score", projects_score)

End Sub

