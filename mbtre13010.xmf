'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		' 종목/탭 변경시 초기화
	g_szBuyPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")		' 주식매수주문가격 자동입력
	g_szSelPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")		' 주식매도주문가격 자동입력
	g_szModPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC")		' 주식정정주문가격 자동입력
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			' 원주문번호 자동입력
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부

	' 주식매수주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 주식매도주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 주식정정주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END

End Function

'============================================================================
' 거래소 ID 시장명으로 변환
'============================================================================
Function Transform_Market(sValue)
	if sValue == "HK" then
		return "홍콩"
	elseif sValue == "CN" then
		return "중국"
	elseif sValue == "JP" then
		return "일본"
	elseif sValue == "US" then
		return "미국"
	end if
end Function

Function RequestTranData_Intr()
	DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
	DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function

'============================================================================
'[[ 폼 초기화 ]]
'============================================================================
Sub Form_OnFormInit()

	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	Form.setSearchType("26")
	f_EventPopup()
	
	Load_OrderSet()
	
	Form.requestIntrItemList("00")
	
	'============================================================================
	'외부화면 연동
	'============================================================================
	if Form.GetOpenLinkData( ) == "0" or Form.GetOpenLinkData( ) == 0	then			'매수
		FormTab0.currenttabpageid = "page0"
		
	elseif Form.GetOpenLinkData( ) == "1" or Form.GetOpenLinkData( ) == 1	then		'매도
		FormTab0.currenttabpageid = "page1"	
		
	else
		szData = Form.GetOpenLinkData()
		arrData = Split(szData, "★")

		if UBOUND(arrData) > 0 then
			temp = 0
			if arrData(0) <> "" then
				Dim arrData2
				'20220510 LES START
				szLinkCode = arrData(2)
				if CheckMasterFile(szLinkCode) then
							
				else
					Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
					Exit Sub
				end if
				'20220510 LES END 
				if arrData(0) == "잔고" then
				
					'잔고★탭순서★종목코드★수량♥매도매수구분코드
					arrData2 = Split(arrData(3), "♥")
					if UBOUND(arrData2) > 0 then
						if arrData2(0) == "0" then
							szQty = 0
						else
							szQty = Fix(arrData2(0))
						end if
						
						szMaedosuGbn = arrData2(1)
						Form.SetSharedData("JANGO" , szMaedosuGbn.."★"..szQty)
						
						szName = Form.GetItemCodeInfo(arrData(2), "name")
						Form.setOverStockItemCode(arrData(2).."★"..szName)
					end if
				elseif arrData(0) == "미체결" then
					'미체결★탭순서★종목코드★주문번호♥미체결수량♥주문유형♥주문가♥""♥매매구분♥신규청산구분명
					arrData2 = Split(arrData(3), "♥")
					if UBOUND(arrData2) > 0 then
						szOrgNo = arrData2(0)
						szQty = Fix(arrData2(1))
						szOrdType = arrData2(2)
						szOrdPrc = arrData2(3)
						szMaedosuGbn = arrData2(5)
						szGbn = arrData2(6)
						
						Form.SetSharedData("MICHE" , szOrgNo.."★"..szQty.."★"..szOrdType.."★"..szOrdPrc.."★"..szMaedosuGbn.."★"..szGbn)
				
						szName = Form.GetItemCodeInfo(arrData(2), "name")
						Form.setOverStockItemCode(arrData(2).."★"..szName)
					end if
				elseif arrData(0) == "기타" then
				
					'기타★탭순서★종목코드★종목명
					Form.setOverStockItemCode(arrData(2).."★"..arrData(3))
				end if
				
				if arrData(1) == "0" then
					FormTab0.currenttabpageid = "page0"
					
				elseif arrData(1) == "1" then
					FormTab0.currenttabpageid = "page1"
					
				elseif arrData(1) == "2" then
					FormTab0.currenttabpageid = "page3"
					
				elseif arrData(1) == "3" then
					FormTab0.currenttabpageid = "page2"
				end if
			end if
		end if
	end if
	
	
	'============================================================================
	'종목코드 초기화
	'============================================================================
	ItemCode0.code = Form.GetSharedData("&ITEM_CODE", false)
	if Len(ItemCode0.code) > 0 then
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "InitCode", ItemCode0.code )
		Form.triggerEvent( "LinkForm2", "RequestData", ItemCode0.code)
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
		DATAMANAGER.RequestTranData("ohhts_6000_002r")
	end if
	
	'============================================================================
	'해외시세 이용신청 검증 -> 계좌변경 이벤트
	'============================================================================
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    DATAMANAGER.RequestTranData("obtre_acnt_001r")
    else
	    Form.SetTimerEvent("1", 1, 1)
    end if
	
	'20220823 SWJ START : 일반계좌인 경우 증거금율 표시
    Form.triggerEvent("LinkForm2", "16200_cfdmgrt", acnt.total & "@" & acnt.sequence & "@" & FormTab0.currenttab )	'20230821 SWJ START : 현재 탭 추가
    '20220823 SWJ END
	'20230809 htw start
    DATAMANAGER.RequestTranData( "obtre_comm_004r" )
    '20230809 htw end
    
    RequestTranData_Intr()
end Sub

