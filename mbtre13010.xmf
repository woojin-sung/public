'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "ITEMINFO_POP_CLOSE" then
		Image0.visible = true
	
	' 해외CFD 종목검색 화면 리턴
	elseif sKeyName == "MBTRE10000_ITEMCODE" then
		edtOrgNo.caption = ""
		'20220510 LES START
		arrLinkCode = Split(sRet,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		Form.setOverStockItemCode(sRet)
		'ItemCode0_OnEditComplete(sRet)
		
	elseif sKeyName == "SISECHECK2" then
		if sRet == "N" then
			DATAMANAGER.RequestTranData("obcsb_acif_077r")
		elseif sRet == "Y-1" then
'			Form.OpenScreen("16090" , "")
			Form.OpenScreen("16095" , "")	'20231226 HSZ: 해외CFD용 시세신청화면 추가
		elseif sRet == "Y-2" then
			DATAMANAGER.SetDataValue( 0, "obtre_acnt_001a", "InBlock1", "ACNO" 					 , 0, acnt.total )	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "ASNO" 				    	 , 0, acnt.sequence )	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "QTTN_APLT_CLCD" 			 , 0, g_qttn_aplt_clcd)	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0, g_mrkt_code)	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "PROS_CLS_CODE1" 			 , 0, g_pros_cls_code1)	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "PROS_CLS_CODE2" 			 , 0, g_pros_cls_code2)	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "PROS_CLS_CODE3" 			 , 0, g_pros_cls_code3)	
			DATAMANAGER.SetDataValue( 0,"obtre_acnt_001a", "InBlock1", "PROS_CLS_CODE4" 			 , 0, g_pros_cls_code4)	
			DATAMANAGER.RequestTranData("obtre_acnt_001a")   
		end if
		
	'20230809 SWJ START : 동의 화면으로 이동
	elseif sKeyName == "HEDGE_AGREECHECK" then
		if sRet == "Y" then
			Form.OpenScreen("88080" , "")
		
		'20240724 SWJ START
		else
			if g_sAGRM_YN <> "Y" then
				Form.OpenPopup("mbtre13000_p10" , "2" , "")
			end if
		'20240724 SWJ END
		
		end if 
	
	'20240724 SWJ START
	elseif sKeyName == "ImposeTaxCheck" then
		if sRet == "Y" then
			Form.OpenScreen("31004" , "")
		end if
	'20240123 SWJ END
	
	elseif sKeyName == "AGREECHECK" then
		if sRet == "Y" then
			Form.OpenScreen("81040" , "")
		
		'20240724 SWJ START
		else
			if g_sAGRM_YN <> "Y" then
				Form.OpenPopup("mbtre13000_p10" , "2" , "")
			end if
		'20240724 SWJ END
		
		end if 
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
	
	elseif sKeyName = "mhprc11000_save" then '관심등록 완료 후
		
		arrRet = split(sRet, "★")
		
		if arrRet(2) = "DEL" then
			Form.delIntrItemList(ItemCode0.code)
			Form.SetInterestTitle("N")
		else
			Form.addIntrItemList(ItemCode0.code)
			RequestTranData_Intr()
			Form.SetInterestTitle("Y")
		end if
	end if
End Sub

