'============================================================================
'계좌변경 이벤트 발생(타이밍 1초)
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 1 then
		Form.SetTimerEvent("1", 0, 1)
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
	end if
End Sub


'============================================================================
'[[ 폼 리프레시 ]]
'============================================================================
Sub Form_OnRefresh()
	ItemCode0_OnEditComplete(ItemCode0.code)
end Sub
 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'============================================================================
	'폼 리프레시
	'============================================================================
	if sEventName == "SCREEN_REFRESH" then
		ItemCode0_OnEditComplete(ItemCode0.code)
	
	'============================================================================
	'관심종목 추가(우측상단) - 해외주식 공유
	'============================================================================
	elseif sEventName == "REG_INTR" then 
		'Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code , "" )
		isIntrItem = Form.isIntrItemList(ItemCode0.code)
	
		if isIntrItem = true then
			Form.OpenPopup("mhprc11000_pe", ItemCode0.code& "★"& "DEL","", "")
		else
			if CInt(g_szIntrGrpCnt) < 1 then
				g_szAction = "GROUP_ADD2"			
				Form.OpenPopup("mhprc11000_pf", g_szAction & "★" & ItemCode0.code & "★", "")
			else
				Form.OpenPopupAnimation("mhprc11000_pd", ItemCode0.code& "★"& "ADD","", "2")	'종목등록
			end if
		end if
		
	'============================================================================
	'연결메뉴(우측상단) - 해외주식 공유
	'============================================================================
	elseif sEventName = "SCREEN_MENU" then						
		
		if sParam = "REG_INTR" Then									' 관심종목등록
			'Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code , "" )
			
			isIntrItem = Form.isIntrItemList(ItemCode0.code)
	
			if isIntrItem = true then
				Form.OpenPopup("mhprc11000_pe", ItemCode0.code& "★"& "DEL","", "")
			else
				if CInt(g_szIntrGrpCnt) < 1 then
					g_szAction = "GROUP_ADD2"			
					Form.OpenPopup("mhprc11000_pf", g_szAction & "★" & ItemCode0.code & "★", "")
				else
					Form.OpenPopupAnimation("mhprc11000_pd", ItemCode0.code& "★"& "ADD","", "2")	'종목등록
				end if
			end if

		elseif sParam = "SET_SCREEN" Then							' 화면설정
			Form.OpenScreen("90000" , "1")

		end if
	
	'============================================================================
	' 상단바 클릭 시
	'============================================================================
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	elseif sEventName == "TITLE_CLICK" then
		Form.OpenCommonDialog("SEARCH", "26", "")
	'20220922 SWJ END
	
	'============================================================================
	'차입잔고 연동(매도)
	'============================================================================
	elseif sEventName == "13000_BORROW" then
		'20220510 LES START
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		Form.setOverStockItemCode(sParam)

	'============================================================================
	'잔고 연동(청산)
	'============================================================================
	elseif sEventName == "13000_BALANCE" then
		'20220510 LES START
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		Form.setOverStockItemCode(sParam)
		
	'============================================================================
	'체결/미체결 연동(전체)
	'============================================================================
	elseif sEventName == "13000_CONTRACT" then
		'20220510 LES START
		arrLinkCode = Split(sParam,"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			Exit Sub
		end if
		'20220510 LES END 
		Form.setOverStockItemCode(sParam)
		
	elseif sEventName = "REFRESH_INTR_ITEM" then
		
		isIntrItem = Form.isIntrItemList(ItemCode0.code)
		if isIntrItem == true then
			Form.SetInterestTitle("Y")
		else
			Form.SetInterestTitle("N")
		end if
	end if
	
end Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if "&ITEM_CODE" == sKey then
		edtOrgNo.caption = ""
		ItemCode0_OnEditComplete(sValue)
	end if
End Sub

'============================================================================
'종목코드 변경
'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	'20220526 SWJ START : 종목코드 다시 세팅
	ItemCode0.code = sCode
	'20220526 SWJ END
	
	Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeCode", ItemCode0.code )
	Form.triggerEvent( "LinkForm2", "RequestData", ItemCode0.code)
End Sub

'============================================================================
'주문탭 변경
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if Len(ItemCode0.code) > 0 then
		'============================================================================
		'원주문번호 연동(정정/취소탭)
		'============================================================================
		if nCurrentTab = 3 then
			if g_szAfterOrg == "1" then		'주문연동시
				if edtOrgNo.caption <> "" then
					Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption) '주문번호 연동
				end if
			end if
		end if
			
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeTab", ItemCode0.code )	
		Form.triggerEvent("LinkForm2", "16200_cfdmgrt", acnt.total & "@" & acnt.sequence & "@" & FormTab0.currenttab )	'20230821 SWJ START : 현재 탭 추가
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_002r" then

		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( ItemCode0.code, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1])
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0])
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay)
		
	elseif szTranID == "obtre_acnt_001r" then
		
		DATAMANAGER.SetDataValue( 0, "obtre_acnt_001r", "InBlock1", "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, "obtre_acnt_001r", "InBlock1", "ASNO" , 0 , acnt.sequence )
		
	elseif szTranID == "obcsb_acif_077r" then	
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_077r", "InBlock1", "ACNO" , 0 , acnt.total )

		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obcsb_acif_077r", "InBlock1", "ACNT_PWD"		, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, "obcsb_acif_077r", "InBlock1", "ACNT_PWD"		, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
	elseif szTranID == "obtre_comm_004r" then	
		DATAMANAGER.SetDataValue( 0, "obtre_comm_004r", "InBlock1", "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, "obtre_comm_004r", "InBlock1", "ASNO" , 0 , acnt.sequence )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_acnt_001r" then
		g_pros_cls_code  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0 )
		g_mrkt_code    = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 )
		g_qttn_aplt_clcd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "QTTN_APLT_CLCD", 0 )
		g_pros_cls_code1 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE1", 0 )
		g_pros_cls_code2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE2", 0 )
		g_pros_cls_code3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE3", 0 )
		g_pros_cls_code4 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE4", 0 )
		'g_mrkt_name    = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MRKT_NAME"	 , 0 )
		
		select case g_mrkt_code
			case "01"
				g_mrkt_name = "미국"
			case "02"
				g_mrkt_name = "홍콩"
			case "03", "04"
				g_mrkt_name = "중국"
			case "05"
				g_mrkt_name = "일본"
		end select
		
		Container0.Label10.caption = g_mrkt_name
		
		Form.triggerEvent("LinkForm1", "CFD_AbroadMarket", g_mrkt_name )	'20230921 SWJ START
		
		'pros_cls_code
		' 0 : 아무처리 안한다.   
		' 1 : 1-2팝업화면 open
		' 2 : 팝업화면 open 
		if g_pros_cls_code = "1" then
		
			'20230921 SWJ START
			'Container0.visible = true
			 LinkForm1.left = 0
			 LinkForm1.visible = True
			 '20230921 SWJ END
			 
			'DATAMANAGER.RequestTranData("obcsb_acif_077r")
		
		'20230809 SWJ START : 삭제
'		elseif g_pros_cls_code = "2" then
'			Container0.visible = false
'			Form.OpenPopup("mbtre13000_p9" , "2"&"@"&g_mrkt_name, "")
		'20230809 SWJ END
		
		else
			Container0.visible = false
			
			'20230921 SWJ START
			 LinkForm1.visible = False
			 '20230921 SWJ END
			 
			'DATAMANAGER.RequestTranData("obcsb_acif_077r")
		end if
		
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
		
	elseif szTranID == "obtre_acnt_001a" then
		'DATAMANAGER.RequestTranData("obcsb_acif_077r")
		
	elseif szTranID == "obcsb_acif_077r" then
		szAgrmRfusClcd = DATAMANAGER.GetDataValue(0, "obcsb_acif_077r", "OutBlock1", "AGRM_RFUS_CLCD" , 0)
		szAgrmValdYN   = DATAMANAGER.GetDataValue(0, "obcsb_acif_077r", "OutBlock1", "AGRM_VALD_YN" , 0) 
		g_sAGRM_YN     = DATAMANAGER.GetDataValue(0, "obcsb_acif_077r", "OutBlock1", "AGRM_YN" , 0) 		'20240724 SWJ START: CFD 과세정보 제공동의 여부
		
		if szAgrmRfusClcd ~= "2" and (szAgrmValdYN == "Y" or szAgrmValdYN == "X" ) then	'20230821 SWJ START: 헷지수수료 관련 X 추가
			'거래가능
		'20230809 htw start
			if g_szAcnoAB == "B" and g_szPopupYn == "Y" then
				Form.OpenPopup("mbtre13000_p10" , "3", "")	'20240724 SWJ START: 헷지수수료 맵파일 변경(13000_p12 -> 13000_p10)
			
			'20240724 SWJ START
			else
				if g_sAGRM_YN <> "Y" then
					Form.OpenPopup("mbtre13000_p10" , "2" , "")
				end if
			'20240724 SWJ END
			
			end if
		else
			Form.OpenPopup("mbtre13000_p10" , "", "")
		end if
	elseif szTranID == "obtre_comm_004r" then	
		g_szAcnoAB = DATAMANAGER.GetDataValue( 0, "obtre_comm_004r", "OutBlock1", "CFD_MARG_GRAD_CODE" , 0 ) 	'A:일반, B:안심
		g_szPopupYn	= DATAMANAGER.GetDataValue( 0, "obtre_comm_004r", "OutBlock1", "PPP_YN" , 0 ) 	'팝업여부
		g_szCTCD 	= DATAMANAGER.GetDataValue( 0, "obtre_comm_004r", "OutBlock1", "CTCD" , 0 ) 		'국가코드 	'20231130 HSZ 추가
		
		DATAMANAGER.RequestTranData("obcsb_acif_077r")
		
		'일반/안심계좌 여부 판단
		Form.SetSharedData("CFD_IlbanAnsim",g_szAcnoAB)	'20230809 htw end
		Form.SetSharedData("CFD_ctcd",g_szCTCD)			'20231130 HSZ 추가
		
	elseif szTranID == "ohhts_intr_006r" then
		ResponseTranData_Intr()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtre_acnt_001r" then
		exit sub
	end if
	
	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
	if szTranID == "obtre_comm_004r" then
		szAcnt = acnt.caption
		if Trim(szAcnt) = "" then
			exit sub
		end if
	end if
	'20231123 HSZ END
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
	end if
End Sub

'============================================================================
'계좌변호 변경 -> 해외주식 시세신청 검증
'============================================================================
Sub acnt_ChangeAccount()
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwd.caption = ""
		edtPwdIcon.imgpath = "icon_save_password_n.9"
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    DATAMANAGER.RequestTranData("obtre_acnt_001r")
    else
	    Form.SetTimerEvent("1", 1, 1)
    end if
    
    '20220823 SWJ START : 일반계좌인 경우 증거금율 표시
    Form.triggerEvent("LinkForm2", "16200_cfdmgrt", acnt.total & "@" & acnt.sequence & "@" & FormTab0.currenttab )	'20230821 SWJ START : 현재 탭 추가
    '20220823 SWJ END
    '20230809 htw start
    g_szAcnoAB = ""
    g_szPopupYn = ""
    DATAMANAGER.RequestTranData( "obtre_comm_004r" )
    '20230809 htw end
End Sub

