	<SCRIPT_INFO _len="30204" _ulen="26730" >
'============================================================================
' 01.화면명 	: 온라인계좌개설
' 02.화면설명	: 온라인계좌개설_ISA계좌개설
' 03.작성	: 2016.04.18
' 04. 세팅하는 SHARED DATA 
'	SetSharedData("ONLINE066_BRCD" , g_szManBranch)
'	SetSharedData("ONLINE000_RCNO" , g_szRCNO)
'	SetSharedData("ONLINE000_CSNO" , g_szCSNO)
'	SetSharedData("ONLINE000_EXPT ", g_szExceptYN )
'	SetSharedData("ONLINE_ACNT",	g_szAccNo)
'	SetSharedData("ONLINE_PSWD",	g_szPassword)
'============================================================================
' [Modyfy]
' 2016.06.17 : 정민영 : "예금자보호 안내문" 추가 v0001
' 2020.09.16 : 권오상 : v002 : T2008250015 : 메모리평문 취약점 수정
' 2020.11.10 : 정민영 : v002 보완
' 2020.11.13 : 정민영 : v003 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_nice_010r,obcsb_efif_021r,obcsb_acif_000r IO 변경분 반영
' 2021.05.26 : 김수진 : 개인신용정보동의 공통팝업처리
' 2022.03.10 : 김수진 : 예금자 보호 제도 변경 > ISA 예금자 보호 안내문 변경
' 2022.03.18 : 김수진 : v006 : obaci_acct_089r 은행연합회 체크 로직 추가 금융소득종합과세대상자여부 체크
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim 	g_szPassword 
dim	g_szAccNo 
dim	g_szCurrentTime 	'현재시간
dim	g_szToday			'오늘날짜
dim	g_szManBranch		'관리지점코드		from obacp_opop_066r(공유)
dim 	g_szRCNO			'실명확인번호		from obcsb_acif_000r(공유)
dim	g_szRCNO_TYPE		'실명확인번호유형	from obcsb_acif_000r
dim	g_szCSNO			'고객번호			from obcsb_acif_000r(공유)
dim 	g_szExceptYN		'금융상품전용		(공유)
dim 	g_nSendCnt			'전송횟수
dim	G_PERSONAL_AGREE_FILE	'개인신용정보동의
dim	g_szAlertTitle	'알림타이틀
dim	g_szSDRC_SRNO		'송수신일련번호 obcsb_nice_010r용
Dim	g_szKYC_DRVT_PROS_YN 			'2016-04-18 ESKIM KYC파생처리여부 추가
Dim	g_PlainRm 'v002

g_szAlertTitle	=	"알림"
g_szSDRC_SRNO		=""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_nSendCnt	=	0
	
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002
	g_szToday = Form.GetSharedData("&HOST_DATE", 0)
	g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)
	G_PERSONAL_AGREE_FILE = "mbonl81020"
	cont01.edtPwd01.caption	=	""
	
	g_szAccNo = cont01.acnt01.total
'	g_szPassword	=	cont01.edtPwd01.caption 'v002

	'v002
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPassword	=	cont01.edtPwd01.caption
	Else
		g_szPassword	=	Form.GetEncData(cont01.edtPwd01.caption)
	End If

	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)
	Form.SetSharedData("ONLINE_PSWD",	g_szPassword)
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'기개설된 ISA 계좌가 존재합니다 확인시 이전 페이지로 이동
	If sKeyName == "Close" then
		Form.triggerEvent("#", "OPENACC_MAIN", "0")
	End If
	
	'v006
	if sKeyName = "ReTryPrcd2" Then
	    If sRet = "ok" Then
		    DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
	    End if
    End if
End Sub

'============================================================================
'acnt01_ChangeAccount
'============================================================================
Sub cont01_acnt01_ChangeAccount()
	g_szAccNo = cont01.acnt01.total
	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)
End Sub


'============================================================================
'edtPwd01_OnEditComplete
'============================================================================
Sub cont01_edtPwd01_OnEditComplete()
	'ISA 계좌가 이미 있는지 체크
	DATAMANAGER.RequestTranData("obcsb_acif_000r_1")
	
'	g_szPassword = cont01.edtPwd01.caption 'v002
	'v002
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPassword	=	cont01.edtPwd01.caption
	Else
		g_szPassword	=	Form.GetEncData(cont01.edtPwd01.caption)
	End If

	Form.SetSharedData("ONLINE_PSWD",	g_szPassword)
End Sub


'============================================================================
'btnInvesTyp01_OnClick
'============================================================================
Sub cont01_btnInvesTyp01_OnClick()
	Dim tmpPwd
	'DATAMANAGER.RequestTranData("obcsb_acif_786r")
	g_szKYC_DRVT_PROS_YN = ""
'	g_szPassword = cont01.edtPwd01.caption 'v002
	'v002
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPassword	=	cont01.edtPwd01.caption
	Else
	    g_szPassword	=	Form.GetEncData(cont01.edtPwd01.caption)
		tmpPwd	=	cont01.edtPwd01.caption
	End If

	
	if	len(trim(g_szPassword))	=	0	or	g_szPassword	=	NULL		then
		Form.ShowAlert(g_szAlertTitle, "비밀번호 확인 바랍니다.")
		Exit	Sub
	end	if
	
	if g_PlainRm == "1" then
		'Form.OpenPopup("mbonl81010_p1" , "84010★0★" & cont01.chkKspKdq01.checkstate & "★" &  g_szAccNo & "★" &g_szPassword)
		Form.OpenPopup("mbonl81010_p1" , "84010★0★" & "0" & "★" &  g_szAccNo & "★" & g_szPassword)
	else
		'mbonl81010_p1 Popup공유변수 주의!! 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘겨줘야함
		Form.OpenPopup("mbonl81010_p1" , "84010★0★" & "0" & "★" &  g_szAccNo & "★" & tmpPwd)
	end if 
End Sub


'============================================================================
'btnPrivInfo01_OnClick
'============================================================================
Sub cont01_btnPrivInfo01_OnClick()
	Dim pwdLen
	Dim tmpPwd

'	g_szPassword = cont01.edtPwd01.caption 'v002
	'v002
	If g_PlainRm == "1" Then '보안모듈 적용
		g_szPassword	= cont01.edtPwd01.caption
		pwdLen = cont01.edtPwd01.pwdlen
		if pwdLen == "" Or pwdLen == Null then
			pwdLen = 0
		end if
	Else
	     g_szPassword	=	Form.GetEncData(cont01.edtPwd01.caption)
		tmpPwd	=	cont01.edtPwd01.caption
	End If

	
	if	len(trim(g_szPassword))	=	0	or	g_szPassword	=	NULL		then
		Form.ShowAlert(g_szAlertTitle, "비밀번호 확인 바랍니다.")
		Exit	Sub
	end	if
	
	Form.OpenFramePopup("mbonl81020" , "005;" & g_szAccNo , sPosInfo)
End Sub


'============================================================================
'btnPolicy01_OnClick
'============================================================================


'============================================================================
'v0001 cont01_btnDpsrPron01_OnClick
'============================================================================
Sub cont01_btnDpsrPron01_OnClick()
	'2022.03.10 OpenData == ISA 전달
	Form.OpenFramePopup("mbonl84010_p8" , "ISA" , sPosInfo)
End Sub



'============================================================================
'btnNext01_OnClick
'============================================================================
Sub cont01_btnNext01_OnClick()
'	g_szPassword = cont01.edtPwd01.caption 'v002
		
	if	cont01.chkinvestTyp01.checkstate ="0"	then
		Form.ShowAlert(g_szAlertTitle, "투자성향 진단을 체크하지 않으셨습니다.")
		exit sub
	end	if
	
	if	cont01.chkPrivInfo01.checkstate ="0"	then
		Form.ShowAlert(g_szAlertTitle, "개인정보제공 및 활용동의를 체크하지 않으셨습니다.")
		exit sub
	end	if

	'v0001
	if	cont01.chkDpsrPron01.checkstate = "0"	then
		Form.ShowAlert(g_szAlertTitle, "예금자보호 확인을 체크하지 않으셨습니다.")
		exit	sub
	end	if
	
	if cont01.chkPrivInfo01.checkstate = "1" then
		'v006 금융소득종합과세대상자 체크 > obcpp_bsdy_017r 호출
		DATAMANAGER.RequestTranData("obaci_acct_089r")
	else
		Form.ShowAlert(g_szAlertTitle, "개인신용정보 관련 동의가 되지 않아 온라인계좌개설이 불가능합니다. 지점/HTS에서 동의 후 처리하시기 바랍니다")
	end if 
End Sub


'============================================================================
'btnPrev01_OnClick
'============================================================================
Sub cont01_btnPrev01_OnClick()
	Form.triggerEvent("#", "OPENACC_MAIN", "0")
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName="INVESTTYPE" then
		cont01.chkinvestTyp01.chksilence = "1"
	end if 
	
	if sKeyName=G_PERSONAL_AGREE_FILE	then	
		if sRet == "ok" then
			cont01.chkPrivInfo01.chksilence = "1"
		end if
	end if
	
	if sKeyName="ACCOUNTPOLICY" then
		if	sRet	=	"1"	then
			cont01.chkPolicy01.chksilence = "1"
		else
			cont01.chkPolicy01.chksilence = "0"
		end	if
	end if 
	
	'v0001
	if sKeyName="DPSRPRONOK" then
		if	sRet	=	"1"	then
			cont01.chkDpsrPron01.chksilence = "1"
		else
			cont01.chkDpsrPron01.chksilence = "0"
		end	if
	end if 
	
	if sKeyName="ETCAGREE" then
		cont01.chkAgree01.chksilence = "1"
	end if 
	
	if sKeyName="KYCCHK_RETURN"	then
		if	sRet	=	"Y"	then
			cont01.chkinvestTyp01.chksilence = "1"
			g_szKYC_DRVT_PROS_YN = Form.GetSharedData("KYC_DRVT_PROS_YN", True )	'2016-04-18 ESKIM KYC파생처리여부 추가
		end if
	end if
	
	
	if sKeyName="INVESTTYPE_OUTPUT" then
		Form.ShowAlert(g_szAlertTitle, "투자성향진단완료")
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "obcsb_acif_786r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_786r", "InBlock1", "ACNO", 0, g_szAccNo)
	
	elseif szTranID = "obcpp_bsdy_017r" then
		DATAMANAGER.SetDataValue(0, "obcpp_bsdy_017r", "InBlock1", "MANG_DATE", 0, g_szToday)
	
	elseif szTranID = "obacp_opop_066r" then
		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword)) 'v002
		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNT_PWD", 0, g_szPassword)
	
	elseif szTranID = "obacp_comm_037u" then
		DATAMANAGER.SetDataValue(0,"obacp_comm_037u", "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0,"obacp_comm_037u", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword)) 'v002
		DATAMANAGER.SetDataValue(0, "obacp_comm_037u", "InBlock1", "ACNT_PWD", 0, g_szPassword)
		
	elseif szTranID = "obcsb_acif_000r" or szTranID = "obcsb_acif_000r_1" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword)) 'v001
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, g_szPassword)
		
	elseif szTranID = "obcsb_nice_010r" then
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "BSWR_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "CRIN_IQRY_CLCD", 0, "TR01")
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "RCNO_TYPE_CODE", 0, g_szRCNO_TYPE)
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "RCNO_PIP", 0, g_szRCNO)  'v004 RCNO->RCNO_PIP
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "ACNO", 0, g_szAccNo)
	end if 
	
	If szTranID = "obcsb_efif_021r" then		'계좌정보 조회 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0,  Form.GetSharedData("&USER_ID", false )) 
	End If
	
	'v006 은합회 결과값에 따라 체크 : 금융소득종합과세대상자인지 체크
	If szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then	
		if szTranID == "obaci_acct_089r" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_PROS_CLS_CODE" , 0 , "3"			)	'업무처리구분코드
		else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_PROS_CLS_CODE" , 0 , "4"			)	'업무처리구분코드
		end if
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PRCD" 				, 0 , "133"			)	'상품코드 : 일임형 ISA 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" 		, 0 , "66"			)	'은행연합회상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_TRPR_CLS_CODE" , 0 , "0" 			)	'세금우대대상자구분
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CUST_CLS_CODE" 		, 0 , "1" 			)	'고객구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RCNO_PIP" 			, 0 , g_szRCNO		)	'고객실명확인번호PIP값
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szIsQuestDone			'투자성향진단완료 0:존재, else:신규작성해야함
		
	dim szOutWorkDate			'영업일
	dim szOutWorkTime			'영업시간
	dim szCustClsCode			'고객구분코드
	
	dim szRet037				'obacp_comm_037u 결과값
	dim szRet000				'obcsb_acif_000r 결과값
	dim szRet010				'obcsb_nice_010r 결과값
	
	
	'obcsb_acif_786r(투자성향진단정보조회)
	'obaci_acct_089r(은행연합회체크 : 금융소득종합과세대상자인지) [obaci_acct_089r~obaci_acct_089r_4]	'v006
	'obcpp_bsdy_017r(영업일조회)
	'obacp_opop_066r(관리지점코드조회)
	'obacp_comm_037u(계좌비밀번호확인) 	- PRO_CLS_CLODE = "1"이면 맞음
	'obcsb_acif_000r(고객정보단건조회) 	- CNSG_YN = "N"이면 오류   --- CUST_CLS_CODE = "1"이면 obcsb_nice_010r --> STEP2
	'obcsb_nice_010r(신용정보조회) 		- RSLT_CLS = "0" 이거나 "3"이면  --> STEP2
	
	
	'보유계좌중 ISA 계좌가 이미 있는지 체크 위해 실명번호 조회
	If szTranID = "obcsb_acif_000r_1" then
		Dim sOutput
		sOutput = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RCNO_PIP", 0)  'v004 RCNO->RCNO_PIP
		
		DATAMANAGER.SetDataValue(0,"obcsb_efif_021r", "InBlock1", "RCNO_PIP", 0, sOutput)  'v004 RCNO->RCNO_PIP
		DATAMANAGER.RequestTranData("obcsb_efif_021r")
	End If
	
	'계좌정보 조회 : 보유계좌중 ISA 계좌가 이미 있는지 체크
	If szTranID = "obcsb_efif_021r" then
		
		'다음 데이터 조회시 자동 조회
		If  DATAMANAGER.IsMoreNextData( szTranID ) == True Then 
			DATAMANAGER.RequestNextData( szTranID )
		
		Else
			For i = 0 to cont01.grd0.rowcount - 1
				sProd = cont01.grd0.GetCellData("bd_cell2", i)	'"133" = ISA
				sStat = cont01.grd0.GetCellData("bd_cell3", i)	'"3" = 폐쇄
				
				If sProd == "133" and sStat <> "3" then
					Form.MsgBox( g_szAlertTitle, "기개설된 ISA 계좌가 존재합니다.", "Close", 0 )
					'cont01.btnNext01.enable = False
					Exit For
				End If
			Next
		End if
	End If
	
	''''''''''''''''''''''''''
	'obcsb_acif_786r
	''''''''''''''''''''''''''
	if szTranID = "obcsb_acif_786r" then
		szIsQuestDone = DATAMANAGER.GetDataValue(0, "obcsb_acif_786r", "OutBlock1", "RSLT_CLS", 0)
		if szIsQuestDone = "0"	then							'존재시 
			'Form.ShowAlert("기존내역존재", szIsQuestDone)
			cont01.chkinvestTyp01.chksilence = "1"
		else
			Form.OpenFramePopup("mbonl81010" , g_szAccNo & ":" & g_szPassword, sPosInfo)		'임시세팅
		end if 
	end if


	''''''''''''''''''''''''''
	'v006 obaci_acct_089r() [obaci_acct_089r~obaci_acct_089r_4]
	'금융소득종합과세대상자인지 체크
	'PROS_CLS_CODE가 '1'이면 1초에 한번 총 5회 OutBlock1.LNKD_TLMS_MNNO를 INPUT으로 하여 다시 전송한다.
	'PROS_CLS_CODE가 '2'로 정상응답을 수신하면 재전송 중단
	'예외처리 통과 --> obcpp_bsdy_017r 조회
	''''''''''''''''''''''''''
	If szTranID == "obaci_acct_089r" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상 
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부
			If sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			End If
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
				Exit Sub			
			End If
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_1", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 10, 1, 1 )
		End If
		
	ElseIf szTranID == "obaci_acct_089r_1" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부
			If sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			End If
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전(수관)신청이 필요합니다.)", "ReTryPrcd2", 2)
				Exit Sub			
			End If
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_2", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 11, 1, 1 )
		End If
		
	ElseIf szTranID == "obaci_acct_089r_2" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부
			If sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			End If
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
				Exit Sub			
			End If
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_3", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 12, 1, 1 )
		End If	
		
	ElseIf szTranID == "obaci_acct_089r_3" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부
			If sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			End If
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
				Exit Sub			
			End If
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_4", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 13, 1, 1 )
		End If
		
	ElseIf szTranID == "obaci_acct_089r_4" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode	
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부
			If sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			End If
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
				Exit Sub			
			End If
		Else
			Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다.")
			Exit Sub
		End If
	End If

	''''''''''''''''''''''''''
	'1 영업일인지 조회
	'2 영업시간인지 조회
	'obcpp_bsdy_017r 성공시 --> obacp_opop_066r 조회후 다음스텝으로 이동
	''''''''''''''''''''''''''
	if szTranID = "obcpp_bsdy_017r" then
	
		szOutWorkDate = DATAMANAGER.GetDataValue(0, "obcpp_bsdy_017r", "OutBlock1", "MANG_DATE", 0)
		g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)

		if g_szToday = szOutWorkDate	then
			szOutWorkTime =left(g_szCurrentTime, 6)

			if	szOutWorkTime >= "080000" and 	szOutWorkTime <= "160000" then
				DATAMANAGER.RequestTranData("obacp_opop_066r")
			else
				Form.ShowAlert(g_szAlertTitle, "온라인 계좌 개설이 가능한 시간은 평일 08:00 ~ 16:00 입니다.")
			end if 
		else
			Form.ShowAlert(g_szAlertTitle, "계좌개설 가능 영업일이 아닙니다.")
		end if 
	end if
	
	
	''''''''''''''''''''''''''
	'obacp_opop_066r
	''''''''''''''''''''''''''
	if szTranID = "obacp_opop_066r" then
		g_szManBranch = "C" + DATAMANAGER.GetDataValue(0, "obacp_opop_066r", "OutBlock1", "MANG_BRCD", 0)
		Form.SetSharedData("ONLINE066_BRCD" , g_szManBranch)
		DATAMANAGER.RequestTranData("obacp_comm_037u")	
	end if 
	
		
	''''''''''''''''''''''''''
	'"obacp_comm_037u"
	''''''''''''''''''''''''''
	if szTranID = "obacp_comm_037u" then
		szRet037 = DATAMANAGER.GetDataValue(0, "obacp_comm_037u", "OutBlock1", "PROS_CLS_CODE", 0)
		
		if szRet037 = "1" then			'비밀번호 맞음
			DATAMANAGER.RequestTranData("obcsb_acif_000r")
		end if 
	end if 
	
	
	''''''''''''''''''''''''''
	'"obcsb_acif_000r"
	''''''''''''''''''''''''''
	if szTranID = "obcsb_acif_000r" then
		szRet000 = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CNSG_YN", 0)
		szCustClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_CLS_CODE", 0)
		g_szRCNO		 =  DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RCNO_PIP", 0)  'v004 RCNO->RCNO_PIP
		g_szRCNO_TYPE	 =  DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RCNO_TYPE_CODE", 0)
		g_szCSNO		 =  DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CSNO", 0)
		

		Form.SetSharedData("ONLINE000_RCNO" , g_szRCNO)
		Form.SetSharedData("ONLINE000_CSNO" , g_szCSNO)
		
		if szRet000 = "N" then			'오류발생
			Form.ShowAlert(g_szAlertTitle, "오류발생")
		else
			if szCustClsCode = "1" then
				DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE", 0, "1")		'첫조회시
				DATAMANAGER.RequestTranData("obcsb_nice_010r")	   	'신용정보조회
			else
				g_szExceptYN = cont01.chkExcept01.checkstate
				Form.SetSharedData("ONLINE000_EXPT", g_szExceptYN )
				Form.SetSharedData("KYC_DRVT_PROS_YN", g_szKYC_DRVT_PROS_YN )	'2016-04-18 ESKIM KYC파생처리여부 추가
				Form.triggerEvent("#", "OPENACC_MAIN", "6")
			end if 
		end if 
	end if 
	

	''''''''''''''''''''''''''
	'"obcsb_nice_010r"
	''''''''''''''''''''''''''
	if szTranID = "obcsb_nice_010r" then
		szRet010 = DATAMANAGER.GetDataValue(0,"obcsb_nice_010r", "OutBlock1", "RSLT_CLS", 0)
		g_szSDRC_SRNO	=	 DATAMANAGER.GetDataValue(0,"obcsb_nice_010r", "OutBlock2", "SDRC_SRNO", 0)
		'0: 전문 전송하지 않아도 되는 정상적인 경우
		'1: 전문 송신한 경우
		'2: 전문 송신 후 응답 대기중
		'3: 전문 수신 결과 정상 응답
		
		if szRet010 = "0"	or	szRet010 = "3"  then				'정상
			g_szExceptYN = cont01.chkExcept01.checkstate
			Form.SetSharedData("ONLINE000_EXPT", g_szExceptYN )
			Form.SetSharedData("KYC_DRVT_PROS_YN", g_szKYC_DRVT_PROS_YN )	'2016-04-18 ESKIM KYC파생처리여부 추가
			Form.triggerEvent("#", "OPENACC_MAIN", "6")
			Form.SetTimerEvent(84010, 0, 3)		
		elseif	szRet010	=	"1" or	szRet010= "2" then
			Form.SetTimerEvent(84010, 1, 3)		
		end if 
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'Form_OnTimerEvent
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if	trim(sTimerID)	=	"84010"	then
		if g_nSendCnt	<	7	then
			DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock2", "SDRC_SRNO", 0, g_szSDRC_SRNO)
			
			DATAMANAGER.RequestTranData("obcsb_nice_010r")
			g_nSendCnt = g_nSendCnt + 1
		else	
			Form.ShowAlert(g_szAlertTitle, "obcsb_nice_010r, TR요청시간이 초과하였습니다. 재시도 바랍니다.")
			Form.SetTimerEvent(84010, 0, 3)		
		end if
	end	if
	
	'v006 sta 은합회 결과값에 따라 체크 
    '안드로이드는 num, 아이폰은 string으로 받음
	If sTimerID == 10 or sTimerID == "10" then
		Form.SetTimerEvent( 10, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	End If
	
	If sTimerID == 11 or sTimerID == "11" then
		Form.SetTimerEvent( 11, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	End If
	
	If sTimerID == 12 or sTimerID == "12" then
		Form.SetTimerEvent( 12, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	End If
	
	If sTimerID == 13 or sTimerID == "13" then
		Form.SetTimerEvent( 13, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
	End If

End Sub


