		<LABEL name="Label1" fgcolor="095:000000000" fontsize="-1" fontstyle="01" caption="인증서비스 이용약관 확인 및 동의" ly_vert="11,5,333,32,1" />
		<WEBVIEW name="WebView1" urlpath="about:blank" ly_vert="18,42,339,126,1" />
		<LABEL name="Label3" fgcolor="095:000000000" fontsize="-1" fontstyle="01" caption="개인정보 수집 및 이용 동의" ly_vert="11,176,264,32,1" />
		<WEBVIEW name="WebView2" urlpath="about:blank" ly_vert="18,215,339,126,1" />
		<LABEL name="Label5" fgcolor="095:000000000" fontsize="-1" fontstyle="01" caption="개인정보 제3자 제공에 대한 동의" ly_vert="11,358,254,32,1" />
		<WEBVIEW name="WebView3" urlpath="about:blank" ly_vert="18,397,339,126,1" />
		<LABEL name="Label6" border="1" bordercolor="178:222222222" ly_vert="16,39,342,132,1" />
		<LABEL name="Label7" border="1" bordercolor="178:222222222" ly_vert="16,212,342,132,1" />
