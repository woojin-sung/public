	<SCRIPT_INFO _len="1660" _ulen="1508" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_발급(이용약관팝업)
' 03. 작    성 : 2020.12.11 성우진
'-------------------------------------------------------------------------------------------
'============================================================================
Sub Form_OnFormInit()

	sMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	'운영
	if sMode == "0" then
		WebView1.urlpath = "https://home.imeritz.com/comm/ctcn/signkorea01.html"
		WebView2.urlpath = "https://home.imeritz.com/comm/ctcn/signkorea02.html"
		WebView3.urlpath = "https://home.imeritz.com/comm/ctcn/signkorea03.html"
	
	'테스트
	elseif sMode == "1" then
		WebView1.urlpath = "https://testhome.imeritz.com/comm/ctcn/signkorea01.html"
		WebView2.urlpath = "https://testhome.imeritz.com/comm/ctcn/signkorea02.html"
		WebView3.urlpath = "https://testhome.imeritz.com/comm/ctcn/signkorea03.html"	
	end if
	
	
	
	
End Sub
'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub ButtonOK_OnClick()
	Form.SendReturnToParent("AllAgree","")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'팝업을 닫고 약관동의 화면으로 갔을 때 
	'모두동의 이미지가 활성화안돼서 활성화시키기 위함
	Form.SendReturnToParent("BtnEnable","")
End Sub

	</SCRIPT_INFO>
</ROOT>