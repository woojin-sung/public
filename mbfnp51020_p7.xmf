<ROOT>
	<MAP_INFO scrno="51020" scrname="펀드자동이체 서비스 안내 팝업" version="2" writer="성우진" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="ImgClose" autosize="1" imgpath="icon_close" ly_vert="340,16,20,20,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="13" outline="0000" designorder="1" ly_vert="20,60,335,260,1" >
			<COL_INFO ly_vert_width="5,330" />
			<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20,20,20,20,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="펀드자동이체 서비스는 당사 CMA계좌나 타사 입출금" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" impidxs="" />
				<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="계좌에서 매월 정해진 날에 일정금액을 출금하여 당사" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" impidxs="" />
				<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="에 보유한 펀드에 자동으로 투자하는 서비스 입니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="출금계좌와 입금계좌가 동일명의인 계좌만 신청이 가" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" impidxs="" />
				<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="능합니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,5,0,5" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="약정기간은 최소 1개월 이상이며, 서비스 신청일 기준" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,6,0,6" line="0,0" impidxs="" />
				<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="으로 익월부터 처리됩니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,7,0,7" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="신청금액은 최소 1천원 이상입니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,8,0,8" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="펀드 신규매수시 투자자 숙려제도에 해당하는 경우 자" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,9,0,9" line="0,0" impidxs="" />
				<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="동이체 신청은 가능하나 가입의사 확정 전까지 펀드의" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,10,0,10" line="0,0" impidxs="" />
				<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="매수처리는 불가합니다. 가입의사 확정은 홈페이지," fontsize="-2" impidxs="" />
				<CELL cell_ly="0,11,0,11" line="0,0" impidxs="" />
				<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="MTS, 거래영업점, 고객지원센터(1588-3400)를 통해" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,12,0,12" line="0,0" impidxs="" />
				<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="가능합니다." fontsize="-2" impidxs="" />
			</CELL_INFO>
