'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		if szListItems(1) = "0"	then	'현재가
			Form.OpenScreen("16100" , g_szData)
			
		elseif szListItems(1) = "1"	then	'정정
			Form.OpenScreen("16200" , "미체결" & "★" & "3" & "★" & g_szOrderData ) 
		elseif szListItems(1) = "2"	then	'취소
			Form.OpenScreen("16200" , "미체결" & "★" & "3" & "★" & g_szOrderData ) 
		end if
		
		g_szData = ""
		g_szOrderData = ""
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket

	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtre_cntg_001r" then	
'	if szTranID == "obtre_cntg_003r" then	
		For iCnt = grd0.rowcount - 1 To 0 Step -1
			szItem = grd0.GetCellData( "bd_Cd", iCnt)
			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
'			If szMarket = "BN" or szMarket = "MM" Then
'				grdList.SetDeleteRow( iCnt )
'			Else
			
				'매매구분
				szData = grd0.GetCellData( "bd_TypeCd", iCnt)
				szData2 = grd0.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
						
				If szData2 = "2" Then								'정정
					If szData = "1" Then
						grd0.SetCellData("bd_TypeNm", iCnt, "매도정정")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellData("bd_TypeNm", iCnt, "매수정정")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
					
				ElseIf szData2 = "3" Then								'취소
					If szData = "1" Then
						grd0.SetCellData("bd_TypeNm", iCnt, "매도취소")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellData("bd_TypeNm", iCnt, "매수취소")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
					End If
					
				Else
					If szData = "1" Then
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
				End If
				
				'처리구분
				szData = grd0.GetCellData( "bd_ProcCd", iCnt)
				
				Select Case szData
					Case "0" grd0.SetCellData("bd_ProcNm", iCnt, "미접수")
					Case "1" grd0.SetCellData("bd_ProcNm", iCnt, "접수")
					Case "2" grd0.SetCellData("bd_ProcNm", iCnt, "확인")
					Case "3" grd0.SetCellData("bd_ProcNm", iCnt, "거부")
					Case "4" grd0.SetCellData("bd_ProcNm", iCnt, "PT효력정지")
				End Select
'			End If
		Next
	end if
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemInfo, tItemInfo, szItemCode, szExSym, szTranExch
	Dim szOdrNo, szQty, szOdrType, szOdrPrc, szClsCd, szSvcTp, szSvcNmTp
	
	szItemInfo	= grd0.GetCellData("bd_Cd", lRow)
	tItemInfo	= split(szItemInfo, ".")
	szItemCode	= tItemInfo(0)
	szExSym		= tItemInfo(1)
	
	'20220527 SWJ START : 종목코드에 "."이 들어간 경우 파싱 오류 수정(EX.버크셔해서웨이)
	if instr(szItemInfo,".") <> instrRev(szItemInfo,".") then
			
		sztempExid = Right(szItemInfo,len(szItemInfo) - instrRev(szItemInfo,"."))			
		sztempCode = Replace(szItemInfo,"." & sztempExid,"")
			
		szItemCode = sztempCode
		szExSym = sztempExid
	end if
	'20220527 SWJ END 
	
	szTranExch	= Transform_Exid2(szExSym)
	
	' 온라인 거래소가 아닌경우
	if szTranExch == "" or szTranExch == null Then
		Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		Exit Sub
	end if
	
	szQty = grd0.GetCellData("bd_cell7", lRow)
	
	' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격
	' 전달내용, 탭위치는 리턴받아서 처리함.
	If CInt( szQty ) > 0 Then
		szFull_ItemInfo = szExSym &"@"& szItemCode
'		szItemName	= grd0.GetCellData("bd_cell0", lRow)
		szItemName	= Form.GetItemCodeInfo(szFull_ItemInfo, "name")
		
		szOdrNo		= grd0.GetCellData("bd_cell1", lRow)
		szOdrType	= grd0.GetCellData("bd_cell15", lRow)
		szOdrPrc		= grd0.GetCellData("bd_cell4", lRow)
		szClsCd		= ""
		szSvcTp		= grd0.GetCellData("bd_TypeCd", lRow)
		szSvcNmTp	= grd0.GetCellData("bd_cell3", lRow) '신규/청산
		
		listLocation =  Split(grd0.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
		
		sPopupType = "4"
		
		'현재가 연결 시 보내는 데이터 > 종목정보★종목명

		g_szData = szFull_ItemInfo & "★" & szItemName 
		
		'주문화면 연결 시 보내는 데이터 > 종목정보★주문번호♥주문잔량♥주문유형♥주문가격♥""♥매매구분♥신규청산명
		g_szOrderData = szFull_ItemInfo & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd & "♥" & szSvcTp & "♥" & szSvcNmTp
		
		Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "미체결수량: " & CInt( szQty ) & "★" & "정정" & "★" & "취소" & "★" & "" & "★" & "" & "★" & "" )	
	End If
	
End Sub


'============================================================================
Sub grd0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obtre_cntg_001r" )
'	isMore = DATAMANAGER.IsMoreNextData( "obtre_cntg_003r" )
	
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obtre_cntg_001r" )
'		DATAMANAGER.RequestNextData( "obtre_cntg_003r" )
		
	end if
End Sub

