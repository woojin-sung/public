	<SCRIPT_INFO _len="11093" _ulen="10343" >
'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리
Dim g_szData, g_szOrderData

'============================================================================
' TR_Inquiry()
'============================================================================
Function TR_Inquiry()
	Dim nAcNo, nAsNo
	nAcNo = Form.GetCtlProp("#acnt0", "total")
	nAsNo = Form.GetCtlProp("#acnt0", "sequence")
	'Test 계좌
'	nAcNo = "30158194"
'	nAsNo = "02"

	Dim DEAL_CLS_CODE, NEW_CLRN_CLCD, CNTG_CLS_CODE
	
	if rdoMedosu.currentindex = 1 or rdoMedosu.currentindex = "1" then ' 매수
		DEAL_CLS_CODE = "2"
	Elseif rdoMedosu.currentindex = 2 or rdoMedosu.currentindex = "2" then ' 매도
		DEAL_CLS_CODE = "1"
	Else
		DEAL_CLS_CODE = "%"
	End if
	
	if rdoNEW.currentindex = 1 or rdoNEW.currentindex = "1" then ' 신규
		NEW_CLRN_CLCD = "1"
	Elseif rdoNEW.currentindex = 2 or rdoNEW.currentindex = "2" then ' 청산
		NEW_CLRN_CLCD = "2"
	Else
		NEW_CLRN_CLCD = "%"
	End if
	
	if rdoCNTG.currentindex = 1 or rdoCNTG.currentindex = "1" then ' 체결
		CNTG_CLS_CODE = "1"
	Elseif rdoCNTG.currentindex = 2 or rdoCNTG.currentindex = "2" then ' 미체결
		CNTG_CLS_CODE = "2"
	Else
		CNTG_CLS_CODE = "%"
	End if
	
