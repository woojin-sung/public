'===========================================================================
' 화 면 명: 다른 금융기관 계좌관리 팝업
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디
'Dim g_szRadio      '라디오 위치


'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	Grid.rowmove = "1" '그리드 순서 변경 
 
     g_szID = Form.GetSharedData("&USER_ID", false )
     'g_szRadio = "1"
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" )
	'DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , "1" ) ' 1:입출금, 2:예적금, 6:수익증권, T:종합계좌
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID", 0 , g_szID)

	DATAMANAGER.RequestTranData("obtss_opnf_008r")
     
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	Dim BankCode
	Dim BankName
	Dim BankAcno
	Dim OpnAcntKindCode
	Dim AcntTypeName
	Dim Prnm
	
	If szTranID = "obtss_opnf_021a" Then 
	
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_021a", "OutBlock1")
		
		if nCount > 0 then
			Form.MsgBox("알림", "저장되었습니다", "", 0)	
		End if
		
		For i = 0 to nCount -1
			BankCode        = DATAMANAGER.GetDataValue(0,"obtss_opnf_021a", "OutBlock1", "BANK_CODE", i)
			BankName        = DATAMANAGER.GetDataValue(0,"obtss_opnf_021a", "OutBlock1", "BANK_NAME", i)
			BankAcno        = DATAMANAGER.GetDataValue(0,"obtss_opnf_021a", "OutBlock1", "BANK_ACNO", i)
			OpnAcntKindCode = DATAMANAGER.GetDataValue(0,"obtss_opnf_021a", "OutBlock1", "OPN_ACNT_KIND_CODE", i)
			AcntTypeName    = DATAMANAGER.GetDataValue(0,"obtss_opnf_021a", "OutBlock1", "ACNT_TYPE_NAME", i)
			Prnm 	       = DATAMANAGER.GetDataValue(0,"obtss_opnf_021a", "OutBlock1", "PRNM", i)
		
			Grid.SetCellData("bd_cell0", i, BankName)
			Grid.SetCellData("bd_cell1", i, Prnm)
			Grid.SetCellData("bd_cell2", i, BankAcno)
			Grid.SetCellData("bd_cell4", i, BankCode)
			Grid.SetCellData("bd_cell5", i, OpnAcntKindCode)
		
		next
		
	End If  
End Sub



'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "INFO_POPUP" , "CLOSE" )
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	if szTranID = "obtss_opnf_021a" then
		Dim SubMsg
	
		SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	 
		if SubMsg = "" then
			Form.MsgBox("알림", szErrMsg, 0)	
		else
			Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
		end if
	end if
End Sub


'============================================================================
Sub btnSave_OnClick()
	
	Dim BankCode
	Dim BankAcno
	Dim OpnTimsNo
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_021a", "InBlock1", "PROS_CLS_CODE"	, 0 ,  "1" )
	'DATAMANAGER.SetDataValue( 0, "obtss_opnf_021a", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , g_szRadio ) ' 1:입출금, 2:예적금, 6:수익증권, T:종합계좌
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_021a", "InBlock1", "ELFN_ID"		, 0 , g_szID )
	
	For i = 0 to Grid.rowcount - 1
		BankAcno  = Grid.GetCellData( "bd_cell2", i)
		BankCode  = Grid.GetCellData( "bd_cell4", i)
		'OpnTimsNo = Grid.GetCellData( "bd_cell5", i)
			
		DATAMANAGER.SetDataValue( 0 , "obtss_opnf_021a", "InBlock2", "BANK_CODE" 	, i , BankCode)
		DATAMANAGER.SetDataValue( 0 , "obtss_opnf_021a", "InBlock2", "BANK_ACNO" 	, i , BankAcno)
		'DATAMANAGER.SetDataValue( 0 , "obtss_opnf_021a", "InBlock2", "OPN_TIMS_NO"	, i , OpnTimsNo)
	next
	
	DATAMANAGER.RequestTranData("obtss_opnf_021a")
	
End Sub






