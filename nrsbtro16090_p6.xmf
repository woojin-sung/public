	<SCRIPT_INFO _len="2963" _ulen="2795" >
'============================================================================
' 화 면 명 : 권리화면_권리유형
' 화면설명 : 권리화면의 권리유형선택 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szRghtCd, g_szGubun
g_szGubun = "%" '이용구분
g_szExch = "%" '시장

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData()	
'msgbox 	szData
	if szData <> "" then
		tData = Split(szData, "★")
		g_szGubun = tData(0)	
		g_szExch = tData(1)
		
		'이용구분
		if g_szGubun == "0" then      '01	신청
			RgGubun.currentindex = 1
		elseif g_szGubun == "1" then  '02	 해지
			RgGubun.currentindex = 2
		else
			RgGubun.currentindex = 0 '% 전체
		end if 
		
		'시장
		if g_szExch == "01" then      '01	미국
			RgExch.currentindex = 1
		elseif g_szExch == "02" then  '02	홍콩
			RgExch.currentindex = 4
		elseif g_szExch == "04" then  '03	심천
			RgExch.currentindex = 3
		elseif g_szExch == "03" then  '04   상해
			RgExch.currentindex = 2
		elseif g_szExch == "05" then  '17	일본
			RgExch.currentindex = 5
		else
			RgExch.currentindex = 0 '% 전체
		end if 		
		
	else
		'디폴트 전체
		RgGubun.currentindex = 0
		RgExch.currentindex = 0
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("OPTION_SET", g_szRghtCd)
End Sub

'============================================================================
Sub RgGubun_OnClick(nIndex)
	if nIndex == 1 then      '01	신청
		g_szGubun = "0" 
	elseif nIndex == 2 then  '02	해지
		g_szGubun = "1" 	
	else
		g_szGubun = "%" 	' % 전체
	end if
End Sub


'============================================================================
Sub RgExch_OnClick(nIndex)

	if nIndex == 1 then      '01	미국
		g_szExch = "01" 
	elseif nIndex == 4 then  '02	홍콩
		g_szExch = "02" 	
	elseif nIndex == 3 then  '03	심천
		g_szExch = "04" 	
	elseif nIndex == 2 then  '04    상해
		g_szExch = "03" 	
	elseif nIndex == 5 then  '17	일본
		g_szExch = "05" 	
	else
		g_szExch = "%" 	
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	Form.SendReturnToParent("OPTION_SET",  g_szGubun&  "★" & g_szExch)
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnInit_OnClick()
	RgGubun.currentindex = 0
	RgExch.currentindex = 0
End Sub

	</SCRIPT_INFO>
</ROOT>