'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet	'리턴값
g_szRet	=	"0"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
'	dim szURL
'	
'	szURL = "84010_CMAEtc"
'	
'	web01.viewtype = 0
'	web01.urlpath = szURL
	
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
		g_URLheader = "http://testhome.imeritz.com/include/resource/comm/"
	Else
		g_URLheader = "http://home.imeritz.com/include/resource/comm/"
	End If
	web01.viewtype = 0
	web01.urlpath = g_URLheader & "ctcn/files/ctcn008_1_ajax.pdf"
	
	Form.SetScreenName("상품설명/기타확인")
End Sub


'============================================================================
'BtnOK_OnClick
'============================================================================
Sub BtnOK_OnClick()

    If ChkButton0.checkstate = "1" Then
        g_szRet = "1"
        Form.CloseForm()
    Else
        Form.MsgBox( "알림" , "내용에 동의해주세요." , "" , 6 )
    End If	
	
End Sub


'============================================================================
'BtnCancel_OnClick
'============================================================================
Sub BtnCancel_OnClick()
	g_szRet	=	"0"
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("ETCOK", g_szRet)
End Sub


