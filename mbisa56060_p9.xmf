	<SCRIPT_INFO _len="2747" _ulen="2563" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청_가입자 확인사항
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sRetData 
g_sRetData = "cancel"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sLinkData
	sLinkData = Form.GetOpenLinkData()
	
	Form.SetScreenName("가입자 확인사항")
	
	'가입서류제출 선택방법
	tbl0.SetCellString( 1, 0, sLinkData)
	If sLinkData = "Email" then
		tbl0.SetCellString( 2, 0, "smart.br@meritz.com")
	ElseIf sLinkData = "Fax" then
		tbl0.SetCellString( 2, 0, "Fax. 02)6098-6445")
	End If
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbisa56060_p9" , g_sRetData )
End Sub

'============================================================================
Sub BtnCall0_OnClick()
	Form.SendCall( "0220626677" )
End Sub

'============================================================================
Sub btnOK_OnClick()
	If chk0.checkstate <> "1" or chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "가입자 서류제출 확인사항에 체크해 주세요.")
		Exit Sub
	End If
	
	g_sRetData = "ok"
	Form.SendReturnToParent( "mbisa56060_p9" , g_sRetData )
	Form.CloseForm()
End Sub

'============================================================================
'문구 클릭시에도 체크박스 선택되도록
Sub tblChk0_OnClick(lRow , lColumn)
	If chk0.checkstate == "0" then
		chk0.checkstate = "1"
	Else
		chk0.checkstate = "0"
	End If
End Sub

'============================================================================
'문구 클릭시에도 체크박스 선택되도록
Sub tblChk1_OnClick(lRow , lColumn)
	If chk1.checkstate == "0" then
		chk1.checkstate = "1"
	Else
		chk1.checkstate = "0"
	End If	
End Sub

