	<SCRIPT_INFO _len="799" _ulen="721" >
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOk_OnClick()
	if rdo1.currentindex ~= "0" then
		Form.MsgBox("알림", "개인정보 수집 및 이용동의를 확인해주세요.", "", 6)
		return
	end if
	
	if rdo2.currentindex ~= "0" then
		Form.MsgBox("알림", "개인정보 제 3자 제공 동의를 확인해주세요.", "", 6)
		return
	end if
	
	Form.SendReturnToParent("mbbnk61040_t4" , "ok")		
	Form.CloseForm()

End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.SendReturnToParent("mbbnk61040_t4" , "cancel")	
	Form.CloseForm()

End Sub

