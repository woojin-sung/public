Sub Form_OnFormInit()

    	sum = Form.GetSharedData("Age_Score") + Form.GetSharedData("Invst_Monthly_Score") + Form.GetSharedData("Earn_Score")     
    	+ Form.GetSharedData("Invst_Percent_Score") + Form.GetSharedData("Regular_Earn_Score") + Form.GetSharedData("Know_Score")
    	+ Form.GetSharedData("Exp_Score") + Form.GetSharedData("Risk_Combo_Score") + Form.GetSharedData("Lose_Score")            
    	+ Form.GetSharedData("Risk_Radio_Score") + Form.GetSharedData("Selection_Score") + Form.GetSharedData("Projects_Score")
   	 
	
	
		 
