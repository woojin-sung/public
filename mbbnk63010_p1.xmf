	<SCRIPT_INFO _len="1533" _ulen="1533" >
--===========================================================================
--===========================================================================

Dim g_SuccYn

'============================================================================
Sub Form_OnFormInit()
	g_SuccYn = "N"
	
	saveDate = Form.GetSharedData("&HOST_DATE", false )
	Form.SaveConfigData("NoticeSetting", "notice_simpletrans", saveDate)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	Form.OpenFramePopup("mbonl86011" , "mbbnk63010" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
    Form.SendReturnToParent("TERM_REG_SIMPLE_SUCCESS" , g_SuccYn)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "63010_CLOSE" then
	    g_SuccYn = "Y"
		Form.CloseForm()
	end If
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub
	</SCRIPT_INFO>
