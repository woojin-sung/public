	<CONTROL_INFO>
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image0" imgpath="popup_bg.9" ly_vert="0,378,375,259,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="1" rowcount="5" outline="0000" designorder="1" ly_vert="1,452,375,116,1" >
			<COL_INFO ly_vert_width="375" />
			<ROW_INFO ly_vert_height="27,27,8,27,27" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="비밀번호만 입력해도 이체가 가능해졌어요." impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="(1일 500만원 한도)" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" caption="보안강화 및 본인확인을 위해" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" caption="이용기기 지정 후 이용하시겠어요?" impidxs="" />
