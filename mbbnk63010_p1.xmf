		<BUTTON name="btnCancel" caption="나중에 이용하기" fgcolor="100:102102102" bgcolor="049:000000000" fontsize="1" fontstyle="01" btnimage="btn_27.9" ly_vert="0,597,187,50,1" />
		<BUTTON name="btnConfirm" caption="등록 후 시작하기" bgcolor="049:000000000" fontsize="1" fontstyle="01" btnimage="btn_20.9" ly_vert="187,597,188,50,1" />
