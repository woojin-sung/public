		<EDIT name="Edit2" mask="0,0,,개월,0,,0,1,1" halign="2" imetype="1" hintcaption="단위 개월" ly_vert="39,296,165,26,1" />
		<EDIT name="Edit3" mask="0,0,,만원,0,,0,1,1" halign="2" imetype="1" hintcaption="단위 개월" ly_vert="39,421,165,26,1" />
		<BUTTON name="Button0" caption="수정" btnimage="btn_05.9" ly_vert="231,416,57,33,1" />
		<BUTTON name="Button1" btnimage="btn_05.9" ly_vert="14,131,10,10,1" />
		<BUTTON name="Button2" btnimage="btn_05.9" ly_vert="14,16,10,10,1" />
		<BUTTON name="Button3" btnimage="btn_05.9" ly_vert="14,256,10,10,1" />
