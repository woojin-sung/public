		<LABEL name="Label1" caption="매달 얼마를 추가 투자할 수 있습니까?" ly_vert="22,122,266,32,1" />
		<LABEL name="Label2" caption="투자 기간은 얼마입니까?" ly_vert="22,247,182,32,1" />
		<LABEL name="Label3" caption="달성 목표 금액은 얼마입니까?" ly_vert="22,372,229,32,1" />
		<EDIT name="Edit0" mask="0,0,,만원,0,,0,1,1" halign="2" imetype="1" hintcaption="단위 만원" ly_vert="39,56,165,26,1" />
