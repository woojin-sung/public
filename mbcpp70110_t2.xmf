	<SCRIPT_INFO _len="4112" _ulen="4078" >
--===========================================================================
Dim uid

--===========================================================================

'============================================================================
Sub Button0_OnClick()
	'수정하기 버튼 클릭
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "CUST_ID", 0 , uid)               
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "USE_YN", 0 , "y")            
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "TOTAL_CSNU", 0 , Form.GetSharedData("User_Grade_Score", false))        
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INCL_GRAD_CODE", 0 , Form.GetSharedData("User_Grade_Code", false))
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "FRST_CNRC_AMT", 0 , Form.GetSharedData("Init_Capital", false))     
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "SPLM_INVT_AMT", 0 , Form.GetSharedData("Monthly_Capital",false))     
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "AGE", 0 , Form.GetSharedData("Age_Value",false))               
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "ANTC_INVT_PRD", 0 , Form.GetSharedData("Invest_Term",false))     
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_DVPD_INVT_EXPC", 0 , Form.GetSharedData("Exp_Value",false))
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INVT_KNLD", 0 , Form.GetSharedData("Know_Value",false))     
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "GOAL_AMT" ,0 , Form.GetSharedData("Goal_Amt",false))          
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_SCHL_REVN_YN", 0 , Form.GetSharedData("Regular_Earn_Value",false))
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "PROS_CLS_CODE", 0 , "u")
	
	DATAMANAGER.RequestTranData("obcpp_rbit_919a")
	
	Form.PostLinkData("CLOSEPLZ", "1")
	
	Form.Toast(0,"수정완료되었습니다",0)
	
	
End Sub

'============================================================================


'============================================================================
Sub Form_OnFormInit()
	
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919r", "InBlock1", "CUST_ID", 0 , uid)
	
	DATAMANAGER.RequestTranData("obcpp_rbit_919r")
	

	
	
End Sub

'============================================================================
Sub Edit0_OnEditComplete()
	Form.SetSharedData("Init_Capital", Cint(Edit0.caption))


End Sub

'============================================================================
Sub Edit1_OnEditComplete()
	Form.SetSharedData("Monthly_Capital", Cint(Edit1.caption))
	
End Sub

'============================================================================
Sub Edit2_OnEditComplete()
	Form.SetSharedData("Invest_Term", Cint(Edit2.caption))

End Sub


'============================================================================
Sub Edit3_OnEditComplete()
	Form.SetSharedData("Goal_Amt", Cint(Edit3.caption))
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	uid = Form.GetSharedData("&USER_ID", false)
End Sub

'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "obcpp_rbit_919a" then
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_919r", "InBlock1", "CUST_ID", 0 , uid)
	
		DATAMANAGER.RequestTranData("obcpp_rbit_919r")
	else 
		Edit0.caption = DATAMANAGER.GetDataValue(0, "obcpp_rbit_919r", "OutBlock1", "FRST_CNRC_AMT", 0)
		Edit1.caption = DATAMANAGER.GetDataValue(0, "obcpp_rbit_919r", "OutBlock1", "SPLM_INVT_AMT", 0)
		Edit2.caption = DATAMANAGER.GetDataValue(0, "obcpp_rbit_919r", "OutBlock1", "ANTC_INVT_PRD", 0)
		Edit3.caption = DATAMANAGER.GetDataValue(0, "obcpp_rbit_919r", "OutBlock1", "GOAL_AMT", 0)
	end if
End Sub

'============================================================================

