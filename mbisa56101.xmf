'============================================================================
' ClearData() : 이전 테이블 내용 초기화
'============================================================================
Function ClearData()
	'가입정보
	tblJoinInfo.SetCellString(0, 1, "")
	tblJoinInfo.SetCellString(0, 3, "")
	tblJoinInfo.SetCellString(1, 1, "")
	tblJoinInfo.SetCellString(1, 3, "")
	tblJoinInfo.SetCellString(2, 1, "")
	tblJoinInfo.SetCellString(2, 3, "")
	tblJoinInfo.SetCellString(3, 1, "")
	tblJoinInfo.SetCellString(3, 3, "")
	
	'납입정보
	tblPayment.SetCellString(0, 1, "")
	tblPayment.SetCellString(0, 3, "")
	tblPayment.SetCellString(1, 2, "")
	
	'인출정보
	tblWithdrawal.SetCellString(0, 1, "")
	tblWithdrawal.SetCellString(0, 3, "")
	tblWithdrawal.SetCellString(1, 2, "")
	tblWithdrawal.SetCellString(2, 2, "")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
    if Account0.caption <> NULL and Account0.caption <> "" then
	    DATAMANAGER.RequestTranData( "obsap_bisa_002r" )
    end if
End Sub

'============================================================================
' ImgPayment_OnClick() : 납입 정보 알림 팝업 오픈
'============================================================================
Sub ImgPayment_OnClick()
	Form.OpenPopup("mbisa56101_p1" , "" , "") 
End Sub

'============================================================================
' ImgWithdrawal_OnClick() : 인출 정보 알림 팝업 오픈
'============================================================================
Sub ImgWithdrawal_OnClick()
	Form.OpenPopup("mbisa56101_p2" , "" , "") 
End Sub

'============================================================================
' btnExpCancelChk_OnClick() : 해지예상 조회화면으로 연결
'============================================================================
Sub btnExpCancelChk_OnClick()
	Form.OpenPopup("mbisa56102" , "" , "")
End Sub

'============================================================================
' Account0_ChangeAccount() : 계좌 변경시 재조회
'============================================================================
Sub Account0_ChangeAccount()
	ClearData()
	
	if Account0.caption <> NULL and Account0.caption <> "" then
	    DATAMANAGER.RequestTranData( "obsap_bisa_002r" )
    end if
End Sub

'****************************************************************************
'               		D A T A				M A N A G E R               
'****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsap_bisa_002r" then
		Dim szACNO, szASNO
		szACNO = Left( Account0.caption, 8 )
		szASNO = Right( Account0.caption, 2 )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, szACNO) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, szASNO) '계좌일련번호
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsap_bisa_002r" then
		Dim szAccStatCd, szJoinTpCd ' 변환 전 코드
		Dim szAccStatName, szJoinTpName ' 변환 후 코드 값
		Dim szTfctAccYn ' 계좌구분 (Y: 이수전용, N: 신규)
		Dim szTfctAccName ' 계좌구분 (Y: 이수전용, N: 신규)
		
		szAccStatCd		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNT_STAT_CODE", 0) ' 계좌 상태 코드
		szJoinTpCd		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "JOIN_TYPE_CODE", 0) '가입자구분
		szTfctAccYn		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TFCT_EXUS_ACNT_YN", 0) '이수관전용계좌여부
	
		if szTfctAccYn == "Y" then
		    szTfctAccName = "이수전용"
		else
		    szTfctAccName = "신규"
		end if
	
		szAccStatName		= Form.GetMetaData("계좌상태코드", szAccStatCd)
		szJoinTpName		= Form.GetMetaData("가입유형코드", szJoinTpCd)
		
		tblJoinInfo.SetCellString(0, 3, szAccStatName)
		tblJoinInfo.SetCellString(0, 1, szJoinTpName)
		tblJoinInfo.SetCellString(3, 1, szTfctAccName)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubMsg <> NULL and szSubMsg <> "" then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	else
		Form.ShowAlert( "알림", szErrMsg )
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

    If sEventName == "SCREEN_MENU" Then
        If Trim(sParam) == "CAUTION_CALL" Then
            Form.OpenPopup("mbisa56101_p3.xmf" , "" , "")
        End If
    End If
    
End Sub

