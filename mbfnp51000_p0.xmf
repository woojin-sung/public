	<SCRIPT_INFO _len="14625" _ulen="13183" >
'============================================================================
' 펀드주요내용
'============================================================================
' 04 수정	:  2024.07.22 정우희 v001. 정기입금이체 약정 적합(적정)성 원칙 적용

dim	g_szShortCd		'선택된아이템 코드값
dim	g_szStndCd		'선택된아이템 풀코드
dim	g_szSaleChanTp	'선택된아이템 판매채널
dim g_szRet
'v001
dim g_szScreenNo		
dim g_szAcno
dim g_szAsno
dim g_szRmndSrno
dim g_szIscd
dim g_szKorIsnm
dim g_KYC_SPCL_INVR_YN		'KYC전문투자자여부
dim g_szRcmdClsCode		'KYC투자권유구분
dim g_szMtrtDate			'KYC만기일자
dim g_szHGDTYn
dim g_szFITYn
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	g_szScreenNo = "" 'v001
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_szShortCd 			= tData[0]
		g_szStndCd 			= tData[1]
		g_szSaleChanTp 		= tData[2]
		IF UBound(tData) > 3 then		
			'v001
			g_szScreenNo 			= tData[3]
			g_szAcno				= tData[4]
			g_szAsno				= tData[5]
			g_szRmndSrno 			= tData[6]
			g_szIscd 			= tData[7]
			g_szKorIsnm 			= tData[8]
		End If
		Container0.Label0.setHighlight(332)
'		Container0.Label1.setHighlight(332)
		
		DATAMANAGER.RequestTranData("oocwi_mall_003r")
		
		'v001 자동이체약정 진입 시 고객투자성향 비교
		if g_szScreenNo = "51020" then
			DATAMANAGER.RequestTranData("obcsb_acif_799r") '고객번호로 전문투자자여부 조회
		end if
	else
		Form.ShowAlert("알림", "입력값이 없습니다.")
	end if
End Sub

'============================================================================
Sub btnOK_OnClick()
	'v001 자동이체약정화면에서 진입 시
	if g_szScreenNo = "51020" then
		'정상이면, 금융소비자유형확인 후 투자성향 및 위험등급 확인 화면 오픈!
		Dim szSendData
		szSendData = g_KYC_SPCL_INVR_YN & "★" & g_szAcno & "★" & g_szShortCd & "★" & g_szStndCd & "★" & "" & "★" & "NEW"	
		Form.OpenPopup("mbfnp51000_p8", szSendData, sPosInfo)
	else 
		Dim szSendData
		szSendData = g_szShortCd & "★" & g_szStndCd & "★" & g_szSaleChanTp
		
		Form.OpenPopup("mbfnp51000_p2", szSendData, "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"oocwi_mall_003r"	then	
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "ISCD", 0, g_szStndCd)
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "STA_DATE", 0, int(Form.GetSharedData( "&HOST_DATE", false)))
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "FIN_DATE", 0, int(Form.GetSharedData( "&HOST_DATE", false)))
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "PROS_CLS_CODE", 0, "1")
	
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
	'v001
	elseif szTranID == "obcsb_acif_799r" then 
		dim szCust_Num	'고객번호
		szCust_Num = Form.GetSharedData("&CUST_NUM", false )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
	'v001
	elseif szTranID == "obcsb_acif_798r" then 
		dim g_szID
		g_szID = Form.GetSharedData("&USER_ID", false )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szID)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if	szTranID	=	"oocwi_mall_003r"	then
		Dim szGradCode, szTransGradNm, szTypeNm, szFundName
		
		szGradCode = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "PROD_GRAD_CODE", 0) 	'펀드등급
		szTransGradNm = Form.GetMetaData("집합투자증권상품등급코드", szGradCode)
		Container0.lblRiskNm.caption = szTransGradNm
		'Container0.lblRiskNm.fgcolor = 261
	
'		if szGradCode = "01" then
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_296.png"
'			Container0.Image0.imgpath = "icon_investmentrisk_case1_1.png"
'		elseif szGradCode = "02" then
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_297.png"
'			Container0.Image0.imgpath = "icon_investmentrisk_case1_2.png"
'		elseif szGradCode = "03" then
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_298.png"
'			Container0.Image0.imgpath = "icon_investmentrisk_case1_3.png"
'		elseif szGradCode = "04" then
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_299.png"
'			Container0.Image0.imgpath = "icon_investmentrisk_case1_4.png"
'		elseif szGradCode = "05" then
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'			Container0.Image0.imgpath = "icon_investmentrisk_case1_5.png"
'		elseif szGradCode = "06" then
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'			Container0.Image0.imgpath = "icon_investmentrisk_case1_6.png"
'		else
'			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		end if
		if szGradCode = "01" then
			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_372.png"
			Container0.Image0.imgpath = "icon_investmentrisk_case1_1.png"
			Container0.lblRiskNm.fgcolor = 273
		elseif szGradCode = "02" then
			Container0.ImgBadge1.imgpath = "img_bgsquare_grade_373.png"
			Container0.Image0.imgpath = "icon_investmentrisk_case1_2.png"
			Container0.lblRiskNm.fgcolor = 144
		elseif szGradCode = "03" then
