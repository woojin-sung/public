			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자정보가 확인되지 않아\n해당 금융상품을 가입할 수 없습니다.\n고객님의 성향에 적합한 금융상품 투자를\n위하여 투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		else
		end if
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	g_szRet = "GO_BACK"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51000_p0" ,  g_szRet)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "errMsgBox"  Then 	
		'v001 
		if sRet == "Left" then
			btnOK.enable = FALSE
		elseif sRet = "Right" then
			Form.OpenScreen("81010", "")
		end if
	elseIf sKeyName == "mbfnp51000_p2"  Then 	
		if sRet <> "GO_BACK" then
			Form.CloseForm()
		end if
	elseif sKeyName == "mbfnp51000_p8" Then
		if  sRet = "NEXT_mbfnp51000_p8" then
			Dim szData
			szData = g_szAcno & "★" & g_szAsno & "★" & g_szRmndSrno & "★" & g_szIscd & "★" & g_szKorIsnm
			Form.OpenPopup("mbfnp51020_p3", szData, sPosInfo)
		end if
	end if
End Sub

