<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50700" scrname="REITs 투자가이드-자주하는 질문" version="2" writer="노일호" />
	<FORM_INFO name="Form" ly_vert="0,0,375,624,1" />
	<CONTROL_INFO>
		<CONTAINER name="contMain" vscroll="1" ly_vert="0,100,375,624,1" scroll_ly_vert="0,100,375,624,1" >
			<CONTROL_INFO>
				<CONTAINER name="contFAQ" vscroll="1" ly_vert="20,20,335,484,1" scroll_ly_vert="20,20,335,484,1" >
					<CONTROL_INFO/>
				</CONTAINER>
			</CONTROL_INFO>
		</CONTAINER>
		<IMAGE name="imgLogo" autosize="1" imgpath="guide_img_faq.png" ly_vert="257,10,88,100,1" />
		<LABEL name="lblMainTitle" fontstyle="01" valign="0" multiline="1" ly_vert="20,29,225,71,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3517" _ulen="1899" >

'============================================================================
Sub Form_OnFormInit()
'	글자 패딩 없애기
	lblMainTitle.paddinginfo = "0,0,0,0"

'	Accordion 적용
'	배경색 320(246247248), 글자색 334(034034034), 차일드글자크기-2, 줄간격기본값(5)
	contMain.setScrollBarVisible("2") '스크롤시만 스크롤바 보이기
	contMain.contFAQ.makeExpandableList("","", 0, -2, "334", "334", -1, "320", False)
	contMain.contFAQ.addExpandableList("리츠란 무엇인가요?", "리츠는 부동산 자산에 쉽게 투자할 수 있는 간접투자기구로서 다수의 투자자들로부터 자금을 모아 부동산 및 부동산 관련 유가증권에 투자/운용하고 그 수익을 투자자에게 배당해요.\n\n리츠가 보유하고 있는 부동산은 아파트,오피스 등에 머물지 않고 통신인프라, 데이터센터, 물류센터로 다양화 되고 있어요.")
	contMain.contFAQ.addExpandableList("리츠 투자의 장점은 무엇인가요?", "주식처럼 거래할 수 있고, 전문가가 실물 부동산 투자를 대신 관리하기 때문에 안전하고 편리해요. 또한 고객이 원하는 기초자산을 선택하여 기대수익률이 낮을 경우 매도가 간단하며, 배당을 통하여 정기적인 현금을 창출 할 수 있어요.")
	contMain.contFAQ.addExpandableList("리츠는 어디에 투자하는 상품인가요?", "리츠는 크게 지분형과 모기지로 구분되고, 지분형리츠는 다양한 섹터로 재분류 하고 있어요.\n\n모기지,호텔,리테일 리츠는 높은 배당수익률이 기대되나 임대수익이 경기에 민감하게 연동되기 때문에 경기침체나 신용위험 발생 시 변동성이 높아 질 수 있어요.\n\n인프라,데이터센터,물류 리츠는 배당수익률은 낮지만 4차 산업혁명으로 관련 수요가 증가하여 자산가치와 임대로 상승이 기대됩니다.")
	contMain.contFAQ.addExpandableList("리츠 투자 시 유의사항은 무엇인가요?", "리츠는 실물 부동산이나 주식과는 다른 성격을 갖고 있어 투자할 때 기초자산의 특성, 임대계약 및 임차인 특성, 투자수익률, 밸류에이션 등을 점검할 필요가 있어요.")
	contMain.contFAQ.addExpandableList("해외 리츠 시장은 어떤가요?", "해외리츠는 약37개의 국가에서 상장 리츠가 거래되고 있고, 미국,일본,호주,영국,싱가포르 등 여러 국가에서 활발하게 거래되고 있어요.\n\n미국리츠는 세계최대규모이고 인프라,물류,데이터센터 등 신사업과 관련된 다양한 섹터가 상장되어 있어요.\n\n일본리츠는 대도시 부동산을 보유하고 있어 임대수익 안정성이 높아요.\n\n한국리츠는 초기단계이나 은퇴 세대의 증가로 향후 고성장이 예상되는 시장이에요.")
	contMain.contFAQ.addExpandableList("리츠 상품 투자 해보기", "리츠는 거래소에 상장되어 있어서 일반 주식을 거래 하듯이 매수/매도를 편리하게 할 수 있어요\n\n투자목적과 투자자 유형에 따라 개별종목매매, 리츠에 투자하는 ETF/ETN매매, 리츠에 투자하는 펀드를 거래 할 수 있어요.")
	
	imgLogo.setMaintainingRatio("1")
	imgLogo.imgpath= "guide_img_faq.png"
	lblMainTitle.caption = "리츠(REITs)상품에 대한\n궁금한 점을 해결해드립니다"
End Sub
'============================================================================

	</SCRIPT_INFO>
</ROOT>