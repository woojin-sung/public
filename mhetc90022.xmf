'============================================================================
' 계좌개설
'============================================================================
Sub ImageAcctOpen_OnClick()
	
	'무조건 로그아웃 시켜야함
	'인증/OTP 화면에 로그인하고 들어가는 화면들이 생겨서
	'본 화면에 진입할 수 있는 케이스가 생김
	'이 상태에서 계좌개설 등 진행하면 'ID를 확인하세요' 오류남
	if  Form.GetSharedData("&USER_ID", false) <> "" and Cint(Form.GetSharedData("&LOGIN_TYPE", false )) > 1 then
		Form.logout(0, 1)
	end if
	
	Form.SetSharedData("&SCREEN_AUTH" , "99")
	'v001
	Form.OpenPopup("mbbdm85100" , "" , "")
	'Form.OpenPopup("mbbdm86100" , "" , "")
End Sub

'============================================================================
' 로그인 방식선택
'============================================================================
Sub ImageLoginSelect_OnClick()
	
	'Form.SetTimerEvent2(1, 1, 0.1)
	Form.SetSharedData("&SCREEN_AUTH" , "")
	
	'KBC : 로그인화면 실행 시 90022화면이 종료되어야 함. OpenScreen은 iOS에서 로그인이 안닫히는 현상으로 OpenNextPopup을 사용 'Form.OpenScreen("90020" , "90022") '앱수정, 같이 배포해야 함 : OpenScreen, 90020을 오픈할때는 2번 오픈되는것 방지 	
	Form.OpenNextPopup("mhetc90021" , "mhetc90022" , "")
End Sub

'============================================================================
'20230524 SWJ START
'============================================================================
' ID관리
'============================================================================
Sub lblID_OnClick()

	'무조건 로그아웃 시켜야함
	if  Form.GetSharedData("&USER_ID", false) <> "" and Cint(Form.GetSharedData("&LOGIN_TYPE", false )) > 1 then
		Form.logout(0, 1)
	end if
	
	if g_sMockDealCheck == "1" then
		Form.SetSharedData("&SCREEN_NO" , "00012")		
		Form.OpenFramePopup("mhtrd00010.xmf" , "" , 0) 'mhtrd00010.xmf : 모의투자 웹링크화면 (모의투자 참가신청/취소)
		exit sub
	end if
	
	Form.SetSharedData("&SCREEN_AUTH","")
	Form.OpenPopup("mhetc90020_p2" , "" , "")	
End Sub

