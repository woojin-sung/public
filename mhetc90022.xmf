'20220805_01 KBC : 로그인개선
'20230404 v001 비대면화면 변경
'============================================================================
Sub Form_OnFormInit()
	'20240405_01 HWG START : 간편인증 등록 오류현상 임시조치 
	'삼성단말 ONE UI 6.0(OS14) - 
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	szOSVer  = Form.GetSharedData("&OS_VERSION", false)
	
	' 안드로이드 OS14 한정 
	if szOSType = "1" and Cint(szOSVer) > 13 then
	
		szConfUserID = Form.GetEnvData("login.input.userid")
		
		' ConfigUtil에 저장된 ID값 이 없는 경우(최초설치&미로그인 상태만 해당)
		if szConfUserID = "" then
			isBackground = Form.getEnvData("common.background_run")
			
			' 백그라운드 기능을 실행하지 않은 상태 확인
			if isBackground = "0" then
				Form.SetEnvData(1, "ROLLBACK_BACKGROUND_RUN", "1")
				Form.SetEnvData(1, "common.background_run", "1")
				Form.SendMessageToMain("BACKGROUND_RUN", "", "")
			end if
		end if
	end if
	'20240405_01 HWG END 
	
	'20230612 KBC START : 앱설치하고 
	'                     "메리츠증권 처음이신가요? 시작화면에서 인증/OTP->OTP관리 실행화면 진행이 안되는 문제
	'                     기본 로그인타입을 메리츠 간편인증으로 지정함
	DEF_TAB_ATON	= "8"	'아톤인증
	
	szTab = Form.GetEnvData("login.input.savetab")
		
	if Trim(szTab) == "" then
		'로그인 방식 미선택시
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ATON)
	end if
	'20230612 KBC END	
	
	g_sMockDealCheck = Form.GetEnvData("login.input.mockdeal")
	
	if g_sMockDealCheck == "1" then
		Form.SetSharedData("&SCREEN_AUTH" , "")
		Form.OpenNextPopup("mhetc90021" , "" , "")
	end if
	
	UserID = Form.GetSharedData("&USER_ID", false)
	
	if UserID <> "" and UserID <> null then
		ImageClose.visible = true
	end if
	
	'20230524 SWJ START
	LblInfo1.setHighlight(332)
	LblInfo2.setNeighborCtlPos("LblInfo1", "left", -3,"")
	'20230524 SWJ END
End Sub

