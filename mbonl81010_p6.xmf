''-------------------------------------------------------------------------------------------
'' 01. 화 면 명 : ELS/DLS 자가진단 문제풀이
'' 02. 화면설명 : 
'' 03. 작    성 : 2017.03.22 신재영
''-------------------------------------------------------------------------------------------
'
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'
Dim g_sRetData
' 계좌번호★계좌일련번호★종목코드★파생경험여부
Dim	g_szAcno		   	'계좌번호
Dim	g_szAsno		   	'계좌일련번호
Dim	g_szIscd		   	'종목코드
Dim	g_szDrvtExpcYn	'파생경험여부


Dim g_nMaxQNumber
Dim g_nAnswer
Dim g_nMaxTableRow

g_nAnswer = Array("X","N","N","N","N","N","N","N","N")
g_nMaxQNumber = 8

'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "CANCEL"
	Form.SetScreenName( "ELS/DLS 청약신청 자가진단표" )
	g_nMaxTableRow = Container0.Table0.rowcount
	
	Dim szLinkedData
	
	szLinkedData = Form.GetOpenLinkData( )
	g_szAcno			= getListItem(szLinkedData,0)
	g_szAsno			= getListItem(szLinkedData,1)
	g_szIscd			= getListItem(szLinkedData,2)
	g_szDrvtExpcYn	= getListItem(szLinkedData,3)

'	
End Sub	

'============================================================================
Sub Container0_Table0_OnClick(lRow , lColumn)
	
	If Container0.Table0.GetCellString( lRow, 1 ) == "○" OR 
		Container0.Table0.GetCellString( lRow, 1 ) == "⊙" Then '클릭한 행이 Anwser일 경우
		
		
		nQNumber = Container0.Table0.GetCellString( lRow, 3 )
		
		If Container0.Table0.GetCellString( lRow, 1 ) == "○" Then
			For i = 0 To g_nMaxTableRow
				If Container0.Table0.GetCellString( i, 3 ) == nQNumber Then
					Container0.Table0.SetCellString(i, 1, "○")
				End If
			Next
			Container0.Table0.SetCellString(lRow, 1, "⊙")
			
		ElseIf Container0.Table0.GetCellString( lRow, 1 ) == "⊙" Then
			Container0.Table0.SetCellString(lRow, 1, "○")

		End If
	End If
End Sub

'============================================================================
Sub Button0_OnClick()

	nCheckCount = 0
	
	For i = 0 to g_nMaxTableRow
		If Container0.Table0.GetCellString( i, 1 ) == "⊙" Then
			nCheckCount = nCheckCount + 1
		End If
	Next
	
	If nCheckCount < g_nMaxQNumber Then
		Form.ShowAlert( "응답하지 않은 항목이 있습니다.", "문제를 모두 풀어주세요" ) 
	ElseIf nCheckCount == g_nMaxQNumber Then '  모두응답
'		Form.OpenPopup("mbonl81010_p7" , g_szAcno &"★"&g_szAsno&"★"&g_szIscd&"★"&g_szDrvtExpcYn&"★"&"Y", "N")
		g_sRetData = "OK"
		Form.CloseForm()
	End If
	
End Sub
'============================================================================
Sub Form_OnFormClose()
	if	g_sRetData		<>	"OK"		then
		g_sRetData	=	"CANCEL"
		
		Form.SendReturnToParent("mbonl81010_p6" , g_sRetData)
	else
		Form.SendReturnToParent("mbonl81010_p6" , g_sRetData)
	end if
End Sub


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList

	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 

end function


'============================================================================
Sub Button1_OnClick()
	g_sRetData = "CANCEL"
	Form.CloseForm()
End Sub

