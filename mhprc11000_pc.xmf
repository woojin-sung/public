'============================================================================
Sub contSet_tblSet_OnClick(lRow , lColumn)
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	if lColumn = 1 or lColumn = 2 then
		if lRow = 0 then						' 호가등락률
			'contSet_imgDispdiff_OnClick()
			contSet_btnDispdiff_OnClick()
		elseif lRow = 1 then					' 호가잔량그래프
			'contSet_imgjangraph_OnClick()
			contSet_btnJangraph_OnClick()
		elseif lRow = 2 then					' 호가직전수량표시
			'contSet_imgDiplayrest_OnClick()
			contSet_btnDiplayrest_OnClick()
		elseif lRow = 4 then					' 현재가 외곽선 표시
			'contSet_imgPriceoutline_OnClick()
			contSet_btnPriceoutline_OnClick()
		elseif lRow = 5 then					' 현재가 스타일
'			contSet_imgStyle_OnClick()
		elseif lRow = 6 then					' 탭표시
			contSet_imgTab_OnClick()
		elseif lRow = 7 then					' 텍스트굵기 호가
			'contSet_imgBoldHoga_OnClick()
			contSet_btnBoldHoga_OnClick()
		elseif lRow = 9 then					' 텍스트굵기 호가잔량
			'contSet_imgBoldJan_OnClick()
			contSet_btnBoldJan_OnClick()
		elseif lRow = 10 then					' 텍스트굵기 직전대비
			'contSet_imgBoldRest_OnClick()
			contSet_btnBoldRest_OnClick()
		end if
	end if
	'20240503_01 HWG END
	
End Sub

