		'20230504 KKM START : 슬라이딩 버튼 변경
		contSet.btnDispdiff.switchindex = g_tSetTable.Dispdiff 
		contSet.btnjangraph.switchindex = g_tSetTable.Jangraph
		contSet.btnDiplayrest.switchindex = g_tSetTable.Diplayrest
		contSet.btnLP.switchindex = g_tSetTable.LP	'20240503_01 HWG : MTS ETF 고도화 대응
		contSet.btnPriceoutline.switchindex = g_tSetTable.Priceoutline		
		contSet.btnBoldHoga.switchindex = g_tSetTable.BoldHoga		
		contSet.btnBoldJan.switchindex = g_tSetTable.BoldJan		
		contSet.btnBoldRest.switchindex = g_tSetTable.BoldRest		
