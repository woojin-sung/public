'		End If
'		
'		'텍스트굵기 호가
'		If g_tSetTable.BoldHoga = "1" Then
'			Set_TableData(7, "선택")
'		Else
'			Set_TableData(7, "미선택")
'		End If
'		
'		'텍스트굵기 호가잔량
'		If g_tSetTable.BoldJan = "1" Then
'			Set_TableData(8, "선택")
'		Else
'			Set_TableData(8, "미선택")
'		End If
'		
'		'텍스트굵기 직전대비
'		If g_tSetTable.BoldRest = "1" Then
'			Set_TableData(9, "선택")
'		Else
