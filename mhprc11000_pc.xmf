'Sub contSet_imgDiplayrest_OnClick()
Sub contSet_btnDiplayrest_OnClick()
	g_tSetTable.Diplayrest = contSet.btnDiplayrest.switchindex
	
	
	if g_tSetTable.Diplayrest = "1" then
		g_tSetTable.LP = "0"
		contSet.btnLP.switchindex = g_tSetTable.LP	
	end if

'	If g_tSetTable.Diplayrest = "1" Then
'		g_tSetTable.Diplayrest = "0"
'		Set_TableData(2, "미선택")
'	Else
'		g_tSetTable.Diplayrest = "1"
'		Set_TableData(2, "선택")
'	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhprc11000", "Diplayrest"	, g_tSetTable.Diplayrest	)	'호가직전수량표시
	Form.SaveConfigData("mhprc11000", "LP"	,		 g_tSetTable.LP	)			'LP잔량
End Sub

Sub contSet_btnLP_OnClick()
	g_tSetTable.LP = contSet.btnLP.switchindex
	
	
	if g_tSetTable.LP = "1" then
		g_tSetTable.Diplayrest = "0"
		contSet.btnDiplayrest.switchindex = g_tSetTable.Diplayrest
	end if

