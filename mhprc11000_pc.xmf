'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'======================================
Sub Form_OnFormInit()
	Form.SetScreenName( "현재가 화면설정" )
	Init_Control( 0 )
End Sub

'======================================
Sub Form_OnFormClose()
	' 주식현재가화면에 셋팅 적용 알림
	Form.SendReturnToParent( "HOGA_SETUP", g_szClick )
	
End Sub


