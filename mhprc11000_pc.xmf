'======================================
' Init_SetTable : 설정테이블 초기화
'======================================
Function Init_SetTable()
	g_tSetTable.Dispdiff 		= "1"
	g_tSetTable.Jangraph 		= "1"
	' 20230427 KKM 호가직전수량표시 "선택"으로 초기화설정
	g_tSetTable.Diplayrest 	= "1"
	g_tSetTable.LP			= "0"	'20240503_01 HWG : MTS ETF 고도화 대응
	g_tSetTable.Priceoutline 	= "1"
	g_tSetTable.Style		 	= "1"
	g_tSetTable.BoldHoga 		= "1"
	g_tSetTable.BoldJan 		= "0"
	g_tSetTable.BoldRest 		= "0"
	
	'20230504 KKM START : 슬라이딩 버튼 변경
	contSet.btnDispdiff.switchindex =  g_tSetTable.Dispdiff
	contSet.btnjangraph.switchindex =  g_tSetTable.Jangraph
	contSet.btnDiplayrest.switchindex = g_tSetTable.Diplayrest
	contSet.btnLP.switchindex = g_tSetTable.LP	'20240503_01 HWG : MTS ETF 고도화 대응
	contSet.btnPriceoutline.switchindex = g_tSetTable.Priceoutline		
	contSet.btnBoldHoga.switchindex = g_tSetTable.BoldHoga
	contSet.btnBoldJan.switchindex =  g_tSetTable.BoldJan
	contSet.btnBoldRest.switchindex = g_tSetTable.BoldRest
	'20230504 KKM  END 		
	
	Form.SaveConfigData("mhprc11000", "Dispdiff"		, g_tSetTable.Dispdiff		)	'호가등락률
	Form.SaveConfigData("mhprc11000", "Jangraph"		, g_tSetTable.Jangraph		)	'호가잔량그래프
	Form.SaveConfigData("mhprc11000", "Diplayrest"	, g_tSetTable.Diplayrest	)	'호가직전수량표시
	Form.SaveConfigData("mhprc11000", "LP"			, g_tSetTable.LP			)	'LP잔량	'20240503_01 HWG : MTS ETF 고도화 대
	Form.SaveConfigData("mhprc11000", "Priceoutline"	, g_tSetTable.Priceoutline	)	'현재가 외곽선 표시
	Form.SaveConfigData("mhprc11000", "Style"		, g_tSetTable.Style		)	'현재가 스타일
	Form.SaveConfigData("mhprc11000", "BoldHoga"		, g_tSetTable.BoldHoga		)	'텍스트굵기 호가
	Form.SaveConfigData("mhprc11000", "BoldJan"		, g_tSetTable.BoldJan		)	'텍스트굵기 호가잔량
	Form.SaveConfigData("mhprc11000", "BoldRest"		, g_tSetTable.BoldRest		)	'텍스트굵기 직전대비
	
End Function

'======================================
' Set_TableData : 선택영역 네이밍 및 폰트 색상 적용
'======================================
Function Set_TableData(nRow, szName)
	contSet.tblSet.SetCellString(nRow, 1, szName)
	
	if Trim(szName) = "선택" then
		contSet.tblSet.SetCellFgColor(nRow, 1, "12")	
	else
		contSet.tblSet.SetCellFgColor(nRow, 1, "13")	
	end if
End Function

'======================================
' Init_Control : 설정 초기화(0: 화면오픈, 1:초기화버튽클릭)
'======================================
Function Init_Control(nIdx)

	contSet.btnDispdiff.SetApplySwitch( "", "", 269, 261, 286, 289) 
	contSet.btnjangraph.SetApplySwitch( "", "", 269, 261, 286,289) 
	contSet.btnDiplayrest.SetApplySwitch( "", "", 269, 261, 286, 289) 
	contSet.btnLP.SetApplySwitch( "", "", 269, 261, 286, 289) 	'20240503_01 HWG : MTS ETF 고도화 대응
	contSet.btnPriceoutline.SetApplySwitch( "", "", 269, 261, 286, 289) 
	contSet.btnBoldHoga.SetApplySwitch( "", "", 269, 261, 286, 289) 
	contSet.btnBoldJan.SetApplySwitch( "", "", 269, 261, 286, 289) 
	contSet.btnBoldRest.SetApplySwitch( "", "", 269, 261, 286, 289) 

	if nIdx = 1 then							' 초기화 버튼 클릭시
		'Set_TableData(0, "선택")
		'Set_TableData(1, "선택")
		'Set_TableData(2, "미선택")
		'Set_TableData(2, "선택") ' 20230427 KKM 호가직전수량표시 "선택"으로 초기화설정
		'Set_TableData(3, "선택")
		Set_TableData(6, "순서변경")	'20240503_01 HWG : MTS ETF 고도화 대응
		'Set_TableData(7, "선택")
		'Set_TableData(8, "미선택")
		'Set_TableData(9, "미선택")	
		
'20230417 KKM 현재가스타일삭제		
'		contSet.cmbStyle.currentindex = 1
'		contSet.lblStyle.caption = "스타일2"
		
		Init_SetTable()
		
		Form.SendReturnToParent( "FORMTAB_INIT", g_szClick )
		
		Form.Toast(0, "설정이 초기화 되었습니다.", true)
	else										' Form_init
		g_tSetTable.Dispdiff		= Form.LoadConfigData("mhprc11000", "Dispdiff"	)	'호가등락률
		g_tSetTable.Jangraph		= Form.LoadConfigData("mhprc11000", "Jangraph"	)	'호가잔량그래프
		g_tSetTable.Diplayrest		= Form.LoadConfigData("mhprc11000", "Diplayrest"	)	'호가직전수량표시
		g_tSetTable.LP			= Form.LoadConfigData("mhprc11000", "LP"	)			'LP잔량	'20240503_01 HWG : MTS ETF 고도화 대응
		g_tSetTable.Priceoutline	= Form.LoadConfigData("mhprc11000", "Priceoutline")	'현재가 외곽선 표시
		g_tSetTable.Style			= Form.LoadConfigData("mhprc11000", "Style"		)	'현재가 스타일
		g_tSetTable.BoldHoga		= Form.LoadConfigData("mhprc11000", "BoldHoga"	)	'텍스트굵기 호가
		g_tSetTable.BoldJan		= Form.LoadConfigData("mhprc11000", "BoldJan"		)	'텍스트굵기 호가잔량
		g_tSetTable.BoldRest		= Form.LoadConfigData("mhprc11000", "BoldRest"	)	'텍스트굵기 직전대비	
		
'		'호가등락률
'		If g_tSetTable.Dispdiff = "1" Then
'			Set_TableData(0, "선택")
'		Else
'			Set_TableData(0, "미선택")
'		End If
'		
'		'호가잔량그래프
'		If g_tSetTable.Jangraph = "1" Then
'			Set_TableData(1, "선택")
'		Else
'			Set_TableData(1, "미선택")
'		End If
'		
'		'호가직전수량표시
'		If g_tSetTable.Diplayrest = "1" Then
'			Set_TableData(2, "선택")
'		Else
'			Set_TableData(2, "미선택")
'		End If
'		
