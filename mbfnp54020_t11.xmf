Sub btnBuy_OnClick()
	Call Check_InputData()'''0
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtrs_oder_301a" then
		g_szTR = szTranID
	
		DATAMANAGER.ClearInputData(0, "obtrs_oder_301a")

		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "SVCD", 0, "302")							''' 서비스코드'
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "CHAN_TYPE_CLS_CODE", 0, "020")				''' 채널유형
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_MKPL_CLS_CODE" , 0, cmbMkt.cbkeydata ) 	'시장콤보컨트롤
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_MKFN_CODL_YN", 0, cmbSmt.cbkeydata)		'동시매매 컨트롤
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acc", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acc", "sequence"))	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
