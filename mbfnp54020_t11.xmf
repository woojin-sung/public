'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID == "obtrs_comn_420r" then
	  
	   Dim szQty
	   szQty = DATAMANAGER.GetDataValue( 0, "obtrs_comn_420r", "OutBlock1", "ODER_ABLE_QTY", 0)
	   g_szODER_ABLE_AMT = DATAMANAGER.GetDataValue( 0, "obtrs_comn_420r", "OutBlock1", "ODER_ABLE_AMT", 0)

'	   edtQty.caption = szQty
	   
	   lblAbleQty.visible = true
	   lblAbleQty0.visible = false
	   
	elseIf szTranID == "obtrs_comn_420r_1" then
	   lblAbleMax.visible = true
	   lblAbleMax0.visible = false
	   
	elseIf szTranID == "obtrs_comn_420r_2" then	'가격/수량 입력 팝업용
		g_szODER_ABLE_AMT = DATAMANAGER.GetDataValue( 0, "obtrs_comn_420r_2", "OutBlock1", "ODER_ABLE_AMT", 0)

		if edtPrice.caption <> "" then
			szPrc = edtPrice.caption
		else'현재가
			szPrc = Form.GetCtlProp("#lblHyun", "caption")
		end if
		szQty = edtQty.caption
		szData = szPrc & "★" & szQty & "★" & g_szMk & "★" & g_szCd & "★" & g_szODER_ABLE_AMT & "★" & g_szOpenCalcClickType  & "★" & "0"
		Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2") 
		
	elseIf szTranID == "ohhts_7052_001r" then
		'20160602 NOHES 채권 호가 단위
		Dim szPrc
		szPrc = DATAMANAGER.GetDataValue( 0, "ohhts_7052_001r", "OutBlock1", "FID_PRPR", 0)
			
		if szPrc ~= "" then
			edtPrice.caption = szPrc
			
			Call Check_OrderQty(1)	'최대수량 조회
			f_SetOrderPrice()
		end if
	
	elseif szTranID == "obtrs_oder_301a" then
			Dim szOrdCd, szOrdMsg, szOrgNo, szWarnCd, szWarnMsg
			' 주문경고보류용 플래그 YGH EDIT 20191125
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
			
				g_szTR = ""
				g_szWarnFlag = "N"
			' 주문경고보류용 플래그 YGH EDIT 20191125
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
		
			    if Trim(szOrdCd) == "0001" then			' 정상주문
			    
				    Form.Toast(0, szOrdMsg, true)
				    
				    if g_szAfterInit == "1" then		' 주문후 초기화
				       edtQty.caption = ""
				       edtPrice.caption = ""
				       lblOrderPrice.caption = ""
				    end if
				    
				    if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
				    end if 
				
				end if
			end if
			
	elseif szTranID == "obtrs_sstm_506r" then	'소액 단일가매매 여부 조회
		szOrdSmt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MKOP_CLS_CODE", 0)	'"035": 소액단일가매매
'		szOrdSmt = "035"

		if szOrdSmt = "035" then
			Form.MsgBox("알림", "소액채권시장 단일가매매 시간\n(15:10~15:30)입니다.\n\n소액채권 단일가매매로 주문하시겠습니까?", "ORDER_SMT", 7, "단일가 주문하기", "취소")
		else
			if g_szOdrPop == "1" then
				Open_ConfirmPopup()
			else
				DATAMANAGER.RequestTranData( "obtrs_oder_301a" )	
			end if
		end if
	
	End If
	
	' 주문경고보류용 플래그 YGH EDIT 20191125
	g_szWarnFlag = "N"	
	' 주문경고보류용 플래그 YGH EDIT 20191125
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	' 주문경고보류용 플래그 YGH EDIT 20191125
	g_szWarnFlag = "N"
	' 주문경고보류용 플래그 YGH EDIT 20191125
	
	'420r이랑 동시호출/ 이미호출하여, 밑에 로직 한번 탐
	if szTranID == "obtrs_comn_420r_1" then
		exit Sub
	elseIf szTranID == "obtrs_comn_420r_2" then	'가격/수량 입력 팝업용
		g_szODER_ABLE_AMT = 0

		if edtPrice.caption <> "" then
			szPrc = edtPrice.caption
		else'현재가
			szPrc = Form.GetCtlProp("#lblHyun", "caption")
		end if
		szQty = edtQty.caption
		szData = szPrc & "★" & szQty & "★" & g_szMk & "★" & g_szCd & "★" & g_szODER_ABLE_AMT & "★" & g_szOpenCalcClickType  & "★" & "0" 
		Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2")
		exit Sub
	end if
	
    if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	if szTranID = "obtrs_oder_301a" then
		cmbSmt.currentindex = 0
	end if
	
End Sub

