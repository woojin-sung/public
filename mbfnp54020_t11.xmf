'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
	lblAbleQty.caption = " 주"
	lblInfo.setNeighborCtlPos("imgIcon", "left", 6, "")
End Sub

'============================================================================
' 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "54020_HOGA" then		' 메인화면의 호가 클릭시
		if sParam <> "" then
			''''(주문유형)에 따른 '주문단가
			edtPrice.caption = sParam
			
			Call Check_OrderQty(1)	'최대수량 조회
			f_SetOrderPrice()
		end if
	
	elseif sEventName == "INIT_CODE" then	' 메인화면에서 종목코드 받기
		if Trim(sParam) <> "" then
			g_szODER_ABLE_AMT = "0"
			tData = Split(sParam, "★")

			if #tData > 0 then
				if #tData > 2 then
					g_szMK = tData(0)
					g_szCd = tData(1)
					
					g_bPrcFlag = true
					edtPrice.caption = tData(2)		
					
					if #tData > 3 then			'채권가상매매 연동>가격&수량
						edtQty.caption = tData(3)
					end if
					Call Check_OrderQty(1)			'최대수량 조회
					f_SetOrderPrice()
					g_bPrcFlag = false
					exit sub
				else
					g_szMK = tData(0)
					g_szCd = tData(1)
				end if

				Set_OrdType()		' 종목코드에 따라 주문유형 설정
			end if
			
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				edtQty.caption = ""
				edtPrice.caption = ""
			else
				Request_Price()				' 종목변경시 가격 재조회
			end if
		end if
		
	'가능수량 팝업에서 리턴
	ElseIf sEventName = "Able_Popup" Then
		tTemp = Split(sParam, "★")
		edtPrice.caption = tTemp(0)
		edtQty.caption = tTemp(1)
		edtPrice_OnEditComplete()
		
	ElseIf sEventName = "ACNT_CHANGE" Then
		g_szODER_ABLE_AMT = "0"
		Call Check_OrderQty(1)	'최대수량 조회
	End if
End Sub

