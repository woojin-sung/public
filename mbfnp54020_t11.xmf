Sub rdoGbn_OnClick(nIndex)
	if Trim(g_szCd) == "" then	'종목코드 없는 경우
		Exit Sub
	end if

	if nIndex == 0 then
		cmbMkt.currentindex = 0
		cmbSmt.currentindex = 0
	else
		cmbMkt.currentindex = 1
		cmbSmt.currentindex = 0
	end if
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			nResult = CDbl(szQty) Mod nUnit
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = szQty - nUnit
				nResult = CDbl(szQty) Mod nUnit
				
				if nResult <> 0 then
					nResult = nUnit - nResult
					szQty = CDbl(szQty) + nResult
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szQty
	szQty = edtQty.caption
	
	if nGbn == 1 then
		if Trim(szQty) == "" then
			szQty = 0
		end if
		
		szQty = CDbl(szQty) + nPlus
	else
		
		'처음 숫자는 초기화
		if g_sIsFirst == true then
			g_sIsFirst = false
			szQty = nPlus
		else
			szQty = szQty & nPlus
		end if
		
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szQty
	szQty = edtQty.caption
	
	if Len(edtQty.caption) > 0 then
		szQty = edtQty.caption & szPlus
		
		Sum_Qty(szQty)
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	if Len(szData) < 16 then
		edtQty.caption = szData
		f_SetOrderPrice()
	end if
End Function

'============================================================================
Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")
	imgIcon.setMaintainingRatio("1")
End Sub
                                                                                
'============================================================================
Sub btnPrderPricePopup_OnClick()
	if Trim(g_szCd) == "" then	'종목코드 없는 경우
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
'	'계좌번호
	szAcnt   = Form.GetCtlProp("#acc", "total")
	szAcntCd   = Form.GetCtlProp("#acc", "sequence")
	'가격
	if edtPrice.caption == "" then
		szPrice = "0"
	else
		szPrice = edtPrice.caption
	end if
	'수량
	if edtQty.caption == "" then
		szQty = 0
	else
		szQty = edtQty.caption
	end if
	
	szMK = cmbMkt.cbkeydata
	
'    '계좌번호|종목코드|매매구분(1매도, 2매수)|주문수량|주문단가|매매시장구분코드|종합분리과세구분코드
    szData = szAcnt & "★" & szAcntCd & "★" & g_szCd & "★" & "2" & "★" & szQty & "★" & szPrice & "★" & szMK & "★" & "1"
    
    Form.OpenPopupAnimation("mbfnp54020_pa" , szData , "","2")
End Sub

'============================================================================
Sub lblInfoClick_OnClick()
	Form.OpenPopupAnimation("mbfnp54020_p10", "", "", "2")
End Sub

'============================================================================
Sub btnPricepop_OnClick()
	Form.OpenPopup("mbfnp54020_pb" , "" , "")
End Sub

'============================================================================
Sub btnOrderPrice_OnClick()
	if Trim(g_szCd) == "" then	'종목코드 없는 경우
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	g_szOpenCalcClickType = "2" '0=단가 1=수량 2=금액
	
    if CInt(g_szODER_ABLE_AMT) = 0 then
	    DATAMANAGER.RequestTranData( "obtrs_comn_420r_2" )
	    exit sub
	end if

	if edtPrice.caption <> "" then
		szPrc = edtPrice.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
    szQty = edtQty.caption
    szData = szPrc & "★" & szQty & "★" & g_szMk & "★" & g_szCd & "★" & g_szODER_ABLE_AMT & "★" & "2"  & "★" & "0"
	Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2")  
End Sub

'============================================================================
Sub edtPrice_OnEditComplete()
	Call Check_OrderQty(1)	'최대수량 조회
	f_SetOrderPrice()
End Sub

'============================================================================
Sub lblAbleQty_OnClick()
	szMaxQty = lblAbleQty.caption
	edtQty.caption = szMaxQty
	f_SetOrderPrice()
End Sub
'============================================================================
Sub lblAbleMax_OnClick()
	szMaxQty = lblAbleQty.caption
	edtQty.caption = szMaxQty
	f_SetOrderPrice()
End Sub

'============================================================================
Sub btnAble_OnClick()	'주문가능 팝업 오픈
	if Trim(g_szCd) == "" then	'종목코드 없는 경우
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if

	Dim szPrc
	if g_szChangeInit == "1" then	'환경설정에 종목탭 변경 초기화 사용인 경우 현재가로 넘김
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	else
		szPrc = edtPrice.caption
	end if
	
	szData = Form.GetCtlProp("#acc", "total") & "★" & Form.GetCtlProp("#acc", "sequence") & "★" & g_szCd & "★" & szPrc & "★" & cmbMkt.cbkeydata & "★" & g_szMk
	Form.triggerEvent("#", "Open_mbfnp54020_pc", szData)
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
'	' ----------------------------------------------------------------------
'	' 소액 단일가매매 확인창에서 리턴
'	' ----------------------------------------------------------------------	
	If sKeyName = "ORDER_SMT" then	
		if sRet = "ok" then
			cmbSmt.currentindex = 1
		else
			Form.Toast(0, " 주문이 취소되었습니다. ", 0)
			exit Sub 
		end if

		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			DATAMANAGER.RequestTranData( "obtrs_oder_301a" )	
		end if
	end if
End Sub
'============================================================================
' 금액 계산
Sub f_SetOrderPrice()
	Dim nPrc,nQty,nOrderPrice
	nPrc = 0
	nQty = 0
	nOrderPrice = 0
	
	if edtPrice.caption <> "" then
		nPrc = CDbl(edtPrice.caption * 100)
	else
		lblOrderPrice.caption = "-"
		Exit Sub
	end if
	
	if edtQty.caption <> "" then
		nQty = CInt(edtQty.caption)
	end if
	
	nOrderPrice = nPrc * nQty / 1000 	'채권 금액 = 단가*수량*0.1
	lblOrderPrice.caption = nOrderPrice
End Sub 
'============================================================================
Sub edtQty_OnEditComplete()
	f_SetOrderPrice()
End Sub

