'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	' 주문경고보류용 플래그 YGH EDIT 20191125
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 주문경고보류용 플래그 YGH EDIT 20191125
	elseif sKeyName == "주문전송" then
		if sRet == "1" then 
	       DATAMANAGER.RequestTranData( "obtrs_oder_301a" )'''
	    end if  
'	' ----------------------------------------------------------------------
'	' 가격확인창에서 리턴
'	' ----------------------------------------------------------------------	
'	elseif sKeyName == "PRC_POPUP" then
'	   edtPrice.caption = sRet
'	' ----------------------------------------------------------------------
'	' 수량확인창에서 리턴
'	' ----------------------------------------------------------------------	
'	elseif sKeyName == "QTY_POPUP" then
'	  edtQty.caption = sRet	
'	  
	elseif sKeyName == "mbfnp54020_p12" then		
		
		if sRet <> "" then
			Dim tTemp
			tTemp = Split(sRet, "★")
			
			edtPrice.caption = tTemp(0)
			edtQty.caption = tTemp(1)
			edtPrice_OnEditComplete()
		end if
	
    end if
End Sub

'============================================================================
Sub btnPrc_OnClick()
	Dim szData
	
	if Trim(g_szCd) == "" or Trim(g_szCd) == Null then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	if g_szMk == Null or g_szMk == "" then
		Form.ShowAlert( "알림", "시장구분 코드가 존재하지 않습니다.")
		Exit Sub
	end if
	g_szOpenCalcClickType = "0" '0=단가 1=수량 2=금액
	
    if CInt(g_szODER_ABLE_AMT) = 0 then
	    DATAMANAGER.RequestTranData( "obtrs_comn_420r_2" )
	    exit sub
	end if
	
	if edtPrice.caption <> "" then
		szPrc = edtPrice.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
    szQty = edtQty.caption
	    
    szData = szPrc & "★" & szQty & "★" & g_szMk & "★" & g_szCd & "★" & g_szODER_ABLE_AMT & "★" & "0"  & "★" & "0"
	Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2")  
End Sub

'============================================================================
Sub btnQty_OnClick()
	Dim szData
	
	if Trim(g_szCd) == "" or Trim(g_szCd) == Null then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	if g_szMk == Null or g_szMk == "" then
		Form.ShowAlert( "알림", "시장구분 코드가 존재하지 않습니다.")
		Exit Sub
	end if
	
	g_szOpenCalcClickType = "2" '0=단가 1=수량 2=금액
	
    if CInt(g_szODER_ABLE_AMT) = 0 then
	    DATAMANAGER.RequestTranData( "obtrs_comn_420r_2" )
	    exit sub
	end if
	if edtPrice.caption <> "" then
		szPrc = edtPrice.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
    szQty = edtQty.caption
    szData = szPrc & "★" & szQty  & "★" & g_szMk & "★" & g_szCd & "★" & g_szODER_ABLE_AMT & "★" & "1"  & "★" & "0"
    Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2")
End Sub

'============================================================================
Sub cmbMkt_OnEditComplete(iIndex)
	if iIndex == 0 then
		btnPricepop.visible = false
		g_szMK = "B"
		Form.triggerEvent("#", "BODY_CALLBACK", "B" & "★" & g_szCd)
	else
		btnPricepop.visible = true
		g_szMK = "SB"
		Form.triggerEvent("#", "BODY_CALLBACK", "SB" & "★" & g_szCd)
	end if
	
	if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
		edtQty.caption = ""
		edtPrice.caption = ""
		Call Check_OrderQty(1)	'최대수량 조회
	else
		Request_Price()				' 종목변경시 가격 재조회
	end if
End Sub


