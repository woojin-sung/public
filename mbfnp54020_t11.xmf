			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))	' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ISCD"				, 0, g_szCd)'''szCd						' 종목코드
		'20160601 NOHES_I/O변경 ODER_PRC -> BOND_ODER_UNPR
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_ODER_UNPR"			, 0, edtPrice.caption)					' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODQT"				, 0, edtQty.caption)						' 주문수량
'		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODER_CLS_CODE"		, 0, szType)								' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BYOV_DATE"		, 0, cldBuy.caption)'''						' 매수일자
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "FEE_LEVY_YN", 0, "0")											' 수수료 징수 여부
		' 주문경고보류용 플래그 YGH EDIT 20191125
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag) 						' 주문경고 확인여부
		' 주문경고보류용 플래그 YGH EDIT 20191125
