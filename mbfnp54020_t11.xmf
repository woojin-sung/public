		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acc", "sequence"))	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, g_szCd)								' 종목코드
