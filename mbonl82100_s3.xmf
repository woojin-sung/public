'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szActPwd
Dim g_szAccount
Dim g_nSelectRow
Dim g_szInputCd
Dim g_szCellId
Dim g_nAmt
Dim g_szGridName
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function f_SetAccountMask(szAccount)
	Dim szReturnData 
	if trim(szAccount) ~= "" then
		if #szAccount == 10 then
			szReturnData = Left(szAccount,4)&"-"&Mid(szAccount,5,4)&"-"&Right(szAccount,2)		
		elseif #szAccount == 8 then
			szReturnData = Left(szAccount,4)&"-"&Right(szAccount,4)
		else
			szReturnData = szAccount
		end if
	end if
	
	return szReturnData
	
End Function


'============================================================================
Sub Form_OnFormInit()
	g_nSelectRow = -1
	cont0.Grid0.setUseCardView(true, 10, "img_bgbox.9.png")
	cont0.Grid1.setUseCardView(true, 10, "img_bgbox.9.png")
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert(sEventName, sParam)

	if sEventName == "Init" then
		if trim(sParam) ~= "" then
			Dim tParam
			tParam = Split(sParam, "★")
			
			'증권담보융자 trim(tParam[4])			
			Dim tData1
			Dim bLoanType1
			Dim bLoanType2
			tData1 = Split(trim(tParam[3]), "☆")
			if trim(tData1[0]) ~= "" and trim(tData1[0]) ~= "Y" then
				g_nAmt = tData1[1]
			
				bLoanType1 = true
				
				Dim tData2
				tData2 = Split(trim(tParam[4]), "☆")
				if trim(tData2[0]) == "" or trim(tData2[0]) == "Y" then
					bLoanType2 = false
				else
					bLoanType2 = true
				end if
			else
				bLoanType1 = false
				bLoanType2 = false
			end	if
			
			
			'신청계좌
			Dim szAccount
			'LHR 수정 8자리만 보여주도록 수정
			g_szAccount = tParam[0]
			szAccount = f_SetAccountMask(left(tParam[0],8))

			'담보관련 통보방법
			Dim szUI_PROD_OPNG
			if  trim(tParam[1])  == "Y" and  trim(tParam[2])  == "Y" then
				szUI_PROD_OPNG = "SMS, 이메일"
			else
				if  trim(tParam[1])  == "Y" then
					szUI_PROD_OPNG = "SMS"
				end if
				
				if  trim(tParam[2])  == "Y" then
					szUI_PROD_OPNG = "이메일"
				end	if
			end if
			
			
			cont0.Grid0.AddRow( )
			cont0.Grid1.AddRow( )
			if bLoanType1 == true and bLoanType2 == false then
			
				cont0.Grid0.SetCellData( "bd_Title1", 0, "대출약정")
				cont0.Grid0.SetCellData( "bd_Title2", 0, "신청계좌")
				cont0.Grid0.SetCellData( "bd_Title3", 0, "약정금액")
				cont0.Grid0.SetCellData( "bd_Title4", 0, "인지세")
				cont0.Grid0.SetCellData( "bd_Title5", 0, "담보관련 통보")
				
				cont0.Grid0.SetCellData( "bd_Data1", 0, "증권담보대출")
				cont0.Grid0.SetCellData( "bd_Data2", 0, trim(szAccount))
				cont0.Grid0.SetCellData( "bd_Data3", 0, FormatNumber(CInt(tData1[1]), 0, 0, 0, -1) & " 원")'CInt(tData1[1]))
				cont0.Grid0.SetCellData( "bd_Data4", 0, "")
				cont0.Grid0.SetCellData( "bd_Data5", 0, szUI_PROD_OPNG)					
				
				g_szCellId = "bd_Data4"
				
				cont0.Grid0.visible = "1"
				cont0.Grid1.visible = "0"
			else
				
				cont0.Grid1.SetCellData( "bd_Title1", 0, "신청계좌")
				cont0.Grid1.SetCellData( "bd_Title2", 0, "약정금액")
				cont0.Grid1.SetCellData( "bd_Title3", 0, "인지세")
				cont0.Grid1.SetCellData( "bd_Title4", 0, "담보관련 통보")
				
				cont0.Grid1.SetCellData( "bd_Data1", 0, trim(szAccount))
				cont0.Grid1.SetCellData( "bd_Data2", 0, FormatNumber(CInt(tData1[1]), 0, 0, 0, -1) & " 원")'CInt(tData1[1]))
				cont0.Grid1.SetCellData( "bd_Data3", 0, "")
				cont0.Grid1.SetCellData( "bd_Data4", 0, szUI_PROD_OPNG)
				
				g_szCellId = "bd_Data3"
				
				cont0.Grid1.visible = "1"
				cont0.Grid0.visible = "0"
			end if
			
			DATAMANAGER.RequestTranData("oblon_stmp_001r")
			
			cont0.Grid0.SetCellData( "bd_Left",   0, "해지")
			cont0.Grid0.SetCellData( "bd_Right",  0, "변경")
			
			cont0.Grid0.SetCellData( "bd_Input1", 0, bLoanType2)
			cont0.Grid0.SetCellData( "bd_Input2", 0, trim(g_szAccount))
			cont0.Grid0.SetCellData( "bd_Input3", 0, trim(tData1[1]))
			cont0.Grid0.SetCellData( "bd_Input4", 0, trim(tParam[1])&"★"&trim(tParam[2]))
			cont0.Grid0.SetCellData( "bd_Input5", 0, "")
			
			cont0.Grid1.SetCellData( "bd_Left",   0, "해지")
			cont0.Grid1.SetCellData( "bd_Right",  0, "변경")
			
			cont0.Grid1.SetCellData( "bd_Input1", 0, bLoanType2)
			cont0.Grid1.SetCellData( "bd_Input2", 0, trim(g_szAccount))
			cont0.Grid1.SetCellData( "bd_Input3", 0, trim(tData1[1]))
			cont0.Grid1.SetCellData( "bd_Input4", 0, trim(tParam[1])&"★"&trim(tParam[2]))
			cont0.Grid1.SetCellData( "bd_Input5", 0, "")
			
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			Form.triggerEvent("#", "CORRECT_PWD", tPwd[0])
			g_szActPwd = tPwd[0]
			
			'Form.MsgBox("안내", "담보대출약정을\n해지하시겠습니까?", "Cancel", 1)
			
			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
		end if
	elseif sKeyName == "mhetc90060_p5" then		
		if sRet ~= "cancel" then		
			'LHR 수정
			'DATAMANAGER.RequestTranData("obsap_acif_999a")
			DATAMANAGER.SetEventFlag( "oblon_basc_801a", "A" )
			DATAMANAGER.RequestTranData( "oblon_basc_801a" ) '약정해지
		end if 
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
'	Form.ShowAlert(sKeyName, sRet)

	if sKeyName == "Cancel" then
		if sRet == "ok" then
			'LHR 수정
			'DATAMANAGER.SetEventFlag( "oblon_basc_801a", "A" )
			'DATAMANAGER.RequestTranData( "oblon_basc_801a" ) 
			'Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
			
			dim szAcntInfo
			if g_szGridName == "Grid0" then
				szAcntInfo = cont0.Grid0.GetCellData( "bd_Input2", g_nSelectRow)
			elseif g_szGridName == "Grid1" then
				szAcntInfo = cont0.Grid1.GetCellData( "bd_Input2", g_nSelectRow)
			else
				exit sub
			end if
		
			'계좌 비밀번호 팝업 호출
			Form.openPopupAnimation("pwdcheckpopup", szAcntInfo&"☆2", "", "2")
		end if
		
	elseif sKeyName == "oblon_basc_801a" then
		if sRet == "close" then
			Form.triggerEvent( "#", "End", "")
		end if
	end if 
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_stmp_001r" then
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "ACNO" , 0 , Left(g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "ASNO" , 0 , Right(g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "UI_STPL_AMT1" , 0 , g_nAmt )
		
	elseif szTranID == "oblon_basc_801a" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "PROS_YN" , 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LOAN_TYPE_CODE" , 0 , "02" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LIMT_AMT" , 0 , g_nAmt ) '약정금액
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "STPL_CANC_CLS_CODE" , 0 , "0" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "UNCL_ATMT_LOAN_YN" , 0 , "N" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "FEE_LEVY_CLS_CODE" , 0 , "2" )
		'해지이므로 0
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "SPLM_PAYM_AMT" , 0 , 0 ) '추가납부인지세
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_MNRC_AMT1" , 0 , cont0.Grid0.GetCellData( "bd_Input5", 0)  ) '추가납부인지세
		
		if g_szCellId == "bd_Data3" then '매도담보융자
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "PROS_YN" , 1 , "Y" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LOAN_TYPE_CODE" , 1 , "03" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LIMT_AMT" , 1 , g_nAmt ) '약정금액
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "STPL_CANC_CLS_CODE" , 1 , "0" )
		end if
'		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ACNO" , 0 , Left(g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ASNO" , 0 , Right(g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ACNT_PWD" , 0 , g_szActPwd  )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "PROS_CLS_CODE" , 0 , "3" )
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "DRNG_ACNO" , 0 , Left(Cont0.Account0.caption, 8) ) '인지세납부계좌번호
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "DRNG_ASNO" , 0 , Right(Cont0.Account0.caption, 2) ) '인지세납부계좌번호
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_CNFR_PWD" , 0 , sPWD )
'		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "CRDT_AGRM_BSWR_KIND_CLCD", 0, "014")
'		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "PROS_DATE", 0, sProsDate)
'		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "PROS_SRNO", 0, sProsSrno)
'		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "FNPR_JOIN_SRNO", 0, g_szFnprJoinSrno) 'v001
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "CONT_CLS_CODE" , 0, "4") 'v001
		
		Dim tData
		Dim szTmp
		szTmp = cont0.Grid0.GetCellData( "bd_Input4", 0)
		tData = Split(szTmp, "★")
		
		if tData[0] == "Y" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN1" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN1" , 0 , "N" )
		end if
		
		if tData[1] == "Y" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN2" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN2" , 0 , "N" )
		end if

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if  szTranID == "oblon_stmp_001r" then
		Dim nAmt 
		nAmt = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_TOTAL_STPL_AMT1" , 0 )) '납부인지세
		
		if nAmt == null or nAmt == "" then
			nAmt = 0
		end if 
		
		cont0.Grid0.SetCellData( "bd_Data4", 0, FormatNumber(CInt(nAmt), 0, 0, 0, -1) & " 원")
		cont0.Grid0.SetCellData( "bd_Input5", 0, nAmt)
		
		cont0.Grid1.SetCellData( "bd_Data3", 0, FormatNumber(CInt(nAmt), 0, 0, 0, -1) & " 원")
		cont0.Grid1.SetCellData( "bd_Input5", 0, nAmt)
		
	elseif szTranID == "oblon_basc_801a" then
		g_szActPwd = ""
		g_nSelectRow = -1

		Form.MsgBox("안내", "담보대출약정이 해지되었습니다.", "oblon_basc_801a", 6)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg <> "" and szSubMsg <> null then
		Form.ShowAlert("알림", szErrMsg & "\n" & szSubMsg )
	else
		Form.ShowAlert("알림", szErrMsg )
	end if 
End Sub


'============================================================================
Sub cont0_Grid0_OnClickUp(lRow, szCellID)
	g_nSelectRow = -1
	g_szActPwd = ""
	
	if szCellID == "bd_Left" then '해지하기 버튼
		g_nSelectRow = lRow	
		g_szGridName = "Grid0"
		
		dim szAcntInfo
		szAcntInfo = cont0.Grid0.GetCellData( "bd_Input2", lRow)
		
		'계좌 비밀번호 팝업 호출
		'Form.openPopupAnimation("pwdcheckpopup", szAcntInfo&"☆1", "", "2")
		Form.MsgBox("안내", "담보대출약정을 해지하시겠습니까?", "Cancel", 1)
	elseif szCellID == "bd_Right" then '변경하기 버튼
		Dim szAccount
'		
		szAccount = trim(cont0.Grid0.GetCellData( "bd_Input2", lRow ))
		Form.triggerEvent("#", "Change", szAccount)
'		
	end if
End Sub



'============================================================================
