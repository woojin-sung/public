'============================================================================
' 01. 화 면 명 : HOME_리서치리포트
' 02. 화면설명 : 메리츠 리서치 리포트
' 03. 작    성 : 
'============================================================================


'============================================================================
Sub Form_OnFormInit()
	lblTitle.fgcolor = 334

	'큰글씨 모드 대응
	szTextSize = Form.GetEnvData("common.textsize")
	szOsType = Form.GetSharedData("&OS_TYPE", false )
	if CInt(szTextSize) > 0 and szOsType == "2" then '큰글씨 + IOS 이면
		lbl0.maxlinecnt = "2^-6"
		lbl5.maxlinecnt = "2^-6"
		lbl8.maxlinecnt = "2^-6"
	else
		lbl0.maxlinecnt = "2^-4"
		lbl5.maxlinecnt = "2^-4"
		lbl8.maxlinecnt = "2^-4"
	end if
	
	DATAMANAGER.RequestTranData("ooopc_rprt_005r")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	icon0.SetMaintainingRatio("1")
	icon1.SetMaintainingRatio("1")
	icon3.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub btn3_OnClick()
	Form.OpenScreen("44060" , "0")
End Sub

'============================================================================
Sub btn0_OnClick()
	Form.OpenScreen("44060" , "1")
End Sub

'============================================================================
Sub btn1_OnClick()
	Form.OpenScreen("44060" , "2")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ooopc_rprt_005r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BBS_GRP_ID" , 0 , "bascGrp")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "BBS_GRP_ID" , 0 , "bascGrp")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "BBS_GRP_ID" , 0 , "bascGrp")
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BBS_ID" , 0 , "sih02")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "BBS_ID" , 0 , "invest03")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "BBS_ID" , 0 , "invest02")
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1")	'1: 최신등록순, 2: 조회수 많은 순
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "IQRY_CLS_CODE" , 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "IQRY_CLS_CODE" , 0 , "1")
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ooopc_rprt_005r")
End Sub

	</SCRIPT_INFO>
