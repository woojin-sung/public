				<EDIT name="edtPwd" fontsize="3" password="2" imetype="1" maxlength="13" hintcaption="계좌비밀번호를 입력해주세요." imagefilepth="input_03.9" ly_vert="20,207,335,74,1" />
				<EDIT name="edtBirth" fontsize="3" imetype="1" maxlength="6" hintcaption="생년월일 6자리를 입력해주세요." imagefilepth="input_03.9" ly_vert="20,292,335,74,1" />
				<COMBO name="CmbAcnt" visible="0" fontsize="4" cblistcount="20" popuptitle="계좌를 선택해주세요." imagefilepth="input_03.9" ly_vert="20,379,335,74,0" />
