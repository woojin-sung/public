'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(1, 0, 0.1)
		contMain.edtAcno.SetShowKeypad(True)
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(2, 0, 0.5)
		contMain.edtPwd.SetShowKeypad(True)
	elseif sTimerID == "3" or sTimerID == 3 then
		Form.SetTimerEvent2(3, 0, 0.1)
		contMain.edtPwd.SetShowKeypad(false)
	elseif sTimerID == "4" or sTimerID == 4 then
		Form.SetTimerEvent2(4, 0, 0.3)
		contMain.edtAcno.SetShowKeypad(false)
	elseif sTimerID == "5" or sTimerID == 5 then
		Form.SetTimerEvent2(5, 0, 0.1)
		contMain.edtBirth.SetShowKeypad(True)
	elseif sTimerID == "6" or sTimerID == 6 then
		Form.SetTimerEvent2(6, 0, 0.1)
		contMain.edtBirth.SetShowKeypad(False)
	elseif sTimerID == "7" or sTimerID == 7 then
		Form.SetTimerEvent2(7, 0, 0.1)
		Form.MsgBox("안내", "계좌비밀번호를 입력해주세요.", "edtbirth_click", 6)
	end if
End Sub
'============================================================================
Sub contMain_edtAcno_OnEditComplete() '이름
    g_Cntt1 = "Y"  '스크롤설정 체크용 변수 설정 
    
    nTop = 0
    nContResize = 0

    If contMain.edtAcno.caption ~= "" Or contMain.edtAcno.caption ~= null Then
        If Len(replace(contMain.edtAcno.caption, " " , "")) == 0 Then
			'contMain.edtBirth.SetShowKeypad(false)
			'contMain.edtPwd.SetShowKeypad(false)
             contMain.edtAcno.SetResultLabel("1","error","계좌번호를 입력해주세요.","contMain")
		    'Form.MsgBox("안내", "계좌번호가 입력되지 않았습니다.\n계좌번호를 먼저 입력해주세요.", "emptyAcno" , 0)
             Exit Sub
        Else
            '이름 공백 체크
            sStr = Len(contMain.edtAcno.Caption)
	    
            If sStr <> 8 Then
                contMain.edtAcno.SetResultLabel("1","error","계좌번호 앞 8자리를 입력해주세요.","contMain")
                Exit Sub
             End If
        End If

       contMain.edtAcno.SetResultLabel("0","complete","","contMain")
       
       contMain.edtAcno.maxlength = "9"
       contMain.edtAcno.mask = "1,0,,,1,####-####,0,1,1"
       
        '계좌비밀번호 입력키보드 자동보이기
        If contMain.edtPwd.caption == "" Or contMain.edtPwd.caption == null Then
		
            '일반키패드(단말지원)->보안키패드(내부) 자동오픈에 따른 오류방지
            '일반키패드에서 입력완료가 아닌 키패드외부 선택에 따라 키패드가 닫힌상태에서 뒤로가기(업무종료시키는 경우)시
            '입력완료로 판단되어 화면은 안내페이지로 돌아가지만 보안키패드가 올라왔다가 앱이 죽는 현상 발생
            If g_Back_Flag <> "Y" Then
			   Form.SetTimerEvent2(2, 1, 0.1)                     '0.1초뒤 보안키패드 활성화
            End If
        End If
    End If
End Sub
'============================================================================
Sub contMain_edtPwd_OnEditComplete() '계좌비밀번호
    nTop = 0
    nContResize = 0

    If contMain.edtPwd.caption == "" Or contMain.edtPwd.caption == null Then
	    contMain.edtPwd.SetResultLabel("1","error","계좌비밀번호를 입력해주세요.","contMain")
	else	   
	    
        nLen = contMain.edtPwd.pwdlen
	   
	   if Cint(nLen) == 0 then
		   contMain.edtPwd.SetResultLabel("1","error","계좌비밀번호를 입력해주세요.","contMain")
		   exit sub
	   end if
	   
	   if Cint(nLen) < 4 then
		   contMain.edtPwd.SetResultLabel("1","error","4자 이상 입력해주세요.","contMain")
		   exit sub
	   end if

	   contMain.edtPwd.SetResultLabel("0","complete","","contMain")
	    
	    if Cint(g_logintype) > 1 then
		      '확인버튼 활성화
		     btnNext.visible = True
		     btnNext.btnimage = "btn_20.9"
		     btnNext.fgcolor = "273"
	    else
		    If g_Back_Flag <> "Y" Then
				Form.SetTimerEvent2(5, 1, 0.1)                     '0.1초뒤 보안키패드 활성화                 
			End If
	    end if
	    
    End If
End Sub
