'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	'2023.06.09 : jsi : 주민번호 확인 시 에러코드 메세지 수정 
	if szTranID = "obacp_opop_073r" and szErrCode = "3431" then
		Form.ShowAlert("안내", "등록 정보가 일치하지 않습니다.\n 다시 한번 확인해주세요.")
		exit Sub
	end if 
	'---------------------------------------------------------jsi end
	
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub
'============================================================================
' 이전단계로
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
    If sKeyName == "Exit" Then
        If sRet == "ok" Then  '예.ok / 아니오.no
            Form.SetSharedData("&SCREEN_AUTH" , "") '비대면화면 권한프리
		   Form.CloseForm()
        Else
            g_Back_Flag = ""
        End If
	elseif sKeyName == "close" then
		g_closeflag = "close"
		Form.CloseForm()
	elseif sKeyName == "emptyAcno" then
		Form.SetTimerEvent2(1, 1, 0.1)
	elseif sKeyName == "edtpwd_click" then
		Form.SetTimerEvent2(3, 1, 0.1)
		Form.SetTimerEvent2(1, 1, 0.1)
	elseif sKeyName == "edtbirth_click" then
		'Form.SetTimerEvent2(6, 0 ,0.1)
		'Form.SetTimerEvent2(2, 0 ,0.2)
		'contMain.edtBirth.SetShowKeypad(false)
		Form.SetTimerEvent2(6, 1, 0.1)
		Form.SetTimerEvent2(2, 1, 0.3)
		'contMain.edtPwd.SetShowKeypad(true)
	
	' SMJ 수정 ------------------------------------------------
	elseif sKeyName == "WRAP_MBWAT61020_P9" then
		if sRet == "ok" then  '예.ok / 아니오.no
			Form.CloseForm()
		end if
		
		Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	' SMJ 수정 ------------------------------------------------
	
    End If
End Sub
'============================================================================
Sub imgBack_OnClick()
    g_Back_Flag = "Y"

	' SMJ 수정 ------------------------------------------------
	if Trim(g_ScrPoint) == "WRAP_MBWAT61020_P9" then
		Form.MsgBox("알림", "온라인 계좌개설을 중단하시겠습니까?", "WRAP_MBWAT61020_P9", "2")  '2.예/아니오
		Exit Sub
	end if
	' SMJ 수정 ------------------------------------------------
	
    '100.비대면계좌개설, 0xx.비대면 업무신청
    If (g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1) Then
        '(진행중인~~ 이어하기~~ 있습니다)  => (  괄호내 이어가기~ 문구 삭제 By박정숙Cha
        'Form.OpenPopup("mbbdm85100_p9" , "100" , "5")  '100.위치? 5.백그라운드회색처리
        Form.MsgBox("알림", "계좌개설을 중단하시겠습니까?", "Exit", "2")  '2.예/아니오
    '0xx.비대면업무신청 3xx.모바일OTP발급 999.비대면진행상태확인
    Else 
        '세분화처리함 
        'Form.OpenPopup("mbbdm85200_p9" , "100" , "5")
        tmpMsg = ""
        If (g_sz_SubNmetBswrGb == "3" Or g_sz_SubNmetBswrGb == 3) Then
            tmpMsg = "모바일OTP 업무처리를 중단하시겠습니까?"
        ElseIf (g_sz_SubNmetBswrGb == "9" Or g_sz_SubNmetBswrGb == 9) Then
            tmpMsg = "진행상태확인 업무를 중단하시겠습니까?"
        Else  'If (g_sz_SubNmetBswrGb == "0" Or g_sz_SubNmetBswrGb == 0) Then
            tmpMsg = "업무신청을 중단하시겠습니까?"
        End If
        Form.MsgBox("알림", tmpMsg, "Exit", "2")  '2.예/아니오
    End If
End Sub
