Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
    
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	Form.SetSharedData("&SCREEN_AUTH"      , "" )

	'화면진입 위치 (로그인 화면인지, 인증센터 화면인지)
	g_ScrPoint = Form.GetOpenLinkData()
	
	' SMJ 수정 ------------------------------------------------
	'Wrap가입 화면에서 진입할 때(mbwat61022_t1 > mbwat61020_p9)
	if Trim(g_ScrPoint) == "WRAP_MBWAT61020_P9" then
		g_ACNT_NO_MBWAT61022 = Form.GetSharedData("mbwat61022_AcntNo", true)		
	end if
	' SMJ 수정 ------------------------------------------------
		
    '로그인여부
	g_logintype = Form.GetSharedData("&LOGIN_TYPE", False )
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	
	'OSType 1.안드로이드 2.IOS
     g_szOSType = Form.GetSharedData("&OS_TYPE", False)	
     
    '메뉴에서 진입하는 입하므로 화면번호로 체크 
    g_SCR_NO = Form.GetSharedData( "&POPUP_SCREEN_NO" , False )
    g_DeviceId         = Form.GetDeviceID2() 
    g_MediaType 		=  Form.GetSharedData("&MEDIA_CODE", false )

    '통신사정보-Default설정 없음
    'g_sz_HPCo = Form.GetSharedData("&PHONE_COMPANY_CODE", False )  '통신사 정보
    g_sz_HPNo = Form.GetSharedData("&PHONE_NUMBER"      , False ) '기기정보에서 읽어온 휴대폰번호(P로 시작하면 핸드폰번호, R로 시작하면 단말ID)
	
	'로그인 시 생년월일 단계 PASS
    if Cint(g_logintype) > 1 then
	    g_juminPip = Form.GetSharedData("&JUMIN_NUM", false )
	    g_szCustNo = Form.GetSharedData("&CUST_NUM", false)
	    
	    contMain.CmbAcnt.top = 90
		contMain.CmbAcnt.visible = true
		contMain.edtPwd.top = 174
		contMain.CmbAcnt.cbtype = 5
		contMain.BtnFindAcnt.visible = false
		contMain.ImgArrow.visible = false
		contMain.lblTitle0.visible = false
		contMain.edtAcno.visible = false
		contMain.edtBirth.visible = false
		
		contMain.edtAcno.SetApplyLabel   ("계좌번호"       , 0, 267, "left", false)  'True.필수입력 / False.선택입력
		contMain.CmbAcnt.SetApplyLabel("계좌번호"       , 0, 267, "left", false, 111)
		contMain.edtPwd.SetApplyLabel    ("계좌비밀번호" 	, 0, 267, "left", false)
		contMain.edtPwd.SetUseResultLabel(True, 1)
		
		if Trim(g_ScrPoint) == "WRAP_MBWAT61020_P9" then
			contMain.CmbAcnt.visible 	= false
			contMain.edtAcno.visible 	= true
			contMain.edtAcno.enable 	= false
			contMain.edtAcno.top 		= 90
			contMain.edtAcno.caption	= Left(g_ACNT_NO_MBWAT61022,4)..Mid(g_ACNT_NO_MBWAT61022,5,4)
			
			Form.SetTimerEvent2(2, 1, 0.5)
		end if

    end if
	
	'재요청버튼 문구
	contMain.btnAthnRetry.caption = "재요청 >"
	contMain.btnAthnRetry.fgcolor = 267   '검은색
	contMain.lblTitle0.caption = "계좌번호 찾기 >"
	contMain.lblTitle0.setNeighborCtlPos("ImgArrow", "right", 10, "")
End Sub
