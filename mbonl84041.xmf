Dim g_Opng_File              '오픈할화면
Dim g_Send_Data              '인자정보
Dim g_sPauCustNo			  '아톤에서 발급시 갖고 있는 고객번호
Dim g_szCustNo			  '고객이 입력한 계좌기준 고객번호
Dim g_szRcnoPip			  
Dim g_sErrorCode			  '인증서 등록여여부 확인용 오류코드

Dim g_RCNO_TYPE_CODE		'SMJ 추가
Dim g_CUST_FULL_NAME		'SMJ 추가
Dim g_ACNT_NO_MBWAT61022	'SMJ 추가

Dim g_MediaType
Dim g_fullRcno
Dim g_FindAcnt1, g_FindAcnt2
Dim g_closeflag
Dim g_custClsCode             'jsi 법인용
Dim g_Reuse
Dim g_sGubunCode, g_MotpYN
Dim g_sAlias
Dim g_juminPip
Dim g_PwdKeyPad
Dim g_motpAppYN
g_motpAppYN = ""

Dim G_MERITZ_ADD_FILE 			'추가인증풀팝업
Dim G_MERITZ_SECURITY_FILE 		'보안카드풀팝업
Dim G_MERITZ_QUESTION_FILE 		'부가정보풀팝업
Dim G_MERITZ_OTP_FILE 			'일반/스마트OTP풀팝업
Dim G_MERITZ_OCSP_FILE			'인증서 검증 팝업
Dim G_MERITZ_MOTP_FILE 		'모바일OTP풀팝업
	
G_MERITZ_ADD_FILE 			= "mhetc90060_p11"	'추가인증풀팝업
G_MERITZ_SECURITY_FILE 		= "mhetc90060_p9"		'보안카드풀팝업
G_MERITZ_QUESTION_FILE			= "mhetc90060_pa"		'부가정보풀팝업
G_MERITZ_OTP_FILE 			= "mhetc90060_pb"		'일반/스마트OTP풀팝업
G_MERITZ_MOTP_FILE			= "mhetc90060_motp"    '모바일OTP풀팝업
G_MERITZ_OCSP_FILE			= "mhetc90060_p5"		'인증서 검증 팝업
'-------------------------------------------------------------------------------

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
Function CheckData()
    If Trim(contMain.edtAcno.caption) == "" Or Trim(contMain.edtAcno.caption) == null Then
        '(순서주의) 포커스후->Alert처리해야함
       ' contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtAcno.top, "1"))
        Form.ShowAlert("오류", "계좌번호가 입력되지 않았습니다.")
        return False
    Else
        '이름 공백 체크
        sStr = Len(contMain.edtAcno.Caption)
        
        If sStr <> 8 Then
       '     contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtAcno.top, "1"))
            Form.ShowAlert("안내", "계좌번호 앞 8자리를 입력해주세요.")
            return False
        End If
    End If
	
    If Trim(contMain.edtPwd.caption) == "" Or Trim(contMain.edtPwd.caption) == null Then
        'contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtPwd.top, "1"))
        Form.ShowAlert("안내", "계좌비밀번호를 입력해주세요.")
        return False
	else
	    nLen = contMain.edtPwd.pwdlen
	   
	   if Cint(nLen) < 4 then
		   Form.ShowAlert("안내", "4자 이상 입력해주세요.")
		   return false
		   
	   elseif Cint(nLen) = 0 then
		   Form.ShowAlert("안내", "계좌비밀번호를 입력해주세요.")
		   return false
	   end if
    End If
    
    if Cint(g_logintype) > 1 then
    else
	    If Trim(contMain.edtBirth.caption) == "" Or Trim(contMain.edtBirth.caption) == null Then
		'(순서주의) 포커스후->Alert처리해야함
	       ' contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtAcno.top, "1"))
		'Form.ShowAlert("오류", "계좌번호가 입력되지 않았습니다.\n계좌번호를 먼저 입력해주세요.")
		return False
	    Else
		'이름 공백 체크
		sStr = Len(contMain.edtBirth.Caption)
		
		if Cint(sStr) < 6 then
			   Form.ShowAlert("안내", "생년월일 6자리를 입력해주세요.")
			   return false
			   
		elseif Cint(sStr) = 0 then
			   Form.ShowAlert("안내", "생년월일을 입력해주세요.")
			   return false
		 end if
	    End If
    end if
    
    return True

end Function 

