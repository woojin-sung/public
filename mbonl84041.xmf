		g_tmpRcno  	= DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "RLNM_ASCT_NO" , 0 )
		g_fullRcno  	= DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "RCNO_PIP" , 0 )
		g_custClsCode	= DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CUST_CLS_CODE" , 0 ) 'jsi 추가
		
		g_RCNO_TYPE_CODE	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO_TYPE_CODE", 0)	'SMJ 추가
		g_CUST_FULL_NAME	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_FULL_NAME", 0)	'SMJ 추가
		
		' SMJ 수정 ------------------------------------------------
		if Trim(g_ScrPoint) == "WRAP_MBWAT61020_P9" then
			Dim NTFR_CLS_CODE, RSDT_CLS_CODE
			NTFR_CLS_CODE = CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "NTFR_CLS_CODE", 0))
			RSDT_CLS_CODE = CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RSDT_CLS_CODE", 0))

			' 외국인 처리불가
			if NTFR_CLS_CODE <> 1 then
				Form.ShowAlert("안내", "외국인은 추가개설 불가합니다.")
				Form.CloseForm()
				
			' 비거주자 처리불가
			elseif RSDT_CLS_CODE == 2 then
				Form.ShowAlert("안내", "비거주자는 추가개설 불가합니다.")
				Form.CloseForm()
				
			' 법인 처리불가
			elseif g_custClsCode <> "1" then
				Form.ShowAlert("안내", "법인은 추가개설 불가합니다.")
				Form.CloseForm()
				
			else
				DATAMANAGER.RequestTranData("obacp_opop_066r")
			end if
			
		else
		' SMJ 수정 ------------------------------------------------
		
			'v001
			'jsi start 법인인 경우 657r로 바로 감
'			if g_custClsCode <> "1" then  
'				DATAMANAGER.RequestTranData("obcsb_oimf_657r")
'			else
				DATAMANAGER.RequestTranData("obacp_opop_073r")
'			end if 
			
		end if
		
	end if
	'***********************************************************************************************************************************
	
	' SMJ 수정 ------------------------------------------------
	if szTranID == "obacp_opop_066r" then
		Form.SetSharedData("mbonl84040_ACNO",			g_ACNT_NO_MBWAT61022)
		Form.SetSharedData("mbonl84040_PWD",				contMain.edtPwd.caption)
		Form.SetSharedData("mbonl84040_RCNO_TYPE_CODE", 	g_RCNO_TYPE_CODE)
		Form.SetSharedData("mbonl84040_RCNO_PIP", 		g_fullRcno)
		Form.SetSharedData("mbonl84040_CUST_FULL_NAME",	g_CUST_FULL_NAME)
		Form.SetSharedData("mbonl84040_CSNO", 			g_szCustNo)
		Form.SetSharedData("mbonl84040_MANG_BRCD", 		DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "MANG_BRCD", 0))
		Form.SetSharedData("&BACK_PRESS_ENABLE", 		"Y")
		
		Form.OpenNextPopup("mbonl84040", "", "")
	end if
	' SMJ 수정 ------------------------------------------------
	
End Sub

'v001 sta.
'============================================================================
' 보안매체별 화면오픈
'============================================================================
'Function SetSecurityOpen()
'	
'	'모바일OTP 인증화면에서
'	'로그아웃 상태에서 520r 서비스 input을 ID로 태우지 않기 위함
