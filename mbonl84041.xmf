Sub contMain_CmbAcnt_OnEditComplete(iIndex)
	contMain.edtAcno.caption = Left(contMain.CmbAcnt.caption,4) & Right(contMain.CmbAcnt.caption,4) '작대기 제거
	
	If g_Back_Flag <> "Y" and g_PwdKeyPad = True Then
		 Form.SetTimerEvent2(2, 1, 0.1)                     '0.1초뒤 보안키패드 활성화
     End If
End Sub
'20230612 KBC END


'============================================================================
'안드로이드에서 키패드 내릴 때 이벤트가 안타서
'에러 메시지 보여주기
'============================================================================
Sub contMain_btnAlpha_OnClick()
	 contMain.btnAlpha.visible = False
	 
'	 if g_szOSType == "2" then
'		 exit sub
'	 end if
	 
	 If contMain.edtAcno.caption ~= "" Or contMain.edtAcno.caption ~= null Then
		If Len(replace(contMain.edtAcno.caption, " " , "")) == 0 Then
		     contMain.edtAcno.SetResultLabel("1","error","계좌번호를 입력해주세요.","contMain")
		     Exit Sub
		Else
		    '이름 공백 체크
		    sStr = Len(contMain.edtAcno.Caption)
		    
		    If sStr <> 8 Then
				contMain.edtAcno.SetResultLabel("1","error","계좌번호 앞 8자리를 입력해주세요.","contMain")
				Exit Sub
		    End If
		End If
	 end if
	 
	 If contMain.edtPwd.caption == "" Or contMain.edtPwd.caption == null Then
		contMain.edtPwd.SetResultLabel("1","error","계좌비밀번호를 입력해주세요.","contMain")
		exit sub
	 else	   
	    
        nLen = contMain.edtPwd.pwdlen
	   
	   if Cint(nLen) == 0 then
		   contMain.edtPwd.SetResultLabel("1","error","계좌비밀번호를 입력해주세요.","contMain")
		   exit sub
	   end if
	   
	   if Cint(nLen) < 4 then
		   contMain.edtPwd.SetResultLabel("1","error","4자 이상 입력해주세요.","contMain")
		   exit sub
	   end if
	 end if
	 
	 If contMain.edtBirth.caption == "" Or contMain.edtBirth.caption == null Then
	    if contMain.edtPwd.caption <> "" and contMain.edtAcno.caption <> "" then
		    contMain.edtBirth.SetResultLabel("1","error","생년월일을 입력해주세요.","contMain")
		end if
	 else	
	    sStr = Len(contMain.edtBirth.Caption)
	    
	    if Cint(sStr) < 6 then
		   contMain.edtBirth.SetResultLabel("1","error","생년월일 6자리를 입력해주세요.","contMain")
	    end if
	 end if
	 
End Sub

'============================================================================
Sub contMain_edtAcno_OnClick()
	contMain.btnAlpha.visible = True
End Sub

