'============================================================================
Sub contMain_edtBirth_OnEditComplete() '생년월일
    nTop = 0
    nContResize = 0

    If contMain.edtBirth.caption == "" Or contMain.edtBirth.caption == null Then
	    if contMain.edtPwd.caption <> "" and contMain.edtAcno.caption <> "" then
		    contMain.edtBirth.SetResultLabel("1","error","생년월일을 입력해주세요.","contMain")
		end if
    else	
	    sStr = Len(contMain.edtBirth.Caption)
	    
	   if Cint(sStr) < 6 then
		   contMain.edtBirth.SetResultLabel("1","error","생년월일 6자리를 입력해주세요.","contMain")
		   exit sub
	  ' elseif Cint(sStr) == 0 then
		 '  contMain.edtBirth.SetResultLabel("1","error","생년월일을 입력해주세요.","contMain")
		  ' exit sub
	   end if
	   
        contMain.edtBirth.SetResultLabel("0","complete","","contMain")
	   
	   '확인버튼 활성화
	    btnNext.visible = True
	    btnNext.btnimage = "btn_20.9"
	    btnNext.fgcolor = "273"
		
	    btnNext_OnClick()
    End If
End Sub
'============================================================================
Sub contMain_edtPwd_OnClick()
	contMain.btnAlpha.visible = True
		
	If contMain.edtPwd.caption == "" Or contMain.edtPwd.caption == null Then
		if Cint(g_logintype) <= 1 then
		    if Len(replace(contMain.edtAcno.caption, " " , "")) == 0 then
			    'contMain.edtAcno.SetShowKeypad(false)
			    contMain.edtPwd.SetShowKeypad(false)
			    Form.MsgBox("안내", "계좌번호가 입력되지 않았습니다.\n계좌번호를 먼저 입력해주세요.", "edtpwd_click", 6)
			end if
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_opop_073r" then
		
		if Cint(g_logintype) > 1 then
			szBirth = left(g_tmpRcno,6)
		else
			szBirth = contMain.edtBirth.caption
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 		0, "2"			  	   )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 				0, contMain.edtAcno.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO", 				0, szBirth			   )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 			0, contMain.edtPwd.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE", 	0, g_MediaType		   )
	end if

'v001
'	if szTranID == "obcsb_oimf_657r" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO", 				0, g_szCustNo		  			 )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 				0, contMain.edtAcno.caption		   )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 			0, g_juminPip		   			)
'	end if
	
	
	'************************************************************************계좌 -> 고객번호 검색 후 비교************************************
	if szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 				0, contMain.edtAcno.caption	   )
	end if
	'*****************************************************************************************************************************************
	
	if szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 				0, contMain.edtAcno.caption	   )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD", 				0,  contMain.edtPwd.caption	   )
	end if

'v001
'	if szTranID == "obcsb_oimf_520r" then	
'		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_520r", "InBlock1", "INPUT_CLS", 0, "2" )
'		'DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"  , 0, "meritz" )
'		DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"  , 0, g_fullRcno)	
'	end if
	
	' SMJ 수정 ------------------------------------------------
	if szTranID == "obacp_opop_066r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 			0,	g_ACNT_NO_MBWAT61022)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNT_PWD", 		0,	contMain.edtPwd.caption)
	end if
	' SMJ 수정 ------------------------------------------------
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	if szTranID = "obcsb_acad_002r" then
		
		'전화번호정보
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "13" then '휴대폰
					ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					TONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					TELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					 Form.SetSharedData("Meritz_OTP_PhoneNum", ARCD & TONO & TELNO)
					
					'계좌개설 완료 -> 간편인증 바로 등록 시 사용하는 쉐어드 변수이므로
					'휴대폰인증 화면에서 먼저 클리어 해준다
					'계좌찾기 절차를 거치면 휴대폰인증 단계를 skip하므로 여기서 클리어
					Form.SetSharedData( "NMET_SIMPLE_ATHN" , "" )
					Form.SetSharedData( "NMET_OTP_ISNC_YN" , "" )
					Form.SetSharedData("MeritzAuth_Security" , "" )
					 
					'if g_Reuse == "Y" then
						Form.CloseForm()
					'else  
					'	DATAMANAGER.RequestTranData( "obcsb_oimf_520r" )
					'end if
				end if
			next
		end if
			
	end if
End Sub
