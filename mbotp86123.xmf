	<CONTROL_INFO>
		<LABEL name="Label3" fontsize="5" fontstyle="01" caption="모바일 OTP 다운로드" ly_vert="10,11,333,55,1" />
		<EDIT name="EdtPinPwd" enable="0" password="2" imetype="0" maxlength="6" hintcaption="숫자6자리 입력" imagefilepth="input_03.9" ly_vert="17,139,340,60,1" />
		<LABEL name="Label0" caption="모바일 OTP 비밀번호" ly_vert="23,111,228,23,1" />
		<BUTTON name="BtnNext" enable="0" caption="다   음" fgcolor="010:213049051" ly_vert="-3,559,382,48,1" />
		<ACCOUNT name="CmbAcnt" enable="0" visible="0" bgcolor="052:255255255" itemcodetype="100,101,102,103,104,105,106,107,108,109,110,112,113,114,115,117,118,119,120,121,123,124,125,126,127,128,129,130,131,132,133,134,135" totalacc="1" ly_vert="97,257,150,32,0" />
