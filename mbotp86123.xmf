	<SCRIPT_INFO _len="4530" _ulen="4432" >
'--===========================================================================
'--===========================================================================

Dim g_MsboVrsn
Dim g_MOTPSrno

'============================================================================
Sub Form_OnFormInit()
    EdtPinPwd.SetApplyLabel("숫자6자리 입력", 0, 76, "left", true)
    Form.requestMOTP("MOTP_GET_VERSION" , "" , "90021")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obcsb_oimf_170a" Then
        Form.OpenFramePopup("mbotp86124" , "" , "")
    End If
    
    If szTranID = "obcsb_oimf_172r" Then
    
        If DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MOTP_SRNO" , 0) == "" Then
            Form.MsgBox("OTP 정보 조회 오류" , "OTP 정보 없음" , "", 6)		    
        Else
            g_MOTPSrno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MOTP_SRNO" , 0)
            EdtPinPwd.enable = True
            BtnNext.enable = True
        End If
	
    End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "CLOSE_YN" Then
	
	    If sRet == "Y" Then
	        Form.CloseForm()
	    End If
	
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 

	Dim tmpList
	If sEventName == "MOTP_GET_VERSION_RET" Then ' M SafeBox 버전 정보 가져오기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
			
              DATAMANAGER.SetDataValue(0 , "obcsb_oimf_172r" , "InBlock1" , "ACNO"     , 0 , CmbAcnt.caption)
              DATAMANAGER.SetDataValue(0 , "obcsb_oimf_172r" , "InBlock1" , "RCNO_PIP" , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
              DATAMANAGER.RequestTranData("obcsb_oimf_172r")			
	      
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
		
	End If

End Sub

'============================================================================
Sub BtnNext_OnClick()


    If EdtPinPwd.caption == "" Then
        Form.MsgBox("알림" , "모바일 OTP 비밀번호를 입력해주세요" , "", 6)		    
    End If

    If g_MOTPSrno == "" Then
        g_MOTPSrno = "0"
    End If

    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "PROS_CLS_CODE"       , 0 , "I"                                     )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "CSNO"                , 0 , ""                                      )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "ACNO"                , 0 , CmbAcnt.caption                         )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "ACNT_PWD"            , 0 , ""                                      )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "MSBO_VRSN"           , 0 , g_MsboVrsn                              )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "CUST_TERM_ID"        , 0 , Form.GetDeviceID()                      )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "RCNO_PIP"            , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "MOTP_ATHN_DATA_CNTT" , 0 , EdtPinPwd.caption2                      )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "OS_CLCD"             , 0 , Form.GetSharedData("&OS_TYPE", False)   )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "OS_VRSN"             , 0 , Form.GetSharedData("&OS_VERSION", False))
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "CUST_TERM_NAME"      , 0 , Form.GetDeviceModel()                   )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "MOTP_DNLD_YN"        , 0 , "Y"                                     )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "MOTP_SRNO"           , 0 , CDBL(g_MOTPSrno)                        )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "APLT_DATE"           , 0 , ""                                      )
    DATAMANAGER.SetDataValue(0 , "obcsb_oimf_170a" , "InBlock1" , "APLT_SRNO"           , 0 , 0                                       )
    DATAMANAGER.RequestTranData("obcsb_oimf_170a")
	
End Sub


