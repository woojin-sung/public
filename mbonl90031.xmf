'****************************************************************************

'============================================================================
Sub Form_OnFormInit()	
	Dim szTab
	szTab = Form.GetEnvData("Bond365_News_Tab")
	if szTab <> "" and szTab <> null then
		FormTab0.currenttab = CInt(szTab)
	end if
	
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "INIT", FormTab0.currenttab)
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.SetEnvData("1", "Bond365_News_Tab", CStr(nCurrentTab))
	
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "CHANGE_TAB", nCurrentTab)
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("Refresh_News_Tab", "")
End Sub

