'============================================================================
'조건 그룹마다 선택되어 있는 상태를 배열에 설정해준다.
'iGroup : 조건그룹 1부터 시작
Sub f_setItemFlags(iGroup)
	Dim iIndex, iCount
	
	iGroupIndex = iGroup - 1	
	
	if g_sGroup[iGroupIndex] <> "99" then
		szData = Split(g_sGroup[iGroupIndex], "|")
		
		iCount = #szData 'UBOUND(szData)		
		
		for i=0 to iCount-1
			iIndex = CInt(szData(i))
			
			f_editGroupItemValue(iGroup, iIndex, True)
'			g_bGroup_Item[iGroupIndex][iIndex - 1] = True
		next
		
'		Form.ShowAlert("f_setItemFlags1", iGroup & "★" & g_sGroup[iGroupIndex] & "★" & 
'									  g_bGroup_Item[iGroupIndex][0] & " : " &
'									  g_bGroup_Item[iGroupIndex][1] & " : " &
'									  g_bGroup_Item[iGroupIndex][2] & " : " &
'									  g_bGroup_Item[iGroupIndex][3])
	end if	

end Sub

'============================================================================
'버튼들의 상태를 초기화 시킨다.
'iGroup : 필터 그룹 하나만 초기화   9: 전체 초기화
Sub f_setInitCtrls(iGroup)
	Dim iGroupIndex, iIndex
	
'	'초기화
	if CInt(iGroup) == 9 then
		for i=0 to g_iGroupCount - 1
			if i == 3 then
				if g_isETF then
					szGroupCtl = "cont0.group" & CStr(i+1) & "1"
				else
					szGroupCtl = "cont0.group" & CStr(i+1) & "2"				
				end if
				
			else
				szGroupCtl = "cont0.group" & CStr(i+1)
			end if
			
		
			for j=0 to g_Max_ItemCount[i]
				Form.SetCtlProp(szGroupCtl & ".Label" & CStr(j), "fgcolor", "146")
				Form.SetCtlProp(szGroupCtl & ".Label" & CStr(j), "fontstyle", "00")
'				Form.SetCtlProp(szGroupCtl & ".Image" & CStr(j), "imgpath", "input_03_n.9.png")
				Form.SetCtlProp(szGroupCtl & ".Image" & CStr(j), "imgpath", "btn_line2_n.9.png")
			next
		next
		
	else
		iGroupIndex = CInt(iGroup) - 1
		
		if iGroupIndex == 3 then
			if g_isETF then
				szGroupCtl = "cont0.group" & CStr(iGroupIndex+1) & "1"
			else
				szGroupCtl = "cont0.group" & CStr(iGroupIndex+1) & "2"				
			end if
			
		else
			szGroupCtl = "cont0.group" & CStr(iGroupIndex+1)
		end if
		
		for i=0 to g_Max_ItemCount[iGroupIndex] - 1
			Form.SetCtlProp(szGroupCtl & ".Label" & CStr(i+1), "fgcolor", "146")
			Form.SetCtlProp(szGroupCtl & ".Label" & CStr(i+1), "fontstyle", "00")
'			Form.SetCtlProp(szGroupCtl & ".Image" & CStr(i+1), "imgpath", "input_03_n.9.png")
			Form.SetCtlProp(szGroupCtl & ".Image" & CStr(i+1), "imgpath", "btn_line2_n.9.png")
		next
		
	end if
	
end Sub

'============================================================================
'조건 그룹별로 설정된 값으로 버튼상태를 바꾸어준다.
'배열에 저장된 값으로 버튼값  설정
Sub f_setCtrls(iGroup)
	Dim iGroupIndex, szGroupCtl
	
	if CInt(iGroup) == 9 then
		
		for i=0 to g_iGroupCount - 1
		
			'발행사/운용사 선택조건일 경우
			if i == 3 then
				if g_isETF then
					szGroupCtl = "cont0.group" & CStr(i+1) & "1"
				else
					szGroupCtl = "cont0.group" & CStr(i+1) & "2"				
				end if
			else
				szGroupCtl = "cont0.group" & CStr(i+1)
			end if
				
			Form.SetCtlProp(szGroupCtl & ".Label0", "fgcolor", "334")
			Form.SetCtlProp(szGroupCtl & ".Label0", "fontstyle", "01")
'			Form.SetCtlProp(szGroupCtl & ".Image0", "imgpath", "input_03_o.9.png")
			Form.SetCtlProp(szGroupCtl & ".Image0", "imgpath", "btn_line2_o.9.png")
		
			for j=0 to g_Max_ItemCount[i] - 1
				Form.SetCtlProp(szGroupCtl & ".Label" & CStr(j+1), "fgcolor", "146")
				Form.SetCtlProp(szGroupCtl & ".Label" & CStr(j+1), "fontstyle", "00")
'				Form.SetCtlProp(szGroupCtl & ".Image" & CStr(j+1), "imgpath", "input_03_n.9.png")
				Form.SetCtlProp(szGroupCtl & ".Image" & CStr(j+1), "imgpath", "btn_line2_n.9.png")
			next
		next
		
	else			
		iGroupIndex = CInt(iGroup) - 1
		if iGroup == 4 then
			if g_isETF then
				szGroupCtl = "cont0.group" & CStr(iGroup) & "1"
			else
				szGroupCtl = "cont0.group" & CStr(iGroup) & "2"				
			end if
		else
			szGroupCtl = "cont0.group" & CStr(iGroup)
		end if
		
		if g_sGroup[iGroupIndex] == "99" then
			Form.SetCtlProp(szGroupCtl & ".Label0", "fgcolor", "334")
			Form.SetCtlProp(szGroupCtl & ".Label0", "fontstyle", "01")
'			Form.SetCtlProp(szGroupCtl & ".Image0", "imgpath", "input_03_o.9.png")
			Form.SetCtlProp(szGroupCtl & ".Image0", "imgpath", "btn_line2_o.9.png")
			
		else		'선택항목 표시
'			Form.ShowAlert("f_setCtrls1", g_bGroup_Item[iGroupIndex][0] & " : " &
'										  g_bGroup_Item[iGroupIndex][1] & " : " &
'										  g_bGroup_Item[iGroupIndex][2] & " : " &
'										  g_bGroup_Item[iGroupIndex][3])

			Form.SetCtlProp(szGroupCtl & ".Label0", "fgcolor", "146")
			Form.SetCtlProp(szGroupCtl & ".Label0", "fontstyle", "00")
'			Form.SetCtlProp(szGroupCtl & ".Image0", "imgpath", "input_03_n.9.png")
			Form.SetCtlProp(szGroupCtl & ".Image0", "imgpath", "btn_line2_n.9.png")
			
			for i=0 to g_Max_ItemCount[iGroupIndex] - 1
				'발행사/운용사 선택조건일 경우
							
				if g_bGroup_Item[iGroupIndex][i] then
					Form.SetCtlProp(szGroupCtl & ".Label" & CStr(i+1), "fgcolor", "334")
					Form.SetCtlProp(szGroupCtl & ".Label" & CStr(i+1), "fontstyle", "01")
'					Form.SetCtlProp(szGroupCtl & ".Image" & CStr(i+1), "imgpath", "input_03_o.9.png")
					Form.SetCtlProp(szGroupCtl & ".Image" & CStr(i+1), "imgpath", "btn_line2_o.9.png")
				end if
			next
					
		end if
	end if

end Sub

'============================================================================
Sub f_groupTogle(szGroup, szItem)
'	Form.ShowAlert("groupTogle1", szGroup & ":" & szItem)
	'상세검색 선택값 저장
	
	Dim iGroup, iIndex, iValue
	
	iGroup = CInt(szGroup) - 1	
	g_sGroup[iGroup] = ""
	
	
	if szItem == "99" then   '전체를 선택했을 경우
'		Form.ShowAlert("groupTogle1", szGroup & ":" & iGroup & ":" & szItem)
		if CInt(szGroup) == 9 then
			for i=0 to g_iGroupCount - 1 
				for j=0 to g_Max_ItemCount[i] - 1
					g_bGroup_Item[i][j] = False
				next
				
				g_sGroup[i] = szItem
			next
			
		else
			for i=0 to g_Max_ItemCount[iGroup] - 1
				g_bGroup_Item[iGroup][i] = False
			next
	'		
			g_sGroup[iGroup] = szItem
		end if
		
	else
		'선택한 조건이 선택되어 있는지 값을 가지고 온다.
		iIndex = CInt(szItem) - 1
'		Form.ShowAlert("groupTogle1", iIndex & " : " & g_bGroup_Item[iGroup][iIndex] )

		'조건을 한개만 선택 가능하도록 변경
		for i = 0 to g_Max_ItemCount[iGroup]
			g_bGroup_Item[iGroup][i] = False
		next
		g_bGroup_Item[iGroup][iIndex] = True
		g_sGroup[iGroup] = szItem
		
'		--------------------------------------------------------------------------
		'조건을 중복 선택 가능하도록 설정
''		Form.ShowAlert("groupTogle1", iGroup & ":" & iIndex  & ":" & g_bGroup_Item[iGroup][iIndex])
'		g_bGroup_Item[iGroup][iIndex] = not g_bGroup_Item[iGroup][iIndex]
''		Form.ShowAlert("groupTogle4", g_bGroup_Item[iGroup][iIndex])
'					
'		for index, value in pairs(g_bGroup_Item[iGroup])
''			Form.ShowAlert("groupTogle5", index & ":" & value)
'			
'			if value == True then
'				if g_sGroup[iGroup] == "" then
'					'처음 선택된 경우
'					g_sGroup[iGroup] = index
'				else
'					'다른 선택이 있을 경우 문자열로 만들어준다.
'					g_sGroup[iGroup] = g_sGroup[iGroup] + "|" + index
'				end if
'			
'			end if			
'		next
'		--------------------------------------------------------------------------

'		Form.ShowAlert("groupTogle6", g_sGroup[iGroup])
	end if	
	
	f_setInitCtrls( CInt(szGroup) )
	f_setCtrls( CInt(szGroup) )
End Sub


'============================================================================
Sub cont0_btnSearch_OnClick()
	Dim szData
	
	for i=0 to g_iGroupCount - 1
		if g_sGroup[i] == "" or g_sGroup[i] == null then
			f_editGroupValue(i+1, "99")
		end if
	next
		
	szData = g_sGroup[0].."★"..g_sGroup[1].."★"..g_sGroup[2].."★"..g_sGroup[3]
	
'	Form.ShowAlert("Search_OnClick", szData)
	
	Form.SendReturnToParent("FILTER_CONDITION" , szData)
	Form.CloseForm()
End Sub


