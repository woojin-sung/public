'============================================================================
' 초기화 버튼
Sub btnClear_OnClick()
	for i=0 to g_iGroupCount-1
		g_sGroup[i] = "99"
	next
	
	g_bGroup_Item = {}
	for i=0 to g_iGroupCount-1
		g_bGroup_Item[i] = {}
		
		for j=0 to g_Max_ItemCount[i] - 1
			g_bGroup_Item[i][j] = False
		next
	next
	
	f_groupTogle(9, "99")
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Dim szData
	
	for i=0 to g_iGroupCount - 1
		if g_sGroup[i] == "" or g_sGroup[i] == null then
			f_editGroupValue(i+1, "99")
		end if
	next
	
	szData = g_sGroup[0].."★"..g_sGroup[1].."★"..g_sGroup[2].."★"..g_sGroup[3]
	
'	Form.ShowAlert("Search_OnClick", sData)
	
	Form.SendReturnToParent("FILTER_CONDITION" , szData)
	Form.CloseForm()
End Sub

