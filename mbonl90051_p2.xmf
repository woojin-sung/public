	<SCRIPT_INFO _len="23188" _ulen="21912" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ETN/ETF 상세검색 조건 입력 팝업
' 02. 화면설명 : 
' 03. 이    력 : 
'   2023.11.05 : 윤혁 : v0001 : 상세검색 팝업 신규 개발
'
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sGroup, g_sPrevGroup
Dim g_bGroup_Item

Dim g_iGroupCount
Dim g_Max_ItemCount

Dim g_SpclYn
Dim g_KycGrad
Dim g_ProsRslt
Dim g_invtYn
Dim g_isETF   'ETF,ETN여부

'각 그룹별로 선택된 값을 문자열값으로 연결해서 저장 (예 : 1|2|4|5)
g_sGroup = {}			'
g_sPrevGroup = {}		'조건값이 변경되었는지 확인하기 위해 처음 상태를 저장

'각 그룹별 필터조건 선택여부를 저장 그룹개수 x 필터조건 갯수의 2차원배열 
g_bGroup_Item= {}

'필터 그룹 갯수
g_iGroupCount = 4

'그룹안에 있는 선택 조건 최대 갯수 (전체버튼은 제외)
g_Max_ItemCount = {3, 8, 6, 13}

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'배열 첨자로 접근하여 값을 수정하려고 하면면 main 에서 오류 발생해서 앱이 죽는다.
'해당 위치의 값을 삭제한 후 다시 그 위치로 insert 시켜준다.
'배열 첨자로 접근시는 0 부터 시작 g_sGroup[0]
'table.remove, insert 함수에서 사용시는 1부터 시작
Sub f_editGroupValue(iIndex, szValue)
	table.remove(g_sGroup, iIndex)
	table.insert(g_sGroup, iIndex, szValue)
end Sub

Sub f_editGroupItemValue(iGroupIndex, iIndex, szValue)
	table.remove(g_bGroup_Item[iGroupIndex - 1], iIndex)
	table.insert(g_bGroup_Item[iGroupIndex - 1], iIndex, szValue)
	
end Sub

'============================================================================
Sub cont0_imgClose_OnClick()
	btnClose_OnClick()
End Sub

'============================================================================
Sub cont0_btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
'	imgDim.setMaintainingRatio("1")
'	imgTitle.setMaintainingRatio("1")
'	imgClose.setMaintainingRatio("1")
'	
'	cont0.group1.Image0.setMaintainingRatio("1")
'	cont0.group1.Image1.setMaintainingRatio("1")
'	cont0.group1.Image2.setMaintainingRatio("1")
'	cont0.group1.Image3.setMaintainingRatio("1")
'	cont0.group1.Image4.setMaintainingRatio("1")
'	
'	cont0.group2.Image0.setMaintainingRatio("1")
'	cont0.group2.Image1.setMaintainingRatio("1")
'	cont0.group2.Image2.setMaintainingRatio("1")
'	cont0.group2.Image3.setMaintainingRatio("1")
'	cont0.group2.Image4.setMaintainingRatio("1")
'	
'	cont0.group3.Image0.setMaintainingRatio("1")
'	cont0.group3.Image1.setMaintainingRatio("1")
'	cont0.group3.Image2.setMaintainingRatio("1")
'	cont0.group3.Image3.setMaintainingRatio("1")
'	cont0.group3.Image4.setMaintainingRatio("1")
'	
'	cont0.group4.Image0.setMaintainingRatio("1")
'	cont0.group4.Image1.setMaintainingRatio("1")
'	cont0.group4.Image2.setMaintainingRatio("1")
'	cont0.group4.Image3.setMaintainingRatio("1")
'	cont0.group4.Image4.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
'	Form.SetScreenName("상세조건 선택")
	
	Dim szData	
	
	for i=0 to g_iGroupCount-1
		table.insert(g_sGroup, "99")
		table.insert(g_sPrevGroup, "99")
	next

	g_bGroup_Item = {}
	for i=0 to g_iGroupCount-1
		g_bGroup_Item[i] = {}
		for j=0 to g_Max_ItemCount[i]-1
			g_bGroup_Item[i][j] = False
		next
	next
		
	f_setInitCtrls(9)
	
	szData = Form.GetOpenLinkData()
	'ETF/ETN★1번그룹 선택조건★2번그룹 조건★3번그룹조건★4번그룹조건
'	szData = "1★1|2★99★3|4★5|6"
'	Form.ShowAlert("FormInit1", szData)
	if szData == "" then
		Exit Sub
	end if
	
	if szData <> "" then
		tData = Split(szData, "★")
		
		
		if tData(0) == "1" then			
			'ETF 일경우 캡션명 운용사선택으로 변경
			g_isETF = True
			cont0.group41.visible = True
			cont0.group42.visible = False
			
			'3배 레버리지 안보이게
			cont0.group3.Image5.visible = False
			cont0.group3.Image6.visible = False
			cont0.group3.Label5.visible = False
			cont0.group3.Label6.visible = False	
		
		else
			'ETN 일경우 캡션명 발행사선택으로 변경
			g_isETF = False
			cont0.group41.visible = False
			cont0.group42.visible = True
			
			'3배 레버리지 보이게
			cont0.group3.Image5.visible = True
			cont0.group3.Image6.visible = True
			cont0.group3.Label5.visible = True
			cont0.group3.Label6.visible = True
			
		end if
		
		for i=0 to g_iGroupCount - 1
			g_sGroup[i] = tData(i+1)
			g_sPrevGroup[i] = tData(i+1)
		next
		
'		'sData = sSpclYn.."★"..sKycGrad.."★"..sProsRslt.."★"..invtYn
'		'1:전문투자자여부
'		'2:일임KYC코드
'		'3:투자성향결과코드
'		'4:투자성향맞춤여부
'		
'		g_SpclYn   = g_tData(0)		' 전문투자자여부
'		g_ProsRslt = g_tData(2)		' 투자성향결과코드
'		g_invtYn   = g_tData(3)		' 투자성향맞춤여부
'		
'		if g_tData(0) = "Y" then
'			g_KycGrad  = "99"			' 일임KYC코드
'		else
'			if g_tData(3) = "Y" and g_tData(1) <> "" and int(g_tData(1)) <> 0 and g_tData(1) <> null then
'				g_KycGrad  = g_tData(1)	' 일임KYC코드
'			else
'				g_KycGrad  = "99"			' 일임KYC코드
'			end if
'		end if
'		
'	else
'		g_SpclYn   = "N"
'		g_KycGrad  = "99"
'		g_ProsRslt = ""
	end if
		
	'각 그룹마다 선택된 항목 기억
	f_setItemFlags(1)
	f_setItemFlags(2)
	f_setItemFlags(3)
	f_setItemFlags(4)
	
'	Form.ShowAlert("FormInit2", g_bGroup1_Item1 & ":" &
'						    g_bGroup1_Item2 & ":" &
'						    g_bGroup1_Item3 & ":" &
'						    g_bGroup1_Item4)
	'각 그룹마다 선택된 항목 표시
	f_setCtrls(1)
	f_setCtrls(2)
	f_setCtrls(3)
	f_setCtrls(4)
	
