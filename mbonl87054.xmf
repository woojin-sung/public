' 04. 수    정 : 2021.01.18 : 김효준 : v001: 신규 ( [7457]해외주식 거래신청 - mbonl87051 참조)
' 05. 수    정 : 2023.01.06 : 강희승 : v002: 수정 talk_yk52.pdf 파일명 및 경로변경
'                2023.02.20 : 양현정 : v003 경로수정
'                2023.10.27 : 전상일 : v004 비밀번호 클리어 로직 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_Csno
Dim	g_Acno
Dim	g_Asno
Dim	g_nPassword
Dim	g_AprvYN 
	g_AprvYN = ""
Dim	g_SvcSrno 
	g_SvcSrno = 0 
Dim	g_CustEngName
	g_CustEngName = ""
Dim	g_ProsYn
	g_ProsYn = ""
Dim	g_NewEngName
	g_NewEngName = ""
Dim	g_URLheader 'v0002
Dim	g_ProsCls
	g_ProsCls = ""
Dim	g_CustClsCode 	  'v0001
	g_CustClsCode = ""
Dim	g_PlainRm  'v005
	
Dim g_MargGradCode
    g_MargGradCode   = "" '증거금등급코드
Dim g_MargGradCodeNm
    g_MargGradCodeNm = "" '증거금등급명
    
Dim g_szFnprJoinSrno		'금융상품일련번호
Dim g_szSvcSrno			'서비스일련번호
    
'v0001 아래 obcsb_acif_000r OutBlock 변수 주석처리
'Dim	g_NtntCtcd			'국적국가
'	g_NtntCtcd = ""
'Dim	g_RsdcNtnlTxrtCode 	'거주국가
