'Dim	g_LscClcd 			'양력구분 slcn_cls_code
'	g_LscClcd = ""
'Dim	g_Brdt				'생년월일
'	g_Brdt = ""
'Dim	g_WdngDate			'결혼 일자
'	g_WdngDate = ""
'Dim	g_BrthCtcd			'출생국가코드
'	g_BrthCtcd = ""
'Dim	g_AmrcYn				'미국인 여부
'	g_AmrcYn = ""
'Dim	g_AmlBstpLrdvCode		'AML업종대분류코드
'	g_AmlBstpLrdvCode = ""
'Dim	g_AmlBstpSmdvCode		'AML업종소분류코드
'	g_AmlBstpSmdvCode = ""
'Dim	g_Giin				'GIIN
'	g_Giin = ""	
'Dim	g_Lstn_yn			'상장여부
'	g_Lstn_yn = ""
'Dim	g_OvrsTxpmChdYn		'해외납세자여부
'	g_OvrsTxpmChdYn = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 컨트롤 초기화
'============================================================================
Function ClearCnt()
	
	g_AprvYN 			= ""
	g_SvcSrno 			= 0
	g_ProsCls 			= ""
	g_szSvcSrno			= ""
	g_szFnprJoinSrno		= ""
	'v0001
'	g_NtntCtcd 			= ""
'	g_RsdcNtnlTxrtCode	= ""
'	g_LscClcd 			= ""
'	g_Brdt 				= ""
'	g_WdngDate 			= ""
'	g_BrthCtcd 			= ""
'	g_AmrcYn 			= ""
'	g_AmlBstpLrdvCode 	= ""
'	g_AmlBstpSmdvCode 	= ""
'	g_Giin 				= ""	
'	g_Lstn_yn 			= ""
'	g_OvrsTxpmChdYn 		= ""
	
'	g_nPassword 			= Form.GetEncData(edtPassword.caption) 'v005
	'v005
	If g_PlainRm = "1" Then
		g_nPassword 	= edtPassword.caption
	Else
		g_nPassword 	= Form.GetEncData(edtPassword.caption)
	End If

	edtSrno.caption 		= ""
	
	tblState.SetCellString(0, 1, "")
	
	btnEnroll.enable 	= False
	btnEnroll.visible	= True
	btnCancle.enable	= False
	btnCancle.visible	= False
	
	'서류제공방식선택 추가
	btnProvision.enable = false
	btnModiTel.enable = false
	chkProvision.checkstate = "0"
	
	'약관체크박스
	ChkView0.chksilence = "0"
	ChkView1.chksilence = "0"
'TODO	ChkView2.chksilence = "0"
'TODO	ChkView3.chksilence = "0"
	g_CustClsCode = "" 'v0001
	
End Function
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	edtPassword.caption = "" 'v004
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	btnEnroll.enable 	= True     
	btnEnroll.visible	= True
	btnCancle.enable 	= False
	btnCancle.visible	= False
	
	'서류제공방식선택 추가
	btnProvision.enable = false
	btnModiTel.enable = false
	chkProvision.checkstate = "0"
		
	g_Acno 		= Left(cmbAccount.caption, 8)
	g_Asno 		= Right(cmbAccount.caption, 2)
'	g_nPassword 	= Form.GetEncData(edtPassword.caption) 'v005
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	'v005
	If g_PlainRm = "1" Then
		g_nPassword 	= edtPassword.caption
	Else
		g_nPassword 	= Form.GetEncData(edtPassword.caption)
	End If
	
	'계좌고객 정보 조회 v004
	DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_Acno)
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub
'============================================================================
Sub edtPassword_OnEditComplete()
'	g_nPassword = Form.GetEncData(edtPassword.caption) 'v005
	'v005
	If g_PlainRm = "1" Then
		g_nPassword 	= edtPassword.caption
	Else
		g_nPassword 	= Form.GetEncData(edtPassword.caption)
	End If

	
	'계좌고객 정보 조회
	DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_Acno)
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obacp_opop_064r" Then
		g_Csno		= DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		

		'통합증거금 약정 조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "081")	
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	
	ElseIf szTranID == "obpds_srvc_323r" Then
		g_AprvYN		= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0)
		g_SvcSrno	= cdbl(edtSrno.caption)
		
				
		If g_AprvYN = "Y" and g_SvcSrno > 0 Then
			tblState.SetCellString(0, 1, "등록")
			btnEnroll.enable 	= False
			btnEnroll.visible	= False
			btnCancle.enable	= True
			btnCancle.visible	= True
			
			'서류제공방식선택 추가
			btnProvision.enable = false
			btnModiTel.enable = false
			chkProvision.checkstate = "0"
			
			'약관체크박스
			ChkView0.chksilence = "1"
			ChkView1.chksilence = "1"
		ElseIf g_AprvYN = "N" and g_SvcSrno > 0 Then
			tblState.SetCellString(0, 1, "등록")
			btnEnroll.enable	= False
			btnEnroll.visible	= False
			btnCancle.enable	= True
			btnCancle.visible	= True
			
			'서류제공방식선택 추가
			btnProvision.enable = false
			btnModiTel.enable = false
			chkProvision.checkstate = "0"
			
			'약관체크박스
			ChkView0.chksilence = "1"
			ChkView1.chksilence = "1"
		Else
			tblState.SetCellString(0, 1, "미등록")
			btnEnroll.enable	= True
			btnEnroll.visible	= True
			btnCancle.enable	= False
			btnCancle.visible	= False
			
			'서류제공방식선택 추가
			btnProvision.enable = true
			btnModiTel.enable = true
			chkProvision.checkstate = "0"
			
			'약관체크박스
			ChkView0.chksilence = "0"
			ChkView1.chksilence = "0"
		End If
		
		'통합증거금 약정 조회
	    DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "CSNO" , 0 , g_Csno)	
	    DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ACNO" , 0 , g_Acno)	
	    DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ASNO" , 0 , g_Asno)	
	    DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "SVCD" , 0 , "082")	
	    DATAMANAGER.RequestTranData("obpds_srvc_323r_1")
	
	'해외주식신청약정 조회
	ElseIf szTranID == "obpds_srvc_323r_1" Then	
		g_MsgCode = DATAMANAGER.GetDataMsgCode("obpds_srvc_323r_1")
		
	    If g_MsgCode = "5766" Then
			Table0.SetCellString(0, 1, "등록")
		Else
			Table0.SetCellString(0, 1, "미등록")
		End If
		
		DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obacp_comm_008r", "InBlock1", "ACNT_PWD" , 0 , g_nPassword)
		DATAMANAGER.RequestTranData("obacp_comm_008r")
		
	ElseIf szTranID == "obacp_comm_008r" Then 
		g_MargGradCode = DATAMANAGER.GetDataValue(0, "obacp_comm_008r", "OutBlock1", "MARG_GRAD_CODE" , 0)
		
		If Trim(g_MargGradCode) = "1" Then
			Table1.SetCellString(0, 1, "40%징수")
		ElseIf Trim(g_MargGradCode) = "3" Then
			Table1.SetCellString(0, 1, "100%징수(수수료미포함)")
		ElseIf Trim(g_MargGradCode) = "4" Then
			Table1.SetCellString(0, 1, "100%징수(수수료포함)")
		ElseIf Trim(g_MargGradCode) = "6" Then
			Table1.SetCellString(0, 1, "기본(종목별차등)")
		ElseIf Trim(g_MargGradCode) = "6" Then
			Table1.SetCellString(0, 1, "특별증거금(우대)")
		End If
	    
	ElseIf szTranID == "obpds_srvc_045a" Then
		
		If g_ProsCls == "I" Then
			Form.ShowAlert( "알림" , "등록이 완료되었습니다.")
			
			'서비스일련번호
			g_szSvcSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO", 0)
			g_szSvcSrno = tonumber(g_szSvcSrno)
			g_szSvcSrno = tostring(g_szSvcSrno)
			
			'계약서류교부처리(계좌고객상품)
		    DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )
			
		ElseIf g_ProsCls == "D" Then
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
		End If
		
		ClearCnt()
		
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "081")	
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	
	ElseIf szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
			
		If g_szFnprJoinSrno <> "" Then
			Form.OpenPopup("mbonl81010_p16" , g_Acno & "★" & g_szFnprJoinSrno, "")
		End If
	
	End If
End Sub
'============================================================================
Sub btnEnroll_OnClick()
	
	If g_CustClsCode == "2" Then 'v0001
		Form.MsgBox("알림", "법인고객은 영업점 내점으로만 약정이 가능합니다.", "", 0)
		Call ClearCnt()
		Exit Sub
	End If
	If ChkView0.chksilence == "0" Then
		Form.MsgBox("알림", "통합증거금 서비스 약관 내용을 확인해주세요.", "", 0)
		Exit Sub
	End If
	If ChkView1.chksilence == "0" Then
		Form.MsgBox("알림", "통합증거금 서비스 설명서 내용을 확인해주세요.", "", 0)
		Exit Sub
	End If
	If Table0.GetCellString(0, 1) == "" Then
		Form.MsgBox("알림", "고객영문명을 확인해주세요.", "", 0)
		Exit Sub
	End If
	If chkProvision.checkstate == "0" Then
		Form.ShowAlert( "알림" , "서류 제공방식을 선택하세요.")
		Exit Sub
	End If
	
	If g_nPassword <> "" and Trim(edtPassword.caption) <> "" then
		If tblState.GetCellString(0, 1) == "미등록" Then
			'Dim sSendData 
			'sSendData = "87051" & "★" & g_Acno & "★" & g_Asno & "★" & edtPassword.caption & "★" & "082" 
			'Form.OpenPopup("mbonl81010_p1" , sSendData , "")
			
			g_ProsCls = "I"
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE"		, 0 , "I")			'처리구분(I등록)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" 			, 0 , g_nPassword)	'계좌비밀번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" 				, 0 , g_Csno)			'고객번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNO" 				, 0 , g_Acno)			'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ASNO" 				, 0 , g_Asno)			'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" 				, 0 , "081")			'서비스 코드
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO"			, 0 , g_SvcSrno)		'서비스 일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")			'서비스 관리 단위코드(03상품)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
			
			DATAMANAGER.RequestTranData("obpds_srvc_045a")
		Else
			Form.MsgBox("알림", "이미 등록된 약정입니다.", "", 0)
			g_nPassword = ""
			edtPassword.caption = ""
		End if
	Else
		Form.MsgBox("알림", "비밀번호를 확인해주세요.", "", 0)
		Exit Sub
	End If
End Sub
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_Acno = Left(cmbAccount.caption, 8)
	g_Asno = Right(cmbAccount.caption, 2)
	
	Call ClearCnt()
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	If szTranID == "obpds_srvc_323r" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Call ClearCnt()
	Else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	End If
	
End Sub

