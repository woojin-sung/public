	</CONTROL_INFO>
	<SCRIPT_INFO _len="950" _ulen="950" >


'============================================================================
Sub btnOk_OnClick()
	Form.SendReturnToParent("mbbdm85131_p5" , "OK")
	Form.CloseForm()
End Sub

'============================================================================
Sub btnQuit_OnClick()
	Form.SendReturnToParent("mbbdm85131_p5" , "QUIT")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
'	szOpenData = "NEW"
	If szOpenData <> "" And szOpenData <> null And szOpenData == "NEW" Then
		btnQuit.visible = false
		btnOk.visible = false
		btnOk2.visible = true
		
		imgBg.height = 165
		
		tblInfo.SetCellString(3, 0, "")
	End If
End Sub

'============================================================================
Sub btnOk2_OnClick()
	Form.SendReturnToParent("mbbdm85131_p5" , "OK")
	Form.CloseForm()
End Sub

