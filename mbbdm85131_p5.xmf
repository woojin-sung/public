		<BUTTON name="btnQuit" caption="다음에 개설하기" fgcolor="004:000000000" fontsize="2" btnimage="btn_25.9" ly_vert="32,380,157,60,1" />
		<BUTTON name="btnOk" caption="예" fontsize="2" btnimage="btn_26.9" ly_vert="189,380,156,60,1" />
