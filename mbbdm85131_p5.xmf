<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="85131" scrname="Wrap계좌개설안내팝업" version="2" writer="이은섭" />
	<FORM_INFO name="Form" transmode="0" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBack" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg_common.9" ly_vert="32,207,312,231,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="안내" halign="1" ly_vert="52,231,275,32,1" />
		<TABLE name="tblInfo" insidelinecolor="102:255255255" colcount="1" rowcount="6" outline="0000" designorder="1" ly_vert="33,275,306,90,1" >
			<COL_INFO ly_vert_width="306" />
			<ROW_INFO ly_vert_height="10,10,20,10,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,1" line="0,0" caption="Wrap 계좌 개설 시 입금을 위한 별도 계좌" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="(종합매매 또는 CMA)를 개설해야 합니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" caption="개설상품 선택화면으로 이동하시겠습니까?" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,5,0,5" halign="0" line="0,0" fontsize="-2" impidxs="" />
