<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="16052" scrname="ADR검색_공지사항" version="2" writer="이재원" />
	<FORM_INFO name="Form" acecnt="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fgcolor="062:255255255" fontsize="6" fontstyle="01" caption="유의사항" bgcolor="064:181181181" transmode="0" halign="1" paddinginfo="20,0,0,0" ly_vert="0,0,375,40,1" />
		<IMAGE name="ImgClose" autosize="1" imgpath="icon_main_11" ly_vert="338,6,28,28,1" />
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="338,6,28,28,1" />
		<CONTAINER name="Container0" vscroll="1" scroll_pos="0,0" ly_vert="0,40,375,607,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="Label1" caption="ADR 특성 및 콘텐츠 안내" autofontsize="1" ly_vert="15,9,302,20,1" />
				<LABEL name="Label2" fontsize="-2" caption="Ⅰ. 미국주식예탁증서, ADR(American Depository Receipt)이란?" multiline="1" ly_vert="6,33,363,32,1" />
				<LABEL name="Label3" fontsize="-2" caption="특정 국가의 기업이 해외 증권거래소에 주식을 직접 상장 하는 경우 발생되는 비용 및 유통상의 여러 가지 문제점을 고려하여 원주는 본국에 소재한 금융 기관에 보관하고, 해외의 투자자에게는 원주에 대한 소유권을 인정하는 표시로서 발행해 주는 증서를 DR 이라고 합니다. American DR은 미국 외 국가에 소재한 기업이 주식을 미국시장에 상장하여 유통시키는 증권을 말합니다.
" multiline="1" ly_vert="6,67,363,112,1" />
				<LABEL name="Label4" fontsize="-2" caption="Ⅱ. ADR 투자 안내" ly_vert="6,184,363,20,1" />
				<LABEL name="Label5" fontsize="-2" caption="이머징 마켓 등 미국 외 국가에 투자 하고 싶지만 직접 투자가 어려운 경우 유용하게 사용될 수 있는 투자 도구이다. ADR은 전세계 투자자를 상대로 거래 되기 때문에 유동성이 뛰어난 편이며 이러한 장점에 따라 ADR 거래량은 늘어나고 있는 추세입니다." valign="0" multiline="1" ly_vert="6,206,363,80,1" />
				<LABEL name="Label6" fontsize="-2" caption="Ⅲ. ADR 수수료" ly_vert="6,291,363,20,1" />
				<LABEL name="Label7" fontsize="-2" caption="DR Depository는 증권수탁소에 수수료 납부를 위해 기준일 당시 해당 증권의 보관기관인 여신 은행에 납부를 요청하고 여신은행은 한국예탁결제원의 계좌에서 수수료 금액을 차감하며 증권사는 이를 고객계좌에서 출금합니다. 이 수수료는 ADR발행회사와 ADR관리기관 사이의 ADR서비스계약에 의하여 부과하는 수수료이며 통상적으로 주당 USD 0.02가 부가 되나 종목마다 상이 할 수 있습니다." valign="0" multiline="1" ly_vert="6,313,363,112,1" />
				<LABEL name="Label8" fontsize="-2" caption="Ⅳ. ADR 프리미엄/디스카운트 산출 방식 및 의미" ly_vert="6,430,363,20,1" />
				<LABEL name="Label9" fontsize="-2" caption="- 환산가
= (ADR현재가($) X 원주당DR수) X 환율
- ADR 프리미엄(+)/디스카운트(-) (%)
= (환산가/원주가 -1) X 100%
- ADR 프리미엄(+)/디스카운트(-)를 통해 ADR이 원주에 비해 어느 정도의 마진에서 거래 되는지 알 수 있습니다.
- 프리미엄(+): ADR 환산가가 원주의 가격 보다 높을 때를 말하며 이는 원주에 비해 ADR이 고평가 되어 있다는 것을 뜻합니다.
- 디스카운트(-): ADR 환산가가 원주의 가격 보다 낮을 때를 말하며 이는 원주에 비해 ADR이 저평가 되어 있다는 것을 뜻합니다.
" valign="0" multiline="1" ly_vert="6,452,363,185,1" />
				<LABEL name="Label10" fontsize="-2" caption="V.대한민국/홍콩 ADR
" ly_vert="6,642,363,20,1" />
				<LABEL name="Label11" fontsize="-2" caption="- 일반적으로 ADR 종목의 원주는 본국에 소재한 거래소에서 거래가 되나 일부 종목들 (특히 대다수의 중국 ADR)은 직상장이며 본국에서 거래가 되지 않습니다. 따라서 원주가 거래되지 않는 종목들은 제외 하였습니다.
- 중국 ADR 원주 중 실거래 종목은 홍콩거래소에 상장되어 있는 H주이며 '홍콩/H주'탭 에서 확인 할 수 있습니다.
" valign="0" multiline="1" ly_vert="6,664,363,112,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="138" _ulen="138" >

