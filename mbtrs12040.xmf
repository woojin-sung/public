'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	'szData = rdoCNTG.currentindex & "|" & rdoMedosu.currentindex
	szData = rdoCNTG.currentindex & "|" &  Combo0.currentindex & "|" & calOderDate.caption

	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrs12040_h0" , szData , "" )
		
	ElseIf sEventName = "RECEIVE" Then
		btnSearch_OnClick()
		
	ElseIf sEventName = "CHANGE_ACCTNO" Then
		btnSearch_OnClick()
		
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbtrs12040" Then
		Dim arrData, szACNO
	
		szACNO = Form.GetCtlProp("#acnt0", "caption")
	
		arrData = Split(sRet,"|")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if
		
		rdoCNTG.currentindex 	= arrData(0)
		Combo0.currentindex	= arrData(1)
		calOderDate.caption    = arrData(2)
		
		If szACNO <> arrData(2) Then
			Form.SetCtlProp( "#acnt0", "caption", arrData(2) )
		Else
			btnSearch_OnClick()
		End If
		
	ElseIf sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		
		if g_szLoanDate <> "" and g_szLoanCd = "0000" then
			if	szListItems(1)	=	"0"	then			'현재가
				Form.OpenScreen("11000" , g_szItemCode & "★" & "0") 
			elseif	szListItems(1)	=	"1"	then		'정정
				Form.OpenScreen("12060" , "미체결" & "★" & "1" & "★" & g_szData ) 
			elseif 	szListItems(1)	=	"2"	then		'취소
				Form.OpenScreen("12060" , "미체결" & "★" & "2" & "★" & g_szData ) 
			end if
		else
			if	szListItems(1)	=	"0"	then			'현재가
				Form.OpenScreen("11000" , g_szItemCode & "★" & "0") 
			elseif	szListItems(1)	=	"1"	then		'정정
				Form.OpenScreen("12000" , "미체결" & "★" & "2" & "★" & g_szData ) 
			elseif 	szListItems(1)	=	"2"	then		'취소
				Form.OpenScreen("12000" , "미체결" & "★" & "3" & "★" & g_szData ) 
			end if

		end if

		
		g_szData = ""
	ElseIf sKeyName = "12000_CLOSE" then
		btnSearch_OnClick()
	End If
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemCode, szOdrNo, szQty, szOdrType, szOdrPrc, szClsCd
	Dim szCutCd, szMk

	g_szItemCode	=	grd0.GetCellData("bd_cell14", lRow)

	listLocation =  Split(grd0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
		
	sPopupType = "4"
	
	szItemCode	= grd0.GetCellData("bd_cell14", lRow)
	szOdrNo		= grd0.GetCellData("bd_cell1", lRow)
	szQty		= grd0.GetCellData("bd_cell8", lRow)
	szOdrType	= grd0.GetCellData("bd_cell15", lRow)
	szOdrPrc		= grd0.GetCellData("bd_cell4", lRow)
	szClsCd		= grd0.GetCellData("bd_cell16", lRow)
	g_szLoanDate    = grd0.GetCellData("bd_cell12", lRow)
	g_szLoanCd      = grd0.GetCellData("bd_cell19", lRow)
	
	szMk = Form.GetItemCodeInfo(szItemCode, "market")
	If Trim(szMk) = "J" or Trim(szMk) = "Q" or Trim(szMk) = "W" or Trim(szMk) = "T" then
		' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
		' 전달내용, 탭위치는 리턴받아서 처리함.	
		g_szData = szItemCode & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
	
		If CInt( szQty ) > 0 Then
			Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "미체결수량: " & CInt( szQty ) & "★" & "정정" & "★" & "취소" & "★" & "" & "★" & "" & "★" & g_szItemCode)	
		End If
	Else
		' 20160310 주문불가한 종목 예외처리
		szCutCd = Mid(szItemCode, 2, Len(szItemCode))
		szMk = Form.GetItemCodeInfo(szCutCd, "market")		

		If Trim(szMk) = "J" or Trim(szMk) = "Q" or Trim(szMk) = "W" or Trim(szMk) = "T" then
			' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
			' 전달내용, 탭위치는 리턴받아서 처리함.	
			g_szData = szItemCode & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
		
			If CInt( szQty ) > 0 Then
				Form.OpenPopup("movepopup3" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "미체결수량: " & CInt( szQty ) & "★" & "정정" & "★" & "취소" & "★" & "" & "★" & "" & "★" & g_szItemCode)	
			End If
		Else
			Form.ShowAlert(g_szTitle, "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
		End if
	End If
	
End Sub

