dim ods_tmp_prtf
dim ods_tmp_srno

'============================================================================
Sub Form_OnFormInit()

	type_flag = 0
	
	Edit2.visible = 0
	Calendar0.visible = 0
	Combo1.visible = 0
	Combo2.visible =0
	Combo3.visible =0
	
	Label0.visible = 0
	
	Label1.visible =0
	
	
	Table1.SetCellFgColor(0,0,"92")
	
	
	
	
	

     szData = Form.GetOpenLinkData()
	szList = Split(szData,"●")	
	
	Table0.SetCellString(0, 1, szList(0)) '주소
	
	Edit2.caption = szList(0)
	Table0.SetCellString(1, 1, szList(1)) '예약날짜
	Table0.SetCellString(2, 1, szList(2)) '예약시간
	Table0.SetCellString(3, 1, szList(3)) '담당직원
	
	
	ods_tmp_prtf = szList(4) '포트폴리오 아이디
	ods_tmp_srno = szList(5) '예약일련번호
	
	'Form.MsgBox("테스트", szList(6), "", "")
	
	'szData = Form.GetOpenLinkData()
	'szList = Split(szData,"●")	
	
	'Label1.caption = szList(0)
	'Label2.caption = szList(1)
End Sub

'============================================================================


'============================================================================


'============================================================================
Sub Table1_OnClick(lRow , lColumn)

Table1.SetCellFgColor(0,0, "92")
Table2.SetCellFgColor(0,0, "89")

Table0.SetCellFgColor(0, 1, "89")
	Table0.SetCellFgColor(1, 1, "89")
	Table0.SetCellFgColor(2, 1, "89")

	Edit2.visible = 0
	Calendar0.visible = 0
	Combo1.visible = 0
	
	Label0.visible = 0
	
	Label1.visible =0
	Combo2.visible =0
	Combo3.visible =0
	
	
	type_flag = 0
	
End Sub

'============================================================================
Sub Table2_OnClick(lRow , lColumn)


	Table1.SetCellFgColor(0,0, "89")
	Table2.SetCellFgColor(0,0, "92")
	
	Table0.SetCellFgColor(0, 1, "90")
	Table0.SetCellFgColor(1, 1, "90")
	Table0.SetCellFgColor(2, 1, "90")

	Edit2.visible = 1
	Calendar0.visible = 1
	Combo1.visible = 1
	
	Label0.visible = 1
	
	Label1.visible =1
	Combo2.visible =1
	Combo3.visible =1
	
	
	type_flag = 1
	
End Sub

'============================================================================
Sub Button0_OnClick()

     'ods 예약취소
	if type_flag == 0 then
	
	DATAMANAGER.SetEventFlag("obcpp_intr_758a", "I")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "ADDR" , 0 , Table0.GetCellString(0, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_DATE" , 0 , Table0.GetCellString(1, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Table0.GetCellString(2, 1))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "RSNS_EMPNO" , 0 , Table0.GetCellString(3, 1))
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_MEMB_SRNO" , 0 , 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PRTF_ID" , 0 , ods_tmp_prtf)
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_CLS_CODE" , 0 , 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_YN_CODE" , 0 , 0)
	
	DATAMANAGER.RequestTranData("obcpp_intr_758a")
	
	
	
	elseif type_flag == 1 then
	
	DATAMANAGER.SetEventFlag("obcpp_intr_758a", "U")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "ADDR" , 0 , Edit2.caption)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_DATE" , 0 , Calendar0.caption )
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_RSEV_SRNO", 0 , ods_tmp_srno)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "CODE_CLS_CODE" , 0 , "2")
	'DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "INP_YN_CODE" , 0 , 1)
	
	if Combo1.currentindex == 1 then
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Edit0.caption+12&":"&Edit1.caption)
	
	else
	DATAMANAGER.SetDataValue(0, "obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Edit0.caption&":"&Edit1.caption)
	
	end if
	
	
	DATAMANAGER.RequestTranData("obcpp_intr_758a")
	
	end if
	





	Form.CloseForm()
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

