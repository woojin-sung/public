		<TRIO_INFO>
			<TRAN name="obcpp_intr_758a" title="인턴A팀 예약내역테이블 처리서?" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="532" _ulen="400" >

