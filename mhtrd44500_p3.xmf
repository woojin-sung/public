<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="44500" scrname="해외파생_시세신청_유의사항팝업" version="2" writer="이준행" />
	<FORM_INFO name="Form" ly_vert="0,0,375,472,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" caption="해외파생 실시간 시세신청 안내" ly_vert="10,15,239,32,1" />
		<LABEL name="Label1" bgcolor="095:000000000" transmode="0" ly_vert="10,51,355,1,1" />
		<IMAGE name="Image0" imgpath="ic_pop_close" ly_vert="337,17,24,24,1" />
		<LABEL name="Label2" fontsize="-1" caption="1. 해외파생 시세조회 및 매매거래를 위해서 시세신청을 하셔야합니다." valign="0" multiline="1" ly_vert="10,70,355,45,1" />
		<LABEL name="Label3" fontsize="-1" caption="2. 해외거래소에서 제공하는 시세서비스를 이용하기 위해서는 고객정보(영문명, 영문주소)를 입력하셔야 하며, CME 거래소의 경우 별도의 추가정보를 입력하셔야 합니다." valign="0" multiline="1" ly_vert="10,120,355,70,1" />
		<LABEL name="Label4" fontsize="-1" caption="3. 실시간 시세신청은 1개월 단위로 신청가능합니다.
   실시간 시세 자동연장을 선택한 경우에는 1개월 단위로 자동연장(신청일 기준 아님)되며, 매월 첫 영업일에 자동연장됩니다.
   " valign="0" multiline="1" ly_vert="10,205,355,75,1" />
		<LABEL name="Label5" fontsize="-1" caption="4. 당월분 실시간 시세를 신청한 경우 재로그인을 하셔야 실시간 시세조회 및 매매거래가 가능합니다." valign="0" multiline="1" ly_vert="10,288,355,60,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="291" _ulen="291" >
