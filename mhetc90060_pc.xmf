		<CHKBUTTON name="ChkButton2" chkcaption="필수정보 동의" unchkcaption="필수정보 동의" ly_vert="6,322,181,39,1" />
		<CHKBUTTON name="ChkButton3" chkcaption="고유식별번호 동의" unchkcaption="고유식별번호 동의" ly_vert="187,322,181,39,1" />
