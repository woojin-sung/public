'============================================================================
' 01. 화 면 명 : 온라인계좌개설
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_Back_Flag   '뒤로가기플래그

Dim g_STEP		' 0 : 본인계좌 인증 화면	/ 1 : 개설상품 확인 화면
g_STEP = 0

Dim g_CrntIdx		' 0 : 알림톡ㆍ문자 		/ 1 : 이메일
g_CrntIdx = 0

Dim g_ACNO
Dim g_RCNO_TYPE_CODE
Dim g_RCNO_PIP
Dim g_CUST_FULL_NAME
Dim g_CSNO
Dim g_MANG_BRCD

Dim g_EmailAddr
Dim g_21_InagTypeCode
Dim g_21_InagSrno
Dim g_TelNO
Dim g_13_InagTypeCode
Dim g_13_InagSrno
			
'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	Cont1.Image0.setMaintainingRatio("1")
	Cont1.Image1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	Cont0.visible	= true
	Cont1.visible	= false
	
	Cont0.edtAcno.SetApplyLabel	("계좌번호", 		0, 267, "left", false)  'True.필수입력 / False.선택입력
	Cont0.edtPwd.SetApplyLabel	("계좌비밀번호",	0, 267, "left", false)
	Cont0.edtPwd.SetUseResultLabel(True, 1)
	
	g_ACNO = Form.GetOpenLinkData()
	Cont0.edtAcno.caption = Left(g_ACNO, 4)..Mid(g_ACNO, 5, 4)

	sLogintype = Form.GetSharedData("&LOGIN_TYPE", false)
	if Cint(sLogintype) > 1 then
		Cont0.edtPwd.enable = true
		Form.SetTimerEvent2(2, 1, 0.5)
	else
		Cont0.edtPwd.enable = false
		Form.MsgBox("알림", "로그인이 필요합니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
	end if

End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	' 로그인 필요
	if sKeyName == "LOG_FORCE" then

		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90021", "", "")
		else
			Form.CloseForm()
			Form.OpenScreen("41000", "")
		end if
		
	' 온라인 계좌개설 종료
	elseif sKeyName == "END_PROCESS" then
	
		if sRet == "ok" then  '예.ok / 아니오.no
			Form.SendReturnToParent("mbonl84040_END_PROCESS", g_ACNO)
			Form.CloseForm()
		else
			g_Back_Flag = ""
		end if
		
	elseif sKeyName == "edtpwd_click" then
		Form.SetTimerEvent2(3, 1, 0.1)
		Form.SetTimerEvent2(1, 1, 0.1)
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	'연락처 변경
	if sKeyName == "mbonl81000" and sRet == "ok" then
		DATAMANAGER.RequestTranData("obcsb_acif_140r")
		
	'계좌 개설 완료 리턴
	elseif sKeyName == "mbonl84040_p1" then
		
		if sRet = "ERROR" then
			Form.SendReturnToParent("mbonl84040_END_PROCESS", g_ACNO)
			Form.CloseForm()
		elseif len(trim(sRet)) > 0 then
			Form.OpenPopup("mbonl84040_p3", sRet, "")
		end if

	'계좌 개설 완료 팝업 리턴
	elseif sKeyName == "mbonl84040_p3" then
		
		if sRet == "ok" then
			Form.SendReturnToParent("mbonl84040_COMPLETE", "")
			Form.CloseForm()
		end if

	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(1, 0, 0.1)
		Cont0.edtAcno.SetShowKeypad(True)
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(2, 0, 0.5)
		Cont0.edtPwd.SetShowKeypad(True)
	elseif sTimerID == "3" or sTimerID == 3 then
		Form.SetTimerEvent2(3, 0, 0.1)
		Cont0.edtPwd.SetShowKeypad(false)
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	
	Form.SetSharedData("mbonl84040_ACNO", 			"")
	Form.SetSharedData("mbonl84040_PWD", 			"")
	Form.SetSharedData("mbonl84040_RCNO_TYPE_CODE", 	"")
	Form.SetSharedData("mbonl84040_RCNO_PIP", 		"")
	Form.SetSharedData("mbonl84040_CUST_FULL_NAME", 	"")
	Form.SetSharedData("mbonl84040_CSNO", 			"")	
	Form.SetSharedData("mbonl84040_MANG_BRCD", 		"")
	Form.SetSharedData("mbonl84040_NotiFlag",		"")
	Form.SetSharedData("mbonl84040_TelNo", 			"")
	Form.SetSharedData("mbonl84040_Email", 			"")
	Form.SetSharedData("mbonl84040_InagSrno",		"")	
End Sub

'===========================================================================
' 							DATAMANAGER 함수
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim STA_DATE, FIN_DATE
	STA_DATE = Left(Form.GetSharedData("&HOST_DATE", false), 6)

	if szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO",		0,	Cont0.edtAcno.caption)
	end if
	
	if szTranID == "obacp_opop_066r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO",		0,	Cont0.edtAcno.caption)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNT_PWD",	0,	Cont0.edtPwd.caption)
	end if
	
	' 유선본인확인정보조회
	if szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO",		0,	Cont0.edtAcno.caption)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_000r" then
		g_RCNO_TYPE_CODE	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO_TYPE_CODE",	0)
		g_RCNO_PIP  		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO_PIP",			0)
		g_CUST_FULL_NAME	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_FULL_NAME",	0)
		g_CSNO 			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CSNO",			0)
		
		Dim NTFR_CLS_CODE, RSDT_CLS_CODE, CUST_CLS_CODE
		NTFR_CLS_CODE 	= CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "NTFR_CLS_CODE", 0))
		RSDT_CLS_CODE 	= CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RSDT_CLS_CODE", 0))
		CUST_CLS_CODE 	= CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_CLS_CODE", 0))

		' 외국인 처리불가
		if NTFR_CLS_CODE <> 1 then
			Form.ShowAlert("안내", "외국인은 추가개설 불가합니다.")
			Form.CloseForm()
			
		' 비거주자 처리불가
		elseif RSDT_CLS_CODE == 2 then
			Form.ShowAlert("안내", "비거주자는 추가개설 불가합니다.")
			Form.CloseForm()
			
		' 법인 처리불가
		elseif CUST_CLS_CODE <> 1 then
			Form.ShowAlert("안내", "법인은 추가개설 불가합니다.")
			Form.CloseForm()
		else
			DATAMANAGER.RequestTranData("obacp_opop_066r")
		end if
		
	end if

	if szTranID == "obacp_opop_066r" then		
		g_MANG_BRCD = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "MANG_BRCD", 0)
		
		Cont0.visible	= false
		Cont1.visible	= true
		
		lblTitle.caption		= "개설상품 확인"
		lblSubTitle.caption	= "개설 정보를 확인해주세요."
		
		g_STEP = 1
		
		DATAMANAGER.RequestTranData("obcsb_acif_140r")
	end if
	
	' 유선본인확인정보조회
	if szTranID == "obcsb_acif_140r" then
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
		else
			Dim nCnt_OutBlock2, nCnt_OutBlock3
			nCnt_OutBlock2 = CInt(DATAMANAGER.GetDataCount(false, szTranID, "OutBlock2"))
			nCnt_OutBlock3 = CInt(DATAMANAGER.GetDataCount(false, szTranID, "OutBlock3"))
			
			if nCnt_OutBlock2 > 0 then
			
				for i = 0 to nCnt_OutBlock2 - 1
					g_21_InagTypeCode = CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "INAG_TYPE_CODE", i))
					
					if g_21_InagTypeCode == 21 then
						g_EmailAddr	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "ADDR", 		i)
						g_21_InagSrno	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "INAG_SRNO",	i)
					end if
					
				next
				
			end if
			
			if nCnt_OutBlock3 > 0 then
			
				for i = 0 to nCnt_OutBlock3 - 1
					g_13_InagTypeCode = CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock3", "INAG_TYPE_CODE", i))
					
					if g_13_InagTypeCode == 13 then
						g_TelNO		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock3", "UI_CUST_TELNO",	i)
						g_13_InagSrno	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock3", "INAG_SRNO",		i)
					end if
					
				next
				
			end if
			
			f_BtnSet(g_CrntIdx)
		end if
		
		if g_STEP == 1 tHEN
			btnNext.visible	= true
			btnNext.btnimage	= "btn_20.9"
			btnNext.fgcolor	= "273"
		end if
		
	end if
	
End Sub			
			
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szSubMsg <> null and szSubMsg <> "" then
		Form.ShowAlert("안내", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("안내", szErrMsg)
	end if
	
	if szTranID == "obacp_opop_066r" and szErrCode <> "5766" then
		Cont0.edtPwd.caption = ""
		Form.SetTimerEvent2(2, 1, 0.5)
	end if
	
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' 뒤로가기
'============================================================================
Sub imgBack_OnClick()
	g_Back_Flag = "Y"
	
	Form.MsgBox("알림", "온라인 계좌개설을 중단하시겠습니까?", "END_PROCESS", "2")  '2.예/아니오
End Sub

'============================================================================
'안드로이드에서 키패드 내릴 때 이벤트가 안타서 에러 메시지 보여주기
'============================================================================
Sub btnAlpha_OnClick()
	btnAlpha.visible = false

	if Cont0.edtAcno.caption ~= "" or Cont0.edtAcno.caption ~= null then
	
		if Len(replace(Cont0.edtAcno.caption, " ", "")) == 0 then
		     Cont0.edtAcno.SetResultLabel("1","error","계좌번호를 입력해주세요.","Cont0")
		     Exit Sub
		else
		    '이름 공백 체크
		    sStr = Len(Cont0.edtAcno.Caption)
		    
		    if sStr <> 8 then
				Cont0.edtAcno.SetResultLabel("1", "error", "계좌번호 앞 8자리를 입력해주세요.", "Cont0")
				Exit Sub
		    end if
		    
		end if
	
	end if
	
	if Cont0.edtPwd.caption == "" or Cont0.edtPwd.caption == null then
		Cont0.edtPwd.SetResultLabel("1", "error", "계좌비밀번호를 입력해주세요.", "Cont0")
		Exit Sub
	else	   
		nLen = Cont0.edtPwd.pwdlen
		
		if Cint(nLen) == 0 then
		   Cont0.edtPwd.SetResultLabel("1", "error", "계좌비밀번호를 입력해주세요." ,"Cont0")
		   Exit Sub
		end if
		
		if Cint(nLen) < 4 then
		   Cont0.edtPwd.SetResultLabel("1", "error", "4자 이상 입력해주세요.", "Cont0")
		   Exit Sub
		end if
		
	end if
	 
End Sub

'============================================================================
' 계좌번호
'============================================================================
Sub Cont0_edtAcno_OnEditComplete()

	if Cont0.edtAcno.caption ~= "" or Cont0.edtAcno.caption ~= null then
		
		if Len(replace(Cont0.edtAcno.caption, " " , "")) == 0 then
			Cont0.edtAcno.SetResultLabel("1", "error", "계좌번호를 입력해주세요.", "Cont0")
			Exit Sub
		else
			'이름 공백 체크
			sStr = Len(Cont0.edtAcno.Caption)
			
			if sStr <> 8 then
				Cont0.edtAcno.SetResultLabel("1", "error", "계좌번호 앞 8자리를 입력해주세요.", "Cont0")
				Exit Sub
			end if
		
		end if
	
		Cont0.edtAcno.SetResultLabel("0", "complete", "", "Cont0")
		Cont0.edtAcno.maxlength = "9"
		Cont0.edtAcno.mask = "1,0,,,1,####-####,0,1,1"
		
		'계좌비밀번호 입력키보드 자동보이기
		if Cont0.edtPwd.caption == "" or Cont0.edtPwd.caption == null then
			'일반키패드(단말지원)->보안키패드(내부) 자동오픈에 따른 오류방지
			'일반키패드에서 입력완료가 아닌 키패드외부 선택에 따라 키패드가 닫힌상태에서 뒤로가기(업무종료시키는 경우)시
			'입력완료로 판단되어 화면은 안내페이지로 돌아가지만 보안키패드가 올라왔다가 앱이 죽는 현상 발생
			if g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(2, 1, 0.5)	'0.5초뒤 보안키패드 활성화
			end if
			
		end if
		
	end if
	
End Sub

'============================================================================
' 계좌비밀번호
'============================================================================
Sub Cont0_edtPwd_OnClick()
	btnAlpha.visible = true

	if Cont0.edtPwd.caption == "" or Cont0.edtPwd.caption == null then
	
	    if Len(replace(Cont0.edtAcno.caption, " " , "")) == 0 then
		    Cont0.edtPwd.SetShowKeypad(false)
		    Form.MsgBox("안내", "계좌번호가 입력되지 않았습니다.\n계좌번호를 먼저 입력해주세요.", "edtpwd_click", 6)
		end if
		
	end if
	
End Sub

'============================================================================
' 계좌비밀번호
'============================================================================
Sub Cont0_edtPwd_OnEditComplete()

	if Cont0.edtPwd.caption == "" or Cont0.edtPwd.caption == null then
		Cont0.edtPwd.SetResultLabel("1", "error", "계좌비밀번호를 입력해주세요.", "Cont0")
	else	   
		nLen = Cont0.edtPwd.pwdlen
	
		if Cint(nLen) == 0 then
			Cont0.edtPwd.SetResultLabel("1", "error", "계좌비밀번호를 입력해주세요.", "Cont0")
			Exit Sub
		end if
	
		if Cint(nLen) < 4 then
			Cont0.edtPwd.SetResultLabel("1", "error", "4자 이상 입력해주세요.", "Cont0")
			Exit Sub
		end if
		
		Cont0.edtPwd.SetResultLabel("0","complete","","Cont0")
		
		'확인버튼 활성화
'		btnNext.visible	= true
'		btnNext.btnimage	= "btn_20.9"
'		btnNext.fgcolor	= "273"
		
		btnNext_OnClick()
	end if
    
End Sub

'============================================================================
' 알림톡ㆍ문자
'============================================================================
Sub Cont1_imgRdo0_OnClick()
	f_BtnSet(0)
End Sub
Sub Cont1_Label0_OnClick()
	Cont1_imgRdo0_OnClick()
End Sub

'============================================================================
' 이메일
'============================================================================
Sub Cont1_imgRdo1_OnClick()
	f_BtnSet(1)
End Sub
Sub Cont1_Label1_OnClick()
	Cont1_imgRdo1_OnClick()
End Sub

'============================================================================
' 변경하기
'============================================================================
Sub Cont1_Table1_OnClick(lRow , lColumn)

	'연락처 정보 변경
	if lRow == 0 and lColumn == 1 then
		Form.OpenFramePopup("mbonl81000" , "" , "")
	end if

End Sub

'============================================================================
' 다음
'============================================================================
Sub btnNext_OnClick()	

	' 본인계좌 인증 화면
	if g_STEP == 0 then
		
	    '필수항목체크
		if CheckData() == true then
			DATAMANAGER.RequestTranData("obcsb_acif_000r")
		end if
		
	' 개설상품 확인 화면
	elseif g_STEP == 1 then
		Form.SetSharedData("mbonl84040_ACNO",			g_ACNO)
		Form.SetSharedData("mbonl84040_PWD",				Cont0.edtPwd.caption)
		Form.SetSharedData("mbonl84040_RCNO_TYPE_CODE", 	g_RCNO_TYPE_CODE)
		Form.SetSharedData("mbonl84040_RCNO_PIP", 		g_RCNO_PIP)
		Form.SetSharedData("mbonl84040_CUST_FULL_NAME",	g_CUST_FULL_NAME)
		Form.SetSharedData("mbonl84040_CSNO", 			g_CSNO)
		Form.SetSharedData("mbonl84040_MANG_BRCD", 		g_MANG_BRCD)
		
		if g_CrntIdx == 0 then
			Form.SetSharedData("mbonl84040_NotiFlag",	"talk")
			Form.SetSharedData("mbonl84040_TelNo",		g_TelNO)
			Form.SetSharedData("mbonl84040_InagSrno",	g_13_InagSrno)
		else
			Form.SetSharedData("mbonl84040_NotiFlag" ,	"email")
			Form.SetSharedData("mbonl84040_Email",		g_EmailAddr)
			Form.SetSharedData("mbonl84040_InagSrno",	g_21_InagSrno)
		end if
			
		'약관팝업	
		Form.OpenPopupAnimation("mbonl84040_p1", "", "", "2")
	end if
	
End Sub

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 계좌번호, 계좌비밀번호 정합성 체크
'============================================================================
Function CheckData()

	if Trim(Cont0.edtAcno.caption) == "" or Trim(Cont0.edtAcno.caption) == null then
		'(순서주의) 포커스후->Alert처리해야함
		Form.ShowAlert("오류", "계좌번호가 입력되지 않았습니다.")
		return false
	
	else
		'이름 공백 체크
		sStr = Len(Cont0.edtAcno.Caption)
		
		if sStr <> 8 then
		    Form.ShowAlert("안내", "계좌번호 앞 8자리를 입력해주세요.")
		    return false
		end if
	
	end if
	
	if Trim(Cont0.edtPwd.caption) == "" or Trim(Cont0.edtPwd.caption) == null then
		Form.ShowAlert("안내", "계좌비밀번호를 입력해주세요.")
		return false
		
	else
	    nLen = Cont0.edtPwd.pwdlen
	   
	   if Cint(nLen) < 4 then
		   Form.ShowAlert("안내", "4자 이상 입력해주세요.")
		   return false
		   
	   elseif Cint(nLen) == 0 then
		   Form.ShowAlert("안내", "계좌비밀번호를 입력해주세요.")
		   return false
	   end if
	   
	end if
	
	return true

End Function 

'============================================================================
' 알림톡ㆍ문자 / 이메일(버튼 세팅 함수)
'============================================================================
Function f_BtnSet(idx)
	Dim sRdoNm, sLblNm
	g_CrntIdx = idx

	for i = 0 to 1
		sRdoNm = "Cont1.imgRdo"& i
		sLblNm = "Cont1.Label" & i

		' 비활성화 ---
		Form.SetCtlProp(sRdoNm, "imgpath",	"input_01_n.9")
		Form.SetCtlProp(sLblNm, "fgcolor", 	"127")
		
		' 활성화 ---
		if i == idx then			
			Form.SetCtlProp(sRdoNm, "imgpath",	"input_01_o.9")
			Form.SetCtlProp(sLblNm, "fgcolor", 	"67")
		end if
		
	next
	
	if idx == 0 then
		Cont1.Table1.SetCellString(0, 0, g_TelNO)
		Cont1.Image0.SetAlpha(0)	'알림톡	'0:선택/1:미선택
		Cont1.Image1.SetAlpha(1)
	else
		Cont1.Table1.SetCellString(0, 0, g_EmailAddr)
		Cont1.Image0.SetAlpha(1)	'알림톡	'0:선택/1:미선택
		Cont1.Image1.SetAlpha(0)
	end if

End Function

