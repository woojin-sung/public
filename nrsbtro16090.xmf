	<SCRIPT_INFO _len="6730" _ulen="5984" >
'실시간 시세 신청

Dim g_szOpenData
g_szOpenData = ""

Dim g_szScreenNo, g_szOpen
g_szScreenNo = ""
g_szOpen = ""

'CFD관련 메시지 한번만 표기
Dim g_szDisplayMsgForCFD
g_szDisplayMsgForCFD = true

'============================================================================
Sub Form_OnFormInitBefore()
	'imgBack.setMaintainingRatio("1")	
	imgInfo.setMaintainingRatio("1")
End Sub

'211216 아이티젠 김성수 END
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N") 
	Form.SetSharedData("nrsbtro16090_ScrNo", "1") 
	
	Dim  szOS_TYPE
	szOS_TYPE = Form.GetSharedData("&OS_TYPE", false)	
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
'gszScreenNo = "16095" 'for TEST		

	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	if CInt(sLOGIN_TYPE) > 1 then  '로그인상태
	else
		g_szOpen = g_szScreenNo
		Form.OpenPopup("mhetc90021","","")	
		Exit Sub
	end if 	
	
 	if g_szScreenNo == "16095" then 'CFD
		'실시간 시세 조회(CFD)
		lblTitle.caption = "실시간 시세 신청(CFD용)"
		'imgTitleArrow.visible = false
		imgInfo.visible = false
	Else 
		lblTitle.caption = "실시간 시세 신청"
		'imgTitleArrow.visible = true
		imgInfo.visible = true
	end if   
	
	g_szOpenData = Form.GetOpenLinkData() 
'환전완료`통화`화면번호`계좌번호`마켓명`이용기간(0,1,2) 
'g_szOpenData = "환전완료`USD`16090`3008432104`미국`0" 'for TEST
'g_szOpenData = "환전완료`CNY`16095`3008432104`상해`2" 'for TEST
'g_szOpenData = "1" 'for TEST
	if g_szOpenData <> "" or g_szOpenData <> "nil" then
		if g_szOpenData == "1" then
			'탭번호 1 : 신청내역, 0 또는 "" : 신청/해지
			'CFD 실시간 시세신청한 고객이 해외주식 실시간 시세 신청 화면에서 해지하는 경우 실시신시세신청 CFD의 신청내역 탭으로 이동 
			'해외주식 실시간 시세신청한 고객이 해외CFD 실시간 시세 신청 화면에서 해지하는 경우 실시신시세신청의 신청내역 탭으로 이동 			
			g_szOpenData = "" '탭이동 데이터이기 때문에 초기화
			fmtab01.currenttab = 1
			fmtab01_OnTabChanged(1)
		else
			'6500 환전신청 후 
			'신청/해지
			fmtab01.currenttab = 0
			fmtab01_OnTabChanged(0)
		end if
	else
		fmtab01.currenttab = 0
		if szOS_TYPE ~= "2" then
			fmtab01_OnTabChanged(0)
		end if
	end if 	
		
	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
'	Dim nWidth
	lblTitle.paddinginfo = "0,0,0,0"
	
'	nWidth = Form.GetTextWidth(lblTitle.caption, 3, false, false)	
'	imgTitleArrow.maintainratio = "2" 
'	imgTitleArrow.imgpath = "icon_arrow_down2"
'	imgTitleArrow.left = 47 + nWidth + 10	
	
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = "icon_main_01"	
End Sub

'============================================================================
Sub Form_OnRefresh()
	fmtab01_OnTabChanged(tonumber(fmtab01.currenttab))
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	'ImgBack_OnClick()	
End Sub

'============================================================================
Sub fmtab01_OnTabChanged(nCurrentTab)

	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "INFO_REFRESH", g_szOpenData)
	if nCurrentTab == 0 then
		Form.SetSharedData("&BACK_PRESS_ENABLE", "N") 
		Form.SetSharedData("nrsbtro16090_ScrNo", "1")
		if g_szDisplayMsgForCFD == true then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "DISPLAY_MSG_FOR_CFD", "1")
			g_szDisplayMsgForCFD = false
		else
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "DISPLAY_MSG_FOR_CFD", "0")
	    end if 
	else
		g_szOpenData = "" '탭이동 이전 데이터 초기화
		Form.SetSharedData("&BACK_PRESS_ENABLE", "Y") 
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "DISPLAY_MSG_FOR_CFD", "0")
	end if
	
End Sub

'============================================================================
Sub imgInfo_OnClick()
    Form.OpenPopup("nrsbtro16090_p10" , "" , "")		
End Sub

'============================================================================
Sub imgBack_OnClick()
	Dim szPrevScr
	szPrevScr = Form.GetSharedData("&PREV_SCREEN_NO", false )	'직전화면번호

	if CInt(fmtab01.currenttab) == 0  then '신청해지
		if Form.GetSharedData("nrsbtro16090_ScrNo", false) == "2" then '시장정보입력 >> 시장선택
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_SUBSCREEN", "1")
		else
			if szPrevScr == "99999" then
				Form.CloseForm()
			else
				'화면닫기전 안드로이드-백버튼 작동Y 원복
				Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")  			
				Form.OpenPrevScreen()
			end if 
		end if 
	else
		if szPrevScr == "99999" then
			Form.CloseForm()
		else
			'화면닫기전 안드로이드-백버튼 작동Y 원복
			Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")  			
			Form.OpenPrevScreen()
		end if 
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'msgbox sKeyName & " :: " & sRet
	if sKeyName == "Login_Type" then
		if Cint(sRet) > 1 then
			if g_szOpen == g_szScreenNo then
				Form_OnFormInit()
			end if	
		end if 
	end if	
End Sub

'============================================================================
Sub Form_OnFormClose()
    '화면닫기전 안드로이드-백버튼 작동Y 원복
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")  	
End Sub

