'
'--===========================================================================

Dim	g_sz_OSType		'OS타입
Dim	g_sz_ErrorMsg 	'불가사유
Dim	g_BDMNMETBSWRGB	'비대면업무구분
Dim	g_BDM_FRST_MAPID	'최초진입화면


'============================================================================
Function ErrorMsgConv(gb)
	
	g_sz_ErrorMsg = ""	
	
	'그 외 오류
	if gb == "E100" then
		g_sz_ErrorMsg = "기타 오류\n\n고객센터 또는 영업점에 사전상담 후\n시도해주시기 바랍니다."

	'대포통장명의인, 사기계좌명의인(07로 분기)
	elseif gb == "E101" then
		'g_sz_ErrorMsg = "계좌개설을 하실 수 없는 고객입니다."
		g_sz_ErrorMsg = "계좌개설을 하실 수 없는 고객입니다.\n(대포통장 명의인)"
		
	elseif gb == "E001" then
		g_sz_ErrorMsg = "비대면업무신청을 하실 수 없는 고객입니다."

	'고객명 상이
	elseif gb == "E102" then
		'g_sz_ErrorMsg = "기존계좌의 고객명과 상이하여,\n개명업무가 필요합니다.\n\n고객센터 또는 영업점에 사전상담 후\n시도해주시기 바랍니다."	
		g_sz_ErrorMsg = "기존계좌의 고객명과 상이하여\n개설이 불가합니다.(개명필요)\n\n고객센터 또는 영업점으로 문의주세요."	
		
	elseif gb == "E002" then
		g_sz_ErrorMsg = "기존계좌의 고객명과 상이하여,\n개명업무가 필요합니다.\n\n고객센터 또는 영업점에 사전상담 후\n시도해주시기 바랍니다."	
		
	elseif gb == "E902" then
		g_sz_ErrorMsg = "기존계좌의 고객명과 상이하여,\n개명업무가 필요합니다.\n\n고객센터 또는 영업점에 사전상담 후\n시도해주시기 바랍니다."	
		

	'미성년자
	elseif gb == "E103" then
		'g_sz_ErrorMsg = "계좌개설이 불가합니다.".."\n".."(미성년자 비대면계좌 개설 불가)"
		'g_sz_ErrorMsg = "주민등록번호를 확인하세요.\n\n미성년자, 외국인 및 재외국민은\n비대면계좌 개설이 불가합니다."
		g_sz_ErrorMsg = "미성년자는 비대면 계좌개설이 불가합니다."
	elseif gb == "E003" then
		'g_sz_ErrorMsg = "비대면업무신청이 불가합니다.".."\n".."(미성년자 비대면업무신청 불가)"
		g_sz_ErrorMsg = "주민등록번호를 확인하세요.\n\n미성년자, 외국인 및 재외국민은\n비대면 업무신청이 불가합니다."

	'정보노출자 등록고객
	elseif gb == "E104" then
		'g_sz_ErrorMsg = "계좌개설이 불가합니다.".."\n".."(개인정보노출 등록 고객)"
		'g_sz_ErrorMsg = "개인정보노출 등록 고객입니다."
		g_sz_ErrorMsg = "계좌개설을 하실 수 없는 고객입니다.\n(개인정보노출 등록 고객)"
	elseif gb == "E004" then
		'g_sz_ErrorMsg = "비대면업무신청이 불가합니다.".."\n".."(개인정보노출 등록 고객)"
		g_sz_ErrorMsg = "개인정보노출 등록 고객입니다."		

	'외국인 및 재외국민(실명번호 7번째 자릿수 = 5,6,7,8)
	elseif gb == "E105" then
		'g_sz_ErrorMsg = "외국인 및 재외국민은 비대면 계좌개설이 불가능합니다."
		'g_sz_ErrorMsg = "주민등록번호를 확인하세요.\n\n미성년자, 외국인 및 재외국민은\n비대면 계좌개설이 불가합니다."
		g_sz_ErrorMsg = "외국인 및 재외국민은\n비대면 계좌개설이 불가합니다."

	elseif gb == "E005" then
		'g_sz_ErrorMsg = "외국인 및 재외국민은 비대면업무신청이 불가능합니다."
		g_sz_ErrorMsg = "주민등록번호를 확인하세요.\n\n미성년자, 외국인 및 재외국민은\n비대면 업무신청이 불가합니다."
		
    '재외국민주민등록증 등록고객 업무신청/모바일OTP 업무신청 불가
	elseif gb == "E006" then
         g_sz_ErrorMsg = "재외국민주민등록증 등록고객은\n비대면업무신청이 불가합니다."
	 
	elseif gb == "E306" then
         g_sz_ErrorMsg = "재외국민주민등록증 등록고객은\n모바일OTP 업무신청이 불가합니다."
	
	'사기계좌명의인
	elseif gb == "E107" then
		g_sz_ErrorMsg = "계좌개설을 하실 수 없는 고객입니다.\n(사기계좌 명의인)"	 
		
	'사망사고
	elseif gb == "E108" then
		g_sz_ErrorMsg = "계좌개설을 하실 수 없는 고객입니다."			
	
	'미정의
	elseif gb == "E999" then
		g_sz_ErrorMsg = "기타 오류가 발생하였습니다"
		
	End if
End Function
'============================================================================
Function User_SharedData_Set()
    '진입점에서 설정되는 정보 ---------------------------------------
    Form.SetSharedData("BDM_FRST_MAPID"         , "" )  '최초진입화면ID
    Form.SetSharedData("BDM_NMETBSWRGB"         , "" )  '비대면업무구분
    Form.SetSharedData("mOTP_IntoClcd"          , "" )  '(모바일OTP)진입구분코드
    Form.SetSharedData("BDM_CSNO"               , "" )  '고객번호

    '휴대폰본인인증에서 설정되는 정보 ---------------------------------------
    Form.SetSharedData("BDM_REG_UNIQ_NO"        , "" ) '등록고유번호
    Form.SetSharedData("BDM_REG_STAG_CLS_CODE"  , "" ) '등록단계구분코드
    Form.SetSharedData("BDM_NAME"               , "" ) '이름
    Form.SetSharedData("BDM_RCNO_PIP"           , "" ) '주민등록번호
    Form.SetSharedData("BDM_COMPANY_CODE"       , "" ) '통신사 정보
    Form.SetSharedData("BDM_HP1"                , "" ) '휴대폰번호
    Form.SetSharedData("BDM_HP2"                , "" )
    Form.SetSharedData("BDM_HP3"                , "" )
        
    '신분증진위확인에서 설정되는 정보 ---------------------------------------
    Form.SetSharedData("BDM_IDNTF_SRNO"         , "" ) '신분증일련번호
    Form.SetSharedData("&RET_NAME"              , "" )  '이름
        
    '이어하기안내용, 진행상태보기용 Data ---------------------------------------
    Form.SetSharedData("BDM_EXSN_CUST_YN"       , "" )  'Y.기존고객 N.신규고객
    Form.SetSharedData("BDM_ISA_ACNT_YN"        , "" )  'ISA계좌보유여부
    Form.SetSharedData("BDM_DREM_YN"            , "" )  'Y.임직원 N.고객
    Form.SetSharedData("BDM_LAST_BSWR_GB"       , "" )  '최근처리업무구분
    Form.SetSharedData("BDM_PRGS_YN"            , "" )  '(계좌개설)진행중데이터여부
    Form.SetSharedData("BDM_LAST_STAG_CLS_CODE" , "" )  '최종등록단계구분코드
    Form.SetSharedData("BDM_CLEAR_YN"           , "" )  '이어하기여부
    Form.SetSharedData("BDM_PRNM"               , "" )  '개설상품명
    Form.SetSharedData("BDM_BDM_APLTDATE"       , "" )  '신청일자
    Form.SetSharedData("BDM_BDM_CLSNDATE"       , "" )  '신청마감일자
    Form.SetSharedData("BDM_ACNT_OPNG_CLCD"     , "" )  '계좌개설구분  
End Function



'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	'OSType 1.안드로이드 2.IOS
	g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)
	'Form.ShowAlert("OS_VERSION", "["..g_sz_OSType.."](1.안드로이드 2.IOS)")
	
	'호출업무 확인
	g_BDMNMETBSWRGB = Form.GetSharedData("BDM_NMETBSWRGB", false)
	'Form.ShowAlert("비대면업무구분", "["..g_sz_NmetBswrGb.."](100.비대면계좌개설 0xx.비대면업무신청 999.비대면진행상황)")

	'최초진입화면ID
	g_BDM_FRST_MAPID = Form.GetSharedData("BDM_FRST_MAPID", false)

	'컨트롤이미지설정
	imgFail.imgpath = "icon_error.png"
	
	if g_sz_NmetBswrGb == "100" or g_sz_NmetBswrGb == 100 then
		btnExit.caption = "나중에 개설하기"
	else
		btnExit.caption = "나중에 신청하기"
	end if
	
	'오류메시지변환
	szErrCode = Form.GetOpenLinkData()

	if Trim(szErrCode) == "" then
		ErrorMsgConv("E999")
	else
		ErrorMsgConv(szErrCode)
	end if	

	'각 업무영역에서 넘겨준 메시지 표시
	if g_BDMNMETBSWRGB == "100" or g_BDMNMETBSWRGB == 100 then
		lblMsg.caption = "계좌개설이 불가능합니다."
	elseif Mid(g_BDMNMETBSWRGB,1,1) == "0" or Mid(g_BDMNMETBSWRGB,1,1) == 0 then  '비대면업무처리 0xx
		lblMsg.caption = "비대면업무처리가 불가능합니다."
	elseif Mid(g_BDMNMETBSWRGB,1,1) == "9" or Mid(g_BDMNMETBSWRGB,1,1) == 9 then  '비대면업무처리 0xx
		lblMsg.caption = "비대면업무처리가 불가능합니다."		
	Else
		lblMsg.caption = "처리가 불가능합니다."
	End if
	lblSubMsg.caption = g_sz_ErrorMsg
	
End Sub



'============================================================================
Sub btnExit_OnClick()    
'	if g_sz_OSType == "1" then
'     	ExitStep() 'onFormClose 이벤트 동일로직
'	     Form.SetTimerEvent2("9999", 1, 0.1)	'화면닫기
'	elseif g_sz_OSType == "2" then
'		Form.CloseForm()
'	end if
	
	if g_BDMNMETBSWRGB == "100" or g_BDMNMETBSWRGB == 100 then	
		'비대면 초기화면으로
		'이 화면 뜰 때 기준으로 앞 뒤로 아무화면도 남아있지 않으므로 넥스트팝업 띄워줌
		Form.OpenNextPopup("mbbdm85100", "", "")	
	else
		'Form.OpenNextPopup("mhetc90023", "", "")	
		Form.OpenScreen( "41000" , "")
		Form.CloseForm()		
	end if
	
End Sub


'============================================================================
Function ExitStep()
	'공유변수 초기화
	User_SharedData_Set()

	'최초진입점으로 위치
	if g_BDM_FRST_MAPID ~= "" and g_BDM_FRST_MAPID ~= null then
		Form.OpenPopup(g_BDM_FRST_MAPID, "", "")
	end if
End Function 
'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

	'공유변수 초기화
	User_SharedData_Set()

	'최초진입점으로 위치
'	if g_BDM_FRST_MAPID ~= "" and g_BDM_FRST_MAPID ~= null then
'		'시장종합으로 가는경우에는 OpenScreen()으로 처리
'		If g_BDM_FRST_MAPID == "screen41000" Then
'			Form.OpenScreen("41000", "")		
'		Else
'			Form.OpenPopup(g_BDM_FRST_MAPID, "", "")
'		End If
'	end if	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'화면닫기
	If sTimerID == "9999" or sTimerID == 9999 then 
		Form.SetTimerEvent2(sTimerID, 0, 0.1)
		if g_sz_OSType  == "1" then
			Form.CloseForm()
		end if
    end if
End Sub
'============================================================================
Sub Form_OnFormBackKeyPressed()
	btnExit_OnClick()
End Sub

	</SCRIPT_INFO>
