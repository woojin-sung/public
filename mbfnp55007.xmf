<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="11111" scrname="상품가입 의사표시 확정" version="2" writer="김유경" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<ACCOUNT name="Account0" itemcodetype="100,101,102,103,104,105,106,107,108,109,110,112,113,114,115,117,118,119,120,121,123,124,125,126,127,131,138,140,200" etcfunctions="" accpwdctl="EditPW" senddatafield="obcck_dsmg_606r.InBlock1.ACNO" ly_vert="6,9,276,39,1" />
		<EDIT name="EditPW" autofontsize="1" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" senddatafield="obcck_dsmg_606r.InBlock1.ACNT_PWD" ly_vert="288,9,80,39,1" />
		<FORMTAB name="FormTab0" tabcount="2" tabwidthtype="1" tabheadheight="50" autosave="1" ly_vert="1,61,375,505,1" >
			<PAGE name="page0" caption="의사표시 확정처리" linkfile="mbfnp55007_t1" loadingtype="1" />
			<PAGE name="page1" caption="확정내역조회" linkfile="mbfnp55007_t2" loadingtype="1" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2321" _ulen="2207" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 상품가입 의사표시 확정
' 02. 화면설명 : 상품가입 의사표시 확정
' 03. 작    성 : 2021.06.02. 김유경
' 04. 수    정 : 
'-------------------------------------------------------------------------------------------
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' SetTrigger(nIndex) : 트리거 발생 함수
'============================================================================
Function SetTrigger(nIndex)
	'TR 입력에 필요한 Data
	szData = LEFT(Account0.caption, 8) & "★" & MID(Account0.caption, 9,2) & "★" & EditPW.caption

	Select Case CInt(nIndex)
		Case 0
			Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid , "확정처리", szData)
		Case 1
			Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid , "내역조회", szData)
	End Select
	
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()	
	Call SetTrigger(FormTab0.currenttab)
End Sub
'============================================================================
Sub Account0_ChangeAccount()
	EditPW.caption = ""
	Call SetTrigger(FormTab0.currenttab)
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Call SetTrigger(FormTab0.currenttab)
End Sub

'============================================================================
Sub EditPW_OnEditComplete()	
	Call SetTrigger(FormTab0.currenttab)
End Sub


	</SCRIPT_INFO>
</ROOT>