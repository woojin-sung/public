'============================================================================
Sub Form_OnFormInit()
	Dim szData
	Dim szList
	

	szData = Form.GetOpenLinkData()
	
	szList = Split(szData,"☆")
	if UBOUND(szList) < 1 then
		Exit Sub
	end if
	
	if szList(1) == "2" then
		Form.SetScreenName("상관관계 - " + szList(2))
	elseif szList(1) == "3" then
		Form.SetScreenName("특징주 - " + szList(2))
	end if
	
	DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , szList(0) )
	DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , szList(1) )
	
	
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_news_008r" then
		Dim szText
		Dim szTemp
		
		szText = ""
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_news_008r", "OutBlock1") - 1
			szTemp = DATAMANAGER.GetDataValue( 0, "ohhts_news_008r", "OutBlock1", "FID_NEWS_CNTT" , i)
			szText = szText & szTemp
		next
			web0.loaddata = "<html><body>"&szText & "<br>* 본 시황은 인포스탁에서 제공됩니다.</body></html>"
	end if
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="ohhts_news_008r" trcode="ohhts_news_008r" compress="1" encryption="1" inputcheck="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="ohhts_news_008r" title="(MTS)국내해외시황" realdata="0" dessvr="N" >
				<TRBLOCK name="InBlock1" inout="in" _len="152" _ulen="116" >

FID_INPUT_NEWS_OFER_ENTP_CODE^FID입력뉴스제공업체코드^5^0^0^0^0^0^0
FID_INPUT_MRKT_CLS_CODE^FID입력시장구분코드^2^0^0^0^0^0^0

