'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm
Dim g_szMediaCode

Dim g_szSaveKey '20211115 아이티젠 김성수 추가
g_szSaveKey = "SELECT_GWGROUP" '마지막 선택 그룹 키

g_tGSelect = {}
g_tDefault = {"GW_RECENT", "GW_HOLDING"}
g_tKey     = {"BB", "CC"}
g_tNm      = {"최근조회 종목", "보유종목"}

'============================================================================
' Insert_grdGroup :  관심그룹리스트 그리드에 SET
'============================================================================
Function Insert_grdGroup(szGroupData)
	Dim szKey, szNm, szSave, tGroupList
	Dim nIdx, nSelect
	
	g_GwantList = {}
	cont0.grdList.SetClear()
	
	tGroupList = Split(szGroupData, "★")
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
'	szSave = Form.GetEnvData("SELECT_GWGROUP")
	'20211116 아이티젠 김성수 추가 
	'종목 편집에서 Env 변경 이슈로 인해 선택 그룹키를 EnvData에서 ShareData로 바로 받도록 수정
	szSave = Form.GetSharedData("PresentSelectKey", true )
	
	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
	For i = 0 to #g_tDefault-1
		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
		
		if g_tGSelect[i] == "" or g_tGSelect[i] == null then
			g_tGSelect[i] = "1"
		end if
		
		' 해당그룹 Show시
		if g_tGSelect[i] == "1" then
		
			if i == 0 then
				g_GwantList(0) = g_tKey[i] & "`" & g_tNm[i]
			
				nIdx = 0
			else
				if nIdx >= 0 then
					nIdx = nIdx + 1
				else
					nIdx = 0
				end if	
				
				g_GwantList(nIdx) = g_tKey[i] & "`" & g_tNm[i]
				
			end if
			
			if szSave == g_tKey[i] then
				nSelect = nIdx
			end if

			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == #tGroupList -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		end if
	NEXT
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(#tGroupList) > 0 and szGroupData <> "grdGroupEmpty" then '20211208 HSZ : 등록된 관심그룹 없는 경우 skip
		For i = 0 to #tGroupList -1
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
		
			g_GwantList(nIdx) = tGroupList(i)
			
			Dim tTemp
			tTemp = Split(g_GwantList(nIdx), "`")
			szKey = tTemp(0)
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == #tGroupList -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
		
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------
	
	gGwanNum = #g_GwantList
	maxGwanNum = 103 '최대관심종목100개+왓칭/최근조회/보유종목
	
	if gGwanNum > maxGwanNum then
		gGwanNum = maxGwanNum
	end if
	
	if gGwanNum > 0 then
		Dim tData
		
		cont0.grdList.rowcount = gGwanNum+1
		
		for i = 0 to gGwanNum-1
			tData = {}
			tData = Split(g_GwantList(i), "`")
			
			cont0.grdList.SetCellData( "bd_cell0", i, tData(1) )
		next
		
		If CStr(nSelect) == "-1" Then
			nSelect = 0
		End If
		
		Call SetGridBgColor(nSelect)
		cont0.grdList.SetCellData( "bd_cell0", gGwanNum, "               관심그룹 편집" )
		'cont0.grdList.SetCellFgColor("bd_cell0", gGwanNum, "3")
		cont0.grdList.SetCellFgColor("bd_cell0", gGwanNum, "148")
		cont0.grdList.SetCellBgColor("bd_cell0", gGwanNum, 75)
	end if
End Function

'============================================================================
' SetGridBgColor : 관심그룹리스트 선택/비선택 폰트색 설정
'============================================================================
Function SetGridBgColor(nIdx)
	Dim nGrdRowCnt
	nGrdRowCnt = CInt(cont0.grdList.rowcount)

	for i = 0 to nGrdRowCnt-1
		if nIdx == i then '그룹 클릭 시
'			cont0.grdList.SetCellBgColor("bd_cell"..i, 0, 76)
			cont0.grdList.SetCellFgColor("bd_cell0", i, "4")
		else
'			cont0.grdList.SetCellBgColor("bd_cell"..i, 0, 28)
			cont0.grdList.SetCellFgColor("bd_cell0", i, "127")
		end if
	next 

End Function

'============================================================================
Sub Form_OnFormInit()
	g_szMediaCode = Form.GetSharedData( "&MEDIA_CODE" , false ) '20211115 아이티젠 김성수 추가
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20210823 HSZ CFD
	'20210823 HSZ START : CFD 메뉴에서 관심종목 오픈시, 보유종목->주식 보유종목
	if g_szScreenNo = "13101" then 'CFD 관심
		g_tNm      = {"최근조회 종목", "CFD 보유종목"}
	'20211115 아이티젠 김성수 해외 관심 개선 추가 START
	elseif g_szScreenNo = "16010" then '해외주식 관심화면
		g_tDefault 	= {}
		g_tNm 		= {}
		g_tKey 		= {}
		
		g_szSaveKey	= "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
		
		if g_szMediaCode == "156" or g_szMediaCode == "157" then 
			g_tDefault 	= {"GW_RECENT_OVERSEA", "GW_HOLDING_OVERSEA"}
			g_tNm 		= {"최근조회 종목", "보유종목"}
			g_tKey  		= {"BB", "CC"}
		else '고유 MTS
			g_tDefault 	= {"GW_RECENT_OVERSEA"}
			g_tNm 		= {"최근조회 종목"}
			g_tKey     	= {"BB"}
		end if
		
	elseif g_szScreenNo = "43110" then '해외파생 관심화면
		g_tDefault 	= {}
		g_tNm 		= {}
		g_tKey 		= {}
		
		g_szSaveKey	= "GLOBAL_INTR_GROUP_SELECT"
		
		if g_szMediaCode == "158" or g_szMediaCode == "159" then
			g_tDefault 	= {"GLOBAL_INTR_RECENT"}
			g_tNm 		= {"최근조회 종목"}
			g_tKey     	= {"BB"}
		else
			g_tDefault 	= {"GLOBAL_INTR_RECENT", "GLOBAL_INTR_HOLDING"}
			g_tNm 		= {"최근조회 종목", "보유종목"}
			g_tKey  		= {"BB", "CC"}
		end if
	
	elseif g_szScreenNo = "16110" then '해외CFD 관심화면
		g_tDefault 	= {}
		g_tNm 		= {}
		g_tKey 		= {}
		
		g_szSaveKey	= "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
		
		g_tDefault 	= {"GW_RECENT_OVERSEA", "GW_HOLDING_OVERSEA"}
		g_tNm      	= {"최근조회 종목", "CFD 보유종목"}
		g_tKey  		= {"BB", "CC"}
	end if
	'20211115 아이티젠 김성수 해외 관심 개선 추가 END
	'20210823 HSZ END
	
	Dim szOpenData
	'오픈데이터형식 : 그룹키`그룹이름★그룹키`그룹이름★...'
	szOpenData = Form.GetOpenLinkData()
'	Form.ShowAlert("", szOpenData)
	if szOpenData <> "" and szOpenData <> null then
		Insert_grdGroup(szOpenData)
	else '20211208 HSZ : 등록된 관심그룹 없는 경우
		Insert_grdGroup("grdGroupEmpty")
	end if
	
End Sub

'============================================================================
Sub btnBG_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub cont0_grdList_OnClickUp(lRow, szCellID)
	dim nRowCnt
	nRowCnt = CInt(cont0.grdList.rowcount)
	
	if lRow == nRowCnt-1 then '관심그룹편집 클릭
		Form.SendReturnToParent("mhprc11010_p7_edit", lRow)
	else
		Form.SendReturnToParent("mhprc11010_p7_select", lRow)
	end if
	
	Form.CloseForm()
End Sub

'============================================================================
Sub btnMenu_OnClick()
	Form.CloseForm()
End Sub

