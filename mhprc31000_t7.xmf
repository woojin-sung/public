'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가의 프로그램탭
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------
Dim g_sHour, g_sMin '시간 설정 변수
Dim g_plus '분 설정

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Function RequestData()
	
	DATAMANAGER.CancelRealData( "ohhts_nmix_pgm" )

	If cboDate.currentindex = "0" Then
		grdTime.visible = True
		grdDate.visible = False
		
		DATAMANAGER.RequestTranData( "ohhts_3000_006r" )
	Else
		grdTime.visible = False
		grdDate.visible = True
		
		DATAMANAGER.RequestTranData( "ohhts_3000_007r" )
	End If
	
End Function


'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	grdDate.top = 59
	grdDate.visible = false
	cboAmount_OnEditComplete( 0 )
	
	RequestData()
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
    If szTranID = "ohhts_nmix_pgm" Then
    
		If cboStock.currentindex = "0" Then
		    DATAMANAGER.SetDataValue( 1, "ohhts_nmix_pgm", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, "KGG01P" )		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
		Else
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_pgm", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, "QGG01P" )		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 1001 -> QGG01P
		End If
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	
	If szTranID = "ohhts_3000_006r" Then
	    For i = 0 To grdTime.rowcount -1 
		    Dim szTime, szHour, szMin, szSec
		    
		    szTime	= DATAMANAGER.GetDataValue( 0, "ohhts_3000_006r", "OutBlock1", "FID_CNTG_HOUR" , i )
		    
'		    If IsNumeric(szTime) = True Then		    
			    If szTime = "888888" Then
				    grdTime.SetCellData( "bd_cell0", i, "장마감")
				ElseIf szTime = "999999" Then
					grdTime.SetCellData( "bd_cell0", i, "시간외")
				Else
'					szHour	= Left(szTime, 2)
'					szMin	= Mid(szTime, 3, 2)
'					szSec	= Right(szTime, 2)
'					grdTime.SetCellData( "bd_cell0", i, szHour & ":" & szMin & ":" & szSec )
				End If
'		    End if
		Next
	End if	
	
	DATAMANAGER.RequestRealData( "ohhts_nmix_pgm" )
	
End Sub

'============================================================================
Sub cboDate_OnEditComplete(iIndex)
	RequestData()
	
End Sub


'============================================================================
Sub cboStock_OnEditComplete(iIndex)
	RequestData()
	
End Sub


'============================================================================
Sub cboAmount_OnEditComplete(iIndex)

 If 	iIndex = 0 then
	grdTime.SetVisibleCol( 1, 0 )
	grdTime.SetVisibleCol( 2, 0 )
	grdTime.SetVisibleCol( 3, 0 )
	grdTime.SetVisibleCol( 4, 1 )
	grdTime.SetVisibleCol( 5, 1 )
	grdTime.SetVisibleCol( 6, 1 )
	
	grdDate.SetVisibleCol( 1, 0 )
	grdDate.SetVisibleCol( 2, 0 )
	grdDate.SetVisibleCol( 3, 0 )
	grdDate.SetVisibleCol( 4, 1 )
	grdDate.SetVisibleCol( 5, 1 )
	grdDate.SetVisibleCol( 6, 1 )

 Else
	grdTime.SetVisibleCol( 1, 1 )
	grdTime.SetVisibleCol( 2, 1 )
	grdTime.SetVisibleCol( 3, 1 )
	grdTime.SetVisibleCol( 4, 0 )
	grdTime.SetVisibleCol( 5, 0 )
	grdTime.SetVisibleCol( 6, 0 )
	
	grdDate.SetVisibleCol( 1, 1 )
	grdDate.SetVisibleCol( 2, 1 )
	grdDate.SetVisibleCol( 3, 1 )
	grdDate.SetVisibleCol( 4, 0 )
	grdDate.SetVisibleCol( 5, 0 )
	grdDate.SetVisibleCol( 6, 0 )

 End If
	
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
	
		
		RequestData()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	If szTranID = "ohhts_nmix_pgm" then
		If cboStock.currentindex = "0" Then
			Dim szTime, szgrdTime
			szTime 	 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_BSOP_HOUR" , 0 )
			szgrdTime = grdTime.GetCellData("bd_cell0", 0)
			
			If szTime = "888888" Then
			    grdTime.SetCellData( "bd_cell0", 0, "장마감")
			ElseIf szTime = "999999" Then
				grdTime.SetCellData( "bd_cell0", 0, "시간외")
			Else		
				szHour	= Left(szTime, 2)
				szMin	= Mid(szTime, 3, 2)
				szSec	= Right(szTime, 2)
			
				If szgrdTime < szTime Then
					grdTime.insertrow = 0
					
					putMin = int(szMin) + 1
					
					if int(putMin) <= 9 then
					    putMin = "0" & putMin
					End if
					
					'20230125 LES START 차세대 후속조치
					if int(putMin) >= 60 then
						putMin = int(putMin) - 60
						szHour = int(szHour) + 1
					End if
					'20230125 LES END 차세대 후속조치
					
					if int(szHour) <= 9 then
						szHour = "0"&szHour
		
					    If Len(szHour) <> 2 then
						    szHour = Right( szHour, 2 )
					    End if			    
					End if
					
					szTime = szHour..putMin
				Else
					szTime = Left(szgrdTime, 4)
				End If
			End If
			
			sValue0 = szTime.."00"
			sValue1 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_ARBT_NTBY_VOL" , 0 )
			sValue2 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_NABT_NTBY_VOL" , 0 )
			sValue3 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_WHOL_NTBY_VOL" , 0 )
			sValue4 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_ARBT_NTBY_TR_PBMN" , 0 )
			sValue5 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_NABT_NTBY_TR_PBMN" , 0 )
			sValue6 = DATAMANAGER.GetDataValue( 1, "ohhts_nmix_pgm", "OutBlock1", "FIDR_WHOL_NTBY_TR_PBMN" , 0 )
			
			grdTime.SetCellData("bd_cell0", 0, sValue0)
			grdTime.SetCellData("bd_cell1", 0, sValue1)
			grdTime.SetCellData("bd_cell2", 0, sValue2)
			grdTime.SetCellData("bd_cell3", 0, sValue3)
			grdTime.SetCellData("bd_cell4", 0, sValue4)
			grdTime.SetCellData("bd_cell5", 0, sValue5)
			grdTime.SetCellData("bd_cell6", 0, sValue6)
		End If
	End If
End Sub

