'============================================================================
' 20180716 LES START - K-OTC종목 선택 시, 컨트롤 위치조정
'============================================================================
Sub Position_Control()
	'20191106 HWG START : 수량필드 스핀컨트롤 추가
	if g_szMk == "T" then
		cmbType.top = 7
		btnBalance.top = 54
		btnAble.top = 54
		
		btnQty.top = 101
		edtQty.top = 101
		btnQPlus.top = 101
		btnQMinus.top = 101
		
		btnPrc.top = 148
		edtPrc.top = 148
		btnPPlus.top = 148
		btnPMinus.top = 148
		
		cmbType.enable = false
		
	else
		cmbType.top = 54
		btnBalance.top = 101
		btnAble.top = 101
		
		btnQty.top = 148
		edtQty.top = 148
		btnQPlus.top = 148
		btnQMinus.top = 148
		
		
		btnPrc.top = 194
		edtPrc.top = 194
		btnPPlus.top = 194
		btnPMinus.top = 194
		
		cmbType.enable = true
	
	end if
	'20191106 HWG END

End Sub

