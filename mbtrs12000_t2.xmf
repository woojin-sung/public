'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	Dim szType, szCode, szPrice, szInner, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if

 	'20220602 LES START 정산금 호출로직 개선
	szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
	
	'시장구분
	if szInner == "002" then		'코스닥
	    szInrMk = "02"
	elseif szInner == "033" then	'코넥스
		szInrMk = "21"
	
	'현재 AOS = 25 , iOS = 11 (메인에서 맞춰야됨)
	elseif szInner == "011" or szInner == "025" then  '프리보드 
		szInrMk = "03"
	else
		szInrMk = "01"
	end if
	'20220602 LES END 
	
	'주문유형에 따른 주문단가
	szType = cmbType.cbkeydata
    
	Select Case szType
		Case "11"										' 장개시전시간외(전일종가)
			szPrice =  Form.GetCtlProp("#lblStd", "caption")
		Case "12"										' 시간외종가(현재가)
			szPrice =  Form.GetCtlProp("#lblHyun", "caption")
		Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
			szPrice =  Form.GetCtlProp("#lblLow", "caption")		' 매수시(상한가), 매도시 ( 하한가 )	
		Case else
		    szPrice = edtPrc.caption
	    
			if edtPrc.caption = "0" or edtPrc.caption = "" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
				exit Sub
			end if	    
	End Select

    '종목코드
	szCode = Change_ItemCode()
	
	
	'20170713 HAMWG START : 주식 신용매도 시 정산금 데이터 추가 
	'현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoGbn", "currentindex")
	
    if szCLS == "1" then		' 신용
		szCLSChk = chkCredit.checkstate ' 신용합산
		if szCLSChk = "1" then	
			szLoanDate = " "
			szLoanSr   = " "
			if cmbCredit.currentindex == "2" then	  ' 예탁담보
				szLoanCd = "0201"
			elseif cmbCredit.currentindex == "1" then  ' 유통융자
				szLoanCd = "0102"
			else									  ' 신용융자
				szLoanCd = "0101"
			end if
		else
			szLoanDate = cldCredit.caption
			
			if cmbCredit.currentindex == "1" then	' 예탁담보
				szLoanCd = "0201"
				if g_szLoanSrno = "" or g_szLoanSrno = 0 then
					szLoanSr = 0
				else
					szLoanSr = g_szLoanSrno
				end if
			else									' 신용융자
				szLoanCd = "0101"
				szLoanSr = 1
			end if
		end if
	end if
		
	
    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
    szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "1" & "★" & edtQty.caption & "★" & szPrice & "★" & szCode
    if szCLS = "0" then
		Form.OpenPopup("mbtrs12000_pc" , szData , "")
	elseif szCLS = "1" then
		
		'20180614 LES START - 전액상환방식 추가
		if chkRepay.checkstate == "1" then
			szRdmpClcd = "2"
		else
			szRdmpClcd = "1"
		end if
		'LES END
		
		szData = szData & "★" & szCLS & "★" & szLoanCd & "★" & szCLSChk & "★" & szLoanDate & "★" & szLoanSr & "★" & szRdmpClcd
		Form.OpenPopup("mbtrs12000_pi" , szData , "")
	end if
	'20170713 HAMWG END
   
    
    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
    'szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "1" & "★" & edtQty.caption & "★" & szPrice & "★" & szCode
    
    'Form.OpenPopup("mbtrs12000_pc" , szData , "")
End Sub

