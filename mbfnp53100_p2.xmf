<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="85100" scrname="환매신청 유의사항" version="2" writer="김철중" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgDim" autosize="1" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,100,375,564,1" />
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="-6,0,375,639,1" />
		<LABEL name="lblTitle" fontsize="3" fontstyle="01" caption="환매신청 유의사항" halign="1" ly_vert="0,113,380,30,1" />
		<TABLE name="tblLine" outlinecolor="038:255255255" insidelinecolor="102:255255255" colcount="1" rowcount="1" outline="1000" transmode="1" designorder="1" ly_vert="186,597,1,50,1" >
			<COL_INFO ly_vert_width="1" />
			<ROW_INFO ly_vert_height="50" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<BUTTON name="BtnOK" caption="중도환매 신청하기" bgcolor="289:057061072" bgcolor2="233:102101101" fontsize="2" btnimage="btn_26.9" ly_vert="0,597,375,50,1" />
		<CONTAINER name="cont0" vscroll="1" ly_vert="0,150,380,408,1" scroll_ly_vert="0,150,380,408,1" >
			<CONTROL_INFO>
				<LABEL name="lblText0" fontsize="-2" caption="한 위험회피(Hedge)거래의 상황, 기초자산의 가격, 시" valign="0" multiline="1" ly_vert="9,37,346,27,1" />
				<LABEL name="lblText" fontsize="-2" caption="· 투자자가 중도환매(상환)를 요청할 경우 본 증권에 대" valign="0" multiline="1" ly_vert="9,19,346,27,1" />
				<LABEL name="lblText1" fontsize="-2" caption="중금리, 기초자산가격의 변동성, 기초자산의 배당률, 관" valign="0" multiline="1" ly_vert="8,54,347,27,1" />
				<LABEL name="lblText2" fontsize="-2" caption="요인들을 고려하여 공정가액(기준가)의 95% 이상(단," valign="0" multiline="1" ly_vert="8,72,347,27,1" />
				<LABEL name="lblText3" fontsize="-2" caption="발행후 6개월까지는 90% 이상)의 가격으로 증권을" valign="0" multiline="1" ly_vert="8,91,362,27,1" />
				<LABEL name="lblText4" fontsize="-2" caption="중도 환매하도록 하며," valign="0" multiline="1" ly_vert="8,110,152,27,1" />
				<LABEL name="lblText5" fgcolor="323:218100096" fontsize="-2" caption="이 경우 일정부분 원금의 손실이" valign="0" multiline="1" ly_vert="139,110,220,27,1" />
				<LABEL name="lblText6" fgcolor="323:218100096" fontsize="-2" caption="발생할 수 있어요." valign="0" multiline="1" ly_vert="7,128,220,27,1" />
				<LABEL name="lblText7" fontsize="-2" caption="· 또한 시장 붕괴 등 정상적으로 운영되지 않아 본 증권" valign="0" multiline="1" ly_vert="8,161,346,27,1" />
				<LABEL name="lblText8" fontsize="-2" caption="의 시장 청산이 불가능하다고 객관적이고 합리적으로" valign="0" multiline="1" ly_vert="8,178,346,27,1" />
				<LABEL name="lblText9" fontsize="-2" caption="판단되는 경우 해당 투자자의 중도환매(상환)에 응하지" valign="0" multiline="1" ly_vert="7,196,347,27,1" />
				<LABEL name="lblText10" fontsize="-2" caption="아니하거나 일부 물량에 대해서만 중도환매(상환)" valign="0" multiline="1" ly_vert="7,215,347,27,1" />
				<LABEL name="lblText11" fontsize="-2" caption="에 응할 수 있으며, 중도환매(상환)에 응하는 경우에도" valign="0" multiline="1" ly_vert="7,233,362,27,1" />
				<LABEL name="lblText12" fontsize="-2" caption="을 수 있습니다." valign="0" multiline="1" ly_vert="7,271,152,27,1" />
				<LABEL name="lblText13" fgcolor="323:218100096" fontsize="-2" caption="이 경우 발생하는 원금의 손실은 모두" valign="0" multiline="1" ly_vert="101,271,272,27,1" />
				<LABEL name="lblText14" fgcolor="323:218100096" fontsize="-2" caption="투자자에게 귀속되므로 중도환매 신청 시 각별한 주의" valign="0" multiline="1" ly_vert="6,291,344,27,1" />
				<LABEL name="lblText15" fontsize="-2" caption="상환금액 결정방식은 이하에 기재된 기준을 따르지 않" valign="0" multiline="1" ly_vert="7,252,362,27,1" />
				<LABEL name="lblText16" fgcolor="323:218100096" fontsize="-2" caption="가 필요해요." valign="0" multiline="1" ly_vert="6,312,344,27,1" />
				<LABEL name="lblText17" fontsize="-2" caption="· 단, 자동조기상환평가일(불포함) 이전 2거래소 영업" valign="0" multiline="1" ly_vert="10,440,349,27,1" />
				<LABEL name="lblText18" fontsize="-2" caption="일, 만기평가일(불포함) 이전 4거래소 영업일에 해당" valign="0" multiline="1" ly_vert="10,457,352,27,1" />
				<LABEL name="lblText19" fontsize="-2" caption="되는날(포함)부터 자동조기상환평가일(포함), 쿠폰지급" valign="0" multiline="1" ly_vert="10,475,347,27,1" />
				<LABEL name="lblText110" fontsize="-2" caption="평가일(포함), 만기평가일(포함)까지는 신청이" valign="0" multiline="1" ly_vert="10,493,347,27,1" />
				<LABEL name="lblText111" fontsize="-2" caption="· 중도환매(상환)신청" valign="0" multiline="1" ly_vert="10,346,152,27,1" />
				<LABEL name="lblText112" fgcolor="323:218100096" fontsize="-2" caption="당일(영업일) 오후 5시까지" valign="0" multiline="1" ly_vert="140,346,184,27,1" />
				<LABEL name="lblText113" fontsize="-2" caption="신청 접수가능해요. 접수취소는" valign="0" multiline="1" ly_vert="4,366,216,27,1" />
				<LABEL name="lblText114" fgcolor="323:218100096" fontsize="-2" caption="당일(영업일) 오후 5시" valign="0" multiline="1" ly_vert="191,366,157,27,1" />
				<LABEL name="lblText115" fgcolor="323:218100096" fontsize="-2" caption="까지 가능하고," valign="0" multiline="1" ly_vert="5,386,145,27,1" />
				<LABEL name="lblText116" fontsize="-2" caption="신청접수 후 중도환매(상환)금액 지급일" valign="0" multiline="1" ly_vert="96,386,259,27,1" />
				<LABEL name="lblText117" fontsize="-2" caption="은 신청일 +3영업일에 지급해요.(신청일 불포함)" valign="0" multiline="1" ly_vert="4,406,326,27,1" />
				<LABEL name="lblText118" fontsize="-2" caption="불가해요." valign="0" multiline="1" ly_vert="10,511,347,27,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<CHKBUTTON name="ChkAgree" fgcolor="334:034034034" chkcaption="  유의사항을 확인했어요." unchkcaption="  유의사항을 확인했어요." chkbtnimage="checkmenu_o" unchkbtnimage="checkmenu_n" ly_vert="20,561,250,27,1" />
		<BUTTON name="Button0" btnimage="alpha" ly_vert="10,560,332,40,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3058" _ulen="3002" >

