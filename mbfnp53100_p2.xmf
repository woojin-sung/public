'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub cont0_OnScrollEnd()
	g_bScrollEnd = True
End Sub

'============================================================================
Sub Button0_OnClick()
	
	if g_bScrollEnd = True then
		ChkAgree.enable = 1
			
		if ChkAgree.checkstate == "1" then
			ChkAgree.checkstate = "0"
		else
			ChkAgree.checkstate = "1"
		end if
	else
		cont0.uniSetScroll("1", 160) 
		Form.MsgBox("안내", "유의사항을 끝까지 읽어주세요.", "", 6)
	end if

	
End Sub
'============================================================================
Sub BtnOK_OnClick()
	
	if ChkAgree.checkstate <> "1" then
		Form.MsgBox("안내", "유의사항에 동의해주세요.", "", 6)
	else
		Form.SendReturnToParent("mbfnp53100_p2", "")
		Form.CloseForm()
	end if
	
End Sub

