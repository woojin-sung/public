'============================================================================
Sub Label4_OnClick()
	Form.OpenNextPopup("mhetc90190_s1" , "mhetc90021" , "")
End Sub

'============================================================================
Sub ChkOrderList_OnChange(sCheckState)
	if Cint(sCheckState) == 1 then
		saveDate = Form.GetSharedData("&HOST_DATE",0)
		Form.SaveConfigData("CertSpinLoginEnd", "NoticeSpin", saveDate)
		
		Form.CloseForm()
	end if
End Sub

'============================================================================

'============================================================================
Sub BtnRegister_OnClick()
