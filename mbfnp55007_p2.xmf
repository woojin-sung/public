<ROOT>
	<MAP_INFO scrname="투자/투자취소 확정 확인" version="2" writer="이은섭" />
	<FORM_INFO name="Form" transmode="0" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="Image2" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image1" imgpath="popup_bg_common.9" ly_vert="32,207,312,231,1" />
		<LABEL name="titleLabel0" fontsize="2" fontstyle="01" caption="알 림" halign="1" ly_vert="52,241,275,32,1" />
		<IMAGE name="Image0" imgpath="icon_main_13" ly_vert="307,222,21,21,1" />
		<BUTTON name="ButtonO" caption="확인" fontsize="2" btnimage="btn_26.9" ly_vert="189,380,156,60,1" />
		<BUTTON name="ButtonC" caption="취소" fontsize="2" btnimage="btn_25.9" ly_vert="32,380,156,60,1" />
