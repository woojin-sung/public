	<SCRIPT_INFO _len="1536" _ulen="1436" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 투자/투자취소 확정 확인
' 02. 화면설명 : 투자/투자취소 확정 확인
' 03. 작    성 : 2021.07.30 김유경
'-------------------------------------------------------------------------------------------

Dim g_Flag
Dim gProsClcd
'============================================================================
Sub Form_OnFormInit()	
	gProsClcd = ""
	
	ButtonC.fgcolor = 269
	Image2.imgpath = "alpha128.png"
	
	gProsClcd = Form.GetSharedData("CAFU_BSWR_PROS_CLCD", False )

	If TRIM(gProsClcd) == "0" or TRIM(gProsClcd) == 0 Then
		Label0.caption = "투자로 확정합니다."
	Else
		Label0.caption = "투자취소로 확정합니다."	
	End If
	
End Sub
'============================================================================
Sub ButtonO_OnClick()
	g_Flag = "ok"
	Form.CloseForm()
End Sub
'============================================================================
Sub ButtonC_OnClick()
	g_Flag = ""	
	Form.CloseForm()
End Sub
'============================================================================
Sub Image0_OnClick()
	g_Flag = ""	
	Form.CloseForm()
End Sub
'============================================================================
Sub Image2_OnClick()
	g_Flag = ""	
	Form.CloseForm()	
End Sub
'============================================================================
Sub Form_OnFormClose()
	 Form.SendReturnToParent("mbfnp55007_p2_end" , g_Flag)
End Sub

	</SCRIPT_INFO>
</ROOT>