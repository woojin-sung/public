'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "enrollok" then
		if sRet == "close" then
			Form.CloseForm()
			Form.SendReturnToParent("mbbnk61080_p1" , "ok")
		end if
	end if
	
	if sKeyName == "modifyok" then
		if sRet == "close" then
			Form.CloseForm()
			Form.SendReturnToParent("mbbnk61080_p1" ,"ok")
		end if
	end if
End Sub


'============================================================================
' btnModify_OnClick - 수정버튼 클릭
'============================================================================
Sub btnModify_OnClick()
	TR_Inquiry("obrtp_tact_004a")
End Sub

'============================================================================
Sub cmbBank_OnEditComplete(iIndex)
	
'	g_szBankCode = cmbBank.cbkeydata
	
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.OpenPopup("mbbnk61010_p3" , "", "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "이체기관" then
	   If sRet <> "" then
	      tData1 = Split(sRet, "★")
	      edtBank.caption = tData1(1)
	      g_szBankCode = tData1(0)
	      
	      edtAccount.caption = ""
	      edtRmtName.caption = ""
	      edtNickName.caption = ""
	      
	   End If   
	End If   
End Sub

'============================================================================
Sub edtNickName_OnEditComplete()
	szLen = Form.GetByteLength(edtNickName.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		edtNickName.caption = ""
		Exit Sub
	end if
	
	btnEnroll.enable = true
End Sub

