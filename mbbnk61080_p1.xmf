			<TRAN tranid="obcpp_code_015r" trcode="obcpp_code_015r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obrtp_tact_001a" title="자주쓰는계좌등록 처리" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="526" _ulen="396" >

BSWR_CLCD^업무구분코드^2^0^0^0^0^0^0
