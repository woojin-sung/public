' 01. 화 면 명 : 자주쓰는은행계좌등록_등록
' 02. 화면설명 : 자주쓰는은행계좌등록_등록
' 03. 작    성 : 2016.02.18 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim szData, szList
Dim g_szUserJumin	'실명인증번호(주민번호)
Dim g_szSerialNumber	'일련번호
Dim g_szBankCode		'은행코드
Dim g_szRnDel		'사용여부
Dim g_blReady

g_blReady = false
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
    if szTranID == "obrtp_tact_001a" then	'등록
	
        DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "BSWR_CLCD"     , 0 , "01"     ) '01. 자주쓰는계좌
        DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "CRNC_CLS_CODE" , 0 , "1"      ) '1. 원화
        DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "ACNO"          , 0 , szList(9))
		
		if g_szBankCode <> "287" then
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "2")	'자타사구분코드
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "BANK_CODE", 0 , g_szBankCode)	'은행코드
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "BANK_USE_ACNO" , 0 , edtAccount.caption)	'은행사용계좌번호
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "BANK_ACNM", 0 , edtRmtName.caption)	'은행계좌명(수취인계좌명)
		else
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "1")	'자타사구분코드
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "CNFT_ACNO" , 0 , Left(edtAccount.caption, 8))	'상대계좌번호
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "CNFT_ASNO", 0 , Right(edtAccount.caption, 2))	'상대계좌일련번호
			DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "USER_NAME", 0 , edtNickName.caption )	'사용자명(계좌별)
		end if

		DATAMANAGER.SetDataValue(0, "obrtp_tact_001a", "InBlock1", "USER_NAME" , 0 , edtNickName.caption)	'사용자명(계좌별칭)
		
		DATAMANAGER.RequestTranData("obrtp_tact_001a")
	end if
	
	if szTranID == "obrtd_drng_025r" then	'수취인 조회
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO" , 0 , szList(4) )'"30076921")	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO" , 0 , szList(2) )'"01")	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN" , 0 , "N")	'사용여부(기본값)
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Left(edtAccount.caption, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO" , 0 , Right(edtAccount.caption, 2))	'상대계좌일련번호		
		
		DATAMANAGER.RequestTranData("obrtd_drng_025r")
	end if
	
	if szTranID == "obtss_elbs_129r" then	'타행이체수취조회
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE", 0 , g_szBankCode)	'입금은행코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO" , 0 , edtAccount.caption)	'입금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , "1")		'거래금액
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO" , 0 , szList(4) )	'출금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , szList(2) )	'계좌상품구분코드
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")	'작업단말번호(기본값)
		DATAMANAGER.RequestTranData("obtss_elbs_129r")
	end if
	
	if szTranID == "obrtp_tact_004a" then	'자주쓰는계좌변경
		DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "RCNO", 0 , g_szUserJumin)	'실명확인번호
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "SRNO" , 0 , g_szSerialNumber)	'일련번호
		if g_szBankCode == "287" then	'자타사구분코드
			DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "1")
		else
			DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "2")
		end if
		DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "ACNO", 0 , Account0.total)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "BANK_ACNM" , 0 , edtRmtName2.caption)	'은행수취계좌명
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "USER_NAME" , 0 , edtNickName.caption)	'계좌별칭
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "USE_ABLE_YN" , 0 , g_szRnDel )'"Y")				'사용가능여부
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "PROS_CLS" , 0 , "U" )'"Y")				'사용가능여부
		DATAMANAGER.RequestTranData("obrtp_tact_004a")
	end if
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnEnroll_OnClick
'============================================================================
Sub btnEnroll_OnClick()
	
	if g_blReady == false then
		Form.MsgBox("알림", "수취인 확인을 해주시기 바랍니다.", "", 0)
	else
		TR_Inquiry("obrtp_tact_001a")
	end if
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szUserJumin = ""	'실명인증번호(주민번호)
	g_szSerialNumber = ""	'일련번호
	g_szBankCode = ""		'은행코드
	g_szRnDel = ""		'사용여부
	
	szData =  Form.GetOpenLinkData()
	' enroll(modify)★주민번호★일련번호★은행명★계좌번호★수취인계좌명★계좌별칭★은행코드★사용여부
	szList = Split(szData, "★")
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	if szList(0) == "enroll" then
		
		lblTitle.caption = "자주쓰는 계좌등록" 
		g_blReady = false
		cmbBank.enable = false

		edtBank.enable = false
		edtAccount.enable = true
		edtRmtName.visible = true
		edtBank.enable = false
		edtRmtName.enable = false
		edtRmtName2.visible = false
		btnAccountSearch.visible = true
		btnEnroll.visible = true
		btnModify.visible = false
		
		DATAMANAGER.RequestTranData( "obcpp_code_015r")
		
	elseif szList(0) == "modify" then
		
		lblTitle.caption = "자주쓰는 계좌수정" 
		g_blReady = true
		cmbBank.enable = false

		edtBank.enable = false
		Image0.visible = false
		edtAccount.enable = false
		edtRmtName.visible = false
		edtRmtName2.visible = true
		edtRmtName2.enable = false
		btnAccountSearch.visible = false
		btnEnroll.visible = false
		btnModify.visible = true
		
		g_szUserJumin = szList(1)
		g_szSerialNumber = szList(2)
		edtBank.caption = szList(3)
		edtAccount.caption = szList(4)
		edtRmtName.caption = szList(5)
		edtRmtName2.caption = szList(5)
		edtNickName.caption = szList(6)
		g_szBankCode = szList(7)
		g_szRnDel = szList(8)
		
	elseif szList(0) == "link" then
		
		lblTitle.caption = "자주쓰는 계좌등록" 
		g_blReady = true
		cmbBank.enable = false
		
		edtBank.enable = false
		Image0.visible = false
		edtAccount.enable = false
		edtRmtName.visible = false
		edtRmtName2.visible = true
		btnAccountSearch.visible = false
		btnEnroll.visible = true
		btnModify.visible = false
		
		g_szUserJumin = szList(1)
		g_szSerialNumber = szList(2)
		edtBank.caption = szList(3)
		edtAccount.caption = szList(4)
		edtRmtName.caption = szList(5)
		edtRmtName2.caption = szList(5)
		edtNickName.caption = szList(6)
		g_szBankCode = szList(7)
		g_szRnDel = szList(8)
		
	end if

End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obrtp_tact_001a" then	'자주쓰는계좌등록조회
		Form.MsgBox("알림", "자주쓰는계좌가 등록되었습니다.", "enrollok", 0)		
	end if
	 
	if szTranID == "obrtd_drng_025r" then '수취인 조회
		if Trim(DATAMANAGER.GetDataValue(0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0)) <> "" then
			g_blReady = true
			edtRmtName.caption = DATAMANAGER.GetDataValue(0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0)
		else
			g_blReady = false
		end if
	end if
	
	if szTranID == "obtss_elbs_129r" then
		if DATAMANAGER.GetDataValue(0, "obtss_elbs_129r", "OutBlock1", "ACNM" , 0) <> "" then
			g_blReady = true
			edtRmtName.caption = DATAMANAGER.GetDataValue(0, "obtss_elbs_129r", "OutBlock1", "ACNM" , 0)
		else
			g_blReady = false
		end if
	end if
	
	if szTranID == "obrtp_tact_004a" then	'자주쓰는계좌등록조회
		Form.MsgBox("알림", "자주쓰는계좌가 수정되었습니다.", "modifyok", 0)	
	end if
	
	if szTranID == "obcpp_code_015r" then	'자주쓰는계좌등록조회
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcpp_code_015r", "OutBlock1")
		For i=0 to nCnt -1
		    szCd = DATAMANAGER.GetDataValue( 0 , "obcpp_code_015r", "OutBlock1", "BANK_CODE", i )
		    szNm = DATAMANAGER.GetDataValue( 0 , "obcpp_code_015r", "OutBlock1", "BANK_NAME", i )
			
			cmbBank.cbadddatatext = szCd & "`" & szNm
		Next
		
		'메리츠 기본갑 셋팅 이호철
		cmbBank.cbkeydata = "287"
		g_szBankCode = "287"
		
		edtBank.caption = cmbBank.caption
		
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)

    If Trim(szSubErr) == "" Then
        Form.ShowAlert("알림", szErrMsg)
    Else
        Form.ShowAlert("알림", szErrMsg .. "\n(" .. szSubErr .. ")")
    End If
End Sub


'============================================================================
' btnAccountSearch_OnClick  - 조회버튼 클릭
'============================================================================
Sub btnAccountSearch_OnClick()
	if g_szBankCode == "287" then
		if Len(edtAccount.caption) < 10 then
			Form.MsgBox("알림", "계좌번호와 계좌일련번호를 입력 해주시기 바랍니다.", "", 0)
		else
			TR_Inquiry("obrtd_drng_025r")
		end if
	else
		TR_Inquiry("obtss_elbs_129r")
	end if
		
End Sub


'============================================================================
' btnCancel_OnClick - 취소버튼
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

