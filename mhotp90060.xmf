'============================================================================
' 2021.01.25 SWJ START : 모바일OTP인증 껍데기화면
'============================================================================
' 2021.05.27 : 정민영 : v001 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
'============================================================================
Dim nTab, g_mSBValue
'============================================================================
Sub Form_OnFormInit()
	
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if g_DeviceOS == "1" then
		Form.requestMOTP("MOTP_GET_VERSION" , "" , "10003")     'mSB 버전값 획득위한 호출
		Form.requestMOTP("MOTP_GETINFO"     , "" , "10003")     '등록된 OTP alias 존재하는지 확인
	end if	
End Sub
'============================================================================
Sub Form_OnFormInitAfter()
	if g_DeviceOS == "2" then
		Form.requestMOTP("MOTP_GET_VERSION" , "" , "10003")     'mSB 버전값 획득위한 호출
		Form.requestMOTP("MOTP_GETINFO"     , "" , "10003")     '등록된 OTP alias 존재하는지 확인
	end if
End Sub
'============================================================================
Sub Image5_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
'FormTab으로 연결하니까 자식화면에서 호출이 안되서 부모화면에서 호출
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "menu_entering" then
		Form.requestMOTP("MOTP_GET_VERSION" , "" , "10003")     'mSB 버전값 획득위한 호출
		Form.requestMOTP("MOTP_GETINFO"     , "" , "10003")     '등록된 OTP alias 존재하는지 확인
	elseif sEventName == "menu_entering_pg" then
		Form.requestMOTP("MOTP_GET_VERSION" , "" , "10003")     'mSB 버전값 획득위한 호출(PG거래)
		Form.requestMOTP("MOTP_GETINFO"     , "" , "10003")     '등록된 OTP alias 존재하는지 확인(PG거래)
	elseif sEventName == "menu_entering2" then
		Form.requestMOTP("MOTP_REQ_OTP_ENC", sParam , "10003")  'OTP 번호 생성(일반 비로그인성 인증)
	elseif sEventName == "menu_entering3" then
		Form.requestMOTP("MOTP_REQ_OTP", sParam, "10003")
	elseif sEventName == "AUTH_COMPLETE" then
		Form.OpenNextPopup("mhetc90060_motpS" , "" , "") '인증완료 창으로 전환
	elseif sEventName == "ios_formclose" then
		Form.CloseForm()
	end if
End Sub
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
'모바일OTP 화면번호10000번으로 (이것과 별개지만 참고로 푸시도 내려줄때 10000번으로 인식)
'호출받을 때 _10000(화면번호)로 받기

	if sEventName == "MOTP_GET_VERSION_RETURN_10003" then
		g_mSBValue = Split(sParam,"★")		'resultcode★resultMsg★mSBVersion
		
		if g_mSBValue(0) <> "00000" then
			Form.MsgBox( "알림", g_mSBValue(1), "", 6 )
		end if
			
		if g_mSBValue(2) ~= "" or g_mSBValue(2) ~= null then
			Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_VERSION", g_mSBValue(2))
		end if
		
		
	elseif sEventName == "MOTP_GETINFO_RETURN_10003" then
		g_mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)

		if Ubound(g_mOTPInfo) < 1 then
			exit sub
		else
			if g_mOTPInfo(0) <> "00000" then
				Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_ALIAS", "NO_MOTP")
			else
				Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_ALIAS", g_mOTPInfo(2))
			end if
		end if
		
			
	elseif sEventName == "MOTP_REQ_OTP_ENC_RETURN_10003" then
		g_mOTPData = Split(sParam,"★")
		
		if g_mOTPData(0) <> "00000" then
			Form.MsgBox( "알림", g_mOTPData(1), "", 6 )
		else
			Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_RETURN", g_mOTPData(2))
		end if
		
	elseif sEventName == "MOTP_REQ_OTP_RETURN_10003" then
		g_mOTPData = Split(sParam,"★")
		if g_mOTPData(0) <> "00000" then
			Form.MsgBox( "알림", g_mOTPData(1), "", 6 )
		else
			Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_RETURN2", g_mOTPData(2))
		end if
	end if
	
End Sub
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_SHOWKEYPAD", "")
	Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "MOTP_PWDCLEAR", "")
End Sub

