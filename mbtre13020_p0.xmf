'============================================================================
'20181210_01 KBC START
'============================================================================
Sub procChekBtn(sCheck)
	if Cint(grdList.rowcount) < 1 then  '20201016 SWJ : 전체선택 에러 수정(rowcount 정수화)
		exit sub
	end if
	
	For nRowIdx = 0 To grdList.rowcount - 1
		szCd = grdList.GetCellData("bd_Cd", nRowIdx)
		'=======================
		
		sztempExid = Right(szCd,len(szCd) - instrRev(szCd,"."))			
		sztempCode = Replace(szCd,"." & sztempExid,"")
		
		szLinkCode = sztempExid & "@" & sztempCode
		
		if CheckMasterFile(szLinkCode) then
			'마스터 파일에 있다
			grdList.SetCellData("bd_Chk", nRowIdx, sCheck)
		else
			grdList.SetCellData("bd_Chk", nRowIdx, "0")
			Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
		end if
		
		
		'=======================
'		szMk = Form.GetItemCodeInfo(szCd, "market")
'		
'		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then		
'			grdList.SetCellData("bd_Chk", nRowIdx, sCheck)
'		else
'			szCutCd = Mid(szCd, 2, Len(szCd))
'			szMk = Form.GetItemCodeInfo(szCutCd, "market")
'
'			if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
'				grdList.SetCellData("bd_Chk", nRowIdx, sCheck)
'			else
'				grdList.SetCellData("bd_Chk", nRowIdx, "0")
'				grdList.SetCellData("bd_rslt", nRowIdx, "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
'			end if
'		end if
	Next
End Sub

'============================================================================
Sub grdList_OnHeaderClickUp(lRow, szCellID)
	if CInt(grdList.rowcount) < 1 then 
		exit sub
	end if
	
	For nRowIdx = 0 To CInt(grdList.rowcount) - 1
		sChk = grdList.GetCellData("bd_Chk", nRowIdx)
		if sChk == "0" then
			Exit For
		end if
	Next	
	
	if sChk == "1" then
		sChk = "0"
	else 
		sChk = "1"
	end if
	
	If szCellID == "th_cellChk" then
		procChekBtn(sChk)
	end if
End Sub

'============================================================================
Sub btnUnsel_OnClick()
	procChekBtn("0")
End Sub

'============================================================================
Sub btnSel_OnClick()
	procChekBtn("1")
End Sub

'============================================================================
Sub btnCnl_OnClick()
	nOrdCnt = 0
	
	For nRowIdx = 0 To grdList.rowcount - 1
		sChk = grdList.GetCellData("bd_Chk", nRowIdx)
		if sChk == "1" then
			nOrdCnt = nOrdCnt + 1
		end if
	Next		
	
	if nOrdCnt > 0 then
		szAcntName = Form.GetAccountInfo(g_szAcnt, "name")
		strWarn = "계좌번호 " & g_szAcnt & "-" & g_szAcntCd & " " & szAcntName & "\n\n"
		strWarn = strWarn & "선택된 " & nOrdCnt & "건에 대한 일괄 취소주문을 하시겠습니까?"	
		
		Form.MsgBox("일괄취소 주문확인", strWarn, "CnclOrd", 1)
	else
		strWarn = "일괄 취소할 종목을 체크하여 주십시오."
		
		Form.MsgBox("일괄취소 주문확인", strWarn, "", 0)
	end if
End Sub

'============================================================================
Sub proc_CnclOrd(lRow)
	
	if Trim(edtPwd.caption) == "" then
		Form.ShowAlert("알림", "비밀번호를 확인 후 다시 입력하십시오.")
		exit sub
	end if
	
	g_CnclOrdRow = lRow
	
	szCd		= grdList.GetCellData("bd_Cd"		, lRow)
	szQty	= grdList.GetCellData("bd_MicheQty"	, lRow)
'	szClsCd	= grdList.GetCellData("bd_ClsCd"	, lRow) '주문조건구분
	szOrgNo	= grdList.GetCellData("bd_OdrNo"	, lRow)	
	szAll	= "Y"
	g_szWarnFlag = "N"

	DATAMANAGER.ClearInputData(0, "obtre_oder_001a")

	'=======
	sCodeData = Split(szCd, ".")	
	
	sztempExid = Right(szCd,len(szCd) - instrRev(szCd,"."))			
	sztempCode = Replace(szCd,"." & sztempExid,"")
	
	szLinkCode = sztempExid & "@" & sztempCode
	
	
	g_szNg = Form.GetItemCodeInfo(szLinkCode, "ovsnation")	' 국가구분코드
	g_szMk = Form.GetItemCodeInfo(szLinkCode, "exchid")		' 거래소벤더코드
	sMediaType = Form.GetSharedData("&MEDIA_CODE", false )
	'=======

	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ACNO"					, 0, g_szAcnt)		' 계좌번호(8)
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ASNO"					, 0, g_szAcntCd)		' 계좌일련번호(2)
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ACNT_PWD"				, 0, edtPwd.caption)	' 계좌 비밀번호
	'MTS메모리평문제거 미적용상태일 때
	else
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ACNT_PWD"				, 0, edtPwd.encdata)	' 계좌 비밀번호
	end if
	'20200910 SWJ END
	
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "OVRS_STCK_SYMB_ISCD"		, 0, sCodeData[0])	' 종목코드
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"		, 0, g_szMk)			' 거래소코드

	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_OQTY"				, 0, szQty)			' 주문수량
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ORGL_ODER_NO"			, 0, szOrgNo)			' 원주문번호
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "WHOL_RCTF_CNCL_YN"		, 0, szAll)			' 전체 취소 취소여부(CFD는 전량 취소)
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "WARN_CNFR_YN"			, 0, g_szWarnFlag)	' 경고확인여부
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "SVC_CLS_CODE"			, 0, "104")			' 서비스 구분 코드
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "BSKT_NO"					, 0, "")				' 바스켓번호(null)
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_GRP_NO"				, 0, "0")			' 주문그룹번호(0 고정)
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0, sMediaType)			' 매체구분코드(156:iOS, 157:안드로이드)
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, "01")			' 주문발생유형코드(01:일반주문, 03:반대주문)
	DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "LQDT_CLCD"				, 0, "1")			' 반대매매구분코드

	DATAMANAGER.RequestTranData("obtre_oder_001a")
End Sub

'============================================================================
Sub btnClose_OnClick()
'20230811 htw start FormClose로 위치 변경
'	Form.SendReturnToParent("12000_CLOSE", "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	if bCancelFlag then
		Form.SendReturnToParent("13020_CLOSE", bCancelFlag)
	else
		Form.SendReturnToParent("13020_CLOSE", "")
	end if
End Sub
'20230811 htw end FormClose로 위치 변경
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CnclOrd" then
		if sRet == "ok" then
			'일괄취소주문 실행
			For nRow = 0 To grdList.rowcount - 1
				sChk = grdList.GetCellData("bd_Chk", nRow)
				if sChk == "1" then
					g_bOrdIng = true
					proc_CnclOrd(nRow)
					exit for
				end if
			Next				
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtre_oder_001a" then
	MsgBox(szTranID,szErrMsg)
		szTranMsg = szErrMsg
		szSubMsg = Trim(DATAMANAGER.GetDataMsgSubText(szTranID))
		
		if szSubMsg == "" then
			grdList.SetCellData("bd_rslt", g_CnclOrdRow, szTranMsg)
		else
			grdList.SetCellData("bd_rslt", g_CnclOrdRow, szTranMsg & "(" & szSubMsg & ")")
		end if
		
		grdList.SetCellData("bd_Chk", g_CnclOrdRow, "0")
		
		'다음주문 처리
		bQuiry = true;
		g_CnclOrdRow = g_CnclOrdRow + 1
		
		For nRow = g_CnclOrdRow To grdList.rowcount - 1
			sChk = grdList.GetCellData("bd_Chk", nRow)
			if sChk == "1" then
				bQuiry = false;
				proc_CnclOrd(nRow)
				exit for
			end if
		Next	
		
		if bQuiry == true then
			g_bOrdIng = false
			Form.ShowAlert("알림", "모든 주문이 완료되었습니다. 미체결내역 조회를 통해서 주문결과를 다시 확인하시기 바랍니다.")
			'20230811 htw start 일괄취소 한 경우 T변경
			bCancelFlag = true
			'20230811 htw end 일괄취소 한 경우 T변경
			DATAMANAGER.RequestTranData("obtre_cntg_001r") '재조회			
		end if
	else
		if Len(Trim(szErrMsg)) > 0 then
			Form.Toast(0, szErrMsg, 0)		
		end if
	end if
End Sub

'============================================================================
Sub btnSearch_OnClick()
	procInquiry()
End Sub

'============================================================================
Sub procInquiry()
	if g_bOrdIng == false then
		DATAMANAGER.RequestTranData("obtre_cntg_001r")
	else
		Form.Toast(0, "취소주문이 진행중입니다. 잠시후 조회하시기 바랍니다.", 0)
	end if
End Sub

