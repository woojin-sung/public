'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	g_bOrdIng = false
	
	Form.SetScreenName("해외CFD일괄취소")	

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_Tab      = tData(2)
		g_szGbn    = tData(3)
		g_szDeal   = tData(4) '매수매도구분
		g_szNew    = tData(5) '신규청산구분
		
		DATAMANAGER.RequestTranData("obtre_cntg_001r")
	end if
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtre_cntg_001r" then
		Dim DEAL_CLS_CODE, NEW_CLRN_CLCD
	
	'	grdList.rowcount = 0
		
		DEAL_CLS_CODE = g_szDeal
		NEW_CLRN_CLCD = g_szNew
	
'		DATAMANAGER.ClearInputData(0, "obtre_cntg_001r")
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ACNO"			, 0 , g_szAcnt )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ASNO"			, 0 , g_szAcntCd )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ODER_DATE"		, 0 , szDate )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "DEAL_CLS_CODE"	, 0 , DEAL_CLS_CODE)	
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "NEW_CLRN_CLCD"	, 0 , NEW_CLRN_CLCD)	
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "2" )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "UI_SORT_CLS_VAL"	, 0 , "2" )
		
		DATAMANAGER.ClearInputData(0, "obtre_cntg_001r")
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ACNO"			, 0 , g_szAcnt )
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ASNO"			, 0 , g_szAcntCd )
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ACNT_PWD"		, 0 , edtPwd.caption )
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "DEAL_CLS_CODE"	, 0 , DEAL_CLS_CODE)	' 매매구분코드(0:전체, 1:매수, 2:매도)
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "NEW_CLRN_CLCD"	, 0 , NEW_CLRN_CLCD)	' 신규청산구분코드(0:전체, 1:신규, 2:청산)
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "2")
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "UI_SORT_CLS_VAL"	, 0 , "2" )
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket

	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtre_cntg_001r" then	
	
		'20181210_01 KBC START
		szProcMsg = DATAMANAGER.GetDataMsgText(szTranID)
		if Len(Trim(szProcMsg)) > 0 then
			Form.Toast(0, szProcMsg, 0)
		end if
		'20181210_01 KBC END
	
		For iCnt = grdList.rowcount - 1 To 0 Step -1
			szItem = grdList.GetCellData( "bd_Cd", iCnt)
			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
'			If szMarket = "BN" or szMarket = "MM" Then
'				grdList.SetDeleteRow( iCnt )
'			Else
		
				'매매구분
				szData = grdList.GetCellData( "bd_TypeCd", iCnt)
				szData2 = grdList.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
				If szData = "1" Then
					grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
				Else
					grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
				End If
				
				
				If szData2 = "2" Then								'정정
					If szData = "1" Then
						grdList.SetCellData("bd_TypeNm", iCnt, "매도정정")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grdList.SetCellData("bd_TypeNm", iCnt, "매수정정")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
					
				ElseIf szData2 = "3" Then								'취소
					If szData = "1" Then
						grdList.SetCellData("bd_TypeNm", iCnt, "매도취소")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grdList.SetCellData("bd_TypeNm", iCnt, "매수취소")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
					End If
				End If
				
				'처리구분
				szData = grdList.GetCellData( "bd_ProcCd", iCnt)
				
				Select Case szData
					Case "0" grdList.SetCellData("bd_ProcNm", iCnt, "미접수")
					Case "1" grdList.SetCellData("bd_ProcNm", iCnt, "접수")
					Case "2" grdList.SetCellData("bd_ProcNm", iCnt, "확인")
					Case "3" grdList.SetCellData("bd_ProcNm", iCnt, "거부")
					Case "4" grdList.SetCellData("bd_ProcNm", iCnt, "PT효력정지")
				End Select
'			End If
		Next
	
	elseif szTranID == "obtre_oder_001a" then		
		szTranMsg = Trim(DATAMANAGER.GetDataMsgText(szTranID))
		szSubMsg = Trim(DATAMANAGER.GetDataMsgSubText(szTranID))
		
		if szSubMsg == "" then
			grdList.SetCellData("bd_rslt", g_CnclOrdRow, szTranMsg)
		else
			grdList.SetCellData("bd_rslt", g_CnclOrdRow, szTranMsg & "(" & szSubMsg & ")")
		end if
		
		grdList.SetCellData("bd_Chk", g_CnclOrdRow, "0")
	
		g_CnclOrdRow = g_CnclOrdRow + 1
		bQuery = true
		
		For nRow = g_CnclOrdRow To grdList.rowcount - 1
			sChk = grdList.GetCellData("bd_Chk", nRow)
			
			if sChk == "1" or sChk == 1 then
				bQuery = false
				proc_CnclOrd(nRow)
				
				exit for
			end if
		Next	
		
		if bQuery == true then
			g_bOrdIng = false
			Form.ShowAlert("알림", "선택된 주문이 모두 완료되었습니다. 미체결내역 조회를 통해서 주문결과를 반드시 확인하시기 바랍니다.")
			'20230811 htw start 일괄취소 한 경우 T변경
			bCancelFlag = true
			'20230811 htw end 일괄취소 한 경우 T변경
		end if
	'20181210_01 KBC END
	
	end if
End Sub

