'============================================================================
' 2017.10.20 -  LSS
' 연합인포맥스 종목검색-중국 화면
'
' 1. 화면상의 모든 DEFINE 은 initDefine() 함수에서 처리 함.
'============================================================================

Dim g_tblDefine
Dim g_sCode
Dim g_nNat '국가 
Dim g_nExid '거래소
Dim g_saveFg '종목메모수정 버튼 flag값
Dim g_rVal '팝업 닫힐때 리턴 값
Dim g_sName '한글 종목명
Dim g_rtChk '실시간 여부
Dim g_nSplitPos '현재가 화면확인
Dim g_szToday
Dim g_szScr	'화면번호 16000:해외시장, 16100:해외CFD

Dim g_sClsCd '현재가 종목상태구분코드 Y : 거래정지
Dim g_sSellOnly '현재가 거래상태 1 : 매도만가능

g_rVal = ""
g_szViewName = ""
'============================================================================
Sub Form_OnFormInit()
	initDefine()
	initDefault()
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
	g_szScr = Form.GetSharedData("&SCREEN_NO", 0 )	'20231226 HSZ: 해외CFD용 시세신청화면 추가
End Sub

'----------------------------------------------------------------------------
' 2017.10.18 -  LSS
' 통신 함수
'----------------------------------------------------------------------------
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szItemCode, szItemName, szOrderState,szExKor
	g_nNat = Form.GetItemCodeInfo(g_sCode, "exchcode3") 'URL 거래소코드

	if szTranID == "ohhts_6000_001r" then
		szExKor = Transform_Exid(g_nNat)
		ctnMain.tblDetail.SetCellString("3", "3", szExKor)
		
		g_sName = DATAMANAGER.GetDataValue(false, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" , 0)
		
		g_sClsCd = DATAMANAGER.GetDataValue(false, "ohhts_6000_001r", "OutBlock1", "FIDX_ISSU_STAT_CLS_CODE" , 0)
		g_sSellOnly = CInt(DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_SELL_ONLY", 0)) '거래상태
		
		sEtfYn = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ETF_YN", 0) ' ETF여부
		
		'20231211 SWJ START : 기존 ETF여부 필드는 ETF, ETN 동일하게 "Y"로 내려와 구분하기 위한 신규 필드 추가
		sEtfEtn = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ETF_TYPE_CODE", 0) 
		'20231211 SWJ END
		
		sLvrg = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FID_LVRG", 0) ' 레버리지
		
		'20231211 SWJ START
		'if sEtfYn = "Y" then
		if sEtfEtn = "001" then
			sTemp = "ETF(" & FormatNumber(sLvrg,1) & ")"
			ctnMain.tblDetail.SetCellString("2", "1", sTemp)
		elseif sEtfEtn = "002" then
			sTemp = "ETN(" & FormatNumber(sLvrg,1) & ")"
			ctnMain.tblDetail.SetCellString("2", "1", sTemp)
		end if
		'20231211 SWJ END
		
		DATAMANAGER.RequestTranData( "obsim_oscm_331r" )
		
	elseif szTranID = "ohhts_memo_013r" Then
		If g_saveFg = True Then
			g_saveFg = False
			DATAMANAGER.RequestTranData( "ohhts_memo_013r" )
		End If
		
	elseif szTranID = "obsim_oscm_331r" Then
		Dim ssSellOnly,sStatus,WeekDate,sMrktCls
		
		sSellOnly   = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN", 0) ' 매수불가여부
		sStatus     = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock1", "TRHT_YN", 0) 		' 거래정지여부
		sWeekDate   = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "STND_DATE", 0) 	' 기준일
		sMrktCls    = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "HLDY_YN", 0) 		' 휴일여부
		

		sWeekDate = WeekDay( CDate( Left( sWeekDate, 4 ) & "-" & Mid( sWeekDate, 5, 2 ) & "-" & Right( sWeekDate, 2 ) ) )
		If Trim( sMrktCls ) = "Y" And sWeekDate <> "1" And sWeekDate <> "7" Then		'일요일, 토요일 제외
			ctnMain.tblDetail.SetCellString("3", "1", "휴장")
		Else
			if g_sClsCd == "Y" then
				ctnMain.tblDetail.SetCellString("3", "1", "거래정지")
			else
				ctnMain.tblDetail.SetCellString("3", "1", "정상")
				if g_sSellOnly == 1 then
					ctnMain.tblDetail.SetCellString("3", "1", "매도만가능")
				end if
			end if
		End If	
	
		'20230906 증거금/대출 표기 추가
		DATAMANAGER.RequestTranData( "obsim_oscm_350r" )
	
	'20230906 증거금/대출 표기 추가
	elseif szTranID == "obsim_oscm_350r"	then
		Dim szMgrtVal, szLoanAbleYn
		szMgrtVal = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "MGRT_VAL", 0)
		szLoanAbleYn = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "LOAN_ABLE_YN", 0)
		
		ctnMain.tblDetail.SetCellString(10, 1, szMgrtVal)
		if szLoanAbleYn == "Y" then
			ctnMain.tblDetail.SetCellString(10, 3, "가능")
		else
			ctnMain.tblDetail.SetCellString(10, 3, "불가능")
		end if
	end if
End Sub

'============================================================================
'해외주식 종목상세 조회
'============================================================================
Sub reqItemDetail(szItemValue)
	g_sCode = szItemValue
	DATAMANAGER.RequestTranData( g_tblDefine["TRAN_DETAIL"] )
	DATAMANAGER.RequestTranData( g_tblDefine["TRAN_MEMO"] )
	
End Sub

'[[ DATAMANAGER 조회 BEFORE ]]
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sTemp, sExid, sCode
		
	sTemp = split(g_sCode, "@")
	sExid = sTemp[0] '시장구분
	sCode = sTemp[1] '종목코드 
	g_rtChk = Form.GetSharedData( "REALTIME_"..sExid, false )
	
	
	if szTranID == "ohhts_6000_001r" then

		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sExid)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk)
	elseif szTranID = "ohhts_memo_013r" Then	
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false )

		If g_saveFg = false Then		
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" 		, 0 , g_sCode )
			
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , "OV" )
		Else
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
			If Trim(ctnMain.edtMemo.caption) = "" Then
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 	, 0 , "5" )
			Else
				DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 	, 0 , "4" )
			End If
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MOD_YMDH"			, 0 , g_szToday )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE"		, 0 , g_sCode )
			
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" 			, 0 , g_sName )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_ISSU_MEMO_CNTT"		, 0 , ctnMain.edtMemo.caption )
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 ,  "OV" )
		
		End If
		
	elseif szTranID == "obsim_oscm_331r"	then
		DATAMANAGER.SetDataValue( false, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , sCode.."."..sExid )
	
	'20230906 증거금/대출 표기 추가
	elseif szTranID == "obsim_oscm_350r"	then
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "ISCD" , 0 , sCode.."."..sExid )
	end if
end Sub

'============================================================================
Sub ctnMain_rdoType_OnClick(nIndex)
	Dim tData, tSub, szSelIndex
	tData = {
		["0"] = { "tblDetail", "imgDetailBg" , "edtMemo", "btnReport" , "btnMemoSave", "btnDisclaimer" , "btnSise" },
		
		["1"] = { "grdList", "btnDeleteAll" }
	}
	
	szSelIndex = CStr( nIndex )	
	For index, val in pairs( tData )
		if "table" == type(val) then
			For _, sVal in pairs( val )	
				if sVal == "btnMemoSave" or sVal == "btnSise" then
					Form.SetCtlProp( "ctnMain." & sVal, "left",  g_tblDefine[ ( ( index == szSelIndex ) and "POS_RIG" or "POS_HIDE" ) ] )
				elseif sVal == "imgDetailBg" or sVal == "btnDeleteAll" then
					Form.SetCtlProp( "ctnMain." & sVal, "left",  g_tblDefine[ ( ( index == szSelIndex ) and "POS_DEF_BOX" or "POS_HIDE" ) ] )
				else
					Form.SetCtlProp( "ctnMain." & sVal, "left",  g_tblDefine[ ( ( index == szSelIndex ) and "POS_DEF" or "POS_HIDE" ) ] )
				end if

				Form.SetCtlProp( "ctnMain." & sVal, "visible",  ( index == szSelIndex ) and 1 or 0 )
			Next
		end if
	Next
	
	if nIndex == 1 then
		initRecentItem()
	end if
	

	
	initBtnVisible()
	

	Dim szSiseStat , szDisclStat
	szSiseStat = ctnMain.btnSise.visible
	szDisclStat = ctnMain.btnDisclaimer.visible
	
	if (szSiseStat == "0" or szSiseStat = false) AND (szDisclStat == "0" or szDisclStat = false) then
		
		'시세신청 버튼 비활성 and Disclaimer 버튼 비활성 일경우 'close 화면 높이 조절
		ctnMain.imgClose.top = g_tblDefine[ nIndex > 0 and "POS_CLOSE_REC" or"POS_CLOSE_IMG"]
	else
		ctnMain.imgClose.top = g_tblDefine[ nIndex > 0 and "POS_CLOSE_REC" or "POS_CLOSE_DEF" ]
	end if
	
	
End Sub

'============================================================================
' Disclaimer, 실시간 시세신청 버튼 Show/Hide 함수
' Disclaimer 일본 hide / 나머지 show
' 실시간 시세신청 MEDIA_CODE 158/159 일 경우 hide 나머지 show
'============================================================================
Function initBtnVisible()

	g_nExid = Form.GetItemCodeInfo(g_sCode, "exchcode3") '거래소 구분코드
	'홍콩/상해/심천/나스닥/뉴욕/아멕스
	if g_nExid == "TSE" then
		InitDisclaimerBtn(1)
	else
		InitDisclaimerBtn(0)
	end if


	mediaCd = Form.GetSharedData("&MEDIA_CODE",0)
	if mediaCd == "158" or mediaCd == "159" then
		InitSiseBtn(1)
	else
		szSiseStat = ctnMain.btnSise.visible
		if szSiseStat == "0" or szSiseStat == false then
			InitSiseBtn(1)
		else
			InitSiseBtn(0)
		end if
	end if

End Function


'============================================================================
Sub ctnMain_grdList_OnClickUp(lRow, szCellID)
	Dim szItemCode
	szItemCode = ctnMain.grdList.GetCellData( g_tblDefine["CODE"], lRow )
	szItemName = ctnMain.grdList.GetCellData( g_tblDefine["NAME"], lRow )

	Select Case szCellID
	Case g_tblDefine["DEL"]
		Form.DelRecentHistoryIMax( szItemCode )	
		ctnMain.grdList.SetDeleteRow( CDbl(lRow) )
		Exit Sub
		
	Case g_tblDefine["CODE"], g_tblDefine["NAME"]
		Dim sParam
		sParam = szItemCode & g_tblDefine["SPLIT"] & szItemName & g_tblDefine["SPLIT"] & ""
		
		Form.SetSharedData( g_tblDefine["LINKDATA"] , sParam )		
		Form.SendMessageToMain( g_tblDefine["SEND_MAIN"], sParam, "" )
		
		Form.CloseForm()
		Exit Sub
		
	End Select
End Sub

'============================================================================
Sub ctnMain_btnDeleteAll_OnClick()
	Form.DelAllHistoryIMax()
	ctnMain.grdList.SetClear()
End Sub

