'============================================================================
' 거래소 ID 이름으로 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 104
		return "홍콩"
	elseif sValue == "HSI" then ' 529
		return "항셍 지수"
'		return "중국"
	elseif sValue == "SHS" then ' 215
		return "상해"
'		return "중국"
	elseif sValue == "SZS" then ' 214
		return "심천"
'		return "중국"
	elseif sValue == "NYS" then ' 321
		return "뉴욕"
'		return "미국"
	elseif sValue == "AMX" then ' 66
		return "아멕스"
'		return "미국"
	elseif sValue == "NAS" then ' 537
		return "나스닥"
'		return "미국"
	elseif sValue == "NAO" then ' 130
		return "미국"
	elseif sValue == "SPI" then ' 625
		return "S&P"
	elseif sValue == "DJI" then ' 310
		return "다우존스"
	elseif sValue == "TSE" then ' 106
		return "도쿄"
	elseif sValue == "OSE" then ' 107
		return "오사카"
	elseif sValue == "JSD" then ' 112
		return "자스닥"
	elseif sValue == "NII" then ' 889
		return "니케이"
	elseif sValue == "NAI" then ' 538
		return "나스닥"
	elseif sValue == "HSX" then ' 770
		return "호치민"
	elseif sValue == "HNX" then ' 771
		return "하노이"
	end if
end Function
