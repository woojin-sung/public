'============================================================================
Sub initDefine()
	g_tblDefine = {
		["SPLIT"] = "★",
		["TRAN_DETAIL"] = "ohhts_6000_001r",
		["TRAN_MEMO"] = "ohhts_memo_013r",
		' 포지션		
		["POS_DEF"] = 8,
		["POS_DEF_BOX"] = 6,
		
		["POS_RIG"] = 190,
		["POS_HIDE"] = 375,
		["POS_CLOSE_DEF"] = 454, '312
		["POS_CLOSE_REC"] = 361,
		
		["POS_CLOSE_IMG"] = 420, '시세신청버튼, Disclaimer 버튼 둘다 안보일때
		
		' 그리드 셀 네임
		["CODE"] = "itemCode",
		["NAME"] = "itemName",
		["DEL"] = "itemDelete",
		["TYPE"] = "itemOrderType",
		["ITEMCD"] = "itemCd",
		' 연결정보
		["LINKDATA"] = "&ITEM_OVERSTOCK",
		' 반환 이벤트
		["SELECT_ITEM"] = "SELECT_ITEM",
		["SEND_MAIN"] = "CHANGE_ITEMCODE_OVERSTOCK",
		["MENU"] = "InfoMaxMenu",
	}
	
End Sub

'============================================================================
' 기본 정보 및 컨트롤 설정
'============================================================================
Function initDefault()
	g_saveFg = false
		
	Dim szData, szItemCode
	szData = Form.GetOpenLinkData()	
	
	g_nSplitPos = InStr( szData, "^" ) 
	if g_nSplitPos > 0 then
		arrData = Split(szData, "^")
		szData = arrData(0) 'itemCode
	end if
	
	szItemCode = getItemCode()
	
	if( not isNull( szData ) ) then
		szItemCode = szData
	end if
	
	if Null <> szItemCode and Len(szItemCode) > 0 then
		reqItemDetail(szItemCode)
	end if
	
	ctnMain_rdoType_OnClick(0)
	
	
End Function

'============================================================================
' 최근조회종목 설정
'============================================================================
Sub initRecentItem()
	Dim nHistoryCount, szItemHistory, tItemHistory, nRowCount, nCurCount
	
	ctnMain.grdList.SetClear()
	nRowCount = CInt( ctnMain.grdList.rowcount )
	
	nHistoryCount = Form.GetRecentHistoryIMaxCount()
	
	For i = nHistoryCount-1 to 0 Step -1
		szItemHistory = Form.GetRecentHistoryIMax(i)
		if( not isNull( szItemHistory ) ) then		
			tItemHistory = Split( szItemHistory, g_tblDefine["SPLIT"] )
			if Null <> tItemHistory and #tItemHistory >= 2 then
				Dim itemCd , sTemp
				ctnMain.grdList.insertrow = CInt(ctnMain.grdList.rowcount)
				
				ctnMain.grdList.SetCellData( g_tblDefine["CODE"], ctnMain.grdList.rowcount-1, tItemHistory[0] )
				
				if tItemHistory[0] <> "" then ' 시장@종목코드 에서 종목코드만 보여주기 위함
					itemCd = tItemHistory[0]
					sTemp = split(itemCd, "@")
				end if
				ctnMain.grdList.SetCellData( g_tblDefine["ITEMCD"], ctnMain.grdList.rowcount-1, sTemp[1] )
							
				ctnMain.grdList.SetCellData( g_tblDefine["NAME"], ctnMain.grdList.rowcount-1, tItemHistory[1] )
				
				if #tItemHistory >= 3 then
					ctnMain.grdList.SetCellData( g_tblDefine["TYPE"], ctnMain.grdList.rowcount-1, tItemHistory[2] )
				end if
			end if
		end if
	Next
End Sub

'DisclaimerBtn 세팅
'============================================================================
Function InitDisclaimerBtn(nIndex)
	if nIndex == 0 then
		ctnMain.btnDisclaimer.visible = true
		ctnMain.btnSise.left = g_tblDefine["POS_RIG"]
	else 
		ctnMain.btnDisclaimer.visible = false
		ctnMain.btnSise.left = g_tblDefine["POS_DEF"]
		
	end if
End Function 

'DisclaimerBtn 세팅
'============================================================================
Function InitSiseBtn(nIndex)
	if nIndex == 0 then
		ctnMain.btnSise.visible = true
	else 
		ctnMain.btnSise.visible = false		
	end if
End Function 

'============================================================================
' 종목코드 반환
'============================================================================
Function getItemCode()
	Dim tData, szData	
	szData = Form.GetSharedData( g_tblDefine["LINKDATA"], false )
	if (not isNull(szData) ) then
		tData = Split( szData, g_tblDefine["SPLIT"] )
		if Null <> tData and #tData >= 2 then
			return tData[0]
		end if
	end if
End Function

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function


