Dim g_CloseGb

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgPayment.setMaintainingRatio("1")
	contMain.imgNum1.setMaintainingRatio("1")
	contMain.imgNum2.setMaintainingRatio("1")
	contMain.imgNum3.setMaintainingRatio("1")
	contMain.imgNum4.setMaintainingRatio("1")
	contMain.imgNum5.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_CloseGb = "0"
'	Form.SetSharedData("mbonl88032_s1_TactYn", "")
	contMain.lblUpperBg.bgcolor = "397"
	contMain.lblUpperText1.fgcolor = "334"
	contMain.lblUpperText2.fgcolor = "398"
	
	
	contMain.lblTitle1.setHighlight(396, 0, 9)
	contMain.lblTitle2.setHighlight(396, 0, 6)
	contMain.lblTitle3.setHighlight(396, 0, 4)
	
	contMain.lblShowInfo.caption = "자세히 알아보기 >"
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		contMain.setScrollBarVisible("2")
		
		contMain.lblStepText4.changeTextAttr(16, 25, 146, -1, false)
	else
		contMain.lblStepText4.changeTextAttr(16, 26, 146, -1, false)
	end if
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
'	szOpenData = "Read_Only"
	if szOpenData == "Read_Only" then
		btnNext.visible = false
'		contMain.height = 597
	'이체화면에서 넘어온 경우 (이체실패,약정등록성공시)
	elseif szOpenData == "TactRegSucc" then
		Form.height = 562	'20240429
		DATAMANAGER.RequestTranData( "obpds_srvc_436r" )
		
		'Form.SetSharedData("mbonl88032_s1_TactYn", "Y")		
		Form.OpenPopup("mbonl88032_s1" , "cancel" , "")
	else
		Form.height = 562	'20240429
		'바로출금서비스 약정현황 조회
'		if acnt.caption <> "" and acnt.caption <> null then
			DATAMANAGER.RequestTranData( "obpds_srvc_436r" )
'		end if
	end if
End Sub

'============================================================================


'============================================================================
Sub btnNext_OnClick()
	if trim(btnNext.caption) == "신청정보 보기" then
		contMain.scroll_pos = 0
		
		Form.OpenPopup("mbonl88032_s1" , "cancel" , "")
	else
		'약정가능대상 검증 후 진행
		DATAMANAGER.RequestTranData( "obpds_srvc_435a" )
'		Form.OpenPopup("mbonl88032_s1" , "reg" , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false)
	
	'바로출금서비스 약정현황 조회
	if szTranID == "obpds_srvc_436r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD" , 0 , "093")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum)
		
		'고객번호만으로 조회되도록 서비스 수정됨
'		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
'		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence)
	
	'바로출금서비스 약정신청
	elseif szTranID == "obpds_srvc_435a" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "5")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD" , 0 , "093")
'		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVC_SRNO" , 0 , "0")

		if acnt.caption <> "" and acnt.caption <> null then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence)
		end if
'		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'바로출금서비스 약정현황 조회
	if szTranID == "obpds_srvc_436r" then
		Dim szStplYn
		szStplYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STPL_YN" , 0)
		if szStplYn == "Y" then
			btnNext.caption = "신청정보 보기"
		else
			btnNext.caption = "서비스 신청하러가기"
		end if
	
	'바로출금서비스 약정신청
	elseif szTranID == "obpds_srvc_435a" then
		Dim szProsAbleYn, szErrCode, szDtlCntt
		szProsAbleYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "PROS_ABLE_YN" , 0)
		if szProsAbleYn == "N" then
			szErrCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ERR_CODE" , 0)
			szDtlCntt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "DTL_CNTT" , 0)
			if szErrCode == "0400" or szErrCode == "0500" or Left(szErrCode, 2) == "07" or szErrCode == "0900" then
				Form.MsgBox("안내", szDtlCntt, "PROS_ABLE_NO", 7, "고객지원센터", "확인")
			
			'약정가능한 계좌없는 케이스
			'일단 다음 화면까지 넘어간 후 예외처리
			elseif szErrCode == "0200" then
				contMain.scroll_pos = 0
			
				Form.OpenPopup("mbonl88032_s1" , "reg" , "")
				
			elseif szErrCode == "1300" then	
				Form.MsgBox("안내", szDtlCntt, "PROC_PHONE_NUM", 7, "등록하기", "확인")
			else
				Form.MsgBox("안내", szDtlCntt, "", 6)
			end if
		else
			contMain.scroll_pos = 0
			
			Form.OpenPopup("mbonl88032_s1" , "reg" , "")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'약정신청 완료
	if sKeyName == "mbonl88032_s1" then
		'이체화면에서 넘어온 경우 (이체실패,약정등록성공시)
'		tTactYn = Form.GetSharedData("mbonl88032_s1_TactYn", false )
'		if tTactYn == "Y" then
'			g_CloseGb = "3"
'			Form.CloseForm()
'		else
			contMain.scroll_pos = 0
		
			'약정현황 다시 조회
			DATAMANAGER.RequestTranData( "obpds_srvc_436r" )
'		end if
	elseif sKeyName == "mbonl88032_p3" then
		contMain.scroll_pos = 0
	
		'약정현황 다시 조회
		DATAMANAGER.RequestTranData( "obpds_srvc_436r" )
		
		if sRet == "2" then
			g_CloseGb = "3"
			Form.CloseForm()			
		end if
	end if
End Sub

'============================================================================
Sub contMain_lblShowInfo_OnClick()
	Form.OpenFramePopup("mbonl88032_p1" , "" , "")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "PROS_ABLE_NO" and sRet == "ok" then
		g_CloseGb = "1"
		Form.CloseForm()
		'고객지원센터 이동
		'Form.OpenScreen("89020" , "")
	elseif sKeyName == "PROC_PHONE_NUM" and sRet == "ok" then
		g_CloseGb = "2"
		Form.CloseForm()		
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_CloseGb == "1" then
		'고객지원센터 이동
		Form.OpenScreen("89020" , "")
	elseif g_CloseGb == "2" then
