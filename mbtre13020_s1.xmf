'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 현재가 호가연동
	' ----------------------------------------------------------------------		
	if sEventName == "PRICE" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
		
	' ----------------------------------------------------------------------
	' 호가테이블 클릭 호가연동
	' ----------------------------------------------------------------------	
	elseif sEventName == "HOGA" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
		
	' ----------------------------------------------------------------------
	' 메인화면 이벤트처리 (종목변경/탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	elseif sEventName == "13000_InitCode" or sEventName == "13000_ChangeCode" or sEventName == "13000_ChangeTab" then	
'		g_bItemFirstStart = true
		g_nAbleQty, g_nAbleQtyCS = 0, 0
		lblAbleQty.caption = "0"
		lblAbleQtyCS.caption = "0"
		
		if g_szCd <> sParam then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		' 거래소벤더코드
		end if
'		f_Request004()
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		
		if sEventName == "13000_ChangeTab" then
			f_Request004()
		end if
		
'		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
'		end if
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "13000_ChangeAcnt" then
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
			
	' 20171127 HAMWG END	
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
			
			Return_AutoQty()
		else
			Init_InputControl()
		end if
		'20170919 HAMWG END
	elseif sEventName == "BUY_MORE_RETURN" then'추가매수
		rdo0.currentindex = "0"
		rdo0_OnClick(0)
	elseif sEventName == "SELL_CLEAR_RETURN" then'매도청산
		rdo0.currentindex = "1"
		rdo0_OnClick(1)
		g_nAbleQtyCS = sParam
'		edtQty.caption = g_nAbleQtyCS
'		edtQty_OnEditComplete()
		lblAbleQtyCS.caption = g_nAbleQtyCS
	elseif sEventName == "AFTER_TR_027" then'청산가능 TR 완료 후
'		g_bItemFirstStart = true
'		f_Request004()
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	

	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		'20160829_01 LKM START
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
		 Form.SetSharedData("B_QTY_TYPE" , "2")
		'20160829_01 LKM END		
		
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
		
	' ----------------------------------------------------------------------
	' 해외주식 미체결팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "13000_CONTRACT" then
		if sRet == "" then
			Exit Sub
		end if
		
		g_bCntrtRtn = true
		Return_ContractScreen(sRet)	
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'주문유형에 따른 주문단가
	szPrc = edtPrc.caption
	' HTS에서 가격없고, 가능금액조회시 현재가를 넣어준다.
	if Trim(szPrc) == "" and (szTranID == "obtro_comn_025r" or szTranID == "obtre_oder_004r" or szTranID == "obtre_oder_004r_2") then
		if g_szLast == "" or CDbl(g_szLast) == 0 then
			szPrc = 0
		else
			szPrc = g_szLast
		end if
	end if

	'====================================
	' 해외CFD 매수주문
	'====================================
	if szTranID == "obtre_oder_001a" then
		g_szTR = szTranID
		sCodeData = Split(g_szCd, "@")
		sMediaType = Form.GetSharedData("&MEDIA_CODE", false )
		
		DATAMANAGER.ClearInputData(0, "obtre_oder_001a")

		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ACNT_PWD"		, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ACNT_PWD"		, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									' 거래소코드
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0, szPrc)									' 주문단가
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_OQTY"			, 0, CLng(edtQty.caption))						' 주문수량
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_CLS_CODE"		, 0, "01")									' 주문구분코드(01:지정가)
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")									' 주문조건구분코드
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)							' 경고확인여부
		if CInt(rdo0.currentindex) == 0 then'신규
			DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "SVC_CLS_CODE"		, 0, "102")									' 서비스구분코드(102:신규매수)
		else
			DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "SVC_CLS_CODE"		, 0, "112")									' 서비스구분코드(102:신규매수)
		end if
		
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "BSKT_NO"				, 0, "")										' 바스켓번호(null)
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_GRP_NO"			, 0, "0")									' 주문그룹번호(0)
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0, sMediaType)								' 매체구분코드(156:iOS, 157:안드로이드)
		
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtre_oder_001a", "InBlock1", "LQDT_CLCD"			, 0, "1")									' 반대매매구분코드(1:정상)
		
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_6000_001r" then
		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
		
	' ----------------------------------------------------------------------
	' 고시환율 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )
	
	'====================================
	' 주문가능금액 조회(100%)
	'====================================
	elseif szTranID == "obtre_oder_004r" or szTranID == "obtre_oder_004r_1" or szTranID == "obtre_oder_004r_2" then
		sOvrsCode = ""
		sCodeData = Split(g_szCd, "@")
		if CInt(ubound(sCodeData)) > 0 then
			sOvrsCode = sCodeData[1].."."..sCodeData[0]
		end if
		
		sCFDExch 	= Get_CFDExch(g_szMk)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm =="1" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "caption"))' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CFD_EXCH_CODE"	, 0 , sCFDExch)									' 거래소코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"			, 0 , sOvrsCode)									' 종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVC_CLS_CODE"	, 0 , "102")										' 서비스구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_CLS_CODE"	, 0 , "01")										' 주문구분코드
		if szTranID == "obtre_oder_004r" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CFD_ODER_PRC"	, 0 , szPrc)										' 가격에디트
		elseif szTranID == "obtre_oder_004r_1" or szTranID == "obtre_oder_004r_2" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CFD_ODER_PRC"	, 0 , g_szLast)									' 현재가
		end if
		
	'====================================
	' 청산가능금액
	'====================================
	elseif szTranID == "obtre_oder_005r" then
		sOvrsCode = ""
		sCodeData = Split(g_szCd, "@")
		if CInt(ubound(sCodeData)) > 0 then
			sOvrsCode = sCodeData[1].."."..sCodeData[0]
		end if
		
		sCFDExch 	= Get_CFDExch(g_szMk)

		DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "ACNO"				, 0 , Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "ASNO"				, 0 , Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm =="1" then
			DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "caption"))' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "CFD_EXCH_CODE"	, 0 , sCFDExch)									' 거래소코드
		DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "ISCD"			, 0 , sOvrsCode)									' 종목코드
		DATAMANAGER.SetDataValue( 0, "obtre_oder_005r", "InBlock1", "SVC_CLS_CODE"	, 0 , "111")										' 서비스구분코드

	'----------------------------------------------------------------------
	' 20210329 LES START 통합증거금 - 약정조회
	'----------------------------------------------------------------------
	elseif szTranID == "obacp_comm_005r" then
	
		DATAMANAGER.SetDataValue(0, "obacp_comm_005r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obacp_comm_005r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obacp_comm_005r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
		
	elseif szTranID == "obpds_srvc_158r" then
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "CSNO" 			, 0 , gCustNo)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "SVCD" 			, 0 , "081")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
		DATAMANAGER.SetDataValue(0, "obpds_srvc_158r", "InBlock1", "RMND_SRNO" 		, 0 , "")
	
	elseif szTranID == "obtre_comm_005r" then
		sOvrsCode = ""
		sCodeData = Split(g_szCd, "@")
		if CInt(ubound(sCodeData)) > 0 then
			sOvrsCode = sCodeData[1].."."..sCodeData[0]
		end if
		
		sHostDate = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue(0, "obtre_comm_005r", "InBlock1", "ISNM" 	, 0 , sOvrsCode)
		DATAMANAGER.SetDataValue(0, "obtre_comm_005r", "InBlock1", "STND_DATE" 	, 0 , sHostDate)
	
	'20220217 SWJ START
	elseif szTranID = "obrtd_drng_036r" then
		DATAMANAGER.SetDataValue(0, "obrtd_drng_036r", "InBlock1", "ACNO" , 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obrtd_drng_036r", "InBlock1", "ASNO" , 0 , Form.GetTopCtlProp("acnt", "sequence"))	
	'20220217 SWJ END
	
	'20230320 SWJ START
	elseif szTranID == "obtre_oder_201r" then
		DATAMANAGER.SetDataValue(0, "obtre_oder_201r", "InBlock1", "ACNO" , 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obtre_oder_201r", "InBlock1", "ASNO" , 0 , Form.GetTopCtlProp("acnt", "sequence"))	
	elseif szTranID == "obtre_comm_027r" or szTranID == "obtre_comm_027r_1" then
		DATAMANAGER.ClearInputData(0, szTranID)
		szDate =  CInt(Form.GetSharedData( "&HOST_DATE", 0 ))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE", 0, szDate)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, Form.GetTopCtlProp("acnt", "sequence"))	
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		
		szCd = Form.GetTopCtlProp("ItemCode0", "code")
		
		sCodeData = Split(szCd, "@")
		szMk = Form.GetItemCodeInfo(szCd, "exchid")		' 거래소벤더코드
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_SYMB_ISCD", 0, sCodeData[1])'해외주식심볼종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_EXCH_VNDR_IDNO", 0, szMk)'해외거래소벤더식별번호
	end if
	'20171204 HAMWG END
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo

	'====================================
	' 해외CFD 매수주문
	'====================================
	Select Case szTranID		
		Case "obtre_oder_001a"	
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
				if Trim(szOrdCd) == "0001" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
					
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						Form.triggerEvent("#", "AfterOrd", szOrgNo)
					end if
					
					DATAMANAGER.ClearInputData(0, "obtre_comm_005r")
					DATAMANAGER.RequestTranData("obtre_comm_005r")
					
					'230914 htw start 주문 후 수량 조회
					if CInt(rdo0.currentindex) == 0 then'신규일 때만
						f_Request004()'가능수량 조회
					else
						DATAMANAGER.RequestTranData("obtre_comm_027r")
					end if
					'230914 htw end 주문 후 수량 조회
					
				end if
			end if
			' 20181022 HWG END

	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
		Case "ohhts_6000_001r"

			g_szLast		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 	, 0 )	' 현재가
			g_szUpLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" 	, 0 )))	' 상한가
			g_szDnLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" 	, 0 )))	' 하한가
'			g_szUnit		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ASPR_UNIT" 	, 0 )	' 호가단위
			g_szOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" , 0 )	' 매매단위
			g_szCur		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 	, 0 )	' 통화
			g_szDecimal 	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
			g_szKorName	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" 	, 0 )	' 한글종목명
			g_szTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_TICK_CLS" 	, 0 )	' 종목 틱타입
'			g_szKofx		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 		, 0 )	' 환율
			
			GetHogaUnit(g_szMk, g_szLast, 0)		'20180710 HAMWG : 호가단위 설정함수 변경
			DATAMANAGER.RequestTranData("obtre_comm_027r_1")
'			g_bItemFirstStart = true
'			f_Request004()'20230904 htw start 가능수량 조회 tr 추가
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
			edtPrc.mask = sMask
			Table0.SetCellMaskInfo(2, 1, sMask)
			
			Table0.SetCellString(2, 0, g_szCur)
			Table0.SetCellString(0, 1, g_szOrdSize)
			
			
			DATAMANAGER.ClearInputData(0, "obtro_comn_025r")
			DATAMANAGER.ClearInputData(0, "obtre_comm_005r")
			
			DATAMANAGER.RequestTranData("obtro_comn_025r")
			DATAMANAGER.RequestTranData("obtre_comm_005r")
			
		Case "obtre_comm_005r"
			szBuyAble = DATAMANAGER.GetDataValue(0, "obtre_comm_005r", "OutBlock1", "BYOV_ABLE_YN" , 0)
			
'			DATAMANAGER.ClearInputData(0, "obtre_oder_005r")
'			DATAMANAGER.RequestTranData("obtre_oder_005r")
			
			if szBuyAble == "Y" then
				sMask = "0,0,,주,0,,0,1,1,2,0"
				'Table1.SetCellMaskInfo(0, 1, sMask)		'20230320 SWJ START
				'Table1.SetCellMaskInfo(1, 1, sMask)
				
'				DATAMANAGER.ClearInputData(0, "obtre_oder_004r_1")
'				DATAMANAGER.RequestTranData("obtre_oder_004r_1")
			else
				sMask = "0,0,,,0,,0,1,1,2,0"
				'Table1.SetCellMaskInfo(0, 1, sMask)		'20230320 SWJ START
				'Table1.SetCellMaskInfo(1, 1, sMask)
				
				'Table1.SetCellString(0, 1, "불가")
				'Table1.SetCellString(1, 1, "불가")		'20230320 SWJ START
			end if
			
		Case "obtro_comn_025r"
			szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
			Table0.SetCellString(1, 1, szAnncExrt)
			
		'====================================
		'가능수량
		'====================================
		Case "obtre_oder_004r"
			szAbleQty = DATAMANAGER.GetDataValue( 0, "obtre_oder_004r", "OutBlock1", "ODER_ABLE_OQTY" , 0 )	' 현금가능수량
			lblAbleQty.caption = szAbleQty
			g_nAbleQty = lblAbleQty.caption
			'20230926 htw start 가능수량 버튼 클릭 시 edt에 삽입 추가
			if g_bClickedAbleBtn then
				g_bClickedAbleBtn = false
				edtQty.caption = g_nAbleQty
				edtQty_OnEditComplete()
			end if
			'20230926 htw end 가능수량 버튼 클릭 시 edt에 삽입 추가
'			szPer = Cint(cmbCash.cbkeydata)

'			if szAbleQty == null or szAbleQty == "" then
'				edtQty.caption = 0
'			else 
'				nAbleQty = Fix(szAbleQty)
'				edtQty.caption = Fix(nAbleQty / 100 * szPer) 
'			end if		
'			edtQty_OnEditComplete()

		'20210329 LES START 통합증거금 - 약정조회
		Case "obacp_comm_005r"
			
			gCustNo = DATAMANAGER.GetDataValue(0, "obacp_comm_005r", "OutBlock1", "CSNO" , 0)
			DATAMANAGER.RequestTranData("obpds_srvc_158r")
			
		
		Case "obpds_srvc_158r"
		
			szCnt = DATAMANAGER.GetDataCount(0, "obpds_srvc_158r", "OutBlock1")
			
			if szCnt > 0 then
				gTotalYN = true
			else
				gTotalYN = false
			end if
		
		'20220217 SWJ START
		Case "obrtd_drng_036r"
			szOutAcno = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "CNFT_ACNO" 		, 0)		'출금계좌번호
			szOutAsno = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "CNFT_ASNO" 		, 0)		'출금계좌일련번호
			szOutPrnm = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "PRNM" 			, 0)		'출금상품명
			szInPrnm  = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "MNRC_ACNT_PRNM"   , 0)		'입금상품명
			szAbleAmt = DATAMANAGER.GetDataValue(0, "obrtd_drng_036r", "OutBlock1", "DRNG_ABLE_AMT"    , 0)		'출금가능금액
			
			'20200910 SWJ START
			'MTS메모리평문제거 적용상태일 때
			if plain_rm == "1" then
				sztmpPwd = Form.GetTopCtlProp("edtPwd", "caption")		' 계좌 비밀번호
			'MTS메모리평문제거 미적용상태일 때
			else
				sztmpPwd = Form.GetTopCtlProp("edtPwd", "encdata")		' 계좌 비밀번호
			end if	
			
			'출금가능액 >= 증거금부족액
			if CDbl(szAbleAmt) >= CDbl(g_ShortAmt) then
				szData = "0" & "@" & szOutAcno&szOutAsno & "@" & szOutPrnm & "@" & szAbleAmt & "@" & Form.GetTopCtlProp("acnt", "total") & Form.GetTopCtlProp("acnt", "sequence") & "@" & sztmpPwd & "@" & szInPrnm & "@" & g_ShortAmt & "@" & "매수"
			'출금가능액 < 증거금부족액
			else
				szData = "1" & "@" & szOutAcno&szOutAsno & "@" & szOutPrnm & "@" & szAbleAmt & "@" & g_ShortAmt
			end if
			
			
			'대체주문확인팝업
			Form.OpenPopup("mbtre13000_p11" , szData , "")
		'20220217 SWJ END
		
		'20230320 SWJ START
		Case	 "obtre_oder_201r"
			szCRCD = DATAMANAGER.GetDataValue(0, "obtre_oder_201r", "OutBlock1", "CRCD" 		, 0)		'통화코드
		'	sMask = "0,0,,".." "..szCRCD..",0,,2,1,1,2,0"
			
		'	Table1.SetCellMaskInfo(0, 1, sMask)
		
	End Select	
	
	if szTranID == "obtre_comm_027r" or szTranID == "obtre_comm_027r_1" then
		szQty = DATAMANAGER.GetDataValue(0, "obtre_comm_027r", "OutBlock1", "UI_SELN_CLRN_ABLE_QTY" 		, 0)
		lblAbleQtyCS.caption = szQty
		g_nAbleQtyCS = lblAbleQtyCS.caption
		
		'20230926 htw start 가능수량 버튼 클릭 시 edt에 삽입 추가
		if g_bClickedAbleBtn then
			g_bClickedAbleBtn = false
			edtQty.caption = g_nAbleQtyCS
			edtQty_OnEditComplete()
		end if
		'20230926 htw end 가능수량 버튼 클릭 시 edt에 삽입 추가
		
		if szTranID == "obtre_comm_027r_1" then
			g_bItemFirstStart = true
			f_Request004()'20230904 htw start 가능수량 조회 tr 추가
		end if
	end if
	
	if szTranID == "obtre_oder_004r_2" then
		nAbleQty = DATAMANAGER.GetDataValue(0, "obtre_oder_004r_2", "OutBlock1", "ODER_ABLE_OQTY" 		, 0)
		lblAbleQty.caption = nAbleQty
		g_nAbleQty = lblAbleQty.caption
		'20230926 htw start 가능수량 버튼 클릭 시 edt에 삽입 추가
		if g_bClickedAbleBtn then
			g_bClickedAbleBtn = false
			edtQty.caption = g_nAbleQty
			edtQty_OnEditComplete()
		end if
		'20230926 htw end 가능수량 버튼 클릭 시 edt에 삽입 추가
	end if
	
	g_szWarnFlag = "N"
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Select Case szTranID	
		'====================================
		'가능수량
		'====================================
		Case "obtre_oder_004r_1"
			nAbleQty = 0
			szAbleQty = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ODER_ABLE_OQTY" , 0 )	' 현금가능수량
			
			if szAbleQty == null or szAbleQty == "" then
				nAbleQty = 0
			else 
				nAbleQty = Fix(szAbleQty)
			end if 
			
			DATAMANAGER.SetDataValue(0, szTranID, "OutBlock1", "ODER_ABLE_OQTY" , 0 , nAbleQty)
	End Select	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "obtre_oder_004r_1" or szTranID == "obtre_oder_005r" or szTranID == "obtre_comm_005r" or szTranID == "obtre_oder_201r" then	'20230320 SWJ START
		exit sub
	end if
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'20220217 SWJ START : 증거금 부족 이후 대체출금 주문 요건 추가
	if szTranID == "obtre_oder_001a" then
		Select Case szErrCode
		
		'주문종료
		'Case "5988"

		'연결계좌 입금 후 주문
		Case "5989"
			'원장 내부 영향도로 인해 오류코드로 대체후 주문처리 할 것
			'증거금 부족금액은 주문모듈에서 계산해서 알 수 있는 값인데
			'오류로 떨어지면 증거금부족금액을 받을 수 있는 방법이
			'오류메시지에서 뿐이라.. (이체 쪽 서비스에서 받기엔 속도 및 유지보수 측면에서 별로)
			
			'증거금부족금액
			g_ShortAmt = tonumber(Trim(szSubMsg))

			DATAMANAGER.RequestTranData("obrtd_drng_036r") '임시
		Case Else
				
			if Trim(szSubMsg) <> "" then
				Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
				'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
			else
				Form.ShowAlert(g_szTitle, szErrMsg)
				'Form.Toast(0, szErrMsg, true)
			end if
		End Select
		
		exit sub
	end if
	'20220217 SWJ END
	
	if szTranID == "obtre_oder_004r" or szTranID == "obtre_oder_004r_2" then
		lblAbleQty.caption = "0"
		g_nAbleQty = 0
		'20231017 HSZ START: 신규매매불가 종목에러메시지 스킵처리
		if szErrCode = "8946" then
			exit Sub
		end if
		'20231017 HSZ END
	end if
	
	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
	if szTranID == "obtre_comm_027r" or szTranID == "obtre_comm_027r_1" then
		g_nAbleQtyCS = 0
		lblAbleQtyCS.caption = "0"
		
		szAcnt   = Form.GetTopCtlProp("acnt", "total")
		if Trim(szAcnt) = "" then
			exit sub
		end if
	'20231123 HSZ END
	end if
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
	end if
	
End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	
	'계좌번호
	szAcnt   = Form.GetTopCtlProp("acnt", "total")
	szAcntCd = Form.GetTopCtlProp("acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if
	
	szPrice = edtPrc.caption
	    
	if edtPrc.caption = "0" or edtPrc.caption = "" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
		exit Sub
	end if
	
	
	szMkClsCode = Get_MarketClsCode(g_szMk)
	szCurrency = Table0.GetCellString(2, 0)
	
	Dim szOvrsCode
	szCodeData = Split(g_szCd, "@")
	if CInt(ubound(szCodeData)) > 0 then
		szOvrsCode = szCodeData[1].."."..szCodeData[0]
	end if
	
	' 계좌번호(0,1) | 종목코드(2) | 거래소코드(3) | 통화단위(4) | 매수매도구분코드(5) | 주문수량(6) | 주문가격(7) | 신규청산구분코드(8)
'	szData = szAcnt & "★" & szAcntCd & "★" & szOvrsCode & "★" & szMkClsCode & "★" & szCurrency& "★" & "2" & "★" & edtQty.caption & "★" & szPrice & "★" & "1"
	szData = szAcnt & "★" & szAcntCd & "★" & szOvrsCode & "★" & szMkClsCode & "★" & szCurrency& "★" & "2" & "★" & edtQty.caption & "★" & szPrice
	
	if CInt(rdo0.currentindex) == 1 then
	    szData = szData & "★" & "2" 
	else
	    szData = szData & "★" & "1" 
	end if
	
	Form.OpenPopup("mbtre13000_p7" , szData , "")
End Sub

