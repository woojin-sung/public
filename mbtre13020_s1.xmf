Sub Button0_OnClick()
	g_bClickedAbleBtn = true'20230926 htw start 가능수량 버튼 클릭 판단
	if CInt(rdo0.currentindex) == 0 then'신규일 때만
		f_Request004()'가능수량 조회
	else
		DATAMANAGER.RequestTranData("obtre_comm_027r")
	end if
End Sub

