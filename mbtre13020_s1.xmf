'====================================
'CFD 거래소 코드 함수
'====================================
Function Get_CFDExch(stmpExidCode)
	Dim szVndrCode
    Select Case stmpExidCode 
	    Case "0537", "0321", "0066"
		    szVndrCode = "US"
	    Case "0215", "0214"
		    szVndrCode = "CN"
	    Case "0104"
		    szVndrCode = "HK"
	    Case "0106"
		    szVndrCode = "JP"
    End Select
    
    return szVndrCode

End Function

'============================================================================
'시장거래구분코드
'============================================================================
Function Get_MarketClsCode(szMarketCode)
	Dim szMarketClsCode
	Select Case szMarketCode
	    
	Case "0537", "0321", "0066"  			'미국
	    szMarketClsCode = "01"
	Case "0214"								'심천
	    szMarketClsCode = "04"
	Case "0215"								'상해
	    szMarketClsCode = "03"     
	Case "0104"								'홍콩
	    szMarketClsCode = "02"
	Case "0106"								'일본
	    szMarketClsCode = "05"
	End Select
	
	return szMarketClsCode
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption
	
	if Trim(szQty) <> "" then
		if CDbl(szQty) >= 99000000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	
	
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = g_szOrdSize
		else
			Exit Function
		end if
	else
'		if Len(szQty) = 1 or Len(szQty) = 2 then
'			nUnit = 1
'		else
'			nCnt = Len(szQty)-1
'			
'			For i = 0 to nCnt-1
'				if i == 0 then
'					szUnit = "1"
'				else
'					szUnit = szUnit & "0"
'				end if
'			Next
'			
'			nUnit = CDbl(szUnit)
'		end if

		nUnit = g_szOrdSize
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
	edtQty_OnEditComplete()
End Function

