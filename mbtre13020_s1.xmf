'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtQty_OnEditComplete()

	edtPrc.caption = ""
	edtPrc_OnEditComplete()
	
	'20230320 SWJ START : 주문실행 후 재조회
	DATAMANAGER.RequestTranData("obtre_oder_201r")
	'20230320 SWJ END
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szBuyQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTY")		' 매수수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szBuyQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTYCNT")	' 매수수량 주수(수량입력 선택시)
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매수수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szBuyQty) = "" then
		g_szBuyQty = "0"		
	end if	
End Function

'============================================================================
' Check_InputData : 주문데이터 사전 체크
'============================================================================
Function Check_InputData(nGbn)

	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn == 0 then
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
			return false
		end if	
	end if	
	
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup : 주문확인창 / 주문경고창 팝업
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	sCodeData = Split(g_szCd, "@")
	'신규/청산 구분
	if CInt(rdo0.currentindex) == 0 then
		szData = "0"													' 매매구분
	else
		szData = "2"												' 매매구분
	end if
	
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
	szData = szData & "|" & sCodeData[1]								' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	szData = szData & "|" & "지정가"								' 주문구분
	szData = szData & "|" & "0"										' 현금
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtPrc.caption							' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & ""										' 전량전부
	szData = szData & "|" & g_szDecimal								' 가격자릿수
	
	' 주문경고
	if Trim(szWarn) <> "" then		
		szData = szData & "|" & szWarn								' 경고메세지		
		Form.OpenPopup("mbtre13000_p5", szData , "")
		
	' 주문확인
	else							
		Form.OpenPopup("mbtre13000_p4", szData , "") 
	end if
End Function

'============================================================================
' Request_Order : 주문전송
'============================================================================
Function Request_Order()
	g_szWarnFlag	= "N"
	DATAMANAGER.RequestTranData("obtre_oder_001a")	
End Function

'============================================================================
' Check_Account : 계좌번호 확인
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd

	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인 후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit
	szLow  = g_szDnLimit

	GetHogaUnit(g_szMk, szPrc, nGbn) '20180710 HAMWG : 호가단위 설정함수 변경

	szUnit = g_szUnit
	
	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if g_szLast == "" or CDbl(g_szLast) == 0 then
			szPrc = 0
		else
			szPrc = g_szLast
		end if
	else
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
			
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function

'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szLast = "" or CDbl(g_szLast) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szLast)
		end if	
	end if
	
	szUnit = "1.000"
	
	szTtype = Cint(g_szTickType)
	
	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	if szMk == "0215" then '상해
		szUnit = "0.010"
		
	elseif szMk == "0214" then '심천
		szUnit = "0.010"
		
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		if szTtype == 1 then
			szUnit = "0.010"
			
		elseif szTtype == 2 then
			szUnit = "0.050"
			
		elseif szTtype == 3 then
			szUnit = "0.050"
			
		elseif szTtype == 4 then
			szUnit = "0.050"
			
		else
			szUnit = "0.010"
			
		end if
		
	elseif szMk == "0104" then '홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		'type = 5 (ETF종목) 추가
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			end if
		
		else
