g_szMk = ""
g_szNg = ""

Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szTR

Dim g_szTitle
g_szTitle = "알림"

' 20171204 HAMWG START : 해외주식_공유변수 선언
Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szLast			' 현재가
g_szLast = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit	=  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit	=  ""

Dim g_szUnit			' 호가단위
g_szUnit		=  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal	=  ""

Dim g_szKorName		' 한글종목명
g_szKorName	=  ""

Dim g_szTickType		' 종목틱타입
g_szTickType	=  ""
' 20171204 HAMWG END

'20210329 LES START 통합증거금
Dim gCustNo
gCustNo = ""

Dim gTotalYN
gTotalYN = false
'20210329 LES END

Dim g_ShortAmt

Dim g_nAbleQty, g_nAbleQtyCS
g_nAbleQty, g_nAbleQtyCS = 0, 0

Dim g_bItemFirstStart	' 종목기준 최초 판단
g_bItemFirstStart = true
Dim g_bClickedAbleBtn	'20230926 htw start 가능수량 버튼 클릭 판단
g_bClickedAbleBtn = false
