'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' Return_AutoQty : 수량 자동입력
'============================================================================
Function Return_AutoQty()
	if g_szBuyQty == "1" then			' 현금가능수량
		Request_Able()
	elseif g_szBuyQty == "2" then		' 최대가능수량 (해외주식은 미수가 없어 현금가능수량으로 조회)
		Request_Able()
	elseif g_szBuyQty == "3" then		' 수량입력
		edtQty.caption = g_szBuyQtyCnt
		edtQty_OnEditComplete()
	end if
End Function

'============================================================================
' Request_Able : 주문가능수량 조회
'============================================================================
Function Request_Able()	
	f_Request004()
'	DATAMANAGER.RequestTranData("obtre_oder_004r")
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "★")
	
	if UBound(tData) > 0 then
		szMkCd = Transform_Exid(tData(2))
		
		arrCode = Split(tData(1), ".")

		if UBound(tData) > 0 then
			sCode = arrCode(0)
			
			'20220527 SWJ START : 종목코드에 "."이 들어간 경우 파싱 오류 수정(EX.버크셔해서웨이)
			if instr(tData(1),".") <> instrRev(tData(1),".") then		
				sztempCode = Replace(tData(1),"." & szMkCd,"")
				
				sCode = sztempCode
			end if
			'20220527 SWJ END 
			
			Form.triggerEvent("#", "13000_CONTRACT", szMkCd & "@" & sCode & "★" & tData(3))
		End if

		' 수량
		g_szQty = ""
		edtQty.caption = Fix(tData(6))	
		edtQty_OnEditComplete()
		g_szQty = Fix(tData(6))

		' 주문가격
		edtPrc.caption = tData(7)
		edtPrc_OnEditComplete()	
	end if
End Function

'============================================================================
' 거래소코드 <- 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

