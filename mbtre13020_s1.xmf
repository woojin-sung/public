'============================================================================
Sub rdo0_OnClick(nIndex)
	edtPrc.caption = ""
	edtQty.caption = ""
	Table0.SetCellString(2, 1, "")
	Table0.SetCellString(3, 1, "")
	
	if nIndex == 1 then'청산가능 수량
		lblAbleQtyCS.visible = true
		lblAbleQty.visible = false
		btnBuy.caption = "청산매수"
		Button0.caption = "청산가능"
		DATAMANAGER.RequestTranData( "obtre_comm_027r" )
	else
		f_Request004()
		lblAbleQtyCS.visible = false
		lblAbleQty.visible = true
		Button0.caption = "가능수량"
		btnBuy.caption = "신규매수"
	end if
End Sub

Sub f_Request004()'가능수량 조회
	g_nAbleQty = 0'초기화
	szPcd = Form.GetCtlProp("#lblAfterCode", "caption")
	
	szAbleNewMaesu = Form.GetTopCtlProp("lblAbleNewMaesu", "caption")
	nAbleChungMaedoQty = CDbl(Form.GetTopCtlProp("lblAbleChungMaedoQty", "caption"))
	
	szAcnt = Form.GetTopCtlProp("acnt", "total")
	
	if szAcnt <> "" then
		if g_bItemFirstStart then
			g_bItemFirstStart = false
			g_bClickedAbleBtn = false'20230926 htw start 가능수량 버튼 클릭 판단
			
			if nAbleChungMaedoQty > 0 then	'매도잔고 청산 가능수량이 있다면
				g_nAbleQtyCS = nAbleChungMaedoQty
				lblAbleQtyCS.caption = g_nAbleQtyCS
				rdo0.currentindex = "1"
				rdo0_OnClick(1)
			else
				rdo0.currentindex = "0"
				lblAbleQtyCS.visible = false
				lblAbleQty.visible = true
				btnBuy.caption = "신규매수"
				
				if szAbleNewMaesu == "불가" then	'신규매수 불가
					lblAbleQty.caption = "0"
				else
					if edtPrc.caption == "" or CDbl(edtPrc.caption) == 0 then
						if g_szLast <> "" then
							DATAMANAGER.RequestTranData("obtre_oder_004r_2")
						end if
					else
						DATAMANAGER.RequestTranData("obtre_oder_004r")
					end if
				end if
			end if
		else
			if szAbleNewMaesu == "불가" then	'신규매수 불가
				g_bClickedAbleBtn = false'20230926 htw start 가능수량 버튼 클릭 판단
				lblAbleQty.caption = "0"
				edtQty.caption = "0"
				edtQty_OnEditComplete()
			else
				if edtPrc.caption == "" or CDbl(edtPrc.caption) == 0 then
					if g_szLast <> "" then
						DATAMANAGER.RequestTranData("obtre_oder_004r_2")
					end if
				else
					DATAMANAGER.RequestTranData("obtre_oder_004r")
				end if
			end if
		end if
	else
		g_bClickedAbleBtn = false'20230926 htw start 가능수량 버튼 클릭 판단
		lblAbleQty.caption = "0"
		lblAbleQtyCS.caption = "0"
	end if
	
End Sub

'============================================================================
Sub lblAbleQty_OnClick()
	edtQty.caption = g_nAbleQty
	edtQty_OnEditComplete()
End Sub

'============================================================================
Sub lblAbleQtyCS_OnClick()
	edtQty.caption = g_nAbleQtyCS
	edtQty_OnEditComplete()
End Sub

