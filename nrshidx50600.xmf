'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "PeriodSet" then
		
		arrData = Split(sRet,"@")
		
		szGubun = arrData(0)
		szFrom = arrData(1)
		szTo = arrData(2)
		
		gPeriodIndex = szGubun
		gPeriodFrom = szFrom
		gPeriodTo = szTo
		
		contBody.CalFrom.caption = szFrom 
		contBody.CalTo.caption = szTo
		
		if szGubun == "0" then
			contHeader.LabelPeriod.caption = "1주일 이내"	
		elseif szGubun == "1" then
			contHeader.LabelPeriod.caption = "1개월 이내"
		elseif szGubun == "2" then
			contHeader.LabelPeriod.caption = "3개월 이내"
		elseif szGubun == "3" then
			contHeader.LabelPeriod.caption = contBody.CalFrom.dispcaption .. " ~ " .. contBody.CalTo.dispcaption .. " 이내"
		end if
		
		'화살표 이미지 위치조정
		'SetPeriodLabelSize()
		
		'데이터조회
		RequestData()
	
	'2024.03.04
	elseif sKeyName == "DLG_SELECT" then
	
		arrData = Split(sRet,"★")
		
		szItemName = arrData(1)
		contHeader.EditSearch.caption = szItemName
			
		if szItemName <> "" then
			contHeader.ImageRemove.visible = true
		end if
			
		RequestData()
		
	
	end if
	
End Sub

