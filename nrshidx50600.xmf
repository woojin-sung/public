	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
End Function

'============================================================================
'공지사항 펼치기/접기
'============================================================================
Function foldNotice()

	'펼치기
	if gNoticeWide == 0 then
		
		'contBody bringfront = 0 줘야 음영이 안생김
		contBody.bringfront("0")
		contHeader.bringfront("1")	
		contHeader.bringfront("0")	
		
		gNoticeWide = 1
		
		contHeader.height = 438'358
		contHeader.contNotice.height = 230'150
		contHeader.contNotice.LabelText1.height = 230
		
		contHeader.ImageIconFold.top = 427'347
		contHeader.ImageIconFold.imgpath = "guidebox_handle_02show"
	
	'접기
	else
		
		'contHeader bringfront = 0 줘야 음영이 안생김
		contHeader.bringfront("0")
		contBody.bringfront("1")	
		contBody.bringfront("0")
		ImageUp.bringfront("1")
		
		gNoticeWide = 0
		
		contHeader.height = 248
		contHeader.contNotice.height = 40
		
		contHeader.ImageIconFold.top = 237
		contHeader.ImageIconFold.imgpath = "guidebox_handle_01hide"
		
	end if
	
End Function

'============================================================================
' 판넬클릭 시, 링크버튼 클릭 여부 확인
'============================================================================
Function isLinkButton(sCellID)
	
	if sCellID == "ButtonLink0" or sCellID == "ButtonLink1" or sCellID == "ButtonLink2" or sCellID == "ButtonLink3" or sCellID == "ButtonLink4" then
		return true
	else
		return false
	end if

End Function

'============================================================================
' 코드 데이터 한글명으로 치환
'============================================================================
Function GetCodeToName(sType,sCode)

	if sType == "주기구분" then
	
		if sCode == "01" then
			return "월배당"
		elseif sCode == "02" then
			return "분기배당"
		elseif sCode == "03" then
			return "반기배당"
		elseif sCode == "04" then
			return "연간배당"
		elseif sCode == "05" then
			return "기타배당"
		end if
	
	end if

End Function

'============================================================================
' 배당주기/ETF포함 여부 상태에 따른 코드값 가져오기
'============================================================================
Function GetStateToCode(sType)
	
	'------------------------------------------------------
	' 배당주기 구분
	' 전체:00, 월:01, 분기:02, 반기:03, 연간:04, 기타:05
	'------------------------------------------------------
	if sType == "배당주기" then
	
		sCurTab = Cint(contHeader.FormTab0.currenttab)
		
		if sCurTab == 0 then
			return "00"
		elseif sCurTab == 1 then
			return "01"
		elseif sCurTab == 2 then
			return "02"
		elseif sCurTab == 3 then
			return "03"
		elseif sCurTab == 4 then
			return "04"
		elseif sCurTab == 5 then
			return "05"
		end if
	
	'------------------------------------------------------
	' ETF 포함여부
	' 1:주식, 2:주식+ETF
	'------------------------------------------------------
	elseif sType == "ETF" then
	
		sCheckState = Cint(contBody.ChkButtonETF.checkstate)
		
		if sCheckState == 0 then
			return "1"
		elseif sCheckState == 1 then
			return "2"
		end if
	
	end if

End Function

'============================================================================
' 조회건수에 따라 컨트롤 위치조정 
'============================================================================
Function CheckDataCnt(nCnt)

	if nCnt > 0 then
		
		contBody.Pannel0.visible = true
		contBody.Pannel0.left = 0
		
		contBody.lbNoticeMsg.visible = false
		contBody.imgNotice.visible = false
		
		contBody.lbNoticeMsg.left = 500
		contBody.imgNotice.left = 500
		
		if nCnt < 30 then
			if gbSetFooter <> true then
				contBody.Pannel0.addfooter = "nrshidx50600_s1"
				gbSetFooter = true
			end if
		end if
		
	
	else
		contBody.Pannel0.visible = false
		contBody.Pannel0.left = 500
		
		contBody.lbNoticeMsg.visible = true
		contBody.imgNotice.visible = true
		
		contBody.lbNoticeMsg.left = 84
		contBody.imgNotice.left = 156
	
	end if

End Function

'============================================================================
' 기간설정 팝업오픈
'============================================================================
Function OpenPopupPeriod(sOpenData)
	Form.OpenPopupAnimation("nrshidx50600_p1", sOpenData, "", "2")
End Function
'============================================================================
Function SetDefaultPeriod()

	gPeriodIndex = 0 '1주일 이내
	gPeriodFrom = Form.GetSharedData("&BIZ_NXT_DT", false) '익영업일
	gPeriodTo = CalcDate("d",7,gPeriodFrom) '익영업일 + 7일
	
	contBody.CalFrom.caption = gPeriodFrom
	contBody.CalTo.caption = gPeriodTo
	
	
End Function

'============================================================================
' From일로부터 + @일/개월 가져오기
'============================================================================
Function CalcDate(sType,nDiff,sBaseDate)

	sYear = Left(sBaseDate,4)
	sMonth = Mid(sBaseDate,5,2)
	sDay = Right(sBaseDate,2)
	sRsltDate = Replace(DateAdd (sType, nDiff,  sYear&"-"& sMonth &"-"& sDay), "-", "")
	return sRsltDate
	
	
End Function

'============================================================================
' LabelPeriod 및 ImageIconArrow 너비 및 위치조정
'============================================================================
Function SetPeriodLabelSize()
	
	if gOsType == "1" then
		nLeft = Form.calcUnResize(contHeader.LabelPeriod.left, "2")
		nWidth = Form.calcUnResize(contHeader.LabelPeriod.width, "2")
		contHeader.LabelPeriodUnderLine.width = nWidth + 18
	else
		nLeft = contHeader.LabelPeriod.left
		nWidth = contHeader.LabelPeriod.width
		contHeader.LabelPeriodUnderLine.width = nWidth + 18
	end if
	
	contHeader.ImageIconArrow.left = nLeft + nWidth + 6

End Function

'============================================================================
' 주문일자 그룹별 접기기능(현재 비활성화 상태)
'============================================================================
Function isPossibleFold(nIndex)
	
	if DATAMANAGER.IsMoreNextData("obrgt_oscm_775r") then
		return false
	else
		return false
	end if 
	
End Function
'============================================================================
' 실험중
'============================================================================
Function foldGroup(nIndex)
	
	for i = nIndex + 1 to contBody.Pannel0.rowcount - 1
		isHeader = contBody.Pannel0.getPropCardCell("visible","LabelHeaderText",i)
		
		if isHeader <> "1" then
			
			'헤더행 접어주기전에 펼쳐진 데이터행이 있으면 접어준다.
			if i == gWidePannelIndex then
				unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
				gWidePannelIndex = -1
			end if
		
			contBody.Pannel0.SetCardWHAt(i,0)
		else
			exit for
		end if
		
	next

End Function
'============================================================================
'실험중
'============================================================================
Function unfoldGroup(nIndex)

	for i = nIndex + 1 to contBody.Pannel0.rowcount - 1
		isHeader = contBody.Pannel0.getPropCardCell("visible","LabelHeaderText",i)
		
		if isHeader <> "1" then
			contBody.Pannel0.SetCardWHAt(i,gUnFoldPannelHeight)
		else
			exit for
		end if
		
	next

End Function

'============================================================================
'20240201
'============================================================================
Sub contBody_OnGestureEvent(sParam)
	
	
End Sub
'============================================================================
'스크롤 위치가 TOP이 아닌 경우
'============================================================================
Sub contBody_Pannel0_OnScrollNoTop()
	
	'하나의 종목만 검색된 경우에는 스크롤 올리지 않는다.
	nCnt = Cint(contBody.Pannel0.rowcount)
	
	'한 종목 조회 시 => 헤더행 + 데이터행이므로 rowCnt == 2
	if nCnt > 2 then
		
		'컨테이너 올리기
		contBody.fixTopAreaWhenScrolling("1", gContUpPos, "Up")
		
		'맨위로 버튼 보이기
		ImageUp.visible = true
		
	end if
	
	'20240429
	if gOsType == "2" then
		contBody.Pannel0.setScrollSpeed(True, 0)
	end if
	
	
End Sub
'============================================================================
'스크롤 위치가 TOP인 경우
'============================================================================
Sub contBody_Pannel0_OnScrollTop()
	
	'컨테이너 내리기
	contBody.fixTopAreaWhenScrolling("1", gContDownPos, "Down")
	
	'맨위로 버튼 숨기기
	ImageUp.visible = false
	
End Sub

'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 시작됐을 때
'============================================================================
Sub contBody_OnAnimationStart(sParam1,sParam2)
	
	'Up Swipe
	if sParam1 == "Up" then
		
		'공지사항이 펼쳐져있을 경우 접어준다.
		if gNoticeWide = 1 then
			foldNotice()
		end if
	
		contBody.height = 656
		
		if sParam2 == "Yes" then
			contBody.Pannel0.height = 616
		end if
		
	end if
	
End Sub
'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 완료됐을 때
'============================================================================
Sub contBody_OnAnimationComplete(sParam)
	
	'Down Swipe
	if sParam == "Down" then
		contBody.height = 408
		contBody.Pannel0.height = 368
	end if
	
End Sub

'============================================================================
' 이전 검색 조건값 적용
'============================================================================
Function ApplyExCondData()
	
	'----------------------------------------------------------------------------
	'이전값 가져오기
	'----------------------------------------------------------------------------
	sPeriodIndex	 	= Form.GetSharedData("BAEDANG_PERIOD_INDEX"	, false )
	sPeriodFrom 	 	= Form.GetSharedData("BAEDANG_PERIOD_FROM"	, false )
	sPeriodTo  		= Form.GetSharedData("BAEDANG_PERIOD_TO"		, false )
	sEditCaption 		= Form.GetSharedData("BAEDANG_CAPTION"		, false )
	sGubunIndex 		= Form.GetSharedData("BAEDANG_GUBUN_INDEX"	, false )
	sETFState 		= Form.GetSharedData("BAEDANG_ETF_STATE"		, false )
	nIndex 			= Form.GetSharedData("BAEDANG_SELECT_INDEX"	, false )
	
	'----------------------------------------------------------------------------
	'이전값 메모리영역 데이터 클리어
	'----------------------------------------------------------------------------
	Form.SetSharedData("BAEDANG_PERIOD_INDEX" , "")
	Form.SetSharedData("BAEDANG_PERIOD_FROM" , "")
	Form.SetSharedData("BAEDANG_PERIOD_TO" , "")
	Form.SetSharedData("BAEDANG_CAPTION" , "")
	Form.SetSharedData("BAEDANG_GUBUN_INDEX" , "")
	Form.SetSharedData("BAEDANG_ETF_STATE" , "")
	Form.SetSharedData("BAEDANG_SELECT_INDEX" , "")
	
	'----------------------------------------------------------------------------
	'이전값 세팅
	'----------------------------------------------------------------------------
	
	'1) 기간 From
	if sPeriodFrom == "" then
		gPeriodFrom = Form.GetSharedData("&BIZ_NXT_DT", false) '익영업일
	else
		gPeriodFrom = sPeriodFrom
	end if
	
	'2) 기간 To
	if sPeriodTo == "" then
		gPeriodTo =  CalcDate("d",7,gPeriodFrom) '익영업일 + 7일
	else
		gPeriodTo = sPeriodTo
	end if
	'Form.ShowAlert(sPeriodFrom.."//"..gPeriodFrom, gPeriodTo.."//"..gPeriodTo)
	
	'3) 기간From/기간To 캘린더 세팅
	contBody.CalFrom.caption = gPeriodFrom
	contBody.CalTo.caption = gPeriodTo
	
	'4) 기간구분 인덱스
	if sPeriodIndex == "" then
		gPeriodIndex = 0
	else
		
		gPeriodIndex = sPeriodIndex
		
		if sPeriodIndex == "0" then
			contHeader.LabelPeriod.caption = "1주일 이내"	
		elseif sPeriodIndex == "1" then
			contHeader.LabelPeriod.caption = "1개월 이내"
		elseif sPeriodIndex == "2" then
			contHeader.LabelPeriod.caption = "3개월 이내"
		elseif sPeriodIndex == "3" then
			contHeader.LabelPeriod.caption = contBody.CalFrom.dispcaption .. " ~ " .. contBody.CalTo.dispcaption .. " 이내"
		end if
		
	end if
		
		
	'5)검색어
	contHeader.EditSearch.caption = sEditCaption
	
	if sEditCaption <> "" then
		contHeader.ImageRemove.visible = true
	end if
	
	'6) 배당구분값
	if sGubunIndex <> "" and sGubunIndex <> "0" then
		contHeader.FormTab0.currenttab = Cint(sGubunIndex)
		contHeader.FormTab0_OnTabChanged(Cint(sGubunIndex))
	else
		sGubunIndex = 0
	end if
	
	
	'7) ETF포함 여부
	if sETFState <> "" and sETFState <> "0" then
		contBody.ChkButtonETF.checkstate = sETFState
	else
		sETFState = "0"
	end if
	
	
	'8)선택행
	gExSelectIndex = nIndex
	if nIndex == "" then
		gExSelectIndex = "-1"
	end if
	
	'Form.ShowAlert("test", "기간From : ".. gPeriodFrom.."\n".. "기간To : " .. gPeriodTo.."\n".. "기간구분 : " .. gPeriodIndex.."\n".."검색어 : ".. sEditCaption.."\n".. "배당구분 : " .. sGubunIndex.."\n".. "ETF포함 : " .. sETFState.."\n".. "선택행 : " .. gExSelectIndex)
	
	RequestData()

End Function

'============================================================================
' 현재 검색 조건값 저장
'============================================================================
Function SaveCurCondData(nIndex)
	
	'---------------------------------------------------------------
	'저장 검색조건 리스트
	'---------------------------------------------------------------
	'기간 		: gPeriodIndex => 기간구분(디폴트 1주일 = 0)
	'From 		: gPeriodFrom => 기간직접입력 시(디폴트 익영업일 Form.GetSharedData("&BIZ_NXT_DT", false))
	'To 			: gPeriodTo => 기간 직접입력 시(디폴트 익영업일 + 7일 CalcDate("d",7,gPeriodFrom))
	'검색어 		: 빈값 
	'배당구분값 	: 디폴트 전체 = 0
	'ETF포함 여부	: 디폴트 미포함 
	'---------------------------------------------------------------
	
	'------------------------------------------
	' 기간
	'------------------------------------------
	Form.SetSharedData("BAEDANG_PERIOD_INDEX" , gPeriodIndex)
	
	'------------------------------------------
	' 기간 From
	'------------------------------------------
	Form.SetSharedData("BAEDANG_PERIOD_FROM" , gPeriodFrom)
	
	'------------------------------------------
	' 기간 To
	'------------------------------------------
	Form.SetSharedData("BAEDANG_PERIOD_TO" , gPeriodTo)
	
	'------------------------------------------
	' 검색어
	'------------------------------------------
	sEditCaption 	= contHeader.EditSearch.caption
	Form.SetSharedData("BAEDANG_CAPTION" , sEditCaption)
	
	'------------------------------------------
	' 배당구분값
	'------------------------------------------
	sGubunIndex = contHeader.FormTab0.currenttab
	Form.SetSharedData("BAEDANG_GUBUN_INDEX" , sGubunIndex)
	
	'------------------------------------------
	' ETF포함여부
	'------------------------------------------
	sETFState = contBody.ChkButtonETF.checkstate
	Form.SetSharedData("BAEDANG_ETF_STATE" , sETFState)
	
	'------------------------------------------
	' 선택종목 인덱스
	'------------------------------------------
	Form.SetSharedData("BAEDANG_SELECT_INDEX" , Cstr(nIndex))
	
End Function

'============================================================================
Function SetHistory(sGubun,nIndex)

	szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
	szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
	sData = szMk .. "@" .. szItemCode
	
	Form.manageTotalSearch(gQUICK_DIVIDE_HIS_KEY, sGubun, sData)
	
	'테스트확인용
	'test = Form.manageTotalSearch(gQUICK_DIVIDE_HIS_KEY, "get", "")
	'Form.ShowAlert("test", test)
	

End Function

'============================================================================
' 링크버튼 화면이동 이벤트
'============================================================================
Function MoveScreen(sType,nIndex)

	'화면이동 전 현재설정 값 저장
	SaveCurCondData(nIndex)

	'---------------------------------------------------------
	'현재가 > 호가
	'---------------------------------------------------------
	if sType == "hyun" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelBodyItemName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode)
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				
				etfYN = Form.GetItemCodeInfo(szMk.."@"..szItemCode, "etfyn")
				
				if etfYN == "Y" then
					Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
				else
					Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
				end if
				
			end if
			
		end if
	
	
	'---------------------------------------------------------
	' 현재가 > 배당정보
	'---------------------------------------------------------
	elseif sType == "info" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelBodyItemName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode)
		else
	
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				
				etfYN = Form.GetItemCodeInfo(szMk.."@"..szItemCode, "etfyn")
				
				if etfYN == "Y" then
					Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."0".."★".."3")
				else
					Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."0".."★".."3")
				end if
					
			end if
			
		end if
	
	'---------------------------------------------------------
	' 주문(매수)
	'---------------------------------------------------------
	elseif sType == "mesu" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelBodyItemName",nIndex)
		
		if szMk == "J" then
			
			Form.OpenScreen("12000" , "기타".."★".."0".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "0") '매수	
			end if
			
		
		end if
	
	'---------------------------------------------------------
	' 주문(매도)
	'---------------------------------------------------------
	elseif sType == "medo" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelBodyItemName",nIndex)
		
		if szMk == "J" then
		
			Form.OpenScreen("12000" , "기타".."★".."1".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "1") '매도	
			end if
		
		end if
	
	end if

End Function

'============================================================================
Sub contTitle_ImgBackPress_OnClick()
	Form.OpenPrevScreen()
End Sub

'============================================================================
' 종목검색창 오픈 2024.03.04
'============================================================================
Sub contHeader_ButtonOpenDialog_OnClick()
	
	'타이틀명★서치타입★히스토리키값
	szData = "종목검색★39★"..gQUICK_DIVIDE_HIS_KEY
	Form.OpenPopup("nrssearchdialog" , szData , "")
	
End Sub
'============================================================================
Sub contHeader_ImageRemove_OnClick()
	contHeader.EditSearch.caption = ""
	contHeader.ImageRemove.visible = false
	
	RequestData()
	
End Sub

'============================================================================
Sub contBody_Pannel0_OnScrollStart()
	
	if gOsType == "1" then
		ImageUp.visible = false
	end if
	
End Sub

'============================================================================
' 맨위로 버튼 클릭이벤트(판넬 행 맨위로)
'============================================================================
Sub ImageUp_OnClick()

	'행 최상단 이동
	contBody.Pannel0.toprow = 0
	ImageUp.visible = false
	
	'리스트 영역 초기화
	contBody.top = 295
	contBody.height = 408
	contBody.Pannel0.height = 368
	
End Sub

'============================================================================
' 링크화면 이동 전 마스터파일 체크
'============================================================================
Function CheckMasterFile(nIndex)
	
	sMarket = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
	sItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
	
	if sMarket <> "" and sItemCode <> "" then
		
		szTransItemCode = sMarket .. "@" .. sItemCode
		szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	
		if szCheckData = "" or szCheckData = null then
			return false
		end if
	
		return true
	
	else
		return false
	end if
	
End Function

'============================================================================
'(iOS 전용) 스크롤링 속도 원복 20240429
'============================================================================
Sub contBody_Pannel0_OnVisibleRow(nEventStartRow, nEventEndRow)
	
	if gOsType == "2" then
		contBody.Pannel0.setScrollSpeed(False, 0)
	end if
	
End Sub

