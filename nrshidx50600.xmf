	<SCRIPT_INFO _len="57211" _ulen="52089" >
'============================================================================
' [주요처리 로직]
'
' gCurOrderAbleDate 일자가 변경되면 헤더행 생성 후 데이터 이어서 생성
' 헤더행 생성시에는 헤더관련 컨트롤만 보임처리 후 행 높이 조정
' 데이터행 생성시에는 데이터관련 컨트롤만 보임처리 행높이는 조정필요없음.
'
'
' [조회기준]
'
' ##.## 까지 주문하면 ~~ : ##.## => 매수가능일(권리락일 - 1영업일) / 매수가능일이 미국 휴장인 경우 (권리락일 - 2영업일)
'
' 1주일 이내 : 조회일+1영업일 ~ 조회일+1영업일 + 7일 
' 1개월 이내 : 조회일+1영업일 ~ 조회일+1영업일 + 1개월 
' 3개월 이내 : 조회일+1영업일 ~ 조회일+1영업일 + 3개월
' 직접입력   : 조회일+1영업일 ~ 조회일+1영업일 + 3개월 선택 기한 내 

'============================================================================

dim gOsType				'OS타입
Dim gCurOrderAbleDate 		'현재 생성중인 주문가능일자
Dim gPannelIndex 			'현재 판넬 인덱스값

Dim gWidePannelIndex 		'펼쳐보기한 판넬 인덱스값
Dim gHeaderPannelHeight	'판넬 내 헤더행 높이
Dim gFoldPannelHeight		'펼쳐보기 시 판넬 행높이
Dim gUnFoldPannelHeight	'평상 시 판넬 행높이

Dim gNoticeWide 			'공지사항 펼쳐보기 상태

Dim gPeriodIndex			'기간구분(디폴트 1주일 = 0)
Dim gPeriodFrom			'기간From(영업일+1)
Dim gPeriodTo				'기간To(최대 3개월)
Dim gbSetFooter			'Footer뷰 추가여부

Dim gContUpPos			'위로 스크롤 시 컨테이너 top값
Dim gContDownPos			'아래로 스크롤 시 컨테이너 top값

Dim gExSelectIndex
gExSelectIndex = -1

Dim gQUICK_DIVIDE_HIS_KEY
gQUICK_DIVIDE_HIS_KEY = "QUICK_DIVIDE_HISTORY"

Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

'20240516 LES START
Dim gDataReqComplete
gDataReqComplete = true

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		contHeader.LabelPeriod.fontsize = 2 - Cint((gsLargeFontsize * 2))
		contHeader.LabelText.fontsize = 2 - Cint((gsLargeFontsize * 2))
		contHeader.EditSearch.fontsize = - Cint((gsLargeFontsize * 2))
		
		if gOsType == "1" then
			contHeader.contNotice.LabelText0.fontsize = -2 - Cint((gsLargeFontsize * 2))
			contHeader.contNotice.LabelText1.fontsize = -2 - Cint((gsLargeFontsize * 2))
		else
			contHeader.contNotice.LabelText0.fontsize = -4 - Cint((gsLargeFontsize * 2))
			contHeader.contNotice.LabelText1.fontsize = -5 - Cint((gsLargeFontsize * 2))
		end if
	end if	
	
	'--------------------------------------------------------------
	'행 펼쳤을때/접혔을때 높이값
	'--------------------------------------------------------------
	if gOsType == "1" then
		gFoldPannelHeight = 131
		gUnFoldPannelHeight = 65
	else
		gFoldPannelHeight = 131
		gUnFoldPannelHeight = 64
	end if
	
	'--------------------------------------------------------------
	'행 헤더 높이값
	'--------------------------------------------------------------
	gHeaderPannelHeight = 41
	
	gPannelIndex = 0
	gWidePannelIndex = -1
	gNoticeWide = 0
	gbSetFooter = false
	
	'--------------------------------------------------------------
	'라벨컨트롤 텍스트에 맞춰 자동 사이즈 조정
	'--------------------------------------------------------------
	if gOsType == "1" then
		contHeader.LabelPeriod.paddinginfo = "0,0,0,0"
		contHeader.LabelPeriod.sizeAutoFit()
	end if
	
	'--------------------------------------------------------------
	'위/아래 스크롤 시 컨테이너 top값 지정
	'--------------------------------------------------------------
	gContUpPos = 47
	gContDownPos = 295
	
	'--------------------------------------------------------------
	'이미지 비율조정
	'--------------------------------------------------------------
	contHeader.ImagePerson.setMaintainingRatio("1")
	contHeader.ImageIconArrow.setMaintainingRatio("1")
	contHeader.ImageIconSearch.setMaintainingRatio("1")
	contHeader.contNotice.ImageIconArrow0.setMaintainingRatio("1")
	contHeader.ImageIconFold.setMaintainingRatio("1")
	
End Sub
'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'판넬 UI업데이트 예외처리(iOS전용)
	'--------------------------------------------------------------
	'20240418 판넬 행 중복 생성되어 삭제 처리(간헐적으로 ScrollEnd 두번 호출됨...)
	'contBody.Pannel0.SetDataNormal(true)
	
	'--------------------------------------------------------------
	'판넬 스크롤 이벤트 사용 / 맨위로 버튼 이미지 세팅
	'--------------------------------------------------------------
	contBody.Pannel0.scrollevent = true
	ImageUp.setMaintainingRatio("1")
	ImageUp.imgpath = "btn_up"
	
	'--------------------------------------------------------------
	'뒤로가기 버튼
	'--------------------------------------------------------------
	contTitle.ImgBackPress.setMaintainingRatio("2")
	contTitle.ImgBackPress.imgpath = "icon_main_01"

	'--------------------------------------------------------------
	'관심종목 리스트 조회 2024.03.04
	'--------------------------------------------------------------
	Form.requestIntrItemList("00")

	'--------------------------------------------------------------
	'라벨컨트롤 텍스트에 맞춰 자동 사이즈 조정
	'--------------------------------------------------------------
	if gOsType == "2" then 
		contHeader.LabelPeriod.paddinginfo = "0,0,0,0"
		contHeader.LabelPeriod.sizeAutoFit()
	end if
	
	'--------------------------------------------------------------
	'유의사항 라벨 컨트롤 설정 및 문구입력
	'--------------------------------------------------------------
	contHeader.LabelText.paddinginfo = "0,0,0,0"
	contHeader.contNotice.LabelText0.paddinginfo = "0,0,0,0"
	contHeader.contNotice.LabelText1.paddinginfo = "0,0,0,0"
	
	contHeader.contNotice.LabelText1.setTextBreakPolicy()
	contHeader.contNotice.LabelText1.caption = "배당 일정은 모두 미국 현지 기준이므로 실제 지급일과 차이가 ".. 
										  "있을 수 있으며, 최초 공시 이후 최종 공시가 수정되어 해당 내용이 "..
										  "업데이트 되거나 삭제 될 수 있습니다.\n\n"..
   
										  "공시 정보를 제공하는 벤더사의 수기 처리로 상이하거나 누락 및 "..
										  "오류의 가능성이 있으므로, 현재 주가 대비 배당금이 과한 종목은 "..
										  "반드시 배당 종목의 배당추이를 확인하시기 바랍니다.\n\n"..

										  "본 서비스는 투자 판단 참고용으로만 사용하실 수 있으며, "..
										  "모든 투자 판단은 투자자 본인의 책임으로 당사는 어떠한 경우에도"..
										  "일체의 법적 책임을 지지 않습니다."
	
	
	
	contHeader.EditSearch.SetOnOffImage("alpha", "alpha")
	contHeader.ImageSearchBG.imgpath = "btn_line2_n.9"
	
	
	'------------------------------------------------------------------------------------------------------------------------------
	'배당주 데이터 조회 순서
	'InsertFormTabPage => ApplyExCondData => RequestData
	'폼탭페이지 동적생성이 완료되기 전에 이후 함수가 호출되면 문제가 되므로, 순차적으로 진행
	'------------------------------------------------------------------------------------------------------------------------------
	'1) 배당구분 폼탭 페이지 동적 생성 (InsertFormTabPage)
	'2) 이전 조건값 or 디폴트 값 설정 (ApplyExCondData)'
	'3) 설정된 조건값에 따라서 배당종목 조회 (RequestData)
	'------------------------------------------------------------------------------------------------------------------------------
	contHeader.FormTab0.SetUseOnlyHeader(true)
	InsertFormTabPage()

	'ApplyExCondData()
	'RequestData()
	
	contBody.gesture = true
	
End Sub

'============================================================================
Sub contHeader_EditSearch_OnClick()
	contHeader.ImageSearchBG.imgpath = "btn_line2_o.9"
End Sub

'============================================================================
Sub contHeader_EditSearch_OnEditComplete()
	contHeader.ImageSearchBG.imgpath = "btn_line2_n.9"
End Sub

'============================================================================
Sub contHeader_EditSearch_OnEditChar(CharCode)
	RequestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obrgt_oscm_775r" then
	
		'20240516 LES START
		gDataReqComplete = true
		
		nCnt = DATAMANAGER.GetDataCount(0, "obrgt_oscm_775r", "OutBlock1")
		
		for i = 0 to nCnt - 1
		
			'주문가능일자
			sOrderAbleDate = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "ODER_ABLE_DATE" , i)
			sOrderAbleDate = Right(sOrderAbleDate,4)
			
			'한글 종목명
			sName = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "KOR_ISNM" , i)
			
			'배당금
			sCAmt = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "PSTC_DVDN_CAMT" , i)
			
			'배당금 통화
			sCrcd = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "CRCD" , i)
			
			'종목코드(티커.거래소)
			sOrgnCode = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "ISCD" , i)
			
			'종목코드(티커)
			sTicker = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "OVRS_STCK_SYMB_ISCD" , i)
			
			'시장구분
			sMarket = Replace(sOrgnCode,sTicker..".","")
			
			'---------------------------------------------------------------------------
			' 마스터파일에서 가져온 종목명(iOS에서 특정 종목명이 깨지는 현상 발생방지)
			' 원장조회 종목명과 마스터파일 종목명이 다른 경우 마스터파일 기준으로 세팅
			'---------------------------------------------------------------------------
			if sMarket <> "" and sTicker <> "" then
				sNameFromMaster = Form.GetItemCodeInfo(sMarket.."@"..sTicker, "name")
				
				if sNameFromMaster <> "" then
					if sName <> sNameFromMaster then
						sName = sNameFromMaster
					end if
				end if
				
			end if
			'---------------------------------------------------------------------------
			
			'배당주기/배당주기명
			sClsName = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "MNRC_CYCL_CLS_NAME" , i)
			sClsRealName = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "DVDN_RCKN_CLS_NAME" , i)
			
			'기타배당일 경우에는 서비스에서 내려주는 실제 배당주기명으로 보여줌.
			if sClsName == "05" then
				sClsName = sClsRealName
			else
				sClsName = GetCodeToName("주기구분",sClsName)
			end if
			
			'지급일
			sProsDate = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "PROS_DATE" , i)
			
			'ETF종목 여부
			sETFYN = DATAMANAGER.GetDataValue(0, "obrgt_oscm_775r", "OutBlock1", "OVRS_STCK_ISSU_TPCD" , i)
			
			
			'---------------------------------------------------------------------------
			'헤더를 생성해줘야되는 확인
			'권리락일자가 생성해주던 데이터와 달라질 경우 헤더 생성 후 바디데이터 입력
			'---------------------------------------------------------------------------
			
			if CheckChangeOrderAbleDate(sOrderAbleDate) then
				
				'---------------------------------------------------------------------------
				'헤더생성
				'---------------------------------------------------------------------------
				contBody.Pannel0.AddRow()
				ChangeControlPosAndRowHeight(1,i + gPannelIndex)
				
				'---------------------------------------------------------------------------
				'헤더데이터 입력
				'---------------------------------------------------------------------------
				contBody.Pannel0.SetCellValue("LabelHeaderDate",i + gPannelIndex,sOrderAbleDate)
				
				'헤더 컨트롤 설정
				'contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderDate",i + gPannelIndex,"0,0,0,0")
				'contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderDate",i + gPannelIndex,"0,0,0,0")
				'contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderText",i + gPannelIndex,"0,0,0,0")
				
				'전역인덱스 변경
				gPannelIndex = gPannelIndex + 1
				
			end if
			
			'---------------------------------------------------------------------------
			'바디데이터 생성
			'---------------------------------------------------------------------------
			contBody.Pannel0.AddRow()
			ChangeControlPosAndRowHeight(2,i + gPannelIndex)
			
			'---------------------------------------------------------------------------
			'바디데이터 입력
			'---------------------------------------------------------------------------
			
			'종목명
			contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyItemName",i + gPannelIndex,"0,0,0,0")
			contBody.Pannel0.setPropCardCell("fontsize","LabelBodyItemName",nIndex,"0")
			contBody.Pannel0.setPropCardCell("maxlinecnt","LabelBodyItemName",i + gPannelIndex,"1^-4")
			contBody.Pannel0.SetCellValue("LabelBodyItemName",i + gPannelIndex,sName)
			
			'---------------------------------------------------------------------------
			'20240612 LES START ETF고도화 추가개선 2차
			'---------------------------------------------------------------------------
			'종목명으로 검색 시에는, 배당금이 0원인 종목도 조회되도록 수정.
			'배당금영역에 "배당예정"으로 텍스트 데이터 입력
			if Cdbl(sCAmt) == 0 then
				
				'배당예정으로 표기
				contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyAMT",i + gPannelIndex,"0,0,0,0")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelBodyAMT",i + gPannelIndex,"333")
				contBody.Pannel0.SetCellValue("LabelBodyAMT",i + gPannelIndex,"배당예정")
				
				'지급일자 미표기
				contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyDate",i + gPannelIndex,"0,0,0,0")
				contBody.Pannel0.SetCellValue("LabelBodyDate",i + gPannelIndex,"")
			
			else
				
				'배당금+통화
				contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyAMT",i + gPannelIndex,"0,0,0,0")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelBodyAMT",i + gPannelIndex,"1")
				
				sTransCamt = FormatNumber(sCAmt,4)
				contBody.Pannel0.SetCellValue("LabelBodyAMT",i + gPannelIndex,sTransCamt.." "..sCrcd)
				
				'지급일자
				contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyDate",i + gPannelIndex,"0,0,0,0")
				contBody.Pannel0.SetCellValue("LabelBodyDate",i + gPannelIndex,sProsDate)
				
			end if
			'---------------------------------------------------------------------------
			'20240612 LES END
			'---------------------------------------------------------------------------
			
			'티커명+배당주기명+ETF여부
			contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyCode",i + gPannelIndex,"0,0,0,0")
			
			if sETFYN == "T" then
				contBody.Pannel0.SetCellValue("LabelBodyCode",i + gPannelIndex,sTicker.." | " ..sClsName.." | ".."ETF")
			else
				contBody.Pannel0.SetCellValue("LabelBodyCode",i + gPannelIndex,sTicker.." | " ..sClsName)
			end if
			
			'티커명+거래소명/티커/거래소(숨김처리되있는 컨트롤)
			contBody.Pannel0.SetCellValue("LabelBodyOrgnCode",i + gPannelIndex,sOrgnCode)
			contBody.Pannel0.SetCellValue("LabelBodyTicker",i + gPannelIndex,sTicker)
			contBody.Pannel0.SetCellValue("LabelBodyMarket",i + gPannelIndex,sMarket)
			
		
		next
		
		CheckDataCnt(Cint(contBody.Pannel0.rowcount))
		
		'------------------------------------------------------------------------------
		'이전 선택행 인덱스값 존재 시 이전행 인덱스가 나올떄까지 자동 재조회 후 자동이동
		'------------------------------------------------------------------------------
		if gExSelectIndex <> "-1" then
			nRow = Cint(contBody.Pannel0.rowcount)
			nIndex = Cint(gExSelectIndex)
			
			'아직 선택행만큼 행수가 생기지 않았으면 재조회
			'선택행만큼 행수가 생겼으면 해당위치로 이동 후 gExSelectIndex 초기화
			'연속조회 끝까지 선택행이 안나오면 그냥 초기화
			if nRow >= nIndex then
				contBody.Pannel0.toprow = nIndex
				gExSelectIndex = "-1"
			else
				
				if DATAMANAGER.IsMoreNextData("obrgt_oscm_775r") then
					gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
					DATAMANAGER.RequestNextData("obrgt_oscm_775r")
				else
					gExSelectIndex = "-1"
				end if
				
			end if
			
			
		end if
		'------------------------------------------------------------------------------
		'
		'------------------------------------------------------------------------------	
		
		
		
	end if
	
End Sub
'============================================================================

'============================================================================
Sub contBody_Pannel0_OnScrollEnd()
	
	if DATAMANAGER.IsMoreNextData("obrgt_oscm_775r") then
		gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
		
		'20240516 LES START
		'DATAMANAGER.RequestNextData( "obrgt_oscm_775r" )
		
		if gDataReqComplete == true then
			DATAMANAGER.RequestNextData( "obrgt_oscm_775r" )
		end if
		'
		gDataReqComplete = false
		'20240516 LES END 
		
	else
		
		if gbSetFooter <> true then
			contBody.Pannel0.addfooter = "nrshidx50600_s1"
			gbSetFooter = true
		end if
		

	end if 
	
End Sub
'============================================================================
'============================================================================
Function RequestData()

	gbSetFooter = false
	contBody.Pannel0.addfooter = ""
	contBody.Pannel0.rowcount = 0 
	gPannelIndex = 0
	gCurOrderAbleDate = ""
	
	DATAMANAGER.SetDataValue(0, "obrgt_oscm_775r", "InBlock1", "STA_DATE", 				  	0, contBody.CalFrom.caption)
	DATAMANAGER.SetDataValue(0, "obrgt_oscm_775r", "InBlock1", "FIN_DATE", 				  	0, contBody.CalTo.caption)
	DATAMANAGER.SetDataValue(0, "obrgt_oscm_775r", "InBlock1", "ISNM", 					  	0, contHeader.EditSearch.caption)
	DATAMANAGER.SetDataValue(0, "obrgt_oscm_775r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE",	0, "01") '미국(01) 고정
	DATAMANAGER.SetDataValue(0, "obrgt_oscm_775r", "InBlock1", "MNRC_CYCL_CLS_NAME", 		  	0, GetStateToCode("배당주기"))
	DATAMANAGER.SetDataValue(0, "obrgt_oscm_775r", "InBlock1", "IQRY_CLS_CODE", 				0, GetStateToCode("ETF"))
	DATAMANAGER.RequestTranData("obrgt_oscm_775r")

End Function

'============================================================================
' 현재 생성중인 권리락일자와 다른지 비교
'============================================================================
Function CheckChangeOrderAbleDate(sDate)
	
	if gCurOrderAbleDate == sDate then
		return false
	else
		gCurOrderAbleDate = sDate
		return true
	end if

End Function
'============================================================================
' 생성할 행의 타입에 따라 컨트롤 위치변경 및 행 높이 변경
' nType = 1(헤더) / nType = 2(데이터)
'============================================================================
Function ChangeControlPosAndRowHeight(nType,nIndex)
	
	if nType == 1 then
	
		contBody.Pannel0.setPropCardCell("visible","LabelBodyItemName",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelBodyAMT",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelBodyCode",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelBodyDate",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelSeperator",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderFold",nIndex,"0")
		
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderBG",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderDate",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderText",nIndex,"1")
		
		'안드로이드 폴드 대응
		if gOsType == "1" then
			contBody.Pannel0.setPropCardCell("maintainratio","ImageHeaderCal",nIndex,"1")
			contBody.Pannel0.SetCellValue("ImageHeaderCal",nIndex,"icon_calender")
		end if
		
		contBody.Pannel0.setPropCardCell("visible","ImageHeaderCal",nIndex,"1")
		
		'==============================================================
		' iOS 판넬컨트롤 리사이클뷰 오류(각 행에 설정되있는 글자크기,패딩값 재설정)
		'==============================================================
		'--------------------------------------------------------------
		'헤더 컨트롤 설정
		'--------------------------------------------------------------
		'iOS에서 헤더행/데이터행 패딩값/글자크기가 잘못들어가는 현상이 있어
		'헤더일때랑 데이터행일때 둘다 해줘야됨.
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderDate",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderText",nIndex,"0,0,0,0")
		'--------------------------------------------------------------
		'데이터 컨트롤 설정
		'--------------------------------------------------------------
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyItemName",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("fontsize","LabelBodyItemName",nIndex,"0")
		contBody.Pannel0.setPropCardCell("maxlinecnt","LabelBodyItemName",nIndex,"1^-4")
		
		'==============================================================
		
		contBody.Pannel0.setPropCardCell("top","LabelHeaderBG",nIndex,"0")
		contBody.Pannel0.setPropCardCell("top","LabelHeaderDate",nIndex,"0")
		contBody.Pannel0.setPropCardCell("top","LabelHeaderText",nIndex,"0")
		contBody.Pannel0.setPropCardCell("top","ImageHeaderCal",nIndex,"11")
		
		
		contBody.Pannel0.SetCardWHAt(nIndex,gHeaderPannelHeight)
	
	else
		
		contBody.Pannel0.setPropCardCell("visible","LabelBodyItemName",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelBodyAMT",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelBodyCode",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelBodyDate",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelSeperator",nIndex,"1")
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderFold",nIndex,"0")
		
		contBody.Pannel0.setPropCardCell("top","LabelBodyItemName",nIndex,"12") 
		contBody.Pannel0.setPropCardCell("top","LabelBodyAMT",nIndex,"12") 
		contBody.Pannel0.setPropCardCell("top","LabelBodyCode",nIndex,"34")
		contBody.Pannel0.setPropCardCell("top","LabelBodyDate",nIndex,"34")
		contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"64")
		
		'==============================================================
		' iOS 판넬컨트롤 리사이클뷰 오류(각 행에 설정되있는 글자크기,패딩값 재설정)
		'==============================================================
		'--------------------------------------------------------------
		'헤더 컨트롤 설정
		'--------------------------------------------------------------
		'iOS에서 헤더행/데이터행 패딩값/글자크기가 잘못들어가는 현상이 있어
		'헤더일때랑 데이터행일때 둘다 해줘야됨.
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderDate",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHeaderText",nIndex,"0,0,0,0")
		'--------------------------------------------------------------
		'데이터 컨트롤 설정
		'--------------------------------------------------------------
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelBodyItemName",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("fontsize","LabelBodyItemName",nIndex,"0")
		contBody.Pannel0.setPropCardCell("maxlinecnt","LabelBodyItemName",nIndex,"1^-4")
		
		'==============================================================
			
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderBG",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderDate",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","LabelHeaderText",nIndex,"0")
		contBody.Pannel0.setPropCardCell("visible","ImageHeaderCal",nIndex,"0")
		
		
		contBody.Pannel0.SetCardWHAt(nIndex,gUnFoldPannelHeight)
		
		
	
	end if
	

End Function
'============================================================================
' 상단 폼탭 페이지 생성
'============================================================================
Function InsertFormTabPage()
	
	'활성화/비활성화/여백
	contHeader.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5)   
	
	'활성화/비활성화 폰트색상
	contHeader.FormTab0.setTabHeaderFgColor("28" , "321") 								   

	'페이지생성
	if gOsType == "1" then
		contHeader.FormTab0.insertPage( 0, "page0", "page0", "nrsempty", "0", "전체")
		contHeader.FormTab0.insertPage( 1, "page1", "page1", "nrsempty", "0", "월배당")
		contHeader.FormTab0.insertPage( 2, "page2", "page2", "nrsempty", "0", "분기배당")	
		contHeader.FormTab0.insertPage( 3, "page3", "page3", "nrsempty", "0", "반기배당")
		contHeader.FormTab0.insertPage( 4, "page4", "page4", "nrsempty", "0", "연배당")	
		contHeader.FormTab0.insertPage( 5, "page5", "page5", "nrsempty", "0", "기타")	

	else
		contHeader.FormTab0.insertPage( 0, "page0", "page0", "nrsempty", "0", " 전체 ")
		contHeader.FormTab0.insertPage( 1, "page1", "page1", "nrsempty", "0", " 월배당 ")
		contHeader.FormTab0.insertPage( 2, "page2", "page2", "nrsempty", "0", " 분기배당 ")	
		contHeader.FormTab0.insertPage( 3, "page3", "page3", "nrsempty", "0", " 반기배당 ")
		contHeader.FormTab0.insertPage( 4, "page4", "page4", "nrsempty", "0", "  연배당  ")	
		contHeader.FormTab0.insertPage( 5, "page5", "page5", "nrsempty", "0", " 기타 ")
	
	end if
	
	'초기페이지 지정
	contHeader.FormTab0.currenttab = 0
	contHeader.FormTab0_OnTabChanged(0)
	
	'애니메이션 사용여부 설정
	if gOsType == "1" then
		contHeader.FormTab0.SetUseAnimation(true)
	else
		contHeader.FormTab0.SetUseAnimation("1")
	end if
	
	ApplyExCondData()
	
End Function
'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub contBody_Pannel0_OnClick(nIndex, sCellID)
	
	isHeader = contBody.Pannel0.getPropCardCell("visible","LabelHeaderText",nIndex)
	
	if isHeader == "1" then
		
		if isPossibleFold(nIndex) then
			
			isFold = contBody.Pannel0.getPropCardCell("caption","LabelHeaderFold",nIndex)
		
			if isFold == "0" then
				contBody.Pannel0.setPropCardCell("caption","LabelHeaderFold",nIndex,"1")
				foldGroup(nIndex)
			else
				contBody.Pannel0.setPropCardCell("caption","LabelHeaderFold",nIndex,"0")
				unfoldGroup(nIndex)
		
			end if
		
		end if
		
		
	else
		
		'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
			gWidePannelIndex = nIndex
			foldBottomLinkArea(nIndex,gFoldPannelHeight)
		
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			'링크버튼 영역 클릭 시
			if isLinkButton(sCellID) then
			
				'마스터파일 체크 로직 추가
				if CheckMasterFile(nIndex) then
				
				else
					Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
					Exit Sub
				End if
			
				'현재가
				if sCellID == "ButtonLink0" then
					SetHistory("set",nIndex)
					MoveScreen("hyun",nIndex)
				
				'배당정보
				elseif sCellID == "ButtonLink1" then
					SetHistory("set",nIndex)
					MoveScreen("info",nIndex)
				
				'관심등록
				elseif sCellID == "ButtonLink2" then
					szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
					szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
					sParam = "ADD"
					Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam & "★" & nIndex ,"", "2")	'종목등록
				
				'매수
				elseif sCellID == "ButtonLink3" then
					SetHistory("set",nIndex)
					MoveScreen("mesu",nIndex)
				
				'매도
				elseif sCellID == "ButtonLink4" then
					SetHistory("set",nIndex)
					MoveScreen("medo",nIndex)
				
				end if
				
				
			'링크버튼 외 영역 클릭 시
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
				
				end if
			
			
			end if
			
		end if
		
		
	
	
	end if
	
	
End Sub
