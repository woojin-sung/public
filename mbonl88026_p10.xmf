'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitData" then
		if trim(sParam) ~= "" then
			WebView0.urlpath = sParam
		end if
	end if 
End Sub

'============================================================================
Sub WebView0_OnLoadingFinished()
	WebView0.scrollTop()
End Sub


