'			Container0.lblInfo3.top = 1110 + 80 + szHeight
'			Container0.lblInfo4.top = 1198 + 80 + szHeight
'			Container0.lblInfo5.top = 1258 + 80 + szHeight
'			Container0.lblInfo6.top = 1318 + 80 + szHeight
'			Container0.lblSeper0.top = 1425
'			
'			Container0.Table2.top = 813 + szHeight
			
			Container0.lblSeper1.top = 785 + szHeight
			Container0.Label4.top = 953 + szHeight
			Container0.imgRdo0.top = 986 + szHeight
			Container0.lblAttach1.top = 982 + szHeight
			Container0.Image0.top = 996 + szHeight
			Container0.imgRdo1.top = 986 + szHeight
			Container0.lblAttach.top = 982 + szHeight
			Container0.Image1.top = 996 + szHeight
			Container0.TableInfo.top = 1051 + szHeight
			Container0.lblInfo1.top = 1111 + szHeight
			Container0.lblInfo2.top = 1191 + szHeight
			Container0.lblInfo3.top = 1270 + szHeight
			Container0.lblInfo4.top = 1358 + szHeight
			Container0.lblInfo5.top = 1418 + szHeight
			Container0.lblInfo6.top = 1478  + szHeight
			Container0.lblSeper0.top = 1555
			Container0.Table2.top = 813 + szHeight
			
		end if
		
		'// 투자주요내용 > 상품내용 및 투자대상 선택시 필요항목 추가.
		Form.SetSharedData("MBONL88060_P1_SHTR_BOND_REG_CLS_CODE", g_SHTR_BOND_REG_CLS_CODE)'투자대상유형코드(20:발행물(메리츠증권 단기사채) / 21:유통물(자산유동화 단기사채))
		Form.SetSharedData("MBONL88060_P1_KOR_ISNM", g_KOR_ISNM)	'종목명
		Form.SetSharedData("MBONL88060_P1_PBLC_DATE", g_PBLC_DATE)	'발행일
		Form.SetSharedData("MBONL88060_P1_MTRT_DATE", g_MTRT_DATE)	'만기일
		Form.SetSharedData("MBONL88060_P1_CRDT_GRAD", g_CRDT_GRAD)	'신용등급
		Form.SetSharedData("MBONL88060_P1_PROD_GRAD_CODE", g_PROD_GRAD_CODE)	'투자등급


		Container0.SetScrollAutoSize()
		
	end if
	
	if g_nMode == "0" then
		g_sUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"	'운영계 주소
	elseif g_nMode == "1" then
		g_sUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"	'테스트계주소
	end if
	
	
	Container0.lblDisAmt.caption = "0원으로 매수할 수 있어요."
	Container0.lblDisAmt.changeTextAttr(1, 14, 4, 0, false)

	'하단의 유의사항 폰트
	Container0.lblInfo1.changeTextAttr(32, 48, 10, -2, false)
	Container0.lblInfo2.changeTextAttr(40, 37, 10, -2, false)
	'Container0.lblInfo3.changeTextAttr(19, 19, 10, -2, false)
	Container0.lblInfo3.changeTextAttr(19, 10, 10, -2, false)	'v003
	Container0.lblInfo7.changeTextAttr(125, 54, 10, -2, false)
	
