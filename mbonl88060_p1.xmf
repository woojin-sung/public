Sub Container0_BtnPrcin_OnClick()
	Dim szPrc, szData

	dim sOS_Type
	sOS_Type = Form.GetSharedData("&OS_TYPE", false)
	if sOS_Type = "2" then  'iOS
		Container0.scroll_pos_noAni = "0"
	else
		Container0.scroll_pos = "0"
	end if
	
	'EK Edit
'	if Trim(Container0.LblPrcin.caption) <> "" then
'		szPrc = Container0.LblPrcin.caption
'	else
		szPrc = ""
'	end if
	
	Container0.BtnPrcin.caption = ""
	Container0.LblPrcin.caption = ""

	Form.SetSharedData("OPEN_FILE_NAME", "mbonl88060_p1" )
	'금액 키패드 오픈
	Form.OpenPopup("mbonl88060_p9", szPrc, "")
End Sub

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	Container0.ImgPrcreset.visible = false
	
	'EK Edit
	'Container0.BtnPrcin.caption = ""
	Container0.BtnPrcin.caption = "금액을 입력해주세요"
	
	Container0.LblPrcin.caption = ""
'	Container0.LblAlert.caption = ""

	Init_Data()
End Function

'============================================================================
Function	Init_Data()
	Container0.Label111.caption = 0	'매수금액
	Container0.Label119.caption = 0	'예상이자(세전)
	Container0.Label1111.caption = 0	'만기상환금액
	
	Container0.Label113.caption = 0	'예상세금
	Container0.Label115.caption = 0	'예상이자(세후)
	Container0.Label115.setHighlight(28)	'초기화
	Container0.Label116.caption = 0	'만기정산금액(예정)
End Function

'============================================================================
Sub Container0_ImgPrcreset_OnClick()
	Init_InputControl()
End Sub

'============================================================================
Sub Container0_LblPrcin_OnClick()
	Container0.ImgPrcreset.visible = true
	if Trim(g_szPopPrc) <> "" then
		szPrc = CLng(g_szPopPrc)
	else
		szPrc = CLng(Container0.LblPrcin.caption)
	end if

	'EK ADD
	if szPrc == 0 or szPrc == "" then
		Container0.BtnPrcin.caption = "금액을 입력해주세요"
		
		Init_Data()
	elseif szPrc mod 1000000 > 0  then
		'1억 초과 & 매매단위(1백만원) 조건 미부합인 경우
		Form.ShowAlert( "알림" , "1억 이상 백만원 단위로만 입력 가능해요.")
		Container0.BtnPrcin.caption = "금액을 입력해주세요"
		Init_Data()
		
		return false
	
	elseif ( szPrc < 100000000 ) then
		'1억 초과 & 매매단위(1백만원) 조건 미부합인 경우
		Form.ShowAlert( "알림" , "1억 이상 백만원 단위로만 입력 가능 해요.")
		Container0.BtnPrcin.caption = "금액을 입력해주세요"
		Init_Data()
		
		return false
	else
		
'		Container0.LblAlert.caption = ""
		Container0.LblPrcin.caption = szPrc	
		
		if szPrc <> "" and szPrc <> null then
			DATAMANAGER.RequestTranData( "obfnp_fnmt_994r" )
		end if
		
	end if
	
'	Container0.LblPrcin.caption = szPrc	
'	
'	if szPrc <> "" and szPrc <> null then
'		DATAMANAGER.RequestTranData( "obfnp_fnmt_994r" )
'	end if
End Sub

