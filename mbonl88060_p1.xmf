			Container0.Table0.SetCellString(7, 2, "할인")	'이자지급방식(하드코딩)
			Container0.Table0.SetCellString(8, 2, "만기일시상환")	'상환방법(하드코딩)
			
			
			' 상품상세 아래 컨트롤들 위치 조정.
			szHeight = 40
