				'매수신청화면 오픈
				Form.OpenPopup("mbonl88060_p2", szData, "")
			end if
		end if	
	ElseIf szTranID = "obsap_acif_999a" Then
        g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
	
	elseif szTranID == "obsac_deal_212r_1" then
		Form.OpenPopup("mbonl81010_p20" , "" , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	if szTranID == "obsac_deal_209a" then
		if szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
		
		elseif szErrCode == "0340" then
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
			
		else
			If g_AcntNo <> "" And g_AcntNo <> null Then
				'투자성향등록여부, 투자성향만기여부
				DATAMANAGER.RequestTranData( "obcsb_acif_700r" )
			else
				Form.MsgBox("알림" , "신청 가능한 계좌가 없습니다. \n고객지원센터로 문의해주세요.", "", "6")
			end if	
		end if
	
	elseif szTranID == "obsac_deal_212r_1" then
		if szErrCode == "6229" then
			Form.ShowAlert("알림", "매수신청은 영업일만 가능합니다.")
		elseif szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)			
		else
			if szSubErr <> null and Trim(szSubErr) <> "" then
				Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
			else
				Form.ShowAlert( "알림" , szErrMsg)
			end if
		end if
	
	else
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , szErrMsg)
		end if
	end if
End Sub

