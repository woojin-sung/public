	<SCRIPT_INFO _len="40378" _ulen="35718" >
'2024.01.03. 박윤경 : v001. 발행물 가능수량 수정
'2024.01.17. 박윤경 : v002. 유통물 가능수량 수정
'2024.06.25. 박윤경 : v003. 예금자보호 문구 변경
'============================================================================
' 단기사채 상품상세조회
'============================================================================

dim g_DiscountedAmt	'할인된금액
dim g_ExpectedAmt		'예상이자

dim g_szRet
dim g_ErrMsgText

dim g_sUrl

dim szTheme, szOSType

dim g_bMoveTicker
g_bMoveTicker = false

dim g_szFnprJoinSrno
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	imgList.setMaintainingRatio("1")
	
	Container0.imgInfo.setMaintainingRatio("1")
	
	Container0.Image0.setMaintainingRatio("1")
	Container0.Image1.setMaintainingRatio("1")
	
	Container0.ImgPrcreset.setMaintainingRatio("1")
	
	Container0.imgGraph.setMaintainingRatio("1")
'	Container0.imgBox.setMaintainingRatio("1")
	
	Container0.imgTooltip.setMaintainingRatio("1")
	
'	Container0.imgBadge1.setMaintainingRatio("1")
'	Container0.imgBadge2.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()

' 상품정보 변경.
' 유통물 : Table1 (모집일/발행일/만기일/신용등급/투자등급/이자지급방식/상환방법)
' 타행물 : Table0 (발행일/매수일/만기일/신용등급/투자등급/신용보강기관/이자지급방식/상환방법)
'============================================================================
Sub Form_OnFormInit()

	szTheme = Form.GetEnvData("common.theme")
	szOSType = Form.GetSharedData("&OS_TYPE", false)

	'20230317_01 HWG START : 가격입력 배경이미지 변경
	if szOSType == "1" then
		Container0.imgBox.imgpath = "img_bgcircle_input_320"
	elseif szOSType == "2" then
		If szTheme == "white" Then	
			Container0.imgBox.imgpath = "img_bgcircle_320_w"
		else
			Container0.imgBox.imgpath = "img_bgcircle_320_b"
		end if
	end if
	'20230317_01 HWG END
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_AcntNo 			= tData[0]	'계좌번호
		g_AcntSeq 			= tData[1]	'계좌순번
		g_ISCD 				= tData[2]	'종목코드
		g_KOR_ISNM 			= tData[3]	'종목한글명
		g_RCRT_FIN_DATE 		= tData[4]	'모집종료일자
		g_RCRT_CLSN_HOUR 		= tData[5]	'모집마감시간
		g_INVT_DYNU		 	= tData[6]	'투자일수
		g_GNRL_INTRT 			= tData[7]	'일반이자율
		g_MTRT_DATE 			= tData[8]	'만기일자
		g_PROD_GRAD_CODE 		= tData[9]	'상품등급코드
		g_CRDT_GRAD 			= tData[10]	'신용등급코드
		g_RMNN_WNCR_AMT 		= tData[11]	'잔여원화금액
		g_TOTAL_ODER_LIMT_AMT 	= tData[12]	'총주문한도금액
		g_PBLC_DATE 			= tData[13]	'발행일자
		g_INVT_TRGT_TYPE_CODE	= tData[14]	'투자대상유형코드
		g_FILE_PATH_NAME		= tData[15]	'홈페이지첨부파일경로명(MTS사용)
		g_FILE_PATH_NAME1		= tData[16]	'홈페이지평가파일경로명(MTS사용)
		g_INVT_ABLE_AMT		= tData[17]	'투자가능금액

		'g_INVT_TRGT_TYPE_CODE	= tData[18]	'투자대상유형코드	'v001 주석처리
		g_IQRY_CLS_CODE		= tData[19]	'조회구분코드
		g_TRGT_CLS_CODE		= tData[20]	'대상구분코드

		g_RCRT_STA_DATE 		= tData[21]	'모집시작일자
		g_RCRT_STA_HOUR 		= tData[22]	'모집시작시간

		g_SHTR_BOND_REG_CLS_CODE 	= tData[23]	'단기사채등록구분코드(1:발행물/2:유통물)
		g_CREN_CO_NAME 		= tData[24]	'신용보강회사명(타행물인 경우에만)
		g_PSNT_DATE 			= tData[25]	'현재일자(타행물인 경우 매수일)

		'프로그레스바 로직
		
		' 신청수량이 없는경우
		if (Clng(g_TOTAL_ODER_LIMT_AMT) - Clng(g_RMNN_WNCR_AMT)) = 0 then
			Container0.imgProgress.imgpath = "img_progressbar_step01"
			
		' 신청수량이 있는경우	
		else
			if Clng(g_RMNN_WNCR_AMT) < 100000000 then
				Container0.imgProgress.imgpath = "img_progressbar_step10"
				
			else
				'(모집금액 - 잔여수량) vs. 총매수수량 비교하여 상태바표시.
				if g_TOTAL_ODER_LIMT_AMT <> "" and g_TOTAL_ODER_LIMT_AMT <> null and g_TOTAL_ODER_LIMT_AMT <> 0 then
					tmpData = ( (g_TOTAL_ODER_LIMT_AMT - g_RMNN_WNCR_AMT) /  g_TOTAL_ODER_LIMT_AMT * 100 )
					tmpData = CLng(Round(tmpData))
				
					
					'KEK STA. 이미지명 변경
					if tmpData < 10 then
						Container0.imgProgress.imgpath = "img_progressbar_step02"
					elseif tmpData < 20 then
						Container0.imgProgress.imgpath = "img_progressbar_step03"
					elseif tmpData < 30 then
						Container0.imgProgress.imgpath = "img_progressbar_step04"
					elseif tmpData < 40 then
						Container0.imgProgress.imgpath = "img_progressbar_step05"
					elseif tmpData < 50 then
						Container0.imgProgress.imgpath = "img_progressbar_step06"
					elseif tmpData < 60 then
						Container0.imgProgress.imgpath = "img_progressbar_step07"
					elseif tmpData < 70 then
						Container0.imgProgress.imgpath = "img_progressbar_step07"
					elseif tmpData < 80 then
						Container0.imgProgress.imgpath = "img_progressbar_step08"
					elseif tmpData < 90 then
						Container0.imgProgress.imgpath = "img_progressbar_step09"
					elseif tmpData <= 100 then
						Container0.imgProgress.imgpath = "img_progressbar_step10"
					end if
					'KEK FIN.
				else
					tmpData = 0
					Container0.imgProgress.imgpath = "img_progressbar_step01"
				end if
			end if
		end if

		Container0.Label0.caption = g_KOR_ISNM
		
		Container0.Label21.caption = Clng(g_TOTAL_ODER_LIMT_AMT)/100000000 .. "억"	'총주문한도금액(억단위로 표기)
		
		Container0.Label11.caption = g_INVT_DYNU		'투자기간
		Container0.Label12.caption = g_GNRL_INTRT	'수익률
				
		Container0.Label16.caption = g_RMNN_WNCR_AMT		'잔여수량
		Container0.Label17.caption = 1	'최소투자금액(하드코딩)
		Container0.Label18.caption = g_TOTAL_ODER_LIMT_AMT	'모집금액
		
		if g_RCRT_STA_DATE <> "" and g_RCRT_FIN_DATE <> "" then
			'20230317 KEK STA. 모집시작일 = 모집종료일의 경우 모집시작일만 조회
			if g_RCRT_STA_DATE == g_RCRT_FIN_DATE  then
				strtmpString = Left(g_RCRT_STA_DATE,4).."."..Mid(g_RCRT_STA_DATE,5,2).."."..Right(g_RCRT_STA_DATE,2)
			else
				strtmpString = Left(g_RCRT_STA_DATE,4).."."..Mid(g_RCRT_STA_DATE,5,2).."."..Right(g_RCRT_STA_DATE,2).." ~ " .. Left(g_RCRT_FIN_DATE,4).."."..Mid(g_RCRT_FIN_DATE,5,2).."."..Right(g_RCRT_FIN_DATE,2)
			end if
			'20230317 KEK FIN.
		else
			strtmpString = ""
		end if
		
		'개선 추가
		'상품등급 뱃지, 신용등급 뱃지
		Container0.lblBadge1.caption = g_PROD_GRAD_CODE
		if Trim(g_PROD_GRAD_CODE) == "매우높은위험" then
			Container0.imgBadge1.imgpath = "img_bgsquare_grade_372.png"
			Container0.lblBadge1.fgcolor = "273"
		elseif Trim(g_PROD_GRAD_CODE) == "높은위험" then
			Container0.imgBadge1.imgpath = "img_bgsquare_grade_373.png"
			Container0.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "다소높은위험" then
			Container0.imgBadge1.imgpath = "img_bgsquare_grade_374.png"
			Container0.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "보통위험" then
			Container0.imgBadge1.imgpath = "img_bgsquare_grade_375.png"
			Container0.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "낮은위험" then
			Container0.imgBadge1.imgpath = "img_bgsquare_grade_376.png"
			Container0.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "매우낮은위험" then
			Container0.imgBadge1.imgpath = "img_bgsquare_grade_377.png"
			Container0.lblBadge1.fgcolor = "273"
		end if
		
'		if Trim(g_PROD_GRAD_CODE) == "초고위험" then
'			Container0.imgBadge1.imgpath = "img_bgsquare_grade_296.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "고위험" then
'			Container0.imgBadge1.imgpath = "img_bgsquare_grade_297.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "중위험" then
'			Container0.imgBadge1.imgpath = "img_bgsquare_grade_298.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "저위험" then
'			Container0.imgBadge1.imgpath = "img_bgsquare_grade_299.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "초저위험" then
'			Container0.imgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		end if
