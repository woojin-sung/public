			szParam5		= g_RMNN_WNCR_AMT '잔여원화금액
			szParam6		= g_KOR_ISNM '종목명
			szParam7		= g_FILE_PATH_NAME	'투자설명서
			
			szParam8		= g_INVT_TRGT_TYPE_CODE	''투자대상유형코드
			szParam9		= g_IQRY_CLS_CODE	''조회구분코드
			szParam10	= g_TRGT_CLS_CODE	''대상구분코드
			szParam11	= g_RCRT_FIN_DATE	'모집종료일
			
	
			szParam12	= g_SHTR_BOND_REG_CLS_CODE		'단기사채등록구분코드(1:발행물/2:유통물)
			szParam13	= g_PSNT_DATE 				'현재일자(타행물인 경우 매수일)

			
			szParam14	= g_PROD_GRAD_CODE		'상품등급코드
			szParam15	= g_CRDT_GRAD				'신용등급코드
			szParam16	= g_CREN_CO_NAME
			
			'종목코드, 거래수익률, 매매금액(주문수량 동일)
			szData = szParam0 & "★" & szParam1 & "★" & szParam2  & "★" & szParam3 & "★" & szParam4
					& "★" & szParam5 & "★" & szParam6 & "★" & szParam7 & "★" & szParam8 & "★" & szParam9
					& "★" & szParam10 & "★" & szParam11& "★" & szParam12 & "★" & szParam13 & "★" & szParam14 & "★" & szParam15
					& "★" & szParam16
					
					
			if szData <> "" And szData <> null  then
				'매수신청화면 오픈
				Form.OpenPopup("mbonl88060_p2", szData, "")
			end if
		end if	
		
	elseif szTranID == "obcsb_acif_700r_1" then
		Dim szProsYN
		
		szProsYN	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r_1", "OutBlock1", "PROS_YN", 0)
		g_szKYC_INVT_RCMD_CLS_CODE 	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r_1", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0) '적정성상품여부 v011
		g_szAPRT_SRNM_PROD_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r_1", "OutBlock1", "APRT_SRNM_PROD_YN", 0) 'KYC투자권유구분코드 v011
		szHgdtYN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "HGDT_PROD_YN", 0)	'
		Form.SetSharedData("KYC_INVT_RCMD_CLS_CODE"	, g_szKYC_INVT_RCMD_CLS_CODE) 'v011
		Form.SetSharedData("MBONL88060_PROS_YN"	, szProsYN)

		Dim szAlertData
		if szProsYN = "A" then '투자성향 등록여부
			g_ErrTitle = "투자자정보등록 안내"
			g_ErrMsgText = "고객님의 투자성향 정보가\n등록되지 않아 상품 가입이 불가합니다.\n\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbonl88060_p8", szAlertData, "")
	
		elseif szProsYN = "B" then '투자성향 만기여부
			g_ErrTitle = "투자자정보 만료 안내"
			g_ErrMsgText = "고객님의 투자성향 만기가 경과되어\n해당 상품 가입이 불가합니다.\n\n투자성향 등록 후 진행해주세요."
			szAlertData = "2".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbonl88060_p8", szAlertData, "")
			
		elseif szProsYN	=	"S"	then	 '취약금융 소비자 여부
			Form.MsgBox("취약금융소비자 투자보호 안내" , "고객님은 취약금융소비자입니다. 투자자보호를 위해 투자성향보다 위험등급이 한단계를 초과한 상품가입이 불가합니다.", "", "6")

		elseif  g_szAPRT_SRNM_PROD_YN = "Y" THEN '부적합 상품 거래 확인서
			Form.OpenPopup("mbbdm85145", "", "")
			Exit Sub
		
		else
			Dim szData
			
			szData = ""
			
			szParam0 	= g_ISCD
			szParam1 	= g_GNRL_INTRT
			szParam2 	= Container0.LblPrcin.caption	'매매금액
			szParam3		= g_INVT_DYNU	'투자기간
			szParam4		= g_INVT_ABLE_AMT	'총주문한도금액
			szParam5		= g_RMNN_WNCR_AMT '잔여원화금액
			szParam6		= g_KOR_ISNM '종목명
			szParam7		= g_FILE_PATH_NAME	'투자설명서
			
			szParam8		= g_INVT_TRGT_TYPE_CODE	''투자대상유형코드
			szParam9		= g_IQRY_CLS_CODE	''조회구분코드
			szParam10	= g_TRGT_CLS_CODE	''대상구분코드
			szParam11	= g_RCRT_FIN_DATE	'모집종료일
			
			
			'종목코드, 거래수익률, 매매금액(주문수량 동일)
			szData = szParam0 & "★" & szParam1 & "★" & szParam2  & "★" & szParam3 & "★" & szParam4 & "★" & szParam5 & "★" & szParam6 & "★" & szParam7 & "★" & szParam8 & "★" & szParam9 & "★" & szParam10 & "★" & szParam11

