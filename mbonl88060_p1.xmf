Sub Form_OnFormClose()
	g_KOR_ISNM = Form.SetSharedData("MBONL88060_P1_KOR_ISNM", "")	'종목명
	g_PBLC_DATE = Form.SetSharedData("MBONL88060_P1_PBLC_DATE", "")	'발행일
	g_MTRT_DATE = Form.SetSharedData("MBONL88060_P1_MTRT_DATE", "")	'만기일
	g_CRDT_GRAD = Form.SetSharedData("MBONL88060_P1_CRDT_GRAD", "")	'신용등급
	g_PROD_GRAD_CODE = Form.SetSharedData("MBONL88060_P1_PROD_GRAD_CODE", "")	'투자등급

	Form.SendReturnToParent("mbonl88060_p1", g_szRet)
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	
	if Cint(sTimerID) = 1 then
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
		g_bMoveTicker = false
	end if
End Sub

