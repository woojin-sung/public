'		Container0.lblExpectedAmt.top = 370	'392
'	else
'		Container0.lblExpectedAmt.top = 537
'	end if


	'수익률, 예상이자(세전) 금액 조회
	Container0.LblPrcin.caption = 100000000	'1억 디폴트.
	Container0.BtnPrcin.caption = ""
	if g_ISCD <> "" and g_ISCD <> null then
		DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
		DATAMANAGER.RequestTranData( "obfnp_fnmt_994r" )
	end if

	if g_RMNN_WNCR_AMT <> "" and g_RMNN_WNCR_AMT <> null and g_RMNN_WNCR_AMT <> 0 then
		if int(g_RMNN_WNCR_AMT) < 100000000 then
			btnOK.btnimage = "btn_15.9"
			btnOK.enable = false
			
			Container0.imgProgress.imgpath = "img_progressbar_step10"
		else
			btnOK.enable = true
			btnOK.btnimage = "btn_05.9"
		end if
	else
		
		btnOK.btnimage = "btn_15.9"
		btnOK.enable = false
		
		Container0.imgProgress.imgpath = "img_progressbar_step10"
	end if
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  szOSType == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'===============================================
	' 가격입력창에서 리턴
	'===============================================
	if sKeyName == "PRC_POPUP" then		
		'EK ADD
		if sRet == "" then
			Container0.BtnPrcin.caption = "금액을 입력해주세요"	
			Init_Data()
		elseif sRet <> "" and int(sRet) <> 0 and sRet <> null then
			Container0.ImgPrcreset.visible = true
			g_szPopPrc = sRet
			call Container0_LblPrcin_OnClick()
		else
			Container0.ImgPrcreset.visible = false
'			Container0.LblAlert.caption = ""
			Container0.BtnPrcin.caption = ""
		end if
		
	'===============================================
	elseif sKeyName == "mbonl88060_p2" then	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			if sRet <> "GO_BACK" then
				g_szRet = sRet
				Form.CloseForm()
			end if
		end if
		
	'===============================================
	'********** 공통 얼럿 팝업 리턴      ***********
	'===============================================
	ElseIf sKeyName == "errMsgBox"  Then
		if sRet = "Right" then	'투자성향 등록 화면으로 이동
			Form.OpenFramePopup("mbonl81010" , "mbonl88060" , "")
		end if	
		
	Elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then			
			'// case1) 계좌번호 + 종목코드로 obcsb_acif_400r
			'// case2) 계좌번호 + 상품등급으로 obcsb_acif_701r 
			Form.SetSharedData("FNP51000_P8_ACC_NO", g_AcntNo)	'계좌번호
			Form.SetSharedData("FNP51000_P8_ISCD", g_ISCD)		'종목코드
			Form.SetSharedData("FNP51000_P8_PROD", "")			'상품등급
			Form.SetSharedData("&SCREEN_NO" , "88060")	'화면번호 강제로 셋팅 한번 더!

			Form.OpenPopup("mbfnp51000_p8", "", "")	'투자성향 및 위험등급 확인 팝업 호출
			
'			DATAMANAGER.RequestTranData( "obsac_deal_209a" )
		elseif sRet == "CANCEL_mbonl81010_p20" then
			'do nothing!!!
		end if
		
	Elseif sKeyName == "mbfnp51000_p8" then	'고객투자성향안내팝업
		'투자성향 재진단으로 연결
		if sRet == "MOVE" then
			g_szRet = sRet
			Form.CloseForm()
		'다음으로 진행
		elseif sRet == "NEXT_mbfnp51000_p8" then
			DATAMANAGER.RequestTranData( "obsac_deal_209a" )
		else
		
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obfnp_fnmt_994r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , "5" )	'처리구분코드

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 0 , g_ISCD )
		
		if g_SHTR_BOND_REG_CLS_CODE == "1" then	
			'''obsap_deal_003r.SHTR_BOND_REG_CLS_CODE : 1(발행물)인 경우, 모집종료일로 이자계산
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 1 , g_RCRT_FIN_DATE )	'모집종료일
		else
			'''obsap_deal_003r.SHTR_BOND_REG_CLS_CODE : 2(유통물)인 경우, 현재일자로 이자계산
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 1 , Form.GetSharedData( "&HOST_DATE", false ) )
		end if

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 2 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 3 , g_GNRL_INTRT )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 4 , CDBL(Container0.LblPrcin.caption) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 5 , 1 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 6 , "" )
			
	elseif szTranID == "obsac_deal_212r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"			, 0 , g_ISCD )	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_ERT"			, 0 , g_GNRL_INTRT )	'거래수익률
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODQT" 			, 0 , CDBL(Container0.LblPrcin.caption) )	'주문수량
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEAL_AMT"		, 0 , g_DiscountedAmt )	'매매금액
	
	elseif szTranID == "obsac_deal_212r_1" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE"			, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SHTR_BOND_REG_CLS_CODE"			, 0 , g_SHTR_BOND_REG_CLS_CODE )
	
	elseif szTranID == "obcsb_acif_700r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , g_AcntNo )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , g_AcntSeq )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"	, 0 , "01" )	'KYC 업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE"		, 0 , "13005" )	'업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0 , g_ISCD )	'종목코드

	elseif szTranID == "obcsb_acif_700r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , g_AcntNo )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , g_AcntSeq )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"	, 0 , "01" )	'KYC 업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE"		, 0 , "13005" )	'업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0 , g_ISCD )	'종목코드

	elseif szTranID == "obsac_deal_209a" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "3")	'1:신청/2:취소/3:조회
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_AcntNo)	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_AcntSeq)'계좌번호접촉구분코드
'		'v0002 컨트롤매핑->스크립트 변경
'		if g_plain_rm == "1" then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)	'비밀번호
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
'		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"	, 0 , g_ISCD				)	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODQT" , 0 , CDBL(Container0.LblPrcin.caption))	'주문수량
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obfnp_fnmt_994r" then 	
		g_DiscountedAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CODE_NAME", 0)	'할인된금액
		g_ExpectedAmt = CDBL(Container0.LblPrcin.caption) - CDBL(g_DiscountedAmt)	'예상이자 = 매매금액 - 할인금액
	
		nTickerTime = 0.7

		Container0.lbblGnrlIntrt.caption = g_GNRL_INTRT	'수익률
		g_bMoveTicker = true
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
		Form.SetTimerEvent2(1, 1, nTickerTime*2)
		
		Container0.lblDisAmt.caption = FormatNumber(g_DiscountedAmt,0) .. "원으로 매수할 수 있어요."
		Container0.lblDisAmt.changeTextAttr(0, Len(FormatNumber(g_DiscountedAmt,0))+1, 10, 0, false)	
		
		'2023.03.07 ADD
		DATAMANAGER.RequestTranData( "obsac_deal_212r" )
		
	elseif szTranID == "obsac_deal_212r" then
		g_APLC_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "APLC_YN", 0)	'당사발행물여부
		
		nINTX = CDBL(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "INTX", 0))	'소득세
		nRSTX = CDBL(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "RSTX", 0))	'주민세
		nSTAS_AMT = CDBL(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "STAS_AMT", 0))	'과표금액
		nSELN_EXCL_AMT = CDBL(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "SELN_EXCL_AMT", 0))	'매도정산금액
		
'		if g_APLC_YN == "Y" then
'			Container0.Label6.caption = "메리츠증권이 발행하는 단기사채"
'			Container0.Label6.width =  256
'			Container0.imgInfo.left = 218		
'		else
			Container0.Label6.caption = "단기사채"
			Container0.Label6.width =  56
			Container0.imgInfo.left = 78
'		end if
	
		Container0.Label111.caption = CDBL(g_DiscountedAmt)	'매수금액
		Container0.Label119.caption = CDBL(g_ExpectedAmt)	'예상이자(세전)
		Container0.Label1111.caption = g_DiscountedAmt + g_ExpectedAmt'만기상환금액
		Container0.Label113.caption = nINTX + nRSTX	'예상세금
		Container0.Label115.caption = nSTAS_AMT - (nINTX + nRSTX)	'예상이자(세후)
		Container0.Label116.caption = nSELN_EXCL_AMT	'만기정산금액(예정)
		
		Container0.Label115.setHighlight(332)
	
	elseif szTranID == "obsac_deal_209a" then 
		If g_AcntNo <> "" And g_AcntNo <> null Then
			'투자성향등록여부, 투자성향만기여부
			DATAMANAGER.RequestTranData( "obcsb_acif_700r" )
		else
			Form.MsgBox("알림" , "신청 가능한 계좌가 없습니다. \n고객지원센터로 문의해주세요.", "", "6")
		end if
		
	'LHR 투자성향진단 추가
	elseif szTranID == "obcsb_acif_700r" then
		Dim szProsYN
		
		szProsYN	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "PROS_YN", 0)
		g_szKYC_INVT_RCMD_CLS_CODE 	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0) '적정성상품여부 v011
		g_szAPRT_SRNM_PROD_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "APRT_SRNM_PROD_YN", 0) 'KYC투자권유구분코드 v011
		szHgdtYN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "HGDT_PROD_YN", 0)	'
		Form.SetSharedData("KYC_INVT_RCMD_CLS_CODE"	, g_szKYC_INVT_RCMD_CLS_CODE) 'v011
		Form.SetSharedData("MBONL88060_PROS_YN"	, szProsYN)

		Dim szAlertData
		if szProsYN = "A" then '투자성향 등록여부
			g_ErrTitle = "투자자정보등록 안내"
			g_ErrMsgText = "고객님의 투자성향 정보가\n등록되지 않아 상품 가입이 불가합니다.\n\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbonl88060_p8", szAlertData, "")
	
		elseif szProsYN = "B" then '투자성향 만기여부
			g_ErrTitle = "투자자정보 만료 안내"
			g_ErrMsgText = "고객님의 투자성향 만기가 경과되어\n해당 상품 가입이 불가합니다.\n\n투자성향 등록 후 진행해주세요."
			szAlertData = "2".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbonl88060_p8", szAlertData, "")
			
		elseif szProsYN	=	"S"	then	 '취약금융 소비자 여부
			Form.MsgBox("취약금융소비자 투자보호 안내" , "고객님은 취약금융소비자입니다. 투자자보호를 위해 투자성향보다 위험등급이 한단계를 초과한 상품가입이 불가합니다.", "", "6")

		elseif  g_szAPRT_SRNM_PROD_YN = "Y" THEN '부적합 상품 거래 확인서
			Form.OpenPopup("mbbdm85145", "", "")
			Exit Sub
		
		else
			Dim szData
			
			szData = ""
			
			szParam0 	= g_ISCD
			szParam1 	= g_GNRL_INTRT
			szParam2 	= Container0.LblPrcin.caption	'매매금액
