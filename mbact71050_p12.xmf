	<SCRIPT_INFO _len="3655" _ulen="3339" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_기타금융상품_CD,CP/전단채
' 02. 화면설명 : 고객자산평가_상품별잔고_기타금융상품_CD,CP/전단채
' 03. 작    성 : 2016. 02. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szList
	
	if sEventName == "기타_CD,CP/전단채" then
	
		szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(szList) < 1 then
		Exit Sub
	End if
	
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_032r", "InBlock1", "ACNO" , 0 , szList(0) )		'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_032r", "InBlock1", "ACNT_PWD" , 0 , szList(1) )	'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_032r", "InBlock1", "STND_DATE" , 0 , szList(2) )	'날짜
		
	g_nNextCount = 0
	DATAMANAGER.RequestTranData( "obacb_balc_032r" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp		
	Dim nCode		'매크로 유가증권구분코드
	Dim szType		'매크로 선후취
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_032r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_032r", "OutBlock1")-1
			g_nNextCount = g_nNextCount + 1
			szTemp = DATAMANAGER.GetDataValue( 0 , "obacb_balc_032r", "OutBlock1", "ACNO" , i) &
			DATAMANAGER.GetDataValue( 0 , "obacb_balc_032r", "OutBlock1", "ACNT_PRNM" , i)
			
			'HTS에 매크로로 되어있는 부분, 치환이나 변환값을 나타냄
			Select Case DATAMANAGER.GetDataValue( 0 , "obacb_balc_032r", "OutBlock1", "MKSC_CLS_CODE" , i)
				Case "1"
					nCode = "CD"
				Case "2"
					nCode = "전자단기사채"
				Case "3"
					nCode = "CP"
			End Select
'			nCode = Form.GetMetaData("유가증권구분코드", DATAMANAGER.GetDataValue( 0 , "obacb_balc_032r", "OutBlock1", "MKSC_CLS_CODE" , i) )
			
			szType = Form.GetMetaData("세금납입구분코드", DATAMANAGER.GetDataValue( 0 , "obacb_balc_032r", "OutBlock1", "TAX_PAYM_CLS_CODE" , i) )
			
			grd0.SetCellData("bd_cell0", g_nNextCount - 1 , szTemp)
			
			grd0.SetCellData("bd_cell1", g_nNextCount - 1 , nCode )
			grd0.SetCellData("bd_cell12", g_nNextCount - 1 , Trim(szType) )
		next		
		
	end if
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obacb_balc_032r" )
End Sub

