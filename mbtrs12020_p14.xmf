'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SecType		' 신용구분
Dim 	g_szOrd_SecDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    If g_nOrd_ChkAll = "1" Then
		g_nOrd_Price = "잔량"
    End If
    
'    If g_nIndex <> 3 Then
'	    Select Case g_szOrd_OrdType	'단가입력하지 않는 주문유형은 가격 초기화
'		Case 005, 012, 013, 061, 071, 305, 312, 405, 412, 053, 353, 453, 064
'		    g_nOrd_Price = "0"
'		End Select
'    End If

	If g_nIndex = "12" Then
		If g_szOrder_MarketType = "W" Then	'ELW
			lblMaesu1Title.caption = "(예약)ELW 매도주문"			    
		ElseIf g_szOrder_MarketType = "T" Then	'K-OTC
			lblMaesu1Title.caption = "(예약)K-OTC 매도주문"
		Else
			lblMaesu1Title.caption = "(예약)현금매도주문"
		End If
	Else
		If g_szOrder_MarketType = "W" Then	'ELW
			lblMaesu1Title.caption = "ELW 매도주문"			    
		ElseIf g_szOrder_MarketType = "T" Then	'K-OTC
			lblMaesu1Title.caption = "K-OTC 매도주문"
		End If
	End If
	
	'20180912 LES START 권리공매도
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	
	if szScrNo == "12070" then
		lblMaesu1Title.caption = "권리입고예정주식 매도주문"
	elseif szScrNo == "12080" then '20211129 HSZ : 주식대용매도 추가
		lblMaesu1Title.caption = "주식대용 매도주문" 
	end if
	'20180912 LES END
	
	Dim szStr1,szStr2,szStr3
	szStr1 = left(g_szOrder_Acc,4)
	szStr2 = mid(g_szOrder_Acc,5,4)
	szStr3 = right(g_szOrder_Acc,2)
	'현금
	tblMaedo.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
	tblMaedo.SetCellString( 1, 1, g_szOrd_ItmName	)
	tblMaedo.SetCellString( 2, 1, g_szOrd_OrdType	)
	tblMaedo.SetCellString( 3, 1, g_nOrd_Qty		)
	
	if g_nOrd_Price == "" or g_nOrd_Price == "잔량" then
		tblMaedo.SetCellString( 4, 1, "-"		)	
		tblMaedo.SetCellString( 5, 1, "-")	
	else
		tblMaedo.SetCellString( 4, 1, FormatNumber(g_nOrd_Price,0).."원"		)	
		tblMaedo.SetCellString( 5, 1, FormatNumber(g_nOrd_Price * g_nOrd_Qty,0).."원")	
	end if
	
	if g_szOrd_OrdType == "장전시간외" then
		lblInfo0.visible = true
		Image1.visible = true
		
		imgMain.top = 296 - 40
		lblMaesu1Title.top = 296 - 40
		Label0.top = 296 - 40
		Label3.top = 356 - 40
		Image0.top = 386 - 40
		tblMaedo.top = 406 - 40
		Label6.top = 520 - 40		
		imgInfo.top = 534 - 40	
	end if
	
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 11:예약매수, 12:예약매도, 14:예약취소)
	g_szOrder_MarketType	= arrData( 1)	' 주문종류 ( J:주식, W:ELW )
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_OrdType  		= arrData( 6)	' 주문구분
	g_szOrd_Security 		= arrData( 7)	' 현금/신용
	g_szOrd_SecType 		= arrData( 8)	' 신용구분
	g_szOrd_SecDate 		= arrData( 9)	' 대출일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(13)	' 잔량전부
	
	imgInfo.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'20230707 htw start 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소
	szTextSize = Form.GetEnvData("common.textsize")
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	if CInt(szTextSize) > 0 and szDeviceOS == "2" then '큰글씨 + IOS 이면
		imgInfo.left = 110
		imgInfo.top = 531
	end if
	'20230707 htw end 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소
    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub btnSell_OnClick()
	SendOrder()
End Sub

'============================================================================

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgInfo_OnClick()
	'안드로이드가 아래로 띄우면 잘려서 일괄 파라미터 '1'로 적용
	imgInfo.openToolTip("수수료 및 세금이 제외된 금액입니다.\n체결 후 매매일지 화면에서 수수료 및 세금을 확인할 수 있어요.",300,95,1)
End Sub

