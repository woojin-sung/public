<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="90150" scrname="클라우드 유의사항 팝업" version="2" writer="성우진" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="ImgClose" autosize="1" imgpath="icon_close" ly_vert="340,20,22,22,1" />
		<LABEL name="labTitle" fgcolor="334:034034034" fontsize="4" fontstyle="01" caption="클라우드인증서 안내" halign="1" ly_vert="0,0,375,60,1" />
		<CONTAINER name="cont0" vscroll="1" ly_vert="0,55,375,592,1" scroll_ly_vert="0,55,375,592,1" >
			<CONTROL_INFO>
				<LABEL name="Label1" fgcolor="334:034034034" fontsize="1" fontstyle="01" caption="이용 안내" ly_vert="10,200,349,24,1" />
				<LABEL name="Label0" fgcolor="334:034034034" fontsize="1" fontstyle="01" caption="클라우드인증서란?" ly_vert="10,7,349,24,1" />
				<TABLE name="Table1" insidelinecolor="102:255255255" colcount="3" rowcount="8" outline="0000" designorder="1" ly_vert="13,229,364,160,1" >
					<COL_INFO ly_vert_width="66,66,232" />
					<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,2,0" fgcolor="334:034034034" halign="0" line="0,0" caption="· 개인 고객만 발급 가능합니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,1,2,1" fgcolor="334:034034034" halign="0" line="0,0" caption="· 인증서의 유효기간은 등록 후 1년이며, 만료일 32일" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,2,2,2" fgcolor="334:034034034" halign="0" line="0,0" caption="   전부터 갱신 가능합니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,3,2,3" fgcolor="334:034034034" halign="0" line="0,0" caption="· 타인의 이용이 의심되었을 경우, 즉시 서비스를 해지" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,4,2,4" fgcolor="334:034034034" halign="0" line="0,0" caption="   처리 하시기 바랍니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,5,2,5" fgcolor="334:034034034" halign="0" line="0,0" caption="· 네트워크 장애, 천재지변 등 인증 서비스의 장애가" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,6,2,6" fgcolor="334:034034034" halign="0" line="0,0" caption="   발생할 경우, 다른 인증 방식을 이용한 인증을 진행" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,7,2,7" fgcolor="334:034034034" halign="0" line="0,0" caption="   하셔야 합니다." fontsize="-1" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table0" insidelinecolor="102:255255255" colcount="3" rowcount="7" outline="0000" designorder="1" ly_vert="10,37,357,140,1" >
					<COL_INFO ly_vert_width="66,66,225" />
					<ROW_INFO ly_vert_height="20,20,20,20,20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,2,0" fgcolor="334:034034034" halign="0" line="0,0" caption="공동인증서를 저장매체(PC, 스마트폰 등)에 보관하지" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,1,2,1" fgcolor="334:034034034" halign="0" line="0,0" caption="않고 코스콤 클라우드 계정에서 발급 및 보관하고," fontsize="-1" impidxs="" />
						<CELL cell_ly="0,2,2,2" fgcolor="334:034034034" halign="0" line="0,0" caption="인증서 이동/복사 없이 인증서 기능을 이용할 수 있는" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,3,2,3" halign="0" line="0,0" caption="보다 진화된 방식의 공동인증서를 의미합니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,4,2,4" halign="0" line="0,0" caption="기존 공동인증서와 클라우드인증서는 동일한 인증서" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,5,2,5" halign="0" line="0,0" caption="입니다. '기존 공동인증서'에 클라우드 보관 기능이" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,6,2,6" halign="0" line="0,0" caption="가미된 인증서가 '클라우드인증서' 입니다." fontsize="-1" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="Label2" fgcolor="334:034034034" fontsize="1" fontstyle="01" caption="이용 방법" ly_vert="10,413,349,24,1" />
				<TABLE name="Table2" insidelinecolor="102:255255255" colcount="3" rowcount="9" outline="0000" designorder="1" ly_vert="18,462,364,174,1" >
					<COL_INFO ly_vert_width="66,66,232" />
					<ROW_INFO ly_vert_height="25,20,20,20,4,25,20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,2,0" fgcolor="334:034034034" halign="0" line="0,0" caption="· 기존 공동인증서를 클라우드에 올리기" fontsize="-1" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,1,2,1" fgcolor="334:034034034" halign="0" line="0,0" caption="   클라우드인증서비스 화면에서 기존 공동인증서" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,2,2,2" fgcolor="334:034034034" halign="0" line="0,0" caption="   목록을 선택하여, 클라우드에 올리는 과정을 거치면" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,3,2,3" fgcolor="334:034034034" halign="0" line="0,0" caption="   공동인증서가 생성됩니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" impidxs="" />
						<CELL cell_ly="1,4,1,4" line="0,0" impidxs="" />
						<CELL cell_ly="2,4,2,4" line="0,0" impidxs="" />
						<CELL cell_ly="0,5,2,5" fgcolor="334:034034034" halign="0" line="0,0" caption="· 클라우드 공동인증서 신규 발급" fontsize="-1" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,6,2,6" fgcolor="334:034034034" halign="0" line="0,0" caption="   공동인증서의 신규 발급이 필요한 경우, '클라우드" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,7,2,7" fgcolor="334:034034034" halign="0" line="0,0" caption="   인증서 발급/재발급' 메뉴를 통해 클라우드인증서를" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,8,2,8" fgcolor="334:034034034" halign="0" line="0,0" caption="   신규로 발급받을 수 있습니다." fontsize="-1" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="Label3" fgcolor="334:034034034" fontsize="-1" fontstyle="01" caption="□ 클라우드인증서 만드는 방법" ly_vert="10,440,349,24,1" />
				<LABEL name="Label4" fgcolor="334:034034034" fontsize="-2" fontstyle="01" caption="□ 클라우드인증서를 기존 공동인증서처럼 사용하는 방법" ly_vert="10,642,349,24,1" />
				<TABLE name="Table3" insidelinecolor="102:255255255" colcount="3" rowcount="5" outline="0000" designorder="1" ly_vert="18,666,364,100,1" >
					<COL_INFO ly_vert_width="66,66,232" />
					<ROW_INFO ly_vert_height="20,20,20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,2,0" fgcolor="334:034034034" halign="0" line="0,0" caption="   클라우드인증서 '인증서 내려받기'를 통해 기존" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,1,2,1" fgcolor="334:034034034" halign="0" line="0,0" caption="   공동인증서처럼 저장매체(PC,스마트폰 등)에 저장" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,2,2,2" fgcolor="334:034034034" halign="0" line="0,0" caption="   한 후 인증서 사용이 가능합니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,3,2,3" fgcolor="334:034034034" halign="0" line="0,0" caption="<![CDATA[   (클라우드인증서> 클라우드인증서 관리> 인증서]]>" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,4,2,4" halign="0" line="0,0" caption="    내려받기)" fontsize="-1" impidxs="" />
					</CELL_INFO>
				</TABLE>
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="477" _ulen="477" >
