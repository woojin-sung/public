Sub btnCnl_OnClick()
	Dim szCLS
	
	Check_InputData(0)
End Sub

'============================================================================
' edtOrgNo_OnEditComplete
'============================================================================
Sub edtOrgNo_OnEditComplete()
	Form.SetSharedData("C_ORG", edtOrgNo.caption)
End Sub

'============================================================================
' edtQty_OnEditComplete 
'============================================================================
Sub edtQty_OnEditComplete()
	Form.SetSharedData("C_QTY", edtQty.caption)
End Sub

'============================================================================
' btnMiche_OnClick : 미체결버튼 클릭
'============================================================================
Sub btnMiche_OnClick()
	Form.triggerEvent("#", "12000_CONTRACT_OPEN", "")
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAll_OnChange(sCheckState)
	Form.SetSharedData("C_QCK", sCheckState)
	
	if sCheckState == "1" then
		edtQty.caption = ""
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		edtQty.caption = g_szQty
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

