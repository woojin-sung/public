'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtQty.caption)

	if nLen <> 0 then
		szQty = Left(edtQty.caption, nLen-1)
		edtQty.caption = szQty
	end if
End Sub

'============================================================================
' btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
	edtQty.caption = ""
End Sub

'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
	if CInt(edtQty.caption) > g_nAllQty then
		Form.ShowAlert("알림", "출고 수량이 출고가능 수량보다 큽니다.")
	else
		Form.SendReturnToParent("QTY_POPUP", edtQty.caption)
		Form.CloseForm()
	end if
End Sub

