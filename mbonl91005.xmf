	<SCRIPT_INFO _len="11500" _ulen="9930" >
'============================================================================
' 01.화면명 	: 청탁금지 제공누적금액 현황
' 02.화면설명	: 청탁금지 제공누적금액 현황 화면
' 03.작성	: 2016.09.26
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szId		'사용자 ID
dim g_szcust_no	'고객번호
dim g_szEmpl_no	'직원번호
dim nRow			'반복
dim nClick		'전체 선택 FLAG
dim g_szType		'
dim g_szYN		'
dim nRound		'요청할 개수
dim nReq			'요청완료 개수
dim nTempCnt		'임시값
dim szLinkedData	'로그인화면에서 고객번호 전달
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	
	szLinkedData = Form.GetOpenLinkData( )
	
	'Form.ShowAlert("AAA", "링크데이터"&szLinkedData)

	'g_szcust_no = Form.GetSharedData("&CUST_NUM", false)
	
	g_szcust_no = szLinkedData
	
	'Form.ShowAlert("AAA", "고객번호"&g_szcust_no)
	
	Grid0.SetClear()
	
	nRow = 0
	
	IF sUserno <> "" Then
	    DATAMANAGER.SetDataValue(0,  "obcmp_uftr_185r", "InBlock1", "CSNO", 0 , g_szcust_no)
	    DATAMANAGER.RequestTranData("obcmp_uftr_185r")
    End IF
    	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim fullAccount
	Dim emp_tel
	if szTranID == "obcmp_uftr_185r" then
		nCnt = DATAMANAGER.GetDataCount(0, "obcmp_uftr_185r", "OutBlock1")
		
		for i = nRow to nRow+nCnt-1
		fullAccount = ""
