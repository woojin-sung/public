'============================================================================
' 01. 화 면 명 : 온라인계좌개설_개설완료
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
					
'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	Dim sACNO
	sACNO = Form.GetOpenLinkData()

	if sACNO <> "" or sACNO <> null then
		ContMain.Table0.SetCellString(1, 3, sACNO)
	end if
	
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		ContMain.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ContMain.Image0.setMaintainingRatio("1")
	ContMain.imgBack.setMaintainingRatio("1")
	ContMain.contNoti.imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub BtnNext_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Dim sCode
	sCode = Form.GetSharedData("mbwat61022_PRCD",	true)
	
	if sCode <> null and sCode <> "" then
		Form.OpenPopup("mbwat61022" , sCode , "") '계약(가입)
	end if

	Form.SendReturnToParent("mbonl84040_p3", "ok")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    Form.CloseForm()
End Sub

