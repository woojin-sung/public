Sub Form_OnRefresh()
	
'	DATAMANAGER.RequestTranData( "obrgt_stsb_209r" )
	
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_szList(0) &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub

