'============================================================================
' 01. 화 면 명 : 유상청약신청_신청
' 02. 화면설명 : 유상청약신청_신청
' 03. 작    성 : 2016. 01. 21. 유창재
' 04. 수    정 : 2020. 09. 18. 성주혁 MTS 메모리 보안 v0001
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'입력받은 데이터 구분
Dim g_szPW		'암호화 PW
Dim g_RghtType		'권리유형
Dim g_nSelectIndex	'취소 선택 Index
Dim plain_rm			'메모리평문 적용유무
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SubCancel() : 청약취소 처리 함수
'============================================================================
Function SubCancel()

	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ACNO" , 0 , g_szList(0) )
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ASNO" , 0 , g_szList(1) )
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ACNT_PWD" , 0 , g_szPW )
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "RGHT_TYPE_CODE" , 0 , grd1.GetCellData("bd_cell12", g_nSelectIndex))
	
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ISCD" , 0 , grd1.GetCellData("bd_cell0", g_nSelectIndex) )			'종목코드
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "SBSC_QTY" , 0 , grd1.GetCellData("bd_cell1", g_nSelectIndex) )		'청약수량
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "SBSC_AMT" , 0 , grd1.GetCellData("bd_cell2", g_nSelectIndex) )		'청약금액
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_SBSC_QTY" , 0 , grd1.GetCellData("bd_cell3", g_nSelectIndex) )	'초과청약수량
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_SBSC_AMT" , 0 , grd1.GetCellData("bd_cell4", g_nSelectIndex) )	'초과청약금액
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_ASGM_QTY" , 0 , grd1.GetCellData("bd_cell5", g_nSelectIndex) )	'초과배정수량
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_ASGM_AMT" , 0 , grd1.GetCellData("bd_cell6", g_nSelectIndex) )	'초과배정금액
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ASGM_QTY" , 0 , grd1.GetCellData("bd_cell7", g_nSelectIndex) )		'배정수량
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ASGM_AMT" , 0 , grd1.GetCellData("bd_cell8", g_nSelectIndex) )		'배정금액
	DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "RGHT_STND_DATE" , 0 , grd1.GetCellData("bd_cell9", g_nSelectIndex) )	'권리기준일자
	
	DATAMANAGER.RequestTranData( "obrgt_stsb_201a" )

End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'테스트를 위해 설정해둠
	grd0.SetCellData("bd_cell7", 0, "취소")
	grd0.SetCellFgColor("bd_cell7", 0, "38")
	
	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	if szCellID == "bd_cell7" then
		g_nSelectIndex = lRow			'선택한 행 기억
'		SubCancel()			'Test용
		if g_szList(2) == "" or Form.GetCtlProp( "#edtPW", "caption") == "" then
			Form.ShowAlert( "알림", "비밀번호를 입력하세요.")
			Exit Sub
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
		end if
	end if
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "청약취소" then
		
		g_RghtType = cmb1.cbkeydata
		
		g_szList	 = Split(sParam , "★")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		
		'v0001
		'AS-IS
		'g_szPW = Form.GetEncData(g_szList(2))
		
		'To-Be
		if plain_rm =="1" then '정책적용시 이미 암호화되어서 넘어옴
			g_szPW = g_szList(2)
		else
			g_szPW = Form.GetEncData(g_szList(2))
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_209r", "InBlock1", "ACNO" , 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_209r", "InBlock1", "ASNO" , 0 , g_szList(1) )
		
		'DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_205r", "InBlock1", "RGHT_TYPE_CODE" , 0 , g_RghtType)	
		'DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_205r", "InBlock1", "ACNO" , 0 , g_szList(0) )
		'DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_205r", "InBlock1", "ASNO" , 0 , g_szList(1) )
		'DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_205r", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
		
	end if

	DATAMANAGER.RequestTranData( "obrgt_stsb_209r" )
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 보안매체 처리하기 위한 TR 입력
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szList(0)
		
		
		'v0001
		'AS-IS
		'sACNO_PWD = Form.GetEncData(g_szList(2))
		
		'To-Be
		if plain_rm =="1" then '정책적용시 이미 암호화되어서 넘어옴
			sACNO_PWD = g_szList(2)
		else
			sACNO_PWD = Form.GetEncData(g_szList(2))
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	elseif szTranID == "obrgt_stsb_201a" then
		Form.ShowAlert("알림", "정상처리 되었습니다.")
		DATAMANAGER.RequestTranData( "obrgt_stsb_209r" )
	elseif szTranID == "obrgt_stsb_209r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0, "obrgt_stsb_209r", "OutBlock1") - 1
			if DATAMANAGER.GetDataValue( 0 , "obrgt_stsb_209r", "OutBlock1", "SBSC_CNCL_YN" , i) == "Y" then
				grd0.SetCellData("bd_cell7", i, "취소")
				grd0.SetCellEnable( "bd_cell7", i, false )
			else
				grd0.SetCellData("bd_cell7", i, "취소")
				grd0.SetCellEnable( "bd_cell7", i, true )
			end if
			grd0.SetCellFgColor("bd_cell7", i, "4")
			
		next
	end if	
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'청약취소
			Call SubCancel()
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim subMsg
	

	if szTranID == "obrgt_stsb_201a" then
		subMsg = DATAMANAGER.GetDataMsgSubText( "obrgt_stsb_201a" )
		grd0.SetClear()
		Form.MsgBox("알림", szErrMsg&"\n("&subMsg&")", 0, 6)
	end if
	
	if szTranID == "obrgt_stsb_209r" then
		subMsg = DATAMANAGER.GetDataMsgSubText( "obrgt_stsb_209r" )
		grd0.SetClear()
		Form.MsgBox("알림", szErrMsg&"\n("&subMsg&")", 0, 6)
		
	end if
	
End Sub

