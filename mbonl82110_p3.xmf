'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82110_p3" , "")
End Sub



'============================================================================
Sub Form_OnFormInitBefore()
	imgIcon.setMaintainingRatio("1")

End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	Dim tData
	
	szOpenData = trim(Form.GetOpenLinkData( ))
	if szOpenData ~= "" then
		' szData = g_szAccount.."★"..g_szButtonEmail.."★"..g_szButtonRadio2
		tData = Split(szOpenData, "★" )
		
		'계좌
		if tData[0] == "" then
			lblData1.caption = ""
		else
			Dim szProductCD
			Dim szProductNM
			szProductCD = Form.GetAccountInfo(tData[0], "productcode")
			szProductNM = Form.GetMetaData("상품코드", szProductCD)
			lblData1.caption = f_SetAccountMask(tData[0])
		end if 
		
		
		'담보관련 통보방법
		if tData[1] == "1" then
			lblData2.caption = "SMS, 이메일"
		else
			lblData2.caption = "SMS"
		end if 
		
		'계약서류 통보방법
		if tData[2] == "1" then
			lblData3.caption = "알림톡·문자"
		else
			lblData3.caption = "이메일"
		end if 


	end if
End Sub



'============================================================================
Function f_SetAccountMask(szAccount)
	Dim szReturnData 
	if trim(szAccount) ~= "" then
		if #szAccount == 10 then
			szReturnData = Left(szAccount,4)&"-"&Mid(szAccount,5,4)&"-"&Right(szAccount,2)		
		elseif #szAccount == 8 then
			szReturnData = Left(szAccount,4)&"-"&Right(szAccount,4)
		else
			szReturnData = szAccount
		end if
	end if
	
	return szReturnData
	
End Function


