'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 해외CFD_주문_주문확인
' 02. 화면설명 : 해외CFD_주문_주문확인
' 03. 작    성 : 2021.12
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:매수청산, 3:매도청산, 4:정정, 5:취소, 10:예약신규, 11:예약신규매도, 12:예약취소, 13:예약청산매수, 14:예약청산매도)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	
Dim	g_nOrd_Decimal		' 가격자릿수
Dim g_nOrd_res_Type 		' 예약주문유형
Dim g_nOrd_res_time		' 주문시간유형
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data()
	'팝업 타이틀,본문 변경
	changeLayout(g_nIndex)

	select case g_nIndex
		case "0", "1", "2", "3"
			tblConfirm.SetCellString( 0, 1, g_szOrder_Acc 		)
			tblConfirm.SetCellString( 0, 2, g_szOrder_AccName 	)
			tblConfirm.SetCellString( 1, 1, g_szOrd_ItmCode		)
			tblConfirm.SetCellString( 2, 1, g_szOrd_ItmName 	)
			tblConfirm.SetCellString( 3, 1, g_szOrd_OrdType		)
			tblConfirm.SetCellString( 4, 1, g_nOrd_Qty			)
			sMask = "0,0,,,0,,"..g_nOrd_Decimal..",1,1,2,0"
			tblConfirm.SetCellMaskInfo( 5, 1, sMask )
			tblConfirm.SetCellString( 5, 1, g_nOrd_Price )	
			
		case "4", "5", "12"
			tblConfirm2.SetCellString( 0, 1, g_szOrder_Acc 		)
			tblConfirm2.SetCellString( 0, 2, g_szOrder_AccName 	)
			tblConfirm2.SetCellString( 1, 1, g_szOrd_ItmCode		)
			tblConfirm2.SetCellString( 2, 1, g_szOrd_ItmName 	)
			tblConfirm2.SetCellString( 3, 1, g_szOrd_OrdType		)
			tblConfirm2.SetCellString( 4, 1, g_nOrd_Qty			)
			sMask = "0,0,,,0,,"..g_nOrd_Decimal..",1,1,2,0"
			tblConfirm2.SetCellMaskInfo( 5, 1, sMask )
			tblConfirm2.SetCellString( 5, 1, g_nOrd_Price )	
			If g_nOrd_ChkAll = "1" Then
				tblConfirm2.SetCellString( 6, 1, "잔량전부" )
			End If
			tblConfirm2.SetCellString( 7, 1, g_nOrd_OrdNo )
			
		case "10", "11", "13", "14"
			tblConfirm1.SetCellString( 0, 1, g_szOrder_Acc 		)
			tblConfirm1.SetCellString( 0, 2, g_szOrder_AccName 	)
			tblConfirm1.SetCellString( 1, 1, g_szOrd_ItmCode		)
			tblConfirm1.SetCellString( 2, 1, g_szOrd_ItmName 		)
			tblConfirm1.SetCellString( 3, 1, g_szOrd_OrdType		)
			tblConfirm1.SetCellString( 4, 1, g_nOrd_res_Type		)
			tblConfirm1.SetCellString( 5, 1, g_nOrd_res_time		)
			tblConfirm1.SetCellString( 6, 1, g_nOrd_Qty			)
			sMask = "0,0,,,0,,"..g_nOrd_Decimal..",1,1,2,0"
			tblConfirm1.SetCellMaskInfo( 7, 1, sMask )
			tblConfirm1.SetCellString( 7, 1, g_nOrd_Price )
			
	end select
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")

	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:매수청산, 3:매도청산, 4:정정, 5:취소, 10:예약매수, 11:예약매도, 13:예약취소, 14:예약청산)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
	
	if UBOUND(arrData) > 12 then
		if g_nIndex == "10" or g_nIndex == "11" 
			or g_nIndex == "13" or g_nIndex == "14" then
			
			g_nOrd_res_Type 	= arrData(12) ' 예약주문유형
			
			if arrData(13) == "0" then
				g_nOrd_res_time = "장개시"
			elseif arrData(13) == "1" then
				g_nOrd_res_time = "장마감 10분 전"
			elseif arrData(13) == "2" then
				g_nOrd_res_time = "장마감 30분 전"
			
			elseif arrData(13) == "3" then
				g_nOrd_res_time = "장개시 30분 후"
			end if
		end if
	end if
	
	Set_Data()	
End Sub

'============================================================================
Sub Form_OnFormInit()
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub imgClose1_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
' 팝업 타이틀, 본문 변경
'============================================================================
Sub changeLayout(nIndex)
	Select Case nIndex
		Case "0"
			tblConfirm.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "CFD 신규 매수주문"
			lblCont.caption		= "매수 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_05.9"
			btnConfirm.caption	= "매수"
			tblConfirm.SetCellFgColor(5, 0, 92)
			tblConfirm.SetCellFgColor(5, 1, 92)
		case "1"
			tblConfirm.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "CFD 신규 매도주문"
			lblCont.caption		= "매도 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_06.9"
			btnConfirm.caption	= "매도"
			tblConfirm.SetCellFgColor(5, 0, 91)
			tblConfirm.SetCellFgColor(5, 1, 91)
		case "2"
			tblConfirm.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "CFD 청산 매수주문"
			lblCont.caption		= "매수 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_05.9"
			btnConfirm.caption	= "매수"
			tblConfirm.SetCellFgColor(5, 0, 92)
			tblConfirm.SetCellFgColor(5, 1, 92)
		case "3"
			tblConfirm.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "CFD 청산 매도주문"
			lblCont.caption		= "매도 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_06.9"
			btnConfirm.caption	= "매도"
			tblConfirm.SetCellFgColor(5, 0, 91)
			tblConfirm.SetCellFgColor(5, 1, 91)
		case "4"
			tblConfirm.visible	= false
			tblConfirm2.visible	= true
			
			lblTitle.caption 		= "CFD 정정주문"
			lblCont.caption		= "정정 하시겠습니까?"	
			btnConfirm.btnimage 	= "btn_07.9"
			btnConfirm.caption	= "정정"
			tblConfirm2.SetCellFgColor(5, 0, 93)
			tblConfirm2.SetCellFgColor(5, 1, 93)
		case "5", "12"
			tblConfirm.visible	= false
			tblConfirm2.visible	= true
			
			lblTitle.caption 		= "CFD 취소주문"
			lblCont.caption		= "취소 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_08.9"
			btnConfirm.caption	= "취소"
			tblConfirm2.SetCellFgColor(5, 0, 94)
			tblConfirm2.SetCellFgColor(5, 1, 94)
		case "10"
			tblConfirm.visible	= false
			tblConfirm1.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "(예약)CFD 신규 매수주문"
			lblCont.caption		= "매수 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_05.9"
			btnConfirm.caption	= "매수"
			tblConfirm1.SetCellFgColor(7, 0, 92)
			tblConfirm1.SetCellFgColor(7, 1, 92)
		case "11"
			tblConfirm.visible	= false
			tblConfirm1.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "(예약)CFD 신규 매도주문"
			lblCont.caption		= "매도 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_06.9"
			btnConfirm.caption	= "매도"
			tblConfirm1.SetCellFgColor(7, 0, 91)
			tblConfirm1.SetCellFgColor(7, 1, 91)
		case "13"
			tblConfirm.visible	= false
			tblConfirm1.visible	= true
			tblConfirm2.visible	= false
			
			lblTitle.caption 		= "(예약)CFD 청산 매수주문"
			lblCont.caption		= "매수 하시겠습니까?"	 
			btnConfirm.btnimage 	= "btn_05.9"
			btnConfirm.caption	= "매수"
			tblConfirm1.SetCellFgColor(7, 0, 92)
			tblConfirm1.SetCellFgColor(7, 1, 92)
		case "14"
			tblConfirm.visible	= false
			tblConfirm1.visible	= true
			tblConfirm2.visible	= false
			
