<ROOT>
	<MAP_INFO scrno="41000" scrname="시장종합_배너" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,185,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" bgcolor="320:246247248" transmode="0" ly_vert="0,108,1000,160,1" />
		<LINKFORM name="linkfm0Banner" linkfile="banner_new" bordercolor="039:242242242" ly_vert="1000,0,355,75,1" />
		<LABEL name="Label1" visible="0" fgcolor="144:034034034" fontsize="2" bgcolor="029:255212175" ly_vert="430,12,187,32,0" />
		<LABEL name="Label2" bgcolor="320:246247248" transmode="0" ly_vert="4,70,375,177,1" />
		<FORMTAB name="FormTab0" tabcount="3" tabheadwidth="0" tabheadheight="0" usepg="1" ly_vert="0,15,375,170,1" >
			<PAGE name="page007751" caption="비대면 이벤트 수정2" linkfile="banner_new_2" loadingtype="1" />
			<PAGE name="page002711" caption="비대면 이벤트 수정3" linkfile="banner_new_3" loadingtype="1" />
			<PAGE name="page1111111" caption="비대면 이벤트 수정1" linkfile="banner_new" loadingtype="1" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="792" _ulen="784" >
Dim g_curTab
Dim g_nRandom

g_curTab = 0
'============================================================================
Sub Form_OnFormInit()
	Label1.caption = "meritz Bond365"	'20230502 HSZ
	nLen = Form.getLen(Label1.caption)
	Label1.changeTextAttr(0, nLen, 334, 2, true)
	Label1.changeTextAttr(0, 6, 323, 2, true)
	'난수생성
	g_nRandom = math.random(1, 3)
	Form.triggerEvent("FormTab0."& FormTab0.currenttabpageid, "Forminit", g_nRandom)

	FormTab0.setAutoScroll(true, 4)
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if g_curTab <> nCurrentTab then
		Form.triggerEvent("FormTab0."& FormTab0.currenttabpageid, "TabChange", nCurrentTab.."|"..g_nRandom)
		g_curTab = nCurrentTab
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>