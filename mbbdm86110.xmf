'============================================================================
Sub Form_OnFormInitBefore()
	Image1.setMaintainingRatio("1")
	Image3.setMaintainingRatio("1")
	
	imgArrow0.setMaintainingRatio("1")
	imgArrow1.setMaintainingRatio("1")
	
	ImgBackPress.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	Label11.changeTextAttr(0, 3, 4, 4, true)
	Label11.setHighlight(332, 0, 3)
	
	Label2.setNeighborCtlPos("imgArrow1", "right", 8, "")
	Label4.setNeighborCtlPos("imgArrow0", "right", 8, "")
	
	cmbDept.SetApplyLabel   ("통신사"       , 0, 267, "left", True, 111) 'HWG
	cmbDept.cbtype = "5"
	
	User_SharedData_All_Init()
	
	'부서코드/부서명 조회
	DATAMANAGER.RequestTranData( "obcpp_dept_010r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'부서코드/부서명 조회
	If szTranID = "obcpp_dept_010r" Then
		DATAMANAGER.SetDataValue( 0, "obcpp_dept_010r", "InBlock1", "DEPT_ABWR_NAME"     , 0 ,"%"  )  '전체
		DATAMANAGER.SetDataValue( 0, "obcpp_dept_010r", "InBlock1", "BSBR_SHAP_CLS_CODE" , 0 ,"01" )  '영업점
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'부서코드/부서명 조회
	If szTranID = "obcpp_dept_010r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		If nCnt > 0 Then
			Dim szCode, szName
			For i = 0 To nCnt - 1
				szCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "DPCD" , i )
				szName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "DEPT_ABWR_NAME" , i )
				
				'디지털금융센터는(1065) 제외
				If szCode <> "1065" Then
					cmbDept.cbadddatatext = szCode & "`" & szName
				End If
			Next
			
			'아이폰은 지정해줘야함
			if Form.GetSharedData("&OS_TYPE", false) == "2" then
				cmbDept.currentindex = "-1"
			end if
			
			If DATAMANAGER.IsMoreNextData(szTranID) Then
				DATAMANAGER.RequestNextData(szTranID)
			End If
		End If
	End If
End Sub

'============================================================================
Sub cmbDept_OnEditComplete(iIndex)
	Form.SetSharedData("BDM_MANG_BRCD" , cmbDept.cbkeydata)
	
'	Form.ShowAlert("관리점 선택 완료", "개설상품 선택으로 이동")
	
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		Form.SetTimerEvent2(1, 1, 0.5)
	else
		Form.OpenNextPopup("mbbdm86120", "", "")
	end if
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if CInt(sTimerID) == 1 then
		Form.SetTimerEvent2(1, 0, 0.5)
		Form.OpenNextPopup("mbbdm86120", "", "")
	end if
End Sub

'============================================================================
Sub btnDigital_OnClick()
	Form.SetSharedData("BDM_MANG_BRCD" , "1065")
	
'	Form.ShowAlert("관리점 선택 완료", "개설상품 선택으로 이동")

	Form.OpenNextPopup("mbbdm86120", "", "")
End Sub

'============================================================================
Sub btnOther_OnClick()
	cmbDept.OpenList()
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
'	Form.CloseForm()
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
	Form.OpenNextPopup("mbbdm85100", "", "")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
'	Form.CloseForm()
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
	Form.OpenNextPopup("mbbdm85100", "", "")
End Sub

