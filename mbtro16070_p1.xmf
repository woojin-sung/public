'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")	
		
		szCode = tData(0)
		arrCdoe = split(szCode, "@") 
		
		for i = 0 to #g_tCheck-1
			if instr(szCode, g_tCrCd(i)) > 0 then
				g_tCheck(i) = "1"
			end if
		next
	else
		g_tCheck(0) = "1"
	end if

	'기선택된 코드 표시
	for i = 0 to #g_tCheck - 1
		if g_tCheck(i) = "1" then
			Form.SetCtlProp("contMain.img" & i, "imgpath", "btn_line2_o.9.png")
		else
			Form.SetCtlProp("contMain.img" & i, "imgpath", "btn_line2_n.9.png")
		end if
	next
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbtro16070_p4", g_szCode .. "★" .. g_szCodeName)
End Sub

'============================================================================
Function SetCheckFilter(iPos)
'	'체크된 버튼 라인 색 변경하고
'	for i = 0 to 20
'		'비활성화
'		Form.SetCtlProp("contMain.img" & CStr(i), "imgpath", "btn_line2_n.9.png")
''		Form.SetCtlProp("contMain.lbl" & CStr(i), "fgcolor", "146")
''		Form.SetCtlProp("contMain.lbl" & CStr(i), "fontstyle", "00")
'	
'		if i = iPos then
'			'활성화
'			Form.SetCtlProp("contMain.img" & CStr(i), "imgpath", "btn_line2_o.9.png")
''			Form.SetCtlProp("contMain.lbl" & CStr(i), "fgcolor", "334")
''			Form.SetCtlProp("contMain.lbl" & CStr(i), "fontstyle", "01")			
'		end if
'	next	

	if g_tCheck(iPos) = "1" then
		g_tCheck(iPos) = "0" 
		Form.SetCtlProp("contMain.img" & CStr(iPos), "imgpath", "btn_line2_n.9.png")
		
		isCheck = false
				
		for i = 1 to #g_tCheck-1
			if g_tCheck(i) == "1" then 
				isCheck = true
			end if
		next
		
		if isCheck == false then
			g_tCheck(0) = "1" 
			Form.SetCtlProp("contMain.img0", "imgpath", "btn_line2_o.9.png")
			Exit Function
		end if
			
		
	elseif g_tCheck(iPos) = "0" then
		if iPos == 0 then
			for i = 0 to #g_tCheck-1
				g_tCheck(i) = "0" 
				
				Form.SetCtlProp("contMain.img" & CStr(i), "imgpath", "btn_line2_n.9.png")
			next
			
			g_tCheck(iPos) = "1" 
			Form.SetCtlProp("contMain.img" & CStr(iPos), "imgpath", "btn_line2_o.9.png")
		else
			g_tCheck(0) = "0" 
			Form.SetCtlProp("contMain.img0", "imgpath", "btn_line2_n.9.png")
			
			g_tCheck(iPos) = "1" 
			Form.SetCtlProp("contMain.img" & CStr(iPos), "imgpath", "btn_line2_o.9.png")
			
			isUnCheck = false
			
			for i = 1 to #g_tCheck-1
				if g_tCheck(i) == "0" then 
					isUnCheck = true
				end if
			next
			
			if isUnCheck == false then
				for i = 0 to #g_tCheck-1
					g_tCheck(i) = "0" 
					Form.SetCtlProp("contMain.img" & CStr(i), "imgpath", "btn_line2_n.9.png")
				next
				
				g_tCheck(0) = "1" 
				Form.SetCtlProp("contMain.img0", "imgpath", "btn_line2_o.9.png")
			end if
		end if
	end if
	
	
'	g_szCode = g_tCrCd[iPos]		'거래국가코드
'	g_szCodeName = g_tCrCdNm[iPos]	'거래국가명
'	Form.CloseForm()
End Function

'============================================================================
Sub contMain_lbl0_OnClick()
	SetCheckFilter(0)
End Sub

'============================================================================
