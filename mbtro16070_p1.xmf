'============================================================================
Sub btnOk_OnClick()
	g_szCode = ""
	g_szCodeName = ""
	for i = 0 to #g_tCheck-1 
		if g_tCheck(i) == "1" then
			if g_szCode == "" then
				g_szCode = g_tCrCd[i]		'거래국가코드
				g_szCodeName = g_tCrCdNm[i]	'거래국가명
			else
				g_szCode = g_szCode & "@" & g_tCrCd[i]		'거래국가코드
				g_szCodeName = g_szCodeName & "@" & g_tCrCdNm[i]	'거래국가명
			end if
		end if
	next
	
	Form.CloseForm()
End Sub

