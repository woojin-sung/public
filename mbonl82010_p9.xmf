Sub chkAgree1_OnChange(sCheckState)
	Dim nIdex
	nIdex = 0

	if sCheckState == "1" then
		chkAgree1.chksilence = "0"
	    'Form.OpenPopup( g_szPopupFileName ,  g_tData[nIdex] , "" )
	    Form.openPopupAnimation( g_szPopupFileName ,  g_tData[nIdex] , "", "2" )
	else
		g_tAgreeState[nIdex] = "0"	
		f_AllAgreeCheck()
	end if
End Sub

