	<SCRIPT_INFO _len="2807" _ulen="2779" >
--===========================================================================
--===========================================================================
Dim szACNO
Dim szASNO
Dim szLDTC

'============================================================================
Sub Form_OnFormInit()
	szACNO = left(acnt1.caption , 8)
	szASNO = right(acnt1.caption, 2)
	szLDTC = Combo0.cbkeydata
	
	'Form.ShowAlert(szACNO, szASNO)
	btnSearch_OnClick()
End Sub

'============================================================================
Sub acnt1_ChangeAccount()
	szACNO = left(acnt1.caption , 8)
	szASNO = right(acnt1.caption, 2)
	
	btnSearch_OnClick()
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "oblon_basc_805r" )
	DATAMANAGER.RequestTranData( "oblon_mntn_925r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "oblon_basc_805r" then
	
		DATAMANAGER.SetDataValue(0, "oblon_basc_805r", "InBlock1", "ACNO" , 0, szACNO)
		DATAMANAGER.SetDataValue(0, "oblon_basc_805r", "InBlock1", "ASNO" , 0, szASNO)
		
	elseif szTranID = "oblon_mntn_925r" then
	
		DATAMANAGER.SetDataValue(0, "oblon_mntn_925r", "InBlock1", "ACNO" , 0, szACNO)
		DATAMANAGER.SetDataValue(0, "oblon_mntn_925r", "InBlock1", "ASNO" , 0, szASNO)
		DATAMANAGER.SetDataValue(0, "oblon_mntn_925r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0, szLDTC)
		
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	szLDTC = Combo0.cbkeydata
	
	btnSearch_OnClick()
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_mntn_925r" then
		for nRowIdx = 0 to Grid0.rowcount - 1
			tmp_ldtc = Grid0.GetCellData("bd_cell11", nRowIdx) 'bd_cell2
			typname = Form.GetMetaData("대출상세유형코드", tmp_ldtc)
			
			Grid0.SetCellData("bd_cell2", nRowIdx, typname)
		next
	end if
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	dim loan_dtl_type_code, loan_date, iscd, loan_dtl_type_code, stnd_date
	
	loan_dtl_type_code = Grid0.GetCellData("bd_cell11", lRow)
	loan_date 		 = Grid0.GetCellData("bd_cell0", lRow)
	iscd 			 = Grid0.GetCellData("bd_cell1", lRow)
	stnd_date 		 = Calendar0.caption
	loan_srno 		 = Grid0.GetCellData("bd_cell10", lRow)
	
	sOpenData = szACNO & "★" & szASNO & "" & "★" & loan_dtl_type_code & "★" & loan_date & "★" & iscd & "★" & loan_srno & "★" & stnd_date
	
	'msgbox sOpenData
	Form.OpenFramePopup("mbonl82030_p1.xmf" , sOpenData , "")
End Sub

