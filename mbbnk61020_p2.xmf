'============================================================================
' ㅇ 증권 잔액조회 : 증권비밀번호 불필요
' ㅇ 은행 잔액조회 : 은행비밀번호 필요
' ㅇ 입금 : 은행비밀번호 필요 & 공동인증 필요
' ㅇ 출금 : 증권비밀번호 필요 & 공동인증 필요
'============================================================================

Dim g_szAccountNumber 
Dim g_szAccountSerialNumber
Dim g_szAccountName
Dim g_szPass
Dim g_szCertUserType
Dim g_sSpinCertYn
Dim g_sBioCertYn
Dim g_szTrMsg

'============================================================================
Sub Form_OnFormInit()

    szData = Form.GetOpenLinkData()
    szList = Split(szData, "★")

    If UBOUND(szList) < 1 Then
        Exit Sub
    End if

    g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
    g_sSpinCertYn = "N"

    g_szAccountNumber = szList(0)
    g_szAccountSerialNumber = szList(1)
    g_szAccountName = szList(2)
    g_szPass = szList(3)

    Table0.SetCellString(1, 1, szList(4) & "/" & szList(5)) '은행명 / 은행계좌번호
    Table0.SetCellString(2, 1, szList(7)) '예금주

    Table1.SetCellString(1, 1, g_szAccountNumber & g_szAccountSerialNumber) '입금계좌(메리츠)
    Table1.SetCellString(2, 1, g_szAccountName) '당사고객명)
    Table1.SetCellString(3, 1, szList(6))'이체금액
    
    If g_szCertUserType == "3" Then '바이오
        g_szTrMsg = "BIO_trType★1★본인 은행개설계좌 이체입금\n★0"
    ElseIf g_szCertUserType == "4" Then '바이오
        g_szTrMsg = "BCHAIN_trType★1★본인 은행개설계좌 이체입금\n★0"
    ElseIf g_szCertUserType == "5" Then '메리츠 사설인증데이터 Set
        g_szTrMsg = "ATON_trType★본인 은행개설계좌 이체입금\n"
    Else
        g_szTrMsg = ""
    End if    

    If g_szCertUserType == "1" Then 
        LinkForm0.linkfile = "mbbnk61010_s7" '간편인증만
    ElseIf g_szCertUserType == "0" Then
        LinkForm0.linkfile = "mbbnk61010_s3" '공동인증서만
    Else
        LinkForm0.linkfile = ""
        LinkForm0.visible = False
    End If

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    
    If sKeyName == "mhetc90060_p5" Then '전자서명인증
        szData = Split(sRet, ";")
        If szData(0) == "ok" or sRet == "ok" Then
            TR_Inquiry()
        End If
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID == "obtsd_asec_024a" Then
    
        Form.MsgBox("알림" , "전송되었습니다.\n이체결과를 확인하세요." , "" , 0)
        Form.SendReturnToParent( "CORNFORM_POPUP" , "OK" )
        Form.CloseForm()
	
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    If szTranID == "obtsd_asec_024a" Then
        Form.MsgBox( "알림", szErrMsg, "", 0 )
    End If
    
End Sub

'============================================================================
Sub BtnCnfr_OnClick()

	Form.triggerEvent("LinkForm0", "이체확인" , "")
	
	If g_szCertUserType == "3" Or g_szCertUserType == "4" Or g_szCertUserType == "5" Then '메리츠 사설인증 or 바이오인증
	    Form.OpenFramePopup("mhetc90060_p5" , g_szTrMsg , "")
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

    If sEventName == "인증서" Then
        If sParam == "Success" Then
            TR_Inquiry()  
        End If
    ElseIf sEventName == "간편인증" Then
        If sParam == "Success" Then
            BtnCnfr_OnClick()
        End If
    ElseIf sEventName == "바이오인증" Or sEventName == "공동인증" Then
        If sParam == "Success" Then
            TR_Inquiry()		
        End If
    End If
    
End Sub

'============================================================================
Sub TR_Inquiry()

	DATAMANAGER.SetDataValue(0 , "obtsd_asec_024a" , "InBlock1" , "SCRT_ACNO" , 0 , g_szAccountNumber        ) '계좌번호
	DATAMANAGER.SetDataValue(0 , "obtsd_asec_024a" , "InBlock1" , "ASNO"      , 0 , g_szAccountSerialNumber  ) '계좌번호	
	DATAMANAGER.SetDataValue(0 , "obtsd_asec_024a" , "InBlock1" , "PWD"       , 0 , g_szPass                 ) '비밀번호
	DATAMANAGER.SetDataValue(0 , "obtsd_asec_024a" , "InBlock1" , "TACT_AMT"  , 0 , Table1.GetCellString(3,1)) '이체금액

	DATAMANAGER.RequestTranData("obtsd_asec_024a")

End Sub

'============================================================================
Sub BtnCancel_OnClick()
	Form.SendReturnToParent( "CORNFORM_POPUP" , "CANCEL" )
	Form.CloseForm()	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "CORNFORM_POPUP" , "CANCEL" )
	Form.CloseForm()
End Sub

