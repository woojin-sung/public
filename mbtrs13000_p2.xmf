'============================================================================
' 화 면 명 : 주식주문_잔고팝업
' 화면설명 : 주식주문 매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.01.26 ~ 2016. 02. 05      ssang
'          : 2018.09.14 : 이학록 v001. 현재가 색상 추가
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szTab, g_szSelect
g_szAcnt, g_szAcntCd, g_szGbn, g_szTab, g_szSelect = "", "", "", "", "", ""

Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer
Dim g_bCloseFlag	'20230831 htw 종목 미선택 팝업 종료인 경우판단 변수 추가
g_bCloseFlag = false	'20230831 htw 종목 미선택 팝업 종료인 경우판단 변수 추가
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	DATAMANAGER.RequestTranData("obtrc_brng_003r")
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_Buffer = 0
	g_Toggle1      = 0
	g_Toggle2      = 0
	
	SetGridHeader(g_Toggle1, g_Toggle2)
	
	Form.SetScreenName("CFD차입잔고")
	
	szOpen = Form.GetOpenLinkData()
	
	Request_Data()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if
	
	
	
	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
		g_szGbn    = tData(3)
		
		Request_Data()
	end if
	
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtrc_brng_003r" Then
		Dim szType
		
		DATAMANAGER.ClearInputData(0, "obtrc_brng_003r")
		
		DATAMANAGER.SetDataValue(0, "obtrc_brng_003r", "InBlock1", "ACNO" 			, 0, g_szAcnt )		
		DATAMANAGER.SetDataValue(0, "obtrc_brng_003r", "InBlock1", "ASNO" 			, 0, g_szAcntCd )
		
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

	if lRow > -1 then
		szCd       = grdList.GetCellData("bd_Cd", lRow)
		szQty      = grdList.GetCellData("bd_New", lRow)
		
'		if(left(szCd,1) == "J" and len(szCd) == 9) or left(szCd,1) == "Q" or left(szCd,1) == "F" then
			szMk = Form.GetItemCodeInfo(szCd, "market")
'		else
'			szCutCd = Mid(szCd,2,len(szCd))
'			szMk = Form.GetItemCodeInfo(szCutCd, "market")
'		end i
		
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
			'  전달내용/탭위치/종목코드/수량
			szData = "차입" & "★" & g_szTab & "★" & szCd & "★" & szQty
			g_szSelect = "1"
			g_bCloseFlag = true	'20230831 htw 종목 미선택 팝업 종료인 경우판단 변수 추가
			Form.SendReturnToParent("13000_BORROW", szData)
			Form.CloseForm()
		else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		end if
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If
	
	Request_Data()
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtrc_brng_003r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub

'============================================================================
Sub grdList_OnHeaderClickUp(lRow, szCellID)
	if g_Buffer = 1 then
		if szCellID = "th_cell0" then
			g_Toggle1 = g_Toggle1 + 1
			g_Toggle2 = 0
			
			if g_Toggle1 > 2 then
				g_Toggle1 = 0
			end if
	
			SetGridHeader(g_Toggle1, g_Toggle2)
			
		end if
	end if
	
	g_Buffer = 1
End Sub
