	<SCRIPT_INFO _len="18443" _ulen="17229" >
'============================================================================
' 01. 화 면 명 : 사고등록/해지_사고등록
' 02. 화면설명 : 사고등록/해지_사고등록
' 03. 작    성 : 2016. 02. 05. 유창재
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2024.01.29 : 전상일 : v0002 : 출금고사고 등록업무 팝업 표시 개선
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'계좌정보
Dim g_szPW		'암호화한 비밀번호
Dim g_PwEnable	'비밀번호값 보유 여부
Dim g_nTranCount	'TR Output Count
Dim g_SelectCount	'사고등록 선택 여부 판단
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nRdoType	'라디오 선택 Index
Dim g_nProCount	'처리해야할 사고 개수
Dim nTrCount
Dim g_plain_rm	'v0001 메모리평문적용여부

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' MultiRegister() : 사고등록 다중 처리 부분
'============================================================================
Function MultiRegister()
	
	nTrCount = nTrCount - 1
	DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "ASNO" , 0 , grd1.GetCellData("bd_cell0", nTrCount ) )
	DATAMANAGER.RequestTranData("obacp_opop_008u")
	
End Function
'============================================================================
' SetRegister() : 사고등록 처리 부분
'============================================================================
Function SetRegister()
	
'	DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock1", "ACNO" , 0 , g_szList(0))
'	DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
'		
'	Select Case g_nRdoType
'		Case 0
'			DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "Y")	'출금고사고등록
'		Case 1
'			DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "Y")	'인감사고
'		Case 2
'			DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "Y")	'IC카드사고
'		Case 3
'			DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "Y")	'종합카드사고
'		Case 4
'			DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "Y")	'통장사고여부
'	End Select
	DATAMANAGER.ClearInputData( 0 , "obacp_opop_008u")
	
	nTrCount = 0
	if g_nRdoType == 5 then
		for i = 0 to g_nTranCount - 1
			if grd0.GetCellData( "bd_cell0" , i) == "1" then
	'			DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "ASNO" , 0 , grd0.GetCellData("bd_cell4", i))
				Dim Temp
				grd1.AddRow()
'				Temp = grd0.GetCellData("bd_cell4", i)
				grd1.SetCellData( "bd_cell0", nTrCount, grd0.GetCellData("bd_cell4", i) )
				nTrCount = nTrCount + 1
	'			DATAMANAGER.RequestTranData("obacp_opop_008u")
			end if
		next
		grd1.rowcount = nTrCount
		MultiRegister()
	else
		DATAMANAGER.RequestTranData("obacp_opop_008u")
	end if
	
'	DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock1", "ACNO" , 0 , g_szList(0))
'	DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock1", "ACNT_PWD" , 0 , g_szPW)

End Function
'============================================================================
' SelectCheck() : 사고등록 선택 여부 판단(통장사고일때)
'============================================================================
Function SelectCheck()
	g_SelectCount = 0
	
	for i = 0 to g_nTranCount - 1
		if grd0.GetCellData("bd_cell0", i) == "1" then
			g_SelectCount = g_SelectCount + 1
		end if
	next
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' btnNotice_OnClick() : 유의사항 팝업
'============================================================================
Sub btnNotice_OnClick()
	Form.OpenPopup("mbonl84020_p1" , "사고등록" , sPosInfo)
End Sub
'============================================================================
' btn0_OnClick() : 공인인증 확인 처리
'============================================================================
Sub btn0_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szList(1) == "" or g_szList(1) == Null or TopPW == "" then		'비밀번호 입력요구창
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Sub
	else
		if g_nRdoType == 5 then
			Call SelectCheck()
			
			if g_SelectCount == 0 then		'상품선택 여부 확인
				Form.MsgBox("알림", "선택된 상품이 없습니다.", 0, 6)
				Exit Sub
			else
'				SetRegister()			'Test용
				Form.MsgBox("알림", "사고등록 하시겠습니까?", 1, 5)
			end if
		elseif g_nRdoType < 5 then
			'v0002 : 출금고사고 등록업무 팝업 표시 개선
			if g_nRdoType == 0 then '출금고사고 등록 시 
				Form.MsgBox("알림", "'출금고해지'는 영업점 방문을 통하여 해지 가능합니다.\n사고등록 하시겠습니까?", 1, 5)
			else
			'			SetRegister()				'Test용
				Form.MsgBox("알림", "사고등록 하시겠습니까?", 1, 5)
			end if

		else
			Form.MsgBox("알림", "선택된 사고가 없습니다.", 0, 6)
		end if

	end if	
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) : 공인인증 확인후 처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'사고등록
			Call SetRegister()
'			Form.ShowAlert("Test", "사고등록ㄱ")
		end if
	end if
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName <> "사고등록" then
		Exit Sub
	end if
	
	g_szList = Split(sParam, "★")
		
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	'v0001 메모리평문적용여부에 따라 암호화/비암호화된 정보로 넘어오므로 연계화면 변경시 확인필수(mbonl84020)
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    g_szPW = g_szList(1)
	else  'MTS메모리평문 미적용상태일때
	    g_szPW = Form.GetEncData(g_szList(1))
	end if
	
	DATAMANAGER.SetDataValue( 0 , "obacp_opop_039r", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obacp_opop_039r", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	
	if UBOUND(g_szList) > 2 then
		Exit Sub
	End if
	
	rdo0.currentindex = 6
	
	rdo0.enableindex = "0,1"
	rdo0.enableindex = "1,0"
	rdo0.enableindex = "2,0"
	rdo0.enableindex = "3,0"
	rdo0.enableindex = "4,0"
	rdo0.enableindex = "5,0"
	
	g_nRdoType = 6
	g_nNextCount = 0
	
	DATAMANAGER.RequestTranData("obacp_opop_039r")
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 사고유무 확인 처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData
	
	if szTranID == "obacp_opop_039r" then
		g_nTranCount = DATAMANAGER.GetDataCount( 0 , "obacp_opop_039r", "OutBlock7")
		for i = 0 to g_nTranCount - 1
			g_nNextCount = g_nNextCount + 1
			
			grd0.SetCellData("bd_cell0", i , 0)
			grd0.SetCellBgColor("bd_cell0", i, "38")
			grd0.SetCellBgColor("bd_cell1", i, "38")
			grd0.SetCellBgColor("bd_cell2", i, "38")
			grd0.SetCellBgColor("bd_cell3", i, "38")
			grd0.SetCellBgColor("bd_cell4", i, "38")
			
	'		grd0.visible = True
			if DATAMANAGER.GetDataValue( 0 , "obacp_opop_039r", "OutBlock7", "ACDN_YN" , i) == "Y" then
				grd0.SetCellEnable( "bd_cell0", i, false)
				grd0.SetCellData("bd_cell3", i, "사고")
			elseif DATAMANAGER.GetDataValue( 0 , "obacp_opop_039r", "OutBlock7", "ACDN_YN" , i) == "N" then
				grd0.SetCellEnable( "bd_cell0", i, true)
				grd0.SetCellData("bd_cell3", i, "정상")
			end if
		next
		
		'출금고
		if DATAMANAGER.GetDataValue(0, "obacp_opop_039r", "OutBlock6", "ACDN_TYPE_NAME" , 0) <> "정상" then
			rdo0.enableindex = "0,0"
		else
			rdo0.enableindex = "0,1"
		end if
		
		'인감
		if DATAMANAGER.GetDataValue(0, "obacp_opop_039r", "OutBlock3", "ACDN_TYPE_NAME" , 0) <> "정상" then
			rdo0.enableindex = "1,0"
		else
			rdo0.enableindex = "1,1"
		end if
		
		'IC카드
		if DATAMANAGER.GetDataValue(0, "obacp_opop_039r", "OutBlock5", "ACDN_TYPE_NAME" , 0) <> "정상" then
			rdo0.enableindex = "2,0"
		else
			rdo0.enableindex = "2,1"
		end if
		
		'은행연계카드
		if DATAMANAGER.GetDataValue(0, "obacp_opop_039r", "OutBlock8", "ACDN_TYPE_NAME" , 0) <> "정상" then
			rdo0.enableindex = "4,0"
		else
			rdo0.enableindex = "4,1"
		end if
		
		'종합카드
		if DATAMANAGER.GetDataValue(0, "obacp_opop_039r", "OutBlock1", "ACDN_TYPE_NAME" , 0) <> "정상" then
			rdo0.enableindex = "3,0"
		else
			rdo0.enableindex = "3,1"
		end if
		
		'통장
		
		if DATAMANAGER.GetDataCount( 0, "obacp_opop_039r", "OutBlock7") == 0 then
			rdo0.enableindex = "5,0"
		else
			rdo0.enableindex = "5,1"
			if rdo0.currentindex == 5 then
				rdo0.visible = True
			end if
		end if
	
		
		
	elseif szTranID == "obacp_opop_008u" then
		Form.ShowAlert( "알림" , "등록이 완료되었습니다.")
		g_nProCount = g_nProCount - 1
		
'		MultiRegister()
		if g_nProCount == 0 or g_nProCount < 0 then
'			Form.ShowAlert( "알림" , "등록이 완료되었습니다.")
			Form.triggerEvent( "#", "Clear", "One")
			Exit Sub
		else
			MultiRegister()
		end if
		
	end if
End Sub
'============================================================================
' Form_OnMsgBoxClose(sKeyName, sRet)
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	if sRet == "ok" then
		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
	end if
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	
	rdo0.currentindex = 5
	
	if szCellID == "bd_cell0" then
		if grd0.GetCellData("bd_cell0", lRow) == "0" then
'			grd0.SetCellData("bd_cell0", lRow, 0)
			grd0.SetCellBgColor("bd_cell0", lRow, "38")
			grd0.SetCellBgColor("bd_cell1", lRow, "38")
			grd0.SetCellBgColor("bd_cell2", lRow, "38")
			grd0.SetCellBgColor("bd_cell3", lRow, "38")
			grd0.SetCellBgColor("bd_cell4", lRow, "38")
			g_nProCount = g_nProCount - 1
		elseif grd0.GetCellData("bd_cell0", lRow) == "1" then
'			grd0.SetCellData("bd_cell0", lRow, 1)
			grd0.SetCellBgColor("bd_cell0", lRow, "44")
			grd0.SetCellBgColor("bd_cell1", lRow, "44")
			grd0.SetCellBgColor("bd_cell2", lRow, "44")
			grd0.SetCellBgColor("bd_cell3", lRow, "44")
			grd0.SetCellBgColor("bd_cell4", lRow, "44")
			g_nProCount = g_nProCount + 1
		end if
	end if
		
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr	
	
	if szTranID == "obacp_opop_008u" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_opop_008u" )
		g_nProCount = g_nProCount - 1
		
'		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", 0, 6)
		if g_nProCount == 0 or g_nProCount < 0 then
			Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", 0, 6)
			Form.triggerEvent( "#", "Clear", "One")
			Exit Sub
		else
			Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", 0, 6)
			MultiRegister()
		end if
'		Form.triggerEvent( "#", "Clear", "One")
	elseif szTranID == "obacp_opop_039r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_opop_039r" )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", 0, 6)
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obacp_opop_008u" then
		DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
		
		Select Case g_nRdoType				'사고등록후 바로 다른 사고등록 할때 InBlock값이 겹치는 현상때문에 다른 InBlokck값 N 설정
			Case 0
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "Y")	'출금고사고등록
				DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_BANK_LNKD_CARD_ACDN_YN" , 0 , "N")
			Case 1
				DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "Y")	'인감사고
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_BANK_LNKD_CARD_ACDN_YN" , 0 , "N")
			Case 2
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "Y")	'IC카드사고
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_BANK_LNKD_CARD_ACDN_YN" , 0 , "N")
			Case 3
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "Y")	'종합카드사고
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_BANK_LNKD_CARD_ACDN_YN" , 0 , "N")
			Case 4
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_BANK_LNKD_CARD_ACDN_YN" , 0 , "Y")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "N")	'IC카드사고
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "N")				
			Case 5
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock3", "UI_BNKB_ACDN_YN" , 0 , "Y")	'통장사고여부
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_DTFW_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0,"obacp_opop_008u", "InBlock2", "UI_RGSL_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_IC_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_CARD_ACDN_YN" , 0 , "N")
				DATAMANAGER.SetDataValue( 0, "obacp_opop_008u", "InBlock2", "UI_BANK_LNKD_CARD_ACDN_YN" , 0 , "N")
		End Select
	
	elseif szTranID == "obacp_opop_039r" then
		DATAMANAGER.SetDataValue( 0 , "obacp_opop_039r", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obacp_opop_039r", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	end if
End Sub
'============================================================================
' rdo0_OnClick(nIndex)
'============================================================================
Sub rdo0_OnClick(nIndex)
	
	g_nRdoType = nIndex
	
	if g_nRdoType <> 5 then		'16-03-23 전요셉과장님께 다시 화면 보이게 수정해달라고 요청받음
		for i = 0 to grd0.rowcount - 1
			grd0.SetCellData( "bd_cell0", i, "0")
			grd0.SetCellBgColor("bd_cell0", i, "38")
			grd0.SetCellBgColor("bd_cell1", i, "38")
			grd0.SetCellBgColor("bd_cell2", i, "38")
			grd0.SetCellBgColor("bd_cell3", i, "38")
			grd0.SetCellBgColor("bd_cell4", i, "38")
		next
'	else
'		grd0.visible = true
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_nProCount = 0
	grd1.SetClear()

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
End Sub

