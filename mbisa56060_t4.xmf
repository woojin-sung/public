'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 : 김은숙
'              : 2020.12.08 : 김유경 : ISA세법개정_계약기간,의무기간  36개월로 변경 v0001
'              : 2022.05.30 : 고승연 : v0003 [T] 금융상품 가입일련번호별 수령처 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array

'[Page1]
'g_szList(0)   : 계좌번호
'g_szList(1)   : 계좌일련번호
'g_szList(2)   : 비밀번호
'g_szList(3)   : 고객번호
'g_szList(4)   : 가입자유형 코드
'g_szList(5)   : 가입자유형 한글명
'g_szList(6)   : 연령
'g_szList(7)   : 동영상시청 날짜
'g_szList(8)   : 동영상시청 시각
'g_szList(9)   : 소득증명발급번호
'g_szList(10)  : 소득확인증명서번호
'g_szList(11)  : 자택주소
'g_szList(12)  : 회사주소
'g_szList(13)  : 연락처
'g_szList(14)  : 이메일주소
'g_szList(15)  : 서류제출방법 코드
'g_szList(16)  : 서류제출방법 한글명
'g_szList(17)  : 최소가입금액
'g_szList(18)  : buffer
'g_szList(19)  : buffer

'[Page2]
'g_szList(20)  : 투자성향 한글명
'g_szList(21)  : 상품(MP) 코드
'g_szList(22)  : 상품(MP) 한글명
'g_szList(23)  : 금융상품가입일련번호
'g_szList(24)  : buffer
'g_szList(25)  : 은행연합회 한도
'g_szList(26)  : ISA계약권유문서 클릭 시각
'g_szList(27)  : 개인종합자산관리계좌(일임형)약관 클릭 시각
'g_szList(28)  : MP설명서 클릭 시각
'g_szList(29)  : 투자성향진단 등급
'g_szList(30)  : MP선택 변경 여부(이전/다음 이동시)
'g_szList(31)  : buffer
'g_szList(32)  : buffer
'g_szList(33)  : buffer
'g_szList(34)  : buffer
'g_szList(35)  : buffer
'g_szList(36)  : buffer
'g_szList(37)  : buffer
'g_szList(38)  : buffer
'g_szList(39)  : buffer

'[Page3]
'g_szList(40)  : 계약금액
'g_szList(41)  : 만기처리방법 코드
'g_szList(42)  : 만기처리방법 한글명
'g_szList(43)  : 증권약정계좌 계좌번호
'g_szList(44)  : 증권약정계좌 일련번호
'g_szList(45)  : 보고서발송처 코드
'g_szList(46)  : 보고서발송처 한글명
'g_szList(47)  : 사전운용통지 코드
'g_szList(48)  : 사전운용통지 한글명
'g_szList(49)  : 계열사종목(운용/제한) 코드
'g_szList(50)  : 계열사종목(운용/제한) 한글명
'g_szList(51)  : 목표수익률
'g_szList(52)  : 손절수익률
'g_szList(53)  : 계약자확인사항 클릭 시각
'g_szList(54)  : 계약서수령방법 코드
'g_szList(55)  : 계약서수령방법 한글명
'g_szList(56)  : buffer
'g_szList(57)  : buffer
'g_szList(58)  : buffer
'g_szList(59)  : buffer


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub SetTableData()
	'의무기간
	Dim sPeriod
	
	If g_szList(4) == "66" then		'일반형
		sPeriod = "36" 'v0001. 의무기간 변경 60 -> 36
	ElseIf g_szList(4) == "67" then	'청년형
		sPeriod = "36"
	ElseIf g_szList(4) == "73" then	'서민형
		sPeriod = "36"
	Else
		sPeriod = "36"	
	End If
	cont0.tbl0.SetCellString( 8, 1, sPeriod)			
	
	cont0.tbl0.SetCellString( 0, 1, g_szList(0) & g_szList(1))		'신청계좌번호
	cont0.tbl0.SetCellString( 1, 1, g_szList(5))					'가입자유형
	cont0.tbl0.SetCellString( 2, 1, g_szList(6))					'연령
	cont0.tbl0.SetCellString( 3, 1, g_szList(20))					'투자성향
	cont0.tbl0.SetCellString( 4, 1, g_szList(22))					'상품명
	cont0.tbl0.SetCellString( 6, 1, g_szList(40))					'계약금액
	cont0.tbl0.SetCellString( 9, 1, g_szList(42))					'만기처리
	cont0.tbl0.SetCellString( 10, 1, g_szList(43) & g_szList(44))	'연계계좌번호
	cont0.tbl0.SetCellString( 11, 1, g_szList(46))				'보고서발송처
	cont0.tbl0.SetCellString( 12, 1, g_szList(55))				'계약서수령방법
	cont0.tbl0.SetCellString( 13, 1, g_szList(48))				'사전운용통지
	cont0.tbl0.SetCellString( 14, 1, g_szList(51))				'목표수익률
	cont0.tbl0.SetCellString( 15, 1, g_szList(52))				'손절수익률
	cont0.tbl0.SetCellString( 16, 1, g_szList(50))				'계열사종목
End Sub

'============================================================================
Function ValidateCheck()
	If cont0.chk0.checkstate <> "1" then
		Form.ShowAlert("알림", "가입자 필수 안내사항을 확인해주세요.")
		return False
	End If
	
	If cont0.chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "가입자 서류제출 확인사항을 확인해주세요.")
		return False
	End If
	
	return True
End Function

'============================================================================
Sub LoadLinkData()
	g_sSendData = Form.GetSharedData("56060_STEP_LINK", True)
	g_szList = Split(g_sSendData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
					
	DATAMANAGER.RequestTranData("obwat_csad_003r")
	Call SetTableData()
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call LoadLinkData()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'STEP1의 계좌번호 변경시 Data Clear
	If sEventName == "CLEAR_DATA" Then	
		cont0.chk0.checkstate = "0"
		cont0.chk1.checkstate = "0"
		cont0.scroll_pos = 0
	End If
	
	'[입력데이터 재로드]
	'다음 버튼 클릭시 SetSharedData한 후, 다음 화면 Form_OnFormInit에서 GetSharedData 하는데,
	'입력내용 유지 위해 폼 변환시 Unload를 하지 않으므로, 
	'이전 화면으로 돌아가 데이터 변경 후 다음 버튼 클릭시, Form_OnFormInit을 타지 않음 
	'-> Trigger로 GetSharedData 재호출
	If sEventName == "RELOAD_DATA" Then
		Call LoadLinkData()
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbisa56060_p9" then
		If sRet == "ok" then
			cont0.chk1.checkstate = "1"
		Else
			cont0.chk1.checkstate = "0"
		End If
	End If
	
	If sKeyName == "mhetc90060_p5" then
		If Left(sRet,2) == "ok" then
			'v0003
			If g_szList(55) == "알림톡/문자" Then  '알림톡/문자
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , cont0.Edit6.Caption)
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , cont0.Edit5.Caption)
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , cont0.Edit0.Caption)
			Else                                                                       '이메일
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , cont0.Edit3.Caption)
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , cont0.Edit4.Caption)
				DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , cont0.Edit1.Caption)
			End If 
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szList(23))
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
			DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "Close" then
		Form.OpenScreen("56050" , "")
	End If
End Sub

'============================================================================
'가입자안내사항
Sub cont0_chk0_OnChange(sCheckState)
	Call cont0_btnDetail0_OnClick()
End Sub

'============================================================================
'가입자안내사항_내용보기
Sub cont0_btnDetail0_OnClick()
	cont0.chk0.checkstate = "1"
	
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/htsdown/PDF/mts_isa_1.pdf", "가입자 안내사항")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.201.184.87/include/resource/htsdown/PDF/mts_isa_1.pdf", "가입자 안내사항")	'테스트계주소
	end if	
End Sub

'============================================================================
'가입자 서류제출 확인사항_내용보기
Sub cont0_btnDetail1_OnClick()
	Form.OpenFramePopup( "mbisa56060_p9" , g_szList(16) , "")
End Sub

'============================================================================
'가입자 서류제출 확인사항
Sub cont0_chk1_OnChange(sCheckState)
	cont0_btnDetail1_OnClick()
End Sub

'============================================================================
Sub cont0_btnCancel_OnClick()
	Form.triggerEvent("#", "OPEN_PREV", "2")
End Sub

'============================================================================
'가입신청 버튼
Sub cont0_btnOK_OnClick()
	If ValidateCheck() == False then
		Exit Sub
	End If
	
	Form.OpenFramePopup( "mhetc90060_p5" , "" , "")	'공인인증서 비밀번호 입력
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_csad_003r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szList(21))	'랩상품코드
	End If
	
	'v0003
	If szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))		'계좌번호
	End If
	
