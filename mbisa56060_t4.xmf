		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "JOIN_TYPE_CODE"              , 0 , g_szList(4))				'가입자구분
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "LNKD_ACNO"                   , 0 , g_szList(43))			'약정계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "LNKD_ASNO"                   , 0 , g_szList(44))			'약정계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PIC_WAT_YN"                  , 0 , "Y")					'동영상시청여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PIC_WAT_DATE"                , 0 , g_szList(7))				'동영상시청일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PIC_WAT_TIME"                , 0 , g_szList(8))				'동영상시청시각
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "KEYN_HOUR"                   , 0 , g_szList(8))				'키인시간(동영상시청시각)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_PRCD"                     , 0 , g_szList(21))			'상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ATMT_CANC_YN"                , 0 , g_szList(41))			'만기처리
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "SNML_INAG_TYPE_CODE"         , 0 , g_szList(45))			'보고서발송처
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 , g_szList(47))			'사전운용통지발송처
		
		If g_szList(51) == "" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_GOAL_ERT"             , 0 , "0.00")					'목표수익률	
		Else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_GOAL_ERT"             , 0 , CDbl(g_szList(51))/100)	'목표수익률
