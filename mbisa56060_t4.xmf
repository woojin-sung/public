'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_csad_003r" then
		Dim sRiskCode, sRiskText
		
		sRiskCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WA_PROD_RISK_CLCD" , 0)	
'		Select Case sRiskCode
'			Case "01"
'				sRiskText = "초고위험"
'			Case "02"
'				sRiskText = "고위험"
'			Case "03"
'				sRiskText = "중위험"
'			Case "04"
'				sRiskText = "저위험"
'			Case "05"
'				sRiskText = "초저위험"
'		End Select
		
		sRiskText = Form.GetMetaData("KYC상품등급코드", sRiskCode)
		cont0.tbl0.SetCellString( 5, 1, sRiskText)				'위험등급	
					
		'v0003
		DATAMANAGER.RequestTranData("obcsb_acif_140r")
	End If
	
	'v0003
	Dim iCnt, iCnt1
	If szTranID == "obcsb_acif_140r" then
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
				    cont0.Edit1.Caption = strAddr
				    cont0.Edit3.Caption = strInagTypeCode2
				    cont0.Edit4.Caption = strInagSrno2
			    End If
			Next 	
			
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    cont0.Edit0.Caption = strCustTelno
				    cont0.Edit6.Caption = strInagTypeCode3
				    cont0.Edit5.Caption = strInagSrno3
			    End If
			Next 
		End If 
	End If
	
	If szTranID == "obcsb_acad_122a" then
		DATAMANAGER.RequestTranData("obwat_ctad_038a")
	End IF
	
	If szTranID == "obwat_ctad_038a" then
		Form.MsgBox("알림" , "ISA 가입신청이 완료되었습니다. 가입진행상태조회 화면으로 이동합니다.", "Close", 6)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

