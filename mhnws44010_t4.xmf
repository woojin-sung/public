	<SCRIPT_INFO _len="10043" _ulen="9777" >
'============================================================================
' 01. 화 면 명 : 시황브리핑_유가/반도체
' 02. 화면설명 : 시황브리핑_유가/반도체
' 03. 작    성 : 2016. 01. 28. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tName	'테이블 헤더 목록
Dim g_tMaktCode, g_tCode	'유가/반도체 지수 코드
Dim g_RadioType	'Radio 선택상태 Index

g_tName = {"WTI선물","두바이현물","필라델피아 반도체"}
g_tMaktCode = {"FN","FN","N"}
g_tCode = {"NYM@CL","SPT@DU","USI@SOXX"} '20200612 HWG : WTI선물 종목코드 오류수정 (WTI현물 -> WTI선물)

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Function TableClear() : Table Clear
'============================================================================
Function TableClear()

	tbl0.GetCellString( 0, 0)
	tbl0.GetCellString( 0, 1)
	tbl0.GetCellString( 0, 2)
	tbl0.GetCellString( 0, 3)
	tbl0.GetCellString( 0, 4)
	tbl0.GetCellString( 1, 0)
	tbl0.GetCellString( 1, 1)
	tbl0.GetCellString( 1, 2)
	tbl0.GetCellString( 1, 3)
	tbl0.GetCellString( 1, 4)
	tbl0.GetCellString( 2, 0)
	tbl0.GetCellString( 2, 1)
	tbl0.GetCellString( 2, 2)
	tbl0.GetCellString( 2, 3)
	tbl0.GetCellString( 2, 4)

End Function
'============================================================================
' SetRealTR(szType) : 실시간 TR 연결
'============================================================================
Function SetRealTR(szType)

	Select Case szType
		Case g_tCode(0)
			if DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
				tbl0.SetCellString( 0 , 1 , -DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			else
				tbl0.SetCellString( 0 , 1 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			end if
			tbl0.SetCellString( 0 , 2 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
			tbl0.SetCellString( 0 , 3 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
			tbl0.SetCellString( 0 , 4 , RIGHT(DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE" , 0) , 4) )
		Case g_tCode(1)
			if DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
				tbl0.SetCellString( 1 , 1 , -DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			else
				tbl0.SetCellString( 1 , 1 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			end if
			tbl0.SetCellString( 1 , 2 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
			tbl0.SetCellString( 1 , 3 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
			tbl0.SetCellString( 1 , 4 , RIGHT(DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE" , 0) , 4) )
		Case g_tCode(2)
			if DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0) == "5" then
				tbl0.SetCellString( 2 , 1 , -DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			else
				tbl0.SetCellString( 2 , 1 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0))
			end if
			tbl0.SetCellString( 2 , 2 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN" , 0))
			tbl0.SetCellString( 2 , 3 , DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_PRDY_VRSS2" , 0))
			tbl0.SetCellString( 2 , 4 , RIGHT(DATAMANAGER.GetDataValue( 1 , "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE" , 0) , 4) )
	End Select

End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_RadioType = 0
	
	TableClear()
	
	for i = 0 to 2
		tbl0.SetCellString( i, 0 , g_tName(i) )
	
		DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , g_tMaktCode(i) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tCode(i) )
	next
	
	DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "PE")
	DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1")
	
	DATAMANAGER.ClearOutputData( 0 , "ohhts_news_008r" )
	
	DATAMANAGER.RequestTranData( "ohhts_1682_001r" )
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_1682_001r" then
		for i = 0 to 2
			if DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i) == "5" then
				tbl0.SetCellString( i , 1 , -DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
			else
				tbl0.SetCellString( i , 1 , DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" , i))
			end if
			tbl0.SetCellString( i , 2 , DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , i))
			tbl0.SetCellString( i , 3 , DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , i))
			tbl0.SetCellString( i , 4 , RIGHT(DATAMANAGER.GetDataValue( 0 , "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE" , i) , 4) )
		next
		
		'실시간 TR Input
		l = 0
		for j = 0 to 2
			for k = 0 to 3
				DATAMANAGER.SetDataValue( 1 , "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB" , l , g_tCode(j) )
				l = l + 1
			next
		next
		
	elseif szTranID == "ohhts_news_008r" then
		Dim szText
		Dim szTemp
		
		szText = ""
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_news_008r", "OutBlock1") - 1
			szTemp = DATAMANAGER.GetDataValue( 0, "ohhts_news_008r", "OutBlock1", "FID_NEWS_CNTT" , i)
			szText = szText & szTemp
		next
			web0.loaddata = "<html><body>"&szText&"</body></html>"
	end if
	
	DATAMANAGER.RequestTranData( "ohhts_nfut_cntg" )
	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	Dim szData
	
	if g_RadioType == 0 then
		szData = "PE" & "☆" & "2" & "☆" &"유가"
	elseif g_RadioType == 1 then
		szData = "PX" & "☆" & "2" & "☆" &"필라델피아-반도체"
	elseif g_RadioType == 2 then
		szData = "DX" & "☆" & "2" & "☆" &"대만-반도체"
	end if
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
	
End Sub
'============================================================================
' btn1_OnClick()
'============================================================================
Sub btn1_OnClick()
	Dim szData
	
	if g_RadioType == 0 then
		szData = "PE" & "☆" & "3" & "☆" &"유가"
	elseif g_RadioType == 1 then
		szData = "PX" & "☆" & "3" & "☆" &"필라델피아-반도체"
	elseif g_RadioType == 2 then
		szData = "DX" & "☆" & "3" & "☆" &"대만-반도체"
	end if
	
	Form.OpenFramePopup( "mhnws44010_p1.xmf" , szData , sPosInfo)
	
End Sub
'============================================================================
' rdo0_OnClick(nIndex)
'============================================================================
Sub rdo0_OnClick(nIndex)
	
	g_RadioType = nIndex
	
	Select Case g_RadioType
		Case 0
			DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "PE")
			DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1")
		Case 1
			DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "PX")
			DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1")
		Case 2
			DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , "DX")
			DATAMANAGER.SetDataValue( 0 , "ohhts_news_008r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "1")
	End Select
	
	DATAMANAGER.RequestTranData( "ohhts_news_008r" )
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveRealComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szDiv
	
	if szTranID == "ohhts_nfut_cntg" then
		szDiv = DATAMANAGER.GetDataValue( 1 , "ohhts_ovrs_nmix", "OutBlock1", "FIDR_SYMB" , 0)
		
		Call SetRealTR(szDiv)
	end if
	
End Sub
'============================================================================
' tbl0_OnClick(lRow , lColumn)
'============================================================================
Sub tbl0_OnClick(lRow , lColumn)
	Dim szData
	
	szData = grd0.GetCellData("bd_cell0", lRow) & "★" & grd0.GetCellData("bd_cell1", lRow) & "★" & grd0.GetCellData("bd_cell2", lRow)
	Form.OpenFramePopup("mhidx42040_p1.xmf" , szData , sPosInfo)
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	Form_OnFormInit()
	
End Sub

	</SCRIPT_INFO>
