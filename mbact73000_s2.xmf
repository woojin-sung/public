Dim g_szPhone2
Dim g_szPhone3

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	g_szTheme = Form.GetEnvData("common.theme")
	
	'다음버튼 비활성화
	Button0.enable = False
	
	Combo0.SetApplyLabel("종합계좌번호" 	  ,0 , 267 , "left", true , 111)
	Edit0.SetApplyLabel ("종합계좌 비밀번호" ,1 , 267 , "left", true)
	
	g_szRCNO_PIP = Form.GetSharedData("BDM_RCNO_PIP", false)
	g_szProcCode = Form.GetSharedData("KAKAO_PROS_CODE", false)
	g_szPhone1 = Form.GetSharedData("BDM_HP1", false)
	g_szPhone2 = Form.GetSharedData("BDM_HP2", false)
	g_szPhone3 = Form.GetSharedData("BDM_HP3", false)	
	
'g_szRCNO_PIP="00134ED31DD1B3AC855867433F16B13150A7"	
	
    '로그인여부
'    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )

    '비로그인상태에서만 비대면화면 권한부여
'    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
'        Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
'    End If	
		
	'카카오뱅크 후속절차 대상내역 조회
	DATAMANAGER.RequestTranData( "obaci_acct_300r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "MOVE_IDREG" Then
		Form.SetSharedData("&SCREEN_AUTH" , "")
		Form.OpenFramePopup("mhetc90020_p8" , "" , "")
		
	ElseIf sKeyName == "MOVE_LOGIN" Then
		Form.SetSharedData("&SCREEN_AUTH" , "")
		Form.OpenNextPopup("mhetc90021", "", "")
		
	ElseIf sKeyName == "MOVE_HOME" Then
	     Form.SetSharedData("&SCREEN_AUTH" , "")
		Form.OpenNextPopup("mhetc90022" , "" , "")
		
	ElseIf sKeyName == "Exit" And sRet == "ok" Then
		'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
		
		Form.OpenNextPopup("mbact73000", "", "")
		
	ElseIf sKeyName == "PWD_RESET" Then
		If sRet == "ok" Then
			'Form.ShowAlert("", "재설정")
			'계좌비밀번호변경 화면으로 이동
			'Form.OpenNextPopup("mbbdm85200" , "" , "")	
			'Form.OpenNextPopup("mbbdm85290" , "" , "")	
			
			'개설하러가기 클릭
			dim sloginType
			sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
			
			if Cint(sloginType) > 1 then
				sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
				Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
			else
				Form.SetSharedData("&SCREEN_AUTH" , "99")
				
				Form.SetSharedData("BDM_NMETBSWRGB" , "002") '계좌비밀번호 설정
				'Form.OpenScreen("85290" , "")
				Form.OpenNextPopup("mbbdm85200" , "" , "")
			end if				
			
'		Else
'			'Form.ShowAlert("", "취소")
'			'취소시 진입화면으로 이동.
'			Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
'			
'			Form.CloseForm()			
		End If
	elseif sKeyName == "LOGOUT_MSG" then	'로그아웃 후
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			
			'Form.OpenScreen("85290" , "")
			Form.SetSharedData("BDM_NMETBSWRGB" , "002") '계좌비밀번호 설정
			Form.OpenNextPopup("mbbdm85200" , "" , "")
		end if	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    '로그인성 업무는 로그인한 ID로 처리, 비대면성 업무는 본인인증한 휴대폰정보로 처리(2021.04.22)
    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
        strUserID = Trim(g_szPhone1&g_szPhone2&g_szPhone3)
        Form.SetSharedData("&BDM_HEADER", strUserID)
    End If
    
	'카카오뱅크 후속절차 대상내역 조회
	If szTranID == "obaci_acct_300r" Then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false)

		'"3"의 경우에는 RCNO_PIP 값을 들고있지 않으므로 고객 아이디로 조회
		If g_szProcCode == "3" Or g_szProcCode == 3 Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID" , 0 , szUserID)
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , g_szRCNO_PIP)
		End If
	
	'계좌 비밀번호 검증
	ElseIf szTranID = "obacp_opop_066r" Then
		'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		
		if plain_rm == "1" then
			szStr = Edit0.caption 'MTS 메모리평문 적용상태일때
		else
			szStr = Edit0.encdata	'MTS메모리평문 미적용상태일때
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Combo0.cbkeydata )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szStr    )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'카카오뱅크 후속절차 대상내역 조회
	If szTranID == "obaci_acct_300r" Then
		Dim szTrgtYn, szIdExstYn
		szTrgtYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "TRGT_YN" , 0)
		szIdExstYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ELFN_ID_EXST_YN" , 0)
		
'		Form.ShowAlert(szTrgtYn, szIdExstYn)
		
		If szTrgtYn == "Y" Then
			If DATAMANAGER.IsMoreNextData(szTranID) Then
				DATAMANAGER.RequestNextData(szTranID)
				Exit Sub
			End If
			
			If CInt(Grid0.rowcount) > 0 Then
				Dim nCnt, szAcnt
				
				'콤보에 대상 종합계좌 추가
				nCnt = 0
				For i = 0 to CInt(Grid0.rowcount) - 1 
					szAcnt = Grid0.GetCellData("bd_cell0", i)
					Combo0.cbadddatatext = szAcnt & "`" & Left(szAcnt, 4) & "-" & Right(szAcnt, 4)
					nCnt = nCnt + 1
				Next
				
				'대상 계좌가 하나라면 바로 세팅, 아니면 선택하게 유도
				If nCnt == 1 Then					
					Combo0.currentindex = 0					
					'Combo0_OnEditComplete(0)
				Else
					Combo0.caption = "계좌번호를 선택하세요."
					Combo0.openList()
				End If
			Else
				Combo0.caption = "선택가능한 종합계좌가 없습니다."
			End If
			
		ElseIf szTrgtYn == "N" Then
			If szIdExstYn == "Y" Then
				Form.MsgBox("알림", "이용 등록이 이미 완료되었습니다.\n로그인 후 이용해 주세요.", "MOVE_LOGIN", 0)
			Else
				Form.MsgBox("알림", "이용 등록이 이미 완료되었습니다.\nID등록 후 이용해 주세요.", "MOVE_IDREG", 0)
			End If
			
		Else
			Form.MsgBox("알림", "이용 등록 대상 고객이 아닙니다.\n개설 정보를 확인해 주세요.", "MOVE_HOME", 0)
		End If
	
	'계좌 비밀번호 검증
	ElseIf szTranID = "obacp_opop_066r" Then
		'검증 완료되었으면 선택계좌 개설시간 24시간 초과 체크
		Dim szValdYn
		szValdYn = Grid0.GetCellData("bd_cell2", g_nSelectRow)
		
		Form.SetSharedData("BDM_KAKAO_ACNO"          , Combo0.cbkeydata )
		Form.SetSharedData("BDM_KAKAO_ACNO_PWD"      , Edit0.caption )
		
		'test
'		g_szValdYn = "Y"
'		Form.ShowAlert("szValdYn", szValdYn)
		
		If g_szProcCode == "3" Or g_szProcCode == 3 Then
			'이미 "3"으로 세팅되어 있는 상태지만 확인차 쉐어드 값 다시 세팅
			Form.SetSharedData("KAKAO_PROS_CODE" , "3")
			Form.OpenNextPopup("mbact73000_s7", "", "")			'고객정보 입력 단계
		Else
			'obaci_acct_300r OutBlock1 VALD_YN
			'"Y"인 경우 개설 후 24시간 초과, "N"인 경우 24시간 이내
			If szValdYn == "Y" Then
				Form.SetSharedData("KAKAO_PROS_CODE" , "2")
				Form.OpenNextPopup("mbact73000_s3", "", "")		'24시간 초과시 신분증 촬영 단계
			Else
				Form.SetSharedData("KAKAO_PROS_CODE" , "1")
				Form.OpenNextPopup("mbact73000_s7", "", "")		'24시간 초과 아닐시 약관 동의 단계
			End If
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'계좌비밀번호 5회 오류체크
	If szTranID == "obacp_opop_066r" Then
		If szErrCode == "2414" Then
			Form.MsgBox("안내", "계좌비밀번호 5회 오류입니다.\n비밀번호 재설정 후 진행해 주세요.", "PWD_RESET", 7, "재설정하기", "취소")
			Exit Sub
		End If
	End If
	
	If szSubMsg <> "" And szSubMsg <> Null Then
		Form.ShowAlert("알림" , szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	g_nSelectRow = CInt(iIndex)

'Form.ShowAlert("Combo 알림", Combo0.cblistcount)			

	'Edit0.visible = true  

	'If Edit0.caption == "" Or Edit0.caption == null Then
        Edit0.SetShowKeypad(true)
     'End If
End Sub

'============================================================================
Sub Edit0_OnEditComplete()
	If Edit0.caption ~= "" And Edit0.caption ~=  null Then
		'비밀번호 검증
		nLen = Edit0.pwdlen
		If CInt(nLen) < 4 Then
			Form.ShowAlert("알림", "4자리 이상 입력해 주세요.")
			Button0.enable = false
		Else 
			Button0.enable = true
		End If
    End If
End Sub

'============================================================================
Sub Button0_OnClick()
	'종합계좌
	If Len(Trim(Combo0.caption)) <= 0 Then
		Form.ShowAlert("오류", "종합계좌를 선택해주세요.")
		Exit Sub
	End If

    '계좌비밀번호
	If Len(Trim(Edit0.caption)) <= 0 Then
		Form.ShowAlert("오류", "계좌비밀번호를 입력해주세요.")
		Exit Sub
	End If
	
	'계좌 비밀번호 검증 
	DATAMANAGER.RequestTranData("obacp_opop_066r")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.MsgBox("알림", "이용 등록을 중단하시겠습니까?\n(중단하시는 경우 처음부터 다시 진행 하셔야 합니다.)", "Exit", 1)
End Sub


