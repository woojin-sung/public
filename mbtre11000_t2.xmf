	<SCRIPT_INFO _len="15197" _ulen="14456" >
'============================================================================
'20230309 SWJ START
'============================================================================
Dim g_ContGeFold 						'증거금 자세히보기 접힘 상태
g_ContGeFold = true
Dim g_ContYeFold 						'예수금 자세히보기 접힘 상태 
g_ContYeFold = true
Dim g_AcctInfo						'안심/일반계좌여부 판단
Dim g_decimal							'소수점 자리 수
'============================================================================
Sub Form_OnFormInitBefore()
	Cont0.Cont1.imgGeFold.setMaintainingRatio("1")
	'Cont0.Cont1.Imgicon1.setMaintainingRatio("1")
	Cont0.Cont2.Cont3.imgYeFold.setMaintainingRatio("1")
	Cont0.Cont2.Imgicon.setMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	'if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Cont0.setScrollBarVisible("0")
		Cont0.Cont1.setScrollBarVisible("0")
		Cont0.Cont2.setScrollBarVisible("0")
		Cont0.Cont2.Cont3.setScrollBarVisible("0")
	'end if
	
	Cont0.FormTab1.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 3) '활성화/비활성화/여백
	Cont0.FormTab1.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	Cont0.FormTab1.insertPage( cont0.FormTab1.tabcount, "page1", "page1", "empty", "0", "원화")
	Cont0.FormTab1.insertPage( cont0.FormTab1.tabcount, "page2", "page2", "empty", "0", "외화")
	
	szRdo = Trim(Form.LoadConfigData( "mbtre11000_t2", "crcd" ))	'원화/외화
		
	if szRdo = "" then
		Cont0.FormTab1.currenttab = 0
	else
		Cont0.FormTab1.currenttab = Cint(szRdo)
	end if
	
	'안드로이드 폴드 디스플레이 가로가 넓어 
	'이미지 위치 벌어지는 현상 개선
	'Cont0.Cont1.lblGeTitle.setNeighborCtlPos("Imgicon1","right",5 ,"")
	'Cont0.Cont2.lblJangTitle.setNeighborCtlPos("Imgicon","right", 5 ,"")
	Cont0.Cont1.lblGeTitle0.setNeighborCtlPos("imgGeFold","right",10 ,"")
	Cont0.Cont2.lblJangTitle.setNeighborCtlPos("Imgicon","right", 10,"")
	Cont0.Cont2.Cont3.lblYeTitle0.setNeighborCtlPos("imgYeFold","right",10 ,"")
	Cont0.lblExRate.setNeighborCtlPos("lblExRate1", "left", 45, "")
			
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHANGE_ACCTNO" then
		'Init_TR()
	elseif sEventName == "CHANGE_ACCTINFO" then
		g_AcctInfo = sParam
		Decide_IlbanAnsim()
		
		f_SetGrdMask()
		
		DATAMANAGER.RequestTranData("obtre_comm_211r")
	
	elseif sEventName == "RECEIVE" then
		'폼탭 변경 시 초기화
'		g_ContGeFold = true
'		g_ContYeFold = false
		
		'Cont0_Cont2_Cont3_BtnYe0_OnClick()
	end if
End Sub
'============================================================================
Sub Decide_IlbanAnsim()
	
	'안심
	if g_AcctInfo == "B" then
		Cont0.Cont2.Cont3.tblYe.visible = false
		Cont0.Cont2.Cont3.tblYe0.visible = true
		Cont0.Cont2.lblLine0.visible = false
		Cont0.Cont2.lblJangTitle.visible = false
		Cont0.Cont2.Imgicon.visible = false
		Cont0.Cont2.tblJang.visible = false
		
		Cont0.Cont2.height = 150
		Cont0.Cont2.Cont3.SetScrollAutoSize()
		Cont0.Cont2.SetScrollAutoSize()
		Cont0.SetScrollAutoSize()
		
		Cont0.Cont1.lblKeyWord0.visible = false
		Cont0.Cont2.Cont3.lblKeyWord1.visible = false
		Cont0.Cont2.Cont3.lblKeyWord2.visible = false
		Cont0.Cont2.Cont3.lblKeyWord3.visible = false
		Cont0.Cont2.Cont3.lblKeyWord4.visible = false
		Cont0.Cont2.Cont3.lblKeyWord5.visible = true
		Cont0.Cont2.Cont3.lblKeyWord6.visible = true
		Cont0.Cont2.Cont3.lblKeyWord7.visible = true
		Cont0.Cont1.lblKeyWord8.visible = true
'		
		Cont0.Cont1.lblKeyWord8.caption = "계좌평가금액"
		Cont0.Cont1.lblKeyWord0.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord1.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord2.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord3.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord4.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord5.caption = "주문가능금액"
		Cont0.Cont2.Cont3.lblKeyWord6.caption = "출금가능금액(원화)"
		Cont0.Cont2.Cont3.lblKeyWord7.caption = "출금가능금액(외화)"
		
		Cont0.Cont2.Cont3.lblKeyWord5.setHighlight(332)
		Cont0.Cont2.Cont3.lblKeyWord6.setHighlight(332)
		Cont0.Cont2.Cont3.lblKeyWord7.setHighlight(332)
		Cont0.Cont1.lblKeyWord8.setHighlight(332)
		
	else
		Cont0.Cont2.Cont3.tblYe.visible = true
		Cont0.Cont2.Cont3.tblYe0.visible = false
		Cont0.Cont2.lblLine0.visible = true
		Cont0.Cont2.lblJangTitle.visible = true
		Cont0.Cont2.Imgicon.visible = true
		Cont0.Cont2.tblJang.visible = true
		
		Cont0.Cont2.height = 332
		Cont0.Cont2.SetScrollAutoSize()
		Cont0.Cont2.Cont3.SetScrollAutoSize()
		Cont0.SetScrollAutoSize()
		
		Cont0.Cont1.lblKeyWord0.visible = true
		Cont0.Cont2.Cont3.lblKeyWord1.visible = true
		Cont0.Cont2.Cont3.lblKeyWord2.visible = true
		Cont0.Cont2.Cont3.lblKeyWord3.visible = true
		Cont0.Cont2.Cont3.lblKeyWord4.visible = true
		Cont0.Cont2.Cont3.lblKeyWord5.visible = false
		Cont0.Cont2.Cont3.lblKeyWord6.visible = false
		Cont0.Cont2.Cont3.lblKeyWord7.visible = false
		Cont0.Cont1.lblKeyWord8.visible = false
		
		Cont0.Cont1.lblKeyWord0.caption = "계좌평가금액(A)"
		Cont0.Cont2.Cont3.lblKeyWord1.caption = "계좌증거금률(A÷B)"
		Cont0.Cont2.Cont3.lblKeyWord2.caption = "주문가능금액"
		Cont0.Cont2.Cont3.lblKeyWord3.caption = "출금가능금액(원화)"
		Cont0.Cont2.Cont3.lblKeyWord4.caption = "출금가능금액(외화)"
		Cont0.Cont2.Cont3.lblKeyWord5.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord6.caption = ""
		Cont0.Cont2.Cont3.lblKeyWord7.caption = ""
		Cont0.Cont1.lblKeyWord8.caption = ""
		
		Cont0.Cont1.lblKeyWord0.setHighlight(332)
		Cont0.Cont2.Cont3.lblKeyWord1.setHighlight(332)
		Cont0.Cont2.Cont3.lblKeyWord2.setHighlight(332)
		Cont0.Cont2.Cont3.lblKeyWord3.setHighlight(332)
		Cont0.Cont2.Cont3.lblKeyWord4.setHighlight(332)
		
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtre_comm_211r" then
		szCRNC = 1 - Cint(Cont0.FormTab1.currentTab)
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO", 0, szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "CRNC_CLS_CODE" , 0,  szCRNC )	'1.원화 0.외화
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_comm_211r" then
	
		'통화코드
		CRCD                 = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CRCD"  )
		
		'계좌평가금액
		ACNT_VLTN_AMT        = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "ACNT_VLTN_AMT"        )
		
		'기본증거금
		CFD_PMARG            = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_PMARG"            )
		
		'주문증거금
		CFD_ODER_MARG        = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_ODER_MARG"        )
		
		'주문가능금액
		UI_CFD_ODER_ABLE_AMT = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "UI_CFD_ODER_ABLE_AMT" )
		
		'계좌증거금율
		CFD_ACNT_MGRT        = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_ACNT_MGRT" )

		'추가증거금
		CFD_SPLM_EVDN_AMT    = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_SPLM_EVDN_AMT"    )
		
		'평가손익
		CFD_VLTN_PRLS_AMT    = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_VLTN_PRLS_AMT"    )
		
		'미결제 청산손익
		UI_CFD_OTST_CLRN_PRLS = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "UI_CFD_OTST_CLRN_PRLS"    )
		
		'미결제비용
		UI_CFD_OTST_EXPN_SMTN = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "UI_CFD_OTST_EXPN_SMTN"   )
		
		'미수금
		CFD_UNAM              = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_UNAM"           )
		
		'유지증거금
		CFD_MNTN_MARG         = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_MNTN_MARG"      )
		
		'마진콜여유금액
		UI_CFD_EXTA_MARG_TTAM = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "UI_CFD_EXTA_MARG_TTAM"   )
		
		'추가증거금
		SPLM_EVDN_AMT         = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "SPLM_EVDN_AMT"        )
		
		'외화출금가능금액
		DRNG_ABLE_AMT2    = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "DRNG_ABLE_FRCR_AMT"    )
		
		'원화출금가능금액
		DRNG_ABLE_AMT    = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "WNCR_DRNG_ABLE_AMT"    )
		
		'원화/외화 예수금 합
		CFD_TFAM_SUM     = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_TFAM"    )
		
		if Cont0.FormTab1.currenttab == "1" or Cont0.FormTab1.currenttab == 1 then
			'외화 예수금
			CFD_TFAM         = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_FRCR_TFAM"    )
			
			g_decimal = 2	
			szCurrency = " " & CRCD
			
			
		'원화
		else	
			'원화 예수금
			CFD_TFAM         = DATAMANAGER.GetDataValue( 0, "obtre_comm_211r", "OutBlock1", "CFD_WNCR_TFAM"    )
			
			g_decimal = 0
			szCurrency = "원"
		end if
		
		'SetCellCRCD()
		
		sMask = "1,0,,,0,,"..g_decimal..",1,1,2,0"	

		Cont0.Cont1.tblGeung.SetCellMaskInfo( 0, 2, sMask)
		Cont0.Cont1.tblGeung.SetCellMaskInfo( 1, 2, sMask)
		Cont0.Cont1.tblGeung.SetCellMaskInfo( 2, 2, sMask)
		Cont0.Cont1.tblGeung.SetCellMaskInfo( 3, 2, sMask)
		
		Cont0.Cont1.tblGeung.SetCellMaskInfo( 5, 2, sMask)
		
		Cont0.Cont1.tblGeung.SetCellMaskInfo( 6, 2, "1,0,,,0,,2,1,1,2,0")
		Cont0.Cont1.tblGeung.SetCellMaskInfo( 7, 2, sMask)
		
'		Cont0.Cont2.Cont3.tblYe.SetCellMaskInfo( 0, 3, sMask)
'		Cont0.Cont2.Cont3.tblYe.SetCellMaskInfo( 1, 3, sMask)
'		Cont0.Cont2.Cont3.tblYe.SetCellMaskInfo( 2, 3, sMask)
'		Cont0.Cont2.Cont3.tblYe.SetCellMaskInfo( 3, 3, sMask)
'		Cont0.Cont2.Cont3.tblYe.SetCellMaskInfo( 4, 3, "1,0,,,0,,0,1,1,2,0"	)
'		Cont0.Cont2.Cont3.tblYe.SetCellMaskInfo( 9, 3, sMask)
		
		Cont0.Cont2.tblJang.SetCellMaskInfo( 0, 3, sMask)
		Cont0.Cont2.tblJang.SetCellMaskInfo( 1, 3, sMask)
		Cont0.Cont2.tblJang.SetCellMaskInfo( 2, 3, sMask)

		Cont0.Cont1.tblGeung.SetCellString( 0, 2, FormatNumber(CFD_TFAM_SUM, g_decimal)& szCurrency)
		Cont0.Cont1.tblGeung.SetCellString( 1, 2, FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& szCurrency)
		Cont0.Cont1.tblGeung.SetCellString( 2, 2, FormatNumber(UI_CFD_OTST_CLRN_PRLS, g_decimal)& szCurrency)
		Cont0.Cont1.tblGeung.SetCellString( 3, 2, FormatNumber(UI_CFD_OTST_EXPN_SMTN, g_decimal)& szCurrency)
		Cont0.Cont1.tblGeung.SetCellString( 4, 2, FormatNumber(CFD_UNAM, g_decimal)& szCurrency)
		Cont0.Cont1.tblGeung.SetCellString( 5, 2, FormatNumber(ACNT_VLTN_AMT, g_decimal)& szCurrency)
		
		Cont0.Cont2.Cont3.tblYe.SetCellString( 0, 3, FormatNumber(CFD_PMARG, g_decimal) & szCurrency)
		Cont0.Cont2.Cont3.tblYe.SetCellString( 2, 3, FormatNumber(CFD_ACNT_MGRT, 2) & "%")
		Cont0.Cont2.Cont3.tblYe.SetCellString( 4, 3, FormatNumber(UI_CFD_ODER_ABLE_AMT, g_decimal) & szCurrency)
		Cont0.Cont2.Cont3.tblYe.SetCellString( 5, 3, FormatNumber(DRNG_ABLE_AMT, 0)& "원")
		Cont0.Cont2.Cont3.tblYe.SetCellString( 6, 3, FormatNumber(DRNG_ABLE_AMT2, 2)& " " & CRCD)
		
		Cont0.Cont2.Cont3.tblYe0.SetCellString( 0, 3, FormatNumber(CFD_PMARG, g_decimal) & szCurrency)
		Cont0.Cont2.Cont3.tblYe0.SetCellString( 2, 3, FormatNumber(UI_CFD_ODER_ABLE_AMT, g_decimal) & szCurrency)
		Cont0.Cont2.Cont3.tblYe0.SetCellString( 4, 3, FormatNumber(DRNG_ABLE_AMT, 0) & "원")
		Cont0.Cont2.Cont3.tblYe0.SetCellString( 5, 3, FormatNumber(DRNG_ABLE_AMT2, 2)& " " & CRCD)
		
		Cont0.Cont2.tblJang.SetCellString( 0, 2, FormatNumber(CFD_MNTN_MARG, g_decimal) & szCurrency)
		Cont0.Cont2.tblJang.SetCellString( 1, 2, FormatNumber(UI_CFD_EXTA_MARG_TTAM, g_decimal) & szCurrency)
		Cont0.Cont2.tblJang.SetCellString( 2, 2, FormatNumber(SPLM_EVDN_AMT, g_decimal)& szCurrency)
		
		Cont0.Cont1.tblGeung.SetCellFgColor(1, 2, SetCellForeColor(Cdbl(CFD_VLTN_PRLS_AMT)))
		Cont0.Cont1.tblGeung.SetCellFgColor(2, 2, SetCellForeColor(Cdbl(UI_CFD_OTST_CLRN_PRLS)))
		
		'Cont0.Cont2.Cont3.tblYe.SetCellFgColor(1, 3, SetCellForeColor(Cdbl(CFD_VLTN_PRLS_AMT)))
		'Cont0.Cont2.Cont3.tblYe.SetCellFgColor(4, 3, SetCellForeColor(Cdbl(DRNG_ABLE_AMT)))
		
'		Cont0.Cont2.tblJang.SetCellFgColor(1, 2, SetCellForeColor(Cdbl(UI_CFD_EXTA_MARG_TTAM)))
	end if
End Sub
'============================================================================
'통화 SET (원화만 없어도 컨트롤로 받는데..)
'============================================================================
Sub	SetCellCRCD()
	Cont0.Cont1.tblGeung.SetCellString( 0, 3, CRCD)
	Cont0.Cont1.tblGeung.SetCellString( 1, 3, CRCD)
	Cont0.Cont1.tblGeung.SetCellString( 2, 3, CRCD)
	Cont0.Cont1.tblGeung.SetCellString( 3, 3, CRCD)
	Cont0.Cont1.tblGeung.SetCellString( 7, 3, CRCD)
	
	Cont0.Cont2.Cont3.tblYe.SetCellString( 0, 4, CRCD)
	Cont0.Cont2.Cont3.tblYe.SetCellString( 1, 4, CRCD)
	Cont0.Cont2.Cont3.tblYe.SetCellString( 2, 4, CRCD)
	Cont0.Cont2.Cont3.tblYe.SetCellString( 3, 4, CRCD)
	Cont0.Cont2.Cont3.tblYe.SetCellString( 4, 4, CRCD)
	Cont0.Cont2.Cont3.tblYe.SetCellString( 9, 4, CRCD)
	
	Cont0.Cont2.tblJang.SetCellString( 0, 3, CRCD)
	Cont0.Cont2.tblJang.SetCellString( 1, 3, CRCD)
	Cont0.Cont2.tblJang.SetCellString( 2, 3, CRCD)
End Sub
'============================================================================
'테이블 색상 SET
'============================================================================
Sub SetCellForeColor(szData)
	if szData > 0 then
		szColor = "10"
	elseif szData < 0 then
		szColor = "11"
	else
		szColor = "12"
	end if
	
	return szColor
End Sub
'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtre11000_t2", "crcd", Cont0.FormTab1.currenttab) 		'원화/외화 저장
End Sub
'============================================================================
'
'============================================================================
'f_SetExMask : 환율 라벨 소수점 자리수 SET
'============================================================================
Function f_SetGrdMask()
	Dim szType
	szType = Trim(Form.GetCtlProp("#lblAcntNation", "caption"))
	
	cont0.lblExRate.caption = ""
	
	if szType == "392" then '일본은 소수점 4자리 표시
		cont0.lblExRate.mask = "0,0,,,0,,4,1,0,0,0"
	else
		cont0.lblExRate.mask = "0,0,,,0,,2,1,0,0,0"
	end if
	
End Function
'============================================================================
Sub Cont0_FormTab1_OnTabChanged(nCurrentTab)
	DATAMANAGER.RequestTranData("obtre_comm_211r")
End Sub
'============================================================================
Sub Cont0_Cont2_Imgicon_OnClick()
	Cont0.Cont2.Imgicon.openToolTip("현재가를 기준으로 기본 증거금을 재산정합니다.",320, 50, 1)
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
