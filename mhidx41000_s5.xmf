'============================================================================
' 01.화면명 	: 시장종합
' 02.화면설명	: 시장종합_상품
' 03.작성		: 2016.02.12
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFileName	'설정파일
dim	g_szNames		'설정Key
dim	g_szValues		'설정값
dim 	g_szCodes		'실제Input값

g_szNames	= Array("41000_GOLD", "41000_WTI", "41000_DUBAI", "41000_BRENT" )
g_szValues	= Array()
'g_szCodes	= Array("COM@GC", "SPT@CL", "SPT@DU", "SPT@EB")
' 20160728 전요셉과장 요청
'	- WTI     : 현물 -> 선물
'	- 브렌트유: 현물 -> 선물
g_szCodes	= Array("COM@GC", "NYM@CL", "SPT@DU", "IPE@EB")


g_szFileName = "41000ITEMS.ini"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function LoadSetting()

	for	i	=	0	to	Ubound(g_szNames)
		g_szValues(i)	=	Form.LoadConfigData(g_szFileName, g_szNames(i)	)
	Next
	
'	for	i	=	0	to	Ubound(g_szNames)
'		Form.ShowAlert(i, g_szValues(i))
'	Next
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	call	 LoadSetting()
	DATAMANAGER.RequestTranData("ohhts_1682_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim	nIdx
	nIdx	=	0
	
	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r")
	for	i = 0	to	Ubound(g_szNames)
		if	g_szValues(i)	=	"1"	then
		    DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , nIdx , "FN" )
		    DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , nIdx , g_szCodes(i) )
		    nIdx	=	nIdx + 1
		end if	
	next
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1682
	dim szRealCode
	
	ncnt1682 = DATAMANAGER.GetDataCount(0, "ohhts_1682_001r" , "OutBlock1")

	if szTranID = "ohhts_1682_001r" then 
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg")

		for i = 0 to ncnt1682 - 1
		  szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_ISCD", i )
		  DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", i, szRealCode) 
		Next	    
		
		DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
	end if 
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd01.SetClear()
	Form_OnFormInit()
End Sub
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd01.GetCellData( "bd_cell0", lRow )
	szMarket = grd01.GetCellData( "bd_cell1", lRow )
	szName	= grd01.GetCellData( "bd_cell2", lRow )
	
'	msgbox "lRow:[" & lRow & "].. szSymbol:[" & szSymbol & "], szMarket[" & szMarket & "], szName[" & szName & "]"
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)
End Sub

