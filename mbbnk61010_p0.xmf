'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체예정내역_확인(단수)
' 02. 화면설명 : 이체예정내역_확인(단수) 팝업
' 03. 작    성 : 16.03.09
' 2020.11.27 : 정민영 : v0001 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
' 2021.11.03 : 김수진 : v0002 : 동일인 계좌간 대체출금 시 전자서명, 보안매체 생략, 간편이체한도 미적용
' 2022.02.28 : 장원혁 : v0003 : 동일인 계좌간 대체출금 시 보안매체 미발급이어도 처리 가능하도록 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAccountNumber
Dim	g_szBankName	'입금은행
Dim	g_szAcc 	'입금계좌번호
Dim	g_szCnFtName 	'받는분
Dim	g_szMoney	'이체금액
Dim	g_szFee 	''수수료
Dim	g_szPlusSec 	''추가인증
Dim g_szPlusData
Dim g_szAccountPassword
Dim g_szList
Dim g_szCertUserType
Dim g_sGubunCode
Dim g_sSpinCertYn
Dim g_sOtpTrMsg
Dim g_sBioTrMsg

Dim g_szSapeYN 	'v0002 입금계좌 동일인 여부
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_625r" THEN		'보안매체확인
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szAccountNumber
		sACNO_PWD = g_szAccountPassword
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	end if

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' imgClose_OnClick
'============================================================================



'============================================================================
' btnCancel_OnClick - 취소
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub



'============================================================================
' btnEnroll_OnClick - 등록
'============================================================================
Sub btnEnroll_OnClick()
	'v0002 sta
	If g_szSapeYN == "Y" Then
		Form.SendReturnToParent("mbbnk61010_p0" , "ok")
		Form.CloseForm( )
	Else
		if g_szCertUserType == "1" then
			' 간편인증 보안매체 추가
			'==================
			Form.triggerEvent("LinkForm0", "이체확인" , "")
			'==================
			'Form.OpenPopup("mhetc90060_px", "", "")
		else
			Form.triggerEvent("LinkForm0", "이체확인" , "")
		end if 
	End If
	'v0002 fin
End Sub



'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			TR_Inquiry("obcsb_oimf_625r")
		else
			Form.CloseForm( )
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Form.SendReturnToParent( "mbbnk61010_p0" , "OK" )
			Form.CloseForm( )
		else						'실패
			exit sub
		end if
	end if
	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			Form.SendReturnToParent( "mbbnk61010_p0" , "ok" )
			Form.CloseForm( )
		ElseIf sRet == "cancel" Then
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	if UBOUND(g_szList) < 1 THEN
		EXIT SUB
	END IF
	
	Form.SetScreenName( "이체예정내역 확인" )
	for i=0 to 6
		Table0.SetCellString( i, 1, "" )	'테이블 clear
	next
	'Form.GetSharedData( "#HOST_DATE", 0 )
	Table0.SetCellString( 0, 1, g_szBankName)	'입금은행
	Table0.SetCellString( 1, 1, g_szAcc)
	if g_szList(11) == "287" then
		Table0.SetCellMaskInfo( 1, 1, "1,0,,,1,####-####-##,0,1,1")
	end if
	Table0.SetCellString( 2, 1, g_szCnFtName)	'받는분
	Table0.SetCellString( 3, 1, g_szMoney)	'이체금액
	Table0.SetCellString( 4, 1, g_szFee )	'수수료
		
	sTotal = CDbl(g_szMoney) + CDbl(g_szFee)
	Table0.SetCellString( 5, 1, sTotal)	'총출금액
	
	g_sSpinCertYn = "N"
	g_sOtpTrMsg = ""
	
	
	g_sOtpTrMsg = g_szBankName & "#" & g_szAcc & "#" & g_szCnFtName & "#" & FormatNumber(CDbl(g_szMoney), 0, 0, 0, -1) & "원#"
	Form.SetSharedData("OTP_TR_MSG_1" , g_sOtpTrMsg)		
		
	if g_szCertUserType == "3" OR g_szCertUserType == "4"  then	'bio 인증
		g_sBioTrMsg = "이체예정내역\n" & "입금기관:" & g_szBankName & "\n" & "입금계좌:" & g_szAcc & "\n" & "예금주명:" & g_szCnFtName & "\n" & "이체금액:" & FormatNumber(CDbl(g_szMoney), 0, 0, 0, -1) & "원\n" 
		Form.SetSharedData("BIO_TR_MSG_1" , g_sBioTrMsg)
	End if
	
	'v0002 sta : 동일인 여부에 따른 분기처리 : 동일인일경우 전자서명, 보안매체 생략 후 출금처리
	'g_szSapeYN = "" 주석처리 v0003
	'g_szSapeYN = Form.GetSharedData("61010_SAPE_YN" , TRUE) 주석처리 v0003

	If g_szSapeYN == "Y" Then
		lblSapeY1.visible = True
		lblSapeY2.visible = True
		LinkForm0.visible = False
	Else
		lblSapeY1.visible = False
		lblSapeY2.visible = False
		LinkForm0.visible = True
	End If
	'v0002 fin
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		Select Case g_sGubunCode
			Case "1"
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form.SendReturnToParent("mbbnk61010_p0" , "Error")
				Form.CloseForm( )
			Case "2"	
				Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				Form.SendReturnToParent("mbbnk61010_p0" , "Error")
				Form.CloseForm( )
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				Form.SendReturnToParent("mbbnk61010_p0" , "Error")
				Form.CloseForm( )
		End Select
		
		'보안매체제외인경우
		IF Form.GetSharedData("61010_SMDIA_SKIP" , TRUE)	 = "Y" THEN
			'간편비번 only
			IF g_szCertUserType = "1" THEN
				LinkForm0.linkfile = "mbbnk61010_s7"
				Exit Sub
			ELSEIF g_szCertUserType = "3" THEN		'바이오 only
				LinkForm0.linkfile = "mbbnk61010_sb"
				Exit Sub
			END IF 
			
			
		END IF
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		if g_szCertUserType <> "1" AND g_szCertUserType <> "3"  AND g_szCertUserType <> "4" THEN
			Select Case g_sGubunCode
				Case "0"
					'Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
					LinkForm0.linkfile = "mbbnk61010_s1"
				Case "3"
					'Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
					LinkForm0.linkfile = "mbbnk61010_s2"
				Case "4"
					'Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_mOTP
					LinkForm0.linkfile = "mbbnk61010_suo"
			End Select
		END IF
		
		if g_szCertUserType == "1" then
			' 간편인증 보안매체 추가
			'==================
			'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
			Select Case g_sGubunCode
				Case "0"
					LinkForm0.linkfile = "mbbnk61010_s5" ' 간편인증_보안카드
				Case "3"
					LinkForm0.linkfile = "mbbnk61010_s6" ' 간편인증_OTP
				Case "4"
					LinkForm0.linkfile = "mbbnk61010_sso" ' 간편인증_mOTP
			End Select
			'==================
		end if
		
		if g_szCertUserType == "3" OR g_szCertUserType == "4" then
			' 간편인증 보안매체 추가
			'==================
			'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
			Select Case g_sGubunCode
				Case "0"
					LinkForm0.linkfile = "mbbnk61010_s8" ' 바이오인증_보안카드
				Case "3"
					LinkForm0.linkfile = "mbbnk61010_s9" ' 바이오인증_OTP
				Case "4"
					LinkForm0.linkfile = "mbbnk61010_sbo" ' 바이오인증_mOTP
			End Select
			'==================
		end if
	end if

End Sub

'============================================================================
Sub Form_OnFormInitBefore()

	g_szSapeYN = "" 'v0003
	g_szSapeYN = Form.GetSharedData("61010_SAPE_YN" , TRUE) 'v0003

	Dim szData
	szData = Form.GetOpenLinkData()
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	g_szList = Split(szData, "♥")
	
	if UBOUND(g_szList) < 1 THEN
		EXIT SUB
	END IF
	'g_szData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& g_nTrcnt &"♥"& g_szEdtName &"♥"& szPwd & g_szCom
'	Form.ShowAlert("szData", szData)
	g_szAccountNumber = g_szList(0)
	g_szBankName = g_szList(1)	'입금은행
	g_szAcc = g_szList(2)	'입금계좌번호
	g_szMoney = g_szList(3)	'이체금액
	g_szCnFtName = g_szList(9)	''받는분
	g_szFee = g_szList(6)	''수수료
	g_szPlusSec = g_szList(7)''추가인증
	g_szAccountPassword= g_szList(10)	
	
	if g_szFee == "" or g_szFee == null then
		g_szFee = "0"
	end if
	
	If g_szSapeYN <> "Y" Then 'v0003 기존로직 If문 처리
	
	    if g_szCertUserType == "1" OR g_szCertUserType == "3" OR g_szCertUserType == "4" then
		    ' 간편인증 보안매체 추가
		    '==================
		    TR_Inquiry("obcsb_oimf_625r")
		    '==================
		    'LinkForm0.linkfile = "mbbnk61010_s4"
	    elseif Trim(g_szPlusSec) == "Y" then
		    g_szPlusData = "1" &"★"& g_szBankName &"★"& g_szList(11) &"★"& g_szCnFtName &"★"& g_szMoney
		    sData = Form.GetSharedData("&USER_ID", false )
		    Form.SetSharedData("CERT_ID" , sData)
		    Form.SetSharedData("CERT_ACNO" , Left(g_szAccountNumber, 8))
		    Form.SetSharedData("BANK_TRANSTYPE" , "01")
		    Form.OpenFramePopup("mhetc90060_p8" , "bank_61010★"& g_szPlusData , "")
	    else 	
		    TR_Inquiry("obcsb_oimf_625r")
	    end if		
	
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "인증서" then  'v0001 mbbnk61010_s1~9,sa,sb 공인인증서->인증서 변경
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	elseif sEventName == "보안카드" then
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	elseif sEventName == "간편인증" then
		if sParam == "Success" then
			btnEnroll_OnClick()
		end if
	elseif sEventName == "바이오인증" OR sEventName == "공동인증" then
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	elseif sEventName == "간편인증OTP" then
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	ElseIf sEventName == "mOTP_GenReq" Then 
'msgbox sParam
		Form.requestMOTP("MOTP_REQ_OTP_ENC", sParam , "61010p0")
'	elseif sEventName == "reqAuthPinPad" then
'		Dim sRet, sErrorCode, sErrorMsg, sPassFailCnt
'		sRet = Split(sParam, "★")
'		
'		if #sRet > 1 then
'			sErrorCode = sRet[0]
'			sErrorMsg = sRet[1]
'			sPassFailCnt = sRet[2]
'		end if
'		
'		if sErrorCode == "0000" then '성공
'			g_sSpinCertYn = "Y"
'		elseif sErrorCode == "2005" then
'			g_sSpinCertYn = "N"
'			Form.ShowAlert("알림", "간편인증 비밀번호 " & sPassFailCnt & "회 오류입니다.")
'		else
'			g_sSpinCertYn = "N"
'			Form.ShowAlert("알림", "간편인증 실패.(" & sErrorMsg & ")")
'		end if
'	elseif sEventName == "reqPush" then
'		Dim sRet, sErrorCode, sErrorMsg
'		sRet = Split(sParam, "★")
'		
'		sErrorCode = sRet[0]
'		sErrorMsg = sRet[1]	
'		
'		if sErrorCode == "0000" then '성공
'			'Form.triggerEvent("#", "공인인증서", "Success")
'		else
'			Form.ShowAlert("알림", "간편인증 실패(" & sErrorMsg & ")")
'		end if
	end if  
End Sub

