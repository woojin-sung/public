'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szMrkt, g_szDate, g_szRate1, g_szRate2, g_szCheck1, g_szCheck2, g_szCheck3
Dim g_bFlag '시장변경시 종목코드 입력안되도록 하는 플래그
Dim g_szData, g_szSearchWord
g_isEmpty_Code = false
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************
'============================================================================
'f_InitFilterValue 설정 값 초기화
'============================================================================
Function f_InitFilterValue(szType)
	if szType == "0" then
		g_szMrkt = "0"
		g_szDate = cldFrom.caption
		
	elseif szType == "1" then
		g_szRate1 	= "0"
		g_szRate2 	= "100"
		g_szCheck1 	= "Y"
		g_szCheck2 	= "Y"
'		g_szCheck3 	= "N"
		g_szCheck3 	= "Y" '20220121 아이티젠 김성수 수정
	end if
	
End Function 

'============================================================================
'f_LoadFilterValue 설정 값 LOAD
'============================================================================
Function f_LoadFilterValue()
	Dim tData1, tData2, szTemp1, szTemp2
	
	szTemp1 = Form.LoadConfigData("SET_mbtre10000", "SET_VALUE_MAIN") '메인화면에서 설정한 필터 값
	szTemp2 = Form.LoadConfigData("SET_mbtre10000", "SET_VALUE_POP"	) '상세팝업에서 설정한 필터 값
	
	if szTemp1 <> "" then
		tData1 = Split(szTemp1, "★")
		'0시장콤보 인덱스|1기준일자
		
		g_szMrkt = tData1(0)
'		g_szDate = tData1(1)
		
	else '초기화
		Call f_InitFilterValue("0")
		
	end if
	
	if szTemp2 <> "" then
		tData2 = Split(szTemp2, "★")
		'0증거금률 이상 % 값|1증거금률 이하 % 값|2신규매수 불가종목 제외여부|3신규매도 불가종목 제외여부|4ETF 제외여부
		
		g_szRate1 	= tData2(0)
		g_szRate2 	= tData2(1)
		g_szCheck1 	= tData2(2)
		g_szCheck2 	= tData2(3)
		g_szCheck3 	= tData2(4)
		
	else '초기화
		Call f_InitFilterValue("1")
		
	end if
	
End Function 

'============================================================================
'f_SaveFilterValue 설정 값 SAVE
'============================================================================
Function f_SaveFilterValue()
	Dim szDate, szMarket
	
	szDate = cldFrom.caption
	szMarket = cmbMarket.currentindex

	Form.SaveConfigData("SET_mbtre10000", "SET_VALUE_MAIN", "" )
	Form.SaveConfigData("SET_mbtre10000", "SET_VALUE_MAIN", szMarket & "★" & szDate )
	
End Function

'============================================================================
'f_SetDataInCtrl 설정 값 SET
'============================================================================
Function f_SetDataInCtrl()
	if g_szMrkt <> "" then
		cmbMarket.currentindex = g_szMrkt
	end if
	
End Function 

'============================================================================
'f_RequestTran 조회 서비스 호출
'============================================================================
Function f_RequestTran()
	DATAMANAGER.RequestTranData( "obtre_comm_021r" )
End Function

'============================================================================
'f_RequestNextTran 다음 조회
'============================================================================
Function f_RequestNextTran()
	DATAMANAGER.RequestNextData( "obtre_comm_021r" )
End Function

'============================================================================
'f_SetRdoExValue 거래소 콤보 LIST SET
'============================================================================
Function f_SetRdoExValue()
	Dim szNationCode
	Dim szCbTotalList, szCbListAll, szCbListUS, szCbListCH, szCbListHK, szCbListJP
	
	szNationCode = cmbMarket.cbkeydata
	
	szCbTotalList = ""
	cmbEx.clear = true
	
	szCbListAll = "%`전체"
	szCbListUS  = "NY`뉴욕\r\nOQ`나스닥\r\nAX`아멕스"
	szCbListCH  = "SH`상해\r\nSZ`심천"
	szCbListHK  = "HK`홍콩"
	szCbListJP  = "JP`일본"
	
	if szNationCode == "%" then '전체
		szCbTotalList = 	szCbListAll& "\r\n" & 
						szCbListUS & "\r\n" & 
						szCbListCH & "\r\n" & 
						szCbListHK & "\r\n" & 
						szCbListJP
						
	elseif szNationCode == "840" then '미국
		szCbTotalList = 	szCbListAll& "\r\n" & 
						szCbListUS
						
	elseif szNationCode == "156" then '중국
		szCbTotalList = 	szCbListAll& "\r\n" & 
						szCbListCH
						
	elseif szNationCode == "344" then '홍콩
		szCbTotalList = 	szCbListHK
						
	elseif szNationCode == "392" then '일본
		szCbTotalList = 	szCbListJP
		
	end if
	
	if szCbTotalList <> "" then
		cmbEx.cbinputdatatext = szCbTotalList
	end if
	
End Function

'============================================================================
'Transform_Exid2 : 거래소 심볼 변환
'============================================================================
Function Transform_Exid2(sValue)
	if sValue = "HK" then
		return "HKS"
	elseif sValue = "SH" then
		return "SHS"
	elseif sValue = "SZ" then
		return "SZS"
	elseif sValue = "NY" then
		return "NYS"
	elseif sValue = "AX" then
		return "AMX"
	elseif sValue = "OQ" then
		return "NAS"
	elseif sValue = "JP" then
		return "TSE"
	else
		return ""
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD종목검색" )
	
	f_LoadFilterValue() '필터 저장 값 불러오기
	f_SetDataInCtrl() '저장 값을 컨트롤에 SET
'	f_SetRdoExValue() '거래소 콤보 SET
	
	ItemCode0.code = "empty"
	
	f_RequestTran() '서비스 호출
End Sub


'============================================================================
Sub Form_OnFormClose()
	Call f_SaveFilterValue()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "POP_SET" then
		Call f_LoadFilterValue()
		Call f_RequestTran()
	
	'다른화면 연결 팝업 이벤트
	elseif sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems, szSendData
		
		szSendData = ""
		szListItems =	split(sRet,"★")
		
		if szListItems(1) = "0" then '현재가
			Form.OpenScreen( "16100" , g_szData )
			
		elseif szListItems(1) = "1" then '매수
			szSendData = "기타" &"★"& "0" &"★"& g_szData 
			Form.OpenScreen("16200" , szSendData )
			
		elseif szListItems(1) = "2" then '매도
			szSendData = "기타" &"★"& "1" &"★"& g_szData 
			Form.OpenScreen("16200" , szSendData ) 
			
		end if
		
		g_szData = ""
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtre_comm_021r" then
		Dim szInputCode, szDate, szMarket, szExCode
		
		if g_isEmpty_Code == false then
'			dim szCdInfo, szMkCd, szCode
'			szCdInfo = split(g_szFullCode, "@")
'			
'			szMkCd = szCdInfo[0]
'			szCode = szCdInfo[1]
			
'			szInputCode = szCode & "." & szMkCd
			szInputCode = g_szSearchWord
			
		else
			szInputCode = "%"
		end if
		
		szDate = cldFrom.caption
		szMarket = cmbMarket.cbkeydata
		szExCode = cmbEx.cbkeydata
'		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISNM"				, 0, szInputCode 	) '종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STND_DATE"			, 0, szDate 		) '조회날짜
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STA_RATE"			, 0, g_szRate1 	) '시작비율
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIN_RATE"			, 0, g_szRate2 	) '종료비율
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CTCD"				, 0, szMarket 	) '국가코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OVRS_STCK_EXCH_IDNO"	, 0, szExCode 	) '거래소코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BYOV_ABLE_YN"		, 0, g_szCheck1 	) '매수가능여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SELN_ABLE_YN"		, 0, g_szCheck2 	) '매도가능여부
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "EXLS_YN"			, 0, g_szCheck3 	) 'ETF 제외여부
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

        if szTranID == "obtre_comm_021r" then
	        If tonumber(grd1.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = grd1.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1
			        Dim GrpCode
				GrpCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CFD_ISSU_RISK_GRP_CODE", i)
				
				If GrpCode == "A" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "A")
				ElseIf GrpCode == "B" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "B")
				ElseIf GrpCode == "C" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "C")
				ElseIf GrpCode == "D" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "D")
				ElseIf GrpCode == "F" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "C-1")
				ElseIf GrpCode == "G" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "D-1")
				ElseIf GrpCode == "E" Then
						grd1.SetCellData( "bd_cell3", nRowCnt + i , "E")
				End If
			Next
		end if
	end if

End Sub

'============================================================================
Sub cmbMarket_OnEditComplete(iIndex)
	g_isEmpty_Code = true
	ItemCode0.code = "empty"	'20220905 SWJ START
	edtSearch.caption = ""
	
	f_SetRdoExValue()
	f_RequestTran()
	
End Sub

'============================================================================
Sub cmbEx_OnEditComplete(iIndex)
	g_isEmpty_Code = true
	ItemCode0.code = "empty"	'20220905 SWJ START
	edtSearch.caption = ""
	
	f_RequestTran()
End Sub
