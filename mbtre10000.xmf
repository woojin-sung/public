End Sub

'============================================================================
'20220905 SWJ START : 에디트 -> 종목컨트롤로 변경
'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	name = Form.GetItemCodeInfo(sCode, "name")	
	g_szSearchWord = name
	g_isEmpty_Code = false
		
	f_RequestTran()
End Sub
