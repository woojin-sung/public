	<SCRIPT_INFO _len="2491" _ulen="2323" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 바이오인증
' 02. 화면설명 : 바이오인증 - 유의사항
' 03. 작    성 : 2017.01.10
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_CheckFlag

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	g_CheckFlag = false
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "NextCheck" then
		if Container0.ChkButton0.chksilence == "0" then
			Form.MsgBox( "알림", "유의사항 확인에 동의해주세요.", "checknotice", 6)
		else 
			Form.triggerEvent( "#", "NextStep", "1" )	
		end if
	elseif sEventName == "BeforeCheck" then
		Form.triggerEvent( "#", "BeforeStep", "1" )
	end if
End Sub

'============================================================================

Sub Form_OnMsgBoxClose(sKeyName, sRet)
	sBIOTermOS = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	
	'20170202 HWG START - 유의사항 확인 미체크후 확인시, 스크롤 다운
	if sBIOTermOS = "1" then
		Container0.scroll_pos = "bottom"
	elseif sBIOTermOS == "2" then
		'20181010 LES START 컨테이너 스크롤 위치 조정
		Container0.scroll_pos = "0,174"		
	end if
	'20170202 HWG END
End Sub

'============================================================================
'20170202 HWG START - 유의사항 확인문구 클릭시, 체크상태 변경
Sub Container0_Label1_OnClick()
	if Container0.ChkButton0.chksilence == "0" then
		Container0.ChkButton0.checkstate = "1"
	else 
		Container0.ChkButton0.checkstate = "0"	
	end if
End Sub
'20170202 HWG END


