'============================================================================
' Form_OnFormInit() 
'============================================================================
Sub Form_OnFormInit() 

    DATAMANAGER.SetDataValue(0, "ohhts_1033_001r" , "InBlock1" , "FID_INPUT_ISCD", 0, g_szItemCode )
    DATAMANAGER.RequestTranData("ohhts_1033_001r")
  
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
' Form_OnFormInitBefore() 
'============================================================================
Sub Form_OnFormInitBefore()
	dim szListitem
	dim szLinkData
	
	szLinkData = Form.GetOpenLinkData( ) 

	if len(szLinkData)	>	0	then	
		szListitem = split(szLinkData,"★")
		
		g_szItemCode = szListitem(0)
		g_szItemName = szListitem(1)
	
		cmbMain0.clear = 1
		DATAMANAGER.RequestTranData("ohhts_0600_001r")	
	end if 
	

	'Form.ShowAlert("g_szItemName", g_szItemName)	
			
End Sub


'============================================================================
' cmbMain0_OnEditComplete() 
'============================================================================
Sub cmbMain0_OnEditComplete(iIndex)
    DATAMANAGER.SetDataValue(0, "ohhts_1033_001r" , "InBlock1" , "FID_INPUT_ISCD", 0, cmbMain0.cbkeydata)
    DATAMANAGER.RequestTranData("ohhts_1033_001r")
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData()
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim ncnt0600
	
	dim szkey
	dim szName
	dim szTargetCode
	
	
	ncnt0600 = DATAMANAGER.GetDataCount(0, "ohhts_0600_001r" , "OutBlock1")

	if szTranID = "ohhts_0600_001r" then 
		for i = 0 to ncnt0600 - 1
		  szkey = DATAMANAGER.GetDataValue(0, "ohhts_0600_001r", "OutBlock1", "FID_TMST_CODE", i )
		  szName =  DATAMANAGER.GetDataValue(0, "ohhts_0600_001r", "OutBlock1", "FID_TMST_NAME" , i) 	

		  cmbMain0.cbadddatatext = szkey & "`" & szName				  
		  
		  if szkey = g_szItemCode then
			  cmbMain0.cbkeydata = szkey
		  end if 
		Next	    
	end if 

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1033
	dim szRealCode
	
	ncnt1033 = DATAMANAGER.GetDataCount(0, "ohhts_1033_001r" , "OutBlock1")
	
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	if szTranID = "ohhts_1033_001r" then
		for i = 0 to ncnt1033 - 1
			szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1033_001r", "OutBlock1", "FID_STND_ISCD1", i)
			DATAMANAGER.SetDataValue(1,"ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD" , i, szRealCode)
		next
		
		DATAMANAGER.RequestRealData("ohhts_stck_incg")
	end if 
	'20230913_01 HWG END
End Sub

