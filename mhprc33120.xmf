'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가
' 03. 작    성 : 2017.04.30 LES
'-------------------------------------------------------------------------------------------

Dim g_szItemCode
Dim g_nfmTab
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

'============================================================================

Sub Form_OnFormInit()

	Dim szStyle
	szStyle	= Form.LoadConfigData("mhprc34000", "Style"	)	'현재가 스타일
		
	If szStyle = "0" Then
		linkfmHoga.linkfile = "mhprc34000_s2"
	ElseIf szStyle = "1" Then
		linkfmHoga.linkfile = "mhprc34000_s1"
	Else
		linkfmHoga.linkfile = "mhprc34000_s2"
	End If

	
	
	g_szItemCode = Form.getFutureCodeNight(0,"CM",true)
	lblItemCode.caption = g_szItemCode
	
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 	' 링크화면에 종목코드 던지기

End Sub



'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		lblItemCode.caption = sValue		
	End If
	
End Sub



	</SCRIPT_INFO>
</ROOT>