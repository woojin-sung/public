'============================================================================
'20230803 SWJ START 'v0001
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'보안매체 없음 팝업에서
	'모바일OTP 및 OTP 발급 후 인증까지 완료하고 여기를 통해 모바일OTP정보를 재조회함
	if Form.GetSharedData("CommonNoSecurity", true ) == "Y" then
		if sKey == "&CommonNoSecurity" and Cint(sValue) == 6 then
			Form.triggerEvent( "#" , "REFRESH_FROM_83200_T1", "" )
			'Form.ShowAlert( "Form_OnLinkData" , sKey&"-"&sValue)
		end if
	end if
End Sub
