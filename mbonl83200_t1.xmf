Sub contMain_cont0_btnOk0_OnClick()
	g_nIdx = 0
	'v0001 sta
	'모바일OTP 보안매체가 원장 기준으로는 있더라도
	'앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
	'Form.requestMOTP("MOTP_GETINFO"     , "" , "83200")     '등록된 OTP alias 존재하는지 확인 
	'껍데기 화면에서 에서 호출
	'v0001 fin
	dim szACNO, szASNO
	szACNO = left(acntMain.caption , 8)
		
	if szACNO == "" then
		Form.ShowAlert( "알림" , "신청 가능한 계좌가 없습니다.")
		Exit sub
	end if 
	DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	'DATAMANAGER.RequestTranData( "obibk_tbal_001r" )
	
End Sub
