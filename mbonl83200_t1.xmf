'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "GOTOLOGIN" Then
		if sRet == "ok" then
			Form.CloseForm()
			'if g_szData <> "1" Then
				Form.OpenScreen("90020" , "")
			'end if
		end if
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Dim szList
	
	if sEventName == "청약신청" then
		szList = Split(sParam , "★")
	elseif sEventName == "MOTP_GETINFO_RETURN_83200_FROM_MAINPAGE" then 'V0001
		g_motpAppYN = sParam
		'Form.ShowAlert( "알림" , g_motpAppYN)
		if g_motpAppYN = "00000" then '모바일OTP가 정상 발급되었을경우에만 처리.
			if g_nIdx == 0 then
				call contMain_cont0_btnOk0_OnClick()
			elseif g_nIdx == 1 then
				call contMain_cont1_btnOk1_OnClick()
			elseif g_nIdx == 2 then
				call contMain_cont2_btnOk2_OnClick()
			end if 
		end if
	end if
	
End Sub

