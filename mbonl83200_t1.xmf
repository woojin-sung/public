	<SCRIPT_INFO _len="17729" _ulen="16609" >
'============================================================================
' 01. 화 면 명 : 공개매수
' 02. 화면설명 : 공개매수
' 03. 작    성 : 2023. 06. 01. 정지환
' 2023-08-10 : 신극수 : v0001 : 공개매수 개선
'============================================================================
Dim g_szToday
Dim g_nIdx
Dim g_tData
g_tData = {}

'20230803 START v0001
Dim g_sJuminNum
Dim g_motpAppYN
Dim g_DeviceOS 
'20230803  END v0001
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_sJuminNum = Form.GetSharedData("&JUMIN_NUM", false) 'v0001
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	contMain.visible = false
	g_szToday = Form.GetSharedData("&HOST_DATE" , false)
	DATAMANAGER.RequestTranData( "obibk_thmn_002r" )
	
End Sub
'============================================================================
Sub Form_OnFormInitAfter()

End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	contMain.cont0.imgLogo0.SetMaintainingRatio("1")
	contMain.cont1.imgLogo1.SetMaintainingRatio("1")
	contMain.cont2.imgLogo2.SetMaintainingRatio("1")
	imgEmpty.setMaintainingRatio("1")
	contMain.cont0.imgPeriod0.setMaintainingRatio("1")
	contMain.cont1.imgPeriod1.setMaintainingRatio("1")
	contMain.cont2.imgPeriod2.setMaintainingRatio("1")
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obibk_thmn_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 			, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNCL_CLS_CODE" 	, 0 , "01" )
	elseif szTranID == "obibk_tbal_001r" then
		dim szACNO, szASNO
		dim tSplitData
		
		szACNO = left(acntMain.caption , 8)
		szASNO = right(acntMain.caption, 2)
		
		tSplitData = Split(g_tData(g_nIdx) , "★")
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"		 	, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 			, 0 , tSplitData(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TOB_SRNO" 		, 0 , tSplitData(2) )
	elseif szTranID == "obcsb_oimf_625r" then 'v0001
		Dim sDeviceID, sACNO, sACNO_PWD
		dim szACNO, szASNO
		dim tSplitData
		
		szACNO = left(acntMain.caption , 8)
		szASNO = right(acntMain.caption, 2)
		
		sDeviceID = Form.GetDeviceID()
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obibk_thmn_002r" then
		dim nCnt
		dim nBeforeDt
		nTop = 0
		
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
'		nCnt = 3
		if nCnt == 0 then
			contMain.visible = false
			lblEmpty.visible = true
			imgEmpty.visible = true
		else
			contMain.visible = true
			lblEmpty.visible = false
			imgEmpty.visible = false
			
			if nCnt == 2 then
				contMain.cont1.top = nTop
			end if
			if nCnt >= 3 then
				contMain.cont1.top = nTop
				contMain.cont2.top = 2 * nTop
				
				nCnt = 3
			end if
		end if
		
		For i = 0 to nCnt - 1
			
			dim szIcsd, szSrno, szStaDate, szFinDate, szKorNm, szPrc, szBuyNm, szCntt, szClsCode, szTrgIsnm, szDocuNm, szToday, szClsnYn
			
			szToday	 	= g_szToday
			szIcsd	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ISCD" 				, i )	'종목코드
			szSrno		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TOB_SRNO" 			, i )	'일련번호
			szStaDate 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "APLT_STA_DATE" 		, i )	'공개매수기간
			szFinDate 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "APLT_FIN_DATE" 		, i )	'공개매수기간
			szKorNm 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "KOR_ISSU_ABWR_NAME" 	, i )	'대상주식 = KOR_ISSU_ABWR_NAME + mid(iscd,2,6)
			szPrc 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "DMPR_PRC" 			, i )	'공개매수가격
			szBuyNm 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RQST_TRGT_INNM" 		, i )	'공개매수자
			szCntt 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CNTT" 				, i )	'경쟁률
			szClsCode	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PRVS_CLS_CODE" 		, i )	'공개매수방식
			szTrgIsnm 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TRGT_STCK_ISNM" 		, i )	'대상주식종목명
			szDocuNm 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "REF_DOCU_NAME" 		, i )	'이미지 URL
			szClsnYn 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CLSN_YN" 			, i )	'마감여부
			
'			szToday = "20220610"
			
			if szToday < szStaDate then
			
				Form.SetCtlProp("contMain.cont" & i & ".lblPrc" & i		, "visible", false)
				Form.SetCtlProp("contMain.cont" & i & ".lblPrcTtl" & i		, "visible", false)
				Form.SetCtlProp("contMain.cont" & i & ".lblCntt" & i		, "visible", false)
				Form.SetCtlProp("contMain.cont" & i & ".lblCnttTtl" & i	, "visible", false)
				Form.SetCtlProp("contMain.cont" & i & ".lblPrc" & i		, "visible", false)
				Form.SetCtlProp("contMain.cont" & i & ".lblPrcTtl" & i		, "visible", false)
				
				Form.SetCtlProp("contMain.cont" & i & ".lblComingSoon" & i	, "visible", true)
				
'				Form.SetCtlProp("contMain.cont" & i & ".btnDetail" & i		, "visible", false)
'				Form.SetCtlProp("contMain.cont" & i & ".btnOk" & i		, "visible", false)
				
				Form.SetCtlProp("contMain.cont" & i & ".lblBuyNm" & i		, "top", "199")
				Form.SetCtlProp("contMain.cont" & i & ".lblBuyNmTtl" & i	, "top", "199")
				
				Form.SetCtlProp("contMain.cont" & i & ".Image" & i		, "height", "220")
				
				Form.SetCtlProp("contMain.cont" & i , "top", nTop)
				
				nTop = nTop + 235
				
			else
				Form.SetCtlProp("contMain.cont" & i & ".lblPrc" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblPrcTtl" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblCntt" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblCnttTtl" & i	, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblPrc" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblPrcTtl" & i		, "visible", true)
				
				Form.SetCtlProp("contMain.cont" & i & ".lbl" & i			, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".imgPeriod" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblStaDt" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".lblFinDt" & i		, "visible", true)
				
				Form.SetCtlProp("contMain.cont" & i & ".btnDetail" & i		, "visible", true)
				Form.SetCtlProp("contMain.cont" & i & ".btnOk" & i		, "visible", true)
				
				if szClsnYn == "Y" then
					Form.SetCtlProp("contMain.cont" & i & ".imgPeriod" & i		, "imgpath", "img_progressbar_payment03.png")
					
					Form.SetCtlProp("contMain.cont" & i & ".lbl" & i			, "caption", "청약마감")
					Form.SetCtlProp("contMain.cont" & i & ".lbl" & i			, "left", "275")
					
				else
					Form.SetCtlProp("contMain.cont" & i & ".imgPeriod" & i		, "imgpath", "img_progressbar_payment02.png")
					
				end if
				
				Form.SetCtlProp("contMain.cont" & i , "top", nTop)
				
				nTop = nTop + 335
				
			end if
			
			
			nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
			if nType == "0" then
				szDocuNm = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"& szDocuNm
			elseif nType == "1" then
				szDocuNm = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"& szDocuNm
			end if
			
			
			szOsType 	= Form.GetSharedData("&OS_TYPE", False)  '1.안드로이드 2.iOS
			if szOsType == "1" then
				if i = 0 then
					contMain.cont0.imgLogo0.SetImageUrl(szDocuNm)
				elseif i = 1 then
					contMain.cont1.imgLogo1.SetImageUrl(szDocuNm)
				elseif i = 2 then
					contMain.cont2.imgLogo2.SetImageUrl(szDocuNm)
				end if
			elseif szOsType == "2" then
				Form.SetCtlProp("contMain.cont" & i & ".imgLogo" & i	, "imagetarget"	, "2")
				Form.SetCtlProp("contMain.cont" & i & ".imgLogo" & i	, "imgpath"		, szDocuNm)
			end if
			
			g_tData[i] = szClsCode & "★" & szIcsd & "★" & szSrno & "★" & szKorNm
			
			Form.SetCtlProp("contMain.cont" & i 						, "visible", true)
			
			Form.SetCtlProp("contMain.cont" & i & ".lblDate" & i		, "caption", szStaDate & szFinDate)
			Form.SetCtlProp("contMain.cont" & i & ".lblTrgIsnm" & i	, "caption", szTrgIsnm & " (" & mid(szIcsd,2,6) & ")" )
			Form.SetCtlProp("contMain.cont" & i & ".lblPrc" & i		, "caption", szPrc)
			Form.SetCtlProp("contMain.cont" & i & ".lblBuyNm" & i		, "caption", szBuyNm)
			Form.SetCtlProp("contMain.cont" & i & ".lblCntt" & i		, "caption", szCntt)
			
			Form.SetCtlProp("contMain.cont" & i & ".lblStaDt" & i		, "caption", mid(szStaDate,5,2)&"/"&right(szStaDate,2))
			Form.SetCtlProp("contMain.cont" & i & ".lblFinDt" & i		, "caption", mid(szFinDate,5,2)&"/"&right(szFinDate,2))
			
			Form.SetCtlProp("contMain.cont" & i & ".lblCntt" & i		, "caption", szCntt)

		next

		contMain.SetScrollAutoSize()
		
	elseif szTranID == "obibk_tbal_001r" then
		szPrhbYn	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PROS_PRHB_REAS_CLS_CODE"	, 0 )	'매수불가코드
		szPrhbCntt	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PROS_PRHB_DTL_CNTT" 		, 0 )	'매수불가내용
		
		if szPrhbYn == "1" then
			Form.MsgBox( "안내", szPrhbCntt, "", 6 )
		else
			Form.OpenPopup("mbonl83200_p2", g_tData(g_nIdx), "0")
		end if
	elseif szTranID == "obcsb_oimf_625r" then 'v0001
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "2"	
				'20230803 SWJ START : 보안매체없음 공통팝업 도입 'v0001
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				Form.OpenPopup("mhetc90190_p1", acntMain.total &"★"& g_sJuminNum &"★"& "N", "")
				exit sub
				'20230803 SWJ END
			Case "4"
				
				'20230803 SWJ START : 앱 재설치 하면 원장 정보와 앱 정보가 달라서  'v0001
				'앱에서 정보 호출했을 때 모바일OTP 정보 없으면 보안매체 없음 팝업  
				if g_motpAppYN <> "00000" then
					Form.OpenPopup( "mhetc90190_p1", acntMain.total &"★"& g_sJuminNum &"★"& "N", "")	'안내 팝업
					exit sub
				end if
				'20230803 SWJ END
		End Select
		DATAMANAGER.RequestTranData( "obibk_tbal_001r" )
	end if
End Sub
