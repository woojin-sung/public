'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
'Form.ShowAlert( "알림" , sEventName)
	if sEventName == "MOTP_GETINFO_RETURN_83200" then
		mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		if Ubound(mOTPInfo) < 1 then
			exit sub
		else	
			g_motpAppYN = mOTPInfo(0)
		end if
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	end if
End Sub
