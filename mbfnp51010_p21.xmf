<ROOT>
	<MAP_INFO scrno="51010" scrname="펀드매매_자동이체서비스신청팝업" version="2" writer="김철중" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgDim" autosize="1" imgpath="alpha128" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,457,375,190,1" />
		<LABEL name="lblTitle" fontsize="3" fontstyle="01" caption="자동이체 서비스 신청" halign="1" ly_vert="32,467,304,30,1" />
		<LABEL name="lblText" caption="자동이체 신청을 통해 매월 적립식으로 
편리하게 자동투자가 가능합니다." halign="1" multiline="1" ly_vert="20,497,335,90,1" />
		<BUTTON name="btnOk" caption="자동이체 등록" btnimage="btn_20.9.png" ly_vert="187,597,188,50,1" />
		<BUTTON name="btnCancel" caption="나중에 하기" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,597,187,50,1" />
		<TABLE name="tblLine" outlinecolor="038:255255255" insidelinecolor="102:255255255" colcount="1" rowcount="1" outline="1000" transmode="1" designorder="1" ly_vert="186,597,1,50,1" >
			<COL_INFO ly_vert_width="1" />
			<ROW_INFO ly_vert_height="50" />
