	<SCRIPT_INFO _len="2287" _ulen="2071" >

Dim g_szAcc
Dim g_szAsno
Dim g_szPswd
Dim g_szRegno
Dim g_szIscd
Dim g_szKorIsnm

'20240416
Dim g_btnOk
g_btnOk = false
'20240416
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")

		g_szAcc 			= tData[0]
		g_szAsno 		= tData[1]
		g_szPswd 		= tData[2]
		g_szRegno 		= tData[3]
		g_szIscd 		= tData[4]
		g_szKorIsnm 		= tData[5]
	end if
End Sub

'============================================================================
Sub btnOk_OnClick()
	Dim szEncpwd
	
	'v002
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1: 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	'MTS메모리평문 적용상태일 때
	if plain_rm == "1" then
		szEncpwd	=	g_szPswd
	'MTS메모리평문 미적용상태 일 때
	else
		szEncpwd	=	Form.GetEncData(g_szPswd)
	end if		
	
	'자동이체등록	'계좌번호 ★ 일련번호 ★ 비밀번호 ★ 잔고번호 ★ 펀드코드
	'Form.'OpenFramePopup("mbfnp51020_p3" , g_szAcc & "★" & g_szAsno & "★" &  szEncpwd & "★" & g_szRegno & "★" & g_szIscd, sPosInfo) 'v001 펀드코드 추가
		'Form.OpenPopup("mbfnp51020_p3" , g_szAcc & "★" & g_szAsno & "★" &  szEncpwd & "★" & g_szRegno & "★" & g_szIscd, sPosInfo) 'v001 펀드코드 추가
		'Form.OpenPopup("mbfnp51020_p3" , g_szAcc & "★" & g_szAsno & "★" & g_szRegno & "★" & g_szIscd & "★" & g_szKorIsnm, sPosInfo) 'v001 펀드코드 추가
	
	'20240416
	g_btnOk = True
	Form.CloseForm()
	'20240416
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'20240416
	if g_btnOk = True then
		Form.OpenPopup("mbfnp51020_p3" , g_szAcc & "★" & g_szAsno & "★" & g_szRegno & "★" & g_szIscd & "★" & g_szKorIsnm, sPosInfo) 'v001 펀드코드 추가
	end if
	'20240416
	
	Form.SendReturnToParent("mbfnp51010_p21", "close")
End Sub

'============================================================================
Sub imgDim_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>