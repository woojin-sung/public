	<SCRIPT_INFO _len="27041" _ulen="24929" >
'============================================================================
' 01.화면명 	: 시장종합
' 02.화면설명	: 시장종합_메인화면
' 03.작성	: 2016.01.04
'============================================================================
'20210916 SWJ START : 시장종합 화면 개편
'20230208 HSZ START : 시장종합 화면 개편 Table0->Table1
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

dim g_szInputFile		'읽어들일리스트세팅파일
dim g_szFileName		'지수, 환율, 금리, 상품 세부화일
dim g_szKeys			'읽어들일키값
dim g_szValues		'읽어들인세팅값
dim g_szLinkNames		'링크이름들
dim g_nTotalSize
dim g_szOrgList		'전체리스트순서및값
dim g_nInitTopSize	'맨위 사이즈 - 20210303 HSZ 배너추가
dim g_LoginType

'파일에 저장된 KEY값
'g_szKeys		=	Array(	"41000P2_TILE6ROW", "41000P2_INVR", "41000P2_PROG", "41000P2_CHNG", 
'						"41000P2_PROD"  , "41000P2_RATE" )	20230208 HSZ 주석처리
g_szKeys		=	Array(	"41020_EVENT", "41020_INDEX", "41020_NEWS", "41020_HISTORY", 
						"41020_MYNEWS"  , "41020_RANKING", "41020_NOTICE", "41020_LINK" )
						
'실제 링크폼명
g_szLinkNames 	=	Array(	"cont01.linkfm1Tile6row"	,	"cont01.linkfm2Invr"		,	"cont01.linkfm3Prog"		,  "cont01.linkfm4Chng",	
						"cont01.linkfm5Prod"		,	"cont01.linkfm6Rate" 	,	"cont01.linkfm1Tile"	)
						
'20210916 SWJ START
dim g_szKeyNames
g_szKeyNames		=	Array("41000_KOSPI200", "41000_FUTURE", "41000_YENEURO", "41000_CD",
						  "41000_NASDAQ", "41000_GOLD", "41000_YENDOLLAR", "41000_WONYEN",
						  "41000_WONDOLLAR", "41000_NIKKEI", "41000_KOSDAQ", "41000_DOW", "41000_HONGKONG", "41000_SHANGHAI", "41000_WONWIAN", "41000_COMBOND",
						  "41000_KOSPI", "41000_DUBAI", "41000_SP500", "41000_CNTBOND", "41000_WTI", "41000_BRENT"  )
dim g_szVCnt
g_szVCnt = 0
'20210916 SWJ END

'190 79 222 250 233 250 190
'20230208 HSZ START: 시장종합 개편
'g_szInputFile	= "41000P2ITEMS.ini"	
'g_szFileName	= "41000ITEMS.ini"
g_szInputFile	= "41020ITEMS.ini"	
g_szFileName	= "41000V2ITEMS.ini"
'20230208 HSZ END
dim g_nNameCol, g_nTopCol, g_nHeightCol, g_sValCol, g_sKeyCol
g_nNameCol 	= 0 '테이블 내 linkform 이름
g_nTopCol 	= 1 '테이블 내 Top Value
g_nHeightCol	= 2 '테이블 내 Height Value
g_nValCol 	= 3 '테이블 내 Visible Value
g_nKeyCol	= 4 '테이블 내 key Value

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'reassignItems:	 변경된 값으로 재 할당
'============================================================================
Function	reassignItems(inList)

	dim szRefreshKeys()
	dim nListCnt
	
'	dim nInitTopSize	'맨위 사이즈
	dim nTopval		'Top 값
	dim nPreHeight	'전아이템의 높이값
	dim nInterSize 	'중간 사이즈
	dim nItemIdx		'삽입될아이템순서

'	'nInitTopSize 	= 10
'	nInitTopSize	=	4
	nTopval 	   	= 0
	'nInterSize   	= 5 
	nInterSize   	= 0
	szItemIdx  	= 0 
	nPreHeight		= 0
	
	nListCnt	= getListItem(inList,0)		'리턴값으로 처리

	For i = 0 to nListCnt -1 
		szRefreshKeys(i)	=	getListItem(inList,(i*2)+1)
	next
	
	'1. TOP 값 초기화 
	For i = 0 to UBound(g_szKeys)
		cont01.Table1.SetCellString(i+1, 1, -1)
	Next 
	
	'2. '재정렬된 값중에서 해당하는 값만 세팅							
	For i = 0 to nListCnt -1 
		For	j = 0 to UBound(g_szKeys)					
			if	szRefreshKeys(i)	=	g_szKeys (j)	then
			
				if szItemIdx = 0	then								'첫 아이템 Init
					nTopval = g_nInitTopSize
					nPreHeight = cont01.Table1.GetCellString(j+1, 2)
				elseif szItemIdx = 1	then
					nTopval = nTopval + nPreHeight + 4					
				else 
					nTopval = nTopval + nPreHeight + nInterSize			'Top 값 계산
				end if 
						
				cont01.Table1.SetCellString(j+1, 1, nTopval)
				szItemIdx = szItemIdx + 1 								'아이템 카운트 증가
						
				nPreHeight = cont01.Table1.GetCellString(j+1, 2)
				
			end if 
		next
	next

end function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function LoadSettings()
'	dim szVal
''	dim nInitTopSize	'맨위 사이즈
	dim nInterSize 		'중간 사이즈
	dim nItemIdx		'삽입될아이템순서
	dim nTopval		'Top 값
	dim nPreHeight		'전아이템의 높이값
	dim nOnOff			'사용여부
'	dim szSect			'구분값
	
	
'	'nInitTopSize 	= 10
'	nInitTopSize	=	4
	nInterSize   	= 5
	nInterSize   	= 0
	szItemIdx  	= 0 
	nTopval 	   	= 0
	
	'20240304 상단 HOME 타이틀 및 통합검색 영역 제거로 인한 최초 top 값 조정
'	nPreHeight	= 45
	nPreHeight	= 0
	
	
'	g_szValues = Array()
	
	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
	
	dim szLoadData
	dim szRefreshKeys()
	
'	szLoadData = Form.LoadConfigData(g_szInputFile, "41000P2_LISTITEMS")
	szLoadData = Form.LoadConfigData(g_szInputFile, "41020_LISTITEMS")		'202302 	HSZ
	
	'LOAD 데이터가 없을 경우 초기 값 SET
	if szLoadData == "" or szLoadData == null then
		Dim nKeyCount
		nKeyCount = UBound(g_szKeys) - LBound(g_szKeys) + 1
		szLoadData = nKeyCount 
		
		for i = 0 to  nKeyCount - 1
			dim sKeys, sValue
			sKeys = g_szKeys(i)
			sValue = "1"
			szLoadData = szLoadData & "★" & sKeys & "★" & sValue
		next
		
'		Form.SaveConfigData(g_szInputFile, "41000P2_LISTITEMS", szLoadData)
		Form.SaveConfigData(g_szInputFile, "41020_LISTITEMS", szLoadData)	'202302 HSZ
	end if
	
	nListCnt	= getListItem(szLoadData,0)	'리턴값으로 처리
	
	'Table에 Data SET
	dim nTableRow
	nTableRow = CInt(cont01.Table1.rowcount)
	
	'Table visible 값 초기화 
	For k = 0 to nTableRow - 1
		cont01.Table1.SetCellString(k+1, g_nValCol, 0 ) 'Visible 초기화
	Next 
	
	if szLoadData <> "" and szLoadData <> null then
		For i = 0 to nListCnt -1
			Dim szTempData
			szTempData = getListItem(szLoadData,(i*2)+1)
			
			if szTempData <> "" then
				szRefreshKeys(i) = szTempData
				
				for j=0 to nTableRow - 1 
					dim szTableKey
					szTableKey = cont01.Table1.GetCellString( j, g_nKeyCol )
					
					if szTempData == szTableKey then
						cont01.Table1.SetCellString( j, g_nValCol, "1" )
					end if
				next
			end if
			
		Next
	end if
	
	'배너 표시 옵션 추가?
'	nOnOff = 1
	nOnOff = 0	'202302 HSZ 
	Dim nBanner_Idx, nBanner_H '배너위치, 배너창 높이
	nBanner_Idx = 2 '추후 배너 위치를 바꿀 시 해당 변수 값을 변경
	nBanner_H = CInt(cont01.Table1.GetCellString( 2, g_nHeightCol ))
	
	Dim nTableRow
	nTableRow = CInt(cont01.Table1.rowcount)
	
	'Table Top 값 초기화 
	For k = 0 to nTableRow - 1
		cont01.Table1.SetCellString(k+1, g_nTopCol, -1) 'Top 초기화
	Next 
	
	For i = 0 to nListCnt -1
		if nOnOff == 1 then ' 배너 표시 위치 순번
			if nBanner_Idx == i+1 then
				cont01.Table1.SetCellString(2, g_nTopCol, nPreHeight)
				cont01.Table1.SetCellString(2, g_nValCol, "1" )
				nPreHeight = nPreHeight + nBanner_H + nInterSize
			end if
		end if
		
		For	j = 0 to nTableRow-1
			dim szTableKey
			szTableKey = cont01.Table1.GetCellString( j, g_nKeyCol )
			
			'테이블 키 값과 비교 후 높이 SET
			if szRefreshKeys(i) ==  szTableKey then
				cont01.Table1.SetCellString(j, 1, nPreHeight )
				nPreHeight = nPreHeight + CInt(cont01.Table1.GetCellString(j, g_nHeightCol)) + nInterSize
			end if
		next
	next
	
	'20211005 아이티젠(김성수) END
	
'	'1. TOP 값 초기화 
'	For i = 0 to UBound(g_szKeys)
'		cont01.Table0.SetCellString(i+1, 1, -1)
'	Next 
'	
'	
'	'2. 세팅파일값을 테이블에 LOAD
'	For i = 0 to UBound(g_szKeys)
'		
'		szVal = Form.LoadConfigData(g_szInputFile, g_szKeys(i))			'파일에서 value 읽어들임				
'		cont01.Table0.SetCellString(i+1, 3, szVal)
'		
'		if szVal = "1"  then	   					'on 일때 top 높이계산 함
'				if szItemIdx = 0	then								'첫 아이템 Init
'					nTopval = 45'g_nInitTopSize
'					nPreHeight = CInt(cont01.Table0.GetCellString(i+1, 2))
'				elseif szItemIdx = 1	then
'					nTopval = nTopval + nPreHeight + 4
