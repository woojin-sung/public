'============================================================================



'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName	=	"SCREEN_MENU"		then
			
		if	trim(sParam)	==	"MARKET_SET"	then
			Form.OpenFramePopup("mhidx41000_p1" , sOpenData , sPosInfo)
		end	if
		if	trim(sParam)	==	"MARKET_ADD"	then
			Form.OpenFramePopup("mhidx41000_p2" , sOpenData , sPosInfo)
		end	if
		
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	
	
	elseif sEventName = "BANNER_DELETE" then
		g_nInitTopSize = 4
		cont01.linkfm0Banner.visible = false
		Form_OnFormInit()
		
	elseif sEventName = "HOME_SCROLL" then	'	202302 HSZ : 더보기 누른 경우, 현재 스크롤 위치 저장
		
		'20230227 LES
		szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
		
		if szDeviceOS == "2" then
			szPos = cont01.scroll_pos * 0.88
			Form.SetSharedData("HOME_SCROLL" , szPos)
		else
			szPos = cont01.scroll_pos
			Form.SetSharedData("HOME_SCROLL" , szPos)
		end if
		
		
		
	end if
End Sub


'============================================================================
'Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if	sKey	=	"&LOGIN"	then				'로그인전에는 실시간 못던지는 문제때문에 추가
		if	sValue	=	"login"	then

			Form_OnFormInit()
		end	if
	end	if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()

	cont01.cont02.imgSetting.setMaintainingRatio("1")	'202302 HSZ
	cont01.icnSearch.setMaintainingRatio("1")	'202302 HSZ
	
	'------------------------------------------------------------------
	' 20190814 HWG START : MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단
	
	'------------------------------------------------------------------
	
'20160427 LKM START - 코치마크 	(추후 반영)
'	Dim szPopup
'	szPopup = Form.LoadConfigData( "mhidx41000", "mhidx41000_p4" )
'	 
'	If szPopup <> "1" Then
'		Form.OpenPopup( "mhidx41000_p4", "" , "")
'	End If

'20160427 LKM END

'20210302 HSZ START: 상단 배너 추가
	Dim saveDate
	Dim calcDate
	saveDate = Form.LoadConfigData("BannerSetting", "banner_210906") 	'20210818 SWJ START : 키값명 변경
	todayDate = Form.GetSharedData("&HOST_DATE",0)
	
	if saveDate <> "" then
		
		ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
		RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
		
		calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))

		if calcDate <= 7 then
			g_nInitTopSize = 4 
			cont01.linkfm0Banner.visible = false 
		else
			g_nInitTopSize	=	107'149 
			cont01.linkfm0Banner.visible = true 
		end if
	else
		g_nInitTopSize	=	107'149 
		cont01.linkfm0Banner.visible = true
	end if
'20210302 HSZ END

End Sub

