	<SCRIPT_INFO _len="7088" _ulen="6904" >
Dim g_RplyDate
Dim g_szList

'============================================================================
Sub Form_OnFormInit()
	
	Dim sSendData
	'계좌번호★계좌일련번호★계좌비밀번호★신청일련번호
	sSendData = Form.GetOpenLinkData()
	g_szList = Split(sSendData,"★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	DATAMANAGER.RequestTranData("obsap_smpr_009r")

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsap_smpr_009r" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "2" 		)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "ACNO" 			, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "ASNO" 			, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "SMPR_APLT_SRNO" 	, 0 , g_szList(3) )
	
	ElseIf szTranID == "obcpp_bsdy_006r" Then
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CLND_CLS_CODE" 	, 0 , "C001"			)
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "MANG_DATE" 		, 0 , g_RplyDate)
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CALC_DYNU" 		, 0 , "1"			)
	ElseIf szTranID == "obcpp_bsdy_006r_1" Then
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_1", "InBlock1", "CLND_CLS_CODE" 	, 0 , "C003"			)
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_1", "InBlock1", "MANG_DATE" 		, 0 , Container0.Calendar0.caption	)
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_1", "InBlock1", "CALC_DYNU" 		, 0 , "1"			)
	ElseIf szTranID == "obcpp_bsdy_006r_2" Then
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_2", "InBlock1", "CLND_CLS_CODE" 	, 0 , "C003"			)
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_2", "InBlock1", "MANG_DATE" 		, 0 , Container0.Calendar0.caption	)
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_2", "InBlock1", "CALC_DYNU" 		, 0 , "2"			)
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obsap_smpr_009r" Then
	
		Container0.Table0.SetCellString(4, 1, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock1", "INVT_AMT" , 0))
'		DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock1", "BYOV_ANTC_INVT_AMT" , 0)
'		DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock1", "SELN_ANTC_INVT_AMT" , 0)
		
		' LONG
		Container0.Table0.SetCellString(1, 0, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "KOR_ISNM"      , 0))
		Container0.Table0.SetCellString(2, 0, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "KOR_ISNM"      , 1))
		Container0.Table0.SetCellString(1, 1, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "TRTH_CALC_QTY" , 0))
		Container0.Table0.SetCellString(2, 1, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "TRTH_CALC_QTY" , 1))
		
		Container0.Table1.SetCellString(0, 2, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "KOR_ISNM"      , 0))
		Container0.Table1.SetCellString(1, 2, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "KOR_ISNM"      , 1))
		Container0.Table1.SetCellString(0, 3, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "TRTH_CALC_QTY" , 0))
		Container0.Table1.SetCellString(1, 3, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock2", "TRTH_CALC_QTY" , 1))
		
		' SHORT
		Container0.Table0.SetCellString(1, 2, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "KOR_ISNM"      , 0))
		Container0.Table0.SetCellString(2, 2, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "KOR_ISNM"      , 1))
		Container0.Table0.SetCellString(1, 3, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "TRTH_CALC_QTY" , 0))
		Container0.Table0.SetCellString(2, 3, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "TRTH_CALC_QTY" , 1))
		
		Container0.Table1.SetCellString(7, 2, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "KOR_ISNM"      , 0))
		Container0.Table1.SetCellString(8, 2, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "KOR_ISNM"      , 1))
		Container0.Table1.SetCellString(7, 3, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "TRTH_CALC_QTY" , 0))
		Container0.Table1.SetCellString(8, 3, DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "TRTH_CALC_QTY" , 1))
		
		
		Container0.Label5.caption = CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "DBCR_FERT" , 0))& "%"
		If Len(DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "DBCR_FERT" , 1)) <> 0 Then
			Container0.Label5.caption = Container0.Label5.caption &"/"& CDbl(DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "DBCR_FERT" , 1))& "%"
		End If
		
		'Label5.caption = INT(DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "DBCR_FEE" , 0) + DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock3", "DBCR_FEE" , 1))
		
		g_RplyDate = DATAMANAGER.GetDataValue(0, "obsap_smpr_009r", "OutBlock1", "RPLY_DATE" , 0)
		
		DATAMANAGER.RequestTranData("obcpp_bsdy_006r")
		DATAMANAGER.RequestTranData("obcpp_bsdy_006r_1")
		DATAMANAGER.RequestTranData("obcpp_bsdy_006r_2")
		
	ElseIf szTranID == "obcpp_bsdy_006r" Then
		Container0.Label6.caption = DATAMANAGER.GetDataValue(0, "obcpp_bsdy_006r", "OutBlock1", "MANG_DATE" , 0)
		
	ElseIf szTranID == "obcpp_bsdy_006r_1" Then
		Dim s_tmp1, s_tmp2, s_tmp3, s_tmp4, s_tmp5, s_tmp6, s_tmp7
		
		s_tmp1 = trim(DATAMANAGER.GetDataValue(0, "obcpp_bsdy_006r_1", "OutBlock1", "MANG_DATE" , 0))
		
		s_tmp2 = left(s_tmp1,4)
		s_tmp3 = Mid(s_tmp1,5,2)
		s_tmp4 = Right(s_tmp1,2)
		s_tmp5 = s_tmp2 +"-"+ s_tmp3 +"-"+ s_tmp4
		
		s_tmp6 = "매수체결가격은 한국시간 " + s_tmp5 + "일 VWAP ×(1+0.6%)"
		s_tmp7 = "매도체결가격은 한국시간 " + s_tmp5 + "일 VWAP ×(1-0.6%)"
		
		Container0.Table1.SetCellString(2, 0, s_tmp6)
		Container0.Table1.SetCellString(8, 0, s_tmp7)
			
	ElseIf szTranID == "obcpp_bsdy_006r_2" Then
	
	End If
End Sub

'============================================================================
Sub Container0_Button0_OnClick()
	'계좌번호★계좌일련번호★계좌비밀번호★스마트프로신청일련번호★청약금액
	Form.OpenFramePopup( "mbfnp55001_p2" ,g_szList(0) &"★"&  g_szList(1) &"★"& g_szList(2) &"★"& g_szList(3) &"★"& Container0.Table0.GetCellString(4, 1) , ""  ) 
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")

End Sub
'============================================================================
Sub Container0_Button1_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
