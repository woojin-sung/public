	<SCRIPT_INFO _len="1177" _ulen="1119" >
'============================================================================
'채권 세미팝업 화면에서 쓰는 화면메뉴 팝업
'============================================================================
Sub Form_OnFormInit()
	szScr = Form.GetSharedData("&SCREEN_NO", FALSE )
	if szScr = "54020" then	'주문화면에서는 SNS공유 삭제
'		TblQuick.rowcount = 2
		TblQuick.height = 80
		imgQuick.height = 80
	end if
End Sub
'============================================================================
Sub TblQuick_OnClick(lRow , lColumn)
	Select Case CInt(lRow)
	Case 0
		Form.OpenScreen("54000" , "")
	Case 1 
		Form.OpenPopup("mhprc54000_p5" , "popup" , "")
	Case 2
'		Form.OpenDialog("sharesns" , "1", "")
		Form.SendReturnToParent("SCREEN_MENU" , "SHA_SNS")
		Form.CloseForm()
	End Select
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "snsshare" Then
		Form.SendReturnToParent("sharedata" , sRet)
	End If
End Sub

	</SCRIPT_INFO>
</ROOT>