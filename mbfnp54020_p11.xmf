	<CONTROL_INFO>
		<IMAGE name="imgBg" autosize="1" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgQuick" autosize="1" imgpath="bg_quick.9" ly_vert="175,35,200,120,1" />
		<TABLE name="TblQuick" insidelinecolor="102:255255255" colcount="1" rowcount="3" outline="0000" transmode="1" designorder="1" ly_vert="175,35,200,120,1" >
			<COL_INFO ly_vert_width="200" />
			<ROW_INFO ly_vert_height="40,40,40" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" fgcolor="062:255255255" bgcolor="016:255255255" halign="0" line="0,0" caption=" 장내채권 찾기" impidxs="" />
				<CELL cell_ly="0,1,0,1" fgcolor="062:255255255" bgcolor="016:255255255" halign="0" line="0,0" caption=" 예상수익 보기" impidxs="" />
				<CELL cell_ly="0,2,0,2" fgcolor="062:255255255" bgcolor="016:255255255" halign="0" line="0,0" caption=" SNS 공유" impidxs="" />
