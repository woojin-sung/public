'============================================================================
' 01. 화 면 명 : 발행어음매매_조회/취소
' 02. 화면설명 : 발행어음매매_조회/취소
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData					'탭화면에서 받아온 계좌 및 비밀번호
Dim g_szList					'
Dim g_szPW					'비밀번호
Dim g_nRowIndex				'선택한 행 Index값
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' GoOrder() : 취소처리
'============================================================================
Function GoOrder()
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_212a", "InBlock1", "ACNO" , 0 , g_szList(0) )		'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_212a", "InBlock1", "ASNO" , 0 , g_szList(1) )		'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_212a", "InBlock1", "PWD" , 0 , g_szPW )				'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_212a", "InBlock1", "TR_DATE" , 0 , grd0.GetCellData( "bd_cell5" , g_nRowIndex) )'거래일자
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_212a", "InBlock1", "TRAN_SRNO" , 0 , grd0.GetCellData( "bd_cell6" , g_nRowIndex) )'거래내열일련번호
	
	DATAMANAGER.RequestTranData( "obsan_deal_212a" )
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbfnp52000" then
		If sParam = "" Or sParam = null Then
			Exit Sub
		End If	
	
		g_szData = sParam
	end if
	
	g_szList = Split( g_szData, "★" )
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	g_szPW = Form.GetEncData( g_szList(2) )			'비밀번호 암호화
	
	DATAMANAGER.RequestTranData( "obsan_deal_223r" )
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsan_deal_223r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "ACNO" , 0 , g_szList(0) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "ASNO" , 0 , g_szList(1) )		'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "PWD" , 0 , g_szPW )		'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "APLT_STA_DATE" , 0 , cldStart.caption )	'시작일자
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "APLT_FIN_DATE" , 0 , cldFinal.caption )	'마감일자
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "DEAL_CLS_CODE" , 0 , "%" )		'%:전체, 1:매도, 2:매수
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_223r", "InBlock1", "CNCL_YN" , 0 , "%" )			'%:전체, N:정상, Y:취소
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obsan_deal_223r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obsan_deal_223r", "OutBlock1") - 1	'매매구분
			if DATAMANAGER.GetDataValue( 0 , "obsan_deal_223r", "OutBlock1", "DEAL_CLS_CODE" , i) == "1" then
				grd0.SetCellData( "bd_cell1" , i, "매도")
				grd0.SetCellFgColor( "bd_cell1" , i, "7" )
			elseif DATAMANAGER.GetDataValue( 0 , "obsan_deal_223r", "OutBlock1", "DEAL_CLS_CODE" , i) == "2" then
				grd0.SetCellData( "bd_cell1" , i, "매수")
				grd0.SetCellFgColor( "bd_cell1" , i, "6" )
			end if
		
			if DATAMANAGER.GetDataValue( 0 , "obsan_deal_223r", "OutBlock1", "CNCL_YN" , i) == "Y" then	'취소구분
				grd0.SetCellData( "bd_cell4" , i, "취소")
			elseif DATAMANAGER.GetDataValue( 0 , "obsan_deal_223r", "OutBlock1", "CNCL_YN" , i) == "N" then
				grd0.SetCellData( "bd_cell4" , i, "정상")
			end if
			
			grd0.SetCellData( "bd_cell0" , i, "취소")
			'grd0.SetCellFgColor( "bd_cell0" , i , "62")
			
			if DATAMANAGER.GetDataValue( 0 , "obsan_deal_223r", "OutBlock1", "CNCL_ABLE_YN" , i) == "Y" then	'취소신청
				grd0.SetCellEnable( "bd_cell0" , i, True)
			else
				grd0.SetCellEnable( "bd_cell0" , i, False)
			end if
		next
	elseif szTranID == "obsan_deal_212a" then
		Form.ShowAlert( "알림" , "취소처리가 완료되었습니다." )
		DATAMANAGER.RequestTranData( "obsan_deal_223r" )
	end if
	
End Sub
'============================================================================
' cldStart_OnEditComplete()
'============================================================================
Sub cldStart_OnEditComplete()
	DATAMANAGER.RequestTranData( "obsan_deal_223r" )
End Sub
'============================================================================
' cldFinal_OnEditComplete()
'============================================================================
Sub cldFinal_OnEditComplete()
	DATAMANAGER.RequestTranData( "obsan_deal_223r" )
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	'신청일자, 거래번호, 종목명, 매매구분, 매수금액, 발행금액, 발행이율, 약정기간
	szData = grd0.GetCellData( "bd_cell5", lRow) & "★" & grd0.GetCellData( "bd_cell6", lRow) & "★" &  grd0.GetCellData( "bd_cell10", lRow) & "★" & 
	grd0.GetCellData( "bd_cell1", lRow) & "★" & grd0.GetCellData( "bd_cell7", lRow) & "★" & grd0.GetCellData( "bd_cell2", lRow) & "★" & 
	grd0.GetCellData( "bd_cell9", lRow) & "★" & grd0.GetCellData( "bd_cell3", lRow)
	
	if szCellID == "bd_cell0" then
		if g_szPW == "" or g_szPW == Null or Form.GetCtlProp("#edtPW", "caption") == "" then
			Form.ShowAlert( "알림", "비밀번호를 입력하세요.")
			Exit Sub
		else
			Form.OpenPopup( "mbfnp52000_p5" , szData , sPosInfo)			'취소확인 팝업
			g_nRowIndex = lRow
		end if
	end if
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) : 공인인증후 취소처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "Ok" then
		Call GoOrder()				'Test용
'		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)			'공인인증
'	elseif sKeyName == "mhetc90060_p5" then
'		if sRet ~= "cancel" then
'			'취소주문
'			Call GoOrder()
'		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obsan_deal_212a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")" )
	end if
	
End Sub

	</SCRIPT_INFO>
