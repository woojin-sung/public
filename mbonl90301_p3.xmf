'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData, iDataCnt, iAmtSum, iHeight
	
	if szTranID == "obsab_deal_605r" then		
		g_iDataCount = contMain.gridData.rowcount
		
		iDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" ))
		
		for i = 0 to iDataCnt - 1
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_TRGT_CLS_CODE",		i)	'처리대상구분코드
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO",					i)   '계좌번호
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO",					i)   '계좌일련번호
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_INPR_NAME",				i)   'UI개별상품명
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CUST_FULL_NAME",			i)   '고객풀명
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",					i)   '종목코드
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_DATE",				i)   '매수일자
			szTemp8  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_QTY",				i)   '잔고수량
			szTemp9  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYNG_AMT",				i)   '매입금액
			szTemp10 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_AMT",				i)   '평가금액
			szTemp11 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYNG_UNPR",				i)   '매입단가
			szTemp12 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_ERT",				i)   '매수수익률
			szTemp13 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_NAME",			i)   '채권분류명
			szTemp14 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM",					i)   '종목명
			szTemp15 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE",				i)   '만기일자
			szTemp16 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_PRLS_AMT",			i)   '평가손익금액
			szTemp17 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_OWN_TYPE_NAME",		i)   '잔고소유유형명
			szTemp18 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "VLTN_UNPR",				i)   '평가단가
			szTemp19 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_AMT",				i)   '대출금액
			szTemp20 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_DATE",				i)   '대출일자
			szTemp21 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_MTRT_DATE",			i)   '대출만기일자
			szTemp22 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PSNT_PRC",				i)   '현재가격
			szTemp23 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRDY_VRSS",				i)   '전일대비
			szTemp24 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RLTM_PRDY_VRSS_SIGN",		i)   '실시간전일대비부호
			szTemp25 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OVRL_SPTX_CLS_CODE",		i)   '종합분리과세구분코드
			szTemp26 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "IQRY_CSNU",				i)   '조회건수

			contMain.gridData.AddRow()	
			
			contMain.gridData.SetCellData("bd_date1",	g_iDataCount + i, "매수일")
			contMain.gridData.SetCellData("bd_date2",	g_iDataCount + i, szTemp7)
			
			contMain.gridData.SetCellData("bd_evalAmt1",	g_iDataCount + i, "평가금액")
			contMain.gridData.SetCellData("bd_evalAmt2",	g_iDataCount + i, szTemp10)
			
			contMain.gridData.SetCellData("bd_qty1",		g_iDataCount + i, "수량(천원)")
			contMain.gridData.SetCellData("bd_qty2",		g_iDataCount + i, CInt(szTemp8) / 1000)
			
			contMain.gridData.SetCellData("bd_buyAmt1",	g_iDataCount + i, "매입금액")
			contMain.gridData.SetCellData("bd_buyAmt2",	g_iDataCount + i, szTemp9)
			
			contMain.gridData.SetCellData("bd_rate1",	g_iDataCount + i, "만기수익률")
			contMain.gridData.SetCellData("bd_rate2",	g_iDataCount + i, szTemp12)
			
			contMain.gridData.SetCellData("bd_buyPrice1",	g_iDataCount + i, "매입단가")
			contMain.gridData.SetCellData("bd_buyPrice2",	g_iDataCount + i, szTemp11)
			
			contMain.gridData.SetCellData("bd_sell", 	g_iDataCount + i, "채권매도")
			contMain.gridData.SetCellImage("bd_sell", 	g_iDataCount + i, "btn_31_n.9.png")
			
			
			contMain.gridData.SetCellData("BYOV_DATE",	g_iDataCount + i, szTemp7 ) '매수일자
			contMain.gridData.SetCellData("RMND_QTY",	g_iDataCount + i, szTemp8 ) '잔고수량
			contMain.gridData.SetCellData("ISCD",		g_iDataCount + i, szTemp6 ) '종목코드
			contMain.gridData.SetCellData("OVRL_SPTX_CLS_CODE",	g_iDataCount + i, szTemp25 ) '종합분리과세구분코드			
		next                                                                             
		
		g_iDataCount = g_iDataCount + iDataCnt
		contMain.gridData.rowcount = g_iDataCount
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			'다음 조회 요청
			DATAMANAGER.RequestNextData(szTranID)
			
		else
			iHeight = (141 * g_iDataCount) + 15
			
			if iHeight < 378 then
				contMain.gridData.height = 378
				contMain.imgBG.height = 532
			else
				contMain.gridData.height = iHeight
				contMain.imgBG.height = iHeight + 155
			end if

			
			contMain.SetScrollAutoSize()
		
		end if
		
	end if
	
End Sub

