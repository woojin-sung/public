	<SCRIPT_INFO _len="12052" _ulen="11108" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 목록 조회
' 02. 화면설명 : 장외채권 상품 목록 간단필터 팝업
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------
'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szList
Dim g_iDataCount
Dim g_iSelectedRow

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'채권 매도 화면 팝업
Sub f_callBondOrder()
	Dim szData, szLinkData, szCode, iRow
	
	iRow = CInt(g_iSelectedRow)
	
	szData = contMain.gridData.GetCellData("BYOV_DATE", iRow)
'	Form.ShowAlert("f_callBondOrder", szData)	
	
	if szData <> "00000000" then
		'장내채권 매도 화면으로 이동
		szLinkData = "채권잔고" & "★" &	'0 채권매도
				    "1"					'1 매도탭
				    
		szCode = contMain.gridData.GetCellData("ISCD",		iRow)
		szLinkData = szLinkData & "★" & szCode	'2 종목코드
		
		'3 시장구분
		szData = Form.GetItemCodeInfo(szCode, "innermarket")
		if szData == "020" then
			szLinkData = szLinkData & "★" & "B"		'장내
		elseif szData == "019" then
			szLinkData = szLinkData & "★" & "SB"	'소액
		elseif Trim(szData) == "" then
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
						
			Exit Sub
		end if 
		
		szLinkData = szLinkData & "★" & CInt(contMain.gridData.GetCellData("RMND_QTY",	iRow)) / 1000	'4 잔고수량
		szLinkData = szLinkData & "★" & contMain.gridData.GetCellData("BYOV_DATE",	iRow)	'5 매수일자
		
		'6 매수구분(종합과세/분리과세)코드
		szData = contMain.gridData.GetCellData("OVRL_SPTX_CLS_CODE",	iRow)
		if szData == "1" then
			szLinkData = szLinkData & "★" & "종합과세"	
		else
			szLinkData = szLinkData & "★" & "분리과세"
		end if
		
'		Form.ShowAlert("f_callBondOrder", szLinkData)
		
'		Form.OpenPopup("mbfnp54021", szLinkData, "")
		Form.OpenScreen(54020, szLinkData)
	end if

end sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_szLinkData = Form.GetOpenLinkData()
	
	if g_szLinkData == "" or g_szLinkData == null then
		Exit Sub
	end if
	
	g_szList = split(g_szLinkData, "|")
	'0 종목코드
	'1 종목명
	'2 ACNO
	'3 ASNO
	'4 만기일
	'5 평가금액
	'6 보유수량
	'7 매입총액
	
	contMain.lblName.caption = g_szList(1)
	
	contMain.tbl0.SetCellString(0, 1, g_szList(4))		'만기일
	contMain.tbl0.SetCellString(0, 3, CInt(g_szList(5)) )	'평가금액
	contMain.tbl0.SetCellString(1, 1, CInt(g_szList(6)) / 1000 )	'보유수량
	contMain.tbl0.SetCellString(1, 3, CInt(g_szList(7)) )	'매입총액
	
	DATAMANAGER.RequestTranData("obsab_deal_605r")
End Sub

'============================================================================
Sub imgDim_OnClick()
	Form.CloseForm("")
End Sub

'============================================================================
Sub contMain_gridData_OnClickUp(lRow, szCellID)
	Dim szCode, szUserID, szLoadDate, szToday
	
	if szCellID == "bd_sell" then
		szCode = contMain.gridData.GetCellData("ISCD", lRow)
			
		szData = Form.GetItemCodeInfo(szCode, "innermarket")
		if Trim(szData) == "" then
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
			
			Exit Sub
		end if	   
		
		szUserID = Form.GetSharedData("&USER_ID" , false)
		szToday = Form.GetSharedData("&HOST_DATE", false)
				
		'팝업 화면에서 오늘 열지 않기 여부 확인
		szLoadDate = Form.LoadConfigData("NoticeSetting", szUserID & "_BondSellNotice")
		
		g_iSelectedRow = CInt(lRow)
		
		if (szLoadDate == "") or (szLoadDate <> szToday) then
'			Form.OpenPopup("mbonl90301_p6", "", "")
			Form.OpenPopupAnimation("mbonl90301_p6", "",  "",  2)
			
		else
			f_callBondOrder()
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl90301_p6" then
		f_callBondOrder()
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림_" & szTranID , "90301_p3\n" & szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림_" & szTranID , "90301_p3\n" & szErrCode .. " : ".. szErrMsg)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsab_deal_605r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_UNIT_CLS",		0, "3")	'UI단위구분  3:매수일별 보기
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_TRGT_CLS_CODE",	0, "1")	'처리대상구분코드  0:전체, 1:채권, 2:단기사채
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",				0, g_szList(2))	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, g_szList(3))	'계좌일련번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",			0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, g_szList(0))	'종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AMT_ADUP_YN",		0, "Y")			'금액합산여부
		
'	elseif szTranID == "obsab_deal_606r" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",				0, g_szList(2))	'계좌번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, g_szList(3))	'계좌일련번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, g_szList(0))	'종목코드
'		
''		szData = contMain.gridData.GetCellData("BYOV_DATE", )
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BYOV_DATE",			0, szData)	'매수일자
'		
