	<SCRIPT_INFO _len="2487" _ulen="2029" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 계좌비밀번호 오류안내
' 02. 화면설명 : 계좌비밀번호 오류안내
' 03. 작    성 : 2021.01.13 김유경
'-------------------------------------------------------------------------------------------

Dim g_Flag
'============================================================================
Sub Form_OnFormInit()
		
	Image0.imgpath     = "alpha128.png"
	Button1.btnimage   = "btn_22.9"
	
	Dim szData 
	szData = Form.GetOpenLinkData()
	
	If szData = "06" Then '4-8 자리체크
		Table0.SetCellString( 2, 0,"( 4 ~ 8자리 가능 )")
	ElseIf szData = "01" Then     '연속된 4자리 숫자
		Table0.SetCellString( 2, 0,"(연속된 4자리 숫자)")
	ElseIf szData = "02" Then '동일한 숫자 입력 시
		Table0.SetCellString( 2, 0,"(동일한 숫자 3자리 이상)")
	ElseIf szData = "03" Then '휴대폰번호와 4자리 이상 일치 시
		Table0.SetCellString( 2, 0,"(휴대폰번호와 4자리 이상 일치)")
	ElseIf szData = "04" Then '자택번호와 4자리 이상 일치 시
		Table0.SetCellString( 2, 0,"(자택번호와 4자리 이상 일치)")
	ElseIf szData = "05" Then '직장번호와 4자리 이상 일치 시
		Table0.SetCellString( 2, 0,"(직장번호와 4자리 이상 일치)")
	ElseIf szData = "07" Then '실명확인번호와 4자리 이상 일치 시
		Table0.SetCellString( 2, 0,"(실명확인번호와 4자리 이상 일치)")
	ElseIf szData = "08" Then '계좌번호와 4자리 이상 일치 시
		Table0.SetCellString( 2, 0,"(계좌번호와 4자리 이상 일치)")		
	ElseIf szData = "09" Then '신규비밀번호와 비밀번호 확인 불일치 시
		Table0.SetCellString( 1, 0,"")	
		Table0.SetCellString( 1, 0,"신규비밀번호와 비밀번호 확인이 불일치 합니다.")	
	End If
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbdm86180_p1_end" , "")
End Sub

'============================================================================
Sub Button1_OnClick()
	g_Flag = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbdm86180_p1_end" , g_Flag)
End Sub

