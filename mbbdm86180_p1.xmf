		<BUTTON name="BtnClose" btnimage="alpha128.png" ly_vert="-1,2,376,649,1" />
		<IMAGE name="Image0" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image1" imgpath="popup_bg_common.9" ly_vert="21,218,335,208,1" />
		<BUTTON name="Button1" caption="확인" fontsize="2" fontstyle="01" btnimage="btn_22.9" ly_vert="21,380,335,60,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="1" rowcount="4" outline="0000" designorder="1" ly_vert="31,262,315,91,1" >
			<COL_INFO ly_vert_width="315" />
			<ROW_INFO ly_vert_height="10,40,40,1" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" valign="2" line="0,0" caption="유효하지 않은 비밀번호입니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" fontsize="-2" impidxs="" />
