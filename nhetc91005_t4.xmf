'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_화면
' 03. 작    성 : 2016.02.16 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_IDXSET_FILE '종합화면설정팝업
Dim G_STOCKPRCSET_FILE '주식현재가화면설정팝업
Dim G_FUTOPTPRCSET_FILE '선물옵션현재가화면설정팝업
Dim G_INTERESTSET_FILE '관심종목화면설정팝업
'2016.02.29 주식호가주문설정삭제
'Dim G_STOCKORDERSET_FILE '주식호가주문설정팝업

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	G_IDXSET_FILE = "mhidx41000_p1"
	G_STOCKPRCSET_FILE = "mhprc11000_pc"
	G_FUTOPTPRCSET_FILE = "mhprc31000_p1"
	G_INTERESTSET_FILE = "mhprc11010_p1"
'	G_STOCKORDERSET_FILE = "mbtrs12010_p1"
End Sub

'============================================================================
Sub Cont0_Table0_OnClick(lRow , lColumn)
	'해당화면 설정오픈
	
	if lRow == 1 then '종합화면설정
		Form.OpenFramePopup(G_IDXSET_FILE , "" , "")
	elseif lRow == 2 then '주식현재가화면설정
		Form.OpenFramePopup(G_STOCKPRCSET_FILE , "" , "")
	elseif lRow == 3 then '선물옵션현재가화면설정
		Form.OpenFramePopup(G_FUTOPTPRCSET_FILE , "" , "")
	elseif lRow == 4 then '관심종목화면설정
		Form.OpenFramePopup(G_INTERESTSET_FILE , "" , "")
'	elseif lRow == 5 then '주식호가주문설정
'		Form.OpenFramePopup(G_STOCKORDERSET_FILE , "" , "")
	end if
End Sub

'============================================================================
' 종합화면설정
'============================================================================
Sub Cont0_Image0_OnClick()
	Form.OpenFramePopup(G_IDXSET_FILE , "" , "")
End Sub

'============================================================================
' 주식현재가화면설정
'============================================================================
Sub Cont0_Image1_OnClick()
	Form.OpenFramePopup(G_STOCKPRCSET_FILE , "" , "")
End Sub

'============================================================================
' 선물옵션현재가화면설정
'============================================================================
Sub Cont0_Image2_OnClick()
	Form.OpenFramePopup(G_FUTOPTPRCSET_FILE , "" , "")
End Sub

'============================================================================
' 관심종목화면설정
'============================================================================
Sub Cont0_Image3_OnClick()
	Form.OpenFramePopup(G_INTERESTSET_FILE , "" , "")
End Sub

