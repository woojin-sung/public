'	if trim(strMediaType) = "156" then 
'		Image1.visible  = false
'		Label1.visible  = false
'		Button2.visible = false
'	end if
'20160525 LKM END

'PENTA13 START => 2021.01.26	애플정책적용
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false )
	if s_OSTYPE == "2" Then
		cont0.tbl1.SetCellString(1, 1, "- 아이폰 : 애플 앱스토어 〉 메리츠증권 계좌개설")
		cont0.tbl1.SetCellString(2, 1, "   검색  〉 앱 설치")
		'cont0.tbl1.SetCellString(3, 1, "")
		'cont0.tbl1.SetCellString(4, 1, "")
	end if
End Sub

