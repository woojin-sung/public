'============================================================================
' 2018.06.14 : 윤유정 : 선물옵션 추가에 따라 화면 문구 수정 v0001 
' 2019.04.24 : 윤유정 : 종금형 CMA 만료 및 해외파생 추가에 따라 화면 문구 수정 v0002
' 2020.12.13 : 정민영 : v0003 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
' 2021.03.12 : 정민영 : v0004 : [T2103100017] 알뜰폰 본인인증 제한에 따른 화면 문구 수정
'============================================================================
Sub Button0_OnClick()
	Form.SendCall("15883400")
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.OpenFramePopup( "mbisa56040" , "" , 0 )
End Sub

'============================================================================
Sub Image1_OnClick()
	'20160429 KBC START
	sVer = Form.GetSharedData("&APP_VERSION")
	
	if sVer == "1.0.49" then 'Open 시 최초 버전 1.0.49
		Form.openExternalBrowser("https://play.google.com/store/apps/details?id=com.imeritz.smartmeritzact" ) 
	else
		'1.0.50이후부터 지원되는 API
		Form.RunSmartMeritzAct()
	end if
	'20160429 KBC END	
End Sub

'============================================================================
Sub Button2_OnClick()
	'20160429 KBC START
	Image1_OnClick() 
	'20160429 KBC END
End Sub

'============================================================================
Sub Form_OnFormInit()
