'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_iDataCount
Dim g_sUserID
Dim g_iSelectedRow

Dim g_bDeleteFlag
Dim g_iMaxDelete, g_iDeleteCount
g_iMaxDelete = 40		'My뉴스 등록된 기사 40개씩 삭제 처리

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
'	Form.ShowAlert("OnFormInit_t2", "")
	
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData("ohhts_news_011r")
End Sub

'============================================================================
Sub lblAllDelete_OnClick()
	'MyNews에서 전체 삭제
	Form.MsgBox( "알림" , "전체 뉴스를 삭제하시겠습니까?" , "DeleteNews" , 1 )
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "DeleteNews" then
		if sRet = "ok" then
			g_bDeleteFlag = True
			g_iDeleteCount = 0
			
			DATAMANAGER.RequestTranData("ohhts_news_010r_1")
		end if
		
	end if
	
End Sub

'============================================================================
Sub gridData_OnClickUp(lRow, szCellID)
	Dim szValue, szLinkData
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szCode, szName	
	
'	Form.ShowAlert("ClickUp", gridData.GetCellData("bd_delete_YN",		lRow ) .. " : " .. 
'							gridData.GetCellData("FID_NEWS_KEY", i))
							
	if szCellID == "bd_delete" then
		g_iSelectedRow = lRow
		
		'MyNews에서 삭제
		DATAMANAGER.RequestTranData("ohhts_news_010r")
		
	else
		szValue = gridData.GetCellData("FID_SRNO2",	lRow )
	
		szTitle			= gridData.GetCellData("FID_TITL",			lRow )	' 제목			-- FID_TITL
		szDate			= Left(szValue, 8)								' 날짜   		-- FID_DATE
		szTime			= Mid(szValue, 9, 6)								' 시간    		-- FID_CNTG_HOUR
		szNewCorpName		= gridData.GetCellData("FID_KOR_ISNM",		lRow )	' 뉴스제공업체명 	-- FID_KOR_ISNM
		szNewKey			= gridData.GetCellData("FID_NEWS_KEY",		lRow )	' 뉴스키       	-- FID_NEWS_KEY
		szNewsCorpCode	= gridData.GetCellData("FID_NEWS_OFER_ENTP_CODE",	lRow )' 뉴스제공업체코드-- FID_NEWS_OFER_ENTP_CODE
		szCode			= ""
		
		szName			= Form.GetItemCodeInfo(szCode, "name")
		
		szLinkData = "mbonl90001" & "★" & 
					szTitle & "|" & 
					szDate & "|" & 
					szTime & "|" & 
					szNewCorpName & "|" & 
					szNewKey & "|" & 
					szNewsCorpCode & "|" &  
					szName 
		
		'뉴스 상세내용 보기
		Form.OpenPopup( "mbonl90031_p1" , szLinkData, "" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert("TranError1", szErrCode .. ":"..szErrMsg)
	
	'전체 삭제중 오류 발생시 삭제예정표시를 없애준다.
	if szTranID == "ohhts_news_010r_1" then
		for i = 0 to gridData.rowcount - 1
			if gridData.GetCellData("bd_delete_YN",	i) == "Y" then
				gridData.SetCellData("bd_delete_YN",	i, "")
			end if
		next
	end if
		
	if szErrCode == "9900" then
	
		'조회건수가 없는경우
		if CInt(gridData.rowcount) == 0 then
			tblNoData.visible = True
			lblAllDelete.visible = False
		else
			tblNoData.visible = False
			lblAllDelete.visible = True
		end if
		
	else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , "mbonl90031_t2("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , "mbonl90031_t2("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
		end if
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szValue, iCount
		
	if szTranID == "ohhts_news_010r" then
		'개별삭제		
		szTemp1  = gridData.GetCellData("FID_NEWS_KEY",	g_iSelectedRow)
		szTemp2  = gridData.GetCellData("FID_DATE",	g_iSelectedRow)
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",	0, g_sUserID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_NEWS_KEY",	0, szTemp1)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_DATE",	0, szTemp2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_MOD_YN",		0, "Y")	
		
	elseif szTranID == "ohhts_news_010r_1" then
		'전체삭제
		iCount = 0
		for i = 0 to gridData.rowcount - 1
			if iCount >= g_iMaxDelete then
				Exit for
			end if
			
			szValue = gridData.GetCellData("bd_delete_YN",	i)
			
			if szValue == "Y" then
				'이미 삭제표시되어 있는 기사
				
			else
				szTemp1  = gridData.GetCellData("FID_NEWS_KEY", i)
				szTemp2  = gridData.GetCellData("FID_DATE",i)
			
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",	iCount, g_sUserID)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_NEWS_KEY",	iCount, szTemp1)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_DATE",	iCount, szTemp2)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_MOD_YN",		iCount, "Y")				
				
				gridData.SetCellData("bd_delete_YN",	i, "Y")	'삭제예정 표시
				
				g_iDeleteCount = g_iDeleteCount + 1
				iCount = iCount + 1
			end if
		next
		
		if CInt(g_iDeleteCount) >= CInt(gridData.rowcount) then
			g_bDeleteFlag = False
'			Form.ShowAlert("TranBefore2", g_bDeleteFlag)
		end if
		
	elseif szTranID == "ohhts_news_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",		0 , g_sUserID)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iDataCount
	
	if szTranID == "ohhts_news_011r" then
		'girdData 에서 데이타 연결로 표시
		if CInt(gridData.rowcount) == 0 then
			Form.ShowAlert("ReceiveTranComplete", "")
			tblNoData.visible = True
			lblAllDelete.visible = False
		else
			tblNoData.visible = False
			lblAllDelete.visible = True
		end if
			
	elseif szTranID == "ohhts_news_010r" then
		msg = DATAMANAGER.GetDataMsgText(szTranID)
				
		gridData.SetDeleteRow(CInt(g_iSelectedRow))
		if CInt(gridData.rowcount) == 0 then
			tblNoData.visible = True
			lblAllDelete.visible = False
		else
			tblNoData.visible = False
			lblAllDelete.visible = True
		end if
		
		Form.Toast(0, "My 뉴스가 삭제 되었습니다.", 1)
	
	elseif szTranID == "ohhts_news_010r_1" then
		'전체 삭제 후
'		iDataCount = gridData.rowcount
'		
'		for i = gridData.rowcount - 1 to 0 step -1
'			if gridData.GetCellData("bd_delete_YN",	i) == "Y" then
'				gridData.SetDeleteRow( CInt(i) )
'			end if
'		next
		
'		Form.ShowAlert("TranComplete1", szTranID)
	
		if g_bDeleteFlag then
'			Form.ShowAlert("TranComplete1", g_iDeleteCount)
			DATAMANAGER.ClearInputData(0, szTranID)
			DATAMANAGER.RequestTranData(szTranID)
		else
'			Form.ShowAlert("TranComplete2", g_iDeleteCount)

			gridData.SetClear()
			
			if CInt(gridData.rowcount) == 0 then
				tblNoData.visible = True
				lblAllDelete.visible = False
			else
				tblNoData.visible = False
				lblAllDelete.visible = True
			end if
			
			gridData.rowcount = 0
			DATAMANAGER.RequestTranData("ohhts_news_011r")
			
			Form.Toast(0, "My 뉴스가 삭제 되었습니다.", 1)
		end if
		
	end if
End Sub



'============================================================================
Sub Form_OnFormInitBefore()
	gridData.setMaintainingRatio("bd_delete", 0, "1")
End Sub

