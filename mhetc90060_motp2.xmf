'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then 
	
		'INPUT_CLS를 "1"로 작업했는데, 다른 경우 발생하는지 확인해보기
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"   , 0 , g_sUserID )		
		
	elseif szTranID == "obcsb_oimf_174a" then
		
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_PROS_CLCD"  , 0 , "TIME")
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "ACNO"                 , 0 , "")
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "RCNO_PIP"             , 0 , g_RcnoPip)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "ELFN_ID"              , 0 , g_sUserID)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "CSNO"                 , 0 , sCsNo)
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MSBO_VRSN"            , 0 , g_mSBVerison)
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_SRNO"            , 0 , g_mOTPAlias)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "CUST_TERM_ID"         , 0 , g_DeviceID)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_ATHN_TYPE_CLCD"  , 0 , "10")
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_ATHN_DATA_CNTT"  , 0 , Container0.EditReal.caption)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_174a", "InBlock1", "MOTP_TR_CNTT"         , 0 , "") 'UUID 확인(일단 안넣어도 되는 것으로 확인)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSMRT_OTP_YN 
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS    = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "RSLT_CLS"      , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		sSMRT_OTP_YN = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN", 0 )
		
		if sRSLT_CLS == "3" and sSMRT_OTP_YN == "M" then
			g_Success = 1
		end if
		
	elseif szTranID == "obcsb_oimf_174a" then
		
		sTRcntt  = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_CNTT" , 0 )
		sTRNo    = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_NO"   , 0 )
		sHourVal = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_HOUR_VAL", 0 )
		sMtsYN   = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_TR_REG_YN", 0 )
		sErrCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_ERR_CODE", 0 )
		sErrCntt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_174a", "OutBlock1", "MOTP_ERR_CNTT", 0 )
		
		if sErrCode == "000000" then
			szData = "512"..g_mOTPAlias.."★".."02010".."★"..sHourVal.."★"..sTRcntt '기관코드(siteCode) 02010으로 고정

			if sMtsYN == "N" then		'(이미 인증완료 됐는데 기존 푸시흔적 눌러서 들어와서 인증할까봐 임의로 오류메시지 둬봤음)
				Form.triggerEvent("#", "menu_entering3", szData )
			else
				Form.MsgBox("알림", "거래 정보가 존재하지 않습니다.", "", 6)
				PasswordFail()
			end if	
			
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_oimf_174a" then
		Dim sSubMsg
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID ) 
		
		'if sSubMsg ~= null and Trim(sSubMsg) ~= "" then				
			szErrMsg = szErrMsg & "\n" & sSubMsg
		'end if
		
		if szErrCode == "2430" then								'비밀번호 오류(5회가 아닌 경우)
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		elseif szErrCode == "8867" then							'비밀번호 오류(5회인 경우)
			
			Form.OpenNextPopup("mhetc90060_motpS" , "motp_error5" , "")
		elseif szErrCode == "2424" then												
			Form.MsgBox( "알림", szErrMsg, "", 6 )
			Form.OpenNextPopup("mhetc90060_motpS" , "motp_error10" , "")	'인증 오류 회수 10회 이상일 시(PG거래만 적용)
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
	elseif szTranID == "obcsb_oimf_176a" then
		Dim sSubMsg
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID ) 
		
		'if sSubMsg ~= null and Trim(sSubMsg) ~= "" then				
			szErrMsg = szErrMsg & "\n" & sSubMsg
			
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		'end if
		
	end if
	
	PasswordFail()
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	elseif sKeyName == "LOG_FORCE" then
		' IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_DeviceOS == "2" Then	'iOS("2")Android("1")
			
			if sRet == "ok" then
				
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
				
			else
				Form.OpenScreen("41000", "")
				Form.CloseForm()
			end if
			
		else
			if sRet == "ok" then
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()			
			end if
			
		end if
		
	elseif sKeyName == "MOTP_NEW" then
		
		'로그인을 한번이라도 했었는지 판단
		if g_sUserID == "" or g_sUserID == null then
			Form.SetSharedData("BDM_NMETBSWRGB", "009")
			Form.OpenNextPopup("mbbdm85200","", "")
		else
			if Cint(g_LoginType) > 1 then '로그인상태
				Form.OpenNextPopup("mbotp86100","", "")
			else
				'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
				'업무신청 화면으로 발급하도록 연결
				 Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
				 Form.SetSharedData("BDM_FRST_MAPID", "screen41000")
				 Form.SetSharedData("BDM_NMETBSWRGB", "009")
				 'V001
				 'Form.OpenNextPopup("mbbdm85110", "" , "" )
				 Form.OpenNextPopup("mbbdm86130", "" , "" )
			end if
		end if
	end if
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "MOTP_VERSION" then
		g_mSBVerison = sParam
		
	elseif sEventName == "MOTP_ALIAS" then
		
		if sParam == "NO_MOTP" then
			Form.MsgBox("알림", "모바일OTP가 발급된 정보가 없습니다.\n모바일OTP를 발급하시겠습니까?", "MOTP_NEW", 6 )
		else
			g_mOTPInfo = sParam
			
			g_mOTPAlias = Right(g_mOTPInfo, 12)
			
			DATAMANAGER.RequestTranData("obcsb_oimf_174a")

		end if
		
	elseif sEventName == "MOTP_RETURN2" then
		
		g_mAuthNum = sParam
		
		if g_mAuthNum ~= null or g_mAuthNum ~= "" then
			Form.OpenNextPopup("mhetc90060_motpA",g_mOTPAlias.."★"..g_mAuthNum,"")
		end if
		
	elseif sEventName == "MOTP_SHOWKEYPAD" then
		Form.SetTimerEvent2(1,1,0.3)
	elseif sEventName == "MOTP_PWDCLEAR" then
		nCnt = 0
		PasswordInsert()
	end if
End Sub
'============================================================================
Sub Container0_EditReal_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if g_DeviceOS == "2"  then
			Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
		elseif g_DeviceOS == "1" then
			Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
		end if
	'20210517 SWJ START : 업무혁신실 수정요청 (입력완료 누르면 바로 인증되도록)
	elseif nCnt = 6 then
		if g_Success = 1 then
			Form.triggerEvent("#", "menu_entering_pg", "")	
		end if
		nCnt = 0
	'20210517 SWJ END
	end if
End Sub


