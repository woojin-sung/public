'============================================================================
Sub Form_OnFormInit()
	
	Container0.EditReal.SetApplyLabel("숫자6자리 입력" 		,0 , 76 , "left" , true) '호출해야 정상작동
	
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_RcnoPip  = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
	sCsNo 	  = Form.GetSharedData("&CUST_NUM"  , false )	 '고객번호
	g_DeviceID = Form.GetDeviceID() 
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", 0 )
	
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO", false) '메뉴클릭시 팝업메뉴 화면번호 전환
													 'ios에서 푸시로 인증 시에 화면번호를 가져오는 경향이 있어서 true로 변경
	'주민번호와 고객번호를 getshared 뒤지다가 안나오면 발급 시 set한 값 불러오도록 처리
	if g_RcnoPip == "" or g_RcnoPip == null then
		g_RcnoPip = Form.GetEnvData("login.session.juminnopip")
	end if
	
	if sCsNo == "" or sCsNo == null then
		sCsNo = Form.GetEnvData("login.session.custno")
	end if

	if szPopupYN == "motp_success" then
		g_sSendData = Form.GetOpenLinkData()
	end if
	
	if g_sUserID ~= null and g_sUserID ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
End Sub
'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.EditReal.caption == null or Container0.EditReal.caption == "" then
		Form.MsgBox( "알림", "모바일 OTP 비밀번호를 입력해주세요.", "", 6 )
	else	
		if g_Success = 1 then
			Form.triggerEvent("#", "menu_entering_pg", "")	
		end if
	end if
	
	nCnt = 0
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.3)
		Container0.EditReal.SetShowKeypad(True)
	end if
	
End Sub
