'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub Container0_EditReal_OnEditChar(CharCode)
	Select Case CharCode
	
	Case "0"
		
		'입력값 6초과할 때 초과 카운팅 방지
		if nCnt = 6 then
			nCnt = 6
		else
			nCnt = nCnt + 1
		end if
		
		g_CountSave = nCnt
	Case "1"	
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt = 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
		
		g_CountSave = nCnt
	'취소, 입력완료일 때
	Case "2"
		nCnt = 0
	End Select

	PasswordInsert()
End Sub
