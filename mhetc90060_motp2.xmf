'============================================================================
' 2021.01.25 SWJ START : 모바일OTP인증화면 
' 2023.04.06 V001 양현정 휴대폰인증 맵id변경
'============================================================================
Dim g_RcnoPip, g_sUserID, sCsNo
Dim g_mSBValue
Dim g_DeviceID , siteCode
Dim g_mOTPInfo, g_mOTPAlias
Dim sTRcntt, sTRNo, sHourVal
