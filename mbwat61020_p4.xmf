--===========================================================================

'============================================================================
dim g_szContent
dim g_szData
dim g_szEmpNo
dim g_szWaPrcd

Sub Form_OnFormInit()
	Dim sData
	sData = Form.GetOpenLinkData()
	
	'Form.ShowAlert(sData)
	
	if sData <> null and sData <> "" then
		Dim tData
		tData = Split(sData, "|")
		
		if tData(0) == "0" then
			btnShowProduct.caption = "운용역의 운용 상품 보기"
		else
			btnShowProduct.caption = "계약 진행하기"
		end if
		
		tablePos(tData(0))
		
		g_szEmpNo = tData(1)
		g_szWaPrcd = tData(2)
		
		DATAMANAGER.RequestTranData("obwat_oiad_071r")
	end if
End Sub

'============================================================================
Sub tablePos(szVal)

	'상품을 운용역으로 검색시
	if szVal == "0" then
		Table0.left = 1000
		Grid0.left = 1000
		Grid1.left = 1000
		
		
		Label0.top = 279
		Label0.caption = "운용역 안내"
		imgClose.top = 282
		Image1.top = 265
		Image1.height = 395
		Table1.left = 8
	else
		Table0.left = 8
		Grid0.left = 8
		Grid1.left = 8
		Label0.top = 19
		Label0.caption = "운용역 프로필"
		imgClose.top = 22
		Image1.top = 13
		Image1.height = 640
		
		Table1.left = 1000		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_oiad_071r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WA_MGRI_EMPNO", 0 , g_szEmpNo)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID = "obwat_oiad_071r" then
		'기본정보
		sFLNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FLNM" , 0) '직원명
		sJBTT_NAME = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "JBTT_NAME" , 0) '직위명
		sDPNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DPNM" , 0) '소속
		sRSNS_BSWR_CNTT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSNS_BSWR_CNTT" , 0) '담당업무
		
		sJBTT_NAME = replace(sJBTT_NAME, "(일반직)", "")
		sJBTT_NAME = replace(sJBTT_NAME, "(연봉직I)", "")
		sJBTT_NAME = replace(sJBTT_NAME, "(연봉직2)", "")
		sJBTT_NAME = replace(sJBTT_NAME, "(촉탁)", "")
		sJBTT_NAME = replace(sJBTT_NAME, "(전문임원)", "")
		
		'전체 프로필 조회시
		Table0.SetCellString(1, 2, sJBTT_NAME)  '직위
		Table0.SetCellString(2, 2, sDPNM) '소속
		Table0.SetCellString(3, 2, sRSNS_BSWR_CNTT) '담당업무
		
		'축소 프로필 조회시
		Table1.SetCellString(1, 2, sJBTT_NAME)  '직위
		Table1.SetCellString(2, 2, sDPNM) '소속
		Table1.SetCellString(3, 2, sRSNS_BSWR_CNTT) '담당업무
		
		'자격보유현황
		nCnt = CInt(DATAMANAGER.GetDataCount("0", szTranID , "OutBlock2"))
		
		Grid0.rowcount = nCnt
		
		For i = 1 to nCnt
			sQLCR_RPRS_NAME = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "QLCR_RPRS_NAME" , i-1) '자격증명
'			sACQS_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ACQS_DATE" , i-1) '취득일
'			sQLCR_ATHN_ISTU_RPRS_NAME = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "QLCR_ATHN_ISTU_RPRS_NAME" , i-1) '인증기관
			
			Grid0.SetCellData("bd_cell0", i-1, sQLCR_RPRS_NAME) ' 자격증명
'			Grid0.SetCellData("bd_cell1", i-1, sACQS_DATE) ' 취득일
'			Grid0.SetCellData("bd_cell4", i-1, sQLCR_ATHN_ISTU_RPRS_NAME) ' 인증기관
		next
		
		'주요경력
		nCnt = CInt(DATAMANAGER.GetDataCount("0", szTranID , "OutBlock4"))
		
		Grid1.rowcount = nCnt
		
		For i = 1 to nCnt
			sCARR_DTL_EXPL = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "CARR_DTL_EXPL" , i-1) '경력상세설명
			sDPNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "DPNM" , i-1) '부서명
			
			sCARR_STA_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "CARR_STA_DATE" , i-1) '시작일
			sCARR_FIN_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "CARR_FIN_DATE" , i-1) '정료일

			if sDPNM <> "" then
				Grid1.SetCellData("bd_cell0", i-1, sCARR_DTL_EXPL.." | "..sDPNM) ' 경력상세설명
			else	'부서없는 경우
				Grid1.SetCellData("bd_cell0", i-1, sCARR_DTL_EXPL) ' 경력상세설명
			end if
			
			sTerm = ""
			if sCARR_STA_DATE <> "" and sCARR_FIN_DATE <> "" then
				sTerm = Left(sCARR_STA_DATE,4)&"."&Mid(sCARR_STA_DATE,5,2)&"."&Mid(sCARR_STA_DATE,7,2)
				sTerm = sTerm&" ~ "&Left(sCARR_FIN_DATE,4)&"."&Mid(sCARR_FIN_DATE,5,2)&"."&Mid(sCARR_FIN_DATE,7,2)
				sTerm = sTerm&" 근무"
			elseif sCARR_STA_DATE <> "" and sCARR_FIN_DATE = "" then  ' 근무종료일이 없는 경우 현재근무중으로 간주
				sTerm = Left(sCARR_STA_DATE,4)&"."&Mid(sCARR_STA_DATE,5,2)&"."&Mid(sCARR_STA_DATE,7,2)
				sTerm = sTerm&" ~ 현재"			
			end if
			
			Grid1.SetCellData("bd_cell1", i-1, sTerm) ' 기간
		next
		
		'제제사항
		sRSTN_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSTN_YN" , 0) '제제여부
		if sRSTN_YN = "N" or sRSTN_YN = "" then
			Table0.SetCellString(18, 0, "해당 규정에 의거 결격사유가 없습니다.")  '제제여부
			Table1.SetCellString(7, 0, "해당 규정에 의거 결격사유가 없습니다.")  '제제여부
		else
			Table0.SetCellString(18, 0, "Y")  '제제여부
			Table1.SetCellString(7, 0, "Y")  '제제여부
		end if
		
		'연락처
		sPRCH_TELNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EMAIL_ID" , 0) '대표연락처
		'sEMAIL_ADDR = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EMAIL_ADDR" , 0) '이메일주소
		
		Table0.SetCellString(21, 0, sPRCH_TELNO)  '대표연락처
		Table1.SetCellString(10, 0, sPRCH_TELNO)  '대표연락처
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub btnShowProduct_OnClick()
	Form.SendReturnToParent("SEARCH_EMP_PRD" , g_szEmpNo)
	Form.CloseForm()
End Sub

