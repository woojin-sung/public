				end if
				div3_cnt = div3_cnt + 1
			end if
			
			grd01T1.SetCellFgColor("bd_cell13", i, "131")
			grd01T1.SetCellFgColor("bd_cell14", i, "131")
			
			'v0002 fin
						
						
			szmakeString = ""
			if grd01T1.GetCellData("bd_cell9", i) <> "" then
				szmakeString = szmakeString .. grd01T1.GetCellData("bd_cell9", i)
			end if
			
			if grd01T1.GetCellData("bd_cell11", i) <> "" then
				szmakeString = szmakeString .. " | " .. grd01T1.GetCellData("bd_cell11", i)
			end if
			
			if grd01T1.GetCellData("bd_cell13", i) <> "" then
				szmakeString = szmakeString .. " | " .. grd01T1.GetCellData("bd_cell13", i)
			end if
			
			if grd01T1.GetCellData("bd_cell14", i) <> "" then
				szmakeString = szmakeString .. " | " .. grd01T1.GetCellData("bd_cell14", i)
			end if
			
			grd01T1.SetCellData("bd_status", i, szmakeString)			
			
			

			' 조회된 펀드목록중 펀드비교함에 추가된 펀드와 동일펀드 존재시 체크박스 활성화 해준다
		    IF  Trim(contCompare.grdList.GetCellData("bd_iscd", 0)) == grd01T1.GetCellData("bd_cell0", i) THEN
			        ' 펀드비교함 첫번째 펀드
			        grd01T1.SetCellData("bd_cell10", i, "1")
			ELSEIF Trim(contCompare.grdList.GetCellData("bd_iscd", 1)) == grd01T1.GetCellData("bd_cell0", i) THEN
			        ' 펀드비교함 두번째 펀드
			        grd01T1.SetCellData("bd_cell10", i, "1")
			ELSE
			        grd01T1.SetCellData("bd_cell10", i, "0")
			END IF


		next
		
'	elseif	szTranID	=	"oocwi_gmyg_011a"	then
'		Form.ShowAlert("알림", "정상적으로 관심펀드에 등록되었습니다.")
	
		
	elseif	szTranID =	"obcsb_acif_400r" then
		g_szSpclInvrYn = DATAMANAGER.GetDataValue(0, "obcsb_acif_400r" , "OutBlock1" , "KYC_SPCL_INVR_YN" , 0)	'KYC전문투자자여부

