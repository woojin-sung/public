'============================================================================
'getListItem: 설정값에서 가져온 조건을 input 배열에 넣는다.
'============================================================================
Function	setInputItems( szInput, nCnt )
	for	i = 0	to	nCnt	- 	1
			g_szMainValues(g_nIdx)	=	getListItem(szInput, (i*2 + 1))
			g_szSubValues(g_nIdx)	=	getListItem(szInput, ((i+1)*2))
			g_nIdx = g_nIdx + 1
	next
End Function


'============================================================================
'getListItem: 해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function



