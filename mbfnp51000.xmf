'============================================================================
Sub lblCompare_OnClick()
	'펀드비교함 버튼
	If g_bCompareBox Then
		g_bCompareBox = false
		
		imgDim.left = 1000
		contCompare.left = 1000
		grd01T1.height = 380
	Else
		g_bCompareBox = true
		
		imgDim.left = 0
		contCompare.left = 0
		grd01T1.height = 117
	End If
End Sub

'============================================================================
Sub contCompare_grdList_OnClickUp(lRow, szCellID)
	'펀드비교함의 아이템 삭제
	If szCellID == "bd_delete" Then
		Dim szTitle, szIscd
		szTitle = Trim(contCompare.grdList.GetCellData("bd_title", lRow))
		szIscd = Trim(contCompare.grdList.GetCellData("bd_iscd", lRow))

		'비교함의 항목 삭제
		IF  g_szCompareData1 <> "" AND g_szCompareData2 == "" THEN
		        '남는 항목이 없으면 자동으로 펀드비교함과 비교함팝업버튼 숨김
			g_bCompareBox = TRUE
			lblCompare_OnClick()
		END IF


		IF  lRow  ==  0  THEN
		        ' 첫번째 비교대상펀드 삭제
		        IF  g_szCompareData2 <> "" THEN
			        ' 두번째 비교대상펀드를 첫번째로 옮기고 두번째거를 삭제
			        g_szCompareData1 = g_szCompareData2
				g_szCompareData2 = ""
			ELSE
			        g_szCompareData1 = ""
			END IF
		ELSEIF lRow  ==  1  THEN
		        ' 두번째 비교대상펀드 삭제
			g_szCompareData2 = ""
		END IF
		
		' 펀드비교 텍스트 변경
		f_SetCompareBox()

		For i = 0 To CInt(grd01T1.rowcount) - 1 
			Dim szTempTitle,szTempIscd
			szTempTitle = grd01T1.GetCellData("bd_name", i)
			szTempIscd = grd01T1.GetCellData("bd_cell0", i)
			
                        ' 현재 조회된 펀드목록에 삭제할 동일펀드가 있으면 체크해제해준다.
			If szTempIscd == szIscd Then
				grd01T1.SetCellData("bd_cell10", i, "0")
			End If
		Next
	End If
End Sub

'============================================================================
Sub contCompare_imgClose_OnClick()
	g_bCompareBox = false
	
	imgDim.left = 1000
	contCompare.left = 1000
	grd01T1.height = 380
End Sub

