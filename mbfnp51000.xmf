'============================================================================
Sub lblSubSearch_OnClick()
	if g_szSpclInvrYn = "N" then
		if g_szMtrtDate = "" or g_szMtrtDate = Null then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n조건 검색이 불가합니다.")
			Exit sub
		
		elseif int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false)) then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \조건 검색이 불가합니다.")
			Exit sub
		
		elseif g_szRcmdClsCode = "2" or g_szRcmdClsCode ="4" then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n조건 검색이 불가합니다.")
			Exit sub
		
		elseif g_szRcmdClsCode = "3" then	'투자권유 미희망 + 정보제공 일때 추가
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n조건 검색이 불가합니다.")
			Exit sub
			
		end if
	end if
	
	'v0004
	szData = g_szInvType  & "★" & g_szRcmdClsCode  & "★" & g_Trgt_Cls_Code  & "★" & g_szSpclInvrYn
	'v0001 
	Form.OpenPopup("mbfnp51000_p1" , szData , sPosInfo)
	

End Sub

