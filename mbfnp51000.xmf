'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'v0001 sta	
	if sKey = "&LOGIN_AUTH" then
		Refresh()		
	'v0001 fin	
	'투자성향 변경 후, 변경된 투자성향으로 재조회하기 위함
	elseif sKey == "Change_Invest_Type" and sValue == "refresh" then	
		Refresh()		
	end if
End Sub
'=============================================================================
Sub Refresh()
'v0001 sta 추가
	g_szID = ""
	g_szNm = ""
	g_logintype = Form.GetSharedData("&LOGIN_TYPE", false)
	
	' 비로그인일 경우 ID를 가져오지 않음.
	if g_logintype <> "1" then
		g_szID = Form.GetSharedData("&USER_ID", false )
		g_szNm = Form.GetSharedData("&USER_NAME", false)
	end if
	
	DATAMANAGER.SetDataValue(0, "obcsb_acif_798r", "InBlock1", "ELFN_ID", 0 , g_szID)
	DATAMANAGER.RequestTranData("obcsb_acif_798r")
'v0001 fin
End Sub

