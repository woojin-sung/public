Sub contCompare_btnPopup_OnClick()
	If CInt(contCompare.grdList.rowcount) < 2 Then
		Form.ShowAlert("안내", "비교할 펀드 2종목을 선택해주세요.")
		Exit Sub
	End If
	
	Form.OpenFramePopup("mbfnp51000_p7" , g_szCompareData1 & "☆" & g_szCompareData2 , "")
End Sub

