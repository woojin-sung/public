'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
    unCheckImgPath = "checkmenu_n.png"
    CheckImgPath   = "checkmenu_o.png"
    
	grd01T1.setUseCardView(true, 10, "input_03_n.9.png")
	
	'펀드 비교데이터 초기화
	g_szCompareData1 = ""
	g_szCompareData2 = ""
	g_bCompareBox = false
	
	' 펀드비교 텍스트 변경
	f_SetCompareBox()
	
	'v0001 sta 추가
	g_szID = ""
	g_szNm = ""
	g_logintype = Form.GetSharedData("&LOGIN_TYPE", false)
	' 비로그인일 경우 ID를 가져오지 않음.
	if g_logintype <> "1" then
		g_szID = Form.GetSharedData("&USER_ID", false )
		g_szNm = Form.GetSharedData("&USER_NAME", false)
	end if

	DATAMANAGER.RequestTranData("obcsb_acif_400r")
	
	'v0001 fin
	g_nIdx = 0
	
End Sub


'============================================================================
'펀드 비교에 쓰일 데이터 세팅
'============================================================================
Function f_SetCompareData(szType, nRow)
	Dim szData
	szData = ""
	
	'가입방법, 펀드명, 위험등급, 기준가, 펀드유형, 운용사, 설정일, 설정규모, 판매수수료, 총보수율, 환매수수료, 1개월수익률, 3개월, 6개월, 12개월
	Dim szMethod, szName, szRiskGrd, szBasePrc, szFundTp, szMgcoNm, szStupDt, szStupAmt, szSalesFee, szRmrt, szZiRmrt, szRate1, szRate3, szRate6, szRate12
'	szData = grd01T1.GetCellData("bd_cell2", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_name", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_grade", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell31", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_type", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell32", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell33", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell12", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell34", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell35", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell36", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell24", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell1", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell3", nRow)
'	szData = szData & "★" & grd01T1.GetCellData("bd_cell6", nRow)
	
	szData = grd01T1.GetCellData("bd_name", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_grade", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_type", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell31", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell33", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell12", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell35", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell34", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell36", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell2", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell32", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell24", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell1", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell3", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell6", nRow)
	szData = szData & "★" & grd01T1.GetCellData("bd_cell0", nRow)
	
	If szType == "Add" Then
		Return szData
	ElseIf szType == "Delete" Then
		'똑같이 데이터 만들어서 g_szCompareData와 비교하여 삭제 
		If g_szCompareData1 == szData Then
			'두번째 펀드데이터가 존재하는데 첫번째가 삭제되는 경우 두번째 데이터를 첫번째 데이터에 넣어줌
			If g_szCompareData2 <> "" Then
				g_szCompareData1 = g_szCompareData2
				g_szCompareData2 = ""
			Else
				g_szCompareData1 = ""
			End If
			
		ElseIf g_szCompareData2 == szData Then
			g_szCompareData2 = ""
		End If
	End If
End Function

'============================================================================
'펀드비교함 세팅
'============================================================================
Function f_SetCompareBox()
	Dim tData

	'셋팅된 데이터를 보고 비교갯수 버튼 처리
	If g_szCompareData1 <> "" And g_szCompareData2 <> "" Then
		contCompare.grdList.rowcount = 2
		
		lblCompare.visible = true
		lblCompare.caption = "펀드비교"	'(2)
		
		tData = Split(g_szCompareData1, "★")
		If UBound(tData) > 0 Then
			contCompare.grdList.SetCellData("bd_title" , 0, tData[0])
			contCompare.grdList.SetCellData("bd_iscd", 0, tData[15])
			tData = ""
		End If
		tData = Split(g_szCompareData2, "★")
		If UBound(tData) > 0 Then
			contCompare.grdList.SetCellData("bd_title" , 1, tData[0])
			contCompare.grdList.SetCellData("bd_iscd", 1, tData[15])
			tData = ""
		End If
		
	ElseIf g_szCompareData1 <> "" And g_szCompareData2 == "" Then
		contCompare.grdList.rowcount = 1
		
		lblCompare.visible = true
		lblCompare.caption = "펀드비교"	'(1)
		
		tData = Split(g_szCompareData1, "★")
		If UBound(tData) > 0 Then
			contCompare.grdList.SetCellData("bd_title" , 0, tData[0])
			contCompare.grdList.SetCellData("bd_iscd", 0, tData[15])
'			contCompare.grdList.SetCellData("bd_title", 1, "")
			tData = ""
		End If
		
	Else
		contCompare.grdList.rowcount = 0
		
		lblCompare.visible = true
		lblCompare.caption = "펀드비교"	'(0)
'		contCompare.grdList.SetCellData("bd_title", 0, "")
'		contCompare.grdList.SetCellData("bd_title", 1, "")
	End If
End Function

'============================================================================
'grd01T1_OnClickUp
'============================================================================
Sub grd01T1_OnClickUp(lRow, szCellID)
	
	g_szShortCd		=	grd01T1.GetCellData("bd_cell0", lRow)
	g_szStndCd		= 	grd01T1.GetCellData("bd_cell5", lRow)
	g_szFundName		=	grd01T1.GetCellData("bd_name", lRow)
	g_szSaleChanTp	=	grd01T1.GetCellData("bd_cell2", lRow)
	
	g_szTransGradNm	=	grd01T1.GetCellData("bd_grade", lRow)
	g_szTypeNm		=	grd01T1.GetCellData("bd_type", lRow)
		
	g_szStatus		=	grd01T1.GetCellData("bd_status", lRow)
	
	'펀드명 SharedData.. 목표시장비교팝업에서 사용!
	Form.SetSharedData( "FNDNAME_51010" , g_szFundName)	
	
	'연금펀드 선택시 연금계좌 셋팅되도록..
	if CInt(InStr(g_szStatus, "개인연금")) > 0 then	'szPNSN_yn
		Form.SetSharedData("51000_PNSN_YN", "Y")
	else
		Form.SetSharedData("51000_PNSN_YN", "N")
	end if
		
	'펀드비교체크
	If szCellID == "bd_cell10" Then			
		Dim nChkCnt
		nChkCnt = 0
		
		Dim szCheck
		szCheck = grd01T1.GetCellData("bd_cell10", lRow)
		'체크 선택
		If szCheck == "1" Then
		        IF g_szCompareData1 <> "" AND g_szCompareData2 <> "" THEN
			        Form.ShowAlert("알림", "펀드 비교는 2개까지 가능합니다.")
				grd01T1.SetCellData("bd_cell10", lRow, "0")
				Exit Sub
			END IF
			
			If g_szCompareData1 == "" Then
				g_szCompareData1 = f_SetCompareData("Add", lRow)
			ElseIf g_szCompareData1 <> "" And g_szCompareData2 == "" Then
				g_szCompareData2 = f_SetCompareData("Add", lRow)
			End If
			
		'체크 해제
		Else
			f_SetCompareData("Delete", lRow)
		End If
		
		f_SetCompareBox()
				
				
	'그 외 펀드선택시 펀드주요내용 팝업 오픈
	Else
		Dim szSendData
		szSendData = g_szShortCd & "★" & g_szStndCd & "★" & g_szSaleChanTp
		
		Form.OpenPopup("mbfnp51000_p0", szSendData, "")
	End If
End Sub

 
'============================================================================
Sub imgInfo_OnClick()
	Form.OpenPopup("mbfnp51000_p3" , sOpenData , sPosInfo)
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if	szTranID	=	"obcsb_acif_400r"	then
		'고객번호
		g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_400r", "InBlock1", "CSNO" , 0 , g_szCsno)
		
	elseif	szTranID	=	"oocwi_mall_002r"	then
					
		'0.	입력값 COUNT 초기화
		g_nIdx	=	0	
		
		nTypeCnt	=	0
		nFeeCnt	=	0
		nGradeCnt	=	0
		nChanCnt	=	0
		nSvngCnt =    0 'V0005
						
		if	edtSearch01.caption 	<>	""	then
			g_szKeyword = UCASE(edtSearch01.caption)
			Form.SetSharedData("51000_KEYWORD", szKeyword)
		else
			g_szKeyword	=""
			Form.SetSharedData("51000_KEYWORD", " ")
		end	if
				
		'2. 각각 조건의 COUNT 가져옴
		if	g_szType <> ""	then
			nTypeCnt	=	getListItem(g_szType, 0)
		end if 
		if	g_szGrade <> ""	then
			nGradeCnt	=	getListItem(g_szGrade, 0)
		end if 
		if	g_szFee <> ""	then
			nFeeCnt	=	getListItem(g_szFee, 0)
		end if 
		if	g_szChan <> "" then
			nChanCnt	=	getListItem(g_szChan, 0)
		end if
		''V0005
		if   g_szSvng <> "" then 
			nSvngCnt = getListItem(g_szSvng,0)
		end if
		
'		Form.ShowAlert("test", nTypeCnt & ".." & nGradeCnt &".." & nFeeCnt &".."& nChanCnt)
		
		'3.분류해서 INPUT Array에 넣음.
		if	nTypeCnt	<>	0	then
			setInputItems(g_szType, nTypeCnt)
		end if
		if	nGradeCnt	<>	0	then
			setInputItems(g_szGrade, nGradeCnt)
		end if	
		if	nFeeCnt	<>	0	then
			setInputItems(g_szFee, nFeeCnt)
		end if
		if	nChanCnt <>	0	then
			setInputItems(g_szChan, nChanCnt)
		end if
		'V0005
		if	nSvngCnt <>	0	then
			setInputItems(g_szSvng, nSvngCnt)
		end if
		
		'4. 실제 TR에 세팅
		DATAMANAGER.ClearInputData(0, "oocwi_mall_002r")
				
		if	len(trim(g_szKeyword))		<>	""	then
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "KOR_ISNM" , 0 , g_szKeyword)
		end if
		
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "IISC_INVT_REGN_CLS_CODE" , 0 , g_szArea)
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "SORT_CLS", 0, cmbSort01.cbkeydata)
		
		for 	i = 0	to	g_nIdx - 1	
			DATAMANAGER.SetDataValue(0,"oocwi_mall_002r", "InBlock2", "ZI_HGRN_ATRB_CODE", i, g_szMainValues(i))
			DATAMANAGER.SetDataValue(0,"oocwi_mall_002r", "InBlock2", "DTL_CODE", i, g_szSubValues(i))
		next
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n002Cnt, szDataCnt
	dim	szOrgGrad, szTransGrad
	dim  nMulti, szColor
	
	dim szFee, szSaleChan, szCDSC_yn, szCLEN_yn, szCLAS_yn, szWaFd_yn, szCNVR_yn, szPNSN_yn, szAPAN_yn, szPfSv_yn 	
	
	dim nIntrIdx			'관심등록 위치
	dim szIntrCD			'관심등록된 코드
	dim	bIsmore
	
	dim div3_cnt			'펀드 한글클래스 3차분류 갯수

	dim tData1
	dim tData2

	nIntrIdx	=	0
	szIntrCD	=	""
	bIsmore	=	false
	
	if	szTranID	=	"oocwi_mall_002r"	then	
		n002Cnt 	=	grd01T1.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "oocwi_mall_002r", "OutBlock2")

		nMulti =  ( n002Cnt / szDataCnt ) - 1
		
		If szDataCnt = 0 then
			'내성향맞춤시	
			if g_Trgt_Cls_Code = "0" then	
				TblNoData.visible = 1
				lblInvestCheck.visible = 1
				lblInvestCheck.caption = "투자성향분석하기 >"
				lblNoData.visible = 0
				grd01T1.visible = 0
			else
				lblNoData.visible = 1
				grd01T1.visible = 0
				TblNoData.visible = 0
				lblInvestCheck.visible = 0
			end if
			
			Exit Sub
		else
			lblNoData.visible = 0
			TblNoData.visible = 0
			lblInvestCheck.visible = 0
			grd01T1.visible = 1
		End if
		
		
		for	i=0+(nMulti * szDataCnt) to	n002Cnt-1
		
			div3_cnt		= 0
						
			'----- 위험등급 -----
			Dim sRiskGrade
			sRiskGrade = grd01T1.GetCellData("bd_grade", i) '상품위험등급
			szTransGrad =  Form.GetMetaData("집합투자증권상품등급코드", sRiskGrade)
			
'			if sRiskGrade = "01" then
'				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_296.png")
'			elseif sRiskGrade = "02" then
'				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_297.png")
'			elseif sRiskGrade = "03" then
'				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_298.png")
'			elseif sRiskGrade = "04" then
'				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_299.png")
'			elseif sRiskGrade = "05" then
'				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_300.png")
'			else
'				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_300.png")
'			end if
			if sRiskGrade = "01" then
				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_372.png")
				grd01T1.SetCellFgColor("bd_grade",  i , 273)
			elseif sRiskGrade = "02" then
				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_373.png")
				grd01T1.SetCellFgColor("bd_grade",  i , 144)
			elseif sRiskGrade = "03" then
				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_374.png")
				grd01T1.SetCellFgColor("bd_grade",  i , 144)
			elseif sRiskGrade = "04" then
				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_375.png")
				grd01T1.SetCellFgColor("bd_grade",  i , 144)
			elseif sRiskGrade = "05" then
				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_376.png")
				grd01T1.SetCellFgColor("bd_grade",  i , 144)
			else
				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_377.png")
				grd01T1.SetCellFgColor("bd_grade",  i , 273)
			end if
			
			grd01T1.SetCellData("bd_grade", i, szTransGrad)
			
			'261 : 블랙/화이트 모두 하얀색
			'grd01T1.SetCellFgColor("bd_grade", i, 261)
			'----- 위험등급 -----
			
			
			'----- 펀드유형 -----
			grd01T1.SetCellImage("bd_type", i, "img_bgsquare_grade_316.png")
			grd01T1.SetCellFgColor("bd_type", i, 321)
			'----- 펀드유형 -----
			
			
			'----- 적정성/고난도 유형 -----
			''적정성이나 고난도인 경우, 위험등급|펀드유형|적정성/고난도|계열사 순으로 뱃지 보이고
			''적정성이나 고난도가 아닌 경우, 위험등급|펀드유형|계열사 뱃지만 보이도록 뱃지 위치 조정
			
			'21.07.12 JHY START
			'v0003
			Dim szHGDTYn, szFITYn, szSaComCode
			szHGDTYn = grd01T1.GetCellData("bd_HGDT_YN", i)	'고난도상품여부
			szFITYn = grd01T1.GetCellData("bd_FIT_YN", i)		'적정성상품여부
			szSaComCode = grd01T1.GetCellData("bd_cell4", i)	'계열사여부
		
		
			'21.09.28 JHY START : 데이터 컨트롤에 세팅해서 새로 호출할때 지우지 않고 그리고 있어, 이전 데이터가 남아있는 오류 있어 추가
			grd01T1.SetCellData("bd_StrHGDT", i, "")
			grd01T1.SetCellData("bd_StrHGDT2", i, "")
			'21.09.28 JHY END

			if szFITYn = "Y" or szHGDTYn = "Y"  then			
				'고난도나 적정성 아닌경우에도 색상이 표시되서 초기화 먼저 하고 색상 지정하기.
				grd01T1.SetCellImage("bd_type2", i, "")
				grd01T1.SetCellFgColor("bd_type2", i, 16)
				
				if szFITYn == "Y" then
					grd01T1.SetCellImage("bd_type2", i, "img_bgsquare_grade_302.png")
					grd01T1.SetCellData("bd_type2", i, "적정성상품")	'"적정성금융투자상품"
					grd01T1.SetCellFgColor("bd_type2", i, 261)
				end if
				
				if szHGDTYn == "Y" then
					if szFITYn == "Y" then
						'grd01T1.SetCellImage("bd_type2", i, "img_bgsquare_grade_302.png")
						grd01T1.SetCellImage("bd_type2", i, "img_bgsquare_grade_372.png")
						grd01T1.SetCellData("bd_type2", i, "고난도상품")	'"고난도금융투자상품"
						'grd01T1.SetCellFgColor("bd_type2", i, 261)
						grd01T1.SetCellFgColor("bd_type2", i, 273)
					else
						'grd01T1.SetCellImage("bd_type2", i, "img_bgsquare_grade_302.png")
						grd01T1.SetCellImage("bd_type2", i, "img_bgsquare_grade_372.png")
						grd01T1.SetCellData("bd_type2", i, "고난도상품")	'"고난도금융투자상품"
						'grd01T1.SetCellFgColor("bd_type2", i, 261)
						grd01T1.SetCellFgColor("bd_type2", i, 273)
					end if
				end if
				'21.07.12 JHY END	
				'----- 적정성/고난도 유형 -----
					
					
				'----- 계열사구분코드 -----
				if szSaComCode = "Y" then
					szSaComName = "계열사"
					grd01T1.SetCellImage("bd_type3", i, "img_bgsquare_grade_303.png")
					grd01T1.SetCellData("bd_type3", i, szSaComName)
					grd01T1.SetCellFgColor("bd_type3", i, 261)
				else
					szSaComName = ""
					grd01T1.SetCellImage("bd_type3", i, "")
					grd01T1.SetCellData("bd_type3", i, szSaComName)
				end if
				'----- 계열사구분코드 -----
			
			else			
				'----- 계열사구분코드 -----
				if szSaComCode = "Y" then
					szSaComName = "계열사"
					grd01T1.SetCellImage("bd_type2", i, "img_bgsquare_grade_303.png")
					grd01T1.SetCellData("bd_type2", i, szSaComName)
					grd01T1.SetCellFgColor("bd_type2", i, 261)
				else
					szSaComName = ""
					grd01T1.SetCellImage("bd_type2", i, "")
					grd01T1.SetCellData("bd_type2", i, szSaComName)
				end if
			
				grd01T1.SetCellImage("bd_type3", i, "")
				'----- 계열사구분코드 -----
			end if
			
			
			'----- 펀드정렬기준 변경시 수익률 변경 -----
			szERT1 = grd01T1.GetCellData("bd_ERT1", i)
			szERT3 = grd01T1.GetCellData("bd_ERT3", i)
			szERT6 = grd01T1.GetCellData("bd_ERT6", i)
			szERT12 = grd01T1.GetCellData("bd_ERT12", i)
			
			if cmbSort01.cbkeydata = "C" then
				grd01T1.SetCellData("bd_cell24", i, szERT1)
			elseif cmbSort01.cbkeydata = "E" then
				grd01T1.SetCellData("bd_cell24", i, szERT3)
			elseif cmbSort01.cbkeydata = "G" then
				grd01T1.SetCellData("bd_cell24", i, szERT6)			
			elseif cmbSort01.cbkeydata = "I" then
				grd01T1.SetCellData("bd_cell24", i, szERT12)
			end if
			'----- 펀드정렬기준 변경시 수익률 변경 -----
						
			'----- 수익률 폰트컬러 -----
			szZI_RLZT_ERT = grd01T1.GetCellData("bd_cell24", i)
			
			 if	szZI_RLZT_ERT	>	"0"	then
				 grd01T1.SetCellFgColor("bd_cell24", i, 10)
			 elseif	szZI_RLZT_ERT 	<	"0"	then
				 grd01T1.SetCellFgColor("bd_cell24", i, 11)
			 else
				 grd01T1.SetCellFgColor("bd_cell24", i, 12)
			 end if
			'----- 수익률 폰트컬러 -----
			
			'----- 종목명 -----
			grd01T1.setCellMaxLineCount("bd_name", 2)	''컨트롤 라인 제한 함수
			'----- 종목명 -----
			
			'v0002 sta 펀드 한글화 클래스 관련 수정
			
			'초기화
			grd01T1.SetCellData("bd_cell9", i, "")
			grd01T1.SetCellData("bd_cell11", i, "")
			grd01T1.SetCellData("bd_cell13", i, "")
			grd01T1.SetCellData("bd_cell14", i, "")
			
			'1차분류 : 수수료
			szFee = grd01T1.GetCellData("bd_cell7", i)
			if szFee = "02" then
				grd01T1.SetCellData("bd_cell9", i, "수수료선취")
			elseif szFee = "04" then
				grd01T1.SetCellData("bd_cell9", i, "수수료후취")
			else
				grd01T1.SetCellData("bd_cell9", i, "수수료미징구")
			end if
			
			grd01T1.SetCellFgColor("bd_cell9", i, "133")
						
			'2차분류 : 판매채널
			szSaleChan = grd01T1.GetCellData("bd_cell2", i)
			
			if szSaleChan = "1" then
				grd01T1.SetCellData("bd_cell11", i, "오프라인")
			elseif szSaleChan = "2" then
				grd01T1.SetCellData("bd_cell11", i, "온라인")
			else
				grd01T1.SetCellData("bd_cell11", i, "오프라인")
			end if
			
			grd01T1.SetCellFgColor("bd_cell11", i, "206")
			
			'3차분류
			szCDSC_yn = grd01T1.GetCellData("bd_cell20", i)
			szCLEN_yn = grd01T1.GetCellData("bd_cell15", i)
			szCLAS_yn = grd01T1.GetCellData("bd_cell16", i)
			szWaFd_yn = grd01T1.GetCellData("bd_cell17", i)
			szCNVR_yn = grd01T1.GetCellData("bd_cell18", i)
			szPNSN_yn = grd01T1.GetCellData("bd_cell19", i)
			szAPAN_yn = grd01T1.GetCellData("bd_cell21", i)
			szPfSv_yn = grd01T1.GetCellData("bd_cell22", i)
			
			if szCDSC_yn <> "N" then
				'한글클래스 3차분류 1개 펀드
				grd01T1.SetCellData("bd_cell13", i, "보수체감")
				
				div3_cnt = div3_cnt + 1
			end if
			
			if szCLEN_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "무권유저비용")
				else
					grd01T1.SetCellData("bd_cell13", i, "무권유저비용")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szCLAS_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					if szCLAS_yn = "F" then
						grd01T1.SetCellData("bd_cell14", i, "기관전용")
					elseif szCLAS_yn = "W" then
						grd01T1.SetCellData("bd_cell14", i, "랩전용")
					else
						grd01T1.SetCellData("bd_cell14", i, "고액")
					end if
				'한글클래스 3차분류 1개 펀드
				else
					if szCLAS_yn = "F" then
						grd01T1.SetCellData("bd_cell13", i, "기관전용")
					elseif szCLAS_yn = "W" then
						grd01T1.SetCellData("bd_cell13", i, "랩전용")
					else
						grd01T1.SetCellData("bd_cell13", i, "고액")
					end if
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szCNVR_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "전환가능")
				else
					grd01T1.SetCellData("bd_cell13", i, "전환가능")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szPNSN_yn <> "N" then
			
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "개인연금")
				else
					grd01T1.SetCellData("bd_cell13", i, "개인연금")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szAPAN_yn <> "N" then
