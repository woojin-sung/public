Sub imgOnline_OnClick()
	if CInt(ChkButton1.checkstate) == 1 then
		f_SetCheck1State(false)
	else
		f_SetCheck1State(true)
	end if
End Sub

'============================================================================
Function f_SetCheck1State(bValue)
	if bValue == true then
		'온라인전용 체크시
		ChkButton1.chksilence = "1"
		imgOnline.imgpath = CheckImgPath
		
		nChanCnt = "1"	'1건만 선택
		g_szChan	=	"1★SALE★2" & "★"
		
		Form.SetSharedData("51000_CHAN",	nChanCnt & "★" & g_szChan)
	else
		'온라인전용 체크 해제시
		ChkButton1.chksilence = "0"
		imgOnline.imgpath = unCheckImgPath
	
		nChanCnt = "1"	'1건만 선택
		g_szChan	=	"1★SALE★1" & "★"
		
		Form.SetSharedData("51000_CHAN",	nChanCnt & "★" & g_szChan)
	end if
	
	DATAMANAGER.RequestTranData( "oocwi_mall_002r" )
End Function


