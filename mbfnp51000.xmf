Sub imgCheck_OnClick()
	if CInt(ChkButton0.checkstate) == 1 then
		f_SetCheckState(false)
	else
		f_SetCheckState(true)
	end if
End Sub

'============================================================================
Function f_SetCheckState(bValue)
	if bValue == true then
		ChkButton0.chksilence = "1"
		imgCheck.imgpath = CheckImgPath

		g_Trgt_Cls_Code = "0"	'내성향맞춤시	
				
		'-----------------------------------------------
		''내성향맞춤시 : 투자성향에 맞는 펀드 우선 검색
		'-----------------------------------------------
		IF g_szInvType = "01" then
		
			g_szGrade = "6★KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"
'			lblInvTypeNm.caption = "고수익지향형"
'			lblInvTypeNm.fgcolor = "326"
		
		elseif g_szInvType = "02" then
		
			g_szGrade = "4★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"
'			lblInvTypeNm.caption = "성장지향형"
'			lblInvTypeNm.fgcolor = "326"
			
		elseif g_szInvType = "03" then
		
			g_szGrade = "3★KYCD★04★KYCD★05★KYCD★06★"
'			lblInvTypeNm.caption = "중립형"
'			lblInvTypeNm.fgcolor = "328"
			
		elseif g_szInvType = "04" then
						
			g_szGrade = "2★KYCD★05★KYCD★06★"
'			lblInvTypeNm.caption = "안정지향형"
'			lblInvTypeNm.fgcolor = "328"
			
		elseif g_szInvType = "05" then	
		
			g_szGrade = "1★KYCD★06★"
'			lblInvTypeNm.caption = "이자소득형"
'			lblInvTypeNm.fgcolor = "329"
		end if

		DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
		DATAMANAGER.RequestTranData( "obcsb_acif_798r" )
		DATAMANAGER.RequestTranData( "oocwi_mall_002r" )
	else
		ChkButton0.chksilence = "0"
		imgCheck.imgpath = unCheckImgPath

		'전문투자자인 경우 체크해지하더라도 팝업 미생성
		if g_szSpclInvrYn = "Y" then

			'-----------------------------------------------
			'내성향맞춤해제시	전체조회
			'-----------------------------------------------
			g_Trgt_Cls_Code = "1"	'내성향맞춤해지
			g_szGrade = "6★KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"
'			g_szGrade = ""	
			
			DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
			DATAMANAGER.RequestTranData( "obcsb_acif_798r" )
			DATAMANAGER.RequestTranData( "oocwi_mall_002r" )
		else
'			if g_szRcmdClsCode == "3" or g_szRcmdClsCode == "4" then	'KYC투자권유구분코드
'				'미희망(불원)&미제공 or 미희망(불원)&제공 인 경우, 체크해지하면 팝업 생성 후 전체상품조회
				Form.openPopupAnimation("mbfnp51000_p10", "", "", "2")
'			else
'				' 내성향맞춤 체크해제시, 안내 팜업 확인 후 전체등급의 상품 조회 가능.
'				Form.openPopupAnimation("mbfnp51000_p10", "", "", "2")
'			end if
		end if
	end if
End Function

