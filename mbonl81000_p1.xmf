	<SCRIPT_INFO _len="4611" _ulen="4371" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객연락처변경
' 02. 화면설명 : 고객연락처변경_전화번호입력창
' 03. 작    성 : 2016.01.25 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sTyp '전화번호종류구분

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData, sTemp
	g_sRetData = "cancel"
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or sRevData == "" then
		Exit Sub
	end if
	
	sTemp = Split(sRevData, ";")
	g_sTyp = sTemp[1]
	if sTemp[0] == "Register" then
		Form.SetScreenName("전화번호 등록")
	elseif sTemp[0] == "Modify" then
		Form.SetScreenName("전화번호 변경")
	end if
	
	if g_sTyp == "page0_Phone" then '휴대폰전화번호
		Cont0.visible = true
		
		Cont0.Table0.SetCellString( 1, 1, "휴대폰" )
	else '자택/직장/Fax전화번호
		Cont1.visible = true
		
		if g_sTyp == "page0_Home" then
			Cont1.Table1.SetCellString( 0, 1, "자택전화" )
			Cont1.Table1.SetCellString( 1, 3, "" )
			Cont1.EditInput4.visible = false
		elseif g_sTyp == "page0_Office" then
			Cont1.Table1.SetCellString( 0, 1, "직장전화" )
		elseif g_sTyp == "page0_Fax" then
			Cont1.Table1.SetCellString( 1, 3, "" )
			Cont1.EditInput4.visible = false
			
			Cont1.Table1.SetCellString( 0, 1, "FAX" )
		end if
	end if
End Sub

'============================================================================
Sub Cont0_EditPInput1_OnEditChar(CharCode)
	if #CharCode >=3 then
		Cont0.EditPInput2.SetShowKeypad( true )
	end if
End Sub

'============================================================================
Sub Cont0_EditPInput2_OnEditChar(CharCode)
	if #CharCode >=4 then
		Cont0.EditPInput3.SetShowKeypad( true )
	end if
End Sub

'============================================================================
Sub Cont1_EditInput1_OnEditChar(CharCode)
	if #CharCode >=3 then
		Cont1.EditInput2.SetShowKeypad( true )
	end if
End Sub

'============================================================================
Sub Cont1_EditInput2_OnEditChar(CharCode)
	if #CharCode >=4 then
		Cont1.EditInput3.SetShowKeypad( true )
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Dim sSendData
	
	if g_sTyp == "page0_Phone" then '휴대폰전화번호
		if Cont0.EditPInput1.caption == "" or Cont0.EditPInput2.caption == "" or Cont0.EditPInput3.caption == "" then
			Form.MsgBox( "알림", "전화번호를 입력해주세요.", "", 6 )
			Exit Sub
		end if
		
		g_sRetData = "ok"
	
		sSendData = Cont0.EditPInput1.caption..";"..Cont0.EditPInput2.caption..";"..Cont0.EditPInput3.caption
		Form.SetSharedData("mbonl81000_p1" , sSendData)
		Form.SetSharedData("mbonl81000_p1_Rdo" , Cont0.RadioGroup0.currentindex)
		Form.CloseForm()
	else '자택/직장/Fax전화번호
		if Cont1.EditInput1.caption == "" or Cont1.EditInput2.caption == "" or Cont1.EditInput3.caption == "" then
			Form.MsgBox( "알림", "전화번호를 입력해주세요.", "", 6 )
			Exit Sub
		end if
		
		g_sRetData = "ok"
		
		if g_sTyp == "page0_Fax" then
			sSendData = Cont1.EditInput1.caption..";"..Cont1.EditInput2.caption..";"..Cont1.EditInput3.caption
		else
			sSendData = Cont1.EditInput1.caption..";"..Cont1.EditInput2.caption..";"..Cont1.EditInput3.caption..";"..Cont1.EditInput4.caption
		end if
		
		Form.SetSharedData("mbonl81000_p1" , sSendData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81000_p1" , g_sRetData)
End Sub



	</SCRIPT_INFO>
</ROOT>