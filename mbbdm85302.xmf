<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="85302" scrname="바이오인증 등록완료" version="2" writer="홍수지" />
	<FORM_INFO name="Form" autosize="1" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="Image0" autosize="1" imgpath="icon_ok" ly_vert="153,140,70,70,1" />
		<LABEL name="Label0" fontsize="8" fontstyle="01" caption="간편번호(PIN) 등록 완료" halign="1" ly_vert="20,230,335,26,1" />
		<LABEL name="Label1" caption="PIN번호가 정상 등록되었습니다." halign="1" ly_vert="20,276,335,18,1" />
		<BUTTON name="Button0" caption="확인" bgcolor="085:205216147" bgcolor2="102:216216216" fontsize="4" fontstyle="01" btnimage="btn_10.9" ly_vert="0,587,375,60,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1297" _ulen="1107" >
Dim g_Ostype
'============================================================================
Sub Button0_OnClick()
	Form.SetEnvData(1, "login.input.savetab", "3")	'로그인 화면 이동시, 바로 바이오인증으로 이동
	Form.SendReturnToParent("CloseForm", "1" )
	'20220805_01 KBC START : 로그인개선
	Form.SetSharedData("&SCREEN_AUTH"      , "" )  	'v0001 비대면화면 권한 프리
	Form.SetSharedData("BDM_BIOREG" , "Y")			'mhetc90022 화면 닫기 FLAG
	Form.OpenNextPopup("mhetc90021" , "" , "")
'	20220805_01 KBC END
	'Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnFormInit()
	g_gubun = Form.GetOpenLinkData()
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	if g_gubun = "register_finger" then
		if g_Ostype = "1" then
			Label0.caption = "지문 등록 완료"
			Label1.caption = "지문이 정상 등록되었습니다."
		elseif g_Ostype = "2" then
			Label0.caption = "지문/Face ID 등록 완료"
			Label1.caption = "지문/Face ID가 정상 등록되었습니다."
		end if
	elseif g_gubun = "register_pin" then
		Label0.caption = "간편번호(PIN) 등록 완료"
		Label1.caption = "PIN번호가 정상 등록되었습니다."
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>