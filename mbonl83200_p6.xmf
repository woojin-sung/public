<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="83200" scrname="공개매수_유의사항" version="2" writer="김철중" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<LABEL name="lblDot0" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,19,7,60,1" />
		<LABEL name="lbl0" caption="신청시점의 '결제 완료된 현금주식 잔고'만 청약 신청이 가능합니다.
(신용 및 대출 잔고는 신청 불가) " valign="0" multiline="1" ly_vert="25,19,330,60,1" />
		<LABEL name="lblDot1" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,79,7,40,1" />
		<LABEL name="lbl1" caption="세제형계좌 및 Wrap계좌에 보유중인 잔고는 청약 신청이 불가합니다." valign="0" multiline="1" ly_vert="25,79,330,40,1" />
		<LABEL name="lbl2" caption="일부 수량 신청 후 추가 신청시에는 기존 신청분을 취소 후 재신청해 주시기 바랍니다." valign="0" multiline="1" ly_vert="25,119,330,40,1" />
		<LABEL name="lblDot2" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,119,7,40,1" />
		<LABEL name="lbl3" caption="청약취소는 청약기간 중 언제든지 취소가능하며 단, 취소시 부분 취소는 불가합니다." valign="0" multiline="1" ly_vert="25,159,330,40,1" />
		<LABEL name="lblDot3" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,159,7,40,1" />
		<LABEL name="lbl4" caption="청약 마지막날 온라인 신청 및 취소는 16:00까지만 신청이 가능합니다." valign="0" multiline="1" ly_vert="25,199,330,40,1" />
		<LABEL name="lblDot4" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,199,7,40,1" />
		<LABEL name="lbl5" caption="경쟁률에 의거 비례배분되므로, 신청수량과 최종 배정수량은 다를 수 있습니다." valign="0" multiline="1" ly_vert="25,259,330,40,1" />
		<LABEL name="lblDot5" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,259,7,40,1" />
		<LABEL name="lbl6" caption="매수대금은 결제일에 청약계좌로 자동 입금됩니다." valign="0" multiline="1" ly_vert="25,299,330,40,1" />
		<LABEL name="lblDot6" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,299,7,40,1" />
		<LABEL name="lblDot7" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,339,7,60,1" />
		<LABEL name="lbl7" caption="매수대금(확정수량 * 주당매수가격)의 0.35%를 증권거래세로 징수하며, 매수대금에서 증권거래세를 차감한 금액이 계좌로 입금됩니다." valign="0" multiline="1" ly_vert="25,339,330,60,1" />
		<LABEL name="lbl8" caption="공개매수는 장외거래로 간주되어 소득세법에 따라 양도차익에 대해 양도소득세가 과세될 수 있습니다." valign="0" multiline="1" ly_vert="25,399,330,60,1" />
		<LABEL name="lblDot8" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,399,7,60,1" />
		<LABEL name="lbl9" caption="양도소득세는 고객이 직접 관할 세무서에 신고 및 납부하는 세금이며, 과세표준, 세율, 신고방법 및 납부방법은 해당 법령을 참고하시기 바랍니다." valign="0" multiline="1" ly_vert="25,459,330,60,1" />
		<LABEL name="lblDot9" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,459,7,60,1" />
		<LABEL name="lbl10" caption="청약 후 신청수량은 매도 및 출고가 불가합니다." valign="0" multiline="1" ly_vert="25,239,330,40,1" />
		<LABEL name="lblDot10" caption="·" valign="0" paddinginfo="1,0,0,0" ly_vert="18,239,7,40,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="411" _ulen="391" >
