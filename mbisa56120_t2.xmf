'============================================================================
Sub LoadLinkData()
	g_sSTEP1_SendData = Form.GetSharedData(g_sSharedKey & "_INFO_STEP_LINK", false)
	g_sSendData = Form.GetSharedData(g_sSharedKey & "_STEP_LINK", false)
'	Form.ShowAlert(g_sSharedKey, g_sSendData)
	
	if g_sSTEP1_SendData <> null and g_sSTEP1_SendData <> "" then
'		Form.ShowAlert("g_sSTEP1_SendData", g_sSendData)
		g_szSTEP1_List = Split(g_sSTEP1_SendData,"★")
	end if
	
	if g_sSendData <> null and g_sSendData <> "" then
'		Form.ShowAlert("g_sSendData", g_sSendData)
		g_szList = Split(g_sSendData,"★")
		
		if UBOUND(g_szList) > 0 then
			DATAMANAGER.RequestTranData("obwat_csad_003r")	
			Call SetTableData()
		else
			Exit Sub
		end if
	end if
		
End Sub

