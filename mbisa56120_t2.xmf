		Exit Sub
	End If
	
	Form.OpenFramePopup( "mhetc90060_p5" , "" , "")	'공인인증서 비밀번호 입력
	
	'테스트용 인증스킵
'	If cont0.chkSkip.checkstate = "1" Then
'		DATAMANAGER.RequestTranData("obwat_ctad_047a")
'	Else
'		Form.OpenFramePopup( "mhetc90060_p5" , "" , "")	'공인인증서 비밀번호 입력
'	End If
'	DATAMANAGER.RequestTranData("obwat_ctad_047a")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_csad_003r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szList(21))	'랩상품코드
	End If
	
	'v0003
	If szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))		'계좌번호
	End If
	
	'v0003
	If szTranID == "obcsb_acad_122a" Then
		If g_szList(54) == "05" Then  '알림톡/문자
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , cont0.Edit6.Caption)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , cont0.Edit5.Caption)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , cont0.Edit0.Caption)
		Else                                                                       '이메일
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , cont0.Edit3.Caption)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , cont0.Edit4.Caption)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , cont0.Edit1.Caption)
		End If 
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szList(23))
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	End If
	
	if szTranID == "obwat_ctad_047a" then
		dim sData, sWA_GOAL_ERT, sLOSS_LIMT_RATE, sCheckTime1, sCheckTime2
		sData = Form.GetSharedData( "&HOST_DATE", false )
		sCheckTime1 = Form.GetSharedData(g_sSharedKey & "_STEP2_CHECK1", false )
		sCheckTime2 = Form.GetSharedData(g_sSharedKey & "_STEP2_CHECK2", false )
		
		If g_szList(51) == "" then
			sWA_GOAL_ERT = "0.00"
		Else
			sWA_GOAL_ERT = CDbl(g_szList(51))/100
		End If
		
		If g_szList(52) == "" then
			sLOSS_LIMT_RATE = "0.00"
		Else
			sLOSS_LIMT_RATE  = CDbl(g_szList(52))/100
		End If
		
		'이벤트헤더 설정
		DATAMANAGER.SetEventFlag( szTranID, g_sProcType )
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CNCL_YN", 0, "N" ) '취소여부

		if g_sProcType == "D" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNCL_YN", 0, "Y")
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_DATE", 0, g_sAPLT_DATE) '신청일자
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_SRNO", 0, g_sAPLT_SRNO) '신청일련번호
		end if 
		
		'InBlock1
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE"	, 0, "Z"	) '처리구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD"  			, 0, g_szSTEP1_List(2)	) '비밀번호
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 			, 0, g_szSTEP1_List(0)	) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 			, 0, g_szSTEP1_List(1)	) '계좌일련번호
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RRNO" 			, 0, g_szSTEP1_List(11)) '
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISA_ISTU_CODE" 	, 0, g_szSTEP1_List(4)	) '대외기관코드(은행코드?)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OTCO_ACNO" 	, 0, g_szSTEP1_List(5) & g_szSTEP1_List(6) ) '타사계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RCNO_PIP"  	, 0, g_szSTEP1_List(7)	) '실명확인번호
		
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISA_TFCT_CLCD"  				, 0, "02" 	) 'ISA이수관구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISA_ACNT_PRE_TYPE_CLCD"			, 0, g_szSTEP1_List(9)	) 'ISA계좌이전유형구분코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISA_ACNT_MOVE_INTN_CNFR_CLCD"	, 0, g_szSTEP1_List(8)	) 'ISA계좌이전의사확인구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNM"  						, 0, g_szSTEP1_List(10)) '이름
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"  						, 0, g_szSTEP1_List(3)	) '고객번호
		
		'InBlock3"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ELCT_DOCU_HNDV_HOUR1"		, 0, sCheckTime1		) '확인사항체크일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ELCT_DOCU_HNDV_HOUR2"		, 0, sCheckTime2		) '일반적인유의사항체크일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ELCT_DOCU_HNDV_HOUR3"		, 0, g_szList(26)		) 'ISA계약권유문서 교부일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ELCT_DOCU_HNDV_HOUR4"		, 0, g_szList(27)		) 'ISA약관 교부일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ELCT_DOCU_HNDV_HOUR5"		, 0, g_szList(28)		) 'MP설명서 교부일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "CNDC_RECV_MTHD_CLCD"		, 0, g_szList(54)		) '계약서수령방법코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "LNKD_ACNO"					, 0, g_szList(43)		) '연계계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "LNKD_ASNO"					, 0, g_szList(44)		) '연계계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ATMT_CANC_YN"				, 0, g_szList(41)		) '만기처리
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "SNML_INAG_TYPE_CODE"		, 0, g_szList(45)		) '발송물통보처유형코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "ASET_RE_DSTR_PRIR_NTFY_CLCD"	, 0, g_szList(47)		) '사전운용통지발송처
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "WA_GOAL_ERT"             	, 0, sWA_GOAL_ERT		) '목표수익률	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "LOSS_LIMT_RATE"          	, 0, sLOSS_LIMT_RATE	) '손절수익률
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "WA_AFCO_LIST_INVT_YN"		, 0, g_szList(49) 	) '랩어카운트계열사리스트투자여부
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "WA_MGRI_EMPNO"				, 0, g_szList(57) 	) '랩어카운트운용직원번호
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "CNTM_MNCN"					, 0, "60" 			) '계약기간월수
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "CONT_CLS_CODE"				, 0, "4" 			) '접촉구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "WA_PRCD"     				, 0, g_szList(21)		) '상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "KEYN_HOUR"   				, 0, g_szList(8)		) '키인시간(동영상시청시각)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "PIC_WAT_YN"				, 0, "Y"				) '동영상시청여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "PIC_WAT_DATE"				, 0, g_szList(7)		) '동영상시청일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "PIC_WAT_TIME"				, 0, g_szList(8)		) '동영상시청시각
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "SEQ1"						, 0, g_szList(56)		) '순서1
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock3", "PPRT_PRSS_RECV_MTHD_CLCD"	, 0, ""				) '재산현황수령방법구분코드
	end if
	
	if szTranID == "obwat_ctad_050a" then
		'이벤트헤더 설정
		DATAMANAGER.SetEventFlag( szTranID, "I" )
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" 					, 0, g_szSTEP1_List(0)	) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD"     				, 0, g_szList(21)		) '상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_MGRI_EMPNO"				, 0, g_szList(57) 	) '랩어카운트운용직원번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SNML_INAG_TYPE_CODE"		, 0, g_szList(45)		) '발송물통보처유형코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LNKD_ACNO"					, 0, g_szList(43)		) '연계계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LNKD_ASNO"					, 0, g_szList(44)		) '연계계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD"  						, 0, g_szSTEP1_List(2)	) '비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_INDV_MGRI_ASNO" 			, 0, g_szSTEP1_List(1)	) '계좌일련번호
		' 대표운용계좌를 제외해야한다.  대표계좌하나를 제외한다. 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SEQ1"						, 0, Int(g_szList(56)) -1	) '순서1
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CNTM_MNCN"					, 0, "36" 			) '계약기간월수
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE"				, 0, "4" 			) '접촉구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"  					, 0, g_szSTEP1_List(3)	) '고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ATMT_CANC_YN"				, 0, g_szList(41)		) '만기처리
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASET_RE_DSTR_PRIR_NTFY_CLCD"	, 0, g_szList(47)		) '사전운용통지발송처
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "APLT_DATE"					, 0, g_sAPLT_DATE		) '신청일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "APLT_SRNO"					, 0, g_sAPLT_SRNO		) '신청일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO"				, 0, g_szList(23)		) '금융상품일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO"		, 0, "00001"			) '금융상품세부일련번호(00001 고정)
	end if
	
	if szTranID == "obwat_move_014r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO", 0, g_szSTEP1_List(0)	) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO", 0, g_szSTEP1_List(1)	) '계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD" , 0, g_szSTEP1_List(2)	) '비밀번호
		
	end if
	
	if szTranID == "obwat_ctad_017a" then
		dim sWA_GOAL_ERT, sLOSS_LIMT_RATE
		
		If g_szList(51) == "" then
			sWA_GOAL_ERT = 0
		Else
'			sWA_GOAL_ERT = CDbl(g_szList(51))/100
			sWA_GOAL_ERT = CDbl(g_szList(51))
		End If
		
		If g_szList(52) == "" then
			sLOSS_LIMT_RATE = 0
		Else
'			sLOSS_LIMT_RATE  = CDbl(g_szList(52))/100
			sLOSS_LIMT_RATE  = CDbl(g_szList(52))
		End If
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" 					, 0, g_szSTEP1_List(0)	) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_CNRC_NO" 				, 0, g_sWA_CNRC_NO	) '랩어카운트 계약번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD"     				, 0, g_szList(21)		) '상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_AFCO_LIST_INVT_YN"		, 0, g_szList(49) 	) '랩어카운트계열사리스트투자여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_GOAL_ERT"             	, 0, sWA_GOAL_ERT		) '목표수익률	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LOSS_LIMT_RATE"          	, 0, sLOSS_LIMT_RATE	) '손절수익률
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RSEV_YN"          			, 0, "Y"				) '예약여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "MOD_CCLS_YN"          		, 0, "Y"				) '변경확정여부	
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_csad_003r" then
		Dim sRiskCode, sRiskText
		
		sRiskCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WA_PROD_RISK_CLCD" , 0)	
'		Select Case sRiskCode
'			Case "01"
'				sRiskText = "초고위험"
'			Case "02"
'				sRiskText = "고위험"
'			Case "03"
'				sRiskText = "중위험"
'			Case "04"
'				sRiskText = "저위험"
'			Case "05"
'				sRiskText = "초저위험"
'		End Select
		
		sRiskText = Form.GetMetaData("KYC상품등급코드", sRiskCode)
		cont0.tbl0.SetCellString( 4, 1, sRiskText)				'위험등급	
		
		'v0003
		DATAMANAGER.RequestTranData("obcsb_acif_140r")
	End If
	
	'v0003
	Dim iCnt, iCnt1
	If szTranID == "obcsb_acif_140r" then
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
				    cont0.Edit1.Caption = strAddr
				    cont0.Edit3.Caption = strInagTypeCode2
				    cont0.Edit4.Caption = strInagSrno2
			    End If
			Next 	
			
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    cont0.Edit0.Caption = strCustTelno
				    cont0.Edit6.Caption = strInagTypeCode3
				    cont0.Edit5.Caption = strInagSrno3
			    End If
			Next 
		End If 
	End If
	
	If szTranID == "obwat_ctad_047a" then
		if g_sProcType == "I" then
			g_sAPLT_DATE = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_DATE" , 0)	
			g_sAPLT_SRNO = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SRNO" , 0)	
			
			if (g_sAPLT_DATE <> "" and g_sAPLT_DATE <> null) and (g_sAPLT_SRNO<>"" and g_sAPLT_SRNO <>null) then
				DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
			end if
			
		elseif g_sProcType == "D" then
			'이어가기 저장 내역 지우기
			dim sDate
			sDate = Form.GetSharedData("&HOST_DATE", false)
			
			DATAMANAGER.ClearInputData( 0, "obwat_ctad_068a")
			DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "ACNO" 				, 0 , g_szSTEP1_List(0) ) '계좌번호
			DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "ASNO" 				, 0 , g_szSTEP1_List(1) ) '계좌번호
			DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "APLT_DATE"  			, 0 , sDate 			) '신청일자
			DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "REG_STAG_CLS_CODE" 	, 0 , ""				) 'STEP
			DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "PWD"  				, 0 , g_szSTEP1_List(2) )
			DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "ANTC_PNSN_RECV_CNTT1"	, 0 , ""		) '저장정보
		
			DATAMANAGER.RequestTranData( "obwat_ctad_068a" )
			
		end if
	End If

	If szTranID == "obcsb_acad_122a" then
		DATAMANAGER.RequestTranData("obwat_ctad_050a")
	End IF
	
	if szTranID == "obwat_ctad_050a" then
		DATAMANAGER.RequestTranData( "obwat_move_014r" )
	end if
	
	if szTranID == "obwat_move_014r" then
		g_sWA_CNRC_NO = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "WA_CNRC_NO"))
		if g_sWA_CNRC_NO <> "" and g_sWA_CNRC_NO <> null then
			DATAMANAGER.RequestTranData( "obwat_ctad_017a" )
		end if
	end if
	
	if szTranID == "obwat_ctad_017a" then
		Form.MsgBox("알림" , "ISA 전환신청이 완료되었습니다.", "Close", 6)
	end if
	
	if szTranID == "obwat_ctad_068a" then
		if g_sProcType == "D" then
			Form.OpenScreen("41000" , "")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obwat_ctad_047a" then
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "Close", 0 )
		
	elseif szTranID == "obwat_ctad_050a" or szTranID == "obwat_ctad_017a" then
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "Error", 0 )
	else
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "Close", 0 )
	end if
End Sub

