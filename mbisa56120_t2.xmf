Sub Form_OnFormInit()
'	Call LoadLinkData()
	g_sProcType = "I"
	
	'테스트용 인증스킵 체크
    nDev = Form.GetSharedData("&SERVER_MODE", False )
    cont0.chkSkip.visivle = False
    
'    If nDev == "1" Or nDev == 1 Then
'	    cont0.chkSkip.visible = True
'    Else
'	    cont0.chkSkip.visivle = False
'	    cont0.chkSkip.checkstate = "0"
'    End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'STEP1의 계좌번호 변경시 Data Clear
	If sEventName == "CLEAR_DATA" Then	
		cont0.chk0.checkstate = "0"
		cont0.chk1.checkstate = "0"
		cont0.scroll_pos = 0
	End If
	
	'[입력데이터 재로드]
	'다음 버튼 클릭시 SetSharedData한 후, 다음 화면 Form_OnFormInit에서 GetSharedData 하는데,
	'입력내용 유지 위해 폼 변환시 Unload를 하지 않으므로, 
	'이전 화면으로 돌아가 데이터 변경 후 다음 버튼 클릭시, Form_OnFormInit을 타지 않음 
	'-> Trigger로 GetSharedData 재호출
	If sEventName == "RELOAD_DATA" Then
		Call LoadLinkData()
	End If
	
	If sEventName == "SET_ONLINE_CODE" Then
		if sParam <> null and sParam <> "" then
			g_sOnline_Code = sParam
		end if
		
	elseif sEventName == "SET_SHARED_KEY" then
		if sParam <> null and sParam <> "" then
			g_sSharedKey = sParam
			
			Call LoadLinkData()
		end if
		
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbisa56060_p9" then
		If sRet == "ok" then
			cont0.chk1.checkstate = "1"
		Else
			cont0.chk1.checkstate = "0"
		End If
	End If
	
	If sKeyName == "mhetc90060_p5" then
		If Left(sRet,2) == "ok" then
			DATAMANAGER.RequestTranData("obwat_ctad_047a")
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "Close" then
		Form.OpenScreen("41000" , "")
	elseif sKeyName == "Error" then
		g_sProcType = "D"
		DATAMANAGER.RequestTranData( "obwat_ctad_047a" )
		
	End If
End Sub

