'============================================================================
Sub SetTableData()
	'의무기간
	Dim sPeriod
	
	If g_szList(4) == "66" then		'일반형
		sPeriod = "36" 'v0001. 의무기간 변경 60 -> 36
	ElseIf g_szList(4) == "67" then	'청년형
		sPeriod = "36"
	ElseIf g_szList(4) == "73" then	'서민형
		sPeriod = "36"
	Else
		sPeriod = "36"	
	End If
'	cont0.tbl0.SetCellString( 8, 1, sPeriod)			
	
	cont0.tbl0.SetCellString( 0, 1, g_szList(0) & g_szList(1))		'신청계좌번호
'	cont0.tbl0.SetCellString( 1, 1, g_szList(5))					'가입자유형
	cont0.tbl0.SetCellString( 1, 1, CInt(g_szList(6)))					'연령
	cont0.tbl0.SetCellString( 2, 1, g_szList(20))					'투자성향
	cont0.tbl0.SetCellString( 3, 1, g_szList(22))					'상품명
'	cont0.tbl0.SetCellString( 6, 1, g_szList(40))					'계약금액
	cont0.tbl0.SetCellString( 5, 1, g_szList(42))					'만기처리
	cont0.tbl0.SetCellString( 6, 1, g_szList(43) & g_szList(44))	'연계계좌번호
	cont0.tbl0.SetCellString( 7, 1, g_szList(46))				'보고서발송처
	cont0.tbl0.SetCellString( 8, 1, g_szList(55))				'계약서수령방법
	cont0.tbl0.SetCellString( 9, 1, g_szList(48))				'사전운용통지
	cont0.tbl0.SetCellString( 10, 1, g_szList(51))				'목표수익률
	cont0.tbl0.SetCellString( 11, 1, g_szList(52))				'손절수익률
	cont0.tbl0.SetCellString( 12, 1, g_szList(50))				'계열사종목
End Sub

