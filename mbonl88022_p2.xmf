'============================================================================
' 화 면 명 : 대차중개약정 약관동의
'============================================================================


Dim g_sRetData 					'리턴데이터
Dim g_szTheme                  		'테마구분  white/black
dim g_szUnCheckImg, g_szCheckImg	'체크이미지
dim g_szUnCheckFg, g_szCheckFg		'체크 폰트 컬러
Dim g_ChkAll						'전체동의여부
Dim g_Chk1						'첫번째 약관
Dim g_Chk2						'두번째 약관
Dim g_ServerMode

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	Select Case iIdx
		Case 1
			szTitle = "증권 대차중개서비스 약관"
		Case 2
			szTitle = "증권 대차거래서비스 핵심설명서"
	End Select
	return szTitle
End Function

'============================================================================
'f_sGetURL(iIdx) : 각 동의체크 별 안내팝업 URL 리턴
'============================================================================
Function f_sGetURL(iIdx)		
	dim sURLheader, sURL
	Select Case iIdx
		Case 1
			'"증권 대차중개서비스 약관"
			If g_ServerMode == "1" Then	'개발기
				'sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/"
				sURLheader = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/"
			Else
				sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "meritz_yk_45.html"
		Case 2
			'"증권 대차거래서비스 핵심설명서"
			If g_ServerMode == "1" Then	'개발기
				sURLheader = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/"
			Else
				sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "meritz_info_05.html"
	End Select
	return sURL
End Function

'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)
	if iIdx == 0 then
		szURL = f_sGetURL(1) & "★" & f_sGetURL(2)
		szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2)
			
		'팝업 호출
		if szURL <> "" then
'			Form.OpenPopup("mbonl88024_p7" , szURL&"♥"&szTitle, "")
			Form.OpenPopup("mbonl88022_p6" , szURL&"♥"&szTitle, "")
		end if		
	else
		Form.SetSharedData("OPEN_URL", f_sGetURL(iIdx) )
'		Form.OpenFramePopup("mbonl82020_p6" , f_sGetURLTitle(iIdx), "")	
		Form.OpenPopup("mbonl88022_p5" , f_sGetURLTitle(iIdx), "")	
	end if
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()

	g_ChkAll = "0"	
	imgUIAllChk.imgpath = g_szUnCheckImg
	lblAllText.fgcolor  = g_szUnCheckFg
	

	if g_Chk1 <> "1" then
		BtnContinue.enable = false
		
		if Form.GetEnvData("common.theme") = "black" then
			BtnContinue.btnimage = "btn_27.9"
		else
			BtnContinue.btnimage = "btn_21.9"
		end if
		BtnContinue.fgcolor = "269"
		
		if g_Chk2 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		
		Exit Function	
	end if
	
	if g_Chk2 <> "1" then
		BtnContinue.enable = false
		
		if Form.GetEnvData("common.theme") = "black" then
			BtnContinue.btnimage = "btn_27.9"
		else
			BtnContinue.btnimage = "btn_21.9"
		end if
		BtnContinue.fgcolor = "269"

		if g_Chk1 <> "1" then
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function	
	end if	
	
	g_ChkAll = "1"	
	imgUIAllChk.imgpath = g_szCheckImg
	lblAllText.fgcolor  = g_szCheckFg			
	
	'신청가능
	BtnContinue.btnimage = "btn_20.9"
	BtnContinue.fgcolor = "273"
	
	BtnContinue.enable = true
	
End Function

'============================================================================
'각 체크 별 기능 동작
'============================================================================
Function f_SetChkState(iIdx, bValue)

	'전체동의
	if iIdx == 0 then
	
		if bValue == true then	
		
			g_ChkAll = "1"	
			imgUIAllChk.imgpath = g_szCheckImg
			lblAllText.fgcolor  = g_szCheckFg			
		
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
			
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg			
		else
			g_ChkAll = "0"	
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg			
			
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
			
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg			
		end if	
	
	'약관동의
	elseif iIdx == 1 then
	
		if bValue == true then	
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
		else
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
		end if		
	
	'핵심설명서 동의
	elseif iIdx == 2 then
	
		if bValue == true then	
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg
		else
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg
		end if		
		
	end if
	
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()	
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	g_szUnCheckImg 	= "icon_chk_on.png"
	g_szCheckImg 		= "icon_chk_off.png"
	g_szUnCheckFg 	= "127"
	g_szCheckFg 		= "4"	
End Sub


'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동Y
	'부모창(mbonl88024) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

	'이미지설정
	if Form.GetEnvData("common.theme") = "black" then
		BtnContinue.btnimage = "btn_27.9"
	else
		BtnContinue.btnimage = "btn_21.9"
	end if
	BtnContinue.fgcolor = "269"
	
	'초기화..	
	f_SetChkState(0, false)	
	
	g_sRetData = "cancel"
	
	'신청가능
	BtnContinue.enable = false	
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	if sKeyName == "mbonl82020_p6" then
	if sKeyName == "mbonl88022_p5" then	
		If sRet == "증권 대차중개서비스 약관" Then
			f_SetChkState(1, true)
		ElseIf sRet == "증권 대차거래서비스 핵심설명서" Then
			f_SetChkState(2, true)
		End If		
		
'	elseif sKeyName == "mbonl88024_p7" then	'전체동의
	elseif sKeyName == "mbonl88022_p6" then	'전체동의
		'전체동의 팝업
		'if sRet == "mbonl87056_p1_All" then		
		if sRet == "AGREE" then		
			f_SetChkState(0, true)
		elseif sRet == "cancel" then	
			f_SetChkState(0, false)
		end if
	end if
End Sub

'============================================================================
Sub BtnContinue_OnClick()
	if g_Chk1 = "1" and g_Chk2 = "1" then
		g_sRetData = "ok"			
	else
		g_sRetData = "cancel"		
	end if 
	
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동N 원복(부모화면에서 호출했던 상태로)
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	Form.SendReturnToParent( "mbonl88022_p2" , g_sRetData )	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 약관 띄움
'============================================================================
Sub imgChk0_OnClick()	
	if CInt(g_Chk1) == 1 then
		f_SetChkState(1, false)
	else
		f_OpenChkPopup(1)
	end if		
End Sub

'============================================================================
' 핵심설명서 띄움
'============================================================================
Sub imgChk1_OnClick()	
	if CInt(g_Chk2) == 1 then
		f_SetChkState(2, false)
	else
		f_OpenChkPopup(2)
	end if	
End Sub

'============================================================================
' 필수약관에 모두 동의 클릭
'============================================================================
Sub btnAllChk_OnClick()
	if CInt(g_ChkAll) == 1 then
		f_SetChkState(0, false)		
	else
		f_OpenChkPopup(0)
	end if		
End Sub

