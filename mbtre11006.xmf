'============================================================================
' 01. 화 면 명 : CFD 반대매매 내역
' 02. 화면설명 : CFD 반대매매 내역
' 03. 작    성 : 2021. 07. 19. KSJ
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szToday		'당일날짜
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' 탭 구분에 따른 서비스 ID 얻기
'============================================================================
Function f_GetTranID()    
	Dim szGetTranID 
    If TabSelect.currenttab == 0 or TabSelect.currenttab == "0" Then
	    szGetTranID = "obtre_lqdt_005r"	' 반대매매처리내역
    Else
	    szGetTranID = "obtre_lqdt_004r"	' 미체결주문취소내역
    End If     
    
    return szGetTranID
End Function

'============================================================================
' 계좌번호 존재유무 체크
'============================================================================
Function f_CheckAcnt()
	if acnt0.total <> "" and acnt0.total <> null  and acnt0.sequence <> "" and acnt0.sequence <> null then
		return true
	else
'		Form.ShowAlert("알림", "계좌번호를 확인해주세요.")
		return false
	end if
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD반대매매 내역" )

	'오늘 날짜
	g_szToday = cldDate.caption
	
	TabSelect.page0.grd0.SetClear()
	TabSelect.page1.grd1.SetClear()
	' 활성 탭에 따른  DataManager Call
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if

End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	TabSelect.page0.grd0.SetClear()
	TabSelect.page1.grd1.SetClear()
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if
End Sub
'============================================================================
' TabSelect_OnTabChanged()
'============================================================================
Sub TabSelect_OnTabChanged(nCurrentTab)
	cldDate.caption = g_szToday
	TabSelect.page0.grd0.SetClear()
	TabSelect.page1.grd1.SetClear()
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if
End Sub

'============================================================================
' cldDate_OnEditComplete()
'============================================================================
Sub cldDate_OnEditComplete()	
	TabSelect.page0.grd0.SetClear()
	TabSelect.page1.grd1.SetClear()
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if
End Sub
'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub TabSelect_page0_grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_lqdt_005r") == True Then
		DATAMANAGER.RequestNextData("obtre_lqdt_005r")
	End If
End Sub
'============================================================================
' grd1_OnScrollEnd() : NextData 조회
'============================================================================
Sub TabSelect_page1_grd1_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_lqdt_004r") == True Then
		DATAMANAGER.RequestNextData("obtre_lqdt_004r")
	End If
End Sub
'============================================================================
' cmbGubun_OnEditComplete()
'============================================================================
Sub TabSelect_page0_cmbGubun_OnEditComplete(iIndex)
	TabSelect.page0.grd0.SetClear()
	
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData("obtre_lqdt_005r")
	end if
End Sub
'============================================================================
' btnRefresh_OnClick()
'============================================================================
Sub btnRefresh_OnClick()
	TabSelect.page0.grd0.SetClear()
	TabSelect.page1.grd1.SetClear()
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	TabSelect.page0.grd0.SetClear()
	TabSelect.page1.grd1.SetClear()
	' 활성 탭에 따른  DataManager Call
	if f_CheckAcnt() == true then
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if
End Sub

'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtre_lqdt_005r" or szTranID == "obtre_lqdt_004r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_STA_DATE" , 0 , cldDate.caption)					'조회시작일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_FIN_DATE" , 0 , cldDate.caption)					'조회종료일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")									'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CTCD" , 0 , "%")									'계좌비밀번호
		If szTranID == "obtre_lqdt_005r" Then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LQDT_CLCD" , 0 , TabSelect.page0.cmbGubun.cbkeydata)'반대매매구분코드
		End If
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "MANG_BRCD" , 0 , "%")
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "MANG_EMPNO" , 0 , "%")
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
'매크로 사용된 TR 사용시 Form.GetMetaData(코드치환Section, 코드 TR)
'sData = Form.GetMetaData( "현물반대매매사유코드", "01" )
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	msg = DATAMANAGER.GetDataMsgText( szTranID )
'	key = DATAMANAGER.GetDataMsgCode( szTranID )
'	
'	Form.ShowAlert(key, msg)
	If szTranID = "obtre_lqdt_005r" Then
		If tonumber(TabSelect.page0.grd0.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = TabSelect.page0.grd0.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1	
				Dim szData0, szData1, szData2
				szData0 = Form.GetMetaData("부서코드", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MANG_BRCD" , i) )
				szData1 = Form.GetMetaData("반대매매구분코드", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LQDT_CLCD" , i) )
				szData2 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ACNO" , i) & DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ASNO" , i)
				TabSelect.page0.grd0.SetCellData( "bd_cell0", nRowCnt + i , szData0)	' 부서명
				TabSelect.page0.grd0.SetCellData( "bd_cell2", nRowCnt + i , szData1)	' 반대매매구분명
				TabSelect.page0.grd0.SetCellData( "bd_cell3", nRowCnt + i , szData2)	' 계좌번호+계좌일련번호
				
				' 매매구분 색상	
				If TabSelect.page0.grd0.GetCellData( "bd_cell9", nRowCnt + i ) <> "" Then			
				    If TabSelect.page0.grd0.GetCellData( "bd_cell9", nRowCnt + i ) = "매도" Then
					    TabSelect.page0.grd0.SetCellFgColor( "bd_cell9", nRowCnt + i, "2" )	    
					ElseIf TabSelect.page0.grd0.GetCellData( "bd_cell9", nRowCnt + i ) = "매수" Then
						TabSelect.page0.grd0.SetCellFgColor( "bd_cell9", nRowCnt + i, "1" )		    
					End If
				End If
			Next
	    End If
	End If
	 
	If szTranID = "obtre_lqdt_004r" Then
		If tonumber(TabSelect.page1.grd1.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = TabSelect.page1.grd1.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1		
				Dim szData0, szData1
				szData0 = Form.GetMetaData("부서코드", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MANG_BRCD" , i) )
				szData1 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ACNO" , i) & DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ASNO" , i)
				TabSelect.page1.grd1.SetCellData( "bd_cell0", nRowCnt + i , szData0)	' 부서명
				TabSelect.page1.grd1.SetCellData( "bd_cell2", nRowCnt + i , szData1)	' 계좌번호+계좌일련번호
				
				' 매매구분 색상
				If TabSelect.page1.grd1.GetCellData( "bd_cell10", nRowCnt + i ) <> "" Then			
				    If TabSelect.page1.grd1.GetCellData( "bd_cell10", nRowCnt + i ) = "매도" Then
					    TabSelect.page1.grd1.SetCellFgColor( "bd_cell10", nRowCnt + i, "2" )	    
					ElseIf TabSelect.page1.grd1.GetCellData( "bd_cell10", nRowCnt + i ) = "매수" Then
						TabSelect.page1.grd1.SetCellFgColor( "bd_cell10", nRowCnt + i, "1" )		    
					End If
				End If
			Next
	    End If
	 End If
End Sub


