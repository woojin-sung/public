	<SCRIPT_INFO _len="28561" _ulen="27385" >
'============================================================================
' 01.화면명 	: 이체_금융기관팝업
' 02.화면설명	: 이체_금융기관팝업
' 03.작성	: 
'============================================================================
' 2022-11-22 : 김효준 : v001 : 9431 응답코드추가
'============================================================================

--===========================================================================
--===========================================================================
Dim g_szSeparator

Dim GridBankRowCount
Dim GridSecRowCount

Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcno

Dim g_szLNKD_BANK_CLS_CODE 
Dim g_szTR_DATE            
Dim g_szOTSD_TR_UNIQ_NO    
Dim g_szTACT_LNKD_ISTU_CODE
Dim g_szTACT_STND_TR_CODE  
Dim g_szLNKD_TLMS_MNNO     
Dim g_szRcvn_iqry_tmnu   

Dim g_AcntCopyYn

'20231116 메리츠증권 보여주지 않는 경우 추가
Dim g_szNoMeritzYn

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	contEdtAcno.imgLogo.setMaintainingRatio("1")
	contEdtAcno.ImgPrcreset.setMaintainingRatio("1")
	Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
	Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	contEdtAcno.imgLogo.setMaintainingRatio("1")
	contEdtAcno.ImgPrcreset.setMaintainingRatio("1")

	Container0.ContainerBank.GridBank.SetClear()
	Container0.ContainerSec.GridSec.SetClear()
	
	GridBankRowCount = 0
	GridSecRowCount = 0
	
	g_szSeparator = "★"
	g_AcntCopyYn = "0"
	
	szData = Form.GetOpenLinkData()
	
	If szData <> "" and szData <> null then
		'20231116 메리츠증권 보여주지 않는 경우 추가
		g_szNoMeritzYn = Form.GetSharedData("61140_NoMeritz", true)
		
		arrBankInfo = Split(szData, "★")
		
		g_szType = arrBankInfo(3)
		
		If g_szType == "SelectBank" then
			Container0.visible =  "1"
		ElseIf g_szType == "EditAcno" then
			g_szBankCode = arrBankInfo(0)
			g_szBankAcno = arrBankInfo(1)
			g_szBankName = arrBankInfo(2)
			
			If Trim(g_szBankAcno) <> "" Then '계좌번호 입력받고 들어온 경우(계좌복사인 경우밖에 없음)
			    
			    If Trim(g_szBankName) <> "" Then '은행명이 있을경우
                      contEdtAcno.lblBankName.caption = g_szBankName
			        contEdtAcno.imgLogo.imgpath = "bank"..g_szBankCode..".png"
			        contEdtAcno.edtRecAcno.caption = g_szBankAcno
			    Else '계좌만 있을 경우
			        g_AcntCopyYn = "1"
			        contEdtAcno.lblBankSelect.visible = "1"
                      contEdtAcno.lblBankName.caption = ""
			        contEdtAcno.imgLogo.imgpath = ""
			        contEdtAcno.edtRecAcno.caption = g_szBankAcno
			    End If
			    
			Else
			    contEdtAcno.lblBankName.caption = g_szBankName
			    contEdtAcno.imgLogo.imgpath = "bank"..g_szBankCode..".png"
			    contEdtAcno.edtRecAcno.caption = ""
			End If
			
			contEdtAcno.visible =  "1"
			btnConfirm.visible = "1"
		End If
		f_CheckAmtFont()
	End If
	
	DATAMANAGER.RequestTranData("obtsp_comm_001r")

End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
     '수취조회
	if trim(sTimerID) == "1" then
		Form.SetTimerEvent2(1,0,0)
		
		DATAMANAGER.RequestTranData( "obtss_elbs_221r" )
		
	elseif trim(sTimerID) == "9999" then 'remove
		Form.removeWaitCursor()
		Form.SetTimerEvent(9999,0,1)
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szACNO = acntList.total
	szASNO = acntList.sequence
	
	If szTranID = "obtsp_comm_001r" then
		If CStr(Container0.Tab0.currenttab) == "0" then
			DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "ISTU_CLCD" , 0 , "1")	'은행
		Else
			DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "ISTU_CLCD" , 0 , "2")	'증권
		end if

		DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")	'메리츠 포함
		
	'당행 수취인 조회 
	elseIf szTranID == "obrtd_drng_025r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" , 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PWD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "USE_YN" , 0 , "N" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "CNFT_ACNO" , 0 , Left(contEdtAcno.edtRecAcno.caption, 8) )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "CNFT_ASNO" , 0 , Right(contEdtAcno.edtRecAcno.caption, 2) )
		
	'타행이체 수취조회 전문발송 ( 당행도 가능 )
	elseIf szTranID == "obtss_elbs_121r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_BANK_CODE"		, 0 , g_szBankCode )		'입금은행코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "JOB_TRNO" 			, 0 , "031" )					'작업단말번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_ACNO"			, 0 , contEdtAcno.edtRecAcno.caption )		'입금계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "TR_AMT"			, 0 , "1" )						'거래금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "DRNG_ACNO"			, 0 , szACNO )				'출금계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , szASNO )		'계좌상품구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PWD"				, 0 , "" )							'비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "RMRK"				, 0 , "N" )						'비고
		Form.addWaitCursor()

	'타행이체 수취조회 응답수신 ( 타행만 호출 )
	elseif szTranID == "obtss_elbs_221r" then
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_szLNKD_BANK_CLS_CODE  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_szTR_DATE             )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_szOTSD_TR_UNIQ_NO     )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_szTACT_LNKD_ISTU_CODE )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_szTACT_STND_TR_CODE   )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_szLNKD_TLMS_MNNO      )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_szRcvn_iqry_tmnu      )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, szACNO      		   ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, szASNO			   ) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, ""				   ) '비밀번호
		
	end if
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtsp_comm_001r" Then
		tmpcount = DATAMANAGER.GetDataCount( 0 , "obtsp_comm_001r", "OutBlock1")	
		image1	=""
		name1	=""
		code1	=""
		image2	=""
		name2	=""
		code2	=""
		
		If CStr(Container0.Tab0.currenttab) == "0" then

			for i = 0 to tmpcount-1	step 2
				Container0.ContainerBank.GridBank.AddRow()
				j = i+1
				
				image1    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, i	) '이미지명
				name1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, i	) '이미지명
				code1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, i	) '이미지명
				
	              'contEdtAcno.imgLogo.setMaintainingRatio("1")
	              'contEdtAcno.ImgPrcreset.setMaintainingRatio("1")
	              Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage1" , GridBankRowCount, "1")
	              Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage2" , GridBankRowCount, "1")
	              'Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	              'Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
				
				Container0.ContainerBank.GridBank.SetCellData("bd_Bimage1" 	, GridBankRowCount, image1	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bname1" 	, GridBankRowCount, name1	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bcode1" 	, GridBankRowCount, code1	 ) 
				
				if tmpcount%2 ==0 and j+1 ==tmpcount then '짝수개 리턴, 마지막일경우
					image2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
					name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
					code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
					
					Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	, GridBankRowCount, image2	 ) 
					Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, GridBankRowCount, name2	 )
					Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, GridBankRowCount, code2	 )
					Exit Sub
				
				elseif tmpcount%2 == 1 and j == tmpcount then '홀수개 리턴, 마지막일경우
					Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	,GridBankRowCount, "alpha"	 ) 
					Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	,GridBankRowCount, ""	 )
					Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	,GridBankRowCount, ""	 )
					Exit Sub
				end if
				
				image2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
				name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
				code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
				
				Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	, GridBankRowCount, image2	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, GridBankRowCount, name2	 )
				Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, GridBankRowCount, code2	 )
				
				
				GridBankRowCount = GridBankRowCount +1
			next
		
		elseIf CStr(Container0.Tab0.currenttab) == "1" then '증권

			for i = 0 to tmpcount-1	step 2
				Container0.ContainerSec.GridSec.AddRow()
				j = i+1
				
				'20231116 메리츠증권 보여주지 않는 경우 추가
				if g_szNoMeritzYn == "Y" then
					image1    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j	) '이미지명
					name1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j	) '이미지명
					code1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j	) '이미지명
				else
					image1    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, i	) '이미지명
					name1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, i	) '이미지명
					code1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, i	) '이미지명
				end if
				
	              Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage1" , GridSecRowCount, "1")
	              Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage2" , GridSecRowCount, "1")

				Container0.ContainerSec.GridSec.SetCellData("bd_Bimage1" 	, GridSecRowCount, image1	 ) 
				Container0.ContainerSec.GridSec.SetCellData("bd_Bname1" 	, GridSecRowCount, name1	 ) 
				Container0.ContainerSec.GridSec.SetCellData("bd_Bcode1" 	, GridSecRowCount, code1	 ) 
				
				if tmpcount%2 ==0 and j+1 ==tmpcount then '짝수개 리턴, 마지막일경우
					image2    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
					name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
					code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
					
					Container0.ContainerSec.GridSec.SetCellData("bd_Bimage2" 	, GridSecRowCount, image2	 ) 
					Container0.ContainerSec.GridSec.SetCellData("bd_Bname2" 	, GridSecRowCount, name2	 )
					Container0.ContainerSec.GridSec.SetCellData("bd_Bcode2" 	, GridSecRowCount, code2	 )
					
					'20231116 메리츠 제외하고 남는 영역 제거
					if g_szNoMeritzYn == "Y" then
						Container0.ContainerSec.GridSec.rowcount = CInt(Container0.ContainerSec.GridSec.rowcount) - 1
					end if
					
					Exit Sub
				
				elseif tmpcount%2 == 1 and j == tmpcount then '홀수개 리턴, 마지막일경우
					Container0.ContainerSec.GridSec.SetCellData("bd_Bimage2" 	,GridSecRowCount, "alpha"	 ) 
					Container0.ContainerSec.GridSec.SetCellData("bd_Bname2" 	,GridSecRowCount, ""	 )
					Container0.ContainerSec.GridSec.SetCellData("bd_Bcode2" 	,GridSecRowCount, ""	 )
					
					'20231116 메리츠 제외하고 남는 영역 제거
					if g_szNoMeritzYn == "Y" then
						Container0.ContainerSec.GridSec.rowcount = CInt(Container0.ContainerSec.GridSec.rowcount) - 1
					end if
					
					Exit Sub
				end if
				
				'20231116 메리츠증권 보여주지 않는 경우 추가
				if g_szNoMeritzYn == "Y" then
					image2    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j+1) '이미지명
					name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j+1) '이미지명
					code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j+1) '이미지명
				else
					image2    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
					name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
					code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
				end if
				
				Container0.ContainerSec.GridSec.SetCellData("bd_Bimage2" 	, GridSecRowCount, image2	 ) 
				Container0.ContainerSec.GridSec.SetCellData("bd_Bname2" 	, GridSecRowCount, name2	 )
				Container0.ContainerSec.GridSec.SetCellData("bd_Bcode2" 	, GridSecRowCount, code2	 )
				
				GridSecRowCount = GridSecRowCount +1
			next
		end if
	
	'당행 수취인 조회 
	elseIf szTranID == "obrtd_drng_025r" then
		szName = DATAMANAGER.GetDataValue (0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0 )
		
		szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..szName
	
		Form.SendReturnToParent("mbbnk63010_p3" , szData)
		Form.CloseForm()

	'타행이체 수취조회 전문발송
	elseif szTranID == "obtss_elbs_121r" then
	    if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )

			Form.SetTimerEvent2(1,1,0.5) '처음은 0.5초 후 조회

			exit sub
		else
			if g_szBankCode == "287" then
				g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
				g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
				g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
				g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
				g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
				g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
				
				szName = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "ACNM", 0 )

				szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..szName..g_szSeparator.."0"..g_szSeparator.."0"
				
				Form.removeWaitCursor()
				
				Form.SendReturnToParent("mbbnk63010_p3" , szData)
				Form.CloseForm()
				
			end if
			Form.SetTimerEvent(9999, 1, 1) 'remove
		end if

	'타행이체 수취조회 응답수신	
	elseif szTranID == "obtss_elbs_221r" then
		if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
		    
		    	g_szRcvn_iqry_tmnu = g_szRcvn_iqry_tmnu + 1 '수취조회횟수 증가
			
			if g_szRcvn_iqry_tmnu < 5 then '5초 MAX
				SLEEP_SEC = g_szRcvn_iqry_tmnu
			else
				SLEEP_SEC = 5
			end if

			Form.SetTimerEvent2(1,1,SLEEP_SEC)
			
			exit sub
		else
			
			'Form.SetTimerEvent(9999, 1, 1) 'remove
			Form.removeWaitCursor() '20231128 수정
	
			szName = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "ACNM", 0 )
			szBankName = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "TACT_BANK_NAME", 0)
			if szBankName <> "" then
				g_szBankName = szBankName
			end if
			szFee = DATAMANAGER.GetDataValue( 0, "obtss_elbs_221r", "OutBlock1", "FEE" , 0 )
			
			szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..szName..g_szSeparator.."0"..g_szSeparator..szFee

			Form.SendReturnToParent("mbbnk63010_p3" , szData)
			Form.CloseForm()

		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "obtss_elbs_121r" or szTranID == "obtss_elbs_221r" then
		Form.SetTimerEvent(9999, 1, 1) 'remove
			
		szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
		
		if szSubErr <> "" and szSubErr <> null then
			szErrMsg = szErrMsg.."\n("..szSubErr..")"
		end if
		
		'v001 9431(413.기타수취불가 추가) 추가
		if szErrCode == "9432" or szErrCode == "9431" then '지로가상계좌일 경우
			szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator.."9432_TAX"..g_szSeparator.."0"..g_szSeparator..""

			Form.SendReturnToParent("mbbnk63010_p3" , szData)
			Form.CloseForm()
		else
			Form.MsgBox("알림", szErrMsg, "", 6)
		end if
		
'		Form.ShowAlert("알림", "입력하신 계좌번호를 다시 확인해주세요.")
	 end if
End Sub

'============================================================================
Sub Container0_Tab0_OnTabChanged(tmp)
	Container0.ContainerBank.GridBank.SetClear()
	Container0.ContainerSec.GridSec.SetClear()
	
	GridBankRowCount = 0
	GridSecRowCount = 0

	If CStr(Container0.Tab0.currenttab) == "0" then
		Container0.ContainerBank.visible = true
		Container0.ContainerSec.visible  = false

	elseIf CStr(Container0.Tab0.currenttab) == "1" then '증권
		Container0.ContainerBank.visible = false
		Container0.ContainerSec.visible  = true
	End If
	
	DATAMANAGER.RequestTranData("obtsp_comm_001r")
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_ContainerBank_GridBank_OnClickUp(lRow, szCellID)
	if szCellID =="bd_Bimage1" or szCellID =="bd_Bname1" or szCellID =="bd_Bcode1" or szCellID =="bd_cell0" or szCellID =="bd_cell1" or szCellID =="bd_cell2" then
		szBankNm   = Container0.ContainerBank.GridBank.GetCellData("bd_Bname1", lRow)
		szBankCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode1", lRow)
		szBankImage= Container0.ContainerBank.GridBank.GetCellData("bd_Bimage1", lRow)
	elseif szCellID =="bd_Bimage2" or szCellID =="bd_Bname2" or szCellID =="bd_Bcode2" or szCellID =="bd_cell3" or szCellID =="bd_cell4" or szCellID =="bd_cell5" then
		szBankNm   = Container0.ContainerBank.GridBank.GetCellData("bd_Bname2", lRow)
		szBankCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode2", lRow)
		szBankImage= Container0.ContainerBank.GridBank.GetCellData("bd_Bimage1", lRow)
	end if
	
	if trim(szBankNm)  ="" then '홀수개 리턴시 하단 우측 공백
		Exit Sub
	end if
	
	g_szBankCode = szBankCode
	g_szBankName = szBankNm
	contEdtAcno.lblBankName.caption = szBankNm
	contEdtAcno.imgLogo.imgpath = "bank"..szBankCode..".png"

    If Trim(contEdtAcno.edtRecAcno.caption) == "" Then
        contEdtAcno.edtRecAcno.fontsize = 0
    Else
        contEdtAcno.edtRecAcno.fontsize = 7
    End If
    
	Container0.visible =  "0"
	contEdtAcno.visible =  "1"
	btnConfirm.visible = "1"
End Sub

'============================================================================
Sub Container0_ContainerSec_GridSec_OnClickUp(lRow, szCellID)
	if szCellID =="bd_Bimage1" or szCellID =="bd_Bname1" or szCellID =="bd_Bcode1" or szCellID =="bd_cell0" or szCellID =="bd_cell1" or szCellID =="bd_cell2" then
		szSecuNm   = Container0.ContainerSec.GridSec.GetCellData("bd_Bname1", lRow)
		szSecuCode = Container0.ContainerSec.GridSec.GetCellData("bd_Bcode1", lRow)
		szSecuImage= Container0.ContainerSec.GridSec.GetCellData("bd_Bimage1", lRow)
	elseif szCellID =="bd_Bimage2" or szCellID =="bd_Bname2" or szCellID =="bd_Bcode2" or szCellID =="bd_cell3" or szCellID =="bd_cell4" or szCellID =="bd_cell5" then
		szSecuNm   = Container0.ContainerSec.GridSec.GetCellData("bd_Bname2", lRow)
		szSecuCode = Container0.ContainerSec.GridSec.GetCellData("bd_Bcode2", lRow)
		szSecuImage= Container0.ContainerSec.GridSec.GetCellData("bd_Bimage1", lRow)
	end if
	
	if trim(szSecuNm)  ="" then '홀수개 리턴시 하단 우측 공백
		Exit Sub
	end if
	
	g_szBankCode = szSecuCode
	g_szBankName = szSecuNm
	contEdtAcno.lblBankName.caption = szSecuNm
	contEdtAcno.imgLogo.imgpath = "bank"..szSecuCode..".png"
	
	contEdtAcno.edtRecAcno.fontsize = 0
	Container0.visible =  "0"
	contEdtAcno.visible =  "1"
	btnConfirm.visible = "1"
End Sub

