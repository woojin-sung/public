Dim	g_szName
Dim	g_ServerMode	'1:개발기, 아니면 운영기
Dim	g_URLheader
Dim 	g_Key1
Dim 	g_Key2
'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szName = Form.GetOpenLinkData()
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)

	If g_ServerMode == "1" Then	'개발기
		
		g_URLheader = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/"
	Else 
		g_URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	End If
	
	web01.viewtype = 0	
	web01.urlpath = g_URLheader & "meritz_yk_13.html" 
			
	Form.SetScreenName("약관확인 및 고객동의 사항")
	Edit0.caption = "온라인서비스 이용약관"
	
	g_Key1 = ""
	g_Key2 = ""

End Sub
	
'============================================================================
Sub btnOk01_OnClick()
	
	'Form.SendReturnToParent("mbbdm20010_p1", chkAgree01.checkstate.."★"..chkAgree02.checkstate)
	Form.SendReturnToParent("mbbdm20010_p1", "1")
	Form.CloseForm()
	
End Sub



