'============================================================================
Sub Form_OnFormInit()
	Grid0.rowcount = 2
	
	Grid0.setMaintainingRatio( "bd_cell0" , 0, "1")
	Grid0.setMaintainingRatio( "bd_cell2" , 0, "1")	
	Grid0.setMaintainingRatio( "bd_cell0" , 1, "1")
	Grid0.setMaintainingRatio( "bd_cell2" , 1, "1")
	
	
	Grid0.SetCellData("bd_cell0", 0, "flag_us2.png")
	Grid0.SetCellData("bd_cell1", 0, "미국 USD")
	Grid0.SetCellData("bd_cell2", 0, "flag_jp2.png")
	Grid0.SetCellData("bd_cell3", 0, "일본 JPY")
	
	Grid0.SetCellData("bd_cell0", 1, "flag_hk.png")
	Grid0.SetCellData("bd_cell1", 1, "홍콩 HKD")
	Grid0.SetCellData("bd_cell2", 1, "flag_chn.png")
	Grid0.SetCellData("bd_cell3", 1, "중국 CNY")
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	szData = ""
	if CInt(lRow) == 0 then
		if "bd_cell4" == szCellID then	'화면 닫히지 않도록!
			Exit Sub
		elseif "bd_cell0" == szCellID or "bd_cell1" == szCellID then'미국
			szData = "USD"
		elseif "bd_cell2" == szCellID or "bd_cell3" == szCellID then'일본
			szData = "JPY"
		end if
	else
		if "bd_cell4" == szCellID then
			Exit Sub
		elseif "bd_cell0" == szCellID or "bd_cell1" == szCellID then'홍콩
			szData = "HKD"
		elseif "bd_cell2" == szCellID or "bd_cell3" == szCellID then'중국
			szData = "CNY"
		end if
	end if

	Form.SendReturnToParent("mbbnk61140_p3" , szData)
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

