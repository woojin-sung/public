					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="CMA 유형 전환 가능시간은 영업일 08:00~17:00 입니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,1" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="유형 전환 신청 시 보유중인 CMA 자동투자상품은 전부" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="매도되어 예수금으로 전환됩니다. 해당 예수금은 회사가" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="정한 자동매수시간에 유형 전환 신청한 자동투자상품" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,5,0,5" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="으로 매수됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,6,0,6" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,7,0,7" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="RP형 CMA, 발행어음형 CMA는 예금자보호법에 따라" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,8,0,8" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="예금보험공사가 보호하지 않습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,9,0,9" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,9,1,9" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,10,0,10" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="RP, 발행어음 수익률은 입금 시 회사가 고시하는 약정" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,11,0,11" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="수익률이 적용되며, 당해 수익률은 시장금리 상황 등에 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,12,0,12" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="따라 변동될 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,13,0,13" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,13,1,13" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,14,0,14" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="RP형 CMA의 입금액은 RP, MMW형 CMA의 입금액은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,15,0,15" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="한국증권금융 예수금 등, 발행어음형 CMA의 입금액은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,16,0,16" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,16,1,16" halign="0" line="0,0" caption="발행어음에 투자됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,17,0,17" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,17,1,17" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,18,0,18" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="투자자는 RP형 CMA, 발행어음형 CMA에 대하여 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,19,0,19" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,19,1,19" halign="0" line="0,0" caption="메리츠증권으로부터 충분한 설명을 받을 권리가 있으며," fontsize="-2" impidxs="" />
						<CELL cell_ly="0,20,0,20" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,20,1,20" halign="0" line="0,0" caption="가입 전 상품설명서 및 약관을 반드시 읽어보시기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,21,0,21" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,22,0,22" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,22,1,22" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,23,0,23" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="RP형 CMA, 발행어음형 CMA는 투자상품 가격 하락" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,24,0,24" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="등에 따라 투자원금의 손실이 발생할 수 있으며, " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,25,0,25" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,25,1,25" halign="0" line="0,0" caption="그 손실은 투자자에게 귀속됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,26,0,26" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,26,1,26" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,27,0,27" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,27,1,27" halign="0" line="0,0" caption="발행어음 발행한도 초과 등 당사의 사정에 의해 발행" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,28,0,28" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,28,1,28" halign="0" line="0,0" caption="어음을 발행할 수 없는 경우 자동매수가 중단될 수 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,29,0,29" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="있으며, 발행어음으로 매수되지 않은 예수금에 대해서는" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,30,0,30" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,30,1,30" halign="0" line="0,0" caption="회사가 정한 별도의 예탁금이용료를 지급합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,31,0,31" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,31,1,31" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,32,0,32" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,32,1,32" halign="0" line="0,0" caption="RP형 CMA는 회사가 보유하고 있는 채권의 수량이" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,33,0,33" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,33,1,33" halign="0" line="0,0" caption="부족한 경우 자동매수되지 않으며, RP로 매수되지 않은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,34,0,34" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,34,1,34" halign="0" line="0,0" caption="예수금에 대해서는 회사가 정한 별도의 예탁금이용료를" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,35,0,35" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,35,1,35" halign="0" line="0,0" caption="지급합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,36,0,36" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,36,1,36" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,37,0,37" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,37,1,37" halign="0" line="0,0" caption="발행어음은 발행사(메리츠증권 신용등급 AA-," fontsize="-2" impidxs="" />
						<CELL cell_ly="0,38,0,38" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,38,1,38" halign="0" line="0,0" caption="2023.5.19 기준, 한국신용평가)의 신용위험(부도, " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,39,0,39" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,39,1,39" halign="0" line="0,0" caption="파산 등)에 따른 원금손실이 발생할 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,40,0,40" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,40,1,40" halign="0" line="0,0" fontsize="-2" impidxs="" />
