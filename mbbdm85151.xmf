Dim errorFlag1 '해외납세자-최초 nIndex = 0 누른 경우와 nIndex = 1 선택 후 nIndex = 0 눌렀을 때 구분하는 플래그
Dim succFlag
Dim sRevData
Dim gAmlOcknName
