Sub Form_OnFormInit()
	Image1.imgpath = "icon_top_back_light"
	
	ContMain.Label2.visible = False '해외납세자 구분
	ContMain.Label3.visible = False '*
	
	'"94" 는 콤보 펼친 값이 ImgF 아래 오기 위한 속성값
     ContMain.CmbMoney.setApplyLabel  ("자금의 원천" ,0  , 268 , "left" , true, "94" )
	ContMain.CmbJob.setApplyLabel    ("직업"        ,0  , 268 , "left" , true, "94" )
	ContMain.CmbPurpose.setApplyLabel("거래목적"    ,0  , 268 , "left" , true, "94" )
	ContMain.CmbOccu.setApplyLabel   ("직종"        ,0  , 268 , "left" , true, "94" )
	
	'에디트 위에 다른 컨트롤이 올라가면 꼭 호출해줘야함
	ContMain.BtnOccu.bringFront("1") 
	
	gRCNO         = Form.GetSharedData("BDM_RCNO_PIP"       , false ) '주민등록번호
	gRegUniqNo 	= Form.GetSharedData("BDM_REG_UNIQ_NO"    , false ) '등록고유번호
	gAcntOpngClcd = Form.GetSharedData("BDM_ACNT_OPNG_CLCD" , false ) '계좌개설구분코드
	
	gPageID		= "3"
	errorFlag     = 0
	errorFlag1    = 0
	succFlag      = 0
	
	'help msg
	ContMain.RadioGroup0.SetUseResultLabel(true,2)
	ContMain.RadioGroup1.SetUseResultLabel(true,2)
	
	'**************************************
     ' GetSharedData 고객정보 입력_기본정보
     '**************************************
	Call GetSharedData_Setting()	
	'gAcntOpngClcd = "2" ' test
	Call SetFrame(gAcntOpngClcd)
	BtnNext.visible = False
	
	'2021.04.19. 김유경. 이전 화면에서 돌아오면 컨트롤 모두 보이기
	sRevData = Form.GetOpenLinkData()
	
	'이전 화면에서 돌아오면 컨트롤 모두보이기
	If sRevData == "StepBack" then	

		gOcptCode        = Form.GetSharedData("BDM_OCPTCODE"         , false )
		gAmlOcknLrdvCode = Form.GetSharedData("BDM_AMLOCKNLRDVCODE"  , false )
		gAmlOcknSmdvCode = Form.GetSharedData("BDM_AMLOCKNSMDVCODE"  , false )
		gEddTrObjtCode   = Form.GetSharedData("BDM_EDDTROBJTCODE"    , false )
		gEddTrFndsSorcCode=Form.GetSharedData("BDM_EDDTRFNDSORCCODE" , false )
		gAmlOcknName     = Form.GetSharedData("BDM_AMLOcknName"      , false )
		
		'실제소유자여부
		ContMain.Label0.visible      = True
		ContMain.Label1.visible      = True
		ContMain.RadioGroup0.visible = True
		
		ContMain.RadioGroup0.currentindex = "0"
		
		'해외납세자구분
		ContMain.Label2.visible      = True
		ContMain.Label3.visible      = True
		ContMain.RadioGroup1.visible = True
		
		ContMain.RadioGroup1.currentindex = "0"
		
		'직업
		ContMain.CmbJob.visible      = True
		ContMain.CmbJob.cbkeydata    = gOcptCode
		ContMain.CmbJob.fgcolor      = 268
				
		
		'직종: 학생(14), 주부(17), 전업투자자(18), 무직(19), 기타(99)
		If gOcptCode == "14" or gOcptCode == "17" or gOcptCode == "18" or gOcptCode == "99" Then  
			ContMain.LabelOccu.visible   = True
		Else
			ContMain.BtnOccu.visible     = True
			ContMain.CmbOccu.visible     = True		
			ContMain.BtnOccu.caption     = ""
			ContMain.CmbOccu.caption     = gAmlOcknName
			ContMain.CmbOccu.fgcolor     = 268
		End If
		
		'거래목적
		ContMain.CmbPurpose.visible  = True
		ContMain.CmbPurpose.cbkeydata= gEddTrObjtCode
		ContMain.CmbPurpose.fgcolor  = 268
		
		'자금의원천
		ContMain.CmbMoney.visible    = True
		ContMain.CmbMoney.cbkeydata  = gEddTrFndsSorcCode
		ContMain.CmbMoney.fgcolor    = 268		

		ContMain.LabStnd.top = 627
		ContMain.SetScrollAutoSize()
		ContMain.scroll_pos = 600
		BtnNext.visible = True
		 
	Else
		DATAMANAGER.RequestTranData("obaci_acct_072r")
	End If

End Sub

'============================================================================
' 고객 확인의무 확인 팝업
'============================================================================
Sub ContMain_Image0_OnClick()
	Form.OpenPopup("mbbdm85151_p2" , "pass" , "")
End Sub

'============================================================================
Sub ContMain_BtnOccu_OnClick()		
	Form.OpenPopupAnimation("mbbdm85151_p1" , "pass"  ,"","2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'직종
	If sKeyName == "mbbdm85151_p1" Then	
		ContMain.Label6.visible = False
		ContMain.CmbOccu.fgcolor = 268
		ContMain.CmbOccu.Caption = sRet
		
		gLRDV_CODE = Form.GetSharedData("13010_OCCU_LRDV", False )	'대업무분류
		gSMDV_CODE = Form.GetSharedData("13010_OCCU_SMDV", False )	'소업무분류

		'20210310 김유경 Combo/Timer 추가
		ContMain.CmbOccu.SetStatus("normal")
		
		Form.SetTimerEvent2(12, 1, 0.5)
				
		'20210309 자금의원천 펼침 로직 추가
		'ContMain.CmbPurpose.openList()	
		'20210309 자금의원천 펼침 로직 추가
		
		'20210310 김유경 Combo/Timer 추가
	End If
End Sub

'============================================================================
Sub ContMain_RadioGroup0_OnClick(nIndex)

	If nIndex == 0 or nIndex == 1 Then

		If nIndex == 1 Then
		
			ContMain.RadioGroup0.SetResultLabel("1", "error","실제소유자가 아닌 경우에는 계좌개설이 불가합니다.","ContMain")
			ContMain.RadioGroup0.currentindex = -1
			errorFlag = 1
						
			Exit Sub
			
		ElseIf nIndex == 0  Then  

			If errorFlag == 1 Then '최초 nIndex = 0 누른 경우와 nIndex = 1 선택 후 nIndex 눌렀을 때 구분하는 플래그
				'helpmsg Reset
				ContMain.RadioGroup0.SetResultLabel("0", "", "", "ContMain")
			End If 	
			
		End If 
			
		'개별추가의 경우 해외납세자 구분 미노출
		If gAcntOpngClcd == "1" Then 
			ContMain.Label2.visible      = True '해외납세자 구분
			ContMain.Label3.visible      = True '*
			ContMain.RadioGroup1.visible = True 
				
			'20210308 김유경 calcUnResize 로직 추가
			ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top, "1"))  + 125
			ContMain.SetScrollAutoSize()
			'ContMain.scroll_pos  = Cint(Form.calcUnResize(ContMain.Label2.top , "1"))  - 84 '20210310 컨트롤 2개씩보이는 것으로 수정
			ContMain.scroll_pos  = Cint(Form.calcUnResize(ContMain.Label0.top , "1"))        '20210310 컨트롤 2개씩보이는 것으로 수정
			
			'20210308 김유경 calcUnResize 로직 추가
		Else  

			ContMain.CmbJob.visible = True

			'ContMain.LabStnd.top = Cint(Form.calcUnResize(ContMain.LabStnd.top, "1"))  + 84
			'ContMain.SetScrollAutoSize()
			'ContMain.scroll_pos  = Cint(Form.calcUnResize(ContMain.CmbJob.top , "1"))        '20210310 컨트롤 2개씩보이는 것으로 수정
			'20210308 김유경 calcUnResize 로직 추가
			
			'20210310 김유경 Combo/Timer 추가
			'직업 -리스트 자동보이기
			'ContMain.CmbJob.openList()
			
			Form.SetTimerEvent2(10, 1, 0.8)
			
		
			'20210310 김유경 Combo/Timer 추가
						
		End If
	End If
End Sub


'============================================================================
' 해외납세자 구분
'============================================================================
Sub ContMain_RadioGroup1_OnClick(nIndex)
	If nIndex == 0 or nIndex == 1 Then
	
		'(To-Be) 해외납세자의 경우에만 계좌개설가능 하므로, InBlock 삭제
		If nIndex == 1 Then
			
			ContMain.RadioGroup1.SetResultLabel("1", "error","해외납세자는 가까운 영업점을 내방하시어\n 계좌 개설해 주시기 바랍니다.","ContMain")
			ContMain.RadioGroup1.currentindex = -1
			errorFlag1 = 1
			succFlag  = 0
			Exit Sub
			
		ElseIf nIndex == 0 and succFlag <> 1 Then  
			
			If errorFlag1 == 1 Then '최초 nIndex = 0 누른 경우와 nIndex = 1 선택 후 nIndex 눌렀을 때 구분하는 플래그
				'helpmsg Reset
				ContMain.RadioGroup1.SetResultLabel("0", "", "", "ContMain")
			End If 
			
			succFlag = 1				

			'개별추가의 경우 해외납세자 구분 미노출
			If gAcntOpngClcd = "1" Then 
