'============================================================================
' 화 면 명 : 주식대용주문_잔고팝업
' 화면설명 : 주식대용주문 매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.01.30     test3
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_acntPwd


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("주식대용 잔고")
	
	szOpen = Form.GetOpenLinkData()
	g_szChk = "0"
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
'		g_acntPwd  = tData(3)
		
	end if
	
	DATAMANAGER.RequestTranData( "obtrs_comn_312r" )
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtrs_comn_312r" Then
		DATAMANAGER.ClearInputData(0,"obtrs_comn_312r" )		 
		DATAMANAGER.SetDataValue(0, "obtrs_comn_312r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_312r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_312r", "InBlock1", "ACNT_PWD"		, 0, g_acntPwd)
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtrs_comn_312r" Then
	
	    If DATAMANAGER.IsMoreNextData( "obtrs_comn_312r" ) = True then
		    DATAMANAGER.RequestNextData( "obtrs_comn_312r" )
	    Else
	    
			szAcno = DATAMANAGER.GetDataValue(0, "obtrs_comn_312r", "OutBlock2", "LNKD_ACNO" , 0)
			szAsno = DATAMANAGER.GetDataValue(0, "obtrs_comn_312r", "OutBlock2", "LNKD_ASNO" , 0)
			
			szSbsn = DATAMANAGER.GetDataValue(0, "obtrs_comn_312r", "OutBlock2", "SBSN_VLTN_AMT" , nIndex)
			szAcnt = szAcno..szAsno
			
			Table0.SetCellString(0, 1, szAcnt)
			Table0.SetCellString(0, 3, szSbsn)
	    
	    End If   
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szGbn, szLoanSr, szData
	
	if lRow > -1 then
		szCd       = grdList.GetCellData("bd_Cd",       lRow)
		szQty      = grdList.GetCellData("bd_AblQty",   lRow)
		szGbn   	  = grdList.GetCellData("bd_Gbn"	, lRow)
		
		'전달내용/탭위치/종목코드/수량/매수일자/과세구분/대용구분
		'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		szData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & szQty & "♥" & "" & "♥" & "" & "♥" & "0" & "♥" & ""
		Form.SendReturnToParent("12080_BALANCE", szData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	DATAMANAGER.RequestTranData( "obtrs_comn_312r" )	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'Form.ShowAlert(szErrCode, szErrMsg)
End Sub

