	<SCRIPT_INFO _len="16753" _ulen="15459" >
'============================================================================
' 01. 화 면 명 : 공개매수
' 02. 화면설명 : 공개매수
' 03. 작    성 : 2023. 06. 01. 정지환
' 2023-08-10 : 신극수 : v0001 : 공개매수 개선
'============================================================================
Dim g_szToday
Dim g_nIdx
Dim g_tData
g_tData = {}
Dim g_szLinkData
Dim g_szPwd
Dim g_szCustClsCd
DIm g_szTpCd, g_szInagSrno
Dim g_szARCD, g_szTONO, g_szTELNO
Dim g_szTkwrDt
Dim g_szMailTpCd
Dim g_tPwdData

'20230803 SWJ START 'v0001
Dim g_sJuminNum
Dim g_motpAppYN
Dim g_DeviceOS
'20230803 SWJ END
'============================================================================
Sub Form_OnFormInit()
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	Form.Form.SetScreenName("공개매수신청")
	
	g_szLinkData = Form.GetOpenLinkData( )
	if g_szLinkData <> "" and g_szLinkData <> null then
		g_tData = Split(g_szLinkData , "★")
		
		contMain.lblTitle0.caption = g_tData(3) & "("& mid(g_tData(1),2,6) & ")"
		DATAMANAGER.RequestTranData( "obibk_tbal_001r" )
	end if
	
	'20230803 SWJ START 'v0001
	'Form.SetSharedData("CommonNoSecurity" , "Y")
	g_sJuminNum = Form.GetSharedData("&JUMIN_NUM", false)
	'20230803 SWJ END
End Sub
'============================================================================
Sub Form_OnFormInitAfter()
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim szACNO, szASNO
		
	szACNO = left(acntMain.caption , 8)
	szASNO = right(acntMain.caption, 2)
	if szTranID == "obibk_tbal_001r" then
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"		 	, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 			, 0 , g_tData(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TOB_SRNO" 		, 0 , g_tData(2) )
		
	'개인 폰번호 조회
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , acntMain.caption )
		
	elseif szTranID == "obibk_tbal_001a" then
		
		DATAMANAGER.SetEventFlag( szTranID, "A" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"		 		, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 				, 0 , g_tData(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TOB_SRNO" 			, 0 , g_tData(2) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_QTY" 			, 0 , contMain.edtQty.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" 				, 0 , g_szPwd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INVT_MANL_HNDV_MTCD"	, 0 , "61" )
		
		if g_szCustClsCd == "1" then '개인
			g_szTpCd = "13"		
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INAG_TYPE_CODE" 		, 0 ,g_szMailTpCd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INAG_SRNO" 			, 0 ,g_UITrgtSrno )
	elseif szTranID == "obaci_acct_095r" then
'		DATAMANAGER.SetUserID("meritz")		'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , szACNO )
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obibk_tbal_001r" then
		Dim szPrhbYn, szPrhbCntt
		dim nCnt
		
		nCnt = Cint(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "QTY" 	, 0 ))	'수량
		
		g_szCustClsCd = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CUST_CLS_CODE" 	, 0 )	'고객구분코드
		g_szTpCd	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "INAG_TYPE_CODE" 	, 0 )	'통보처유형코드
		g_szTkwrDt	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TKWR_DATE" 		, 0 )	'출고일자
	
		szPrhbYn	 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PROS_PRHB_REAS_CLS_CODE"	, 0 )	'매수불가코드
		szPrhbCntt	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PROS_PRHB_DTL_CNTT" 		, 0 )	'매수불가내용
		
		if szPrhbYn == "2" then
			Form.MsgBox( "안내", szPrhbCntt, "", 6 )
			btnOk.enable = false
		elseif szPrhbYn == "3" then
			Form.MsgBox( "안내", szPrhbCntt, "PRHBYN_3", 7, "확인", "신청내역 확인" )
			btnOk.enable = false
		else
			btnOk.enable = true
		end if
		
		if g_szCustClsCd == "1" then 		'개인
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
		elseif g_szCustClsCd == "2" then 	'법인
			DATAMANAGER.RequestTranData( "obaci_acct_095r" ) '연락처조회

		end if
	'고객연락처정보조회
	elseIf szTranID == "obcsb_acad_002r" Then
		Dim nCnt, nCnt1, nCnt3, szMailTpCd, szINAG_TYPE_CODE
		g_szCustClsCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock5", "CUST_CLS_CODE" , 0 )
'		
		szMailTpCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock5", "MAIL_INAG_TYPE_CODE" , 0 )
		
'		if g_szCustClsCd == "1" then 		'개인
		contMain.lblLink2.visble = true
		contMain.lblTitle2.caption = "배정결과를 알림톡으로 발송해드려요\n연락처를 확인해주세요"
		
		contMain.lblTitle2.changeTextAttr(6,3,"7",0,0)		'iOS 속성 남아있는 현상 조치
		
		g_szInagSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "INAG_SRNO" , 0 )
		
		nCnt3 = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock3")	
		
		If CInt(nCnt3) > 0 Then
			For i = 0 To nCnt3 - 1 
				szINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i )
				if szINAG_TYPE_CODE == "13" then
					g_szARCD = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "ARCD" , i )
					g_szTONO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "TONO" , i )
					g_szTELNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "TELNO" , i )
					
					contMain.lblTel.caption = g_szARCD & "-" & g_szTONO & "-" & g_szTELNO
				end if
			Next
		End If

	elseIf szTranID == "obibk_tbal_001a" Then
'		dim szErr
'		szErr = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ERR_CNTT" , 0 )
'		
'		if szErr == "" or  szErr == null then
			dim szData
			szData = acntMain.caption & "★" & contMain.lblTitle0.caption & "★" & contMain.edtQty.caption & "★" & g_szTkwrDt
			
			Form.openPopup("mbonl83200_p4",szData, "")
'		end if
	'법인 폰번호, 이메일 조회
	elseif szTranID == "obaci_acct_095r" then
		contMain.lblLine1.visible = true
		contMain.lblTel.width = "345"
		contMain.lblTel.top = "440"
		contMain.lblLink2.visible = false
		contMain.lblTitle2.caption = "배정결과를 등기우편 및 알림톡으로 발송해드려요. 통보처를 확인해주세요"
		contMain.lblAddr.visible = true
		
		contMain.lblTitle2.changeTextAttr(6,10,"7",0,0)		'iOS 속성 남아있는 현상 조치
		
		g_szMailTpCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MAIL_INAG_TYPE_CODE" 	, 0 )
		g_UITrgtSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_TRGT_SRNO" 		, 0 )

		nCnt2 = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")	

		If CInt(nCnt2) > 0 Then
			For i = 0 To nCnt2 - 1
			
				Dim szNotice	'통보처유형코드
				szNotice = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE", i)
				if g_szMailTpCd == szNotice then
					contMain.lblAddr.caption = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "UI_ADDR" , i ) )
				end if
				
				if szNotice == "13" then
					szTel = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "UI_CUST_TELNO", i)
					contMain.lblTel.caption = szTel
				end if
				
			Next
		End If
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'20230803 SWJ START : 보안매체없음 공통팝업 도입 'v0001
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				Form.SetSharedData("CommonNoSecurity" , "Y")
				Form.OpenPopup("mhetc90190_p1", acntMain.total &"★"& g_sJuminNum &"★"& "Y", "")
				'20230803 SWJ END
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				
				'20230803 SWJ START : 앱 재설치 하면 원장 정보와 앱 정보가 달라서  'v0001
				'앱에서 정보 호출했을 때 모바일OTP 정보 없으면 보안매체 없음 팝업  
				if g_motpAppYN <> "00000" then
					Form.SetSharedData("CommonNoSecurity" , "Y")
					Form.OpenPopup( "mhetc90190_p1", acntMain.total &"★"& g_sJuminNum&"★"& "Y", "")	'안내 팝업
					exit sub
				end if
				'20230803 SWJ END
				
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	if szTranID <> "obibk_tbal_001a"then
		Form.ShowAlert( "알림" , szErrMsg)
	else
		Form.ShowAlert( "알림" ,szSubErr)
	end if
End Sub
'============================================================================
Sub contMain_lblLink1_OnClick()
	Form.OpenPopupAnimation("mbtrs12000_pp", acntMain.total & "★" & acntMain.sequence & "★1★3★0★0", "","2")	
End Sub
'============================================================================
Sub contMain_lblLink2_OnClick()
	Form.OpenFramePopup("mbonl81000" , "" , "")
End Sub


'============================================================================
Sub btnOk_OnClick()

	if contMain.edtQty.caption == "" or contMain.edtQty.caption == null or contMain.edtQty.caption == "0" then
		ShowAlert("안내", "신청 수량을 입력해 주세요")
		Exit Sub
	elseif CInt(contMain.edtQty.caption) > CInt(contMain.tbl0.GetCellString(4, 1)) then
		ShowAlert("안내", "청약 가능 수량을 확인해 주세요")
		Exit Sub
	elseif Trim(contMain.lblTel.caption) == "　" or contMain.lblTel.caption == null then
		Form.MsgBox( "안내", "통보처가 존재하지 않습니다.\n통보처 등록 후 신청 가능합니다.", "NO_CALL", 7, "확인", "고객센터지원" )
		Exit Sub
	elseif g_szCustClsCd == "2" then 	'법인
		if Trim(contMain.lblAddr.caption) == "　" or contMain.lblAddr.caption == null then
			Form.MsgBox( "안내", "통보처가 존재하지 않습니다.\n통보처 등록 후 신청 가능합니다.", "NO_CALL", 7, "확인", "고객센터지원" )
			Exit Sub
		end if
	end if 
		Form.OpenPopupAnimation("mbonl83200_p3", g_szLinkData & "★" & acntMain.caption, "","2"	)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl83200_p3_ok" then
		Form.openPopupAnimation("pwdcheckpopup", acntMain.caption& "☆0" ,"","2")
		
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" And sRet <> Null then
			g_tPwdData = Split(sRet, "★")
			g_szPwd = g_tPwdData(0)
			if UBOUND(g_tPwdData) > 0 then
				'Form.ShowAlert( "Form_OnPopupReturn" , "")
				'20230803 SWJ START 'v0001
				'(미리호출함)
			     '모바일OTP 보안매체가 원장 기준으로는 있더라도
				 '앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
				 Form.SetTimerEvent2(1, 1, 0.1)
			     '20230803 SWJ END
			end if
		end if
	elseif sKeyName == "mhetc90060_p5" then 							'							> test skip
		if sRet ~= "cancel" then	
			
			DATAMANAGER.RequestTranData( "obibk_tbal_001a" )
		end if
	
	elseif sKeyName == "mbonl81000" then
		if g_szCustClsCd == "1" then 		'개인
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
    Form.CloseForm()
End Sub

'============================================================================
Sub lblTitle_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub acntMain_ChangeAccount()
	contMain.edtQty.caption = ""
	contMain.lblTel.caption = "　"
	contMain.lblAddr.caption = "　"
	DATAMANAGER.RequestTranData( "obibk_tbal_001r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "NO_CALL" then
		if sRet == "no" then
			Form.OpenScreen("89020" , "")
		end if
	elseif sKeyName == "PRHBYN_3" then 
		if sRet == "no" then
			Form.OpenScreen("83200" , "2")
		else
			
		end if 
	end if
End Sub

''============================================================================
'

'============================================================================
Sub contMain_edtQty_OnClick()
	contMain.edtHintCaption.visible = false
End Sub

'============================================================================
Sub contMain_edtQty_OnEditComplete()
	if contMain.edtQty.caption == "" or contMain.edtQty.caption == null then
		contMain.edtHintCaption.visible = true
	end if
End Sub

'============================================================================
'20230803 SWJ START 'v0001
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'보안매체 없음 팝업에서
	'모바일OTP 및 OTP 발급 후 인증까지 완료하고 여기를 통해 진입함
	if Form.GetSharedData("CommonNoSecurity", true ) == "Y" then
		if sKey == "&CommonNoSecurity" and Cint(sValue) == 6 then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)	
		end if
	end if
End Sub
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨 v0001
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
	if sEventName == "MOTP_GETINFO_RETURN_83201" then
		mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		if Ubound(mOTPInfo) < 1 then
			exit sub
		else	
			g_motpAppYN = mOTPInfo(0)
			
		end if
	end if
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 0.1)
		Form.requestMOTP("MOTP_GETINFO"     , "" , "83201")     '등록된 OTP alias 존재하는지 확인
	     DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	end if
End Sub

