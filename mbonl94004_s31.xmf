	end if
End Sub
'============================================================================
' cont0_edtRcno_OnEditComplete() : 생일 편집완료 > 에디트 키패드로 인한 컨테이너 조정
'============================================================================
Sub cont0_edtRcno_OnEditComplete()
	cont0.edtRcno.imagefilepth	= "login_input_off.9.png"
	if g_OsType == "1" then 'AOS
		cont0.lblLine.top = 475
		cont0.scroll_pos = 0
		cont0.SetScrollAutoSize()
