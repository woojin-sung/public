'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	Select Case szTranID	
			
		'신분증 등록
		Case "obaci_acct_158a"	
			Dim szJumin 
			szjumin = Form.GetSharedData("&JUMIN_NUM", false )	'취약점 보완후 암호화된 값으로 내려옴
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"		, 0 	, Len(g_ImgData)				) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IMG_DATA"		, 0 	, g_ImgData 					) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, g_szIDNTF_CODE 				) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"		, 0 	, szjumin					)	'22.05.17 &JUMIN_NUM 쉐어드값으로 변경
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BRDT"  				, 0 	, Trim(cont0.edtRcno.caption)	) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_szRCNO_7 	 				)
			
		'금결원_신분증 진위확인
		Case "obtss_idvs_001a"			
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_CLS_CODE"             , 0 , g_szIDNTF_CLS_CODE			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"                   , 0 , g_szAFT_RCNO_PIP			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"              , 0 , g_szRCNO_PIP					)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_FLNM"                 , 0 , cont0.edtName.caption		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_IDNTF_FLNM"            , 0 , g_szNAME					)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISNC_DATE_PIP"              , 0 , cont0.edtIssueDate.caption	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_ISNC_DATE_PIP"         , 0 , g_szISSU_DATE				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OLD_DRVN_LCNS_NO_PIP"       , 0 , "" 			)
			'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OLD_DRVN_LCNS_NO_PIP"       , 0 , g_szLISENCE_NUM 			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP"  , 0 , ""   			)
			'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP"  , 0 , g_szLISENCE_NUM   			)
			
			'운전면허번호 4개 필드로 분리
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_REGN_CODE" 		, 0 	, g_LISENCE_NUM1				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_YEAR" 			, 0 	, g_LISENCE_NUM2				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_SRNO_PIP" 		, 0 	, g_LISENCE_NUM3				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_DETL_SRNO" 		, 0 	, g_LISENCE_NUM4				)
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_SPFT_VLTN_SCOR"       , 0 , g_szFEATURE_SCORE			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"             , 0 , g_szFEATURE_LEN 			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_PHTG_DATA_CNTT"          , 0 , g_szFEATURE				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NMET_CLS_CODE"              , 0 , "10" 						)	'10:비대면모바일
			
		'진위확인오류내역 
		Case "obaci_idvs_003a"
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_TORF_CNFR_RSLT_CLCD" , 0 , g_szRSPN_TYPE_CODE			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"                  , 0 , g_szAFT_RCNO_PIP			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_TORF_CNFR_RCNO_PIP"  , 0 , g_szAFT_RCNO_PIP			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_CLS_CODE"            , 0 , g_szIDNTF_CLS_CODE			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"             , 0 , g_szRCNO_PIP				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_FLNM"                , 0 , cont0.edtName.caption		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_IDNTF_FLNM"           , 0 , g_szNAME					)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISNC_DATE_PIP"             , 0 , cont0.edtIssueDate.caption	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_ISNC_DATE_PIP"        , 0 , g_szISSU_DATE				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OLD_DRVN_LCNS_NO_PIP"      , 0 , ""				)
			'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OLD_DRVN_LCNS_NO_PIP"      , 0 , g_szLISENCE_NUM				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP" , 0 , ""				)
			'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP" , 0 , g_szLISENCE_NUM				)
			
			'운전면허번호 4개 필드로 분리
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_REGN_CODE" 		, 0 	, g_LISENCE_NUM1				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_YEAR" 			, 0 	, g_LISENCE_NUM2				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_SRNO_PIP" 		, 0 	, g_LISENCE_NUM3				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_ISNC_DETL_SRNO" 		, 0 	, g_LISENCE_NUM4				)
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_SPFT_VLTN_SCOR"      , 0 , g_szFEATURE_SCORE			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_DATE"                   , 0 , g_szTR_DATE				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"           , 0 , g_szOTSDTRUNIQNO			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_TORF_YN"             , 0 , g_szIDNTF_TORF_YN			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SCR_TYPE_CLS_CODE"         , 0 , "1" 						)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_UNIQ_NO"               , 0 , Form.GetSharedData( "&HOST_DATE", False ) & "D0000"	) '신분증 진위확인만 하는경우 : 오늘날짜+T0000(총 8자리)
			
		'2022.04.25 obcsb_nmet_102c 서비스 추가
		Case "obcsb_nmet_102c"
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NMET_BSWR_CLCD" 		, 0 , "010"					)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO" 		, 0 , Form.GetSharedData( "&HOST_DATE", False ) & "D0000"	)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_CLS_CODE"		, 0 , "2"					)	'2.신분증진위확인
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_szOTSDTRUNIQNO			)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "TR_DATE"				, 0 , g_szTR_DATE				)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_SRNO"			, 0 , cont0.edtSRNO.caption		)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"		, 0 , g_szRSPN_TYPE_CODE		)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_TORF_YN"		, 0 , g_szIDNTF_TORF_YN		)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_szFEATURE_LEN			)
		
	End Select
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'신분증 등록
	If szTranID = "obaci_acct_158a" then
		cont0.edtSRNO.caption 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SRNO" 		, 0)	'신분증등록일련번호
		g_szAFT_RCNO_PIP 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MDAF_RCNO_PIP"	, 0) '변경후실명확인번호PIP
		
		g_szRSPN_TYPE_CODE = ""
		DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		
		Form.SetTimerEvent("1", 1, 30)

	'금결원_신분증 진위확인
	ElseIf szTranID = "obtss_idvs_001a" Then 
		'Form.SetTimerEvent("1", 0, 30)
		
		g_BIOTrName	= szTranID
		g_BIORetry	= 0
		g_szOTSDTRUNIQNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
		
		Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
	ElseIf szTranID == "obtss_idvs_002a" Then
		sCODE 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 		, 0)
		'g_szTR_DATE        = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0) '거래일자
		'g_szOTSDTRUNIQNO   = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO"	, 0) '대외거래고유번호
		g_szRSPN_TYPE_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_TYPE_CODE"	, 0) '응답유형코드 (0:정상 9:오류  8:수기허용 R:재시도)
		g_szRSPN_MSG       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0) '응답메시지내용
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		if sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry = g_BIORetry + 1
			'v0003
			'if g_BIORetry >= 3 then 
			if g_BIORetry >= 21 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry= 0 '초기화
				Exit Sub
			end if 
			
			Form.SetTimerEvent(3,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			Exit Sub
		end if
		
		
		'정상
		If g_szRSPN_TYPE_CODE == "0" Then 
			
			g_szTR_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0) '거래일자
			
			'신분증진위확인여부
			g_szIDNTF_TORF_YN = "Y" 		
			
			'2022.04.25 obcsb_nmet_102c 서비스 추가
			DATAMANAGER.RequestTranData("obcsb_nmet_102c")
		Else
			'TEST > 테스트-SKIP처리인경우, 정상으로 처리
			if ChkButton0.checkstate == "1" or ChkButton0.checkstate == 1 then		
				'신분증진위확인여부
				g_szIDNTF_TORF_YN = "Y" 		
				g_szRSPN_TYPE_CODE = "0"	'22.05.17 테스트일경우 추가
				
				'2022.04.25 obcsb_nmet_102c 서비스 추가
				DATAMANAGER.RequestTranData("obcsb_nmet_102c")
			else
				'신분증진위확인여부
				g_szIDNTF_TORF_YN = "N"
	
				'진위확인 오류내역 생성추가
				DATAMANAGER.RequestTranData("obaci_idvs_003a")
			end if
		End If
	
	'2022.04.25 obcsb_nmet_102c 서비스 추가
	ElseIf szTranID == "obcsb_nmet_102c" Then 	
		'========== [정상]알림팝업(mbbdm85121_p1) ==========
		Dim szTitle, szMsg, szFlag 
		szTitle = "알림"
		szMsg = "신분증 전송이 완료 되었습니다."
		szFlag = "complete"
		
		if g_OsType == "1" then 'AOS
			Form.setCaptureEnblYN("Y")
		end if
		
		Form.OpenPopup("mbbdm85121_p1" , szTitle.."#"..szMsg.."#"..szFlag , "5")
		
    '진위확인이력생성 
	ElseIf szTranID == "obaci_idvs_003a" Then		
		Dim szMsg
		szMsg = ""
		If g_szRSPN_TYPE_CODE == "8" Then  '수기허용 
			'수기허용도 진위확인 오류로 처리함
			szMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf g_szRSPN_TYPE_CODE == "R" Then	'재시도
			szMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf g_szRSPN_TYPE_CODE == "9" Then	'오류
			szMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
		ElseIf g_szRSPN_TYPE_CODE == "7" Then		
			szMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
		Else
			If Trim(g_szRSPN_MSG) <> "" Then
				szMsg = g_szRSPN_MSG
			Else
				szMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
			End If
		End If
		
		if g_OsType == "1" then 'AOS
			Form.setCaptureEnblYN("Y")
		end if
		
		
		Form.OpenPopup("mbbdm85122" , szMsg)	
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsg
	szMsg = ""	
	
	if szTranID == "obaci_acct_158a" then
		If szErrCode = "4984" then
			'========== [에러]알림팝업(mbbdm85121_p1) ==========
			szMsg = "생년월일을 확인하세요.(주민번호 앞 6자리)"
			
			Dim szTitle, szFlag 
			szTitle = "알림"
			szFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , szTitle.."#"..szMsg.."#"..szFlag , "5")
			
		Else 
			szMsg = "신분증 정보를 읽을 수 없습니다.다시 시도하여 주십시요."
			Form.OpenPopup("mbbdm85122" , szMsg)	
		End If
		
	
	elseIf szTranID == "obtss_idvs_001a" or szTranID == "obtss_idvs_002a" Then 

		'22.05.17 테스트일경우 추가
		if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then
			'테스트_신분증인증SKip
		     Form.SetTimerEvent("1", 0, 30)
		     
			'g_szTR_DATE		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
			'g_szOTSDTRUNIQNO	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
			g_szRSPN_TYPE_CODE = "0"	'0:정상 9:오류  8:수기허용 R:재시도	
			g_szIDNTF_TORF_YN  = "Y" 	'신분증진위확인여부	
			
			'2022.04.25 obcsb_nmet_102c 서비스 추가
			DATAMANAGER.RequestTranData("obcsb_nmet_102c")
		Else
			Dim szMsgTmp
			szMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
			szMsg = szErrMsg & Chr(13) & Chr(10) & szMsgTmp
			
			Form.OpenPopup("mbbdm85122" , szMsg)
		End If
		
	'2022.04.25 obcsb_nmet_102c 서비스 추가
	elseIf szTranID == "obcsb_nmet_102c" Then 
		Dim szMsgTmp
		szMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
		szMsg = szErrMsg & Chr(13) & Chr(10) & szMsgTmp
		
		Form.OpenPopup("mbbdm85122" , szMsg)
    '진위확인이력생성 
	ElseIf szTranID == "obaci_idvs_003a" Then
         '이력생성중 오류인 경우인 경우 오류종료처리하지 않고, 진위확인오류로 처리함
		If g_szRSPN_TYPE_CODE = "8" Then  '수기허용 
			'수기허용도 진위확인 오류로 처리함
			szMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf g_szRSPN_TYPE_CODE = "R" Then	'재시도
			szMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		'v0003
		ElseIf g_szRSPN_TYPE_CODE = "9" Then	'오류
			'szMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
			szMsg = "죄송합니다. \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."		
		ElseIf g_szRSPN_TYPE_CODE = "7" Then		
			szMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
		Else
			If Trim(g_szRSPN_MSG) <> "" Then
				szMsg = g_szRSPN_MSG
			Else
				szMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
			End If
		End If
		
		Form.OpenPopup("mbbdm85122" , szMsg)
	end if
	
End Sub

'============================================================================
' Form_OnTimerEvent(sTimerID) : 타이머이벤트
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID == "1" or sTimerID == 1 Then
		Form.ShowAlert("오류", "통신상태가 원활하지 않습니다.\n잠시 후 다시 처리해 주세요.")
		Form.SetTimerEvent(sTimerID, 0, 30)
		Exit Sub
	  'v0001 jsi start
	ElseIf sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2(sTimerID, 0, DEF_1ST_TIME)
		
