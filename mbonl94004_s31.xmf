'--===========================================================================
' 01. 화 면 명 : 지정신청심사
' 02. 화면설명 : mbonl94004_s2 개선건 적용 신분증 본인확인
' 03. 작    성 : 2022.04.12
' 04. 수    정 : 
' 2022.08.12 : 전상일 : v0001 : 바이오인증 송수신 분리 개발
' 2024.04.24 : 전상일 : v0002 : 캡쳐방지 위치 변경
' 2023.04.26 : 전상일 : v0003 : 바이오인증 송수신 처리 대기 횟수 증가
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'============================================================================
' OCR 데이터 및 특징점 추출데이터 (메인에서 취득)
'============================================================================
Dim g_szIdCardType	'신분증구분(주민등록증 10, 주민등록증(재외국민)12, 면허증11)
Dim g_ImgData			'주민번호 마스킹 없는 이미지(서비스 전송용)

Dim g_szIDNTF_CODE 	'신분증유형
Dim g_szIDNTF_CLS_CODE '신분증구분코드(01:주민등록 02:운전면허 03:외국인증록증/국내거소신고증 04:국가유공자증 05:장애인등록증)

Dim g_szNAME			'이름
Dim g_szRCNO_PIP		'암호화된 실명확인번호		
Dim g_szISSU_DATE		'발급일자
Dim g_szLISENCE_NUM	'신분증번호

'20230807 장외파생상품 개선 운전면허증 번호 세분화(비대면계좌개설과 동일하게 변경)
Dim g_LISENCE_NUM1	'발급지역코드(평문)
Dim g_LISENCE_NUM2     '발급년도(평문)
Dim g_LISENCE_NUM3     '발급일련번호1(암호화)
Dim g_LISENCE_NUM4     '발급일련번호2(암호화)

Dim g_szRCNO_7		'실명확인번호 뒷 7자리 

Dim g_szFEATURE		'특징점데이터
Dim g_szFEATURE_LEN	'특징점데이터 길이
Dim g_szFEATURE_SCORE 	'특징점 점수

'============================================================================
' 쉐어드변수 및 기타 전역변수
'============================================================================
Dim g_szSharedName	'성명
Dim g_szSharedBirth	'생년월일

Dim g_szRSPN_TYPE_CODE '진위확인응답유형코드(0:정상 9:오류  8:수기허용 R:재시도)
Dim g_szRSPN_MSG	

Dim g_szTR_DATE
Dim g_szOTSDTRUNIQNO
Dim g_szAFT_RCNO_PIP
Dim g_szIDNTF_TORF_YN 	'신분증진위확인여부

Dim g_szOsType	'OS타입(1:AOS / 2:IOS )

DIM DEF_1ST_TIME
DIM DEF_2ST_TIME

DEF_1ST_TIME = 0.5
DEF_2ST_TIME = 1.0


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_DataSet() : 사진촬영 후 메인에서 받은 데이터 세팅
'============================================================================
Sub f_DataSet()

	g_ImgData = ""

	'주민등록증 10, 주민등록증(재외국민)12, 면허증11
	g_szIdCardType = Form.GetSharedData("&RET_CARD_TYPE", 0)
	
	If g_szIdCardType == "10" or g_szIdCardType == "12" then
		
		cont0.edtLicenseNo.left = 500
		cont0.edtLicenseNo.visible = false
		cont0.lblLicenseNo.visible = false
		
		cont0.edtLicense1.visible = false
		cont0.edtLicense2.visible = false
		cont0.edtLicense3.visible = false
		cont0.edtLicense4.visible = false
		cont0.lblDash1.visible = false
		cont0.lblDash2.visible = false
		cont0.lblDash3.visible = false
		
		cont0.edtIssueDate.top = 367
		cont0.lblIssueDate.top = 369
		cont0.Button0.height = 152
		
		g_szIDNTF_CODE     =  "1"  
		g_szIDNTF_CLS_CODE =  "01" 		
		
	Elseif g_szIdCardType == "11" then
	
'		'면허번호 중요정보로 숨김처리
'		cont0.edtLicenseNo.left = 500
'		cont0.edtLicenseNo.visible = false
'		cont0.lblLicenseNo.visible = false
'		
'		cont0.edtIssueDate.top = 367
'		cont0.lblIssueDate.top = 369
'		cont0.Button0.height = 152
		
		g_szIDNTF_CODE     =  "2"  
		g_szIDNTF_CLS_CODE =  "02"
		
	End if
	
	'OCR정보 세팅
	cont0.edtName.caption  	= Form.GetSharedData("&RET_NAME", 0)				'이름
	cont0.edtRcno.caption  	= left(Form.GetSharedData("&RET_BIRTHDAY", 0), 6)	'생년월일
	cont0.edtLicenseNo.caption 	= Form.GetSharedData("&RET_LICENSE_NUM", 0) 		'면허번호
	cont0.edtIssueDate.caption 	= Form.GetSharedData("&RET_ISSU_DATE", 0) 		'발급일자
	
	'운전면허번호 4영역으로 분할
	cont0.edtLicense3.pwdlen = 6
	
	cont0.edtLicense1.caption = Form.GetSharedData("&RET_LICENSE_NUM1"	, 0 )
	cont0.edtLicense2.caption = Form.GetSharedData("&RET_LICENSE_NUM2"	, 0 )
	cont0.edtLicense3.caption = Form.GetSharedData("&RET_LICENSE_NUM3"	, 0 )
	cont0.edtLicense4.caption = Form.GetSharedData("&RET_LICENSE_NUM4"	, 0 )
	
	
	g_szNAME			= Form.GetSharedData("&RET_NAME"			,0 ) '이름
	g_szRCNO_PIP		= Form.GetSharedData("&RET_JUMIN_NUM"		,0 ) '암호화된 실명확인번호
	g_szISSU_DATE		= Form.GetSharedData("&RET_ISSU_DATE"		,0 ) '발급일자
	
	g_szFEATURE		= Form.GetSharedData("&RET_FEATURE"			,0 ) '특징점데이터
	g_szFEATURE_SCORE	= Form.GetSharedData("&RET_FEATURE_SCORE"	,0 ) '특징점 점수
	g_szFEATURE_LEN  	= Form.GetSharedData("&RET_FEATURE_LEN"		,0 ) '특징점데이터 길이
'	g_SERIAL    	  = Form.GetSharedData("&RET_SERIAL"			, 0 ) 	'발급번호
	g_szLISENCE_NUM	= Form.GetSharedData("&RET_LICENSE_NUM"		,0 ) '신분증번호

	'운전면허증번호 4자리로 세분화
	g_LISENCE_NUM1 	= Form.GetSharedData("&RET_LICENSE_NUM1"	, 0 ) 	'발급지역코드(평문) 
	g_LISENCE_NUM2 	= Form.GetSharedData("&RET_LICENSE_NUM2"	, 0 ) 	'발급년도(평문)
	g_LISENCE_NUM3 	= Form.GetSharedData("&RET_LICENSE_NUM3"	, 0 ) 	'발급일련번호1(암호화)
	g_LISENCE_NUM4 	= Form.GetSharedData("&RET_LICENSE_NUM4"	, 0 ) 	'발급일련번호2(평문)

	g_szRCNO_7		= Form.GetSharedData("&RET_JUMIN_NUM_BACK"	,0 ) '실명확인번호 뒷 7자리

	Dim ImgMskData
	ImgMskData 	    = Form.GetSharedData("&RET_MASK_IMAGE_ENC" 	,0 ) '주민번호 마스킹이미지
	g_ImgData  	    = Form.GetSharedData("&RET_IMAGE_ENC"		,0 ) '주민번호 마스킹없는이미지
	
	if ImgMskData <> "" and g_ImgData <> "" then 
		if LEN(g_ImgData) > 0  and LEN(ImgMskData) > 0 then
			cont0.imgIdCard.SetImageDataEnc(ImgMskData)
			
'			'OCR정보 세팅
'			cont0.edtName.caption  	= Form.GetSharedData("&RET_NAME", 0)				'이름
'			cont0.edtRcno.caption  	= left(Form.GetSharedData("&RET_BIRTHDAY", 0), 6)	'생년월일
'			cont0.edtLicenseNo.caption 	= Form.GetSharedData("&RET_LICENSE_NUM", 0) 		'면허번호
'			cont0.edtIssueDate.caption 	= Form.GetSharedData("&RET_ISSU_DATE", 0) 		'발급일자
			
		end if
	end if
	
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'==================================
	' TEST
	'==================================
	nDev = Form.GetSharedData("&SERVER_MODE", false )	
	if nDev == "1" then
		ChkButton0.visible = true
	else
		ChkButton0.visible = false
		ChkButton0.checkstate = 0
	end if
	'==================================
		
	'라벨글자색
	cont0.lblInfo0.fgcolor = 269
	cont0.lblInfo1.fgcolor = 269
	
	cont0.lblName.fgcolor 		= 268	
	cont0.lblBirth.fgcolor 	= 268
	cont0.lblLicenseNo.fgcolor 	= 268
	cont0.lblIssueDate.fgcolor 	= 268
	
	'이름/생일 에디트 이미지
	cont0.edtName.imagefilepth	= "login_input_off.9.png"
	cont0.edtRcno.imagefilepth	= "login_input_off.9.png"
	cont0.edtLicense3.imagefilepth = "login_input_off.9.png"

	'OS타입
	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	if g_OsType == "1" then 'AOS
		Form.setCaptureEnblYN("N")
	end if
		
	'거래일자 세팅
	g_szTR_DATE  = Form.GetSharedData("&HOST_DATE", false )

	'발급일자 컨트롤 세팅(평문으로 보여야함)
	cont0.edtIssueDate.SetDispPlain()
	
	'신분증 데이터 세팅
	Call f_DataSet()
	
	imgProcess.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgProcess.setMaintainingRatio("1")
End Sub

'============================================================================
' cont0_edtName_OnClick() : 이름 선택 > 에디트 키패드로 인한 컨테이너 조정
'============================================================================
Sub cont0_edtName_OnClick()
	cont0.edtName.imagefilepth	= "login_input_on.9.png"
	
	if g_OsType == "1" then 'AOS
		cont0.lblLine.top = 505
		cont0.SetScrollAutoSize()
		cont0.scroll_pos = 25
	else
		cont0.lblLine.top = 505
		cont0.scroll_pos = 20
	end if
End Sub
'============================================================================
' cont0_edtName_OnClick() : 이름 편집완료 > 에디트 키패드로 인한 컨테이너 조정
'============================================================================
Sub cont0_edtName_OnEditComplete()
	cont0.edtName.imagefilepth = "login_input_off.9.png"
	
	if g_OsType == "1" then 'AOS
		cont0.lblLine.top = 475
		cont0.scroll_pos = 0
		cont0.SetScrollAutoSize()
	else
		cont0.lblLine.top = 475
		cont0.scroll_pos = 0
	end if
End Sub

'============================================================================
' cont0_edtName_OnClick() : 생일 선택 > 에디트 키패드로 인한 컨테이너 조정
'============================================================================
