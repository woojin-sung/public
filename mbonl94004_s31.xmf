		cont0.lblLine.top = 475
		cont0.scroll_pos = 0
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbdm85121_p1" then
		if sRet == "complete_ok" then
			
			Form.SetSharedData("&RET_NAME" 		, g_szSharedName)	'이름
			Form.SetSharedData("&RET_NAME" 		, g_szSharedName)	'이름
			Form.SetSharedData("&RET_ISSU_DATE"  , cont0.edtIssueDate.caption)		'신분증 발급일자	
			
			'v0002
			'if g_OsType == "1" then 'AOS
			'	Form.setCaptureEnblYN("Y")
			'end if
			
			Form.triggerEvent("#", "COMPLETE_TRUE_AND_FALSE", cont0.edtSRNO.caption)			
		end if
	
	elseif sKeyName == "mbbdm85122" then
		if sRet == "Retry" then
			Form.triggerEvent("#", "RETRY", szSRNO)
		end if
		
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	' 신분증전송-------------------------------------------------
	if sEventName == "JUDGE_TRUE_AND_FALSE" then
		if g_szIdCardType = "12" then 
			strMsg = "재외국민은 비대면 업무신청이 불가합니다."
			Form.OpenPopup("mbbdm85122" , strMsg)
		
		else
			g_szSharedName 	= Form.GetSharedData("mbonl94004_USER_NAME" 	,false ) '이름
			g_szSharedBirth	= Form.GetSharedData("mbonl94004_USER_BIRTH"	,false )	'생년월일 

			'Test > 테스트Skip인경우, 체크 제외
			if CInt(ChkButton0.checkstate) ~= 1 then 
				'-------------------------------------------------
				'입력데이터 확인 및 OCR데이터와 전단계화면 데이터 비교
				'-------------------------------------------------
				'========== [에러]알림팝업(mbbdm85121_p1) ==========
				Dim szTitle, szMsg, szFlag 
				szTitle = "알림"
				szFlag = "error"
				szMsg = ""
				if Trim(cont0.edtName.caption) == "" or g_szSharedName <> Trim(cont0.edtName.caption) then 
					szMsg = "이름을 확인하세요."
					Form.OpenPopup("mbbdm85121_p1" , szTitle.."#"..szMsg.."#"..szFlag , "5")
					exit Sub 
				end if
				
				if Trim(cont0.edtRcno.caption) == "" or g_szSharedBirth <> Trim(cont0.edtRcno.caption) then
					szMsg = "생년월일을 확인하세요.(주민번호 앞 6자리)"
					Form.OpenPopup("mbbdm85121_p1" , szTitle.."#"..szMsg.."#"..szFlag , "5")
					exit Sub 
				end if
				
				rcnoLen = cont0.edtRcno.getLen(cont0.edtRcno.caption)
				if cint(rcnoLen) < 6 then
					szMsg = "생년월일을 확인하세요.(주민번호 앞 6자리)"
					Form.OpenPopup("mbbdm85121_p1" , szTitle.."#"..szMsg.."#"..szFlag , "5")
					exit Sub 	
				end if
				
				if CInt(left(cont0.edtIssueDate.caption,4)) < 8 then
					szMsg = "발급일자를 확인하주시기 바랍니다."
					Form.OpenPopup("mbbdm85121_p1" , szTitle.."#"..szMsg.."#"..szFlag , "5")
					exit Sub  
				end if
			end if

			'-------------------------------------------------
			'서비스호출
			'재시도의 경우 obaci_acct_158a SKIP 후 obtss_idvs_001a Call
			'-------------------------------------------------
			If g_szRSPN_TYPE_CODE <> "R" then
				if Len(g_ImgData) < 102400 then	'이미지 최대사이즈 
					DATAMANAGER.RequestTranData("obaci_acct_158a")
				else
					Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
				end if	
			else
				g_szRSPN_TYPE_CODE = ""
				DATAMANAGER.RequestTranData("obtss_idvs_001a") 
				'v0001
				'Form.SetTimerEvent("1", 1, 30) '1:Set
			end If
		end if
	end if
End Sub



