	<SCRIPT_INFO _len="558" _ulen="558" >
Dim g_curTab
Dim g_nRandom

g_curTab = 0
'============================================================================
Sub Form_OnFormInit()
	Form.triggerEvent("FormTab0."& FormTab0.currenttabpageid, "Forminit", "")
	FormTab0.SetPageBarPos("TR",10) 
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if g_curTab <> nCurrentTab then
		Form.triggerEvent("FormTab0."& FormTab0.currenttabpageid, "TabChange", nCurrentTab.."|".."")
		g_curTab = nCurrentTab
	end if
End Sub

