		<CONTAINER name="contMain" vscroll="1" scroll_pos="0,0" ly_vert="0,60,375,537,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="Label0" fontsize="1" fontstyle="01" caption="모바일OTP 이용안내" paddinginfo="1,0,0,0" ly_vert="20,5,220,20,1" />
				<LABEL name="Label1" fontsize="1" fontstyle="01" caption="유의사항" paddinginfo="1,0,0,0" ly_vert="20,308,220,20,1" />
				<TABLE name="Table1" insidelinecolor="102:255255255" colcount="1" rowcount="16" outline="0000" designorder="1" ly_vert="15,353,345,278,1" >
					<COL_INFO ly_vert_width="345" />
					<ROW_INFO ly_vert_height="20,20,7,20,20,7,20,20,7,20,20,7,20,20,20,30" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="146:124124124" halign="0" line="0,0" caption="· 모바일OTP 발급 시 등록된 토큰OTP(스마트OTP 포함)" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="146:124124124" halign="0" line="0,0" caption="   는 이용 해지됩니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="146:124124124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="146:124124124" halign="0" line="0,0" caption="· 모바일OTP는 메리츠증권에서만 이용이 가능하며," fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="146:124124124" halign="0" line="0,0" caption="   1인 1단말기로 제한됩니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="146:124124124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="146:124124124" halign="0" line="0,0" caption="· 스마트폰 기기 변경, OTP인증 10회 오류, 앱 재설치 등의" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="146:124124124" halign="0" line="0,0" caption="   경우에는 재발급 하시기 바랍니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="146:124124124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="146:124124124" halign="0" line="0,0" caption="· 모바일OTP 비밀번호는 타인에게 유출되지 않도록" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,10,0,10" fgcolor="146:124124124" halign="0" line="0,0" caption="   각별히 유의하시기 바랍니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,11,0,11" fgcolor="146:124124124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,12,0,12" fgcolor="146:124124124" halign="0" line="0,0" caption="· 모바일 OTP를 발급 받은 스마트폰을 분실한 경우," fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,13,0,13" fgcolor="146:124124124" halign="0" line="0,0" caption="   고객지원센터(1588-3400) 또는 영업점에 신고하시기" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,14,0,14" fgcolor="146:124124124" halign="0" line="0,0" caption="   바랍니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,15,0,15" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="Label2" bgcolor="256:238239240" transmode="0" ly_vert="20,36,335,1,1" />
				<LABEL name="Label3" fontsize="-2" caption="모바일OTP는 별도의 실물 보안매체 없이 간편하게 인증이
가능합니다. 스마트폰의 안전한 영역에서 사용자 검증을
통해 생성된 OTP번호를 자동으로 인증합니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,54,335,50,1" />
				<LABEL name="Label4" bgcolor="066:238239240" transmode="0" ly_vert="20,118,335,170,1" />
				<LABEL name="lblText0" fontsize="-2" caption="· 발급대상: 만 19세이상 개인고객" paddinginfo="1,0,0,0" ly_vert="40,134,302,20,1" />
				<LABEL name="lblText1" fontsize="-2" caption="· 발급채널: 메리츠SMART APP" paddinginfo="1,0,0,0" ly_vert="40,159,302,20,1" />
				<LABEL name="lblText2" fontsize="-2" caption="· 이체한도: 1회 최대 1억원 / 1일 최대 5억원" paddinginfo="1,0,0,0" ly_vert="40,184,302,20,1" />
				<LABEL name="lblText3" fontsize="-2" caption="· 이용가능 스마트폰:" paddinginfo="1,0,0,0" ly_vert="40,209,302,20,1" />
