'============================================================================
' 01.화면명 	: 뉴스/공시
' 02.화면설명	: 뉴스/공시_상세팝업창
' 03.작성	: 2016.01.07
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szDate, g_szTime, g_szNewCorpName, g_szNewKey, g_szNewsCorpCode
Dim g_nFontSize					'웹뷰 폰트사이즈

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'btnZoomIn_OnClick
'============================================================================
Sub btnZoomIn_OnClick()

	if g_nFontSize = 0 then
		webNews01.fontsize = 1
		g_nFontSize = 1
	elseif g_nFontSize = 1 then
		webNews01.fontsize = 2
		g_nFontSize = 2
	elseif g_nFontSize = -2 then
		webNews01.fontsize = -1
		g_nFontSize = -1
	elseif g_nFontSize = -1 then 
		webNews01.fontsize = 0
		g_nFontSize = 0
	else 
		webNews01.fontsize = 2
		g_nFontSize = 2
	end if
End Sub


'============================================================================
'btnZoomOut_OnClick
'============================================================================
Sub btnZoomOut_OnClick()

	if g_nFontSize = 0 then
		webNews01.fontsize = -1
		g_nFontSize = -1
	elseif g_nFontSize = -1 then
		webNews01.fontsize = -2
		g_nFontSize = -2
	elseif g_nFontSize = 2 then
		webNews01.fontsize = 1
		g_nFontSize = 1
	elseif g_nFontSize = 1 then 
		webNews01.fontsize = 0
		g_nFontSize = 0
	else
		webNews01.fontsize = -2
		g_nFontSize = -2
	end if
End Sub


'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szDate			= arrData(1)
	g_szTime			= arrData(2)
	g_szNewCorpName	= arrData(3)
	g_szNewKey		= arrData(4)
	g_szNewsCorpCode	= arrData(5)
	
	tblHeader01.SetCellString( 0, 0, arrData(0))
	tblHeader01.SetCellString( 1, 0, g_szDate)
	tblHeader01.SetCellString( 1, 1, g_szTime)
	tblHeader01.SetCellString( 1, 2, g_szNewCorpName)
End Sub


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_nFontSize = 0
    	Form.SetScreenName("뉴스/공시")
	DATAMANAGER.RequestTranData( "ohhts_news_002r" )

End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0, "ohhts_news_002r", "InBlock1", "FID_INPUT_SRCH_NAME"  		, 0 , g_szNewKey )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_002r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , g_szNewsCorpCode )	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData, szStrTemp, szNewsData
	
	If szTranID = "ohhts_news_002r" Then
	    Dim nCnt, i, szUrlPath
	    
	    szData = ""
	    szStrTemp = ""
	    szNewsData = ""
	    
	    nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_news_002r", "OutBlock1" )	    	    

		for i =0 to nCnt - 1
		    szStrTemp 	= DATAMANAGER.GetDataValue( 0, "ohhts_news_002r", "OutBlock1", "FID_NEWS_CNTT", i )
		    szNewsData	= szNewsData & szStrTemp
	    next
	    
	End If

	webNews01.loaddata = szNewsData

End Sub

