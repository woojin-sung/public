'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
' SetNoticeMsg() : 환율정보가 경우 메시지 처리
'============================================================================
Function SetNoticeMsg()
	if CStr(Pannel0.rowcount) == "0" then 
'	     영업일오전
		'lbNoticeMsg.caption = "환율정보가 없어요. 9시이후 조회돼요."
		lbNoticeMsg.caption = "환율정보가 없어요."
		imgNotice.left = 160
		lbNoticeMsg.left = 87 				
		imgNotice.visible = true
		lbNoticeMsg.visible = true 		
	else
		imgNotice.left = 671
		lbNoticeMsg.left = 587 				
		imgNotice.visible = false
		lbNoticeMsg.visible = false 					
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	ImgRefresh.setMaintainingRatio("1")
	Pannel0.imgBG.setMaintainingRatio("1")	
	Pannel0.imgDetail.setMaintainingRatio("1")	
	Pannel0.bgcolor = "066"	
	Label0.bgcolor = "066"	
	imgNotice.setMaintainingRatio("1")	
End Sub

'============================================================================
Sub Form_OnFormInit()
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	if szScrNo == "65000" or szScrNo == "65010" then
		Pannel0.height = 578
	end if
	
	'ImgRefresh_OnClick()
	ExeQuery()
	'Form.SetTimerEvent(1, 1, 60)	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INFO_REFRESH" then
		Calendar0.caption = CalToday.caption '오늘날짜
		'ImgRefresh_OnClick()
		ExeQuery()
	 end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtsd_fbnk_225r" then
		Pannel0.rowcount = 0
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE", 0, Calendar0.caption )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, "287" )
	elseif szTranID == "obcpp_bsdy_006r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLND_CLS_CODE" , 0 , "C001" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MANG_DATE" , 0 , calTempDate.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CALC_DYNU" , 0 , "1" )		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID =	"obtsd_fbnk_225r"	then
		Dim nCnt, szCRCD, szVisible, sTemp
		nCnt = DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" )	
		
		
		if nCnt == 0 then
			Pannel0.rowcount = 0
			'영업일이지만 미래
			lbNoticeMsg.caption = "환율정보가 없어요."
			imgNotice.left = 160
			lbNoticeMsg.left = 87 				
			imgNotice.visible = true
			lbNoticeMsg.visible = true 					
			Exit Sub
		end if
		
'i = 0 ' for TEST	
		szVisible = true
		'Pannel0.rowcount = nCnt
		'Pannel0.rowcount = 9
		
		nIdx = 0
		i = -1 
		for j = 0 to nCnt - 1 step 1		
			szCRCD = DATAMANAGER.GetDataValue(0, "obtsd_fbnk_225r", "OutBlock1", "CRCD", j)			
			Select Case szCRCD 'for TEST
				Case "USD"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 1) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0)  
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "미국 " & szCRCD
				Case "JPY"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 1)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0)   
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "일본 " & szCRCD					
				Case "CNY"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 1)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0) 
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "중국 " & szCRCD	
				Case "HKD"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 1) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0) 
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "홍콩 " & szCRCD					
				Case "EUR"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 1)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0) 
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "유로화 " & szCRCD					
				Case "CHF"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 1)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0)
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "스위스 " & szCRCD					
				Case "AUD"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 1)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0) 	
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "호주 " & szCRCD
				Case "CAD"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 1)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0) 	 
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "캐나다 " & szCRCD					
				Case "SGD"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 1) 
					Pannel0.SetCellVisible("imgFlagVND", i, 0)  					
					sTemp =  "싱가포르 " & szCRCD					
				Case "VND"
					nIdx = Pannel0.AddRow()
					szVisible = true
					i = i + 1
					Pannel0.SetCellVisible("imgFlagUSD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagJPY", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagHKD", i, 0) 					
					Pannel0.SetCellVisible("imgFlagEUR", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCHF", i, 0)  					
					Pannel0.SetCellVisible("imgFlagAUD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagCAD", i, 0)  
					Pannel0.SetCellVisible("imgFlagSGD", i, 0)  					
					Pannel0.SetCellVisible("imgFlagVND", i, 1)  					
					sTemp =  "베트남 " & szCRCD						
					
				Case Else
					szVisible = false
			End Select
			
			if szVisible == true then
				'sTemp = szCRCD .. " " .. DATAMANAGER.GetDataValue(0, "obtsd_fbnk_225r", "OutBlock1", "CRCD_KOR_NAME", j)					
				Pannel0.SetCellValue( "lblName", nIdx, sTemp)
				Pannel0.SetCellValue( "lblData1", nIdx, DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "STND_EXRT" , j )) '실시간환율
				Pannel0.SetCellValue( "lblData2", nIdx, DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "DEAL_STND_EXRT" , j )) '고시환율
'				Pannel0.SetCellValue( "lblData3", i, DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "TLTR_BYRT" , j )) '전신환매입율 '살 때 환율
'				Pannel0.SetCellValue( "lblData4", i, DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "TLTR_SLRT" , j )) '전신환매도율 '팔 때 환율
				Pannel0.SetCellValue( "lblData3", nIdx, DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "TLTR_APLY_BYRT" , j )) '전신환매입율 '살 때 환율
				Pannel0.SetCellValue( "lblData4", nIdx, DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "TLTR_APLY_SLRT" , j )) '전신환매도율 '팔 때 환율
			end if 
		next	
		
		'Pannel0.height = Pannel0.height +10
		Pannel0.addfooter = "nrsbonl83000_p0.xmf"		
'Pannel0.rowcount = 0 'for TEST
		SetNoticeMsg()
		
		ImgRefresh.visible = true

	elseif szTranID == "obcpp_bsdy_006r" then
		Dim sMangDate
		sMangDate = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MANG_DATE" , 0 )
	
		if Calendar0.caption == sMangDate then '선택일이 영업일 맞음
			DATAMANAGER.RequestTranData("obtsd_fbnk_225r")
		else
			' 비영업일
			Pannel0.rowcount = 0
			lbNoticeMsg.caption = "환율정보가 없어요."
			imgNotice.left = 160
			lbNoticeMsg.left = 87 				
			imgNotice.visible = true
			lbNoticeMsg.visible = true 	
			
			ImgRefresh.visible = true
		end if		
    end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID =	"obtsd_fbnk_225r"	then
		msgbox "!"
		if szErrCode == "1093" then '당일자 환율 미고시 
		     '영업일오전
			lbNoticeMsg.caption = "환율정보가 없어요.\n 9시 이후 조회돼요."
			imgNotice.left = 160
			lbNoticeMsg.left = 87 				
			imgNotice.visible = true
			lbNoticeMsg.visible = true 
		end if 
	end if 
	ImgRefresh.visible = true
End Sub


'============================================================================
Sub Calendar0_OnEditComplete()
	'ImgRefresh_OnClick()	
	ExeQuery()
End Sub

'============================================================================
Sub ImgRefresh_OnClick()
	ImgRefresh.visible = false
	ExeQuery()
End Sub

Function ExeQuery()
	lblTime.caption = ""
	calTempDate.caption = Calendar0.caption
	calTempDate.addday = -1
'	DATAMANAGER.RequestTranData("obcpp_bsdy_006r") 영업일/비영업일	
	DATAMANAGER.RequestTranData("obtsd_fbnk_225r")	
End Function

'============================================================================
Sub lblRefresh_OnClick()
	ImgRefresh_OnClick()
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	Form.OpenPopup("nrsbbnk65100_p2.xmf", Pannel0.GetCellValue("lblName",nIndex).."★"..Calendar0.caption , "")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 1 then
		'ImgRefresh_OnClick()
		ExeQuery()
	end if 
End Sub


