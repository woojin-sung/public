'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' imgClose_OnClick
'============================================================================



'============================================================================
' btnCancel_OnClick - 취소
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub



'============================================================================
' btnEnroll_OnClick - 등록
'============================================================================
Sub btnEnroll_OnClick()
	'v0003 sta
	If g_szSapeYN == "Y" Then
		Form.SendReturnToParent("mbbnk61010_p0" , "ok")
		Form.CloseForm( )
	Else
		if g_szCertUserType == "1" then
			' 간편인증 보안매체 추가
			'==================
			Form.triggerEvent("LinkForm0", "이체확인" , "")
			'==================
			'Form.OpenPopup("mhetc90060_px", "", "")
		else
			Form.triggerEvent("LinkForm0", "이체확인" , "")
		end if
	End If
	'v0003 fin
End Sub



'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			TR_Inquiry("obcsb_oimf_625r")
		else
			Form.CloseForm( )
			exit sub
		end if
	end if
	
	' 간편인증 보안매체 추가
	'==================
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			Form.OpenPopup("mhetc90060_px", "", "")	
		else 					'실패
			exit sub
		end if	
	end if	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			Form.OpenPopup("mhetc90060_px", "", "")
		else						'실패		
			exit sub
		end if	
	end if
	'==================
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Form.SendReturnToParent( "mbbnk61010_p0" , "ok" )
			Form.CloseForm( )
		else						'실패
			exit sub
		end if
	end if
	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			Form.SendReturnToParent( "mbbnk61010_p0" , "ok" )
			Form.CloseForm( )
		ElseIf sRet == "cancel" Then
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	if sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then
			'Form.SendReturnToParent("mbbnk61100_p4" , "Error")
			Form.CloseForm( )		
		'end if
	end If	
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	Dim szData, szList
	Dim szTotalAmt
	
	szData = Form.GetOpenLinkData()
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	g_sOtpTrMsg = ""
	g_sBioTrMsg = ""
	
	szListTemp = Split(szData, "★") 
	if UBOUND(szListTemp) < 1 THEN
		EXIT SUB
	END IF
	
	
	szList = Split(szListTemp[0], "♥") 
	
	if UBOUND(szList) < 1 THEN
		EXIT SUB
	END IF

'	Form.ShowAlert("szData", szData)
	g_szAccountNumber = szList(3)
	g_szAccountPassword = szList(4)	'입금은행
		
	
	g_szPlusSec = szList(5)''추가인증


	g_szCnt = szList(0)
	g_szMoney	= szList(1)'이체금액
    g_szFee = szList(2)	''수수료
	if g_szFee == "" or g_szFee == null then
		g_szFee = "0"
	end if
	
	'확인정보로 등록
	'추가인증-> 보안매체-> 공인인증 순으로 처리 후 완료되었다는 메세지 띄우고 종료
'			Form.SendReturnToParent( "mbbnk61010_p0" , "OK" )
'			Form.CloseForm( )
    Dim szData
    szData = ""
	szTotalAmt = 0
	
	g_szMultiData = szListTemp(1)

	mData = Split (g_szMultiData, "@") ''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd 'receiverN
	
	if #mData == CInt(g_szCnt) then
	   for i=0 to g_szCnt-1
	       tData = Split (mData(i), "♥")
	       if #tData  > 0 then
		       szData0 = tData(1) '은행명
		       
		       szData1 = tData(7)'은행코드
		       szData2 = tData(9)'수취인명
		       szData3 = tData(3)'이체금액
		       
		       grd0.AddRow()
		       grd0.SetCellData( "bd_cell0", i, tData(1) )
		       grd0.SetCellData( "bd_cell1", i, tData(2) )
		       grd0.SetCellData( "bd_cell2", i, tData(9) )
		       grd0.SetCellData( "bd_cell3", i, tData(3) )
		       
		       if i == 0 then
			       szData =  szData0 &"★"& szData1 &"★"& szData2 &"★"& szData3
		       
			   else
				   szData =  szData & "★"&  szData0 &"★"& szData1 &"★"& szData2 &"★"& szData3
			   end if
			   
			   g_sOtpTrMsg = g_sOtpTrMsg & tData(1) & "#" & tData(2) & "#" & tData(9) & "#" & FormatNumber(CDbl(tData(3)), 0, 0, 0, -1) & "원#"
			   Form.SetSharedData("OTP_TR_MSG_1" , g_sOtpTrMsg)
			   
			   if g_szCertUserType == "3" OR g_szCertUserType == "4" then	'bio 인증 4-공동인증
				   if i == 0 then
				       g_sBioTrMsg = "이체예정내역\n" & "입금기관 : " & tData(1) & "\n" & "입금계좌 : " & tData(2) & "\n" & "예금주명 : " & tData(9) & "\n" & "이체금액 : " & FormatNumber(CDbl(tData(3)), 0, 0, 0, -1)  & " 원\n" 
				   end if
			   End if
			   szTotalAmt = szTotalAmt + CDbl(tData(3))
		    end if   
	   next 
	   
	   
	   if CInt(g_szCnt) > 1 then
		   g_sBioTrMsg = g_sBioTrMsg & "외 " & g_szCnt -1 & " 건\n"
		   g_sBioTrMsg = g_sBioTrMsg & "총금액 : " & FormatNumber(szTotalAmt, 0, 0, 0, -1) & " 원\n"
	   end if
	   
	   if g_szCertUserType == "3" OR g_szCertUserType == "4" then
		   Form.SetSharedData("BIO_TR_MSG_1" , g_sBioTrMsg)
	   end if
		   
	end if
	
	g_sSpinCertYn = "N"
	
	'v0003 sta : 동일인 여부에 따른 분기처리 : 동일인일경우 전자서명, 보안매체 생략 후 출금처리
	g_szSapeYN = ""
	g_szSapeYN = Form.GetSharedData("61010_SAPE_YN" , TRUE)

	If g_szSapeYN == "Y" Then
		lblSapeY1.visible = True
		lblSapeY2.visible = True
		LinkForm0.visible = False
	Else
		lblSapeY1.visible = False
		lblSapeY2.visible = False
		LinkForm0.visible = True
		
		if g_szCertUserType == "1" OR g_szCertUserType == "3" then
			' 간편인증 보안매체 추가
			'==================
			TR_Inquiry("obcsb_oimf_625r")
			'==================
			'LinkForm0.linkfile = "mbbnk61010_s4"
		elseif g_szPlusSec == "Y" then
		sData = Form.GetSharedData("&USER_ID", false )
		    Form.SetSharedData("CERT_ID" , sData)
		    Form.SetSharedData("CERT_ACNO" , Left(g_szAccountNumber, 8))
		    Form.SetSharedData("BANK_TRANSTYPE" , "02")		
		    Form.OpenFramePopup("mhetc90060_p8" , "bank_61010★" & g_szCnt &"★"& szData , "")
		else 	
			TR_Inquiry("obcsb_oimf_625r")
		end if	
	End If
	'v0003 fin
	
	Form.SetScreenName( "이체예정내역 확인" )
	for i=0 to 6
		Table0.SetCellString( i, 1, "" )	'테이블 clear
	next
	'Form.GetSharedData( "#HOST_DATE", 0 )
	Table0.SetCellString( 0, 1, g_szCnt)	'요청건수
	Table0.SetCellString( 1, 1, g_szMoney)	'출금액
	Table0.SetCellString( 2, 1, g_szFee)	'수수료
	sTotal = CDbl(g_szMoney) + CDbl(g_szFee)
	Table0.SetCellString( 3, 1, sTotal)	'총출금액

	tbl0.SetCellString( 0, 1, g_szCnt )	'요청건수
	tbl0.SetCellString( 0, 2, g_szMoney)	'출금액
	tbl0.SetCellString( 0, 4, g_szFee)	'수수료
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		Select Case g_sGubunCode
			Case "1"
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form.SendReturnToParent("mbbnk61010_p0" , "Error")
				Form.CloseForm( )
			Case "2"	
'				Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
'				Form.SendReturnToParent("mbbnk61010_p0" , "Error")
'				Form.CloseForm( )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				Form.SendReturnToParent("mbbnk61010_p0" , "Error")
				Form.CloseForm( )
		End Select
		
		'보안매체제외인경우
		IF Form.GetSharedData("61010_SMDIA_SKIP" , TRUE)	 = "Y" THEN
			'간편비번 only
			IF g_szCertUserType = "1" THEN
				LinkForm0.linkfile = "mbbnk61010_s7"
				Exit Sub
			ELSEIF g_szCertUserType = "3" THEN		'바이오 only
				LinkForm0.linkfile = "mbbnk61010_sb"
				Exit Sub
			END IF 			
		END IF
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		
		if g_szCertUserType <> "1" AND g_szCertUserType <> "3"  AND g_szCertUserType <> "4" THEN
			Select Case g_sGubunCode
				Case "0"
					'Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)
					LinkForm0.linkfile = "mbbnk61010_s1"                 '공인인증서_보안카드화면
				Case "3"
					'Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
					LinkForm0.linkfile = "mbbnk61010_s2"
				Case "4" 'v0002
					LinkForm0.linkfile = "mbbnk61010_suo" '공인인증서_mOTP	v0002			     
			End Select
		END IF
		
		' 간편인증 보안매체 추가
		'==================
		if g_szCertUserType == "1" then
			'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
			Select Case g_sGubunCode
				Case "0"
					LinkForm0.linkfile = "mbbnk61010_s5" ' 간편인증_보안카드
				Case "3"
					LinkForm0.linkfile = "mbbnk61010_s6" ' 간편인증_OTP
				Case "4" 'v0002
					LinkForm0.linkfile = "mbbnk61010_sso" ' 간편인증_mOTP v0002
			End Select
			'LinkForm0.linkfile = "mbbnk61010_s4"
		end if
		
		if g_szCertUserType == "3" OR g_szCertUserType == "4" then
			' 간편인증 보안매체 추가
			'==================
			'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
			Select Case g_sGubunCode
				Case "0"
					LinkForm0.linkfile = "mbbnk61010_s8" ' 바이오인증_보안카드
				Case "3"
					LinkForm0.linkfile = "mbbnk61010_s9" ' 바이오인증_OTP
				Case "4" 'v0002
					LinkForm0.linkfile = "mbbnk61010_sbo" ' 바이오인증_mOTP 'v0002
			End Select
			'==================
		end if
		'==================
	end if

End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "인증서" then  'v0001 mbbnk61010_s1~9,sa,sb 공인인증서->인증서 변경
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	elseif sEventName == "보안카드" then
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	elseif sEventName == "간편인증" then
		if sParam == "Success" then
			btnEnroll_OnClick()
		end if
	elseif sEventName == "바이오인증" OR sEventName == "공동인증" then
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	elseif sEventName == "간편인증OTP" then
		if sParam == "Success" then
			Form.SendReturnToParent("mbbnk61010_p0" , "ok")
			Form.CloseForm( )
		else
			Form.SendReturnToParent("mbbnk61010_p0" , "Error")
			Form.CloseForm( )
		end if
	ElseIf sEventName == "mOTP_GenReq" Then 'v0002
	    Form.requestMOTP("MOTP_REQ_OTP_ENC", sParam , "61010p0") 'v0002
'	elseif sEventName == "reqAuthPinPad" then
'		Dim sRet, sErrorCode, sErrorMsg, sPassFailCnt
'		sRet = Split(sParam, "★")
'		
'		if #sRet > 1 then
'			sErrorCode = sRet[0]
'			sErrorMsg = sRet[1]
'			sPassFailCnt = sRet[2]
'		end if
'		
'		if sErrorCode == "0000" then '성공
'			Form.SendReturnToParent( "mbbnk61010_p0" , "ok" )
'			Form.CloseForm( )
'		elseif sErrorCode == "2005" then
'			Form.ShowAlert("알림", "간편인증 비밀번호 " & sPassFailCnt & "회 오류입니다.")
'		else
'			Form.ShowAlert("알림", "간편인증 실패.(" & sErrorMsg & ")")
'		end if
'	elseif sEventName == "reqPush" then
'		Dim sRet, sErrorCode, sErrorMsg
'		sRet = Split(sParam, "★")
'		
'		sErrorCode = sRet[0]
'		sErrorMsg = sRet[1]	
'		
'		if sErrorCode == "0000" then '성공
'			'Form.triggerEvent("#", "공인인증서", "Success")
'		else
'			Form.ShowAlert("알림", "간편인증 실패(" & sErrorMsg & ")")
'		end if
	end if   
End Sub

'============================================================================
Sub Form_OnRefresh()
	
