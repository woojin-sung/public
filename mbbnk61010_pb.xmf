'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체예정내역확인(복수)
' 02. 화면설명 : 정기이체등록_확인 팝업
' 03. 작    성 : 16.03.09
' 2020.11.27 : 정민영 : v0001 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
' 2021.02.24 : 장원혁 : v0002 : 모바일 OTP 적용
' 2021.11.04 : 김수진 : v0003 : 동일인 계좌간 대체출금시 전자서명, 보안매체 생략, 간편이체한도 미적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAccountNumber
Dim  g_szAccountPassword
Dim	g_szBankName	'입금은행
Dim	g_szAcc 	'입금계좌번호
Dim	g_szCnFtName 	'받는분
Dim	g_szMoney	'이체금액
Dim	g_szFee 	''수수료
Dim	g_szPlusSec 	''추가인증
Dim g_szMultiData  '다건이체정보
Dim g_szCnt
Dim g_szCertUserType
Dim g_sGubunCode
Dim g_sSpinCertYn
Dim g_sOtpTrMsg		'OTP 거래연동 DATA
Dim g_sBioTrMsg

Dim g_szSapeYN 	'v0003 입금계좌 동일인 여부
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_625r" THEN		'보안매체확인
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szAccountNumber
		sACNO_PWD = g_szAccountPassword
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	end if

End Function

