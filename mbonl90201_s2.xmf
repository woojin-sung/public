Sub Form_OnFormInit()
	Dim szValue, iYear
	Dim szList
	
	g_szLinkData = Form.GetOpenLinkData()
'	Form.ShowAlert("FormInit", g_szLinkData)
	
	'test용 data
'	g_szLinkData = "05|1|AA|01|회사채|" &
'				 "삼천리|4.02|3.84|295|1234|" &
'				 "TTTT|4.5|9245|20230101|20240101|"&
'				 "01|01| | | |" &
'				 " |N|N"
	
	szList = Split(g_szLinkData, "|")
	
	if UBound(szList) <= 0 then
		Exit Sub
	end if
	
	g_szBuyPrice = ""
	g_szSellPrice = ""
	
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	g_szToday = Form.GetSharedData("&HOST_DATE", false)
	g_szFnprJoinSrno = Form.GetSharedData("FNPR_JOIN_SRNO", False)	
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	
	g_szScrno = 90201
	
	g_szSymbolData = {}
	g_szAccountData = {}
	
	table.insert(g_szSymbolData, szList(0))   	'KYC상품등급코드
	table.insert(g_szSymbolData, szList(1))   	'순서번호
	table.insert(g_szSymbolData, szList(2))   	'신용등급코드
	table.insert(g_szSymbolData, szList(3))   	'채권분류코드
	table.insert(g_szSymbolData, szList(4))   	'채권분류명		
	table.insert(g_szSymbolData, szList(5))   	'종목명		
	table.insert(g_szSymbolData, szList(6))   	'매수수익률
	table.insert(g_szSymbolData, szList(7))   	'은행예금환산수익률
	table.insert(g_szSymbolData, szList(8))   	'잔존일수		
	table.insert(g_szSymbolData, szList(9))   	'매매가능수량
	table.insert(g_szSymbolData, szList(10))   	'종목코드
	table.insert(g_szSymbolData, szList(11))   	'표면이자율
	table.insert(g_szSymbolData, szList(12))   	'매매단가
	table.insert(g_szSymbolData, szList(13))   	'발행일자
	table.insert(g_szSymbolData, szList(14))   	'만기일자
	table.insert(g_szSymbolData, szList(15))   	'이자지급방법코드명
	table.insert(g_szSymbolData, szList(16))   	'펀드코드			
	table.insert(g_szSymbolData, szList(17))   	'투자가능금액			
	table.insert(g_szSymbolData, szList(18))   	'투자설명서 첨부파일경로명
	table.insert(g_szSymbolData, szList(19))   	'신용평가서 첨부파일경로명
	
	g_szAccount = szList(20)
	g_szAccountSeq = szList(21)
	g_UI_PFIN_YN = szList(23)
	
'	table.insert(g_szAccountData, szList(20))   	'계좌번호
'	table.insert(g_szAccountData, szList(21))   	'계좌seq
'	table.insert(g_szAccountData, szList(22))   	'계좌비번
'	table.insert(g_szAccountData, szList(23))   	'전문투자자여부
'	table.insert(g_szAccountData, szList(24))   	'전문투자자 만료여부
	
'	Form.ShowAlert("FormInit2", contMain.cont1.cmbAccount.caption)
'	Form.ShowAlert("FormInit3", g_szAccount .. g_szAccountSeq)
'	Form.ShowAlert("FormInit4", contMain.cont1.cmbAccount.total)
	f_setCtrlData()
	
'	Form.ShowAlert("FormInit5", contMain.cont1.cmbAccount.caption)
	
	'계좌 체크
	if contMain.cont1.cmbAccount.caption <> "" and 
	   contMain.cont1.cmbAccount.caption <> null then 
'		Form.ShowAlert("FormInit5", contMain.cont1.cmbAccount.caption)
