Sub contMain_cont2_BtnPrcin_OnClick()
	Dim szPrc, szData

	szPrc = "0|" & contMain.cont2.rdoInput.currentindex
		
	contMain.cont2.BtnPrcin.caption = ""
	contMain.cont2.LblPrcin.caption = ""
	contMain.cont2.edtInput.caption = ""
	
	Dim szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	if szOSType == "1" then
		contMain.scroll_pos = 190
	else
		contMain.scroll_pos_noAni = 190
	end if
	
	'20240320 금액 재입력시 하단 매수버튼 캡션 초기화
	lblBuy.caption = "매수하기"
	
	Form.SetSharedData("OPEN_FILE_NAME", "mbonl90201_p2" )
	Form.openPopup("mbonl90201_p9", szPrc, "")	'mhtro16090_p1
End Sub

'============================================================================
Sub contMain_cont2_LblPrcin_OnClick()
	Dim szQty, szAmt, szValue
	
	contMain.cont2.ImgPrcreset.visible = true
	if Trim(g_szPopPrc) <> "" then
		szPrc = CLng(g_szPopPrc)
	else
		szPrc = CLng(contMain.cont2.lblPrcin.caption)
	end if
	
'	Form.ShowAlert("LblPrcin_OnClick", szPrc)
	
	contMain.cont2.LblAlert.caption = ""
	if szPrc == 0 then
		contMain.cont2.LblPrcin.caption = ""
		
		if CInt(contMain.cont2.rdoInput.currentindex) == 0 then
			contMain.cont2.BtnPrcin.caption = "금액을 입력해주세요"
		else
			contMain.cont2.BtnPrcin.caption = "수량을 입력해주세요"
		end if
		
	else
		contMain.cont2.LblPrcin.caption = szPrc
		contMain.cont2.edtInput.caption = szPrc
	end if
	
'	Dim szQty, szAmt, szValue
	
	if f_checkInput() then
'		Form.ShowAlert("OnEditComplete", f_checkInput())
		
'		g_dSymbolPrice = 9938.2  'test용 매매단가
		
		if CInt(contMain.cont2.rdoInput.currentindex) == 0 then
'			'1. 매수수량 = 입력금액 / 매매단가 * 10
'			szQty = Round( CInt(contMain.cont2.edtInput.caption) / CDbl(g_dSymbolPrice), 0) * 10
'			'2. 매수결제금액 = 매수수량 * 매매단가 / 10
'			szAmt = CInt(szQty) * CDbl(g_dSymbolPrice) / 10
'			'3. 예상매수수량 = 매수결제금액 / 매매단가 * 10 * 1000
'			szQty = CInt(szAmt) / CDbl(g_dSymbolPrice) * 10 * 1000
						
			'예상매수수량 = TRUNC(입력금액 * 10000 / 매매단가 / 1000) * 1000
			szQty = CInt( CInt(szPrc) * 10000 / CDbl(g_dSymbolPrice) / 1000 ) * 1000
			
'			Form.ShowAlert("edtInput_OnEditComplete", szQty .. " : " ..  g_dSymbolPrice)
			'매수결제금액 = TRUNC(예상매수수량 * 매매단가 / 10000)
			szAmt = CInt( szQty * CDbl(g_dSymbolPrice) / 10000 )
			
			if CInt(szAmt) <= 0 then
				contMain.cont2.lblAlert.caption = "최소금액을 입력해주세요."
				
				contMain.cont2.tblInfo.SetCellString(1, 3, "0")		'매수단가
				contMain.cont2.tblInfo.SetCellString(2, 3, "0")		'예상매수수량
				contMain.cont2.tblInfo.SetCellString(3, 3, "0")		'매수결제금액
			else				
				contMain.cont2.tblInfo.SetCellString(1, 3, g_dSymbolPrice)		'매수단가
				contMain.cont2.tblInfo.SetCellString(2, 3, szQty)		'예상매수수량
				contMain.cont2.tblInfo.SetCellString(3, 3, szAmt)		'매수결제금액
			end if
			
		else
'			'1. 입력 수량 백원 단위 절사
'			szQty = CInt(CInt(contMain.cont2.edtInput.caption) / 1000) * 1000
'			'2. 매수결제금액 = 입력금액 / 1000 * 매매단가 / 10
'			szAmt = CInt(szQty) / 1000 * CDbl(g_dSymbolPrice) / 10
			
			'예상매수수량 = TRUNC((입력금액 / 1000) * 1000
			szQty = CInt( CInt(szPrc) / 1000 ) * 1000
			'매수결제금액 = TRUNC(예상매수수량 * 매매단가 / 10000)
			szAmt = CInt( szQty * CDbl(g_dSymbolPrice) / 10000 )
			
			if CInt(szAmt) <= 0 then
				contMain.cont2.lblAlert.caption = "최소수량을 입력해주세요."
				
				contMain.cont2.tblInfo.SetCellString(1, 3, "0")		'매수단가
				contMain.cont2.tblInfo.SetCellString(2, 3, "0")		'예상매수수량
				contMain.cont2.tblInfo.SetCellString(3, 3, "0")		'매수결제금액
			else	
				contMain.cont2.tblInfo.SetCellString(1, 3, g_dSymbolPrice)		'매수단가
				contMain.cont2.tblInfo.SetCellString(2, 3, szQty)		'예상매수수량
				contMain.cont2.tblInfo.SetCellString(3, 3, szAmt)		'매수결제금액
			end if
			
		end if
		
'		Form.ShowAlert("edtInput_OnEditComplet", szAmt)
		if CInt(szAmt) > 0 then
			lblBuy.caption = FormatNumber(CInt(szAmt), 0) & "원 매수 신청"
			
			'20240320 금액 입력 완료시 스크롤 최하단으로 이동
			nTop = Form.calcUnResize(contMain.cont1.top, "2")
			nTop = nTop + 52
			if  Form.GetSharedData("&OS_TYPE", false ) == "1" then
				contMain.scroll_pos = "bottom"
			else
				contMain.scroll_pos = nTop
			end if
		end if
'		DATAMANAGER.RequestTranData( "obsab_deal_106r" )
	end if
	
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
'		Form.ShowAlert("PopupReturn_" & sKeyName, sRet)
		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				contMain.cont1.edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				contMain.cont1.edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contMain.cont1.edtPassword.pwdlen = tData(1)
				contMain.cont1.edtPassword.caption = tData(0)
				
				DATAMANAGER.RequestTranData("obcsb_acad_122a")
			end if
			
		end if
		
	'===============================================
	'********** 약관 동의 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbonl88060_p4" Then		
'		if sRet == "ok" then
'			Dim sSendData
'			sSendData = contMain.cont1.cmbAccount.total & contMain.cont1.cmbAccount.sequence & "☆" & "0"
'			
'			'비밀번호 팝업 띄움..	
'			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
'		end if
		
	'===============================================
	'********** 고객정보 변경 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName = "mbonl81000" Then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if
		
	'===============================================
	' 가격입력창에서 리턴
	'===============================================
	elseif sKeyName == "PRC_POPUP" then
'		Form.ShowAlert("PopupReturn_" & sKeyName, sRet)
		
'		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
		if sRet <> "" and sRet <> null then
			contMain.cont2.ImgPrcreset.visible = true
			g_szPopPrc = sRet
			
			contMain.cont2.lblAlert.visible = True
			
			call contMain_cont2_LblPrcin_OnClick()
		else
			contMain.cont2.ImgPrcreset.visible = false
			contMain.cont2.lblAlert.caption = ""	'' 
			contMain.cont2.BtnPrcin.caption = "금액을 입력해주세요"
			
			contMain.cont2.lblAlert.visible = 0			
		end if
		
	'===============================================
	'투자자금 원금보존 확인 
	'===============================================
	elseif sKeyName == "mbonl88060_p3_agree" then		

		if sRet == "Y" then
			'상품가입 불가
			
			'KEK STA. 원금보존 무조건 받고 700r 조회 했을때 메시지 팝업띄어줌.
			'Form.MsgBox("원금보존 위험상품 안내" , "고객님은 금융투자자금 원금보존을 선택하였습니다. 해당 상품은 위험등급 4등급 이상으로 투자자보호를 위해 단기사채 가입이 제한됩니다.", "ME_CLOSE", "6")
			g_sAgree = "Y"
			DATAMANAGER.RequestTranData( "obcsb_acif_792a" )
			'KEK FIN.
			
		else
			g_sAgree = "N"
			DATAMANAGER.RequestTranData( "obcsb_acif_792a" )
		end if
'						
	'===============================================
	'********** 투자권유 희망여부 확인서 리턴      ***********
	'===============================================		
'	ElseIf sKeyName == "MBBDM85147"  Then
'		if sRet = "ok" then
'			'투자성향등록여부, 투자성향만기여부
'			DATAMANAGER.RequestTranData( "obcsb_acif_700r_1" )
'		end if
	
	ElseIf sKeyName == "mbonl81010_p23"  Then
		if sRet = "OK" then
			g_MesuGO = "OK"			
			'투자성향등록여부, 투자성향만기여부
			DATAMANAGER.RequestTranData( "obcsb_acif_700r" )
'			btnReg_OnClick()
		end if
		
	'===============================================
	'********** 투자성향대비 고위험거래 확인서 리턴      ***********
	'===============================================		
	elseif	sKeyName = "mbonl81010_p2"		then						'고위험거래확인팝업
		if	sRet	=	"CANCEL"	then		'취소버튼
			'v003
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
			
		elseif sRet	=	"OK"	then		'확인버튼
			Form.OpenPopup("mbonl81010_p24" , g_szScrno	& "★" & 
										  contMain.cont1.cmbAccount.caption & "★" & 
										  contMain.cont1.cmbAccount.sequence & "★" &
										  "01"		& "★" & 
										  "13005"	& "★" & 
										  g_szSymbolCode 	& "★" &
										  g_KYC_INVT_INCL_GRAD_CODE	& "★" & 
										  g_KYC_PROD_GRAD_CODE 	& "★" &
										  g_KYC_DVPD_EPMD_CODE		& "★" & 
										  g_KYC_DRVT_PROS_YN		& "★" & 
										  g_DVPD_GRAD_CODE
					     	, sPosInfo)
		end if
	
	'===============================================
	'********** 고위험거래가입팝업      ***********
	'===============================================		
	elseif	sKeyName = "mbonl81010_p24"	then		
		if	sRet	=	"CANCEL"	then		'취소버튼
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
			
'		elseif sRet	=	"OK"	then		'확인버튼
'			DATAMANAGER.RequestTranData("obsab_deal_608a")
			
		end if
			
	'===============================================
	'********** 투자주요내욕 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbonl88060_p13"  Then 	
		if sRet = "ok" then
			Dim sSendData
			sSendData = contMain.cont1.cmbAccount.total & contMain.cont1.cmbAccount.sequence & "☆" & "0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
		
	'===============================================
	'********** 신청 등록완료 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbonl90201_p5"  Then 	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			g_szRet = sRet
			Form.CloseForm()
		end if
	End if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "obpds_srvc_433a_2" then
		if sRet == "close" then
			'진입화면으로 이동
			Form.OpenScreen("88026" , "")
			Form.CloseForm()
			Exit Sub
		end if

	elseif sKeyName == "ME_CLOSE" then
		if sRet == "close" then
		
		    'KEK STA. 원금보존 무조건 받고 700r 조회 했을때 메시지 팝업띄어줌.
		    'g_sAgree = "Y"
		    'DATAMANAGER.RequestTranData( "obcsb_acif_792a" )		
			Form.CloseForm()
		    'KEK FIN.
			
			Exit Sub
		end if
	
	elseif sKeyName = "RELOAD" then	
		'잔여수량 재조회
		g_Reload = "ok"
		DATAMANAGER.RequestTranData( "obsac_deal_211r" )
		
	elseif sKeyName = "RELOAD_1" then	
		'매수가능금액 재조회
		g_Reload_1 = "ok"
		DATAMANAGER.RequestTranData( "obsap_deal_003r" )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szTranID == "obsab_deal_608a" then
		if szErrCode == "0340" then
			Form.ShowAlert( "알림" , szSubErr)
			
			Exit Sub
		
		elseif szErrCode == "6706" then
			'v001
			'Form.ShowAlert( "알림" , "채권 이자 지급 3일전에는\n거래가 정지되요.")
			Exit Sub
			
		else
			if szSubErr <> null and Trim(szSubErr) <> "" then
				Form.ShowAlert( "알림" , szTranID .. "\n"..szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
			else
				Form.ShowAlert( "알림" , szTranID .. "\n"..szErrCode .. " : ".. szErrMsg)
			end if
		
		end if
	
	else
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , szTranID .. "\n"..szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , szTranID .. "\n"..szErrCode .. " : ".. szErrMsg)
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'고객번호
	dim szCust_Num, szValue, iQty, iAmt
	
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = contMain.cont1.edtPassword.caption
	Else
		szPwd = contMain.cont1.edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = contMain.cont1.edtPassword.caption
	    end if
	End If
	
	'폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , contMain.cont1.cmbAccount.total)	
	
	elseif szTranID == "obsab_deal_129r" or szTranID == "obsab_deal_129r_1" then
		'채권 단가 조회
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ISCD" , 0 , g_szSymbolCode)
		
		if szTranID == "obsab_deal_129r" then
			'매수일 및 매수수익률 입력
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1","CALC_STND_DATE",	0, g_szToday)		'매수일
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1","APLY_ERT",		0, g_szBuyRate)	'매수수익률
		elseif szTranID == "obsab_deal_129r_1" then
			'매도일 및 매도수익률 입력
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1","CALC_STND_DATE",	0, g_szSymbolData(14))	'매도일
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1","APLY_ERT",		0, 0)				'매도수익률
		end if
		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock3", "DCPN_LOEQ_FGRS_CNT" , 0 , "1")
	
	elseif szTranID == "obcsb_acif_792a" then 
		'고객 투자자금 원금 보존여부 확인
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, contMain.cont1.cmbAccount.total )	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, contMain.cont1.cmbAccount.sequence )	'계좌일련번호		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PRNC_PRSV_YN" 		, 0, g_sAgree)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MOD_REAS_RMRK"		, 0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_SRNO"		, 0, g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO"	, 0, "00001")
	
	elseif szTranID == "obcsb_acif_700r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , contMain.cont1.cmbAccount.total )		'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , contMain.cont1.cmbAccount.sequence )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"	, 0 , "01")			'KYC 업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE"		, 0 , "13005")		'업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0 , g_szSymbolCode )	'종목코드
		
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then			
		dim strCustTelno, strAddr, strInagTypeCode, strInagSrno

		if g_szNotiFlag == "talk" then
			strCustTelno = contMain.cont3.tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = contMain.cont3.tblUserInfo.GetCellString(0, 2)
			strInagSrno = contMain.cont3.tblUserInfo.GetCellString(0, 3)

			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
			
		elseif g_szNotiFlag == "email" then
			strAddr = contMain.cont3.tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = contMain.cont3.tblUserInfo.GetCellString(1, 2)
			strInagSrno = contMain.cont3.tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ADDR"          , 0 , strAddr)
		End If 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
			
	elseif szTranID == "obsab_deal_608a" then
		'장외채권 매수 처리
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",				0, contMain.cont1.cmbAccount.total)		'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, contMain.cont1.cmbAccount.sequence)   '계좌일련번호
		
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",		0, contMain.cont1.edtPassword.caption)        '계좌비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",		0, Form.GetCtlProp("contMain.cont1.edtPassword", "encdata"))
		end if
				
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE",		0, "4")        			'접촉구분코드	1:창구 2:유선 3:ODS 4:온라인 5:시스템 6:비대면창구"
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PBNT_TYPE_CODE",		0, "01")        			'공시유형코드	01:자율공시 02:입고매도공시(소액채권) 03:협의공시 04:딜러공시 05:미공시
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PBNT_SRNO",			0, "")					'공시일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, g_szSymbolCode)        	'종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNCD",				0, g_szSymbolData(16))    	'펀드코드
		
		if CInt(contMain.cont2.rdoInput.currentindex) == 0 then
			'금액 입력시
			szValue = "2"
		else
			szValue = "1"
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_CLS_CODE",		0, szValue)        		'신청구분코드  1:수량기준, 2:금액기준

		iQty = CInt(CInt(contMain.cont2.tblInfo.GetCellString(2, 3)) / 1000)
		iAmt = CInt(contMain.cont2.tblInfo.GetCellString(3, 3))
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_AMT",			0, iAmt)					'매매금액
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT",				0, iQty)					'주문수량
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OTDL_UNPR",			0, g_dSymbolPrice) 		'장외매매단가
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_ERT",			0, g_szSymbolData(6))		'매매수익률
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STDY_CLS_CODE",		0, "00")      			'결제일구분코드	"00:당일 01:익일"
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_DATE",			0, g_szToday)   			'주문일자
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STLM_DATE",			0, "")        			'결제일자
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_GRP_NO",		0, "")        			'주문그룹번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROD_PSTN_CLS_CODE",	0, "")       				'상품포지션구분코드
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SNOT_EMPNO",			0, "")       				'파출직원번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_SRNO",		0, g_szFnprJoinSrno)		'금융상품가입일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO",	0, "0001")       			'금융상품가입세부일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNFR_YN",			0, "")        			'확인여부

	'end of if szTranID == "obsab_deal_608a"
	
	elseif szTranID == "obsab_deal_603r" then
		'장외채권 상품 상세 정보
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",	0, g_szUSERID)  	  'ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",		0, contMain.cont1.cmbAccount.total)  	  '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",		0, contMain.cont1.cmbAccount.sequence)  '계좌일련번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",	0, "")  			  '비밀번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",		0, g_szSymbolCode)  '종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE",		0, "A")  '조회구분코드
	
'	elseif szTranID == "obsab_deal_106r" then
'		'장외채권 매매분석표 조회 (매수결제금액 조회를 위해서 호출)
'		Dim szInputQty, szInputAmt
'		
'		szInputQty = 0
'		szInputAmt = 0
'		if CInt(contMain.cont2.rdoInput.currentindex) == 0 then
'			'금액 선택시 예상 수량 입력
'			szInputAmt = contMain.cont2.edtInput.caption
'			szInputQty = round(CInt(contMain.cont2.edtInput.caption) / CInt(g_dSymbolPrice),0)
'		else
'			szInputQty = contMain.cont2.edtInput.caption
'			'수량 선택시 예상 금액 입력
''			szInputAmt = CInt(g_dSymbolPrice) * CInt(contMain.cont2.edtInput.caption)
'			szInputAmt = contMain.cont2.tblInfo.GetCellString(2, 3)
'			
'		end if
'		Form.ShowAlert("TranBefore", szInputQty & " : " & szInputAmt)
'		
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",				0, contMain.cont1.cmbAccount.total)		'계좌번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",				0, contMain.cont1.cmbAccount.sequence)   '계좌일련번호
''		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",			0, "")   							'계좌 비밀번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",				0, g_szSymbolCode)   					'종목코드
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BYOV_DATE",			0, g_szToday)   						'매수일자
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BYOV_ERT",			0, g_szBuyRate)    					'매수수익률
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BYOV_UNPR",			0, g_szBuyPrice)  					'매수단가
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_DATE",			0, g_szSymbolData(14))  				'매도 일자
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_ERT",			0, g_szSellRate)   			'매도 수익률
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELN_UNPR",			0, g_szSellPrice)   			'매도 단가
