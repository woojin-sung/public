'============================================================================
' 채권 정보 화면에 표시
Sub f_setCtrlData()	
'	g_szSymbolData(0) 	KYC상품등급코드
'	g_szSymbolData(1)  	순서번호
'	g_szSymbolData(2)   	신용등급코드
'	g_szSymbolData(3)   	채권분류코드
'	g_szSymbolData(4)   	채권분류명		
'	g_szSymbolData(5)   	종목명		
'	g_szSymbolData(6)   	매수수익률
'	g_szSymbolData(7)   	은행예금환산수익률
'	g_szSymbolData(8)   	잔존일수		
'	g_szSymbolData(9)   	매매가능수량
'	g_szSymbolData(10)   	종목코드
'	g_szSymbolData(11)   	표면이자율
'	g_szSymbolData(12)   	매매단가
'	g_szSymbolData(13)   	발행일자
'	g_szSymbolData(14)   	만기일자
'	g_szSymbolData(15)   	이자지급방법코드명
'	g_szSymbolData(16)   	펀드코드			
'	g_szSymbolData(17)   	투자가능금액			
'	g_szSymbolData(18)   	첨부파일경로명
'	g_szSymbolData(19)   	첨부파일경로명

'	g_szAccountData(0)   	계좌번호
'	g_szAccountData(1)   	계좌seq
'	g_szAccountData(2)   	계좌비번
'	g_szAccountData(3)   	전문투자자여부
'	g_szAccountData(4)   	전문투자자 만료여부
	
	g_szSymbolCode = g_szSymbolData(10)
	g_dSymbolPrice = g_szSymbolData(12)
	g_szBuyRate    = g_szSymbolData(6)
	
	'상품등급 badge_1
	if g_szSymbolData[0] = "01" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_372.png"
		contMain.cont0.lblBadge1.caption = "매우높은위험"	
		contMain.cont0.lblBadge1.fgcolor = 273
	elseif g_szSymbolData[0] = "02" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_373.png"
		contMain.cont0.lblBadge1.caption = "높은위험"	
		contMain.cont0.lblBadge1.fgcolor = 144
	elseif g_szSymbolData[0] = "03" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_374.png"
		contMain.cont0.lblBadge1.caption = "다소높은위험"
		contMain.cont0.lblBadge1.fgcolor = 144
	elseif g_szSymbolData[0] = "04" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_375.png"
		contMain.cont0.lblBadge1.caption = "보통위험"
		contMain.cont0.lblBadge1.fgcolor = 144
	elseif g_szSymbolData[0] = "05" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_376.png"
		contMain.cont0.lblBadge1.caption = "낮은위험"	
		contMain.cont0.lblBadge1.fgcolor = 144
	elseif g_szSymbolData[0] = "06" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_377.png"
		contMain.cont0.lblBadge1.caption = "매우낮은위험"	
		contMain.cont0.lblBadge1.fgcolor = 273
	elseif g_szSymbolData[0] = "09" then
		contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_377.png"
		contMain.cont0.lblBadge1.caption = "미지정"
		contMain.cont0.lblBadge1.fgcolor = 273
	end if				

	'badge_2 신용등급
	contMain.cont0.imgBadge2.imgpath = "img_bgsquare_grade_316.png"
	if (g_szSymbolData[2] == "" or g_szSymbolData[2] == null) and (trim(g_szSymbolData[4]) == "국채" or trim(g_szSymbolData[4]) == "지방채") then
		contMain.cont0.lblBadge2.caption = "국공채"
	else
		contMain.cont0.lblBadge2.caption = g_szSymbolData[2]
	end if
'	contMain.cont0.lblBadge2.fgcolor = 261
	
	'badge_3 채권분류
'		contMain.cont0.imgBadge3.imgpath = "img_bgsquare_grade_366.png"
	contMain.cont0.imgBadge3.imgpath = "img_bgsquare_grade_363.png"
	contMain.cont0.lblBadge3.caption = g_szSymbolData[4]
'	contMain.cont0.lblBadge3.fgcolor = 261
	
	contMain.cont0.lblSymbolName.caption = g_szSymbolData(5)
	
	'종목코드
	contMain.cont0.lblSymbolCode.caption = g_szSymbolData(10)
	
	'상품 금리 정보
	contMain.cont0.tblSymbolnfo.SetCellString(2, 0, FormatNumber(CDbl(g_szSymbolData[6]), 3))	'매수금리
	contMain.cont0.tblSymbolnfo.SetCellString(2, 1, FormatNumber(CDbl(g_szSymbolData[7]), 3))	'은행환산 수익률
	
	iYear = CInt(CInt(g_szSymbolData[8]) / 365)
	if iYear >= 1 then
		szValue = iYear & "년 " & (CInt(g_szSymbolData[8]) - (iYear * 365)) & "일"
	else
		szValue = CInt(g_szSymbolData[8]) & "일"
	end if 
	contMain.cont0.tblSymbolnfo.SetCellString(2, 2, szValue)		'잔존일수
	
	'상품 매수가능수량
	contMain.cont0.lblAmt.caption = g_szSymbolData[9]
	
'	Form.ShowAlert("f_setCtrlData1", contMain.cont1.cmbAccount.caption)
'	Form.ShowAlert("f_setCtrlData2", g_szAccount)
'	Form.ShowAlert("f_setCtrlData3", g_szAccountSeq)
	
	if contMain.cont1.cmbAccount.caption <> (g_szAccount .. g_szAccountSeq) then
		contMain.cont1.cmbAccount.caption = (g_szAccount .. g_szAccountSeq)
	end if
	
'	Form.ShowAlert("f_setCtrlData4", contMain.cont1.cmbAccount.caption)
	
	'계좌 매수가능금액
	contMain.cont1.lblAmt.caption = g_szSymbolData[17]
	
	'입력값 초기화
	Init_InputControl()
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contMain.setScrollBarVisible("2")
	end if
	
end sub

'============================================================================
'f_checkBuy() : '매수 전에 화면 전체 입력값 체크
'============================================================================
function f_checkBuy()
'	Form.ShowAlert("f_checkBuy1", contMain.cont1.cmbAccount.total)
'	Form.ShowAlert("f_checkBuy2", contMain.cont1.cmbAccount.caption)
	
	'계좌번호 존재 유무 체크
	if contMain.cont1.cmbAccount.total == "" or 
	   contMain.cont1.cmbAccount.total == null or 
	   Len(contMain.cont1.cmbAccount.total) < 8 then
		Form.MsgBox("알림", "계좌번호를 확인해주세요.", "", 0)
		return false
	end if
	
	'매수가능 수량 체크
	if CInt(contMain.cont2.tblInfo.GetCellString(2, 3)) > CInt(contMain.cont0.lblAmt.caption) then
		Form.MsgBox("알림", "매매수량이 공시정보의 잔고수량보다 큽니다.", "", 0)
		return false	
	end if
	
	'매수가능 금액 체크
	if CInt(contMain.cont2.tblInfo.GetCellString(3, 3)) > CInt(contMain.cont1.lblAmt.caption) then
		Form.MsgBox("알림", "매매금액이 매수가능금액보다 큽니다.", "", 0)
		return false	
	end if
	
	'매수금액 체크
	if Trim(contMain.cont2.edtInput.caption) == "" or 
	   Trim(contMain.cont2.edtInput.caption) == null or 
	   CDBL(contMain.cont2.edtInput.caption) == 0 then
		if CInt(contMain.cont2.rdoInput.currentindex) == 0 then
			Form.MsgBox("알림", "금액을 입력해 주세요.", "", 0)
		else
			Form.MsgBox("알림", "수량을 입력해 주세요.", "", 0)
		end if
		return false
	end if
	
	'이용동의서류 제공방식 선택 여부 체크
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		Form.MsgBox("알림", "계약서류 제공방식을 선택해 주세요.", "", 0)
		return false
	else
		dim szData
		szData = contMain.tblInfo.GetCellString( 0, 0 )
		
		if szData == "" or szData == null then
			if g_szNotiFlag == "talk" then
				Form.MsgBox("알림", "핸드폰 번호를 등록해 주세요.", "", 0)
			elseif g_szNotiFlag == "email" then
				Form.MsgBox("알림", "이메일 주소를 등록해 주세요.", "", 0)
			else
				Form.MsgBox("알림", "핸드폰 번호 혹은 이메일 주소를 확인해 주세요.", "", 0)
			end if
			return false
		end if
	end if
	
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = contMain.cont1.edtPassword.caption
	Else
		 szPwd = contMain.cont1.edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = contMain.cont1.edtPassword.caption
	    end if
	End If
	
'	Form.ShowAlert("f_checkBuy5", "")
	'적합
	return true
end function


