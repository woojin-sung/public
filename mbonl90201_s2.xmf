'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData
	Dim szList	
	
	if szTranID == "obsab_deal_129r" or szTranID == "obsab_deal_129r_1" then'수익률 입력시
		szOTDL_UNPR = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "OTDL_UNPR" , 0)		
		szOTDL_UNPR = round(szOTDL_UNPR, 1)
		
		if szTranID == "obsab_deal_129r" then
			'매수단가
			g_szBuyPrice = CDbl(szOTDL_UNPR)
		else
			'매도단가
			g_szSellRate = 0
			g_szSellPrice = CDbl(szOTDL_UNPR)
		end if
		
		if g_szSellPrice == "" then
			DATAMANAGER.RequestTranData( "obsab_deal_129r_1" )
		end if
		
	elseif szTranID == "obcsb_acif_140r" then
		'유선본인확인 정보 조회
		Dim iCnt, iCnt1
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 	
			contMain.cont3.tblUserInfo.SetCellString(0, 1, "")
			contMain.cont3.tblUserInfo.SetCellString(0, 2, "")
			contMain.cont3.tblUserInfo.SetCellString(0, 3, "")
			contMain.cont3.tblUserInfo.SetCellString(1, 1, "")
			contMain.cont3.tblUserInfo.SetCellString(1, 2, "")
			contMain.cont3.tblUserInfo.SetCellString(1, 3, "")
			
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
					contMain.cont3.tblUserInfo.SetCellString(1, 1, strAddr)
					contMain.cont3.tblUserInfo.SetCellString(1, 2, strInagTypeCode2)
					contMain.cont3.tblUserInfo.SetCellString(1, 3, strInagSrno2)
			    End If
			Next 	
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    contMain.cont3.tblUserInfo.SetCellString(0, 1, strCustTelno)
				    contMain.cont3.tblUserInfo.SetCellString(0, 2, strInagTypeCode3)
				    contMain.cont3.tblUserInfo.SetCellString(0, 3, strInagSrno3)
			    End If
			Next
			
			f_SetToggleData(g_szNotiFlag)
			
		End If 
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		DATAMANAGER.RequestTranData( "obsab_deal_608a" )
	
	elseif szTranID == "obcsb_acif_792a" then 
		g_MesuGO = "NO"
		'KEK.투자성향 공통팝업 테스트_20240111 주석처리
		'DATAMANAGER.RequestTranData("obcsb_acif_700r")		'제대로 등록되면 PROS_YN : C 가 나오지 않음.
	
	'LHR 투자성향진단 추가
	elseif szTranID == "obcsb_acif_700r" then
		g_ProsYN					=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_YN", 0)
		g_KYC_INVT_RCMD_CLS_CODE 	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0) '적정성상품여부 v011		
		g_KYC_INVT_INCL_GRAD_CODE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		g_KYC_PROD_GRAD_CODE		=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_PROD_GRAD_CODE", 0)
		g_KYC_DVPD_EPMD_CODE		=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_DVPD_EPMD_CODE", 0)
		g_KYC_DRVT_PROS_YN		=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_DRVT_PROS_YN", 0)
		g_DVPD_GRAD_CODE			=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DVPD_GRAD_CODE", 0)		
		
