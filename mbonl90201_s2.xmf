'============================================================================
Sub btnBuy_OnClick()
	Dim szMode, szUrl
	
	if f_CheckBuy() then
		szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
		if szMode == "0" then
			szUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"	'운영계 주소
			
		elseif szMode == "1" then
			szUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"	'테스트계주소
			
		end if
	
		szParam = szUrl..g_szSymbolData[18] & "|" & 
				 g_szSymbolData(4) & "|" & 
				 g_szSymbolData(0) & "|" & 
				 g_szSymbolCode
				 
		'투자설명서 | 
		'채권분류명
		'상품등급코드
		'종목코드
		
'		Form.ShowAlert("btnBuy_OnClick", szParam)
		Form.OpenPopup("mbonl90201_p13" , szParam , "")
		
	end if
End Sub

