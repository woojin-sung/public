Sub contMain_cont1_cmbAccount_ChangeAccount()
	f_InitUI()
	Init_InputControl()
	
	g_szAccount = Left(contMain.cont1.cmbAccount.caption, 8)
	g_szAccountSeq = Right(contMain.cont1.cmbAccount.caption, 2)
	
	'계좌 체크
	if contMain.cont1.cmbAccount.caption <> "" and contMain.cont1.cmbAccount.caption <> null then 
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )	'유선본인확인 정보 조회
		
		DATAMANAGER.RequestTranData( "obsab_deal_603r" )	'장외채권 상품 상세 조회 (계좌변경시 주문가능수량 조회를 위해 호출)
		
	end if
End Sub

