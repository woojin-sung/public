	<SCRIPT_INFO _len="64040" _ulen="57151" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 매수
' 02. 화면설명 : 장외채권 상품 매수 화면
' 03. 작    성 : 
'  2023.11.06  신규 작성
'  2024.06.17
'     Bond Home  	mbonl90001_s2

'2024.06.17. 박윤경 : v001. 채권 이자 지급 일자 알림 메시지 팝업 순서 변경            
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szSymbolData, g_szAccountData
Dim g_szNotiFlag
dim g_Reg_YN		'등록 가능여부 체크
g_Reg_YN = "Y"

Dim g_szRet, g_sAgree
Dim g_szSavePwd
Dim g_bUseCreditAgree
Dim g_szNotiFlag
Dim g_szUserInfoFlag
Dim gAcdnYn
Dim g_szUSERID
Dim g_szToday, g_PlainRm, g_szScrno
Dim g_szSymbolCode

Dim g_szFnprJoinSrno	'금융상품일련번호
Dim g_dSymbolPrice     '매매단가
Dim g_szBuyPrice, g_szSellPrice   '매수단가, 매도단가
Dim g_szBuyRate, g_szSellRate	  '매수수익률, 매도수익률
g_szFnprJoinSrno = ""

Dim g_UI_PFIN_YN		'전문투자자여부
Dim g_szAccount, g_szAccoutSeq

'obcsb_acif_700r  투자성향고객등급상품등급비교
dim g_ProsYN					'처리 여부
dim g_KYC_INVT_RCMD_CLS_CODE	'KYC투자권유구분코드
dim g_KYC_INVT_INCL_GRAD_CODE	'KYC 투자 성향 등급 코드
dim g_KYC_PROD_GRAD_CODE		'KYC 상품 등급 코드
dim g_KYC_DVPD_EPMD_CODE		'KYC파생상품유의코드
dim g_KYC_DRVT_PROS_YN			'KYC 파생 처리 여부
dim g_DVPD_GRAD_CODE			'파생상품등급코드

dim g_MesuGO

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Function f_InitUI()
	f_SetToggleUI(-1)
	contMain.cont1.edtPassword.caption = ""
	
	lblBuy.caption = "매수하기"
	
	if g_szSavePwd == "0" then
		contMain.cont1.edtPwdIcon.imgpath = "icon_save_password_n.9"
		contMain.cont1.edtPassword.caption = ""
	else
		contMain.cont1.edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
End Function

'============================================================================
'f_SetToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1
	
	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러

	if nFlag == 0 then '알림,톡
		contMain.ImageAttach1.SetAlpha(0)	'알림톡	'0:선택/1:미선택
		contMain.ImageAttach2.SetAlpha(1)	'이메일
		contMain.imgRdoAttach1.imgpath = szToggleImg1
		contMain.imgRdoAttach2.imgpath = szToggleImg0
		contMain.lblAttach1.fgcolor = szToggleColor1
		contMain.lblAttach2.fgcolor = szToggleColor0
		contMain.lblInfoText.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니  휴대폰 번호를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "talk"
	elseif nFlag == 1 then '이메일
		contMain.ImageAttach1.SetAlpha(1)
		contMain.ImageAttach2.SetAlpha(0)
		contMain.imgRdoAttach1.imgpath = szToggleImg0
		contMain.imgRdoAttach2.imgpath = szToggleImg1
		contMain.lblAttach1.fgcolor = szToggleColor0
		contMain.lblAttach2.fgcolor = szToggleColor1
		contMain.lblInfoText.caption = "고객정보에 등록된 이메일로 발송되오니 이메일 주소를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "email"
	else
		contMain.ImageAttach1.SetAlpha(1)
		contMain.ImageAttach2.SetAlpha(1)
		contMain.imgRdoAttach1.imgpath = szToggleImg0
		contMain.imgRdoAttach2.imgpath = szToggleImg0
		contMain.lblAttach1.fgcolor = szToggleColor0
		contMain.lblAttach2.fgcolor = szToggleColor0
		
		contMain.lblInfoText.caption = ""
		contMain.tblInfo.visible = false
		contMain.btnChangeInfo.visible = false
		contMain.ImageInfo.visible = false
		contMain.lblInfoText.visible = false
		g_szNotiFlag = ""
		
		Exit Function
	end if
	
	contMain.tblInfo.visible = true
	contMain.btnChangeInfo.visible = true
	contMain.ImageInfo.visible = true
	contMain.lblInfoText.visible = true
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()
'	btnReg.visible = true

	'이용동의서류 제공방식 선택 여부
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		lblBuy.enable = false
		Exit Function	
	end if

	'개인신용정보 미동의 사용자가 동의를 하지 않았다면 비활성화
	if g_bUseCreditAgree == false and g_bCheckCreditAgree == false then
		lblBuy.enable = false
		Exit Function		
	end if 

	'계약서류 통보처 정보 없는경우 비활성화
	if g_szUserInfoFlag == false then
		lblBuy.enable = false
		Exit Function		
	end if 

	'KEK STA. 사고계좌 체크
	if gAcdnYn == "Y" then
		lblBuy.enable = false
		
		Exit Function		
	end if 	
	'KEK FIN.
	
	'신청가능
	lblBuy.enable = true
End Function

'============================================================================
'f_SetToggleData(sFlag) : 서류제공방법 DATA SET
'============================================================================
Function f_SetToggleData(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	
	Dim szData
	szData = ""
	if sFlag == "talk" then '알림,톡
		szData = contMain.cont3.tblUserInfo.GetCellString(0, 1) '폰번호
	elseif sFlag == "email" then '이메일
		szData = contMain.cont3.tblUserInfo.GetCellString(1, 1) '이메일
	end if
	if szData <> "" and szData <> null then
		contMain.tblInfo.SetCellString(0, 0, szData)
		contMain.tblInfo.SetCellString(0, 1, "변경하기 〉")		
		
		g_szUserInfoFlag = true
	else
		contMain.tblInfo.SetCellString(0, 0, "")
		contMain.tblInfo.SetCellString(0, 1, "등록하기 〉")
		
		g_szUserInfoFlag = false
	end if
End Function

'============================================================================
'f_CheckPwd() : 비밀번호 입력여부 체크
'============================================================================
Function f_CheckPwd()
	if contMain.cont1.edtPassword.caption == "" or contMain.cont1.edtPassword.caption == null 
		or Len(contMain.cont1.edtPassword.caption) < 4 then
		
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
		
		return false
	else
		return true
	end if
End Function

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Sub	Init_InputControl()
	contMain.cont2.edtInput.caption = ""
	
	if CInt(contMain.cont2.rdoInput.currentindex) == 0 then
		contMain.cont2.LblPrcin.caption = ""	
		contMain.cont2.edtInput.caption = ""
		contMain.cont2.edtInput.hintcaption = "금액을 입력해주세요."		
		contMain.cont2.BtnPrcin.caption = "금액을 입력해주세요."
		
	else
		contMain.cont2.LblPrcin.caption = ""	
		contMain.cont2.edtInput.caption = ""
		contMain.cont2.edtInput.hintcaption = "수량을 입력해주세요."
		contMain.cont2.BtnPrcin.caption = "수량을 입력해주세요."
	end if
	
	contMain.cont2.tblInfo.SetCellString(1, 3, "0")		'매수단가
	contMain.cont2.tblInfo.SetCellString(2, 3, "0")		'수량(액면금액)
	contMain.cont2.tblInfo.SetCellString(3, 3, "0")		'결제금액
	
	contMain.cont2.tblInfo.SetCellString(1, 3, 0)
	contMain.cont2.tblInfo.SetCellString(2, 3, 0)
	contMain.cont2.tblInfo.SetCellString(3, 3, 0)

	contMain.cont2.lblAlert.visible = False
	
	lblBuy.caption = "매수하기"
End Sub

