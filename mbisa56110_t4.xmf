'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctad_023r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_INDV_MGRI_ASNO" , 0 , g_szList(1))
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD" , 0 , g_szList(2))
	End If
	
	'=====================================================================================
	'20210312_01 HSZ START : ISA계좌개설 개선
	'=====================================================================================
	If szTranID = "obwat_ctad_069r" then
		'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
		dim plain_rm
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )

'		n_acno = Form.GetSharedData("ISA_ACNO_SEND", 0 )
'		n_asno = Form.GetSharedData("ISA_ASNO_SEND", 0 )
'		n_pwd = Form.GetSharedData("ISA_PWD_SEND", 0 )
		
		n_acno = Form.GetCtlProp("#acnt0", "total")
		n_asno = Form.GetCtlProp("#acnt0", "sequence")
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , n_acno	)	'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , n_asno	)	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "APLT_DATE" , 0 , Form.GetSharedData("&HOST_DATE" , false)	)	'신청일자
		
	
		if plain_rm == "1" then 'MTS 메모리평문 적용상태일때
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD" , 0 ,	Form.GetCtlProp("#edtPwd", "caption") )	'비밀번호
		else 'MTS메모리평문 미적용상태일때
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD" , 0 ,	Form.GetCtlProp("#edtPwd", "encdata") )	'비밀번호
		end if
			
	End if
	
	if szTranID == "obwat_csad_003r" or szTranID == "obwat_csad_003r_1" then
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szList(21)	)	'WA상품코드
		
		if szTranID == "obwat_csad_003r" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "2"	)	'구분
		else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "3"	)	'구분
		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_ctad_023r" then	
		Call ResetAddrInfo(szTranID)	'연락처 변경시 연락처 정보 및 보고서발송처/계약서수령방법 콤보 재셋팅
	End If
	
	'=====================================================================================
	'20210312_01 HSZ START : ISA계좌개설 개선
	'=====================================================================================
	if szTranID = "obwat_ctad_069r" then
		g_sReceiveData3  =  DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "EXIN_TLMS_CNTT" , 0)
		
		g_sReceiveExt0  = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT" , 0)
		g_sReceiveExt1  = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT1" , 0)
		g_sReceiveExt2 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT2" , 0)
		g_sReceiveExt3 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLT_SVC_INFO_CNTT3" , 0)
		g_sReceiveExt4 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ANTC_PNSN_RECV_CNTT" , 0)
		g_sReceiveExt5 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ANTC_PNSN_RECV_CNTT1" , 0)
		
		Call DataSetting()
	end if
	
	if szTranID == "obwat_csad_003r" then
		g_nUSE_CNT = CInt(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "USE_CNT" , 0))
		g_sWA_MGRI_EMPNO = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "WA_MGRI_EMPNO" , 0)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
Sub Form_OnFormClose()
	nFlag = 0
End Sub

