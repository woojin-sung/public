'============================================================================
Sub SetTableData()
'	cont0.tbl0.SetCellString( 0, 1, g_szList(25))		'미사용한도
	cont0.tbl0.SetCellString( 5, 1, g_szList(11))		'자택주소
	cont0.tbl0.SetCellString( 6, 1, g_szList(12))		'직장주소
	cont0.tbl0.SetCellString( 7, 1, g_szList(13))	'연락처
	cont0.tbl0.SetCellString( 8, 1, g_szList(14))	'email
End Sub

'============================================================================
Sub SetCombo()
	'보고서발송처 : 연락처가 존재하는 항목만 콤보에 셋팅
	cont0.cmb1.clear = 1
	If g_szList(11) <> "" then
		cont0.cmb1.cbadddatatext = "01`자택"
	End If
	
	If g_szList(12) <> "" then
		cont0.cmb1.cbadddatatext = "02`직장"
	End If
	
	If g_szList(14) <> "" then
		cont0.cmb1.cbadddatatext = "21`E-mail"
	End If

	'계약서수령방법 : 연락처가 존재하는 항목만 콤보에 셋팅
	cont0.cmb3.clear = 1
'	If g_szList(11) <> "" then
'		cont0.cmb3.cbadddatatext = "02`자택"
'	End If
	
	If g_szList(12) <> "" then
		cont0.cmb3.cbadddatatext = "05`알림톡/문자"
	End If
	
	'v0002
	If g_szList(14) <> "" then
		cont0.cmb3.cbadddatatext = "04`E-mail"
	End If
	
	'증권약정계좌 중 ISA 계좌와 앞 8자리가 같은 계좌로 디폴트 셋팅(자동매도 : 종합매매, CMA)
	For i = 0 to cont0.acnt0.accountcount-1
		cont0.acnt0.currentindex = i
		If (cont0.acnt0.itemcodetype == "100" or cont0.acnt0.itemcodetype == "118") and cont0.acnt0.total == g_szList(0) then
			Exit For
		End If

	Next

	'증권약정계좌 중 ISA 계좌와 앞 8자리가 같은 계좌로 디폴트 셋팅(지정매도 : 종합매매)
	For i = 0 to cont0.acnt1.accountcount-1
		cont0.acnt1.currentindex = i
		If cont0.acnt1.itemcodetype == "100" and cont0.acnt1.total == g_szList(0) then
			Exit For
		End If
	Next
	
	
End Sub

'============================================================================
'연락처 변경시 연락처 정보 및 보고서발송처/계약서수령방법 콤보 재셋팅
Sub ResetAddrInfo(szTranID)
	sHomeAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_ADDR" , 0)	'자택주소
	sCoAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CO_ADDR" , 0)		'회사주소
	sTel = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CNPL_TELNO" , 0)		'연락처
	sEMail = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "EMAIL_ADDR" , 0)	'이메일주소
	
	cont0.tbl0.SetCellString( 5, 1, sHomeAddr)		'자택주소
	cont0.tbl0.SetCellString( 6, 1, sCoAddr)			'직장주소
	cont0.tbl0.SetCellString( 7, 1, sTel)			'연락처
	cont0.tbl0.SetCellString( 8, 1, sEMail)			'email
	
	'보고서발송처 : 연락처가 존재하는 항목만 콤보에 셋팅
	cont0.cmb1.clear = 1
	If sHomeAddr <> "" then
		cont0.cmb1.cbadddatatext = "01`자택"
	End If
	
	If sCoAddr <> "" then
		cont0.cmb1.cbadddatatext = "02`직장"
	End If
	
	If sEMail <> "" then
		cont0.cmb1.cbadddatatext = "21`E-mail"
	End If
	
	cont0.cmb1.cbkeydata = g_cmbKey1
	
	'계약서수령방법 : 연락처가 존재하는 항목만 콤보에 셋팅
	cont0.cmb3.clear = 1
'	cont0.cmb3.cbadddatatext = "01`온라인"
	
'	If sHomeAddr <> "" then
'		cont0.cmb3.cbadddatatext = "02`자택"
'	End If

	'v0003
	If sTel <> "" then
		cont0.cmb3.cbadddatatext = "05`알림톡/문자"
	End If
	
	If sEMail <> "" then
		cont0.cmb3.cbadddatatext = "04`E-mail"
	End If
	
	cont0.cmb3.cbkeydata = g_cmbKey3
End Sub

'============================================================================
Function ValidateCheck()
'	If cont0.edtAmt.caption == "" then
'		Form.ShowAlert("알림", "계약금액을 입력해주세요.")
'		return False
'	End If
'
'	If CDbl(cont0.edtAmt.caption) <  CDbl(g_szList(17)) then
'		Form.ShowAlert("알림", "최소가입금액은 " & CDbl(g_szList(17)) & "원 입니다.")
'		return False
'	End If
	
	'v0001. 미사용한도 금액 체크 제거 
'	If CDbl(cont0.edtAmt.caption) >  CDbl(cont0.tbl0.GetCellString( 0 , 1 )) then
'		Form.ShowAlert("알림", "계약금액은 미사용한도 금액 이내로 가능합니다.")
'		return False
'	End If
	'v0001.fin
	
	'선택사항으로 변경
'	If cont0.edt0.caption == "" then
'		Form.ShowAlert("알림", "목표수익률을 입력해주세요.")
'		return False
'	End If
'	
'	If cont0.edt1.caption == "" then
'		Form.ShowAlert("알림", "손절수익률을 입력해주세요.")
'		return False
'	End If
'	
'	If CDbl(cont0.edt0.caption) <= 0 then
'		Form.ShowAlert("알림", "목표수익률을 입력해주세요.")
'		return False
'	End If
'	
'	If CDbl(cont0.edt1.caption) <= 0 then
'		Form.ShowAlert("알림", "손절수익률을 입력해주세요.")
'		return False
'	End If

	'v0001.계약기간에 따른 계약금액 체크 sta
'     If Int(TRIM(cont0.edtAmt.caption)) > 60000000 Then 
'		Form.ShowAlert("알림", "계약금액 최대 6천만원까지 입력 가능")
'		return False
'     End If
	'v0001. fin

	If cont0.edt0.caption <> "" then
		If CDbl(cont0.edt0.caption) >= 1000 then
			Form.ShowAlert("알림", "목표수익률은 1000 미만으로 입력가능합니다.")
			return False
		End If
	End If
	
	If cont0.edt1.caption <> "" then
		If CDbl(cont0.edt1.caption) >= 100 then
			Form.ShowAlert("알림", "손절수익률은 100 미만으로 입력가능합니다.")
			return False
		End If
	End If
	
	If cont0.cmb1.cbkeydata == "" then
		Form.ShowAlert("알림", "보고서발송처가 존재하지 않습니다.")
		return False
	End If

'	If cont0.chk1.checkstate <> "1" then
'		Form.ShowAlert("알림", "계약자 확인사항을 입력해주세요.")
'		return False
'	End If
	
	return True
End Function

'============================================================================
Sub MoveNextPage()
	Dim sSendData, szTranID
	szTranID = "obwat_ctad_068a"
	'추후 유지보수 중 항목 추가 발생할 경우에 대비, 각 화면마다 array 20개씩 잡아놓음
	
	'20210312_01 HSZ START : ISA계좌개설 개선
	sSendData = cont0.edtAMt.caption & "★"
	'sSendData = g_sSendData & cont0.edtAMt.caption & "★"
	'20210312_01 HSZ END
	
	sSendData = sSendData & cont0.cmb0.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb0.caption & "★"
	
	If cont0.cmb0.currentindex == "0" then
		sSendData = sSendData & cont0.acnt0.total & "★"
		sSendData = sSendData & cont0.acnt0.sequence & "★"
	Else
		sSendData = sSendData & cont0.acnt1.total & "★"
		sSendData = sSendData & cont0.acnt1.sequence & "★"
	End If
	
	sSendData = sSendData & cont0.cmb1.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb1.caption & "★"
	sSendData = sSendData & cont0.cmb2.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb2.caption & "★"
	sSendData = sSendData & cont0.cmb4.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb4.caption & "★"
	
	sSendData = sSendData & cont0.edt0.caption & "★"
	sSendData = sSendData & cont0.edt1.caption & "★"
	sSendData = sSendData & g_sClickTime & "★"
	sSendData = sSendData & cont0.cmb3.cbkeydata & "★"
	sSendData = sSendData & cont0.cmb3.caption & "★"
	sSendData = sSendData & g_nUSE_CNT & "★" 
	sSendData = sSendData & g_sWA_MGRI_EMPNO & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	
	prevList = g_szList(0)
	For i = 1 to 29 '30 $$
		prevList = prevList & "★" & g_szList(i)
	Next
	prevList = prevList & "★" & "0"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	prevList = prevList & "★"
	'20210312_01 HSZ START : ISA계좌개설 개선
'	Form.ShowAlert(g_sSharedKey, sSendData)
	if nFlag = 1 then
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK", prevList & sSendData)
	else
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK",  prevList & sSendData) 'g_sSendData & sSendData )$$
	end if
	'20210312_01 HSZ END	
	
	'=====================================================================================
	'20210312_01 HSZ START : ISA계좌개설 개선 (서비스사용으로 대체필요)
	'=====================================================================================
	sSaveExt1 = cont0.cmb0.currentindex
	sSaveExt2 = g_sInputText '계약자확인사항 저장하면 안될듯(이정도는 다시 입력받아야 할듯. 중요항목이어서)$$
	
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0)	)	'계좌번호
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , g_szList(1)	)	'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "APLT_DATE" , 0 , Form.GetSharedData("&HOST_DATE" , false)	)	'신청일자
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD" , 0 , g_szList(2)	)	'비밀번호
	
	'필수정보(기존유지)
'	Form.SaveConfigData("56060_STEP_LINK", "STEP3", sSendData)
'	DATAMANAGER.SetDataValue( 0, "obwat_ctad_068a", "InBlock1", "EXIN_TLMS_CNTT" 	, 0 , g_sSendData & sSendData)
	if nFlag = 1 then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "EXIN_TLMS_CNTT", 0 , prevList & sSendData)
	else
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "EXIN_TLMS_CNTT", 0 , prevList & sSendData) 'g_sSendData & sSendData )$$
	end if
	'단계정보
'	Form.SaveConfigData("56060_STEP_LINK", "STEP_FINAL", "3") '4단계완료	
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" 	, 0 , "4")
	
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ANTC_PNSN_RECV_CNTT1", 0, g_sReceiveExt5 )
	
	'부가정보1
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_SVC_INFO_CNTT3" 	, 0 , sSaveExt1)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ANTC_PNSN_RECV_CNTT" 	, 0 , sSaveExt2) '$$
	
	'앞단계 정보
'	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ANTC_PNSN_RECV_CNTT" 	, 0 , g_sReceiveData2)
'	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ANTC_PNSN_RECV_CNTT1" 	, 0 , g_sReceiveData2)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_SVC_INFO_CNTT" 		, 0 , g_sReceiveExt0)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_SVC_INFO_CNTT1" 	, 0 , g_sReceiveExt1)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APLT_SVC_INFO_CNTT2" 	, 0 , g_sReceiveExt2)
	
	'유형코드
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ETC_CNTT" 			, 0, g_sOnline_Code 	)
	
	DATAMANAGER.RequestTranData("obwat_ctad_068a")
	
	'부가정보2
	'Form.SaveConfigData("56060_STEP_LINK", "STEP3_2", sSaveExt2)

	'=====================================================================================
	'20210312_01 HSZ END	
	'=====================================================================================
	
	Form.triggerEvent("#", "OPEN_NEXT", "4")
End Sub

'============================================================================
'nGb = 0 : Trigger 발생시 콤보 셋팅 제외(기존 입력값 유지 위해)한 나머지 데이터 셋팅
'nGb = 1 : Form Init시 콤보 셋팅 초기화 포함
Sub LoadLinkData(nGb)
	'20210312_01 HSZ START : ISA계좌개설 개선
	g_sReceiveExt0 = Form.GetSharedData(g_sSharedKey & "_STEP_LINK_ETC" , false)
	g_sReceiveExt1 = Form.GetSharedData(g_sSharedKey & "_STEP_LINK_ETC1", false)
	g_sReceiveExt2 = Form.GetSharedData(g_sSharedKey & "_LINK_ETC2", false)
	g_sReceiveExt5 = Form.GetSharedData(g_sSharedKey & "_INFO_STEP_LINK", false)
	'20210312_01 HSZ END
		
	g_sSendData = Form.GetSharedData(g_sSharedKey & "_STEP_LINK", false)
	
	if g_sSendData <> null and g_sSendData <> "" then
		g_szList = Split(g_sSendData,"★")		
		
		if UBOUND(g_szList) > 0 then
			Call SetTableData()
		
			If nGb == 1 then
				Call SetCombo()
			End If
			
			DATAMANAGER.RequestTranData( "obwat_csad_003r" )
		
		else
			Exit Sub
		end if
	end if
	
'	DATAMANAGER.RequestTranData( "obwat_csad_003r_1" )
	'이전/다음 이동시 MP선택 변경했다면 계약자 확인 사항 내용 변경되므로 체크 해제
'	If g_szList(30) == "1" then
'		cont0.chk1.checkstate = "0"
'		g_sInputText = "★★★★★★★"
'	End If
	
End Sub


