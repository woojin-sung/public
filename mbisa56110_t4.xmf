'============================================================================
Sub Form_OnFormInit()
'	Call LoadLinkData(1)	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'STEP1의 계좌번호 변경시 Data Clear
	If sEventName == "CLEAR_DATA" Then
		cont0.edtAmt.caption = ""
		
		cont0.cmb0.currentindex = 0
		Call cont0_cmb0_OnEditComplete(0)
		
		cont0.cmb1.currentindex = 0
		cont0.cmb3.currentindex = 0
		cont0.cmb2.currentindex = 0
		cont0.edt0.caption = "0"
		cont0.edt1.caption = "0"
		cont0.cmb4.currentindex = 0
		cont0.chk1.checkstate = "0"
		
		g_sInputText = "★★★★★★★"
		g_sClickTime = ""
		g_cmbKey1 = ""
		g_cmbKey3 = ""
		
		cont0.scroll_pos = 0
	End If
	
	'[입력데이터 재로드]
	'다음 버튼 클릭시 SetSharedData한 후, 다음 화면 Form_OnFormInit에서 GetSharedData 하는데,
	'입력내용 유지 위해 폼 변환시 Unload를 하지 않으므로, 
	'이전 화면으로 돌아가 데이터 변경 후 다음 버튼 클릭시, Form_OnFormInit을 타지 않음 
	'-> Trigger로 GetSharedData 재호출
	If sEventName == "RELOAD_DATA" Then
		Call LoadLinkData(0)	
	End If
	
	If sEventName == "OPEN_PREV" Then

		'=====================================================================================
		'20210312_01 HSZ START : ISA계좌개설 개선
		'=====================================================================================
		nFlag = 1
		DATAMANAGER.RequestTranData("obwat_ctad_069r")
	
	elseif sEventName == "SET_ONLINE_CODE" Then
		if sParam <> null and sParam <> "" then
			g_sOnline_Code = sParam
		end if
	
	elseif sEventName == "SET_SHARED_KEY" then
		if sParam <> null and sParam <> "" then
			g_sSharedKey = sParam
			
			Call LoadLinkData(1)
		end if
		
	end if

End Sub
'============================================================================
'20210312_01 HSZ START : 이어가기 데이터 세팅 함수
'============================================================================
Function DataSetting()
	szList		= Split(g_sReceiveData3,"★") '필수정보(기존유지)
	szListExt1	= g_sReceiveExt3 '부가정보1
	g_sInputText 	= g_sReceiveExt4
	
	if g_sReceiveExt5 <> "" and g_sReceiveExt5 <> null then 'STEP1 데이터 체크
		Form.SetSharedData(g_sSharedKey & "_INFO_STEP_LINK", g_sReceiveExt5 )
	end if
	
	if UBOUND(szList) > 0 then
		'원래 공유 링크변수에 값 셋팅해줘야 함
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK", g_sReceiveData3 )
		
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK_ETC" , g_sReceiveExt0)
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK_ETC1", g_sReceiveExt1)
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK_ETC2", g_sReceiveExt2)
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK_ETC3", g_sReceiveExt3)
		Form.SetSharedData(g_sSharedKey & "_STEP_LINK_ETC4", g_sInputText)
		
		
		LoadLinkData(1)
		
		'-------------------------------------------------------------------
		'(유형1) UI 강제셋팅 
		'-------------------------------------------------------------------
		if len(szListExt1) > 0 then
			acntGb = g_sReceiveExt3
		End if
		
		'-------------------------------------------------------------------
		'(유형2) Saved Data -> UI & Variable 셋팅
		'-------------------------------------------------------------------
		cont0.edtAMt.caption	= szList(40)
		cont0.cmb0.cbkeydata	= szList(41)
		cont0.cmb0.caption	= szList(42)
		
		cont0.cmb1.cbkeydata	= szList(45)
		cont0.cmb1.caption	= szList(46)
		cont0.cmb2.cbkeydata	= szList(47)
		cont0.cmb2.caption	= szList(48)
		cont0.cmb4.cbkeydata	= szList(49)
		cont0.cmb4.caption	= szList(50)
		cont0.edt0.caption	= szList(51)
		cont0.edt1.caption	= szList(52)
		g_sClickTime			= szList(53)
		cont0.cmb3.cbkeydata	= szList(54)
		cont0.cmb3.caption	= szList(55)
		if acntGb = "0" then
			cont0.acnt0.visible = true
			cont0.acnt1.visible = false
			cont0.acnt0.caption	= szList(43) & szList(44)
		else
			cont0.acnt0.visible = false
			cont0.acnt1.visible = true
			cont0.acnt1.caption	= szList(43) & szList(44)
		end if
		
'		szText = Split(g_sInputText,"★")	
		
'		if UBOUND(szText) < 1 then
'			cont0.chk1.checkstate = "0"
'			Exit Function
'		End if
'		
'		If szText(0) == "ok" then
'			cont0.chk1.checkstate = "1"
'			g_sClickTime = Form.GetSharedData("&HOST_TIME", True )
'		Else
'			cont0.chk1.checkstate = "0"
'		End If

		
	else
		LoadLinkData(1)
	end if

	
End Function
'20210312_01 HSZ END

