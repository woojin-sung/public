'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
' 진한색
Dim g_szLineColor
g_szLineColor = "347"
' 중간색
Dim g_szLineColor2
g_szLineColor2 = "256"
' 연한색
Dim g_szLineColor3
g_szLineColor3 = "320"


' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

'==============================================
' 기타 전역변수
'==============================================
Dim g_szItemCd 
Dim g_szExidCd
Dim g_szOnlyCd
Dim g_sExid3
Dim g_szItemName
Dim g_rtChk

Dim g_szType
g_szType = "하드웨어 및 장비"

Dim g_szTypeCd
g_szTypeCd = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	contMain.setEnableScroll(false)
	
	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	contMain.lblExpand.paddinginfo = "0,0,0,0"
	contMain.lblExpand.fgcolor = g_szTxtColor_Grey
	
	contMain.lblDiv.bgcolor = g_szLineColor3
'	

'	
'	contMain.imgNotice.maintainratio = "1"
'	
'	contMain.lblInfo1.paddinginfo = "0,0,0,0"
'	contMain.lblInfo1.maxlinecnt = "1"
'	contMain.lblInfo1.fgcolor = g_szTxtColor_Red
'	contMain.lblInfo1.visible = true
	
	
End Function

Function Request_Tran_ohhts_news_001r()
	contMain.Pannel0.rowcount = "0"
	DATAMANAGER.ClearInputData(false, "ohhts_news_001r")
	
	szDate =  Form.GetSharedData("&HOST_DATE", false)
'	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "00" )
'	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_DATE"				, 0 , szDate )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"			, 0 , g_sExid3 & g_szOnlyCd )
	
	DATAMANAGER.RequestTranData("ohhts_news_001r")
End Function

Function Process_Tran_ohhts_news_001r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "ohhts_news_001r", "OutBlock1")
	
	if nDataCnt == "" or Cint(nDataCnt) == 0 then
		Exit Function
	end if
	
	if Cint(nDataCnt) > 3 then
		nDataCnt = 3
	end if
	
	if nDataCnt > 0 then
		nReduce = (3-nDataCnt) * 70
		contMain.lblDiv.top = 245 - nReduce
		
		Form.triggerEvent("#", "CHANGE_LAYOUT_S13", 280 - nReduce)
	else
		Form.triggerEvent("#", "CHANGE_LAYOUT_S13", 0)
	end if
	
	for i = 0 to nDataCnt-1
		szData0 = DATAMANAGER.GetDataValue(false, "ohhts_news_001r", "OutBlock1", "FID_DATE" , i)				'뉴스일자
		szData1 = DATAMANAGER.GetDataValue(false, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i)			'뉴스시간
		szData2 = DATAMANAGER.GetDataValue(false, "ohhts_news_001r", "OutBlock1", "FID_TITL", i)				'뉴스제목
		szData3 = DATAMANAGER.GetDataValue(false, "ohhts_news_001r", "OutBlock1", "FID_NEWS_KEY", i)			'뉴스키
		szData4 = DATAMANAGER.GetDataValue(false, "ohhts_news_001r", "OutBlock1", "FID_KOR_ISNM" , i)			'한글종목명
		szData5 = DATAMANAGER.GetDataValue(false, "ohhts_news_001r", "OutBlock1", "FID_NEWS_OFER_ENTP_CODE" , i)	'뉴스제공업체코드
		
		nIdx = contMain.Pannel0.addRow()
		
		DisplaySetting_Pannel(nIdx, szData0, szData1, szData2, szData3, szData4, szData5) 
	next
End Function


Function DisplaySetting_Pannel(nIdx, szDate, szTime, szTitle, szNewsKey, szKorNm, szEntpCd) 
	'상단 라인표시
	if nIdx = 0 then
		contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szTxtColor_White)
	else
		contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor2)
	end if


	contMain.Pannel0.setPropCardCell("paddinginfo","lblNewsTitle",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblNewsTitle",nIdx, g_szTxtColor_Normal)
	contMain.Pannel0.setPropCardCell("maxlinecnt","lblNewsTitle",nIdx, "1^-1")
	contMain.Pannel0.setPropCardCell("caption","lblNewsTitle",nIdx, szTitle)
	
	
	szDateTime = ""
	
	if szDate <> "" then
		szDateTime = szDateTime & mid(szDate, 3, 2) & "." & mid(szDate, 5, 2) & "." & right(szDate, 2) & " "
	end if
	
	if szTime <> "" then
		szDateTime = szDateTime & left(szTime, 2) & ":" & mid(szTime, 2, 2) & ":" & right(szTime, 2) 
	end if
	
	contMain.Pannel0.setPropCardCell("paddinginfo","lblDateTime",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblDateTime",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("caption","lblDateTime",nIdx, szDateTime)
	
	
	contMain.Pannel0.setPropCardCell("caption","lblHideData0",nIdx, szDate)
	contMain.Pannel0.setPropCardCell("caption","lblHideData1",nIdx, szTime)
	contMain.Pannel0.setPropCardCell("caption","lblHideData2",nIdx, szNewsKey)
	contMain.Pannel0.setPropCardCell("caption","lblHideData3",nIdx, szKorNm)
	contMain.Pannel0.setPropCardCell("caption","lblHideData4",nIdx, szEntpCd)
	
End Function
Function Convert_NatCd(szExidCd)
	szResult = ""
	
	Select Case szExidCd
'		Case "NY", "AX", "OQ" 
'			szResult = "US"
		Case "SH", "SZ"
			szResult = "CN"
		Case "JP", "HK"
			szResult = szExidCd
'		Case Else
'			szResult = ""
	End Select
	
	return szResult
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'===============================================
' Form_OnTriggerEvent(종목코드 연동)
'===============================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		if instr(sParam, "@") > 0 then
			g_szItemCd = sParam
			g_szExidCd = ""
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 
			g_sExid3 	= Form.GetItemCodeInfo(g_szItemCd, "exchcode3") '거래소 구분코드
			g_szItemName = Form.GetItemCodeInfo( sParam , "name")
					
			g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			
			Request_Tran_ohhts_news_001r()
		end if
	end if
End Sub

'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
End Sub

'===============================================
' DATAMANAGER_OnReceiveTranComplete
'===============================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_news_001r" then
		Process_Tran_ohhts_news_001r()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.triggerEvent("#", "CHANGE_LAYOUT_S13", 0)
End Sub

'============================================================================
Sub contMain_Pannel0_OnClick(nIndex, sCellID)
	szTitle 			= contMain.Pannel0.getPropCardCell("caption", "lblNewsTitle", nIndex)
	szDate 			= contMain.Pannel0.getPropCardCell("caption", "lblHideData0", nIndex)
	szTime 			= contMain.Pannel0.getPropCardCell("caption", "lblHideData1", nIndex)
	szNewCorpName 	= contMain.Pannel0.getPropCardCell("caption", "lblHideData3", nIndex)
	szNewKey 		= contMain.Pannel0.getPropCardCell("caption", "lblHideData2", nIndex)
	szNewsCorpCode 	= contMain.Pannel0.getPropCardCell("caption", "lblHideData4", nIndex)

	if szTitle <> "" and szDate <> "" and szTime <> "" and szTitle <> "" and szNewCorpName <> "" and szNewKey <> "" and szNewsCorpCode <> "" then
		szMsg = szTitle & "|" & szDate & "|" & szTime & "|" & szNewCorpName & "|" & szNewKey & "|" & szNewsCorpCode & "|" & g_szItemName
		Form.OpenPopup( "mhprc11000_p6" , "mhtro16000_t09"& "★" &szMsg, "" )
	end if
End Sub

'============================================================================
Sub contMain_lblExpand_OnClick()
	Form.triggerEvent("#", "RETURN_LAYOUT", "뉴스")
End Sub


