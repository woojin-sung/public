'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 매도담보대출
' 02. 화면설명 : 매도담보대출 담보대출가능종목 팝업
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAcctFirstCode, g_szAcctMidCode, g_szAcctPW, g_nTab


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, szAcctNo, szValue
	
	szValue = Form.GetOpenLinkData()

	szData = Split(szValue,"★",-1,1)
	
	If UBOUND(szData) < 1 Then 'Data 없을때
		Exit Sub
	End If
	
	g_szAcctFirstCode	= szData(0)
	g_szAcctMidCode	= szData(1)
	g_nTab			= szData(2)
	g_szAcctPW		= szData(3)
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	Form.SetScreenName( "담보대출 가능종목" )
	DATAMANAGER.RequestTranData( "obtrs_comn_306r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( false, "obtrs_comn_306r", "InBlock1", "ASNO"		, 0 , g_szAcctMidCode	)
	DATAMANAGER.SetDataValue( false, "obtrs_comn_306r", "InBlock1", "ACNO"		, 0 , g_szAcctFirstCode)
	DATAMANAGER.SetDataValue( false, "obtrs_comn_306r", "InBlock1", "ACNT_PWD"	, 0 , g_szAcctPW 		)
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szOrd_Data, szCredit, szCode, szQty, szDate, szSRNO, szTmp
	
	if szCellID <> "bd_cell1" then
		
		szTmp   = grd0.GetCellData( "bd_cell5", lRow  )	'종목코드
	
		If Left(szTmp, 1) = "A" or Left(szTmp, 1) = "J" Then
		    szCode = Right( szTmp, Len( szTmp )-1 )
		Else
			szCode = szTmp
		End If
	
	    szCredit = grd0.GetCellData( "bd_cell6", lRow  )	'신용유형(Code)	    
	    szQty    = grd0.GetCellData( "bd_cell12", lRow  )	'가능수량
	    szDate   = grd0.GetCellData( "bd_cell4", lRow  )   '대출일자
	    szSRNO   = grd0.GetCellData( "bd_cell16", lRow )   '대출일련번호
	    
'	    If szCredit = "0103" Or szCredit = "0104" Or							'자기대주, 유통대주
'	       szCredit = "0201"  Or szCredit = "0211" Or OrszCredit = "0401" Then	'신용
'			Form.ShowAlert( "Meritz", "해당 잔고는 주식주문화면에서 매매 가능합니다.")		
'			Exit Sub
'			
'		End If
	    
		'  전달내용/탭위치/종목코드/수량/대출일자/대출일련번호/신용유형
		szOrd_Data = "담보" & "★" & g_nTab & "★" & szCode & "★" & szQty & "♥" & szDate & "♥" & szSRNO & "♥" & szCredit
	    
		Form.SendReturnToParent( "12000_BALANCE" , szOrd_Data )
		Form.CloseForm()
	
	End If
End Sub


'============================================================================
Sub btn0_OnClick()
	DATAMANAGER.RequestTranData( "obtrs_comn_306r" )	
End Sub

