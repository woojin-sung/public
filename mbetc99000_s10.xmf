<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99000" scrname="투자성향진단1" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" caption="나는" ly_vert="42,160,40,32,1" />
		<EDIT name="Edit0" halign="1" imetype="1" ly_vert="102,160,70,32,1" />
		<LABEL name="Label1" caption="살 이고 " ly_vert="182,160,70,32,1" />
		<LABEL name="Label2" caption="투자예정기간은" ly_vert="42,210,120,32,1" />
		<EDIT name="Edit1" halign="1" imetype="1" ly_vert="175,210,70,32,1" />
		<LABEL name="Label3" caption="개월 입니다." ly_vert="252,210,100,32,1" />
		<LABEL name="Label5" border="1" bordercolor="144:034034034" ly_vert="12,115,350,180,1" />
		<LABEL name="Label4" fontstyle="01" caption="Q1." bgcolor="048:255255255" transmode="0" halign="1" ly_vert="42,100,40,32,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1924" _ulen="1904" >


'============================================================================
Sub Edit0_OnEditComplete()

     age = Cint(Edit0.caption)
	
	if  age >= 1 and age <21 then 
	
	age_score = 1
	
	elseif age >=21 and age <31 then
	
	age_score = 3
	
	elseif age >=31 and age <51 then
	
	age_score = 5
	
	elseif age >=51 and age <61 then
	
	age_score = 4
	
	elseif age >= 61 then
	
	age_score = 2
	
	end if
	
	Form.SetSharedData("score1" , Cstr(age_score))
	
	
	if Edit0.caption <> "" and Edit1.caption <> "" then
		'Form.triggerEvent("#", "check_condition", "1") '완료
		 check_flag_1 = 1
		 Form.SetSharedData("check_flag_1" , check_flag_1)
		 
	elseif Edit0.caption =="" or Edit1.caption =="" then
	'	Form.triggerEvent("#", "check_condition", "0") '미입력
		 check_flag_1 = 0
		 Form.SetSharedData("check_flag_1" , check_flag_1)
		
			
	end if
	
	
	
	
End Sub


'============================================================================
Sub Edit1_OnEditComplete()

     period = Cint(Edit1.caption)
	
	if period < 6 then
	
	period_score = 15
	
	elseif period >= 6 and period <12 then
	
	period_score = 10
	
	elseif period >=12 and period <36 then
	
	period_score = 5
	
	elseif period >=36 then
	
	period_score = 1
	
	end if
	
	
	Form.SetSharedData("score2" , period_score)
	
	
	if Edit0.caption <> "" and Edit1.caption <> "" then
		'Form.triggerEvent("#", "check_condition", "1") '완료
		 check_flag_1 = 1
		 Form.SetSharedData("check_flag_1" , check_flag_1)
		 
	elseif Edit0.caption =="" or Edit1.caption =="" then
	'	Form.triggerEvent("#", "check_condition", "0") '미입력
		 check_flag_1 = 0
		 Form.SetSharedData("check_flag_1" , check_flag_1)
		
			
	end if
	
	
	

	
End Sub



'============================================================================



'============================================================================
Sub Form_OnFormInit()
	check_flag_1 = 0
End Sub

	</SCRIPT_INFO>
</ROOT>