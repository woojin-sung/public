'============================================================================
Sub Form_OnFormInit()
	Dim sOpenData, sOpenArr
	sOpenData	= Form.GetOpenLinkData()
	sOpenArr		= split(sOpenData, "@")

	if UBOUND(sOpenArr) < 1 then
		Form.ShowAlert("알림", "펀드자동이체 신청내역 데이터가 없습니다.")
		Form.CloseForm()
		
		Exit Sub
	end if
	
	sOpenArr	= split(sOpenData, "@")	' 종목명, 출금계좌, 이체금액, 이체기간, 이체일
	
	LblTitle.caption = sOpenArr(0)	
	Table0.SetCellString(0, 1, sOpenArr(1))
	Table0.SetCellString(1, 1, sOpenArr(2))
	Table0.SetCellString(2, 1, sOpenArr(3))
	Table0.SetCellString(3, 1, sOpenArr(4))
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

