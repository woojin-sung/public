'============================================================================
' 01.화면명 	: 오픈뱅킹 다른금융기관 직접입력
' 02.화면설명	: 오픈뱅킹 다른금융기관 직접입력
' 03.작성	: 2020.10.07
' 04.수정     : 2021.01.13. 장원혁 : v001 : 간편인증로그인 시 공인인증절차를 간편인증으로 변경
'============================================================================
Dim sz_email
Dim szCust_Num 	'고객번호
Dim sz_CheckAccountOK
Dim g_szCom		'오픈뱅킹기관코드
Dim sUserID
Dim g_CiKey
Dim g_szCertUserType        'v001 로그인유형 

Sub Form_OnFormInit()
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
	sUserID	  = Form.GetSharedData( "&USER_ID"		, false )	'사용자ID
	g_szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입

	Image0.imgpath = "title_3step_cut_02_on.png"
	
	g_szCom  = ""
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE"   	, 0, "1"  	) '1:미해지계좌전체, 2:출금동의계좌 9:해지계좌포함전체
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE"  , 0, "A"  	) 'A :전체
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID"   			, 0, sUserID  ) 
	
	DATAMANAGER.RequestTranData("obtss_opnf_008r") '오픈뱅킹_타행계좌내역조회
	
	
	recv_data = Form.GetOpenLinkData()
	
	tData = Split(recv_data, "★")
	
	if UBOUND(tData) < 1 then
		exit sub
	end if
	
	sz_email = tData[0]
	g_CiKey  = tData[1]
	
	sz_CheckAccountOK = "N"
	
	
	
	
	
End Sub

'============================================================================

Sub imgSearch_OnClick()
	achoName.caption  = ""  '계좌변경시 예금주명 초기화
	sz_CheckAccountOK = "N" '금융기관변경시 타행계좌실명조회 다시해야함
	
	Form.OpenPopup("mbbnk62007" , "" ,"")
End Sub

Sub edtAcnt_OnEditComplete()
	achoName.caption  = ""  '계좌변경시 예금주명 초기화
	sz_CheckAccountOK = "N" '계좌변경시 타행계좌실명조회 다시해야함
End Sub
'============================================================================

Sub btnName_OnClick() '오픈뱅킹_타행계좌실명조회

	if Trim(g_szCom) == "" then
		Form.ShowAlert("알림", "금융기관을 선택하세요.")
		Exit Sub
	end if
	
	if Trim(edtAcnt.caption) == "" then
		Form.ShowAlert("알림", "계좌번호를 입력하세요.")
		Exit Sub
	end if
	
	for i = 0 to Grid0.rowcount - 1
		tmp_bank_code = Grid0.GetCellData("bd_cell0", i)
		tmp_bank_name = Grid0.GetCellData("bd_cell2", i)
		
		if g_szCom == tmp_bank_code and tmp_bank_name == edtAcnt.caption then
			Form.ShowAlert("알림", "이미 등록된 계좌입니다.")
			g_szCom  		= ""
			edtAcnt.caption	= ""
			edtBank.caption   = ""
			
	
			Exit Sub
		end if
	next
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_002r", "InBlock1", "ELFN_ID"  , 0, sUserID )
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_002r", "InBlock1", "BANK_CODE", 0, g_szCom	)
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_002r", "InBlock1", "BANK_ACNO", 0, edtAcnt.caption	)
	
	DATAMANAGER.RequestTranData( "obtss_opnf_002r" )
End Sub

'============================================================================

Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "obtss_opnf_002r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if szSubErr ="" then
			Form.ShowAlert( "알림", szErrMsg )
		else
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		end if
	 
		'szSubErr = DATAMANAGER.GetDataValue (0, "obtss_opnf_002r", "OutBlock1", "API_RSPN_MSG"		, 0 )
		'Form.ShowAlert( "알림", szSubErr )
		'Form.ShowAlert( "알림", szErrMsg )
		 
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtss_opnf_002r" then
	
		AcntClsName.caption = DATAMANAGER.GetDataValue (0, "obtss_opnf_002r", "OutBlock1", "ACNT_CLS_NAME"		, 0 )
		
		tmp_acnt_cls_code = DATAMANAGER.GetDataValue (0, "obtss_opnf_002r", "OutBlock1", "ACNT_CLS_CODE"		, 0 )
		if tmp_acnt_cls_code ="1" then 		AcntClsCode.caption = "수시입출금"
		elseif tmp_acnt_cls_code ="2" then 	AcntClsCode.caption = "예적금"
		elseif tmp_acnt_cls_code ="3" then	AcntClsCode.caption = "신탁"
		elseif tmp_acnt_cls_code ="4" then	AcntClsCode.caption = "당좌예금"
		elseif tmp_acnt_cls_code ="5" then	AcntClsCode.caption = "외화예금"
		elseif tmp_acnt_cls_code ="A" then	AcntClsCode.caption = "개인연금저축"
		elseif tmp_acnt_cls_code ="6" then	AcntClsCode.caption = "ISA"
		elseif tmp_acnt_cls_code ="7" then	AcntClsCode.caption = "펀드"
		elseif tmp_acnt_cls_code ="8" then	AcntClsCode.caption = "미교부국민주"
		elseif tmp_acnt_cls_code ="9" then	AcntClsCode.caption = "미지급출자금"
		elseif tmp_acnt_cls_code ="0" then	AcntClsCode.caption = "미지급배당금"
		elseif tmp_acnt_cls_code ="Z" then	AcntClsCode.caption = "금투사계좌"
		end if
		
		Form.ShowAlert("알림", "계좌 조회가 완료되었습니다.")
		sz_CheckAccountOK = "Y"
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "오픈뱅킹기관" then
		If sRet <> "" then
			tData1 = Split(sRet, "★")
			edtBank.caption = tData1(1)
			g_szCom = tData1(0)
		End If
		
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'등록
			Setpass()
		end if
		
     ElseIf sKeyName == "mhetc90060_px" Then 'v001
         If sRet == "ok" Then
	         Setpass()
	     End If
	
	elseif sKeyName == "mbbnk62005_end" then 
			if sRet = "1" then
				Form.CloseForm()		'첫페이지(ID등록)로 이동
			end if
	End if
End Sub
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbnk62004_end" ,  "1" )
End Sub
'============================================================================
Sub btnOK_OnClick()
		'sz_CheckAccountOK = "Y"
		'g_szCom ="287"
		'edtBank.caption = "국민은행" 
		'edtAcnt.caption = "36270204109854"
		
	if g_szCom ="" then
		Form.ShowAlert("알림", "금융 기관을 선택하세요.")
		Exit Sub
	end if
	
	if edtAcnt.caption ="" then
		Form.ShowAlert("알림", "계좌번호를 입력하세요.")
		Exit Sub
	end if
	
	if sz_CheckAccountOK ~= "Y" then
		Form.ShowAlert("알림", "계좌 조회가 완료되지 않았습니다.")
		Exit Sub
	end if
	
	if g_szCertUserType == "1" Or g_szCertUserType == 1 Then '간편인증 v001
	    Form.OpenFramePopup( "mhetc90060_px" , "" , mhetc90060_px)		'간편인증
	Else
	    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
	End If
	
End Sub

Function Setpass()
	'전체건수★이메일★CIKEY★(계좌구분명★예금명★금융기관코드★금융기관명★계좌번호★예금주명)
	
	g_szData = "1" &"★"& sz_email &"★"& g_CiKey  &"★"& AcntClsName.caption&"★"& " " &"★"& g_szCom &"★"& edtBank.caption  &"★"& edtAcnt.caption &"★"& achoName.caption 
	Form.OpenFramePopup( "mbbnk62005" , g_szData , sPosInfo) 
	'Form.CloseForm()		'첫페이지(ID등록)로 이동
End Function

