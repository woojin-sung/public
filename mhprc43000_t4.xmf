	<SCRIPT_INFO _len="4034" _ulen="3686" >
'============================================================================
' 01. 화 면 명 : 탭_프로그램
' 02. 화면설명 : 투자자동향 프로그램 테이블
' 03. 작    성 : 2016. 01. 06.	유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nMarket	'라디오 버튼 구분에 사용할 변수
Dim g_nReal	'실시간 업종구분코드
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
'	rdo0_OnClick(nIndex) : 코스피, 코스닥 선택 라디오 버튼 클릭시 이벤트
'============================================================================
Sub rdo0_OnClick(nIndex)
	'TR 초기화
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1531_001r" )
	DATAMANAGER.CancelRealData( "ohhts_nmix_pgm" )
	
	if nIndex == 0 then	'0이면 코스피, 1이면 코스닥
		g_nMarket = "K"
		g_nReal = "KGG01P"	'22년 차세대 업종코드 하드코딩
	else
		g_nMarket = "Q"
		g_nReal = "QGG01P"	'22년 차세대 업종코드 하드코딩
	end if
	
	'TR 연결
	DATAMANAGER.SetDataValue( 0 , "ohhts_1531_001r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , g_nMarket )
		
	DATAMANAGER.RequestTranData( "ohhts_1531_001r" )
	
End Sub

'============================================================================
'	rdo1_OnClick(nIndex) : 금액, 수량 선택 라디오 버튼 클릭시 이벤트
'============================================================================
Sub rdo1_OnClick(nIndex)
	'TR 초기화
	DATAMANAGER.ClearTranConnectedCtrl( "ohhts_1531_001r" )
	DATAMANAGER.CancelRealData( "ohhts_nmix_pgm" )
	
	'0이면 금액, 1이면 수량
	if nIndex == 0 then
		tbl0.visible = True
		tbl1.visible = False
	else
		tbl0.visible = False
		tbl1.visible = True
	end if
	
	DATAMANAGER.SetDataValue( 0 , "ohhts_1531_001r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , g_nMarket )
		
	DATAMANAGER.RequestTranData( "ohhts_1531_001r" )
	
End Sub

'============================================================================
'	Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_nMarket = "K"	'초기화면값 제공
	g_nReal = "KGG01P"	'22년 차세대 업종코드 하드코딩
	
	tbl1.visible = False	'초기화면에 따른 tbl1 숨김설정
	
	'TR 연결
	DATAMANAGER.SetDataValue( 0 , "ohhts_1531_001r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , g_nMarket )
		
	DATAMANAGER.RequestTranData( "ohhts_1531_001r" )

End Sub


'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	'실시간 TR 연결
	if szTranID == "ohhts_nmix_pgm" then
		DATAMANAGER.SetDataValue( 1 , "ohhts_nmix_pgm", "InBlock1", "FIDR_BSTP_CLS_CODE" , 0 , g_nReal)
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_1531_001r" then
		DATAMANAGER.RequestRealData( "ohhts_nmix_pgm" )
	end if
	
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "RECEIVE" then
		Form_OnFormInit()
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	Form_OnFormInit()
	
End Sub

