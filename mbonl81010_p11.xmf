'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 적정성팜단보고서
' 02. 화면설명 : 고객투자성향진단_고위험거래가입팝업
' 03. 작    성 : 2021.06.16 김인택
' 04. 수    정 : 
' 2021.12.27 : 김수진 : v007 : K-OTC 거래신청 추가
' 2023.07.04 : 양현정 : v008 : 발행어음 추가
' 2024.07.29 : 정우희 : v009 : 정기입금이체 약정 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

dim	g_szAcno		'계좌번호
dim	g_szAsno		'계좌일련번호
dim	g_szBswr		'KYC업무분류코드(KYC_BSWR_DIV_COE)
dim	g_szDiv		'업무분류코드(BSWR_DIV_CODE)
dim	g_szISCD		'종목코드
dim	g_szAlertTitle	'알림타이틀
Dim g_szScrNo 	'호출한 화면번호

Dim g_szRetData 
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 		'KYC상품등급코드
Dim g_szKYC_DVPD_EPMD_CODE 		'KYC파생상품유의코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szDVPD_GRAD_CODE 			'파생상품등급코드
Dim g_szKYC_INVT_RCMD_CLS_CODE       'KYC투자권유구분코드 

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setGlobalItems(szInput)


	g_szScrNo	=	getListItem(szInput, 0)
	g_szAcno	=	getListItem(szInput, 1)
	g_szAsno	=	getListItem(szInput, 2)
	g_szBswr	=	getListItem(szInput, 3)
	g_szDiv	=	getListItem(szInput, 4)
	g_szISCD	=	getListItem(szInput, 5)


	g_szKYC_INVT_INCL_GRAD_CODE 	=	getListItem(szInput, 6)
	g_szKYC_PROD_GRAD_CODE 		=	getListItem(szInput, 7)
	g_szKYC_DVPD_EPMD_CODE 		=	getListItem(szInput, 8)
	g_szKYC_DRVT_PROS_YN 		=	getListItem(szInput, 9)
	g_szDVPD_GRAD_CODE 			=	getListItem(szInput, 10)
	g_szDVPD_GRAD_CODE 			=	getListItem(szInput, 10)

End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_sRetData = "CANCEL"
	szLinkedData = Form.GetOpenLinkData( )
	
	Form.SetScreenName("투자성상품 적정성 판단 보고서(부적정)")


	if szLinkedData = "" then
		Form.ShowAlert(g_szAlertTitle, "입력값이 없습니다.")
	else
		setGlobalItems(szLinkedData)
	end if 
'g_szScrNo	=	"51000"
'g_szAcno	=	"12341234"
'g_szAsno	=	"01"
'
'g_szKYC_INVT_INCL_GRAD_CODE 	=	"03"
'g_szKYC_PROD_GRAD_CODE 		=	"01"
'g_szKYC_DVPD_EPMD_CODE 		=	"01"
'g_szKYC_DRVT_PROS_YN 		=	"Y"
'g_szDVPD_GRAD_CODE 			=	"1"

	'신용계좌개설,	펀드매매,	ELS/DLS청약,   온라인계좌개설 (종합매매), 공모주청약-주식 v002
	'CME/EUREX 약정 추가 v003
	'해외주식, 해외파생ETF 약정 추가 v004
	'CMA유형전환 추가 v008
	'해외(주식.ETP)거래 화면번호 변경 (87051 > 87057)
	'v009 51020 정기이체입금약정 추가
	if g_szScrNo == "82010" or	g_szScrNo == "51000" or g_szScrNo == "53000" or  g_szScrNo == "84010" or g_szScrNo == "83110" or g_szScrNo == "87040_t1" or g_szScrNo == "87040_t2" or g_szScrNo == "87050" or g_szScrNo == "87051" or g_szScrNo == "89030" or g_szScrNo == "87052_2" or g_szScrNo == "87052_3" or g_szScrNo == "87057_1" or g_szScrNo == "87057_2" or g_szScrNo == "87057_3" or g_szScrNo == "51020" then

		sName = Form.GetSharedData("&USER_NAME", false )
			
		szGRAD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_INVT_INCL_GRAD_CODE)
		szKYC_GRAD_NAME 	= Form.GetMetaData("KYC투자성향등급코드", g_szKYC_INVT_INCL_GRAD_CODE)
		szPROD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_PROD_GRAD_CODE)
		szKYC_PROD_NAME 	= Form.GetMetaData("KYC상품등급코드", g_szKYC_PROD_GRAD_CODE)
		
		Container0.tbl01.SetCellString( 1, 1, g_szAcno & g_szAsno)
		Container0.tbl01.SetCellString( 1, 4, sName )
		Container0.tbl01.SetCellString( 4, 0, CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급 ".."("..szKYC_GRAD_NAME..")" )
		Container0.tbl01.SetCellString( 4, 4, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
		
		
		if	g_szScrNo	=	"82010"	then
			szProdName	=	"신용계좌개설"
		'v009
		elseif	g_szScrNo	=	"51000" or g_szScrNo	=	"51020"	then 
			szProdName	=	"펀드매매"
		elseif	g_szScrNo	=	"53000"	then
			szProdName	=	"ELS/DLS청약"
		elseif	g_szScrNo	=	"84010"	then
			'szProdName	=	"온라인계좌개설"   '종합매매계좌 개설 시 부적합 징구는 주식매매로 징구함 v002	
			szProdName	=	"주식 매매"   
		elseif   g_szScrNo	=	"83110"	then '공모주청약-주식 v002	
		     szProdName	=	"주식 매매"
		elseif   g_szScrNo	=	"87040_t1"	then 'CME 야간거래 v003	
		     szProdName	=	"CME 야간거래"
		elseif   g_szScrNo	=	"87040_t2"	then 'EUREX 야간거래 v003	
		     szProdName	=	"EUREX 야간거래"
		elseif   g_szScrNo	=	"87050"	or g_szScrNo == "87052_2" or g_szScrNo == "87052_3" then '해외파생ETF 약정 v004
		     szProdName	=	"해외ETP 거래"	
		elseif   g_szScrNo	=	"87051"	then '해외주식 약정 v004
		     szProdName	=	"해외주식 거래"	
		'2023.05.23  해외주식/ETP 거래신청--------------------------------------------------------------------------------------  
		elseif  g_szScrNo	=	"87057_1" or g_szScrNo == "87057_2" or g_szScrNo == "87057_3"  then ''해외(주식.ETP)거래 약정
		     szProdName	=	"해외(주식.ETP)거래"
		'-----------------------------------------------------------------------------------------------------------------------     
		elseif   g_szScrNo	=	"89030"	then 'v008 CMA계좌
		     szProdName	=	"CMA계좌"			     
		else
			szProdName	=	" "
		end if
		
		Container0.tbl01.SetCellString( 4, 2, szProdName )			
		'적정성보고서
		Container0.Table1.SetCellString( 1, 1, sName )
		Container0.Table1.SetCellString( 1, 3, g_szAcno & g_szAsno)
		Container0.Table1.SetCellString( 2, 1, szProdName )
		Container0.Table1.SetCellString( 2, 3, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
'		Container0.Table2.SetCellString( 6, 1, CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급 ".."("..szKYC_GRAD_NAME..")" )
		Container0.Table2.SetCellString( 6, 1, szKYC_GRAD_NAME )

	'ELW/ETF/ETN/ELS
	'v005 변동성ETN거래신청 약정 추가 (g_szScrNo="88021")
	'v007 K-OTC 거래신청 추가 (g_szScrNo="88050")
	elseif g_szScrNo == "88010" or	g_szScrNo == "88000" or g_szScrNo == "88020" or g_szScrNo == "53000" or g_szScrNo == "88021" or g_szScrNo == "88050" then 'ETN거래신청
		sName = Form.GetSharedData("&USER_NAME", false )
		
	
		szGRAD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_INVT_INCL_GRAD_CODE)
		szKYC_GRAD_NAME 	= Form.GetMetaData("KYC투자성향등급코드", g_szKYC_INVT_INCL_GRAD_CODE)
		szPROD_NAME 		= Form.GetMetaData("상품등급코드", g_szKYC_PROD_GRAD_CODE)
		szKYC_PROD_NAME 	= Form.GetMetaData("KYC상품등급코드", g_szKYC_PROD_GRAD_CODE)
		
		Container0.tbl01.SetCellString( 1, 1, g_szAcno )
		Container0.tbl01.SetCellMaskInfo( 1, 1, "1,0,,,1,####-####,0,1,1" )
		Container0.tbl01.SetCellString( 1, 4, sName )
		Container0.tbl01.SetCellString( 4, 0, CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급 ".."("..szKYC_GRAD_NAME..")" )
		Container0.tbl01.SetCellString( 4, 4, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
		
		if	g_szScrNo	=	"88010"	then
			szProdName	=	"ELW거래신청"
		elseif	g_szScrNo	=	"88000"	then
			szProdName	=	"파생상품ETF 거래신청"  'v006
		elseif	g_szScrNo	=	"88020"	then
			szProdName	=	"ETN거래신청"
		elseif	g_szScrNo	=	"53000"	then
			szProdName	=	"ELS/DLS청약"
		'v005 변동성ETN거래신청
		elseif	g_szScrNo	=	"88021"	then
			szProdName	=	"변동성ETN거래신청"
		'v007 K-OTC 거래신청
		elseif	g_szScrNo	=	"88050"	then
			szProdName	=	"K-OTC 거래신청"	
		else
			szProdName	=	" "
		end if
		
		Container0.tbl01.SetCellString( 4, 2, szProdName )
		'적정성보고서
		Container0.Table1.SetCellString( 1, 1, sName )
		Container0.Table1.SetCellString( 1, 3, g_szAcno & g_szAsno)
		Container0.Table1.SetCellString( 2, 1, szProdName )
		Container0.Table1.SetCellString( 2, 3, CInt(g_szKYC_PROD_GRAD_CODE).."등급 ".."("..szPROD_NAME..")" )
'		Container0.Table2.SetCellString( 6, 1, CInt(g_szKYC_INVT_INCL_GRAD_CODE).."등급 ".."("..szKYC_GRAD_NAME..")" )
		Container0.Table2.SetCellString( 6, 1, szKYC_GRAD_NAME )
	end if
End Sub


'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	if Container0.ChkButton0.chksilence == "0"  then
		Form.MsgBox( g_szAlertTitle, "내용을 확인해 주세요.(투자성상품 적정성 판단 보고서)", "", 6 )
		Exit Sub
	end if

	g_sRetData = "OK"
	Form.CloseForm()
End Sub


'============================================================================
'btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	g_sRetData	=	"CANCEL"
	Form.SendReturnToParent("mbonl81010_p11" , g_sRetData)

	Form.CloseForm()
End Sub


