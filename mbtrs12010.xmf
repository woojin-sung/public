'============================================================================
'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
'============================================================================
' Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub

'============================================================================
'PENTA13 START => 2024.04.15(호가주문수량저장)
Sub CheckItemCodeQty(szCode)
	Dim sEnvKey, sItemQty, sItemCode
	
	sEnvKey = "hogaord.save_itemqty"
	sItemQty = Form.GetEnvData(sEnvKey)
	
	if sItemQty <> null and sItemQty <> "" then
		tData = Split(sItemQty, "★")

		if UBOUND(tData) > 0 then
			sSaveItemCode = tData(0)
			sSaveQty      = tData(1)
			sSaveQtyFlag  = tData(2)
			
			sItemCode = ChangeOrderItemCode(szCode)
			
			if sItemCode <> null and sItemCode <> "" and sItemCode <> sSaveItemCode then
				if sSaveQty <> null and sSaveQty <> "" then
					if CDbl(sSaveQty) >= 0 then		'초기화
						Form.SetEnvData(1, sEnvKey, sItemCode & "★" & "0" & "★" & sSaveQtyFlag)
					end if
				end if
			end if
		end if
	end if
End Sub
'============================================================================
Sub Init_OrderQty(sValue)
	if g_szCd <> null and g_szCd <> "" then
		if g_szCd <> sValue then
			edtQty.caption = ""
		end if
	end if
End Sub
'PENTA13 END

