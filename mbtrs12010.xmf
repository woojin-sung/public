	</CONTROL_INFO>
	<SCRIPT_INFO _len="90976" _ulen="82890" >
' 20200824 LES START 제도개선 (경고구분코드 추가 3:투자유의 / 4: 경고+투자유의 / 5:보류+투자유의)
' 20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
' 20201119 HSZ : 제도개선, 경고구분코드 추가 (추가 : 6.단기과열 7.경고+단기과열 8.보류+단기과열 9.투자경고 a.경고+투자경고 b.보류+투자경고
'											  c.투자위험 d.경고+투자위험 e.보류+투자위험 f.정리매매 g.경고+정리매매 h.보류+정리매매)
' 20240716 HSZ : 버튼텍스트 변경 - 일괄취소 ->매도취소, 매수취소
'============================================================================
' 화 면 명 : 주식호가주문
' 화면설명 : 주식호가주문 메인화면
' 작    성 : 2016.02.25 ~ 2016.  .       ssang
'============================================================================

'	tInfo.OrderNo 		= ""			' 주문번호
'	tInfo.OrgnOrderNo		= ""			' 원주문번호
'	tInfo.OrderQty		= 0			' 주문수량
'	tInfo.LoanDate		= ""			' 대출일
'	tInfo.ChannelCd		= ""			' 채널유형구분코드
'	tInfo.ModCanlCd		= ""			' 정정취소구분코드
'	tInfo.DealCd			= ""			' 매매구분코드
'	tInfo.OrderPrc		= 0			' 주문단가
'	tInfo.CntgPrc			= 0			' 체결단가
'	tInfo.CanlQty			= 0			' 취소수량
'	tinfo.OderAbleQty		= 0			' 주문가능수량
'	tInfo.RemainQty 		= 0			' 미체결수량
'	tInfo.szStatus 		= "0"		' 체결 역전 구분 (0:정상, 1:역전)
	
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCd, g_szMk
g_szCd, g_szMk = "", ""

Dim g_szTitle, g_szSlt
g_szTitle, g_szSlt = "알림", "HOGA"

Dim g_szPrc, g_ModPrc
g_szPrc, g_szModPrc = "", ""

Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szOrder

Dim g_szSelect, g_szMod, g_szCol
g_szSelect, g_szMod, g_szCol = "", "", ""

Dim g_szConfNo
Dim g_szConfQty

Dim g_nHogaRow
g_nHogaRow = 20

'20180810_01 LKM START
'최대주문가능 건수 
Dim g_MaxOrderCount 
g_MaxOrderCount = 30
'20180810_01 LKM END

' Table 관련 ////////////////////////////////////////////////////////////////
Dim g_tOrderTable()		' 주문 정보 리스트 테이블
Dim g_tModCnlTable()		' 정정/취소 리스트 테이블

g_tOrderTable = {}
g_tModCnlTable = {}
' ///////////////////////////////////////////////////////////////////////////

' 20200824 LES START 경고구분코드
Dim gWarnCd
gWarnCd =""

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

'20220425 HWG START : 계좌비밀번호 입력 개선
Dim g_szSavePwd
g_szSavePwd = "0"

'PENTA13 START => 2024.04.15(호가주문수량저장)
Dim g_bSaveOrdQty
g_bSaveOrdQty = false
'PENTA13 END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Request_Multi_Order : 주식복수주문
'============================================================================
Function Request_Multi_Order(szFlag)
	g_szWarnFlag = szFlag
	
	Dim szCd, szCLSCd
	
	' 종목코드
	szCd = Change_ItemCode()

	if g_szOrder == "2" then		' 정정	
		szCLSCd = "103"
	elseif g_szOrder == "3" then		' 취소
		szCLSCd = "104"	
	end if
	
	DATAMANAGER.ClearInputData(0, "obtrs_oder_107a")
	
	For i = 0 to #g_tModCnlTable - 1
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ACNO",                i, acnt.total)			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ASNO",                i, acnt.sequence)		' 계좌일련번호(2)
		
		'20200910 SWJ START : MTS 메모리평문제거
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ACNT_PWD",            i, edtPwd.caption)		' 계좌 비밀번호
		'MTS메모리평문 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ACNT_PWD",            i, edtPwd.encdata)		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ISCD",                i, szCd)				' 종목코드
		
		if g_szOrder == "2" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ODER_UNPR",           i, g_szModPrc)			' 주문단가
		end if
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ODQT",                i, g_tModCnlTable[i].OrderQty)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ODER_CLS_CODE",       i, "01")
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ODER_COND_CLS_CODE",  i, "0")
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ORGL_ODER_NO",        i, g_tModCnlTable[i].OrderNo)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "WHOL_RCTF_CNCL_YN",   i, "Y")
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "WARN_CNFR_YN",        i, g_szWarnFlag)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "SVC_CLS_CODE",        i, szCLSCd)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "ODER_OCRN_TYPE_CODE", i, "06")
		'DATAMANAGER.SetDataValue(0, "obtrs_oder_107a", "InBlock2", "PROS_SRNO",           i, )
	Next
	
	DATAMANAGER.RequestTranData("obtrs_oder_107a")
End Function

'============================================================================
' Request_Cash_Order : 주식현금주문
'============================================================================
Function Request_Cash_Order(szFlag)
	g_szWarnFlag = szFlag

	Dim szCd, szCLSCd
	
	' 종목코드
	szCd = Change_ItemCode()

	if g_szOrder == "0" then			' 현금매수
		szCLSCd = "102"
	elseif g_szOrder == "1" then		' 현금매도
		szCLSCd = "101"
	elseif g_szOrder == "2" then		' 정정	
		szCLSCd = "103"
	elseif g_szOrder == "3" then		' 취소
		szCLSCd = "104"	
	end if
	
	DATAMANAGER.ClearInputData(0, "obtrs_oder_101a")

	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNO"				 , 0, acnt.total)			' 계좌번호(8)
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ASNO"				 , 0, acnt.sequence)		' 계좌일련번호(2)
	
	'20200910 SWJ START : MTS 메모리평문제거
	'MTS메모리평문 적용상태일 때
	if plain_rm == "1" then
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD",         0, edtPwd.caption)		' 계좌 비밀번호
	'MTS메모리평문 미적용상태일 때
	else
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD",         0, edtPwd.encdata)		' 계좌 비밀번호
	end if
	'20200910 SWJ END

	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ISCD"				 , 0, szCd)				' 종목코드
	
	if g_szOrder == "0" or g_szOrder == "1" then		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_UNPR"         , 0, g_szPrc)			' 주문단가
	elseif g_szOrder == "2" then
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_UNPR"         , 0, g_szModPrc)			' 주문단가
	end if
	
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODQT"				 , 0, edtQty.caption)		' 주문수량
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_CLS_CODE"		 , 0, "01")				' 주문구분코드(지정가)
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	 , 0, "0")				' 주문조건구분코드

	if g_szOrder == "2" or g_szOrder == "3" then		' 정정, 취소시
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ORGL_ODER_NO"      , 0, g_szConfNo)			' 원주문번호
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WHOL_RCTF_CNCL_YN" , 0, "Y")				' 잔량전부 여부
	end if
	
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WARN_CNFR_YN"		 , 0, g_szWarnFlag)		' 경고확인여부
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "SVC_CLS_CODE"		 , 0, szCLSCd)			' 서비스 구분 코드
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "PGM_ASPR_DCLR_CLS_CODE", 0, "0")				' 프로그램호가신고구분코드
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"	 , 0, "01")				' 주문발생유형코드(01:일반주문)
	
	DATAMANAGER.RequestTranData("obtrs_oder_101a")
End Function

'============================================================================
' Request_Credit_Order : 주식신용주문
'============================================================================
Function Request_Credit_Order(szFlag)
	Dim szCd, szCLSCd, szLoanDate, szLoanCd, szLoanSrno
	
	g_szWarnFlag = szFlag
	szCd = Change_ItemCode()			' 종목코드

	if g_szOrder == "0" then			' 매수
		szCLSCd, szLoanDate, szLoanSrno = "202", "", "1"
		
		' ----------------------------------------------------------------------
		' 주식 신용 매수주문
		' ----------------------------------------------------------------------	
		DATAMANAGER.ClearInputData(0, "obtrs_oder_201a")	
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNO"				, 0, acnt.total)			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ASNO"				, 0, acnt.sequence)		' 계좌일련번호(2)
		
		'20200910 SWJ START : MTS 메모리평문제거
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNT_PWD",            0, edtPwd.caption)		' 계좌 비밀번호
		'MTS메모리평문 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNT_PWD",            0, edtPwd.encdata)		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ISCD" 				, 0, szCd)				' 종목코드 
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_CLS_CODE" 		, 0, "01")				' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")				' 주문조건구분코드		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODQT" 				, 0, edtQty.caption)		' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_UNPR" 			, 0, g_szPrc)				' 주문가격
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, "01")				' 신용구분
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_DATE" 			, 0, "")	 				' 대출일자
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd)				' 서비스구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")				' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, "")					' 채널유형구분
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_SRNO" 			, 0, szLoanSrno)			' 대출일련번호
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, "N")				' 전체금액상환여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag)		' 경고확인여부
		
		DATAMANAGER.RequestTranData("obtrs_oder_201a")		' 신용주문		
	elseif g_szOrder == "1" then		' 매도
		if chkCredit.checkstate == "1" then	' 신용합산
			szLoanDate = ""
			
			if cmbCredit.currentindex == "2" then	' 예탁담보
				szCLSCd = "203"
			else									' 신용융자(자기융자/유통융자)
				szCLSCd = "201"
			end if
		else
			szLoanDate = cldCredit.caption
			
			if cmbCredit.currentindex == "1" then	' 예탁담보
				szCLSCd = "203"
'				szLoanCd = "0201"
			else									' 신용융자
				szCLSCd = "201"
'				szLoanCd = "0102"
			end if
		end if
		
			szKey = cmbCredit.cbkeydata
	
		'20190409 HWG START : 대출일련번호 세팅로직 불필요
		'if szKey = "01" or szKey = "05" or szKey = "06" then
		'	g_szLoanSrno = "1"
		'else
		'	g_szLoanSrno = ""
		'end if
		'20190409 HWG END
			
		' ----------------------------------------------------------------------
		' 주식 신용합산 매도주문
		' ----------------------------------------------------------------------	
		if chkCredit.checkstate == "1" then
			DATAMANAGER.ClearInputData(0, "obtrs_oder_211a")
			
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ACNO"				, 0, acnt.total)			' 계좌번호(8)
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ASNO"				, 0, acnt.sequence)		' 계좌일련번호(2)
			
			'20200910 SWJ START : MTS 메모리평문제거
			'MTS메모리평문 적용상태일 때
			if plain_rm == "1" then
				DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ACNT_PWD",            0, edtPwd.caption)		' 계좌 비밀번호
			'MTS메모리평문 미적용상태일 때
			else
				DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ACNT_PWD",            0, edtPwd.encdata)		' 계좌 비밀번호
			end if
			'20200910 SWJ END
			
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ISCD" 				, 0, szCd)				' 종목코드
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_CLS_CODE" 		, 0, "01")				' 주문구분코드
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")				' 주문조건구분코드		
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODQT" 				, 0, edtQty.caption)		' 주문수량
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_UNPR" 			, 0, g_szPrc)				' 주문가격
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, cmbCredit.cbkeydata)	' 신용구분
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "LOAN_DATE" 			, 0, szLoanDate)	 		' 대출일자
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd)				' 서비스구분코드
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")				' 주문발생유형코드 01:일반주문
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, "")					' 채널유형구분
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "LOAN_SRNO" 			, 0, g_szLoanSrno)		' 대출일련번호	'20190409 HWG : 대출일련번호 세팅로직 불필요(잔고연동)
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, "N")				' 전체금액상환여부
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag)		' 경고확인여부
			
			DATAMANAGER.RequestTranData("obtrs_oder_211a")		' 신용합산주문
		else
		' ----------------------------------------------------------------------
		' 주식 신용 매도주문
		' ----------------------------------------------------------------------	
			DATAMANAGER.ClearInputData(0, "obtrs_oder_201a")	
			
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNO"				, 0, acnt.total)			' 계좌번호(8)
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ASNO"				, 0, acnt.sequence)		' 계좌일련번호(2)
			
			'20200910 SWJ START : MTS 메모리평문제거
			'MTS메모리평문 적용상태일 때
			if plain_rm == "1" then
				DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNT_PWD",            0, edtPwd.caption)		' 계좌 비밀번호
			'MTS메모리평문 미적용상태일 때
			else
				DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNT_PWD",            0, edtPwd.encdata)		' 계좌 비밀번호
			end if
			'20200910 SWJ END
			
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ISCD" 				, 0, szCd)				' 종목코드 
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_CLS_CODE" 		, 0, "01")				' 주문구분코드
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")				' 주문조건구분코드		
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODQT" 				, 0, edtQty.caption)		' 주문수량
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_UNPR" 			, 0, g_szPrc)				' 주문가격
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, cmbCredit.cbkeydata)	' 신용구분
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_DATE" 			, 0, szLoanDate)	 		' 대출일자
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd)				' 서비스구분코드
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")				' 주문발생유형코드(01:일반주문)
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, "")					' 채널유형구분
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_SRNO" 			, 0, g_szLoanSrno)		' 대출일련번호	'20190409 HWG : 대출일련번호 세팅로직 불필요(잔고연동)
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, "N")				' 전체금액상환여부
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag)		' 경고확인여부
			
			DATAMANAGER.RequestTranData("obtrs_oder_201a")		' 신용주문		
		end if		
	elseif g_szOrder == "2" or g_szOrder == "3" then		' 정정, 취소
		Exit Function
	end if
End Function

'============================================================================
' Change_HOGA_Request
'============================================================================
Function Change_HOGA_Request(szCd, szType)
	if szCd <> g_szCd then
		g_szCd = szCd
			
		Request_Hoga()
		return ""
	else
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")		' 미체결내역 조회
	end if
End Function

'============================================================================
' Request_Hoga
'============================================================================
Function Request_Hoga()
'	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_incg") '20220216 HSZ 시세속도 개선
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_aspr")
	DATAMANAGER.CancelRealData("ohhts_elw_aspr")
	DATAMANAGER.CancelRealData("ohhts_cntg_infr")
	DATAMANAGER.CancelRealData("ohhts_cntg_rslt")
	
	'20180730 LES START - KOTC시장 추가
	DATAMANAGER.CancelRealData("ohhrs_frbr_cntg")
	DATAMANAGER.CancelRealData("ohhts_frbr_aspr")
	'20180730 LES END
	
	

	DATAMANAGER.RequestTranData("ohhts_2030_001r")		' 현재가(마우스주문호가)	
	DATAMANAGER.RequestTranData("ohhts_1001_001r")		' 현재가 : 호가단위를 위해 조회	
End Function

'============================================================================
' Return_Change_ItemCode : 다른화면에서 리턴된 종목코드 확인
'============================================================================
Function Return_Change_ItemCode(szCd)
	Dim szCutCd, szMk
	' 플랫폼에 종목코드변경 요청
	szCutCd = Mid(szCd, 2, Len(szCd))
	szMk = Form.GetItemCodeInfo(szCutCd, "market")
	
	' 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
	Select Case szMk
		Case "J", "T", "W"
			Form.SetItemCode(szCutCd)
		Case else
			if Left(szCd, 1, 1) == "A" then
				Form.SetItemCode(szCutCd)
			else
				Form.SetItemCode(szCd)
			end if
	End Select
End Function

'============================================================================
' Change_ItemCode
'============================================================================
Function Change_ItemCode()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")

	if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
		return g_szCd
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & g_szCd
	elseif szMk = "W" then	'ELW
		return "J" & g_szCd
	else
		return g_szCd
	end if 
End Function

'============================================================================
' Open_Popup : 팝업오픈관련 함수
'============================================================================
Function Open_Popup(szGbn)
	if szGbn == "BALANCE" then
		' 계좌번호(8), 계좌일련번호(2), 탭구분, 주문구분(0:일반주문, 1:예약주문, 2:호가주문), 신용합산구분
		Form.OpenFramePopup("mbtrs12000_pb", acnt.total & "★" & acnt.sequence & "★1★2★" & chkCredit.checkstate, "")
	elseif szGbn == "MICHE" then
		' 계좌번호(8), 계좌일련번호(2), 탭구분, 주문구분(0:일반주문, 1:예약주문, 2:호가주문)
		Form.OpenFramePopup("mbtrs12000_pa", acnt.total & "★" & acnt.sequence & "★0★2", "")
	elseif szGbn == "ETCBUY" then
		Form.OpenPopup("mbtrs12010_p3" , "0★" & lblHyun.caption & "★" & lblHigh.caption & "★" & lblLow.caption & "★" & lblStd.caption & "★" & lblUnit.caption & "★" & g_szMk , "")
	elseif szGbn == "ETCSELL" then
		Form.OpenPopup("mbtrs12010_p3" , "1★" & lblHyun.caption & "★" & lblHigh.caption & "★" & lblLow.caption & "★" & lblStd.caption & "★" & lblUnit.caption & "★" & g_szMk , "")
	end if
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Len(acnt.caption) < 10 then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	end if
	
	if Trim(edtPwd.caption) = "" then
		Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
		return False
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if nGbn <> 1 then
		if g_szOrder == "0" or g_szOrder == "1" or g_szOrder == "2" then
			if Trim(g_szPrc) == "" or Trim(g_szPrc) == "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if
		end if	
	end if
	
	if nGbn <> 2 then
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if	
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData, szGbn

	szGbn = rdoGbn.currentindex
	
	szData = g_szOrder											' 매매구분(0매수, 1매도)
	szData = szData & "|" & g_szMk									' 시장구분
	szData = szData & "|" & acnt.caption								' 계좌번호
	szData = szData & "|" & acnt.accountname							' 계좌명
	szData = szData & "|" & g_szCd									' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")		' 종목명
	szData = szData & "|" & "지정가"								' 주문구분
	
	
	if g_szOrder == "0" or g_szOrder == "1" then		' 매수/매도
		szData = szData & "|" & szGbn									' 0현금/1신용
		
		if g_szOrder == "0" then
			szData = szData & "|" & cmbCredit.cbkeydata								' 신용구분
			szData = szData & "|" & ""									' 대출일자	
		else
			szData = szData & "|" & cmbCredit.cbkeydata					' 신용구분
			
			if chkCredit.checkstate == "0" then
				szData = szData & "|" & cldCredit.caption					' 대출일자	
			else
				szData = szData & "|"
			end if
		end if
		
		szData = szData & "|" & edtQty.caption							' 주문수량
		szData = szData & "|" & g_szPrc									' 주문가격
		szData = szData & "|" & ""										' 원주문번호
		szData = szData & "|" & ""										' 전량전부
	else											' 정정/취소
		szData = szData & "|" & ""										' 0현금/1신용
		szData = szData & "|" & ""										' 신용구분
		szData = szData & "|" & ""										' 대출일자	
		szData = szData & "|" & g_szConfQty								' 주문수량
		
		if g_szOrder == "2"  then
			szData = szData & "|" & g_szModPrc
		else
			szData = szData & "|" & ""									' 주문가격
		end if
		
		szData = szData & "|" & _tonumber(g_szConfNo)						' 원주문번호
		szData = szData & "|" & "Y"										' 전량전부
	end if

	if Trim(szWarn) <> "" then											' 경고팝업 오픈
		szData = szData & "|" & szWarn									' 경고메세지
		
		'20200824 LES START 경고구분코드 추가
		szData = szData & "|" & gWarnCd									' 경고구분코드추가
		'20200824 LES END
		
		Form.OpenPopup("mbtrs12020_p8", szData , "")		
	else																' 주문확인팝업 오픈
		if g_szOrder == "0" then
			if szGbn == "0" then
				Form.OpenPopup("mbtrs12020_p2", szData , "")
			elseif szGbn == "1" then
				Form.OpenPopup("mbtrs12020_p3", szData , "")
			end if
		elseif g_szOrder == "1" then
			if szGbn == "0" then
				Form.OpenPopup("mbtrs12020_p4", szData , "")
			elseif szGbn == "1" then
				Form.OpenPopup("mbtrs12020_p5", szData , "")
			end if
		elseif g_szOrder == "2" then
			Form.OpenPopup("mbtrs12020_p6", szData , "")
		elseif g_szOrder == "3" then
			Form.OpenPopup("mbtrs12020_p7", szData , "")
		end if
	end if
End Function

'============================================================================
' InitOrderData
'============================================================================
Function InitOrderData(tInfo)
	tInfo = {}
	
	tInfo.OrderNo 		= ""			' 주문번호
	tInfo.OrgnOrderNo		= ""			' 원주문번호
	tInfo.OrderQty		= 0			' 주문수량
	tInfo.LoanDate		= ""			' 대출일
	tInfo.ChannelCd		= ""			' 채널유형구분코드
	tInfo.ModCanlCd		= ""			' 정정취소구분코드
	tInfo.DealCd			= ""			' 매매구분코드
	tInfo.OrderPrc		= 0			' 주문단가
	tInfo.CntgPrc			= 0			' 체결단가
	tInfo.CanlQty			= 0			' 취소수량
	tinfo.OderAbleQty		= 0			' 주문가능수량
	tInfo.RemainQty 		= 0			' 미체결수량
	tInfo.szStatus 		= "0"		' 체결 역전 구분 (0:정상, 1:역전)	

	return tInfo
End Function

'============================================================================
' InsertOrderTable : 주문테이블에 신규주문 넣기
'============================================================================
Function InsertOrderTable(tOrderData)
	' 테이블에 빈공간이 있으면 그 위치에 insert
	for i=0 to #g_tOrderTable-1	
		if _tonumber(g_tOrderTable[i].OrderNo) == 0 then
			g_tOrderTable[i] = tOrderData
			Exit Function
		
		'NOHES 20160428 : 체결 통보시 주문번호 자릿수 9자리, 응답수신시 주문번호 자릿수 10자리. 
		'숫자형태로 형변환 하여 비교 필요 - Cint 쓰지 말 것.
		elseif _tonumber(g_tOrderTable[i].OrderNo) == _tonumber(tOrderData.OrderNo) then
			' 20160418 : 주문완료조회보다 체결통보 실시간이 먼저들어온 경우
			if tOrderData.szStatus == "2" then
				Exit Function
			end if
			
			if g_tOrderTable[i].szStatus == "1" then				' 통보보다 결과가 먼저 들어온 경우(미체결내역 지울것!)
				' 20160408 왠지 지우는게 아닌거 같음. 그냥 패스하는것이 맞지 않을까?
				'DeleteOrderTable(tOrderData)
				Exit Function
			end if
		end if
	next

	' 테이블에 빈공간이 없으면 맨뒤에 insert
	g_tOrderTable[#g_tOrderTable] = tOrderData	
End Function

'============================================================================
' SetOrderTable : 주문테이블에 값 변경
'============================================================================
Function SetOrderTable(tOrderData)
	Dim nQty
	
	for i=0 to #g_tOrderTable-1
		' 주문내고 바로 미체결리스트에 담기 때문에 항상 존재
		if _tonumber(g_tOrderTable[i].OrderNo) == _tonumber(tOrderData.OrderNo) then		
			' 최종미체결수량 = 기존의 미체결수량 - 체결수량(체결결과는 체결수량이 내려옴) : 20160324
			nQty = _tonumber(g_tOrderTable[i].RemainQty) - _tonumber(tOrderData.RemainQty)

			if nQty == 0 then						' 미체결이 클리어상태
				DeleteOrderTable(tOrderData)
				return
			end if
			
			' 그외는 미체결상태
			tOrderData.RemainQty = nQty
			g_tOrderTable[i] = tOrderData
			return
			'end if
		end if
	next

' 20160418 : g_tOrderTable[i].szStatus == "2" 주문내고 바로 미체결내역 보여주기 한 상태 추가
'	Dim nQty
'	
'	for i=0 to #g_tOrderTable-1
'		' 주문내고 바로 미체결리스트에 담기 때문에 항상 존재
'		if _tonumber(g_tOrderTable[i].OrderNo) == _tonumber(tOrderData.OrderNo) then		
'			' 최종미체결수량 = 기존의 미체결수량 - 체결수량(체결결과는 체결수량이 내려옴) : 20160324
'			if g_tOrderTable[i].szStatus == "2" then		' 주문내고 바로 미체결내역 보여주기 한 상태
'				nQty = _tonumber(tOrderData.RemainQty)
'				tOrderData.szStatus = "1"
'			else
'				nQty = _tonumber(g_tOrderTable[i].RemainQty) - _tonumber(tOrderData.RemainQty)
'				
'				if nQty == 0 then						' 미체결이 클리어상태
'					DeleteOrderTable(tOrderData)
'					return 1
'				end if
'			end if
'			
'			' 그외는 미체결상태
'			tOrderData.RemainQty = nQty
'			g_tOrderTable[i] = tOrderData
'			return 1
'			'end if
'		end if
'	next
'	
'	return 0
End Function

'============================================================================
' DeleteOrderTable
'============================================================================
Function DeleteOrderTable(tOrderData)
	Dim szOrderNo
	szOrderNo = ""
	
	for i=0 to #g_tOrderTable-1
		if tOrderData.ModCnclCd =="2" or tOrderData.ModCnclCd == "3" then
			szOrderNo = tOrderData.OrgnOrderNo		' 정정, 취소주문은 원주문번호와 비교
		else
			szOrderNo = tOrderData.OrderNo			' 신규주문은 주문번호 비교
			
		end if
		
		if _tonumber(g_tOrderTable[i].OrderNo) == _tonumber(szOrderNo) then
			Dim tData()
			tData = {}
			g_tOrderTable[i] = InitOrderData(tData)	' 해당 주문테이블 공간을 초기화
			return
		end if
	next
End Function

'============================================================================
' Init_Control
'============================================================================
Function Init_Control(nGbn)
	g_szMod, g_szCol = "", ""
	
	contBCncl.left = 1000
	contSCncl.left = 1000
	contHoga.imgDim.left = 1000
	contHoga.imgDim.visible = false
	btnAllSCncl.visible = false
	btnAllBCncl.visible = false
		
	if nGbn <> 2 then	
		Set_Hoga_Mod(1, "")
	end if
		
	if nGbn == 0 then	
		Enable_CreditControl(0)
	end if
End Function

'============================================================================
' _tonumber
'============================================================================
Function _tonumber(szData)
	return tonumber(szData) or 0
End Function

'============================================================================
' Init_OrderArea : 주문영역 초기화
'============================================================================
Function Init_OrderArea()
	tblHoga.SetCellString(0, 0, "")
	tblHoga.SetCellString(0, 4, "")

	For j=0 to g_nHogaRow-1
		contHoga.hogaTbl.SetCellString(j, 0, "")
		contHoga.hogaTbl.SetCellString(j, 4, "")
	Next
End Function

'============================================================================
' 주문 테이블 각 호가별로 저장
'============================================================================
Function SetHogaOrderTable()
	
	Dim szPrice

	Dim szSubSCnt, szSubSQty, szSubBCnt, szSubBQty
	Dim szTotSCnt, szTotSQty, szTotBCnt, szTotBQty	

	szTotSCnt, szTotSQty, szTotBCnt, szTotBQty = 0, 0, 0, 0

	Init_OrderArea()
		
	For i=0 to g_nHogaRow-1
		szPrice = contHoga.hogaTbl.GetCellString(i, 2)
		szSubSCnt, szSubSQty, szSubBCnt, szSubBQty = 0, 0, 0, 0
			
		for j=0 to #g_tOrderTable-1
			if _tonumber(g_tOrderTable[j].OrderPrc) == _tonumber(szPrice) then
				
				if g_tOrderTable[j].DealCd == "1" then				' 매도
					szSubSCnt = szSubSCnt + 1
					szSubSQty = szSubSQty + g_tOrderTable[j].RemainQty
				elseif g_tOrderTable[j].DealCd == "2" then			' 매수
					szSubBCnt = szSubBCnt + 1
					szSubBQty = szSubBQty + g_tOrderTable[j].RemainQty
					
				end if
			end if
			
			if i == 0 then			' 총잔량은 한번만 체크하면 됨	
				if g_tOrderTable[j].DealCd == "1" then				' 매도
					szTotSCnt = szTotSCnt + 1
					szTotSQty = szTotSQty + g_tOrderTable[j].RemainQty
				elseif g_tOrderTable[j].DealCd == "2" then			' 매수
					szTotBCnt = szTotBCnt + 1
					szTotBQty = szTotBQty + g_tOrderTable[j].RemainQty
				end if				
			end if
		next

		if szSubSCnt > 0 then		' 호가별 매도 잔량(건수)
			
			contHoga.hogaTbl.SetCellString(i, 0, szSubSQty .. "(" .. szSubSCnt .. ")")
		else
			contHoga.hogaTbl.SetCellString(i, 0, "")
		end if
		
		if szSubBCnt > 0 then		' 호가별 매수 잔량(건수)
			
			'Form.ShowAlert(i, szSubBQty)
			contHoga.hogaTbl.SetCellString(i, 4, szSubBQty .. "(" .. szSubBCnt .. ")")
		else
			contHoga.hogaTbl.SetCellString(i, 4, "")
		end if
	Next

	if szTotSCnt > 0 then			' 총 매도 잔량(건수)
		tblHoga.SetCellString(0, 0, szTotSQty .. "(" .. szTotSCnt .. ")")
	else
		tblHoga.SetCellString(0, 0, "")
	end if

	if szTotBCnt > 0 then			' 총 매수 잔량(건수)
		tblHoga.SetCellString(0, 4, szTotBQty .. "(" .. szTotBCnt .. ")")
	else
		tblHoga.SetCellString(0, 4, "")
	end if
End Function

'============================================================================
' Init_cmbCredit
'============================================================================
Function Init_cmbCredit(szChk)
	' 20160328 기존에 라디오구분으로 되었던 부분을 합산체크박스로 변경
	Dim szList, szCredit 
	szList, szCredit = "", ""
	
	cmbCredit.currentindex = "0"					' 0으로 변경해야 die안됨
	Form.SetCtlProp("cmbCredit", "clear", "")		' 콤보 리스트 클리어
			
	szCredit = chkCredit.checkstate
	if CStr(szCredit) == "1" then
		szList = "05`자기융자\r\n06`유통융자\r\n03`예탁담보"
		cldCredit.visible = false
	else
		szList = "01`신용융자\r\n03`예탁담보"		
		cldCredit.visible = true
	end if

	cmbCredit.cbinputdatatext = szList
End Function

'============================================================================
' Enable_CreditControl : 현금/신용 변경관련 컨트롤 enable
'============================================================================
Function Enable_CreditControl(nIdx)
	if nIdx == 0 then
		chkCredit.enable = false
		cmbCredit.enable = false
		cldCredit.enable = false
		
		'chkCredit.checkstate = "0"	' 20160324 신용합산의 값은 계속 미변경
		cmbCredit.currentindex = "0"
		cldCredit.caption = Form.GetSharedData("&HOST_DATE", false)
	elseif nIdx == 1 then
		chkCredit.enable = true
		cmbCredit.enable = true
		cldCredit.enable = true
	end if
End Function

'============================================================================
' Change_LinkForm
'============================================================================
Function Change_LinkForm()
	Dim szStyle
	
	szStyle	= Form.LoadConfigData("mhprc11000", "Style")	'현재가 스타일
		
	if szStyle = "0" then
		linkfm.linkfile = "mhprc11000_s1"
	elseif szStyle = "1" then
		linkfm.linkfile = "mhprc11000_s2"
	elseif szStyle = "2" then
		linkfm.linkfile = "mhprc11000_s3"
	else
		linkfm.linkfile = "mhprc11000_s1"
	end if
End Function

'============================================================================
' Set_Hoga_Mod
'============================================================================
Function Set_Hoga_Mod(nGbn, nRow)
	if nGbn == 0 then
		For i = 0 to 19
			if i == nRow then
				g_szSelect = contHoga.hogaTbl.GetCellString(nRow, g_szCol)
			else
				contHoga.hogaTbl.SetCellString(i, g_szCol, "정정")
			end if
		Next
	elseif nGbn == 1 then
		For i = 0 to 19
			contHoga.hogaTbl.SetCellString(i, g_szCol, "")
			g_szSelect = ""
		Next
		
		SetHogaOrderTable()
	elseif nGbn == 2 then		' 호가실시간시
		For i = 0 to 19
			if i == nRow then
				contHoga.hogaTbl.SetCellString(nRow, g_szCol, g_szSelect)
			else
				contHoga.hogaTbl.SetCellString(i, g_szCol, "정정")
			end if
		Next		
	end if
End Function

'============================================================================
' Init_Table : 주문관련 테이블 init(nGbn : 0/계좌변경, 종목변경, 1/주문 후)
'============================================================================
Function Init_Table(nGbn)
	g_szMod = ""
	g_szPrc = ""
	g_szModPrc = ""
	
	g_tModCnlTable = {}
	
	if nGbn == 0 then
		g_tOrderTable = {}
	end if
End Function

'============================================================================
' ConFirm_Reject : 주문거부 체크
'============================================================================
Function ConFirm_Reject(szID)
	Select Case szID
		Case "TTRODP11321", "TTRODP11322", "TTRODP41302", "T904"
			return 0
		Case Else
			return 1
	End Select
End Function

'============================================================================
' Return_BalanceScreen
'============================================================================
Function Return_BalanceScreen(szRet)
	tData = Split(szRet, "♥")
	
	if UBound(tData) > 0 then
		edtQty.caption = tData(0)				' 수량
		
		if Trim(tData(3)) == "0" then
			cldCredit.caption = tData(1)		' 대출일자
		end if

		if Trim(tData(2)) <> "0000" then		' 대출상세
			rdoGbn.currentindex = "1"
			
			chkCredit.checkstate = tData(3)		' 신용합산체크
			
			Init_cmbCredit(tData(3))	

			if Trim(tData(2)) == "0101" or Trim(tData(3)) == "0102" then
				if Trim(tData(3)) == "1" then							' 신용합산
					if Trim(tData(2)) == "0201" then		' 유통융자
						cmbCredit.currentindex = 1
					else									' 자기융자
						cmbCredit.currentindex = 0
					end if					
				else													' 신용일반
					cmbCredit.currentindex = 0
				end if
			elseif Trim(tData(2)) == "0201" or Trim(tData(2)) == "0211" or Trim(tData(2)) == "0401" then
				if Trim(tData(2)) == "0201" or Trim(tData(2)) == "0211" then
					if Trim(tData(3)) == "1" then							' 신용합산
						cmbCredit.currentindex = 2			' 예탁담보
					else													' 신용일반
						cmbCredit.currentindex = 1			' 예탁담보
					end if
				end if
				
				g_szLoanSrno = tData(4)	   '대출일련번호
			
			'20180424 LES START - 유통융자 적용
			elseif Trim(tData(2)) == "0102" then
				if Trim(tData(3)) == "1" then
					cmbCredit.currentindex = 1
				else
					cmbCredit.currentindex = 0
				end if
			'20180424 LES END
			
			end if
		else
			rdoGbn.currentindex = "0"
		end if
	end if
End Function	

'============================================================================
' Select_OrderList : 정정, 취소시 관련주문리스트를 GrdSelect에 담고, 관련 리스트를 주문확인 팝업으로 전송
'============================================================================
Function Select_OrderList(szGbn, szAll)
	Dim szNo, szQty
	Dim tData()
	Dim nChk1, nChk2, nCnt
	
'20180810_01 LKM START
	Dim nOrgCount
	nOrgCount = 0	'실제 요청건수 
'20180810_01 LKM END
	
	szNo, szQty = "", ""
	nChk1, nChk2, nCnt = 0, 0, 0
	
	g_tModCnlTable = {}

	if #g_tOrderTable < 1 then
		Exit Function
	end if
	
	For i = 0 To #g_tOrderTable-1
		tData = {}
		tData = InitOrderData(tData)
		tData = g_tOrderTable[i]
		
		if tData.DealCd == szGbn then		' 1:매도, 2:매수
		
			if szAll == "1" then
				nChk1 = _tonumber(tData.OrderPrc)
				nChk2 = _tonumber(g_szPrc)
			end if
			
			if nChk1 == nChk2 then
			
				'20180810_01 LKM START
				if nCnt < g_MaxOrderCount Then 
				'20180810_01 LKM END
			
					g_tModCnlTable[#g_tModCnlTable] = tData
				
					if nCnt == 0 then
						szNo = tData.OrderNo
						szQty = tData.RemainQty
						
						g_szConfNo = szNo
						g_szConfQty = szQty
					else
						szNo = szNo & "★" & tData.OrderNo
						szQty = szQty & "★" & tData.RemainQty
						
						g_szConfQty = _tonumber(g_szConfQty) + _tonumber(tData.RemainQty)
					end if
				
					nCnt = nCnt + 1
				
				'20180810_01 LKM START
				end if
				
				nOrgCount = nOrgCount+1
				'20180810_01 LKM END
				
			end if
		end if
	Next
		
	if #g_tModCnlTable > 1 then
		g_szConfNo = "999999"
	end if
	
'20180810_01 LKM START
	if nOrgCount > g_MaxOrderCount then
		Form.MsgBox("안내", "일괄 정정/취소 주문가능한 최대건수는 "..g_MaxOrderCount.."건입니다.\n주문완료 후 처리결과를 다시 확인하시기 바랍니다.", "MaxOrdCnt", 6)
	else
		Open_ConfirmPopup()		' 주문확인창 무조건 오픈여부
	end if

	'ORG
	'Open_ConfirmPopup()		' 주문확인창 무조건 오픈여부
'20180810_01 LKM END		

End Function


