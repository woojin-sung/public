'20191106 HWG START : 수량필드 스핀컨트롤 추가
'======================================
' btnQPlus_OnClick : 수량 + 버튼
'======================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'======================================
' btnQMinus_OnClick : 수량 - 버튼
'======================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption
	
	if Trim(szQty) == "" then
		szQty = 1
		
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
			
		end if
	end if
	
	edtQty.caption = szQty
	
	if g_bSaveOrdQty == true then		'PENTA13 START => 2024.04.15(호가주문수량저장)
		Dim sEnvKey, szCode, sValue
		
		sEnvKey = "hogaord.save_itemqty"
		
		szCode = Change_ItemCode()
		sValue = szCode & "★" & szQty & "★" & "1"
		
		Form.SetEnvData(1, sEnvKey, sValue)
	end if

End Function
'20191106 HWG END

'20220425 HWG START : 계좌비밀번호 입력 개선
