'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	Dim szData

	' 종목코드
	szCd = Change_ItemCode()
	
	szData = acnt.total								' 계좌번호(8)
	szData = szData & "★" & acnt.sequence				' 계좌일련번호(2)
	szData = szData & "★" & acnt.itemcodetype			' 계좌itemcodetype
	szData = szData & "★" & szCd						' 종목코드
	szData = szData & "★" & g_szMk						' 시장구분
	szData = szData & "★" & lblHyun.caption				' 가격(현재가고정)
	szData = szData & "★" & edtQty.caption				' 수량
	szData = szData & "★" & rdoGbn.currentindex			' 현금/신용	'PENTA13 START => 2024.04.15(호가주문수량저장)
	
	Form.OpenPopup("mbtrs12010_p2", szData, "")
End Sub

'============================================================================
' tblHoga_OnClick
'============================================================================
Sub tblHoga_OnClick(lRow , lColumn)
	Dim szData 
	
	if lColumn == 0 or lColumn == 4 then
		szData = Trim(tblHoga.GetCellString(lRow , lColumn))
		
		if szData <> "" then
			Init_Control(1)
			Init_OrderArea()
			SetHogaOrderTable()
		
			if lColumn == 0 then	
				btnAllSCncl.visible = true
			elseif lColumn == 4 then
				btnAllBCncl.visible = true
			end if
		end if
	end if
End Sub

'============================================================================
' rdoGbn_OnClick : 현금/신용 라디오버튼 클릭
'============================================================================
Sub rdoGbn_OnClick(nIndex)
	Enable_CreditControl(nIndex)
	Init_cmbCredit(nIndex)
	
	' 현금/신용 라디오 버튼 클릭시 미체결내역 재조회요청(20160324 : 오택경차장)
	Init_Control(1)
	Init_Table(0)
	Init_OrderArea()	
		
	Change_HOGA_Request(g_szCd, szType)
