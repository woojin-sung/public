'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'20220425 HWG START : 계좌비밀번호 입력 개선
	btnPwd.bringfront("1")
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwd.caption = ""
		edtPwdIcon.imgpath = "icon_save_password_n.9"
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	Dim szCd

	chkCredit.chkcaption = "신용\n합산"
	chkCredit.unchkcaption = "신용\n합산"
	
	Change_LinkForm()
	Init_Control(0)
	'10호가창 중간위치/ 호가 잔량그래프 없애기
	contHoga.scroll_pos = "vcenter"
	contHoga.hogaTbl.hojangraph = "0"
	
	'20180719 LES START -KOTC시장 추가
	' 종목컨트롤
	Form.SetSearchType ("29:1:5:6:3:15")		'20220922 SWJ START : 최근조회 탭 추가
	'20180719 LES END
	
	szCd = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	Form.SetItemCode(szCd)						' 최초 화면진입시 종목코드 설정
		
	g_szMk = Form.GetItemCodeInfo(szCd, "market")
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
	' ELW경우(체크하는지 확인후 적용하자)
'	if g_szMk == "W" then
'		DATAMANAGER.RequestTranData("obcsb_acif_000r")
'	end if

	LoadHogaOrderItemQty(szCd)	'PENTA13 START => 2024.04.15(호가주문수량저장)

End Sub
'============================================================================
'PENTA13 START => 2024.04.15(호가주문수량저장)
Sub LoadHogaOrderItemQty(szCode)
	if szCode <> null and szCode <> "" then
		Dim sEnvKey, sItemQty, sItemCode, bFileWrite
		Dim sSaveItemCode, sSaveQty, sSaveQtyFlag

		bFileWrite = false

		sEnvKey = "hogaord.save_itemqty"
		sItemQty = Form.GetEnvData(sEnvKey)

		if sItemQty <> null and sItemQty <> "" then
			bFileWrite = true
			tData = Split(sItemQty, "★")

			if UBOUND(tData) > 0 then
				sSaveItemCode = tData(0)	'종목
				sSaveQty      = tData(1)	'수량
				sSaveQtyFlag  = tData(2)	'수량저장 플래그

				if sSaveItemCode <> null and sSaveItemCode <> "" then
					sItemCode = ChangeOrderItemCode(szCode)
					
					if sItemCode == sSaveItemCode then
						if sSaveQty <> null and sSaveQty <> "" then
							if CDbl(sSaveQty) >= 0 and sSaveQtyFlag == "1" then
								g_bSaveOrdQty = true
							end if
						end if
					end if
				end if
				
			end if
		end if
		
		if bFileWrite == true then		
			if g_bSaveOrdQty == true then
				edtQty.caption = sSaveQty

			else
				Form.SetEnvData(1, sEnvKey, sItemCode & "★" & "0" & "★" & sSaveQtyFlag)
				
				if sSaveQtyFlag == "1" then
					g_bSaveOrdQty = true
				end if
			end if
		end if

	end if
End Sub

'============================================================================
Function ChangeOrderItemCode(szCode)
	Dim szMk
	szMk = Form.GetItemCodeInfo(szCode, "market")

	if Left(szCode, 1) = "J" or Left(szCode, 1) = "F" then		'신주인수권, 수익증권
		return szCode
		
	elseif szMk = "J" or szMk = "T" then						'주식
		return "A" & szCode
		
	elseif szMk = "W" then									'ELW
		return "J" & szCode

	else
		return szCode										'기타
		
	end if
End Function
'PENTA13 END
'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "ITEMCODE" then
		lblPrc.caption = ""
		
		g_szMk = Form.GetItemCodeInfo(sValue, "market")
		
		Init_OrderQty(sValue)									'PENTA13 START => 2024.04.15(호가주문수량저장)
		
		Init_Control(1)
		Init_Table(0)
		Init_OrderArea()
		
		Change_HOGA_Request(sValue, szType)
		
		'20180719 LES START - KOTC시장 추가
		Position_Control()
		
		Form.postTriggerEvent("", "CHECK_SAVE_ITEMQTY", sValue)	'PENTA13 START => 2024.04.15(호가주문수량저장)		
		
	elseif sKey == "&ACR_ITEM" then	' 20160324 상단현재가 부분 좌/우 스크롤시 필요
		Form.SetItemCode(sValue)
	end	if	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
	if sEventName == "SCREEN_MENU" then	
		if sParam == "POPUP1" then			' 예수금
			Form.OpenPopup("mbtrs12000_pe", acnt.total & "★" & acnt.sequence, "")
		elseif sParam == "POPUP2" then		' 주문가능
			' 종목코드
			szCd = Change_ItemCode()
	
			if Trim(lblPrc.caption) == "" then
				Form.OpenPopup("mbtrs12000_pf", acnt.total & "★" & acnt.sequence & "★" & szCd & "★" & lblHyun.caption, "")	
			else
				Form.OpenPopup("mbtrs12000_pf", acnt.total & "★" & acnt.sequence & "★" & szCd & "★" & lblPrc.caption, "")	
			end if
		elseif sParam = "POPUP3" then		' 투자의견(20160324 변경)
			' 종목코드
			szCd = Change_ItemCode()
			Form.OpenScreen("11000" , szCd & "★투자의견" )
		end if	
	' ----------------------------------------------------------------------
	' 상단 종목부분 클릭시 종목정보/최근조회종목 팝업호출 : 20160318 추가
	' ----------------------------------------------------------------------			
	elseIf sEventName = "TITLE_CLICK" Then
		'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
		'Form.OpenPopup("mhprc11000_p1" , "" , "")
		Form.OpenCommonDialog("SEARCH", "29:1:5:6:3:15", "")
		'20220922 SWJ END
		
'PENTA13 START => 2024.04.15(호가주문수량저장)
	elseif sEventName == "CHECK_SAVE_ITEMQTY" then
		CheckItemCodeQty(sParam)
		
	elseif sEventName == "RET_BALANCE_SCREEN" then
		Return_BalanceScreen(sParam)
	
	elseif sEventName == "RET_CONTRACT_SCREEN" then
		edtQty.caption = sParam
'PENTA13 END

	end if
End Sub
	
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szGbn
	
	szGbn = rdoGbn.currentindex
	
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------
	if sKeyName == "주문경고" then
		if sRet == "1" then
			if g_szOrder == "2" or g_szOrder == "3" then
'				Request_Cash_Order("Y")
				Request_Cash_Order("A")	'20201119 HSZ 제도개선
			else
				'현금
				if szGbn == "0" then
					'20200824 LES START 제도개선
'					if gWarnCd = "3" then
'						Request_Cash_Order("O")
'					elseif gWarnCd = "4" then
'						Request_Cash_Order("A")
'					elseif gWarnCd = "5" then
'						Request_Cash_Order("A")
'					else
'						Request_Cash_Order("Y")
'					end if
					'20200824 LES END
					
					Request_Cash_Order("A")	'20201119 HSZ 제도개선
					
				'
				'신용
				elseif szGbn == "1" then
					
					'20200824 LES START 제도개선
'					if gWarnCd = "3" then
'						Request_Credit_Order("O")
'					elseif gWarnCd = "4" then
'						Request_Credit_Order("A")
'					elseif gWarnCd = "5" then
'						Request_Credit_Order("A")
'					else
'						Request_Credit_Order("Y")
'					end if
					'20200824 LES END
					
					Request_Credit_Order("A")	'20201119 HSZ 제도개선
					
				end if
			end if
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴 
	' ----------------------------------------------------------------------
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			if g_szOrder == "2" or g_szOrder == "3" then
				if #g_tModCnlTable > 1 then
					Request_Multi_Order("N")
				else
					Request_Cash_Order("N")
				end if
			else
				if szGbn == "0" then
					Request_Cash_Order("N")
				elseif szGbn == "1" then
					Request_Credit_Order("N")
				end if
			end if
		end if
	' ----------------------------------------------------------------------
	' 잔고팝업, 미체결팝업에서 리턴
	' ----------------------------------------------------------------------
	elseif sKeyName == "12000_BALANCE" or sKeyName == "12000_CONTRACT" then
		Dim szChk

		if sRet <> "" then
			tData = Split(sRet, "★")

'PENTA13 START => 2024.04.15(호가주문수량저장)
			szCode = Change_ItemCode()
			
			Return_Change_ItemCode(tData(2))
			
			if tData(3) <> "" then
				if sKeyName == "12000_BALANCE" then
					'edtQty.caption = tList(0)

					if g_bSaveOrdQty == true then
						if tData(2) <> "" then
						
							Dim sRecvCode, sRecvQty
							sRecvCode = tData(2)
							sRecvQty = tData(3)
						
							'if szCode == sRecvCode then			'파일저장
								sEnvKey = "hogaord.save_itemqty"
								tRecv = Split(sRecvQty, "♥")
								
								if UBOUND(tRecv) > 0 then
									sValue = sRecvCode & "★" & tRecv(0) & "★" & "1"
									Form.SetEnvData(1, sEnvKey, sValue)
								end if
							'end if

							Form.postTriggerEvent("", "RET_BALANCE_SCREEN", tData(3))
							'Return_BalanceScreen(tData(3))

						end if
					
					else
						Form.postTriggerEvent("", "RET_BALANCE_SCREEN", tData(3))
						'Return_BalanceScreen(tData(3))
						
					end if
					
				elseif sKeyName == "12000_CONTRACT" then
					if g_bSaveOrdQty == true then
						if tData(2) <> "" then
							tList = Split(tData(3), "♥")
							
							'if szCode == tData(2) then
								sEnvKey = "hogaord.save_itemqty"
								
								if UBOUND(tList) > 0 then
									sValue = tData(2) & "★" & tList(1) & "★" & "1"
									Form.SetEnvData(1, sEnvKey, sValue)
								end if
							'end if
							
							Form.postTriggerEvent("", "RET_CONTRACT_SCREEN", tList(1))
							'edtQty.caption = tList(1)
						end if

					else
						tList = Split(tData(3), "♥")
						Form.postTriggerEvent("", "RET_CONTRACT_SCREEN", tList(1))
						'edtQty.caption = tList(1)

					end if
				end if
'PENTA13 END
			end if
		end if
	' ----------------------------------------------------------------------
	' 기타팝업에서 매수선택시 리턴
	' ----------------------------------------------------------------------
	elseif sKeyName == "RETURN_ETCBUY" then
		g_szOrder = "0"
		g_szPrc =  sRet
		
		bRtn = Check_InputData(0)
		
		if bRtn == false then
			Exit Sub
		end if
			
		Open_ConfirmPopup()		' 주문확인창 무조건 오픈여부
	' ----------------------------------------------------------------------
	' 기타팝업에서 매도선택시 리턴 
	' ----------------------------------------------------------------------
	elseif sKeyName == "RETURN_ETCSELL" then	
		g_szOrder = "1"
		g_szPrc =  sRet
			
		bRtn = Check_InputData(0)
		
		if bRtn == false then
			Exit Sub
		end if
			
		Open_ConfirmPopup()		' 주문확인창 무조건 오픈여부
	' ----------------------------------------------------------------------
	' 수량팝업에서 리턴 
	' ----------------------------------------------------------------------
	elseif sKeyName == "QTY_POPUP" then	
		if sRet <> "" then	'PENTA13 START => 2024.04.15(호가주문수량저장)		
			tData = Split(sRet, "★")

			if UBOUND(tData) > 0 then
				edtQty.caption = tData(0)

				if tData(1) == "1" then
					g_bSaveOrdQty = true
				else
					g_bSaveOrdQty = false
				end if
				
			end if
		end if
	' ----------------------------------------------------------------------
	' 종목정보/최근조회종목 팝업에서 리턴 : 20160318 추가
	' ----------------------------------------------------------------------		
	elseif sKeyName = "11000_p1_Close" then
		if Trim(sRet) <> "종목없음" then
			Form.SetItemCode(sRet)
		end if
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
	end if
End Sub

'============================================================================
' Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Init_Control(1)
	Init_Table(0)
	Init_OrderArea()
	
	Request_Hoga()	
End Sub

'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
'20180810_01 LKM START
	if sKeyName = "MaxOrdCnt" then'일괄 정정/취소 건수 30건 초과 
		Open_ConfirmPopup()		' 주문확인창 무조건 오픈여부
	end if
'20180810_01 LKM END	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'DATAMANAGER.ClearInputData(0, szTranID)

	' ----------------------------------------------------------------------
	' 현재가(마우스주문호가)
	' ----------------------------------------------------------------------
	if szTranID = "ohhts_2030_001r" then	    
		DATAMANAGER.SetDataValue(0, "ohhts_2030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_2030_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)

		DATAMANAGER.SetDataValue(0, "ohhts_2030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_2030_001r", "InBlock2", "FID_INPUT_ISCD"              , 0, g_szCd)	
	' ----------------------------------------------------------------------
	' 현재가(호가단위)
	' ----------------------------------------------------------------------
	elseif szTranID = "ohhts_1001_001r" then	    
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)		
	' ----------------------------------------------------------------------
	' 고객정보
	' ----------------------------------------------------------------------
	elseif szTranID = "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "PROS_CLS_CODE"	, 0, "1")			' 처리구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNO"			, 0, acnt.total)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD"		, 0, "")				' 계좌비밀번호	
	' ----------------------------------------------------------------------
	' 약정내역조회
	' ----------------------------------------------------------------------
	elseif szTranID = "obpds_srvc_069r" then
		edtState.caption = ""
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "CSNO"				, 0, "")				' 고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "SVCD"				, 0, "021")			' 서비스코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "ACNO"				, 0, acnt.total)		' 계좌번호(8)		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE"		, 0, "0" )			' 처리구분코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "STPL_STAT_CLS_CODE"	, 0, "98")			' 약정상태 구분코드
	' ----------------------------------------------------------------------
	' 상품_ELW교육 이수 확인내역
	' ----------------------------------------------------------------------
	elseif szTranID = "obpds_srvc_243r" then
		edtEdu.caption = ""
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_243r", "InBlock1", "ACNO", 0, acnt.total)	' 계좌번호(8)
	' ----------------------------------------------------------------------
	' 계좌별 주문체결현황
	' ----------------------------------------------------------------------
	elseif szTranID = "obtrs_cntg_638r" then
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "ACNO",               0, acnt.total)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "ASNO",               0, acnt.sequence)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "ACNT_PWD",           0, "")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "ODER_DATE",          0, Form.GetSharedData("&HOST_DATE", false))
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "IQRY_CLS_CODE",      0, "0")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "DEAL_CLS_CODE",      0, "0")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "CNTG_CLS_CODE",      0, "2")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "PROS_CLS",           0, "2")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "ISCD",               0, "A" & g_szCd)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "ODER_NO",            0, "00000000000")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "DATA_CLS",           0, "0")
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_638r", "InBlock1", "IQRY_CSNU",          0, "00000000000")
	end if	
	
	'10호가창 중간위치
	'contHoga.scroll_pos = "vcenter"	' 20160324 주문후 호가 정렬시키지 말라는 이유로 주석처리
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(마우스주문호가)
	' ----------------------------------------------------------------------
	if szTranID = "ohhts_2030_001r" then	  
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		
		if g_szMk = "W" then
			DATAMANAGER.RequestRealData("ohhts_elw_cntg")
			DATAMANAGER.RequestRealData("ohhts_elw_aspr")
		
		'20180719 LES START - KOTC시장 추가
		elseif g_szMk = "T" then
			DATAMANAGER.RequestRealData("ohhts_frbr_cntg")
			DATAMANAGER.RequestRealData("ohhts_frbr_aspr")
		'20180719 LES END
		
		else
			DATAMANAGER.RequestRealData("ohhts_stck_aspr")
'			DATAMANAGER.RequestRealData("ohhts_stck_cntg")
			DATAMANAGER.RequestRealData("ohhts_stck_incg") '20220216 HSZ 시세속도 개선
		end if	
	' ----------------------------------------------------------------------
	' 고객정보
	' ----------------------------------------------------------------------
	elseif szTranID = "obcsb_acif_000r" then				
		DATAMANAGER.RequestTranData("obpds_srvc_069r")
	' ----------------------------------------------------------------------
	' 약정내역조회
	' ----------------------------------------------------------------------
	elseif szTranID = "obpds_srvc_069r" then
		edtState.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "STPL_STAT_CLS_CODE", 0)	' 약정상태 구분코드
		
		DATAMANAGER.RequestTranData("obpds_srvc_243r")
	' ----------------------------------------------------------------------
	' 상품_ELW교육 이수 확인내역
	' ----------------------------------------------------------------------
	elseif szTranID = "obpds_srvc_243r" then	
		if edtState.caption =="01" then
			edtEdu.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_243r", "OutBlock1", "ELW_EDCT_CMCO_YN", 0)			' ELW교육 이수여부
			
			if edtEdu.caption == "N" then
				Form.OpenPopup("mbtrs12000_pd", "N", "")
			end if
		else
			Form.OpenPopup("mbtrs12000_pd", "Y", "")
		end if
	' ----------------------------------------------------------------------
	' 주식 주문 / 주식복수주문
	' ----------------------------------------------------------------------
	elseif szTranID == "obtrs_oder_101a" or szTranID == "obtrs_oder_201a" or szTranID == "obtrs_oder_211a" or szTranID == "obtrs_oder_107a" then
		
		'20200824 LES START 제도개선
		'경고구분코드 (0.정상, 1.경고, 2.보류  추가: 3.투자유의 4.투자유의+경고  5.투자유의+보류)
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		gWarnCd = szWarnCd
		'20200824 LES END
		
		'20200824 LES START 제도개선
		'20201119 HSZ 제도개선 (6, 7, 9, a, c, d, f, g 추가)
		if szWarnCd = "1"or szWarnCd ="3"or szWarnCd ="4" or szWarnCd ="6" or szWarnCd ="7" or szWarnCd ="9" or szWarnCd ="a" or szWarnCd ="c"or szWarnCd ="d"or szWarnCd ="f"or szWarnCd ="g" then								' 20201119 HSZ 제도개선
			Open_ConfirmPopup(szWarnMsg)			' 경고

		'20200824 LES START 제도개선
		'20201119 HSZ 제도개선 (8, b, e, h 추가)
		elseif szWarnCd = "2" or szWarnCd = "5" or szWarnCd = "8" or szWarnCd = "b" or szWarnCd = "e" or szWarnCd = "h" then						' 보류
			'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)

		else	' 20201119 HSZ 제도개선
			if g_szOrder == "0" or g_szOrder == "1" then		' 20160408 매수, 매도주문시만..
				if szTranID == "obtrs_oder_101a" or szTranID == "obtrs_oder_201a" or szTranID == "obtrs_oder_211a" then
					tData = InitOrderData(tData)
	
					tData.OrderNo     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)		' 주문번호
					tData.OrgnOrderNo = ""				' 원주문번호
					tData.ItemCd      = g_szCd			' 종목코드
					tData.LoanDate    = ""				' 대출일
					tData.ChannelCd   = ""				' 채널유형구분코드
					tData.ModCnclCd   = ""				' 정정취소구분코드
					
					if g_szOrder == "0" then
						tData.DealCd      = "2"		' 매매구분코드
					elseif g_szOrder == "1" then
						tData.DealCd      = "1"		' 매매구분코드
					end if
					
					tData.OrderPrc    = g_szPrc			' 주문단가
					tData.RemainQty   = edtQty.caption	' 주문수량
					
					'tData.szStatus 	= "0"		' 체결 역전 구분 (0:정상, 1:역전)
					tData.szStatus 	= "2"		' 체결 역전 구분 (0:정상, 1:역전) 20160418 : 주문완료시 "2"

					InsertOrderTable(tData)	
					SetHogaOrderTable()
				end if
			end if
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) == "0001" then			' 정상주문
				Form.Toast(0, szOrdMsg, true)
			end if
			
			Init_Table(1)
			Init_Control(1)
		end if
	
	' ----------------------------------------------------------------------
	' 주식 복수주문
	' ----------------------------------------------------------------------
'	elseif szTranID == "obtrs_oder_107a" then
'		Init_Table(1)
'		Init_Control(1)
	' ----------------------------------------------------------------------
	' 체결내역조회
	' ----------------------------------------------------------------------
	elseif szTranID == "obtrs_cntg_638r" then
		Dim tData()
		
		nCnt = DATAMANAGER.GetDataCount(0, "obtrs_cntg_638r", "OutBlock1")

		For i = 0 to nCnt-1
			tData = InitOrderData(tData)

			tData.OrderNo     = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "ODER_NO",            i)		' 주문번호
			tData.OrgnOrderNo = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "ORGL_ODER_NO",       i)		' 원주문번호
			tData.OrderTypeCd = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "ODER_CLS_CODE",      i)		' 주문구분코드
			tData.ItemCd      = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "ISCD",               i)		' 종목코드
			tData.OrderQty    = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "ODQT",               i)		' 주문수량
			tData.TotalCntgQty= DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "TOTAL_CNTG_QTY",     i)		' 총체결수량
			tData.ModQty      = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "RCTF_QTY",           i)		' 정정수량
			tData.CofrQty     = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "CNFR_QTY",           i)		' 확인수량
			tData.LoanDate    = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "LOAN_DATE",          i)		' 대출일
			tData.ChannelCd   = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "CHAN_TYPE_CLS_CODE", i)		' 채널유형구분코드
			tData.ModCnclCd   = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "RCTF_CNCL_CLS_CODE", i)		' 정정취소구분코드
			tData.DealCd      = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "DEAL_CLS_CODE",      i)		' 매매구분코드
			'NOHES 20160602 START 소수점처리 컬럼
			tData.OrderPrc    = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "BOND_ODER_UNPR",          i)		' 주문단가
			tData.CntgPrc     = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "BOND_CNTG_PRC",          i)		' 체결단가
			'NOHES 20160602 END	
			tData.CanlQty     = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "CNCL_QTY",           i)		' 취소수량
			tData.OderAbleQty = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "ODER_ABLE_QTY",      i)		' 주문가능수량
			tData.RemainQty   = DATAMANAGER.GetDataValue(0, "obtrs_cntg_638r", "OutBlock1", "NCNT_QTY",           i)		' 미체결수량
			tData.szStatus 	= "0"		' 체결 역전 구분 (0:정상, 1:역전)

			InsertOrderTable(tData)
		Next
			
		SetHogaOrderTable()
		
		DATAMANAGER.RequestRealData("ohhts_cntg_infr")
		DATAMANAGER.RequestRealData("ohhts_cntg_rslt")
    end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	' ----------------------------------------------------------------------
	' 주식 주문 / 주식 복수주문(107a)
	' ----------------------------------------------------------------------
	if szTranID == "obtrs_oder_101a" or szTranID == "obtrs_oder_201a" or szTranID == "obtrs_oder_211a" or szTranID == "obtrs_oder_107a" 	then
		Dim szSubMsg
			
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
			
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
			'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
			'Form.Toast(0, szErrMsg, true)
		end if
	
		Init_Table(1)
	' ----------------------------------------------------------------------
	' 주식 복수주문
	' ----------------------------------------------------------------------
'	elseif szTranID == "obtrs_oder_107a" then
'		Init_Table(1)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 주식체결 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_stck_incg" then '20220216 HSZ 시세속도 개선(cntg->incg)
		DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주식호가 자동갱신
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_stck_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW호가 자동갱신
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_elw_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주문체결통보
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_cntg_infr" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_USER_ID", 0, Form.GetSharedData("&USER_ID", 0))
	' ----------------------------------------------------------------------
	' 주문체결결과
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_cntg_rslt" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_USER_ID", 0, Form.GetSharedData("&USER_ID", 0))
	
	'20180719 LES START - KOTC시장 추가
	elseif szTranID == "ohhts_frbr_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	
	elseif szTranID == "ohhts_frbr_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	'20180719 LES END
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szAcnt, szAcno, szAsno, szCd

	' ----------------------------------------------------------------------
	' 주식호가 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_stck_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		
		if g_szMod == "" then
			SetHogaOrderTable()
		else
			For i = 0 to g_nHogaRow-1
				nPrc = _tonumber(contHoga.hogaTbl.GetCellString(i, 2))
				
				' 20160324 호가 변동시 추가주문 선택상황에서 클리어되는 부분 수정
				if nPrc > 0 and _tonumber(g_szPrc) == nPrc then
					Set_Hoga_Mod(2, i)
					Exit Sub
				end if
				' 선택호가가 없으면 화면에서 같이 지워질수 밖에 없음
				if i == g_nHogaRow-1 then
					Set_Hoga_Mod(0, "")
				end if
				' /////////////////////////////////////////////////////////////////
			Next
				
		end if
	' ----------------------------------------------------------------------
	' 주문체결통보
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_cntg_infr" then
		Dim tData()
		
		szAcno = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_ACNO",      0)	' 계좌번호
		szAsno = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_ASNO",      0)	' 계좌일련번호
		szCd   = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_STND_ISCD", 0)	' 종목코드		
		
		szCd = Mid(szCd, 4, 6)
		szAcnt = szAcno & szAsno
		
		if acnt.caption <> szAcnt then		' 계좌비교
			Exit Sub
		end if
		
		if g_szCd <> szCd then				' 종목비교
			Exit Sub
		end if
	
			tData = InitOrderData(tData)
			tData.OrderNo     = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ODER_NO",            0)		' 주문번호
			tData.OrgnOrderNo = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ORGL_ODER_NO",       0)		' 원주문번호
			tData.ItemCd      = szCd																				' 종목코드
			tData.LoanDate    = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_LOAN_DATE",          0)		' 대출일
			tData.ChannelCd   = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "CHAN_TYPE_CLS_CODE",      0)		' 채널유형구분코드
			tData.ModCnclCd   = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_RCTF_CNCL_CLS_CODE", 0)		' 정정취소구분코드
			tData.DealCd      = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_DEAL_CLS_CODE",      0)		' 매매구분코드
			tData.OrderPrc    = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_ASPR_PRC",           0)		' 주문단가
			tData.RemainQty   = DATAMANAGER.GetDataValue(1, "ohhts_cntg_infr", "OutBlock1", "FIDR_TLMS_ASPR_QTY",      0)		' 미체결수량	
			tData.szStatus	= "0"
			
			szSvcID = DATAMANAGER.GetDataValue(1,"ohhts_cntg_infr", "OutBlock1", "FIDR_SVC_ID", 0)		' 서비스 ID
			nRet    = ConFirm_Reject(szSvcID)			' 주문거부 체크
			
			'20180820 LES START
			'K-OTC종목일 경우 정정/취소주문 시 tData.DealCd = 0 으로 내려오므로
			'기존 테이블에 가지고있는 주문정보와 실시간으로 내려오는 원주문번호를 비교하여
			'tData.DealCd를 세팅해준다.
			
			szMK = Form.GetItemCodeInfo(szCd, "market")
			
			if szMk == "T" then
				for i=0 to #g_tOrderTable-1
					if _tonumber(tData.OrgnOrderNo) == _tonumber(g_tOrderTable[i].OrderNo) then
						if g_tOrderTable[i].DealCd <> "" then
							tData.DealCd = g_tOrderTable[i].DealCd
						end if
					end if
				next
			end if
			'20180820 LES END
			
			
			
			
			' 20160408 : 정정, 취소일때는 기존방식 유지, 신규일때는 예외처리
			if tData.ModCnclCd == "2" or tData.ModCnclCd == "3" then
				if nRet == 0 then
					Exit Sub
				end if
				
				if tData.ModCnclCd == "3" then		' 취소시
					DeleteOrderTable(tData)
				elseif tData.ModCnclCd == "2" then		' 정정시
					DeleteOrderTable(tData)
					InsertOrderTable(tData)
				end if
			else
				' 20160408 거부시 Delete, 접수시 Update
				if nRet == 0 then
					DeleteOrderTable(tData)
					'Exit Sub
				else
					DeleteOrderTable(tData)
					InsertOrderTable(tData)

' 차후 정 이상하면.. 적용해보자!
'					nRtn = SetOrderTable(tData)
'					
'					' 20160418 : "0" 이면 다른곳에서 주문냈을때
'					if nRtn == 0 then
'						InsertOrderTable(tData)
'					end if				
''					DeleteOrderTable(tData)
''					InsertOrderTable(tData)
				end if
			end if
			
			SetHogaOrderTable()
	' ----------------------------------------------------------------------
	' 주문체결통보, 주문체결결과
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_cntg_rslt" then	
		Dim tData()
		szAcno = DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_ACNO",      0)	' 계좌번호
		szAsno = DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_ASNO",      0)	' 계좌일련번호
		szCd   = DATAMANAGER.GetDataValue(1, "ohhts_cntg_rslt", "OutBlock1", "FIDR_STND_ISCD", 0)	' 종목코드		
		
		szCd = Mid(szCd, 4, 6)
		szAcnt = szAcno & szAsno
		
		if Trim(acnt.caption) <> Trim(szAcnt) then		' 계좌비교
			Exit Sub
		end if
		
		if g_szCd <> szCd then				' 종목비교
			Exit Sub
		end if
		
		tData = InitOrderData(tData)
		tData.OrderNo     = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_ODER_NO",       0)		' 주문번호
		tData.OrgnOrderNo = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_ORGL_ODER_NO",  0)		' 원주문번호
		tData.ItemCd      = szCd																	' 종목코드
		tData.LoanDate    = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_LOAN_DATE",     0)		' 대출일
		tData.ModCnclCd   = ""
		tData.DealCd      = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_DEAL_CLS_CODE", 0)		' 매매구분코드	
		tData.OrderPrc    = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_CNTG_PRC",      0)		' 체결가격
		tData.RemainQty   = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_CNTG_QTY",      0)		' 체결수량(미체결로 착각하지 말자!)	
		
		tData.szStatus    = "1"
		
		SetOrderTable(tData)
		SetHogaOrderTable()		
	end if
End Sub

'============================================================================
' contHoga_hogaTbl_OnClick
'============================================================================
Sub contHoga_hogaTbl_OnClick(lRow, lCol)
	Dim szData
	
	if lRow > -1 then
		if lCol == 0 or lCol == 4 then
			Init_Control(2)
			
			szData = contHoga.hogaTbl.GetCellString(lRow, lCol)
			
			if Trim(szData) == "정정" then
				g_szModPrc = contHoga.hogaTbl.GetCellString(lRow, 2)
			else
				g_szPrc = contHoga.hogaTbl.GetCellString(lRow, 2)
			end if
			
			if lCol == 0 then				' 매도주문	
				if Trim(szData) == "" then
					Set_Hoga_Mod(1, "")				
					
					bRtn = Check_InputData(0)
					
					if bRtn == false then
						Exit Sub
					end if
			
					g_szOrder = "1"
				else
					bRtn = Check_InputData(2)
					
					if bRtn == false then
						Exit Sub
					end if
					
					g_szMod = "1"
					g_szCol = lCol
					contSCncl.left = 69
					contHoga.imgDim.left = 69
					contHoga.imgDim.visible = true
					
					if Trim(szData) == "정정" then			' 정정주문
						g_szOrder = "2"
						
						Select_OrderList("1", "1")
						Exit Sub
					else									' 추가매도주문	
						Set_Hoga_Mod(0, lRow)
						Exit Sub
					end if			
				end if
			elseif lCol == 4 then			' 매수주문
				if Trim(szData) == "" then
					Set_Hoga_Mod(1, "")
					
					bRtn = Check_InputData(0)
					
					if bRtn == false then
						Exit Sub
					end if
					
					g_szOrder = "0"
				else	
					bRtn = Check_InputData(2)
					
					if bRtn == false then
						Exit Sub
					end if
					
					g_szMod = "1"
					g_szCol = lCol
					contBCncl.left = 240
					contHoga.imgDim.left = 0
					contHoga.imgDim.visible = true
					
					if Trim(szData) == "정정" then			' 정정주문
						g_szOrder = "2"
						
						Select_OrderList("2", "1")
						Exit Sub
					else									' 추가매수주문
						Set_Hoga_Mod(0, lRow)
						Exit Sub
					end if
				end if
			end if
			
			Open_ConfirmPopup()		' 주문확인창 무조건 오픈여부
		else
			Init_Control(1)
		end if
	end if
End Sub

