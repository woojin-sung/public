	<SCRIPT_INFO _len="6142" _ulen="5502" >
'============================================================================
' 2017.10.16 -  LSS
' 연합인포맥스 로그인 View 화면
'
' 2017.10.18 - LSS : 에디트 이미지 "" -> btn_white_n.9로 변경
' 2017.10.23 - LSS :  화면번호 전달받아 로그인 완료 후 화면이동 처리
' 2020.09.10 - SWJ : 메모리평문제거 적용 (plain_rm = 1 : 적용 / plain_rm = 0 : 미적용)
'============================================================================

Dim g_tblDefine

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

'============================================================================
Sub Form_OnFormInit()
	initDefine()
	initDefault()
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	if plain_rm == "1" then
		edtPass.SetEncExcept()           '해외주식 로그인화면 평문처리
	end if
'	'20200910 SWJ END
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if g_tblDefine[ "refreshExtra" ] == sKey then
		Form.CloseForm()
	end if
End Sub

'----------------------------------------------------------------------------
' 2017.10.16 - LSS
' 컨트롤 함수
'----------------------------------------------------------------------------
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub lblJoin_OnClick()
	doOpenPopup("JOIN")
End Sub

'============================================================================
Sub lblSearch_OnClick()
	doOpenPopup("SEARCH")
End Sub

'============================================================================
Sub btnLogin_OnClick()
	if doRunLoginCheck() then
		'로그인 TR 전송요청을 위한 이벤트 발생		
		runLoginProcess("0")
	end if
End Sub

'----------------------------------------------------------------------------
' 2017.10.16 - LSS
' 사용자 함수
'----------------------------------------------------------------------------
'============================================================================
' 기본 설정된 정보들 설정
'============================================================================
Sub initDefine()

	' 20180417 HAMWG START : 테스트/운영 판별 공유변수 변경
	g_tblDefine = {
		[ "TEST" ] = Form.GetSharedData( "&SERVER_MODE", false ),
		' 버전 및 아이디
		[ "VERSION" ] = Form.GetSharedData( "&APP_VERSION", false ),
		[ "USERID" ] = Form.GetEnvData( "login.session.userid_YH" ),
		' 연결화면
		[ "JOIN" ] = "https://paygts.einfomax.co.kr/m/join.html#/join/MZSM",
		[ "SEARCH" ] = "https://paygts.einfomax.co.kr/m/join.html#/findidpw",
		'반환 이벤트
		[ "refreshExtra" ] = "REFRESH_EXTRA_VIEW"
	}
	
	' // TODO
	' 테스트 모드인 경우 개발서버로... 추후 삭제 처리 하자
	if CInt( g_tblDefine[ "TEST" ] ) == 1 then
		g_tblDefine[ "JOIN" ] = "http://devpaygts.einfomax.co.kr/m/join.html#/join/MZSM"
		g_tblDefine[ "SEARCH" ] = "https://devpaygts.einfomax.co.kr/m/join.html#/findidpw"
	end if
    ' 20180417 HAMWG END
    
	g_tblDefine.isPost = false
	g_tblDefine.szOpenScreen = ""
End Sub

'============================================================================
' 기본 정보 및 컨트롤 설정
'============================================================================
Function initDefault()
	g_tblDefine.szOpenScreen = Form.GetOpenLinkData()

	lblVersion.caption = "Ver " & g_tblDefine["VERSION"]
	edtID.caption = Form.KBase64Decoding( g_tblDefine["USERID"] )
End Function

'============================================================================
' 로그인 유효성 체크
'============================================================================
Function doRunLoginCheck()
	if isNull( edtID.caption ) then
		Form.ShowAlert( "알림", "연합인포맥스 ID를 입력하세요." )
		return false
		
	elseif isNull( edtPass.caption ) then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요." )
		return false
		
	' 2017.10.16
	' CtlEditText에서 자릿수 지정해놨지만... 혹시 모르지만 예외처리 넣어놓자.
	elseif Len( edtID.caption ) > 10 then		
		Form.ShowAlert( "알림", "ID는 10자리 이하여야 합니다." )
		return false
		
	elseif Len( edtPass.caption ) > 16 then
		Form.ShowAlert( "알림", "비밀번호는 16자리 이하여야 합니다." )
		return false
		
	end if
	
	return true	
End Function

'============================================================================
' 로그인 프로세스 실행
'============================================================================
Function runLoginProcess(szType)
	Dim tData, szData
	
	tData = {}
	
	' 0 : 일반로그인, 1 : 강제로그인, 2 : 실시간 자동로그인, 3 : 지연로그인, 4: 로그아웃
	table.insert( tData, szType )
	table.insert( tData, ( not isNull( edtID.caption ) ) and Form.KBase64Encoding( edtID.caption ) or "" )
	table.insert( tData, ( not isNull( edtPass.caption ) ) and Form.KBase64Encoding( edtPass.caption ) or "" )
	table.insert( tData, g_tblDefine.szOpenScreen )
	
	For _, val in pairs( tData )
		if isNull( szData ) then
			szData = val
		else
			szData = szData & "★" & val
		end if		
	Next
	
	Form.OpenPopup( "AspLoginProcess" , szData , "")
End Function

'============================================================================
' 외부 웹 화면 호출
'============================================================================
Function doOpenPopup(szType)
	if isNull(szType) then
		return 
	end If
	
	Form.OpenExternalBrowser( g_tblDefine[ szType ] )
End Function

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function


