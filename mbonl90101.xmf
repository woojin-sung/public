'============================================================================
Sub Container0_contCheck_imgFold_OnClick()
	Dim szimgFile

	if bFoldState then
		szimgFile = "icon_arrow_down.png"
	else
		szimgFile = "icon_arrow_up.png"
	end if
	
	bFoldState = not bFoldState
	Container0.contCheck.imgFold.imgpath = szimgFile
	f_ShowInfo(bFoldState)
End Sub

'============================================================================
Function f_ShowInfo(bState)
	if bState then
		Container0.contCheck.height = 335
		Container0.contCheck.SetScrollAutoSize()
		
		Container0.scroll_pos = 335	
		Container0.Label999BG.top = 830	'900
		Container0.Label999.top = 830	'900
		
		Container0.SetScrollAutoSize()
	else
		Container0.contCheck.height = 25	'25	'!!!
		Container0.contCheck.SetScrollAutoSize()

		Container0.scroll_pos = 0
		Container0.Label999BG.top = 517
		Container0.Label999.top = 517
		
		Container0.SetScrollAutoSize()
	end if
End Function 

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'투자성향 변경 후 단기사채 화면의 투자성향 재조회하기 위함
	if sKey == "Change_Invest_Type" and sValue == "refresh" then	
		DATAMANAGER.RequestTranData( "obsap_deal_003r" )
	end if
End Sub 

'============================================================================
Sub Container1_btnSort_OnClick()
	if g_COMN_PFIN_YN == "N" then
		if g_szMtrtDate = "" or g_szMtrtDate = Null then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n단기사채 정렬 기준 변경이 불가합니다.")
		elseif int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false)) then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n단기사채 정렬 기준 변경이 불가합니다.")
		elseif szKYC_INVT_RCMD_CLS_CODE = "2" or szKYC_INVT_RCMD_CLS_CODE ="4" then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n단기사채 정렬 기준 변경이 불가합니다.")
		elseif szKYC_INVT_RCMD_CLS_CODE = "3" then	'투자권유 미희망 + 정보제공 일때 추가
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n단기사채 정렬 기준 변경이 불가합니다.")
		else
			Container1.cmbSortGb.openList()
		end if
	else
		Container1.cmbSortGb.openList()
	end if
End Sub

