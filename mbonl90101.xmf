				Container0.ContMain.grdData.SetCellData("RCRT_FIN_DATE", 			g_nNextCount , szTemp11)
				Container0.ContMain.grdData.SetCellData("RCRT_CLSN_HOUR", 			g_nNextCount , szTemp12)
				Container0.ContMain.grdData.SetCellData("RMNN_WNCR_AMT", 			g_nNextCount , szTemp9)
				Container0.ContMain.grdData.SetCellData("PBLC_DATE", 				g_nNextCount , szTemp5)
				Container0.ContMain.grdData.SetCellData("INVT_TRGT_TYPE_CODE", 		g_nNextCount , szTemp10)
				Container0.ContMain.grdData.SetCellData("HMPG_ATCH_FILE_PATH_NAME", 	g_nNextCount , szTemp15)
				Container0.ContMain.grdData.SetCellData("HMPG_ATCH_FILE_PATH_NAME1",	g_nNextCount , szTemp17)
				Container0.ContMain.grdData.SetCellData("RCRT_STA_DATE", 			g_nNextCount , szTemp19)
				Container0.ContMain.grdData.SetCellData("RCRT_STA_HOUR", 			g_nNextCount , szTemp20)
				Container0.ContMain.grdData.SetCellData("SHTR_BOND_REG_CLS_CODE", 	g_nNextCount , szTemp21)
				Container0.ContMain.grdData.SetCellData("PSNT_DATE", 				g_nNextCount , szTemp23)
				Container0.ContMain.grdData.SetCellData("TOTAL_ODER_LIMT_AMT", 		g_nNextCount , szTemp8)
				
				
				g_nNextCount = g_nNextCount + 1
			next
			
			Container0.ContMain.grdData.rowcount = g_nNextCount
			
			
			nINVT_ABLE_AMT = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock5", "INVT_ABLE_AMT" , 0)


			'그리드랑 컨테이너 데이터 건수에 맞게 높이 조절
			Container0.ContMain.grdData.height = (157 * g_nNextCount) + 15
			Container0.ContMain.SetScrollAutoSize()
			
			'상품목록 있는 경우에만 심의필 노출
			Container0.contCheck.visible = 1
			Container0.contCheck.bgcolor = "286"
			Container0.Label999BG.visible = 1
			Container0.Label999.visible = 1
	
			'그리드 이미지 세팅 타이머
			Form.SetTimerEvent2(1, 1, 0.1)

	
			if g_CUST_CLS_CODE == "2" then	'2: 법인/1:개인
				Form.MsgBox("알림", "법인은 신청이 불가합니다.", "auth_check", 6)		
				Exit Sub
			end if
		
		end if
	end if
	
	if szTranID == "obcsb_acif_400r" then
		g_COMN_PFIN_YN = DATAMANAGER.GetDataValue(0, "obcsb_acif_400r" , "OutBlock1" , "KYC_SPCL_INVR_YN" , 0)	'KYC전문투자자여부
		
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_798r", "InBlock1", "ELFN_ID", 0 , szUSERID)
		DATAMANAGER.RequestTranData("obcsb_acif_798r")
	end if
	
	if szTranID == "obcsb_acif_798r" then
		szKYC_INVT_INCL_GRAD_CODE = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE" , 0)	'KYC투자성향등급코드
		szKYC_INVT_RCMD_CLS_CODE = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_RCMD_CLS_CODE" , 0) 'KYC투자권유구분코드
		g_szMtrtDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_VALD_PRD_MTRT_DATE" , 0) '만기일자
	
		if g_COMN_PFIN_YN = "Y" then
			Container1.Label4.caption = "전문투자자 >"
			Container1.Label4.fgcolor = "330"
			
			
		elseif g_szMtrtDate = "" then
			'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
			Container1.Label4.caption = "미등록 >"
			Container1.Label4.fgcolor = "146"


			Dim szAlertData, szTitle
			szTitle = "투자자정보 미등록 안내"
			g_ErrMsgText = "투자성향에 맞는 상품 가입을 위해\n투자자정보 등록이 필요합니다."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
		elseif int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false)) then
			'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
			Container1.Label4.caption = "미등록 >"	'유효기간만료
			Container1.Label4.fgcolor = "146"
		
		
			Dim szAlertData, szTitle
			szTitle = "투자자정보 만료 안내"
			g_ErrMsgText = "투자자정보 유효기간이 경과되었습니다.\n투자성향에 맞는 상품 가입을 위해\n투자자정보 등록이 필요합니다."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
		elseif szKYC_INVT_RCMD_CLS_CODE = "2" or szKYC_INVT_RCMD_CLS_CODE ="4" then
			'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
			Container1.Label4.caption = "정보미제공 >"
			Container1.Label4.fgcolor = "321"
			
			Dim szAlertData, szTitle
			szTitle = "투자자정보 미제공 안내"
			g_ErrMsgText = "투자성향에 맞는 상품 가입을 위해\n투자자정보 제공이 필요합니다."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
			
		else	
		
'			if szKYC_INVT_RCMD_CLS_CODE ="3" then	'투자권유 미희망 + 정보제공 일때 추가
'			
'				'권유 미희망이라 조건검색&펀드정렬만 불가처리 (정보제공했으니까 투자성향별 위험등급 보여줌!!!)
'				btnSort01.visible = true
'				btnSort01.caption = "3개월 수익률 상위"
'				cmbSort01.visible = false
'				
'			else
'				
'				btnSort01.visible = false
'				btnSort01.caption = ""
'				cmbSort01.visible = true
'				
'			end if
			
			'v0001 sta 투자성향에 맞는 펀드 우선 검색
			if szKYC_INVT_INCL_GRAD_CODE = "01" then
				Container1.Label4.caption = "고수익지향형 >"
				Container1.Label4.fgcolor = "326"
			
			elseif szKYC_INVT_INCL_GRAD_CODE = "02" then
				Container1.Label4.caption = "성장지향형 >"
				Container1.Label4.fgcolor = "321"
				
			elseif szKYC_INVT_INCL_GRAD_CODE = "03" then
				Container1.Label4.caption = "중립형 >"
				Container1.Label4.fgcolor = "328"
				
			elseif szKYC_INVT_INCL_GRAD_CODE = "04" then
				Container1.Label4.caption = "안정지향형 >"
				Container1.Label4.fgcolor = "328"
				
			elseif szKYC_INVT_INCL_GRAD_CODE = "05" then	
				Container1.Label4.caption = "이자소득형 >"
				Container1.Label4.fgcolor = "329"
			'v0001 fin
					
			end if
		
		end if
		
		DATAMANAGER.RequestTranData( "obsap_deal_003r" )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub Container0_ContMain_grdData_OnClickUp(lRow, szCellID)
	Dim szData

	szData = ""
	
	szParam0 	= cmbAccount.total
	szParam1 	= cmbAccount.sequence
	szParam2 	= Container0.ContMain.grdData.GetCellData( "ISCD" , lRow)	'ISCD
	szParam3 	= Container0.ContMain.grdData.GetCellData( "KOR_ISNM" , lRow)	''KOR_ISNM
	szParam4 	= Container0.ContMain.grdData.GetCellData( "RCRT_FIN_DATE" , lRow)	''RCRT_FIN_DATE
	szParam5 	= Container0.ContMain.grdData.GetCellData( "RCRT_CLSN_HOUR" , lRow)	''RCRT_CLSN_HOUR
	szParam6 	= Container0.ContMain.grdData.GetCellData( "INVT_DYNU" , lRow)	''INVT_DYNU
	szParam7 	= FormatNumber(Container0.ContMain.grdData.GetCellData( "GNRL_INTRT" , lRow),2)	''GNRL_INTRT
	szParam8 	= Container0.ContMain.grdData.GetCellData( "MTRT_DATE" , lRow)	''MTRT_DATE
	szParam9 	= Container0.ContMain.grdData.GetCellData( "badge_1" , lRow)	''PROD_GRAD_CODE
	szParam10 	= Container0.ContMain.grdData.GetCellData( "badge_2" , lRow)	''CRDT_GRAD
	szParam11 	= CDBL(Container0.ContMain.grdData.GetCellData( "RMNN_WNCR_AMT" , lRow))	'RMNN_WNCR_AMT
	szParam12 	= CDBL(Container0.ContMain.grdData.GetCellData( "TOTAL_ODER_LIMT_AMT" , lRow))	'TOTAL_ODER_LIMT_AMT
	szParam13 	= Container0.ContMain.grdData.GetCellData( "PBLC_DATE" , lRow)	'PBLC_DATE
	szParam14 	= Container0.ContMain.grdData.GetCellData( "INVT_TRGT_TYPE_CODE" , lRow)	'INVT_TRGT_TYPE_CODE
	szParam15 	= Container0.ContMain.grdData.GetCellData( "HMPG_ATCH_FILE_PATH_NAME" , lRow)	'HMPG_ATCH_FILE_PATH_NAME
	szParam16 	= Container0.ContMain.grdData.GetCellData( "HMPG_ATCH_FILE_PATH_NAME1" , lRow)	'HMPG_ATCH_FILE_PATH_NAME1
	szParam17 	= CDBL(nINVT_ABLE_AMT)	'INVT_ABLE_AMT
	
	szParam18	= Container1.cmbProdCd.cbkeydata
	szParam19	= Container1.cmbSortGb.cbkeydata
	szParam20	= g_Trgt_Cls_Code

	szParam21 	= Container0.ContMain.grdData.GetCellData( "RCRT_STA_DATE" , lRow)	'RCRT_STA_DATE
	szParam22 	= Container0.ContMain.grdData.GetCellData( "RCRT_STA_HOUR" , lRow)	'RCRT_STA_HOUR

	szParam23 	= Container0.ContMain.grdData.GetCellData( "SHTR_BOND_REG_CLS_CODE" , lRow)	'단기사채등록구분코드
	szParam24 	= Container0.ContMain.grdData.GetCellData( "CREN_CO_NAME" , lRow)	'신용보강회사명
	szParam25 	= Container0.ContMain.grdData.GetCellData( "PSNT_DATE" , lRow)	'현재일자


	szData = szParam0 & "★" & szParam1 & "★" & szParam2 & "★" & szParam3 & "★" & szParam4 & "★" &
			szParam5 & "★" & szParam6 & "★" & szParam7 & "★" & szParam8 & "★" & szParam9 & "★" & 
			szParam10 & "★" &szParam11 & "★" & szParam12 & "★" & szParam13 & "★" & szParam14 & "★" & 
			szParam15 & "★" & szParam16 & "★" & szParam17 & "★" & szParam18 & "★" & szParam19 & "★" & 
			szParam20 & "★" & szParam21 & "★" & szParam22 & "★" & szParam23 & "★" & szParam24 & "★" & szParam25
		
			
	if szData <> "" And szData <> null  then
		Form.OpenPopup( "mbonl88060_p1" , szData , "")
	end if
End Sub

