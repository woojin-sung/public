' 그리드 이미지 세팅 타이머
Sub Form_OnTimerEvent(sTimerID)
	
	if Cint(sTimerID) = 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0)
		
		
		Dim nCnt, nGridCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, "obsap_deal_003r", "OutBlock1" ))
		nGridCnt = CInt(Container0.ContMain.grdData.rowcount)

		if DATAMANAGER.IsMoreNextData("obsap_deal_003r") == true then
			DATAMANAGER.RequestNextData("obsap_deal_003r")
		end if
		
		
	elseif Cint(sTimerID) = 2 then
		Form.SetTimerEvent2(2, 0, 1)
		Container1.FormTab0.currenttab = tmpCurrentab
		
		'v003. sta
'		if Instr(g_szOpenData, "88061") > 0  then
'			Container1.FormTab0.currenttab = 0 'v004. 화면ID와 통일시키기 위해 수정
'		
'		elseif Instr(g_szOpenData, "88062") > 0 then
'			Container1.FormTab0.currenttab = 1 'v004. 화면ID와 통일시키기 위해 수정
'		end if		
		'v003. fin
		
'		DATAMANAGER.RequestTranData( "obsap_deal_003r" )	'장외_전단채모집관리매수가능종목조회
		
		DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
		
	end if 
	
End Sub

