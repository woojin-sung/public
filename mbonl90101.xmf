	</CONTROL_INFO>
	<SCRIPT_INFO _len="43586" _ulen="39422" >
' v001. 전문투자자의 경우 모집상품없는 경우는 조회되도록 수정
' 2023.05.16. v002. 탭별로 화면오픈데이터 생성하도록 수정
'============================================================================
'2023.05.31. 김유경 : v001. 초기탭 변경
'2023.07.19. 김유경 : v003. URL에서 들어오는 경우 화면 연결을위해 로직 추가
'2023.07.21. 김유경 : v004. 초기탭 변경_유동화->메리츠단기사채
'============================================================================
' 단기사채 매매
'============================================================================


Dim g_Trgt_Cls_Code	'내성향맞춤구분

Dim unCheckImgPath 
Dim CheckImgPath

Dim nINVT_ABLE_AMT	'투자가능금액

'============================================================================

Dim g_plain_rm  		'v0002 메모리평문적용여부

Dim szKYC_INVT_INCL_GRAD_CODE
Dim szKYC_INVT_RCMD_CLS_CODE
Dim g_CUST_CLS_CODE
Dim g_szINVT_TRGT_TYPE_CODE	'유통물/발행물 구분

Dim g_szCsno 'v0004 고객번호
Dim g_szMtrtDate	'만기일자

Dim g_COMN_PFIN_YN	'전문투자자 여부
Dim szUSERID

Dim g_szOpenData		'v003
Dim tmpCurrentab

'============================================================================
Sub Form_OnFormInitBefore()
'	ImgBackPress.setMaintainingRatio("1")
'	imgList.setMaintainingRatio("1")
	
	Container1.imgCheck.setMaintainingRatio("1")
'	Container1.imgType.setMaintainingRatio("1")
	Container1.imgSort.setMaintainingRatio("1")
	
	Container0.ContMain.grdData.SetMaintainingRatio("badge_1", 0, "1")
	Container0.ContMain.grdData.SetMaintainingRatio("badge_2", 0, "1")
'	Container0.ContMain.grdData.SetMaintainingRatio("badge2", 0, "1")
	
	Container0.contCheck.imgFold.setMaintainingRatio("1")
	
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
''	Container1.imgType.left = 53
''	Container1.imgSort.left = 337
'	Container1.cmbSortGb.left = 270
	
    unCheckImgPath = "checkmenu_n.png"
    CheckImgPath   = "checkmenu_o.png"
    
	Container0.ContMain.grdData.setUseCardView(true, 8, "bg_listbox.9.png")
	
	'초기화..
	Container0.ContMain.grdData.visible = 1
	Container0.ContMain.lblNoData.visible = 0
	Container0.ContMain.imgBreakTime.visible = 0
	Container0.ContMain.tblBreakTime.visible = 0
	Container0.ContMain.tblBreakTime2.visible = 0
	Container0.ContMain.tblInvestCheck.visible = 0
	Container0.ContMain.lblInvestCheck.visible = 0
	Container0.ContMain.tblInvestCheck2.visible = 0
	Container0.contCheck.visible = 0
	Container0.Label999BG.visible = 0
	Container0.Label999.visible = 0
	
	'검색조건 초기화 '투자성향 없는 고객들은 수익률순 디폴트로 하고, 검색조건 비활성화
	Container1.cmbSortGb.enable = true
	Container1.imgSort.enable = true
	
	'TAB
	Container1.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	Container1.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	Container1.FormTab0.insertPage( Container1.FormTab0.tabcount, "page1", "page1", "empty", "0", "메리츠증권 단기사채")
	Container1.FormTab0.insertPage( Container1.FormTab0.tabcount, "page2", "page2", "empty", "0", "자산유동화 단기사채")
		
	'Container1.FormTab0.currenttab = 1 'v001. 초기탭 변경 0 -> 1
	
	szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	g_COMN_PFIN_YN = "N"
	g_Trgt_Cls_Code = "0"
	
	
	'Dim szOpenData
	g_szOpenData = Form.GetOpenLinkData()
	
	if g_szOpenData <> "" then
		if Instr(g_szOpenData, "88061") > 0  then
			'Container1.FormTab0.currenttab = 0 'v004. 화면ID와 통일시키기 위해 수정
			tmpCurrentab = 0
		
		elseif Instr(g_szOpenData, "88062") > 0 then
			'Container1.FormTab0.currenttab = 1 'v004. 화면ID와 통일시키기 위해 수정
			tmpCurrentab = 1
		end if	
		
		Form.SetTimerEvent2(2, 1, 1)
	else
		Container1.FormTab0.currenttab = 0 'v003 v004 1->0
'		DATAMANAGER.RequestTranData( "obsap_deal_003r" )	'장외_전단채모집관리매수가능종목조회
		
		DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
		
	end if


	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Container0.ContMain.setScrollBarVisible("2")
		Container0.contCheck.setScrollBarVisible("2")
		Container0.setScrollBarVisible("2")
	end if
	
	DATAMANAGER.RequestTranData("ohhts_open_001r")	'20230308 SWJ: 화면 오픈 횟수 집계
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 법인인 경우 HOME 화면으로 이동
	if sKeyName == "auth_check" then
		if sRet == "close" then
			Form.CloseForm()
			Exit Sub
		end if
	end if
End Sub

'============================================================================
Sub Container1_FormTab0_OnTabChanged(nCurrentTab)	
	'20230626 카테고리 바꿀시 스크롤 위치 최상단으로
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		Container0.ContMain.scroll_pos_noAni = 0
	else
		Container0.ContMain.scroll_pos = 0
	end if
	
	DATAMANAGER.RequestTranData( "obsap_deal_003r" )
	
	DATAMANAGER.RequestTranData("ohhts_open_001r")	'v002. 탭별로 화면오픈데이터 생성하도록 수정
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsap_deal_003r" then 
		if Container1.FormTab0.currenttab = 1 or Container1.FormTab0.currenttab = "1" then
			g_szINVT_TRGT_TYPE_CODE = 21	'유통물(자산유동화 단기사채)
		else
			g_szINVT_TRGT_TYPE_CODE = 20	'발행물(메리츠증권 단기사채)
		end if

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence )
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INVT_TRGT_TYPE_CODE" , 0 , g_szINVT_TRGT_TYPE_CODE )	'투자대상유형코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , Container1.cmbSortGb.cbkeydata )	'조회구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KOR_ISNM" , 0 , "%" )	'한글종목명
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRGT_CLS_CODE" , 0 , g_Trgt_Cls_Code )	'대상구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"	  , 0 , szUSERID)
	end if
	
	'20230308 SWJ START: 화면오픈횟수 집계
	if szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = szOSType + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		'v002. 탭별로 화면오픈데이터 생성하도록 수정 sta
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "88061") 	 '메뉴에 등록된 화면번호
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "M Pick") '하드코딩
		if Container1.FormTab0.currenttab = 0 or Container1.FormTab0.currenttab = "0" Then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO"   , 0 , "88061") 	 '메뉴에 등록된 화면번호
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "Bond365_당사발행단기사채") '하드코딩
		Elseif Container1.FormTab0.currenttab = 1 or Container1.FormTab0.currenttab = "1" Then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO"   , 0 , "88062") 	 '메뉴에 등록된 화면번호
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "Bond365_자산유동화단기사채") '하드코딩
		End If 
		'v002.fin
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) '최근 로그인 아이디
	end if
	'20230308 SWJ END
	
	if szTranID == "obcsb_acif_400r" then
		'고객번호
		g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_400r", "InBlock1", "CSNO" , 0 , g_szCsno)
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obsap_deal_003r" then
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ))

'		g_COMN_PFIN_YN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "COMN_PFIN_YN" , 0)
'g_COMN_PFIN_YN = "Y"		

