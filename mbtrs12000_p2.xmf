	<SCRIPT_INFO _len="34852" _ulen="33590" >

' 20160317 가격 Max : 7 (전요셉과장)

'============================================================================
' 화 면 명 : 주식주문_가격입력창
' 화면설명 : 주식주문 가격입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive
g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive = "", "", "", "", ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, nResult
	
	g_szReceive = ""
	szPrc  = edtPrc.caption
	szUnit = g_szUnit
	szHigh = edtHigh.caption
	szLow  = edtLow.caption
	szHyun = tblData.GetCellString(1, 0)

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szPrc) <> "" then
		if CDbl(szPrc) >= 9900000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	'=======================================================================
	'20221116 HWG START : (거래소 차세대) 호가단위 개선
	'=======================================================================
	'20231122 HSZ START:  (거래소 차세대) ETF,ETN 호가단위 개선
	'=======================================================================
	' ETN
	'=======================================================================
	if g_szMk == "Q" then
		if CDbl(szPrc) < 2000 then
			szUnit = 1
		elseif CDbl(szPrc) >= 2000 then
			szUnit = 5
		end if
	'=======================================================================
	' ELW
	'=======================================================================	
	elseif  g_szMk == "W" then
		szUnit = 5
		
	'=======================================================================
	' ETN/ELW 외
	'=======================================================================
	else
		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		'=======================================================================
		' ETF
		'=======================================================================
		if szInnerMk = "013" then
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif CDbl(szPrc) >= 2000 then
				szUnit = 5
			end if
	'20231122 HSZ END

		
		'=======================================================================
		' KOTC
		'=======================================================================
'		elseif szInnerMk = "025" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc)<  500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'			
'			if nGbn == 1 then
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 20000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 50
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 100
'				elseif CDbl(szPrc) = 100000 then
'					szUnit = 500
'				elseif CDbl(szPrc) = 500000 then
'					szUnit = 1000
'				end if
'			end if
		
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			if nGbn == 1 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
	end if
	'20221116 HWG END
	
	' 이전소스
'	'=======================================================================
'	' 20190403 LES START 호가단위 설정
'	'=======================================================================
'	if g_szMk == "J" or g_szMk == "T" then
'			
'		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
'			
'		'-------------------------------------------------------------------
'		'코스닥, 코넥스
'		'-------------------------------------------------------------------
'		if szInnerMk == "002" or szInnerMk == "033" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif CDbl(szPrc) >= 50000 then
'				szUnit = 100
'			end if
'				
'		'-------------------------------------------------------------------
'		'ETF
'		'-------------------------------------------------------------------
'		elseif szInnerMk = "013" then
'			szUnit = 5
'						
'		
'		'-------------------------------------------------------------------
'		'코스피, 신주인수권, 수익증권, K-OTC
'		'-------------------------------------------------------------------
'		else
'					
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc) < 500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'					
'		end if
'	
'	'-------------------------------------------------------------------
'	'ETN, ELW
'	'-------------------------------------------------------------------
'	elseif g_szMk == "Q" or g_szMk == "W" then
'		szUnit = 5
'					
'	end if
'	'20190403 LES END
'	
'	'=======================================================================
'	' 20220118 HSZ START - 클릭시 호가단위 설정 수정
'	'=======================================================================
'	if nGbn == 1 then
'		if g_szMk == "J" or g_szMk == "T" then
'			'-------------------------------------------------------------------
'			'코스닥, 코넥스
'			'-------------------------------------------------------------------
'			if szInnerMk == "002" or szInnerMk == "033" then
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 50
'				end if
'			'-------------------------------------------------------------------
'			'ETF
'			'-------------------------------------------------------------------
'			elseif szInnerMk = "013" then
'		
'			'-------------------------------------------------------------------
'			'코스피, 신주인수권, 수익증권, K-OTC
'			'-------------------------------------------------------------------
'			else
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 50
'				elseif CDbl(szPrc) = 100000 then
'					szUnit = 100
'				elseif CDbl(szPrc) = 500000 then
'					szUnit = 500
'				end if
'			end if
'		end if
'	end if
'	'20220118 HSZ END
	
	'=======================================================================
	' +,- 버튼 클릭시 동작 
	'=======================================================================		
	
	' ----------------------------------------------------------------------
	' ELW
	' ----------------------------------------------------------------------		
	if g_szMk = "W" then
		if Trim(szUnit) == "" then
			szUnit = "5"
		end if

		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then							
				szPrc = CDbl(szPrc) + CDbl(szUnit)
				
				nResult = CDbl(szPrc) Mod CDbl(szUnit)
				
				if nResult <> 0 then
					szPrc = CDbl(szPrc) - nResult
				end if				
			' - 버튼 클릭 ////////////////////////////	
			elseif nGbn == 1 then					
				if CDbl(szPrc) == 0 then		' 0상태에서 "-"선택시 현재가로 복귀
					szPrc = szHyun
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				
					nResult = CDbl(szPrc) Mod CDbl(szUnit)
					
					if nResult <> 0 then
						nResult = CDbl(szUnit) - nResult
						szPrc = CDbl(szPrc) + nResult
					end if					
				end if
			end if
		end if
	' ----------------------------------------------------------------------
	' 그외
	' ----------------------------------------------------------------------		
	else
		if Trim(szUnit) == "" then
			szUnit = "1"
		end if
		
		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then							
				
			'20210216 SWJ START : 신주인수권 가격 +/- 버튼 입력오류 수정(상한가, 하한가 항상 0이어서 생긴 오류)
				if Left(g_szCd,1) == "J" then
					
					szPrc = CDbl(szPrc) + CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
						szPrc = szHigh
					elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) + CDbl(szUnit)
					
						nResult = CDbl(szPrc) Mod CDbl(szUnit)
					
						if nResult <> 0 then
							szPrc = CDbl(szPrc) - nResult
						end if					
					end if
				end if
			' - 버튼 클릭 ////////////////////////////
			elseif nGbn == 1 then
			
				if Left(g_szCd,1) == "J" then
					
					szPrc = CDbl(szPrc) - CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
						szPrc = szHigh		
					elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) - CDbl(szUnit)
					
						nResult = CDbl(szPrc) Mod CDbl(szUnit)
					
						if nResult <> 0 then
							nResult = CDbl(szUnit) - nResult
							szPrc = CDbl(szPrc) + nResult
						end if
					end if
				end if
			end if
			'20210216 SWJ END
		end if
	end if
	
	Sum_Prc(szPrc)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nPlus)
	Dim szPrc
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = nPlus
	else
		szPrc = edtPrc.caption
		
	'	if Trim(szPrc) == "" then
	'		szPrc = 0
	'	end if	
		szPrc = szPrc & nPlus
		Sum_Prc(szPrc)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	else
		szPrc = edtPrc.caption	
		
		if Len(edtPrc.caption) > 0 then
			szPrc = edtPrc.caption & szPlus
			
			Sum_Prc(szPrc)
		end if
	end if
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData)
	'if Len(szData) < 16 then
	if Len(szData) < 8 then		' Max 7(20160317 전요셉과장)	
		edtPrc.caption = szData
	end if
End Function	

'============================================================================
' Request_Data
'============================================================================
Function Request_Data()
	if g_szType == "13" then
		DATAMANAGER.RequestTranData("ohhts_1181_001r")		' 시간외단일가(호가)	
	else
		DATAMANAGER.RequestTranData("ohhts_1001_005r")		' 현재가(호가&예상체결)	
	end if
End Function

