'============================================================================
'20220112 HSZ START
'좌측 전체가격 그리드
'============================================================================
Function Add_Prc()
	szSdpr = tblData0.GetCellString(1, 0)	'기준가
	szHyun = tblData0.GetCellString(1, 1)	'현재가
	szMaedo = tblData.GetCellString(1, 0)	'매도1호가
	szMaesu = tblData.GetCellString(3, 0)	'매수1차호가
	szMxpr = header.GetCellString(0, 1)		'상한가
	szLlam = foot.GetCellString(0, 1)		'하한가

	if szSdpr = null or szSdpr = "" then
		szSdpr = "0"
	end if
	
	if szHyun = null or szHyun = "" then
		szHyun = "0"
	end if
	
	if szMaedo = null or szMaedo = "" then
		szMaedo = "0"
	end if
	
	if szMaesu = null or szMaesu = "" then
		szMaesu = "0"
	end if
	
	if szMxpr = null or szMxpr = "" then
		szMxpr = "0"
	end if
	
	if szLlam = null or szLlam = "" then
		szLlam = "0"
	end if

	'상하한가 같을 경우 예외처리
	if szMxpr == szLlam then
		exit function 
	end if
	
	lBasP	= CLng(szSdpr)
	lCurP	= CLng(szHyun)
	lSellP	= CLng(szMaedo)
	lBuyP	= CLng(szMaesu)
	lMax		= CLng(szMxpr)
	lMin		= CLng(szLlam)
	
	iCurPRow = 0
	i = 0 		 			'가격개수 저장
	

	szStep = grd_Price(lMax)
	szPrc = lMax - szStep 	'시작가격

	while szPrc > lMin
		'전일대비율 계산
		debiVal = (szPrc - szSdpr) / szSdpr * 100
		debiVal = Round(debiVal,2)
		Cont0.grdPrc.AddRow()
		
		Cont0.grdPrc.SetCellData("bd_prc",i, szPrc)
		Cont0.grdPrc.SetCellData("bd_debi",i, debiVal)
		
		'색상 세팅
		if int(szPrc) > int(lBasP) then
			Cont0.grdPrc.SetCellFgColor("bd_prc",i, "10")
			Cont0.grdPrc.SetCellFgColor("bd_debi",i, "10")
		elseif int(szPrc) < int(lBasP) then
			Cont0.grdPrc.SetCellFgColor("bd_prc",i, "11")
			Cont0.grdPrc.SetCellFgColor("bd_debi",i, "11")
		end if 
		
		if int(szPrc) >= int(lSellP) then
			Cont0.grdPrc.SetCellBgColor("bd_prc",i, "44")
			Cont0.grdPrc.SetCellBgColor("bd_debi",i, "44")
		elseif int(szPrc) >= int(lBuyP) then
			Cont0.grdPrc.SetCellBgColor("bd_prc",i, "43")
			Cont0.grdPrc.SetCellBgColor("bd_debi",i, "43")
		end if 
		
		'현재가 행
		if szPrc = lCurP then
			iCurPRow = i
		end if
		
		szStep = grd_Price(szPrc)
		szPrc = szPrc - szStep
		i = i +1
	wend
	
'	현재가 가운데로
	Cont0.grdPrc.toprow = iCurPRow-4
End Function 

