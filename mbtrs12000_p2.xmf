'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
'	20220112 HSZ START : 좌측 전체가격 그리드 추가
	szOstype = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2") Android("1") 기타("9")
	if szOstype = "1" then
		foot.SetCellString(0, 0, "4")
	end if
'	20220112 HSZ END 

	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
	
		g_szReceive = "1"
		edtPrc.caption = tData(0)
		g_szCd   = tData(1)
		g_szMk   = tData(2)
		g_szUnit = tData(3)
		g_szType = tData(4)
		edtHigh.caption = tData(5)
		edtLow.caption  = tData(6)
		
		Request_Data()
	end if

End Sub

