				<CELL cell_ly="1,0,1,0" import="0,1,108;1,1,79" fgcolor="011:030080200" bgcolor="043:240249254" halign="2" line="0,0" fontsize="3" mask="0,0,,,0,,0,1,0,0,0" autofontsize="1" impidxs="" />
