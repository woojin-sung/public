'----------------------------------------------------------------------------
' 01. 화 면 명 : 서브_종목검색창
' 02. 화면설명 : 주식현재가 종목검색창
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

Dim g_szItemCode, g_szItemMarket,g_szMask

'============================================================================
Sub Form_OnFormInitBefore()
	
	ChartEx0.SetChartType("line")
	ChartEx0.SetPeriodType("1")
	ChartEx0.SetPeriodTime("5")
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'g_szItemCode = "175M9000"
	'g_szItemMarket = "CF"
	
	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	If sKey = "ITEMCODE" Then
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	

	If szTranID = "ohhts_3050_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
		
	ElseIf szTranID = "ohhts_5030_003r" then
		Dim szToday
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
	End If
	
End Sub
 
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	szCd = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_SHRN_ISCD" , 0)
	
	if szTranID == "ohhts_cfut_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCd)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim 	szItemCodeInfo
	Dim 	nPrice					'전일대비

	nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_PRDY_VRSS2" , 0 )
'	
	DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
	DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
	
	g_bMoveItem 	= true

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
	
		tmp = Split(sParam, "★")
		
		g_szItemCode   =  tmp(0)
		g_szMask = tmp(1)
		g_szItemMarket = 	Form.GetItemCodeInfo( g_szItemCode , "market")
		
		Set_MaskInfo(g_szMask)

		
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CF"			
		end if
		

		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	 end if

End Sub

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
	DATAMANAGER.RequestTranData( "ohhts_3080_007r" )
End Sub

'=============================================================================
' 미국달러선물인 경우 소수점 한자리 까지만 나타내기 위해 마스킹처리를 해준다.
'=============================================================================
Sub Set_MaskInfo(szMask)

	if szMask == 1 or szMask == "1" then
		tblHoga.SetCellMaskInfo(0, 0, "0,0,,,1,,1,1,0")
		tblHoga.SetCellMaskInfo(0, 3, "0,0,,,1,,1,1,0")
		
	elseif szMask == 2 or szMask == "2" then
		tblHoga.SetCellMaskInfo(0, 0, "0,0,,,1,,2,1,0")
		tblHoga.SetCellMaskInfo(0, 3, "0,0,,,1,,2,1,0")
		
	else
		tblHoga.SetCellMaskInfo(0, 0, "0,0,,,1,,0,1,0")
		tblHoga.SetCellMaskInfo(0, 3, "0,0,,,1,,0,1,0")
		
	end if
	

End Sub
