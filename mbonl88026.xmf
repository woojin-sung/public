'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCust_Num
Dim g_CUST_CLS_CODE
Dim g_UI_PFIN_YN
Dim g_PFIN_CLS_CODE

Dim g_PlainRm
Dim g_szSelectSrno, g_szAcno, g_szAsno
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'Function f_AddGridRegCell()
'	cont0.Grid0.AddRow()
'	cont0.Grid0.SetCellData("bd_acntinfo", CInt(cont0.Grid0.rowcount)-1, "서비스 신청 후 거래가 가능해요.\r\n거래하실 계좌를 등록해 주세요.")
'	cont0.Grid0.SetCellData("bd_btn", CInt(cont0.Grid0.rowcount)-1, "+")
'	cont0.Grid0.SetCellFgColor( "bd_btn", CInt(cont0.Grid0.rowcount)-1, "13" )
'End Function

'============================================================================
Function f_SetGrdHeight()
	dim nGrd_H, nGrdCell_H
	nGrdCell_H = 90
	nGrd_H = CInt(cont0.Grid0.rowcount) * nGrdCell_H
	cont0.Grid0.height = nGrd_H
End Function

'============================================================================
Function f_SetBtmContTop()
	dim nAcntCnt, nRowCnt
	nAcntCnt = CInt(cmbAccount.accountcount)
	nRowCnt = CInt(cont0.Grid0.rowcount)

	if nAcntCnt == 0 then
		'	신청가능 계좌가 없는 경우
		cont0.contAcct.visible = true
		cont0.contBtm.visible = false
	else
		'	신청가능 계좌가 있는 경우
		cont0.contAcct.visible = false
		
		if nAcntCnt == nRowCnt and nRowCnt > 0 then
			'	추가 계약 가능한 종합매매 계좌가 없는 경우
			cont0.contBtm.visible = false
		else
			cont0.contBtm.visible = true
			cont0.contBtm.top = CInt(cont0.Grid0.height)
		end if
	end if
End Function


'============================================================================
Sub Form_OnFormInit()
	lblTopText.fgcolor = "67"

	'암호화 버전
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE )
	cont0.Grid0.setUseCardView(true, 10, "img_bgbox.9.png")
	'고객번호
	dim szCust_Num
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴

	if szCust_Num <> "" and szCust_Num <> null then
		g_szCust_Num = szCust_Num
		DATAMANAGER.RequestTranData( "obcsb_acif_799r" )
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	'이미지 찌그러짐 방지
	cont0.Grid0.setMaintainingRatio("bd_cell3", 0, "1")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl88026_p1" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obpds_srvc_434r" )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항 아이콘 클릭 이벤트
	if sEventName == "INFO_CLICK" then 
		Form.OpenFramePopup("mbonl88026_p4", "", "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_799r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
	elseif szTranID == "obpds_srvc_434r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "092"	)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_799r" then
		g_CUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CUST_CLS_CODE", 0)
		g_UI_PFIN_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "UI_PFIN_YN", 0)
		g_PFIN_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "PFIN_CLS_CODE", 0)

		if g_UI_PFIN_YN == "Y" then
			'전문투자자
			DATAMANAGER.RequestTranData( "obpds_srvc_434r" )
		else
'			Form.MsgBox( "안내", "일반투자자는\nCDS 계약 신청이 불가능합니다.", szTranID, 6 )	
			Form.MsgBox( "안내", "CDS계약 신청은\n전문투자자만 가능합니다.\n전문투자자 신청 후 진행해주세요.", "Go_94002", 7, "전문투자자 신청", "취소" )
		end if
		
	elseif szTranID == "obpds_srvc_434r" then
		Dim nCnt, nGridCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" )

		if nCnt > 0 then			
			for i = 0 to nCnt-1 
				szAccNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ACNO" , i ) 	'계좌번호
				szAsNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ASNO" , i ) 	'계좌일련번호
				szDate = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "APLT_DATE" , i ) '신청일자
				szCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STPL_STAT_CLS_CODE" , i ) 	'약정상태구분코드

				szDate = Left(szDate,4).."."..Mid(szDate,5,2).."."..Right(szDate,2)
		
				szProdCd = Form.GetAccountInfo(szAccNo&szAsNo, "productcode")
				szProdText = Form.GetMetaData("상품코드", szProdCd)
	
				cont0.Grid0.SetCellData( "bd_cell0", i, "신청계좌")
				cont0.Grid0.SetCellData( "bd_cell2", i, Left(szAccNo,4).."-".. Right(szAccNo,4) .. "-" .. szAsNo)	' 계좌번호
				
				cont0.Grid0.SetCellData( "bd_cell1", i, "신청일" )

				if szCode == "03" then	'''03:승인대기
'				if szCode == "01" then	'test
					cont0.Grid0.SetCellImage( "bd_cell3", i, "standby_line_w.png" )		'''"img_bgbox_4.9.png"
					cont0.Grid0.SetCellData( "bd_cell3", i, "승인대기" )
				end if
				
				cont0.Grid0.SetCellData( "bd_cell4", i, szDate )	'신청일				
			next
		end if
	
		f_SetGrdHeight()
		f_SetBtmContTop()
		cont0.SetScrollAutoSize()
		g_szSelectSrno = ""
		g_szAcno = ""
		g_szAsno = ""
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg <> "" and szSubMsg <> null then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")" )
	else
		Form.ShowAlert("알림", szErrMsg )
	end if 
End Sub

'============================================================================
Sub cont0_contBtm_btnAdd_OnClick()
	Form.OpenPopup("mbonl88026_p1", "", "")
End Sub

'============================================================================
Sub cont0_contAcct_btnAcct_OnClick()
	'계좌개설하기 클릭
	dim sloginType
	sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )

	if Cint(sloginType) > 1 then
		sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
		Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
	else
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup("mbbdm85100", "", "")
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then	'로그아웃 후
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", "", "")
		end if
	elseif sKeyName == "Go_94002" then
		if sRet == "ok" then
			'지점심사신청 메뉴로 이동
			Form.OpenScreen("94002" , "")
			Form.CloseForm()
			Exit Sub
		else	'no
			Form.OpenMainMenuWithIndex(1,6,0)
		end if
	elseif sKeyName == "obcsb_acif_799r" then
		if sRet == "close" then
			Form.OpenMainMenuWithIndex(1,6,0)
		end if
	end if
End Sub

