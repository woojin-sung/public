Dim g_szData		'
Dim g_szList		'
Dim g_szUrl		'URL
Dim g_szFileName	'파일명
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	Form.SetScreenName( "상품세부안내" )
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	g_szFileName = "IBK_PRODMAN"&g_szList(3)&CDbl(g_szList(4))&".pdf"
	
	g_szUrl = "http://211.255.202.106/include/ocw/"&g_szFileName	'개발계
'	g_szUrl = "http://home.imeritz.com/include/ocw/"&g_szFileName	'운영계
	
	Form.OpenPdfViewer( g_szUrl, "")		'안드로이드 정상, IOS View 나타나지 않음
'	web0.urlpath = g_szUrl
	
End Sub

