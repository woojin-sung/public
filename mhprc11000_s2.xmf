' Move_ItemCode
'============================================================================
Function Move_ItemCode( szType )
	If szType = "Right" Then
		Form.ACRSetProp( "moveitem", "1" )
	ElseIf szType = "Left" Then
		Form.ACRSetProp( "moveitem", "-1" )
	End If
	
