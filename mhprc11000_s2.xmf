'============================================================================
' SetMarginRate
'============================================================================
Function SetMarginRate( nMARG_RATE )
	'20210823 HSZ START : CFD현재가 화면 추가
	if g_szScreenNo = "13100" or g_szScreenNo = "13200" or g_szScreenNo = "13220"  then	'20230821 주문2 추가
		exit function 
	end if
	'20210823 HSZ END
	
	Dim 	szItemCodeInfo

	Select Case g_szISSU_STAT_CLS_CODE
		Case "51"	
			szItemCodeInfo = "관" + nMARG_RATE + "%"		'관심종목
			tblHoga.SetCellFgColor( 1, 0, 131 )
		Case "52"
			szItemCodeInfo = "위" + nMARG_RATE + "%"		'투자위험
			tblHoga.SetCellFgColor( 1, 0, 131 )
		Case "53"		
			szItemCodeInfo = "경" + nMARG_RATE + "%"		'투자경고
			tblHoga.SetCellFgColor( 1, 0, 131 )
		Case "54"
			szItemCodeInfo = "주" + nMARG_RATE + "%"		'투자주의
			tblHoga.SetCellFgColor( 1, 0, 131 )
		Case "55"
			szItemCodeInfo = "신" + nMARG_RATE + "%"		'신용주문가능
			tblHoga.SetCellFgColor( 1, 0, 133 )
		Case "56"
			szItemCodeInfo = "신" + nMARG_RATE + "%"		'신용초과
			tblHoga.SetCellFgColor( 1, 0,  13 )
		Case "57"		
			szItemCodeInfo = "증" + nMARG_RATE + "%"		'증거금율
			tblHoga.SetCellFgColor( 1, 0, 128 )
		Case "58"		
			szItemCodeInfo = "정" + nMARG_RATE + "%"		'거래정지
			tblHoga.SetCellFgColor( 1, 0, 130 )
		Case "61"
			szItemCodeInfo = "정" + nMARG_RATE + "%"		'정리매매
			tblHoga.SetCellFgColor( 1, 0, 130 )
		Case "63"
			szItemCodeInfo = "과" + nMARG_RATE + "%"		'단기과열
			tblHoga.SetCellFgColor( 1, 0, 131 )
		Case "64"
			szItemCodeInfo = "환" + nMARG_RATE + "%"		'투자주의환기
			tblHoga.SetCellFgColor( 1, 0, 131 )
		
		'20200831 LES START 제도개선
		Case "65"
			szItemCodeInfo = "유" + nMARG_RATE + "%"		'투자유의
			tblHoga.SetCellFgColor( 1, 0, 131 )
		'20200831 LES END
			
	End Select
	
	'Form.ShowAlert(szItemCodeInfo, "")
	tblHoga.SetCellString( 1, 0, szItemCodeInfo )

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szCurtouch		 = Form.GetEnvData( "common.curtouch_swing" 		)	' 현재가 터치이동
	g_szSwingGroup	 = Form.GetEnvData( "common.curtouch_swing_group"	)	' 관심종목일경우 관심그룹키
	g_szInterest_cloud = Form.GetEnvData( "common.interest_cloud" 		)	' 관심종목동기화(0:로컬, 1:서버)
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 '20210823 HSZ
	
	If g_szCurtouch = "" Then
		g_szCurtouch = "0"
	End If
	
	If g_szSwingGroup = "" Then
		g_szSwingGroup = ""
	End If
	
	If g_szInterest_cloud = "" Then
		g_szInterest_cloud = "0"
	End If
	ChartEx0.SetChartType("line")
	ChartEx0.SetPeriodType("1")
	ChartEx0.SetPeriodTime("5")
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_bMoveItem 	= true
	g_nIndexItem = 0
'	Set_RotateItem()

	'20210823 HSZ START : CFD현재가 화면 추가
	if g_szScreenNo = "13100" or g_szScreenNo = "13200" or g_szScreenNo = "13220"  then	'20230821 주문2 추가
		ChartEx0.visible = false
		TblCFD.visible = true
	else
		TblCFD.visible = false
	end if
	'20210823 HSZ END
End Sub

'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then		
		If g_bMoveItem = true Then
			Request_Data(g_szType, sValue)
'			Set_RotateItem()
		End If
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	

	'Table Clear
	For i = 0 To 2
		For j = 0 To 3
			tblHoga.SetCellString( i, j, "")
		Next	
	Next

	DATAMANAGER.CancelRealData( "ohhts_marg_rate" )
'	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_stck_incg" ) '20220211 HSZ 시세속도 개선
	DATAMANAGER.CancelRealData( "ohhts_elw_cntg"  )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_ovtp_cntg" )

	If szTranID = "ohhts_1001_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
	
	ElseIf szTranID = "ohhts_1181_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
		
	ElseIf szTranID = "ohhts_5010_002r" then
		Dim szToday
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" 	, 0 , "0"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
	
	'20220607 SWJ START
	ElseIf szTranID = "obtrc_comm_017r" then
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "STND_DATE"					, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "ISCD" 						, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "MRKT_DIV_CLS_CODE"			, 0 , "%"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "STA_RATE"					, 0 , "0"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "FIN_RATE"					, 0 , "100"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "BYOV_ABLE_YN"				, 0 , "Y"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "SELN_ABLE_YN"				, 0 , "Y"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "EXLS_YN"					, 0 , "N"			)
	'20220607 SWJ END
	
	'20220823 SWJ START : 일반계좌인 경우만 증거금율 표출
	elseif szTranID = "obtrc_comm_004r" then
		DATAMANAGER.SetDataValue( false, "obtrc_comm_004r", "InBlock1", "ACNO" , 0 , g_ACNO )
		DATAMANAGER.SetDataValue( false, "obtrc_comm_004r", "InBlock1", "ASNO" , 0 , g_ASNO )
	'20220823 SWJ END
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	if szTranID = "ohhts_stck_incg" then '20220211 HSZ 시세속도 개선 (cntg->incg)
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )

	elseif szTranID = "ohhts_frbr_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_ovtp_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
	
	elseif szTranID = "ohhts_marg_rate" then
		DATAMANAGER.SetDataValue( 1, "ohhts_marg_rate", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_1001_001r" Then
		Dim	nMARG_RATE				'증거금율
		Dim 	nPrice					'전일대비

	
		g_szISSU_STAT_CLS_CODE 	= DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_ISSU_STAT_CLS_CODE" , 0 )
		nMARG_RATE				= CInt( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_MARG_RATE" , 0 ) )
		
		nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_PRDY_VRSS" , 0 )
		
'		SetHogaTblFgColor( CDbl( nPrice ) )			
		SetMarginRate( nMARG_RATE )
		
		if g_szItemMarket = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
			
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szItemMarket = "T" then
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
			
		else
'			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_stck_incg" ) '20220211 HSZ 시세속도 개선
		
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_marg_rate" )
'		DATAMANAGER.RequestTranData("ohhts_5010_002r"	 )
	ElseIf szTranID = "ohhts_1181_002r" Then
		DATAMANAGER.RequestRealData( "ohhts_ovtp_cntg" )
		
	ElseIf szTranID = "ohhts_5010_002r" Then		
		DATAMANAGER.RequestTranData( g_szTranID )
	
	'20220607 SWJ START : 서비스 변경
	'20210823 HSZ START : CFD현재가 화면 추가
	ElseIf szTranID = "obtrc_comm_017r" Then	
		cfd_buy = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "BYOV_ABLE_ACNT_CLCD"		, 0 )	
		cfd_sell = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "SELN_ABLE_ACNT_CLCD" 		, 0 )	
'		cfd_mrgt = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "CFD_MGRT" 			, 0 )
'		cfd_rgrp = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "CFD_ISSU_RISK_GRP_CODE" , 0 )
		
		'20230109 SWJ START : 양도소득 추가
		cfd_tax  = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "TRNF_INCM_TXTN_CLCD" 		, 0 )
		
		'비과세
		if cfd_tax = "0" then
			cfd_tax = "비과세"
		'과세 (기본값 : 1)
		else
			cfd_tax = "과세"
		end if
		'20230109 SWJ END
		
'		if cfd_buy = "Y" then
'			if cfd_mrgt <> "" then
'				if Cint(cfd_mrgt) = 40 then
'					if cfd_rgrp = "E" then
'						cfd_buy = "안심"
'					else
'						cfd_buy = "안심/일반"
'					end if
'				elseif Cint(cfd_mrgt) = 100 then
'					cfd_buy = "안심"
'				else
'					cfd_buy = ""
'				end if
'			end if
'		else
'			cfd_buy = "불가"
'		end if
'		
'		if cfd_sell = "Y" then
'			if cfd_rgrp = "E" then
'				cfd_sell = "불가"
'			else
'				cfd_sell = "일반"
'			end if
'		else
'			cfd_sell = "불가"
'		end if
		
		TblCFD.SetCellString(0, 1, cfd_buy)
		TblCFD.SetCellString(1, 1, cfd_sell)
		TblCFD.SetCellString(2, 1, cfd_tax)		'20230109 SWJ START
		
		TblCFD0.SetCellString(0, 1, cfd_buy)		'20220823 SWJ START
		TblCFD0.SetCellString(1, 1, cfd_sell)	'20220823 SWJ END
		TblCFD0.SetCellString(3, 1, cfd_tax)		'20230109 SWJ START
		
		'20230821 SWJ START : 신규매도인 경우 무조건 증거금율 100% 처리
		if g_sCurrentTab == 1 or g_sCurrentTab == "1"  then
			'20230829 htw start cfd주문2의 경우 신규매도인지 판단하는 값 추가
			if g_szRdoGbn == "" or g_szRdoGbn == "0" then
				TblCFD0.SetCellString( 2, 1, "100")
			end if
			'20230829 htw end
		end if
		'20230821 SWJ END
		
	'20210823 HSZ END
	'20220607 SWJ END
	
	'20220823 SWJ START : 일반계좌인 경우만 증거금율 표출
	elseif szTranID == "obtrc_comm_004r" then
		szAcnoAB = DATAMANAGER.GetDataValue( 0, "obtrc_comm_004r", "OutBlock1", "CFD_MARG_GRAD_CODE" , 0 ) 	'A:일반, B:안심
		
		if szAcnoAB = "A" then
			TblCFD.visible = false
			TblCFD0.visible = true	
		else
			TblCFD.visible = true
			TblCFD0.visible = false
		end if
		
		Form.SetSharedData("CFD_AcnoType", szAcnoAB)		'20230912 SWJ START
	'20220823 SWJ END
	End If
	
	g_bMoveItem 	= true
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim	nMARG_RATE				'증거금율

	If szTranID = "ohhts_marg_rate" Then
		nMARG_RATE = CInt( DATAMANAGER.GetDataValue( 1, "ohhts_marg_rate", "OutBlock1", "FIDR_MARG_RATE" , 0 ) )
		
		SetMarginRate( nMARG_RATE )
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szType

	if sEventName = "sharedata" then
		Dim szFlag
	
		sName = Form.GetItemCodeInfo(g_szItemCode, "name")
		sCurpirce = FormatNumber( tblHoga.GetCellString(0, 0),  0)
		
		If CDbl(tblHoga.GetCellString(0, 3)) > 0 Then
			szFlag	= "▲"			
		ElseIf CDbl(tblHoga.GetCellString(0, 3)) < 0 Then
			szFlag	= "▼"
		Else
			szFlag	= ""
		End If
		
		sDiff    = FormatNumber( abs(tblHoga.GetCellString(0, 3)),  0)		
		sRate     = FormatNumber( tblHoga.GetCellString(1, 2),  2)
		sQuqn	 = FormatNumber( tblHoga.GetCellString(1, 1),  0)
		szParam = sName.."\n"..sCurpirce.."원\n ("..szFlag..sDiff.." / "..sRate.."% / "..sQuqn..")"
		Form.triggerEvent("#", "sharedata", szParam)
	end if

	If sEventName = "12000_BUYTYPE" then
		szType = Form.GetSharedData("STOCK_BUYTYPE", false )
	ElseIf sEventName = "12000_SELTYPE" then
		szType = Form.GetSharedData("STOCK_SELTYPE", false )
	ElseIf sEventName = "12000_MODTYPE" then
		szType = Form.GetSharedData("STOCK_MODTYPE", false )
	ElseIf sEventName = "12000_CNLTYPE" then
		szType = Form.GetSharedData("STOCK_CNLTYPE", false )
	ElseIf sEventName = "HOGA_TYPE" then
		szType = sParam
	End If
	
	'20220823 SWJ START : 일반계좌인 경우만 증거금율 표출
	'Request_Data는 원래 있었고 분기 주석처리 함
	'if szType <> nil and szType <> "" and #szType > 0 then
		Request_Data(szType, g_szItemCode)
	'end if
	
	if sEventName == "13200_cfdmgrt" then
		
		Dim sTemp
		sTemp = split(sParam, "@")
		
		if Ubound(sTemp) < 2 then
			exit sub
		end if		
		
		g_ACNO = sTemp[0]
		g_ASNO = sTemp[1]
		g_sCurrentTab = sTemp[2]	'20230821 SWJ START : 추가
		
		if CInt(#sTemp) > 3 then
			g_szRdoGbn = sTemp[3]	'20230829 HTW START : 추가
		end if
		
		'20210823 HSZ START : CFD현재가 화면 추가
		if g_szScreenNo = "13100" or g_szScreenNo = "13200"  or g_szScreenNo = "13220"  then	'20230821 주문2 추가
			
			'20220607 SWJ START : 서비스 변경(매수, 매도별 가능 계좌유형 표시)
			DATAMANAGER.RequestTranData("obtrc_comm_017r"	 )
		end if
		'20210823 HSZ END
		'20230821 SWJ END
		
		DATAMANAGER.RequestTranData( "obtrc_comm_004r" )
		
	end if
	'20220823 SWJ END
End Sub



