'============================================================================
Sub proc_folding(bFold)
	Container0.setScrollAnimation(True)

	if bFold == False then
		sCaption = "접기"
		Container1.Image0.imgpath = "arrow_up"
		
		Container0.top 	= 120
		Container0.height	= 527 + 20
	else
		sCaption = "더보기"
		Container1.Image0.imgpath = "arrow_down"
		
		Container0.top = 290
		Container0.height = 250
	end if
	
	Container0.setScrollAutoSize()	
	Container1.Label13.caption = sCaption
End Sub

'============================================================================
Sub Container1_Label13_OnClick()
	if Container1.Label13.caption == "접기" then
		proc_folding(True)
	else
		proc_folding(False)
	end if
End Sub

'============================================================================
Sub Container1_Image0_OnClick()
	Container1_Label13_OnClick()
End Sub

'============================================================================
Sub Container1_btnFolding_OnClick()
	Container1_Label13_OnClick()
End Sub

