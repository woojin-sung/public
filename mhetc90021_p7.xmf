	<SCRIPT_INFO _len="6938" _ulen="6600" >
'375 X 647
'-------------------------------
'20220805_01 KBC : 로그인개선
'-------------------------------
'20230524 SWJ : 메리츠 간편인증 추가 및 UI 개선
'20240314_01 KBC 클라우드공동인증서 도입

'============================================================================
Sub Form_OnFormInit()
	proc_folding(True)
	
	sMockDealCheck = Form.GetEnvData("login.input.mockdeal")
	
	if sMockDealCheck == "1" then
		
		'20240724 SWJ START
'		Container0.lblBsns.visible = false
'		Container0.Label4.visible = false
'		Container0.lblCenter.visible = false
'		Container0.Label6.visible = false
'		Container0.lblMock.visible = false
		Container1.lblBsns.visible = false
		Container1.lblCenter.visible = false
		Container1.lblMock.visible = false
		'20240724 SWJ END
		
		Container0.lblTitle.caption = "실전투자 로그인 방식을 선택해주세요."
	end if
End Sub

'============================================================================
Sub Container0_btnBIO_OnClick()
	Form.SendReturnToParent( "Login_Cert_Type", "3" )		'바이오인증 로그인
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_btnCert_OnClick()
	Form.SendReturnToParent( "Login_Cert_Type", "1" )		'인증서 로그인
