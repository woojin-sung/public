'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImageBio.SetMaintainingRatio("1")
	Container0.ImageCert.SetMaintainingRatio("1")
	Container0.ImagePIN.SetMaintainingRatio("1")
	Container0.ImageID.SetMaintainingRatio("1")
	Container0.ImageCloudCert.SetMaintainingRatio("1") 	'20240314_01 KBC 클라우드공동인증서 도입
	
	Container0.ImgNext0.setMaintainingRatio("1")
	Container0.ImgNext1.setMaintainingRatio("1")
	Container0.ImgNext2.setMaintainingRatio("1")
	Container0.ImgNext3.setMaintainingRatio("1")
	Container0.ImgNext4.setMaintainingRatio("1")
	Container0.ImgNext5.setMaintainingRatio("1") 			'20240314_01 KBC 클라우드공동인증서 도입
	Container0.ImageClose.setMaintainingRatio("1")
End Sub

