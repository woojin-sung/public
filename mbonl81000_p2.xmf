'============================================================================
Sub ButtonView_OnClick()
	Form.OpenFramePopup(G_AGREE_FILE , "" , "")
	
End Sub

'============================================================================
Sub ButtonRequest_OnClick()
	if Table0.GetCellString( 0, 1 ) == "" then
		Form.MsgBox( "알림", "고객 연락처 변경 화면에서 휴대폰 번호를 입력하신 후 사용 가능합니다.", "", 6 )
		Exit Sub
	end if
	
	if ChkButton0.chksilence == "0" then
		Form.MsgBox( "알림", "본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다. ", "", 6 )
		Exit Sub
	end if
	
	g_nTryCnt = 0
	g_sSMSSeqNo = ""
	g_sSMSSeqNo1 = ""
	EditInput.enable = true
	DATAMANAGER.RequestTranData( "obcsb_oimf_613a" ) ''인증번호요청조회
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if ChkButton0.chksilence == "0" then
		Form.MsgBox( "알림", "본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다.", "", 6 )
		Exit Sub
	end if
	
	if g_sSMSSeqNo == "" then
		Form.MsgBox( "알림", "[인증번호 전송]을 실행해 주세요.", "", 6 )
		Exit Sub
	end if
	
	if EditInput.caption == "" then
		Form.MsgBox( "알림", "인증번호를 입력하세요.", "", 6 )
		Exit Sub
	end if
	
	g_nTryCnt = 0
	DATAMANAGER.RequestTranData( "obcsb_oimf_614a" ) '613a인증확인요청
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81000_p2" , g_sRetData)
End Sub

'16-03-11 YCJ 추가
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0 , 0, 1)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 40 then			'4~50초 정도만 적용해놓음
			Form.ShowAlert( "알림", "본인인증확인에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_614a_1" ) '613a인증확인요청
	
	elseif sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent( 1 , 0, 1)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 40 then			'4~50초 정도만 적용해놓음
			Form.ShowAlert( "알림", "본인인증확인에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) '인증번호확인요청
	
	end if	
End Sub

