'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객연락처변경
' 02. 화면설명 : 고객연락처변경_등록변경본인인증
' 03. 작    성 : 2016.01.25 김보라
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_608r,613a,614a,615r,638r IO 변경분 반영, obcsb_efif_250r 추가
'-------------------------------------------------------------------------------------------
'	Form.GetDeviceID()	 UI단말식별키
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID '고객ID
Dim g_sUserName '고객명
Dim g_sUserRCNO '고객주민번호
Dim g_sUserBirthDt 'v0001 주민번호앞6자리
Dim g_sSMSSeqNo 'SMS인증전문일련번호
Dim g_sSMSSeqNo1 'SMS인증전문일련번호
Dim g_nTryCnt  'SMS/ARS인증검증요청횟수
Dim G_AGREE_FILE '개인정보수집이용제공동의풀팝업

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sTemp, sRevData
	sRevData = Form.GetOpenLinkData()
	sTemp = Form.GetSharedData("mbonl81000_p1" , false)
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_sUserName = Form.GetSharedData("&USER_NAME" , false)
	g_sUserRCNO = Form.GetSharedData("&JUMIN_NUM" , false)  'v0001 메모리취약점보완이후 암호화된실명번호로 내려옴
	g_nTryCnt = 0
	g_sSMSSeqNo = ""
	g_sSMSSeqNo1 = ""
	g_sRetData = "cancel"
	G_AGREE_FILE = "mbonl81000_p6"
	
	if sTemp == null or sTemp == "" then
		Exit Sub
	end if
	
	if sRevData == "contact_regi" then
		Form.SetScreenName("휴대폰 등록 본인인증")
	elseif sRevData == "contact_modi" then
		Form.SetScreenName("휴대폰 변경 본인인증")
	end if

	sTemp = Split(sTemp, ";")
	LabelPhone1.caption = sTemp[0]
	LabelPhone2.caption = sTemp[1]
	LabelPhone3.caption = sTemp[2]
	Table0.SetCellString( 0, 1, sTemp[0]..sTemp[1]..sTemp[2] )
	Table0.SetCellString( 7, 1, g_sUserName )
	'v0001 실명번호암호화에 따라 서비스로 실명번호 조회
	'Table0.SetCellString( 8, 1, Left(g_sUserRCNO, 6) )
	if g_sUserID ~= null and Trim(g_sUserID) ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_efif_250r" )  '고객ID로 주민번호 조회	
	end if
	
	DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_AGREE_FILE then
		if sRet == "ok" then
			ChkButton0.chksilence = "1"
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	elseif szTranID == "obcsb_oimf_613a" then
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "2" )
		if RadioGroup0.currentindex == "0" then 'SKT
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "SKT" )
		elseif RadioGroup0.currentindex == "1" then 'KT
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "KT " )
		elseif RadioGroup0.currentindex == "2" then 'LG U+
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "LGT" )
		elseif RadioGroup0.currentindex == "3" then 'SKT 알뜰폰
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "AL " )
		elseif RadioGroup0.currentindex == "4" then 'KT 알뜰폰
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "KAL" )
		elseif RadioGroup0.currentindex == "5" then 'LG U+ 알뜰폰
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "MCCO_CODE" , 0 , "LAL" )
		end if		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_ARCD" , 0 , LabelPhone1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_TONO" , 0 , LabelPhone2.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "CLPH_SRNO" , 0 , LabelPhone3.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_613a", "InBlock1", "SVCD" , 0 , "000" )
	elseif szTranID == "obcsb_oimf_614a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "PROS_CLS" , 0 , "2" )
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a", "InBlock1", "SMS_ATHN_NO" , 0 , EditInput.caption )
	elseif szTranID == "obcsb_oimf_614a_1" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "PROS_CLS" , 0 , "1" )
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_614a_1", "InBlock1", "SMS_ATHN_NO" , 0 , "" )
	elseif szTranID == "obcsb_oimf_615r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "SMS_ATHN_NO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_615r", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo1 )
	elseif szTranID == "obcsb_efif_250r" then  'v0001 고객ID로 주민번호 조회
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_250r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		Dim CLPH_ARCD, CLPH_TONO, CLPH_SRNO
		CLPH_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_ARCD" , 0 )
		CLPH_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_TONO" , 0 )
		CLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_SRNO" , 0 )
		
		Table0.SetCellString( 6, 1, CLPH_ARCD..CLPH_TONO..CLPH_SRNO )
	elseif szTranID == "obcsb_oimf_613a" then
		g_sSMSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_613a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
		'16-03-11 YCJ 수정
		Form.SetTimerEvent( 0 , 1, 1)
'		g_nTryCnt = g_nTryCnt+1
'		if g_nTryCnt < 10 then
'			DATAMANAGER.RequestTranData( "obcsb_oimf_614a_1" ) '613a인증확인요청
'		else
'			g_nTryCnt = 0
'			g_sSMSSeqNo = ""
'			g_sSMSSeqNo1 = ""
'			EditInput.enable = false
'			Form.MsgBox( "알림", "본인인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'		end if
	elseif szTranID == "obcsb_oimf_614a" then
		g_sSMSSeqNo1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_614a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
		
		'16-03-11 YCJ 수정
		Form.SetTimerEvent( 1 , 1, 1)
'		g_nTryCnt = g_nTryCnt+1
'		if g_nTryCnt < 10 then
'			DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) '인증번호확인요청
'		else
'			g_nTryCnt = 0
'			Form.MsgBox( "알림", "SMS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'		end if
	elseif szTranID == "obcsb_oimf_614a_1" then
		g_sSMSSeqNo1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_614a_1", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
	elseif szTranID == "obcsb_oimf_615r" then
		g_sRetData = "ok"
		Form.CloseForm( )
	elseif szTranID == "obcsb_efif_250r" then 'v0001 고객ID로 주민번호 조회
	    Dim sMaskRcno, sRcno1
	    sMaskRcno = DATAMANAGER.GetDataValue( 0, "obcsb_efif_250r", "OutBlock1", "UI_RCNO" , 0 )  '마스킹실명번호
	    sRcno1 = Left(Replace(Trim(sMaskRcno), "-", ""), 6)
	    'TR에서 마스킹되어 내려오나 Table0 실명확인번호 마스킹 속성(-*******) 적용되어 있어 기존처럼 앞6자리만 매핑
	    Table0.SetCellString( 8, 1, sRcno1 )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_oimf_614a_1" then			'16-03-15 YCJ 수정
		if szErrCode == "3021" then
			Form.SetTimerEvent( 0 , 1, 1)
'			g_nTryCnt = g_nTryCnt+1
'			if g_nTryCnt < 10 then
'				DATAMANAGER.RequestTranData( "obcsb_oimf_614a_1" ) '613a인증확인요청
'			else
'				g_nTryCnt = 0
'				g_sSMSSeqNo = ""
'				g_sSMSSeqNo1 = ""
'				EditInput.enable = false
'				Form.MsgBox( "알림", "본인인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'			end if
'		else
'			g_nTryCnt = 0
'			g_sSMSSeqNo = ""
'			g_sSMSSeqNo1 = ""
'			EditInput.enable = false
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
	elseif szTranID == "obcsb_oimf_615r" then
		if szErrCode == "3021" then
			Form.SetTimerEvent( 1 , 1, 1)
'			g_nTryCnt = g_nTryCnt+1
'			if g_nTryCnt < 10 then
'				DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) '인증번호확인요청
'			else
'				g_nTryCnt = 0
