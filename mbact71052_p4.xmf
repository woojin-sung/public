'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_CMA
' 02. 화면설명 : 고객자산평가_상품별잔고_CMA
' 03. 작    성 : 2016. 02. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList

Dim g_nSelectRow
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "ACNO" , 0 , Left(g_szList(g_nAllCount), 8) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "PROS_CLS" , 0 , "1" )			'조회구분(전체)
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_080r" )
	else
		lblVisible()
	end if
 
	
End Function
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "06")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Function Asset_Request()
	'--------------------------------------------------------------
	' 전역변수 초기화
	'--------------------------------------------------------------	
	'대상계좌 개수 세팅
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	'서비스 날리기전 인덱스 초기화
	g_nNextCount = 0
	
	'--------------------------------------------------------------
	'서비스 호출
	'--------------------------------------------------------------
	'Y:전체 그외:개별

	if g_szList(1) == "Y" then
		cont0.grd1.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.ClearInputData(0, "obacb_balc_080r")
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "PROS_CLS" , 0 , "2" )	'조회구분(개별)
			
		DATAMANAGER.RequestTranData( "obacb_balc_080r" )
	end if
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	cont0.grd1.SetClear()
	
	if sEventName == "mbact71052_p4" then			'CMA
		g_szList = Split(sParam,"○")
	
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		'상단 카드뷰 평가금액 서비스 호출 후 자산조회
		call VltnAmt_Request()

	elseif sEventName == "p4_refresh" then
		call VltnAmt_Request()
	
	end if
'		g_nAcntCount = g_szList(0)		'계좌개수
'		
'		g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
'		
'		g_nNextCount = 0
'		
'		if g_szList(1) == "Y" then
'			cont0.grd1.rowcount = 0
'			AllSearch()
'		else
'			DATAMANAGER.ClearInputData(0, "obacb_balc_080r")
'			DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8) )	'계좌번호
'			DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )	'계좌번호
'			DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
'			DATAMANAGER.SetDataValue( 0 , "obacb_balc_080r", "InBlock1", "PROS_CLS" , 0 , "2" )	'조회구분(개별)
'			
'			DATAMANAGER.RequestTranData( "obacb_balc_080r" )
'		end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, TempCount
	Dim szUsdTemp0, szUsdTemp1, szUsdTemp2
	Dim szBuySeq, szBuyDate
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_080r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_080r", "OutBlock2")-1
			cont0.grd1.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "ACNO" , i)
			szTemp0 = Left(szTemp0, 4).."-"..Right(szTemp0, 4).."-"
			szTemp0 = szTemp0 & DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "ASNO" , i)	'계좌번호	
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "BYOV_AMT" , i)	'매수금액
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "TXAT_VLTN_AMT" , i)	'세후평가금액
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "APLY_MNRT" , i)	'적용금리
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "EXPR_DYNU" , i)	'경과일수
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "BYOV_DATE" , i)	'매수일
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "UI_ACNT_PRNM" , i))
			szTemp7 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "UI_ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			szTemp0 = szTemp0 & szTemp7
'			szTemp8 = CDbl(szTemp3) - CDbl(szTemp2) '평가손익
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "VLTN_PRLS_AMT" , i) '평가손익
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "ISCD" , i)	'종목코드
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "PROS_TRGT_CLS_CODE" , i)	'처리대상구분코드(슈퍼365 원화/외화 구분)
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "MTRT_DATE" , i)	'만기일자
			
			szUsdTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "IF_TR_AMT" , i)				'외화매수금액
			szUsdTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "FRCR_VLTN_AMT" , i)			'외화평가금액
			szUsdTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "FRCR_VLTN_PRLS_AMT" , i)		'외화평가손익
			
			szBuySeq		= DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "BYOV_SRNO" , i)				'매수일련번호
			szBuyDate	= DATAMANAGER.GetDataValue( 0 , "obacb_balc_080r", "OutBlock2", "BYOV_DATE" , i)				'매수일자
			
			cont0.grd1.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			cont0.grd1.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			cont0.grd1.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			cont0.grd1.SetCellData("bd_cell6", g_nNextCount , szTemp6)
			cont0.grd1.SetCellData("bd_cell7", g_nNextCount , szTemp7)
'			cont0.grd1.SetCellData("bd_cell8", g_nNextCount , szTemp8)
			cont0.grd1.SetCellData("bd_cell9", g_nNextCount , szTemp9)
			cont0.grd1.SetCellData("bd_cell25", g_nNextCount , szTemp10)
			cont0.grd1.SetCellData("bd_cell18", g_nNextCount , szTemp11)
			
			cont0.grd1.SetCellData("bd_cell12", g_nNextCount , szUsdTemp0)
			cont0.grd1.SetCellData("bd_cell13", g_nNextCount , szUsdTemp1)
			cont0.grd1.SetCellData("bd_cell15", g_nNextCount , szUsdTemp2)
			
			cont0.grd1.SetCellData("bd_cell16", g_nNextCount , szBuySeq)
			cont0.grd1.SetCellData("bd_cell17", g_nNextCount , szBuyDate)
			
'			if CInt(szTemp8) > 0 then
'				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "10")
'				cont0.grd1.SetCellData("bd_cell8", g_nNextCount, szTemp8)
'			elseif CInt(szTemp8) < 0 then
'				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "11")
'				cont0.grd1.SetCellData("bd_cell8", g_nNextCount, "-"&szTemp8)
'			end if	
			if CDBL(szTemp8) > 0 then
				cont0.grd1.SetCellData("bd_cell8", g_nNextCount , "+"..FormatNumber(szTemp8, 0))
				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "10")
			elseif CDBL(szTemp8) < 0 then
				cont0.grd1.SetCellData("bd_cell8", g_nNextCount , FormatNumber(szTemp8, 0))
				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell8", g_nNextCount , FormatNumber(szTemp8, 0))
				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "4")
			end if
			g_nNextCount = g_nNextCount + 1
		next
		
		cont0.grd1.rowcount = g_nNextCount
		
		if  DATAMANAGER.IsMoreNextData( "obacb_balc_080r" ) == True then 
				DATAMANAGER.RequestNextData( "obacb_balc_080r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if

	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		if CDBL(nPrlsamt) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsamt) < 0 then
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "4")
		end if
		call Asset_Request()
	
	'계좌번호로 ID연결여부 조회
	elseif szTranID == "obcsb_efif_264r" then
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ID_LNKN_YN" , 0)
		
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		Dim szType, szCurrType, szAcnt
		szTemp0 = cont0.grd1.GetCellData("bd_cell9", g_nSelectRow) '종목코드
		szTemp1 = cont0.grd1.GetCellData("bd_cell1", g_nSelectRow) '종목명
		szTemp2 = cont0.grd1.GetCellData("bd_cell3", g_nSelectRow) '평가금액
		szTemp3 = cont0.grd1.GetCellData("bd_cell2", g_nSelectRow) '매입금액
		szTemp4 = cont0.grd1.GetCellData("bd_cell8", g_nSelectRow) '평가손익
		szTemp5 = cont0.grd1.GetCellData("bd_cell4", g_nSelectRow) '약정금리
		szTemp6 = cont0.grd1.GetCellData("bd_cell6", g_nSelectRow) '매수일
		szTemp7 = cont0.grd1.GetCellData("bd_cell5", g_nSelectRow) '경과일수
		szTemp8 = cont0.grd1.GetCellData("bd_cell18", g_nSelectRow) '만기일
		
		szUsdTemp0 = cont0.grd1.GetCellData("bd_cell12", g_nSelectRow)
		szUsdTemp1 = cont0.grd1.GetCellData("bd_cell13", g_nSelectRow)
		szUsdTemp2 = cont0.grd1.GetCellData("bd_cell15", g_nSelectRow)
		
		szBuySeq = cont0.grd1.GetCellData("bd_cell16", g_nSelectRow)
		szBuyDate = cont0.grd1.GetCellData("bd_cell17", g_nSelectRow)
		
		szData0 = cont0.grd1.GetCellData("bd_cell1", g_nSelectRow)	'상품약어명
		szCurrType = cont0.grd1.GetCellData("bd_cell25", g_nSelectRow)	'처리대상구분코드(슈퍼365 원화/외화 구분)
		szAcnt = cont0.grd1.GetCellData("bd_cell0", g_nSelectRow)
		szAcnt = Left(szAcnt, 12)
		szAcnt = Replace(szAcnt, "-", "")
		
		If InStr(szData0, "슈퍼365") <> 0 Then
			szType = "0"
		Else
			szType = "1"
		End If
		
		Dim szSendData
		szSendData = szType & "|" & szCurrType & "|" & szTemp1 & "|" & szTemp2 & "|" & szTemp3 & "|" & szTemp4 & "|" & szTemp5 & "|" & szTemp6 & "|" & szTemp7 & "|" & szUsdTemp0 & "|" & szUsdTemp1 & "|" & szUsdTemp2 & "|" & szTemp0 & "|" & szBuySeq & "|" & szBuyDate & "|" & szAcnt & "|" & szTemp8
		
	'	szSendData = "0" & "|" & szTemp1 & "|" & szTemp2 & "|" & szTemp3 & "|" & szTemp4 & "|" & szTemp5 & "|" & szTemp6 & "|" & szTemp7
		
		Form.OpenPopupAnimation("mbact71052_ph", szSendData , "", "2") 
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	cont0.grd1.SetClear()
	Form.ShowAlert("알림", szErrMsg)
	g_nNextCount = 0
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
	'hsz
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
	'hsz
End Sub

'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.lblNone.visible = true
	else
		cont0.lblNone.visible = false
	end if
End Function 
