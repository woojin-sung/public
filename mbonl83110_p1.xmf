'============================================================================
Sub Form_OnFormInit()
	
	'showalert("init")
	'Tab0.currenttab = 0
	
	Dim szData
	
	Form.SetScreenName( "청약 정보 상세" )
	
	szData = Form.GetOpenLinkData()
	
	g_szList = Split(szData, "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	szSbscDate = g_szList(0)
	szSbscSrno = g_szList(1)
		
	DATAMANAGER.SetDataValue( 0, "obibk_psif_001r", "InBlock1", "SBSC_DATE" , 0 , szSbscDate)
	DATAMANAGER.SetDataValue( 0, "obibk_psif_001r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , szSbscSrno)
	DATAMANAGER.RequestTranData( "obibk_psif_001r" )
	
	DATAMANAGER.SetDataValue( 0, "obibk_pssb_005r", "InBlock1", "SBSC_DATE" , 0 , szSbscDate)
	DATAMANAGER.SetDataValue( 0, "obibk_pssb_005r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , szSbscSrno)
	DATAMANAGER.RequestTranData( "obibk_pssb_005r" )
	
	DATAMANAGER.SetDataValue( 0, "obibk_pssb_006r", "InBlock1", "SBSC_DATE" , 0 , szSbscDate)
	DATAMANAGER.SetDataValue( 0, "obibk_pssb_006r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , szSbscSrno)
	DATAMANAGER.RequestTranData( "obibk_pssb_006r" )
	
	
End Sub

Function SetTable()
	szSbscCls = DATAMANAGER.GetDataValue( 0 , "obibk_psif_001r", "OutBlock1", "SBSC_ISSU_CLS_CODE" , 0)
	szSbscClsName = Form.GetMetaData("청약종목구분코드", szSbscCls) 
	
	Tab0.page001812.Container0.Table0.SetCellString(0,2,szSbscClsName)
	
	'청약일자
	Dim szViewDate
	szStaDate = DATAMANAGER.GetDataValue( 0 , "obibk_psif_001r", "OutBlock2", "SBSC_STA_DATE" , 0)
	szFinDate = DATAMANAGER.GetDataValue( 0 , "obibk_psif_001r", "OutBlock2", "SBSC_FIN_DATE" , 0)
	szViewDate = Left(szStaDate,4) & "/" & MID(szStaDate,5,2) & "/" & MID(szStaDate,7,2)
	szViewDate = szViewDate & " ~ " & Left(szFinDate,4) & "/" & MID(szFinDate,5,2) & "/" & MID(szFinDate,7,2)
	Tab0.page001812.Container0.Table1.SetCellString(0,2,szViewDate)
	
End Function


'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obibk_psif_001r" then		
		SetTable()	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
End Sub

'============================================================================


'============================================================================
Sub Tab0_page005562_Container2_Grid11_OnScrollEnd()
	DATAMANAGER.RequestNextData("obibk_pssb_006r")
End Sub

