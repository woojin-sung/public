	<SCRIPT_INFO _len="1655" _ulen="1557" >
'============================================================================
Sub Button0_OnClick()
	if Check_Validation() <> false then
		Requset_TR()
	else
		Form.ShowAlert("안내", "응답하지 않는 설문항목이 있습니다.")
	end if
End Sub

'============================================================================
Function Check_Validation()


	Radio1 = Container0.RadioQ1.currentindex
	Radio2 = Container0.RadioQ2.currentindex
	Radio3 = Container0.RadioQ3.currentindex
	Radio4 = Container0.RadioQ4.currentindex
	Radio5 = Container0.RadioQ5.currentindex
	
	if Radio1 == -1 then
		return false
	elseif Radio2 == -1 then
		return false
	elseif Radio3 == -1 then
		return false
	elseif Radio4 == -1 then
		return false
	elseif Radio5 == -1 then
		return false
	end if
	
	return true

End Function

'============================================================================
Sub Requset_TR()

	szUserID = Form.GetSharedData("&USER_ID", 0)
	
	DATAMANAGER.SetDataValue(0, "obcpp_comm_004a", "InBlock1", "PROS_CLS_CODE" 	, 0 , "I")
	DATAMANAGER.SetDataValue(0, "obcpp_comm_004a", "InBlock1", "ELFN_ID" 		, 0 , szUserID)
	DATAMANAGER.RequestTranData("obcpp_comm_004a")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Form.ShowAlert("안내", "설문에 참여해주셔서 감사합니다.")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("안내", "금일 설문에 이미 참여하셨습니다.")
End Sub

