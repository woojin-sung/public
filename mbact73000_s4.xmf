			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "OLD_DRVN_LCNS_NO_PIP"     , 0 	, g_LISENCE_NUM 				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP", 0 	, g_LISENCE_NUM   			)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_SPFT_VLTN_SCOR" 	, 0 	, g_FEATURE_SCORE				)
			
