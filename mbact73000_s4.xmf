			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_RSLT_CLCD", 0  , sRSPNTYPECODE 	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "RCNO_PIP"                 , 0  , g_AFT_RCNO_PIP	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ACNO"                 	, 0  , szKakaoAcno	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_RCNO_PIP" , 0  , g_AFT_RCNO_PIP                  )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_CLS_CODE"           , 0  , g_IDNTF_CLS_CODE                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_RCNO_PIP"            , 0  , g_RCNO_PIP                      )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_FLNM"           	, 0  , Container0.EditName.caption     )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_IDNTF_FLNM"      	, 0  , g_NAME                          )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ISNC_DATE_PIP"            , 0  , Container0.EditIssueDate.caption)
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_ISNC_DATE_PIP"       , 0  , g_ISSU_DATE                     )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "OLD_DRVN_LCNS_NO_PIP"     , 0  , g_LISENCE_NUM                   )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP", 0  , g_LISENCE_NUM                   )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_SPFT_VLTN_SCOR" 	, 0  , g_FEATURE_SCORE                 )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "TR_DATE"         		, 0  , g_TR_DATE                       )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "OTSD_TR_UNIQ_NO" 		, 0  , g_OTSDTRUNIQNO                  )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_YN" 			, 0  , g_IDNTF_TORF_YN                 )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "SCR_TYPE_CLS_CODE" 		, 0  , "1"                             )
'			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1",  "REG_UNIQ_NO" 			, 0  , g_BDM_REG_UNIQ_NO	           )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_CMPR_PROS_YN" 		, 0  , "N"                             )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_BSWR_CLCD" 		, 0  , "01"                             )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_BSWR_DETL_CLCD" 		, 0  , "01"                             )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_BSWR_SCR_ID" 		, 0  , "mbact73000_s4"                             )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_BSWR_SCR_NO" 		, 0  , "73000"                             )
			
	'카카오뱅크 후속절차 관련추가
	'창구 신분증 등록
	Case "obaci_idvs_004a"
		Dim szRcnoPip, szSrno, szIdntfDate
		szRcnoPip 	= DATAMANAGER.GetDataValue(0, "obaci_idvs_003a" , "OutBlock1" , "RCNO_PIP" , 0)
		szSrno 		= DATAMANAGER.GetDataValue(0, "obaci_idvs_003a" , "OutBlock1" , "SRNO" , 0)
		szIdntfDate 	= DATAMANAGER.GetDataValue(0, "obaci_idvs_003a" , "OutBlock1" , "IDNTF_TORF_CNFR_DATE" , 0)
		
		DATAMANAGER.SetDataValue( 0, "obaci_idvs_004a", "InBlock1", "RCNO_PIP", 0  ,  szRcnoPip )
		DATAMANAGER.SetDataValue( 0, "obaci_idvs_004a", "InBlock1", "SRNO", 0  ,  szSrno )
		DATAMANAGER.SetDataValue( 0, "obaci_idvs_004a", "InBlock1", "IDNTF_TORF_CNFR_DATE", 0  ,  szIdntfDate )
		DATAMANAGER.SetDataValue( 0, "obaci_idvs_004a", "InBlock1", "UI_IMG_DATA", 0  ,  g_FEATURE )
		DATAMANAGER.SetDataValue( 0, "obaci_idvs_004a", "InBlock1", "ATCH_FILE_SIZE", 0  ,  g_FEATURE_LEN )
		DATAMANAGER.SetDataValue( 0, "obaci_idvs_004a", "InBlock1", "PROS_CLS_CODE", 0  ,  "I" )
	End Select
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_acct_158a" then
		
	'JMY Sta ---------------------------------------
	'비대면계좌개설(100), 비대면업무신청(0xx), 모바일OTP(3xx) 모두 진위확인 체크함
		g_AFT_RCNO_PIP = DATAMANAGER.GetDataValue(0, "obaci_acct_158a" , "OutBlock1" , "MDAF_RCNO_PIP" , 0)
		g_BIORetry = 0 '초기화
		sRSPNTYPECODE = ""
		DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		'Form.SetTimerEvent("1", 1, 30)
			
'	Elseif szTranID = "obaci_acct_049c" then 
'		
'		g_BDM_REG_STAG_CLS_CODE = DATAMANAGER.GetDataValue(0, "obaci_acct_049c" , "OutBlock1" , "REG_STAG_CLS_CODE", 0)	'등록단계구분코드
'		g_BDM_REG_UNIQ_NO 	 = DATAMANAGER.GetDataValue(0, "obaci_acct_049c" , "OutBlock1" , "REG_UNIQ_NO"      , 0)	'등록고유번호
'		
'		'공유변수 설정
'		User_SharedData_Set()
'		
'		DATAMANAGER.RequestTranData("obaci_acct_234a") 
	
'	Elseif szTranID = "obcsb_nmet_102c" then
'		g_BDM_REG_STAG_CLS_CODE = ""	'등록단계구분코드
'		g_BDM_REG_UNIQ_NO 	 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "REG_UNIQ_NO"      , 0)	'등록고유번호
'
'		'공유변수 설정
'		User_SharedData_Set()
'
'		strTitle = "알림"
'		strMsg = "신분증 전송이 완료 되었습니다."
'		strFlag = "complete"
'		Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")

'	ElseIf szTranID = "obaci_acct_234a" Then
'	
'		strTitle = "알림"
'		strMsg = "신분증 전송이 완료 되었습니다."
'		strFlag = "complete"
'		Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
'		
	'
	ElseIf szTranID = "obtss_idvs_001a" Then 
		
		'v0008 jsi start
		'Form.SetTimerEvent("1", 0, 30) '1:Set
		g_BIOTrName	= szTranID
		g_BIORetry	= 0
		'g_TR_DATE 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
		g_OTSDTRUNIQNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
		
		Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		'Form.SetTimerEvent(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
		
		'v0008 jsi end
	'v0008 jsi start
	ElseIf szTranID == "obtss_idvs_002a" Then	
		sCODE 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 		, 0)
		sCNTT 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		sRSPNTYPECODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_TYPE_CODE"	, 0) '0:정상 9:오류  8:수기허용 R:재시도
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		g_sRSPNMSG = DATAMANAGER.GetDataValue(0, "obtss_idvs_002a", "OutBlock1", "RSPN_MSG_CNTT" , 0)  'v0001 전역변수로 변경(sRSPNMSG -> g_sRSPNMSG)
		
		if sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry = g_BIORetry + 1
			
			if g_BIORetry >= 3 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry = 0 '초기화
				Exit Sub 
			end if 
			
			Form.SetTimerEvent(3,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			Exit Sub 
		end if
		
		'정상
		If sRSPNTYPECODE = "0" Then 
			
			g_TR_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
			
			'신분증진위확인여부
			g_IDNTF_TORF_YN = "Y" 		
			
			'v0001 진위확인 오류내역 생성추가
			DATAMANAGER.RequestTranData("obaci_idvs_003a")
		Else
		     '카카오뱅크 후속절차 관련
		     'obaci_idvs_003a 를 무조건 호출하게 변경됨
		     
		     'JMY 테스트-SKIP처리인경우, 정상으로 처리
			if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then								
				
				sRSPNTYPECODE = "0"   '진위확인유형
				g_IDNTF_TORF_YN = "Y" '신분증진위확인여부
				
				'v0001 진위확인 오류내역 생성추가
				DATAMANAGER.RequestTranData("obaci_idvs_003a")
				
			else
     			'v0001 신분증진위확인여부
				g_IDNTF_TORF_YN = "N"

			  'v0001 진위확인 오류내역 생성추가
			  DATAMANAGER.RequestTranData("obaci_idvs_003a")
			end if
		End If
	'v0008 jsi end
    'v0001 진위확인이력생성 
	ElseIf szTranID = "obaci_idvs_003a" Then	
		If sRSPNTYPECODE == "0" Then
			'카카오뱅크 후속절차 관련: 창구 신분증 등록
			DATAMANAGER.RequestTranData("obaci_idvs_004a")
		Else
			If sRSPNTYPECODE = "8" Then  '수기허용 
				'수기허용도 진위확인 오류로 처리함
				strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
			ElseIf sRSPNTYPECODE = "R" Then	'재시도
				strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
			ElseIf sRSPNTYPECODE = "9" Then	'오류
				strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
			ElseIf sRSPNTYPECODE = "7" Then		
				strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
			Else
				If Trim(g_sRSPNMSG) <> "" Then
					strMsg = g_sRSPNMSG
				Else
					strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
				End If
			End If
			
			Form.OpenPopup("mbbdm85122" , strMsg)
			Exit Sub
		End If
	
	'카카오뱅크 후속절차 관련추가 : 창구 신분증 등록
	ElseIf szTranID = "obaci_idvs_004a" Then	
		strTitle = "알림"
		strMsg = "신분증 전송이 완료 되었습니다."
		strFlag = "complete"
		Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID = "obaci_acct_158a" then
		
		If szErrCode = "4984" then
		
			strTitle = "알림"
			strMsg = "생년월일을 확인하세요.(주민번호 앞 6자리)"
			strFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
		Else 
			
			strMsg = "신분증 정보를 읽을 수 없습니다.다시 시도하여 주십시요."
			Form.OpenPopup("mbbdm85122" , strMsg)
			
		End If
					
	
'	elseif szTranID = "obaci_acct_049c" or szTranID = "obcsb_nmet_102c" then
'		
'		if szTranID = "obcsb_nmet_102c"  and (ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1) then
'			g_BDM_REG_STAG_CLS_CODE = ""	'등록단계구분코드
'			'g_BDM_REG_UNIQ_NO 	 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "REG_UNIQ_NO"      , 0)	'등록고유번호
'	
'			'공유변수 설정
'			User_SharedData_Set()
'	
'			strTitle = "알림"
'			strMsg = "신분증 전송이 완료 되었습니다."
'			strFlag = "complete"
'			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
'		else		
'			strMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
'			strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp
'			
'			Form.OpenPopup("mbbdm85122" , strMsg)
'		end if
		
	elseIf szTranID = "obtss_idvs_001a" or szTranID = "obtss_idvs_002a"  Then 
		
		'JMY Sta
		if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then
			
			'테스트_신분증인증SKip
		     'Form.SetTimerEvent("1", 0, 30)
			'obtss_idvs_002a 인경우 return fail 로 outblock이 세팅되지 않음
			'g_TR_DATE		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
			'g_OTSDTRUNIQNO	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
			sRSPNTYPECODE		= "0"	'0:정상 9:오류  8:수기허용 R:재시도			
			g_IDNTF_TORF_YN	= "Y"	'신분증진위확인여부
			
			'비대면계좌개설
'			if g_NMETBSWRGB == "100" then 
'				DATAMANAGER.RequestTranData("obaci_acct_049c")			
'			'비대면업무신청(0xx), 모바일OTP(3xX)
'			else 
'				DATAMANAGER.RequestTranData("obcsb_nmet_102c")
'			end if		
		'JMY Fin
		
			DATAMANAGER.RequestTranData("obaci_idvs_003a")
		
		else
			strMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
			
			strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp
			Form.OpenPopup("mbbdm85122" , strMsg)
	
		end if


'	elseif szTranID = "obaci_acct_234a" then
'		
'		strMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
'		
'		strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp
'		Form.OpenPopup("mbbdm85122" , strMsg)
	

		
    'v0001 진위확인이력생성 
	ElseIf szTranID = "obaci_idvs_003a" Then
         '이력생성중 오류인 경우인 경우 오류종료처리하지 않고, 진위확인오류로 처리함
	 
		'20230113 YHJ 추가
		if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then								
			sRSPNTYPECODE = "0"   '진위확인유형
			g_IDNTF_TORF_YN = "Y" '신분증진위확인여부
			
			strTitle = "알림"
			strMsg = "신분증 전송이 완료 되었습니다."
			strFlag = "complete"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")	
			
		else
			If sRSPNTYPECODE = "8" Then  '수기허용 
				'수기허용도 진위확인 오류로 처리함
				strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
			ElseIf sRSPNTYPECODE = "R" Then	'재시도
				strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
			ElseIf sRSPNTYPECODE = "9" Then	'오류
				strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
			ElseIf sRSPNTYPECODE = "7" Then		
				strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
			Else
				If Trim(g_sRSPNMSG) <> "" Then
					strMsg = g_sRSPNMSG
				Else
					strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
				End If
			End If
			
			Form.OpenPopup("mbbdm85122" , strMsg)
			Exit Sub
		end if

	end if
	
End Sub


