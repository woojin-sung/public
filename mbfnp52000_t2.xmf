	<SCRIPT_INFO _len="9601" _ulen="8887" >
'============================================================================
' 01. 화 면 명 : 발행어음매매_매도
' 02. 화면설명 : 발행어음매매_매도
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData				'발행어음매매에서 가져온 계좌및비밀번호
Dim g_szList				'
Dim g_szPW				'비밀번호
Dim g_nTabIndex			'탭Index
Dim g_nFlag				'최근 열어본 탭 Index
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' GoOrder() : 매수주문
'============================================================================
Function GoOrder()
	
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_216a", "InBlock1", "ACNO" , 0 , g_szList(0) ) 			'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_216a", "InBlock1", "ASNO" , 0 , g_szList(1) ) 			'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_216a", "InBlock1", "PWD" , 0 , g_szPW ) 				'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_216a", "InBlock1", "ISCD" , 0 , edtCode.caption ) 		'종목코드
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_216a", "InBlock1", "ISNT_NO" , 0 , edtNum.caption ) 		'어음번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_216a", "InBlock1", "INVT_AMT" , 0 , edtMoney.caption ) 	'원금
	
	DATAMANAGER.RequestTranData( "obsan_deal_216a" )

End Function
''============================================================================
'' TableClean() : 테이블 초기화
''============================================================================
'Function TableClean()
'	
'	for i = 0 to 3
'		tab0.page000506.tbl2.SetCellString( i, 1, "" )
'		tab0.page000506.tbl2.SetCellString( i, 3, "" )
'	next
'
'End Function
'============================================================================
' InputCheck() : 가계산 조건 체크
'============================================================================
Function InputCheck()
	
	if g_nTabIndex == 1 then
		
		if edtCode == "" then	
			Form.ShowAlert( "알림" , "종목코드를 입력해주세요.")
			Exit Function
		end if
	
		if edtNum.caption = "" then
			Form.ShowAlert( "알림" , "어음번호를 입력해주세요.")
			Exit Function
		end if
		
		if edtMoney.caption = "" then
			Form.ShowAlert( "알림" , "투자금액을 입력해주세요.")
			Exit Function
		end if
	elseif g_nTabIndex == 0 then
		Exit Function
	end if

	btnCalcul.enable = true
	
End Function
'============================================================================
' SetingClear() : 매도 Input 세팅값 초기화
'============================================================================
Function SetingClear()
	edtCode.caption = ""
	edtName.caption = ""
	edtNum.caption = ""
	edtMoney.caption = ""
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
'	g_nFlag = Form.LoadConfigData( "mbfnp52000_t2_Flag", "Flag" )			'마지막 열었던 폼 Index 불러옴
'	
'	g_nTabIndex = g_nFlag
'	tab0.currenttab = g_nFlag
	
	btnCalcul.enable = false
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbfnp52000" then
	
		If sParam = "" Or sParam = null Then
			Exit Sub
		End If
		
		g_szData = sParam
	end if
	
	g_szList = Split( g_szData, "★" )
	if UBOUND(g_szList) < 1 then
		Exit sub
	End if
	
	g_szPW = Form.GetEncData( g_szList(2) )			'비밀번호 암호화
	
	SetingClear()
	
'	if g_nFlag == 1 then
'		TableClean()			'테이블 초기화
'	else
'		Exit Sub
'	end if
	
	
End Sub
'============================================================================
' btn0_OnClick() : 잔고확인버튼
'============================================================================
Sub btn0_OnClick()
	
	if Form.GetCtlProp( "#edtPW", "caption") == "" or Form.GetCtlProp( "#edtPW", "caption") == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")
		Exit Sub
	end if
	
	Form.OpenFramePopup( "mbfnp52000_p3" , g_szData , sPosInfo)			'잔고확인 팝업
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szData			'잔고팝업에서 가져온 데이터
	Dim szList
	
	if sKeyName == "mbfnp52000_p3" then
		szData = sRet
		szList = Split(szData , "★")
		
		if UBOUND(szList) < 1 then
			Exit sub
		End if
		
		edtCode.caption = szList(0)			'종목코드
		edtName.caption = szList(1)			'종목명
		edtNum.caption = szList(2)			'어음번호
		edtMoney.caption = szList(3)		'원금
		
		grd1.SetCellData( "bd_cell0", 0, szList(1) )			'종목명
		grd1.SetCellData( "bd_cell1", 0, szList(3) )			'매수금액
		grd1.SetCellData( "bd_cell2", 0, szList(4) )			'투자기간
		grd1.SetCellData( "bd_cell3", 0, szList(5) )			'만기일자
		grd1.SetCellData( "bd_cell4", 0, szList(6) )			'이자금액
		grd1.SetCellData( "bd_cell5", 0, szList(7) )			'세금
		grd1.SetCellData( "bd_cell6", 0, szList(8) )			'세후계산
		grd1.SetCellData( "bd_cell7", 0, szList(9) )			'경과기간
		
		
		InputCheck()
		
	elseif sKeyName == "Ok" then
		GoOrder()
'		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)			'공인인증
'		Exit Sub
'	elseif sKeyName == "mhetc90060_p5" then
'		if sRet ~= "cancel" then
'			'매도주문
'			Call GoOrder()
'			Exit Sub
'		end if
'		Exit Sub
	end if
		
'	TableClean()
'	InputCheck()
	
End Sub
'============================================================================
' tab0_OnTabChanged(nCurrentTab)
'============================================================================

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsan_deal_214r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ACNO" , 0 , g_szList(0) )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ASNO" , 0 , g_szList(1) )			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ISCD" , 0 , edtCode.caption )			'종목코드
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ISNT_NO" , 0 , edtNum.caption )		'어음번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "INVT_AMT" , 0 , edtMoney.caption )	'원금(투자금액)
	
	end if
	
End Sub
'============================================================================
' btnMaeDo_OnClick()
'============================================================================
Sub btnMaeDo_OnClick()
	Dim szData
	
	szData = grd1.GetCellData( "bd_cell0", 0) & "★" & grd1.GetCellData( "bd_cell1", 0) & "★" &  grd1.GetCellData( "bd_cell2", 0) & "★" & 
	grd1.GetCellData( "bd_cell3", 0) & "★" &  grd1.GetCellData( "bd_cell4", 0) & "★" &  grd1.GetCellData( "bd_cell5", 0) & "★" & 
	grd1.GetCellData( "bd_cell6", 0) & "★" &  grd1.GetCellData( "bd_cell7", 0)
	
	if g_szPW == "" or g_szPW == Null or Form.GetCtlProp("#edtPW", "caption") == "" then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요")
		Exit Sub
	elseif edtCode.caption == "" then
		Form.ShowAlert( "알림", "종목코드를 입력하세요")
		Exit Sub
	end if
	
	Form.OpenPopup( "mbfnp52000_p4" , szData , sPosInfo)
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obsan_deal_216a" then
		Form.ShowAlert( "알림" , "매매처리가 완료되었습니다.")
		SetingClear()
	end if
	
End Sub

'============================================================================
Sub btnCalcul_OnClick()
	Dim szData
	
	'계좌번호, 일련번호, 종목코드Index, 투자일수, 매수금액(투자금액)
	szData = "mbfnp52000_t2" & "★" & g_szList(0) & "★" & g_szList(1) & "★" & edtCode.caption & "★" & edtNum.caption & "★" & edtMoney.caption
	
	Form.OpenPopup( "mbfnp52000_p7" , szData , sPosInfo)
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obsan_deal_216a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obsan_deal_216a" )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		SetingClear()
	end if
	
End Sub

