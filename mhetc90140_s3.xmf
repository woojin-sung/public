'============================================================================
'인증번호 만료기간 3분 타이머 초기화
Function InitCountTimer()
    contMain.lblAthnTime.caption = "3:00"
    contMain.lblAthnTime.visisle = False
    g_HPSec = 180
    Form.SetTimerEvent(2, 0, 1)  '3분타이머 종료
End Function
'============================================================================
Function CheckData()
    If Trim(contMain.edtName.caption) == "" Or Trim(contMain.edtName.caption) == null Then
        '(순서주의) 포커스후->Alert처리해야함
        Form.ShowAlert("오류", "이름을 입력해주시기 바랍니다.")
        return False
    Else
        '이름 공백 체크
        sStr = Len(contMain.edtName.Caption)
        sRplStr = Len(replace(contMain.edtName.caption, " " , ""))
        If sStr <> sRplStr Then
            Form.ShowAlert("오류", "이름을 입력해주시기 바랍니다.(공백 불가)")
            return False
        End If
    End If

    If Trim(contMain.edtRcno.caption) == "" Or Trim(contMain.edtRcno.caption) == null Then
        Form.ShowAlert("오류", "주민번호를 입력해주시기 바랍니다.")
        return False
    Else
        nLen = contMain.edtRcno.pwdlen
        If CInt(nLen) < 13 Then
            Form.ShowAlert("오류", "주민번호를 확인해주세요.(13자리)")
            return False
        End If
    End If

    If Trim(contMain.cmbMcco.caption) == "" Or Trim(contMain.cmbMcco.caption) == null Then
        Form.ShowAlert("오류", "통신사를 확인해주세요.")
        return False    
    End If
        '통신사확인 0.SKT 1.KT 2.LGU+ 3.SK알뜰 4.KT알뜰 5.LG알뜰
        nIdx = contMain.cmbMcco.currentindex


    If Trim(contMain.edtHPNo.caption) == "" Or Trim(contMain.edtHPNo.caption) == null Then
        Form.ShowAlert("오류", "휴대폰번호를 입력해주시기 바랍니다.")
        return False
    ElseIf Mid(contMain.edtHPNo.caption,1,2) <> "01" Then 
        Form.ShowAlert("오류", "휴대폰번호를 확인해주시기 바랍니다.")
        return False
    Else
        If Len(contMain.edtHPNo.Caption) < 10 Or Len(contMain.edtHPNo.Caption) > 11 Then
            Form.ShowAlert("오류", "휴대폰번호를 확인해주시기 바랍니다.")
            return False
        End If
    End If

    If CInt(contMain.chkCtcnAgrm.checkstate) < 1 Then  '0.uncheck 1.check
        Form.ShowAlert("안내", "휴대폰 본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다.")
        return False
    End If
    
    return True
end Function 

'============================================================================
Sub Button0_OnClick()
	if contMain.ChkButton0.checkstate = "1" then 'test skip
		Form.triggerEvent( "#", "NextStep", "1" )
	else
	    '필수항목체크
	    If CheckData() = True Then
			Form.triggerEvent( "#", "NextStep", "1" )
		End If
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()

	'테스트skip처리 숨김 유무
	nDev = Form.GetSharedData("&SERVER_MODE", false )
	if nDev == "1" then '테스트
		contMain.ChkButton0.visible = true	
		contMain.ChkButton0.enable = true
	else
		contMain.ChkButton0.visible = false	
		contMain.ChkButton0.enable = false	
	end if
	
	Button0.enable = False
	
    '재요청버튼 문구
    contMain.btnAthnRetry.caption = "재요청 >"
    contMain.btnAthnRetry.fgcolor = 267   '검은색
    
    
    '항목가이드 Default 설정 (267.검정색)
    contMain.edtName.SetApplyLabel   ("성명"         , 0, 267, "left", True)  'True.필수입력 / False.선택입력
    contMain.edtRcno.SetApplyLabel   ("주민등록번호" , 0, 267, "left", True)
    contMain.cmbMcco.SetApplyLabel   ("통신사"       , 0, 267, "left", True, 111) 'HWG
    contMain.edtHPNo.SetApplyLabel   ("휴대폰번호"   , 0, 267, "left", True)
    contMain.edtAthnNo.SetApplyLabel ("인증번호"     , 0, 267, "left", True)
    
    
End Sub

'============================================================================
Sub contMain_chkCtcnAgrm_OnChange(sCheckState)
'    If sCheckState == "1" Or sCheckState == 1 Then
'        contMain.chkCtcnAgrm.chkbtnimage = "check_square_on.png"
'	end if
	Form.OpenPopup("mbbdm85110_p1", "", "")
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
    
    '휴대폰 본인인증 약관동의 -----------------------------------------------
    If sKeyName == "mbbdm85110_p1"  Then
        If sRet == "ok" Then
            '약관동의 체크
            If contMain.chkCtcnAgrm.checkstate == "0" Or contMain.chkCtcnAgrm.checkstate == 0 Then  '0.uncheck 1.check
                contMain.chkCtcnAgrm.checkstate = "1"
            End If
        End If
	End if
End Sub

