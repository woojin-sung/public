'============================================================================
Sub contMain_edtName_OnEditComplete()
    g_Cntt1 = "Y"  '스크롤설정 체크용 변수 설정
	Dim nTop, nContResize
	nTop = 0
	nContResize = 0
	
	If contMain.edtName.caption ~= "" Or contMain.edtName.caption ~= null Then
        If Len(replace(ContMain.edtName.caption, " " , "")) == 0 Then
             Form.ShowAlert("오류","이름을 입력해주시기 바랍니다.")
		    contMain.edtName.Setstatus("focus")
             Exit Sub
        Else
            '이름 공백 체크
            sStr = Len(contMain.edtName.Caption)
            sRplStr = Len(replace(contMain.edtName.caption, " " , ""))
            If sStr <> sRplStr Then
                Form.ShowAlert("오류","이름을 확인해주시기 바랍니다.(공백 불가)")
			  contMain.edtName.Setstatus("focus")
                Exit Sub
             End If
        End If
	   
	   '스크롤 설정
        If g_Cntt2 == "Y" Then
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1"))
        Else
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + 90 'HWG 'CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        End If
        nTop = CInt(Form.calcUnResize(contMain.edtName.top, "1"))
        '항목을 위로 올리면서 스크롤을 늘리기 위해 컨테이너상의 마지막 컴포턴트 위치를 아래로 강제 처리함
        contMain.lblScrollPos.top = nContResize
        '스크롤사이즈 자동조정
        contMain.SetScrollAutoSize()
        '현재 스크롤위치 설정
        contMain.scroll_pos = nTop
	    g_Cntt2 = "Y"  '스크롤설정 체크용 변수 설정
	    
        '주민등록번호 입력키보드 자동보이기
        If contMain.edtRcno.caption == "" Or contMain.edtRcno.caption == null Then
             contMain.edtRcno.Setstatus("focus")
             contMain.edtRcno.SetShowKeypad(True)
        End If
    End if
End Sub
'============================================================================
Sub contMain_edtRcno_OnEditComplete() '주민등록번호
	Dim nTop, nContResize
	nTop = 0
	nContResize = 0
	
    If contMain.edtRcno.caption ~= "" Or contMain.edtRcno.caption ~= null Then
        '13자리 입력체크
        nLen = contMain.edtRcno.pwdlen
        If CInt(nLen) < 13  Or CInt(nLen) > 13 Then
            Form.ShowAlert("오류","주민등록번호 13자리를 입력해주세요.")
            Exit Sub
        End If
	
	  '고객번호 일치확인 로직
	   DATAMANAGER.SetDataValue( 0 , "obcsb_info_004r", "InBlock1", "RRNO_PIP" , 0 , contMain.edtRcno.caption)
	   DATAMANAGER.RequestTranData("obcsb_info_004r")
    End If
End Sub
'============================================================================
'앞 단계에서 인증한 고객번호와 비교
Function CHECK_CSNO()
	apiCSNOm = Form.GetSharedData("&MYDATA_MAP_CSNO", false )
	if g_trCSNO == apiCSNOm then
		CHECK_CSNO = true
		g_ChkCSNO = "true"
	else
		CHECK_CSNO = false
		g_ChkCSNO = "false"
	end if
End Function 
'============================================================================

Sub contMain_cmbMcco_OnEditComplete(iIndex)  '통신사
	Dim nTop, nContResize
	nTop = 0
	nContResize = 0
	
	'스크롤 설정
     If g_Cntt4 == "Y" Then
		nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1"))
     Else
	     nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + 90 'HWG 'CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
	End If
     nTop = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
     '항목을 위로 올리면서 스크롤을 늘리기 위해 컨테이너상의 마지막 컴포턴트 위치를 아래로 강제 처리함
     contMain.lblScrollPos.top = nContResize
     '스크롤사이즈 자동조정
     contMain.SetScrollAutoSize()
     '현재 스크롤위치 설정
     contMain.scroll_pos = nTop
     g_Cntt4 = "Y"  '스크롤설정 체크용 변수 설정

    If iIndex ~= "" Or iIndex ~= null Then
        '휴대폰번호 -입력키보드 자동보이기
        If contMain.edtHPNo.caption = "" Or contMain.edtHPNo.caption = null Then
		   contMain.edtHPNo.Setstatus("focus")
            contMain.edtHPNo.SetShowKeypad(True)
        End If
    End If
    
End Sub
'============================================================================
Sub contMain_edtHPNo_OnEditComplete()   '휴대폰번호
	Dim nTop, nContResize
	nTop = 0
	nContResize = 0
	
    If contMain.edtHPNo.caption ~= "" Or contMain.edtHPNo.caption ~= null Then
        '10자리 미만 또는 11자리 초과 또는 '0xx'가 아닌경우 입력시
        If Mid(contMain.edtHPNo.caption, 1, 2) ~= "01" Then
            Form.ShowAlert("오류","정확한 휴대폰번호를 입력해 주세요.")
            Exit Sub
        ElseIf Len(Trim(contMain.edtHPNo.caption)) < 10 Then
            Form.ShowAlert("오류","정확한 휴대폰번호를 입력해 주세요.")
            Exit Sub
        ElseIf Len(Trim(contMain.edtHPNo.caption)) > 11 Then
            Form.ShowAlert("오류","정확한 휴대폰번호를 입력해 주세요.")
            Exit Sub
        End If
		
        '스크롤 설정
        If g_Cntt5 == "Y" Then
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1"))
        Else
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + 90 'HWG 'CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        End If
        nTop = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
        '항목을 위로 올리면서 스크롤을 늘리기 위해 컨테이너상의 마지막 컴포턴트 위치를 아래로 강제 처리함
        contMain.lblScrollPos.top = nContResize
        '스크롤사이즈 자동조정
        contMain.SetScrollAutoSize()
        '현재 스크롤위치 설정
        contMain.scroll_pos = nTop
        g_Cntt5 = "Y"  '스크롤설정 체크용 변수 설정	     
	     
	     
		contMain_btnAthnRetry_OnClick()		
	End if
End Sub
'============================================================================
Sub contMain_edtAthnNo_OnEditComplete()  '인증번호
    If contMain.edtAthnNo.caption == "" Or contMain.edtAthnNo.caption == null Then
        Form.ShowAlert("오류","인증번호가 입력되지 않았습니다.")
        Exit Sub
    Else
        If Len(Trim(contMain.edtAthnNo.caption)) == 0 Then
            Form.ShowAlert("오류","인증번호가 입력되지 않았습니다.")
            Exit Sub
        ElseIf Len(Trim(contMain.edtAthnNo.caption)) > 0 And Len(Trim(contMain.edtAthnNo.caption)) < 6  Then
            Form.ShowAlert("오류","인증번호를 확인해주세요.(숫자 6자리)")
            Exit Sub
        End If
    End If

    '인증확인 요청검증
    DATAMANAGER.RequestTranData( "obcsb_oimf_654a_1")
End Sub

'============================================================================
' 본인인증용 타이머
Sub Form_OnTimerEvent(sTimerID)

    'sTimerID = 0 : 인증번호 요청
    'sTimerID = 1 : 인증확인 요청/요청검증
    'sTimerID = 2 : 인증유효시간
    'sTimerID = 3 : 단기다수계좌여부/대포통장명의인여부 확인
    'sTimerID = 4 : 사기계좌명의인여부 확인
    'sTimerID = 5 : 통신사콤보 자동펼치기
    '인증번호 요청 -------------------------------------------------------
    If  sTimerID == 0 Or sTimerID == "0" Then
        '인증요청 타이머종료
        Form.SetTimerEvent(0, 0, 1)

        '인증유효횟수 설정
        g_nCnt = CInt(g_nCnt) + 1

        '인증유효횟수 초과 체크
        If CInt(g_nCnt) > 10 Then
            Form.ShowAlert("오류", "본인인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
            Exit Sub
        End If

        '인증확인 요청
        DATAMANAGER.RequestTranData "obcsb_oimf_654a"
	
    '인증확인 요청검증 -------------------------------------------------------
    ElseIf sTimerID == 1 Or sTimerID == "1" Then
        '검증요청 타이머종료
        Form.SetTimerEvent(1, 0, 1)

'        '인증유효횟수 설정
        g_nCnt = CInt(g_nCnt)+1

        '인증유효횟수 초과 체크
        If CInt(g_nCnt) > 10 Then
            Form.ShowAlert("오류","SMS 검증요청이 실패하였습니다. 잠시 후 다시 시도해 주십시오.")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
            Exit Sub
        End If

        '인증결과 검증
        DATAMANAGER.RequestTranData "obcsb_oimf_655r"

    '휴대폰본인인증 유효시간(3분) -------------------------------------------------------
    ElseIf sTimerID == 2 Or sTimerID == "2" Then
        If g_HPSec == 0 Then
            Form.ShowAlert("오류","인증시간이 만료되었습니다. 다시 시도하여 주시기 바랍니다")

            '유효시간체크 종료
            Form.SetTimerEvent(2, 0, 1)

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
        Else
            Dim nMin, nSec
            nMin  = Int(CInt(g_HPSec) / 60 )
            nSec  = CInt(g_HPSec) Mod  60
            If Len(nSec) == 1 Then
                nSec = "0"..nSec
                nSec = nSec
            End If

            '#:##
            contMain.lblAthnTime.caption = nMin..":"..nSec
            g_HPSec = CInt(g_HPSec)-1
        End If
	
    '통신사콤보 포커싱 및 자동펼치기 -------------------------------------------------------
    ElseIf sTimerID = "5" Or sTimerID = 5 Then
        Form.SetTimerEvent2(sTimerID, 0, 0.8)

'Form.ShowAlert("a", contMain.cmbMcco.caption)
        If CInt(contMain.cmbMcco.currentindex) < 1 Then
            contMain.cmbMcco.openList()
        End If
    End If
End Sub 
'============================================================================
Sub Form_OnFormClose() 
    Button0.enable = False
End Sub

'============================================================================
Sub contMain_btnAthnRetry_OnClick()
    If CheckData() = True Then
        '기존 인증번호 Clear
        contMain.edtAthnNo.caption = ""
        contMain.edtAthnNo.enable  = True

        '타이머 초기화
        InitCountTimer()

        '기 인증처리 중인 전문정보 초기화
        edtRqstTlmsNo.caption  = ""
        edtVrfcTlmsNo.caption  = ""

        '재요청버튼 비활성화/숨김
        contMain.btnAthnRetry.visible  = False

        '(TOBE)임시난수번호 생성 X -> 암호화실명번호로 처리 / 미성년자,사망자,정보노출자 체크
        '(ASIS)임시난수번호 생성 및 미성년자,사망자,정보노출자 체크
        DATAMANAGER.RequestTranData( "obcsb_oimf_639a" )    
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    '오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null And Trim(strSubMsg) ~= "" Then
        strMsg2 = szErrMsg.."("..Trim(strSubMsg)..")"
        strMsg = szErrMsg.."\n"..Trim(strSubMsg)
    Else
        strMsg2 = szErrMsg
        strMsg = szErrMsg
    End If

    '미성년자,사망자,정보노출자 체크 -------------------------------------------
    If szTranID == "obcsb_oimf_639a"  Then
        '개설불가 안내 후, 종료
        strSetErrCode = ""
        If (g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1) Or (g_sz_SubNmetBswrGb == "0" Or g_sz_SubNmetBswrGb == 0) Then  '비대면계좌개설 '비대면업무신청
            If szErrCode == "6660" Or szErrCode == 6660 Then
'                If Trim(strSubMsg) == "미성년자는 계좌개설이 불가합니다." Then
'                    strSetErrCode = "03"
'                ElseIf Trim(strSubMsg) == "개인정보노출 등록 고객" Then
'                    strSetErrCode = "04"
'                ElseIf Trim(strSubMsg) == "외국인 및 재외국민 계좌개설 불가" Then
'                    strSetErrCode = "05"
'                ElseIf Trim(strSubMsg) == "재외국민 업무신청 불가" Then
'                    strSetErrCode = "06"
'                Else
'                    strSetErrCode = "00"
'                End If
'        
'                CommErrClose(strSetErrCode)
            Else
                'strSetErrCode = "00"
                Form.ShowAlert("오류", strMsg2)
            End If
        Elseif (g_sz_SubNmetBswrGb == "3" Or g_sz_SubNmetBswrGb == 3) Then 
            If szErrCode == "6660" Or szErrCode == 6660 Then
'                If Trim(strSubMsg) == "재외국민 업무신청 불가" Then
'                    strSetErrCode = "06"
'		           CommErrClose(strSetErrCode)
'                End If
            Else
                'strSetErrCode = "00"
                Form.ShowAlert("오류", strMsg2)
            End If
        Else
            Form.ShowAlert("오류", strMsg2)
        End If
        'CommErrClose(strSetErrCode)

    '인증번호 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_653a" Then
        Form.ShowAlert("오류",strMsg)

        '인증번호 재요청버튼 Show
        contMain.edtAthnNo.caption    = ""
        contMain.edtAthnNo.enable     = False
        contMain.btnAthnRetry.visible = True
        contMain.btnAthnRetry.enable  = True

    '인증확인 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a" Then
        If szErrCode == "3021" Or szErrCode == 3021 Then
            '전문미수신인경우, 인증번호 재요청(타이머 실행)
            Form.SetTimerEvent(0, 1, 1)
        Else
            Form.ShowAlert("오류",strMsg)

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True
        End If

    '인증확인 요청검증 ---------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a_1" Then
       Form.ShowAlert("오류",strMsg)

        '인증번호 재요청버튼 Show
        contMain.edtAthnNo.caption    = ""
        contMain.edtAthnNo.enable     = False
        contMain.btnAthnRetry.visible = True
        contMain.btnAthnRetry.enable  = True

    '인증결과 검증 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_655r" Then
        If szErrCode == "3021" Or szErrCode == 3021 Then        
            '전문미수신인경우, 인증확인 요청검증 재요청(타이머 실행)
            Form.SetTimerEvent(1, 1, 1)
        Else
            Form.ShowAlert("오류",strMsg)

            '인증번호 재요청버튼 Show
            'contMain.edtAthnNo.caption    = ""
            'contMain.edtAthnNo.enable     = True  'False 
            If contMain.lblAthnTime.caption == "3:00" And CInt(g_HPSec) = 180 Then
                contMain.edtAthnNo.caption    = ""
                contMain.edtAthnNo.enable     = True
                contMain.btnAthnRetry.visible = True
                contMain.btnAthnRetry.enable  = True
            Else
                '인증번호체크중 오류인 경우에는 인증유효시간까지 재입력가능
                contMain.btnAthnRetry.visible = False
                contMain.btnAthnRetry.enable  = False
            End if
        End If
	ElseIf szTranID == "obcsb_info_004r" Then
		Form.ShowAlert("알림", "고객정보가 일치하지 않습니다.")
	
		contMain.cmbMcco.enable = false
		contMain.edtHPNo.enable = false
		contMain.edtAthnNo.enable = false
		Button0.enable = false
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    '미성년자,사망자,정보노출자 체크 --------------------------------------------------------------
    If szTranID == "obcsb_oimf_639a" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"      , 0, contMain.edtRcno.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0, "1"  ) '당사고객임
    '인증번호 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_653a" Then
        '인증검증건수 초기화
        g_nCnt = 0
    
        '요청전문번호/검증전문번호 초기화
        edtRqstTlmsNo.caption = ""
        edtVrfcTlmsNo.caption = ""

        '통신사확인(인증프로그램에서 체크하는 2자리로만 매핑)
        strRd = contMain.cmbMcco.currentindex
        If strRd == "0" Or strRd == 0 Then
            strRd_Key = "SKT"  'SKT    -메타값 STK
        ElseIf strRd == "1" Or strRd == 1 Then
            strRd_Key = "KT"  'KT   -메타값 KTF
        ElseIf strRd == "2" Or strRd == 2 Then
            strRd_Key = "LGT"  'LGU+ -메타값 LGT
        ElseIf strRd == "3" Or strRd == 3 Then
            strRd_Key = "AL"  'SK알뜰 -메타값 SKA
        ElseIf strRd == "4" Or strRd == 4 Then
            strRd_Key = "KAL"  'KT알뜰 -메타값 KTA
        ElseIf strRd == "5" Or strRd == 5 Then
            strRd_Key = "LAL"  'LGU+알뜰 -메타값 LGA
        End If

        '휴대폰번호
        If Len(Trim(contMain.edtHPNo.caption)) == 10 Then  '###-###-####
            strArcd = mid(Trim(contMain.edtHPNo.caption), 1, 3)
            strTono = mid(Trim(contMain.edtHPNo.caption), 4, 3)
            strSrno = mid(Trim(contMain.edtHPNo.caption), 7, 4)
        Else  '###-####-####
            strArcd = mid(Trim(contMain.edtHPNo.caption), 1, 3)
            strTono = mid(Trim(contMain.edtHPNo.caption), 4, 4)
            strSrno = mid(Trim(contMain.edtHPNo.caption), 8, 4)
        End If

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"       , 0, " "                      )  '빈값
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "2"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MCCO_CODE"      , 0, strRd_Key                )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD"           , 0, "000"                    )  '000.일반업무 인증
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"		   , 0, contMain.edtRcno.caption		 )  '암호화주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNM"           , 0, contMain.edtName.caption 		 )  '고객명
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_ARCD"      , 0, strArcd                  )  '휴대폰번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TONO"      , 0, strTono                  )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_SRNO"      , 0, strSrno                  )

    '인증확인 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a" Then
        '인증검증건수 초기화
        'g_nCnt = 0

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"            , 0, "1"                      )  '1.응답코드조회
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD"      , 0, "2"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMS_ATHN_NO"         , 0, ""                       )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"            , 0, contMain.edtRcno.caption 		 )  '암호화주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0, edtRqstTlmsNo.caption    )  '인증번호요청전문번호

    '인증확인 요청검증 ---------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a_1" Then
        '요청검증전문번호 초기화
        edtVrfcTlmsNo.caption = ""

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"            , 0, "2"                        )  '2.확인 전송
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD"      , 0, "2"                        )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"            , 0, contMain.edtRcno.caption   		   )  '암호화주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0, edtRqstTlmsNo.caption      )  '인증번호요청전문번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMS_ATHN_NO"         , 0, contMain.edtAthnNo.caption 		   )  '인증번호

    '인증결과 검증 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_655r" Then
        '인증검증건수 초기화
        'g_nCnt = 0

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"             , 0, " "                        )  'SPACE
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD"       , 0, "2"                        )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"	         , 0, contMain.edtRcno.caption   			)  '암호화주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NICE_ISTU_TLMS_MNNO"  , 0, edtVrfcTlmsNo.caption      )  '인증번호검증전문번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMS_ATHN_NO"          , 0, contMain.edtAthnNo.caption 		)  '인증번호

	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    '미성년자,사망자,정보노출자 체크 -------------------------------------------
    If szTranID == "obcsb_oimf_639a" Then
        DATAMANAGER.RequestTranData( "obcsb_oimf_653a" )
    '인증번호 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_653a" Then  
        '요청전문번호 설정
        sTemp = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "NICE_ISTU_TLMS_MNNO", 0)
        edtRqstTlmsNo.caption = Trim(sTemp)

        '인증번호 요청 타이머실행
        Form.SetTimerEvent(0, 1, 1)

    '인증확인 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a" Then
        Form.ShowAlert("확인", "인증번호가 정상적으로 발송 되었습니다.")
    
        g_HPSec = 180             '인증가능시간설정
        Form.SetTimerEvent(2, 1, 1)

    '인증확인 요청검증 ---------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a_1" Then
        '인증확인 요청전문번호 설정
         sTemp = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "NICE_ISTU_TLMS_MNNO", 0)
         edtVrfcTlmsNo.caption = Trim(sTemp)

         '인증확인 요청검증 타이머실행
         Form.SetTimerEvent(1, 1, 1)

    '인증결과 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_655r" Then
        g_CIKeyNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CIKEY_NO", 0)

        '3분 타이머 초기화
        InitCountTimer()

        '인증완료 메시지 표시
        Form.ShowAlert("확인","인증되었습니다.")

'        '인증이 정상적으로 처리된 후, 정보 변경 못하도록 전체 비활성화(보안성 보완)
'        edtName.enable      = False
'        edtRcno.enable      = False
'        cmbMcco.enable      = False
'        contMain.edtHPNo.enable      = False
'        contMain.btnCtcnAgrm.enable  = False
'        contMain.chkCtcnAgrm.bringFront("1")   '(IOS)인증완료후, 비활성화를 위해 제일 앞단으로 위치 (순서주의! btnCtcnAgrm 처리후해야함)
'        contMain.chkCtcnAgrm.enable  = False
'        contMain.imgAthnShow.enable  = False
'        contMain.edtAthnNo.enable    = False
'        contMain.btnAthnRetry.enable = False

        contMain.btnAthnRetry.visibe = False  '재요청버튼은 hidden
        contMain.lblAthnTime.visibe  = False  '인증유효시간 hidden
       
        '확인버튼 활성화
	   Button0.enable = True
    '인증결과 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_info_004r" Then
	    g_trCSNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO", 0)
	    
	   CHECK_CSNO()
	   if g_ChkCSNO = "false" then
	   
		   contMain.cmbMcco.enable = false
		   contMain.edtHPNo.enable = false
		   contMain.edtAthnNo.enable = false
		   Button0.enable = false

		   Form.ShowAlert("알림", "고객정보가 일치하지 않습니다.")
		   exit Sub
	   else
		   contMain.cmbMcco.enable = true
		   contMain.edtHPNo.enable = true
		   contMain.edtAthnNo.enable = true

	   end if
	   
		'스크롤 설정
        If g_Cntt3 == "Y" Then
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1"))
        Else
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + 90 'HWG 'CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        End If
        nTop = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        '항목을 위로 올리면서 스크롤을 늘리기 위해 컨테이너상의 마지막 컴포턴트 위치를 아래로 강제 처리함
        contMain.lblScrollPos.top = nContResize
        '스크롤사이즈 자동조정
        contMain.SetScrollAutoSize()
        '현재 스크롤위치 설정
        contMain.scroll_pos = nTop
	   g_Cntt3 = "Y"  '스크롤설정 체크용 변수 설정
	   
	   'If contMain.cmbMcco.cbkeydata == "" Or contMain.cmbMcco.cbkeydata == null Then
        Form.SetTimerEvent2(5, 1, 0.8)
'        cmbMcco.Setstatus("focus")
'        If CInt(contMain.cmbMcco.currentindex) < 1 Then
'            contMain.cmbMcco.openList()
'        End If
    
    End if
End Sub 

'============================================================================
Sub ContMain_ChkButton0_OnChange(sCheckState)
	if sCheckState = "1" then
		Button0.enable = true
	else
		Button0.enable = false
	end if
End Sub


