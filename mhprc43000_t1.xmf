'============================================================================
' DATAMANAGER_OnReceiveRealComplete(szTranID) : 실시간 데이터 연결
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim sKetMartket	'마켓코드
	Dim szDiv		'투자자구분코드

	if szTranID == "ohhts_invr_indv" then 
		
		sKetMartket = Left( DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE" , 0), 6 )		
		szDiv = Right( DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE" , 0), 4 )		
		
		Select Case sKetMartket
			Case g_tMcode(0)	
				Call SetTableDataReal(1 , szDiv,1 )
			Case g_tMcode(1)
				Call SetTableDataReal(4 , szDiv,1 )
			Case g_tMcode(2)	
				Call SetTableDataReal(7 , szDiv,2 )
			Case g_tMcode(3)
				Call SetTableDataReal(10, szDiv,3 )
			Case g_tMcode(4)
				Call SetTableDataReal(13, szDiv,4 )
			
			
			'20190304 LES START 주식선물 추가
			Case g_tMcode(5)
				Call SetTableDataReal(16, szDiv, 5)
			'20190304 LES END
			
			'20190902 위클리 업데이트 Start
			Case g_tMcode(6)
				Call SetTableDataReal(19, szDiv, 6)
			Case g_tMcode(7)
				Call SetTableDataReal(22, szDiv, 7)
			Case g_tMcode(8)
				Call SetTableDataReal(25, szDiv, 8)
			Case g_tMcode(9)
				Call SetTableDataReal(28, szDiv, 9)
			Case g_tMcode(10)
				Call SetTableDataReal(31, szDiv, 10)
			'20190902 End
		End Select
		
	end if

End Sub

