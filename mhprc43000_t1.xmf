'============================================================================
' SetTableDataReal(MarKetIndex,InvDiv,CboIndex) : 마켓코드, 투자자구분코드, 옵션구분Index를 받아와 조건에 따른 실시간 TR 연결
'============================================================================
Sub SetTableDataReal(MarKetIndex,InvDiv,CboIndex)
    Dim i, j, FieldName, RadDiv, nIndex
    Dim sData_RSELN, sData_RSHNU, sData_RNTBY, szData, szData_1, szData_2
    
    Select Case InvDiv	'투자자구분
	    Case "8000"
		    nIndex = 3
	    Case "9100"
		    nIndex = 4
	    Case "8888"
		    nIndex = 5
	    Case "1000"
		    nIndex = 6
	    Case "2000"
		    nIndex = 7
	    Case "3000"
		    nIndex = 8
	    Case "5000"
		    nIndex = 9
	    Case "4000"
		    nIndex = 10
	    Case "6000"
		    nIndex = 11
	    Case "3100"
		    nIndex = 12
	    Case "7000"
		    nIndex = 13
	    Case "7100"
		    nIndex = 14
    End Select
    
    
	if CboIndex == 1 then	'1이면 코스피, 코스닥 거래대금 실시간 TR 세팅
		sData_RSELN = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(0)+g_tTradekind(0) , 0 )
		sData_RSHNU = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(1)+g_tTradekind(0) , 0 )
		sData_RNTBY = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(2)+g_tTradekind(0) , 0 )
		
		szData = Array(sData_RSELN, sData_RSHNU, sData_RNTBY)
		
		for i = 0 to 2
			ctn0.grd0.SetCellData( "grd0_cell"+(MarKetIndex+i)+"_"+nIndex, 0 , Left( Round(szData(i),-2), Len(Round(szData(i),-2))-2) )
		next
	elseif CboIndex == 2 then	'선물옵션 실시간 TR 세팅
		if g_PresentType == "1" then
			sData_RSELN = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(0)+g_tTradekind(0) , 0 )
			sData_RSHNU = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(1)+g_tTradekind(0) , 0 )
			sData_RNTBY = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(2)+g_tTradekind(0) , 0 )
			
			szData_2 = Array(sData_RSELN, sData_RSHNU, sData_RNTBY)
			
			for i = 0 to 2
				ctn0.grd0.SetCellData( "grd0_cell"+(MarKetIndex+i)+"_"+nIndex, 0 , Left( Round(szData_2(i),-2), Len(Round(szData_2(i),-2))-2) )
			next
		elseif g_PresentType == "0" then
			sData_RSELN = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(0)+g_tTradekind(2) , 0 )
			sData_RSHNU = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(1)+g_tTradekind(2) , 0 )
			sData_RNTBY = DATAMANAGER.GetDataValue( 1 , "ohhts_invr_indv", "OutBlock1", "FIDR"+g_tTradeType(2)+g_tTradekind(3) , 0 )
			
			szData_1 = Array(sData_RSELN, sData_RSHNU, sData_RNTBY)
			
			for i = 0 to 2
				ctn0.grd0.SetCellData( "grd0_cell"+(MarKetIndex+i)+"_"+nIndex, 0 , szData_1(i) )
			next
		end if
	elseif CboIndex == 3 then	'콜옵션 실시간 TR 세팅
		if g_CallType == "1" then
