'****************************************************************************
'============================================================================
' Form_OnFormInit() - Grid셀 시장구분 초기값 세팅
'============================================================================
Sub Form_OnFormInit()

	g_PresentType = "0"
	g_CallType = "0"
	g_PutType = "0"
	g_InitType = "0"
	
	'20190304 LES START 주식선물 추가
	g_SfType = "0"
	
	'20190902 위클리 추가
	g_MfType = "0"
	g_MCallType = "0"
	g_MPutType = "0"
	g_WCallType = "0"
	g_WPutType = "0"
	'20190902 위클리추가
	
	'20190304 LES START 주식선물 추가
	'16,17,18 열 추가
	for i = 1 to 33
		Select Case i
			Case 1,4,7,10,13,16,19,22,25,28,31
				ctn0.grd0.SetCellData("grd0_cell"+i+"_2", 0, "매도")
			Case 2,5,8,11,14,17,20,23,26,29,32
				ctn0.grd0.SetCellData("grd0_cell"+i+"_2", 0, "매수")
			Case 3,6,9,12,15,18,21,24,27,30,33
				ctn0.grd0.SetCellData("grd0_cell"+i+"_2", 0, "순매수")
		End Select
	next
	
	ctn0.grd0.SetCellData( "grd0_cell1_1" , 0, "거래소\n(억원)" )
	ctn0.grd0.SetCellData( "grd0_cell4_1" , 0, "코스닥\n(억원)" )
	ctn0.grd0.SetCellData( "grd0_cell7_1" , 0, "KOSPI200\n선물\n(계약)" )
	ctn0.grd0.SetCellData( "grd0_cell10_1" , 0, "KOSPI200\n콜옵션\n(계약)" )
	ctn0.grd0.SetCellData( "grd0_cell13_1" , 0, "KOSPI200\n풋옵션\n(계약)" )
	'20190304 주식선물 추가
	ctn0.grd0.SetCellData( "grd0_cell16_1" , 0, "주식선물\n(계약)")
	'20190304 LES END
	'20190830 위클리 추가
	ctn0.grd0.SetCellData( "grd0_cell19_1" , 0, "KOSPI200\n미니선물\n(계약)" )
	ctn0.grd0.SetCellData( "grd0_cell22_1" , 0, "KOSPI200\n미니콜옵션\n(계약)" )
	ctn0.grd0.SetCellData( "grd0_cell25_1" , 0, "KOSPI200\n미니풋옵션\n(계약)" )
	ctn0.grd0.SetCellData( "grd0_cell28_1" , 0, "KOSPI200\n위클리콜옵션\n(계약)" )
	ctn0.grd0.SetCellData( "grd0_cell31_1" , 0, "KOSPI200\n위클리풋옵션\n(계약)" )
	'20190830 위클리 추가 END
	
	

	
	
	'20190304 LES START 주식선물 추가		
	'20190830 위클리 추가 
	'10가지 종목명,코드 TR 입력
	'orgn
	'for i = 0 to 4
	'for i = 0 to 5
	for i = 0 to 10
		DATAMANAGER.SetDataValue( 0 , "ohhts_1520_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_tMarket(i) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1520_001r", "InBlock1", "FID_INPUT_ISCD2" , i , g_tMcode(i) )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1520_001r", "InBlock1", "FID_INPUT_OPTN" , i , "000" )
		DATAMANAGER.SetDataValue( 0 , "ohhts_1520_001r", "InBlock1", "FID_INPUT_DATE1" , i , cld0.caption )
	next
	
	DATAMANAGER.RequestTranData( "ohhts_1520_001r" )
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 초기세팅 출력 함수 호출
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_1520_001r" then
	
		if g_InitType == "0" then
			call SetAmount()
		end if
		
		k = 0
		
		'20190304 LES START
		'orgn
		'for i = 0 to 4
		'for i = 0 to 5
		'20190902 위클리업데이트
		for i= 0 to 10
			for j = 0 to 11
				DATAMANAGER.SetDataValue( 1 , "ohhts_invr_indv", "InBlock1", "FIDR_INVR_BSTP_CODE" , k , g_tMcode(i) & g_tMarket_Real(j) )
				k = k + 1
			next
		next
		
	elseif szTranID == "ohhts_1520_001r_1521" then
		if g_Type == "0" then
			SetPresentData()
		elseif g_Type == "1" then
			SetCallData()
		elseif g_Type == "2" then
			SetPutData()
		'20190304 LES START
		elseif g_Type == "3" then
			SetSFData()
		'20190304 LES END
		'20190902 위클리 업데이트 
		elseif g_Type == "4" then
			SetMFData()
		elseif g_Type == "5" then
			SetMCallData()
		elseif g_Type == "6" then
			SetMPutData()
		elseif g_Type == "7" then
			SetWCallData()
		elseif g_Type == "8" then
			SetWPutData()
		end if
		'20190902 End
	
	end if
	
	DATAMANAGER.RequestRealData( "ohhts_invr_indv" )
	
End Sub

'============================================================================
