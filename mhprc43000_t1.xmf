	<SCRIPT_INFO _len="52703" _ulen="50917" >
'============================================================================
' 01. 화 면 명 : 탭_투자자종합
' 02. 화면설명 : 투자자동향 투자자종합 그리드
' 03. 작    성 : 2016. 01. 12.	유창재
'============================================================================

'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tMarket, g_tMcode ,g_PresentType, g_CallType, g_PutType,g_SfType, g_MfType, g_MCallType, g_MPutType,g_WCallType, g_WPutType	'시장, 시장코드 구분 / 선물,콜,풋 옵션.주식선물 대금,거래량 구분값
Dim g_InitType 	'TranData가 클릭 이벤트 발생 이후인지 Form Init 이후인지 구분하기 위한 변수
Dim g_tInputType, g_tTradeType	'시장사용자, 시장판매구분
Dim g_tTradeKind	'매수금액,매수량 구분
Dim g_tMarket_Real	'실시간에 사용될 투자자 구분 코드
Dim g_Type	'옵션,풋,콜옵션 구분 코드

'20190304 LES START 주식선물추가
'orgn
'g_tMarket = {"KSP","KSQ","K2I","K2I","K2I"}
'g_tMcode = {"0001","1001","F001","OC01","OP01"}
g_tMarket = {"KSP","KSQ","K2I","K2I","K2I" ,"999","MKI","MKI","MKI","WKI","WKI"}
g_tMcode = {"KGG01P","QGG01P","F001  ","OC01  ","OP01  ", "S001  ","F005  ","OC02  ","OP02  ","OC04  ","OP04  "}		'22년 차세대 업종코드 하드코딩
g_tInputType = {"","","","_PRSN","_FRGN","_ORGN","_SCRT","_INSU","_IVTR","_MRBN","_BANK","_FUND","_PE_FUND","_ETC_ORGT","_ETC_CORP"}
g_tTradeType = {"_SELN","_SHNU", "_NTBY"}
g_tTradeKind = {"_TR_PBMN","_VOL", "_QTY", "_CNQN"}
g_tMarket_Real = {"8000", "9100", "8888", "1000", "2000", "3000", "5000", "4000", "6000", "3100", "7100", "7000"}
			
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Function SetAmount() : 투자자종합 초기세팅 출력
'============================================================================
Function SetAmount()
	'20190304 LES START 주식선물 추가 (16,17,18열 추가)
	'orgn
	'for j = 0 to 4
	for j = 0 to 10
		for i = 3 to 14
			Select Case j
			'코스피, 코스닥일때 거래대금
			Case 0, 1
				sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(0) , j )
				sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(0) , j )
				sData_NTBY = Int(sData_SHNU) - Int(sData_SELN)
					
				ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, Left( Round(sData_SELN,-2), Len(Round(sData_SELN,-2))-2))
				ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, Left( Round(sData_SHNU,-2), Len(Round(sData_SHNU,-2))-2))
				ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, Left( Round(sData_NTBY,-2), Len(Round(sData_NTBY,-2))-2))
			
			'주식선물 추가 (16,17,18열 추가)
			'선물, 콜옵션, 풋옵션 일때는 거래량
			'orgn
			'Case 2,3,4
			Case 2, 3, 4 ,5, 6, 7, 8, 9, 10
				sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(1) , j )
				sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(1) , j )
	
				sData_NTBY = Int(sData_SHNU) - Int(sData_SELN)
				
				ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, sData_SELN )
				ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, sData_SHNU )
				ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, sData_NTBY )

			end Select
		next	 
	next
	
End Function

'============================================================================
' SetOptionData() : 선물,콜옵션,계약의 셀 선택시 거래대금, 거래량을 바꿔서 셀에 표시
'============================================================================
Function SetOptionData()
	
	if g_PresentType == "0" then	
		j = 2
		ctn0.grd0.SetCellData( "grd0_cell7_1" , 0, "KOSPI200\n선물\n(계약)" )
		for i = 3 to 14
			sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(1) , j )
			sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(1) , j )
			sData_NTBY = CInt(sData_SHNU) - CInt(sData_SELN)
		
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, sData_SELN)
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, sData_SHNU)
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, sData_NTBY)
		next	 	
	elseif g_PresentType == "1" then
		j = 2
		ctn0.grd0.SetCellData( "grd0_cell7_1" , 0, "KOSPI200\n선물\n(억원)" )
		for i = 3 to 14
			sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(0) , j )
			sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(0) , j )
			sData_NTBY = CInt(sData_SHNU) - CInt(sData_SELN)
		
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, Left( Round(sData_SELN,-2), Len(Round(sData_SELN,-2))-2))
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, Left( Round(sData_SHNU,-2), Len(Round(sData_SHNU,-2))-2))
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, Left( Round(sData_NTBY,-2), Len(Round(sData_NTBY,-2))-2))
		next	 
	end if
	
	if g_CallType == "0" then	
		j = 3
		ctn0.grd0.SetCellData( "grd0_cell10_1" , 0, "KOSPI200\n콜옵션\n(계약)" )
		for i = 3 to 14
			sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(1) , j )
			sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(1) , j )
			sData_NTBY = CInt(sData_SHNU) - CInt(sData_SELN)
		
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, sData_SELN)
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, sData_SHNU)
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, sData_NTBY)
		next	 	
	elseif g_CallType == "1" then
		j = 3
		ctn0.grd0.SetCellData( "grd0_cell10_1" , 0, "KOSPI200\n콜옵션\n(억원)" )
		for i = 3 to 14
			sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(0) , j )
			sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(0) , j )
			sData_NTBY = CInt(sData_SHNU) - CInt(sData_SELN)
		
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, Left( Round(sData_SELN,-2), Len(Round(sData_SELN,-2))-2))
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, Left( Round(sData_SHNU,-2), Len(Round(sData_SHNU,-2))-2))
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, Left( Round(sData_NTBY,-2), Len(Round(sData_NTBY,-2))-2))
		next	
	end if
	
	if g_PutType == "0" then	
		j = 4
		ctn0.grd0.SetCellData( "grd0_cell13_1" , 0, "KOSPI200\n풋옵션\n(계약)" )
		for i = 3 to 14
			sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(1) , j )
			sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(1) , j )
			sData_NTBY = CInt(sData_SHNU) - CInt(sData_SELN)
		
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, sData_SELN)
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, sData_SHNU)
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, sData_NTBY)
		next	 	
	elseif g_PutType == "1" then
		j = 4
		ctn0.grd0.SetCellData( "grd0_cell13_1" , 0, "KOSPI200\n풋옵션\n(억원)" )
		for i = 3 to 14
			sData_SELN = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(0)+g_tTradekind(0) , j )
			sData_SHNU = DATAMANAGER.GetDataValue( 0 , "ohhts_1520_001r", "OutBlock1", "FID"+g_tInputType(i)+g_tTradeType(1)+g_tTradekind(0) , j )
			sData_NTBY = CInt(sData_SHNU) - CInt(sData_SELN)
		
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+1)+"_"+i , 0, Left( Round(sData_SELN,-2), Len(Round(sData_SELN,-2))-2))
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+2)+"_"+i , 0, Left( Round(sData_SHNU,-2), Len(Round(sData_SHNU,-2))-2))
			ctn0.grd0.SetCellData( "grd0_cell"+(j*3+3)+"_"+i , 0, Left( Round(sData_NTBY,-2), Len(Round(sData_NTBY,-2))-2))
		next	
	end if
End Function

'============================================================================
