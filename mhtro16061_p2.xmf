'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 기간설정 창
' 03. 작    성 : 2016.07.15 NOHES
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


Dim g_Vendor
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	sData = Form.GetOpenLinkData()
	tData = Split(sData, "★")
	If UBound(tData) > 0 then
		g_Vendor = tData(0)
		
		'20200911 LES START 예약시간 추가
		if tData(1) = "3" then
			rgptime.currentindex = 1
		elseif tData(1) = "1" then
			rgptime.currentindex = 2
		elseif tData(1) = "2" then
			rgptime.currentindex = 3
		else
			rgptime.currentindex = 0
		end if
		
		'rgptime.currentindex = tData(1)
		''20200911 LES END
		
		'20220613 SWJ START : 주문유형별 주문시간 콤보 변경
		'LOO, LOC, MOO, MOC
		Dim szList
		
		if tData(5) = "31" or tData(5) = "32" or tData(5) = "33" or tData(5) = "34" then
			szList = Set_TypeList(0)
		else
			szList = Set_TypeList(1)
		end if
		
		rgptime.currentindex = "0"
		Form.SetCtlProp("rgptime", "clear", "")
		rgptime.cbinputdatatext = szList
		'20220613 SWJ END
		
		if tData(2) == "일반예약" or tData(2) == "" then
			cldStart.visible = false
			cldFinish.visible = false
			Label0.visible = true
			cmbRange.currentindex = 0	
		elseif tData(2) == "기간잔량" then
			cldStart.visible = True
			cldFinish.visible = True
			Label0.visible = True
			cmbRange.currentindex = 1
			cldStart.caption = tData(3)
			cldFinish.caption = tData(4)
		elseif tData(2) == "기간예약" then
			cldStart.visible = True
			cldFinish.visible = True
			Label0.visible = True
			cmbRange.currentindex = 2
			cldStart.caption = tData(3)
			cldFinish.caption = tData(4)
		else
			cldStart.visible = True
			cldFinish.visible = False
			Label0.visible = False
			cmbRange.currentindex = 3
			cldStart.caption = tData(3)
		end if
		DATAMANAGER.RequestTranData("obtro_comn_006r"  )
	end if
	cmbRange.enable = False
	
End Sub

'============================================================================
Sub btnChange_OnClick()
	cmbRange.enable = True
	If cmbRange.currentindex == "0" Then
		cldStart.visible = False
		Label0.visible = False
		cldFinish.visible = False
	elseif cmbRange.currentindex == "3" Then
		cldStart.visible = True
		Label0.visible = False
		cldFinish.visible = False
	Else
		cldStart.visible = True
		Label0.visible = True
		cldFinish.visible = True
	End If
	
	
End Sub


'============================================================================
Sub btnOK_OnClick()

	
	
	Dim flag 
	'예약구분★시작일자★종료일자★시간구분
	flag = cmbRange.currentindex
	If flag == "1" or flag == "2" Then
		If cldStart.caption == "" or Len(cldStart.caption) <> 8 Then
			ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
			Exit Sub
		End If
		If cldFinish.caption == "" or Len(cldFinish.caption) <> 8 Then
			ShowAlert "기간설정", "예약주문 종료일자가 유효하지 않습니다."
			Exit Sub
		End If
		If CDbl(cldStart.caption) >= CDbl(cldFinish.caption) Then
			ShowAlert "기간설정", "기간예약 종료일이 시작일과 같거나 앞설 수 없습니다."
			Exit Sub
		End If
		
		'20200911 LES START 예약시간 추가
		'sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& cldStart.caption &"★"& cldFinish.caption & "★" & Rgptime.currentindex
		sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& cldStart.caption &"★"& cldFinish.caption & "★" & rgptime.cbkeydata
		'20200911 LES END
	
	Elseif flag == "3" Then
			If cldStart.caption == "" or Len(cldStart.caption) <> 8 Then
				ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
				Exit Sub
			End If
		
		'20200911 LES START 예약시간 추가
		'sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& cldStart.caption &"★"& "" & "★" & Rgptime.currentindex
		sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& cldStart.caption &"★"& "" & "★" & rgptime.cbkeydata
		'20200911 LEs END
		
	Else
		'20200911 LES START 예약시간 추가
		'sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& Form.GetSharedData("&HOST_DATE", false) &"★"& Form.GetSharedData("&HOST_DATE", false) & "★" & Rgptime.currentindex
		sLnkData =  Form.GetCtlProp("cmbRange", "currentindex") &"★"& Form.GetSharedData("&HOST_DATE", false) &"★"& Form.GetSharedData("&HOST_DATE", false) & "★" & rgptime.cbkeydata
		'20200911 LES END
	End If
		
	Form.SendReturnToParent("Range" , sLnkData)

	Form.CloseForm()
End Sub

'============================================================================
Sub cldStart_OnEditComplete()
	If Len(cldStart.caption) <> 8 Then
		ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
		cldStart.caption = ""
		Exit Sub
	End If
	
	If CDbl(cldStart.caption) > CDbl(cldadd30.caption) Then
		ShowAlert "기간설정", "주문예약기간은 30일 이내만 지정가능합니다."
		cldStart.caption = cldadd30.caption
		cldFinish.caption = cldadd30.caption
		Exit Sub
	End If
	If CDbl(cldStart.caption) < CDbl(cldHost.caption) Then
		ShowAlert "기간설정", "시작일을 오늘날짜로 변경합니다.(당일 이후 날짜부터 지정 가능)"
		cldStart.caption = cldHost.caption
	End If
	
End Sub

'============================================================================
Sub cldFinish_OnEditComplete()
	If Len(cldFinish.caption) <> 8 Then
		ShowAlert "기간설정", "예약주문 종료일자가 유효하지 않습니다."
		cldFinish.caption = ""
		Exit Sub
	End If
		
	If cldadd30.caption == "" Then
		ShowAlert "기간설정", "예약 시작날짜를 확인해주십시오."
		Exit Sub
	End If
	If CDbl(cldFinish.caption) > CDbl(cldadd30.caption) Then
		ShowAlert "기간설정", "주문예약기간은 30일 이내만 지정가능합니다.(종료일자 30일 이후 지정 불가)"
		cldFinish.caption = cldadd30.caption
		Exit Sub
	End If
	
End Sub

'============================================================================
Sub cmbRange_OnEditComplete(iIndex)
	If iIndex == 0  Then
		cldStart.caption = cldHost.caption
		cldFinish.caption = cldHost.caption
		cldStart.visible = False
		Label0.visible = False
		cldFinish.visible = False
	elseif iIndex == 3  Then
		cldFinish.caption = cldHost.caption
		cldStart.visible = True
		cldStart.caption = cldHost.caption
		Label0.visible = false
		cldFinish.visible = False
		cldFinish.caption = ""
	Else
		cldStart.visible = True
		cldStart.caption = cldHost.caption
		Label0.visible = True
		cldFinish.visible = True
		cldFinish.caption = cldHost.caption
	End If
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( False, "obtro_comn_006r", "InBlock1", "OVRS_EXCH_VNDR_IDNO", 0 , g_Vendor)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtro_comn_006r" Then
		cldHost.caption =  DATAMANAGER.GetDataValue(False, "obtro_comn_006r", "OutBlock1", "BSOP_DATE"  , 0)
		cldadd30.caption =  DATAMANAGER.GetDataValue(False, "obtro_comn_006r", "OutBlock1", "BSOP_DATE"  , 0)
		Form.SetCtlProp("cldadd30", "addday", "30")
	End If
End Sub
'============================================================================
'20220613 SWJ START : 주문유형별 주문시간 콤보 세팅
'============================================================================
Function Set_TypeList(nGbn)
	if nGbn = 0 then
		rgptime.enable = False
		return "0`장개시"
	else
		rgptime.enable = True
		return "0`장개시\r\n3`장개시 30분 후\r\n1`장마감 10분 전\r\n2`장마감 30분 전"
	end if
End Function

