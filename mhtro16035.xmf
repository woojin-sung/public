'============================================================================
Sub Form_OnFormInit()
	f_CodeTrigger()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "SCREEN_REFRESH", "")
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	f_CodeTrigger()
End Sub

