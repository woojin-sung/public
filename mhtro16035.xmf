'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	f_CodeTrigger()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhtro16035_p1" then
		f_CodeTrigger()
	end if
End Sub

'============================================================================
Sub f_CodeTrigger()
	dim szCodeInfo
	
	szCodeInfo = Form.GetSharedData("PEERGRP_CODEINFO", false)

	Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "SELECT_CODE", szCodeInfo )
End Sub

