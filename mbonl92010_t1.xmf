'============================================================================
Dim g_szPwd
Dim g_szAcno
Dim g_szAsno
Dim g_nlRow
Dim g_Ostype
Dim g_pros_cnt
Dim g_data_cnt
Dim g_cnt_row
Dim g_CHAN_TYPE_CLS_CODE
Dim g_szIndex
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TRANCALL" then
		grd0.SetClear()
		tmp = Split(sParam, "||")
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		g_szPwd = Form.GetCtlProp("#EditPW", "caption")
		g_Ostype = Form.GetSharedData("&OS_TYPE", false )
		g_szIndex = tmp(2)

		if g_szIndex == "0" then
			grd0.SetVisibleCol(11, false)
			DATAMANAGER.RequestTranData("oblon_lndn_013r")
		elseif g_szIndex == "1" then
			grd0.SetVisibleCol(11, true)
			DATAMANAGER.RequestTranData("oblon_lndn_313r")
		end if
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim AnctPwd
	Dim data_cnt
	'MTS메모리보안
	Dim plain_rm
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		AcntPwd  = g_szPwd
	else
		AcntPwd  = Form.GetEncData(g_szPwd)
	end if
	
	'AcntPwd  = Form.GetEncData(g_szPwd)
	data_cnt = 0

	if szTranID = "oblon_lndn_013r" then
		
		
		DATAMANAGER.SetDataValue(0, "oblon_lndn_013r", "InBlock1", "ACNO" , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_013r", "InBlock1", "ASNO" , 0 , g_szAsno)
	elseif szTranID = "oblon_lndn_015a" then
		DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "ACNT_PWD" , 0 , AcntPwd)
	elseif szTranID = "oblon_lndn_313r" then
		DATAMANAGER.SetDataValue(0, "oblon_lndn_313r", "InBlock1", "ACNO" , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_313r", "InBlock1", "ASNO" , 0 , g_szAsno)
	elseif szTranID = "oblon_lndn_315a" then
		DATAMANAGER.SetDataValue(0, "oblon_lndn_315a", "InBlock1", "ACNT_PWD" , 0 , AcntPwd)
	end if
End Sub



'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	if szCellID = "bd_cell5" or szCellID = "bd_cell9" then
		g_nlRow = lRow
		Form.OpenPopup("mbtrs12000_p1.xmf", "" ,"")
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "QTY_POPUP" then
		grd0.SetCellData("bd_cell5", g_nlRow, sRet)
	end if
End Sub

'============================================================================
Sub Button0_OnClick()
	g_szPwd = Form.GetCtlProp("#EditPW", "caption")

	g_pros_cnt = 0
	g_cnt_row = 0
	if GetPWCheck() then
		exit Sub
	end if
	
				
	if g_Ostype = "1" then
		g_CHAN_TYPE_CLS_CODE = "156"
	elseif g_Ostype = "2" then
		g_CHAN_TYPE_CLS_CODE = "157"
	else
		exit Sub
	end if
		
	
	for i = 0 to grd0.rowcount - 1
		if grd0.GetCellData("bd_cell5", i) = 0 or grd0.GetCellData("bd_cell5", i) = "" then
			grd0.SetCellData("bd_cell0", i, "0")
		else
			grd0.SetCellData("bd_cell0", i, "1")
			g_pros_cnt = g_pros_cnt + 1
		end if
	next
	

	
	if g_pros_cnt = 0 then
		Form.ShowAlert("알림", "처리대상이 없습니다.")
		exit sub
	end if
	
	if g_szIndex == "0" then
		tmpTranID = "oblon_lndn_015a"
	elseif g_szIndex == "1" then
		tmpTranID = "oblon_lndn_315a"
	end if
	
	for i = 0 to grd0.rowcount - 1
		if grd0.GetCellData("bd_cell0", i) = "1" then
			g_cnt_row = i + 1
			ISCD		 			= grd0.GetCellData("bd_cell1" , i)
			LOAN_DATE		 	= grd0.GetCellData("bd_cell3" , i)
			LOAN_SRNO 		 	= grd0.GetCellData("bd_cell10", i)
			LNDN_RDMP_APLT_QTY 	= grd0.GetCellData("bd_cell5" , i)
			BYOV_DATE			= grd0.GetCellData("bd_cell12" , i)
			OVRL_SPTX_CLS_CODE	= grd0.GetCellData("bd_cell13" , i)
		
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "1")
			'DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "LNDN_RDMP_ASK_CLCD" 	, 0 , "01")
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "ACNO"				, 0 , g_szAcno)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "ASNO" 				, 0 , g_szAsno)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "ISCD" 				, 0 , ISCD)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "LOAN_DATE" 			, 0 , LOAN_DATE)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "LOAN_SRNO"			, 0 , LOAN_SRNO)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "LNDN_RDMP_APLT_QTY"	, 0 , LNDN_RDMP_APLT_QTY)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "APLT_DATE"			, 0 , "")
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "APLT_SRNO"			, 0 , 0)
			DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0 , g_CHAN_TYPE_CLS_CODE)
			
			if g_szIndex == "1" then
				DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "BYOV_DATE" 			, 0 , BYOV_DATE)
				DATAMANAGER.SetDataValue(0, tmpTranID, "InBlock1", "OVRL_SPTX_CLS_CODE" 	, 0 , OVRL_SPTX_CLS_CODE)
			end if
			
			DATAMANAGER.RequestTranData(tmpTranID)
			
			exit for
		end if
	next
		
End Sub
'============================================================================
Function GetPWCheck()
	if g_szPwd == null or g_szPwd == "" then
		Form.MsgBox("알림", "비밀번호를 입력해주세요", "", 6)
		return true
	end if
	
	return false
End Function
'============================================================================
Sub Form_OnFormInit()
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_lndn_015a" then
	
		DATAMANAGER.ClearInputData(0, "oblon_lndn_015a")
		for i = g_cnt_row to grd0.rowcount - 1
			g_cnt_row = i + 1
			if grd0.GetCellData("bd_cell0", i) = "1" then
				ISCD		 			= grd0.GetCellData("bd_cell1" , i)
				LOAN_DATE		 	= grd0.GetCellData("bd_cell3" , i)
				LOAN_SRNO 		 	= grd0.GetCellData("bd_cell10", i)
				LNDN_RDMP_APLT_QTY 	= grd0.GetCellData("bd_cell5" , i)
			
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "PROS_CLS_CODE" 		, 0 , "1")
				'DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "LNDN_RDMP_ASK_CLCD" 	, 0 , "01")
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "ACNO"				, 0 , g_szAcno)
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "ASNO" 				, 0 , g_szAsno)
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "ISCD" 				, 0 , ISCD)
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "LOAN_DATE" 			, 0 , LOAN_DATE)
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "LOAN_SRNO"			, 0 , LOAN_SRNO)
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "LNDN_RDMP_APLT_QTY"	, 0 , LNDN_RDMP_APLT_QTY)
				DATAMANAGER.SetDataValue(0, "oblon_lndn_015a", "InBlock1", "APLT_DATE"			, 0 , "")
