'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		
		tblData.SetCellString(0, 1, tData[0])
		tblData.SetCellString(1, 1, tData[1])
		tblData.SetCellString(2, 1, tData[2])
		tblData.SetCellString(3, 1, tData[3])
		tblData.SetCellString(4, 1, tData[4])
	End If
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl88027_p2" , "0")
	Form.CloseForm()
End Sub

'============================================================================
Sub btnMove_OnClick()
	Form.SendReturnToParent("mbonl88027_p2" , "1")
	Form.CloseForm()
End Sub

