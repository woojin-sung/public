Sub Container0_BtnHOME_OnClick()
	g_sScreenKey = "common.start_screen"		'환경설정>앱 실행 시 첫화면 설정값
	sValue = Form.GetEnvData(g_sScreenKey)	

	if CInt(sValue) <> 0 then				'0:시장종합 아닌 경우에만, HOME화면 띄워주기(부하방지)
		Form.OpenScreen("99999" , "")
	end if
	Form.CloseForm()
End Sub

