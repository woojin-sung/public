'===========================================================================
'===========================================================================
Dim g_szData
Dim g_arrItem
Dim g_intItemCnt

Dim g_arrCheck 

'============================================================================
Sub Form_OnFormInit()
	g_intItemCnt = Form.GetEnvData( "comp_itemCnt")
	tmpItem =  Form.GetEnvData( "comp_itemList" )
	tmpCheckSt = Form.GetEnvData("comp_itmeCheck")
	
	if g_intItemCnt = "" then
		Exit Sub		
	end if
	g_arrItem = split(tmpItem , "^")
	g_arrCheck = split(tmpCheckSt , "^")
	for i = 0 to g_intItemCnt - 1
		Grid0.insertrow = i
		Grid0.SetCellData( "bd_cell4", i , g_arrItem[i] )
		szItemName = Form.GetItemCodeInfo(g_arrItem[i] ,"name")
		Grid0.SetCellData( "bd_cell1", i , szItemName )
		if g_arrCheck[i] = "" then
			g_arrCheck[i] = "1"
		end if
		Grid0.SetCellData( "bd_cell0", i , g_arrCheck[i] )
	next
End Sub

'============================================================================
Sub Form_OnFormClose()
	nGridCnt = CInt(Grid0.rowcount)
	if nGridCnt =  0 then
		Exit Sub
	end if
	tmpItemData = ""
	tmpCheck = ""
	for i = 0 to nGridCnt -1
		tmpItemData = tmpItemData..Grid0.GetCellData( "bd_cell4", i ).."^"
		tmpCheck = tmpCheck..Grid0.GetCellData( "bd_cell0", i ).."^"
	next
	Form.SetEnvData( 1, "comp_itemCnt", nGridCnt )
	Form.SetEnvData( 1, "comp_itemList", tmpItemData )
	Form.SetEnvData( 1, "comp_itmeCheck", tmpCheck )
	Form.SendReturnToParent( "CompOption" , "true" )
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	nGridCnt = CInt(Grid0.rowcount)
	if szCellID = "bd_cell2" then
		if nGridCnt = 1 then
			Form.ShowAlert("알림", "최소 1개 종목은 있어야 합니다. ")
			Exit Sub
		else
			Grid0.SetDeleteRow( lRow )
		end if
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub BtnAdd_OnClick()
	nGridCnt = CInt(Grid0.rowcount)
	if nGridCnt = 5 then
		Form.ShowAlert("알림" , "비교종목은 5개까지 가능합니다.")
		Exit Sub
	end if
	Form.OpenCommonDialog("SEARCH", "2:3:5:6:15", "")	'20180712 HAMWG : K-OTC MTS 도입
End Sub

'============================================================================
Sub BtnSave_OnClick()
	Form.CloseForm( ) 
End Sub


'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	nGridCnt = CInt(Grid0.rowcount)

	if sDlgName = "SEARCH" then
		if sReturn1 = "" or sReturn1 = null then
			Exit Sub
		else
			if nGridCnt = 0 then
				Grid0.insertrow = 0
				Grid0.SetCellData( "bd_cell4", 0 , sReturn1 )
				szItemName = Form.GetItemCodeInfo(sReturn1,"name")
				Grid0.SetCellData( "bd_cell1", 0 , szItemName )
				Grid0.SetCellData( "bd_cell0", 0 , "1" )
			else
				for i = 0 to nGridCnt-1
					tmpItemcode = Grid0.GetCellData( "bd_cell4", i )
					if sReturn1 = tmpItemcode then
						
						Form.ShowAlert("알림", "동일한 종목을 선택하셨습니다.")
						Exit Sub
					else
						if i = nGridCnt - 1 then
							Grid0.insertrow = i+1
							Grid0.SetCellData( "bd_cell4", i+1 , sReturn1 )
							szItemName = Form.GetItemCodeInfo(sReturn1,"name")
							Grid0.SetCellData( "bd_cell1", i+1 , szItemName )
							Grid0.SetCellData( "bd_cell0", i+1 , "1" )
						elseif i = 4 then
							Grid0.SetCellData( "bd_cell4", 0 , sReturn1 )
							szItemName = Form.GetItemCodeInfo(sReturn1,"name")
							Grid0.SetCellData( "bd_cell1", 0 , szItemName )
							Grid0.SetCellData( "bd_cell0", 0 , "1" )
							
						end if
					end if
				next
			end if
		end if
	end if
End Sub

