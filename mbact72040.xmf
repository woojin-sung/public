	<SCRIPT_INFO _len="4531" _ulen="4327" >
'============================================================================
' 01. 화 면 명 : 선옵 예탁금
' 02. 화면설명 : 선옵 예탁금조회
' 03. 작    성 : 2016.1.14 하원만
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry(g_nAcNo, g_nAsNo)
'============================================================================
Function TR_Inquiry(g_nAcNo, g_nAsNo)

	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
	if Trim(g_nAcNo) ==  "" then
		exit Function
	end if
	'20231123 HSZ END	

	If Len(g_nAcNo & g_nAsNo) < 10 Then
		Form.ShowAlert("알림", "계좌번호를 확인해 주세요.")
	else

		DATAMANAGER.SetDataValue(0, "obtrf_oder_608r", "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_608r", "InBlock1", "ASNO", 0 , g_nAsNo)
		DATAMANAGER.RequestTranData("obtrf_oder_608r")

	End If		    

End Function

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_nAcNo =  cmbAccount.total    'Left( cmbAccount.caption, 8)
	g_nAsNo =  cmbAccount.sequence 'Right( cmbAccount.caption, 2)

	'최초 조회 수행
	Call TR_Inquiry(g_nAcNo, g_nAsNo)	

End Sub

'============================================================================
' btnSearch_OnClick()
'============================================================================
Sub btnSearch_OnClick()

	g_nAcNo =  cmbAccount.total    'Left( cmbAccount.caption, 8)
	g_nAsNo =  cmbAccount.sequence 'Right( cmbAccount.caption, 2)

	'폼 초기화
	Call Output_Data_Clear()
	Call TR_Inquiry(g_nAcNo, g_nAsNo)

End Sub

'============================================================================
'출력 Data 초기화
Sub Output_Data_Clear()
	
	cont.Table0.SetCellString(0,1,"")
	cont.Table0.SetCellString(1,1,"")
	cont.Table0.SetCellString(2,1,"")

	cont.Table1.SetCellString(1,1,"")
	cont.Table1.SetCellString(1,2,"")
	cont.Table1.SetCellString(2,1,"")
	cont.Table1.SetCellString(2,2,"")
	cont.Table1.SetCellString(3,1,"")
	cont.Table1.SetCellString(3,2,"")
	cont.Table1.SetCellString(4,1,"")
	cont.Table1.SetCellString(4,2,"")
	cont.Table1.SetCellString(5,1,"")
	cont.Table1.SetCellString(5,2,"")

	cont.Table2.SetCellString(0,1,"")
	cont.Table2.SetCellString(1,1,"")
	cont.Table2.SetCellString(2,1,"")
	cont.Table2.SetCellString(3,1,"")
	cont.Table2.SetCellString(4,1,"")
	cont.Table2.SetCellString(5,1,"")

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	If sEventName <> "선물옵션주문" Then
	    Exit Sub
	End If
	
	g_nAcNo =  Left( sParam, 8)
	g_nAsNo =  Right( sParam, 2)
	
	'폼 초기화
	Call Output_Data_Clear()
	Call TR_Inquiry(g_nAcNo, g_nAsNo)
	
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()

	g_nAcNo = cmbAccount.total    'Left( cmbAccount.caption, 8)
	g_nAsNo = cmbAccount.sequence 'Right( cmbAccount.caption, 2)

	Call Output_Data_Clear()
	Call TR_Inquiry(g_nAcNo, g_nAsNo)

End Sub

'============================================================================
Sub Form_OnRefresh()
	
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
	if szTranID == "obtrf_oder_608r"  then
		szAcnt = cmbAccount.caption
		if Trim(szAcnt) == "" then
			exit sub
		end if
	end if
	'20231123 HSZ END	
End Sub

