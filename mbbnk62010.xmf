'===========================================================================
' 화 면 명: 다른 금융기관 계좌조회_입출금
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
' 2021.12.08. 장원혁 v002 : 오픈뱅킹_이용재동의여부 조회&등록 추가 (추가수정)
'============================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim g_szTotAmt   	'총 잔액
Dim g_szNo		'넘버

Dim LdgrBal     	'잔액
Dim OpngDate    	'계좌개설일자
Dim MtrtDate		'만기일
Dim LastTrDate	'최종입출금일
Dim nCount		'카운트

Dim TrDate  
Dim ApiTlmsClcd  
Dim OpnOtsdTrNo
Dim RpttCsnu

Dim currentIndex
Dim currentLoopIndex

Dim InitCount

Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
Dim g_setRmndAmtYn '잔액세팅여부 v002
Dim g_isAcdnCust
'===========================================================================
' Form_OnFormInit()
'===========================================================================
Sub Form_OnFormInit()
'	Init_Data()
	'v001
	g_szID = Form.GetSharedData("&USER_ID", false )
	g_isAcdnCust = ""
	
	'v001
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false) = "Y" THEN
	    Init_Data()
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
	
	DATAMANAGER.RequestTranData("obcsb_scif_033r")
	
End Sub

'============================================================================
Sub BtnRefresh_OnClick()
    Init_Data()
End Sub

Sub Init_Data()

	g_szNo = 0
	g_szTotAmt = 0
	nCount = 0
	
	LblSum.caption = 0
	Grid.rowcount = 0
	
'	g_szID = Form.GetSharedData("&USER_ID", false ) 'v001
	TrDate = Form.GetSharedData("&HOST_DATE", false )
    
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE" , 0 ,  "2" )
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , "A" ) '전체
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID", 0 , g_szID) 'acno랑 둘중하나만
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN", 0 , "Y") 
	DATAMANAGER.RequestTranData("obtss_opnf_008r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtss_opnf_008r" then
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
		
		if nCount = 0 then 
			MsgBox("등록된 계좌가 없습니다")
		else
			'g_szNo = g_szNo + 1
			g_szCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
			
			for i = 0 to g_szCount
				szAcnm = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_NAME" , i) & " " & DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BANK_ACNO" , i) 
			
				Grid.SetCellData("bd1_acnm", i, szAcnm)
				
				Grid.SetCellData("bd3_cell0", i, "출금액")
				Grid.SetCellData("bd3_tr_amt", i, "0")
				Grid.SetCellFgColor("bd3_tr_amt", i, 7)
				
				'Grid.SetCellData("bd3_cell0", i, "이체")
				'Grid.SetCellData("bd3_cell1", i, "모으기")
				
			
			next
			
			currentLoopIndex = 0
	
			For i = 0 To Grid.rowcount - 1
			
			    If Trim(Grid.GetCellData("bd2_drng_able_amt" , i)) = "" Then '잔액 란이 공란이면
			    
						currentLoopIndex = i
						TR_DATE             = TRIM(Grid.GetCellData("bd1_tr_date" , currentLoopIndex))
						API_TLMS_CLCD       = TRIM(Grid.GetCellData("bd2_api_tlms_clcd" , currentLoopIndex)) 'API전문구분코드
						OPN_OTSD_TR_UNIQ_NO = TRIM(Grid.GetCellData("bd3_opn_otsd_tr_uniq_no" , currentLoopIndex)) '대외기관고유번호
						DATAMANAGER.SetDataValue(0 , "obtss_opnf_034r" , "InBlock1" , "TR_DATE"             , 0 , TR_DATE            )
						DATAMANAGER.SetDataValue(0 , "obtss_opnf_034r" , "InBlock1" , "API_TLMS_CLCD"       , 0 , API_TLMS_CLCD      )
						DATAMANAGER.SetDataValue(0 , "obtss_opnf_034r" , "InBlock1" , "OPN_OTSD_TR_UNIQ_NO" , 0 , OPN_OTSD_TR_UNIQ_NO)
						DATAMANAGER.RequestTranData("obtss_opnf_034r")
				       Exit Sub
				
			    End If
		
			Next	    		
			
		end if
	elseif szTranID == "obtss_opnf_034r" then
	
	    If g_setRmndAmtYn == "N" Then 'v002
	        Exit Sub
	    End If
		
	    RMND_AMT            = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "LDGR_BAL"      , 0)
        DRNG_ABLE_AMT       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "DRNG_ABLE_AMT" , 0)
        Grid.SetCellData("bd1_ldgr_bal", currentLoopIndex , RMND_AMT) '출금가능금액
        Grid.SetCellData("bd2_drng_able_amt", currentLoopIndex , DRNG_ABLE_AMT     ) '잔액
	    Grid.SetCellData("bd2_bal", currentLoopIndex , DRNG_ABLE_AMT     ) 
	    
        currentLoopIndex = currentLoopIndex + 1
	
        If currentLoopIndex <= Grid.rowcount - 1 Then
            TR_DATE             = TRIM(Grid.GetCellData("bd1_tr_date" , currentLoopIndex))  '거래일자
            API_TLMS_CLCD       = TRIM(Grid.GetCellData("bd2_api_tlms_clcd" , currentLoopIndex)) 'API전문구분코드
            OPN_OTSD_TR_UNIQ_NO = TRIM(Grid.GetCellData("bd3_opn_otsd_tr_uniq_no" , currentLoopIndex)) '대외기관고유번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_DATE"             , 0 , TR_DATE            )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "API_TLMS_CLCD"       , 0 , API_TLMS_CLCD      )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "OPN_OTSD_TR_UNIQ_NO" , 0 , OPN_OTSD_TR_UNIQ_NO)
            DATAMANAGER.RequestTranData(szTranID)
        End If
	
	elseif szTranID == "obtss_opnf_047r" then	'v001
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부

	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If
	    
	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
        '다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then
	 
			Form_Enable(False)
		Else
		    Init_Data()
	    End If
	elseif szTranID == "obtss_opnf_048a" then	'v001
	
		Init_Data()
		
	ElseIf szTranID == "obcsb_scif_033r" Then
	
	    g_isAcdnCust = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TRGT_YN" , 0)
	    
	    If g_isAcdnCust == "Y" Then
	        Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )
	    End If
		
	end if	
	
End Sub



'============================================================================
Sub Grid_OnClickUp(lRow, szCellID)
	
	if szCellID = "bd_cell_chk" then
		
	else
		exit sub
	end if
	
	if Grid.GetCellData("bd_cell_chk" , lRow) <> 1 AND Grid.GetCellData("bd_cell_chk" , lRow) <> "1" then
		Grid.SetCellData("bd3_tr_amt", lRow, "0")
		Calc_Sum()
	else
	   PROS_CNT = 0
    
        For i = 0 To Grid.rowcount - 1
            If Grid.GetCellData("bd_cell_chk" , i) = 1 Or Grid.GetCellData("bd_cell_chk" , i) = "1" Then
                PROS_CNT = PROS_CNT + 1
            End If
        Next
    
        If PROS_CNT > 5 Then
            Form.MsgBox("알림" , "계좌는 최대 5건까지 선택 가능합니다." , "" , 0)
		   Grid.SetCellData("bd_cell_chk" , lRow ,  0 )		   
            Exit Sub
        End If
	    
        If Grid.GetCellData("bd2_bal", lRow) = "" Then
            Form.MsgBox("알림" , "출금가능금액을 확인해주세요." , "" , 0)
		   Grid.SetCellData("bd_cell_chk" , lRow ,  0 )
		   
            Exit Sub	    
        End If
	    
        currentIndex = lRow
        Form.SetSharedData("DRNG_ACNT"      , Grid.GetCellData("bd1_acnm", lRow) )
        Form.SetSharedData("RMND_AMT"       , Grid.GetCellData("bd1_ldgr_bal", lRow))
        Form.SetSharedData("DRNG_ABLE_AMT"  , Grid.GetCellData("bd2_drng_able_amt", lRow))
        Form.OpenDialog( "mbbnk62010_p1" , "" , "")
	end if
	
End Sub


'============================================================================
Sub Form_OnFormInitBefore()

	Dim szData
	szData = Form.GetOpenLinkData()
	g_szList = Split(szData, "★")

	if UBOUND(g_szList) < 1 THEN
		EXIT SUB
	END IF

	EdtAc.caption = g_szList(0)
	EdtAcAl.caption = g_szList(1)
	EdtAcOpenD.caption = g_szList(2)
	EdtCloD.caption = g_szList(3)
	EdtCurrTrD.caption = g_szList(4)
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	Dim SubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If Trim(SubMsg) == "" Then
	    Form.MsgBox("알림", szErrMsg, 0)	
	Else
	    Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)	
	End If
	
	
    If szTranID = "obtss_opnf_034r" Then

        Grid.SetCellData("bd1_ldgr_bal", currentLoopIndex , "") '출금가능금액
        Grid.SetCellData("bd2_drng_able_amt", currentLoopIndex , ""     ) '잔액
        Grid.SetCellData("bd2_bal", currentLoopIndex , ""     ) 
	
        currentLoopIndex = currentLoopIndex + 1
	
        If currentLoopIndex <= Grid.rowcount - 1 Then
            TR_DATE             = TRIM(Grid.GetCellData("bd1_tr_date" , currentLoopIndex))  '거래일자
            API_TLMS_CLCD       = TRIM(Grid.GetCellData("bd2_api_tlms_clcd" , currentLoopIndex)) 'API전문구분코드
            OPN_OTSD_TR_UNIQ_NO = TRIM(Grid.GetCellData("bd3_opn_otsd_tr_uniq_no" , currentLoopIndex)) '대외기관고유번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_DATE"             , 0 , TR_DATE            )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "API_TLMS_CLCD"       , 0 , API_TLMS_CLCD      )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "OPN_OTSD_TR_UNIQ_NO" , 0 , OPN_OTSD_TR_UNIQ_NO)
            DATAMANAGER.RequestTranData(szTranID)
        End If
    
    End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "SetValue" Then
	    Grid.SetCellData("bd3_tr_amt", currentIndex , sRet)
	    Calc_Sum()
	End If
	
	If sKeyName == "CLOSE_YN" Then 
	    If sRet == "Y" Then
	        If Form.GetSharedData("CLOSE_YN", TRUE ) == "Y" Then
		        Init_Data() '초기화
		    End If
	        
	    End If
	End If
	
	'v001
	If sKeyName == "mbbnk62000_p1" then
	     
		If sRet == "Y" then 'Y:재동의 N:취소
		
			Form_Enable(True)
			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
			
				Form_Enable(True)
				
				Init_Data()
			Else
			
				Form_Enable(False)
				g_setRmndAmtYn = "N" 'v002
				Init_Data() 'v002
			End If
		End If
	End If
End Sub

Sub Calc_Sum()

    SUM_AMT = 0

    For i = 0 To Grid.rowcount - 1
        If Grid.GetCellData("bd_cell_chk" , i) = "1" or Grid.GetCellData("bd_cell_chk" , i) = 1 Then
            SUM_AMT = SUM_AMT + Grid.GetCellData("bd3_tr_amt" , i)
        End If
    Next
    
    LblSum.caption = SUM_AMT

End Sub

Sub BtnNext_OnClick()
    
    If g_isAcdnCust == "Y" Then
        Form.MsgBox( "알림", "개인정보노출 고객입니다.", "", 6 )    
        Exit Sub
    End If
    
    PROS_CNT = 0
    
    szData = ""
    
    For i = 0 To Grid.rowcount - 1
        If Grid.GetCellData("bd_cell_chk" , i) = 1 Or Grid.GetCellData("bd_cell_chk" , i) = "1" Then
	
            If Grid.GetCellData("bd3_tr_amt" , i) = 0 Or TRIM(Grid.GetCellData("bd3_tr_amt" , i)) = "" Or TRIM(Grid.GetCellData("bd3_tr_amt" , i)) = "0" Then
                Form.MsgBox("알림" , "금액을 입력해주세요." , "" , 0)
                Exit Sub
            End If
	    
            If PROS_CNT = 0 Then
                szData =                 Grid.GetCellData("bd1_acnm" , i) & "★" & Grid.GetCellData("bd3_tr_amt" , i) & "★" & Grid.GetCellData("bd1_bank_code" , i) & "★" & Grid.GetCellData("bd2_bank_acno" , i)
            Else
                szData = szData & "●" & Grid.GetCellData("bd1_acnm" , i) & "★" & Grid.GetCellData("bd3_tr_amt" , i) & "★" & Grid.GetCellData("bd1_bank_code" , i) & "★" & Grid.GetCellData("bd2_bank_acno" , i)
            End If
	    
            PROS_CNT = PROS_CNT + 1
	    
        End If
    Next
    
    For i = 0 To 4 - PROS_CNT
        szData = szData & "●" & "★" & "★" & "★"
    Next
    
    If PROS_CNT = 0 Then
        Form.MsgBox("알림" , "계좌를 하나 이상 선택해주십시오." , "" , 0)
        Exit Sub
    End If
    
    If PROS_CNT > 5 Then
        Form.MsgBox("알림" , "최대 5건까지 처리 가능합니다." , "" , 0)
        Exit Sub
    End If
    
    If CDBL(LblSum.caption) > 10000000 Then
        Form.MsgBox("알림" , "1회 출금한도 초과입니다.(1천만원)" , "" , 0)
        Exit Sub        
    End If
    
    Form.SetSharedData("mbbnk62010_MultiRowData" , szData)
    
    Form.OpenFramePopup("mbbnk62010_t1" , "" , "")
    
    
End Sub


'v001
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szID )
	end if

	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
	
    If szTranID == "obcsb_scif_033r" Then
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO"    , 0 , ""    )
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"    , 0 , ""    )
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID" , 0 , g_szID)
    End If
	
End Sub

'v001
'============================================================================
' Form_Enable
'============================================================================
Function Form_Enable(EnableYn)
    if EnableYn = True then
    
		Grid.enable e      = True '그리드
		BtnNext.enable     = True '다음
		BtnRefresh.enable  = True '재조회
				
    elseif EnableYn = False then
    
		Grid.enable e      = False '그리드
		BtnNext.enable     = False '다음
		BtnRefresh.enable  = False '재조회
    end if
End Function
