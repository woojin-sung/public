--===========================================================================
' 2019.11.04 - CME개별거래소 추가 및 약관처리 추가
' 2020.09.17 - MTS메모리평문 적용유무 추가 
' 2021.05.27 - v002:개인신용정보동의 추가
--===========================================================================

Dim g_szEngName		'구독자 영문이름
Dim g_szEngAddress	'구독자 영문주소
Dim g_szEngJob		'구독자 영문직업명
Dim g_szEngCompany	'구독자 영문회사명
Dim g_szEngWorkAddr	'구독자 영문회사주소

Dim g_szAgree			'이용계약 동의여부
g_CheckBtn3Cnt = 0  	'이용약관 카운트 횟수 - 2019.11.04

g_szEngName = ""
g_szEngAddress = ""
g_szEngJob = ""
g_szEngCompany = ""
g_szEngWorkAddr = ""
g_szAgree = ""
g_szPlainRm = ""		'MTS메모리평문 적용여부

Dim g_szAllYn
g_szAllYn = "" 'v002: 전체동의여부
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData( "obtrd_acnt_321r" ) '시세신청상태 조회
	
	'등록구분/신청기간 기본세팅인 등록 및 자동연장에 맞게 컨트롤 세팅
	btnSubmit.caption = "등록"
	btnSubmit.enable = false
	
'	cldFrom.enable = true
'	cldTo.enable = false
'	cldFrom.caption = ""
'	cldTo.caption = "99991201"

	cmbPeriod_OnEditComplete(0)
	
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용) - 2020.09.17
	g_szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "AGREE" then
		if sRet <> "" then
			Dim szSplitData
			
			szSplitData = Split(sRet, "★")
			
			g_szEngName = szSplitData[0]
			g_szEngAddress = szSplitData[1]
			g_szAgree = szSplitData[2]
			
			'2019.12.05 - 주석처리
			'g_szEngJob = szSplitData[2]
			'g_szEngCompany = szSplitData[3]
			'g_szEngWorkAddr = szSplitData[4]
			'g_szAgree = szSplitData[5]
			
			btnSubmit.enable = true
		end if
		
	elseif sKeyName = "INFO_RETURN" then
		if sRet <> "" then
			Dim szSplitData
			
			szSplitData = Split(sRet, "★")
			
			g_szEngName = szSplitData[0]
			g_szEngAddress = szSplitData[1]
			
			'CME 이외의 거래소 신청시 신청자 정보 리턴 완료시 신청 버튼 활성화
			if Form.GetCtlProp("cmbExch", "currentindex") <> "0" or 'CME통합
			   Form.GetCtlProp("cmbExch", "currentindex") <> "5" or 'CME개별
			   Form.GetCtlProp("cmbExch", "currentindex") <> "6" or 'CBOT개별
			   Form.GetCtlProp("cmbExch", "currentindex") <> "7" or 'NYMEX개별
			   Form.GetCtlProp("cmbExch", "currentindex") <> "8" then 'COMEX개별
				btnSubmit.enable = true
			end if
		end if
	'v002
	elseif sKeyName = "ALL_YN" then
		if sRet <> "" then
			g_szAllYn = sRet
			'전체동의가 Y이면, 개인신용정보동의 체크처리
			if g_szAllYn = "Y" Then
				ChkAgrm.checkstate = "1"
			end If
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_acnt_321r" then
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321r", "InBlock1", "EMPL_YN" , 0 , "N")
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321r", "InBlock1", "ACNO" , 0 , Form.GetCtlProp("acnt", "total") )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321r", "InBlock1", "ASNO" , 0 , Form.GetCtlProp("acnt", "sequence") )
		
		'MTS메모리평문여부 - 2020.09.17
		If g_szPlainRm = "1" Then		'적용상태
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321r", "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPwd", "caption") )
		else							'미적용상태
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321r", "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPwd", "encdata") )
		end if
	
	elseif szTranID = "obtrd_acnt_321a" then
		Dim szREG_PRD_CLCD
		
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "EMPL_YN" , 0 , "N" )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "ACNO" , 0 , Form.GetCtlProp("acnt", "total") )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "ASNO" , 0 , Form.GetCtlProp("acnt", "sequence") )
		'MTS메모리평문여부 - 2020.09.17
		If g_szPlainRm = "1" Then		'적용상태
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPwd", "caption") )
		else							'미적용상태
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPwd", "encdata") )
		end if
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "QTTN_REG_CLCD" , 0 , cmbType.currentindex ) '0:등록, 1:해지
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "EXCH_CLCD" , 0 , cmbExch.cbkeydata ) '1:CME통합, 2:EUREX, 3:HKEX, 4:SGX, 5:OSE 6:CME개별 7:CBOT 8:NYMEX 9:COMEX
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "QTTN_APLT_CLCD" , 0, cmbQttn.cbkeydata ) '1:전문가, 2:비전문가 - 2019.11.04 추가
		
		if cmbPeriod.currentindex = "0" then
			Dim szDate
			szREG_PRD_CLCD = "1"
			
			szDate = Left( Form.GetSharedData("&HOST_DATE", false ), 6 )
			
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "STA_DATE" , 0 , szDate )
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "FIN_DATE" , 0 , "999912" )
			
		elseif cmbPeriod.currentindex = "1" then
			szREG_PRD_CLCD = "2"
			
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "STA_DATE" , 0 , cldFrom.caption )
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "FIN_DATE" , 0 , cldTo.caption )
		else
			Dim szDate
			szREG_PRD_CLCD = "3"
			
			szDate = Left( Form.GetSharedData("&HOST_DATE", false ), 6 )
			
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "STA_DATE" , 0 , szDate )
			DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "FIN_DATE" , 0 , szDate )
		end if
		
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "REG_PRD_CLCD" , 0 , szREG_PRD_CLCD) '1:자동연장, 2:기간선택, 3:당월

		'영문 고객정보데이터 (신청현황TR 조회시 또는 팝업화면에서 받아오는 데이터들)
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "CUST_ENG_NAME" , 0 , g_szEngName )	'신청자 영문명
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "ENG_ADDR" , 0 , g_szEngAddress )		'신청자 영문주소
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "AGRM_YN" , 0 , g_szAgree )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "ENG_OCPT_NAME" , 0 , g_szEngJob )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "ENG_CO_NAME" , 0 , g_szEngCompany )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_321a", "InBlock1", "ENG_CO_ADDR" , 0 , g_szEngWorkAddr )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_acnt_321r" then
		Dim nCnt, szExchCode, szSTAT_CLS_CODE
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtrd_acnt_321r", "OutBlock2" )
		
		for i = 0 to nCnt - 1 step 1
			szExchCode = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock2", "EXCH_CLCD" , i )
			szSTAT_CLS_CODE = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock2", "STAT_CLS_CODE" , i ) 'X:미신청, 0:신청, 1:해지
			
			Select Case szExchCode
				Case "1"
					grdStatus.SetCellData("bd_cell0", i, "CME(통합)")
				Case "2"
					grdStatus.SetCellData("bd_cell0", i, "EUREX")
				Case "3"
					grdStatus.SetCellData("bd_cell0", i, "HKEX")
				Case "4"
					grdStatus.SetCellData("bd_cell0", i, "SGX")
				Case "5"
					grdStatus.SetCellData("bd_cell0", i, "OSE")
				Case "6"
					grdStatus.SetCellData("bd_cell0", i, "CME(개별)")	'2019.11.04 - CME개별거래소 추가
				Case "7"
					grdStatus.SetCellData("bd_cell0", i, "CBOT(개별)")
				Case "8"
					grdStatus.SetCellData("bd_cell0", i, "NYMEX(개별)")
				Case "9"
					grdStatus.SetCellData("bd_cell0", i, "COMEX(개별)")
			End Select
			
			if szSTAT_CLS_CODE = "X" then
				grdStatus.SetCellData("bd_cell3", i, "미신청") '미신청 상태
			elseif szSTAT_CLS_CODE = "1" then
				grdStatus.SetCellData("bd_cell3", i, "미신청") '신청 후 해지시 -> 미신청 상태 
				grdStatus.SetCellData("bd_cell1", i, "")
				grdStatus.SetCellData("bd_cell2", i, "")
			end if
		next

		Dim szCUST_ENG_NAME, szENG_ADDR, szENG_OCPT_NAME, szENG_CO_NAME, szENG_CO_ADDR, szAGRM_YN
		
		szCUST_ENG_NAME = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock1", "CUST_ENG_NAME" , 0 )
		szENG_ADDR = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock1", "ENG_ADDR" , 0 )
		szENG_OCPT_NAME = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock1", "ENG_OCPT_NAME" , 0 )
		szENG_CO_NAME = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock1", "ENG_CO_NAME" , 0 )
		szENG_CO_ADDR = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock1", "ENG_CO_ADDR" , 0 )
		szAGRM_YN = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321r", "OutBlock1", "AGRM_YN" , 0 )
		
		if szCUST_ENG_NAME <> "" then
			g_szEngName = szCUST_ENG_NAME
		end if
		
		if szENG_ADDR <> "" then
			g_szEngAddress = szENG_ADDR
		end if
		
		if szENG_OCPT_NAME <> "" then
			g_szEngJob = szENG_OCPT_NAME
		end if
		
		if szENG_CO_NAME <> "" then
			g_szEngCompany = szENG_CO_NAME
		end if
		
		if szENG_CO_ADDR <> "" then
			g_szEngWorkAddr = szENG_CO_ADDR
		end if
		
		if szAGRM_YN <> "" then
			g_szAgree = szAGRM_YN
		end if
		
	elseif szTranID = "obtrd_acnt_321a" then
		Dim szCode
		
		szCode = DATAMANAGER.GetDataValue( false, "obtrd_acnt_321a", "OutBlock1", "PROS_YN" , 0)
		
		if Form.GetCtlProp("cmbType", "currentindex") = "0" then
			if szCode = "Y" then
				Form.ShowAlert("알림", "등록 신청이 완료되었습니다.")
				
				DATAMANAGER.RequestTranData("obtrd_acnt_321r")
			end if
			
		elseif Form.GetCtlProp("cmbType", "currentindex") = "1" then
			if szCode = "Y" then
				Form.ShowAlert("알림", "해지 신청이 완료되었습니다.")
				
				DATAMANAGER.RequestTranData("obtrd_acnt_321r")
			end if
		end if
		
		'v002 : 개인신용정보동의 동의내역 초기화
	     g_szAllYn = "N"
		ChkAgrm.checkstate = "0"
		
	end if
End Sub

'============================================================================
Sub edtPwd_OnEditComplete() '2019.11.04 주석해제
'	if Form.GetCtlProp("edtPwd", "caption") <> "" then
'		DATAMANAGER.RequestTranData( "obtrd_acnt_321r" )
'	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'20190213 LES START
	if szErrCode = "4984" then
		Exit Sub
	end if
	'20190213 LES END
	
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub cmbExch_OnEditComplete(iIndex)
	'선택된 거래소가 CME 통합 및 개별이 아니라면 이용계약 버튼 숨김 '2019.11.04
	if iIndex = 0 or (iIndex >=5 and iIndex <=8) then	
		btnTerms.visible = true
		
		if Form.GetCtlProp("cmbType", "currentindex") = "0" then 
			btnSubmit.enable = false '등록 숨김
		else 
			btnSubmit.enable = true  '해지 표시
		end if
	else
		btnTerms.visible = false
		btnSubmit.enable = true
	end if
End Sub

'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	if iIndex <> 0 then			'등록구분 콤보값이 해지일경우 나머지 콤보 및 버튼 비활성화 (거래소 선택 콤보 제외)
		cmbExch.enable = true
		cmbPeriod.enable = false
		btnTerms.enable = false
		cldTo.enable = false
		cldFrom.enable = false
		
		btnSubmit.enable = true
		btnSubmit.caption = "해지"
	else
		cmbExch.enable = true
		cmbPeriod.enable = true
		btnTerms.enable = true
		cldFrom.enable = true
		cldTo.enable = true
		
		btnSubmit.enable = false
		btnSubmit.caption = "등록"
		
		if Form.GetCtlProp("cmbExch", "currentindex") = "0" or 'CME통합
		   Form.GetCtlProp("cmbExch", "currentindex") = "5" or 'CME개별
		   Form.GetCtlProp("cmbExch", "currentindex") = "6" or 'CBOT개별
		   Form.GetCtlProp("cmbExch", "currentindex") = "7" or 'NYMEX개별
		   Form.GetCtlProp("cmbExch", "currentindex") = "8" then 'COMEX개별
		   btnSubmit.enable = false
	     else
		   btnSubmit.enable = true
		end if
	end if
	
	'v002
	ChkAgrm.checkstate = "0"
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	if iIndex = 0 then			'자동연장
		cldFrom.enable = true
		cldFrom.caption = ""
		cldTo.enable = false
		cldTo.caption = "99991201"
	elseif iIndex = 2 then			'당월
		cldFrom.enable = false
		cldTo.enable = false
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
	else							'기간선택
		cldFrom.enable = true
		cldTo.enable = true
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
	end if
End Sub

'============================================================================
Sub btnSubmit_OnClick()
	
	'2019.11.04 - 비전문가 선택시, 약관버튼 클릭해야 진행
	if Form.GetCtlProp("cmbQttn", "currentindex") = "1" and	'비전문가
		Form.GetCtlProp("cmbType", "currentindex") = "0" then	'등록
		if g_CheckBtn3Cnt = 0 then
			Form.ShowAlert("알림", "이용약관 확인후 신청 가능합니다.")
			Exit Sub
		end if
	end if
	
	'v002 : 등록이고, 동의여부가 Y일때만 등록 가능
	if cmbType.cbkeydata = "0" Then
		if ChkAgrm.checkstate = "0" Then
			Form.ShowAlert("알림", "개인(신용)정보제공 동의 후 신청 가능합니다.")
		Exit Sub
		end if
	End If
	
	if Form.GetCtlProp("edtPwd", "caption") <> "" then
		DATAMANAGER.RequestTranData("obtrd_acnt_321a")
	else
		Form.ShowAlert("알림", "비밀번호를 입력해주세요.")
	end if	
	
End Sub

