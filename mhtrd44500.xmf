Sub ButtonAgrm_OnClick()
	Dim sURL 
	sURL = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf"
	acno = acnt.caption
	Form.SetSharedData("ACNO"  , acno )	'계좌번호
	Form.SetSharedData("EMPLYN", "N"  )	'직원여부
	Form.SetSharedData("OPEN_URL"  , sURL )	'PDF링크
	Form.OpenFramePopup("mhtrd44500_pop" , "해외파생 개인정보처리 요약동의서" , "")
End Sub

