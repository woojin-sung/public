'20230109 HSZ 주간거래 시세 추가
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szFirst
g_szFirst = "0"

' 20160309 중복종목 체크
Dim g_szCd
g_szCd = ""

Dim g_szTitle
g_szTitle = "알림"

' 20160407 종목다중선택을 위해 필요한 변수
Dim g_tCode()
g_tCode = {}

' 20160404 앱 최초 등록확인(그룹 없음) ->편집 활성화
Dim g_szAppFirst
g_szAppFirst = "NO"

'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm
g_tGSelect = {}
g_tDefault = {"GW_RECENT_OVERSEA", "GW_HOLDING_OVERSEA"}
g_tKey     = {"BB", "CC"}
g_tNm      = {"최근조회 종목", "보유종목"}


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	fmTab.currenttab = "1"	' 20160406 : 속도이슈때문에 미리 탭위치 변경
	' 폼탭의 좌우스크롤 제어
	Control_FmTab_Swipe()
	
	f_EventPopup()
	reqIntrGroupList()
	'20230707 HSZ START: 주간 체크값 저장
	szChk = Trim(Form.LoadConfigData( "11010", "GW_DAYTIME" ))
	if szChk = "" then
		chkDaytime.checkstate = 0
	else
		chkDaytime.checkstate = CInt(szChk)
		call chkDaytime_OnChange(szChk)
	end if
	'20230707 HSZ END
End Sub


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Control_FmTab_Swipe : 폼탭의 좌우스크롤 제어
'============================================================================
Function Control_FmTab_Swipe()
	' 좌우 스크롤시 관심그룹 변경 설정
	' 20160325 최초설정은 좌우스트롤 가능하도록 변경 -> 요청사항
	if Form.GetEnvData("GW_SWIPE_OVERSEA") == "0" then
		fmTab.usepg = "0"
	else
		fmTab.usepg = "1"
	end if
End Function


'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	' 2018.01.02 CJH JF, JO 추가
	Select Case szMk
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
		Case Else
			return ""
	End Select
End Function

'============================================================================
' null 체크
'============================================================================
Sub isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
end Sub

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
	DATAMANAGER.RequestTranData("ohhts_intr_039r")
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' 이전 그룹 이동
'============================================================================
Sub btnPrev_OnClick()
	if Int(cboIntrGroup.currentindex) == 0 then
		cboIntrGroup.currentindex = cboIntrGroup.rowcount-1
	else
		cboIntrGroup.currentindex = cboIntrGroup.currentindex - 1
	end if
End Sub

'============================================================================
' 이후 그룹 이동
'============================================================================
Sub btnNext_OnClick()
	if Int(cboIntrGroup.currentindex) == Int(cboIntrGroup.rowcount-1) then
		cboIntrGroup.currentindex = 0
	else
		cboIntrGroup.currentindex = cboIntrGroup.currentindex + 1
	end if
	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub

'============================================================================
' fmTab_OnTabChanged
'============================================================================
Sub fmTab_OnTabChanged(nCurrentTab)
	fmTab.currenttab = "1"		' 20160406 :  속도이슈때문에 선택 위치 변경
	
	if nCurrentTab == 2 then
		btnNext_OnClick()
	elseif nCurrentTab == 0 then
		btnPrev_OnClick()
	end if
End Sub

'============================================================================
' 그룹 이동
'============================================================================
Sub cboIntrGroup_OnEditComplete(iIndex)
	Dim szStyle, szKey
	
	'최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = cboIntrGroup.cbkeydata	
	'20160906 NOHES START 왓칭, 최근조회, 보유종목은 추가버튼 예외처리
	if szKey == "BB" or szKey == "CC" then
		Table0.SetCellFgColor(1, 0, "4") 
		Table0.SetCellFgColor(1, 2, "127")
	else
		Table0.SetCellFgColor(1, 0, "4") 
		Table0.SetCellFgColor(1, 2, "4")
	end if
	
	if g_szFirst == "0" then
		g_szFirst = "1"
	end if
	
	edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
	
	sEnvKey = "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
	Form.SetEnvData("1", sEnvKey, cboIntrGroup.cbkeydata)
	
	'20211026 아이티젠(김성수) 관심 개선 START
	f_SetToggleUI(szKey)
	lblGroupNm.caption = cboIntrGroup.caption 
	'20211026 아이티젠(김성수) 관심 개선 END
	
	' 타매체에서 종목,그룹 추가를 고려해서 FID버전ID 재요청
	DATAMANAGER.RequestTranData( "ohhts_intr_036r_1" )
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cboIntrGroup.cbkeydata & "♥" & edtvrsnID.caption)		
End Sub

'============================================================================
' 종목 추가
'============================================================================
Sub BtnItemAdd_OnClick( )
	' 최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = cboIntrGroup.cbkeydata
	
	'20160906 NOHES START 최근조회, 보유종목 추가버튼만 예외처리
	if szKey == "BB" or szKey == "CC" then
		Exit Sub
	end if
	
	Dim nRowCount, nGroupCnt
	nRowCount = CInt(edtListCnt.caption)
	nGroupCnt = CInt(grdGroup.rowcount)
	
	if g_nGroupCnt = 0 then
		Form.MsgBox("알림", "등록된 관심그룹이 없습니다.\n생성하시겠습니까?", "MAKE_INTEREST_GROUP", 1)
	else
		if nRowCount >= 100 then
			Form.ShowAlert( "알림", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		else
			Form.OpenCommonDialog("SEARCH", "20", nRowCount)		'종목갯수를 플랫폼에 보낸다.
		end if
	end if
end Sub

'============================================================================
' 관심 편집
'============================================================================
Sub BtnItemEdit_OnClick()
	Form.OpenFramePopup("mhtro16010_p0" , "" , "")
end Sub

'============================================================================
' 관심그룹 리스트 조회
'============================================================================
Sub reqIntrGroupList()	
	cboIntrGroup.clear = "1"
	DATAMANAGER.RequestTranData( "ohhts_intr_036r" )
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 환경설정 팝업 리턴 ---------------------------------------------------
	if sKeyName == "GW_SET" then
		if Trim(sRet) <> "" then
			' 폼탭의 좌우스크롤 제어
			Control_FmTab_Swipe()
			' 그룹콤보 초기화
			Insert_cboIntrGroup()
		end if
	' 종목편집 완료
	elseif sKeyName == "INTR_EDIT_COMPLETE" and sRet == "1" then
		reqIntrGroupList()
	
	'20211026 아이티젠(김성수) 관심 개선 START
	elseif sKeyName = "mhprc11010_p7_select" then '그룹팝업에서 리턴
		cboIntrGroup.currentindex = sRet
		
	elseif sKeyName = "mhprc11010_p7_edit" then '그룹팝업에서 리턴
		Form.OpenFramePopup("mhtro16010_p0" , "1", "") '편집 팝업 오픈
	'20211026 아이티젠(김성수) 관심 개선 END
	end if
End Sub

'============================================================================
'종목추가 
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if Trim(sReturn1)  <> "" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_ADD", sReturn1 & "★" & cboIntrGroup.caption)
		end if
	end if	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
	if sEventName == "SCREEN_MENU" then		
		if sParam == "SET_SCREEN" then
			Form.OpenFramePopup("mhtro16010_p6" , "환경설정", "")
		end if
	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 관심편집팝업 오픈
	if sKeyName == "ADDGROUP" then	
		If sRet == "ok" Then
			Form.OpenFramePopup("mhtro16010_p0" , "1", "")
		End If
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	DATAMANAGER.ClearInputData(0, szTranID)
	' ----------------------------------------------------------------------
	' 그룹조회
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_intr_036r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_KIND_CODE", 0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
	' FID 버전조회
	elseif szTranID == "ohhts_intr_036r_1" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r_1", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r_1", "InBlock1", "FID_KIND_CODE", 0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_036r" then
		'20160906 NOHES START관심그룹 없는 경우 새로등록창 안내
		If g_szFirst == "0" Then
			If DATAMANAGER.GetDataCount(0, "ohhts_intr_036r" , "OutBlock1") < 1 Then
				Form.MsgBox("안내", "등록된 관심그룹이 없습니다.\n관심그룹을 새로 등록하시겠습니까?", "ADDGROUP", 1)
			End If
		End If
		' 관심그룹을 그룹콤보에 넣기
		Insert_cboIntrGroup()
	' FID 버전조회(타매체에서 종목,그룹 추가를 고려해서 FID버전ID 재요청)
	elseif szTranID == "ohhts_intr_036r_1" then
		' Sub화면에 조회 요청
		edtvrsnID.caption = DATAMANAGER.GetDataValue(0, "ohhts_intr_036r_1", "OutBlock2", "FID_VRSN_ID" , 0 )
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "NEW_FIDVRSN", edtvrsnID.caption)		
	end if
End Sub

'============================================================================
' Insert_cboIntrGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cboIntrGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect
	
	' 콤보 리스트 클리어
	Form.SetCtlProp("cboIntrGroup", "clear", "")
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	sEnvKey = "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
	szSave = Form.GetEnvData(sEnvKey)
	
	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
	For i = 0 to #g_tDefault-1
	
		' 보유종목은 고유MTS에서는 안보임처리
		if g_tDefault[i] == "GW_HOLDING_OVERSEA" then
			szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
			if szMediaCode = "156" or szMediaCode = "157" then
				g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
			else
				'20211202 HSZ START : 관심종목 리뉴얼
				cboIntrGroup.visible = true
				btnPrev.visible = true
				btnNext.visible = true
				btnOpenGroup.visible = false
				lblGroupNm.visible = false
				'20211202 HSZ END
				g_tGSelect[i] = "0"
			end if
		else
			g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
		end if
		
		
		
		if g_tGSelect[i] == "" or g_tGSelect[i] == null then
			g_tGSelect[i] = "1"
		end if
		
		' 해당그룹 Show시
		if g_tGSelect[i] == "1" then
		
			if i == 0 then
				szgrpList = g_tKey[i] & "`" & g_tNm[i]
			
				nIdx = 0
			else
				if szgrpList == "" then
					szgrpList = g_tKey[i] & "`" & g_tNm[i]
				else
					szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
				end if
				
				if nIdx >= 0 then
					nIdx = nIdx + 1
				else
					nIdx = 0
				end if			
			end if
			
			if szSave == g_tKey[i] then
				nSelect = nIdx
			end if

			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		end if
	NEXT
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		g_szAppFirst = "NO"
		
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
	else
		g_szAppFirst = "YES"
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cboIntrGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	'20160804 NOHES START 초기값 셋팅
	If CStr(nSelect) == "-1" Then
		nSelect = 0 
	End If
	'20160804 NOHES END
	cboIntrGroup.currentindex = CStr(nSelect)	
End Function

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
	'20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

'============================================================================
' Form_OnRefresh : 관심을 첫화면으로 했을때 종목 재조회
'============================================================================
Sub Form_OnRefresh()
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cboIntrGroup.cbkeydata & "♥" & edtvrsnID.caption)
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
'	20211209 HSZ START: 해외CFD > 관심종목 분기처리
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	If g_szScreenNo == "16110" then
		g_tNm      = {"최근조회 종목", "CFD 보유종목"}
		
		Form.SetTitleCaption("해외주식CFD 관심종목")
	end if
'	20211209 HSZ END
End Sub

'20211115 아이티젠 김성수 해외주식 관심 개선 추가 START
'============================================================================
' f_ShowGroupList : 관심그룹리스트 보이기
'============================================================================
Function f_ShowGroupList()
	dim nRowCnt, szSendData
	nRowCnt = CInt(grdGroup.rowcount)
	szSendData = ""
	
	if nRowCnt > 0 then
		for i=0 to nRowCnt-1
			dim sKey, sName, sStr
			sKey = grdGroup.GetCellData( "bd_code", i )
			sName = grdGroup.GetCellData( "bd_name", i )
			sStr = sKey & "`" & sName
			
			if szSendData == "" then
				szSendData = sStr
			else
				szSendData = szSendData & "★" & sStr
			end if
		next
	end if

	Form.SetSharedData("PresentSelectKey" , cboIntrGroup.cbkeydata) '현재 선택된 그룹키
	
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	if g_Ostype = "2" then
		Form.OpenPopupAnimation("mhprc11010_p7" , szSendData, "", "3")
	else 
		Form.OpenPopupAnimation("mhprc11010_p7" , szSendData, "", "1")
	end if
	
End Function

'============================================================================
' imgEdit_OnClick : 종목추가 클릭 이벤트
'============================================================================
Sub imgEdit_OnClick()
	' 최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = cboIntrGroup.cbkeydata
	
	'20160906 NOHES START 최근조회, 보유종목 추가버튼만 예외처리
	if szKey == "BB" or szKey == "CC" then
		Exit Sub
	end if
	
	Dim nRowCount, nGroupCnt
	nRowCount = CInt(edtListCnt.caption)
	nGroupCnt = CInt(grdGroup.rowcount)
	
	if g_nGroupCnt = 0 then
		Form.MsgBox("알림", "등록된 관심그룹이 없습니다.\n생성하시겠습니까?", "MAKE_INTEREST_GROUP", 1)
	else
		if nRowCount >= 100 then
			Form.ShowAlert( "알림", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		else
			Form.OpenCommonDialog("SEARCH", "20", nRowCount)		'종목갯수를 플랫폼에 보낸다.
		end if
	end if
End Sub

'============================================================================
' imgGrp_OnClick : 관심편집 클릭 이벤트
'============================================================================
Sub imgGrp_OnClick()
	Form.OpenFramePopup("mhtro16010_p0" , "0", "") '20211130 HSZ 종목편집 팝업 오픈
End Sub
'============================================================================
' btnOpenGroup_OnClick : 그룹메뉴 버튼
'============================================================================
Sub btnOpenGroup_OnClick()
	f_ShowGroupList()
End Sub

'============================================================================
' lblGroupNm_OnClick : 그룹명 label
'============================================================================
Sub lblGroupNm_OnClick()
	f_ShowGroupList()
End Sub

'============================================================================
' f_SetToggleUI : 이미지 버튼 UI SET
'============================================================================
Function f_SetToggleUI(szKey)
	'20160906 NOHES START 왓칭, 최근조회, 보유종목은 추가버튼 예외처리
	if szKey == "BB" or szKey == "CC" then
		imgEdit.visible = false
		chkDaytime.left = 257	'20230109 HSZ
	else
		imgEdit.visible = true
		chkDaytime.left = 225	'20230109 HSZ
	end if
	'20160906 NOHES END
End Function

