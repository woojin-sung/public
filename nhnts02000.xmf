'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "ITEMINFO_POP_CLOSE" then
		Image0.visible = true
		
	'20200331 HWG START : 고유MTS
	elseif sKeyName = "FUNDINFO" then
	
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
			
		end if
	end if
	'20200331 HWG END
End Sub

