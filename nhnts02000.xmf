'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_intr_006r" then
		szUserId = Form.GetSharedData("&USER_ID" , false)	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0 , szUserId )	
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "ohhts_intr_006r" then  '관심그룹 조회
		g_nGroupCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r", "OutBlock1")
	end if
End Sub

'============================================================================
Sub Click_GWANSIM()
	Dim szCode
	szCode = ItemCode0.code
	if Trim(szCode) = "" then
		exit sub
	end if
	
	if g_nGroupCnt = 0 then
		Form.OpenPopup("mhprc11000_pf", "GROUP_ADD2" & "★" & szCode & "★", "")		'관심그룹과 관심종목 동시추가
	else
		'관심종목 등록 화면 팝업
		Form.OpenPopupAnimation("mhprc11000_pd", szCode & "★"& "ADD","", "2")	'종목등록
	end if 
End Sub

