Dim g_sDecimalLen
Dim sData

'20210610 SWJ START : 해외주식 시세 자체구축 프로젝트
'주문설정값
Dim g_szChangeInit
Dim g_szBuyPrc
Dim g_szSelPrc
Dim g_szModPrc
Dim g_szAfterOrg

Dim g_szCloud		'관심 서버사용 여부
Dim g_nGroupCnt	'관심 그룹 개수

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		' 종목/탭 변경시 초기화

	g_szBuyPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")		' 주식매수주문가격 자동입력
	g_szSelPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")		' 주식매도주문가격 자동입력
	g_szModPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC")		' 주식정정주문가격 자동입력
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			' 원주문번호 자동입력

	' 주식매수주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 주식매도주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 주식정정주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END	
	
	'관심 관련 세팅
	g_szCloud = Form.GetEnvData("common.interest_cloud")	' 관심 동기화 
	if Trim(g_szCloud) == "" then						' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if

	if g_szCloud == "1" then		' Server 저장시		
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else							' Local 저장시
		Load_GWGroup()
	end if

End Function
'20210610 SWJ END

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")

		g_nGroupCnt = #tGroup
	end if	
	
End Function

'============================================================================
Function Tonum(sValue)
	return tonumber( sValue ) or 0
end Function

'============================================================================
' 거래소 ID 시장명으로 변환
'============================================================================
Function Transform_Market(sValue)
	if sValue == "HK" then
		return "홍콩"
	elseif sValue == "CN" then
		return "중국"
	elseif sValue == "JP" then
		return "일본"
	elseif sValue == "US" then
		return "미국"
	end if
end Function

'============================================================================
'[[ 폼 초기화 ]]
'============================================================================
Sub Form_OnFormInit()
	'20200331 HWG START : 고유MTS
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	edtFundCd.setFundPwCtl("edtPwd")
	'20200326 HWG END
	
	'20210610 SWJ START
	Load_OrderSet()
	'20210610 SWJ END
	
	f_EventPopup()
	if Form.GetOpenLinkData( ) == "0" or Form.GetOpenLinkData( ) == 0	then			'매수
		FormTab0.currenttabpageid = "page0"
	elseif Form.GetOpenLinkData( ) == "1" or Form.GetOpenLinkData( ) == 1	then		'매도
		FormTab0.currenttabpageid = "page1"	
	else
		szData = Form.GetOpenLinkData()
		arrData = Split(szData, "♥")
		if arrData(0) <> "" then
			Form.setOverStockItemCode(arrData(0))
			if arrData(1) == "0" then
				FormTab0.currenttabpageid = "page0"
			elseif arrData(1) == "1" then
				FormTab0.currenttabpageid = "page1"
				Form.SetSharedData("JANGO" , arrData(2))
			end if
		end if
	end if

	ItemCode0.code = Form.GetSharedData("&ITEM_CODE", false)
	if Len(ItemCode0.code) > 0 then
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "InitCode", ItemCode0.code )
		Form.triggerEvent( "LinkForm2", "RequestData", ItemCode0.code)
		
		'20210610 SWJ START
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
		DATAMANAGER.RequestTranData("ohhts_6000_002r")
		'20210610 SWJ END
	end if
	
	Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeFundCd", "" )	'20200331 HWG : 고유MTS
end Sub

'============================================================================
'[[ 폼탭 변경시 ]]
'============================================================================


'============================================================================
Sub Form_OnRefresh()
	ItemCode0_OnEditComplete(ItemCode0.code)
end Sub
 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH" then
		ItemCode0_OnEditComplete(ItemCode0.code)
	
	'20210610 SWJ START : 해외주식 시세 자체구축 프로젝트
	'elseif "TITLE_CLICK" == sEventName then
	     'Form.OpenPopup( "mhtro16000_p0" , "", "" )
	
	elseif sEventName == "REG_INTR" then ' 상반바 우측 관심추가 버튼 클릭 시
'		Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code , "" )
		Click_GWANSIM()
	elseif sEventName = "SCREEN_MENU" then							' 연결정보(상단 ...)
		
		if sParam = "REG_INTR" Then								' 관심종목등록
'			Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code , "" )
			Click_GWANSIM()

		elseif sParam = "SET_SCREEN" Then							' 화면설정
			Form.OpenScreen("90000" , "1")

		end if
	'20210610 SWJ END
	
	elseif (sEventName == "02000_BALANCE") then	'20200331 HWG : 고유MTS
		Form.setOverStockItemCode(sParam)
		
	elseif (sEventName == "02000_CONTRACT") then	'20200331 HWG : 고유MTS
		Form.setOverStockItemCode(sParam)
	end if
end Sub



'============================================================================
Sub Form_OnLinkData(sKey, sValue)	
	if "&ITEM_CODE" == sKey then
		edtOrgNo.caption = ""			'20210610 SWJ START : 해외주식 시세 자체구축 프로젝트
		ItemCode0_OnEditComplete(sValue)
	end if
End Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	ItemCode0.code = sCode
	Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeCode", ItemCode0.code )
	Form.triggerEvent( "LinkForm2", "RequestData", ItemCode0.code)
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if Len(ItemCode0.code) > 0 then
		
		'20210610 SWJ START : 해외주식 시세 자체구축 프로젝트
		'if nCurrentTab = 2 then
	'		if g_szAfterOrg == "1" then		'주문연동시
		'		if edtOrgNo.caption <> "" then
	'				Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption) '주문번호 연동
	'			end if
	'		end if
	'	end if
		'20210610 SWJ END
		
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeTab", ItemCode0.code )	
	end if
End Sub
