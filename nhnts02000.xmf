Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG" then
		if sRet == "ok" then
			Form.OpenScreen("87051" , "")
		end if
	end if
End Sub

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
    szEndDate = "20180731"                            ' 팝업노출일
    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
        if szDate == null or szDate == "" then
            Form.OpenPopup("popup_noti", "" , "")
        else
            nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
            if nDiffDay > 7 then
                Form.SetEnvData("EVENT_DATE_YH", "")
                Form.OpenPopup("popup_noti", "" , "")
            end if
        end if
    end if
end function

