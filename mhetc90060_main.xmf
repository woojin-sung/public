'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then 
		'if g_IDRegYN == "Y" then 
		if g_szAcno <> "" and Len(g_szAcno) >= 8 then 	
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "3" ) '계좌번호
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO"      , 0 , Left(g_szAcno, 8) )
		else
			'앱 설치하자마자 업무신청에서 모바일OTP 발급 후, 타매체에서 푸시로 인증할 때
			'ID값이 없어서 인증오류 생기는 현상 방지
			if g_sUserID == "" or g_sUserID == null then
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '주민번호
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"   , 0 , g_szRcnoPip )
			else	
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '고객ID
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"   , 0 , g_szUserID )		
			end if		
		end if
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE, sSMRT_OTP_YN
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:보안매체 , 9:에러
		sRSLT_CLS    = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "RSLT_CLS"      , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		'UI스마트OTP여부
		sSMRT_OTP_YN = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN", 0 )
		

'sRSLT_CLS = "2" 'for TEST
'sSMRT_OTP_YN = ""	'for TEST
'msgbox sRSLT_CLS	'for TEST	
		g_szRSLT_CLS_NEW = ""
		Select Case sRSLT_CLS
			Case "0" '보안카드 보유
				g_szRSLT_CLS_NEW = "C"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				'Form.OpenPopup( "mhetc90060_p9" , "" , sPosInfo)		
				
			Case "1" '부가정보
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				
			Case "2"	'보안매체 미보유
				'계좌번호★주민번호★Y/N : 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함			
				Form.OpenPopup("mhetc90190_p1", g_szAcno &"★"& g_szRcnoPip &"★"& "N", "")
				
			Case "3" '보안매체
				 '모바일OTP 보유
				if sSMRT_OTP_YN == "M" then
					g_szRSLT_CLS_NEW = "M"
					
					Form.SetSharedData("IdRegPros", "Y" )         '"Y"이면 ID등록
					Form.SetSharedData("IdRegProsAcno", g_szAcno ) '계좌번호					
					Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")
					
				'스마트OTP 보유	
				elseif sSMRT_OTP_YN == "Y" then 
					g_szRSLT_CLS_NEW = "S"
					
					Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)
					
				'OTP보유	
				else'if sSMRT_OTP_YN == null or sSMRT_OTP_YN = "" then  
					g_szRSLT_CLS_NEW = "O" '알파벳대문자
					
					Form.SetSharedData("IdRegPros", "Y" )         '"Y"이면 ID등록
					Form.SetSharedData("IdRegProsAcno", g_szAcno ) '계좌번호					
					Form.OpenPopup("mhetc90060_otp", "otp_success" , "")
					
				end if 
				
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				Form.CloseForm()				
		End Select
'msgbox g_szRSLT_CLS_NEW	'for TEST	

		'사용중인 보안매체저장
		Form.SetSharedData("&RSLT_CLS_90060", g_szRSLT_CLS_NEW)

'		Form.SetTimerEvent2(1, 1, 0.6)
	end if  	
End Sub
	

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg	
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	szErrMsg = szErrMsg & "\n" & sSubMsg
	Form.MsgBox( "알림" .. szTranID, szErrMsg, "", 6 )
	Form.CloseForm()				
End Sub
