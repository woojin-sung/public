'============================================================================
' 화 면 명 : 인증매체 공통화면
' 화면설명 : 인증매체 공통화면
' 작    성 : 2024.01.25 
'============================================================================
dim g_szList		'BSWR_DIV_CODE(업무별 예외처리용)★RCNO_PIP(주민번호)★ELFN_ID(사용자ID)★ACNO(계좌번호)
dim g_szDiv		'업무분류코드(BSWR_DIV_CODE)  ' TODO :: 사용여부 확인필요
dim g_szUserID 	'사용자ID
dim g_szCsNo	 	'고객번호
dim g_szAcno		'계좌번호
dim g_szAsno		'계좌일련번호
dim g_szRcnoPip	'실명확인번호PIP(주민번호)
'dim g_szCONO		'1: 개인, 2: 법인

dim g_ScrNum		'화면번호
dim g_DeviceOS	'1.안드로이드 2.iOS
dim g_LoginType	'로그인상태 Cint(g_LoginType) > 1 

dim g_szRSLT_CLS_NEW '사용중인 보안매체저장
g_szRSLT_CLS_NEW = ""

'dim g_IDRegYN, g_IDRegAcno	 ' TODO :: 사용여부 확인필요

dim g_szRet '리턴값 ok, cancel
g_szRet = "cancel"

'============================================================================
Sub Form_OnFormInit()
'lblOpen.visible = true 'for TEST
 
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO",true) '메뉴클릭시 팝업메뉴 화면번호 전달
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", 0 )	'로그인상태 Cint(g_LoginType) > 1 
	'g_szCONO    = Form.GetSharedData("&LOGIN_CUST_CLS_CODE", false) '1: 개인, 2: 법인	
	
	'BSWR_DIV_CODE(업무별 예외처리용)★고객번호★RCNO_PIP(주민번호)★ELFN_ID(사용자ID)★ACNO(계좌번호)
	dim szLinkedData
	szLinkedData = Form.GetOpenLinkData( )
	if len(szLinkedData) > 0 then
		g_szList = Split(szLinkedData , "★")
		g_szDiv = g_szList(0)     '업무별 예외처리용
		g_szCsNo = g_szList(1)    '고객번호
		g_szRcnoPip = g_szList(2) '주민번호
		g_szUserID = g_szList(3)  '사용자ID
		g_szAcno = g_szList(4)	   '계좌번호
		
	else
		'Form.ShowAlert("안내", "입력값이 없습니다.")
		g_szDiv	   = "" '업무별 예외처리용
		g_szCsNo    = Form.GetSharedData("&CUST_NUM"  , false ) '고객번호
		g_szRcnoPip = Form.GetSharedData("&JUMIN_NUM" , false)  '주민번호 암호화 값
		g_szUserID  = Form.GetSharedData("&USER_ID" , false)    '사용자ID
		g_szAcno    = "" '계좌번호
		
		'주민번호와 고객번호를 getshared 뒤지다가 안나오면 발급 시 set한 값 불러오도록 처리(ios쪽 처리때문)
		if g_szRcnoPip == "" or g_szRcnoPip == null then
			g_szRcnoPip = Form.GetEnvData("login.session.juminnopip")
		end if
		'비로그인 상태로 진행할때를 대비
		if g_szRcnoPip == "" or g_szRcnoPip == null then
			g_szRcnoPip = Form.GetSharedData("BDM_RCNO_PIP", false)
		end if
		'고객번호
		if g_szCsNo == "" or g_szCsNo == null then
			g_szCsNo = Form.GetEnvData("login.session.custno")
		end if	
		
	end if	
'for TEST
'msgbox "계좌번호 :"  & g_szAcno		
'msgbox "사용자ID :"  & g_szUserID		
'msgbox "주민번호 :"  & g_szRcnoPip		
'msgbox "고객번호: " & g_szCsNo		
'msgbox "업무별 예외처리용 : " & g_szDiv		
	
	'팝업하는 화면별 예외처리
'	if g_ScrNum == "" then
'	end if 

	DATAMANAGER.RequestTranData("obcsb_oimf_520r") '보안매체상태조회

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'msgbox sKeyName & " :: "& sRet	'for TEST
'	'보안매체 미보유
'	if sKeyName = "mhetc90190_p1" then
'	'보안카드 보유 
'	elseif sKeyName = "mhetc90060_p9" then
'	'OTP 보유
'	elseif sKeyName = "mhetc90060_otp" then
'	'모바일OTP 보유
'	elseif sKeyName = "mhetc90060_motp" then
'	'스마트OTP 보유
'	elseif sKeyName = "mhetc90060_pb" then
'	end if 

	g_szRet = sRet	
	if sRet == "ok" then
		DATAMANAGER.RequestData("obcsb_oimf_520r") '보안매체상태재조회
		Form.SendReturnToParent("SUCC_YN_90060_RETURN" , "Y")		
	else
		Form.SendReturnToParent("SUCC_YN_90060_RETURN" , "N")	
		Form.CloseForm()	
	end if 
End Sub 

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mhetc90060_main" , g_szRet)	
End Sub

