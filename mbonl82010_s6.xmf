'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szActPwd
Dim g_nSelectRow
Dim g_szFnprJoinSrno
Dim g_szProsDate
Dim g_szProsSRNO
Dim g_szInputCd
Dim g_szPossibleAct
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function f_SetAccountMask(szAccount)
	Dim szReturnData 
	if trim(szAccount) ~= "" then
		if #szAccount == 10 then
			szReturnData = Left(szAccount,4)&"-"&Mid(szAccount,5,4)&"-"&Right(szAccount,2)		
		elseif #szAccount == 8 then
			szReturnData = Left(szAccount,4)&"-"&Right(szAccount,4)
		else
			szReturnData = szAccount
		end if
	end if
	
	return szReturnData
	
End Function


'============================================================================
Sub Form_OnFormInit()
	g_nSelectRow = -1
	cont0.Grid0.setUseCardView(true, 10, "img_bgbox.9.png")
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Init" then
		g_szInputCd = "2"
		DATAMANAGER.RequestTranData("oblon_basc_811r")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			Form.triggerEvent("#", "CORRECT_4", tPwd[0])
			g_szActPwd = tPwd[0]
			
			'LHR 수정
			'Form.MsgBox("안내", "신용거래약정을\n해지하시겠습니까?", "Cancel", 1)
			
			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
		end if
	elseif sKeyName == "mhetc90060_p5" then		
		if sRet ~= "cancel" then
			'LHR 수정
			'DATAMANAGER.RequestTranData("obsap_acif_999a")
			DATAMANAGER.SetEventFlag( "oblon_basc_803a", "A" )
			DATAMANAGER.RequestTranData( "oblon_basc_803a" ) '약정등록	
		end if 
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
'	Form.ShowAlert(sKeyName, sRet)

	if sKeyName == "Cancel" then
		if sRet == "ok" then
'			DATAMANAGER.RequestTranData("obaci_acct_255a")
'			DATAMANAGER.RequestTranData("obsap_acif_999a")
			'LHR 수정
			'DATAMANAGER.SetEventFlag( "oblon_basc_803a", "A" )
			'DATAMANAGER.RequestTranData( "oblon_basc_803a" )
			'LHR 수정
			dim szAcntInfo
			szAcntInfo = cont0.Grid0.GetCellData( "bd_Data1", g_nSelectRow)
			szAcntInfo = Replace( szAcntInfo, "-", "")
			Form.openPopupAnimation("pwdcheckpopup", szAcntInfo&"☆2", "", "2")
			'Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
			
		end if
		
	elseif sKeyName == "oblon_basc_803a" then
		if sRet == "close" then
			Form.triggerEvent( "#", "End", "")
		end if
	end if 
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_basc_811r" then
		Dim szID
		szID = Form.GetSharedData("&USER_ID", false )
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , szID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOAN_TYPE_CODE" , 0 , "01")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , g_szInputCd )
		
	elseif szTranID == "oblon_basc_803a" then
		Dim szAccount
		Dim szRegDate		
		Dim sLoanType	
		Dim tUI_PROD_OPNG_YN 
		Dim szUI_COND
		Dim szDejuDate
		Dim szTmp
		
		szAccount = trim(cont0.Grid0.GetCellData( "bd_Input1", g_nSelectRow ))
		szRegDate = trim(cont0.Grid0.GetCellData( "bd_Input2", g_nSelectRow ))
		sLoanType = trim(cont0.Grid0.GetCellData( "bd_Input3", g_nSelectRow ))
		szTmp = trim(cont0.Grid0.GetCellData( "bd_Input4", g_nSelectRow ))
		tUI_PROD_OPNG_YN = Split(szTmp, "★")
		szUI_COND = trim(cont0.Grid0.GetCellData( "bd_Input5", g_nSelectRow ))
		szDejuDate = trim(cont0.Grid0.GetCellData( "bd_Input6", g_nSelectRow ))
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "ACNO" , 0 , Left(szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "ASNO" , 0 , Right(szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "ACNT_PWD" , 0 , g_szActPwd )
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD", 0, "013")
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "PROS_DATE", 0, g_szProsDate)
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "PROS_SRNO", 0, g_szProsSrno)
'		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "FNPR_JOIN_SRNO", 0, g_szFnprJoinSrno ) 'V001
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "PROS_CLS_CODE" , 0 , "3" )		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" ) 'v001
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "UI_PROD_OPNG_YN1" , 0 , tUI_PROD_OPNG_YN[0] )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "UI_PROD_OPNG_YN2" , 0 , tUI_PROD_OPNG_YN[1] )
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "ACNO" , 0 , Left(szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "ASNO" , 0 , Right(szAccount, 2) )		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "MORG_APLY_FORM_CODE" , 0 , sLoanType )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "LOAN_CORE_MANL_CNFR_YN" , 0 , "Y" )		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_TR_CNFR_YN" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_RISK_TR_NTIC_YN" , 0 , "" )			
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "LOAN_STPL_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "REG_DATE" , 0 , szRegDate )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STUP_DATE" , 0 , szDejuDate )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "CRDT_STPL_YN" , 0 , "N" )	
		
		if szDejuDate == null or szDejuDate == "" or szDejuDate == "N" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STPL_YN" , 0 , "N" )		
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STPL_YN" , 0 , "Y" )		
		end if 
		
	' 개인신용정보동의
	elseif szTranID == "obaci_acct_255a" then	
		Dim szAccount
		szAccount = trim(cont0.Grid0.GetCellData( "bd_Input1", g_nSelectRow ))
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ACNO" , 0 , Left( szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ASNO" , 0 , Right( szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "ISCD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "RMND_SRNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD" , 0 , "013") 'g_sKindCode
		DATAMANAGER.SetDataValue( 0, "obaci_acct_255a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "1" ) '요약1, 상세2, 둘다3
		
		'필수동의(공통)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "UI_COMN_AGRM_YN1" , 0 , "Y")'수집이용 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock2", "UI_COMN_AGRM_YN2" , 0 , "Y")'수집이용 개인신용정보
		
		'필수동의(수집/이용 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "UI_COMN_AGRM_YN1" , 0 , "Y" )'수집이용_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock3", "UI_COMN_AGRM_YN2" , 0 , "Y" )'수집이용_신용공여/미수/파생상품 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN1" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 고유식별번호
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN2" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 민감정보
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock4", "UI_COMN_AGRM_YN3" , 0 , "0" )'수집이용_비과세종합저축/ISA/연금저축 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "UI_COMN_AGRM_YN1" , 0 , "0" )'수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock5", "UI_COMN_AGRM_YN2" , 0 , "0" )'수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보

		'필수동의(제공 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "UI_COMN_AGRM_YN1" , 0 , "Y" )'제공_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock6", "UI_COMN_AGRM_YN2" , 0 , "Y" )'제공_신용공여/미수/파생상품 개인신용정보
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "PROS_CLS_CODE" , 0 , "0" )
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "UI_COMN_AGRM_YN1" , 0 , "0" )'제공_해외주식/해외파생/해외금융/EUREX 고유식별번호
'		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock7", "UI_COMN_AGRM_YN2" , 0 , "0" )'제공_해외주식/해외파생/해외금융/EUREX 개인신용정보

		'필수동의(조회 상품별)
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "PROS_CLS_CODE" , 0 ,"1" )
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "UI_COMN_AGRM_YN1" , 0 , "Y" )'조회_신용공여/미수/파생상품 고유식별번호
		DATAMANAGER.SetDataValue(0, "obaci_acct_255a", "InBlock8", "UI_COMN_AGRM_YN2" , 0 , "Y" )'조회_신용공여/미수/파생상품 개인신용정보 
		
	elseif szTranID == "obsap_acif_999a" then
		DATAMANAGER.SetDataValue( 0 , "obsap_acif_999a", "InBlock1", "IQRY_CLS_CODE", 0 , "")	
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_811r" then	
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, "oblon_basc_811r", "OutBlock1" ))

		if g_szInputCd == "3" then
			if nCnt > 0 then
				Dim szAct
				Dim szActGb			
				szAct = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ACNO", 0 ) '계좌번호		
				szActGb = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ASNO", 0 ) '계좌상품코드
				g_szPossibleAct = szAct&szActGb
			else
				cont0.contBtm.visible = "0"
			end if
		else
			if nCnt > 0 then
				for i=0 to nCnt - 1 
					Dim szAct
					Dim szActGb
					Dim szRegDate
					Dim sUI_PROD_OPNG_YN1 
					Dim sUI_PROD_OPNG_YN2
					Dim sLoanType
					Dim szDejuDate
					Dim szUI_COND
					
					szAct = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ACNO", i ) '계좌번호		
					szActGb = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ASNO", i ) '계좌상품코드	
					szActNm = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_INPR_NAME", i ) '계좌상품코드	
					szRegDate = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "REG_DATE", i ) '신청일자			
					sUI_PROD_OPNG_YN1 = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_PROD_OPNG_YN1" , i ) 'SMS		
					sUI_PROD_OPNG_YN2 = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_PROD_OPNG_YN2" , i ) 'E-mail		
					sLoanType = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MORG_APLY_FORM_CODE" , i ) '신용융자/대주코드(A : 기본형, B : 투자형)		
					szDejuDate = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STLN_STUP_DATE", i ) '대주일자
					szUI_COND = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_COND_RSLT_CLS_VAL", i ) '유통융자 담보활용 동의 신청 여부
					
					'신청계좌
					Dim szAccount
					szAccount = f_SetAccountMask(szAct&szActGb)
					
					'신청일자
					szRegDate = Replace( szRegDate, "-", "")
					
					'신용거래유형
					Dim szLoan
					if sLoanType == "A" then
						szLoan = "기본형"
					elseif sLoanType == "B" then
						szLoan = "투자형"
					end if
					
					'담보관련 통보방법
					Dim szUI_PROD_OPNG
					if sUI_PROD_OPNG_YN1 == "Y" and sUI_PROD_OPNG_YN2 == "Y" then
						szUI_PROD_OPNG = "SMS, 이메일"
					else
						if sUI_PROD_OPNG_YN1 == "Y" then
							szUI_PROD_OPNG = "SMS"
						end if
						
						if sUI_PROD_OPNG_YN2 == "Y" then
							szUI_PROD_OPNG = "이메일"
						end	if
					end if
					
					'유통융자 담보활용 동의
					Dim szAgree
					if szUI_COND == "Y" then
						szAgree = "동의"
					else
						szAgree = "미동의"
					end if
					
					
					cont0.Grid0.AddRow( )
					cont0.Grid0.SetCellData( "bd_Title1", i, "신청계좌")
					cont0.Grid0.SetCellData( "bd_Title2", i, "신청일자")
					cont0.Grid0.SetCellData( "bd_Title3", i, "신용거래유형")
					cont0.Grid0.SetCellData( "bd_Title4", i, "담보관련 통보")
					cont0.Grid0.SetCellData( "bd_Title5", i, "유통융자\n담보활용동의")
					cont0.Grid0.SetCellData( "bd_Left",   i, "해지")
					cont0.Grid0.SetCellData( "bd_Right",  i, "변경")
					
					'LHR 수정
					cont0.Grid0.SetCellData( "bd_Data1", i, trim(szAccount))
					cont0.Grid0.SetCellData( "bd_Data2", i, trim(szRegDate))
					cont0.Grid0.SetCellData( "bd_Data3", i, trim(szLoan))
					cont0.Grid0.SetCellData( "bd_Data4", i, trim(szUI_PROD_OPNG))
					cont0.Grid0.SetCellData( "bd_Data5", i, trim(szAgree))	
					
					cont0.Grid0.SetCellData( "bd_Input1", i, trim(szAct&szActGb))
					cont0.Grid0.SetCellData( "bd_Input2", i, trim(szRegDate))
					cont0.Grid0.SetCellData( "bd_Input3", i, trim(sLoanType))
					cont0.Grid0.SetCellData( "bd_Input4", i, trim(sUI_PROD_OPNG_YN1&"★"&sUI_PROD_OPNG_YN2))
					cont0.Grid0.SetCellData( "bd_Input5", i, trim(szUI_COND))
					cont0.Grid0.SetCellData( "bd_Input6", i, trim(szDejuDate))
				next
					
				dim nRowCnt
				nRowCnt = CInt(cont0.Grid0.rowcount)
				'cont0.Grid0.height = (CInt(cont0.Grid0.height) * nRowCnt ) + ((nRowCnt-1)*10)
				cont0.Grid0.height = (CInt(cont0.Grid0.height) * nRowCnt )
				
				'  항상 보이게 수정
				cont0.contBtm.visible = true
				cont0.contBtm.top = CInt(cont0.Grid0.height) + 30
				cont0.lblScrollSize.top = CInt(cont0.Grid0.height) + 30 + 110 + 80
				'Form.ShowAlert(cont0.lblScrollSize.top, Form.calcUnResize(cont0.lblScrollSize.top, "1") )
			else
				cont0.contBtm.visible = true
				cont0.contBtm.top = 10
				cont0.lblScrollSize.top = 10
			
			end if 		
			
			cont0.SetScrollAutoSize()
			
			g_szInputCd = "3"
			DATAMANAGER.RequestTranData("oblon_basc_811r")
		end if
	
	' 개인신용정보동의
	elseif szTranID == "obaci_acct_255a" then
		g_szProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
		g_szProsSRNO =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
		
		DATAMANAGER.RequestTranData("obsap_acif_999a")
		
	elseif szTranID == "obsap_acif_999a" then
'		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0, "obsap_acif_999a" , "OutBlock1" , "FNPR_JOIN_SRNO" , 0)
		DATAMANAGER.SetEventFlag( "oblon_basc_803a", "A" )
		DATAMANAGER.RequestTranData( "oblon_basc_803a" ) 
		
	elseif szTranID == "oblon_basc_803a" then
		g_szActPwd = ""
		g_nSelectRow = -1
		g_szFnprJoinSrno = ""
		g_szProsDate = ""
		g_szProsSRNO = ""
		
		Form.MsgBox("안내", "신용거래약정이 해지되었습니다.", "oblon_basc_803a", 6)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg <> "" and szSubMsg <> null then
		Form.ShowAlert("알림", szErrMsg & "\n" & szSubMsg )
	else
		Form.ShowAlert("알림", szErrMsg )
	end if 
End Sub


'============================================================================
Sub cont0_Grid0_OnClickUp(lRow, szCellID)
	g_nSelectRow = -1
	g_szActPwd = ""
'	g_szFnprJoinSrno = ""
'	g_szProsDate = ""
'	g_szProsSRNO = ""
	
	if szCellID == "bd_Left" then '해지하기 버튼
		g_nSelectRow = lRow	
		
		dim szAcntInfo
		szAcntInfo = cont0.Grid0.GetCellData( "bd_Data1", lRow)
		szAcntInfo = Replace( szAcntInfo, "-", "")

		'계좌 비밀번호 팝업 호출
		'LHR 순서 변경
		Form.MsgBox("안내", "신용거래약정을 해지하시겠습니까?", "Cancel", 1)
		'Form.openPopupAnimation("pwdcheckpopup", szAcntInfo&"☆2", "", "2")
		
	elseif szCellID == "bd_Right" then '변경하기 버튼
		'g_szTrData = sLoanType.."★"..sUI_PROD_OPNG_YN1.."★"..sUI_PROD_OPNG_YN2.."★"..szRegDate.."★"..szDejuDate.."★"..szUI_COND
		
		Dim szAccount
'		Dim szRegDate		
'		Dim sLoanType	
'		Dim tUI_PROD_OPNG_YN 
'		Dim szUI_COND
'		Dim szDejuDate
'		Dim szTmp
'		
		szAccount = trim(cont0.Grid0.GetCellData( "bd_Input1", lRow ))
'		szRegDate = trim(cont0.Grid0.GetCellData( "bd_Input2", lRow ))
'		sLoanType = trim(cont0.Grid0.GetCellData( "bd_Input3", lRow ))
'		szTmp = trim(cont0.Grid0.GetCellData( "bd_Input4", lRow ))
'		tUI_PROD_OPNG_YN = Split(szTmp, "★")
'		szUI_COND = trim(cont0.Grid0.GetCellData( "bd_Input5", lRow ))
'		szDejuDate = trim(cont0.Grid0.GetCellData( "bd_Input6", lRow ))
'		
'		Dim szTrData
'		szTrData = sLoanType.."★"..tUI_PROD_OPNG_YN[0].."★"..tUI_PROD_OPNG_YN[1].."★"..szRegDate.."★"..szDejuDate.."★"..szUI_COND.."★"..szAccount
		Form.triggerEvent("#", "Change", "Change".."★"..szAccount)
		
	end if
End Sub

'============================================================================
Sub cont0_contBtm_btnAdd_OnClick()
	if trim(g_szPossibleAct) ~= "" then
		Form.triggerEvent("#", "Change", "Add".."★"..trim(g_szPossibleAct))
	end if
End Sub



