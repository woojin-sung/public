	<MAP_INFO scrno="88010" scrname="ELW매매거래위험고지" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<WEBVIEW name="web0" urlpath="about:blank" ly_vert="-2,-2,379,611,1" />
