	<SCRIPT_INFO _len="23519" _ulen="22881" >
'============================================================================
' 화 면 명 : 
' 화면설명 : KYC 고객설문
' 작    성 : 2021.03.15 : 이현우
'		    2021.10.20 : V001. 온라인 재진단 1회 제한 -> 3회 제한으로 변경
'============================================================================
Dim g_szCustClsCode	'개인/법인 여부 (1:개인, 2:법인)
Dim g_szTrigType
Dim g_szAnxtAprt_Yn	'부적정여부 (Y,N)
'Const Type
Dim QUERY
Dim EXECUTE
QUERY   = "1"		'질의문
EXECUTE = "2"		'입력

Dim g_INBLOCK			'for TriggerEvent
dim g_INBLOCK_PROS_CLS_CODE
dim g_INBLOCK_ACNO
dim g_INBLOCK_ASNO
dim g_INBLOCK_ACNT_PWD
dim g_INBLOCK_CONT_CLS_CODE
dim g_INBLOCK_CUST_RLTS_CODE	
dim g_INBLOCK_PXPR_NAME
dim g_INBLOCK_BRDT
dim g_INBLOCK_CUST_RLTS_ETC_CNTT
dim g_INBLOCK_COUN_EMPNO
'V001
dim g_INBLOCK_APLT_REAS_CLCD
dim g_INBLOCK_RMRK

dim g_szSelectRdoImage, g_szUnSelectRdoImage

Dim g_tItemCntt

'LHR 수정
Dim g_szPopupYN
'============================================================================
' Form Init Before
'============================================================================
Sub Form_OnFormInitBefore()
	contScroll.imgRdo131.setMaintainingRatio("1")
	contScroll.imgRdo132.setMaintainingRatio("1")
	contScroll.imgRdo133.setMaintainingRatio("1")
	contScroll.imgRdo134.setMaintainingRatio("1")
	contScroll.imgRdo135.setMaintainingRatio("1")
	contScroll.imgRdo136.setMaintainingRatio("1")
	contScroll.imgRdo141.setMaintainingRatio("1")
	contScroll.imgRdo142.setMaintainingRatio("1")
	contScroll.imgRdo143.setMaintainingRatio("1")
	contScroll.imgRdo144.setMaintainingRatio("1")
	contScroll.imgRdo145.setMaintainingRatio("1")
End Sub
'============================================================================
' Form Init
'============================================================================
Sub Form_OnFormInit()
	g_szSelectRdoImage = "check_circle_on"
	g_szUnSelectRdoImage = "check_circle_off"

	'Initialize
	g_szAnxtAprt_Yn = ""	'부적정여부 체크
	g_INBLOCK_ACNO  = ""
	g_szCustClsCode = ""	'개인/법인 여부 (1:개인, 2:법인)	
	
	'LHR 수정
	g_szPopupYN = Form.GetSharedData("mbonl93500_g_szPopupYN", false )
	if g_szPopupYN == "Y" then
		contScroll.height = 607
	else
		contScroll.height = 562
	end if
	
	contScroll.img7Tip.setMaintainingRatio("2")
	contScroll.lblCntText.bringfront("1")
End Sub

'============================================================================
' Receive Trigger Event
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "ACNT_INFO" Then
		'Data Split
		g_INBLOCK = Split(sParam,"★")
		g_INBLOCK_ACNO     	  = g_INBLOCK(0)
		g_INBLOCK_ASNO     	  = g_INBLOCK(1)
		g_INBLOCK_ACNT_PWD 	  = g_INBLOCK(2)
		
		' Valid Check	    
	    if trim(g_INBLOCK_ACNO) = "" then
		    Form.ShowAlert("알림", "계좌번호가 없습니다. 처리불가합니다.")
		    exit sub
	    end if
		
		'대출 고객정보 확인서 응답 조회
		DATAMANAGER.RequestTranData("oblon_basc_102r")
	elseif sEventName = "SCROLL_UP" then
		sDeviceOS = Form.GetSharedData("&OS_TYPE", false)
		if sDeviceOS == "2" then '아이폰
			contScroll.scroll_pos_noAni = Form.calcUnResize(contScroll.lblCntText.top, "1")
		else
			contScroll.scroll_pos = Form.calcUnResize(contScroll.lblCntText.top, "1")
		end if
	End If
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'대출 고객정보 확인서 응답 조회
	if szTranID = "oblon_basc_102r" then
	    if trim(g_INBLOCK_ACNO) <> "" then
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_INBLOCK_ACNO )
	    end if
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'대출 고객정보 확인서 응답 조회
	if szTranID = "oblon_basc_102r" then
		if DATAMANAGER.IsMoreNextData(szTranID) = true then
			DATAMANAGER.RequestNextData(szTranID)
		else
			Dim nCnt
			nCnt = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CSNU", 0 ))
			contScroll.lblCntText.caption = "당일진단 회차 : " & nCnt & "회(1일 3회까지 가능)"
			call Check_Value_Set()
		end If
	end If	
End Sub

'============================================================================
' 질의결과 조회항목 화면에 세팅
'============================================================================
Sub Check_Value_Set()
    for i = 0 to Grid1.rowcount - 1
	    QUES_QSIT_NO = CLNG(Grid1.GetCellData("bd_ques_qsit_no", i)) '설문문항번호
	    ITEM_NO_VAL  = Grid1.GetCellData("bd_item_no_val" , i)  '항목번호값
	    ITEM_CNTT    = Grid1.GetCellData("bd_item_cntt"   , i) '항목내용
	    RSPN_SLCT_YN = Grid1.GetCellData("bd_rspn_slct_yn", i) '응답선택여부
	    TRGT_AMT	 = CDBL(Grid1.GetCellData("bd_trgt_amt" , i))  '대상금액
	    
	    if ITEM_NO_VAL <> "0" then 
		    if RSPN_SLCT_YN = "Y" then
			    Form.SetCtlProp( "contScroll.rdoQ"&QUES_QSIT_NO, "currentindex", ITEM_NO_VAL-1)
		    end if
		else
		    if RSPN_SLCT_YN = "Y" then
			    Dim nRdoIndex
			    
			    if QUES_QSIT_NO == 5 or QUES_QSIT_NO == "5" then
				    '자산현황		
					if TRGT_AMT == "" or TRGT_AMT == "0" or TRGT_AMT == 0 or TRGT_AMT == null then
						nRdoIndex = -1
					else
						if CInt(TRGT_AMT) > 1000000000 then
							nRdoIndex = 4
						elseif CInt(TRGT_AMT) > 500000000 then
							nRdoIndex = 3
						elseif CInt(TRGT_AMT) > 300000000 then
							nRdoIndex = 2
						elseif CInt(TRGT_AMT) > 100000000 then
							nRdoIndex = 1
						else
							nRdoIndex = 0
						end if
					end if
					
				elseif QUES_QSIT_NO == 6 or QUES_QSIT_NO == "6" then
					'소득현황					
					if TRGT_AMT == "" or TRGT_AMT == "0" or TRGT_AMT == 0 or TRGT_AMT == null then
						nRdoIndex = -1
					else
						if CInt(TRGT_AMT) > 100000000 then
							nRdoIndex = 4
						elseif CInt(TRGT_AMT) > 50000000 then
							nRdoIndex = 3
						elseif CInt(TRGT_AMT) > 30000000 then
							nRdoIndex = 2
						elseif CInt(TRGT_AMT) > 10000000 then
							nRdoIndex = 1
						else
							nRdoIndex = 0
						end if
					end if
					
				elseif QUES_QSIT_NO == 7 or QUES_QSIT_NO == "7" then
					'부채현황					
					if TRGT_AMT == "" or TRGT_AMT == "0" or TRGT_AMT == 0 or TRGT_AMT == null then
						nRdoIndex = -1
					else
						if CInt(TRGT_AMT) > 100000000 then
							nRdoIndex = 4
						elseif CInt(TRGT_AMT) > 50000000 then
							nRdoIndex = 3
						elseif CInt(TRGT_AMT) > 30000000 then
							nRdoIndex = 2
						elseif CInt(TRGT_AMT) > 10000000 then
							nRdoIndex = 1
						else
							nRdoIndex = 0
						end if
					end if
					
				end if
					
			    Form.SetCtlProp( "contScroll.rdoQ"&QUES_QSIT_NO, "currentindex", nRdoIndex)
		    end if
	    end if
    next 
    
    'call Form.SetRedraw( true )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)	
	if szTranID == "oblon_basc_102r" then
		szSub = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if trim(szSub) <> "" then
			szErrMsg = szErrMsg& "\n" &szSub
		end if
		Form.MsgBox("알림", szErrMsg , "", 0)
		Exit Sub
	end if
End Sub

