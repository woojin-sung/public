Sub contScroll_rdoQ3_OnClick(nIndex)
	if g_szRdoQ3Index == null or g_szRdoQ3Index == "" or g_szRdoQ3Index == "-1" or g_szRdoQ3Index== -1 then
		g_szRdoQ3Index = nIndex
	else
		if CInt(g_szRdoQ3Index) == nIndex then
			g_szRdoQ3Index = ""
			contScroll.rdoQ3.currentindex = "-1"
		else
			g_szRdoQ3Index = nIndex
		end if
	end if 
End Sub

