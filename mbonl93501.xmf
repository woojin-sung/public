Sub contScroll_img7Tip_OnClick()
	Dim sText
	sText = "신용평가사로부터 채무불이행 이력이 수신된 경우 약정이 불가하며, 고객의 신용점수는 신용약정 계약 체결 전 회사에서 추후 확인합니다."
	contScroll.img7Tip.openToolTip( sText, 330, 90, 1 )
End Sub

'============================================================================
Sub contScroll_btnChange_OnClick()
	Dim szSendData
	Dim tCtlNm
	tCtlNm = {"rdoQ4", "rdoQ1", "rdoQ2", "rdoQ3", "rdoQ5", "rdoQ6", "rdoQ7", "rdoQ8","rdoQ12", "rdoQ13", "rdoQ14"}
	for i = 0 to #tCtlNm - 1
		do
			Dim szIndex 
			Dim ITEM_CNTT
			szIndex = Form.GetCtlProp( "contScroll."&tCtlNm[i], "currentindex")
			szName  = Form.GetCtlProp( "contScroll."&tCtlNm[i], "name")
			
			
			'LHR 수정
			'선택을 안한 경우 continue
			if Cint(szIndex) < 0 then
				Exit do
			end if
			'ITEM_CNTT    = Grid1.GetCellData("bd_item_cntt" , i) '항목내용
			if 	  szName == "rdoQ4" then ITEM_CNTT = contScroll.rdoQ4.GetRadioCaption(szIndex)
			elseif szName == "rdoQ1" then ITEM_CNTT = contScroll.rdoQ1.GetRadioCaption(szIndex)
			elseif szName == "rdoQ2" then ITEM_CNTT = contScroll.rdoQ2.GetRadioCaption(szIndex)
			elseif szName == "rdoQ3" then ITEM_CNTT = contScroll.rdoQ3.GetRadioCaption(szIndex)
			elseif szName == "rdoQ5" then ITEM_CNTT = contScroll.rdoQ5.GetRadioCaption(szIndex)
			elseif szName == "rdoQ6" then ITEM_CNTT = contScroll.rdoQ6.GetRadioCaption(szIndex)
			elseif szName == "rdoQ7" then ITEM_CNTT = contScroll.rdoQ7.GetRadioCaption(szIndex)
			elseif szName == "rdoQ8" then ITEM_CNTT = contScroll.rdoQ8.GetRadioCaption(szIndex)
			elseif szName == "rdoQ12" then ITEM_CNTT = contScroll.rdoQ12.GetRadioCaption(szIndex)
			elseif szName == "rdoQ13" then ITEM_CNTT = contScroll.rdoQ13.GetRadioCaption(szIndex)
			elseif szName == "rdoQ14" then ITEM_CNTT = Form.GetCtlProp("contScroll.lblRdo8"&szIndex+1, "caption")
	'		else
	'			Form.ShowAlert("!", szName)
			end if
			
			if szSendData == null or szSendData == "" then			
				szSendData = tCtlNm[i] & "☆" & szIndex & "☆" & ITEM_CNTT
			else
				szSendData = szSendData & "★" & tCtlNm[i] & "☆" & szIndex & "☆" & ITEM_CNTT
			end if
		loop while false
	next
	
	 Form.triggerEvent("#", "ChangeData", szSendData)
End Sub

