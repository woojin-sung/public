	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="oblon_basc_100r" trcode="oblon_basc_100r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="oblon_basc_101a" trcode="oblon_basc_101a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="oblon_basc_102r" trcode="oblon_basc_102r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="oblon_basc_100r" title="대출 고객정보 확인서 설문 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="54" _ulen="42" >

CUST_CLS_CODE^고객구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="60" inout="out" _len="233" _ulen="179" >

APLT_NO^신청번호^11^0^7^0^0^0^0
QUES_QSIT_NO^설문문항번호^11^0^7^0^0^0^0
ITEM_NO_VAL^항목번호값^10^0^0^0^0^0^0
ITEM_CNTT^항목내용^200^0^0^0^0^0^0
MLTT_SLCT_ABLE_YN^다중선택가능여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="oblon_basc_101a" title="대출 고객정보 확인서 응답 등록" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="490" _ulen="370" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
