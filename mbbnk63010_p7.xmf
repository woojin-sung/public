	<SCRIPT_INFO _len="1807" _ulen="1793" >
--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()

	if szData <> "" and szData <> null then
		arrTransInfo = Split(szData, "★")
		
		nAcmlAmt = CInt(arrTransInfo(0))
		nOneTimeAmt = CInt(arrTransInfo(1))
		nOneDayAmt = CInt(arrTransInfo(2))
		nTranIndex = CInt(arrTransInfo(3))

		if nTranIndex > 1 then
			contMany.tblLimit.SetCellString(0, 1, nAcmlAmt)
			contMany.tblLimit.SetCellString(1, 1, nOneTimeAmt)
			contMany.tblLimit.SetCellString(2, 1, nOneDayAmt)
			
			contMany.tblTrans.SetCellString(0, 0, "["..(nTranIndex-1).."]건 이체접수 중")
			contMany.tblTrans.SetCellString(0, 1, CInt(arrTransInfo(4)))
			
			contMany.visible = "1"
		else
			contOne.tblLimit.SetCellString(0, 1, nAcmlAmt)
			contOne.tblLimit.SetCellString(1, 1, nOneTimeAmt)
			contOne.tblLimit.SetCellString(2, 1, nOneDayAmt)
			contOne.visible = "1"
		end if
	end if
End Sub

'============================================================================
Sub contMany_btnConfirm_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contOne_btnConfirm_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub


