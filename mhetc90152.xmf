'로그인 or 인증센터 (CLOUD_EVENT_ACQUIREUSERINFO 이벤트 발생시) -> mhetc90302.xmf -> mhetc90303.xmf

Dim g_Back_Flag   '뒤로가기플래그

g_Back_Flag = ""

Dim g_bExistCert
g_bExistCert = False

Dim g_sArrCloudID
g_sArrCloudID = Array()

Dim g_sArrCloudDN
g_sArrCloudDN = Array()

