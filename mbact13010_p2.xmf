'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객정보입력
' 02. 화면설명 : 고객정보입력_직종선택
' 03. 작    성 : 2016.02.29 노은솔
' 04. 수    정 : 2017.09.07 윤유정 : 대분류 자동셋팅 제거 v0001
'              : 2018.09.13 윤유정 : 그리드 멈춤 높이 수정(그리드 바디 높이 축소) v0002
'              : 2023.03.22 양현정 : CDD직업코드값 개편 v0003
'-------------------------------------------------------------------------------------------
Dim	g_lCellID
Dim	g_lRow
	g_lRow = -1
Dim g_sRetData
Dim g_isNextFlag
'============================================================================
Sub BtnOK_OnClick()
	If g_lRow < 0 Then
		ShowAlert("확인", "직종을 선택하여주시기 바랍니다.")
		Exit Sub
	End If
	
	sName = Grid0.GetCellData("bd_cell0", g_lRow)
	lLrdv = Grid0.GetCellData("bd_cell1", g_lRow)
	lSmdv = Grid0.GetCellData("bd_cell2", g_lRow)
	
	Form.SetSharedData("13010_OCCU_NAME" , sName)
	Form.SetSharedData("13010_OCCU_LRDV" , lLrdv)
	Form.SetSharedData("13010_OCCU_SMDV" , lSmdv)
	
	Form.SendReturnToParent("mbact13010_p2" , sName)	

	Form.CloseForm()
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	If g_lRow >= 0 Then
		nIndex = g_lRow%2
		If nIndex = 0 Then
			Grid0.SetCellFgColor("bd_cell0",g_lRow,"4")				
		Else
			Grid0.SetCellFgColor("bd_cell0",g_lRow,"4")		
		End If
	End If
	Grid0.SetCellFgColor(szCellID,lRow,"10")
	
	g_lRow = lRow

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranMessage(szTranID, szMsgCode, szMessage, szSubMessage)
	if szTranID == "obcmm_kcdd_032r" then
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcmm_kcdd_032r", "OutBlock1" ))
		if nCnt > 0 then
			for i=0 to nCnt-1
				strCode = DATAMANAGER.GetDataValue( 0, "obcmm_kcdd_032r", "OutBlock1", "AML_OCKN_LRDV_CODE", i )
				
				'v0003 코드값 개편
'				if strCode = "01" then
'					strName = "관리자"
'				elseif strCode = "02" then
'					strName = "전문가 및 관련 종사자"
'				elseif strCode = "03" then
'					strName = "사무 종사자"
'				elseif strCode = "04" then
'					strName = "서비스 종사자"
'				elseif strCode = "05" then
'					strName = "판매 종사자"
'				elseif strCode = "06" then
'					strName = "농림어업 숙련 종사자"
'				elseif strCode = "07" then
'					strName = "기능원 및 관련 기능 종사자"
'				elseif strCode = "08" then
'					strName = "장치, 기계조작 및 조립종사자"
'				elseif strCode = "09" then
'					strName = "단순노무 종사자"
'				elseif strCode = "OA" then
'					strName = "군인"
'				end if

				if strCode = "01" then
					strName = "직장인"
				elseif strCode = "02" then
					strName = "자영업자"
				elseif strCode = "03" then
					strName = "전문직"
				elseif strCode = "04" then
					strName = "학생"
				elseif strCode = "05" then
					strName = "주부"
				elseif strCode = "06" then
					strName = "무직"
				elseif strCode = "07" then
					strName = "전업투자자"
				elseif strCode = "08" then
					strName = "가상자산사업 종사자"
				elseif strCode = "09" then
					strName = "카지노사업 종사자"
				elseif strCode = "10" then
					strName = "대부업 종사자"
				elseif strCode = "11" then
					strName = "환전업무 종사자"
				elseif strCode = "12" then
					strName = "귀금속 판매 종사자"
				elseif strCode = "13" then
					strName = "기타"
				end if

				DATAMANAGER.SetDataValue 0, "obcmm_kcdd_032r", "OutBlock1", "AML_OCKN_EXPL", i, strName				
			next
		end if
		
		If DATAMANAGER.IsMoreNextData(szTranID) == true Then
			g_isNextFlag = true
		Else
			g_isNextFlag = False
		End If
	end if

End Sub


'============================================================================
Sub Grid0_OnScrollEnd()
	If g_isNextFlag == true Then
		DATAMANAGER.RequestNextData("obcmm_kcdd_032r")
	End If
End Sub

'============================================================================
Sub Form_OnFormInit()

	'v0003
	szLinkedData = Form.GetOpenLinkData( )
	'Form.ShowAlert("확인", szLinkedData)
	if len(trim(szLinkedData)) > 0 then	
		Combo0.cbkeydata = szLinkedData
		Combo0.enable = false
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_LRDV_CODE" , 0 , Combo0.cbkeydata)
		DATAMANAGER.RequestTranData("obcmm_kcdd_032r")	
	else
		'v0001
		Combo0.caption = "직종 대분류를 선택해주세요."	
	end if
	
	'DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_LRDV_CODE" , 0 , "%")
	'DATAMANAGER.RequestTranData("obcmm_kcdd_032r")
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
	
End Sub


'============================================================================
Sub Button0_OnClick()
	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_032r" , "InBlock1" , "AML_OCKN_LRDV_CODE" , 0 , "%")
	DATAMANAGER.RequestTranData("obcmm_kcdd_032r")
End Sub

