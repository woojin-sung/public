	<SCRIPT_INFO _len="13190" _ulen="12022" >
'============================================================================
' 01. 화 면 명 : 중요거래단말지정서비스_지정단말조회/해지
' 02. 화면설명 : 중요거래단말지정서비스_지정단말조회/해지 탭
' 03. 작    성 : 2016.01.18 ~ 최지희
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_638r IO 변경분 반영
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserId	'고객아이디
Dim g_szMacAddr	'맥주소
Dim g_szRegCount
Dim g_szRegYN
Dim g_nBtnIndex
Dim g_szProsCls	'각각의 해지 2, 전체 해지 3
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회'
		btnCancelOne.enable = false
		btnCancelTwo.enable = false
		btnCancelThree.enable = false
		btnCancelFour.enable = false
		btnCancelFive.enable = false
		g_szRegCount = 0
		g_szRegYN = "N"
		
		'16-03-08 TR Input값 변경 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY", 0 , Form.GetDeviceID())	'단말지정구분코드
'		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "MAC_ADDR" , 0 , g_szMacAddr)	'MAC 주소
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
	
	if szTranID == "obcsb_oimf_636a" then	'이용pc단말 등록(범용)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "PROS_CLS" , 0 , g_szProsCls)	'처리구분	1:등록 2:해지 3:전체해지
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "ELFN_ID" , 0 , Trim(g_szUserId))	'전자금융ID
		
		
		
		if g_szProsCls == "3" then	'전체해지
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "TERM_NAME" , 0 , "")
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "MAC_ADDR" , 0 , Form.GetDeviceID())	'맥주소
			
		else	'각각의 해지
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "TERM_NAME" , 0 , GridPro1.GetCellData( "bd_cell0", g_nBtnIndex-1 ))
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "MAC_ADDR" , 0 , GridPro1.GetCellData( "bd_cell1", g_nBtnIndex-1 ))	'맥주소
		end if
		
		if GridPro1.GetCellData( "bd_cell2", g_nBtnIndex-1 ) <> "" then	'디스크 일련번호가 있다는 것은 pc에서 등록된 것
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "DISK_SERL_NO" , 0 , GridPro1.GetCellData( "bd_cell2", g_nBtnIndex-1 ))
		else
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "UI_TERM_IDNT_KEY", 0 , Form.GetDeviceID())	'단말지정구분코드
		end if 
				
		DATAMANAGER.RequestTranData("obcsb_oimf_636a")
	end if
	
End Function

'============================================================================
' SendQuery
'============================================================================
Function SendQuery()
	Form.OpenFramePopup("mhetc90060_p8" , "mobile_cancel" , "")
	'TR_Inquiry("obcsb_oimf_638r")
End Function


'============================================================================
' SendUnReg
'============================================================================
Function SendUnReg()
	Dim szTermNm
	szTermNm = GridPro1.GetCellData( "bd_cell0", g_nBtnIndex-1 )
	
	if szTermNm == "" then			'단말기별명
		Form.ShowAlert("알림", "삭제할 등록단말이 없습니다.")
		exit function
	end if
	
	Form.OpenFramePopup("mhetc90060_p8" , "mobile_cancel" , "")
	
End Function

'============================================================================
' CheckCert
'============================================================================
Function CheckCert()
	
	if g_nBtnIndex == 100 Or g_szRegCount == 1 then	'100은 전체해지 1은 최후 1개 단말 해지
		'추가인증 화면을 열고 정상 처리가 되었을 경우 쿼리 진행
'		TR_Inquiry("obcsb_oimf_636a")
		Call SendQuery()		
	else
		Call SendUnReg()
	end if
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub btnInform_OnClick()
	Form.OpenPopup("mbonl86010_p1" , "지정단말조회해지" , "")

End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szProsCls = ""
	if sEventName == "cancel" then			
		btnSearch_OnClick()
	end if	
End Sub

'============================================================================
' btnSearch_OnClick  - 조회
'============================================================================
Sub btnSearch_OnClick()
	for i=2 to 11 
		if i== 3 or i== 5 or i== 7 or i == 9 or i== 11 then
			tblCancel.SetCellString( i, 0, "" )
		end if
		tblCancel.SetCellString( i, 1, "" )
	next
	'tblCancel.SetCellString( 'nRowIdx, nColIdx, sValue )
	
	g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID
	g_szMacAddr = Trim(Form.GetSharedData("&MAC_ADDRESS", false ))	'MAC 주소
	g_szRegCount = 0
	g_szRegYN = "N"
	g_nBtnIndex = -1
	
	TR_Inquiry("obcsb_oimf_638r")
End Sub

'============================================================================
' btnAllCancel_OnClick - 전체 해지
'============================================================================
Sub btnAllCancel_OnClick()
	g_szProsCls = "3"
	
	'TR_Inquiry("obcsb_oimf_636a")
	if g_szRegCount == "0" then
		Form.MsgBox("알림", "삭제할 등록단말이 없습니다.", "", 0)
		exit sub
	end if
	
	g_nBtnIndex = 100
	
	'Form.OpenFramePopup("mhetc90060_p8" , "mobile_cancel" , "")
	Call CheckCert()
End Sub


'============================================================================
' btnCancelOne_OnClick
'============================================================================
Sub btnCancelOne_OnClick()
	g_szProsCls = "2"
	g_nBtnIndex = 1
	Call CheckCert()
End Sub


'============================================================================
' btnCancelTwo_OnClick
'============================================================================
Sub btnCancelTwo_OnClick()
	g_szProsCls = "2"
	g_nBtnIndex = 2
	Call CheckCert()
End Sub


'============================================================================
' btnCancelThree_OnClick
'============================================================================
Sub btnCancelThree_OnClick()
	g_szProsCls = "2"
	g_nBtnIndex = 3
	Call CheckCert()
End Sub


'============================================================================
' btnCancelFour_OnClick
'============================================================================
Sub btnCancelFour_OnClick()
	g_szProsCls = "2"
	g_nBtnIndex = 4
	Call CheckCert()
End Sub


'============================================================================
' btnCancelFive_OnClick
'============================================================================
Sub btnCancelFive_OnClick()
	g_szProsCls = "2"
	g_nBtnIndex =  5
	Call CheckCert()
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회
		g_szRegYN = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "REG_YN" , 0)	'등록여부
		g_szRegCount = DATAMANAGER.GetDataCount(0,"obcsb_oimf_638r", "OutBlock2" )
		
		for i=0 to g_szRegCount-1
			Dim szDate,szPhoneName, szStatus, szMac
			szDate = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "REG_DATE" , i))
			szPhoneName = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "TERM_NAME" , i))
			szStatus = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "STAT_CLS_CODE" , i))
			szMac = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "MAC_ADDR" , i))
			
			if szStatus == "1" then
				szStatus = "접속중"
			else
				szStatus = "등록단말"
			end if
			
			tblCancel.SetCellString( 2*i+3, 0 , szDate )
			tblCancel.SetCellString( 2*i+2, 1 , szPhoneName )
			tblCancel.SetCellString( 2*i+3, 1 , szStatus )
			tblCancel.SetCellString( 2*i+2, 3 , szMac )
				
			Select Case i
			Case 0 
				btnCancelOne.enable = true
			Case 1
				btnCancelTwo.enable = true
			Case 2
				btnCancelThree.enable = true
			Case 3
				btnCancelFour.enable = true
			Case 4
				btnCancelFive.enable = true
			End Select		
		next 
	end if
	
	if szTranID == "obcsb_oimf_636a" then
'		Dim szSucMsg
'		szSucMsg = DATAMANAGER.GetDataMsgText( "obcsb_oimf_636a" )
		
		Form.ShowAlert( "알림", "이용단말등록 약정이 해지되었습니다.")
		btnSearch_OnClick()
	end if
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증
		if sRet == "ok" then	'추가인증 성공
			szScrcOtpClsCode = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0)
			if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0) == "Y" then	'추가인증약정여부
				if szScrcOtpClsCode == "0" then	'보안카드
					Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				elseif szScrcOtpClsCode == "1" then	'부가정보
					Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				elseif szScrcOtpClsCode == "2" then	'보안매체없음
					'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
					RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
				elseif szScrcOtpClsCode == "3" then	'OTP
					Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
				elseif szScrcOtpClsCode == "4" then	'mOTP
					Form.OpenPopup( "mhetc90060_motp" , "motp_success" , sPosInfo)		'공인인증서_일반/스마트OTP
				else			'오류
					Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				end if
			else '추가인증하지 않아도 됨
				Call TR_Inquiry("obcsb_oimf_636a")
			end if			
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	If sKeyName == "mhetc90060_motp" Then
		If sRet == "ok" Then
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		Else
			exit sub
		End If
	End If
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Call TR_Inquiry("obcsb_oimf_636a")
		else						'실패
			exit sub
		end if
		
	end if
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub

