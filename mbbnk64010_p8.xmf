'============================================================================
' 화 면 명 : 외화이체 완료 팝업
'============================================================================

Dim g_szSuccessYN

Dim g_szUserNm '고객명
Dim g_szCustNo 

Dim g_szACNO	          '계좌번호
Dim g_szASNO
Dim g_szFRCR_TFAM_NWRM	'출금 후 잔액
Dim g_szSendAmt	     '보낸금액

Dim g_szBankCode			'은행코드
Dim g_szBicCode 			'BIC코드
Dim g_szBankAcno		    '은행계좌번호
Dim g_szBankName			'상대은행명
Dim g_szBankAcNm			'은행계좌명(수취인계좌명)

Dim g_szCurrencyCode 				'통화코드

Dim g_szAccountAliasYN		'계좌별명설정여부


'============================================================================
Sub Form_OnFormInitBefore()

    contSuccess.imgComplete.setMaintainingRatio("1")
    contSuccess.imgLogo.setMaintainingRatio("1")
    contSuccess.imgStar.setMaintainingRatio("1")
    contSuccess.imgShare.setMaintainingRatio("1")
    
    contFail.imgCaution.setMaintainingRatio("1")
    contFail.imgLogo2.setMaintainingRatio("1")
    
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	f_InitValue()
		
	szData = Form.GetOpenLinkData()
	if szData = "" then
		Exit Sub
	end if
	
	if szData ~= "" and szData ~= "" then
		tOpenData = Split(szData, "★")
		
		'S/F★출금계좌★출금계좌순번★출금후잔액★이체금액★통화코드★수신은행코드★BIC코드★은행계좌★은행명★수취영문명★자주쓰는계좌여부★수수료★에러메시지
		g_szSuccessYN      = tOpenData[0]
		
		g_szACNO           = tOpenData[1]
		g_szASNO           = tOpenData[2]
		
		g_szFRCR_TFAM_NWRM = tOpenData[3]		
		g_szSendAmt        = tOpenData[4]
		
		g_szCurrencyCode   = tOpenData[5]		
		g_szBankCode       = tOpenData[6]
		g_szBicCode        = tOpenData[7]
		g_szBankAcno       = tOpenData[8]
		g_szBankName       = tOpenData[9]
		g_szBankAcNm       = tOpenData[10]
		
		g_szSPCI_ACNT_YN   = tOpenData[11]
	
		g_szFee            = tOpenData[12]
		g_szResultMsg      = tOpenData[13]
	
	end if
		
'	'JPY 이외의 통화는 소수점 두자리 표현
'	if g_szCurrencyCode = "JPY" then
'		g_szDecimal = 0
'	else
		g_szDecimal = "2"
'	end if
	
	if g_szSuccessYN = "S" then
		contFail.visible = false
		
		contSuccess.visible = true		
		contSuccess.lblTransInfo1.SetMaxLineCount(1)	'컨트롤 라인 제한 함수
		if g_OSType = "2" then
			contSuccess.lblTransInfo1.SetSizeToFitTextSkip(true)
		end if
	
		'수취인명 긴 경우, 폰트 사이즈 줄임
		if Len(g_szBankAcNm) > 20 then
			contSuccess.lblTransInfo1.fontsize = 4
			contSuccess.lblTransInfo1.width = 280
			contSuccess.lblTransInfo1.caption = g_szBankAcNm
			contSuccess.lblTransInfo3.visible = true
		else	
			contSuccess.lblTransInfo1.caption = g_szBankAcNm .. " 님에게"
			nStaOffset = contSuccess.lblTransInfo1.getLen(contSuccess.lblTransInfo1.caption)
			contSuccess.lblTransInfo1.changeTextAttr(0, (nStaOffset-4), 4, 6, True)
		end if
		
		contSuccess.lblTransInfo2.caption = FormatNumber(g_szSendAmt, g_szDecimal) .. g_szCurrencyCode .." 가 이체되었어요."
		nStaOffset2 = contSuccess.lblTransInfo2.getLen(contSuccess.lblTransInfo2.caption)
		contSuccess.lblTransInfo2.changeTextAttr(0, (nStaOffset2-9), 4, 6, True)
	
		contSuccess.lblSendAcc.caption = Left(g_szACNO,4).."-"..Right(g_szACNO,4).."-"..g_szASNO	'출금계좌
		
		contSuccess.lblBalAmt.caption = g_szFRCR_TFAM_NWRM	'출금후잔액
		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		contSuccess.lblBalAmt.mask = sMask
		
		contSuccess.imgLogo.imgpath = "bank"..g_szBankCode..".png"
		contSuccess.lblName.caption = g_szBankAcNm
		
		if g_szSPCI_ACNT_YN = "Y" then	'자주쓰는계좌여부
			g_szAccountAliasYN = "Y"
			contSuccess.imgStar.imgpath = "icon_star_yellow.png"
		else
			contSuccess.imgStar.imgpath = "icon_star_gray.png"
		end if
		
		If g_szBankCode == "287" Then
		
			contSuccess.lblReceiveAcc.caption = "메리츠증권 "..Left(g_szBankAcno,4).."-"..Mid(g_szBankAcno,5,4).."-"..Right(g_szBankAcno,2)
		    
			'당사/타사 이체 결과 문구 다르게 표시함.
			contSuccess.imgStar.visible = False
			contSuccess.Table0.height = 24
			contSuccess.Table0.SetCellString(0, 0, "입출금내역에서 처리결과를 확인해주세요.")
			contSuccess.Image0.visible = false
			contSuccess.Label0.visible = false
		Else
			contSuccess.lblReceiveAcc.caption = g_szBankName.." "..g_szBankAcno
		    
			'당사/타사 이체 결과 문구 다르게 표시함.
			contSuccess.Table0.height = 48
			contSuccess.Table0.SetCellString(0, 0, "외화이체 처리중으로 입출금내역에서")
			contSuccess.Image0.visible = True
			contSuccess.Label0.visible = True
		End If
		
		contSuccess.lblSendAmt.caption = g_szSendAmt
		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		contSuccess.lblSendAmt.mask = sMask
		
		if cint(g_szFee) = 0 then
			contSuccess.lblSendFee.caption = "무료"
		else
			contSuccess.lblSendFee.caption = FormatNumber(g_szFee, 0)
		end if
		
    Else
	
        contSuccess.visible = false
		
        contFail.visible = true
		
        contFail.imgLogo2.imgpath = "bank"..g_szBankCode..".png"
        contFail.lblName2.caption = g_szBankAcNm
		
        If g_szBankCode == "287" Then
            contFail.lblReceiveAcc2.caption = "메리츠증권 "..Left(g_szBankAcno,4).."-"..Mid(g_szBankAcno,5,4).."-"..Right(g_szBankAcno,2)
        Else
            contFail.lblReceiveAcc2.caption = g_szBankName.." "..g_szBankAcno
        End If
				
        contFail.lblSendAmt2.caption = g_szSendAmt
        sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
        contFail.lblSendAmt2.mask = sMask
		
        '이체오류 사유표시
        If InStr(g_szResultMsg, "☆") <> 0 Then
	
            szResultMsg = Split(g_szResultMsg, "☆")
            szCommMsg    = szResultMsg[0]
            szCommSubMsg = szResultMsg[1]
		   
		   If Trim(szCommSubMsg) == "" Then
		       szTotalMsg = szCommMsg
		   Else
		       szTotalMsg = szCommMsg .. "\n(" .. Trim(szCommSubMsg) .. ")"
		   End If
			
        End If
		
        contFail.lblResultMsg.caption = szTotalMsg

    end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
    If sKeyName == "mbbnk64010_p9" Then
	
        If sRet <> "" And sRet <> Null Then
            g_szAlias = sRet
        Else
            g_szAlias = ""
        End If
	
        DATAMANAGER.RequestTranData("obrtp_tact_101a")
	
	End If
	
End Sub


'============================================================================
Sub f_InitValue()

	g_szSeparator = "★"
	
	g_szSPCI_ACNT_YN = "N"
	
	g_szUserNm = Form.GetSharedData("&USER_NAME" , False) '고객명
	g_szCustNo = Form.GetSharedData("&CUST_NUM"  , False) '고객번호 
	
	g_szACNO 	= ""		'계좌번호
	g_szASNO      = ""
	g_szSendAmt	= 0		'보낸 금액
	g_szFRCR_TFAM_NWRM	= 0		'출금 후 잔액
	
	g_szBankCode	= ""		'은행코드
	g_szBankAcno	= ""		'은행사용계좌번호
	g_szBankAcNm	= ""		'은행계좌명(수취인계좌명)
	g_szBankName = ""		'상대은행명
	
	g_szCurrencyCode 	= ""		'통화코드
	g_szBicCode 	= ""		'BIC코드

    
	g_szAccountAliasYN = "N"	'계좌별명설정여부
	
End Sub
		
'============================================================================
Sub contSuccess_imgStar_OnClick()
	If g_szAccountAliasYN == "Y" Then
		DATAMANAGER.RequestTranData( "obrtp_tact_101a_1" )
	Else
		Form.OpenPopupAnimation("mbbnk64010_p9", "" , "","2")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    If szTranID == "obrtp_tact_101a" Then '자주쓰는계좌 등록 처리
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1"             ) '1.등록
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CSNO"          , 0 , g_szCustNo      ) '고객번호
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BSWR_CLCD"     , 0 , "01"            ) '01.자주쓰는계좌
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "2"             ) '2.외화
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CRCD"          , 0 , g_szCurrencyCode) '통화코드
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_ACNM"     , 0 , g_szBankAcNm    ) '계좌명
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BIC_CODE"      , 0 , g_szBicCode     ) 'BIC코드
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_CODE"     , 0 , g_szBankCode    ) '은행코드
	
        If Trim(g_szBankCode) == "287" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ONCO_OTCO_CLS_CODE" , 0 , "1"                   ) '자사타사구분코드 1.당사 2.타사
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_ACNO"          , 0 , Left(g_szBankAcno, 8) ) '상대계좌번호
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_ASNO"          , 0 , Right(g_szBankAcno, 2)) '상대계좌일련번호
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ONCO_OTCO_CLS_CODE" , 0 , "2"         ) '자사타사구분코드 1당사 2타사
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "BANK_USE_ACNO"      , 0 , g_szBankAcno) '은행사용계좌번호
        End If
		
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "USER_NAME" , 0 , g_szAlias) '별명

    End If
	
	If szTranID == "obrtp_tact_101a_1" Then '자주쓰는계좌 삭제 처리
		g_Often_PROS_CLS_CODE = "5"
		szCustNum             = Form.GetSharedData("&CUST_NUM", false )
		sziQryNo              = ""
		
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE"      , 0 , g_Often_PROS_CLS_CODE )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"               , 0 , szCustNum             )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"          , 0 , "01"                  ) '업무구분코드	'01 자주 02 약정
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE"      , 0 , "2"                   ) '통화구분코드	'1:원화, 2:외화
		
		If Trim(g_szBankCode) <> "287" Then
			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE"       , 0 , "2"           )	'자사타사구분코드(1:당사,2:타사)
			'타사(원화) : 은행코드 + 은행사용계좌번호
			'타사(외화) : BIC코드 + 은행사용계좌번호
			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BIC_CODE"       , 0 , g_szBicCode           )
			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"  , 0 , g_szBankAcno          )
		Else
			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE"       , 0 , "1"           )
			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"      , 0 , Left(g_szBankAcno,8)  )
			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"      , 0 , Right(g_szBankAcno,2) )
		End If
		
    End If		
    	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID == "obrtp_tact_101a_1" Then '자주쓰는계좌 삭제 처리
		g_szAccountAliasYN = "N"
		contSuccess.imgStar.imgpath = "icon_star_gray.png"
         
		Form.Toast(0, "자주쓰는 목록에서 삭제되었습니다.", 0)
		
	ElseIf szTranID == "obrtp_tact_101a" Then '자주쓰는계좌 등록 처리
		g_szAccountAliasYN = "Y"		
		contSuccess.imgStar.imgpath = "icon_star_yellow.png"
         
		Form.Toast(0 , "자주쓰는 목록에 추가되었습니다." , 0)
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	If szTranID == "obrtp_tact_101a_1" or szTranID == "obrtp_tact_101a" Then
    
		Form.MsgBox("알림" , szErrMsg , "" , 6)
		
	End If
	
End Sub

'============================================================================
Sub contSuccess_imgShare_OnClick()
	if g_szCurrencyCode = "JPY" then
	    szText = g_szUserNm.."님이 보낸 금액을 확인해보세요.\n보낸계좌 "..g_szBankName.."\n보낸금액 "..FormatNumber(g_szSendAmt,0).." " ..g_szCurrencyCode
	else
	    szText = g_szUserNm.."님이 보낸 금액을 확인해보세요.\n보낸계좌 "..g_szBankName.."\n보낸금액 "..FormatNumber(g_szSendAmt,2).." " ..g_szCurrencyCode
	end if
    Form.shareSNS(szText)
End Sub

'============================================================================
Sub contFail_btnOK_OnClick()
	g_szOpenPage = "64010"
	Form.CloseForm()
End Sub

'============================================================================
Sub contSuccess_btnList_OnClick()
	g_szOpenPage = "63030"
	Form.CloseForm()
End Sub

'============================================================================
Sub contSuccess_btnConfirm_OnClick()
	g_szOpenPage = "64010"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbbnk64010_p8" , g_szOpenPage)
End Sub

