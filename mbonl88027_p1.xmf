'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)
	if iIdx == 0 then
		szURL = f_sGetURL(1)
		szTitle = f_sGetURLTitle(1)
		
		'팝업 호출
		if szURL <> "" then
			Form.OpenPopup("mbonl87056_p6" , "mbonl87056_p1_All"&"♥"&szURL&"♥"&szTitle, "")			
			Form.OpenPopup("mbonl88024_p7" , szURL&"♥"&szTitle, "")
		end if		
	else
		Form.SetSharedData("OPEN_URL", f_sGetURL(iIdx) )
		Form.OpenFramePopup("mbonl82020_p6" , f_sGetURLTitle(iIdx), "")	
	end if
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()

	g_ChkAll = "0"	
	imgUIAllChk.imgpath = g_szUnCheckImg
	lblAllText.fgcolor  = g_szUnCheckFg			
	

	if g_Chk1 <> "1" then
		BtnContinue.enable = false
'		if g_Chk2 <> "1" then
'			imgUIAllChk.imgpath = g_szUnCheckImg
'			lblAllText.fgcolor  = g_szUnCheckFg	
'		end if
		
		Exit Function	
	end if
	
	g_ChkAll = "1"	
	imgUIAllChk.imgpath = g_szCheckImg
	lblAllText.fgcolor  = g_szCheckFg			
	
	'신청가능
	BtnContinue.enable = true
	
	'BtnContinue.imgpath = "btn_01.9"
	
End Function

'============================================================================
'각 체크 별 기능 동작
'============================================================================
Function f_SetChkState(iIdx, bValue)

	'전체동의
	if iIdx == 0 then
	
		if bValue == true then	
		
			g_ChkAll = "1"	
			imgUIAllChk.imgpath = g_szCheckImg
			lblAllText.fgcolor  = g_szCheckFg			
		
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg		
		else
			g_ChkAll = "0"	
			imgUIAllChk.imgpath = g_szUnCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg			
			
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
		end if	
	
	'약관동의
	elseif iIdx == 1 then
	
		if bValue == true then	
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
		else
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
		end if		
	end if
	
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()	
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	g_szUnCheckImg 	= "icon_chk_on.png"
	g_szCheckImg 		= "icon_chk_off.png"
	g_szUnCheckFg 	= "127"
	g_szCheckFg 		= "4"	
End Sub


'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동Y
	'부모창(mbonl88024) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

     '이미지설정
	'imgBg.imgpath       = "alpha128"
	'imgExit.imgpath     = "icon_close"
	'If g_szTheme = "black" Then
	'	BtnCancel.imgpath   = "btn_27.9"   
	'Else
	'	BtnCancel.imgpath   = "btn_27.9"  'white모드도 동일 
	'End If
	'BtnContinue.imgpath = "btn_09.9"

	'초기화..	
	f_SetChkState(0, false)	
	
	g_sRetData = "cancel"
	
	'신청가능
	BtnContinue.enable = false	
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		g_szUrl = tData[0]
		g_szUrlName = tData[1]
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl82020_p6" then
		If sRet == g_szUrlName Then
'		If sRet == "CDS 설명서" Then
			f_SetChkState(1, true)
		End If		
		
	elseif sKeyName == "mbonl88024_p7" then	'전체동의
		'전체동의 팝업
		'if sRet == "mbonl87056_p1_All" then		
		if sRet == "AGREE" then		
			f_SetChkState(0, true)
		elseif sRet == "cancel" then	
			f_SetChkState(0, false)
		end if			
	end if
End Sub

'============================================================================
Sub BtnContinue_OnClick()
	if g_Chk1 = "1" Then
		g_sRetData = "ok"			
	else
		g_sRetData = "cancle"		
	end if 
	
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl88027_p1" , g_sRetData )	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 약관 띄움
'============================================================================
Sub imgChk0_OnClick()	
	if CInt(g_Chk1) == 1 then
		f_SetChkState(1, false)
	else
		f_OpenChkPopup(1)
	end if		
End Sub

'============================================================================
' 필수약관에 모두 동의 클릭
'============================================================================
Sub btnAllChk_OnClick()
	if CInt(g_ChkAll) == 1 then
		f_SetChkState(0, false)		
	else
		f_OpenChkPopup(0)
	end if		
End Sub

'============================================================================
Sub imgAlpha_OnClick()
	Form.CloseForm()
End Sub

