	<SCRIPT_INFO _len="8807" _ulen="8257" >

Dim g_sRetData 					'리턴데이터
Dim g_szTheme                  		'테마구분  white/black
dim g_szUnCheckImg, g_szCheckImg	'체크이미지
dim g_szUnCheckFg, g_szCheckFg		'체크 폰트 컬러
Dim g_ChkAll						'전체동의여부
Dim g_Chk1						'첫번째 약관
Dim g_Chk2						'두번째 약관

Dim g_szUrl
Dim g_szUrlName

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	szTitle = g_szUrlName
	
	return szTitle
End Function

'============================================================================
'f_sGetURL(iIdx) : 각 동의체크 별 안내팝업 URL 리턴
