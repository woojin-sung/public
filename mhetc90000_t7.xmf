'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환경설정
' 02. 화면설명 : 환경설정_개인_메모관리(일반메모)
' 03. 작    성 : 2016.02.16 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sType '처리구분값
Dim G_DETAIL_FILE '메모상세보기팝업
Dim G_MEMOADD_FILE '메모추가팝업

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	G_DETAIL_FILE = "mhetc90000_p5"
	G_MEMOADD_FILE = "mhetc90000_p6"
	g_sType = "2"
	
	DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '메모조회	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_DETAIL_FILE or sKeyName == G_MEMOADD_FILE then
		g_sType = "2"
	
		DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '메모조회 ' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "allclear" then
		if sRet == "ok" then
			g_sType = "9"
			
			DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '전체삭제	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
		end if
	elseif sKeyName == "clear" then
		if sRet == "ok" then
			g_sType = "5"

			DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '선택삭제	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	if szTranID == "ohhts_memo_013r" then
		Dim sUserID 
		sUserID = Form.GetSharedData("&USER_ID", false )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" , 0 , sUserID )
		'일반1,종목2
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" , 0 , "1" ) 
		'입력검색1,전체검색2,추가3,수정4,선택삭제5,전체삭제9
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" , 0 , g_sType )
		'제목1,내용2,내용+제목3
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" , 0 , "1" )
		
		if g_sType == "5" then '선택삭제인경우
			Dim nRow, sClsCode
			nRow = CInt(Grid0.selectrow)
			sClsCode = Grid0.GetCellData( "bd_clscode", nRow )

			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_CLS_CODE" , 0 , sClsCode )
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_CLS_CODE" , 0 , "" )
		end if
		
		Grid0.rowcount = "0"
	end if
	' 20210622 HWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if g_sType == "5" then '선택삭제인경우
		g_sType = "2"
	
		DATAMANAGER.RequestTranData( "ohhts_memo_013r" ) '메모조회	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	end if
End Sub

'============================================================================
' 상세보기
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sDate, title, text, clscode
	sDate = Grid0.GetCellData( "bd_date", lRow )
	title = Grid0.GetCellData( "bd_title", lRow )
	text = Grid0.GetCellData( "bd_text", lRow )
	clscode = Grid0.GetCellData( "bd_clscode", lRow )
	
	Form.SetSharedData("mhetc90000_t7_date" , sDate)
	Form.SetSharedData("mhetc90000_t7_title" , title)
	Form.SetSharedData("mhetc90000_t7_text" , text)
	Form.SetSharedData("mhetc90000_t7_clscode" , clscode)
	
	Form.OpenPopup(G_DETAIL_FILE , "1" , "")
End Sub

'============================================================================
' 전체삭제
'============================================================================
Sub ButtonAll_OnClick()
	if Grid0.rowcount == "0" or Grid0.rowcount == 0 then
		Form.MsgBox( "알림", "삭제할 메모가 없습니다.", "", 6 )
		Exit Sub
	end if
	
	Form.MsgBox( "알림", "일반메모 전체 내용을 삭제 하시겠습니까?", "allclear", 1 )
End Sub

'============================================================================
' 선택삭제
'============================================================================
Sub ButtonDel_OnClick()
	if Grid0.rowcount == "0" or Grid0.rowcount == 0 then
		Form.MsgBox( "알림", "삭제할 메모가 없습니다.", "", 6 )
		Exit Sub
	end if
	
	Dim nRow, sClsCode
	nRow = Grid0.selectrow
	
	if nRow == "-1" or nRow == -1 then	
		Form.MsgBox( "알림", "삭제할 메모를 선택하여 주십시오.", "", 6 )
		Exit Sub
	end if

	Form.MsgBox( "알림", "선택된 일반메모를 삭제 하시겠습니까?", "clear", 1 )
End Sub

'============================================================================
' 메모추가
'============================================================================
Sub ButtonAdd_OnClick()
	Form.OpenPopup(G_MEMOADD_FILE , "1" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("mhetc90000_t7_date" , "")
	Form.SetSharedData("mhetc90000_t7_title" , "")
	Form.SetSharedData("mhetc90000_t7_text" , "")
	Form.SetSharedData("mhetc90000_t7_clscode" , "")
End Sub



