--===========================================================================

Dim g_szItemCode

'============================================================================
Sub Form_OnFormInit()
'	Form.SetCtlProp("btnBuy", "fgcolor"	, "62")
'	Form.SetCtlProp("btnSell", "fgcolor"	, "62")
	
	listInfo = Split ( Form.GetOpenLinkData() , "★" , 0 , 0 )
	
	if ( #listInfo == 1 ) then
		exit sub
	end if
	
	szCode		= listInfo[0]			'코드
	nYPos	 	= Int(listInfo[1])
	nHeight	 	= Int(listInfo[2])
	
	'ShowAlert( nYPos , nHeight )
	
	g_szItemCode = szCode
	
	nScreenHeight = 650 ' 임시로 잡음
	
	sConImageName = "Container0.Image0" 
	nConHeight = Int(Form.GetCtlProp("Container0", "height"))
	
	nImageTop = Int(Form.GetCtlProp(sConImageName, "top"))
	nImageHeight = Int(Form.GetCtlProp(sConImageName, "height"))
	
	if nConHeight + nYPos + nHeight > nScreenHeight then ' 위로 떠야 하는 경우
		szTop = "164"
		
		'- 7 패딩 값, 삭제 금지
		Form.SetCtlProp("Container0", "top" , nYPos - nConHeight + 7 )
'				Form.SetCtlProp(sConImageName , "top", nImageTop - IMAGE_ARROW_HEIGT)
		Form.SetCtlProp(sConImageName , "imgpath", "btn_link_bg2.9")
		Form.SetCtlProp("Container0.tblData", "top" , 4)
		
	else ' 아래로 떠야 하는 경우
		szTop = "170"
		
		Form.SetCtlProp("Container0", "top" , nYPos + nHeight - 14 )
'				Form.SetCtlProp(sConImageName , "height", nImageHeight - IMAGE_ARROW_HEIGT)
		Form.SetCtlProp(sConImageName , "imgpath", "btn_link_bg.9")
		Form.SetCtlProp("Container0.tblData", "top" , 10)

	end if
	'ShowAlert ( nYPos , nHeight )  
	
	For i = 0 to 4
		szButton = "Container0" & "." & "Button" & i
		
		' KMC 160307
		Form.SetCtlProp(szButton, "top"		, szTop)
		Form.SetCtlProp(szButton, "caption"	, listInfo[i+3])
		szSize	=	0
		
		if i > 0 then
			szSize	=	len(listInfo[i+3])
			if	szSize	>= 18		then
				Form.SetCtlProp(szButton, "fontsize", "-3")
			end	if
		end	if

		Select Case Trim(listInfo[i+3])
			Case "매수"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc10.9")
						Form.SetCtlProp(szButton, "fgcolor"	, "62")
			Case "매도"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc11.9")
						Form.SetCtlProp(szButton, "fgcolor"	, "62")
			Case "정정"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc17.9")
						Form.SetCtlProp(szButton, "fgcolor"	, "62")
			Case "취소"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc18.9")
						Form.SetCtlProp(szButton, "fgcolor"	, "62")
			Case	"추가매수"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc10.9")
							Form.SetCtlProp(szButton, "fgcolor"	, "62")
			Case	"신규가입"	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc10.9")
							Form.SetCtlProp(szButton, "fgcolor"	, "62")
			Case Else	Form.SetCtlProp(szButton, "btnimage"	, "btn_etc16.9")
						Form.SetCtlProp(szButton, "fgcolor"	, "4")
		End Select
	Next
	
	DATAMANAGER.RequestTranData("obtrd_comm_500r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	f_Clear()
	
	if szTranID = "obtrd_comm_500r" then
		DATAMANAGER.SetDataValue( false, "obtrd_comm_500r", "InBlock1", "FISCD" , 0 , g_szItemCode)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_comm_500r" then
		Dim szTICK_UNIT, szTICK_WRTH_FAMT, szFMARG, szMNTN_FMARG
		
		szTICK_UNIT = DATAMANAGER.GetDataValue( false, "obtrd_comm_500r", "OutBlock1", "TICK_UNIT" , 0 )
		szTICK_WRTH_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_comm_500r", "OutBlock1", "TICK_WRTH_FAMT" , 0 )
		szFMARG = DATAMANAGER.GetDataValue( false, "obtrd_comm_500r", "OutBlock1", "FMARG" , 0 )
		szMNTN_FMARG = DATAMANAGER.GetDataValue( false, "obtrd_comm_500r", "OutBlock1", "MNTN_FMARG" , 0 )
		
		if szTICK_UNIT <> "" or szTICK_UNIT <> null then
			Container0.tblData.SetCellString(2, 1, f_SetTickSize(szTICK_UNIT))
		end if
		
		if szTICK_WRTH_FAMT <> "" or szTICK_WRTH_FAMT <> null then
			Container0.tblData.SetCellString(2, 3, f_SetTickSize(szTICK_WRTH_FAMT))
		end if
		
		if szFMARG <> "" or szFMARG <> null then
			Container0.tblData.SetCellString(3, 1, f_SetTickSize(szFMARG))
		end if
		
		if szMNTN_FMARG <> "" or szMNTN_FMARG<> null then
			Container0.tblData.SetCellString(3, 3, f_SetTickSize(szMNTN_FMARG))
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	 szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
  
	 if Trim(szSubMsg) <> "" then
		 Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	 else
		 Form.ShowAlert("알림", szErrMsg)
	 end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szItemCode = sParam
	
	DATAMANAGER.RequestTranData("obtrd_comm_500r")
End Sub 

'============================================================================
Function f_Clear()
	Container0.tblData.SetCellString(0, 1, "")
	Container0.tblData.SetCellString(0, 3, "")
	Container0.tblData.SetCellString(1, 1, "")
	Container0.tblData.SetCellString(1, 3, "")
	Container0.tblData.SetCellString(2, 1, "")
	Container0.tblData.SetCellString(2, 3, "")
	Container0.tblData.SetCellString(3, 1, "")
	Container0.tblData.SetCellString(3, 3, "")
	Container0.tblData.SetCellString(4, 1, "")
	Container0.tblData.SetCellString(4, 3, "")
End Function 

'============================================================================
Function f_SetTickSize(szData)
	Dim szTickSize, tData
	szTickSize = szData
	
	if szData <> nil and szData <> "" then
		tData = Split(szData, ".")
		szTickSize = tData(0)
		
		if UBound(tData) > 0 then
			if tData(1) <> "" then
				szTickSize = szTickSize & "." & tData(1)
			end if
			
			while right(szTickSize,1) = "0"
				szTickSize = left(szTickSize,Len(szTickSize)-1)
			wend
		end if
	end if
	
	return szTickSize
End Function


'============================================================================


'============================================================================
Sub Container0_Button0_OnClick()
	Form.OpenScreen("43100" , g_szItemCode)
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Button1_OnClick()
	Form.OpenScreen("43300" , g_szItemCode)
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Button2_OnClick()
	Form.OpenScreen("44300", "주요종목" & "★" & "0" & "★" & g_szItemCode)
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Button3_OnClick()
	Form.OpenScreen("44300", "주요종목" & "★" & "1" & "★" & g_szItemCode)
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Button4_OnClick()
	Form.OpenPopup( "mhtrd43110_p4" , g_szItemCode, "" )
	Form.CloseForm()
End Sub

'============================================================================
Sub Label1_OnClick()
	Form.CloseForm()
End Sub

