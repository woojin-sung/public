Sub Form_OnFormInit()
	
	g_bOrderType = "1"
	
	tbl0.visible = true
	tbl1.visible = false
	btnUp.visible = false
	btnDown.visible = true
	
'	grd0.top = 200
'	grd0.height = 311

	btnSearch_OnClick()
	'V001
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
End Sub

