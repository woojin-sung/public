'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	If szCellID = "bd_Check" Then
		If grd0.GetCellData("bd_Check", lRow) = "0" Then
			'grd0.SetCellData("bd_OderType"	, lRow, "")
			
			
			''//TEST
			''szISCD			= grd0.GetCellData( "bd_cell3", lRow)
			''nODER_QTY		= grd0.GetCellData( "bd_Qty"  , lRow )
			''nODER_PRC		= grd0.GetCellData( "bd_Price", lRow )			
			''nASPR_TYPE_CODE	= grd0.GetCellData( "bd_OderType", lRow)
			''msgbox "[" & szISCD & "][" & nODER_QTY & "][" & nODER_PRC  & "][" & nASPR_TYPE_CODE & "]"
			
			''//V002
			grd0.SetCellData("bd_Qty"		, lRow, "수량입력")
			grd0.SetCellData("bd_Price"		, lRow, "가격입력")
			
			g_nSelectCnt = g_nSelectCnt -1
			
			if g_nSelectCnt < 0 then
				g_nSelectCnt = 0
			end if
			
			
			
		else
			szCode = grd0.GetCellData("bd_cell3", lRow)
			
			If Left( Trim(szCode), 1 ) = "K" Then
				szItemCode	= Right( Trim(szCode), Len(Trim(szCode)) - 1)
			Else
				szItemCode	= szCode
			End If
			
			szMk = Form.GetItemCodeInfo(szItemCode, "market")
			
			g_nSelectCnt = g_nSelectCnt +1
			
			''//모든상품거래 가능 
			' 지수선물/미니선물/옵션/미니옵션만 가능
'			If Trim(szMk) = "F"  or Trim(szMk) = "O" or 
'			   Trim(szMk) = "MF" or Trim(szMk) = "MO" or
'			   Trim(szMk) = "JF"  or Trim(szMk) = "JO" or
'			   Trim(szItemMarket) = "XF" or Trim(szItemMarket) = "QO" then '2018.04.06 KRX300선물, KSQ150옵션 추가 XF(KRX300) QO(KSQ150) 
			   
				g_nSelectRow = lRow
'			Else
'				grd0.SetCellData("bd_Check", lRow, "0")
'				Form.ShowAlert(g_szTitle, "선택상품은 MTS에서 거래되지 않는 상품입니다.")
'				Exit Sub
'			End If
		
		End If
		
	ElseIf szCellID = "bd_OderType" Or szCellID = "bd_Qty" Or szCellID = "bd_Price" Then
		Dim szData	
		Dim szUnit, szPrc, szChk,szCode,szMk,szItemCode
		If grd0.GetCellData("bd_Check", lRow) = "1" Then
			
			g_nSelectRow = lRow
			
			If szCellID = "bd_OderType" Then		'주문유형
				szData = "주문유형★" & grd0.GetCellData("szCellID", lRow)
				Form.OpenPopup("mbtrf31060_p1", szData, "")
				
			ElseIf szCellID = "bd_Qty" And g_bOrderType = "1" Then			'수량
				'szData = "수량★" & grd0.GetCellData("szCellID", lRow)
				'Form.OpenPopup("mbtrf31060_p1", szData, "")
				
				szData =  grd0.GetCellData("bd_Qty", lRow)
				
				''//V002
				If szData = "수량입력" then
					szData = 0
				End If
				
				Form.OpenPopup("mbtrf31030_p1", szData ,"")
			
			ElseIf szCellID = "bd_Price" And g_bOrderType = "1"  Then		'가격
				'szData = "가격★" & grd0.GetCellData("szCellID", lRow)
				'Form.OpenPopup("mbtrf31060_p1", szData, "")
				szCode = grd0.GetCellData("bd_cell3", lRow)
				
				If Left( Trim(szCode), 1 ) = "K" Then
					g_szItemCode	= Right( Trim(szCode), Len(Trim(szCode)) - 1)
				Else
					g_szItemCode	= szCode
				End If
				
				szMk = Form.GetItemCodeInfo(g_szItemCode, "market")
				
				szPrc = CDbl( grd0.GetCellData("bd_Price", lRow) )
				
				g_szData = szPrc & "★" & g_szItemCode & "★" & szMk & "★" & "20"
				
				DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
				
'				Form.OpenPopup("mbtrf31030_p2" , szPrc & "★" & szItemCode & "★" & szMk & "★" & "20", "")
			End If			
		End If		
	End If
	
	if g_nSelectCnt > 0 then
		btnOrder.enable = true
	else
		btnOrder.enable = false
	end if
End Sub

'============================================================================
Sub btnCNTG_OnClick()
	Dim nRowCnt
	
	g_szTR_GUB = "0"
	
	If Check_Account(nGbn) = false Then
		Exit Sub
	End If
	
	nRowCnt = 0
	
	DATAMANAGER.ClearInputData( 0, "obtrf_oder_106r" )
	
	tbl0.SetCellString( 2, 2, "")
	tbl0.SetCellString( 3, 2, "")
	
	tbl1.SetCellString( 6, 2, "")
	tbl1.SetCellString( 7, 2, "")
	tbl1.SetCellString( 8, 2, "")
	tbl1.SetCellString( 9, 2, "")
	
	For i = 0 To grd0.rowcount - 1
		If grd0.GetCellData( "bd_Check", i ) = "1" Then
			Dim szISCD, szDEAL_CLS_CODE, nODER_QTY, nODER_PRC, nASPR_TYPE_CODE
			Dim szASPR_TYPE_CODE
			
			szISCD			= grd0.GetCellData( "bd_cell3", i )
			nODER_QTY		= grd0.GetCellData( "bd_Qty"  , i )
			nODER_PRC		= grd0.GetCellData( "bd_Price", i )			
			nASPR_TYPE_CODE	= grd0.GetCellData( "bd_OderType", i )
			
			If grd0.GetCellData( "bd_FtopType", i ) = "1" Then
				szDEAL_CLS_CODE = "2"
			Else
				szDEAL_CLS_CODE = "1"
			End If
			
			Select Case nASPR_TYPE_CODE
				Case "시장가"				szASPR_TYPE_CODE = "1"
				Case "지정가"				szASPR_TYPE_CODE = "2"
				Case "조건부지정가"		szASPR_TYPE_CODE = "I"
				Case "최유리 지정가"		szASPR_TYPE_CODE = "X"
			End Select
			
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "ISCD" 			, nRowCnt , szISCD 			)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "DEAL_CLS_CODE" 	, nRowCnt , szDEAL_CLS_CODE 	)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "ODQT"			, nRowCnt , nODER_QTY 			)
'			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "FTOP_ODER_UNPR"  , nRowCnt , nODER_PRC 			)
'			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "ASPR_TYPE_CODE"  , nRowCnt , szASPR_TYPE_CODE	)
			
			nRowCnt = nRowCnt + 1		
		End If
	Next
	
	If nRowCnt > 0 Then
		DATAMANAGER.RequestTranData( "obtrf_oder_106r" )
	Else
		Form.ShowAlert(g_szTitle, "처리할 내역이 없습니다.")
	End If

End Sub

'============================================================================
Sub btnOrder_OnClick()
	g_szTR_GUB = "1"
	
	If Check_Account(nGbn) = false Then
		Exit Sub
	End If
	
	nRowCnt = 0
	
	DATAMANAGER.ClearInputData( 0, "obtrf_oder_106r" )
	
	For i = 0 To grd0.rowcount - 1
		If grd0.GetCellData( "bd_Check", i ) = "1" Then
			
			Dim szISCD, szDEAL_CLS_CODE, nODER_QTY, nODER_PRC, nASPR_TYPE_CODE
			Dim szASPR_TYPE_CODE
		
			szISCD			= grd0.GetCellData( "bd_cell3", i )
			nODER_QTY		= grd0.GetCellData( "bd_Qty"  , i )
			nODER_PRC		= grd0.GetCellData( "bd_Price", i )			
			nASPR_TYPE_CODE	= grd0.GetCellData( "bd_OderType", i )			
			
			If nASPR_TYPE_CODE = "" Then
				Form.ShowAlert(g_szTitle, "주문유형코드 입력 후 처리하세요!")
				Exit Sub
			End If


			''//V002
			If nODER_QTY = "" or nODER_QTY = "수량입력" Then
				Form.ShowAlert(g_szTitle, "주문수량을 확인하세요.")
				Exit Sub
			End If
		
			If nASPR_TYPE_CODE = "지정가" Or nASPR_TYPE_CODE = "조건부지정가" Then
				If nODER_PRC = "" Or CDbl(nODER_PRC) = 0  Or nODER_PRC = "가격입력" Then
					Form.ShowAlert(g_szTitle, "지정가/조건부지정가 - 가격입력 필수입니다.")
					Exit Sub
				End If
			End If
			


			If grd0.GetCellData( "bd_FtopType", i ) = "1" Then
				szDEAL_CLS_CODE = "2"
			Else
				szDEAL_CLS_CODE = "1"
			End If
			
			Select Case nASPR_TYPE_CODE
				Case "시장가"				szASPR_TYPE_CODE = "1"
				Case "지정가"				szASPR_TYPE_CODE = "2"
				Case "조건부지정가"		szASPR_TYPE_CODE = "I"
				Case "최유리 지정가"		szASPR_TYPE_CODE = "X"
			End Select
			
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "ISCD" 			, nRowCnt , szISCD 			)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "DEAL_CLS_CODE" 	, nRowCnt , szDEAL_CLS_CODE 	)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "ODQT"			, nRowCnt , nODER_QTY 			)
'			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "FTOP_ODER_UNPR"  , nRowCnt , nODER_PRC 			)
'			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock2", "ASPR_TYPE_CODE"  , nRowCnt , szASPR_TYPE_CODE	)
			
			nRowCnt = nRowCnt + 1		
		End If
	Next	
	
	If nRowCnt > 0 Then
		''//V002
		''Form.MsgBox(g_szTitle, "추가증거금계좌 일괄주문은  \n 취소할 수 없습니다. \n\n 주문처리 하시겠습니까?", "ORDER", "2")
		DATAMANAGER.RequestTranData( "obtrf_oder_106r" )
	Else
		Form.ShowAlert(g_szTitle, "처리할 내역이 없습니다.")
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "RESEARCH" Then
		If sRet = "ok" Then
			Init()
			DATAMANAGER.RequestTranData( "obtrf_oder_107r" )
		End If
		
	ElseIf sKeyName = "ORDER" Then
		If sRet = "ok" Then
			''//V002			
			''DATAMANAGER.RequestTranData( "obtrf_oder_106r" )
			DATAMANAGER.RequestTranData( "obtrf_oder_105c" )
		Else
			Form.ShowAlert(g_szTitle, "주문취소하셨습니다.")
		End If	
	
	End If
	
End Sub


