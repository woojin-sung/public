							</CELL>
							<CELL name="bd_cell22" cell_ly="0,4,0,4" line="0,1" import="2,1,-1" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
			</COLINFO>
			<UPDATETR_INFO/>
			<UPDATEBC_INFO keycellid="bd_Check" rangecellid="bd_Check" hlcolorcellid="bd_Check" />
		</GRID>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="23628" _ulen="22254" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 추가증거금 청산주문
' 02. 화면설명 : 추가증거금 청산주문(테스트계좌 3007-8165-03)
' 03. 작    성 : 2016.04.30 LJS
'                 : 2020.09.10 V001. 윤현수 MTS메모리보안적용
'		  : 2022.11.15 V002. 심효석 화면개선
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_nSelectRow
Dim 	g_szTR_GUB   	' 주문처리 or 가상증거금조회처리
Dim 	g_bOrderType	'주문유형(1:지정가, 조건부지정가 0 : 시장가, 최유리)
Dim	g_szItemCode, g_szData
Dim	g_szTitle
g_szTitle = "알림"

Dim 	g_nSelectCnt
g_nSelectCnt = 0

'V001
Dim plain_rm 'MTS메모리평문 적용유무
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'======================================
' Check_Account
'======================================
Function Check_Account(nGbn)
	
	'20231123 HSZ START: 계좌없는 경우 오류메시지 SKIP처리
	if Trim( acnt.caption) ==  "" then
		return False
	end if
	'20231123 HSZ END	
	
    If Len( acnt.caption) < 10 Then
	    Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
	    return False
	End If
	
	if nGbn <> 2 then
		If Trim( edtPwd.caption ) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function


'======================================
' Init
'======================================
Function Init()
	
	For i =0 To tbl0.rowcount -1
		tbl0.SetCellString( i, 2, "")
	Next
	
	For i =0 To tbl1.rowcount -1
		tbl1.SetCellString( i, 2, "")
	Next
	
	grd0.rowcount = 0
	
End Function

'======================================
' SetGridRowStateByOrderType
'======================================
Function SetGridRowStateByOrderType()
	Dim szType
	szType = grd0.GetCellData("bd_OrderType", g_nSelectRow)
	
	If szType = "지정가" Or "조건부지정가" Then
		g_bOrderType = "1"
		
	Else
		g_bOrderType = "0"
		grd0.SetCellData( "bd_Qty"	 , g_nSelectRow, "")
		grd0.SetCellData( "bd_Price", g_nSelectRow, "")
		
	End If
	
End Function


'======================================
' Send_Order
'======================================
Function Send_Order()
	Dim nRowCnt, nCnt
	nCnt = grd0.rowcount
	
	If CInt( nCnt ) <= 0 Then
		Form.ShowAlert(g_szTitle, "처리대상건이 없습니다.")
	End If
	
	nRowCnt = 0
	DATAMANAGER.ClearInputData( 0, "obtrf_oder_105c" )
	
	For i = 0 To grd0.rowcount - 1
		If grd0.GetCellData( "bd_Check", i ) = "1" Then
			Dim szISCD, szDEAL_CLS_CODE, nODER_QTY, nODER_PRC, nASPR_TYPE_CODE, nABLE_QTY
			Dim szASPR_TYPE_CODE, szFTOP_TYPE_CODE
			
			szISCD			= grd0.GetCellData( "bd_cell3"   , i )
			nODER_QTY		= grd0.GetCellData( "bd_Qty"     , i )
			nODER_PRC		= grd0.GetCellData( "bd_Price"   , i )
			nABLE_QTY		= grd0.GetCellData( "bd_AbleQty" , i )
			nASPR_TYPE_CODE	= grd0.GetCellData( "bd_OderType", i )
			szFTOP_TYPE_CODE	= grd0.GetCellData( "bd_cell10"	 , i )
			
			If nODER_QTY = "수량입력" then
				nODER_QTY = 0
			ElseIf nODER_PRC = "가격입력"  then
				nODER_PRC = ""
			End If
			
			
			If nODER_QTY = "" or nODER_QTY = 0 Then
				Form.ShowAlert(g_szTitle, "주문수량을 확인하세요.")
				Exit Function
			End If
			
			
			If CDbl(nODER_QTY) > CDbl(nABLE_QTY) Then
				Form.ShowAlert(g_szTitle, "주문수량이 주문가능수량을 초과합니다.")
				Exit Function
			End If
			
			If nASPR_TYPE_CODE = "지정가" Or nASPR_TYPE_CODE = "조건부지정가" Then
				If nODER_PRC = "" Or CDbl(nODER_PRC) = 0  Or nODER_PRC = "가격입력" Then
					Form.ShowAlert(g_szTitle, "지정가/조건부지정가 - 가격입력 필수입니다.")
					Exit Function
				End If
			End If
			
			
			If grd0.GetCellData( "bd_FtopType", i ) = "1" Then
				szDEAL_CLS_CODE = "2"
			Else
				szDEAL_CLS_CODE = "1"
			End If
			
			Select Case nASPR_TYPE_CODE
				Case "시장가"				szASPR_TYPE_CODE = "1"
				Case "지정가"				szASPR_TYPE_CODE = "2"
				Case "조건부지정가"		szASPR_TYPE_CODE = "I"
				Case "최유리 지정가"		szASPR_TYPE_CODE = "X"
			End Select
			
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock2", "ISCD" 			, nRowCnt , szISCD 			)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock2", "ODQT"			, nRowCnt , nODER_QTY 			)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock2", "DEAL_CLS_CODE" 	, nRowCnt , szDEAL_CLS_CODE 	)			
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock2", "FTOP_TYPE_CODE" 	, nRowCnt , szFTOP_TYPE_CODE	)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock2", "ASPR_TYPE_CODE"  , nRowCnt , szASPR_TYPE_CODE	)
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock2", "FTOP_ODER_UNPR"  , nRowCnt , nODER_PRC 			)
			
			nRowCnt = nRowCnt + 1		
		End If
	Next
	
	If nRowCnt > 0 Then
		''//V002
		''DATAMANAGER.RequestTranData( "obtrf_oder_105c" )
		Form.MsgBox(g_szTitle, "청산주문을 실행하시겠습니까?", "ORDER", "2")
	Else
		Form.ShowAlert(g_szTitle, "처리할 내역이 없습니다.")
	End If
	
End Function

