'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)


	If sKeyName = "주문유형" Then
		grd0.SetCellData( "bd_OderType"	, g_nSelectRow, sRet)
		SetGridRowStateByOrderType()
	
	ElseIf sKeyName = "수량" Then
		grd0.SetCellData( "bd_Qty"		, g_nSelectRow, sRet)
	
	ElseIf sKeyName = "가격" Then
		grd0.SetCellData( "bd_Price"	, g_nSelectRow, sRet)
	
	elseif sKeyName == "QTY_POPUP" then		
		grd0.SetCellData( "bd_Qty"		, g_nSelectRow, sRet)
	
	elseif sKeyName == "PRC_POPUP" then		
		grd0.SetCellData( "bd_Price"	, g_nSelectRow, sRet)
	
	End If	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	
	If szTranID = "obtrf_oder_105c" Then
		Dim nTOTAL_ENTM_MARG, nCASH_ENTM_MARG ,nCNTG_HH_TOTAL_ENTM_MARG ,nCNTG_HH_CASH_ENTM_MARG 
		nTOTAL_ENTM_MARG			= tbl1.GetCellString( 2, 2 )	'위탁증거금 총액
		nCASH_ENTM_MARG			= tbl1.GetCellString( 3, 2 )	'현금증거금 총액
		nCNTG_HH_TOTAL_ENTM_MARG	= tbl1.GetCellString( 6, 2 )	'체결시 위탁증거금 총액
		nCNTG_HH_CASH_ENTM_MARG 	= tbl1.GetCellString( 7, 2 )	'체결시 현금증거금 총액
	
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "ACNO" 					, 0 , acnt.total 				)
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "ASNO" 					, 0 , acnt.sequence 			)
		'V001
		'DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "PWD" 					, 0 , edtPwd.encdata 			)		
		'MTS 메모리평문 적용상태일때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "PWD" 					, 0 , edtPwd.caption 			)
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "PWD" 					, 0 , edtPwd.encdata 			)
		end if
		
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "TOTAL_ENTM_MARG" 		, 0 ,  nTOTAL_ENTM_MARG		)
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "CASH_ENTM_MARG" 			, 0 ,  nCASH_ENTM_MARG			)
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "CNTG_HH_TOTAL_ENTM_MARG" 	, 0 ,  nCNTG_HH_TOTAL_ENTM_MARG	)
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_105c", "InBlock1", "CNTG_HH_CASH_ENTM_MARG" 	, 0 ,  nCNTG_HH_CASH_ENTM_MARG	)
	
	ElseIf szTranID = "obtrf_oder_106r" Then
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock1", "ACNO" 					, 0 , acnt.total 				)
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock1", "ASNO" 					, 0 , acnt.sequence 			)
		'V001
		'DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock1", "PWD" 					, 0 , edtPwd.encdata 			)
		'MTS 메모리평문 적용상태일때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock1", "PWD" 					, 0 , edtPwd.caption 			)
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_106r", "InBlock1", "PWD" 					, 0 , edtPwd.encdata 			)
		end if
	
	ElseIf szTranID = "obtrf_oder_107r" Then
		DATAMANAGER.ClearInputData( 0, "obtrf_oder_107r" )

		DATAMANAGER.SetDataValue( 0, "obtrf_oder_107r", "InBlock1", "ACNO" 					, 0 , acnt.total 				)
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_107r", "InBlock1", "ASNO" 					, 0 , acnt.sequence 			)
		'V001
		'DATAMANAGER.SetDataValue( 0, "obtrf_oder_107r", "InBlock1", "PWD" 					, 0 , edtPwd.encdata 			)
		'MTS 메모리평문 적용상태일때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_107r", "InBlock1", "PWD" 					, 0 , edtPwd.caption 			)
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue( 0, "obtrf_oder_107r", "InBlock1", "PWD" 					, 0 , edtPwd.encdata 			)
		end if
		DATAMANAGER.SetDataValue( 0, "obtrf_oder_107r", "InBlock1", "PROS_CLS" 				, 0 , "1" 					)
		
	ElseIf szTranID = "ohhts_3050_001r" Then
		Dim szMarket
		szMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		DATAMANAGER.ClearInputData( 0, "ohhts_3050_001r" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMarket 		)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	If szTranID = "obtrf_oder_105c" Then
		
		''//V002 재조회 제거, 무조건 재조회
		''Form.MsgBox(g_szTitle, "재조회 하시겠습니까?", "RESEARCH", "2")
		Init()
		DATAMANAGER.RequestTranData( "obtrf_oder_107r" )
		
		''//V002
		''btnCNTG.enable = false
		btnOrder.enable = false
		g_nSelectCnt = 0
		
		
	ElseIf szTranID = "obtrf_oder_106r" Then
	
	ElseIf szTranID = "obtrf_oder_107r" Then
		tbl0.SetCellString( 2, 2, "")
		tbl0.SetCellString( 3, 2, "")
		
		tbl1.SetCellString( 6, 2, "")
		tbl1.SetCellString( 7, 2, "")
		tbl1.SetCellString( 8, 2, "")
		tbl1.SetCellString( 9, 2, "")
		
		''//V002
		''btnCNTG.enable = true
		btnOrder.enable = false
		g_nSelectCnt = 0
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtrf_oder_106r" Then		
		Dim nCash, nEntm
		nCash = CDbl( tbl1.GetCellString(6, 2) ) - CDbl( tbl1.GetCellString(2, 2) )
		nEntm = CDbl( tbl1.GetCellString(7, 2) ) - CDbl( tbl1.GetCellString(3, 2) )
		
		if nCash > 0 then
			Cashmask="0,0,+,,0,,0,1,0"
		else
			Cashmask="0,0,,,0,,0,1,1"
		end if
		
		if nEntm > 0 then
			Entmmask="0,0,+,,0,,0,1,0"
		else
			Entmmask="0,0,,,0,,0,1,1"
		end if		
		tbl0.setCellMaskInfo( 2, 2, Cashmask)
		tbl0.setCellMaskInfo( 3, 2, Entmmask)
		
		tbl0.SetCellString( 2, 2, nCash)
		tbl0.SetCellString( 3, 2, nEntm)
		
		tbl1.setCellMaskInfo( 8, 2, Cashmask)
		tbl1.setCellMaskInfo( 9, 2, Entmmask)
		tbl1.SetCellString( 8, 2, nCash)
		tbl1.SetCellString( 9, 2, nEntm)
		
		If g_szTR_GUB = "0" Then		'체결 시 증거금 조회
			btnOrder.enable = true
		Else
			Send_Order()				'청산주문
		End If
	
	ElseIf szTranID = "obtrf_oder_107r" Then
		
		For i = 0 To grd0.rowcount - 1
			Dim szPosition					
			szPosition = grd0.GetCellData("bd_FtopType", i)		' 포지션구분코드
			
			grd0.SetCellData("bd_cell6"   , i, Form.GetMetaData("포지션구분코드", szPosition))
			
			
			''//V002
			grd0.SetCellImage("bd_OderType", i ,"input_01_n.9.png")
			grd0.SetCellData("bd_OderType", i, "지정가")

			grd0.SetCellImage("bd_Qty", i ,"input_01_n.9.png")
			grd0.SetCellData("bd_Qty", i, "수량입력"		)
			
			grd0.SetCellImage("bd_Price", i ,"input_01_n.9.png")
			grd0.SetCellData("bd_Price", i, "가격입력"	)
			
		Next
		
	ElseIf szTranID = "ohhts_3050_001r" Then
		Dim nHight, nLow
		nHight	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_MXPR2" , 0 ) )
		nLow	  	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_LLAM2" , 0 ) )
	
		Form.OpenPopup("mbtrf31030_p2" , g_szData  & "★" & nHight & "★" & nLow, "")
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
End Sub


