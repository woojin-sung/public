	<SCRIPT_INFO _len="21847" _ulen="19863" >
Dim MaxCnt
MaxCnt = 10

Dim gOsType
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	Container0.LabelText0.paddinginfo = "0,0,0,0"
	Container0.LabelText1.paddinginfo = "0,0,0,0"
	Container0.LabelText2.paddinginfo = "0,0,0,0"
	Container0.LabelItem1.paddinginfo = "0,0,0,0"
	Container0.LabelItem2.paddinginfo = "0,0,0,0"
	
	
	Container0.LabelText0.sizeAutoFit()
	Container0.LabelText1.sizeAutoFit()
	
	Container0.ChartEx0.SetChartType("pie")
	Container0.ChartEx1.SetChartType("pie")
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		'--------------------------------------------------------------
		'종목명 라벨
		'--------------------------------------------------------------
		Container0.LabelItemName1.fontsize = - Cint((gsLargeFontsize * 2))
		Container0.LabelItemName2.fontsize = - Cint((gsLargeFontsize * 2))
		
		'--------------------------------------------------------------
		'기준일자 라벨
		'--------------------------------------------------------------
		Container0.LabelItemStndDate1.fontsize = - Cint((gsLargeFontsize * 4))
		Container0.LabelItemStndDate2.fontsize = - Cint((gsLargeFontsize * 4))
	
	end if	
	
	Container0.LabelText0.caption = "섹터비중"
	Container0.LabelText1.caption = "구성종목(PDF)"
	
	Container0.LabelItem1.SetMaxLineCount(1)
	Container0.LabelItem2.SetMaxLineCount(1)
		
	
	'--------------------------------------------------------------
	' 하단 유의사항 아코디언 생성 및 큰글씨 모드 대응
	'--------------------------------------------------------------
	sNoticeText = "본 서비스에서 제공되는 데이터에 대한 저작권은\n모닝스타 코리아와 메리츠증권에 있으며 복사 또는 배포할 수 없습니다.\n\n"..
				"정보의 정확성과 신뢰성을 보장하기 위해 최선을 다하지만 이를 보장하지 않으며 손실이나 손상에 대한 법적 책임이 없습니다.\n\n"..
				"또한 제 3자 데이터 제공업체에서 자료를 제공하므로 수신이 지연되거나 일부 정보가 정확하지 않을 수 있습니다.\n\n"..
				"ETF는 자산가격 변동,환율 변동 등에 따라 투자원금의 일부 또는 전액 손실이 발생할 수 있으며, 그 손실은 투자자에게 귀속됩니다.\n\n"..
				"ETF는 예금자보호법에 따라 보호되지 않습니다.\n"
	
	if gbLargeFont then
		nTextSize = -2 - Cint((gsLargeFontsize * 2))
		Container0.Container1.makeExpandableList("","",nTextSize,nTextSize,334,333,0,320,false,5)
	else
		Container0.Container1.makeExpandableList("","",-2,-2,334,333,0,320,false,5)
	end if
	
	Container0.Container1.addExpandableList("유의사항",sNoticeText)
	
	'바로 펼쳐서 보여줄 시, iOS쪽이 안펼쳐지는 현상이 있어
	'타이머로 1초뒤에 펼침.(요건변경 => 디폴트 접힘상태)
	'Form.SetTimerEvent(1, 1, 1)
	
	Container0.SetScrollAutoSize()
	Container0.SetScrollBarVisble("0")
	
End Sub

'============================================================================
'
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'Form.ShowAlert("[포트폴리오]"..sEventName, sParam)
	
	if sEventName == "SEND_COMPARE_ITEM" then
	
		'종목명★시장구분코드★종목코드@종목명★시장구분코드★종목코드
		arrData = Split(sParam, "@")
		arrItem1 = Split(arrData(0),"★")
		arrItem2 = Split(arrData(1),"★")
		
		gCompareItemName1 = arrItem1(0)
		gCompareItemName2 = arrItem2(0)
		
		gCompareItemMarket1 = arrItem1(1)
		gCompareItemMarket2 = arrItem2(1)
		
		gCompareItemCode1 = arrItem1(2)
		gCompareItemCode2 = arrItem2(2)
		
		'차트 종목명 세팅
		Container0.LabelItem1.caption = gCompareItemName1
		Container0.LabelItem2.caption = gCompareItemName2
		
		'테이블 종목명 세팅
		Container0.LabelItemName1.paddinginfo = "0,0,0,0"
		Container0.LabelItemName2.paddinginfo = "0,0,0,0"
		Container0.LabelItemName1.SetMaxLineCount(2)
		Container0.LabelItemName2.SetMaxLineCount(2)
		Container0.LabelItemName1.caption = gCompareItemName1
		Container0.LabelItemName2.caption = gCompareItemName2
		
		'Container0.Table0.SetCellString(0, 0, gCompareItemName1)
		'Container0.Table0.SetCellString(0, 2, gCompareItemName2)
		
		'테이블 종목 기준일자 세팅
		Container0.LabelItemStndDate1.paddinginfo = "0,0,0,0"
		Container0.LabelItemStndDate2.paddinginfo = "0,0,0,0"
		
		if gOsType == "1" then
			Container0.LabelItemStndDate1.left = 27
			Container0.LabelItemStndDate2.left = 243		
		end if
				
		'구성종목 데이터 조회
		RequestTableData(gCompareItemMarket1,gCompareItemCode1,gCompareItemMarket2,gCompareItemCode2)
		
		'섹터비중 차트서비스 호출
		RequestChartData(gCompareItemMarket1,gCompareItemCode1,gCompareItemMarket2,gCompareItemCode2)

	end if
	
End Sub

'============================================================================
Function RequestChartData(sItemMarket1,sItemCode1,sItemMarket2,sItemCode2)
	
	
	'섹터비중 차트 데이터 조회
	DATAMANAGER.SetDataValue(0, "ohhts_metf_014r", "InBlock1", "FID_INPUT_OVRS_ISCD", 	 0, sItemCode1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_014r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",	 0, sItemMarket1)
		
	DATAMANAGER.SetDataValue(0, "ohhts_metf_014r_1", "InBlock1", "FID_INPUT_OVRS_ISCD", 		0, sItemCode2)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_014r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, sItemMarket2)
	
	DATAMANAGER.RequestTranData("ohhts_metf_014r")
	DATAMANAGER.RequestTranData("ohhts_metf_014r_1")
	 

End Function

'============================================================================
Function RequestTableData(sItemMarket1,sItemCode1,sItemMarket2,sItemCode2)

	'구성종목 데이터 조회
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r"		,"InBlock1"	,"FID_INPUT_OVRS_ISCD" 	, 0 , sItemCode1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r"		,"InBlock1"	,"FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , sItemMarket1)
		
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r_1"	,"InBlock1"	,"FID_INPUT_OVRS_ISCD" 	, 0 , sItemCode2)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_006r_1"	,"InBlock1"	,"FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , sItemMarket2)
	
	DATAMANAGER.RequestTranData("ohhts_metf_006r")
	DATAMANAGER.RequestTranData("ohhts_metf_006r_1")
	 

End Function
'============================================================================
Function SetPieChartData(sIndex,sTitle,sData,sColor)

	'=====================================================================================================================
	'("타이틀=데이터=컬러타입(커스텀:0)=정렬=툴팁 형식=중앙 텍스트=색상값(R,G,B;R,G,B)=중앙 원 비율=구분선 굵기= 해당값 이상만 그리기=애니메이션 유무=강조유무=툴팁유무=폰트스타일(title/value)(true=bold,false=normal)=폰트크기(title/value)=색상(title/value)")
	'=====================================================================================================================
	'(★동적) 타이틀 : 타이틀1;타이틀2;타이틀3...
	'(★동적) 데이터 : 7;40;30;27;16;15;14;10;9;8
	'(고정) 컬러타입 : (커스텀:0)
	'(고정) 정렬 : right
	'(고정) 툴팁형식 : V
	'(고정) 중앙텍스트 : 
	'(고정) 퍼센트 :  
	'(★동적) 색상값 : 62,93,255;62,93,255;0,188,247;101,0,255;215,79,226;150,224,83;255,153,84;68,85,123;126,132,152;154,163,188
	'(고정) 중앙원비율 : 0.55
	'(고정) 구분선 굵기 : 2
	'(고정) 해당값 이상만 그리기 : 0
	'(고정) 애니메이션 유무 : true
	'(고정) 강조유무 : false
	'(고정) 툴팁유무 : false
	'(고정) 폰트스타일(title/value)(true=bold,false=normal) : false/true
	'(고정) 폰트크기(title/value) : 10/10
	'(고정) 색상(title/value) : 29,219,22/255,0,255
	'=====================================================================================================================
	'sType = "1" 
	'sTitle = "타이틀1;타이틀2;타이틀3;타이틀4;타이틀5"
	'sData = "20;20;20;20;20"
	
	sDataTitle		= sTitle
	sDataValue		= sData
	sColorType 		= "0"
	sAlign 			= "right"
	sTooltipType 		= "V"
	sCenterTitle 		= ""
	sPercent 		= ""
	sPieChartColor 	= sColor '"246,248,168;254,226,196;254,206,209;244,190,234;209,186,244"
	sCircleRate 		= "0.55"
	sStorkeWidth 		= "2"
	sIgnoreValue 		= "0"
	sAnimationFlag 	= "false"
	sConvexusFlag 	= "false"
	sToolTipFlag 		= "false"
	sFontStyle 		= "false/true"
	sFontSize 		= "11/11"
	sFontColor 		= "115,118,124/115,118,124"
	
	if sIndex == "1" then
		Container0.ChartEx0.SetAccrueName(sDataTitle.."="..sDataValue.."="..sColorType.."="..sAlign.."="..sTooltipType.."="..sCenterTitle.."="..sPercent.."="..sPieChartColor.."="..sCircleRate.."="..sStorkeWidth.."="..sIgnoreValue.."="..sAnimationFlag.."="..sConvexusFlag.."="..sToolTipFlag.."="..sFontStyle.."="..sFontSize.."="..sFontColor)
	else
		Container0.ChartEx1.SetAccrueName(sDataTitle.."="..sDataValue.."="..sColorType.."="..sAlign.."="..sTooltipType.."="..sCenterTitle.."="..sPercent.."="..sPieChartColor.."="..sCircleRate.."="..sStorkeWidth.."="..sIgnoreValue.."="..sAnimationFlag.."="..sConvexusFlag.."="..sToolTipFlag.."="..sFontStyle.."="..sFontSize.."="..sFontColor)
	end if
	
End Function

'============================================================================
Function GetSectorRGB(sName)
	
	if sName == "IT" then
		return "246,248,168"
	elseif sName == "커뮤니케이션" or sName == "정보통신" then
		return "254,226,196"
	elseif sName == "금융" then
		return "254,206,209"
	elseif sName == "헬스케어" then
		return "244,190,234"
	elseif sName == "에너지" then
		return "209,186,244"
	elseif sName == "소재" then
		return "185,181,241"
	elseif sName == "산업재" then
		return "168,177,229"
	elseif sName == "경기소비재" then
		return "128,188,245"
	elseif sName == "필수소비재" then
		return "121,211,225"
	elseif sName == "유틸리티" then
		return "136,232,209"
	elseif sName == "부동산" then
		return "186,245,192"
	else
		return "229,229,229"
	end if

End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'----------------------------------
	' 파이차트 아이템1
	'----------------------------------
	if szTranID == "ohhts_metf_014r" then
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_014r", "OutBlock2")
		
		sTitleList = ""
		sDataList = ""
		sColorList = ""
		
		for i = 0 to nCnt - 1
			
			
			sTitle 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_014r", "OutBlock2", "FIDX_ETF_SECT_NAME" , i)
			sData 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_014r", "OutBlock2", "FID_RLIM" , i)
			sColor 	= GetSectorRGB(sTitle)
			
			if sTitleList == "" then
				sTitleList = sTitle
			else
				sTitleList = sTitleList .. ";" .. sTitle
			end if
			
			if sDataList == "" then
				sDataList = sData
			else
				sDataList = sDataList .. ";" .. sData
			end if
			
			if sColorList == "" then
				sColorList = sColor
			else
				sColorList = sColorList .. ";" .. sColor
			end if
			
			
		
		next
		
		'차트데이터 조회 건수가 없으면 조회정보 없음 라벨 표시
		if nCnt > 0 then
			
			Container0.imgNotice1.visible = false
			Container0.LabelGuideText1.visible = false
		
			SetPieChartData("1",sTitleList,sDataList,sColorList)
		else
			
			'(요건변경) 데이터없을때 무조건 기타100% (업혁 노민아 과장 요청)
			'Container0.imgNotice1.visible = true
			'Container0.LabelGuideText1.visible = true
			
			sTitleList = "기타"
			sDataList  = "100"
			sColorList = GetSectorRGB(sTitle)
			SetPieChartData("1",sTitleList,sDataList,sColorList)
		
		end if
		
	'----------------------------------
	' 파이차트 아이템2
	'----------------------------------
	elseif szTranID == "ohhts_metf_014r_1" then
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_014r_1", "OutBlock2")
		
		sTitleList = ""
		sDataList = ""
		sColorList = ""
		
		for i = 0 to nCnt - 1
			
			
			sTitle = DATAMANAGER.GetDataValue(0, "ohhts_metf_014r_1", "OutBlock2", "FIDX_ETF_SECT_NAME" , i)
			sData = DATAMANAGER.GetDataValue(0, "ohhts_metf_014r_1", "OutBlock2", "FID_RLIM" , i)
			sColor 	= GetSectorRGB(sTitle)
			
			if sTitleList == "" then
				sTitleList = sTitle
			else
				sTitleList = sTitleList .. ";" .. sTitle
			end if
			
			if sDataList == "" then
				sDataList = sData
			else
				sDataList = sDataList .. ";" .. sData
			end if
			
			if sColorList == "" then
				sColorList = sColor
			else
				sColorList = sColorList .. ";" .. sColor
			end if
		
		next
		
		'차트데이터 조회 건수가 없으면 조회정보 없음 라벨 표시
		if nCnt > 0 then
		
			Container0.imgNotice2.visible = false
			Container0.LabelGuideText2.visible = false
			
			SetPieChartData("2",sTitleList,sDataList,sColorList)
		
		else
		
			'(요건변경) 데이터없을때 무조건 기타100% (업혁 노민아 과장 요청)
			'Container0.imgNotice2.visible = true
			'Container0.LabelGuideText2.visible = true
			
			sTitleList = "기타"
			sDataList  = "100"
			sColorList = GetSectorRGB(sTitle)
			SetPieChartData("2",sTitleList,sDataList,sColorList)
		
		end if
		
	'----------------------------------
	' 구성종목 아이템1
	'----------------------------------
	elseif szTranID == "ohhts_metf_006r" then
		
		SetTableCellMaxLineCnt()
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_006r", "OutBlock1")
		
		for i = 0 to MaxCnt -1
		
			sName = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FIDX_KOR_ISNM" , i)
			sPer = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_RLIM" , i)
			
			if sName == "" then
				sName = "-"
			end if
			
			if sPer <> "" then
				sPer = sPer .. "%"
			end if
			
			if sName == "-" then
				Container0.Table0.SetCellString(i*3 + 2, 0, sName)
			else
				Container0.Table0.SetCellString(i*3 + 1, 0, sName)
				Container0.Table0.SetCellString(i*3 + 3, 0, sPer)
			end if
			
			'--------------------------------------------------------
			'구성종목 기준일자 표시
			'구성종목별 기준일자는 모두 동일하므로 처음값으로 세팅
			'--------------------------------------------------------
			if i == 0 then
				sStndDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r", "OutBlock1", "FID_STND_DATE" 	, i)
				nStndDateLen = Form.getLen(sStndDate)
				
				if nStndDateLen > 7 then
					Container0.LabelItemStndDate1.caption = sStndDate
				else
					Container0.LabelItemStndDate1.visible = false
					Container0.LabelItemName1.height = 48
				end if
	
			end if
			'--------------------------------------------------------
				
		next
	
	'----------------------------------
	' 구성종목 아이템2
	'----------------------------------
	elseif szTranID == "ohhts_metf_006r_1" then
	
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_006r_1", "OutBlock1")
		
		for i = 0 to MaxCnt -1
		
			sName = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r_1", "OutBlock1", "FIDX_KOR_ISNM" , i)
			sPer = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r_1", "OutBlock1", "FID_RLIM" , i)
			
			
			if sName == "" then
				sName = "-"
			end if
			
			if sPer <> "" then
				sPer = sPer .. "%"
			end if
			
			if sName == "-" then
				Container0.Table0.SetCellString(i*3 + 2, 2, sName)
			else
				Container0.Table0.SetCellString(i*3 + 1, 2, sName)
				Container0.Table0.SetCellString(i*3 + 3, 2, sPer)
			end if
			
			'--------------------------------------------------------
			'구성종목 기준일자 표시
			'구성종목별 기준일자는 모두 동일하므로 처음값으로 세팅
			'--------------------------------------------------------
			if i == 0 then
				sStndDate = DATAMANAGER.GetDataValue(0, "ohhts_metf_006r_1", "OutBlock1", "FID_STND_DATE" 	, i)
				nStndDateLen = Form.getLen(sStndDate)
				
				if nStndDateLen > 7 then
					Container0.LabelItemStndDate2.caption = sStndDate
				else
					Container0.LabelItemStndDate2.visible = false
					Container0.LabelItemName2.height = 48
				end if
	
			end if
			'--------------------------------------------------------
				
		next
	
	
	end if
	
End Sub

