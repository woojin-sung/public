	Container0.Table0.SetCellMaxLineCount(19,2,1)
	Container0.Table0.SetCellMaxLineCount(22,2,1)
	Container0.Table0.SetCellMaxLineCount(25,2,1)
	Container0.Table0.SetCellMaxLineCount(28,2,1)

End Function

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent(1, 0, 1)
	Container0.Container1.showExpandableList(0,true)

End Sub

'=======================================================================================
' 유의사항 컨테이너(아코디언) 접기/펼치기 후 사이즈 리턴(애니메이션 미사용 시에만 호출)
'=======================================================================================
Sub Container0_Container1_OnExpandableSize(nHeight)
	
	Container0.height = 1200 + nHeight + 1
	Container0.SetScrollAutoSize()
	
	nLinkFormHeight = 1200 + nHeight +1
	Form.triggerEvent("#", "NOTICE_HEIGHT_CHANGE", nLinkFormHeight)
	
End Sub

'============================================================================
' 구성종목 테이블 종목명 클릭 시, 종목명이 길 경우 클릭이벤트 발생
' 종목명이 길경우 종목명을 두줄 처리하여 별도의 라벨컨트롤을 클릭한 셀 위치에 보여준다.
'============================================================================
Sub Container0_Table0_OnClick(lRow , lColumn)
	
	if lColumn == 0 or lColumn == 2 then
	
		if (lRow % 3 == 1 or lRow % 3 == 0) and lRow <> 0 then
		
			if lRow % 3 == 0 then
				nSelectRow = lRow - 2
			else
			
				nSelectRow = lRow
			end if
			
			szItemName = Container0.Table0.GetCellString(nSelectRow, lColumn)
			szItemData = Container0.Table0.GetCellString(nSelectRow + 2, lColumn)
		
			if szItemName <> "" then
				
				nLen = Form.getLen(szItemName)
				
				'----------------------------------
				'큰글씨모드일때, 비교글자수 변경
				'----------------------------------
				nCompareLen = 8
				if gbLargeFont then
					nCompareLen = 5
				end if
				'----------------------------------
				
				if nLen > nCompareLen then
						
					if lColumn == 0 then
						xPos = 20
					elseif lColumn == 2 then
						xPos = 235	
					end if
					
					Container0.Label0.left = xPos
					
					if gOsType == "1" then
						nContTop = Form.calcUnResize(Container0.Table0.top, "1")
						sYpos = nContTop + 64 + Cint(nSelectRow/3) * 55
					else
						sYpos = Container0.Table0.top + 64 + Cint(nSelectRow/3) * 55
					end if
					
					Container0.Label0.top = sYpos
					
					Container0.Label0.paddinginfo = "3,0,3,0"
					Container0.Label0.SetMaxLineCount(2)
					Container0.Label0.caption = szItemName
					Container0.Label0.visible  = true
				
				else
					
					Container0.Label0.visible  = false
					
				
				end if
				
			else
			
				Container0.Label0.visible  = false
				
				
			end if
			
		else
			
			Container0.Label0.visible  = false
			
		end if
		
	else
	
		Container0.Label0.visible  = false
		
		
	end if
	
	
End Sub


'============================================================================
Sub Container0_Label0_OnClick()
	Container0.Label0.visible  = false
End Sub

