'	20230208 HSZ START: 시장종합 개편
'	szLoadData = Form.LoadConfigData(g_szInputFile, "41000P2_LISTITEMS")
	szLoadData = Form.LoadConfigData(g_szInputFile, "41020_LISTITEMS")
'	20230208 HSZ END
	
	arrLoadData = Array()
	arrLoadData = split(Trim(szLoadData), "★")
	
	g_arrSelectList = Array( "", "", "", "", "", "" )
	
	'설정 List SET
	if UBound(arrLoadData) >= 1 then
		For i = 1 to UBound(arrLoadData) step 2
			if Trim(arrLoadData(i)) <> "" then
				g_arrSelectList(nIdx) = arrLoadData(i)
				
				nIdx = nIdx + 1
			end if
		Next
	end if
	
	'20211005 아이티젠(김성수) END
	
'	For i = 0 to UBound(g_szKeys)
'		szVal = Form.LoadConfigData(g_szInputFile, g_szKeys(i))
		'Form.ShowAlert("output",g_szKeys(i) & "=" & szVal & ",," & i)
'		g_szValues(i) = szVal
		
		'20211005 아이티젠(김성수) START
		'시장종합 개편 추가
'		Dim nFlag
'		nFlag = 0
'		
'		For j = 0 to UBound(g_arrSelectList)
'			if g_szKeys(i) == g_arrSelectList(j) then
'				nFlag = 1
'			end if
'		Next
'		
'		if nFlag <> 1 then
'			g_arrNoneSelectList(nIdx) = g_szKeys(i)
'			nIdx = nIdx + 1
'		end if
		'20211005 아이티젠(김성수) END
'	Next
	
	'TEST 출력용 
'	For j = 0 to UBound(g_szKeys)
'		Form.ShowAlert("output22",g_szKeys(j) & "=" & g_szValues(j)  & ",," & j )
'	Next
	
End Function


'============================================================================
'ShowSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function ShowSettings()
	dim nGridIdx
	dim szOutputData
	
	nGridIdx = 0 
'	call LoadSettings()

	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
	Dim nNoneSelectIdx
	nNoneSelectIdx = 0
	
	Dim nGrd_Header_H, nGrd_Cell_H '그리드 header, cell 높이
	nGrd_Header_H, nGrd_Cell_H = 25, 50
	
	Dim nGrdMain00_H, nGrdMain01_T, nGrdMain01_H
	nGrdMain00_H, nGrdMain01_T, nGrdMain01_H = 0,0,0
	
	Dim nFlag, nMatchIdx
	
	grdMain00.SetClear( )
	grdMain01.SetClear( )
	
	'설정 목록 UI SET
	For i = 0 to UBound(g_arrSelectList)
		if g_arrSelectList(i) <> "" then
			nFlag = 0
			
			for j = 0 to UBound(g_szKeys)
				if g_arrSelectList(i) == g_szKeys(j) then '리스트 데이터 비교
					nFlag = 1
					nMatchIdx = j
				end if 
			next
			
			if nFlag == 1 then
				grdMain00.AddRow( )
				
				grdMain00.SetCellData("bd_cell1", nGridIdx, g_szNames(nMatchIdx))
				grdMain00.SetCellData("bd_cell3", nGridIdx, g_szKeys(nMatchIdx))
				grdMain00.SetCellData("bd_cell5", nGridIdx, "1")
				grdMain00.SetCellData("bd_cell0", nGridIdx, "1")
				nGridIdx = nGridIdx + 1
				
				nGrdMain00_H = nGrdMain00_H + nGrd_Cell_H
				nGrdMain01_T = nGrdMain01_T + nGrd_Cell_H
			end if	
		end if
	Next
	
	Call f_SetNoneSelectList()
	
	'미설정 목록 UI SET
	if UBound(g_arrNoneSelectList) > 0 then
		for i = 0 to UBound(g_arrNoneSelectList)
			for j = 0 to UBound(g_szKeys)
				if g_arrNoneSelectList(i) == g_szKeys(j) then
					grdMain01.AddRow()
					
'					Form.ShowAlert(g_arrNoneSelectList(i), g_szKeys(j))
					grdMain01.SetCellData("bd_cell1", i, g_szNames(j))
					grdMain01.SetCellData("bd_cell3", i, g_szKeys(j))
					grdMain01.SetCellData("bd_cell5", i, "1")
					
					nGrdMain01_H = nGrdMain01_H + nGrd_Cell_H
					
				end if
			next
		next
		
	else
		grdMain01.SetClear()
		
	end if
	
	if nGrdMain00_H > 0 then
		'안드로이드에서 그리드 순서 변경 시 
		'맨 아래 목록이 사라지는 현상이 있어서 삭제
'		grdMain00.height 	= nGrdMain00_H + nGrd_Header_H 
		grdMain01.height 	= nGrdMain01_H + nGrd_Header_H
		grdMain01.top		= nGrdMain01_T + nGrd_Header_H
	end if
	
	'20211005 아이티젠(김성수) END
	
'	for i = 0 to UBound(g_szKeys) 
'		szOutputData = g_szValues (i)
'		
'		if szOutputData = "1" then ' 설정 목록 셋팅
'			'grdMain00.SetCellData("bd_cell0", nGridIdx, "DEL")
'			grdMain00.SetCellData("bd_cell1", nGridIdx, g_szNames(i))
'			grdMain00.SetCellData("bd_cell3", nGridIdx, g_szKeys(i))
'			grdMain00.SetCellData("bd_cell5", nGridIdx, g_szValues(i))
'			nGridIdx = nGridIdx + 1
'			grdMain00.AddRow()
'		end if
'	next 
	
'	grdMain00.SetDeleteRow(nGridIdx)
	
End Function

