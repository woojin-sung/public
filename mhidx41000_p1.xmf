dim g_szValues		'읽어들인세팅값
dim g_szNames 		'한글로 출력할 이름

'20211005 아이티젠(김성수) START
'g_szKeys = Array(  "41000P2_TILE6ROW" , "41000P2_INVR", "41000P2_PROG", "41000P2_CHNG", 
'			"41000P2_PROD", "41000P2_RATE") '6개		
'g_szNames = Array( "지수타일",  "종목 조회 순위", "메뉴 바로가기", "키워드뉴스", "환율/상품/금리", 
'			 "투자자별/프로그램 매매동향" )'6개
'20230208 HSZ START 
'시장종합 개편 수정
Dim g_arrSelectList, g_arrNoneSelectList
g_arrSelectList = Array( "", "", "", "", "", "" )
g_arrNoneSelectList = Array( "", "", "", "", "", "" )

g_szKeys = Array(	"41020_EVENT", "41020_INDEX", "41020_NEWS", "41020_HISTORY", 
						"41020_MYNEWS"  , "41020_RANKING", "41020_NOTICE", "41020_LINK" )	'8개
			
g_szNames = Array( "메리츠 상품 및 이벤트", "주요지수", "실시간 뉴스", "MY 종목"
					, "MY 뉴스", "실시간 순위", "공지", "유튜브·카카오 채널 바로가기")		'8개	20230720 HSZ MY종목,MY뉴스,바로가기 명칭 변경 및 체크/버튼이미지 변경
