'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
'	20230208 HSZ START: 시장종합 개편
'	g_szInputFile	= "41000P2ITEMS.ini"	
'	g_szFileName	= "41000ITEMS.ini"
	g_szInputFile	= "41020ITEMS.ini"	
	g_szFileName	= "41000V2ITEMS.ini"
'	20230208 HSZ END
	Form.SetScreenName("설정") ''20211005 아이티젠(김성수) 삭제 / Framepopup에서 일반 popup으로 변경
	grdMain00.rowmove = "1"	
	call LoadSettings()
	call ShowSettings()

End Sub


'============================================================================
'btnInit00_OnClick
'============================================================================
Sub btnInit00_OnClick()
	'TODO : 클리어하고 기본 값만 세팅하는 기능 

	'전체 아이템 세팅
	'20230208 HSZ START
'	Form.SaveConfigData(g_szInputFile, "41000P2_TILE"		, "0")
'	Form.SaveConfigData(g_szInputFile, "41000P2_INVR"		, "1")
'	Form.SaveConfigData(g_szInputFile, "41000P2_PROG"		, "1")
'	Form.SaveConfigData(g_szInputFile, "41000P2_CHNG"		, "1")
'	Form.SaveConfigData(g_szInputFile, "41000P2_PROD"		, "1")
'	Form.SaveConfigData(g_szInputFile, "41000P2_RATE"		, "1")
'	Form.SaveConfigData(g_szInputFile, "41000P2_TILE6ROW"  , "1")

	Form.SaveConfigData(g_szInputFile, "41020_EVENT"		, "1")
	Form.SaveConfigData(g_szInputFile, "41020_INDEX"		, "1")
	Form.SaveConfigData(g_szInputFile, "41020_NEWS"		, "1")
	Form.SaveConfigData(g_szInputFile, "41020_HISTORY"	, "1")
	Form.SaveConfigData(g_szInputFile, "41020_MYNEWS"		, "1")
	Form.SaveConfigData(g_szInputFile, "41020_RANKING"	, "1")
	Form.SaveConfigData(g_szInputFile, "41020_NOTICE" 	, "1")
	Form.SaveConfigData(g_szInputFile, "41020_LINK"  		, "1")
	'20230208 HSZ END
	
	'지수 항목 세팅
	Form.SaveConfigData(g_szFileName, "41000_KOSPI"		, "1")
	Form.SaveConfigData(g_szFileName, "41000_KOSDAQ"		, "1")
	Form.SaveConfigData(g_szFileName, "41000_KOSPI200"	, "0")
	Form.SaveConfigData(g_szFileName, "41000_FUTURE"		, "1")
	Form.SaveConfigData(g_szFileName, "41000_DOW"			, "1")
	Form.SaveConfigData(g_szFileName, "41000_NASDAQ"		, "0")
	Form.SaveConfigData(g_szFileName, "41000_SP500"		, "0")
	Form.SaveConfigData(g_szFileName, "41000_SHANGHAI"	, "1")
	
	'20220401 SWJ START ; 설정 초기화 니케이->홍콩으로 변경
	Form.SaveConfigData(g_szFileName, "41000_HONGKONG"	, "1")
	Form.SaveConfigData(g_szFileName, "41000_NIKKEI"		, "0")
	'20220401 SWJ END
	
	Form.SaveConfigData(g_szFileName, "41000_WONDOLLAR"	, "1")
	Form.SaveConfigData(g_szFileName, "41000_WONYEN"		, "1")
	Form.SaveConfigData(g_szFileName, "41000_WONWIAN"		, "1")
	'Form.SaveConfigData(g_szFileName, "41000_DOLLAREURO"	, "0")
	Form.SaveConfigData(g_szFileName, "41000_YENDOLLAR"	, "0")
	Form.SaveConfigData(g_szFileName, "41000_YENEURO"		, "0")
	'Form.SaveConfigData(g_szFileName, "41000_DOLLARPOUND" , "0")
	
	' 20160728 전요셉과장 default 조정 요청
	Form.SaveConfigData(g_szFileName, "41000_GOLD"	, "1")
	Form.SaveConfigData(g_szFileName, "41000_WTI"		, "1")
	Form.SaveConfigData(g_szFileName, "41000_DUBAI"	, "0")
	Form.SaveConfigData(g_szFileName, "41000_BRENT"	, "1")
	
	Form.SaveConfigData(g_szFileName, "41000_CD"		, "1")
	Form.SaveConfigData(g_szFileName, "41000_COMBOND"	, "1")
	Form.SaveConfigData(g_szFileName, "41000_CNTBOND"	, "1")
	
	Form.SaveConfigData(g_szInputFile, "41000P2_TILECNT"	, "1")
	
	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
	Dim szLinkData
	szLinkData = UBound(g_szKeys) - LBound(g_szKeys) + 1
	
	for i = 0 to UBound(g_szKeys)
		szLinkData = szLinkData & "★" & g_szKeys(i) & "★" & "1"
		
	next
'	20230208 HSZ START
'	Form.SaveConfigData(g_szInputFile, "41000P2_LISTITEMS", szLinkData)
	Form.SaveConfigData(g_szInputFile, "41020_LISTITEMS", szLinkData)
'	20230208 HSZ END
	
	Form.ShowAlert("알림", "설정이 초기화 되었습니다.")
	
	LoadSettings()
	ShowSettings()
	
	Form.SendReturnToParent("REFRESH_MAIN" , "")
	'20211005 아이티젠(김성수) END
End Sub


'============================================================================
'grdMain00_OnClickUp
'============================================================================
Sub grdMain00_OnClickUp(lRow, szCellID)
	dim szCnt
	dim szItemName			'선택된 ITEM의 이름 
	
	szCnt = grdMain00.rowcount
	
	if szCellID = "bd_cell0" then					' 삭제 기능 
		if szCnt <= "3" then
			grdMain00.SetCellData( "bd_cell0", lRow, 1 )
			Form.ShowAlert("알림", "최소 3개 이상 유지되어야합니다.")
		else
'			szItemName = grdMain00.GetCellData("bd_cell3", lRow)
'			Form.SaveConfigData(g_szInputFile, szItemName, "0★-1")
			grdMain00.SetDeleteRow(lRow)
			
			'20211005 아이티젠(김성수) START
			'시장종합 개편 추가
			g_arrSelectList = Array( "", "", "", "", "", "" )
			szCnt = CInt(grdMain00.rowcount)
			
			for i = 0 to szCnt
				szItemName = grdMain00.GetCellData("bd_cell3", i)
				
				if szItemName <> "" and szItemName <> null then
					g_arrSelectList(i) = szItemName
				end if
			next
			'20211005 아이티젠(김성수) END
			
			ShowSettings()
			
		end if 
	end if 
	
End Sub

'============================================================================
'grdMain01_OnClickUp
'============================================================================
'20211005 아이티젠(김성수) START
'시장종합 개편 추가
Sub grdMain01_OnClickUp(lRow, szCellID)
	dim szCnt
	dim szItemName			'선택된 ITEM의 이름 
	
'	szCnt = grdMain01.rowcount
	
	if szCellID = "bd_cell0" then
		szItemName = grdMain01.GetCellData("bd_cell3", lRow) '미설정에서 선택한 키 값
		
		szCnt = CInt(grdMain00.rowcount) '설정한 목록의 개수 = Select List 길이
		g_arrSelectList(szCnt) = szItemName '추가된 항목을 Selet List 뒤에 추가
		grdMain01.SetDeleteRow(lRow)
		
		ShowSettings()
	end if 
	
End Sub
'20211005 아이티젠(김성수) END

