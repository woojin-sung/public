'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function
'============================================================================
'f_SaveSettingData() : 설정저장 함수
'============================================================================
'20211005 아이티젠(김성수) START
'시장종합 개편 추가
Function f_SaveSettingData()
	dim szGridCnt
	dim szLinkData
	
	szGridCnt = grdMain00.rowcount
	szLinkData = szGridCnt 
	
	for i = 0 to  szGridCnt - 1
		dim sKeys, sValue
		sKeys = grdMain00.GetCellData("bd_cell3", i)
		sValue = grdMain00.GetCellData("bd_cell5", i)
		szLinkData = szLinkData & "★" & sKeys & "★" & sValue
		
		Form.SaveConfigData(g_szInputFile, sKeys ,sValue)
	next
'	20230208 HSZ START: 시장종합 개편
'	Form.SaveConfigData(g_szInputFile, "41000P2_LISTITEMS", szLinkData)
	Form.SaveConfigData(g_szInputFile, "41020_LISTITEMS", szLinkData)
'	20230208 HSZ END
	Form.SendReturnToParent("REFRESH_MAIN" , "")
End Function
'20211005 아이티젠(김성수) END

'============================================================================
'f_SetNoneSelectList() : 미설정 목록 데이터 SET
'============================================================================
Function f_SetNoneSelectList()
	'미설정 List SET
	Dim nFlag, nIdx
	nIdx = 0
	
	g_arrNoneSelectList = Array( "", "", "", "", "", "" )
	
	For j = 0 to UBound(g_szKeys)
		nFlag = 0
	
		for k = 0 to UBound(g_arrSelectList)
			if g_szKeys(j) == g_arrSelectList(k) then
				nFlag = 1
			end if
		next
		
		if nFlag == 0 then
			g_arrNoneSelectList(nIdx) = g_szKeys(j)
			nIdx = nIdx + 1
			
		end if
	Next
	
End Function

'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들임
'============================================================================
Function LoadSettings()
	dim szVal
	dim nIdx
	nIdx = 0
	
'	g_szValues = Array()
	
	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
