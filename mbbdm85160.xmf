				<LABEL name="Label1" fontsize="2" caption="사용하실 계좌비밀번호를 입력해주세요" halign="1" ly_vert="0,188,335,20,1" />
				<EDIT name="EdtPwReal" visible="0" password="2" imetype="1" maxlength="4" minlength="4" ly_vert="92,51,262,34,0" />
				<IMAGE name="Image0" autosize="1" imgpath="icon_top_back_light" ly_vert="20,18,24,24,1" />
