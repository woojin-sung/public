				<IMAGE name="PwdFail1" visible="0" autosize="1" imgpath="pwd_red" ly_vert="156,239,20,20,0" />
				<IMAGE name="PwdFail2" visible="0" autosize="1" imgpath="pwd_red" ly_vert="194,239,20,20,0" />
				<IMAGE name="PwdFail3" visible="0" autosize="1" imgpath="pwd_red" ly_vert="232,239,20,20,0" />
				<IMAGE name="PwdInsert0" visible="0" autosize="1" imgpath="pwd_blue" ly_vert="118,239,20,20,0" />
				<IMAGE name="PwdInsert1" visible="0" autosize="1" imgpath="pwd_blue" ly_vert="156,239,20,20,0" />
				<IMAGE name="PwdInsert2" visible="0" autosize="1" imgpath="pwd_blue" ly_vert="194,239,20,20,0" />
				<IMAGE name="PwdInsert3" visible="0" autosize="1" imgpath="pwd_blue" ly_vert="232,239,20,20,0" />
				<IMAGE name="Pwdbasic0" autosize="1" imgpath="pwd_gray" ly_vert="118,239,20,20,1" />
