'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	
	Form.SetScreenName( "권리정보" )
	
	szData = Form.GetOpenLinkData()
	
	g_szList = Split(szData, "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
		
	DATAMANAGER.SetDataValue( 0, "obrgt_ismn_308r", "InBlock1", "RGHT_TYPE_CODE" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0, "obrgt_ismn_308r", "InBlock1", "RGHT_STND_DATE" , 0 , g_szList(1))
	DATAMANAGER.SetDataValue( 0, "obrgt_ismn_308r", "InBlock1", "ISCD" , 0 , g_szList(2))
	
	DATAMANAGER.RequestTranData( "obrgt_ismn_308r" )
End Sub

