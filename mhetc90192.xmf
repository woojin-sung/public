'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mpopup_auth" then
		if sRet == "AuthCancel" then
			Form.SetTimerEvent2( "1", 1, 0.1)
			
		elseif sRet == "AuthRenew" then
		
			'Form.OpenPopup("mhetc90190_s3","renew","")
			Form.OpenFramePopup("mhetc90060_py","mhetc90192_Renew","")
			
		elseif sRet == "AuthCancel2" or sRet == "AuthCancel3" then
			if Cint(g_LoginType) >= 2 then
				g_logout = true
			end if
			
			Form.CloseForm()
		end if
		
	elseif sKeyName == "Login_Type" then
	
		if Cint(sRet) >= 1 then
			if g_logforce = "AuthRenew" then
				Form.OpenPopup("mpopup_auth" , "AuthRenew" , "" )
			else
				Form.OpenPopup("mpopup_auth" , "AuthCancel" , "" )
			end if
		end if
		
	elseif sKeyName == "mhetc90060_py" then
		if sRet == "ok" then
			sPinData = Form.GetSharedData( "90060py_AuthPwd" , false )
			
			'-----------------------------------------------------------------------
			'전문전송
			'-----------------------------------------------------------------------	
			procRequestAtonTR_DISCARDCERT(sPinData)
		elseif sRet == "RenewOK" then
			Form_OnFormInit()
		end if
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Close" then
		Form.OpenNextPopup("mhidx41000" , "", "")
	
	elseif sKeyName == "LOG_FORCE" then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021" , "" , "")
			g_logforce = "AuthCancel"
		else
			Form.CloseForm()			
		end if
		
	elseif sKeyName == "LOG_FORCE2" then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021" , "" , "")	
			g_logforce = "AuthRenew"
		else
			Form.CloseForm()			
		end if
	
	elseif sKeyName = "AuthCancel" then
		if Cint(g_LoginType) >= 2 then
			g_logout = true
			Form.CloseForm()
		end if
	
	elseif sKeyName == "E3201" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s1" , "" , "")
		end if
	end if
End Sub

'============================================================================
Sub procRequestAtonTR_DISCARDCERT(paramPinData)	
	sTranID = "ohhts_pauth_003"

	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO"					, 0 , g_CustNum)		'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_PIN_DATA_CON" 				, 0 , paramPinData)	'PIN데이터내용 (예: SHA-256 HexString, 64Byte)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID

	DATAMANAGER.RequestTranData(sTranID)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "ohhts_pauth_003" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0) 	'인증서일련번호
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if			
		
		'-----------------------------------------------------------------------
		'ATON_DISUSE
		'-----------------------------------------------------------------------			
		sRet = Form.requestAtonAuth("ATON_DISUSE" , sKeyAlias , "")
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
		else
			'알리미 발송
			DATAMANAGER.RequestTranData("obcsb_oimf_658a")
		end if	
		
	end if
	
	if szTranID == "ohhts_pauth_004" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" 					,0)
		g_sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" 				,0) 		 '인증서일련번호	
		g_AtonBioYn	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_BIO_USE_YN" 				,0) 		 '생체인증사용여부
		g_StartYMD	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_VLTE_STTG_YMD"   			,0) 	     '인증서유효시작년월일
		g_EndYMD		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_VLTE_EXPY_YMD"				,0) 	     '인증서유효만료년월일
		g_RenewYN	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_EXPY_GDNC_YN"			,0) 	     '인증서갱신공지여부
		g_DcrdGbn	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_STTS_DCD"				,0) 	     '인증서상태구분코드 (10. 발급, 50. 폐기)
		
		if sErrorCode <> "000000" then		
			'메시지 박스 처리할지 확인
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			'Form.MsgBox(szTranID, "(" & sErrorCode & ")" & sErrorMsg, "", 0)
		end if
		
		'CheckBio 추가
		'서버 조회 및 앱 정보 조회까지 추가
		'(간편비번 + 생체 등록되어있는상태에서
		'생체인증 추가등록을 할 때, 실제 발급까지 완료하진 않고 생체인증을 태우고 취소를 눌러서 껐을 때
		'생체인증을 발급했던 정보가 날아가서
		'앱과 서버 정보가 불일치)
		procVerifyBioSignature()
		
		'등록여부별 UI 불러옴
		AuthManager()
	end if 
	
	if szTranID == "obcsb_oimf_658a" then
		szProsYN = DATAMANAGER.GetDataValue(0, "obcsb_oimf_658a", "OutBlock1", "PROS_YN" ,0)
		
		if szProsYN == "Y" then
			Form.OpenPopup("mpopup_auth","AuthCancel2","")
		else
			Form.OpenPopup("mpopup_auth","AuthCancel3","")
		end if
	end if	
End Sub
'============================================================================
'생체인증정보 확인 및 검증
'============================================================================
Sub procVerifyBioSignature()
	'-----------------------------------------------------------------------
	'ATON_CHECKBIOSIGNATURE
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_CHECKBIOSIGNATURE" , "" , "")
	
	sRetItem = Split(sRet, "★")
	
	g_sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]

End Sub
'-----------------------------------------------------------------------------
'SafeBox 정보획득
'-----------------------------------------------------------------------------
function fnGetSBInfo(sParam)
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	g_SBVersion  	= sRetItem[2] 'SafeBox 버전 (에러여도 값 있음)
	g_SBAlias 	= sRetItem[3] '인증서일련번호(식별자)

	if sErrorCode == "00000" then
		
		if sParam <> "ISSUE" then
			'발급시 인증서 일련번호에 해당하는 고객번호를 획득
			'g_CustNo = Form.LoadConfigData("MERITZATONAUTH", g_SBAlias) '발급 시, 고객번호를 앱에 저장 후 이값을 인증 시 사용 (인증서조회 1 transaction을 줄이고자 함)
			g_CustNo = Form.GetSharedData("&CUST_NUM", false )
		end if
		
		return True
	else
		if sParam <> "ISSUE" then
			if sErrorCode == "E3201" then
				Form.MsgBox("안내", "메리츠 간편인증 등록 후\n이용해주세요.", "E3201", 7, "간편인증 등록","취소")
			else
				Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			end if
		end if
	
		return False
	end if
	
	return True
end function
'============================================================================
Sub procRequestAtonTR_INQUIRYCERT()
	sTranID = "ohhts_pauth_004"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO"				, 0 , g_SBAlias)		'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNum)		'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
		
	DATAMANAGER.RequestTranData(sTranID)
End Sub
'============================================================================
Sub AuthManager()
	ImgMeritz.visible = True
	
	'등록된 간편인증 O
	if g_DcrdGbn == "10" then
		contX.visible = False
		contRegi.visible = True
		contRegi.left = 24
		contRegi.Top = 78
		ImgMeritz.visible = True
		
		'생체인증 등록여부
		if g_AtonBioYn = "Y" and g_sErrorCode <> "E4103" then
			if g_sBioType = "2" then
				'Face 등록
				sRegiType = "간편비밀번호 + Face ID"
				sRegiTypeNum = "01$02"
			else
				'지문 등록
				sRegiType = "간편비밀번호 + 지문"
				sRegiTypeNum = "01$03"
			end if
		else
			sRegiType = "간편비밀번호"
			sRegiTypeNum = "01"
		end if
		
		'갱신 가능할 때에 따라 버튼 상태 변경
		if g_RenewYN == "Y" then
			contRegi.ImgRenew.imgpath = "input_01_n.9"
			contRegi.LblRenew.fgcolor = "334"
		else
			contRegi.ImgRenew.imgpath = "input_01_d.9"
			contRegi.LblRenew.fgcolor = "321"
		end if
		
		'알리미 서비스 태우기 위해 (갱신, 해지 안내 시)
		'간편비밀번호 인증방식 구분 Set
		Form.SetSharedData("MERITZAUTH_REGITYPE", sRegiTypeNum)
		
		contRegi.Table0.SetCellString(0, 1, g_sCsName & "님의 간편인증")
		contRegi.Table0.SetCellString(2, 2, sRegiType)
		contRegi.Table0.SetCellString(3, 2, g_StartYMD)
		contRegi.Table0.SetCellString(4, 2, g_EndYMD)
		
		szEndYMD = left(g_EndYMD, 4) & "." & Mid(g_EndYMD, 5 ,2) & "." & Right(g_EndYMD, 2)
		
		'갱신 안내 때 쓰기 위함
		Form.SetSharedData("MerithAuth_EndYMD" , szEndYMD)
	'등록된 간편인증 X
	else
		contX.visible = True
		contRegi.visible = False
		contX.BtnRegi.caption = "메리츠 간편인증 등록 >"
	end if
End Sub

'============================================================================
Sub contX_BtnRegi_OnClick()
	Form.OpenNextPopup( "mhetc90190_s1" , "AuthCenter" , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'알리미 발송 서비스
	if szTranID == "obcsb_oimf_658a" then
		sRegiType = Form.GetSharedData( "MERITZAUTH_REGITYPE" , false )
		
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "PROS_CLS"			, 0 , "3"       ) '해지
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "UI_EASY_ATHN_KEY_VAL" , 0 , sRegiType  ) '간편인증/지문/Face ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "CSNO" 				, 0 , g_CustNo  ) 
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "REG_YN_IQRY_KEY"		, 0 , g_SBAlias  ) 
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Trim(sTimerID) == "1" then
		Form.SetTimerEvent2(1, 0, 0)
		
		if fnGetSBInfo("") == False then 
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'PIN 또는 바이오 데이터입력받아야함 (사용자인증)
		'-----------------------------------------------------------------------
		Form.OpenFramePopup("mhetc90060_py" , "mhetc90192_Cancel" , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_oimf_658a" then
		Form.OpenPopup("mpopup_auth","AuthCancel3","")
		exit sub
	end if
	
	Form.MsgBox( "안내", szErrMsg, "", 6 )
End Sub
'============================================================================
Sub Form_OnFormClose()
	if g_logout then
		'(1param(0:문구없음,1문구있음), 
		'2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
		Form.LogOut(0, 1)
	end if
	
End Sub

