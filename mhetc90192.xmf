'-------------------------------------------------------------------------------------------
'20230519 SWJ START : 메리츠 사설인증 신규 개발 (메리츠 간편인증센터 -> 인증 관리)
' 2024.01.19 : 전상일 : v0001 : obcsb_oimf_658a ui_cust_cont_cls_code 추가 (별도 맵핑 x)
'-------------------------------------------------------------------------------------------
Dim g_LoginType
Dim g_sErrorCode, g_sPauCustNo, g_DeviceId
Dim g_AtonBioYn			'바이오 사용여부
Dim g_ScrPoint			'진입한 곳
Dim g_sBioType
Dim g_CustNo, g_SBVersion, g_SBAlias
Dim g_sAthnTchnCode
Dim g_PinPWD
Dim g_complete
Dim g_DcrdGbn

'인증유형구분
Dim DEF_ATON_PIN
Dim DEF_ATON_BIO

'인증유형 바이오 구분
Dim DEF_ATON_FINGER
Dim DEF_ATON_FACE

DEF_ATON_PIN			= "10"
DEF_ATON_BIO			= "20"

DEF_ATON_FINGER 		= "100"
DEF_ATON_FACE 		= "200"

Dim g_sCsName
Dim g_StartYMD, g_EndYMD, g_AtonBioYn
Dim g_sKeyAlias

Dim g_logforce
Dim g_RenewYN
Dim g_sErrorCode
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	contX.ImgRegi.setMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", false )
	g_DeviceId  = Form.GetDeviceID2()
	g_sBioType  = Form.getBiometryType()						'생체/지문 기기 및 사용가능여부 판단 : 0.사용불가 1.TOUCH ID 2.FACE ID
	'szName      = Form.GetSharedData("&USER_NAME", false)
	
	g_CustNum   = Form.GetSharedData("&CUST_NUM"  , false )	 '고객번호
	
	'-----------------------------------------------------------------------
	'발급여부 미리 판단
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
	sRetItem = Split(sRet, "★")
		
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]	
	sSBVersion 	= sRetItem[2] 'SafeBox 버전
	g_SBAlias 	= sRetItem[3] '인증서일련번호(식별자)
	
	'발급시 인증서 일련번호에 해당하는 고객번호를 획득
	'g_sCsName = Form.LoadConfigData("MERITZATONAUTH2", g_SBAlias)
	'tmpCsNO = Form.LoadConfigData("MERITZATONAUTH", g_SBAlias)
	
	g_sCsName = Form.GetSharedData("&USER_NAME", false)

'	if g_sCsName == "" or g_sCsName == null then
'		g_sCsName = "고객"
'	end if

	'식별자 없으면 앱에 간편인증 등록 정보 없는 것
	if g_SBAlias == "" or g_SBAlias == null then
		contX.visible = True
		contRegi.visible = False
		contX.BtnRegi.caption = "메리츠 간편인증 등록 >"
		exit sub
	end if
	
	'-----------------------------------------------------------------------
	'전문전송
	'-----------------------------------------------------------------------	
	procRequestAtonTR_INQUIRYCERT()	
	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

