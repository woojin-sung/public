'----------------------------------------------------------------------------
' 01. 화 면 명 : 탭_시간별
' 02. 화면설명 : 주식현재가 시간별 탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szgrdHeader1, g_szgrdHeader2

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szItemCode		= arrData(0)

	Form.SetScreenName( arrData(1) )

	
	g_szgrdHeader1	= Form.LoadConfigData("mhprc11000", "PA_Header1")
	g_szgrdHeader2	= Form.LoadConfigData("mhprc11000", "PA_Header2")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_tog = 0 '0은 전일대비 / 1은 등락율
	
	If Left(g_szgrdHeader1, 7) = "th_cell" then
		grd0_OnHeaderClickUp(0, g_szgrdHeader1)
	End if 	

	If Left(g_szgrdHeader2, 7) = "th_cell" then
		grd0_OnHeaderClickUp(0 , g_szgrdHeader2 )
	End if 	
	
	DATAMANAGER.RequestTranData( "ohhts_1182_002r" )
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mhprc11000", "PA_Header1", g_szgrdHeader1)
	Form.SaveConfigData("mhprc11000", "PA_Header2", g_szgrdHeader2)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID = "ohhts_1182_002r" then
	    DATAMANAGER.CancelRealData("ohhts_ovtp_cntg")
	    	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, "J" )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_HOUR_CLS_CODE" 		, 0, "1" )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0, "N" )
	    
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	    DATAMANAGER.SetDataValue( 1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	For i = 0 To grd0.rowcount - 1
		Dim nData
		nData = CDbl( grd0.GetCellData( "bd_cell2", i ) )
		
		If nData > 0 Then
			grd0.SetCellFgColor( "bd_cell1", i, "10")
		ElseIf nData < 0 Then
			grd0.SetCellFgColor( "bd_cell1", i, "11")
		Else
			grd0.SetCellFgColor( "bd_cell1", i, "12")
		End If
	
	Next
	
	DATAMANAGER.RequestRealData( "ohhts_ovtp_cntg" )
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
End Sub


'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)

	    if szCellID = "th_cell6" then				' 등락률
		    grd0.SetVisibleCol(2, 0)
		    grd0.SetVisibleCol(3, 1)
		    g_szgrdHeader1 = szCellID
	    elseif szCellID = "th_cell3" then			' 대비
		    grd0.SetVisibleCol(2, 1)
		    grd0.SetVisibleCol(3, 0)
		    g_szgrdHeader1 = szCellID
		elseif szCellID = "th_cell5" then			' 거래량
		    grd0.SetVisibleCol(4, 1)
		    grd0.SetVisibleCol(5, 0)
		    g_szgrdHeader2 = szCellID
		 elseif szCellID = "th_cell4" then			' 체결량
		    grd0.SetVisibleCol(4, 0)
		    grd0.SetVisibleCol(5, 1)
		    g_szgrdHeader2 = szCellID
	    end if
End Sub


