Sub Form_OnPopupReturn(sKeyName, sRet)
	l_sSendData = "" 'v0003
	'l_sSendData= g_sSendDataTmp
	if sKeyName == g_sPopupFileName then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90020_pi", "", "")
			'If sKeyName == "mhetc90060_motp" Then
			'	if g_plain_rm == "1" then
			'		'g_sSendData = g_sSendDataTmp + edtNewPW.caption + "★"
			'		l_sSendData = g_sSendDataTmp + edtNewPW.caption + "★" 'v0003
			'	else
			'		'g_sSendData = g_sSendDataTmp + Form.GetEncData(edtNewPW.caption) + "★"
			'		l_sSendData = g_sSendDataTmp + Form.GetEncData(edtNewPW.caption) + "★" 'v0003
			'	end if
			'	'Form.ShowAlert("jsi알림NEW", l_sSendData )
			'	Form.OpenPopup("mhetc90060_pi", "", "")
			'Else
			'	g_sRetData = "ok"
			'	Form.CloseForm( )
			'End If
		end if
	
	' 인증서 선택 팝업
	elseif sKeyName == "mhetc90020_pi"  then
		'Form.ShowAlert("jsi", g_CustNum)
		g_mhetc90020_pi_val = sRet
		Form.SetSharedData("90060_ChangePwd", "ChangePwd" & "★" & g_mhetc90020_pi_val & "★" & g_CustNum)
		if sRet == "0" or sRet == 0 then '공동인증
			l_cert_dn = Form.GetSharedData("CERT_DN" , false)
			'Form.ShowAlert("jsi 알림", l_cert_dn)
			if l_cert_dn == "" then	
				Form.MsgBox("알림", "인증서 정보가 등록되어 있지 않습니다.", "", 0)
				exit sub
			else
				procSelectedCert(l_cert_dn)	
			end if
		elseif sRet == "3" or sRet == 3 then '바이오인증
			'-----------------------------------------------------------------------
			'바이오인증앱 설치 판단
			'-----------------------------------------------------------------------
			BioInstalled_YN = Form.GetKftcBioInstalled()

			if BioInstalled_YN == "0" then '0 : 설치안됨, 1 : 설치됨
				Form.setKftcBioInstalled() 'FIDO 설치
				exit sub
			else
				Form.requestKftcBio("Bio_401","","90020pb")
			end if

		elseif sRet == "5" or sRet == 5 then '사설인증
			'-----------------------------------------------------------------------
			'발급여부 판단
			'-----------------------------------------------------------------------
			ATON_GETALLINFO = Form.requestAtonAuth("ATON_GETALLINFO", "", "")
			ATON_GETALLINFO_ARR = Split(ATON_GETALLINFO, "★")
			
			g_SBAlias 	= ATON_GETALLINFO_ARR[3] '인증서일련번호(식별자)
			'g_CustNum 	= Form.GetSharedData("&CUST_NUM", false)
			g_DeviceId	= Form.GetDeviceID2()
			if g_SBAlias = "" then 
				Form.MsgBox("알림", "인증서 정보가 등록되어 있지 않습니다.", "", 0)
				exit sub
			else
				procRequestAtonTR_INQUIRYCERT()
			end if 
			
		end if
		
		
		
		
	elseif sKeyName == "mhetc90060_p5"  then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData("obcsb_efif_210a") 
			
		else
			Form.MsgBox("알림", "인증서 정보가 등록되어 있지 않습니다.", "", 0)
		end if
		
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
End Sub

