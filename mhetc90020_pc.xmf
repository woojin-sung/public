Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_comm_004r" then
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "ELFN_ID" , 0 , g_szList(1) )
	end if
	
	if szTranID = "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "ELFN_ID" , 0 , g_szList(1) )	
	end if 
	
     'v0001 비밀번호 유효성 검증체크
	if szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "4" )	 '4.[MTS] HTSID비밀번호 재설정시 체크(mhetc90020_pc)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , g_szList(2) )  '계좌번호 (프로그램내에서 실명번호 조회위해 필수 설정)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , g_szList(1) )  'ID
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDBF_PWD_PIP", 0 , "" 			     )  '현재비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , edtNewPW.caption2    )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , edtNewPWChk.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""	         )  '실명확인번호(서비스에서조회)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
	end if

	'ID등록요청
	if szTranID == "obcsb_efif_210a" then	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" , 0 , edtNewPW.caption )
	end if
	if szTranID == "obcsb_efif_060a" then	
		DATAMANAGER.SetUserID("meritz")		'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(2) )
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(10) )
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" , 0 , g_szList(8) )  'v0004 RCNO->RCNO_PIP mhetc90020_p5에서 암호화된정보로 넘어옴
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" , 0 , g_szList(7) )
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(11) )
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" , 0 , g_szList(12) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(3) )
		'v0004 DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" , 0 , g_RcnoPip )  'v0004 RCNO->RCNO_PIP mhetc90020_p5에서 암호화된정보로 넘어옴
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" , 0 , g_CustClsCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" , 0 , edtNewPW.caption2 )
	end if
	
	if szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_szList(2))
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_comm_004r" then
		g_szJuminNum = DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "RCNO" , 0)
		
		'v0001 연락처정보 설정
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
		if g_plain_rm == "1" then
			
			DATAMANAGER.RequestTranData("obacp_comm_058r")
		else
			if Pw_Check(edtNewPW) == True then		'비밀번호 적합성 검사
				'고객정보조회 호출
				DATAMANAGER.RequestTranData("obcsb_acif_000r")
				'DATAMANAGER.RequestTranData("obcsb_oimf_520r")	'개인별보안매체상태조회
			end if
		end if
	end if
	
	'v0001 메모리평문 적용시, ID비밀번호유효성체크
	if szTranID == "obacp_comm_058r" then
		
		'고객정보조회 호출
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
		'DATAMANAGER.RequestTranData("obcsb_oimf_520r")	'개인별보안매체상태조회
	end if

	'보안매체종류 조회
	if szTranID == "obcsb_oimf_520r" then	
		Dim sResult
		'0: 보안카드 / 1: 부가정보 / 2: otp,보안카드,부가정보 없음 / 3: otp / 9: 기타오류
		sResult = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0)
		'보안카드, 부가정보, OTP
		if sResult == "0" or sResult == "1" or sResult == "3" then		
			Call MoveNextPage(sResult)		'다음 페이지로
		elseif sResult == "2" then 
			'로그아웃성 페이지 = 법인은 기존 팝업 그대로 세팅
			'Form.ShowAlert("g_CustClsCode" , g_CustClsCode)
			if g_CustClsCode == "1" then 
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			else 
				Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			end if
		else 
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if	
		
		'고객정보조회 호출
		'DATAMANAGER.RequestTranData("obcsb_acif_000r")
	end if
	
	if szTranID = "obcsb_acif_000r" then
		g_CustNum = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_000r", "OutBlock1", "CSNO" , 0)
		g_RcnoPip = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_000r", "OutBlock1", "RCNO_PIP" , 0)
		g_CustClsCode = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_000r", "OutBlock1", "CUST_CLS_CODE" , 0)
		
		DATAMANAGER.RequestTranData("obcsb_oimf_520r")	'개인별보안매체상태조회
	end if 
	if szTranID == "ohhts_pauth_004" then
		DcrdGbn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_STTS_DCD", 0) '인증서상태구분코드 (10. 발급, 50. 폐기)

		'등록된 간편인증 O
		if DcrdGbn == "10" then
			'Form.SetSharedData("90060_ChangePwd", "ChangePwd" & "★" & g_mhetc90020_pi_val)
			Form.OpenFramePopup( "mhetc90060_p5" , l_sSendData , sPosInfo)	'공인인증서 인증 화면 팝업
		'등록된 간편인증 X
		else
			Form.MsgBox("알림", "인증서 정보가 등록되어 있지 않습니다.", "NO_AUTH", 0)
		end if
		
	end if
	
	if szTranID == "obcsb_fido_005r" then
	
		for i = 0 to DATAMANAGER.GetDataCount(0 , szTranID, "OutBlock1") - 1
			sTERM_OS_CODE			= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TERM_OS_CODE" 		, i) 	'단말OS '1.안드로이드 2.iOS
			sTERM_ID				= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TERM_ID" 			, i) 	'단말ID
			sATHN_TCHN_CODE		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ATHN_TCHN_CODE" 		, i) 	'인증기술코드 100, 116
			sBIO_ATHN_STAT_CODE	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "BIO_ATHN_STAT_CODE" 	, i) 	'바이오인증상태코드 1.등록 2.재등록 3.해지
			sCHAN_TYPE_CLS_CODE	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CHAN_TYPE_CLS_CODE" 	, i)		'채널유형코드

			if sATHN_TCHN_CODE == "100" and sBIO_ATHN_STAT_CODE <> "3" then
				g_005r_bFinger = true
			elseif sATHN_TCHN_CODE == "116" and sBIO_ATHN_STAT_CODE <> "3" then
				g_005r_bPin = true
			end if
			
		next
	
		if g_005r_bFinger == false or g_005r_bPin == false then
			if  DATAMANAGER.IsMoreNextData( szTranID ) == true then 
				DATAMANAGER.RequestNextData( szTranID )
				exit sub
			end if
		end if

		Dim sYN
		if g_005r_bFinger == true and g_005r_bPin == true then
			sYN = "Y"
		elseif g_005r_bFinger == true then
			sYN = "Y"
		elseif g_005r_bPin == true then
			sYN = "Y"
		else '등록정보없음
			sYN = "N"
		end if
		
		'등록정보있음
		if sYN == "Y" then
			'Form.SetSharedData("90060_ChangePwd", "ChangePwd" & "★" & g_mhetc90020_pi_val)
			Form.OpenFramePopup( "mhetc90060_p5" , l_sSendData , sPosInfo)	'공인인증서 인증 화면 팝업
		'등록정보없음
		else
			Form.MsgBox("알림", "인증서 정보가 등록되어 있지 않습니다.", "NO_AUTH", 0)
			exit sub
		end if
		
	end if
	
	if szTranID = "obcsb_efif_210a" then
		g_sRetData = "ok"
		Form.MsgBox("알림", "ID비밀번호 재설정이 완료되었습니다.", "COMPLETE", 0)
			
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	if sKeyName == "NO_AUTH" or sKeyName == "COMPLETE" then
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub procRequestAtonTR_INQUIRYCERT()
	sTranID = "ohhts_pauth_004"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO"				, 0 , g_SBAlias)		'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNum)		'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
		
	DATAMANAGER.RequestTranData(sTranID)
End Sub

'============================================================================
Sub Form_OnTriggerEventBio(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	
	if #sRet > 1 then
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
	else
		exit sub
	end if
		
	if #sRet > 2 then
		sBioRet = Form.KBase64Decoding(sRet[2])
		sBioItemRet = Split(sBioRet, "★")
	end if	
	
	if sEventName == "90020pb_Bio_402" Then		
		g_sBIOTermID	= Form.getKftcBioDeviceID(); 'Bio_401 을 태우면 Bio_402 리턴할때 getKftcBioDeviceID()를 통해서 Device ID를 가져올 수 있다.(앱에서 처리중)

		ProcRequsetBioRegInfo()
	end if
	
End Sub

'============================================================================
'20220805_01 KBC : 로그인개선
'바이오인증 등록정보 조회
Sub ProcRequsetBioRegInfo()
	g_005r_bFinger	= false
	g_005r_bPin		= false
	'sID 				= Form.GetEnvData("login.input.userid")
	sOsType 			= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	DATAMANAGER.SetDataValue(0, "obcsb_fido_005r", "InBlock1", "ELFN_ID",		0, g_szList(1)) 
	DATAMANAGER.SetDataValue(0, "obcsb_fido_005r", "InBlock1", "TERM_OS_CODE",	0, sOsType) '1.안드로이드 2.iOS
	DATAMANAGER.SetDataValue(0, "obcsb_fido_005r", "InBlock1", "TERM_ID",		0, g_sBIOTermID) 
		
	DATAMANAGER.RequestTranData("obcsb_fido_005r")
End Sub

'============================================================================
Sub procSelectedCert(sDN)
	Dim sCertCnt, sCalDate 
	Dim bFind
	
	sCertCnt	= Form.GetCertListSize()
	sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
	sCalDate	= Left(sCalDate, 8)
	bFind	= false
	
	'Form.ShowAlert("jsi 알림 sCertCnt", sCertCnt)
	if sCertCnt ~= null and sCertCnt ~= "" then
		if CInt(sCertCnt) > 0 then
			Dim sCertInfo, sTemp, sDate

			for i = 0 to CInt(sCertCnt)-1
				sCertInfo = Form.GetCertListDataAt(i)
				sTemp = Split(sCertInfo, ";")
				
				if #sTemp > 7 then
					'sTemp[0] 성명
					'sTemp[1] DN
					'sTemp[2] 종류(범용개인)
					'sTemp[3] 발급기관
					'sTemp[5] 사용가능여부(가능1)
					'sTemp[6] 만기일
					'sTemp[7] 시작일
					'Form.ShowAlert("jsi 알림 sTemp", sTemp[1])
					if sTemp[1] == sDN then
						'Form.ShowAlert("jsi 알림 ", "들어오나?")
						bFind = true
					end if
				end if
			next
		end if
	end if
	
	if bFind == false then
		Form.MsgBox("알림", "인증서 정보가 등록되어 있지 않습니다.", "", 0)
	else
		Form.OpenFramePopup( "mhetc90060_p5" , l_sSendData , sPosInfo)	'공인인증서 인증 화면 팝업
	end if	
End Sub		

