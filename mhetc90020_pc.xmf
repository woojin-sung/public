'============================================================================
' 01. 화 면 명 : ID비밀번호변경
' 02. 화면설명 : ID비밀번호변경
' 03. 작    성 : 2016. 01. 28. 유창재
' 2020.10.12 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
'            ; 비밀번호컨트롤속성 '일반비밀번호'=>'계좌/거래비밀번호사용'으로 변경
' 2021.05.27 : 정민영 : v0002 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
' 2023.02.01 : 전상일 : v0003 : 공유변수 누적 문제 수정
' 2023.11.07 : 양현정 : v0004 : obcsb_efif_060a 없는 io매핑삭제
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************

Dim g_sRetData
Dim g_sPopupFileName
Dim g_sSendData
Dim g_sSendDataTmp
Dim g_szList			'g_sSendData Split Array
Dim g_plain_rm  		'v0001 메모리평문적용여부
Dim g_HomeNo  	     'v0001 자택전화번호
Dim g_ClphNo			'v0001 휴대전화번호
Dim g_WorkNo			'v0001 직장전화번호

Dim l_sSendData        'v0003 l_sSendData (모바일otp용)
'g_szList(0) : "ChangePswd"
'g_szList(1) : 사용자ID
'g_szList(2) : 계좌번호

Dim g_mhetc90020_pi_val

' 사설인증 발급여부 판단 ------------------------------------------------------------
Dim g_SBAlias, g_CustNum, g_DeviceId
' 사설인증 발급여부 판단 ------------------------------------------------------------

' 바이오인증 발급여부 판단 ------------------------------------------------------------
Dim g_sBioReg				'00 : 공동앱 설치안됨
						'01 : 등록정보없음
						'10 : 등록정보있음 (ALL, 최종지문)
						'11 : 등록정보있음 (ALL, 최종PIN)
						'12 : 등록정보있음 (ALL, 최종모름)
						'20 : 등록정보있음 (지문)
						'21 : 등록정보있음 (PIN)
g_sBioReg = "12"

Dim g_005r_bFinger
Dim g_005r_bPin
Dim g_sBIOTermID
Dim g_RcnoPip , g_CustClsCode
Dim l_cert_dn
' 바이오인증 발급여부 판단 ------------------------------------------------------------

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
'다음 페이지로
'sGubn : 지점개설계좌ID등록인 경우 보안매체종류, 은행개설계좌ID등록인 경우 ""
Sub MoveNextPage(sGubn)
	
	mOTPYN = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0)
	if sGubn == "0" then			'보안카드
		g_sPopupFileName = "mhetc90060_p9" 
	elseif sGubn == "1" then		'부가정보
		g_sPopupFileName = "mhetc90060_pa" 
	elseif sGubn == "3" then		'OTP
		If mOTPYN == "M" Then
			g_sPopupFileName = "mhetc90060_motp" 
		Else
			g_sPopupFileName = "mhetc90060_pb" 
		End If
	end if
	
	'v0001 
	If mOTPYN == "M" Then
		g_sSendDataTmp = g_sSendData
		'Form.ShowAlert("jsi알림 SendDataTmp", g_sSendDataTmp )	
		'g_sSendData = "motp_success"
		l_sSendData = "motp_success" 'l_sSendData(모바일 otp용)
	Elseif g_plain_rm == "1" then
		g_sSendData = g_sSendData + edtNewPW.caption + "★"
		'l_sSendData = l_sSendData + edtNewPW.caption + "★"
		
	else
		g_sSendData = g_sSendData + Form.GetEncData(edtNewPW.caption) + "★"
		'l_sSendData = l_sSendData + Form.GetEncData(edtNewPW.caption) + "★"
	end if
	'Form.ShowAlert("jsi알림 g_sSendData", g_sSendData )	
	If mOTPYN == "M" Then
		'Form.OpenPopup( g_sPopupFileName , l_sSendData , sPosInfo)
		Form.SetSharedData("IdRegPros"    , "Y")
		Form.SetSharedData("IdRegProsAcno", g_szList(2))	
		Form.OpenPopup( g_sPopupFileName , "motp_success" , sPosInfo)
	else 
		Form.OpenPopup( g_sPopupFileName , g_sSendData , sPosInfo)
	end if
	
	'Form.ShowAlert("알림", g_sSendData)
End Sub

'============================================================================
' Pw_Check(szPW) : 비밀번호 조건 체크
'============================================================================
Function Pw_Check(szPW)
	
	if edtNewPW.caption <> edtNewPWChk.caption then
		Form.MsgBox("알림", "신규비밀번호와 비밀번호확인이 일치하지 않습니다.", 0, 6)
		edtNewPW.caption = ""
		edtNewPWChk.caption = ""
		return False
	end if
	
	Str_Chk(edtNewPWChk.caption)
	
	if g_bNewPW == False then		'영문+숫자+특수문자 혼합 필수 , 8~12자리 
		Form.MsgBox("알림", "비밀번호가 영문+숫자+특수문자 조합이 아니거나 자릿수 8~12 자리가 아닙니다.", 0, 6)
		edtNewPW.caption = ""
		edtNewPWChk.caption = ""
		return False
	end if

'	if edtNewPW.caption == edtNowPW.caption then
'		Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(기존 비밀번호와 동일)", 0, 6)
'		edtNewPW.caption = ""
'		edtNewPWChk.caption = ""
'		return False
'	end if

	for i = 1 to Len(edtNewPWChk.caption) - 3		'주민등록번호와 비교
		Dim szEdit, szJoomin
		szEdit = mid( edtNewPWChk.caption , i , 4)
		for j = 1 to Len( g_szJuminNum ) - 3
			szJoomin = mid( g_szJuminNum , j , 4 )
			if szEdit == szJoomin then
				Form.MsgBox( "알림" , "유효하지 않은 비밀번호입니다.", 0, 6 )
				edtNewPW.caption = ""
				edtNewPWChk.caption = ""
				return False
			end if
		next
	next
		
	for i = 1 to Len(edtNewPWChk.caption) - 3 ' 연속된 3자리 숫자, 동일 숫자
		if Asc(mid( edtNewPWChk.caption, i, 1 )) = Asc(mid(edtNewPWChk.caption,i+1,1)) + 1 and Asc(mid(edtNewPWChk.caption,i+1,1)) = Asc(mid(edtNewPWChk.caption,i+2,1)) + 1 then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			edtNewPW.caption = ""
			edtNewPWChk.caption = ""
			return False
		elseif Asc(mid(edtNewPWChk.caption,i,1)) = Asc(mid(edtNewPWChk.caption,i+1,1)) - 1 and Asc(mid(edtNewPWChk.caption,i+1,1)) = Asc(mid(edtNewPWChk.caption,i+2,1)) - 1 then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			edtNewPW.caption = ""
			edtNewPWChk.caption = ""
			return False
		elseif Asc(mid(edtNewPWChk.caption,i,1)) = Asc(mid(edtNewPWChk.caption,i+1,1)) and Asc(mid(edtNewPWChk.caption,i+1,1)) = Asc(mid(edtNewPWChk.caption,i+2,1)) then
			Form.MsgBox("알림", "3자리 이상 연속된 숫자/문자/동일문자를 사용하는 비밀번호입니다.", 0, 6)
			edtNewPW.caption = ""
			edtNewPWChk.caption = ""
			return False
		end if
	next

'	if Len(cmbAcnt.caption) > 4 then
'		for i = 1 to Len(edtNewPWChk.caption) - 3		'계좌번호와 비교
'			Dim szAcnt
'			szEdit = mid(edtNewPWChk.caption,i,4)
'			for j = 1 to Len(cmbAcnt.caption) - 3
'				szAcnt = mid(cmbAcnt.caption,j,4)
'				if szEdit == szAcnt then
'					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(계좌번호와 4자리 이상 일치)", 0, 6)
'					edtNewPW.caption = ""
'					edtNewPWChk.caption = ""
'					Exit Function
'				end if
'			next
'		next
'	end if
'	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'휴대폰번호와 비교
			Dim szPhone
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) - 3
				szPhone = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0),j,4)
				if szEdit == szPhone then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(휴대폰번호와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					return False
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'자택번호와 비교
			Dim szHome
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) - 3
				szHome = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0),j,4)
				if szEdit == szHome then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(자택번호와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					return False
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'직장번호와 비교
			Dim szWorkTel
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) - 3
				szWorkTel = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0),j,4)
				if szEdit == szWorkTel then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(직장번호와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					return False
				end if
			next
		next
	end if
	
	if Len(g_szList(1)) > 4 then
		for i = 1 to Len(edtNewPWChk.caption) - 3		'로그인 아이디와 비교
			Dim szEdit, szLoginID
			szEdit = mid(edtNewPWChk.caption,i,4)
			for j = 1 to Len(g_szList(1)) - 3
				szLoginID = mid((g_szList(1)),j,4)
				if szEdit == szLoginID then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인ID와 4자리 이상 일치)", 0, 6)
					edtNewPW.caption = ""
					edtNewPWChk.caption = ""
					return False
				end if
			next
		next
	end if
'	
''	if Len(Form.GetSharedData("&USER_PWD", false )) > 4 then
'	if Len(edtNowPW.caption) > 4 then
'		for i = 1 to Len(edtNewPWChk.caption) - 3		'로그인 비밀번호와 비교
'			Dim szEdit, szLoginPW
'			szEdit = mid(edtNewPWChk.caption,i,4)
'				for j = 1 to Len(edtNowPW.caption) - 3
'				szLoginPW = mid((edtNowPW.caption),j,4)
''				for j = 1 to Len(Form.GetSharedData("&USER_PWD", false )) - 3
''				szJoomin = mid((Form.GetSharedData("&USER_PWD", false )),j,4)
'				if szEdit == szLoginPW then
'					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인 비밀번호와 4자리 이상 일치)", 0, 6)
'					edtNewPW.caption = ""
'					edtNewPWChk.caption = ""
'					return False
'				end if
'			next
'		next
'	end if
	
	return True
	
End Function
'============================================================================
' Str_Chk(str) : 입력 비밀번호 유효성 체크
'============================================================================

'한글 입력, 기럭지 체크
'리턴 : 영+숫, 기럭지 8 ~ 12 = True
'       한글, 기럭지 꽝 	= False
Function Str_Chk(str)	
	dim i						'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크 '20150309_01 KBC
    
	chk_n = 0
	chk_c = 0
	chk_t = 0
    
    if Len(str) < 8 or 12 < Len(str) then
		g_bNewPW = False
		exit Function
	end if
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
	    
	    if nAscii < 0 then			'한글 일때
		    g_bNewPW = False
		    exit Function			'한글 기럭지 2
		else						'영, 숫, 특 일때    '20130125 lkm 영문+숫자 혼합 규칙 → 영문+숫자(필수), 특수문자(선택) 가능 으로 변경 
		    '48~57 : 0~9
		    '65~90 : A~Z
		    '97~122: a~z
		    '
		    If nAscii >=48 and nAscii <=57 Then 
			    chk_n = 1 	
			Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
			    chk_c = 1 
		    '20150309_01 KBC START
		    '특수문자 확인 부분
		    Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
			    chk_t = 1 
		    '20150309_01 KBC END
		    End if 		    
		end if
	Next
    
	If ((chk_n + chk_c + chk_t) < 3) Then  '20150309_01 KBC
		g_bNewPW = False
		exit Function
	End if
	
	g_bNewPW = True
End Function
