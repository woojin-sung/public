'============================================================================
' 휴대폰 인증번호 재요청
'============================================================================
Sub contMain_btnAthnRetry_OnClick()
    nTop = 0
    nContResize = 0

   'If contMain.chkCtcnAgrm.checkstate == "0" Or contMain.chkCtcnAgrm.checkstate == 0 Then  '0.uncheck 1.check
   '     'contMain.edtAthnNo.SetResultLabel("1","error","휴대폰 본인인증 약관동의를 하지 않으셨습니다.","contMain")
   '    Form.ShowAlert("오류", "휴대폰 본인인증 약관동의를 하지 않으셨습니다.")
   '    exit sub
   'End If
    If CheckData() = True Then
        contMain.edtAthnNo.SetResultLabel("0","complete","","contMain")

        '기존 인증번호 Clear
        contMain.edtAthnNo.caption = ""
        contMain.edtAthnNo.enable  = True

        '타이머 초기화
        InitCountTimer()

        '기 인증처리 중인 전문정보 초기화
        edtRqstTlmsNo.caption  = ""
        edtVrfcTlmsNo.caption  = ""

        '재요청버튼 비활성화/숨김
        'contMain.btnAthnRetry.enable  = False
        contMain.btnAthnRetry.visible  = False

        '테스트용 인증서 Skip
         If CInt(chkSkip.checkstate) == 1 Then
			'확인버튼 활성화
               btnNext.visible = True
		
               btnNext.btnimage = "btn_20.9"
               btnNext.fgcolor = "273"				
         Else
              '인증번호 요청
               DATAMANAGER.RequestTranData( "obcsb_oimf_653a" )
         End If
	 
    End If
    
End Sub

'============================================================================
' 테스트인증Skip
'============================================================================
Sub chkSkip_OnChange(sCheckState)
    If g_nDev == "1" Or g_nDev == 1 Then  '개발서버인 경우에만 동작하도록.
        '휴대폰 본인인증 약관동의 & 테스트인증Skip 해제한 경우, 인증처리 할수 있도록 인증요청버튼 활성화 처리
        If contMain.chkCtcnAgrm.checkstate == "1" Or contMain.chkCtcnAgrm.checkstate == 1 Then
           '타이머이벤트 모두 종료
            User_Stop_Timer()

            If CInt(chkSkip.checkstate) == 1 Then
               '확인버튼 활성화
                btnNext.visible = True

                btnNext.btnimage = "btn_20.9"
                btnNext.fgcolor = "273"
            Else
               '확인버튼 비활성화
                btnNext.visible = False
		
                If Form.GetEnvData("common.theme") = "black" Then
				btnNext.btnimage = "btn_27.9"
                Else 
				btnNext.btnimage = "btn_21.9"
                End If
                btnNext.fgcolor = "269"	
            End If
        Else
            '확인버튼 비활성화
            btnNext.visible = False
	    
            If Form.GetEnvData("common.theme") = "black" Then
			btnNext.btnimage = "btn_27.9"
            Else 
			btnNext.btnimage = "btn_21.9"
            End If
            btnNext.fgcolor = "269"	    
        End If
    End If
End Sub

