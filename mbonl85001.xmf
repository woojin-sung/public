	Dim szData
	szData = Form.GetSharedData("MeritzAuth_FindAcnt", true)
	
	if szData == "Y" then
		Form.OpenNextPopup("mhetc90190_s1", "", "")	
	else
		Form.CloseForm()
	end if

End Sub

