	<SCRIPT_INFO _len="1974" _ulen="1870" >
'============================================================================
' 01.화면명 	: 오픈뱅킹 개인정보동의
' 02.화면설명	: 오픈뱅킹 개인정보동의
' 03.작성	: 2020.10.07
' 04.수정	: 
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet	'리턴값
g_szRet	=	"0"

Dim g_URLheader
Dim g_ServerMode

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
		g_URLheader = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/"
	Else
		g_URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	End If
	WebView0.viewtype = 0
	WebView0.urlpath = g_URLheader & "crinoferagrm3.pdf"
	
	Form.SetScreenName("개인(신용)정보수집/이용/제공 동의서")
	
End Sub

'============================================================================
'BtnOK_OnClick
'============================================================================
Sub BtnOK_OnClick()
	g_szRet	=	"1"
	Form.CloseForm()
End Sub


'============================================================================
'BtnCancel_OnClick
'============================================================================
Sub BtnCancel_OnClick()
	g_szRet	=	"0"
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("MBBNK62002_T3" , g_szRet)
End Sub






	</SCRIPT_INFO>
</ROOT>