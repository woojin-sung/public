	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="-1,-1,375,560,1" />
		<BUTTON name="BtnCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,561,187,45,1" />
		<BUTTON name="BtnOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,561,188,45,1" />
