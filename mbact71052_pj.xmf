			End If
			
			If CDbl(g_tData[4]) > 0 Then
				contA.tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[4], 2))
				contA.tbl1.SetCellFgColor(1, 1, "1")
			ElseIf CDbl(g_tData[4]) < 0 Then
				contA.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 2))
				contA.tbl1.SetCellFgColor(1, 1, "2")
			Else
				contA.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 2))
			End If
			
'			contA.tbl1.SetCellString(1, 1, g_tData[4])
			contA.tbl3.SetCellString(0, 1, g_tData[5])
'			contA.tbl3.SetCellString(1, 1, g_tData[6])
'			contA.tbl3.SetCellString(2, 1, g_tData[7])
			contA.tbl3.SetCellString(1, 1, g_tData[7])
			
			'20230925 현재가, 기준가 추가
			if CInt(g_tData[11]) == 0 then
				contA.tbl3.SetCellString(2, 1, "-")
			else
				contA.tbl3.SetCellString(2, 1, FormatNumber(g_tData[11], 0) .. "원")
			end if
			
			contA.tbl2.SetCellString(0, 1, g_tData[8])
			contA.tbl2.SetCellString(1, 1, g_tData[9])
			
			'Pick 상품인지 판단
			Dim szCode
			szCode = g_tData[10]
			If szCode <> "" And szCode <> null Then
				DATAMANAGER.SetDataValue( 0, "obsac_deal_211r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2" )
				DATAMANAGER.SetDataValue( 0, "obsac_deal_211r" , "InBlock1" , "ISCD" , 0 , szCode )
				DATAMANAGER.RequestTranData( "obsac_deal_211r" )
			End If
		
		Case "C"		'MMW
			contC.lblName.caption = g_tData[1]
			
			contC.tbl0.SetCellString(0, 2, g_tData[2])
			contC.tbl1.SetCellString(0, 1, g_tData[3])
			
		Case "E"		'해외뮤츄얼펀드
			contE.lblName.caption = g_tData[1]
			
			contE.tbl0.SetCellString(0, 2, g_tData[2])
			contE.tbl1.SetCellString(0, 1, g_tData[3])
			
