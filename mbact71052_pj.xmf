			contL.tbl2.SetCellString(0, 1, g_tData[4])
			contL.tbl2.SetCellString(1, 1, g_tData[5])
			contL.tbl2.SetCellString(2, 1, g_tData[6])
		
		Case "M"		'발행어음
			
			
			'발행어음 잔고 조회
			DATAMANAGER.RequestTranData( "obsan_deal_222r" )
			
	End Select
