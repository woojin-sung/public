			End If
			
			contE.tbl3.SetCellString(0, 1, g_tData[5])
			contE.tbl3.SetCellString(1, 1, g_tData[6])
			
		Case "F"		'외화표시펀드
			contF.lblName.caption = g_tData[1]
			
			contF.tbl0.SetCellString(0, 2, g_tData[2])
