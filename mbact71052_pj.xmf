'============================================================================
Sub cont8_btnCancel_OnClick()
	Dim szSendData
	szSendData = "취소" & "★" & g_szSendData
	
	Form.OpenPopupAnimation("mbact71052_pj_popup", szSendData, "", "2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CLOSE" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "71052_p7" and sValue == "refresh" then
		Form.CloseForm()
	end if
End Sub

