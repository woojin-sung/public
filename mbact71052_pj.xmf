'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'발행어음 잔고 조회
	if szTranID == "obsan_deal_222r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Left(g_tData[1], 8))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , Right(g_tData[1], 2))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISNT_NO" , 0 , g_tData[2])
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obsac_deal_211r" Then
		Dim szIscd
		szIscd = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISCD" , 0 )
		'szIscd가 빈값이 아니면 M Pick 상품
		If szIscd <> "" And szIscd <> null Then
			contA.btnOther.visible = true
			contA.btnOK.left = 188
			contA.btnOK.width = 187
		End If
	
	'발행어음 잔고 조회
	elseif szTranID == "obsan_deal_222r" then
		'종목명
		'종목코드
		'매수금액
		'약정수익률
		'경과기간
		'약정기간
		'중도상환수익률
		'이자금액
		'제세금
		'평가금액
		'매수일자
		'만기일자
		'거래내역일련번호(매매 취소 시 사용)
		Dim szName, szCode, szBuyAmt, szPblcInt, szExprDt, szInvtDt, szAplyInt, szIntAmt, szWtaxAmt, szVltnAmt, szByovDate, szMtrtDate, szTranSrno
		szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "KOR_ISSU_ABWR_NAME" , 0)
		szCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ISCD" , 0)
		szBuyAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ACBK_AMT" , 0)
		szPblcInt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "PBLC_INRT" , 0)
		szExprDt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "EXPR_DYNU" , 0) 
		szInvtDt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "INVT_DYNU" , 0)
		szAplyInt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "APLY_INRT" , 0)
		szIntAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "INT_AMT" , 0)
		szWtaxAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "WTAX_AMT" , 0)
		szVltnAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "VLTN_AMT" , 0)
		szByovDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "BYOV_DATE" , 0)
		szMtrtDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "MTRT_DATE" , 0)
		szTranSrno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "TRAN_SRNO" , 0)
		
		cont8.lblName.caption = szName
		cont8.tbl0.SetCellString(0, 1, szVltnAmt)
		
		cont8.tbl1.SetCellString(0, 1, szBuyAmt)
		
		cont8.tbl3.SetCellString(0, 1, szByovDate)
		cont8.tbl3.SetCellString(1, 1, szMtrtDate)
		cont8.tbl3.SetCellString(2, 1, CInt(szExprDt) & "일/" & CInt(szInvtDt) & "일")
		
		cont8.tbl2.SetCellString(0, 1, szAplyInt)
		cont8.tbl2.SetCellString(1, 1, szPblcInt)
		
		'취소버튼 활성화 여부 체크
		'당일 08시에서 17시까지 가능
		Dim szOrderDate, szToday
		szOrderDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ODER_DATE" , 0)
		szToday = Form.GetSharedData("&HOST_DATE", false)
		if szOrderDate == szToday then
			Dim szTime
			szTime = Form.GetSharedData("&HOST_TIME", false)
			if CInt(szTime) >= 80000 and CInt(szTime) <= 170000 then
				cont8.btnCancel.visible = true
				cont8.lblCancelBg.visible = true
				cont8.btnSell.visible = true
			end if
		else
			cont8.btnCancel.visible = false
			cont8.lblCancelBg.visible = false
			cont8.btnSell.visible = true
			cont8.btnSell.left = 0 
			cont8.btnSell.width = 375
		end if
'		Form.ShowAlert("szOrderDate", szOrderDate)
		
		
		'발행어음 취소 또는 매도에 사용
		g_szSendData = g_tData[1] & "★" & g_tData[2] & "★" & szName & "★" & szCode & "★" & szBuyAmt & "★" & szPblcInt & "★" & szExprDt & "★" & 
					szInvtDt & "★" & szAplyInt & "★" & szIntAmt & "★" & szWtaxAmt & "★" & szVltnAmt & "★" & szByovDate & "★" & szMtrtDate & "★" & szTranSrno
	End If
End Sub

'============================================================================
Sub contA_btnOther_OnClick()
	Dim szScreenNo
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	If szScreenNo <> "71052" Then
		Form.SendReturnToParent("close" , "")
	End If
	
	Form.OpenNextPopup("mbonl88060", "", "")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont8.imgClose.setMaintainingRatio("1")
End Sub

'발행어음 매도/취소 추가
