	<SCRIPT_INFO _len="17768" _ulen="17050" >

Dim g_tData
Dim g_szSendData

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("szOpenData", szOpenData)
		g_tData = Split(szOpenData, "☆")
		
		'상품코드를 보고 맞는 컨테이너를 보임
		f_SetScreenData(g_tData[0]) 
	End If
End Sub

'============================================================================
Function f_SetScreenData(szCode) 
	Form.SetCtlProp("cont" & CStr(szCode), "left", 0)
	
	'발행어음 예외처리
	if szCode == "M" then
		cont8.left = 0
	end if
	
	'항목중 평가손익 또는 수익률 항목이 있는 경우 색상 및 마스킹 처리 별도로 함
	Select Case CStr(szCode)
		Case "7"		'RP
			cont7.lblName.caption = g_tData[1]
			
			cont7.tbl0.SetCellString(0, 2, g_tData[2])
			cont7.tbl1.SetCellString(0, 1, g_tData[3])
			cont7.tbl3.SetCellString(0, 1, g_tData[4])
			cont7.tbl3.SetCellString(1, 1, g_tData[5])
			cont7.tbl2.SetCellString(0, 1, g_tData[6])
			cont7.tbl2.SetCellString(1, 1, g_tData[7])
			cont7.tbl2.SetCellString(2, 1, g_tData[8])
		
		Case "8"		'발행어음
'			cont8.lblName.caption = g_tData[1]
'			
'			cont8.tbl0.SetCellString(0, 2, g_tData[2])
'			cont8.tbl1.SetCellString(0, 1, g_tData[3])
'			cont8.tbl3.SetCellString(0, 1, g_tData[4])
'			cont8.tbl3.SetCellString(1, 1, g_tData[5])
'			cont8.tbl2.SetCellString(0, 1, g_tData[6])
'			cont8.tbl2.SetCellString(1, 1, g_tData[7])
'			cont8.tbl2.SetCellString(2, 1, g_tData[8])
			
			'발행어음 잔고 조회
			DATAMANAGER.RequestTranData( "obsan_deal_222r" )
			
		Case "9"		'신탁
			cont9.lblName.caption = g_tData[1]
			
			cont9.tbl0.SetCellString(0, 2, g_tData[2])
			cont9.tbl1.SetCellString(0, 1, g_tData[3])
'			cont9.tbl1.SetCellString(1, 1, g_tData[4])
'			cont9.tbl1.SetCellString(2, 1, g_tData[5])
			
			'평가손익, 수익률 마스킹 처리
			If CDbl(g_tData[4]) > 0 Then
				cont9.tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[4], 0))
				cont9.tbl1.SetCellFgColor(1, 1, "1")
			ElseIf CDbl(g_tData[4]) < 0 Then
				cont9.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 0))
				cont9.tbl1.SetCellFgColor(1, 1, "2")
			Else
				cont9.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 0))
			End If
			
			If CDbl(g_tData[5]) > 0 Then
				cont9.tbl1.SetCellString(2, 1, "+" & FormatNumber(g_tData[5], 2))
				cont9.tbl1.SetCellFgColor(2, 1, "1")
			ElseIf CDbl(g_tData[5]) < 0 Then
				cont9.tbl1.SetCellString(2, 1, FormatNumber(g_tData[5], 2))
				cont9.tbl1.SetCellFgColor(2, 1, "2")
			Else
				cont9.tbl1.SetCellString(2, 1, FormatNumber(g_tData[5], 2))
			End If
			
		Case "A"		'CD/CP/전단채
			contA.lblName.caption = g_tData[1]
			
			contA.tbl0.SetCellString(0, 2, g_tData[2])
			'평가손익, 수익률 마스킹 처리
