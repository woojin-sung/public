				contF.tbl1.SetCellString(0, 1, "+" & FormatNumber(g_tData[3], 0))
				contF.tbl1.SetCellFgColor(0, 1, "1")
			ElseIf CDbl(g_tData[3]) < 0 Then
				contF.tbl1.SetCellString(0, 1, FormatNumber(g_tData[3], 0))
				contF.tbl1.SetCellFgColor(0, 1, "2")
			Else
				contF.tbl1.SetCellString(0, 1, FormatNumber(g_tData[3], 0))
			End If
			
			If CDbl(g_tData[4]) > 0 Then
				contF.tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[4], 2))
				contF.tbl1.SetCellFgColor(1, 1, "1")
			ElseIf CDbl(g_tData[4]) < 0 Then
				contF.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 2))
				contF.tbl1.SetCellFgColor(1, 1, "2")
			Else
				contF.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 2))
			End If
			
			contF.tbl3.SetCellString(0, 1, g_tData[5])
			contF.tbl3.SetCellString(1, 1, g_tData[6])
		
		Case "J"		'외화RP
			contJ.lblName.caption = g_tData[1]
			
			contJ.tbl0.SetCellString(0, 2, g_tData[2])
			contJ.tbl1.SetCellString(0, 1, g_tData[3])
'			contJ.tbl1.SetCellString(1, 1, g_tData[4])
			
			'평가손익, 수익률 마스킹 처리
