				contJ.tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[4], 0))
				contJ.tbl1.SetCellFgColor(1, 1, "1")
			ElseIf CDbl(g_tData[4]) < 0 Then
				contJ.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 0))
				contJ.tbl1.SetCellFgColor(1, 1, "2")
			Else
				contJ.tbl1.SetCellString(1, 1, FormatNumber(g_tData[4], 0))
			End If
			
			contJ.tbl1.SetCellString(2, 1, g_tData[5])
			contJ.tbl3.SetCellString(0, 1, g_tData[6])
			contJ.tbl3.SetCellString(1, 1, g_tData[7])
'			contJ.tbl3.SetCellString(2, 1, g_tData[8])
			
			If CDbl(g_tData[8]) > 0 Then
				contJ.tbl3.SetCellString(2, 1, "+" & FormatNumber(g_tData[8], 2))
				contJ.tbl3.SetCellFgColor(2, 1, "1")
			ElseIf CDbl(g_tData[8]) < 0 Then
				contJ.tbl3.SetCellString(2, 1, FormatNumber(g_tData[8], 2))
				contJ.tbl3.SetCellFgColor(2, 1, "2")
			Else
				contJ.tbl3.SetCellString(2, 1, FormatNumber(g_tData[8], 2))
			End If
			
			contJ.tbl2.SetCellString(0, 1, g_tData[9])
			contJ.tbl2.SetCellString(1, 1, g_tData[10])
			contJ.tbl2.SetCellString(2, 1, g_tData[11])
		
		Case "K"		'외화채권
			contK.lblName.caption = g_tData[1]
			
			contK.tbl0.SetCellString(0, 2, g_tData[2])
			contK.tbl1.SetCellString(0, 1, g_tData[4])
			contK.tbl1.SetCellString(1, 1, g_tData[3])
			contK.tbl1.SetCellString(2, 1, g_tData[5])
			contK.tbl2.SetCellString(0, 1, g_tData[6])
			contK.tbl2.SetCellString(1, 1, g_tData[7])
		
		Case "L"		'해외파생
			contL.lblName.caption = g_tData[1]
			If Trim(g_tData[4]) == "매수" Then
				contL.lblName.changeTextAttr(0, 2, 6, 4, false)
			ElseIf Trim(g_tData[4]) == "매도" Then
				contL.lblName.changeTextAttr(0, 2, 7, 4, false)
			End If
			
			contL.tbl0.SetCellString(0, 2, g_tData[2])
'			contL.tbl1.SetCellString(0, 1, g_tData[3])
			
			'평가손익, 수익률 마스킹 처리
			If CDbl(g_tData[3]) > 0 Then
