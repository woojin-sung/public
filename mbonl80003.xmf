Dim g_szPwd
Dim g_szThcoMnno1		'당사관리번호(상장주식 등)
Dim g_szThcoMnno2		'당사관리번호(기타)

'============================================================================
Sub Form_OnFormInitBefore()
	'이미지 비율 유지
	contMain.imgToolTip1.setMaintainingRatio("1")
	contMain.imgToolTip2.setMaintainingRatio("1")
	contMain.imgToolTip3.setMaintainingRatio("1")
	contMain.imgToolTip4.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'Label 스타일 적용
	contMain.lblTitle1.changeTextAttr(0, 4, 67, 1, true)
	contMain.lblTitle2.changeTextAttr(0, 2, 67, 1, true)
	
	'버튼 스위치 적용
	contMain.btnSwitch1.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	contMain.btnSwitch2.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	
	contMain.btnSwitch1.switchindex = "1"
	contMain.btnSwitch2.switchindex = "1"
	
	'금투세 사전신청내역 조회(상장주식 등)
	DATAMANAGER.RequestTranData( "obcsb_fiin_999r" )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "CORRECT_PWD" And sRet <> "" And sRet <> Null Then
		Dim tData
		tData = Split(sRet, "★")
		If UBOUND(tData) > 0 Then
			g_szPwd = tData[0]
			
			'금투세 기본공제한도사전신청(상장주식 등)
'			DATAMANAGER.RequestTranData( "obcsb_fiin_999c" )
			
			'고객정보조회
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		End If
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	sTimerID = CInt(sTimerID)
	If sTimerID == 1000 Then
		Form.SetTimerEvent(1000, 0, 1)
		
		'금투세 기본공제한도사전신청(기타)
		DATAMANAGER.RequestTranData( "obcsb_fiin_999c_1" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNo
	szCustNo = Form.GetSharedData("&CUST_NUM", false)
	
	'금투세 사전신청내역 조회(상장주식 등 / 기타)
	If szTranID == "obcsb_fiin_999r" Or szTranID == "obcsb_fiin_999r_1" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , szCustNo)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , "2023" )
		If szTranID == "obcsb_fiin_999r" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "1")
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "2")
		End If
	
	'고객정보조회
	ElseIf szTranID == "obcsb_acif_000r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
	
	'고객연락처조회
	ElseIf szTranID == "obcsb_acad_002r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PWD" , 0 , g_szPwd)
	
	'금투세 사전신청 등록(상장주식 등 / 기타)
	ElseIf szTranID == "obcsb_fiin_999c" Or szTranID == "obcsb_fiin_999c_1" Then
		If g_szThcoMnno1 <> "" And g_szThcoMnno1 <> null And g_szThcoMnno2 <> "" And g_szThcoMnno2 <> null Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "U")
			If szTranID == "obcsb_fiin_999c" Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNNO" , 0 , g_szThcoMnno1)
			Else
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNNO" , 0 , g_szThcoMnno2)
			End If
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "I")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNNO" , 0 , "")
		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , szCustNo)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , "2023")
		If szTranID == "obcsb_fiin_999c" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "1" )
		ElseIf szTranID == "obcsb_fiin_999c_1" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "2" )
		End If
		
		Dim szFullName, szRcnoPip, szRcnoTpCode, szTelNo, szAddr
		szFullName = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r" , "OutBlock1" , "CUST_FULL_NAME" , 0)
		szRcnoPip = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r" , "OutBlock1" , "RCNO_PIP" , 0)
		szRcnoTpCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r" , "OutBlock1" , "RCNO_TYPE_CODE" , 0)
		szAddr = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r" , "OutBlock1" , "ADDR" , 0)
		szTelNo = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r" , "OutBlock3" , "ARCD" , 0) & DATAMANAGER.GetDataValue(0, "obcsb_acad_002r" , "OutBlock3" , "TONO" , 0) & DATAMANAGER.GetDataValue(0, "obcsb_acad_002r" , "OutBlock3" , "TELNO" , 0)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CUST_FULL_NAME" , 0 , szFullName )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , szRcnoPip )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO_TYPE_CODE" , 0 , szRcnoTpCode)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ADDR" , 0 , szAddr )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CNPL_TELNO" , 0 , szTelNo)
		
		If szTranID == "obcsb_fiin_999c" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_REG_AMT" , 0 , contMain.edtAmt1.caption)
			If CInt(contMain.btnSwitch1.switchindex) == 1 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "Y")
			Else
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "N")
			End If
			
		ElseIf szTranID == "obcsb_fiin_999c_1" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_REG_AMT" , 0 , contMain.edtAmt2.caption)
			If CInt(contMain.btnSwitch2.switchindex) == 1 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "Y")
			Else
				DATAMANAGER.SetDataValue(0, szTra*nID , "InBlock1" , "CROV_YN" , 0 , "N")
			End If
		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_BRCD" , 0 , "1065")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'금투세 사전신청내역 조회(상장주식 등 / 기타)
	If szTranID == "obcsb_fiin_999r" Or szTranID == "obcsb_fiin_999r_1" Then
		'상장주식 등, 기타 각각 다른 당사관리번호로 채번됨
		If szTranID == "obcsb_fiin_999r" Then
			g_szThcoMnno1 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "THCO_MNNO" , 0)
		Else
			g_szThcoMnno2 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "THCO_MNNO" , 0)
		End If
		
		'당사관리번호가 있으면 사전신청한 내역이 있다라고 봄
		If g_szThcoMnno1 <> "" And g_szThcoMnno1 <> null And g_szThcoMnno2 <> "" And g_szThcoMnno2 <> null Then
			Dim szRegAmt, szNextYn
			szRegAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BSDD_REG_AMT" , 0)
			szNextYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CROV_YN" , 0)
			
			If szTranID == "obcsb_fiin_999r" Then
				contMain.tblStock.SetCellString(1, 1, szRegAmt)
				If szNextYn == "Y" Then
					contMain.btnSwitch1.switchindex = 1
				Else
					contMain.btnSwitch1.switchindex = 0
				End If
				contMain.edtAmt1.caption = szRegAmt
			Else
				contMain.tblEtc.SetCellString(1, 1, szRegAmt)
				If szNextYn == "Y" Then
					contMain.btnSwitch2.switchindex = 1
				Else
					contMain.btnSwitch2.switchindex = 0
				End If
				contMain.edtAmt2.caption = szRegAmt
			End If
		Else
			If szTranID == "obcsb_fiin_999r" Then
				contMain.tblStock.SetCellString(1, 1, "0")
				contMain.btnSwitch1.switchindex = 1
				
				contMain.edtAmt1.caption = "0"
			Else
				contMain.tblEtc.SetCellString(1, 1, "0")
				contMain.btnSwitch2.switchindex = 1
				
				contMain.edtAmt2.caption = "0"
			End If
		End If
		
		'상장주식 데이터 다 세팅했으면 기타 데이터도 호출
		If szTranID == "obcsb_fiin_999r" Then
			'금투세 사전신청내역 조회(기타)
			DATAMANAGER.RequestTranData( "obcsb_fiin_999r_1" ) 
		End If
	
	'고객정보조회
	ElseIf szTranID == "obcsb_acif_000r" Then
		'고객연락처조회
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
	
	'고객연락처조회
	ElseIf szTranID == "obcsb_acad_002r" Then
		'금투세 기본공제한도사전신청(상장주식 등)
		DATAMANAGER.RequestTranData( "obcsb_fiin_999c" )
	
	'금투세 기본공제한도사전신청(상장주식 등)
	ElseIf szTranID == "obcsb_fiin_999c" Then
		'금투세 기본공제한도사전신청(기타)
		DATAMANAGER.RequestTranData( "obcsb_fiin_999c_1" )
	
	'금투세 기본공제한도사전신청(기타)
	ElseIf szTranID == "obcsb_fiin_999c_1" Then
		Form.MsgBox("안내", "금융투자소득 기본공제금액 신청이 완료되었습니다.", "REG_COMPLETE", 6)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> "" And szSubMsg <> Null Then
		Form.ShowAlert("알림" & szTranID, szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림" & szTranID, szErrMsg)
	End If
End Sub

'============================================================================
Function f_ClearData()
	contMain.edtAmt1.caption = ""
	contMain.edtAmt2.caption = ""
	
	contMain.btnSwitch1.switchindex = "1"
	contMain.btnSwitch1.switchindex = "1"
End Function

'============================================================================
Sub contMain_imgToolTip1_OnClick()
	Dim szText, nLen
	szText = "상장주식 등 총 한도 : 연간 합계 5천만원\n·국내상장주식등(증권시장 양도분), 공모국내주식형적격펀드(국내상장주식에 2/3 이상 투자, 국내주식형ETF 포함), K-OTC 중소,중견기업 주식"
	
	contMain.lblLen.caption = szText
	nLen = contMain.lblLen.getLen(szText)
	
	contMain.imgToolTip1.openToolTip(szText, 320, 110, 2)
	contMain.imgToolTip1.changeToolTipTextAttr(24, CInt(nLen) - 24, 62, -4, false)
End Sub

'============================================================================
Sub contMain_imgToolTip2_OnClick()
	Dim szText, nLen
	szText = "내년에도 동일하게 한도가 적용되요\n·신청한 기본공제금액이 내년에도 동일하게 자동 적용됩니다."
	
	contMain.lblLen.caption = szText
	nLen = contMain.lblLen.getLen(szText)
	
	contMain.imgToolTip2.openToolTip(szText, 290, 85, 2)
	contMain.imgToolTip2.changeToolTipTextAttr(18, CInt(nLen) - 18, 62, -4, false)
End Sub

'============================================================================
Sub contMain_imgToolTip3_OnClick()
	Dim szText, nLen
	szText = "기타 총 한도 : 연간 합계 250만원\n·해외주식, 비상장주식, 기타펀드, 파생결합증권, 파생상품, 채권 등"
	
	contMain.lblLen.caption = szText
	nLen = contMain.lblLen.getLen(szText)
	
	contMain.imgToolTip3.openToolTip(szText, 320, 85, 2)
	contMain.imgToolTip3.changeToolTipTextAttr(22, CInt(nLen) - 22, 62, -4, false)
End Sub

'============================================================================
Sub contMain_imgToolTip4_OnClick()
	Dim szText, nLen
	szText = "내년에도 동일하게 한도가 적용되요\n·신청한 기본공제금액이 내년에도 동일하게 자동 적용됩니다."
	
	contMain.lblLen.caption = szText
	nLen = contMain.lblLen.getLen(szText)
	
	contMain.imgToolTip4.openToolTip(szText, 290, 85, 1)
	contMain.imgToolTip4.changeToolTipTextAttr(18, CInt(nLen) - 18, 62, -4, false)
End Sub

'============================================================================
Sub btnReg_OnClick()
	'신청 서비스 호출 전 데이터 체크
	'신청금액 미입력 체크
	If contMain.edtAmt1.caption == "" Or contMain.edtAmt1.caption == Null Or contMain.edtAmt2.caption == "" Or contMain.edtAmt2.caption == Null Then
		Form.ShowAlert("알림", "신청금액을 입력해 주세요.")
		Exit Sub
	End If
	
	'한도보다 큰 금액 입력 체크
	If (CInt(contMain.edtAmt1.caption) > 50000000) Or (CInt(contMain.edtAmt2.caption) > 2500000) Then
		Form.ShowAlert("알림", "신청가능한도 확인 후 다시 입력해 주세요.")
		Exit Sub
	End If
	
	'계좌비밀번호 입력 후 신청 서비스 호출
	Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "REG_COMPLETE" Then
		f_ClearData()
		
		DATAMANAGER.RequestTranData( "obcsb_fiin_999r" )
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INFO_CLICK" Then
		Form.OpenFramePopup("mbonl80003_p1" , "" , "")
	End If
End Sub

