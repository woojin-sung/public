'============================================================================
Sub Edit0_OnEditComplete()

	cost = Cint(Edit0.caption)
	
	if cost>=0 and cost<25 then
	score3 = 4
	
	elseif cost >=25 and cost <50 then
	score3 = 3
	
	elseif cost >=50 and cost < 75 then
	score3 = 2
	
	elseif cost>=75 then
	score3 = 1
	
	end if
	
	Form.SetSharedData("score9", score3)
	
	if Combo0.currentindex <> "0" and Combo1.currentindex <> "0" and Edit0.caption <> "" and Edit1.caption <> "" then
		check_flag_4 = 1
		Form.SetSharedData("check_flag_4" , check_flag_4)
		
		elseif Combo0.currentindex == "0" or Combo1.currentindex == "0" or Edit0.caption == "" or Edit1.caption == "" then
		check_flag_4 = 0
		Form.SetSharedData("check_flag_4" , check_flag_4)
		
		end if
	
	
	
End Sub

