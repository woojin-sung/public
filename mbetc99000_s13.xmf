'============================================================================
Sub Combo0_OnEditComplete(iIndex)


nIndex = Combo0.currentindex

Select Case CInt(nIndex)
		Case 1
			score = 3
		Case 2
			score = 0
		End Select
		
		Form.SetSharedData("score7",score)
		
		if Combo0.currentindex <> "0" and Combo1.currentindex <> "0" and Edit0.caption <> "" and Edit1.caption <> "" then
		check_flag_4 = 1
		Form.SetSharedData("check_flag_4" , check_flag_4)
		
		elseif Combo0.currentindex == "0" or Combo1.currentindex == "0" or Edit0.caption == "" or Edit1.caption == "" then
		check_flag_4 = 0
		Form.SetSharedData("check_flag_4" , check_flag_4)
		
		end if
		
	
End Sub

