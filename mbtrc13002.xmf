'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtrc_rmnd_007r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "MANG_BRCD"     , 0 , "%"                  ) '관리지점코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"          , 0 , acnt0.total          ) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO"          , 0 , acnt0.sequence       ) '계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD"      , 0 , ""                   ) '계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "STA_DATE"      , 0 , cldFrom.caption      ) '시작일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FIN_DATE"      , 0 , cldTo.caption        ) '종료일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , rdoKind.currentindex ) '조회구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , ChkButton0.checkstate) '처리구분코드
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrc_rmnd_007r" then
	    If tonumber(grd0.rowcount) > 0 Then
		    Dim l_stnd_amt
		    Dim dl_stnd_amt
		
		    nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		    nRowCnt = grd0.rowcount - nDataCnt

   		    For i = 0 To nDataCnt - 1
		        l_stnd_amt = CLng(Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_SBSN_FEE_STND_AMT" , i)))
		        dl_stnd_amt = l_stnd_amt / 100000000
		    
		        grd0.SetCellData( "bd_cell8", nRowCnt + i, dl_stnd_amt )
	        Next
	    end if
	end if
End Sub

