'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim 	g_sMarket, g_sMCode
Dim	g_szSect		'0일땐 금액, 1일땐 수량

g_sMarket = Array("KSP", "KSQ", "K2I")
g_sMarket_Feed = Array( "8000", "9100", "8888")		'개인, 외국인, 기관

'20221117 LES START 
'거래소 차세대 업종코드 변경
'선물(F001)의 경우 내부적으로 정의해서 사용하는 코드이므로,
'차세대와는 상관없음. 원래 올리던 값으로 올리면됨.

'g_sMCode = Array("0001", "1001", "F001")			'거래소, 코스닥, 선물
g_sMCode = Array("KGG01P", "QGG01P", "F001")			'거래소, 코스닥, 선물
'20221117 LES END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_1520_001r")
	g_szSect	=	"0"		'기본값 금액(억원)세팅
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_1520_001r" then
	    for nIndex = 0 to 2
		     DATAMANAGER.SetDataValue(0, "ohhts_1520_001r", "InBlock1", "FID_INPUT_ISCD", nIndex, g_sMarket(nIndex) )
		     DATAMANAGER.SetDataValue(0, "ohhts_1520_001r", "InBlock1", "FID_INPUT_ISCD2", nIndex, g_sMCode(nIndex) )
	    next
		
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	dim n1520Cnt
	dim nBefAmt
	
		
	if szTranID = "ohhts_1520_001r" then		' 금액/ 100로 변환한다.
	
		n1520Cnt = DATAMANAGER.GetDataCount(0, "ohhts_1520_001r" , "OutBlock1")
		
		for  i = 0 to n1520Cnt - 1 
		
			'개인
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			'외국인
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			'기관계
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , i, Round(nBefAmt / 100))
			
			nBefAmt = 0
			
			nBefAmt = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , i))
			DATAMANAGER.SetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , i, Round(nBefAmt / 100))
		next 
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nSell
	Dim nBuy
	Dim nNetBuy
	Dim n1520Cnt
	Dim nTblCol
	
	if szTranID = "ohhts_1520_001r" then
	
		DATAMANAGER.CancelRealData("ohhts_invr_indv")
	
		n1520Cnt = DATAMANAGER.GetDataCount(0, "ohhts_1520_001r" , "OutBlock1")
	
		for  i = 0 to n1520Cnt - 1
			'개인--------------
			nSell	=0
			nBuy		=0
			nNetBuy 	=0
			
			if	g_szSect	=	"0"	then
				'순매수계산
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN" , i))
				
				if	i	=	2	then		'선물일때만 계약	160407
					nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_VOL" , i))
					nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_VOL" , i)) 
				end	if
			else
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SELN_VOL" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_PRSN_SHNU_VOL" , i)) 
			end if
			nNetBuy = nBuy - nSell 
			
			'Row값계산
			tbl01.SetCellString(i+1, 1, nNetBuy)


			'외국인--------------
			nSell	=0
			nBuy		=0
			nNetBuy 	=0
			
			if	g_szSect	=	"0"	then
				'순매수계산
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN" , i))

				if	i	=	2	then		'선물일때만 계약	160407
					nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_VOL" , i))
					nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_VOL" , i))
				end	if
			else
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SELN_VOL" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_FRGN_SHNU_VOL" , i))
			end if
			nNetBuy = nBuy - nSell 
			
			'Row값계산
			tbl01.SetCellString(i+1, 2, nNetBuy)
			
			
			'기관--------------
			nSell	=0
			nBuy		=0
			nNetBuy 	=0
			
			if	g_szSect	=	"0"	then
			'순매수계산
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN" , i))
				
				if	i	=	2	then		'선물일때만 계약	160407
					nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_VOL" , i))
					nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_VOL" , i))
				end	if
			else
				nSell = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SELN_VOL" , i))
				nBuy	 = CDbl(DATAMANAGER.GetDataValue(0 ,"ohhts_1520_001r", "OutBlock1", "FID_ORGN_SHNU_VOL" , i))
			end if 
			nNetBuy = nBuy - nSell 
			
			'Row값계산
			tbl01.SetCellString(i+1, 3, nNetBuy)
		next
		
		DATAMANAGER.RequestRealData("ohhts_invr_indv")
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	dim k 
	k = 0
	
	for i = 0 to 2
	    For j = 0 To 2
		    DATAMANAGER.SetDataValue(1, "ohhts_invr_indv", "InBlock1", "FIDR_INVR_BSTP_CODE", k, g_sMCode(i) & g_sMarket_Feed(j) )
		    k = k + 1
	    Next
	next
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	dim nNetBuy, nNetBuyFut
	dim nIndex
	dim szInvDiv
	dim szMarket
	
	if szTranID = "ohhts_invr_indv"	then
	
		if	g_szSect	=	"0"	then
			szMarket = Left(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 4)
			szInvDiv = Right(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 4)
			nNetBuy = Round(CDbl(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_NTBY_TR_PBMN", 0 )) / 100 )
			nNetBuyFut	=	Round(CDbl(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_NTBY_CNQN", 0 ))  )
		else
			szMarket = Left(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 4)
			szInvDiv = Right(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_INVR_BSTP_CODE", 0) , 4)
			nNetBuy = Round(CDbl(DATAMANAGER.GetDataValue(1, "ohhts_invr_indv", "OutBlock1", "FIDR_NTBY_CNQN", 0 ))  )
		end if 
		
		Select Case szInvDiv	'투자자구분
		    Case "8000"
			    nIndex = 1
		    Case "9100"
			    nIndex = 2
		    Case "8888"
			    nIndex = 3
		end select
			    
		Select Case szMarket
			Case "0001"
				nRowIdx = 1
			Case "1001"
				nRowIdx = 2
			Case "F001"
			     nRowIdx = 3
		end select

		if	nRowIdx	=	3	then
			tbl01.SetCellString(nRowIdx, nIndex, nNetBuyFut)
		else
			tbl01.SetCellString(nRowIdx, nIndex, nNetBuy)
		end	if
	end if 
End Sub


'============================================================================
'btnChg01_OnClick
'============================================================================
Sub btnChg01_OnClick()
	if g_szSect	=	"0"	then
		btnChg01.caption	=	"수량\r\n(천주)"
		g_szSect	=	"1"
	else
		btnChg01.caption	=	"금액\r\n(억원)"
		g_szSect	=	"0"
	end if
End Sub

'============================================================================
Sub tbl01_OnClick(lRow , lColumn)
	'Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)
	Form.OpenFramePopup("mhprc43000", "", sPosInfo)	'투자자별 매매동향
End Sub

