'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Dim szData
	
'	if g_szSelect <> "1" then
		'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
'		szData = "잔고" & "★" & g_szTab & "★★♥♥♥" & chk1.checkstate & "♥"
'		Form.SendReturnToParent("12000_BALANCE", szData)
'	end if
	
	Form.SaveConfigData("mbtrs12000", "balance1", chk1.checkstate )	'신용합산	'20230807 SWJ START
	Form.SaveConfigData("mbtrs15000", "balance1", chk1.checkstate )	'신용합산
	Form.SaveConfigData("mbtrs15000", "balance2", chk2.checkstate ) '비용반영
End Sub



'============================================================================
Sub grdList_OnScrollEnd()
	if chk1.checkstate = "1" then
			DATAMANAGER.RequestNextData( "obtrs_comn_329r" )
	Else
			DATAMANAGER.RequestNextData( "obtrs_comn_310r" )
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
		
	elseif sKeyName == "DAEYU" then'대여
		if sRet == "ok" then
			Form.SendReturnToParent("mbtrs12000_pp" , "12060●"..g_szSendData)
			Form.CloseForm()
		end if
	elseif sKeyName == "DAEYONG" then'대용
		if sRet == "ok" then
			Form.SendReturnToParent("mbtrs12000_pp" , "12080●"..g_szSendData)
			Form.CloseForm()
		end if
	elseif sKeyName == "DAEJU" then'대주
		if sRet == "ok" then
			Form.SendReturnToParent("mbtrs12000_pp" , "12090●"..g_szSendData)
			Form.CloseForm()
		end if
	end if
End Sub

