Sub FormTab0_OnTabChanged(nCurrentTab)
	Select Case nCurrentTab
		'20230725 htw start 체크 해제 삭제 + 인/비지블 처리로 변경
		Case 0,2,3
			chk1.visible = true
		Case 1
			chk1.visible = false
		'20230725 htw end 체크 해제 삭제 + 인/비지블 처리로 변경
	End Select
	Request_Data()
End Sub

