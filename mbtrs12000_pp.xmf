'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	Dim nRate, nData
	Dim szData, szReturnValue
	Dim nVLTN_PRLS_AMT, nBYNG_AMT, nEXPN_AMT	' 평가손익, 매입금액, 비용금액
	
	nVLTN_PRLS_AMT = 0
	nBYNG_AMT      = 0
	g_Toggle1      = 0
	g_Toggle2      = 0
	
'	SetGridHeader(g_Toggle1, g_Toggle2)

	For i = 0 To grdList.rowcount -1
		If chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT	= CDbl(grdList.GetCellData("bd_cell6", i)) - CDbl( grdList.GetCellData("bd_cell0", i) )
		
		Else
			nVLTN_PRLS_AMT	= CDbl( grdList.GetCellData( "bd_cell6", i ) )
		End If	
	
		nBYNG_AMT 	  	= CDbl(grdList.GetCellData("bd_cell8", i))
		nPSNT_PRC		= grdList.GetCellData("bd_Hyun", i)
		szData			= grdList.GetCellData("bd_Gbn", i)
		
		grdList.SetCellData("bd_cell6", i, nVLTN_PRLS_AMT)
		
		'매입금액이 있는 경우에만 계산
		If CDbl(grdList.GetCellData("bd_cell8", i) ) = 0 Then
			grdList.SetCellData("bd_cell7", i, "" )
		Else
			grdList.SetCellData("bd_cell7", i, FormatNumber(FIX((nVLTN_PRLS_AMT/nBYNG_AMT)*10000)/100,2))
		End If
			
		
		If nPSNT_PRC = "" and chk2.checkstate = "1" Then
			nData = CDbl(grdList.GetCellData("bd_cell13", i)) * -1
			
			grdList.SetCellData("bd_LoanCd", i, nData)
		End If
		'================================================================================
		'20230714 htw start 구분명 잔고 화면과 동일하게 변경
'		01현금 02대출 03신용 04대주 05대여 06대용 07재활용 99기타			
'		szGbn = grdList.GetCellData("bd_cell12",i)
'		szLOAN_AMT = grdList.GetCellData("bd_cell15",i)
'		szMTRT_DATE = grdList.GetCellData("bd_cell14",i)
'
'		Select Case szGbn
'			Case "01"
'				grdList.SetCellData("bd_Gbn", i, "현금")
'			Case "02"
'				grdList.SetCellData("bd_Gbn", i, "대출")	
'				
''				cont0.grdCard.SetCellData("bd_tag", i, "대출")
''				cont0.grdCard.SetCellFgColor("bd_tag", i, "62")
''				cont0.grdCard.SetCellImage("bd_tag", i, "btn_38_n.9")
''				cont0.grdCard.SetCellData("bd_text_prc", i, "대출 "..FormatNumber(szLOAN_AMT,0).."원")
''				if szTranID = "obtrs_comn_310r" Then
''					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
''				end if
'			Case "03"
'				grdList.SetCellData("bd_Gbn", i, "신용")
'				
''				cont0.grdCard.SetCellData("bd_tag", i, "신용")
''				cont0.grdCard.SetCellImage("bd_tag", i, "btn_37_n.9")
''				cont0.grdCard.SetCellFgColor("bd_tag", i, "4")
''				cont0.grdCard.SetCellData("bd_text_prc", i, "신용 "..FormatNumber(szLOAN_AMT,0).."원")
''				if szTranID = "obtrs_comn_310r" Then
''					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
''				end if
'			Case "04"
'				grdList.SetCellData("bd_Gbn", i, "대주")
''					cont0.grdCard.SetCellData("bd_tag", i, "대주")	'기획서에는 대주는 없음
'			Case "05"
'				grdList.SetCellData("bd_Gbn", i, "대여")
'				
''				cont0.grdCard.SetCellData("bd_tag", i, "대여")
''				cont0.grdCard.SetCellImage("bd_tag", i, "btn_38_n.9")
''				cont0.grdCard.SetCellFgColor("bd_tag", i, "62")
''				cont0.grdCard.SetCellData("bd_text_prc", i, "대여 "..FormatNumber(szLOAN_AMT,0).."원")
''				if szTranID = "obtrs_comn_310r" Then
''					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
''				end if
'			Case "06"
'				grdList.SetCellData("bd_cell10", i, "대용")
'				
''				cont0.grdCard.SetCellData("bd_tag", i, "대용")
''				cont0.grdCard.SetCellImage("bd_tag", i, "btn_38_n.9")
''				cont0.grdCard.SetCellFgColor("bd_tag", i, "62")
''				cont0.grdCard.SetCellData("bd_text_prc", i, "대용 "..FormatNumber(szLOAN_AMT,0).."원")
''				if szTranID = "obtrs_comn_310r" Then
''					cont0.grdCard.SetCellData("bd_date", i, " | 만기 "..mid(szMTRT_DATE,3,2).."."..mid(szMTRT_DATE,5,2).."."..right(szMTRT_DATE,2))
''				end if
'			Case "07"
'				grdList.SetCellData("bd_Gbn", i, "재활용")
'			Case "99"
'				grdList.SetCellData("bd_Gbn", i, "기타")
'		end Select
		
		Select Case szData
			Case "0000"	szReturnValue = "보통"
			Case "0101"	szReturnValue = "자기융자"
			Case "0102"	szReturnValue = "유통융자"
			Case "0103"	szReturnValue = "자기대주"
			Case "0104"	szReturnValue = "유통대주"
			Case "0201"	szReturnValue = "예탁주식"
			Case "0202"	szReturnValue = "예탁채권"
			Case "0203"	szReturnValue = "예탁집합투자"
			Case "0204"	szReturnValue = "예탁장외파생"
			Case "0211"	szReturnValue = "예탁유통주식"
			Case "0212"	szReturnValue = "예탁유통채권"
			Case "0213"	szReturnValue = "예탁유통집합투자"
			Case "0214"	szReturnValue = "예탁유통장외파생"
			Case "0301"	szReturnValue = "매도증권담보대출"
			Case "0302"	szReturnValue = "수익증권환매"
			Case "0303"	szReturnValue = "ELS환매자금대출"
			Case "0401"	szReturnValue = "소액주식"
			Case "0402"	szReturnValue = "소액채권"
			Case "0403"	szReturnValue = "소액수익증권"
			Case "0404"	szReturnValue = "소액 ELS"
			Case "0501"	szReturnValue = "공모주청약"
			Case "0502"	szReturnValue = "ELS청약"
			Case "0503"	szReturnValue = "주식매입"
			Case "0601"	szReturnValue = "매입자금대출"
			Case "0701"	szReturnValue = "초단기대출"
			Case "0801"	szReturnValue = "CMA담보대출"
			Case "9201"   szReturnValue = "대출(대여)"'v002
			Case "8201"   szReturnValue = "양도담보"'v003
			Case "6201" szReturnValue = "슈퍼365(재활용)" '20230908 SWJ
			Case "7201" szReturnValue = "담보대여" 		'20230908 SWJ
			
		End Select
		
		'20180123 LES START - 대여주문 '20180904 대여주석처리
'		if szData == "0000" then
'			if grdList.GetCellData("bd_cell2", i) == "31" then
'				szReturnValue = "대여"
'			end if
'		end if
		'20211210 HSZ START - CFD대용, 선물대용 분기처리 추가
		szRMND_CLCD = grdList.GetCellData("bd_cell2", i)
		if szData == "0000" then
			if szRMND_CLCD = "31" then
				szReturnValue = "주식대여"				'20230908 SWJ
			elseif szRMND_CLCD = "32" then
				szReturnValue = "CFD대용"
			elseif szRMND_CLCD = "16" then
				szReturnValue = "선물대용"
			end if
		end if
		'20211210 HSZ END
		grdList.SetCellData("bd_Gbn", i, szReturnValue)
		'20230714 htw end 구분명 잔고 화면과 동일하게 변경
		'==============================================================================================
		
		'DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "PRDY_CLPR" , 0)
		'grdList.SetCellData('sCellID, nRowIdx, sValue)
	Next	
	
	'v001. 최초 호출 후, ReceiveComplete에서 연속 호출(종목정보)
'	g_index = 0
'	iscd = grdList.GetCellData("bd_Cd", 0)
'		
'	DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)	
'	DATAMANAGER.RequestTranData("obsim_stsv_001r")
	
'	nRate = Round((nVLTN_PRLS_AMT / nBYNG_AMT) * 100, 2)	
'
'	tbl0.SetCellString(0, 3, nVLTN_PRLS_AMT)		'미실현손익
'	tbl0.SetCellString(1, 3, nRate)				'손익률

End Function

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	if g_szGbn == "1" then		' 예약주문에서 조회
		DATAMANAGER.RequestTranData("obtrs_comn_310r")	
	else
		If chk1.checkstate = "1" Then
			DATAMANAGER.RequestTranData("obtrs_comn_329r")
		Else
			DATAMANAGER.RequestTranData("obtrs_comn_310r")
		End If
	end if
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "현금")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "신용")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "대출")
	FormTab0.currenttab = 0
	
	chk1.dischkbtnimage = "checkmenu_n.png"'IOS 체크 비활성화시 기존 이미지로 셋팅되는 현상 방지용
	
	Dim szChkVal1, szChkVal2
	g_Buffer = 0
	
	Form.SetScreenName("국내주식 잔고")
	
	'20230807 SWJ START : 주문화면에서 신용합산 체크가 되어있으면, 잔고에서도 체크
	szChkVal0 = Form.LoadConfigData("mbtrs12000", "balance1")
	'20230807 SWJ END
	
	szChkVal1 = Form.LoadConfigData( "mbtrs15000", "balance1" )		'신용합산
	szChkVal2 = Form.LoadConfigData( "mbtrs15000", "balance2" )		'비용반영
	
	'20180124 LES START - 대여주문
	gScrNo = Form.GetSharedData("&SCREEN_NO", false)
	if gScrNo = "12060" then
		szChkVal = 0
		chk1.visible = false
		chk1.enable = false
		chk2.left = 6
	end if
	'20180124 LES END
	
	If szChkVal2 <> "" Then
		chk2.checkstate = szChkVal2
	End If
	
'	Button1.visible = False '권리입고예정수량 매도버튼(기본 false)

	
	szOpen = Form.GetOpenLinkData()
	g_szChk = "0"
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")

	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
		g_szGbn    = tData(3)
		chk1.checkstate = tData(4)
		FormTab0.currenttab = CInt(tData(5)) + 1
		
		'20230807 SWJ START
		if szChkVal0 == "1" then
			chk1.checkstate = szChkVal0
		else
			If szChkVal1 <> "" Then
				chk1.checkstate = szChkVal1
			End If
		end if
		'20230807 SWJ END
		
		Select Case CInt(tData(5)) + 1
			'20230725 htw start 체크 해제 삭제 + 인/비지블 처리로 변경
			Case 0,2,3
				chk1.visible = true
			Case 1
				chk1.visible = false
			'20230725 htw end 체크 해제 삭제 + 인/비지블 처리로 변경
		End Select
		
		if tData(3) == "1" then		' 예약주문에서 여는경우
			chk1.left = 1000
			chk2.left = 1000
			grdList.top = 0
			grdList.height = 563		
		end if
		
		'20180124 LES START - 대여주문
		gScrNo = Form.GetSharedData("&SCREEN_NO", false)
		if gScrNo = "12060" then
			szChkVal = 0
			chk1.checkstate = szChkVal
			
			grdList.SetCellTopCaption("th_cell10", "대여일")
			
		end if
		'20180124 LES END
			
		Request_Data()
	end if
	
	DATAMANAGER.RequestTranData("obtrs_oder_161r")
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szFEE_INCU_YN
	
	'비용반영
	if g_szGbn == "1" then		' 예약주문에서 조회
		szFEE_INCU_YN = "N"
	else
		if chk2.checkstate = "1" then
			szFEE_INCU_YN = "Y"
		else
			szFEE_INCU_YN = "N"
		end if
	end if

'	' ----------------------------------------------------------------------
'	' 개별계좌 평가내역
'	' ----------------------------------------------------------------------	
'	If szTranID = "obacb_balc_105r" Then
'		DATAMANAGER.ClearInputData(0, "obacb_balc_105r")
'		
'		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" 	, 0, "N")
'		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "ACNO" 			, 0, g_szAcnt)		
'		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
'	' ----------------------------------------------------------------------
'	' 계좌 주식잔고내역
'	' ----------------------------------------------------------------------	
'	ElseIf szTranID = "obtrs_comn_308r" Then
'		DATAMANAGER.ClearInputData(0, "obtrs_comn_308r")
'		
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "ACNO"		 	, 0, g_szAcnt)
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "UI_RMND_CLCD" 	, 0, "00")
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "FEE_INCU_YN" 	, 0, szFEE_INCU_YN)
	' ----------------------------------------------------------------------
	' 계좌 실시간 잔고조회2(미체결주
	' ----------------------------------------------------------------------			
	If szTranID = "obtrs_comn_310r" Then
		DATAMANAGER.ClearInputData(0,"obtrs_comn_310r" )
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
		
		if gScrNo == "12060" then
			DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0, "31")
		else
			'UI_RMND_CLCD= 전체 00 / 현금 19 / 신용 21 / 대출 22
			if CInt(FormTab0.currenttab) == 0 then
				DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0, "00")'전체(예상)
			elseif CInt(FormTab0.currenttab) == 1 then	
				DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0, "19")'현금
			elseif CInt(FormTab0.currenttab) == 2 then	
				DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0, "21")'신용
			elseif CInt(FormTab0.currenttab) == 3 then	
				DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0, "22")'대출
			end if
		end if
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "IQRY_CLS_CODE"	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "BRNG_STCK_YN"	, 0, "N")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "FEE_INCU_YN"		, 0, szFEE_INCU_YN)		
	' ----------------------------------------------------------------------
	' 계좌 신용팝산 실시간 잔고조회
	' ----------------------------------------------------------------------			
	ElseIf szTranID = "obtrs_comn_329r" Then
		DATAMANAGER.ClearInputData(0, "obtrs_comn_329r")
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "ACNO" 			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
		
		'UI_RMND_CLCD= 전체 00 / 현금 19 / 신용 21 / 대출 22
		if CInt(FormTab0.currenttab) == 0 then
				DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD"	, 0, "00")'전체
			elseif CInt(FormTab0.currenttab) == 1 then	
				DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD"	, 0, "19")'현금
			elseif CInt(FormTab0.currenttab) == 2 then	
				DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD"	, 0, "21")'신용
			elseif CInt(FormTab0.currenttab) == 3 then	
				DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD"	, 0, "22")'대출
			end if
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "IQRY_CLS_CODE" 	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "BRNG_STCK_YN" 	, 0, "N")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "FEE_INCU_YN" 	, 0, szFEE_INCU_YN)
	' ----------------------------------------------------------------------
	' 고객별 매매수수료정보 조회
	' ----------------------------------------------------------------------			
	ElseIf szTranID = "obpds_srvc_326r" Then
		DATAMANAGER.ClearInputData(0, "obpds_srvc_326r")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ACNO" 			, 0, g_szAcnt)		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ONLN_YN" 		, 0, "Y")
'	elseif szTranID = "obsim_stsv_001r" then
	elseif szTranID = "obtrs_oder_161r" then
		DATAMANAGER.ClearInputData(0, "obtrs_oder_161r")
	
		DATAMANAGER.SetDataValue(0, "obtrs_oder_161r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_161r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_161r", "InBlock1", "ISCD"			, 0, "%")
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	' ----------------------------------------------------------------------
'	' 개별계좌 평가내역
'	' ----------------------------------------------------------------------		
'	If szTranID = "obacb_balc_105r" Then
'		DATAMANAGER.RequestTranData("obtrs_comn_308r")
'	' ----------------------------------------------------------------------
'	' 계좌 주식잔고내역
'	' ----------------------------------------------------------------------		
'	ElseIf szTranID = "obtrs_comn_308r" Then
'		Request_Data()
	' ----------------------------------------------------------------------
	' 계좌 신용팝산 실시간 잔고조회, 계좌 실시간 잔고조회2(미체결주
	' ----------------------------------------------------------------------		
	If szTranID = "obtrs_comn_329r" Or szTranID = "obtrs_comn_310r" Then
		SetGridData()
		Dim szLOAN_DATE

		for i = 0 to grdList.rowcount - 1
		
			szLOAN_DATE = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "LOAN_DATE" , i )'htw 230530 신용합산의 경우 대출일자가 30000101로 임의로 내려와 스크립트로 처리
			if szTranID == "obtrs_comn_329r" then
				grdList.SetCellData("bd_LoanDate", i, "")
			else
				grdList.SetCellData("bd_LoanDate", i, szLOAN_DATE)
			end if
			
			psnt_prc = Cdbl(grdList.GetCellData("bd_Hyun", i))
			psdy_clpr= Cdbl(grdList.GetCellData("bd_cell1",i))'신용이자
						
			if psnt_prc > psdy_clpr then
				grdList.SetCellFgColor("bd_Hyun", i, "10")
			elseif psnt_prc = psdy_clpr then
				grdList.SetCellFgColor("bd_Hyun", i, "4")
			else
				grdList.SetCellFgColor("bd_Hyun", i, "11")
			end if
			
			if trim(grdList.GetCellData("bd_cell8", i)) == "" then
				byng_amt = 0
			else
				byng_amt = Cdbl(grdList.GetCellData("bd_cell8", i))
			end if
			
			if trim(grdList.GetCellData("bd_cell4", i)) == "" then
				loan_amt = 0
			else
				loan_amt = Cdbl(grdList.GetCellData("bd_cell4", i))
			end if
			
			grdList.SetCellData("bd_cell10", i, byng_amt - loan_amt)
		next
		'v001.
'	elseif szTranID = "obsim_stsv_001r" then
'		
'		if Cint(g_index) < Cint(grdList.rowcount)  then
'			
'			iscd = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0)
'			prdy_clpr = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "PRDY_CLPR" , 0)
'			
'			grdList.SetCellData("bd_cell1", g_index, prdy_clpr)
'			g_index = g_index + 1
'			
'			iscd = grdList.GetCellData("bd_Cd", g_index)
'			DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)	
'			
'			DATAMANAGER.RequestTranData("obsim_stsv_001r")
'		end if
'		
'		'v001. g_index = grdList.rowcnt 일때 complete를 안타므로 바로 색상처리
'		if Cint(g_index) == Cint(grdList.rowcount) then
'			for i = 0 to grdList.rowcount - 1
'				psnt_prc = Cdbl(grdList.GetCellData("bd_Hyun", i))
'				psdy_clpr= Cdbl(grdList.GetCellData("bd_cell1", i))
'				
'				
'				if psnt_prc > psdy_clpr then
'					grdList.SetCellFgColor("bd_Hyun", i, "10")
'				elseif psnt_prc = psdy_clpr then
'					grdList.SetCellFgColor("bd_Hyun", i, "4")
'				else
'					grdList.SetCellFgColor("bd_Hyun", i, "11")
'				end if
'			next
'		end if
	elseif szTranID = "obtrs_oder_161r" then
'		if DATAMANAGER.GetDataValue(0, "obtrs_oder_161r", "OutBlock1", "RGHT_HLDN_YN", 0) == "Y" then
'			Button1.visible = True
'			Label1.visible  = True
			
'			chk1.height = 30
'			chk2.height = 30
'			chk1.fontsize = -1
'			chk2.fontsize = -1
'		end if
	End If
End Sub

'============================================================================
' chk1_OnChange
'============================================================================
Sub chk1_OnChange(sCheckState)
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If

	g_szChk = "0"
	Request_Data()
End Sub

'============================================================================
' chk2_OnChange
'============================================================================
Sub chk2_OnChange(sCheckState)
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If
	
	g_szChk = "1"
	Request_Data()
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	'20230605 htw start 주문 화면 외 다른 화면에서 오픈 시 그리드 클릭 시 연동 제거 추가
	if g_szGbn <> "3" and CInt(g_szGbn) <> 3 then
		Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
		Dim errmsg
		
		errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."
	
		if lRow > -1 then
			szCd       = grdList.GetCellData("bd_Cd",       lRow)
			szQty      = grdList.GetCellData("bd_Able",     lRow)
			szLoanDate = grdList.GetCellData("bd_LoanDate", lRow)	
			szLoanCd   = grdList.GetCellData("bd_LoanCd",   lRow)	
			szLoanSr   = grdList.GetCellData("bd_LoanSr",   lRow)
			
			g_szSelectRowCode = szCd
			
			'20180123 LES START - 대여주문
			'szScrNo	  = Form.GetSharedData("&SCREEN_NO", false )
			szClcd 	  = grdList.GetCellData("bd_cell2", lRow)
			
			'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
			g_szSendData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr
			
			'20230918 SWJ START: 위치 옮김 (뒤에 위치하면, szClcd값이 "31"이어서 대여주문 가능 메시지를 뿌림)
			if szLoanCd = "8201" then  'v003 양도담보 불가
				Form.ShowAlert("알림", "양도담보 잔고는 매도주문이 불가능 합니다.")
				Exit Sub
			end if 
			
			if szLoanCd = "9201" then  'v002 대출대여 신용합산 매도 불가
			    Form.ShowAlert("알림", "대출대여 잔고는 MTS에서 매도주문이 불가능 합니다.")
			    Exit Sub
			end if 
			'20230918 SWJ END
			
			if gScrNo = "12060" then
				if szClcd <> "31" and ( szLoanCd <> "6201" and szLoanCd <> "7201" ) then	'20230908 SWJ : 잔고 세분화 (담보대여, 슈퍼365재활용)
					'20230908 SWJ START : 주문 실행 불가능해야함
					'20230626 htw start 대용/대여/대주일 경우 탭위치 값=0으로 셋팅
					'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
					'g_szSendData = "잔고" & "★" & "0" & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr
					'Form.MsgBox("안내", "해당 종목은\n대여주문화면에서\n주문이 가능합니다.", "DAEYU", 7,"주문화면바로가기","확인")
					Form.ShowAlert("알림", "해당 종목은 대여주문화면에서 주문실행이 불가능 합니다.")
					Exit Sub
				end if
			
			else
				
				if szClcd == "31" or ( szLoanCd == "6201" or szLoanCd == "7201" ) then	'20230908 SWJ : 잔고 세분화 (담보대여, 슈퍼365재활용)
					'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
					g_szSendData = "잔고" & "★" & "0" & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr
					Form.MsgBox("안내", "해당 종목은\n대여주문화면에서\n주문이 가능합니다.", "DAEYU", 7,"주문화면바로가기","확인")
	'				Form.ShowAlert("알림", "해당 종목은 대여주문화면에서 주문실행하시기 바랍니다.")
					Exit Sub
				end if
					
			end if
			'20180123 LES END - 대여주문
			'20211210 HSZ START - 대용주식매도
			if gScrNo = "12080" then
				if szClcd <> "32" or szClcd <> "16" then
					'20230908 SWJ START : 주문 실행 불가능해야함
					'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
					'g_szSendData = "잔고" & "★" & "0" & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr
					'Form.MsgBox("안내", "해당 종목은\n대용주식매도화면에서\n주문이 가능합니다.", "DAEYONG", 7,"주문화면바로가기","확인")
					Form.ShowAlert("알림", "해당 종목은 대용주식매도화면에서 주문실행이 불가능 합니다.")
					Exit Sub
				end if
			elseif gScrNo = "12020" then '예약주문 (대용매도 가능)
			
			else
				if szClcd == "32" or szClcd == "16" then
					'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
					g_szSendData = "잔고" & "★" & "0" & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr
					Form.MsgBox("안내", "해당 종목은\n대용주식매도화면에서\n주문이 가능합니다.", "DAEYONG", 7,"주문화면바로가기","확인")
	'				Form.ShowAlert("알림", "해당 종목은 대용주식매도화면에서 매도가능한 종목입니다.")
					Exit Sub
				end if
					
			end if 
			'20211210 HSZ END - 대용주식매도
			
			
			'20211228 SWJ START : 신용대주
			if gScrNo <> "12090" then
				if szLoanCd == "0104" then
					'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
					g_szSendData = "잔고" & "★" & "0" & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr
					'20230626 htw end 대용/대여/대주일 경우 탭위치 값=0으로 셋팅
					Form.MsgBox("안내", "해당 종목은\n대주주문화면에서\n주문이 가능합니다.", "DAEJU", 7,"주문화면바로가기","확인")
	'				Form.ShowAlert("알림", "해당 종목은 대주주문화면에서 주문실행하시기 바랍니다.")
					Exit Sub
				end if
			end if
			'20211228 SWJ END
			
			'20161205 ETN이나 신주인수권 등 6자리가 아닌 종목은 Q나 J를 붙여서 종목안내창에 표기하므로
			'  그 부분에 대한 처리를 하여야 한다고 함.
			' 20160310 주문불가한 종목 예외처리
			'szCutCd = Mid(szCd, 2, Len(szCd))
	'		if Left(Trim(szCd), 1) <> "J" Then 
	'		   szCutCd = Mid(szCd, 2, Len(szCd))
	'		else
	'		   szCutCd = szCd
	'		end if
	'		
	'		'20170502 상장수익증권 예외처리
	'		if Left(Trim(szCd), 1) == "F" Then
	'		   szCutCd = szCd			
	'		end if
	'		
	'		szMk = Form.GetItemCodeInfo(szCutCd, "market")
	
	'20180416 LES
	'  if Left(g_szItemCode,3) == "106" then
	'   g_szItemMarket = "J"
	'  end if
	  
			
			
			if(left(szCd,1) == "J" and len(szCd) == 9) or left(szCd,1) == "Q" or left(szCd,1) == "F" then
				szMk = Form.GetItemCodeInfo(szCd, "market")
			else
				szCutCd = Mid(szCd,2,len(szCd))
				szMk = Form.GetItemCodeInfo(szCutCd, "market")
			end if
			
			
			if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
		'		if g_szGbn == "2" then		' 호가주문 예외처리
		'			if Trim(szLoanCd) <> "0000" then
		'				Form.ShowAlert("알림", "신용주문은 일반주문을 이용해주시기 바랍니다.")
		'				Exit Sub
		'			end if
		'		end if
				
				'  		전달내용		/탭위치			/종목코드	/수량		/대출일자			/대출상세		/신용합산여부			/대출일련번호		/대출일련번호
				szData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & CInt(szQty) & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr

				g_szSelect = "1"
				'20211210 HSZ START - 대용주식매도
				if gScrNo == "12020" then '예약주문
					'  전달내용/잔고구분 추가
					szData = szData  & "♥" & szClcd
				end if
				'20211210 HSZ END - 대용주식매도
				Form.SendReturnToParent("12000_BALANCE", szData)
				Form.CloseForm()
			else
				Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
			end if
		end if
	end if
	'20230605 htw end 주문 화면 외 다른 화면에서 오픈 시 그리드 클릭 시 연동 제거 추가
End Sub

