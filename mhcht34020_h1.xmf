'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  		'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then  	'주/월
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false then
			sTemp = RadioGroup0.GetRadioCaption(1)
			
			if sTemp == "월" then
				g_szChrtType = "M"
			else
				g_szChrtType = "W"
			end if
			
			g_flagWeek = true
			
			PeriodSet(g_szChrtType)
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_h4.xmf", sTemp, "" )
		end if
		
'		if g_flagWeek == true   then
'			if g_szChrtType == "W" then
'				g_szChrtType = "M"
'				g_flagWeek = false
'				RadioGroup0.SetRadioCaption( 1, "월" )
'			else
'				g_szChrtType = "W"
'			end if
'		else
'			if g_szChrtType == "M" then
'				g_szChrtType = "W"
'				g_flagWeek = true
'				RadioGroup0.SetRadioCaption( 1, "주" )
'			else
'				g_szChrtType = "M"
'			end if
'		end if	
'		PeriodSet(g_szChrtType)
'	elseif nIndex == 2 then  '월
'		g_szChrtType = "M"
'		PeriodSet(g_szChrtType)
	elseif nIndex == 2 then   		'분
		g_flagTic = false
		g_flagWeek = false
	
		g_szChrtType = "1"
		
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
		else
			'g_flagMin = false
			Form.OpenPopup( "mhcht13000_h2.xmf", g_szMinType, "" )
		end if
		
	elseif nIndex == 3 then   		'틱
		g_flagMin = false
		g_flagWeek = false
		
		g_szChrtType = "0"
		
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
			g_szTicType = tmpTic[0]
			
			PeriodSet(g_szChrtType)
		else
			Form.OpenPopup( "mhcht13000_h3.xmf", g_szTicType, "" )
			'g_flagTic = false
		end if
		
	end if
End Sub
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================

'============================================================================
' 차트 설정 개수 변경시
'============================================================================
Function ChartEx0_OnByNumber(Count)
	if #Count == 1 then
		Count = "000"..Count
	elseif #Count == 2 then
		Count = "00"..Count
	elseif #Count == 3 then
		Count = "0"..Count
	end if

	g_sChartCnt = Count
	
	RequestData()
End function
'============================================================================
' 분,틱 설정파일 저장
'============================================================================
Function Save_ini()
	dim sMin, sTic, sflag
	
	for i = 0 to 6 
		Form.SetEnvData( 1, "chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "chart_min"..i, g_chartMinArr[i] )
		
		Form.SetEnvData( 1, "chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, g_chartTicArr[i] )
	next
'	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			' 데이터갯수...필요 없음 삭제 해도 됩니다.
End function
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet
		RadioGroup0.SetRadioCaption( 3, g_szTicType )
		tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet )
		
		PeriodSet(g_szChrtType)
	end if
End Sub
'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
Function PeriodSet(sPeriodType)
	if sPeriodType= "0" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType= "1" then
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	   
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod ="1"
	    
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod ="1"
	   
	end if
	
	sPeriod = CInt( g_sPeriod )
	if Len( sPeriod ) = 1 then
	   g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod ) = 2 then
	   g_sPeriod = "0"..g_sPeriod
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	RequestData()
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If g_szItemMarket = "EO" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_eopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
		
	elseif g_szItemMarket = "EM" then
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		
	elseif g_szItemMarket = "CM" then
		DATAMANAGER.SetDataValue( 1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_cmef_cntg" )
		
	elseif g_szItemMarket = "CD" then
		DATAMANAGER.SetDataValue( 1, "ohhts_cusf_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_cusf_cntg" )
	End If
End Sub
'============================================================================
Function ChartEx0_OnRequestData(nIndex, sData)
	If sData = "" or sData = null then
		Exit Function
	End If
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode   = Cstr(Trim(Data[0]))             '코드
	g_sPeriodType  = Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod      = Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh 	 = Cstr(Trim(Data[3]))
	
	radioIndex = ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then  
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType =  "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
	
	else
		Select case g_sPeriodType
			case "0"
				radioIndex = 3
				RadioGroup0.SetRadioCaption(radioIndex, g_sPeriod.."틱")
				
			case "1"				
				radioIndex = 2
				RadioGroup0.SetRadioCaption(radioIndex, g_sPeriod.."분")
			
			case "2"
				radioIndex = 0
			
			case "3"
				radioIndex = 1
				RadioGroup0.SetRadioCaption(radioIndex, "주")
			
			case "4"
				radioIndex = 1
				RadioGroup0.SetRadioCaption(radioIndex, "월")
		
		end Select
	end if
	
	RadioGroup0.currentindex = radioIndex
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode, "market_night")
	Form.SetItemCode(g_szItemCode)
	
	RequestData()
End Function
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetLoadChart("future")
End Sub
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub ChartEx0_OnScrollEnd()
	if g_szChrtType = "0" then 		' 틱
		DATAMANAGER.RequestNextData("ohhts_5030_004r")
	elseif g_szChrtType = "1" then 	' 분
		DATAMANAGER.RequestNextData("ohhts_5030_003r")
	else
		DATAMANAGER.RequestNextData("ohhts_5030_001r")
	end if
End Sub
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
Function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	sPeriodType = ""
	
	Dim sMin, sTic
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType & sMin & "/"
			else
				sPeriodType = sPeriodType & sMin & ";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType & sTic & "/"
			else
				sPeriodType = sPeriodType & sTic & ";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
End Function
'============================================================================
Function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
		sTemp = split(sPeriodType, "/")
		sMinArr = split(sTemp[0], ";")
		sTicArr = split(sTemp[1], ";")
		
		Form.Log("sPeriodType", sPeriodType)
	   
		for i = 0 to 7 step 1
			Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )
		next
	end if
End Function
'============================================================================
Sub Form_OnFormClose()
	ChartEx0.SetSaveChart("1")
	Form.SendReturnToParent("OrientaitonClose", g_szItemCode)
End Sub
'============================================================================
Sub BtnLine_OnClick()
	if g_flagLine = false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath = "btn_chart01_o.9.png"
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath = "btn_chart01_n.9.png"
	end if
End Sub
'============================================================================
Sub Form_OnRefresh()
	RequestData()
End Sub
'============================================================================
Sub imgSearch_OnClick()
	Form.OpenCommonDialog("SEARCH", "11:12:13", "")
End Sub
