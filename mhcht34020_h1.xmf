''''''''''''''''''''''''''''''''''''''''''''''-
' 01. 화 면 명 : 야간선옵현재가
' 02. 화면설명 : 야간선옵현재가 차트탭
' 03. 작    성 : 2017.04.10 PENTA13
''''''''''''''''''''''''''''''''''''''''''''''-

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_flagLine

Dim g_szItemKey, g_szHostKey, g_szOsKey
g_szItemKey = "&ITEM_CMEEUREX"
g_szHostKey = "&HOST_DATE"
g_szOsKey   = "&OS_TYPE"

'============================================================================
Sub Form_OnFormInit()
	sBIOTermOS = Form.GetSharedData(g_szOsKey, false) 'iOS("2")Android("1")
	
	if sBIOTermOS == "2" then
		imgSearch.visible = false
	end if
	
	Dim szOpen, g_szCd, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"★")
	
	if arrData(0) <> "" then
		g_szItemCode = arrData(0)
		
		' 타화면에서 호출되는 탭으로 이동
		If #arrData > 1 Then
			If arrData(1) <> "" then
				fmtab0.currenttab = arrData(1)
			End If
		End If
	else
		g_szItemCode = Form.GetSharedData(g_szItemKey, 0)		' 최근조회종목
	end if
	
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market_night" )
	
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = true
	g_szChrtType = "D" 	'일
	g_szToday = Form.GetSharedData(g_szHostKey, 0)
'	g_szMinType = "1분"
'	g_szTicType = "1틱"
	
	g_flagLine = false
	PeriodSet(g_szChrtType)
	
	RequestData()
End Sub
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		if g_szItemCode = sValue and g_flagInit = false then
			exit Sub
		end if
		
		If g_szItemMarket = "EO" Then
			DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
		ElseIf g_szItemMarket = "EM" Then
			DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
		ElseIf g_szItemMarket = "CM" Then	
			DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )
		ElseIf g_szItemMarket = "CD" Then
			DATAMANAGER.CancelRealData( "ohhts_cusf_cntg" )
		End If
		
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market_night" )
		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode, "name" )
		
		RequestData()
	end	if
End Sub
'============================================================================
Function RequestData()
	DATAMANAGER.CancelRealData("ohhts_eopt_cntg")
	DATAMANAGER.CancelRealData("ohhts_efut_cntg")
	DATAMANAGER.CancelRealData("ohhts_cmef_cntg")
	DATAMANAGER.CancelRealData("ohhts_cusf_cntg")	
	
	if g_szChrtType = "0" then 		' 틱
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_ISCD", 0, g_szItemCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, "Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_DATE1", 0, g_szToday)
			
		sTic = Split(g_szTicType, "틱", -1, 1)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_CNT1", 0, sTic[0])  'n틱
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, "2") 
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN", 0, "Y") 
	
		DATAMANAGER.RequestTranData("ohhts_5030_004r")

	elseif g_szChrtType = "1" then 	' 분
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD", 0, g_szItemCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0,"Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1", 0, g_szToday)
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60

		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp)  'n분
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN", 0,"Y")  '
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN", 0,"N")
		
		DATAMANAGER.RequestTranData("ohhts_5030_003r")

	else
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD", 0, g_szItemCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, "Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR", 0, g_szChrtType)  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1", 0, g_szToday)
	
		DATAMANAGER.RequestTranData("ohhts_5030_001r")

	end if
	
	DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
	
	DATAMANAGER.RequestTranData("ohhts_3050_001r")

End Function
