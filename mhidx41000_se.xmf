'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"ohhts_1058_003r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1058_003r", "InBlock1", "FID_INPUT_ISCD", 0, g_szISCD)
		DATAMANAGER.SetDataValue(0, "ohhts_1058_003r", "InBlock1", "FID_INPUT_ISCD2", 0, g_szISCD2)
	end if
End Sub

