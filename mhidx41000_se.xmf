'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	chart01.SetAccrueName("개인,외국인,기관=1,1,1")
	chart01.SetPeriodType(0)			'0:틱, 1:분, 2:일자
	chart01.setViewDataCount(-1)
	g_szISCD		=	"KSQ"
	
	'20221117 LES START 차세대 업종코드 변경
	'0001 => KGG01P
	g_szISCD2	=	"KGG01P"
	'20221117 LES END
	
	
	DATAMANAGER.RequestTranData("ohhts_1058_003r")
	chart01.setTouchEventType("0")	'0:터치이벤트 없음 1:모든 터치 이벤트 2:가로차트
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


