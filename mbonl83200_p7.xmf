<ROOT>
	<MAP_INFO scrno="83010" scrname="약관동의풀팝업P" version="2" writer="최지희" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="btnNext" caption="투자설명서를
제공받았음을 동의" fgcolor="211:222222222" fontstyle="01" btnimage="btn_26.9.png" ly_vert="187,587,188,60,1" />
		<LABEL name="lblTitle" fontsize="4" fontstyle="01" halign="1" fonttype="1" ly_vert="0,0,375,60,1" />
		<FORMTAB name="fmtab" tabcount="4" tabheadwidth="0" tabheadheight="0" usepg="1" ly_vert="20,60,335,489,1" >
			<PAGE name="1" caption="개인정보수집/이용등록" linkfile="mbonl82010_s5" loadingtype="1" />
			<PAGE name="2" caption="고유식별정보처리동의" linkfile="mbonl82010_s5" loadingtype="1" />
			<PAGE name="3" caption="통신사이용약관동의" linkfile="mbonl82010_s5" loadingtype="1" />
			<PAGE name="4" caption="서비스이용약관" linkfile="mbonl82010_s5" loadingtype="1" />
		</FORMTAB>
		<LABEL name="lblPage" halign="1" autofontsize="1" ly_vert="0,554,375,18,1" />
		<BUTTON name="btnClose" caption="미동의" fgcolor="013:051051051" btnimage="btn_25.9.png" ly_vert="0,587,187,60,1" />
		<LINKFORM name="lnkMain" linkfile="mbonl82010_s5" visible="0" ly_vert="20,60,335,489,0" />
		<IMAGE name="imgPrev" autosize="1" imgpath="icon_arrow3_l" ly_vert="20,311,24,24,1" />
		<IMAGE name="imgNext" autosize="1" imgpath="icon_arrow3_r" ly_vert="329,311,24,24,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6809" _ulen="6683" >
'===========================================================================
' 화  면  명 : (공통)약관동의풀팝업P
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2021.10.06 최지희
' 수      정 : 
'===========================================================================
Dim g_szOpenData 
Dim g_tOpenData
Dim g_tAgreeIndex 
Dim g_nCnt           ' 약관 갯수
Dim g_nIndex
'============================================================================
Sub Form_OnFormInit()
	g_szOpenData = ""
	g_tOpenData = {}
	g_tAgreeIndex = {}
	g_nCnt = 0            ' 약관 갯수
	g_nIndex = 1
	
	g_szOpenData = trim( Form.GetOpenLinkData( ) )
	if nil ~= g_szOpenData and "" ~= g_szOpenData then
		g_tOpenData = Split(g_szOpenData, "☆")
	    g_nCnt = #g_tOpenData
	end if

    if g_nCnt > 0 then
        if g_nCnt == 1 then
		    lnkMain.visible = "1"
		    imgPrev.visible = "0"
		    imgNext.visible = "0"
		    fmtab.visible = "0"
        else
		   imgPrev.visible = "0"
		    
        end if
		f_SetUI()
    end if   
    
End Sub

'============================================================================
function f_SetUI()
    if g_nCnt > 0 then
        if g_nIndex <= g_nCnt then
			if trim(g_tOpenData[g_nIndex-1]) ~= "" then
				'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
				Dim tData
				Dim szTitle
				Dim szUrlType
				Dim szData 
				
				tData = Split(g_tOpenData[g_nIndex-1], "★")
				szTitle       = trim( tData[0] )
				szUrlType     = trim( tData[2] )
				szData        = trim( tData[1] )
				table.insert(g_tAgreeIndex, tData[5])
				lblTitle.caption = szTitle
				Form.triggerEvent("fmtab."..fmtab.currenttabpageid, "InitData", szData)
				Form.triggerEvent("lnkMain", "InitData", szData)
				
'				if szUrlType == "loaddata" then
'					webAgree.loaddata = szData
'				else
'					webAgree.urlpath = szData
'				end
			end if
        else
            g_nIndex = 0
        end if

        if g_nCnt == g_nIndex then
		   imgNext.visible = "0"
		   if g_nIndex == 1 then
			   imgPrev.visible = "0"
		   else
			   imgPrev.visible = "1"
		   end if
        else
			if g_nIndex == 1 then
				imgPrev.visible = "0"
				imgNext.visible = "1"
			else
				imgPrev.visible = "1"
			end if 
			
        end if
    end if
End Function

'============================================================================
Sub Form_OnFormClose()
	Dim szData
	
	if #g_tAgreeIndex > 0 then
		for i = 0 to #g_tAgreeIndex -1
			if i == 0 then
				szData = g_tAgreeIndex[i]
			else
				szData = szData.."☆"..g_tAgreeIndex[i]
			end if
		next
	else
		szData = "close"
	end if
	
	Form.SendReturnToParent("mbonl83010_p5" ,  szData)
End Sub                                                                            

'============================================================================
Sub btnNext_OnClick()
	Dim szPopup
	szPopup = ""
	
	if g_nCnt > 0 then
		Dim bClose
		bClose = false
		
		if g_nCnt == 1 then
			bClose = true
		else
			if g_nCnt > g_nIndex then
				g_nIndex = g_nIndex + 1
				f_SetUI()
			elseif g_nCnt == g_nIndex then
				bClose = true  
			end if
		end if

		if bClose == true then
			for i = 0 to #g_tAgreeIndex -1
				Dim szScreenNo
				szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
				if szScreenNo == "82100" or szScreenNo == "82110" or szScreenNo == "82020" then
					if g_tAgreeIndex[i] == "3" then
						szPopup = "Y"
'						Form.OpenPopup("mbonl82010_p5", "", "")
					else
						szPopup = "N"
'						Form.CloseForm()
					end if 
				else
					if g_tAgreeIndex[i] == "4" then
						szPopup = "Y"
'						Form.OpenPopup("mbonl82010_p5", "", "")
					else
						szPopup = "N"
'						Form.CloseForm()
					end if 
				end if
			next
		end if	
	end if
	 if szPopup == "Y" then
		 Form.OpenPopup("mbonl82010_p5", "", "")
	 elseif szPopup == "N" then
		 Form.CloseForm()
	 end if 
End Sub

'============================================================================
Sub btnClose_OnClick()
	g_tAgreeIndex = {}
	Form.CloseForm()
End Sub

'============================================================================
Sub fmtab_OnTabChanged(nCurrentTab)
	if g_nCnt > 0 then
		Dim bClose
		bClose = false
		
		if g_nCnt == 1 then
			bClose = true
		else
			if g_nCnt > g_nIndex then
				g_nIndex = g_nIndex + 1
				f_SetUI()
			elseif g_nCnt == g_nIndex then
				bClose = true  
			end if
		end if
			
		if bClose == true then
			for i = 0 to #g_tAgreeIndex -1
				Dim szScreenNo
				szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
				if szScreenNo == "82100" or szScreenNo == "82110" or szScreenNo == "82020" then
					if g_tAgreeIndex[i] == "3" then
						Form.OpenPopup("mbonl82010_p5", "", "")
					else
						Form.CloseForm()
					end if 
				else
					if g_tAgreeIndex[i] == "4" then
						Form.OpenPopup("mbonl82010_p5", "", "")
					else
						Form.CloseForm()
					end if 
				end if
			next
		end if	
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl82010_p5" then
		' mbonl82010_p5 이 팝업의 리턴
		if trim(sRet) == "ok" then
			Form.CloseForm()
		else
'			Form.OpenPopup("mbonl82010_p5", "", "")
		end if
	end if
End Sub

'============================================================================
Sub imgNext_OnClick()
	if g_nCnt > 0 then
		Dim bClose
		bClose = false
		
		if g_nCnt == 1 then
			bClose = true
		else
			if g_nCnt > g_nIndex then
				g_nIndex = g_nIndex + 1
				f_SetUI()
			elseif g_nCnt == g_nIndex then
				bClose = true  
			end if
		end if
			
		if bClose == true then
			for i = 0 to #g_tAgreeIndex -1
				Dim szScreenNo
				szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
				if szScreenNo == "82100" or szScreenNo == "82020" then
					if g_tAgreeIndex[i] == "3" or szScreenNo == "82110" then
						Form.OpenPopup("mbonl82010_p5", "", "")
					else
						Form.CloseForm()
					end if 
				else
					if g_tAgreeIndex[i] == "4" then
						Form.OpenPopup("mbonl82010_p5", "", "")
					else
						Form.CloseForm()
					end if 
				end if
			next
		end if	
	end if
End Sub

'============================================================================
Sub imgPrev_OnClick()
	if g_nCnt > 0 then
		if g_nIndex > 1 then
			g_nIndex = g_nIndex - 1
			f_SetUI()
		end if	
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgPrev.setMaintainingRatio("1")
	imgNext.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	btnClose_OnClick()
End Sub

	</SCRIPT_INFO>
</ROOT>