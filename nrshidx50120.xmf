	<SCRIPT_INFO _len="70825" _ulen="63924" >
Dim gOsType				'OS타입
Dim gPannelIndex 			'현재 판넬 인덱스값
Dim gWidePannelIndex 		'펼쳐보기한 판넬 인덱스값

Dim gFoldPannelHeight		'펼쳐보기 시 판넬 행높이
Dim gUnFoldPannelHeight	'평상 시 판넬 행높이

Dim gCompareMode 			'종목비교 모드여부

Dim gContUpPos			'위로 스크롤 시 컨테이너 top값
Dim gContDownPos			'아래로 스크롤 시 컨테이너 top값

Dim gKeywordIndex			'라디오그룹 선택 키워드 인덱스

Dim gCompareItemIndex1 	'선택종목1
Dim gCompareItemIndex2		'선택종목2
Dim gCompareBtnShow		'비교하기버튼 보임여부

Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gFilterNationCode		'필터(국가 구분 설정값)
Dim gFilterSortingCode		'필터(정렬 구분 설정값)

Dim gETF_SUPER_HIS_KEY		'히스토리 관리 키
gETF_SUPER_HIS_KEY = "ETF_SUPER_HISTORY"

Dim gExSelectIndex		'이전 선택행 값
gExSelectIndex = -1

Dim gSearchText			'검색어
gSearchText = ""

Dim gOvrsMarketList()
gOvrsMarketList = {"AX","NY","OQ","SZ","SH","HK","JP"}

'============================================================================
Sub Form_OnFormInitBefore()

	'--------------------------------------------------------------
	'이미지 비율 유지
	'--------------------------------------------------------------
	contSearch.ImageIconSearch.setMaintainingRatio("1")
	contBody.Image0.setMaintainingRatio("1")
	contBody.imgNotice.setMaintainingRatio("1")
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		contSearch.EditSearch.fontsize = - Cint((gsLargeFontsize * 2))
		contBody.BtnCompare.fontsize = - Cint((gsLargeFontsize * 2))
		contBody.LabelFilter.fontsize = -3 - Cint((gsLargeFontsize * 2))
		contKeyword.RadioGroup0.fontsize = -3 - Cint((gsLargeFontsize * 2))
		
	end if	

	'--------------------------------------------------------------
	'OS타입
	'--------------------------------------------------------------
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	
	'--------------------------------------------------------------
	'판넬관련 전역변수 설정 
	'--------------------------------------------------------------
	
	'행 펼쳤을때/접혔을때 높이값 설정
	if gOsType == "1" then
		gFoldPannelHeight = 174
		gUnFoldPannelHeight = 103
	else
		gFoldPannelHeight = 174
		gUnFoldPannelHeight = 102
	end if
	
	gPannelIndex = 0
	gWidePannelIndex = -1
	gCompareMode = false
	
	'--------------------------------------------------------------
	' 스크롤관련 전역변수 설정
	'--------------------------------------------------------------
	'위/아래 스크롤 시 컨테이너 top값 지정
	gContUpPos = 0
	gContDownPos = 256
	
	'--------------------------------------------------------------
	' 종목비교관련  전역변수 설정
	'--------------------------------------------------------------
	gKeywordIndex = -1
	gCompareItemIndex1 = -1
	gCompareItemIndex2 = -1
	gCompareBtnShow = false
	
	'--------------------------------------------------------------
	' 필터(조회국가/정렬기준) 관련 전역변수 설정 
	'--------------------------------------------------------------
	gFilterNationCode = "Y@N@N@N@N@N"
	gFilterSortingCode = "-1"
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'-------------------------------------------------------
	' 안드로이드 음성검색 버튼 활성화
	'-------------------------------------------------------
	if gOsType == "1" then
		contSearch.EditSearch.width = 259
		contSearch.ImageSearchBG.width = 285
		contSearch.ImageSearchBG0.imgpath = "btn_line2_n.9"
		contSearch.ImageSearchBG0.visible = true
		
		contSearch.Imagemic.setMaintainingRatio("1")
		contSearch.Imagemic.imgpath = "icon_sub_01"
		contSearch.Imagemic.visible = true
	end if
	
	'-------------------------------------------------------
	'(iOS전용) 판넬컨트롤 렌더링 오류 수정
	'-------------------------------------------------------
	contBody.Pannel0.setDataNormal(true)
	
	'-------------------------------------------------------
	'검색창 영역 컨트롤 설정
	'-------------------------------------------------------
	contSearch.bgcolor = 320
	contSearch.EditSearch.SetOnOffImage("alpha", "alpha")
	contSearch.ImageSearchBG.imgpath = "btn_line2_n.9"
	
	'-------------------------------------------------------
	' 데이터영역 컨트롤 설정
	'-------------------------------------------------------
	contBody.LabelSearchResultCnt.paddinginfo = "0,0,0,0"
	contBody.LabelSearchResultCnt.fgcolor = 321
	contBody.LabelFilter.paddinginfo = "0,0,0,0"
	
	'--------------------------------------------------------------
	'이전 설정값 존재 시 설정
	'--------------------------------------------------------------
	ApplyExCondData()
	
	'--------------------------------------------------------------
	'관심종목리스트 조회
	'--------------------------------------------------------------
	Form.requestIntrItemList("00")
	
	'----------------------------------------------------------------
	' 화면진입 후 첫 스크롤 시, fixTopAreaWhenScrolling 자연스럽게
	'----------------------------------------------------------------
	contBody.gesture = true
	
	'-------------------------------------------------------
	' 데이터 조회
	'-------------------------------------------------------
	RequestData("ohhts_metf_001r")
	
	
End Sub

'============================================================================
' 종목검색창 클릭 시
'============================================================================
Sub contSearch_EditSearch_OnClick()
	contSearch.ImageSearchBG.imgpath = "btn_line2_o.9"
End Sub

'============================================================================
' 종목검색창 입력 완료 시
'============================================================================
Sub contSearch_EditSearch_OnEditComplete()
	contSearch.ImageSearchBG.imgpath = "btn_line2_n.9"
	
	sCurSearchText = contSearch.EditSearch.caption
	if sCurSearchText <> gSearchText then
		Form.SetTimerEvent2(1, 0, 0.5)
		RequestData("ohhts_metf_001r")
	end if
	
	'20240327_2
	Form.SetTimerEvent2(2, 1, 0.2)
	'ContSizeByType("COMPLETE")
	
	
End Sub

'============================================================================
' 종목검색창 입력 중
' (입력 시 타이머 이벤트 발생, 중간에 입력 다시 들어오면 기존 타이머 취소 후 새로걸어줌)
'============================================================================
Sub contSearch_EditSearch_OnEditChar(CharCode)
	
	Form.SetTimerEvent2(1, 0, 0.5)
	Form.SetTimerEvent2(1, 1, 0.5)
	
	'20240327_2
	if CharCode <> "" then
		ContSizeByType("ENTERING")
	end if
	
End Sub
'============================================================================
' 검색어 입력상태에 따른 컨테이너 사이즈 조절
'============================================================================
Function ContSizeByType(sType)

	if sType == "ENTERING" then
		
		contBody.top = 78
		contBody.height = 611 - 78
		contBody.Pannel0.height = 550 - 78
		
		contBody.SetScrollAutoSize()
		
	elseif sType == "COMPLETE" then
		
		searchText = contSearch.EditSearch.caption
		
		'검색어 없을 시, 원래 사이즈로 원복
		if searchText == "" then
		
			contBody.top = 256
			contBody.height = 355
			contBody.Pannel0.height = 295
		
		else
			
			contBody.top = 78
			contBody.height = 611 - 78
			contBody.Pannel0.height = 550 - 78
			
		end if
		
		contBody.SetScrollAutoSize()
		
	elseif sType == "RESET" then
		
		'원래 사이즈로 원복
		contBody.top = 256
		contBody.height = 355
		contBody.Pannel0.height = 295
		
		contBody.SetScrollAutoSize()
		
	end if
	
End Function

'============================================================================
' 종목검색
' 서비스 호출 시점에 이전 검색어와 동일검색어가 입력되어있을 시, 서비스 호출하지 않음.
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	'검색서비스 호출
	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 0.5)
		
		sCurSearchText = contSearch.EditSearch.caption
		if sCurSearchText <> gSearchText then
			RequestData("ohhts_metf_001r")
			gSearchText = sCurSearchText
		end if
	
	'결과 개수에 따른 컨테이너 높이/위치 조정
	elseif sTimerID == 2 or sTimerID == "2" then
		Form.SetTimerEvent2(2, 0, 0.2)
		
		nCnt = Cint(contBody.Pannel0.rowcount)
		
		if nCnt > 0 then
			ContSizeByType("COMPLETE")
		else
			ContSizeByType("RESET")
		end if
		
	end if
	
End Sub

'============================================================================
' 데이터 조회 처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_metf_001r" then
		
		'--------------------------
		' 토탈조회건수 세팅
		'--------------------------
		nTotalCnt = DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock1", "FID_IQRY_CSNU" , 0)
		'contBody.LabelSearchResultCnt.caption = "검색결과 "..Cint(nTotalCnt).."건"
		contBody.LabelSearchResultCnt.caption = Cint(nTotalCnt)
		
		'----------------------------------------------------
		'현재 아웃블럭 데이터 조회건수
		'----------------------------------------------------
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_001r", "OutBlock2")
		
		'------------------------------------------------------------------------------
		'토탈건수로 contBody 내 데이터조회 영역 컨트롤 보임/숨김처리
		'현재아웃블럭 개수에 따라 데이터행 개수 세팅
		'------------------------------------------------------------------------------
		CheckDataCnt(Cint(nTotalCnt))
		SetPannelRowCnt(gPannelIndex + nCnt)
	
		for i = 0 to nCnt - 1
		
			'--------------------------
			'데이터 가져오기
			'--------------------------
			sName 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FIDX_KOR_ISNM" , i)
			sCode 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_OVRS_ISCD" , i)
			sMarket  = DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , i)
			sPrice 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_PRPR" , i)
			sDebi 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_PRDY_CTRT" , i)
			sBosu 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_TOTAL_PAY_RATE" , i)
			sNAV 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FIDX_NAV" , i)
			sVol 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_VOL" , i)
			sNation 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_LSTN_NTNL_CODE" , i)
			
			sRlim 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_RLIM" , i)
			sNew		= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_NEW_LSTN_YN" , i)
			sTrht	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_TRHT_YN", i)
			sSign 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_001r", "OutBlock2", "FID_PRDY_VRSS_SIGN" , i)
			
			'--------------------------
			'바디데이터 행 생성 및 컨트롤 위치조정
			'--------------------------
			
			'20240223
			'contBody.Pannel0.AddRow()
			ChangeControlPosAndRowHeight(1,i + gPannelIndex)
			
			
			'--------------------------
			'바디데이터 입력
			'--------------------------
			'국가
			sNationFlagName = GetNationFlagName(sNation)
			contBody.Pannel0.setPropCardCell("maintainratio","ImageFlag",i + gPannelIndex,"1")
			contBody.Pannel0.setPropCardCell("imgpath","ImageFlag",i + gPannelIndex,sNationFlagName)
			
			'--------------------------
			'종목명
			'--------------------------
			contBody.Pannel0.SetCellValue("LabelName",i + gPannelIndex,sName)
			
			'--------------------------
			'종목코드(티커)
			'--------------------------
			contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sCode)
			contBody.Pannel0.SetCellValue("LabelBodyTicker",i + gPannelIndex,sCode)
			
			'--------------------------
			'거래소구분코드
			'--------------------------
			contBody.Pannel0.SetCellValue("LabelBodyMarket",i + gPannelIndex,sMarket)
			
			'--------------------------
			'현재가
			'--------------------------
			nDecimalLen = GetNationDecimalLen(sNation)
			sPrice = FormatNumber(sPrice,nDecimalLen)
			contBody.Pannel0.SetCellValue("LabelHyun",i + gPannelIndex,sPrice.." | "..sDebi.."%")
			
			'--------------------------
			'등락률(현재가 라벨과 통합)
			'--------------------------
			'contBody.Pannel0.SetCellValue("LabelDebi",i + gPannelIndex,sDebi)
			
			'--------------------------
			'현재가/등락률 색상표시
			'--------------------------
			if sSign == "2" then '상승
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"290")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"290")
			elseif sSign == "5" then '하락
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"291")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"291")
			else '보합
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"333")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"333")
			end if
			
			
			'--------------------------
			'보수
			'--------------------------
			if Cdbl(sBosu) == 0 then
				
				sTransBosu = "-"
			else
				'sTransBosu = Decimal_Setting(sBosu,2) .. "%"
				sTransBosu = sBosu .. "%"
			end if
			contBody.Pannel0.SetCellValue("LabelBosuData",i + gPannelIndex,sTransBosu)
			
			'--------------------------
			'NAV
			'--------------------------
			if Cdbl(sNAV) == 0 then
				sTransNAV = "-"
			else
				'sTransNAV = Decimal_Setting(sNAV,2)
				sTransNAV = FormatNumber(sNAV,2)
			end if
			contBody.Pannel0.SetCellValue("LabelNAVData",i + gPannelIndex,sTransNAV)
			
			'--------------------------
			'거래량
			'--------------------------
			contBody.Pannel0.SetCellValue("LabelVolData",i + gPannelIndex,sVol)
			
			'--------------------------
			'거래정지
			'--------------------------
			if sTrht == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | " .. "거래정지"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'--------------------------
			'신규상장 여부
			'--------------------------
			if sNew == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | " .. "신규상장"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'--------------------------
			'편입비중
			'--------------------------
			if Cdbl(sRlim) > 0 then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | 편입비중 " .. sRlim .. "%"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'--------------------------
			'관심종목/체크 이미지 세팅
			'--------------------------
			if gCompareMode then
				contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i + gPannelIndex,"1")
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"checkmenu_n")
			else
				
				'20240221 START
				'국내=종목코드 / 해외=거래소구분@종목코드
				bReg = false
				if sNation == "KOR" then
					bReg = Form.isIntrItemList(sCode)
				else
					bReg = Form.isIntrItemList(sMarket.."@"..sCode)
				end if
				
				if bReg then
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"Y")
					contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i + gPannelIndex,"1")
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_like_o")
				else
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"N")
					contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i + gPannelIndex,"1")
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_like_n")
				end if
				'20240221 END
				
			end if
			
		next
		
		'20240223
		'CheckDataCnt(Cint(contBody.Pannel0.rowcount))
		
		'------------------------------------------------------------------------------
		'이전 선택행 인덱스값 존재 시 이전행 인덱스가 나올떄까지 자동 재조회 후 자동이동
		'------------------------------------------------------------------------------
		if gExSelectIndex <> "-1" then
			nRow = Cint(contBody.Pannel0.rowcount)
			nIndex = Cint(gExSelectIndex)
			
			'아직 선택행만큼 행수가 생기지 않았으면 재조회
			'선택행만큼 행수가 생겼으면 해당위치로 이동 후 gExSelectIndex 초기화
			'연속조회 끝까지 선택행이 안나오면 그냥 초기화
			if nRow >= nIndex then
				
				'20240424 안드로이드 앱 수정 후 배포해야됨
				'(안드로이드 전용) 안드로이드가 스크롤이 생성되기전에 toprow가 호출되어
				'ScrollNoTop에서 호출되는 fixTopAreaWhenScrolling가 호출이 안됨.
				'안드로이드만 이부분에서 플래그값 바꾸는 용도로 호출
				if gOsType == "1" then
					contBody.fixTopAreaWhenScrolling("1", gContUpPos, "Up")	
				end if
			
				contBody.Pannel0.toprow = nIndex
				gExSelectIndex = "-1"
				
			else
				
				if DATAMANAGER.IsMoreNextData("ohhts_metf_001r") then
					gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
					DATAMANAGER.RequestNextData("ohhts_metf_001r")
				else
					gExSelectIndex = "-1"
				end if
				
			end if
			
			
		end if
		'------------------------------------------------------------------------------
		'
		'------------------------------------------------------------------------------	
		
	
	end if

	
End Sub

'============================================================================
' 판넬컨트롤 스크롤 완료 시
'============================================================================
Sub contBody_Pannel0_OnScrollEnd()

	if DATAMANAGER.IsMoreNextData("ohhts_metf_001r") then
		gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
		DATAMANAGER.RequestNextData( "ohhts_metf_001r" )
	end if 
	
End Sub

'============================================================================
' 판넬컨트롤 클릭 이벤트(행 펼치기/관심종목 등록,삭제)
'============================================================================
Sub contBody_Pannel0_OnClick(nIndex, sCellID)


		'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
		
			'관심종목등록/종목비교 체크버튼 이 아닌 경우에는 행을 펼침
			'ButtonIntrCheck => 하트/체크이미지를 너무 정확하게 눌러야되서 근처영역 클릭 시 동작할 수 있게 버튼하나 올림
			if sCellID <> "ImageIntrCheck" and sCellD <> "LabelDebi" and sCellID <> "ButtonIntrCheck" then
				gWidePannelIndex = nIndex
				foldBottomLinkArea(nIndex,gFoldPannelHeight)
				
			else
			
				'종목비교모드가 아니면 관심종목 등록 버튼 클릭 시 관심종목 추가팝업 오픈
				if gCompareMode <> true then
					szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
					szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
					'20240221 START 등록완료 후 몇번째 행을 처리했는지 리턴받기 위해 넘김.
					sReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",nIndex)
					
					if sReg == "Y" then
						sParam = "DEL" .. "★" .. nIndex
						'Form.OpenPopupAnimation("nrshidx50600_p4", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목삭제
						if szMk == "J" then
							Form.OpenPopup("nrshidx50600_p4" , szItemCode& "★"& sParam , "")
						else
							Form.OpenPopup("nrshidx50600_p4" , szMk.."@"..szItemCode& "★"& sParam , "")
						end if
					else
						sParam = "ADD" .. "★" .. nIndex
						
						if szMk == "J" then
							Form.OpenPopupAnimation("nrshidx50600_p2", szItemCode& "★"& sParam,"", "2")	'종목등록
						else
							Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목등록
						end if
						
					end if
					'20240221 END
				
				'종목비교모드라면 선택행 체크(단 최대 2개까지만 선택가능)
				else
					
					SetCompareItem(nIndex)
				
				end if
				
			end if
		
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			'링크버튼or관심종목 등록 영역 클릭 시(접히면 안되는 경우임)
			'ButtonIntrCheck => 하트/체크이미지를 너무 정확하게 눌러야되서 근처영역 클릭 시 동작할 수 있게 버튼하나 올림
			if isLinkButton(sCellID) then
				
				if sCellID == "ImageIntrCheck" or sCellID == "LabelDebi" or sCellID == "ButtonIntrCheck" then
					
					'종목비교모드가 아니면 관심종목 추가팝업 오픈
					if gCompareMode <> true then
						szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
						szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
						'20240221 START 등록완료 후 몇번째 행을 처리했는지 리턴받기 위해 넘김.
						sReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",nIndex)
						
						if sReg == "Y" then
							sParam = "DEL" .. "★" .. nIndex
							'Form.OpenPopupAnimation("nrshidx50600_p4", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목삭제
							if szMk == "J" then
								Form.OpenPopup("nrshidx50600_p4" , szItemCode& "★"& sParam , "")
							else
								Form.OpenPopup("nrshidx50600_p4" , szMk.."@"..szItemCode& "★"& sParam , "")
							end if
							
							
						else
							sParam = "ADD" .. "★" .. nIndex
							
							if szMk == "J" then
								Form.OpenPopupAnimation("nrshidx50600_p2", szItemCode& "★"& sParam,"", "2")	'종목등록
							else
								Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목등록
							end if
							
						end if
						'20240221 END
					
					'종목비교모드라면 선택행 체크(단 최대 2개까지만 선택가능)
					else
						
						SetCompareItem(nIndex)
					
					end if
					
				'화면링크버튼 클릭 시, 히스토리 리스트에 쌓는다.
				elseif sCellID == "ButtonLink0" then '현재가
					
					SetHistory("set",nIndex)
					MoveScreen("hyun",nIndex)
				
				elseif sCellID == "ButtonLink1" then '차트
				
					SetHistory("set",nIndex)
					MoveScreen("chart",nIndex)
				
				elseif sCellID == "ButtonLink2" then '종목정보
				
					SetHistory("set",nIndex)
					MoveScreen("info",nIndex)
				
				elseif sCellID == "ButtonLink3" then '매수
				
					SetHistory("set",nIndex)
					MoveScreen("mesu",nIndex)
				
				elseif sCellID == "ButtonLink4" then '매도
				
					SetHistory("set",nIndex)
					MoveScreen("medo",nIndex)
					
				end if
				
				
			'링크버튼 외 영역 클릭 시(접혀도 되는 경우임)
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
				
				end if
			
			
			end if
			
		end if
		
		
	

	
End Sub

'============================================================================
' 종목검색 서비스 호출
'============================================================================
Function RequestData(szTranID)

	if szTranID == "ohhts_metf_001r" then
		
		SetDefaultGlobalVariable()
		
		'20240223
		'contBody.Pannel0.rowcount = 0
		
		'------------------------------------------------------------------------------------------
		'(필터> 국가구분) sTransNationCode => 화면에서는 Y@N@N... 이런식으로 관리 서비스에 올릴때는 YNN 형식으로 올려줘야함.
		'(필터> 정렬구분) sTransSortingCode => 화면에서 default = -1 , 서비스 default = 0이므로 하나 더해서 올려줌.
		'(직접검색or키워드검색 인덱스) sKeywordIndex => 
		'------------------------------------------------------------------------------------------
		sTransNationCode = replace(gFilterNationCode,"@","")
		
		'---------------------------------------------------------
		' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
		'---------------------------------------------------------
		'sTransSortingCode = gFilterSortingCode + 1
		sTransSortingCode = GetSortingCodeForTran()
		'---------------------------------------------------------
		' 20240612 LES END
		'---------------------------------------------------------
		
		sKeywordIndex = gKeywordIndex + 1
		
		DATAMANAGER.SetDataValue( 0, "ohhts_metf_001r", "InBlock1", "FID_INPUT_SRCH_NAME",		 0, contSearch.EditSearch.caption )
		DATAMANAGER.SetDataValue( 0, "ohhts_metf_001r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 		 0, sTransNationCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_metf_001r", "InBlock1", "FID_INPUT_CLS_CODE", 		 0, sKeywordIndex)
		DATAMANAGER.SetDataValue( 0, "ohhts_metf_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE",	 0, sTransSortingCode)
		
		for i = 0 to #gOvrsMarketList - 1 
			
			'0:지연 / 1:실시간
			sRealSiseYN = GetRealTimeSiseYN(gOvrsMarketList[i])
			
			if sRealSiseYN == "" then
				sRealSiseYN = "0"
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_metf_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , i , gOvrsMarketList[i])
			DATAMANAGER.SetDataValue(0, "ohhts_metf_001r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , i , sRealSiseYN)
			
		next
		
		
		DATAMANAGER.RequestTranData("ohhts_metf_001r")
		
		SetFilterText()
	
	end if


End Function

'============================================================================
' 숫자형반환 
'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
' 선택행 링크영역 펼치기
'============================================================================
Function foldBottomLinkArea(nIndex,nHeight)
	
	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","ImageBottomLinkBG",nIndex,"100") 
	contBody.Pannel0.setPropCardCell("top","ButtonLink0",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink1",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink2",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink3",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink4",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"173")
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"1")
	
	'========================================
	'마지막행 클릭 시 스크롤 자동 이동
	'========================================
	'nLastIndex = contBody.Pannel0.rowcount - 1
	'	
	'if nIndex ==  nLastIndex then
	'	contBody.Pannel0.toprow = nIndex
	'end if
	
	'nContBodyTop 		: 리스트가 접힌상태인지 펼침 상태인지 구분
	'nVisibleStartRowIndex : 현재보여지는 리스트의 첫행 인덱스
	'nIndex 				: 선택한 행의 인덱스
	'nDiffIndex			: nIndex - nVisibleStartRowIndex 의 값에 따라 얼마나 스크롤을 이동시켜줄지 결정
	
	nContBodyTop = Cint(contBody.top)
	nVisibleStartRowIndex = Cint(contBody.Pannel0.toprow)
	nDiffIndex = nIndex - nVisibleStartRowIndex
	
	'리스트 접힘 상태
	if nContBodyTop > 250 then
	
		if nDiffIndex >= 2 then
			if nDiffIndex == 2 then
				contBody.Pannel0.toprow = nVisibleStartRowIndex + 1
			else
				contBody.Pannel0.toprow = nVisibleStartRowIndex + 2
			end if
			
		end if
	
	'리스트 펼침 상태
	else
	
		if nDiffIndex >= 4 then
			if nDiffIndex == 4 then
				contBody.Pannel0.toprow = nVisibleStartRowIndex + 1
			elseif nDiffIndex == 5 then
				contBody.Pannel0.toprow = nVisibleStartRowIndex + 2
			else
				contBody.Pannel0.toprow = nVisibleStartRowIndex + 3
			end if
			
		end if
	
	end if 
	
	
End Function

'============================================================================
' 선택행 링크영역 접기
'============================================================================
Function unfoldBottomLinkArea(nIndex,nHeight)

	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"101")
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
End Function

'============================================================================
' 판넬클릭 시, 링크버튼 + 관심종목 버튼 클릭 여부 확인
'============================================================================
Function isLinkButton(sCellID)
	
	if sCellID == "ButtonLink0" or sCellID == "ButtonLink1" or sCellID == "ButtonLink2" or sCellID == "ButtonLink3" or sCellID == "ButtonLink4" or sCellID == "ImageIntrCheck" or sCellID == "LabelDebi" or sCellID == "ButtonIntrCheck" then
		return true
	else
		return false
	end if

End Function

