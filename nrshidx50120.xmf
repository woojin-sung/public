'============================================================================
' 링크버튼 화면이동 이벤트
'============================================================================
Function MoveScreen(sType,nIndex)

	'화면이동 전 현재설정 값 저장
	SaveCurCondData(nIndex)

	'---------------------------------------------------------
	'현재가 > 호가
	'---------------------------------------------------------
	if sType == "hyun" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."1")
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
			end if
			
		end if
	
	'---------------------------------------------------------
	'차트
	'---------------------------------------------------------
	elseif sType == "chart" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("13000" , szItemCode)
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16020", "")	
			end if
			
		end if
	
	'---------------------------------------------------------
	' 현재가 > 종목정보
	'---------------------------------------------------------
	elseif sType == "info" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."0")
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."0")
			end if
			
		end if
	
	'---------------------------------------------------------
	' 주문(매수)
	'---------------------------------------------------------
	elseif sType == "mesu" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			
			Form.OpenScreen("12000" , "기타".."★".."0".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "0") '매수	
			end if
			
		
		end if
	
	'---------------------------------------------------------
	' 주문(매도)
	'---------------------------------------------------------
	elseif sType == "medo" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
		
			Form.OpenScreen("12000" , "기타".."★".."1".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "1") '매도	
			end if
		
		end if
	
	end if

End Function

'============================================================================
' 이전 검색 조건값 적용
'============================================================================
Function ApplyExCondData()
	
	'----------------------------------------------------------------------------
	'이전값 가져오기
	'----------------------------------------------------------------------------
	sEditCaption 		 	= Form.GetSharedData("ETF_DIRECT_CAPTION", false )
	sKeyWordIndex 	 	= Form.GetSharedData("ETF_DIRECT_KEWORD_INDEX", false )
	
	sFilterNationCode  	= Form.GetSharedData("ETF_DIRECT_FILTER_NATION", false )
	sFilterSortingCode 	= Form.GetSharedData("ETF_DIRECT_FILTER_SORT", false )
	nIndex 			 	= Form.GetSharedData("ETF_DIRECT_SELECT_INDEX", false )
	
	'----------------------------------------------------------------------------
	'이전값 메모리영역 데이터 클리어
	'----------------------------------------------------------------------------
	'Form.SetSharedData("ETF_SUPER_SEARCH_INDEX" , "")
	Form.SetSharedData("50100_INDEX" , "")
	Form.SetSharedData("ETF_DIRECT_CAPTION" , "")
	Form.SetSharedData("ETF_DIRECT_KEWORD_INDEX" , "")
	Form.SetSharedData("ETF_DIRECT_FILTER_NATION" , "")
	Form.SetSharedData("ETF_DIRECT_FILTER_SORT" , "")
	Form.SetSharedData("ETF_DIRECT_SELECT_INDEX" , "")
	
	'----------------------------------------------------------------------------
	'이전값 세팅
	'----------------------------------------------------------------------------
	
	'1)검색어
	contSearch.EditSearch.caption = sEditCaption
	gSearchText = sEditCaption
	
	'2)키워드 인덱스
	'라디오그룹 OnClick이벤트를 타면서 전역변수에 자동으로 세팅됨.
	'gKeywordIndex = sKeyWordIndex
	if sKeyWordIndex <> "" then
		contKeyword.RadioGroup0.currentindex = sKeyWordIndex
	end if
	
	'3)필터 국가
	gFilterNationCode = sFilterNationCode
	
	if gFilterNationCode == "" then
		gFilterNationCode = "Y@N@N@N@N@N"
	end if
	
	'4)필터 정렬
	gFilterSortingCode = sFilterSortingCode
	
	if gFilterSortingCode == "" then
		gFilterSortingCode = "-1" 
	end if
	
	'5)선택행
	gExSelectIndex = nIndex
	if nIndex == "" then
		gExSelectIndex = "-1"
	end if
	
	'Form.ShowAlert("test", "검색어 : ".. sEditCaption.."\n".. "키워드 : " .. gKeywordIndex.."\n".. "필터국가 : " .. gFilterNationCode.."\n".."필터정렬 : ".. gFilterSortingCode.."\n".. "선택행 : " .. gExSelectIndex)
	

End Function

'============================================================================
' 현재 검색 조건값 저장
'============================================================================
Function SaveCurCondData(nIndex)
	
	'---------------------------------------------------------------
	'저장 검색조건 리스트
	'---------------------------------------------------------------
	'검색어 : EditSearch.caption
	'키워드선택값 : gKeywordIndex(초기값 -1)
	'필터조건값(국가/정렬) : gFilterNationCode (초기값 Y@N@N@N@N@N) / gFilterSortingCode (초기값 -1)
	'선택종목 인덱스 : nIndex
	'---------------------------------------------------------------
	
	'------------------------------------------
	' 현재 화면위치
	'------------------------------------------
	'Form.SetSharedData("ETF_SUPER_SEARCH_INDEX" , "1")
	Form.SetSharedData("50100_INDEX" , "1")
	
	'------------------------------------------
	' 검색어
	'------------------------------------------
	sEditCaption 	= contSearch.EditSearch.caption
	Form.SetSharedData("ETF_DIRECT_CAPTION" , sEditCaption)
	
	'------------------------------------------
	' 키워드 인덱스
	'------------------------------------------
	sKeyWordIndex = gKeywordIndex
	Form.SetSharedData("ETF_DIRECT_KEWORD_INDEX" , sKeyWordIndex)
	
	'------------------------------------------
	' 필터 국가
	'------------------------------------------
	sFilterNationCode = gFilterNationCode
	Form.SetSharedData("ETF_DIRECT_FILTER_NATION" , sFilterNationCode)
	
	'------------------------------------------
	' 필터 정렬
	'------------------------------------------
	sFilterSortingCode = Cstr(gFilterSortingCode)
	Form.SetSharedData("ETF_DIRECT_FILTER_SORT" , sFilterSortingCode)
	
	'------------------------------------------
	' 선택종목 인덱스
	'------------------------------------------
	Form.SetSharedData("ETF_DIRECT_SELECT_INDEX" , Cstr(nIndex))
	
End Function

'============================================================================
Function SetFilterText()

	'-------------------------------------------------
	' 국가필터값 텍스트 추출
	'-------------------------------------------------
	sNationFilterText = ""
	if gFilterNationCode == "" then
		sNationFilterText = "필터"
	else
	
		arrNationFlag = Split(gFilterNationCode,"@")
		
		for i = 0 to #arrNationFlag - 1
			
			if i == 0 then
				
				sFlag = arrNationFlag(0)
				
				if sFlag == "Y" then
					sNationFilterText = "전체"
					exit for
				end if
				
			else
				
				sFlag = arrNationFlag(i)
				
				if sFlag = "Y" then
					
					if i == 1 then
						if sNationFilterText == "" then
							sNationFilterText = "국내"
						else
							sNationFilterText = sNationFilterText.."·국내"
						end if
					elseif i == 2 then
						if sNationFilterText == "" then
							sNationFilterText = "미국"
						else
							sNationFilterText = sNationFilterText.."·미국"
						end if
					elseif i == 3 then
						if sNationFilterText == "" then
							sNationFilterText = "중국"
						else
							sNationFilterText = sNationFilterText.."·중국"
						end if
					elseif i == 4 then
						if sNationFilterText == "" then
							sNationFilterText = "홍콩"
						else
							sNationFilterText = sNationFilterText.."·홍콩"
						end if
					elseif i == 5 then
						if sNationFilterText == "" then
							sNationFilterText = "일본"
						else
							sNationFilterText = sNationFilterText.."·일본"
						end if
					end if
				
				end if
			
			end if
		
		next
		
	
	end if
	
	'---------------------------------------------------------
	' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
	'---------------------------------------------------------
	' 정렬기준 필터 텍스트 추출
	'-------------------------------------------------
	sFilterSortingCode = ""
	if gFilterSortingCode == 0 or gFilterSortingCode == "0" then
		sFilterSortingCode = "상승률 낮은순"
	elseif gFilterSortingCode == 1 or gFilterSortingCode == "1" then
		sFilterSortingCode = "상승률 높은순"
	elseif gFilterSortingCode == 2 or gFilterSortingCode == "2" then
		sFilterSortingCode = "거래량 적은순"
	elseif gFilterSortingCode == 3 or gFilterSortingCode == "3" then
		sFilterSortingCode = "거래량 많은순"
	elseif gFilterSortingCode == 4 or gFilterSortingCode == "4" then
		sFilterSortingCode = "    보수 낮은순"
	elseif gFilterSortingCode == 5 or gFilterSortingCode == "5" then
		sFilterSortingCode = "    보수 높은순"
	end if
	
	'Form.ShowAlert(sNationFilterText, sFilterSortingCode)
	'-------------------------------------------------
	' 20240612 LES END
	'-------------------------------------------------
	
	'-------------------------------------------------
	' 세팅
	'-------------------------------------------------
	if sNationFilterText == "전체" and sFilterSortingCode == "" then
			
			contBody.LabelFilter.fontsize = -2
			contBody.LabelFilter.SetMaxLineCount(1)
			contBody.LabelFilter.caption = "필터"
	else
			
			if sFilterSortingCode == "" then
				contBody.LabelFilter.fontsize = -2
				contBody.LabelFilter.SetMaxLineCount(1)
				contBody.LabelFilter.caption = sNationFilterText
			else
				contBody.LabelFilter.fontsize = -2
				contBody.LabelFilter.SetMaxLineCount(2)
				contBody.LabelFilter.caption = sNationFilterText.." " .. "\n"..sFilterSortingCode
			end if
	end if
	
	

End Function

'============================================================================
' 시장별 실시간/지연 여부 가져오기
'============================================================================
Function GetRealTimeSiseYN(sMarketCode)
	
	szRealAble = Form.GetSharedData( "REALTIME_"&sMarketCode, false )
	return szRealAble
	
End Function


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'---------------------------------------------------------------
	' requestIntr 함수 호출 후 조회 완료 시 발생
	' 관심종목 등록이미지로 변경 못할 경우를 대비하여 다시 칠해준다.
	'---------------------------------------------------------------
	if sEventName == "REFRESH_INTR_ITEM" then
		
		nCnt = contBody.Pannel0.rowcount
		
		for i = 0 to nCnt - 1
			
			'--------------------------
			'관심종목/체크 이미지 세팅
			'--------------------------
			if gCompareMode <> true then
				
				'국내=종목코드 / 해외=거래소구분@종목코드
				sMarket 	= contBody.Pannel0.GetCellValue("LabelBodyMarket",i)
				sCode 	= contBody.Pannel0.GetCellValue("LabelBodyTicker",i)
				
				bReg = false
				if sMarket == "J" then
					bReg = Form.isIntrItemList(sCode)
				else
					bReg = Form.isIntrItemList(sMarket.."@"..sCode)
				end if
				
				'----------------------------------------------------
				' 관심종목에 등록되어 있는 종목이지만, 
				' 판넬상에서 이미지 변경이 안된 행이 있으면 변경해준다.
				'----------------------------------------------------
				if bReg then
					sIntrYN = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",i)
					
					if sIntrYN <> "Y" then
						contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i,"Y")
						contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i,"1")
						contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"icon_like_o")
					end if
				
				end if
			
			end if
		
		next
	
	'----------------------------------------------------
	'음성검색 리턴값 수신
	'----------------------------------------------------
	elseif sEventName == "VOICEINPUT" then
		
		sVoiceText = sParam
		if sVoiceText <> "" then
			contSearch.EditSearch.caption = sVoiceText
			RequestData("ohhts_metf_001r")
		end if
	
	end if
	
End Sub

