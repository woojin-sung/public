'============================================================================
' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
'============================================================================
Function GetSortingCodeForTran()
	
	'-----------------------------------------------------------------------------
	' [gFilterSortingCode] 화면에서 가지고 있는 값으로 서비스에 올려야되는 값 추출 
	'-----------------------------------------------------------------------------
	' [구분]		    [화면값]	 [서비스값]
	'-----------------------------------------------------------------------------
	' 디폴트 		: -1			0
	' 상승률 낮은순 	: 0			2
	' 상승률 높은순 	: 1			1
	' 거래량 적은순 	: 2			5
	' 거래량 많은순 	: 3			3
	' 보수 낮은순   	: 4			4
	' 보수 높은순   	: 5			6
	'-----------------------------------------------------------------------------

	if gFilterSortingCode == -1 or gFilterSortingCode == "-1" then
		return "0"
	elseif gFilterSortingCode == 0 or gFilterSortingCode == "0" then
		return "2"
	elseif gFilterSortingCode == 1 or gFilterSortingCode == "1" then
		return "1"
	elseif gFilterSortingCode == 2 or gFilterSortingCode == "2" then
		return "5"
	elseif gFilterSortingCode == 3 or gFilterSortingCode == "3" then
		return "3"
	elseif gFilterSortingCode == 4 or gFilterSortingCode == "4" then
		return "4"
	elseif gFilterSortingCode == 5 or gFilterSortingCode == "5" then
		return "6"
	end if
	 

End Function

