'============================================================================
' 비교종목 설정
'============================================================================
Function SetCompareItem(nIndex)
	
	'선택된 아이템 개수가 최대가능 개수인 경우
	if gCompareItemIndex1 > -1 and gCompareItemIndex2 > -1 then
		
		'첫번째 선택 아이템이랑 동일한 아이템이 또 들어온 경우
		'두번째 아이템을 첫번째로 옮겨주고, 기존 첫번째 아이템 체크 해제 , 두번째 아이템 클리어
		if gCompareItemIndex1 == nIndex then
			gCompareItemIndex1 = gCompareItemIndex2
			gCompareItemIndex2 = -1
			contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_n")
		
		'두번째 선택 아이템이랑 동일한 아이템이 또 뜰어온 경우
		'두번째 아이템 체크해제, 두번째 아이템 클리어
		elseif gCompareItemIndex2 == nIndex then
			gCompareItemIndex2 = -1
			contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_n")
		
		'첫번째/두번째 아이템과 다른 아이템이 들어온 경우
		'최대개수 초과 팝업 발생
		else
			
			Form.ShowAlert("알림", "최대 2개 종목만 선택 가능합니다.")
		
		end if
	
	'선택된 아이템 개수가 최대가능 개수보다 적을 경우
	else
		
		'첫번째 아이템이 들어가있는 경우
		if gCompareItemIndex1 > -1 then
			
			'첫번째 아이템과 동일한 아이템인지 체크
			'동일한 아이템이면 체크해제 및 아이템 클리어
			if gCompareItemIndex1 == nIndex then
				gCompareItemIndex1 = -1
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_n")
			
			'첫번째 아이템과 다른 아이템이면
			'두번째 아이템에 담아줌.
			else
				gCompareItemIndex2 = nIndex	
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_o")
			end if
		
		
		'첫번째/두번째 아이템이 모두 비어있는 경우
		'첫번째 아이템에 담아줌.
		else
			gCompareItemIndex1 = nIndex
			contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_o")
		end if
		
	end if
	
	
	'선택되어있는 종목이 있으면 비교하기 버튼 show
	if gCompareItemIndex1 > -1 or gCompareItemIndex2 > -1 then
		SetShowCompareButton(true)
	else
		SetShowCompareButton(false)
	end if
	
	
	
End Function

'================================================================================
' 종목비교 모드, 종목선택 후 하단 종목비교/초기화 버튼 생성 및 컨트롤 사이즈 조정
'================================================================================
Function SetShowCompareButton(bShow)

	'종목비교모드인 상태
	if gCompareMode then
		
		'종목비교/초기화 버튼 SHOW
		if bShow then
			
			btnReset.visible = true
			btnOk.visible = true
			
			'종목비교/초기화 버튼 보임처리
			'컨테이너/판넬 높이값 조정, 종목비교/초기화 버튼 top값 지정
			if gCompareBtnShow <> true then
				
				gCompareBtnShow = true
				contBody.height = contBody.height - 60
				contBody.Pannel0.height = contBody.Pannel0.height - 60
				
				btnReset.top = contBody.top + contBody.height 
				btnOk.top = contBody.top + contBody.height 
				
				
			end if
		
		'종목비교/초기화버튼 HIDE
		else
			
			'종목비교/초기화 버튼이 보임일때만 높이값 원복
			if gCompareBtnShow then
				contBody.height = contBody.height + 60
				contBody.Pannel0.height = contBody.Pannel0.height + 60
			end if
			
			'종목비교/초기화 버튼 숨김처리
			'컨테이너/판넬 높이값 조정, 종목비교/초기화 버튼 top값 지정
			gCompareBtnShow = false
			
			'20240327
			'contBody.height = contBody.height + 60
			'contBody.Pannel0.height = contBody.Pannel0.height + 60
			
			btnReset.visible = false
			btnOk.visible = false
		
		end if

		contBody.SetScrollAutoSize()	
		
	end if

End Function

'============================================================================
' 비교종목 초기화
'============================================================================
Sub btnReset_OnClick()

	if gCompareMode then
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",gCompareItemIndex1,"checkmenu_n")
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",gCompareItemIndex2,"checkmenu_n")
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
	end if
	
End Sub

'============================================================================
' 비교하기
'============================================================================
Sub btnOk_OnClick()

	if gCompareMode then
		'Form.ShowAlert("선택행", gCompareItemIndex1.."//"..gCompareItemIndex2)
		if gCompareItemIndex1 < 0 or gCompareItemIndex2 < 0 then
			Form.ShowAlert("안내", "비교할 종목을 선택해주세요.")
		else
			
			sCompareItemName1 	= contBody.Pannel0.GetCellValue("LabelName"			,gCompareItemIndex1)
			sCompareItemCode1 	= contBody.Pannel0.GetCellValue("LabelBodyTicker"		,gCompareItemIndex1)
			sCompareItemMarket1 	= contBody.Pannel0.GetCellValue("LabelBodyMarket"		,gCompareItemIndex1)
			
			sCompareItemName2 	= contBody.Pannel0.GetCellValue("LabelName"			,gCompareItemIndex2)
			sCompareItemCode2 	= contBody.Pannel0.GetCellValue("LabelBodyTicker"		,gCompareItemIndex2)
			sCompareItemMarket2 	= contBody.Pannel0.GetCellValue("LabelBodyMarket"		,gCompareItemIndex2)
			
			Form.OpenPopupAnimation("nrshidx50150", sCompareItemName1.."★"..sCompareItemMarket1.."★"..sCompareItemCode1.."@"..sCompareItemName2.."★"..sCompareItemMarket2.."★"..sCompareItemCode2, "", "2")
		
		end if
		
		
	end if
	
End Sub

'============================================================================
' 전역변수 전체 초기화
'============================================================================
Function SetDefaultGlobalVariable()

	'--------------------------------------------------------------
	'판넬관련 전역변수 설정 
	'--------------------------------------------------------------
	gPannelIndex = 0
	gWidePannelIndex = -1
	
	'--------------------------------------------------------------
	' 종목비교관련  전역변수 설정
	'--------------------------------------------------------------
	SetShowCompareButton(false)
	
	contBody.BtnCompare.fgcolor = 338
	contBody.BtnCompare.caption = "종목비교"
	contBody.BtnCompare.btnimage = "btn_36.9"
		
	gCompareItemIndex1 = -1
	gCompareItemIndex2 = -1
	gCompareMode = false
	gCompareBtnShow = false
	
	'--------------------------------------------------------------
	'키워트 관련 전역변수 설정
	'--------------------------------------------------------------
	'gKeywordIndex = -1
	
	'--------------------------------------------------------------
	' 필터(조회국가/정렬기준) 관련 전역변수 설정 
	'--------------------------------------------------------------
	'gFilterNationCode = "Y@N@N@N@N@N"
	'gFilterSortingCode = "-1"
	

End Function

'============================================================================
' 필터설정 팝업 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "FILTER_SET_COMPLETE" then
	
		arrData = Split(sRet,"★")
		gFilterNationCode = arrData(0)
		gFilterSortingCode = arrData(1)
		
		'Form.ShowAlert(gFilterNationCode, gFilterSortingCode)
		
		RequestData("ohhts_metf_001r")
		
	'20240221 START
	elseif sKeyName == "GWAN_ADD_COMPLETE" then
		
		completeIndex = Cint(sRet)
		
		'처리행 관심종목 하트버튼 처리
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",completeIndex,"icon_like_o")
		
		' 판넬 관심등록여부 체크라벨 업데이트
		contBody.Pannel0.SetCellValue("LabelBodyIntrYN",completeIndex,"Y")
		
		'관심종목 리스트(메인에서 관리) 업데이트
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",completeIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",completeIndex)
		
		'ETF는 시장구분코드가 J밖에없어 이 값으로 국내/해외 구분
		if szMk == "J" then
			Form.addIntrItemList(szItemCode)
		else
			Form.addIntrItemList(szMk.."@"..szItemCode)
		end if
	
	elseif sKeyName == "GWAN_DELETE_COMPLETE" then
		
		completeIndex = Cint(sRet)
		
		'처리행 관심종목 하트버튼 처리
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",completeIndex,"icon_like_n")
		
		' 판넬 관심등록여부 체크라벨 업데이트
		contBody.Pannel0.SetCellValue("LabelBodyIntrYN",completeIndex,"N")
		
		'관심종목 리스트(메인에서 관리) 업데이트
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",completeIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",completeIndex)
		
		'ETF는 시장구분코드가 J밖에없어 이 값으로 국내/해외 구분
		if szMk == "J" then
			Form.delIntrItemList(szItemCode)
		else
			Form.delIntrItemList(szMk.."@"..szItemCode)
		end if
	
	'20240221 END
	
	end if
	
End Sub

'============================================================================
' 소수점 자리수 조정
'============================================================================
Function Decimal_Setting(sValue, sDecimalLen)

	if sDecimalLen == 0 then
		return Cint(sValue)
	end if

	Dim sReturn
	sReturn = sValue
	
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
	
end Function

'============================================================================
' 국가코드별 소수점자리 수
'============================================================================
Function GetNationDecimalLen(sNation)
	
	if sNation == "USA" then
		return 4
	elseif sNation =="KOR" then
		return 0
	elseif sNation =="HKG" then
		return 3
	elseif sNation =="CHN" then
		return 3
	elseif sNation =="JPN" then
		return 1
	else
		return 4
	end if
	
End Function

'============================================================================
' 국가코드별 국기이미지 명
'============================================================================
Function GetNationFlagName(sNation)
	
	if sNation == "USA" then
		return "flag_us2"
	elseif sNation =="KOR" then
		return "flag_kor_round"
	elseif sNation =="HKG" then
		return "flag_hk"
	elseif sNation =="CHN" then
		return "flag_chn"
	elseif sNation =="JPN" then
		return "flag_jp2"
	else
		return "flag_general"
	end if

End Function
