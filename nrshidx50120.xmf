'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 시작됐을 때
'============================================================================
Sub contBody_OnAnimationStart(sParam,sParam2)
	
	'키패드 내림
	contSearch.EditSearch.SetShowKeypad(false)
	
	'종목비교가 활성화 되있는 상태에서 
	'스크롤 시 버튼이 뒤로 숨는 현상조치
	btnReset.bringFront("1")
	btnOk.bringFront("1")
	
	'Up Swipe
	if sParam == "Up" then
		if gCompareBtnShow == true then
			
			'기존사이즈 + 숨겨지는 영역 사이즈 - 종목비교/초기화 버튼 사이즈
			contBody.height = 355 + 256 - 60
			
			if sParam2 == "Yes" then
				contBody.Pannel0.height = 295 + 256 -60
			end if
		
		else
		
			'기존사이즈 + 숨겨지는 영역 사이즈
			contBody.height = 355 + 256
			contBody.Pannel0.height = 295 + 256
			
		end if
		
		contBody.SetScrollAutoSize()
		
	end if
	
	'Form.ShowAlert("UP SIZE", contBody.height.."//"..contBody.Pannel0.height)
	
End Sub
'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 완료됐을 때
'============================================================================
Sub contBody_OnAnimationComplete(sParam)
	
	'Down Swipe
	if sParam == "Down" then
		
		if gCompareBtnShow == true then
			
			'기존 사이즈 - 종목비교/초기화 버튼 사이즈
			contBody.height = 355 - 60
			contBody.Pannel0.height = 295 - 60
		else
			
			'기존사이즈 
			contBody.height = 355
			contBody.Pannel0.height = 295
			
		end if
		
		contBody.SetScrollAutoSize()
	
		
	end if
	
	'Form.ShowAlert("DOWN SIZE", contBody.height.."//"..contBody.Pannel0.height)
	
End Sub

