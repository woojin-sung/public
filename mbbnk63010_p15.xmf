'============================================================================
Sub Form_OnFormInit()
    Dim szOpenData
    szOpenData = Form.GetOpenLinkData()
    if szOpenData <> "" and szOpenData <> null then
        '이체할금액 / 내계좌출금가능금액 / 매도담보대출가능금액 / 대출금리 / 이체수수료
        Dim tData
        tData = Split(szOpenData, "★")
		
        tblData.SetCellString(0, 1, tData[0])
        if CInt(tData[4]) == 0 then
            tblData.SetCellString(1, 1, "무료")
        else
            tblData.SetCellString(1, 1, FormatNumber(tData[4], 0) & "원")
        end if
        tblData.SetCellString(2, 1, tData[1])
		
		If CInt(tData[0]) + CInt(tData[4]) - CInt(tData[1]) > 0 Then 'JWH 20230602
			'tblData.SetCellString(3, 1, CInt(tData[0]) + CInt(tData[4]) - CInt(tData[1]))	 
		
			lblLoanAmt.caption = Cdbl(tData[0]) + Cdbl(tData[4]) - Cdbl(tData[1])
		Else
			'tblData.SetCellString(3, 1, 0)	 	     
		
			lblLoanAmt.caption = "0"
		End If
		
		'매도담보대출금액 세팅 후 하이라이트 처리
		lblLoanTitle.setHighlight(332, 0, 8)
		
		Dim nLen
		nLen = Len(lblLoanAmt.dispcaption)
		lblLoanAmt.setHighlight(332, 0, CInt(nLen)-2)
		
		tblData.SetCellString(5, 0, "대출금리 " & FormatNumber(tData[3], 2) & "%")
	
    end if
    
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnNext_OnClick()
	Form.SendReturnToParent("mbbnk63010_p15" , "ok")
	Form.CloseForm()
End Sub

