	<SCRIPT_INFO _len="6996" _ulen="6922" >
Dim g_szACNO
Dim g_szASNO
Dim g_szPwd
Dim g_szItemCode

g_szItemCode = ""

'============================================================================
Sub Form_OnFormInit()
	ItemCode0.code = "empty"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" then
		if sParam <> "" and sParam <> null then
			Dim szSplitData
			szSplitData = Split(sParam, "★")
			g_szACNO = szSplitData[0]
			g_szASNO = szSplitData[1]
			
			DATAMANAGER.RequestTranData("obtrd_oder_826r")
			DATAMANAGER.RequestTranData("obtrd_oder_826r_1")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_oder_826r" then		
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r", "InBlock1", "ACNO" , 0, g_szACNO )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r", "InBlock1", "ASNO" , 0, g_szASNO )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r", "InBlock1", "STA_DATE" , 0, cldFrom.caption )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r", "InBlock1", "FIN_DATE" , 0, cldTo.caption )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r", "InBlock1", "FISCD" , 0, g_szItemCode )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r", "InBlock1", "CRCD" , 0, cmbCurrency.cbkeydata )
	
	elseif szTranID = "obtrd_oder_826r_1" then
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r_1", "InBlock1", "ACNO" , 0, g_szACNO )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r_1", "InBlock1", "ASNO" , 0, g_szASNO )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r_1", "InBlock1", "STA_DATE" , 0, cldFrom.caption )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r_1", "InBlock1", "FIN_DATE" , 0, cldTo.caption )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r_1", "InBlock1", "FISCD" , 0, g_szItemCode )
		DATAMANAGER.SetDataValue( false, "obtrd_oder_826r_1", "InBlock1", "CRCD" , 0, cmbCurrency.cbkeydata )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_oder_826r" then
		Dim nCnt, nIndex
		Dim szCLRN_PRLS_FAMT, szEXCL_VPAL_FAMT, szENTM_FFEE, szNTPL_FAMT, szCRCD
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtrd_oder_826r", "OutBlock1")
		nIndex = Cint(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1
			szCLRN_PRLS_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r", "OutBlock1", "CLRN_PRLS_FAMT" , i) '청산손익
			szEXCL_VPAL_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r", "OutBlock1", "EXCL_VPAL_FAMT" , i) '평가증감
			szENTM_FFEE = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r", "OutBlock1", "ENTM_FFEE" , i) '수수료
			szNTPL_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r", "OutBlock1", "UI_NTPL_FAMT" , i) '순손익
			szCRCD = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r", "OutBlock1", "CRCD" , i) '통화코드
			
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell2", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 0))
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szENTM_FFEE, 0))
				grdList.SetCellData("bd_cell7", nIndex+i, FormatNumber(szEXCL_VPAL_FAMT, 0))
				grdList.SetCellData("bd_cell8", nIndex+i, FormatNumber(szNTPL_FAMT, 0))
			else
				grdList.SetCellData("bd_cell2", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 2))
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szENTM_FFEE, 2))
				grdList.SetCellData("bd_cell7", nIndex+i, FormatNumber(szEXCL_VPAL_FAMT, 2))
				grdList.SetCellData("bd_cell8", nIndex+i, FormatNumber(szNTPL_FAMT, 2))
			end if
		next
		
	elseif szTranID = "obtrd_oder_826r_1" then
		Dim szCLRN_PRLS_FAMT, szEXCL_VPAL_FAMT, szENTM_FFEE, szNTPL_FAMT, szCRCD
		
		szCLRN_PRLS_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r_1", "OutBlock2", "CLRN_PRLS_FAMT" , 0) '청산손익
		szEXCL_VPAL_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r_1", "OutBlock2", "EXCL_VPAL_FAMT" , 0) '평가증감
		szENTM_FFEE = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r_1", "OutBlock2", "ENTM_FFEE" , 0) '수수료
		szNTPL_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_oder_826r_1", "OutBlock2", "UI_NTPL_FAMT" , 0) '순손익
		
		if cmbCurrency.cbkeydata = "KRW" or cmbCurrency.cbkeydata = "JPY" then
			tblData.SetCellString(0, 1, FormatNumber(szCLRN_PRLS_FAMT, 0))
			tblData.SetCellString(0, 3, FormatNumber(szENTM_FFEE, 0))
			tblData.SetCellString(1, 1, FormatNumber(szEXCL_VPAL_FAMT, 0))
			tblData.SetCellString(1, 3, FormatNumber(szNTPL_FAMT, 0))
		else
			tblData.SetCellString(0, 1, FormatNumber(szCLRN_PRLS_FAMT, 2))
			tblData.SetCellString(0, 3, FormatNumber(szENTM_FFEE, 2))
			tblData.SetCellString(1, 1, FormatNumber(szEXCL_VPAL_FAMT, 2))
			tblData.SetCellString(1, 3, FormatNumber(szNTPL_FAMT, 2))
		end if
	end if
	
End Sub

