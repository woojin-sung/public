'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obtrd_oder_826r" ) = true then
		DATAMANAGER.RequestNextData( "obtrd_oder_826r" )
	end if
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtrd_oder_826r" )
	DATAMANAGER.RequestTranData( "obtrd_oder_826r_1" )
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtrd_oder_826r" )
	DATAMANAGER.RequestTranData( "obtrd_oder_826r_1" )
End Sub

'============================================================================
Sub cmbCurrency_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData( "obtrd_oder_826r" )
	DATAMANAGER.RequestTranData( "obtrd_oder_826r_1" )
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		g_szItemCode = sReturn1
		DATAMANAGER.RequestTranData( "obtrd_oder_826r" )
		DATAMANAGER.RequestTranData( "obtrd_oder_826r_1" )
	end if
End Sub

'============================================================================
Sub btnErase_OnClick()
	
'	if ItemCode0.code <> "" then
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
		
		ItemCode0.code = "empty"
		g_szItemCode = ""
		
		DATAMANAGER.RequestTranData("obtrd_oder_826r")
		DATAMANAGER.RequestTranData( "obtrd_oder_826r_1" )
'	end if
End Sub

