'============================================================================
'btnNext01_OnClick
'============================================================================
Sub cont01_btnNext01_OnClick()
	'v002 평문적용/미적용에 따른 비밀번호 설정
	if g_PlainRm == "1" then 
		g_szPassword = cont01.edtPwd01.caption
	else 
		g_szPassword = Form.GetEncData(cont01.edtPwd01.caption)
	end if
		
	if	cont01.chkinvestTyp01.checkstate ="0"	then
		Form.ShowAlert(g_szAlertTitle, "투자성향 진단을 체크하지 않으셨습니다.")
		exit sub
	end	if
	
	if	cont01.chkPrivInfo01.checkstate ="0"	then
		Form.ShowAlert(g_szAlertTitle, "개인정보제공 및 활용동의를 체크하지 않으셨습니다.")
		exit sub
	end	if
	
	if	cont01.chkPolicy01.checkstate ="0"	then
		Form.ShowAlert(g_szAlertTitle, "종합매매계좌약관을 확인하지 않으셨습니다.")
		exit sub
	end	if
	
	'v0001
	if	cont01.chkDpsrPron01.checkstate ="0"	then
		Form.ShowAlert(g_szAlertTitle, "예금자보호 확인을 체크하지 않으셨습니다.")
		exit	sub
	end	if

	if cont01.chkPrivInfo01.checkstate = "1" then
		DATAMANAGER.RequestTranData("obcpp_bsdy_017r")
	else
		Form.ShowAlert(g_szAlertTitle, "개인신용정보 관련 동의가 되지 않아 온라인계좌개설이 불가능합니다. 지점/HTS에서 동의 후 처리하시기 바랍니다")
	end if 
End Sub


'============================================================================
'btnPrev01_OnClick
'============================================================================
Sub cont01_btnPrev01_OnClick()
	Form.triggerEvent("#", "OPENACC_MAIN", "0")
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName="INVESTTYPE" then
		cont01.chkinvestTyp01.chksilence = "1"
	end if 
	
	if sKeyName=G_PERSONAL_AGREE_FILE	then	
		if sRet == "ok" then
			cont01.chkPrivInfo01.chksilence = "1"
		end if 
	end if
	
	if sKeyName="ACCOUNTPOLICY" then
		if	sRet	=	"1"	then
			cont01.chkPolicy01.chksilence = "1"
		else
			cont01.chkPolicy01.chksilence = "0"
		end	if
	end if 
	
	if sKeyName="ETCAGREE" then
		cont01.chkAgree01.chksilence = "1"
	end if 

	if sKeyName="KYCCHK_RETURN"	then
		if	sRet	=	"Y"	then
			cont01.chkinvestTyp01.chksilence = "1"
		end if
	end if
	
	if sKeyName="INVESTTYPE_OUTPUT" then
		Form.ShowAlert(g_szAlertTitle, "투자성향진단완료")
	end if 
	
	'v0001
	if sKeyName="DPSRPRONOK" then
		if	sRet	=	"1"	then
			cont01.chkDpsrPron01.chksilence = "1"
		else
			cont01.chkDpsrPron01.chksilence = "0"
		end	if
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "obcsb_acif_786r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_786r", "InBlock1", "ACNO", 0, g_szAccNo)
	elseif szTranID = "obcpp_bsdy_017r" then
		DATAMANAGER.SetDataValue(0, "obcpp_bsdy_017r", "InBlock1", "MANG_DATE", 0, g_szToday)
	elseif szTranID = "obacp_opop_066r" then
		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword)) 'v002
		'v002 평문적용/미적용에 따라 비밀번호 전역변수에 이미 체크되어 설정되어있으므로 전역변수 그대로 매핑
		'If g_PlainRm = "1" Then '보안모듈 적용
			DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNT_PWD", 0, g_szPassword)
		'Else
		'	DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword))
		'End If
		
	elseif szTranID = "obacp_comm_037u" then
		DATAMANAGER.SetDataValue(0,"obacp_comm_037u", "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0,"obacp_comm_037u", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword)) 'v002
		'v002 평문적용/미적용에 따라 비밀번호 전역변수에 이미 체크되어 설정되어있으므로 전역변수 그대로 매핑
		'If g_PlainRm = "1" Then '보안모듈 적용
			DATAMANAGER.SetDataValue(0, "obacp_comm_037u", "InBlock1", "ACNT_PWD", 0, g_szPassword)
		'Else
		'	DATAMANAGER.SetDataValue(0, "obacp_comm_037u", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword))
		'End If

	elseif szTranID = "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0,"obcsb_acif_000r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword)) 'v002
		'v002 평문적용/미적용에 따라 비밀번호 전역변수에 이미 체크되어 설정되어있으므로 전역변수 그대로 매핑
		'If g_PlainRm = "1" Then '보안모듈 적용
			DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD", 0, g_szPassword)
		'Else
		'	DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword))
		'End If

	elseif szTranID = "obcsb_nice_010r" then
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "BSWR_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "CRIN_IQRY_CLCD", 0, "TR01")
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "RCNO_TYPE_CODE", 0, g_szRCNO_TYPE)
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "RCNO_PIP", 0, g_szRCNO) 'v0004 RCNO->RCNO_PIP
		DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "ACNO", 0, g_szAccNo)
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szIsQuestDone			'투자성향진단완료 0:존재, else:신규작성해야함
		
	dim szOutWorkDate			'영업일
	dim szOutWorkTime			'영업시간
	dim szCustClsCode			'고객구분코드
	
	dim szRet037				'obacp_comm_037u 결과값
	dim szRet000				'obcsb_acif_000r 결과값
	dim szRet010				'obcsb_nice_010r 결과값
	
	
	'obcsb_acif_786r(투자성향진단정보조회)
	'obcpp_bsdy_017r(영업일조회)
	'obacp_opop_066r(관리지점코드조회)
	'obacp_comm_037u(계좌비밀번호확인) 	- PRO_CLS_CLODE = "1"이면 맞음
	'obcsb_acif_000r(고객정보단건조회) 	- CNSG_YN = "N"이면 오류   --- CUST_CLS_CODE = "1"이면 obcsb_nice_010r --> STEP2
	'obcsb_nice_010r(신용정보조회) 		- RSLT_CLS = "0" 이거나 "3"이면  --> STEP2
	
	
	''''''''''''''''''''''''''
	'obcsb_acif_786r
	''''''''''''''''''''''''''
	if szTranID = "obcsb_acif_786r" then
		szIsQuestDone = DATAMANAGER.GetDataValue(0, "obcsb_acif_786r", "OutBlock1", "RSLT_CLS", 0)
		if szIsQuestDone = "0"	then							'존재시 
			'Form.ShowAlert("기존내역존재", szIsQuestDone)
			cont01.chkinvestTyp01.chksilence = "1"
		else
			Form.OpenFramePopup("mbonl81010" , g_szAccNo & ":" & g_szPassword, sPosInfo)		'임시세팅
		end if 
	end if


	''''''''''''''''''''''''''
	'1 영업일인지 조회
	'2 영업시간인지 조회
	'obcpp_bsdy_017r 성공시 --> obacp_opop_066r 조회후 다음스텝으로 이동
	''''''''''''''''''''''''''
	if szTranID = "obcpp_bsdy_017r" then
	
		szOutWorkDate = DATAMANAGER.GetDataValue(0, "obcpp_bsdy_017r", "OutBlock1", "MANG_DATE", 0)
		g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)

		if g_szToday = szOutWorkDate	then
			szOutWorkTime =left(g_szCurrentTime, 6)

			if	szOutWorkTime >= "080000" and 	szOutWorkTime <= "160000" then
				DATAMANAGER.RequestTranData("obacp_opop_066r")
			else
				Form.ShowAlert(g_szAlertTitle, "온라인 계좌 개설이 가능한 시간은 평일 08:00 ~ 16:00 입니다.")
			end if 
		else
			Form.ShowAlert(g_szAlertTitle, "계좌개설 가능 영업일이 아닙니다.")
		end if 
	end if
	
	
	''''''''''''''''''''''''''
	'obacp_opop_066r
	''''''''''''''''''''''''''
	if szTranID = "obacp_opop_066r" then
		g_szManBranch = "C" + DATAMANAGER.GetDataValue(0, "obacp_opop_066r", "OutBlock1", "MANG_BRCD", 0)
		Form.SetSharedData("ONLINE066_BRCD" , g_szManBranch)
		DATAMANAGER.RequestTranData("obacp_comm_037u")	
	end if 
	
		
	''''''''''''''''''''''''''
	'"obacp_comm_037u"
	''''''''''''''''''''''''''
	if szTranID = "obacp_comm_037u" then
		szRet037 = DATAMANAGER.GetDataValue(0, "obacp_comm_037u", "OutBlock1", "PROS_CLS_CODE", 0)
		
		if szRet037 = "1" then			'비밀번호 맞음
			DATAMANAGER.RequestTranData("obcsb_acif_000r")
		end if 
	end if 
	
	
	''''''''''''''''''''''''''
	'"obcsb_acif_000r"
	''''''''''''''''''''''''''
	if szTranID = "obcsb_acif_000r" then
		szRet000 = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CNSG_YN", 0)
		szCustClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CUST_CLS_CODE", 0)
		g_szRCNO		 =  DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RCNO_PIP", 0) 'v0004 RCNO->RCNO_PIP
		g_szRCNO_TYPE	 =  DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "RCNO_TYPE_CODE", 0)
		g_szCSNO		 =  DATAMANAGER.GetDataValue(0, "obcsb_acif_000r", "OutBlock1", "CSNO", 0)
		

		Form.SetSharedData("ONLINE000_RCNO" , g_szRCNO)
		Form.SetSharedData("ONLINE000_CSNO" , g_szCSNO)
		
		if szRet000 = "N" then			'오류발생
			Form.ShowAlert(g_szAlertTitle, "오류발생")
		else
			if szCustClsCode = "1" then
				DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE", 0, "1")		'첫조회시
				DATAMANAGER.RequestTranData("obcsb_nice_010r")	   	'신용정보조회
			else
				g_szExceptYN = cont01.chkExcept01.checkstate
				Form.SetSharedData("ONLINE000_EXPT", g_szExceptYN )
				Form.triggerEvent("#", "OPENACC_MAIN", "2")
			end if 
		end if 
	end if 
	

	''''''''''''''''''''''''''
	'"obcsb_nice_010r"
	''''''''''''''''''''''''''
	if szTranID = "obcsb_nice_010r" then
		szRet010 = DATAMANAGER.GetDataValue(0,"obcsb_nice_010r", "OutBlock1", "RSLT_CLS", 0)
		g_szSDRC_SRNO	=	 DATAMANAGER.GetDataValue(0,"obcsb_nice_010r", "OutBlock2", "SDRC_SRNO", 0)
		'0: 전문 전송하지 않아도 되는 정상적인 경우
		'1: 전문 송신한 경우
		'2: 전문 송신 후 응답 대기중
		'3: 전문 수신 결과 정상 응답
		
		if szRet010 = "0"	or	szRet010 = "3"  then				'정상
			g_szExceptYN = cont01.chkExcept01.checkstate
			Form.SetSharedData("ONLINE000_EXPT", g_szExceptYN )
			Form.triggerEvent("#", "OPENACC_MAIN", "2")
			Form.SetTimerEvent(84010, 0, 3)		
		elseif	szRet010	=	"1" or	szRet010= "2" then
			Form.SetTimerEvent(84010, 1, 3)		
		end if 
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub


'============================================================================
'Form_OnTimerEvent
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if	trim(sTimerID)	=	"84010"	then
		if g_nSendCnt	<	7	then
			DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0,"obcsb_nice_010r", "InBlock2", "SDRC_SRNO", 0, g_szSDRC_SRNO)
			
			DATAMANAGER.RequestTranData("obcsb_nice_010r")
			g_nSendCnt = g_nSendCnt + 1
		else	
			Form.ShowAlert(g_szAlertTitle, "obcsb_nice_010r, TR요청시간이 초과하였습니다. 재시도 바랍니다.")
			Form.SetTimerEvent(84010, 0, 3)		
		end if
	end	if
End Sub

