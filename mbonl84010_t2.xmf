	<SCRIPT_INFO _len="21538" _ulen="19336" >
'============================================================================
' 01.화면명 	: 온라인계좌개설
' 02.화면설명	: 온라인계좌개설_종합매매계좌개설
' 03.작성	: 2016.01.14
' 04. 세팅하는 SHARED DATA 
'	SetSharedData("ONLINE066_BRCD" , g_szManBranch)
'	SetSharedData("ONLINE000_RCNO" , g_szRCNO)
'	SetSharedData("ONLINE000_CSNO" , g_szCSNO)
'	SetSharedData("ONLINE000_EXPT ", g_szExceptYN )
'	SetSharedData("ONLINE_ACNT",	g_szAccNo)
'	SetSharedData("ONLINE_PSWD",	g_szPassword)
'============================================================================
' [Modyfy]
' 2016.06.17 : 정민영 : "예금자보호 안내문" 추가 v0001
' 2020.09.16 : 권오상 : v002 : T2008250015 : 메모리평문 취약점 수정
' 2020.11.10 : 정민영 : v002 보완
' 2020.11.13 : 정민영 : v0004 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_acif_000r,obcsb_nice_010r IO 변경분 반영
'            : v0005 : [고위험 금융투자상품 보호 강화 우선조치 방안 개발] 관련 개선
' 2021.05.26 : 김수진 : 개인신용정보동의 공통팝업처리
' 2021.08.12 : 정민영 : v0007 : 투자권유 희망여부 확인서 추가(5등급 상품개설)
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim 	g_szPassword 
dim	g_szAccNo 
dim	g_szCurrentTime 	'현재시간
dim	g_szToday			'오늘날짜
dim	g_szManBranch		'관리지점코드		from obacp_opop_066r(공유)
dim 	g_szRCNO			'실명확인번호		from obcsb_acif_000r(공유)
dim	g_szRCNO_TYPE		'실명확인번호유형	from obcsb_acif_000r
dim	g_szCSNO			'고객번호			from obcsb_acif_000r(공유)
dim 	g_szExceptYN		'금융상품전용		(공유)
dim 	g_nSendCnt			'전송횟수
dim	G_PERSONAL_AGREE_FILE	'개인신용정보동의
dim	g_szAlertTitle	'알림타이틀
dim	g_szSDRC_SRNO		'송수신일련번호 obcsb_nice_010r용
Dim	g_PlainRm 'v002
g_szAlertTitle	=	"알림"
g_szSDRC_SRNO		=""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002

	g_nSendCnt	=	0
	
	g_szToday = Form.GetSharedData("&HOST_DATE", 0)
	g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)
	G_PERSONAL_AGREE_FILE = "mbonl81020"
	cont01.edtPwd01.caption	=	""
	
	g_szAccNo = cont01.acnt01.total
	'v002 평문적용/미적용에 따른 비밀번호 설정
	if g_PlainRm == "1" then 
		g_szPassword	= cont01.edtPwd01.caption
	else 
		g_szPassword	= Form.GetEncData(cont01.edtPwd01.caption)
	end if

	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)
	Form.SetSharedData("ONLINE_PSWD",	g_szPassword)

	'v0007 1등급처리로 일원화
	cont01.chkKspKdq01.chksilence = "1"
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'acnt01_ChangeAccount
'============================================================================
Sub cont01_acnt01_ChangeAccount()
	g_szAccNo = cont01.acnt01.total
	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)
End Sub


'============================================================================
'edtPwd01_OnEditComplete
'============================================================================
Sub cont01_edtPwd01_OnEditComplete()
	'v002 평문적용/미적용에 따른 비밀번호 설정
	if g_PlainRm == "1" then 
		g_szPassword = cont01.edtPwd01.caption
	else 
		g_szPassword = Form.GetEncData(cont01.edtPwd01.caption)
	end if

	Form.SetSharedData("ONLINE_PSWD",	g_szPassword)
End Sub


'============================================================================
'btnInvesTyp01_OnClick
'============================================================================
Sub cont01_btnInvesTyp01_OnClick()
	Dim tmpPwd
	
	'DATAMANAGER.RequestTranData("obcsb_acif_786r")
	
	'v002 평문적용/미적용에 따른 비밀번호 설정
	if g_PlainRm == "1" then 
		g_szPassword = cont01.edtPwd01.caption
	else 
	     g_szPassword = Form.GetEncData(cont01.edtPwd01.caption)
		tmpPwd = cont01.edtPwd01.caption
	end if	
	
	if	len(trim(g_szPassword))	=	0	or	g_szPassword	=	NULL		then
		Form.ShowAlert(g_szAlertTitle, "비밀번호 확인 바랍니다.")
		Exit	Sub
	end	if	
	
	'v002 
	if g_PlainRm == "1" then 
		Form.OpenPopup("mbonl81010_p1" , "84010★0★" & cont01.chkKspKdq01.checkstate & cont01.chkExcept01.checkstate & "★" &  g_szAccNo & "★" & g_szPassword)
	else
		'mbonl81010_p1 Popup공유변수 주의!! 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘겨줘야함
		Form.OpenPopup("mbonl81010_p1" , "84010★0★" & cont01.chkKspKdq01.checkstate & cont01.chkExcept01.checkstate & "★" &  g_szAccNo & "★" & tmpPwd)
	end if	
End Sub


'============================================================================
'btnPrivInfo01_OnClick
'============================================================================
Sub cont01_btnPrivInfo01_OnClick()
	Dim pwdLen
	Dim tmpPwd

	'v002 평문적용/미적용에 따른 비밀번호 설정
	if g_PlainRm == "1" then 
		g_szPassword = cont01.edtPwd01.caption
		pwdLen = cont01.edtPwd01.pwdlen
		if pwdLen == "" Or pwdLen == Null then
			pwdLen = 0
		end if
	else 
	    g_szPassword = Form.GetEncData(cont01.edtPwd01.caption)
		tmpPwd = cont01.edtPwd01.caption
	end if
	
	if	len(trim(g_szPassword))	=	0	or	g_szPassword	=	NULL		then
		Form.ShowAlert(g_szAlertTitle, "비밀번호 확인 바랍니다.")
		Exit	Sub
	end	if
	
	Dim sSendData 
	if cont01.chkExcept01.chksilence == "1" then
		sSendData = "010;" & g_szAccNo	'금융상품전용
	else
		sSendData = "002;" & g_szAccNo	'종합계좌(미수가능)
	end if 
	
	'Form.OpenFramePopup("mbonl81020" ,  g_szAccNo & ";" & g_szPassword & ";" & cont01.edtPwd01.pwdlen , sPosInfo)
'	if g_PlainRm == "1" then 
	    '끝에 자릿수(Lx)넘겨줌
	    Form.OpenFramePopup("mbonl81020" ,  sSendData , sPosInfo)
'	else
		'mbonl81020 Popup공유변수 주의!! 메모리평문 적용시 암호화된비밀번호로/메모리평문 미적용시에는 평문비밀번호로 넘겨줘야함
	    
'	end if
End Sub


'============================================================================
'btnPolicy01_OnClick
'============================================================================
Sub cont01_btnPolicy01_OnClick()
	Form.OpenFramePopup("mbonl84010_p2" , sOpenData , sPosInfo)
End Sub

