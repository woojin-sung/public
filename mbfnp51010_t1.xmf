'============================================================================
'cont01_btnResult_OnClick() : v012 운용보고서 팝업 처리
'============================================================================
Sub cont01_btnResult_OnClick()
	If	g_szShortCd == NULL	or	g_szShortCd == "" or	len(g_szShortCd) <  3	Then
		Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		Exit Sub
	End	If

	If g_szAccNo <> NULL or g_szAccNo <> "" Then
		g_szPasswd = Form.GetCtlProp("#edtPwd01", "caption")	
		If g_szPasswd == NULL or len(g_szPasswd)	< 3	then
			Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주시기바랍니다.")
		Else
			Form.OpenPopup("mbfnp51010_p14" ,  g_szAccNo& "★" & g_szPasswd	& "★" & cont01.cmbResult.cbkeydata, "")
		End	If	
	End If
End Sub
'============================================================================
'cont01_btnReceive_OnClick() : v012 계약서류 수령처 팝업 처리
'============================================================================
Sub cont01_btnReceive_OnClick()
	If	g_szShortCd == NULL	or	g_szShortCd == "" or	len(g_szShortCd) <  3	Then
		Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		Exit Sub
	End	If
	
	If g_szAccNo <> NULL or g_szAccNo <> "" Then
		g_szPasswd = Form.GetCtlProp("#edtPwd01", "caption")
		If g_szPasswd == NULL or len(g_szPasswd)	< 3	then
			Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주시기바랍니다.")
		Else
			Form.OpenPopup("mbonl81010_p16" ,  g_szAccNo & "★" & g_szFnprJoinSrno, "")
		End If
	End If	

End Sub


