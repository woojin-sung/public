'============================================================================
'cont01_chkCapExplain_OnChange
'============================================================================
Sub cont01_chkCapExplain_OnChange(sCheckState)
	dim	szURL
	
	if	sCheckState	=	"1"	then

		if	g_szShortCd = NULL	or	len(g_szShortCd) <  3	then
			Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		end	if
		
		If g_szShortCd <> "" then
		    'g_zer_st = string(12-len(g_szShortCd),"0") & g_szShortCd 
			'szURL = "http://home.imeritz.com/include/ocw/"& g_zer_st&"K.pdf" 
			szURL = "http://home.imeritz.com/include/ocw/"&g_szCORE_FILE
