'============================================================================
'ResetItems
'============================================================================
Function	ResetItems()
'	cont01.cmbSavetype.cbkeydata	=	"3"			'저축방법 (자유적립식 기본세팅)
	cont01.edtPeriod.caption 		= 	"12"			'계약기간
	cont01.cmbResult.cbkeydata		=	"4"			'운용보고서	'22.03.28 v012 디폴트 셋팅 빈값 
	cont01.cmbResult.caption		=	""			'운용보고서	'22.03.28 v012 디폴트 셋팅 빈값 
	cont01.cmbReInvst.cbkeydata		=	"Y"			'재투자
	cont01.chkAgree.chksilence		=	"0"			'유의사항동의
	cont01.chkExplain.chksilence	=	"0"			'투자설명서
'	cont01.chkPolicy.chksilence		=	"0"			'집합투자규악
	cont01.chkCapExplain.chksilence	=	"0"			'간이설명서
	cont01.chkChkType01.chksilence	=	"0"			'투자성향진단
	'v015 벤처 약관 분리
	cont01.chkVenture.chksilence	=	"0"			'벤처저축약관 
	cont01.chkVenture2.chksilence	=	"0"			'벤처핵심설명서
	'개인신용정보제공동의 약관
	cont01.chkHighild.chksilence	=	"0"			'분리과세신청
	cont01.chkSummary.chksilence	=	"0"			'요약
	cont01.chkDetail.chksilence		=	"0"			'상세
	g_szManagerCode				=""				'관리자코드
	g_szManagerName				=""				'관리자명
	g_szCanvasserCode				=""				'권유자코드
	g_szCanvasserName				=""				'권유자명
	
	'21.07.19 JHY START
	'v008
	cont01.chkSavTerms.chksilence	= "0"
	'cont01.chkJoinInfo.chksilence	= "0"
	'21.07.19 JHY END
	
	'21.09.14 JHY START (v009)
	cont01.chkKeyManual.chksilence	= "0"
	'21.09.14 JHY END
	
	'v012 Sta
	cont01.cmbReInvst.cbkeydata 	= "0"			'계약서류 수령처 
	cont01.cmbReceive.caption 		= ""				'계약서류 수령처 
	'v012 Fin 
'''''	Form.SetSharedData("MBFNP51010_T1_FNPRJOINSRNO", "")	'v014 금융상품일련번호		'''' 
End	Function


'============================================================================
'chkSteps	: 다음스텝으로 넘어가기 위한 값들 체크
'============================================================================
Function 	chkSteps()
	'21.07.15 JHY START : 수익증권저축약관 및 상품가입관련안내문 추가 및 UI 변경에 따른 확인 순서 변경
	'v008
	if	cont01.chkSavTerms.checkstate 	=	"0"	then
		Form.ShowAlert(g_szAlertTitle, "수익증권저축약관을 확인하세요.")
		return -1
	end if
	
	if	cont01.chkCapExplain.checkstate 	=	"0"	then
		Form.ShowAlert(g_szAlertTitle, "간이투자설명서를  확인하세요.")
		return -1
	end if

	if	cont01.chkExplain.checkstate 	=	"0"	then
		Form.ShowAlert(g_szAlertTitle, "투자설명서를 확인하세요.")
		return -1
	end if
	
	if	cont01.chkAgree.checkstate 	=	"0"	then
		Form.ShowAlert(g_szAlertTitle, "유의사항을 확인하세요")
		return -1
	end if
	
'	if cont01.chkJoinInfo.checkstate 	=	"0"	then
'		Form.ShowAlert(g_szAlertTitle, "상품가입관련 안내문을 확인하세요.")
'		return -1
'	end if
	
' v004 집합투자규약 삭제요청	
'	if	cont01.chkPolicy.checkstate 	=	"0"	then
'		Form.ShowAlert(g_szAlertTitle, "집합투자규약을 확인하세요.")
'		return -1
'	end if	
	
	if	cont01.chkChkType01.checkstate 	=	"0"	then
		Form.ShowAlert(g_szAlertTitle, "고객투자성향진단 여부를 확인하세요.")
		return -1
	end if
	
	'21.09.14 JHY START (v009)
	if cont01.chkKeyManual.checkstate 	=	"0"	then
		Form.ShowAlert(g_szAlertTitle, "핵심상품설명서를 확인하세요.")
		return -1
	end if
	'21.09.14 JHY END
	
	'v002
	if	g_szVNTR_IVTR_YN = "Y" then
		if cont01.chkVenture.checkstate 	=	"0"	then
			Form.ShowAlert(g_szAlertTitle, "벤처기업투자신탁 저축약관을 확인하세요.")
			return -1
		end if
	end if
	
	'v015 벤처약관분리
	if	g_szVNTR_IVTR_YN = "Y" then
		if cont01.chkVenture2.checkstate 	=	"0"	then
			Form.ShowAlert(g_szAlertTitle, "벤처기업투자신탁 핵심설명서를 확인하세요.")
			return -1
		end if
	end if
	
	
	if g_szRSDT_CLS_CODE == "1" and g_szCUST_CLS_CODE == "1" and g_szINMR_CLS_CODE == "111" and g_szSPTX_CODE == "8"  and
		cont01.cmbSavetype.cbkeydata = "4" then
	
		if cont01.chkHighild.checkstate 	=	"0"	then
			Form.ShowAlert(g_szAlertTitle, "분리과세 신청 약관을 확인하세요.")
			return -1
		end if
	
		if (cont01.edtPeriod.caption == "0" or cont01.edtPeriod.caption == "" or CInt(cont01.edtPeriod.caption) < 12 ) then
			Form.ShowAlert("알림", "계약기간 입력 오류.")		
			return -1
		end if
		
		if g_nRemainLmt == 0 then
			Form.ShowAlert("알림", "은행연합회 한도조회 오류.")
			return -1
		elseif g_nRemainLmt < CInt(cont01.edtBuyAmt.caption) then
			Form.ShowAlert("알림", "은행연합회 한도조회 초과.")
			return -1
		end if
		
	end if
	
	
	if tonumber(cont01.edtBuyAmt.caption) <> NULL and tonumber(cont01.tblMesuInfo.GetCellString(0, 1)) <> NULL then
		if tonumber(g_szMinAmt) > tonumber(cont01.edtBuyAmt.caption) then
			Form.ShowAlert(g_szAlertTitle, "신청하신 금액이 신규매수 최소매수금액보다 작습니다. 매수신청 금액을 확인하시기 바랍니다.")
			return -1
		end if
		
		if	tonumber(cont01.edtBuyAmt.caption) > tonumber(cont01.tblMesuInfo.GetCellString(0, 1)) or tonumber(cont01.edtBuyAmt.caption) == 0 then
			Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
			return -1
		end	if
		
	else
		Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
		return -1
	end if
	'21.07.15 JHY END

	'v012 Sta
	'22.03.28 자산운용 통보처
	If cont01.cmbResult.caption == NULL or cont01.cmbResult.caption == "" or cont01.cmbResult.cbkeydata == "4" Then
		Form.ShowAlert(g_szAlertTitle, "자산운용 통보처를 선택하세요.")
		return -1		
	End If
	
	'22.03.28 계약서류 
	If cont01.cmbReceive.caption == NULL or cont01.cmbReceive.caption == "" or cont01.cmbReceive.cbkeydata == "0" Then
		Form.ShowAlert(g_szAlertTitle, "계약서류 수령처를 선택하세요.")
		return -1		
	End If
	'v012 Fin
	
	If g_FinCustomer <> "Y" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		return -1		
	End If
	
	return 1 
end Function


'============================================================================
'set900Items : 펀드 등록을 위한 아이템 세팅
'============================================================================
Function	set900Items()
	dim	nIdx
	
	nIdx	=	""
	
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE", 0	, g_szSVNG_TYPE_CODE)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MGRI_INFR_YN", 0		, g_szMGRI_YN)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MGRI_RPRT_INAG_TYPE_CODE", 0, g_szINAG_TYPE_CODE)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "RNVS_YN", 0			, g_szRNVS_YN)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE", 0	,  g_szSPTX_CODE)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "INSU_JOIN_YN", 0		, g_szLNKD_PROD_YN)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "KYC_DVPD_EPMD_CODE", 0	,  g_szDVPD_EPMD_CODE)
	'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "KYC_DRVT_PROS_YN", 0	,  g_szDRVT_YN)
	
	'1. 저축 유형코드 변수
	g_szSVNG_TYPE_CODE	=		cont01.cmbSavetype.cbkeydata
	
	
	'2. 운용 통보 여부	(Email 기본값)
	'3. 운용 보고서 통보처 유형 코드 (Email 기본값)
	'v012 운용 보고서 팝업 변경 
	nIdx	=	cont01.cmbResult.cbkeydata
	if	trim(nIdx)	=	"0"	then			'자택
		g_szMGRI_YN = "Y"
		g_szINAG_TYPE_CODE = "01" 
	elseif	trim(nIdx)	=	"1"	then		'직장
		g_szMGRI_YN = "Y"
		g_szINAG_TYPE_CODE = "02" 	
	elseif	trim(nIdx)	=	"2"	then		'이메일
		g_szMGRI_YN = "Y"
		g_szINAG_TYPE_CODE = "21" 	
	elseif	trim(nIdx)	=	"3"	then		'거부
		g_szMGRI_YN = "N"
		g_szINAG_TYPE_CODE = "51" '2013-04-17 lkm 운용통보처 발송되지 않는 케이스 수정 	
	end if
	

	'4. 재투자여부
	g_szRNVS_YN	=	cont01.cmbReInvst.cbkeydata


	'5. 보험 가입 여부
	'g_szSPTX_CODE		obsim_idmn_018r에 의해 세팅
	
	
	'6. '파생상품등급코드
	g_szDVPD_EPMD_CODE 	= Form.GetSharedData("KYC_DVPD_EPMD_CODE", 0 )
	
	'7. KYC 파생 처리 여부
	g_szDRVT_YN		= Form.GetSharedData("KYC_DRVT_PROS_YN", 0 )
	
	'8. v006. 숙려대상여부 
	g_szCAFU_TRGT_YN		= Form.GetSharedData("CAFU_TRGT_YN", 0 )
'g_szCAFU_TRGT_YN		= "Y" '테스트
	
End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'저축방법 콤보 초기화(연금저축일 경우 임의식으로 FIX
'============================================================================
Function cmbSavetypeInit()

	szProdCd = Form.GetAccountInfo(g_szAccNo..g_szAsNo, "productcode")	'계좌상품코드

	'하이일드펀드 : 개인신용정보제공동의		
	cont01.chkHighild.Visible  = False
	cont01.Label6.Visible  = False
	cont01.Label7.Visible  = False
	cont01.chkSummary.Visible  = False
	cont01.chkDetail.Visible  = False
	
	cont01.btnInfoConfirm.top = 741
	cont01_cmbSavetype_OnEditComplete(0)
	
	'g_szSPTX_CODE = Form.GetSharedData("SPTX_CODE_51010")	'탭 이동시 분리과세 콤보 셋팅 강제로하기위함.
	'
	'분리과세 콤보 셋팅하려고 서비스 태움.. obacp_comm_007r -> obsim_idmn_089r -> obaci_acct_089r
	'if g_szSPTX_CODE == "8" and (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then
	if (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then
		if g_szShortCd	<>	"" then 
			DATAMANAGER.RequestTranData("obsim_idmn_018r")	'
		end if
	else

		cont01.cmbSavetype.clear = 0		
		cont01.cmbSavetype.cbadddatatext = "1"  &"`"& "임의식"
		cont01.cmbSavetype.cbadddatatext = "3"  &"`"& "자유적립식"

		cont01.cmbSavetype.cbkeydata	=	"1"
		cont01_cmbSavetype_OnEditComplete(0)
		
		if cont01.Edit0.Caption = "131" then
			cont01.cmbSavetype.cbkeydata	=	"1"
			cont01.cmbSavetype.enable = False
			cont01_cmbSavetype_OnEditComplete(0)
		elseif g_szShortCd = "16090501" then
			cont01.cmbSavetype.cbkeydata	=	"1"
			cont01.cmbSavetype.enable = False
			cont01_cmbSavetype_OnEditComplete(0)
		else
			'21.07.27 JHY START : 디폴트 자유적립식 12개월 -> 임의식 0개월로 변경
			'v008
			cont01.cmbSavetype.cbkeydata	=	"1"
			cont01.cmbSavetype.enable = True
			cont01_cmbSavetype_OnEditComplete(0)
			'21.07.27 JHY END
		end if
	end if
End Function

'============================================================================
'투자설명서 가져오는 함수
'============================================================================
Function getInvtAtchFile()
 	
	DATAMANAGER.RequestTranData("obsim_idmn_080r")

End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
		g_URLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	Else
		g_URLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	End If
	
	'v015 줄바꿈을 위해 체크캡션 스크립트로 처리
	cont01.chkVenture.chkcaption = "벤처기업투자신탁\n저축약관"
	cont01.chkVenture.unchkcaption = "벤처기업투자신탁\n저축약관"
	cont01.chkVenture2.chkcaption = "벤처기업투자신탁\n핵심설명서"
	cont01.chkVenture2.unchkcaption = "벤처기업투자신탁\n핵심설명서"
	g_szAnxtAprtPopUp = "0"
	
	cont01.left = 0
	cont03.left = 400

	cont01.Edit0.Caption = Form.GetCtlProp("#edtPrcd", "caption")
	if cont01.Edit0.Caption = "" then
		Form.SetTimerEvent(51010, 1, 1)
	else
		cmbSavetypeInit()
	end if
	
	DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번	
	
'	Form.SetSharedData("SAVETYPE_51010" , "자유적립식") '21.07.27 JHY				'추가매수 위함
	set900Items()
	DATAMANAGER.RequestTranData("obpds_srvc_380r")
	if	g_szShortCd	<>	""	then	
		DATAMANAGER.RequestTranData("obsim_idmn_018r")
	else
		cont01.left = 400
		cont03.left = 0
	end if
	
End Sub


'============================================================================
'cont01_cmbSavetype_OnEditComplete
'============================================================================
Sub cont01_cmbSavetype_OnEditComplete(iIndex)
	if	iIndex 	=	1	then
		cont01.edtPeriod.caption	=	"12"
		cont01.edtPeriod.enable	=	true
'		Form.SetSharedData("SAVETYPE_51010" , "자유적립식")
	elseif	iIndex 	=	2	then
		cont01.edtPeriod.caption	=	"12"
		cont01.edtPeriod.enable	=	true
	else
		cont01.edtPeriod.caption	=	"0"
		cont01.edtPeriod.enable	=	false
'		Form.SetSharedData("SAVETYPE_51010" , "임의식")
	end if
	
	set900Items()
End Sub


'============================================================================
'cont01_chkAgree_OnChange
'============================================================================
Sub cont01_chkAgree_OnChange(sCheckState)
	dim	szURL

	if	sCheckState	=	"1"	then
		
		if	g_szShortCd = NULL	or	len(g_szShortCd) <  3	then
			Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		end	if
		
		If g_szShortCd <> "" then
			cont01.left	=	0
			cont03.left   =   400
			Form.OpenFramePopup("mbfnp51010_p8" , "" , sPosInfo)
			'cont01.chkAgree.chksilence	=	"1"
		End if
	else	
		cont01.chkAgree.chksilence	=	"1"
	end	if
End Sub


'============================================================================
'cont01_chkExplain_OnChange
'============================================================================
Sub cont01_chkExplain_OnChange(sCheckState)
	dim	szURL
	
	if	sCheckState	=	"1"	then
		if	g_szShortCd = NULL	or	len(g_szShortCd) <  3	then
			Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		end	if
		
		If g_szShortCd <> "" then
'		    g_zer_st = string(12-len(g_szShortCd),"0") & g_szShortCd 
'			szURL = "http://home.imeritz.com/include/ocw/"& g_zer_st&"T.pdf" 
			
			szURL = "http://home.imeritz.com/include/ocw/"&g_szINVT_FILE
			Form.OpenPdfViewer( 	szURL, "투자설명서" )
			
			cont01.chkExplain.chksilence	=	"1"
		End if
	else
	        ' [v016] 2022.08.02 임동군 주석
		' 다시한번 열어볼 수 있도록 체크 활성/비활성화 로직 살림
		'cont01.chkExplain.chksilence	=	"1"
	end	if
End Sub


