'============================================================================
'cont01_chkChkType01_OnChange
'============================================================================
Sub cont01_chkChkType01_OnChange(sCheckState)
	'투자성향진단, 신규매수: 51000★0★ACNO★ASNO★ISCD★PASSWD
	''Form.ShowAlert("type222", "51000★0★" & g_szAccNo & "★" &  g_szAsNo & "★" &  g_szShortCd & "★" & g_szPasswd)
	
	if	sCheckState	=	"1"	then
	
		'g_szAccNo	=	left(Form.GetCtlProp("#acnt01", "caption"), 8)
		'g_szAsNo	=	mid(Form.GetCtlProp("#acnt01", "caption"), 9, 2)
		g_szAccNo	=	left(Form.GetCtlProp("#acnt02", "caption"), 8)
		g_szAsNo	=	mid(Form.GetCtlProp("#acnt02", "caption"), 9, 2)

		if	g_szAccNo = NULL	or	len(g_szAccNo)	<	3	then
			Form.ShowAlert(g_szAlertTitle, "계좌를 선택하여주시기바랍니다.")
			cont01.chkChkType01.chksilence	=	"0"
			Exit	Sub
		end	if
		
		if	g_szShortCd = NULL	or	len(g_szShortCd)	<	3	then
			Form.ShowAlert(g_szAlertTitle, "종목을 선택하여주시기바랍니다.")
			cont01.chkChkType01.chksilence	=	"0"
			Exit	Sub
		end	if
		
		g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")

		if	g_szPasswd = NULL	or	len(g_szPasswd)	<	3	then
			Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주시기바랍니다.")
			cont01.chkChkType01.chksilence	=	"0"
			Exit	Sub
		end	if
		
		if	len(trim(g_szAccNo)) 	>	0	and	 len(trim(g_szAsNo)) 	>	0	and	 
			len(trim(g_szShortCd)) >	0	and	 len(trim(g_szPasswd)) >	0	then
			Form.OpenPopup("mbonl81010_p1" , "51000★0★" & g_szAccNo & "★" &  g_szAsNo & "★" &  g_szShortCd & "★" & g_szPasswd)
		end if	
	else
		cont01.chkChkType01.chksilence	=	"1"
	end	if
End Sub

