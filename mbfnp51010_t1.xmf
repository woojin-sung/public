Sub cont01_btnBuy_OnClick()
	dim	szRet
	
	szRet = chkSteps()

	if szRet = 1	then
	
		'g_szAccNo	=	left(Form.GetCtlProp("#acnt01", "caption"), 8)
		'g_szAsNo		=	mid(Form.GetCtlProp("#acnt01", "caption"), 9, 2)
		g_szAccNo	=	left(Form.GetCtlProp("#acnt02", "caption"), 8)
		g_szAsNo		=	mid(Form.GetCtlProp("#acnt02", "caption"), 9, 2)
		g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")

		if	g_szPasswd = NULL	or	len(g_szPasswd)	<	3	then
			Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주시기바랍니다.")
			Exit	Sub
		end	if

		'21.08.03 JHY START : 신규매수와 동일하게 공인인증 및 확인 팝업 뜨도록 수정 ( 정우희 주임님 로직 확인 )
		if	len(trim(g_szAccNo))	>	7	and	len(trim(g_szPasswd))	>	0 	then
' 테스트 끝나면 앞정렬 지우고 밑에 주석처리 풀기
			Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)			'공통프로세스 체크완료후 공인인증서
			
'Dim szAccount
'szAccount	=	Form.GetCtlProp("#acnt02", "caption")
'
''파일명, 계좌번호, 펀드명, 저축방법, 매수신청금액 (추가매수와 내용 달라 기존 팝업 문제생길까봐 신청완료 신규 팝업에서 분기 타서 하도록 수정) 
'Form.OpenPopup("mbfnp51010_p11" , "confirm" & "★" & szAccount & "★" & g_szFndname & "★" & cont01.cmbSavetype.caption & "★" & Trim(cont01.edtBuyAmt.caption), sPosInfo)
		end if
		'21.08.03 JHY END
	end if
End Sub


