'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'g_szAccNo	=	left(Form.GetCtlProp("#acnt01", "caption"), 8)
	'g_szAsNo		=	mid(Form.GetCtlProp("#acnt01", "caption"), 9, 2)
	g_szAccNo	=	left(Form.GetCtlProp("#acnt02", "caption"), 8)
	g_szAsNo		=	mid(Form.GetCtlProp("#acnt02", "caption"), 9, 2)
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")

	if	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
		
	elseif	szTranID	=	"obaci_acct_009c" then			'집합투자증권펀드등록
		'
	
'ShowAlert(cont01.cmbSavetype.cbkeydata , g_szSPTX_CODE)	

		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "UI_CUST_CONT_CLS_CODE", 0, "4")
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ACNO", 0,	g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ASNO", 0,	 g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "CNRC_PRD"			, 0	, Trim(cont01.edtPeriod.caption))
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ISCD"				, 0	, g_szShortCd)
'		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE"	, 0	, g_szSVNG_TYPE_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "RCMD_EMPNO"			, 0	, Form.GetSharedData("MBFNP51010_T1_RCMDEMPNO"))	'g_szCanvasserCode
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MANG_EMPNO"			, 0	, Form.GetSharedData("MBFNP51010_T1_MANGEMPNO"))	'g_szManagerCode
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MGRI_INFR_YN"		, 0	, g_szMGRI_YN)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "MGRI_RPRT_INAG_TYPE_CODE", 0, g_szINAG_TYPE_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "RNVS_YN"				, 0	, g_szRNVS_YN)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ATMT_RPRC_YN"		, 0	, "0")
'		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0	,  szSPTX_CODE)	'g_szSPTX_CODE
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "INSU_JOIN_YN"		, 0	,  g_szLNKD_PROD_YN)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "KYC_DVPD_EPMD_CODE"	, 0	,  g_szDVPD_EPMD_CODE)
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "KYC_DRVT_PROS_YN"		, 0	,  g_szDRVT_YN)
		
		'DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "SVNG_ENCR_ACNT_YN" 	, 0 	, "N" ) '저축 장려계좌 여부
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "CAFU_TRGT_YN" 		, 0 	, g_szCAFU_TRGT_YN ) '숙려대상여부
		'v007
		if g_szSTPL_YN = "Y" then
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "SVNG_ENCR_ACNT_YN" 	, 0 	, "SS" ) '저축장려계좌여부  SS 증권
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "AFCO_EMPNO" 			, 0 	, g_szAFCO_EMPNO ) '계열사직원번호
		else 
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "SVNG_ENCR_ACNT_YN" 	, 0 	, "N" ) '저축 장려계좌 여부
		end if
		
		'v005 
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ACNT_PWD"		, 0	, g_szPasswd )
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "ACNT_PWD"		, 0	, Form.GetEncData(g_szPasswd))
		end if
		
		'21.07.15 JHY START
		'v008
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BYOV_AMT", 0	,  Trim(cont01.edtBuyAmt.caption))		'매수금액
		'21.07.15 JHY END

		'분리과세하이일드
		if cont01.cmbSavetype.cbkeydata = "4" then
		
			if cont01.chkSummary.chksilence	=	"1"  then
				szAGRM_RQCL_DOCU_CLCD = "1"
			else
				szAGRM_RQCL_DOCU_CLCD = "2"
			end if
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE"	, 0	,	g_szSVNG_TYPE_CODE)	'집합투자증권저축유형코드
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0	,	"8")	'종합 분리과세 구분 코드
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "CNRC_AMT"			, 0	,	Trim(cont01.edtBuyAmt.caption))	'계약 금액 = 매수 금액
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "PROS_CMPT_YN"		, 0	, 	g_PROS_CMPT_YN)		
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "LNKD_TLMS_MNNO"		, 0	, 	g_szLNKD_TLMS_MNNO)		
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock2", "AGRM_RQCL_DOCU_CLCD"	, 0	, 	szAGRM_RQCL_DOCU_CLCD)	'동의징구서류구분코드
			
		else
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "IISC_SVNG_TYPE_CODE"	, 0	,	g_szSVNG_TYPE_CODE)
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "OVRL_SPTX_CLS_CODE"	, 0	, 	g_szSPTX_CODE)
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "PROS_CMPT_YN"		, 0	, 	g_PROS_CMPT_YN)		
			DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "LNKD_TLMS_MNNO"		, 0	, 	g_szLNKD_TLMS_MNNO)		
			
		end if
		
		'21.08.19 JHY START (v009)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IISC_JOIN_APLT_NO", 0	, "")		'집합투자증권가입신청번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RECDNG_NO", 0	, "")			'녹취번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ODER_GRP_NO", 0	, "")			'주문그룹번호
		'21.08.19 JHY END
	
		DATAMANAGER.SetDataValue(0, "obaci_acct_009c", "InBlock1", "FNPR_JOIN_SRNO"		, 0	, Form.GetSharedData("MBFNP51010_T1_FNPRJOINSRNO") )		'금융상품일련번호
		
	elseif	szTranID	=	"obacp_comm_008r"	then		'개별계좌 정보조회
		DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNO" , 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ASNO" , 0, g_szAsNo)
		
		'v005
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNT_PWD" , 0, g_szPasswd )
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacp_comm_008r", "InBlock1", "ACNT_PWD" , 0, Form.GetEncData(g_szPasswd))
		end if
		
	'v003
	elseif	szTranID =	"obcsb_acad_106r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_106r", "InBlock1", "ACNO" , 0, g_szAccNo)
	'v004
	elseif	szTranID =	"obsim_idmn_080r" then
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "ISCD"				, 0, g_szShortCd	)
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "MFI_ATCH_FILE_CLCD" 	, 0, "%"			)
	'v007
	elseif	szTranID =	"obpds_srvc_380r" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_380r", "InBlock1", "ACNO", 0,	g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_380r", "InBlock1", "ASNO", 0,	 g_szAsNo)
	
	'21.07.06 JHY START
	'v008
	elseif	szTranID	=	"obrtp_drab_001r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, g_szAsNo)
	'v013
	elseif	szTranID	=	"obsat_deal_109r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, g_szAsNo)
	'21.07.06 JHY END
	
	'고객투자성향 및 상품위험등급조회
	elseif	szTranID	=	"obcsb_acif_400r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0, g_szShortCd)
	
	'종합계좌 정보 조회
	elseif	szTranID == "obacp_comm_007r" then

		DATAMANAGER.SetDataValue( 0, "obacp_comm_007r", "InBlock1", "ACNO"     , 0 , g_szAccNo )

		'v005
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNT_PWD" , 0, g_szPasswd )
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNT_PWD" , 0, Form.GetEncData(g_szPasswd))
		end if
		
		DATAMANAGER.SetDataValue( 0, "obacp_comm_007r", "InBlock1", "IQRY_CLS_CODE" , 0 , "9" )
	
	'은행연합회 한도금액 조회
	ElseIf szTranID == "obaci_acct_089r" Then
		szProdCd = Form.GetAccountInfo(g_szAccNo..g_szAsNo, "productcode")	'계좌상품코드

		If g_bTrTimer Then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "BSWR_PROS_CLS_CODE"  , 0 , 	"2"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "ACNO"          		, 0 , 	g_szAccNo	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "ASNO"          		, 0 , 	g_szAsNo	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "PRCD"          		, 0 , 	szProdCd	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO"          		, 0 , 	""	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_PRCD"          	, 0 , 	"93"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_TRPR_CLS_CODE"	, 0 , 	"0"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "CUST_CLS_CODE"		, 0 , 	"1"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "LNKD_TLMS_MNNO"		, 0 , 	g_szLnkdTlmsMnno	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO_PIP"			, 0 , 	""	)  
		Else
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "BSWR_PROS_CLS_CODE"  , 0 , 	"1"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "ACNO"          		, 0 , 	g_szAccNo	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "ASNO"          		, 0 , 	g_szAsNo	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "PRCD"          		, 0 , 	szProdCd	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO"          		, 0 , 	""	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_PRCD"			, 0 , 	"93"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_TRPR_CLS_CODE"	, 0 , 	"0"	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "CUST_CLS_CODE"		, 0 , 	"1"	) 
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "LNKD_TLMS_MNNO"		, 0 , 	""	)  
			DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO_PIP"			, 0 , 	""	)  
		End If
	
	end if

End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szProdCd
	szProdCd = Form.GetAccountInfo(g_szAccNo..g_szAsNo, "productcode")	'계좌상품코드

	'------------------
	'펀드기본정보조회
	'------------------
	if	szTranID	=	"obsim_idmn_018r"	then				
		g_szSPTX_CODE = DATAMANAGER.GetDataValue(0,"obsim_idmn_018r", "OutBlock4", "OVRL_SPTX_CLS_CODE", 0)
		g_szVNTR_IVTR_YN = DATAMANAGER.GetDataValue(0, "obsim_idmn_018r", "OutBlock5", "VNTR_ETPR_IVTR_YN", 0) 'v002
		g_szLNKD_PROD_YN = DATAMANAGER.GetDataValue(0, "obsim_idmn_018r", "OutBlock6", "INSU_LNKD_PROD_YN", 0)

'		Form.SetSharedData("SPTX_CODE_51010", g_szSPTX_CODE)		'탭 이동시 분리과세 콤보 셋팅 강제로하기위함.

		'21.08.03 JHY START : 최소매수금액 제어 추가 (정우희 주임님 요청)
		g_szMinAmt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "STA_SDPR", 0) 'v002
		'21.08.03 JHY END
		
		'v002
		if g_szVNTR_IVTR_YN = "Y" then
			'v015 벤처약관분리
			cont01.chkVenture.Visible  = True
			cont01.chkVenture2.Visible  = True
		end if
		
		'v011
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD", 0 , "02") '추가매수
		DATAMANAGER.RequestTranData("obsai_deal_701r")

		'01. 분리과세조건
		if g_szSPTX_CODE == "8" and (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then			
			DATAMANAGER.RequestTranData("obacp_comm_007r")	'종합계좌 정보 조회	
		end if
			
	'---------------------------------------
	'종합계좌 정보 조회
	'---------------------------------------
	Elseif szTranID == "obacp_comm_007r" Then
		g_szCUST_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CUST_CLS_CODE", 0)	'1 : 개인
		g_szINMR_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INMR_CLS_CODE", 0)	'111 : 내국인(주민등록번호부여자)
		g_szRSDT_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSDT_CLS_CODE", 0)	'1 : 거주

		'02. 분리과세조건 '국내거주자가 하이일드펀드 선택시 저축방법 변경
		if g_szRSDT_CLS_CODE == "1" and g_szCUST_CLS_CODE == "1" and g_szINMR_CLS_CODE == "111" and g_szSPTX_CODE == "8" and 
							 (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then

			'저축방법 구분 추가 : 거치식(분리과세 신청)
			DATAMANAGER.SetDataValue(0, "obsim_idmn_089r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
			DATAMANAGER.SetDataValue(0, "obsim_idmn_089r" , "InBlock1", "OVRL_SPTX_CLS_CODE", 0 , "8")			
			DATAMANAGER.RequestTranData("obsim_idmn_089r")	
		end if

	'---------------------------------------
	'종목_집합투자증권분리과세기간정보 조회
	'---------------------------------------
	elseif	szTranID	=	"obsim_idmn_089r"	then		
		szAPLY_STA_DATE	= DATAMANAGER.GetDataValue(0,   "obsim_idmn_089r", "OutBlock1", "APLY_STA_DATE" , 0)
		szAPLY_FIN_DATE	= DATAMANAGER.GetDataValue(0,   "obsim_idmn_089r", "OutBlock1", "APLY_FIN_DATE" , 0)

		'03. 분리과세조건	'매수신청일자가 szAPLY_STA_DATE 와 szAPLY_FIN_DATE 사이인 경우 구분코드 추가됨.
		if (szAPLY_STA_DATE <> nil and szAPLY_FIN_DATE <> nil ) and
					(CDBL(szAPLY_STA_DATE) <= CDBL(cont01.Calendar0.caption))  and (CDBL(cont01.Calendar0.caption) <= CDBL(szAPLY_FIN_DATE)) then
				
			'개인신용정보제공동의
			if g_szRSDT_CLS_CODE == "1" and g_szCUST_CLS_CODE == "1" and g_szINMR_CLS_CODE == "111" and g_szSPTX_CODE == "8" and 
							 (szProdCd = "100" or szProdCd = "106" or szProdCd = "118" or szProdCd = "200") then
							
				cont01.cmbSavetype.clear = 0			
				cont01.cmbSavetype.cbadddatatext = "1"  &"`"& "임의식"
				cont01.cmbSavetype.cbadddatatext = "3"  &"`"& "자유적립식"			
				cont01.cmbSavetype.cbadddatatext = "4"  &"`"& "거치식(분리과세신청)"
				
				cont01.cmbSavetype.cbkeydata = "4"
				cont01_cmbSavetype_OnEditComplete(2)
 
				cont01.cmbSavetype.enable = false
	
				cont01.chkHighild.Visible  = True
				cont01.chkHighild.enable = False
				cont01.Label6.Visible  = True
				cont01.Label7.Visible  = True
				cont01.chkSummary.Visible  = True
				cont01.chkDetail.Visible  = True
				
				cont01.btnInfoConfirm.top = 791
			else
				
				cont01.cmbSavetype.clear = 0		
				cont01.cmbSavetype.cbadddatatext = "1"  &"`"& "임의식"
				cont01.cmbSavetype.cbadddatatext = "3"  &"`"& "자유적립식"
				
				cont01.cmbSavetype.cbkeydata	=	"1"
				cont01_cmbSavetype_OnEditComplete(0)
				
				cont01.cmbSavetype.enable = true
								
				cont01.chkHighild.Visible  = False
				cont01.Label6.Visible  = False
				cont01.Label7.Visible  = False
				cont01.chkSummary.Visible  = False
				cont01.chkDetail.Visible  = False
				
				cont01.btnInfoConfirm.top = 741
			end if
			
			
			DATAMANAGER.RequestTranData("obaci_acct_089r")	''은행연합회 한도금액 조회
			
		end if
		
	'---------------------------------------
	'은행연합회 한도금액 조회
	'---------------------------------------
	ElseIf szTranID == "obaci_acct_089r" Then
		If g_bTrTimer Then
			Dim szProsClsCode
			szProsClsCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)			'처리구분코드
			'최초 조회 후에 PROS_CLS_CODE 가 "2"로 나올때까지 타이머 이용하여 재호출
			If szProsClsCode == "2" Then
				Dim szUI_SVNG_LIMT_UNSD_AMT, szJOIN_LIMT_AMT
				szUI_SVNG_LIMT_UNSD_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT", 0)	'UI저축한도 미사용금액
				szJOIN_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "JOIN_LIMT_AMT", 0)	'가입한도금액
				
				g_nRemainLmt = CInt(szUI_SVNG_LIMT_UNSD_AMT)			
			Else
				Form.SetTimerEvent2("5555", 1, 1.5)
			End If
		Else
			g_szLnkdTlmsMnno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LNKD_TLMS_MNNO", 0)		'연계전문번호
		
			g_bTrTimer = true
			
			DATAMANAGER.RequestTranData( szTranID )
		End If
	
	
	'------------------
	'계좌정보조회
	'------------------
	elseif	szTranID	=	"obacp_comm_008r"	then			
		g_szMANG_BRCD   		= DATAMANAGER.GetDataValue(0,   "obacp_comm_008r", "OutBlock1", "INDV_MANG_BRCD" , 0)

		if	trim(g_szCanvasserCode)	=	NULL		or		len(trim(g_szCanvasserCode))	=	0	then
			g_szCanvasserCode		= "C"&DATAMANAGER.GetDataValue(0,   "obacp_comm_008r", "OutBlock1", "INDV_MANG_BRCD" , 0)
			Form.SetSharedData("MBFNP51010_T1_RCMDEMPNO", g_szCanvasserCode)
		end	if
		
		if	trim(g_szManagerCode)		=	NULL		or		len(trim(g_szManagerCode))	=	0	then
			g_szManagerCode		= "C"&DATAMANAGER.GetDataValue(0,   "obacp_comm_008r", "OutBlock1", "INDV_MANG_BRCD" , 0)
			Form.SetSharedData("MBFNP51010_T1_MANGEMPNO", g_szManagerCode)
		end	if
	
	
'		if g_szRSDT_CLS_CODE == "1" and g_szCUST_CLS_CODE == "1" and g_szINMR_CLS_CODE == "111" and g_szSPTX_CODE == "8" then
		if cont01.cmbSavetype.cbkeydata = "4" then
			g_PROS_CMPT_YN = "A"
		else
			g_PROS_CMPT_YN = "N"
		end if
		DATAMANAGER.RequestTranData("obaci_acct_009c")			'계좌정보 조회후 등록
	'------------------
	'펀드설정
	'------------------
	elseif	szTranID	=	"obaci_acct_009c"	then
		g_szSrno				=	DATAMANAGER.GetDataValue(0,"obaci_acct_009c", "OutBlock1", "RMND_SRNO", 0 )
		g_szLNKD_TLMS_MNNO	=	DATAMANAGER.GetDataValue(0,"obaci_acct_009c", "OutBlock1", "LNKD_TLMS_MNNO", 0 )
		
		g_szCAFU_DDLN_STA_DATE	=	DATAMANAGER.GetDataValue(0,"obaci_acct_009c", "OutBlock1", "UI_BSOP_DATE1", 0 )
		g_szCAFU_DDLN_FIN_DATE	=	DATAMANAGER.GetDataValue(0,"obaci_acct_009c", "OutBlock1", "UI_BSOP_DATE2", 0 )
		g_szINTN_DTRM_STA_DATE	=	DATAMANAGER.GetDataValue(0,"obaci_acct_009c", "OutBlock1", "UI_BSOP_DATE3", 0 )
		g_szINTN_DTRM_FIN_DATE	=	DATAMANAGER.GetDataValue(0,"obaci_acct_009c", "OutBlock1", "UI_BSOP_DATE4", 0 )
		
		

		'21.08.03 JHY START : 신규매수신청완료 팝업 데이터
			g_szStlmDate = DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "STLM_DATE", 0 )
			g_szPrcpFee = DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "PRCP_FEE", 0 )
		'21.08.03 JHY END
		
		Form.SetSharedData("RMNDNO_51010", g_szSrno)		'추가매수위함
		ResetItems()									'v001	
		
		
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "6616" or sCode == "4278" then
			g_PROS_CMPT_YN = "P"	
			DATAMANAGER.RequestTranData("obaci_acct_009c")
		end if
		if len(trim(g_szLNKD_TLMS_MNNO)) == 0 then 
			'v006
			if g_szCAFU_TRGT_YN = "Y" then 
				Dim szHgdtYN, szOldtYN, szInfoYN, szUnfitYN
				szHgdtYN 	= Form.GetSharedData("700r_HGDT_PROD_YN", false) '고난도상품여부
				szOldtYN 	= Form.GetSharedData("700r_CAFU_OLDT_YN", false) '숙려고령자여부
				szInfoYN 	= Form.GetSharedData("700r_INFO_REFS_YN", szInfoYN) '정보미제공여부
				szUnfitYN 	= Form.GetSharedData("700r_UNFIT_YN", szUnfitYN) '부적합여부		
				
				Dim szReason
				szReason = "숙려제도 대상 고객"
				
				if szHgdtYN == "Y" then
					szReason = "고난도상품"
				elseif szOldtYN == "Y" then
					szReason = "만 65세 이상 투자자"
				elseif szUnfitYN == "Y" then
					szReason = "부적합투자자"
				end if
				
				Form.OpenPopup("mbonl81010_p9" ,	g_szSrno  & "★" &  
													g_szFndname	& "★" & g_szSVNG_TYPE_CODE	& "★" &
													szReason 	& "★" & g_szCAFU_DDLN_STA_DATE	& "★" & g_szCAFU_DDLN_FIN_DATE& "★" & g_szINTN_DTRM_STA_DATE	& "★" & g_szINTN_DTRM_FIN_DATE
										, sPosInfo)
			else 
				'21.07.20 JHY START : 추가매수와 동일하게 맞출시에는 얼럿 뜨도록 수정하면 됨
				'v008
				'계좌번호 ★ 일련번호 ★ 잔고번호 ★ 펀드명	 ★ 패스워드 ★ 펀드코드 v004 펀드코드 추가
				Form.OpenPopup("mbfnp51010_p1" , g_szAccNo & "★" & g_szAsNo  & "★" & g_szSrno & "★" & g_szFndname & "★" & g_szPasswd & "★" & g_szShortCd, sPosInfo)
				'21.07.20 JHY END
			end if
		end if
	'v003 추가
	elseif	szTranID = 	"obcsb_acad_106r" then
		g_szACTL_ERT_CODE = DATAMANAGER.GetDataValue(0,"obcsb_acad_106r", "OutBlock1", "ACTL_ERT_RPRT_INAG_TYPE_CODE", 0)
		
		'21.07.27 JHY START : 과세구분 삭제로 펀드 실질 수익률 보고서 위치 2,1 로 변경
		'v008
		if	g_szACTL_ERT_CODE	=	"01"	then
			cont01.tblT101.SetCellString(2, 1, "자택주소")
		elseif g_szACTL_ERT_CODE	=	"02"	then
			cont01.tblT101.SetCellString(2, 1, "직장주소")
		elseif g_szACTL_ERT_CODE	=	"03"	then
			cont01.tblT101.SetCellString(2, 1, "기타주소")
		elseif g_szACTL_ERT_CODE	=	"21"	then
			cont01.tblT101.SetCellString(2, 1, "E-mail")
		elseif g_szACTL_ERT_CODE	=	"31"	then
			cont01.tblT101.SetCellString(2, 1, "SMS")
		else
			cont01.tblT101.SetCellString(2, 1, "수신거부")
		end if
		'21.07.27 JHY END
	'v004 추가
	elseif	szTranID ==	"obsim_idmn_080r" then
		 g_szCTCN_FILE = 	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CTCN_ATCH_FILE_ORTX_NAME", 0)	'집합투자규약 파일명
		 g_szINVT_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_INVT_ATCH_FILE_ORTX_NAME", 0)	'투자설명서 파일명
		 g_szCORE_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CORE_ATCH_FILE_ORTX_NAME", 0)	'간이설명서 파일명
		 '22.05.30 v015 벤처약관분리
		 g_szCO_FILE	 =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CO_ATCH_FILE_ORTX_NAME", 0)		'벤처저축약관 파일명
		 g_szVNTR_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_VNTR_FILE_ORTX_NAME", 0)		'벤처핵심설명서 파일명
		 
		 '21.09.14 JHY START (v009)
		 g_szPROD_FILE	=	DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "UI_PROD_ATCH_FILE_ORTX_NAME", 0)		'UI상품첨부파일원본명
		 '21.09.14 JHY END
	
	'v007 저축장려약정여부
	elseif	szTranID	=	"obpds_srvc_380r"	then
		g_szSTPL_YN = DATAMANAGER.GetDataValue(0,"obpds_srvc_380r", "OutBlock1", "STPL_YN", 0)	'약정여부
		g_szAFCO_EMPNO = DATAMANAGER.GetDataValue(0,"obpds_srvc_380r", "OutBlock1", "EMPNO", 0)	'직원번호
		
	'21.07.06 JHY START
	'v008
	elseif	szTranID	==	"obrtp_drab_001r"	then
		Dim szCash	
		Dim szRp		
		Dim szMsg	
		
		szCash	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ALTN_ABLE_CASH_AMT", 0))
		szRp 	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ALTN_ABLE_RP_VLTN_AMT" , 0))

		if tonumber(szCash) <> NULL and tonumber(szRp) <> NULL then
			cont01.tblMesuInfo.SetCellString(0, 1, trim(szCash + szRp	))	'매수가능 합계
			cont01.tblMesuInfo.SetCellString(1, 1, szCash)					'매수가능 현금
			cont01.tblMesuInfo.SetCellString(2, 1, szRp)					'매수가능 현금성자산	
		end if
	'v013
	elseif	szTranID	==	"obsat_deal_109r"	then
		Dim szCash	
		Dim szRp		
		Dim szMsg	
		
		szCash	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CASH_AMT", 0))
		szRp 	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RP_VLTN_AMT" , 0))

		if tonumber(szCash) <> NULL and tonumber(szRp) <> NULL then
			cont01.tblMesuInfo.SetCellString(0, 1, trim(szCash + szRp	))	'매수가능 합계
			cont01.tblMesuInfo.SetCellString(1, 1, szCash)					'매수가능 현금
			cont01.tblMesuInfo.SetCellString(2, 1, szRp)					'매수가능 현금성자산	
		end if
	elseif	szTranID	=	"obsai_deal_701r"	then
		 g_szFND_DEAL_RSTC_CLCD = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "FND_DEAL_RSTC_CLCD", 0)	'펀드매매제한구분코드
		 g_szTN_INFORM_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "TN_INFORM_YN", 0)		'주의알림여부
		 g_szDEAL_ABLE_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "DEAL_ABLE_YN", 0)		'매매제한여부
		 
		 if g_szTN_INFORM_YN = "Y" then
			 if g_szFND_DEAL_RSTC_CLCD = "001" then
				 Form.ShowAlert("알림", "선택하신 펀드는 오스템임플란트 주식(2022.01.03일자 거래정지)을 편입하고 있습니다. 오스템임플란트 주식을 편입한 펀드의 경우, 운용사에서 공정가치 재평가 후 자산 상각을 진행하여 기준가에 반영하였으나 향후 추가 상각될 가능성이 있습니다. 이와 관련하여 편입비율 변동 및 추가 위험에 노출될 수 있으니 투자시 유의하시기 바랍니다. 자세한 사항은 거래 영업점 또는 고객센터(1588-3400)로 문의하시기 바랍니다.")
			 end if
		 end if
	'21.07.06 JHY END
		
		'고객투자성향 및 상품위험등급조회
		DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
	
	'v012 Sta
	elseif	szTranID	=	"obsap_acif_999a"	then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData("MBFNP51010_T1_FNPRJOINSRNO", g_szFnprJoinSrno)	'v014
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		'금융상품일련번호 바뀔시 계약서류 수령처 공통팝업 재등록필요 + 'v014 obacsb_acif_792a 서비스 재등록필요 투자자금확인 리셋
		cont01.cmbReInvst.cbkeydata 	= "0"			'계약서류 수령처 
		cont01.cmbReceive.caption 		= ""				'계약서류 수령처 
		cont01.chkChkType01.chksilence	= "0"			'투자자금확인
	'v012 Fin
    
    '고객투자성향 및 상품위험등급조회
	elseif	szTranID	=	"obcsb_acif_400r"	then
		Dim szInvestGrd, szPrdtGrd, szSpecialYn, szAnxtAprtYn
		
		szInvestGrd     = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CUST_IVIC_GRAD_CNTT"           , 0 )
		szPrdtGrd        = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "INVT_PROD_RISK_GRAD_CNTT" , 0 )
		szSpecialYn    = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_SPCL_INVR_YN" ,                0 )
		szAnxtAprtYn   = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ANXT_APRT_YN"                      , 0)
		
		cont01.tblInvestInfo.SetCellString(0, 1, szInvestGrd)
		cont01.tblInvestInfo.SetCellString(1, 1, szPrdtGrd)
		
		if szSpecialYn == "Y" then
			cont01.lblMoveInvest.visible = false
		end if

	
	        IF  szAnxtAprtYn  =  "Y"  AND g_szAnxtAprtPopUp = "0" THEN
		        ' 부적합한 펀드면 알림메시지 이후에 고객선택에 따라 신규매수 또는 닫기
			g_szAnxtAprtPopUp = "1"
			Form.OpenPopup("mbfnp51000_p8", g_szFndname & "★" & szInvestGrd & "★" & szPrdtGrd, sPosInfo)
		END IF
		
	end if

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'ShowAlert(szTranID, szErrMsg)
	'v003 
	if szTranID =	"obcsb_acad_106r" and szErrCode = "5820" then
		Form.OpenPopup("mbfnp51010_p10" , "통보처★" & g_szAccNo, sPosInfo)
		
	else
	
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	end if
	
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim	szNumber,	szName,	szDiv
	'-----------------------------------------------
	'투자성향진단
	'-----------------------------------------------
	if	sKeyName = 	"KYCCHK_RETURN"	then
		'진단 후 상단 정보 다시 조회
		DATAMANAGER.RequestTranData( "obcsb_acif_400r" )
		
		if	sRet	=	"Y"	then
			cont01.chkChkType01.chksilence	=	"1"
			set900Items()
		else
			cont01.chkChkType01.chksilence	=	"0"
		end if

	'-----------------------------------------------
	'권유자,관리자
	'-----------------------------------------------	
	elseif	sKeyName	=	"returnEmployee"	then
'	if g_szTitle == "관리자 검색" then
'		szTempData = "관리자★" & szNumber & "★" & szName & "★" & szIndustry
'	elseif g_szTitle == "권유자 검색" then
'		szTempData = "권유자★" & szNumber & "★" & szName & "★" & szIndustry
'	end if
		szDiv	=	getListItem(sRet, 0)
		if	szDiv	=	"권유자"	then
			g_szCanvasserCode	=""
			g_szCanvasserName	=""

			g_szCanvasserCode	=	getListItem(sRet,1)
			g_szCanvasserName	=	getListItem(sRet,2)
			
			Form.SetSharedData("MBFNP51010_T1_RCMDEMPNO", g_szCanvasserCode)
			
			'Form.ShowAlert("test", g_szCanvasserCode &".." & g_szCanvasserName)
		elseif	szDiv	=	"관리자"	then
			g_szManagerCode		=""
			g_szManagerName		=""
			
			g_szManagerCode	=	getListItem(sRet,1)
			g_szManagerName	=	getListItem(sRet,2)
			
			Form.SetSharedData("MBFNP51010_T1_MANGEMPNO", g_szManagerCode)
			'Form.ShowAlert("test", g_szManagerCode &".." & g_szManagerName)
		end if
	
	'-----------------------------------------------
	'추가매수로이동
	'-----------------------------------------------
	elseif	sKeyName	=	"BUYREQUEST_51010"	then
		if	sRet	=	"1"	then
			Form.triggerEvent("#", "MOVE_ADDBUYNOCHK", g_szSrno)			'추가매수로이동
		end	if
	
	'-----------------------------------------------
	'신규가입신청완료
	'-----------------------------------------------
	elseif	sKeyName	=	"BUYREQUEST_COMPL"	then
		if	sRet	=	"1"	then
			'21.08.03 JHY START : 기존 신청 완료 얼럿 신규매수신청 완료 팝업 오픈으로 수정
			'펀드명★저축방법★매수신청금액★결제일★선취수수료★접수번호★숙려대상여부'
			Form.OpenPopup("mbfnp51010_p11" , g_szFndname & "★" & cont01.cmbSavetype.caption & "★" & Trim(cont01.edtBuyAmt.caption) & "★" &
								g_szStlmDate & "★" & g_szPrcpFee & "★" & g_szSrno & "★" & g_szCAFU_TRGT_YN, sPosInfo)
			
			cont01.edtBuyAmt.caption	=	"0"							'1.	매수가능금액 초기화
			if Len(g_szAccNo)	>=	8	then
				' v013 임동군 변경
				'DATAMANAGER.RequestTranData("obrtp_drab_001r")			'2. 잔고재조회
				DATAMANAGER.RequestTranData("obsat_deal_109r")			'2. 잔고재조회
			end if
			
			'21.08.03 JHY 
			
		end	if
		
	'-----------------------------------------------
	'유의사항동의팝업
	'-----------------------------------------------
	elseif	sKeyName	=	"mbfnp51010_p8"		then
		if	sRet	=	"1"	then
			cont01.chkAgree.chksilence	=	"1"
		else
			cont01.chkAgree.chksilence	=	"0"
		end	if
		
		
	'-----------------------------------------------
	'펀드 실질투자수익률 보고서 통보처 팝업 v003
	'-----------------------------------------------
	elseif	sKeyName =	"returnACTL_RPRT_INAG"	then
		'통보처 등록 성공
		if	sRet =	"SUCC" then
			
			DATAMANAGER.RequestTranData("obcsb_acad_106r")
		'통보처 등록 실패
		else
			Form.ShowAlert("알림", "펀드 실질투자수익률 보고서 통보처 선택은 필수입니다.")
			Form.OpenPopup("mbfnp51010_p10" , "통보처★" & g_szAccNo, sPosInfo)
			'cont01.btnBuy.enable = False
		end if
	'-----------------------------------------------
	'목표시장 팝업 가입중단
	'-----------------------------------------------
	elseif	sKeyName	=	"mbonl81010_p8_rc"	then
		if	sRet	=	"CANCEL"	then
			cont01.btnBuy.enable = FALSE
		else
			cont01.btnBuy.enable = TRUE
		end	if
	'-----------------------------------------------
	'숙려대상여부 셋팅
	'-----------------------------------------------
	elseif	sKeyName	=	"CAFU_TRGT_YN"		then
		if	sRet	=	"1"	then
			cont01.chkAgree.chksilence	=	"1"
		else
			cont01.chkAgree.chksilence	=	"0"
		end	if
	'-----------------------------------------------
	'숙려안내 popup return
	'-----------------------------------------------	
	elseif	sKeyName = "mbonl81010_p9"		then						'고위험거래확인팝업
		if 	sRet = 	"OK" then
			'21.08.03 JHY START : 시장종합으로 가던것 가입에서 매수로 바뀌면서 매수완료 띠워 달라고 하여 수정 (정우희 주임님 요청)
			Form.OpenPopup("mbfnp51010_p1" , g_szAccNo & "★" & g_szAsNo  & "★" & g_szSrno & "★" & g_szFndname & "★" & g_szPasswd & "★" & g_szShortCd, sPosInfo)
			'21.08.03 JHY END
		end if
	
	'21.08.03 JHY START
	'-----------------------------------
	'공인인증검증
	'-----------------------------------	
	elseif	sKeyName	==	"mhetc90060_p5"	then			
		if	 sRet	<>	"cancel"		then
			Dim szAccount
			szAccount	=	Form.GetCtlProp("#acnt02", "caption")
			
			'파일명, 계좌번호, 펀드명, 저축방법, 매수신청금액 (추가매수와 내용 달라 기존 팝업 문제생길까봐 신청완료 신규 팝업에서 분기 타서 하도록 수정) 
			Form.OpenPopup("mbfnp51010_p11" , "confirm" & "★" & szAccount & "★" & g_szFndname & "★" & cont01.cmbSavetype.caption & "★" & Trim(cont01.edtBuyAmt.caption), sPosInfo)	
		end	if
	'21.08.03 JHY END
	
	'-----------------------------------
	' 신규매수 확인 팝업 return
	'-----------------------------------	
	elseif sKeyName == "close_mbfnp51010_p11" then
		if sRet == "BUY" then
			if	len(trim(g_szAccNo))	>	7	and	len(trim(g_szPasswd))	>	0 	then
				DATAMANAGER.RequestTranData("obacp_comm_008r")					'계좌정보에서 권유자, 관리자 가져옴
			end if		
		end if
	
	'v012 Sta
	'-----------------------------------
	' 운용보고서 선택 팝업 return
	'-----------------------------------	

	elseif sKeyName == "mbfnp51010_p14" then
		'22.03.28 v012
		if Trim(sRet) <> "" and Trim(sRet) <> null then
			cont01.btnResult.caption = ""
			cont01.cmbResult.cbkeydata = sRet
			set900Items()
		Else
			cont01.btnResult.caption = "선택"
			cont01.cmbResult.cbkeydata = "4"
		end if
	'-----------------------------------
	' 계약서류 수령처 선택 팝업 return (공통팝업 mbonl81010_p16)
	'-----------------------------------			
	elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" Then
			DIm szReceive
			szReceive = Form.GetSharedData( "MBONL81010_P16_SELECT", true )

			If szReceive <> "" and szReceive <> null Then
				cont01.btnReceive.caption = ""
				cont01.cmbReceive.cbkeydata = szReceive
			Else
				cont01.btnReceive.caption = "선택"
				cont01.cmbReceive.cbkeydata = "0"
			End If	
		End If
 	'v012 Fin
	'-----------------------------------
	' 부적정확인 return
	'-----------------------------------			
	elseif sKeyName == "mbfnp51000_p8" then
		If Trim(sRet) == "CANCEL" Then
		    Form.OpenScreen("51000" , "")
		    Form.CloseForm()
		    Exit Sub
		End If
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
		elseif sRet == "CANCEL_mbonl81010_p20" then
			g_FinCustomer = "N"
		end if
	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'------------------------------------------
	'펀드코드변경
	'------------------------------------------
	if	sEventName		=	"FNDCODE_CHG"	then					'
		
		g_szVNTR_IVTR_YN				=	""				'벤처펀드여부 초기화 V002
		'v015 벤처약관분리
		cont01.chkVenture.Visible  		= 	False
		cont01.chkVenture2.Visible  	= 	False
		
		'하이일드펀드 : 개인신용정보제공동의		
		cont01.chkHighild.Visible  = False
		cont01.Label6.Visible  = False
		cont01.Label7.Visible  = False
		cont01.chkSummary.Visible  = False
		cont01.chkDetail.Visible  = False
		
		cont01.btnInfoConfirm.top = 741
		

		if	len(sParam)	>	3	then
			g_szShortCd	=	getListItem(sParam, 0)
			g_szStndCd	=	getListItem(sParam, 1)
			g_szFndname	=	getListItem(sParam, 2)
			
			
			cont01.left = 0
			cont03.left = 400
			if	len(g_szShortCd)	>	3	then						'ShortCD 필요
				DATAMANAGER.RequestTranData("obsim_idmn_018r")
				
			end if

			'v004
			if	len(g_szShortCd)	>	3	then						'ShortCD 필요
				getInvtAtchFile()
			end if
					
		end	if
	
	'------------------------------------------
	'계좌변경
	'------------------------------------------	
	elseif	sEventName	=	"ACNTINFO_CHG"	then				
		
		if	len(sParam)	>	2	then
			g_szAccNo	=	getListItem(sParam, 0)
			g_szAsNo		=	getListItem(sParam, 1)
			
			ResetItems()			'초기화
			Form.SetSharedData("SPCL_CNFR_ACNO", g_szAccNo )
			'저축방법 초기화
			cont01.Edit0.Caption = Form.GetCtlProp("#edtPrcd", "caption")
			if cont01.Edit0.Caption = "" then
				Form.SetTimerEvent(51010, 1, 1)
			else
				cmbSavetypeInit()
			end if
			
			'v003 추가
			DATAMANAGER.RequestTranData("obcsb_acad_106r")			'실질수익률보고서 통보처 조회

		end	if
		DATAMANAGER.RequestTranData("obpds_srvc_380r")
		
		
		'21.07.06 JHY START
		'v008
		Dim szFullAcc
		szFullAcc	=	Form.GetCtlProp("#acnt02", "caption")		
		
		if Len(szFullAcc)	>	8	then
			' v013 임동군 변경
			'DATAMANAGER.RequestTranData("obrtp_drab_001r")			'잔고는 계좌만 있으면 됨(비밀번호 트리거 처리 제외)
			DATAMANAGER.RequestTranData("obsat_deal_109r")			'잔고는 계좌만 있으면 됨(비밀번호 트리거 처리 제외)			
		end if
		'21.07.06 JHY END
	


	'------------------------------------------
	'비밀번호
	'------------------------------------------
	'v012 Sta
	elseif	sEventName	=	"PWDINFO_CHG"	then		
		
'		if	g_szShortCd	<>	NULL	and g_szShortCd	<>	""	then
'			DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번	
'		end if
'	'v012 Fin

	end if
End Sub



'============================================================================
Sub cont01_edtPeriod_OnEditComplete()
	if len(cont01.edtPeriod.caption) > 3 then
		Form.ShowAlert(g_szAlertTitle, "계약기간은 최대 999개월 입니다.")
		cont01.edtPeriod.caption = "0"
	end if
	
	if cont01.cmbSavetype.cbkeydata == "4" and (cont01.edtPeriod.caption == "0" or cont01.edtPeriod.caption == "" or CInt(cont01.edtPeriod.caption) < 12 ) then
		Form.ShowAlert(g_szAlertTitle, "계약기간 1년이하 선택불가.")
		cont01.edtPeriod.caption = "0"
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if	trim(sTimerID)	=	"51010"	then
		if g_nSendCnt	<	7	then
			cont01.Edit0.Caption = Form.GetCtlProp("#edtPrcd", "caption")
			tabInx = Form.GetCtlProp("#fmtab01", "currenttab")
			g_nSendCnt = g_nSendCnt + 1
			if cont01.Edit0.Caption <> "" or tabInx = 4 then
'				Form.ShowAlert("완료", cont01.Edit0.Caption)
				Form.SetTimerEvent(51010, 0, 1)
				g_nSendCnt = 0
				cmbSavetypeInit()
			end if
		else	
'			Form.ShowAlert(g_szAlertTitle, "계좌정보(상품코드) 조회가 지연되고 있습니다. 재시도 바랍니다.")
			Form.SetTimerEvent(51010, 0, 1)
			g_nSendCnt = 0
		end if
		
	'은행연합회 한도조회 타이머
	ElseIf trim(sTimerID)	=	"5555"	then
		Form.SetTimerEvent2(sTimerID, 0, 1.5)

		'재조회
		DATAMANAGER.RequestTranData("obaci_acct_089r")
	end	if
End Sub



'============================================================================
Sub cont01_lblMoveInvest_OnClick()
	'이동한 화면에서 다시 돌아왔을때 세팅해줄 펀드정보 저장
	Form.SetSharedData("51010_Fund_Code" , g_szShortCd)
	Form.SetSharedData("51010_Stnd_Code" , g_szStndCd)
	Form.SetSharedData("51010_Fund_Name" , g_szFndname)
	
	'투자성향진단 화면 이동
	Form.OpenScreen("81010" , "")	
End Sub

'============================================================================
Sub cont01_btnInfoConfirm_OnClick()
	'결제정보 확인하기 버튼
	if	g_szShortCd	=	NULL  or	len(g_szShortCd) < 3 	then
		Form.ShowAlert(g_szAlertTitle, "종목 코드를 입력하세요.")
		Exit	Sub
	end	if
	
	
	if	len(g_szShortCd)	>	0	and	len(g_szFndname) > 0	then
		'-------------------------
		' 결제정보 팝업:  
		' 1. ShortCode
		' 2. 펀드명 
		'--------------------------
		Form.OpenPopup("mbfnp51010_p3" , g_szShortCd & "★" & g_szFndname , "")
	end if
End Sub

'============================================================================
Sub cont01_lblPopUp_OnClick()

	Form.OpenPopup("mbonl81010_p20" , "" , "")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
End Sub

