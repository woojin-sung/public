		DATAMANAGER.RequestTranData("obpds_srvc_323r_3")
	end if
End Sub

Sub chk11_OnChange(sCheckState)
	if sCheckState == "1" then
		Dim sCsno
		sCsno = Form.GetSharedData("&CUST_NUM", false)
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_4", "InBlock1", "SVCD" , 0 , "083")	'해외ETP
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_4", "InBlock1", "CSNO" , 0 , sCsno)	'고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_323r_4")
	end if
End Sub

