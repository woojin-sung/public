'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경 (계약정보)
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2022.10.24 : 고승연 : v0002 : 계좌일련번호 추가
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정, ETP투자여부 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szWA_PRCD		'랩상품코드
Dim g_sAcno
Dim g_sAsno
Dim g_sCnrcNo
Dim g_sAbleYN
Dim g_tData

' g_tData(0)		= 상품코드
' g_tData(1)		= 거래소
' g_tData(2)		= 코드닥
' g_tData(3)		= 코넥스
' g_tData(4)		= ETN
' g_tData(5)		= K-OTC
' g_tData(5)		= 파생ETF
' g_tData(6)		= 해외주식
' g_tData(7)		= 해외ETP
' g_tData(8)		= 선물옵션매수/청산
' g_tData(9)		= 모든선물옵션
' g_tData(10)		= 채권
' g_tData(11)		= 펀드
' g_tData(12)		= MMW자동투자

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgDot0.setMaintainingRatio("1")
	imgDot1.setMaintainingRatio("1")
	imgDot2.setMaintainingRatio("1")
	imgDot3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim sData
	sData = Form.GetOpenLinkData()
	
	if sData <> null and sData <> "" then
		g_tData = Split(sData, "|")
		g_szWA_PRCD = g_tData(0)
		g_sAcno = g_tData(1)
		g_sAsno = g_tData(2)
		g_sCnrcNo = g_tData(3)
		
		DATAMANAGER.RequestTranData("obwat_pdad_065r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_pdad_065r" then '운용대상자산
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD)	'랩어카운트상품코드	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_pdad_065r" then '운용대상자산
		sMGRI_MNBD_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MGRI_MNBD_CLS_CODE" , 0)	'운용주체구분
	
		if sMGRI_MNBD_CLS_CODE == "1" then
			g_sAbleYN = "N"
		else
			g_sAbleYN = "Y"
		end if
			
		sEXCH_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EXCH_INVT_YN" , 0)	'거래소
		sKOSDAQ_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KOSDAQ_INVT_YN" , 0)	'코스닥
		sKONEX_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KONEX_INVT_YN" , 0)	'코넥스		
		sETN_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETN_INVT_YN" , 0)	'ETN
		sOTC_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTC_INVT_YN" , 0)	'K-OTC
		sDRVT_ETF_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DRVT_ETF_INVT_YN" , 0)	'파생ETF
		
		sOVRS_STCK_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OVRS_STCK_INVT_YN" , 0)	'해외주식
		sOVRS_ETP_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETP_INVT_YN" , 0)	'해외ETP
		
		sCLRN_INDC_YN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CLRN_INDC_YN" , 0)	'선물옵션매수/청산만 허용
		sOPTN_TR_ABLE_YN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OPTN_TR_ABLE_YN" , 0) '모든선물옵션
		
		sBOND_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BOND_INVT_YN" , 0)	'채권
		sFND_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FND_INVT_YN" , 0)	'펀드
		sMMW_ATMT_INVT_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MMW_ATMT_INVT_YN" , 0)
		
		f_Check("chk00", sEXCH_INVT_YN)
		f_Check("chk01", sKOSDAQ_INVT_YN)
		f_Check("chk02", sKONEX_INVT_YN)
		f_Check("chk03", sETN_INVT_YN)
		f_Check("chk04", sOTC_INVT_YN)
		f_Check("chk05", sDRVT_ETF_INVT_YN)
		
		f_Check("chk10", sOVRS_STCK_INVT_YN)
		f_Check("chk11", sOVRS_ETP_INVT_YN)
		
		f_Check("chk20", sCLRN_INDC_YN)
		f_Check("chk21", sOPTN_TR_ABLE_YN)
		
		f_Check("chk30", sBOND_INVT_YN)
		f_Check("chk31", sFND_INVT_YN)
		f_Check("chk32", sMMW_ATMT_INVT_YN)
		
		chk20.enable = false
		
		if sMGRI_MNBD_CLS_CODE == "1" then
			chk00.enable = false
			chk01.enable = false
			chk02.enable = false
			chk03.enable = false
			chk04.enable = false
			chk05.enable = false
			
			chk10.enable = false
			chk11.enable = false
			
			chk20.enable = false
			chk21.enable = false
			
			chk30.enable = false
			chk31.enable = false
			chk32.enable = false
		end if
	elseif szTranID = "obpds_srvc_323r" then
		Dim sSVCD
		sSVCD = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVCD" , 0)
		
		if Len(Trim(sSVCD)) == 0 then
			Form.ShowAlert("", "ETN 약정 미등록 상태입니다.")
			chk03.checkstate = 0
		end if 
	elseif szTranID = "obpds_srvc_323r_1" then
		Dim sSVCD
		sSVCD= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r_1" , "OutBlock1" , "SVCD" , 0)
		
		if Len(Trim(sSVCD)) == 0 then
			Form.ShowAlert("", "K-OTC 약정 미등록 상태입니다.")
			chk04.checkstate = 0
		end if 
	elseif szTranID = "obpds_srvc_323r_2" then
		Dim sSVCD
		sSVCD= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r_2" , "OutBlock1" , "SVCD" , 0)
		
		if Len(Trim(sSVCD)) == 0 then
			Form.ShowAlert("", "파생ETF 약정 미등록 상태입니다.")
			chk05.checkstate = 0
		end if 
	elseif szTranID = "obpds_srvc_323r_3" then
		Dim sSVCD
		sSVCD= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r_3" , "OutBlock1" , "SVCD" , 0)
		
		if Len(Trim(sSVCD)) == 0 then
			Form.ShowAlert("", "해외주식 약정 미등록 상태입니다.")
			chk10.checkstate = 0
		end if 
	elseif szTranID = "obpds_srvc_323r_4" then
		Dim sSVCD
		sSVCD= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r_4" , "OutBlock1" , "SVCD" , 0)
		
		if Len(Trim(sSVCD)) == 0 then
			Form.ShowAlert("", "해외ETP 약정 미등록 상태입니다.")
			chk11.checkstate = 0
		end if 
	end if
End Sub

Sub f_Check(sCtlName, sYN)
	Dim sState
	
	if sYN == "Y" then
		sState = "1"
	else
		sState = "0"
	end if
	
	if g_sAbleYN == "Y" then
		Form.SetCtlProp(sCtlName, "enable", sState)
	end if
	
	if #g_tData == 17 then
		if sCtlName == "chk00" then
			if g_tData(4) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk01" then
			if g_tData(5) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk02" then
			if g_tData(6) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk03" then
			if g_tData(7) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk04" then
			if g_tData(8) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk05" then
			if g_tData(9) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk10" then
			if g_tData(10) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk11" then
			if g_tData(11) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk20" then
			if g_tData(12) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk21" then
			if g_tData(13) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk30" then
			if g_tData(14) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk31" then
			if g_tData(15) == "N" then
				sState = "0"
			end if
		elseif sCtlName == "chk32" then
			if g_tData(16) == "N" then
				sState = "0"
			end if
		end if
	end if
	
	Form.SetCtlProp(sCtlName, "checkstate", sState)
End Sub

Function CheckYN(sCtlName)
	Dim sState
	sState = Form.GetCtlProp(sCtlName, "checkstate")
	CheckYN = sState = "1" and "Y" or "N"
End Function

'============================================================================
Sub btnTrans_OnClick()
	Dim sData
	
	sData = CheckYN("chk00").."|"..CheckYN("chk01").."|"..CheckYN("chk02").."|"
	sData = sData..CheckYN("chk03").."|"..CheckYN("chk04").."|"..CheckYN("chk05").."|"
	
	sData = sData..CheckYN("chk10").."|"..CheckYN("chk11").."|"
	
	sData = sData..CheckYN("chk20").."|"..CheckYN("chk21").."|"
	
	sData = sData..CheckYN("chk30").."|"..CheckYN("chk31").."|"
	sData = sData..CheckYN("chk32")
	
	Form.SendReturnToParent("Invt", sData)
	Form.CloseForm()
End Sub



