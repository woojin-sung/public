		<CHKBUTTON name="chk21" chkcaption="모든 선물옵션" unchkcaption="모든 선물옵션" ly_vert="36,476,131,17,1" />
		<IMAGE name="imgDot3" imgpath="icon_dot.png" ly_vert="11,504,26,30,1" />
