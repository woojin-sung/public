		<CHKBUTTON name="chk01" chkcaption="코스닥" unchkcaption="코스닥" ly_vert="151,304,100,17,1" />
		<CHKBUTTON name="chk02" chkcaption="코넥스" unchkcaption="코넥스" ly_vert="266,304,100,17,1" />
		<CHKBUTTON name="chk03" chkcaption="ETN" unchkcaption="ETN" ly_vert="36,328,100,17,1" />
		<CHKBUTTON name="chk04" chkcaption="K-OTC" unchkcaption="K-OTC" ly_vert="151,328,100,17,1" />
