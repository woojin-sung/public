'============================================================================
Sub chk03_OnChange(sCheckState)
	if sCheckState == "1" then
		Dim sCsno
		sCsno = Form.GetSharedData("&CUST_NUM", false)
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "065")	'ETN
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , sCsno)	'고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	end if
End Sub

'
'============================================================================
Sub chk04_OnChange(sCheckState)
	if sCheckState == "1" then
		Dim sCsno
		sCsno = Form.GetSharedData("&CUST_NUM", false)
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_1", "InBlock1", "SVCD" , 0 , "061")	'K-OTC
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_1", "InBlock1", "CSNO" , 0 , sCsno)	'고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_323r_1")
	end if
End Sub

'
'============================================================================
Sub chk05_OnChange(sCheckState)
	if sCheckState == "1" then
		Dim sCsno
		sCsno = Form.GetSharedData("&CUST_NUM", false)
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_2", "InBlock1", "SVCD" , 0 , "054")	'ETF
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_2", "InBlock1", "CSNO" , 0 , sCsno)	'고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_323r_2")
	end if
End Sub

Sub chk10_OnChange(sCheckState)
	if sCheckState == "1" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r_3", "InBlock1", "SVCD" , 0 , "082")	'해외주식
