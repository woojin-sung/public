'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약이체
' 02. 화면설명 : 예약이체_메인폼
' 03. 작    성 : 16.03.08
' 04. 수    정 : v001 : 메모리 평문 제거
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName	'계좌명

Dim g_szData	'계좌번호+일련번호+비밀번호+계좌명

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	g_szAccountNumber = cmbAccount.total 
	g_szAccountSerialNumber = cmbAccount.sequence
	g_szAccountPassword = ""
	edtPassword.caption = ""
	g_szAccountName = lblAccountName.caption
	
	g_szData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & g_szAccountName	
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AllAccount", g_szData)

'	FormTab0.currenttab = 0
End Sub

'============================================================================
Sub btnSearch_OnClick()
	'조회
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	g_szAccountNumber = cmbAccount.total 
	g_szAccountSerialNumber = cmbAccount.sequence
	g_szAccountPassword = ""
	edtPassword.caption = ""
	g_szAccountName = lblAccountName.caption
	
	g_szData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & g_szAccountName
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AllAccount", g_szData)
End Sub

'============================================================================
Sub edtPassword_OnEditComplete()
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption) v001 주석처리
	'v001 sta *******************
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	If plain_rm = "1" Then
	    g_szAccountPassword = edtPassword.caption
	Else
	    g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	'v001 fin *******************
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "Password", g_szAccountPassword)
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	g_szData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & g_szAccountName
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AllAccount", g_szData)

End Sub

