		<ACCOUNT name="cmbAccount" itemcodetype="100,101,102,103,104,105,106,107,108,109,110,112,114,115,117,118,124,125,126,127,128,129,130,132,135,136,137,138,139,140,200" etcfunctions="" accpwdctl="edtPassword" accnamectl="lblAccountName" ly_vert="5,6,271,39,1" />
		<EDIT name="edtPassword" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" ly_vert="282,6,86,39,1" />
		<FORMTAB name="FormTab0" tabcount="3" tabwidthtype="1" tabheadheight="35" autosave="1" ly_vert="0,57,375,505,1" >
