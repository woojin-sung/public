'============================================================================
' 01. 화 면 명 : 불원등록
' 02. 화면설명 : 불원등록
' 03. 작    성 : 2016.01.18 ~ 최지희
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2021.05.22 : 정민영 : v0002 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserCode	'고객번호
Dim g_szYoN		'불원여부
Dim g_nAccountNumber	'계좌번호
Dim g_nPassword		'계좌비밀번호
Dim g_szChangeState	'변경상태
Dim g_plain_rm  		'v0001 메모리평문적용여부


'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)

	if szTranID == "obacp_opop_064r" then	'종합계좌기준계좌컨트롤조회
		DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obacp_opop_064r")	
	elseif szTranID == "obpds_srvc_045a" then	'서비스약정메인tr
		DATAMANAGER.SetDataValue(0,"obpds_srvc_045a", "InBlock1", "ACNO" , 0 , g_nAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_nPassword)	'계좌비밀번호
		DATAMANAGER.RequestTranData("obpds_srvc_045a")
	elseif szTranID == "obpds_srvc_323r" then	'hts/wts용 서비스 내역 조회
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	end if
	
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_045a" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , g_szYoN)	'처리구분코드, 불원여부
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_szUserCode)		'고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "048")			'서비스 코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO", 0 , edtSrno.caption)	'서비스 일련번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE", 0 , "02")	'서비스 관리 단위코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_045a", "InBlock1", "ELFN_ID", 0 , Form.GetSharedData("&USER_ID" , false))		'HTS ID
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" , 0 , "4")		'접촉 구분코드
	end if
	
	if szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "048")			'서비스코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_szUserCode)		'고객번호
	end if
End Sub



'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_064r" then
		g_szUserCode = DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		TR_Inquiry("obpds_srvc_323r")
	end if
	
	if szTranID == "obpds_srvc_323r" then
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0) == "N" then
			tblState.SetCellString( 0, 1, "통보불원" )			
			btnEnroll.visible = false
			btnCancel.visible = true
		else
			tblState.SetCellString( 0, 1, "통보희망" )			
			btnEnroll.visible = true
			btnCancel.visible = false
		end if	
	end if
	
	if szTranID == "obpds_srvc_045a" then
		'(2022.05.24) 메시지박스 대체 mbonl87020_p1
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_045a", "OutBlock1", "SVC_SRNO" , 0) <> "" AND g_szYoN = "I" then
'			Form.MsgBox("알림", "HTS불원 약정이 등록되었습니다.", "", 0)
			Form.OpenPopup("mbonl87020_p1" , "I" , "")
		elseif DATAMANAGER.GetDataValue(0, "obpds_srvc_045a", "OutBlock1", "SVC_SRNO" , 0) <> "" AND g_szYoN = "D" then
'			Form.MsgBox("알림", "HTS불원 약정이 해지되었습니다.", "", 0)
			Form.OpenPopup("mbonl87020_p1" , "D" , "")
		end if
		
		'mbonl87020_p1 팝업리턴에서 호출 예정으로 주석처리
'		TR_Inquiry("obpds_srvc_323r")
'
'		g_szChangeState = "ok"
	
	end if
	
	
End Sub


'============================================================================
' btnSearch_OnClick - 조회버튼 obacp_opop_064r tr요청
'============================================================================
Sub btnSearch_OnClick()
	TR_Inquiry("obacp_opop_064r")
End Sub





'============================================================================
' btnEnroll_OnClick - 등록버튼
'============================================================================
Sub btnEnroll_OnClick()
	g_szYoN = "I"	
	if g_nPassword <> "" and Trim(edtPassword.caption) <> "" then
		if tblState.GetCellString( 0, 1 ) == "불원" then
			Form.MsgBox("알림", "이미 등록된 약정입니다.", "", 0)
			g_nPassword = ""
			edtPassword.caption = ""
		else
			TR_Inquiry("obpds_srvc_045a")
			g_nPassword = ""
			edtPassword.caption = ""
		end if
	else
		Form.MsgBox("알림", "비밀번호를 입력해 주세요.", "", 0)
	end if
	TR_Inquiry("obacp_opop_064r")
End Sub




'============================================================================
' btnCancel_OnClick - 해지버튼
'============================================================================
Sub btnCancel_OnClick()
	g_szYoN = "D"
	Dim szCode
	szCode = DATAMANAGER.GetDataValue(0,"obpds_srvc_323r", "OutBlock1", "SVC_SRNO" , 0)
	DATAMANAGER.SetDataValue(0,  "obpds_srvc_045a", "InBlock1", "SVC_SRNO", 0 , szCode)	'서비스 일련번호
		
	if g_nPassword <> "" and Trim(edtPassword.caption) <> "" then
		if tblState.GetCellString( 0, 1 ) == "통보희망" then
			Form.MsgBox("알림", "이미 해지된 약정입니다.", "", 0)
			g_nPassword = ""
			edtPassword.caption = ""
		else
			TR_Inquiry("obpds_srvc_045a")
			g_nPassword = ""
			edtPassword.caption = ""
		end if
	else
		Form.MsgBox("알림", "비밀번호를 입력해 주세요.", "", 0)
	end if
	
	TR_Inquiry("obacp_opop_064r")	'재조회
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obpds_srvc_045a" then
		Form.MsgBox("알림", szErrMsg, "", 0)
	end if
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	g_szChangeState = "cancel"
	g_nAccountNumber = cmbAccount.total
	'v0001 
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    g_nPassword = edtPassword.caption		
	else  'MTS메모리평문 미적용상태일때
	    g_nPassword = Form.GetEncData(edtPassword.caption)		
	end if
	
	btnSearch_OnClick()
End Sub

'============================================================================
' edtPassword_OnEditComplete
'============================================================================
Sub edtPassword_OnEditComplete()
	'v0001 
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    g_nPassword = edtPassword.caption
	else  'MTS메모리평문 미적용상태일때
	    g_nPassword = Form.GetEncData(edtPassword.caption)
	end if
	
	btnSearch_OnClick()
End Sub


'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl87020" , g_szChangeState )
End Sub


'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_nAccountNumber = cmbAccount.total
	edtPassword.caption = ""
	'v0001 
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    g_nPassword = edtPassword.caption
	else  'MTS메모리평문 미적용상태일때
	    g_nPassword = Form.GetEncData(edtPassword.caption)
	end if
	
	btnSearch_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'완료팝업 리턴 처리
	if sKeyName == "mbonl87020_p1" then
		TR_Inquiry("obpds_srvc_323r")

		g_szChangeState = "ok"
	end if
End Sub

