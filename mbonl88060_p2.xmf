'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	szTheme = Form.GetEnvData("common.theme")
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	g_szScrno = "88060"
	f_InitUI()
	
	'종목코드, 거래수익률, 매매금액(주문수량 동일)
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		
		g_ISCD 					= tData[0]
		g_GNRL_INTRT 				= tData[1]
		g_ODQT 					= tData[2]
		g_INVT_DYNU		 		= tData[3]
		g_INVT_ABLE_AMT	 		= tData[4]
		g_RMNN_WNCR_AMT 			= tData[5]
		g_KOR_ISNM 				= tData[6]
		g_FILE_PATH_NAME			= tData[7]
		
		g_INVT_TRGT_TYPE_CODE		= tData[8]
		g_IQRY_CLS_CODE			= tData[9]
		g_TRGT_CLS_CODE			= tData[10]
		
		g_RCRT_FIN_DATE			= tData[11]
		g_SHTR_BOND_REG_CLS_CODE	= tData[12]
		g_PSNT_DATE				= tData[13]
		
		g_PROD_GRAD_CODE			= tData[14]
		g_CRDT_GRAD				= tData[15]
		g_CREN_CO_NAME			= tData[16]
		
		'2줄로 처리된 종목명을 다시 한줄로
		g_KOR_ISNM = Replace(g_KOR_ISNM, "\n", "")
		
		contInput.Label0.caption = g_KOR_ISNM
		
		contInput.Table0.SetCellString(2, 0, "1억원")	'최소주문금액
		contInput.Table0.SetCellString(2, 1, g_INVT_DYNU)		'투자기간	
		contInput.Table0.SetCellString(2, 2, g_GNRL_INTRT)	'수익률			
		
		contInput.Table1.SetCellString(0, 1, g_RMNN_WNCR_AMT)	'잔여수량
		contInput.Table3.SetCellString(0, 2, g_INVT_ABLE_AMT)	'매수가능금액		
		
		'개선 추가
		'상품등급 뱃지, 신용등급 뱃지
		contInput.lblBadge1.caption = g_PROD_GRAD_CODE
		if Trim(g_PROD_GRAD_CODE) == "매우높은위험" then
			contInput.imgBadge1.imgpath = "img_bgsquare_grade_372.png"
			contInput.lblBadge1.fgcolor = "273"
		elseif Trim(g_PROD_GRAD_CODE) == "높은위험" then
			contInput.imgBadge1.imgpath = "img_bgsquare_grade_373.png"
			contInput.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "다소높은위험" then
			contInput.imgBadge1.imgpath = "img_bgsquare_grade_374.png"
			contInput.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "보통위험" then
			contInput.imgBadge1.imgpath = "img_bgsquare_grade_375.png"
			contInput.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "낮은위험" then
			contInput.imgBadge1.imgpath = "img_bgsquare_grade_376.png"
			contInput.lblBadge1.fgcolor = "144"
		elseif Trim(g_PROD_GRAD_CODE) == "매우낮은위험" then
			contInput.imgBadge1.imgpath = "img_bgsquare_grade_377.png"
			contInput.lblBadge1.fgcolor = "273"
		end if
'		
'		if Trim(g_PROD_GRAD_CODE) == "초고위험" then
'			contInput.imgBadge1.imgpath = "img_bgsquare_grade_296.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "고위험" then
'			contInput.imgBadge1.imgpath = "img_bgsquare_grade_297.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "중위험" then
'			contInput.imgBadge1.imgpath = "img_bgsquare_grade_298.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "저위험" then
'			contInput.imgBadge1.imgpath = "img_bgsquare_grade_299.png"
'		elseif Trim(g_PROD_GRAD_CODE) == "초저위험" then
'			contInput.imgBadge1.imgpath = "img_bgsquare_grade_300.png"
'		end if
		
		contInput.lblBadge2.caption = g_CRDT_GRAD
		contInput.imgBadge2.imgpath = "img_bgsquare_grade_316.png"
		
		'신용보강회사
		if g_CREN_CO_NAME <> "" and g_CREN_CO_NAME <> null then
			contInput.lblCreditCo.caption = "신용보강 " & g_CREN_CO_NAME
		end if
	end if
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	contInput.edtPassword.caption = ""
	if g_szSavePwd == "0" then
		contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
		contInput.edtPassword.caption = ""
	else
		contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	contInput.btnPwd.bringfront("1")
	
	szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	Init_InputControl()
	
	'계좌 체크
	if contInput.cmbAccount.caption <> "" and contInput.cmbAccount.caption <> null then 
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		'KEK. receivecomplete (obsap_deal_003r)로 위치 변경
		'DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		
		DATAMANAGER.RequestTranData( "obsap_deal_003r" )	'장외_전단채모집관리매수가능종목조회
		
	end if
	
	'안드로이드인 겨웅, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contInput.setScrollBarVisible("2")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contInput.edtPassword.pwdlen = tData(1)
				contInput.edtPassword.caption = tData(0)
				
				DATAMANAGER.RequestTranData("obcsb_acad_122a")
			end if
			
		end if
		
	'===============================================
	'********** 약관 동의 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbonl88060_p4" Then		
'		if sRet == "ok" then
'			Dim sSendData
'			sSendData = contInput.cmbAccount.total&contInput.cmbAccount.sequence&"☆"&"0"
'			'비밀번호 팝업 띄움..	
'			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
'		end if
		
	'===============================================
	'********** 고객정보 변경 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName = "mbonl81000" Then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if
		
	'===============================================
	' 가격입력창에서 리턴
	'===============================================
	elseif sKeyName == "PRC_POPUP" then	
		contInput.Label1.top = 0
		
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			contInput.ImgPrcreset.visible = true
			g_szPopPrc = sRet
			
			contInput.LblAlert.visible = 1
			
			call contInput_LblPrcin_OnClick()
		else
'			contInput.ImgPrcreset.visible = false
'			contInput.LblAlert.caption = ""	'' 
'			contInput.BtnPrcin.caption = "금액을 입력해주세요"
'			
'			contInput.LblAlert.visible = 0			
			
			Init_InputControl()
		end if

	'===============================================
	'원금보존 추구자금 확인 
	'===============================================
	elseif sKeyName == "mbonl88060_p3_agree" then		

		if sRet == "Y" then
			'상품가입 불가
			
			'KEK STA. 원금보존 무조건 받고 700r 조회 했을때 메시지 팝업띄어줌.
			'Form.MsgBox("원금보존 위험상품 안내" , "고객님은 금융투자자금 원금보존을 선택하였습니다. 해당 상품은 위험등급 4등급 이상으로 투자자보호를 위해 단기사채 가입이 제한됩니다.", "ME_CLOSE", "6")
			g_sAgree = "Y"
			DATAMANAGER.RequestTranData( "obcsb_acif_792a" )
			'KEK FIN.
			
		else
			g_sAgree = "N"
			DATAMANAGER.RequestTranData( "obcsb_acif_792a" )
		end if
'						
	'===============================================
	'********** 투자권유 희망여부 확인서 리턴      ***********
	'===============================================		
'	ElseIf sKeyName == "MBBDM85147"  Then
'		if sRet = "ok" then
'			'투자성향등록여부, 투자성향만기여부
'			DATAMANAGER.RequestTranData( "obcsb_acif_700r_1" )
'		end if
	
	ElseIf sKeyName == "mbonl81010_p23"  Then
		if sRet = "OK" then
			g_MesuGO = "OK"			
			'투자성향등록여부, 투자성향만기여부
			DATAMANAGER.RequestTranData( "obcsb_acif_700r" )
'			btnReg_OnClick()
		end if
		
	'===============================================
	'********** 투자성향대비 고위험거래 확인서 리턴      ***********
	'===============================================		
	elseif	sKeyName = "mbonl81010_p2"		then						'고위험거래확인팝업
		if	sRet	=	"CANCEL"	then		'취소버튼
			'v003
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		elseif sRet	=	"OK"	then		'확인버튼
			Form.OpenPopup("mbonl81010_p24" , g_szScrno	& "★" & contInput.cmbAccount.caption & "★" & contInput.cmbAccount.sequence & "★" &
											 "01"& "★" & "13005"	& "★" & g_ISCD & "★" &
											 g_KYC_INVT_INCL_GRAD_CODE	& "★" & g_KYC_PROD_GRAD_CODE & "★" &
											 g_KYC_DVPD_EPMD_CODE		& "★" & g_KYC_DRVT_PROS_YN	& "★" & g_DVPD_GRAD_CODE
					     	, sPosInfo)				
'			'21.08.26 JHY 변경 : 박미선 대리님 요청으로 해당 팝업 타이틀 중간에 짤리지 않게 타이틀 생성했으므로 openpopup으로 변경
'			Form.OpenPopup("mbonl81010_p3" , g_szScrno	& "★" & contInput.cmbAccount.caption & "★" & contInput.cmbAccount.sequence & "★" &
'											 "01"& "★" & "13005"	& "★" & g_ISCD & "★" &
'											 g_KYC_INVT_INCL_GRAD_CODE	& "★" & g_KYC_PROD_GRAD_CODE & "★" &
'											 g_KYC_DVPD_EPMD_CODE		& "★" & g_KYC_DRVT_PROS_YN	& "★" & g_DVPD_GRAD_CODE
'					     	, sPosInfo)		
		end if
		
	'===============================================
	'********** 고위험거래가입팝업      ***********
	'===============================================		
	elseif	sKeyName = "mbonl81010_p24"	then		
		if	sRet	=	"CANCEL"	then		'취소버튼
			Form.SendReturnToParent("KYCCHK_RETURN" , "N")
			Form.CloseForm()
		elseif sRet	=	"OK"	then		'확인버튼
			DATAMANAGER.RequestTranData("obsac_deal_209a")
		end if
	
	'===============================================
	'********** 투자주요내욕 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbonl88060_p13"  Then 	
		if sRet = "ok" then
			Dim sSendData
			sSendData = contInput.cmbAccount.total&contInput.cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
	
	'===============================================
	'********** 신청 등록완료 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbonl88060_p5"  Then 	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			g_szRet = sRet
			Form.CloseForm()
		end if
	End if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "obpds_srvc_433a_2" then
		if sRet == "close" then
			'진입화면으로 이동
			Form.OpenScreen("88026" , "")
			Form.CloseForm()
			Exit Sub
		end if

	elseif sKeyName == "ME_CLOSE" then
		if sRet == "close" then
		
		    'KEK STA. 원금보존 무조건 받고 700r 조회 했을때 메시지 팝업띄어줌.
		    'g_sAgree = "Y"
		    'DATAMANAGER.RequestTranData( "obcsb_acif_792a" )		
			Form.CloseForm()
		    'KEK FIN.
			
			Exit Sub
		end if
	
	elseif sKeyName = "RELOAD" then	
		'잔여수량 재조회
		g_Reload = "ok"
		DATAMANAGER.RequestTranData( "obsac_deal_211r" )
		
	elseif sKeyName = "RELOAD_1" then	
		'매수가능금액 재조회
		g_Reload_1 = "ok"
		DATAMANAGER.RequestTranData( "obsap_deal_003r" )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = contInput.edtPassword.caption
	Else
		 szPwd = contInput.edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = contInput.edtPassword.caption
	    end if
	End If
	'고객번호
	dim szCust_Num
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
		
	'폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , contInput.cmbAccount.total)	
		
	'고객번호로 전문투자자여부 조회
	elseif szTranID == "obcsb_acif_799r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
'
	elseif szTranID == "obcsb_acif_700r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , contInput.cmbAccount.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , contInput.cmbAccount.sequence )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"	, 0 , "01" )	'KYC 업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE"		, 0 , "13005" )	'업무 분류 코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0 , g_ISCD )	'종목코드

	elseif szTranID == "obcsb_acif_792a" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , contInput.cmbAccount.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , contInput.cmbAccount.sequence )	'계좌일련번호		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRNC_PRSV_YN" 		, 0, g_sAgree)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOD_REAS_RMRK"		, 0, "")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FNPR_JOIN_SRNO"		, 0, g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")

	elseif szTranID == "obsac_deal_211r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" 		, 0, "1")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0, g_ISCD)

	elseif szTranID == "obsap_deal_003r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , contInput.cmbAccount.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , contInput.cmbAccount.sequence )
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INVT_TRGT_TYPE_CODE" , 0 , g_INVT_TRGT_TYPE_CODE )	'투자대상유형코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , g_IQRY_CLS_CODE )	'조회구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KOR_ISNM" , 0 , "%" )	'한글종목명
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRGT_CLS_CODE" , 0 , g_TRGT_CLS_CODE )	'대상구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"	  , 0 , szUSERID)

	elseif szTranID == "obfnp_fnmt_994r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , "5" )	'처리구분코드

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 0 , g_ISCD )
		
		if g_SHTR_BOND_REG_CLS_CODE == "1" then	
			'''obsap_deal_003r.SHTR_BOND_REG_CLS_CODE : 1(발행물)인 경우, 모집종료일로 이자계산
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 1 , g_RCRT_FIN_DATE )
		else	
			'''obsap_deal_003r.SHTR_BOND_REG_CLS_CODE : 2(유통물)인 경우, 현재일자로 이자계산
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 1 , Form.GetSharedData( "&HOST_DATE", false ) )
		end if	

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 2 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 3 , g_GNRL_INTRT )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 4 , CDBL(contInput.LblPrcin.caption) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 5 , 1 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CODE_ID"	, 6 , "" )

	'전자단기사채 온라인 매수신청 처리
	elseif szTranID == "obsac_deal_209a" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "3")	'1:신청/2:취소/3:조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , contInput.cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , contInput.cmbAccount.sequence)'계좌번호접촉구분코드
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"	, 0 , g_ISCD				)	'종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT" , 0 , CDBL(contInput.LblPrcin.caption))	'주문수량
		'KEK. 매매금액 추가-매수가능금액 체크
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_AMT", 0 , g_DiscountedAmt)	'주문수량
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4") '2023.06.15 추가
	elseif szTranID == "obcsb_acad_122a" then			
		dim strCustTelno, strAddr, strInagTypeCode, strInagSrno

		if g_szNotiFlag == "talk" then
			strCustTelno = contInput.contNoti.tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = contInput.contNoti.tblUserInfo.GetCellString(0, 2)
			strInagSrno = contInput.contNoti.tblUserInfo.GetCellString(0, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
		elseif g_szNotiFlag == "email" then
			strAddr = contInput.contNoti.tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = contInput.contNoti.tblUserInfo.GetCellString(1, 2)
			strInagSrno = contInput.contNoti.tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , strAddr)
		End If 
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	
	'전자단기사채 온라인 매수신청 처리
	elseif szTranID == "obsac_deal_209a_1" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "1")	'1:신청/2:취소
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , contInput.cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , contInput.cmbAccount.sequence)'계좌번호접촉구분코드
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CP_TAX_LEVY_CLS_CODE" , 0 , "02")	'CP세금징수구분코드(02:후취)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"	, 0 , g_ISCD				)	'종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TR_ERT" , 0 , g_GNRL_INTRT)	'거래수익률
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT" , 0 , CDBL(contInput.LblPrcin.caption))	'주문수량
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_AMT" , 0 , g_DiscountedAmt)	'매매금액
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)	'금융상품가입일련번호
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4") '2023.06.15 추가
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_140r" then
		Dim iCnt, iCnt1
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 	
			contInput.contNoti.tblUserInfo.SetCellString(0, 1, "")
			contInput.contNoti.tblUserInfo.SetCellString(0, 2, "")
			contInput.contNoti.tblUserInfo.SetCellString(0, 3, "")
			contInput.contNoti.tblUserInfo.SetCellString(1, 1, "")
			contInput.contNoti.tblUserInfo.SetCellString(1, 2, "")
			contInput.contNoti.tblUserInfo.SetCellString(1, 3, "")
			
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
					contInput.contNoti.tblUserInfo.SetCellString(1, 1, strAddr)
					contInput.contNoti.tblUserInfo.SetCellString(1, 2, strInagTypeCode2)
					contInput.contNoti.tblUserInfo.SetCellString(1, 3, strInagSrno2)
			    End If
			Next 	
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    contInput.contNoti.tblUserInfo.SetCellString(0, 1, strCustTelno)
				    contInput.contNoti.tblUserInfo.SetCellString(0, 2, strInagTypeCode3)
				    contInput.contNoti.tblUserInfo.SetCellString(0, 3, strInagSrno3)
			    End If
			Next
			
			f_SetToggleData(g_szNotiFlag)
		End If 
		
'	elseif szTranID == "obsap_acif_999a" then	
'		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		
'		DATAMANAGER.RequestTranData( "obcsb_acif_799r" ) '고객번호로 전문투자자여부 조회
		
	elseif szTranID == "obcsb_acif_799r" then
		g_UI_PFIN_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "UI_PFIN_YN", 0)	'전문투자자여부

		if g_UI_PFIN_YN == "N"  then
			'투자자금 원금보존 확인
			Form.openPopupAnimation("mbonl88060_p3" , g_szFnprJoinSrno.."|"..contInput.cmbAccount.total.."|"..contInput.cmbAccount.sequence , "", "2")
			Exit Sub
		end if
		
	elseif szTranID == "obcsb_acif_792a" then 
		g_MesuGO = "NO"
		DATAMANAGER.RequestTranData("obcsb_acif_700r")		'제대로 등록되면 PROS_YN : C 가 나오지 않음.
		
	'LHR 투자성향진단 추가
	elseif szTranID == "obcsb_acif_700r" then
		g_ProsYN	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "PROS_YN", 0)
		g_KYC_INVT_RCMD_CLS_CODE 	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0) '적정성상품여부 v011
		
		g_KYC_INVT_INCL_GRAD_CODE	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		g_KYC_PROD_GRAD_CODE		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_PROD_GRAD_CODE", 0)
		g_KYC_DVPD_EPMD_CODE		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_DVPD_EPMD_CODE", 0)
		g_KYC_DRVT_PROS_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_DRVT_PROS_YN", 0)
		g_DVPD_GRAD_CODE			=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "DVPD_GRAD_CODE", 0)		
		
'		g_ProsYN = "Y"
'		g_KYC_INVT_RCMD_CLS_CODE = "3"
'ShowAlert(szTranID, g_ProsYN .. " : " .. g_MesuGO .. " ; " .. g_KYC_INVT_RCMD_CLS_CODE)

		if g_MesuGO == "NO" then
			if (g_ProsYN == "Y" or g_ProsYN == "N") and (g_KYC_INVT_RCMD_CLS_CODE = "3" or g_KYC_INVT_RCMD_CLS_CODE = "4") then	'미제공 or 불원
				'투자권유희망서 작성 팝업 호출
			    Form.OpenPopup("mbonl81010_p23" , g_szScrno	& "★" & contInput.cmbAccount.total	& "★" & contInput.cmbAccount.sequence & "★" &
									 "01"	& "★" & "13005"	& "★" & g_ISCD & "★" &
									 g_KYC_INVT_INCL_GRAD_CODE	& "★" & g_KYC_PROD_GRAD_CODE & "★" & g_KYC_INVT_RCMD_CLS_CODE
								, sPosInfo)								
	'		    Form.OpenFramePopup("mbonl81010_p10" , g_szScrno	& "★" & contInput.cmbAccount.total	& "★" & contInput.cmbAccount.sequence & "★" &
	'								 "01"	& "★" & "13005"	& "★" & g_ISCD & "★" &
	'								 g_KYC_INVT_INCL_GRAD_CODE	& "★" & g_KYC_PROD_GRAD_CODE & "★" & g_KYC_INVT_RCMD_CLS_CODE
	'							, sPosInfo)
				Exit Sub
				
			elseif g_ProsYN == "Y" then
				'고위험거래팝업				
				Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
												g_KYC_INVT_INCL_GRAD_CODE	& "★" & g_KYC_PROD_GRAD_CODE	& "★" &
												g_KYC_DVPD_EPMD_CODE 	& "★" & g_KYC_DRVT_PROS_YN	& "★" & g_DVPD_GRAD_CODE
								, sPosInfo)
			
			elseif g_ProsYN == "D" then '원금보존 투자자금 가입불가 상품
				' v002
				Form.MsgBox("원금보존 위험상품 안내" , "고객님은 금융투자자금 원금보존을 선택하였습니다. 해당 상품은 위험등급 보통위험(4등급) 이상으로 투자자보호를 위해 단기사채 가입이 제한됩니다.", "ME_CLOSE", "6")
	
			else
				DATAMANAGER.RequestTranData("obsac_deal_209a") '온라인 전단채 매수 신청 전, 가능 수량 조회
	
			end if		
		end if
	
		if g_MesuGO == "OK" then
			if g_ProsYN == "Y" then
				'고위험거래팝업				
				Form.OpenFramePopup("mbonl81010_p2" ,	g_szScrno  & "★" &  
												g_KYC_INVT_INCL_GRAD_CODE	& "★" & g_KYC_PROD_GRAD_CODE	& "★" &
												g_KYC_DVPD_EPMD_CODE 	& "★" & g_KYC_DRVT_PROS_YN	& "★" & g_DVPD_GRAD_CODE
								, sPosInfo)
			
			elseif g_ProsYN == "D" then '원금보존 투자자금 가입불가 상품
				' v002
				Form.MsgBox("원금보존 위험상품 안내" , "고객님은 금융투자자금 원금보존을 선택하였습니다. 해당 상품은 위험등급 보통위험(4등급) 이상으로 투자자보호를 위해 단기사채 가입이 제한됩니다.", "ME_CLOSE", "6")
	
			else
				DATAMANAGER.RequestTranData("obsac_deal_209a") '온라인 전단채 매수 신청 전, 가능 수량 조회
	
			end if		
		end if
		
	elseif szTranID == "obsac_deal_211r" then 
		g_RMNN_WNCR_AMT = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RMNN_WNCR_AMT" , 0)
		contInput.Table1.SetCellString(0, 1, g_RMNN_WNCR_AMT)	'잔여수량 재조회
		g_Reload = ""
	
	elseif szTranID == "obsap_deal_003r" then 
		g_INVT_ABLE_AMT = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock5", "INVT_ABLE_AMT" , 0)
		
		contInput.Table3.SetCellString(0, 2, g_INVT_ABLE_AMT)	'매수가능금액	재조회
		g_Reload_1 = ""
				
		'KEK STA. 사고여부체크
		gAcdnYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "ACDN_YN" , 0)
		If gAcdnYn = "Y" Then
			Form.MsgBox("알림", "사고계좌로 매수신청이 불가합니다.", "", 0)
			btnReg.enable = false
			Exit Sub
		Else
			btnReg.enable = true	'EK ADD
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'init에서 위치변경
			g_szFnprJoinSrno = Form.GetSharedData( "FNPR_JOIN_SRNO", false )
			DATAMANAGER.RequestTranData( "obcsb_acif_799r" ) '고객번호로 전문투자자여부 조회
		End If
		'KEK FIN.
	elseif szTranID == "obfnp_fnmt_994r" then 	
		g_DiscountedAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CODE_NAME", 0)	'할인된금액
		g_ExpectedAmt = CDBL(contInput.LblPrcin.caption) - CDBL(g_DiscountedAmt)	'예상이자 = 매매금액 - 할인금액
		
		if CDBL(g_DiscountedAmt) > CDBL(contInput.Table3.GetCellString(0, 2)) then
			contInput.LblPrcin.caption = ""
			contInput.TblResultprc.SetCellString(0, 2, 0)	'할인금액
			
			contInput.LblAlert.caption = "매수가능금액을 확인해주세요"
			btnReg.caption = "매수하기"
	
			contInput.ImgPrcreset.visible = false
			contInput.BtnPrcin.caption = "금액을 입력해주세요"
		else
			contInput.TblResultprc.SetCellString(0, 2, g_ExpectedAmt)	'할인금액
			contInput.TblResultprc.SetCellString(1, 2, FormatNumber(g_DiscountedAmt, 0))	'할인금액
			if CLng(g_DiscountedAmt) > 0 then
				btnReg.caption = FormatNumber(g_DiscountedAmt, 0) & "원 매수 신청"
			else
				btnReg.caption = "매수하기"
			end if 
		end if
	
	elseif szTranID == "obsac_deal_209a" then
		if g_Reload == "ok" then
			g_KYC_INVT_RCMD_CLS_CODE 	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0)
			
			contInput.Table1.SetCellString(0, 1, g_RMNN_WNCR_AMT)	
'			
'		else		
''			szParam = contInput.cmbAccount.total & "★" & contInput.cmbAccount.sequence & "★" & g_FILE_PATH_NAME
''			Form.openPopupAnimation("mbonl88060_p4", szParam, "", "2")	'약관동의팝업
'			
'			'투자주요내용 팝업 오픈
'			szParam = g_FILE_PATH_NAME
'			Form.OpenPopup("mbonl88060_p13" , szParam , "")
		end if
		
	elseif szTranID == "obcsb_acad_122a" then
		DATAMANAGER.RequestTranData( "obsac_deal_209a_1" )
		
	elseif szTranID == "obsac_deal_209a_1" then
		
		OM_ODER_SRNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "OM_ODER_SRNO", 0)		'OM_ODER_SRNO

		KOR_ISNM = g_KOR_ISNM	'종목명
		nDEAL_ERT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DEAL_ERT", 0)	'수익률
		nFCVL_AMT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FCVL_AMT", 0)	'액면금액
		nSTLM_AMT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STLM_AMT", 0)	'결제금액
		nINT_AMT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "INT_AMT", 0)	'이자
		nTAX_SMTN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "TAX_SMTN", 0)	'세금(후취)
		nEXCL_AMT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "EXCL_AMT", 0)	'만기 정산금액
		sPBLC_DATE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PBLC_DATE", 0)	'발행일
		sMTRT_DATE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MTRT_DATE", 0)	'만기일

		g_szSendData = contInput.cmbAccount.total & contInput.cmbAccount.sequence & "★" & KOR_ISNM & "★" & nDEAL_ERT & "★" & nFCVL_AMT & "★" & nSTLM_AMT 
					& "★" & nINT_AMT & "★" & nTAX_SMTN & "★" & nEXCL_AMT & "★" & sPBLC_DATE & "★" & sMTRT_DATE
					& "★" & g_SHTR_BOND_REG_CLS_CODE & "★" & g_PSNT_DATE
					
		' 완료팝업
		Form.OpenPopup("mbonl88060_p5" , g_szSendData , "")	
		
 	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szTranID == "obsac_deal_209a" or szTranID == "obsac_deal_209a_1" then
		if szErrCode == "1590" then
			Form.MsgBox("알림", "장외파생전용계좌는 매매가 불가합니다.", "", 0)
		elseif szErrCode == "5228" then
			Form.MsgBox("알림", "매수가능 수량이 부족합니다.\n잔여수량을 다시 확인해주세요.", "RELOAD", 0)
		'KEK STA. 주석 처리.메시지 추가
		'elseif szErrCode == "6660" then
		'	Form.MsgBox("알림", "매수 가능 시간은 15:00 까지 입니다.", "", 0)
		elseif szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
		'KEK FIN.
		
		elseif szErrCode == "0340" then
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
			
		elseif szErrCode == "7100" then
			Form.MsgBox("알림", "매수가능금액이 부족합니다.", "RELOAD_1", 0)
		'KEK 6629 영업일체크 추가
		elseif szErrCode == "6229" then
			Form.ShowAlert( "알림" , "주문은 영업일만 가능합니다.")			
			Exit Sub
			
		else
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
		end if
	else
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , szErrMsg)
		end if
	end if
End Sub

