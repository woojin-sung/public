' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	contInput.ImgPrcreset.visible = false
	contInput.BtnPrcin.caption = "금액을 입력해주세요"
	contInput.LblPrcin.caption = ""
	contInput.LblAlert.caption = ""
	contInput.TblResultprc.SetCellString(0, 2, 0)
	contInput.TblResultprc.SetCellString(1, 2, FormatNumber(0, 0))	'할인금액
	
	contInput.LblAlert.visible = 0
	
	btnReg.caption = "매수하기"
End Function

'============================================================================
Sub contInput_ImgPrcreset_OnClick()
	Init_InputControl()
End Sub

'============================================================================
' BtnPrcin_OnClick
'============================================================================
Sub contInput_BtnPrcin_OnClick()
	Dim szPrc, szData

	szPrc = ""
		
	contInput.BtnPrcin.caption = ""
	contInput.LblPrcin.caption = ""
	
	contInput.ImgPrcreset.visible = false
	
	Form.SetSharedData("OPEN_FILE_NAME", "mbonl88060_p2" )
	Form.openPopup("mbonl88060_p9", szPrc, "")	'mhtro16090_p1
	
End Sub

'============================================================================
Sub contInput_LblPrcin_OnClick()
	contInput.ImgPrcreset.visible = true
	if Trim(g_szPopPrc) <> "" then
		szPrc = CLng(g_szPopPrc)
	else
		szPrc = CLng(contInput.LblPrcin.caption)
	end if


	'EK ADD! 
	if szPrc > 0 and (szPrc > CDBL(g_RMNN_WNCR_AMT)) then
		contInput.LblAlert.caption = "잔여수량을 확인해주세요."
		btnReg.caption = "매수하기"
	
		contInput.TblResultprc.SetCellString(0, 2, 0)
		contInput.TblResultprc.SetCellString(1, 2, FormatNumber(0, 0))
		
		'20230223 LES START
		contInput.ImgPrcreset.visible = false
		contInput.BtnPrcin.caption = "금액을 입력해주세요"
		'20230223 LES END
		
		return false	
	'v001
'	elseif (szPrc > 0 and szPrc > 100000000) and (szPrc > CDBL(g_INVT_ABLE_AMT)) then
'		contInput.LblAlert.caption = "매수가능금액을 확인해주세요."
'		btnReg.caption = "매수하기"
'	
'		'20230223 LES START
'		contInput.ImgPrcreset.visible = false
'		contInput.BtnPrcin.caption = "금액을 입력해주세요"
'		'20230223 LES END
'		
'		return false	
	elseif szPrc > 0 and szPrc < 100000000 then
		'1억미만 입력한 경우
		contInput.LblAlert.caption = "최소주문금액을 확인해주세요."
		btnReg.caption = "매수하기"
		
		contInput.TblResultprc.SetCellString(0, 2, 0)
		contInput.TblResultprc.SetCellString(1, 2, FormatNumber(0, 0))
		
		'20230223 LES START
		contInput.ImgPrcreset.visible = false
		contInput.BtnPrcin.caption = "금액을 입력해주세요"
		'20230223 LES END
		
		return false
	elseif (szPrc > 100000000) and (szPrc mod 1000000) > 0 then
		'1억 초과 & 매매단위(1백만원) 조건 미부합인 경우
		contInput.LblAlert.caption = "1억이상 1백만원 단위로 주문 가능합니다."
		btnReg.caption = "매수하기"
		
		contInput.TblResultprc.SetCellString(0, 2, 0)
		contInput.TblResultprc.SetCellString(1, 2, FormatNumber(0, 0))
		
		'20230223 LES START
		contInput.ImgPrcreset.visible = false
		contInput.BtnPrcin.caption = "금액을 입력해주세요"
		'20230223 LES END
				
		return false
	'v001	
'	elseif (szPrc > 100000000) and (szPrc mod 1000000) == 0 and (szPrc > CDBL(g_INVT_ABLE_AMT)) then
'		'1억 초과 & 매매단위(1백만원) 조건 부합 & 매수가능금액 초과 입력한 경우
'		contInput.LblAlert.caption = "매수가능금액을 확인해주세요."
'		btnReg.caption = "매수하기"
'		
'		'20230223 LES START
'		contInput.ImgPrcreset.visible = false
'		contInput.BtnPrcin.caption = "금액을 입력해주세요"
'		'20230223 LES END
'				
'		return false
	else
		
		contInput.LblAlert.caption = ""
		if szPrc == 0 then
			contInput.LblPrcin.caption = ""
			contInput.BtnPrcin.caption = "금액을 입력해주세요"
			
			contInput.TblResultprc.SetCellString(0, 2, 0)
			contInput.TblResultprc.SetCellString(1, 2, FormatNumber(0, 0))
		else
			contInput.LblPrcin.caption = szPrc	
		end if
		
		if szPrc <> "" and szPrc <> null then
			DATAMANAGER.RequestTranData( "obfnp_fnmt_994r" )
		end if
		
	end if
End Sub

