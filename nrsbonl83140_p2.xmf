'20230907 KKM START 일반청약 메뉴의 화면들로 전환
'============================================================================
Sub lblTitle_OnClick()
	ImgMenu_OnClick()
End Sub

'============================================================================
Sub ImgMenu_OnClick()
	'ImgMenu.imgpath = "icon_arrow_up2.png"
	Combo0.currentindex = 1	
	Combo0.OpenList()	
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 0 then   '유상청약 신청/조회
		Form.CloseForm()
		Form.OpenScreen("83010" , "")
	else '반대의사/매수청구 신청
		ImgMenu.imgpath = "icon_arrow_down2.png"
	end if 	
End Sub

'============================================================================
Sub cont2_Edit0_OnClick()
	cont2.edtHintCaption0.visible = false
End Sub

'============================================================================
Sub cont2_Edit0_OnEditComplete()
	if cont2.Edit0.caption == "" or cont2.Edit0.caption == null then
		cont2.edtHintCaption0.visible = true
	end if
End Sub

