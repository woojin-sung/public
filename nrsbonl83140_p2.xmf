Sub cont2_Edit0_OnEditComplete()
'	g_szPreKeyPad = "Edit0"	
'	if g_OSType <> "1" and g_szPreKeyPad == g_szCurKeyPad then
'		cont1.lblScrollPos.top = 0
'		cont1.SetScrollAutoSize()
'		cont1.scroll_pos = 0
'	end if
	
	dim nAbleQty, nEdit0
	'nAbleQty = CDbl(cont0.Table0.GetCellString(3, 2))
	nAbleQty = CDbl(cont1.Label12.caption)
	nEdit0 = CDbl(cont2.Edit0.caption)	
	if nEdit0 > nAbleQty then
		Form.ShowAlert("알림", "현금 가능 수량보다 큽니다.")
		cont2.Edit0.caption = "0"
		Exit Sub
	end if
End Sub

'============================================================================
Sub cont2_Edit0_OnClick()
	IF g_OsType <> "1" THEN '안드로이드가 아닌경우에만
		g_szCurKeyPad = "Edit0"
		
'		cont1.lblScrollPos.top = 500
'		cont1.SetScrollAutoSize()
'		cont1.scroll_pos = 80

	END IF 
End Sub

'============================================================================
Sub btnReg_OnClick()
	if f_CheckBefore() then
		if g_sAsPw == "" then
			'Form.ShowAlert("알림", "계좌 비밀번호를 입력해 주세요.")
			'Form.OpenPopup("nrsbonl83140_p5", acnt0.total&"★"&acnt0.sequence, "")
			Form.openPopupAnimation("pwdcheckpopup", acnt0.total & acnt0.sequence & "☆0" ,"","2")
		else
'f_Proc() 'TEST
			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_bFlag == true then
		Form.SendReturnToParent( "REG_FIN" , "")
	end if
End Sub

