	<SCRIPT_INFO _len="3154" _ulen="2822" >

Dim g_tOpenData
g_tOpenData = ""
'============================================================================
Sub Form_OnFormInit()
	
	if Form.GetOpenLinkData( ) <> "" then
		Dim szData
		szData = Form.GetOpenLinkData( )
		
		'20230828 아이디 연결여부 추가
		g_szLinkedYN = Form.GetSharedData("71052_ID_LNKN_YN", false)
		
		'종목명/평가금액/매입금액/평가손익/수익률/잔고구분/잔고수량/매입단가/신용,대출금/신용,대출일(질권일)/만기일/종목코드
		g_tOpenData = Split(szData, "★")
		
		tbl0.SetCellString(0, 0, g_tOpenData(0))
		tbl0.SetCellString(1, 1, g_tOpenData(1))
		tbl0.SetCellString(2, 1, g_tOpenData(2))
		tbl0.SetCellString(3, 1, g_tOpenData(3))
		tbl0.SetCellString(4, 1, g_tOpenData(4))
		
		tbl0.SetCellString(7, 1, g_tOpenData(5))
		tbl0.SetCellString(8, 1, g_tOpenData(6))
		tbl0.SetCellString(9, 1, g_tOpenData(7))
		
		if g_tOpenData(8) == "" or CInt(g_tOpenData(8)) == 0 then
			tbl0.SetCellString(12, 1, "-")
			tbl0.SetCellString(13, 1, "-")
			tbl0.SetCellString(14, 1, "-")
		else
			tbl0.SetCellString(12, 1, FormatNumber(g_tOpenData(8),0).."원")
			tbl0.SetCellString(13, 1, left(g_tOpenData(9),4).."."..mid(g_tOpenData(9),5,2).."."..right(g_tOpenData(9),2))
			tbl0.SetCellString(14, 1, left(g_tOpenData(10),4).."."..mid(g_tOpenData(10),5,2).."."..right(g_tOpenData(10),2))
		end if
		
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnHyun_OnClick()
	Form.SendReturnToParent( "mbtrs12000_po" , "11000☆"..g_tOpenData(11) )
	Form.CloseForm()
End Sub

'============================================================================
Sub btnChart_OnClick()
	Form.SendReturnToParent( "mbtrs12000_po" , "13000☆"..g_tOpenData(11)  )
	Form.CloseForm()
End Sub

'============================================================================
Sub btnBuy_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	Form.SendReturnToParent( "mbtrs12000_po" , "12000☆기타★0★"..g_tOpenData(11)  )
	Form.CloseForm()
End Sub

'============================================================================
Sub btnSell_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	Form.SendReturnToParent( "mbtrs12000_po" , "12000☆기타★1★"..g_tOpenData(11)  )
	Form.CloseForm()
End Sub

