<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="57020" scrname="Wrap상품 및 가입_Wrap상품검색" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="lblTitle" fontsize="3" caption="Wrap 상품 검색" halign="1" ly_vert="10,0,355,40,1" />
		<IMAGE name="ImgBack" autosize="1" imgpath="icon_top_back_light" ly_vert="15,10,15,20,1" />
		<BUTTON name="btnBack" btnimage="alpha" ly_vert="0,0,40,40,1" />
		<IMAGE name="imgClose" imgpath="ic_close.png" ly_vert="342,9,21,21,1" />
		<IMAGE name="imgSearchBg" imgpath="img_bgbox.9.png" ly_vert="10,45,355,34,1" />
		<IMAGE name="imgSearchIcon" imgpath="icon_main_06.png" ly_vert="16,48,28,28,1" />
		<EDIT name="edtSearch" fonttype="1" imetype="0" hintcaption="상품명을 입력해주세요." imagefilepth="alpha" ly_vert="42,45,322,34,1" />
		<GRID name="grdData" colcount="2" ly_vert="10,84,355,553,1" ver="1" >
			<CONTROL_INFO>
				<LABEL name="name" autofontsize="1" />
				<LABEL name="code" halign="2" />
			</CONTROL_INFO>
			<DEFAULTINFO useblockclr="0" usetopheader="0" initrowcount="0" border="0000" inlinecolor="025:255255255" />
			<COLINFO ly_vert_width="355,70" ly_vert_visible="0,2" >
				<COLUMN colcount="1" >
					<SUBCOLINFO ly_vert_width="355" ly_vert_visible="0" />
					<BODY rowcount="1" impblkcnt="1" >
						<ROWINFO ly_vert_height="40" />
						<CELLINFO>
							<CELL name="name" cell_ly="0,0,0,0" line="0,1" import="0,1,1" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
				<COLUMN colcount="1" >
					<SUBCOLINFO ly_vert_width="70" ly_vert_visible="2" />
					<BODY rowcount="1" impblkcnt="1" >
						<ROWINFO ly_vert_height="40" />
						<CELLINFO>
							<CELL name="code" cell_ly="0,0,0,0" line="0,1" import="0,1,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
			</COLINFO>
			<UPDATETR_INFO/>
			<UPDATEBC_INFO keycellid="name" rangecellid="name" hlcolorcellid="name" />
		</GRID>
		<LABEL name="lblNoData" visible="0" fgcolor="146:124124124" fontsize="2" caption="상품이 존재하지 않습니다." halign="1" ly_vert="54,249,268,59,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2671" _ulen="2615" >

Dim g_sAcnt

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBack.setMaintainingRatio("1")
'	imgSearchBg.setMaintainingRatio("1")
	imgSearchIcon.setMaintainingRatio("1")
End Sub

' 뒤로가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.OpenScreen("57020", "")
End Sub

'============================================================================
Sub Form_OnFormInit()
	edtSearch.SetOnOffImage("alpha", "alpha")
	g_sAcnt = Form.GetOpenLinkData()
End Sub

'============================================================================
Sub imgSearch_OnClick()
	edtSearch.SetShowKeypad(true)
End Sub

'============================================================================
Sub edtSearch_OnEditChar(CharCode)
	lblNoData.visible = false
	grdData.SetClear()
	DATAMANAGER.RequestTranData("obwat_csad_023r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_csad_023r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WA_PRNM", 0, edtSearch.caption) '랩어카운트상품코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NRML_YN", 0 , "Y") '정상여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_sAcnt) '계좌번호
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_csad_023r" then
		Dim nCount
		nCount = tonumber(grdData.rowcount)
		
		lblNoData.visible = false
		
		if nCount == 0 then
			lblNoData.visible = true
		end if
	end if
End Sub

' 상품명 선택
'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	Dim sCode
	sCode = grdData.GetCellData("code", lRow)
	
	Form.SendReturnToParent("FullCode" , sCode)
	Form.CloseForm()
End Sub

'============================================================================
Sub grdData_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obwat_csad_023r" ) then
		DATAMANAGER.RequestNextData( "obwat_csad_023r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
