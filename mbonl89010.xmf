					<ROW_INFO ly_vert_height="29,5,20,20,20,20,20,20,20,20,20,20,20,20,20,5,29,5,20,20,20,20,20,20,20,20,5,29,5,20,20,20,20,20,20,20,20,20,20,20,20,20,20,5" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="061:239059036" line="0,1" caption=" ▶" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="061:239059036" halign="0" line="0,1" caption="고객 유의사항" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,1,0,1" line="0,0" impidxs="" />
						<CELL cell_ly="1,1,1,1" line="0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" line="0,0" caption=" 1." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="반드시 공인된 앱스토어 및 마켓을 통해 메리츠증권" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="'메리츠 SMART' 어플리케이션을 다운로드하시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" caption=" 2." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="메리츠증권 '메리츠 SMART' 프로그램은 고객님의 정보" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,5,0,5" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="유출 방지를 위해 공인인증서를 기반으로 운용됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,6,0,6" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="공인인증서는 '메리츠 SMART'에서 발급 가능하며, 홈페이지" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,7,0,7" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="에서 발급받은 공인인증서는 PC에서 복사하여 사용하" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,8,0,8" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,9,0,9" line="0,0" caption=" 3." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="만약, 스마트폰 분실 시에는 기존에 사용하시던 공인인" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,10,0,10" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="증서를 폐기하시고 재발급받아서 사용하실 것을 권장합" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,11,0,11" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,12,0,12" line="0,0" caption=" 4." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="스마트폰 증권거래 서비스 이용요금은 당사에서 별도로" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,13,0,13" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,13,1,13" halign="0" line="0,0" caption="부과하지 않습니다. 무선 인터넷 사용에 따른 통신요금은" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,14,0,14" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="가입하신 이동 통신사에 문의하시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,15,0,15" line="0,1" impidxs="" />
						<CELL cell_ly="1,15,1,15" line="0,1" impidxs="" />
						<CELL cell_ly="0,16,0,16" fgcolor="061:239059036" line="0,1" caption=" ▶" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,16,1,16" fgcolor="061:239059036" halign="0" line="0,1" caption="개인정보 유출 예방" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,17,0,17" line="0,0" impidxs="" />
						<CELL cell_ly="1,17,1,17" line="0,0" impidxs="" />
						<CELL cell_ly="0,18,0,18" line="0,0" caption=" 1." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="스마트폰 전자금융거래에 사용하는 각종 비밀번호(계좌" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,19,0,19" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,19,1,19" halign="0" line="0,0" caption="비밀번호, 접속비밀번호, 공인인증서 비밀번호 등)가 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,20,0,20" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,20,1,20" halign="0" line="0,0" caption="타인에게 노출되지 않도록 종이나 PC, 모바일 단말기 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,21,0,21" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="내에 남기지말고 가급적 암기하여 사용하시고, " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,22,0,22" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,22,1,22" halign="0" line="0,0" caption="정기적으로 변경해주시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,23,0,23" line="0,0" caption=" 2." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="시스템 접속상태에서 모바일 단말기를 타인과 공유하는" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,24,0,24" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="것은 위험하며, 타인과 공유시 반드시 로그아웃하시기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,25,0,25" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,25,1,25" halign="0" line="0,0" caption="바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,26,0,26" line="0,1" impidxs="" />
						<CELL cell_ly="1,26,1,26" line="0,1" impidxs="" />
						<CELL cell_ly="0,27,0,27" fgcolor="061:239059036" line="0,1" caption=" ▶" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,27,1,27" fgcolor="061:239059036" halign="0" line="0,1" caption="스마트폰 10대 안전수칙" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,28,0,28" line="0,0" impidxs="" />
						<CELL cell_ly="1,28,1,28" line="0,0" impidxs="" />
						<CELL cell_ly="0,29,0,29" line="0,0" caption=" 1." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="의심스러운 애플리케이션 다운로드 하지 않기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,30,0,30" line="0,0" caption=" 2." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,30,1,30" halign="0" line="0,0" caption="신뢰할 수 없는 사이트 방문하지 않기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,31,0,31" line="0,0" caption=" 3." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,31,1,31" halign="0" line="0,0" caption="발신인이 불명확하거나 의심스러운 메시지 및 메일 삭제" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,32,0,32" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,32,1,32" halign="0" line="0,0" caption="하기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,33,0,33" line="0,0" caption=" 4." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,33,1,33" halign="0" line="0,0" caption="비밀번호 설정기능을 이용하고 정기적으로 비밀번호 변" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,34,0,34" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,34,1,34" halign="0" line="0,0" caption="경하기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,35,0,35" line="0,0" caption=" 5." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,35,1,35" halign="0" line="0,0" caption="블루투스 기능 등 무선 인터페이스는 사용시에만 켜놓기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,36,0,36" line="0,0" caption=" 6." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,36,1,36" halign="0" line="0,0" caption="이상증상이 지속될 경우 악성코드 감염여부 확인하기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,37,0,37" line="0,0" caption=" 7." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,37,1,37" halign="0" line="0,0" caption="다운로드한 파일은 바이러스유무를 검사한 후 사용하기" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,38,0,38" line="0,0" caption=" 8." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,38,1,38" halign="0" line="0,0" caption="PC에서도 백신프로그램을 설치하고 정기적으로 바이러" fontsize="-2" impidxs="" />
