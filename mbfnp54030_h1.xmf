'============================================================================
' 01. 화 면 명 : 채권주문체결
' 02. 화면설명 : 채권주문체결
' 03. 작    성 : 2016.1.14 하원만
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	btnSearch_OnClick()

	DATAMANAGER.RequestTranData("obtrs_cntg_660r")

End Sub

'============================================================================
'출력 Data 초기화
Sub Output_Data_Clear()
	
    '그리드 초기화
	grdList.ClearAllData( )
	grdList.DeleteAllRow( )

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obtrs_cntg_660r" then

		g_nAcNo = cmbAcnt.total    'Left( cmbAccount.caption, 8)
		g_nAsNo = cmbAcnt.sequence 'Right( cmbAccount.caption, 2)

		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ASNO", 0 , g_nAsNo)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "CNTG_CLS_CODE", 0 , rboCntg.currentindex)  '0:전체, 1:채결, 2:미채결
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ODER_TYPE_CLS_CODE", 0 , "08") '주문유형코드구분

	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obtrs_cntg_660r" Then

		Dim iCnt, iDataCount, strFullNM, strTrade_Gubun, strMC_Gubun, strTrade_Gubun_nm, strMC_Gubun_nm
		Dim sCode, sName, OderRfusReasCode
		iDataCount = DATAMANAGER.GetDataCount( 0, "obtrs_cntg_660r" , "OutBlock1" )
		
		For iCnt = 0 To iDataCount - 1

			OderRfusReasCode = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "ODER_RFUS_REAS_CODE", iCnt ) '주문거부사유코드
			sCode            = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "BOND_MKPL_CLS_CODE", iCnt ) '채권매매시장구분코드
			strTrade_Gubun   = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "DEAL_CLS_CODE", iCnt )
			strMC_Gubun      = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "RCTF_CNCL_CLS_CODE", iCnt )

			strTrade_Gubun_nm = fn_CodeToName( "Trade", strTrade_Gubun )
			strMC_Gubun_nm    = fn_CodeToName( "MC", strMC_Gubun )

			if tostring(strMC_Gubun) == "1" then
			    strFullNM = strTrade_Gubun_nm
			else
			    strFullNM = strTrade_Gubun_nm&strMC_Gubun_nm
			end if

		    '매매구분
		    grdList.SetCellData( "bd_cell4", ( (grdList.rowcount - iDataCount) + iCnt), strFullNM )
		    
		    '채권매매시장구분코드
		    sName = Form.GetMetaData( "채권매매시장구분코드", sCode )
		    grdList.SetCellData( "bd_cell8", ( (grdList.rowcount - iDataCount) + iCnt), sName )
	    
		    if Trim(OderRfusReasCode) == "0000" or Trim(OderRfusReasCode) == "" then
			    grdList.SetCellData( "bd_cell9", ( (grdList.rowcount - iDataCount) + iCnt), "정상" )
		    else
			    grdList.SetCellData( "bd_cell9", ( (grdList.rowcount - iDataCount) + iCnt), "거부" )
		    end if
		    
		     '매도
		    if strTrade_Gubun == "1" then
			    grdList.SetCellFgColor("bd_cell4", ( (grdList.rowcount - iDataCount) + iCnt), "11")
		    '매수
		    else
			    grdList.SetCellFgColor("bd_cell4", ( (grdList.rowcount - iDataCount) + iCnt), "10")
		    end if
		    
	    next
    End If
End Sub
'============================================================================


'============================================================================
Sub btnSearch_OnClick()

	Call Output_Data_Clear()
	
	DATAMANAGER.RequestTranData("obtrs_cntg_660r")

End Sub

Function fn_CodeToName(szTitle, szCode)
 Select Case szTitle
  Case "Trade"
   Select Case szCode
    Case "1" return "매도"
    Case "2" return "매수"
    Case "3" return "매수청산"
    Case "4" return "매도청산"
    Case "5" return "권리행사"
    Case "6" return "의무배정"
    Case "7" return "행사포기"
    Case "8" return "의무면제"
    Case "A" return "인수대금"
    Case "B" return "인도대금"
    Case "C" return "단주행사"
    Case "D" return "단주배정"
    Case "0" return "상계"
   end Select 
  
  Case "MC"
   Select Case szCode
    Case "1" return "정상"
    Case "2" return "정정"
    Case "3" return "취소"
   end Select
end Select
End Function

'============================================================================
Sub cmbAcnt_ChangeAccount()
	
	btnSearch_OnClick()
	
End Sub

'============================================================================
' btnClose_OnClick()
'============================================================================
Sub btnClose_OnClick()
	
	Form.CloseForm()
	
End Sub

'============================================================================
' img0_OnClick()
'============================================================================
Sub img0_OnClick()
	
	Form.CloseForm()
	
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	
	Form.SendReturnToParent( "mbfnp54030_h1" , cmbAcnt.caption)

End Sub

'============================================================================
Sub rboCntg_OnClick(nIndex)
	
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	
	DATAMANAGER.RequestNextData( "obtrs_cntg_660r" )
	
End Sub


'============================================================================
Sub Form_OnRefresh()
	
	btnSearch_OnClick()
	
End Sub

