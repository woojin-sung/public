	<SCRIPT_INFO _len="4068" _ulen="4042" >
'--===========================================================================
'--===========================================================================

Dim g_szACNO
Dim g_szASNO

'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "obtrd_cntg_122r" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" then
		if sParam <> "" and sParam <> null then
			Dim szSplitData
			szSplitData = Split(sParam, "★")
			g_szACNO = szSplitData[0]
			g_szASNO = szSplitData[1]
			
			DATAMANAGER.RequestTranData( "obtrd_cntg_122r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_cntg_122r" then
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_122r", "InBlock1", "BSOP_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ) )
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_122r", "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_122r", "InBlock1", "ASNO" , 0 , g_szASNO )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_cntg_122r" then
		Dim szClrnDeal, szIntoDeal, szCRCD, szFUTS_CLRN_PRLS_FAMT, szFTRS_CLRN_PRLS_FAMT, szENTM_FFEE, szNTPL_FAMT, szCLRN_PRLS_FAMT
		Dim nCnt, nIndex
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtrd_cntg_122r", "OutBlock1")
		nIndex = tonumber(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1 
			szIntoDeal = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)
			szClrnDeal = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "DEAL_CLS_NAME" , i)
			szFUTS_CLRN_PRLS_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "FUTS_CLRN_PRLS_FAMT" , i)
			szFTRS_CLRN_PRLS_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "FTRS_CLRN_PRLS_FAMT" , i)
			szENTM_FFEE = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "ENTM_FFEE" , i)
			szNTPL_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "UI_NTPL_FAMT" , i)
			szCRCD = DATAMANAGER.GetDataValue( false, "obtrd_cntg_122r", "OutBlock1", "CRCD" , i)
			
			szCLRN_PRLS_FAMT = szFUTS_CLRN_PRLS_FAMT + szFTRS_CLRN_PRLS_FAMT
			
			if szIntoDeal = "매수" then
				grdList.SetCellFgColor("bd_cell8", nIndex+i, "1")
			elseif szIntoDeal = "매도" then
				grdList.SetCellFgColor("bd_cell8", nIndex+i, "2")
			end if
			
			if szClrnDeal = "매수" then
				grdList.SetCellFgColor("bd_cell1", nIndex+i, "1")
			elseif szClrnDeal = "매도" then
				grdList.SetCellFgColor("bd_cell1", nIndex+i, "2")
			end if
			
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT,0))
				grdList.SetCellData("bd_cell10", nIndex+i, FormatNumber(szENTM_FFEE,0))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szNTPL_FAMT,0))
			else
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 2))
				grdList.SetCellData("bd_cell10", nIndex+i, FormatNumber(szENTM_FFEE, 2))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szNTPL_FAMT, 2))
			end if
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
'	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		
'	if Trim(szSubMsg) <> "" then
'		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
'	else
'		Form.ShowAlert("알림", szErrMsg)
'	end if
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtrd_cntg_122r") = true then
		DATAMANAGER.RequestNextData( "obtrd_cntg_122r" )
	end if
End Sub

