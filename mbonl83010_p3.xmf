''-------------------------------------------------------------------------------------------
'' 01. 화 면 명 : 유상청약 신청완료
'' 02. 화면설명 : 유상청약 신청완료
'' 03. 작    성 : 2022.09.27 신극수
'' 04. 수    정 :  
'' 2021.10.26 : v0001 : 김수진 : 해외 CFD/ 중개형ISA 추가
''-------------------------------------------------------------------------------------------
Dim g_szRsevYn
Dim g_szSbsc_qty
dim g_szExcsSbsc_qty
Dim closeFlag
''============================================================================
Sub USER_Notice()
	If g_szRsevYn = "Y" Then '예약청약여부
'		aFlag = "down"
'		ContNotiTitle.ImgArrow.imgpath = "icon_caret_up.png"
'
'		ContNotiBody.setHeightResize(450) 
		Label0.caption = "유상청약 예약신청이"..CHR(13)..CHR(10).."완료 되었습니다."
		Label2.visible = true
'		'2021.04.13. 김유경 숫자->변수 변경
''		lblScrollPos.top = 950
''		SetScrollAutoSize()
''		scroll_pos = 950 'CInt(Form.calcUnResize(Table0.top, "1"))
'		lblScrollPos.top = g_FrstPos + 480
'		SetScrollAutoSize()
'		scroll_pos = g_FrstTop + 450 - nDelHeight '950 'CInt(Form.calcUnResize(Table0.top, "1"))
'		
	Else	
		Label0.caption = "유상청약 완료 되었습니다."
		Label2.visible = false
'		aFlag = "up"
'		ContNotiTitle.ImgArrow.imgpath = "icon_caret_down.png"
'
'		ContNotiBody.setHeightResize(0) 
'		ContNotiBody.visible = False
'		
'		'2021.04.13. 김유경 숫자->변수 변경
''		lblScrollPos.top = 548
''		SetScrollAutoSize()		
''		scroll_pos = 0 
'		lblScrollPos.top = g_FrstPos + 20
'		SetScrollAutoSize()		
'		scroll_pos = g_FrstTop
	End If

End sub
'============================================================================
Sub Form_OnFormInitBefore()
	Image0.SetMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	BtnNext.fgcolor = 269
	Label2.fgcolor = 67
	
	g_szBIZDATE = Form.GetSharedData("&HOST_DATE", 0)
	g_szData = Form.GetOpenLinkData()
	'Form.ShowAlert("", szOpenData)
	
	'g_szList(0) :계좌번호★
	'g_szList(1) :계좌일련번호★
	'g_szList(2) :권리구분코드★
	'g_szList(3) :종목명★ 0
	
	'g_szList(4) :청약단가★ 1
	'g_szList(5) :청약가능금액★ 2
	'g_szList(6) :본배정수량★ 3
	
	'g_szList(7) :초과배정수량★ 4
	'g_szList(8) :문서명★5
	'g_szList(9) :종목코드★6
	
	'g_szList(10):권리기준일자★7
	'g_szList(11):총배정수량★8
	'g_szList(12):배정금액★ 9
	
	'g_szList(13):초과배정수량★ 10
	'g_szList(14):초과배정금액★ 11
	'g_szList(15):투자설명서★ 12
	
	'g_szList(16):총청약금액★ 16
	'g_szList(17):신청구분★
	
	'g_szList(18):청약수량★
	'g_szList(19):청약금액★
	'g_szList(20):초과청약수량★
	'g_szList(21):초과청약금액★
	
	g_szList = Split(g_szData, "★")
		
	if UBound(g_szList) > 1 then
		'Form.ShowAlert("", g_szList(18))
		g_szRsevYn 		= g_szList(17) '예약청약여부
		g_szSbsc_qty		= g_szList(18) '기본청약수량
		g_szExcsSbsc_qty	= g_szList(20) '초과청약수량
		if g_szSbsc_qty = "" then
			g_szSbsc_qty = 0
		end if 
		if g_szExcsSbsc_qty = "" then
			g_szExcsSbsc_qty = 0
		end if 
		call USER_Notice()
		call set_data()
	end if
End Sub


'============================================================================
Sub set_data()
	Table0.SetCellString(1, 3, left(g_szList(0),4).."-"..right(g_szList(0),4).."-"..g_szList(1)) '신청계좌
	Table0.SetCellString(2, 3, g_szList(3)) '청약종목
	Table0.SetCellString(3, 3, g_szSbsc_qty) '기본청약수량
	Table0.SetCellString(4, 3, g_szExcsSbsc_qty) '초과청약수량
	Table0.SetCellString(5, 3, g_szSbsc_qty + g_szExcsSbsc_qty) '총청약수량
	
End Sub
'============================================================================
Sub BtnNext_OnClick()
'	Form.OpenNextPopup("mbbdm85183", "", "" ) '진행상태확인
	Form.SetSharedData("ACNO_83010", g_szList(0)..g_szList(1))
	Form.OpenScreen( "83010" , "1")
	Form.CloseForm()		
End Sub
'
''============================================================================
Sub BtnNext0_OnClick()
	closeFlag = 2
	Form.CloseForm()
End Sub
'
'
''============================================================================
Sub Form_OnFormClose()
	If closeFlag == 2 Then
		'Form.OpenScreen( "41000" , "")
		Form.SetSharedData("ACNO_83010", g_szList(0)..g_szList(1))
		Form.OpenScreen( "83010" , "")
	End If
End Sub 
