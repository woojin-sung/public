Dim g_szCode, g_szName, g_szMarket, g_szGubun
Dim g_tCode
Dim g_szCloud
Dim g_szReturn
g_tCode = {}
Dim g_szUserId
Dim g_szTitle
g_szTitle = "알림"
Dim g_szTB
g_szTB = "T"
Dim g_szCodeList
'============================================================================
Sub Form_OnFormInit()
	Container0.setSearchMode(true)
	Container0.setSearchType("31")
	
	lblCombo.setmaxlinecount(2)
	
	g_szCodeList = ""
	g_szUserId =  Form.GetSharedData("&USER_ID", false)	' USER ID	
	
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	
	'20230731 KKM START 종목추가 위치
	if Form.GetEnvData("GW_POSITION")	== "" then
		g_szTB = "T"
	else
		g_szTB = Form.GetEnvData("GW_POSITION")
	end if
	'20230731 KKM END 
	
	' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는 다.
'	DATAMANAGER.RequestTranData("ohhts_intr_006r")
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup()
		Insert_cmbGroup()		
	end if
'	Container0.setIntrItems("138040^105190")
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH_DLG_RETURN" then
		Dim nRow
		
		g_szCode = sReturn1
		g_szName = Form.GetItemCodeInfo(g_szCode, "name")
		if Trim(g_szCode) <> "" then
			nRow = Cint(grdList.rowcount)
			
			if nRow > 99 then
				Form.MsgBox(g_szTitle, "종목 추가는 최대 100개 까지만\n가능합니다.", 1)
				Container0.setIntrItems(g_szCodeList)
				Exit Sub
			end if
		'0818 JJH 해외와 국내 중복되는 종목코드로인한 이슈 해결 START ----------------------------
			Dim  nMkLen, tCode
				
			if CInt(Instr(g_szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
				tCode = Split(g_szCode, "@")
				if UBOUND(tCode) < 1 then
					Exit Sub
				End if
				g_szMarket  = tCode[0]
	'			
				if Trim(g_szMarket) == "" then
					Exit Sub
				else
					nMkLen = Form.getLen(g_szMarket)
					if nMkLen == 2 then
						g_szGubun = "OV" '해외주식(마켓구분 2자리)
					else
						g_szGubun = "KR"
					end if
				end if
			else
				g_szGubun = "KR"
			end if 
		
			if g_szGubun = "KR" then
				g_szMarket   = Form.GetItemCodeInfo(g_szCode, "market")
				g_szMarket   = Change_EtcMarket(g_szMarket)	
			elseif g_szGubun = "OV" then
				g_szMarket   = g_szMarket		'tCode[0] 그대로 사용
			end if
			
			For i = 0 to nRow - 1	
				Dim szCode, szNm, szTemp, szMk, szNation
				
				szCode = Trim(grdList.GetCellData("bd_code", i))						
				szMk = Trim(grdList.GetCellData("bd_mk", i))
				szNm = Trim(grdList.GetCellData("bd_name", i))
				szNation = Trim(grdList.GetCellData("bd_nation", i))
				szTemp = szMk&"@"&szCode
				
				if g_szGubun == szNation then
					if g_szGubun == "KR" and g_szCode == szCode then
						Form.OpenPopup( "mhprc11010_p17" , "" , "" )
						Exit Sub
					elseif g_szGubun == "OV" and g_szCode == szTemp then
						Form.OpenPopup( "mhprc11010_p17" , "" , "" )
						Exit Sub
					end if
				end if
				
'				if g_szCode == szCode or g_szCode == szTemp then
'					Form.OpenPopup( "mhprc11010_p17" , "" , "" )
'					Exit Sub
'				end if
		'0818 JJH 해외와 국내 중복되는 종목코드로인한 이슈 해결 END ----------------------------
			Next
			
			if g_szCloud == "1" then		' Server 저장시
				DATAMANAGER.RequestTranData("ohhts_intr_102r")
			else
				if g_szCodeList == "" then 
					g_szCodeList = g_szCode
				else
					g_szCodeList = g_szCodeList & "^" & g_szCode
				end if
				Container0.setIntrItems(g_szCodeList)
				
				Form.Toast(2, "관심종목이 추가되었습니다.", 0)
				Add_Item(0)
				Save_GWList()
				
			end if 
		end if
		
		g_szReturn = "0"
	end if
End Sub

'============================================================================
Function Add_Item(nGbn)
	Dim szMk, nMkLen, szGubun
	
	grdList.insertrow = 0
	if g_szGubun ==  "OV" then
		tCode = Split(g_szCode, "@")
		
		grdList.SetCellData("bd_code", grdList.insertrow, tCode[1])
	else
		grdList.SetCellData("bd_code", grdList.insertrow, g_szCode)
	end if
	grdList.SetCellData("bd_mk",   grdList.insertrow, g_szMarket)
	grdList.SetCellData("bd_name", grdList.insertrow, g_szName)		' 20160325 위젯위해 종목명 추가
	grdList.SetCellData("bd_nation", grdList.insertrow, g_szGubun)		' 20160325 위젯위해 종목명 추가

End Function


'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
Sub tblEdit_OnClick(lRow , lColumn)
	if lColumn == 0 then
		Form.OpenFramePopup("mhprc11010_p12" , "" , "")
	elseif lColumn == 1 then
		Form.OpenFramePopup("mhprc11010_p13" , "" , "")
	end if
End Sub

'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = 0
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")
	
	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)
			
			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if		
		Next

	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------
	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList
	' 관심그룹콤보에서 최종 저장된 그룹 선택
	cmbGroup.currentindex = nSelect		
End Function

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, g_szUserId)	' USER ID
		' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_007r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",			0, g_szUserId)	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID",	0, cmbGroup.cbkeydata)	
		
	elseif szTranID == "ohhts_intr_102r" then  
		DATAMANAGER.ClearInputData(0, "ohhts_intr_102r")
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_USER_ID",     0, g_szUserId)	' USER ID
'		' FID버전ID
		if g_szCloud == "1" then		' Server 저장시
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		else
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_VRSN_ID",     0, Form.GetSharedData("VRSN_ID", false))	
		end if

		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CODE_CLS_CODE", 0, "1")		' 종목


		Dim  nMkLen, tCode, szCode

		nMkLen = 0
		
'		grdList.insertrow = 0
		
'	'	//20230711 HSZ START 
	'0818 JJH ohhts_intr_102r 호출이전에 정의 완료했기에 주석처리
'		'szGubun 세팅(OV: 해외주식, KR: 그 외)
'		if CInt(Instr(g_szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
'			tCode = Split(g_szCode, "@")
'			if UBOUND(tCode) < 1 then
'				Exit Sub
'			End if
'			g_szMarket  = tCode[0]
''			
'			if Trim(g_szMarket) == "" then
'				Exit Sub
'			else
'				nMkLen = Form.getLen(g_szMarket)
'				if nMkLen == 2 then
'					g_szGubun = "OV" '해외주식(마켓구분 2자리)
'				else
'					g_szGubun = "KR"
'				end if
'			end if
'		else
'			g_szGubun = "KR"
'		end if 
'		
'		'szMk 세팅
'		if g_szGubun = "KR" then
'			g_szMarket   = Form.GetItemCodeInfo(g_szCode, "market")
'			g_szMarket   = Change_EtcMarket(g_szMarket)	
'		elseif g_szGubun = "OV" then
'			g_szMarket   = g_szMarket		'tCode[0] 그대로 사용
'		end if
'	'	//20230711 HSZ END
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", 0, g_szMarket)	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0, g_szCode)
		
		if g_szGubun == "OV" then
			Dim tCode
			tCode = Split(g_szCode, "@")	
			'tCode(0) = 종목코드
			'tCode(1) = 종목마켓
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", 0, tCode(0))	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0, tCode(1))
		else
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", 0,  g_szMarket)	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0, g_szCode)
		end if

		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CNCN_GRP_NTNL_CLS_CODE", 0, g_szGubun)

		' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock3", "FID_CNCN_ISSU_NEW_GRP_ID", 0, cmbGroup.cbkeydata)	
	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock4", "FID_CLS", 0, g_szTB)
		'g_szTB = "T"
	end if
end Sub
'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_007r" then
		Dim nCnt
		Dim szCode
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_007r", "OutBlock1")
		
		For i = 0 to nCnt-1
			szCode = Trim(DATAMANAGER.GetDataValue(0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD", i))
			if szCode == "EMPTY" then
				DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD", i, "빈칸")
			end if
		Next
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
	
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
'		' 관심종목 종목 조회
'		DATAMANAGER.RequestTranData("ohhts_intr_007r")	'Insert_cmbGroup()에 들어가면 얘도 알아서 탐
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		Dim  nCnt
		g_szCode = ""
		szCodeList = ""
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )	
		
		For i = 0 to nCnt - 1
			dim szCode
			
			szMk   = grdList.GetCellData("bd_mk",   i)
			szCode = grdList.GetCellData("bd_code", i)
			
			if szCode <> "빈칸" then 
				
				if grdList.GetCellData("bd_nation", i) == "OV" then
					szCode =  szMk & "@" & szCode
'				else
'					if nMkLen == 2 then
'						szCode =  szMk & "@" & szCode
'					end if 
				end if
				
				if g_szCodeList == "" then 
					g_szCodeList = szCode
				else
					g_szCodeList = g_szCodeList & "^" & szCode
				end if
			end if
		Next
		
		Container0.setIntrItems(g_szCodeList)
		
		Dim szMk, szCode, szMemo
			
		For i = 0 to grdList.rowcount - 1
			szMk   = grdList.GetCellData("bd_mk",   i)
			szCode = grdList.GetCellData("bd_code", i)
			szNation = grdList.GetCellData("bd_nation", i)
			
			if szCode == "빈칸" then
				' 빈칸 색상 적용 (색상은 임시색상)
				szMemo = grdList.GetCellData("bd_memo", i)
				grdList.SetCellData("bd_name", i, szMemo)
			else
'				 종목명 가져오는 함수
				if grdList.GetCellData("bd_nation", i) == "OV" then
					szName = Form.GetItemCodeInfo( szMk & "@" & szCode, "name")
				else
					szName = Form.GetItemCodeInfo(szCode, "name")
				end if
				
				grdList.SetCellData("bd_name", i, szName)
			end if
		Next
	
	elseif szTranID == "ohhts_intr_102r" then  
		Form.Toast(2, "관심종목이 추가되었습니다.", 0)
		Add_Item(0)
		Save_GWList()
		
		if g_szCodeList == "" then 
			g_szCodeList = g_szCode
		else
			g_szCodeList = g_szCodeList & "^" & g_szCode
		end if
		Container0.setIntrItems(g_szCodeList)
		
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) 
		
	end if
	
end Sub
'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick()

	if Int(cmbGroup.currentindex) == 0 then
		cmbGroup.currentindex = cmbGroup.rowcount-1
	else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	end if
End Sub

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick()
	if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
		cmbGroup.currentindex = 0
	else
		cmbGroup.currentindex = cmbGroup.currentindex + 1
	end if

	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub

'============================================================================
' cmbGroup_OnEditComplete
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	g_tCode = {}
	lblCombo.caption = cmbGroup.caption
	
	g_szCodeList = ""
	
	cmblastIdx = cmbGroup.rowcount -1
	
	if g_szCloud == "0" then	' 로컬
		Load_GWList()
	else						' 서버
		' 관심종목 종목 조회
		DATAMANAGER.RequestTranData("ohhts_intr_007r")	
	end if
	' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
	Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
End Sub

'============================================================================
' Load_GWList :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList
	
	g_szCodeList = ""
	grdList.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", cmbGroup.cbkeydata)

	if Trim(szGroup) <> "" then
		tGroup = Split(szGroup, "♣")

		For i = 0 to #tGroup-1
			Dim szCode
			
			tList = Split(tGroup(i), "★")
			
			grdList.insertrow = i
	
			grdList.SetCellData("bd_code", i, tList(0))
			grdList.SetCellData("bd_mk",   i, tList(1))
			grdList.SetCellData("bd_memo", i, tList(2))
			grdList.SetCellData("bd_name", i, tList(3))	' 20160325 위젯위해 종목명 추가
			
			if tList(4) == "" or tList(4) == null  then
				grdList.SetCellData("bd_nation",i, "KR")	'국가구분(KR/OV)
			else
				grdList.SetCellData("bd_nation",i, tList(4))	'국가구분(KR/OV)
			end if 
			
			if grdList.GetCellData("bd_nation",i) == "OV" then	'국가구분(KR/OV)
				szCode = tList(1) & "@" & tList(0)
			else
				szCode = tList(0)
			end if
			
			if g_szCodeList == "" then 
				g_szCodeList = szCode
			else
				g_szCodeList = g_szCodeList & "^" & szCode
			end if
		Next
	end if
	Container0.setIntrItems(g_szCodeList)
End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function
'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "GW_SET2" then
'		if sRet == "1" then
			g_szCodeList = ""
			grdGroup.rowcount = 0
			if g_szCloud == "1" then		' Server 저장시
				' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
				DATAMANAGER.RequestTranData("ohhts_intr_006r")
			else
				' 로컬 저장된 관심그룹 가져오기
				Load_GWGroup()
				Insert_cmbGroup()		
			end if
'		end if
		if g_szReturn <> "1" and g_szReturn <> "" then	'이미 그룹편집을 갔다왔을 경우 1로만 세팅한다
			g_szReturn = sRet
		end if
		
		'mhprc11010_p17 return
	elseif sKeyName == "DUPLICATE"  then

		g_szTB = sRet	'T = Top, B = Bottom
		DATAMANAGER.RequestTranData("ohhts_intr_102r")
		g_szReturn = "0"
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_szReturn <> "" then
		Form.SendReturnToParent("GW_SET2" , g_szReturn)
	end if
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ADD_ITEM" and sRet == "ok" then
		DATAMANAGER.RequestTranData("ohhts_intr_102r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

End Sub

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCode, szMk, szMemo, szNation, szName
	szList = ""
	
	For i = 0 to grdList.rowcount-1
		szCode = grdList.GetCellData("bd_code",  i)
		szName = grdList.GetCellData("bd_name",  i)
		szMemo  = grdList.GetCellData("bd_memo", i)
		szNation = grdList.GetCellData("bd_nation", i)
		szMk  = grdList.GetCellData("bd_mk", i)
		
		if Trim(szMk) == "" then
			szMk = ""
		end if
		
		' 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCode & "★" & szMk & "★" & szMemo & "★" & szName & "★" & szNation
		else
			szList = szList & "♣" & szCode  & "★" & szMk & "★" & szMemo & "★" & szName & "★" & szNation
		end if
	Next
	
	For i = 0 to grdGroup.rowcount-1
		Dim szCd
		szCd = grdGroup.GetCellData("bd_code", i)
			
		if cmbGroup.cbkeydata == szCd then
			grdGroup.SetCellData("bd_count", i, grdList.rowcount)
			Exit For
		end if
	Next
	
	Save_GWGroup()
	Form.SaveConfigData("GWANSIM", cmbGroup.cbkeydata, szList)
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

