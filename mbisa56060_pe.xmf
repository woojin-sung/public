	<SCRIPT_INFO _len="4043" _ulen="2755" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 투자유의사항 팝업
' 02. 화면설명 : 
' 03. 작    성 : 2023.12.04 : 고승연 : v0001 : [T2310260012] 온라인 설명의무 가이드 적용
' 04. 수    정 : 2024.06.28 : 고승연 : v0002 : 예금자보호 문구 수정
'
'-------------------------------------------------------------------------------------------
Dim g_bAgree

'============================================================================
Sub Form_OnFormInit()
	g_bAgree = false
	dim str
	
	str = "· 이 개인종합자산관리계좌(ISA)는 예금자보호법에 따라 예금보호 대상으로 운용되는"
	   .. "금융상품에 한하여 1인당 " & chr(34) & "5천만원까지" & chr(34) & "(운용되는"
	   .. "금융상품 판매회사별 보호상품 합산) 보호됩니다.\n\n"
	   .. "· 당사는 본 계좌에 관하여 충분히 설명할 의무가 있으며, 투자자는 투자에 앞서"
	   .. " 그러한 설명을 충분히 들으시기 바랍니다.\n\n"
	   .. "· 과세기준 및 과세방법은 향후 세법개정 등에 따라 변동될 수 있습니다.\n\n"
	   .. "· 본 계좌는 투자일임계약으로서 일임업자가 투자자에게 사전적으로 제시한"
	   .. " 운용방법을 변경할 수 있는 권한이 부여됩니다.\n\n"
	   .. "· 본 계좌는 운용결과에 따라 투자원금의 손실이 발생할 수 있으며, 그 손실은"
	   .. " 투자자에게 귀속됩니다.\n\n"
	   .. "· 본 계좌는 일임수수료가 발생할 수 있습니다."
	
	' 텍스트 색상 표시
	cont0.Label0.caption = str
	cont0.Label0.changeTextAttr(21, 74, 1, -2, false)
	cont0.Label0.changeTextAttr(170, 39, 1, -2, false)
	cont0.Label0.changeTextAttr(286, 48, 1, -2, false)
	
'	str = "· 이 개인종합자산관리계좌(ISA)에 편입된 금융상품 중 예금보호 대상으로 운용되는"
'	   .. " 금융상품에 한하여 예금자보호법에 따라 예금보험공사가 보호하되, 보호 한도는"
'	   .. " 금융상품을 판매한 금융회사별로 귀하의 모든 예금보호 대상 금융상품의 원금과"
'	   .. " 소정의 이자를 합하여 1인당 '최고 5천만원' 이며, 5천만원을 초과하는 나머지"
'	   .. " 금액은 보호하지 않습니다.\n\n"
'	   .. "· 당사는 본 계좌에 관하여 충분히 설명할 의무가 있으며, 투자자는 투자에 앞서"
'	   .. " 그러한 설명을 충분히 들으시기 바랍니다.\n\n"
'	   .. "· 과세기준 및 과세방법은 향후 세법개정 등에 따라 변동될 수 있습니다.\n\n"
'	   .. "· 본 계좌는 투자일임계약으로서 일임업자가 투자자에게 사전적으로 제시한"
'	   .. " 운용방법을 변경할 수 있는 권한이 부여됩니다.\n\n"
'	   .. "· 본 계좌는 운용결과에 따라 투자원금의 손실이 발생할 수 있으며, 그 손실은"
'	   .. " 투자자에게 귀속됩니다.\n\n"
'	   .. "· 본 계좌는 일임수수료가 발생할 수 있습니다."
'	
'	' 텍스트 색상 표시
'	cont0.Label0.caption = str
'	cont0.Label0.changeTextAttr(21, 57, 1, -2, false)
'	cont0.Label0.changeTextAttr(160, 30, 1, -2, false)
'	cont0.Label0.changeTextAttr(262, 39, 1, -2, false)
'	cont0.Label0.changeTextAttr(378, 48, 1, -2, false)

	imgBg.top = Form.GetCtlProp("cont0", "top") - 15
	imgBg.height = 647 - (Form.GetCtlProp("cont0", "top") - 15)
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_bAgree = false
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOk_OnClick()
	g_bAgree = true
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()

	if g_bAgree == true then
		Form.SendReturnToParent("mbisa56060_pe", "AGREE")
	else
		Form.SendReturnToParent("mbisa56060_pe", "CANCEL")
	end if
	
End Sub



	</SCRIPT_INFO>
</ROOT>