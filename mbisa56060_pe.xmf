	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgDim" autosize="1" imgpath="alpha128" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,250,375,397,1" />
		<CONTAINER name="cont0" vscroll="1" scroll_pos="0,0" ly_vert="0,150,375,451,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblTitl0" fontsize="2" fontstyle="01" caption="투자 유의사항" ly_vert="10,0,355,20,1" />
