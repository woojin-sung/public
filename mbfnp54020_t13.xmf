'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAllCancel_OnChange(sCheckState)
'	Form.SetSharedData("M_QCK", sCheckState)
	if CInt(Grid0.rowcount) > 0 then
		if sCheckState == "1" then
			btnAllCancel.visible = true
			Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
		else
			btnAllCancel.visible = false
		end if
		
		Grid0.height = 356
		for i = 0 to Grid0.rowcount - 1
			Grid0.SetCellData("bd_cell0", i, sCheckState)
		next
	else
		chkAllCancel.checkstate = "0"
		Grid0.selectrow = -1
	end if
End Sub

'============================================================================
Sub chkAll_OnChange(sCheckState)
	Form.SetSharedData("M_QCK", sCheckState)
	
	if sCheckState == "1" then
		edtQty.caption = ""	
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		'20230704 htw start 잔량 전부 체크 비활성화 시 수량 삽입 추가
		'20230718 htw start if문 g_nGridClickedIdxdp CInt() 추가
		if CInt(g_nGridClickedIdx) > -1 then
		'20230718 htw end if문 g_nGridClickedIdxdp CInt() 추가
			szAbleQty = Grid0.GetCellData("bd_cell13", g_nGridClickedIdx)
			edtQty.caption = szAbleQty
		else
			edtQty.caption = ""
		end if
		'20230704 htw end 잔량 전부 체크 비활성화 시 수량 삽입 추가
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	Dim szData
	
	if Trim(g_szCd) == "" or Trim(g_szCd) == Null then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	if g_szMk == Null or g_szMk == "" then
		Form.ShowAlert( "알림", "시장구분 코드가 존재하지 않습니다.")
		Exit Sub
	end if
	
	if edtPrc.caption <> "" then
		szPrc = edtPrc.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
    szQty = edtQty.caption
	szOrdQty		= Grid0.GetCellData("bd_cell7", g_nGridClickedIdx)
	
	szOrdType	= Grid0.GetCellData("bd_cell4", g_nGridClickedIdx)	'매매구분
	if szOrdType = "매수" then
		szOrdType = 0
	elseif szOrdType = "매도" then
		szOrdType = 1
	end if
	szTab = "2●" & szOrdType
	
	szData = szPrc & "★" & szQty & "★" & g_szMk & "★" & g_szCd & "★" & szOrdQty & "★" & "1" & "★" & szTab
	Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2")  
End Sub

'============================================================================
' btnPrc_OnClick
'============================================================================
Sub btnPrc_OnClick()
	Dim szData
	
	if Trim(g_szCd) == "" or Trim(g_szCd) == Null then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	if g_szMk == Null or g_szMk == "" then
		Form.ShowAlert( "알림", "시장구분 코드가 존재하지 않습니다.")
		Exit Sub
	end if
	
	if edtPrc.caption <> "" then
		szPrc = edtPrc.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
	szQty = edtQty.caption
	
	szOrdQty		= Grid0.GetCellData("bd_cell7", g_nGridClickedIdx)
	
	szOrdType	= Grid0.GetCellData("bd_cell4", g_nGridClickedIdx)	'매매구분
	if szOrdType = "매수" then
		szOrdType = 0
	elseif szOrdType = "매도" then
		szOrdType = 1
	end if
	szTab = "2●" & szOrdType
	
	szData = szPrc & "★" & szQty & "★" & g_szMk & "★" & g_szCd & "★" & szOrdQty & "★" & "0" & "★" & szTab
	Form.OpenPopupAnimation("mbfnp54020_p12", szData, "", "2")  
End Sub 


