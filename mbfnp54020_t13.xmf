'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit() 
	Grid0.height = 356

	'20230707 htw start 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소
	szTextSize = Form.GetEnvData("common.textsize")
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	if CInt(szTextSize) > 0 and szDeviceOS == "2" then '큰글씨 + IOS 이면
		chkAllCancel.fontsize = - 3 - CInt(szTextSize)
	end if
	'20230707 htw end 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소

	Grid0.SetCellMaxLineCount("bd_cell2", 2)
	
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상

	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "매수")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "매도")

	FormTab0.currenttab = 0
	
	Load_OrderSet() '주문설정값 읽어오기   
	
'	chkAll_OnChange("1")
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20230712 htw start 종목명 멀티라인 설정
	Grid0.SetCellMaxLineCount("bd_cell9", 2)
	'20230712 htw end 종목명 멀티라인 설정
	
	'20200910 SWJ END
	g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'MsgBox(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면의 호가 클릭시
	' ----------------------------------------------------------------------				
	if sEventName == "54020_HOGA" then
		if sParam <> "" then
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------			
	elseif sEventName == "INIT_CODE" then	' 20160316
		if sParam <> "" then
			DATAMANAGER.RequestTranData("obtrs_cntg_660r")		' HSZ TEST
			
			tData = Split(sParam, "★")
			
			if #tData > 0 then
				
				if #tData > 2 then
					g_szMK = tData(0)
					g_szCd = tData(1)
					edtQty.caption   = tData(2) '수량
					edtOrgNo.caption = tData(3) '주문번호
					'tData(4) '주문유형
					edtPrc.caption = tData(5) '가격
					'tData(6) '주문조건코드
				else
					g_szMK = tData(0)
					g_szCd = tData(1)
					
					'그리드에서 선택해서 종목이 변경 된 경우는 이쪽을 탄다
					if g_szChangeInit == "1" then
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					else
						edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
					end if
					
					g_bCntrtRtn = false
				end if
			end if
			
		end if	
	
'	
'	
'		'20230725 htw start 정정취소탭에서 환경설정 클릭 후, 환경설정에서 <로 나올 경우 init_code를 타서 오류 발생하여 방지용
'		if Trim(g_szCd) <> "" then
'			Dim szTempCd
'			szTempCd = g_szCd
'			
'			if szTempCd == sParam then
'				'그리드에서 선택해서 종목이 변경 된 경우는 이쪽을 탄다
'				if g_szChangeInit == "1" then
'					Form.SetCtlProp("#edtOrgNo", "caption", "")
'				else
'					edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
'				end if
'				
'				g_bCntrtRtn = false
'			else
'				'종목검색기로 종목을 변경한 경우 이쪽을 탄다
'			
'
						Grid0.SetCellData("bd_cell0", g_nGridClickedIdx, "0")
						Grid0.selectrow = -1
						g_nGridClickedIdx = -1
						chkAllCancel.checkstate = "0"
						btnAllCancel.visible = false
						Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
						Grid0.height = 356

				if g_bCntrtRtn == false then
					Form.SetCtlProp("#edtOrgNo", "caption", "")
					edtOrgNo.caption = ""
				else
					if g_szChangeInit == "1" then
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					else
						Form.SetCtlProp("#edtOrgNo", "caption", edtOrgNo.caption)
					end if
				end if
				
			'===================================================================================
			' 20170726 LES START - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
			'===================================================================================
			
				if g_szCd <> sParam then
					g_szCd = sParam
				
				end if
			
			'===================================================================================
			' 20170726 LES END - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
			'===================================================================================
			
				if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
					Init_InputControl()
				end if	
'			end if
			
			
'		end if
		'20230725 htw end 정정취소탭에서 환경설정 클릭 후, 환경설정에서 <로 나올 경우 init_code를 타서 오류 발생하여 방지용
	' ----------------------------------------------------------------------
	' 메인화면에서 탭 체인지
	' ----------------------------------------------------------------------			
	elseif sEventName == "CHNAGE_TAB" then
'		edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		
		'230525 htw 컨트롤 visible초기화 start
		btnAllCancel.visible = false
		chkAllCancel.checkstate = "0"
		'230525 htw 컨트롤 visible초기화 end
		
		'===================================================================================
		' 20170726 LES START - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		if g_szCd <> sParam then
			g_szCd = sParam
		
		end if
		
		'===================================================================================
		' 20170726 LES END - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if	
		
		'20180716 LES START
		Grid0.height = 356
		chkAllCancel.checkstate = "0"
		btnAllCancel.visible = false

		Grid0.rowcount = 0
		DATAMANAGER.RequestTranData("obtrs_cntg_660r")
		
	' ----------------------------------------------------------------------
	' 주문번호 연동
	' ----------------------------------------------------------------------			
	elseif sEventName == "AFTER_ORGNO" then		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
			edtOrgNo_OnEditComplete()
		end if

	elseif sEventName == "ACNT_CHANGE" then'계좌변경
		edtPrc.caption = ""
		edtQty.caption = ""
		f_Reset()
		DATAMANAGER.RequestTranData("obtrs_cntg_660r")
		
	elseif sEventName == "SEND_MOD" then'주문/체결 탭에서 미체결 주문 클릭 시
		if sParam <> "" then
			g_tGetData = Split(sParam,"★")'종목코드★주문번호★호가★미체결수량
			
			g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
			FormTab0.currenttab = 0
			Grid0.rowcount = 0
			DATAMANAGER.RequestTranData("obtrs_cntg_660r")
		end if
	elseif sEventName == "SEND_ALL_CANCEL" then'주문/체결 탭에서 미체결 전체취소하기
		g_tAllCancelData = "ALL_CANCEL"
		'20230724 htw start 환경설정에 설정한 단가 get하는 트리거 추가
	elseif sEventName == "MOD_SEND_SETTING_HOGA" then'환경설정에 설정한 단가 get
		if sParam <> "" then
			edtPrc.caption = sParam
			g_szOdrPrc = CInt(sParam)
		else
			edtPrc.caption = g_szOdrPrc
		end if
		'20230724 htw end 환경설정에 설정한 단가 get하는 트리거 추가
	end if
End Sub

Sub f_Reset()
	Grid0.rowcount = 0
	Form.triggerEvent("#", "MOD_CAN_RESET", "")
end Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		g_szQty = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()

	elseif sKeyName == "mbfnp54020_p12" then		'키패드		
		
		if sRet <> "" then
			Dim tTemp
			tTemp = Split(sRet, "★")
			
			edtPrc.caption = tTemp(0)
			edtQty.caption = tTemp(1)
			edtPrc_OnEditComplete()
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szAll, szQty
	
	' 종목코드
	szCd = g_szCd
	
	'주문유형에 따른 주문단가
	szPrc = edtPrc.caption

	if g_OrderGubn == "0" then	'정정
		' 정정
		szCLSCd = "303"
	else
		' 취소
		szCLSCd = "304"
	end if

	' 잔량전부 여부
	if chkAll.checkstate == "1" then
		szAll = "Y"
		szQty = Grid0.GetCellData("bd_cell7", g_szTRIdx)	'미체결 수량
	else
		szAll = "N"
		szQty = edtQty.caption
	end if

	' ----------------------------------------------------------------------
	' 채권 정정/취소주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_oder_301a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_301a")
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "SVCD", 0, szCLSCd)											''' 서비스코드'
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "CHAN_TYPE_CLS_CODE", 0, "020")
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acc", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acc", "sequence"))	' 계좌일련번호(2)
		 
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))	' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ISCD"				, 0, Grid0.GetCellData("bd_cell9", g_szTRIdx))' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODQT"				, 0, edtQty.caption)						' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ORGL_ODER_NO"		, 0, Grid0.GetCellData("bd_ordno", g_szTRIdx))' 원주문번호
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "WHOL_RCTF_CNCL_YN"	, 0, szAll)								' 전체 정정 취소여부
		'==================================
		if g_OrderGubn == "0" then	'정정
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_ODER_UNPR"		, 0, szPrc)							' 주문단가
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BYOV_DATE"			, 0, "")								' 매수일자 -> HSZ 확인필요
				DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "WARN_CNFR_YN"	, 0, g_szWarnFlag)					' 경고확인여부
		else'취소						
			if g_OrderGubn == "2" then	'일괄 취소
				DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "WHOL_RCTF_CNCL_YN"	, 0, "Y")						' 전체 정정 취소여부
				DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODQT"				, 0, Grid0.GetCellData("bd_cell7", g_szTRIdx))						' 주문수량
			end if
		end if
	' ----------------------------------------------------------------------
	' 채권 체결/미체결 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_cntg_660r" or szTranID == "obtrs_cntg_660r_1" then
		g_nAcNo = Form.GetCtlProp("#acc", "total")
		g_nAsNo = Form.GetCtlProp("#acc", "sequence")
		DATAMANAGER.ClearInputData(0, szTranID)
		
		'매수/매도여도 전체건수 표시 요청
		if szTranID == "obtrs_cntg_660r_1" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEAL_CLS_CODE"	, 0 , "0")					' 매매구분코드(0:전체, 1:매도, 2:매수)
		else	
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEAL_CLS_CODE"	, 0 , g_szGbnCode)			' 매매구분코드(0:전체, 1:매도, 2:매수)
		end if

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0 , g_nAsNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNTG_CLS_CODE", 0 , "2")							'0:전체, 1:채결, 2:미체결
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_TYPE_CLS_CODE", 0 , "08") 					'주문유형코드구분
		
	elseif szTranID == "ohhts_7052_001r" then
		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		
	end if
End Sub
			
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg
	' ----------------------------------------------------------------------
	' 주식 정정/취소주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_oder_301a" then
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		if szWarnCd = "1" then							' 경고
			Open_ConfirmPopup(szWarnMsg)
		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			
			if g_OrderGubn == "2" then '일괄취소
				Dim szIdx
				szIdx = ""
				
				for i = g_szTRIdx + 1 to Grid0.rowcount - 1
					if Grid0.GetCellData("bd_cell0", i) == "1" then
						szIdx = i
						exit for
					end if
				next
				
				if szIdx <> "" then	'다음 취소할 대상을 찾으면
					g_szTRIdx = szIdx
					g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1	'다건 취소 주문 갯수 증가
					'20230718 htw start 보류= 주문 완료가 아니므로 g_MultiCancelOrderNotAcceptCnt 추가
					g_MultiCancelOrderNotAcceptCnt = g_MultiCancelOrderNotAcceptCnt + 1
					'20230718 htw end 보류= 주문 완료가 아니므로 g_MultiCancelOrderNotAcceptCnt 추가
					DATAMANAGER.RequestTranData("obtrs_oder_301a")
				else	'끝이면
					'20230627 htw start 취소 문구 케이스별로 분류
					'다건일 경우 주문 완료 알럿 제공
					
					g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1
					
					if g_MultiCancelOrderNotAcceptCnt == 0 then
						Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					elseif g_nMultiCancelOrderCnt == g_MultiCancelOrderNotAcceptCnt then'취소주문요청갯수=불가갯수
						Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					else
						Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					end if
					
					g_MultiCancelOrderNotAcceptCnt = 0'취소 주문 불가 갯수 카운트 초기화
					g_nMultiCancelOrderCnt = 0	'다건 취소 주문 갯수 초기화
					'20230627 htw end 취소 문구 케이스별로 분류
					chkAllCancel.checkstate = "0"
					btnAllCancel.visible = false
					Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
					Grid0.height = 356
					imgRefresh_OnClick()
				end if
			end if
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) == "0001" then
				if g_szAfterInit == "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				if g_OrderGubn <> "2" then '일괄취소
					Form.Toast(0, szOrdMsg, true)
				end if
				
				if g_OrderGubn == "0" then	'정정
					' 20160322  정정주문에서도 주문번호 연동 추가 ////////////
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
						edtOrgNo.caption = szOrgNo
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					end if				
					' ////////////////////////////////////////////////////////
				end if
				
				if g_OrderGubn == "2" then '일괄취소
					Dim szIdx
					szIdx = ""
					
					for i = g_szTRIdx + 1 to Grid0.rowcount - 1
						if Grid0.GetCellData("bd_cell0", i) == "1" then
							szIdx = i
							exit for
						end if
					next
					
					if szIdx <> "" then	'다음 취소할 대상을 찾으면
						g_szTRIdx = szIdx
						g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1	'다건 취소 주문 갯수 증가
						DATAMANAGER.RequestTranData("obtrs_oder_301a")
						return false
					else	'끝이면
						'20230627 htw start 취소 문구 케이스별로 분류
						'다건일 경우 주문 완료 알럿 제공
						g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1
						
						if g_MultiCancelOrderNotAcceptCnt == 0 then
							Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
						elseif g_nMultiCancelOrderCnt == g_MultiCancelOrderNotAcceptCnt then'취소주문요청갯수=불가갯수
							Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
						else
							Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
						end if
						
						g_MultiCancelOrderNotAcceptCnt = 0'취소 주문 불가 갯수 카운트 초기화
						g_nMultiCancelOrderCnt = 0	'다건 취소 주문 갯수 초기화
						'20230627 htw end 취소 문구 케이스별로 분류
					end if
				end if
				
				chkAllCancel.checkstate = "0"
				btnAllCancel.visible = false
				Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
				Grid0.height = 356
				imgRefresh_OnClick()
			end if
		end If
	elseif szTranID == "obtrs_cntg_660r" then
		Dim nCnt
		nCnt = CInt(Grid0.rowcount)

		if nCnt > 0 then
			imgNodata.visible = false
			lblNodata.visible = false
		else
			Grid0.height = 356
			Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
			imgNodata.visible = true
			lblNodata.visible = true
		end if
		if g_szGbnCode == "0" then
			FormTab0.SetTabPageCaption( "page1", "전체("..nCnt.."건)" )
		'20230719 htw start 매수/매도여도 전체건수 표시 요청
		else
			DATAMANAGER.RequestTranData( "obtrs_cntg_660r_1" )
		'20230719 htw end 매수/매도여도 전체건수 표시 요청
		end if
		
		For iCnt = Grid0.rowcount - 1 To 0 Step -1
			OderRfusReasCode = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "ODER_RFUS_REAS_CODE", iCnt ) '주문거부사유코드
			sCode            = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "BOND_MKPL_CLS_CODE", iCnt ) '채권매매시장구분코드
			strTrade_Gubun   = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "DEAL_CLS_CODE", iCnt )
			strMC_Gubun      = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "RCTF_CNCL_CLS_CODE", iCnt )

			strTrade_Gubun_nm = fn_CodeToName( "Trade", strTrade_Gubun )
			strMC_Gubun_nm    = fn_CodeToName( "MC", strMC_Gubun )

			'Form.ShowAlert(sTitle, "-->"..strMC_Gubun.."<--")
			
			if tostring(strMC_Gubun) == "1" then
			    strFullNM = strTrade_Gubun_nm
			else
			    strFullNM = strTrade_Gubun_nm&strMC_Gubun_nm
			end if

		    '매매구분
		    Grid0.SetCellData( "bd_cell4", iCnt, strFullNM )
		    
		    '채권매매시장구분코드
		    sName = Form.GetMetaData( "채권매매시장구분코드", sCode )
		    Grid0.SetCellData( "bd_cell8", iCnt, sName )
		    
		    if Trim(OderRfusReasCode) == "0000" or Trim(OderRfusReasCode) == "" then
			    Grid0.SetCellData( "bd_cell12",  iCnt, "정상" )
		    else
			    Grid0.SetCellData( "bd_cell12",  iCnt, "거부" )
		    end if
		    
		    '매도
		    if strTrade_Gubun == "1" then
			    Grid0.SetCellFgColor("bd_cell4",  iCnt, "11")
		    '매수
		    else
			    Grid0.SetCellFgColor("bd_cell4", iCnt, "10")
		    end if
		next
		

		if g_tGetData <> "" and #g_tGetData > 0 then
			Dim szOrdNo, szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szMk, szCredit, szData
'			
			For lRow = 0 to Grid0.rowcount - 1
'				
				szOrdNo = Grid0.GetCellData("bd_ordno", lRow)'주문번호
				if szOrdNo == g_tGetData(3) then
					Grid0.SetCellData("bd_cell0", lRow, "1")
					'20230718 htw start 선택색상 추가
					Grid0.selectrow = lRow
					'20230718 htw end 선택색상 추가
					g_nGridClickedIdx = lRow
					szCd      = Grid0.GetCellData("bd_cell9",       lRow)
					szQty     = Grid0.GetCellData("bd_cell7", lRow)
					szOdrNo   = Grid0.GetCellData("bd_ordno",    lRow)	
					szOdrType = Grid0.GetCellData("bd_cell4",  lRow)
					szOdrPrc  = Grid0.GetCellData("bd_cell5",   lRow)
					szClsCd   = Grid0.GetCellData("bd_cell11",    lRow)
					szMktNM   = Grid0.GetCellData("bd_cell8", lRow)
'					
					szMk = Form.GetItemCodeInfo(szCd, "market")
'					
					g_szCd = szCd
'					
					Dim g_Tab
					g_Tab = "2"'임시			
					
					' 장내채권, 소액채권만가능
					If Trim(szMk) == "MM" or Trim(szMk) == "BN" then
						' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
'						szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
'						Form.triggerEvent("#", "12000_CONTRACT", szData)
						szData = g_szMk & "★" & g_szCd & "★" &  szQty & "★" & szOdrNo & "★" & szOdrType & "★" & szOdrPrc & "★" & szClsCd
						Form.triggerEvent("#", "BODY_CALLBACK", szData)
					else
						Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
					end if

					if chkAll.checkstate == "1" then
						btnQty.enable = false
						btnQMinus.enable = false
						btnQPlus.enable = false
						edtQty.enable = false
						edtQty.caption = ""
					else
						btnQty.enable = true
						btnQMinus.enable = true
						btnQPlus.enable = true
						edtQty.enable = true
						edtQty.caption = Grid0.GetCellData("bd_cell7", lRow)'미체결 수량
						'20230724 htw start 주문한 단가 셋팅
						g_szOdrPrc = CInt(szOdrPrc)
						'20230724 htw start 주문한 단가 셋팅
					end if
'
					Grid0.height = 152
					Form.SetTimerEvent2(1, 1, 0.1)
'					
					Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
					exit for
				end if
			next
			g_tGetData = ""
		elseif g_tAllCancelData <> "" then
			chkAllCancel.checkstate = 1
			chkAllCancel_OnChange("1")
			g_tAllCancelData = ""
		end if
		
	'20230719 htw start 매수/매도여도 전체건수 표시 요청
	elseif "obtrs_cntg_660r_1" == szTranID then
		nCnt = DATAMANAGER.GetDataCount( false, "obtrs_cntg_660r_1", "OutBlock1" )
		FormTab0.SetTabPageCaption( "page1", "전체("..nCnt.."건)" )
	'20230719 htw end 매수/매도여도 전체건수 표시 요청
	elseIf szTranID == "ohhts_7052_001r" then
		'20160602 NOHES 채권 호가 단위
		Dim szPrc
		szPrc = DATAMANAGER.GetDataValue( 0, "ohhts_7052_001r", "OutBlock1", "FID_PRPR", 0)
				
		if szPrc ~= "" then
			edtPrc.caption = szPrc
		end if
	end if
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg, szTranMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obtrs_oder_301a" then
		'20230718 htw start 일괄취소 1개를 할 경우도 있으므로 오류로 들어온 경우 무조건 갯수 증가
		if g_OrderGubn == "2" then
			g_MultiCancelOrderNotAcceptCnt = g_MultiCancelOrderNotAcceptCnt + 1'취소 주문 불가 갯수 카운트 증가
		end if
		'20230718 htw end 일괄취소 1개를 할 경우도 있으므로 오류로 들어온 경우 무조건 갯수 증가
		
		Dim szIdx
		szIdx = ""
		
		for i = g_szTRIdx + 1 to Grid0.rowcount - 1
			if Grid0.GetCellData("bd_cell0", i) == "1" then
				szIdx = i
				exit for
			end if
		next
		
		
		if szIdx <> "" then	'다음 취소할 대상을 찾으면
			g_szTRIdx = szIdx
			g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1	'다건 취소 주문 갯수 증가
			'20230718 htw start 주석처리
'			g_MultiCancelOrderNotAcceptCnt = g_MultiCancelOrderNotAcceptCnt + 1'취소 주문 불가 갯수 카운트 증가
			'20230718 htw start 주석처리
			DATAMANAGER.RequestTranData("obtrs_oder_301a")
			return false
		else
			if g_OrderGubn == "0" or g_OrderGubn == "1" then
				'단건일 경우 에러는 무조건 에러알림창 제공
				if Trim(szSubMsg) <> "" then
					Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
				else
					Form.ShowAlert(g_szTitle, szErrMsg)
				end if
			else
				'20230720 htw start 
				g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1
				'20230627 htw start 취소 문구 케이스별로 분류
				'다건일 경우 주문 완료 알럿 제공
				if g_MultiCancelOrderNotAcceptCnt == 0 then
					Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				elseif g_nMultiCancelOrderCnt == g_MultiCancelOrderNotAcceptCnt then'취소주문요청갯수=불가갯수
					Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				else
					Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				end if
				
				g_MultiCancelOrderNotAcceptCnt = 0'취소 주문 불가 갯수 카운트 초기화
				g_nMultiCancelOrderCnt = 0	'다건 취소 주문 갯수 초기화
				'20230627 htw end 취소 문구 케이스별로 분류
				chkAllCancel.checkstate = "0"
				btnAllCancel.visible = false
				Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
				Grid0.height = 356
				imgRefresh_OnClick()
			end if
		end if
	else
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
End Sub
