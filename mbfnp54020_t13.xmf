'============================================================================
Sub imgRefresh_OnClick()
	'20230724 htw start 변경시 그리드 펼치기 추가
	g_nGridClickedIdx = -1
	Grid0.selectrow = -1
	Grid0.rowcount = 0
	btnAllCancel.visible = false
	chkAllCancel.checkstate = "0"
	chkAllCancel_OnChange("0")
	Grid0.height = 356
	Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
	'20230724 htw end 변경시 그리드 펼치기 추가
	DATAMANAGER.RequestTranData("obtrs_cntg_660r")
End Sub

'============================================================================
Function f_GridCheck()
	Dim szChecked, bFlag
	bFlag = false
	
	for i = 0 to Grid0.rowcount - 1
		szChecked = Grid0.GetCellData("bd_cell0", i)
		if szChecked == "1" then
			bFlag = true
			exit for
		end if
	next
	
	if bFlag then
		'그리드에 1개라도 체크가 되어있다
		Grid0.height = 152
		Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
	else
		'그리드에 체크된게 없다
		Grid0.height = 356
		Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible false처리
	end if
end Function 

'============================================================================
Sub btnAllCancel_OnClick()
	if Check_Account(0) == false then
		return false
	end if
	'일괄취소
	dim bFlag, nCnt,szData
	nCnt = 0
	bFlag = false
	szData = ""
	
	for i = 0 to Grid0.rowcount - 1
		if Grid0.GetCellData("bd_cell0", i) == "1" then
			if bFlag == false then
				g_szTRIdx = i
				bFlag = true
			end if
			
			nCnt = nCnt + 1
		end if
	next
	
	if bFlag == true then
		g_OrderGubn = "2"

		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
'			
			szData = Form.GetCtlProp("#acc", "caption")					' 계좌번호
			szData = szData & "|" & Form.GetCtlProp("#acc", "accountname")				' 계좌명
			szData = szData & "|" & nCnt
			
			if CInt(nCnt) == CInt(Grid0.rowcount) then
				szData = szData & "|" & "전종목"
			else
				szData = szData & "|" & "선택종목"
			end if
			
			Form.OpenPopupAnimation("mbfnp54020_p17", szData , "","2")		' 주문확인팝업 오픈
		else
			Request_Order()
		end if
	else
		'선택한게 하나도 없다면
		Form.ShowAlert("알림", "일괄취소할 주문을 선택해주세요.")
	end if
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 1 then
		g_szGbnCode = "2"	' 매매구분코드(0:전체, 1:매도, 2:매수)
	elseif nCurrentTab == 2 then
		g_szGbnCode = "1"
	else
		g_szGbnCode = CStr(nCurrentTab)	' 매매구분코드(0:전체, 1:매도, 2:매수)
	end if
	g_nGridClickedIdx = -1
	Grid0.rowcount = 0
	'20230724 htw start 변경시 그리드 펼치기 추가
	Grid0.selectrow = -1
	Grid0.height = 356
	'20230724 htw start 전체취소 체크 클리어 추가
	chkAllCancel.checkstate = "0"
	btnAllCancel.visible = false
	Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
	'20230724 htw end 변경시 그리드 펼치기 추가
	DATAMANAGER.RequestTranData("obtrs_cntg_660r")

End Sub

