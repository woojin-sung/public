End Sub
'============================================================================
Function fn_CodeToName(szTitle, szCode)
 Select Case szTitle
  Case "Trade"
   Select Case szCode
    Case "1" return "매도"
    Case "2" return "매수"
    Case "3" return "매수청산"
    Case "4" return "매도청산"
    Case "5" return "권리행사"
    Case "6" return "의무배정"
    Case "7" return "행사포기"
    Case "8" return "의무면제"
    Case "A" return "인수대금"
    Case "B" return "인도대금"
    Case "C" return "단주행사"
    Case "D" return "단주배정"
    Case "0" return "상계"
   end Select 
  
  Case "MC"
   Select Case szCode
    Case "1" return "정상"
    Case "2" return "정정"
    Case "3" return "취소"
   end Select
end Select
End Function


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if chkAllCancel.checkstate == "1" then'전체취소 체크 상태
		Dim szCheck, bFlag
		szCheck = Grid0.GetCellData("bd_cell0", lRow)
		
		if szCellID <> "bd_cell0" then
			if szCheck == "1" then
				Grid0.SetCellData("bd_cell0", lRow, 0)
			else
				Grid0.SetCellData("bd_cell0", lRow, 1)
			end if
		end if
		
		
		bFlag = false
		for i = 0 to Grid0.rowcount - 1
			szCheck = Grid0.GetCellData("bd_cell0", i)
			
			if szCheck == "1" then
				bFlag = true
			end if
		next
		
		if bFlag == false then '모든 리스트가 체크 해제 상태
			chkAllCancel.checkstate = "0"
			chkAllCancel_OnChange("0")
		end if
		Grid0.selectrow = -1
	else'미체크 상태
		DIm szChecked
		szChecked = Grid0.GetCellData("bd_cell0", lRow)
		
		if szCellID <> "bd_cell0" then'체크 이외를 누른 경우
			if szChecked == "1" then'이미눌려서 체크 해제
				Grid0.SetCellData("bd_cell0", lRow, "0")
				szChecked = "0"
			else
				Grid0.SetCellData("bd_cell0", lRow, "1")
				szChecked = "1"
			end if
		end if
		
		if szChecked == "1" then '누름(특정 종목 조회 + 그리드 작게)
			'20230719 htw start IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
			Dim bFlag
			bFlag = false
			for i = 0 to Grid0.rowcount - 1			
				if i <> lRow then
					szChk = CInt(Grid0.GetCellData("bd_cell0", i))
					if szChk == 1 then
						bFlag = true
						g_nAlreadyClickIdx = CInt(lRow)
					end if
					Grid0.SetCellData("bd_cell0", i, 0)
				end if
			next
			
			if bFlag == false then'아무것도 선택 안한 상태라면
				g_nAlreadyClickIdx = CInt(lRow)
			end if
			'20230719 htw end IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
			
			g_nGridClickedIdx = lRow
			'===ASIS미체결 팝업
			Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
			
			if lRow > -1 then
				Form.SetTimerEvent2(1, 1, 0.1)
				Grid0.height = 152
				
				szCd      = Grid0.GetCellData("bd_cell9", lRow)
				szQty     = Grid0.GetCellData("bd_cell7", lRow)
				szOdrNo   = Grid0.GetCellData("bd_ordno", lRow)	
				szOdrType = Grid0.GetCellData("bd_cell4", lRow)	'매매구분
				szOdrPrc  = Grid0.GetCellData("bd_cell5", lRow)
				szClsCd   = Grid0.GetCellData("bd_cell11", lRow)	'주문조건구분코드    ODER_COND_CLS_CODE
				szMktNm   = Grid0.GetCellData("bd_cell8", lRow) 	'채권매매시장구분
				
				g_szCd = szCd
				if szMktNm == "일반시장" then
					g_szMk = "B"  '장내
				else
					g_szMk = "SB"  '소액
				end if
				g_szCd = szCd
				szMk = Form.GetItemCodeInfo(szCd, "market")
				
				'20230724 htw start 주문한 단가 셋팅
				edtPrc.caption = szOdrPrc		'채권은 무조건 그리드 단가로 입력(기획)
				
				g_Tab = "2"'임시
				' 장내채권, 소액채권만가능
				If Trim(szMk) == "MM" or Trim(szMk) == "BN" then	
					' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
'					szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
					szData = g_szMk & "★" & g_szCd & "★" &  szQty & "★" & szOdrNo & "★" & szOdrType & "★" & szOdrPrc & "★" & szClsCd
					Form.triggerEvent("#", "BODY_CALLBACK", szData)
					
				else
					Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
				end if
				
				if chkAll.checkstate == "1" then
					btnQty.enable = false
					btnQMinus.enable = false
					btnQPlus.enable = false
					edtQty.enable = false
					edtQty.caption = ""
				else
					btnQty.enable = true
					btnQMinus.enable = true
					btnQPlus.enable = true
					edtQty.enable = true
					edtQty.caption = Grid0.GetCellData("bd_cell7", lRow)'미체결 수량
				end if
			
				Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
			end if	
			
		'체크 해제(=리스트 전체로 보이기)
		else
			'20230719 htw start IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
			g_nAlreadyClickIdx = -1
			'20230719 htw start end 그리드 리스트 체크 상태 적용을 위한 변수 추가
			Grid0.selectrow = -1
			g_nGridClickedIdx = -1'선택 상품 해제
			Grid0.height = 356
			Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
		end if
	end if
End Sub 
'============================================================================
Function f_GridCheck()
	Dim szChecked, bFlag
	bFlag = false
	
	for i = 0 to Grid0.rowcount - 1
		szChecked = Grid0.GetCellData("bd_cell0", i)
		if szChecked == "1" then
			bFlag = true
			exit for
		end if
	next
	
	if bFlag then
		'그리드에 1개라도 체크가 되어있다
		Grid0.height = 152
		Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
	else
		'그리드에 체크된게 없다
		Grid0.height = 356
		Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible false처리
	end if
end Function 

