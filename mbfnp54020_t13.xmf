'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'주문 환경
Dim g_szOdrPop
'Dim g_szBtnMkt

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit

' 주문후 
Dim g_szAfterOrg

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szTR

Dim g_bBtnMkClk
g_bBtnMkClk = false

Dim g_szInner

Dim g_szTitle
g_szTitle = "알림"

Dim g_nUnit
g_nUnit = 1

Dim g_szQty
g_szQty = ""

Dim g_bCntrtRtn		' 미체결리턴
g_bCntrtRtn = false

Dim g_OrderGubn	'0정정 1취소 '2일괄취소
g_OrderGubn = "0"

Dim g_szGbnCode			
Dim g_szTRIdx
Dim g_nGridClickedIdx
Dim g_tGetData	'주문/체결 탭에서 받은 data 저장
Dim g_tAllCancelData '주문/체결 탭에서 미체결 전체취소하기
g_tGetData = ""
g_tAllCancelData = ""
Dim g_bFirstSelectBeforeMarket
g_bFirstSelectBeforeMarket = false
Dim g_MultiCancelOrderNotAcceptCnt'다건 취소 시 TR에서 취소불가 주문 갯수 저장
Dim g_nMultiCancelOrderCnt		'다건 취소 요청 갯수
g_MultiCancelOrderNotAcceptCnt = 0
g_nMultiCancelOrderCnt = 0
Dim g_nAlreadyClickIdx '그리드 리스트 체크 상태 적용을 위한 변수 추가
g_nAlreadyClickIdx = -1

Dim g_szOdrPrc'선택한 리스트의 주문 단가 저장
g_szOdrPrc = ""

Dim g_bClickHeaderItem'상단 종목검색기로 검색한 경우를 판단하는 변수
g_bClickHeaderItem = true
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtQty_OnEditComplete()

	if g_bCntrtRtn == false then
		g_szQty = ""
'		edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")	

		edtOrgNo.caption = ""	
		edtOrgNo_OnEditComplete()
		edtPrc.caption = ""
		edtPrc_OnEditComplete()
	end if
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	' 환경설정값 정의
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if

	
	' 20240712 HSZ START: 매크로주문 긴급대응
'	if Trim(g_szAfterInit) = "" then
'		g_szAfterInit = "1"
'	end if	
	g_szAfterInit = "1"
	' 20240712 HSZ END
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
End Function

'============================================================================
' Visible_Control : nGbn(유형)
'============================================================================
Function Visible_Control(nGbn)
	if g_szMk == "W" then		' 20160325 ELW는 제외 적용
		edtPrc.enable = true
		btnPrc.enable = true
		btnPPlus.enable = true
		btnPMinus.enable = true
		
	else
		
		' 보통, 조건부지정가, 보통(IOC), 보통(FOK), 시간외단일가
		Select case nGbn
			case 0, 2, 5, 8, 13
				edtPrc.enable = true
				btnPrc.enable = true
				btnPPlus.enable = true
				btnPMinus.enable = true	
			case else
				edtPrc.caption = ""
				edtPrc_OnEditComplete()
				
				edtPrc.enable = false	
				btnPrc.enable = false
				btnPPlus.enable = false
				btnPMinus.enable = false
		End Select
	end if
End Function

'============================================================================
' Set_TypeList : "market" or "ineermarket"에 따른 주문유형 변경 (20160329 추가)
'============================================================================
Function Set_TypeList(nGbn)
	
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	
	if nGbn == 0 then
		return "00`보통(지정가)\r\n01`보통(IOC)\r\n02`보통(FOK)"
	elseif nGbn == 1 then
		return "00`보통(지정가)\r\n01`시장가\r\n02`장후시간외"
	else
		
		'20200416 LES START 대여주문 관련수정(대여주문 시간외단일가/장후시간외 주문타입 삭제 - 양현정 과장 요청)
		if szScrNo = "12060" then
			return "00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외"'\r\n12`장후시간외\r\n13`시간외단일가"
		else
			return "00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외\r\n12`장후시간외\r\n13`시간외단일가"
		end if
		
	end if
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if

	
	if Trim(Grid0.GetCellData("bd_ordno", g_szTRIdx)) == "" then
		Form.ShowAlert(g_szTitle, "주문번호를 입력하십시요.")
		return false
	end if
	
	if chkAll.checkstate == "0" then		' 일부잔량 선택시
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if
	
	if nGbn == 0 and g_OrderGubn == "0" then	'정정일때만 체크
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false	
		end if
	end if	
		
'	if g_nGridClickedIdx > -1 then
'	
'	end if
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	Dim szData
	
	'20230720 htw start 경고창일 경우 정정=2로 변경
	if Trim(szWarn) <> "" then
		szData = "2"
	else
		szData = g_OrderGubn
	end if
	'20230720 htw end 경고창일 경우 정정=2로 변경
	
	szData = szData & "|" & g_szMk											' 시장구분
	szData = szData & "|" & Form.GetCtlProp("#acc", "caption")					' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acc", "accountname")				' 계좌명
	szData = szData & "|" & g_szCd											' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")				' 종목명
	szData = szData & "|" & ""												' 소액매매구분
	szData = szData & "|" & ""												' 소액매매구분데이타
	szData = szData & "|" & Grid0.GetCellData("bd_cell8", g_nGridClickedIdx)		' 시장구분2
	szData = szData & "|" & ""												' 매수일자
	szData = szData & "|" & edtQty.caption									' 주문수량
	
	szData = szData & "|" & edtPrc.caption									' 주문가격
	szData = szData & "|" & Grid0.GetCellData("bd_ordno", g_nGridClickedIdx)		' 주문번호
	szData = szData & "|" & ""												' 과세구분
	szData = szData & "|" & chkAll.checkstate								' 전량전부
	

	if Trim(szWarn) <> "" then
		szData = szData & "|" & szWarn								' 경고메세지
'		Form.OpenPopup("mbfnp54020_p9", szData , "")					' 경고팝업 오픈
		Form.OpenPopupAnimation("mbfnp54020_p20", szData , "","2")	
	else
		'20230720 htw end 경고창을 제외한 팝업에서만 사용함으로 if-else 안으로 옮김
		if g_OrderGubn == "0" then'정정
			Form.OpenPopupAnimation("mbfnp54020_p15", szData , "","2")		' 주문확인팝업 오픈
'			Form.OpenPopup("mbfnp54020_p3", szData , "")
			
		elseif g_OrderGubn == "1" then'취소
			Form.OpenPopupAnimation("mbfnp54020_p16", szData , "","2")		' 주문확인팝업 오픈
'			Form.OpenPopup("mbfnp54020_p4", szData , "")
		end if
	end if
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	g_szWarnFlag = "N"
	
	DATAMANAGER.RequestTranData("obtrs_oder_301a")
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acc", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function
'============================================================================
' 20160602 틱단위 수정
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn, szPM)
	Dim szPrc, szUnit
'	szUnit = "1"
	'NOHES 예외처리 : 마스터에서 bondunit 안오는 경우 디폴트값 "1"
	If Trim(szPM) == "" or Trim(szPM) == " " or Trim(szPM) == "0" Then
		szUnit = "1"
	Else
		szUnit = Trim(szPM)
	End If
	
	szPrc = edtPrc.caption

	CDbl decP2
	'20230122_01 HWG START : 거래소차세대 대응
	decP2 = Round(Cdbl(FormatNumber(szPrc, 2)) Mod Cdbl(FormatNumber(szPM, 2)),2) 'Round(CDbl(szPrc) Mod CDbl(szUnit), 2)
	'20230122_01 HWG END
	'decP2 = Round(CDbl(szPrc) Mod CDbl(szPM), 2)
	
	if Trim(szPrc) <> "" then
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			szPrc = CDbl(szPrc) + CDbl(szUnit) - decP2
					
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > 0 then'else
				If decP2 > 0 Then
					szPrc = CDbl(szPrc) - decP2
				Else
					szPrc = CDbl(szPrc) - CDbl(szUnit) - decP2
				End If
        		end if
		end if
		
		edtPrc.caption = szPrc
		edtPrc_OnEditComplete()
	end if

End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			nResult = CDbl(szQty) Mod nUnit
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = szQty - nUnit
				nResult = CDbl(szQty) Mod nUnit
				
				if nResult <> 0 then
					nResult = nUnit - nResult
					szQty = CDbl(szQty) + nResult
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	if Len(szData) < 16 then
		edtQty.caption = szData
		edtQty_OnEditComplete()
	end if
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "♥")
	
	if UBound(tData) > 0 then
	'tData = 주문번호/미체결수량/주문유형/주문가격/주문조건/구분자/종목코드
		' 메인화면에서 종목변경에 따른 구분자를 넣어준것
		if tData(5) == "1" then
			g_bCntrtRtn = true
		else
			g_bCntrtRtn = false
		end if	
	
		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", tData(0))
		end if
		
		'정정 취소 통합으로 하나의 shared로
		g_szQty = ""
		Form.SetSharedData("M_QTY", "")
		Form.SetSharedData("M_QCK", chkAll.checkstate)
		
		' 수량
'		if chkAll.checkstate == "1" then
'			edtQty.caption = ""						
'			g_szQty = tData(1)
'			Form.SetSharedData("M_QTY", g_szQty)
'		else
'			edtQty.caption = tData(1)
'			g_szQty = tData(1)
'			edtQty_OnEditComplete()
'		end if
		'정정 취소 통합으로 하나의 shared로
		
		
'		if tData(2) == "01" or tData(2) == "06" or tData(2) == "81" then	' 지정, 조건부, 시간외
'			' 주문가격
'			edtPrc.caption = tData(3)
'			edtPrc_OnEditComplete()
'		end if
'		
'		edtOrgNo.caption = tData(0)						' 주문번호
'		edtOrgNo_OnEditComplete()	
		szData = tData(6) &"★"& tData(0) &"★" & tData(3) & "★" & tData(1)
		g_tGetData = Split(szData,"★")'종목코드★주문번호★호가★미체결수량
				
		g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
		FormTab0.currenttab = 0
		Grid0.rowcount = 0
		DATAMANAGER.RequestTranData("obtrs_cntg_660r")
	end if
End Function


