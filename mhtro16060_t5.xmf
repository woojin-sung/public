						<CELL cell_ly="1,8,1,8" halign="0" line="1,0" caption="· 장 개시 5분전까지 주문/정정/취소 가능" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,9,1,9" halign="0" line="1,0" caption="· 시초가에 미체결시 주문 거부" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,10,1,10" halign="0" line="1,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,11,1,11" halign="0" line="1,0" caption="3. MOO (장개시 시장가) 주문" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,12,1,12" halign="0" line="1,0" caption="· 장 개시와 동시에 시장가로 주문 내 시초가로" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,13,1,13" halign="0" line="1,0" caption="  체결시키는 주문" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,14,1,14" halign="0" line="1,0" caption="· 장 개시 5분전까지 주문/취소 가능" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,15,1,15" halign="0" line="1,0" caption="· 매도만 가능" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,16,1,16" halign="0" line="1,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,17,1,17" halign="0" line="1,0" caption="4. LOC (장마감 지정가) 주문" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,18,1,18" halign="0" line="1,0" caption="· 장 마감과 동시에 종가가 지정한 가격보다" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,19,1,19" halign="0" line="1,0" caption="  같거나 유리하면 체결시키는 주문" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,20,1,20" halign="0" line="1,0" caption="· 장 마감 10분전까지 주문/정정/취소 가능" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="1,0" caption="· 장 중 가격이 주문 가격보다 유리해도," fontsize="-2" impidxs="" />
