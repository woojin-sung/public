						<CELL cell_ly="1,17,1,17" halign="0" line="1,0" caption="* 주간 거래 시간에 체결된 거래는 당일 T+2" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,18,1,18" halign="0" line="1,0" caption="Pre-market, 정규장, After-Market에 체결된" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,19,1,19" halign="0" line="1,0" caption="주식과 함께 T+2일 결제됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,20,1,20" halign="0" line="1,0" caption="* 주간거래 시세는 별도의 신청없이 실시간" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="1,0" caption="20호가가 제공되지만, 일부종목에 대해서는" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,22,1,22" halign="0" line="1,0" caption="시세호가가 제공되지 않으니 유의바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,23,1,23" halign="0" line="1,0" caption="* 전일 종가에 ±20%를 상회하는 주문은" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,24,1,24" halign="0" line="1,0" caption="거부될 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,25,1,25" halign="0" line="1,0" caption="* 주간거래는 정규장 대비 거래량이 적고," fontsize="-2" impidxs="" />
						<CELL cell_ly="1,26,1,26" halign="0" line="1,0" caption="가격변동이 크거나 가격이 불리할 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,27,1,27" halign="0" line="1,0" caption="* 주간거래 주문은 현지 거래소, 브로커 및" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,28,1,28" halign="0" line="1,0" caption="시세 벤더 등의 사유로 거부되거나 취소" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,29,1,29" halign="0" line="1,0" caption="될 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,30,1,30" halign="0" line="1,0" caption="* 주간거래는 별도의 약정이 필요하지 않으며," fontsize="-2" impidxs="" />
						<CELL cell_ly="1,31,1,31" halign="0" line="1,0" caption="기존 해외주식 거래신청이 되어 있는 경우" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,32,1,32" halign="0" line="1,0" caption="거래가 가능합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,33,1,33" halign="0" line="1,0" caption="* 당일 권리(분할, 병합, 티커변경, 거래소변경" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,34,1,34" halign="0" line="1,0" caption="등) 발생으로 해당종목에 대해 거래 정지가" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,35,1,35" halign="0" line="1,0" caption="될 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,36,1,36" halign="0" line="1,0" caption="* 주간거래의 휴장일은 정규장 휴장일과" fontsize="-2" impidxs="" />
