	<SCRIPT_INFO _len="922" _ulen="922" >
--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "ChangeTab" or sEventName == "ChangeCode" then
		
		Dim szNation
		
		szNation = Form.GetItemCodeInfo(sParam, "ovsnation")

		Container0.visible = "0"
		Container0.scroll_pos = "0"
		Container1.visible = "0"
		Container1.scroll_pos = "0"
		Container2.visible = "0"
		Container2.scroll_pos = "0"
		Container3.visible = "0"
		Container3.scroll_pos = "0"
		
		if szNation == "USA" then
			Container0.visible = "1"
		elseif szNation == "CHN" then
			Container1.visible = "1"
		elseif szNation == "HKG" then
			Container2.visible = "1"
		elseif szNation == "JPY" then
			Container3.visible = "1"
		end if
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>