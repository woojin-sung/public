						<CELL cell_ly="1,30,1,30" halign="0" line="1,0" caption="6. TWAP (장중시간분할) 주문" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,31,1,31" halign="0" line="1,0" caption="· 과거 거래시간을 분석하여 현지 브로커" fontsize="-2" impidxs="" />
