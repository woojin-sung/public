						<CELL cell_ly="1,38,1,38" halign="0" line="1,0" caption="* 주간거래 수수료는 정규장 미국주식 거래" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,39,1,39" halign="0" line="1,0" caption="수수료율과 동일하게 적용됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="1,40,1,40" halign="0" line="1,0" caption="* 주간거래는 정규장과 다른 이유로 거래의" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,41,1,41" halign="0" line="1,0" caption="불편함 또는 불리함이 있을 수 있습니다." fontsize="-2" impidxs="" />
