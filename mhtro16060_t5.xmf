						<CELL cell_ly="1,0,1,0" halign="0" line="1,0" caption="* 미국 주간거래는 FINRA(미국 금융산업규제 " fontsize="-2" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="1,0" caption="국)가 승인한 대체거래소(BOATS, Blue" fontsize="-2" impidxs="" />
