						<CELL cell_ly="1,38,1,38" halign="0" line="1,0" caption="· 과거 거래량을 분석하여 현지 브로커 자체" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,39,1,39" halign="0" line="1,0" caption="  기준으로 장중 시간별로 분할 체결하는" fontsize="-2" impidxs="" />
