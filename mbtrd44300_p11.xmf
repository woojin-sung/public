--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		Dim tData
		tData = Split(szData, "|")
		
		if UBOUND(tData) < 1 then
		    Exit sub
		End if
		
		' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
		if tData(0) = "0" then
			lblTitle.caption = "해외파생 매수주문"
			lblTitle.bgcolor = "92"
			tblData.SetCellFgColor(3, 0, "6")
			tblData.SetCellFgColor(3, 1, "6")
			tblData.SetCellFgColor(4, 0, "6")
			tblData.SetCellFgColor(4, 1, "6")
			btnOrder.btnimage = "btn_05.9"
			btnOrder.caption="매수"
			
		elseif tData(0) = "1" then
			lblTitle.caption = "해외파생 매도주문"
			lblTitle.bgcolor = "91"
			tblData.SetCellFgColor(3, 0, "7")
			tblData.SetCellFgColor(3, 1, "7")
			tblData.SetCellFgColor(4, 0, "7")
			tblData.SetCellFgColor(4, 1, "7")
			btnOrder.btnimage = "btn_06.9"
			btnOrder.caption="매도"
			
		elseif tData(0) = "2" then
			lblTitle.caption = "해외파생 정정주문"
			lblTitle.bgcolor = "93"
			tblData.SetCellFgColor(3, 0, "8")
			tblData.SetCellFgColor(3, 1, "8")
			tblData.SetCellFgColor(4, 0, "8")
			tblData.SetCellFgColor(4, 1, "8")
			btnOrder.btnimage = "btn_07.9"
			btnOrder.caption="정정"
			
		end if
		
		tblData.SetCellString( 0, 1, tData(1)) ' 계좌번호
		tblData.SetCellString( 0, 2, tData(2)) ' 고객명
		tblData.SetCellString( 1, 1, tData(3)) ' 종목코드
		tblData.SetCellString( 2, 1, tData(4)) ' 종목명
		tblData.SetCellString( 3, 1, tData(5)) ' 주문가격
		tblData.SetCellString( 4, 1, tData(6)) ' 조건가격
		tblData.SetCellString( 5, 1, tData(7)) ' 주문수량
		lblMsg.caption = tData(8) ' 경고메세지
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOrder_OnClick()
	Form.SendReturnToParent( "WARN_ODER" , "")
	Form.CloseForm( )
End Sub

