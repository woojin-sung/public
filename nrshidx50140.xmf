'============================================================================
' 필터설정 팝업 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "FILTER_SET_COMPLETE" then
	
		arrData = Split(sRet,"★")
		gFilterNationCode = arrData(0)
		gFilterSortingCode = arrData(1)
		
		'Form.ShowAlert(gFilterNationCode, gFilterSortingCode)
		
		RequestData("ohhts_metf_001r")
		
	'20240221 START
	elseif sKeyName == "GWAN_ADD_COMPLETE" then
		
		completeIndex = Cint(sRet)
		
		'처리행 관심종목 하트버튼 처리
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",completeIndex,"icon_like_o")
		
		' 판넬 관심등록여부 체크라벨 업데이트
		contBody.Pannel0.SetCellValue("LabelBodyIntrYN",completeIndex,"Y")
		
		'관심종목 리스트(메인에서 관리) 업데이트
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",completeIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",completeIndex)
		
		'ETF는 시장구분코드가 J밖에없어 이 값으로 국내/해외 구분
		if szMk == "J" then
			Form.addIntrItemList(szItemCode)
		else
			Form.addIntrItemList(szMk.."@"..szItemCode)
		end if
	
	elseif sKeyName == "GWAN_DELETE_COMPLETE" then
		
		completeIndex = Cint(sRet)
		
		'처리행 관심종목 하트버튼 처리
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",completeIndex,"icon_like_n")
		
		' 판넬 관심등록여부 체크라벨 업데이트
		contBody.Pannel0.SetCellValue("LabelBodyIntrYN",completeIndex,"N")
		
		'관심종목 리스트(메인에서 관리) 업데이트
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",completeIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",completeIndex)
		
		'ETF는 시장구분코드가 J밖에없어 이 값으로 국내/해외 구분
		if szMk == "J" then
			Form.delIntrItemList(szItemCode)
		else
			Form.delIntrItemList(szMk.."@"..szItemCode)
		end if
	
	'20240221 END
	
	end if
	
End Sub

'============================================================================
' 소수점 자리수 조정
'============================================================================
Function Decimal_Setting(sValue, sDecimalLen)
	
	if sDecimalLen == 0 then
		return Cint(sValue)
	end if

	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Function

'============================================================================
' 국가코드별 소수점자리 수
'============================================================================
Function GetNationDecimalLen(sNation)
	
	if sNation == "USA" then
		return 4
	elseif sNation =="KOR" then
		return 0
	elseif sNation =="HKG" then
		return 3
	elseif sNation =="CHN" then
		return 3
	elseif sNation =="JPN" then
		return 1
	else
		return 4
	end if
	
End Function

'============================================================================
' 국가코드별 국기이미지 명
'============================================================================
Function GetNationFlagName(sNation)
	
	if sNation == "USA" then
		return "flag_us2"
	elseif sNation =="KOR" then
		return "flag_kor_round"
	elseif sNation =="HKG" then
		return "flag_hk"
	elseif sNation =="CHN" then
		return "flag_chn"
	elseif sNation =="JPN" then
		return "flag_jp2"
	else
		return "flag_general"
	end if

End Function

'============================================================================
' 최근조회 종목 가져오기
'============================================================================
Function GetHistory()
	
	contBody.gridHistory.rowcount = 0
	sData = Form.manageTotalSearch(gETF_SUPER_HIS_KEY, "get", "")
	
	arrTotalData = Split(sData,"^") 
	
	'sData가 빈값인 경우 Split후 arrTotalData 사이즈가 1로 잡혀버려 
	'sData가 빈값인 경우 arrTotalData을 초기화하여 사이즈 0으로 만듬.
	if sData = "" then
		arrTotalData = Array()
	end if
	
	if #arrTotalData > 0 then
		
		'최근조회종목이 10종목 이상이면 10종목까지만 가져옴.
		if #arrTotalData > 10 then
		
			contBody.gridHistory.rowcount = 10
			
			for i = 0 to 9
				
				arrData = Split(arrTotalData(i),"@")
				szMk = arrData(0)
				szCode = arrData(1)
	
				contBody.gridHistory.SetCellData("bd_mk", i, szMk)
				contBody.gridHistory.SetCellData("bd_code", i, szCode)
			
			next
			
		else
			
			if #arrTotalData > 0 then
				
				contBody.gridHistory.rowcount = #arrTotalData
			
				for i = 0 to #arrTotalData -1
					
					arrData = Split(arrTotalData(i),"@")
					szMk = arrData(0)
					szCode = arrData(1)
					
					contBody.gridHistory.SetCellData("bd_mk", i, szMk)
					contBody.gridHistory.SetCellData("bd_code", i, szCode)
				
				next
			
			
			end if
		
		
		end if
	
	end if
	
	RequestData("ohhts_metf_020r")
	
	

End Function

'============================================================================
' 최근조회 종목 삭제하기
'============================================================================
Function DeleteHistory(bAll,nIndex)
	
	if bAll then
		Form.manageTotalSearch(gETF_SUPER_HIS_KEY, "clear", "")
		contBody_BtnEdit_OnClick()
		
	else
		sMk = contBody.gridHistory.GetCellData("bd_mk", nIndex)
		sCode = contBody.gridHistory.GetCellData("bd_code", nIndex)
	
		if sMk <> "" and sCode <> "" then
			Form.manageTotalSearch(gETF_SUPER_HIS_KEY, "delete", sMk.."@"..sCode)
			contBody.Pannel0.DeleteRow(nIndex)
		end if
		
	end if
	
	GetHistory()	

End Function

