	<SCRIPT_INFO _len="49685" _ulen="45171" >
Dim gOsType				'OS타입
Dim gPannelIndex 			'현재 판넬 인덱스값
Dim gWidePannelIndex 		'펼쳐보기한 판넬 인덱스값

Dim gFoldPannelHeight		'펼쳐보기 시 판넬 행높이
Dim gUnFoldPannelHeight	'평상 시 판넬 행높이

Dim gEditMode				'종목편집 모드여부
Dim gCompareMode 			'종목비교 모드여부

Dim gContUpPos			'위로 스크롤 시 컨테이너 top값
Dim gContDownPos			'아래로 스크롤 시 컨테이너 top값

Dim gCompareItemIndex1 	'선택종목1
Dim gCompareItemIndex2		'선택종목2
Dim gCompareBtnShow		'비교하기버튼 보임여부

Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gFilterNationCode
Dim gFilterSortingCode

Dim gETF_SUPER_HIS_KEY
gETF_SUPER_HIS_KEY = "ETF_SUPER_HISTORY"

'============================================================================
Sub Form_OnFormInitBefore()
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		contBody.BtnCompare.fontsize = - Cint((gsLargeFontsize * 2))
		contBody.BtnEdit.fontsize = - Cint((gsLargeFontsize * 2))
		contBody.LabelFilter.fontsize = -3 - Cint((gsLargeFontsize * 2))
		
	end if	

	'--------------------------------------------------------------
	'OS타입
	'--------------------------------------------------------------
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	
	'--------------------------------------------------------------
	'판넬관련 전역변수 설정 
	'--------------------------------------------------------------
	
	'행 펼쳤을때/접혔을때 높이값 설정
	if gOsType == "1" then
		gFoldPannelHeight = 174
		gUnFoldPannelHeight = 103
	else
		gFoldPannelHeight = 174
		gUnFoldPannelHeight = 102
	end if
	
	gPannelIndex = 0
	gWidePannelIndex = -1
	gCompareMode = false
	gEditMode = false
	
	'--------------------------------------------------------------
	' 스크롤관련 전역변수 설정
	'--------------------------------------------------------------
	'위/아래 스크롤 시 컨테이너 top값 지정
	gContUpPos = 0
	gContDownPos = 256
	
	'--------------------------------------------------------------
	' 종목비교관련  전역변수 설정
	'--------------------------------------------------------------
	gCompareItemIndex1 = -1
	gCompareItemIndex2 = -1
	gCompareBtnShow = false
	
	'--------------------------------------------------------------
	' 필터(조회국가/정렬기준) 관련 전역변수 설정 
	'--------------------------------------------------------------
	gFilterNationCode = "Y@N@N@N@N@N"
	gFilterSortingCode = "-1"
		
End Sub

'============================================================================
Sub Form_OnFormInit()

	'(iOS전용) 판넬컨트롤 렌더링 오류 수정
	contBody.Pannel0.setDataNormal(true)
	
	'-------------------------------------------------------
	' 데이터영역 컨트롤 설정
	'-------------------------------------------------------
	contBody.LabelSearchResultCnt.paddinginfo = "0,0,0,0"
	contBody.LabelSearchResultCnt.fgcolor = 321
	
	contBody.LabelAllRemove.paddinginfo = "0,0,0,0"
	contBody.LabelAllRemove.fgcolor = 321
	
	contBody.LabelFilter.paddinginfo = "0,0,0,0"
	
	'20240221 START
	'관심종목리스트 조회
	Form.requestIntrItemList("00")
	
	'최근조회 목록 가져오기
	GetHistory()
	
	'Form.SetSharedData("ETF_SUPER_SEARCH_INDEX" , "")
	Form.SetSharedData("50100_INDEX" , "")
	
End Sub

'============================================================================
'
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub

'============================================================================
'
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_metf_020r" then
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_020r", "OutBlock1")
	
		for i = 0 to nCnt - 1
			
			'--------------------------
			'데이터 가져오기
			'--------------------------
			sCode 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_OVRS_ISCD" , i)
			sName 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FIDX_KOR_ISNM" , i)
			sPrice 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_PRPR" , i)
			sDebi 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_PRDY_CTRT" , i)
			sVol 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_VOL" , i)
			sBosu 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_TOTAL_PAY_RATE" , i)
			sNAV 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FIDX_NAV" , i)
			
			sNation 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_LSTN_NTNL_CODE" , i)
			sMarket  = DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i)
			
			sNew		= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_NEW_LSTN_YN" , i)
			sTrht	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_TRHT_YN", i)
			sSign 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_020r", "OutBlock1", "FID_PRDY_VRSS_SIGN" , i)
			
			

			'--------------------------
			'바디데이터 행 생성 및 컨트롤 위치조정
			'--------------------------
			contBody.Pannel0.AddRow()
			ChangeControlPosAndRowHeight(1,i + gPannelIndex)
			
			
			'--------------------------
			'바디데이터 입력
			'--------------------------
			'국가
			sNationFlagName = GetNationFlagName(sNation)
			contBody.Pannel0.setPropCardCell("imgpath","ImageFlag",i + gPannelIndex,sNationFlagName)
			
			'시장구분코드
			contBody.Pannel0.SetCellValue("LabelBodyMarket",i + gPannelIndex,sMarket)
			
			'종목명
			contBody.Pannel0.SetCellValue("LabelName",i + gPannelIndex,sName)
			
			'종목코드(티커)
			contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sCode)
			contBody.Pannel0.SetCellValue("LabelBodyTicker",i + gPannelIndex,sCode)
			
			'현재가
			nDecimalLen = GetNationDecimalLen(sNation)
			sPrice = FormatNumber(sPrice,nDecimalLen)
			contBody.Pannel0.SetCellValue("LabelHyun",i + gPannelIndex,sPrice.." | "..sDebi.."%")
						
			'등락률(현재가 라벨과 통합)
			'contBody.Pannel0.SetCellValue("LabelDebi",i + gPannelIndex,sDebi)
			
			'--------------------------
			'현재가/등락률 색상표시
			'--------------------------
			if sSign == "2" then '상승
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"290")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"290")
			elseif sSign == "5" then '하락
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"291")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"291")
			else '보합
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"333")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"333")
			end if
			
			
			'보수
			if Cdbl(sBosu) == 0 then
				sTransBosu = "-"
			else
				'sTransBosu = Decimal_Setting(sBosu,2) .. "%"
				sTransBosu = sBosu .. "%"
			end if
			contBody.Pannel0.SetCellValue("LabelBosuData",i + gPannelIndex,sTransBosu)
			
			'NAV
			if Cdbl(sNAV) == 0 then
				sTransNAV = "-"
			else
				'sTransNAV = Decimal_Setting(sNAV,2)
				sTransNAV = FormatNumber(sNAV,2)
			end if
			contBody.Pannel0.SetCellValue("LabelNAVData",i + gPannelIndex,sTransNAV)
			
			'거래량
			contBody.Pannel0.SetCellValue("LabelVolData",i + gPannelIndex,sVol)
			
			'거래정지
			if sTrht == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | " .. "거래정지"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'신규상장 여부
			if sNew == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | " .. "신규상장"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'관심종목/체크 이미지 세팅
			if gCompareMode then
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"checkmenu_n")
			elseif gEditMode then
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_remove")
				
				'20240221 START
				'국내=종목코드 / 해외=거래소구분@종목코드
				bReg = false
				if sNation == "KOR" then
					bReg = Form.isIntrItemList(sCode)
				else
					bReg = Form.isIntrItemList(sMarket.."@"..sCode)
				end if
				
				if bReg then
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"Y")
				else
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"N")
				end if
				'20240221 END
				
			else
			
				'20240221 START
				'국내=종목코드 / 해외=거래소구분@종목코드
				bReg = false
				if sNation == "KOR" then
					bReg = Form.isIntrItemList(sCode)
				else
					bReg = Form.isIntrItemList(sMarket.."@"..sCode)
				end if
				
				if bReg then
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"Y")
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_like_o")
				else
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"N")
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_like_n")
				end if
				'20240221 END
				
			end if
			
		
		next
		
		CheckDataCnt(Cint(contBody.Pannel0.rowcount))
	
	end if

	
End Sub

'============================================================================
' 판넬컨트롤 스크롤 완료 시
'============================================================================
Sub contBody_Pannel0_OnScrollEnd()

'	if DATAMANAGER.IsMoreNextData("ohhts_metf_001r") then
'		gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
'		DATAMANAGER.RequestNextData( "ohhts_metf_001r" )
'	end if 
	
End Sub

'============================================================================
'
'============================================================================
Sub contBody_Pannel0_OnClick(nIndex, sCellID)


		'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
		
			'관심종목등록/종목비교 체크버튼 이 아닌 경우에는 행을 펼침
			'ButtonIntrCheck => 하트/체크이미지를 너무 정확하게 눌러야되서 근처영역 클릭 시 동작할 수 있게 버튼하나 올림
			if sCellID <> "ImageIntrCheck" and sCellD <> "LabelDebi" and sCellID <> "ButtonIntrCheck" then
				gWidePannelIndex = nIndex
				foldBottomLinkArea(nIndex,gFoldPannelHeight)
			
			else
			
				'종목비교모드 and 종목편집모드가 아니면 관심종목 등록 버튼 클릭 시 관심종목 추가팝업 오픈
				if gCompareMode <> true then
					
					if gEditMode then
						
						DeleteHistory(false,nIndex)
						
					else
						
						szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
						szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
						'20240221 START 등록완료 후 몇번째 행을 처리했는지 리턴받기 위해 넘김.
						sReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",nIndex)
						
						if sReg == "Y" then
							sParam = "DEL" .. "★" .. nIndex
							'Form.OpenPopupAnimation("nrshidx50600_p4", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목삭제
							
							if szMk == "J" then
								Form.OpenPopup("nrshidx50600_p4" , szItemCode& "★"& sParam , "")
							else
								Form.OpenPopup("nrshidx50600_p4" , szMk.."@"..szItemCode& "★"& sParam , "")
							end if
							
						else
							sParam = "ADD" .. "★" .. nIndex
							
							if szMk == "J" then
								Form.OpenPopupAnimation("nrshidx50600_p2", szItemCode& "★"& sParam,"", "2")	'종목등록
							else
								Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목등록
							end if
								
						end if
						'20240221 END
					
					end if
					
					
				
				'종목비교모드라면 선택행 체크(단 최대 2개까지만 선택가능)
				else
					
					SetCompareItem(nIndex)
				
				end if
				
			end if
		
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			'링크버튼or관심종목 등록 영역 클릭 시(접히면 안되는 경우임)
			'ButtonIntrCheck => 하트/체크이미지를 너무 정확하게 눌러야되서 근처영역 클릭 시 동작할 수 있게 버튼하나 올림
			if isLinkButton(sCellID) then
				
				if sCellID == "ImageIntrCheck" or sCellID == "LabelDebi" or sCellID == "ButtonIntrCheck" then
					
					'종목비교모드 and 종목편집모드가 아니면 관심종목 추가팝업 오픈
					if gCompareMode <> true then
						
						if gEditMode then
						
							DeleteHistory(false,nIndex)
						
						else
						
							szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
							szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
							'20240221 START 등록완료 후 몇번째 행을 처리했는지 리턴받기 위해 넘김.
						sReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",nIndex)
						
						if sReg == "Y" then
							sParam = "DEL" .. "★" .. nIndex
							'Form.OpenPopupAnimation("nrshidx50600_p4", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목삭제
							
							if szMk == "J" then
								Form.OpenPopup("nrshidx50600_p4" , szItemCode& "★"& sParam , "")
							else
								Form.OpenPopup("nrshidx50600_p4" , szMk.."@"..szItemCode& "★"& sParam , "")
							end if
							
							
						else
							sParam = "ADD" .. "★" .. nIndex
							
							if szMk == "J" then
								Form.OpenPopupAnimation("nrshidx50600_p2", szItemCode& "★"& sParam,"", "2")	'종목등록
							else
								Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목등록
							end if
							
						end if
						'20240221 END
						
						end if
												
					
					'종목비교모드라면 선택행 체크(단 최대 2개까지만 선택가능)
					else
						
						SetCompareItem(nIndex)
					
					end if
					
				'화면링크버튼 클릭 시, 히스토리 리스트에 쌓는다.
				elseif sCellID == "ButtonLink0" then '현재가
					
					MoveScreen("hyun",nIndex)
				
				elseif sCellID == "ButtonLink1" then '차트
				
					MoveScreen("chart",nIndex)
				
				elseif sCellID == "ButtonLink2" then '종목정보
				
					MoveScreen("info",nIndex)
				
				elseif sCellID == "ButtonLink3" then '매수
				
					MoveScreen("mesu",nIndex)
				
				elseif sCellID == "ButtonLink4" then '매도
				
					MoveScreen("medo",nIndex)
					
				end if
				
				
			'링크버튼 외 영역 클릭 시(접혀도 되는 경우임)
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
				
				end if
			
			
			end if
			
		end if
		
		
	

	
End Sub


'============================================================================
' 종목정보 서비스 호출
'============================================================================
Function RequestData(szTranID)

	if szTranID == "ohhts_metf_020r" then
	
		DATAMANAGER.ClearInputData(0, "ohhts_metf_020r")
		
		SetDefaultGlobalVariable()
		contBody.Pannel0.rowcount = 0
		
		nCnt = Cint(contBody.gridHistory.rowcount)
		
		
		for i = 0 to nCnt - 1
		
			sItemCode = contBody.gridHistory.GetCellData("bd_code", i)
			sMkCode 	 = contBody.gridHistory.GetCellData("bd_mk", i)
						
			DATAMANAGER.SetDataValue( 0, "ohhts_metf_020r", "InBlock1", "FID_INPUT_OVRS_ISCD",	i,  sItemCode)
			DATAMANAGER.SetDataValue( 0, "ohhts_metf_020r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i,  sMkCode)
			
			'0:지연 / 1:실시간
			sRealSiseYN = GetRealTimeSiseYN(sMkCode)
			
			if sRealSiseYN == "" then
				sRealSiseYN = "0" 
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_metf_020r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , i , sRealSiseYN)
			
		
		next
		
		DATAMANAGER.RequestTranData("ohhts_metf_020r")
	
	end if


End Function

'============================================================================
'
'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
' 선택행 링크영역 펼치기
'============================================================================
Function foldBottomLinkArea(nIndex,nHeight)
	
	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","ImageBottomLinkBG",nIndex,"100") 
	contBody.Pannel0.setPropCardCell("top","ButtonLink0",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink1",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink2",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink3",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink4",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"173")
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"1")
	
	'마지막행 클릭 시 스크롤 자동 이동
	nLastIndex = contBody.Pannel0.rowcount - 1
	
	if nIndex ==  nLastIndex then
		contBody.Pannel0.toprow = nIndex
	end if

End Function

'============================================================================
' 선택행 링크영역 접기
'============================================================================
Function unfoldBottomLinkArea(nIndex,nHeight)

	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"101")
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
End Function

'============================================================================
' 판넬클릭 시, 링크버튼 + 관심종목 버튼 클릭 여부 확인
'============================================================================
Function isLinkButton(sCellID)
	
	if sCellID == "ButtonLink0" or sCellID == "ButtonLink1" or sCellID == "ButtonLink2" or sCellID == "ButtonLink3" or sCellID == "ButtonLink4" or sCellID == "ImageIntrCheck" or sCellID == "LabelDebi" or sCellID == "ButtonIntrCheck" then
		return true
	else
		return false
	end if

End Function

'============================================================================
' 조회건수에 따라 컨트롤 위치조정 
'============================================================================
Function CheckDataCnt(nCnt)
	
	if nCnt > 0 then
	
		contBody.LabelSearchResultCnt.visible = true
		contBody.BtnEdit.visible = true
		contBody.BtnCompare.visible = true
		
		contBody.separator0.visible = true
		contBody.Pannel0.visible = true
		contBody.Pannel0.left = 0
		
		contBody.lbNoticeMsg.visible = false
		contBody.imgNotice.visible = false
		
		contBody.lbNoticeMsg.left = 500
		contBody.imgNotice.left = 500
		
	else
				
		contBody.LabelSearchResultCnt.visible = false
		contBody.BtnEdit.visible = false
		contBody.BtnCompare.visible = false
	
		contBody.separator0.visible = false
		contBody.Pannel0.visible = false
		contBody.Pannel0.left = 500
		
		contBody.lbNoticeMsg.visible = true
		contBody.imgNotice.visible = true
		
		contBody.lbNoticeMsg.left = 84
		contBody.imgNotice.left = 160
		
		if gEditMode then
			contBody_BtnEdit_OnClick()
		elseif gCompareMode then
			contBody_BtnCompare_OnClick()
		end if
		
		
		
		
	end if

End Function

'============================================================================
' 종목편집 버튼 클릭이벤트
'============================================================================
Sub contBody_BtnEdit_OnClick()

	'종목편집모드 ON -> OFF
	if gEditMode then
	
		gEditMode = false
		
		contBody.BtnEdit.fgcolor = 333
		contBody.BtnEdit.fontstyle = "00"
		contBody.BtnEdit.caption ="편집"
		contBody.BtnEdit.singleimage = "btn_line2_n.9"
	
		'판넬위치/높이 조정
		contBody.Pannel0.top = 53
		contBody.Pannel0.height = 558
		
		'전체삭제버튼 숨김
		contBody.LabelAllRemove.visible = false
		
		ChangeIntrCehckImage("2")
	
	'종목편집모드 OFF -> ON
	else
	
		gEditMode = true
		
		contBody.BtnEdit.fgcolor = 334
		contBody.BtnEdit.fontstyle = "01"
		contBody.BtnEdit.caption ="편집해제"
		contBody.BtnEdit.singleimage = "btn_line2_o.9"
	
		'판넬위치/높이 조정
		contBody.Pannel0.top = 90
		contBody.Pannel0.height = 521
		
		'전체삭제버튼 보임
		contBody.LabelAllRemove.visible = true
		
		
		'종목비교/초기화 버튼 SHOW -> HIDE
		if gCompareBtnShow then
			SetShowCompareButton(false)
		end if
	
		gCompareMode = false
		
		contBody.BtnCompare.fgcolor = 338
		contBody.BtnCompare.caption = "종목비교"
		contBody.BtnCompare.btnimage = "btn_36.9"
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
		ChangeIntrCehckImage("3")
	
	end if
	
End Sub


'============================================================================
' 종목비교 버튼 클릭이벤트
'============================================================================
Sub contBody_BtnCompare_OnClick()
	
	'종목비교모드 OFF
	if gCompareMode then
	
		'종목비교/초기화 버튼 SHOW -> HIDE
		if gCompareBtnShow then
			SetShowCompareButton(false)
		end if
	
		gCompareMode = false
		
		contBody.BtnCompare.fgcolor = 338
		contBody.BtnCompare.caption = "종목비교"
		contBody.BtnCompare.btnimage = "btn_36.9"
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
		ChangeIntrCehckImage("2")
	
	'종목비교모드 ON
	else
	
		'편집모드 변수 변경
		gEditMode = false
		
		contBody.BtnEdit.fgcolor = 333
		contBody.BtnEdit.fontstyle = "00"
		contBody.BtnEdit.caption ="편집"
		contBody.BtnEdit.singleimage = "btn_line2_n.9"

		
		'판넬위치/높이 조정
		contBody.Pannel0.top = 53
		contBody.Pannel0.height = 558
		
		'전체삭제버튼 숨김
		contBody.LabelAllRemove.visible = false
		
		gCompareMode = true
		
		contBody.BtnCompare.fgcolor = 326
		contBody.BtnCompare.caption = "비교해제"
		contBody.BtnCompare.btnimage = "btn_42.9"
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
		ChangeIntrCehckImage("1")	
	
	end if

	
End Sub

'============================================================================
' 판넬 데이터행 버튼이미지 변환
'sType 
'1: 관심종목 등록버튼 => 체크 버튼
'2: 체크버튼 => 관심종목 등록버튼
'3: 관심종목 or 체크버튼 => 삭제버튼 
'============================================================================
Function ChangeIntrCehckImage(sType)

	dataCnt = Cint(contBody.Pannel0.rowcount)
	
	if dataCnt > 0 then
	
		if sType == "1" then
		
			for i= 0 to dataCnt - 1
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"checkmenu_n")
			next
			
		elseif sType == "2" then
		
			for i= 0 to dataCnt - 1
			
				'20240221 START
				sIntrReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",i)
				if sIntrReg == "Y" then
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"icon_like_o")
				else
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"icon_like_n")
				end if
				'20240221 END
				
			next
			
		else
		
			for i= 0 to dataCnt - 1
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"icon_remove")
			next
		
		end if
		
	end if

End Function

'============================================================================
' 데이터행 높이 및 컨트롤 위치 조정
' sType 1:(기본)접힌상태 2:펼침상태
'============================================================================
Function ChangeControlPosAndRowHeight(nType,nIndex)

	if nType == 1 then
	
		'종목명
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelName",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("fontsize","LabelName",nIndex,"0")
		contBody.Pannel0.setPropCardCell("maxlinecnt","LabelName",nIndex,"1^-4")
		
		'종목코드(티커)
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelCode",nIndex,"0,0,0,0")
		
		'현재가
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHyun",nIndex,"0,0,0,0")
			
		'등락률
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelDebi",nIndex,"0,0,0,0")
			
		'보수
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelBosuTitle",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelBosuData",nIndex,"0,0,0,0")
			
		'NAV
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelNAVTitle",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelNAVData",nIndex,"0,0,0,0")
			
		'거래량
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelVolTitle",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelVolData",nIndex,"0,0,0,0")
		
		'구분선
		contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"101")	
		contBody.Pannel0.SetCardWHAt(nIndex,gUnFoldPannelHeight)
		
		'큰글씨 사용모드일때 폰트크기 대응
		if gbLargeFont then
		
			'기본폰트크기(-3) - (큰글씨 설정값 * 2)
			'큰글씨 설정값 = 1:조금 크게 / 2 : 크게
			sTransFontsize = Cstr( -3 - (Cint(gsLargeFontsize) * 2))
					
			'보수
			contBody.Pannel0.setPropCardCell("fontsize","LabelBosuTitle",nIndex,sTransFontsize)
			contBody.Pannel0.setPropCardCell("fontsize","LabelBosuData",nIndex,sTransFontsize)
			
			'NAV
			contBody.Pannel0.setPropCardCell("fontsize","LabelNAVTitle",nIndex,sTransFontsize)
			contBody.Pannel0.setPropCardCell("fontsize","LabelNAVData",nIndex,sTransFontsize)
			
			'거래량
			contBody.Pannel0.setPropCardCell("fontsize","LabelVolTitle",nIndex,sTransFontsize)
			contBody.Pannel0.setPropCardCell("fontsize","LabelVolData",nIndex,sTransFontsize)
			
		end if
		
		
	else
		contBody.Pannel0.SetCardWHAt(nIndex,gFoldPannelHeight)
	end if

End Function

'============================================================================
'
'============================================================================
Sub contBody_LabelFilter_OnClick()
	OpenPopupCond()
End Sub

'============================================================================
'
'============================================================================
Sub contBody_Image0_OnClick()
	OpenPopupCond()
End Sub
'============================================================================
' 키워드가 선택되있는 경우에는 조회국가 선택 숨겨야하므로 "1" 로 올림
'============================================================================
Function OpenPopupCond()
	
	if gKeywordIndex < 0 then
		Form.OpenPopupAnimation("nrshidx50120_p1", "2".."★"..gFilterNationCode .. "★".. gFilterSortingCode, "", "2")
	else
		Form.OpenPopupAnimation("nrshidx50120_p1", "1".."★"..gFilterNationCode .. "★".. gFilterSortingCode, "", "2")
	end if
	
	
End Function 

'============================================================================
'
'============================================================================
Function SetCompareItem(nIndex)
	
	'선택된 아이템 개수가 최대가능 개수인 경우
	if gCompareItemIndex1 > -1 and gCompareItemIndex2 > -1 then
		
		'첫번째 선택 아이템이랑 동일한 아이템이 또 들어온 경우
		'두번째 아이템을 첫번째로 옮겨주고, 기존 첫번째 아이템 체크 해제 , 두번째 아이템 클리어
		if gCompareItemIndex1 == nIndex then
			gCompareItemIndex1 = gCompareItemIndex2
			gCompareItemIndex2 = -1
			contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_n")
		
		'두번째 선택 아이템이랑 동일한 아이템이 또 뜰어온 경우
		'두번째 아이템 체크해제, 두번째 아이템 클리어
		elseif gCompareItemIndex2 == nIndex then
			gCompareItemIndex2 = -1
			contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_n")
		
		'첫번째/두번째 아이템과 다른 아이템이 들어온 경우
		'최대개수 초과 팝업 발생
		else
			
			Form.ShowAlert("알림", "최대 2개 종목만 선택 가능합니다.")
		
		end if
	
	'선택된 아이템 개수가 최대가능 개수보다 적을 경우
	else
		
		'첫번째 아이템이 들어가있는 경우
		if gCompareItemIndex1 > -1 then
			
			'첫번째 아이템과 동일한 아이템인지 체크
			'동일한 아이템이면 체크해제 및 아이템 클리어
			if gCompareItemIndex1 == nIndex then
				gCompareItemIndex1 = -1
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_n")
			
			'첫번째 아이템과 다른 아이템이면
			'두번째 아이템에 담아줌.
			else
				gCompareItemIndex2 = nIndex	
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_o")
			end if
		
		
		'첫번째/두번째 아이템이 모두 비어있는 경우
		'첫번째 아이템에 담아줌.
		else
			gCompareItemIndex1 = nIndex
			contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",nIndex,"checkmenu_o")
		end if
		
	end if
	
	
	'선택되어있는 종목이 있으면 비교하기 버튼 show
	if gCompareItemIndex1 > -1 or gCompareItemIndex2 > -1 then
		SetShowCompareButton(true)
	else
		SetShowCompareButton(false)
	end if
	
	
	
End Function

'================================================================================
' 종목비교 모드, 종목선택 후 하단 종목비교/초기화 버튼 생성 및 컨트롤 사이즈 조정
'================================================================================
Function SetShowCompareButton(bShow)

	'종목비교모드인 상태
	if gCompareMode then
		
		'종목비교/초기화 버튼 SHOW
		if bShow then
			
			btnReset.visible = true
			btnOk.visible = true
			
			'종목비교/초기화 버튼 보임처리
			'컨테이너/판넬 높이값 조정, 종목비교/초기화 버튼 top값 지정
			if gCompareBtnShow <> true then
				gCompareBtnShow = true
				
				contBody.height = contBody.height - 60
				contBody.Pannel0.height = contBody.Pannel0.height - 60
				contBody.SetScrollAutoSize()
				
				btnReset.top = contBody.top + contBody.height 
				btnOk.top = contBody.top + contBody.height 
				
				
			end if
		
		'종목비교/초기화버튼 HIDE
		else
			
			'종목비교/초기화 버튼 숨김처리
			'컨테이너/판넬 높이값 조정, 종목비교/초기화 버튼 top값 지정
			gCompareBtnShow = false
			
			contBody.height = contBody.height + 60
			contBody.Pannel0.height = contBody.Pannel0.height + 60
			contBody.SetScrollAutoSize()
			
			btnReset.visible = false
			btnOk.visible = false
		
		end if
			
	end if

End Function

'============================================================================
' 비교종목 초기화
'============================================================================
Sub btnReset_OnClick()

	if gCompareMode then
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",gCompareItemIndex1,"checkmenu_n")
		contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",gCompareItemIndex2,"checkmenu_n")
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
	end if
	
End Sub

'============================================================================
' 비교하기
'============================================================================
Sub btnOk_OnClick()

	if gCompareMode then
		'Form.ShowAlert("선택행", gCompareItemIndex1.."//"..gCompareItemIndex2)
		if gCompareItemIndex1 < 0 or gCompareItemIndex2 < 0 then
			Form.ShowAlert("안내", "비교할 종목을 선택해주세요.")
		else
			
			sCompareItemName1 	= contBody.Pannel0.GetCellValue("LabelName"			,gCompareItemIndex1)
			sCompareItemCode1 	= contBody.Pannel0.GetCellValue("LabelBodyTicker"		,gCompareItemIndex1)
			sCompareItemMarket1 	= contBody.Pannel0.GetCellValue("LabelBodyMarket"		,gCompareItemIndex1)
			
			sCompareItemName2 	= contBody.Pannel0.GetCellValue("LabelName"			,gCompareItemIndex2)
			sCompareItemCode2 	= contBody.Pannel0.GetCellValue("LabelBodyTicker"		,gCompareItemIndex2)
			sCompareItemMarket2 	= contBody.Pannel0.GetCellValue("LabelBodyMarket"		,gCompareItemIndex2)
			
			Form.OpenPopupAnimation("nrshidx50150", sCompareItemName1.."★"..sCompareItemMarket1.."★"..sCompareItemCode1.."@"..sCompareItemName2.."★"..sCompareItemMarket2.."★"..sCompareItemCode2, "", "2")
			
		end if
		
		
	end if
	
End Sub

