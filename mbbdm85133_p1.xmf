<ROOT>
	<MAP_INFO scrname="계좌정보 입력(개별추가)_예외팝업" version="2" writer="이은섭" />
	<FORM_INFO name="Form" transmode="0" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBg" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBox" imgpath="popup_bg_common.9" ly_vert="31,90,314,450,1" />
		<IMAGE name="imgBgTitle" imgpath="pop_header.9" ly_vert="31,105,314,40,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="안내" halign="1" ly_vert="51,90,273,60,1" />
		<IMAGE name="imgClose" imgpath="icon_main_13" ly_vert="308,105,21,21,1" />
		<CONTAINER name="contContent" scroll_pos="0,0" ly_vert="31,160,314,302,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblContent0" fontsize="-1" multiline="1" ly_vert="20,0,283,22,1" />
				<LABEL name="lblContent1" visible="0" fontsize="-1" multiline="1" ly_vert="20,40,283,22,0" />
				<LABEL name="lblContent2" visible="0" fontsize="-1" multiline="1" ly_vert="20,80,283,22,0" />
				<LABEL name="lblContent3" visible="0" fontsize="-1" multiline="1" ly_vert="20,120,283,22,0" />
				<LABEL name="lblContent4" visible="0" fontsize="-1" multiline="1" ly_vert="20,160,283,22,0" />
				<LABEL name="lblContent5" visible="0" fontsize="-1" multiline="1" ly_vert="20,200,283,22,0" />
				<IMAGE name="imgdot0" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,0,18,18,0" />
				<IMAGE name="imgdot1" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,40,18,18,0" />
				<IMAGE name="imgdot2" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,80,18,18,0" />
				<IMAGE name="imgdot3" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,120,18,18,0" />
				<IMAGE name="imgdot4" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,160,18,18,0" />
				<IMAGE name="imgdot5" visible="0" autosize="1" imgpath="icon_dot.png" ly_vert="10,200,18,18,0" />
			</CONTROL_INFO>
		</CONTAINER>
		<BUTTON name="btnCancle" fontsize="2" fontstyle="01" btnimage="btn_25.9" ly_vert="31,480,158,60,1" />
		<BUTTON name="btnNext" fontsize="2" fontstyle="01" btnimage="btn_26.9" ly_vert="189,480,158,60,1" />
		<LABEL name="lblCancle" caption="취소" halign="1" multiline="1" ly_vert="31,480,158,60,1" />
		<LABEL name="lblNext" fgcolor="062:255255255" caption="확인" halign="1" multiline="1" ly_vert="189,480,158,60,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="5475" _ulen="5205" >
'============================================================================
' 2022.03.16: 김수진 : 계좌정보 입력(개별추가)_예외팝업
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szRetKeyNm			' Return KeyName
Dim g_szRet				' Return 값
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()
	imgBg.imgpath = "alpha128.png" 
	lblCancle.fgcolor = 269
	g_szRetKeyNm = ""
	g_szRet = ""				
	
	'szData : KeyName★타이틀명★버튼 개수★버튼넓이(Left)★버튼명(Left)★버튼명(Right)★안내문 정렬★총 안내문 수★안내문 줄 수★imgdot 사용여부★안내내용
	Dim szData
	szData = Trim(Form.GetOpenLinkData())
 	
	If szData <> "" and szData <> null Then
		Dim tList
		tList = Split(szData, "★")
		
		if UBOUND(tList) < 1 then
			exit sub
		end if

		'리턴 키값, 팝업 타이틀 설정----------------------------------
		g_szRetKeyNm = Trim(tList(0))
		g_szRet = ""
		lblTitle.caption = Trim(tList(1))
		
		'버튼 설정----------------------------------------------------
		'2022.03.24 아이폰에서 버튼 캡션 스크립트로 설정시 멀티라인 적용x > 라벨 사용
		If tonumber(tList(2)) == 2 Then
			btnNext.visible = true
			lblNext.visible = true
			If Trim(tList(3)) <> null and Trim(tList(3)) <> "" Then
				btnCancle.width = tonumber(tList(3))
				btnNext.left = 31 + tonumber(tList(3)) 	
				btnNext.width = 314 - tList(3)			'314 : imgBox.width
				
				lblCancle.width = tonumber(tList(3))
				lblNext.left = 31 + tonumber(tList(3)) 	
				lblNext.width = 314 - tList(3)			'314 : imgBox.width				
			Else
				btnCancle.width = 158
				lblCancle.width = 158
			End If
			lblCancle.caption = Trim(tList(4))
			lblNext.caption = tList(5)
		Else
			btnCancle.width = 314
			btnNext.visible = false
			lblCancle.width = 314
			lblNext.visible = false			
			
			lblCancle.caption = tList(4)
		End If
		
		'Contents 설정------------------------------------------------	
		Dim nCount, nLine, nTop
		nCount = tonumber(tList(7))	'안내 내용 갯수
		nTop = 0
		For i = 0 to nCount-1
			nLine = tonumber(tList(i*3+8))
			
			Form.SetCtlProp( "contContent.lblContent"..i, "height", 15*nLine+7)
			nTop = nTop + (15*nLine+7) +10
			If i <> nCount-1 Then
				Form.SetCtlProp( "contContent.lblContent"..i+1, "top", nTop)
				Form.SetCtlProp( "contContent.imgdot"..i+1, "top", nTop)
			End If
			Form.SetCtlProp( "contContent.lblContent"..i, "caption", tList(i*3+10))
			Form.SetCtlProp( "contContent.lblContent"..i, "visible", True)
			Form.SetCtlProp( "contContent.lblContent"..i, "halign", tList(6))
			Form.SetCtlProp( "contContent.imgdot"..i, "visible", tonumber(tList(i*3+9)))
		Next 
		
		'화면 컨트롤 배치------------------------------------------------
		'647 : 화면 길이
		'70 : contContent.top - imgBox.top 
		'60 : btnOK.height

		contContent.height = nTop
		imgBox.height = 70 + nTop + 60
	
		imgBox.top = CInt((647 - (70 + nTop + 60))/2)	
		lblTitle.top = CInt((647 - (70 + nTop + 60))/2)
		imgBgTitle.top = CInt((647 - (70 + nTop + 60))/2) + 15		'15 : imgBgTitle.top - imgBox.top	
		imgClose. top = CInt((647 - (70 + nTop + 60))/2) + 15		'15 : imgClose.top - imgBox.top	
		
		contContent.top = CInt((647 - (70 + nTop + 60))/2) + 70	 
		btnCancle.top = CInt((647 - (70 + nTop + 60))/2) + 75 + nTop		'75 : contContent.top - imgBox.top + 5
		btnNext.top = CInt((647 - (70 + nTop + 60))/2) + 75 + nTop
		lblCancle.top = CInt((647 - (70 + nTop + 60))/2) + 75 + nTop		'75 : contContent.top - imgBox.top + 5
		lblNext.top = CInt((647 - (70 + nTop + 60))/2) + 75 + nTop		
	End If

End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( g_szRetKeyNm , g_szRet )
End Sub

'============================================================================
' imgBg_OnClick() : 닫기
'============================================================================
Sub imgBg_OnClick()
	g_szRet = ""
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick() : 닫기
'============================================================================
Sub imgClose_OnClick()
	g_szRet = ""
	Form.CloseForm()
End Sub
'============================================================================
' btnCancle_OnClick() 
'============================================================================
Sub btnCancle_OnClick()
	g_szRet = "no"
	Form.CloseForm()	
End Sub
'============================================================================
' btnNext_OnClick() 
'============================================================================
Sub btnNext_OnClick()
	g_szRet = "yes"
	Form.CloseForm()		
End Sub




	</SCRIPT_INFO>
</ROOT>