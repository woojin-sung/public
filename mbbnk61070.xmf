'============================================================================
' 01. 화 면 명 : 이체한도변경
' 02. 화면설명 : 이체한도변경
' 03. 작    성 : 2016.02.15 ~ 최지희
' 04. 수    정 : 2020.09.21. 장원혁 v001 메모리평문제거
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szAccountNumber
Dim g_szAccountSerialNumber
Dim g_szAccountPassword

'---- 서비스 코드, 서비스 일련번호, 고객 번호, 서비스 관리 단위 코드
Dim g_szSVCD, g_szSVCD_SRNO, g_szCSNO, g_szSVC_MANG_UNIT_CODE
'---- 처리구분 코드, 약정상태 구분 코드
Dim g_szPROS_CLS_CODE, g_szSTPL_STAT_CLS_CODE
'---- 고객구분 코드, 보안 등급구분코드, 접촉 구분 코드, 파출 직원 번호
Dim g_szCUST_CLS_CODE, g_szSECU_GRAD_CLS_CODE, g_szCONT_CLS_CODE, g_szCUST_GRAD_CODE, g_szSNOT_EMPNO
'---- 주문 채널 유형 구분 코드
Dim g_szODER_CHAN_TYPE_CLS_CODE
'---- 계좌일련번호
Dim g_szASNO

Dim g_nCheckLimit
Dim tempMsg

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
'TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_070r", "InBlock1", "ACNO"  , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obpds_srvc_070r")
	end if
	
	if szTranID == "obpds_srvc_120r" then	'고객보안등급조회
		DATAMANAGER.SetDataValue(0, "obpds_srvc_120r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obpds_srvc_120r")
	end if
	
	if szTranID == "obpds_srvc_123r" then	'즉시이체약정한도
		DATAMANAGER.RequestTranData("obpds_srvc_123r")
	end if
	
	if szTranID == "obpds_srvc_069r" then	'약정내역조회TR
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obpds_srvc_069r")
	end if
	
	if szTranID == "obpds_srvc_072r" then	'이체한도약정명세서
		DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.RequestTranData("obpds_srvc_072r")

	end if
	
	if szTranID == "obpds_srvc_042a" then	'즉시이체약정
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "PROS_CLS_CODE" , 0 , g_szPROS_CLS_CODE)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "CSNO" , 0 , g_szCSNO)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "ASNO" , 0 , g_szASNO)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_042a", "InBlock1", "SVCD", 0 , g_szSVCD)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "SVC_SRNO" , 0 , g_szSVCD_SRNO)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , g_szSVC_MANG_UNIT_CODE)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_042a", "InBlock1", "CONT_CLS_CODE", 0 , g_szCUST_CLS_CODE)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "SNOT_EMPNO" , 0 , "")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock2", "ODER_CHAN_TYPE_CLS_CODE" , 0 , g_szODER_CHAN_TYPE_CLS_CODE)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_042a", "InBlock1", "ACNO", 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
		DATAMANAGER.SetDataValue(0,"obpds_srvc_042a", "InBlock2", "T1_TACT_LIMT_AMT"  , 0 , edtOne.caption)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_042a", "InBlock2", "D1_TACT_LIMT_AMT" , 0 , edtDay.caption)
		DATAMANAGER.RequestTranData("obpds_srvc_042a")
	end if
End Function

'============================================================================
' CheckLimit
'============================================================================
Function CheckLimit()
	g_nCheckLimit = "true"
	
	Dim szOldLimitDay
	szOldLimitDay = Trim(tblBefore.GetCellString( 0, 1 ))
	Dim szOldLimitOne
	szOldLimitOne = Trim(tblBefore.GetCellString( 1, 1 ))
	
	Dim szChangeLimitDay 
	szChangeLimitDay = Trim(edtOne.caption)
	Dim szChangeLimitOne 
	szChangeLimitOne = Trim(edtDay.caption)
	
	if szOldLimitDay <> "" then
		if CDbl(szOldLimitDay) < CDbl(szChangeLimitDay) then
			Form.MsgBox("알림", "한도감액만 가능합니다.", "", 0)
			g_nCheckLimit = "false"
			exit function
		end if
	else
		Form.MsgBox("알림", "1일 이체 한도 감액 설정이 잘못되었습니다.", "", 0)
		g_nCheckLimit = "false"
		exit function		
	end if
	
	if szChangeLimitOne <> "" then
		if CDbl(szOldLimitOne) < CDbl(szChangeLimitOne) then
			Form.MsgBox("알림", "한도감액만 가능합니다.", "", 0)
			g_nCheckLimit = "false"
			exit function
		end if
	else
		Form.MsgBox("알림", "1회 이체 한도 감액 설정이 잘못되었습니다.", "", 0)
		g_nCheckLimit = "false"
		exit function
	end if		
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_nCheckLimit = "false"
	g_szSVCD = "019"
	g_szPROS_CLS_CODE= "U"
	
	g_szAccountNumber = cmbAccount.total 
	g_szAccountSerialNumber = cmbAccount.sequence 
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption) v001 주석처리
	
    'v001 sta ***********************
	
    dim plain_rm 

    plain_rm = Form.GetSharedData("&PLAIN_RM", false ) '시스템헤더변수
    
    if plain_rm = "1" then  '메모리평문적용상태
        g_szAccountPassword = edtPassword.caption '평문을 그대로 세팅한다
    else
        g_szAccountPassword = Form.GetEncData(edtPassword.caption) '암호화된 패스워드를 사용한다
    end if 

    'v001 fin ***********************
	
'	if edtName.caption <> "" then
'		btnSearch_OnClick()
'	end if	
btnSearch_OnClick()
End Sub


'============================================================================
' btnSearch_OnClick
'============================================================================
Sub btnSearch_OnClick()
	for i=0 to 1
		tblBefore.SetCellString( i, 1, "" )
	next
	
	edtOne.caption = ""
	edtDay.caption = ""
	
	TR_Inquiry("obpds_srvc_070r")
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회
		g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue(0, "obpds_srvc_070r", "OutBlock1", "CUST_CLS_CODE" , 0)
		g_szCSNO = DATAMANAGER.GetDataValue(0, "obpds_srvc_070r", "OutBlock1", "CSNO" , 0)
		TR_Inquiry("obpds_srvc_120r")
	end if
	
	if szTranID == "obpds_srvc_069r" then	'약정내역조회tr
		g_szSVCD_SRNO = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO" , 0)
		g_szSVC_MANG_UNIT_CODE = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "SVC_MANG_UNIT_CODE" , 0)
		g_szASNO = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "ASNO", 0)
		g_szCONT_CLS_CODE = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "CONT_CLS_CODE", 0)
		TR_Inquiry("obpds_srvc_072r")
	end if
	
	if szTranID == "obpds_srvc_072r" then	'이체한도악정명세서
		g_szODER_CHAN_TYPE_CLS_CODE = DATAMANAGER.GetDataValue(0, "obpds_srvc_072r", "OutBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0)
		
		'이체한도약정 해지 시 0원으로 SET
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) <> "01" then
			tblBefore.SetCellString(0, 1, 0)
			tblBefore.SetCellString(1, 1, 0)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "OutBlock1", "T1_TACT_LIMT_AMT" , 0, 0)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "OutBlock1", "D1_TACT_LIMT_AMT" , 0, 0)
		end if
		
	end if
	
	if szTranID == "obpds_srvc_120r" then	'고객보안등급조회
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_120r", "OutBlock1", "UI_OTP_ISNC_YN" , 0) == "Y" then
			Table2.SetCellString( 0, 1, "발급" )
		else
			Table2.SetCellString( 0, 1, "미발급" )
		end if
		
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_120r", "OutBlock1", "UI_SCRC_ISNC_YN" , 0) == "Y" then
			Table2.SetCellString( 0, 3, "발급" )
		else
			Table2.SetCellString( 0, 3, "미발급" )
		end if
		
		
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_120r", "OutBlock1", "UI_SMS_STPL_YN", 0) == "Y" then
			Table2.SetCellString( 0, 5, "약정" )
		else
			Table2.SetCellString( 0, 5, "미약정" )
		end if
		
		g_szSECU_GRAD_CLS_CODE = DATAMANAGER.GetDataValue(0,  "obpds_srvc_120r", "OutBlock1", "SECU_GRAD_CLS_CODE", 0)
		edtGrade.caption = Form.GetMetaData("보안등급구분코드", g_szSECU_GRAD_CLS_CODE)
		
		If g_szSECU_GRAD_CLS_CODE == "01" Then
		    Label4.caption = "1등급[OTP]"
         ElseIf g_szSECU_GRAD_CLS_CODE == "02" Then
             Label4.caption = "2등급[보안카드]"
         ElseIf g_szSECU_GRAD_CLS_CODE == "03" Then
             Label4.caption = "3등급[보안카드]"
         ElseIf g_szSECU_GRAD_CLS_CODE == "04" Then
             Label4.caption = "1등급[모바일OTP]"
		End If
		
		TR_Inquiry("obpds_srvc_123r")
	end if
	
	if szTranID == "obpds_srvc_123r" then	'즉시이체약정한도
		TR_Inquiry("obpds_srvc_069r")
	end if
	
	if szTranID == "obpds_srvc_042a" then	'즉시이체약정
		tempMsg = DATAMANAGER.GetDataMsgText("obpds_srvc_042a")
		
		if tempMsg <> "" then
			Form.MsgBox("알림", tempMsg, "", 0)
			tempMsg = ""
		end if
		
		TR_Inquiry("obpds_srvc_072r")
		
		edtOne.caption = ""
		edtDay.caption = ""
		
		edtPassword.caption = ""
		g_szAccountPassword = ""
	end if
	
	
End Sub


'============================================================================
' btnChange_OnClick
'============================================================================
Sub btnChange_OnClick()

	if edtOne.caption == "" then
		Form.MsgBox("알림", "1회 이체 한도 감액 설정이 잘못되었습니다.", "", 0)
		exit sub
	end if
	
	if edtDay.caption == "" then
		Form.MsgBox("알림", "1일 이체 한도 감액 설정이 잘못되었습니다.", "", 0)
		exit sub
	end if
	
	if CDbl(edtOne.caption) > CDbl(edtDay.caption) then
		Form.MsgBox("알림", "1회 이체 한도 감액 설정이 잘못되었습니다.", "", 0)
		exit sub
	end if
	
	if edtPassword.caption == "" or edtPassword.caption == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요.")
		Exit Sub
	end if
	
	Call CheckLimit()
	
	if g_nCheckLimit == "true" then	
		TR_Inquiry("obpds_srvc_042a")
	end if
End Sub



'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_069r" then	'약정내역조회tr
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "CSNO" , 0 , g_szCSNO)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "SVCD" , 0 , g_szSVCD)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE", 0 , g_szPROS_CLS_CODE)
	end if
	
	if szTranID == "obpds_srvc_072r" then	'이체한도약정명세서
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_072r", "InBlock1", "SVCD", 0 , g_szSVCD)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_072r", "InBlock1", "SVC_SRNO", 0 , g_szSVCD_SRNO)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "InBlock1", "CSNO" , 0 , g_szCSNO)
	end if	
	
	
	if szTranID == "obpds_srvc_123r" then	'즉시이체약정한도
		DATAMANAGER.SetDataValue(0, "obpds_srvc_123r", "InBlock1", "SVCD" , 0 , g_szSVCD)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_123r", "InBlock1", "CUST_CLS_CODE" , 0 , g_szCUST_CLS_CODE)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_123r", "InBlock1", "SECU_GRAD_CLS_CODE" , 0 , g_szSECU_GRAD_CLS_CODE)
	end if
End Sub


'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_szAccountNumber = cmbAccount.total 
	g_szAccountSerialNumber = cmbAccount.sequence 
	edtPassword.caption = ""
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption) v001 주석처리
	g_nCheckLimit = "false"
	btnSearch_OnClick()
	
    'v001 sta ***********************
	
    dim plain_rm 

    plain_rm = Form.GetSharedData("&PLAIN_RM", false ) '시스템헤더변수
    
    if plain_rm = "1" then  '메모리평문적용상태
        g_szAccountPassword = edtPassword.caption '평문을 그대로 세팅한다
    else
        g_szAccountPassword = Form.GetEncData(edtPassword.caption) '암호화된 패스워드를 사용한다
    end if 

    'v001 fin ***********************
    
End Sub





'============================================================================
