Sub graph_set()
	
	'총매도수량
	d1 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_RLIM1", 0)
	d2 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_RLIM2" , 0)
	d3 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_RLIM3" , 0)
	d4 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_RLIM4" , 0)
	d5 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_RLIM5" , 0)
		
	'총매수수량
	d6 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_RLIM1" , 0)
	d7 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_RLIM2" , 0)
	d8 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_RLIM3" , 0)
