	d10 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_RLIM5" , 0)
		
	
	
	ChartEx0.SetAccrueData("initdata="&d5&";"&d4&";"&d3&";"&d2&";"&d1&";"&d6&";"&d7&";"&d8&";"&d9&";"&d10)
