'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_stck_mbcr" then
	
		szYseNo 	= DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SELN_MBCR_GLOB_YN1" , 0 )		
		SetTableColor_real( 1, 1, szYseNo )		
		
		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SELN_MBCR_GLOB_YN2" , 0 )	
		SetTableColor_real( 2, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SELN_MBCR_GLOB_YN3" , 0 )	
		SetTableColor_real( 3, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SELN_MBCR_GLOB_YN4" , 0 )	
		SetTableColor_real( 4, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SELN_MBCR_GLOB_YN5" , 0 )	
		SetTableColor_real( 5, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SHNU_MBCR_GLOB_YN1" , 0 )	
		SetTableColor_real( 1, 2, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SHNU_MBCR_GLOB_YN2" , 0 )	
		SetTableColor_real( 2, 2, szYseNo )

		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SHNU_MBCR_GLOB_YN3" , 0 )	
		SetTableColor_real( 3, 2, szYseNo )

		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SHNU_MBCR_GLOB_YN4" , 0 )	
		SetTableColor_real( 4, 2, szYseNo )

		szYseNo = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcr", "OutBlock1", "FIDR_SHNU_MBCR_GLOB_YN5" , 0 )	
		SetTableColor_real( 5, 2, szYseNo )
		
		
	
	end if
End Sub

