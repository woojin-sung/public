'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 탭_거래원
' 02. 화면설명 : 주식현재가화면 거래원 탭
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim n1,n2,n3,n4,n5,n6,n7,n8,n9,n10
Dim d1,d2,d3,d4,d5,d6,d7,d8,d9,d10

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function SetTableColor( nRow, nCol, szYseNo )
	
	If Trim( szYseNo) <> "" Then
		Dim szName, szColor
		szName = tbl0.GetCellString(nRow, nCol)
		
		If nCol = 1 Then
			szColor = "11"
		Else
			szColor = "10"
		End If
	
		If szYseNo = "Y" Then
			tbl0.SetCellFgColor( nRow, nCol, szColor )
			tbl0.setPropTable("fontstyle" , nRow, nCol , "01")
		Else
			tbl0.SetCellFgColor( nRow, nCol, "4" )
			tbl0.setPropTable("fontstyle" , nRow, nCol , "00")
		
		End If
	End If
	
End Function 

'============================================================================
Function SetTableColor_real( nRow, nCol, szYseNo )

	If Trim( szYseNo) <> "" Then
		Dim szName, szColor
		szName = tbl0.GetCellString(nRow, nCol)
		
		If nCol = 1 Then
			szColor = "11"
		Else
			szColor = "10"
		End If
	
		If szYseNo = "Y" Then
			tbl0.SetCellFgColor( nRow, nCol, szColor )
			tbl0.setPropTable("fontstyle" , nRow, nCol , "01")
		Else
			tbl0.SetCellFgColor( nRow, nCol, "4" )
			tbl0.setPropTable("fontstyle" , nRow, nCol , "00")
		
		End If
	End If


End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		DATAMANAGER.RequestTranData( "ohhts_1001_006r" )
	end	if	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	ChartEx0.SetAccrueName(",member_bar")
	
'	DATAMANAGER.RequestTranData( "ohhts_1001_006r" )

	'20180619 HAMWG START : 회원사 매수/매도증감 토글기능 추가
	tbl1.visible = False
	tbl2.visible = False
	'20180619 HAMWG END
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		DATAMANAGER.RequestTranData( "ohhts_1001_006r" )
		
	 end if
	 
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_stck_mbcr" )
	
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_006r", "InBlock1", "FID_INPUT_ISCD"			 	, 0 , g_szItemCode	)
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_006r", "InBlock2", "FID_INPUT_ISCD"			 	, 0 , g_szItemCode	)
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_006r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	DATAMANAGER.SetDataValue( 1, "ohhts_stck_mbcr", "InBlock1", "FIDR_SHRN_ISCD"			 	, 0 , g_szItemCode	)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	
	If szTranID = "ohhts_1001_006r" Then
		Dim szYseNo, szName
	
		szYseNo 	= DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_GLOB_YN1" , 0 )		
		SetTableColor( 1, 1, szYseNo )		
		
		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_GLOB_YN2" , 0 )	
		SetTableColor( 2, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_GLOB_YN3" , 0 )	
		SetTableColor( 3, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_GLOB_YN4" , 0 )	
		SetTableColor( 4, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_GLOB_YN5" , 0 )	
		SetTableColor( 5, 1, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_GLOB_YN1" , 0 )	
		SetTableColor( 1, 2, szYseNo )
		
		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_GLOB_YN2" , 0 )	
		SetTableColor( 2, 2, szYseNo )

		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_GLOB_YN3" , 0 )	
		SetTableColor( 3, 2, szYseNo )

		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_GLOB_YN4" , 0 )	
		SetTableColor( 4, 2, szYseNo )

		szYseNo = DATAMANAGER.GetDataValue( 0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_GLOB_YN5" , 0 )	
		SetTableColor( 5, 2, szYseNo )
		
		DATAMANAGER.RequestRealData( "ohhts_stck_mbcr" )
		
		'매도회원사명
		n1 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_NAME1" , 0)
		n2 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_NAME2" , 0)
		n3 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_NAME3" , 0)
		n4 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_NAME4" , 0)
		n5 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SELN_MBCR_NAME5" , 0)
		
		'매수회원사명
		n6 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_NAME1" , 0)
		n7 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_NAME2" , 0)
		n8 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_NAME3" , 0)
		n9 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_NAME4" , 0)
		n10 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_SHNU_MBCR_NAME5" , 0)
		
		'총매도수량
		d1 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SELN_QTY1" , 0)
		d2 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SELN_QTY2" , 0)
		d3 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SELN_QTY3" , 0)
		d4 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SELN_QTY4" , 0)
		d5 = DATAMANAGER.GetDataValue(0, "ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SELN_QTY5" , 0)
		
		'총매수수량
		d6 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SHNU_QTY1" , 0)
		d7 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SHNU_QTY2" , 0)
		d8 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SHNU_QTY3" , 0)
		d9 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SHNU_QTY4" , 0)
		d10 = DATAMANAGER.GetDataValue(0,"ohhts_1001_006r", "OutBlock1", "FID_TOTAL_SHNU_QTY5" , 0)
		
		'그래프데이터 셋팅
		graph_set()
	
	End If
	
End Sub

'============================================================================
Sub tbl0_OnClick(lRow , lColumn)
	Dim szMemberCode, szMemberName, szItemName, nVol
	
	If lRow = 6 Then
		Exit Sub
	End If
	
	'20180619 HAMWG START : 회원사 매수/매도증감 토글기능 추가
	If lRow == 0 Then
		If lColumn == 0 or lColumn == 3 then
			tbl1.visible = True
			tbl2.visible = True
		End If
	End If
	'20180619 HAMWG END
	
	If lColumn > 0 and lColumn < 3 then
		If lColumn = 1 Then
			nVol = CDbl(tbl0.GetCellString( lRow, 0 ) )
		ElseIf lColumn = 2 Then
			nVol = CDbl(tbl0.GetCellString( lRow, 3 ) )
		End If
	
		If nVol > 0 Then
			szMemberName	= tbl0.GetCellString( lRow, lColumn )
			szMemberCode	= tbl0.GetCellString( lRow, lColumn + 3 )
			szItemName 	= Form.GetItemCodeInfo( g_szItemCode , "name")
			
			Form.OpenFramePopup( "mhprc11000_p5" , g_szItemCode & "|" & szMemberCode & "|" & szMemberName & "|" & szItemName  , "")
		End If
	End If
	
End Sub

