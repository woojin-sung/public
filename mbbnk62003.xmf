'============================================================================

Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "obtss_acis_100a" or szTranID = "obtss_acis_100a_1" then
		'Form.ShowAlert("알림", "조회 내역이 존재하지 않습니다.")
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if szSubErr ="" then
			Form.ShowAlert( "알림", szErrMsg )
		else
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		end if
		
		'Label2.caption = "0"
		'Label4.caption = "0"		
         total_csnu = 0
         reg_able_csnu = 0		
		
		DisPlayAcntCnt()
		
	end if
	
	if szTranID = "obtss_acis_101r" then
		'6622
		sMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
		if sMsgCode = "6622" AND g_nRtryCnt < 12 then	'응답수신전 최대 35초임 - 서버에서 3 초 wait--> 3 * 12
			g_nRtryCnt = g_nRtryCnt + 1
			InqRsltData(sOtsdTrUniqNo)	
		else
			szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		
			if szSubErr ="" then
				Form.ShowAlert( "알림", szErrMsg )
			else
				Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
			end if
		end if
	end if
	
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'최초조회
	if szTranID = "obtss_acis_100a" then
		grd0.DeleteAllRow( )	
		
		g_nNextCount = 0
		selectCount	=0
		reg_able_csnu = 0
		iqry_srno 			= 0
		rqst_csnu			= 15
		iqry_dsgt_no = 1
		pros_csnu = 0
		g_sFrst = "Y"
		'Label2.caption = "0"
		'Label4.caption = "0"

         total_csnu = 0
         reg_able_csnu = 0		
	 
	end if
	
	if szTranID = "obtss_acis_100a" OR szTranID = "obtss_acis_100a_1" then
		g_nRtryCnt = 0
		g_sOtsdTrUniqNo = ""
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"	 , 0, g_szUserID	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_DSGT_NO", 0, iqry_dsgt_no 			) '조회지정번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RQST_CSNU"	 , 0, rqst_csnu			) '요청건수(15건씩)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_SRNO"	 , 0, iqry_srno			) '조회일련번호
		
		if RadioGroup0.currentindex == "0" then '은행
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISTU_CLCD"	 , 0, "1"		) 
		elseif RadioGroup0.currentindex == "1" then '증권사
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISTU_CLCD"	 , 0, "4"		) 
		elseif RadioGroup0.currentindex == "2" then '제2금융
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISTU_CLCD"	 , 0, "2"		)
		end if
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RSPN_YN"	 , 0, "N"			) '응답대기여부	skip
	end if
	
	'연속조회	
	if szTranID = "obtss_acis_100a_1" then
		g_sFrst = "N"
		DATAMANAGER.SetDataValue( 0, "obtss_acis_100a_1", "InBlock1", "IQRY_ORGL_TR_UNIQ_NO"	 , 0, iqry_orgl_tr_uniq_no	) '조회원거래고유번호
	end if
			
End Sub

Function InqRsltData(sOtsdTrUniqNo)

	g_sOtsdTrUniqNo = sOtsdTrUniqNo
	
	DATAMANAGER.SetDataValue( 0, "obtss_acis_101r", "InBlock1", "ELFN_ID"	 , 0, g_szUserID	)
	DATAMANAGER.SetDataValue( 0, "obtss_acis_101r", "InBlock1", "OTSD_TR_UNIQ_NO"	 , 0, sOtsdTrUniqNo	)
	DATAMANAGER.RequestTranData( "obtss_acis_101r" )
	
	
End Function

Sub DisPlayAcntCnt()

    Label1.caption = "계좌통합조회 목록(보유계좌) " .. FormatNumber(CDbl(total_csnu), 0, 0, 0, -1) .. " 건 / 등록가능계좌 " .. FormatNumber(CDbl(reg_able_csnu), 0, 0, 0, -1) .. " 건"

End Sub

