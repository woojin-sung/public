'============================================================================
' 01.화면명 	: 오픈뱅킹 다른금융기관 한번에 등록하기
' 02.화면설명	: 오픈뱅킹 다른금융기관 한번에 등록하기
' 03.작성	: 2020.10.07
' 04.수정     : 2021.01.13. 장원혁 : v001 : 간편인증로그인 시 공인인증절차를 간편인증으로 변경
'============================================================================
Dim sz_email		'이메일
Dim szCust_Num 	'고객번호
Dim sz_CheckAccountOK
Dim g_szUserID
Dim g_szUserName
Dim g_CiKey

Dim selectCount	'선택건수
Dim g_nNextCount

Dim sSendData

Dim iqry_dsgt_no			'조회지정번호
Dim iqry_srno				'조회일련번호
Dim iqry_orgl_tr_uniq_no	'조회원거래고유번호
Dim rqst_csnu				'요청건수
Dim total_csnu			'총건수
Dim pros_csnu				'처리건수
Dim reg_able_csnu			'등록가능건수
Dim tpcd					'유형코드 ( A : 활동성계좌 , I : 비활동성계좌)

Dim data_cntt_yn			'데이터지속여부

Dim g_nRtryCnt			'응답대기 카운트
Dim g_sOtsdTrUniqNo
Dim g_sFrst

Dim g_szCertUserType        'v001 로그인유형 

Dim g_hldn_acnt_csnu '보유계좌수
Dim g_able_acnt_csnu '가능계좌수

'============================================================================

Sub Form_OnFormInit()
	
	szCust_Num = Form.GetSharedData("&CUST_NUM"		, false )	'로그인 해야만 고객번호 받아옴
	g_szUserID = Form.GetSharedData( "&USER_ID"		, false )	'사용자ID
	g_szUserName =Form.GetSharedData( "&USER_NAME"	, false )	'사용자명
	g_szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입
	
	Image0.imgpath = "title_3step_cut_02_on.png"
	
	recv_data = Form.GetOpenLinkData()
	
	tData = Split(recv_data, "★")
	
	if UBOUND(tData) < 1 then
		exit sub
	end if
	
	sz_email = tData[0]
	g_CiKey  = tData[1]
	
	g_nNextCount = 0
	selectCount	=0
	
	total_csnu = 0
	reg_able_csnu = 0
	DisPlayAcntCnt()
	
	pros_csnu = 0
	
	iqry_srno 			= 0
	rqst_csnu			= 0
	iqry_dsgt_no = 1
	
	
	SetAllAccount() '최초호출
	
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	SetAllAccount() '최초호출 '라디오 재클릭시 무조건 재호출
End Sub

'============================================================================

Sub btnOK_OnClick()
	selectCount =0 '선택건수 초기화
	if grd0.rowcount ==0 then
		Form.ShowAlert("알림", "조회 내역이 존재하지 않습니다.")
		Exit Sub
	end if
	
	for i = 0 to grd0.rowcount -1 
		if grd0.GetCellData("bd_cell0", i) =="1" then
			selectCount = cdbl(selectCount) +1
		end if 
	next
	
	if cdbl(selectCount) == 0 then
		Form.ShowAlert("알림", "등록 계좌를 선택해주세요.")
		Exit Sub
	end if
	
	if cdbl(selectCount) >6 then
		Form.ShowAlert("알림", "최대 5건까지 선택 가능합니다.")
		Exit Sub
	end if
	
	if g_szCertUserType == "1" Or g_szCertUserType == 1 Then '간편인증 v001
	    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
	Else
	    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
	End If
	
End Sub

Sub Form_OnPopupReturn(sKeyName, sRet)		
	
	if sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'등록
			Setpass()
		end if
	
	elseif sKeyName == "mbbnk62005_end" then 
			if sRet = "1" then
				'Form.ShowAlert("알림", "테스트중 완료화면 나가도 이전화면유지")
				Form.CloseForm()		'첫페이지(ID등록)로 이동
			end if
			
     ElseIf sKeyName == "mhetc90060_px" Then 'v001
         If sRet == "ok" Then
	         Setpass()
	     End If
	End if
End Sub
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbnk62003_end" ,  "1" )
End Sub
'============================================================================
Function Setpass()
	sSendData = selectCount &"★"& sz_email &"★"& g_CiKey '고정값 (전체건수★이메일★CIKEY)
	'sSendData = selectCount &"★"& "이메일" &"★"& "씨아이키" '고정값 (전체건수★이메일★CIKEY)
	
	for i = 0 to grd0.rowcount -1 
		if grd0.GetCellData("bd_cell0", i) =="1" then
			
					  '전체건수★이메일★CIKEY(★계좌구분명★예금명★금융기관코드★금융기관명★계좌번호★예금주명)
			sSendData = sSendData &"★"& grd0.GetCellData("bd_cell3", i) &"★"& grd0.GetCellData("bd_cell7", i) &"★"& grd0.GetCellData("bd_cell9", i)&"★"& grd0.GetCellData("bd_cell1", i) &"★"& grd0.GetCellData("bd_cell5", i) &"★"& g_szUserName
		end if
	next
	
	Form.OpenFramePopup( "mbbnk62005" , sSendData , sPosInfo) '완료화면에서 등록 서비스 호출
	
End Function
'============================================================================

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obtss_acis_100a" OR szTranID == "obtss_acis_100a_1" then '전계좌 조회
		sOtsdTrUniqNo = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO"				, 0	) 
		
		InqRsltData(sOtsdTrUniqNo)	'응답수신 확인 CALL
		
		'DATAMANAGER.SetDataValue( 0, "obtss_acis_101r", "InBlock1", "ELFN_ID"	 , 0, g_szUserID	)
		'DATAMANAGER.SetDataValue( 0, "obtss_acis_101r", "InBlock1", "OTSD_TR_UNIQ_NO"	 , 0, sOtsdTrUniqNo	)
		
		
		'DATAMANAGER.RequestTranData( "obtss_acis_101r" )
		
	end if
	
	
	if szTranID == "obtss_acis_101r" then
		total_csnu			= DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "TOTAL_CSNU"				, 0	) '총건수
		
		if g_sFrst = "Y" then
			reg_able_csnu  = total_csnu '총건수입력후 불가 내역존재시 -1
		end if
		
		for i = 0 to DATAMANAGER.GetDataCount( 0 , szTranID, "OutBlock2" ) -1
			grd0.AddRow()
			grd0.SetCellData("bd_cell1", g_nNextCount, DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "ISTU_NAME"		, i )) '금융기관명
			grd0.SetCellData("bd_cell2", g_nNextCount, DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "TOTAL_VLTN_AMT"	, i )) '총평가금액
			grd0.SetCellData("bd_cell9", g_nNextCount, DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "ISTU_CODE"	  	, i ))
			grd0.SetCellData("bd_cell5", g_nNextCount, DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "BANK_USE_ACNO"	, i ))
			grd0.SetCellData("bd_cell7", g_nNextCount, DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "ACNT_PRNM"		, i ))'계좌상품명(예금명)
			grd0.SetCellData("bd_cell3", g_nNextCount, DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "ACNT_CLS_NAME"	, i ))

			tpcd   = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "TPCD"	 , i ) '유형코드 ( A : 활동성계좌 , I : 비활동성계좌)
			reg_yn = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock2", "STPL_YN", i ) '약정여부(오픈뱅킹계좌등록여부)
			
			if tpcd == "A" then
				grd0.SetCellData("bd_cell8", g_nNextCount, "Y")
			else
				grd0.SetCellData("bd_cell8", g_nNextCount, "N")
			end if
			
			if reg_yn =="Y" then	'기약정계좌
				grd0.SetCellData("bd_cell4", g_nNextCount, "등록")
			else
				if tpcd == "A" then
					grd0.SetCellData("bd_cell4", g_nNextCount, "가능")
				else
					grd0.SetCellData("bd_cell4", g_nNextCount, "불가")
				end if
			end if
			
			if tpcd = "I" or reg_yn =="Y" then '비활동성계좌이거나 기약정계좌일 경우
				grd0.SetCellEnable( "bd_cell0", g_nNextCount, False )
				reg_able_csnu = reg_able_csnu -1
			end if
			
			g_nNextCount = cdbl(g_nNextCount) + 1
		next
		
		data_cntt_yn 	= DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "DATA_CNNT_YN", 0 )
		
		if data_cntt_yn =="Y" then '데이터지속여부 Y일때
				
			iqry_srno 			= DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "IQRY_SRNO"				, 0	) '조회일련번호
			iqry_orgl_tr_uniq_no	= DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "IQRY_ORGL_TR_UNIQ_NO"		, 0	) '조회원거래고유번호
			pros_csnu			= pros_csnu + DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "PROS_CSNU"	, 0	)			  '처리건수

			iqry_dsgt_no			= iqry_dsgt_no	+	15
			
			if total_csnu - pros_csnu <15 then
				rqst_csnu = total_csnu - pros_csnu
			else
				rqst_csnu =15
			end if
			
			SetAllAccount_1() '연속호출
		else
			'Label4.caption = reg_able_csnu
			DisPlayAcntCnt()
		end if	
	end if
	
End Sub
