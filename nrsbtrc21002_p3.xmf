						if Trim(g_szFRSKQty) == "" then
							Table0313.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0")
							Table0313.SetCellString(6, 0, "")					
							Table0313.SetCellString(6, 1, "")					
						else
							'Table0313.SetCellMaskInfo(6, 1, "0,0,,주,1,,0,1,0,0,0" )
							Table0313.SetCellString(6, 1, g_szFRSKQty) 'CFD단수주수
						end if 							
						
						'단수주수 또는 단수주지급일자
						if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
							Table0313.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0")
							Table0313.SetCellString(7, 0, "")
							Table0313.SetCellString(7, 1, "")
						else
							Table0313.SetCellString(7, 1, g_szFRSKDate) 'CFD단수주지급일자
						end if 
					
						'단수주수 또는 CFD단수주대금
						if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
							Table0313.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")
							Table0313.SetCellString(8, 0, "")					
							Table0313.SetCellString(8, 1, "")					
						else
							'Table0313.SetCellMaskInfo(8, 1, "0,0,,원,0,,0,1,0,0,0")
							Table0313.SetCellString(8, 1, g_szFRSK) 'CFD단수주대금	
						end if 								
					
					elseif g_szRghtNm == "동시배당" then		
						'현금지급일
						if Trim(grd0.GetCellData("bd_cell33",  0)) == "" then
							Table0315.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
							Table0315.SetCellString(2, 1, "미정") 
						else
							Table0315.SetCellString(2, 1, grd0.GetCellData("bd_cell33",  0)) 
						end if 
						'주식지급일
						if Trim(grd0.GetCellData("bd_cell16",  0)) == "" then
							Table0315.SetCellMaskInfo(3, 1,  "1,0,,,1,,0,0,1,0,0")
							Table0315.SetCellString(3, 1, "미정") 
						else
							Table0315.SetCellString(3, 1, grd0.GetCellData("bd_cell16",  0)) 
						end if 							
						Table0315.SetCellString(4, 1, grd0.GetCellData("bd_cell13",  0)) 'CFD배당금상당액출금
						
						'배정비율
						if grd0.GetCellData("bd_cell18", 0) <> nil then
							if CDbl(grd0.GetCellData("bd_cell18", 0)) > 0 then
								Table0315.SetCellString(5, 1, CDbl(grd0.GetCellData("bd_cell18", 0)))  
							end if 
						end if			
						
						Table0315.SetCellString(6, 1, grd0.GetCellData("bd_cell17",  0)) 'CFD배당주수
						
						'CFD단수주수
						if Trim(g_szFRSKQty) == "" then
							Table0315.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0")
							Table0315.SetCellString(7, 0, "")					
							Table0315.SetCellString(7, 1, "")					
						else
							'Table0315.SetCellMaskInfo(7, 1, "0,0,,주,1,,0,1,0,0,0" )
							Table0315.SetCellString(7, 1, g_szFRSKQty) 'CFD단수주수
						end if 							
						
						'단수주수 또는 단수주지급일자
						if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
							Table0315.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")
							Table0315.SetCellString(8, 0, "")
							Table0315.SetCellString(8, 1, "")
						else
							Table0315.SetCellString(8, 1, g_szFRSKDate) 'CFD단수주지급일자
						end if 
					
						'단수주수 또는 CFD단수주대금
						if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
							Table0315.SetCellMaskInfo(9, 1, "1,0,,,1,,0,0,1,0,0")
							Table0315.SetCellString(9, 0, "")					
							Table0315.SetCellString(9, 1, "")					
						else
							'Table0315.SetCellMaskInfo(9, 1, "0,0,,원,0,,0,1,0,0,0")
							Table0315.SetCellString(9, 1, g_szFRSK) 'CFD단수주대금	
						end if 						
						
					end if 
				end if 					
			end if
			
		Case "17", "28", "30" '17	ETF분배금 28	ETN분배금,  30 펀드분배금
			Dim szCash
			if InStr(g_szRghtNm, "현금") > 0 then '현금배당의 경우 단수주관련 데이터 삭제
				szCash = true 
			else
				szCash = false
			end if		
			
			lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 
 
			if g_szStatCd == "2" then '예정
			
				'CFD배당금입금/CFD차입배당금출금
				if g_szPSTNCd == "1" then '매수
					'지급일자
					if Trim(grd0.GetCellData("bd_cell33",  0)) == "" then
						Table1721.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table1721.SetCellString(2, 1, "미정") 
					else
						Table1721.SetCellString(2, 1, grd0.GetCellData("bd_cell33",  0)) 
					end if 
					
					'주당배당액
					if grd0.GetCellData("bd_cell23", 0) <> nil then
						if CDbl(grd0.GetCellData("bd_cell23", 0)) > 0 then
							Table1721.SetCellString(3, 1, CDbl(grd0.GetCellData("bd_cell23", 0)))  
						end if 
					end if 					
					
					Table1721.SetCellString(4, 1, grd0.GetCellData("bd_cell21", 0)) '보유잔고
					Table1721.SetCellString(5, 1, grd0.GetCellData("bd_cell12",  0))  'CFD결산분배금입금
					
				else  '매도
					'지급일자
					if Trim(grd0.GetCellData("bd_cell33",  0)) == "" then
						Table172.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table172.SetCellString(2, 1, "미정") 
					else
						Table172.SetCellString(2, 1, grd0.GetCellData("bd_cell33",  0)) 
					end if 
					
					'주당배당액 
					if grd0.GetCellData("bd_cell23", 0) <> nil then
						if CDbl(grd0.GetCellData("bd_cell23", 0)) > 0 then
							Table172.SetCellString(3, 1, CDbl(grd0.GetCellData("bd_cell23", 0)))  
						end if 
					end if 						
					Table172.SetCellString(4, 1, grd0.GetCellData("bd_cell21", 0)) '보유잔고
					Table172.SetCellString(5, 1, grd0.GetCellData("bd_cell20", 0)) '차입수량								
					Table172.SetCellString(6, 1, grd0.GetCellData("bd_cell13",  0)) 'CFD결산분배금출금
					
				end if
				
			else '지급
				'CFD배당금입금/CFD차입배당금출금
				if g_szPSTNCd == "1" then '매수
					'지급일자
					if Trim(grd0.GetCellData("bd_cell33",  0)) == "" then
						Table1711.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table1711.SetCellString(2, 1, "미정") 
					else
						Table1711.SetCellString(2, 1, grd0.GetCellData("bd_cell33",  0)) 
					end if 					
					Table1711.SetCellString(3, 1, grd0.GetCellData("bd_cell12",  0)) 'CFD결산분배금입금
					
				else  '매도
					'지급일자
					if Trim(grd0.GetCellData("bd_cell33",  0)) == "" then
						Table171.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table171.SetCellString(2, 1, "미정") 
					else
						Table171.SetCellString(2, 1, grd0.GetCellData("bd_cell33",  0)) 
					end if 				
					Table171.SetCellString(3, 1, grd0.GetCellData("bd_cell13",  0)) 'CFD결산분배금출금
					
				end if 					
			end if
	End Select
end Function 

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	grd0.rowcount = 0	
	szData = Form.GetOpenLinkData()	
	if szData <> "" then
		grd0.AddRow(0)
		tData = Split(szData, "★")
		For i = 0 to grd0.colcount -1  ' 33개
			grd0.SetCellData("bd_cell"&CStr(i), 0, tData(i))
		Next	
		
		g_szItemCd = tData(8) '종목코드
		g_szItemNm = tData(9) '종목코드
		g_szRghtCd = tData(4) '권리유형코드
		g_szRghtNm = tData(5) '권리유형명		
		g_szStatCd = tData(6) '상태처리코드		
		g_szStndDate = tData(10) '기준일
		g_szWrhsDate = tData(16) '입고일
		lblItem.caption = g_szItemNm
		
		lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 	
		
		'단수주수량이 0 이상일 경우에만 단수주지금일, 단수주금액이 보여짐
		'단수주수량은 소숫점(10자리)이나 금액은 정수로 나옴.. 23-10-18
		'단수주수량
		if grd0.GetCellData("bd_cell28", 0) <> nil then 
			g_szFRSKQty = CDbl(grd0.GetCellData("bd_cell28", 0))
			if g_szFRSKQty == "0" or g_szFRSKQty == 0 then
				g_szFRSKQty = ""
			end if
		else 
			g_szFRSKQty = ""
		end if 		
		'단수주대금(세전)
		if grd0.GetCellData("bd_cell22", 0) <> nil then 
			g_szFRSK = CDbl(grd0.GetCellData("bd_cell22", 0))
			if g_szFRSK == "0" or g_szFRSK == 0 then
				g_szFRSK = ""
'			else
'				g_szFRSK = g_szFRSK & " " & grd0.GetCellData("bd_cell11", 0) '단수주대금(세전)
			end if
		else 
			g_szFRSK = ""
		end if
		'단수주지급일
		g_szFRSKDate = Trim(grd0.GetCellData("bd_cell19", 0))

		'매매구분코드
		g_szPSTNCd = grd0.GetCellData("bd_cell7", 0) ' 1.매수 2.매도
		if g_szPSTNCd == "1" then
			g_szPSTNNm = "매수"
		elseif g_szPSTNCd == "2" then
			g_szPSTNNm = "매도"
		else
			g_szPSTNNm = ""
		end if
		
		SetVisible()
		SetData()

	else
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	Form.CloseForm()	
End Sub
	</SCRIPT_INFO>
</ROOT>