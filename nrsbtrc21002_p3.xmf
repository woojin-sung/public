	<SCRIPT_INFO _len="45699" _ulen="41901" >
'============================================================================
' 화 면 명 : CFD국내권리화면_권리상세
' 화면설명 : CFD국내권리화면의 상세 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szItemCd, g_szItemNm, g_szRghtCd, g_szRghtNm, g_szStatCd, g_szStndDate, g_szWrhsDate
Dim g_szFRSK, g_szFRSKDate, g_szFRSKQty, g_szASGM_RATE
Dim g_szPSTNCd, g_szPSTNNm
Dim g_Left, g_Top
g_Left = 12
g_Top = 265

Function SetVisible()
	Table012.left = 512 
	Select Case g_szRghtCd	
	
		Case "01" '01	유상
			if g_szStatCd == "2" then '예정
				Table012.left = g_Left 
				Table012.top = g_Top
				Table012.SetCellString(0, 1, g_szRghtNm)
				Table012.SetCellString(1, 1, g_szPSTNNm) '매매구분
				
			else
				Table011.left = g_Left 
				Table011.top = g_Top
				Table011.SetCellString(0, 1, g_szRghtNm)
				Table011.SetCellString(1, 1, g_szPSTNNm) '매매구분
			end if 
			
		Case "02" '02 무상		
			if g_szStatCd == "2" then '예정
				if g_szPSTNCd == "1" then '매수
					Table022.left = g_Left 
					Table022.top = g_Top
					Table022.SetCellString(0, 1, g_szRghtNm)
					Table022.SetCellString(1, 1, g_szPSTNNm) '매매구분
				else
					Table0221.left = g_Left
					Table0221.top = g_Top
					Table0221.SetCellString(0, 1, g_szRghtNm)
					Table0221.SetCellString(1, 1, g_szPSTNNm) '매매구분
				end if
			else '지급
				if g_szPSTNCd == "1" then '매수
					Table021.left = g_Left 
					Table021.top = g_Top
					Table021.SetCellString(0, 1, g_szRghtNm)
					Table021.SetCellString(1, 1, g_szPSTNNm) '매매구분
				else
					Table0211.left = g_Left 
					Table0211.top = g_Top
					Table0211.SetCellString(0, 1, g_szRghtNm)
					Table0211.SetCellString(1, 1, g_szPSTNNm) '매매구분
				end if
			end if 
			
		Case "03" '03	 배당(현금, 주식, 동시배당)		
			
			if g_szStatCd == "2" then
				if g_szPSTNCd == "1" then '매수
					if g_szRghtNm == "현금배당" then 
						Table0321.left = g_Left 
						Table0321.top = g_Top
						Table0321.SetCellString(0, 1, g_szRghtNm)
						Table0321.SetCellString(1, 1, g_szPSTNNm) '매매구분
					elseif g_szRghtNm == "주식배당" then
						Table0322.left = g_Left 
						Table0322.top = g_Top
						Table0322.SetCellString(0, 1, g_szRghtNm)
						Table0322.SetCellString(1, 1, g_szPSTNNm) '매매구분						
					elseif g_szRghtNm == "동시배당" then 
						Table0324.left = g_Left 
						Table0324.top = g_Top
						Table0324.SetCellString(0, 1, g_szRghtNm)
						Table0324.SetCellString(1, 1, g_szPSTNNm) '매매구분						
					end if 
				else
					if g_szRghtNm == "현금배당" then 
						Table032.left = g_Left 
						Table032.top = g_Top
						Table032.SetCellString(0, 1, g_szRghtNm)
						Table032.SetCellString(1, 1, g_szPSTNNm) '매매구분						
					elseif g_szRghtNm == "주식배당" then	
						Table0323.left = g_Left 
						Table0323.top = g_Top
						Table0323.SetCellString(0, 1, g_szRghtNm)
						Table0323.SetCellString(1, 1, g_szPSTNNm) '매매구분
					elseif g_szRghtNm == "동시배당" then 
						Table0325.left = g_Left 
						Table0325.top = g_Top
						Table0325.SetCellString(0, 1, g_szRghtNm)
						Table0325.SetCellString(1, 1, g_szPSTNNm) '매매구분
					end if 
				end if 
			else
				if g_szPSTNCd == "1" then '매수
					if g_szRghtNm == "현금배당" then 
						Table0311.left = g_Left 
						Table0311.top = g_Top
						Table0311.SetCellString(0, 1, g_szRghtNm)
						Table0311.SetCellString(1, 1, g_szPSTNNm) '매매구분
					elseif g_szRghtNm == "주식배당" then
						Table0312.left = g_Left 
						Table0312.top = g_Top
						Table0312.SetCellString(0, 1, g_szRghtNm)
						Table0312.SetCellString(1, 1, g_szPSTNNm) '매매구분
					elseif g_szRghtNm == "동시배당" then 
						Table0314.left = g_Left 
						Table0314.top = g_Top
						Table0314.SetCellString(0, 1, g_szRghtNm)
						Table0314.SetCellString(1, 1, g_szPSTNNm) '매매구분					
					end if 
				else
					if g_szRghtNm == "현금배당" then 
						Table031.left = g_Left 
						Table031.top = g_Top
						Table031.SetCellString(0, 1, g_szRghtNm)
						Table031.SetCellString(1, 1, g_szPSTNNm) '매매구분
					elseif g_szRghtNm == "주식배당" then
						Table0313.left = g_Left 
						Table0313.top = g_Top
						Table0313.SetCellString(0, 1, g_szRghtNm)
						Table0313.SetCellString(1, 1, g_szPSTNNm) '매매구분					
					elseif g_szRghtNm == "동시배당" then 
						Table0315.left = g_Left 
						Table0315.top = g_Top
						Table0315.SetCellString(0, 1, g_szRghtNm)
						Table0315.SetCellString(1, 1, g_szPSTNNm) '매매구분					
					end if 
				end if 
			end if
			
		Case "17", "28", "30" '17	ETF분배금 28	ETN분배금,  30 펀드분배금
			if g_szStatCd == "2" then
				if g_szPSTNCd == "1" then '매수
					Table1721.left = g_Left 
					Table1721.top = g_Top
					Table1721.SetCellString(0, 1, g_szRghtNm)
					Table1721.SetCellString(1, 1, g_szPSTNNm) '매매구분				
				else
					Table172.left = g_Left 
					Table172.top = g_Top
					Table172.SetCellString(0, 1, g_szRghtNm)
					Table172.SetCellString(1, 1, g_szPSTNNm) '매매구분
				end if 
			else
				if g_szPSTNCd == "1" then '매수
					Table1711.left = g_Left 
					Table1711.top = g_Top
					Table1711.SetCellString(0, 1, g_szRghtNm)
					Table1711.SetCellString(1, 1, g_szPSTNNm) '매매구분
				else
					Table171.left = g_Left 
					Table171.top = g_Top
					Table171.SetCellString(0, 1, g_szRghtNm)
					Table171.SetCellString(1, 1, g_szPSTNNm) '매매구분
				end if 
			end if 			
				
	End Select
end Function

'02  무상(매수)(예정,지급) : CFD단수주지급일자, CFD무상단수주매각대금입금
'03	 배당(현금(X), 주식, 동시배당)(매수,매도)(예정,지급) : CFD단수주지급일자, CFD무단수주대금

Function SetData()
	
	Select Case g_szRghtCd	
		Case "01" '01	유상
			if g_szStatCd == "2" then '예정

				'신주인수권이 있는 경우 
				if InStr(grd0.GetCellData("bd_cell38", 0), "J") > 0 or InStr(grd0.GetCellData("bd_cell38", 0), "j") > 0 then
				
					Table012.SetCellMaskInfo(2, 1, "0,0,,주,0,,-1,1,0,0,0" )
					Table012.SetCellMaskInfo(3, 1, "0,0,,주,0,,-1,1,0,0,0" )
					if g_szPSTNCd == "1" then '매수
						Table012.SetCellString(2, 0, "CFD보유잔고") 
						Table012.SetCellString(2, 1, grd0.GetCellData("bd_cell21",  0)) 'CFD보유잔고
						Table012.SetCellString(3, 1, grd0.GetCellData("bd_cell14",  0)) '배정주수
					else
						Table012.SetCellString(2, 0, "CFD차입수량") 
						Table012.SetCellString(2, 1, grd0.GetCellData("bd_cell20",  0)) 'CFD차입배정주수
						Table012.SetCellString(3, 0, "CFD차입배정주수") 
						Table012.SetCellString(3, 1, grd0.GetCellData("bd_cell15",  0)) '배정주수
					end if 
					
					'배정비율
					Table012.SetCellMaskInfo(4, 1, "0,0,,%,0,,-1,1,0,0,0" )
					if grd0.GetCellData("bd_cell18", 0) <> nil then
						if CDbl(grd0.GetCellData("bd_cell18", 0)) > 0 then
							Table012.SetCellString(4, 1, CDbl(grd0.GetCellData("bd_cell18", 0)))  
						end if 
					end if 
				
					'CFD유상증서매각대금입금/CFD유상증서차입매각대금출금
					Table012.SetCellMaskInfo(5, 1, "0,0,,원,0,,0,1,0,0,0")
					if g_szPSTNCd == "1" then '매수
						Table012.SetCellString(5, 0, "CFD유상증서매각대금입금")
						Table012.SetCellString(5, 1, grd0.GetCellData("bd_cell12",  0)) 
					else  '매도 - 없음
						Table012.SetCellString(5, 0, "CFD유상증서차입매각대금출금") 
						Table012.SetCellString(5, 1, grd0.GetCellData("bd_cell13",  0)) 
					end if
					
					Table012.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0") 
					Table012.SetCellString(6, 0, "")
					Table012.SetCellString(6, 1, "")
					Table012.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0") 
					Table012.SetCellString(7, 0, "")
					Table012.SetCellString(7, 1, "")					
					Table012.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0") 
					Table012.SetCellString(8, 0, "")
					Table012.SetCellString(8, 1, "")
				else
					Table012.SetCellString(2, 0, "배정주수")
					Table012.SetCellMaskInfo(2, 1, "0,0,,주,0,,-1,1,0,0,0" )
					Table012.SetCellString(2, 1, grd0.GetCellData("bd_cell34",  0)) '배정주수
					
					'배정비율
					Table012.SetCellMaskInfo(3, 1, "0,0,,%,0,,-1,1,0,0,0" )
					Table012.SetCellString(3, 0, "배정비율")
					if grd0.GetCellData("bd_cell18", 0) <> nil then
						if CDbl(grd0.GetCellData("bd_cell18", 0)) > 0 then
							Table012.SetCellString(3, 1, CDbl(grd0.GetCellData("bd_cell18", 0)))  
						end if 
					end if 
					
					Table012.SetCellString(4, 0, "본청약수량")
					Table012.SetCellMaskInfo(4, 1, "0,0,,주,0,,-1,1,0,0,0" )
					Table012.SetCellString(4, 1, grd0.GetCellData("bd_cell25", 0))  '본청약수량
					Table012.SetCellString(5, 0, "초과청약수량")
					Table012.SetCellMaskInfo(5, 1, "0,0,,주,0,,-1,1,0,0,0" )
					Table012.SetCellString(5, 1, grd0.GetCellData("bd_cell26", 0))  '초과청약수량 
					
					Table012.SetCellString(6, 0, "참여요청수량")
					Table012.SetCellMaskInfo(6, 1, "0,0,,주,0,,-1,1,0,0,0" )
					Table012.SetCellString(6, 1, grd0.GetCellData("bd_cell36", 0))  '참여요청수량 
					Table012.SetCellString(7, 0, "초과참여요청수량")
					Table012.SetCellMaskInfo(7, 1, "0,0,,주,0,,-1,1,0,0,0" )
					Table012.SetCellString(7, 1, grd0.GetCellData("bd_cell37", 0))  '초과참여요청수량 
					Table012.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0") 
					Table012.SetCellString(8, 0, "")
					Table012.SetCellString(8, 1, "")
				end if

			else '지급
				'Table011.SetCellString(2, 1, grd0.GetCellData("bd_cell17",  0)) '배정주수				
				'Table011.SetCellString(2, 1, grd0.GetCellData("bd_cell14",  0)) '입고수량				
				'신주인수권이 있는 경우 
				if InStr(grd0.GetCellData("bd_cell38", 0), "J") > 0 or InStr(grd0.GetCellData("bd_cell38", 0), "j") > 0 then	
'					'CFD유상증서매각대금입금/CFD유상증서차입매각대금출금
'					if g_szPSTNCd == "1" then '매수
'						Table011.SetCellString(3, 0, "CFD유상증서매각대금입금")
'						Table011.SetCellString(3, 1, grd0.GetCellData("bd_cell12",  0)) 
'					else  '매도 
'						Table011.SetCellString(3, 0, "CFD유상증서차입매각대금출금") 
'						Table011.SetCellString(3, 1, grd0.GetCellData("bd_cell13",  0)) 
'					end if 
					'CFD유상증서매각대금입금/CFD유상증서차입매각대금출금
					Table011.SetCellMaskInfo(2, 1, "0,0,,원,0,,0,1,0,0,0")
					if g_szPSTNCd == "1" then '매수
						Table011.SetCellString(2, 0, "CFD유상증서매각대금입금")
						Table011.SetCellString(2, 1, grd0.GetCellData("bd_cell12",  0)) 
					else  '매도 
						Table011.SetCellString(2, 0, "CFD유상증서차입매각대금출금") 
						Table011.SetCellString(2, 1, grd0.GetCellData("bd_cell13",  0)) 
					end if 
					
					Table011.SetCellMaskInfo(3, 1, "1,0,,,1,,0,0,1,0,0") 
					Table011.SetCellString(3, 0, "")
					Table011.SetCellString(3, 1, "") 					
					
				else	
					Table011.SetCellString(2, 1, grd0.GetCellData("bd_cell14",  0)) '입고수량				
					Table011.SetCellMaskInfo(3, 1, "1,0,,,1,,0,0,1,0,0") 
					Table011.SetCellString(3, 0, "")
					Table011.SetCellString(3, 1, "") 	
				end if 
			end if			
			
		Case "02" '02 무상	

			if g_szStatCd == "2" then  '예정			
				if g_szPSTNCd == "1" then '매수	
				
					Table022.SetCellString(2, 1, grd0.GetCellData("bd_cell21",  0)) '보유잔고
					Table022.SetCellString(3, 1, grd0.GetCellData("bd_cell17",  0)) '배정주수
					
					'배정비율
					if grd0.GetCellData("bd_cell18", 0) <> nil then
						if CDbl(grd0.GetCellData("bd_cell18", 0)) > 0 then
							Table022.SetCellString(4, 1, CDbl(grd0.GetCellData("bd_cell18", 0)))  
						end if 
					end if 
				
					Table022.SetCellString(5, 1, grd0.GetCellData("bd_cell16", 0)) '입고일자
					Table022.SetCellString(6, 1, grd0.GetCellData("bd_cell14", 0)) 'CFD입고수량
					
					'단수주수
					if Trim(g_szFRSKQty) == "" then
						Table022.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0")
						Table022.SetCellString(7, 0, "")					
						Table022.SetCellString(7, 1, "")					
					else
						'Table022.SetCellMaskInfo(7, 1, "0,0,,주,1,,0,1,0,0,0" )
						Table022.SetCellString(7, 1, g_szFRSKQty) 'CFD단수주수
					end if 					
					
					'단수주수 또는 단수주지급일자
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
						Table022.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")
						Table022.SetCellString(8, 0, "")
						Table022.SetCellString(8, 1, "")
					else
						Table022.SetCellString(8, 1, g_szFRSKDate) 'CFD단수주지급일자
					end if 
				
					'단수주수 또는 단주수매각대금입금
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
						Table022.SetCellMaskInfo(9, 1, "1,0,,,1,,0,0,1,0,0")
						Table022.SetCellString(9, 0, "")					
						Table022.SetCellString(9, 1, "")					
					else					
						'Table022.SetCellMaskInfo(9, 1, "0,0,,원,0,,0,1,0,0,0")
						Table022.SetCellString(9, 1, g_szFRSK) 'CFD단주수매각대금입금
					end if

				else  '매도
					Table0221.SetCellString(2, 1, grd0.GetCellData("bd_cell21",  0)) '보유잔고
					Table0221.SetCellString(3, 1, grd0.GetCellData("bd_cell17",  0)) '배정주수
					Table0221.SetCellString(4, 1, grd0.GetCellData("bd_cell20", 0)) 'CFD차입수량					
					Table0221.SetCellString(5, 1, grd0.GetCellData("bd_cell15", 0)) 'CFD차입배정수량   				
					
					'배정비율
					if grd0.GetCellData("bd_cell18", 0) <> nil then
						if CDbl(grd0.GetCellData("bd_cell18", 0)) > 0 then
							Table0221.SetCellString(6, 1, CDbl(grd0.GetCellData("bd_cell18", 0)))  
						end if 
					end if 
					
					Table0221.SetCellString(7, 1, grd0.GetCellData("bd_cell16", 0)) '입고일자
					
					'CFD단수주수
					if Trim(g_szFRSKQty) == "" then
						Table0221.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")
						Table0221.SetCellString(8, 0, "")					
						Table0221.SetCellString(8, 1, "")					
					else
						'Table0221.SetCellMaskInfo(8, 1, "0,0,,주,1,,0,1,0,0,0" )
						Table0221.SetCellString(8, 1, g_szFRSKQty) 'CFD단수주수
					end if 					
					
					'CFD단수주대금지급일자
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
						Table0221.SetCellMaskInfo(9, 1, "1,0,,,1,,0,0,1,0,0")
						Table0221.SetCellString(9, 0, "")
						Table0221.SetCellString(9, 1, "")
					else
						Table0221.SetCellString(9, 1, g_szFRSKDate) 'CFD단수주대금지급일자
					end if 
				
					'CFD단수주대금
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
						Table0221.SetCellMaskInfo(10, 1, "1,0,,,1,,0,0,1,0,0")
						Table0221.SetCellString(10, 0, "")					
						Table0221.SetCellString(10, 1, "")					
					else					
						Table0221.SetCellMaskInfo(10, 1, "0,0,,원,0,,0,1,0,0,0")
						Table0221.SetCellString(10, 1, g_szFRSK) 'CFD단수주대금
					end if 
					
				end if 
				
			else '지급
				if g_szPSTNCd == "1" then '매수			
					Table021.SetCellString(2, 1, grd0.GetCellData("bd_cell16", 0)) '입고일자
					Table021.SetCellString(3, 1, grd0.GetCellData("bd_cell14", 0)) 'CFD입고수량
					
					'단수주수
					if Trim(g_szFRSKQty) == "" then
						Table021.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")
						Table021.SetCellString(4, 0, "")					
						Table021.SetCellString(4, 1, "")					
					else
						'Table021.SetCellMaskInfo(4, 1, "0,0,,주,1,,0,1,0,0,0" )
						Table021.SetCellString(4, 1, g_szFRSKQty) 'CFD단수주수
					end if 	
					
					'단수주수 또는 단수주지급일자
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
						Table021.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")
						Table021.SetCellString(5, 0, "")
						Table021.SetCellString(5, 1, "")
					else
						Table021.SetCellString(5, 1, g_szFRSKDate) 'CFD단수주지급일자
					end if 
				
					'단수주수 또는 단주수매각대금입금
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
						Table021.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0")
						Table021.SetCellString(6, 0, "")					
						Table021.SetCellString(6, 1, "")					
					else
						'Table021.SetCellMaskInfo(6, 1, "0,0,,원,0,,0,1,0,0,0")
						Table021.SetCellString(6, 1, g_szFRSK) 'CFD단주수매각대금입금	
					end if 					
				
				else
					Table0211.SetCellString(2, 1, grd0.GetCellData("bd_cell16", 0)) '입고일자
					Table0211.SetCellString(3, 1, grd0.GetCellData("bd_cell14", 0)) '배정수량
					Table0211.SetCellString(4, 1, grd0.GetCellData("bd_cell15", 0)) 'CFD차입배정수량
					
					'단수주수
					if Trim(g_szFRSKQty) == "" then
						Table0211.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")
						Table0211.SetCellString(5, 0, "")					
						Table0211.SetCellString(5, 1, "")					
					else
						'Table0211.SetCellMaskInfo(5, 1, "0,0,,주,1,,0,1,0,0,0" )
						Table0211.SetCellString(5, 1, g_szFRSKQty) 'CFD단수주수
					end if 	
					
					'단수주수 또는 단수주지급일자
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
						Table0211.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0")
						Table0211.SetCellString(6, 0, "")
						Table0211.SetCellString(6, 1, "")
					else
						Table0211.SetCellString(6, 1, g_szFRSKDate) 'CFD단수주지급일자
					end if 
				
					'단수주수 또는 단주수매각대금입금
					if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
						Table0211.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0")
						Table0211.SetCellString(7, 0, "")					
						Table0211.SetCellString(7, 1, "")					
					else
						'Table0211.SetCellMaskInfo(7, 1, "0,0,,원,0,,0,1,0,0,0")
						Table0211.SetCellString(7, 1, g_szFRSK) 'CFD단주수매각대금입금	
					end if 					
				end if 
				
			end if 
			
		Case "03" '03	 배당(현금, 주식, 동시배당)
			Dim szCash
			if InStr(g_szRghtNm, "현금") > 0 then '현금배당의 경우 단수주관련 데이터 삭제
				szCash = true 
			else
				szCash = false
			end if		
			
			lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 
 
			if g_szStatCd == "2" then '예정
			
				'CFD배당금입금/CFD차입배당금출금
				if g_szPSTNCd == "1" then '매수
				
					if g_szRghtNm == "현금배당" then

						'지급일자
						if Trim(grd0.GetCellData("bd_cell33",  0)) == "" then
							Table0321.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
							Table0321.SetCellString(2, 1, "미정") 
						else
							Table0321.SetCellString(2, 1, grd0.GetCellData("bd_cell33",  0)) 
						end if 
						
						'주당배당액
						if grd0.GetCellData("bd_cell23", 0) <> nil then
							if CDbl(grd0.GetCellData("bd_cell23", 0)) > 0 then
								Table0321.SetCellString(3, 1, CDbl(grd0.GetCellData("bd_cell23", 0)))  
							end if 
						end if 
						Table0321.SetCellString(4, 1, grd0.GetCellData("bd_cell21", 0)) '보유잔고
						Table0321.SetCellString(5, 1, grd0.GetCellData("bd_cell12",  0))  'CFD배당상당액입금
						
					elseif g_szRghtNm == "주식배당" then					
						'지급일자
						if Trim(grd0.GetCellData("bd_cell16",  0)) == "" then
							Table0322.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
							Table0322.SetCellString(2, 1, "미정") 
						else
