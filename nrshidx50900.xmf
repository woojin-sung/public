			<CONTROL_INFO>
				<LABEL name="lblContMainBg" caption=" " transmode="0" ly_vert="0,0,375,66,1" />
				<BUTTON name="btn50900" caption="절세 투자" fgcolor="013:051051051" fontsize="-2" fontstyle="01" ly_vert="20,10,105,36,1" />
				<BUTTON name="btn50910" caption="세금이야기" fgcolor="013:051051051" fontsize="-2" ly_vert="135,10,105,36,1" />
				<BUTTON name="btn50920" caption="세무 캘린더" fgcolor="013:051051051" fontsize="-2" ly_vert="250,10,105,36,1" />
				<CONTAINER name="contSub" vscroll="1" ly_vert="0,66,375,599,1" scroll_ly_vert="0,66,375,599,1" >
					<CONTROL_INFO>
						<LINKFORM name="linkfmS1" linkfile="nrshidx50900_s1" ly_vert="16,18,343,412,1" />
						<LINKFORM name="linkfmS2" linkfile="nrshidx50900_s2" ly_vert="16,440,343,412,1" />
						<LINKFORM name="linkfmS3" linkfile="nrshidx50900_s3" ly_vert="16,862,343,479,1" />
					</CONTROL_INFO>
				</CONTAINER>
				<LINKFORM name="linkfm50910" linkfile="nrshidx50910" visible="0" ly_vert="0,66,375,655,0" />
