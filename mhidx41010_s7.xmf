	<SCRIPT_INFO _len="21170" _ulen="18544" >
'============================================================================
' 01. 화 면 명 : 메리츠TOP50
' 02. 화면설명 : 메리츠TOP50
' 03. 작    성 : 2016. 02. 15. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCode			'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START
Dim g_nHour			'시간
Dim g_nMinute			'분

'20211005 아이티젠(김성수) START
'시장종합 개편 추가
dim	g_szRSelect
g_szRSelect = "0"
'20211005 아이티젠(김성수) END

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'20211005 아이티젠(김성수) START
'시장종합 개편 추가
'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	Select Case szMk
		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(예상가)
'				DATAMANAGER.SetDataValue(1, "ohhts_antc_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)
			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 시간외단일호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if
			
		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			end if 
			
		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동				
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동	
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			end if 
			
		Case "U"		' 업종코드
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_antg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 예상체결 자동갱신										
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
			end if 
		
		Case "T"		' K-OTC(프리보드)
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 시간외단일호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if 
		
		Case "W"		' ELW
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(예상가)
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
			end if 
			
		Case "N"	' 해외지수
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		
		Case "B"	' 소액채권, 장내채권
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_aspr", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
			end if
			
		Case "EN"		' 세계환율
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 			

	End Select
End Function

'============================================================================
' Real_RequestData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Real_RequestData(szMk)
	
	Select Case szMk
		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
				DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' 주식호가 자동갱신(예상가)
				DATAMANAGER.RequestRealData("ohhts_antc_cntg")
			elseif g_szRSelect == "2" then
				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")		' 시간외단일호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
			end if
			
		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_futs_aspr")		' 선물 호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
			end if 
			
		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동				
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_aspr")		' 옵션 호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
			end if 
			
		Case "U"		' 업종코드
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_nmix_antg")		' 업종지수 예상체결 자동갱신										
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			end if 
		
		Case "T"		' K-OTC(프리보드)
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' 주식호가 자동갱신
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")		' 시간외단일호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신
			end if 
		
		Case "W"		' ELW
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_elw_aspr")			' ELW호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
			end if 

		Case "N"	' 해외지수
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		
		Case "B"	' 소액채권, 장내채권
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_bond_aspr")		' 일반채권 호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if
			
		Case "EN"		' 세계환율
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if			
	End Select
End Function
'20211005 아이티젠(김성수) END
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	Dim listLocation
	Dim nYPos
	Dim height
	
	listLocation = Split(grd0.location, ":")
	nYPos = Int(listLocation[1])	'y위치
	height = listLocation[3]		'높이
	
	sPopupType = "0"

	g_szCode = DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , lRow)

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_nCount = 0

	DATAMANAGER.SetDataValue( 0 , "ohhts_top50_002", "InBlock1", "FID_INPUT_MDIA_CLS_CODE" , 0 , Form.getDeviveID() )

'	DATAMANAGER.RequestTranData("ohhts_1020_001r")
	DATAMANAGER.RequestTranData("ohhts_top50_002")
	
	grd0.fontbold = "1"
	'Label1.bgcolor = "250250250"
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp			'시간값 임의 저장
	
	if szTranID == "ohhts_top50_002" then
		szTemp = DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock1", "FID_HOUR" , 0)
		g_nHour = Left(szTemp, 2)
		g_nMinute = Mid(szTemp , 3, 2)
		
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ohhts_top50_002", "OutBlock2") - 1
			Select Case DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_PRDY_VRSS_SIGN" , i)
				Case 2
					grd0.SetCellFgColor( "bd_cell3", i, "1")
				Case 5
					grd0.SetCellFgColor( "bd_cell3", i, "2")
			End Select
		next
		
		lblTime.caption = g_nHour&"시"&g_nMinute&"분 기준"

		DATAMANAGER.RequestTranData("ohhts_1020_001r")
	elseif szTranID = "ohhts_1020_001r" then
		for i = grd0.rowcount - 1 to 0 step -1
			if grd0.GetCellData( "bd_cell2", i) == "" then
				grd0.SetDeleteRow( i )
			end if
		next
		
		'20210916 SWJ START
		g_nCount = 0
		
		for i = 0 to 4
			if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , i) <> "" then
				g_nCount = g_nCount + 1
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , grd1.GetCellData("bd_cell1", i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_ISCD" , i , grd1.GetCellData("bd_cell0", i))
				grd0.SetCellData( "bd_cell0" , g_nCount-1 , g_nCount)
				
'				20211020 HSZ START : 주석처리 - 한글 바이트 수 안맞아서 깨지는 현상 발생
				'종목글자 애매하게 잘려 보이는 부분 방지
				'적당히 최대글자라고 생각되는길이로 미리 자르기
'				stmpStr = grd0.GetCellData("bd_cell2", g_nCount-1)
'				
'				if len(stmpStr) > 15 then
'					grd0.SetCellData("bd_cell2", g_nCount-1 , Left(stmpStr,15))
'				end if
'				20211020 HSZ END
			end if
			
		next
		'20210916 SWJ END
		
		'20211005 아이티젠(김성수) START
		'시장종합 개편 추가
		' 실시간을 위한 작업 //////////////////////////////////////////////
		For j = 0 to 4
			Dim szCd, szMk
			szCd = grd0.GetCellData("bd_cell6", j)
			
			if szCd <> "" then
				szMk = Form.GetItemCodeInfo(szCd, "market")
				
				if szMk <> "" then
					Set_Real_Input(szMk, j, szCd)
					Real_RequestData(szMk)
'					
				end if
			end if
		Next
		'20211005 아이티젠(김성수) END
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1020_001r" then
		for i = 0 to 4'DATAMANAGER.GetDataCount( 0 , "ohhts_top50_002", "OutBlock2") - 1
			if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , i) <> "" then
				g_nCount = g_nCount + 1
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , grd1.GetCellData("bd_cell1", i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_ISCD" , i , grd1.GetCellData("bd_cell0", i))
				grd0.SetCellData( "bd_cell0" , g_nCount-1 , g_nCount)
			end if
			
			if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_SCR_NO" , i) <> "00000000" then	'20160510 LKM (00000000: 기존 99999999: 신규)
				grd0.SetCellData( "bd_cell7", i, "신규")
			end if
		next
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID == "ohhts_top50_002" then
		Form.ShowAlert(szErrCode, szErrMsg)
		DATAMANAGER.RequestTranData("ohhts_1020_001r")
	elseif szTranID = "ohhts_1020_001r" then
		Form.ShowAlert(szErrCode, szErrMsg)
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList

	if g_szCode == "" then
		Exit Sub
	end if
	
	if sKeyName == "MOVEPOP_RETURN" then
		szList = Split(sRet , "★")
		
		Select Case szList(1)
			Case "0"		'현재가
				Form.OpenScreen("11000" , g_szCode & "★" & "0")
			Case "1" 	'차트
				Form.OpenScreen("13000" , g_szCode)
			Case "2" 	'관심등록
				Form.OpenPopup( "mhprc11000_pd" , g_szCode , sPosInfo)
			Case "3" 	'매수
				Form.OpenScreen("12000" , "관심종목" & "★" & "0" & "★" & g_szCode)
			Case "4" 	'매도
				Form.OpenScreen("12000" , "관심종목" & "★" & "1" & "★" & g_szCode)
		End Select
	
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	Form_OnFormInit()
	
End Sub

'============================================================================
Sub lbl0_OnClick()
	Form.OpenScreen("21000" , "")
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.OpenScreen("21000" , "")
End Sub


