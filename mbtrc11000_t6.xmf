	<SCRIPT_INFO _len="5695" _ulen="5362" >
'============================================================================
'20230309 SWJ START
'============================================================================
Dim g_AcctInfo						'안심/일반계좌여부 판단
Dim g_szDeviceOS
'============================================================================
Sub Form_OnFormInitBefore()
	Cont0.Cont2.Imgicon.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Cont0.setScrollBarVisible("0")
	Cont0.Cont2.setScrollBarVisible("0")
	
	Cont0.Cont2.lblJangTitle.setNeighborCtlPos("Imgicon", "right", 5, "")	'AOS폴드폰 대응
	
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	
	Form.SetTimerEvent2(1, 1, 0.1)
'	Cont0.Cont2.lbl1.setHighlight(332)
'	Cont0.Cont2.lbl2.setHighlight(332)
'	Cont0.Cont2.lbl3.setHighlight(332)
'	Cont0.Cont3.lbl4.setHighlight(332)
'	Cont0.Cont3.lbl5.setHighlight(332)
End Sub

'============================================================================
Sub Cont0_Cont2_Imgicon_OnClick()
	Cont0.Cont2.Imgicon.openToolTip("현재가를 기준으로 기본 증거금을 재산정합니다.",320, 50, 1)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHANGE_ACCTNO" or sEventName == "RECEIVE" then
		g_AcctInfo = sParam
		Decide_IlbanAnsim()
		DATAMANAGER.RequestTranData("obtrc_comm_211r")
	end if
End Sub

'============================================================================
Sub Decide_IlbanAnsim()

	'안심
	if g_AcctInfo == "B" then
'		Cont0.tblGeung.SetCellString(6, 1, "계좌평가금액")
'		Cont0.lbl0.caption = "계좌평가금액"
'		Cont0.lbl0.setHighlight(332)
		
		Cont0.Cont3.left = 0      '보이기
		
		Cont0.Cont2.left = 1000   '숨기기
		Cont0.Cont2.height = 200  '스크롤 방지 처리
		
		Cont0.Cont2.tblJang.visible = false
		Cont0.Cont2.lblJangTitle.visible = false
		Cont0.Cont2.lblLine0.visible = false
		Cont0.Cont2.Imgicon.visible = false
		
		f_SettingUI_A()
		Cont0.SetScrollAutoSize()
	
	else
'		Cont0.tblGeung.SetCellString(6, 1, "계좌평가금액(A)")
'		Cont0.lbl0.caption = "계좌평가금액(A)"
'		Cont0.lbl0.setHighlight(332)
		
		
		Cont0.Cont3.left = 1000   '숨기기
		
		Cont0.Cont2.left = 0      '보이기
		Cont0.Cont2.height = 420  '스크롤 원복 처리
		
		Cont0.Cont2.tblJang.visible = true
		Cont0.Cont2.lblJangTitle.visible = true
		Cont0.Cont2.lblLine0.visible = true
		Cont0.Cont2.Imgicon.visible = true
		
		f_SettingUI_G()
		Cont0.SetScrollAutoSize()
		Cont0.Cont2.SetScrollAutoSize()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtrc_comm_211r" then
	
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO", 0, szASNO )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
' 라벨 컨트롤
'============================================================================
Function f_SettingUI_A()
		Cont0.lbl0.caption = "계좌평가금액"
		Cont0.lbl0.setHighlight(332)
		
		Cont0.Cont3.lbl4.caption = "주문가능금액"
		Cont0.Cont3.lbl4.setHighlight(332)
		Cont0.Cont3.lbl5.caption = "출금가능금액"
		Cont0.Cont3.lbl5.setHighlight(332)
		
		Cont0.Cont2.lbl1.removeHighlight()
		Cont0.Cont2.lbl1.caption = ""
		Cont0.Cont2.lbl2.removeHighlight()
		Cont0.Cont2.lbl2.caption = ""
		Cont0.Cont2.lbl3.removeHighlight()
		Cont0.Cont2.lbl3.caption = ""
End Function 

Function f_SettingUI_G()
		Cont0.lbl0.caption = "계좌평가금액(A)"
		Cont0.lbl0.setHighlight(332)
		
		Cont0.Cont2.lbl1.caption = "계좌증거금률(A+B)÷C"
		Cont0.Cont2.lbl1.setHighlight(332)
		Cont0.Cont2.lbl2.caption = "주문가능금액"
		Cont0.Cont2.lbl2.setHighlight(332)
		Cont0.Cont2.lbl3.caption = "출금가능금액"
		Cont0.Cont2.lbl3.setHighlight(332)
		
		Cont0.Cont3.lbl4.removeHighlight()
		Cont0.Cont3.lbl4.caption = ""
		Cont0.Cont3.lbl5.removeHighlight()
		Cont0.Cont3.lbl5.caption = ""
End Function 

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) = 1 then
		Form.SetTimerEvent2(1, 0, 0.1)
		f_SettingUI_G()
	end if 
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
        If szTranID == "obtrc_comm_211r" Then
                szCFD_MNTN_MARG_RATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_MNTN_MARG_RATE", 0)
                Cont0.Cont2.tblJang.SetCellString( 1, 0, "유지증거금(" & FormatNumber(szCFD_MNTN_MARG_RATE, 0) & "%)")
		       
		       ll_stnd_amt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_SBSN_FEE_STND_AMT", 0)  '(v001) 대용 관련 추가
		       ld_stnd_amt = ll_stnd_amt / 100000000                                                           '(v001) 대용 관련 추가
		       Cont0.Cont2.tblYe.SetCellString( 1, 1, "대용사용(" & ld_stnd_amt & "억 초과)")                  '(v001) 대용 관련 추가
	end if
End Sub

