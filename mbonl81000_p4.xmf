	<SCRIPT_INFO _len="17778" _ulen="16828" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 	: 고객연락처변경
' 02. 화면설명 	: 고객연락처변경_우편번호검색
' 03. 작    성 	: 2016.01.25 김보라
' 04. 수    정	: 2017.04.17 윤유정 : 신 주소 검색 시 입력한 건물번호 상세주소란으로 자동 셋팅되도록 수정(&문구수정) v0001
'				: 2023.04.14 신명준 : 통합검색(카카오MAP API) 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sRetData
Dim g_nNextFlag
Dim g_Post
Dim g_Dtad
Dim g_BLDN_MNNO
Dim g_nFlag
Dim g_DeviceOS

'===========================================================================
' 							FORM 함수
'===========================================================================
Sub Form_OnFormInit()
	g_sRetData	= "cancel"
	g_nNextFlag	= false
	
	Form.SetScreenName("우편번호 검색")
	FormTab0_OnTabChanged(0)	
	
	EditDtlAddr.imagefilepth = "login_input.9.png"
	
	'========================================================================
	' 앱<->웹 연동을 위한 필수 세팅 
	'========================================================================
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if g_DeviceOS == "1" then
		WebView0.SetUserAgent("meritz_android")
	elseif g_DeviceOS == "2" then
		WebView0.SetUseJavaScript("1")
		WebView0.SetUserAgent("meritz_ios")
	end if
	
	f_SyncKAKAO() ' 카카오 주소검색 페이지 연동
End Sub

'===========================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'========================================================================
	' 주소선택 후(통합검색 카카오API)
	'========================================================================
	if sEventName == "WebViewReturn" then
		Grid3.visible 		= true
		EditDtlAddr.visible 	= true
		EditDtlAddr.caption	= ""
		
'		arrData(0) : 도로명주소 / arrData(1) : 지번주소 / arrData(2) : 우편번호
		arrData = Split(sParam , "@")

		if arrData(0) == "" or arrData(0) == null then
			g_nFlag = "지번주소"
			Grid3.SetCellData("BD_POST", 0, arrData(2))
		else
			g_nFlag = "도로명주소"
			Grid3.SetCellData("BD_POST", 0, arrData(0).." "..arrData(1))
		end if

		Grid3.SetCellData("BD_ZIP", 0, arrData(3))
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0.3)
	
	if Cint(sTimerID) = 1 then

		if g_DeviceOS == "2" then
			WebView0.SetUseJavaScript("1")
			WebView0.SetUserAgent("meritz_ios")
		end if
		
		f_SyncKAKAO() ' 카카오 주소검색 페이지 연동
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81000_p4" , g_sRetData)
End Sub

'===========================================================================
' 							DATAMANAGER 함수
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	if szTranID == "obcpp_zipa_010r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ROAD_NAME", 	0, EditInput.caption)

	elseif szTranID == "obcpp_zipa_011r" then	
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ADDR", 		0, g_Post)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if DATAMANAGER.GetDataMsgCode(szTranID) == "5820" then
		Form.MsgBox("알림", DATAMANAGER.GetDataMsgText(szTranID), "", 6)
	end if
	
	if szTranID == "obcpp_zipa_010r" then
		g_nNextFlag = DATAMANAGER.IsMoreNextData(szTranID)

		Dim nCnt, nIndex
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		
		if nCnt > 0 then
			Dim REGN_ZIP, DTL_ZIP
			nIndex = Grid0.rowcount - nCnt
			
			for i = 0 to nCnt - 1
				REGN_ZIP	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REGN_ZIP",	i)
				DTL_ZIP	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "DTL_ZIP",	i)

				Grid0.SetCellData("bd_zip", nIndex, REGN_ZIP..DTL_ZIP)
				
				nIndex = nIndex + 1
			next
			
			Label0.visible = false
		else
			Label0.visible = true
		end if
		
	elseif szTranID == "obcpp_zipa_011r" then
		g_Post = ""
		
		if FormTab0.currenttabpageid == "page0" then
			g_Post		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "POST", 		0)
			g_Dtad		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "DTAD", 		0)
			g_BLDN_MNNO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "BLDN_MNNO",	0)
			
		else		
			Dim nCnt1, nCnt2, sPost, sDtad
			nCnt1 = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
			nCnt2 = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock2")

			if nCnt1 > 0 then
			
				for i = 0 to nCnt1 - 1
					sPost = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "POST", i)
					sDtad = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "DTAD", i)
	
					Grid1.AddRow()
					Grid1.SetCellData("bd_address", i, sPost.." "..sDtad)
					Grid1.SetCellData("bd_post", 	i, sPost)
					Grid1.SetCellData("bd_dtad",	i, sDtad)
				next

			end if
			
			if nCnt2 > 0 then
				
				for i = 0 to nCnt2 - 1
					sPost = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "POST", 		i)
					sDtad = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "DTAD", 		i)
					sBldn = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "BLDN_MNNO",	i)

					Grid2.AddRow()
					Grid2.SetCellData("bd_address", i, sPost.." "..sDtad)
					Grid2.SetCellData("bd_post", 	i, sPost)
					Grid2.SetCellData("bd_dtad",	i, sDtad)
					Grid2.SetCellData("bd_bldn", 	i, sBldn)
					Grid2.SetCellData("bd_check",	i, "1")
				next
				
			end if

		end if
		
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSumMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & " " & sSumMsg)
End Sub

'===========================================================================
' 							CONTORL 함수
'===========================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	f_ControlSet(nCurrentTab)
	
	f_ResetSharedData()
	
	' 통합검색
	if nCurrentTab == 0 then		
		Grid3.SetCellData("BD_POST", 	0, "")
		Grid3.SetCellData("BD_ZIP", 	0, "")

		EditDtlAddr.caption = ""
		
		Form.SetTimerEvent2(1, 1, 0.3)
	
	' 일반검색
	else
		EditInput.caption 		= ""
		Grid0.rowcount 			= 0
		Grid1.rowcount 			= 0
		Grid2.rowcount 			= 0
		EditInputAddress.caption 	= ""
		EditInputAddress1.caption 	= ""
	end if

End Sub

'============================================================================
' 통합검색 : 상세주소
'============================================================================
Sub EditDtlAddr_OnEditComplete()

	if Grid3.GetCellData("BD_POST", 0) == "" or Grid3.GetCellData("BD_POST", 0) == null then
		EditDtlAddr.caption = ""
		
		Form.MsgBox("알림", "기본주소를 검색하세요.", "", 6)
	else
		g_Post = Grid3.GetCellData("BD_POST", 0).." "..EditDtlAddr.caption
		
		DATAMANAGER.RequestTranData("obcpp_zipa_011r") '정제주소조회	
	end if

End Sub

'============================================================================
' 일반검색 : 주소조회
'============================================================================
Sub EditInput_OnEditComplete()
	f_AddrSerch()
End Sub

'============================================================================
' 일반검색 : 주소조회
'============================================================================
Sub ButtonRequest_OnClick()
	f_AddrSerch()
End Sub

'============================================================================
' 일반검색 : 주소선택
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Grid1.rowcount = "0"
	Grid2.rowcount = "0"
	EditInputAddress.caption = ""
	EditInputAddress1.caption = ""
	
	Dim regnzip, dtlzip, post
	regnzip	= Grid0.GetCellData("bd_regnzip",		lRow)
	dtlzip	= Grid0.GetCellData("bd_dtlzip", 		lRow)
	post		= Grid0.GetCellData("bd_post",			lRow)
	
	LabelREGNZIP.caption	= regnzip
	LabelDTLZIP.caption	= dtlzip
	
	EditInputAddress.caption = regnzip.."-"..dtlzip.." "..	post		'도로명주소
	
	EditInputAddress1.setFocus()
End Sub

'============================================================================
' 일반검색 : 주소검색 스크롤엔드
'============================================================================
Sub Grid0_OnScrollEnd()

	if g_nNextFlag == "1" or g_nNextFlag == true then
		DATAMANAGER.RequestTranData("obcpp_zipa_010r")	'도로명주소조회	
	end if
	
End Sub

'============================================================================
' 일반검색 : 상세주소
'============================================================================
Sub EditInputAddress1_OnEditComplete()
	Grid1.rowcount = "0"
	Grid2.rowcount = "0"
End Sub

'============================================================================
' 일반검색 : 정제버튼 클릭
'============================================================================
Sub Button0_OnClick()
	Grid1.rowcount = "0"
	Grid2.rowcount = "0"
	
	if EditInputAddress.caption == "" then	
		Form.MsgBox("알림", "기본주소를 선택하세요.", "", 6)
		Exit Sub
	end if
	
	if EditInputAddress1.caption == "" then	
		Form.MsgBox("알림", "상세주소를 입력하세요.", "", 6)
		Exit Sub
	end if
	
	Dim post, nIndex
	nIndex	= Grid0.selectrow
	post		= Grid0.GetCellData("bd_post", nIndex)
	g_Post	= post.." "..EditInputAddress1.caption
	
	DATAMANAGER.RequestTranData("obcpp_zipa_011r") '정제주소조회
End Sub

'============================================================================
' 일반검색 : 정제 구주소
'============================================================================
Sub Grid1_OnClickUp(lRow, szCellID)
	Dim sCheck
	sCheck = Grid1.GetCellData("bd_check", lRow)

	if sCheck == "1" then
	
		for i = 0 to Grid1.rowcount - 1
		
			if i ~= lRow then
				Grid1.SetCellData("bd_check", i, "0")
			end if
			
		next

		for i = 0 to Grid2.rowcount - 1
			Grid2.SetCellData("bd_check", i, "0")
		next
		
	end if
	
End Sub

'============================================================================
' 일반검색 : 정제 새주소
'============================================================================
Sub Grid2_OnClickUp(lRow, szCellID)
	Dim sCheck
	sCheck = Grid2.GetCellData("bd_check", lRow)
	
	if sCheck == "1" then
	
		for i = 0 to Grid2.rowcount - 1
		
			if i ~= lRow then
				Grid2.SetCellData("bd_check", i, "0")
			end if
			
		next
		
		for i = 0 to Grid1.rowcount - 1
			Grid1.SetCellData("bd_check", i, "0")
		next
		
	end if
	
End Sub

'============================================================================
' 반영버튼 클릭
'============================================================================
Sub ButtonOK_OnClick()
	Dim nCnt, sCheck, sPost, sDtad, sBLDN
	nCnt = 0

	if FormTab0.currenttabpageid == "page0" then
		sYN			= g_nFlag == "도로명주소" and "Y" 			or "N"		
		g_BLDN_MNNO	= g_nFlag == "도로명주소" and g_BLDN_MNNO	or ""
		
		if g_Post == "" then	
			Form.MsgBox("알림", "기본주소를 검색하세요.", "", 6)
			Exit Sub
		end if
		
		if g_Dtad == "" then	
			Form.MsgBox("알림", "상세주소를 입력하세요.", "", 6)
			Exit Sub
		end if

		Form.SetSharedData("mbonl81000_p4_YN", 		sYN)
		Form.SetSharedData("mbonl81000_p4_REGN_ZIP",	LEFT(Grid3.GetCellData("BD_ZIP", 0), 	3))
		Form.SetSharedData("mbonl81000_p4_DTL_ZIP",	RIGHT(Grid3.GetCellData("BD_ZIP", 0), 	2))
		Form.SetSharedData("mbonl81000_p4_POST", 	g_Post)
		Form.SetSharedData("mbonl81000_p4_DTAD", 	g_Dtad)
		Form.SetSharedData("mbonl81000_p4_BLDN", 	g_BLDN_MNNO)
		
	else
		
		for i = 0 to Grid1.rowcount - 1
			sCheck = Grid1.GetCellData("bd_check", i)
			
			if sCheck == "1" then
				sPost = Grid1.GetCellData("bd_post", i)
				sDtad = Grid1.GetCellData("bd_dtad", i)
				
				Form.SetSharedData("mbonl81000_p4_YN", 		"N")
				Form.SetSharedData("mbonl81000_p4_REGN_ZIP", 	LabelREGNZIP.caption)
				Form.SetSharedData("mbonl81000_p4_DTL_ZIP", 	LabelDTLZIP.caption)
				Form.SetSharedData("mbonl81000_p4_POST", 	sPost)
				Form.SetSharedData("mbonl81000_p4_DTAD", 	sDtad)
				Form.SetSharedData("mbonl81000_p4_BLDN",		"")
	
				nCnt = nCnt + 1
			end if
			
		next
		
		for i = 0 to Grid2.rowcount - 1 
			sCheck = Grid2.GetCellData("bd_check", i)
			
			if sCheck == "1" then
				sPost = Grid2.GetCellData("bd_post", i)
				sDtad = Grid2.GetCellData("bd_dtad", i)
				sBLDN = Grid2.GetCellData("bd_bldn", i)
				
				Form.SetSharedData("mbonl81000_p4_YN", 		"Y")
				Form.SetSharedData("mbonl81000_p4_REGN_ZIP",	LabelREGNZIP.caption)
				Form.SetSharedData("mbonl81000_p4_DTL_ZIP",	LabelDTLZIP.caption)
				Form.SetSharedData("mbonl81000_p4_POST", 	sPost)
				Form.SetSharedData("mbonl81000_p4_DTAD", 	sDtad)
				Form.SetSharedData("mbonl81000_p4_BLDN", 	sBLDN)
				
				nCnt = nCnt + 1
			end if
			
		next
		
		if nCnt == 0 then
			Form.MsgBox("알림", "반영할 주소를 선택하세요.", "", 6)
			Exit Sub	
		end if
		
		if nCnt > 1 then
			Form.MsgBox("알림", "반영할 주소를 선택하세요.(2개이상의 주소존재)", "", 6)
			Exit Sub	
		end if
	
	end if
	
	g_sRetData = "ok"
	
	Form.CloseForm()	
End Sub

'===========================================================================
' 							사용자 함수
'============================================================================
' 탭 변경시 화면 세팅 함수
'============================================================================
Sub f_ControlSet(nCurrentTab)

	if nCurrentTab == 0 then
		EditInput.visible			= FALSE
		ButtonRequest.visible		= FALSE
		Table0.visible			= FALSE
		Grid0.visible 			= FALSE
		Label0.visible 			= FALSE
		Grid1.visible 			= FALSE
		Grid2.visible 			= FALSE
		EditInputAddress.visible	= FALSE
		EditInputAddress1.visible	= FALSE
		Button0.visible			= FALSE
		WebView0.visible 			= TRUE
		LblLine.visible			= TRUE
	else
		EditInput.visible			= TRUE
		ButtonRequest.visible		= TRUE
		Table0.visible			= TRUE
		Grid0.visible 			= TRUE
		Grid1.visible 			= TRUE
		Grid2.visible 			= TRUE
		EditInputAddress.visible	= TRUE
		EditInputAddress1.visible	= TRUE
		Button0.visible			= TRUE
		WebView0.visible 			= FALSE
		LblLine.visible			= FALSE
		Grid3.visible 			= FALSE
		EditDtlAddr.visible 		= FALSE
	end if
	
End Sub

'===========================================================================
' 주소조회 함수
'===========================================================================
Function f_AddrSerch()
	Grid0.rowcount = 0
	Grid1.rowcount = 0
	Grid2.rowcount = 0
	
	EditInputAddress.caption = ""
	EditInputAddress1.caption = ""
	
	if EditInput.caption == "" then
		Form.MsgBox("알림", "도로명을 입력하세요.", "", 6)
		Exit Function
	end if
	
	g_nNextFlag = false

	DATAMANAGER.RequestTranData("obcpp_zipa_010r")	'도로명주소조회
End Function

'===========================================================================
' SetSharedData 리셋 함수
'===========================================================================
Function f_ResetSharedData()
	Form.SetSharedData("10050_ADDRESS_YN"       , "")
	Form.SetSharedData("10050_ADDRESS_REGN_ZIP" , "")
	Form.SetSharedData("10050_ADDRESS_DTL_ZIP"  , "")
	Form.SetSharedData("10050_ADDRESS_POST"     , "")
	Form.SetSharedData("10050_ADDRESS_DTAD"     , "")
	Form.SetSharedData("10050_ADDRESS_BLDN"     , "")
End Function

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'===========================================================================
' 카카오 주소검색 페이지 연동
'===========================================================================
Function f_SyncKAKAO()
	serverMode = Form.GetSharedData("&SERVER_MODE", false)
	
	if serverMode == "1" Then	'개발기
		WebView0.urlpath = "https://testhome.imeritz.com/biz/kakaoaddr.html"
	else
		WebView0.urlpath = "https://home.imeritz.com/biz/kakaoaddr.html"
	end if
	
End Function

