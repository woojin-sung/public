'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 옵션거래신청
' 02. 화면설명 : 옵션거래신청
' 03. 작    성 : 2016.02.15 김보라
' 04. 수    정 : 2017.03.09  : 김유경 : 파생상품 개인투자자 보호제도 변경에 따라 2차사전교육/자격증 항목 추가 v0001
'						            (obcsb_drvt_009r추가)
'              : 2018.07.13	  : 윤유정 : obcsb_drvt_003r IO 변경(조회항목 추가) v0002
' 2019.11.08   : 정민영 : v0003 : KRX제도개선_3차
' 2019.12.06   : 정민영 : v0004 : 안내문구수정
'			: 2020.09.16 : 권오상 : v005 : T2008250015 : 메모리평문 취약점 수정
' 2020.12.05 : 정민영 : v005 보완조치
' 2021.05.24 : 정민영 : v007 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'계좌컨트롤
'101선물옵션,120WRAP(선물)
Dim g_sAcc '계좌번호
Dim g_sCSNO '고객번호
Dim g_Invr_Tpcd     'v0003 투자유형
Dim g_OptnTrAbleYN  'v0003 옵션가능여부
Dim	g_PlainRm 'v005

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 속성 초기화함수
'===========================================================================
Function SetControlViewClear()
	LabelSRNO.caption = ""
	
	Table0.SetCellString( 0, 1, "" )
	Table0.SetCellString( 1, 1, "" )
	Table0.SetCellString( 2, 1, "" )
	Table0.SetCellString( 3, 1, "" )
	Table0.SetCellString( 4, 1, "" )
	Table0.SetCellString( 5, 1, "" ) 'v0001
	
	g_Invr_Tpcd    = "" 'v0003 투자유형
	g_OptnTrAbleYN = "" 'v0003 옵션가능여부
End Function

'===========================================================================
' 조회함수
'===========================================================================
Function SetRequestData()
	if EditPW.caption ~= null and EditPW.caption ~= "" then
		SetControlViewClear()
		DATAMANAGER.RequestTranData( "obcsb_acif_000r" ) '고객정보조회
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	Form.setTitleCaption("파생 2단계(옵션 신규매도) 거래신청") 'v0001
	
	g_sAcc = Account0.caption
	g_sCSNO = ""

	'v0001 5->6
	Dim sText
	'sText = Table0.GetCellString( 6, 0 ).."\n\"선물옵션예탁금\" 화면에서 확인 가능합니다."
	sText = Table0.GetCellString( 6, 0 ).."\n\"당일/익일증거금>상세\" 화면에서 확인 가능합니다."
	
	Table0.SetCellString( 6, 0, sText ) '
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "alert" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obpds_srvc_045a" ) '거래신청
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
'	sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" ) 'v005
'	sACNT_PWD = Form.GetEncData(sACNT_PWD)'v005

	'v005
	If g_PlainRm = "1" Then '보안모듈 적용
		sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" )
	Else
		'화면 최초오픈시에는 비밀번호가 Null 이므로 GetCtlprop()오류발생/GetCtlProp()와 GetEncData() 분리
		'sACNT_PWD = Form.GetEncData(Form.GetCtlProp( "EditPW", "caption" ))
		sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" )
		sACNT_PWD = Form.GetEncData(sACNT_PWD)
	End If
	
	if szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "PROS_CLS_CODE" , 0 , "I" )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obcsb_drvt_003r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_drvt_003r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_drvt_003r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "obcsb_drvt_003r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obpds_srvc_069r" then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "CSNO" , 0 , g_sCSNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "SVCD" , 0 , "066" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE" , 0 , "0" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01" ) '정상
	elseif szTranID == "obpds_srvc_045a" then
		if Table0.GetCellString( 0, 1 ) == "등록" then
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "D" )
		else
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "I" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_sCSNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "066" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
	elseif szTranID == "obtrf_cntg_306r" then
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_306r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_306r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_306r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	'v0001 sta
	elseif szTranID == "obcsb_drvt_009r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_drvt_009r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
	'v0001 fin
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_000r" then	
		g_sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CSNO" , 0 )
		
		DATAMANAGER.RequestTranData( "obcsb_drvt_003r" ) '최초계좌개설일자조회
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" ) '신청내역조회
		DATAMANAGER.RequestTranData( "obtrf_cntg_306r" ) '예탁금조회		
		DATAMANAGER.RequestTranData( "obcsb_drvt_009r" ) '2차사전교육/자격증조회 v0001
	elseif szTranID == "obpds_srvc_069r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obpds_srvc_069r", "OutBlock1" )
		
		if nCnt > 0 then
			Dim sMoASNO, ASNO
			sMoASNO = Right(g_sAcc, 2)
			
			for i = 0 to nCnt-1 
				ASNO = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "ASNO" , i )
				
				if sMoASNO == ASNO then
					LabelSRNO.caption = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO" , i )
					Table0.SetCellString( 0, 1, "등록" )
					ButtonOK.caption = "해지"
					
					Exit For
				end if
			next
		end if
		
		if Table0.GetCellString( 0, 1 ) ~= "등록" then
			Table0.SetCellString( 0, 1, "미등록" )
			ButtonOK.caption = "신청"
		end if
	elseif szTranID == "obpds_srvc_045a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		SetControlViewClear()
		DATAMANAGER.RequestTranData( "obcsb_drvt_003r" ) '최초계좌개설일자조회
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" ) '신청내역조회
		DATAMANAGER.RequestTranData( "obtrf_cntg_306r" ) '예탁금조회
		DATAMANAGER.RequestTranData( "obcsb_drvt_009r" ) '2차사전교육/자격증조회 v0001
		
	elseif szTranID == "obtrf_cntg_306r" then	' 20160330 추가
		Dim szCode		'기본 예탁금 등급 코드
		Dim szData		'받은 기본예탁금 등급코드를 변환하여 기본 예탁금으로 변환
		Dim szInvtTypeCode '투자유형코드    v0001
		Dim szInvtTypeNm   '투자유형코드명  v0001
		szCode = DATAMANAGER.GetDataValue(0, "obtrf_cntg_306r", "OutBlock1", "BASC_DPMN_GRAD_CODE", 0)
		szData = Form.GetMetaData("기본예탁금등급코드", szCode)
		Table0.SetCellString( 2, 1, szData )	 'v0001
	'v0001 sta
		szInvtTypeCode = DATAMANAGER.GetDataValue(0, "obtrf_cntg_306r", "OutBlock1", "INVT_TYPE_CODE", 0)
		szInvtTypeNm   = Form.GetMetaData("투자유형코드", szInvtTypeCode)
		Table0.SetCellString( 1, 1, szInvtTypeNm )	 		
		
	elseif szTranID == "obcsb_drvt_009r" then	
		ScndEdctCmno = DATAMANAGER.GetDataValue(0, "obcsb_drvt_009r", "OutBlock1", "SCND_SCTY_EDCT_CMCO_NO"  , 0)
		DrvtInvtQlcd = DATAMANAGER.GetDataValue(0, "obcsb_drvt_009r", "OutBlock1", "DRVT_INVT_EXPC_QLCR_CODE", 0)
			
		'v0003 2차 사전교육/자격증여부 삭제
'		If g_OptnTrAbleYN == "Y" Or (len(trim(EdctCmno)) > 0 or len(trim(DrvtInvtQlcd)) > 0) Then
'			Table0.SetCellString( 4, 1, "Y" )
'		Else
'			Table0.SetCellString( 4, 1, "N" )
'		End If
		
		'v0003 투자유형코드
		g_Invr_Tpcd = DATAMANAGER.GetDataValue(0, "obcsb_drvt_009r", "OutBlock1", "DRVT_INVR_TPCD"  , 0)
	'v0001 fin
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obpds_srvc_045a" or szTranID == "obcsb_drvt_003r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account0_ChangeAccount()
	g_sAcc = Account0.caption
End Sub

'============================================================================
' 비밀번호 입력
'============================================================================
Sub EditPW_OnEditComplete()
	SetRequestData()
End Sub
'============================================================================
Sub EditPW_OnCompletedAccountPassword()
	SetRequestData()
End Sub


'============================================================================
Sub ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	if Table0.GetCellString( 0, 1 ) ~= "등록" then
		Dim sText
		'v0003 1년 초과 체크 삭제
		'sText = "1) \"옵션신청 가능여부\"가 \"Y\"인 경우에만 옵션신청이 가능합니다.\n"..
		'		"2) \"파생계좌 유형\"이 \"C(일반투자자)\"인 경우, 최초 계좌 개설일이 1년 초과해야 옵션거래신청이 가능합니다."
		'Form.MsgBox( "알림", sText, "alert", 1 )
		'Exit Sub
		
		'v0003 A/B 유형은 약정불필요	
		If g_Invr_Tpcd == "01" Then  '01.전문투자자대우 02.일반
			sText = "전문투자자 대우(유형A/유형B) 고객은\n"..
					"별도 신청 없이 옵션 신규매도가 가능합니다."
			Form.MsgBox( "알림", sText, "", 6 )
			Exit Sub
		End If
	End If
	
	DATAMANAGER.RequestTranData( "obpds_srvc_045a" ) '거래신청
	
End Sub





	</SCRIPT_INFO>
