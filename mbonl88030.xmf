			<TRAN tranid="obpds_srvc_045a" trcode="obpds_srvc_045a" compress="1" encryption="1" inputcheck="1" digitalsign="1" />
			<TRAN tranid="obcsb_drvt_003r" trcode="obcsb_drvt_003r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrf_cntg_306r" trcode="obtrf_cntg_306r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_drvt_009r" trcode="obcsb_drvt_009r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_acif_000r" title="고객정보조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="134" _ulen="102" >

PROS_CLS_CODE^처리 구분 코드^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
