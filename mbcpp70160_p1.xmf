Dim rsvYMDH, rsvPlace, ptName, rsvID
'============================================================================
Sub Form_OnFormInitBefore()
	rsvID	= Form.GetSharedData("szrsvID", false )
	rsvYMDH = Form.GetSharedData("szrsvYMDH", false )
	rsvPlace = Form.GetSharedData("szrsvPlace", false )
	ptName = Form.GetSharedData("szptName", false ) 
End Sub



'============================================================================
Sub Form_OnFormInit()
		
	Label1.caption =  ptName
	Label2.caption =  rsvYMDH
	Label3.caption =  rsvPlace
	'Form.MsgBox("", rsvID, "", "")
End Sub

'============================================================================

Sub DATAMANAGER_OnSendTranBefore(szTranID)
