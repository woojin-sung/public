	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1" , "INP_ITEM_ID" , 0 , rsvID )
End Sub

'============================================================================

Sub Button0_OnClick()
	DATAMANAGER.RequestTranData("obcpp_rbit_022a")
	Form.SendReturnToParent( "cancel" , "" )
	Form.CloseForm()
End Sub




'============================================================================
Sub Button1_OnClick()
