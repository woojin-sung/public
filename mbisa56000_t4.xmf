'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 계약정보_적립식정보
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If Form.GetCtlProp("#acnt0", "total") = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Form.GetCtlProp("#cmbSeq", "caption") = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Function RequestData()
	'Clear Data
	cont0.tbl0.SetCellString( 0, 1, "")
	cont0.tbl0.SetCellString( 1, 1, "")
	
	Dim i
	For i = 0 to 9
		cont0.tbl1.SetCellString(i, 1, "")
		cont0.tbl1.SetCellString(i, 3, "")
	Next
	
	If Account_Check() == True then
		DATAMANAGER.RequestTranData( "obwat_ctcs_032r" )	'계약종합정보
	End If
End Function

'============================================================================
Sub SetTableData(szTranID)
	'HTS 정기이체약정 조회
	If szTranID = "obpds_srvc_221r" Then
		'신청구분
	    Dim sGbCode, sGbText
	    sGbCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_ACNT_CLS_CODE" , 0 )

	    If sGbCode = "1" Then
		    sGbText = "CMA"
	    Elseif sGbCode = "2" then
		    sGbText = "CMS"
	    else 
	         sGbText = ""
	    End If
	    
	    cont0.tbl1.SetCellString( 0 , 1, sGbText )
	End If
	
	'정기이체약정명세 조회
	If szTranID = "obpds_srvc_082r" Then
		sAcno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_SCRT_ACNO" , 0 )
		sAsno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_SCRT_ASNO" , 0 )

		cont0.tbl1.SetCellString( 1 , 1, sAcno & sAsno )						'은행/CMA 계좌번호
		'cont0.tbl1.SetCellString( 1 , 3, Form.GetAccountInfo(sAcno, "name") )	'계좌주
	End If
	
	'If szTranID = "obpds_srvc_082r" Then
		
		'이체기간
		Dim sStaDate, sFinDate, sStaDate2, sFinDate2
		sStaDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_STA_DATE" , 0 )
		sFinDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_FIN_DATE" , 0 )
		
		If Trim(sStaDate) <> "" and Trim(sFinDate) <> "" then
			sStaDate2 = Left(sStaDate, 4) & "-" & Mid(sStaDate, 5, 2) & "-" & Right(sStaDate, 2)
			sFinDate2 = Left(sFinDate, 4) & "-" & Mid(sFinDate, 5, 2) & "-" & Right(sFinDate, 2)
			
			sStaDate = Left(sStaDate, 4) & "/" & Mid(sStaDate, 5, 2) & "/" & Right(sStaDate, 2)
			sFinDate = Left(sFinDate, 4) & "/" & Mid(sFinDate, 5, 2) & "/" & Right(sFinDate, 2)
			cont0.tbl1.SetCellString( 3 , 1, sStaDate & " ~ " & sFinDate )
		End If
		
		'총납입예정금액
		Dim nAmt
		Dim nDiffMonth
		if Trim(sStaDate) <> "" and Trim(sFinDate) <> "" then
			nDiffMonth = DateDiff("m", sStaDate2, sFinDate2)
			
			if Right(sStaDate2, 2) > cont0.tbl1.GetCellString(2, 3) then
				nDiffMonth = nDiffMonth - 1
			end if 
			
			if Right(sFinDate2, 2) > cont0.tbl1.GetCellString(2, 3) then
				nDiffMonth = nDiffMonth + 1
			end if 
		else
			nDiffMonth  = 0
		end if 
		
		nAmt = CDbl(cont0.tbl0.GetCellString( 0 , 1 )) * nDiffMonth
		cont0.tbl0.SetCellString( 1 , 1 , nAmt)
		
		'이체제한기간
		Dim sRstcStaDate, sRstcFinDate
		sRstcStaDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_RSTC_STA_DATE" , 0 )
		sRstcFinDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_RSTC_FIN_DATE" , 0 )
		
		If Trim(sRstcStaDate) <> "" and Trim(sRstcFinDate) <> "" then
			sRstcStaDate = Left(sRstcStaDate, 4) & "/" & Mid(sRstcStaDate, 5, 2) & "/" & Right(sRstcStaDate, 2)
			sRstcFinDate = Left(sRstcFinDate, 4) & "/" & Mid(sRstcFinDate, 5, 2) & "/" & Right(sRstcFinDate, 2)
			cont0.tbl1.SetCellString( 4 , 1, sRstcStaDate & " ~ " & sRstcFinDate )
		End If
		
		'이체약정 신청결과
		Dim sCode0, sText0
		sCode0 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TACT_STPL_APLT_RSLT_CODE" , 0 )

		Select Case sCode0
			Case "00"
				sText0 = "정상"
			Case "01"
				sText0 = "신규"
			Case "02"
				sText0 = "해지"
			Case "03"
				sText0 = "오류"
			Case "04"
				sText0 = "결재원신청중"
			Case "05"
				sText0 = "해지완료"
		End Select

		cont0.tbl1.SetCellString( 6 , 3, sText0 )
				
	'End If
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	cont0.tblTitle1.visible = FALSE
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" Then
		RequestData()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#cmbSeq", "caption")

	'계약종합정보
	If szTranID = "obwat_ctcs_032r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , szASNO )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계약종합정보
	If szTranID = "obwat_ctcs_032r" Then		
		Dim szACNO, szASNO
		szACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_INDV_MGRI_ACNO"     , 0 )
		szASNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_INDV_MGRI_ASNO"     , 0 )
		'msgbox szACNO
		'msgbox szASNO
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_221r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_221r", "InBlock1", "ASNO" , 0 , szASNO )
		
		DATAMANAGER.RequestTranData( "obpds_srvc_221r" )	'HTS 정기이체약정 조회
	End If
	
	'HTS 정기이체약정 조회
	If szTranID = "obpds_srvc_221r" Then
		Call SetTableData(szTranID)
		
		Dim sOutput0, sOutput1, sOutput2
		sOutput0 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CSNO"     , 0 )
		sOutput1 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SVCD"     , 0 )
		sOutput2 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SVC_SRNO" , 0 )

		If Trim(sOutput0) <> "" then
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_082r", "InBlock1", "CSNO"     , 0 , sOutput0 )	'고객번호
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_082r", "InBlock1", "SVCD"     , 0 , sOutput1 )	'서비스코드
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_082r", "InBlock1", "SVC_SRNO" , 0 , sOutput2 )	'서비스 일련번호
			
			DATAMANAGER.RequestTranData( "obpds_srvc_082r" )	'정기이체약정명세 조회
		else
			Form.ShowAlert("알림", "정기이체 신청내역이 없습니다.")
		End If
	End If
	
	'정기이체약정명세 조회
	If szTranID = "obpds_srvc_082r" Then
		Call SetTableData(szTranID)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub
