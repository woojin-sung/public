'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szOpenData
Dim g_sUserID		     '사용자ID
Dim g_szPW			'비밀번호
Dim g_acno
Dim g_szList			'계좌번호와 비밀번호
Dim SelfAcc			'본인계좌여부
Dim AccExst			'계좌번호 유효여부
DIm g_cls
Dim	g_PlainRm 'v002
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
