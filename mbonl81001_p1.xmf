'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	if szTranID == "obpds_srvc_411a" then	'지연이체 서비스 약정 조회
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "PROS_CLS_CODE"	 , 0 ,"U"		    		)	'처리구분코드(U:예외계좌추가)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVCD"	 		 , 0 ,"069"		    		)	'서비스코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVC_MANG_UNIT_CODE", 0 ,"01"		    		)	'01: 고객
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "CONT_CLS_CODE"	 , 0 ,"4"		    		)	'4 : 온라인
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNO"	  	 	 , 0 ,g_szList(0)			)	'계좌번호
'		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNT_PWD"	 	 , 0 ,g_szList(1)			)	'비밀번호 
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNO"	  	 	 , 0 ,g_acno			)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNT_PWD"	 	 , 0 ,g_szPW			)	'비밀번호 
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "BANK_CODE"	 	 , 0 ,g_szCom		    		)	'은행코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "TACT_BANK_ACNO"	 , 0 ,edtAcnt.caption 		)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "TACT_BANK_ACNM"	 , 0 ,edtBankName.caption   )	'수취인명
		DATAMANAGER.RequestTranData("obpds_srvc_411a")
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_sUserID)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000")'기본 '200'  등록 '400'
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if	
End Function
'****************************************************************************

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "이체기관" then
	   If sRet <> "" then
	      tData1 = Split(sRet, "★")
	      edtBank.caption = tData1(1)
	      g_szCom = tData1(0)
	   End If   
	end if
	
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공 -> 보안매체조회 및 인증
			Call TR_Inquiry("obcsb_oimf_638r")	
		else
			Form.CloseForm( )
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			'Call SendReg()		
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			'Call SendReg()	
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			'Call SendReg()	
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'일반/스마트OTP v003
		if sRet == "ok" then			'성공
			'Call SendReg()	
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			'Call TR_Inquiry("obpds_srvc_411a")
			Call SendReg()
		else						'실패
			exit sub
		end if
		
	end if
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002

	edtBank.caption = "메리츠"  'v0001 메리츠종금->메리츠
	g_szCom = "287"
	g_szOpenData = Form.GetOpenLinkData()
	g_szList = Split(g_szOpenData, "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_acno = g_szList(0)
	
'	g_szPW = Form.GetEncData(g_szList(1)) 'v002
	'v002
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPW = g_szList(1) 'v002
	Else
		g_szPW = Form.GetEncData(g_szList(1)) 'v002
	End If

	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if
End Sub
'============================================================================
Sub imgSearch_OnClick()
	Form.OpenPopup("mbbnk61010_p3" , "" ,"")
End Sub 
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("예외계좌추가", "succ") '20160713
	Form.CloseForm()
End Sub
'============================================================================
Sub btnName_OnClick()
	if g_szCom == "287" then	'메리츠당행조회
		DATAMANAGER.SetDataValue(0, "obacp_opop_071r", "InBlock1", "TACT_BANK_ACNO", 0 ,edtAcnt.caption)		'계좌번호
		DATAMANAGER.SetDataValue(0, "obacp_opop_071r", "InBlock1", "ACNO"		  , 0 ,g_szList(0)    )		'계좌번호
		DATAMANAGER.RequestTranData("obacp_opop_071r")
	else
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE"	 , 0 ,g_szCom		    )	'은행코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO"	  	 , 0 ,edtAcnt.caption )	'입금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT"		  	 , 0 ,"1"		    )	'거래금액
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO"	  	 , 0 ,g_szList(0)		)	'출금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE", 0 ,"01"			)	'계좌상품구분코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "JOB_TRNO"		 , 0 ,"031"			)	'작업단말번호
		DATAMANAGER.RequestTranData("obtss_elbs_129r")
	end if
End Sub

'============================================================================
' 등록 버튼 클릭
'============================================================================
Sub btn0_OnClick()
	if edtAcnt.caption = "" or edtBankName.caption = "" Then
		Form.MsgBox( "알림", "계좌명 조회를 실행해주세요.", "", 6 )
	else
		Form.OpenFramePopup("mhetc90060_p8" , "bank_update" , "")
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_071r" then	'당사 조회
		SelfAcc = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SELF_ACNT_YN" 		 , 0 )		    '본인계좌여부 
		AccExst = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ACNT_EXST_CNFR_CODE" , 0 )		    '계좌번호 유효
		
		if AccExst = "00" Then
			edtAcnt.caption 		= ""
			edtBankName.caption    = ""
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_opop_071r" )
			'Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
			Form.ShowAlert( "알림" , szSubErr)
		end if
		
		if SelfAcc =  "Y" Then
			edtAcnt.caption 		= ""
			edtBankName.caption    = ""
			Form.ShowAlert( "알림" , "당사 본인계좌는 자동 등록 처리 됩니다.")
		end if
		
		edtBankName.caption = Trim(DATAMANAGER.GetDataValue(0, "obacp_opop_071r", "OutBlock1", "CSNM" , 0)) '수취인명
			
	elseif szTranID == "obtss_elbs_129r" then	'타사 조회
		edtBankName.caption = Trim(DATAMANAGER.GetDataValue(0, "obtss_elbs_129r", "OutBlock1", "ACNM" , 0)) '수취인명
	elseif szTranID == "obpds_srvc_411a" then	'타사 조회
		Form.ShowAlert("알림", "예외계좌가 등록되었습니다.")
	     edtBank.caption = "메리츠"  'v0001 메리츠종금->메리츠
		edtAcnt.caption = ""
		edtBankName.caption = ""
		Form.SendReturnToParent("예외계좌추가", "succ")
		Form.CloseForm()		
	elseif szTranID == "obcsb_oimf_638r" then				
		if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "0" then		'보안카드
			Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)											'공인인증서_보안카드화면
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "1" then	'부가정보
			Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)											'공인인증서_부가정보
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "2" then	'보안매체없음
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "3" then	'OTP
			Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)											'공인인증서_일반/스마트OTP
		elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "4" then	'mOTP v003
              Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" )
		else																							'오류
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if
	end if
End Sub  

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obpds_srvc_411a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_411a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		'g_nSuccesCount = 0
	end if
	
	if szTranID == "obacp_opop_071r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obacp_opop_071r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		edtAcnt.caption 		= ""
		edtBankName.caption    = ""
		'g_nSuccesCount = 0
	end if
	if szTranID == "obtss_elbs_129r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obtss_elbs_129r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		'g_nSuccesCount = 0
	end if
	
	if szTranID == "obcsb_oimf_638r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_638r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		'g_nSuccesCount = 0
	end if
End Sub 

'============================================================================
' SendReg
'============================================================================
Function SendReg()
	Call TR_Inquiry("obpds_srvc_411a")		
End Function 
'============================================================================
Sub edtAcnt_OnEditChar(CharCode)
	edtBankName.caption    = ""
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_acno &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacp_opop_071r" trcode="obacp_opop_071r" compress="1" encryption="1" inputcheck="1" useattr="0" />
