<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="9999" scrname="연합인포맥스 하단바" version="2" writer="임성수" />
	<FORM_INFO name="Form" ly_vert="0,0,375,25,1" />
	<CONTROL_INFO>
		<IMAGE name="imgLogo" autosize="1" imgpath="yna_logo" ly_vert="8,5,64,14,1" />
		<LABEL name="lblSise" fontsize="-5" caption="권한없음" ly_vert="72,0,100,25,1" />
		<LABEL name="lblOffer" visible="0" fgcolor="062:255255255" fontsize="-4" caption="Disclaimer" halign="1" click="1" ly_vert="235,0,70,25,0" />
		<LABEL name="lblSiseButtonBack" transmode="0" ly_vert="305,0,70,25,1" />
		<LABEL name="lblSiseButton" fgcolor="062:255255255" fontsize="-4" caption="시세신청" halign="1" click="1" ly_vert="305,0,70,25,1" />
		<LABEL name="lblLine0" transmode="0" ly_vert="223,0,1,25,1" />
		<LABEL name="lblLine1" transmode="0" ly_vert="305,0,1,25,1" />
		<IMAGE name="imgStWeather" autosize="1" imgpath="stockweather" ly_vert="230,6,70,12,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6946" _ulen="6360" >
'============================================================================
' 2017.10.18 -  LSS
' 연합인포맥스 하단바 화면
'
' 1. 화면상의 모든 DEFINE 은 initDefine() 함수에서 처리 함.
'============================================================================

Dim g_tblDefine, g_tblAuthCode
'============================================================================
Sub Form_OnFormInit()
	initDefine()
	initDefault()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	Select Case sKey
	Case g_tblDefine[ "refreshExtra" ], g_tblDefine[ "SWAPCODE" ]
		
		' 권한View 설정
		initAuthView()
		' 제공처View 설정
		initOfferView()
		
		Exit Sub
	End Select
End Sub

'----------------------------------------------------------------------------
' 2017.10.18 -  LSS
' 컨트롤 함수
'----------------------------------------------------------------------------
'============================================================================
Sub lblSiseButton_OnClick()
	Form.OpenPopup( g_tblDefine["MENU"] , "" , "" )
End Sub

'============================================================================
Sub lblOffer_OnClick()
	' 2017.11.22 - LSS > 나스닥 디스클레이머 추가 - 19.04.10 김경민
	' 연합인포맥스 안내팝업창 추가요청
	Dim szGetCode 
	szGetCode = getExchangeCode()
	Form.OpenPopup( "AspDisclaimerAlert" , szGetCode , "" )
End Sub

'----------------------------------------------------------------------------
' 2017.10.18 -  LSS
' 사용자 함수
'----------------------------------------------------------------------------
'============================================================================
' 기본 설정된 정보들 설정
'============================================================================
Sub initDefine()
	g_tblDefine = {
		["SPLIT"] = "★",
		["SPLIT_CODE"] = "@",
		' 컨트롤 색상
		["CL_BACK"] = "000:062062062",
		["CL_SISE"] = "000:236140009",
		["CL_BTNSISE"] = "000:068052052",
		["CL_LINE"] = "000:036036036",
		' 연결화면
		["MENU"] = "InfoMaxMenu",
		' 연결정보
		["SCREEN"] = "&SCREEN_NO",
		["AUTH"] = "&AUTH_INFOMAX",
		["SWAPCODE"] = "&ITEM_CODE",
		["LINKDATA"] = "&ITEM_OVERSTOCK",
		' 반환 이벤트
		[ "refreshExtra" ] = "REFRESH_EXTRA_VIEW"
	}
	
	g_tblAuthCode = {
		'1:홍콩, 2:항셍 지수, 3:상해, 4:심천, 5:뉴욕
		["1"] = "HKS", ["2"] = "HSI", ["3"] = "SHS", ["4"] = "SZS", ["5"] = "NYS", 
		'6:아멕스, 7:나스닥, 8:미국 OTCBB, 9:S&P 지수, 10:다우존스 지수
		["6"] = "AMX", ["7"] = "NAS", ["8"] = "NAO", ["9"] = "SPI", ["10"] = "1DJI", 
		'11:도쿄, 12:오사카, 13:자스닥, 14:니케이 지수, 15:미국 나스닥 지수
		["11"] = "TSE", ["12"] = "OSE", ["13"] = "JSD", ["14"] = "NII", ["15"] = "NAI", 
		'16:인도네시아, 17:호치민, 18:하노이
		["16"] = "IDX", ["17"] = "HSX", ["18"] = "HNX"
	}
End Sub

'============================================================================
' 기본 정보 및 컨트롤 설정
'============================================================================
Function initDefault()
	'컨트롤 기본정보 설정
	Form.bgcolor = g_tblDefine["CL_BACK"]
	lblSise.fgcolor = g_tblDefine["CL_SISE"]
	lblSiseButtonBack.bgcolor = g_tblDefine["CL_BTNSISE"]
	lblLine0.bgcolor = g_tblDefine["CL_LINE"]
	lblLine1.bgcolor = g_tblDefine["CL_LINE"]
	
	' 권한View 설정
	initAuthView()
	' 제공처View 설정
	initOfferView()
End Function

'============================================================================
' 제공처 설정
'============================================================================
Function initOfferView()
	Dim szItemCode, szExchange
	
	lblLine0.visible = false
	lblOffer.visible = false
	imgStWeather.visible = false
	
	if not isShowingScreen() then
		Exit Function
	end if
	
	szExchange = getExchangeCode()
	
	' 나스닥 디스클레이머 추가 - 19.04.10 김경민
	' HKS : 홍콩 or 나스닥의 경우
	if szExchange == g_tblAuthCode["1"] or szExchange == g_tblAuthCode["7"] then
		lblLine0.left = 235
		lblLine0.visible = true
		lblOffer.visible = true
		
	' TSE : 도쿄의 경우
	elseif szExchange == g_tblAuthCode["11"] then
		lblLine0.left = 223
		lblLine0.visible = false
		imgStWeather.visible = true
		
	end if
	
End Function

'============================================================================
' 권한명 반환
'============================================================================
Function initAuthView()
	lblSise.visible = isShowingScreen()

	Dim tAuthType, szAuth, szAuthName, szItemCode, szExchange
	
	tAuthType = {
		["0"] = "권한없음",
		["1"] = "*실시간시세",
		["2"] = "지연시세",
		["3"] = "종가"
	}
	
	szAuth = Form.GetSharedData( g_tblDefine["AUTH"], false )
	szAuthName = tAuthType["0"]
	
	szExchange = getExchangeCode()
	if not isNull( szAuth ) then
		For key, val in pairs( g_tblAuthCode )
			if val == szExchange then
				szAuthName = tAuthType[ Mid( szAuth, CInt( key ), 1 ) ]
			end if
		Next
	end if
	
	lblSise.caption = szAuthName
End Function

'============================================================================
' 제공처, 권한 표시 여부
'============================================================================
Function isShowingScreen()
'	연합인포쪽에서 현재가, 차트, 주문만 텍스트 및 이미지 표기 한다고 함.

	Dim tData, szCurScreen
	tData = {
		"16000", "16020", "16060", "16061" , "16075"
	}
	
	szCurScreen = Form.GetSharedData( g_tblDefine["SCREEN"], false )
	For _, val in ipairs( tData ) 
		if val == szCurScreen then
			return true
		end if
	Next
	
	return false
End Function

'============================================================================
' 거래소 코드 반환
'============================================================================
Function getExchangeCode()
	Dim tData, szItemCode
	szItemCode = getItemCode()
	
	if( not isNull(szItemCode) ) then
		tData = Split( szItemCode, g_tblDefine["SPLIT_CODE"] )
		if Null <> tData and #tData >= 1 then
			return tData[0]
		end if
	end if
End Function

'============================================================================
' 종목코드 반환
'============================================================================
Function getItemCode()
	Dim tData, szData	
	szData = Form.GetSharedData( g_tblDefine["LINKDATA"], false )
	
	if (not isNull(szData) ) then
		tData = Split( szData, g_tblDefine["SPLIT"] )
		if Null <> tData and #tData >= 2 then
			return tData[0]
		end if
	end if
End Function

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function

	</SCRIPT_INFO>
</ROOT>