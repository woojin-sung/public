'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	imgGrp.setMaintainingRatio("1")	'202306 HSZ 임시TEST
' 차트관련 ------------------------------------------------------------------
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = true
	g_szChrtType = "D" '일
	g_szMinType = "1분"
	g_szTicType = "1틱"
' ---------------------------------------------------------------------------
	edtGWAdd.caption = "0"		' 20160401 관심 타매체 실시간 연동관련 에디트(1:MTS에서 관심등록)
	Change_Style("SET_BLANK")
	
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	'  조회 토글의 초기화 : 20160317 메인화면에만 미적용부분 추가
	if Form.GetEnvData("GW_RSELECT") == "" then
		g_szRSelect = "0"
	else
		
		g_szRSelect = Form.GetEnvData("GW_RSELECT")
	end if
	
	if g_szRSelect == "1" then
		tblSelect.SetCellString(0, 0, "예상")
		imgSelect.imgpath = "toggle_img3_2.png"
	elseif g_szRSelect == "2" then
		tblSelect.SetCellString(0, 0, "단일")
		imgSelect.imgpath = "toggle_img3_3.png"
	else
		tblSelect.SetCellString(0, 0, "현재")
		imgSelect.imgpath = "toggle_img3_1.png"	
	end if
	
	'20211019 아이티젠(김성수) 관심화면 개선 START
	Call f_SetPrcType(g_szRSelect)
	'20211019 아이티젠(김성수) 관심화면 개선 END
	' //////////////////////////////////////////////////////////////////////
	
	fmTab.currenttab = "1"	' 20160406 : 속도이슈때문에 미리 탭위치 변경
	' 폼탭의 좌우스크롤 제어
	Control_FmTab_Swipe()
	
	' 관심그룹만 설정
	init_GWGroup()
	
	' 전체 장운영 알람 ----------------------------
	'DATAMANAGER.RequestRealData("ohhts_whol_mkop")	
	
	' 20160401 관심 타매체 실시간 연동 ------------
	DATAMANAGER.RequestRealData("ohhts_intr_real")
	
'	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20210823 HSZ CFD
	'20210823 HSZ START : CFD 메뉴에서 관심종목 오픈시, 보유종목->주식 보유종목
	if g_szScreenNo = "13101" then
		Form.setRotateEnable("0") '가로화면 비활성화 (안드로이드)
		g_tNm      = {"Watching종목", "최근조회 종목", "CFD 보유종목"}
	end if
	'20210823 HSZ END
	
'	20230208 HSZ START : 홈화면에서 오픈한 경우->최근조회 종목
	szOpenData = Form.GetOpenLinkData()
	if szOpenData = "HOME" then
		g_szOpenData = "1"
	end if
'	20230208 HSZ END
	
'	20230322 HSZ START : 화면집계 서비스호출 추가
	szTheme = Form.GetEnvData("common.theme") 
	if szTheme = "black" then
		DATAMANAGER.RequestTranData("ohhts_open_001r")
	end if
'	20230322 HSZ END
	
End Sub

'============================================================================
' Form_OnLinkData : 20160404 로그인시 신호 받고 해당 ID로 관심요청
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&LOGIN" then
		if sValue == "login" then
			init_GWGroup()
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 환경설정 팝업 리턴 ---------------------------------------------------
	if sKeyName == "GW_SET" then
		if Trim(sRet) <> "" then
			' 폼탭의 좌우스크롤 제어
			Control_FmTab_Swipe()
			
			' 그룹콤보 초기화
			Insert_cmbGroup()
			
		end if
	' 편집 팝업 리턴	 -----------------------------------------------------
	elseif sKeyName == "GW_SET2" then
		 ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가 //////
		Dim szvrsnID
		
		szvrsnID = Form.GetSharedData("VRSN_ID", true)
		
		if Trim(szvrsnID) <> "" then
			edtvrsnID.caption = szvrsnID
		end if
		' //////////////////////////////////////////////////////////////////
		
		' 내가 편집하면 어차피 재조회를 요청하기 때문에 의미가 없다.
		'edtGWAdd.caption = "1"	' 20160401 관심 타매체 실시간 연동(1:MTS에서 관심등록)
		
		if sRet == "0" then		' 종목편집
			edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
		else						' 그룹편집
			init_GWGroup()
		end if
	' 가로 팝업 리턴	 -----------------------------------------------------
	elseif sKeyName == "GW_SELECT_GROUP" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if tData(1) == "0" then
				tblSelect.SetCellString(0, 0, "현재")
				Form.SetEnvData("1", "GW_RSELECT", "0")
				g_szRSelect = "0"	
				imgSelect.imgpath = "toggle_img3_1.png"
			elseif tData(1) == "1" then
				tblSelect.SetCellString(0, 0, "예상")
				g_szRSelect = "1"
				Form.SetEnvData("1", "GW_RSELECT", "1")
				imgSelect.imgpath = "toggle_img3_2.png"
			elseif tData(1) == "2" then
				tblSelect.SetCellString(0, 0, "단일")
				g_szRSelect = "2"
				Form.SetEnvData("1", "GW_RSELECT", "2")
				imgSelect.imgpath = "toggle_img3_3.png"
			end if
			
			cmbGroup.currentindex = tData(0)
			
			'20211019 아이티젠(김성수) 관심화면 개선 START
			Call f_SetPrcType(g_szRSelect)
			'20211019 아이티젠(김성수) 관심화면 개선 END
		end if
	elseif sKeyName == "Chart_Min" then
		g_szMinType = sRet
		rdoChart.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(rdoChart.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		rdoChart.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(rdoChart.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]
		PeriodSet(g_szChrtType)
	elseif sKeyName = "snsshare" then			' SNS 리턴 : 20160324 SNS연동 추가(화면연동)
		if sRet == "2" then
			Dim szScreenNo, szFileName
			
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"

			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(sRet, "", "", szFileName)
		end if
		
	elseif sKeyName = "mhprc11010_p7_select" then '그룹팝업에서 리턴
		cmbGroup.currentindex = sRet
		
	elseif sKeyName = "mhprc11010_p7_edit" then '그룹팝업에서 리턴
		Form.OpenFramePopup("mhprc11010_p2" , "AddGroup", "") '편집 팝업 오픈
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 가로팝업 전환
	' ----------------------------------------------------------------------
	if sEventName == "CHANGE_ORIENTATION" then
		Form.OpenPopup("mhprc11010_h0", g_szRSelect, "")
	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
	elseif sEventName == "SCREEN_MENU" then
		'	20211115 HSZ 스타일4 추가
		if sParam == "SET_STYLE1" or sParam == "SET_STYLE2" or sParam == "SET_STYLE3" or sParam == "SET_STYLE4" then 
			Form.SetEnvData("1", "GW_STYLE", sParam)
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "STYLE", sParam)
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
			
			Change_Style(sParam)
			'20211019 아이티젠(김성수) 관심화면 개선 START
			Change_StyleIcon(sParam)
			'20211019 아이티젠(김성수) 관심화면 개선 END
		elseif sParam == "SET_SCREEN" then
			Form.OpenFramePopup("mhprc11010_p1" , "환경설정", "")
		elseIf sParam = "SHA_SNS" Then			' SNS 리턴 : 20160324 SNS연동 추가(화면연동)
			Form.OpenDialog("sharesns1" , "0", "")
		elseif sParam = "HELP_POPUP" Then'20211019 HSZ 도움말 추가
			Form.OpenPopup( "mhprc11010_p4", "HELP_POPUP" , "")
		end if
		
	end if
End Sub

'============================================================================
' Form_OnCommonDialogReturn : 종목검색창에서 선택된 종목 가져오기
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if Trim(sReturn1)  <> "" then
			edtGWAdd.caption = "1"	' 20160401 관심 타매체 실시간 연동(1:MTS에서 관심등록)
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_ADD", sReturn1 & "★" & cmbGroup.caption)
	'		grdList.SetCellData("bd_code", 0, sReturn1)
	'		szName = Form.GetItemCodeInfo(sReturn1, "name")
	'		grdList.SetCellData("bd_name", 0, szName)
	'		
	'		Check_LocalOrServer()
		end if
	end if
End Sub

'============================================================================
' Form_OnRefresh : 관심을 첫화면으로 했을때 종목 재조회
'============================================================================
Sub Form_OnRefresh()
	'init_GWGroup()
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
End Sub

'============================================================================
' Form_OnFormClose : 20160401
'============================================================================
Sub Form_OnFormClose()
	' 전체 장운영 알람 ----------------------------
	DATAMANAGER.CancelRealData("ohhts_whol_mkop")	
	
	' 20160401 관심 타매체 실시간 연동 ------------
	DATAMANAGER.CancelRealData("ohhts_intr_real")	
End Sub

'============================================================================
' tblSelect_OnClick
'============================================================================
Sub tblSelect_OnClick(lRow , lColumn)
	' 왓칭, 최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = cmbGroup.cbkeydata
	
	'20160906 NOHES START 왓칭, 최근조회, 보유종목 추가버튼만 예외처리
	if szKey == "AA" or szKey == "BB" or szKey == "CC" then
		if lColumn == 2 then
			Exit Sub
		end if
	end if
	'20160906 NOHES END
	' //////////////////////////////////////////////////////////////////////
    
	if lColumn == 0 then							' 현재/예상/단일
		if g_szRSelect == "0" then
			tblSelect.SetCellString(0, 0, "예상")
			g_szRSelect = "1"
			Form.SetEnvData("1", "GW_RSELECT", "1")
			imgSelect.imgpath = "toggle_img3_2.png"
		elseif g_szRSelect == "1" then
			tblSelect.SetCellString(0, 0, "단일")
			g_szRSelect = "2"
			Form.SetEnvData("1", "GW_RSELECT", "2")
			imgSelect.imgpath = "toggle_img3_3.png"
		elseif g_szRSelect == "2" then
			tblSelect.SetCellString(0, 0, "현재")
			Form.SetEnvData("1", "GW_RSELECT", "0")
			g_szRSelect = "0"
			imgSelect.imgpath = "toggle_img3_1.png"
		end if

		edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption )
	elseif lColumn == 1 then						' 편집
		Form.OpenFramePopup("mhprc11010_p2" , "", "")
	elseif lColumn == 2 then						' 추가
		if CInt(edtListCnt.rowcount) >= 100 then
			'Form.ShowAlert("관심종목추가", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
			Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		end if
		
		' 종목검색창 열기
		Form.OpenCommonDialog("SEARCH", "0", edtListCnt.caption)		' 20160407 : 종목갯수를 플랫폼에 보낸다.
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
		grdGroup.rowcount = 0
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID	
	
	'20230321 HSZ START : 화면집계 서비스호출 추가
	elseif szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = CInt(szOSType) + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "11014") '하드코딩(미사용 화면번호)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "관심종목(블랙)") '하드코딩
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) '최근 로그인 아이디
	'20230321 HSZ END

	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
	' ----------------------------------------------------------------------
	' 20160401 관심 타매체 실시간 연동
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_real" then
		DATAMANAGER.SetDataValue(1, "ohhts_intr_real", "InBlock1", "FIDR_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		'20160906 NOHES START관심그룹 없는 경우 새로등록창 안내
		If g_szFirst == "0" Then
			If DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1") < 1 Then
				Form.MsgBox("안내", "등록된 관심그룹이 없습니다.\n관심그룹을 새로 등록하시겠습니까?", "ADDGROUP", 1)
			End If
		End If
		'20160906 NOHES END
		Save_GWGroup()		' 동기화 상태일때도 파일에는 계속저장
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		edtMkopCd.caption = DATAMANAGER.GetDataValue(1, "ohhts_whol_mkop", "OutBlock1", "FIDR_MKOP_TRNM_CODE", 0)
		edtMkopNm.caption = DATAMANAGER.GetDataValue(1, "ohhts_whol_mkop", "OutBlock1", "FIDR_MKOP_CLS_NAME",  0)
	' ----------------------------------------------------------------------
	' 20160401 관심 타매체 실시간 연동
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_real" then
		Dim szID, szReturn
		szID, szReturn = "", ""
		
		if g_szCloud == "1" then		' Server 저장시
			szID = Form.GetSharedData("&USER_ID", false)	' USER ID
			szReturn = DATAMANAGER.GetDataValue(1, "ohhts_intr_real", "OutBlock1", "FIDR_USER_ID", 0)
			
			if Trim(szID) == Trim(szReturn) then
				if Trim(edtGWAdd.caption) == "1" then
					edtGWAdd.caption = "0"
					Exit Sub
				else
					edtGWAdd.caption = "0"
					init_GWGroup()
				end if
			end if
		end if
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	if szTranID == "ohhts_intr_006r" then
'		Form.Toast(1, "[" & szErrCode & "]" & szErrMsg, true)
'	end if
End Sub

'============================================================================
' fmTab_OnTabChanged
'============================================================================
Sub fmTab_OnTabChanged(nCurrentTab)
	fmTab.currenttab = "1"		' 20160406 :  속도이슈때문에 선택 위치 변경
	
	if nCurrentTab == 2 then
		btnNext_OnClick()
	elseif nCurrentTab == 0 then
		btnPrev_OnClick()
	end if
End Sub

'============================================================================
' cmbGroup_OnEditComplete
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	Dim szStyle, szKey
	
	' 왓칭, 최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = cmbGroup.cbkeydata
	'20160906 NOHES START 왓칭, 최근조회, 보유종목은 추가버튼 예외처리
	if szKey == "AA" or szKey == "BB" or szKey == "CC" then
		tblSelect.SetCellFgColor(0, 1, "4") 
		tblSelect.SetCellFgColor(0, 2, "127")
	else
		tblSelect.SetCellFgColor(0, 1, "4") 
		tblSelect.SetCellFgColor(0, 2, "4")
	end if
	'20160906 NOHES END
	' //////////////////////////////////////////////////////////////////////
	
	'fmTab.currenttab = "1"		' 20160406 :  속도이슈때문에 선택 위치 변경
	edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "CHANGE_GROUP", "")		' 초기화
	
	' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
	Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)

	if g_szFirst == "0" then
		g_szFirst = "1"
		'  스타일 초기화 ///////////////////////////////////////////////////////
		if Form.GetEnvData("GW_STYLE") == "" then
			szStyle = "SET_STYLE1"
		else
			szStyle = Form.GetEnvData("GW_STYLE")
		end if
		
		Change_Style(szStyle)
		Change_StyleIcon(szStyle)
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "STYLE", szStyle)
		' //////////////////////////////////////////////////////////////////////
	end if
	
	'20211026 아이티젠(김성수) 관심 개선 START
	f_SetToggleUI(szKey)
	
	lblGroupNm.caption = cmbGroup.caption
	'20211026 아이티젠(김성수) 관심 개선 END
	
	' Sub화면에 조회 요청
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
	
End Sub

'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick()
	if Int(cmbGroup.currentindex) == 0 then
		cmbGroup.currentindex = cmbGroup.rowcount-1
	else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	end if
End Sub

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick()
	if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
		cmbGroup.currentindex = 0
		
	else
		cmbGroup.currentindex = cmbGroup.currentindex + 1
		
	end if
	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub

'============================================================================
' rdoChart_OnClick
'============================================================================
Sub rdoChart_OnClick(nIndex)
	if nIndex == 0 then  '일
		g_flagMin = false
		g_flagTic = false
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
	elseif nIndex == 1 then  '주/월
		g_flagMin = false
		g_flagTic = false
		if g_flagWeek == true   then
			if g_szChrtType == "W" then
				g_szChrtType = "M"
				g_flagWeek = false
				rdoChart.SetRadioCaption( 1, "월" )
			else
				g_szChrtType = "W"
			end if
		else
			if g_szChrtType == "M" then
				g_szChrtType = "W"
				g_flagWeek = true
				rdoChart.SetRadioCaption( 1, "주" )
			else
				g_szChrtType = "M"
			end if
		end if	
		PeriodSet(g_szChrtType)
'	elseif nIndex == 2 then  '월
'		g_szChrtType = "M"
'		PeriodSet(g_szChrtType)
	elseif nIndex == 2 then   '분
		g_flagTic = false
	
		g_szChrtType = "A"
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(rdoChart.GetRadioCaption( 2),"분")
			g_szMinType = tmpMin[0]
			PeriodSet(g_szChrtType)
		else
			'g_flagMin = false
			Form.OpenPopup( "mhcht13000_p1" , g_szMinType , "" )
		end if
	elseif nIndex == 3 then   '틱
		g_flagMin = false
		
		g_szChrtType = "T"
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(rdoChart.GetRadioCaption( 3),"틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
		else
			Form.OpenPopup( "mhcht13000_p2" , g_szTicType , "" )
			'g_flagTic = false
		end if
	end if	
End Sub
	

'============================================================================
Sub Form_OnFormInitBefore()
	'------------------------------------------------------------------
	' 20190814 HWG START : MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	'------------------------------------------------------------------
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단
	
	'20180129 LES START - 관심종목 초기세팅값 변경
	Form.SetEnvData("1","GW_RSELECT", "0")
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20210823 HSZ CFD
'20160427 LKM START - 코치마크 	

	'20211119 HSZ START - CFD 관심종목 화면에서는 SKIP 
	if g_szScreenNo = "13101" then
		exit sub
	end if
	'20211119 HSZ END
	
	Dim szPopup
	szPopup = Form.LoadConfigData( "mhprc11010", "mhprc11010_p4" )

	'20211108 HSZ START 화면개편 - 코치마크 다시 띄워주기
	newPopdate = Form.LoadConfigData( "mhprc11010", "mhprc11010_p4_date" )
	if newPopdate = "" or newPopdate = null then
		Form.SaveConfigData("mhprc11010", "mhprc11010_p4_date", "20211111") 
		Form.SaveConfigData("mhprc11010", "mhprc11010_p4", "0" )
		Form.OpenPopup( "mhprc11010_p4", "" , "")
		exit sub
	end if
	'20211108 HSZ END

	If szPopup <> "1" Then 
		Form.OpenPopup( "mhprc11010_p4", "" , "")
	End If

'20160427 LKM END



End Sub

'20160906 NOHES START 관심그룹 추가 등록 
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ADDGROUP" then	
		If sRet == "ok" Then
			Form.OpenFramePopup("mhprc11010_p2" , "AddGroup", "")
		End If
	end if
End Sub
'20160906 NOHES END

'============================================================================
'20211019 아이티젠(김성수) 관심화면 개선 START
'============================================================================
' f_SetPrcType : 토글버튼 이벤트 및 이미지 적용
'============================================================================
Function f_SetPrcType(nType)
	Dim nParam
	nParam = CInt(nType)
	
	g_szRSelect = CStr(nParam)
	Form.SetEnvData("1", "GW_RSELECT", g_szRSelect) '설정 저장
	
	if nParam == 0 then
		LblToggle.caption = "현재가"
		imgToggle.imgpath = "togglenavy_1.png"
		
	elseif nParam == 1 then
		LblToggle.caption = "예상가"
		imgToggle.imgpath = "togglenavy_2.png"
		
	elseif nParam == 2 then
		LblToggle.caption = "단일가"
		imgToggle.imgpath = "togglenavy_3.png"
		
	end if
	
	edtListCnt.caption = "" ' 종목리스크 카운트 에디트 클리어
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption )
	
End Function

'============================================================================
' Change_StyleIcon : 스타일 아이콘 이미지 적용
'============================================================================
Function Change_StyleIcon(sStyle)
	if sStyle == "SET_STYLE1" then
		imgStyle.imgpath = g_tStyleImgNm(0)
	elseif sStyle == "SET_STYLE2" then
		imgStyle.imgpath = g_tStyleImgNm(1)
	elseif sStyle == "SET_STYLE3" then
		imgStyle.imgpath = g_tStyleImgNm(2)
	elseif sStyle == "SET_STYLE4" then	'	20211115 HSZ : 스타일4 추가
		imgStyle.imgpath = g_tStyleImgNm(3)
	end if
	
End Function

'============================================================================
' f_ShowGroupList : 관심그룹리스트 보이기
'============================================================================
Function f_ShowGroupList()
	dim nRowCnt, szSendData
	nRowCnt = CInt(grdGroup.rowcount)
	szSendData = ""
	
	if nRowCnt > 0 then
		for i=0 to nRowCnt-1
			dim sKey, sName, sStr
			sKey = grdGroup.GetCellData( "bd_code", i )
			sName = grdGroup.GetCellData( "bd_name", i )
			sStr = sKey & "`" & sName
			
			if szSendData == "" then
				szSendData = sStr
			else
				szSendData = szSendData & "★" & sStr
			end if
		next
	end if
	
	'20211116 아이티젠 김성수 추가
	'종목편집 창에서 Env가 바뀌는 것때문에 현재 선택 그룹키 값을 저장
	Form.SetSharedData( "PresentSelectKey", cmbGroup.cbkeydata)
	
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	if g_Ostype = "2" then
		Form.OpenPopupAnimation("mhprc11010_p7" , szSendData, "", "3")
	else 
		Form.OpenPopupAnimation("mhprc11010_p7" , szSendData, "", "1")
	end if
	
End Function

'============================================================================
Function f_SetToggleUI(szKey)
'	20160906 NOHES START 왓칭, 최근조회, 보유종목은 추가버튼 예외처리
'	20220103 HSZ : imgEdit 종목추가 삭제 (주석처리)
	if szKey == "AA" or szKey == "BB" or szKey == "CC" then
		'20211119 아이티젠 김성수 수정 START
		'CFD관심일때는 스타일 버튼 안보임 처리
'		imgEdit.visible = false '20220103 HSZ
		
		if g_szScreenNo == "13101" then'CFD
			imgStyle.visible = false '스타일 아이콘
			imgGrp.left = 336 '그룹편집
			LblToggle.left = 264 '301 20220103 HSZ '토글라벨
			imgToggle.left = 316 '353 20220103 HSZ '토글이미지
'		else
'			LblToggle.left = 262 '토글라벨
'			imgToggle.left = 314 '토글이미지
		end if
	else
'		imgEdit.visible = true '20220103 HSZ
		
		if g_szScreenNo == "13101" then'CFD
			imgStyle.visible = false '스타일 아이콘
			imgGrp.left = 336 '그룹편집
'			imgEdit.left = 335 '종목편집 20220103 HSZ 주석처리
			LblToggle.left = 264 '토글라벨
			imgToggle.left = 316 '토글이미지

'		else
'			LblToggle.left = 224 '토글라벨
'			imgToggle.left = 276 '토글이미지
		end if
		
	end if
	'20160906 NOHES END
End Function

'============================================================================
' imgStyle_OnClick : 스타일 아이콘 클릭 이벤트
'============================================================================
Sub imgStyle_OnClick()
	Dim sNowStyle, sChangeStyle
	sNowStyle = Form.GetEnvData("GW_STYLE")
	
	if sNowStyle == "" or sNowStyle == null then
		sNowStyle = "SET_STYLE1"
	end if
	
	if sNowStyle == "SET_STYLE1" then
		sChangeStyle = "SET_STYLE2"
		
	elseif sNowStyle == "SET_STYLE2" then
		sChangeStyle = "SET_STYLE3"
		
	elseif sNowStyle == "SET_STYLE3" then
		sChangeStyle = "SET_STYLE4"
'	20211115 HSZ START : 스타일4 추가 
	elseif sNowStyle == "SET_STYLE4" then
		sChangeStyle = "SET_STYLE1"
'	20211115 HSZ END
	end if
	
	Form.SetEnvData("1", "GW_STYLE", sChangeStyle)
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "STYLE", sChangeStyle)
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GW_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
	
	Call Change_Style(sChangeStyle)
	Call Change_StyleIcon(sChangeStyle)
	
End Sub

'============================================================================
' imgEdit_OnClick : 종목추가 클릭 이벤트
'============================================================================
Sub imgEdit_OnClick()
	if CInt(edtListCnt.rowcount) >= 100 then
		'Form.ShowAlert("관심종목추가", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
	end if
		
	' 종목검색창 열기
	Form.OpenCommonDialog("SEARCH", "0", edtListCnt.caption)		' 20160407 : 종목갯수를 플랫폼에 보낸다.

End Sub

'============================================================================
' imgGrp_OnClick : 관심편집 클릭 이벤트 
'============================================================================
Sub imgGrp_OnClick()
	Form.OpenFramePopup("mhprc11010_p2" , "", "") '편집 팝업 오픈
End Sub
'============================================================================
' btnOpenGroup_OnClick : 그룹메뉴 버튼
'============================================================================
Sub btnOpenGroup_OnClick()
	f_ShowGroupList()
End Sub

'============================================================================
' lblGroupNm_OnClick : 그룹명 label
'============================================================================
Sub lblGroupNm_OnClick()
	f_ShowGroupList()
End Sub

'============================================================================
' LblToggle_OnClick :  현재가/예상가/시간외 토글 버튼
'============================================================================
Sub LblToggle_OnClick()
	if g_szRSelect == "0" then
		g_szRSelect = "1"
		imgToggle.imgpath = "togglenavy_2.png"
		
	elseif g_szRSelect == "1" then
		g_szRSelect = "2"
		imgToggle.imgpath = "togglenavy_3.png"
		
	elseif g_szRSelect == "2" then
		g_szRSelect = "0"
		imgToggle.imgpath = "togglenavy_1.png"
		
	end if

	f_SetPrcType(g_szRSelect)
End Sub

