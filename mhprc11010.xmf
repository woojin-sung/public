'****************************************************************************
'============================================================================
' init_GWGroup :  관심그룹 재설정 (로컬/서버)
'============================================================================
Function f_ChangeRdoType(nIdx)
	' 왓칭, 최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = cmbGroup.cbkeydata
	
	'20160906 NOHES START 왓칭, 최근조회, 보유종목 추가버튼만 예외처리
	if szKey == "AA" or szKey == "BB" or szKey == "CC" then
		if lColumn == 2 then
			Exit Function
		end if
	end if
	'20160906 NOHES END
	' //////////////////////////////////////////////////////////////////////
	
	if nIdx == 0 then
		g_szRSelect = "0"
		Form.SetEnvData("1", "GW_RSELECT", "0")
	elseif nIdx == 1 then
		g_szRSelect = "1"
		Form.SetEnvData("1", "GW_RSELECT", "1")
	elseif nIdx == 2 then
		g_szRSelect = "2"
		Form.SetEnvData("1", "GW_RSELECT", "2")
	end if
	
End Function

'============================================================================
' init_GWGroup :  관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup()
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup()
		Insert_cmbGroup()
		
	end if
End Function

'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect
	
	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")
	
	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
	For i = 0 to #g_tDefault-1
		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
		
		if g_tGSelect[i] == "" or g_tGSelect[i] == null then
			g_tGSelect[i] = "1"
		end if
		
		' 해당그룹 Show시
		if g_tGSelect[i] == "1" then
		
			if i == 0 then
				szgrpList = g_tKey[i] & "`" & g_tNm[i]
			
				nIdx = 0
			else
				if szgrpList == "" then
					szgrpList = g_tKey[i] & "`" & g_tNm[i]
				else
					szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
				end if
				
				if nIdx >= 0 then
					nIdx = nIdx + 1
				else
					nIdx = 0
				end if			
			end if
			
			if szSave == g_tKey[i] then
				nSelect = nIdx
			end if

			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		end if
	NEXT
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		g_szAppFirst = "NO"
		
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
	else
		g_szAppFirst = "YES"
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------
	
	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	'20160804 NOHES START 초기값 셋팅
	If CStr(nSelect) == "-1" Then
		nSelect = 0 
	End If
	'20160804 NOHES END
	
	'20230208 HSZ START : 시장종합 개선 건. 분기처리 추가
	if g_szOpenData = "1" then
		cmbGroup.currentindex = CStr(g_szOpenData)
	else
		cmbGroup.currentindex = CStr(nSelect)	
	end if
	'20230208 HSZ END
End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	Form.SaveConfigData("GWANSIM", "GROUP", "")
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

'============================================================================
' Control_FmTab_Swipe : 폼탭의 좌우스크롤 제어
'============================================================================
Function Control_FmTab_Swipe()
	' 좌우 스크롤시 관심그룹 변경 설정
	' 20160325 최초설정은 좌우스트롤 가능하도록 변경 -> 요청사항
	if Form.GetEnvData("GW_SWIPE") == "0" then
		fmTab.usepg = "0"
	else
		fmTab.usepg = "1"
	end if
End Function

'============================================================================
' Change_Style : 오른쪽 상단 편집과 차트 버튼부분
'============================================================================
Function Change_Style(szStyle)
	'20210823 HSZ START : CFD 화면 추가
	if g_szScreenNo = "13101" then
		Form.SetTitleCaption("국내주식CFD 관심종목")
		szStyle = "SET_STYLE1"
	end if
	'20210823 HSZ END
	
	if szStyle == "SET_STYLE1" or szStyle == "SET_STYLE2" or szStyle == "SET_STYLE4" then '	20211115 HSZ START : 스타일4 추가 
'		tblSelect.visible = true
'		tblLine.visible   = true
'		imgSelect.visible = true
		
		'20211019 아이티젠(김성수) 관심종목 개선 START
		LblToggle.visible = true
		imgToggle.visible = true
		
		' 왓칭, 최근조회, 보유종목 예외처리 ////////////////////////////////////
		szKey = cmbGroup.cbkeydata
		f_SetToggleUI(szKey)
		
		imgGrp.visible = true 
		
		f_SetPrcType(g_szRSelect)
		
		'20211019 아이티젠(김성수) 관심종목 개선 END
		
		rdoChart.visible = false
		imgWeek.visible  = false
		imgMin.visible   = false
		imgTick.visible  = false
	elseif szStyle == "SET_STYLE3" then
'		tblSelect.visible = false
'		tblLine.visible   = false
'		imgSelect.visible = false
		
		'20211019 아이티젠(김성수) 관심종목 개선 START
		LblToggle.visible = false
		imgToggle.visible = false	
'		imgEdit.visible = false '20220103 HSZ 주석처리
		imgGrp.visible = false 
		'20211019 아이티젠(김성수) 관심종목 개선 END
		
		rdoChart.visible = true
		imgWeek.visible  = true
		imgMin.visible   = true
		imgTick.visible  = true
	else
'		tblSelect.visible = false
'		tblLine.visible   = false
'		imgSelect.visible = false
		
		'20211019 아이티젠(김성수) 관심종목 개선 START
		LblToggle.visible = false
		imgToggle.visible = false		
'		imgEdit.visible = false '20220103 HSZ 주석처리
		imgGrp.visible = false 
		'20211019 아이티젠(김성수) 관심종목 개선 END
		
		rdoChart.visible = false
		imgWeek.visible  = false
		imgMin.visible   = false
		imgTick.visible  = false
	end if
	
End Function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
Function PeriodSet(sPeriodType)
	if sPeriodType= "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	elseif sPeriodType= "A" then
	   g_sPeriod = CInt(g_szMinType) * 60
	   g_sPeriodType = "1"
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	    g_sPeriod ="1"
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	    g_sPeriod ="1"
	end if
	
	sPeriod = CInt( g_sPeriod)
	
	if Len( sPeriod )= 1 then
		g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
		g_sPeriod = "0"..g_sPeriod
	end if

	if sPeriodType= "T" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "SET_CHART", g_sPeriodType & "★" & g_sPeriod & "★" & g_szChrtType & "★" & g_szTicType)
	elseif sPeriodType= "A" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "SET_CHART", g_sPeriodType & "★" & g_sPeriod & "★" & g_szChrtType & "★" & g_szMinType)
	else
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "SET_CHART", g_sPeriodType & "★" & g_sPeriod & "★" & g_szChrtType & "★")
	end if
End Function


