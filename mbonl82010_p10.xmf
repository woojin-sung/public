				</TABLE>
				<LABEL name="lblInfo0" fontsize="-2" caption="신용거래융자는 재원에 따라 회사의 자금으로 빌려주는 자기신용거래융자와 증권금융회사로부터 대출받아 고객에게 빌려주는 유통신용거래융자가 있으며, 신용 매수주문 입력 후 '주문'창 및' 주식체결내역' 화면에서 확인할 수 있음." valign="0" multiline="1" ly_vert="25,31,325,136,1" />
				<LABEL name="lblInfo2" fontsize="-2" caption="권리 관계의 처리는 한국증권금융의 “증권유통금융에 부수하는 배당금 및 신주인수권 처리 등의 요령“에 따라 처리됨." valign="0" multiline="1" ly_vert="25,196,325,50,1" />
				<LABEL name="lblInfo3" fontsize="-2" caption="유통금융매수증권의 의결권 행사를 위해서는 고객이 회사 영업점을 방문하거나 전화 등을 통하여 의결권 행사를 신청해야 함." valign="0" multiline="1" ly_vert="25,246,325,50,1" />
				<LABEL name="lblInfo4" fontsize="-2" caption="(유통융자 담보활용에 동의한 경우) 본인은 증권금융회사로부터 차입한 자금으로 신용융자 매수한 종목에 대하여 담보로 제공하여 증권금융회사가 제3자에게 대여하는 것에 동의하며, 증권금융회사에서 제3자 대여로 인해 발생한 이익은 사전 약정에 따라 고객에게 제공됨. 또한, 제3자 대여 시 의결권 행사가 제한될 수 있으며 의결권 행사를 위해서는 주주총회 기준일 5영업일 이전에 담보활용동의 철회를 완료하여야 함." valign="0" multiline="1" ly_vert="25,296,325,145,1" />
				<LABEL name="lblInfo5" fontsize="-2" caption="SMS(또는 알림톡)로 변경내용을 요약 통보함" valign="0" multiline="1" ly_vert="25,484,325,50,1" />
				<LABEL name="lblInfo6" fontsize="-2" caption="담보부족, 반대매매, 만기예정 내역을 SMS(또는 알림톡)로 통보" valign="0" multiline="1" ly_vert="25,552,325,50,1" />
				<LABEL name="lblInfo7" fontsize="-2" caption="추가담보요구(담보부족) 시 전화(핸드폰→원장통보지
→통보지외전화 순) 및 SMS/이메일(이메일은 선택한
경우에 한함)로 통보하며, 전화/SMS/이메일 모두 통보
불가(발송실패) 시 내용증명으로 통보" valign="0" multiline="1" ly_vert="25,588,325,80,1" />
				<LABEL name="lblInfo1" fontsize="-2" caption="회사의 사정에 의하여 신용거래융자의 재원이 변경될 수 있으며, 중도전환의 경우도 있을 수 있음." valign="0" multiline="1" ly_vert="25,116,325,50,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<CONTAINER name="Container1" ly_vert="0,597,375,50,1" scroll_ly_vert="0,597,375,50,1" >
			<CONTROL_INFO>
				<BUTTON name="btnOK" caption="확인" btnimage="btn_01.9" ly_vert="183,0,194,50,1" />
