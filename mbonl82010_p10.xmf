'============================================================================
Sub Form_OnFormInit()
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	Dim tOpenData, tData1
	tOpenData = Form.GetOpenLinkData()
	if tOpenData <> "" then	
		tData1 = Split(tOpenData,"★")	
		if tData1[0] <> nil then
			g_nIndex = tonumber(tData1[0])
		end if 
		if tData1[1] <> nil then
			g_nSubIndex = tonumber(tData1[1])
		end if 
	else
		g_nIndex = -1
		g_nSubIndex = -1	
		exit Sub	
'For TEST
'g_nIndex = 0
'g_nSubIndex = 2
'msgbox g_nIndex  & " *** " & g_nSubIndex		
	end if 

	SetContainerVisible()
	SetContainerContent()
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Container00.Top = g_szTop
	Container01.Top = g_szTop
	'Container02.Top = g_szTop
	Container03.Top = g_szTop
	Container04.Top = g_szTop
	Container05.Top = g_szTop

	Container00.Height = g_szHeight
	Container01.Height = g_szHeight
	'Container02.Height = g_szHeight
	Container03.Height = g_szHeight
	Container04.Height = g_szHeight
	Container05.Height = g_szHeight
	
End Sub

'============================================================================
Sub Container1_btnCancel_OnClick()
	Form.SendReturnToParent("mbonl82010_p10" , "Close☆"& g_nSubIndex)
	g_szRet	=	"Cancel"
	Form.CloseForm()	
End Sub

'============================================================================
Sub Container1_btnOK_OnClick()
	Form.SendReturnToParent("mbonl82010_p10" , "OK☆"& g_nSubIndex)
	g_szRet	=	"OK"
	Form.CloseForm()	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

