			</CONTROL_INFO>
		</CONTAINER>
		<LABEL name="Label1" bgcolor="075:244244244" transmode="0" ly_vert="10,150,355,5,1" />
		<LABEL name="lbSubTitle" fontsize="2" fontstyle="01" caption="이자 및 상환 방식" click="1" ly_vert="10,106,315,50,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="11335" _ulen="9426" >
Dim g_szDeviceOS
Dim g_nOpenIndex
g_nOpenIndex = -1

Dim g_tTitle, g_tSubTitle
Dim g_nIndex, g_nSubIndex


g_tTitle = {"신용거래융자약정", "신용거래대주약정", "증권담보융자약정" }
g_tSubTitle = {"이자 및 상환 방식", "담보 관련", "소비자 부담금액", "투자위험 및 불이익", "금융소비자의 권리", "기타 유의사항" }

Dim g_szTop, g_szHeight, g_szContainer
g_szTop = 165
g_szHeight = 433
g_szContainer = ""

Dim g_szRet
g_szRet	=	"Cancel"

'============================================================================
Function SetContainerVisible()
	lbSubTitle.caption = g_tSubTitle[g_nSubIndex]
	
	Dim szName
	for i = 0 to #g_tTitle - 1
		for j = 0 to #g_tSubTitle - 1
			szName = "Container" & CStr(i) & CStr(j)	
			if i == g_nIndex and j == g_nSubIndex then
				Form.SetCtlProp(szName, "left", 0)
				g_szContainer = szName
			else
				Form.SetCtlProp(szName, "left", 500)
			end if 			
		Next
	Next	
End Function 

'changeTextAttr(nStartOffset, nLen, nColorIdx, nFontSize, isBold)
Function SetContainerContent()
	Dim nLen, nStartOffset
	
	if g_szContainer == "Container00" then  '1. 이자 및 상환 방식
		nStartOffset = 0
		nLen = Container00.lblInfo2.getLen(Container00.lblInfo0.caption)	
		Container00.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, true) 		

		nStartOffset = Container00.lblInfo2.getLen("일자계산은 ")
		nLen = Container00.lblInfo2.getLen("한편넣기")
		Container00.lblInfo2.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container00.lblInfo2.getLen("이자 미납 시 연체이자 부과")	
		Container00.lblInfo5.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container00.lblInfo7.getLen(Container00.lblInfo7.caption)			
		Container00.lblInfo7.changeTextAttr(nStartOffset, nLen, 10, -2, false)
	elseif g_szContainer == "Container01" then '2. 담보 관련
		'1.안드로이드 2.iOS
		if g_szDeviceOS == "2" then 
			nStartOffset = 147
		else
			nStartOffset = 140
		end if			
		nLen = Container01.lblInfo0.getLen("당사가 신용거래융자 대상종목으로 지정한 A군, B군, C군")	
		Container01.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 13
		nLen = Container01.lblInfo3.getLen("주권(증권예탁증권 포함) 또는 상장집합투자기구의 집합투자증권을 담보로 징구")	
		Container01.lblInfo3.changeTextAttr(nStartOffset, nLen, 10, -2, false)	
		
		nStartOffset = 110
		nLen = Container01.lblInfo4.getLen("담보유지비율에 미달하는 경우 추가납부 요구")	
		Container01.lblInfo4.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 6
