				<LABEL name="lblInfo1" fontsize="-2" caption="신용 매수시점부터 상환 시점까지의 보유기간에 따른 최종 이자율을 적용하는 방식" valign="0" multiline="1" ly_vert="25,31,325,50,1" />
				<LABEL name="lblInfo2" fontsize="-2" caption="일자계산은 한편넣기 방법으로 융자매수 결제일 익일부터 현금상환일 또는 융자매도 결제일까지로 계산" valign="0" multiline="1" ly_vert="25,118,325,55,1" />
				<LABEL name="lblInfo3" fontsize="-2" caption="정기 : 매월 첫 영업일(전월분 이자 징수)" valign="0" multiline="1" ly_vert="25,206,335,45,1" />
				<LABEL name="lblInfo0" fgcolor="005:000000000" fontsize="-1" fontstyle="01" caption="소급법" valign="0" multiline="1" ly_vert="145,11,325,20,1" />
				<LABEL name="lblInfo4" fontsize="-2" caption="수시 : 상환일(매월 첫영업일부터 상환일(매매결제일, 현금상환일)까지 경과기간에 대한 이자 징수)" valign="0" multiline="1" ly_vert="25,224,325,45,1" />
				<LABEL name="lblInfo5" fontsize="-2" caption="이자 미납 시 연체이자 부과" valign="0" multiline="1" ly_vert="25,261,325,45,1" />
				<LABEL name="lblInfo6" fontsize="-2" caption="매도상환, 현금상환" valign="0" multiline="1" ly_vert="25,321,325,45,1" />
				<LABEL name="lblInfo7" fontsize="-2" caption="상환기일에 상환되지 않을 경우 연체이자 발생 및 반대매매로 인한 손실이 발생할 수 있음" valign="0" multiline="1" ly_vert="25,339,325,50,1" />
