	<SCRIPT_INFO _len="1180" _ulen="1112" >

'============================================================================
' 화 면 명 : 단기사채 투자자유의사항 팝업
'============================================================================

Dim g_szReturnKey

Dim szOSType

'============================================================================
Sub Form_OnFormInit()
	szOSType = Form.GetSharedData("&OS_TYPE", false)

	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  szOSType == "1" then'iOS("2")Android("1")
		cont.setScrollBarVisible("2")
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl88060_p16" , g_szReturnKey)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szReturnKey = "cancel"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_szReturnKey = "ok"
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
