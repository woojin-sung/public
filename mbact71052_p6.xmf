'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_ELS/DLS
' 02. 화면설명 : 고객자산평가_상품별잔고_ELS/DLS
' 03. 작    성 : 2016. 02. 03. 유창재
' 04. 수    정 : 2018. 09. 21. 신미정 스마트프로 오류수정 v001
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "ACNO" , 0 , g_szList(Int(g_nAllCount)) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "PROS_CLS" , 0 , "1" )	'조회구분(종합)
		
		DATAMANAGER.RequestTranData( "obacb_balc_033r" )
	else
		lblVisible()
	end if

End Function
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "08")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Function Asset_Request()
	'--------------------------------------------------------------
	' 전역변수 초기화
	'--------------------------------------------------------------	
	'대상계좌 개수 세팅
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	'서비스 날리기전 인덱스 초기화
	g_nNextCount = 0
	
	'--------------------------------------------------------------
	'서비스 호출
	'--------------------------------------------------------------
	'Y:전체 그외:개별

	if g_szList(1) == "Y" then
		cont0.grd1.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.ClearInputData(0, "obacb_balc_033r")
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "ACNO" , 0 , LEFT(g_szList(3), 8) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "ASNO" , 0 , RIGHT(g_szList(3), 2) )		'계좌번호
	'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_033r", "InBlock1", "PROS_CLS" , 0 , "2" )	'조회구분(개별)
		
		DATAMANAGER.RequestTranData( "obacb_balc_033r" )
	end if
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	cont0.grd1.SetClear()
	
	if sEventName == "mbact71052_p6" then			'ELS/DLS
	
		g_szList = Split(sParam,"○")
	
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		
		'상단 카드뷰 평가금액 서비스 호출 후 자산조회
		call VltnAmt_Request()
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11,
		szTemp12, szTemp13, szTemp14, szTemp15
	Dim szSplit, TempCount
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_033r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_033r", "OutBlock1")-1
		
			cont0.grd1.AddRow()
			
			szTemp = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ACNO" , i) &
					DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ASNO" , i)
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "PBLC_DATE" , i)	'매수일
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "FUND_PBLC_UNPR" , i)	'매수기준가
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "BYNG_AMT" , i)	'매수금액
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ERT" , i)	'수익률
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "CLRD_DATE" , i)	'차기평가일
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "RDMP_ERT_INFO_EXPL" , i)	'상환수익률
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "CLRD_BARR_HIT_DATE" , i)	'상환확정일
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ABRV_ISNM" , i)	'종목명
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "MTRT_DATE" , i)	'만기일
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "PSNT_PRC" , i)	'현재기준가
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "VLTN_AMT" , i)	'평가금액
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "CLRD_DTRM_DATE" , i)	'차기지급일
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "CCLS_DATE" , i)	'확정지급일			
			szTemp16 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ITEM_CNTT" , i)	'확정수익률			
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ACNT_PRNM" , i))
			szTemp15 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			if g_szList(1) == "Y" then
				cont0.grd1.SetCellData("bd_acc", g_nNextCount , szTemp..szTemp15)
			end if
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , szTemp8)
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp3)
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , szTemp11)
'			cont0.grd1.SetCellData("bd_cell7", g_nNextCount , szTemp12)
'			cont0.grd1.SetCellData("bd_cell8", g_nNextCount , szTemp4)
			if CDBL(szTemp4) > 0 then
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount , "+"..FormatNumber(szTemp12, 0))
				cont0.grd1.SetCellData("bd_cell8", g_nNextCount  , "+"..FormatNumber(szTemp4, 2))
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "10")
			elseif CDBL(szTemp4) < 0 then
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount , FormatNumber(szTemp12, 0))
				cont0.grd1.SetCellData("bd_cell8", g_nNextCount  , FormatNumber(szTemp4, 2))
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount , FormatNumber(szTemp12, 0))
				cont0.grd1.SetCellData("bd_cell8", g_nNextCount  , FormatNumber(szTemp4, 2))
			end if
			cont0.grd1.SetCellData("Data1", g_nNextCount , szTemp1)
			cont0.grd1.SetCellData("Data2", g_nNextCount , szTemp9)
			cont0.grd1.SetCellData("Data3", g_nNextCount , szTemp2)
			cont0.grd1.SetCellData("Data4", g_nNextCount , szTemp10)
			
			cont0.grd1.SetCellData("Data5", g_nNextCount , szTemp5)
			cont0.grd1.SetCellData("Data6", g_nNextCount , szTemp13)
			cont0.grd1.SetCellData("Data7", g_nNextCount , szTemp6)
'			cont0.grd1.SetCellData("Data8", g_nNextCount , szTemp16)		'확정수익률
			cont0.grd1.SetCellData("Data9", g_nNextCount , szTemp7)		
			cont0.grd1.SetCellData("Data10", g_nNextCount , szTemp14)		
			
			if Trim(DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ITEM_CNTT" , i)) == "미확정" then
				cont0.grd1.SetCellData("Data8", g_nNextCount, DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ITEM_CNTT" , i))
			elseif Trim(DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ITEM_CNTT" , i)) == "" or Trim(DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ITEM_CNTT" , i)) == Null then
				'g_nNextCount = g_nNextCount + 1
				'Exit for 
				'v001 주석처리 
			else
				szSplit = DATAMANAGER.GetDataValue( 0 , "obacb_balc_033r", "OutBlock1", "ITEM_CNTT" , i)
				cont0.grd1.SetCellData("Data8", g_nNextCount, szSplit&"%")
			end if
			
			g_nNextCount = g_nNextCount + 1
		next
		
		cont0.grd1.rowcount = g_nNextCount
		
		if  DATAMANAGER.IsMoreNextData( "obacb_balc_033r" ) == True then 
				DATAMANAGER.RequestNextData( "obacb_balc_033r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if

	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		if CDBL(nPrlsrate) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsrate) < 0 then
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "4")
		end if
		call Asset_Request()
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	grd0.SetClear()
	g_nNextCount = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
End Sub 
'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.lblNone.visible = true
	else
		cont0.lblNone.visible = false
	end if
End Function 

'============================================================================
Sub cont0_grd1_OnClickUp(lRow, szCellID)
	Dim szSendData
	Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, szTemp12, szTemp13, szTemp14, szTemp15, szTemp16, szTemp17
	szTemp1 = cont0.grd1.GetCellData("bd_cell1", lRow)
	szTemp2 = cont0.grd1.GetCellData("bd_cell3", lRow)
	szTemp3 = cont0.grd1.GetCellData("bd_cell2", lRow)
	szTemp4 = cont0.grd1.GetCellData("bd_cell7", lRow)
	szTemp5 = cont0.grd1.GetCellData("bd_cell8", lRow)
	szTemp6 = cont0.grd1.GetCellData("Data1", lRow)
	szTemp7 = cont0.grd1.GetCellData("Data2", lRow)
	szTemp8 = cont0.grd1.GetCellData("Data7", lRow)
	
	
'	szTemp9 = cont0.grd1.GetCellData("Data4", lRow)
'	szTemp10 = cont0.grd1.GetCellData("Data5", lRow)
'	szTemp11 = cont0.grd1.GetCellData("Data6", lRow)
'	szTemp12 = cont0.grd1.GetCellData("Data7", lRow)
'	szTemp13 = cont0.grd1.GetCellData("Data8", lRow)
'	szTemp14 = cont0.grd1.GetCellData("Data9", lRow)
'	szTemp15 = cont0.grd1.GetCellData("Data10", lRow)
	
'	szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10 & "☆" & szTemp11 & "☆" & szTemp12 & "☆" & szTemp13 & "☆" & szTemp14 & "☆" & szTemp15
	
	szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8
	
	Form.OpenPopupAnimation("mbact71052_pi", szSendData, "", "2")
End Sub




