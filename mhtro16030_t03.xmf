'===========================================================================
' 01. 업무구분 : 해외주식
' 02. 화면 :  ETF
' 03. 화면설명 : 
' 04. 작성자 : 정성헌
' 05. 작성일 : 2015.04.27
' 06. 수정이력 : 이재원 2017.10.12
'===========================================================================
Dim g_tCmbData1
Dim g_tCmbData2
Dim g_nPage
Dim g_xPos
Dim nRowCount
Dim g_szNext
g_tCmbData1 = "상해^심천^홍콩" '미/홍/중			
g_tCmbData2 = "" ' 일/베
g_nPage = 0
g_xPos  = ""
nRowCount = 0
g_szNext = ""
'============================================================================
Sub Form_OnFormInit()
	
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Combo1.bgimagetype = "1"
	
	if Combo1.cbkeydata == "0" then
		DATAMANAGER.RequestTranData( "ohhts_6247_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6247_002r" ) 
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	Dim szDelay
	
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	szCmb1 = Form.GetCtlProp( "Combo1",  "cbkeydata" )
	
	szDelay = ""
	if szCmb0 <> "" then
		szDelay = Form.GetSharedData("REALTIME_"..szCmb0, 0 )
	end if
	
	if szCmb0 == "CN" then
		if RadioGroup1.currentindex == "0" then
			szCmb0 = "SH"
		else
			szCmb0 = "SZ"
		end if
	end if
		
	if szTranID == "ohhts_6247_001r" or szTranID == "ohhts_6247_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62470" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , szCmb0 )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , 0 , szCmb1 )
	end if
end Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	g_nPage  = 0
	nRowCount = 0
	g_szNext = ""
	Grid0.SetClear( )
	
	if Combo0.currentindex == "0" then
		RadioGroup1.visible = "1"
		Combo1.left = "280"
	else
		RadioGroup1.visible = "0"
		Combo1.left = "99"
	end if
	
	if Combo1.cbkeydata == "0" then
		DATAMANAGER.RequestTranData( "ohhts_6247_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6247_002r" ) 
	end if
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)		
	g_nPage  = 0
	nRowCount = 0
	g_szNext = ""
	Grid0.SetClear( )
	if Combo1.cbkeydata == "0" then
		DATAMANAGER.RequestTranData( "ohhts_6247_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6247_002r" ) 
	end if
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 0
	nRowCount = 0
	g_szNext = ""
	Grid0.SetClear( )
	if Combo1.cbkeydata == "0" then
		DATAMANAGER.RequestTranData( "ohhts_6247_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6247_002r" ) 
	end if
end Sub

'============================================================================
function _tonumber(data)
	return tonumber(data) or 0
end function

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim bNext, szTranID
	szTranID = ""
	if Combo1.cbkeydata == "0" then
		szTranID = "ohhts_6247_001r"
	else
		szTranID = "ohhts_6247_002r"
	end if

	bNext = DATAMANAGER.IsMoreNextData( szTranID )
	if bNext == "1" or bNext == true then
		DATAMANAGER.RequestNextData( szTranID )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode
	Dim sKorname
	Dim sExid
	
	sCode 	= Grid0.GetCellData( "bd_cell7", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell0", lRow )
	sExid	= Grid0.GetCellData( "bd_cell2", lRow )
	
	if sCode <> "" then

		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sExid.."@"..sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")
		
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	g_nPage  = 0
	nRowCount = 0
	g_szNext = ""
	Grid0.SetClear( )
	if Combo1.cbkeydata == "0" then
		DATAMANAGER.RequestTranData( "ohhts_6247_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6247_002r" ) 
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Combo0.currentindex = "1"
End Sub

