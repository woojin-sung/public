	<SCRIPT_INFO _len="8847" _ulen="8389" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : MY ELS/DLS _ 중도환매신청하기
' 02. 화면설명 : MY ELS/DLS _ 중도환매신청하기
'                

' 03. 이    력 : 
' - 2024.06.26 성우진


'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_sACNO, g_sASNO, g_sISCD
g_sACNO = ""
g_sASNO = ""
g_sISCD = ""

Dim g_sTemp21, g_sTemp22, g_sTemp23
g_sTemp21 = ""
g_sTemp22 = ""
g_sTemp23 = ""

Dim g_sOSType
g_sOSType = ""

Dim g_szQty
g_szQty = 0

Dim g_sAcntName
g_sAcntName = ""

Dim g_sReturn
g_sReturn = ""
'============================================================================
Sub Form_OnFormInitBefore()
'	ImgGrade0.setMaintainingRatio("1")
'	ImgGrade1.setMaintainingRatio("1")
'	ImgGrade2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	LblISNM.maxlinecnt = "1^2"
	
	g_sOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if g_sOSType == "2" then
		LblOK.maxlinecnt = "2^1"
		LblOK.caption = "중도환매\n신청하기"
	else
		LblOK.visible = False
		BtnOK.caption = "중도환매\n신청하기"
	end if
End Sub

'============================================================================
Sub BtnPrcin_OnClick()
	LblPrcin_OnClick()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsao_rght_107r" then
		DATAMANAGER.SetDataValue(0, "obsao_rght_107r", "InBlock1", "CONT_CLS_CODE",		0, "4"		)	
		DATAMANAGER.SetDataValue(0, "obsao_rght_107r", "InBlock1", "ACNO",				0, g_sACNO	)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obsao_rght_107r", "InBlock1", "ASNO",				0, g_sASNO	)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obsao_rght_107r", "InBlock1", "IQRY_CLS_CODE",		0, "1"		)	
		DATAMANAGER.SetDataValue(0, "obsao_rght_107r", "InBlock1", "ISCD",				0, g_sISCD	)	'종목코드	
	
	elseif szTranID == "obsao_rght_001a" then
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "CONT_CLS_CODE",		0, "4"		)	
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "ACNO",				0, g_sACNO	)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "ASNO",				0, g_sASNO	)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "PWD",				0, edtPassword.caption	)
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "ISCD",				0, g_sISCD	)	'종목코드	
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "OM_RMND_CLS_CODE",	0, "1"		)	'일반 1, 대출 2(대출 가능한지 확인)
		DATAMANAGER.SetDataValue(0, "obsao_rght_001a", "InBlock1", "APLT_QTY"		,	0, g_szQty	)	
		

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obsao_rght_107r" then
		 sPRVS_DATE = DATAMANAGER.GetDataValue(0, "obsao_rght_107r", "OutBlock1", "RPRC_PBMN_PRVS_DATE",				0) 
	 
		 tblInfo.SetCellString(7, 2 , Right(Trim(sPRVS_DATE), 6))
	
	elseif szTranID == "obsao_rght_001a" then
		
		sHostDate = Right(Trim(Form.GetSharedData("&HOST_DATE", false)),6)
		sSendData = "SubScription" & "★" & g_sAcntName & "★" & Trim(LblISNM.caption) & "★" & g_szQty & "★" & sHostDate & "★" & tblInfo.GetCellString(7,2)
		
		Form.OpenPopup("mbfnp53100_p3",sSendData , "")
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0 , 0.2)
	
	if Cint(sTimerID) == 1 then
		DATAMANAGER.RequestTranData("obsao_rght_107r")
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "53100_RequestData"then
	
		g_sACNO = Form.GetSharedData("53100_ACNO", true)
		g_sASNO = Form.GetSharedData("53100_ASNO", true)
		g_sISCD = Form.GetSharedData("53100_ISCD", true)
		g_sAcntName = Form.GetSharedData("53100_ACNTNAME", true)
		
		g_sTemp21 = Form.GetSharedData("53100_TEMP21", true)  '원금보장여부
		g_sTemp22 = Form.GetSharedData("53100_TEMP22", true)  '위험여부판단
		g_sTemp23 = Form.GetSharedData("53100_TEMP23", true)  '고난도여부
		
		ImageSetting()
		
		Form.SetTimerEvent2("1", 1, 0.2)
	
	elseif sEventName == "Clear" then
		LblPrcin.caption = ""
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.MsgBox("안내", szErrMsg.."("..szSubErr..")" , "", 6)
	else
		Form.MsgBox("안내", szErrMsg , "", 6)
	end if
End Sub

'============================================================================
Function ImageSetting()
	
	'고난도 여부
	if g_sTemp23 == "Y" then
		ImgGrade2.imgpath = "img_bgsquare_grade_363.png"
		LblGrade2.caption = "고난도"
		LblGrade2.fgcolor = 384
	end if
	
	'원금보장여부
	if g_sTemp21 == "Y" then
		ImgGrade0.imgpath = "img_bgsquare_grade_316.png"
		LblGrade0.caption = "원금보장형"
		LblGrade0.fgcolor = 333
	else
		ImgGrade0.imgpath = "img_bgsquare_grade_316.png"
		LblGrade0.caption = "원금비보장형"
		LblGrade0.fgcolor = 333
	end if
	
	'위험여부판단
	if g_sTemp22 == "01" then
		ImgGrade1.imgpath = "img_bgsquare_grade_372.png"
		LblGrade1.caption = "매우높은위험"
		LblGrade1.fgcolor = 273
	elseif g_sTemp22 == "02" then
		ImgGrade1.imgpath = "img_bgsquare_grade_373.png"
		LblGrade1.caption = "높은위험"
		LblGrade1.fgcolor = 144
	elseif g_sTemp22 == "03" then
		ImgGrade1.imgpath = "img_bgsquare_grade_374.png"
		LblGrade1.caption = "다소높은위험"
		LblGrade1.fgcolor = 144
	elseif g_sTemp22 == "04" then
		ImgGrade1.imgpath = "img_bgsquare_grade_375.png"
		LblGrade1.caption = "보통위험"
		LblGrade1.fgcolor = 144
	elseif g_sTemp22 == "05" then
		ImgGrade1.imgpath = "img_bgsquare_grade_376.png"
		LblGrade1.caption = "낮은위험"
		LblGrade1.fgcolor = 144
	elseif g_sTemp22 == "06" then
		ImgGrade1.imgpath = "img_bgsquare_grade_377.png"
		LblGrade1.caption = "매우낮은위험"
		LblGrade1.fgcolor = 273
	end if
	
End Function
'============================================================================


'============================================================================
Sub BtnOK_OnClick()
	CheckPricePopup()
End Sub

'============================================================================
Sub LblPrcin_OnClick()
	BtnPrcin.caption = ""
	LblPrcin.caption = ""
	LblPrcin0.caption = ""
	g_sReturn = ""
	g_szQty = 0
	
	Form.OpenPopup("mbfnp53100_p11","","")

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 가격입력창에서 리턴
	if sKeyName == "PRC_POPUP" then	
		
		g_sReturn = sRet
		
		CheckPricePopup()
	
	elseif sKeyName == "CLEAR_POPUP" then
		BtnPrcin.caption = ""
		LblPrcin.caption = ""
		g_sReturn = ""
		g_szQty = 0
		
	'계좌비번 수신
	elseif sKeyName = "CORRECT_PWD" then
		
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				
				DATAMANAGER.RequestTranData( "obsao_rght_001a" )
			end if
		end if
	
	'신청 완료 화면 수신
	elseif sKeyName == "mbfnp53100_p3" then
		Form.triggerEvent("#", "mbfnp53100_t11", "")
	end if
End Sub
'============================================================================
Function CheckPricePopup()
	
	if g_sReturn <> "" and int(g_sReturn) <> 0 and g_sReturn <> null then
			
		nRemainder = tonumber(g_sReturn) % 100
			
		g_szQty = 0
			
		if nRemainder = 0 then
			LblPrcin.fgcolor = "3"
			LblPrcin.mask = "0,0,,주,1,,0,1,1"
			g_szQty = Cint(g_sReturn)
	
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",g_sACNO & g_sASNO &"☆"&"0","","2")
					
		else
			LblPrcin0.fgcolor = "1"
			LblPrcin.mask = "0,0,,주,1,,0,1,1"
			LblPrcin0.mask ="1,0,,,1,,0,1,1"
					
			LblPrcin0.caption = "최소수량을 확인해주세요.(100주 단위)"			
		end if
				
		LblPrcin.caption = Cint(g_sReturn)

	else' 
		LblPrcin0.fgcolor = "1"
		LblPrcin0.mask ="1,0,,,1,,0,1,1"
		LblPrcin0.caption = "수량을 입력해주세요."
	end if
	
End Function
'============================================================================
Sub LblOK_OnClick()
	BtnOK_OnClick()
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obsao_rght_107r" trcode="obsao_rght_107r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obsao_rght_001a" trcode="obsao_rght_001a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obsao_rght_107r" title="OTC 공모/사모계좌 환매신청잔고" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="300" _ulen="224" >

CONT_CLS_CODE^접촉 구분 코드^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
PWD^비밀번호^68^0^0^0^0^0^0
IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
ISCD^종목코드^12^0^0^0^0^0^0
OM_RMND_CLS_CODE^장외잔고구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="30" inout="out" _len="724" _ulen="546" >

OM_RMND_CLS_CODE^장외 잔고 구분 코드^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
