	<SCRIPT_INFO _len="1796" _ulen="1756" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'============================================================================
Sub Button0_OnClick()
	Save_Select()
	Form.triggerEvent( "#", "NextStep", "1" )
End Sub

'============================================================================
Sub Form_OnFormInit()
	rdo_yn = Form.GetSharedData("&MYDATA_IS_SCHEDULED", false )	'조회 후 사용자 설정 변경 시, 화면에서 재설정 필요
	if rdo_yn = "false" then
		RdoYn.currentindex = 1
		RdoMonth.currentindex = -1
	end if
'	Button0.enable = False
End Sub

'============================================================================
Function Save_Select()
	If RdoYn.currentindex = "0" then
		Form.SetSharedData("&MYDATA_IS_SCHEDULED"	, "true")
		Form.SetSharedData("&MYDATA_FND_CYCLE"		, "1/w")
	Elseif RdoYn.currentindex = "1" then
		Form.SetSharedData("&MYDATA_IS_SCHEDULED"	, "false")
		Form.SetSharedData("&MYDATA_FND_CYCLE"		, "")
	End if
	
	if Int(RdoMonth.currentindex) > -1 then
		Form.SetSharedData("&MYDATA_ADD_CYCLE"		, "1/w")
	else
		Form.SetSharedData("&MYDATA_ADD_CYCLE"		, "")
	end if
End Function 
'============================================================================

'Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	DATAMANAGER.SetDataValue( 0 , "obaci_myif_001r", "InBlock1", "IF_CI" , 0 , g_userci )
'End Sub
'============================================================================
Sub RdoYn_OnClick(nIndex)
	if nIndex = 1 then
		RdoMonth.enable = false
		RdoMonth.currentindex = -1
	else 
		RdoMonth.currentindex = 0
		RdoMonth.enable = true
	end if
End Sub

	</SCRIPT_INFO>
