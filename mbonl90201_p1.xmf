'============================================================================
' 01. 화 면 명 : 장외채권 상품 목록 조회
' 02. 화면설명 : 장외채권 상품 목록 조회
'                기본적인 조건은 단기사채 화면의 로직을 기본으로 개발함.

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szRet
g_szRet = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Sub f_setBtn(iIndex)	
	Container0.Image0.imgpath = "btn_line2_n.9"
	Container0.Image1.imgpath = "btn_line2_n.9"
	Container0.Image2.imgpath = "btn_line2_n.9"
	Container0.Image3.imgpath = "btn_line2_n.9"
	Container0.Image4.imgpath = "btn_line2_n.9"
	Container0.Image5.imgpath = "btn_line2_n.9"
	
	select case CInt(iIndex)		
		case 0	Container0.Image0.imgpath = "btn_line2_o.9.png"
	     case 1	Container0.Image1.imgpath = "btn_line2_o.9.png"
	     case 2	Container0.Image2.imgpath = "btn_line2_o.9.png"
	     case 3	Container0.Image3.imgpath = "btn_line2_o.9.png"
	     case 4	Container0.Image4.imgpath = "btn_line2_o.9.png"
	     case 5	Container0.Image5.imgpath = "btn_line2_o.9.png"
	end select
end Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szLinkData
	
	szLinkData = Form.GetOpenLinkData()
'	Form.ShowAlert("FormInit", szLinkData)
	select case szLinkData		
		case "11"	
'			Container0.Image0.imgpath = "input_03_o.9.png"
			Container0.Image0.imgpath = "btn_line2_o.9.png"
			
			g_szRet = "0"
			
	     case "21"	
'		     Container0.Image1.imgpath = "input_03_o.9.png"
		     Container0.Image1.imgpath = "btn_line2_o.9.png"
		     g_szRet = "1"
		     
	     case "31"	
'		     Container0.Image2.imgpath = "input_03_o.9.png"
		     Container0.Image2.imgpath = "btn_line2_o.9.png"
		     g_szRet = "2"
		     
	     case "32"	
'		     Container0.Image3.imgpath = "input_03_o.9.png"
		     Container0.Image3.imgpath = "btn_line2_o.9.png"
		     g_szRet = "3"
		     
	     case "41"	
'		     Container0.Image4.imgpath = "input_03_o.9.png"
		     Container0.Image4.imgpath = "btn_line2_o.9.png"
		     g_szRet = "4"
		     
	     case "42"	
'		     Container0.Image5.imgpath = "input_03_o.9.png"
		     Container0.Image5.imgpath = "btn_line2_o.9.png"
		     g_szRet = "5"
		     
	end select
	
End Sub

