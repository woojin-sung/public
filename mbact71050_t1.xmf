'============================================================================
' 01. 화 면 명 : 고객자산평가_고객별자산
' 02. 화면설명 : 고객자산평가_고객별자산
' 03. 작    성 : 2016. 02. 04. 유창재
' 2021.07.05 : 정민영 : v0001 : obcsb_efif_005r IO재매핑
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim nCellType			'토글 상태를 구분하기 위한 변수
Dim szTemp			'고객번호
Dim szACNO			'계좌번호
Dim szUSERID
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetInput(szData) : TR의 입력값 세팅
'============================================================================
Function SetInput(szData)

	DATAMANAGER.SetDataValue( 0 , "ooopc_cuma_043r", "InBlock1", "CSNO" , 0 , szData)
	DATAMANAGER.SetDataValue( 0, "ooopc_cuma_030r", "InBlock1", "CSNO" , 0 , szTemp)
	
	DATAMANAGER.RequestTranData("ooopc_cuma_030r")
	DATAMANAGER.RequestTranData( "ooopc_cuma_043r" )
	
End Function

Function SetName()
	grd0.SetCellData( "cell1_1" , 0 , "주식")
	grd0.SetCellData( "cell13_1" , 0 , "해외주식")
	grd0.SetCellData( "cell2_1" , 0 , "CFD")
	grd0.SetCellData( "cell3_1" , 0 , "채권")
	grd0.SetCellData( "cell4_1" , 0 , "CMA")
	grd0.SetCellData( "cell5_1" , 0 , "펀드")
	grd0.SetCellData( "cell6_1" , 0 , "ELS/DLS")
	grd0.SetCellData( "cell7_1" , 0 , "선물옵션")
	grd0.SetCellData( "cell8_1" , 0 , "외화/기타상품")
	grd0.SetCellData( "cell9_1" , 0 , "D+2추정예수금")
	grd0.SetCellData( "cell10_1" , 0 , "신용설정보증금")
	grd0.SetCellData( "cell11_1" , 0 , "자산소계")
	grd0.SetCellData( "cell12_1" , 0 , "대출소계")
	grd0.SetCellData( "cell14_1" , 0 , "순자산")

	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()		자산유형 출력값 세팅
'============================================================================
Sub Form_OnFormInit()
	
	nCellType = 0
	lbl0.visible = false
	lblline.visible = false
	grd0.SetVisibleCol( 2, false)
	
	SetName()

	szACNO = ""
	szUSERID = Form.GetSharedData("&USER_ID", false )
	
	DATAMANAGER.SetDataValue(0,  "obcsb_efif_005r", "InBlock1", "PROS_CLS_CODE", 0 , "1")
	DATAMANAGER.SetDataValue(0,  "obcsb_efif_005r", "InBlock1", "ELFN_ID"	  , 0 , szUSERID)
	
	DATAMANAGER.RequestTranData("obcsb_efif_005r")
	
End Sub
'============================================================================
' grd0_OnHeaderClickUp(lRow, szCellID) : 토글버튼 부분
'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	
	'16-03-23 오택경 차장님께서 토글지 조회 안되게 수정 요청함.
	if szCellID == "th_cell1" or szCellID == "th_cell4" then
		if nCellType == 0 then		'매수금액 TR
	'		DATAMANAGER.ClearTranConnectedCtrl( "ooopc_cuma_043r" )
			
			nCellType = 1
	'		grd0.SetCellTopCaption( "th_cell1" , "매수금액" )
			
			lbl0.visible = true
			lblline.visible = true
			
	'		DATAMANAGER.SetDataValue( 0 , "ooopc_cuma_043r_1", "InBlock1", "CSNO" , 0 , szTemp)
	'		DATAMANAGER.RequestTranData( "ooopc_cuma_043r_1" )
			
			grd0.SetVisibleCol( 2, true)
			grd0.SetVisibleCol( 1, false)
			
			for i = 8 to 11
				grd0.SetCellData( i , 1 , "0")
			next
		else			'평가금액 TR
	'		DATAMANAGER.ClearTranConnectedCtrl( "ooopc_cuma_043r_1" )
			
			nCellType = 0
	'		grd0.SetCellTopCaption( "th_cell1" , "평가금액" )
			grd0.SetVisibleCol( 1, true)
			grd0.SetVisibleCol( 2, false)
			
			lbl0.visible = false
			lblline.visible = false
			
	'		DATAMANAGER.SetDataValue( 0 , "ooopc_cuma_043r", "InBlock1", "CSNO" , 0 , szTemp)
	'		DATAMANAGER.RequestTranData( "ooopc_cuma_043r" )
		end if
	end if
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbact71050_t1" then		'고객별자산
			szTemp = sParam
			
		Call SetInput(szTemp)	
'		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , sParam)
'		szACNO = sParam
	end if
	
'	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : ooopc_cuma_030r TR을 사용하여 사용자번호를 입력하여 계좌번호 출력
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ooopc_cuma_043r" then
		grd1.SetClear()
	
'		DATAMANAGER.SetDataValue( 0, "ooopc_cuma_030r", "InBlock1", "CSNO" , 0 , szTemp)
'		DATAMANAGER.RequestTranData("ooopc_cuma_030r")
	elseif szTranID == "ooopc_cuma_030r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "ooopc_cuma_030r" , 0) - 1 
'			szACNO = szACNO & "☆" & DATAMANAGER.GetDataValue( 0, "ooopc_cuma_030r", "OutBlock1", "ACNO" , i) 'grd1.GetCellData("bd_cell0", i)
'			Form.ShowAlert("szACNO", szACNO)
		next
		SetName()
'		Form.ShowAlert("szACNO", szACNO)
	elseif szTranID == "ooopc_cuma_043r_1" then
		SetName()
	elseif szTranID == "obcsb_efif_005r" then
		CUST_GRAD_CODE = CSTR(DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock1", "CUST_GRAD_CODE", 0))
		CUST_GRAD_CODE = LEFT(CUST_GRAD_CODE,1)
		
		if TRIM(CUST_GRAD_CODE) == "1" then
		    Label0.caption = Label0.caption & " 다이아몬드"
		elseif TRIM(CUST_GRAD_CODE) = "2" then
		    Label0.caption = Label0.caption & " 플레티넘"
		elseif TRIM(CUST_GRAD_CODE) == "3" then
		    Label0.caption = Label0.caption & " 프리미엄"
		elseif TRIM(CUST_GRAD_CODE) == "4" then
		    Label0.caption = Label0.caption & " 골드"
		elseif TRIM(CUST_GRAD_CODE) == "5" then
		    Label0.caption = Label0.caption & " 실버"
		elseif TRIM(CUST_GRAD_CODE) == "6" then
		    Label0.caption = Label0.caption & " 등급없음"
		elseif TRIM(CUST_GRAD_CODE) == "9" then
		    Label0.caption = Label0.caption & " 등급없음"
		else
		    Label0.caption = Label0.caption & ""
		end if
	end if
	
'	if szTranID == "obcsb_acif_000r" then
'		szTemp = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_000r", "OutBlock1", "CSNO" , 0)
'		Call SetInput(szTemp)
'	elseif szTranID == "ooopc_cuma_043r" then
'		
'	end if
	
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	for i = 0 to grd1.rowcount - 1
		szACNO = szACNO & "☆" & grd1.GetCellData("bd_cell0", i)
'		grd1.GetCellData("bd_cell0", 0)
	next
	
	'행을 누를때 각각의 상세팝업
	Select Case Left(szCellID , 6)
		Case "cell1_"
			szData = "1" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell2_"
			szData = "0" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)		
		Case "cell3_"
			szData = "1" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell4_"
			szData = "3" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell5_"
			szData = "4" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell6_"
			szData = "5" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell7_"
			szData = "7" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell8_"
			szData = "6" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell9_"
			szData = "8" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
		Case "cell13_"
			szData = "2" & "☆" & 0 & "☆" & grd1.rowcount - 1 & szACNO
			Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
'		Case "cell9_"
'			Form.OpenFramePopup( "mbact71050_p1" , 8 , sPosInfo)
'		Case "cell10"
'			Form.OpenFramePopup( "mbact71050_p1" , 9 , sPosInfo)
'		Case "cell11"
'			Form.OpenFramePopup( "mbact71050_p1" , 10 , sPosInfo)
'		Case "cell12"
'			Form.OpenFramePopup( "mbact71050_p1" , 11 , sPosInfo)
	End Select
	
End Sub

