--===========================================================================
' 2019.10.16 - 자동조회 기능추가
--===========================================================================

Dim g_szItemCode '종목코드
Dim g_szQty '청산가능수량
Dim g_szFncd
Dim g_szACNO
Dim g_szASNO
'============================================================================
Sub Form_OnFormInitBefore()
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	g_szFncd = edtFundCd.caption
End Sub
'============================================================================
Sub Form_OnFormInit()
		
	'펀드코드 계좌조회
	if len(trim(g_szFncd)) > 0 Then
		DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	end if
	
	if szTranID == "obfnd_sstm_103r" then 
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "ACNO" , 0 , g_szACNO)
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "ASNO" , 0 , g_szASNO)
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "BSOP_DATE" , 0 , CalQryDate.caption)
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "FTOT_TPCD" , 0 , CmbFO.cbkeydata )
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "STLM_FORM_TPCD", 0 , CmbMethod.cbkeydata )
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "IQRY_CLS_CODE" , 0 , CmbQryCls.cbkeydata )
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "IQRY_CNT" 	  , 0 , EdtQryDate.caption )
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "INDV_MANG_BRCD", 0 , "%" )
		DATAMANAGER.SetDataValue( false, "obfnd_sstm_103r", "InBlock1", "OVDV_ACNT_CLCD", 0 , "3" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		
		if len(trim(g_szACNO)) > 0 Then
			'해외파생 고유 만기종목보유계좌 조회
		DATAMANAGER.RequestTranData("obfnd_sstm_103r")
		else
			grdData.SetClear()
			Form.ShowAlert("알림", "펀드코드를 확인하세요.")
		End If
		
	end if
	
	if szTranID = "obfnd_sstm_103r" then
		Dim nCount, nIndex
		
		nCount = DATAMANAGER.GetDataCount( false, "obfnd_sstm_103r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount step 1
				Dim szOPTN_CLS_CODE, szOVDV_DEAL_CLCD, szFISCD, szOTST_RMND_RSQN, szSTA_DATE, szMTRT_DATE, szFRST_INFR_DATE
				
				szOPTN_CLS_CODE	= DATAMANAGER.GetDataValue( false, "obfnd_sstm_103r", "OutBlock1", "OPTN_CLS_NAME" 	, i )'상품구분
				szOVDV_DEAL_CLCD 	= DATAMANAGER.GetDataValue( false, "obfnd_sstm_103r", "OutBlock1", "OVDV_DEAL_CLCD" 	, i ) '매도수구분
				
				'상품구분
				grdData.SetCellData("OptnClsName", nIndex+i, szOPTN_CLS_CODE)
				
				'구분				
				if szOVDV_DEAL_CLCD = "1" then
					grdData.SetCellData("Deal", nIndex+i, "매수")
					grdData.SetCellFgColor("Deal", nIndex+i, "1")
				elseif szOVDV_DEAL_CLCD = "2" then
					grdData.SetCellData("Deal", nIndex+i, "매도")
					grdData.SetCellFgColor("Deal", nIndex+i, "2")
				end if				
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
'	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		
'	if Trim(szSubMsg) <> "" then
'		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
'	else
'		Form.ShowAlert("알림", szErrMsg)
'	end if
	if szTranID == "obfnp_fnmt_011r" then
		Form.SetTimerEvent(0, 0, 5)
	end if
End Sub


'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub

'============================================================================
' 연속조회
'============================================================================
Sub grdData_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obfnd_sstm_103r") = true then
		DATAMANAGER.RequestNextData( "obfnd_sstm_103r" )
	end if
End Sub
'============================================================================
' 펀드코드 변경시 
'============================================================================
Sub edtFundCd_OnEditComplete()
	g_szFncd = edtFundCd.caption
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub
