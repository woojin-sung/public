'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnCancel_OnClick - 취소
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnEnroll_OnClick - 등록
'============================================================================
Sub btnEnroll_OnClick()
	'확인정보로 등록
	'추가인증-> 보안매체-> 공인인증 순으로 처리 후 완료되었다는 메세지 띄우고 종료
	'추가인증삭제
	'Form.OpenFramePopup("mhetc90060_p8" , "bank_reservation" , "")
	TR_Inquiry("obcsb_oimf_625r")
	'TR_Inquiry("obrtd_drng_015a")
End Sub



'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			TR_Inquiry("obcsb_oimf_625r")
		else
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
		else 					'실패
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'모바일OTP v001
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
		else						'실패		
			exit sub
		end if	
	end if	
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			TR_Inquiry("obrtd_drng_015a")
		else						'실패
			exit sub
		end if
	end if
	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			TR_Inquiry("obrtd_drng_015a")
		ElseIf sRet == "cancel" Then
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szData, szList
	
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	szData = Form.GetOpenLinkData()
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 THEN
		EXIT SUB
	END IF
	
'	Form.ShowAlert("szData", szData)
	g_szAccountNumber = szList(0)	'출금계좌번호
	g_szAccountSerialNumber = szList(1)	'출금계좌일련번호
	g_szAccountPassword = szList(2)	'비밀번호
	g_szMoney = szList(3)	'신청금액	
	g_szBankName = szList(4)	'은행이름/은행계좌번호	
	g_szCnFtName = szList(5)	'수취인명	
	g_szRsevDate = szList(6)	'예약일자
	g_szAmPm = szList(7)	'오전 A   오후 P 구분
	g_szDate = szList(8)	'신청일자
	g_szSrNo	= szList(9)	'요청일련번호
	g_szFee	= szList(10)	'수수료
	for i=0 to 7
		Table0.SetCellString( i, 1, "" )	'테이블 clear
	next
	
	Table0.SetCellString( 7, 2, "" )	'테이블 clear
	
	Table0.SetCellString( 0, 1, g_szDate)	'예약등록일
	Table0.SetCellString( 1, 1, g_szRsevDate)	'예약일자
	if g_szAmPm == "A" then
		Table0.SetCellString( 2, 1, "오전 10:30 ~ 11:30")	'예약시간
	else
		Table0.SetCellString( 2, 1, "오후 04:30 ~ 05:30")	
	end if
	
	Table0.SetCellString( 3, 1, Left(g_szAccountNumber, 4).."-"..Mid(g_szAccountNumber, 5, 4) & "-" & g_szAccountSerialNumber)	'출금계좌
	Table0.SetCellString( 4, 1, g_szBankName)	'입금은행
	Table0.SetCellString( 5, 1, g_szCnFtName )	'받는분
	Table0.SetCellString( 6, 1, g_szMoney )		'출금금액
	Table0.SetCellString( 6, 2, g_szFee )		'수수료
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN, g_sGubunCode
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form.SendReturnToParent( "mbbnk61030_p3" , "fail" )
				Form.CloseForm( )
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP			
			Case "4" 'v001
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" ) '모바일OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
	
	
	if szTranID == "obrtd_drng_015a" then	'취소성공
		
		Form.SendReturnToParent( "mbbnk61030_p3" , "ok" )
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg <> "" or szErrMsg <> Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if

	if szTranID == "obrtd_drng_015a" then	'
		Form.MsgBox("알림",szErrMsg, "", 0)
		Form.SendReturnToParent( "mbbnk61030_p3" , "fail" )
		Form.CloseForm( )
	end if	
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_szAccountNumber &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub

