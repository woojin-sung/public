'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 정기이체등록_확인
' 02. 화면설명 : 정기이체등록_확인 팝업
' 03. 작    성 : 16.03.09
' 04. 수    정 : 장원혁 v001 모바일 OTP 개발
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


	Dim g_szAccountNumber	'출금계좌번호
	Dim g_szAccountSerialNumber	'출금계좌일련번호
	Dim g_szBankName	'은행이름
	Dim g_szAccountPassword	'비밀번호
	

	Dim g_szCnFtName 	'수취인명
	Dim	g_szExpl	'거래설명
	Dim g_szRsevDate 	'예약일자
	Dim g_szAmPm 	'오전 A   오후 P 구분
	Dim g_szOpenBank 	''개설은행계좌번호
	Dim g_szSrNo 	''요청일련번호
	Dim g_szCertUserType
	Dim g_szFee '수수료

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_625r" THEN		'보안매체확인
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szAccountNumber
		sACNO_PWD = g_szAccountPassword
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	end if
	
	if szTranID == "obrtd_drng_015a" then	'취소
		DATAMANAGER.SetEventFlag( "obrtd_drng_015a", "A" )
		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock1", "RQST_DATE" , 0 , g_szRsevDate)	'요청일자
		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock1", "RQST_SRNO", 0 , g_szSrNo)	'요청일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock1", "PROS_CLS" , 0 , "U")	'처리구분
		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock1", "MRNN_AFTN_CLS_CODE" , 0 ,  g_szAmPm)	'오전오후구분

		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock2", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock2", "ASNO", 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_015a", "InBlock2", "ACNT_PWD" , 0 , g_szAccountPassword)	'비밀번호

		DATAMANAGER.RequestTranData("obrtd_drng_015a")
	end if
End Function

