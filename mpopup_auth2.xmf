		<IMAGE name="Image3" visible="0" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,0" />
		<IMAGE name="imgBG" imgpath="popup_bg.9" ly_vert="0,400,375,204,1" />
		<BUTTON name="BtnNewRegi" caption="신규 등록" fgcolor="334:034034034" fontsize="4" btnimage="btn_27.9" ly_vert="-1,597,188,51,1" />
		<BUTTON name="BtnReuse" caption="이용 동의" fgcolor="320:246247248" fontsize="4" fontstyle="01" btnimage="btn_20.9" ly_vert="187,597,189,51,1" />
		<TABLE name="tblInfo" insidelinecolor="102:255255255" colcount="1" rowcount="7" outline="0000" designorder="1" ly_vert="0,432,376,145,1" >
