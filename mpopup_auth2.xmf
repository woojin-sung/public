	<SCRIPT_INFO _len="1604" _ulen="1554" >
'============================================================================
' 01. 화 면 명 : 로그인_간편인증_등록팝업
' 02. 화면설명 :
' 03. 작    성 : 
'============================================================================
Dim 	g_Reuse
Dim g_NewRegi
'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if sDeviceOS = "2" then
		Image3.visible = true
	elseif sDeviceOS = "1" then
'		
		Image3.visible = false
	end if
	
End Sub
'============================================================================
Sub BtnNewRegi_OnClick() 
	g_NewRegi = "Y"
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnReuse_OnClick()
	g_Reuse = "Y"
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormClose()
	if g_Reuse == "Y" then
		Form.SendReturnToParent("mpopup_auth2", "Reuse") 
	end if
	
	if g_NewRegi = "Y" then
		Form.SendReturnToParent("mpopup_auth2", "NewRegi") 
	end if
End Sub
'============================================================================
Sub Image4_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
