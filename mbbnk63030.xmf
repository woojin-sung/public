'============================================================================
' 01. 화 면 명 : 입출금내역
' 02. 화면설명 : 입출금내역
' 03. 작    성 : 2016. 02. 24. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_ComboIndex	'콤보선택 Index값
Dim g_GridCnt
Dim g_nCmb1
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTr() : TR 입력값 세팅, 조회 요청
'============================================================================
Function SetTr()
	g_GridCnt = 0
	'Grid0.SetClear()
	Grid0.rowcount = 0

	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "ACNO"          , 0 , acnt0.total)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "ASNO"          , 0 , acnt0.sequence)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "IO_CLS_CODE"   , 0 , g_nCmb1)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "IQRY_STA_DATE" , 0 , cld0.caption)
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "IQRY_FIN_DATE" , 0 , cld1.caption)
	
	'231013 htw start data 추가
	dim szGbn
	if CInt(rdoGbn.currentindex) == 0 then'전체
		szGbn = "%"
	elseif CInt(rdoGbn.currentindex) == 1 then'원화
		szGbn = "1" 
	elseif CInt(rdoGbn.currentindex) == 2 then'외화
		szGbn = "2"
	end if
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "CRNC_CLS_CODE" , 0 , szGbn)
	'231013 htw end data 추가
	
	if Combo0.cbkeydata == "0" then
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "SORT_CLS" , 0 , "DES")
	else
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_008r", "InBlock1", "SORT_CLS" , 0 , "ASC")
	end if
	
	DATAMANAGER.RequestTranData( "obrtp_tran_008r" )
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
dim g_szCRCD
g_szCRCD = ""
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	'수취인명 한줄표기
	Grid0.SetCellMaxLineCount("bd_cell19",1)

	g_nCmb1 = "%"
	
	szData = Form.GetOpenLinkData()

	if szData <> "" and szData <> null then
		if Len( Trim(szData) ) == 10 then
              nIndex = acnt0.GetIndexByAccountInfo(Trim(szData))
              acnt0.currentindex = nIndex
		end if
	end if	
	
	SetTr()
	
End Sub
'============================================================================
' cmb0_OnEditComplete(iIndex)
'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	Dim ToYear
	Dim ToMonth
	Dim ToDay
	
	ToYear  = Left(cld1.caption, 4)
	ToMonth = Mid (cld1.caption, 5, 2)
	ToDay   = Mid (cld1.caption, 7, 2)
	
	g_ComboIndex = iIndex
	'ComboIndex에 따라 조회 기간 설정
	Select Case g_ComboIndex
		Case 0
			cld1.caption = cldToday.caption
			cld0.caption = cld1.caption
		Case 1
			cld1.caption = cldToday.caption
'			cld0.caption = ((ToYear*10000) + (ToMonth*100) + (ToDay - 7))
			cld0.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)
		Case 2
			cld1.caption = cldToday.caption
'			cld0.caption = ((ToYear*10000) + ((ToMonth-1)*100) + ToDay)
			cld0.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)
		Case 3
			cld1.caption = cldToday.caption
'			cld0.caption = ((ToYear*10000) + ((ToMonth-3)*100) + (ToDay - 7))
			cld0.caption = Left(Form.calcDateTime( nYear, -3, nDay, nHour, nMinute, nSecond ), 8)
	End Select
	
	SetTr()
	
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	
	SetTr()
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    if szTranID == "obrtp_tran_008r" then
		
        for i = 0 to DATAMANAGER.GetDataCount( 0 , "obrtp_tran_008r", "OutBlock1") - 1
			
            '231013 htw start 외화,처리중 판단 추가
            g_szCRCD         = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CRCD"           , i)
            szUI_AMT_LETT1   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_AMT_LETT1"   , i) '예수금잔
            szUI_AMT_LETT2   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_AMT_LETT2"   , i) '입금금액
            szUI_AMT_LETT3   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_AMT_LETT3"   , i) '출금금액
            szRMTN_CNFR_CLCD = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "RMTN_CNFR_CLCD" , i) '송금확인
	    
            Grid0.SetCellData( "bd_cell21" , i+g_GridCnt, g_szCRCD)
			
            If Right(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_008r", "OutBlock1", "SMCD" , i),1) == "9" Then '취소거래
			
                Grid0.SetCellData( "bd_cell7" , i+g_GridCnt, "취소")
		
                if Trim(szUI_AMT_LETT2) == "0" Then
				    
                    if Trim(g_szCRCD) == "KRW" Or Trim(g_szCRCD) == "" Then
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT3 .." 원")         '출금금액
                    else
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT3 .." "..g_szCRCD) '출금금액
                    end if
				    
                Else
				    
                    if Trim(g_szCRCD) == "KRW" Or Trim(g_szCRCD) == "" Then
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT2 .." 원")'입금금액
                    else
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT2 .." "..g_szCRCD)'입금금액
                    end if
		    
                End If

                Grid0.SetCellFgColor( "Money" , i+g_GridCnt, "004")
		
            else
		
                if Trim(szUI_AMT_LETT2) == "0" Then
				
                    Grid0.SetCellData( "bd_cell7" , i+g_GridCnt, "출금")
                    if Trim(g_szCRCD) == "KRW" Or Trim(g_szCRCD) == "" Then
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT3 .." 원")'출금금액
                    else
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT3 .." "..g_szCRCD)'출금금액
                    end if
                    Grid0.SetCellFgColor( "Money" , i+g_GridCnt, "291")
                else
                    Grid0.SetCellData( "bd_cell7" , i+g_GridCnt, "입금")
		    
                    if Trim(g_szCRCD) == "KRW" Or Trim(g_szCRCD) == "" Then
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT2 .." 원")'입금금액
                    else
                        Grid0.SetCellData( "Money" , i+g_GridCnt, szUI_AMT_LETT2 .." "..g_szCRCD)'입금금액
                    end if
					
                    Grid0.SetCellFgColor( "Money" , i+g_GridCnt, "290")
                end if
				
				if Trim(szRMTN_CNFR_CLCD) <> "" then
					Grid0.SetCellImage("bd_cell23", i+g_GridCnt, "img_bgsquare_grade_316.png")
					Grid0.SetCellData("bd_cell23", i+g_GridCnt, "처리중")
					Grid0.SetCellFgColor("bd_cell23", i+g_GridCnt, "6")
				end if
				
				Grid0.SetCellFgColor( "Date" , i+g_GridCnt, "304")
				Grid0.SetCellFgColor( "bd_cell19" , i+g_GridCnt, "304")
				Grid0.SetCellFgColor( "bd_cell13" , i+g_GridCnt, "304")
				
			end if
			
			Grid0.setMaintainingRatio("Img" , i , "1")
			
		next
		'==========
	end if
	
End Sub

