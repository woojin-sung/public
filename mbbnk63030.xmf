'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim szData
	Dim rmtName
	
	if szCellID = "Img" or szCellID = "Money" or szCellID = "bd_cell17" then

		if Grid0.GetCellData( "bd_cell18" , lRow) <> "" then
			rmtName = Grid0.GetCellData( "bd_cell18" , lRow)
		else
			rmtName = Grid0.GetCellData( "bd_cell19" , lRow)
		end if
		
		if Grid0.GetCellData( "bd_cell14" , lRow) <> "" then
			cell2 =Grid0.GetCellData( "bd_cell14" , lRow)
		else
			cell2 = " "
		end if
		
		'231013 htw start 이체처리중 case 추가
		szIng = Grid0.GetCellData( "bd_cell23" , lRow)
		
		if Trim(szIng) <> "" then
			cell16 = "이체처리중"
		else
			if Grid0.GetCellData( "bd_cell16" , lRow) <> "" then
				cell16 = Grid0.GetCellData( "bd_cell16" , lRow)
			else
				cell16 = " "
			end if
		end if
		'231013 htw end 이체처리중 case 추가
		
		if Grid0.GetCellData( "bd_cell15" , lRow) = "00000000000" then
			cell15 = ""
		else
			cell15 = Grid0.GetCellData( "bd_cell15" , lRow)
		end if
			
		szData = Grid0.GetCellData( "Date" , lRow)&Grid0.GetCellData( "bd_cell3" , lRow) & "★" & '날짜		0
		acnt0.total&"-"&acnt0.sequence & "★" & '계좌													1
		Grid0.GetCellData( "bd_cell13" , lRow) & "★" &'적요코드명										2
		Grid0.GetCellData( "bd_cell7" , lRow) & "★" & '입금 or 출금									3
		Grid0.GetCellData( "Money" , lRow) & "★" & '금액												4
		grd1.GetCellData( "bd_cell0" , lRow) & "★" &'수수료											5
		grd1.GetCellData( "bd_cell4" , lRow) & "★" & '상대계좌										6
		rmtName & "★" & '상대이름																	7
		grd1.GetCellData( "bd_cell1" , lRow) & "★" &'잔액											8
		cell2 & "★" & '처리자###																	9
		grd1.GetCellData( "bd_cell3" , lRow) &"★" & '거래번호											10
		
		Grid0.GetCellData( "bd_cell2" , lRow) &"★" & '내통장설명											11
		Grid0.GetCellData( "bd_cell9" , lRow) & "★" &'상대통장표기											12
		cell15  & "★" & '원거래번호									13
		cell16 &"★" & '처리내용###																	14
		
		'15-18
		acnt0.total & "★" & 																	'	15
		acnt0.sequence & "★" & 																'	16
		Grid0.GetCellData( "Date" , lRow) & "★" & 												'	17
		Grid0.GetCellData( "bd_cell1" , lRow) & "★" & 											'	18
		Grid0.GetCellData( "bd_cell21" , lRow)													'	19
		
		Form.OpenFramePopup( "mbbnk63030_p1" , szData , "")
	end if
	
End Sub

