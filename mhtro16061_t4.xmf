'============================================================================
Sub Form_OnFormInit()
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	Call btnSearch_OnClick()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then	
		btnSearch_OnClick()
	'20160502 LKM START
	elseif sEventName = "ChangeAcnt" Then
		
		grd0.rowcount = 0	'기존내역 Clear
			
		If Check_Accout() = False Then
			Exit Sub
		End If
		
		btnSearch_OnClick()
	'20160502 LKM END
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtro_oder_240r" Then
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ACNO" 		, 0 , Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ASNO" 		, 0 , Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ACNT_PWD" 	, 0 , Form.GetTopCtlProp("edtPwd", "caption"))	' 계좌비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ACNT_PWD" 	, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))	' 계좌비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "RSEV_STA_DATE"	, 0 , cld0.caption)		' 예약시작일자
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "RSEV_FIN_DATE"	, 0 , cld0.caption)		' 예약종료일자
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"	, 0 , "00")	' 해외시장구분코드
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtro_oder_240r" Then
		For i = 0 To grd0.rowcount -1 
			szMkCd	 = grd0.GetCellData("bd_cell17", i)
			szType  	 = grd0.GetCellData("bd_cell8", i)
			szOdrStat = grd0.GetCellData("bd_cell18", i)
'			szDecimal = grd0.GetCellData("bd_cell7", i)
			rSevType  = grd0.GetCellData( "bd_cell0"	, i)	'주문예약구분코드     - 2019.10.14
			hOurType  = grd0.GetCellData( "bd_cell9", i)	'주문예약시간구분코드 - 2019.10.14

'			szOdrPrc = grd0.GetCellData("bd_cell15", i)
'			szOdrPrc2 = Set_Unit(CDbl(szOdrPrc), szDecimal)
'			grd0.SetCellData("bd_cell15", i, szOdrPrc2)

			
			'20201124 LES START 해외주식 시장가매도
			szOrdType = grd0.GetCellData("bd_cell22", i)
			
			Select Case szOrdType
				Case "1"
					grd0.SetCellData("bd_cell12", i, "지정가")
				Case "2"
					grd0.SetCellData("bd_cell12", i, "시장가")
				Case "4"
					grd0.SetCellData("bd_cell12", i, "LOO")
				Case "5"
					grd0.SetCellData("bd_cell12", i, "LOC")
				Case "6"
					grd0.SetCellData("bd_cell12", i, "MOO")
				Case "7"
					grd0.SetCellData("bd_cell12", i, "MOC")
				Case "8"
					grd0.SetCellData("bd_cell12", i, "Limit VWAP")
				Case "9"
					grd0.SetCellData("bd_cell12", i, "Limit TWAP")
				Case "A"
					grd0.SetCellData("bd_cell12", i, "VWAP")
				Case "B"
					grd0.SetCellData("bd_cell12", i, "TWAP")
			End Select
			
			'20201124 LES END


			'주문예약구분코드 - 2019.10.14
			Select Case rSevType
				Case "1"
					grd0.SetCellData( "bd_cell0", i, "일반예약")
				Case "2" 
					grd0.SetCellData( "bd_cell0", i, "기간잔량")
				Case "3" 
					grd0.SetCellData( "bd_cell0", i, "기간예약")
				Case "4" 
					grd0.SetCellData( "bd_cell0", i, "특정일주문")
			End Select
			
			'주문예약시간구분코드 - 2019.10.14
			Select Case hOurType
				Case "0"
					grd0.SetCellData( "bd_cell9", i, "장개시")
				Case "1" 
					grd0.SetCellData( "bd_cell9", i, "장마감10분전")
				Case "2" 
					grd0.SetCellData( "bd_cell9", i, "장마감30분전")
				
				'20200911 LES START 예약시간 추가
				Case "3" 
					grd0.SetCellData( "bd_cell9", i, "장개시30분후")
				'20200911 LES END
				
			End Select


			'매매구분
			Select Case szType
				Case "1"	
					grd0.SetCellFgColor( "bd_cell2", i, "2" )
					
					'20201021 LES START 해외주식 매도상환
					szGubun = grd0.GetCellData("bd_cell19", i)
					if szGubun == "0251" then
						grd0.SetCellData( "bd_cell2", i, "예탁담보매도")
					else
						grd0.SetCellData( "bd_cell2", i, "매도")
					end if
					'20201021 LES END
					
					
				Case "2"	
					grd0.SetCellFgColor( "bd_cell2", i, "1" )
					grd0.SetCellData( "bd_cell2", i, "매수")
			End Select
			
			' 시장구분
			if szMkCd == "01" then
				grd0.SetCellData("bd_cell4", i, "미국")
			elseif szMkCd == "02" then
				grd0.SetCellData("bd_cell4", i, "홍콩")
			elseif szMkCd == "03" then
				grd0.SetCellData("bd_cell4", i, "상해")
			elseif szMkCd == "04" then
				grd0.SetCellData("bd_cell4", i, "심천")
			elseif szMkCd == "05" then
				grd0.SetCellData("bd_cell4", i, "일본")
			end if
			
			
			' 주문상태
			if szOdrStat == "0" then
				grd0.SetCellData("bd_cell6", i, "주문대기")
			elseif szOdrStat == "1" then
				grd0.SetCellData("bd_cell6", i, "정상")
			elseif szOdrStat == "2" then
				grd0.SetCellData("bd_cell6", i, "거부")
			end if
		Next
	End If
End Sub

'============================================================================
Sub btnSearch_OnClick()
	
	If Check_Accout() = False Then
		Exit Sub
	End If
		
	DATAMANAGER.RequestTranData( "obtro_oder_240r" )
	
End Sub


'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

