'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap상품 목록 조회
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2023.05.08 : 고승연 : v0002 : [T2305030027] obwat_csad_021r IO 수정, 고객번호,조회구분 입력 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sAcnt
Dim g_sCode
Dim g_sWaPrcd

Dim g_szCode
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBack.setMaintainingRatio("1")
'	imgSearchBg.setMaintainingRatio("1")
	imgSearchIcon.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	edtSearch.SetOnOffImage("alpha", "alpha")
	
	Dim sData
	sData = Form.GetOpenLinkData()
	
	'Form.MsgBox(sData)
	
	if sData <> null and sData <> "" then
		Dim tData
		tData = Split(sData, "|")
		
		g_sAcnt = tData(0)
		g_sCode = tData(1)
		g_sWaPrcd = tData(2)
	end if
End Sub

' 뒤로가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.OpenScreen("57020", "")
End Sub

'============================================================================
Sub imgSearch_OnClick()
	edtSearch.SetShowKeypad(true)
End Sub

'============================================================================
Sub edtSearch_OnEditChar(CharCode)
	lblNoData.visible = false
	grdData.SetClear()
	DATAMANAGER.RequestTranData("obwat_oiad_021r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_oiad_021r" then
		DATAMANAGER.SetDataValue(0, "obwat_oiad_021r", "InBlock1", "NRML_YN", 0 , "Y") '정상여부
		DATAMANAGER.SetDataValue(0, "obwat_oiad_021r", "InBlock1", "DPCD", 0 , "") '부서코드
		DATAMANAGER.SetDataValue(0, "obwat_oiad_021r", "InBlock1", "FLNM", 0, edtSearch.caption) '성명
		
	elseif szTranID == "obwat_csad_021r" then
		'v0002
		DATAMANAGER.SetDataValue(0, "obwat_csad_021r", "InBlock1", "IQRY_CLS_CODE", 0 , "2")
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_oiad_021r" then
		Dim nCount
		nCount = tonumber(grdData.rowcount)
		
		lblNoData.visible = false
		
		if nCount == 0 then
			lblNoData.visible = true
		end if
	
	elseif szTranID == "obwat_csad_021r" then
		Dim nCount, bFlag
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_csad_021r", "OutBlock1" )
		bFlag = false
		
		if tonumber(nCount) > 0 then
			if len(g_sCode) == 1 then
				for i = 0 to nCount-1
					Dim sGrpCode
					sGrpCode = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock1", "DIV_GRP_CODE" , i )
					
					if sGrpCode == g_sCode then
						bFlag = true
						exit for
					end if
				next
			end if
		end if
		
		if bFlag then
			Dim sEmpno
			sEmpno = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "InBlock1", "MANG_EMPNO" , 0 )
			Form.OpenPopup("mbwat61020_p4", "1|"..sEmpno.."|"..g_sWaPrcd , "")
		else
			Form.MsgBox("알림", "해당 운용역은 선택하신 상품을 운용하지 않습니다. 운용역을 다시 확인해주세요.", "", 8, "확인", "")
		end if
		
	elseif szTranID == "obwat_oiad_023r" then
		Dim sAplyYN
		sAplyYN = DATAMANAGER.GetDataValue( 0, "obwat_oiad_023r", "OutBlock1", "APLY_YN" , 0 )
		
		if sAplyYN == "Y" then '협의완료
			Dim sCode, sCsno
			sCode = DATAMANAGER.GetDataValue( 0, "obwat_oiad_023r", "OutBlock1", "WA_PRCD" , 0 )
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , g_sAcnt )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , sCode )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_003r" )
		else
			Form.OpenPopup("mbwat61020_p5", "", "")
		end if
		
	elseif szTranID == "obwat_onln_003r" then
		Dim sJoinYN
		sJoinYN = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "JOIN_ABLE_YN" , 0 )
		
		if sJoinYN == "Y" then
			g_szCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 )
			
'			Form.OpenPopup("mbwat61022" , sCode , "") '계약(가입)
			
			Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		else
			Dim sResultCode, sMsg
			sResultCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_RSLT_CODE" , 0 )
			sMsg = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_PRHB_DTL_CNTT" , 0 )
			
			Form.OpenPopup("mbwat61020_p9", sResultCode.."|"..sMsg, "")
		end if
		
	end if
End Sub

' 운용역 선택
'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	Dim sEmpno
	sEmpno = grdData.GetCellData("empno", lRow)
	
	DATAMANAGER.SetDataValue(0, "obwat_csad_021r", "InBlock1", "MANG_EMPNO", 0 , sEmpno)
	DATAMANAGER.RequestTranData( "obwat_csad_021r" )
End Sub

'============================================================================
Sub grdData_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obwat_oiad_021r" ) then
		DATAMANAGER.RequestNextData( "obwat_oiad_021r" )
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "SEARCH_EMP_PRD" then
		if Len(g_sWaPrcd) > 1 then
			DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "WA_PRCD" , 0 , g_sWaPrcd )
		else
			DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "WA_PRCD" , 0 , g_sCode )
		end if
		DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "EMPNO" , 0 , sRet )
		
		Dim sLOGIN_TYPE
		sLOGIN_TYPE = Form.GetSharedData( "&LOGIN_TYPE", 0 )
	
		If sLOGIN_TYPE = "1" Then
			Form.MsgBox("알림", "로그인이 필요한 메뉴입니다.\n로그인하시겠습니까?", "GOTOLOGIN", 1)
			Exit Sub
		else
			DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "ACNO" , 0 , g_sAcnt )
			DATAMANAGER.RequestTranData( "obwat_oiad_023r" )
		end if
		
	elseif sKeyName == "Login_Type" then
		if sRet == "3" then
			Form.PostLinkData("ReloadAccount", "mbwat61020_p3")
		end if
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			Form.OpenPopup("mbwat61022" , g_szCode , "") '계약(가입)
		elseif sRet == "CANCEL_mbonl81010_p20" then
		
		end if
	end if
End Sub

Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "GOTOLOGIN" Then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021", "", "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "mbwat61020_p3" then
		g_sAcnt = sValue
		DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "ACNO" , 0 , g_sAcnt )
		DATAMANAGER.RequestTranData( "obwat_oiad_023r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

