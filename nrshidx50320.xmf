Dim gOsType

Dim gSearchText
gSearchText = ""

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	'---------------------------------------------------
	' 이미지 설정
	'---------------------------------------------------
	imgBack.setMaintainingRatio("2")
	imgSearch.setMaintainingRatio("1")
	grdHistory.setMaintainingRatio("bd_delete", 0, "1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'---------------------------------------------------
	' (iOS전용) 에디트 Focus/UnFocus 이미지 세팅
	'---------------------------------------------------
	edtSearch.SetOnOffImage("alpha", "alpha")
	
	'---------------------------------------------------
	'최근 조회 검색어 체크
	'---------------------------------------------------
	f_SetHistoryList()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'ETF 매거진 컨텐츠 목록 조회
	if szTranID == "ooopc_rprt_002r" then
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_GRP_ID" , 0 , "bascGrp" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_ID" , 0 , "EtfMgz" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_DIV_CODE" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_WRTR_NAME" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_TITL_NAME" , 0 , edtSearch.caption )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" , 0 , "000000" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" , 0 , "999999" )
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'----------------------------------
	'ETF 매거진 컨텐츠 목록 조회
	'----------------------------------
	if szTranID == "ooopc_rprt_002r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		if nCnt == 0 then
			
			lblTitleHistory.visible = false
			lblDelete.visible = false
			grdHistory.visible = false
			lblNoData.visible = true
			lblNoData.caption = "조회된 데이터가 없어요."
			
			pannList.visible = false
			exit sub
			
		else
			
			lblTitleHistory.visible = false
			lblDelete.visible = false
			grdHistory.visible = false
			lblNoData.visible = false
			
			pannList.visible = true
			
			Dim nGrdCnt
			nGrdCnt = CInt(pannList.rowcount)
			
			for i = 0 to nCnt - 1
				
				pannList.AddRow()
				Dim sTitle, sThumPath, sContentsUrl
				sTitle 	= DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TITL_NAME" , i)
				sThumPath = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_SPLM_ITEM_VAL13" , i)
				sContentsUrl = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TURN_NO" , i)
				
				if sContentsUrl <> "" then
					sContentsUrl = GetTotalUrlPath("contents",sContentsUrl)
				else
					sContentsUrl = ""
				end if
				
				if sThumPath <> "" then
					sThumPath = GetTotalUrlPath("image",sThumPath)
				else
					sThumPath = ""
				end if
				
				pannList.setPropCardCell("caption", "lblMgzTitle", nGrdCnt+i, sTitle)
				pannList.setPropCardCell("caption", "lblUrl", nGrdCnt+i, sContentsUrl)
				pannList.setPropCardCell("imgurl", "imgThumb", nGrdCnt+i, sThumPath)
			next
			
		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	Dim szMsgText, szSubText
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
	
End Sub

'============================================================================
Function f_SetHistoryList()

	Dim szRecent
	szRecent = Form.manageTotalSearch("ETF_MAG_SEARCH", "get", "")
	
	'------------------------------------------
	' 최근검색어 있음
	'------------------------------------------
	if szRecent <> "" and szRecent <> null then
		
		lblTitleHistory.visible = true
		lblDelete.visible = true
		grdHistory.visible = true
		lblNoData.visible = false
		
		Dim tSplit
		tSplit = Split(szRecent, "^")
		if #tSplit > 0 then
			
			'------------------------------------------
			'검색기록은 최대 10개까지 표현
			'------------------------------------------
			if #tSplit >= 10 then
				grdHistory.rowcount = 10
				for i = 0 to 9
					grdHistory.SetCellData("bd_title", i, tSplit(i))
				next
			else
				grdHistory.rowcount = #tSplit
				for i = 0 to #tSplit - 1
					grdHistory.SetCellData("bd_title", i, tSplit(i))
				next
			end if
			
		end if
	
	'------------------------------------------
	'최근 검색어 없음
	'------------------------------------------
	else
		lblTitleHistory.visible = false
		lblDelete.visible = false
		grdHistory.visible = false
		lblNoData.visible = true
		lblNoData.caption = "최근 검색어가 없어요."
	end if
	
End Function

'============================================================================
' 썸네일 및 본문 URL 가져오기
'============================================================================
Function GetTotalUrlPath(sGubun,sPath)

	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	'-------------------------
	' 본문 링크주소
	'-------------------------
	if sGubun = "contents" then
		
		if CInt(szMode) == 0 then
			szUrl = "https://home.imeritz.com/bbs/mwCtn1.do?bbsId=EtfMgz&bbsCnttTurnNo="..Cint(sPath)		'운영계 주소
		elseif CInt(szMode) == 1 then
			szUrl = "https://testhome.imeritz.com/bbs/mwCtn1.do?bbsId=EtfMgz&bbsCnttTurnNo="..Cint(sPath)	'테스트계주소
		end if
		
	'-------------------------
	' 썸네일 링크주소
	'-------------------------
	else
		if CInt(szMode) == 0 then
			szUrl = "https://home.imeritz.com"..sPath		'운영계 주소
		elseif CInt(szMode) == 1 then
			szUrl = "https://testhome.imeritz.com"..sPath		'테스트계주소
		end if
	end if
	
	return szUrl
	
End Function

'============================================================================
' 최근검색어 선택 및 편집
'============================================================================
Sub grdHistory_OnClickUp(lRow, szCellID)
	
	if szCellID == "bd_delete" then
		Dim szKeyword
		szKeyword = grdHistory.GetCellData("bd_title", lRow)
		Form.manageTotalSearch("ETF_MAG_SEARCH", "delete", szKeyword)
		f_SetHistoryList()
		
	elseif szCellID == "bd_title" then
		Dim szTitle
		szTitle = grdHistory.GetCellData("bd_title", lRow)
		edtSearch.caption = szTitle
		
		'판넬행 초기화 이후 서비스 조회
		pannList.rowcount = 0
		DATAMANAGER.RequestTranData( "ooopc_rprt_002r" )
		
	end if
	
End Sub

'============================================================================
' 컨텐츠 클릭 > 본문으로 이동
'============================================================================
Sub pannList_OnClick(nIndex, sCellID)
	
	Dim szUrl
	szUrl = pannList.getPropCardCell("caption", "lblUrl", nIndex)
	
	if szUrl <> "" and szUrl <> null then
		Form.OpenPopup("nrshidx50310", szUrl, "")
	end if
	
End Sub

'============================================================================
Sub edtSearch_OnEditChar(CharCode)

	if CharCode <> "" then
		
		if gOsType == "1" then
			Form.SetTimerEvent2(1, 0, 0.5)
			Form.SetTimerEvent2(1, 1, 0.5)
		else
			Form.SetTimerEvent3(1, 0, 0.5)
			Form.SetTimerEvent3(1, 1, 0.5)
		end if
	
	
		'판넬행 초기화 이후 서비스 조회
		'pannList.rowcount = 0
		'DATAMANAGER.RequestTranData( "ooopc_rprt_002r" )
	
	else
	
		lblTitleHistory.visible = true
		lblDelete.visible = true
		grdHistory.visible = true
		lblNoData.visible = false
		pannList.visible = false
		
		'검색어 입력창이 빈값일 경우 최근검색어 리스트 업데이트
		f_SetHistoryList()
	
	end if
	
End Sub
'============================================================================
Sub edtSearch_OnEditComplete()
	
	if edtSearch.caption <> "" and edtSearch.caption <> null then
		
		'최근검색어 추가
		Form.manageTotalSearch("ETF_MAG_SEARCH", "set", edtSearch.caption)
		
		sCurSearchText = edtSearch.caption
		
		if sCurSearchText <> gSearchText then
			
			if gOsType == "1" then
				Form.SetTimerEvent2(1, 0, 0.5)
			else
				Form.SetTimerEvent3(1, 0, 0.5)
			end if
			
			'판넬행 초기화 이후 서비스 조회
			pannList.rowcount = 0
			DATAMANAGER.RequestTranData( "ooopc_rprt_002r" )
			
		end if
		
		
	else
		
		lblTitleHistory.visible = true
		lblDelete.visible = true
		grdHistory.visible = true
		lblNoData.visible = false
		pannList.visible = false
		
		'검색어 입력창이 빈값일 경우 최근검색어 리스트 업데이트
		f_SetHistoryList()
		
	end if
	
End Sub

'============================================================================
' 최근검색어 전체삭제
'============================================================================
Sub lblDelete_OnClick()
	
	Form.manageTotalSearch("ETF_MAG_SEARCH", "clear", "")
	f_SetHistoryList()
	
End Sub

'============================================================================
' 뒤로가기 버튼
'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 검색어 조회 서비스 타이머
'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if sTimerID == 1 or sTimerID == "1" then
	
		if gOsType == "1" then
			Form.SetTimerEvent2(1, 0, 0.5)
		else
			Form.SetTimerEvent3(1, 0, 0.5)
		end if
		
		sCurSearchText = edtSearch.caption
		
		if sCurSearchText <> gSearchText and sCurSearchText <> "" then
		
			pannList.rowcount = 0
			DATAMANAGER.RequestTranData( "ooopc_rprt_002r" )
			
			gSearchText = sCurSearchText
			
		end if
	
	end if
	
End Sub


