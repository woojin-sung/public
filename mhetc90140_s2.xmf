	<SCRIPT_INFO _len="3812" _ulen="3504" >
'Dim g_Ostype
Dim g_trCSNO
Dim g_trCSNM
Dim g_apiCSNO
'============================================================================
Sub Button0_OnClick()
	Form.triggerEvent( "#", "NextStep", "1" )
End Sub

'============================================================================
Sub Form_OnFormInit()
	'항목가이드 Default 설정 (267.검정색)
	EdtID.SetApplyLabel   ("사용자 ID"         , 0, 267, "left", True)  'True.필수입력 / False.선택입력
	EdtIDPwd.SetApplyLabel("ID 비밀번호" , 0, 267, "left", True)
	Button0.enable = False
	g_apiCSNO = Form.GetSharedData("&INNER_MYDATA_CSNO" , false)
End Sub

'============================================================================
Sub EdtIDPwd_OnEditComplete()
	DATAMANAGER.RequestTranData("obcsb_efif_162r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_efif_162r" then
		sucs_yn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SUCS_YN", 0)
		if sucs_yn = "Y" THEN
			DATAMANAGER.SetDataValue( 0 , "obcsb_info_004r", "InBlock1", "ELFN_ID" , 0 , EdtID.Caption)
			DATAMANAGER.RequestTranData("obcsb_info_004r")
		else
			Button0.enable = False
			szCode = DATAMANAGER.GetDataMsgCode( "obcsb_efif_162r" ) 
			szErr = DATAMANAGER.GetDataMsgText( "obcsb_efif_162r" )
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_efif_162r" )
			if szCode == "2413" then '5회이상 오류시
				Form.ShowAlert("알림", "ID비밀번호 5회 오류입니다.\n\nID비밀번호를 5회 연속 잘못 입력하여 접속이 불가능하오니\n내방하시거나 앱(메리츠스마트) 또는 홈페이지(ID 비밀번호 재설정)에서 \n재설정하시기 바랍니다.")
			else	
				Form.MsgBox("알림", "[TR]"& szErr& " " & szSubErr, "", 6)
			end if
		end if
	elseif szTranID = "obcsb_info_004r" then
		g_trCSNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO", 0)
		g_trCSNM = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNM", 0) ''20211028 HSZ 쉐어드 변수 저장
		CHECK_CSNO()
	end if
End Sub
'============================================================================
Function CHECK_CSNO()
	if g_trCSNO  = g_apiCSNO then
		Form.SetSharedData("&MYDATA_MAP_CSNO", g_trCSNO)
		Button0.enable = True 
	else
		Form.ShowAlert("알림", "고객정보가 일치하지 않습니다.")
	end if
End Function 
'============================================================================
'Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
'	Form.MsgBox("알림", "[TR]"&szErrMsg&" "&szSubErr, "", 6)
'End Sub

'============================================================================
Sub EdtID_OnEditComplete()
	If EdtIDPwd.caption == "" Or EdtIDPwd.caption == null Then
		EdtIDPwd.SetShowKeypad(True)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	sUser_Id = Form.getsharedData("&USER_ID", FALSE)
	If CInt(sLOGIN_TYPE) > 1 and sUser_Id <> "" then '로그인상태
	else 
		'처리중인 휴대폰정보로 USerID설정
		DATAMANAGER.SetUserID("meritz")
	end if
	DATAMANAGER.SetDataValue( 0 , "obcsb_efif_162r", "InBlock1", "ELFN_ID" , 0 , EdtID.Caption)
	DATAMANAGER.SetDataValue( 0 , "obcsb_efif_162r", "InBlock1", "CONN_PWD" , 0 , EdtIDPwd.Caption)
End Sub
'============================================================================
Sub Form_OnFormClose()
	Button0.enable = False 
	'20211028 HSZ 쉐어드 변수 저장
	Form.SetSharedData("MAP_MYDATA_CUSNO" , g_trCSNO)
	Form.SetSharedData("MAP_MYDATA_CUSNM" , g_trCSNM)
End Sub 

