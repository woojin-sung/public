	<SCRIPT_INFO _len="10673" _ulen="10095" >
'===========================================================================
' 01. 업무구분 : 해외주식_호가
' 02. 화면 : 
' 03. 화면설명 : 
' 04. 작성자 : 이재원
' 05. 작성일 : 2017.10.10
' 06. 수정이력 : 
'===========================================================================
'[[ 전역변수 ]]
Dim g_sCode
Dim g_nMaxCount
'============================================================================
Sub Form_OnFormInit()
	g_nMaxCount = 300
	Container0.setScrollBarVisible("0") '숨김처리
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		g_sCode = sParam
		
		Form.triggerEvent("LinkForm0", "13000_" & sEventName, sParam) '20171213 HAMWG : 해외주식 종목코드 전달

		Container0.scroll_pos = "vcenter"

		DATAMANAGER.CancelRealData( "ohhts_exst_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_exst_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_exst_cntd" ) '20221213_01 KBC 해외주식주간거래
		
		Container0.HogaTable0.SetCellClear()
		
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		DATAMANAGER.RequestTranData( "ohhts_6000_002r" )
		DATAMANAGER.RequestTranData( "ohhts_6000_003r" )
	elseif (sEventName == "13000_CONTRACT") then
		Form.TriggerEvent( "#", "13000_CONTRACT", sParam )
	elseif sEventName == "ChangeAcnt" then
		Form.triggerEvent("LinkForm0", "13000_" & sEventName, "") '20171213 HAMWG : 계좌변경
		
		sMiche = Form.GetSharedData("MICHE", 1 )
		if sMiche <> "" and sMiche <> null	then
			Form.triggerEvent("LinkForm0", "MICHE", sMiche)
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sCodeData, szDelay

	sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
	sCodeData = Split( g_sCode, "@" )
	
	szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
	
	if szTranID == "ohhts_6000_001r" then
		
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
		
	elseif szTranID == "ohhts_6000_002r" then

		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연

	elseif szTranID == "ohhts_6000_003r" then

		DATAMANAGER.SetDataValue( 0, "ohhts_6000_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_003r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_003r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_003r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_001r" then
		Dim nCLPrice, nPoint
		nCLPrice = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_PRDY_CLPR" , 0))
		nPoint = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_DCPN_CNT" , 0))
		
		Container1.tblPrice.SetCellString(3, 1, Replace( FormatNumber(nCLPrice, nPoint) , "," , "" ) )
		
		Table_Color_Setting()
		
	elseif szTranID == "ohhts_6000_002r" then
		Container0.scroll_pos = "vcenter"

		DATAMANAGER.RequestRealData( "ohhts_exst_aspr" )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntd" ) '20221213_01 KBC 해외주식주간거래
		
	elseif szTranID == "ohhts_6000_003r" then
		if _tonumber(Container1.grdCNTG.rowcount) > g_nMaxCount then
			Container1.grdCNTG.rowcount = g_nMaxCount
		end if
	end if
	
	if szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_002r" then
		Return_AutoPrice()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID == "ohhts_exst_aspr" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	elseif szTranID == "ohhts_exst_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	elseif szTranID == "ohhts_exst_cntd" then '20221213_01 KBC 해외주식주간거래
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
'	Table_Color_Setting()
end Sub

'============================================================================
Sub Container0_HogaTable0_OnClick(lRow, lCol)
	if Container0.HogaTable0.GetCellString( lRow, 0 ) <> null and Container0.HogaTable0.GetCellString( lRow, 0 ) <> ""	then
		Dim sHoga
		sHoga = Container0.HogaTable0.GetCellString( lRow, 0 )
		Form.triggerEvent("LinkForm0", "HOGA", sHoga)
	end if
End Sub

'============================================================================
' 시가, 고가, 저가 색상세팅
'============================================================================
Function	Table_Color_Setting()
	Dim sOpen
	Dim sHigh
	Dim sLow
	Dim sLast

	sOpen = 0	' 시가
	sHigh = 0	' 고가
	sLow  = 0	' 저가
	sLast = 0	' 전일종가
	
	sOpen = CDbl( Container1.tblPrice.GetCellString( 0, 1 ) )	' 시가
	sHigh = CDbl( Container1.tblPrice.GetCellString( 1, 1 ) )	' 고가
	sLow  = CDbl( Container1.tblPrice.GetCellString( 2, 1 ) )	' 저가
	sLast  = CDbl( Container1.tblPrice.GetCellString( 3, 1 ) )	' 전일종가
	
	Dim sColor
	sColor = "4"
		
	if sOpen > sLast then
		sColor = "1"
	elseif sOpen < sLast then
		sColor = "2"
	elseif sOpen == sLast then
		sColor = "3"
	end if
	
	Container1.tblPrice.SetCellFgColor( 0, 1, sColor )
	
	if sHigh > sLast then
		sColor = "1"
	elseif sHigh < sLast then
		sColor = "2"
	elseif sHigh == sLast then
		sColor = "3"
	end if
	
	Container1.tblPrice.SetCellFgColor( 1, 1, sColor )

	
	if sLow > sLast then
		sColor = "1"
	elseif sLow < sLast then
		sColor = "2"
	elseif sLow == sLast then
		sColor = "3"
	end if
	
	Container1.tblPrice.SetCellFgColor( 2, 1, sColor )
	
	Container1.tblPrice.SetCellFgColor( 3, 1, "4" )
	
end Function

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub imgAlpha_OnClick()
	if Container1.visible == true or Container1.visible == "1" then
		Container1.visible = false
		imgAlpha.height = 27
	elseif Container1.visible == false or Container1.visible == "0" then
		Container1.visible = true
		imgAlpha.height = 120
	end if
End Sub

'============================================================================
' Return_AutoPrice : 가격 자동연동(화면실행 or 탭변경시)
'============================================================================
Function Return_AutoPrice()
	Dim szTab, szAuto

	szAuto = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC")
	
	Select Case Trim(szAuto)
		Case "1"											' 매도10호가
			szPrc = Container0.HogaTable0.GetCellString( 0, 0)
		Case "2"											' 매도9호가
			szPrc = Container0.HogaTable0.GetCellString( 1, 0)
		Case "3"											' 매도8호가
			szPrc = Container0.HogaTable0.GetCellString( 2, 0)
		Case "4"											' 매도7호가
			szPrc = Container0.HogaTable0.GetCellString( 3, 0)
		Case "5"											' 매도6호가
			szPrc = Container0.HogaTable0.GetCellString( 4, 0)
		Case "6"											' 매도5호가
			szPrc = Container0.HogaTable0.GetCellString( 5, 0)
		Case "7"											' 매도4호가
			szPrc = Container0.HogaTable0.GetCellString( 6, 0)
		Case "8"											' 매도3호가
			szPrc = Container0.HogaTable0.GetCellString( 7, 0)
		Case "9"											' 매도2호가
			szPrc = Container0.HogaTable0.GetCellString( 8, 0)
		Case "10"										' 매도1호가
			szPrc = Container0.HogaTable0.GetCellString( 9, 0)
		Case "11"										' 현재가
			szPrc = lblHyun.caption					
		Case "12"										' 매수1호가
			szPrc = Container0.HogaTable0.GetCellString(10, 0)
		Case "13"										' 매수2호가
			szPrc = Container0.HogaTable0.GetCellString(11, 0)
		Case "14"										' 매수3호가
			szPrc = Container0.HogaTable0.GetCellString(12, 0)
		Case "15"										' 매수4호가
			szPrc = Container0.HogaTable0.GetCellString(13, 0)
		Case "16"										' 매수5호가
			szPrc = Container0.HogaTable0.GetCellString(14, 0)
		Case "17"										' 매수6호가
			szPrc = Container0.HogaTable0.GetCellString(15, 0)
		Case "18"										' 매수7호가
			szPrc = Container0.HogaTable0.GetCellString(16, 0)
		Case "19"										' 매수8호가
			szPrc = Container0.HogaTable0.GetCellString(17, 0)
		Case "20"										' 매수9호가
			szPrc = Container0.HogaTable0.GetCellString(18, 0)
		Case "21"										' 매수10호가
			szPrc = Container0.HogaTable0.GetCellString(19, 0)
		Case "22"										' 상한가
			szPrc = lblHigh.caption
		Case "23"										' 하한가
			szPrc = lblLow.caption
		Case Else										' 미적용 및 기타에러
			szPrc = ""
	End Select		
	
	Form.triggerEvent("LinkForm0", "AUTO_PRICE", szPrc)
End Function


'============================================================================
Sub Container1_grdCNTG_OnScrollEnd()
	if _tonumber(Container1.grdCNTG.rowcount) < g_nMaxCount then
		Dim bNext
		bNext = DATAMANAGER.IsMoreNextData( "ohhts_6000_003r" )
		if bNext == "1" or bNext == true then
			DATAMANAGER.RequestNextData( "ohhts_6000_003r" )
		end if
	end if
End Sub

