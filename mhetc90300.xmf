	<SCRIPT_INFO _len="5074" _ulen="4642" >
'20240314_01 KBC 클라우드공동인증서 도입 (신규)
'클라우드인증서 인증서 리스트 조회화면


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sGubun '인증서업무구분
Dim g_OpenType

'============================================================================
'20160428 NOHES : update의 경우 이 맵 사용 안함. 주석처리 여부 추후 확인 필요.
'============================================================================
Sub ContainerCloudCert_Grid0_OnClickUp(lRow, szCellID)
	if g_sGubun == "update" then '갱신인경우 "SignKorea" 인증서가 아닌경우 안내팝업
		Dim sCertSort 
		sCertSort = ContainerCloudCert.Grid0.GetCellData( "bd_cert", lRow )
		
		if InStr(Trim(sCertSort), "SignKorea") > 0 then
			Dim sDN, sIndex
			sDN = ContainerCloudCert.Grid0.GetCellData( "bd_dn", lRow )
			sIndex = ContainerCloudCert.Grid0.GetCellData( "bd_index", lRow )

			Form.SetSharedData("CLOUDCERT_DN" , sDN)
			Form.SetSharedData("CLOUDCERT_INDEX" , sIndex)
			Form.triggerEvent( "#", "NextStep", "1" )
		else
			Form.MsgBox( "알림", sCertSort.."인증서는 해당 발급기관에서 갱신하시기 바랍니다.", "", 6 )
		end if
	else	
		Dim sDN, sIndex
		sDN = ContainerCloudCert.Grid0.GetCellData( "bd_dn", lRow )
		sIndex = ContainerCloudCert.Grid0.GetCellData( "bd_index", lRow )

		Form.SetSharedData("CLOUDCERT_DN" , sDN)
		Form.SetSharedData("CLOUDCERT_INDEX" , sIndex)
		Form.triggerEvent( "#", "NextStep", "1" )
	end if
	
	'로그인 화면에서 팝업띄운 경우
	if g_OpenType == "CloudLogin_Open" then
		Form.SendReturnToParent("CloudLogin_Close","")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_OpenType = Form.GetOpenLinkData( )

	if g_OpenType == "CloudLogin_Open" then
		Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90300") '응답이벤트에서 procCloudCertList 실행
	end if
End Sub

'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox(sCommand, sErrorMsg, "", 0)
		exit sub
	end if		

	'-------------------------------------------------------------
	'요청_응답처리
	'-------------------------------------------------------------
	if sCommand = "CLOUD_REQ_CERT_LIST_90300" then		
		procCloudCertList(sResult)
	end if
End Sub

'============================================================================
Sub procCloudCertList(sParam)
	ContainerCloudCert.left = 0
	ContainerNotExist.left = 0
	
	Dim sCertCnt, sCalDate 
	Dim szItem, bFind

	bFind = false
	szItem = Split(sParam,"★")
	
	if #szItem > 3 then
		sCertCnt	= szItem(2) 	'인증서 개수
		
		sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
		sCalDate	= Left(sCalDate, 8)
					
		ContainerCloudCert.Grid0.SetClear()
		ContainerCloudCert.Grid0.rowcount = 1
	
		if sCertCnt ~= null and sCertCnt ~= "" then
			if CInt(sCertCnt) > 0 then		
			
				Dim sTemp, sDate
				ContainerCloudCert.Grid0.rowcount =  CInt(sCertCnt)
	
				for i = 0 to CInt(sCertCnt)-1
					sTemp = Split(szItem(i+3), "♥")

					if #sTemp > 7 then
						'sTemp[ 0]	클라우드여부 
						'sTemp[ 1]	캐쉬여부
						'sTemp[ 2]	PIN잠김여부	
						'sTemp[ 3]	BIO여부
						'sTemp[ 4]	이름
						'sTemp[ 5]	DN
						'sTemp[ 6]	종류(범용/개인)
						'sTemp[ 7]	만료일
						'sTemp[ 8]	시작일
						'sTemp[ 9]	클라우드인증서ID	
						'sTemp[10]	시리얼
						
						ContainerCloudCert.Grid0.SetCellData("bd_name"	, i, sTemp[4])
						ContainerCloudCert.Grid0.SetCellData("bd_cert"	, i, sTemp[6])
						ContainerCloudCert.Grid0.SetCellData("bd_date"	, i, sTemp[8])
						ContainerCloudCert.Grid0.SetCellData("bd_Edate"	, i, sTemp[7])
						ContainerCloudCert.Grid0.SetCellData("bd_dn"		, i, sTemp[5])
						ContainerCloudCert.Grid0.SetCellData("bd_index"	, i, i)
						
						sDate = sTemp[7]
						
						if tonumber(sDate) > tonumber(sCalDate) then
							ContainerCloudCert.Grid0.SetCellData( "bd_icon", i, "login_sub_11.png" )
						else
							ContainerCloudCert.Grid0.SetCellData( "bd_icon", i, "login_sub_12.png" )
						end if							
					end if
				next			
			end if
		end if		
	end if		

End Sub

'============================================================================
'인증서 발급하기/가져오기
Sub ContainerNotExist_btnCertPublish_OnClick()
	'인증서 선택 팝업 닫고 인증센터로 이동
	Form.SendReturnToParent("Login_CloudCert_Select", "0")
	Form.CloseForm()
End Sub

'============================================================================
Sub Image5_OnClick()
	Form.CloseForm()
End Sub
	</SCRIPT_INFO>
</ROOT>