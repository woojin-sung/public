			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_INTG_CSNM" 	, 0 , Container0.Container1.Edit4.caption	)	'UI개인실제소유자실명확인번호
'			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_PBO_RCNO" 	, 0 , Container0.Container1.Edit5.caption	)	'UI개인실제소유자실명확인번호 'v002
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_PBO_RCNO_PIP" 	, 0 , Container0.Container1.Edit5.caption	)	'UI개인실제소유자실명확인번호 'v002
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_INTG_CSNM"	, 0 , Container0.Container1.Edit4.caption	)	'UI개인실제소유자통합고객명
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "WRTR_INTG_CSNM" 	, 0 , Container0.Container1.Edit4.caption	)	'작성자통합고객명
		end if

		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_NTNT_CTCD" 		, 0 , "410"						)	'개인실제소유자국적국가코드


		DATAMANAGER.RequestTranData("obcsb_srpi_102a")


	elseif szTranID == "obcmm_kedd_019a" then
