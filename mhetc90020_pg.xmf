Sub Form_OnFormInit()

	g_szNoticeType = "" 			'발송물 통보처 유형 코드
	g_szNoticeSerial = "" 			'발송물 통보처 일련번호
	g_szMailType = ""				'우편물 통보처 유형 코드
	g_szMailSerial= "" 			'우편물 통보처 일련번호
	g_szHtsYN = "N" 				'HTS불원등록 약정상태 변수
	g_szJangoYN = "N" 			'잔고통보처 약정 상태 변수
	g_szCSNM = "" 				'고객명
	g_szPostalIndex = 0 			'우편물 통보처 인덱스
	g_szTrInformIndex = 0 			'거래내역 통보처 인덱스
	g_szContClsCode = ""			'접촉구분코드
	g_szProsClsCode = ""			'처리구분코드
	g_szFundRmndRcmsClsCode = ""	'펀드잔고수신구분코드
	g_szCustClsCode = ""			'고객구분코드
	g_szContClsCode = "4"			'접촉구분코드
	g_szProsClsCode = "5"			'처리구분코드
	g_szCsno = ""					'고객번호

	Container0.Container1.top = 10000
	Container0.Container2.top = 600

	Container0.Container2.Combo4.currentindex = -1
	Container0.Container2.Combo5.currentindex = -1
	Container0.Container2.Combo4.caption = " "
	Container0.Container2.Combo5.caption = " "

	Container0.Container2.Table9.visible = False
	Container0.Container2.Table10.visible = false
	Container0.Container2.Edit1.visible = false
	Container0.Container2.Edit6.visible = false

	Container0.Combo0.currentindex = -1
	Container0.Combo1.currentindex = -1
	Container0.Combo2.currentindex = -1
	'V004 Container0.Combo3.currentindex = -1
	Container0.Combo6.currentindex = -1


	Container0.Combo0.caption = " "
	Container0.Combo1.caption = " "
	Container0.Combo2.caption = " "
	'V004 Container0.Combo3.caption = " "
	Container0.Combo6.caption = " "


	Container0.Table3.visible = False
	Container0.Edit2.visible = False
	Container0.Edit2.caption = ""

	g_sRetData = "cancel"
	Form.SetScreenName("은행개설계좌 ID등록")

	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")

	Container0.LabelOccu.visible = False

	Container0.Edit0.Caption=""

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if



	TR_Inquiry("obcsb_acad_002r")


End Sub



'============================================================================
' TR_Inquiry() - tr명에 따라
'============================================================================
Function TR_Inquiry(szTranID)

	if szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "CONT_CLS_CODE" , 0, "4")	'접촉구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "PROS_CLS_CODE" , 0 , "5")	'처리구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , g_szList(10) )	'계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , g_szList(11) )	'비밀번호
		DATAMANAGER.RequestTranData("obcsb_acad_002r")

	elseif szTranID == "obacp_opop_064r" then
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szList(10))	'계좌번호
		DATAMANAGER.RequestTranData("obacp_opop_064r")

	elseif szTranID == "obcsb_srpi_102a" then
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "RLTD_ACNO" 			, 0 , g_szList(10)				)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "RLTD_ASNO" 			, 0 , g_szAccountAsNumber			)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "AML_CUST_CLS_CODE"	, 0 , "1"						)	'AML고객구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "RCNO_TYPE_CODE"		, 0 , "01"						)	'AML고객구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock1", "CUST_TYPE_CODE"		, 0 , "01"						)	'고객유형코드 01:계좌고객

		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CUST_FULL_NAME"		, 0 , Container0.Label0.caption		)	'고객명
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CUST_ENG_FULL_NAME"	, 0 , Container0.Edit0.caption		)	'영문명
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "BRDT"	 			, 0 ,Container0.Combo0.Caption & Container0.Combo1.Caption & Container0.Combo2.Caption		)	'생년월일

		if( Container0.RadioGroup2.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "GNDR_CLS_CODE"		, 0 , "1"	)	'성별
		else
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "GNDR_CLS_CODE"		, 0 , "2"	)	'성별
		end if
		if( Container0.RadioGroup0.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "RSDT_CLS_CODE"		, 0 , "1"	)	'거주구분코드
		else
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "RSDT_CLS_CODE"		, 0 , "2"	)	'거주구분코드
		end if

		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "EMAIL_ADDR"			, 0 , Container0.Label4.caption		)	'이메일
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CLPH_ARCD"			, 0 , Container0.Label1.caption		)	'휴대폰1
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CLPH_TONO"			, 0 , Container0.Label8.caption		)	'휴대폰2
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "CLPH_SRNO"			, 0 , Container0.Label9.caption		)	'휴대폰3
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "NTNT_CTCD"			, 0 , "410"						)	'국적국가코드 (대한민국)
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "NTFR_CLS_CODE"		, 0 , "1"						)	'내외국인구분코드
		'자택
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_REGN_ZIP"		, 0 , Container0.Label2.caption		)	'지역우편
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_DTL_ZIP"		, 0 , Container0.Label5.caption		)	'상세우편
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_POST"		, 0 , Container0.Label6.caption		)	'우편주소
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_DTAD"		, 0 , Container0.Label7.caption		)	'상세주소
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_NW_ADDR_USE_YN", 0 , g_szNW_ADDR_USE_YN			)	'신주소사용여부
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_BLDN_MNNO"	, 0 , g_szBLDN_MNNO				)	'건물관리번호

		'직장'
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_REGN_ZIP"		, 0 , Container0.Label3.caption		)	'지역우편
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_DTL_ZIP"		, 0 , Container0.Label21.caption	)	'상세우편
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_POST"			, 0 , Container0.Label22.caption	)	'우편주소
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_DTAD"			, 0 , Container0.Label23.caption	)	'상세주소
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_NW_ADDR_USE_YN"	, 0 , g_co_szNW_ADDR_USE_YN			)	'신주소사용여부
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_BLDN_MNNO"		, 0 , g_co_szBLDN_MNNO				)	'건물관리번호

		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_OWHS_ARCD"		, 0 , Container0.Label12.caption	)	'자택1 (전화)
