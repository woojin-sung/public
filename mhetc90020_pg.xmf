Sub Container0_Combo6_OnEditComplete(iIndex)

	sKey = iIndex + 1
	'학생(14), 주부(17), 전업투자자(18), 무직(19), 기타(99) 직종 비활성화 : 직종 안보냄
	'Container0.Combo6.cbkeydata 으로 실제 매핑데이터 전달하지만 여기서는 sKey 사용하여 기타(20 > 단순 인덱스)
	
	'V004 01~03만 직종선택함. 그 외엔 안함..
'	If sKey == 14 or sKey == 17 or sKey == 18 or sKey == 19 or sKey == 20 Then
'		g_Job = "Y"
'		'EdtOccu는 쓸데가 어딘지몰라서 일단 안가져왓음 추후 필요할시 mbact13111에서 가져올것
'		Container0.BtnOccu.visible = False
'		'Container0.EdtOccu.visible = False
'		Container0.BtnOccu.caption = ""
'		Container0.LabelOccu.visible = True
'
'		'ContMain.ContReg1.EdtOccu.Caption = ""
'		Container0.BtnOccu.Caption = ""
'		g_LRDV_CODE = "00"
'		g_SMDV_CODE = "0000"
'
'		Container0.Table3.visible = False
'		Container0.Edit2.visible = False
'		Container0.Edit2.caption = ""
'
'	Else
'		g_Job = "N"
'		Container0.BtnOccu.visible 		= True
'		'Container0.EdtOccu.visible 	= True
'		'Container0.ImgCombo.visible 	= True
'		Container0.LabelOccu.visible 	= False
'	End If

	Container0.Table3.visible = False
	Container0.Edit2.visible = False
	Container0.Edit2.caption = ""	
	Container0.BtnOccu.Caption = ""
	
	if sKey >= 10 then
		g_LRDV_CODE = sKey		
	else
		g_LRDV_CODE = "0"&sKey
	end if 
	g_SMDV_CODE = ""	
	g_SMDV_CODE11 = ""
		
	If sKey == 1 or sKey == 2 or sKey == 3 Then		
		Container0.BtnOccu.visible 		= True
		Container0.LabelOccu.visible 	= False
	else
		'EdtOccu는 쓸데가 어딘지몰라서 일단 안가져왓음 추후 필요할시 mbact13111에서 가져올것
		Container0.BtnOccu.visible = False
		Container0.LabelOccu.visible = True
	end if

	'Form.MsgBox( "알림", sKey, "", 0 )
	'V004
	'If sKey == 20 Then
	If sKey == 13 Then
		'Form.MsgBox( "알림", "!", "", 0 )
		Container0.Table3.visible 	= True
		Container0.Edit2.visible 	= True
	else
		'Form.MsgBox( "알림", "@", "", 0 )
		Container0.Table3.visible 	= False
		Container0.Edit2.visible 	= False
		'V004 Container0.Edit2.Caption    = ""
	end if
	'g_JobKey = ContMain.ContReg1.CmbJob.cbkeydata >이거뭐지

		'ShowAlert "알림3", Container0.Label3.Caption

	If Trim(Container0.Label3.Caption) <>""  Then '직장주소
		'ShowAlert "알림1", Container0.Combo6.Caption
		if(Trim(Container0.Combo6.Caption) =="주부"
			or Trim(Container0.Combo6.Caption) =="학생"
			or Trim(Container0.Combo6.Caption) =="전업투자자"
			or Trim(Container0.Combo6.Caption) =="무직") Then
			ShowAlert "알림", "직장 주소 존재 시[주부/학생/전업투자자/무직] 선택 불가."
			Container0.Combo6.currentindex = 0

			Exit Sub
		End if
	End If
	
	'V004 값세팅 추가
	g_SPF_HRISK_BSTP_CLCD = "00"
	'if sKey == 4 then
	'	g_OCPT_CD = "14"	'14:학생
	'elseif sKey == 5 then
	'	g_OCPT_CD = "17"	'17:주부
	'elseif sKey == 6 then
	'	g_OCPT_CD = "19"	'19:무직
	'elseif sKey == 7 then
	'	g_OCPT_CD = "18"	'18:전업투자자
	'elseif sKey == 13 then				
	'	g_OCPT_CD = "99" '99:기타
	'	g_SPF_HRISK_BSTP_CLCD="00"	'00`해당없음			
	'elseif sKey == 3 then	
	'	g_OCPT_CD = "16"	'16:전문직
	'elseif sKey == 2 then	
	'	g_OCPT_CD = "03"	'03:자영업자
	'else		
	'	g_OCPT_CD = "15" '15:회사원
		
		if sKey == 8 then
			g_SPF_HRISK_BSTP_CLCD="01"	'01`가상화폐업자			
		elseif sKey == 9 then			
			g_SPF_HRISK_BSTP_CLCD="02"	'02`카지노사업자			
		elseif sKey == 10 then			
			g_SPF_HRISK_BSTP_CLCD="03"	'03`대부업자			
		elseif sKey == 11 then			
			g_SPF_HRISK_BSTP_CLCD="04"	'04`환전상			
		elseif sKey == 12 then			
			g_SPF_HRISK_BSTP_CLCD="05"	'05`귀금속판매상						
		end if
	'end if
	g_OCPT_CD = g_LRDV_CODE
	if g_LRDV_CODE <> "01" and g_LRDV_CODE <> "02" and g_LRDV_CODE <> "03" then
		g_SMDV_CODE = g_LRDV_CODE&"00"
	end if

End Sub

