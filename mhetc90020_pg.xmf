Sub Container0_Combo2_OnEditComplete(iIndex)
	if 	Container0.Combo1.caption =="04"
		or   Container0.Combo1.caption =="06"
		or   Container0.Combo1.caption =="09"
		or   Container0.Combo1.caption =="11" then
			if Container0.Combo2.caption =="31" then
				Container0.Combo2.caption ="01"
				Container0.Combo2.currentindex = 0
				Form.MsgBox("알림", "일자를 확인하세요", 0, 6)
			end if
	elseif Container0.Combo1.caption =="02" then
		if Container0.Combo2.caption =="31"
			or Container0.Combo2.caption =="30"
			or Container0.Combo2.caption =="29" then
				Container0.Combo2.caption ="01"
				Container0.Combo2.currentindex = 0
				Form.MsgBox("알림", "일자를 확인하세요", 0, 6)
		end if
	end if

End Sub

