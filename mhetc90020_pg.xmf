'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'HTS 고객등록처리
	if szTranID == "obcsb_efif_060a" then
		DATAMANAGER.SetUserID("meritz")	'ID등록요청시 헤더 ID 영역에 'meritz'로 강제처리
		
		'처리일자, 처리일련번호
		Dim sProsDate, sProsSrno 
		sProsDate = Form.GetSharedData( "PROS_DATE", false )
		sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(10) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(11) )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO" , 0 , g_szList(9) ) 'v002
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" , 0 , g_szList(8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(12) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" , 0 , g_szList(13) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0,  szTranID, "InBlock1", "PROS_DATE", 0, sProsDate)
		DATAMANAGER.SetDataValue(0,  szTranID, "InBlock1", "PROS_SRNO", 0, sProsSrno)
		
	end if

		'부가정보등록
	if szTranID == "obcsb_aaif_003a" then
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO" , 0 , g_szList(9) ) 'v002
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP" , 0 , g_szList(9) ) 'v002
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szList(12) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" , 0 , g_szList(13) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szList(10) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ADIF_CNFR_QSTN_CNTT1" , 0 , g_szList(15) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ADIF_CNFR_ANSR_CNTT1" , 0 , g_szList(16) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ADIF_CNFR_QSTN_CNTT2" , 0 , g_szList(17) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ADIF_CNFR_ANSR_CNTT2" , 0 , g_szList(18) )
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	if sKeyName == g_sPopupFileName then
'		if sRet == "ok" then
'			g_sRetData = "ok"
'			Form.CloseForm( )
'		end if
'	end if

	'직종
	If sKeyName == "mbact13010_p2" Then
		'ContMain.ContReg1.EdtOccu.Caption = sRet
		Container0.BtnOccu.Caption = sRet
		g_LRDV_CODE 	= Form.GetSharedData("13010_OCCU_LRDV", False )	'대업무분류
		g_SMDV_CODE 	= Form.GetSharedData("13010_OCCU_SMDV", False )		'소업무분류
		g_SMDV_CODE11	= Form.GetSharedData("13010_OCCU_NAME", False )		'소업무분류

		'V004
		Container0.Combo6.cbkeydata = g_LRDV_CODE
		
		Container0.Table3.visible = False
		Container0.Edit2.visible = False
		Container0.Edit2.caption = ""	
		

		If g_LRDV_CODE == "01" or g_LRDV_CODE == "02" or g_LRDV_CODE == "03" Then
			Container0.BtnOccu.visible 		= True
			Container0.LabelOccu.visible 	= False
		elseif g_LRDV_CODE == "13" then
			Container0.Table3.visible 	= True
			Container0.Edit2.visible 	= True		
		else
			'EdtOccu는 쓸데가 어딘지몰라서 일단 안가져왓음 추후 필요할시 mbact13111에서 가져올것
			Container0.BtnOccu.visible = False
			Container0.LabelOccu.visible = True
		end if
		
		g_SPF_HRISK_BSTP_CLCD="00"	'00`해당없음
		
		'if g_LRDV_CODE == "04" then
		'	g_OCPT_CD = "14"	'14:학생
		'elseif g_LRDV_CODE == "05" then
		'	g_OCPT_CD = "17"	'17:주부
		'elseif g_LRDV_CODE == "06" then
		'	g_OCPT_CD = "19"	'19:무직
		'elseif g_LRDV_CODE == "07" then
		'	g_OCPT_CD = "18"	'18:전업투자자
		'else
			if g_LRDV_CODE == "13" then				
		'	g_OCPT_CD = "99" '99:기타
		'	g_SPF_HRISK_BSTP_CLCD="00"	'00`해당없음			
				Container0.Container2.Edit1.enable = true	'기타 활성화..
		'elseif g_LRDV_CODE == "03" then	
		'	g_OCPT_CD = "16"	'16:전문직
		'elseif g_LRDV_CODE == "02" then	
		'	g_OCPT_CD = "03"	'03:자영업자
		'else		
		'	g_OCPT_CD = "15" '15:회사원
			
		'	if g_LRDV_CODE == "08" then
			elseif g_LRDV_CODE == "08" then
				g_SPF_HRISK_BSTP_CLCD="01"	'01`가상화폐업자			
			elseif g_LRDV_CODE == "09" then			
				g_SPF_HRISK_BSTP_CLCD="02"	'02`카지노사업자			
			elseif g_LRDV_CODE == "10" then			
				g_SPF_HRISK_BSTP_CLCD="03"	'03`대부업자			
			elseif g_LRDV_CODE == "11" then			
				g_SPF_HRISK_BSTP_CLCD="04"	'04`환전상			
			elseif g_LRDV_CODE == "12" then			
				g_SPF_HRISK_BSTP_CLCD="05"	'05`귀금속판매상						
			end if
		'end if	
		g_OCPT_CD = g_LRDV_CODE
		If g_LRDV_CODE <> "01" and g_LRDV_CODE <> "02" and g_LRDV_CODE <> "03" Then
			g_SMDV_CODE = g_LRDV_CODE&"00"
		end if
			
	End If

	if sKeyName == "mbonl81000" then	'고객연락처변경에서 넘어옴
		if sRet == "ok" then
			'btnSearch_OnClick()	'재조회
			TR_Inquiry("obcsb_acad_002r") '변경한 내역 바로 보이도록 다시 Call
		end if

	end if

End Sub

