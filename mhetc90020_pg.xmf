		'DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock4", "AML_PROD_CODE"		, 0 , g_AML_PROD_CODE				)	'AML상품코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock4", "AML_PROD_CODE"		, 0 , "0006"						)	'AML상품코드


		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock4", "CDD_TR_KIND_CODE" 	, 0 , "1"						)	'CDD 거래종류코드


		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "CUST_FULL_NAME" 		, 0 , Container0.Label0.caption		)	'고객풀명
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "UI_FRGN_YN" 			, 0 , "N"						)	'UI_외국인여부

		if( Container0.RadioGroup1.currentindex =="0") then
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "PBO_YN"	 		, 0 , 	"Y"						)	'개인실제소유자여부
			DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock8", "WRTR_INTG_CSNM" 	, 0 , Container0.Label0.caption		)	'작성자통합고객명
		else
