'============================================================================
Sub Container0_Edit0_OnEditComplete()
	' 영문명 체크(한글 불가)
	if Str_Chk(Container0.Edit0.caption, "ENG_NAME") == False then
		Form.MsgBox("알림", "고객영문명은 영문만 입력 가능합니다.", 0, 6)
		Container0.Edit0.caption = ""
		Container0.scroll_pos = 0
		Exit Sub
	end if
End Sub
'============================================================================
Function Str_Chk(str, sGubn) 'v0007
	dim i							'루프용
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크 '20150309_01 KBC

	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자


	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))

	    if nAscii < 0 then			'한글 일때
		    return False			'한글 기럭지 2
		else						'영, 숫, 특 일때
		    '48~57 : 0~9
		    '65~90 : A~Z
		    '97~122: a~z
		    '
		    If nAscii >=48 and nAscii <=57 Then
			    chk_n = 1
			Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
			    chk_c = 1
		    Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
			    chk_t = 1
		    End if
		end if
	Next

	if sGubn == "ENG_NAME" then
		If chk_n == 1 Then
			return False
		End if

		If chk_t == 1 Then
			return False
		End if
	end if

	return True
End Function



