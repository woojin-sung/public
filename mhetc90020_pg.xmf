		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_TONO"			, 0 , Container0.Label112.caption	)	'직장2
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock2", "UI_CO_TELNO"			, 0 , Container0.Label113.caption	)	'직장3


		'V004 DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "OCPT_CODE"			, 0 , Container0.Combo6.cbkeydata	)	'직업코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "OCPT_CODE"			, 0 , g_OCPT_CD					)	'직업코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "ETC_CNTT"			, 0 , Container0.Edit2.caption		)	'기타내용
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "AML_OCKN_LRDV_CODE"	, 0 , g_LRDV_CODE					)	'AML직종대분류코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "AML_OCKN_SMDV_CODE"	, 0 , g_SMDV_CODE					)	'AML직종소분류코드
		'V004 DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "SPF_HRISK_BSTP_CLCD"	, 0 , Container0.Combo3.cbkeydata	)	'특종고위험업종구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "SPF_HRISK_BSTP_CLCD"	, 0 , g_SPF_HRISK_BSTP_CLCD			)	'특종고위험업종구분코드
		DATAMANAGER.SetDataValue(0, "obcsb_srpi_102a", "InBlock3", "WRPL_NAME"			, 0 , Container0.Edit3.caption		)	'V004 직장명 매핑 추가

