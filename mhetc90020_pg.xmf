		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "EDD_TR_FNDS_SORC_CODE" 	, 0 , Container0.Container2.Combo5.cbkeydata	)
		DATAMANAGER.SetDataValue(0, "obcmm_kedd_019a", "InBlock1", "EDD_TR_FNDS_SORC_ETC_CNTT"	, 0 , Container0.Container2.Edit6.caption	)


		DATAMANAGER.RequestTranData("obcmm_kedd_019a")

	elseif szTranID == "obcsb_efif_060a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , g_szList(10) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , g_szList(11) )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO" 				, 0 , g_szList(9) ) 'v002
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE" 		, 0 , g_szList(8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 			, 0 , g_szList(12) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD" 			, 0 , g_szList(13) )

		DATAMANAGER.RequestTranData("obcsb_efif_060a")
	end if
End Function

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acad_002r" then

		'//////현재 고객 통보처 상태 기억 /////////////

		g_szNoticeType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "SNML_INAG_TYPE_CODE" , 0)
		g_szNoticeSerial = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "SNML_INAG_SRNO" , 0)

		'g_szFundRmndRcmsClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "FUND_RMND_RCMS_CLS_CODE" , 0) '펀드잔고수신구분코드

		g_szMailType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MAIL_INAG_TYPE_CODE" , 0)
		g_szMailSerial = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MAIL_INAG_SRNO" , 0)

		'g_szCsno = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "CSNO" , 0)


		szReport = DATAMANAGER.GetDataValue(0,  "obcsb_acad_002r", "OutBlock5", "MGRI_RPRT_INAG_TYPE_CODE", 0)
		szReportSerial = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock5", "MGRI_RPRT_INAG_SRNO" , 0)


		'//////계좌별 통보처 등록 부분 ////////////////
		Dim szAccNoticeType	'발송물통보처유형코드
		Dim szAccMailType 	'우편물통보처유형코드
		szAccNoticeType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock7", "SNML_INAG_TYPE_CODE" , 0)
		szAccMailType = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock9", "MAIL_INAG_TYPE_CODE" , 0)


		'//////고객 통보처 부분 셋팅////////////////
		for i=0 to DATAMANAGER.GetDataCount(0, "obcsb_acad_002r", "OutBlock1" )-1
			Dim szNotice	'통보처유형코드
			szNotice = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE", i)


			Dim nNoticeRow
			if szNotice == "01" then 	'자택
				Container0.Label2.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "REGN_ZIP" 		, i )) '지역우편
				Container0.Label5.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "DTL_ZIP" 		, i ))	'상세우편
				Container0.Label6.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "POST" 			, i ))	'우편주소
				Container0.Label7.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "DTAD" 			, i ))	'상세주조
				g_szNW_ADDR_USE_YN	   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "NW_ADDR_USE_YN" , i ))	'신주소사용여부
				g_szBLDN_MNNO			   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "BLDN_MNNO"		, i ))	'건물관리번호
			elseif szNotice == "02" then	'회사
				Container0.Label3.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "REGN_ZIP" 		, i ))
				Container0.Label21.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "DTL_ZIP" 		, i ))
				Container0.Label22.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "POST" 		, i ))
				Container0.Label23.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "DTAD" 		, i ))
				g_co_szNW_ADDR_USE_YN   = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "NW_ADDR_USE_YN" 	, i ))	'회사신주소사용여부
				g_co_szBLDN_MNNO		 = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "BLDN_MNNO"		, i ))	'회사건물관리번호

'			elseif szNotice == "03" then	'기타
'				nNoticeRow = 3
			elseif szNotice == "21" then	'이메일
				Container0.Label4.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "ADDR" , i ))
			end if

			'Container0.tblView.SetCellString(nNoticeRow, 1, Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i ) ))
			'Container0.tblView.SetCellString(nNoticeRow, 2, Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock1", "ADDR" , i ) ))
		next


		'//////연락처 셋팅////////////////
		for i=0 to DATAMANAGER.GetDataCount(0, "obcsb_acad_002r", "OutBlock3" )-1
			Dim szNotice	'통보처유형코드
			Dim nNoticeRow
			szNotice = DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE", i)


			if szNotice == "13" then 	'휴대폰
				Container0.Label1.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i ))
				Container0.Label8.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TONO" , i ))
				Container0.Label9.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i ))

			elseif szNotice == "11" then 	'자택전화
				Container0.Label12.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i ))
				Container0.Label19.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TONO" , i ))
				Container0.Label110.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i ))

			elseif szNotice == "12" then 	'직장전화
				Container0.Label10.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TONO" , i ))
				Container0.Label112.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i ))
				Container0.Label113.caption = Trim(DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i ))

			end if

		next


		TR_Inquiry("obacp_opop_064r")	'고객명 조회
	end if

	if szTranID == "obacp_opop_064r" then	'종합계좌 기준 계좌 CONTROL 조회
		Container0.Label0.caption = DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNM" , 0)	'고객명

		g_szAccountAsNumber = "01" 		'계좌 일련번호

	end if


	if szTranID == "obcsb_srpi_102a" then	'CDD 고객개인내역 등록
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CDD_RISK_CLCD" , 0) == "3" then 'EDD 실행대상
			TR_Inquiry("obcmm_kedd_019a")	'개인 EDD 처리
		else
			TR_Inquiry("obcsb_efif_060a")	'ID 등록요청
		end if
	end if

	if szTranID == "obcmm_kedd_019a" then
		TR_Inquiry("obcsb_efif_060a")	'ID 등록요청
	end if

	if szTranID == "obcsb_efif_060a" then	'ID 등록요청
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SUCS_YN" , 0) == "Y" then
			DATAMANAGER.RequestTranData("obcsb_aaif_003a")	'부가정보 등록
		else
			Form.MsgBox( "알림", "ID등록이 실패하였습니다. 해당 영업점 또는 고객지원센터(1588-3400)로 문의 바랍니다.", "", 6 )
		end if
	end if

	if szTranID == "obcsb_aaif_003a" then	'부가정보 등록
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RSLT_CLS" , 0) == "0" then

			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 0 )
		end if
	end if


End Sub

Sub Form_OnMsgBoxClose(sKeyName, sRet)

	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		g_sRetData = "ok"
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	end if
End Sub



