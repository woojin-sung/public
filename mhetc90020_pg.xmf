Sub Container0_btnOK_OnClick()

' 개별 검증 확인위해 주석처리. 추후에 아래내용 다 주석 풀어야함

'	If Trim(Container0.Label0.Caption) = "" Then
'		ShowAlert "알림", "고객명을 확인하시기 바랍니다."
'		Exit Sub
'	End If

	If Trim(Container0.Edit0.Caption) = "" Then
		ShowAlert "알림", "영문명을 입력하세요."
		Container0.scroll_pos = 0
		Exit Sub
	End If

	If Trim(Container0.RadioGroup2.currentindex) = "-1" Then
		ShowAlert "알림", "성별을 선택하세요."
		Container0.scroll_pos = 0
		Exit Sub
	end if

	If Container0.Combo0.caption = " "
		or Container0.Combo1.caption = " "
		or Container0.Combo2.caption = " " Then
		ShowAlert "알림", "생년월일을 입력하세요."
		Container0.scroll_pos = 0
		Exit Sub
	End If

	If Container0.Combo6.Caption = " "  Then
		ShowAlert "알림", "직업을 확인하세요."
		Exit Sub
	End If

	'V004
	'if(Trim(Container0.Combo6.Caption) <>"주부"
	'	and Trim(Container0.Combo6.Caption) <>"학생"
	'	and Trim(Container0.Combo6.Caption) <>"전업투자자"
	'	and Trim(Container0.Combo6.Caption) <>"무직"
	'	and Trim(Container0.Combo6.Caption) <>"기타") Then
	if (Trim(Container0.Combo6.Caption) == "직장인" or Trim(Container0.Combo6.Caption) == "자영업자" or Trim(Container0.Combo6.Caption) == "전문직") Then
		if Container0.BtnOccu.caption = "" then
			ShowAlert "알림", "직종을 확인하세요"
			Exit Sub
		end if
	end if

	If Trim(Container0.Combo6.Caption) == "기타" Then
		'if Len(Trim(Container0.Edit2.Caption)) < 4 Then
		if Form.getLen(Trim(Container0.Edit2.Caption)) < 3 Then
			ShowAlert "알림", "기타 입력을 확인하세요(3자이상)"
			Exit Sub
		end if
		if Trim(Container0.Edit2.Caption) = "기타" Then
			ShowAlert "알림", "기타 항목을 올바르게 입력하세요('기타' 입력 불가)."
			Exit Sub
		end if		
	End If

	'V004
	'If Container0.Combo3.Caption = " "  Then
	'		ShowAlert "알림", "특종 고위험 업종 구분을 확인하세요."
	'	Exit Sub
	'End If

	if Container0.RadioGroup1.currentindex =="1" then
		if Trim(Container0.Container1.Edit4.Caption) ==""
			or Trim(Container0.Container1.Edit5.Caption) =="" Then
			ShowAlert "알림", "실제소유자 정보를 확인하세요"
			Exit Sub
		End If
	End If

	'if Container0.Container2.Combo4.currentindex == "-1" then
	if TRIM(Container0.Container2.Combo4.caption) == "" then
		ShowAlert "알림", "거래목적을 입력하세요"
		Exit Sub
	end if

	if Container0.Container2.Combo4.cbkeydata =="9" then '선택 기타일 때
		if (TRIM(Container0.Container2.Edit1.Caption) ="") or (Len(Trim(Container0.Container2.Edit1.Caption)) < 4)  then
			ShowAlert "알림", "거래목적 기타내용을 입력하세요"
			Exit Sub
		end if
	end if

	if TRIM(Container0.Container2.Combo5.caption) == "" then
		ShowAlert "알림", "자금의 원천을 입력하세요"
		Exit Sub
	end if

	if Container0.Container2.Combo5.cbkeydata =="99" then '선택 기타일 때
		if (TRIM(Container0.Container2.Edit6.Caption) ="") or (Len(Trim(Container0.Container2.Edit6.Caption)) < 4) then
			ShowAlert "알림", "자금원천 기타내용을 입력하세요"
			Exit Sub
		end if
	end if


	TR_Inquiry("obcsb_srpi_102a")	'CDD고객개인내역등록

End Sub

