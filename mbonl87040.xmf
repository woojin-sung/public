'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선물옵션 야간거래 신청
' 02. 화면설명 : 선물옵션 야간거래(CME/EUREX)를 신청하는 화면
' 03. 작    성 : 2017.05.25 김동구
' 04. 수    정 : 2019.04.30 장원혁 v0002 해외 거래소 개인(신용)정보 제공 동의 기능 추가
' 2020.09.18 : 정민영 : v0003 : [T2008250015] 메모리취약점 보완
' 2020.12.14 : 정민영 : v0004 : [T2012140011] CME연계 야간선물거래 중단(mbonl87040_t1 연결삭제처리)          
'-------------------------------------------------------------------------------------------
'============================================================================

'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nFmtabIndex			'폼탭 Index
Dim g_szAccountNumber		'계좌번호 8글자
Dim g_szAccountSerialNumber	'계좌일련번호 2글자
Dim g_szAccountPassword	'계좌 비밀번호
Dim g_szAllData			'계좌 + 일련번호 + 비밀번호
Dim g_plain_rm  			'v0003 메모리평문적용여부
Dim g_pwdLen				'v0003 비밀번호자릿수


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************ㅉ

'============================================================================
' Account0_ChangeAccount
'============================================================================
Sub Account0_ChangeAccount()
	g_szAccountNumber = Account0.total
	EditPW.caption = ""
	'v0003
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_pwdLen = EditPW.pwdlen
		if g_pwdLen == "" or g_pwdLen == Null then
			g_pwdLen = 0
		end if
		g_szAccountPassword = EditPW.caption
	else  'MTS메모리평문 미적용상태일때
		g_szAccountPassword = Form.GetEncData(EditPW.caption)
	end if
	
	FormTab0_OnTabChanged(FormTab0.currenttab)
End Sub

'============================================================================
' EditPW_OnEditComplete
'============================================================================
Sub EditPW_OnEditComplete()
	'v0003 비밀번호 자릿수 및 전역변수에 비밀번호 설정
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_pwdLen = EditPW.pwdlen
		if g_pwdLen == "" or g_pwdLen == Null then
			g_pwdLen = 0
		end if
	end if
	g_szAccountPassword = EditPW.caption

	'v0003 g_szAllData 설정로직 추가
	g_szAllData = Account0.total & "★" & Account0.sequence & "★" & g_szAccountPassword
	
	'v0003 메모리평문적용시, 타화면과의 비밀번호자릿수연동을위해 마지막에 비밀번호자릿수(Lx) 설정해줌
	if g_plain_rm == "1" then
		g_szAccountPassword = Trim(g_szAccountPassword) & "★" & "L" & CStr(g_pwdLen)
		g_szAllData         = Trim(g_szAllData) & "★" & "L" & CStr(g_pwdLen)
	end if
	
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AccountData", g_szAllData)	
	Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "PASSWORD", g_szAccountPassword ) 'v0003	'v0002 삭제 
	'Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "PASSWORD", EditPW.caption )     'v0003주석	'v0002
	Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "SELECT", g_szAllData )	
End Sub

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	if EditPW.caption == null or EditPW.caption == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' FormTab0_OnTabChanged - 탭 변경할 때 조회
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	'v0003 비밀번호 자릿수 설정
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_pwdLen = EditPW.pwdlen
		if g_pwdLen == "" or g_pwdLen == Null then
			g_pwdLen = 0
		end if
	end if
	
	g_szAccountPassword = EditPW.caption
	g_szAllData = Account0.total & "★" & Account0.sequence & "★" & g_szAccountPassword
	
	'v0003 메모리평문적용시, 타화면과의 비밀번호자릿수연동을위해 마지막에 비밀번호자릿수(Lx) 설정해줌
	if g_plain_rm == "1" then
		g_szAccountPassword = Trim(g_szAccountPassword) & "★" & "L" & CStr(g_pwdLen)
		g_szAllData         = Trim(g_szAllData) & "★" & "L" & CStr(g_pwdLen)
	end if
	
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AccountData", g_szAllData)	
	Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "PASSWORD", g_szAccountPassword ) 'v0003	'v0002 삭제
	'Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "PASSWORD", EditPW.caption )     'v0003주석 'v0002
	'v0003 조회이벤트 추가
	Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "SELECT", g_szAllData )	
End Sub



'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	g_szAccountNumber = Account0.total

	'v0003 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	'v0003 비밀번호 자릿수 설정
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_pwdLen = EditPW.pwdlen
		if g_pwdLen == "" or g_pwdLen == Null then
			g_pwdLen = 0
		end if
	end if
	
	g_szAccountPassword = EditPW.caption
	g_szAllData = Account0.total & "★" & Account0.sequence & "★" & g_szAccountPassword

	
	'v0003 메모리평문적용시, 타화면과의 비밀번호자릿수연동을위해 마지막에 비밀번호자릿수(Lx) 설정해줌
	if g_plain_rm == "1" then
		g_szAccountPassword = Trim(g_szAccountPassword) & "★" & "L" & CStr(g_pwdLen)
		g_szAllData         = Trim(g_szAllData) & "★" & "L" & CStr(g_pwdLen)
	end if

	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AccountData", g_szAllData)	
	Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "PASSWORD", g_szAccountPassword ) 'v0003	'v0002 삭제
	'Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "PASSWORD", EditPW.caption )     'v0003주석	'v0002
	'v0003 조회이벤트 추가
	Form.triggerEvent( "FormTab0."& FormTab0.currenttabpageid, "SELECT", g_szAllData )

'	if CInt(FormTab0.currenttab) == 0 then
'	   Form.triggerEvent("#", "enroll", szParam)
'	elseif CInt(FormTab0.currenttab) == 1 then   
'	   Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "cancel", szParam) 
'	end if   
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	Form.SetSharedData("mbonl81010_p16_LOAN_YN", "")
End Sub

