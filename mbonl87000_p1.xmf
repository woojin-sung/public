					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" fontsize="-1" impidxs="" />
						<CELL cell_ly="1,0,2,0" halign="0" caption="· 알리미 서비스는 카카오 알림톡으로 먼저 전송되며," impidxs="" />
						<CELL cell_ly="0,1,0,1" halign="0" fontsize="-1" impidxs="" />
						<CELL cell_ly="1,1,2,1" halign="0" caption="   전송 실패 시 휴대폰 문자로 재발송 됩니다." impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" fontsize="-1" impidxs="" />
						<CELL cell_ly="1,2,2,2" halign="0" caption="   (일부 업무는 제외)" impidxs="" />
