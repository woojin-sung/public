						<CELL cell_ly="1,7,2,7" halign="0" caption="   참고용으로 확인하시고, 최종적으로는 온라인 채널" impidxs="" />
						<CELL cell_ly="0,8,0,8" impidxs="" />
						<CELL cell_ly="1,8,2,8" halign="0" caption="   등을 통해 직접 확인하시기 바랍니다." impidxs="" />
