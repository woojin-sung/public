	<CONTROL_INFO>
		<LABEL name="Label0" fontsize="-2" caption="1. 베트남 동 (VND) 환전은 현지 외환관리규정에 의하여" ly_vert="1,52,362,32,1" />
		<LABEL name="Label2" fontsize="-2" caption="    미국달러 (USD)로 현지에서만 가능한 환전입니다." ly_vert="1,73,379,32,1" />
		<LABEL name="Label3" fontsize="-2" caption="2. 베트남 동 (VND)은 현지 주식투자 용도의 환전으로," ly_vert="1,104,379,32,1" />
		<LABEL name="Label4" fontsize="-2" caption="    다른 외화와 달리 타사 계좌로 이체·대체는 제한됩니다." ly_vert="1,125,379,32,1" />
		<LABEL name="Label5" fontsize="-2" caption="3. 환전결제일 매도통화 부족 시 외화미수금이 발생할 수" ly_vert="1,176,379,32,1" />
		<LABEL name="Label6" fontsize="-2" caption="4. 환전은 환전신청일 기준 T+1~2 영업일 이내 환전 결과" ly_vert="1,228,379,32,1" />
		<LABEL name="Label8" fontsize="-2" caption="5. 08:00~11:00 신청 건은 T+1영업일 오전에 환전 결제되고," ly_vert="1,280,379,32,1" />
		<LABEL name="Label9" fontsize="-2" caption="    11:00~17:00 신청 건은 T+2영업일 오전에 환전 결제" ly_vert="1,301,379,32,1" />
		<LABEL name="Label10" fontsize="-2" caption="6. 현지 사정 또는 국내/현지 휴일 등의 사유로 환전처리" ly_vert="1,352,379,32,1" />
		<BUTTON name="BtnCnfr" caption="확인" fgcolor="006:213049051" btnimage="btn_pop2.9" ly_vert="0,561,375,45,1" />
		<LABEL name="Label11" fontsize="-2" caption="    있습니다." ly_vert="1,197,379,32,1" />
		<LABEL name="Label1" fontsize="-3" caption="     (이체·대체를 원하시는 경우 USD로 환전 후 가능합니다.)" ly_vert="1,146,379,32,1" />
		<LABEL name="Label12" fontsize="-2" caption="    확인 후, 일괄 처리 됩니다." ly_vert="1,249,379,32,1" />
		<LABEL name="Label13" fontsize="-2" caption="    됩니다." ly_vert="1,321,379,32,1" />
		<LABEL name="Label14" fontsize="-2" caption="    결제일은 지연될 수 있습니다." ly_vert="1,373,379,32,1" />
		<LABEL name="Label15" fontsize="-2" caption="7. 11:00 이전 신청 건은 11:00 이후에는 취소 불가합니다." ly_vert="1,404,379,32,1" />
		<LABEL name="Label16" fontsize="-2" caption="8. 현지 환전결과가 USD 0.01 미만인 경우는 환전신청은" ly_vert="1,435,379,32,1" />
		<LABEL name="Label17" fontsize="-2" caption="    취소될 수 있습니다." ly_vert="1,456,379,32,1" />
