	<CONTROL_INFO>
		<LINKFORM name="linkfmHoga" linkfile="mhprc31000_s1" bordercolor="017:216216216" ly_vert="0,0,375,76,1" />
		<FORMTAB name="fmtab0" tabcount="6" tabheadwidth="80" tabheadheight="40" autosave="1" ly_vert="0,76,375,487,1" >
			<PAGE name="page006984" caption="호가" linkfile="mhprc34000_t1" loadingtype="1" />
			<PAGE name="page004447" caption="상세" linkfile="mhprc34000_t2" loadingtype="1" />
			<PAGE name="page000316" caption="시간별" linkfile="mhprc34000_t4" loadingtype="1" />
			<PAGE name="page000774" caption="일별" linkfile="mhprc34000_t5" loadingtype="1" />
			<PAGE name="page003534" caption="차트" linkfile="mhprc34000_t6" loadingtype="1" />
			<PAGE name="page001616" caption="설정" linkfile="mhprc34000_t7" />
		</FORMTAB>
		<LABEL name="lblItemCode" ly_vert="100,600,100,32,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6730" _ulen="6076" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************

Dim g_szItemCode
Dim g_nfmTab
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

'====================================================================================
Sub Form_OnFormInit()
	Dim szOpen, arrData
	
	szStyle	= Form.LoadConfigData("mhprc34000", "Style"	)	'현재가 스타일
	
'	20220708 HSZ START: 임시로 mhprc34000_s1로 처리
'	If szStyle = "0" Then
'		linkfmHoga.linkfile = "mhprc34000_s2"
'	ElseIf szStyle = "1" Then
		linkfmHoga.linkfile = "mhprc34000_s1"
'	Else
'		linkfmHoga.linkfile = "mhprc34000_s2"
'	End If
'	20220708 HSZ END
	
	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"★")
	
	if arrData(0) <> "" then
		g_szItemCode = arrData(0)
		
		' 타화면에서 호출되는 탭으로 이동
		If #arrData > 1 Then
			If arrData(1) <> "" then
				fmtab0.currenttab = arrData(1)
			End If
		End If
	else
		g_szItemCode = Form.GetSharedData("&ITEM_CMEEUREX", 0)		' 최근조회종목
	end if
	
	lblItemCode.caption = g_szItemCode
	
	Form.SetItemCode(g_szItemCode)												' 최초 화면진입시 종목코드 설정
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 						' 링크화면에 종목코드 던지기
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기

End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mhprc34000", "frmTab", g_nfmTab)
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	g_nfmTab = nCurrentTab
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "INIT_CODE", lblItemCode.caption )
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	'20220307 HSZ 야간 위클리옵션 신규상장 (27 추가)
	Form.SetSearchType ( "11:12:13:27" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "FORMTAB_SET" Then							' 폼탭 셋팅
		fmtab0.showconfig("탭표시 순서 변경")
		
	ElseIf sEventName = "FORMTAB_INIT" Then						' 폼탭 초기화
		fmtab0.SetDefaultHeader()
		
	ElseIf sEventName = "HOGA_SETUP" Then						' 폼탭 초기화
		Dim szStyle
		szStyle	= Form.LoadConfigData("mhprc34000", "Style"	)	'현재가 스타일
'	20220708 HSZ START: 임시로 mhprc34000_s1로 처리
'		If szStyle = "0" Then
'			linkfmHoga.linkfile = "mhprc34000_s2"
'		ElseIf szStyle = "1" Then
			linkfmHoga.linkfile = "mhprc34000_s1"
'		Else
'			linkfmHoga.linkfile = "mhprc34000_s2"
'		End If
'	20220708 HSZ END
		If fmtab0.currenttab = "0" Or fmtab0.currenttab = 0 Then
			Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "HOGA_SETUP", "" )
		End If
		
		Form.SetItemCode(g_szItemCode)							'종목스타일 변경시 종목을 던져서 재조회

	ElseIf sEventName = "SCREEN_MENU" Then						'연결정보(상단 ...)
		
		If sParam = "POP_UP1" Then								' 프로그램동향(투자자동향)
			Form.OpenScreen("43000" , 3)
		
		ElseIf sParam = "REG_INTR" Then							' 관심종목등록
			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			
		ElseIf sParam = "SET_SCREEN" Then						' 화면설정
			Form.OpenFramePopup("mhprc34000_p1" , "" , "")
			
		ElseIf sParam = "SHA_SNS" Then							' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If
		
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "11:12:13:27" , "")	
	'20220922 SWJ END	
	End If
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		lblItemCode.caption = sValue		
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	If sKeyName = "FORMTAB_SET" Then			' 폼탭 셋팅
		fmtab0.showconfig("탭표시 순서 변경")
		
	ElseIf sKeyName = "FORMTAB_INIT" Then		' 폼탭 초기화
		fmtab0.SetDefaultHeader()
		
	ElseIf sKeyName = "HOGA_SETUP" Then			' 폼탭 초기화
		Dim szStyle
		szStyle	= Form.LoadConfigData("mhprc34000", "Style"	)	'현재가 스타일
'	20220708 HSZ START: 임시로 mhprc34000_s1로 처리
'		If szStyle = "0" Then
'			linkfmHoga.linkfile = "mhprc34000_s2"
'		ElseIf szStyle = "1" Then
			linkfmHoga.linkfile = "mhprc34000_s1"
'		Else
'			linkfmHoga.linkfile = "mhprc34000_s2"
'		End If
'	20220708 HSZ END
		If fmtab0.currenttab = "0" Or fmtab0.currenttab = 0 Then
			Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "HOGA_SETUP", "" )
		End If
		
		Form.SetItemCode(g_szItemCode)	'종목스타일 변경시 종목을 던져서 재조회
		
	elseif sKeyName = "snsshare" Then	' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If

	End If
End Sub

'============================================================================
Sub Form_OnRefresh()

	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 						' 링크화면에 종목코드 던지기
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
	
End Sub

'============================================================================
'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>