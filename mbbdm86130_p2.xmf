	<SCRIPT_INFO _len="4410" _ulen="3656" >
'--===========================================================================
' 01. 화 면 명 : 비대면계좌개설이어하기안내
' 02. 화면설명 : 비대면계좌개설이어하기안내
' 03. 작    성 : 2021.01.31 : 정민영
' 04. 수    정 : 
'
'--===========================================================================

Dim	g_BDM_LAST_STAG_CLS_CODE	'최종등록단계구분코드
Dim	g_BDM_CLEAR_YN		'	Y:처음부터하기 N: 이어가기
Dim	g_BDM_PRNM				'개설상품명
Dim	g_BDM_APLTDATE			'신청일자
Dim	g_BDM_CLSNDATE			'신청마감일자
Dim  g_szTheme                  '테마구분  white/black

'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동Y
	'부모창(mbbdm85110) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

     '이미지설정
	imgBg.imgpath       = "alpha128"
	imgExit.imgpath     = "icon_close"
	If g_szTheme = "black" Then
		BtnCancel.imgpath   = "btn_27.9"   
	Else
		BtnCancel.imgpath   = "btn_27.9"  'white모드도 동일 
	End If
	BtnContinue.imgpath = "btn_20.9"

	'lblSubTitle.caption = "진행 중이던 비대면 계좌개설 건이 있습니다.\n\n".."계속 진행하시겠습니까?"
	lblSubTitle.caption = "진행중인 계좌 개설 내역이 있습니다.\n".."이어서 진행하시겠어요?"

	'넘어온 정보 설정
	g_BDM_LAST_STAG_CLS_CODE	= Form.GetSharedData("BDM_LAST_STAG_CLS_CODE"	, false)	'최종등록단계구분코드	
	g_BDM_PRNM				= Form.GetSharedData("BDM_PRNM"				, false)	'개설상품명
	g_BDM_APLTDATE			= Form.GetSharedData("BDM_APLTDATE"			, false)	'신청일자
	g_BDM_CLSNDATE			= Form.GetSharedData("BDM_CLSNDATE"			, false)	'신청마감일자

    	Form.SetCtlProp("grid0", "insertrow", 0)	'한줄삽입
	'항목명 설정
	'2021.04.05 개설상품명 미표시(By박정숙Cha)
	'grid0.SetCellData( "prnm"			, 0, g_BDM_PRNM	)	'개설상품명
	grid0.SetCellData( "aplt_state_l"	, 0, "개설 상품"	)	'완료단계
	grid0.SetCellData( "aplt_date_l"	, 0, "진행 단계"	)	'최초신청일
	grid0.SetCellData( "aplt_fin_l"		, 0, "신청 마감일"	)	'신청마감일
	'항목정보 설정
	If g_BDM_LAST_STAG_CLS_CODE == "1" or g_BDM_LAST_STAG_CLS_CODE == 1 then
		strRegStagNm = "고객정보 입력"
	ElseIf g_BDM_LAST_STAG_CLS_CODE == "2" or g_BDM_LAST_STAG_CLS_CODE == 2 then
		strRegStagNm = "계좌비밀번호 설정"
	ElseIf g_BDM_LAST_STAG_CLS_CODE == "3" or g_BDM_LAST_STAG_CLS_CODE == 3 then
		strRegStagNm = "본인계좌 인증"
	ElseIf g_BDM_LAST_STAG_CLS_CODE == "4" or g_BDM_LAST_STAG_CLS_CODE == 4 then
		strRegStagNm = "본인계좌 인증"		
	Else
		strRegStagNm = "개설실패?"
	end If	
	grid0.SetCellData( "aplt_date"	, 0, strRegStagNm	) '최초신청일
	grid0.SetCellData( "aplt_fin"	, 0, g_BDM_CLSNDATE	) '신청마감일
	grid0.SetCellData( "aplt_state"	, 0, g_BDM_PRNM		) '완료단계
End Sub


'============================================================================
Sub BtnCancel_OnClick()
	g_BDM_CLEAR_YN = "Y" 	'Y:처음부터하기 N: 이어가기
	Form.CloseForm()	
End Sub


'============================================================================
Sub BtnContinue_OnClick()
	g_BDM_CLEAR_YN = "N" 	'Y:처음부터하기 N: 이어가기
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동N 원복(부모화면에서 호출했던 상태로)
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	Form.SendReturnToParent("mbbdm86130_p2" , g_BDM_CLEAR_YN)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	imgExit_OnClick()
End Sub
'============================================================================
Sub imgBg_OnClick()
	imgExit_OnClick()
End Sub
'============================================================================
Sub imgExit_OnClick()
     g_BDM_CLEAR_YN = ""
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgExit.setMaintainingRatio("1")
End Sub

	</SCRIPT_INFO>
</ROOT>