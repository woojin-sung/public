	<SCRIPT_INFO _len="6650" _ulen="6200" >
'============================================================================
' 01. 화 면 명 : 선옵 당일/익일 증거금 익일증거금
' 02. 화면설명 : 선옵 당일/익일 증거금 익일증거금 테이블
' 03. 작    성 : 2016.01.11 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'일련번호
Dim g_nKospiNmix				'KOSPI_NMIX(현재가/입력가에 따른 가격) 
Dim g_szAccountPassword		'계좌비밀번호

Dim g_szData 					'계좌번호★일련번호★KOSPI_NMIX★비밀번호
Dim g_nCurrentValue				'현재가 임시저장


'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_nKospiNmix)

	DATAMANAGER.SetDataValue(0,"obtrf_cntg_728r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_728r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_728r", "InBlock1", "KOSPI_NMIX", 0 , g_nKospiNmix)
	if g_szAccountPassword <> "" then
		DATAMANAGER.SetDataValue(0,"obtrf_cntg_728r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
	else
		DATAMANAGER.SetDataValue(0,"obtrf_cntg_728r", "InBlock1", "ACNT_PWD", 0 , "")
	end if
	
	DATAMANAGER.RequestTranData("obtrf_cntg_728r")
End Function



'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' btnDetail_OnClick
'============================================================================
Sub btnDetail_OnClick()

	'16-03-28 YCJ 현재가 일 경우 "0" 값이 들어가야 한다고 전달 받음 - 시스팀개발팀 박영우 차장님
	if cmbExpectValue.currentindex == "0" then	'현재가 선택되있음
		g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & "0" & "★" &  g_szAccountPassword
	elseif cmbExpectValue.currentindex == "1" then	'입력가 선택되있음
		g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" &  g_nKospiNmix & "★" &  g_szAccountPassword
	end if
	
	Form.OpenFramePopup("mbtrf35066_p2" , g_szData , sPosInfo)
End Sub


'============================================================================
' cmbExpectValue_OnEditComplete - 인덱스에 따라 가격 활성화여부
'============================================================================
Sub cmbExpectValue_OnEditComplete(iIndex)

	if iIndex == 0 then	'현재가		
		edtValue.caption= g_nCurrentValue
		g_nKospiNmix = g_nCurrentValue
		edtValue.enable = false
	elseif iIndex == 1 then	'입력가
		edtValue.caption = ""
		edtValue.enable = true
	end if
	
	
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtrf_cntg_728r" then		
		if cmbExpectValue.currentindex == "0" then	'현재가 선택되있음
			g_nCurrentValue = DATAMANAGER.GetDataValue(0,"obtrf_cntg_728r", "OutBlock1", "PRPR", 0)
			g_nKospiNmix = g_nCurrentValue
		elseif cmbExpectValue.currentindex == "1" then	'입력가 선택되있음
			g_nKospiNmix = edtValue.caption
		end if
	end if
	
	if DATAMANAGER.GetDataValue(0, "obtrf_cntg_728r", "OutBlock1", "TOTAL_MGRT" , 0) <> "" then
	'위탁총액비율, 유지총액비율, 위탁현금비율, 유지현금비율
		Table0.SetCellString( 2, 1, (Math.floor(DATAMANAGER.GetDataValue(0, "obtrf_cntg_728r", "OutBlock1", "TOTAL_MGRT" , 0)*1000))/1000 )
		Table0.SetCellString( 5, 1, (Math.floor(DATAMANAGER.GetDataValue(0, "obtrf_cntg_728r", "OutBlock1", "TTAM_MNTN_RATE" , 0)*1000))/1000 )
		Table0.SetCellString( 2, 3, (Math.floor(DATAMANAGER.GetDataValue(0, "obtrf_cntg_728r", "OutBlock1", "CASH_MGRT" , 0)*1000))/1000 )
		Table0.SetCellString( 5, 3, (Math.floor(DATAMANAGER.GetDataValue(0, "obtrf_cntg_728r", "OutBlock1", "CASH_MNTN_RATE" , 0)*1000))/1000 )
	end if
	edtValue.caption = g_nKospiNmix
	
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" &  g_nKospiNmix & "★" &  g_szAccountPassword
	btnDetail.enable = true
End Sub


'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	btnDetail.enable = false
	for i=0 to 6
		Table0.SetCellString( i, 1, "" )
		Table0.SetCellString( i, 3, "" )
	next

	if sEventName == "NextDaySearch" then
		if cmbExpectValue.currentindex == "0" then	'현재가 선택되있음
			g_nKospiNmix = g_nCurrentValue
		elseif cmbExpectValue.currentindex == "1" then	'입력가 선택되있음
			g_nKospiNmix = edtValue.caption
		end if
		
		Dim szList
		szList = Split(sParam, "★")
		if UBOUND(szList) < 1 then
			exit sub
		end if
		
		g_nAccountNumber = szList(0)
		g_nAccountSerialNumber = szList(1)
		if szList(2) <> "" then
			g_szAccountPassword = szList(2)
		else
			g_szAccountPassword = ""
		end if
		
		g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" &  "0" & "★" &  g_szAccountPassword
		TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_nKospiNmix)		
	end if
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()	
	g_nKospiNmix = "000.00"
End Sub




'============================================================================
' edtValue_OnEditComplete
'============================================================================
Sub edtValue_OnEditComplete()
	g_nKospiNmix = edtValue.caption
End Sub

