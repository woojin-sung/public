						<CELL cell_ly="0,7,0,7" halign="0" line="0,0" caption="- 계좌개설 시 위탁증거금률은 100%로 신청됩니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,8,0,8" halign="0" line="0,0" caption="- 증거금률은 계좌개설 완료 후 변경 가능합니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,9,0,9" halign="0" line="0,0" caption="   (MTS 〉 MY/업무 〉 MY정보 〉 계좌관리 〉 위탁증거금 " fontsize="-1" impidxs="" />
