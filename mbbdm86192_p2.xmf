						<CELL cell_ly="0,14,0,14" halign="0" line="0,0" caption="면제기준" fontsize="-1" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,15,0,15" halign="0" line="0,0" caption="- 최초 계좌개설 고객 : 계좌개설일로부터 1년간 면제" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,16,0,16" halign="0" line="0,0" caption="- 고객 서비스 등급 GOLD 이상" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,17,0,17" halign="0" line="0,0" caption="- 펀드신규가입(이동)고객 : 설정일로부터 1년간 면제" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,18,0,18" halign="0" line="0,0" caption="- 급여 50만원 이상 입금 고객 : 익월 면제" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,19,0,19" halign="0" line="0,0" caption="   (CMA/Super365 계좌의 거래내역에 급여 또는 상여" fontsize="-1" impidxs="" />
