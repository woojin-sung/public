					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="이체 한도" fontsize="-1" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="- 계좌개설 시 이체 한도는 기본한도(1회 1억/1일 5억)" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="   로 적용됩니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="   (단, 보유하신 보안매체에 따라 적용한도는 다르게" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,4,0,4" halign="0" line="0,0" caption="   적용될 수도 있습니다.)" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,5,0,5" halign="0" line="0,0" fontsize="-1" impidxs="" />
