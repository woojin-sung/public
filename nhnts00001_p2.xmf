'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	szDeptCd = Grid0.GetCellData("bd_cell0", lRow)
	szDeptNm = Grid0.GetCellData("bd_cell1", lRow)
	
	Form.SendReturnToParent("DEPTINFO", szDeptCd & "★" & szDeptNm)
	Form.CloseForm()
End Sub

