			<TRAN tranid="obaci_nmet_007r" trcode="obaci_nmet_007r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obaci_nmet_009r" trcode="obaci_nmet_009r" compress="1" encryption="1" inputcheck="1" useattr="0" />
