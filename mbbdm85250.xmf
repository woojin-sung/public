Sub ContMain_Container1_Label1_OnClick()
	
	if bWide == false then
		bWide = true
		
		ContMain.InfoPos.top = 710
		ContMain.SetScrollAutoSize()
		ContMain.Container1.Image3.imgpath = "icon_caret_up.png"
		
		ContMain.Container1.SetHeightResize(285)
		ContMain.scroll_pos =  245
		
	else
		
		bWide = false
		ContMain.Container1.SetHeightResize(40)
		ContMain.InfoPos.top = 0
		ContMain.scroll_pos = 0
		ContMain.Container1.Image3.imgpath = "icon_caret_down.png"
		
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		'ContMain.SetScrollAutoSize()
		
	end if
end Sub

Sub ContMain_Container1_Image1_OnClick()
	ContMain_Container1_Label1_OnClick()
End SUb

Sub ContMain_Container1_Image3_OnClick()
	ContMain_Container1_Label1_OnClick()
End SUb

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" or sTimerID == 9999 then
		Form.SetTimerEvent2("9999", 0, 0.5)
		ContMain.SetScrollAutoSize()
	end if
End Sub

