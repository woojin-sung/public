'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	dim	szList
	dim  szLinkData
	
	if sEventName = "OPENACC_MAIN" then
		if	InStr(sParam, "★") > 0	then
				szList	= split (sParam, "★")
				fmtab01.currenttab = szList(0)
				szLinkData = szList(1)
				
				Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "CMASECT", szLinkData)
		else
			fmtab01.currenttab = sParam
		end if
		
		'Call SetScreenName()	'2016-04-18 ESKIM : 화면타이틀 변경 요청(채화석 차장님)
	end if 
End Sub


