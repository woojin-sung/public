Sub Form_OnFormInitBefore()
	Dim bChkValue
	bChkValue = Form.LoadConfigData("mbtrs15010", "ChkView")
	
End Sub


'============================================================================
Sub Form_OnFormInit()
	chkGrid.checkstate = bChkValue	
	chkGrid_OnChange( bChkValue )	
	btnSearch_OnClick()
End Sub

