Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcNo, szAsNo 
	
	szAcNo  = acnt0.total
	szAsNo  = acnt0.sequence

	If szTranID = "obtrs_cntg_532r" Then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r", "InBlock1", "ACNO" , 0 , szAcNo )
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r", "InBlock1", "ASNO" , 0 , szAsNo )
	
	ElseIf szTranID = "obtrs_cntg_532r_1" Then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r_1", "InBlock1", "ACNO" , 0 , szAcNo )
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r_1", "InBlock1", "ASNO" , 0 , szAsNo )
		
	End If

	
End Sub



'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs15010", "ChkView", chkGrid.checkstate )
End Sub


'============================================================================
Sub chkGrid_OnChange(sCheckState)
	If sCheckState = "1" Then
		grd1.visible = true
		grd2.visible = false
	Else
		grd1.visible = false
		grd2.visible = true
	End If
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrs_cntg_532r"   )
'	DATAMANAGER.RequestTranData( "obtrs_cntg_532r_1" )
	
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	
	szData = cld0.caption & "|" & chkGrid.checkstate

	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrs15010_h0" , szData , "" )
		
	ElseIf sEventName = "SCREEN_MENU" Then
		
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "", "")
		end if
		
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbtrs15010" Then
		Dim arrData
	
		arrData = Split(sRet,"|")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if
		
		cld0.caption = arrData(0)
		chkGrid.checkstate = CInt( arrData(1) )
		chkGrid_OnChange( arrData(1) )
		
		If acnt0.caption <>  arrData(2) Then
			acnt0.caption = arrData(2)
		End If
		
		btnSearch_OnClick()
		
	ElseIf sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
			
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert( szErrCode , szErrMsg )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtrs_cntg_532r" Then
		DATAMANAGER.RequestTranData( "obtrs_cntg_532r_1" )
	End If
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

