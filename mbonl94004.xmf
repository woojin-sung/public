'--===========================================================================
' 01. 화 면 명 : 장외파생상품 거래요건 등록 신청
' 02. 화면설명 : 메인화면
' 03. 작    성 : 
' 04. 수    정 : 
' 2022.04.13 : v0001 : KSJ : 신분증 등록 및 진위확인 개선
' 2023.11.21 : v0002 : 전상일 : 모바일신분증 추가
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nStep '현재 스텝
Dim g_szApplyAbleYN '신청 가능YN
Dim g_szSRNO 	'신분증 진위 확인 후, 받은 일련번호

Dim g_szVCALL_TRGT_YN	'영상통화대상여부
Dim g_ErrMsgText	'에러 메시지 출력

Dim g_CERT_METHOD
Dim szUserName, szJumin, szBirth 'v0002 모바일신분증 비교를 위해 전역변수로 변경
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_ChangeBtnState() : 각각 체크해야할 버튼 확인하여 다음 버튼 활성화/비활성화
'============================================================================
Function f_ChangeBtnState(sEnable)
	btnRetry.visible = false
	btnNextHalf.visible = false
	btnNext.visible = true

	if tonumber(sEnable) == 1 or sEnable == true then		
		btnNext.enable = true
		btnNext.btnimage = "btn_20.9"
		btnNext.fgcolor = "273"
	else
		btnNext.btnimage = "btn_15.9"
		btnNext.enable = false
	end if
End Function

'============================================================================
' f_SetNextStep() : 단계에 맞는 링크폼 세팅 및 버튼 세팅
'============================================================================
Function f_SetNextStep()
	if g_nStep == 0 then
		LinkForm0.linkfile = "mbonl94004_s0"
		btnNext.caption = "다음"
		f_ChangeBtnState(true)
		
	elseif g_nStep == 1 then
		LinkForm0.linkfile = "mbonl94004_s1"
		btnNext.caption = "등록신청"
		f_ChangeBtnState(false)	'
		
	elseif g_nStep == 2 then
		Form.triggerEvent("LinkForm0", "change_step2", "")
		
		LinkForm0.linkfile = "mbonl94004_s2"
		btnNext.caption = "다음"
		f_ChangeBtnState(false)
		
	elseif g_nStep == 3 then
		LinkForm0.linkfile = "mbonl94002_s2"
		btnNext.caption = "다음"
		
		f_ChangeBtnState(false)
		
'		f_ChangeBtnState(true) 'v0001	
		
	'v0001 STA
	elseif g_nStep == 31 then
		LinkForm0.linkfile = "mbonl94002_s21"
		
		btnRetry.visible = true
		btnNextHalf.visible = true
		btnNext.visible = false
		
		btnNextHalf.enable = true
		btnNextHalf.btnimage = "btn_20.9"
		btnNextHalf.fgcolor = "273"
	'v0001 FIN
	
	end if
	
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
End Function

'============================================================================
' f_SetPrevStep() : 이전 화면으로 이동
'============================================================================
Function f_SetPrevStep()		

	if g_nStep = 0 then
		Form.MsgBox("알림", "신청을 종료하시겠습니까?", "Close_Form", 2)
	else
		if g_nStep = 1 then
			g_nStep = 0
			
			'임시저장된 내역 삭제 시작 (권오상차장 요청)
			Dim szAccount
			szAccount = Account0.caption			
			if szAccount <> "" and szAccount <> NULL then
				'신청일련번호 있는 경우에만 취소 처리
				if Trim(Form.GetSharedData("124a_Aplt_Srno")) <> "" and Form.GetSharedData("124a_Aplt_Srno") <> NULL then
					DATAMANAGER.RequestTranData( "obcsb_acif_124a_1" )
				end if
			end if
			'임시저장된 내역 삭제 끝!
			
			LinkForm0.linkfile = "mbonl94004_s0"
			btnNext.caption = "다음"
			f_ChangeBtnState(true)
			
		elseif g_nStep == 2 then
			g_nStep = 1
			
			LinkForm0.linkfile = "mbonl94004_s1"
			btnNext.caption = "다음"
			f_ChangeBtnState(true)
			
			Form.triggerEvent("LinkForm0", "PREV_STEP", "mbonl94004_s1")
			
		elseif g_nStep == 3 then
			g_nStep = 2
			LinkForm0.linkfile = "mbonl94004_s2"
			btnNext.caption = "다음"
			f_ChangeBtnState(true)
			
			Form.triggerEvent("LinkForm0", "PREV_STEP", "")
			
		elseif g_nStep == 31 then
			g_nStep = 3
			LinkForm0.linkfile = "mbonl94002_s2"
			btnNext.caption = "다음"
			f_ChangeBtnState(false)
		end if
		
'		Form.triggerEvent("LinkForm0", "PREV_STEP", "")
	end if
End Function

'============================================================================
Function f_GetMobileData()
	g_NAME		    = Form.GetSharedData("&RET_MOBILEID_NAME", 0)				'이름
	g_RCNO 		    = Form.GetSharedData("&RET_MOBILEID_IHIDNUM", 0 )			'암호화된 실명확인번호
	g_ISSU_DATE	    = Form.GetSharedData("&RET_MOBILEID_ISSUDE", 0)			'발급일자
	g_BIRTH		    = Form.GetSharedData("&RET_MOBILEID_BIRTH", 0)			'생년월일
	
	ImgMskData 	    = Form.GetSharedData("&RET_MOBILEID_IMAGE_MASK" , 0)		'주민번호 마스킹이미지 
	
	''20231207 jsi 수정: 이미지 처리 안함---------------------------------------------
	g_ImgData  	    = Form.GetSharedData("&RET_MOBILEID_IMAGE", 0)			'주민번호 마스킹없는이미지
	g_ImgFace	    = ""'Form.GetSharedData("&RET_MOBILEID_IMAGE_FACE", 0)			'얼굴 이미지
	'20231207 jsi 수정: 이미지 처리 안함---------------------------------------------
	if ImgMskData <> "" and g_ImgData <> "" then
		g_ImgDataLen 	= Len(g_ImgData)
	end if
	if g_ImgFace <> "" and g_ImgFace <> "" then
		g_ImgFaceLen 	= Len(g_ImgFace)
	end if
	
	g_LISENCE_NUM   = Form.GetSharedData("&RET_MOBILEID_DLNO"	, 0 ) 	'신분증번호
	
	g_RCNO_7		  = Form.GetSharedData("&RET_MOBILEID_IHIDNUM7"	, 0 ) 	'실명확인번호 뒷 7자리
End Function


''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	Form.SetSharedData( "mbonl94004_USER_NAME" , "")
	Form.SetSharedData( "mbonl94004_USER_BIRTH" , "")
	Form.SetSharedData( "mbonl94004_s1_CHECK_SUMMARY" , "")
	Form.SetSharedData( "mbonl94004_s1_CHECK_DETAIL" , "")

	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	g_CERT_METHOD = ""
	Form.SetSharedData("mbonl_SCREEN_NO", "94004")
	
	g_nStep = 0
	f_SetNextStep()

End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "BTN_NEXT_ENABLE_STATE" then
		f_ChangeBtnState(sParam)
	
	'v0001 STA 
	'신분증 촬영 완료되었을때 ( 링크폼에 트리거 전달, 링크폼에서 열어도 부모화면으로 트리거 들어옴 )
	elseif sEventName == "OCRCOMPLETE" then
		g_nStep = 31
		f_SetNextStep()

	'mbbdm85122화면에서 다시 촬영하기 눌렀을때 mbonl94004_s21화면 popupreturn에서 부모화면으로 트리거 전달 
	elseif sEventName == "RETRY" then
'''		g_nStep = 31
		btnNextHalf.enable = true
		btnNextHalf.btnimage = "btn_20.9"
		btnNextHalf.fgcolor = "273"
	
		f_SetPrevStep()
		Form.triggerEvent("LinkForm0", "START_CAMERA", "")
	'v0001 FIN
	
	elseif sEventName == "ENABLE_NEXTHALF" then
		btnNextHalf.enable = true
		btnNextHalf.btnimage = "btn_20.9"
		btnNextHalf.fgcolor = "273"
	
	elseif sEventName == "COMPLETE_SUBMIT" then
		Form.CloseForm()
		
	elseif sEventName == "COMPLETE_TRUE_AND_FALSE" then
		g_szSRNO = sParam
				
		'v0001 STA
		'20220518 KSJ 인증서확인 로직 추가 > 인증완료후 신청 서비스 호출
		Dim szCertUseType 
		'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
		
		If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
		    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		Else
		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		End If
		'v0001 FIN
		
	
	elseif sEventName == "UPDATE_APLT_ABLE_YN" then
		g_szApplyAbleYN = sParam
	
	'모바일신분증 관련 추가 start
	elseif sEventName == "CERT_METHOD" then
		g_CERT_METHOD = sParam
		
		if g_CERT_METHOD <> "" and g_CERT_METHOD <> null then
			f_ChangeBtnState(true)
		else
			f_ChangeBtnState(false)
		end if
	
	elseif sEventName == "MOBILEID_OPEN_COMPLETE" then
		Dim szCode, szMsg
		szCode = Form.GetSharedData("&RET_MOBILEID_TRXCODE", false)
		szMsg = Form.GetSharedData("&RET_MOBILEID_M200", false)
		
		'모바일 신분증 앱 실행
		Dim szRunApp
		szRunApp = Form.runMobileIDApp(szMsg)
'		Form.ShowAlert("szRunApp", szRunApp)
		
		if szRunApp == "-1" then
			Form.MsgBox("안내", "행정안전부의 '모바일신분증' 앱이 설치되어 있지 않습니다.\n앱 설치 후 다시 진행해 주세요.", "NO_MOBILEID_APP", 6)
		end if
	
	elseif sEventName == "MOBILEID_APP_RETURN" and sParam <> "" and sParam <> null then
		
		Form.requestMobileID("MOBILEID_STATUS", "", "")
		
	elseif sEventName == "MOBILEID_STATUS_COMPLETE" then
		Dim szStepCode, szResultCode
		szStepCode = Form.GetSharedData("&RET_MOBILEID_STEPCODE", false)
		szResultCode = Form.GetSharedData("&RET_MOBILEID_RESULTCODE", false)
		
		if szStepCode == "VP_VERIFY" and szResultCode == "0" then
			Form.requestMobileID("MOBILEID_RESULT", "", "")
		else
			if szResultCode = "0" then 
				'중복으로 떨어지는 경우가 있어 예외처리
			elseif szResultCode = "-1" then
				Form.ShowAlert("안내", "행정안전부의 '모바일신분증' 앱이 설치되어 있지 않습니다.\n앱 설치 후 다시 진행해 주세요.")
			elseif szResultCode = "20202" then  '유효시간 초과
				Form.ShowAlert("안내", "모바일 운전면허증 인증시간이 초과되었습니다.\n다시 시도해 주세요.")
			elseif szResultCode = "20301" or szResultCode = "20302" then '유효한 모바일신분증 아닐 경우
				Form.ShowAlert("안내", "모바일 운전면허증 정보 가져오기를 실패하였습니다.\n확인 후 다시 진행해 주세요.")
			elseif szResultCode = "20901" then '사용자에 의한 취소
				Form.ShowAlert("안내", "모바일 운전면허증 인증을 취소하였습니다.")
			else	'기타 오류 전부
				Form.ShowAlert("안내", "모바일 운전면허증 정보 가져오기를 실패하였습니다.\n확인 후 다시 시도해 주세요.")
			end if
			
			f_ChangeBtnState(true)
			
'			btnNext.enable = true
'					
'			btnNext.btnimage = "btn_20.9"
'			btnNext.fgcolor = "273"
		end if
	
	elseif sEventName == "MOBILEID_RESULT_COMPLETE" then
		Form.requestMobileID("MOBILEID_IMAGES", "", "")
	
	elseif sEventName == "MOBILEID_IMAGES_COMPLETE" then
		Form.requestMobileID("MOBILEID_IMAGES_MASK", "", "")
	
	elseif sEventName == "MOBILEID_IMAGES_MASK_COMPLETE" then
		Form.requestMobileID("MOBILEID_IMAGES_FACE", "", "")
	
	elseif sEventName == "MOBILEID_IMAGES_FACE_COMPLETE" then
		
		f_GetMobileData()
		
		'v0002
		if szUserName <> g_NAME or szBirth <> Right(g_BIRTH,6)	then
			Form.ShowAlert("안내", "본인 정보와 모바일신분증의 정보가 일치하지 않습니다.")
			exit sub
		end if 
		
		if g_FACE_YN == "Y" then
			'업무신청 화면들의 안면인식 단계는 추후 추가
		else
			DATAMANAGER.RequestTranData( "obaci_acct_158a" )
		end if	
		
	elseif sEventName == "MOBILEID_OPEN_ERROR" or sEventName == "MOBILEID_STATUS_ERROR" or sEventName == "MOBILEID_RESULT_ERROR" or sEventName == "MOBILEID_IMAGE_ERROR" then
		
		Dim szRspCode, szErrCode, szErrMsg
		szRspCode = Form.GetSharedData("&RET_MOBILEID_RESPONSE_CODE", false)
		szErrCode = Form.GetSharedData("&RET_MOBILEID_ERROR", false)
		szErrMsg = Form.GetSharedData("&RET_MOBILEID_ERROR_DESCRIPTION", false)
		'Form.ShowAlert("jsi ERROR sEventName", sEventName)
		'Form.ShowAlert("jsi ERROR szRspCode", szRspCode)
		'Form.ShowAlert("jsi ERROR szErrCode", szErrCode)
		'Form.ShowAlert("jsi ERROR szErrMsg", szErrMsg)
		'complete으로 떨어지지만 혹시 몰라 남겨둠
		if szErrCode = "0" then 
				'중복으로 떨어지는 경우가 있어 예외처리
		elseif szErrCode = "-1" then
			Form.ShowAlert("안내", "행정안전부의 '모바일신분증' 앱이 설치되어 있지 않습니다.\n앱 설치 후 다시 진행해 주세요.")
		elseif szErrCode = "20202" then '유효시간 초과
			Form.ShowAlert("안내", "모바일 운전면허증 인증시간이 초과되었습니다.\n다시 시도해 주세요.")
		elseif szErrCode = "20301" or szErrCode = "20302" then  '유효한 모바일신분증 아닐 경우	
			Form.ShowAlert("안내", "모바일 운전면허증 정보 가져오기를 실패하였습니다.\n확인 후 다시 진행해 주세요.")
		elseif szErrCode = "20901" then '사용자에 의한 취소 
			Form.ShowAlert("안내", "모바일 운전면허증 인증을 취소하였습니다.")
		else	 '기타 오류 전부
			Form.ShowAlert("안내", "모바일 운전면허증 정보 가져오기를 실패하였습니다.\n확인 후 다시 시도해 주세요.")
		end if
		
		f_ChangeBtnState(true)
		
'		btnNext.enable = true
'				
'		btnNext.btnimage = "btn_20.9"
'		btnNext.fgcolor = "273"	
		
	else
		'Form.ShowAlert("jsi" , sEventName)
'		btnNext.enable = true
'				
'		btnNext.btnimage = "btn_20.9"
'		btnNext.fgcolor = "273"	
'		
''		f_ChangeBtnState(true)
	end if
	'모바일신분증 관련 추가 end
End Sub

'============================================================================
' Form_OnMsgBoxClose(sKeyName, sRet)
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Go_Next" then
		if sRet == "ok" then
			g_nStep = 1
			f_SetNextStep()		
		else
			Exit Sub
		end if
		
	elseif sKeyName == "Close_Form" then
		if sRet == "ok" then
			Form.CloseForm()
		end if
		
	elseif sKeyName == "Go_Login" then		
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021", "", "")
		else
			Form.CloseForm()
		end if
	
	elseif sKeyName == "MOBILE_CERT_COMPLETE" then
		'v0001 STA
		'20220518 KSJ 인증서확인 로직 추가 > 인증완료후 신청 서비스 호출
		Dim szCertUseType 
		'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
		
		If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
		    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		Else
		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		End If
		'v0001 FIN
	
	elseif sKeyName == "MOVE_STORE" and sRet <> "" and sRet <> null then
		if sRet <> "ok" then
			Dim szOsType
			szOsType = Form.GetSharedData("&OS_TYPE", false )
			if szOsType == "1" then
				Form.runStoreApp("", "market://details?id=com.imeritz.smartmeritz")
			elseif szOsType == "2" then
				Form.OpenAppStore("1104272974")
			end if
		else
			f_ChangeBtnState(true)
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "close_mbonl94004_p1" then
		g_nStep = 2
		f_SetNextStep()
		
	'20220518 KSJ 인증후 신청TR 호출
	'==[인증팝업]==
	'공동인증및바이오인증
	Elseif sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" Then
			DATAMANAGER.RequestTranData( "obcsb_acif_124a" )
		End If
	'간편인증전용
	ElseIf sKeyName == "mhetc90060_px" Then 
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData( "obcsb_acif_124a" )
		End If	
	
	'공통팝업(mbonl94004_p4)
	elseIf sKeyName == "errMsgBox"  Then 
		if sRet = "Left" then				
			'장외파생상품 거래요건 등록내역 화면 연결
			Form.OpenScreen("94005")
		end if	
	
	'등록완료팝업
	elseif sKeyName == "close_mbonl94004_p2" then
		Form.CloseForm()
	
	elseif sKeyName == "close_mbonl94004_p3" then
		' 업무신청 중단할 경우, 메뉴 닫기
		if sRet == "return_to_start" then
'			Form.CloseForm()	'현재화면 유지로 요건 변경 (박효정과장 요청)
		
		'등록신청 화면으로 이동
		elseif sRet == "Go_Next" then
			g_nStep = 1
			f_SetNextStep()
		
		elseif sRet == "continue_next_step" then
			DATAMANAGER.RequestTranData( "obcsb_acif_124a" )
		
		elseif sRet == "return_to_quit" then
			Form.CloseForm()
			Form.OpenScreen("94005" , "")		'투자요건 등록내역 화면으로 이동	
		end if
	end if
End Sub

'============================================================================
' Form_OnFormBackKeyPressed() : 이전 스텝으로 이동
'============================================================================
Sub Form_OnFormBackKeyPressed()	
	f_SetPrevStep()
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData( "mbonl94004_USER_NAME" , "")
	Form.SetSharedData( "mbonl94004_USER_BIRTH" , "")
	Form.SetSharedData( "mbonl94004_s1_CHECK_SUMMARY" , "")
	Form.SetSharedData( "mbonl94004_s1_CHECK_DETAIL" , "")
	
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	If sKey == "&LOGIN_AUTH" Then
		Account0.ReloadAccount()
	end if
End Sub

'============================================================================
' btnBack_OnClick() : 이전 스텝으로 이동
'============================================================================
Sub btnBack_OnClick()
	f_SetPrevStep()
End Sub

'============================================================================
' btnNext_OnClick() : 스텝 이동
'============================================================================
Sub btnNext_OnClick()
	if g_nStep == 0 then
		Dim sLOGIN_TYPE
		sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false)
		
		if sLOGIN_TYPE = "1" then
			Form.MsgBox("알림", "로그인이 필요한 메뉴입니다.\n로그인하시겠습니까?", "Go_Login", 1)
			Exit Sub
		else
			if Trim(Account0.caption) <> "" and Trim(Account0.caption) <> NULL then
				DATAMANAGER.RequestTranData( "obacp_opop_064r" )
			end if
			
		end if
				
	elseif g_nStep == 1 then	
		Form.openPopupAnimation("mbonl94004_p1", "", "", "2")

	elseif g_nStep == 2 then
		g_nStep = 3
		f_SetNextStep()
		
	elseif g_nStep == 3 then
		'모바일신분증 추가
		Form.SetSharedData("CERT_METHOD_TYPE" , g_CERT_METHOD)
		
		DATAMANAGER.SetDataValue( 0, "obcsb_face_004r" , "InBlock1" , "IDNTF_KIND_CODE" , 0 , "M")
		DATAMANAGER.RequestTranData( "obcsb_face_004r" )
		
'		Form.triggerEvent("LinkForm0", "START_CAMERA", "")

	end if
End Sub

'============================================================================
' btnNext_OnClick() : 스텝 이동
'============================================================================
Sub btnNextHalf_OnClick()
	btnNextHalf.enable = false
	btnNextHalf.btnimage = "btn_27.9"
	btnNextHalf.fgcolor = "269"
	
	Form.triggerEvent("LinkForm0", "JUDGE_TRUE_AND_FALSE", "")
End Sub

'============================================================================
'  btnRetry_OnClick() : 재촬영
'============================================================================
Sub btnRetry_OnClick()
	'v0001 STA
	g_nStep = 31
	f_SetPrevStep()
	Form.triggerEvent("LinkForm0", "START_CAMERA", "")
	'v0001 FIN
End Sub


