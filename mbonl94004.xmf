		<IMAGE name="imgBack" autosize="1" imgpath="icon_top_back_light" ly_vert="21,14,24,24,1" />
		<BUTTON name="btnBack" btnimage="alpha" ly_vert="13,5,40,40,1" />
		<BUTTON name="btnRetry" caption="재촬영" fgcolor="267:255255255" fontsize="4" btnimage="btn_27.9" ly_vert="0,587,189,60,1" />
		<BUTTON name="btnNextHalf" caption="다음" fontsize="4" btnimage="btn_20.9" ly_vert="185,587,190,60,1" />
		<ACCOUNT name="Account0" visible="0" bgcolor="052:255255255" itemcodetype="100,101,102,103,104,105,106,107,108,109,110,112,113,114,115,117,118,119,120,121,123,124,125,126,127,128,129,130,131,132,133,135,136,137,138,139,140,200" etcfunctions="" ly_vert="100,79,200,32,0" />
