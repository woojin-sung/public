'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 인풋 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum, szHostDate, szAccount
	
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	szHostDate = Form.GetSharedData("&HOST_DATE",0)
	szAccount = Account0.caption

	if szTranID == "obcsb_acif_123r" then	'장외파생투자요건 상태조회
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "0"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )

	elseif szTranID == "obcsb_acif_124a" then	'장외파생투자요건 등록
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_APLT_STCD" , 0 , "0"  )	'0:등록/9:취소
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "VCALL_TRGT_YN" , 0 , g_szVCALL_TRGT_YN )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE" , 0 , szHostDate  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IDNTF_SRNO" , 0 , g_szSRNO  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CRIN_AGRM_YN" , 0 , "Y"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PXPR_YN" , 0 , "N"  )
		
	elseif szTranID == "obcsb_acif_124a_1" then	'장외파생투자요건 등록 취소
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_APLT_STCD" , 0 , "9"  )	'0:등록/9:취소/F:강제취소
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_CNCL_CLCD" , 0 , "Z"  )	'Z:자동취소
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "VCALL_TRGT_YN" , 0 , g_szVCALL_TRGT_YN )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE" , 0 , szHostDate )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_SRNO" , 0 , Trim(Form.GetSharedData("124a_Aplt_Srno"))  )
	
	elseif szTranID == "obacp_opop_064r" then		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0, szAccount )
	
	'모바일신분증 관련 추가 start
	elseif szTranID == "obaci_acct_158a" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"		, 0 	, g_ImgDataLen			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IMG_DATA"		, 0 	, g_ImgData		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "3" 	 			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"		, 0 	, g_RCNO 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BRDT"				, 0 	, Right(g_BIRTH,6)			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_RCNO_7	 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 	, "I" 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SRNO"				, 0 	, ""	 				)
	
	elseif szTranID == "obaci_acct_158a_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"		, 0 	, g_ImgFaceLen			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IMG_DATA"		, 0 	, g_ImgFace		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, "3" 	 			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"		, 0 	, g_MDAF_RCNO_PIP 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BRDT"				, 0 	, Right(g_BIRTH,6)			)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_RCNO_7	 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 	, "U" 				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SRNO"				, 0 	, g_szSRNO	 				)
	
	elseif szTranID == "obcsb_nmet_102c" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NMET_BSWR_CLCD" 		, 0 , "010"					)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO" 		, 0 , Form.GetSharedData( "&HOST_DATE", False ) & "D0000"	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_CLS_CODE"		, 0 , "2"					)	'2.신분증진위확인
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_szOTSDTRUNIQNO			)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "TR_DATE"				, 0 , Form.GetSharedData( "&HOST_DATE", False )				)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_SRNO"			, 0 , g_szSRNO		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"		, 0 , "0"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_TORF_YN"		, 0 , "Y"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , 1			)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "RCNO_PIP"	, 0 , g_MDAF_RCNO_PIP		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_KIND_CODE"	, 0 , "3"		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_FLNM"	, 0 , g_NAME		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_RCNO_PIP"	, 0 , g_RCNO		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_IDNTF_FLNM"	, 0 , g_NAME		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ISNC_DATE"	, 0 , g_ISSU_DATE		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_ISNC_DATE"	, 0 , g_ISSU_DATE 		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OLD_DRVN_LCNS_NO"	, 0 , ""		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "ORGL_OLD_DRVN_LCNS_NO"	, 0 , ""		)
	
	'모바일신분증 관련 추가 end
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_123r" then
		Dim szAlertData, szTitle, szTempDate
		szTitle = "알림"
		szTempDate = ""
		
		
		g_ErrMsgText = ""		
		g_szVCALL_TRGT_YN = ""
		
		szAPLT_ABLE_YN = ""
		szAPLT_PRHB_REAS = ""
		szAPLT_AVLE_STA_DATE = ""
		szHOUR_CHCK_YN = ""
		
		g_szVCALL_TRGT_YN 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock4" , "VCALL_TRGT_YN" , 0 )		'영상통화대상여부
		Form.SetSharedData("mbonl94004_VCALL_TRGT_YN", g_szVCALL_TRGT_YN)
		
		szAPLT_ABLE_YN 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock4" , "APLT_ABLE_YN" , 0 )		'신청가능여부
		szAPLT_PRHB_REAS 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock4" , "APLT_PRHB_REAS" , 0 )	'신청불가사유
		szAPLT_AVLE_STA_DATE	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock4" , "APLT_ABLE_STA_DATE" , 0 )	'신청가능시작일자
		szHOUR_CHCK_YN		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock4" , "HOUR_CHCK_YN" , 0 )		'시간체크여부
		
'	Form.ShowAlert("확인", g_szVCALL_TRGT_YN)
'g_szVCALL_TRGT_YN = "Y"
'Form.SetSharedData("mbonl94004_VCALL_TRGT_YN", g_szVCALL_TRGT_YN)
		
		if szHOUR_CHCK_YN = "Y" then
			g_ErrMsgText = "신청 가능 시간이 아닙니다.$(영업일 08:00~16:00까지 신청 가능)"
			szAlertData = "1".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."확인"
			
			Form.OpenPopup("mbonl94004_p4", szAlertData, "")
			Exit Sub
		
		elseif szAPLT_ABLE_YN = "X" then	'알림 팝업 버튼 2개로
			if CInt(szAPLT_AVLE_STA_DATE) > Cint(Form.GetSharedData("&HOST_DATE",0)) then
				
				szTempDate = Left(Int(szAPLT_AVLE_STA_DATE), 4) .. "." .. Mid(Int(szAPLT_AVLE_STA_DATE),5,2) .."." ..Right(Int(szAPLT_AVLE_STA_DATE),2)
				g_ErrMsgText = "유효기간 만료일 3개월 전 부터$재등록 신청이 가능합니다.$(" .. szTempDate .." 이후 신청가능)"				
				szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."등록내역 확인".."★".."확인"
				
				Form.OpenPopup("mbonl94004_p4", szAlertData, "")
				Exit Sub
			else
				g_ErrMsgText = szAPLT_PRHB_REAS
				szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."등록내역 확인".."★".."확인"
				
				Form.OpenPopup("mbonl94004_p4", szAlertData, "")
				Exit Sub
			end if
		
		elseif szAPLT_ABLE_YN = "N" then	''알림 팝업 버튼 1개로
			g_ErrMsgText = szAPLT_PRHB_REAS
			szAlertData = "1".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."확인"
			
			Form.OpenPopup("mbonl94004_p4", szAlertData, "")
			Exit Sub
		
		elseif szAPLT_ABLE_YN = "Y" then	'등록신청 가능 상태
			'영상통화대상여부 안내 팝업은 텍스트 컬러적용 때문에 별도 화면으로 호출함
			Form.OpenPopup("mbonl94004_p3" , g_szVCALL_TRGT_YN , "2")
			Exit Sub
		
		end if

		
	elseif szTranID == "obcsb_acif_124a" then	'장외파생투자요건 등록
		'신청완료팝업 오픈
		Form.OpenPopup("mbonl94004_p2" , "REG_SUCCESS" , "")
		
	elseif szTranID == "obcsb_acif_124a_1" then	'장외파생투자요건 등록 취소
	
	
	elseif szTranID == "obacp_opop_064r" then
		'Dim szUserName, szJumin, szBirth'v0002
		szJumin = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "RCNO" , 0 ) '실명확인번호
		
		szUserName = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "CSNM" , 0 ) '고객명
		szBirth = Left(szJumin, 6)

		Form.SetSharedData( "mbonl94004_USER_NAME" , szUserName)
		Form.SetSharedData( "mbonl94004_USER_BIRTH" , szBirth)

		DATAMANAGER.RequestTranData( "obcsb_acif_123r" )
	
	'모바일신분증 추가 start
	elseif szTranID == "obcsb_face_004r" then
		Dim szFaceYn
		szFaceYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FACEID_ACMP_YN" , 0 )
		
		'모바일신분증은 안면인식 처리 안함 추후 수정..
		szFaceYn = "N"
		
		g_FACE_YN = szFaceYn
		
		if g_CERT_METHOD == "1" then
			Form.triggerEvent("LinkForm0", "START_CAMERA", "")
		elseif g_CERT_METHOD == "2" then
			'20231204 모바일 신분증 진행 시 앱버전 체크
			Dim szAppVer, szOSType, nAppVer
			szAppVer = Form.GetSharedData("&APP_VERSION", false)
			szOSType = Form.GetSharedData("&OS_TYPE", false)
			nAppVer = replace(szAppVer, ".", "")
			
			if szOSType == "1" then
				if CInt(nAppVer) > 238 then
					f_ChangeBtnState(false)
					
					Form.requestMobileID("MOBILEID_OPEN", "", "")
				else
					Form.MsgBox("안내", "해당 버전에서는 모바일신분증 이용이 불가합니다. 앱 업데이트 후 이용해주세요.", "MOVE_STORE", 7, "확인", "업데이트 하러가기")
				end if
			else
				if CInt(nAppVer) > 2536 then
					f_ChangeBtnState(false)
					
					Form.requestMobileID("MOBILEID_OPEN", "", "")
				else
					Form.MsgBox("안내", "해당 버전에서는 모바일신분증 이용이 불가합니다. 앱 업데이트 후 이용해주세요.", "MOVE_STORE", 7, "확인", "업데이트 하러가기")
				end if
			end if
			
'			Form.requestMobileID("MOBILEID_OPEN", "", "")
		end if
		
	elseif szTranID == "obaci_acct_158a" then
		g_szSRNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SRNO" , 0 )
		g_MDAF_RCNO_PIP = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "MDAF_RCNO_PIP" , 0 )
	'20231207 jsi obaci_acct_158a_1 호출 안함---------------------------------------------------------
	'	DATAMANAGER.RequestTranData( "obaci_acct_158a_1" )
		
	'elseif szTranID == "obaci_acct_158a_1" then
'		Form.ShowAlert(szTranID, "호출완료")
	'20231207 jsi obaci_acct_158a_1 호출 안함---------------------------------------------------------	
		DATAMANAGER.RequestTranData( "obcsb_nmet_102c" )
	
	elseif szTranID == "obcsb_nmet_102c" then
		Form.MsgBox("안내", "모바일 운전면허증을 통한\n본인인증이 완료되었습니다.", "MOBILE_CERT_COMPLETE", 6)
		
'		'v0001 STA
'		'20220518 KSJ 인증서확인 로직 추가 > 인증완료후 신청 서비스 호출
'		Dim szCertUseType 
'		'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
'		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
'		
'		If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
'		    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
'		Else
'		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
'		End If
'		'v0001 FIN
	
	'모바일신분증 추가 end

	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szTranID == "obcsb_acif_123r" then
		Dim szErrorMsg
		szErrorMsg = szErrMsg & "(" & szSubMsg & ")"
	
		if szErrCode = "9501" then	'법인계좌		
			Dim szAlertData, szTitle
			szTitle = "알림"
			g_ErrMsgText = ""
			g_ErrMsgText = "개인전문투자자만 신청 가능합니다."		
			g_ErrMsgText = Replace(g_ErrMsgText, "$", "\n")	
		
			Form.ShowAlert("알림", g_ErrMsgText)		
			Exit Sub
		else
			Form.OpenPopup("mbonl94004_p4" , szErrorMsg , "")
		end if
	
	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub

