'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : (야)선옵종합시세
' 02. 화면설명 : (야)선옵종합시세
' 03. 작    성 : 2017.04.30 LES
'-------------------------------------------------------------------------------------------
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'20210630 HWG START : ATM 실시간 하이라이트 적용
Dim g_nGIdx, g_nJisu
g_nGIdx = 0
'20210630 HWG END

' 20230628_01 KBC START : 위클리옵션(야간, 월요일) 추가
Dim	g_KOSPI200
Dim	g_K200WEEKM
Dim	g_K200WEEK

g_KOSPI200 	= 0
g_K200WEEKM	= 1
g_K200WEEK 	= 2
' 20230628_01 KBC END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 콜/풋 조회
'============================================================================
Function SetCallPutRequest()
	DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_eopt_cntg_1" )
	
	'20210630 HWG START : ATM 실시간 하이라이트 적용
	g_nGIdx = 0 '인덱스값 초기화
	g_nJisu = 0
	g_bFirst = true
	'20210630 HWG END
			
	if RadioGroupCP.currentindex == "1" then
		DATAMANAGER.RequestTranData( "ohhts_3002_003r" )	 	'콜시세조회
	elseif RadioGroupCP.currentindex == "2" then
		DATAMANAGER.RequestTranData( "ohhts_3002_003r_1" ) 	'풋시세조회
	else
		DATAMANAGER.RequestTranData( "ohhts_3002_003r" ) 		'콜시세조회
		DATAMANAGER.RequestTranData( "ohhts_3002_003r_1" ) 	'풋시세조회
	end if	
End Function

'============================================================================
' 콜/풋 선택
'============================================================================
Function SetCallPutGrid()
	Dim nCnt, nTopRow, sTranID
	nCnt = CInt(GridCP.rowcount)
	nTopRow = 0
	
	'20210630 HWG START : ATM 실시간 하이라이트 적용
	nBaseJisu = CDbl(Table0.GetCellString(0, 3))
	nMinDiff = 0
	nMinIdx = 0
	'20210630 HWG END
	
	if RadioGroupCP.currentindex == "1" then '콜
		sTranID = "ohhts_eopt_cntg"
	elseif RadioGroupCP.currentindex == "2" then '풋
		sTranID = "ohhts_eopt_cntg_1"
	end if
	
	if nCnt > 0 then
		Dim nSign, sAtm, sCode
		
		for i = 0 to nCnt-1 
			sCode = GridCP.GetCellData( "bd_code", i )
			sAtm = GridCP.GetCellData( "bd_atm", i )
			nPrc = CDbl(GridCP.GetCellData( "bd_cell0", i ))	'20210630 HWG : ATM 실시간 하이라이트 적용
			
			'그리드 실시간 자동업데이트 안되서 일단 세팅
			DATAMANAGER.SetDataValue( 1, sTranID, "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
			
			'20210630 HWG START : ATM 실시간 하이라이트 적용
			nHDiff = ABS(nBaseJisu - nPrc)
			if i = 0 then
				nMinDiff = nHDiff
			else
				if nHDiff < nMinDiff then
					nMinDiff = nHDiff
					nMinIdx = i
				end if
			end if
			
'			if sAtm == "ATM" then
'				if i > 2 then
'					nTopRow = i-3
'				end if
'				
'				GridCP.SetCellBgColor( "bd_cell0", i, "156:255253233" )
'				g_nGIdx = i	'20210630 HWG : ATM 실시간 하이라이트 적용
'			end if 
			'20210630 HWG END
		next
		
		'20210630 HWG START : ATM 실시간 하이라이트 적용
		if nMinIdx > 3 then
			nTopRow = nMinIdx-4
		end if
				
		GridCP.SetCellBgColor( "bd_cell0", nMinIdx, "156:255253233" )
		g_nGIdx =  nMinIdx
		'20210630 HWG END : ATM 실시간 하이라이트 적용
	
		if nTopRow ~= 0 then
			GridCP.toprow = nTopRow		
		end if
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
'	20220311 HSZ START 위클리 추가
	Dim nCurrentTab
	nCurrentTab = FormTab0.currenttab
'	20220311 HSZ END

	'' 아이폰에서만 사용. 스크롤을 멈추게 한다.
	Container0.GridAllC.scrollenable = "0"
	Container0.GridAllC0.scrollenable = "0"
	Container0.GridAllP.scrollenable = "0"
	'Form.SetTitleCaption("선물옵션종합시세")
	
	' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
'	20220311 HSZ START 위클리 추가
	if CInt(nCurrentTab) <> g_K200WEEK and CInt(nCurrentTab) <> g_K200WEEKM then
		DATAMANAGER.RequestTranData( "ohhts_0510_001r" ) '결제월조회
	end if
	DATAMANAGER.RequestTranData( "ohhts_3002_002r" ) '결제월조회
'	20220311 HSZ END
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	ComboYYMM.clear = true

	Container0.GridAllC.rowcount = "0"
	Container0.GridAllC0.rowcount = "0"
	Container0.GridAllP.rowcount = "0"
	GridCP.rowcount = "0"

' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
'	20220311 HSZ START 위클리 추가
	if CInt(nCurrentTab) <> g_K200WEEK and CInt(nCurrentTab) <> g_K200WEEKM then
		DATAMANAGER.RequestTranData( "ohhts_0510_001r" ) '결제월조회
	end if
	DATAMANAGER.RequestTranData( "ohhts_3002_002r" ) '결제월조회
'	20220311 HSZ END
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_0510_001r" then
	'20210223 HSZ START야간선물 제도개편
'		DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )	
		DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
'		DATAMANAGER.CancelRealData( "ohhts_cmef_cntg_1" )
		DATAMANAGER.CancelRealData( "ohhts_efut_cntg_1" )
	'20210223 HSZ END
		DATAMANAGER.CancelRealData( "ohhts_nmix_cntg")
		DATAMANAGER.CancelRealData( "ohhts_nmix_cntg_1")	'20210630 HWG : ATM 실시간 하이라이트 적용
		
		DATAMANAGER.SetDataValue( 0, "ohhts_0510_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "523" )
		
	elseif szTranID == "ohhts_3002_002r" then
'		20220311 HSZ START : 위클리옵션 추가
		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "526" )
		elseif FormTab0.currenttabpageid = "page1" then '위클리옵션
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "530" )
		' 20230628_01 KBC START : 위클리옵션(야간, 월요일) 추가
		elseif FormTab0.currenttabpageid = "page2" then '위클리옵션(월)
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "532" )			
		' 20230628_01 KBC END
		end if
'		20220311 HSZ END
		
	elseif szTranID == "ohhts_3002_004r" then
		'최근월선물
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "F" )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "CM" )
	
	'KSP200지수
	elseif szTranID == "ohhts_3050_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "F" )
		
	elseif szTranID == "ohhts_3002_003r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_ISCD2" , 0 , "" ) ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		
'		20220311 HSZ START : 위클리옵션 추가
		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EO" )
		elseif FormTab0.currenttabpageid = "page1" then '위클리옵션
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EW" )
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_ISCD2" , 0 , "WKI" ) ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		' 20230628_01 KBC START : 위클리옵션(월요일) 추가
		elseif FormTab0.currenttabpageid = "page2" then '위클리옵션(월)
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EW" )	
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_ISCD2" , 0 , "WKM" ) ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		' 20230628_01 KBC END			
		end if
'		20220311 HSZ END
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "3002" )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_ISCD" , 0 , ComboYYMM.cbkeydata )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "CO" )
	elseif szTranID == "ohhts_3002_003r_1" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_ISCD2" , 0 , "" ) ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		
'		20220311 HSZ START : 위클리옵션 추가
		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EO" )
		elseif FormTab0.currenttabpageid = "page1" then '위클리옵션
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EW" )
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_ISCD2" , 0 , "WKI" ) ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		' 20230628_01 KBC START : 위클리옵션(야간, 월요일) 추가
		elseif FormTab0.currenttabpageid = "page2" then '위클리옵션(월)
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "EW" )	
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_ISCD2" , 0 , "WKM" ) ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		' 20230628_01 KBC END				
		end if
'		20220311 HSZ END
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "3002" )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_ISCD" , 0 , ComboYYMM.cbkeydata )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r_1", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" , 0 , "PO" )
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_0510_001r" then
		Dim sISCD, sISCD1
		
		'최근월선물(주)
		sISCD = Form.GetFutureCode(0,false,true)
		sISCD1 = DATAMANAGER.GetDataValue( 0, "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD" , 0 ) 
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock1", "FID_INPUT_ISCD" , 0 , sISCD )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock2", "FID_INPUT_ISCD" , 0 , sISCD1 )
		
		'KSP200지수
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , sISCD1 )

		DATAMANAGER.RequestTranData( "ohhts_3002_004r" ) '최근월물/차근월물시세조회
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" ) 'KSP200 지수 조회
	
	elseif szTranID == "ohhts_3002_002r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_3002_002r", "OutBlock1" )
'		20220311 HSZ START : 위클리옵션 추가
		if nCnt > 0 then
			Dim sYYMM
			Dim sWeek
			
			for i = 0 to nCnt-1 
				sYYMM = DATAMANAGER.GetDataValue( 0, "ohhts_3002_002r", "OutBlock1", "FID_MTRT_YYMM" , i )
				sWeek = DATAMANAGER.GetDataValue( 0, "ohhts_3002_002r", "OutBlock1", "FID_STLM_WEEK" , i )
				nWeek = Replace(sWeek, "W", "")
				
				' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
				if FormTab0.currenttabpageid = "page1" or FormTab0.currenttabpageid = "page2" then
					ComboYYMM.cbadddatatext = sYYMM&sWeek.."`"..sYYMM&" "&nWeek&"주" '결제월콤보세팅
				else
					ComboYYMM.cbadddatatext = sYYMM.."`"..sYYMM '결제월콤보세팅
				end if
			next
'		20220311 HSZ END
			SetCallPutRequest()	
		end if
	elseif szTranID == "ohhts_3002_004r" then
		
		Dim sISCD, sISCD1, nSign, nSign1 
		
		sISCD = DATAMANAGER.GetDataValue( 0, "ohhts_3002_004r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
		sISCD1 = DATAMANAGER.GetDataValue( 0, "ohhts_3002_004r", "OutBlock2", "FID_SHRN_ISCD" , 0 )
		'20210223 HSZ START 야간선물 제도개편
'		DATAMANAGER.SetDataValue( 1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , sISCD )
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , sISCD )
'		DATAMANAGER.SetDataValue( 1, "ohhts_cmef_cntg_1", "InBlock1", "FIDR_SHRN_ISCD" , 0 , sISCD1 )
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg_1", "InBlock1", "FIDR_SHRN_ISCD" , 0 , sISCD1 )
		'20210223 HSZ END
		DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0 , "K2G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
		DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0 , "KGG01P" )	'20210630 HWG : ATM 실시간 하이라이트 적용	"KGG01P")	'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
		'20210223 HSZ START 야간선물 제도개편
'		DATAMANAGER.RequestRealData( "ohhts_cmef_cntg" ) 		'최근월물실시간조회
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" ) 		'최근월물실시간조회
'		DATAMANAGER.RequestRealData( "ohhts_cmef_cntg_1" ) 	'차근월물실시간조회
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg_1" ) 	'차근월물실시간조회
		'20210223 HSZ END
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" ) 		'KSP200실시간조회
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg_1" )	'20210630 HWG : ATM 실시간 하이라이트 적용
	
	elseif szTranID == "ohhts_3002_003r" then
		if RadioGroupCP.currentindex == "0" then
			Dim nCnt, nTopRow
			nCnt = CInt(Container0.GridAllC.rowcount)
			nTopRow = 0
			
			'20210630 HWG START : ATM 실시간 하이라이트 적용
			nBaseJisu = CDbl(Table0.GetCellString(0, 3))
			nMinDiff = 0
			nMinIdx = 0
			'20210630 HWG END
			
			if nCnt > 0 then
				
				'20210527 HWG START : 그리드 높이값 조정(스크롤 없어야함)
				Container0.GridAllP.height = CInt(40*nCnt)
				Container0.GridAllC0.height = CInt(28.2*nCnt)
				Container0.GridAllC.height = CInt(40*nCnt)
				'20210527 HWG END
				
				Dim nSign, sAtm, sCode
				
				for i = 0 to nCnt-1
				
					sCode = Container0.GridAllC.GetCellData( "bd_callcode", i )
					sAtm = Container0.GridAllC.GetCellData( "bd_callatm", i )
					nPrc = CDbl(Container0.GridAllC.GetCellData( "bd_cell2", i ))	'20210630 HWG : ATM 실시간 하이라이트 적용
					
					'그리드 실시간 자동업데이트 안되서 일단 세팅
					DATAMANAGER.SetDataValue( 1, "ohhts_eopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
					
					'20210630 HWG START : ATM 실시간 하이라이트 적용
					nHDiff = ABS(nBaseJisu - nPrc)
					if i = 0 then
						nMinDiff = nHDiff
					else
						if nHDiff < nMinDiff then
							nMinDiff = nHDiff
							nMinIdx = i
						end if
					end if
					
'					if sAtm == "ATM" then
'						if i > 2 then
'							nTopRow = i-3
'						end if
'						
'						Container0.GridAllC.SetCellBgColor( "bd_cell2", i, "156:255253233" )
'						Container0.GridAllC.SetCellBgColor( "bd_cell3", i, "156:255253233" )
'						Container0.GridAllC.SetCellBgColor( "bd_cell9", i, "156:255253233" )
'						Container0.GridAllC0.SetCellBgColor( "bd_cell2", i, "156:255253233" )
'						g_nGIdx =  i	'20210630 HWG : ATM 실시간 하이라이트 적용
'					end if 
					'20210630 HWG START : ATM 실시간 하이라이트 적용
				next
				
				Container0.SetScrollAutoSize()
				
				'20210630 HWG START : ATM 실시간 하이라이트 적용
				if nMinIdx > 2 then
					nTopRow = nMinIdx-3
				end if
						
				Container0.GridAllC.SetCellBgColor( "bd_cell2", nMinIdx, "156:255253233" )
				g_nGIdx =  nMinIdx
				
				if nTopRow ~= 0 then
					szOsType = Form.GetSharedData("&OS_TYPE", false )
					szMediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
					if szOsType = "2" then
						if szMediaType = "158" then
							Container0.scroll_pos = nTopRow* 37
						else
							Container0.scroll_pos_noAni = nTopRow* 37
						end if
					else
						Container0.scroll_pos = nTopRow* 37
					end if
				end if
				'20210630 HWG END
			else
				Container0.GridAllC.height = "0"
				Container0.GridAllC0.height = "0"
				Container0.SetScrollAutoSize()
			end if
		else
			SetCallPutGrid()
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" ) '콜실시간조회
	
	elseif szTranID == "ohhts_3002_003r_1" then
		if RadioGroupCP.currentindex == "0" then
			Dim nCnt
			nCnt = CInt(Container0.GridAllP.rowcount)
			
			if nCnt > 0 then'test
				
				Container0.GridAllP.height = CInt(40*nCnt)	'20210527 HWG START : 그리드 높이값 조정(스크롤 없어야함)
				
				Dim nSign, sCode
				
				for i = 0 to nCnt-1 
					sCode = Container0.GridAllP.GetCellData( "bd_putcode", i )
					
					'그리드 실시간 자동업데이트 안되서 일단 세팅
					DATAMANAGER.SetDataValue( 1, "ohhts_eopt_cntg_1", "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
				next
			else
				Container0.GridAllP.height = "0"
			end if
		else
			SetCallPutGrid()
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_eopt_cntg_1" ) '풋실시간조회
	end if
End Sub

'============================================================================
' KOSPI200/Mini KOSPI200 선택
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	ComboYYMM.clear = true
'	20220311 HSZ START 위클리 추가
	if FormTab0.currenttabpageid = "page0" then 'KOSPI200
		Table0.visible = true
		GridCP.top = 160
		Table1.top = 160
		imgToggle.top = 204
		imgToggle0.top = 204
		imgToggle1.top = 204
	elseif FormTab0.currenttabpageid = "page1" or FormTab0.currenttabpageid = "page2" then ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
		Table0.visible = false
		GridCP.top = 90
		Table1.top = 90
		imgToggle.top = 134
		imgToggle0.top = 134
		imgToggle1.top = 134
	end if

	SetControl() '20220311 HSZ
	
	' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
	if CInt(nCurrentTab) <> g_K200WEEK and CInt(nCurrentTab) <> g_K200WEEKM then
		DATAMANAGER.RequestTranData( "ohhts_0510_001r" ) '결제월조회
	end if
	DATAMANAGER.RequestTranData( "ohhts_3002_002r" ) '결제월조회
'	20220311 HSZ END
	
End Sub

