'============================================================================
'20220311 HSZ START : 위클리 추가
Function SetControl()
	Dim nCurrentTab
	Dim nRadioIndx
	nCurrentTab = FormTab0.currenttab
	nRadioIndex = RadioGroupCP.currentindex
	
	GridCP.SetClear()
	Container0.GridAllC.SetClear()
	Container0.GridAllP.SetClear()
	Container0.GridAllC0.SetClear()
	
	if CInt(nRadioIndex) = 0 then
		Container0.visible = true
		Table1.visible = true
		GridCP.visible = false
		
		imgToggle.visible = true
		imgToggle0.visible = true
		imgToggle1.visible = true
		if CInt(nCurrentTab) = 0 then 'KOSPI200
			Container0.top = 214
			Container0.height = 349
		elseif CInt(nCurrentTab) = 1 or CInt(nCurrentTab) = 2 then ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
			Container0.top = 145
			Container0.height = 420
		end if
	
	else
		Container0.visible = false
		Table1.visible = false
		GridCP.visible = true
		
		imgToggle.visible = false
		imgToggle1.visible = false
		imgToggle0.visible = false
		if CInt(nCurrentTab) = 0 then 'KOSPI200
			GridCP.top = 162
			GridCP.height = 403
		elseif CInt(nCurrentTab) = 1 or CInt(nCurrentTab) = 2 then ' 20230628_01 KBC : 위클리옵션(야간, 월요일) 추가
			GridCP.top = 95
			GridCP.height = 468
		end if
	end if
End Function 

'============================================================================

Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "SCREEN_MENU" Then							' 연
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	End if	
End Sub

'============================================================================

Sub Form_OnPopupReturn(sKeyName, sRet)
	g_nSNSType = Cint(sRet)
	If g_nSNSType = 2 Then
		Dim szScreenNo, szFileName
		szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
		szFileName = szScreenNo & "_ScreenShot.png"
		
		Form.SaveScreenShot( szFileName )		
		Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
	Else
		Form.triggerEvent("linkfmHoga", "sharedata", "")
	End If
End Sub

'============================================================================
Sub Table1_OnClick(lRow , lColumn)
	
	if lColumn = 0 then
		
		if Table1.GetCellString(1, 0) = "대비" then
			Table1.SetCellString(1, 0, "등락률")
			Container0.GridAllC.SetVisibleCol(0, true)
			Container0.GridAllC.SetVisibleCol(1, false)
			Container0.GridAllC.SetVisibleCol(2, false)
			Container0.GridAllC.SetCellData(0, 10, "test")
			
		elseif Table1.GetCellString(1, 0) = "등락률" then
			Table1.SetCellString(1, 0, "대비")
			Container0.GridAllC.SetVisibleCol(0, false)
			Container0.GridAllC.SetVisibleCol(1, true)
			Container0.GridAllC.SetVisibleCol(2, true)
		end if
			
	elseif lColumn = 2 then
		
		if Table1.GetCellString(0, 2) = "행사가격" then
			Table1.SetCellString(0, 2, "행사가격\r\n(지수환산)")
			Container0.GridAllC.SetVisibleCol(5, true)
			Container0.GridAllC.SetVisibleCol(4,false)
		else
			Table1.SetCellString(0, 2, "행사가격")
			Container0.GridAllC.SetVisibleCol(5, false)
			Container0.GridAllC.SetVisibleCol(4,true)
		end if
			
		
		
	elseif lColumn = 4 then
	
		if Table1.GetCellString(1, 4) = "대비" then
			Table1.SetCellString(1, 4, "등락률")
			Container0.GridAllP.SetVisibleCol(3,true)
			Container0.GridAllP.SetVisibleCol(1,false)
			Container0.GridAllP.SetVisibleCol(2,false)
		elseif Table1.GetCellString(1, 4) = "등락률" then
			Table1.SetCellString(1, 4, "대비")
			Container0.GridAllP.SetVisibleCol(3,false)
			Container0.GridAllP.SetVisibleCol(1,true)
			Container0.GridAllP.SetVisibleCol(2,true)
		end if
	end if
End Sub

'20210630 HWG START : ATM 실시간 하이라이트 적용
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID = "ohhts_nmix_cntg" then
		szHyunJisu = DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0)
		szHyunJisu = Round(szHyunJisu, 2)
		
		if RadioGroupCP.currentindex = "0" then
			SetAllRealAtm(szHyunJisu)
		else
			SetCallPutRealAtm(szHyunJisu)
		end if
		
	elseif szTranID = "ohhts_nmix_cntg_1" then
		g_nJisu = DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_PRPR2", 0)
	end if
End Sub

'============================================================================
Function SetCallPutRealAtm(szHyunJisu)
	nCnt = CInt(GridCP.rowcount)
	nAtm = CDbl(GridCP.GetCellData("bd_cell0", g_nGIdx))
	nDiff = ABS(szHyunJisu - nAtm) 
	
	nBaseJisu = 0
	if g_nJisu <> 0 and g_nJisu <> "" then
		nBaseJisu = Round(g_nJisu,2)
	end if
	
	nMinDiff = 0
	nMinIdx = 0
	
	for i = 0 to nCnt - 1
		nPrc = CDbl(GridCP.GetCellData("bd_cell0", i))
		nHDiff = ABS(szHyunJisu - nPrc)
		
		if nBaseJisu <> 0 then
			nJisu = Round(nBaseJisu / szHyunJisu * nPrc, 2)
			GridCP.SetCellData("bd_cell1", i, nJisu)
		end if
		
		if i = 0 then
			nMinDiff = nHDiff
		else
			if nHDiff < nMinDiff then
				nMinDiff = nHDiff
				nMinIdx = i
			end if
		end if
	next
	
	if nMinIdx <> g_nGIdx then
		if nMinDiff < nDiff then
			GridCP.SetCellBgColor( "bd_cell0", nMinIdx, "156:255253233" )
			GridCP.SetCellBgColor( "bd_cell0", g_nGIdx, "38:255255255" )
			
'			nTopRow = 0
'			if nMinIdx > 2 then
'				nTopRow = nMinIdx - 3
'			end if
'			
'			if nTopRow ~= 0 then
'				GridCP.toprow = nTopRow		
'			end if
			
			g_nGIdx = nMinIdx
		end if
	end if
End Function

'============================================================================
Function SetAllRealAtm(szHyunJisu)
	nCnt = CInt(Container0.GridAllC.rowcount)
	nAtm = CDbl(Container0.GridAllC.GetCellData("bd_cell2", g_nGIdx))
	nDiff = ABS(szHyunJisu - nAtm) 
	nBaseJisu = 0
	if g_nJisu <> 0 and g_nJisu <> "" then
		nBaseJisu = Round(g_nJisu,2)
	end if
	nMinDiff = 0
	nMinIdx = 0
	
	for i = 0 to nCnt - 1
		nPrc = CDbl(Container0.GridAllC.GetCellData("bd_cell2", i))
		nHDiff = ABS(szHyunJisu - nPrc)
		
		if i = 0 then
			nMinDiff = nHDiff
		else
			if nHDiff < nMinDiff then
				nMinDiff = nHDiff
				nMinIdx = i
			end if
		end if
	next
	
	if nMinIdx <> g_nGIdx then
		if nMinDiff < nDiff then
		
			Container0.GridAllC.SetCellBgColor( "bd_cell2", nMinIdx, "156:255253233" )
			Container0.GridAllC.SetCellBgColor( "bd_cell3", nMinIdx, "156:255253233" )
			Container0.GridAllC.SetCellBgColor( "bd_cell9", nMinIdx, "156:255253233" )
			Container0.GridAllC0.SetCellBgColor( "bd_cell2", nMinIdx, "156:255253233" )
			
			Container0.GridAllC.SetCellBgColor( "bd_cell2", g_nGIdx, "38:255255255" )
			Container0.GridAllC.SetCellBgColor( "bd_cell3", g_nGIdx, "38:255255255" )
			Container0.GridAllC.SetCellBgColor( "bd_cell9", g_nGIdx, "38:255255255" )
			Container0.GridAllC0.SetCellBgColor( "bd_cell2", g_nGIdx, "38:255255255" )
			
'			nTopRow = 0
'			if nMinIdx > 2 then
'				nTopRow = nMinIdx - 3
'			end if
'			
'			if nTopRow ~= 0 then
'				Container0.scroll_pos = nTopRow * 37
'			end if
			
			g_nGIdx = nMinIdx
		end if
	end if
End Function
'20210630 HWG END

