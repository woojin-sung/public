'============================================================================
Sub Form_OnFormClose()
	ChartEx0.SetSaveChart("1")

	Form.SetEnvData( 1,"mhtro16020_chart_setting" , g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"mhtro16020_chart_settingmintick" , g_szMinType.."^"..g_szTicType )
	
	Dim sReturn
	sReturn = g_szChrtType
	if g_szChrtType == "A" then
		sReturn = sReturn.."`"..g_szMinType
	elseif g_szChrtType == "T" then 
		sReturn = sReturn.."`"..g_szTicType
	end if
	
	Form.SendReturnToParent("LAND_CHART_TYPE" , g_szItemCode.."^"..sReturn)
	'Form.SendReturnToParent("LAND_CHART_TYPE" , g_szItemCode )
End Sub

