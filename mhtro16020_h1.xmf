'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'============================================================================
Dim g_sCode 
Dim g_szItemCode
Dim g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_flagInit
Dim g_flagLine
Dim g_sStockMode

Dim g_szExid
Dim g_szCode
Dim g_rtChk

g_sStockMode = "1"	'수정주가 1: 0
g_szChrtType = "D" 	'일

'============================================================================
Sub Form_OnFormInitBefore()

	ChartEx0.SetLoadChart("foreignstock")
	
	szMin0 = Form.GetEnvData( "mhtro16020_chart_min0" )
	szTic0 = Form.GetEnvData( "mhtro16020_chart_tic0" )
		
	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	
	ChartEx0.SetMarketCategory("7")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_open_001r") '20220523 HSZ : 가로화면 화면집계 서비스호출 추가
	g_flagInit = true
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_flagLine = false
	
	' LinkData : 마켓@종목코드^PeriodType`min/tic
	' LinkData Ex : OQ@AAPL^A`1

	if Form.GetOpenLinkData( ) <> null and Form.GetOpenLinkData( ) <> ""	then
		
		szData = split(Form.GetOpenLinkData( ), "^")
		g_szItemCode = szData[0]		
		
		
		sParam = split(szData[1], "`")
		g_szChrtType = sParam[0] 	' 타입
		if g_szChrtType == "A" then	
			g_szMinType = sParam[1]		' 분
		elseif g_szChrtType == "T" then
			g_szTicType = sParam[1]		' 틱
		end if
		
		g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
		
		SetChart()
		PeriodSet(g_szChrtType)
	else
		Form.CloseForm( )
	end if
End Sub

'============================================================================
Function SetChart()
	Dim szValue, szValueMinTick
	szValue			= Form.GetEnvData( "mhtro16020_chart_setting" )
	szValueMinTick	= Form.GetEnvData( "mhtro16020_chart_settingmintick" )    
	tempStock 		= Form.GetEnvData( "mhtro16020_chart_stockmode" )	
		
	if tempStock <> "" then
		g_sStockMode = tempStock
		ChartEx0.SetAdjustedStock(g_sStockMode)
	end if
	
	if szValue = "" then
		Form.SetEnvData( "mhtro16020_chart_settingmintick", "2^001" )
		g_sPeriod	= "001"
		g_sPeriodType	= "2"
		
	else
		temp = split(szValue, "^")
		g_sPeriodType	= temp[0]
		g_sPeriod	= temp[1]
		
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")
		g_szMinType = temp1[0]
		g_szTicType = temp1[1]

	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "mhtro16020_chart_min0" )
		szTic0 = Form.GetEnvData( "mhtro16020_chart_tic0" )
	
		if szMin0 <> "" and szMin0 <> 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			g_szTicType = szTic0
		else 
			g_szTicType = "1"
		end if 
	end if
	
	'분틱 셋팅	
	tmpIndex = null
	if g_sPeriodType = "0" or g_sPeriodType = "1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
		end if
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
'PENTA13 START => 2019.03.04
		elseif g_sPeriodType = "4" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
'PENTA13 END
		end if	
	end if
	
	RadioGroup0.currentindex = g_TempIndex
End Function

'============================================================================
Function RequestData()
	if g_szItemCode == "" or g_szItemCode == null	then
		exit function
	end if
	
	DATAMANAGER.RequestTranData( "ohhts_exst_cntg" )
	
	sTemp = split(g_szItemCode, "@")
	g_szExid = sTemp[0] '시장구분
	g_szCode = sTemp[1] '종목코드 
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExid, false )
				
	szStockMode = "0"
	if g_sStockMode = "0" then
		szStockMode = "1"
	end if
	if g_szChrtType = "A" then		'분차트
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")
		DATAMANAGER.RequestTranData("ohhts_5041_005r")
	elseif g_szChrtType = "T" then		'틱차트
		sTic = Split(g_szTicType, "틱", -1, 1)
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_006r", "InBlock2", "FID_INPUT_CNT1" , 0, sTic[0])
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_006r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y")
		DATAMANAGER.RequestTranData("ohhts_5041_006r")
	elseif g_szChrtType = "D" then		'일차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_001r")
	elseif g_szChrtType = "W" then		'주차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_002r")
	elseif g_szChrtType == "M" then 	'월차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_003r")
	elseif g_szChrtType == "Y" then 	'년차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_004r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_004r")
	End If

end Function


