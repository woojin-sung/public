' 분,틱 설정파일 저장
'============================================================================
function Save_ini()
	dim sMin, sTic, sflag
	
	for i = 0 to 6
		Form.SetEnvData( 1, "mhtro16020_chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "mhtro16020_chart_min"..i, g_chartMinArr[i] )
		
		Form.SetEnvData( 1, "mhtro16020_chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "mhtro16020_chart_tic"..i, g_chartTicArr[i] )
	next
'	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			' 데이터갯수...필요 없음 삭제 해도 됩니다.

end function

'======================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'======================================
function PeriodSet(sPeriodType)

'	Form.ShowAlert("", sIndex..":"..sPeriod)	
	if sPeriodType= "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
	   
	elseif sPeriodType= "A" then
		g_sPeriod = CInt(g_szMinType) 
		g_sPeriodType = "1"
	   
	elseif sPeriodType= "D" then 
		g_sPeriodType = "2"
		g_sPeriod ="1"
	   
	elseif sPeriodType= "W" then 
		g_sPeriodType = "3"
		g_sPeriod = "1"
	   
	elseif sPeriodType= "M" then 
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
'PENTA13 START => 2019.05.08
	elseif sPeriodType= "Y" then 
		g_sPeriodType = "5"
		g_sPeriod = "1"
'PENTA13 END
	end if
	
	sPeriod = CInt( g_sPeriod)
	if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if
	
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
   
	' 조회TR 보내기
	RequestData()
end function

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim nDecimal
	nDecimal = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_DCPN_CNT" , 0))
	ChartEx0.SetDecimal(nDecimal)
	ChartEx0.SetJisuCode(g_szItemCode)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD", 0, g_szItemCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	
	g_flagInit = false
	g_flagMinTic = false
	
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	
	if nIndex == 0 then  '일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
	elseif nIndex == 1 then  '주/월
		g_flagMin = false
		g_flagTic = false
		if g_flagWeek == false   then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
			elseif sTemp == "년" then
				g_szChrtType = "Y"
			else
				g_szChrtType = "W"
			end if
			g_flagWeek = true
			PeriodSet(g_szChrtType)
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_h5.xmf" , sTemp , "" )
		end if
	elseif nIndex == 2 then   '분
		g_flagTic = false
		g_flagWeek = false	
		
		g_szChrtType = "A"
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(RadioGroup0.GetRadioCaption( 2),"분")
			g_szMinType = tmpMin[0]
			'Chart0.period = g_szMinType
			PeriodSet(g_szChrtType)
		else
			If g_flagInit = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhtro16020_p3.xmf" , g_szMinType , "" )
			End If
		end if
	elseif nIndex == 3 then   '틱
		g_flagMin = false
		g_flagWeek = false	
		
		g_szChrtType = "T"
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption( 3),"틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
		else
			If g_flagMinTic = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhtro16020_p4.xmf" , g_szTicType , "" )
			End If
		end if
	end if	
	Form.SetEnvData(1, "mhtro16020_RADIO", RadioGroup0.currentindex)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_WEEK"	then			'주/월
		if sRet == "월" then
			g_szChrtType = "M"
		elseif sRet == "년" then
			g_szChrtType = "Y"
		else
			g_szChrtType = "W"
		end if
		RadioGroup0.SetRadioCaption( 1, sRet)
		PeriodSet(g_szChrtType)
	elseif sKeyName == "Chart_Tic"	then		'틱
		g_szTicType = sRet	
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(RadioGroup0.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]		
		PeriodSet(g_szChrtType)
	elseif sKeyName == "Chart_Min"	then		'분
		g_szMinType = sRet		
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		PeriodSet(g_szChrtType)
	end if
End Sub

'============================================================================
function ChartEx0_OnChangeAdjustedStock(sData)
	if g_sStockMode <> sData then
		g_sStockMode = sData
		Form.SetEnvData( 1, "mhtro16020_chart_stockmode", g_sStockMode )
		RequestData()
	end if
end function
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "mhtro16020_chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "mhtro16020_chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)

	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
		sTemp = split(sPeriodType, "/")
		sMinArr = split(sTemp[0], ";")
		sTicArr = split(sTemp[1], ";")
		Form.Log("sPeriodType", sPeriodType)
	   
		for i = 0 to 7 step 1
			Form.SetEnvData( 1, "mhtro16020_chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "mhtro16020_chart_tic"..i, sTicArr[i] )
		next
	end if
end function

'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)

	if #Count == 1 then
		Count = "000"..Count
	   
	elseif #Count == 2 then
		Count = "00"..Count
	   
	elseif #Count == 3 then
		Count = "0"..Count
	   
	end if

	g_sChartCnt = Count
	RequestData()
end function

'============================================================================
'차트 불러오기
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")

   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode   = Cstr(Trim(Data[0]))             '코드
	g_sPeriodType  = Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod      = Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh 	 = Cstr(Trim(Data[3]))
	radioIndex 	 = ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType =  "D"
		
		sTic = Form.GetEnvData( "mhtro16020_chart_tic0" )
		sMin = Form.GetEnvData( "mhtro16020_chart_min0" )
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		Select case g_sPeriodType
			case "0"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱" )
				g_szTicType = g_sPeriod
			case "1"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분" )
				g_szMinType = g_sPeriod
			case "2"
				radioIndex = 0
			
			case "3"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주" )
			
			case "4"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월" )

'PENTA13 START => 2019.03.04
			case "5"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "년" )
'PENTA13 END
		end Select
	end if
	
	RadioGroup0.currentindex = radioIndex
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	Dim szName
	szName = Form.GetItemCodeInfo(g_szItemCode, "name")
	Form.setOverStockItemCode(g_szItemCode.."★"..szName)

	RequestData()
end function

'============================================================================
Sub ChartEx0_OnScrollEnd()
	' Chart Next Data
	if g_szChrtType = "A" then
		DATAMANAGER.RequestNextData("ohhts_5041_005r")
	elseif g_szChrtType = "T" then
		DATAMANAGER.RequestNextData("ohhts_5041_006r")
	elseif g_szChrtType = "D" then	
		DATAMANAGER.RequestNextData("ohhts_5041_001r")
	elseif g_szChrtType == "W" then 
		DATAMANAGER.RequestNextData("ohhts_5041_002r")
	elseif g_szChrtType == "M" then 
		DATAMANAGER.RequestNextData("ohhts_5041_003r")
	elseif g_szChrtType == "Y" then 
		DATAMANAGER.RequestNextData("ohhts_5041_004r")
	end if
End Sub

