'JMY Sta
'진입점에서 설정되는 정보 ---------------------------------------
Dim	g_BDM_FRST_MAPID			'최초진입점화면ID
Dim	g_BDMNMETBSWRGB			'비대면업무구분 : 100.비대면계좌개설 0xx.비대면업무신청 3xx.모바일OTP발급 999.비대면진행상태조회
Dim	g_mOTP_IntoClcd			'(모바일OTP)진입구분코드 NMET_ACNT.계좌개설후처리, NMET_BSWR.업무처리, MTS.MTS
'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
Dim	g_BDM_REG_UNIQ_NO			'등록고유번호 : 비대면계좌개설(YYYYMMDD+N+일련번호4자리), 비대면업무신청(YYYYMMDD+B+일련번호4자리)
Dim	g_BDM_REG_STAG_CLS_CODE	'등록단계구분코드
Dim	g_BDM_NAME  				'이름
Dim	g_BDM_RCNO_PIP 	 		'주민등록번호
Dim	g_BDM_COMPANY_CODE		'통신사 정보 
Dim	g_BDM_HP1   				'휴대폰번호
Dim	g_BDM_HP2
Dim	g_BDM_HP3
'신분증진위확인에서 설정되는 정보 ---------------------------------------
Dim	g_BDM_IDNTF_SRNO			'신분증일련번호
'이어하기안내용, 진행상태보기용 Data ---------------------------------------
Dim	g_BDM_LAST_STAG_CLS_CODE	'최종등록단계구분코드
Dim	g_BDM_CLEAR_YN			'Y:처음부터하기 N: 이어하기
Dim	g_BDM_PRNM				'개설상품명
Dim	g_BDM_APLTDATE			'신청일자
Dim	g_BDM_CLSNDATE			'신청마감일자
'JMY Fin


Dim gState 
gState = ""

Dim g_prevScr
g_prevScr = ""

'============================================================================
Function User_SharedData_Set(gb)	'JMY

    '진입점에서 설정되는 정보 ---------------------------------------
    Form.SetSharedData("BDM_FRST_MAPID"  , g_BDM_FRST_MAPID  )	'최초진입화면ID
    Form.SetSharedData("BDM_NMETBSWRGB"  , g_BDMNMETBSWRGB   )	'비대면업무구분
    Form.SetSharedData("mOTP_IntoClcd"	, g_mOTP_IntoClcd   )	'(모바일OTP)진입구분코드

    if gb == "Init" then
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"    		, "")	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, "")	'등록단계구분코드
		Form.SetSharedData("BDM_NAME"         		, "")	'이름
		Form.SetSharedData("BDM_RCNO_PIP"       		, "")	'주민등록번호
		Form.SetSharedData("BDM_COMPANY_CODE"  	 	, "")	'통신사 정보
		Form.SetSharedData("BDM_HP1"          		, "")	'휴대폰번호
		Form.SetSharedData("BDM_HP2"              	, "")
		Form.SetSharedData("BDM_HP3"              	, "")
		
		'신분증진위확인에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_IDNTF_SRNO"          	, "")	'신분증일련번호

		'이어하기안내용, 진행상태보기용 Data ---------------------------------------
		Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"	, "" )	'최종등록단계구분코드
		Form.SetSharedData("BDM_CLEAR_YN"     		, "" )	'이어하기여부
		Form.SetSharedData("BDM_PRNM"       			, "" )	'개설상품명
		Form.SetSharedData("BDM_BDM_APLTDATE"   		, "" )	'신청일자
		Form.SetSharedData("BDM_BDM_CLSNDATE"   		, "" )	'신청마감일자

    else
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"       	, g_BDM_REG_UNIQ_NO   		)	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, g_BDM_REG_STAG_CLS_CODE 	)	'등록단계구분코드
		Form.SetSharedData("BDM_NAME"         		, g_BDM_NAME        		)	'이름
		Form.SetSharedData("BDM_RCNO_PIP"       		, g_BDM_RCNO_PIP      		)	'주민등록번호
		Form.SetSharedData("BDM_COMPANY_CODE"   		, g_BDM_COMPANY_CODE    	)	'통신사 정보
		Form.SetSharedData("BDM_HP1"          		, g_BDM_HP1         		)	'휴대폰번호
		Form.SetSharedData("BDM_HP2"              	, g_BDM_HP2       		)
		Form.SetSharedData("BDM_HP3"              	, g_BDM_HP3       		)
		
		'신분증진위확인에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_IDNTF_SRNO"          	, g_BDM_IDNTF_SRNO		)	'신분증일련번호

		'이어하기안내용, 진행상태보기용 Data ---------------------------------------
		Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"	, g_BDM_LAST_STAG_CLS_CODE	)	'최종등록단계구분코드
		Form.SetSharedData("BDM_CLEAR_YN"     		, g_BDM_CLEAR_YN      		)	'이어하기여부
		Form.SetSharedData("BDM_PRNM"       			, g_BDM_PRNM        		)	'개설상품명
		Form.SetSharedData("BDM_APLTDATE"     		, g_BDM_APLTDATE      		)	'신청일자
		Form.SetSharedData("BDM_CLSNDATE"     		, g_BDM_CLSNDATE      		)	'신청마감일자
      
	end if

End Function
'============================================================================
Function User_SharedData_Get()	'JMY

	'진입점에서 설정되는 정보 ---------------------------------------
	g_BDM_FRST_MAPID        	= Form.GetSharedData("BDM_FRST_MAPID"		, false)	'최초진입화면ID
	g_BDMNMETBSWRGB         	= Form.GetSharedData("BDM_NMETBSWRGB"		, false)	'비대면업무구분
	g_mOTP_IntoClcd			= Form.GetSharedData("mOTP_IntoClcd"			, false)	'(모바일OTP)진입구분코드

	'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
	g_BDM_REG_UNIQ_NO       	= Form.GetSharedData("BDM_REG_UNIQ_NO"        , false) '등록고유번호
	g_BDM_REG_STAG_CLS_CODE 	= Form.GetSharedData("BDM_REG_STAG_CLS_CODE"  , false) '등록단계구분코드
	g_BDM_NAME              	= Form.GetSharedData("BDM_NAME"               , false) '이름
	g_BDM_RCNO_PIP        	  	= Form.GetSharedData("BDM_RCNO_PIP"           , false) '주민등록번호
	g_BDM_COMPANY_CODE   	  	= Form.GetSharedData("BDM_COMPANY_CODE"       , false) '통신사 정보
	g_BDM_HP1             	  	= Form.GetSharedData("BDM_HP1"                , false) '휴대폰번호
	g_BDM_HP2              	= Form.GetSharedData("BDM_HP2"                , false)
	g_BDM_HP3               	= Form.GetSharedData("BDM_HP3"                , false)

	'신분증진위확인에서 설정되는 정보 ---------------------------------------
	g_BDM_IDNTF_SRNO			= Form.GetSharedData("BDM_IDNTF_SRNO"        	, false)	'신분증일련번호

	'이어하기안내용, 진행상태보기용 Data ---------------------------------------
	g_BDM_LAST_STAG_CLS_CODE 	= Form.GetSharedData("BDM_LAST_STAG_CLS_CODE"	, false)	'최종등록단계구분코드
	g_BDM_CLEAR_YN          	= Form.GetSharedData("BDM_CLEAR_YN"    		, false) '이어하기여부
	g_BDM_PRNM              	= Form.GetSharedData("BDM_PRNM"         		, false) '개설상품명
	g_BDM_APLTDATE          	= Form.GetSharedData("BDM_APLTDATE" 			, false) '신청일자
	g_BDM_CLSNDATE          	= Form.GetSharedData("BDM_CLSNDATE" 			, false) '신청마감일자

End Function


'============================================================================
Sub Form_OnFormInit()
	'공유변수 Get
	User_SharedData_Get()

	'비대면계좌개설인 경우에만 진행단계표시
	if g_BDMNMETBSWRGB == "100" then
		ImgF.visible = true
	else
		ImgF.visible = false
	end if	
	
	
	'뒤로가기(물리버튼) 막음
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
		
End Sub



'============================================================================
'촬영하기 버튼
'============================================================================
Sub BtnRunCamera_OnClick()
	
	Form.runInziCamera()
	'Form.OpenPopupAnimation("mbbdm85120_p1"  , "" , "", "2")
	
End Sub

'============================================================================
'코치마크 화면오픈
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "mbbdm85120_p1" then
		if sRet = "close" then
			Form.runInziCamera()
			
		end if
		
	elseif sKeyName = "mbbdm85121" then
	
		if sRet = "OCREND" then
			Form.CloseForm()
		end if
		
	end if	
		
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "OCRCOMPLETE" then
		if sParam == "1" then
			
			'공유변수 Set
			User_SharedData_Set("")
			Form.OpenPopup("mbbdm85121" , "" , "")
			
		end if
		
	end if
	
End Sub
'============================================================================
Sub Image1_OnClick()
	g_prevScr = "mbbdm85110"
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormClose()
	
	'뒤로가기(물리버튼) 막음
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	
	if g_prevScr <> "" and g_prevScr <> null then
		
		'공유변수 Set
		User_SharedData_Set("")
		Form.OpenPopup(g_prevScr , "StepBack" , "")
		
	end if
	
End Sub


'============================================================================
Sub Form_OnFormBackKeyPressed()
	g_prevScr = "mbbdm85110"
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
