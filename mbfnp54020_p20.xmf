	<SCRIPT_INFO _len="5275" _ulen="4799" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 채권주문
' 02. 화면설명 : 채권주문주문 경고안내
' 03. 작    성 : 2019.11.25 YGH
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_MarketType	'
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SecType		' 신용구분
Dim 	g_szOrd_SecDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부
Dim 	g_szErrMsg			' 경고메세지


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

	If g_nOrd_ChkAll = "1" Then
		If g_nIndex = 2 Then
			g_nOrd_Qty = "잔량"
		ElseIf g_nIndex = 3 Then
			g_nOrd_Qty = "전부"
		End If
	End If
	
	If g_nIndex = "0" Then
		lblTitle.caption = "채권매수주문"
	ElseIf g_nIndex = "1" Then
		lblTitle.caption = "채권매도주문"
	ElseIf g_nIndex = "2" Then
		lblTitle.caption = "채권정정주문"
	End If
	
	lblMsg.caption = g_szErrMsg	
	
	tbl0.SetCellString( 0, 1, g_szOrder_Acc 		)
	tbl0.SetCellString( 0, 2, g_szOrder_AccName	)
	tbl0.SetCellString( 1, 1, g_szOrd_ItmCode 	)
	tbl0.SetCellString( 2, 1, g_szOrd_ItmName	)
	tbl0.SetCellString( 3, 1, g_nOrd_Qty			)
	tbl0.SetCellString( 4, 1, g_nOrd_Price 		)

End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 11:예약매수, 12:예약매도, 14:예약취소)
	g_szOrder_MarketType	= arrData( 1)	' 주문종류 
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_OrdType  		= arrData( 6)	' 소액매매구분
	g_szOrd_Security 		= arrData( 7)	' 소액매매구분데이타
	g_szOrd_SecType 		= arrData( 8)	' 시장구분2
	g_szOrd_SecDate 		= arrData( 9)	' 매수일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(13)	' 과세구분
	if CInt(g_nIndex) > 1 then
		g_szErrMsg	 		= arrData(15)	' 경고메세지
	else
		g_szErrMsg	 		= arrData(14)	' 경고메세지
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	If g_nIndex = "0" Then 
		lblTitle.caption = "채권매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_etc10.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "1" Then
		lblTitle.caption = "채권매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_etc11.9"
		btnOrder.caption="매도"
	
	ElseIf g_nIndex = "2" Then
		lblTitle.caption = "채권정정주문"
		lblTitle.bgcolor = "93"
		tbl0.SetCellFgColor( 4, 0, "8" )
		tbl0.SetCellFgColor( 4, 1, "8" )
		btnOrder.btnimage = "btn_etc17.9"
		btnOrder.caption="정정"
		
	End If	

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub


'============================================================================
Sub btnOrder_OnClick()
	SendOrder()
End Sub


'============================================================================




'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>