'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'0:전체, 1:매수, 2:매도
Dim g_nAryAmt			'매입금액
Dim g_nAryExcl		'월정산금액
Dim g_nAryExclPrls	'월정산손익
			
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Init_TR()
	
	DATAMANAGER.RequestTranData("obtre_comm_231r")

End Sub

'============================================================================
''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************
''============================================================================
Sub Form_OnFormInit()
	Cont0.setScrollBarVisible("0")
	
'	cont0.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 10) '활성화/비활성화/여백
'	cont0.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
'	
'	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page1", "page1", "empty", "0", "월정산 결제월")
'	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page2", "page2", "empty", "0", "월정산 평가월")
'	
	'Init_TR()
	
'	szTab = Trim(Form.LoadConfigData( "mbtre11000_t6", "search" ))	'펼침버튼
'	if szTab = "" then
'		cont0.FormTab0.currenttab = 0
'	else
'		cont0.FormTab0.currenttab = CInt(szTab)
'	end if
	
	'월 -1 차이 나도록 수정(안드로이드에서는 addday가 월 단위로는 안먹네..) 그대로 나갈까 말까
'	if cont0.cldFrom.calmonth == "1" then
'		calmonth = "12"
'	else
'		calmonth = tostring(tonumber(cont0.cldFrom.calmonth) - 1)
'		
'		if (tonumber(calmonth)/10) < 1 then
'			calmonth = "0" & calmonth
'		end if
'	end if
	
	cont0.grd1.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grd1.SetCellData("bd_cell0", 0, "매입금액")
	cont0.grd1.SetCellData("bd_cell2", 0, "월정산금액")
	
	cont0.grd1.scrollenable = "0"
	
	'당월 1일 세팅
	szhostDate = Form.GetSharedData("&HOST_DATE" , false)
	szMonth = Mid(szhostDate, 5, 2)
	cont0.cldFrom.caption = cont0.cldFrom.calyear & szMonth & "01"
	
	'안드로이드 폴드 디스플레이 가로가 넓어 
	'이미지 위치 벌어지는 현상 개선
	cont0.lblExRate0.setNeighborCtlPos("lblExRate2", "left", 45, "")

	'cont0.cldFrom.addday = -1
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHANGE_ACCTNO" then
		Init_TR()
		f_SetGrdMask()
	if sEventName == "RECEIVE" then 
	end if
End Sub

