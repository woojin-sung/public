'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 그리드 로우 위치 변경 위한 속성
	grdGroup.rowmove = "1"
	
'PENTA13 START => 2019.01.23
	Get_GWGroup()
'PENTA13 END
End Sub

'============================================================================
' btnAdd_OnClick
'============================================================================
Sub btnAdd_OnClick()	
	Dim szCode, szChk
	Dim nRow
	
	nRow = CInt(grdGroup.rowcount)-1

	if nRow == 99 then
		'Form.ShowAlert("관심그룹 추가", "관심그룹은 최대 100개까지입니다")
		Form.ShowAlert(g_szTitle, "관심그룹은 최대 100개까지입니다")
		Exit Sub
	end if
	
	' 관심그룹 명칭 초기 설정위해.. 코드로 정한다. //////////////////////////
	if nRow < 0 then
		szCode = "00"
	else
		'20180905_01 NOHES START : 관심그룹 생성 시, 순차적으로 확인해서 코드 빠졌을 때 채워넣으면서 만든다.
		'                          그룹이 10개 이상인 경우에 szCd == szCode 처리 못해서 CStr 처리함.
		For i = 0 to 99
			if Len(i) == 1 then
				szCode = "0" & i
			else
				szCode = CStr(i)
			end if
			
			For j = 0 to nRow		
				szCd = grdGroup.GetCellData("bd_code", j)
				if szCd == szCode then					
					szChk = "0"
					Exit For
				else 
					szChk = "1"
				end if
			Next
			if szChk == "1" then
				Exit For
			end if	
		Next
		'20180905_01 NOHES ORG	
'		For i = 0 to 99
'			if Len(i) == 1 then
'				szCode = "0" & i
'			else
'				szCode = i
'			end if
'				
'			For j = 0 to nRow
'				szCd = grdGroup.GetCellData("bd_code", j)
'								
'				if szCd == szCode then
'				
'					szChk = "0"
'					Exit For
'				end if
'				
'				if j == nRow then
'					szChk = "1"
'				end if				
'			Next	
'			
'			if szChk = "1" then
'				Exit For
'			end if
'		Next
		'20180905_01 NOHES END
	end if
	' ////////////////////////////////////////////////////////////////////////
	
	Form.OpenPopup("mhtro16010_p3" , "GROUP_ADD★" & szCode & "★", "")
End Sub

'============================================================================
' grdGroup_OnClickUp
'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cancel" then	
		if grdGroup.rowcount == "1" then
			'Form.ShowAlert("관심그룹삭제", "관심그룹은 최소 1개이상 존재하여야합니다.")
			Form.ShowAlert(g_szTitle, "관심그룹은 최소 1개이상 존재하여야합니다.")
			exit Sub
		end if
		
		g_szRow = lRow
	
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
	
		'Form.MsgBox("관심그룹삭제", "선택된 관심그룹을 삭제하겠습니까?\r\n\n["& szCode & "] " & szName , "DELETE", 1)
		Form.MsgBox("알림", "선택된 관심그룹을 삭제하겠습니까?", "DELETE", 1)
	elseif szCellID == "bd_mod" then
		g_szRow = lRow
		
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
		
		Form.OpenPopup("mhtro16010_p3" , "GROUP_MOD★" & szCode & "★" & szName , "")
	end if	
End Sub

'============================================================================
' grdGroup_OnDropRow
'============================================================================
Sub grdGroup_OnDropRow()
	g_szCode = ""
	DATAMANAGER.RequestTranData("ohhts_intr_038r")
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sRet <> "" then
		tData = Split(sRet, "★")
		
		' 그룹 추가
		if sKeyName == "GROUP_ADD" then
'			if grdGroup.rowcount <= 0 then
'				nRow = 0
'			else
				g_szRow = grdGroup.rowcount
'			end if
'			
			g_szCode = tData(0)
			grdGroup.insertrow = g_szRow
			
			grdGroup.SetCellData("bd_count", g_szRow, 0)
		end if
		
		grdGroup.SetCellData("bd_code", g_szRow, tData(0))
		grdGroup.SetCellData("bd_name", g_szRow, tData(1))
			
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_038r")
		
