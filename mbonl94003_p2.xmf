'============================================================================
' Form_OnCertEvent(sType  , sSucces , stext) : 인증완료 후 이벤트
'============================================================================
Sub Form_OnCertEvent(sType  , sSucces , stext)
	if sType == "RetIsCertPasswordValid" then
		if sSucces == "Success" then  '성공
			Form.SetCertDNPW(g_szDN, g_szCertPass)
			g_szSucsYN = "Y"
			DATAMANAGER.RequestTranData( "obcpp_logn_017a" )
			
		elseif sSucces == "Failed" then '비밀번호 오류
			g_szSucsYN = "N"
			Form.ShowAlert("알림", "인증서 비밀번호 오류입니다.")
			
			DATAMANAGER.RequestTranData( "obcpp_logn_017a" )
			
		elseif sSucces == "Error" then ' 인증서 없음
			Form.OpenDialog("mhetc90020_perr", "", "") '인증서 없음 처리
		end if	
	end if
End Sub

'============================================================================
' 20180730_01 NOHES : 아이폰 login 창 close를 위한 정리
' g_bAccAlarmClose(계좌알림안내확인) g_bCloseForm(efif_005r 응답확인) g_bExpiredChecked(인증서만료확인)
' 위의 3가지 전역변수를 모두 만족해야만 로그인창을 닫을 수 있다.
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	' 인증서 선택 팝업 닫혔을때
	if sKeyName == "Login_Close" then
		g_szDN = Form.GetSharedData("CERT_DN", 0)
		
		Form.SetEnvData(1,"login.input.userdn",g_szDN)
		f_ProcSelectedCert(g_szDN)
	
	' 인증서 없음 처리
	elseIf sKeyName == "pError" then
		If sRet == "Cert" then
			'KBC : CloseForm 먼저 하지 말아라. 안드로이드에서 null참조오류난다.
			Form.OpenScreen("90060" , "")
			Form.CloseForm()
		End If
		
	'=======================================================================================================
	' 인증서 만료안내 팝업 제공
	'=======================================================================================================		
	elseif sKeyName == "mhetc90021_p2" then
		g_bExpiredChecked = True
		
		if g_bCloseForm And g_bExpiredChecked then '20190522_04 KBC : 팝업분리
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================
' ContainerCert_btnCertList_OnClick() : 인증서 선택 팝업 오픈
'============================================================================
Sub ContainerCert_btnCertList_OnClick()
	Form.OpenPopup("mhetc90060_pe" , "Login_Open" , "")	
End Sub

'============================================================================
' ContainerCert_Grid0_OnClickUp(lRow, szCellID) : 인증서 선택 팝업 오픈
'============================================================================
Sub ContainerCert_Grid0_OnClickUp(lRow, szCellID)
	Form.OpenPopup("mhetc90060_pe" , "Login_Open" , "")	
End Sub

'============================================================================
' imgClose_OnClick() : 팝업 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "KS" then '인증서로그인(비번리턴됨)
		g_szCertPass = sReturn2
		
		'인증서 특수기호 ">"종료글자 오류회피
		sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
		
		if sCertPass <> null and sCertPass <> "" then
			g_szCertPass = sCertPass
		end if
		
		if g_szCertPass <> "" then
			Form.RequestCertCommand("ReqCheckIsValidPassword", g_szDN, g_szCertPass) '일반(인증서로그인)
		end if
	end if
End Sub

'============================================================================
' ContainerCert_edtCertPswd_OnEditComplete() : 인증서 비밀번호 입력 완료했을때
'============================================================================
Sub ContainerCert_edtCertPswd_OnEditComplete()
	g_szCertPass = ContainerCert.edtCertPswd.caption
		
	'인증서 특수기호 ">"종료글자 오류회피
	sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
		
	if sCertPass <> null and sCertPass <> "" then
		g_szCertPass = sCertPass
	end if
		
	if g_szCertPass <> "" then
		Form.RequestCertCommand("ReqCheckIsValidPassword", g_szDN, g_szCertPass) '일반(인증서로그인)
	end if
End Sub

''****************************************************************************
''               		D A T A				M A N A G E R               
''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 인풋 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcpp_logn_017a" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "DN_DATA" , 0 , g_szDN) 	'DN
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "SUCS_YN" , 0 , g_szSucsYN)	'성공여부
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_logn_017a" then
		if g_szSucsYN == "Y" then
			Form.SendReturnToParent("COMPLETE_CERT" , "Y")
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 에러 발생
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)	
	sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if Len(sSubMsg) > 1 Then
		Form.MsgBox("알림", "[TR] " & szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
	else
		Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
	end if
End Sub

