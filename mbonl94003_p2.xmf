'' 01. 화 면 명 : 공인인증확인 팝업
'' 02. 화면설명 : 
'' 03. 작    성 : 2021.06.08 정효영
'' 04. 수    정 : 
''
''--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCertPass
Dim g_szDn, g_szSucsYN

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ProcSelectedCert(sDN) : 선택 인증서 세팅 ( 로그인에 있는 그대로 )
'============================================================================
Sub f_ProcSelectedCert(sDN)
	Dim sCertCnt, sToday, sCalDate 
	Dim bFind
	
	sCertCnt	= Form.GetCertListSize()
	sToday	= Form.GetSharedData("&HOST_DATE",0)
	sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
	sCalDate	= Left(sCalDate, 8)
	bFind	= false
	
	ContainerCert.Grid0.SetClear()
	ContainerCert.Grid0.rowcount = 1
	
	if sCertCnt ~= null and sCertCnt ~= "" then
		if CInt(sCertCnt) > 0 then
			Dim sCertInfo, sTemp, sDate

			for i = 0 to CInt(sCertCnt)-1
				sCertInfo = Form.GetCertListDataAt(i)
				sTemp = Split(sCertInfo, ";")
				
				if #sTemp > 7 then
					'sTemp[0] 성명
					'sTemp[1] DN
					'sTemp[2] 종류(범용개인)
					'sTemp[3] 발급기관
					'sTemp[5] 사용가능여부(가능1)
					'sTemp[6] 만기일
					'sTemp[7] 시작일
					
					if sTemp[1] == sDN then
						bFind = true
						
						ContainerCert.Grid0.SetCellData("bd_name", 0, sTemp[0])
						ContainerCert.Grid0.SetCellData("bd_cert", 0, sTemp[2].." ("..sTemp[3]..")")
						
						sDate = sTemp[7]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerCert.Grid0.SetCellData("bd_date", 0, "20"..sDate)
						
						sDate = sTemp[6]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerCert.Grid0.SetCellData("bd_Edate", 0, "20"..sDate)
						
						ContainerCert.Grid0.SetCellData("bd_dn", 0, sTemp[1])
						ContainerCert.Grid0.SetCellData("bd_index", 0, i)
						
						if tonumber("20"..sDate) > tonumber(sCalDate) then
							ContainerCert.Grid0.SetCellData("bd_icon", 0, "icon_sub_11.png")
						else
							ContainerCert.Grid0.SetCellData("bd_icon", 0, "icon_sub_12.png")
						end if
					end if
				end if
			next
		end if
	end if
	
	if bFind == false then
		ContainerCert.Grid0.SetCellData("bd_cert", 0, "인증서를 선택하세요.")
		ContainerCert_btnCertList_OnClick()
	end if	
End Sub

