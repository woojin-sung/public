								<CELL cell_ly="2,10,2,10" line="0,0" impidxs="" />
								<CELL cell_ly="3,10,3,10" line="0,0" impidxs="" />
								<CELL cell_ly="4,10,4,10" line="0,0" impidxs="" />
							</CELL_INFO>
						</TABLE>
					</CONTROL_INFO>
				</CONTAINER>
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="25188" _ulen="23352" >
'============================================================================
' 01. 화 면 명 : 예수금
' 02. 화면설명 : 예수금 조회
' 03. 작    성 : 2016.1.14 하원만
' [Modify] ==================================================================
' 2020.08.20 : 정민영 : v0001 : [T2007130018] 레버리지ETF/ETN 기본예탁금관련(OutBlock6) obacb_balc_024rTR 재매핑
' 2021.09.02 : 김효준 : v0002 : 해외주식 통합증거금 (OutBlock2 - 환전증거금,타통화증거금) 추가
' 2023.05.25 : 장원혁 : v0003 : 슈퍼365 바로출금서비스
' 2023.09.12 : 이학록 : v0004 : 사용하지 않는 계좌콤보 삭제 'cmbAccount', 계좌콤보히스토리에 영향을 줌.
' 2023.10.12 : 윤혁   : v0005 : 예수금 화면 UI 개선
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리

Dim g_hMargin
Dim g_Show1, g_Show2, g_Show3, g_Show4
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************



'============================================================================
' TR_Inquiry(g_nAcNo, g_nAsNo)
'============================================================================
Function TR_Inquiry(g_nAcNo, g_nAsNo)

	DATAMANAGER.SetDataValue(0, "obacb_balc_024r" , "InBlock1" , "ACNO" , 0 , g_nAcNo)
	DATAMANAGER.SetDataValue(0, "obacb_balc_024r" , "InBlock1" , "ASNO" , 0 , g_nAsNo)
	DATAMANAGER.RequestTranData("obacb_balc_024r")

	Dim szData
	szData = Form.GetSharedData( "&BIZ_DT" , false )
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_085r" , "InBlock1" , "ACNO"      , 0 , g_nAcNo)
	DATAMANAGER.SetDataValue(0, "obacb_balc_085r" , "InBlock1" , "ASNO"      , 0 , g_nAsNo)
	DATAMANAGER.SetDataValue(0, "obacb_balc_085r" , "InBlock1" , "PROS_DATE" , 0 , szData)
	DATAMANAGER.RequestTranData("obacb_balc_085r")
	
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "SVCD"             , 0 , "VRT")
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "PROS_DATE"        , 0 , szData)
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "ACNO"             , 0 , g_nAcNo)
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "ASNO"             , 0 , g_nAsNo)
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "SMCD"             , 0 , "102020")
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "TR_OCRN_CLS_CODE" , 0 , "01")
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "TACT_PROS_YN"     , 0 , "Y")
	DATAMANAGER.SetDataValue(0, "obrtp_vrtl_001r" , "InBlock1" , "IQRY_CLS_CODE"    , 0 , "")
	DATAMANAGER.RequestTranData("obrtp_vrtl_001r") 'v0003

End Function

'============================================================================
Sub Form_OnFormInit()
	g_Show1 = False
	g_Show2 = False
	g_Show3 = False
	g_Show4 = False
	
	g_hMargin = 5
		
	szData = Form.LoadConfigData("mbact71000", "VIEW_MODE")
	
	select case szData
		case "1"		g_Show1 = True
		case "2"		g_Show2 = True
		case "3"		g_Show3 = True
		case "4"		g_Show4 = True
	end select
	
'	Form.ShowAlert("FormInit", szData)
	if CInt(szData) > 0 then
		f_setViewCtrl(szData, True, False)
	else
		f_setViewCtrl(szData, False, False)	
	end if
	
	'btnSrch_OnClick()
	
End Sub

'============================================================================
Sub btnSrch_OnClick()

	'g_nAcNo =  Left( cmbAccount.caption, 8)
	'g_nAsNo =  Right( cmbAccount.caption, 2)

'	g_nAcNo =  cmbAccount.total    'Left( cmbAccount.caption, 8)
'	g_nAsNo =  cmbAccount.sequence 'Right( cmbAccount.caption, 2)

	'2016.02.11 LJS 수정(잔고평가 탭으로 묶임)
	'2016.03.05 YCJ 수정(잔고평가 탭으로 묶임에 따라 연결된 계좌컨트롤 변경)
	g_nAcNo = Form.GetCtlProp("#acnt1", "total")			'anct0 -> anct1
	g_nAsNo = Form.GetCtlProp("#acnt1", "sequence")		'anct0 -> anct1
	

	Call Output_Data_Clear()
	Call TR_Inquiry(g_nAcNo, g_nAsNo)

	szData = Form.LoadConfigData("mbact71000", "VIEW_MODE")
	if CInt(szData) > 0 then
		f_setViewCtrl(szData, True, False)
	else
		f_setViewCtrl(szData, False, False)	
	end if
	
End Sub

'============================================================================
'출력 Data 초기화
Sub Output_Data_Clear()

	cnnt.tbl0.SetCellString(0, 3, "")
	cnnt.tbl0.SetCellString(2, 3, "")
	cnnt.tbl0.SetCellString(3, 3, "")
	cnnt.tbl0.SetCellString(4, 3, "")
	cnnt.tbl0.SetCellString(5, 3, "")
	
	cnnt.cont1.tbl1.SetCellString(2, 2, "")
	cnnt.cont1.tbl1.SetCellString(3, 2, "")
	
	cnnt.cont2.tbl2.SetCellString(2, 2, "")
	cnnt.cont2.tbl2.SetCellString(3, 2, "")
	
	cnnt.cont3.tbl3.SetCellString(2, 2, "")
	cnnt.cont3.tbl3.SetCellString(3, 2, "")
	
	cnnt.cont4.tbl4.SetCellString(2, 2, "")
	cnnt.cont4.tbl4.SetCellString(3, 2, "")	

End Sub


'============================================================================
Sub cnnt_cont3Detail_ImgQuestion_OnClick()
	szText = "대출이자는 결제잔고 기준으로 표시됩니다."
	
	cnnt.cont3Detail.ImgQuestion.openToolTip(szText, 290, 32, 2)
End Sub

'============================================================================
'TR 에서 받은 데이타를 숫자 형식으로 변환하는 함수
'szData : 표시할 데이타
'iDecimal : 소수점 자리수
'bIsPost : 데이타 뒤에 '원' 표시 여부
function getNumberData(szData, iDecimal, bIsPost)
	Dim szNumber
	
	szNumber = FormatNumber(szData, iDecimal)
		
'	if szNumber == "0" then
'		szNumber = "0"
'	else
'		szNumber = FormatNumber(szData, 0)
'	end if
	
	if bIsPost then
		szNumber = szNumber + "원"
	end if
	
	return szNumber
end function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'수표금액 = HTS의 [7601]예수금 상세조회의 총출금가능금액 선택시 보여지는 팝업의 ②수표금액 
'	If szTranID == "obacb_balc_024r" Then

'	    '미수금 = 현재 화면 하단의 현금미수금 + 기타미수금 + 수수료미수금
'	    Dim CASH_UNAM, ETC_UNAM, FEE_UNAM
'	    CASH_UNAM = DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "CASH_UNAM", 0 )  '현금미수금
'	    ETC_UNAM = DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "ETC_UNAM",  0 )  '기타미수금
'	    FEE_UNAM = DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "FEE_UNAM",  0 )  '수수료미수금
'	    cnnt.tbl0.SetCellString(3, 0, (CASH_UNAM + ETC_UNAM + FEE_UNAM))
'	    
'		'이자미납금 = 현재 화면 하단의 대출이자미납금
'		
'		'대출금액 = 현재화면 하단의 ( 신용융자금 + 신용대주금 + 예탁담보대출금 + 매도담보대출금 + 소액담보대출금 )
'		Dim CRDT_LOAN_AMT, UI_CRDT_STLN_AMT, DEPS_ASCR_AMT, SELN_ASCR_AMT, SMAM_LOAN_AMT
'		CRDT_LOAN_AMT 	= DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "CRDT_LOAN_AMT", 0 )  '
'		UI_CRDT_STLN_AMT 	= DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "UI_CRDT_STLN_AMT", 0 )  '
'		DEPS_ASCR_AMT 	= DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "DEPS_ASCR_AMT", 0 )  '
'		SELN_ASCR_AMT 	= DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "SELN_ASCR_AMT", 0 )  '
'		SMAM_LOAN_AMT 	= DATAMANAGER.GetDataValue( 0, "obacb_balc_024r", "OutBlock3", "SMAM_LOAN_AMT", 0 )  '
'		cnnt.tbl0.SetCellString(1, 2, (CRDT_LOAN_AMT + UI_CRDT_STLN_AMT + DEPS_ASCR_AMT + SELN_ASCR_AMT + SMAM_LOAN_AMT))
		
'    End If
	if szTranID == "obacb_balc_024r" then
		'주문가능 및 증거금 상세
		'-----------------------------------------------------------------------------------
	
		' 증거금 현금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "UI_TDAY_CASH_ENTM_MARG", 0)		
		cnnt.cont1Detail.tbl0.SetCellString(0, 2, getNumberData(szData, 0, True))  
		
		'증거금 대용
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "UI_TDAY_SBSN_ENTM_MARG", 0)		
		cnnt.cont1Detail.tbl0.SetCellString(1, 2, getNumberData(szData, 0, True))
		
		' 환전증거금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "MNEC_MARG", 0)		
		cnnt.cont1Detail.tbl1.SetCellString(2, 2, getNumberData(szData, 0, True))
		
		'타통화증거금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTHR_CRNC_MARG", 0)		
		cnnt.cont1Detail.tbl1.SetCellString(3, 2, getNumberData(szData, 0, True))
		
		'해외주식소수점증거금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "SMNO_ODER_MARG", 0)		
		cnnt.cont1Detail.tbl1.SetCellString(4, 2, getNumberData(szData, 0, True))
		
		'집투매수증거금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IISC_BYOV_MARG", 0)
		cnnt.cont1Detail.tbl1.SetCellString(5, 2, getNumberData(szData, 0, True))
		
		'단기사채증거금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OM_BOND_MARG", 0)
		cnnt.cont1Detail.tbl1.SetCellString(6, 2, getNumberData(szData, 0, True))
		
		'ELW기본예탁금 등급
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "STND_VLTN_DEPS_TTAM", 0)		
		cnnt.cont1Detail.tbl2.SetCellString(2, 2, getNumberData(szData, 0, True))
		
		'ELW예탁총액
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "VLTN_DEPS_TTAM", 0)		
		cnnt.cont1Detail.tbl2.SetCellString(3, 2, getNumberData(szData, 0, True))
		
		'레버리지 ETF기본예탁금 등급
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock6", "ETF_BASC_DEPS_AMT", 0)		
		cnnt.cont1Detail.tbl2.SetCellString(4, 2, getNumberData(szData, 0, True))
		
		'레버리지 ETF예탁총액
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock6", "VLTN_DEPS_TTAM", 0)		
		cnnt.cont1Detail.tbl2.SetCellString(5, 2, getNumberData(szData, 0, True))
		
		' 매매대금 상세
		'-----------------------------------------------------------------------------------
		'D+1
		'추정예수금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_D1_AFT_TFAM", 0)
		cnnt.cont2Detail.tbl0.SetCellString(2, 1, getNumberData(szData, 0, True))
		
		'매수정산금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_PRDY_BYOV_EXCL_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(3, 1, getNumberData(szData, 0, True))
		
		'매도정산금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_PRDY_SELN_EXCL_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(4, 1, getNumberData(szData, 0, True))
		
		'변제소요금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_D1_AFT_UNCL_RPMN_RQRD_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(5, 1, getNumberData(szData, 0, True))
		
		'출금가능금액
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_D1_AFT_DRNG_ABLE_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(6, 1, getNumberData(szData, 0, True))
		
		'D+2
		'추정예수금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_D2_AFT_TFAM", 0)
		cnnt.cont2Detail.tbl0.SetCellString(2, 2, getNumberData(szData, 0, True))
		
		'매수정산금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_TDAY_BYOV_EXCL_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(3, 2, getNumberData(szData, 0, True))
		
		'매도정산금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_TDAY_SELN_EXCL_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(4, 2, getNumberData(szData, 0, True))
		
		'변제소요금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_D2_AFT_UNCL_RPMN_RQRD_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(5, 2, getNumberData(szData, 0, True))
		
		'출금가능금액
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_D2_AFT_DRNG_ABLE_AMT", 0)
		cnnt.cont2Detail.tbl0.SetCellString(6, 2, getNumberData(szData, 0, True))
		
		'신용 및 대출 상세
		'-----------------------------------------------------------------------------------		
		'신용대주금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CRDT_STLN_AMT", 0)
		cnnt.cont3Detail.tbl0.SetCellString(0, 2, getNumberData(szData, 0, True))
		
		'매도담보대출금	
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "SELN_ASCR_AMT", 0)
		cnnt.cont3Detail.tbl0.SetCellString(1, 2, getNumberData(szData, 0, True))
		
		'바로출금(매도담보)
		'szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_BAL", 0)
		'cnnt.cont3Detail.tbl0.SetCellString(2, 2, getNumberData(szData, 0, True))
		
		'신용담보금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "CRDT_MORG_AMT", 0)
		cnnt.cont3Detail.tbl0.SetCellString(4, 2, getNumberData(szData, 0, True))
		
		'추가담보금 현금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "SPLM_MORG_CASH_AMT", 0)
		cnnt.cont3Detail.tbl0.SetCellString(5, 2, getNumberData(szData, 0, True))
		
		'추가담보금 대용
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "SPLM_MORG_SBSN_AMT", 0)
		cnnt.cont3Detail.tbl0.SetCellString(6, 2, getNumberData(szData, 0, True))
		
		'담보부족금
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "CNTG_RFLC_MORG_DFCN_AMT", 0)
		cnnt.cont3Detail.tbl0.SetCellString(7, 2, getNumberData(szData, 0, True))
		
		'담보비율(종가기준)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "CNTG_RFLC_MORG_RATE", 0)
		cnnt.cont3Detail.tbl0.SetCellString(8, 2, getNumberData(szData, 2, False) .. "%")
		
		'대출이자(D+1)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_D1_AFT_INT_AMT", 0)
		cnnt.cont3Detail.tbl1.SetCellString(2, 2, getNumberData(szData, 0, True))
		
		'대출이자 D+2
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_D2_AFT_INT_AMT", 0)
		cnnt.cont3Detail.tbl1.SetCellString(3, 2, getNumberData(szData, 0, True))
			
		' 미납금 및 연체료 상세
		'-----------------------------------------------------------------------------------
		'현금미수금(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "CASH_UNAM", 0)
		cnnt.cont4Detail.tbl0.SetCellString(2, 2, getNumberData(szData, 0, True))
		
		'현금미수금(연체료)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "CASH_UNAM_OVFE", 0)
		cnnt.cont4Detail.tbl0.SetCellString(2, 3, getNumberData(szData, 0, True))
		
		'기타대여금(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ETC_LNDN_AMT", 0)
		cnnt.cont4Detail.tbl0.SetCellString(3, 2, getNumberData(szData, 0, True))
		
		'기타대여금(연체료)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ETC_LNDN_AMT_OVFE", 0)
		cnnt.cont4Detail.tbl0.SetCellString(3, 3, getNumberData(szData, 0, True))
		
		'기타미수금(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ETC_UNAM", 0)
		cnnt.cont4Detail.tbl0.SetCellString(4, 2, getNumberData(szData, 0, True))
		
		'기타미수금(연체료)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ETC_UNCL_AMT_OVFE", 0)
		cnnt.cont4Detail.tbl0.SetCellString(4, 3, getNumberData(szData, 0, True))
		
		'수수료미수금(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "FEE_UNAM", 0)
		cnnt.cont4Detail.tbl0.SetCellString(5, 2, getNumberData(szData, 0, True))
		
		'수수료미수금(연체료) - 항목없음
		cnnt.cont4Detail.tbl0.SetCellString(5, 3, "0원")
		
		'미수증권확보금(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UNCL_SCRT_RSRV_AMT", 0)
		cnnt.cont4Detail.tbl0.SetCellString(6, 2, getNumberData(szData, 0, True))
		
		'미수증권확보금(연체료)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UNCL_CRDT_INT_OVFE", 0)
		cnnt.cont4Detail.tbl0.SetCellString(6, 3, getNumberData(szData, 0, True))
		
		'대출정기이자미납(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "LOAN_INT_NTPD_AMT", 0)
		cnnt.cont4Detail.tbl0.SetCellString(7, 2, getNumberData(szData, 0, True))
		
		'대출정기이자미납(연체료)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UNCL_CRDT_INT_OVFE", 0)
		cnnt.cont4Detail.tbl0.SetCellString(7, 3, getNumberData(szData, 0, True))
		
		'대출 미상환금(미수금)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "NNRD_LOAN_AMT", 0)
		cnnt.cont4Detail.tbl0.SetCellString(8, 2, getNumberData(szData, 0, True))
		
		'대출 미상환금(연체료)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "NNRD_OVRD_INT", 0)
		cnnt.cont4Detail.tbl0.SetCellString(8, 3, getNumberData(szData, 0, True))
		
	elseif szTranID == "obrtp_vrtl_001r" then
		'바로출금(매도담보)
		szData = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LOAN_BAL", 0)
		cnnt.cont3Detail.tbl0.SetCellString(2, 2, getNumberData(szData, 0, True))
		
	end if 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'Form.ShowAlert("OnTrigger", sEventName)
	
	if szEventID == "mbacb14010" then    
		Dim sData
		sData = left(replace(sParam,"-",""),12)

		g_nAcNo =  Left( sData, 8)
		g_nAsNo =  Right( sData, 2)
		
		
		Call TR_Inquiry(g_nAcNo, g_nAsNo)
		
	ElseIf sEventName == "RECEIVE" Then
		btnSrch_OnClick()
		
	ElseIf sEventName == "CHANGE_ACCTNO" Then  ' 계좌변경
		btnSrch_OnClick()
		
	elseif sEventName == "INFO_CLICK" then   '화면 상단 유의사항 버튼
		Form.OpenFramePopup( "mbact71000_p2" , "", "")
		
	end if
	
End Sub

' 컨테이너 안에서는 컨트롤의 top, height값이 제대로 안나오기 때문에 수치계산하여 사용
Function f_getCtrlInfo(szName, szPos)
	Dim iCont1Top, iPos
	
	iCont1Top = 132
	
	if szPos == "top" then    ' tbl1 을 기준으로한 top 값 계산
		if szName == "cnnt.cont1" then
			iPos = iCont1Top
		
		elseif szName == "cnnt.cont2" then
			iPos = iCont1Top + 85  ' cont1 의 top 과 height
			if g_Show1 then
				iPos = iPos + 355 + g_hMargin 'cont1Detail 의 height
			else
				iPos = iPos + g_hMargin
			end if
		
		elseif szName == "cnnt.cont3" then
			iPos = iCont1Top + 85  ' cont1 의 top 과 height
			if g_Show1 then
				iPos = iPos + 355 + g_hMargin 'cont1Detail 의 height
			else
				iPos = iPos + g_hMargin
			end if
			
			iPos = iPos + 85  ' cont2 의 height
			if g_Show2 then
				iPos = iPos + 311 + g_hMargin 'cont1Detail 의 height
			else
				iPos = iPos + g_hMargin
			end if
		
		elseif szName == "cnnt.cont4" then
			iPos = iCont1Top + 85  ' cont2 의 top 과 height
			if g_Show1 then
				iPos = iPos + 355 + g_hMargin 'cont1Detail 의 height
			else
				iPos = iPos + g_hMargin
			end if
			
			iPos = iPos + 85  ' cont2 의 height
			if g_Show2 then
				iPos = iPos + 311 + g_hMargin 'cont1Detail 의 height
			else
				iPos = iPos + g_hMargin
			end if
			
			iPos = iPos + 85  ' cont3 의 height
			if g_Show3 then
				iPos = iPos + 351 + g_hMargin 'cont1Detail 의 height
			else
				iPos = iPos + g_hMargin
			end if
			
		end if	
		
		szResult = iPos
	
	elseif szPos == "height" then
		select case szName
			case "cnnt.cont1Detail"	szResult = 327
			case "cnnt.cont2Detail" 	szResult = 150
			case "cnnt.cont3Detail" 	szResult = 270
			case "cnnt.cont4Detail" 	szResult = 204
			case "cnnt.cont1" 		szResult = 79
			case "cnnt.cont2" 		szResult = 79
			case "cnnt.cont3" 		szResult = 79				
			case "cnnt.cont4" 		szResult = 79
		end select
	
	end if
	
	return CInt(szResult)
end Function

