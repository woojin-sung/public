Sub cnnt_cont1_btnDetail_OnClick()
	g_Show1 = not g_Show1
	
	if g_Show1 then		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", "1")
	else		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", 0)
	end if
	
	f_setViewCtrl("1", g_Show1, True)
End Sub

'============================================================================
Sub cnnt_cont2_btnDetail_OnClick()
	g_Show2 = not g_Show2
	
	if g_Show2 then		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", "2")
	else		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", 0)
	end if
	
	f_setViewCtrl("2", g_Show2, True)
End Sub

'============================================================================
Sub cnnt_cont3_btnDetail_OnClick()
	g_Show3 = not g_Show3
	
	if g_Show3 then		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", "3")
	else		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", 0)
	end if
	
	f_setViewCtrl("3", g_Show3, True)
End Sub

'============================================================================
Sub cnnt_cont4_btnDetail_OnClick()
	g_Show4 = not g_Show4
	
	if g_Show4 then		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", "4")
	else		
		Form.SaveConfigData("mbact71000", "VIEW_MODE", 0)
	end if
	
	f_setViewCtrl("4", g_Show4, True)
End Sub

sub f_setShowFlag(szType)	
	select case szType
		
		case "1"	
			g_Show2 = False
			g_Show3 = False
			g_Show4 = False
		
		case "2"
			g_Show1 = False
			g_Show3 = False
			g_Show4 = False
			
		case "3"
			g_Show1 = False
			g_Show2 = False
			g_Show4 = False
			
		case "4"
			g_Show1 = False
			g_Show2 = False
			g_Show3 = False
			
		case else
			g_Show1 = False
			g_Show2 = False
			g_Show3 = False
			g_Show4 = False
				
	end select	
	
	if g_Show1 then
		cnnt.cont1.lblDetail.caption = "접기"
		cnnt.cont1.imgArrow.imgpath = "icon_gray_up"
	else
		cnnt.cont1.lblDetail.caption = "더보기"
		cnnt.cont1.imgArrow.imgpath = "icon_gray_down"
	end if
	
	if g_Show2 then
		cnnt.cont2.lblDetail.caption = "접기"
		cnnt.cont2.imgArrow.imgpath = "icon_gray_up"
	else
		cnnt.cont2.lblDetail.caption = "더보기"
		cnnt.cont2.imgArrow.imgpath = "icon_gray_down"
	end if
	
	if g_Show3 then
		cnnt.cont3.lblDetail.caption = "접기"
		cnnt.cont3.imgArrow.imgpath = "icon_gray_up"
	else
		cnnt.cont3.lblDetail.caption = "더보기"
		cnnt.cont3.imgArrow.imgpath = "icon_gray_down"
	end if
	
	if g_Show4 then
		cnnt.cont4.lblDetail.caption = "접기"
		cnnt.cont4.imgArrow.imgpath = "icon_gray_up"
	else
		cnnt.cont4.lblDetail.caption = "더보기"
		cnnt.cont4.imgArrow.imgpath = "icon_gray_down"
	end if
		
	cnnt.cont1Detail.visible = g_Show1
	cnnt.cont2Detail.visible = g_Show2
	cnnt.cont3Detail.visible = g_Show3
	cnnt.cont4Detail.visible = g_Show4
end sub

'============================================================================
'szType : 펼치기 할 영역, 1:주문가능금액, 2:매매대금, 3:신용/대출, 4:미수금 및 연체료
'bIsShow : 펼치기(1), 접기(0)
'bIsFocus : 펼치기 했을때 해당 위치를 화면 제일 위로 이동(스크롤 이동)
Sub f_setViewCtrl(szType, bIsShow, bIsFocus)
	dim iPos, iPos1, iPos2, iPos3, iPos4
	
	iPos1 = f_getCtrlInfo("cnnt.cont1", "top")
	iPos = f_getCtrlInfo("cnnt.cont1", "top") + f_getCtrlInfo("cnnt.cont1", "height")
		
'	Form.ShowAlert("f_setViewCtrl1", szType & " : " & bIsShow)
	
	
'	Form.ShowAlert("f_setViewCtrl2", g_Show1)

	'세부정보 플래그 설정
	f_setShowFlag(szType)
	
'	Form.ShowAlert("f_setViewCtrl3", g_Show1)
	
'	Form.ShowAlert("f_setViewCtrl3", g_Show1 & "," & g_Show2 & "," & g_Show3 & "," & g_Show4)
	
	'테이블 위치 설정  cnnt.cont1의 top 값은 항상 고정
	if g_Show1 then								
		cnnt.cont1Detail.top = iPos	
		iPos = iPos + f_getCtrlInfo("cnnt.cont1Detail", "height")
		
	end if
	
	' cnnt.cont2 위치
	iPos = iPos + g_hMargin
	cnnt.cont2.top = iPos
	iPos2 = iPos
	
	iPos = iPos + f_getCtrlInfo("cnnt.cont2", "height")
	
	if g_Show2 then				
		cnnt.cont2Detail.top = iPos
		
		iPos = iPos + f_getCtrlInfo("cnnt.cont2Detail", "height")
	end if
	
	' cnnt.cont3 위치
	iPos = iPos + g_hMargin
	cnnt.cont3.top = iPos
	iPos3 = iPos
	
	iPos = iPos + f_getCtrlInfo("cnnt.cont3", "height")
	
	if g_Show3 then				
		cnnt.cont3Detail.top = iPos
		
		iPos = iPos + f_getCtrlInfo("cnnt.cont3Detail", "height")
	end if
	
	' cnnt.cont4 위치
	iPos = iPos + g_hMargin
	cnnt.cont4.top = iPos
	iPos4 = iPos
	
	iPos = iPos + f_getCtrlInfo("cnnt.cont4", "height")
	
	if g_Show4 then				
		cnnt.cont4Detail.top = iPos
		
		iPos = iPos + f_getCtrlInfo("cnnt.cont4Detail", "height")
	end if
	
	if not bIsShow then
		' 폼 아래쪽 공간 없애기 위해서
		select case szType			
			case "1"		cnnt.cont1Detail.top = 0
			case "2"		cnnt.cont2Detail.top = 0
			case "3"		cnnt.cont3Detail.top = 0
			case "4"		cnnt.cont4Detail.top = 0
		end select 
		
		cnnt.scroll_pos = 0
		
	else
		if bIsFocus then
			' 화면 스크롤 위치 조정
			select case szType				
				case "1"		cnnt.scroll_pos = iPos1
				case "2"		cnnt.scroll_pos = iPos2
				case "3"		cnnt.scroll_pos = iPos3
				case "4"		cnnt.scroll_pos = iPos4
				case else 	cnnt.scroll_pos = 0
			end select
		else
			cnnt.scroll_pos = 0
		end if
	end if
		
	cnnt.SetScrollAutoSize()
end sub


