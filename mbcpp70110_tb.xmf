Dim g_pid
Dim g_uid
Dim g_init_invest
Dim g_expect_ror
Dim suminvest

'============================================================================
Sub Form_OnFormInitBefore()
		
	g_pid = Form.GetSharedData("Shared_PID", false)
	suminvest = 0
	'나중에 쉐어드 데이터로 바꿀것!
	
	g_uid = Form.GetSharedData("&USER_ID", false )
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_004r", "InBlock1", "PRTF_ID" , 0 , g_pid)
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_919r", "InBlock1", "CUST_ID" , 0 , g_uid)
	
	DATAMANAGER.RequestTranData("obcpp_rbit_004r")
	
	
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obcpp_rbit_004r" then
	
	
	g_expect_ror = DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "ERT" , 0)
	temp0= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M1_ERT" , 0)
	temp1= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M3_ERT" , 0)
	temp2= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M6_ERT" , 0)
	temp3= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M12_ERT" , 0)
	temp4= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M36_ERT" , 0)
		
	ChartEx0.SetAccrueData("자료일자=20150301;20150601;20150901;20160101;20160301")       
	ChartEx0.SetAccrueData("data1="&temp0&";"&temp1&";"&temp2&";"&temp3&";"&temp4&"=2")
	ChartEx0.SetAccrueData("data2=1.75;1.5;1.25;1.25;1.25=2")
	ChartEx0.SetAccrueData("data3=1.72;1.55;1.71;1.43;1.72=2")
	
	ChartEx0.setLineColor("포트폴리오;255;0;0")
	ChartEx0.setLineColor("기준금리;0;255;0")
	ChartEx0.setLineColor("국고채금리(3년);0;0;255")
		
	ChartEx0.SetPriceFormat("data1^10^2")
	ChartEx0.SetPriceFormat("data2^10^2")
	ChartEx0.SetPriceFormat("data3^10^2")
	
	ChartEx0.SetShowCrossLine("true")                          
	ChartEx0.SetAccrueData("repaintall");	
	
	
	'ChartEx0.SetAccrueData("data1="&temp1&";"&temp2&";"&temp3&";"&temp4&"")

'	ChartEx0.setInvestorRealData("포트폴리오;기준금리;국고채금리(3년)=".."150901"..";"..temp1..";".."1.75"..";".."1.72")
'	ChartEx0.setInvestorRealData("포트폴리오;기준금리;국고채금리(3년)=".."151201"..";"..temp2..";".."1.5"..";".."1.55")
'	ChartEx0.setInvestorRealData("포트폴리오;기준금리;국고채금리(3년)=".."150601"..";"..temp3..";".."1.25"..";".."1.71")
'	ChartEx0.setInvestorRealData("포트폴리오;기준금리;국고채금리(3년)=".."160301"..";"..temp4..";".."1.25"..";".."1.43")
		DATAMANAGER.RequestTranData("obcpp_rbit_919r")
		
	elseif  szTranID=="obcpp_rbit_919r" then
		g_init_invest = DATAMANAGER.GetDataValue(0, "obcpp_rbit_919r", "OutBlock1", "FRST_CNRC_AMT" , 0)
		Label1.caption = g_init_invest
		Label3.caption = Cal_Expect_Profit(g_expect_ror,g_init_invest)

	end if
	
	

End Sub

'============================================================================
Sub Form_OnFormInit()
	
		
	ChartEx0.SetAccrueName("포트폴리오,기준금리,국고채금리(3년)")                                                  
     ChartEx0.SetPeriodType(2)	
	'ChartEx0.setViewDataCount(5)
	'ChartEx0.SetAccrueData("period=1=YYYYMMDD")                                                           
	                                                           
	ChartEx0.SetAccrueData("initdata=20150301;20150601;20150901;20160101;20160301")                                    
	ChartEx0.SetAccrueData("changetitle=".."포트폴리오;기준금리;국고채금리(3년)")           
    
    Grid0.SetCellData("bd_cell0",0,"1개월")
    Grid0.SetCellData("bd_cell4",0,"3개월")
    Grid0.SetCellData("bd_cell8",0,"6개월")
    Grid0.SetCellData("bd_cell12",0,"12개월")
    Grid0.SetCellData("bd_cell16",0,"36개월")
     
    Grid0.SetCellData("bd_cell2",0,1.75)
    Grid0.SetCellData("bd_cell6",0,1.5)
    Grid0.SetCellData("bd_cell10",0,1.25)
    Grid0.SetCellData("bd_cell14",0,1.25)
    Grid0.SetCellData("bd_cell18",0,1.25)
	
	Grid0.SetCellData("bd_cell3",0,1.72)
    Grid0.SetCellData("bd_cell7",0,1.55)
    Grid0.SetCellData("bd_cell11",0,1.71)
    Grid0.SetCellData("bd_cell15",0,1.43)
    Grid0.SetCellData("bd_cell19",0,1.72)


		
End Sub


'============================================================================

Function Cal_Expect_Profit(ert,invest)

		if suminvest <> null then
		suminvest = invest*((ert/12)/100+"1")
						
		for i=0 to 10
		
		suminvest= (suminvest)*((ert/12)/100+"1")

		
		next
		
		Cal_Expect_Profit = Cint(suminvest)-Cint(invest)
	end if

End Function




