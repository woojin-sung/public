	<SCRIPT_INFO _len="4403" _ulen="4315" >
'============================================================================
' 01. 화 면 명 : 권리예정내역_입출고	
' 02. 화면설명 : 권리예정내역_입출고
' 03. 작    성 : 2016. 02. 15. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList
Dim g_GridCnt
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_GridCnt =0
	
	if sEventName == "입출고" then
		g_szList = Split(sParam , "★")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
		
	DATAMANAGER.SetDataValue( 0 , "obrgt_stpm_002r", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obrgt_stpm_002r", "InBlock1", "ASNO" , 0 , g_szList(1))
	DATAMANAGER.SetDataValue( 0 , "obrgt_stpm_002r", "InBlock1", "RGHT_STND_DATE" , 0 , cld0.caption)
	
	DATAMANAGER.RequestTranData("obrgt_stpm_002r")
End Sub
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	cld0.caption = Left(Form.calcDateTime( nYear, -5 , nDay, nHour, nMinute, nSecond ), 8)
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	g_GridCnt = grd0.rowcount
	DATAMANAGER.RequestNextData("obrgt_stpm_002r")
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	szData = grd1.GetCellData("bd_cell0", lRow) & "★" & grd1.GetCellData("bd_cell1", lRow) & "★" & grd1.GetCellData("bd_cell2", lRow)
	
	Form.OpenFramePopup( "mbonl83000_p1" , szData , sPosInfo)
End Sub
'============================================================================
' cld0_OnEditComplete()
'============================================================================
Sub cld0_OnEditComplete()
	Dim szDate
	g_GridCnt = 0
	
	szDate = cld0.caption
	DATAMANAGER.SetDataValue( 0 , "obrgt_stpm_002r", "InBlock1", "RGHT_STND_DATE" , 0 , szDate)
	
	DATAMANAGER.RequestTranData("obrgt_stpm_002r")
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData
	
	if szTranID == "obrgt_stpm_002r" then
		
	'	for i = 0 to grd0.rowcount - 1
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obrgt_stpm_002r", "OutBlock1")
			szData = Form.GetMetaData( "권리유형코드", DATAMANAGER.GetDataValue( 0, "obrgt_stpm_002r", "OutBlock1", "RGHT_TYPE_CODE" , i))
			grd0.SetCellData( "bd_cell1" , i+g_GridCnt , szData)
		next
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	'DATAMANAGER.RequestTranData("obrgt_stpm_002r")
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim subMsg
	
	subMsg = DATAMANAGER.GetDataMsgSubText( "obrgt_stpm_002r" )
	
	if szTranID == "obrgt_stpm_002r" then
		grd0.SetClear()
		Form.MsgBox("알림", szErrMsg&"\n("&subMsg&")", 0, 6)
	end if
	
End Sub




