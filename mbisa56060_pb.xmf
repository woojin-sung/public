'============================================================================
Sub Form_OnFormInit()

'	ACCOUNT =Form.GetSharedData( "&ACCOUNT" , false) 'ACNO
'	Form.ShowAlert( "알림", ACCOUNT )
'	CUST_NUM =Form.GetSharedData( "&CUST_NUM" , false) 'CSNO
'	Form.ShowAlert( "알림", CUST_NUM )
	
	Dim szText
	Form.SetScreenName("투자성향진단")
	
	szText =          "<html><body>투자성향진단서 작성 안내문<br><br>" &
					"①    고객님께서는 자본시장과 금융투자업에 관한 법률 제9조 및 동 법 시행령 제10조(전문투자자의 범위 등)에의거 전문투자자의 범위에 해당하지 않음에 따라 일반투자자로 분류되었음을 알려드립니다.<br><br>" &
					"②    일반투자자로 분류되는 경우에는 전문투자자에 비하여 상기 규정에 의하여 투자권유시 적합성원칙의 엄격한 적용 및 과당매매 거래 권유의 금지 등 고객 보호장치가 적용됨을 알려드립니다.<br>"&
					"※ 증권회사가 일반투자자에게 대하여 부담하는 각종 의무·일중매매거래 및 시스템트레이딩에 대한 위험고지 의무·부적격자의 일반투자자에 대한 투자상담 금지 의무·과당매매거래 권유 금지의무·투자권유의 적합성 (고객 성향 및 위험에 대한 태도에 따른 투자권유의무)·정보미제공 고객님에 대한 미상장(상장이 확정되지 않은 증 권),투자경고, 투자위험, 관리(투자 유의)종목, 투자적격등급이 아니거나 신용등급이 없는 사채권/자산유동화 증권/기업어음 등, 신용거래 및 자산규모에 비추어 결제가 곤란한 증권거래, 파생상품 등 권유 금지<br>"&
					"※ 영업상의 제한·초보 고객님 등에 대한 일중매매거래 및 시스템트레이딩 프로그램 이용 권유 제한<br><br>"&
					"③    고객님께서 상기 규정에 의해 보호받기 위해서는 투자성향진단서에 의거 투자와 관련된 고객정보를 제공하셔야 하며 고객 정보 중 일부만 제공한 경우에는 정보의 범위 내에서만 보호받을 수 있음을 알려드립니다.<br><br>"&
					"④    투자성향진단서는 투자와 관련된 고객 성향을 파악하여 투자조언 내지는 투자권유 등의 근거자료로서 사용 할 것이며, 귀하의 동의없이 기타의 목적으로 사용하지 않습니다.<br><br>"&
					"⑤    고객님께서 투자성향진단서 내용을 변경하고자 하는 경우 신규 작성을 하실 수 있음을 알려드립니다.</body></html>"	
	tab0.page0.web0.loaddata = szText
	Dim sSendData
	
	sSendData = Form.GetOpenLinkData()
	'sSendData = "30083766★3000301102" ' test
	
	'V0003
	IF sSendData  = "" THEN
		'ACNO★CSNO
		sSendData = MID(Form.GetSharedData( "&ACCOUNT" , false),1,8)&"★"&Form.GetSharedData( "&CUST_NUM" , false)
		g_IsNotPopUp = "N"
		tab0.page0.web0.height = 394
		tab0.page0.web0.SetScrollAutoSize()
		tab0.page0.chk0.top = 406
		tab0.page0.chk0.fontsize = 0
		tab0.page0.Label0.top = 438
		tab0.page0.Label0.fontsize = 0
		tab0.page0.btnCancel.top = 473
		tab0.page0.btnCancel.fontsize = 0
		tab0.page0.btnOK.top = 473
		tab0.page0.btnOK.fontsize = 0
		
'		tab0.page1.grd0.height = 382
'		tab0.page1.grd0.fontsize = 0
'		tab0.page1.grd0.SetScrollAutoSize()
'		tab0.page1.btnReg.top = 473
'		tab0.page1.btnReg.fontsize = 0
		
		'Form.ShowAlert( "알림", sSendData ) 
	END IF 
	
	g_szList = Split(sSendData,"★")			

	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
'	'V0003
	if g_szList(0)  = "" then '계좌번호
		Form.ShowAlert( "알림", "로그인 후 진행가능합니다." )
		Exit Sub
	End if
	'V0003
	if g_szList(1)  = "" then '고객번호
		Form.ShowAlert( "알림", "로그인 후 진행가능합니다." )
		Exit Sub
	End if

	nDev = Form.GetSharedData("&SERVER_MODE", 0 )
 
	if nDev == "1" then '개발/테스트
		g_CheckBefDate = "20210317"
	else
		g_CheckBefDate = "20210325"
	end if


	DATAMANAGER.RequestTranData("obcsb_acif_791r")		'전문투자자여부 조회
	DATAMANAGER.RequestTranData("obcsb_acif_290r")		'계좌단위 고객검색  조회
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "GradeConfirm" and sRet == "ok" then
		DATAMANAGER.RequestTranData("obwat_ctad_021a")	'랩KYC등록
	End If
	
	If sKeyName == "CloseForm" then
		'Form.SendReturnToParent( "mbisa56060_pb" , g_sGradCode & g_sGradText ) 'v0005
		Form.SendReturnToParent( "mbisa56060_pb" , g_WA_KYC_GRAD_CODE & g_strTuzaStyle ) 'v0005
		Form.CloseForm()
	End If
End Sub

'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent( "mbisa56060_pb" , g_sGradCode & g_sGradText ) 'v0005
	Form.SendReturnToParent( "mbisa56060_pb" , g_WA_KYC_GRAD_CODE & g_strTuzaStyle ) 'v0005
End Sub

'============================================================================
'동의 버튼
Sub tab0_page0_btnOK_OnClick()
	If tab0.page0.chk0.checkstate == "0" then
		Form.ShowAlert("알림", "상기 안내문을 모두 읽고 체크해주세요.")
		Exit Sub
	End If
	
	tab0.currenttab = "1"
	tab0_OnTabChanged("1") 'v0001
	
	'DATAMANAGER.RequestTranData("obwat_ctad_020r")		'랩KYC조회
	tab0_page1_RadioGroup1_OnClick(0)
End Sub

'============================================================================
'취소 버튼
Sub tab0_page0_btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'초기화 버튼


'============================================================================
'최근투자성향 버튼


'============================================================================
'등록 버튼
Sub tab0_page1_btnReg_OnClick()
	g_sGradCode = ""
	g_sGradText = ""
	  

	'v0005 sta
	
	call SetSeolMoonGridData() '설문 사항 설문지Grid에 입력처리
	
	If tab0.page1.RadioGroup1.currentindex == "0" 
	or tab0.page1.RadioGroup1.currentindex == "1"
	or tab0.page1.RadioGroup1.currentindex == "2"
	Then 'v0001
		If ValidateCheck() == False then
			Exit Sub
		End If
	else
		Form.MsgBox( "알림", "실행은 등록. 변경, 동일 중 선택", "", 0 )
		Exit Sub
	end if 
	
	
	
	If tab0.page1.RadioGroup0.currentindex <> "1" Then '전문투자자가 아닐경우에만 아래 로직 수행
		if Calc_Invt_Grad() <> SUCC THEN
			c_msg = MsgBoxOkCancel ("투자성향 점수 처리중 오류 발생." , "확인" )  
			exit sub
		END IF 
	END IF
	
	
	'v0005 fin
	
	'v0005 sta 주석처리
'	If tab0.page1.RadioGroup0.currentindex = "0" Then 'v0001
'		If ValidateCheck() == False then
'			Exit Sub
'		End If
'	end if 
	'v0005 fin 주석처리
	
	Call CalGrade()	'등급산정
	
	
	
End Sub

'============================================================================
'그리드 체크 박스 체크시
Sub tab0_page1_grd0_OnClickUp(lRow, szCellID)
	Dim sTitleNo, sChk, i

	If szCellID <> "bd_cell0" then
		Exit Sub
	End If
	
	sTitleNo = tab0.page1.grd0.GetCellData("bd_cell2", lRow)
	If CDbl(sTitleNo) == 3 then		'3번 항목은 다중 선택 가능
		'v0005 sta 3번 항목 미체크시 나머지값의 선택여부 0으로 처리
		For i = 0 to tab0.page1.grd0.rowcount - 1
			sChk = tab0.page1.grd0.GetCellData("bd_cell0", i)
			If sTitleNo == tab0.page1.grd0.GetCellData("bd_cell2", i) and sChk <> "1" then
				tab0.page1.grd0.SetCellData("bd_cell0", i, "0")
			End If
		Next
		'v0005 fin
		Exit Sub
	End If
	
	'3번 항목이 아닌 경우, 한 문항당 한 건만 체크할 수 있음
	sChk = tab0.page1.grd0.GetCellData("bd_cell0", lRow)
	If sChk == "1" then
		For i = 0 to tab0.page1.grd0.rowcount - 1
			If sTitleNo == tab0.page1.grd0.GetCellData("bd_cell2", i) and i <> lRow then
				tab0.page1.grd0.SetCellData("bd_cell0", i, "0")
			End If
		Next
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'랩KYC조회 
	If szTranID == "obwat_ctad_020r"  then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO" , 0 , g_szList(1))		'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" , 0 , g_szList(0))	'계좌번호
		if g_CustClsCode = "2" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CORP_YN" , 0 , "Y")	'법인여부
		end if 
		
	End If
	'랩KYC최근설문결과 조회
	If szTranID == "obwat_ctad_024r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO" , 0 , g_szList(1))		'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" , 0 , g_szList(0))	'계좌번호
	End If
	
	'랩KYC등록
	If szTranID == "obwat_ctad_021a" then
		DATAMANAGER.ClearInputData( 0, sTranID ) 'V0001
		Dim i, sPldCode
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO" , 0 , g_szList(1))	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))				'계좌번호
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_KYC_GRAD_CODE" , 0 , g_sGradCode)	'계산한 투자등급코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4")	'접촉구분코드 V0001
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KYC_SPCL_INVR_YN" , 0 , g_sPfin_Invr_yn)'KYC전문투자자여부 V0003
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PXPR_YN" , 0 , "N")	'대리인여부 V0003
		
		'v0005 sta
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_KYC_GRAD_CODE" , 0 , g_WA_KYC_GRAD_CODE)	'계산한 투자등급코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INVT_PRD_CLCD" , 0 , g_INVT_PRD_CLCD)	'계산한 투자등급코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TR_OBJT_GRAD_CODE" , 0 ,g_TR_OBJT_GRAD_CODE)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RISK_RSNT_ABLT_GRAD_CODE" ,0 ,g_RISK_RSNT_ABLT_GRAD_CODE)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TR_INCL_GRAD_CODE" , 0 ,g_TR_INCL_GRAD_CODE)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INVT_PROD_EXPC_GRAD_CODE" , 0 ,g_INVT_PROD_EXPC_GRAD_CODE)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "EXPL_INTR_ABLT_GRAD_CODE" , 0 ,g_EXPL_INTR_ABLT_GRAD_CODE)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ITEM_OVRL_INVT_INCL_GRAD" , 0 ,g_ITEM_OVRL_INVT_INCL_GRAD)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SFDI_INVT_INCL_GRAD" , 0 ,g_SFDI_INVT_INCL_GRAD)
		'v0005 fin
		
		For i = 0 to tab0.page1.grd0.rowcount - 1
			If CDbl(tab0.page1.grd0.GetCellData("bd_cell2", i)) == 2 and tab0.page1.grd0.GetCellData("bd_cell0", i) == "0" then
				sPldCode = Right(tab0.page1.grd0.GetCellData("bd_cell3", i), 2)
			End If
		Next
		'v0005 sta 주석처리
'		if g_sPfin_Invr_yn = "Y" then 'v0001
'			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INVT_PRD_CLCD" , 0 , "00")		'2번항목 답변번호 끝 2자리
'		else
'			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INVT_PRD_CLCD" , 0 , sPldCode)		'2번항목 답변번호 끝 2자리
'		end if 
		'v0005 fin 주석처리
		
		IF tab0.page1.grd0.rowcount - 1 >= 0 THEN 'V0001 조건문 추가
		For i = 0 to tab0.page1.grd0.rowcount - 1
				DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "QUES_QSIT_NO" , i , tab0.page1.grd0.GetCellData("bd_cell2", i))	'질문번호
				'답변번호(질문일 경우 0) : 답변번호값이 조회시(11자리)와 등록시(10자리) 자릿수가 달라, Right 처리
				DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ITEM_NO_VAL"  , i , Right(tab0.page1.grd0.GetCellData("bd_cell3", i), 10))	
				'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ITEM_CNTT"    , i , tab0.page1.grd0.GetCellData("bd_cell1", i))	'문항내용 v0004
				'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PRT_CNTT"    , i , tab0.page1.grd0.GetCellData("bd_cell1", i))	'문항내용 v0004 V0005
				DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "INVT_INCL_QUES_QSIT_CNTT"    , i , tab0.page1.grd0.GetCellData("bd_cell1", i))	'문항내용 v0004
				DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WGHN_SCOR"    , i , tab0.page1.grd0.GetCellData("bd_cell4", i))	'점수
				DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "RSPN_SLCT_YN" , i , tab0.page1.grd0.GetCellData("bd_cell0", i))	'체크여부
			Next
		END IF
	End If 
	
	' 전문투자자여부 조회
	If szTranID == "obcsb_acif_791r" then	'v0001
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"  , 0 , g_szList(0))	
	End If
	
	'계좌단위고객검색
	If szTranID == "obcsb_acif_290r" then 'v0005
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"  , 0 , g_szList(1))	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "2")	'고객번호로 계좌단위 고객검색
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_CLS_CODE"  , 0 , "3")	'정상, 통합계좌 상태 조회
	end if 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'랩KYC조회
	If szTranID == "obwat_ctad_020r" then	
		Dim nCnt		
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock3" )

		If nCnt == 0 then
			Exit Sub
		End If
		
		'v0005 sta
		call set_grid0_CellChange()
		
		call SetInvtIncl()
		call SetContainer(1)
		call set_RadioGroup1(DATAMANAGER.GetDataMsgCode( "obwat_ctad_020r" ), DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "REG_DATE" , 0))
'		Call SetGridData()
'		
'		If DATAMANAGER.GetDataMsgCode( "obwat_ctad_020r" ) == "5822" Then
'			tab0.page1.RadioGroup1.enableindex = "0,1"
'			tab0.page1.RadioGroup1.enableindex = "1,0"
'			tab0.page1.RadioGroup1.enableindex = "2,0"
'			tab0.page1.RadioGroup1.enableindex = "3,0"
'			tab0.page1.RadioGroup1.currentindex = "0"
'		Else
'			tab0.page1.RadioGroup1.enableindex = "0,0"
'			tab0.page1.RadioGroup1.enableindex = "1,1"
'			tab0.page1.RadioGroup1.enableindex = "2,1"
'			tab0.page1.RadioGroup1.enableindex = "3,1"
'			tab0.page1.RadioGroup1.currentindex = "1"
'		End I
		'v0005 fin
	End If
	
	'랩KYC최근설문결과 조회
	If szTranID == "obwat_ctad_024r" then
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WA_KYC_GRAD_CODE" , 0) = "00" and g_sPfin_Invr_yn = "Y"  then	 'v0001
			tab0.page1.RadioGroup0.currentindex = 1
			tab0_page1_RadioGroup0_OnClick(1) 'v0005
		else
			If DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock3") == 0 then
				Form.MsgBox( "알림", "최근 투자성향진단 등록 내용이 없습니다.", "", 0 )
				DATAMANAGER.RequestTranData("obwat_ctad_020r")		'랩KYC조회
				Exit Sub
			End If
		end if
	
		Dim sVal, i
		sVal = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CODE_VALD_VAL_KOR_NAME" , 0)	
		tab0.page1.tbl0.SetCellString( 0, 0, sVal)

		'v0005 sta
		g_RegDate = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "REG_DATE" , 0)
		call set_grid0_CellChange()
		
		call SetInvtIncl()
		call SetContainer(2)
		call set_RadioGroup1(DATAMANAGER.GetDataMsgCode( "obwat_ctad_024r" ),g_RegDate )
'		For i = 0 to tab0.page1.grd0.rowcount-1
'			If g_sPros_Index == 2 or g_sPros_Index == 3 or CDbl(tab0.page1.grd0.GetCellData( "bd_cell3", i )) == 0 then
'				tab0.page1.grd0.SetCellEnable("bd_cell0", i, 0)		'타이틀 체크박스 Disable
'				if CDbl(tab0.page1.grd0.GetCellData( "bd_cell3", i )) == 0 Then
'					tab0.page1.grd0.SetCellFgColor("bd_cell1", i, "128")	'타이틀 빨강색 표시
'				end if
'			End If
'		Next
'		
'		If DATAMANAGER.GetDataMsgCode( "obwat_ctad_024r" ) == "5822" Then
'			tab0.page1.RadioGroup1.enableindex = "0,1"
'			tab0.page1.RadioGroup1.enableindex = "1,0"
'			tab0.page1.RadioGroup1.enableindex = "2,0"
'			tab0.page1.RadioGroup1.enableindex = "3,0"
'		Else
'			tab0.page1.RadioGroup1.enableindex = "0,0"
'			tab0.page1.RadioGroup1.enableindex = "1,1"
'			tab0.page1.RadioGroup1.enableindex = "2,1"
'			tab0.page1.RadioGroup1.enableindex = "3,1"
'		End If
		'v0005 fin
	End If
	
	'랩KYC등록
	If szTranID == "obwat_ctad_021a" then	
		Form.MsgBox( "알림", "투자성향진단 등록이 완료되었습니다."&chr(10)&"투자자정보 또는 이메일·전화번호 등이 변경된 경우에는 반드시 회사에 통지하여 주시기 바랍니다.", "CloseForm", 0 )
		if g_IsNotPopUp = "N" then
			tab0.page1.btnReg.enable = FALSE
		end if 
	End If
	
	'v0001 
	If szTranID == "obcsb_acif_791r" then	
		g_sPfin_Invr_yn =  DATAMANAGER.GetDataValue( 0 , "obcsb_acif_791r" , "OutBlock1", "KYC_SPCL_INVR_YN" , 0) 
	End If
	
	'계좌단위고객검색 v0005
	If szTranID == "obcsb_acif_290r" then 
		g_CustClsCode =  DATAMANAGER.GetDataValue( 0 , "obcsb_acif_290r" , "OutBlock1", "CUST_CLS_CODE" , 0) 
	end if 

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
Sub tab0_OnTabChanged(nCurrentTab)
	if nCurrentTab =  "1" then
		' 전문투자자여부 조회
		If g_sPfin_Invr_yn  = "Y" then
			Form.SetCtlProp( "tab0.page1.RadioGroup0" , "visible", "1")
			Form.SetCtlProp( "tab0.page1.Label1" , "visible", "1")
			'tab0.page0.RadioGroup1.SetRadioCaption( -1, "" )
		Else
			Form.SetCtlProp( "tab0.page1.RadioGroup0" , "visible", "0")
			Form.SetCtlProp( "tab0.page1.Label1" , "visible", "0")
		End If
		
		if g_IsNotPopUp = "N" then 'v0003
			tab0.page1.grd0.height = 382
			tab0.page1.grd0.fontsize = 0
			'v0005 sta
			tab0.page1.Container0.height = 382
			'v0005 fin
			tab0.page1.grd0.SetScrollAutoSize()
			tab0.page1.btnReg.top = 473
			tab0.page1.btnReg.fontsize = 0
		
		end if 
	end if 
End Sub

'============================================================================
Sub tab0_page1_RadioGroup0_OnClick(nIndex)
	if nIndex = 1 then
		tab0.page1.grd0.SetClear()
		tab0.page1.grd0.enable = false
		'v0005
		call DisableInvtController()
	else
		tab0.page1.grd0.enable = true
		tab0.page1.grd0.SetClear()
		DATAMANAGER.RequestTranData("obwat_ctad_020r")		'랩KYC조회
	end if 
	
End Sub

'============================================================================
Sub tab0_page1_RadioGroup1_OnClick(nIndex)
' 0: 등록 1: 변경 2: 동일 3: 조회 4: 초기화
     Select Case nIndex
	     Case 0 ' 등록
		     g_sPros_Index = nIndex
	     	tab0.page1.grd0.SetClear()
			DATAMANAGER.RequestTranData("obwat_ctad_020r")		'랩KYC 조회
			tab0.page1.grd0.Enable = True
			tab0.page1.RadioGroup0.Enable = True
			tab0.page1.btnClear.enable = True
			tab0.page1.btnReg.enable = True
	     Case 1 ' 변경
		     g_sPros_Index = nIndex
		     tab0.page1.RadioGroup0.currentindex = "0"
			tab0_page1_RadioGroup0_OnClick(0)
			tab0.page1.tbl0.SetCellString( 0, 0, "")
			tab0.page1.btnClear.enable = True
			tab0.page1.RadioGroup0.Enable = True
			tab0.page1.btnReg.enable = True
	     Case 2 ' 동일
		     g_sPros_Index = nIndex
		     tab0.page1.tbl0.SetCellString( 0, 0, "")
		     tab0.page1.grd0.SetClear()
			DATAMANAGER.RequestTranData("obwat_ctad_024r")		'랩KYC최근설문결과 조회
			tab0.page1.grd0.Enable = False
			tab0.page1.RadioGroup0.Enable = False
			For i = 0 to tab0.page1.grd0.rowcount - 1
				tab0.page1.grd0.SetCellEnable("bd_cell0", i, "0")
			Next
			tab0.page1.btnClear.enable = False
			tab0.page1.btnReg.enable = True
	     Case 3 ' 조회
		     g_sPros_Index = nIndex
		     tab0.page1.grd0.SetClear()
			DATAMANAGER.RequestTranData("obwat_ctad_024r")		'랩KYC최근설문결과 조회
			tab0.page1.grd0.Enable = False
			tab0.page1.RadioGroup0.Enable = False
			tab0.page1.btnClear.enable = False
			tab0.page1.btnReg.enable = False
	     Case 4 ' 초기화
			For i = 0 to tab0.page1.grd0.rowcount - 1
				tab0.page1.grd0.SetCellData("bd_cell0", i, "0")
			Next

			SetContainer(1) 'v0005
		Case else '미선택 v0005
		     g_sPros_Index = nIndex
		     tab0.page1.btnReg.enable = False
	 End Select
	 
End Sub


'============================================================================
Sub tab0_page1_btnClear_OnClick()
	tab0_page1_RadioGroup1_OnClick(4)
End Sub

'============================================================================ v0005
Sub set_grid0_CellChange()
	For i = 0 to tab0.page1.grd0.rowcount-1
		If g_sPros_Index == 2 or g_sPros_Index == 3 or getNumber(tab0.page1.grd0.GetCellData( "bd_cell3", i )) == 0 then
			tab0.page1.grd0.SetCellEnable("bd_cell0", i, 0)		'타이틀 체크박스 Disable
			if getNumber(tab0.page1.grd0.GetCellData( "bd_cell3", i )) == 0 Then
				tab0.page1.grd0.SetCellFgColor("bd_cell1", i, "128")	'타이틀 빨강색 표시
			end if
		End If
	Next
End Sub
'============================================================================ v0005
Sub set_RadioGroup1(msgcode,regdate)
	If msgcode == "5822" Then
		tab0.page1.RadioGroup1.enableindex = "0,1"
		tab0.page1.RadioGroup1.enableindex = "1,0"
		tab0.page1.RadioGroup1.enableindex = "2,0"
		tab0.page1.RadioGroup1.enableindex = "3,0"
		
		if tab0.page1.RadioGroup1.currentindex == "-1" then
			tab0.page1.RadioGroup1.currentindex = "0"
		end if 
	Else
		tab0.page1.RadioGroup1.enableindex = "0,0"
		tab0.page1.RadioGroup1.enableindex = "1,1"
		tab0.page1.RadioGroup1.enableindex = "2,1"
		tab0.page1.RadioGroup1.enableindex = "3,1"
		
		if regdate < g_CheckBefDate then
			tab0.page1.RadioGroup1.enableindex = "2,0"
			tab0.page1.RadioGroup1.enableindex = "3,0"
			tab0.page1.RadioGroup1.currentindex = "1"
		elseif tab0.page1.RadioGroup1.currentindex == "-1" then
			tab0.page1.RadioGroup1.currentindex = "3"
		end if 
	End If
	
	
'	if tab0.page1.RadioGroup1.currentindex == "-1" then
'		g_sPros_Index = nIndex
'		tab0.page1.btnReg.enable = False
'	end if 
End sub

'============================================================================ v0005
Function getNumber(str)
    if len(Trim(str)) = 0 Then
	    str = 0 
    End if
    getNumber = Int(str)
End Function
'============================================================================ 
'1단계: 항목별 등급 및 종합등급 산정	
'	
'□ 1차 항목별 등급 산정	
'	
' (1) 거래목적	
'  - 점수산정 : "8번 점수" (5점 만점)	
'  - 등급산정 : 1등급(5점 이상), 2등급(4점 이상), 3등급(3점 이상), 4등급(2점 이상), 5등급(2점 미만)	
'	
' (2) 위험감수능력	
' * 개인의 경우	
'  - 점수산정 : "1번 점수" + "2번 점수" + "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" + "10번 점수" (34점 만점)	
'  - 등급산정 : 1등급(29점 이상), 2등급(24점 이상), 3등급(19점 이상), 4등급(14점 이상), 5등급(14점 미만)	
'	
' * 법인의 경우	
'  - 점수산정 : "2번 점수" + "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" (25점 만점)	
'  - 등급산정 : 1등급(21점 이상), 2등급(16점 이상), 3등급(12점 이상), 4등급(8점 이상), 5등급(8점 미만)	
'	
' (3) 거래성향	
'  - 점수산정 : "3번 점수" + "5번 점수" + "7번 점수" + "11번 점수" (21점 만점)	
'  - 등급산정 : 1등급(17점 이상), 2등급(13점 이상), 3등급(9점 이상), 4등급(5점 이상), 5등급(5점 미만)	
'	
' (4) 투자성 상품을 취득, 처분한 경험	
'  - 점수산정 : "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" + "9번 점수" (24점 만점)	
'  - 등급산정 : 1등급(20점 이상), 2등급(16점 이상), 3등급(12점 이상), 4등급(8점 이상), 5등급(8점 미만)	
'	
' (5) 법 제10조에 따른 설명을 이해할 수 있는 능력	
'  - 점수산정 : "3번 점수" + "4번 점수" + "9번 점수" (13점 만점)	
'  - 등급산정 : 1등급(11점 이상), 2등급(9점 이상), 3등급(7점 이상), 4등급(5점 이상), 5등급(5점 미만)	
'	
'	
'□ 종합등급 산정	
'	
'○(1) ~ (5) 까지의 등급을 아래와 같은 비중으로 가중 합산 (총점100점)	
'  - 등급별 점수 : 1등급 : 10점, 2등급 : 8점, 3등급 : 6점, 4등급 4점, 5등급 : 2점	
'  - 점수산정방식 : (1)점수 * 2 + (2)점수 * 2 + (3)점수 * 2 + (4)점수 * 2 + (5)점수 * 2	
'	
'□투자성향분류	
'	
'○점수결과에 따라 고객의 투자성향을 5단계로 분류	
'   ▶20점이하: 이자소득형	
'   ▶20점초과~ 40점이하: 안정지향형	
'   ▶40점초과~ 60점이하: 중립형	
'   ▶60점초과~ 80점이하: 성장지향형	
'   ▶80점초과: 고수익지향형	
'	
'2단계: 자가진단투자성향도출	
'	
'○8번: 배점은 없으며, 투자자의 선택 결과를 적용	
'          (예) 안정지향형, 적극투자형등	
'	
'3단계: 최종투자성향도출	
'	
'○1단계의 진단값과 2단계의 진단값중 하위값 적용	
'   (예) 1단계: 성장지향형& 2단계: 중립형→ 최종: 중립형	
'         1단계: 중립형& 2단계: 성장지향형→ 최종: 중립형	
'	
'============================================================================ 
function Calc_Invt_Grad() 'v0005
    '변수 초기화
    Calc_Invt_Grad = SUCC
    
    g_TR_OBJT_GRAD_CODE =  "" '거래목적등급코드  (01:1등급 02:2등급 03:3등급 04:4등급 05:5등급)
    g_RISK_RSNT_ABLT_GRAD_CODE =  "" '위험감수능력등급코드  (01:1등급 02:2등급 03:3등급 04:4등급 05:5등급)
    g_TR_INCL_GRAD_CODE =  "" '거래성향등급코드  (01:1등급 02:2등급 03:3등급 04:4등급 05:5등급)
    g_INVT_PROD_EXPC_GRAD_CODE =  "" '투자상품경험등급코드  (01:1등급 02:2등급 03:3등급 04:4등급 05:5등급)
    g_EXPL_INTR_ABLT_GRAD_CODE =  "" '설명이해능력등급코드  (01:1등급 02:2등급 03:3등급 04:4등급 05:5등급)
    g_ITEM_OVRL_INVT_INCL_GRAD =  "" '항목종합투자성향등급  (01:고수익지향형 02:성장지향형 03:중립형 04:안정지향형 05:이자소득형)
    g_SFDI_INVT_INCL_GRAD =  "" '자가진단투자성향등급 (01:고수익지향형 02:성장지향형 03:중립형 04:안정지향형 05:이자소득형)
    g_WA_KYC_GRAD_CODE =  "" '랩어카운트KYC등급코드 (01:고수익지향형 02:성장지향형 03:중립형 04:안정지향형 05:이자소득형)
    g_INVT_PRD_CLCD =  "" '투자기간구분코드 (01:6개월미만 02:6개월이상~1년미만 03:1년이상~2년미만 04:2년이상~3년미만 05:2년이상~3년미만)
    g_strTuzaStyle = "" '투자성향 한글

    tr_objt_grad_code_score = 0 '거래목적점수
    risk_rsnt_ablt_grad_code_score = 0 '위험감수능력점수
    tr_incl_grad_code_score = 0 '거래성향점수
    invt_prod_expc_grad_code_score = 0
    expl_intr_ablt_grad_code_score = 0
    
    maxScore = 0
    
    
    '3번은 중복체크가 가능하므로 일반적 계산에서 제외시킨다. -> 두개를 골랐다면..그중에 점수가 큰것을 기준으로..
    For i = 0 to tab0.page1.grd0.rowcount - 1
        if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 3 Then
            If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then '체크박스 체크여부
	            if Int(maxScore) < Int(tab0.page1.grd0.GetCellData("bd_cell4", i)) Then
	                maxScore = Int(tab0.page1.grd0.GetCellData("bd_cell4", i)) 
			    end if
		    end if 
	    End if
    next
    
    '3번 점수를 미리 계산함
    risk_rsnt_ablt_grad_code_score = risk_rsnt_ablt_grad_code_score + maxScore
    tr_incl_grad_code_score        = tr_incl_grad_code_score + maxScore
    invt_prod_expc_grad_code_score = invt_prod_expc_grad_code_score + maxScore
    expl_intr_ablt_grad_code_score = expl_intr_ablt_grad_code_score + maxScore
    
    For i = 0 to tab0.page1.grd0.rowcount - 1
	    '□ 1차 항목별 등급 산정	
        ' (1) 거래목적
	    '  - 점수산정 : "8번 점수" (5점 만점)
	    '  - 등급산정 : 1등급(5점 이상), 2등급(4점 이상), 3등급(3점 이상), 4등급(2점 이상), 5등급(2점 미만)
        if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 8 then
            If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then '체크박스 체크여부
			    tr_objt_grad_code_score = tr_objt_grad_code_score + Int(tab0.page1.grd0.GetCellData("bd_cell4", i))
		    end if 
		end if 
		   	    
		' (2) 위험감수능력	
		' * 개인의 경우	
		'  - 점수산정 : "1번 점수" + "2번 점수" + "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" + "10번 점수" (34점 만점)	
		'  - 등급산정 : 1등급(29점 이상), 2등급(24점 이상), 3등급(19점 이상), 4등급(14점 이상), 5등급(14점 미만)	
		'	
		' * 법인의 경우	
		'  - 점수산정 : "2번 점수" + "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" (25점 만점)	
		'  - 등급산정 : 1등급(21점 이상), 2등급(16점 이상), 3등급(12점 이상), 4등급(8점 이상), 5등급(8점 미만)	
		If g_CustClsCode = "1" Then '개인
			   if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 1 or
			       getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 2 or
			       getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 5 or
			       getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 6 or
			       getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 8 or
			       getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 10
			   then
			       If tab0.page1.grd0.GetCellData("bd_cell0", i) = "1" Then '체크박스 체크여부
					     risk_rsnt_ablt_grad_code_score = risk_rsnt_ablt_grad_code_score + Int(tab0.page1.grd0.GetCellData("bd_cell4", i))
					 end if 
			   end if 
		ELSEIf g_CustClsCode = "2" Then '법인
			if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 2 or
			    getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 5 or
			    getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 6 or
			    getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 8
			then
			    If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then '체크박스 체크여부
				    risk_rsnt_ablt_grad_code_score = risk_rsnt_ablt_grad_code_score + Int(tab0.page1.grd0.GetCellData("bd_cell4", i))
			    end if 
		    end if 
		end if 
		    
        ' (3) 거래성향	
		'  - 점수산정 : "3번 점수" + "5번 점수" + "7번 점수" + "11번 점수" (21점 만점)	
		'  - 등급산정 : 1등급(17점 이상), 2등급(13점 이상), 3등급(9점 이상), 4등급(5점 이상), 5등급(5점 미만)
		if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 5 or
		   getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 7 or
		   getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 11
		then
		    If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then '체크박스 체크여부
			    tr_incl_grad_code_score = tr_incl_grad_code_score + Int(tab0.page1.grd0.GetCellData("bd_cell4", i))
		    end if 
		end if
		
		
		' (4) 투자성 상품을 취득, 처분한 경험	
		'  - 점수산정 : "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" + "9번 점수" (24점 만점)	
		'  - 등급산정 : 1등급(20점 이상), 2등급(16점 이상), 3등급(12점 이상), 4등급(8점 이상), 5등급(8점 미만)	
		if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 5 or
		   getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 6 or
		   getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 8 or
		   getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 9
		then
            If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then '체크박스 체크여부
				    invt_prod_expc_grad_code_score = invt_prod_expc_grad_code_score + Int(tab0.page1.grd0.GetCellData("bd_cell4", i))
			   end if 
		end if

		
		' (5) 법 제10조에 따른 설명을 이해할 수 있는 능력	
		'  - 점수산정 : "3번 점수" + "4번 점수" + "9번 점수" (13점 만점)	
		'  - 등급산정 : 1등급(11점 이상), 2등급(9점 이상), 3등급(7점 이상), 4등급(5점 이상), 5등급(5점 미만)	
		if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 4 or
		   getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 9
		then
             If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then '체크박스 체크여부
                 expl_intr_ablt_grad_code_score = expl_intr_ablt_grad_code_score + Int(tab0.page1.grd0.GetCellData("bd_cell4", i))
             end if 
        end if
	    
				
		'투자기간 계산
		if getNumber(tab0.page1.grd0.GetCellData("bd_cell2", i )) == 2 Then 
		    If tab0.page1.grd0.GetCellData("bd_cell0", i) == "1" Then
			    '기간구분코드를 셋팅한다.
			    g_INVT_PRD_CLCD = "0"&Int(tab0.page1.grd0.GetCellData("bd_cell3", i ))
		    end if
        End if
    Next
'------------------------------------------------------------------------------------------------------------

    
    '1차 항목별 등급 산정처리
    ' (1) 거래목적
    '  - 점수산정 : "8번 점수" (5점 만점)
    '  - 등급산정 : 1등급(5점 이상), 2등급(4점 이상), 3등급(3점 이상), 4등급(2점 이상), 5등급(2점 미만)
	 if     tr_objt_grad_code_score >= 5 then '1등급 
	     g_TR_OBJT_GRAD_CODE = "01" 
	     score1 = 10 
	 elseif tr_objt_grad_code_score  >= 4 then '2등급 
	     g_TR_OBJT_GRAD_CODE = "02" 
	     score1 = 8 
	 elseif tr_objt_grad_code_score  >= 3 then '3등급 
	     g_TR_OBJT_GRAD_CODE = "03" 
	     score1 = 6 
	 elseif tr_objt_grad_code_score  >= 2 then '4등급 
	     g_TR_OBJT_GRAD_CODE = "04" 
	     score1 = 4 
	 elseif tr_objt_grad_code_score <  2 then '5등급 
	     g_TR_OBJT_GRAD_CODE = "05" 
	     score1 = 2 
	 end if 
    
	 ' (2) 위험감수능력	
	 ' * 개인의 경우	
	 '  - 점수산정 : "1번 점수" + "2번 점수" + "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" + "11번 점수" (34점 만점)	
	 '  - 등급산정 : 1등급(29점 이상), 2등급(24점 이상), 3등급(19점 이상), 4등급(14점 이상), 5등급(14점 미만)	
	 '	
	 ' * 법인의 경우	
	 '  - 점수산정 : "2번 점수" + "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" (25점 만점)	
	 '  - 등급산정 : 1등급(21점 이상), 2등급(16점 이상), 3등급(12점 이상), 4등급(8점 이상), 5등급(8점 미만)	
    If g_CustClsCode = "1" Then '개인
    	if     risk_rsnt_ablt_grad_code_score >= 29 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "01" 
		    score2 = 10 '1등급 
	    elseif risk_rsnt_ablt_grad_code_score >= 24 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "02" 
		    score2 = 8 '2등급 
	    elseif risk_rsnt_ablt_grad_code_score >= 19 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "03" 
		    score2 = 6 '3등급 
	    elseif risk_rsnt_ablt_grad_code_score >= 14 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "04" 
		    score2 = 4 '4등급 
	    elseif risk_rsnt_ablt_grad_code_score <  14 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "05" 
		    score2 = 2 '5등급 
	    end if 
    ELSEIf g_CustClsCode = "2" Then '법인
    	if     risk_rsnt_ablt_grad_code_score >= 21 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "01" 
		    score2 = 10 '1등급 
	    elseif risk_rsnt_ablt_grad_code_score >= 16 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "02" 
		    score2 = 8 '2등급 
	    elseif risk_rsnt_ablt_grad_code_score >= 12 then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "03" 
		    score2 = 6 '3등급 
	    elseif risk_rsnt_ablt_grad_code_score >= 8  then
		    g_RISK_RSNT_ABLT_GRAD_CODE = "04" 
		    score2 = 4 '4등급 
	    elseif risk_rsnt_ablt_grad_code_score <  8  then 
		    g_RISK_RSNT_ABLT_GRAD_CODE = "05" 
		    score2 = 2 '5등급 
	    end if 	
    END IF
    
    ' (3) 거래성향	
    '  - 점수산정 : "3번 점수" + "5번 점수" + "7번 점수" + "11번 점수" (21점 만점)	
    '  - 등급산정 : 1등급(17점 이상), 2등급(13점 이상), 3등급(9점 이상), 4등급(5점 이상), 5등급(5점 미만)
    if     tr_incl_grad_code_score >= 17 then 
	     g_TR_INCL_GRAD_CODE = "01" 
	     score3 = 10 '1등급 
    elseif tr_incl_grad_code_score  >= 13 then 
	     g_TR_INCL_GRAD_CODE = "02" 
	     score3 = 8 '2등급 
    elseif tr_incl_grad_code_score  >=  9 then 
	     g_TR_INCL_GRAD_CODE = "03" 
	     score3 = 6 '3등급 
    elseif tr_incl_grad_code_score  >=  5 then 
	     g_TR_INCL_GRAD_CODE = "04" 
	     score3 = 4 '4등급 
    elseif tr_incl_grad_code_score <   5 then 
	     g_TR_INCL_GRAD_CODE = "05" 
	     score3 = 2 '5등급 
    end if 
	
    ' (4) 투자성 상품을 취득, 처분한 경험	
    '  - 점수산정 : "3번 점수" + "5번 점수" + "6번 점수" + "8번 점수" + "9번 점수" (24점 만점)	
    '  - 등급산정 : 1등급(20점 이상), 2등급(16점 이상), 3등급(12점 이상), 4등급(8점 이상), 5등급(8점 미만)	
    if     invt_prod_expc_grad_code_score >= 20 then 
		g_INVT_PROD_EXPC_GRAD_CODE = "01" 
		score4 = 10 '1등급 
    elseif invt_prod_expc_grad_code_score  >= 16 then 
	    g_INVT_PROD_EXPC_GRAD_CODE = "02" 
	    score4 = 8 '2등급 
    elseif invt_prod_expc_grad_code_score  >=  12 then 
	    g_INVT_PROD_EXPC_GRAD_CODE = "03" 
	    score4 = 6 '3등급 
    elseif invt_prod_expc_grad_code_score  >=  8 then 
	    g_INVT_PROD_EXPC_GRAD_CODE = "04" 
	    score4 = 4 '4등급 
    elseif invt_prod_expc_grad_code_score <   8 then 
	    g_INVT_PROD_EXPC_GRAD_CODE = "05" 
	    score4 = 2 '5등급 
    end if 
	
    ' (5) 법 제10조에 따른 설명을 이해할 수 있는 능력	
    '  - 점수산정 : "3번 점수" + "4번 점수" + "9번 점수" (13점 만점)	
	 '  - 등급산정 : 1등급(11점 이상), 2등급(9점 이상), 3등급(7점 이상), 4등급(5점 이상), 5등급(5점 미만)	
    if expl_intr_ablt_grad_code_score >= 11 then 
	     g_EXPL_INTR_ABLT_GRAD_CODE = "01" 
	     score5 = 10 '1등급 
	 elseif expl_intr_ablt_grad_code_score  >=  9 then 
	     g_EXPL_INTR_ABLT_GRAD_CODE = "02" 
	     score5 = 8 '2등급 
	 elseif expl_intr_ablt_grad_code_score  >=  7 then 
	     g_EXPL_INTR_ABLT_GRAD_CODE = "03" 
	     score5 = 6 '3등급 
	 elseif expl_intr_ablt_grad_code_score  >=  5 then 
	     g_EXPL_INTR_ABLT_GRAD_CODE = "04" 
	     score5 = 4 '4등급 
	 elseif expl_intr_ablt_grad_code_score <   5 then 
	     g_EXPL_INTR_ABLT_GRAD_CODE = "05" 
	     score5 = 2 '5등급 
	 end if 
	
	
	 '□ 종합등급 산정	
    '	
    '○(1) ~ (5) 까지의 등급을 아래와 같은 비중으로 가중 합산 (총점100점)	
    '  - 등급별 점수 : 1등급 : 10점, 2등급 : 8점, 3등급 : 6점, 4등급 4점, 5등급 : 2점	
    '  - 점수산정방식 : (1)점수 * 2 + (2)점수 * 2 + (3)점수 * 2 + (4)점수 * 2 + (5)점수 * 2	
    sum_score = (score1 + score2 + score3 + score4 + score5) *2 
    
'    msgbox sum_score
    '□투자성향분류	
    '	
    '○점수결과에 따라 고객의 투자성향을 5단계로 분류	
    '   ▶20점이하: 이자소득형	
    '   ▶20점초과~ 40점이하: 안정지향형	
    '   ▶40점초과~ 60점이하: 중립형	
    '   ▶60점초과~ 80점이하: 성장지향형	
    '   ▶80점초과: 고수익지향형	
    For i = 0 to tab0.page1.grdGrade.rowcount - 1
		nFrom = CDbl(tab0.page1.grdGrade.GetCellData("bd_cell2", i))
		nTo = CDbl(tab0.page1.grdGrade.GetCellData("bd_cell3", i))
	    if nFrom <= sum_score and sum_score <= nTo Then
		    g_ITEM_OVRL_INVT_INCL_GRAD    = tab0.page1.grdGrade.GetCellData("bd_cell0", i)
		    ITEM_OVRL_INVT_INCL_GRAD_NAME = tab0.page1.grdGrade.GetCellData("bd_cell1", i)
		    Exit For
	    End if
    Next
	
    '2단계: 자가진단투자성향도출	
    '	
    '○8번: 배점은 없으며, 투자자의 선택 결과를 적용	
    '          (예) 안정지향형, 적극투자형등	
    For i = 0 to tab0.page1.grdGrade.rowcount - 1
    		nFrom = CDbl(tab0.page1.grdGrade.GetCellData("bd_cell2", i))
		nTo = CDbl(tab0.page1.grdGrade.GetCellData("bd_cell3", i))
	     if nFrom <= tr_objt_grad_code_score*20 and tr_objt_grad_code_score*20 <= nTo Then
		      g_SFDI_INVT_INCL_GRAD    = tab0.page1.grdGrade.GetCellData("bd_cell0", i)
		      SFDI_INVT_INCL_GRAD_NAME = tab0.page1.grdGrade.GetCellData("bd_cell1", i)
		      Exit For
	     End if
    Next
    

    '3단계: 최종투자성향도출	
    '	
    '○1단계의 진단값과 2단계의 진단값중 하위값 적용	
    '   (예) 1단계: 성장지향형& 2단계: 중립형→ 최종: 중립형	
    '         1단계: 중립형& 2단계: 성장지향형→ 최종: 중립형
    if  g_ITEM_OVRL_INVT_INCL_GRAD >= g_SFDI_INVT_INCL_GRAD then
	     g_WA_KYC_GRAD_CODE = g_ITEM_OVRL_INVT_INCL_GRAD
	     g_strTuzaStyle     =   ITEM_OVRL_INVT_INCL_GRAD_NAME 
    else 
	     g_WA_KYC_GRAD_CODE = g_SFDI_INVT_INCL_GRAD
	     g_strTuzaStyle     =    SFDI_INVT_INCL_GRAD_NAME 
    end if


    if len(g_INVT_PRD_CLCD)== 0 Then
	    if g_CustClsCode == "1" Then
		    Form.ShowAlert("알림", "2번문항은 고객의 투자기간을 체크하는 필수값입니다.")
	    Else
		    Form.ShowAlert("알림", "1번문항은 고객의 투자기간을 체크하는 필수값입니다.")
	    End if
	    Calc_Invt_Grad = FAIL
    End if
    

End Function
'============================================================================ v0005
Sub SetInvtIncl()
	LabelYn = "Y"
	ContainerSize = 375'tab0.page1.Container0.width
	
	SeolMoonLeft = 0
	SeolMoonHeight = 50
	SeolMoonWidth = ContainerSize 
	GapHeight = 20 '각 설문간 갭을 두기위함
	
	'현재높이위치
	CurrTopLocation = 0
	
	CurrProsCodeIndex = tab0.page1.RadioGroup1.currentindex
	
	'개인/고객별 최초 설문 시작 문항 -1
	If g_CustClsCode = "1" Then '개인 
		bef_set_ques_qsit_no = -1
	else
		bef_set_ques_qsit_no = 0
	end if 
	
	'투자성향설문용 컨트롤러 일괄 Disable처리
	call DisableInvtController()

	For i = 0 to tab0.page1.grd0.rowcount - 1 
		set_rspn_slct_yn 				= tab0.page1.grd0.GetCellData( "bd_cell0", i) '체크여부
		set_invt_incl_ques_qsit_cntt 	= tab0.page1.grd0.GetCellData( "bd_cell1", i) '설문내용
		set_ques_qsit_no 				= getNumber(tab0.page1.grd0.GetCellData( "bd_cell2", i)) '설문문항
		set_item_no 					= getNumber(tab0.page1.grd0.GetCellData( "bd_cell3", i)) '설문문제세부번호

		'설문으로 사용하는 컨트롤러에 대해서 활성화 처리
		Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, 	"visible", TRUE)
		Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, 				"visible", TRUE)
		Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no  , 	"visible", TRUE)

		
		if set_item_no == 0 then '설문문항
			If g_CustClsCode = "1" Then '개인
				if set_ques_qsit_no <> 1 then
					CurrTopLocation = CurrTopLocation + GapHeight
				end if 
			elseIf g_CustClsCode = "2" Then '법인
				if set_ques_qsit_no <> 2 then
					CurrTopLocation = CurrTopLocation + GapHeight
				end if 
			end if 
			
			'현재 설문문항 위치 저장
			bef_set_ques_qsit_no  = set_ques_qsit_no
			
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "caption", set_invt_incl_ques_qsit_cntt)
			
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "fontsize", "-2")

			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "left"  , SeolMoonLeft)
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "height", SeolMoonHeight)
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "width" , SeolMoonWidth)
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "top"   , CurrTopLocation)
			
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "fgcolor", "128")
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "bgcolor", "80")
				

			CurrTopLocation = CurrTopLocation + SeolMoonHeight
		else '설문내용
			if set_ques_qsit_no == 3 then
				SizeOfHeight = 40

				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "chkcaption", "")
				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "unchkcaption", "")
				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "checkstate", set_rspn_slct_yn)
				
				'설문내용
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "caption", set_invt_incl_ques_qsit_cntt)
				'설문내용 폰드사이즈 조절
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "fontsize", "-2")
				
				'각 설문 위치
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "left"  , 45)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "height", SizeOfHeight)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "width" , ContainerSize - 45)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "top"   , CurrTopLocation)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "valign"   , "1") '위쪽정렬 중앙정렬 아래정렬
				
				'tab0.page1.Container0.LblPersonInvt43.valign
				'각 체크박스 위치
				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "left"  , 25)
				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "height", SizeOfHeight)
				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "width" , 30)
				Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "top"   , CurrTopLocation)
				
			else
				Select Case set_ques_qsit_no
				Case 1
					tab0.page1.Container0.RdoPersonInvt1.SetRadioCaption(set_item_no-1,set_invt_incl_ques_qsit_cntt)
					tab0.page1.Container0.RdoPersonInvt1.fontsize = -2
					SizeOfHeight = 90
					MoonHang = 1 '문항수
					if set_item_no <> 1 then
						SizeOfHeight = 0 '높이
					end if 
					
				Case 2
					tab0.page1.Container0.RdoPersonInvt2.SetRadioCaption(set_item_no-1,set_invt_incl_ques_qsit_cntt)
					tab0.page1.Container0.RdoPersonInvt2.fontsize = -2
					SizeOfHeight = 90
					MoonHang = 1 '문항수
					if set_item_no <> 1 then
						SizeOfHeight = 0 '높이
					end if 
				Case 4
					SizeOfHeight = 40
					MoonHang = 4 '문항수
				Case 5
					SizeOfHeight = 35
					MoonHang = 5 '문항수
				Case 6
					SizeOfHeight = 50
					MoonHang = 3 '문항수
				Case 7
					SizeOfHeight = 50
					MoonHang = 4 '문항수
					LabelYn = "Y" '레이블존재여부
				Case 8
					SizeOfHeight = 95
					MoonHang = 5 '문항수
					LabelYn = "Y" '레이블존재여부
				Case 9
					SizeOfHeight = 60
					MoonHang = 4 '문항수
				Case 10
					SizeOfHeight = 32
					MoonHang = 5 '문항수
				Case 11
					SizeOfHeight = 35
					MoonHang = 5 '문항수
				End Select 
				
				'설문내용
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "caption", set_invt_incl_ques_qsit_cntt)
				'설문내용 폰트사이즈 조절
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "fontsize", "-2")
				
				'각 설문 위치
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "left"  , 45)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "height", SizeOfHeight)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "width" , ContainerSize - 45)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "top"   , CurrTopLocation)
				Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&set_ques_qsit_no&set_item_no, "valign"   , 1) '위쪽정렬 중앙정렬 아래정렬

				'라디오박스 위치
				if set_item_no == 1 then
					Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "height", SizeOfHeight * MoonHang)
					Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "top"   , CurrTopLocation)
					Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "left"  , 0)
				end if 
				'체크박스박스 체크시
				if set_rspn_slct_yn == "1" then 
					Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "currentindex", set_item_no-1)
				end if 

			end if 
			CurrTopLocation = CurrTopLocation + SizeOfHeight
		end if 
	Next
	tab0.page1.Container0.SetScrollAutoSize()

End Sub 
'============================================================================ v0005
' prosclscode: 1: 초기화 2: 비활성화
Sub SetContainer(prosclscode)
	
	'Form.ShowAlert("알림", tab0.page1.grd0.rowcount)
	For i = 0 to tab0.page1.grd0.rowcount - 1 
		set_rspn_slct_yn 				= tab0.page1.grd0.GetCellData( "bd_cell0", i) '체크여부
		set_invt_incl_ques_qsit_cntt 	= tab0.page1.grd0.GetCellData( "bd_cell1", i) '설문내용
		set_ques_qsit_no 				= getNumber(tab0.page1.grd0.GetCellData( "bd_cell2", i)) '설문문항
		set_item_no 					= getNumber(tab0.page1.grd0.GetCellData( "bd_cell3", i)) '설문문제세부번호
		
		'Form.ShowAlert("알림", set_ques_qsit_no)
		if prosclscode == 1 then ' prosclscode: 1: 초기화 2: 비활성화
			'라디오 및 체크박스 활성화
			Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "enable"  , true)
			Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "enable", true)			
			'라디오 및 체크박스 초기화
			Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "currentindex"  , -1)
			Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "checkstate", "0")			
		elseif prosclscode == 2 then ' prosclscode: 1: 초기화 2: 비활성화
			'라디오 및 체크박스 비활성화
			Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "enable"  , false)
			Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "enable", false)			
		end if 
	Next
	
End Sub 

'============================================================================ v0005
' 각 설문문항에서 입력한 데이터를 Grd0에 입력처리한다.
' Grd0은 서비스로부터 데이터를 받아오거나 처리시 사용.
'=============================================================================
Sub SetSeolMoonGridData()
	
	'Form.ShowAlert("알림", tab0.page1.grd0.rowcount - 1 )
	For i = 0 to tab0.page1.grd0.rowcount - 1 
		set_invt_incl_ques_qsit_cntt 	= tab0.page1.grd0.GetCellData( "bd_cell1", i) '설문내용
		set_ques_qsit_no 				= getNumber(tab0.page1.grd0.GetCellData( "bd_cell2", i)) '설문문항
		set_item_no 					= getNumber(tab0.page1.grd0.GetCellData( "bd_cell3", i)) '설문문제세부번호
		set_rspn_slct_yn                = 0 '선택 비활성화
		
'		if i < 10 then
'			Form.ShowAlert("알림", set_ques_qsit_no&"-"&set_item_no)
'		end if 
			
		
		tab0.page1.grd0.SetCellData("bd_cell0", i, 0) '설문Grid 체크박스 초기화
		
		if set_ques_qsit_no <> 3 then
			if set_item_no == 0 then
				set_curr_index = Form.GetCtlProp("tab0.page1.Container0.RdoPersonInvt"&set_ques_qsit_no, "currentindex")
			end if

			if set_curr_index+1 == set_item_no then
				tab0.page1.grd0.SetCellData("bd_cell0", i, 1) '설문Grid 체크박스 체크
				'Form.ShowAlert("알림", i)
			end if 
		else
			set_rspn_slct_yn = Form.GetCtlProp("tab0.page1.Container0.ChkPersonInvt"&set_ques_qsit_no&set_item_no, "checkstate")
			if set_rspn_slct_yn == "1" then ' 설문 체크시
				tab0.page1.grd0.SetCellData("bd_cell0", i, 1) '설문Grid 체크박스 체크
			end if 
		end if 
	Next
End Sub

'============================================================================ v0005
Sub DisableInvtController()
	for i = 0 to 20
		for j = 0 to 10
			Form.SetCtlProp("tab0.page1.Container0.LblPersonInvt"&i&j  , "visible", false)
			Form.SetCtlProp("tab0.page1.Container0.RdoPersonInvt"&i    , "visible", false)
			Form.SetCtlProp("tab0.page1.Container0.ChkPersonInvt"&i&j  , "visible", false)
		next
	next
End Sub
