'등급산정
Sub CalGrade()
	Dim nScore, nMax, sTitleNo, sChk, i
	nScore = 0
	nMax = 0
	
'	'v0005 sta 주석처리
'	If tab0.page1.RadioGroup0.currentindex = "0" Then 'v0001
'		For i = 0 to tab0.page1.grd0.rowcount - 1
'			sTitleNo = tab0.page1.grd0.GetCellData("bd_cell2", i)
'			sChk = tab0.page1.grd0.GetCellData("bd_cell0", i)
'			
'			If tab0.page1.grd0.GetCellData("bd_cell3", i) <> "0" then
'				'1. 3번 항목을 제외하고 체크된 모든 항목에 대해 점수를 더함 	
'				If CDbl(sTitleNo) <> 3 then		
'					If sChk == "1" then
'						nScore = nScore + CDbl(tab0.page1.grd0.GetCellData("bd_cell4", i))
'					End If
'					
'				'2. 3번 항목은 체크된 것들 중에서 가장 큰 값을 구함
'				Else							
'					If sChk == "1" then
'						If CDbl(tab0.page1.grd0.GetCellData("bd_cell4", i)) > nMax then
'							nMax = CDbl(tab0.page1.grd0.GetCellData("bd_cell4", i))
'						End If					
'					End If
'				End If
'			End If
'		Next
'		
'		'3. 1의 합계와 2의 값을 더하고 38로 나눈 후 *100을 하고 round 처리함
'		nScore = Round((nScore + nMax) / 38 * 100)
'	end if
'	'v0005 fin 주석처리
	'v0001
	If tab0.page1.RadioGroup0.currentindex = "1" Then
		Form.MsgBox( "알림", "전문투자자로 정보미제공을 선택하셨습니다. 저장하시겠습니까?", "GradeConfirm", "2" )	
		g_WA_KYC_GRAD_CODE = "00"
		g_INVT_PRD_CLCD = "00"
		g_strTuzaStyle = "정보미제공"
	else
		'v0005 sta
''		'4. 구한 값으로 등급산정을 위한 기준표에서 from~to 구간에 속한 값을 찾음
'		For i = 0 to tab0.page1.grdGrade.rowcount - 1
'			nFrom = CDbl(tab0.page1.grdGrade.GetCellData("bd_cell2", i))
'			nTo = CDbl(tab0.page1.grdGrade.GetCellData("bd_cell3", i))
'			
'			If nScore > nFrom and nScore <= nTo then
'				g_sGradCode = tab0.page1.grdGrade.GetCellData("bd_cell0", i)
'				g_sGradText = tab0.page1.grdGrade.GetCellData("bd_cell1", i)
'				sMsg = "총 점수는 [" & nScore & "]점 이므로 고객님의 투자성향은 [" & g_sGradText & "]입니다. 저장하시겠습니까?"
'				Form.MsgBox( "알림", sMsg, "GradeConfirm", "2" )	
'			End If
'		Next
		'				
		sMsg = "고객님의 투자성향은 [" & g_strTuzaStyle & "]입니다. 저장하시겠습니까?" 'v0005
		Form.MsgBox( "알림", sMsg, "GradeConfirm", "2" )	
		'v0005 fin
	end if
End Sub


