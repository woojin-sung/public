'============================================================================
Sub SetGridData()
	Dim i, sPreTitleNo, sTitleNo
	
	sPreTitleNo = tab0.page1.grd0.GetCellData( "bd_cell2", 0)

	'첫번째 문항 타이틀 셋팅
	tab0.page1.grd0.insertrow = 0
	tab0.page1.grd0.SetCellData("bd_cell1", 0, g_szTitle(0))
	tab0.page1.grd0.SetCellFgColor("bd_cell1", 0, "128")		'타이틀 빨강색 표시
	tab0.page1.grd0.SetCellData("bd_cell2", 0, "00000000001")	'문항번호
	tab0.page1.grd0.SetCellData("bd_cell3", 0, "0")			'타이틀인 경우 항목번호 0
	tab0.page1.grd0.SetCellEnable("bd_cell0", 0, "0")			'타이틀 체크박스 Disable

	'두번째 ~ 마지막 문항 타이틀 셋팅
	For i = 1 to tab0.page1.grd0.rowcount + 6		'cont0.grd0.rowcount-1 이 아니라 +6인 이유는 For문 내 타이틀문항 insertrow 때문
		sTitleNo = tab0.page1.grd0.GetCellData( "bd_cell2", i)
		
		If sTitleNo <> sPreTitleNo then
			tab0.page1.grd0.insertrow = i
			tab0.page1.grd0.SetCellData("bd_cell1", i, g_szTitle(sTitleNo-1))
			tab0.page1.grd0.SetCellFgColor("bd_cell1", i, "128")									'타이틀 빨강색 표시
			tab0.page1.grd0.SetCellData("bd_cell2", i, "0000000000" & Left(g_szTitle(sTitleNo-1),1))	'문항번호
			tab0.page1.grd0.SetCellData("bd_cell3", i, "0")										'타이틀인 경우 항목번호 0
			tab0.page1.grd0.SetCellEnable("bd_cell0", i, "0")										'타이틀 체크박스 Disable
		End If
		
		sPreTitleNo = sTitleNo
	Next
End Sub

'============================================================================
Function ValidateCheck()
	Dim i, sSeq, bChk
	
	bChk = False
	
	If tab0.page1.RadioGroup0.currentindex <> "1" Then '전문투자자가 아닐경우에만 아래 로직 수행 'v0005
		For i = 1 to tab0.page1.grd0.rowcount
			'sSeq = tab0.page1.grd0.GetCellData("bd_cell3", i) 'v0005
			sSeq = getNumber(tab0.page1.grd0.GetCellData("bd_cell3", i)) 'v0005
			sChk = tab0.page1.grd0.GetCellData("bd_cell0", i)
			
			If sChk == "1" then
				bChk = True
			End If
				
			'If sSeq == "0" or sSeq == "" then	'각 문항 타이틀인 경우 V0005
			If sSeq == 0 or sSeq == "" then	'각 문항 타이틀인 경우 V0005
				If bChk <> True then
					Form.ShowAlert("알림", CDbl(tab0.page1.grd0.GetCellData("bd_cell2", i-1)) & "번 문항에 체크해주세요.")
					return False
				End If
				
				bChk = False
			End If
		Next
	end if 
End Function

