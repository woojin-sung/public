'============================================================================
' 01. 화 면 명 : 온라인매체동시접속
' 02. 화면설명 : 온라인매체동시접속
' 03. 작    성 : 2016.01.18 ~ 최지희
' 2020.03.16 : 정민영 : v0001 : [T2003040024] 종금영업종료 및 사명 변경 (설명문구내 '종금'삭제)
' 2020.09.23 : 정민영 : v0002 : [T2008250015] 메모리취약점 보완
 '           : ID비밀번호 컨트롤속성 '일반비밀번호'->'계좌/거래비밀번호' 변경
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szId			'사용자아이디
Dim g_szPassword		'사용자 비밀번호
Dim g_szPAndICheck	'동시접속차단/허용 선택 (차단 : N 허용 : Y)
Dim g_plain_rm  		'v0002 메모리평문적용여부


'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(g_szId, g_szPassword, g_szPAndICheck)
	DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "ELFN_ID" , 0 , g_szId)
	DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "CONN_PWD" , 0 , g_szPassword)
	DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "CNCC_CONN_INFR_YN", 0 , g_szPAndICheck)	
	DATAMANAGER.RequestTranData("obcsb_efif_167a")
	
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInitBefore - 기기에 저장된 ID를 가져와 설정한다
'============================================================================
Sub Form_OnFormInitBefore()
	'현재 접속중인 ID를 가져와서 edtId에 설정해준다.	
	Dim szUserId
	szUserId = Form.GetSharedData("&USER_ID" , false)	
	Table1.SetCellString( 0, 1, szUserId )
	g_szId = szUserId
End Sub

'============================================================================
' Form_OnFormInit - 설정된 ID를 가지고 차단/허용 여부를 선택한다
'============================================================================
Sub Form_OnFormInit()	
	edtPassword.certname = "ID비밀번호 입력"

	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	'초기 셋팅을 봉㎸?"obcsb_efif_166r" TR을 부른다	
	DATAMANAGER.SetDataValue(0, "obcsb_efif_166r", "InBlock1", "ELFN_ID", 0 , g_szId)
	DATAMANAGER.RequestTranData("obcsb_efif_166r")	
End Sub



'============================================================================
' btnSetting_OnClick - 동시접속 설정 변경
'============================================================================
Sub btnSetting_OnClick()
	if edtPassword.caption = "" then	'비밀번호 입력하지 않은 경우
		Form.MsgBox("알림", "비밀번호를 확인 후 다시 입력하십시오.", "", 0)
		Exit Sub
	else	
		g_szId = Trim(Table1.GetCellString( 0, 1 ))
		'g_szId = edtId.caption
		'v0002
		if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		    g_szPassword = edtPassword.caption
		else  'MTS메모리평문 미적용상태일때
		    g_szPassword = Form.GetEncData(edtPassword.caption)		
		end if
		
		if rdoPAndI.currentindex == 0 then
			g_szPAndICheck = "N"
		elseif rdoPAndI.currentindex == 1 then
			g_szPAndICheck = "Y"
		end if

		'처리 완료 후 재조회
		'TR obcsb_efif_167a 호출
		
		TR_Inquiry(g_szId, g_szPassword, g_szPAndICheck)
		edtPassword.caption = ""
		g_szPassword = ""
	end if
	
	
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'동시접속 차단/허용(라디오) 설정을 위한 TR
	if szTranID == "obcsb_efif_166r" then	
		Dim szPAndI
		szPAndI = DATAMANAGER.GetDataValue(0, "obcsb_efif_166r", "OutBlock1", "CNCC_CONN_INFR_YN" , 0)
		if szPAndI == "Y" then
			rdoPAndI.currentindex = 1
			g_szPAndICheck = "Y"
		elseif szPAndI == "N" then
			rdoPAndI.currentindex = 0
			g_szPAndICheck = "N"
		end if
	end if

	'동시접속 설정 변경을 위한 TR
	if szTranID == "obcsb_efif_167a" then

		Dim szMsg
		szMsg = DATAMANAGER.GetDataMsgText("obcsb_efif_167a")
		
		if szMsg <> "" then
			Form.MsgBox("알림", szMsg, "", 0)
		end if
		
		Dim szSUYN
		szSUYN = DATAMANAGER.GetDataValue(0,"obcsb_efif_167a", "OutBlock1", "SUCS_YN" , 0)
		if szSUYN = "Y" then	
			DATAMANAGER.SetDataValue(0, "obcsb_efif_166r", "InBlock1", "ELFN_ID", 0 , g_szId)
			DATAMANAGER.RequestTranData("obcsb_efif_166r")
			'Form.CloseForm()
		end if
	elseif szTranID == "obcsb_efif_162r" then
		Dim szErrMsg, szSubErr
		szErrMsg = DATAMANAGER.GetDataMsgText( szTranID )
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		szSUYN = DATAMANAGER.GetDataValue(0,"obcsb_efif_162r", "OutBlock1", "SUCS_YN" , 0)
		if szSUYN == "N" then
			Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , "", 0)
			edtPassword.caption = ""
		end if	
	end if
	
	
End Sub


'============================================================================
' rdoPAndI_OnClick - 차단 : N / 허용 : Y 
'============================================================================
Sub rdoPAndI_OnClick(nIndex)
	if nIndex == 0 then
		g_szPAndICheck = "N"
	elseif nIndex == 1 then
		g_szPAndICheck = "Y"
	end if
	
End Sub




'============================================================================
' edtPassword_OnEditComplete
'============================================================================
Sub edtPassword_OnEditComplete()
	'v0002
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_szPassword = edtPassword.caption
	else  'MTS메모리평문 미적용상태일때
		g_szPassword = Form.GetEncData(edtPassword.caption)
	end if	
	
	'16-03-25 YCJ 비밀번호 일치 체크 추가
	DATAMANAGER.SetDataValue( 0 , "obcsb_efif_162r", "InBlock1", "ELFN_ID" , 0 , g_szId)
	DATAMANAGER.SetDataValue( 0 , "obcsb_efif_162r", "InBlock1", "CONN_PWD" , 0 , g_szPassword)
	
	DATAMANAGER.RequestTranData( "obcsb_efif_162r" )
End Sub




'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	if szTranID == "obcsb_efif_167a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , "", 0)
		edtPassword.caption = ""
	end if
End Sub

	</SCRIPT_INFO>
