'============================================================================
' 01. 화 면 명 : CFD 권리예정내역 조회
' 02. 화면설명 : CFD 권리예정내역 조회
' 03. 작    성 : 2021. 07. 21. KSJ
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szItemCode	'종목코드
Dim g_szItemSym	'거래소 심볼
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szItemCode = ""
	g_szItemSym = ""
	
	ItemCode0.code = "empty"

	cldDate.caption = Replace(DateAdd ("m", -5, cldDate.calyear &"-"& cldDate.calmonth &"-"& cldDate.calday), "-", "")
	grd0.SetClear()
	
	DATAMANAGER.RequestTranData( "obrgt_oscm_789r" )
End Sub
'============================================================================
' acnt0_ChangeAccount() : 계좌변경
'============================================================================
Sub acnt0_ChangeAccount()
	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obrgt_oscm_789r" )
End Sub
'============================================================================
' Form_OnCommonDialogReturn()
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		dim tCodeInfo
		tCodeInfo = {}
		tCodeInfo = split(sReturn1, "@")
		
		g_szItemCode = tCodeInfo(1)
		g_szItemSym = tCodeInfo(0)
		
		DATAMANAGER.RequestTranData( "obrgt_oscm_789r" )
	end if
End Sub
'============================================================================
' btnAll_OnClick() : 종목전체조회
'============================================================================
Sub btnAll_OnClick()
	g_szItemCode = ""
	g_szItemSym = ""
	ItemCode0.code = "empty"

	grd0.SetClear()
	DATAMANAGER.RequestTranData( "obrgt_oscm_789r" )
End Sub
