'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)    
	If szTranID == "obrgt_oscm_789r" Then
		dim szISCD
		
		if g_szItemCode <> "" and g_szItemSym <> "" then
			szISCD = g_szItemCode & "." & g_szItemSym
		else
			szISCD = "%"
		end if
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 			, 0 , acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 			, 0 , acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RGHT_DATE" 	, 0 , cldDate.caption)'권리일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RGHT_TYPE_CODE"	, 0 , cmbGubun0.cbkeydata)				'권리유형코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PSTN_CLS_CODE" 	, 0 , cmbGubun1.cbkeydata)				'포지션구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 			, 0 , szISCD)									'종목코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INDV_MANG_BRCD"	, 0 , "")							'개별관리점코드
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
'매크로 사용된 TR 사용시 Form.GetMetaData(코드치환Section, 코드 TR)
'sData = Form.GetMetaData( "현물반대매매사유코드", "01" )
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obrgt_oscm_789r" Then
		If tonumber(grd0.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = grd0.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1	
				Dim szData0
				szData0 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ACNO" , i) & DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ASNO" , i)
				grd0.SetCellData( "bd_cell0", nRowCnt + i, szData0)	' 계좌번호+계좌일련번호
			Next
	    End If
	End If
End Sub



