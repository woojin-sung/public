	<SCRIPT_INFO _len="4845" _ulen="4497" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵호가주문
' 02. 화면설명 : 선옵호가주문_설정팝업
' 03. 작    성 : 2016.02.23 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sFileName '파일명
Dim g_sConfirmKey '주문입력확인창사용키
Dim g_sOneTouchKey '원터치주문사용키

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 환경설정초기화함수
'============================================================================
Function SetInitData()
	'주문입력확인창사용 - 사용
	'원터치주문사용 - 미사용
	
	Cont0.Table0.SetCellString( 1, 1, "사용" )
	Cont0.Table0.SetCellString( 2, 1, "미사용" )
	
	SetFgColor(1, 1)
	SetFgColor(2, 1)
	
	SetConfigData(g_sFileName, g_sConfirmKey, 1, 1)
	SetConfigData(g_sFileName, g_sOneTouchKey, 2, 1)
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sFileName, sKey, nRow, nCol)
	Dim sValue
	sValue = Form.LoadConfigData(sFileName, sKey)

	if sValue == null or Trim(sValue) == "" then
		if sKey == g_sConfirmKey then
			sValue = "Y" '기본값 사용
		elseif sKey == g_sOneTouchKey then
			sValue = "N" '기본값 미사용
		end if
	end if
	
	if sValue == "Y" then 'On
		sValue = "사용"
	else 'Off
		sValue = "미사용"
	end if

	Cont0.Table0.SetCellString( nRow, nCol, sValue )
	
	if sValue == "미사용" then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "4:000000000" )
	else
		Cont0.Table0.SetCellFgColor( nRow, nCol, "128:188030030" )
	end if
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sFileName, sKey, nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sValue == "사용" then
		sValue = "N"
	else
		sValue = "Y"
	end if
	
	Form.SaveConfigData( sFileName, sKey, sValue )
End Function 

'============================================================================
' 글자색상함수
'============================================================================
Function SetFgColor(nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sValue == "미사용" then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "4:000000000" )
	else
		Cont0.Table0.SetCellFgColor( nRow, nCol, "128:188030030" )
	end if
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("선물옵션호가주문 설정")
	
	g_sFileName = "SET_ORDER" 
	g_sConfirmKey = "HOGA_ORD_CONFM_YN" 
	g_sOneTouchKey = "HOGA_ORD_ONETH_YN" 
	
	GetConfigData(g_sFileName, g_sConfirmKey, 1, 1)
	GetConfigData(g_sFileName, g_sOneTouchKey, 2, 1)
End Sub

'============================================================================
Sub Cont0_Table0_OnClick(lRow , lColumn)
	if lRow == 1 then '주문입력확인창사용
		SetConfigData(g_sFileName, g_sConfirmKey, 1, 1)
		GetConfigData(g_sFileName, g_sConfirmKey, 1, 1)
	elseif lRow == 2 then '원터치주문사용
		SetConfigData(g_sFileName, g_sOneTouchKey, 2, 1)
		GetConfigData(g_sFileName, g_sOneTouchKey, 2, 1)
	end if
End Sub

'============================================================================
' 주문입력확인창사용
'============================================================================
Sub Cont0_Image0_OnClick()
	SetConfigData(g_sFileName, g_sConfirmKey, 1, 1)
	GetConfigData(g_sFileName, g_sConfirmKey, 1, 1)
End Sub

'============================================================================
' 원터치주문사용
'============================================================================
Sub Cont0_Image1_OnClick()
	SetConfigData(g_sFileName, g_sOneTouchKey, 2, 1)
	GetConfigData(g_sFileName, g_sOneTouchKey, 2, 1)
End Sub



	</SCRIPT_INFO>
</ROOT>