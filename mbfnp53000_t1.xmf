'============================================================================
' 01. 화 면 명 : ELS/DLS청약_신청탭
' 02. 화면설명 : ELS/DLS청약_신청탭
' 03. 작    성 : 2016. 03. 05. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Seting(nIndex) : 그리드 값 세팅
'============================================================================
Function Seting(nIndex)

'	grd0.SetCellData( "cell2_3" , nIndex, ":")
	grd0.SetCellData( "cell2_1" , nIndex, "특정조건 충족시 수익률(세전) :")
	grd0.SetCellFgColor( "cell2_1" , nIndex, "61")
	grd0.SetCellFgColor( "cell2_4" , nIndex, "61")
	grd0.SetCellData( "cell2_8" , nIndex, "청약")
	grd0.SetCellFgColor( "cell2_8" , nIndex, "61")
	grd0.SetCellData( "cell3_8" , nIndex, "신청")
	grd0.SetCellFgColor( "cell3_8" , nIndex, "61")
	grd0.SetCellData( "cell3_1" , nIndex, "청약기간 :")
'	grd0.SetCellData( "cell3_3" , nIndex, ":")
	grd0.SetCellData( "cell3_5" , nIndex, "~")
	grd0.SetCellData( "cell4_1" , nIndex, "기초자산 :")
'	grd0.SetCellData( "cell4_3" , nIndex, ":")
	
	grd0.SetCellData( "cell6_1" , nIndex, "조건 미 충족시 손실률 :")
	grd0.SetCellFgColor( "cell6_1" , nIndex, "61")
	grd0.SetCellFgColor( "cell6_6" , nIndex, "61")
	
End Function
'============================================================================
' GradeCheck(nIndex , szIssueCode, szCode, szYN) : 그리드값 구분해서 세팅
'============================================================================
Function GradeCheck(nIndex , szIssueCode, szCode, szYN)
	Dim szText
	szText = ""
	
	if szIssueCode == "10" then
		grd0.SetCellData( "cell1_1", nIndex, "[DLS]")
	elseif szIssueCode == "07" then
		grd0.SetCellData( "cell1_1", nIndex, "[ELS]")
	end if

	Select Case szCode			'위험도 체크
		Case "01"
			szText = "초고위험/"
'			grd0.SetCellData( "cell2_6" , nIndex, "초고위험/")
		Case "02"
'			grd0.SetCellData( "cell2_6" , nIndex, "고위험/")
			szText = "고위험/"
		Case "03"
'			grd0.SetCellData( "cell2_6" , nIndex, "중위험/")
			szText = "중위험/"
		Case "04"
'			grd0.SetCellData( "cell2_6" , nIndex, "저위험/")
			szText = "저위험/"
		Case "05"
'			grd0.SetCellData( "cell2_6" , nIndex, "초저위험/")
			szText = "초저위험/"
		Case "09"
'			grd0.SetCellData( "cell2_6" , nIndex, "미지정/")
			szText = "미지정/"
		Case "99"
'			grd0.SetCellData( "cell2_6" , nIndex, "투자목적기재서거부/")
			szText = "투자목적기재서거부/"
	End Select

	if szYN == "Y" then			'보장여부
		szText = szText.."원금보장형"
		grd0.SetCellData( "cell2_6" , nIndex, szText )		
	else
		szText = szText.."원금비보장형"
		grd0.SetCellData( "cell2_6" , nIndex, szText )	
	end if
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
'	cld0.caption = "20160304"			'주말이거나 공휴일일때 테스트 했던 부분
	
	DATAMANAGER.RequestTranData( "obibk_pssb_024r" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nDataCount			'데이터 개수
	Dim szIssuCode			'청약종목구분코드
	Dim szGradeCode			'위험등급코드
	Dim szProtectYN			'보장여부
	
	if szTranID == "obibk_pssb_024r" then
		nDataCount = DATAMANAGER.GetDataCount( 0 , "obibk_pssb_024r", "OutBlock1") - 1
		for i = 0 to nDataCount
			Seting( i )
			szIssuCode = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_024r", "OutBlock1", "PROD_CLS_CODE" , i)			'상품코드
			szGradeCode = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_024r", "OutBlock1", "KYC_PROD_GRAD_CODE" , i)	'위험도Code
			szProtectYN = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_024r", "OutBlock1", "PRNC_GUAR_YN" , i)			'보장여부
			GradeCheck( i, szIssuCode, szGradeCode, szProtectYN)
		next
		
		if CInt(grd0.rowcount) == 0 then
			Form.ShowAlert( "알림", "신청가능 종목이 없습니다.")
		end if
	end if
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	'상품명, 당일날짜, 청약종목일련코드, 종목코드, 청약금액, 청약일자, 청약종목구분코드, 청약단가
	szData = grd0.GetCellData( "cell1_2" , lRow) & "★" & cld0.caption & "★" & grd0.GetCellData( "bd_cell8" , lRow) & "★" & grd0.GetCellData( "bd_cell9" , lRow) & "★" &
	grd0.GetCellData( "bd_cell10" , lRow) & "★" & grd0.GetCellData( "bd_cell11" , lRow) & "★" & grd0.GetCellData( "bd_cell13" , lRow) & "★" &
	grd0.GetCellData( "bd_cell14" , lRow)
	
	if szCellID == "cell2_8" or szCellID == "cell3_8" then
		Form.OpenFramePopup( "mbfnp53000_p1" , szData , sPosInfo)
	end if
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
