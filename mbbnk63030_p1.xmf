	<SCRIPT_INFO _len="5573" _ulen="5233" >
'============================================================================
' 01. 화 면 명 : 입출금내역_상세팝업
' 02. 화면설명 : 입출금내역_상세팝업
' 03. 작    성 : 2016. 02. 24. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim szList
Dim szData
Dim g_szChange
Dim g_szText
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	tbl1.SetCellMaxLineCount(4, 1, 1)
	
	g_szChange = "0"
	szData = Form.GetOpenLinkData()
	Form.SetScreenName("입출금내역")
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 then
		Exit sub
	End if

'	for i = 0 to 10
'		tbl0.SetCellString( i , 1, Trim(szList(i)))
'	next

	tbl1.SetCellString( 0 , 1, Trim(szList(0)))'거래일시
	tbl1.SetCellString( 3 , 1, Trim(szList(1)))'계좌번호
	tbl1.SetCellString( 6 , 1, Trim(szList(2)))'적요명
	tbl1.SetCellString( 5 , 1, Trim(szList(3)))'거래구분
	if Trim(szList(3)) == "출금" then
		tbl1.SetCellFgColor(7, 1, 7)
	elseif Trim(szList(3)) == "입금" then
		tbl1.SetCellFgColor(7, 1, 6)
	end if
	
	tbl1.SetCellString( 7 , 1, Trim(szList(4)))'거래금액
	
	tbl1.SetCellString( 8 , 1, Trim(szList(5)))'수수료		
	
	tbl1.SetCellString( 10 , 1, Trim(szList(6)))'상대계좌번호
	tbl1.SetCellString( 11 , 1, Trim(szList(7)))'거래상대명
	
	if szList(19) == "KRW" then
		tbl1.SetCellString( 9 , 1, (Trim(szList(8))).." 원")'잔액
	else
		tbl1.SetCellString( 9 , 1, (Trim(szList(8))).." "..szList(19))'잔액
	end if
	
	tbl1.SetCellString( 13 , 1, Trim(szList(9)))'처리자
	tbl1.SetCellString( 1 , 1, Trim(szList(10)))'거래번호
	tbl1.SetCellString( 4 , 1, Trim(szList(11)))'내통장설명
	tbl1.SetCellString( 12 , 1, Trim(szList(12)))'상대통장표기
	
	
	if Trim(szList(13)) == "00000000000" then
		tbl1.SetCellString( 2 , 1, "")'원거래내역일련번호
	else
		tbl1.SetCellString( 2 , 1, Trim(szList(13)))'원거래내역일련번호
	End if
	
	tbl1.SetCellString( 14 , 1, Trim(szList(14)))'처리내용
	
	'231013 htw start 이체처리중 case 추가
	if Trim(szList(14)) == "이체처리중" then
		tbl1.SetCellFgColor(14, 1, "290")
	end if
	'231013 htw end 이체처리중 case 추가
	g_szText = Trim(szList(11))
	
	Edit0.caption = Trim(szList(11))
	tbl1.SetCellString( 4 , 1, Trim(szList(11)))
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "CHANGE" , g_szChange)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "POPUP_TEXT" then
	
	    If Trim(sRet) == "" Then
	        return
	    End If
	    
	    
		szLen = Form.GetByteLength(sRet)
		if CDbl( szLen ) > 20 then
			Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
			Exit Sub
		else
			Edit0.caption = sRet
			tbl1.SetCellString( 4 , 1, sRet)
		end if
		
		DATAMANAGER.RequestTranData( "obrtp_tran_025a" )
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrtp_tran_025a" then
		
		DATAMANAGER.SetDataValue( false, "obrtp_tran_025a", "InBlock1", "ACNO" , 0, Trim(szList(15)) )
		DATAMANAGER.SetDataValue( false, "obrtp_tran_025a", "InBlock1", "ASNO" , 0, Trim(szList(16)) )
		DATAMANAGER.SetDataValue( false, "obrtp_tran_025a", "InBlock1", "TR_DATE" , 0, Trim(szList(17)) )
		DATAMANAGER.SetDataValue( false, "obrtp_tran_025a", "InBlock1", "TRAN_SRNO" , 0, Trim(szList(18)) )
		szText = Edit0.caption
		DATAMANAGER.SetDataValue( false, "obrtp_tran_025a", "InBlock1", "TR_EXPL" , 0, szText )
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "MNPL_TRNO" , 0 , Form.GetSharedData( "&IP_ADDRESS" , false ))
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "MNPL_EMPNO" , 0 , Form.GetSharedData( "&USER_ID" , false ) )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtp_tran_025a" then
		g_szChange = "1"
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.MsgBox(szTranID, szErrCode .."/".. szErrMsg)
	Edit0.caption = g_szText
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.OpenPopupAnimation("textkeypadpopup", "내 통장 표기☆"..Edit0.caption.."☆최대 10글자 입력 가능☆1☆20" , "","2")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obrtp_tran_025a" trcode="obrtp_tran_025a" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obrtp_tran_025a" title="거래내역 거래설명 수정" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="332" _ulen="248" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
TR_DATE^거래일자^8^0^0^0^0^0^0
TRAN_SRNO^거래내역일련번호^11^0^7^0^0^0^0
TR_EXPL^거래설명^20^0^0^0^0^0^0
MNPL_YMDH^조작일시^19^0^0^0^0^0^0
MNPL_TRNO^조작단말번호^39^0^0^0^0^0^0
MNPL_EMPNO^조작직원번호^20^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>