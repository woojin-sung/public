' 2020.08.20 : 정민영 : v0001 : [T2007130018] 레버리지ETF/ETN 기본예탁금관련(OutBlock6) obacb_balc_024rTR 재매핑
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Init_Table
'============================================================================
Sub Init_Table()
	tblData.SetCellString(1, 0, "")
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(1, 2, "")
	tblData.SetCellString(3, 0, "")
	tblData.SetCellString(3, 1, "")
	tblData.SetCellString(3, 2, "")
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)

		Init_Table()
		DATAMANAGER.RequestTranData("obacb_balc_024r")
		DATAMANAGER.RequestTranData("obacb_balc_105r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 예수금 조회
	' ----------------------------------------------------------------------	
	if szTranID = "obacb_balc_024r" then	 
		DATAMANAGER.ClearInputData(0, "obacb_balc_024r")
		
		DATAMANAGER.SetDataValue(0, "obacb_balc_024r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obacb_balc_024r", "InBlock1", "ASNO", 0, g_szAcntCd)
	' ----------------------------------------------------------------------
	' 평가내역 조회
	' ----------------------------------------------------------------------			
	elseif szTranID = "obacb_balc_105r" then	 
		DATAMANAGER.ClearInputData(0, "obacb_balc_105r")
		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN", 0, "N")
		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "ASNO", 0, g_szAcntCd)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
'	if Trim(szSubMsg) <> "" then
'		Form.Toast(1, szErrMsg & "(" & szSubMsg & ")", true)	
'	else
'		Form.Toast(1, szErrMsg, true)
'	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	Init_Table()
	DATAMANAGER.RequestTranData("obacb_balc_024r")
	DATAMANAGER.RequestTranData("obacb_balc_105r")
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub
