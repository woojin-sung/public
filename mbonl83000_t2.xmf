	<SCRIPT_INFO _len="3649" _ulen="3555" >
'============================================================================
' 01. 화 면 명 : 권리예정내역_유상/매수청구
' 02. 화면설명 : 권리예정내역_유상/매수청구
' 03. 작    성 : 2016. 02. 15. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "유상/매수청구" then
		g_szList = Split(sParam , "★")
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	DATAMANAGER.SetDataValue( 0 , "obrgt_ismn_036r", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obrgt_ismn_036r", "InBlock1", "ASNO" , 0 , g_szList(1))
	DATAMANAGER.SetDataValue( 0 , "obrgt_ismn_036r", "InBlock1", "PROS_DATE" , 0 , cld0.caption)
	
	DATAMANAGER.RequestTranData("obrgt_ismn_036r")
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obrgt_ismn_036r")
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	szData = grd1.GetCellData("bd_cell0", lRow) & "★" & grd1.GetCellData("bd_cell1", lRow) & "★" & grd1.GetCellData("bd_cell2", lRow)
	
	Form.OpenFramePopup( "mbonl83000_p1" , szData , sPosInfo)
End Sub
'============================================================================
' cld0_OnEditComplete()
'============================================================================
Sub cld0_OnEditComplete()
	DATAMANAGER.SetDataValue( 0 , "obrgt_ismn_036r", "InBlock1", "PROS_DATE" , 0 , cld0.caption)
	
	DATAMANAGER.RequestTranData("obrgt_ismn_036r")
End Sub

'============================================================================
Sub Form_OnRefresh()
	
'	DATAMANAGER.RequestTranData("obrgt_ismn_036r")
	
End Sub

Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obrgt_ismn_036r" then
		grd0.SetClear()
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obrgt_ismn_036r" )
		Form.ShowAlert("알림", szErrMsg.."("..szSubErr..")" )
	end if
	
End Sub

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrgt_ismn_036r" then	
		nCnt = DATAMANAGER.GetDataCount(0, "obrgt_ismn_036r", "OutBlock1")
		if nCnt >0 then
			for i=0 to nCnt-1
				asgm_qty = DATAMANAGER.GetDataValue(0, "obrgt_ismn_036r", "OutBlock1", "ASGM_QTY" , i )
				excs_asgm_qty = DATAMANAGER.GetDataValue(0, "obrgt_ismn_036r", "OutBlock1", "EXCS_ASGM_QTY" , i )
				grd0.SetCellData( "bd_cell5", i, asgm_qty + excs_asgm_qty)
			next
		end if
	end if
End Sub




