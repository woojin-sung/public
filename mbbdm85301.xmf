	<SCRIPT_INFO _len="4234" _ulen="4124" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 바이오인증
' 02. 화면설명 : 바이오인증 - 유의사항
' 03. 작    성 : 2020.02.08 HSZ
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_btnimg
Dim g_CheckFlag
Dim g_sBIOTermOS

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	szTheme = Form.GetEnvData("common.theme") 
	if szTheme = "white" then
		g_btnimg = "btn_21.9"
	elseif szTheme = "black" then
		g_btnimg = "btn_27.9"
	end if
	g_CheckFlag = false
	call Button0_Change()
	g_sBIOTermOS = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")	
	if g_sBIOTermOS == "1" then
		Container0.setScrollBarVisible("2")
	end if	
End Sub


'============================================================================
'유의사항 확인문구 클릭시, 체크상태 변경
Sub Container0_Label1_OnClick()
	if Container0.ChkButton0.chksilence == "0" then
		Container0.ChkButton0.checkstate = "1"
		call Container0_ChkButton0_OnChange("1")
	else 
		Container0.ChkButton0.checkstate = "0"
		call Container0_ChkButton0_OnChange("0")
	end if
End Sub

'============================================================================
Sub Button0_OnClick()
'	call Button0_Change()
	if Container0.ChkButton0.chksilence == "0" then
		Form.MsgBox( "알림", "유의사항 확인에 동의해주세요.", "", "")
	else 
		Form.triggerEvent( "#", "NextStep", "1" )	
	end if
End Sub
'============================================================================
Function Button0_Change()
	if g_CheckFlag = false then
		Button0.enable = false
		Button0.btnimage  = g_btnimg
		Button0.fgcolor   = "269" 
	elseif g_CheckFlag = true then
		Button0.enable = true 
		Button0.btnimage  = "btn_20.9"
		Button0.fgcolor   = "273"
	end if
End Function 
'============================================================================

Sub Container0_ChkButton0_OnChange(sCheckState)
	if sCheckState = "1" then
		g_CheckFlag = true
		call Button0_Change()
	else
		g_CheckFlag = false
		call Button0_Change()
	end if
End Sub
'============================================================================
