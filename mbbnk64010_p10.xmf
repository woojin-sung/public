'============================================================================
' 화 면 명 : 외화이체 알림바텀팝업
'============================================================================

Dim g_szResult

'============================================================================
Sub Form_OnFormInit()

	szData = Form.GetOpenLinkData( )
	
	if szData ~= "" and szData ~= "" then
		tOpenData = Split(szData, "★")
	
		'에러코드★출력메시지
		g_szErrCode			= tOpenData[0]
		g_szErrMsg			= tOpenData[1]
		
		
		lblResult.caption = g_szErrMsg
		
	end if

End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub


	</SCRIPT_INFO>
