	<CONTROL_INFO>
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image0" imgpath="input_03_n.9" ly_vert="0,430,375,217,1" />
		<LABEL name="Label0" fontsize="3" fontstyle="01" caption="알림" halign="1" valign="2" ly_vert="0,430,375,43,1" />
		<LABEL name="lblResult" halign="1" multiline="1" ly_vert="20,500,335,60,1" />
		<BUTTON name="btnOK" caption="확인" fontsize="2" fontstyle="01" btnimage="btn_22.9" ly_vert="-5,597,385,50,1" />
