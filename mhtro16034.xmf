'============================================================================
Sub Form_OnFormInit()
	f_EventPopup()
	Dim strOpenData, strOpenScreen, strSearchData
	strOpenData = Form.GetOpenLinkData()
	
	if strOpenData == null or strOpenData == "" then
		strOpenScreen = Form.GetSharedData("16034_OPEN_SCREEN", 0 )
		strSearchData = Form.GetSharedData("16034_SEARCH_DATA", 0 )
	else
		Dim splitIndex
		splitIndex = InStr( strOpenData, "★" )
		if splitIndex > 0 then
			Dim sTemp
			sTemp = Split(strOpenData, "★")
			strOpenScreen = sTemp[0]
			strSearchData = sTemp[1]
		else
			strOpenScreen = strOpenData
		end if
	end if
	
	Form.SetSharedData("16034_OPEN_SCREEN", strOpenScreen)
	Form.SetSharedData("16034_SEARCH_DATA", strSearchData)
	
	Dim strTitle
	for i=0 to #g_GridListDic1 - 1 		
		if g_GridListDic1[i][0] == strOpenScreen then
			Form.SetTitleCaption(g_GridListDic1[i][1])
			exit for
		end if
	next
	LinkForm1.linkfile = strOpenScreen
	if strOpenScreen == "mhtro16030_s20" then
		Form.triggerEvent( "LinkForm1", "OPEN_DATA", strSearchData)
	end if
End Sub

Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form.triggerEvent( "LinkForm1", "SCREEN_REFRESH", "")
	end if
end Sub

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
    '20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

