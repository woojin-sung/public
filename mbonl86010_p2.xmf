	<SCRIPT_INFO _len="2169" _ulen="1619" >
'============================================================================
' 01. 화 면 명 : 중요거래단말지정서비스_추가인증팝업
' 02. 화면설명 : 중요거래단말지정서비스_추가인증팝업
' 03. 작    성 : 2016.01.19 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("추가인증")
	Dim szSort	'등록인지 해지인지 판별하기 위해
	szSort = Form.GetOpenLinkData()
	
	if szSort == "등록" then
		Form.ShowAlert("등록눌림", "등록눌림")
	elseif szSort == "해지" then
		Form.ShowAlert("해지눌림", "해지눌림")

	end if
	
	Container0.Label1.caption = "1. 휴대폰 SMS인증 시 통신사의 사정에 따라 전송이 지연될 수 있습니다. \n\n" &
							"2. 1회용 비밀번호는 발급 받은 후 5 영업일 이내에만 사용 가능합니다. \n\n" &
							"3. ARS 인증 시 전화승인 요청을 누르면 고객이 지정하신 전화번호로 전화승인 ARS가 발송되며, 고객님께서 음성을 확인하고 전화승인여부를 선택하여 본인 여부를 확인 합니다. \n\n" &
							"4. 전화승인을 위한 ARS 전화를 3회 이상 미수신하거나 전화수신에 무응답시 해당 요청이 진행되지 않습니다.\n\n" &
							"5. 개인만 이용가능하며, 법인은 지점에서 전화번호를 변경/등록할 수 있습니다."
End Sub

	</SCRIPT_INFO>
</ROOT>