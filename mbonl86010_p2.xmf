	<MAP_INFO scrno="86010" scrname="중요거래단말지정서비스_추가인증팝업" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fontstyle="01" caption="추가인증수단 선택" ly_vert="6,9,150,39,1" />
		<CONTAINER name="Container0" vscroll="1" scroll_pos="0,0" ly_vert="0,362,375,200,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="Label1" valign="0" multiline="1" ly_vert="6,9,363,350,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<BUTTON name="Button0" caption="추가인증" ly_vert="107,317,160,39,1" />
