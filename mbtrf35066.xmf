		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtrf_cntg_722r" title="(야간)장내파생 당일 익일 증거?" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="123" _ulen="91" >

ACNO^계좌번호^8^0^0^0^0^0^0
