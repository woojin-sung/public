	<SCRIPT_INFO _len="5723" _ulen="5281" >
'============================================================================
' 01. 화 면 명 : 선옵 당일/익일 증거금
' 02. 화면설명 : 선옵 당일/익일 증거금 폼탭
' 03. 작    성 : 2016.01.11 ~ 최지희
'              : 2020.09.10 V001. 윤현수 MTS메모리보안적용(edtPassword 비밀번호 속성 계좌/거래비밀번호 사용으로 변경)
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

Dim g_nAccountNumber	'계좌번호 8글자 ex)18431988
Dim g_nAccountSerialNumber	'계좌 일련번호 2글자 ex)01
Dim g_nAccountPassword		'계좌 비밀번호
Dim g_szData			'계좌번호★일련번호★비밀번호 ex) 18431988★01★비밀번호
'V001
Dim plain_rm 'MTS메모리평문 적용유무

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry() - TR(계좌번호와 일련번호로 조회)
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_nAccountPassword)
	
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_722r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_722r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	if g_nAccountPassword <> "" then
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_722r", "InBlock1", "ACNT_PWD", 0 , g_nAccountPassword)
	else 
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_722r", "InBlock1", "ACNT_PWD", 0 , "")
	end if
	DATAMANAGER.RequestTranData("obtrf_cntg_722r")
	

End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'V001
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	'g_nAccountPassword = Form.GetEncData(edtPassword.caption)	
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_nAccountPassword = edtPassword.caption	
	'MTS메모리평문 미적용상태일때
	else
		g_nAccountPassword = Form.GetEncData(edtPassword.caption)	
	end if
	
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_nAccountPassword
	btnSearch_OnClick()
	'Container0.fmtabMargin.currenttab = 0
	edtPassword.visible = false
	
End Sub


'============================================================================
' btnSearch_OnClick() - 조회버튼
'============================================================================
Sub btnSearch_OnClick()
	for i=0 to 5
		Container0.Table0.SetCellString( i, 1, "" )
		Container0.Table0.SetCellString( i, 3, "" )
	next
	
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	'g_nAccountPassword = Form.GetEncData(edtPassword.caption)	
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_nAccountPassword = edtPassword.caption
	'MTS메모리평문 미적용상태일때
	else
		g_nAccountPassword = Form.GetEncData(edtPassword.caption)	
	end if
	
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_nAccountPassword
	Form.triggerEvent("fmtabMargin." & Container0.fmtabMargin.currenttabpageid, "TodaySearch", g_szData)
	Form.triggerEvent("fmtabMargin." & Container0.fmtabMargin.currenttabpageid, "NextDaySearch", g_szData)
	TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_nAccountPassword)	

End Sub


'============================================================================
' Container0_fmtabMargin_OnTabChanged - 폼탭 체인지
'============================================================================
Sub Container0_fmtabMargin_OnTabChanged(nCurrentTab)
	btnSearch_OnClick()	
End Sub


'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	'g_nAccountPassword = Form.GetEncData(edtPassword.caption)	
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_nAccountPassword = edtPassword.caption
	'MTS메모리평문 미적용상태일때
	else
		g_nAccountPassword = Form.GetEncData(edtPassword.caption)	
	end if
	

	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_nAccountPassword
	btnSearch_OnClick()

End Sub





'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtrf_cntg_722r" then
		
		if CInt(DATAMANAGER.GetDataValue( 0 , "obtrf_cntg_722r", "OutBlock1", "FEE" , 0)) <> 0 then
			Container0.Table0.SetCellFgColor( 3, 1, "11")
		else
			Container0.Table0.SetCellFgColor( 3, 1, "4")
		end if
		
	end if
	
End Sub

	</SCRIPT_INFO>
