				<CELL cell_ly="0,0,1,0" halign="0" line="0,0" caption="[개인정보 수집 및 이용동의]" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="0,1,1,1" halign="0" line="0,0" caption="- 수집 및 이용목적 : 자동이체 서비스의 제공" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,2,1,2" halign="0" line="0,0" caption="- 수집항목(개인정보) : 금융기관명, 출금계좌번호, 생년월일" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,3,1,3" halign="0" line="0,0" caption="   계좌주명, 전화번호" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,4,1,4" halign="0" line="0,0" caption="- 보유 및 이용기간 : 수집, 이용 동의일로부터 자동이체 이용" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,5,1,5" halign="0" line="0,0" caption="   종료 또는 해지 후 5년" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,6,1,6" halign="0" line="0,0" caption="- 신청자는 개인정보 및 고유식별정보 수집 및 이용을 거부할" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,7,1,7" halign="0" line="0,0" caption="   권리가 있으며 권리행사 시 자동이체 신청이 거부될 수 " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,8,1,8" halign="0" line="0,0" caption="   있습니다." fontsize="-2" impidxs="" />
