				<CELL cell_ly="1,9,1,9" halign="0" line="0,0" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,10,1,10" halign="0" line="0,0" caption="[개인정보 제 3자 제공 동의]" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="0,11,1,11" halign="0" line="0,0" caption="- 제공받는 자 : 사단법인 금융결제원, 은행 등 금융회사" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,12,1,12" halign="0" line="0,0" caption="- 개인정보 이용 목적 : 자동이체 서비스 제공, 자동이체 " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,13,1,13" halign="0" line="0,0" caption="   신규 등록 및 해지 사실 통지, 자동이체 출금동의 확인" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,14,1,14" halign="0" line="0,0" caption="- 제공하는 개인정보 항목 : 금융기관명, 출금계좌번호, " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,15,1,15" halign="0" line="0,0" caption="   생년월일, 계좌주명, 전화번호, 출금기관 개설 금융기관에" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,16,1,16" halign="0" line="0,0" caption="   등록된 휴대전화번호" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,17,1,17" halign="0" line="0,0" caption="- 보유 및 이용기간 : 수집, 이용 동의일로부터 자동이체 이용" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,18,1,18" halign="0" line="0,0" caption="   종료 또는 해지 후 5년" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,19,1,19" halign="0" line="0,0" caption="- 신청자는 개인정보를 금융결제원에 제공하는 것을 거부할" fontsize="-2" impidxs="" />
