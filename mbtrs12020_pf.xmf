	<SCRIPT_INFO _len="4370" _ulen="3992" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SecType		' 신용구분
Dim 	g_szOrd_SecDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    If g_nOrd_ChkAll = "1" Then
	    g_nOrd_Qty = "전부"
    End If
	
'    If g_nIndex <> 3 Then
'	    Select Case g_szOrd_OrdType	'단가입력하지 않는 주문유형은 가격 초기화
'		Case 005, 012, 013, 061, 071, 305, 312, 405, 412, 053, 353, 453, 064
'		    g_nOrd_Price = "0"
'		End Select
'    End If

	If g_szOrder_MarketType = "W" Then	'ELW
	    lblCancleTitle.caption = "ELW 취소주문"
    End If

	tblCancle.SetCellString( 0, 1, g_szOrder_Acc 		)
	tblCancle.SetCellString( 0, 2, g_szOrder_AccName		)
	tblCancle.SetCellString( 1, 1, g_szOrd_ItmCode 		)
	tblCancle.SetCellString( 2, 1, g_szOrd_ItmName		)
	tblCancle.SetCellString( 3, 1, g_nOrd_Qty			)
	tblCancle.SetCellString( 4, 1, g_nOrd_OrdNo 		)
	
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= CInt( arrData( 0) )	' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
	g_szOrder_MarketType	= arrData( 1)	' 주문종류 ( J:주식, W:ELW )
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_OrdType  		= arrData( 6)	' 주문구분
	g_szOrd_Security 		= arrData( 7)	' 현금/신용
	g_szOrd_SecType 		= arrData( 8)	' 신용구분
	g_szOrd_SecDate 		= arrData( 9)	' 대출일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(13)	' 잔량전부
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
    Set_Data(g_nIndex)
    
End Sub


'============================================================================
Sub btnCancleClose_OnClick()
	Form.CloseForm( )
	
End Sub


'============================================================================
Sub btnCancle_OnClick()
	SendOrder()
End Sub


'============================================================================
Sub imgClose3_OnClick()
	Form.CloseForm( )
End Sub


	</SCRIPT_INFO>
