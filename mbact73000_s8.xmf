'============================================================================
Function Str_Chk(str, sGubn)
	'한글 입력 체크
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
    
	If sGubn == "ENG_NAME" then
		If chk_n == 1 Then  
			return False
		End if
	End if
	
	return True
End Function 

'============================================================================
' 이메일-한글체크 v0006
'============================================================================
Function Str_Chk_Email(str, sGubn)
	dim i				'루프용 
	dim chk_n, chk_c, chk_t
	Dim sTail, sTailTemp, sTailDetail
	sTail = ""
	sTailTemp = ""
	sTailDetail = ""
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
	
	'2023-02-08 양현정 추가 
	'@ 포함여부 체크
	if Instr(str, "@") == 0 then
		return False
	end if
	
	sTail = split(str, "@")
	If ubound(sTail) > 0 Then 
		sTailTemp = sTail[1]
		
		'@ 뒤에 . 포함여부 체크, @ 바로 뒤에 . 이 와도 오류처리함
		if InStr(sTailTemp, ".") == 0 or InStr(sTailTemp, ".") == 1 then
			return False		
		end if	
		
		sTailDetail = split(sTailTemp, ".")
		
		If ubound(sTailDetail) == 0 Then 
			'. 전에 문자가 없어도 오류처리함
			return False
		end if
		
		'. 뒤에 문자가 없어도 오류처리함
		if len(trim(sTailDetail[1])) == 0 then
			return False
		end if
	end if
	
	return True
End Function


