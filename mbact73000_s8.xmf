'End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'카카오뱅크 후속절차 대상내역 조회
	If szTranID == "obaci_acct_300r" Then
		Dim szUserID
		szUserID = Form.GetSharedData("&USER_ID", false)
		If g_szProcCode == "3" Or g_szProcCode == 3 Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ELFN_ID" , 0 , szUserID)
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RCNO_PIP" , 0 , g_szRcnoPip)
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'카카오뱅크 후속절차 대상내역 조회
	If szTranID == "obaci_acct_300r" Then
	
		'로그인해서 팝업에서 넘어오는 경우 휴대폰인증을 하지 않으므로.. 조회값으로 기본값 매핑함..
		if g_szProcCode = "3" then
			g_szRcnoPip = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "RCNO_PIP" 	  	, 0)
			g_szName    = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CUST_ABWR_NAME"	, 0)
			g_szPhone1  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CLPH_TONO" 		, 0)
			g_szPhone2  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CLPH_TELNO" 		, 0)
			g_szPhone3  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CLPH_SRNO" 		, 0)
			
			Form.SetSharedData("BDM_NAME"     , g_szName      )  '이름
			Form.SetSharedData("BDM_RCNO_PIP" , g_szRcnoPip   )  '주민등록번호			
			Form.SetSharedData("BDM_HP1"      , g_szPhone1    )  '휴대폰번호
			Form.SetSharedData("BDM_HP2"      , g_szPhone2    )
			Form.SetSharedData("BDM_HP3"      , g_szPhone3    )			
		end if
	
		contMain.edtName.caption = g_szName
		contMain.edtPhone.caption = g_szPhone1 & "-" & g_szPhone2 & "-" & g_szPhone3
		
		g_szEngName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "CUST_ENG_NAME" , 0)
		If g_szEngName <> "" And g_szEngName <> null Then
			contMain.edtEngName.caption = g_szEngName
		End If
		
		g_szEmail = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "EMAIL_ADDR" , 0)
		If g_szEmail <> "" And g_szEmail <> null Then
			contMain.edtEmail.caption = g_szEmail
		End If
		
		g_szOwhsRegnZip	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_OWHS_REGN_ZIP" , 0)
		g_szOwhsDtlZip  	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_OWHS_DTL_ZIP" , 0)
		g_szOwhsPost 		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_OWHS_POST" , 0)
		g_szOwhsDtl 		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_OWHS_DTAD" , 0)
		g_szOwhsNewAddr 	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_OWHS_NW_ADDR_USE_YN" , 0)
		g_szOwhsBldnMnno 	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_OWHS_BLDN_MNNO" , 0)
		
		g_szCoRegnZip 	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_CO_REGN_ZIP" , 0)
		g_szCoDtlZip 		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_CO_DTL_ZIP" , 0)
		g_szCoPost 		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_CO_POST" , 0)
		g_szCoDtl 		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_CO_DTAD" , 0)
		g_szCoNewAddr 	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_CO_NW_ADDR_USE_YN" , 0)
		g_szCoBldnMnno 	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "UI_CO_BLDN_MNNO" , 0)
		
		Dim szMailTpCode
		szMailTpCode 		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "MAIL_INAG_TYPE_CODE" , 0)
		If szMailTpCode <> "" And szMailTpCode <> null Then
			If szMailTpCode == "01" Then	'자택
				contMain.rdoAddrType.currentindex = "0"
				contMain.lblAddr.caption 	= g_szOwhsPost
				contMain.lblAddrDtl.caption	= g_szOwhsDtl
			Else							'직장
				contMain.rdoAddrType.currentindex = "1"
				contMain.lblAddr.caption 	= g_szCoPost
				contMain.lblAddrDtl.caption	= g_szCoDtl
			End If
			g_bInformOk = True
		Else
			g_bInformOk = False
		End If
		
		f_BtnEnableChk()
	
	'금융상품가입일련번호 채번
	ElseIf szTranID == "obsap_acif_999a" Then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "FNPR_JOIN_SRNO" , 0)
		
		f_SetSharedData()
		
		'이 단계에서는 g_szProcCode가 "3"이던 아니던간에 mbact73000_s9 로 넘어감 
		'고객확인의무 단계로 진행
		Form.OpenNextPopup("mbact73000_s9", "", "")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	If szSubErr <> "" And szSubErr <> null Then
		Form.ShowAlert("알림", szErrMsg.."("..szSubErr..")" )
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Function f_BtnEnableChk()
	'하단 다음버튼 활성화 체크
	If contMain.edtEngName.caption == "" Or contMain.edtEngName.caption == null Then
		Exit Function
	End If
	
	If contMain.edtEmail.caption == "" Or contMain.edtEmail.caption == null Then
		Exit Function
	End If
	
	If CInt(contMain.rdoAddrType.currentindex) == -1 Then
		Exit Function
	End If
	
	If contMain.lblAddr.caption == "" Or contMain.lblAddr.caption == null Or contMain.lblAddrDtl.caption == "" Or contMain.lblAddrDtl.caption == null Then
		Exit Function
	End If
	
	If Not g_bInformOk Then
		Exit Function
	End If
	
	BtnNext.enable = true
End Function 

'============================================================================
Function f_GetSharedData()
	'이전 단계에서 저장한 필요한 데이터들 가져옴
	g_szRcnoPip = Form.GetSharedData("BDM_RCNO_PIP", false)
	g_szProcCode = Form.GetSharedData("KAKAO_PROS_CODE", false) 
	g_szName = Form.GetSharedData("BDM_NAME", false)
	g_szPhone1 = Form.GetSharedData("BDM_HP1", false)
	g_szPhone2 = Form.GetSharedData("BDM_HP2", false)
	g_szPhone3 = Form.GetSharedData("BDM_HP3", false)
End Function

'============================================================================
Function f_SetSharedData()
	Form.SetSharedData("BDM_CUST_ENG_NAME"          , g_szEngName )
	Form.SetSharedData("BDM_EMAIL_ADDR"          , g_szEmail )
	If CInt(contMain.rdoAddrType.currentindex) == 0 Then
		Form.SetSharedData("BDM_MAIL_INAG_TYPE_CODE"          , "01" )
	Else
		Form.SetSharedData("BDM_MAIL_INAG_TYPE_CODE"          , "02" )
	End If
	Form.SetSharedData("BDM_OWHS_REGN_ZIP"          , g_szOwhsRegnZip )
	Form.SetSharedData("BDM_OWHS_DTL_ZIP"          , g_szOwhsDtlZip )
	Form.SetSharedData("BDM_OWHS_POST"          , g_szOwhsPost )
	Form.SetSharedData("BDM_OWHS_DTAD"          , g_szOwhsDtl )
	Form.SetSharedData("BDM_OWHS_NEW_ADDR"          , g_szOwhsNewAddr )
	Form.SetSharedData("BDM_OWHS_BLDN_MNNO"          , g_szOwhsBldnMnno )
	
	Form.SetSharedData("BDM_CO_REGN_ZIP"          , g_szCoRegnZip )
	Form.SetSharedData("BDM_CO_DTL_ZIP"          , g_szCoDtlZip )
	Form.SetSharedData("BDM_CO_POST"          , g_szCoPost )
	Form.SetSharedData("BDM_CO_DTAD"          , g_szCoDtl )
	Form.SetSharedData("BDM_CO_NEW_ADDR"          , g_szCoNewAddr )
	Form.SetSharedData("BDM_CO_BLDN_MNNO"          , g_szCoBldnMnno )
	
	If CInt(contMain.rdoInform.currentindex) == 0 Then
		Form.SetSharedData("BDM_SNML_INAG_TYPE_CODE"          , "51" )
	ElseIf CInt(contMain.rdoInform.currentindex) == 1 Then
		Form.SetSharedData("BDM_SNML_INAG_TYPE_CODE"          , "21" )
	ElseIf CInt(contMain.rdoInform.currentindex) == 2 Then
		Form.SetSharedData("BDM_SNML_INAG_TYPE_CODE"          , "01" )
	Else
		Form.SetSharedData("BDM_SNML_INAG_TYPE_CODE"          , "02" )
	End If
	
	Form.SetSharedData("BDM_FNPR_JOIN_SRNO"          , g_szFnprJoinSrno )
	
	If CInt(contMain.rdoProvision.currentindex) == 0 Then
		Form.SetSharedData("BDM_HNDV_MTHD_CLCD"          , "04" )
	Else
		Form.SetSharedData("BDM_HNDV_MTHD_CLCD"          , "02" )
	End If
End Function 

'============================================================================
Sub contMain_edtEngName_OnEditComplete()
'	If Trim(contMain.edtEngName.caption) == "" Then				
'		contMain.edtEngName.SetResultLabel("1","error","고객영문명을 확인하세요.","contMain")
'		contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtEngName.top, "1")) 
'		return False
'	Else 
'		contMain.edtEngName.SetResultLabel("0","complete","","contMain")
'	End If 	

	'2023-02-08 필수값 체크 추가
	if len(trim(contMain.edtEngName.caption)) == 0 then
		contMain.edtEngName.SetResultLabel("1","error","고객영문명을 입력하세요.","contMain")
		Exit Sub	
	end if

	If Str_Chk(contMain.edtEngName.caption, "ENG_NAME") == False then		 
		contMain.edtEngName.SetResultLabel("1","error","고객영문명은 영문만 입력 가능합니다.","contMain")
		Exit Sub
	Else
		g_szEngName = contMain.edtEngName.caption
		
		contMain.edtEngName.SetResultLabel("0","complete","","contMain")
	End If
	
	f_BtnEnableChk()
End Sub

'============================================================================
Sub contMain_edtEmail_OnEditComplete()
	'contMain.edtEmail.SetResultLabel("0", "", "", "", 1)	
	'contMain.edtEmail.SetUseResultLabel(true, 1)			
	
	Dim sParam, sTail, sTailTemp, sTailDetail
	sParam  = ""
	sTail   = ""
	sTailTemp = ""
	sTailDetail = ""

	sParam = contMain.edtEmail.caption
	If LEN(TRIM(sParam)) > 0 Then 
		sTail = split(sParam, "@")
		
		'2021.05.01. 김유경. 개선사항 추가
		If Str_Chk_Email(contMain.edtEmail.caption, "EMAIL") == False then		 
			contMain.edtEmail.SetResultLabel("1","error","이메일을 확인하세요.","contMain")
			'contMain.edtEmail.caption = ""
			Exit Sub
		End If
				
		If ubound(sTail) > 0 Then 
			
'			'2021.05.01. 김유경. 개선사항 추가
'			If Str_Chk_Email(contMain.edtEmail.caption, "EMAIL") == False then		 
'				contMain.edtEmail.SetResultLabel("1","error","이메일을 확인하세요.","contMain")
'				Exit Sub
'			End If
	
			sTailTemp = sTail[1]
			sTailDetail = split(sTailTemp, ".")
			
			If sTailDetail[0] == "yahoo" or sTailDetail[0] == "hotmail" Then
				contMain.edtEmail.SetUseResultLabel(true, 3)
				contMain.edtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","contMain", 3)	'v0007
				contMain.edtEmail.caption = ""
				Exit Sub
			Else 
				g_szEmail = contMain.edtEmail.caption
				
				contMain.edtEmail.SetResultLabel("0","complete","","contMain")
			End If
		End If
	else
		contMain.edtEmail.SetResultLabel("1","error","이메일을 입력하세요.","contMain")
		Exit Sub	
	End If
	
	f_BtnEnableChk()
End Sub

'============================================================================
Sub contMain_rdoInform_OnClick(nIndex)
	'거래내역 통보처 자택 또는 직장 선택시 등록 되어있는지 확인
	If nIndex == 2 Or nIndex == 3 Then
		If nIndex == 2 Then
			If g_szOwhsRegnZip == "" Or g_szOwhsRegnZip == null Then
				g_bInformOk = false
				contMain.rdoInform.SetResultLabel("1","error","등록된 자택 정보가 없습니다.","contMain")
				Exit Sub
			Else
				g_bInformOk = true
				contMain.rdoInform.SetResultLabel("0","complete","","contMain")
			End If
		End If
		
		If nIndex == 3 Then
			If g_szCoRegnZip == "" Or g_szCoRegnZip == null Then
				g_bInformOk = false
				contMain.rdoInform.SetResultLabel("1","error","등록된 직장 정보가 없습니다.","contMain")
				Exit Sub
			Else
				g_bInformOk = true
				contMain.rdoInform.SetResultLabel("0","complete","","contMain")
			End If
		End If
	Else
		g_bInformOk = true
		contMain.rdoInform.SetResultLabel("0","complete","","contMain")
	End If
	
	f_BtnEnableChk()
End Sub

