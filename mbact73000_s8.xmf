	<SCRIPT_INFO _len="20287" _ulen="18967" >
'--===========================================================================
' 01. 화 면 명 : 카뱅후속-고객정보 입력(1/2)
' 02. 화면설명 : 카뱅후속-고객정보 입력(1/2)
' 03. 작    성 : 2022.12.19
'                비대면 고객정보 입력 참고...
'--===========================================================================
Dim g_szRcnoPip
Dim g_szProcCode
Dim g_szName, g_szEngName, g_szEmail
Dim g_szPhone1, g_szPhone2, g_szPhone3
Dim g_szOwhsRegnZip, g_szOwhsDtlZip, g_szOwhsPost, g_szOwhsDtl, g_szOwhsNewAddr, g_szOwhsBldnMnno		'자택 주소 데이터	
Dim g_szCoRegnZip, g_szCoDtlZip, g_szCoPost, g_szCoDtl, g_szCoNewAddr, g_szCoBldnMnno					'직장 주소 데이터
Dim g_szFnprJoinSrno

Dim g_bInformOk

'============================================================================
Sub Form_OnFormInit()
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	contMain.edtName.setApplyLabel("이름" , 0 , 268 , "left" , false)
	contMain.edtEngName.setApplyLabel("영문명" , 0 , 268 , "left" , true)
	contMain.edtPhone.setApplyLabel("휴대폰번호" , 0 , 268 , "left" , true)
	contMain.edtEmail.setApplyLabel("이메일 주소" , 0 , 268 , "left" , true)
	
	contMain.edtName.enable = false
	contMain.edtPhone.enable = false
	
	BtnNext.enable = false
	
	contMain.edtEngName.SetUseResultLabel(true,1)
	contMain.edtEmail.SetUseResultLabel(true,1)
	contMain.rdoInform.SetUseResultLabel(true,1)
	
	f_GetSharedData()
	
	g_bInformOk = false
	
	'카카오뱅크 후속절차 대상내역 조회
	DATAMANAGER.RequestTranData( "obaci_acct_300r" )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
    
	'주소검색 팝업 리턴
	If sKeyName == "mbbdm85150_p1" And sRet == "ok" Then	
		Dim szTmpRegnZip, szTmpDtlZip, szTmpPost, szTmpDtl, szTmpBldnMnno
		szTmpRegnZip		= Form.GetSharedData("10050_ADDRESS_REGN_ZIP", False )
		szTmpDtlZip		= Form.GetSharedData("10050_ADDRESS_DTL_ZIP" , False )
		szTmpPost		= Form.GetSharedData("10050_ADDRESS_POST"    , False )
		szTmpDtl			= Form.GetSharedData("10050_ADDRESS_DTAD"    , False )
		szTmpBldnMnno		= Form.GetSharedData("10050_ADDRESS_BLDN"    , False )
		
		If contMain.rdoAddrType.currentindex == "0" or contMain.rdoAddrType.currentindex == 0 Then
			If g_szOwhsRegnZip <> szTmpRegnZip or g_szOwhsDtlZip <> szTmpDtlZip or g_szOwhsPost <> szTmpPost or g_szOwhsDtl <> szTmpDtl or g_szOwhsBldnMnno <> szTmpBldnMnno Then
				g_szOwhsRegnZip	= Form.GetSharedData("10050_ADDRESS_REGN_ZIP", False )
				g_szOwhsDtlZip	= Form.GetSharedData("10050_ADDRESS_DTL_ZIP" , False )
				g_szOwhsPost 		= Form.GetSharedData("10050_ADDRESS_POST"    , False )
				g_szOwhsDtl 		= Form.GetSharedData("10050_ADDRESS_DTAD"    , False )
				g_szOwhsBldnMnno	= Form.GetSharedData("10050_ADDRESS_BLDN"    , False )
				
				contMain.lblAddr.caption = g_szOwhsPost
				contMain.lblAddrDtl.caption = g_szOwhsDtl
				
				g_szOwhsNewAddr = "Y"
			End If
		Else
			If g_szCoRegnZip <> szTmpRegnZip or g_szCoDtlZip <> szTmpDtlZip or g_szCoPost <> szTmpPost or g_szCoDtl <> szTmpDtl or g_szCoBldnMnno <> szTmpBldnMnno Then
				g_szCoRegnZip		= Form.GetSharedData("10050_ADDRESS_REGN_ZIP", False )
				g_szCoDtlZip		= Form.GetSharedData("10050_ADDRESS_DTL_ZIP" , False )
				g_szCoPost 		= Form.GetSharedData("10050_ADDRESS_POST"    , False )
				g_szCoDtl 		= Form.GetSharedData("10050_ADDRESS_DTAD"    , False )
				g_szCoBldnMnno	= Form.GetSharedData("10050_ADDRESS_BLDN"    , False )
				
				contMain.lblAddr.caption = g_szCoPost
				contMain.lblAddrDtl.caption = g_szCoDtl
				
				g_szCoNewAddr = "Y"
			End If
		End If
		
		g_bInformOk = true
		f_BtnEnableChk()
		
'		Form.ShowAlert("g_szOwhsNewAddr", g_szOwhsNewAddr)
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "Exit" And sRet == "ok" Then
'		Form.CloseForm()
		Form.OpenNextPopup("mbact73000", "", "")
	End If
End Sub

'============================================================================
'Sub Form_OnFormClose()
