	Form.OpenPopupAnimation("mbbdm85150_p1", "pass", "", "2")
End Sub

'============================================================================
Sub contMain_rdoAddrType_OnClick(nIndex)
	contMain.lblAddr.caption = ""
	contMain.lblAddrDtl.caption = ""
	
	If nIndex == 0 Then
		contMain.lblAddr.caption = g_szOwhsPost
		contMain.lblAddrDtl.caption = g_szOwhsDtl
	Else
		contMain.lblAddr.caption = g_szCoPost
		contMain.lblAddrDtl.caption = g_szCoDtl
	End If
	
	f_BtnEnableChk()
End Sub

