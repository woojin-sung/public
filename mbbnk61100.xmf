'	cont0.edtAltnAcnt.enable 	= false '입고계좌 에디트
''			cont0.btnCheckAcnt.enable 	= false '입고계좌 확인 버튼
'	cont0.rdoTrnfYN.enable 	= false '양도여부 라디오
'	cont0.chkTrnfYN.enable		= false '양도외거래 확인사항 체크
'	cont0.lblTrnfYNChk.enable 	= false '양도외거래 확인사항 체크
'
'	Form.Toast(0, "출고처리가 진행 중입니다.", false)
'	DATAMANAGER.RequestTranData( "obrts_tkwr_005a" )	'출고처리
End Sub


