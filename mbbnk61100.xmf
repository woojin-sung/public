End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	If  szTranID = "obrts_tkwr_005a" Then	
		cont0.grdList.SetCellData( "bd_SuccessYN"	, g_nTRcount , "처리불가"	)
		
		If szSubMsg <> "" And szSubMsg <> Null Then
		    cont0.grdList.SetCellData( "bd_ReasonN"	, g_nTRcount , szErrMsg & "\n(" & szSubMsg & ")")
		Else
		    cont0.grdList.SetCellData( "bd_ReasonN"	, g_nTRcount , szErrMsg)
		End If
		
		If tonumber(cont0.grdList.rowcount-1) == g_nTRcount Then			
			'************************************
			' szSendData : 출고정보♥종목정보~~♥종목정보~~...
			' 출고정보 : 당사/타사구분값★입고계좌번호★입고계좌명★상대증권★수수료합계(타사에서 사용/당사일경우 빈값)
			' 종목정보 : 종목명★출고수량★처리성공여부★처리불능일경우Msg
			'************************************
			Dim szSendData
			szSendData =  "3" & "★" & cont0.edtAltnAcnt.caption & "★" & cont0.lblAltnAcntName.caption & "★" & "메리츠증권" & "★" & 0 & "★" & acnt0.caption 
				
			For i = 0 to tonumber(cont0.grdList.rowcount-1) 
				Dim szIscdNm, szQty, szSuccessYN, szReasonN
				szIscdNm 	= cont0.grdList.GetCellData( "bd_IscdNm"		, i)
				szQty 		= cont0.grdList.GetCellData( "bd_Qty"			, i)
				szSuccessYN 	= cont0.grdList.GetCellData( "bd_SuccessYN"	, i)
				szReasonN 	= cont0.grdList.GetCellData( "bd_ReasonN"		, i)
				szSendData 	= szSendData & "♥" & szIscdNm & "★" & szQty  & "★" & szSuccessYN & "★" & szReasonN 
			Next
			Form.OpenPopup( "mbbnk61100_p5" , szSendData , "")	'출고결과 확인
			f_InitCtrl()
		Else
			g_nTRcount = g_nTRcount + 1
			DATAMANAGER.RequestTranData( "obrts_tkwr_005a" )	
		End If
	
	ElseIf szTranID <> "obrts_tkwr_005a" Then
	
	    If Trim(szSubMsg) == "" Or Trim(szSubMsg) == Null Then
	        Form.ShowAlert("알림", szErrMsg)
	    Else
	        Form.ShowAlert("알림", szErrMsg & "\n" & "(" & szSubMsg & ")")
	    End If

	End If
End Sub












