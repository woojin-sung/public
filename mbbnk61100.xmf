'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'메모리평문적용여부(0:미적용 / 1:적용)
	Dim szPlain_rm, szPwd
	szPlain_rm = Form.GetSharedData("&PLAIN_RM" , false)	
	If szPlain_rm == "1" Then
	    szPwd = edtPswd.caption
	Else
	    szPwd = Form.GetEncData(edtPswd.caption)
	End If

	'계좌번호 기본 고객정보 조회
	If szTranID = "obacp_comm_040r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0, Left( cont0.edtAltnAcnt.Caption(), 8 ) 	) 	'이체 계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 	, 0, Right( cont0.edtAltnAcnt.Caption(), 2 ) 	)  	'이체 계좌일련번호
		
	'동일인 여부 조회
	ElseIf szTranID = "obrtp_comn_019r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0, acnt0.total 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 	, 0, acnt0.sequence 	)	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ACNO" 			, 0 , Left( cont0.edtAltnAcnt.Caption(), 8 ) 	) 	'이체 계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ASNO" 			, 0 , Right( cont0.edtAltnAcnt.Caption(), 2 ) )  	'이체 계좌일련번호
			
	'당사대체출고
	ElseIf szTranID = "obrts_tkwr_005a" Then
		Dim szISCD, szBuyDate, szTaxCode, nByovErt, szTaxPaymCd, nTkwrQty, nRghtExerRffusQty
		szISCD	 		= cont0.grdList.GetCellData("bd_Iscd"		, g_nTRcount )
		szBuyDate 		= cont0.grdList.GetCellData("bd_BuyDate"	, g_nTRcount )
		szTaxCode 		= cont0.grdList.GetCellData("bd_TaxCode"	, g_nTRcount )
		nByovErt 		= tonumber(cont0.grdList.GetCellData("bd_ByovErt"		, g_nTRcount ))
		szTaxPaymCd 		= cont0.grdList.GetCellData("bd_TaxPaymCd"	, g_nTRcount )
		nTkwrQty			= tonumber(cont0.grdList.GetCellData("bd_Qty"			, g_nTRcount ))
		nRghtExerRffusQty	= tonumber(cont0.grdList.GetCellData("bd_BuyAbleQty" 	, g_nTRcount ))	'매수청구/반대의사 가능수량
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS" 			, 0 , "1" 									)	'처리구분
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_BRCD" 			, 0 , "" 									)	'처리지점코드 2022.04.07 서비스에서 자체처리
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_DATE" 			, 0 , Form.GetSharedData( "&HOST_DATE", False ) 	)	'처리일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , acnt0.total 							)	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 				, 0 , acnt0.sequence 							)	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd									)	'비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 				, 0 , szISCD 									)	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BYOV_DATE" 			, 0 , szBuydate 								)	'매수일자		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OVRL_SPTX_CLS_CODE" 	, 0 , szTaxCode 								) 	'종합 분리과세 구분
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TKWR_QTY" 			, 0 , nTkwrQty 								)	'수량
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRMD_CLS_CODE" 		, 0 , "17" 									)	'거래매체 구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_CLS_CODE"		, 0 , "01" 									)	'이체구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INHR_ACNT_YN" 		, 0 , "N" 									)	'상속계좌여부		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ALTN_ACNO" 			, 0 , Left( cont0.edtAltnAcnt.Caption(), 8 ) 			) 	'이체 계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ALTN_ASNO" 			, 0 , Right( cont0.edtAltnAcnt.Caption(), 2 ) 			)  	'이체 계좌일련번호	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BYOV_ERT" 			, 0 , nByovErt								)	'매수수익률 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TAX_PAYM_CLS_CODE"	, 0 , szTaxPaymCd								) 	'세금납입구분코드 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RGHT_EXER_RFUS_QTY"	, 0 , nRghtExerRffusQty						) 	'권리행사거부수량 
		If cont0.rdoTrnfYN.currentindex == "0" Then 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRNF_YN" , 0 , "Y" )  		'양도여부
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRNF_YN" , 0 , "N" )  		'양도여부
		End If
		
	'20220519 계좌 정상 체크
	elseif szTranID == "obrtp_comn_041r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0, acnt0.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0, acnt0.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0, szPwd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SCR_FUNC_CLS_CODE" , 0, "4" ) '4:출고
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_CLS_CODE" , 0, "01" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMCD" , 0, "003040" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_DATE" , 0, Form.GetSharedData("&HOST_DATE", false ))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRMD_CLS_CODE" , 0, "17")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_OCRN_CLS_CODE" , 0, "01")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_NCSR_YN" , 0, "Y") '비밀번호 확인여부
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계좌번호 기본 고객정보 조회
	If szTranID = "obacp_comm_040r" Then
		Dim szCsNm
		szCsNm= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNM" , 0 )
		
		If szCsNm == null or szCsNm == "" Then
			cont0.edtAltnAcnt.caption = ""
			cont0.lblAltnAcntName.caption = ""
			Form.ShowAlert( "알림", "입력하신 계좌번호를 다시 확인해주세요.")
		Else
			cont0.lblAltnAcntName.caption = szCsNm
			DATAMANAGER.RequestTranData( "obrtp_comn_019r" )	'동일인 여부 조회
		End If	
	
	'동일인 여부 조회
	ElseIf szTranID = "obrtp_comn_019r" Then
		g_szSapeYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SAPE_YN" , 0 )
		
		If g_szSapeYN <> "" and g_szSapeYN <> null Then
			If g_szSapeYN == "Y" Then
				cont0.rdoTrnfYN.currentindex = "1"
			Else 
				'컨트롤 visible
				cont0.tblReceiving.SetCellString(3, 0, "양도여부")
				cont0.rdoTrnfYN.visible = true
				Form.OpenPopup("mbbnk61100_p7", "", "")	'타인대체출고유의사항		
			End If
		End If
		f_ChangeBtnState() '2022.05.09
	
	'20220518 계좌 정상 체크
	elseif szTranID == "obrtp_comn_041r" then
		dim sMsgCode, sMsg, sMsgSub, sTR_ABLE_YN
		sTR_ABLE_YN = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "TR_ABLE_YN" , 0)) '계좌정상여부
		sMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
		
		if sMsgCode <> "5766" or sTR_ABLE_YN <> "Y" then
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sMsgSub = DATAMANAGER.GetDataMsgSubText( szTranID )
			
			if sMsgCode == "3335" or sMsgCode == "2414" then
				if sMsgSub <> "" and sMsgSub <> null then
					Form.ShowAlert("알림", sMsg &" (" & sMsgSub & ")")
				else
					Form.ShowAlert("알림", sMsg )
				end if
			end if
			
			g_bAcntCheck = false
		end if 
	
		g_bAcntCheck = true
		f_ChangeBtnState() '2022.05.09
		
	'당사대체출고
	ElseIf  szTranID = "obrts_tkwr_005a" Then
		Dim szMsgCode, szTranMsg
		szMsgCode = tonumber(DATAMANAGER.GetDataMsgCode( szTranID ))
		szTranMsg  = DATAMANAGER.GetDataMsgText( szTranID )
		
		If szMsgCode == 6620 Then	'대체출고처리성공
			cont0.grdList.SetCellData( "bd_SuccessYN" , g_nTRcount, "완료")
		Else
			cont0.grdList.SetCellData( "bd_SuccessYN" , g_nTRcount, "처리불가")
			cont0.grdList.SetCellData( "bd_ReasonN"	 , g_nTRcount, szTranMsg)
		End If
		
		If tonumber(cont0.grdList.rowcount-1) == g_nTRcount Then		
			'************************************
			' szSendData : 출고정보♥종목정보~~♥종목정보~~...
			' 출고정보 : 당사/타사구분값★입고계좌번호★입고계좌명★상대증권★수수료합계(타사에서 사용/당사일경우 0)
			' 종목정보 : 종목명★출고수량★처리성공여부★처리불능일경우Msg
			'************************************
			Dim szSendData
			szSendData =  "3" & "★" & cont0.edtAltnAcnt.caption & "★" & cont0.lblAltnAcntName.caption & "★" & "메리츠증권" & "★" & 0 & "★" & acnt0.caption 	
			
			For i = 0 to tonumber(cont0.grdList.rowcount-1) 
				Dim szIscdNm, szQty, szSuccessYN, szReasonN
				szIscdNm 	= cont0.grdList.GetCellData( "bd_IscdNm"		, i)
				szQty 		= cont0.grdList.GetCellData( "bd_Qty"			, i)
				szSuccessYN 	= cont0.grdList.GetCellData( "bd_SuccessYN"	, i)
				szReasonN 	= cont0.grdList.GetCellData( "bd_ReasonN"		, i)
				szSendData 	= szSendData & "♥" & szIscdNm & "★" & szQty  & "★" & szSuccessYN & "★" & szReasonN 
			Next
			Form.OpenPopup( "mbbnk61100_p5" , szSendData , "")	'출고결과 확인
			f_InitCtrl()
		Else
			g_nTRcount = g_nTRcount + 1
