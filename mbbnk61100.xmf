'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'안내사항
	if sEventName == "INFO_CLICK" then
		Form.OpenFramePopup( "mbbnk61100_p2" , "3", "")
	end if
End Sub


'============================================================================
' cont0_grdList_OnClickUp 
'============================================================================
Sub cont0_grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_Del" Then
		cont0.grdList.SetDeleteRow( lRow )
		f_ChangeBtnState() '2022.05.09
	ElseIf szCellID == "bd_ShowQty" then	'220517 Qty > ShowQty 로 변경
		g_nChoiceRow = CInt(lRow)
		
		Dim szAbleQty, szQty, szIscd, szIscdNm, szIssuTpCd
		szAbleQty = cont0.grdList.GetCellData( "bd_AbleQty", lRow )
		szQty = cont0.grdList.GetCellData( "bd_Qty", lRow )
		szIscd = cont0.grdList.GetCellData( "bd_Iscd", lRow )
		szIscdNm = cont0.grdList.GetCellData( "bd_IscdNm", lRow )
		szIssuTpCd = cont0.grdList.GetCellData( "bd_IssuTpCd", lRow )

		Form.OpenPopup("mbbnk61100_p6", szAbleQty & "★" & szQty & "★" & szIscd & "★" & szIscdNm & "★" & szIssuTpCd,"")	
	End If
End Sub

'============================================================================
' cont0_edtAltnAcnt_OnClick() : 아이폰 에이트 선택시 화면이동이슈
'============================================================================
Sub cont0_edtAltnAcnt_OnClick()
	dim nItemListCnt
	nItemListCnt = CInt(cont0.grdList.rowcount)
	
	if nItemListCnt > 0 then
		dim szState, nQty, szShowQty
		szState = true
		
		for i=0 to nItemListCnt-1 
			szShowQty = cont0.grdList.GetCellData( "bd_ShowQty", i ) 'Show출고수량
			nQty = tonumber(cont0.grdList.GetCellData( "bd_Qty", i )) '출고수량
			if szShowQty == "수량입력" or nQty == 0 or nQty == null then	'220517 szShowQty 추가
				szState = false
				Exit for
			end if
		next
		
		if szState == true then
			g_szCurKeyPad = "edtAltnAcnt"
	
			if g_OSType <> "1" then
				cont0.lblScrollPos.top = 400
				cont0.SetScrollAutoSize()
				cont0.scroll_pos = 110
			end if
		else
			Form.ShowAlert("알림", "출고하실 수량을 입력해주세요.")
		end if
	else
		Form.ShowAlert("알림", "출고하실 종목을 추가해주세요.")
	end if
End Sub

'============================================================================
' cont0_edtAltnAcnt_OnEditComplete() 입금계좌 확인
'============================================================================
Sub cont0_edtAltnAcnt_OnEditComplete()	
	'입금계좌 고객명 양도여부 초기화
	cont0.lblAltnAcntName.caption = ""
	g_szSapeYN = ""
	cont0.rdoTrnfYN.currentindex = "-1"
	cont0.chkTrnfYN.checkstate = "0"
	
	'컨트롤 visible
	cont0.tblReceiving.SetCellString(3, 0, "")
	cont0.rdoTrnfYN.visible = false
	cont0.lblTrnfYNChk.visible = false
	cont0.chkTrnfYN.visible = false
	
	If Len(cont0.edtAltnAcnt.Caption()) == 10 Then
		DATAMANAGER.RequestTranData( "obacp_comm_040r" )	'계좌번호 기본 고객정보 조회
	Else
		cont0.edtAltnAcnt.caption = ""
		Form.ShowAlert("알림", "입력하신 계좌번호를 다시 확인해주세요.")
	End If
	f_ChangeBtnState() '2022.05.09
	
	g_szPreKeyPad = "edtAltnAcnt"
	
	if g_OSType <> "1" and g_szPreKeyPad == g_szCurKeyPad then
		cont0.lblScrollPos.top = 0
		cont0.SetScrollAutoSize()
		cont0.scroll_pos = 0
	end if
End Sub

'============================================================================
' cont0_lblTrnfYNChk_OnClick() : 양도외거래 확인사항 체크
'============================================================================
Sub cont0_lblTrnfYNChk_OnClick()	
	If cont0.chkTrnfYN.checkstate == "0" Then
		cont0.chkTrnfYN.checkstate = "1"
	Else
		cont0.chkTrnfYN.checkstate = "0"
	End If
	f_ChangeBtnState() '2022.05.09
End Sub
'============================================================================
Sub cont0_chkTrnfYN_OnChange(sCheckState)
	f_ChangeBtnState() '2022.05.09
End Sub


'============================================================================
' cont0_rdoTrnfYN_OnClick(nIndex) : 양도여부 선택
'============================================================================
Sub cont0_rdoTrnfYN_OnClick(nIndex)	
	'2022.05.09
	If g_szSapeYN <> "" and g_szSapeYN <> "Y" and nIndex == 1 Then
		cont0.lblTrnfYNChk.visible = true
		cont0.chkTrnfYN.visible = true
	Else
		cont0.chkTrnfYN.checkstate = "0"
		cont0.lblTrnfYNChk.visible = false
		cont0.chkTrnfYN.visible = false
	End If 
	f_ChangeBtnState() '2022.05.09
End Sub


'============================================================================
' btnProcess_OnClick() : 출고처리
