	'**************************************************************************************
	Dim szSendData
	szSendData = "3" & "★" & acnt0.caption & "★" & "메리츠증권" & "★" & cont0.edtAltnAcnt.caption & "★" & cont0.lblAltnAcntName.caption 
				& "★" & 0 & "★" & edtPswd.caption 
   
	Form.OpenFramePopup( "mbbnk61100_p4", szSendData, "" )	'보안매체 + 전자서명 인증
	
	'TEST
	'처리중엔 컨트롤 작동 막기
