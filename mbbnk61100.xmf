'--===========================================================================
' 01. 화 면 명 : 당사 대체출고
' 02. 화면설명 : 당사 대체출고
' 03. 작    성 : 2022.03.29 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szSapeYN	'동일인 여부
Dim g_nTRcount	'255a TR 처리 횟수
Dim g_nChoiceRow	'선택한 Row

' 확장개발 > 컴플리트랑 같이 스크롤포스 조절되서 안먹도록 하기 위해 현재 포커싱 에디트와 이전 포커싱 에디트 비교하여 왓다갓다 하지 않도록 수정
Dim g_OSType
Dim g_szCurKeyPad 
Dim g_szPreKeyPad

Dim g_bAcntCheck '20220519
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_InitCtrl()
'============================================================================
Function f_InitCtrl()
	'계좌비밀번호 리셋
	If edtPswd.caption <> "" Then 
		edtPswd.caption = ""
	End If

	'출고 정보 리셋
	cont0.grdList.SetClear()
	cont0.lblGrdInfo.visible = true
	g_nTRcount = 0
	g_nChoiceRow = -1
	
	'입고계좌정보 리셋
	cont0.edtAltnAcnt.caption = ""
	cont0.lblAltnAcntName.caption = ""
	cont0.rdoTrnfYN.currentindex = "-1"
	cont0.chkTrnfYN.checkstate = "0"
	g_szSapeYN = ""
	
	'컨트롤 visible
	cont0.rdoTrnfYN.visible = false
	cont0.lblTrnfYNChk.visible = false
	cont0.chkTrnfYN.visible = false
	
	cont0.tblReceiving.SetCellString(3, 0, "")
	
	'컨트롤 enable 
	cont0.edtAltnAcnt.enable 	= true '입고계좌 에디트
'	cont0.btnCheckAcnt.enable 	= true '입고계좌 확인 버튼
	cont0.rdoTrnfYN.enable 	= true '양도여부 라디오
	cont0.chkTrnfYN.enable		= true '양도외거래 확인사항 체크
	cont0.lblTrnfYNChk.enable 	= true '양도외거래 확인사항 체크
	btnProcess.enable		= false '출고처리버튼
	
	g_bAcntCheck = false	'20220519
End Function

'===========================================================================
' f_GetPWChkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWChkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )

	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	

'============================================================================
' f_ChangeBtnState() : 입력 조건 확인 후, 버튼 활성/비활성 2022.05.09
'============================================================================
Function f_ChangeBtnState()
	Dim isAble
	isAble = true
	
	'출고종목 체크
	If tonumber(cont0.grdList.rowcount) == 0 Then
		isAble = false
	End If	

	'20220519 계좌 정상 체크
	If g_bAcntCheck == false Then
		isAble= false
	End If
	
	'출고수량 체크
	If tonumber(cont0.grdList.rowcount) > 0 then
		Dim nQty, szShowQty	'입력수량
		For i = 0 to tonumber(cont0.grdList.rowcount) -1
			szShowQty = cont0.grdList.GetCellData("bd_ShowQty", i)
			nQty = tonumber(cont0.grdList.GetCellData("bd_Qty", i))
			if szShowQty == "수량입력" or nQty == 0 or nQty == null then	'220517 szShowQty 추가
				isAble = false
			End If
		Next
	End If
	
	'입고계좌정보 체크
	If cont0.edtAltnAcnt.caption == null or cont0.edtAltnAcnt.caption == "" Then
		isAble = false
	End If
	If Len(cont0.edtAltnAcnt.caption) <> 10 Then
		isAble = false
	End If
	If cont0.lblAltnAcntName.caption == null or cont0.lblAltnAcntName.caption == "" Then
		isAble = false
	End If
	
	'양도여부 체크
	If cont0.rdoTrnfYN.currentindex <> "0" and cont0.rdoTrnfYN.currentindex <> "1" Then
		isAble = false
	End If
	
	'동일인 대체시 양도 여부 체크
	If g_szSapeYN == "Y" THen
		If cont0.rdoTrnfYN.currentindex == "0" Then
			isAble = false
		End If
		
	'타인 대체시 양도 여부 체크
	Else
		If cont0.rdoTrnfYN.currentindex == "1" Then
			If cont0.chkTrnfYN.checkstate == "0" Then
				isAble = false
			End If
		End If
	End If 

	btnProcess.enable = isAble
End Function

'===========================================================================
' f_ValidChk() : 출고처리 유효성 검사
'===========================================================================
Function f_ValidChk()

	'계좌번호 체크
	If acnt0.caption == null or acnt0.caption == "" Then
		Form.ShowAlert( "알림", "계좌번호를 선택해주세요.")	
		return false
	End If
	
	'비밀번호 체크
	If edtPswd.caption == null or edtPswd.caption == "" Then
		Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")	
		return false
	End If
	
	'출고종목 체크
	If tonumber(cont0.grdList.rowcount) == 0 Then
		Form.ShowAlert( "알림", "출고할 종목이 없습니다.\n종목을 추가해주세요.")	
		return false
	End If	

	'출고수량 체크
	If tonumber(cont0.grdList.rowcount) > 0 then
		For i = 0 to tonumber(cont0.grdList.rowcount) -1
			Dim nQty, szShowQty	'입력수량
			
			szShowQty = cont0.grdList.GetCellData("bd_ShowQty", i)
			nQty = CInt(cont0.grdList.GetCellData("bd_Qty", i))
			
			if szShowQty == "입력수량" or nQty == 0 or nQty == null then	'220517 szShowQty 추가
				Form.ShowAlert("알림", "출고수량이 입력되지 않았습니다.")
				return false
			End If
		Next
	End If
	
	'입고계좌정보 체크
	If cont0.edtAltnAcnt.caption == null or cont0.edtAltnAcnt.caption == "" Then
		Form.ShowAlert( "알림", "입고계좌를 입력해주세요.")
		return false
	End If
	
	If Len(cont0.edtAltnAcnt.caption) <> 10 Then
		Form.ShowAlert( "알림", "입고계좌가 잘못 입력되었습니다.\n다시 확인해주세요.")
		return false
	End If
	
	
	If cont0.lblAltnAcntName.caption == null or cont0.lblAltnAcntName.caption == "" Then
		Form.ShowAlert( "알림", "입고계좌가 확인되지 않았습니다.\n다시 확인해주세요.")
		return false
	End If
	
	'양도여부 체크
	If cont0.rdoTrnfYN.currentindex <> "0" and cont0.rdoTrnfYN.currentindex <> "1" Then
		Form.ShowAlert( "알림", "양도여부를 체크해주세요.")
		return false		
	End If
	
	'동일인 대체시 양도 여부 체크
	If g_szSapeYN == "Y" THen
		If cont0.rdoTrnfYN.currentindex == "0" Then
			Form.ShowAlert( "알림", "동일명의 대체시 양도여부 '아니오'를 선택하여 처리하세요.")
			return false
		End If
		
	'타인 대체시 양도 여부 체크
	Else
		If cont0.rdoTrnfYN.currentindex == "1" Then
			If cont0.chkTrnfYN.checkstate == "0" Then
				Form.ShowAlert( "알림", "양도외거래 확인사항을 체크 바랍니다.")
				return false
			End If
		End If
	End If 
	
	return true
End Function	

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	f_InitCtrl()
	g_OSType	= Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
	
	'2022.04.20 IOS 에디트 이미지 이슈 > 영향 최소화로 IOS일 경우에만 적용
	If g_OSType == "2" Then
		cont0.edtAltnAcnt.SetOnOffImage("input_01_o.9.png","input_01_n.9.png")	'select/normal 이미지 설정
		cont0.edtAltnAcnt.imagefilepth = "input_01_n.9.png"						'최초 이미지 설정
	End If
End Sub

'============================================================================
' Form_OnPopupReturn() : 팝업리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'--- 잔고팝업 ---
	If sKeyName == "mbbnk61100_p1" Then
		If Trim(sRet) <> "" and Trim(sRet) <> null Then
			'리스트 초기화
			cont0.grdList.SetClear()

			'리스트 셋팅
			Dim tItem, tData, nRow
			tItem = Split(sRet, "♥")
			If #tItem > 0 Then
				cont0.lblGrdInfo.visible = false
				For i = 0 to #tItem - 1 
					If Trim(tItem[i]) <> "" Then
						cont0.grdList.AddRow()
						
						tData = Split(tItem[i], "★")
						
						nRow = tonumber(cont0.grdList.rowcount - 1)
						cont0.grdList.SetCellData( "bd_Iscd" 	    , nRow, tData[0]  )
						cont0.grdList.SetCellData( "bd_IscdNm"    , nRow, tData[1]  )
						cont0.grdList.SetCellData( "bd_AbleQty"   , nRow, tData[2]  )
						cont0.grdList.SetCellData( "bd_TaxType"   , nRow, tData[3]  )
						cont0.grdList.SetCellData( "bd_TaxCode"   , nRow, tData[4]  )
						cont0.grdList.SetCellData( "bd_IssuTpCd"   , nRow, tData[5]  )
						cont0.grdList.SetCellData( "bd_ByovErt"   , nRow, tData[6]  )
						cont0.grdList.SetCellData( "bd_TaxPaymCd" , nRow, tData[7]  )
						cont0.grdList.SetCellData( "bd_013r_SptxYN" 	, nRow, tData[8]  )
						cont0.grdList.SetCellData( "bd_013r_RmndQty" 	, nRow, tData[9]  )
						cont0.grdList.SetCellData( "bd_BuyAbleQty" 	, nRow, tData[10] )
						cont0.grdList.SetCellData( "bd_BuyGuYN" 		, nRow, tData[11] )
						cont0.grdList.SetCellData( "bd_BuyDate"   , nRow, tData[12] )
						
						cont0.grdList.SetCellImage("bd_ShowQty", nRow ,"input_01_n.9.png")
						cont0.grdList.SetCellData("bd_ShowQty", nRow, "수량입력"		)	'220517 추가
						cont0.grdList.SetCellFgColor("bd_ShowQty", nRow, "98" )			'220517 추가
						cont0.grdList.SetCellData("bd_Qty", nRow, 0 )						'220517 추가
					End If
				Next
				
				DATAMANAGER.RequestTranData( "obrtp_comn_041r" ) '20220519 계좌 정상 체크
				f_ChangeBtnState() '2022.05.09
			End If
		End If

	'--- 수량 입력 팝업 처리  ---
	ElseIf sKeyName == "QTY_POPUP" Then	'수량
		Dim nAbleQty, sz013r_SptxYN, n013r_RmndQty
		nAbleQty 		= tonumber(cont0.grdList.GetCellData( "bd_AbleQty", g_nChoiceRow))	'출고가능수량
		sz013r_SptxYN  	= cont0.grdList.GetCellData( "bd_013r_SptxYN", g_nChoiceRow)				'분리과세여부
		n013r_RmndQty 	= tonumber(cont0.grdList.GetCellData( "bd_013r_RmndQty", g_nChoiceRow))		'분리과세잔고수량

		'출고가능수량체크
		If nAbleQty == "" or nAbleQty == null or nAbleQty == 0 Then
			Form.ShowAlert("알림", "출고 가능수량을 확인해주세요.")
			Exit Sub
		End If
		
		'출고가능수량 이상 입력 체크
		If CInt(sRet) > nAbleQty Then
			Form.ShowAlert( "알림", "출고가능수량을 초과했습니다.\n다시 입력해주세요.")
			cont0.grdList.SetCellData( "bd_ShowQty", g_nChoiceRow, FormatNumber( nAbleQty , 0 ) )
			cont0.grdList.SetCellFgColor("bd_ShowQty", g_nChoiceRow, "4" )		'220517 추가
			cont0.grdList.SetCellData("bd_Qty", g_nChoiceRow, nAbleQty )	'220517 추가
			f_ChangeBtnState() '2022.05.09
			Exit Sub
		End If
		
		'분리과세 잔고수량 체크
		If sz013r_SptxYN == "Y" Then
			if CInt(sRet) > n013r_RmndQty then
				Form.ShowAlert("알림", "출고대상수량에 분리과세신청 잔고가 존재합니다.\n해지 후 처리하시기 바랍니다")
				cont0.grdList.SetCellData("bd_ShowQty", g_nChoiceRow, "수량입력"		)	'220517 추가
				cont0.grdList.SetCellFgColor("bd_ShowQty", g_nChoiceRow, "98" )			'220517 추가
				cont0.grdList.SetCellData("bd_Qty", g_nChoiceRow, 0 )	'220517 추가
				f_ChangeBtnState() '2022.05.09
				Exit Sub
			end if
		End If

		'수량 SET
		If CInt(sRet) == 0 Then
			cont0.grdList.SetCellData("bd_ShowQty", g_nChoiceRow, "수량입력"		)	'220517 추가
			cont0.grdList.SetCellFgColor("bd_ShowQty", g_nChoiceRow, "98" )			'220517 추가
			cont0.grdList.SetCellData("bd_Qty", g_nChoiceRow, 0 )	'220517 추가
			f_ChangeBtnState() '2022.05.09
			Exit Sub
		End If
		
		cont0.grdList.SetCellData( "bd_ShowQty", g_nChoiceRow, FormatNumber( sRet , 0 ))
		cont0.grdList.SetCellFgColor("bd_ShowQty", g_nChoiceRow, "4" )			'220517 추가
		cont0.grdList.SetCellData("bd_Qty", g_nChoiceRow, sRet )				'220517 추가
		f_ChangeBtnState() '2022.05.09
		
	'--- 보안매체 + 전자서명 인증 팝업  ---
	ElseIf sKeyName == "mbbnk61100_p4" Then
		If Trim(sRet) == "ok" Then
			'처리중엔 컨트롤 작동 막기
			btnProcess.enable		= false '출고처리버튼
			cont0.edtAltnAcnt.enable 	= false '입고계좌 에디트
'			cont0.btnCheckAcnt.enable 	= false '입고계좌 확인 버튼
			cont0.rdoTrnfYN.enable 	= false '양도여부 라디오
			cont0.chkTrnfYN.enable		= false '양도외거래 확인사항 체크
			cont0.lblTrnfYNChk.enable 	= false '양도외거래 확인사항 체크
		
			Form.Toast(0, "출고처리가 진행 중입니다.", false)
			DATAMANAGER.RequestTranData( "obrts_tkwr_005a" )	'출고처리
		End If
		
	'--- 대체출고 결과 팝업 ---
	ElseIf sKeyName == "mbbnk61100_p5" Then
		If Trim(sRet) == "move" Then
			Form.OpenScreen( "61120" , "3")
		Else
			f_InitCtrl()
		End If
	End If 
End Sub

'============================================================================
' acnt0_ChangeAccount() : 계좌변경
'============================================================================
Sub acnt0_ChangeAccount()
	f_InitCtrl()
	edtPswd.caption = ""
End Sub

'============================================================================
' cont0_btnAddPopup_OnClick() : 잔고조회/추가
'============================================================================
Sub cont0_btnAddPopup_OnClick()	
	If acnt0.caption <> "" and acnt0.caption <> null Then
		Dim szAcno, szAsno, szPwd
		szAcno = acnt0.total
		szAsno = acnt0.sequence	
		
		If szAcno <> null and szAcno <> "" and szAsno <> null and szAsno <> "" Then
			Form.OpenFramePopup( "mbbnk61100_p1" , szAcno.."★"..szAsno.."★".."3" , "")
		End If		
	End If
End Sub

