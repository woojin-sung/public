End Function

'============================================================================
Function CheckData()
    If Trim(contMain.edtName.caption) == "" Or Trim(contMain.edtName.caption) == null Then
        '(순서주의) 포커스후->Alert처리해야함
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtName.top, "1"))
        Form.ShowAlert("오류", "이름을 입력해주시기 바랍니다.")
        return False
    Else
        '이름 공백 체크
        sStr = Len(contMain.edtName.Caption)
        sRplStr = Len(replace(contMain.edtName.caption, " " , ""))
        If sStr <> sRplStr Then
            contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtName.top, "1"))
            Form.ShowAlert("오류", "이름을 입력해주시기 바랍니다.(공백 불가)")
            return False
        End If
    End If

    If Trim(contMain.edtRcno.caption) == "" Or Trim(contMain.edtRcno.caption) == null Then
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        Form.ShowAlert("오류", "주민번호를 입력해주시기 바랍니다.")
        return False
    Else
        nLen = contMain.edtRcno.pwdlen
        If CInt(nLen) < 13 Then
            contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
            Form.ShowAlert("오류", "주민번호를 확인해주세요.(13자리)")
            return False
        End If
    End If

    If Trim(contMain.cmbMcco.caption) == "" Or Trim(contMain.cmbMcco.caption) == null Then
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
        Form.ShowAlert("오류", "통신사를 확인해주세요.")
        return False    
    End If
    '비대면계좌개설_알뜰폰은 테스트서버 && 테스트SKip일때만 허용
    'V0005 : 알뜰폰 제한 처리 제거.
'    If g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1 Then  '계좌개설
'        '통신사확인 0.SKT 1.KT 2.LGU+ 3.SK알뜰 4.KT알뜰 5.LG알뜰
'        nIdx = contMain.cmbMcco.currentindex
'        '개발서버인 경우, 
'        If (g_nDev == "1" Or g_nDev == 1) Then
'            '테스트Skip아닌 경우에는 알뜰폰 선택 불가
'            If CInt(chkSkip.checkstate) == 0 Then
'                If (nIdx == "3" Or nIdx == 3) Or (nIdx == "4" Or nIdx == 4) Or (nIdx == "5" Or nIdx == 5) Then
'                    contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
'                    Form.ShowAlert("오류", "알뜰폰을 이용한 휴대폰인증으로는 비대면계좌개설이 불가합니다. 고객님의 안전한 금융거래를 위해 영업점에 내점하시어 개설을 부탁드립니다.")
'                    return False
'                End If
'            End If
'        '운영서버_알뜰폰 불가
'        Else
'            If (nIdx == "3" Or nIdx == 3) Or (nIdx == "4" Or nIdx == 4) Or (nIdx == "5" Or nIdx == 5) Then
'                contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
'                Form.ShowAlert("오류", "알뜰폰을 이용한 휴대폰인증으로는 비대면계좌개설이 불가합니다. 고객님의 안전한 금융거래를 위해 영업점에 내점하시어 개설을 부탁드립니다.")
'                return False
'            End If
'        End If
'    End If
'
    If Trim(contMain.edtHPNo.caption) == "" Or Trim(contMain.edtHPNo.caption) == null Then
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
        Form.ShowAlert("오류", "휴대폰번호를 입력해주시기 바랍니다.")
        return False
    ElseIf Mid(contMain.edtHPNo.caption,1,2) <> "01" Then 
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
        Form.ShowAlert("오류", "휴대폰번호를 확인해주시기 바랍니다.")
        return False
    Else
        If Len(contMain.edtHPNo.Caption) < 10 Or Len(contMain.edtHPNo.Caption) > 11 Then
            contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
            Form.ShowAlert("오류", "휴대폰번호를 확인해주시기 바랍니다.")
            return False
        End If
    End If

    If CInt(contMain.chkCtcnAgrm.checkstate) < 1 Then  '0.uncheck 1.check
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.btnCtcnAgrm.top, "1"))
        Form.ShowAlert("안내", "휴대폰 본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다.")
        return False
    End If
    
    return True
end Function 
'============================================================================
Function User_Stop_Timer()

    'sTimerID = 0 : 인증번호 요청
    'sTimerID = 1 : 인증확인 요청/요청검증
    'sTimerID = 2 : 인증유효시간
    'sTimerID = 3 : 단기다수계좌여부/대포통장명의인여부 확인
    'sTimerID = 4 : 사기계좌명의인여부 확인
    'sTimerID = 5 : 통신사콤보 자동펼치기
    
    Form.SetTimerEvent(0, 0, 1)
    Form.SetTimerEvent(1, 0, 1)
    Form.SetTimerEvent(2, 0, 1)
    Form.SetTimerEvent(3, 0, 1)
    Form.SetTimerEvent(4, 0, 1)
    Form.SetTimerEvent(5, 0, 1)
End Function 


