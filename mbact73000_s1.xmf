Function User_SharedData_Set(gb)
    '진입점에서 설정되는 정보 ---------------------------------------
'    Form.SetSharedData("BDM_FRST_MAPID"  , g_BDM_FRST_MAPID    )  '최초진입화면ID
'    Form.SetSharedData("BDM_NMETBSWRGB"  , g_BDMNMETBSWRGB     )  '비대면업무구분
'    Form.SetSharedData("mOTP_IntoClcd"   , g_mOTP_IntoClcd     )  '(모바일OTP)진입구분코드
'    Form.SetSharedData("BDM_CSNO"        , g_BDM_CSNO          )  '고객번호
'    Form.SetSharedData("BDM_CONNECTING"  , g_BDM_CONNECTING    )  '(계좌개설/업무신청)안내화면에서 넘어오는 진행상태구분

    If gb == "Init" Then

        '휴대폰본인인증에서 설정되는 정보 ------------------------------------------
'        Form.SetSharedData("BDM_REG_UNIQ_NO"         , "" )  '등록고유번호
'        Form.SetSharedData("BDM_REG_STAG_CLS_CODE"   , "" )  '등록단계구분코드
        Form.SetSharedData("BDM_NAME"                , "" )  '이름
        Form.SetSharedData("BDM_RCNO_PIP"            , "" )  '주민등록번호
        Form.SetSharedData("BDM_COMPANY_CODE"        , "" )  '통신사 정보
        Form.SetSharedData("BDM_HP1"                 , "" )  '휴대폰번호
        Form.SetSharedData("BDM_HP2"                 , "" )
        Form.SetSharedData("BDM_HP3"                 , "" )

        '신분증진위확인에서 설정되는 정보 ------------------------------------------
'        Form.SetSharedData("BDM_IDNTF_SRNO"          , "" )  '신분증일련번호
'        Form.SetSharedData("&RET_NAME"               , "" )  '이름

        '이어하기안내용, 진행상태보기용 Data ---------------------------------------
'        Form.SetSharedData("BDM_EXSN_CUST_YN"        , "" )  'Y.기존고객 N.신규고객
'        Form.SetSharedData("BDM_ISA_ACNT_YN"         , "" )  'ISA계좌보유여부
'        Form.SetSharedData("BDM_DREM_YN"             , "" )  'Y.임직원 N.고객
'        Form.SetSharedData("BDM_LAST_BSWR_GB"        , "" )  '최근처리업무구분
'        Form.SetSharedData("BDM_PRGS_YN"             , "" )  '(계좌개설)진행중데이터여부
'        Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"  , "" )  '최종등록단계구분코드
'        Form.SetSharedData("BDM_CLEAR_YN"            , "" )  '이어하기여부
'        Form.SetSharedData("BDM_PRNM"                , "" )  '개설상품명
'        Form.SetSharedData("BDM_BDM_APLTDATE"        , "" )  '신청일자
'        Form.SetSharedData("BDM_BDM_CLSNDATE"        , "" )  '신청마감일자
'        Form.SetSharedData("BDM_ACNT_OPNG_CLCD"      , "" )  '계좌개설구분
    Else
        '휴대폰본인인증에서 설정되는 정보 ---------------------------------------
'        Form.SetSharedData("BDM_REG_UNIQ_NO"         , g_BDM_REG_UNIQ_NO        )  '등록고유번호
'        Form.SetSharedData("BDM_REG_STAG_CLS_CODE"   , g_BDM_REG_STAG_CLS_CODE  )  '등록단계구분코드
        Form.SetSharedData("BDM_NAME"                , g_BDM_NAME               )  '이름
        Form.SetSharedData("BDM_RCNO_PIP"            , g_BDM_RCNO_PIP           )  '주민등록번호
        Form.SetSharedData("BDM_COMPANY_CODE"        , g_BDM_COMPANY_CODE       )  '통신사 정보
        Form.SetSharedData("BDM_HP1"                 , g_BDM_HP1                )  '휴대폰번호
        Form.SetSharedData("BDM_HP2"                 , g_BDM_HP2                )
        Form.SetSharedData("BDM_HP3"                 , g_BDM_HP3                )
        Form.SetSharedData("BDM_CIKEY_NO"            , g_CIKeyNo                )

        '신분증진위확인에서 설정되는 정보 ---------------------------------------
'        Form.SetSharedData("BDM_IDNTF_SRNO"          , g_BDM_IDNTF_SRNO         )  '신분증일련번호
'        Form.SetSharedData("&RET_NAME"               , g_BDM_NAME               )  '이어가기시 필요

        '이어하기안내용, 진행상태보기용 Data ---------------------------------------
'        Form.SetSharedData("BDM_EXSN_CUST_YN"        , g_BDM_EXSN_CUST_YN        )  'Y.기존고객 N.신규고객
'        Form.SetSharedData("BDM_ISA_ACNT_YN"         , g_BDM_ISA_ACNT_YN         )  'ISA계좌보유여부
'        Form.SetSharedData("BDM_DREM_YN"             , g_BDM_DREM_YN             )  'Y.임직원 N.고객
'        Form.SetSharedData("BDM_LAST_BSWR_GB"        , g_BDM_LAST_BSWR_GB        )  '최근처리업무구분
'        Form.SetSharedData("BDM_PRGS_YN"             , g_BDM_PRGS_YN             )  '(계좌개설)진행중데이터여부
'        Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"  , g_BDM_LAST_STAG_CLS_CODE  )  '최종등록단계구분코드
'        Form.SetSharedData("BDM_CLEAR_YN"            , g_BDM_CLEAR_YN            )  '이어하기여부
'        Form.SetSharedData("BDM_PRNM"                , g_BDM_PRNM                )  '개설상품명
'        Form.SetSharedData("BDM_APLTDATE"            , g_BDM_APLTDATE            )  '신청일자
'        Form.SetSharedData("BDM_CLSNDATE"            , g_BDM_CLSNDATE            )  '신청마감일자
'        Form.SetSharedData("BDM_ACNT_OPNG_CLCD"      , g_BDM_ACNT_OPNG_CLCD      )  '계좌개설구분

    End If
End Function
