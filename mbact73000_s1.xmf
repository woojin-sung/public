'    g_BDM_LAST_STAG_CLS_CODE  = Form.GetSharedData("BDM_LAST_STAG_CLS_CODE" , False)  '최종등록단계구분코드
'    g_BDM_CLEAR_YN            = Form.GetSharedData("BDM_CLEAR_YN"           , False)  '이어하기여부
