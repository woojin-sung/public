'============================================================================
' Form
'============================================================================
Sub Form_OnFormInit()
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
    '로그인여부
    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )

    '비로그인상태에서만 비대면화면 권한부여
'    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
'        Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
'    End If

    'OSType 1.안드로이드 2.IOS
'    g_sz_OSType = Form.GetSharedData("&OS_TYPE", False)
    'Form.ShowAlert("OS_VERSION", "["..g_sz_OSType.."](1.안드로이드 2.IOS)")

    '비대면업무의 공유변수 일괄 초기화
    User_SharedData_All_Init()

    '메뉴에서 진입하는 입하므로 화면번호로 체크 
'    g_SCR_NO = Form.GetSharedData( "&POPUP_SCREEN_NO" , False )
    'Form.ShowAlert("g_SCR_NO", g_SCR_NO)
    '계좌개설진행상태조회 : 85184
'    If g_SCR_NO == "85184" Or g_SCR_NO == 85184 Then
        '비대면업무코드=999.비대면진행상태조회 로 강제 설정
'        Form.SetSharedData("BDM_NMETBSWRGB" , "999")
'        g_BDMNMETBSWRGB = Form.GetSharedData("BDM_NMETBSWRGB", False)
    '업무신청진행상태조회 : 85183
'    ElseIf g_SCR_NO == "85183" Or g_SCR_NO == 85183 Then
        '비대면업무코드=999.비대면진행상태조회 로 강제 설정
'        Form.SetSharedData("BDM_NMETBSWRGB" , "999")
'        g_BDMNMETBSWRGB = Form.GetSharedData("BDM_NMETBSWRGB", False)
'    End If
    
    '호출업무 확인
    'g_BDMNMETBSWRGB = Form.GetSharedData("BDM_NMETBSWRGB", False)
    'g_sz_SubNmetBswrGb = Mid(g_BDMNMETBSWRGB, 1, 1)
    User_SharedData_Get()

    '비대면업무구분1자리 설정
'    g_sz_SubNmetBswrGb = Mid(g_BDMNMETBSWRGB,1,1)

    tmpMsg1 = "본인확인을 위해"
    tmpMsg2 = "휴대폰 인증을 진행합니다."
    contMain.lblSubTitle.caption = tmpMsg1.."\n"..tmpMsg2

    '재요청버튼 문구
    contMain.btnAthnRetry.caption = "재요청 >"
    contMain.btnAthnRetry.fgcolor = 267   '검은색

    '통신사정보-Default설정 없음
    'g_sz_HPCo = Form.GetSharedData("&PHONE_COMPANY_CODE", False )  '통신사 정보
    g_sz_HPNo = Form.GetSharedData("&PHONE_NUMBER"      , False ) '기기정보에서 읽어온 휴대폰번호(P로 시작하면 핸드폰번호, R로 시작하면 단말ID)
    'Form.ShowAlert("통신사정보", "["..g_sz_HPCo.."]["..g_sz_HPNo.."]")

    '테스트용 인증스킵 체크
    g_nDev = Form.GetSharedData("&SERVER_MODE", False )
    'Form.ShowAlert("SERVER_MODE(1.테스트)", nDev)
    If g_nDev == "1" Or g_nDev == 1 Then
		'금보원앱심사까지 Hidden
		'chkSkip.visible = False
		'chkSkip.checkstate = "0"
        chkSkip.visible = True
        chkSkip.checkstate = "0"   '자동체크 제외 "1"  '자동체크
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If

    '본인인증구분
'    g_sz_AthnGb = "1" '현재는 휴대폰본인인증만 함

    '서비스에 대한 토스메시지 제거
    DATAMANAGER.setNotifyDataMessage( "obcsb_oimf_639a"   , False )
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_653a"   , False )  '인증번호 요청
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_654a"   , False )  '인증확인 요청
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_654a_1" , False )  '인증확인 요청검증
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_655r"   , False )  '인증결과 검증
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_091r"   , False )  '단기다수계좌여부 조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_091r_1" , False )  '대포통장명의인여부 조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_091r_2" , False )  '사기계좌명의인여부 조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_096r"   , False )  '단기다수계좌여부/대포통장명의인여부/사기계좌명의인여부 확인
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_072r"   , False )  '비대면계좌개설 이어하기 조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_072r_1" , False )  '비대면업무진행상태조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_049c"   , False )  '비대면계좌개설 이어하기 등록_0단계
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_049c_1" , False )  '비대면계좌개설 이어하기 취소
    'DATAMANAGER.setNotifyDataMessage( "obcsb_nmet_102c"   , False )  '비대면본인인증및1원역이체관리

    '항목가이드 Default 설정 (267.검정색)
    contMain.edtName.SetApplyLabel   ("이름"         , 0, 267, "left", True)  'True.필수입력 / False.선택입력
    contMain.edtRcno.SetApplyLabel   ("주민등록번호" , 0, 267, "left", True)
    contMain.cmbMcco.SetApplyLabel   ("통신사"       , 0, 267, "left", True, 111) 'HWG
    contMain.edtHPNo.SetApplyLabel   ("휴대폰번호"   , 0, 267, "left", True)
    contMain.edtAthnNo.SetApplyLabel ("인증번호"     , 0, 267, "left", True)
    
    '헬퍼텍스트 설정
    contMain.edtName.SetUseResultLabel  (True, 1)  'True.사용가능 / False.사용불가, 라인수
    contMain.edtRcno.SetUseResultLabel  (True, 1)
    contMain.cmbMcco.SetUseResultLabel  (True, 1)
    contMain.edtHPNo.SetUseResultLabel  (True, 1)
    contMain.edtAthnNo.SetUseResultLabel(True, 2)
    
    '주민등록번호 자릿수 설정
    contMain.edtRcno.pwdlen = 13
    
    '신분증단계에서 넘어온경우, 기입력정보 재설정
    sRevData = Form.GetOpenLinkData()
    If sRevData == "StepBack" Then
        '컨트롤 모두보이기
        contMain.edtName.visible      = True   '이름
        contMain.edtRcno.visible      = True   '주민등록번호
        contMain.cmbMcco.visible      = True   '통신사
        contMain.edtHPNo.visible      = True   '휴대폰번호
        contMain.btnCtcnAgrm.visible  = True   '약관동의
        contMain.chkCtcnAgrm.visible  = True
        contMain.imgAthnShow.visible  = True
        contMain.lblCtcnShow.visible  = True
        contMain.edtAthnNo.visible    = True   '인증번호
        '안드로이드 인증유효시간이 표시가 되지 않아 true -> false 처리
        contMain.lblAthnTime.visible  = True  '인증유효시간 -> ReTry버튼클릭시,visible True
        contMain.lblAthnTime.bringFront("1")   '인증유효시간을 제일앞단으로 위치시킴
        'contMain.lblAthnTime.visible  = False
        contMain.btnAthnRetry.visible = True   '인증번호재요청
        contMain.btnAthnRetry.ebable  = True
        g_Frst_YN = "N" 

        '스크롤설정 체크용 변수 설정
        g_Cntt1 = "Y"
        g_Cntt2 = "Y"
        g_Cntt3 = "Y"
        g_Cntt4 = "Y"
        g_Cntt5 = "Y"
        g_Cntt6 = "Y"

        '스크롤 설정
        nContResize = 0
        nTop = 0
        nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + CInt(Form.calcUnResize(contMain.btnCtcnAgrm.top, "1"))
        nTop = CInt(Form.calcUnResize(contMain.edtAthnNo.top, "1"))
        contMain.lblScrollPos.top = nContResize
        contMain.SetScrollAutoSize()
        contMain.scroll_pos = nTop
        
        '신분증단계로 넘긴 입력정보 다시 설정
        '단, 화면이 넘어온 경우, 인증은 다시 받아야 함
        g_BDM_NAME          = Form.GetSharedData("BDM_NAME"         , False)  '이름
        g_BDM_RCNO_PIP      = Form.GetSharedData("BDM_RCNO_PIP"     , False)  '주민등록번호
        g_BDM_COMPANY_CODE  = Form.GetSharedData("BDM_COMPANY_CODE" , False)  '통신사 정보
        g_BDM_HP1           = Form.GetSharedData("BDM_HP1"          , False)  '휴대폰번호
        g_BDM_HP2           = Form.GetSharedData("BDM_HP2"          , False)
        g_BDM_HP3           = Form.GetSharedData("BDM_HP3"          , False)

        contMain.edtName.caption        = Trim(g_BDM_NAME)          '이름
        contMain.edtRcno.caption        = Trim(g_BDM_RCNO_PIP)      '주민등록번호
        contMain.cmbMcco.cbkeydata      = Trim(g_BDM_COMPANY_CODE)  '통신사
        contMain.edtHPNo.caption        = Trim(g_BDM_HP1)..Trim(g_BDM_HP2)..Trim(g_BDM_HP3)  '휴대폰번호
        contMain.chkCtcnAgrm.checkstate = "1" '약관동의
    End If
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
    
    '휴대폰 본인인증 약관동의 -----------------------------------------------
    If sKeyName == "mbbdm85110_p1"  Then
        If sRet == "ok" Then
            '약관동의 체크
            If contMain.chkCtcnAgrm.checkstate == "0" Or contMain.chkCtcnAgrm.checkstate == 0 Then  '0.uncheck 1.check
                contMain.chkCtcnAgrm.checkstate = "1"
                contMain_chkCtcnAgrm_OnChange("1")
            End If
        End If
    End If
End Sub

'============================================================================
' IOS-인증문자 자동 설정
Sub Form_OnTriggerEvent(sEventName, sParam)
    If sEventName == "event_HpCertNo" Then
        If sParam <>"" Then
            strData = Split(sParam,":")
            If len(strData[1]) == 8 Then
                strCertNo = Mid(strData[1],2,6)
                contMain.edtAthnNo.caption = strCertNo
            End If
        End If
    End If
End Sub

'============================================================================
' 본인인증용 타이머
Sub Form_OnTimerEvent(sTimerID)

    'sTimerID = 0 : 인증번호 요청
    'sTimerID = 1 : 인증확인 요청/요청검증
    'sTimerID = 2 : 인증유효시간
    'sTimerID = 3 : 단기다수계좌여부/대포통장명의인여부 확인
    'sTimerID = 4 : 사기계좌명의인여부 확인
    'sTimerID = 5 : 통신사콤보 자동펼치기

    '인증번호 요청 -------------------------------------------------------
    If  sTimerID == 0 Or sTimerID == "0" Then
        '인증요청 타이머종료
        Form.SetTimerEvent(0, 0, 1)

        '인증유효횟수 설정
        g_nCnt = CInt(g_nCnt) + 1

        '인증유효횟수 초과 체크
        If CInt(g_nCnt) > 10 Then
            contMain.edtAthnNo.SetResultLabel("1","error","본인인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.","contMain")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
            Exit Sub
        End If

        '인증확인 요청
        DATAMANAGER.RequestTranData "obcsb_oimf_654a"

    '인증확인 요청검증 -------------------------------------------------------
    ElseIf sTimerID == 1 Or sTimerID == "1" Then
        '검증요청 타이머종료
        Form.SetTimerEvent(1, 0, 1)

        '인증유효횟수 설정
        g_nCnt = CInt(g_nCnt)+1

        '인증유효횟수 초과 체크
        If CInt(g_nCnt) > 10 Then
            contMain.edtAthnNo.SetResultLabel("1","error","SMS 검증요청이 실패하였습니다. 잠시 후 다시 시도해 주십시오.","contMain")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
            Exit Sub
        End If

        '인증결과 검증
        DATAMANAGER.RequestTranData "obcsb_oimf_655r"

    '휴대폰본인인증 유효시간(3분) -------------------------------------------------------
    ElseIf sTimerID == 2 Or sTimerID == "2" Then
        If g_HPSec == 0 Then
            contMain.edtAthnNo.SetResultLabel("1","error","인증시간이 만료되었습니다. 다시 시도하여 주시기 바랍니다","contMain")

            '유효시간체크 종료
            Form.SetTimerEvent(2, 0, 1)

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
        Else
            Dim nMin, nSec
            nMin  = Int(CInt(g_HPSec) / 60 )
            nSec  = CInt(g_HPSec) Mod  60
            If Len(nSec) == 1 Then
                nSec = "0"..nSec
                nSec = nSec
            End If

            '#:##
            contMain.lblAthnTime.caption = nMin..":"..nSec
            g_HPSec = CInt(g_HPSec)-1
        End If

    'LES START
    '통신사콤보 포커싱 및 자동펼치기
    ElseIf sTimerID = "5" Or sTimerID = 5 Then
        Form.SetTimerEvent2(sTimerID, 0, 0.8)

'Form.ShowAlert("a", contMain.cmbMcco.caption)
        If CInt(contMain.cmbMcco.currentindex) < 1 And Trim(contMain.cmbMcco.caption) == "통신사를 선택해주세요" Then
            contMain.cmbMcco.openList()
        End If
    End If
End Sub



'============================================================================
' 입력항목 Show
' 이름 -> 주민등록번호 -> 통신사 -> 휴대폰번호 -> 약관 -> 인증번호 순으로 Show
'============================================================================
'============================================================================
Sub contMain_edtName_OnEditComplete() '이름
    g_Cntt1 = "Y"  '스크롤설정 체크용 변수 설정

    nTop = 0
    nContResize = 0

    If contMain.edtName.caption ~= "" Or contMain.edtName.caption ~= null Then
        If Len(replace(contMain.edtName.caption, " " , "")) == 0 Then
             contMain.edtName.SetResultLabel("1","error","이름을 입력해주시기 바랍니다.","contMain")
             Exit Sub
        Else
            '이름 공백 체크
            sStr = Len(contMain.edtName.Caption)
            sRplStr = Len(replace(contMain.edtName.caption, " " , ""))
            If sStr <> sRplStr Then
                contMain.edtName.SetResultLabel("1","error","이름을 확인해주시기 바랍니다.(공백 불가)","contMain")
                Exit Sub
             End If
        End If

       contMain.edtName.SetResultLabel("0","complete","","contMain")

        '스크롤 설정
        '아래컨트롤이 오픈된 후에는 스크롤증가 없음
        'If contMain.edtRcno.visible == True Then
        If g_Cntt2 == "Y" Then
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1"))
        Else
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + 120 'HWG 'CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        End If
        'LES nTop = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        nTop = CInt(Form.calcUnResize(contMain.edtName.top, "1"))

        '항목을 위로 올리면서 스크롤을 늘리기 위해 컨테이너상의 마지막 컴포턴트 위치를 아래로 강제 처리함
        contMain.lblScrollPos.top = nContResize
        '스크롤사이즈 자동조정
        contMain.SetScrollAutoSize()
        '현재 스크롤위치 설정
        contMain.scroll_pos = nTop

        '주민등록번호 Show
        g_Cntt2 = "Y"  '스크롤설정 체크용 변수 설정
        contMain.edtRcno.visible = True

        '주민등록번호 입력키보드 자동보이기
        If contMain.edtRcno.caption == "" Or contMain.edtRcno.caption == null Then
            '일반키패드(단말지원)->보안키패드(내부) 자동오픈에 따른 오류방지
            '일반키패드에서 입력완료가 아닌 키패드외부 선택에 따라 키패드가 닫힌상태에서 뒤로가기(업무종료시키는 경우)시
            '입력완료로 판단되어 화면은 안내페이지로 돌아가지만 보안키패드가 올라왔다가 앱이 죽는 현상 발생
            If g_Back_Flag <> "Y" Then
                contMain.edtRcno.SetShowKeypad(True)
            End If
        End If
    End If
End Sub
