'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry(g_nAcNo, g_nAsNo)
'============================================================================
'Function TR_Inquiry(g_nAcNo, g_nAsNo)
'	DATAMANAGER.SetDataValue(0, "obtrc_rmnd_001r", "InBlock1", "ACNO", 0 , g_nAcNo)
'	DATAMANAGER.SetDataValue(0, "obtrc_rmnd_001r", "InBlock1", "ASNO", 0 , g_nAsNo)
'	DATAMANAGER.SetDataValue(0, "obtrc_rmnd_001r", "InBlock1", "STND_DATE", 0 , Form.GetSharedData("&HOST_DATE", false ))
'	DATAMANAGER.SetDataValue(0, "obtrc_rmnd_001r", "InBlock1", "IQRY_CLS_CODE", 0 , "1")
'	
'	DATAMANAGER.SetDataValue(0, "obtrc_marg_006r", "InBlock1", "ACNO", 0 , g_nAcNo)
'	DATAMANAGER.SetDataValue(0, "obtrc_marg_006r", "InBlock1", "ASNO", 0 , g_nAsNo)
'	
'	DATAMANAGER.RequestTranData("obtrc_rmnd_001r")
'	DATAMANAGER.RequestTranData("obtrc_marg_006r")
'End Function

'============================================================================
'Output_Data_Clear() : 출력 Data 초기화
'============================================================================
Function Output_Data_Clear()
	'v0001 테이블 추가
	contBody.tbl0.SetCellString(2, 0, "")
	contBody.tbl0.SetCellString(2, 1, "")
	contBody.tbl0.SetCellString(2, 2, "")
	contBody.tbl0.SetCellString(4, 0, "")
	contBody.tbl0.SetCellString(4, 1, "")
	contBody.tbl0.SetCellString(4, 2, "")
	contBody.tbl0.SetCellString(6, 0, "")
	contBody.tbl0.SetCellString(6, 1, "")
	contBody.tbl0.SetCellString(6, 2, "")
	contBody.tbl0.SetCellString(8, 0, "")
	contBody.tbl0.SetCellString(8, 1, "")
	contBody.tbl0.SetCellString(8, 2, "")

	contBody.tbl1.SetCellString(2, 0, "")
	contBody.tbl1.SetCellString(2, 1, "")
	contBody.tbl1.SetCellString(2, 2, "")
	
	contBody.tbl2.SetCellString(2, 0, "")
	contBody.tbl2.SetCellString(2, 1, "")
	contBody.tbl2.SetCellString(2, 2, "")
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Call Output_Data_Clear()
	DATAMANAGER.RequestTranData("obtrc_rmnd_003r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'v0001 obtrc_rmnd_001r > obtrc_rmnd_003r 으로 변경
	'TR_Inquiry > DATAMANAGER_OnSendTranBefore로 변경
	g_nAcNo = Form.GetCtlProp("#acnt0", "total")
	g_nAsNo = Form.GetCtlProp("#acnt0", "sequence")
	
	If szTranID == "obtrc_rmnd_003r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0 , g_nAsNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE", 0 , Form.GetSharedData("&HOST_DATE", false ))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , "2")
	
	ElseIf szTranID == "obtrc_marg_006r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0 , g_nAsNo)
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrc_rmnd_003r" then
		'위험도 계산
		Dim nAcntRate, nRiskRate, nData, nReturnValue '계좌증거금율, 위험도, 반환값
		nData = tonumber(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "ACNT_MGRT", 0 ))
		
		if nData == 0 or nData == "" then
			nReturnValue = 0
		else
			nAcntRate = CDbl(CInt(nData * 100)/100) '소수 둘째자리까지 재가공
			nRiskRate = (100-nAcntRate) '(1-계좌증거금율) * 100

			if nRiskRate < 0 then
				nReturnValue = 0
			elseif nRiskRate >= 100 then
				nReturnValue = 100
			else
				nReturnValue = nRiskRate
			end if
		end if
		
		contBody.Label0.caption = CDbl(nReturnValue)
		
		if nReturnValue > 40 then
			contBody.Label0.fgcolor = "10"
		else
			contBody.Label0.fgcolor = "4"
		end if
		
		DATAMANAGER.RequestTranData("obtrc_marg_006r") 'v0001 obtrc_rmnd_003r > obtrc_marg_006r 순서
	
	'v0001
	ElseIf szTranID == "obtrc_marg_006r" then
		'마진콜여유금액 
		Dim nAcntVltnAmt, nMntnMarg, nAmt '계좌평가금액, 유지증거금
		nAcntVltnAmt = tonumber(contBody.tbl0.GetCellString(2, 0))
		nMntnMarg = tonumber(contBody.tbl2.GetCellString(2, 0))
		
		nAmt = nAcntVltnAmt - nMntnMarg	'마진콜여유금액
		' 마진콜 여유금액 (-)금액 표시, T2206300016, CFD증거금 화면개선
		'If nAmt < 0 Then
		'	nAmt = 0
		'End If
		contBody.tbl2.SetCellString(2, 1, nAmt)
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "RECEIVE" Then
		Call Output_Data_Clear()
		DATAMANAGER.RequestTranData("obtrc_rmnd_003r")
		
	ElseIf sEventName == "CHANGE_ACCTNO" Then
		Call Output_Data_Clear()
		DATAMANAGER.RequestTranData("obtrc_rmnd_003r")
		
	End If
	
End Sub

'============================================================================
Sub contBody_btnCaution_OnClick()
	Form.OpenFramePopup("mbtrc11000_p1" , "" , "")
End Sub




