'============================================================================
' 작성 : 2021.08.04 ksj
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'전역변수 설정
Dim g_szPlain_rm	'메모리 평문적용 여부
Dim g_tItemCodeInfo 	'종목정보 배열
Dim g_szItemCode		'종목코드
Dim g_szItemSym		'종목거래소심볼
Dim g_szNationCode	'종목국가코드
Dim g_szRet		'전달값

'============================================================================
' f_GetNationCode(szSym) : 거래소별 벤더 값 반환
'============================================================================
Function f_GetExCode(szSym)
	Dim szReturnValue
	szReturnValue = ""
	if szSym == "NY" then '뉴욕
		szReturnValue = "0321"
	elseif szSym == "OQ" then '나스닥
		szReturnValue = "0537"
	elseif szSym == "AX" then '아멕스
		szReturnValue = "0066"
	elseif szSym == "SH" then '상해
		szReturnValue = "0215"
	elseif szSym == "SZ" then '심천
		szReturnValue = "0214"
	elseif szSym == "HK" then '홍콩
		szReturnValue = "0104"
	elseif szSym == "JP" then '일본
		szReturnValue = "0106"
	end if	
	
	return szReturnValue
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_tItemCodeInfo = {}
	g_szItemCode = ""
	g_szItemSym = ""
	
	g_szRet = "no"
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	g_szItemCode = ""
	ContainerBody.ItemCode0.code = "empty"
	
	DATAMANAGER.RequestTranData( "obtre_brng_109r" )
End Sub
'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "MBTRE21000_P1" , g_szRet)
End Sub
'============================================================================
' Form_OnCommonDialogReturn()
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		g_tItemCodeInfo = split(sReturn1, "@")
		g_szItemCode = g_tItemCodeInfo(1)
		g_szItemSym = g_tItemCodeInfo(0)
		
		DATAMANAGER.RequestTranData( "obtre_brng_109r" )
	end if
End Sub
'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub ContainerBody_grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_brng_109r") == True Then
		DATAMANAGER.RequestNextData("obtre_brng_109r")
	End If
End Sub
'============================================================================
' grd0_OnClickUp() : 대상 선택
'============================================================================
Sub ContainerBody_grd0_OnClickUp(lRow, szCellID)
	Dim szISCD, nAbleQty
	szISCD = ContainerBody.grd0.GetCellData( "bd_cell0", lRow )
	nAbleQty = ContainerBody.grd0.GetCellData( "bd_cell3", lRow )
	
	If szISCD ~= null and szISCD ~= "" and nAbleQty ~= null and nAbleQty ~= "" Then
		Form.SetSharedData("mbtre21000_p1_ISCD" , szISCD)
		Form.SetSharedData("mbtre21000_p1_ABLE_QTY" , nAbleQty)
		g_szRet = "ok"
	End If
	
	Form.CloseForm()
End Sub
'============================================================================
' ImgClose_OnClick() : 닫기
'============================================================================
Sub ContainerBody_ImgClose_OnClick()
	Form.CloseForm()
End Sub
'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)  
	Dim szACNT_PWD, szACNO, szASNO
	szACNO = Form.GetSharedData("mbtre21000_ACNO" , false)
	szASNO = Form.GetSharedData("mbtre21000_ASNO" , false)
	
	szACNT_PWD = Form.GetSharedData("mbtre21000_ACNT_PWD" , false)
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = szACNT_PWD
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(szACNT_PWD)
	end if	
	
	If szTranID == "obtre_brng_109r" Then
		Dim szISCD, szExCode
		szISCD = ""
		szExCode = ""
		
		if g_szItemCode <> "" then
			szISCD = g_szItemCode
		end if 
		
		if g_szItemSym <> "" then
			szExCode = f_GetExCode(g_szItemSym)
		end if
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , szACNO)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , szASNO)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , szACNT_PWD)							'비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OVRS_STCK_SYMB_ISCD" , 0 , szISCD)	'종목코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OVRS_EXCH_VNDR_IDNO" , 0 , szExCode)	'거래소코드
	End If
End Sub






