'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문의 처리결과 조회 화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szTitle
g_szTitle = "알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
'	계좌번호/비밀번호 확인
'	내역조회는 비밀번호 없이 조회가능하도록 수정함. 	20160502 LKM 
'	주문올릴때만 비밀번호 확인하도록 로직 수정
'============================================================================
Function Check_Accout()

'20160502 LKM START

	Dim szAcctNo
	
	szAcctNo = Form.GetCtlProp("#acnt", "caption")
    
    If Len(Trim(szAcctNo)) < 10 Then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If

	Check_Accout = True

' ORG
'	Dim szAcctNo, szAcpw
'	
'	szAcctNo = Form.GetCtlProp("#acnt", "caption")
'	szAcpw	= Form.GetCtlProp("#edtPwd", "caption")
'    
'    If Len(Trim(szAcctNo)) < 10 Then
'	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
'	    Check_Accout = False
'	    Exit Function
'	End If
'	
'	If szAcpw = "" Then
'	    Form.ShowAlert( g_szTitle, "비밀번호를 확인후 다시 입력하십시오." )
'	    Check_Accout = False
'	    Exit Function
'	End If
'
'	Check_Accout = True
'20160502 LKM END

	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData( "obtrs_oder_507r" )
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	If sEventName = "CHANGE_PASS" Then
		btnSearch_OnClick()
	'20160502 LKM START
	elseif sEventName = "CHANGE_ACCT" Then
		
		grd0.rowcount = 0	'기존내역 Clear
			
		If Check_Accout() = False Then
			Exit Sub
		End If
		
		btnSearch_OnClick()
	'20160502 LKM END
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID = "obtrs_oder_503a" Then
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ACNO"			, 0 , Form.GetCtlProp("#acnt", "total") 	)	' 계좌1
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ASNO"			, 0 , Form.GetCtlProp("#acnt", "sequence") 	)	' 계좌2
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ACNT_PWD"		, 0 , Form.GetCtlProp("#edtPwd", "encdata") 	)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "DEAL_CLS_CODE"	, 0 , "0" 		)	' 매매구분코드 1매도,2매수,%전체
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ISCD"			, 0 , "" 		)	' 종목코드
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "DATA_CLS"		, 0 , "1" 		)	' 데이터구분 1전체,2미전송건
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "IQRY_CSNU"		, 0 , 20 		)	' 조회건수
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "IQRY_CLS_CODE"	, 0 , "2" 		)	' 조회구분코드 1취소가능, 2전체
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtrs_oder_503a" Then
		
		For i = 0 To grd0.rowcount -1 
			Dim szISCD, szODER_CLS_CODE, szADOD_TYPE_CODE, szCNCL_CLS_CODE
			
			szISCD			= grd0.GetCellData( "bd_cell7" , i)
			szODER_CLS_CODE	= grd0.GetCellData( "bd_cell8" , i)
			szADOD_TYPE_CODE	= grd0.GetCellData( "bd_cell18", i)
			szCNCL_CLS_CODE	= grd0.GetCellData( "bd_cell17", i)
			
			'종목코드
			grd0.SetCellData( "bd_cell1", i, Mid(szISCD, 2, 6 ) )
			
			'구분
			Select Case szODER_CLS_CODE
				Case "01"	grd0.SetCellData( "bd_cell3", i, "보통" )
				Case "05"	grd0.SetCellData( "bd_cell3", i, "시장가")
				Case "06"	grd0.SetCellData( "bd_cell3", i, "조건부지정가")
				Case "09"	grd0.SetCellData( "bd_cell3", i, "자기주식")
				Case "10"	grd0.SetCellData( "bd_cell3", i, "S-OPTION 자기주식")
				Case "11"	grd0.SetCellData( "bd_cell3", i, "금전신탁자기주식")
				Case "12"	grd0.SetCellData( "bd_cell3", i, "최유리 지정가")
				Case "13"	grd0.SetCellData( "bd_cell3", i, "최우선 지정가")
				Case "20"	grd0.SetCellData( "bd_cell3", i, "코넥스 경매매")
				Case "51"	grd0.SetCellData( "bd_cell3", i, "장중 대량매매")
				Case "52"	grd0.SetCellData( "bd_cell3", i, "장중 바스켓 매매")
				Case "53"	grd0.SetCellData( "bd_cell3", i, "장중 경쟁 대량매매")
				Case "61"	grd0.SetCellData( "bd_cell3", i, "장개시전 시간외종가")
				Case "62"	grd0.SetCellData( "bd_cell3", i, "장개시전 시간외대량")
				Case "63"	grd0.SetCellData( "bd_cell3", i, "장개시전 시간외 바스켓")
				Case "64"	grd0.SetCellData( "bd_cell3", i, "장개시전 시간외 경쟁 대량매매")
				Case "67"	grd0.SetCellData( "bd_cell3", i, "장개시전 시간외대량 자사주 신탁")
				Case "69"	grd0.SetCellData( "bd_cell3", i, "장개시전 시간외대량 자사주")
				Case "71"	grd0.SetCellData( "bd_cell3", i, "시간외 종가")
				Case "72"	grd0.SetCellData( "bd_cell3", i, "시간외 종가 대량매매")
				Case "77"	grd0.SetCellData( "bd_cell3", i, "금전신탁자기주식 시간외 대량매매")
				Case "79"	grd0.SetCellData( "bd_cell3", i, "자기주식 시간외 대량매매")
				Case "80"	grd0.SetCellData( "bd_cell3", i, "시간외 바스켓")
				Case "81"	grd0.SetCellData( "bd_cell3", i, "시간외 단일가")
				Case "X1"	grd0.SetCellData( "bd_cell3", i, "ECN")
			End Select		
			
			'주문종류
			Select Case szADOD_TYPE_CODE
				Case "01"	grd0.SetCellData( "bd_cell13", i, "현금매도" )
							grd0.SetCellFgColor( "bd_cell13", i, "11" )
				Case "02"	grd0.SetCellData( "bd_cell13", i, "현금매수")
							grd0.SetCellFgColor( "bd_cell13", i, "10" )
				Case "03"	grd0.SetCellData( "bd_cell13", i, "신용매도")
							grd0.SetCellFgColor( "bd_cell13", i, "11" )
				Case "04"	grd0.SetCellData( "bd_cell13", i, "신용매수")
							grd0.SetCellFgColor( "bd_cell13", i, "10" )
				Case "05"	grd0.SetCellData( "bd_cell13", i, "대주매수")
							grd0.SetCellFgColor( "bd_cell13", i, "10" )
				Case "06"	grd0.SetCellData( "bd_cell13", i, "대주매도")
							grd0.SetCellFgColor( "bd_cell13", i, "11" )
				Case "11"	grd0.SetCellData( "bd_cell13", i, "예탁담보")
				Case "12"	grd0.SetCellData( "bd_cell13", i, "소액담보")
				Case "13"	grd0.SetCellData( "bd_cell13", i, "대용매도")
							grd0.SetCellFgColor( "bd_cell13", i, "11" )
			End Select
			
			'취소
			Select Case szCNCL_CLS_CODE
				Case "01"	grd0.SetCellData( "bd_cell5", i, "정상" )
				Case "02"	grd0.SetCellData( "bd_cell5", i, "취소")
			End Select
		
		Next

	ElseIf szTranID = "obtrs_oder_507r" Then
		cld0.caption = DATAMANAGER.GetDataValue( 0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE" , 0 )
		szAcpw	= Form.GetCtlProp("#edtPwd", "caption")
		If szAcpw <> "" Then
			btnSearch_OnClick()
		end if	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	
	If Check_Accout() = False Then
		Exit Sub
	End If
		
	DATAMANAGER.RequestTranData( "obtrs_oder_503a" )
	
End Sub


'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

