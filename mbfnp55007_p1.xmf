	<SCRIPT_INFO _len="6733" _ulen="6281" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 상품가입 의사표시 확정 처리
' 02. 화면설명 : 상품가입 의사표시 확정 처리
' 03. 작    성 : 2021.06.11 김유경
' 04. 수    정 : 2022.04.21 김유경 v001. T2108190021 관련 추가 개선 건 - 1단계/2단계 구분없이 가입의사,확정처리
'-------------------------------------------------------------------------------------------

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szList

Dim gApltDate
Dim gProdClsCode
Dim gChanTypeCode
Dim gPrnm
Dim gIntnDtrmDate
Dim gJoinStatCode
Dim gProdClsNm
Dim gIscd
Dim gCnrcNo
Dim gAcno
Dim gAsno
Dim szLinkedData
Dim gProsClsCode
Dim g_szPassWord
Dim gCloseFlag

Dim gApltNo
Dim gByovApltAmt
Dim gSrno
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	gCloseFlag = 0
	szLinkedData = Form.GetOpenLinkData( )

	'신청일자 상품구분명 신청채널 투자상품 의사표시기한 상태 상태구분코드 종목코드
	g_szList = Split(szLinkedData,"★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
		
	gApltDate     = ""
	gProdClsCode  = ""
	gChanTypeCode = ""
	gPrnm         = ""
	gIntnDtrmDate = ""
	gJoinStatCode = ""
	gProdClsNm    = ""
	gIscd         = ""
	gCnrcNo       = ""
	gAcno         = ""
	gAsno         = ""
	g_szPassWord  = ""
	
	gApltNo       = ""
	gByovApltAmt  = ""
	gSrno         = ""
	
	gApltDate     = g_szList(0)
	gProdClsNm    = g_szList(1)
	gChanTypeCode = g_szList(2)
	gPrnm         = g_szList(3)
	gIntnDtrmDate = g_szList(4)
	gJoinStatCode = g_szList(5)
	gProdClsCode  = g_szList(6)
	gIscd         = g_szList(7)
	gCnrcNo       = g_szList(8)
	gAcno         = g_szList(9)
	gAsno         = g_szList(10)
	g_szPassWord  = g_szList(11)

	gApltNo       = g_szList(12)
	gByovApltAmt  = g_szList(13)
	gSrno         = g_szList(14)   
	
	Edit0.caption = gApltDate    
	Edit1.caption = gProdClsNm 
	Edit2.caption = gChanTypeCode
	Edit3.caption = gPrnm        
	Edit4.caption = gIntnDtrmDate
	
	If Trim(gJoinStatCode) == "1" Then
		Edit5.caption = "신청중"
	ElseIf Trim(gJoinStatCode) == "2" Then
		Edit5.caption = "숙려중"
	ElseIf Trim(gJoinStatCode) == "3" Then
		Edit5.caption = "정상"
	ElseIf Trim(gJoinStatCode) == "4" Then
		Edit5.caption = "취소"
	ElseIf Trim(gJoinStatCode) == "5" Then
		Edit5.caption = "가입의사확인중"
	Else
	     Edit5.caption =  gJoinStatCode
	End If 
	
	Edit9.caption = gApltNo    
	Edit8.caption = gByovApltAmt 
	Edit6.caption = gAcno..gAsno    
	Edit7.caption = gIscd
	
End Sub
'

'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	gCloseFlag = 1
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	imgClose_OnClick()
End Sub


'============================================================================
' v001. T2108190021 관련 추가 개선 건 - 1단계/2단계 구분없이 가입의사,확정처리
'============================================================================
Sub ButtonOK_OnClick()
	If RadioGroup0.currentindex == "-1" or RadioGroup0.currentindex == -1 Then 
		Form.ShowAlert( "알림", "투자확정 여부를 확인해주세요.")
		Exit Sub
	End If 
	
	If RadioGroup0.currentindex == "0" or RadioGroup0.currentindex == 0 Then 
		Form.MsgBox("알림", "투자를 확정합니다.", "confirm", 1)
	Else
		Form.MsgBox("알림", "투자취소를 확정합니다.", "confirm", 1)
	End If 
End Sub 

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'v001. 기존 로직 제거
	If szTranID == "obcck_dsmg_607a" then
		gCloseFlag = 2 '처리완료
		Form.CloseForm()
	End If 
End Sub 		 

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obcck_dsmg_607a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcck_dsmg_607a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")	
	end if
End Sub 

'============================================================================
Sub Form_OnFormClose()
	If gCloseFlag == 2 Then 
		If RadioGroup0.currentindex == "0" or RadioGroup0.currentindex == 0 Then
			gProsClsCode = "3"
		ElseIf RadioGroup0.currentindex == "1" or RadioGroup0.currentindex == 1 Then
			gProsClsCode = "4"
		End If 
			
		Form.SendReturnToParent("의사표시완료", gProsClsCode )
	Else 
		Form.SendReturnToParent("의사표시취소", "")
	End If 
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "confirm" Then
        'sRet=no/ok
		If sRet == "ok" Then
			If RadioGroup0.currentindex == "0" or RadioGroup0.currentindex == 0 Then
				gProsClsCode = "3" 'v001. PROS_CLS_CODE 1, 2 단계 제거 1->3
			ElseIf RadioGroup0.currentindex == "1" or RadioGroup0.currentindex == 1 Then
				gProsClsCode = "4" 'v001. PROS_CLS_CODE 1, 2 단계 제거 2-> 4
			End If 
			
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "PROS_CLS_CODE"       , 0 , gProsClsCode)
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "APLT_DATE"           , 0 , gApltDate   )
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "CAFU_TRGT_BSWR_CLCD" , 0 , gProdClsCode) '숙려대상업무구분코드
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "ACNO"    			 , 0 , gAcno  	 )
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "ASNO"    			 , 0 , gAsno  	 )	
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "CNRC_NO" 			 , 0 , gCnrcNo	 )	
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "ISCD"    			 , 0 , gIscd  	 )	
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "ACNT_PWD"			 , 0 , g_szPassWord)	
			
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "APLT_SRNO"    		 , 0 , gApltNo     )	
			DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_607a", "InBlock1", "SRNO"         		 , 0 , gSrno       )
		
			DATAMANAGER.RequestTranData( "obcck_dsmg_607a" )
		End If

    End If
End Sub 
