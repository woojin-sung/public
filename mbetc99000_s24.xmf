'============================================================================
Sub Form_OnFormInit()

szData = Form.GetOpenLinkData()
szList = split(szData,"●")

Edit0.caption = szList(0) / 10000
Edit1.caption = 50
Edit2.caption = Cint(szList(1))


'Form.MsgBox("",szData, "", "")
	
End Sub

'============================================================================


'============================================================================
Sub Form_OnFormClose()


	
End Sub

'============================================================================
Sub btnok_OnClick()
Form.SendReturnToParent("mbetc99000_s24" , Cint(Edit0.caption)*10000&"●"&Edit1.caption&"●"&Edit2.caption)
	Form.CloseForm()
	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

