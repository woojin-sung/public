Dim g_tData
DIm g_szPwd

Dim g_szPhoneNum
Dim g_szPhoneInagTypeCode
Dim g_szPhoneInagSrno
Dim g_szEmail
Dim g_szEmailInagTypeCode
Dim g_szEmailInagSrno

Dim g_szFnprJoinSrno

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBack.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
	
	imgToolTip1.setMaintainingRatio("1")
	imgToolTip2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	btnSwitch.setApplySwitch("OFF", "ON", 261, 261, 127, 289)
	
	lblGuide2.fgcolor = "290"
	
	btnReg.enable = false
	
	'0 계좌번호
	'1 계좌일련번호
	'2 종목명
	'3 종목코드
	'4 투자기간일수
	'5 프리미엄명목이율
	'6 프리미엄이율
	'7 증거금이율
	'8 판매보수이율
	'9 투자수익이율
	'10 최소계약금액
	'11 증거금비율
	'12 설명서파일경로
	'13 설명서파일명
	'14 신청가능금액
	'15 재투자종료일
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("szOpenData", szOpenData)
		g_tData = Split(szOpenData, "★")
		
		acnt0.caption = g_tData[0] & g_tData[1]
		
		lblName.caption = g_tData[2]
		tblInfo.SetCellString(0, 1, g_tData[11])
		tblInfo.SetCellString(1, 1, g_tData[10])
		tblInfo.SetCellString(2, 1, g_tData[4])
		tblInfo.SetCellString(3, 1, CDbl(g_tData[9]))
		tblInfo.SetCellString(4, 1, CDbl(g_tData[6]))
		tblInfo.SetCellString(5, 1, CDbl(g_tData[7]))
		
		edtAmount.hintcaption = "최소 " & FormatNumber(g_tData[10], 0) & "원 이상"
		
		Dim szDate
		szDate = Form.GetSharedData("&HOST_DATE", false)
		If CInt(szDate) > CInt(g_tData[15]) Then
			btnSwitch.switchindex = 0
			btnSwitch.enable = false
		Else
			btnSwitch.switchindex = 1
			btnSwitch.enable = true
		End If
		
		'등록된 휴대폰번호, 이메일 조회
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'설명서 팝업 리턴
	If sKeyName == "mbonl88027_p1" Then
		If sRet == "ok" Then
			'계좌 비밀번호 입력 팝업
			Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
		End If
	
	'계좌 비밀번호 입력 리턴
	ElseIf sKeyName == "CORRECT_PWD" And sRet <> "" And sRet <> Null Then
'		Form.ShowAlert(sKeyName, sRet)
		Dim tData
		tData = Split(sRet, "★")
		If UBOUND(tData) > 0 Then
			g_szPwd = tData[0]
			
			'test
'			'금융상품가입일련번호 채번
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" )
			
			'인증절차 팝업
			Dim szCertUseType 
			'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
			szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
			
			If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
			    Form.OpenFramePopup( "mhetc90060_px" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
			Else
			    Form.OpenFramePopup( "mhetc90060_p5" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
			End If
		End If
	
	'공동인증 및 바이오인증 완료
	ElseIf sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" Then
			'금융상품가입일련번호 채번
			DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		End If
		
	'간편인증 완료
	ElseIf sKeyName == "mhetc90060_px" Then 
		If sRet == "ok" Then
			'금융상품가입일련번호 채번
			DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		End If
	
	'완료팝업 리턴
	ElseIf sKeyName == "mbonl88027_p2" And sRet <> "" And sRet <> null Then
		Form.SendReturnToParent("MOVE_TAB" , sRet)
		Form.CloseForm()
	
	'연락처변경 팝업 리턴
	ElseIf sKeyName == "mbonl81000" And sRet == "ok" Then
		'등록된 휴대폰번호, 이메일 조회
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_acif_140r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
	
	'CDS 매수 신청
	ElseIf szTranID == "obsat_cdss_001a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , acnt0.sequence )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ISCD" , 0 , g_tData[3] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_INVT_PRD_DYNU" , 0 , g_tData[4] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_PRMM_NOMN_INRT" , 0 , g_tData[5] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_PRMM_INRT" , 0 , g_tData[6] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_MARG_INRT" , 0 , g_tData[7] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_SALE_PAY_INRT" , 0 , g_tData[8] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_INVT_ERNN_INRT" , 0 , g_tData[9] )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "APLT_AMT" , 0 , edtAmount.caption )
		If CInt(btnSwitch.switchindex) == 1 Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_RNVS_YN" , 0 , "Y" )
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CDS_RNVS_YN" , 0 , "N" )
		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		
	'가입계약서류 제공방식 관리
	ElseIf szTranID == "obcsb_acad_122a" Then
		If CInt(rdoProvision.currentindex) == 0 Then
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , g_szPhoneInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , g_szPhoneInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , g_szPhoneNum)
			
		ElseIf CInt(rdoProvision.currentindex) == 1 Then
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , g_szEmailInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , g_szEmailInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , g_szEmail)
		End If 
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_acif_140r" Then
		Dim nCnt, nCnt1
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'이메일 주소
			nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to nCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    If strInagTypeCode2 = "21" Then
					g_szEmail = strAddr
					g_szEmailInagTypeCode = strInagTypeCode2
					g_szEmailInagSrno = strInagSrno2
			    End If
			Next 	
			'휴대폰 번호
			nCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to nCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)
			    If strInagTypeCode3 = "13" Then
				    g_szPhoneNum = strCustTelno
				    g_szPhoneInagTypeCode = strInagTypeCode3
				    g_szPhoneInagSrno = strInagSrno3
			    End If
			Next
		End If 
		
		'재조회 시 표시영역에 바뀐 정보 보여줌
		If CInt(rdoProvision.currentindex) == 0 Then
			tblProvision.SetCellString(0, 0, g_szPhoneNum)
			lblProNotice.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
		ElseIf CInt(rdoProvision.currentindex) == 1 Then
			tblProvision.SetCellString(0, 0, g_szEmail)
			lblProNotice.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
		End If
		
		f_RegBtnEnable()
	
	'금융상품가입일련번호 채번
	ElseIf szTranID == "obsap_acif_999a" Then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO"  , i)
'		Form.ShowAlert("g_szFnprJoinSrno", g_szFnprJoinSrno)
		
		'가입계약서류 제공방식 관리
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
	
	'CDS 매수 신청
	ElseIf szTranID == "obsat_cdss_001a" Then
		Dim szSendData, szAcnt, szName, szAmount, szContAmt, szReYn
		szAcnt = "[종합매매-장외파생] " & Left(acnt0.total, 4) & "-" & Right(acnt0.total, 4) & "-" & acnt0.sequence
		szName = g_tData[2]
		szAmount = edtAmount.caption
		
		Dim nAmount, nMargRate
		nAmount = CInt(edtAmount.caption)
		nMargRate = CInt(g_tData[11])
		szContAmt = (nAmount/nMargRate) * 100
		
		If CInt(btnSwitch.switchindex) == 1 Then
			szReYn = "재투자"
		Else
			szReYn = "만기상환"
		End If
		szSendData = szAcnt & "★" & szName & "★" & szAmount & "★" & szContAmt & "★" & szReYn
		
		'신청완료 화면 팝업
		Form.OpenPopup("mbonl88027_p2" , szSendData , "")
	
	'가입계약서류 제공방식 관리
	ElseIf szTranID == "obcsb_acad_122a" Then
		'CDS 매수 신청
		DATAMANAGER.RequestTranData( "obsat_cdss_001a" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubText <> "" And szSubText <> null Then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	Else
		Form.ShowAlert("알림", szMsgText)
	End If
End Sub

'============================================================================
Function f_RegBtnEnable()
	'하단 신청하기 버튼 활성화 여부
	If edtAmount.caption == "" or edtAmount.caption == null Then
		btnReg.enable = false
		Exit Function
	End If
	
	If CInt(rdoProvision.currentindex) <> 0 And CInt(rdoProvision.currentindex) <> 1 Then
		btnReg.enable = false
		Exit Function
	End If
	
	If tblProvision.GetCellString(0, 0) == "" Or tblProvision.GetCellString(0, 0) == null Then
		btnReg.enable = false
		Exit Function
	End If
	
	btnReg.enable = true
End Function

'============================================================================
Function f_CalcCntcPrc()
	'계약(액면)금액 계산
	Dim nAmount, nMargRate, nCntcPrc
	nAmount = CInt(edtAmount.caption)
	nMargRate = CInt(g_tData[11])
	
	nCntcPrc = (nAmount/nMargRate) * 100
	
	lblGuide1.caption = "계약(액면)금액은"
	lblGuide2.caption = FormatNumber(nCntcPrc, 0) & "원 입니다."
End Function

'============================================================================
Sub rdoProvision_OnClick(nIndex)
	tblProvision.visible = true
	lblProNotice.visible = true
	imgProvision.visible = true
	
	If nIndex == 0 Then
		tblProvision.SetCellString(0, 0, g_szPhoneNum)
		lblProNotice.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
	Else
		tblProvision.SetCellString(0, 0, g_szEmail)
		lblProNotice.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
	End If
	
'	If tblProvision.GetCellString(0, 0) == "" Or tblProvision.GetCellString(0, 0) Then
'		tblProvision.SetCellString(0, 1, "등록하기 〉")
'	End If
	
	f_RegBtnEnable()
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.OpenFramePopup("mbonl88027_p5" , "" , "")
End Sub

'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub edtAmount_OnEditComplete()
	'최소거래금액 체크
	If UBound(g_tData) > 0 Then
		Dim nMinAmt, nInputAmt
		nMinAmt = CInt(g_tData[10])
		nInputAmt = CInt(edtAmount.caption)
		If nInputAmt < nMinAmt Then
			If nInputAmt > 0 Then
				Form.ShowAlert("안내", "최소 거래금액을 확인해 주세요.")
			End If
			edtAmount.caption = ""
			lblGuide1.caption = ""
			lblGuide2.caption = ""
			Exit Sub
		End If
		
		If nInputAmt > 0 Then
			'만 단위 아래 금액 입력 체크
			If (nInputAmt % 10000) > 0 Then
				Form.ShowAlert("안내", "만원단위로 입력해 주세요.")
				edtAmount.caption = ""
				lblGuide1.caption = ""
				lblGuide2.caption = ""
				Exit Sub
			End If
			f_CalcCntcPrc()
		Else
			lblGuide1.caption = ""
			lblGuide2.caption = ""
		End If
		
		f_RegBtnEnable()
	End If
End Sub

'============================================================================
Sub edtAmount_OnEditChar(CharCode)
	If edtAmount.caption == "" Then
		lblGuide1.caption = ""
		lblGuide2.caption = ""
	End If
End Sub

'============================================================================
Sub btnReg_OnClick()
	'신청하기 버튼
	If UBound(g_tData) > 0 Then		
		'신청가능금액 체크
		If CInt(edtAmount.caption) > CInt(g_tData[14]) Then
			Form.ShowAlert("알림", "거래신청금액(증거금)이 부족합니다.\n잔고 확인 후 다시 신청해 주세요.")
			Exit Sub
		End If
		
		'설명서확인 > 계좌비밀번호 입력 > 인증 절차 > 신청
		'설명서확인 팝업 오픈
		Form.OpenPopupAnimation("mbonl88027_p1" , g_tData[12] & "★" & g_tData[13] , "", "2")
	End If
End Sub

'============================================================================
Sub tblProvision_OnClick(lRow , lColumn)
	If lRow == 0 And lColumn == 1 Then
		'연락처변경 화면 오픈
		Form.OpenFramePopup("mbonl81000" , "" , "")
	End If
End Sub

'============================================================================
Sub imgToolTip1_OnClick()
	Dim szText
	szText = "재투자 신청시, 만기일 종료 후 30일 단위로\n'자동롤오버' 돼요.\n재투자(자동롤오버) 종료는 해지 신청을 통해\n가능하며, 해지 신청시 만기상환으로 변경 돼요."
	
	imgToolTip1.openToolTip(szText, 320, 120, 1)
End Sub

'============================================================================
Sub imgToolTip2_OnClick()
	Dim szText
	szText = "약관, 설명서 등 확인 서류를\n알림톡·문자 또는 이메일로 받을 수 있어요."
	
	imgToolTip2.openToolTip(szText, 290, 70, 1)
End Sub


