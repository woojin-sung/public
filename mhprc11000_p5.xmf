	<SCRIPT_INFO _len="4724" _ulen="4588" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 팝업_거래원상세
' 02. 화면설명 : 주식현재가 거래원탭 클릭시 거래원 상세정보 표시
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode
Dim g_szMemberCode, g_szMemberName

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData
	
	szData 	= Form.GetOpenLinkData()
	arrData = Split(szData, "|", -1, 1)
	
	If UBOUND(arrData) < 1 Then 'Data 없을때
		Exit Sub
	End If
	
	g_szItemCode   = arrData(0)
	g_szMemberCode = arrData(1)
	g_szMemberName = arrData(2)	

	Form.SetScreenName( arrData(3) )
	
End Sub

'============================================================================
Sub Form_OnFormInit()	
	
	DATAMANAGER.RequestTranData( "ohhts_1084_001r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0, "ohhts_1084_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE"	, 0 , "1084" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1084_001r", "InBlock1", "FID_INPUT_ISCD"  			, 0 ,  g_szItemCode )	
	DATAMANAGER.SetDataValue( 0, "ohhts_1084_001r", "InBlock1", "FID_INPUT_ISCD2"  			, 0 ,  g_szMemberCode )
	
	DATAMANAGER.SetDataValue( 0, "ohhts_1084_001r", "InBlock2", "FID_INPUT_ISCD"  			, 0 ,  g_szItemCode )
	DATAMANAGER.SetDataValue( 0, "ohhts_1084_001r", "InBlock2", "FID_INPUT_ISCD2" 			, 0 ,  g_szMemberCode)	
	DATAMANAGER.SetDataValue( 0, "ohhts_1084_001r", "InBlock2", "FID_INPUT_CNT1" 				, 0 ,  0 )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	DATAMANAGER.SetDataValue( 1, "ohhts_stck_mbcn", "InBlock1", "FIDR_MBCR_NO" , 0 , g_szMemberCode )
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCnt, i
	
	tbl0.SetCellString( 0, 1, g_szMemberName )
	
	For i = 0 To grd0.rowcount - 1
		If grd0.GetCellData( "bd_cell4", i ) = "1" then 
			grd0.SetCellData( "bd_cell1", i, "매도" )
			grd0.SetCellFgColor( "bd_cell1", i, "11")
			
		ElseIf grd0.GetCellData( "bd_cell4", i ) = "2" then 
			grd0.SetCellData( "bd_cell1", i, "매수" )
			grd0.SetCellFgColor( "bd_cell1", i, "10")
			
		End If
	Next
	
	DATAMANAGER.RequestRealData( "ohhts_stck_mbcn" )
	
End Sub


'============================================================================
Sub grd0_OnScrollEnd()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szSHRN_ISCD	
	szSHRN_ISCD = DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcn", "OutBlock1", "FIDR_SHRN_ISCD" , 0 )
	
	If g_szItemCode = szSHRN_ISCD Then
		grd0.insertrow = 0
		
		Dim nSELN_QTY, nSHNU_QTY, szBSOP_HOUR, nPRPR, nCNTG_VPL
	
		szBSOP_HOUR 	= DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcn", "OutBlock1", "FIDR_BSOP_HOUR" 	, 0 )	'영업시간
		nSELN_QTY 	= DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcn", "OutBlock1", "FIDR_SELN_QTY" 	, 0 )	'매도수량
		nSHNU_QTY 	= DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcn", "OutBlock1", "FIDR_SHNU_QTY" 	, 0 )	'매수수량
		nPRPR 		= DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcn", "OutBlock1", "FIDR_PRPR" 		, 0 )	'현재가
		nCNTG_VPL	= DATAMANAGER.GetDataValue( 1, "ohhts_stck_mbcn", "OutBlock1", "FIDR_CNTG_VOL"	, 0 )	'체결거래량
		
		If Trim(nSELN_QTY) <> "" Then
			grd0.SetCellData( "bd_cell1", 0, "매도" )
			grd0.SetCellFgColor( "bd_cell1", 0, "11")
			
		ElseIf Trim(nSHNU_QTY) <> "" Then
			grd0.SetCellData( "bd_cell1", 0, "매수" )
			grd0.SetCellFgColor( "bd_cell1", 0, "10")
		
		End If
		
		grd0.SetCellData( "bd_cell0", 0, szBSOP_HOUR )		
		grd0.SetCellData( "bd_cell2", 0, nCNTG_VPL )
		grd0.SetCellData( "bd_cell3", 0, nPRPR )
		
	End If
End Sub

