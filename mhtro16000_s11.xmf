'===============================================
' 컨트롤 초기화
'===============================================
Function Init_Control()
	g_nCommFontSize = Form.getEnvData("common.textsize")
	
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle1.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle1.paddinginfo = "0,0,0,0"
	
	contMain.lblExpand.paddinginfo = "0,0,0,0"
	contMain.lblExpand.fgcolor = g_szTxtColor_Grey
	
	contMain.lblExpand0.paddinginfo = "0,0,0,0"
	contMain.lblExpand0.fgcolor = g_szTxtColor_Grey
	
	contMain.lblGuideLine0.bgcolor = g_szLineColor
	contMain.lblGuideLine1.bgcolor = g_szLineColor
	
	contMain.lblLine0.bgcolor = g_szLineColor3
	contMain.lblDiv.bgcolor = g_szLineColor3
	contMain.lblDiv0.bgcolor = g_szLineColor3
	
	contMain.lblSubTitle1.caption = "기간 수익률       (전영업일 기준)"
	
	contMain.Button0.makeRangeSlider(false, 0, 100, 0, 50, 1.0)
	contMain.Button0.exceptSliderHandleType("1")
	contMain.Button0.SetRangeSliderLineHeight(3)
	contMain.Button0.setRangeSliderLineColor(347, 347)
	contMain.Button0.SetRangeSliderHandleSize(20)
	contMain.Button0.SetRangeSliderHandleImage("triangle")
	
	contMain.Button0.enable = false
	contMain.Button0.visible = false
	
	contMain.lblLow.imagefilepth = "roundbox_4r_stoke02.9"
	contMain.lblHigh.imagefilepth = "roundbox_4r_stoke02.9"
	
	for i = 0 to 1
		Form.SetCtlProp("contMain.lblTitle"&i, "fgcolor", g_szTxtColor_Grey)
		Form.SetCtlProp("contMain.lblTitle"&i, "paddinginfo", "10,0,0,0")
		
		Form.SetCtlProp("contMain.lblData"&i, "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.lblData"&i, "paddinginfo", "0,0,10,0")
		Form.SetCtlProp("contMain.lblData"&i, "maxlinecnt", "1")
	next
	
	contMain.lblRate.paddinginfo = "0,0,0,0"
	
	contMain.imgTooltip0.setMaintainingRatio("2")
	contMain.imgTooltip0.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("기간 수익률", 0, true, false)
	contMain.imgTooltip0.left = 20 + nTextWidth + 5
	
	contMain.lblRate.maxlinecnt = "1"
	'contMain.lblSubTitle1.setNeighborCtlPos("imgTooltip0", "right", 5, "기간 수익률")
	
	contMain.lblSubTitle1.changeTextAttr(0,13,334,0,true)
	contMain.lblSubTitle1.changeTextAttr(13,9,333,-6,true)
End Function

'==============================================
' 해외주식 현재가(프리/정규) 조회
'==============================================
Function Request_Tran_ohhts_6000_001r()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_szExidCd )	'마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_szOnlyCd )	'종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	'실시간 여부
	
	DATAMANAGER.RequestTranData("ohhts_6000_001r")
End Function

Function Process_Tran_ohhts_6000_001r()
	
	szHigh 	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_52_WEEK_HGPR", 0) 
	szLow	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_52_WEEK_LWPR", 0) 
	szHyun	= DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_PRPR", 0) 
	
	szPrevVol = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_PRDY_VOL", 0) 
	szVol = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ACML_VOL", 0)

	if szHigh <> "" and szLow <> "" and szHyun <> "" then
		if cdbl(szHyun) < cdbl(szLow) then
			szHyun =  cdbl(szLow)
		end if
		
		if cdbl(szHyun) > cdbl(szHigh) then
			szHyun = cdbl(szHigh)
		end if
		
		contMain.Button0.visible = true
		
		if Cdbl(szLow) = 0 and Cdbl(szHigh) = 0 then
			contMain.lblLow.caption =  "1년 최저가"
			contMain.lblHigh.caption =  "1년 최고가"
			
			contMain.lblLow.fgcolor = 333
			contMain.lblHigh.fgcolor = 333
			
			contMain.Button0.SetRangeSliderHandleImage("alpha")
			contMain.Button0.setRangeSliderLineColor(272, 272)
		else
			if g_szExidCd = "AX" or g_szExidCd = "NY" or g_szExidCd = "OQ" then
				
				contMain.Button0.SetRangeSlider( szLow, szHigh, szHyun, szHyun, 0.0001, 4)
				
				szhigh = FormatNumber(szhigh, 4)
				szlow = FormatNumber(szlow, 4)
			elseif g_szExidCd = "HK" or g_szExidCd = "SH" or g_szExidCd = "SZ" then
	
				contMain.Button0.SetRangeSlider( szLow, szHigh, szHyun, szHyun, 0.001,3)
				
				szhigh = FormatNumber(szhigh, 3)
				szlow = FormatNumber(szlow, 3)
			elseif g_szExidCd = "JP" then
	
				contMain.Button0.SetRangeSlider(szLow, szHigh, szHyun, szHyun, 0.1,1)
				
				szhigh = FormatNumber(szhigh, 1)
				szlow = FormatNumber(szlow, 1)
			else
	
				contMain.Button0.SetRangeSlider( szLow, szHigh, szHyun, szHyun, 1.0,0)
				
				szhigh = FormatNumber(szhigh, 0)
				szlow = FormatNumber(szlow, 0)
			end if
			
			nLen_High = Form.getLen(szHigh)
			nLen_Low = Form.getLen(szLow)
		
			contMain.lblLow.caption = szlow & "\n1년 최저가"
			contMain.lblHigh.caption = szhigh & "\n1년 최고가"
		
			contMain.lblLow.changeTextAttr(nLen_Low+1,6,333,-3,false) 
			contMain.lblHigh.changeTextAttr(nLen_High+1,6,333,-3,false) 
		end if
	end if
	
	Request_Tran_ohhts_6000_022r()
End Function

Function Request_Tran_ohhts_6000_022r()
	DATAMANAGER.ClearInputData(0, "ohhts_6000_022r")
	
	g_szData_Init_022r = ""
	g_szData_Date_022r = ""
	g_szData_Rate_022r = ""
	g_szData_Last = ""
	contMain.lblRate.caption = ""
	
	nidx = cint(contMain.rdoPeriod.currentindex)
	szPeriod = "1"
	
	if nidx == 0 then
		szPeriod = "1"
	elseif  nidx == 1 then
		szPeriod = "3"
	
	elseif  nidx == 2 then
		szPeriod = "12"
	
	elseif  nidx == 3 then
		szPeriod = "36"

	end if

	DATAMANAGER.SetDataValue( 0, "ohhts_6000_022r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_022r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , g_szOnlyCd )	'종목코드
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_022r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_szExidCd )	'마켓구분
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_022r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE"		, 0 , szPeriod )
	
	DATAMANAGER.RequestTranData("ohhts_6000_022r")
End Function

Function Process_Tran_ohhts_6000_022r()
		szData_Date = ""
		szData_Rate = ""
		szData_Init = ""

		nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_6000_022r", "OutBlock1")
		
		for i = 0 to nDataCnt-1
			
			szDate = DATAMANAGER.GetDataValue(0, "ohhts_6000_022r", "OutBlock1", "FID_DATE" , i)
			szRate = DATAMANAGER.GetDataValue(0, "ohhts_6000_022r", "OutBlock1", "FID_ERNN_RATE" , i)
			
			if g_szData_Last = "" then
				g_szData_Last = szRate
			end if
			
			if i <> 0 then
				
				szData_Date = ";" & szData_Date 
				szData_Rate = ";" & szData_Rate
				szData_Init = ";" & szData_Init 
			end if
			
			szData_Date = szDate & szData_Date 
			szData_Rate = szRate & szData_Rate
			szData_Init = i & szData_Init 
		next
		
		if g_szData_Init_022r <> "" then
			g_szData_Init_022r = g_szData_Init_022r & ";" & szData_Init
			g_szData_Date_022r = g_szData_Date_022r & ";" &szData_Date
			g_szData_Rate_022r = g_szData_Rate_022r & ";" &szData_Rate
		else
			g_szData_Init_022r = szData_Init
			g_szData_Date_022r = szData_Date
			g_szData_Rate_022r = szData_Rate
		end if
		
		if DATAMANAGER.IsMoreNextData("ohhts_6000_022r") == true then
			DATAMANAGER.RequestNextData("ohhts_6000_022r")
		else
			Init_ChartEx0()
		end if
		
	
		
End Function


Function Init_ChartEx0()
	if g_szData_Rate_022r == "" then
		Exit Function
	end if
	
	szItemNm = Form.getItemCodeInfo(g_szItemCd, "name")
	
	'----------------------------------------
	' 종목명1,종목명2,차트유형,스케일유형
	'----------------------------------------
	contMain.ChartEx0.SetAccrueName(szItemNm&",ETF_Compare_FundFlow,L")
'	contMain.ChartEx0.SetAccrueName(szData3_Nm&","&szData4_Nm&",ETF_Compare2,L")
	
	'----------------------------------------
	' 데이터 자리 초기화
	'----------------------------------------
	contMain.ChartEx0.SetAccrueData("initdata="..g_szData_Init_022r)
	
	'----------------------------------------
	' 날짜 데이터
	'----------------------------------------
	
	contMain.ChartEx0.SetAccrueData("자료일자="..g_szData_Date_022r)
	
	'----------------------------------------
	' 차트 데이터
	'----------------------------------------
	contMain.ChartEx0.SetAccrueData("ETF_Titles= (%);%;% ")
	contMain.ChartEx0.SetAccrueData("data1="..g_szData_Rate_022r.."=2")

	'----------------------------------------
	' 차트 그리기
	'----------------------------------------
	contMain.ChartEx0.SetLineColor(szItemNm&";117;147;226")
'	contMain.ChartEx0.SetLineColor(szData4_Nm&";219;161;12")

	contMain.ChartEx0.SetAccrueData("repaintall")
	
	contMain.lblRate.caption = g_szData_Last
	
End Function

