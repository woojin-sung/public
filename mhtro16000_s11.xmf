'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_001r" then
		Process_Tran_ohhts_6000_001r()
		
		Form.triggerEvent("#", "CHANGE_LAYOUT_S11", 475)
	elseif szTranID == "ohhts_6000_022r" then
		Process_Tran_ohhts_6000_022r()
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		g_szItemCd = sParam
		g_szExidCd = ""
		if instr(g_szItemCd, "@") > 0 then
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 
			
			szRtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			
			Request_Tran_ohhts_6000_001r()
			'Request_Tran_ohhts_6000_022r()
		end if
	end if
End Sub

'============================================================================


'============================================================================
Sub contMain_imgTooltip0_OnClick()
	sText = "수익률은 전일 종가 기준으로 제공돼요."
	contMain.imgTooltip0.ToolTipBringFront(true)
	
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.imgTooltip0.openToolTip( sText, 350, 50, 2 )
	else
		contMain.imgTooltip0.openToolTip( sText, 300, 50, 2 )
	end if
	
End Sub

'============================================================================


'============================================================================
Sub contMain_rdoPeriod_OnClick(nIndex)
	Request_Tran_ohhts_6000_022r()
End Sub

'============================================================================
Sub contMain_lblExpand_OnClick()
	Form.triggerEvent("#", "RETURN_LAYOUT", "호가")
End Sub

'============================================================================
Sub contMain_lblExpand0_OnClick()
	Form.triggerEvent("#", "RETURN_LAYOUT", "체결일자별")
End Sub

