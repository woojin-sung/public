' 신규가능수량
'============================================================================
Sub btnNew_OnClick()
	DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "PROS_CLS_CODE" , 0 , "" )
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_111r" )
End Sub

'============================================================================
' 청산가능수량
'============================================================================
Sub btnCal_OnClick()
	DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_111r" )
End Sub

