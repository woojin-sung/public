'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵호가주문
' 02. 화면설명 : 선옵호가주문_수량입력
' 03. 작    성 : 2016.02.24 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sType '매도(1)매수(2)구분
Dim g_sAcc '계좌번호(10자리)
Dim g_sCode '종목코드
Dim g_nCurPrc '현재가
Dim g_sIsFirst

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty_old(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

Function Calc_Qty(nGbn)
	Dim szQty, szCalc, szUnit, szCut, szData, szChk
	Dim nUnit, nLen, nResult
	
	szQty = edtQty.caption

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szQty) <> "" then
		if CDbl(szQty) >= 99000000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			nResult = CDbl(szQty) Mod nUnit
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else		' 20160317 추가사항 적용
				szQty = szQty - nUnit
				nResult = CDbl(szQty) Mod nUnit

				if nResult <> 0 then
					nResult = nUnit - nResult
					szQty = CDbl(szQty) + nResult
				elseif nResult == 0 then
					if Len(nUnit) > 1 then
						szQty = szQty + nUnit
						szCut = Mid(szQty, 1, 1)
						
						if szCut == "1" then
							szChk = Mid(szQty, 2, Len(szQty))

							For i = 0 to Len(szChk)-1
								szData = Mid(szChk, i+1, 1)

								if szData <> "0" then
									szQty = szQty - nUnit
									Exit For
								end if
								
								if i == Len(szChk)-1 then
									nUnit = Left(nUnit, Len(nUnit)-1)
									szQty = szQty - nUnit
								end if
							Next
						else
							szQty = szQty - nUnit
						end if
					end if
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szQty
	szQty = edtQty.caption
	
	if nGbn == 1 then
		if Trim(szQty) == "" then
			szQty = 0
		end if
		
		szQty = CDbl(szQty) + nPlus
	else
		
		'처음 숫자는 초기화
		if g_sIsFirst == true then
			g_sIsFirst = false
			szQty = nPlus
		else
			szQty = szQty & nPlus
		end if
		
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szQty
	szQty = edtQty.caption
	
	if Len(edtQty.caption) > 0 then
		szQty = edtQty.caption & szPlus
		
		Sum_Qty(szQty)
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	if Len(szData) < 9 then
		edtQty.caption = szData
	end if
End Function

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData, sTemp, sQty
	sRevData = Form.GetOpenLinkData()
'sRevData = "2★3007388102★301L8235★0.12"
	
	if sRevData == null or Trim(sRevData) == "" then
		Exit Sub
	end if

	'매도(1)매수(2)구분★계좌번호(10자리)★종목코드★현재가
	sTemp = Split(sRevData, "★")
	
	g_sType = sTemp[0]
	g_sAcc = sTemp[1]
	g_sCode = sTemp[2]
	g_nCurPrc = GetTonumber(sTemp[3])
	sQty = sTemp[4]

	if sQty == "" then
		edtQty.caption = ""
	else
		edtQty.caption = GetTonumber(CDbl(sTemp[4]))
	end if
	
	if g_sType == "1" then '매도
		rdoType.currentindex = "1"
	else '매수
		rdoType.currentindex = "0"
	end if
	
	g_sIsFirst = true
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtrf_cntg_111r" then
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "ISCD" , 0 , g_sCode )
		if rdoType.currentindex == "0" then '매수
			DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "DEAL_CLS_CODE" , 0 , "2" )
		else '매도
			DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "DEAL_CLS_CODE" , 0 , "1" )
		end if
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "ASPR_TYPE_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "FTOP_ODER_UNPR" , 0 , g_nCurPrc )
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_111r", "InBlock1", "ODQT" , 0 , edtQty.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrf_cntg_111r" then
		edtQty.caption = DATAMANAGER.GetDataValue( 0, "obtrf_cntg_111r", "OutBlock1", "ODER_ABLE_QTY" , 0 )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obtrf_cntg_111r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

