Dim g_szItemNm, g_szRghtCd, g_szRghtNm, g_szStatCd, g_szStndDate, g_szWrhsDate
Dim g_szFRSK, g_szFRSKQty, g_szFRSKDate 
Dim g_Left, g_Top
g_Left = 12
g_Top = 288

Function SetVisible()

	Table012.left = 512 
	Select Case g_szRghtCd	
	
		Case "01", "51", "25", "75" '01	유상	 51,25,75	
			'신주인수권이 있는 경우 
			if InStr(grd0.GetCellData("bd_cell22", 0) , "J") > 0 or InStr(grd0.GetCellData("bd_cell22", 0) , "j") > 0 then
				'Table011
				Table011.left = g_Left
				Table011.top = g_Top
				Table011.SetCellString(0, 1, "유상")
			else
				'Table012
				Table012.left = g_Left 
				Table012.top = g_Top
				Table012.SetCellString(0, 1, "유상")
				if g_szStatCd == "2" then '예정
					Button0.visible = "1"				
					Button0.Caption = "유상청약 바로가기  >"			
				else
					Button0.visible = "0"				
				end if
			end if 

		Case "02", "52"  '02 무상 02,52		
			if g_szStatCd == "2" then 
				Table022.left = g_Left 
				Table022.top = g_Top
				Table022.SetCellString(0, 1, "무상")
			else
				Table021.left = g_Left
				Table021.top = g_Top
				Table021.SetCellString(0, 1, "무상")
			end if 
			
		Case "03","53"  '03 배당(현금, 주식, 동시배당)	03,53	
			if g_szRghtNm == "현금배당" then
				if g_szStatCd == "2" then
					Table032.left = g_Left 
					Table032.top = g_Top
					Table032.SetCellString(0, 1, g_szRghtNm)
				else
					Table031.left = g_Left 
					Table031.top = g_Top
					Table031.SetCellString(0, 1, g_szRghtNm)
				end if
				
			elseif g_szRghtNm == "주식배당" then
				if g_szStatCd == "2" then
					Table034.left = g_Left 
					Table034.top = g_Top
					Table034.SetCellString(0, 1, g_szRghtNm)
				else
					Table033.left = g_Left 
					Table033.top = g_Top
					Table033.SetCellString(0, 1, g_szRghtNm)
				end if
			elseif g_szRghtNm == "동시배당" then
				if g_szStatCd == "2" then
					Table036.left = g_Left 
					Table036.top = g_Top
					Table036.SetCellString(0, 1, g_szRghtNm)
				else
					Table035.left = g_Left 
					Table035.top = g_Top
					Table035.SetCellString(0, 1, g_szRghtNm)
				end if
			end if			
			
		Case "04", "54" '04 매수청구	04,54
			if g_szStatCd == "2" then '예정
				Table042.left = g_Left 
				Table042.top = g_Top
				Table042.SetCellString(0, 1, "매수청구")
				Button0.visible = "1"				
				Button0.Caption = "반대의사/매수청구 바로가기  >"			
				
			else '지급
				Table041.left = g_Left  
				Table041.top = g_Top
				Table041.SetCellString(0, 1, "매수청구")
			end if 		
			
		Case "17", "28", "30", "35" '17	ETF분배금 28	ETN분배금, 35	ETN액면병합, 30 펀드분배금
			if g_szStatCd == "2" then
				Table172.left = g_Left 
				Table172.top = g_Top
				Table172.SetCellString(0, 1, g_szRghtNm)
			else
				Table171.left = g_Left 
				Table171.top = g_Top
				Table171.SetCellString(0, 1, g_szRghtNm)
			end if 
			
'		Case "28", "35" '28	ETN분배금 35 ETN액면병합
'			if g_szStatCd == "2" then
'				Table282.left = g_Left 
'				Table282.top = g_Top
'				Table282.SetCellString(0, 1, g_szRghtNm)
'			else
'				Table281.left = g_Left 
'				Table281.top = g_Top
'				Table281.SetCellString(0, 1, g_szRghtNm)
'			end if			
			
		Case "07", "57" '07 합병 07,57
			if g_szStatCd == "2" then
				Table072.left = g_Left 
				Table072.top = g_Top
				Table072.SetCellString(0, 1, "합병")
			else
				Table071.left = g_Left 
				Table071.top = g_Top
				Table071.SetCellString(0, 1, "합병")
			end if 
			
		Case "08", "58" '08 무상감자 08,58
			if g_szStatCd == "2" then
				Table082.left = g_Left 
				Table082.top = g_Top
				Table082.SetCellString(0, 1, "무상감자")
			else
				Table081.left = g_Left 
				Table081.top = g_Top
				Table081.SetCellString(0, 1, "무상감자")
			end if 	
			
		Case "09", "59" '09 유상감자 09,59
			if g_szStatCd == "2" then
				Table092.left = g_Left 
				Table092.top = g_Top
				Table092.SetCellString(0, 1, "유상감자")
			else
				Table091.left = g_Left 
				Table091.top = g_Top
				Table091.SetCellString(0, 1, "유상감자")
			end if 	
			
		Case "10", "11", "60", "61" '10	액면분할, 11 액면병합	10,60 11,61		
			if g_szStatCd == "2" then
				Table102.left = g_Left 
				Table102.top = g_Top
				Table102.SetCellString(0, 1, g_szRghtNm)
			else
				Table101.left = g_Left 
				Table101.top = g_Top
				Table101.SetCellString(0, 1, g_szRghtNm)
			end if 
			
		Case "12", "13", "14", "31","32", "33","34","62","63","64","67","68","69","70" '12 기업분할 12,13,14,31,32,33,34,62,63,64,67,68,69,70
			if g_szStatCd == "2" then
				Table122.left = g_Left 
				Table122.top = g_Top
				Table122.SetCellString(0, 1, "기업분할")
			else
				Table121.left = g_Left 
				Table121.top = g_Top
				Table121.SetCellString(0, 1, "기업분할")
			end if
			
		Case "15", "16", "65", "66" '15, 16	주식교환/주식이전	15,65,16,66
			if g_szRghtCd == "16" then
				g_szRghtNm = "주식이전"
			else
				g_szRghtNm = "주식교환"
			end if 
			
			if g_szStatCd == "2" then
				Table152.left = g_Left 
				Table152.top = g_Top
				Table152.SetCellString(0, 1, g_szRghtNm)
			else
				Table151.left = g_Left 
				Table151.top = g_Top
				Table151.SetCellString(0, 1, g_szRghtNm)
			end if
	End Select
end Function


' 02 무상(예정, 지급)					: 단수주수, 단수주대금(세전) - OK 
' 03  배당(주식, 동시배당)(예정, 지급)	: 단수주지급일, 단수주대금(세전) - OK 
' 07	 합병(예정, 지급) 		: 단수주지급일, 단수주대금(세전) - OK 
' 09	 유상감자(예정, 지급) 	: 단수주지급일, 단수주대금(세전) - OK 
' 08	 무상감자(예정, 지급) 	: 단수주지급일, 단수주대금(세전)/단수주지급금액(세전)??? - OK 
' 10	 액면분할(예정) 		: 단수주지급일, 단수주대금(세전) - OK
' 11  액면병합(예정) 		: 단수주지급일, 단수주대금(세전)  - OK
' 12, 13 기업분할(예정, 지급) 			: 단수주지급일, 단수주대금(세전) - OK
' 15, 16	주식교환/주식이전(예정, 지급) 	: 단수주지급일, 단수주대금(세전)  - OK

'단수주수량이 0 이상일 경우에만 단수주지금일, 단수주금액이 보여짐
'단수주수량은 소숫점(10자리)이나 금액은 정수로 나옴.. 23-10-18
'g_szFRSKQty	g_szFRSKDate	g_szFRSK

Function SetData()
	Dim sTemp 
	Select Case g_szRghtCd	
	
		Case "01", "51", "25", "75" '01	유상	 51,25,75
		
			'신주인수권이 있는 경우 
			if InStr(grd0.GetCellData("bd_cell22", 0) , "J") > 0 or InStr(grd0.GetCellData("bd_cell22", 0) , "j") > 0 then
				'Table011.SetCellString(0, 1, "유상")			
				if g_szStatCd == "2" then '예정
					Table011.SetCellString(1, 0, "증서입고예정수량") '증서입고예정수량
				else
					Table011.SetCellString(1, 0, "증서입고수량") '증서입고예정수량
				end if
				
				Table011.SetCellString(1, 1, grd0.GetCellData("bd_cell28",  0)) '증서입고수량
				Table011.SetCellString(2, 1, grd0.GetCellData("bd_cell23", 0)) '신주증서명 
			else
				'Table012.SetCellString(0, 1, "유상")
				Table012.SetCellString(2, 1, grd0.GetCellData("bd_cell13", 0) & grd0.GetCellData("bd_cell14", 0)) '청약일정				
				Table012.SetCellString(6, 1, grd0.GetCellData("bd_cell39",  0)) '청약금액				
				Table012.SetCellString(7, 1, grd0.GetCellData("bd_cell70",  0)) '청약단가	
				
				if g_szStatCd == "2" then '예정
					Table012.SetCellString(1, 0, "배정주수") 
					Table012.SetCellString(1, 1, grd0.GetCellData("bd_cell28",  0)) '배정주수
					Table012.SetCellString(3, 0, "본청약가능수량") 
					'Table012.SetCellString(3, 1, grd0.GetCellData("bd_cell30", 0)) '본청약가능수량
					Table012.SetCellString(3, 1, grd0.GetCellData("bd_cell28", 0)) '본청약가능수량
					Table012.SetCellString(4, 0, "초과청약가능수량") 
					'Table012.SetCellString(4, 1, grd0.GetCellData("bd_cell34",  0)) '초과청약가능수량
					Table012.SetCellString(4, 1, grd0.GetCellData("bd_cell32",  0)) '초과청약가능수량
					Table012.SetCellString(5, 0, "청약가능수량") 
					Table012.SetCellString(5, 1, grd0.GetCellData("bd_cell36",  0)) '청약가능수량						
					
					Table012.SetCellString(8, 0, "") 
					Table012.SetCellMaskInfo(8, 1,  "1,0,,,1,,0,0,1,0,0")
					Table012.SetCellString(8, 1, "") 
				else
					Table012.SetCellString(1, 0, "입고수량") 
					Table012.SetCellString(1, 1, grd0.GetCellData("bd_cell28",  0)) '입고수량					
					Table012.SetCellString(3, 0, "본청약신청수량") 
					Table012.SetCellString(3, 1, grd0.GetCellData("bd_cell30", 0)) '본청약신청수량
					Table012.SetCellString(4, 0, "초과청약신청수량") 
					Table012.SetCellString(4, 1, grd0.GetCellData("bd_cell34",  0)) '초과청약신청수량
					Table012.SetCellString(5, 0, "청약신청수량") 
					'Table012.SetCellString(5, 1, grd0.GetCellData("bd_cell36",  0)) '청약신청수량
					Table012.SetCellString(5, 1, grd0.GetCellData("bd_cell38",  0)) '청약신청수량
					
					'상장일자
					if Trim(grd0.GetCellData("bd_cell10", 0)) == "" then
						Table012.SetCellMaskInfo(8, 1,  "1,0,,,1,,0,0,1,0,0")
						Table012.SetCellString(8, 1, "미정") 
					else
						Table012.SetCellString(8, 1, grd0.GetCellData("bd_cell10", 0)) 
					end if				
				end if
			end if 
			
		Case "02", "52" '02	무상 02,52	
'msgbox "단수주수 : " & g_szFRSKQty
			if g_szStatCd == "2" then  '예정
				'Table022.SetCellString(0, 1, "무상")
				'Table022.SetCellString(1, 1, grd0.GetCellData("bd_cell10",  0)) '입고일
				'입고일
				if Trim(grd0.GetCellData("bd_cell10", 0)) == "" then
					Table022.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
					Table022.SetCellString(1, 1, "미정") 
				else
					Table022.SetCellString(1, 1, grd0.GetCellData("bd_cell10", 0)) 
				end if				
				Table022.SetCellString(2, 1, grd0.GetCellData("bd_cell28", 0)) '배정주수
				
				'단수주수
				if Trim(g_szFRSKQty) == "" then
					'안보이도록 처리
					Table022.SetCellMaskInfo(3, 1, "1,0,,,1,,0,0,1,0,0")
					Table022.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")
					Table022.SetCellString(3, 0, "") 
					Table022.SetCellString(4, 0, "") 
					Table022.SetCellString(3, 1, "") 
					Table022.SetCellString(4, 1, "") 
				else
					Table022.SetCellString(3, 1, g_szFRSKQty) 
					
					'단수주대금(세전)
					if Trim(g_szFRSK) == "" then
						'안보이도록 처리
						Table022.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")
						Table022.SetCellString(4, 0, "") 
						Table022.SetCellString(4, 1, "") 
					else
						Table022.SetCellMaskInfo(4, 1, "0,0,,원,0,,0,1,0,0,0") 
						Table022.SetCellString(4, 1, g_szFRSK) 
					end if 					
				end if 
					
			else '지급
				'Table021.SetCellString(0, 1, "무상")
				'입고일
				if Trim(grd0.GetCellData("bd_cell10", 0)) == "" then
					Table021.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
					Table021.SetCellString(1, 1, "미정") 
				else
					Table021.SetCellString(1, 1, grd0.GetCellData("bd_cell10", 0)) 
				end if
				
				Table021.SetCellString(2, 1, grd0.GetCellData("bd_cell28", 0)) '입고수량
				
				'단수주수
				if Trim(g_szFRSKQty) == "" then
					'안보이도록 처리
					Table021.SetCellMaskInfo(3, 1, "1,0,,,1,,0,0,1,0,0")
					Table021.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")
					Table021.SetCellString(3, 0, "") 
					Table021.SetCellString(4, 0, "") 
					Table021.SetCellString(3, 1, "") 					
					Table021.SetCellString(4, 1, "") 
				else
					Table021.SetCellString(3, 1, g_szFRSKQty) 
					
					'단수주대금(세전)
					if Trim(g_szFRSK) == "" then
						'안보이도록 처리				
						Table021.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")
						Table021.SetCellString(4, 0, "") 
						Table021.SetCellString(4, 1, "") 					
					else
						Table021.SetCellMaskInfo(4, 1, "0,0,,원,0,,0,1,0,0,0") 
						Table021.SetCellString(4, 1, g_szFRSK) 
					end if 					
				end if 
				
			end if 
			
		Case "03", "53" '03	 배당(현금, 주식, 동시배당)	03,53
		
			if g_szRghtNm == "현금배당" then
			
				lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 
				
				if g_szStatCd == "2" then '예정
					'Table032.SetCellString(0, 1, g_szRghtNm)
					'지급일자
					if Trim(grd0.GetCellData("bd_cell11",  0)) == "" then
						Table032.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
						Table032.SetCellString(1, 1, "미정") 
					else
						Table032.SetCellString(1, 1, grd0.GetCellData("bd_cell11",  0)) 
					end if 						
					Table032.SetCellString(2, 1, grd0.GetCellData("bd_cell55", 0)) '주당배당액
					Table032.SetCellString(3, 1, grd0.GetCellData("bd_cell29", 0)) '배당금(세전)
					Table032.SetCellString(4, 1, grd0.GetCellData("bd_cell50",  0)) '세금합계
					Table032.SetCellString(5, 1, grd0.GetCellData("bd_cell71",  0)) '배당금입금					
				else '지금
					'Table031.SetCellString(0, 1, g_szRghtNm)
					'지급일자
					if Trim(grd0.GetCellData("bd_cell11",  0)) == "" then
						Table031.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
						Table031.SetCellString(1, 1, "미정") 
					else
						Table031.SetCellString(1, 1, grd0.GetCellData("bd_cell11",  0)) 
					end if 					
					Table031.SetCellString(2, 1, grd0.GetCellData("bd_cell29", 0)) '배당금(세전)
					Table031.SetCellString(3, 1, grd0.GetCellData("bd_cell50", 0)) '세금합계
					Table031.SetCellString(4, 1, grd0.GetCellData("bd_cell71", 0)) '배당금입금
				end if
				
			elseif g_szRghtNm == "주식배당" then
				
				if g_szStatCd == "2" then '예정
					'Table034.SetCellString(0, 1, g_szRghtNm)
					'지급일자
					if Trim(grd0.GetCellData("bd_cell10",  0)) == "" then
						Table034.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
						Table034.SetCellString(1, 1, "미정") 
					else
						Table034.SetCellString(1, 1, grd0.GetCellData("bd_cell10",  0)) 
					end if 					
					Table034.SetCellString(2, 1, grd0.GetCellData("bd_cell28", 0)) '배당주수
					
					'단수주수
					if Trim(g_szFRSKQty) == "" then					
