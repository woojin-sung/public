						'안보이도록 처리
						Table151.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")
						Table151.SetCellString(5, 0, "") 
						Table151.SetCellString(5, 1, "")
					else
						Table151.SetCellString(5, 1, g_szFRSKDate) 
					end if 
					
					'단수주대금(세전)
					if Trim(g_szFRSK) == "" then
						'안보이도록 처리
						Table151.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0")
						Table151.SetCellString(6, 0, "")
						Table151.SetCellString(6, 1, "")
					else
						Table151.SetCellMaskInfo(6, 1, "0,0,,원,0,,0,1,0,0,0")
						Table151.SetCellString(6, 1, g_szFRSK) 
					end if 					
				end if 
			end if
	End Select
end Function 

'============================================================================
Sub Form_OnFormInitBefore()

End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	grd0.rowcount = 0	
	szData = Form.GetOpenLinkData()	
	if szData <> "" then
		grd0.AddRow(0)
		tData = Split(szData, "★")
		For i = 0 to grd0.colcount -1  ' 76개
			grd0.SetCellData("bd_cell"&CStr(i), 0, tData(i))
		Next			
		
		g_szItemNm = tData(5) '종목코드
		g_szRghtCd = tData(6) '권리유형코드
		g_szRghtNm = tData(8) '권리유형명
		g_szStatCd = tData(9) '상태처리코드
		g_szStndDate = tData(7) '기준일
		g_szWrhsDate = tData(10) '입고일
		lblItem.caption = g_szItemNm
		
		if g_szStatCd == "1" then '지급
			lblDate.caption = "입고일 "& Left(g_szWrhsDate, 4) &"."& Mid(g_szWrhsDate, 5, 2) &"."& Right(g_szWrhsDate, 2)
		elseif g_szStatCd == "2" then '예정
			lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 
		end if 		

		'단수주수량이 0 이상일 경우에만 단수주지금일, 단수주금액이 보여짐
		'단수주수량은 소숫점(10자리)이나 금액은 정수로 나옴.. 23-10-18
		'단수주수량
		if grd0.GetCellData("bd_cell40", 0) <> nil then 
			g_szFRSKQty = CDbl(grd0.GetCellData("bd_cell40", 0))
			if g_szFRSKQty == "0" or g_szFRSKQty == 0 then
				g_szFRSKQty = ""
			end if
		else 
			g_szFRSKQty = ""
		end if 		
		'단수주대금(세전)
		if grd0.GetCellData("bd_cell41", 0) <> nil then 
			g_szFRSK = CDbl(grd0.GetCellData("bd_cell41", 0))
			if g_szFRSK == "0" or g_szFRSK == 0 then
				g_szFRSK = ""
			end if
		else 
			g_szFRSK = ""
		end if 
		'단주주수지급일
		g_szFRSKDate = grd0.GetCellData("bd_cell12", 0)
		
		SetVisible()
		SetData()

	else
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub Button0_OnClick()
	if  g_szRghtCd == "04" then '매수청구
		Form.OpenScreen("83140", "")
	else '유상청약
		Form.OpenScreen("83010", "")
	end if 
End Sub
