                        '(처리한)현재투자성향 재조회후 종료
                        DATAMANAGER.RequestTranData("obcsb_acif_801r_1")
                    End If
                End If
            End If

        Case Else
            If g_713rPros_Cnt > 0 Then
                '처리대상 존재시, 다음 개설상품 가입처리
                DATAMANAGER.RequestTranData("obcsb_acif_713r")	
            Else
                '(처리한)현재투자성향 재조회후 종료
                DATAMANAGER.RequestTranData("obcsb_acif_801r_1")
            End If	
        End Select
        
    ElseIf szTranID = "obcsb_acif_715a" Then	
        If Set712Input() == True Then
			'21.09.14 JHY START : 2회차부터 재진단 사유 표기 (v0004)
			if 1 < g_nTryCnt then
				if g_nTryCnt < 4 then
					Form.OpenPopup("mbonl81010_p15" , "" , "")
				else
					Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
				end if
			else
			    DATAMANAGER.RequestTranData("obcsb_acif_712a")
		    end if
        End If	
    
    ElseIf szTranID == "obcsb_acif_712a" Then
		' 21.09.13 JHY START
		'	[KYC투자성향등급코드]
		'	00@정보미제공
		'	01@고수익지향형
		'	02@성장지향형
		'	03@중립형
		'	04@안정지향형
		'	05@이자소득형
	
		Dim szInvGradeIn, szInvGradeOut, szEntt, szTrust, szEnttName, szTrustName
		
		'만기일 추가
		Dim szKycValid, szEnttValid, szTrustValid			'일반투자성향만기일, 일임형만기일, 신탁만기일
		
		szInvGradeIn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		szEntt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ENTT_IVIC_GRCD", 0)
		szTrust = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TRUST_IVIC_GRCD", 0)
		
		szKycValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_VALD_PRD_MTRT_DATE", 0)
		szEnttValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ENTT_KYC_MTRT_DATE", 0)
		szTrustValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TRUST_KYC_MTRT_DATE", 0)
		
		
		' KYC꺼에 맵핑하면 된다고 권오상 차장님 확인
		szInvGradeOut = Form.GetMetaData("KYC투자성향등급코드", szInvGradeIn)
		szEnttName = Form.GetMetaData("KYC투자성향등급코드", szEntt)
		szTrustName = Form.GetMetaData("KYC투자성향등급코드", szTrust)

		Form.OpenPopup("mbbdm85143" , szInvGradeOut & "★" & szEnttName & "★" & szTrustName & "★" & szKycValid & "★" & szEnttValid & "★" & szTrustValid, "")  '진단완료
		' 21.09.13 JHY END
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    
    If szTranID = "obcsb_acif_715a" Or szTranID = "obcsb_acif_712a" Then
        If szErrCode == "4966" And szSubMsg == "설문항목이 누락되었습니다." Then
            Form.MsgBox("알림", "기존에 등록된 정보가 없거나 설문에 응답하지 않은 항목이 존재합니다. 투자성향 진단을 다시 등록해 주세요.", "retry", 6)
        ElseIf szErrCode == "5820" And szSubMsg == "설문항목점수 정보 없음" Then
            Form.MsgBox("알림", "기존에 등록된 정보가 없거나 설문에 응답하지 않은 항목이 존재합니다. 투자성향 진단을 다시 등록해 주세요.", "retry", 6)
        Else
            If Trim(szSubMsg) == "" Then
                Form.ShowAlert("알림" , szErrMsg)
            Else
                Form.ShowAlert("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" )
            End If		

            User_SharedData_Set("init")
            Form.SendReturnToParent("MBBDM85140", "")
            Form.CloseForm()
        End If
    Else
        If Trim(szSubMsg) == "" Then
            Form.ShowAlert("알림" , szErrMsg)
        Else
            Form.ShowAlert("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" )
        End If		

        User_SharedData_Set("init")
        Form.SendReturnToParent("MBBDM85140", "")
        Form.CloseForm()
    End If
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    '투자성향 진단 설문 1
    If sKeyName == "MBBDM85141" Then
        'sRet. ok.완료 null.그냥종료	
        If sRet == "ok" Then
            Form.SetSharedData("BDM_CHK_KYC" , "Y")

            '현재투자성향정보 조회(상품가입가능여부 체크 필요)
            DATAMANAGER.RequestTranData("obcsb_acif_801r")
        Else
            User_SharedData_Set("init")
            Form.SendReturnToParent("MBBDM85140", sRet)
            Form.CloseForm()
        End If    
	
    '투자권유희망 확인서
    ElseIf sKeyName == "MBBDM85147" Then
        'sRet. ok.투자권유희망 확인 null.그냥종료
        If sRet == "ok" Then
            '(처리한)현재투자성향 재조회후 종료
            'JMY DATAMANAGER.RequestTranData("obcsb_acif_801r_1")
            'JMY 부적합대상 존재시, 부적합고지 Open
            If g_APLY_UNFIT_YN = "Y" Or g_APLY_DVPD_UNFIT_YN = "Y" Then
                If g_REG_KYC_YN = "Y" Then
                    Form.MsgBox("알림", "계좌개설을 진행하는 기간에 투자성향이 변경되신 고객님의 경우 계좌개설을 처음부터 다시 진행하셔야 합니다.\n(기존 입력된 개설과정은 삭제됩니다.)", "unable", 6)  '6.close/cancel
                Else
                    Form.OpenPopup("mbbdm85145", "", "")
                End If
            Else
                '(처리한)현재투자성향 재조회후 종료
                DATAMANAGER.RequestTranData("obcsb_acif_801r_1")
            End If
	    
        Else 
            User_SharedData_Set("init")
            Form.SendReturnToParent("MBBDM85140", sRet)  'sRet.unfit_fail/null/hopeRecInv_fail
            Form.CloseForm()	
        End If
    
    '개설불가(재진단필요)
    ElseIf sKeyName == "MBBDM85144" Then
        'sRet. re.재진단 null.그냥종료
        If sRet == "re" Then
            '투자성향진단
            User_SharedData_Set("init")
            Form.OpenPopup("mbbdm85141", "NEW", "")
        Else
            Form.SendReturnToParent("MBBDM85140", "")  '그냥종료
            Form.CloseForm()	
        End If

    '부적합고지
    ElseIf sKeyName == "MBBDM85145" Then        
        If sRet == "ok" Then	
            'Form.SendReturnToParent("MBBDM85140", "ok")
            'Form.CloseForm()
            'tmpYN = Form.GetSharedData("BDM_DVPD_UNFIT_YN" , False)
            'If BDM_PRCD101 == "Y" And tmpYN = "Y" Then
                'Form.SetSharedData("BDM_PRCD101_UNFIT" , "Y")
            'End If
            'If BDM_PRCD135 == "Y" And tmpYN = "Y" Then
                'Form.SetSharedData("BDM_PRCD135_UNFIT" , "Y")
            'End If
            'If tmpYN == "Y" Then
                '적정성보고서 Open
                'Form.OpenPopupAnimation("mbbdm85146", "", "", "2")
		   'Else
            '(처리한)현재투자성향 재조회후 종료
            DATAMANAGER.RequestTranData("obcsb_acif_801r_1")	    
		   'End If
        Else
            User_SharedData_Set("init")
            Form.SendReturnToParent("MBBDM85140", sRet)  'sRet.unfit_fail/null
            Form.CloseForm()	
        End If
	
    '투자성향진단선택
    ElseIf sKeyName == "MBBDM85140_P1" Then

	    'sRet. 0.신규/재진단 1.동일 null.그냥종료
        If sRet == "0" or sRet == 0 Then
            User_SharedData_Set("init")
            Form.OpenPopup("mbbdm85141", "NEW", "")

        ElseIf sRet == "1" or sRet == 1 Then
            '1.투자권유희망+정보제공 2.투자권유희망+정보미제공 3.투자권유불원+정보제공 4.투자권유불원+정보미제공
		   'szInvtRcmdGb = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0)
            if g_szInvtRcmdGb == "1" or g_szInvtRcmdGb == 1 then
                MBBDM85141_Q1Answer = "2"
                MBBDM85141_Q2Answer = "2"
            elseif g_szInvtRcmdGb == "2" or g_szInvtRcmdGb == 2 then
                MBBDM85141_Q1Answer = "2" 'v0002 예 "1"
                MBBDM85141_Q2Answer = "1" 'v0002 아니오 "2"
            elseif g_szInvtRcmdGb == "3" or g_szInvtRcmdGb == 3 then
                MBBDM85141_Q1Answer = "1" 'v0002 아니오 "2"
                MBBDM85141_Q2Answer = "2" 'v0002 예 "1"
            elseif g_szInvtRcmdGb == "4" or g_szInvtRcmdGb == 4 then
                MBBDM85141_Q1Answer = "1"
                MBBDM85141_Q2Answer = "1"
            else
                MBBDM85141_Q1Answer = ""
                MBBDM85141_Q2Answer = ""
		   end if

            'szWeakYN = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "WEAK_YN", 0)

            if g_szWeakYN == "Y" then
                MBBDM85141_Q3Answer = "2"
            elseif g_szWeakYN == "N" then
                MBBDM85141_Q3Answer = "1"
            else
                MBBDM85141_Q3Answer = ""
            end if
	    
            If MBBDM85141_Q1Answer == "1" or MBBDM85141_Q1Answer == 1 Then
                g_BDM_RCMD_YN = "N"   ' 투자권유여부 : 아니오
            ElseIf MBBDM85141_Q1Answer == "2" or MBBDM85141_Q1Answer == 2 Then
                g_BDM_RCMD_YN = "Y"   ' 투자권유여부 : 예
            End If	
	
            If MBBDM85141_Q2Answer == "1" or MBBDM85141_Q2Answer == 1 Then
                g_BDM_INFO_OFER_YN = "N" '고객정보제공여부 : 아니오
            ElseIf MBBDM85141_Q2Answer == "2" or MBBDM85141_Q2Answer == 2 Then
                g_BDM_INFO_OFER_YN = "Y" '고객정보제공여부 : 예
            End If    	    
	    
            DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "CNSH_CLS_CODE"  , 0 , "09"     ) '확인서구분코드
            DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "RCNO_TYPE_CODE" , 0 , "01"     ) '실명확인번호 구분코드
            DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "RCNO_PIP"       , 0 , g_RCNO_PIP ) '실명확인번호 구분코드
	
            If MBBDM85141_Q3Answer == "2" or MBBDM85141_Q3Answer == 2 Then '취약금융소비자입니까? : 예
                DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "Y" )	'고객확인여부
            ElseIf MBBDM85141_Q3Answer == "1" or MBBDM85141_Q3Answer == 1 Then '취약금융소비자입니까? : 아니오
                DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "N" )	'고객확인여부
            End If	   	    

            DATAMANAGER.RequestTranData("obcsb_acif_715a" )	'확인서 이력등록	
	   Else
            Form.SendReturnToParent("MBBDM85140", "")  '그냥종료
            Form.CloseForm()
        End If

    ElseIf sKeyName == "MBBDM85143" Then
        If sRet == "ok" Then
             Form.SetSharedData("BDM_CHK_KYC" , "Y")
            'Form.SendReturnToParent("MBBDM85140", "ok")
            'Form.CloseForm()
            '현재투자성향정보 조회
            DATAMANAGER.RequestTranData("obcsb_acif_801r")
        Else
            User_SharedData_Set("init")
            Form.SendReturnToParent("MBBDM85140", sRet)
            Form.CloseForm()	
        End If
	
    'ElseIf sKeyName == "MBBDM85146" Then
        'sRet. ok.완료 null.취소(현재화면(계좌정보입력 또는 설문진단)에머무름) 또는 그냥닫음	
        'If sRet == "ok" Then
            '(처리한)현재투자성향 재조회후 종료
            'DATAMANAGER.RequestTranData("obcsb_acif_801r_1")
        'Else
            'User_SharedData_Set("init")
            'Form.SendReturnToParent("MBBDM85140", sRet)
            'Form.CloseForm()
        'End If 
	'21.09.14 JHY START (v0004)
	'투자성향진단 재진단 사유 입력 완료
    ElseIf sKeyName == "close_mbonl81010_p15" then
	    if sRet <> "" then
		    DATAMANAGER.ClearInputData(0, "obcsb_acif_712a")
		    Set712Input("obcsb_acif_712a")
		    
		    ' 재진단 사유는 여기서 넣어줌
		    Dim tReason
		    tReason = split(sRet, "★")
		    
		    if tReason <> "" and tReason <> NULL then
			    if tReason[0] <> NULL and tReason[0] <> "" then
				    DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS_CODE" , 0 , tReason[0])
			    end if
			    
			    if tReason[1] <> NULL and tReason[1] <> "" then
				    DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS" , 0 , tReason[1])
			    end if
		    end if
		    
		    DATAMANAGER.RequestTranData("obcsb_acif_712a")
		end if
	'21.09.14 JHY END
	
	'신규고객 투자자정보확인서 등록 안내 팝업
	ElseIf sKeyName == "mbbdm85140_p2" Then
		If sRet == "Y" Then
			Form.OpenPopup("mbbdm85141" , "NEW" , "")
		ElseIf sRet == "N" Then
			User_SharedData_Set("init")
			Form.SendReturnToParent("MBBDM85140", "")
			Form.CloseForm()
		End If
	
	'기존고객 투자권유불원 팝업 리턴
	ElseIf sKeyName == "mbbdm85140_p3" Then
		If sRet <> "" and sRet <> null Then
			'투자자정보등록
			If sRet == "Change" Then
				Form.OpenPopup("mbbdm85141" , "NEW" , "")
			Else
				User_KYC_Proc()
			End If
		End If
    End If
End Sub
