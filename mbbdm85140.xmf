'============================================================================
Function User_KYC_Proc()
    '투자성향 등급정보 체크대상 상품 가입이 아닌경우, 정상종료
    If BDM_PRCD100 <> "Y" And BDM_PRCD200 <> "Y" And BDM_PRCD101 <> "Y" And BDM_PRCD135 <> "Y" And g_BDM_ISA_PROD_TYPE <> "3" And BDM_PRCD131 <> "Y" And BDM_PRCD118RP <> "Y" And BDM_PRCD100F <> "Y"  Then	'v0006 중개형 ISA 추가
        'v0005 5등급상품 개설시에도 투자권유희망여부 확인서 출력
        If BDM_PRCD100F == "Y" Or BDM_PRCD118RP == "Y" Or BDM_PRCD131 == "Y" Then
            If (g_APLY_KYC_INVT_RCMD_CLS_CODE == "3") or (g_APLY_KYC_INVT_RCMD_CLS_CODE == "4") Then
                Form.OpenPopup("mbbdm85147", "", "")		
			  Exit Function
            End If
        End If
	
        Form.SendReturnToParent("MBBDM85140", "ok")
        Form.CloseForm()
    Else
		
        '처리건수 설정
        g_713rPros_Cnt = 0
        If BDM_PRCD100F == "Y" Then			'금상전용
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
        If BDM_PRCD118RP == "Y" Then			'CMA
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
        If BDM_PRCD131 == "Y" Then			'연금저축
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
        If BDM_PRCD100 == "Y" Then
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
        If BDM_PRCD200 == "Y" Then
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If	
        'v0006 sta
        If BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3" Then
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
        'v0006 fin
        If BDM_PRCD101 == "Y" Then
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
        If BDM_PRCD135 == "Y" Then
            g_713rPros_Cnt = g_713rPros_Cnt + 1
        End If
	
        '처리구분 설정
        '계좌가입순으로 주식매매->중개형ISA->선물옵션->해외파생 처리
	
		
        '중합매매-금상전용 > CMA > 연금저축 > 종합매매 > 다드림 > 중개형ISA > 선물옵션 > 해외파생 순서로 처리
	    g_713rPros_Gb = ""
        If BDM_PRCD100F == "Y" Then			'금상전용
            p100f = "Y"
        Else
            p100f = "N"	
        End If
        If BDM_PRCD118RP == "Y" Then			'CMA
            p118 = "Y"
        Else
            p118 = "N"	
        End If
        If BDM_PRCD131 == "Y" Then			'연금저축
            p131 = "Y"
        Else
            p131 = "N"	
        End If
        If BDM_PRCD100 == "Y" Then			'종합매매
            p100 = "Y"
        Else
            p100 = "N"
        End If
        If BDM_PRCD200 == "Y" Then			'다드림
            p200 = "Y"
        Else
            p200 = "N"
        End If	
        'v0006 sta
        If BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3" Then		'중개형ISA
            p140 = "Y"
        Else
            p140 = "N"
        End If	
        'v0006 fin 
        If BDM_PRCD101 == "Y" Then			'선물옵션
            p101 = "Y"
        Else
            p101 = "N"
        End If
        If BDM_PRCD135 == "Y" Then			'해외파생
            p135 = "Y"
        Else
            p135 = "N"
        End If
        
	
        '가입처리체크는 역순으로하므로, 개설순서에 맞춰 역순으로 조립
        'v0006 중개형ISA 추가	
        g_713rPros_Gb = p135..p101..p140..p100..p200..p131..p118..p100f

        DATAMANAGER.RequestTranData("obcsb_acif_713r")
    End If
End Function 



'============================================================================
Sub Form_OnFormInit()
    g_CurDate =  Form.GetSharedData("&HOST_DATE", 0) '현재일자

    User_SharedData_Set("init")
    
    g_RCNO_PIP           = Form.GetSharedData("BDM_RCNO_PIP"      , False)
    g_CUST_FULL_NAME     = Form.GetSharedData("BDM_NAME"         , False) 
    'g_BDM_ACNT_OPNG_CLCD = Form.GetSharedData("BDM_ACNT_OPNG_CLCD", False)    
    g_BDM_EXSN_CUST_YN   = Form.GetSharedData("BDM_EXSN_CUST_YN"  , False )  'Y.기존고객 N.신규고객
    g_BDM_REG_UNIQ_NO    = Form.GetSharedData("BDM_REG_UNIQ_NO"   , False)   'JMY_ADD
    g_BDM_MANG_BRCD      = Form.GetSharedData("BDM_MANG_BRCD"          , false)  '관리점
    
    BDM_PRCD100 = Form.GetSharedData("BDM_PRCD100", False )
    BDM_PRCD101 = Form.GetSharedData("BDM_PRCD101", False )
    BDM_PRCD135 = Form.GetSharedData("BDM_PRCD135", False )
    'v0006 sta
    BDM_PRCD133 = Form.GetSharedData("BDM_PRCD133", False )
    g_BDM_ISA_PROD_TYPE = Form.GetSharedData("BDM_ISA_PROD_TYPE", False ) 
    'v0006 fin
    
    BDM_WRAP = Form.GetSharedData("BDM_WRAP", False )
    BDM_PRCD131 = Form.GetSharedData("BDM_PRCD131", False )
    
    BDM_PRCD118RP	= Form.GetSharedData("BDM_PRCD118RP"	, False)	'v0005 CMA(증권형)가입여부
    BDM_PRCD100F	= Form.GetSharedData("BDM_PRCD100F"	, False)	'v0005 종합매매(금상전용)가입여부
    BDM_PRCD200	= Form.GetSharedData("BDM_PRCD200"	, False)	'다드림 계좌 개설여부
    
	'랩 계좌 또는 일임형ISA 단독개설시 투자성향 스킵
	If BDM_WRAP == "Y" And (BDM_PRCD100 == "N" And BDM_PRCD101 == "N" And BDM_PRCD135 == "N" And BDM_PRCD133 == "N" And BDM_PRCD118RP == "N" And BDM_PRCD100F == "N" And BDM_PRCD200 == "N" ) Then
		Form.SendReturnToParent("MBBDM85140", "ok")
		Form.CloseForm()
	ElseIf (BDM_PRCD133 == "Y" And g_BDM_ISA_PROD_TYPE == "2") And (BDM_WRAP == "N" And BDM_PRCD100 == "N" And BDM_PRCD101 == "N" And BDM_PRCD135 == "N" And BDM_PRCD118RP == "N" And BDM_PRCD100F == "N" And BDM_PRCD200 == "N" ) Then
		Form.SendReturnToParent("MBBDM85140", "ok")
		Form.CloseForm()
	Else
		'KYC고객정보조회(기존과동일처리용)
		DATAMANAGER.RequestTranData("obcsb_acif_701r")
	End If

'    'KYC고객정보조회(기존과동일처리용)
'    DATAMANAGER.RequestTranData("obcsb_acif_701r")
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "unable" Then
        'sRet=close/cancel
        'cancel로 들어와도 취소로 간주함
        User_SharedData_Set("init")
        Form.SendReturnToParent("MBBDM85140", "unable")  'unable
        Form.CloseForm()
    ElseIf sKeyName = "retry" Then
        User_SharedData_Set("init")
        Form.OpenPopup("mbbdm85141" , "NEW" , "")
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    If szTranID = "obcsb_acif_701r" Then
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO"           , 0, "NMET"     )
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0, g_RCNO_PIP )
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_TYPE_CODE" , 0, "01"       )

    ElseIf szTranID = "obaci_acct_072r" Then  'JMY_ADD
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0 , g_RCNO_PIP       )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"              )  '2.단계별조회
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_UNIQ_NO"       , 0 , g_BDM_REG_UNIQ_NO)
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , 2                )  '2단계 계좌상품정보단계로 조회

    ElseIf szTranID = "obcsb_acif_801r" Or szTranID = "obcsb_acif_801r_1" Then
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP" , 0, g_RCNO_PIP)

    ElseIf szTranID = "obcsb_acif_713r" Then
        'g_713rPros_Gb  = 주식매매여부&선물옵션여부&해외파생여부
        'g_713rPros_Cnt = 가입상품건수

        'v0006 중개형ISA 추가
        chkIdx = 0
        nowIdx = 0
        For i = 1 To 8
            nowIdx = i
            YN = Mid(g_713rPros_Gb,i,1)
            If YN == "Y" Then 
                chkIdx = chkIdx + 1
                If chkIdx == g_713rPros_Cnt Then
                    Exit For
                End If	
            End If
        Next

        g_PRCD = ""
        g_szAcc = ""
        If nowIdx == 1 Then
            g_PRCD = "135"
            g_szAcc = "01040"  '01040.해외파생가입
        ElseIf nowIdx == 2 Then
            g_PRCD = "101"
            g_szAcc = "01005"  '01005.선물옵션가입
        ElseIf nowIdx == 3 Then
            g_PRCD = "140"
            g_szAcc = "01053"  '중개형ISA가입
        ElseIf nowIdx == 4 Then
            g_PRCD = "100"
            g_szAcc = "01004"  '주식거래 가능한 종합매매계좌	    
        ElseIf nowIdx == 5 Then
            g_PRCD = "200"
            g_szAcc = "01054"  '다드림
        ElseIf nowIdx == 6 Then
            g_PRCD = "131"
            g_szAcc = "01050"  '연금저축
        ElseIf nowIdx == 7 Then
            g_PRCD = "118"
            g_szAcc = "01045"  'CMA
        ElseIf nowIdx == 8 Then
            g_PRCD = "100"
            g_szAcc = "01052"  '종합매매 금융상품전용
        End If

        DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "RCNO"                  , 0, "NMET"      )
        DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "RCNO_PIP"              , 0, g_RCNO_PIP  )	
        DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DOMN_CLCD"        , 0, "02"    	   )  '비대면 02
        DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "PRCD"                  , 0, g_PRCD      )
        DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "KYC_BSWR_DIV_CODE"     , 0, "03"	        ) 
        DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DIV_CODE"         , 0, g_szAcc     )

    End If
End Sub
'============================================================================
Sub DTAMANAGER_OnRequestTranTimeout(szTranID)
    'TR타임아웃 발생시, 부모창으로 돌아가 재처리할 수 있도록 종료처리
    User_SharedData_Set("init")
    Form.SendReturnToParent("MBBDM85140", "")
    Form.CloseForm()
End Sub
'============================================================================
Function ReturnEqEx() 
	'JMY if ( g_APLY_KYC_INVT_RCMD_CLS_CODE == "3" or g_APLY_KYC_INVT_RCMD_CLS_CODE == "4" ) and (g_APLY_KYC_INVT_RCMD_CLS_CODE <> g_REG_KYC_INVT_RCMD_CLS_CODE) Then
	'JMY 2단계 투자성향진단 후,
	If (g_REG_KYC_YN <> "Y" And ( g_APLY_KYC_INVT_RCMD_CLS_CODE == "3" or g_APLY_KYC_INVT_RCMD_CLS_CODE == "4" )) Then	
		return true
	'JMY 4단계 이어가기 투자성향진단 후,
	ElseIf (g_REG_KYC_YN == "Y" And ( g_APLY_KYC_INVT_RCMD_CLS_CODE == "3" or g_APLY_KYC_INVT_RCMD_CLS_CODE == "4" ) And (g_APLY_KYC_INVT_RCMD_CLS_CODE <> g_REG_KYC_INVT_RCMD_CLS_CODE)) Then	
		return true	
	Else
		return false
	End if
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obcsb_acif_701r" Then
        g_CSNO                   = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "CSNO"                   , 0)
        g_GRADE_CUST             = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
        g_KYC_INVT_RCMD_CLS_CODE = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0)  '=최종성향등급
        g_PXPR_RCNO_TYPE_CODE    = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO_TYPE_CODE"    , 0)
        g_PXPR_RCNO              = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO"              , 0)
        g_PXPR_NAME              = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "PXPR_NAME"              , 0)
        g_CUST_RLTS_CODE         = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "CUST_RLTS_CODE"         , 0)
        g_CUST_RLTS_ETC_CNTT     = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "CUST_RLTS_ETC_CNTT"     , 0)   
        g_szInvtRcmdGb           = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0)
        g_szWeakYN               = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "WEAK_YN"                , 0)
        g_SpclInvrYN             = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_SPCL_INVR_YN"       , 0)  '전문투자자여부

		'21.09.14 JHY START (v0004)
		g_nTryCnt = CDbl(DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_ACMP_TMNU"     , 0))
		'21.09.14 JHY END

        '투자성향진단 처리여부 조회 JMY_ADD
        DATAMANAGER.RequestTranData("obaci_acct_072r")
    
    ElseIf szTranID = "obaci_acct_072r" Then  'JMY_ADD
	    g_REG_KYC_YN = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "UI_INVT_INCL_ACMP_YN", 0)  '투자성향수행여부
		
        If g_REG_KYC_YN <> "Y" Then  '미수행
            '신규
            If g_BDM_EXSN_CUST_YN <> "Y" Then
'                Form.OpenPopup("mbbdm85141", "NEW", "")
				Form.OpenPopupAnimation("mbbdm85140_p2", "", "", "2")		
            '기존고객
            Else
                '현재투자성향정보 조회
                 DATAMANAGER.RequestTranData("obcsb_acif_801r")
            End If	    
        Else
            g_REG_KYC_GRAD       = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "KYC_INVT_INCL_GRAD_CODE" , 0)  'KYC투자성향등급코드
            g_REG_PROD_BRAD      = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "KYC_PROD_GRAD_CODE"      , 0)  'KYC상품등급코드
            g_REG_UNFIT_YN       = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "UNFIT_YN"                , 0)  '부적합여부
            g_REG_DVPD_KYC_GRAD  = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "FTOT_INVT_INCL_GRAD_CODE", 0)  '선물옵션투자성향등급코드
            g_REG_DVPD_PROD_GRAD = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "FTOT_PROD_GRAD_CODE"     , 0)  '선물옵션상품등급코드
            g_REG_DVPD_UNFIT_YN  = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "FTOT_UNFIT_YN"           , 0)  '선물옵션부적합여부
            g_REG_WEAK_FNNC_YN   = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "WEAK_FNNC_SMAL_VISA_YN"  , 0)  '취약금융소비자여부	
		   g_REG_KYC_INVT_RCMD_CLS_CODE = DATAMANAGER.GetDataValue(0, "obaci_acct_072r", "OutBlock5", "KYC_INVT_RCMD_CLS_CODE" , 0)  'KYC투자권유구분코드	 
	    
            '현재투자성향정보 조회
            DATAMANAGER.RequestTranData("obcsb_acif_801r")
        End If

    ElseIf szTranID = "obcsb_acif_801r" Or szTranID = "obcsb_acif_801r_1" Then
        g_MtrtDate            = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_VALD_PRD_MTRT_DATE"  , 0)  '유효기간만기일
        g_RegDate             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STND_DATE"               , 0)  '최근설문등록일자
        g_KYC_GRAD            = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0)  'KYC투자성향등급코드(=적용투자성향등급)
        g_APLY_KYC_GRAD       = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0)  'KYC투자성향등급코드(=적용투자성향등급)
        g_TDAY_KYC_GRAD       = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TDAY_PSNT_KYC_GRAD"      , 0)  '당일투자성향등급
        g_APLY_WEAK_FNNC_YN   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WEAK_YN"                 , 0)  '취약금융소비자여부	
        g_APLY_KYC_INVT_RCMD_CLS_CODE	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0)  'KYC투자권유구분코드	
		
	
        '종합매매개설인 경우 'v0006 중개형ISA 추가
        If BDM_PRCD100 = "Y" Or BDM_PRCD200 = "Y" Or (BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3")Then
            g_APLY_KYC_GRAD       = g_APLY_KYC_GRAD  '투자성향등급
            g_APLY_PROD_GRAD      = "01"             'KYC상품등급코드
        End If
	
        '파생상품개설인 경우
        If BDM_PRCD101 = "Y" Or BDM_PRCD135 = "Y" Then
            g_APLY_DVPD_KYC_GRAD   = g_APLY_KYC_GRAD  '선물옵션투자성향등급코드
            g_APLY_DVPD_PROD_GRAD  = "01"             '선물옵션상품등급코드
            '당일투자성향등급=정보미제공인 경우, obcsb_acif_713r으로 체크
            'If g_TDAY_KYC_GRAD == "00" Or g_TDAY_KYC_GRAD == "" Or g_TDAY_KYC_GRAD == null Then  
            '    g_APLY_DVPD_KYC_GRAD  = g_TDAY_KYC_GRAD  
            'End If
        End If

	   '현재기준으로 공유변수 Set
        Form.SetSharedData("BDM_APLY_KYC_GRAD"      , g_KYC_GRAD             )  '투자성향등급
        Form.SetSharedData("BDM_KYC_GRAD"           , g_APLY_KYC_GRAD        )  '투자성향등급
        Form.SetSharedData("BDM_PROD_GRAD"          , g_APLY_PROD_GRAD       )  '상품등급
        Form.SetSharedData("BDM_DVPD_KYC_GRAD"      , g_APLY_DVPD_KYC_GRAD   )  '파생상품투자성향등급
        Form.SetSharedData("BDM_DVPD_PROD_GRAD"     , g_APLY_DVPD_PROD_GRAD  )  '파생상품상품등급
        Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"     , g_APLY_KYC_INVT_RCMD_CLS_CODE  )  'KYC투자권유구분코드
	
        If szTranID = "obcsb_acif_801r" Then
			
            '앞에서 등록된 정보있는경우
            If g_REG_KYC_YN = "Y" Then
                ReKYC = "N"
			  'v0006 중개형 ISA 추가
                If (BDM_PRCD100 = "Y" Or BDM_PRCD200 = "Y" Or (BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3") Or BDM_PRCD131 == "Y" Or BDM_PRCD118RP == "Y" Or BDM_PRCD100F == "Y") And ((g_REG_KYC_GRAD <> g_APLY_KYC_GRAD ) Or (ReturnEqEx() == True)) Then
                   ReKYC = "Y"
                End If
                If (BDM_PRCD101 = "Y" Or BDM_PRCD135 = "Y") And ((g_REG_DVPD_KYC_GRAD <> g_APLY_KYC_GRAD) Or (ReturnEqEx() == True)) Then
                   ReKYC = "Y"
                End If
          '      '파생상품가입시, 당일성향등급 정보미제공 가입불가 체크
          '      If (BDM_PRCD101 = "Y" Or BDM_PRCD135 = "Y") And ((g_TDAY_KYC_GRAD == "00" Or g_TDAY_KYC_GRAD == "" Or g_TDAY_KYC_GRAD == NULL) Or (ReturnEqEx() == True)) Then
          '         ReKYC = "Y"
          '      End If

                '종합매매,선물옵션,해외파생 상품에대해 등급이 변경이 있는경우, 가입가능여부 다시 체크(전문투자자 제외) 'v0006 중개형ISA 추가
                '신규고객도 제외(비교대상 등급이 없으므로)
                If g_BDM_EXSN_CUST_YN == "Y" And ( g_SpclInvrYN <> "Y" And ReKYC = "Y" ) Then
                    '고객 투자성향 등급정보 체크(계좌가입) 처리
                    User_KYC_Proc()
                Else
                    '변경사항이 없는 경우, 앞에서 등록된 정보로 설정하고 정상종료
                    Form.SetSharedData("BDM_KYC_GRAD"       , g_REG_KYC_GRAD       )  '투자성향등급
                    Form.SetSharedData("BDM_PROD_GRAD"      , g_REG_PROD_BRAD      )  '상품등급
                    Form.SetSharedData("BDM_UNFIT_YN"       , g_REG_UNFIT_YN       )  '부적합여부
                    Form.SetSharedData("BDM_DVPD_KYC_GRAD"  , g_REG_DVPD_KYC_GRAD  )  '파생상품투자성향등급
                    Form.SetSharedData("BDM_DVPD_PROD_GRAD" , g_REG_DVPD_PROD_GRAD )  '파생상품상품등급
                    Form.SetSharedData("BDM_DVPD_UNFIT_YN"  , g_REG_DVPD_UNFIT_YN  )  '파생상품부적합여부
                    Form.SetSharedData("BDM_WEAK_FNNC_YN"   , g_REG_WEAK_FNNC_YN   )  '취약금융소비자여부
                    Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"   , g_REG_KYC_INVT_RCMD_CLS_CODE   )  'KYC투자권유구분코드 
				
                    Form.SendReturnToParent("MBBDM85140", "ok")
                    Form.CloseForm()	
                End If
            '앞에서 등록된 정보없는경우
            Else
                '기존고객
                If g_BDM_EXSN_CUST_YN = "Y" Then
                    '전문투자자는 설문등록/부적합여부체크 없음.정상 리턴
                    If g_SpclInvrYN == "Y" Then
                        '정상처리종료
                        Form.SendReturnToParent("MBBDM85140", "ok")
                        Form.CloseForm()

                       '전문투자자 아닌경우 설문진단
                    Else 'ElseIf CInt(g_CurDate) == CInt(g_RegDate) Then
                        g_ReChkYN = Form.GetSharedData("BDM_CHK_KYC", False)
                        If g_ReChkYN == "Y" Then
                            '고객 투자성향 등급정보 체크(계좌가입) 처리
                            User_KYC_Proc()
                        Else
						If g_APLY_KYC_INVT_RCMD_CLS_CODE == "4" Then
                                Form.OpenPopupAnimation("mbbdm85140_p3", g_APLY_KYC_INVT_RCMD_CLS_CODE, "","2")
						
						'스킵 추가 LJH
'						ElseIf BDM_PRCD100 = "Y" Or (BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3") Or BDM_PRCD101 = "Y" Or BDM_PRCD135 = "Y" Or BDM_PRCD131 == "Y" Then
'							If g_APLY_KYC_GRAD == "01" Then
'								'정상처리종료
'							    Form.SendReturnToParent("MBBDM85140", "ok")
'							    Form.CloseForm()
'							Else
'								Form.OpenPopupAnimation("mbbdm85140_p1", "", "","2")
'							End If
		                   Else
							 User_KYC_Proc()
'                                Form.OpenPopupAnimation("mbbdm85140_p1", "", "","2")
                            End If
				
                            '설문진단popup
                            '기존고객인 경우, 투자성향진단 유형 선택 popup 무조건
'                            If g_TDAY_KYC_GRAD == "00" Or g_TDAY_KYC_GRAD == "" Or g_TDAY_KYC_GRAD == NULL Then '당일 진단내역 미존재시 바로 설문등록
'                                Form.OpenPopup("mbbdm85141" , "NEW" , "")
'		                   Else
'                                Form.OpenPopupAnimation("mbbdm85140_p1", "", "","2")
'                            End If
                        End If
                    End If

                '신규고객(투자성향 설문응답하고 난뒤 체크됨)
                Else  'If g_BDM_EXSN_CUST_YN <> "Y" Then
                    '고객 투자성향 등급정보 체크(계좌가입) 처리
                    User_KYC_Proc()	    
                End If 
	       End If
        Else
            '정상처리종료
            Form.SendReturnToParent("MBBDM85140", "ok")
            Form.CloseForm()
        End If

    ElseIf szTranID = "obcsb_acif_713r" Then

        tmp_KYC_GRAD  = DATAMANAGER.GetDataValue(0, "obcsb_acif_713r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0)  'KYC투자성향등급코드
        tmp_PROD_GRAD = DATAMANAGER.GetDataValue(0, "obcsb_acif_713r", "OutBlock1", "KYC_PROD_GRAD_CODE"      , 0)  'KYC상품등급	
        tmp_KYC_INVT_RCMD_CLS_CODE = DATAMANAGER.GetDataValue(0, "obcsb_acif_713r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0)  'KYC권유구분코드

        '종합매매개설인 경우 'v0006중개형ISA추가
        If BDM_PRCD100 = "Y" Or BDM_PRCD200 = "Y" Or (BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3") Or BDM_PRCD131 == "Y" Or BDM_PRCD118RP == "Y" Or BDM_PRCD100F == "Y" Then
            g_APLY_KYC_GRAD       = tmp_KYC_GRAD
            g_APLY_PROD_GRAD      = tmp_PROD_GRAD
            g_APLY_KYC_INVT_RCMD_CLS_CODE = tmp_KYC_INVT_RCMD_CLS_CODE
        End If

        '파생상품개설인 경우
        If BDM_PRCD101 = "Y" Or BDM_PRCD135 = "Y" Then
            g_APLY_DVPD_KYC_GRAD   = tmp_KYC_GRAD
            g_APLY_DVPD_PROD_GRAD  = tmp_PROD_GRAD
            g_APLY_KYC_INVT_RCMD_CLS_CODE = tmp_KYC_INVT_RCMD_CLS_CODE
        End If

        '처리된기준으로 공유변수 Set
        Form.SetSharedData("BDM_APLY_KYC_GRAD"      , tmp_KYC_GRAD           )  '(적용)투자성향등급
        Form.SetSharedData("BDM_KYC_GRAD"           , g_APLY_KYC_GRAD        )  '투자성향등급
        Form.SetSharedData("BDM_PROD_GRAD"          , g_APLY_PROD_GRAD       )  '상품등급
        Form.SetSharedData("BDM_DVPD_KYC_GRAD"      , g_APLY_DVPD_KYC_GRAD   )  '파생상품투자성향등급
        Form.SetSharedData("BDM_DVPD_PROD_GRAD"     , g_APLY_DVPD_PROD_GRAD  )  '파생상품상품등급

       '처리대상건수 조정
        g_713rPros_Cnt = g_713rPros_Cnt - 1

        '가입여부 체크====================================================
        Form.SetSharedData("BDM_WEAK_FNNC_YN"  , g_APLY_WEAK_FNNC_YN   )  '취약금융소비자여부
        Form.SetSharedData("BDM_UNFIT_YN"      , g_APLY_UNFIT_YN       )  '부적합여부
        Form.SetSharedData("BDM_DVPD_UNFIT_YN" , g_APLY_DVPD_UNFIT_YN  )  '파생상품부적합여부        
		
        'KYC투자권유구분코드
        Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"     , g_APLY_KYC_INVT_RCMD_CLS_CODE  )  
	
        pros = DATAMANAGER.GetDataValue(0,  "obcsb_acif_713r" , "OutBlock1" , "PROS_YN" , 0 )
'		Form.ShowAlert("pros", pros)
        Select Case pros
        Case "S"  '취약금융소비자
            '투자성향 등급정보 체크대상 상품 가입이 아닌경우, 정상종료	'v0006 중개형ISA 추가
            If BDM_PRCD100 <> "Y" And BDM_PRCD200 <> "Y" And BDM_PRCD101 <> "Y" And BDM_PRCD131 <> "Y" And BDM_PRCD135 <> "Y" And g_BDM_ISA_PROD_TYPE <> "3" Then 'v0009 131연금저축추가
