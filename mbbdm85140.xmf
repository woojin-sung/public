'============================================================================
Function Set_Reg_Data()
	' 21.09.02 JHY START (v0004)
	if g_tQuestion == NULL then
		g_tQuestion As Integer
	end if
	
	Dim nDataCnt
	
	nDataCnt = CDbl(DATAMANAGER.GetDataCount(0, "obcsb_acif_701r", "OutBlock2"))
	
	Dim nQNum, nAnswerNum, szRspnYn
	
	for i = 0 to nDataCnt -1
		nQNum		= CDbl(DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock2", "QUES_QSIT_NO", i)) '문항 번호
		nAnswerNum    = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock2", "ITEM_NO_VAL" , i) ' 답변 번호
		szRspnYn		= DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock2", "RSPN_SLCT_YN" , i)  '1.Y	
		
		' 사용자가 선택한 응답이면 g_tQuestion(응답 항목 가지고 있는 배열) 에 저장
		if CDbl(szRspnYn) == 1 then
			if nQNum > 0 then
				g_tQuestion[nQNum] = nAnswerNum
				
				' 복수 선택 가능한 8번 문항은 테이블에 따로 담아줌
				if CDbl(nQNum) == 8 then
					Dim nIndex
					nIndex = CDbl(nAnswerNum) - 1
					
					if nIndex >=0 then
						g_tQ8Answer[nIndex] = szRspnYn
					end if
				end if
			end if
		end if
	next
	' 21.09.02 JHY END (v0004)
End Function 

'============================================================================
Function Set712Input()
	Set_Reg_Data()        
	' 21.09.02 JHY START (v0004)
	Dim nQCnt, szAnswer ' 문항 수, 답변번호
	Dim nIndex '인풋 배열 인덱스
	
	nIndex = 0
	nQCnt = Ubound(g_tQuestion)
	
	for i = 0 to CDbl(nQCnt)
		if i == 7 then ' 복수 응답 가능 8번 문항 
			for j = 0 to CDbl(Ubound(g_tQ8Answer))
				if g_tQ8Answer[j] <> NULL then
					Dim szChkState
					szChkState = g_tQ8Answer[j]
					
					if CDbl(szChkState) == 1 then
						DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "QUES_QSIT_NO", nIndex , i+1) 
						DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "ITEM_NO_VAL" , nIndex , j)
						DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "RSPN_SLCT_YN", nIndex , "Y")
						
						nIndex = nIndex + 1
					end if
				end if
			next
		else ' 복수 응답 불가 문항들
			if g_tQuestion[i] == NULL then
				szAnswer = ""
			else
				szAnswer = g_tQuestion[i]
			end if
			
			DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "QUES_QSIT_NO", nIndex , i+1) 
			DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "ITEM_NO_VAL" , nIndex , szAnswer)
			DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "RSPN_SLCT_YN", nIndex , "Y")
			
			nIndex = nIndex + 1
		end if
    next 
    '21.09.01 JHY END    
    
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CONT_CLS_CODE" , 0 , "6")
    
    If g_GRADE_CUST == "00" Or g_GRADE_CUST == "" Or g_GRADE_CUST == NULL Then '기존 투자성향진단내역이 없으면
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
    Else'기존 투자성향진단내역이 있으면
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE" , 0 , "3" ) 'v0002 3.동일로 변경 "2" )
    End If
   
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO"                   , 0 , "NMET"..g_BDM_MANG_BRCD) '비대면
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_PIP"               , 0 , g_RCNO_PIP)    
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_TYPE_CODE"         , 0 , "01")
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CSNO"                   , 0 , g_CSNO) 
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_CLS_CODE"          , 0 , "1") '개인
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_FULL_NAME"         , 0 , g_CUST_FULL_NAME)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_RCNO_TYPE_CODE"    , 0 , g_PXPR_RCNO_TYPE_CODE)
