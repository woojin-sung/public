Function User_SharedData_Set(gb)
    '투자성향 정보 ---------------------------------------------------------
    If gb == "init" then	
        g_KYC_GRAD            = ""  '(현재)KYC투자성향등급코드
        g_APLY_KYC_GRAD       = ""  '(현재)KYC투자성향등급코드
        g_APLY_PROD_GRAD      = ""  '(현재)KYC상품등급코드
        g_APLY_UNFIT_YN       = ""  '(현재)부적합여부
        g_APLY_DVPD_KYC_GRAD  = ""  '(현재)선물옵션투자성향등급코드
        g_APLY_DVPD_PROD_GRAD = ""  '(현재)선물옵션상품등급코드
        g_APLY_DVPD_UNFIT_YN  = ""  '(현재)선물옵션부적합여부
        g_APLY_WEAK_FNNC_YN   = ""  '(현재)취약금융소비자여부
        g_APLY_KYC_INVT_RCMD_CLS_CODE = ""	'(현재)KYC투자권유구분코드
	
        'Form.SetSharedData("BDM_CHK_KYC"            , ""        ) 
        Form.SetSharedData("BDM_APLY_KYC_GRAD"      , ""        )  '(적용)투자성향등급
        Form.SetSharedData("BDM_KYC_GRAD"           , ""        )  '투자성향등급
        Form.SetSharedData("BDM_PROD_GRAD"          , ""        )  '상품등급
        Form.SetSharedData("BDM_UNFIT_YN"           , ""        )  '부적합여부
        Form.SetSharedData("BDM_DVPD_KYC_GRAD"      , ""        )  '파생상품투자성향등급
        Form.SetSharedData("BDM_DVPD_PROD_GRAD"     , ""        )  '파생상품상품등급
        Form.SetSharedData("BDM_DVPD_UNFIT_YN"      , ""        )  '파생상품부적합여부
        Form.SetSharedData("BDM_WEAK_FNNC_YN"       , ""        )  '취약금융소비자여부        
        Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , ""        )  'KYC투자권유구분코드
	 

'    Else
'정보처리후,바로 설정
'        Form.SetSharedData("BDM_APLY_KYC_GRAD"      , g_KYC_GRAD             )  '투자성향등급
'        Form.SetSharedData("BDM_KYC_GRAD"           , g_APLY_KYC_GRAD        )  '투자성향등급
'        Form.SetSharedData("BDM_PROD_GRAD"          , g_APLY_PROD_GRAD       )  '상품등급
'        Form.SetSharedData("BDM_UNFIT_YN"           , g_APLY_UNFIT_YN        )  '부적합여부
'        Form.SetSharedData("BDM_DVPD_KYC_GRAD"      , g_APLY_DVPD_KYC_GRAD   )  '파생상품투자성향등급
'        Form.SetSharedData("BDM_DVPD_PROD_GRAD"     , g_APLY_DVPD_PROD_GRAD  )  '파생상품상품등급
'        Form.SetSharedData("BDM_DVPD_UNFIT_YN"      , g_APLY_DVPD_UNFIT_YN   )  '파생상품부적합여부
'        Form.SetSharedData("BDM_WEAK_FNNC_YN"       , g_APLY_WEAK_FNNC_YN    )  '취약금융소비자여부
