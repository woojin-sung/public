	<CONTROL_INFO>
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="35" outline="0000" designorder="1" ly_vert="10,15,360,655,1" >
			<COL_INFO ly_vert_width="7,353" />
			<ROW_INFO ly_vert_height="20,10,20,20,10,20,20,20,20,30,20,20,20,10,20,20,5,20,20,10,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="·" fontsize="5" impidxs="" />
				<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="거래신청 가능시간 : 국내 영업일 기준 09:00 ~ 15:00" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,1,1,1" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="·" fontsize="5" impidxs="" />
				<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="신청금액은 증거금을 의미하며, CDS종목 증거금율에" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="따라 CDS 계약(액면)금액이 계산됩니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,4,1,4" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,5,0,5" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="(예시)" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,6,0,6" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="- 신청금액(증거금) : 1억원" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,7,0,7" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="- CDS증거금비율 : 50%" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,8,0,8" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="  → CDS 계약(액면)금액 2억원" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,9,0,9" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,9,1,9" valign="0" halign="0" line="0,0" caption="     (최대투자손실금액 2억원)" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,10,0,10" line="0,0" caption="·" fontsize="5" impidxs="" />
				<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="CDS 상품의 이자수익은 CDS 프리미엄과 현금증거금" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,11,0,11" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="이자가 있으며, 각 이자수익의 산출방식은 아래와" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,12,0,12" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="같습니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,13,0,13" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,13,1,13" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,14,0,14" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="- CDS 프리미엄 이자수익" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,15,0,15" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="= 계약(액면)금액*CDS 프리미엄이율(%) / 365*투자기간" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,16,0,16" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,16,1,16" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,17,0,17" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="- 현금증거금 이자수익" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,18,0,18" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="= 증거금*증거금이율(%) / 365*투자기간" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,19,0,19" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,19,1,19" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,20,0,20" line="0,0" caption="·" fontsize="5" impidxs="" />
				<CELL cell_ly="1,20,1,20" halign="0" line="0,0" caption="투자수익률은 신청금액(증거금) 기준입니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,21,0,21" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,21,1,21" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,22,0,22" line="0,0" caption="·" fontsize="5" impidxs="" />
				<CELL cell_ly="1,22,1,22" halign="0" line="0,0" caption="CDS 프리미엄 이자수익은 비과세되며, 현금증거금 " fontsize="-1" impidxs="" />
				<CELL cell_ly="0,23,0,23" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="이자수익은 소득세법상 과세대상으로서 지급시점에" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,24,0,24" line="0,0" fontsize="5" impidxs="" />
				<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="원천징수됩니다." fontsize="-1" impidxs="" />
