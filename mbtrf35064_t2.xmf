	<SCRIPT_INFO _len="3378" _ulen="3122" >
'============================================================================
' 01. 화 면 명 : 선옵 가상체결증거금 조회 미체결내역
' 02. 화면설명 : 선옵 가상체결증거금 조회 미체결내역 그리드
' 03. 작    성 : 2016.01.12 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'일련번호
Dim g_szAccountPassword		'비밀번호

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_701r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_701r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_701r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
	DATAMANAGER.RequestTranData("obtrf_cntg_701r")
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "NonTighteningHistory" then
		Dim szList
		szList = Split(sParam, "★")
		g_nAccountNumber = szList(0)
		g_nAccountSerialNumber = szList(1)
		g_szAccountPassword = szList(2)
		TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber)
	end if
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrf_cntg_701r" then
		for i=0 to DATAMANAGER.GetDataCount(0,"obtrf_cntg_701r", "OutBlock1")-1
			Dim szCodeOne		'호가유형코드
			Dim szCodeTwo 	'매매구분코드
			Dim szDataOne		'받은 호가유형코드를 변환하여 주문구분명으로 변환
			Dim szDataTwo 	'받은 매매구분코드를 변환하여 매매구분명으로 변환
			szDataOne = ""
			szDataTwo = ""
			
			szCodeOne = DATAMANAGER.GetDataValue(0, "obtrf_cntg_701r", "OutBlock1", "ASPR_TYPE_CODE" , i)
			szCodeTwo = DATAMANAGER.GetDataValue(0, "obtrf_cntg_701r", "OutBlock1", "DEAL_CLS_CODE", i)
			
			szDataOne = Form.GetMetaData("호가유형코드", szCodeOne)
			szDataTwo = Form.GetMetaData("매매구분코드", szCodeTwo)
			
			grdTighteningHistory.SetCellData( "bd_cell2", i, szDataOne )
			grdTighteningHistory.SetCellData( "bd_cell3", i, szDataTwo )
		next		
	end if		
End Sub

	</SCRIPT_INFO>
