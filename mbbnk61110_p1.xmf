--===========================================================================
--===========================================================================
Function f_ReturnData(szCode, szName)
	Form.SendReturnToParent("RETURN_GROUP" , szCode & "★" & szName)
	Form.CloseForm()
End Function


'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("obrts_ccfo_017r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrts_ccfo_017r" then
		Dim sName, sCode
		
		if Trim(edtName.caption) == "" or edtName.caption == null then
			sName = "%"
		elseif Len(Trim(edtName.caption)) <= 48 then
			sName = "%" & edtName.caption & "%"
		elseif Len(Trim(edtName.caption)) == 49 then
			sName = edtName.caption & "%"
		else
			sName = edtName.caption
		end if
		
		if Trim(edtcode.caption) == "" or edtcode.caption == null then
			sCode = "%"
		elseif Len(Trim(edtcode.caption)) <= 8 then
			sCode = "%" & edtcode.caption & "%"
		elseif Len(Trim(edtcode.caption)) == 9 then
			sCode = edtcode.caption & "%"
		else
			sCode = edtcode.caption
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEPS_SCRT_CLS_CODE", 0, "01" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SECO_BRCD" , 0, sCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SECO_BRNM" , 0, sName )
	end if
End Sub

'============================================================================
Sub edtName_OnEditComplete()
	DATAMANAGER.RequestTranData("obrts_ccfo_017r")
End Sub

'============================================================================
Sub edtcode_OnEditComplete()
	DATAMANAGER.RequestTranData("obrts_ccfo_017r")
End Sub

'============================================================================
Sub grdList0_OnClickUp(lRow, szCellID)
	Dim szName, szCode
	szCode = grdList0.GetCellData( "bd_cell0", lRow )
	szName = grdList0.GetCellData( "bd_cell1", lRow )

	Form.SendReturnToParent("RETURN_GROUP" , szCode & "★" & szName)
	Form.CloseForm()
	
End Sub



'============================================================================
Sub grdList0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obrts_ccfo_017r" )
End Sub

