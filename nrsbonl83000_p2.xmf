<ROOT>
	<MAP_INFO scrno="83000" scrname="권리CFD매매구분선택창" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="BtnClose" btnimage="alpha.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBG" autosize="1" imgpath="popup_bg.9" ly_vert="0,356,375,296,1" />
		<BUTTON name="btnSave" caption="적용" fontsize="1" btnimage="btn_20.9" ly_vert="0,587,375,60,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="매매구분을 선택해 주세요." bgcolor="092:185046046" halign="1" ly_vert="0,356,375,60,1" />
		<RADIOGROUP name="RgBuySell" fontsize="-2" buttonshape="1" buttonsnumber="3" initselectionuse="1" initselection="0" ly_vert="20,426,337,44,1" >
			<RADIO_INFO>
				<RADIO no="0" text="전체" radioimage="input_06.9.png" transfervalue="%" position="0,0,105,44" />
				<RADIO no="1" text="매수" radioimage="input_06.9.png" transfervalue="01" position="115,0,105,44" />
				<RADIO no="2" text="매도" radioimage="input_06.9.png" transfervalue="02" position="230,0,105,44" />
			</RADIO_INFO>
		</RADIOGROUP>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1770" _ulen="1666" >
'============================================================================
' 화 면 명 : 권리화면_매매유형
' 화면설명 : 권리화면의 매매유형선택 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szBuySellCd
g_szBuySellCd = "%"

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	if szData <> "" then
		g_szBuySellCd = szData	
		if g_szBuySellCd == "01" then      '01	매수
			RgBuySell.currentindex = 1
		elseif g_szBuySellCd == "02" then  '02	매도
			RgBuySell.currentindex = 2
		end if 		
	else
		'디폴트 전체
		RgBuySell.currentindex = 0
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("SELLBUY_SET", g_szBuySellCd)
End Sub

'============================================================================
Sub RgBuySell_OnClick(nIndex)

	if nIndex == 1 then      '01 매수
		g_szBuySellCd = "01" 
	elseif nIndex == 2 then  '02 매도
		g_szBuySellCd = "02" 	
	else
		g_szBuySellCd = "%" 	
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	'매매유형선택 알림
	Form.SendReturnToParent("SELLBUY_SET", g_szBuySellCd)
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
</ROOT>