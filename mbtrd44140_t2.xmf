'	end if
End Sub

'============================================================================
Function f_SetTickSize(szData)
	Dim szTickSize, tData
	szTickSize = szData
	
	if szData <> nil and szData <> "" then
		tData = Split(szData, ".")
		szTickSize = tData(0)
		
		if UBound(tData) > 0 then
			if tData(1) <> "" then
				szTickSize = szTickSize & "." & tData(1)
			end if
			
			while right(szTickSize,1) = "0"
				szTickSize = left(szTickSize,Len(szTickSize)-1)
			wend
		end if
	end if
	
	return szTickSize
End Function 
