Dim g_szACNO
Dim g_szASNO

'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "obtrd_acnt_002r" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" then
		if sParam <> "" and sParam <> null then
			Dim tSplitData
			tSplitData = Split(sParam, "★")
			g_szACNO = tSplitData[0]
			g_szASNO = tSplitData[1]
			
			DATAMANAGER.RequestTranData( "obtrd_acnt_002r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	grdList.SetClear()
	
	if szTranID = "obtrd_acnt_002r" then
		'DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "BSOP_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ) )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "BSOP_DATE" , 0 , " " )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "ASNO" , 0 , g_szASNO )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_acnt_002r" then
		Dim nCnt
		Dim szTDAY_DEPS_FAMT, szENTM_FMARG, szMNTN_FMARG, szWTMN_ABLE_FAMT, szDEPS_ASET_VLTN_FAMT, szSPLM_FMARG, szODER_ABLE_FAMT, szSTND_EXRT, szCRCD
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtrd_acnt_002r", "OutBlock2" )
		
		for i = 0 to nCnt - 1 step 1
			szTDAY_DEPS_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "TDAY_DEPS_FAMT" , i)
			szENTM_FMARG = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "ENTM_FMARG" , i)
			szMNTN_FMARG = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "MNTN_FMARG" , i)
			szWTMN_ABLE_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "WTMN_ABLE_FAMT" , i)
			szDEPS_ASET_VLTN_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "DEPS_ASET_VLTN_FAMT" , i)
			szSPLM_FMARG = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "SPLM_FMARG" , i)
			szODER_ABLE_FAMT = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "ODER_ABLE_FAMT" , i)
			szSTND_EXRT = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "STND_EXRT" , i)
			szCRCD = DATAMANAGER.GetDataValue( false, "obtrd_acnt_002r", "OutBlock2", "CRCD" , i)
			
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell1", i, FormatNumber(szTDAY_DEPS_FAMT, 0))
				grdList.SetCellData("bd_cell2", i, FormatNumber(szENTM_FMARG, 0))
				grdList.SetCellData("bd_cell3", i, FormatNumber(szMNTN_FMARG, 0))
				grdList.SetCellData("bd_cell4", i, FormatNumber(szWTMN_ABLE_FAMT, 0))
				grdList.SetCellData("bd_cell5", i, FormatNumber(szDEPS_ASET_VLTN_FAMT, 0))
				grdList.SetCellData("bd_cell6", i, FormatNumber(szSPLM_FMARG, 0))
				grdList.SetCellData("bd_cell7", i, FormatNumber(szODER_ABLE_FAMT, 0))
'				grdList.SetCellData("bd_cell8", i, FormatNumber(szSTND_EXRT, 0))

				szSTND_EXRT = f_SetTickSize(szSTND_EXRT)
				grdList.SetCellData("bd_cell8", i, szSTND_EXRT)
			else
				grdList.SetCellData("bd_cell1", i, FormatNumber(szTDAY_DEPS_FAMT, 2))
				grdList.SetCellData("bd_cell2", i, FormatNumber(szENTM_FMARG, 2))
				grdList.SetCellData("bd_cell3", i, FormatNumber(szMNTN_FMARG, 2))
				grdList.SetCellData("bd_cell4", i, FormatNumber(szWTMN_ABLE_FAMT, 2))
				grdList.SetCellData("bd_cell5", i, FormatNumber(szDEPS_ASET_VLTN_FAMT, 2))
				grdList.SetCellData("bd_cell6", i, FormatNumber(szSPLM_FMARG, 2))
				grdList.SetCellData("bd_cell7", i, FormatNumber(szODER_ABLE_FAMT, 2))
'				grdList.SetCellData("bd_cell8", i, FormatNumber(szSTND_EXRT, 2))

				szSTND_EXRT = f_SetTickSize(szSTND_EXRT)
				grdList.SetCellData("bd_cell8", i, szSTND_EXRT)
			end if
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
