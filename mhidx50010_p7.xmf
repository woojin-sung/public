'============================================================================
' 01. 화 면 명 : HOME_실시간순위
' 02. 화면설명 : 실시간순위_국내
' 03. 작    성 : 
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCode			'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
End Function

'============================================================================
' Real_RequestData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Real_RequestData(szMk)
	DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		FormTab0.setTabDefaultImage("tab_03_o.9","alpha.9")
	else
		FormTab0.setTabHeaderImage("tab_00_o.9","alpha", 0)
	end if

	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_top50_002" then			'grd1에만 뿌리는 서비스
		grd1.rowcount = 5
		DATAMANAGER.RequestTranData("ohhts_1020_001r")
	else
		Pannel0.rowcount = 5
		
		for i = 0 to 4
			'순위 세팅
			Pannel0.setPropCardCell("caption","lblRank",i, i+1)	
			Pannel0.setPropCardCell("maxlinecnt","lblName",i,"2^-2")
			
			'라벨 색상 세팅 & 등락률 라벨 세팅 & 등락률 이미지 세팅(거래대금, 거래량 탭만)
			if szTranID == "ohhts_1703_002r" then
				szCtrt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "FID_PRDY_CTRT" , i)
				nVrssSign = CInt(Pannel0.GetCellValue("lblSign",i))
				
				Select Case nVrssSign
					Case 1, 2
						Pannel0.setPropCardCell("fgcolor","lblPr",i,"10")
						Pannel0.setPropCardCell("fgcolor","lblVrss",i,"10")
						Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"10")
						
						Pannel0.setPropCardCell("caption","lblCtrt",i,szCtrt)
						
						Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
						Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_red.9.png")
					Case 4, 5
						Pannel0.setPropCardCell("fgcolor","lblPr",i,"11")
						Pannel0.setPropCardCell("fgcolor","lblVrss",i,"11")
						Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"11")
						
						Pannel0.setPropCardCell("caption","lblCtrt",i,"-"..szCtrt)	'업체 서비스여서 -부호가 안내려옴
						
						Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
						Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_blue.9.png")
					Case Else
						Pannel0.setPropCardCell("fgcolor","lblPr",i,"12")
						Pannel0.setPropCardCell("fgcolor","lblVrss",i,"12")
						Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"12")
						
						Pannel0.setPropCardCell("caption","lblCtrt",i,szCtrt)
						
						Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
						Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_gray.9.png")
				End Select
			else
			
			'등락률 이미지 세팅(나머지 탭)
				szCtrtData = Pannel0.GetCellValue("lblCtrt",i)
				szCtrtData = CDbl(szCtrtData * 100)
				if CDbl(szCtrtData) > 0 then
					Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_red.9.png")
				elseif CDbl(szCtrtData) < 0 then
					Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_blue.9.png")
				else
					Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_gray.9.png")
				end if
				
			end if
			
			' 실시간 인블럭 세팅
			Dim szCd, szMk
			szCd =  Pannel0.GetCellValue("lblCode",i)
			
			if szCd <> "" then
				szMk = Form.GetItemCodeInfo(szCd, "market")
				if szMk <> "" then
					Set_Real_Input(szMk, i, szCd)
				end if
			end if
		next
		
		'실시간 호출
		Real_RequestData(szMk)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Pannel0.rowcount = 0
	DATAMANAGER.CancelRealData("ohhts_stck_incg")
	
	if szTranID == "ohhts_1020_001r" then
		g_nCount = 0
		for i = 0 to 4
			if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , i) <> "" then
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , g_nCount , grd1.GetCellData("bd_cell1", i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_ISCD" , g_nCount , grd1.GetCellData("bd_cell0", i))
				g_nCount = g_nCount + 1
				if g_nCount = 5 then
					exit for
				end if
			end if
		next
	
	elseif szTranID == "ohhts_1751_001r" then
		g_szMarginType = "11111"
		g_szEtfEtn = "00"
		g_szExceptItem = "0000000"
		nTab = CInt(FormTab0.currenttab)
		if nTab = 1 then
			DATAMANAGER.SetDataValue( 0 , "ohhts_1751_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE" , 0 , "7" )
		elseif nTab = 2 then
			DATAMANAGER.SetDataValue( 0 , "ohhts_1751_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE" , 0 , "8" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_ISCD", 0, "000000" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, "0" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_TRGT_CLS_CODE", 0, g_szMarginType )
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_TRGT_EXLS_CLS_CODE", 0,  g_szExceptItem & "  " & g_szEtfEtn )
		DATAMANAGER.SetDataValue( 0 ,"ohhts_1751_001r", "InBlock1", "FID_INPUT_PRC1" , 0, "" )
		DATAMANAGER.SetDataValue( 0 ,"ohhts_1751_001r", "InBlock1", "FID_INPUT_PRC2" , 0, "" )
		DATAMANAGER.SetDataValue( 0 ,"ohhts_1751_001r", "InBlock1", "FID_INPUT_VOL1"  , 0, "" )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList

	if g_szCode == "" then
		Exit Sub
	end if
	
	if sKeyName == "MOVEPOP_RETURN" then
		szList = Split(sRet , "★")
		
		Select Case szList(1)
			Case "0"		'현재가
				Form.OpenScreen("11000" , g_szCode & "★" & "0")
			Case "1" 	'차트
				Form.OpenScreen("13000" , g_szCode)
			Case "2" 	'관심등록
				Form.OpenPopup( "mhprc11000_pd" , g_szCode , sPosInfo)
			Case "3" 	'매수
				Form.OpenScreen("12000" , "관심종목" & "★" & "0" & "★" & g_szCode)
			Case "4" 	'매도
				Form.OpenScreen("12000" , "관심종목" & "★" & "1" & "★" & g_szCode)
		End Select
	
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.SetSharedData("HOME_RANKING_KOR" , nCurrentTab)
	FormTab0.currenttab = nCurrentTab

	Select Case CInt(nCurrentTab)
		Case 0	'TOP50>당일조회
			DATAMANAGER.SetDataValue( 0 , "ohhts_top50_002", "InBlock1", "FID_INPUT_MDIA_CLS_CODE" , 0 , Form.getDeviveID() )
			DATAMANAGER.RequestTranData("ohhts_top50_002")
		Case 1	'특징주>상/하한가>상승률/등락률높은순 						20231214 HSZ 특징주 화면으로 수정
			DATAMANAGER.RequestTranData("ohhts_1751_001r")
		Case 2	'특징주>상/하한가>하락률/등락률높은순 						20231214 HSZ 하락률 추가
			DATAMANAGER.RequestTranData("ohhts_1751_001r")
		Case 3	'기관/외국인>당일추정-외국인/순매수
			DATAMANAGER.SetDataValue( 0 , "ohhts_1074_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "V" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1074_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "1074" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1074_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , "000000" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1074_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE" , 0 , "000" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1074_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , "000" )
			DATAMANAGER.RequestTranData("ohhts_1074_001r")
		Case 4	'기관/외국인>당일추정-기관합계/순매수
			DATAMANAGER.SetDataValue( 0 , "ohhts_1073_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "V" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1073_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "1073" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1073_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , "000000" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1073_001r", "InBlock1", "FID_INPUT_INVR_CLS_CODE" , 0 , "0" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1073_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , "000" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1073_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE" , 0 , "000" )
			DATAMANAGER.RequestTranData("ohhts_1073_001r")
		Case 5	'조건검색>순위종목>거래대금 상위
			DATAMANAGER.SetDataValue( 0 , "ohhts_1703_002r", "InBlock1", "FID_INPUT_SRNO" 			, 0 , "48" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1703_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "0" )
			DATAMANAGER.RequestTranData("ohhts_1703_002r")
		Case 6	'조건검색>순위종목>거래량 상위
			DATAMANAGER.SetDataValue( 0 , "ohhts_1703_002r", "InBlock1", "FID_INPUT_SRNO" 			, 0 , "47" )
			DATAMANAGER.SetDataValue( 0 , "ohhts_1703_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "0" )
			DATAMANAGER.RequestTranData("ohhts_1703_002r")
	End Select
End Sub 
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	nTab = CInt(FormTab0.currenttab)
	
	'라벨 색상 세팅 & 등락률 이미지 세팅(거래대금, 거래량 탭만)
	if nTab = 5 or nTab = 6 then	
		for i = 0 to 4
			nVrssSign = CInt(Pannel0.GetCellValue("lblSign",i))
			Select Case nVrssSign
			Case 1, 2
				Pannel0.setPropCardCell("fgcolor","lblPr",i,"10")
				Pannel0.setPropCardCell("fgcolor","lblVrss",i,"10")
				Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"10")
					
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_red.9.png")
			Case 4, 5
				Pannel0.setPropCardCell("fgcolor","lblPr",i,"11")
				Pannel0.setPropCardCell("fgcolor","lblVrss",i,"11")
				Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"11")
				
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_blue.9.png")
			Case Else
				Pannel0.setPropCardCell("fgcolor","lblPr",i,"12")
				Pannel0.setPropCardCell("fgcolor","lblVrss",i,"12")
				Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"12")
					
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_gray.9.png")
			End Select
		next
	else
		'등락률 이미지 세팅
		for i = 0 to 4
			szCtrtData = Pannel0.GetCellValue("lblCtrt",i)
			szCtrtData = CDbl(szCtrtData * 100)

			if CDbl(szCtrtData) > 0 then
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_red.9.png")
			elseif CDbl(szCtrtData) < 0 then
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_blue.9.png")
			elseif CInt(szCtrtData) = 0 then
				Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_gray.9.png")
			end if
		next
	end if
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)

	Dim listLocation
	Dim nYPos
	Dim height
	
	listLocation = Split(Pannel0.location, ":")
	nYPos = Int(listLocation[1])	'y위치
	height = listLocation[3]		'높이
	
	sPopupType = "0"
	g_szCode = Pannel0.GetCellValue("lblCode",nIndex)

	if Trim(g_szCode) = "" then
		Exit Sub
	end if

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="ohhts_frbr_cntg" trcode="ohhts_frbr_cntg" />
			<TRAN tranid="ohhts_stck_incg" trcode="ohhts_stck_incg" />
