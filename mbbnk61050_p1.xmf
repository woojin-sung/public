'============================================================================
' 01. 화 면 명 : 당사대체출금_등록계좌
' 02. 화면설명 : 지정이체계좌조회팝업
' 03. 작    성 : 2016. 02. 15. test3
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************

Dim g_szAccountNumber		'넘어온 계좌번호
Dim g_szAccountSerialNumber	'넘어온 계좌일련번호

Dim g_szSendAccount	'계좌번호
Dim g_szSendAccountName	'계좌명
Dim g_szSendItemName	'상품명
Dim g_szSendAccountInfo	'계좌설명
Dim g_szSendBankCode	'은행코드
Dim g_szSendItemCode	'상품코드


'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_szSendAccount = ""	'계좌번호
	g_szSendAccountName = ""	'계좌명
	g_szSendItemName = ""	'상품명
	g_szSendAccountInfo = ""	'계좌설명
	g_szSendBankCode = ""	'은행코드
	g_szSendItemCode = ""	'상품코드

	Dim szData, szList
	szData = Form.GetOpenLinkData()
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	
	g_szAccountNumber = szList(0)
	g_szAccountSerialNumber = szList(1)

	DATAMANAGER.RequestTranData( "obpds_srvc_067r" )
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue(0, "obpds_srvc_067r", "InBlock1", "ACNO", 0 , g_szAccountNumber )
	DATAMANAGER.SetDataValue(0,  "obpds_srvc_067r", "InBlock1", "PROS_CLS_CODE", 0 , "0")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_067r", "InBlock1", "ASNO", 0 , g_szAccountSerialNumber )
End Sub



'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("mbbnk61050_p1" , "cancel")
	Form.CloseForm()
	
End Sub

'============================================================================
Sub grdRgacc_OnScrollEnd()
	DATAMANAGER.RequestNextData("obpds_srvc_067r")
End Sub



'============================================================================
' grdRgacc_OnClickUp - 그리드 선택 되었을 때
'============================================================================
Sub grdRgacc_OnClickUp(lRow, szCellID)

	g_szSendAccount = grdRgacc.GetCellData( "bd_cell0", lRow )
	g_szSendAccountName = grdRgacc.GetCellData( "bd_cell2", lRow )
	g_szSendItemName =grdRgacc.GetCellData( "bd_cell1", lRow )
	g_szSendAccountInfo = grdRgacc.GetCellData( "bd_cell3", lRow )
	g_szSendBankCode = grdRgacc.GetCellData( "bd_cell4", lRow )	'은행코드
	g_szSendItemCode = grdRgacc.GetCellData( "bd_cell5", lRow )	'상품코드


	if g_szSendAccount <> "" then
		Dim szSendData
		szSendData = g_szSendAccount & "★" & g_szSendAccountName  & "★" & g_szSendItemName & "★" & g_szSendAccountInfo & "★" & g_szSendBankCode & "★" & g_szSendItemCode
		Form.SendReturnToParent("mbbnk61050_p1" , szSendData)
		Form.CloseForm()
	else
		Form.ShowAlert("알림", "지정이체계좌를 선택해 주세요")
		exit sub
	end if
End Sub

