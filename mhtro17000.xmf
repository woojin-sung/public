	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function

'==============================================
' 종목메모 조회
'==============================================
Function Request_Tran_ohhts_memo_011r()
	DATAMANAGER.ClearInputData(0, "ohhts_memo_011r")
	DATAMANAGER.SetDataValue(0, "ohhts_memo_011r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.SetDataValue(0, "ohhts_memo_011r", "InBlock1", "FID_NEW_ISSU_CODE", 0, g_szItemCode)
	DATAMANAGER.RequestTranData("ohhts_memo_011r")
End Function

Function Response_Tran_ohhts_memo_011r()
	nCnt = DATAMANAGER.GetDataCount(0, "ohhts_memo_011r" , "OutBlock1")
	
	if cint(nCnt) > 0 then
		imgMemo.visible = true
		contHideTop.imgTopMemo.visible = true
	else
		imgMemo.visible = false
		contHideTop.imgTopMemo.visible = false
	end if
End Function

'==============================================
' 상단 시세 색상지정
'==============================================
Function Change_ContBgColor(szAttr)
	contHideTop.contTopSearch.lblItemName.transmode = "1"
	contHideTop.lblTopPrc.transmode = "1"
	contHideTop.lblTopDiff.transmode = "1"
	contHideTop.lblTopRate.transmode = "1"
	contHideTop.lblTopSign.transmode = "1"
	
	if cint(szAttr) == 43 then
		contHideTop.bgcolor = "218100096"
		contHideTop.contTopSearch.bgcolor = "218100096"
		contHideTop.lblTopSign.caption = "▲"
	elseif cint(szAttr) == 45 then
		contHideTop.bgcolor = "079102214"
		contHideTop.contTopSearch.bgcolor = "079102214"
		contHideTop.lblTopSign.caption = "▼"
	else
		contHideTop.bgcolor = "057062075"'
		contHideTop.contTopSearch.bgcolor = "057062075"
		contHideTop.lblTopSign.caption = ""
	end if
End Function

'==============================================
' 컨트롤 초기설정
'==============================================
Function Init_Control()
	
	'컨테이너 스크롤 이벤트 발생 유무
	contMain.SetUseScrollingEvent(true)
	
	'컨테이너 안보임 컨트롤 무시 유무(스크롤 위치)
	contMain.setExceptInvisibleCtl(true)
	
	'컨테이너 스크롤 안보임 처리
	contMain.setScrollBarVisible("0")
	
	'컨테이너 제스터 이벤트 사용유무
	contMain.gesture = true
	
	'컨테이너 헤더 여백조정(탭순서변경 버튼 추가)
	contMain.FormTab.setHorzMargin(0, 30) 
	contMain.FormTabEtf.setHorzMargin(0, 30) 
	contMain.FormTabJPN.setHorzMargin(0, 30) 
	
	sOsType = Form.GetSharedData("&OS_TYPE", false )
	
	if sOsType == "1" then
		Label1.top = 39
	elseif sOsType == "2" then
		Label1.top = 37
	end if
	
	'CFD 여부 확인
	If trim(g_szScreenNo) == "16100" then
		Form.setSearchType("26")
		
		cont0.imgCfd0.visible = true
		contHideTop.contTopSearch.imgTopCfd.visible = true
		
		cont0.imgCfd0.imgpath = "icon_cfd_b"
		contHideTop.contTopSearch.imgTopCfd.imgpath = "icon_cfd_w"
		
		cont0.lblName.left = 20
		cont0.lblName.width = 130
		
		contHideTop.contTopSearch.lblItemName.left = 20
		contHideTop.contTopSearch.lblItemName.width = 130
	else
		Form.setSearchType("19")
		Form.setSearchTypeClick("1")
		
		cont0.imgCfd0.visible = false
		contHideTop.contTopSearch.imgTopCfd.visible = false
	end if
	
	'--------------------
	'기본컨트롤 설정 START
	'--------------------
	'뒤로가기 버튼 설정
	ImgBackPress.maintainratio = "2"
	ImgBackPress.imgpath = "icon_main_01"
	
	'탭 순서변경 버튼 설정
	contMain.imgEdit.maintainratio = "3"
	contMain.imgEdit.imgpath = "btn_tab_edit"
	
	'세미메뉴(우측상단 버튼 설정)
	imgMenu.maintainratio = "3"
	imgMenu.imgpath = "icon_main_02"
	
	'돋보기버튼 설정
	imgSearch.maintainratio = "3"
	imgSearch.imgpath = "icon_search"
	
	'종목명 텍스트 롤링 처리
	cont0.lblName.setUseAutoScroll(True, 30, True)
	
	'주문화면 연동버튼 설정
	lblOrder.imagefilepth = "img_bground_12_5.9"
	
	imgMemo.maintainratio = "1"
	imgMemo.imgpath = "icon_txt_m"
	
	contBtn.Button2.singleimage = "btn_4r_gray.9"
	'--------------------
	'기본컨트롤 설정 END
	'--------------------
	
	'--------------------
	'숨김 컨테이너(상단) 설정 START
	'--------------------
	'뒤로가기 버튼 설정
	contHideTop.imgTopBack.maintainratio = "2"
	contHideTop.imgTopBack.imgpath = "icon_main_01_white"
	
	'돋보기 버튼 설정
	contHideTop.imgTopSearch.maintainratio = "3"
	contHideTop.imgTopSearch.imgpath = "icon_search_white"
	
	'메모이미지 설정
	contHideTop.imgTopMemo.maintainratio = "1"
	contHideTop.imgTopMemo.imgpath = "icon_txt_m"
	
	'언더라인
	contHideTop.lblUnderLine.bgcolor = "340"
	
	'종목명 텍스트 롤링 처리
	contHideTop.contTopSearch.lblItemName.paddinginfo = "0,0,0,0"
	contHideTop.contTopSearch.lblItemName.setUseAutoScroll(True, 30, True)
	
	'현재가 설정
	contHideTop.lblTopPrc.paddinginfo = "0,0,0,0"
	contHideTop.lblTopPrc.maxlinecnt = "1"
	contHideTop.lblTopPrc.setAttributeEnable(false)
	
	'전일대비 설정
	contHideTop.lblTopDiff.paddinginfo = "0,0,0,0"
	contHideTop.lblTopDiff.maxlinecnt = "1"
	contHideTop.lblTopDiff.setAttributeEnable(false)
	
	'등락률 설정
	contHideTop.lblTopRate.paddinginfo = "0,0,0,0"
	contHideTop.lblTopRate.maxlinecnt = "1"
	contHideTop.lblTopRate.setAttributeEnable(false)
	
	'전일대비부호 설정
	contHideTop.lblTopSign.paddinginfo = "0,0,0,0"
	contHideTop.lblTopSign.maxlinecnt = "1"
	contHideTop.lblTopSign.setAttributeEnable(false)

	contHideTop.top = -42
	'--------------------
	'숨김 컨테이너(상단) 설정 END
	'--------------------
End Function
