'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szContBgColor
g_szContBgColor = "333"

Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "290"

Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "291"

Dim g_szCurTab
g_szCurTab = ""

Dim g_szPrevTab
g_szPrevTab = ""

Dim g_ItemInfoPage
g_ItemInfoPage = "page04" '기업정보 페이지 정보

Dim g_nETF_Link_Tab
g_nETF_Link_Tab = ""

Dim g_nETF_Link_SubTab
g_nETF_Link_SubTab = ""

Dim g_isFst
g_isFst = false

Dim g_isChangeCd
g_isChangeCd = false

Dim g_szItemCode
Dim g_sCode 	
Dim g_sExid 
Dim g_szMkOpClsCd
g_szMkOpClsCd = ""

Dim g_szIntrGrpCnt
g_szIntrGrpCnt = 0

Dim g_isContScrollPos
g_isContScrollPos = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'==============================================
' 탭정보 초기화
'==============================================
Function Init_Tab()
	szETF_YN	= Form.GetItemCodeInfo(g_szItemCode, "etfyn")
	szExid	= Form.GetItemCodeInfo(g_szItemCode, "exchcode")
	
	'-----------------------------------------------------
	' 이전탭 저장 (탭변경 여부 확인용)
	' 종목별 탭 구성 다르므로 탭 변경되면 초기탭 설정 필요
	'-----------------------------------------------------
	contMain.FormTab.visible = false
	contMain.FormTabJPN.visible = false
	contMain.FormTabEtf.visible = false
	
	g_szPrevTab = g_szCurTab
	if szETF_YN == "Y" then
		g_szCurTab = "FormTabEtf"
	else
		if szExid == "JP" then
			g_szCurTab = "FormTabJPN"
		else
			g_szCurTab = "FormTab"
		end if
	end if
	
	if g_szCurTab == "FormTabEtf" then
		contMain.FormTabEtf.visible = true
	elseif g_szCurTab == "FormTabJPN" then
		contMain.FormTabJPN.visible = true
	else	
		contMain.FormTab.visible = true
	end if
	
	'-----------------------------------------------------
	' 탭 변경 시 초기값 설정
	'-----------------------------------------------------
	if g_szCurTab <> g_szPrevTab then
		szSelTabPage =  Form.getEnvData("16000_SELECT_TABPAGE_ID")
	
		if g_szCurTab == "FormTabJPN" then
		
			'컨센서스 / 배당 탭 인 경우 호가탭으로 이동
			if szSelTabPage == "page05" or szSelTabPage = "page06" then
				szSelTabPage = "page01"
			end if
		elseif g_szCurTab == "FormTabEtf" then
		
			'기업개요 / 컨센서스 / 배당 탭 인 경우 호가탭으로 이동
			if szSelTabPage == "page04" or szSelTabPage == "page05" or szSelTabPage = "page06" then
				szSelTabPage = "page01"
			end if
		end if
		
		'ETF 화면연동 정보 있는경우 
		if g_nETF_Link_Tab <> "" then
			' 연동화면 정보가 있는 경우
			if g_nETF_Link_Tab = "1" then
				'현재가 연동
				szSelTabPage = "page01"
				
			elseif g_nETF_Link_Tab = "0" then
				'종목정보 연동
				if g_szCurTab == "FormTabEtf" then
					szSelTabPage = "page00"
					
				elseif g_szCurTab == "FormTabJPN" then
					if g_nETF_Link_SubTab == "3" then
						szSelTabPage = "page04"
					else
						szSelTabPage = "page00"
					end if
					
				else
					if g_nETF_Link_SubTab == "3" then
						szSelTabPage = "page06"
					else
						szSelTabPage = "page00"
					end if
				end if
			
			end if
		end if

		'현재탭에 탭 초기값 설정
		Form.SetCtlProp("contMain." & g_szCurTab, "currenttabpageid", szSelTabPage)
		
		'ETF탭 인 경우 서브정보 전달
		if g_szCurTab == "FormTabEtf" and g_nETF_Link_SubTab <> "" and g_nETF_Link_Tab <> "" then
			Form.triggerEvent( g_szCurTab &"." & contMain.FormTabEtf.currenttabpageid, "ETF_SUB_TAB", g_nETF_Link_SubTab)
		end if
	end if
	
	' 연동정보 초기화
	g_nETF_Link_Tab = ""
	g_nETF_Link_SubTab = ""
End Function

'==============================================
' 종목코드 변경 
'==============================================
Function Chnage_ItemCode(szCode)
	if szCode == "" or szCode == null then
		Exit Function
	end if
	
	arrLinkCode = Split(szCode,"★")
	
	if #arrLinkCode < 1 then
		Exit Function
	end if
	
	szCheckData = Form.GetItemCodeInfo(arrLinkCode(0), "name")
	szCheckData2 = Form.GetItemCodeInfo(arrLinkCode(0), "enablefst")
	
	'종목정보 확인 (name 없는 경우, 마스터 파일에 없다고 판단)
	if CheckMasterFile(arrLinkCode(0)) == false then
		Exit Function
	end if
	
	'------------------------------------------------------
	' 종목코드 분리 (거래소코드@종목코드)
	'------------------------------------------------------
	arrCode = split(arrLinkCode(0), "@")
	
	if #arrCode > 1 then 
		g_sCode = arrCode(1)		
		g_sExid = Transform_Exid2(arrCode(0))
		
		g_szItemCode = g_sExid & "@" & g_sCode
	else
		Exit Function
	end if
	
	'------------------------------------------------------
	' 종목변경 플래그 (폼탭 Change 이벤트와 중복처리 방지용)
	'------------------------------------------------------
	g_isChangeCd = true
	
	'------------------------------------------------------
	' 종목명 세팅 및 관심그룹 조회
	'------------------------------------------------------
	Form.SetTimerEvent2(99, 1, 0.2)
	
	'------------------------------------------------------
	' 종목별 탭 초기설정
	'------------------------------------------------------
	Init_Tab()
	
	szCurPageID = Form.GetCtlProp("contMain." & g_szCurTab, "currenttabpageid")
	
	'------------------------------------------------------
	' 현재탭이 종목정보탭 인 경우
	' 주문화면 연동 버튼 구성 세팅 (소수점 포함여부)
	'------------------------------------------------------
	if szCurPageID == "page00" then
		if szCheckData2 = "Y" or CInt(szCheckData2) = 1 then
		'유지
		contBtn.Button2.visible = true
		
		contBtn.Button0.width = 105
		contBtn.Button1.left = 20 + 105 + 10
		contBtn.Button1.width = 105
		
		else
			'소수점 불가
			contBtn.Button2.visible = false
			
			contBtn.Button0.width = 162
			contBtn.Button1.left = 20 + 162 + 10
			contBtn.Button1.width = 163
		end if
	
		contBtn.visible = true
	else
		contBtn.visible = false
	end if
	
	'------------------------------------------------------
	' 종목코드 전달
	'------------------------------------------------------
	'Form.ShowAlert("TEST", "Init_Tab : " & g_szItemCode)
	Form.TriggerEvent( g_szCurTab & "." & szCurPageID, "RequestData", g_szItemCode )
	Form.triggerEvent( "LinkForm2", "RequestData", g_szItemCode)
	
	'------------------------------------------------------
	' 장구분 코드 전달
	'------------------------------------------------------
	if g_szMkOpClsCd <> "" then
		Form.TriggerEvent( g_szCurTab & "." & szCurPageID, "CHANGE_MKTOP", g_szMkOpClsCd )
	end if
	
	'------------------------------------------------------
	' 관심종목 등록여부 확인 및 이미지 세팅
	'------------------------------------------------------
	isIntrItem = Form.isIntrItemList(g_szItemCode)
	if isIntrItem == true then
		imgIntr.imgpath = "icon_like_o.png"
	else
		imgIntr.imgpath = "icon_like2_n.png"
	end if
	
	'------------------------------------------------------
	' 메인 컨테이너가 스크롤이 끝까지 내려가있는 경우
	' 하위 탭에 트리서 이벤트 전달 (탭내 스크롤 가능여부 체크)
	'------------------------------------------------------
	Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "CONTMAIN_SCROLL_POS", contMain.scroll_pos)
	
	if g_isContScrollPos == "END" then
		szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
		Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "ENABLE_SCROLL", "END" )
'		Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "CONTMAIN_SCROLLING", "" )
	end if
	
	'------------------------------------------------------
	' 플래그값 초기화
	' 첫화면 오픈 / 종목코드 변경
	'------------------------------------------------------
	g_isFst = false
	g_isChangeCd = false
	
	'------------------------------------------------------
	' 종목메모 등록여부 조회
	'------------------------------------------------------
	Request_Tran_ohhts_memo_011r()
End Function

'==============================================
' 거래소 구분코드 변경(3자리 -> 2자리)
' 원장조회 종목연동 시, 과거 거래소 코드로 연동되는 경우 예외처리를 위해 필요
'==============================================
Function Transform_Exid2(sValue)
	if sValue = "HKS" then
		Transform_Exid2 = "HK"
		exit Function
	elseif sValue = "SHS" then
		Transform_Exid2 = "SH"
		exit Function
	elseif sValue = "SZS" then
		Transform_Exid2 = "SZ"
		exit Function
	elseif sValue = "NYS" then
		Transform_Exid2 = "NY"
		exit Function
	elseif sValue = "AMX" then
		Transform_Exid2 = "AX"
		exit Function
	elseif sValue = "NAS" then
		Transform_Exid2 = "OQ"
		exit Function
	elseif sValue = "TSE" then
		Transform_Exid2 = "JP"
		exit Function
	else
		Transform_Exid2 = sValue
		exit Function
	end if
End Function

'==============================================
' 장운영 정보 기반 시세서비스 호출
'==============================================
Function Request_MktOp(szMkOpClsCd)

	g_szMkOpClsCd = szMkOpClsCd
	
	'해외주식 체결(프리/정규) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	
	'해외주식 체결(주간) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	
	Select Case szMkOpClsCd
		Case "001"	'주간장 개시
			Request_Tran_ohhts_6000_017r()
			
		Case "002"	'주간장 종료
			Request_Tran_ohhts_6000_017r()
			
'		Case "003"	'프리장 개시
'			Request_Tran_ohhts_6000_001r()
'		
'		Case "004"	'정규장 개시
'			Request_Tran_ohhts_6000_001r()
'			
'		Case "005"	'애프터장 개시
'			Request_Tran_ohhts_6000_020r()
'			
'		Case "006"	'애프터장 종료
'			Request_Tran_ohhts_6000_020r()
'			
'		Case "011", "012" 
'			Request_Tran_ohhts_6000_001r()
			
		Case Else
			Request_Tran_ohhts_6000_001r()
			
	End Select

End Function

'==============================================
' 해외주식 현재가(프리/정규) 조회
'==============================================
Function Request_Tran_ohhts_6000_001r()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , g_sCode )	'종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	'실시간 여부
	
	DATAMANAGER.RequestTranData("ohhts_6000_001r")
	
	Request_Real_ohhts_exst_cntg()
End Function

Function Request_Tran_ohhts_6000_001r_1()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )	'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , g_sCode )	'종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	'실시간 여부
	
	DATAMANAGER.RequestTranData("ohhts_6000_001r")
End Function

Function Request_Tran_ohhts_6000_017r()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_017r")
	
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )	'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , g_sCode )	'종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	'실시간 여부
	
	DATAMANAGER.RequestTranData("ohhts_6000_017r")
	
	Request_Real_ohhts_exst_cntd()
End Function

Function Request_Real_ohhts_exst_cntg()
'	DATAMANAGER.ClearInputData( true, "ohhts_exst_cntg")
	
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_szItemCode )
	
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
End Function

Function Request_Real_ohhts_exst_cntd()
'	DATAMANAGER.ClearInputData( true, "ohhts_exst_cntd")
	
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_szItemCode )
	
	DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
End Function

