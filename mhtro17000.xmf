'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
'	Form.ShowAlert("TEST", "Form_OnLinkData : " .. sKey .. "|" ..sValue)
	'-----------------------------------------------
	' 종목연동
	' sValue : 거래소구분코드@종목코드
	' ex) OQ@AAPL
	'-----------------------------------------------
	if "&ITEM_CODE" == sKey then
'		Chnage_ItemCode(sValue)
	
	'-----------------------------------------------
	' 로그인 (화면 열어둔 상태에서 로그인)
	'-----------------------------------------------
	elseif "&LOGIN" == sKey then
		
		'-----------------------------------------------
		' 로그인 시, USER_ID 변경가능 
		'-----------------------------------------------
		
		' 관심종목 업데이트 / 관심그룹 재조회 
		Form.requestIntrItemList("00")
		RequestTranData_Intr()
		
		' 종목메모 재조회
		Request_Tran_ohhts_memo_011r()
	end if
End Sub

'============================================================================
' Form_OnTriggerEventSemiScreen
'============================================================================
' 이벤트 시점 : 화면오픈 / 외부화면 종목연동 
'============================================================================
Sub Form_OnTriggerEventSemiScreen(sEventName, sParam)
	'Form.ShowAlert("TEST", "Form_OnTriggerEventSemiScreen : " .. sEventName .. "|" ..sParam)
	'-----------------------------------------------
	' 종목연동
	' sParam : 거래소구분코드@종목코드★종목명★기타
	' ex) OQ@AAPL★애플★
	'-----------------------------------------------
	if sEventName == "ITEM_CD" then
		Chnage_ItemCode(sParam)
		
		ItemCode0.code = sParam
	end if
End Sub

