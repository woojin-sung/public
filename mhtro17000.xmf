Sub Form_OnRefresh()
	if g_szItemCode <> "" then
		Chnage_ItemCode(g_szItemCode)
	end if
end Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_intr_006r" then
		ResponseTranData_Intr()
	elseif szTranID == "ohhts_memo_011r" then
		Response_Tran_ohhts_memo_011r()
		
	elseif szTranID == "ohhts_6000_001r"then
		szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" , 0)
		Change_ContBgColor(szAttr)
	
	elseif szTranID == "ohhts_6000_017r"then
		szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0)
		Change_ContBgColor(szAttr)
		
		if Cdbl(contHideTop.lblTopPrc.caption) == 0 then
			Request_Tran_ohhts_6000_001r_1()
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "ohhts_memo_011r" then
		Response_Tran_ohhts_memo_011r()
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_exst_cntg" or szTranID == "ohhts_exst_cntd" then
		szAttr = DATAMANAGER.GetDataAttr(1, szTranID, "OutBlock1", "FIDXR_PRPR" , 0)
		Change_ContBgColor(szAttr)
	end if
End Sub
 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert("TEST", "Form_OnTriggerEvent : " .. sEventName .. "|" ..sParam)
	' 상단바 클릭 시
	if "TITLE_CLICK" == sEventName then
		If g_szScreenNo = "16100" then
			Form.OpenCommonDialog("SEARCH", "26", "")
		else
			'Form.OpenCommonDialog("SEARCH", "19", "")
			Form.OpenPopup("msearchdialog", "종목검색★50:51:52:53:54:55★INTG_DIVIDE_HISTORY★OVRS★11000", "")
		end if

'	' 상반바 우측 관심추가 버튼 클릭 시 
'	elseif "REG_INTR" == sEventName then
'		Form.OpenPopup( "mhtro16010_p5" , g_szItemCode, "" )
		
	ElseIf sEventName = "HOGA_SETUP" Then			' 폼탭 초기화
		szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
		
		If szCurPageID == "page01" Then
			Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "HOGA_SETUP", "" )
		End If
		
	ElseIf sEventName = "FormTab_INIT" Then							' 폼탭 초기화
		contMain.FormTab.SetDefaultHeader()
		contMain.FormTabEtf.SetDefaultHeader()
		contMain.FormTabJPN.SetDefaultHeader()
'		
'	ElseIf sEventName = "FormTab_SET" Then							' 폼탭 셋팅
'		if g_szCurTab == "FormTab" then
'			contMain.FormTab.showconfig("")
'		elseif g_szCurTab == "FormTabEtf" then
'			contMain.FormTabEtf.showconfig("")
'		elseif g_szCurTab == "FormTabJPN" then
'			contMain.FormTabJPN.showconfig("")
'		end if
		
	elseif sEventName = "RETURN_LAYOUT_T11" then
		if sParam == "기업개요" then
			Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" ,  "page04")
			Form.SetCtlProp("contMain." &g_szCurTab, "currenttabpageid", "page04")
			Chnage_ItemCode(g_szItemCode)
			
		elseif sParam == "뉴스" then
			Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" ,  "page07")
			Form.SetCtlProp("contMain." &g_szCurTab, "currenttabpageid", "page07")
			Chnage_ItemCode(g_szItemCode)
			
		elseif sParam == "호가" then
			Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" ,  "page01")
			Form.SetCtlProp("contMain." &g_szCurTab, "currenttabpageid", "page01")
			Chnage_ItemCode(g_szItemCode)
			
		elseif sParam == "체결일자별" then
			Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" ,  "page02")
			Form.SetCtlProp("contMain." &g_szCurTab, "currenttabpageid", "page02")
			Chnage_ItemCode(g_szItemCode)
			
			szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
			Form.TriggerEvent(g_szCurTab & ".page02", "CHANGE_RDO", "1" )
		end if

	elseif sEventName = "CHANGE_MKTOP" then
		Request_MktOp(sParam)
		
		if g_szMkOpClsCd <> "" then
			szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
			Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "CHANGE_MKTOP", g_szMkOpClsCd )
		End If
		
	elseif sEventName = "REFRESH_INTR_ITEM" then
		
		isIntrItem = Form.isIntrItemList(g_szItemCode)
		if isIntrItem == true then
			imgIntr.imgpath = "icon_like_o.png"
		else
			imgIntr.imgpath = "icon_like2_n.png"
		end if
	End if
end Sub


'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
'	Form.ShowAlert("TEST", "Form_OnPopupReturn : " .. sKeyName .. "|" ..sRet)
	
	'---------------------------------
	' 우측상단 메뉴 클릭 
	'---------------------------------
	if sKeyName = "SCREEN_MENU" Then
	
		'---------------------------------
		' 현재가 화면설정
		'---------------------------------
		If sRet == "SET_SCREEN" Then				
			Form.OpenFramePopup("mhtro16000_pc" , "" , "")
			
		'---------------------------------
		' 종목메모
		'---------------------------------	
		elseif sRet == "REG_MEMO" then
			Form.OpenPopup("mhtro16000_p17" , g_sExid & "@" & g_sCode & "@" & g_szMkOpClsCd , "")
			
		'---------------------------------
		' DISCLAIMER
		'---------------------------------
		elseif sRet == "DISCLAIMER" then
			Form.OpenPopup("mhtro17000_p1" , g_sExid , "")
		end if
		
	'---------------------------------
	' 호가창 설정변경
	'---------------------------------
	elseif sKeyName = "HOGA_SETUP" Then	
		
		'---------------------------------
		' sRet 정의
		' - CLICK : 설정 변경
		' - 빈값 : 설정 미변경 또는 초기화
		'---------------------------------
'		if sRet == "CLICK" then
			szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
		
			If szCurPageID == "page01" Then
				Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "HOGA_SETUP", "" )
			End If
'		end if
	
	'---------------------------------
	' 폼탭(호가창) 초기화
	'---------------------------------
	elseif sKeyName = "FormTab_INIT" Then							
		contMain.FormTab.SetDefaultHeader()
		contMain.FormTabEtf.SetDefaultHeader()
		contMain.FormTabJPN.SetDefaultHeader()
	
	'---------------------------------
	' 관심종목 등록/삭제처리
	'---------------------------------	
	elseif sKeyName = "mhprc11000_save" then '관심등록 완료 후
		
		arrRet = split(sRet, "★")
		
		' 관심종목 삭제
		if arrRet(2) = "DEL" then
			Form.delIntrItemList(g_szItemCode)
			imgIntr.imgpath = "icon_like2_n.png"
			
		' 관심종목 등록
		else
			Form.addIntrItemList(g_szItemCode)
			RequestTranData_Intr()
			imgIntr.imgpath = "icon_like_o.png"
		end if
	
	'---------------------------------
	' 종목 통합검색 팝업 리턴
	'---------------------------------	
	elseif sKeyName = "DLG_SELECT" then
		'처리 불필요

	'---------------------------------
	' 종목메모 팝업 리턴
	'---------------------------------
	elseif sKeyName == "REG_MEMO" then
		Request_Tran_ohhts_memo_011r()
		
	end if
End Sub

'============================================================================
' 마스터파일에 있는 종목인지 체크
'============================================================================
Function CheckMasterFile(szCode)
	if szCode == "" or szCode == null then
		CheckMasterFile = false
		Exit Function
	end if
	arrCode = Split(szCode,"@")
	
	if #arrCode < 2 then
		CheckMasterFile = false
		Exit Function
	end if
	
	szTransExidCode = Transform_Exid2(arrCode(0))
	szTransItemCode = szTransExidCode .. "@" .. arrCode(1)
	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	
	if szCheckData = "" or szCheckData = null then
		CheckMasterFile = false
		Exit Function
	end if
	
	CheckMasterFile = true
	
End Function

'============================================================================
' 탭설정창 버튼
'============================================================================
Sub contMain_imgEdit_OnClick()
	if g_szCurTab == "FormTab" then
		contMain.FormTab.showconfig("")
	elseif g_szCurTab == "FormTabEtf" then
		contMain.FormTabEtf.showconfig("")
	elseif g_szCurTab == "FormTabJPN" then
		contMain.FormTabJPN.showconfig("")
	end if
End Sub

'============================================================================
' 타이머 이벤트 처리(종목명 세팅 및 관심그룹 조회)
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if CInt(sTimerID) == 99 then
		Form.SetTimerEvent2(99, 0, 0.2)
		contHideTop.contTopSearch.lblItemName.setAutoScrollText(Form.GetItemCodeInfo(g_szItemCode, "name"))	
		cont0.lblName.setAutoScrollText(Form.GetItemCodeInfo(g_szItemCode, "name"))
		
		RequestTranData_Intr()
	end if
End Sub

'============================================================================
' 컨테이너 위로 올리는 경우
'============================================================================
Sub contMain_OnScrollEnd()
'	Form.ShowAlert("TEST", "contMain_OnScrollEnd")

	g_isContScrollPos = "END"
	contMain.gesture = false
	contHideTop.gesture = true
	contHideTop.fixTopAreaWhenScrolling("1", 0, "Down")
	contHideTop.fixTopMoving("")
	
	Form.setItemSwipeEnable("0")
	
	szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
	
	Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "ENABLE_SCROLL", "END" )
	
	if szCurPageID == "page03" then
		Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "RESIZE_CHART", "END" )
	end if
End Sub

'============================================================================
' 컨테이너 아래로 내리는 경우
'============================================================================
Sub contMain_OnScrollTop()
'	Form.ShowAlert("TEST", "contMain_OnScrollTop")
'	contMain.gesture = true
	g_isContScrollPos = "TOP"
	contHideTop.gesture = true
	contHideTop.fixTopAreaWhenScrolling("1", -50, "Up")
	contHideTop.fixTopMoving("")
	
	Form.setItemSwipeEnable("1")
	
	szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
	
	Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "ENABLE_SCROLL", "TOP" )
	
	if szCurPageID == "page03" then
		Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "RESIZE_CHART", "TOP" )
	end if
End Sub

'============================================================================
' 컨테이너 스크롤 중
'============================================================================
Sub contMain_OnScrolling()
	
	szCurPageID = Form.GetCtlProp( "contMain." & g_szCurTab, "currenttabpageid")
	
	Form.TriggerEvent(g_szCurTab & "." & szCurPageID, "CONTMAIN_SCROLLING", "" )
End Sub

