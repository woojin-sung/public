'============================================================================
'[[ 폼 초기화 ]]
'============================================================================
Sub Form_OnFormInitBefore()
	imgIntr.maintainratio = "1"
	imgMenu.maintainratio = "1"
	
	cont0.imgCfd0.maintainratio = "2"
	contHideTop.contTopSearch.imgTopCfd.maintainratio = "2"
End Sub

Sub Form_OnFormInit()
	
	'화면 첫 진입 플래그
	g_isFst = true	
	
	'해외CFD 분기처리
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )	
	
	'컨트롤 초기화
	Init_Control()
	
	'관심종목 리스트 조회
	Form.requestIntrItemList("00")
	
	'최초 화면진입 시 호가탭 초기설정
	szSelTabPage =  Form.getEnvData("16000_SELECT_TABPAGE_ID")

	if szSelTabPage = "" then
		contMain.FormTab.currenttabpageid = "page01"
		contMain.FormTabEtf.currenttabpageid = "page01"
		contMain.FormTabJPN.currenttabpageid = "page01"
		Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" , "page01")
	end if
	
	szData = Form.GetOpenLinkData()

	'========================================================
	' ETF 관련화면 연동 처리 로직
	'========================================================
	' 종목코드★ETF/INCOME★1(호가) / 0(종목정보/기업개요)★하위탭 인덱스
	if instr(szData, "★ETF★") > 0 or instr(szData, "★INCOME★") > 0 then
		arrData = Split(szData, "★")
		
		g_nETF_Link_Tab = ""
		g_nETF_Link_SubTab = ""
		
		if #arrData > 2 then
			g_nETF_Link_Tab = arrData(2)
		
			if #arrData > 3 then
				g_nETF_Link_SubTab = arrData(3) 
			end if
		end if
		
		Exit Sub
	end if

	arrData = Split(szData, "♥")

	if arrData(0) <> "" then
		arrLinkCode = Split(arrData(0),"★")
		szLinkCode = arrLinkCode(0)
		
		if CheckMasterFile(szLinkCode) then
			
		else
			Form.ShowAlert("안내", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요.")
			Exit Sub
		end if
		
		g_szItemCode = arrData(0)
		Form.setOverStockItemCode(arrData(0))
	end if
	
	'해외CFD 잔고화면 차트 버튼
	if UBOUND(arrData) > 0 then
		if int(arrData(1)) == 2 then
			Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" , "page03")

'			contMain.FormTab.currenttab = 2
'			call contMain_FormTab_OnTabChanged(2)
		end if
	end if
	
'	if Form.GetOpenLinkData( ) == "GMP_CURRENT"	then
'		szItemCode = Form.GetSharedData("&ITEM_CODE", false)
'		Chnage_ItemCode(szItemCode)
'		
'	elseif Form.GetOpenLinkData( ) == "ITEMINFO_POP_CLOSE"	then
'		Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" , g_ItemInfoPage)
'
'	else
'		
'	end if
end Sub

'============================================================================
'[[ 폼탭 변경시 ]]
'============================================================================
Sub contMain_FormTab_OnTabChanged(nCurrentTab)
	'---------------------------------
	' 화면 첫 오픈 시 이벤트 처리 제외
	'---------------------------------
	if g_isFst == true then
		Exit Sub
	end if
	
	Form.SetEnvData(1, "16000_SELECT_TABPAGE_ID" , contMain.FormTab.currenttabpageid)
	
	'-------------------------------------------------
	' 종목변경으로 인한 탭변경 시에는 이벤트 처리 제외
	'-------------------------------------------------
	if g_isChangeCd == true then
		Exit Sub 
	end if
	

	if Len(g_szItemCode) > 0  then
'		Form.ShowAlert("TEST", "contMain_FormTab_OnTabChanged : "& g_szItemCode)
		Form.TriggerEvent( "FormTab." .. contMain.FormTab.currenttabpageid, "RequestData", g_szItemCode )
	end if
	
	if g_szMkOpClsCd <> "" then
		Form.TriggerEvent( "FormTab." .. contMain.FormTab.currenttabpageid, "CHANGE_MKTOP", g_szMkOpClsCd )
	end if
	
	Form.TriggerEvent("FormTab." .. contMain.FormTab.currenttabpageid, "CONTMAIN_SCROLL_POS", contMain.scroll_pos)
	
	if g_isContScrollPos == "END" then
		Form.TriggerEvent("FormTab." .. contMain.FormTab.currenttabpageid, "ENABLE_SCROLL", "END" )
'		Form.TriggerEvent("FormTab." .. contMain.FormTab.currenttabpageid, "CONTMAIN_SCROLLING", "" )
	end if
	
	if contMain.FormTab.currenttabpageid == "page00" then
		contBtn.visible = true
	else
		contBtn.visible = false
	end if
end Sub

