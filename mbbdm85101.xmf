	<SCRIPT_INFO _len="4063" _ulen="3937" >
'===========================================================================
' 01. 화 면 명 : 비대면 계좌개설 안내2
' 02. 화면설명 : 비대면 계좌개설 안내2
' 03. 작    성 : 
' 04. 수    정 : 
' 2021.11.11 : 김수진 : v0001 : CFD개설안내버튼 추가
'===========================================================================
DIm CloseFlag
Dim g_OsType
Dim g_Arrow


'============================================================================
Function USER_Notice(flag)
	If flag = "down" Then
		g_Arrow = "down"
		ContMain.ContiNotiTitle.ImgArrow.imgpath = "icon_caret_up.png"

		ContMain.ContiNotiBody.setHeightResize(320) 
		ContMain.ContiNotiBody.visible = True
		ContMain.lblScrollPos.top = 856
		ContMain.SetScrollAutoSize()
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.Label2.top, "1"))
	
	Else	'up
		g_Arrow = "up"
		ContMain.ContiNotiTitle.ImgArrow.imgpath = "icon_caret_down.png"

		ContMain.ContiNotiBody.setHeightResize(0) 
		ContMain.ContiNotiBody.visible = False
		ContMain.lblScrollPos.top = 455
		ContMain.SetScrollAutoSize()		
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.Label0.top, "1"))  
	End If

End Function 

'============================================================================
Sub Form_OnFormInit()
	g_OsType = Form.GetSharedData("&OS_TYPE", False)

	CloseFlag = 0
	Button0.btnimage = "btn_20.9"
	
	'개설가능상품들 문구
	'ContMain.Table0.SetCellFgColor(0, 0, 269)
	'ContMain.Table0.SetCellFgColor(0, 1, 269)
	'ContMain.Table0.SetCellFgColor(2, 0, 269)
	'ContMain.Table0.SetCellFgColor(2, 1, 269)
	'ContMain.Table0.SetCellFgColor(4, 0, 269)
	'ContMain.Table0.SetCellFgColor(4, 1, 269)

	'ContMain.Label13.fgcolor = 268
	'ContMain.Label14.fgcolor = 268
	'ContMain.Label15.fgcolor = 268
	'ContMain.Label16.fgcolor = 268
	
	ContMain.Label17.fgcolor = 270

	'이어하기 안내문구
	'ContMain.Label3.fgcolor = 269
	
	'안내사항
'	ContMain.ContiNotiTitle.bgcolor = 271
'	ContMain.ContiNotiBody.bgcolor = 272
	USER_Notice("up")
	
	
End Sub
'============================================================================
Sub Button0_OnClick()
	CloseFlag = 1
	if g_OsType == "1" then
		If CloseFlag == 1 Then
			Form.OpenPopup("mbbdm85110", "" , "")
		Else
			Form.OpenPopup("mbbdm85100", "" , "")
		End If
	
		Form.SetTimerEvent2("9999", 1, 0.1)
	elseif g_OsType == "2" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	CloseFlag = 2
	if g_OsType == "1" then
		If CloseFlag == 1 Then
			Form.OpenPopup("mbbdm85110", "" , "")
		Else
			Form.OpenPopup("mbbdm85100", "" , "")
		End If
	
		Form.SetTimerEvent2("9999", 1, 0.1)
	elseif g_OsType == "2" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_OsType == "2" then
		If CloseFlag == 1 Then
			Form.OpenPopup("mbbdm85110", "" , "")
		Else
			Form.OpenPopup("mbbdm85100", "" , "")
		End If
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID == "9999" or sTimerID == 9999 then 
		Form.SetTimerEvent2("9999", 0, 0.1)
		if g_OsType == "1" then
			Form.CloseForm()
		end if
	End If
End Sub


'============================================================================
Sub ContMain_BtnNotice_OnClick()	'JMY
	If g_Arrow = "up" Then
		USER_Notice("down")
	Else
		USER_Notice("up")
	End If
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Call ImgBackPress_OnClick()
End Sub

'============================================================================

'============================================================================
'v0001 CFD 안내
'============================================================================
Sub ContMain_imgCFDInfo_OnClick()
	Form.OpenPopup( "mbbdm85101_p1" , "" , "")	
End Sub

