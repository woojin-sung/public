	<SCRIPT_INFO _len="5084" _ulen="4830" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 일자별 탭화면
' 03. 작    성 : 2017.04.30 LES
'----------------------------------------------------------------------------
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_ItemMarket, g_szgrdHeader1, g_szgrdHeader2
'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CM"			
	end if
	'20160705 NOHES END

	
End Sub

'============================================================================
Sub Form_OnFormInit()

'	DATAMANAGER.RequestTranData( "ohhts_3000_001r" )
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
		
		'MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
		
		Set_MaskInfo()
		DATAMANAGER.RequestTranData( "ohhts_3000_001r" )
	end	if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
'	DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
'	DATAMANAGER.CancelRealData( "ohhts_cusf_cntg" )	'20210712 HSZ 야간 미국달러선물 제도개편
	
	DATAMANAGER.SetDataValue( 0, "ohhts_3000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	DATAMANAGER.SetDataValue( 0, "ohhts_3000_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	If szTranID = "ohhts_efut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	Elseif szTranID = "ohhts_eopt_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_eopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	'20210223 HSZ 야간선물 제도개편
'	Elseif szTranID = "ohhts_cmef_cntg" then
'		DATAMANAGER.SetDataValue( 1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	'20210712 HSZ 야간 미국달러선물 제도개편	
'	Elseif szTranID = "ohhts_cusf_cntg" then
'		DATAMANAGER.SetDataValue( 1, "ohhts_cusf_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_3000_001r" Then
		
		If g_szItemMarket = "EM" then
			DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		
		Elseif g_szItemMarket = "CM" then
'			DATAMANAGER.RequestRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
			DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		Elseif g_szItemMarket = "CD" then
'			DATAMANAGER.RequestRealData( "ohhts_cusf_cntg" )	'20210712 HSZ 야간 미국달러선물 제도개편
			DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		ElseIf g_szItemMarket = "EO" then
			DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
		ElseIf g_szItemMarket = "EW" then					'20220307 HSZ 야간 위클리옵션 신규상장
			DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
		End if
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
		
		'MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
		
	Set_MaskInfo()
	DATAMANAGER.RequestTranData( "ohhts_3000_001r" )
	End If
End Sub


'===============================================================================

Sub Set_MaskInfo()

	strItemCode =  Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	strItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")

	if strItemMarket = "CD" then
		Grid0.SetCellIDMaskInfo("bd_cell1", "0,0,,,1,,1,1,0")
 	else
		Grid0.SetCellIDMaskInfo("bd_cell1", "0,0,,,1,,2,1,0")
	end if

End Sub

