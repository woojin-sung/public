'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nFirmFlag	'기관선택 플래그
'Dim g_szAplyDate 	'신청일자
Dim g_szAplySrno	'신청일련번호

Dim g_nTrCount		'서비스 카운트
Dim g_szRgstFailText	'등록실패 Alert 문구
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_RgstDocu() : 타사 투자 경험 잔고증명서 제출 Open
'============================================================================
'Function f_RgstDocu(nFirmFlag)
'	If nFirmFlag > -1 Then
'		Dim szFirmNm, szFirmCd, szIstuCd
'		szFirmNm = Trim(Form.GetCtlProp("btnFirm"..nFirmFlag, "caption"))
'		szFirmCd = Trim(tblFirm.GetCellString(nFirmFlag, 0))
'		szIstuCd = Trim(tblFirm.GetCellString(nFirmFlag, 5))
'
'		If szFirmNm <> "거래기관을 선택해 주세요" and szFirmCd <> "" and szIstuCd <> "" Then
'			g_nFirmFlag = nFirmFlag
'			Dim szImg
'			szImg = Trim(tblFirm.GetCellString(g_nFirmFlag, 2))
'			Form.OpenPopup("mbonl94004_p12", g_nFirmFlag & "★" & szFirmNm & "★" & szImg , "")
'		Else
'			Form.ShowAlert("알림", "거래기관을 선택해 주세요.")
'			g_nFirmFlag = -1
'		End If
'	End If
'End 	Function
Function f_RgstDocu(nFirmFlag)
	If nFirmFlag > -1 Then
		Dim szFirmNm, szFirmCd, szIstuCd
		szFirmNm = Trim(Form.GetCtlProp("btnFirm"..nFirmFlag, "caption"))
		szFirmCd = Trim(tblFirm.GetCellString(nFirmFlag, 0))
		szIstuCd = Trim(tblFirm.GetCellString(nFirmFlag, 5))
		szDetlSrno = Trim(tblFirm.GetCellString(nFirmFlag, 7))

		If szFirmNm <> "거래기관을 선택해 주세요" and szFirmCd <> "" and szIstuCd <> "" Then
			g_nFirmFlag = nFirmFlag
			Dim szImg
			szImg = Trim(tblFirm.GetCellString(g_nFirmFlag, 2))
			'이미지플래그★기관명★이미지데이터★세부일련번호(obcsb_acif_128r에서 이미지조회하기 위해 추가!)
			Form.OpenPopup("mbonl94004_p12", g_nFirmFlag & "★" & szFirmNm & "★" & szImg & "★" & szDetlSrno , "")
		Else
			Form.ShowAlert("알림", "거래기관을 선택해 주세요.")
			g_nFirmFlag = -1
		End If
	End If
End 	Function
'============================================================================
' f_DoubleChkData() : 등록하기 전 데이터 더블체크
'============================================================================
Function f_DoubleChkData()
	For i = 0 to 2
		Dim szText
		szText = lblRgstTitle1.caption.." "..i.."번째"
	
		If Form.GetCtlProp("btnFirm"..i, "enable" ) == "1" Then
			If Form.GetCtlProp("chkFirm"..i, "checkstate" ) == "1" Then
				Dim szFirmCd, szIstuCd, szImg
				szFirmCd = Trim(tblFirm.GetCellString(i, 1))
				szIstuCd = Trim(tblFirm.GetCellString(i, 5))
				
				If szFirmCd == "" or szIstuCd == "" Then
					'데이터 초기화
					Form.SetCtlProp("chkFirm"..i, "checkstate", False)
					Form.SetCtlProp("imgCheck"..i, "imgpath", "checkmenu_n.png")					
					Form.SetCtlProp("btnFirm"..i, "caption", "거래기관을 선택해 주세요")
					tblFirm.SetCellString(i, 0, ""  )
					tblFirm.SetCellString(i, 1, "거래기관 선택" )
					tblFirm.SetCellString(i, 2, ""  )
					tblFirm.SetCellString(i, 3, "N" )
					tblFirm.SetCellString(i, 5, ""  )
					tblFirm.SetCellString(i, 6, ""  )
					Form.ShowAlert("알림", szText.."거래기관을 다시 선택해주세요.")
					
					Return false
				End If
				
				szImg = Trim(tblFirm.GetCellString(i, 2))
				If szImg == null or szImg == "" Then
					'데이터 초기화
					Form.SetCtlProp("chkFirm"..i, "checkstate", False)
					Form.SetCtlProp("imgCheck"..i, "imgpath", "checkmenu_n.png")
					tblFirm.SetCellString(i, 2, ""  )
					tblFirm.SetCellString(i, 3, "N" )
					Form.ShowAlert("알림", szText.."서류 등록을 다시 해주세요.")
					
					Return false
				End If
			Else
				'데이터 초기화
				Form.SetCtlProp("btnFirm"..i, "caption", "거래기관을 선택해 주세요")
				tblFirm.SetCellString(i, 0, ""  )
				tblFirm.SetCellString(i, 1, "거래기관 선택" )
				tblFirm.SetCellString(i, 2, ""  )
				tblFirm.SetCellString(i, 3, "N" )
				tblFirm.SetCellString(i, 5, ""  )
				tblFirm.SetCellString(i, 6, ""  )
			End If
		End If
	Next
	
	Return true
End 	Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgCheck0.setMaintainingRatio("1")
	imgCheck1.setMaintainingRatio("1")
	imgCheck2.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'전역변수 초기화--------------------------------
	g_nFirmFlag = -1	'선택기관 플래그
'	g_szAplyDate = ""	'신청일자
	g_szAplyNum = ""	'신청일련번호
	
	g_nTrCount = 0		'서비스카운트
	g_szRgstFailText = ""	'등록실패 Alert 문구
	
	imgCheck0.imgpath = "checkmenu_n.png"	'기관체크 이미지 초기화
	imgCheck1.imgpath = "checkmenu_n.png"
	imgCheck2.imgpath = "checkmenu_n.png"

'tblFirm.visible = true	'EK TEST!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

	'OpenData SET ----------------------------------
	Dim szOpenData
	szOpenData = Trim(Form.GetOpenLinkData())
	If szOpenData <> null and szOpenData <> "" Then
		Dim tData
		tData = Split(szOpenData, "★")
		If Ubound(tData) > 0 Then
			If tData[0] <> NULL and tData[1] <> NULL Then
''				g_szAplyDate = tData[0]			
				g_szAplySrno = tData[0]
				Form.SetSharedData("94004_ApplySrno" , g_szAplySrno)
		
				DATAMANAGER.RequestTranData("obcsb_acif_127r")	'전문투자자 서류등록내역	'"obcsb_acif_115r"
			End If
		End If
	End If	
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)--------------
	if sKeyName == "close_mbonl94003_p4" then
		if sRet <> NULL and sRet <> "" then
			'데이터 초기화
			Form.SetCtlProp("chkFirm"..g_nFirmFlag, "checkstate", False)
			Form.SetCtlProp("imgCheck"..g_nFirmFlag, "imgpath", "checkmenu_n.png")
			Form.SetCtlProp("btnFirm"..g_nFirmFlag, "caption", "거래기관을 선택해 주세요")
			tblFirm.SetCellString(g_nFirmFlag, 0, ""  )
			tblFirm.SetCellString(g_nFirmFlag, 1, "거래기관 선택"  )
			tblFirm.SetCellString(g_nFirmFlag, 2, ""  )
			tblFirm.SetCellString(g_nFirmFlag, 3, "N" )
			tblFirm.SetCellString(g_nFirmFlag, 5, ""  )
'			tblFirm.SetCellString(g_nFirmFlag, 6, ""  )
			
			Dim tCompany
			tCompany = Split(sRet, "★")
			if Ubound(tCompany) > 0 then	
				if tCompany[0] <> NULL and tCompany[1] <> NULL and tCompany[2] <> NULL then
				
					If g_nFirmFlag > 0 Then 
						Dim szFirmCd1, szFirmCd2, szFirmCd3
						szFirmCd1 = tblFirm.GetCellString(0, 0)
						szFirmCd2 = tblFirm.GetCellString(1, 0)
						szFirmCd3 = tblFirm.GetCellString(2, 0)
						Dim szIstuCd1, szIstuCd2, szIstuCd3
						szIstuCd1 = tblFirm.GetCellString(0, 5)
						szIstuCd2 = tblFirm.GetCellString(1, 5)
						szIstuCd3 = tblFirm.GetCellString(2, 5)
						
						If (tCompany[2] == szIstuCd1 and tCompany[0] == szFirmCd1) or (tCompany[2] == szIstuCd2 and tCompany[0] == szFirmCd2) 
							or (tCompany[2] == szIstuCd3 and tCompany[0] == szFirmCd3) Then
							Form.ShowAlert("알림", "이미 선택한 기관입니다.")
						
						else
							Form.SetCtlProp("btnFirm"..g_nFirmFlag, "enable", False)								
							Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fgcolor", "146")
							'기관명 긴 경우 폰트 작게.
							if Len(tCompany[1]) > 42 then
								Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fontsize", -3)
							else
								Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fontsize", 0)
							end if
							Form.SetCtlProp("btnFirm"..g_nFirmFlag, "caption", tCompany[1])
									
							tblFirm.SetCellString(g_nFirmFlag, 0, tCompany[0])
							tblFirm.SetCellString(g_nFirmFlag, 1, tCompany[1])
							tblFirm.SetCellString(g_nFirmFlag, 5, tCompany[2])
					
						End If
											
						Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "fgcolor", "67")
						Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "btnimage", "btn_02.9")
						Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "caption", "서류 등록")
					
					Else
					
			
						tblFirm.SetCellString(g_nFirmFlag, 0, tCompany[0])
						tblFirm.SetCellString(g_nFirmFlag, 1, tCompany[1])
						tblFirm.SetCellString(g_nFirmFlag, 5, tCompany[2])
				
						Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fgcolor", "4")
						
						'기관명 긴 경우 폰트 작게.
						if Len(tCompany[1]) > 42 then
							Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fontsize", -3)
						else
							Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fontsize", 0)
						end if
						Form.SetCtlProp("btnFirm"..g_nFirmFlag, "caption", tCompany[1])
						
						Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "fgcolor", "67")
						Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "btnimage", "btn_02.9")
						Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "caption", "서류 등록")
						
					End If
				end if
			end if
		end if
		
	' 타사 투자 경험 잔고증명서 제출 팝업 -----------------------------------
	elseif sKeyName == "close_mbonl94004_p12" then
		if sRet <> NULL and sRet <> "" then		
			Form.SetCtlProp("chkFirm"..g_nFirmFlag, "checkstate", True)
			Form.SetCtlProp("imgCheck"..g_nFirmFlag, "imgpath", "checkmenu_o.png")
			tblFirm.SetCellString(g_nFirmFlag, 2, sRet )	'등록이미지
			tblFirm.SetCellString(g_nFirmFlag, 3, "Y" )	'등록여부
			Form.SetCtlProp("btnFirm"..g_nFirmFlag, "enable", True)	
			Form.SetCtlProp("btnFirm"..g_nFirmFlag, "fgcolor", "4")
		
			Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "fgcolor", "16")
			Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "btnimage", "btn_15.9")
			Form.SetCtlProp("btnExpRgst"..g_nFirmFlag, "caption", "등록 완료")
		else
			Form.SetCtlProp("chkFirm"..g_nFirmFlag, "checkstate", False)
			Form.SetCtlProp("imgCheck"..g_nFirmFlag, "imgpath", "checkmenu_n.png")
			tblFirm.SetCellString(g_nFirmFlag, 2, ""  )	'등록이미지
			tblFirm.SetCellString(g_nFirmFlag, 3, "N" )	'등록여부			
		end if	
	end if
	
End Sub

