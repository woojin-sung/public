'============================================================================
' btnNext_OnClick() : 투자경험 등록
'============================================================================
Sub btnNext_OnClick()
	'등록전 데이터 더블 체킹
	If f_DoubleChkData() == false Then
		Exit Sub
	End if

	'거래기관 선택하고 이미지 등록한 경우만 서비스 호출
	Dim szRgstYN
	g_nTrCount = 0
	For i = g_nTrCount to 2
		szRgstYN = Trim(tblFirm.GetCellString(i, 3))	'등록여부
		If szRgstYN == "Y" Then
			g_nTrCount = i
			DATAMANAGER.RequestTranData("obcsb_acif_126a")
			Form.Toast(0, "타사 투자경험 등록 중입니다.", false)
			Exit Sub
		End If
	Next
	
	If szRgstYN <> "Y" Then
		Form.ShowAlert("알림", "서류 등록 후 진행해 주세요.")
	End If
End Sub
