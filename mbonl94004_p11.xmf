'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCsno, szHostDate
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	szHostDate = Form.GetSharedData("&HOST_DATE",0)
	
	'전문투자자 서류등록내역
	if szTranID == "obcsb_acif_127r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" 			, 0, szCsno 		) '고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "INVT_EXPC_CLCD"	, 0, "1"			) '투자경험구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_SRNO" 		, 0, g_szAplySrno	) '신청일련번호
		
	'전문투자자 서류등록
	elseif szTranID == "obcsb_acif_126a" Then	
		Dim szCertCd, szFirmCd, szImg, szIstuCd
		szCertCd = Trim(tblFirm.GetCellString(g_nTrCount, 4))	'증명서종류코드
		szFirmCd = Trim(tblFirm.GetCellString(g_nTrCount, 0))	'타사기관코드
		szIstuCd = Trim(tblFirm.GetCellString(g_nTrCount, 5))	'기관구분코드
		szImg 	= tblFirm.GetCellString(g_nTrCount, 2)	'이미지데이터	
		szFirmCd2 = Trim(tblFirm.GetCellString(g_nTrCount, 6))	'타사기관코드
		
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" 			, 0, szCsno 		) '고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_DATE"		, 0, szHostDate	) '신청일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_SRNO" 		, 0, g_szAplySrno	) '신청일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "INVT_EXPC_CLCD" 	, 0, "1"			) '투자경험구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CERT_KIND_CODE" 	, 0, szCertCd 	) '(1년이상거래계좌등록: 18 / 투자경험잔고증명서: 16)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISTU_CLCD" 		, 0, szIstuCd 	) '기관구분코드(은행:B/ 증권:F/ 보험:I/ 기타:E)
		
		if Trim(tblFirm.GetCellString(g_nTrCount, 0)) <> Trim(tblFirm.GetCellString(g_nTrCount, 6)) then	'수정등록일 경우
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OTCO_ISTU_CODE" 	, 0, Trim(tblFirm.GetCellString(g_nTrCount, 0)) 	) '타사기관코드
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OTCO_ISTU_CODE1" 	, 0, Trim(tblFirm.GetCellString(g_nTrCount, 6))	) '타사기관코드
		else	
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OTCO_ISTU_CODE" 	, 0, szFirmCd 	) '타사기관코드
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OTCO_ISTU_CODE1" 	, 0, szFirmCd 	) '타사기관코드
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ATCH_FILE_SIZE" 	, 0, LEN(szImg) 	) '첨부파일사이즈
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "UI_IMG_DATA" 		, 0, szImg		) '이미지데이터	
	
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	'전문투자자 서류등록내역
	if szTranID == "obcsb_acif_127r" Then	
		Dim szRmndCertIsncYN
		szRmndCertIsncYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RMND_CERT_ISNC_YN", 0  )	'투자경럼 서류등록여부
	
		If szRmndCertIsncYN == "Y" Then
			Dim nDataCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2"))

			If nDataCnt > 0 Then
				If nDataCnt > 3 Then
					nDataCnt = 3
'					btnNext.enable = False
				End if
		
				Dim szComCode, szIstuCode, szIstuName 
				For i = 0 to nDataCnt - 1
					szFirmCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTCO_ISTU_CODE", i )	'타사기관코드
					szFirmNm = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "ISTU_NAME", i )	'기관명
					szIstuCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "ISTU_CLCD", i )	'기관구분코드
					szDetlSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "DETL_SRNO", i )	'세부일련번호
		
					If szFirmCd <> "" and szFirmNm <> "" and szIstuCd <> "" Then
						tblFirm.SetCellString(i, 0, szFirmCd )
						tblFirm.SetCellString(i, 1, szFirmNm)
						tblFirm.SetCellString(i, 5, szIstuCd)
						tblFirm.SetCellString(i, 6, szFirmCd )
						tblFirm.SetCellString(i, 7, szDetlSrno )
					
						Form.SetCtlProp("btnFirm"..i, "caption", szFirmNm)
'						Form.SetCtlProp("btnFirm"..i, "enable", False)	
						Form.SetCtlProp("btnFirm"..i, "fgcolor", "4")	'기등록된 기관 폰트컬러 검정으로
						'기관명 긴 경우 폰트 작게.
						if Len(szFirmNm) > 42 then
							Form.SetCtlProp("btnFirm"..i, "fontsize", -3)
						else
							Form.SetCtlProp("btnFirm"..i, "fontsize", 0)
						end if
						Form.SetCtlProp("chkFirm"..i, "checkstate", True)		
						
						Form.SetCtlProp("imgCheck"..i, "imgpath", "checkmenu_o.png")
						
						Form.SetCtlProp("btnExpRgst"..i, "fgcolor", "16")
						Form.SetCtlProp("btnExpRgst"..i, "btnimage", "btn_15.9")			
						Form.SetCtlProp("btnExpRgst"..i, "caption", "등록 완료")
						
						'등록완료여도 파일 업로드 가능하도록 수정. (박효정과장 요청)
						
'						'이미지 SetCtlProp enable적용 안됨
'						if i == 0 then
'							imgSearch0.enable = False
'						elseif i == 1 then 
'							imgSearch1.enable = False
'						else
'							imgSearch2.enable = False
'						end if
					End If
				Next
			End If
		End If
		
	'전문투자자 서류등록
	elseif szTranID == "obcsb_acif_126a" then
		g_nTrCount = g_nTrCount + 1
		If g_nTrCount < 3 Then
			Dim szRgstYN
			szRgstYN = ""
			For i = g_nTrCount to 2
				szRgstYN = Trim(tblFirm.GetCellString(i, 3))	'등록여부
				If szRgstYN == "Y" Then
					g_nTrCount = i
					Exit For
				End If
			Next
			
			If szRgstYN == "Y" Then
				DATAMANAGER.RequestTranData( "obcsb_acif_126a" )
			Else
				If g_szRgstFailText <> "" Then
					DATAMANAGER.RequestTranData( "obcsb_acif_127r" )	'전문투자자 서류등록내역
					Form.ShowAlert("알림", g_szRgstFailText)
				Else
					Form.SendReturnToParent("close_mbonl94004_p11" , "")
					Form.CloseForm()
				End If
			End If
		Else
			If g_szRgstFailText <> "" Then
				DATAMANAGER.RequestTranData( "obcsb_acif_127r" )	'전문투자자 서류등록내역
				Form.ShowAlert("알림", g_szRgstFailText)
			Else
				Form.SendReturnToParent("close_mbonl94004_p11" , "")
				Form.CloseForm()
			End If
		End If
	end if
End Sub
