	<SCRIPT_INFO _len="4275" _ulen="3833" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 은행개설계좌 ID등록_이용약관동의
' 02. 화면설명 : 
' 03. 작    성 : 2016.03.07 김은숙
' 2021.05.27 : 정민영 : v0001 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : 개인정보 처리방침 제거
' 2023.05.12 : v0002 : 전상일 : 화면권한 쉐어드 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sPopupFileName
Dim g_sSendData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&SCREEN_AUTH", "") 'v0002
	g_sRetData = "cancel"
	'v0001 개인신용정보동의는 ID가입정보 등록시, 임시저장(공통)으로 같이 처리. _p4 화면은 건너뜀
	'g_sPopupFileName = "mhetc90020_p4"
	g_sPopupFileName = "mhetc90020_p5"
	Form.SetScreenName("은행개설계좌 ID등록")
End Sub

'============================================================================
'취소 버튼
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'다음 버튼
Sub btnOK_OnClick()
	if chkAgree0.chksilence == "0" then
		Form.MsgBox( "알림", "온라인서비스 이용약관 동의를 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if
	
	'v0001 제외(2021.05.31 원복By박정숙Cha)
	if chkAgree1.chksilence == "0" then
		Form.MsgBox( "알림", "개인정보 처리방침 동의를 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if

	'v0001 mhetc90020_p4에서 처리한 다음이동 로직 추가
	'Form.OpenFramePopup( g_sPopupFileName , sOpenData , sPosInfo)
	g_sSendData = "은행" + "★"
	g_sSendData = g_sSendData + "" + "★"
	g_sSendData = g_sSendData + "" + "★"
	g_sSendData = g_sSendData + "" + "★"
	g_sSendData = g_sSendData + "" + "★"
	g_sSendData = g_sSendData + "" + "★"
	g_sSendData = g_sSendData + "" + "★"
	g_sSendData = g_sSendData + "" + "★"
	Form.OpenFramePopup( g_sPopupFileName , g_sSendData , sPosInfo)
End Sub

'============================================================================
'온라인서비스 이용약관 보기
Sub btnView0_OnClick()
	Form.OpenFramePopup("mhetc90020_p9" , "OnlineService" , "")
End Sub

'============================================================================
'개인정보 처리방침 보기
Sub btnView1_OnClick()
	Form.OpenFramePopup("mhetc90020_p9" , "Disposal" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SendReturnToParent( "mhetc90020_p3" , g_sRetData )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == g_sPopupFileName then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
	
	if sKeyName == "mhetc90020_p9" then
		if sRet == "OnlineService" then
			chkAgree0.checkstate = "1"
		elseif sRet == "Disposal" then
			chkAgree1.checkstate = "1"
		end if
	end if
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.OpenFramePopup("mhetc90020_p9" , "OnlineService" , "")
End Sub


'============================================================================
Sub Button1_OnClick()
	'v0001 제외 (2021.05.31 원복By박정숙Cha)
	 Form.OpenFramePopup("mhetc90020_p9" , "Disposal" , "")
End Sub

