'============================================================================
'20240628 SWJ START : MY ELS/DLS 청약조회
'============================================================================
Dim g_szSelectAcc, g_szSelectAccSeq
g_szSelectAcc = ""
g_szSelectAccSeq = ""

Dim g_szList, g_szAccList
g_szList = ""
g_szAccList = ""

Dim g_bEntire
g_bEntire = False

Dim g_sEntireAcc, g_sEntireAccSeq, g_sEntireSaveAcno
g_sEntireAcc = Array()
g_sEntireAccSeq = Array()
g_sEntireSaveAcno = Array()

Dim g_sEntireACNO, g_sEntireASNO
g_sEntireACNO = Array()
g_sEntireASNO = Array()

Dim g_nEntireCount
g_nEntireCount = 0
 
Dim g_nAcntIndex
g_nAcntIndex = 0

Dim g_sHostDate
g_sHostDate = ""

Dim g_nAcnoCount
g_nAcnoCount = 0

Dim g_iAccountCount, g_sSaveAccountList
g_iAccountCount = ""
g_sSaveAccountList = ""

Dim g_sAcnoList
g_sAcnoList = ""

Dim g_bNextFlag
g_bNextFlag = True

Dim g_sSBSC_DATE, g_sSBSC_ISSU_SRNO, g_sSBSC_APLT_SRNO, g_sSBSC_STCN, g_sISNM
g_sSBSC_DATE = ""
g_sSBSC_ISSU_SRNO = ""
g_sSBSC_APLT_SRNO = ""
g_sSBSC_STCN = ""
g_sISNM = ""
g_sData2 = ""
'============================================================================

'============================================================================
Sub Form_OnFormInit()

	'Form.SetTimerEvent2(1, 1, 0.1)
	
	Pannel0.rowcount = 0
	
	g_sHostDate = Form.GetSharedData("&HOST_DATE", false)
	
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent2(sTimerID,0,0.1)
	
	if Cint(sTimerID) == 1 then
		
		DATAMANAGER.RequestTranData("obibk_pssp_001r")
	
	elseif Cint(sTimerID) == 2 then
		
		RequestDataForEntire()
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.MsgBox("안내", szErrMsg.."("..szSubErr..")" , "", 6)
	else
		Form.MsgBox("안내", szErrMsg , "", 6)
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	g_nEntireCount = 0
	g_nAcntIndex = 0
	
	'화면 처음 열때
	if sEventName == "Init" then
	
		'0 종합계좌 개수
		'1 종합계좌 리스트
		'2 개별계좌개수
		'3 개별계좌 리스트(ACNo + ASNo)
		'4 개별계좌명 리스트([상품명]계좌번호)
		'5 계좌개수☆개별계좌의 그룹인덱스
		'6 선택한 계좌번호
		'7 선택한 계좌seq
		'8 비밀번호
		
		szLinkData = sParam
		g_szList = split(szLinkData, "|")
		
		g_szSelectAcc = g_szList(6)
		g_szSelectAccSeq = g_szList(7)
		
		'계좌번호전체, 계좌명을 비교하기 위해서 
		g_iAccountCount = CInt(g_szList(2))
		
		'종합계좌 전체개수
		g_nAcnoCount = CInt(g_szList(0))
		g_sAcnoList  = g_szList(1)
		
		g_szAccountList = split(g_szList(4), "○")
		g_sSaveAccountList = g_szList(3)
		
		ProcessAccount(sEventName)
	
	'계좌콤보 변경시
	elseif sEventName == "AccountChange" then

		'0 선택한 계좌번호		
		'1 선택한 계좌seq
		'2 비밀번호
		
		szList = split(sParam, "|")
		g_szSelectAcc = szList(0)
		g_szSelectAccSeq = szList(1)
		
		ProcessAccount(sEventName)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obibk_pssp_001r" then
		
		if g_bEntire then
			DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "ACNO" 			 , 0 , g_sEntireSaveAcno(g_nAcntIndex))
			
			'전체 계좌 조회할 때는, 종합계좌 기준으로만 조회한다. (서비스 호출 1회)
			'원장 프로그램에서 고객 기준으로 전체 조회해줌. (이 고객의 계좌번호 아무거나 세팅은 해줘야함)
			DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE2"     , 0 , "1")	
		else
			DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "ACNO" 			 , 0 , g_szSelectAcc)
			DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "ASNO"		      , 0 , g_szSelectAccSeq)
			DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE2"     , 0 , "2")
		end if
		
		DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "SBSC_APLT_DATE"    , 0 , "19000101")
		DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "IQRY_FIN_DATE"     , 0 , "")
		DATAMANAGER.SetDataValue(0, "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE"     , 0 , "1")
	
	elseif szTranID == "obibk_pssb_001a" then
		
		DATAMANAGER.SetEventFlag( "obibk_pssb_001a", "A" )
		
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock1", "PROS_CLS_CODE"	, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock1", "CONT_CLS_CODE"	, 0 , "4")
		
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock1", "ACNO" 			 , 0 , g_szSelectAcc)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock1", "ASNO"		      , 0 , g_szSelectAccSeq)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock1", "ACNT_PWD"		 , 0 , edtPassword.caption)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock1", "TRNF_YN"		      , 0 , "0")
		
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock2", "SBSC_DATE"	      , 0 , g_sSBSC_DATE)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock2", "SBSC_ISSU_SRNO"	 , 0 ,g_sSBSC_ISSU_SRNO)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock2", "SBSC_APLT_SRNO"    , 0 , g_sSBSC_APLT_SRNO)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock2", "SBSC_STCN"	      , 0 , g_sSBSC_STCN)
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock2", "BSWR_FEE_LEVY_YN"	  , 0 , "N")
		DATAMANAGER.SetDataValue(0, "obibk_pssb_001a", "InBlock2", "CNCL_YN"	           , 0 , "Y")
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obibk_pssp_001r" then
			
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" )
		
		'판넬의 OnScrollEnd를 2번 타는 현상이 있어서
		'플래그 세움
		g_bNextFlag = True
		
		Pannel0.rowcount = g_nEntireCount + Cint(nDataCnt)

		for i = 0 to Cint(nDataCnt) - 1 
			sSBSC_DATE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "SBSC_DATE" , i)	'청약신청일
			sSBSC_ISSU_SRNO = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "SBSC_ISSU_SRNO" , i)	'청약종목일련번호
			sSBSC_APLT_SRNO = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "SBSC_APLT_SRNO" , i)	'청약신청일련번호
			sSBSC_STCN = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "SBSC_STCN" , i)	'청약주수
			nEXCL_AMT  = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "EXCL_AMT" , i)	'청약금액
			sUNAS_NAME = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "UNAS_NAME" , i)	'기초자산
			sSBSC_STA_DATE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "SBSC_STA_DATE" , i)	'청약시작일자
			sSBSC_FIN_DATE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "SBSC_FIN_DATE" , i)	'청약종료일자
			sCAFU_DDLN_DATE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "CAFU_DDLN_DATE" , i)	'신청일자 다음날 ~ 숙려기한일자
			sINTN_DTRM_DATE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "INTN_DTRM_DATE" , i)	'숙려기한일자 다음날 ~ 의사표시일자
			sBSWR_PROS_CLS_CODE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "BSWR_PROS_CLS_CODE" , i)	'처리상태
			sPO_MKSC_NAME = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "PO_MKSC_NAME" , i)	'공모유가증권명
			sCAFU_TRGT_YN = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "CAFU_TRGT_YN" , i)	'숙려대상여부
			
			sPROS_DATE = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "PROS_DATE" , i)	'
			
			g_sEntireACNO(i + g_nEntireCount) = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "ACNO" , i)	'계좌번호
			g_sEntireASNO(i + g_nEntireCount) = DATAMANAGER.GetDataValue( 0 , "obibk_pssp_001r", "OutBlock1", "ASNO" , i)	'계좌일련번호
			
			lblForMask0.caption = sSBSC_STA_DATE
			lblForMask1.caption = sSBSC_FIN_DATE
			lblForMask2.caption = sCAFU_DDLN_DATE
			lblForMask3.caption = sINTN_DTRM_DATE
				
			if sSBSC_FIN_DATE == "" then
				Pannel0.setPropCardCell("visible","ImgGrade0", i + g_nEntireCount, 0)
				Pannel0.setPropCardCell( "visible" ,"LblGrade0", i + g_nEntireCount, 0)
				Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "")
			else
					
				ResaveDate 	= left(sSBSC_FIN_DATE,4)&"-"&mid(sSBSC_FIN_DATE,5,2)&"-"&right(sSBSC_FIN_DATE,2)
				RetodayDate 	= left(g_sHostDate,4)&"-"&mid(g_sHostDate,5,2)&"-"&right(g_sHostDate,2)
		
				calcDate = DateDiff("d",RetodayDate, ResaveDate)
				
				if calcDate > 0 then
					Pannel0.setPropCardCell("visible","ImgGrade0", i + g_nEntireCount, 1)
					Pannel0.setPropCardCell( "visible" ,"LblGrade0", i + g_nEntireCount, 1)
					
					sdDate = "-"..calcDate
				
					Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "청약마감 D"..sdDate)	
				
				elseif calcDate == 0 then
					
					Pannel0.setPropCardCell("visible","ImgGrade0", i + g_nEntireCount, 1)
					Pannel0.setPropCardCell( "visible" ,"LblGrade0", i + g_nEntireCount, 1)
				
					Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "청약마감 D-day")	
				
				else
					Pannel0.setPropCardCell("visible","ImgGrade0", i + g_nEntireCount, 0)
					Pannel0.setPropCardCell( "visible" ,"LblGrade0", i + g_nEntireCount, 0)
					
					Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "")	
				end if
				
			end if
				
			Pannel0.setPropCardCell("maxlinecnt","LblISNM", i + g_nEntireCount, "1^-3")
			Pannel0.setPropCardCell("maxlinecnt","LblData0", i + g_nEntireCount, "1^-1")
			Pannel0.setPropCardCell("maxlinecnt","LblData1", i + g_nEntireCount, "1^-4")
			Pannel0.setPropCardCell("maxlinecnt","LblData2", i + g_nEntireCount, "1^-1")
			Pannel0.setPropCardCell("maxlinecnt","LblData3", i + g_nEntireCount, "1^-1")
			Pannel0.setPropCardCell("maxlinecnt","LblData4", i + g_nEntireCount, "1^-1")
			Pannel0.setPropCardCell("maxlinecnt","LblData5", i + g_nEntireCount, "1^-1")
			Pannel0.setPropCardCell("maxlinecnt","LblData6", i + g_nEntireCount, "1^-1")
			Pannel0.setPropCardCell("maxlinecnt","LblGrade0", i + g_nEntireCount, "1^-1")
					
			Pannel0.SetCellValue("LblISNM", i + g_nEntireCount, sPO_MKSC_NAME)
			Pannel0.SetCellValue("LblData0", i + g_nEntireCount, Right(sSBSC_DATE,6))
			
			if g_bEntire then
				Pannel0.SetCellValue("LblData1", i + g_nEntireCount, FindFullAcntName(g_sEntireACNO(i + g_nEntireCount), g_sEntireASNO(i + g_nEntireCount)))
			else
				Pannel0.SetCellValue("LblData1", i + g_nEntireCount, FindFullAcntName(g_szSelectAcc, g_szSelectAccSeq))
			end if
			
			Pannel0.SetCellValue("LblData2", i + g_nEntireCount, nEXCL_AMT)
			Pannel0.SetCellValue("LblData3", i + g_nEntireCount, sUNAS_NAME)
			
			if g_bEntire then
				Pannel0.SetCellValue("LblAcnt", i + g_nEntireCount,  g_sEntireACNO(i + g_nEntireCount))
				Pannel0.SetCellValue("LblAcntSeq", i + g_nEntireCount, g_sEntireASNO(i + g_nEntireCount))
			end if
			
			Pannel0.SetCellValue("LblSbscDate", i + g_nEntireCount,  sPROS_DATE)
			Pannel0.SetCellValue("LblSbscIssuSrno", i + g_nEntireCount,  sSBSC_ISSU_SRNO)
			Pannel0.SetCellValue("LblSbscApltSrno", i + g_nEntireCount,  sSBSC_APLT_SRNO)
			Pannel0.SetCellValue("LblSbscStcn", i + g_nEntireCount,  sSBSC_STCN)
			
			if sSBSC_STA_DATE <> "" and sSBSC_FIN_DATE <> "" then
				Pannel0.SetCellValue("LblData4", i + g_nEntireCount, Right(lblForMask0.dispcaption,8).." ~ "..Right(lblForMask1.dispcaption,8))
			end if
			
			'숙려대상여부
			if sCAFU_TRGT_YN == "Y" then
				if sCAFU_DDLN_DATE <> "" and sINTN_DTRM_DATE <> "" then
					Pannel0.SetCellValue("LblData5", i + g_nEntireCount, Right(lblForMask2.dispcaption,8).." ~ "..Right(lblForMask3.dispcaption,8))
				end if
			else
				Pannel0.SetCellValue("LblData5", i + g_nEntireCount, Right(lblForMask0.dispcaption,8).." ~ "..Right(lblForMask1.dispcaption,8))
			end if
				
			Pannel0.SetCellValue("LblData6", i + g_nEntireCount, ProcessType(sBSWR_PROS_CLS_CODE))
			
			'청약 신청 상태에서만 취소하기 버튼 활성화
			if Trim(sBSWR_PROS_CLS_CODE) == "1" then
				Pannel0.setPropCardCell( "singleimage" ,"Button0", i + g_nEntireCount, "btn_15_o.9.png")
				Pannel0.setPropCardCell( "fgcolor" ,"Button0", i + g_nEntireCount, 38)
			else
				Pannel0.setPropCardCell( "singleimage" ,"Button0", i + g_nEntireCount, "btn_15_d.9.png")
				Pannel0.setPropCardCell( "fgcolor" ,"Button0", i + g_nEntireCount, 295)
			end if
					
		next
		
		g_nEntireCount = g_nEntireCount + Cint(nDataCnt)
		
		if g_bEntire then
			
			if DATAMANAGER.IsMoreNextData("obibk_pssp_001r") then
			
				'다음 조회 요청
				DATAMANAGER.RequestNextData("obibk_pssp_001r")
				
			'else
				'종합계좌 기준으로 다음 계좌에 대한 데이터 재조회
				'if g_nAcntIndex <  CInt(g_nAcnoCount) - 1 then
				'	g_nAcntIndex = g_nAcntIndex + 1
	
				'	DATAMANAGER.RequestTranData("obibk_pssp_001r")
				'end if
				
			end if
		end if
		
		if Cint(g_nEntireCount) > 0 then
			imgNotice.visible = False
			tblNoData.visible = False
			Pannel0.visible = True
			Pannel0.left = 10
			
		else
			Pannel0.visible = False
			Pannel0.left = 500
			
			tblNoData.top = 100
			imgNotice.top = 60
						
			imgNotice.visible = True
			tblNoData.visible = True
		end if
		
	elseif szTranID == "obibk_pssb_001a" then
		Form.OpenPopup("mbfnp53100_p3", "SubScriptionCancel" & "★" & FindFullAcntName(g_szSelectAcc,g_szSelectAccSeq) & "★" & g_sISNM & "★" & g_sData2, "")
	end if
	
End Sub
'============================================================================
Sub Pannel0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obibk_pssp_001r") then
		
		g_nEntireCount = Cint( Pannel0.rowcount )	
		
		if g_bNextFlag then
			'다음 조회 요청
			DATAMANAGER.RequestNextData("obibk_pssp_001r")
			
			g_bNextFlag = False
		end if
	end if
End Sub

'============================================================================
Sub ProcessAccount(sEventName)
	
	if g_szSelectAcc == "전체" then
		
		'전체 계좌 여부
		g_bEntire = True
		
		if sEventName == "Init" then
			Form.SetTimerEvent2(2, 1, 0.2)
		else
			RequestDataForEntire()
		end if
		
	else
		
		'전체 계좌 여부
		g_bEntire = False
		
		DATAMANAGER.RequestTranData("obibk_pssp_001r")
	end if
		
End Sub
'============================================================================
Sub RequestDataForEntire()
	szAccList = Split(g_sSaveAccountList, "○")
	sAcnoList = Split(g_sAcnoList, "○")
		
	for i = 0 to CInt(g_iAccountCount) - 1		
		g_sEntireAcc(i) = Left(szAccList(i), 8)
		g_sEntireAccSeq(i) = Right(szAccList(i), 2)
	next
	
	for j = 0 to Cint(g_nAcnoCount) - 1
		g_sEntireSaveAcno(j) = sAcnoList(j)
	next
	
	DATAMANAGER.RequestTranData("obibk_pssp_001r")
	
End Sub
'============================================================================
Function	ProcessType(sType)

	if sType == "1" then
		return "청약신청완료"
	elseif sType == "2" then
		return "청약취소"
	elseif sType == "3" then
		return "청약확정"
	elseif sType == "4" then
		return "발행완료"
	end if
		
	return ""
	
End Function 

'============================================================================
'FULL 계좌명 찾기 함수
Function FindFullAcntName(sAccount, sAccountSeq)

	sComparedData = sAccount & sAccountSeq
	
	sSaveAccountList = Split(g_sSaveAccountList, "○")

	for i = 0 to #sSaveAccountList - 1
		if sComparedData == sSaveAccountList(i) then
			 return g_szAccountList(i)
		end if
	next
	
	return ""
End Function
'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	
	'취소하기
	if sCellID == "Button0" then
		
		sFgColor = Pannel0.getPropCardCell( "fgcolor" ,"Button0", nIndex)
		
		if sFgColor == "295" then
			exit sub
		end if
		
		if g_bEntire then
			g_szSelectAcc    = Pannel0.GetCellValue("LblAcnt",nIndex)
			g_szSelectAccSeq = Pannel0.GetCellValue("LblAcntSeq",nIndex)
			
			sSendData = g_szSelectAcc & g_szSelectAccSeq &"☆"&"0"
		else
			sSendData = g_szSelectAcc & g_szSelectAccSeq &"☆"&"0"
		end if 
		
		g_sSBSC_DATE = Pannel0.GetCellValue("LblSbscDate", nIndex)
		g_sSBSC_ISSU_SRNO = Pannel0.GetCellValue("LblSbscIssuSrno", nIndex)
		g_sSBSC_APLT_SRNO = Pannel0.GetCellValue("LblSbscApltSrno", nIndex)
		g_sSBSC_STCN = Pannel0.GetCellValue("LblSbscStcn", nIndex)
		g_sISNM = Pannel0.GetCellValue("LblISNM", nIndex)
		g_sData2 = Pannel0.GetCellValue("LblData2", nIndex)	'청약금액
		
		if sSendData <> "" then
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				
				DATAMANAGER.RequestTranData( "obibk_pssb_001a" )
			end if
		end if
	
	'청약 취소
	elseif sKeyName == "mbfnp53100_p3" then
		
		g_nEntireCount = 0
		
		if g_bEntire then
			 RequestDataForEntire()
		else
			ProcessAccount("AccountChange")
		end if
		
	end	if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

