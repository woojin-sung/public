' 20160317 수량 Max : 8 (전요셉과장)

'============================================================================
' 화 면 명 : 주식주문_수량입력창
' 화면설명 : 주식주문 수량입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szMk, g_szReceive
g_szMk, g_szReceive = "", ""

Dim g_szOrdSize
g_szOrdSize = ""


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, szCalc, szUnit, szCut, szData, szChk
	Dim nUnit, nLen, nResult
	
	g_szReceive = ""
	'g_szMk = Form.GetCtlProp("#edtMk", "caption")
	szQty = edtQty.caption

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szQty) <> "" then
		if CDbl(szQty) >= 99000000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = g_szOrdSize
		else
			Exit Function
		end if
	else
		'if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = g_szOrdSize
		'else
		'	nCnt = Len(szQty)-1
			
		'	For i = 0 to nCnt-1
		'		if i == 0 then
		'			szUnit = "1"
		'		else
		'			szUnit = szUnit & "0"
		'		end if
		'	Next
			
		'	nUnit = CDbl(szUnit)
		'end if
	
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			nResult = CDbl(szQty) Mod nUnit
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else		' 20160317 추가사항 적용
				szQty = szQty - nUnit
				nResult = CDbl(szQty) Mod nUnit

'				if nResult <> 0 then
'					nResult = nUnit - nResult
'					szQty = CDbl(szQty) + nResult
'				elseif nResult == 0 then
'					if Len(nUnit) > 1 then
'						szQty = szQty + nUnit
'						szCut = Mid(szQty, 1, 1)
'						
'						if szCut == "1" then
'							szChk = Mid(szQty, 2, Len(szQty))
'							
'							For i = 0 to Len(szChk)-1
'							szData = Mid(szChk, i+1, 1)
'								if szData <> "0" then
'									szQty = szQty - nUnit
'									Exit For
'								end if
'								
'								if i == Len(szChk)-1 then
'									nUnit = Left(nUnit, Len(nUnit)-1)
'									szQty = szQty - nUnit
'								end if
'							Next
'						else
'							szQty = szQty - nUnit
'						end if
'					end if
'				end if
			end if
		end if
	end if
	
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szQty
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtQty.caption = nPlus
	else
		szQty = edtQty.caption
		
		if nGbn == 1 then
			if Trim(szQty) == "" then
				szQty = 0
			end if
			
			szQty = CDbl(szQty) + nPlus
		else
			szQty = szQty & nPlus
		end if
		
		Sum_Qty(szQty)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szQty
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtQty.caption = ""
	else	
		szQty = edtQty.caption
		
		if Len(edtQty.caption) > 0 then
			szQty = edtQty.caption & szPlus
			
			Sum_Qty(szQty)
		end if
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	'if Len(szData) < 16 then
	if Len(szData) < 9 then		' Max 8(20160317 전요셉과장)
		if CStr(szData) == "0" or CStr(szData) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szData
		end if
	end if
End Function	

'============================================================================
' Sum_Qty
'============================================================================
Function Enable_QtyBtn(szData)
	if szData > 10 then	
		btnPlus10.caption		= "+" & szData
		btnPlus50.caption 	= "+" & (CInt(szData) * 2)
		btnPlus100.caption 	= "+" & (CInt(szData) * 3)
		btnPlus500.caption 	= "+" & (CInt(szData) * 4)
		btnPlus1000.caption 	= "+" & (CInt(szData) * 5)
	end if
End Function	


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT" then
		g_szReceive = "1"
		tData = Split(sParam, "★")
		edtQty.caption = tData(0)
		g_szOrdSize = tData(1)
		
		nzOrdSize = Cint(g_szOrdSize)
		
		Enable_QtyBtn(nzOrdSize)
	end if
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' btnPlus1_OnClick
'============================================================================
Sub btnPlus1_OnClick()
	Calc_Plus(0, 1)
End Sub

'============================================================================
' btnPlus2_OnClick
'============================================================================
Sub btnPlus2_OnClick()
	Calc_Plus(0, 2)
End Sub

'============================================================================
' btnPlus3_OnClick
'============================================================================
Sub btnPlus3_OnClick()
	Calc_Plus(0, 3)
End Sub


'============================================================================
' btnPlus4_OnClick
'============================================================================
Sub btnPlus4_OnClick()
	Calc_Plus(0, 4)
End Sub

'============================================================================
' btnPlus5_OnClick
'============================================================================
Sub btnPlus5_OnClick()
	Calc_Plus(0, 5)
End Sub

'============================================================================
' btnPlus6_OnClick
'============================================================================
Sub btnPlus6_OnClick()
	Calc_Plus(0, 6)
End Sub

'============================================================================
' btnPlus7_OnClick
'============================================================================
Sub btnPlus7_OnClick()
	Calc_Plus(0, 7)
End Sub

'============================================================================
