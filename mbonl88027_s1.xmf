				<LABEL name="lblProChange" visible="0" fgcolor="067:049081150" fontsize="-2" caption="변경하기" halign="2" click="1" ly_vert="266,397,100,25,0" />
				<LABEL name="lblProNotice" visible="0" fgcolor="146:124124124" fontsize="-3" caption="·고객정보에 등록된 휴대폰번호로 발송되오니, 휴대폰번호를 반드시 확인해 주세요." valign="0" multiline="1" ly_vert="15,435,345,35,0" />
