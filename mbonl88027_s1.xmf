				<IMAGE name="imgToolTip1" imgpath="icon_question.png" ly_vert="149,190,16,16,1" />
				<LABEL name="Label1" fgcolor="146:124124124" fontsize="-1" caption="(단위 : 1만원)" halign="2" ly_vert="259,189,100,20,1" />
				<EDIT name="edtAmont" mask="0,0,,,0,,0,1,1,0,0" imetype="1" ly_vert="25,213,325,32,1" />
				<LABEL name="lblGuide" fgcolor="146:124124124" fontsize="-2" fontstyle="01" caption="계약(액면)금액은 200,000,000원 입니다." ly_vert="15,247,345,20,1" />
