	<SCRIPT_INFO _len="14010" _ulen="12462" >

Dim g_szAcno
Dim g_szAsno

'============================================================================
Sub Form_OnFormInitBefore()
	contInput.imgToolTip1.setMaintainingRatio("1")
	contInput.imgToolTip2.setMaintainingRatio("1")
	contInput.imgToolTip3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_nMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if g_nMode == "0" then
		g_szUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles"	'운영계 주소
	elseif g_nMode == "1" then
		g_szUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles"	'테스트계주소
	end if
	
'	Form.MsgBox("알림", "전문투자자만 거래 가능합니다.\n신청 자격요건을 확인하세요.", "MOVE_94002", 7, "전문투자자 신청", "확인")
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INIT_SCREEN" And sParam <> "" And sParam <> null Then
		contList.grdList.setUseCardView(true, 10, "btn_12_n.9")
	
		contInput.btnSwitch.setApplySwitch("OFF", "ON", 261, 261, 127, 289)
		
		g_szAcno = Left(sParam, 8)
		g_szAsno = Right(sParam, 2)
		
		contList.grdList.SetClear()
		
		'CDS 매수 신청 대상 조회
		DATAMANAGER.RequestTranData( "obsat_cdss_001r" )
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "MOVE_88026" And sRet == "ok" Then
		'CDS 계약신청 화면으로 이동 
		Form.OpenScreen("88026" , "")
		
	ElseIf sKeyName == "MOVE_94002" And sRet == "ok" Then	
		'전문투자자 지정심사신청 화면으로 이동
		Form.OpenScreen("94002" , "")
	
	ElseIf sKeyName == "MOVE_81040" And sRet == "ok" Then
		'금융거래정보이용제공동의 화면으로 이동
		Form.OpenScreen("81040" , "")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'CDS 매수 신청 대상 조회
	If szTranID == "obsat_cdss_001r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "")
	End IF
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'CDS 매수 신청 대상 조회
	If szTranID == "obsat_cdss_001r" Then
		contList.lblNoQlfc.visible = false
		contList.grdList.visible = false
		contList.lblText.visible = false
		
		'신청 대상 리스트를 보여주기 전에 거래불가조건 체크
		Dim szUiPfinYn, szCdsPfinYn, szStplYn, szTrApltYn, szCnrcApltYn, szBdcrYn, szMngrQlfcYn, szAcdnTpCode
		szUiPfinYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_PFIN_YN" , 0)		'전문투자자 기간만료 여부
		szCdsPfinYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CDS_PFIN_YN" , 0)		'전문투자자 해당 여부
		szStplYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STPL_YN" , 0)			'계약승인전 거래신청 여부
		szTrApltYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_APLT_YN" , 0)		'거래중복신청 여부
		szCnrcApltYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CNRC_APLT_YN" , 0)	'계약미신청계좌 선택 여부
		szBdcrYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BDCR_YN" , 0)			'채무불이행자여부
		szMngrQlfcYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MNGR_QLFC_YN" , 0)	'관리자자격미등록상태 여부
		szAcdnTpCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACDN_TYPE_CODE" , 0)	'사고유형코드
		
		If szCdsPfinYn <> "Y" Then
			Form.MsgBox("알림", "전문투자자만 거래 가능합니다.\n신청 자격요건을 확인하세요.", "MOVE_94002", 7, "전문투자자 신청", "확인")
			contList.lblNoQlfc.visible = true
			contList.lblNoQlfc.caption = "전문투자자만 거래가 가능합니다."
			Exit Sub
		End If
		If szUiPfinYn <> "N" Then
			Form.ShowAlert("알림", "전문투자자 효력기간이 경과하였습니다.\n신청 자격요건을 확인하세요.")
			contList.lblNoQlfc.visible = true
			contList.lblNoQlfc.caption = "전문투자자만 거래가 가능합니다."
			Exit Sub
		End If
		If szCnrcApltYn <> "Y" Then
			Form.MsgBox("알림", "CDS 계약 신청 후 거래 가능합니다.", "MOVE_88026", 7, "신청하러 가기", "확인")
			contList.lblNoQlfc.visible = true
			Exit Sub
		End If
		If szStplYn <> "Y" Then
			Form.MsgBox("알림", "계약 승인 여부를 확인하세요.\n승인 후 신청 가능합니다.", "MOVE_88026", 7, "승인상태 확인", "확인")
			contList.lblNoQlfc.visible = true
			Exit Sub
		End If
'		If szTrApltYn == "Y" Then
'			Form.ShowAlert("알림", "오늘 신청한 거래가 있습니다.\n취소 후 신청 가능합니다.")
'			contList.lblNoQlfc.visible = true
'			Exit Sub
'		End If
		If szBdcrYn == "Y" Then
			Form.ShowAlert("알림", "채무불이행자는\n신청이 불가능합니다.")
			contList.lblNoQlfc.visible = true
			Exit Sub
		End If
		If szMngrQlfcYn == "N" Then
			Form.ShowAlert("알림", "계좌의 관리자가\n해당 상품의 판매자격을 미보유하여 신청이 불가능합니다.")
			contList.lblNoQlfc.visible = true
			Exit Sub
		End If
		If Trim(szAcdnTpCode) == "Y" Then
			Form.ShowAlert("알림", "사고 계좌는\n신청이 불가능합니다.")
			contList.lblNoQlfc.visible = true
			Exit Sub
		End If
		
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2"))
		
		If nCnt > 0 Then	
			contList.grdList.visible = true
			contList.lblText.visible = true
			
			Dim szName, szRate, szMinAmt, szPeriod, szPremium, szMarg, szMargRate
			For i = 0 to nCnt - 1
				contList.grdList.AddRow()
				
				szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "KOR_ISSU_ABWR_NAME" , i)
				szRate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_INVT_ERNN_INRT" , i)
				szMinAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_MIN_CNRC_AMT" , i)
				szPeriod = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_INVT_PRD_DYNU" , i)
				szPremium = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_PRMM_INRT" , i)
				szMarg = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_MARG_INRT" , i)
				szMargRate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "MARG_RATE" , i)
				
				'현금증거금이율의 소수점 이하가 전부 0이면 정수, 있으면 소수점 4자리로 표현
				'판단하는 기능이 있는지 몰라서 일단 이렇게 처리함
'				Dim tTemp
'				tTemp = Split(szMarg, ".")
'				If CInt(tTemp[1]) == 0 Then
'					szMarg = FormatNumber(szMarg, 0)
'				Else
'					szMarg = FormatNumber(szMarg, 4)
'				End If
				
				contList.grdList.SetCellData("bd_name", i, szName)
				contList.grdList.SetCellData("bd_rate", i, CDbl(szRate))
				contList.grdList.SetCellFgColor("bd_rate", i, "290")
				
				contList.grdList.SetCellData("bd_text", i, "(세전  |  이율 변경가능)")
				contList.grdList.SetCellData("bd_title1", i, "증거금")
				contList.grdList.SetCellData("bd_title2", i, "최소거래금액")
				contList.grdList.SetCellData("bd_title3", i, "투자기간")
				contList.grdList.SetCellData("bd_title4", i, "CDS프리미엄")
				contList.grdList.SetCellData("bd_title5", i, "현금증거금이율")
				
				contList.grdList.SetCellData("bd_min", i, szMinAmt)
				contList.grdList.SetCellData("bd_period", i, szPeriod)
				contList.grdList.SetCellData("bd_premium", i, CDbl(szPremium))
				contList.grdList.SetCellData("bd_int", i, CDbl(szMarg))
				contList.grdList.SetCellData("bd_marg", i, szMargRate)
				
				contList.grdList.SetCellImage("bd_detail", i, "img_bgbox.9.png")
				contList.grdList.SetCellImage("bd_reg", i, "btn_01_n.9.png")
				
				contList.grdList.SetCellData("bd_detail", i, "설명서")
				contList.grdList.SetCellData("bd_reg", i, "신청하기")
				
				'신청화면으로 넘길 데이터 세팅
				contList.grdList.SetCellData("Data1", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "KOR_ISSU_ABWR_NAME" , i))
				contList.grdList.SetCellData("Data2", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ISCD" , i))
				contList.grdList.SetCellData("Data3", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_INVT_PRD_DYNU" , i))
				contList.grdList.SetCellData("Data4", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_PRMM_NOMN_INRT" , i))
				contList.grdList.SetCellData("Data5", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_PRMM_INRT" , i))
				contList.grdList.SetCellData("Data6", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_MARG_INRT" , i))
				contList.grdList.SetCellData("Data7", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_SALE_PAY_INRT" , i))
				contList.grdList.SetCellData("Data8", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_INVT_ERNN_INRT" , i))
				contList.grdList.SetCellData("Data9", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CDS_MIN_CNRC_AMT" , i))
				contList.grdList.SetCellData("Data10", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "MARG_RATE" , i))
				contList.grdList.SetCellData("Data11", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ATCH_FILE_PATH_NAME" , i))
				contList.grdList.SetCellData("Data12", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ATCH_FILE_ORTX_NAME" , i))
				contList.grdList.SetCellData("Data14", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "RNVS_FIN_DATE" , i))
				
				'거래건수(중복신청 확인용)
				contList.grdList.SetCellData("Data13", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "TR_CSNU" , i))
			Next
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubText <> "" And szSubText <> null Then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	Else
		Form.ShowAlert("알림", szMsgText)
	End If
End Sub

'============================================================================
Sub contList_grdList_OnClickUp(lRow, szCellID)
	Dim szSendData
	
	'설명서
	If szCellID == "bd_detail" Then
		Dim szPath, szPathName
		szPath = contList.grdList.GetCellData("Data11", lRow)
		szPathName = contList.grdList.GetCellData("Data12", lRow)
'		Form.ShowAlert(szPathName, g_szUrl & szPath)
		
		Form.OpenPdfViewer(Trim(g_szUrl) & szPath, "유의사항")
		
	ElseIf szCellID == "bd_reg" Then
		'신청가능시간 체크
		Dim szTime
		szTime = Form.GetSharedData("&HOST_TIME", false)
		
		'************************ test 목적으로 09시~21시까지 시간 체크 *****************************
'		If CInt(szTime) < 90000 Or CInt(szTime) > 210000 Then
		If CInt(szTime) < 90000 Or CInt(szTime) > 150000 Then
			Form.ShowAlert("알림", "신청 가능 시간이 아닙니다.\n신청가능시간 09:00 ~ 15:00")
			Exit Sub
		End If
		
		'거래중복신청여부 체크
		Dim nTrCsnu
		nTrCsnu = CInt(contList.grdList.GetCellData("Data13", lRow))
		If nTrCsnu > 0 Then
			Form.ShowAlert("알림", "오늘 신청한 거래가 있습니다.\n취소 후 신청 가능합니다.")
			Exit Sub
		End If
		
		'채무불이행자 체크
		Dim szBdcrYn 
		szBdcrYn = DATAMANAGER.GetDataValue(0, "obsat_cdss_001r" , "OutBlock1" , "BDCR_YN" , 0)
		If szBdcrYn == "Y" Then
			Form.ShowAlert("알림", "채무불이행자는\n신청이 불가능합니다.")
			Exit Sub
		End If
		
		'임직원체크
		Dim szEmployYn
		szEmployYn = DATAMANAGER.GetDataValue(0, "obsat_cdss_001r" , "OutBlock1" , "DREM_YN" , 0)
		If szEmployYn == "Y" Then
			Form.ShowAlert("알림", "임직원은 신청이 불가능합니다.")
			Exit Sub
		End If
		
		'금융거래정보이용제공동의 체크
		Dim szAgrmYn
		szAgrmYn = DATAMANAGER.GetDataValue(0, "obsat_cdss_001r" , "OutBlock1" , "AGRM_YN" , 0)
		If szAgrmYn <> "Y" Then
			Form.MsgBox("알림", "금융거래정보이용제공동의서(장외파생거래) 신청 후 거래 가능합니다.", "MOVE_81040", 7, "신청하러 가기", "확인")
			Exit Sub
		End If
		
		Dim szData1, szData2, szData3, szData4, szData5, szData6, szData7, szData8, szData9, szData10, szData11, szData12, szData13, szData14
		szData1 = contList.grdList.GetCellData("Data1", lRow)
		szData2 = contList.grdList.GetCellData("Data2", lRow)
		szData3 = contList.grdList.GetCellData("Data3", lRow)
		szData4 = contList.grdList.GetCellData("Data4", lRow)
		szData5 = contList.grdList.GetCellData("Data5", lRow)
		szData6 = contList.grdList.GetCellData("Data6", lRow)
		szData7 = contList.grdList.GetCellData("Data7", lRow)
		szData8 = contList.grdList.GetCellData("Data8", lRow)
		szData9 = contList.grdList.GetCellData("Data9", lRow)
		szData10 = contList.grdList.GetCellData("Data10", lRow)
