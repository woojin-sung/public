						<CELL cell_ly="0,2,0,2" fgcolor="146:124124124" halign="0" line="0,0" caption="투자수익률" fontsize="-1" impidxs="" />
						<CELL cell_ly="1,2,1,2" fgcolor="146:124124124" halign="2" line="0,0" fontsize="-1" mask="0,0,,%,0,,2,1,1,0,0" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="146:124124124" halign="0" line="0,0" caption="프리미엄 이율" fontsize="-1" impidxs="" />
						<CELL cell_ly="1,3,1,3" fgcolor="146:124124124" halign="2" line="0,0" fontsize="-1" mask="0,0,,%,0,,2,1,1,0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="146:124124124" halign="0" line="0,0" caption="증거금 이율" fontsize="-1" impidxs="" />
						<CELL cell_ly="1,4,1,4" fgcolor="146:124124124" halign="2" line="0,0" fontsize="-1" mask="0,0,,%,0,,2,1,1,0,0" impidxs="" />
					</CELL_INFO>
