'============================================================================
' 50300_SELECT_URL : 매거진 본문에서 링크화면으로 이동 시, 보고있던 매거진 URL 저장
'============================================================================
Function OpenPrevMgz()

	'링크화면에서 이동하여 보고있던 매거진URL이 저장되어 있으면 자동으로 열어준다.
	sPrevMgzUrl = Form.GetSharedData("50300_SELECT_URL", true)

	if sPrevMgzUrl <> "" then
		Form.OpenPopup("nrshidx50310" , sPrevMgzUrl , "")
	end if

End Function
