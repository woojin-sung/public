	<SCRIPT_INFO _len="8149" _ulen="7827" >
Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()
	
	gOsType = Form.GetSharedData("&OS_TYPE", false)

	Image0.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	LabelScreenTitle.paddinginfo = "0,0,0,0"
	LabelTitle0.paddinginfo = "0,0,0,0"
	LabelTitle1.paddinginfo = "0,0,0,0"
	LabelTitle2.paddinginfo = "0,0,0,0"
	
	DATAMANAGER.RequestTranData("ooopc_rprt_002r")

	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "ooopc_rprt_002r"  then
		
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_GRP_ID" 				, 0 , "bascGrp")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_ID" 					, 0 , "EtfMgz")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_CNTT_DIV_CODE" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_CNTT_WRTR_NAME" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "BBS_CNTT_TITL_NAME" 		, 0 , "%")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "STA_DATE" 				, 0 , "00000000")
		DATAMANAGER.SetDataValue(0, "ooopc_rprt_002r", "InBlock1", "FIN_DATE" 				, 0 , "99999999")
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ooopc_rprt_002r"  then
		
		nCnt = DATAMANAGER.GetDataCount(0, "ooopc_rprt_002r", "OutBlock1")
		
		if nCnt == 0 then
			
			LabelGuideText.visible = true
			imgNotice.visible = true
			Exit Sub
			
		elseif nCnt > 3 then
		
			nCnt = 3
			LabelGuideText.visible = false
			imgNotice.visible = false
			
		end if
		
		for i = 0 to nCnt - 1
		
			sTitle 	= DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TITL_NAME" , i)
			sThumPath = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_SPLM_ITEM_VAL13" , i)
			sContentsUrl = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TURN_NO" , i)
			
			if sContentsUrl <> "" then
				sContentsUrl = GetTotalUrlPath("contents",sContentsUrl)
			else
				sContentsUrl = ""
			end if
			
			
			if sThumPath <> "" then
				sThumPath = GetTotalUrlPath("image",sThumPath)
			else
				sThumPath = ""
			end if
			
			
			if i == 0 then
			
				LabelTitle0.visible = true
				ImageThum0.visible = true
				
				LabelTitle0.SetMaxLineCount(1)
				LabelTitle0.caption = sTitle
				
				LabelUrl0.caption = sContentsUrl
				
				if gOsType == "1" then
					ImageThum0.SetImageUrl(sThumPath)
				else
					ImageThum0.imagetarget = 2
					ImageThum0.imgpath = sThumPath
				end if
				
				
			elseif i == 1 then
			
				separator0.visible = true
				LabelTitle1.visible = true
				ImageThum1.visible = true
			
				LabelTitle1.SetMaxLineCount(1)
				LabelTitle1.caption = sTitle
				
				LabelUrl1.caption = sContentsUrl
				
				if gOsType == "1" then
					ImageThum1.SetImageUrl(sThumPath)
				else
					ImageThum1.imagetarget = 2
					ImageThum1.imgpath = sThumPath
				end if
			
			elseif i == 2 then
				
				separator1.visible = true
				LabelTitle2.visible = true
				ImageThum2.visible = true
			
				LabelTitle2.SetMaxLineCount(1)
				LabelTitle2.caption = sTitle
				
				LabelUrl2.caption = sContentsUrl
				
				if gOsType == "1" then
					ImageThum2.SetImageUrl(sThumPath)
				else
					ImageThum2.imagetarget = 2
					ImageThum2.imgpath = sThumPath
				end if
			
			end if
		
		next
		
		'이전에 열었던 매거진 URL 존재 시, 자동으로 열어줌.
		OpenPrevMgz()
		
	end if
	
End Sub


'============================================================================
Sub lbl1_OnClick()
	
	MoveScreen("more")
	
End Sub

'============================================================================
Sub Image0_OnClick()

	MoveScreen("more")
	
End Sub

'============================================================================
Function MoveScreen(sGubun)
	
	Form.triggerEvent("#", "SAVE_ETF_HOME_SCROLL", "")
	
	if sGubun == "more" then
	
		Form.OpenScreen("50300" , "")
	
	end if

End Function

'============================================================================
' 썸네일 및 본문 URL 가져오기
'============================================================================
Function GetTotalUrlPath(sGubun,sPath)

	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	'-------------------------
	' 본문 링크주소
	'-------------------------
	if sGubun = "contents" then
		
		if CInt(szMode) == 0 then
			'szUrl = "https://home.imeritz.com/mobile/mts/etfMgz.html?bbsCnttTurnNo="..Cint(sPath)			'운영계 주소
			szUrl = "https://home.imeritz.com/bbs/mwCtn1.do?bbsId=EtfMgz&bbsCnttTurnNo="..Cint(sPath)		'운영계 주소
		elseif CInt(szMode) == 1 then
			'szUrl = "https://testhome.imeritz.com/mobile/mts/etfMgz.html?bbsCnttTurnNo="..Cint(sPath)		'테스트계주소
			szUrl = "https://testhome.imeritz.com/bbs/mwCtn1.do?bbsId=EtfMgz&bbsCnttTurnNo="..Cint(sPath)	'테스트계주소
		end if
	
	'-------------------------
	' 썸네일 링크주소
	'-------------------------
	else
		if CInt(szMode) == 0 then
			szUrl = "https://home.imeritz.com"..sPath		'운영계 주소
		elseif CInt(szMode) == 1 then
			szUrl = "https://testhome.imeritz.com"..sPath		'테스트계주소
		end if
	end if
	
	return szUrl
	
End Function

