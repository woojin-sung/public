'============================================================================
' 화 면 명 : 채권주문_가격입력창
' 화면설명 : 채권주문 가격입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
' 20160602 NOHES 채권 주문가격 소수점 둘째짜리까지 표현 방식으로 변경
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szPrc, g_szQty, g_szCd, g_szMk, g_szUnit, g_szType, g_szODER_ABLE_AMT, g_szTab, g_szModGbn
Dim g_sIsFirst
Dim g_bPoint

Dim g_szFocusType		'(단가=0수량=1금액=2)
Dim g_bFirstClear	'키패드 첫 클릭 시 현재 포커싱 된 곳 초기화 후 키패드 삽입
g_bFirstClear = false
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' 20160602 틱단위 수정
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn, szPM)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, nResult
	
	szPrc  = edtPrc.caption
'	szUnit = "1"
	If Trim(szPM) == "" or Trim(szPM) == "0" or Trim(szPM) == " " Then
		szUnit = "1"
	Else
		szUnit = Trim(szPM)
	End If


	szHyun = tblData.GetCellString(1, 1)
	
	CDbl decP2
	'20230122_01 HWG START : 거래소차세대 대응
	decP2 = Round(Cdbl(FormatNumber(szPrc, 2)) Mod Cdbl(FormatNumber(szPM, 2)),2) 'Round(CDbl(szPrc) Mod CDbl(szUnit), 2)
	'20230122_01 HWG END
	'decP2 = Round(CDbl(szPrc) Mod CDbl(szPM), 2)
	
	if Trim(szUnit) == "" then
			szUnit = "1"
	end if
		
	if Trim(szPrc) == "" then
			szPrc = szHyun
	else
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			szPrc = CDbl(szPrc) + CDbl(szUnit) - decP2
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then		
			if CDbl(szPrc) > 0 then'else
				if decP2 > 0 Then
					szPrc = CDbl(szPrc) - decP2
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit) - decP2
				end if
			end if
		end if
	end if
	
	Sum_Prc(szPrc,0 )
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nPlus)

	if CInt(g_szFocusType) > 0 then	'수량, 금액
		QtyCalc_Plus(0, nPlus)
		Exit Function	
	end if
	
	Dim szPrc
	szPrc = edtPrc.caption
'	if Trim(szPrc) == "" then
'		szPrc = 0
'	end if

	'처음 숫자는 초기화
	if g_sIsFirst == true then
		g_sIsFirst = false
		szPrc = nPlus
		edtPrc.caption = szPrc
	else
		if szPrc == "0" or szPrc == "0.0" or szPrc == "0.00" Then
			edtPrc.caption = nPlus
			Exit Function
		End if
		
		szChk = Instr( edtPrc.caption,  ".")
		
		If CStr(szChk) <> "0" Then
			szCha = CInt(Len(edtPrc.caption) - szChk)
			if CStr(szCha) == "2" Then
				Exit Function
			End if
		End If
		'20160602 NOHES START
		If g_bPoint == True Then
			If CStr(Instr(szPrc, ".")) <> "0" Then
				szPrc = szPrc & nPlus		
			else
				szPrc = szPrc&"."&nPlus
			end if	
			Sum_Prc(szPrc, 1)
		else
			szPrc = szPrc & nPlus
			Sum_Prc(szPrc,1)
		End If
		'20160602 NOHES END
	end if
	
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	If CInt(g_szFocusType) > 0 then
		Calc_QtyZero(szPlus)
		exit Function
	End If

	Dim szPrc
	szPrc = edtPrc.caption
	
	If szPlus == "0" or szPlus == "00" then
		If szPrc == "0" or szPrc == "0.0" or szPrc == "0.00" Then
			Exit Function
		ElseIf szPrc == "" Then
			edtPrc.caption = "0"
			Exit Function
		End If
	End If
		
	szChk = Instr(edtPrc.caption, ".")

	If CStr(szChk) <> "0" Then
		If Trim(szPlus) == "." Then
			Exit Function
		Else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == "2" Then
				Exit Function
			ElseIf CStr(szCha) == "1" Then
				If Len(szPlus) == 1 Then
					szPrc = edtPrc.caption & szPlus
					Sum_Prc(szPrc, 1)
				End If
				
				Exit Function
			End If
		End If
	End If
	
	if Len(edtPrc.caption) > 0 then
		szPrc = edtPrc.caption & szPlus
		Sum_Prc(szPrc, 1)
	end if
End Function
'============================================================================
' Calc_QtyZero
'============================================================================
Function Calc_QtyZero(szPlus)
	Dim szQty
	szQty = edtQty.caption
	szAmt = lblOrderPrice.caption
	if CInt(g_szFocusType) = 2 then
		szQty = szAmt
	end if
	
	if Len(szQty) > 0 then
		szQty = szQty & szPlus
		
		Sum_Qty(szQty)
	end if
End Function
'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData, nGbn)
	if Len(szData) < 16 then
		If nGbn == 0 Then
			szData = Set_Unit(szData)
		End If
		edtPrc.caption = szData
		
		edtPrc_OnEditComplete()
	end if
End Function	

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData)
	Dim szChk
	
	szChk = InStr(CStr(szData), ".")
	
	if CStr(szChk) == "0" then
		return szData & ".00"
	else
		szCha = CInt(Len(szData) - szChk)
		
		if CStr(szCha) == "1" then 
			return szData & "0"
		end if
		
	end if
	
	return szData
End Function


'============================================================================
' Request_Data
'============================================================================
Function Request_Data()
	DATAMANAGER.RequestTranData("ohhts_7052_001r")	
	DATAMANAGER.RequestTranData("ohhts_7052_005r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	szOpen = Form.GetOpenLinkData()
	
'	Form.ShowAlert("szOpen", szOpen)
	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
	
		g_szPrc 				= tData(0)	'가격
		g_szQty 				= tData(1)	'수량
		g_szMk   			= tData(2)	'종목구분
		g_szCd   			= tData(3)	'종목코드
		g_szODER_ABLE_AMT		= tData(4)	'주문가능금액/수량
		g_szFocusType			= tData(5)	'입력구분 - 0:가격 1:수량 2:금액
		g_szTab				= tData(6)	'탭 		 - 0:매수 1:매도 2●0:매수정정 2●1:매도정정
		if left(g_szTab, 1) = "2" then
			g_szTab = "2"
			g_szModGbn = right(g_szTab,1)
		end if
		
		if Trim(g_szPrc) <> "" then
			edtPrc.caption = g_szPrc
		end if
		if Trim(g_szQty) <> "" then
			edtQty.caption = g_szQty
		end if
		
		f_Cal_Order_Prc()
		f_SetFocus(g_szFocusType)
		Request_Data()
	else
		f_SetFocus("0")
	end if
	
	g_sIsFirst = true
	
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_smbd_aspr")
	DATAMANAGER.CancelRealData("ohhts_bond_aspr")
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg")
	DATAMANAGER.CancelRealData("ohhts_bond_cntg")
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_7052_005r" then
		DATAMANAGER.ClearInputData(0, "ohhts_7052_005r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 현재가
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_7052_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_7052_001r")

		DATAMANAGER.SetDataValue(0,"ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0,"ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	' ----------------------------------------------------------------------
	' 최대주문가능수량(매수)
	' ----------------------------------------------------------------------			
	elseif szTranID = "obtrs_comn_420r" then
		acc = Form.GetSharedData("BOND_ORDER_ACC", false )
		acc_total = left(acc, 8)
		acc_seq = right(acc, 2)
	    DATAMANAGER.ClearInputData(0, szTranID)
	    if g_szMk = "SB" then
		    szMkCd = "02"
		else
		    szMkCd = "01"
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, acc_total)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, acc_seq)			' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, g_szCd)			' 종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BOND_ODER_UNPR"		, 0, edtPrc.caption)	' 주문가격
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BOND_MKPL_CLS_CODE" 	, 0, szMkCd ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 	, "1" )				' 최대가능
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------			
	if szTranID = " ohhts_7052_005r" then
		if g_szMk == "B" then' 일반채권(호가&체결)
		   DATAMANAGER.RequestRealData( "ohhts_bond_aspr" )
	    else ' 소액채권(호가&체결)	
		   DATAMANAGER.RequestRealData( "ohhts_smbd_aspr" )
		end if   
	' ----------------------------------------------------------------------
	' 현재가
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_7052_001r" then
		if g_szMk = "B" then		
			DATAMANAGER.RequestRealData("ohhts_bond_cntg")
		else
			DATAMANAGER.RequestRealData("ohhts_smbd_cntg")
		end if
		Form.SetTimerEvent2("1", 1, 0.2)
	' ----------------------------------------------------------------------
	' 최대주문가능수량(매수)
	' ----------------------------------------------------------------------			
	elseif szTranID = "obtrs_comn_420r" then
		szQty = DATAMANAGER.GetDataValue( 0, "obtrs_comn_420r", "OutBlock1", "ODER_ABLE_QTY", 0)
		edtQty.caption = szQty
		f_Cal_Order_Prc()
	end if
	

End Sub

