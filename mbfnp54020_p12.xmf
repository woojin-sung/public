'============================================================================
' QtyCalc_Plus	수량&금액 계산
'============================================================================
Function QtyCalc_Plus(nGbn, nPlus)
	Dim szQty
	szQty = edtQty.caption
	szAmt = lblOrderPrice.caption
	if CInt(g_szFocusType) = 2 then
		szQty = szAmt
	end if
	
	if nGbn == 1 then
		if Trim(szQty) == "" then
			szQty = 0
		end if
		
		szQty = CDbl(szQty) + nPlus
	else
		
		'처음 숫자는 초기화
		if g_sIsFirst == true then
			g_sIsFirst = false
			szQty = nPlus
		else
			szQty = szQty & nPlus
		end if
		
	end if
	
	Sum_Qty(szQty)
End Function
'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			nResult = CDbl(szQty) Mod nUnit
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = szQty - nUnit
				nResult = CDbl(szQty) Mod nUnit
				
				if nResult <> 0 then
					nResult = nUnit - nResult
					szQty = CDbl(szQty) + nResult
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	if CInt(g_szFocusType) = 1 then
		if Len(szData) < 16 then
			edtQty.caption = szData
		end if
		
		edtQty_OnEditComplete()
	elseif CInt(g_szFocusType) = 2 then
		lblOrderPrice.caption = szData
		f_Calc_Prc_Qty()
		
	end if
	
End Function

'============================================================================
Sub contQty_btnMax_OnClick()
	f_SetFocus("1")'(단가=0수량=1금액=2)
	g_bFirstClear = true
	if g_szODER_ABLE_AMT == "" then
		g_szODER_ABLE_AMT = 0
	end if
	
	if g_szTab == "0" then
		'20230628 htw start 단가 0일 경우 수량 0으로 설정
		if g_szPrc == "" or Clng(g_szPrc) == 0 then
			edtQty.caption = "0"
		else	'매수-최대수량 서비스 조회(채권: 당일결재 - 수수료제비용 포함계산, 주식:D+2결재 - 단순계산)
'			nODER_ABLE_AMT = Cdbl(g_szODER_ABLE_AMT) * 1000
'			nPrc = Cdbl(g_szPrc) * 100
'			edtQty.caption = Cdbl(Cdbl(nODER_ABLE_AMT) / Cdbl(nPrc))
			DATAMANAGER.RequestTranData("obtrs_comn_420r")	'최대가능수량 서비스 조회
			exit sub
		end if
		'20230628 htw start 단가 0일 경우 수량 0으로 설정
	elseif g_szTab == "1" or g_szTab == "2" then	'매도/정정
		edtQty.caption = g_szODER_ABLE_AMT
	end if
	
	f_Cal_Order_Prc()
End Sub
'============================================================================
' AmtCalc_Plus	금액 계산
'============================================================================
Function AmtCalc_Plus(nGbn, nPlus)
	Dim szAmt
	szAmt = lblOrderPrice.caption
	if nGbn == 1 then
		if Trim(szAmt) == "" then
			szAmt = 0
		end if
		
		szAmt = CDbl(szAmt) + nPlus
	else
		
		'처음 숫자는 초기화
		if g_sIsFirst == true then
			g_sIsFirst = false
			szAmt = nPlus
		else
			szAmt = szAmt & nPlus
		end if
		
	end if
	
	lblOrderPrice.caption = szAmt
End Function

'============================================================================
Function f_Cal_Order_Prc()
	Dim szQty, szPrc
	if Trim(edtPrc.caption) = "" then
		szPrc = 0
	else
		szPrc = CDbl(edtPrc.caption) * 100
	end if
	if Trim(edtQty.caption) = "" then
		szQty = 0
	else
		szQty = CDbl(edtQty.caption)
	end if
	
	lblOrderPrice.caption = CDbl(szPrc) * Clng(szQty) / 1000
End Function
'============================================================================
function f_Calc_Prc_Qty()
	Dim nNum,nPrc,nQty
	nNum = Cdbl(lblOrderPrice.caption) * 1000
	nPrc = Cdbl(g_szPrc) * 100
	
	if nPrc <> 0 then
		edtQty.caption = Clng(nNum / nPrc)
	else
		edtQty.caption = 0
	end if
	
end function
'============================================================================
Sub edtPrc_OnEditComplete()
	f_Cal_Order_Prc()
End Sub

'============================================================================
Sub edtQty_OnEditComplete()
	f_Cal_Order_Prc()
End Sub

'============================================================================
Sub btnQMinus_OnClick()
	f_SetFocus("1")
	Calc_Qty(1)
End Sub

'============================================================================
Sub btnQPlus_OnClick()
	f_SetFocus("1")
	Calc_Qty(0)
End Sub

'============================================================================
Sub btnClear_OnClick()
	if g_bFirstClear == false then
		g_bFirstClear = true
	end if
	
	if g_szFocusType == "0" then'(단가=0수량=1금액=2)
		g_szPrc = "0"
		edtPrc.caption = g_szPrc 'FormatNumber(g_szPrc,0).." 원"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "1" then
		edtQty.caption = "0"
		f_Cal_Order_Prc()
	elseif g_szFocusType == "2" then
		lblOrderPrice.caption = "0"
		f_Calc_Prc_Qty()
	end if
End Sub


'============================================================================
Sub grdPrc_OnClickUp(lRow, szCellID)
	nPrc = grdPrc.GetCellData("bd_prc", lRow)
	edtPrc.caption = nPrc
	g_szPrc = nPrc
	f_SetFocus("0")'(단가=0수량=1금액=2)
	g_bFirstClear = false
	edtPrc_OnEditComplete()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	' ----------------------------------------------------------------------
	' 최대주문가능수량(매수)
	' ----------------------------------------------------------------------			
	if szTranID = "obtrs_comn_420r" then
		edtQty.caption = 0
		f_Cal_Order_Prc()
	end if
End Sub

