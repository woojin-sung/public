'============================================================================
Function f_SetFocus(szFocusType)
	if szFocusType == "0" then'단가
		lblTitle.caption = "단가 입력"
		'상한가 하한가 시장가 버튼
		contPrc.visible = 		true
		contQty.visible = 		false
		contOrderPrice.visible = 	false
		
		btnPMinus0.visible = true
		btnPMinus.visible = false
		btnPPlus0.visible = true
		btnPPlus.visible = false
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
		
		btnPlus00.visible = false
		btnpoint.visible = true
		
		edtPrc.imagefilepth = "input_07_o.9"
		edtQty.imagefilepth = "input_07_n.9"
		imgOrderPrc.imgpath = "input_06_n.9"
		
	elseif szFocusType == "1" then'수량
		lblTitle.caption = "수량 입력"
		'가능 10주 100주 1000주 버튼
		contPrc.visible = 		false
		contQty.visible = 		true
		contOrderPrice.visible = 	false
		
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = true
		btnQMinus.visible = false
		btnQPlus0.visible = true
		btnQPlus.visible = false
		
		btnPlus00.visible = true
		btnpoint.visible = false
		
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_o.9"
		imgOrderPrc.imgpath = "input_06_n.9"

	elseif szFocusType == "2" then'금액
		lblTitle.caption = "금액 입력"
		'10만 100만 1000만 내잔고 버튼
		contPrc.visible = 		false
		contQty.visible = 		false
		contOrderPrice.visible = 	true
		
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
		
		btnPlus00.visible = true
		btnpoint.visible = false
		
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_n.9"
		imgOrderPrc.imgpath = "input_06_o.9"
	end if
	
	'20230705 htw start 포커스가 달라질 경우 clear 플레그 초기화
	if g_szFocusType <> szFocusType then
		g_bFirstClear = false
	end if
	'20230705 htw end 포커스가 달라질 경우 clear 플레그 초기화
	
	g_szFocusType = szFocusType
	
end function


