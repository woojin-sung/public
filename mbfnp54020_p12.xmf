'============================================================================
' NOHES setcomma : 콤마셋팅
'============================================================================
Function SetComma(szData)
	If CStr(Instr(szData, ".")) <> "0" Then
		sInt = Left( szData, Instr(szData, ".")-1)			'정수부
		sMinor = Mid(szData, Instr(szData, "."), Len(szData))	'소수부

		sInt = CInt(sInt)
		If Len(sInt) < 4 Then
			return szData
		Else
			Dim stemp
			stemp = ""
			For i = 0 To Len(sInt)		
				If i<> 0 And i%3 == 0 Then
					stemp = ","&Mid(sInt,Len(sInt)-i+1, 1)&stemp
				else
					stemp = Mid(sInt,Len(sInt)-i+1, 1)&stemp
				End If	
			Next
			If Left(stemp, 1) == "," Then
				stemp = Mid(stemp, 2, Len(stemp))
			End If
			sData = stemp&sMinor
			return sData
		End If
	End If	
	
	
End Function

