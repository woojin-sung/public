'가격그리드 데이터 세팅 (현재가 기준 위/아래 10호가씩)
'============================================================================
Function Add_Prc()
	szHyun = tblData.GetCellString(1, 1)		'현재가
	szSdpr = tblData.GetCellString(1, 3)		'전일종가

	'현재가 없는 경우, 예외처리
	if szHyun = null or szHyun = "" then
		exit function 
	elseif CInt(szHyun) = 0 then
		exit function 
	end if
	
	If Trim(g_szCd) == "" Then
		exit function 
	Else
		nStep = CDbl(Form.GetItemCodeInfo(g_szCd, "bondunit"))
	End If
	
	'부동소수점 계산 오류로 100 곱한 상태로 계산
	szHyun = tblData.GetCellString(1, 1) * 100	'현재가
	szSdpr = tblData.GetCellString(1, 3) * 100	'전일종가
	nStep = nStep * 100	'가격단위

	lMax		= CDbl(szHyun + nStep * 10)
	lMin		= CDbl(szHyun - nStep * 11)

	If lMin < 0 then
		lMin = 0
	end if
	
	iCurPRow = 0
	i = 0 		 			'가격개수 저장
	szPrc = lMax		 		'시작가격
'	Form.ShowAlert(szPrc, nStep)
	while szPrc > lMin
		'전일대비율
'		debiVal = (szPrc - szSdpr) / szSdpr	
		grdPrc.AddRow()
		grdPrc.SetCellData("bd_prc",i, szPrc/100)
'		grdPrc.SetCellData("bd_debi",i, debiVal/100)
		
		'색상 세팅
		if szPrc > szSdpr then
			grdPrc.SetCellFgColor("bd_prc",i, "10")
'			grdPrc.SetCellFgColor("bd_debi",i, "10")
		elseif szPrc < szSdpr then
			grdPrc.SetCellFgColor("bd_prc",i, "11")
'			grdPrc.SetCellFgColor("bd_debi",i, "11")
		else
			grdPrc.SetCellFgColor("bd_prc",i, "12")
'			grdPrc.SetCellFgColor("bd_debi",i, "12")
		end if 
		
		szPrc = szPrc - nStep
		i = i +1
	wend
	
	if i = 21 then
		grdPrc.toprow = 5		'현재가 가운데로
	end if
End Function 


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2("1", 0, 0.2)
	Add_Prc()
End Sub

