			<TRAN tranid="obpds_srvc_312r" trcode="obpds_srvc_312r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_520r" trcode="obcsb_oimf_520r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
