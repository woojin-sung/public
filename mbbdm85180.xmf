'============================================================================
Sub BtnNext_OnClick()
	If BtnNext.caption == "확인" Then 			' 홈으로
		'2021.04.07. CloseForm 방식 변경
		'Form.OpenScreen("41000" , "")
		
		closeFlag = "2"
		Form.CloseForm()	
		
	ElseIf BtnNext.caption == "ID 등록" Then 		' ID등록화면으로
		Form.SetSharedData( "NMET_ACNO"		, getAcnoOutData )
		Form.SetSharedData( "mOTP_IntoClcd"	, "NMET_ACNT" )
		Form.OpenNextPopup( "mbbdm85230.xmf"	, "", "" )
	Else									' OTP등록화면으로
		Form.SetSharedData( "NMET_ACNO" 	, getAcnoOutData )
		Form.SetSharedData( "mOTP_IntoClcd"	, "NMET_ACNT" )
		Form.SetSharedData( "SCRC_YN"		, gScrcIsncYN )
		Form.OpenNextPopup( "mbotp86107.xmf"	, "", "" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_oimf_520r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INPUT_CLS"	, 0, "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"	, 0, gRcno )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_oimf_520r" Then
		szRsltCls	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RSLT_CLS", 0 )
		szElfnId	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ELFN_ID_EXST_YN", 0 )

		'2021.04.09. 김유경. HTS 약정여부(getHtsStplApltYn) N 인경우 로직 추가
		'HTS신청여부가 Y인경우에만 후속업무 가능
		If getHtsStplApltYn == "N" Then
			btnSkip.visible = False
			BtnNext.width	= 375
			BtnNext.caption = "확인"
		Else

			If szRsltCls == "3" And szElfnId == "Y" Then
				btnSkip.visible = False
				BtnNext.caption = "확인"
			ElseIf szRsltCls <> "3" Then 
			    '다음에하기, OTP등록/발급으로 분리
				'btnSkip.visible = False
				btnSkip.visible = True
				btnSkip.fgcolor = 269
				btnSkip.caption = "다음에 하기"
				BtnNext.left	= 187
				BtnNext.width	= 188
				BtnNext.caption = "OTP 등록/발급"
				If szRsltCls == "0" Then
					gScrcIsncYN = "Y"
				End If
			Else
				btnSkip.visible = True
				btnSkip.fgcolor = 269
				btnSkip.caption = "다음에 하기"
				BtnNext.left	= 187
				BtnNext.width	= 188
				BtnNext.caption = "ID 등록"
			End If	
		End If
		'2021.04.09. 김유경. HTS 약정여부(getHtsStplApltYn) N 인경우 로직 추가
		'HTS신청여부가 Y인경우에만 후속업무 가능
'		If getHtsStplApltYn == "N" Then
'			btnSkip.visible = False
'			BtnNext.width	= 587
'			BtnNext.caption = "확인"
'		End If
	End If
End Sub

'============================================================================
Sub btnSkip_OnClick()
	'홈으로 가기.
	Form.OpenScreen("41000" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	ShowAlert "안내", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
	Exit Sub	
End Sub

'============================================================================
Sub Form_OnFormClose()
	If closeFlag == "2" Then
		Form.OpenScreen( "41000" , "")
	End If
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    btnSkip_OnClick()
End Sub


	</SCRIPT_INFO>
