		DATAMANAGER.RequestTranData("obcpp_dgtl_003r")
	else
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcpp_dgtl_003r" then 
		DATAMANAGER.SetDataValue( 0, "obcpp_dgtl_003r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_dgtl_003r" then
		
		'sPppID는 개인화 팝업 각각의 ID이다.
		'OutBlock에 게시 순서에 대한 필드가 있지만,
		'서비스에서 게시 순서대로 Array로 내려주기로 해서,
		'화면에서는 순서 판단하지 않아도 된다.
		'배열 순서대로만 띄워주면 된다.
		sPppID = Array()
		sPppWeb = Array()
		sPppScr = Array()
		sPppflag = Array()
		
		for i = 0 to DATAMANAGER.GetDataCount(0, "obcpp_dgtl_003r", "OutBlock1") - 1
			sPppID(i)    = DATAMANAGER.GetDataValue( 0, "obcpp_dgtl_003r", "OutBlock1", "PPP_ID"          , i )
			sPppWeb(i)   = DATAMANAGER.GetDataValue( 0, "obcpp_dgtl_003r", "OutBlock1", "URL_ADDR"        , i )
			sPppScr(i)   = DATAMANAGER.GetDataValue( 0, "obcpp_dgtl_003r", "OutBlock1", "SCR_NO"   	   , i )
			sPppflag(i)  = DATAMANAGER.GetDataValue( 0, "obcpp_dgtl_003r", "OutBlock1", "PROS_CLS_CODE"   , i )
		next
		
		
		for i = DATAMANAGER.GetDataCount(0, "obcpp_dgtl_003r", "OutBlock1") - 1 to 0 step -1
			g_szData1 = sPppID(i)   & "★" & g_szData1
			g_szData2 = sPppWeb(i)  & "★" & g_szData2
			g_szData3 = sPppScr(i)  & "★" & g_szData3
			g_szData4 = sPppflag(i) & "★" & g_szData4
		next
		
		if Ubound(sPppID) < 0 then
			Form.CloseForm()
			exit sub
		else
			'Form.SetTimerEvent2("1", 1, 0.1)
			'20230731 SWJ START: OpenNextPopup으로 열면 iOS에서 웹에서 MTS 계좌개설화면 연동 시 까만 배경만 나오는 현상 수정
			'(notice_p0 이 7일간 보지 않기일 때 개인화 팝업도 뜰 경우만 재연되었음) 
			g_bCloseFlag = true
			Form.CloseForm()
		end if
	end if
End Sub

