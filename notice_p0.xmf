'============================================================================
'컨트롤 보임처리 함수
'============================================================================
Function ControlVisible(bTrue)
	Container0.visible = bTrue
	btnClose.visible = bTrue
	btnClose7.visible = bTrue
	Btn0.visible = bTrue
	ImgPop.visible = bTrue
	LblClose.visible = bTrue
	ImgClose.visible = bTrue
	Chk7days.visible = bTrue
	'Label0.visible = bTrue
	'Label1.visible = bTrue
	'Label2.visible = bTrue
	
	'20230904 LES START
	sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	if sDeviceOS == "2" then
		if g_sAppver <> "" and g_sAppver >= 2533 then
			Image3.visible = bTrue
		end if
	end if
	'20230904 LES END
	
	
End Function
