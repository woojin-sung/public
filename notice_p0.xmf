'============================================================================
Sub DATAMANAGER_OnRequestTranTimeout(szTranID)
	if szTranID == "obcpp_dgtl_003r" then
		Form.CloseForm()
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcpp_dgtl_003r" then
		Form.CloseForm()
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			'로그아웃실행
			'(1param(0:문구없음,1문구있음), 
			'2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
			Form.LogOut(0, 1) 		
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100" , "" , "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_bCloseFlag then
		Form.OpenPopup("notice_event" , g_szData1 & "♥" & g_szData2 & "♥" & g_szData3 & "♥" & g_szData4, "")
	end if
End Sub

'============================================================================
' 20231013 LES START - 플로팅배너 읽음처리 초기화(임시추가로직)
'============================================================================
Function FloatBanner_ReadCheck(sDeviceOS)

	'20231012_6 : MY업무 > MY자산 플로팅배너 키값
	szFloatBannerKey = "20231012_6"

	'-----------------------------------------
	'안드로이드
	'-----------------------------------------
	if sDeviceOS == "1" then
		
		szReadCheck = Form.GetEnvData(szFloatBannerKey)
		
		if szReadCheck == "1" then
			
			szReadCheckDate = Form.LoadConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate")
			
			'읽은날짜가 있으면 
			if szReadCheckDate <> "" then
			
				szToday = Form.GetSharedData("&HOST_DATE", false)
				
				'읽은날짜가 당일이 아니면 
				if szReadCheckDate <> szToday then
					
					'읽음처리/읽은날짜 클리어
					Form.SetEnvData(1,szFloatBannerKey, "0")
					Form.SaveConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate", "")
					
				end if
			
			else
			
				'읽은날짜가 없으면 오늘날짜로 세팅
				szToday = Form.GetSharedData("&HOST_DATE", false)
				Form.SaveConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate", szToday)
			
			end if
		
		end if
		
	'-----------------------------------------
	'iOS
	'-----------------------------------------
	elseif sDeviceOS == "2" then
		
		
		szReadCheck = Form.LoadConfigData("FloatBanner", szFloatBannerKey)
		
		if szReadCheck == "1" then
			
			szReadCheckDate = Form.LoadConfigData("FloatBanner", szFloatBannerKey.."_readCheckDate")
			
			'읽은날짜가 있으면 
			if szReadCheckDate <> "" then
			
				szToday = Form.GetSharedData("&HOST_DATE", false)
				
				'읽은날짜가 당일이 아니면 
				if szReadCheckDate <> szToday then
					
					'읽음처리/읽은날짜 클리어
					Form.SaveConfigData("FloatBanner", szFloatBannerKey, "0")
					Form.SaveConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate", "")
					
				end if
			
			else
			
				'읽은날짜가 없으면 오늘날짜로 세팅
				szToday = Form.GetSharedData("&HOST_DATE", false)
				Form.SaveConfigData("FloatBanner", szFloatBannerKey.."_readCheckDate", szToday)
				
			end if
		
		end if
		
		
	end if
	
End Function

'============================================================================
' 20231013 LES END 
'============================================================================
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20240802_01 HWG START
	if sKeyName == "prevnotice" then
		sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
		
		'20211026 SWJ START : 안드로이드 targetSDK verison30 관련 안내 팝업 게시
		szAppVer = Form.GetSharedData("&APP_VERSION", False)
		szData = Split(szAppVer, ".")
		szAppVer = Cint(szData(0) & szData(1) & szData(2))
		g_sAppver = szAppVer '20230904 LES
		
		sOSVrsn		=	Form.GetSharedData("&OS_VERSION", false)
		szAppVerCode  = 	Form.GetSharedData("&APP_VERSION_CODE", False)
		
		'20220913 SWJ START
		g_sUserID 	= Form.GetSharedData("&USER_ID" , false)
		'20220913 SWJ END
		
		'20231013 LES START
		FloatBanner_ReadCheck(sDeviceOS)
		'20231013 LES END
		
		'20240710 SWJ START
		'권리선반영 플래그용으로
		'notice_p0에서 만든다.
		'앞으로 권리선반영 배포가 있을 경우 notice_p0에서만 하면 된다.
		Form.SaveConfigData("NoticeSetting", "AbroadAgreement_StartDate", "20240715")
		Form.SaveConfigData("NoticeSetting", "AbroadAgreement_EndDate", "20240717")
		Form.SaveConfigData("NoticeSetting", "AbroadAgreement_BswrClcd", "10")
		Form.SetSharedData("AbroadAgreement_PopupYN", "Y")
		'20240710 SWJ END
		
		if sDeviceOS = "1" then
			
			Image3.visible = false
	
		elseif sDeviceOS = "2" then
	'		
			'2.5.33 버전부터 다시 그냥 띄워줌
			'ios 2.5.8 버전부터 공지팝업 메인에서 애니메이션 처리해줌
			if szAppVer >= 2533 then
				Image3.visible = false '20230904 LES
				
			else
				Image3.visible = false
				Image4.visible = false
			end if
		end if
		'20211026 SWJ END
		
		'20220509 SWJ START : 고객 이벤트 메뉴에 같은 화면 추가
		szScreen = Form.GetSharedData("&SCREEN_NO", false)
		
		'20230421 SWJ START: 블랙테마 없애기
		Form.SetEnvData(1, "common.theme", "white")	
		'20230421 SWJ END
		
		Dim saveDate
		Dim calcDate
		
		g_Savekey = Form.GetOpenLinkData( )
		
		saveDate = Form.LoadConfigData("NoticeSetting", "notice_20240809") '20210508 HSZ 
		todayDate = Form.GetSharedData("&HOST_DATE",0)
		
		if saveDate <> "" then
			
			ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
			RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
			
			calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))
	
			if calcDate <= 7 then
				
				'20220913 SWJ START
				if g_sUserID <> "" then
					DATAMANAGER.RequestTranData("obcpp_dgtl_003r")
				else
					Form.CloseForm()
				end if
				'20220913 SWJ END	
			
			'20220913 SWJ START
			'7일간 보지 않기인데, 개인화팝업을 호출해야하는 경우
			'깜빡이면서 화면이 닫히는 현상 개선
			else
				ControlVisible(True)
			end if
		else
			ControlVisible(True)
		end if
		
		'글자색 진하게
		'Container0.Label0.fontbold = 1
		Container0.btnClose.fontbold = 1
		Container0.btnClose7.fontbold = 1
		
		LblClose.setNeighborCtlPos("ImgClose","right", 10,"")
		Container0.setScrollBarVisible("0")
	end if
	' 20240802_01 HWG END
End Sub

