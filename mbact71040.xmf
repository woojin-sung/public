Sub acnt0_ChangeAccount()
	'20230904 KKM 자동투자내역 제외 체크값 추가 : Super365 200, CMA계좌 118 인 경우
	'ChkCMAYN.checkstate = 0
	if acnt0.itemcodetype == "200" or acnt0.itemcodetype == "118" then 
		if g_FormTabIndex == 1 or g_FormTabIndex == 3 then 
			ChkCMAYN.visible = 0
		else
			ChkCMAYN.visible = 1
		end if	
	else
		ChkCMAYN.visible = 0
	end if	
	SetTrigger(g_FormTabIndex)
End Sub

