'============================================================================
Sub ImgBackPress_OnClick()
	'Form.CloseForm()
	Form.OpenPrevScreen()
End Sub


'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbact71040", "ChkCMAYN", ChkCMAYN.checkstate)	
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.SetSharedData("mbact71040_p2_acno" , Mid(acnt0.Caption, 1, 8)) 'v002
	Form.SetSharedData("mbact71040_p2_asno" , Mid(acnt0.Caption, 9, 2))
'	Form.MsgBox("알림", Mid(acnt0.Caption, 1, 8), "", 0)
'	Form.MsgBox("알림",Mid(acnt0.Caption, 9, 2), "", 0)
	Form.OpenPopup("mbact71040_p2" , "" , "")
End Sub

'============================================================================


'============================================================================
Sub btnDate_OnClick()
	Dim szData 'v002
	
	szData = g_szDateType		& "|" &
			g_szStartDate		& "|" &
			g_szEndDate
			
	Form.OpenPopupAnimation("mbact71040_p3", szData,  "",  2)
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "SEARCH_DATE" then 'v002
		'조회 날짜 선택 후
		tData = Split(sRet, "|")
		
		g_szDateType = tData(0)
		g_szStartDate = tData(1)
		g_szEndDate = tData(2)
'ShowAlert(g_szDateType, 	g_szStartDate .. " : " .. 	g_szEndDate)
		
		lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
							 " ~ " &
						 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
	
		cld0.caption = Mid(g_szStartDate, 1, 4) & Mid(g_szStartDate, 5, 2) & Right(g_szStartDate, 2)
		cld1.caption = Mid(g_szEndDate, 1, 4) & Mid(g_szEndDate, 5, 2) & Right(g_szEndDate, 2)
		
		Call SetTrigger(fmtab0.currenttab)
	End If
End Sub

