'============================================================================
' 01. 화 면 명 : 거래내역
' 02. 화면설명 : 거래내역
' 03. 작    성 : 2016. 01. 14. 유창재
' 04. 수정내역 : 
' 20230904 KKM 자동투자내역 제외 체크값 추가
' 20240614 SJH 날짜 선택 UI 수정 v002
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_ComboIndex	'콤보선택 Index값
Dim g_FormTabIndex	'폼탭 Index값
Dim szData		'트리거로 다른 화면에서 TR 입력에 쓰일 데이터 저장변수
Dim g_szToday		'당일날짜
Dim g_szDateType
Dim g_szStartDate
Dim g_szEndDate
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTrigger(nIndex) : 트리거 발생 함수
'============================================================================
Function SetTrigger(nIndex)
	
'	Left(cmb1.caption , 8)
'	Right(cmb1.caption , 2) xxyy
	'TR 입력에 필요한 Data
	sta_date = Mid(g_szStartDate, 1, 4) & Mid(g_szStartDate, 5, 2) & Right(g_szStartDate, 2)
	end_date = Mid(g_szEndDate, 1, 4) & Mid(g_szEndDate, 5, 2) & Right(g_szEndDate, 2)
	szData = acnt0.total & "★" & acnt0.sequence & "★" & sta_date & "★" & end_date 'v002
	
	'20230904 KKM 자동투자내역 제외 체크값 추가 : Super365 200, CMA계좌 118 인 경우
	if acnt0.itemcodetype == "200" or acnt0.itemcodetype == "118" then 
		szData2 = acnt0.total & "★" & acnt0.sequence & "★" & sta_date & "★" & end_date & "★" & ChkCMAYN.checkstate
	else
		szData2 = acnt0.total & "★" & acnt0.sequence & "★" & sta_date & "★" & end_date & "★" 
	end if 
	
	Select Case CInt(nIndex)
		Case 0
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "전체", szData2)
		Case 1
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "입출금", szData)
		Case 2
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "매매", szData2)
		Case 3
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "입출고", szData)
	End Select
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
'	g_FormTabIndex = 0
	'20230427 KKM OS별 위치 수정
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "2" then '아이폰
	else
		'ChkCMAYN.left = 215
	end if 
	
	'g_szToday = cld1.caption v002
	g_FormTabIndex  = fmtab0.currenttab
	
	g_szToday = Form.GetSharedData("&HOST_DATE", false) 'v002
	g_szStartDate = g_szToday
	g_szEndDate = g_szToday
	g_szDateType = 1
	lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
					 " ~ " &
					 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
					 
	'20230904 KKM 자동투자내역 제외 체크값 추가 : Super365 200, CMA계좌 118 인 경우
	ChkCMAYN.checkstate = 0
	if acnt0.itemcodetype == "200" or acnt0.itemcodetype == "118" then 
		if g_FormTabIndex == 1 or g_FormTabIndex == 3 then 
			ChkCMAYN.visible = 0
		else
			ChkCMAYN.visible = 1
		end if	
	else
		ChkCMAYN.visible = 0
	end if	
	
	if Form.LoadConfigData("mbact71040", "ChkCMAYN") == "1" then
		ChkCMAYN.checkstate = 1
	else
		ChkCMAYN.checkstate = 0
	end if 
	
	Call SetTrigger(fmtab0.currenttab)
End Sub
'============================================================================
' cmb0_OnEditComplete(iIndex)
'============================================================================
'
'============================================================================
' fmtab0_OnTabChanged(nCurrentTab)
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	g_FormTabIndex = nCurrentTab
	
	'20230904 KKM 자동투자내역 제외 체크값 추가 : Super365 200, CMA계좌 118 인 경우
	'ChkCMAYN.checkstate = 0
	if acnt0.itemcodetype == "200" or acnt0.itemcodetype == "118" then 
		if g_FormTabIndex == 1 or g_FormTabIndex == 3 then 
			ChkCMAYN.visible = 0
		else
			ChkCMAYN.visible = 1
		end if	
	else
		ChkCMAYN.visible = 0
	end if	
	
	Call SetTrigger(nCurrentTab)
	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	Call SetTrigger(g_FormTabIndex)
End Sub

'20230904 KKM 자동투자내역 제외 체크값 추가
'============================================================================
Sub ChkCMAYN_OnChange(sCheckState)
	btn0_OnClick()
End Sub

