'============================================================================
' 01. 화 면 명 : 선옵 반대매매조회
' 02. 화면설명 : 선옵 반대매매조회 테이블 그리드
' 03. 작    성 : 2016.01.12 ~ 최지희
'              : 2020.09.10 V001. 윤현수 MTS메모리보안적용(edtPassword 비밀번호 속성 계좌/거래비밀번호 사용으로 변경)
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber		'계좌번호 8글자 ex)18431988
Dim g_nAccountSerialNumber	'계좌 일련번호 2글자 ex)01
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szLiquidationDate	'반대일자
Dim g_szGMEDIATYPE		'단말구분 1: 직원용 0:고객용
Dim j
'V001
Dim plain_rm 'MTS메모리평문 적용유무

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry() - TR(계좌번호와 일련번호, 날짜로 조회)
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_szAccountPassword, g_szLiquidationDate)
	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_109r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_109r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_109r", "InBlock1", "PWD" , 0 , g_szAccountPassword)
	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_109r", "InBlock1", "LQDT_ODER_DATE", 0 , g_szLiquidationDate)
	DATAMANAGER.RequestTranData("obtrf_lqdt_109r")
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'V001
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	j=0
	g_szGMEDIATYPE = Form.GetSharedData("&USER_TYPE", false )

	g_nAccountNumber = cmdAccount.total
	g_nAccountSerialNumber = cmdAccount.sequence
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption)	
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_szAccountPassword = edtPassword.caption	
	'MTS메모리평문 미적용상태일때
	else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)	
	end if
	g_szLiquidationDate = cldLiquidationDate.caption
	edtPassword.visible = false
	
	btnSearch_OnClick()
End Sub


'============================================================================
' btnSearch_OnClick - 조회를 눌릴때만 TR요청
'============================================================================
Sub btnSearch_OnClick()
	j=0
	for i=0 to 3
		Table0.SetCellString( i, 1, "" )
		Table0.SetCellString( i, 3, "" )		
	next
	TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_szAccountPassword, g_szLiquidationDate)
End Sub


'============================================================================
' cldLiquidationDate_OnEditComplete
'============================================================================
Sub cldLiquidationDate_OnEditComplete()
	g_szLiquidationDate = cldLiquidationDate.caption	
	btnSearch_OnClick()
End Sub


'============================================================================
' cmdAccount_ChangeAccount
'============================================================================
Sub cmdAccount_ChangeAccount()
	g_nAccountNumber = cmdAccount.total
	g_nAccountSerialNumber = cmdAccount.sequence
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_szAccountPassword = edtPassword.caption
	'MTS메모리평문 미적용상태일때
	else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	end if
	btnSearch_OnClick()
End Sub



'============================================================================
' grdLiquidation_OnScrollEnd
'============================================================================
Sub grdLiquidation_OnScrollEnd()
	DATAMANAGER.RequestNextData("obtrf_lqdt_109r")
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrf_lqdt_109r" then		
		nRowcount = CInt(grdLiquidation.rowcount)
		for i = 0 to nRowcount - 1
			Dim szCode		'매매구분코드
			Dim szData		'받은 매매구분코드를 변환하여 매매구분으으로 변환
			szCode = grdLiquidation.GetCellData("bd_cell6", i)
			szData = Form.GetMetaData("매매구분코드", szCode)
			
			grdLiquidation.SetCellData( "bd_cell3", i, szData )	
		next		
	end if
End Sub

