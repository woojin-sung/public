						<CELL cell_ly="1,2,1,2" fgcolor="321:115118124" halign="0" line="0,0" caption="ETF를 매매할 때 참고 기준으로 되는 가격으로" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
