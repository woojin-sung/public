						<CELL cell_ly="1,3,1,3" fgcolor="321:115118124" halign="0" line="0,0" caption="매수/매도 가격이 iNav를 크게 벗어나지 않았는지" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
