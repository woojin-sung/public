					<COL_INFO ly_vert_width="10,285" />
					<ROW_INFO ly_vert_height="18,10,18,18,18,10,18,18,18,18,18" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="321:115118124" line="0,0" caption="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="321:115118124" halign="0" line="0,0" caption="iNav는 10초 간격으로 발표됩니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
