						<CELL cell_ly="1,6,1,6" fgcolor="321:115118124" halign="0" line="0,0" caption="유동성 공급자들은 ETF매매가 원활하게 될 수" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,7,1,7" fgcolor="321:115118124" halign="0" line="0,0" caption="있도록 매수/매도 호가를 제출합니다. 그러니, " fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" fgcolor="321:115118124" halign="0" line="0,0" caption="장초반, 장마감, 동시호가시간에는 호가 스프레드" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,9,1,9" fgcolor="321:115118124" halign="0" line="0,0" caption="가 확대될 가능성이 있습니다. 이를 확인하여" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,10,0,10" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,10,1,10" fgcolor="321:115118124" halign="0" line="0,0" caption="주문을 진행합니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="Label11" bgcolor="320:246247248" transmode="0" ly_vert="20,912,335,260,1" />
				<LABEL name="Label12" fontstyle="01" caption="거래비용 및 세금" paddinginfo="1,0,0,0" ly_vert="40,932,200,20,1" />
				<TABLE name="Table2" insidelinecolor="102:255255255" colcount="2" rowcount="11" outline="0000" transmode="1" designorder="1" ly_vert="40,964,303,190,1" >
					<COL_INFO ly_vert_width="10,293" />
					<ROW_INFO ly_vert_height="18,18,10,18,18,18,18,18,18,18,18" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="321:115118124" line="0,0" caption="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="321:115118124" halign="0" line="0,0" caption="ETF를 거래할 때 주식거래와 마찬가지로 거래" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,1,1,1" fgcolor="321:115118124" halign="0" line="0,0" caption="수수료를 내야합니다.(증권사별 상이)" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,2,1,2" fgcolor="321:115118124" halign="0" line="0,0" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="321:115118124" line="0,0" caption="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,3,1,3" fgcolor="321:115118124" halign="0" line="0,0" caption="거래수수료 외에 ETF의 운용보수는 ETF의 순자산" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,4,1,4" fgcolor="321:115118124" halign="0" line="0,0" caption="에서 일할로 계산하여 차감됩니다. 현재 국내에 상" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,5,1,5" fgcolor="321:115118124" halign="0" line="0,0" caption="장된 모든 ETF는 공통적으로 거래세가 면제되고" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="321:115118124" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,6,1,6" fgcolor="321:115118124" halign="0" line="0,0" caption="있습니다. 다만, 매매차익에 대해서는 ETF의 유형" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,7,1,7" fgcolor="321:115118124" halign="0" line="0,0" caption="별로 다음과 같이 세금이 부과됩니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" fgcolor="321:115118124" halign="0" line="0,0" caption="- 국내주식형: 비과세" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,9,1,9" fgcolor="321:115118124" halign="0" line="0,0" caption="- 국내주식형 이외 ETF: 과표상승분 및 매매차익" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,10,0,10" fgcolor="321:115118124" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,10,1,10" fgcolor="321:115118124" halign="0" line="0,0" caption="중 작은 금액에 대한 배당소득세 원천징수(15.4%)" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
					</CELL_INFO>
