	<SCRIPT_INFO _len="2617" _ulen="2565" >
--===========================================================================
--===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szSta_Date
Dim g_szFin_Date
Dim g_NextCnt
'============================================================================
' Form Init
'============================================================================
Sub Form_OnFormInit()
	g_NextCnt = 0
End Sub
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName = "SearchBalance" then
		tmp = Split(sParam, "||")
		
		g_NextCnt = 0
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		
		'해외주식 온라인 외화잔고 조회
		DATAMANAGER.RequestTranData("obtro_oder_104r")
	end if
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtro_oder_104r" then
		
		if len(g_szAcno) < 8 then
			Form.ShowAlert("알림", "계좌번호를 확인해주세요.")
		end if 
		DATAMANAGER.SetDataValue(0, "obtro_oder_104r", "InBlock1", "ACNO" 			, 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_104r", "InBlock1", "ASNO" 			, 0 , g_szAsno)
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtro_oder_104r" then
		
		for i = g_NextCnt to grd0.rowcount - 1
		
			crcd   			= grd0.GetCellData("bd_crcd", i)
			frcr_amt			= Cstr(grd0.GetCellData("bd_frcr_amt", i))
			oder_able_camt	= Cstr(grd0.GetCellData("bd_camt1", i))
			oder_margin		= Cstr(grd0.GetCellData("bd_oder_margin", i))
			otst_seln		= Cstr(grd0.GetCellData("bd_otst_seln", i))
			otst_byon		= Cstr(grd0.GetCellData("bd_otst_byov", i))
						
			grd0.SetCellData("bd_frcr_amt"	, i , FormatNumber(frcr_amt,2))
			grd0.SetCellData("bd_camt1"		, i , FormatNumber(oder_able_camt,2))
			grd0.SetCellData("bd_oder_margin",i , FormatNumber(oder_margin,2))
			grd0.SetCellData("bd_otst_seln"	, i , FormatNumber(otst_seln,2))
			grd0.SetCellData("bd_otst_byov"	, i , FormatNumber(otst_byon,2))
			
		next
		
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_oder_104r", "OutBlock1")
		
	end if
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtro_oder_104r" trcode="obtro_oder_104r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtro_oder_104r" title="해외주식 온라인 외화잔고 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="122" _ulen="90" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="30" inout="out" _len="423" _ulen="295" >

CRCD^통화코드^3^0^0^0^0^0^0
FRCR_AMT^외화금액^20^3^7^0^0^0^0
CAMT1^통화금액(주문가능금액)^20^4^7^0^0^0^0
CAMT2^통화금액(재매매가능금액)^20^4^7^0^0^0^0
ODER_MARG_CAMT^주문증거금통화금액^20^4^7^0^0^0^0
OTST_SELN_CAMT^미결제매도통화금액^20^4^7^0^0^0^0
OTST_BYOV_CAMT^미결제매수통화금액^20^4^7^0^0^0^0
RGPL_STUP_CAMT^질권설정통화금액^20^4^7^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="NextBlock1" inout="next" _len="39" _ulen="31" >

CRCD^통화코드^3^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
