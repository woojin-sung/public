Dim g_szOSType

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("2")
	imgSearch.setMaintainingRatio("1")
	imgTitle.setMaintainingRatio("1")
	pannList.setMaintainingRatio("bd_thumbnail", 0, "1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSizeMode = Form.GetEnvData("common.textsize")
	
	if CInt(szTextSizeMode) > 0 then
	
		if gOsType == "1" then
			lblTitleText.fontsize = 1 - Cint((szTextSizeMode * 2))
			
		else
			lblTitleText.fontsize = -1 - Cint((szTextSizeMode * 2))
		end if
		
	end if	
	
	lblTitleBg.bgcolor = 397
	lblTitleText.fgcolor = 398
	
	'ETF 매거진 컨텐츠 목록 조회
	DATAMANAGER.RequestTranData( "ooopc_rprt_002r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'ETF 매거진 컨텐츠 목록 조회
	if szTranID == "ooopc_rprt_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_GRP_ID" , 0 , "bascGrp" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_ID" , 0 , "EtfMgz" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_DIV_CODE" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_WRTR_NAME" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_TITL_NAME" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" , 0 , "000000" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" , 0 , "999999" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'ETF 매거진 컨텐츠 목록 조회
	if szTranID == "ooopc_rprt_002r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		if nCnt == 0 then
			imgNotice.visible = true
			LabelGuideText.visible = true
			pannList.visible = false
			exit sub
		else
			imgNotice.visible = false
			LabelGuideText.visible = false
			pannList.visible = true
			
			Dim nGrdCnt
			nGrdCnt = CInt(pannList.rowcount)
			for i = 0 to nCnt - 1
				pannList.AddRow()
				Dim sTitle, sThumPath, sContentsUrl
				sTitle 	= DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TITL_NAME" , i)
				sThumPath = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_SPLM_ITEM_VAL13" , i)
				sContentsUrl = DATAMANAGER.GetDataValue(0, "ooopc_rprt_002r", "OutBlock1", "BBS_CNTT_TURN_NO" , i)
				
				if sContentsUrl <> "" then
					sContentsUrl = GetTotalUrlPath("contents",sContentsUrl)
				else
					sContentsUrl = ""
				end if
				
				
				if sThumPath <> "" then
					sThumPath = GetTotalUrlPath("image",sThumPath)
				else
					sThumPath = ""
				end if
				
				pannList.setPropCardCell("caption", "lblMgzTitle", nGrdCnt+i, sTitle)
				pannList.setPropCardCell("caption", "lblUrl", nGrdCnt+i, sContentsUrl)
				pannList.setPropCardCell("imgurl", "imgThumb", nGrdCnt+i, sThumPath)
			next
			
			'nrshidx50310 에서 화면이동 후 돌아온 경우 다시 본문을 띄우기 위한 처리
			Dim szSelectUrl
			szSelectUrl = Form.GetSharedData("50300_SELECT_URL", true)
			if szSelectUrl <> "" and szSelectUrl <> null then
				for i = 0 to CInt(pannList.rowcount) - 1
					Dim szListUrl
					szListUrl = pannList.getPropCardCell("caption", "lblUrl", i)
					if szListUrl == szSelectUrl then
						Form.OpenPopup("nrshidx50310", szSelectUrl, "")
						exit for
					end if
				next
			end if
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgText, szSubText
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
' 썸네일 및 본문 URL 가져오기
'============================================================================
Function GetTotalUrlPath(sGubun,sPath)

	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	'-------------------------
	' 본문 링크주소
	'-------------------------
	if sGubun = "contents" then
'		if CInt(szMode) == 0 then
'			szUrl = "https://home.imeritz.com/mobile/mts/etfMgz.html?bbsCnttTurnNo="..Cint(sPath)		'운영계 주소
'		elseif CInt(szMode) == 1 then
'			szUrl = "https://testhome.imeritz.com/mobile/mts/etfMgz.html?bbsCnttTurnNo="..Cint(sPath)	'테스트계주소
'		end if
		
		if CInt(szMode) == 0 then
			szUrl = "https://home.imeritz.com/bbs/mwCtn1.do?bbsId=EtfMgz&bbsCnttTurnNo="..Cint(sPath)		'운영계 주소
		elseif CInt(szMode) == 1 then
			szUrl = "https://testhome.imeritz.com/bbs/mwCtn1.do?bbsId=EtfMgz&bbsCnttTurnNo="..Cint(sPath)	'테스트계주소
		end if
	
	'-------------------------
	' 썸네일 링크주소
	'-------------------------
	else
		if CInt(szMode) == 0 then
			szUrl = "https://home.imeritz.com"..sPath		'운영계 주소
		elseif CInt(szMode) == 1 then
			szUrl = "https://testhome.imeritz.com"..sPath		'테스트계주소
		end if
	end if
	
	return szUrl
	
End Function


'============================================================================
Sub imgBack_OnClick()
	Form.openPrevScreen()
End Sub

'============================================================================
Sub pannList_OnClick(nIndex, sCellID)
	Dim szUrl
	szUrl = pannList.getPropCardCell("caption", "lblUrl", nIndex)
	if szUrl <> "" and szUrl <> null then
		Form.SetSharedData("50300_SELECT", nIndex)
		Form.OpenPopup("nrshidx50310", szUrl, "")
	end if
End Sub

'============================================================================
Sub pannList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ooopc_rprt_002r") then
		DATAMANAGER.RequestNextData("ooopc_rprt_002r")
	end if
End Sub

'============================================================================
Sub imgSearch_OnClick()
	Form.OpenPopup("nrshidx50320", "", "")
End Sub

'============================================================================
Sub Form_OnTriggerEventSCREEN(sEventName, sParam)

	'백버튼으로 다시 되돌아온 경우가 아니면
	'이전에 보고있던 매거진 정보 클리어 시킴
	if sEventName <> "PREV" then
		Form.SetSharedData("50300_SELECT", "")
		Form.SetSharedData("50300_SELECT_URL", "")
	end if
	
End Sub

