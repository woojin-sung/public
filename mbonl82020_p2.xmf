'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_약정금액설정
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sAcc

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData 
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or sRevData == "" then
		Exit Sub
	end if
	
	g_sAcc = sRevData

	Form.SetScreenName("약정금액설정")
	g_sRetData = "cancel"
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_stmp_001r" then
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_stmp_001r", "InBlock1", "UI_STPL_AMT1" , 0 , EditInput.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

End Sub

'============================================================================
Sub EditInput_OnEditComplete()
	Table0.SetCellString( 3, 0, "" )
	Table0.SetCellString( 3, 1, "" )
End Sub

'============================================================================
Sub ButtonRequest_OnClick()
	if EditInput.caption == "" or EditInput.caption == "0" then
		Form.MsgBox( "알림", "약정금액을 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData( "oblon_stmp_001r" ) '인지세조회
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if EditInput.caption == "" or EditInput.caption == "0" then
		Form.MsgBox( "알림", "약정금액을 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if
	
	if Table0.GetCellString( 3, 0 ) == "" then
		Form.MsgBox( "알림", "인지세 조회를 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if
	
	Form.SetSharedData("mbonl82020_p2_Amt1" , EditInput.caption)
	Form.SetSharedData("mbonl82020_p2_Amt2" , Table0.GetCellString( 3, 0 ))
	Form.SetSharedData("mbonl82020_p2_Amt3" , Table0.GetCellString( 3, 1 ))
	
	g_sRetData = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82020_p2" , g_sRetData)
End Sub











