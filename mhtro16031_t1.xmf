'===========================================================================
' 01. 업무구분 : 해외주식
' 02. 화면 :  지수/업종 주요종목
' 03. 화면설명 : 
' 04. 작성자 : 
' 05. 작성일 : 
' 06. 수정이력 :

'===========================================================================
Dim g_sNatCd	' 국가구분코드
Dim g_sExCd	' 거래소구분코드
Dim g_rtChk	' 실시간 구분코드 
Dim g_sBstpCd ' 입력 업종 코드 
Dim g_grdCnt	' 그리드 갯수

g_sBstpCd = ""
g_grdCnt = 0
'============================================================================
Sub Form_OnFormInit()
	Dim szCombo0
	Dim szCombo1
	
	szCombo0 = Form.GetEnvData("16031_T01_COMBO0")
	szCombo1 = Form.GetEnvData("16031_T01_COMBO1")
	if szCombo0 <> nil and szCombo0 <> "" then
		Combo0.cbkeydata = szCombo0
	end if

	Combo1_Setting()
	
	if szCombo1 <> nil and szCombo1 <> "" then
		Combo1.cbkeydata = szCombo1
		g_sBstpCd = Combo1.cbkeydata
	end if

	DATAMANAGER.RequestTranData( "ohhts_6251_001r" ) 
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	Dim szClsCd
	szCmb0 = Combo0.cbkeydata
	g_sBstpCd = Combo1.cbkeydata
	
	g_sExCd = Transform_Exid(szCmb0)
	if g_sExCd == "SZ" or g_sExCd == "SH" then
		szClsCd = g_sExCd
		g_sExCd = "CN"
	else 
		szClsCd = ""
	end if
	
	if szTranID == "ohhts_6251_001r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6251_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) '시장구분코드
		DATAMANAGER.SetDataValue( false, "ohhts_6251_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62510" ) '화면분류코드
		DATAMANAGER.SetDataValue( false, "ohhts_6251_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk ) '실시간 지연여부
		
		DATAMANAGER.SetDataValue( false, "ohhts_6251_001r", "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 ,  g_sExCd) ' 국가코드
		DATAMANAGER.SetDataValue( false, "ohhts_6251_001r", "InBlock1", "FID_INPUT_COND_MRKT_CLS_CODE" , 0 , szClsCd) '입력조건시장구분코드

		DATAMANAGER.SetDataValue( false, "ohhts_6251_001r", "InBlock1", "FIDX_INPUT_BSTP_CODE" , 0 ,  g_sBstpCd) '업종코드	
	end if
end Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	nCount    = CInt( DATAMANAGER.GetDataCount( false, "ohhts_6251_001r", "OutBlock1" ) )
	
	For i = 0 To nCount - 1
		Dim sCode
		szNat = DATAMANAGER.GetDataValue(false, "ohhts_6251_001r", "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
		szIsCd = DATAMANAGER.GetDataValue(false, "ohhts_6251_001r", "OutBlock1", "FIDX_ISCD" , i)
		sCode = szNat.."@"..szIsCd
		Grid0.SetCellData("bd_cell11", g_grdCnt + i, sCode)
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , i , sCode )
		
	Next
		g_grdCnt = Grid0.rowcount
		Grid0.keyall = "1"
		DATAMANAGER.RequestRealData( "ohhts_exst_ictg" )
		
End Sub


'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Combo0.cbkeydata
	Form.SetEnvData(1, "16031_T01_COMBO0", szComboData)
	
	Combo1_Setting()
	Grid0.SetClear( )
	g_sBstpCd = Combo1.cbkeydata
	g_grdCnt = 0
	DATAMANAGER.RequestTranData( "ohhts_6251_001r" ) 
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)		
	Dim szComboData
	szComboData = Combo1.cbkeydata
	Form.SetEnvData(1, "16031_T01_COMBO1", szComboData)
	
	szCombo1 = Form.GetEnvData("16031_T01_COMBO1")
	
	if szCombo1 <> nil and szCombo1 <> "" then
		Combo1.cbkeydata = szCombo1
	end if
	g_sBstpCd = szComboData
	Grid0.SetClear( )
	g_grdCnt = 0
	DATAMANAGER.RequestTranData( "ohhts_6251_001r" ) 
end Sub

'============================================================================
Sub Form_OnRefresh()
	if szCombo0 <> nil and szCombo0 <> "" then
		Combo0.cbkeydata = szCombo0
	end if

	Combo1_Setting()
	
	if szCombo1 <> nil and szCombo1 <> "" then
		Combo1.cbkeydata = szCombo1
		g_sBstpCd = Combo1.cbkeydata
	end if
	
	g_grdCnt = 0
	
	DATAMANAGER.RequestTranData( "ohhts_6251_001r" ) 
end Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "ohhts_6251_001r" ) then
		DATAMANAGER.RequestNextData( "ohhts_6251_001r" )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	Dim sCode, sSymbol, sKorname, sEngName, sExid
	sSymbol		= Grid0.GetCellData( "bd_cell7", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell0", lRow )
	sExid       = Grid0.GetCellData( "bd_cell4", lRow ) 

	if sExid ~= "" then
		Form.SetSharedData( "&ITEM_CODE" , sCode )
		Form.SetSharedData( "&ITEM_SYMBOL" , sSymbol )
		Form.SetSharedData( "&ITEM_KORNAME" , sKorname )
		Form.SetSharedData( "&ITEM_EXID" , sExid )
	
		sCode = sExid.."@"..sSymbol
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")		
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Function Combo1_Setting()
			
	Dim szCmb0

	Combo1.clear = true
	szCmb0 = Combo0.cbkeydata
	
	if szCmb0 == "990" then ' 미국 
		Combo1.cbadddatatext = "DJI`다우30"
		Combo1.cbadddatatext = "NDX`나스닥100"
		Combo1.cbadddatatext = "SP500`S&P500"
	elseif szCmb0 == "215" then ' 상해
		Combo1.cbadddatatext = "000016`SSE50"
		Combo1.cbadddatatext = "000010`SSE180"
		Combo1.cbadddatatext = "000009`SSE380"
	elseif szCmb0 == "214" then ' 심천
		Combo1.cbadddatatext = "399004`심천 100 PRICE INDEX"
	elseif szCmb0 == "104" then ' 홍콩
		Combo1.cbadddatatext = "HSCE`H주"
		Combo1.cbadddatatext = "HSCC`Red Chip"
	elseif szCmb0 == "106" then ' 일본
		Combo1.cbadddatatext = "NI225`니케이225"
		Combo1.cbadddatatext = "T002A`TOPIX100"
	end if
	
End Function 


'============================================================================
Function Transform_Exid(sValue)
	if sValue == "990" then ' 미국
		g_rtChk = Form.GetSharedData( "REALTIME_OQ", false )
		return "US"
	elseif sValue == "215" then ' 상해
		g_rtChk = Form.GetSharedData( "REALTIME_SH", false )
		return "SH"
	elseif sValue == "214" then ' 심천
		g_rtChk = Form.GetSharedData( "REALTIME_SZ", false )
		return "SZ"
	elseif sValue == "104" then ' 홍콩
		g_rtChk = Form.GetSharedData( "REALTIME_HK", false )
		return "HK"
	elseif sValue == "106" then ' 일본
		g_rtChk = Form.GetSharedData( "REALTIME_JP", false )
		return "JP"
	end if
end Function

