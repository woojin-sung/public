							<CELL name="rsevsrno" cell_ly="0,4,0,4" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell170" cell_ly="0,5,0,5" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell171" cell_ly="0,6,0,6" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell172" cell_ly="0,7,0,7" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell173" cell_ly="0,8,0,8" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell174" cell_ly="0,9,0,9" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell175" cell_ly="0,10,0,10" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell176" cell_ly="0,11,0,11" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell177" cell_ly="0,12,0,12" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell178" cell_ly="0,13,0,13" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
							<CELL name="bd_cell179" cell_ly="0,14,0,14" line="0,0" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
			</COLINFO>
			<UPDATETR_INFO/>
			<UPDATEBC_INFO keycellid="bd_cell0" rangecellid="bd_cell0" hlcolorcellid="bd_cell0" />
		</GRID>
		<LABEL name="lblNoData" visible="0" fgcolor="146:124124124" caption="진행 내역이 없어요." halign="1" ly_vert="30,152,315,20,0" />
		<COMBO name="cmbAcnt" ly_vert="6,5,361,39,1" />
		<LABEL name="lblAcntNodata" visible="0" caption="선택할 수 있는 계좌가 없습니다." ly_vert="6,5,250,39,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="15339" _ulen="14305" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 신규개발
'                2023.01.05 : 고승연 : v0002 : 비밀번호 체크 수정
'-------------------------------------------------------------------------------------------

Dim g_sCsno, g_sAcno, g_sAsno, g_sCnrcNo
Dim gs_sAcno, gs_sAsno, g_idx

'============================================================================
Sub Form_OnFormInit()
	grdData.setUseCardView(true, 15, "btn_12_n.9")
	
	g_sCsno = Form.GetSharedData("&CUST_NUM", false)
	gs_sAcno = Form.GetSharedData("mbwat61022_ACNO", false)
	gs_sAsno = Form.GetSharedData("mbwat61022_ASNO", false)
		
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "4" )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
	
	DATAMANAGER.RequestTranData( "obwat_onln_004r" )
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
	grdData.SetClear()
	lblNoData.visible = false
	
	g_sAcno = Left(cmbAcnt.cbkeydata, 8)
	g_sAsno = Right(cmbAcnt.cbkeydata, 2)
			
	if (g_sAcno <> nil and g_sAcno <> "") and (g_sAsno <> nil and g_sAsno <> "") then
		DATAMANAGER.RequestTranData( "obwat_ctad_084r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_ctad_084r" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_084r", "InBlock1", "ACNO" , 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_084r", "InBlock1", "ASNO" , 0 , g_sAsno )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_004r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		
		g_idx = 0
		
		if nCount > 0 then	
			for i = 0 to nCount-1
				Dim sAcno, sAsno, sPrcd, sCnrcNo, sPrcdName
				sAcno	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCnrcNo	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CNRC_NO" , i )
				sCsnm	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				cmbAcnt.cbadddatatext = sAcno..sAsno.."`"..sPrcdName..mid(sAcno, 1, 4).."-"..mid(sAcno, 5, 4).."-"..sAsno.." "..sCsnm
				
				'Form.MsgBox("sAcno = " & sAcno & " / gs_sAcno = " & gs_sAcno &  " / sAsno = " & sAsno & " / gs_sAsno = " & gs_sAsno)
				
				if sAcno = gs_sAcno And sAsno = gs_sAsno Then
					g_idx = i
				end if
				
			next
			
			cmbAcnt.currentindex = g_idx
			g_sAcno = Left(cmbAcnt.cbkeydata, 8)
			g_sAsno = Right(cmbAcnt.cbkeydata, 2)
			
			Form.SetSharedData("mbwat61022_ACNO", "")
			Form.SetSharedData("mbwat61022_ASNO", "")
		
		else
			lblAcntNodata.visible = true
			lblNoData.visible = true
		end if
		
	elseif szTranID == "obwat_ctad_084r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_ctad_084r", "OutBlock1" )
		grdData.rowcount = nCount
		
		if nCount == 0 then
			lblNoData.visible = true
		end if
		
		for i = 0 to nCount-1
			grdData.SetCellData("tooltip0", i, "alpha")
			grdData.SetCellData("tooltip1", i, "alpha")
			grdData.SetCellData("icon3", i, "alpha")
			grdData.SetCellData("stepline2", i, "alpha")
			
			'1 계약신청완료, 2 화상상담완료, 3 숙려기간, 4 계약완료 (숙려대상여부에 따라 숙려표시 결정), 5 계약취소
			sStateCode = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "NMET_PRGS_STAT_CODE" , i )
			
			sWA_PRNM = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "WA_PRNM" , i )
			grdData.SetCellData("name", i, sWA_PRNM)
			
			grdData.SetCellData("topline", i, "btn_27_o.9.png")
			
			sUI_TR_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "UI_MOD_DATE" , i ) '계약신청 일자
			sUI_TR_DATE = Mid(sUI_TR_DATE, 3, 2).."."..Mid(sUI_TR_DATE, 5, 2).."."..Mid(sUI_TR_DATE, 7, 2)
			
			grdData.SetCellData("icon0", i, "wrap_btn_check_navy.png")
			grdData.SetCellData("steptext0", i, "계약신청 완료")
			grdData.SetCellData("stepdate0", i, sUI_TR_DATE)
			
			if tonumber(sStateCode) > 1 then '화상상담 완료
				sUI_TR_DATE1 = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "UI_MOD_DATE1" , i ) '화상상담 완료일자
				sUI_TR_DATE1 = Mid(sUI_TR_DATE1, 3, 2).."."..Mid(sUI_TR_DATE1, 5, 2).."."..Mid(sUI_TR_DATE1, 7, 2)
				
				grdData.SetCellData("icon1", i, "wrap_btn_check_navy.png")
				grdData.SetCellData("steptext1", i, "화상상담 완료")
				grdData.SetCellData("stepdate1", i, sUI_TR_DATE1)
			else
				grdData.SetCellData("icon1", i, "wrap_btn_check_gray.png")
				grdData.SetCellData("steptext1", i, "화상상담 대기 중")
				grdData.SetCellFgColor("steptext1", i, "67")
				grdData.SetCellData("tooltip0", i, "icon_noti.png")
				
				sRSEV_APLT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "RSEV_APLT_DATE" , i ) '화상상담 예약일자
				sRSEV_APLT_STA_HOUR = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "RSEV_APLT_STA_HOUR" , i ) '화상상담 예약시작시간
				sRSEV_APLT_FIN_HOUR = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "RSEV_APLT_FIN_HOUR" , i ) '화상상담 예약종료시간
				
				Dim sData
				sData = Mid(sRSEV_APLT_DATE, 3, 2).."."..Mid(sRSEV_APLT_DATE, 5, 2).."."..Mid(sRSEV_APLT_DATE, 7, 2).." | "
				sData = sData..Mid(sRSEV_APLT_STA_HOUR, 1, 2)..":"..Mid(sRSEV_APLT_STA_HOUR, 3, 2).." ~ "
				sData = sData..Mid(sRSEV_APLT_FIN_HOUR, 1, 2)..":"..Mid(sRSEV_APLT_FIN_HOUR, 3, 2).." 예약"
				
				grdData.SetCellData("stepdate2", i, sData)
				grdData.SetCellFgColor("stepdate2", i, "146")
			end if
			
			grdData.SetCellData("stepline0", i, "btn_27_o.9.png")
			grdData.SetCellData("stepline1", i, "btn_27_o.9.png")
			
			Dim nIndex
			nIndex = 2
			sCAFU_TRGT_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "CAFU_TRGT_YN" , i ) '숙려대상여부
			
			if sCAFU_TRGT_YN == "Y" then
				nIndex = nIndex + 1
				grdData.SetCellData("icon2", i, "wrap_btn_check_gray.png")
				grdData.SetCellData("steptext2", i, "숙려기간")
				grdData.SetCellData("tooltip1", i, "icon_noti.png")
				
				if tonumber(sStateCode) == 1 then '계약신청 완료
					grdData.SetCellFgColor("steptext2", i, "146")
					
				elseif tonumber(sStateCode) > 1 then '화상상담 완료로 숙려기간중
					sUI_STA_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "UI_STA_DATE" , i ) '시작숙려기간
					sUI_FIN_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "UI_FIN_DATE" , i ) '종료숙려기간
					
					Dim sData
					sData = Mid(sUI_STA_DATE, 3, 2).."."..Mid(sUI_STA_DATE, 5, 2).."."..Mid(sUI_STA_DATE, 7, 2).." ~ "
					sData = sData..Mid(sUI_FIN_DATE, 3, 2).."."..Mid(sUI_FIN_DATE, 5, 2).."."..Mid(sUI_FIN_DATE, 7, 2)
					
					if Len(Trim(sUI_STA_DATE)) + Len(Trim(sUI_FIN_DATE)) > 0 then
						grdData.SetCellData("stepdate3", i, sData)
					else
						grdData.SetCellData("stepdate3", i, "")
					end if
					
					if tonumber(sStateCode) == 2 or tonumber(sStateCode) == 3 then
						grdData.SetCellFgColor("steptext2", i, "67")
						grdData.SetCellFgColor("confirm", i, "67")
						grdData.SetCellData("confirm", i, "가입 확정하러 가기")
					elseif tonumber(sStateCode) > 2 then
						grdData.SetCellData("icon2", i, "wrap_btn_check_navy.png")
					end if
				end if
				
				grdData.SetCellData("stepline2", i, "btn_27_o.9.png")
			end if
			
			if tonumber(sStateCode) == 5 then '계약취소
				grdData.SetCellData("icon"..nIndex, i, "wrap_btn_check_red.png")
				grdData.SetCellData("steptext"..nIndex, i, "계약 취소")
				
				sUI_TR_DATE3 = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "UI_MOD_DATE3" , i ) '계약취소
				sUI_TR_DATE3 = Mid(sUI_TR_DATE3, 3, 2).."."..Mid(sUI_TR_DATE3, 5, 2).."."..Mid(sUI_TR_DATE3, 7, 2)
				grdData.SetCellData("stepdate"..(nIndex+1), i, sUI_TR_DATE3)
			
				grdData.SetCellData("icon1", i, "wrap_btn_check_navy.png")
				grdData.SetCellData("steptext1", i, "화상상담")
				grdData.SetCellData("stepdate1", i, "")
			elseif tonumber(sStateCode) == 4 then '계약완료
				grdData.SetCellData("icon"..nIndex, i, "wrap_btn_check_navy.png")
				grdData.SetCellData("steptext"..nIndex, i, "계약 완료")
				
				sUI_TR_DATE2 = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "UI_MOD_DATE2" , i ) '계약완료일자
				sUI_TR_DATE2 = Mid(sUI_TR_DATE2, 3, 2).."."..Mid(sUI_TR_DATE2, 5, 2).."."..Mid(sUI_TR_DATE2, 7, 2)
				grdData.SetCellData("stepdate"..(nIndex+1), i, sUI_TR_DATE2)
			
			else
				grdData.SetCellData("icon"..nIndex, i, "wrap_btn_check_gray.png")
				grdData.SetCellData("steptext"..nIndex, i, "계약 완료")
				grdData.SetCellFgColor("steptext"..nIndex, i, "146")
			end if
			
			'취소버튼
			if tonumber(sStateCode) < 2 then
				grdData.SetCellData("cancel", i, "취소하기")
				grdData.SetCellImage("cancel", i, "img_bgbox.9.png")
			end if
			
			sNMET_APLT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "NMET_APLT_DATE" , i )
			sNMET_APLT_SRNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "NMET_APLT_SRNO" , i )
			sRSEV_APLT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "RSEV_APLT_DATE" , i )
			sRSEV_APLT_SRNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_084r", "OutBlock1", "RSEV_APLT_SRNO" , i )
			
			grdData.SetCellData("statecode", i, sStateCode)
			grdData.SetCellData("nmetdate", i, sNMET_APLT_DATE)
			grdData.SetCellData("nmetsrno", i, sNMET_APLT_SRNO)
			grdData.SetCellData("rsevdate", i, sRSEV_APLT_DATE)
			grdData.SetCellData("rsevsrno", i, sRSEV_APLT_SRNO)
		next
		
	elseif szTranID == "obwat_ctad_085a" then '계약취소
		Form.MsgBox("안내", "Wrap 계약이 취소 되었습니다.", "", 8, "확인", "")
		grdData.SetClear()
		
		if (g_sAcno <> nil and g_sAcno <> "") and (g_sAsno <> nil and g_sAsno <> "") then
			DATAMANAGER.RequestTranData( "obwat_ctad_084r" )
		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	ShowAlert(szTranID, szErrMsg)
End Sub

'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	if szCellID == "cancel" then
		Dim sText
		sText = grdData.GetCellData(szCellID, lRow)
		
		if sText == "취소하기" then
			Dim sStateCode, sNMET_APLT_DATE, sNMET_APLT_SRNO, sRSEV_APLT_DATE, sRSEV_APLT_SRNO
			sStateCode = grdData.GetCellData("statecode", lRow)
			sNMET_APLT_DATE = grdData.GetCellData("nmetdate", lRow)
			sNMET_APLT_SRNO = grdData.GetCellData("nmetsrno", lRow)
			sRSEV_APLT_DATE = grdData.GetCellData("rsevdate", lRow)
			sRSEV_APLT_SRNO = grdData.GetCellData("rsevsrno", lRow)
			
			DATAMANAGER.ClearInputData( 0, "obwat_ctad_085a" )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "ACNO" , 0 , g_sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "ASNO" , 0 , g_sAsno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "PRGS_STAT_CODE" , 0 , sStateCode )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "NMET_APLT_DATE" , 0 , sNMET_APLT_DATE )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "NMET_APLT_SRNO" , 0 , sNMET_APLT_SRNO )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "RSEV_APLT_DATE" , 0 , sRSEV_APLT_DATE )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_085a", "InBlock1", "RSEV_APLT_SRNO" , 0 , sRSEV_APLT_SRNO )
			
			Form.MsgBox("안내", "진행중인 Wrap 계약을 취소 하시겠습니까?", "cancel", 7, "계약취소", "닫기")
		end if
		
	elseif szCellID == "tooltip0" then '화상상담 대기중 툴팁
		Dim sText
		sText = grdData.GetCellData(szCellID, lRow)
		
		if sText <> "" then
			Dim tData
			tData = Split(grdData.location, ":")
			
			imgToolTip0.top = tData(1) + 97 - 40 ' 그리드 로우 상단부터 툴팁까지 높이가 97임. 선택한 셀의 탑위치와 97 더해서 이미지 위치함.
			
			Form.SetTimerEvent2(1, 1, 0.2) '이미지 탑지정후 바로툴팁띄우면 이상한데 뜸. 타이머로 예외처리
		end if
	
	elseif szCellID == "tooltip1" then '숙려기간 툴팁
		Dim sText
		sText = grdData.GetCellData(szCellID, lRow)
		
		if sText <> "" then
			Dim tData
			tData = Split(grdData.location, ":")
			
			imgToolTip1.top = tData(1) + 143 - 40 ' 그리드 로우 상단부터 툴팁까지 높이가 143임. 선택한 셀의 탑위치와 143 더해서 이미지 위치함.
			
			Form.SetTimerEvent2(2, 1, 0.2) '이미지 탑지정후 바로툴팁띄우면 이상한데 뜸. 타이머로 예외처리
		end if
		
	elseif szCellID == "confirm" then ' 가입 확정하러 가기
		Form.OpenFramePopup( "mbfnp55007" , "" , "")
		
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 0.5)
		Dim sToolTipText
		sToolTipText = "상담예약일에 직원이 직접 연락 드려요.\n상담 미진행시, 예약일 +5영업일 후 계약이 자동 취소 됩니다."
		imgToolTip0.openToolTip( sToolTipText, 270, 80, 1 )
		
	elseif sTimerID == 2 or sTimerID == "2" then
		Form.SetTimerEvent2(2, 0, 0.5)
		Dim sToolTipText
		sToolTipText = "고난도 상품으로 숙려기간이 적용되어\n2영업일간 계약이 보류 됩니다.\n의사 결정 미확정시, 계약이 자동취소 됩니다."
		imgToolTip1.openToolTip( sToolTipText, 270, 100, 1 )
		
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "cancel" then
		if sRet == "ok" then
			'v0002
			Form.openPopupAnimation("pwdcheckpopup", g_sAcno & g_sAsno & "☆0" ,"","2")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	grdData.SetMaintainingRatio("icon0", 0, "1")
	grdData.SetMaintainingRatio("icon1", 0, "1")
	grdData.SetMaintainingRatio("icon2", 0, "1")
