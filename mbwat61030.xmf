End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				DATAMANAGER.RequestTranData( "obwat_ctad_085a" )
			end if
		end if
	end if
End Sub

