'===========================================================================
' 화 면 명: 다른 금융기관 계좌조회_수익증권
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim g_szTotAmt   	'총 잔액
Dim g_szNo		'넘버

Dim LdgrBal     	'잔액
Dim OpngDate    	'계좌개설일자
Dim MtrtDate		'만기일
Dim LastTrDate	'최종입출금일
Dim nCount        '카운트

Dim TrDate  
Dim ApiTlmsClcd  
Dim OpnOtsdTrNo
Dim RpttCsnu

	
'===========================================================================
' Form_OnFormInit()
'===========================================================================
Sub Form_OnFormInit()

	g_szNo = 0
	g_szTotAmt = 0
	nCount = 0
	
	g_szID = Form.GetSharedData("&USER_ID", false )
	TrDate = Form.GetSharedData("&HOST_DATE", false )
    
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" )
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , "6" ) '수익증권
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID", 0 , g_szID) 'acno랑 둘중하나만
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN", 0 , "Y") 

	DATAMANAGER.RequestTranData("obtss_opnf_008r")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtss_opnf_008r" then
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
		
		if nCount = 0 then 
			MsgBox("등록된 계좌가 없습니다")
		else
			'g_szNo = g_szNo + 1
			g_szCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
			
			ApiTlmsClcd 	= DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "API_TLMS_CLCD", 0)
			OpnOtsdTrNo	= DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "OPN_OTSD_TR_UNIQ_NO", 0)
			RpttCsnu 	= 1
			
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "TR_DATE"   			 , 0 , TrDate)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "API_TLMS_CLCD"  		 , 0 , ApiTlmsClcd)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "OPN_OTSD_TR_UNIQ_NO"	 , 0 , OpnOtsdTrNo)
			'DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "RPTT_CSNU"			 , 0 , RpttCsnu)
			
			DATAMANAGER.RequestTranData("obtss_opnf_034r")
		end if
	elseif szTranID == "obtss_opnf_034r" then
		
		LdgrBal	= DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", "OutBlock1", "LDGR_BAL"		, 0)	 '잔액
		OpngDate	= DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", "OutBlock1", "ACNT_OPNG_DATE"	, 0)	 '계좌개설일자
		MtrtDate	= DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", "OutBlock1", "MTRT_DATE"		, 0)	 '만기일
		LastTrDate = DATAMANAGER.GetDataValue(0,"obtss_opnf_034r", "OutBlock1", "LAST_TR_DATE"	, 0)	 '최종입출금일
		
		Grid.SetCellData("bd_cell3", g_szNo, LdgrBal)
		Grid.SetCellData("bd_cell5", g_szNo, OpngDate)
		Grid.SetCellData("bd_cell6", g_szNo, MtrtDate)
		Grid.SetCellData("bd_cell7", g_szNo, LastTrDate)
				
		if g_szCount-1 <> g_szNo then
		
			g_szNo = g_szNo + 1
			
			OpnOtsdTrNo = DATAMANAGER.GetDataValue(0,"obtss_opnf_008r", "OutBlock1", "OPN_OTSD_TR_UNIQ_NO", g_szNo)
			
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "TR_DATE"   			 , 0 , TrDate)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "API_TLMS_CLCD"  		 , 0 , ApiTlmsClcd)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "OPN_OTSD_TR_UNIQ_NO"	 , 0 , OpnOtsdTrNo)
			'DATAMANAGER.SetDataValue( 0, "obtss_opnf_034r", "InBlock1", "RPTT_CSNU"			 , 0 , RpttCsnu)
						
			DATAMANAGER.RequestTranData("obtss_opnf_034r")
			g_szTotAmt = LdgrBal + g_szTotAmt
			
		else
			'총 잔액 합산
			g_szTotAmt = LdgrBal + g_szTotAmt
			edtTotalAmt.caption = g_szTotAmt
		end if
		
	end if	
	
End Sub


'============================================================================
Sub Grid_OnClickUp(lRow, szCellID)
	'전달 항목
	'1.계좌번호 2.계좌별명 3.계좌개설일 4.만기일 5.최종입출금일 6.출금계좌동의 
	Dim Acno
	Dim AcAlas
	Dim AcOpenD
	Dim AcCloD
	Dim AcCurrTrD
	Dim AcAgr
	Dim AcNm
	Dim AcCd
	
	Acno       = Grid.getCellData("bd_cell2", lRow)
	AcAlas	  = Grid.getCellData("bd_cell4", lRow)
	AcOpenD	  = Grid.getCellData("bd_cell5", lRow)
	AcCloD	  = Grid.getCellData("bd_cell6", lRow)
	AcCurrTrD  = Grid.getCellData("bd_cell7", lRow)
	AcAgr	  = Grid.getCellData("bd_cell8", lRow)
	AcNm       = Grid.getCellData("bd_cell0", lRow)
	AcCd       = Grid.getCellData("bd_cell9", lRow)
	
	Form.OpenPopup( "mbbnk62030_p1" , Acno & "★" & AcAlas & "★" & AcOpenD & "★" & AcCloD & "★" & AcCurrTrD & "★" & AcAgr & "★" & "mbbnk62030_t4" & "★" & AcNm& "★" & AcCd)
	
End Sub




'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	Dim SubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)	
End Sub








