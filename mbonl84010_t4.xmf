	<SCRIPT_INFO _len="16599" _ulen="15351" >
'============================================================================
' 01.화면명 	: 온라인계좌개설
' 02.화면설명	: 온라인계좌개설_CMA계좌개설
' 03.작성	: 2016.01.14
' 04. 세팅하는 SHARED DATA 
'	Form.SetSharedData("ONLINE066_BRCD" , g_szManBranch)		'관리코드
'	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)			'계좌번호
'	Form.SetSharedData("ONLINE_PSWD",	g_szPassword)		'계좌비번
'	Form.SetSharedData("ONLINE_DVPDCODE" , szDVPDCode)		'파생상품유의코드
'============================================================================
' [Modyfy]
' 2016.06.17 : 정민영 : "예금자보호 안내문" 추가 v0001
' 2019.03.18 : 김유경 : 자동매수상품선택(종금형/증권형 선택삭제) v0002
'				      투자성향 체크박스 클릭시 팝업안되는 오류 수정
' 2020.09.16 : 권오상 : v003 : T2008250015 : 메모리평문 취약점 수정
' 2020.11.10 : 정민영 : v003 보완
' 2020.11.19 : 정민영 : v004 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_acif_701r IO 변경분 반영
' 2021.05.26 : 김수진 : 개인신용정보동의 공통팝업처리
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim 	g_szPassword 
dim	g_szAccNo 
dim	g_szCurrentTime 	'현재시간
dim	g_szToday			'오늘날짜

dim	g_szManBranch		'관리지점코드		from obacp_opop_066r(공유)
dim	g_szBRCODE			'for obaci_acct_003c.BRCODE
dim  g_szUserID
dim	g_szMangCD
dim	g_szAlertTitle	'알림타이틀
Dim	g_PlainRm 'v003

dim	G_PERSONAL_AGREE_FILE	'개인신용정보동의

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'g_szPassword = "1357"		'임시세팅
	'g_szAccNo = "30076961"		'임시세팅
	'g_szUserID = "chikoo81"		'임시세팅
	
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v003
	g_szToday = Form.GetSharedData("&HOST_DATE", 0)
	g_szCurrentTime= Form.GetSharedData("&HOST_TIME", 0)
	G_PERSONAL_AGREE_FILE = "mbonl81020"
	
	
	g_szAccNo = cont01.acnt01.total
'	g_szPassword	=	cont01.edtPwd01.caption 'v003
	cont01.edtPwd01.caption	=	""
	'v003
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPassword	=	cont01.edtPwd01.caption 'v003
	Else
		g_szPassword	=	Form.GetEncData(cont01.edtPwd01.caption) 'v003
	End If

	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)
	Form.SetSharedData("ONLINE_PSWD",	g_szPassword)

	g_szUserID = Form.GetSharedData("&USER_ID", 0)
	
	cont01_rdoAutoItem01_OnClick(1)  'v0002. 자동매수상품선택(종금형/증권형 선택삭제) - 강제 증권형(RP형 CMA) 셋팅
	
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'cont01_acnt01_ChangeAccount
'============================================================================
Sub cont01_acnt01_ChangeAccount()
	g_szAccNo = cont01.acnt01.total
	Form.SetSharedData("ONLINE_ACNT",	g_szAccNo)
End Sub


