Sub BtnLine_OnClick()
	if g_flagLine = false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath = "btn_chart01_o.9.png"
		
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath = "btn_chart01_n.9.png"
		
	end if
End Sub
