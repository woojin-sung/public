Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_sStockMode
Dim g_flagLine 

g_flagLine = false
g_sStockMode = "1"	' 수정주가 1: 0

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_open_001r") 				'20220523 HSZ : 가로화면 화면집계 서비스호출 추가
	szData = Form.GetOpenLinkData()

	if szData = "" then
		g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	else
		g_szItemCode = szData
	end if
	
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	Form.SetItemCode(g_szItemCode)

	'Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 	' 링크화면에 종목코드 던지기
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_szChrtType = "D" 										'일
	
	g_szToday = Form.GetSharedData( "&HOST_DATE", 0 )

	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END
	
	setChart()
	PeriodSet(g_szChrtType)
	'RequestData()		'PENTA13 START => 2023.07.26(차트성능개선)
	
	Form.SetRealBundle("1")		'PENTA13 START => 2023.09.12(플랫폼개선)
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )
		
		RequestData()
	end	if	
End Sub
'============================================================================
Function RequestData()
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG : K-OTC MTS 도입	
	
	szStockMode = "0"
	if g_sStockMode = "0" then
		szStockMode = "1"
	end if

	PeriodSetChart(g_szChrtType)  '20230905 한국금융IT : 일주월분 차트 주기 설정

	if g_szChrtType = "A" then			'분차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_ISCD", 0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_DATE1", 0, g_szToday )
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN", 0, "Y" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN", 0, "N" )
		
		DATAMANAGER.RequestTranData("ohhts_5010_002r")
		
	elseif g_szChrtType = "T" then		'틱차트

		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_ISCD", 0, g_szItemCode )
		
		sTic = Split(g_szTicType, "틱", -1, 1)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_CNT1", 0, sTic[0] )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, "2" )	
		DATAMANAGER.SetDataValue( 0,  "ohhts_5010_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN", 0, "N" )
		
		DATAMANAGER.RequestTranData("ohhts_5010_003r")
		
	Else
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD", 0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR", 0, g_szChrtType )  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1", 0, g_szToday )
	
		DATAMANAGER.RequestTranData("ohhts_5010_001r")
		
	End If

	DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0, g_szItemMarket )
	DATAMANAGER.RequestTranData("ohhts_1001_001r")	
	
	If g_szItemMarket = "W" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
	
	'20180712 HAMWG START : K-OTC MTS 도입
	ElseIf g_szItemMarket = "T" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
	'20180712 HAMWG END
	
	Else
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		
	End If
	
end Function
