'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin & "/"
			else
				sPeriodType = sPeriodType&sMin & ";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic & "/"
			else
				sPeriodType = sPeriodType&sTic & ";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
		sTemp = split(sPeriodType, "/")
		sMinArr = split(sTemp[0], ";")
		sTicArr = split(sTemp[1], ";")
		'Form.Log("sPeriodType", sPeriodType)	'PENTA13 START => 2023.08.08(차트성능개선)
	   
		for i = 0 to 7 step 1
			Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )
		next
	end if
	
end function
'============================================================================
Sub ChartEx0_OnScrollEnd()
	if g_szChrtType = "A" then
		DATAMANAGER.RequestNextData("ohhts_5010_002r")
		
	elseif g_szChrtType = "T" then
		DATAMANAGER.RequestNextData("ohhts_5010_003r")
		
	else
		DATAMANAGER.RequestNextData("ohhts_5010_001r")
		
	end if
End Sub
'============================================================================
function ChartEx0_OnChangeAdjustedStock(sData)
	if g_sStockMode <> sData then
		g_sStockMode = sData
		Form.SetEnvData( 1, "chart_stockmode", g_sStockMode )
		
		RequestData()
	end if

end function
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetLoadChart("stock")
End Sub

'============================================================================
Sub Form_OnFormClose()
	ChartEx0.SetSaveChart("1")
	Form.SetEnvData( 1,"chart_setting" , g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"chart_settingmintick" , g_szMinType.."^"..g_szTicType )
	
	Form.SendReturnToParent("OrientaitonClose" , g_szItemCode )
End Sub
'============================================================================
function setChart()
     szValue 			= Form.GetEnvData( "chart_setting" )
     szValueMinTick 	= Form.GetEnvData( "chart_settingmintick" )    
	tempStock 		= Form.GetEnvData( "chart_stockmode" )
	
	if tempStock <> "" then
		g_sStockMode = tempStock
		ChartEx0.SetAdjustedStock(g_sStockMode)

	end if
	
	if szValue = "" then
		Form.SetEnvData( "chart_settingmintick" , "2^001" )
		g_sPeriod	= "001"
		g_sPeriodType	= "2"
		
	else
		temp = split(szValue, "^")
		
		g_sPeriodType	= temp[0]
		g_sPeriod	= temp[1]
		
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")
		g_szMinType = temp1[0]
		g_szTicType = temp1[1]
		
	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "chart_min0" )
		szTic0 = Form.GetEnvData( "chart_tic0" )
	
		if szMin0 <> "" and szMin0 <> 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			g_szTicType = szTic0
		else 
			g_szTicType = "1"
		end if
		' 20190404 HWG END     
	     
	end if
	
	'분틱 셋팅	
	tmpIndex = null 
	if g_sPeriodType = "0" or g_sPeriodType ="1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
'PENTA13 START => 2019.03.04
		elseif g_sPeriodType = "4" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
'PENTA13 END
		end if
	end if
	
	RadioGroup0.currentindex = g_TempIndex
	if g_TempIndex = 0 then
		RadioGroup0_OnClick(g_TempIndex)
	end if
	
end function

