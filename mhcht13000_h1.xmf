	ChartEx0.SetOpenDlg("save;BtnSave")
End Sub

'============================================================================
Sub BtnIndi_OnClick()
	ChartEx0.SetOpenDlg("indicatormini;BtnIndi")
End Sub

'============================================================================
Sub BtnTool_OnClick()
	ChartEx0.SetOpenDlg("tools;BtnTool")
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  		'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"

		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then  	'주/월/년
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"

			elseif sTemp == "년" then	'PENTA13 START => 2019.03.04
				g_szChrtType = "Y"

			else
				g_szChrtType = "W"
				
			end if
			
			g_flagWeek = true
			PeriodSet(g_szChrtType)
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_h5.xmf", sTemp, "" )	'PENTA13 START => 2019.03.04
			
		end if
	
	elseif nIndex == 2 then   	'분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
			
		else
			'g_flagMin = false
			Form.OpenPopup( "mhcht13000_h2.xmf", g_szMinType, "" )
			
		end if
		
	elseif nIndex == 3 then   	'틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"
		
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption(3),"틱")
			g_szTicType = tmpTic[0]
			
			PeriodSet(g_szChrtType)
			
		else
			Form.OpenPopup( "mhcht13000_h3.xmf", g_szTicType, "" )
			'g_flagTic = false
			
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"

		elseif sRet == "년" then	'PENTA13 START => 2019.03.04
			g_szChrtType = "Y"

		else
			g_szChrtType = "W"
			
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet )
		PeriodSet(g_szChrtType)
		
	else
		SetLoadChart("reload")
		
	end if
End Sub

'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType, period)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   'g_sNextKey[gCurInd] = ""
'   Form.ShowAlert(sPeriodType, period)
   
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1=1:1=3...#1=1:1=3...#
	if InStr(sPeriodType, "#") > 0 then
		sTemp = split(sPeriodType, "#")
		sMinArr = split(sTemp[0], ":")
		sTicArr = split(sTemp[1], ":")
		Form.Log("sPeriodType",sPeriodType)
	   
		for i = 0 to 13 step 2
			if i == 0 then	
				j = 0
			else
				j = i/2
			end if
			
			g_chartMinArr[j] = sMinArr[i]
			g_chartMinFlagArr[j] = sMinArr[i+1]
		   
			g_chartTicArr[j] = sTicArr[i]
			g_chartTicFlagArr[j] = sTicArr[i+1]
		next
	end if
	   
	Save_ini()
end function

'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)
	if #Count == 1 then
		Count = "000"..Count
	   
	elseif #Count == 2 then
		Count = "00"..Count
	   
	elseif #Count == 3 then
		Count = "0"..Count
	   
	end if

	g_sChartCnt = Count
	RequestData()	
end function

'============================================================================
' 분,틱 설정파일 저장
'============================================================================
function Save_ini()
	dim sMin, sTic, sflag
	
	for i = 0 to 6
		Form.SetEnvData( 1, "chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "chart_min"..i, g_chartMinArr[i] )
		Form.SetEnvData( 1, "chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, g_chartTicArr[i] )
		
	next
'	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			' 데이터갯수...필요 없음 삭제 해도 됩니다.

end function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
'	Form.ShowAlert("", sIndex..":"..sPeriod)	
	if sPeriodType = "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
	   'g_sPeriod = CInt(g_szMinType) * 60
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "Y" then 		'PENTA13 START => 2019.03.04
	   g_sPeriodType = "5"
	   g_sPeriod = "1"

	end if
	
	sPeriod = CInt( g_sPeriod )
	
	if Len( sPeriod ) = 1 then
		g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod ) = 2 then
		g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	' 조회TR 보내기
	RequestData()
end function
'============================================================================
'20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType = "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
	   'g_sPeriod = CInt(g_szMinType) * 60
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "Y" then
	   g_sPeriodType = "5"
	   g_sPeriod = "1"

	end if
	
	sPeriod = CInt( g_sPeriod )
	
	if Len( sPeriod ) = 1 then
		g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod ) = 2 then
		g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
end function
'20230905 한국금융IT END : 일주월분 차트 주기 설정
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode   = Cstr(Trim(Data[0]))            '코드
	g_sPeriodType  = Cstr(Trim(Data[1]))            '일주월년분틱
	g_sPeriod      = Cstr(Trim(Data[2]))            '주기(1,5,...)
	
	'20170126 HWG START - Data table index오류 수정 4->3
	sRefresh = Cstr(Trim(Data[3]))
	radioIndex = ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		'PENTA13 START => 2023.07.04(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱" )
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분" )
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
			
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주" )
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월" )
				
			case "5"						'PENTA13 START => 2019.03.04
				g_szChrtType = "Y"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "년" )
		
		end Select
		'PENTA13 END
	end if
	
	'PENTA13 START => 2023.07.13(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end if
	'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )
	'Form.SetItemCode(g_szItemCode)		'PENTA13 START => 2023.07.26(차트성능개선)
	RequestData()
end function
'============================================================================
'PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		Exit function
	end if

	if nIndex < 1 then
		Exit function
	end if

	Data = split(sData, ";")
	
	g_sPeriodType   = Cstr(Trim(Data[2]))
	g_sPeriod       = Cstr(Trim(Data[3]))
     
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then		'틱
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else								'분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		elseif g_sPeriodType == "4" then	'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else								'년
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
		
		end if
		
	end if
	
	RadioGroup0.setCurIndexSilent(g_TempIndex)

	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		RadioGroup0.enable = 0
	end if

end function
'PENTA13 END
