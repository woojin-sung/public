Sub Cont0_Table0_OnClick(lRow , lColumn)
	'20231212 SWJ START : 계좌별명 및 설정 추가
	'20231103 SWJ START : 자주쓰는은행계좌관리 삭제
	'계좌순서 및 별명설정
	if lRow = 0 then
		Dim sLOGIN_TYPE 
		sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

		if CInt(sLOGIN_TYPE) > 1 then '로그인 상태
			Form.OpenFramePopup( G_ACCOUNT_NICK_FILE , "", "")
		else
			Form.MsgBox( "알림", "로그인이 필요한 화면입니다.\n로그인 하시겠습니까?", "NEED_LOGIN", 2 )
		end if

	elseif lRow == 1 then '자주쓰는은행계좌관리
		'메모관리
		Form.OpenFramePopup(G_MEMOSET_FILE , "" , "")
