'============================================================================
' 메모관리
'============================================================================
Sub Cont0_Image0_OnClick()
	Form.OpenFramePopup(G_MEMOSET_FILE , "" , "")
End Sub
'============================================================================
'20231212 SWJ START
' 계좌별명/설정
'============================================================================
Sub Cont0_Image1_OnClick()
	Dim sLOGIN_TYPE 
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

	if CInt(sLOGIN_TYPE) > 1 then '로그인 상태
		Form.OpenFramePopup( G_ACCOUNT_NICK_FILE , "", "")
	else
		Form.MsgBox( "알림", "로그인이 필요한 화면입니다.\n로그인 하시겠습니까?", "NEED_LOGIN", 2 )
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if (sKeyName == "NEED_LOGIN") then
		if (sRet == "ok") then	
			Form.OpenPopup( "mhetc90021" , "2" , "" )
		end if 
	end if 
End Sub
'============================================================================
'20231212 SWJ START : 로그인 후 계좌 순서/별명 설정 바로 띄우기 위함
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Login_Type" then
		if Cint(sRet) > 1 then
			Form.OpenFramePopup(G_ACCOUNT_NICK_FILE , "" , "")
		end if
	end if
End Sub

