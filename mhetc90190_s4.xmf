Dim g_sBioType
Dim g_PwdpipAuth
Dim g_CustName
Dim g_ScrPoint
Dim g_nextpage, g_nextpage2
'============================================================================
Sub Form_OnFormInit()
	
	Container0.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_RcnoPip  = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
	g_sCsNo 	  = Form.GetSharedData("&CUST_NUM"  , false )	 '고객번호
	g_DeviceID = Form.GetDeviceID2() 
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	'g_DeviceModel	= Form.GetSharedData("&DEVICE_MODEL", false)
	
	'위 쉐어드 변수 사용하면 아이폰은 iPhone이라고만 나옴
	g_DeviceModel	= Form.getDeviceModel()				'모델명
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", 0 )
	
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO",true) '메뉴클릭시 팝업메뉴 화면번호 전달
	g_otpACNO = Form.GetSharedData("Meritz_OTP_ACNO" , false )
	g_szPhoneNum = Form.GetSharedData( "Meritz_OTP_PhoneNum", false )
	g_CustName  = Form.GetSharedData("Meritz_OTP_CustName", false)
	
	g_OSVersion = Form.GetSharedData("&OS_VERSION", false)
	
	'주민번호와 고객번호를 getshared 뒤지다가 안나오면 발급 시 set한 값 불러오도록 처리(ios쪽 처리때문)
	if g_RcnoPip == "" or g_RcnoPip == null then
		g_RcnoPip = Form.GetEnvData("login.session.juminnopip")
	end if

	if g_sCsNo == "" or g_sCsNo == null then
		g_sCsNo = Form.GetEnvData("login.session.custno")
	end if
	
	Container0.Label3.caption = "처음부터 다시 입력하기 >" 
	
	'진입점
	g_ScrPoint = Form.GetOpenLinkData()
	
	'갱신
	if g_ScrPoint == "renew" then
		Container0.labTitle.caption = "메리츠 간편인증"
	end if
	
	'-----------------------------------------------------------------	
	'아톤 PIN 해쉬값 처리를 위해서 필수
	'-----------------------------------------------------------------
	'로그인 상태에서 간편인증 등록 시에는 SharedData 가져와서 쓰자
	'비로그인 상태에서는 계좌인증 화면에서 고객번호 Set해주는 값으로 쓰자
	'(사유: 로그인 상태는 계좌인증 화면을 skip)
	
	if CInt(g_LoginType) > 1 then '로그인상태
		g_CustNo = Form.GetSharedData("&CUST_NUM"  , false )	 '고객번호
		g_RcnoPip = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
	else
		g_CustNo = Form.GetSharedData("Meritz_OTP_CSNO" , false )
		g_RcnoPip = Form.GetSharedData("Meritz_OTP_RCNOPIP" , false )
	end if
	
	'이전화면에서 검증위해 set
	g_PwdpipAuth = Form.GetSharedData("Meritz_OTP_PWDAuth", false)
	
	Container0.EditReal.setHashSalt(g_CustNo)
	
	g_sBioType = Form.getBiometryType()				'생체/지문 기기 및 사용가능여부 판단 : 0.사용불가 1.TOUCH ID 2.FACE ID
	
	Form.SetTimerEvent2("100", 1, 0.1)
	
'	if g_DeviceOS == "1" then
'		'발급 전 아톤 safebox에서 SBinfo 가져오기
'		'ATON_GETALLINFO는 에러처리 하면안됨. 에러인경우에도 SBVersion 획득가능 (에러인경우 sAlias는 획득불가)
'		fnGetSBInfo("ISSUE")
'	end if
	
	'비밀번호 입력키패드 Show
	Form.SetTimerEvent2(1, 1, 0.6)
End Sub
'============================================================================
Sub Form_OnFormInitAfter()
	'iOS forminit에서 정보 불러올 때 씹힘
'	if g_DeviceOS == "2" then
'		'발급 전 아톤 safebox에서 SBinfo 가져오기
'		'ATON_GETALLINFO는 에러처리 하면안됨. 에러인경우에도 SBVersion 획득가능 (에러인경우 sAlias는 획득불가)
'		fnGetSBInfo("ISSUE")
'	end if
End Sub
'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.EditReal.caption == null or Container0.EditReal.caption == "" then
		Form.MsgBox( "알림", "간편인증 비밀번호를 입력해주세요.", "", 6 )
	else	
		if g_AuthSucess = "success" then
		
			'발급 전 아톤 safebox에서 SBinfo 가져오기
			'ATON_GETALLINFO는 에러처리 하면안됨. 에러인경우에도 SBVersion 획득가능 (에러인경우 sAlias는 획득불가)
			fnGetSBInfo("ISSUE")
		
			Call PasswordInsert()
			
			Container0.Label2.visible = false
			Container0.Label3.visible = false

			'-----------------------------------------------------------------------	
			'갱신
			'-----------------------------------------------------------------------
			if g_ScrPoint == "renew" then
			
				'-----------------------------------------------------------------------
				'인증서 조회를 통해서 갱신기간이 아닌 경우, 아래 로직을타서는 안된다. 
				'ATON_ISSUE 수행 시 기존인증서 SafeBox에서 삭제됨
				'-----------------------------------------------------------------------
				
				'-----------------------------------------------------------------------
				'ATON_ISSUE
				'-----------------------------------------------------------------------
				g_TmpAlias = "612110190000001"
				
				sRet = Form.requestAtonAuth("ATON_ISSUE" , g_TmpAlias , "")
				
				sRetItem = Split(sRet, "★")
				
				sErrorCode	= sRetItem[0]
				sErrorMsg	= sRetItem[1]
				sPublicKey 	= sRetItem[2] '공개키
					
				if sErrorCode <> "00000" then
					Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
					exit sub
				end if
				
				'-----------------------------------------------------------------------
				'PIN데이터입력받아야함 (갱신시 2회)
				'-----------------------------------------------------------------------
				sPinData = Container0.EditReal.caption
				
				if sPinData == "" then
					exit sub
				end if
				
				'-----------------------------------------------------------------------
				'전문전송
				'-----------------------------------------------------------------------
				procRequestAtonTR_REISSUECERT(sPinData, sPublicKey)	
				
			'-----------------------------------------------------------------------	
			'발급
			'-----------------------------------------------------------------------
			else
				'-----------------------------------------------------------------------
				'ATON_ISSUE
				'-----------------------------------------------------------------------
				g_TmpAlias = "612110190000001"
				
				sRet = Form.requestAtonAuth("ATON_ISSUE" , g_TmpAlias , "") '발급 시, 임의의 인증서일련번호를 사용하고 전문응답에서 수신받은 일련번호로 변경함
				
				sRetItem = Split(sRet, "★")
				
				sErrorCode	= sRetItem[0]
				sErrorMsg	= sRetItem[1]
				sPublicKey 	= sRetItem[2] '공개키
					
				if sErrorCode <> "00000" then
					Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
					exit sub
				end if
				
				'-----------------------------------------------------------------------
				'PIN데이터입력받아야함 (발급시 2회)
				'-----------------------------------------------------------------------
				sPinData = Container0.EditReal.caption
				
				if sPinData == "" then
					exit sub
				end if
	
				'-----------------------------------------------------------------------
				'전문전송
				'-----------------------------------------------------------------------
				procRequestAtonTR_ISSUECERT(sPinData, sPublicKey)	
			end if
		end if
	end if
	
	nCnt = 0
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.EditReal.SetShowKeypad(True)
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent(sTimerID, 0, 2)
		Form.OpenNextPopup("mhetc90190_s5" , g_sBioType , "")
	end if
End Sub
