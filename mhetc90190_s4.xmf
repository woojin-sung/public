'============================================================================
' 2023.05.16 SWJ START
' 메리츠 사설인증 비밀번호 등록화면
' 2024.01.19 : 전상일 : v0001 : obcsb_oimf_658a ui_cust_cont_cls_code 추가 (별도 맵핑 x)
'============================================================================
Dim g_RcnoPip, g_sUserID, g_sCsNo
Dim g_mSBValue
Dim g_DeviceID , siteCode, g_DeviceModel
Dim g_mOTPInfo
Dim sTRcntt, sTRNo, sHourVal
Dim sRSLT_CLS , sSMRT_OTP_YN
Dim g_mOTPData
Dim szChannel, szErrCntt
Dim nCnt, nSavePwd, g_DeviceOS, szPopupYN, g_LoginType
nCnt = 0
Dim nCount
nCount = 0
Dim g_Cnt
g_Cnt = 0
Dim szErrCode
Dim g_IDRegYN, g_IDRegAcno, g_CountSave, g_CharFlag
Dim g_otpACNO 				'계좌인증단계에서 세팅한 계좌번호
Dim g_szPhoneNum				'휴대폰인증단계에서 세팅한 폰번호
Dim g_AuthSucess				'인증 성공 플래그
g_AuthSucess = ""

Dim g_SBVersion, g_SBAlias, g_OSVersion
Dim g_TmpAlias 				'인증서일련번호 (발급,갱신시 임시번호로 사용)
Dim g_notEncPwd                 '암호화안된
Dim g_CustNo
