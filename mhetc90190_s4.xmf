'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

	if szTranID == "obaci_nmet_011r" then
		szProsClsCode = ""
		szRsltCode    = ""
		
		szProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		szRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If szProsClsCode == "2" and TRIM(szRsltCode) <> "00" Then
			
			Container0.Label2.visible = true
			Container0.Label3.visible = true

			PasswordFail()
			
		Else '비밀번호 입력 성공시
			
			g_AuthSucess = "success"			
			
			Container0_Buttonok_OnClick()
		End If
	
	'발급(등록)
	elseif szTranID == "ohhts_pauth_001" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0)	'인증서일련번호
		sCert 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_DATA_CON" ,0)	'인증서데이터내용
	
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_SAVECERT
		'-----------------------------------------------------------------------		
		sRet = Form.requestAtonAuth("ATON_SAVECERT" , g_TmpAlias & "★" & sCert , "") '발급 시, 임의의 인증서일련번호를 사용하고 전문응답에서 수신받은 일련번호로 변경함
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_RENAMEALIAS
		'-----------------------------------------------------------------------		
		sRet = Form.requestAtonAuth("ATON_RENAMEALIAS" , g_TmpAlias & "★" & sKeyAlias , "") '수신받은 일련번호로 변경함
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if		
		
		Form.SetEnvData(1, "meritzauth.custname", g_CustName)	 '발급 시, 고객명을 앱에 저장 (인증관리 화면에서 사용)
'		
		'-------------------------------------------------------------------------	
'		'바이오 등록여부, 지원여부
'		'-------------------------------------------------------------------------	
		if g_sBioType == "0" then
			g_nextpage = true
			
			Form.SetSharedData("MERITZAUTH_ALIAS" , g_SBAlias)
		
			Form.CloseForm()
			exit sub
		end if
		
		'지문/얼굴 등록여부 판단
		sFingerEnrolled = Form.isTouchIDSupported()
		if sFingerEnrolled <> "1" then	
			g_nextpage = true
			
			Form.SetSharedData("MERITZAUTH_ALIAS" , g_SBAlias)
		
			Form.CloseForm()
			
			exit sub	
		end if
		
		if fnGetSBInfo("") == False then 
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_CHECKBIOSIGNATURE
		'-----------------------------------------------------------------------
		sRet = Form.requestAtonAuth("ATON_CHECKBIOSIGNATURE" , "" , "")
		
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
			
		'바이오 등록시에는 아래 에러는 무시 (더 있는지 테스트필요)
		'E4100	생체 데이터에 오류가 발생하였습니다.
		'E4101	생체 등록 정보가 변경되었습니다.
		'E4102	단말에 등록된 생체 정보가 없습니다.
		'E4103	생체 인증 등록 키가 존재하지 않습니다.
		'E4104	생체 인증에 실패하였습니다.
		'E4105	생체 인증을 취소하였습니다.
		'E4106	TouchID/FaceID가 잠겨있습니다.
		'E4107	단말에 등록된 패스워드가 없습니다.
		'E4108	생체 정보를 사용할 수 없습니다.
		 
		if sErrorCode <> "00000" and sErrorCode <> "E4101" and sErrorCode <> "E4103" and sErrorCode <> "E4105" then 
			g_nextpage = true
		
			Form.SetSharedData("MERITZAUTH_ALIAS" , g_SBAlias)
		
			Form.CloseForm()
			exit sub
		end if	
		
		'-------------------------------------------------------------------------
		'지문/FACE ID 여부 판단
		'-------------------------------------------------------------------------
		'지문/Face
		if g_sBioType == "1" or g_sBioType == "2" then
		
			Form.SetSharedData("Meritz_OTP_PINPWD" , Container0.EditReal.caption)
			
			g_nextpage2 = true
			
			Form.SetSharedData("MERITZAUTH_ALIAS" , g_SBAlias)
			
			Form.CloseForm()
			'Form.SendReturnToParent("mhetc90190_s4" , g_sBioType)
			'g_nextpage2 = ""
			
			'if g_DeviceOS == "1" then 
		'		Form.CloseForm()
		'	end if
		
		'사용불가는 원래 0
		else
			g_nextpage = true
			
			Form.SetSharedData("MERITZAUTH_ALIAS" , g_SBAlias)
			
			Form.CloseForm()
			'Form.SendReturnToParent("mhetc90190_s4" , "nextpage")
			'g_nextpage = ""
				
			'if g_DeviceOS == "1" then 
		'		Form.CloseForm()
		'	end if
		end if
	
	'갱신
	elseif szTranID == "ohhts_pauth_002" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0)	'인증서일련번호(갱신 후)
		sCert 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_DATA_CON" ,0)	'인증서데이터내용
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "renew", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_SAVECERT
		'-----------------------------------------------------------------------		
		sRet = Form.requestAtonAuth("ATON_SAVECERT" , g_TmpAlias & "★" & sCert , "") '발급 시, 임의의 인증서일련번호를 사용하고 전문응답에서 수신받은 일련번호로 변경함
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "renew", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_RENAMEALIAS
		'-----------------------------------------------------------------------		
		sRet = Form.requestAtonAuth("ATON_RENAMEALIAS" , g_TmpAlias & "★" & sKeyAlias , "")
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "renew", 0)
			exit sub
		end if
		
		'알리미 발송
		DATAMANAGER.RequestTranData("obcsb_oimf_658a")
		
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obaci_nmet_011r" then
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"        , 0 , "2")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        	    , 0 , g_PwdpipAuth				)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNFR_PWD_PIP"         , 0 , Container0.EditReal.Caption2)	'해시<->아리아 전환
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     	    , 0 , g_szPhoneNum)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"             , 0 , g_RcnoPip   )
	end if
	
	'알리미 발송 서비스
	if szTranID == "obcsb_oimf_658a" then
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "PROS_CLS"			, 0 , "1"       ) '발급
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "UI_EASY_ATHN_KEY_VAL" , 0 , "01"      ) '간편비밀번호
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "CSNO" 				, 0 , g_CustNo  ) 
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "REG_YN_IQRY_KEY"		, 0 , g_SBAlias  ) 
	end if
End Sub

