	<SCRIPT_INFO _len="5819" _ulen="4792" >
'============================================================================
' LinkForm0 : ETF Super검색
' LinkForm1 : ETF 투자 첫걸임
' LinkForm2 : ETF 매거진
' LinkForm3 : ETF 리포트
' LinkForm4 : 메리츠 선정 테마
' LinkForm5 : 시장에서 관심받는 ETF
'============================================================================

Dim gOsType
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

'============================================================================
Sub Form_OnFormInitBefore()
	
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	SettingUI()
	
End Sub
'============================================================================
Function SettingUI()
	
	'--------------------------------------------------------------
	'(안드로이드 전용) 스크롤보임 후 숨김처리
	'--------------------------------------------------------------
	if gOsType == "1" then	
		contBody.setScrollBarVisible("2")
	end if
	
	'--------------------------------------------------------------
	'뒤로가기 버튼
	'--------------------------------------------------------------
	contTitle.ImgBackPress.setMaintainingRatio("2")
	contTitle.ImgBackPress.imgpath = "icon_main_01"
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSizeMode = Form.GetEnvData("common.textsize")
	nTextsize = -2
	if CInt(szTextSizeMode) > 0 then
		gbLargeFont = true
		gsLargeFontsize = Cint(szTextSizeMode)
	end if	
	
	
	'--------------------------------------------------------------------------------
	' 하단 유의사항 아코디언 생성 및 큰글씨 모드 대응
	'
	' 아코디언 컨트롤 초기 사이즈 지정 
	' : iOS -> Forminit에서 지정
	' : AOS -> addExpandableList 시 OnExpandableAdd 발생. OnExpandableAdd에서 지정
	'--------------------------------------------------------------------------------
	if gOsType == "2" then
		contBody.contNotice.height = 50	
	end if
	
	sNoticeText = "·투자자는 금융투자상품에 대하여 금융상품 판매업자로부터 충분한 설명을 받을 권리가 있으며, 투자전 상품설명서 등을 반드시 읽어보시기 바랍니다.\n\n"..
				"·이 금융상품은 예금자보호법에 따라 보호되지 않습니다.\n\n"..
				"·금융투자상품은 자산가격 변동, 환율 변동, 신용등급 하락등에 따라 투자원금의 손실(0~100%)이 발생할 수 있으며, 그 손실은 투자자에게 귀속됩니다.\n\n"..
				"·채권은 발생사의 신용등급의 하락시 원금손실 발생이 가능하고, 발행사의 파산·부도시 원금 100% 손실이 발생할 수 있습니다.\n\n"..
				"·ETF 거래 시 온라인 거래수수료는 0.009% ~ 0.498132%이며, 기타 자세한 사항은 홈페이지 등을 참고하시기 바랍니다.\n\n"..
				"·증권거래비용, ETF 보수, 기타비용이 추가로 발생할 수 있습니다.\n\n"..
				"메리츠증권 준법감시인 심사필 제 24-354호(2024.05.09 ~ 2025.05.08)"
	
	if gbLargeFont then
		nTextSize = - Cint((gsLargeFontsize * 2))
		contBody.contNotice.makeExpandableList("","",nTextSize,nTextSize,334,333,0,320,false,3)
	else
		contBody.contNotice.makeExpandableList("","",nTextsize,nTextsize,334,333,0,320,false,3)
	end if
	
	contBody.contNotice.addExpandableList("       투자 유의사항",sNoticeText)
	contBody.SetScrollAutoSize()
	

End Function
'============================================================================
Sub Form_OnTriggerEventSCREEN(sEventName, sParam)
	
	if sEventName == "PREV" then
	
		'이전스크롤 값 존재 시 스크롤 위치
		sScrollPos = Form.GetSharedData("ETF_HOME_SCROLL", false )
		
		if sScrollPos <> "" then
			Form.SetSharedData("ETF_HOME_SCROLL" , "")
			contBody.uniSetScroll("0", Cint(sScrollPos))
		end if
	
	else
		
		if sEventName <> "" then
		
			'보고있던 매거진URL(매거진화면에서 링크화면으로 이동 시 저장됨)
			'백버튼으로 다시 되돌아온 경우가 없으면 클리어 시켜줌.
			Form.SetSharedData("50300_SELECT_URL" , "")
			Form.SetSharedData("ETF_HOME_SCROLL" , "")
			
		end if
	
	end if
	
	
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "SAVE_ETF_HOME_SCROLL" then
		
		nScrollPos = contBody.uniGetScroll()
		Form.SetSharedData("ETF_HOME_SCROLL" , nScrollPos)
	
	end if
	
	
End Sub

'============================================================================
Sub contTitle_ImgBackPress_OnClick()
	Form.openPrevScreen()
End Sub

'=======================================================================================
' (안드로이드 전용) 아코디언 Add할때 높이값 리턴
'=======================================================================================
Sub contBody_contNotice_OnExpandableAdd(nHeight)
	contBody.contNotice.height = nHeight + 1
	contBody.SetScrollAutoSize()
End Sub

'=======================================================================================
' 유의사항 컨테이너(아코디언) 접기/펼치기 후 사이즈 리턴(애니메이션 미사용 시에만 호출)
'=======================================================================================
Sub contBody_contNotice_OnExpandableSize(nHeight)

	if gOsType == "1" then
		contBody.contNotice.height = nHeight + 1
	else
		contBody.contNotice.height = nHeight
	end if
	
	contBody.SetScrollAutoSize()
	contBody.scroll_pos = "end"
	
End Sub
	</SCRIPT_INFO>
</ROOT>