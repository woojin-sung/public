				<LINKFORM name="LinkForm1" linkfile="nrshidx50010_s2" ly_vert="0,235,375,193,1" />
				<LABEL name="separator1" bgcolor="320:246247248" transmode="0" ly_vert="0,428,375,10,1" />
				<LINKFORM name="LinkForm2" linkfile="nrshidx50010_s3" ly_vert="0,766,375,303,1" />
