'--===========================================================================
' 작  성 : 장원혁 : 2021.02.24.
' 수  정 : 장원혁 : 2021.02.24.
'--===========================================================================
Dim g_RCNO_PIP
	   
'============================================================================
' 21.09.13 JHY 추가
' getListItem(szInput, nIdx) : 해당하는 인덱스의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return ""
	else
		szList = split(szInput, "★")
		if szList <> "" then
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return ""
				end if
				
			else
				return ""
			end if
		else
			return ""
		end if 
	end if 
end function

'============================================================================
Sub Form_OnFormInit()
	' 21.09.13 JHY START  
'    g_RCNO_PIP           = Form.GetSharedData("BDM_RCNO_PIP"      , False)
'    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO"           , 0, "NMET"   )
'    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_PIP"       , 0,  g_RCNO_PIP)
'    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_TYPE_CODE" , 0, "01"     )
'    DATAMANAGER.RequestTranData("obcsb_acif_701r")        

	Dim szData
	szData = Form.GetOpenLinkData()
	
	tblGrade.SetCellString(1, 1, getListItem(szData, 0))
	tblGrade.SetCellString(2, 1, getListItem(szData, 1))
	tblGrade.SetCellString(3, 1, getListItem(szData, 2))
	
	'만기일 추가
	tblGrade.SetCellString(1, 2, getListItem(szData, 3))
	tblGrade.SetCellString(2, 2, getListItem(szData, 4))
	tblGrade.SetCellString(3, 2, getListItem(szData, 5))
	
	If CInt(getListItem(szData, 6)) > 0 Then
		Label1.visible = True
		Label0.visible = True
	End If
	
	' 21.09.13 JHY END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    If szTranID = "obcsb_acif_701r" Then
        Label0.visible = True	
	
        szInvGradeIn = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
	
'        ImgValid.visible = True
        Label1.visible = True
'        Label2.visible = True
        Label4.visible = True	
        Label0.top = 481	    
            
'        If szInvGradeIn == "01" Then
'            Label2.caption = "고수익지향형"
'            ImgValid.imgpath = "icon_invest_grade_5.png"
'        ElseIf szInvGradeIn == "02" Then
'            Label2.caption = "성장지향형"
'            ImgValid.imgpath = "icon_invest_grade_4.png"
'        ElseIf szInvGradeIn == "03" Then
'            Label2.caption = "중립형"
'            ImgValid.imgpath = "icon_invest_grade_3.png"		
'        ElseIf szInvGradeIn == "04" Then
'            Label2.caption = "안정지향형"
'            ImgValid.imgpath = "icon_invest_grade_2.png"
'        ElseIf szInvGradeIn == "05" Then
'            Label2.caption = "이자소득형"
'            ImgValid.imgpath = "icon_invest_grade_1.png"
'        Else
'            ImgValid.imgpath = "icon_error.png"
'            Label2.caption = "정보미제공"
'        End If

	
	'	[KYC투자성향등급코드]
	'	00@정보미제공
	'	01@고수익지향형
	'	02@성장지향형
	'	03@중립형
	'	04@안정지향형
	'	05@이자소득형
	
	szInvGradeOut = Form.GetMetaData("KYC투자성향등급코드", szInvGradeIn)
	tblGrade.SetCellString(0, 1, szInvGradeOut)

	Dim szEntt, szTrust, szEnttName, szTrustName

	szEntt = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "ENTT_IVIC_GRCD", 0)
	szTrust = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "TRUST_IVIC_GRCD", 0)

	' KYC꺼에 맵핑하면 된다고 권오상 차장님 확인
	szEnttName = Form.GetMetaData("KYC투자성향등급코드", szEntt)
	szTrustName = Form.GetMetaData("KYC투자성향등급코드", szTrust)

	tblGrade.SetCellString(1, 1, szInvGradeOut)
	tblGrade.SetCellString(2, 1, szEnttName)
	tblGrade.SetCellString(3, 1, szTrustName)
	
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(szSubMsg) == "" Then
        Form.MsgBox("알림" , szErrMsg, "", 6)
    Else
        Form.MsgBox("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" , "", 6)
    End If
End Sub


'============================================================================
Sub BtnCnfr_OnClick()
    Form.SendReturnToParent("MBBDM85143", "ok")
    Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    '투자성향 등록 "완료안내"페이지이므로 비정상종료가 아닌 정상종료로 리턴
    'Form.SendReturnToParent("MBBDM85143", "")
    Form.SendReturnToParent("MBBDM85143", "ok")
    Form.CloseForm()
End Sub



