	<SCRIPT_INFO _len="15368" _ulen="13922" >
Dim g_szAcnt
Dim g_szAcntCd   
Dim g_szAcntPwd
Dim g_szCustID
Dim g_szType
g_szType = "0"

'============================================================================
Sub Form_OnFormInitBefore()

	imgNodata.setMaintainingRatio("1")

End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'-----------------------------------------------------------------------------
	' 탭 생성
	'-----------------------------------------------------------------------------
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "현금")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "대출")
	FormTab0.currenttab = 0

	'-----------------------------------------------------------------------------
	' 유저아이디 가져오기
	'-----------------------------------------------------------------------------
	g_szCustID = Form.GetSharedData("&USER_ID", false )

	'-----------------------------------------------------------------------------
	' 링크데이터 가져오기
	'-----------------------------------------------------------------------------
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		
		
		g_szAcnt   	= tData(0) '종합계좌(8자리)
		g_szAcntCd 	= tData(1) '계좌일련번호(2자리)
		g_szAcntPwd	= tData(2) '계좌비밀번호
		g_szType		= tData(3) '잔고구분(0:현금/1:대출)
		
		'-----------------------------------------------------------------------------
		' 초기탭으로 이동
		' 매도화면 현금(0)/대출(1) 라디오버튼 인덱스 받아와서 처리.
		' 받아온값에 +1을 해줘야 현재 화면의 전체(0)/현금(1)/대출(2) 탭으로 이동 가능 
		'-----------------------------------------------------------------------------
		FormTab0.currenttab = Cint(g_szType) + 1
		
		'-----------------------------------------------------------------------------
		'초기탭 이동 후 서비스 인풋값에 올라가는 값으로 변경
		'-----------------------------------------------------------------------------
		if g_szType == "0" then		'현금
			g_szType = "1"
		elseif g_szType == "1" then 	'대출
			g_szType = "2"
		end if
		
		Request_Data()
		
	end if
	
	'------------------------------------------------------------
	'정렬(소팅)헤더 설정
	'------------------------------------------------------------
	'grdList.setSortCellID("th_cell24","bd_cell25") '종목명
	'grdList.setSortCellID("th_cell31","bd_cell11") '종목코드
	'grdList.setSortCellID("th_cell1","bd_cell26")  '구분
	'grdList.setSortCellID("th_cell2","bd_cell3")   '평가손익
	'grdList.setSortCellID("th_cell3","bd_cell13")  '수익률
	
	
End Sub

'============================================================================
Function Request_Data()
	
	grdList.rowcount = 0
	DATAMANAGER.RequestTranData("obtro_oder_110r")
	
End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	If szTranID = "obtro_oder_110r" Then
		
		DATAMANAGER.ClearInputData(0, "obtro_oder_110r")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "ACNO" 				, 0, g_szAcnt)		
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "ASNO" 				, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "ACNT_PWD"			, 0, g_szAcntPwd)
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "IQRY_CLS_CODE"		, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "PROD_PSTN_CLS_CODE"	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "ELFN_ID"				, 0, g_szCustID)
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "RMND_CLCD"			, 0, g_szType) 'v001
		
		'------------------------------------------------------------
		'주간거래시세 적용 구분값
		'------------------------------------------------------------
		sDayYN = Form.GetSharedData( "&OVRS_DAYMARKET", false )
	
		if sDayYN == "Y"  then
			DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "DYTM_TR_CLPR_APLY_YN"	, 0, "Y")
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "DYTM_TR_CLPR_APLY_YN"	, 0, "N")
		end if
		
		'------------------------------------------------------------
		' 비용포함 여부(Y/N)
		'------------------------------------------------------------
		Dim sApplyCost
		nCheckCost = Cint(checkCost.checkstate)
		
		if nCheckCost == 1 then
			sApplyCost = "Y"
		else
			sApplyCost = "N"
		end if
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_110r", "InBlock1", "FEE_INCU_YN"	, 0, sApplyCost)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtro_oder_110r" Then
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_110r") == true then
		   DATAMANAGER.RequestNextData( "obtro_oder_110r" )
		else
		   
			'-------------------------------------------------------
			' 데이터 조회건수 체크
			'-------------------------------------------------------
			nDataCnt = Cint(grdList.rowcount)
			
			if nDataCnt == 0 then
				imgNodata.visible = true
				lblNodata.visible = true
			else
				imgNodata.visible = false
				lblNodata.visible = false
			end if
			
			'-------------------------------------------------------
			' 국가명세팅(삭제)
			'-------------------------------------------------------
			'SetGridData()
		
			'-------------------------------------------------------
			'잔고구분(현금/일반) / 구분에 따른 수량데이터 포맷 설정
			'-------------------------------------------------------
			SetItemGubun()
			
			'-------------------------------------------------------
			'등락에따른 글자색상 설정
			'-------------------------------------------------------
		   	for i = 0 to grdList.rowcount -1
				nDiff = CDbl(grdList.GetCellData("bd_cell10", i))
				swapItemColor(i, nDiff)
			next
		   
		end if
	
	End If
	
End Sub

'============================================================================
' 종목선택
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData

	if lRow > -1 then
	
		'-------------------------------------------------------------
		' 선택종목 종목정보 획득
		'-------------------------------------------------------------
		szCdName		= grdList.GetCellData("bd_cell25"	,    lRow)
		szCd			= grdList.GetCellData("bd_cell11"	,    lRow)
		szVndrCd		= grdList.GetCellData("bd_cell17"	,    lRow)
		szQty		= grdList.GetCellData("bd_cell12"	,    lRow)
		
		szLoanDate 	= grdList.GetCellData("bd_cell23", lRow)
		szLoanCd   	= grdList.GetCellData("bd_cell27", lRow)
		szLoanSr   	= grdList.GetCellData("bd_cell28", lRow)
		
		'-------------------------------------------------------------
		' 천단위 부호 삭제 처리(안드로이드 천단위 부호 중복방지)
		' 자세한 내용은 해외주식 주문화면 내 잔고(16100_t5) 화면에 작성
		'-------------------------------------------------------------
		szQty = replace(szQty,",","")
		
		'-------------------------------------------------------------
		' 오프라인종목 예외처리
		'-------------------------------------------------------------
		szOnline 	= grdList.GetCellData("bd_cell19"	,	lRow)
		if szOnline == "N" then
			Form.MsgBox("안내", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요.", "OnLineCheck", 6)
			Exit Sub
		end if
			
		szFullcode = grdList.GetCellData("bd_cell20", lRow)
		szMarketCode = right(szFullcode,2)
		
		if szMarketCode == "OT" then
			Form.MsgBox("안내", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요.", "OnLineCheck", 6)
			Exit Sub
		end if
		
		'-------------------------------------------------------------
		' 종목정보 전달
		'-------------------------------------------------------------
		'szData = [0]:구분명
		'    	 [1]:종목명
		'		 [2]:종목코드 
		'		 [3]:시장구분코드(4자리)
		'		 [4]:매도가능수량
		'		 [5]:대출일자
		'		 [6]:대출구분코드
		'		 [7]:대출일련번호
		'------------------------------------------------------------------------
		
		szData = "잔고" & "★" & szCdName & "★" & szCd & "★" & szVndrCd & "★" & szQty & "★" & szLoanDate & "★" & szLoanCd & "★" & szLoanSr
		Form.SendReturnToParent("16100_BALANCE", szData)
		Form.CloseForm()
	
	end if
	
End Sub

'============================================================================
' 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' SetGridData => 국가명 세팅
'============================================================================
Function SetGridData()

	For iCnt = grdList.rowcount - 1 To 0 Step -1
		
		szType 	= grdList.GetCellData("bd_cell7" , iCnt)
		szVndr 	= grdList.GetCellData("bd_cell17" , iCnt)
		
		' 시장구분
		if szType == "01" then
			grdList.SetCellData("bd_cell16", iCnt, "미국")
		elseif szType == "02" then
			grdList.SetCellData("bd_cell16", iCnt, "홍콩")
		elseif szType == "03" then
			grdList.SetCellData("bd_cell16", iCnt, "중국")
		elseif szType == "04" then
			grdList.SetCellData("bd_cell16", iCnt, "중국")
		elseif szType == "05" then
			grdList.SetCellData("bd_cell16", iCnt, "일본")
		elseif szType == "06" then
			grdList.SetCellData("bd_cell16", iCnt, "호주")
		elseif szType == "07" then
			grdList.SetCellData("bd_cell16", iCnt, "싱가포르")
		elseif szType == "19" then
			grdList.SetCellData("bd_cell16", iCnt, "스페인")
		elseif szType == "21" then
			grdList.SetCellData("bd_cell16", iCnt, "캐나다")
		elseif szType == "23" then
			grdList.SetCellData("bd_cell16", iCnt, "인도네시아")
		elseif szType == "24" then
			grdList.SetCellData("bd_cell16", iCnt, "베트남")
		end if
		
		szVndrStr = Transform_Exid(szVndr)
		grdList.SetCellData("bd_cell6", iCnt, szVndrStr)

	Next
	

End Function

'============================================================================
' 거래소벤더코드 => 거래소명 세팅
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "HS0529I" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		'return "상해"
		return "후강통"
	elseif sValue == "0214" then ' 심천거래소 종목
		'return "심천"
		return "선강통"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "0770" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "0771" then ' 베트남 하노이
		return "하노이"
	end if
end Function

'============================================================================
' 등락 색상 설정
'============================================================================
Function swapItemColor(nIndex, nDiff)
	
	grdlist.SetCellFgColor( "bd_cell10"	, nIndex	, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist.SetCellFgColor( "bd_cell5"	, nIndex	, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	
	grdlist.SetCellData( "bd_cell0", nIndex, nDiff > 0 and "2" or ( nDiff < 0 and "5" or "0" ) )
	
End Function

'============================================================================
' 잔고구분/수량데이터 포맷 설정
'============================================================================
Sub SetItemGubun()
	
	Dim nOwnQty, nMadoQty, szDotType, szLoanType 
	
	for i = 0 to grdList.rowcount -1 
	
		'------------------------------------------------------------------------
		' 종목명 세팅
		'------------------------------------------------------------------------
		sName = grdList.GetCellData("bd_cell25", i)
		grdList.SetCellMaxLineCount("bd_cell25",2)
		grdList.SetCellData("bd_cell25", i, sName)
	
		'------------------------------------------------------------------------
		' 수량세팅
		'------------------------------------------------------------------------
		nOwnQty = CDbl(grdList.GetCellData("bd_cell31", i))  '잔고수량
		nMadoQty = CDbl(grdList.GetCellData("bd_cell32", i)) '매도가능수량
		
		nOwnQty = FormatNumber(nOwnQty, 0)
		nMadoQty = FormatNumber(nMadoQty, 0)
		
		grdList.SetCellData("bd_cell2", i, nOwnQty)
		grdList.SetCellData("bd_cell12", i, nMadoQty)
		
		'------------------------------------------------------------------------
		' 잔고구분 세팅
		'------------------------------------------------------------------------
		szLoanType = grdList.GetCellData("bd_cell27", i)
		szJangoType = grdList.GetCellData("bd_cell29", i)
		
		'------------------------------------
		' 종목코드 + 현금/대출 구분
		'------------------------------------
		Dim sData 
		sData = ""
		
		if szJangoType == "1" then
			'grdList.SetCellData("bd_cell26", i, "현금")
			sData = "현금"
		elseif szJangoType == "2" then '대출
			grdList.SetCellData("bd_cell26", i, "대출")
			sData = "대출"
		end if
		
		sData = sData & " | " & grdList.GetCellData("bd_cell11", i)
		
		grdList.SetCellData("bd_cell145", i, sData)
	
	next
	

End sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	
	'--------------------------------------------------------------
	' 변경된 탭 인덱스에 따라 서비스 인풋값에 올라갈 값으로 변환
	'--------------------------------------------------------------
	if nCurrentTab == 0 then
		g_szType = "0"
	elseif nCurrentTab == 1 then
		g_szType = "1"
	elseif nCurrentTab == 2 then
		g_szType = "2"
	end if
	
	'--------------------------------------------------------------
	' 서비스 호출
	'--------------------------------------------------------------
	Request_Data()
	
End Sub

'============================================================================
Sub checkCost_OnChange(sCheckState)
	Request_Data()
End Sub

