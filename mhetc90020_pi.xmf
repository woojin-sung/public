<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="90020" scrname="인증서선택팝업" version="2" writer="이은섭" />
	<FORM_INFO name="Form" transmode="0" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBack" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg_common.9" ly_vert="32,200,312,145,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="인증서 선택" halign="1" ly_vert="52,220,275,32,1" />
		<BUTTON name="BtnClose" caption="닫기" fgcolor="004:000000000" fontsize="2" btnimage="btn_25.9" ly_vert="32,340,157,45,1" />
		<BUTTON name="BtnOk" caption="확인" fontsize="2" btnimage="btn_26.9" ly_vert="189,340,156,45,1" />
		<RADIOGROUP name="RadioGroup0" initselectionuse="1" initselection="0" ly_vert="60,255,200,68,1" >
			<RADIO_INFO>
				<RADIO no="0" text="메리츠간편인증" position="0,0,132,50" />
				<RADIO no="1" text="공동인증서" position="0,25,100,50" />
			</RADIO_INFO>
		</RADIOGROUP>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="878" _ulen="860" >
Dim g_sDATA
g_sDATA = 5

'============================================================================
' 인증서 선택
'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	nIndex = CInt(nIndex)
	
	if nIndex == 0 then
		g_sDATA = 5
	elseif nIndex == 1 then
		g_sDATA = 0
	elseif nIndex == 2 then
		g_sDATA = 3
	end if

End Sub

'============================================================================
' 닫기
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 확인
'============================================================================
Sub BtnOk_OnClick()
	Form.SendReturnToParent("mhetc90020_pi", g_sDATA)
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>