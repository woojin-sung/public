'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 일별탭
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function SetFlag(szCRCD)
	Select Case szCRCD
		Case "USD"	
			lblCRCD.caption = "미국 " & szCRCD 
			ImgCRCD.imgpath = "flag_us2.png"
			'ImgSelect.left = 166
			ImgSelect.left = 130
		Case "JPY"		
			lblCRCD.caption = "일본 " & szCRCD 
			ImgCRCD.imgpath = "flag_jp2.png" 
			'ImgSelect.left = 145
			ImgSelect.left = 130
		Case "CNY"				
			lblCRCD.caption = "중국 " & szCRCD 
			ImgCRCD.imgpath = "flag_chn.png" 
			'ImgSelect.left = 165
			ImgSelect.left = 130
		Case "HKD"				
			lblCRCD.caption = "홍콩 " & szCRCD 
			ImgCRCD.imgpath = "flag_hk.png" 
			'ImgSelect.left = 165
			ImgSelect.left = 130
		Case "EUR"	
			lblCRCD.caption = "유로화 " & szCRCD 
			ImgCRCD.imgpath = "flag_eu.png" 
			ImgSelect.left = 145
		Case "CHF"	
			lblCRCD.caption = "스위스 " & szCRCD 
			ImgCRCD.imgpath = "flag_swi.png" 
			'ImgSelect.left = 183
			ImgSelect.left = 145
		Case "AUD"		
			lblCRCD.caption = "호주 " & szCRCD 
			ImgCRCD.imgpath = "flag_aus.png" 
			'ImgSelect.left = 165
			ImgSelect.left = 130
		Case "CAD"
			lblCRCD.caption = "캐나다 " & szCRCD 
			ImgCRCD.imgpath = "flag_can.png" 
			'ImgSelect.left = 183
			ImgSelect.left = 145
		Case "SGD"	
			lblCRCD.caption = "싱가포르 " & szCRCD 
			ImgCRCD.imgpath = "flag_sgp.png" 
			'ImgSelect.left = 195
			ImgSelect.left = 160
		Case "VND"	
			lblCRCD.caption = "베트남 " & szCRCD 
			ImgCRCD.imgpath = "flag_vie_round.png" 
			'ImgSelect.left = 195
			ImgSelect.left = 160
	End Select
end Function

'============================================================================
' SetNoticeMsg() : 데이터가 없는 경우 메시지 처리
'============================================================================
Function SetNoticeMsg()
	if CStr(grd1.rowcount) == "0" then 
'	     영업일오전
		'lbNoticeMsg.caption = "환율정보가 없어요. 9시이후 조회돼요."
		lbNoticeMsg.caption = "환율정보가 없어요."
		imgNotice.left = 171
		lbNoticeMsg.left = 87 				
		imgNotice.visible = true
		lbNoticeMsg.visible = true 		
	else
		imgNotice.left = 671
		lbNoticeMsg.left = 587 				
		imgNotice.visible = false
		lbNoticeMsg.visible = false 					
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	ImgCRCD.setMaintainingRatio("1")
	ImgSelect.setMaintainingRatio("1")	
	ImgSelect1.setMaintainingRatio("1")	
	ImgRefresh.setMaintainingRatio("1")	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
	lblTitle.paddinginfo = "0,0,0,0"
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = "icon_main_01"
	
	Dim szData, szList
	szData = Form.GetOpenLinkData()
	szList = Split(szData, "★")	
	if UBOUND(szList) < 1 then
		'exit sub
		lblCRCD.caption  = "미국 USD"
	else
		lblCRCD.caption  = szList(0)
		SetFlag(Right(szList(0), 3))
		if Trim(szList(1)) <> "" then
			Calendar0.caption = szList(1)
		end if
	end if
	lblDate.caption = Calendar0.caption	
	ImgRefresh_OnClick()	
	Form.SetTimerEvent(1, 1, 60)
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetTimerEvent(1, 0, 60) '타이머끄기
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtsd_fbnk_226r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE", 0, Calendar0.caption )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, "287" )	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRCD", 0, Right(lblCRCD.Caption, 3)) 
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID =	"obtsd_fbnk_226r"	then    
		SetNoticeMsg()
		ImgRefresh.visible = true
    end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID =	"obtsd_fbnk_226r"	then
		if szErrCode == "1093" then '당일자 환율 미고시 
		     '영업일오전
			lbNoticeMsg.caption = "환율정보가 없어요.\n 9시 이후 조회돼요."
			imgNotice.left = 171
			lbNoticeMsg.left = 87 				
			imgNotice.visible = true
			lbNoticeMsg.visible = true 
		end if 
	end if 	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CDRD_SET" then

		if sRet <> "" then
			SetFlag(sRet)
			ImgRefresh_OnClick()
		elseif sKeyName == "DATE_SET" then
		
			ImgRefresh_OnClick()
		end if 
	end if 
End Sub


'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub lblCRCD_OnClick()
	Form.OpenPopupAnimation("nrsbbnk65100_p1", Right(lblCRCD.caption, 3),  "",  2)
End Sub

'============================================================================
Sub ImgCRCD_OnClick()
	lblCRCD_OnClick()
End Sub

'============================================================================
Sub ImgSelect_OnClick()
	lblCRCD_OnClick()
End Sub

'============================================================================
Sub lblDate_OnClick()
	'날짜선택팝업
	Calendar0.showcalendar = "1"
	'ImgRefresh_OnClick()
End Sub

'============================================================================
Sub ImgSelect1_OnClick()
	lblDate_OnClick()
End Sub

'============================================================================
Sub Calendar0_OnEditComplete()
	lblDate.caption = Calendar0.caption
	ImgRefresh_OnClick()
End Sub

'============================================================================
Sub ImgRefresh_OnClick()
	ImgRefresh.visible = false
	DATAMANAGER.RequestTranData("obtsd_fbnk_226r")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	ImgRefresh_OnClick()
End Sub


