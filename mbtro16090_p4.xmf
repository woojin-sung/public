'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData, szSplitData, szTempTitle
	
	szOpenData = Form.GetOpenLinkData()
	'szOpenData = "미국"
	szTempTitle = szOpenData & "시장 실시간 시세신청을 해지하시겠습니까?"
	Table0.SetCellString(0, 0, szTempTitle)
End Sub
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "INFO_POPUP" , "CANCEL" )
	Form.CloseForm()
End Sub

'============================================================================
Sub Button0_OnClick()
