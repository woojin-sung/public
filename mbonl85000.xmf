'============================================================================
' fmtab0_OnTabChanged(nCurrentTab)
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	g_szData = Form.GetSharedData("&CUST_NUM", false ) & "★" & LblID.caption 
			
	if nCurrentTab == 0 then
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid, "계좌추가", g_szData)
	else
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid, "계좌해지", g_szData)
	end if
	
End Sub

'============================================================================
'						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obcsb_efif_000r" then
		Dim RCNO_PIP
		RCNO_PIP	= Form.GetSharedData("&JUMIN_NUM", false)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE",	0, "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP",		0, RCNO_PIP)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_efif_000r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		
		if nCnt > 0 then
			
			for i = 0 to nCnt - 1
				Dim USER_ID, ELFN_ID
				USER_ID = Form.GetSharedData("&USER_ID", false)
				ELFN_ID = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ELFN_ID", 	i)
				
				if USER_ID == ELFN_ID then
				
					if "Y" == DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ATMT_ISNC_YN", i) then
						Label2.visible = true
					else
						Label2.visible = false
					end if
					
				end if

			next

		end if
		
	end if
	
End Sub

