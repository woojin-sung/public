Sub Form_OnFormInit()
'	Dim sLOGIN_TYPE
'	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false)
'	
'	if sLOGIN_TYPE = "1" then
'		Form.MsgBox("알림", "로그인이 필요한 화면입니다.\n로그인 하시겠습니까?", "NEED_LOGIN", 2)
'		Exit Sub
'	end if
	
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm	= Form.GetSharedData("&PLAIN_RM", false)
	
	if Form.GetSharedData("&USER_ID", false ) <> "" then
		LblID.caption = Form.GetSharedData("&USER_ID", false )
	end if
	
	DATAMANAGER.RequestTranData("obcsb_efif_000r")
	
	fmtab0_OnTabChanged(0)
End Sub

