	<SCRIPT_INFO _len="9782" _ulen="9348" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 뉴스상세팝업
' 03. 작    성 : 2016.04.30 LJS
			   '2017.03.03 NOHES : 관련주, 관심종목등록, my뉴스 저장 기능 추가
			   '20230724 HSZ: Button0 삭제(관심종목 등록)
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szDate, g_szTime, g_szNewCorpName, g_szNewKey, g_szNewsCorpCode
Dim g_nFontSize
Dim g_nCount
Dim g_szScreen		'직전화면파일명
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Image1.setMaintainingRatio("1")	'20231128 HSZ
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	'20170227 NOHES START : 해당팝업 불러온 파일명 읽기
	t_Data = Split(szData, "★")

	if UBOUND(t_Data) > 0 then
		g_szScreen = t_Data(0)
		szData = t_Data(1)
	end if
	'20170227 NOHES END : 키워드뉴스에서 넘어온 화면인지 확인
	
	arrData = Split(szData,"|")

	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szDate			= arrData(1)
	g_szTime			= arrData(2)
	g_szNewCorpName	= arrData(3)
	g_szNewKey		= arrData(4)
	g_szNewsCorpCode	= arrData(5)
	g_nCount 		= 0
	
	contNews.lblItemName.caption = arrData(6)	
	
	lblTitle.caption = arrData(0)
	tblDateTime.SetCellString( 0, 0, g_szDate)
	tblDateTime.SetCellString( 0, 1, g_szTime)
	tblDateTime.SetCellString( 0, 4, g_szNewCorpName)
	
	
	'20180503 LES START 
	Table0.visible = false
	Grid0.visible = false
''	Button0.visible = false
	'LES END
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
'	Form.ShowAlert("90031_p1", "FormInit")
	g_nFontSize = 0
	'20170227 NOHES START : Row unvisible 처리
	For i=0 to Grid0.colcount-1
		Grid0.SetVisibleCol(i, false)	
	Next	
	'20170227 NOHES END
'	20220706 HSZ START : 해외주식 현재가-뉴스탭 추가
	if g_szScreen = "mhtro16000_t09" then
		lblTitle.top = 35
		tblDateTime.top = 96
		contNews.top = 88
		Label0.top = 130
			
		webNews.top = 136
		webNews.height = 541
	end if
'	20220706 HSZ END
	DATAMANAGER.RequestTranData( "ohhts_news_002r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_news_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_news_002r", "InBlock1", "FID_INPUT_SRCH_NAME"  		, 0 , g_szNewKey )
		DATAMANAGER.SetDataValue( 0, "ohhts_news_002r", "InBlock1", "FID_INPUT_NEWS_OFER_ENTP_CODE" , 0 , g_szNewsCorpCode )	
	'20170227 NOHES START : 'my뉴스 저장	
	
	elseif szTranID == "ohhts_news_004r" then	
		sLoginID = Form.GetSharedData( "&USER_ID", 0 )
		DATAMANAGER.SetDataValue( 0, "ohhts_news_004r", "InBlock1", "FID_USER_ID"  		, 0 , sLoginID )
		DATAMANAGER.SetDataValue( 0, "ohhts_news_004r", "InBlock1", "FID_NEWS_KEY" , 0 , g_szNewKey )	
		DATAMANAGER.SetDataValue( 0, "ohhts_news_004r", "InBlock1", "FID_INPUT_DATE" , 0 , g_szDate )
		DATAMANAGER.SetDataValue( 0, "ohhts_news_004r", "InBlock1", "FID_INPUT_HOUR" , 0 , g_szTime )
		DATAMANAGER.SetDataValue( 0, "ohhts_news_004r", "InBlock1", "FID_MON_YN" , 0 , "" )
	'20170227 NOHES END	
	
	elseif szTranID == "ohhts_news_010r" then
		'채권 전용 My뉴스 저장
		sLoginID = Form.GetSharedData( "&USER_ID", 0 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_USER_ID",	0 , sLoginID )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_NEWS_KEY", 	0 , g_szNewKey )	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_DATE",	0 , g_szDate )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_MON_YN",	0 , "" )  'Y : 삭제
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	Dim szData, szStrTemp, szNewsData
	
	If szTranID = "ohhts_news_002r" Then
	    Dim nCnt, i, szUrlPath
	    
	    szData = ""
	    szStrTemp = ""
	    szNewsData = ""
	    
	    '20170227 NOHES START : 관련 종목 안내
	    g_nCount = DATAMANAGER.GetDataCount(0, "ohhts_news_002r" , "OutBlock2")
	    	    
	    for i=0 to g_nCount -1
		    
		    '20210622 LES START
		    'szTemp = DATAMANAGER.GetDataValue(0 , "ohhts_news_002r" , "OutBlock2" , "FID_SHRN_ISCD" , i)
		    szTemp = DATAMANAGER.GetDataValue(0 , "ohhts_news_002r" , "OutBlock2" , "FID_NEW_SHRN_ISCD" , i)
		    '20210622 LES END
		    
		    szName = Form.GetItemCodeInfo(szTemp, "name")
		    szNameID = "bd_name"+i
		    szCodeID = "bd_code"+i			
			szCellID = "th_cell"+i
                                                                                                                          
			Grid0.SetCellData(szNameID, 0, szName)
			Grid0.SetCellData(szCodeID, 0, szTemp)
			Edit0.caption = szName  				'GridTopCaption의 버튼이 마스크 속성 안먹기 때문에, 우회처리
			sMaskName = Form.GetCtlProp("Edit0", "dispcaption")
			
			Grid0.SetCellTopCaption(szCellID, sMaskName )
			 
			Grid0.SetCellFgColor(szCodeID, 0, "016")
			Grid0.SetCellFgColor(szNameID, 0, "016")
			Grid0.SetVisibleCol(i, true)
	    next

'		20220706 HSZ START : 해외주식 현재가-뉴스탭 추가
		if g_szScreen = "mhtro16000_t09" then
			g_nCount = 0
		end if
'		20220706 HSZ END
		
		if g_nCount > 0 Then
'			Button0.visible = true
			Table0.visible = true
			Grid0.visible = true
		
		else
			'20180503 LES START
			lblTitle.top = 35
			tblDateTime.top = 96
			contNews.top = 88
			Label0.top = 130
			
			webNews.top = 136
			webNews.height = 541
			'LES END
				
		End if
	    '20170227 NOHES END
	    
	    '뉴스 원문 셋팅
	    nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_news_002r", "OutBlock1" )	    	    

		for i =0 to nCnt - 1
		    szStrTemp 	= DATAMANAGER.GetDataValue( 0, "ohhts_news_002r", "OutBlock1", "FID_NEWS_CNTT", i )
		    
		    '20160803_01 LKM start
		    if Trim(szStrTemp) <> "" and szStrTemp <> null then
'			    20220706 HSZ START : 해외주식 가로스크롤 현상 방지
				if g_szScreen = "mhtro16000_t09" then
				    szStrTemp		= replace(szStrTemp,"<HTML>", "<!DOCTYPE html><html><head><meta name =" + chr(34) + "viewport" + chr(34) + " content=" + chr(34) + "width=100%, initial-scale=1.0" + chr(34) + "/>" + "</head>")
				    szStrTemp		= replace(szStrTemp, "<PRE " , "<")
				    szStrTemp		= replace(szStrTemp, "</PRE>" , "")
				end if
'				20220706 HSZ END
			    szNewsData	= szNewsData & szStrTemp
		    end if
		    'ORG
		    'szNewsData	= szNewsData & szStrTemp
		    '20160803_01 LKM end
	    next
		webNews.loaddata = szNewsData
	'20170227 NOHES START : my 뉴스 등록	
	elseif szTranID == "ohhts_news_004r" then
		Form.Toast(0, DATAMANAGER.GetDataMsgText("ohhts_news_004r" ) , 1 )
		
	'20170227 NOHES END
	
	'채권 뉴스 등록
	elseif szTranID == "ohhts_news_010r" then
'		Form.Toast(0, DATAMANAGER.GetDataMsgText(szTranID) , 0 )
		Form.Toast(0, "My 뉴스가 등록 되었습니다.", 1)
	
	End If
	
	
End Sub

'============================================================================
Sub contNews_btnZoomDown_OnClick()
	If g_nFontSize > -2 Then
		g_nFontSize = g_nFontSize - 1
		webNews.fontsize = g_nFontSize
	End If
	
End Sub

'============================================================================
Sub contNews_btnZoomUp_OnClick()
	If g_nFontSize < 2 Then
		g_nFontSize = g_nFontSize + 1
		webNews.fontsize = g_nFontSize
	End If
	
End Sub

'============================================================================
Sub contNews_imgClose_OnClick()
	Form.CloseForm()
End Sub

'20170227 NOHES START : 관련종목 선택 시 현재가 화면으로 이동
'============================================================================
Sub Grid0_OnHeaderClickUp(lRow, szCellID)	
	sCellID = "bd_code" + Right(szCellID, 1)
	sCode = Grid0.GetCellData(sCellID, 0)
	Form.CloseForm()
	Form.OpenScreen("11000" , sCode)
End Sub
'20170227 NOHES END

'20170227 NOHES START : 관심등록에 추가
'============================================================================

'20170227 NOHES END

