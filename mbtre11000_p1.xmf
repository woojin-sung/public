						<CELL cell_ly="0,3,0,3" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="미결제비용" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" caption="전일, 금일 발생한 수수료, 거래세, 롤오버이자
