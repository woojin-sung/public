						<CELL cell_ly="0,9,0,9" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="유지증거금" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,9,1,9" halign="0" caption="위탁(포지션)증거금 총액 * 60%" fontsize="-3" impidxs="" />
