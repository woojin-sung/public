						<CELL cell_ly="1,6,1,6" halign="0" caption="실정산단가 * 잔고수량 * 종목증거금률" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="기타증거금" fontsize="-2" fontstyle="01" impidxs="" />
