	<SCRIPT_INFO _len="2001" _ulen="1805" >
'============================================================================
' 01. 화 면 명 : 메뉴바로가기
' 02. 화면설명 : 메뉴바로가기
' 03. 작    성 : 2021.09.23 성우진
'============================================================================

'============================================================================
Sub Image0_OnClick()
	Form.OpenScreen("11010","")
End Sub
'============================================================================
Sub Image1_OnClick()
	Form.OpenScreen("11000","")
End Sub
'============================================================================
Sub Image3_OnClick()
	Form.OpenScreen("15000","")
End Sub
'============================================================================
Sub Image4_OnClick()
	Form.OpenScreen("12000","")
End Sub
'============================================================================
Sub Image5_OnClick()
	Form.OpenScreen("63010","")
End Sub
'============================================================================
Sub Image6_OnClick()
'	Form.OpenScreen("61000","")
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Dim sText
		sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"	
		Form.MsgBox( "알림", sText, "LOGOUT_MSG", 1 )
	else
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup("mbbdm85100" , "" , "")
	end if	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			'로그아웃실행
			'(1param(0:문구없음,1문구있음), 
			'2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
			Form.LogOut(0, 1) 		
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100" , "" , "")
		end if
	end if
End Sub

