'===========================================================================
' 01. 업무구분 : 해외주식현재가_기업정보
' 02. 화면 : 
' 03. 화면설명 : 
' 04. 작성자 : 이재원
' 05. 작성일 : 2017.10.10
' 06. 수정이력 :
'===========================================================================
Dim g_sCode
Dim g_sExid
Dim g_sNat
Dim g_sMarket
Dim g_rtChk
Dim g_sEtfType

Dim g_sEtfSubTab 
g_sEtfSubTab = ""

Dim g_szOsType
g_szOsType = ""
'============================================================================
Sub Form_OnFormInit()
	WebView0.viewtype = "0"
	g_szOsType = Form.GetSharedData("&OS_TYPE", false )
end Sub

'============================================================================
'[[ 트리거 이벤트 ]]
Sub Form_OnTriggerEvent(sEventName, sParam)
	if (sEventName == "RequestData") then
		g_sCode = sParam
		g_sNat = Form.GetItemCodeInfo(sParam, "ovsnation") '국가 구분코드
		g_sExid = Form.GetItemCodeInfo(sParam, "exchcode3") 'URL 거래소 코드
		g_sMarket = Form.GetItemCodeInfo(sParam , "exchid") ' 거래소 ID
		g_sEtfType = Form.GetItemCodeInfo(sParam , "etftype") 'ETF Type 0 : ETF 아님 / 1: ETF 
		
		if g_szOsType == "1" then
			WebView0.height = 423
		else
			WebView0.height = 523
		end if
		
		Dim tmp
		tmp = {}
		tmp = (Split(sParam, "@"))
		
		if (sParam <> "") then		
			Dim sUrlPath  
			
'			if g_sEtfSubTab = "" then
'				if g_sEtfType == "1" then	
'					sUrlPath = "http://dev_globalmonitor.einfomax.co.kr/meritz_mobile_index.html#/"..tmp[1]
'				else
'					' 거래소 구분코드로 변환하여 분기 
'					if (g_sExid == "TSE" or g_sExid == "OSE") then
'					'if (g_sNat == "JPY") then
'						sUrlPath = "http://realtimeweb.einfomax.co.kr/financial_mobile.html#/main/MZS/"..tmp[1].."/"..g_sExid
'					else
'						sUrlPath = "https://globalmonitor.einfomax.co.kr/meritz_mobile_index.html#/"..g_sExid..":"..tmp[1]
'					end if	
'				end if 
'			else
'				
'				if g_sEtfType == "1" then	
'					sUrlPath = "http://dev_globalmonitor.einfomax.co.kr/meritz_mobile_index.html#/"..g_sExid..":"..tmp[1].."/5"
'				else
'					' 거래소 구분코드로 변환하여 분기 
'					if (g_sExid == "TSE" or g_sExid == "OSE") then
'					'if (g_sNat == "JPY") then
'						sUrlPath = "http://realtimeweb.einfomax.co.kr/financial_mobile.html#/main/MZS/"..tmp[1].."/"..g_sExid.."/tab4"
'					else
'						sUrlPath = "https://globalmonitor.einfomax.co.kr/meritz_mobile_index.html#/"..g_sExid..":"..tmp[1].."/3"
'					end if	
'				end if 
'				
'			end if
			
			if (g_sExid == "TSE" or g_sExid == "OSE") then
			'if (g_sNat == "JPY") then
				sUrlPath = "http://realtimeweb.einfomax.co.kr/financial_mobile.html#/main/MZS/"..tmp[1].."/"..g_sExid.."/tab4"
			else
				sUrlPath = "https://gmm.einfomax.co.kr/mobile/MERITZ/ca/" & g_sExid & ":" & tmp[1] & "/01"
			end if	
			
			WebView0.urlpath = "https://gmm.einfomax.co.kr"
			WebView0.urlpath = sUrlPath
			
			DATAMANAGER.CancelRealData("ohhts_exst_cntg")
			DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		end if
		
	elseif sEventName = "ETF_SUB_TAB" then
		g_sEtfSubTab = sParam
	elseif sEventName == "CONTMAIN_SCROLLING" then
		WebView0.height = 523
	elseif sEventName == "CONTMAIN_SCROLL_POS" then
		if g_szOsType == "1" then
			WebView0.height = 423 + Cint(sParam)
		end if
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	Dim sExid , sCode , sTemp
	sTemp = split(g_sCode, "@")
	sExid = sTemp[0] '시장구분
	sCode = sTemp[1] '종목코드 
	g_rtChk = Form.GetSharedData( "REALTIME_"..sExid, false )
	
	if szTranID == "ohhts_6000_001r" then		
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sExid )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCode)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk)
		
	end if
end Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_001r" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_sCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	end if
end Sub


