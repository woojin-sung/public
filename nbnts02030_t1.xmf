'============================================================================
' 2019.05.15 : 이현우 : 일본시장 추가
' 2020.12.01 : 이현우 : v001 : 유럽시장 추가
' 2024.03.20 : 장시방 : v002 : 스위스 시장코드, 해외거래소코드 추가
'============================================================================
Dim g_szData
Dim g_szItemCode
Dim g_szNewData
Dim g_szNewOrderData
Dim g_szQty
Dim g_NextCnt

Dim g_szFundCd
g_szFundCd = "", ""
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName = "REQUEST" THEN
		if sParam <> null then
			g_szFncd = sParam
			Request_Data()
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "obtro_oder_303r" then
		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.ClearInputData(0, "obtro_oder_303r")
		DATAMANAGER.SetDataValue( false, "obtro_oder_303r", "InBlock1", "IQRY_CLS_CODE"			, 0 , "0")
		DATAMANAGER.SetDataValue( false, "obtro_oder_303r", "InBlock1", "FNCD"					, 0 , g_szFncd) 
		DATAMANAGER.SetDataValue( false, "obtro_oder_303r", "InBlock1", "PROD_PSTN_CLS_CODE"		, 0 , "1" )
	end if
End Sub


'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	For iCnt = grdList.rowcount - 1 To 0 Step -1
		szType 	= grdList.GetCellData("bd_cell7" , iCnt)
		szVndr 	= grdList.GetCellData("bd_cell17" , iCnt)

		' 시장구분
		if szType = "01" then
			grdList.SetCellData("bd_cell16", iCnt, "미국")
		elseif szType = "02" then
			grdList.SetCellData("bd_cell16", iCnt, "홍콩")
		elseif szType = "03" then
			grdList.SetCellData("bd_cell16", iCnt, "중국")
		elseif szType = "04" then
			grdList.SetCellData("bd_cell16", iCnt, "중국")
		elseif szType = "05" then
			grdList.SetCellData("bd_cell16", iCnt, "일본")
		elseif szType = "06" then
			grdList.SetCellData("bd_cell16", iCnt, "호주")
		elseif szType = "07" then
			grdList.SetCellData("bd_cell16", iCnt, "싱가포르")
		elseif szType = "08" then '2020.11.05 유로국가 추가
			grdList.SetCellData("bd_cell16", iCnt, "영국")			
		elseif szType = "09" then
			grdList.SetCellData("bd_cell16", iCnt, "영국")			
		elseif szType = "10" then
			grdList.SetCellData("bd_cell16", iCnt, "독일")			
		elseif szType = "11" then
			grdList.SetCellData("bd_cell16", iCnt, "핀란드")
		elseif szType = "12" then
			grdList.SetCellData("bd_cell16", iCnt, "프랑스")			
		elseif szType = "13" then
			grdList.SetCellData("bd_cell16", iCnt, "벨기에")			
		elseif szType = "14" then
			grdList.SetCellData("bd_cell16", iCnt, "네덜란드")
		elseif szType = "15" then
			grdList.SetCellData("bd_cell16", iCnt, "포르투갈")
		elseif szType = "16" then
			grdList.SetCellData("bd_cell16", iCnt, "그리스")
		elseif szType = "17" then
			grdList.SetCellData("bd_cell16", iCnt, "아일랜드")
		elseif szType = "18" then
			grdList.SetCellData("bd_cell16", iCnt, "이탈리아")
		elseif szType = "19" then
			grdList.SetCellData("bd_cell16", iCnt, "스페인")			
		elseif szType = "20" then
			grdList.SetCellData("bd_cell16", iCnt, "오스트리아")			
		elseif szType = "21" then
			grdList.SetCellData("bd_cell16", iCnt, "캐나다")
		elseif szType = "23" then
			grdList.SetCellData("bd_cell16", iCnt, "인도네시아")
		elseif szType = "24" then
			grdList.SetCellData("bd_cell16", iCnt, "베트남")
		elseif szType = "25" then
			grdList.SetCellData("bd_cell16", iCnt, "베트남")
		elseif szType = "26" then
			grdList.SetCellData("bd_cell16", iCnt, "스위스") 'v002
		end if
		
		szVndrStr = Transform_Exid(szVndr, szType)
		grdList.SetCellData("bd_cell6", iCnt, szVndrStr)
		
		'평가손익률
		rate = grdList.GetCellData("bd_cell13" , iCnt)
		
		if rate <> null or rate <> "" then
			if tonumber(rate) > 1 then
				grdList.SetCellFgColor("bd_cell13", iCnt, "1")
		     elseif tonumber(rate) < 1 Then
				grdList.SetCellFgColor("bd_cell13", iCnt, "2")
			end if
		end if
		
	Next
End Function

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	DATAMANAGER.RequestTranData("obtro_oder_303r")
End Function

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obtro_oder_303r" Then
		SetGridData()
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	
	g_szItemCode = grdList.GetCellData("Iscd", lRow)
	if Trim(g_szItemCode) == "" then
		Exit Sub
	end if
	
	listLocation =  Split(grdList.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	szItemCode = grdList.GetCellData("Iscd", lRow)
	szItemName = grdList.GetCellData("bd_cell11", lRow)
	szQty      = grdList.GetCellData("bd_cell12" , lRow)
	szCutIscd  = Mid(szItemCode, 1, Len(szItemCode)-3)	
	szTranExch = Transform_Exid2(right(szItemCode, 2))	
	
	' 온라인 거래소가 아닌경우
	if szTranExch = nil Then
		Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		Exit Sub
	end if

	
	if len(szCutIscd) < 0 or len(szTranExch) < 0 then
		msgbox "필수 데이터 값이 존재하지 않습니다." & "@" & szCutIscd & "@" & szTranExch
	end if
	
	'거래소영문@종목코드★종목명	
	g_szNewData = szTranExch & "@" & szCutIscd & "★" & szItemName

	'신용거래용도 -> 고유 미사용
	szLoanDate = ""
	szLoanCd   = "0000"
	szLoanSr   = "00000000000"
	
	sPopupType = "2"
	
	g_szData = szItemCode & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	g_szNewBuyData = szTranExch & "@" & szCutIscd & "★" & szItemName & "♥" & "0" & "♥"& szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	g_szNewSelData = szTranExch & "@" & szCutIscd & "★" & szItemName & "♥" & "1" & "♥"& szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")

End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "MOVEPOP_RETURN" then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("16000" , g_szNewData)
		elseif szListItems(1)	=	"1"	then
			Form.OpenScreen("02000" , g_szNewBuyData)
		elseif szListItems(1)	=	"2"	then
			Form.OpenScreen("02000" , g_szNewSelData)
		end if
	end if
End Sub
'============================================================================
Sub grdList_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtro_oder_303r" )
End Sub
'============================================================================
' 거래소코드 -> 거래소벤더코드 변환
'============================================================================
Function Transform_Exid(sValue, szType)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "HS0529I" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		return "상해"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "심천"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "XSTC" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "HSTC" then ' 베트남 하노이
		return "하노이"
	elseif sValue == "0627" then ' 영국GBP
		return "런던"
	elseif sValue == "XLON" then ' 영국USD
		return "런던인터네셔널"
	elseif sValue == "0762" then ' 독일
		return "독일"
	elseif sValue == "XHEL" then ' 핀란드
		return "핀란드"
	elseif sValue == "0787" then ' 프랑스/벨기에/네덜란드/포르투갈
		    if szType == "12" Then '프랑스
			return "프랑스"
		elseif szType == "13" Then '벨기에
			return "벨기에"
		elseif szType == "14" Then '네덜란드
			return "네덜란드"
		elseif szType == "15" Then '포르투갈
			return "포르투갈"
		end if
	elseif sValue == "ASEX" then ' 그리스
		return "그리스"
	elseif sValue == "XDUB" then ' 아일랜드
		return "아일랜드"
	elseif sValue == "XMIL" then ' 이탈리아
		return "이탈리아"
	elseif sValue == "0216" then ' 스페인
		return "스페인"
	elseif sValue == "XWBO" then ' 오스트리아
		return "오스트리아"
'20201218 SWJ START : 오프라인 주문 거래국가 추가
	elseif sValue == "0372" then '캐나다
	      return "토론토"
     elseif sValue == "0556" then '인도네시아
	      return "인도네시아"
     elseif sValue == "0728" then '호주
	      return "호주"
     elseif sValue == "0713" then '싱가포르
	      return "싱가포르"
	elseif sValue == "0000" then
		if szType == "01" or szType == "02" then '미국 OTC, 홍콩 OTC
			return "OTC"
		end if
'20201218 SWJ END
     elseif sValue == "XSWX" then 'v002 스위스
	      return "스위스"
	end if
end Function
'============================================================================
Function Transform_Exid2(sValue)

	
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
		exit Function
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
		exit Function
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
		exit Function
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
		exit Function
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
		exit Function
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
		exit Function
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
		exit Function		
	end if
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID == "obtro_oder_303r" then
		'데이터 없음
		if szErrCode = "5820" then
			grdList.SetClear()
		end if
	end if
End Sub
'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)

		if szCha > CInt(sDecimal) then
			sztemp = Round(sztemp, CInt(sDecimal))
		end if
		
		szCha = CInt(Len(sztemp) - szChk)
		
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function
