	<SCRIPT_INFO _len="17919" _ulen="16073" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 본인계좌 인증(1/2)
' 02. 화면설명 : 본인계좌 인증(1/2)
' 03. 작    성 : 2021.01.11 김유경
' 04. 수    정 : 
' 2021.06.09 : 정민영 : v0001 : T2102250017 : CFD차액결제시스템 구축
'            :        : obaci_acct_049c 변경IO 적용
' 2021.07.21 : 정민영 : v0002 : 비대면CFD개설 목표시장비교에 따른 obaci_acct_049c 변경IO 적용
' 2021.10.26 : 김수진 : v0003 : 비대면중개형ISA/ 해외CFD 상품추가에 따른 obaci_acct_049c 변경IO 적용
' 2022.02.21 : 김수진 : v0004 : 국내/해외 CFD 계좌개설시_국가/계좌 유형 일괄개설 추가 > obaci_acct_049c 변경IO 적용
' 2022.05.04 : 김수진 : v0005 : 계약서류 제공방식 추가 > obaci_acct_049c 변경IO 적용
' 2022.08.12 : 전상일 : v0006 : 바이오인증 송수신 분리
' 2022.12.08 : 강희승 : v0007 : 비대면 본인계좌인증 화면 개선 요청의 건		'v0007
'-------------------------------------------------------------------------------------------
'****************************************************************************
' 다음 화면 참고
'mbbdm10071	계좌개설-본인계좌 인증(2/2)
'mbbdm10072	업무신청-본인계좌 인증(2/2)
'****************************************************************************

Dim UpSize '컨트롤 입력 완료시 움직이는 데이터
    UpSize = 100

Dim sNmetBswrGb '비대면업무구분 (100.비대면계좌개설 000.비대면업무신청)
Dim gPageID			'화면의 단계 구분
Dim gRegUniqNo		'등록고유번호
Dim gClearYN
Dim gBackYN
Dim gBackBankCode
Dim gBackBankName
Dim gBackBankAcno

Dim gBankCode
Dim gBankName
Dim gRCNO

Dim gRcvnIqryNo
Dim gNmetBswrAClcd
Dim gMnrcBankCode
Dim gBankAcno
Dim gBankUseAcno
Dim gAchoName
Dim gRegSrno

'obtss_arss_101r
Dim sName
Dim sCODE
Dim sCNTT

'obtss_opnf_101a
Dim gOpnOtsdTrUniqNo
Dim gRcvnDate

Dim g_sz_HPNo
Dim closeFlag
closeFlag = 0 

Dim g_OsType

Dim szTheme


'v0006
Dim g_BIORetry
Dim g_BIOTrName
DIM DEF_1ST_TIME
DIM DEF_2ST_TIME

DEF_1ST_TIME = 0.5
DEF_2ST_TIME = 1.0

Dim g_szOSType
Dim gRcvnDate
'============================================================================

'============================================================================
Sub Form_OnFormInit()
	gRcvnDate  = Form.GetSharedData("&HOST_DATE", false )
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	szTheme  = Form.GetEnvData("common.theme")
	
	if g_OsType == "1" then
		g_szOSType =  "112"			'안드로이드
	else
		g_szOSType = "111"			'IOS
	end if
	
	'2021.04.07. 김유경 추가
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	'JMY 안내문구 설정(1개의 Label로 통합)
	ContMain.Label5.caption = "고객님 명의의 금융기관 본인계좌로 인증합니다.\n인증번호 3자리가 포함된 입금자명으로 1원을 보내드립니다."
	
	'**************
	' 컨트롤 셋팅
	'**************		
	ContMain.Label5.fgcolor = 269
	'ContMain.Label4.fgcolor = 269
	'ContMain.Label6.fgcolor = 269
	
	'다음버튼 비활성화
	BtnNext.enable  = False
	If szTheme == "black" Then
		BtnNext.btnimage = "btn_27.9" '"btn_21.9"
	Else
		BtnNext.btnimage = "btn_21.9"
	End If 
	BtnNext.fgcolor = "269"
     
     ContMain.Edit0.hintcaption = "숫자만 입력해주세요." '2021.05.01. 김유경. 개선사항 추가 (컨트롤에서 스크립트로 변경)
	ContMain.Edit1.setApplyLabel   ("금융기관" ,0 , 268 , "left" , false)
	ContMain.Edit0.setApplyLabel   ("계좌번호" ,0 , 268 , "left" , false)
			
	'테스트용 인증스킵 체크
    nDev = Form.GetSharedData("&SERVER_MODE", False )
    
    If nDev == "1" Or nDev == 1 Then
        chkSkip.visible = True
        'chkSkip.checkstate = "1"  '자동체크 해제
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If
    
	'**************
	' 데이터 셋팅
	'**************
	gPageID	= "4" '단계
	sNmetBswrGb = Form.GetSharedData("BDM_NMETBSWRGB", false )  '100.비대면계좌개설 000.비대면업무신청 300.모바일OTP발급
	gRCNO       = Form.GetSharedData("BDM_RCNO_PIP"  , false ) '주민등록번호
	gBackYN	   = Form.GetSharedData("BDM_BACK_YN"   , true  ) 'Y: 본인계좌인증(2/2) 에서 넘어옴
	gRegUniqNo  = Form.GetSharedData("BDM_REG_UNIQ_NO"	 , false ) '등록고유번호
	
	If sNmetBswrGb == "100" Then
		ImgF.visible = True
	Else
		ImgF.visible = False
	End If
		
	'20210216 HWG
	ContMain.Button0.bringFront("0")
	
	g_sz_HPNo = Form.GetSharedData("&PHONE_NUMBER"  , false )	'기기정보에서 읽어온 휴대폰번호(P로 시작하면 핸드폰번호, R로 시작하면 단말ID)
	
	DATAMANAGER.ClearInputData(0, "obtss_arss_101r")
	DATAMANAGER.ClearInputData(0, "obaci_acct_049c")
	DATAMANAGER.ClearInputData(0, "obtss_opnf_101a")
	DATAMANAGER.ClearInputData(0, "obaci_nmet_013a")
End Sub

'============================================================================
Sub ContMain_Button0_OnClick()
	Form.OpenPopupAnimation("mbbdm85170_p1" , "pass"  ,"","2")
	ContMain.Edit0.caption = ""
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbbdm85170_p1" Then
		'ContMain.LabStnd.top = Cint(ContMain.LabStnd.top + UpSize)
		ContMain.LabStnd.top = 548 + UpSize
		ContMain.SetScrollAutoSize()
		
		'ContMain.scroll_pos     = Cint(ContMain.Edit0.top - UpSize)
		ContMain.scroll_pos     = 120 '312 - UpSize
		ContMain.Edit0.visible  = true
						
		gBankName = Form.GetSharedData("BANK_NAME", false )
		gBankCode = Form.GetSharedData("BANK_CODE", false )
		
		ContMain.Edit1.caption  = gBankName
		ContMain.Label3.caption = gBankCode
		
		'2021.04.05. 은행코드가 287(메리츠)인 경우 안내문구 미조회
		If Trim(gBankCode) <> "287" and Trim(sNmetBswrGb) == "100" Then 
			ContMain.Label0.visible = true
			ContMain.Label1.visible = true
			ContMain.Image1.visible = true		
			ContMain.Edit0.hintcaption = "숫자만 입력해주세요." '2021.05.01. 김유경. 개선사항 추가
		Else
			ContMain.Label0.visible = False
			ContMain.Label1.visible = False
			ContMain.Image1.visible = False
			If Trim(gBankCode) == "287" Then
				ContMain.Edit0.hintcaption = "숫자만 입력해주세요.(10자리)" '2021.05.01. 김유경. 개선사항 추가
			Else
				ContMain.Edit0.hintcaption = "숫자만 입력해주세요." '2021.05.01. 김유경. 개선사항 추가
			End If
		End If
	
		'ContMain_Edit1_OnEditComplete()  'JMY 다음포커싱위해 이벤트호출
		'ContMain.Edit0.SetShowKeypad(True) '2021.03.30.
		Form.SetTimerEvent2("2", 1, 0.5)    '2021.03.30.
	ElseIf sKeyName = "mbbdm85100_p9_end" or sKeyName = "mbbdm85200_p9_end" Then
	
		If sRet == "ok" Then
			'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
			closeFlag = "2"
			Form.CloseForm()
			'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
		End If 
	
	End If
End Sub
'============================================================================
Sub ContMain_Edit0_OnEditComplete()
	ContMain.scroll_pos = 0
	'BtnNext.bgcolor = 265
	'BtnNext.fgcolor = 0
	BtnNext.enable  = True
	BtnNext.btnimage = "btn_20.9"
	BtnNext.fgcolor = "273"
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'처리중인 휴대폰정보로 USerID설정
	'DATAMANAGER.SetUserID("meritz")
	
	If szTranID = "obtss_arss_101r"  Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "OPNG_RPRS_ISTU_CODE" , 0 , gBankCode    		  )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "TR_ACNO" 			 , 0 , ContMain.Edit0.caption)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "RCNO_PIP"			 , 0 , gRCNO                 )	
		
	ElseIf szTranID = "obaci_acct_049c" Then
		'공통
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 		, 0 , gRegUniqNo			   )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 	, 0 , gPageID			       )
		
		'4.추가인증(1원역이체정보등록)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock6",  "PROS_CLS_CODE"	 	, 0 , "1"				   ) '1원역이체 타행계좌정보 INSERT
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock6",  "MNRC_BANK_CODE" 	, 0 , gBankCode		       )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock6",  "MNRC_BANK_ACNO" 	, 0 , ContMain.Edit0.caption  )
	ElseIf szTranId = "obtss_opnf_101a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "RCVN_DATE"			 , 0 , gRcvnDate              )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "RCVN_IQRY_NO"		 , 0 , gRcvnIqryNo            )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "NMET_BSWR_CLCD"		 , 0 , sNmetBswrGb            )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "MNRC_BANK_CODE"		 , 0 , gBankCode              )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "BANK_ACNO"			 , 0 , ContMain.Edit0.caption )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "ACHO_NAME"			 , 0 , sName                  )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO"		 , 0 , gRegUniqNo             )
		'v0007 start
		Form.SetSharedData("RCVN_DATE" , gRcvnDate)
		Form.SetSharedData("RCVN_IQRY_NO" , gRcvnIqryNo)
		Form.SetSharedData("ACHO_NAME" , sName)
		'v0007 start
	ElseIf szTranId = "obaci_nmet_013a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 		 , 0 , gRegUniqNo		       )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "MNRC_BANK_CODE"		 , 0 , gBankCode		       )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "BANK_USE_ACNO" 		 , 0 , ContMain.Edit0.caption )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	ShowAlert "안내", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
	If szTranID == "obtss_arss_101r" then
		Form.SetTimerEvent("1", 0, 50)
	ElseIf szTranID == "obtss_arss_102r" Then	
		Form.SetTimerEvent(4, 0, DEF_2ST_TIME)
	end if
	
	Exit Sub
End Sub 

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtss_arss_101r" Then
		'테스트인증 스킵 처리
		If chkSkip.checkstate == "1" or chkSkip.checkstate == 1 Then
			If sNmetBswrGb = "100" Then '100.비대면계좌개설
				DATAMANAGER.RequestTranData("obaci_acct_049c")
			Else
				DATAMANAGER.RequestTranData("obaci_nmet_013a")
			End If 
			
			Exit Sub
		End If 
		
		'Form.SetTimerEvent("1", 0, 50)
		'v0006 jsi start
		'당사는 전문을 통하지 않음.. 102r 태울 필요 x
		If gBankCode <> "287" Then 
			g_BIOTrName	= szTranID
			g_BIORetry	= 0
			
			gRcvnIqryNo = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
			'Form.ShowAlert("알림", "gRcvnIqryNo::: " & gRcvnIqryNo)
			
			Form.SetTimerEvent2(3,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		else 
			'gRcvnDate   = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_DATE"    , 0)
			gRcvnIqryNo = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
			sCODE       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 	, 0)
			sName       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACHO_NAME" 	, 0)
			'당사 조회 
			If CLng(sCODE) == 0 Then			
				If sNmetBswrGb = "100" Then '100.비대면계좌개설
					DATAMANAGER.RequestTranData("obaci_acct_049c")
				Else
					DATAMANAGER.RequestTranData("obaci_nmet_013a")
				End If 
			End If
		end if 
		'v0006 jsi end
	'v0006 jsi start
	ElseIf szTranID == "obtss_arss_102r" Then	
		sName       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACHO_NAME" 	, 0)
		sCODE       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 	, 0)
		sCNTT       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		
		'송수신 분리 후 수신 에러나는 경우를 위해 거래일자 / 조회번호 101r에서 세팅해준다
		'gRcvnDate   = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_DATE"    , 0)		
		'gRcvnIqryNo = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCVN_IQRY_NO" , 0)
		If gRcvnDate == "" then
			gRcvnDate = g_TR_DATE
		end if
		
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		if sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry = g_BIORetry + 1
			if g_BIORetry >= 3 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry = 0 '초기화
				Exit Sub
				
			end if 
			
			Form.SetTimerEvent(4,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			
			exit sub
		end if
		
		If CLng(sCODE) == 0 Then			
		
			If sNmetBswrGb = "100" Then '100.비대면계좌개설
				DATAMANAGER.RequestTranData("obaci_acct_049c")
			Else
				DATAMANAGER.RequestTranData("obaci_nmet_013a")
			End If 
			
'		Else
'			ShowAlert "알림", "송금하실 출금기관 및 계좌번호를 다시 확인해주시기 바랍니다."
		End If
	'v0006 jsi end	
	ElseIf szTranID = "obaci_acct_049c" Then
		'2021.04.07 skip 처리 추가 (chkSkip.checkstate = 1 인경우 1원 역이체 전송 안함)
		If chkSkip.checkstate == "1" or chkSkip.checkstate == 1 Then
			closeFlag = "1"
			If sNmetBswrGb == "100" Then
				Form.OpenNextPopup("mbbdm85171" , "" , "")
			Else
				Form.OpenNextPopup("mbbdm85172" , "" , "")
			End If 
		Else 
			DATAMANAGER.RequestTranData("obtss_opnf_101a")
		End If 
	ElseIf szTranID = "obaci_nmet_013a" Then
		'DATAMANAGER.RequestTranData("obtss_opnf_101a")
		
		'2021.04.07 skip 처리 추가 (chkSkip.checkstate = 1 인경우 1원 역이체 전송 안함)
		If chkSkip.checkstate == "1" or chkSkip.checkstate == 1 Then
			closeFlag = "1"
			If sNmetBswrGb == "100" Then
				Form.OpenNextPopup("mbbdm85171" , "" , "")
			Else
				Form.OpenNextPopup("mbbdm85172" , "" , "")
			End If 
		Else 
			DATAMANAGER.RequestTranData("obtss_opnf_101a")
		End If 
		
	ElseIf szTranID = "obtss_opnf_101a" Then
		Dim gNrmlYn
		
		gOpnOtsdTrUniqNo  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OPN_OTSD_TR_UNIQ_NO" 	, 0)
		gNrmlYn           = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "NRML_YN" 	         , 0)
				
		'2021.04.07. 1원 역이체 정상여부(gNrmlYn)  확인 추가
		If gNrmlYn == "Y" Then 
			Form.SetSharedData("BDM_OTSD_TR_UNIQ_NO" ,gOpnOtsdTrUniqNo )
			
			'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
			closeFlag = "1"
			If sNmetBswrGb == "100" Then
				Form.OpenNextPopup("mbbdm85171" , "" , "")
			Else
				Form.OpenNextPopup("mbbdm85172" , "" , "")
			End If 	
			'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
		End If 
	End If
End Sub 

'============================================================================
Sub BtnNext_OnClick()

	Form.SetSharedData("BDM_BANKCODE" , gBankCode			  )
	Form.SetSharedData("BDM_BANKACNO" , ContMain.Edit0.caption )
	Form.SetSharedData("BDM_BANKNAME" , ContMain.Edit1.caption )

	DATAMANAGER.RequestTranData("obtss_arss_101r")
	'Form.SetTimerEvent("1", 1, 50)	
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If TRIM(sTimerID) == "1" Then
		Form.ShowAlert("오류", "통신상태가 원활하지 않습니다.\n잠시 후 다시 처리해 주세요.")
		Form.SetTimerEvent("1", 0, 50)
		Exit Sub
	ElseIf TRIM(sTimerID) == "2" Then
		Form.SetTimerEvent2("2", 0, 0.5)
		ContMain.Edit0.SetShowKeypad(True) '2021.03.30.
	'v0006 jsi start
	'SetTimerEvent2 :: 1초 미만 / SetTimerEvent :: 1초 이상
	ElseIf sTimerID == "3" or sTimerID == 3 Then
	
		Form.SetTimerEvent2(sTimerID, 0, DEF_1ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RCVN_IQRY_NO"	, 0,  gRcvnIqryNo)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r")
		
	ElseIf sTimerID == "4" or sTimerID == 4 Then
		Form.SetTimerEvent(sTimerID, 0, DEF_2ST_TIME)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RCVN_IQRY_NO"	, 0,  gRcvnIqryNo)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.SetDataValue(0, "obtss_arss_102r", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0,  g_szOSType)
		DATAMANAGER.RequestTranData("obtss_arss_102r")
		
	'v0006 jsi end
	End If
	
End Sub 


'============================================================================
Sub Image0_OnClick()
	
	If sNmetBswrGb == "100" Then
		Form.OpenPopup("mbbdm85100_p9" , "" , "")
	Else
		Form.OpenPopup("mbbdm85200_p9" , "100" , "5")
	End If
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	'2021.04.07. 김유경 추가
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
	If closeFlag == "2" Then
		Form.OpenScreen( "41000" , "")
	End If
End Sub


'============================================================================
Sub ContMain_Edit1_OnEditComplete()
	'JMY 계좌번호에 포커싱
	If ContMain.Edit1.caption ~= "" Or ContMain.Edit1.caption ~= null Then
		ContMain.Edit0.SetShowKeypad(true)
	End If
End Sub
'============================================================================
'2021.04.07. 백버튼 불가 추가
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    Call Image0_OnClick()
End Sub

