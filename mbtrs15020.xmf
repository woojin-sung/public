		<ACCOUNT name="acnt0" itemcodetype="100,102,105,107,108,112,131,132,138,139,140,200" delegate="1" finaceexcept="1" benefitexcept="1" ly_vert="10,9,310,39,1" />
		<FORMTAB name="fmtab0" tabcount="3" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="0,54,375,509,1" >
			<PAGE name="page008561" caption="기간별" linkfile="mbtrs15020_t1" loadingtype="1" />
			<PAGE name="page004795" caption="종목별" linkfile="mbtrs15020_t2" loadingtype="1" />
			<PAGE name="page008634" caption="일별수익률" linkfile="mbtrs15020_t3" loadingtype="1" />
		</FORMTAB>
		<BUTTON name="btnSearch" btnimage="btn_refresh.9" ly_vert="326,9,39,39,1" />
