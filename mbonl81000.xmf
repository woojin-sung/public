'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객연락처변경
' 02. 화면설명 : 고객연락처변경
' 03. 작    성 : 2016.01.25 김보라
' 04. 수    정 : 2016.06.22 김유경 : 법인은 온라인에서 연락처 등록/변경/삭제
'								못하도록 수정 (영업지원팀/박정숙) v0001
'			   2019.03.22 성주혁 : HTS ID 생성단계 별도 로직(ACNO 처리 및 보안매채 안타도록 수정) v0002
' 2020.09.18 : 정민영 : v0004 : [T2008250015] 메모리취약점 보완
' 2023.08.21 : 전상일 : v0005 : 모바일우선통보 오류 수정
' 2023.11.29 : 장원혁 : v0006 : 외화이체 화면에서 오픈 시 신규연락처 return
'-------------------------------------------------------------------------------------------
'============================================================================
'전화번호프로세스
'자택/직장/FAX 등록and변경 -> 전화번호입력창 -> 추가인증 -> 보안매체 -> 공인인증비밀번호
'휴대폰 		 등록and변경 -> 전화번호입력창 -> 본인인증(본인명의)or추가인증(타인명의) -> 보안매체 -> 공인인증비밀번호 
'자택/직장/휴대폰/FAX 삭제 -> 추가인증 -> 보안매체 -> 공인인증비밀번호

'주소프로세스
'자택/직장/기타 등록and변경 -> 주소입력창 -> 보안매체 -> 공인인증비밀번호
'e-mail		  등록and변경 -> 이메일입력창 -> 보안매체 -> 공인인증비밀번호
'자택/직장/기타/e-mail 삭제 -> 보안매체 -> 공인인증비밀번호
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'계좌컨트롤
'종합계좌스타일
'100종합매매 ~ 127비과세종합저축까지
Dim g_sAcc '계좌번호
Dim g_sRetData '고객연락처변경리턴데이터
Dim g_sTyp '등록/변경/삭제종류구분값
Dim g_sProcessTyp '전화종류/주소종류구분값
Dim g_sCSNO '고객번호
Dim g_sCustTypCd '고객유형코드
Dim g_sGubunCode '보안매체구분코드
Dim g_sScreenNo '고객연락처변경[81000], 신용계좌개설[82010]
Dim G_PHONE_INPUT_FILE '전화번호입력창풀팝업
Dim G_PHONE_CONFIRM_FILE '휴대폰본인인증풀팝업
Dim G_ADDRESS_INPUT_FILE '우편번호검색풀팝업
Dim G_EMAIL_INPUT_FILE '이메일입력풀팝업
Dim G_CERT_ADD_FILE '추가인증풀팝업
Dim G_CERT_SECURITY_FILE '보안카드풀팝업
Dim G_CERT_QUESTION_FILE '부가정보풀팝업
Dim G_CERT_OTP_FILE '일반/스마트OTP풀팝업
Dim G_CERT_mOTP_FILE '모바일OTP풀팝업
Dim G_CERT_PW_FILE '공인인증서비밀번호입력풀팝업

Dim ARCD, TONO, TELNO, TENO
Dim szDateCount

Dim g_sSendData '은행개설계좌 HTS ID 생성시 ACNO 전달 v0002

'v0001
Dim g_sCustClsCd '고객구분코드
Dim g_stmp_tmp   '은행개설계좌 ID 등록 - 연락처 변경시 인자
Dim g_plain_rm   'v0004 메모리평문적용여부

Dim g_newTelno 'v0006

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	if EditPW.caption == null or EditPW.caption == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
	if g_sGubunCode == "0" then '보안카드
		Form.OpenFramePopup( G_CERT_SECURITY_FILE , "" , "" )
	elseif g_sGubunCode == "1" then '부가정보
		Form.OpenFramePopup( G_CERT_QUESTION_FILE , "" , "" )
	elseif g_sGubunCode == "3" then 'OTP
		Form.OpenFramePopup( G_CERT_OTP_FILE , "" , "" )
	elseif g_sGubunCode == "4" then 'mOTP
		Form.OpenPopup( G_CERT_mOTP_FILE , "motp_success" , "" )
	elseif g_sGubunCode == "2" then '없을경우
		'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
		RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
	else '에러
		Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
	end if
End Function

