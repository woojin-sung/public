'===========================================================================
' 조회함수
'===========================================================================
Function SetRequestData()
	if EditPW.caption ~= null and EditPW.caption ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '보안매체조회
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '고객연락처조회
	end if
End Function

'===========================================================================
' 삭제 전화번호 Input 세팅
'===========================================================================
Function SetTel(szYype)
	Dim TelType, IndexNum
	
	Select Case szYype
		Case "page0_Home"
			TelType = "11"
		Case "page0_Office"
			TelType = "12"
		Case "page0_Phone"
			TelType = "13"
		Case "page0_Fax"
			TelType = "14"
	End Select
	
	for i = 0 to szDateCount
		if grd0.GetCellData( "bd_cell0", i) == TelType then
			IndexNum = i
			Exit for
		end if
	next
	
	DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "ARCD" , 0 , grd0.GetCellData( "bd_cell1", IndexNum) )
	DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "TONO" , 0 , grd0.GetCellData( "bd_cell2", IndexNum) )
	DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "TELNO" , 0 , grd0.GetCellData( "bd_cell3", IndexNum) )
	if grd0.GetCellData( "bd_cell4", i) ~= null and grd0.GetCellData( "bd_cell4", i) ~= "" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "TENO" , 0 , grd0.GetCellData( "bd_cell4", IndexNum) )
	end if
		
End Function
'===========================================================================
' 고객구분코드 체크함수 v0001
'===========================================================================
Function CustClsCdCkeck()
	if g_sCustClsCd == "2" then
		Form.MsgBox( "알림", "법인계좌는 온라인에서 연락처 등록/변경/삭제가 불가합니다.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()	

    g_newTelno = ""
	g_sRetData = "cancel"
	g_sTyp = ""
	g_sProcessTyp = ""
	g_sCSNO = ""
	g_sCustTypCd = ""
	g_sGubunCode = ""
	g_sScreenNo = Form.GetSharedData("&SCREEN_NO", false )	
	G_PHONE_INPUT_FILE 	= "mbonl81000_p1"
	G_PHONE_CONFIRM_FILE	= "mbonl81000_p2"
	G_ADDRESS_INPUT_FILE	= "mbbdm85150_p1"
	G_EMAIL_INPUT_FILE	= "mbonl81000_p5"
	G_CERT_ADD_FILE		= "mhetc90060_p8"
	G_CERT_SECURITY_FILE	= "mhetc90060_p9" 
	G_CERT_QUESTION_FILE	= "mhetc90060_pa" 
	G_CERT_OTP_FILE		= "mhetc90060_pb"
	G_CERT_mOTP_FILE	= "mhetc90060_motp"
	G_CERT_PW_FILE		= "mhetc90060_p5"
	Edit0.visible = false
	
	'v0004 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	Dim sRevData 
	sRevData = Form.GetOpenLinkData()

	if sRevData == null or sRevData == "" then
		g_sAcc = Account0.caption
	else

		Dim sTemp
		sTemp = Split(sRevData, ";")
		'v0003. 다른 화면에서 해당 화면 호출 시 sTemp[3]이 없어서 스크립트 오류.
		strlen = Form.GetByteLength( sRevData )

		'--------------------------------------------------
		'v0004 공유변수 설정시 주의
		'mbisa56060_t3		ISA가입신청				인자없음
		'mbonl82010			신용계좌개설				(평문미적용)계좌번호;평문비밀번호	(평문적용)계좌번호;암호화비밀번호;비밀번호길이
		'mbonl82020_t1		담보대출신청_약정등록		(평문미적용)계좌번호;평문비밀번호	(평문적용)계좌번호;암호화비밀번호;비밀번호길이
		'mbonl87010			잔고통보처변경			(평문미적용)계좌번호;평문비밀번호;1	(평문적용)계좌번호;암호화비밀번호;1:비밀번호길이
		'mhetc90020_cddReg	CDD 고객확인서 등록		(평문미적용)계좌번호;;1;9999		(평문적용)좌동
		'mhetc90020_pg		은행개설계좌 CDD/EDD 등록	(평문미적용)계좌번호;;1;9999		(평문적용)좌동
		'--------------------------------------------------
		If g_plain_rm == "1" Then  '메모리평문적용시,
			Dim argIdx, pwdLen

			'배열의 갯수설정(분리문자로 분리된 갯수)
			argIdx = UBOUND(sTemp)

			'비밀번호 자릿수 설정
			'가장 마지막인자가 비밀번호길이인지 체크(비밀번호길이=Lx)
			If argIdx > 1 And Left(Trim(sTemp[argIdx-1]), 1) == "L" Then
				If Len(Trim(sTemp[argIdx-1])) == 1 Then				
					pwdLen = 4  
				Else
					'넘겨준 자릿수 설정
					pwdLen = CInt(Right(Trim(sTemp[argIdx-1]), Len(Trim(sTemp[argIdx-1]))-1))
					'자릿수가 0인 경우 Default 4자리로 설정 
					If pwdLen == 0 Then
						pwdLen = 4
					End If
				End If				
			Else
				'비밀번호 자릿수 인자가 없는 경우 Default 4자리로 설정 
				pwdLen = 4
			End If			
			EditPW.pwdlen = pwdLen
			
			
			If UBOUND(sTemp) >= 3 And sTemp[3] == "9999" then
				g_stmp_tmp = sTemp[3]
				Edit0.visible = true
				g_sAcc = sTemp[0]
				
				Edit0.caption = g_sAcc
				Edit0.enable  = false
				EditPW.caption = sTemp[1]
				
				Account0.enable = false
				Account0.visible= false
				
				FormTab0.currenttab = sTemp[2]
			Else
				g_sAcc = sTemp[0]
				Account0.caption = g_sAcc
				EditPW.caption = sTemp[1]
				Account0.enable = false
				
				if (UBOUND(sTemp) == 3 and Left(Trim(sTemp[argIdx-1]), 1) ~= "L") or
				   (UBOUND(sTemp) == 4 and Left(Trim(sTemp[argIdx-1]), 1) == "L") then '잔고통보처에서 주소 탭으로			 
					
					if g_sScreenNo <> "87052" then
						g_sScreenNo = "87010" '잔고통보처에소 닫지 않게 하기 위해
					end if
					
					FormTab0.currenttab = sTemp[2]
				end if			
			End If
		
		Else
			'v0002
			if strlen <> "13" and sTemp[3] =="9999" then 'v0003. shared 값 길이 구해서 sTemp[1] 이상의 데이터가 있을 때만 해당 로직 타도록 수정
				g_stmp_tmp = sTemp[3]
				Edit0.visible = true
				g_sAcc = sTemp[0]
				
				'Label0.caption = g_sAcc
				'Label0.enable  = false
				Edit0.caption = g_sAcc
				Edit0.enable  = false
				'Account0.caption = g_sAcc
				EditPW.caption = sTemp[1]
				
				Account0.enable = false
				Account0.visible= false
				
				FormTab0.currenttab = sTemp[2]
			else
				g_sAcc = sTemp[0]
				Account0.caption = g_sAcc
				EditPW.caption = sTemp[1]
				Account0.enable = false
				
				if UBOUND(sTemp) == 3 then '잔고통보처에서 주소 탭으로
					
					if g_sScreenNo <> "87052" then
						g_sScreenNo = "87010" '잔고통보처에소 닫지 않게 하기 위해
					end if
					
					FormTab0.currenttab = sTemp[2]
				end if
			end if		
		End If
	end if
		
	SetRequestData()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	SetRequestData()
	
	if sEventName == "Register" then '등록
	
		if GetPWCkeck() then
			Exit Sub
		end if
		
		'v0001
		if CustClsCdCkeck() then
			Exit Sub
		end if
		
		
		g_sTyp = "Register"
		g_sProcessTyp = sParam
		
		if sParam == "page0_Home" or sParam == "page0_Office" or 
			sParam == "page0_Phone" or sParam == "page0_Fax" then '자택/직장/휴대폰/Fax전화번호
			Form.SetSharedData("mbonl81000_p1" , "")
			Form.SetSharedData("mbonl81000_p1_Rdo" , "")
	
			Form.OpenFramePopup(G_PHONE_INPUT_FILE , sEventName..";"..sParam , "")
		elseif sParam == "page1_Email" then 'E-mail	
			Form.SetSharedData("mbonl81000_p5_EMAIL" , "")
			
			Form.OpenFramePopup(G_EMAIL_INPUT_FILE , sEventName..";"..sParam , "")	
		else '자택/직장/기타주소
			Form.SetSharedData("mbonl81000_p4_YN" , "")
			Form.SetSharedData("mbonl81000_p4_REGN_ZIP" , "")
			Form.SetSharedData("mbonl81000_p4_DTL_ZIP" , "")
			Form.SetSharedData("mbonl81000_p4_POST" , "")
			Form.SetSharedData("mbonl81000_p4_DTAD" , "")
			Form.SetSharedData("mbonl81000_p4_BLDN" , "")
			
			Form.OpenPopupAnimation(G_ADDRESS_INPUT_FILE, sEventName..";"..sParam, "", "2")
		end if
	elseif sEventName == "Modify" then '변경
		if GetPWCkeck() then
			Exit Sub
		end if
		
		'v0001
		if CustClsCdCkeck() then
			Exit Sub
		end if
		
		g_sTyp = "Modify"
		g_sProcessTyp = sParam
		
		if sParam == "page0_Home" or sParam == "page0_Office" or 
			sParam == "page0_Phone" or sParam == "page0_Fax" then '자택/직장/휴대폰/Fax전화번호
			Form.SetSharedData("mbonl81000_p1" , "")
			Form.SetSharedData("mbonl81000_p1_Rdo" , "")
	
			Form.OpenFramePopup(G_PHONE_INPUT_FILE , sEventName..";"..sParam , "")
		elseif sParam == "page1_Email" then 'E-mail	
			Form.SetSharedData("mbonl81000_p5_EMAIL" , "")
			
			Form.OpenFramePopup(G_EMAIL_INPUT_FILE , sEventName..";"..sParam , "")
		else '자택/직장/기타주소
			Form.SetSharedData("mbonl81000_p4_YN" , "")
			Form.SetSharedData("mbonl81000_p4_REGN_ZIP" , "")
			Form.SetSharedData("mbonl81000_p4_DTL_ZIP" , "")
			Form.SetSharedData("mbonl81000_p4_POST" , "")
			Form.SetSharedData("mbonl81000_p4_DTAD" , "")
			Form.SetSharedData("mbonl81000_p4_BLDN" , "")
	
			Form.OpenPopupAnimation(G_ADDRESS_INPUT_FILE, sEventName..";"..sParam, "", "2")
		end if
	elseif sEventName == "Delete" then '삭제
		if GetPWCkeck() then
			Exit Sub
		end if
		
		'v0001
		if CustClsCdCkeck() then
			Exit Sub
		end if
		
		Dim sText
		g_sTyp = "Delete"
		g_sProcessTyp = sParam
		
		if sParam == "page0_Home" then '자택전화번호
			 sText = "자택전화를 삭제 하시겠습니까?"	
		elseif sParam == "page0_Office" then '직장전화번호
			sText = "직장전화를 삭제 하시겠습니까?"
		elseif sParam == "page0_Phone" then '휴대폰전화번호
			sText = "휴대폰을 삭제 하시겠습니까?"
		elseif sParam == "page0_Fax" then 'Fax전화번호
			sText = "FAX를 삭제 하시겠습니까?"
		elseif sParam == "page1_Home" then '자택주소
			sText = "자택주소를 삭제 하시겠습니까?"
		elseif sParam == "page1_Office" then '직장주소
			sText = "직장주소를 삭제 하시겠습니까?"
		elseif sParam == "page1_Etc" then '기타주소
			sText = "기타주소를 삭제 하시겠습니까?"
		elseif sParam == "page1_Email" then 'E-mail
			sText = "e-mail을 삭제 하시겠습니까?"
		end if
		
		Form.MsgBox( "알림", sText, sParam, 1 )
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "page0_Home" or sKeyName == "page0_Office" or sKeyName == "page0_Phone" or sKeyName == "page0_Fax" then
		if sRet == "ok" then
			if sKeyName == "page0_Home" then '자택전화번호
				sNum = Form.GetSharedData("Number_Home1" , false)
				sNum = sNum..Form.GetSharedData("Number_Home2" , false)
				sNum = sNum..Form.GetSharedData("Number_Home3" , false)
				sNum = sNum..Form.GetSharedData("Number_Home4" , false)
			elseif sKeyName == "page0_Office" then '직장전화번호
				sNum = Form.GetSharedData("Number_Office1" , false)
				sNum = sNum..Form.GetSharedData("Number_Office2" , false)
				sNum = sNum..Form.GetSharedData("Number_Office3" , false)
				sNum = sNum..Form.GetSharedData("Number_Office4" , false)
			elseif sKeyName == "page0_Phone" then '휴대폰전화번호
				sNum = Form.GetSharedData("Number_Phone1" , false)
				sNum = sNum..Form.GetSharedData("Number_Phone2" , false)
				sNum = sNum..Form.GetSharedData("Number_Phone3" , false)
			elseif sKeyName == "page0_Fax" then 'Fax전화번호
				sNum = Form.GetSharedData("Number_Fax1" , false)
				sNum = sNum..Form.GetSharedData("Number_Fax2" , false)
				sNum = sNum..Form.GetSharedData("Number_Fax3" , false)
			end if
			
			Form.SetSharedData("mbonl81000_p1" , sNum)
			Form.SetSharedData("CERT_ACNO" , g_sAcc)
			Form.OpenFramePopup(G_CERT_ADD_FILE , "contact_del" , "")	
		end if
	elseif sKeyName == "page1_Email" then 'E-mail
		if sRet == "ok" then	
			Dim EMAIL
			EMAIL = Form.GetSharedData("Adress_Email1" , false)
			Form.SetSharedData("mbonl81000_p5_EMAIL" , EMAIL)
			
			SetSecurityOpen()
		end if
	elseif sKeyName == "page1_Home" or sKeyName == "page1_Office" or sKeyName == "page1_Etc" then
		if sRet == "ok" then
			Dim REGN_ZIP, DTL_ZIP, POST, DTAD
			if sKeyName == "page1_Home" then '자택주소
				REGN_ZIP = Form.GetSharedData("Adress_Home1" , false) 
				DTL_ZIP = Form.GetSharedData("Adress_Home2" , false) 
				POST = Form.GetSharedData("Adress_Home3" , false) 
				DTAD = Form.GetSharedData("Adress_Home4" , false) 
			elseif sKeyName == "page1_Office" then '직장주소
				REGN_ZIP = Form.GetSharedData("Adress_Office1" , false)
				DTL_ZIP = Form.GetSharedData("Adress_Office2" , false)
				POST = Form.GetSharedData("Adress_Office3" , false)
				DTAD = Form.GetSharedData("Adress_Office4" , false)
			elseif sKeyName == "page1_Etc" then '기타주소
				REGN_ZIP = Form.GetSharedData("Adress_Etc1" , false)
				DTL_ZIP = Form.GetSharedData("Adress_Etc2" , false)
				POST = Form.GetSharedData("Adress_Etc3" , false)
				DTAD = Form.GetSharedData("Adress_Etc4" , false)	
			end if
			
			Form.SetSharedData("mbonl81000_p4_REGN_ZIP" , REGN_ZIP)
			Form.SetSharedData("mbonl81000_p4_DTL_ZIP" , DTL_ZIP)
			Form.SetSharedData("mbonl81000_p4_POST" , POST)
			Form.SetSharedData("mbonl81000_p4_DTAD" , DTAD)
			
			SetSecurityOpen()
		end if		
	end if 
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'msgbox sKeyName & "][" & sRet
	if sKeyName == G_PHONE_INPUT_FILE then
		if sRet == "ok" then
			Dim sTemp, sGubun, sNewNum, sOldNum 
			sTemp = Form.GetSharedData("mbonl81000_p1" , false)
			sGubun = Form.GetSharedData("mbonl81000_p1_Rdo" , false)
			sTemp = Split(sTemp, ";")
			sNewNum = sTemp[0]
			for i = 1 to #sTemp-1
				sNewNum = sNewNum..sTemp[i]
			next

			if g_sTyp == "Modify" then '기존연락처와동일한지 확인
				if g_sProcessTyp == "page0_Home" then '자택전화번호
					sOldNum = Form.GetSharedData("Number_Home1" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Home2" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Home3" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Home4" , false)
				elseif g_sProcessTyp == "page0_Office" then '직장전화번호
					sOldNum = Form.GetSharedData("Number_Office1" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Office2" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Office3" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Office4" , false)
				elseif g_sProcessTyp == "page0_Phone" then '휴대폰전화번호
					sOldNum = Form.GetSharedData("Number_Phone1" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Phone2" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Phone3" , false)
				elseif g_sProcessTyp == "page0_Fax" then 'Fax전화번호
					sOldNum = Form.GetSharedData("Number_Fax1" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Fax2" , false)
					sOldNum = sOldNum..Form.GetSharedData("Number_Fax3" , false)
				end if

				if sNewNum == sOldNum then
					Form.MsgBox( "알림", "기존 연락처와 동일합니다.", "", 6 )	
					Exit Sub
				end if
			end if
		
			if g_sProcessTyp == "page0_Phone" then '휴대폰전화번호
				if sGubun == "0" then '본인인증 확인창				
					if g_sTyp == "Register" then 
						Form.OpenFramePopup(G_PHONE_CONFIRM_FILE , "contact_regi" , "")			
					elseif g_sTyp == "Modify" then 
						Form.OpenFramePopup(G_PHONE_CONFIRM_FILE , "contact_modi" , "")			
					end if 
				else '타인명의 추가인증
					Form.SetSharedData("CERT_ACNO" , g_sAcc)
					
					if g_sTyp == "Register" then 
						Form.OpenFramePopup(G_CERT_ADD_FILE , "contact_regi" , "")			
					elseif g_sTyp == "Modify" then 
						Form.OpenFramePopup(G_CERT_ADD_FILE , "contact_modi" , "")			
					end if
				end if
			else '자택/직장/Fax전화번호 추가인증
				Form.SetSharedData("CERT_ACNO" , g_sAcc)
				
				if g_sTyp == "Register" then 
					Form.OpenFramePopup(G_CERT_ADD_FILE , "contact_regi" , "")			
				elseif g_sTyp == "Modify" then 
					Form.OpenFramePopup(G_CERT_ADD_FILE , "contact_modi" , "")			
				end if
			end if
		end if
	elseif sKeyName == G_ADDRESS_INPUT_FILE or sKeyName == G_EMAIL_INPUT_FILE then
		if sRet == "ok" then
			if g_stmp_tmp =="9999" then
				DATAMANAGER.RequestTranData( "obcsb_acad_003a" ) '고객연락처변경실행
			else
				SetSecurityOpen()
			end if
		end if
	elseif sKeyName == G_PHONE_CONFIRM_FILE or sKeyName == G_CERT_ADD_FILE then
		if sRet == "ok" then
			if g_stmp_tmp =="9999" then
				DATAMANAGER.RequestTranData( "obcsb_acad_003a" ) '고객연락처변경실행
			else
				SetSecurityOpen()
			end if
		end if
	elseif sKeyName == G_CERT_SECURITY_FILE or sKeyName == G_CERT_QUESTION_FILE or sKeyName == G_CERT_OTP_FILE or sKeyName == G_CERT_mOTP_FILE then
		if sRet == "ok" then
			Form.OpenFramePopup( G_CERT_PW_FILE , "" , "" )	
		end if 
	elseif sKeyName == G_CERT_PW_FILE then
		if sRet ~= "cancel" then 
			DATAMANAGER.RequestTranData( "obcsb_acad_003a" ) '고객연락처변경실행
		end if 
		
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then	
		'Form.ShowAlert("jsi 90190_p1" , "들어오나???")
		'if sRet == "ok" then									
		'end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD
	'v0004
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    sACNT_PWD = EditPW.caption
	else  'MTS메모리평문 미적용상태일때
	    sACNT_PWD = Form.GetEncData(EditPW.caption)
	end if	
		
	if szTranID == "obacp_opop_068r" then
		DATAMANAGER.SetDataValue( 0, "obacp_opop_068r", "InBlock1", "ACNO" , 0 , g_sAcc )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_068r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , g_sAcc )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID
		sDeviceID = Form.GetDeviceID()

		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , g_sAcc )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	elseif szTranID == "obcsb_acad_003a" then
		DATAMANAGER.ClearInputData( 0, szTranID )
		
		Dim sTemp, sToday, REGN_ZIP, DTL_ZIP, POST, DTAD, sYN, BLDN, EMAIL
		sToday = Form.GetSharedData("&HOST_DATE" , false)
		
		if g_sProcessTyp == "page0_Home" or g_sProcessTyp == "page0_Office" or g_sProcessTyp == "page0_Phone" or g_sProcessTyp == "page0_Fax" then
			if g_sTyp == "Delete" then
				
				'16-03-24 YCJ 고객연락처 삭제시 전화번호가 필요한 부분 추가 -> 김유경 주임 요청
				SetTel(g_sProcessTyp)		'전화번호 Input 값 세팅
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "CNPL_REG_DATE" , 0 , sToday )

			end if
				
			if g_sTyp ~= "Delete" then
				sTemp = Form.GetSharedData("mbonl81000_p1" , false)
				sTemp = Split(sTemp, ";")
							
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "ARCD" , 0 , sTemp[0] )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "TONO" , 0 , sTemp[1] )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "TELNO" , 0 , sTemp[2]) 
				
				If g_sProcessTyp == "page0_Phone" then '휴대폰전화번호
				    g_newTelno = sTemp[0] .. "-" .. sTemp[1] .. "-" .. sTemp[2] 'v0006
				End If
				
				if sTemp[3] ~= null and sTemp[3] ~= "" then
					DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "TENO" , 0 , sTemp[3] )
				end if
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "CNPL_REG_DATE" , 0 , sToday )
			end if
					
			if g_sProcessTyp == "page0_Home" then '자택전화번호
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_TYPE_CODE" , 0 , "11" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_SRNO" , 0 , LabelHNumber.caption )	
			elseif g_sProcessTyp == "page0_Office" then '직장전화번호
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_TYPE_CODE" , 0 , "12" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_SRNO" , 0 , LabelONumber.caption )
			elseif g_sProcessTyp == "page0_Phone" then '휴대폰전화번호
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_TYPE_CODE" , 0 , "13" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_SRNO" , 0 , LabelPNumber.caption )
			elseif g_sProcessTyp == "page0_Fax" then 'Fax전화번호
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_TYPE_CODE" , 0 , "14" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock2", "INAG_SRNO" , 0 , LabelFNumber.caption )
			end if
		elseif g_sProcessTyp == "page1_Home" or g_sProcessTyp == "page1_Office" or g_sProcessTyp == "page1_Etc" then
			sYN = Form.GetSharedData("mbonl81000_p4_YN" , false)
			REGN_ZIP = Form.GetSharedData("mbonl81000_p4_REGN_ZIP" , false)
			DTL_ZIP = Form.GetSharedData("mbonl81000_p4_DTL_ZIP" , false)
			POST = Form.GetSharedData("mbonl81000_p4_POST" , false)
			DTAD = Form.GetSharedData("mbonl81000_p4_DTAD" , false)
			BLDN = Form.GetSharedData("mbonl81000_p4_BLDN" , false)
	
			Dim i
			if g_sProcessTyp == "page1_Home" then
				i = 0
				
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_TYPE_CODE" , i , "01" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_SRNO" , i , LabelHAddress.caption )
			elseif g_sProcessTyp == "page1_Office" then
				i = 1
				
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_TYPE_CODE" , i , "02" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_SRNO" , i , LabelOAddress.caption )
			elseif g_sProcessTyp == "page1_Etc" then
				i = 2
				
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_TYPE_CODE" , i , "03" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_SRNO" , i , LabelEtcAddress.caption )
			end if
	
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "CUST_TYPE_CODE" , i , g_sCustTypCd )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "ADDR_REG_DATE" , i , sToday )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "REGN_ZIP" , i , REGN_ZIP )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "DTL_ZIP" , i , DTL_ZIP )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "POST" , i , POST )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "DTAD" , i , DTAD )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "NW_ADDR_USE_YN" , i , sYN )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "BLDN_MNNO" , i , BLDN )
		elseif g_sProcessTyp == "page1_Email" then 'E-mail
			EMAIL = Form.GetSharedData("mbonl81000_p5_EMAIL" , false)
		
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "CUST_TYPE_CODE" , 3 , g_sCustTypCd )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_TYPE_CODE" , 3 , "21" )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "ADDR_REG_DATE" , 3 , sToday )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "INAG_SRNO" , 3 , LabelMailAddress.caption )
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock1", "EMAIL_ADDR" , 3 , EMAIL )
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock3", "SNML_INAG_TYPE_CODE" , 0 , LabelSNMLTYPE.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock3", "SNML_INAG_SRNO" , 0 , LabelSNMLSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock3", "MAIL_INAG_TYPE_CODE" , 0 , LabelMAILTYPE.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock3", "MAIL_INAG_SRNO" , 0 , LabelMAILSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock3", "FUND_RMND_RCMS_CLS_CODE" , 0 , LabelFUNDRCMS.caption )		
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "ACNO" , 0 , g_sAcc )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "ACNT_PWD" , 0 , sACNT_PWD )
		if g_sTyp == "Register" then
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "PROS_CLS_CODE" , 0 , "1" )
		elseif g_sTyp == "Modify" then
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "PROS_CLS_CODE" , 0 , "2" )
		elseif g_sTyp == "Delete" then
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "PROS_CLS_CODE" , 0 , "3" )
		end if
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock4", "CSNO" , 0 , g_sCSNO )
		'v0005
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_003a", "InBlock3", "MBL_PRTY_INFR_YN" , 0 , LabelMBLPRTY.caption )
		'Form.ShowAlert("jsi" , LabelMBLPRTY.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_068r" then
		SetRequestData()
	elseif szTranID == "obcsb_acad_002r" then
		SetControlViewClear()

		Dim nCnt, REGN_ZIP, DTL_ZIP, POST, DTAD, EMAIL_ADDR, ARCD, TONO, TELNO, TENO

		'주소정보
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )
		g_sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "CSNO" , 0 )
		g_sCustTypCd = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "CUST_TYPE_CODE" , 0 )
		'16-03-24 YCJ 고객 전화번호 입력 개수
		szDateCount = DATAMANAGER.GetDataCount( 0 , "obcsb_acad_002r", "OutBlock3") - 1
		'v0001
		g_sCustClsCd = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE" , 0 )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "01" then '자택
					REGN_ZIP = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "REGN_ZIP" , i )
					DTL_ZIP = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTL_ZIP" , i )
					POST = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST" , i )
					DTAD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD" , i )
					LabelHAddress.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )
					
					Form.SetSharedData("Adress_Home1" , REGN_ZIP) 
					Form.SetSharedData("Adress_Home2" , DTL_ZIP) 
					Form.SetSharedData("Adress_Home3" , POST) 
					Form.SetSharedData("Adress_Home4" , DTAD) 
				elseif sINAG_TYPE_CODE == "02" then '직장
					REGN_ZIP = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "REGN_ZIP" , i )
					DTL_ZIP = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTL_ZIP" , i )
					POST = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST" , i )
					DTAD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD" , i )
					LabelOAddress.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )
					
					Form.SetSharedData("Adress_Office1" , REGN_ZIP)
					Form.SetSharedData("Adress_Office2" , DTL_ZIP)
					Form.SetSharedData("Adress_Office3" , POST)
					Form.SetSharedData("Adress_Office4" , DTAD)
				elseif sINAG_TYPE_CODE == "03" then '기타
					REGN_ZIP = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "REGN_ZIP" , i )
					DTL_ZIP = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTL_ZIP" , i )
					POST = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST" , i )
					DTAD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD" , i )
					LabelEtcAddress.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )
					
					Form.SetSharedData("Adress_Etc1" , REGN_ZIP)
					Form.SetSharedData("Adress_Etc2" , DTL_ZIP)
					Form.SetSharedData("Adress_Etc3" , POST)
					Form.SetSharedData("Adress_Etc4" , DTAD)
				elseif sINAG_TYPE_CODE == "21" then 'E-mail
					EMAIL_ADDR = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )
					LabelMailAddress.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )
					
					Form.SetSharedData("Adress_Email1" , EMAIL_ADDR)
				end if
			next
		end if

		'전화번호정보
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "11" then '자택
					ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					TONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					TELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					TENO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TENO" , i )
					LabelHNumber.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )
										
					Form.SetSharedData("Number_Home1" , ARCD)
					Form.SetSharedData("Number_Home2" , TONO)
					Form.SetSharedData("Number_Home3" , TELNO)
					Form.SetSharedData("Number_Home4" , TENO)
				elseif sINAG_TYPE_CODE == "12" then '직장
					ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					TONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					TELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					TENO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TENO" , i )
					LabelONumber.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )
										
					Form.SetSharedData("Number_Office1" , ARCD)
					Form.SetSharedData("Number_Office2" , TONO)
					Form.SetSharedData("Number_Office3" , TELNO)
					Form.SetSharedData("Number_Office4" , TENO)
				elseif sINAG_TYPE_CODE == "13" then '휴대폰
					ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					TONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					TELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					LabelPNumber.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )

					Form.SetSharedData("Number_Phone1" , ARCD)
					Form.SetSharedData("Number_Phone2" , TONO)
					Form.SetSharedData("Number_Phone3" , TELNO)
				elseif sINAG_TYPE_CODE == "14" then 'FAX
					ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					TONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					TELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					LabelFNumber.caption = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )

					Form.SetSharedData("Number_Fax1" , ARCD)
					Form.SetSharedData("Number_Fax2" , TONO)
					Form.SetSharedData("Number_Fax3" , TELNO)
				end if
			next
		end if	
		
		Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", FormTab0.currenttab )
		
		'Form.ShowAlert("jsi" , LabelMBLPRTY.caption )
	elseif szTranID == "obcsb_oimf_625r" then
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
	elseif szTranID == "obcsb_acad_003a" then
		
		Form.SetSharedData("mbbnk64010_new_number" , g_newTelno)
		
		if g_sScreenNo ~= "81000" and  g_sScreenNo ~= "87010" then '고객연락처변경 본화면이 아닌경우
			g_sRetData = "ok"
			Form.CloseForm()
		else
			if  g_sScreenNo == "87010" then
				g_sRetData = "ok"
			end if
			
			Dim sMsg, sSubMsg
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )	
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			
			if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
				sMsg = sMsg.." "..sSubMsg
			end if
			
			Form.MsgBox( "알림", sMsg, "", 6 )
		
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '고객연락처조회
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obacp_opop_068r" then
		EditPW.caption = ""
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obcsb_acad_003a" then
		if szErrCode == "2776" then
			Form.MsgBox( "알림", "도로명주소 일괄전환 작업으로 인하여 주소변경업무가 일시중단 됩니다. (중단시간: 19:00 ~ 24:00)", "", 6 )
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
	end if
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account0_ChangeAccount()
	g_sAcc = Account0.caption
	
	EditPW.caption = ""
End Sub
'============================================================================
' 비밀번호 입력
'============================================================================
Sub EditPW_OnEditComplete()
	if EditPW.caption ~= null and EditPW.caption ~= "" then
		DATAMANAGER.RequestTranData( "obacp_opop_068r" ) '비밀번호검증
	end if
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if g_stmp_tmp =="9999" then
		FormTab0.currenttab = "1"
		Form.MsgBox( "알림", "전화번호는 변경하실 수 없습니다.", "", 6 )
		exit sub
	end if

	Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", nCurrentTab )
	
End Sub

