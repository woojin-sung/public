'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&CommonNoSecurity" then
		if Cint(sValue) == 6 then
			DATAMANAGER.RequestTranData( "obcsb_acad_003a" ) '고객연락처변경실행
		end if
	end if
End Sub
