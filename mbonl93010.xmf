'============================================================================
Sub Form_OnFormInit()

    RefreshAll()
    
    Tab0_OnTabChanged(0)
    
End Sub

'============================================================================
Sub Account0_ChangeAccount()

    ACNO = ""
    ASNO = ""
    PASSWORD = ""

    BtnInfr.enable = False
    RefreshAll()
    
End Sub

'============================================================================
Sub EditPW_OnEditComplete()

    ACNO = Left ( Account0.caption , 8 )
    ASNO = Right( Account0.caption , 2 )
    PASSWORD = EditPW.caption
    
    RefreshAll()

End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)

    RefreshAll()

    If nCurrentTab = 0 Then
    
        Label0.visible = True
        Label1.visible = True
        Label2.visible = True
        Label4.visible = True
        Label5.visible = True
        Label6.visible = True
        Label7.visible = True
