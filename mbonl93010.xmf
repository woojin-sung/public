        Label11.visible = False
        Label12.visible = False
        Label13.visible = False
	
        Label3.visible = False
        Label9.visible = False
        Label10.visible = False
	
        EdtLimt.visible = False
        EdtUsableAmt.visible = False
        EdtUseAmt.visible = False
        EdtApltAmt.visible = False
	
        BtnInfr.visible = False
	
        BtnAplt.visible = False
        BtnMod.visible = False
        BtnCanc.visible = False
    
        Grid0.visible = True

    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    
    If szTranID = "obrtp_sptx_001r" Then
    
        If DATAMANAGER.IsMoreNextData(szTranID) = True Then
            DATAMANAGER.RequestNextData(szTranID)
        Else
	
            If Tab0.currenttab = 2 Or Tab0.currenttab = "2" Then
                USE_AMT = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "UI_TXCM_JOIN_AMT" , 0)
                EdtApltAmt.caption = USE_AMT
                EdtApltAmt.enable = False
		   Else
                EdtApltAmt.caption = ""
                EdtApltAmt.enable = True
            End If
	    
            BtnInfr.enable = True
	    
        End If
	
    End If
    
    If szTranID = "obrtp_sptx_002a" Then
    
        Form.MsgBox("" , "처리가 완료되었습니다", "", 0)
        RefreshAll()
	
    End If
    
    DATAMANAGER.ClearInputData(0 , szTranID)
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
    If szTranID = "obrtp_sptx_001r" Then
        Dim strMsg
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        Form.MsgBox("사용현황 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)  
    End If
    
    If szTranID = "obrtp_sptx_002a" Then
        Dim strMsg
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        Form.MsgBox("신청처리 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
    End If
    
    DATAMANAGER.ClearInputData(0 , szTranID)
    
End Sub

'============================================================================
Sub BtnInfr_OnClick()

    Form.OpenPopup("mbonl93010_p1" , "" , "")
	
End Sub

Sub Form_OnPopupReturn(sKeyName, sRet)
	
    If sKeyName = "OKClick" And sRet = "1" Then
    
        If LEN(TRIM(ACNO)) > 0 And LEN(TRIM(ASNO)) > 0 And LEN(TRIM(PASSWORD)) > 0 Then
    
            BtnAplt.enable = True
            BtnMod.enable = True
            BtnCanc.enable = True
	
        End If	    
        
    End If
    
End Sub

'============================================================================
Sub BtnAplt_OnClick()

    If LEN(TRIM(EdtApltAmt.caption)) = 0 Then
        Form.MsgBox("" , "신청금액을 입력하여 주십시오" , "" , 0)
        Exit Sub
    End If

    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" ) '접촉구분코드
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "JOB_CLS_CODE"  , 0 , "1" ) '신청
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "ACNO"          , 0 , ACNO )
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "ASNO"          , 0 , ASNO )
    
    plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v001
    If plain_rm == "1" Then
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "PWD" , 0 , PASSWORD )
    Else
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "PWD" , 0 , Form.GetEncData(PASSWORD) )
    End If
    
    
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "APLT_LIMT_AMT" , 0 , EdtApltAmt.caption )
    DATAMANAGER.RequestTranData("obrtp_sptx_002a")     
    
End Sub

'============================================================================
Sub BtnMod_OnClick()

    If LEN(TRIM(EdtApltAmt.caption)) = 0 Then
        Form.MsgBox("" , "변경후금액을 입력하여 주십시오" , "" , 0)
        Exit Sub
    End If

    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" ) '접촉구분코드
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "JOB_CLS_CODE"  , 0 , "2" ) '변경
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "ACNO"          , 0 , ACNO )
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "ASNO"          , 0 , ASNO )
    
    plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v001
    If plain_rm == "1" Then
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "PWD" , 0 , PASSWORD )
    Else
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "PWD" , 0 , Form.GetEncData(PASSWORD) )
    End If
    
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "APLT_LIMT_AMT" , 0 , EdtApltAmt.caption )
    DATAMANAGER.RequestTranData("obrtp_sptx_002a")     
    
End Sub

'============================================================================
Sub BtnCanc_OnClick()

    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" ) '접촉구분코드
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "JOB_CLS_CODE"  , 0 , "3" ) '해지
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "ACNO"          , 0 , ACNO )
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "ASNO"          , 0 , ASNO )
    
    plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v001
    If plain_rm == "1" Then
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "PWD" , 0 , PASSWORD )
    Else
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "PWD" , 0 , Form.GetEncData(PASSWORD) )
    End If
       
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_002a" , "InBlock1" , "APLT_LIMT_AMT" , 0 , EdtApltAmt.caption )
    DATAMANAGER.RequestTranData("obrtp_sptx_002a")     
    
End Sub

'============================================================================
Sub RefreshAll()

	EdtUsableAmt.caption = ""
	EdtLimt.caption = ""
	EdtUseAmt.caption = ""
	EdtApltAmt.caption = ""
	Grid0.rowcount = 0
	
	EdtApltAmt.enable = False
	
	BtnAplt.enable = False
	BtnMod.enable = False
	BtnCanc.enable = False

    If LEN(TRIM(ACNO)) > 0 And LEN(TRIM(ASNO)) > 0 And LEN(TRIM(PASSWORD)) > 0 Then
    
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_001r" , "InBlock1" , "ACNO" , 0 , ACNO )
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_001r" , "InBlock1" , "ASNO" , 0 , ASNO )
	
        plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v001
        If plain_rm == "1" Then
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_001r" , "InBlock1" , "PWD"  , 0 , PASSWORD )
        Else	 
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_001r" , "InBlock1" , "PWD"  , 0 , Form.GetEncData(PASSWORD) )
        End If
    
        DATAMANAGER.RequestTranData( "obrtp_sptx_001r" )    
	
    End If

End Sub

