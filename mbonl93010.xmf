        EdtLimt.visible = True
        EdtUseAmt.visible = True
        EdtApltAmt.visible = True
	
        BtnInfr.visible = True
	
        BtnAplt.visible = True
        BtnMod.visible = False
        BtnCanc.visible = False
	
        Grid0.visible = False
	
    ElseIf nCurrentTab = 1 Then
    
        Label0.visible = True
        Label1.visible = True
        Label2.visible = True
        Label4.visible = True
        Label5.visible = True
        Label6.visible = True
        Label7.visible = True
        Label8.visible = True
        Label11.visible = True
        Label12.visible = True
        Label13.visible = True
	
        Label3.visible = False
        Label9.visible = True
        Label10.visible = False
	    
        EdtLimt.visible = True
        EdtUsableAmt.visible = True
        EdtUseAmt.visible = True
        EdtApltAmt.visible = True
	
        BtnInfr.visible = True
	
        BtnAplt.visible = False
        BtnMod.visible = True
        BtnCanc.visible = False
	
        Grid0.visible = False
    
    ElseIf nCurrentTab = 2 Then
    
        Label0.visible = True
        Label1.visible = True
        Label2.visible = True
        Label4.visible = True
        Label5.visible = True
        Label6.visible = True
        Label7.visible = True
        Label8.visible = True
        Label11.visible = True
        Label12.visible = True
        Label13.visible = True
	
        Label3.visible = False
        Label9.visible = False
        Label10.visible = True
	
        EdtLimt.visible = True
        EdtUsableAmt.visible = True
        EdtUseAmt.visible = True
        EdtApltAmt.visible = True
	
        BtnInfr.visible = True
	
        BtnAplt.visible = False
        BtnMod.visible = False
        BtnCanc.visible = True
	
        Grid0.visible = False
	
    ElseIf nCurrentTab = 3 Then
    
        Label0.visible = False
        Label1.visible = False
        Label2.visible = False
        Label4.visible = False
        Label5.visible = False
        Label6.visible = False
        Label7.visible = False
