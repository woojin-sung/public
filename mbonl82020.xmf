'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)

'	if nCurrentTab == 0 then
'		Account0.visible = true
'		Account1.visible = false
'		Account2.visible = false
'		
'		EditPW0.visible = true
'		EditPW1.visible = false
'		EditPW2.visible = false
'		
'		Account0_ChangeAccount()
'	else
	if nCurrentTab == 0 then 
		Account0.visible = true
		Account1.visible = false
		Account2.visible = false
		
		EditPW0.visible = true
		EditPW1.visible = false
		EditPW2.visible = false
		
		Account0_ChangeAccount()
	elseif nCurrentTab == 1 then 
		Account0.visible = false
		Account1.visible = true
		Account2.visible = false
		
		EditPW0.visible = false
		EditPW1.visible = true
		EditPW2.visible = false
		
		Account1_ChangeAccount()
	elseif nCurrentTab == 2 then 
		Account0.visible = false
		Account1.visible = false
		Account2.visible = true
		
		EditPW0.visible = false
		EditPW1.visible = false
		EditPW2.visible = true
		
		Account2_ChangeAccount()
	elseif nCurrentTab == 3 then '20160912 만기연장신청(2번과동일하게함)
		Account0.visible = false
		Account1.visible = true
		Account2.visible = false
		
		EditPW0.visible = false
		EditPW1.visible = true
		EditPW2.visible = false
		
		Account1_ChangeAccount()		
	end if
End Sub





