'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'계좌컨트롤
'(약정등록)
'종합계좌스타일 

'(예탁담보가능계좌등록)
'종합계좌스타일

'(예탁담보대출신청)
'100종합매매,105은행제휴(위탁),106은행제휴(수익),119WRAP(종합매매)

'(매도담보대출신청)
'100종합매매,105은행제휴(위탁),106은행제휴(수익)

'(대출만기연장신청) 20160912추가
'예탁담보와 동일

Dim g_sAcc '계좌번호


Dim g_szDAccName	'예탁담보신청 계좌명칭
Dim g_szSAccName	'매도담보신청 계좌명칭
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()	
	Dim szScreenNo
	Dim szCurrentTab
	Dim szRegiAccount
	szCurrentTab = FormTab0.currenttab
	g_sAcc = Account0.caption
	
	g_szDAccName = Account1.accnamectl
	g_szSAccName = Account2.accnamectl
	
	Form.SetSharedData( "Deposit_Name" , g_szDAccName)
	Form.SetSharedData( "Sale_Name" , g_szSAccName)
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	szRegiAccount = Form.GetOpenLinkData()
	
	'담보대출약정 화면 개선에 따른 담보대출약정 탭 삭제
	if szScreenNo == "82020" then
		Form.SetScreenName("담보대출약정")
		
		if len(szRegiAccount) == 0 then
			FormTab0.currenttab = 1
			FormTab0_OnTabChanged(CInt(FormTab0.currenttab))		
		else
			FormTab0.currenttab = 1
			FormTab0_OnTabChanged(CInt(FormTab0.currenttab))			
		end if

	elseif szScreenNo == "82021" then
		Form.SetScreenName("예탁담보대출")
		FormTab0.currenttab = 1
		FormTab0_OnTabChanged(CInt(FormTab0.currenttab))
	elseif szScreenNo == "82022" then
		Form.SetScreenName("매도담보대출")
		FormTab0.currenttab = 2
		FormTab0_OnTabChanged(CInt(FormTab0.currenttab))
	elseif szScreenNO == "82023" then
		Form.SetScreenName("대출만기연장 신청")
		FormTab0.currenttab = 3
		FormTab0_OnTabChanged(CInt(FormTab0.currenttab))
	elseif szScreenNO == "82024" then
		Form.SetScreenName("담보대출계좌 추가등록")
		FormTab0.currenttab = 0
		FormTab0_OnTabChanged(CInt(FormTab0.currenttab))
	else
		FormTab0_OnTabChanged(CInt(szCurrentTab))
	end if
	'비밀번호없이 조회되도록 요청하여 주석처리
'	if EditPW0.caption ~= null and EditPW0.caption ~= "" then
		'Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", g_sAcc )
'	end if
    '폼탭 자동저장 기능으로 변경 2016.04.20
    
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account0_ChangeAccount()
	g_sAcc = Account0.caption
	
	EditPW0.caption = ""
	
	'비밀번호없이 조회되도록 요청하여 주석처리
'	if EditPW0.caption ~= null and EditPW0.caption ~= "" then
		Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", g_sAcc )
'	end if
End Sub
'============================================================================
Sub Account1_ChangeAccount()
	g_sAcc = Account1.caption
	
	g_szDAccName = Account1.accnamectl
	Form.SetSharedData( "Deposit_Name" , g_szDAccName)
	
	'비밀번호없이 조회되도록 요청하여 주석처리
'	if EditPW1.caption ~= null and EditPW1.caption ~= "" then
		Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", g_sAcc )
'	end if
End Sub
'============================================================================
Sub Account2_ChangeAccount()
	g_sAcc = Account2.caption
	
	g_szSAccName = Account2.accnamectl
	Form.SetSharedData( "Sale_Name" , g_szSAccName)
	'비밀번호없이 조회되도록 요청하여 주석처리
'	if EditPW2.caption ~= null and EditPW2.caption ~= "" then
		Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", g_sAcc )
