	szOpenData = Container0.tblExtention.GetCellString(0, 1).."|"..Container0.tblExtention.GetCellString(0, 0)
	Form.OpenPopupAnimation("mbwat61022_p1" ,  szOpenData ,"POPUP_EXTENSION","2")
End Sub

