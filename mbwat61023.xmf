Sub Form_OnFormInitBefore()
	ContainerManageInfo.Button0.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	ContainerManageInfo.Button1.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	ContainerManageInfo.Button2.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	ContainerManageInfo.Button3.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	ContainerManageInfo.Button4.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	
	ContainerManageInfo.Button0.switchindex = 1
	
	ContainerManageInfo.Button1.switchindex = 0
	ContainerManageInfo.Button2.switchindex = 0
	ContainerManageInfo.Button2.enable = false
	
	ContainerManageInfo.Button3.switchindex = 1
	ContainerManageInfo.Button4.switchindex = 1
End Sub


Sub Container0_edtMinAmt_OnEditComplete()
	if CInt(Container0.edtMinAmt.caption) < CInt(g_szMinAmt) then
		Form.ShowAlert("알림", "최소 가입금액을 확인해주세요.")
	end if
End Sub

Sub Container0_edtMinTerm_OnEditComplete()
	if CInt(Container0.edtMinTerm.caption) < 12 then
		Form.ShowAlert("알림", "12개월(기본 계약기간)로\n입력해 주세요.")
	end if
End Sub

Function f_EnableNextBtn()
	btnNext.enable = false
	bEnable = CInt(Container0.edtMinAmt.caption) >= CInt(g_szMinAmt) '최소가입금액
	
	if bEnable then
		bEnable = CInt(Container0.edtMinTerm.caption) >= 12 '최소계약기간
	end if
	if bEnable then
		bEnable = Container0.tblExtention.GetCellString(0, 1) <> ""  '기간연장여부
	end if
	if bEnable then
		bEnable = Container0.tblReport.GetCellString(0, 1) <> ""  '투자일임보고서
	end if
	if bEnable then
		bEnable = Container0.tblPaper.GetCellString(0, 1) <> ""  '계약서류
	end if
	if bEnable then
		bEnable = Container0.tblDepositAcnt.GetCellString(0, 1) <> ""  '입금계좌
	end if
	if bEnable then
		if not(g_bAgree) then  '보수협의 안했다면...
			'Form.OpenPopup("mbwat61022_p5" , g_szWA_PRCD , "")  '보수협의 팝업
			ContainerAgree.visible = true
			Container0.visible = false
			bEnable = false
		end if
	end if
'Form.ShowAlert("bEnable",bEnable)
	btnNext.enable = bEnable
End Function

