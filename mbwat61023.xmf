	<SCRIPT_INFO _len="9850" _ulen="9390" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 이    력 : 2023.11.10 : 고승연 : v0002 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

'============================================================================
dim g_szWA_PRCD, g_szMinAmt, g_bConfirm1, g_bConfirm2, g_bAgree
dim g_bSelect1, g_bSelect2, g_bSelect3


Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_bAgree = false
	ContainerAgree.left = 0
	ContainerAgree.top = 84
	ContainerManageInfo.left = 0
	ContainerManageInfo.top = 84
	ContainerManageInfo.lblConfirm.left = 0	
	ContainerAgree.visible = false
	g_bSelect1 = false
	g_bSelect2 = false
	g_bSelect3 = false
	
	Dim szOpenData, tData
	g_bConfirm1 = false '보수확인 
	g_bConfirm2 = false '운용상품 확인
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "null" and szOpenData <> "" then
		tData = Split(szOpenData, "|")
		g_szWA_PRCD = tData(1) '상품코드
		g_szMinAmt = tData(2) '최소가입금액
		Container0.Table0.SetCellString(3, 1, tData(0)) '상품명
		Container0.Label0.caption = g_szMinAmt
		
		'Form.ShowAlert("Label0.caption", FormatNumber( g_szMinAmt , 0 ))
		Container0.edtMinAmt.hintcaption = "최소"..FormatNumber( g_szMinAmt , 0 ).."원"
		
		DATAMANAGER.RequestTranData("obwat_csad_003r")
		
	end if
End Sub

Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_csad_023r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WA_PRNM" 					 , 0 , lblPrdName.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NRML_YN" 					 , 0 , "Y")
	elseif szTranID = "obwat_csad_003r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD)	'랩어카운트상품코드	
	end if
End Sub

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_csad_023r" then
		sT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "WA_PRNM" , 0)
		Form.ShowAlert("WA_PRNM", sT)
	elseif szTranID = "obwat_csad_003r" then
		sT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "WA_PRNM" , 0)
		'Form.ShowAlert("WA_PRNM2", sT)	
	end if
End Sub
