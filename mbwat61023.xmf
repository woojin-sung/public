	szOpenData = Container0.tblDepositAcnt.GetCellString(0, 1).."|"..Container0.tblDepositAcnt.GetCellString(0, 0)
	Form.OpenPopupAnimation("mbwat61022_p4" ,  szOpenData ,"","2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "POPUP_EXTENSION" then	'기간연장팝업
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			Container0.tblExtention.SetCellString(0, 0, tData(1))
			Container0.tblExtention.SetCellString(0, 1, tData(0))
		end if
		f_EnableNextBtn()
	elseif sKeyName = "POPUP_REPORT" then	'투자일임보고서 수신
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			Container0.tblReport.SetCellString(0, 0, tData(1))
			Container0.tblReport.SetCellString(0, 1, tData(0))
		end if
		f_EnableNextBtn()
	elseif sKeyName = "POPUP_PAPER" then	'계약서수신
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			Container0.tblPaper.SetCellString(0, 0, tData(1))
			Container0.tblPaper.SetCellString(0, 1, tData(0))
		end if
		f_EnableNextBtn()
	elseif sKeyName = "POPUP_AGREEMENT" then	'보수협의
		g_bConfirm1 = sRet <> "Y"
		Container0_lblConfirm_OnClick()
		if g_bConfirm1 then
			sOpenData = g_szWA_PRCD
			'Form.OpenPopup("mbwat61022_p6" , sOpenData , "")  ' 운용정보 팝업
			ContainerManageInfo.visible = true '운용정보 컨테이터
			lblPrdName.caption = "운용 정보"
			btnNext.enable = false
		end if
	elseif sKeyName = "POPUP_INVESTINFO" then	'운용정보
		Form.ShowAlert(sKeyName, sRet)
	elseif sKeyName = "POPUP_DEPOSITACNT" then	'입금계좌
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			sT = tData(0)
			sT = Left(sT,4)&"-"&Mid(sT,5,4)&"-"&Right(sT,2)
			'Container0.tblDepositAcnt.SetCellString(0, 0, tData(1))
			Container0.tblDepositAcnt.SetCellString(0, 1, sT)
		end if
		f_EnableNextBtn()
	elseif sKeyName = "POPUP_CREDIT%" then	'신용 사용한도
		'Form.ShowAlert(sKeyName, sRet)  신용한도 팝업 데이터 수신
	elseif sKeyName = "POPUP_MANAGE_ASSETS" then	'	
		
		if sRet = "CONFIRM" then
			g_bConfirm2 = true
			ContainerManageInfo.imgConfirm.imgpath = "icon_chk_off"

			btnNext.enable = g_bConfirm2
		end if
	end if
	
End Sub


Sub Container0_lblConfirm_OnClick()
	if g_bConfirm1 then
		Container0.imgConfirm.imgpath = "icon_chk_on"
	else
		Container0.imgConfirm.imgpath = "icon_chk_off"
	end if
	g_bConfirm1 = not(g_bConfirm1)
	
End Sub


Sub btnNext_OnClick()
	
'	sOpenData = g_szWA_PRCD
	'Form.OpenPopup("mbwat61022_p6" , sOpenData , "")  '운용정보화면으로 
	ContainerManageInfo.visible = true '운용정보 컨테이터
	lblPrdName.caption = "운용 정보"
	btnNext.enable = false
End Sub


