	szOpenData = Container0.tblReport.GetCellString(0, 1).."|"..Container0.tblReport.GetCellString(0, 0)
	Form.OpenPopupAnimation("mbwat61022_p2" ,  szOpenData ,"POPUP_REPORT","2")
End Sub

