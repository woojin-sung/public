'============================================================================
'20211026 SWJ START : 안드로이드 targetSDK version30 고객 안내 팝업
'============================================================================
Dim g_szGb
'============================================================================
Sub Form_OnFormInit()
	g_szGb = Form.GetOpenLinkData()
	
	'앱 실행 시 띄워줄 때
	if g_szGb == "OPEN_FROM_NOTICE" then
		sOpenYN = Form.LoadConfigData("NoticeSetting", "SDK30_NOTICE")
		
		if sOpenYN == "1" or sOpenYN == 1 then
			Form.CloseForm()
		end if
	end if
	
End Sub

'============================================================================
Sub Button2_OnClick()
	'앱 실행 시 띄워줄 때
	if g_szGb == "OPEN_FROM_NOTICE" then
		Form.SaveConfigData("NoticeSetting", "SDK30_NOTICE", "1") 	'1일 때 오픈하지 않고 닫기
	'인증센터 진입 시 띄워줄 때
	elseif g_szGb == "OPEN_FROM_AUTH" then 
		Form.SaveConfigData("NoticeSetting", "SDK30_AUTH", "1") 	'1일 때 오픈하지 않고 닫기
	end if
	
	Form.CloseForm()
End Sub

'============================================================================
Sub Button3_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub Image5_OnClick()
	Form.CloseForm()
End Sub
