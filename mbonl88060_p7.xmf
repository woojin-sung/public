	<SCRIPT_INFO _len="2503" _ulen="2491" >
Dim g_SHTR_BOND_REG_CLS_CODE

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.imgGraph.setMaintainingRatio("1")
end sub

'============================================================================
Sub Form_OnFormInit()
	
	if  Form.GetSharedData("&OS_TYPE", false ) == "2" then'iOS("2")Android("1")
		Container0.containerimage = "popup_bg.9"
	end if
	
	g_SHTR_BOND_REG_CLS_CODE = Form.GetOpenLinkData()

	if g_SHTR_BOND_REG_CLS_CODE == "1" then	'발행물
		
		Container0.Image11.visible = 1
		Container0.Image11.top = 120
		
		Container0.Image1.top = 170
		Container0.Image2.top = 200
		Container0.Image3.top = 230
		Container0.Image10.top = 280
		Container0.Image4.top = 310
		Container0.Image5.top = 340
		
		Container0.Label15.visible = 1
		Container0.Label15.top = 115
		
		Container0.Label0.top = 165
		Container0.Label1.top = 195
		Container0.Label2.top = 225
		Container0.Label14.top = 275 
		Container0.Label3.top = 305
		Container0.Label4.top = 335
		
		Container0.lblSeper0.top = 370
		
		
		Container0.Label15.changeTextAttr(22, 21, 4, 0, true)
		
	else	'유통물
	
		Container0.Image11.visible = 0
		
		Container0.Image1.top = 140
		Container0.Image2.top = 170
		Container0.Image3.top = 200
		Container0.Image10.top = 250
		Container0.Image4.top = 280
		Container0.Image5.top = 310
		
		Container0.Label15.visible = 0
		
		Container0.Label0.top = 135
		Container0.Label1.top = 165
		Container0.Label2.top = 195
		Container0.Label14.top = 245 
		Container0.Label3.top = 275
		Container0.Label4.top = 305
		
		Container0.lblSeper0.top = 355
	end if

	Container0.Label0.changeTextAttr(3, 5, 4, 0, true)
	Container0.Label1.changeTextAttr(3, 5, 4, 0, true)
	Container0.Label2.changeTextAttr(30, 11, 4, 0, true)
	Container0.Label14.changeTextAttr(0, 4, 4, 0, true)
	Container0.Label3.changeTextAttr(6, 12, 4, 0, true)
	Container0.Label4.changeTextAttr(4, 2, 4, 0, true)

	Form.SetTimerEvent2(1, 1, 0.01)
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	Container0.lblTitle.setHighlight(325)
	Container0.lblTitle0.setHighlight(325)
End Sub

