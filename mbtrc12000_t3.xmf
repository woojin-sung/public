'--===========================================================================
' 01. 화 면 명 : CFD한도
' 02. 화면설명 : CFD한도_총한도증액신청
' 03. 작    성 : 2022.05.16 KSJ 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szState			'신청/해지 여부
	
Dim g_nChoiceRow	'선택한 Row
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	tblState.SetCellString( 0 , 1, "")	'총한도
	tblState.SetCellString( 1 , 1, "")	'기본한도
	tblState.SetCellString( 2 , 1, "")	'추가한도
	tblState.SetCellString( 4 , 1, "")	'총 소진한도
	tblState.SetCellString( 5 , 1, "")	'잔고기준 소진한도
	tblState.SetCellString( 6 , 1, "")	'미체결 소진한도
	tblState.SetCellString( 9 , 1, "")	'신청상태
	
	edtApltLimt.caption = ""	'추가신청한도
	grdList.SetClear()		'협의한도 신청내역
	
	g_nChoiceRow = -1			'선택한 Row
End Function
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )

	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	f_ClearData()
	edtPswd.caption = ""
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	f_ClearData()
	edtPswd.caption = ""
End Sub
'============================================================================
' edtPswd_OnEditComplete() : 비밀번호 입력완료
'============================================================================
Sub edtPswd_OnEditComplete()
	f_ClearData()
	DATAMANAGER.RequestTranData( "obtrc_limt_006r" ) 
End Sub

'============================================================================
' grdList_OnScrollEnd() : Next 조회
'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtrc_limt_006r") == true then
		DATAMANAGER.RequestNextData("obtrc_limt_006r")
	end if
End Sub

'============================================================================
' grdList_OnClickUp(lRow, szCellID)
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_Del" Then
		g_szState = "D"
		g_nChoiceRow = CInt(lRow)
		DATAMANAGER.RequestTranData( "obtrc_limt_007a" ) '총한도증액신청
	End If
End Sub

'============================================================================
' edtApltLimt_OnClick() : 추가신청한도 입력
'============================================================================
Sub edtApltLimt_OnClick()
	If f_GetPWCkeck() Then
		Exit Sub
	End If
End Sub

'============================================================================
' btnAplt_OnClick() : 신청
'============================================================================
Sub btnAplt_OnClick()
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	If edtApltLimt.caption == "" or edtApltLimt.caption == 0 Then
		Form.ShowAlert( "알림", "추가신청한도를 입력해주세요." )
		Exit Sub
	End If
	
	g_szState = "I"
	DATAMANAGER.RequestTranData( "obtrc_limt_007a" ) '총한도증액신청
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
	
	If szTranID == "obtrc_limt_006r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 	, 0 , cmbAcct.total	) '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 	, 0 , cmbAcct.sequence ) '계좌일련번호	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" 		, 0 , szACNT_PWD 		) '비밀번호	
		
	'CFD고객한도조회
	ElseIf szTranID == "obtrc_limt_012r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"	, 0 , "1"			) '처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total	) '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence ) '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 		, 0 , "" 			) '종목코드
	
	'CFD고객별협의한도신청
	ElseIf szTranID == "obtrc_limt_007a" Then
		If g_szState == "I" Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CFD_MRKT_CLS_CODE" , 0 , "99" 		) 'CFD시장구분코드
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APLT_LIMT_AMT" 	, 0 , edtApltLimt.caption			 		) '추가신청한도
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" 		, 0 , Form.GetSharedData("&HOST_DATE", false )) '시작일자
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" 		, 0 , "99991231"	) '종료일자
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "APRV_APLT_CNTT" 	, 0 , ""			) '승인신청내용
		Else
			DIm szSrno, szCsno
			szSrno = grdList.GetCellData( "bd_Srno", g_nChoiceRow) 
			szCsno = grdList.GetCellData( "bd_Csno", g_nChoiceRow) 
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO"		, 0 , szCsno	) '고객번호
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "SRNO" 	, 0 , szSrno	) '일련번호
		End If
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"	, 0 , g_szState		) '처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total	) '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence ) '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" 			, 0 , szACNT_PWD 		) '비밀번호
		
		
	End If
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtrc_limt_006r" Then
		If tonumber(grdList.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" ))
			nRowCnt = grdList.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1		
				Dim szAprvYN, szDelYN
				szAprvYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "APRV_YN" , i)
				szDelYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "DEL_YN" 	, i)
				
				grdList.SetCellData( "bd_Del",  i, "해지" )	'해지버튼 Caption 설정
				If szDelYN == "Y" Then
					grdList.SetCellEnable( "bd_Del", nRowCnt + i, false )
					grdList.SetCellFgColor( "bd_Del", nRowCnt + i, "100" )
					grdList.SetCellData( "bd_DelYN", nRowCnt + i , "해지")	' 해지여부
				ElseIf szDelYN == "N" Then
					grdList.SetCellData( "bd_DelYN", nRowCnt + i , "정상")	' 해지여부
				End If
				
				'정상이여도 승인일 경우에만 해지버튼 활성화
				If szAprvYN == "Y" Then
					grdList.SetCellData( "bd_AprvYN", nRowCnt + i , "승인")	' 승인여부
				ElseIf szAprvYN == "N" Then
					grdList.SetCellEnable( "bd_Del", nRowCnt + i, false )
					grdList.SetCellFgColor( "bd_Del", nRowCnt + i, "100" )
					grdList.SetCellData( "bd_AprvYN", nRowCnt + i , "승인대기")	' 승인여부
				ElseIf szAprvYN == "C" Then
					grdList.SetCellEnable( "bd_Del", nRowCnt + i, false )
					grdList.SetCellFgColor( "bd_Del", nRowCnt + i, "100" )
					grdList.SetCellData( "bd_AprvYN", nRowCnt + i , "반려")	' 승인여부
				End If
				
			Next
	    End If
	
		If tblState.GetCellString( 9 , 1 ) == "" or tblState.GetCellString( 9 , 1 ) == null Then
			Dim szAprvClsCd
			szAprvClsCd = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APRV_CLS_CODE" 	, i)	'신청상태
			If szAprvClsCd == "01" Then
				tblState.SetCellString( 9 , 1, "1차승인대기")
			ElseIf szAprvClsCd == "02" Then
				tblState.SetCellString( 9 , 1, "1차승인")
			ElseIf szAprvClsCd == "03" Then
				tblState.SetCellString( 9 , 1, "2차승인")
			ElseIf szAprvClsCd == "04" Then
				tblState.SetCellString( 9 , 1, "승인완료(3차승인)")	
			ElseIf szAprvClsCd == "00" Then
				tblState.SetCellString( 9 , 1, "승인건 미존재")	
			End If
			
			DATAMANAGER.RequestTranData( "obtrc_limt_012r" ) 'CFD고객한도조회
		End If
		
		
	'CFD고객한도조회
	ElseIf szTranID == "obtrc_limt_012r" Then
		'총한도 SET
		Dim nBascLimtAmt, nCustSplmLimtAmt, nTotalLimt
		nBascLimtAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CUST_BASC_LIMT_AMT" , 0 )) '고객기본한도금액
		nCustSplmLimtAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CUST_SPLM_LIMT_AMT" , 0 )) '고객추가한도금액
		nTotalLimt = nBascLimtAmt + nCustSplmLimtAmt
		
		tblState.SetCellString( 0 , 1, nTotalLimt )	'총한도
		
		'총소진한도 SET
		Dim nRmndStndExhsAmt, nNcntExhsAmt, nTotalExhsAmt
		nRmndStndExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RMND_STND_EXHS_AMT" , 0 )) '잔고기준소진금액
		nNcntExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "NCNT_EXHS_AMT" , 0 )) '미체결소진금액
		nTotalExhsAmt = nRmndStndExhsAmt + nNcntExhsAmt
		
		tblState.SetCellString( 4 , 1, nTotalExhsAmt )	'총소진한도
		
	'CFD고객한도조회
	ElseIf szTranID == "obtrc_limt_007a" Then
		If g_szState == "I" Then
			Form.ShowAlert( "알림", "신청 완료되었습니다.")
		Else
			Form.ShowAlert( "알림", "해지 완료되었습니다.")
		End If
	
		f_ClearData()
		DATAMANAGER.RequestTranData( "obtrc_limt_006r" ) 
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub




