Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then
		'Form.OpenPopupAnimation("mbonl82080_p2" , "" , "" , "2")
		Form.OpenPopup("mbonl82080_p2" , "", "")
	end if
End Sub

