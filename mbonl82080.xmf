			contBody.lblInfo1.top = 187+16
			contBody.lblInfo2.top = 187+16
			contBody.lblInfo3.top = 187+16+16
			contBody.lblInfo4.top = 187+16+16
			contBody.lblInfo5.top = 187+16+16+16
			contBody.lblInfo6.top = 187+16+16+16+25
			contBody.lblInfo7.top = 187+16+16+16+25+16
			
			contBody.Label1.top = 226
			contBody.Label2.top = 242
			'contBody.lblInfo1.top = 373-169
			'contBody.lblInfo2.top = 391-169
			
			contBody.cont2.lblDate.caption = szDate
			
			
			'LHR수정
			'btnOK.visible = "0"
		     btnOK.visible = "1"
		     btnOK.caption = "재등록 하기"
		    
		else
			contBody.cont2.visible = "0"
			contBody.cont1.left = 0
			contBody.cont1.visible = "1"
			contBody.lblLine.top = 314
			'contBody.tblInfo.top = 355
			contBody.lblInfo0.top = 315
			contBody.lblInfo1.top = 315+16
			contBody.lblInfo2.top = 315+16
			contBody.lblInfo3.top = 315+16+16
			contBody.lblInfo4.top = 315+16+16
			contBody.lblInfo5.top = 315+16+16+16
			contBody.lblInfo6.top = 315+16+16+16+25
			contBody.lblInfo7.top = 315+16+16+16+25+16
		
			contBody.Label1.top = 354
			contBody.Label2.top = 370
			'contBody.lblInfo1.top = 373
			'contBody.lblInfo2.top = 391
			
			btnOK.visible = "1"
			btnOK.caption = "등록하기"
		
		end if
		
		contBody.SetScrollAutoSize()
		
		'계좌일련번호 조회
		DATAMANAGER.RequestTranData("obacp_opop_065r")

	'계좌일련번호 조회
	ElseIf szTranID == "obacp_opop_065r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" )
		
		If nCnt > 0 Then
			Dim szACNT_STAT_CODE, szPRCD
			szACNT_STAT_CODE = ""
			szPRCD = ""
			For i = 0 To nCnt-1 
				szACNT_STAT_CODE 	= DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "ACNT_STAT_CODE" 	, i )
				szPRCD 			= DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "PRCD" 				, i )
				
				If szACNT_STAT_CODE == "1" and szPRCD == "100" or szPRCD == "105" or szPRCD == "106" or szPRCD == "107" or szPRCD == "117" or szPRCD == "119" then
					lblASNO.caption = DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1"	, "ASNO" 	, i )
					Exit For
				Else
					lblASNO.caption = DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1"	, "ASNO" 	, 0 )
				End If
			Next
		End If
		
	'사전교육/모의거래 이수등록
	ElseIf szTranID == "oblon_basc_705a" Then
		Dim szSendData
		Dim szAct
		Dim szToday
		Dim szNumber
		'LHR 수정
		szAct = acntList.total
		szToday = trim(Form.GetSharedData( "&HOST_DATE", false ))		
		szNumber = trim(contBody.cont1.edtNumber.caption)
		
		szSendData = szAct&"★"&szToday&"★"&szNumber '신청계좌, 신청일, 이수번호
		
		Form.OpenPopup("mbonl82080_p1" , szSendData , "")
		
		f_ClearData()
		lblASNO.caption = ""
		'사전교육/모의거래 이수등록 조회
		DATAMANAGER.RequestTranData("oblon_basc_705r")
		
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> NULL and szSubMsg <> "" Then
		Form.ShowAlert( "알림", szErrMsg & "\n" & szSubMsg)
	Else
		Form.ShowAlert( "알림", szErrMsg )
	End If
End Sub


