'--===========================================================================
' 01. 화 면 명 : 대주위험고지등록
' 02. 화면설명 : 대주위험고지등록
' 03. 작    성 : 2021.11.22 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szIqry_YN		'정보조회여부
Dim g_szUi_cmco_yn	'UI 이수여부(ui_cmco_yn) X.미존재 Y.이수완료(정상승인) N.이수이력존재(취소또는승인중)
Dim g_szCncl_yn		'취소여부
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	g_szIqry_YN = "N"
	g_szUi_cmco_yn = ""
	g_szCncl_yn = ""
	
	contBody.cont2.lblState1.caption = ""
	contBody.cont2.lblState2.caption = ""
	contBody.cont2.lblDate.caption = ""
'	contBody.cont2.imgStateBg1.visible = "0"
'	contBody.cont2.imgStateBg2.visible = "0"
	contBody.cont2.lblState1.fgcolor = "4"
	contBody.cont2.lblState2.fgcolor = "4"
		
	contBody.cont1.edtNumber.caption = ""
	contBody.cont1.edtID.caption = ""
	contBody.cont1.edtKey.caption = ""
		
	'실행버튼 비활성화 (정보조회후 활성화처리)
	btnOK.enable = False
End Function

'============================================================================
' f_ChkData() : 처리입력값 체크
'============================================================================
Function f_ChkData()

	'선조회여부 체크
	If g_szIqry_YN <> "Y" Then
		Form.ShowAlert("알림", "이수정보 조회 후 등록 가능")
		return false
	End If
	
	'승인관련 체크
	'이수여부(ui_cmco_yn) X.미존재 Y.이수완료(정상승인) N.이수이력존재(취소또는승인중)
	If g_szUi_cmco_yn == "N" Then
	    If g_szCncl_yn <> "Y" Then
			Form.ShowAlert("안내", "사전교육/모의거래 등록정보가 접수되어 확인중에 있습니다.\n".."재등록(변경)을 원하시는 고객께서는 해당 관리지점 및 컨택센터(1588-3400)으로 문의 바랍니다.")
			return false
		End If		
	End If
	
	'입력값 체크
	If Trim(contBody.cont1.edtNumber.caption) = "" Then
		Form.ShowAlert("알림", "교육이수번호를 입력하세요.")
		return false
	End If
'	If Trim(contBody.cont1.edtID.caption) = "" Then
'		Form.ShowAlert("알림", "모의거래 고객ID를 입력하세요.")
'		return false
'	End If
'	If Trim(contBody.cont1.edtKey.caption) = "" Then
'		Form.ShowAlert("알림", "모의거래 인증키를 입력하세요.")
'		return false
'	End If

	If Len(Trim(contBody.cont1.edtNumber.caption)) < 14 Then
		Form.ShowAlert("알림", "교육이수번호를 확인해 주세요.(14자리)")
		return false
	End If
	
	If Len(Trim(contBody.cont1.edtKey.caption)) < 13 Then
		Form.ShowAlert("알림", "모의거래 인증키를 확인해 주세요.(13자리)")
		return false
	End If

	'ASCII 코드 : 48~57:0~9/ 65~90:A~Z/ 97~122:a~z, '''''95:언더바(_)
	Dim nAscii, szChkErrYN	
	szChkErrYN = ""
	For i = 1 to Len(contBody.cont1.edtNumber.caption)
		nAscii = Asc(Mid(contBody.cont1.edtNumber.caption, i, 1))	
		If (nAscii < 48) or (nAscii > 57  and nAscii < 65) or (nAscii > 90 and nAscii < 97) or (nAscii > 122) Then
			szChkErrYN = "Y"
		End If
	Next
	If szChkErrYN = "Y" Then	
		Form.ShowAlert("알림", "교육이수번호는 영문/숫자만 가능합니다.")
		return false
	End If
	
	return true
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	f_ClearData()
	edtPswd.caption = ""
	lblASNO.caption = ""
	
	'LHR TEST
	'contBody.tblInfo.visible = false
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
	
	DATAMANAGER.RequestTranData("oblon_basc_705r")
	
	'LHR 수정
	contBody.cont1.edtNumber.SetOnOffImage("alpha", "alpha")
	contBody.cont1.edtID.SetOnOffImage("alpha", "alpha")
	contBody.cont1.edtKey.SetOnOffImage("alpha", "alpha")
	
	contBody.lblInfo1.changeTextAttr(1, 23, 293, -2, 0)
	contBody.lblInfo3.changeTextAttr(1, 21, 293, -2, 0)
	
	contBody.Label1.bgcolor = 293
	contBody.Label2.bgcolor = 293
	
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	edtPswd.caption = ""	
	lblASNO.caption = ""
	
	DATAMANAGER.RequestTranData("oblon_basc_705r")
End Sub


'============================================================================
' Form_OnMsgBoxClose() : 등록 확인
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Register" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData("oblon_basc_705a")
		end if
	end if
End Sub

Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			if UBOUND(tPwd) > 0 then
				edtPswd.pwdlen = tPwd(1)
				edtPswd.caption = tPwd(0)
			end if
			
'			Form.ShowAlert(sRet, trim(edtPswd.caption))
			If g_szUi_cmco_yn = "Y" Then
				Form.MsgBox("안내", "사전교육/모의거래 이수정보를 등록 하시겠습니까?\n".."확인 선택시 기 등록된 교육이수정보는 자동 취소됩니다.",  "Register", 2)
			Else
				DATAMANAGER.RequestTranData("oblon_basc_705a")
			End If
		end if
	end if
End Sub

'============================================================================
' acntList_ChangeAccount() : 다른 계좌로 변경 되었을때 초기화
'============================================================================
Sub acntList_ChangeAccount()
	f_ClearData()
	edtPswd.caption = ""
	lblASNO.caption = ""
	
	DATAMANAGER.RequestTranData("oblon_basc_705r")
End Sub


'============================================================================
Sub edtPswd_OnClick()
	if trim(edtPswd.caption) == "" or trim(edtPswd.caption) == nil then
		Form.openPopupAnimation("pwdcheckpopup", acntList.total&lblASNO.caption&"☆2", "", "2")
	end if
End Sub


'============================================================================
' btnOK_OnClick() : 대주 위험고지 확인
'============================================================================
Sub btnOK_OnClick()
	'LHR 수정 g_szUi_cmco_yn == "Y"
	If (g_szUi_cmco_yn == "N" and g_szCncl_yn == "Y") or g_szUi_cmco_yn == "Y" Then
		contBody.cont2.visible = "0"
		contBody.cont1.visible = "1"
		contBody.cont1.left = 0
		contBody.cont1.visible = "1"
		contBody.lblLine.top = 314
		'contBody.tblInfo.top = 355
		contBody.lblInfo0.top = 315
		contBody.lblInfo1.top = 315+16
		contBody.lblInfo2.top = 315+16
		contBody.lblInfo3.top = 315+16+16
		contBody.lblInfo4.top = 315+16+16
		contBody.lblInfo5.top = 315+16+16+16
		contBody.lblInfo6.top = 315+16+16+16+25
		contBody.lblInfo7.top = 315+16+16+16+25+16
		
		contBody.Label1.top = 354
		contBody.Label2.top = 370
		
		btnOK.caption = "등록하기"
		
		contBody.SetScrollAutoSize()
		
		f_ClearData()
		'LHR 수정
		btnOK.enable = True
		g_szIqry_YN = "Y"
		
		g_szUi_cmco_yn = ""
		g_szCncl_yn = ""

	else
		'처리 체크
		If f_ChkData() == false Then
			Exit Sub
		End If
			
		Dim szACNT_PWD 
		szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )
		
		If szACNT_PWD == null or szACNT_PWD == "" Then
			'계좌 비밀번호 팝업 호출
			Form.openPopupAnimation("pwdcheckpopup", acntList.total&lblASNO.caption&"☆2", "", "2")			
		else	
			If g_szUi_cmco_yn = "Y" Then
				Form.MsgBox("안내", "사전교육/모의거래 이수정보를 등록 하시겠습니까?\n".."확인 선택시 기 등록된 교육이수정보는 자동 취소됩니다.",  "Register", 2)
			Else
				DATAMANAGER.RequestTranData("oblon_basc_705a")
			End If
			
		end if
		
	end if
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
	
	'사전교육/모의거래 이수등록 조회
	If szTranID == "oblon_basc_705r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"          , 0 , acntList.total	)	'Left(acntList.caption, 8)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      , 0 , szACNT_PWD		)
	
	'사전교육/모의거래 이수등록
	ElseIf szTranID == "oblon_basc_705a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE"      , 0 , "I" 				)	'처리구분 (I:등록, D:삭제)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE"      , 0 , "4"				)	'접촉구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"         	 	, 0 , acntList.total		)	'Left(acntList.caption, 8)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      		, 0 , szACNT_PWD			)	'비밀번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"          		, 0 , lblASNO.caption		)	'Right(acntList.caption, 2)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "EDCT_CMCO_NO" 		, 0 , contBody.cont1.edtNumber.caption	)	'교육이수번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "MOCK_TR_CUST_ID" 	, 0 , contBody.cont1.edtID.caption	)	'모의거래고객ID
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ATHN_UNIQ_NO"  		, 0 , contBody.cont1.edtKey.caption	)	'인증고유번호

	'계좌일련번호 조회
	ElseIf szTranID == "obacp_opop_065r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"         	 	, 0 , acntList.total		)	'Left(acntList.caption, 8)
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'사전교육/모의거래 이수등록 조회
	If szTranID == "oblon_basc_705r" Then
		g_szIqry_YN = "Y"
		btnOK.enable = True
		
		g_szUi_cmco_yn 	= DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "UI_CMCO_YN" 		, 0 )
		g_szCncl_yn		= DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "CNCL_YN" 			, 0 )
		
		Dim szDate 
		szDate = DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "REG_DATE" 			, 0 )
'		szDate = Replace( szDate, "-","" )
'		Form.ShowAlert("szDate", trim(szDate))
		
		'승인관련 체크
		'이수여부(ui_cmco_yn) X.미존재 Y.이수완료(정상승인) N.이수이력존재(취소또는승인중)		
		If g_szUi_cmco_yn == "N" Then
		    If g_szCncl_yn <> "Y" Then
			    contBody.cont2.lblState1.caption = "승인대기"
			    contBody.cont2.lblState2.caption = "승인대기"
			    contBody.cont2.lblState1.fgcolor = "291"
			    contBody.cont2.lblState2.fgcolor = "291"
'			    contBody.cont2.imgStateBg1.imgpath = "input_03_e.9"
'			    contBody.cont2.imgStateBg2.imgpath = "input_03_e.9"
'			    contBody.cont2.imgStateBg1.visible = "1"
'			    contBody.cont2.imgStateBg2.visible = "1"
			    
			    btnOK.visible = "0"
			    
			else
				contBody.cont2.lblState1.caption = "승인거부"
			    contBody.cont2.lblState2.caption = "승인거부"
			    contBody.cont2.lblState1.fgcolor = "290"
			    contBody.cont2.lblState2.fgcolor = "290"
'			    contBody.cont2.imgStateBg1.visible = "0"
'			    contBody.cont2.imgStateBg2.visible = "0"
			    
			    btnOK.visible = "1"
			    btnOK.caption = "재등록 하기"
		    end if
		    
		    contBody.cont2.visible = "1"
			contBody.cont1.visible = "0"
			contBody.cont1.left = 400
			contBody.lblLine.top = 166
			'contBody.tblInfo.top = 187
			contBody.lblInfo0.top = 187
			contBody.lblInfo1.top = 187+16
			contBody.lblInfo2.top = 187+16
			contBody.lblInfo3.top = 187+16+16
			contBody.lblInfo4.top = 187+16+16
			contBody.lblInfo5.top = 187+16+16+16
			contBody.lblInfo6.top = 187+16+16+16+25
			contBody.lblInfo7.top = 187+16+16+16+25+16
			
			contBody.Label1.top = 226
			contBody.Label2.top = 242
			'contBody.lblInfo1.top = 373-169
			'contBody.lblInfo2.top = 391-169
			
			contBody.cont2.lblDate.caption = szDate
		    
		elseif g_szUi_cmco_yn == "Y" then
			contBody.cont2.lblState1.caption = "승인"
		    contBody.cont2.lblState2.caption = "승인"
		    contBody.cont2.lblState1.fgcolor = "4"
			contBody.cont2.lblState2.fgcolor = "4"
'		    contBody.cont2.imgStateBg1.imgpath = "input_03_n.9"
'		    contBody.cont2.imgStateBg2.imgpath = "input_03_n.9"
'		    contBody.cont2.imgStateBg1.visible = "1"
'		    contBody.cont2.imgStateBg2.visible = "1"
		     contBody.cont2.visible = "1"
			contBody.cont1.visible = "0"
			contBody.cont1.left = 400
			contBody.lblLine.top = 166
			'contBody.tblInfo.top = 187
