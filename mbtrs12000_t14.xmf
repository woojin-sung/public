		<LABEL name="lblNodata" visible="0" fgcolor="321:115118124" fontsize="-2" caption="조회 내역이 없어요." halign="1" valign="0" multiline="1" ly_vert="0,200,375,57,0" />
		<LABEL name="lblcmb" fontsize="-2" caption="전체" halign="2" click="1" ly_vert="265,5,75,34,1" />
		<IMAGE name="Image0" autosize="1" imgpath="icon_gray_down" ly_vert="340,9,25,25,1" />
