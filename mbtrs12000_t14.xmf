	<SCRIPT_INFO _len="12111" _ulen="10987" >
'--===========================================================================
'--===========================================================================
Dim g_szGbnCode			' 매매구분코드(0:전체, 1:매도, 2:매수)
Dim g_szTradeGbnCode		' 체결구분코드(0:전체, 1:체결, 2:미체결)
g_szGbnCode = 0
g_szTradeGbnCode = 0
'============================================================================
Sub Form_OnFormInit()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "체결")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "미체결")
	FormTab0.currenttab = 0
	'20230710 htw start 종목명 멀티라인 설정
	Grid0.SetCellMaxLineCount("bd_cell12", 2)
	'20230710 htw end 종목명 멀티라인 설정
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHNAGE_TAB" then
		f_Reset()
	elseif sEventName == "ACNT_CHANGE" then
		f_Reset()
	end if
End Sub

Sub f_Reset()
	Grid0.rowcount = 0
'	g_szGbnCode = "0"		' 매매구분코드(0:전체, 1:매도, 2:매수)
'	g_szTradeGbnCode = "0"	' 체결구분코드(0:전체, 1:체결, 2:미체결)
'	FormTab0.currenttab = 0
'	Combo0.currentindex = 0
	
	f_SendTR()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtrs_cntg_638r" then
		Dim szDate
		szDate = Form.GetSharedData("&BIZ_DT", false)
		DATAMANAGER.ClearInputData(0, "obtrs_cntg_638r")
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ACNO"			, 0 , Form.GetCtlProp("#acnt", "total") )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ASNO"			, 0 , Form.GetCtlProp("#acnt", "sequence") )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ODER_DATE"		, 0 , szDate )'당일만 조회
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "DEAL_CLS_CODE"	, 0 , g_szTradeGbnCode)		' 매매구분코드(0:전체, 1:매도, 2:매수)
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "CNTG_CLS_CODE"	, 0 , g_szGbnCode)			' 체결구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "PROS_CLS"		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "DATA_CLS"		, 0 , "0" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtrs_cntg_638r" then
		Dim szDate, nCnt
		nCnt = DATAMANAGER.GetDataCount( false, szTranID , "OutBlock1" )
		for i = 0 to nCnt - 1
			szDate = DATAMANAGER.GetDataValue( false, "obtrs_cntg_638r", "OutBlock1", "LOAN_DATE" , i )
			szDate = right(szDate,6)
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_638r", "OutBlock1", "LOAN_DATE" , i , szDate )
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrs_cntg_638r" then
		Dim szItem, szMarket   
		if CInt(Grid0.rowcount) == 0 then
			imgNodata.visible = true
			lblNodata.visible = true
		else
			imgNodata.visible = false
			lblNodata.visible = false
		end if
		For iCnt = Grid0.rowcount - 1 To 0 Step -1
			szItem = Grid0.GetCellData( "bd_cell0", iCnt)
			szMarket = Form.GetItemCodeInfo(szItem, "market")
			
			If szMarket = "BN" Or szMarket = "MM" Then
				Grid0.SetDeleteRow( iCnt )
			Else
			
				'매매구분
				szData	= Grid0.GetCellData( "bd_cell2", iCnt)		'매수/매도구분(1매도, 2매수)
				szData2	= Grid0.GetCellData( "bd_cell1", iCnt)		'정정/취소구분(1신규,2정정, 3취소)
				szData3	= Grid0.GetCellData( "bd_cell20", iCnt)		'신용주문구분코드
				szData4	= Grid0.GetCellData( "bd_cell21", iCnt) 		'대출상세유형코드
				'==============================
				'20230615 htw start 구분 data 변경
	'			01현금 02대출 03신용 04대주 05대여 06대용 07재활용 99기타			
				szGbn = Grid0.GetCellData("bd_cell11",iCnt)'주식잔고구분코드
				
				Select Case szGbn
					Case "01"
						Grid0.SetCellData("bd_Name", iCnt, "현금")
					Case "02"
						Grid0.SetCellData("bd_Name", iCnt, "대출")	
					Case "03"
						Grid0.SetCellData("bd_Name", iCnt, "신용")
					Case "04"
						Grid0.SetCellData("bd_Name", iCnt, "대주")
					Case "05"
						Grid0.SetCellData("bd_Name", iCnt, "대여")
					Case "06"
						Grid0.SetCellData("bd_Name", iCnt, "대용")
					Case "07"
						Grid0.SetCellData("bd_Name", iCnt, "재활용")
					Case "99"
						Grid0.SetCellData("bd_Name", iCnt, "기타")
				end Select
				'20230615 htw end 구분 data 변경
				'==============================
				If szData2 = "1" Then									'정상
					Select Case szData3				'보통
						Case "10"
							If szData = "1" Then
								If szData4 = "0201" Then
									Grid0.SetCellData("bd_cell3", iCnt, "예탁담보매도")
								Else
									Grid0.SetCellData("bd_cell3", iCnt, "매도")
								End If
								Grid0.SetCellFgColor("bd_cell3", iCnt, "11")
							Else
								Grid0.SetCellData("bd_cell3", iCnt, "매수")
								Grid0.SetCellFgColor("bd_cell3", iCnt, "10")
							End If
						
						Case "21", "31"								'신용매수
							Grid0.SetCellData("bd_cell3", iCnt, "신용매수")
							Grid0.SetCellFgColor("bd_cell3", iCnt, "10")
						
						Case "22", "32"								'신용매도
							Grid0.SetCellData("bd_cell3", iCnt, "신용매도")
							Grid0.SetCellFgColor("bd_cell3", iCnt, "11")
						
						Case "23", "33"								'대주매도
							Grid0.SetCellData("bd_cell3", iCnt, "대주매도")
							Grid0.SetCellFgColor("bd_cell3", iCnt, "11")
		
						Case "24", "34"								'대주매수
							Grid0.SetCellData("bd_cell3", iCnt, "대주매수")
							Grid0.SetCellFgColor("bd_cell3", iCnt, "10")
						
					End Select
				ElseIf szData2 = "2" Then								'정정
					If szData = "1" Then
						Grid0.SetCellData("bd_cell3", iCnt, "매도정정")
						Grid0.SetCellFgColor("bd_cell3", iCnt, "11")
					Else
						Grid0.SetCellData("bd_cell3", iCnt, "매수정정")
						Grid0.SetCellFgColor("bd_cell3", iCnt, "10")
					End If
					
				ElseIf szData2 = "3" Then								'취소
					If szData = "1" Then
						Grid0.SetCellData("bd_cell3", iCnt, "매도취소")
						Grid0.SetCellFgColor("bd_cell3", iCnt, "11")
					Else
						Grid0.SetCellData("bd_cell3", iCnt, "매수취소")
						Grid0.SetCellFgColor("bd_cell3", iCnt, "10")
						
					End If
				End If
			end if
			
			Dim szReturnValue
			
			Select Case szData4
				Case "0000" szReturnValue = "보통"
				Case "0101" szReturnValue = "자기융자"
				Case "0102" szReturnValue = "유통융자"
				Case "0103" szReturnValue = "자기대주"
				Case "0104" szReturnValue = "유통대주"
				Case "0201" szReturnValue = "예탁주식"
				Case "0202" szReturnValue = "예탁채권"
				Case "0203" szReturnValue = "예탁집합투자"
				Case "0204" szReturnValue = "예탁장외파생"
				Case "0211" szReturnValue = "예탁유통주식"
				Case "0212" szReturnValue = "예탁유통채권"
				Case "0213" szReturnValue = "예탁유통집합투자"
				Case "0214" szReturnValue = "예탁유통장외파생"
				Case "0301" szReturnValue = "매도증권담보대출"
				Case "0302" szReturnValue = "수익증권환매"
				Case "0303" szReturnValue = "ELS환매자금대출"
				Case "0401" szReturnValue = "소액주식"
				Case "0402" szReturnValue = "소액채권"
				Case "0403" szReturnValue = "소액수익증권"
				Case "0404" szReturnValue = "소액 ELS"
				Case "0501" szReturnValue = "공모주청약"
				Case "0502" szReturnValue = "ELS청약"
				Case "0503" szReturnValue = "주식매입"
				Case "0601" szReturnValue = "매입자금대출"
				Case "0701" szReturnValue = "초단기대출"
				Case "0801" szReturnValue = "CMA담보대출"
				Case "9201" szReturnValue = "대출(대여)" 'v003
				Case "8201" szReturnValue = "양도담보" 'v004
				Case Else   szReturnValue = szData4
			End Select
			
			Grid0.SetCellData("bd_ProcCd", iCnt, szReturnValue)
			
			szData = Grid0.GetCellData( "bd_cell9", iCnt)
			Select Case szData
				Case "0" Grid0.SetCellData("bd_cell17", iCnt, "미접수")
				Case "1" Grid0.SetCellData("bd_cell17", iCnt, "접수")
				Case "2" Grid0.SetCellData("bd_cell17", iCnt, "확인")
				Case "3" Grid0.SetCellData("bd_cell17", iCnt, "거부")
				Case "4" Grid0.SetCellData("bd_cell17", iCnt, "PT효력정지")
				Case Else Grid0.SetCellData("bd_cell17", iCnt, szData)
			End Select
		next
		
		if CInt(g_szGbnCode) == 2 and CInt(Grid0.rowcount) > 0 then
			if CInt(Grid0.rowcount) < 5 then
				Grid0.height = 45 + CInt(Grid0.rowcount) * 64
				lblAllCancel.top = 44 + 45 + CInt(Grid0.rowcount) * 64
			else
				Grid0.height = 336
				lblAllCancel.top  = 380
			end if
			lblAllCancel.visible = true
		else
			Grid0.height = 366
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg, szTranMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	lblcmb.caption = Combo0.caption
	if nCurrentTab == 1 then
		g_szTradeGbnCode = "2"	' 체결구분코드(0:전체, 1:체결, 2:미체결)
	elseif nCurrentTab == 2 then
		g_szTradeGbnCode = "1"
	else
		g_szTradeGbnCode = CStr(nCurrentTab)	' 체결구분코드(0:전체, 1:체결, 2:미체결)
	end if

	if iIndex == 0 then
		g_szTradeGbnCode = "0"
	elseif iIndex == 1 then
		g_szTradeGbnCode = "2"
	elseif iIndex == 2 then
		g_szTradeGbnCode = "1"
	end if
	
	f_SendTR()
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	g_szGbnCode = nCurrentTab			' 체결구분코드(0:전체, 1:체결, 2:미체결)
	f_SendTR()
End Sub

Sub f_SendTR()
	Grid0.rowcount = 0
	lblAllCancel.visible = false
	DATAMANAGER.RequestTranData("obtrs_cntg_638r")
end sub 


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	'미체결인 item인 경우 정정/취소 탭 이동 및 해당 item 종목으로 조회,해당 호가로 화면 data 셋팅
	if CInt(FormTab0.currenttab) == 2 then
		'종목코드★주문번호★호가★미체결수량
		
		Dim szParam
		szParam = Grid0.GetCellData("bd_cell0", lRow)					'종목코드
		szParam = szParam .."★".. Grid0.GetCellData("bd_cell16", lRow)	'주문번호
		szParam = szParam .."★".. Grid0.GetCellData("bd_cell4", lRow)	'주문가격
		szParam = szParam .."★".. Grid0.GetCellData("bd_cell6", lRow)	'미체결수량
		
		Form.triggerEvent("#", "SEND_MOD", szParam)
	end if
End Sub

'============================================================================
Sub lblAllCancel_OnClick()
	'전체취소
	'주문번호
	Form.triggerEvent("#", "SEND_ALL_CANCEL", "")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgNodata.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub lblcmb_OnClick()
	Combo0.openlist()
End Sub

'============================================================================
Sub Image0_OnClick()
	Combo0.openlist()
End Sub

