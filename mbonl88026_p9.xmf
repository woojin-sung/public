	<SCRIPT_INFO _len="4316" _ulen="4114" >
'============================================================================
' 2021-07-14 KSJ : 목표시장 불일치 안내 팝업
'============================================================================

'전역변수 설정
Dim g_szRet				' Return 값
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_SetDialog() : 목표시장 일치여부에 따른 팝업 셋팅
'============================================================================
Function f_SetDialog(szOpenData)
	'(Y.목표시장부적합 N.정상)
	if szOpenData == "N" Then
		imgState.imgpath = "icon_ok.png"
		lblState.caption = "일치"
		lblState.fgcolor = "2"
		
		contNo.visible = False
		btnNoCancel.visible = False
		btnNoNext.visible = False
		btnNext.visible = True
	Else
		imgState.imgpath = "icon_error.png"	
		lblState.caption = "불일치"
		lblState.fgcolor = "1"
		
		contNo.visible = True
		btnNoCancel.visible = True
		btnNoNext.visible = True
		btnNext.visible = False
		
		imgMbg.height = 433
	End If
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()
	g_szRet = "no"
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData ~= null and szOpenData ~= "" Then
		f_SetDialog(szOpenData)
	End If
	
	btnNoCancel.fgcolor = 269
	imgBg.imgpath = "alpha128.png"
	
	btnNoNext.enable = false
End Sub
'============================================================================
'Form_OnFormBackKeyPressed() : 닫기 
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Form.CloseForm()
End Sub
'============================================================================
' imgBg_OnClick() : 닫기
'============================================================================
'Sub imgBg_OnClick()
'	Form.CloseForm()
'End Sub
'============================================================================
' imgClose_OnClick() : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' btnNoCancel_OnClick() : 목표시장 불일치 > 중단하기
'============================================================================
Sub btnNoCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnNoNext_OnClick() : 목표시장 불일치 > 진행하기
'============================================================================
Sub btnNoNext_OnClick()
	If contNo.ChkAgree.checkstate == 0 or contNo.ChkAgree.checkstate == "0" Then
		Form.ShowAlert("알림", "안내사항을 확인해주세요.")
		Exit Sub
	End If 
	g_szRet = "ok"
	Form.CloseForm()
End Sub
'============================================================================
' btnNext_OnClick() : 목표시장 일치 
'============================================================================
Sub btnNext_OnClick()
	g_szRet = "ok"
	Form.CloseForm()	
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("close_mbonl88026_p9" , g_szRet)	'MBBDM85130_P8_end
End Sub

'============================================================================
Sub contNo_ChkAgree_OnChange(sCheckState)
	If sCheckState = "1" or sCheckState = 1 then
	'if contNo.ChkAgree.checkstate = "1" or contNo.ChkAgree.checkstate = 1 then
		btnNoNext.enable = true
	else
		btnNoNext.enable = false
	End If 	
End Sub

