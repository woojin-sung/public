'============================================================================
Function f_isEnbleProc()
	if g_bCheckPdf == true and
		CInt(ContainerMain.contain1.ChkButton0.checkstate) == 1 and
		CInt(ContainerMain.contain1.ChkButton1.checkstate) == 1 and
		CInt(ContainerMain.contain2.ChkButton2.checkstate) == 1 and
		CInt(ContainerMain.contain2.ChkButton3.checkstate) == 1 and
		CInt(ContainerMain.contain3.ChkButton4.checkstate) == 1 and
		CInt(ContainerMain.contain3.ChkButton5.checkstate) == 1 then
		
		if g_bCheckPdf == true then
			ContainerMain.btnReg.enable = true
		else
			Form.OpenPopup("mbbdm85131_p1", "Mndt", "")
		end if
	else
		ContainerMain.btnReg.enable = false
	end if
End Function

'============================================================================
Sub Form_OnFormInitBefore()
	szLinkedData = Form.GetOpenLinkData( )

	'계좌번호 계좌비밀번호 
	g_szList = Split(szLinkedData,"★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
		
	gAcno          = ""
	gAsno          = ""
	gAcntPwd		 = ""
	
	gAcno          = g_szList(0)
	gAsno          = g_szList(1)	
	gAcntPwd       = g_szList(2)
	
	'g_szImgUnCheck = "product_check_on.png"
	'g_szImgCheck = "product_check_off.png"
	g_szImgUnCheck = "icon_chk_on.png"
	g_szImgCheck = "icon_chk_off.png"
	g_szFgUnCheck = "127"
	g_szFgCheck = "4"
	g_bCheckPdf = false
	g_bAgree = false
	
	'초기화
	gAgrm11	= ""
	gAgrm12	= ""
	gAgrm111	= ""
	gAgrm112	= ""
	gAgrm121	= ""
	gAgrm122	= ""
	gAgrm123	= ""
	gAgrm131	= ""
	gAgrm132	= ""
	gAgrm21	= ""
	gAgrm22	= ""
	gAgrm211	= ""
	gAgrm212	= ""
	gAgrm31	= ""
	gAgrm32	= ""
'	gAgrmSlctYn1 = ""
'	gAgrmSlctYn2 = ""
'	gAgrmSlctYn3 = ""
'	gAgrmPbltTlphYn = ""
'	gAgrmPbltSmsYn = ""
'	gAgrmPbltEmailYn = ""
'	gAgrmPrmlRcmsYn = ""	
End Sub

'============================================================================
Sub Form_OnFormInit()
'	imgBG0.imgpath = "img_bgbox.9.png"
	ContainerMain.lblShowPdf.caption = "    필수동의서(요약/상세) 확인                             >"
	ContainerMain.lblShowPdf.fgcolor = "127"
	ContainerMain.lblUnderLine.bgcolor = "127"
	ContainerMain.imgUIAllChk.imgpath = "icon_chk_on.png"
	ContainerMain.contain1.lbl1.fgcolor = 265	'265(주황색) #ef3b24
	ContainerMain.contain2.lbl1.fgcolor = 265	'265(주황색) #ef3b24
	ContainerMain.contain3.lbl1.fgcolor = 265	'265(주황색) #ef3b24
	
	DATAMANAGER.RequestTranData( "obaci_acct_256r" ) '개인신용정보조회
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_bAgree == true then
		Form.SendReturnToParent("mbonl87056_p7", "ok")
	else
		Form.SendReturnToParent("mbonl87056_p7", "cancel")
	end if
End Sub

'============================================================================
Sub ContainerMain_lblShowPdf_OnClick()
	Form.OpenPopup("mbbdm85131_p1", "Mndt", "")
	
	'Form_OnPopupReturn("mbbdm85131_p1", "ok_Mndt")

End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "TR_ERR" then
		g_bAgree = false
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'약관
	if sKeyName == "mbbdm85131_p1" then
		if sRet == "ok_Mndt" then
			g_bCheckPdf = true
			ContainerMain.lblShowPdf.fgcolor = "4"
			ContainerMain.lblUnderLine.bgcolor = "4"
			ContainerMain.imgUIAllChk.imgpath = "icon_chk_off.png"
			ContainerMain.imgBG0.imgpath = "img_bg.9.png"
			'f_AllCheck()
			f_isEnbleProc()
		end if
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				
				Dim PlainRm
				PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
				If PlainRm = "1" Then
					gAcntPwd 	= edtPassword.caption
				Else
					gAcntPwd 	= Form.GetEncData(edtPassword.caption)
				End If
				DATAMANAGER.RequestTranData( "obaci_acct_256a" ) '개인신용정보등록(필수)	
			end if
		end if 
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)  
	if szTranID == "obaci_acct_256r" then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "ACNO" , 0 , gAcno )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "ASNO" , 0 , gAsno )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "ACNT_PWD" , 0 , gAcntPwd )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "IQRY_CLS_CODE" , 0 , "A" )	
	elseif szTranID == "obaci_acct_256a" then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )	'1:필수동의서
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , "3" )	'3:필수+선택
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD" , 0 , "015" )	'015 약정_해외주식
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "RQCL_OBJT_CNTT" , 0 , "약정_해외주식" )
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "ACNO" , 0 , gAcno )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "ASNO" , 0 , gAsno )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "ACNT_PWD" , 0 , gAcntPwd )
		
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock2", "UI_COMN_AGRM_YN1" , 0 , gAgrm11 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock2", "UI_COMN_AGRM_YN2" , 0 , gAgrm12 )
		
		if CInt(ContainerMain.contain1.ChkButton0.checkstate) == 1 then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock2", "UI_COMN_AGRM_YN1" , 0 , "Y" )
		end if 
		
		if CInt(ContainerMain.contain1.ChkButton1.checkstate) == 1 then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock2", "UI_COMN_AGRM_YN2" , 0 , "Y" )
		end if 		
		
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN1" , 0 , gAgrm111 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN2" , 0 , gAgrm112 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN3" , 0 , gAgrm121 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN4" , 0 , gAgrm122 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN5" , 0 , gAgrm123 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN6" , 0 , gAgrm131 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN7" , 0 , gAgrm132 )
		
		if CInt(ContainerMain.contain2.ChkButton2.checkstate) == 1 then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN6" , 0 , "Y" )
		end if		
	
		if CInt(ContainerMain.contain2.ChkButton3.checkstate) == 1 then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN7" , 0 , "Y" )
		end if
		
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN1" , 0 , gAgrm21 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN2" , 0 , gAgrm22 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN3" , 0 , gAgrm211 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN4" , 0 , gAgrm212 )
		
		if CInt(ContainerMain.contain3.ChkButton4.checkstate) == 1 then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN3" , 0 , "Y" )
		end if
	
		if CInt(ContainerMain.contain3.ChkButton5.checkstate) == 1 then
			DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN4" , 0 , "Y" )
		end if
		
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock5", "UI_COMN_AGRM_YN1" , 0 , gAgrm31 )
'		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock5", "UI_COMN_AGRM_YN2" , 0 , gAgrm32 )	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obaci_acct_256r" then
		Dim sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN
		Dim nCnt 
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2")
		for i = 0 to nCnt -1 
			sNW_AGRM_BSWR_CLCD 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "NW_AGRM_BSWR_CLCD" , i )
			sUI_CLS 			 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "NW_AGRM_BSWR_DETL_CLS_CODE" , i )
			sNW_AGRM_KIND_CLCD 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "NW_AGRM_KIND_CLCD" , i )
			sAGRM_YN 			= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "CRIN_AGRM_YN" , i )
			
			'1.필수수집이용(공통)
			if sNW_AGRM_BSWR_CLCD == "1" then
				'1.고유식별번호
				if sNW_AGRM_KIND_CLCD == "1" then
					gAgrm11 = sAGRM_YN
					if sAGRM_YN = "Y" then
						f_Check0(true)
					end if
				'2.개인신용정보
				elseif sNW_AGRM_KIND_CLCD == "2" then
					gAgrm12 = sAGRM_YN
					if sAGRM_YN = "Y" then
						f_Check1(true)
					end if
				end if
			'2.필수수집이용(상품)	
			elseif sNW_AGRM_BSWR_CLCD == "2" then
				'신용/미수/파생상품
				if sUI_CLS == "01" then
					'1.고유식별번호
					if sNW_AGRM_KIND_CLCD == "1" then
						gAgrm111 = sAGRM_YN
					'2.개인신용정보	
					elseif sNW_AGRM_KIND_CLCD == "2" then
						gAgrm112 = sAGRM_YN
					end if
				'비과세종합/ISA/연금저축	
				elseif sUI_CLS == "02" then
					'1.고유식별번호
					if sNW_AGRM_KIND_CLCD == "1" then
						gAgrm121 = sAGRM_YN
					'3.민감정보	
					elseif sNW_AGRM_KIND_CLCD == "3" then
						gAgrm122 = sAGRM_YN							
					'2.개인신용정보	
					elseif sNW_AGRM_KIND_CLCD == "2" then
						gAgrm123 = sAGRM_YN					
					end if	
				'해외주식/해외파생/외화금융상품/EUREX	
				elseif sUI_CLS == "03" then
					'1.고유식별번호
					if sNW_AGRM_KIND_CLCD == "1" then
						gAgrm131 = sAGRM_YN
						if sAGRM_YN = "Y" then							
							f_Check2(true)
						end if
					'2.개인신용정보	
					elseif sNW_AGRM_KIND_CLCD == "2" then
						gAgrm132 = sAGRM_YN
						if sAGRM_YN = "Y" then
							f_Check3(true)
						end if
					end if
				end if
			'3.필수제공(상품)	
			elseif sNW_AGRM_BSWR_CLCD == "3" then
				'신용/미수/파생상품/해외파생
				if sUI_CLS == "01" then		
					'1.고유식별번호
					if sNW_AGRM_KIND_CLCD == "1" then
						gAgrm21 = sAGRM_YN
					'2.개인신용정보	
					elseif sNW_AGRM_KIND_CLCD == "2" then
						gAgrm22 = sAGRM_YN
					end if
				'해외주식/해외파생/해외금융상품	
				elseif sUI_CLS == "02" then
					'1.고유식별번호
					if sNW_AGRM_KIND_CLCD == "1" then
						gAgrm211 = sAGRM_YN
						if sAGRM_YN = "Y" then
							f_Check4(true)
						end if
					'2.개인신용정보	
					elseif sNW_AGRM_KIND_CLCD == "2" then
						gAgrm212 = sAGRM_YN	
						if sAGRM_YN = "Y" then
							f_Check5(true)
						end if
					end if
				end if
			'4.필수조회(상품)	
			elseif sNW_AGRM_BSWR_CLCD == "4" then					
				'신용/미수/파생상품/해외파생
				if sUI_CLS == "01" then		
					'1.고유식별번호
					if sNW_AGRM_KIND_CLCD == "1" then
						gAgrm31 = sAGRM_YN
					'2.개인신용정보	
					elseif sNW_AGRM_KIND_CLCD == "2" then
						gAgrm32 = sAGRM_YN
					end if
				end if
			end if
		next
		
		'선택동의서 설정
		'gAgrmSlctYn1 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "UI_SLCT_AGRM_YN1" , 0 )
		'gAgrmSlctYn2 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "UI_SLCT_AGRM_YN2" , 0 )
		'gAgrmSlctYn3 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "UI_SLCT_AGRM_YN3" , 0 )
		'gAgrmPbltTlphYn 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "PBLT_TLPH_RCMS_YN" , 0 )
		'gAgrmPbltSmsYn 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "PBLT_SMS_RCMS_YN" , 0 )
		'gAgrmPbltEmailYn	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "PBLT_EMAIL_RCMS_YN" , 0 )
		'gAgrmPrmlRcmsYn 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3" , "PRML_RCMS_YN" , 0 )
	
	elseif szTranID == "obaci_acct_256a" then
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	If szTranID == "obaci_acct_256a" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")				
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", "TR_ERR", "0")
	End If
	
End Sub

