'============================================================================
Function f_AllCheck()
	ContainerMain.lblShowPdf.fgcolor = "4"
	ContainerMain.lblUnderLine.bgcolor = "4"
	ContainerMain.imgUIAllChk.imgpath = "icon_chk_off.png"
	ContainerMain.imgBG0.imgpath = "img_bg.9.png"
	f_Check0(true)
	f_Check1(true)
	f_Check2(true)
	f_Check3(true)
	f_Check4(true)
	f_Check5(true)
End Function

'============================================================================
Function f_Check0(bState)
	if bState == true then
		ContainerMain.contain1.ChkButton0.chksilence = "1"
		ContainerMain.contain1.lblChk0.fgcolor = g_szFgCheck
		ContainerMain.contain1.imgChk0.imgpath = g_szImgCheck
	else
		ContainerMain.contain1.ChkButton0.chksilence = "0"
		ContainerMain.contain1.lblChk0.fgcolor = g_szFgUnCheck
		ContainerMain.contain1.imgChk0.imgpath = g_szImgUnCheck
	end if
End Function
