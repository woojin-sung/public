Sub ContainerMain_contain1_btnChk0_OnClick()
	dim bCheck
	bCheck = ContainerMain.contain1.ChkButton0.checkstate == "1"
	

	if bCheck ~= true then
		ContainerMain.contain1.ChkButton0.chksilence = "1"
		ContainerMain.contain1.lblChk0.fgcolor = g_szFgCheck
		ContainerMain.contain1.imgChk0.imgpath = g_szImgCheck
	else
		ContainerMain.contain1.ChkButton0.chksilence = "0"
		ContainerMain.contain1.lblChk0.fgcolor = g_szFgUnCheck
		ContainerMain.contain1.imgChk0.imgpath = g_szImgUnCheck
	end if
	f_isEnbleProc()
End Sub

