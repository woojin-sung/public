	<SCRIPT_INFO _len="10191" _ulen="8673" >
Dim gOsType
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)
		
	LabelData0.paddinginfo = "0,0,0,0"
	LabelData1.paddinginfo = "0,0,0,0"
	LabelData2.paddinginfo = "0,0,0,0"
	LabelData3.paddinginfo = "0,0,0,0"
	LabelData4.paddinginfo = "0,0,0,0"
	LabelData5.paddinginfo = "0,0,0,0"
	LabelData6.paddinginfo = "0,0,0,0"
	LabelData7.paddinginfo = "0,0,0,0"
	LabelData8.paddinginfo = "0,0,0,0"
	LabelData9.paddinginfo = "0,0,0,0"
	LabelData10.paddinginfo = "0,0,0,0"
	LabelData11.paddinginfo = "0,0,0,0"
	
	LabelData0.transmode = "1"
	LabelData1.transmode = "1"
	LabelData2.transmode = "1"
	LabelData3.transmode = "1"
	LabelData4.transmode = "1"
	LabelData5.transmode = "1"
	LabelData6.transmode = "1"
	LabelData7.transmode = "1"
	LabelData8.transmode = "1"
	LabelData9.transmode = "1"
	LabelData10.transmode = "1"
	LabelData11.transmode = "1"
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
	end if
	
	'--------------------------------------------------------------
	' 텍스트 글자크기 변경
	'--------------------------------------------------------------
	ChangeTextSize("LabelData0")
	ChangeTextSize("LabelData1")
	ChangeTextSize("LabelData2")
	ChangeTextSize("LabelData3")
	ChangeTextSize("LabelData4")
	ChangeTextSize("LabelData5")
	ChangeTextSize("LabelData6")
	ChangeTextSize("LabelData7")
	ChangeTextSize("LabelData8")
	ChangeTextSize("LabelData9")
	ChangeTextSize("LabelData10")
	
	'--------------------------------------------------------------
	' 텍스트 입력
	'--------------------------------------------------------------
	LabelData0.sizeAutoFit()
	LabelData0.caption = "1. 시장가 주문\n·주문가격을 정하지 않고 현재 호가에 해당하는 가격으로 주문\n·매도만 가능"
	
	LabelData1.sizeAutoFit()
	LabelData1.caption = "2. LOO (장개시 지정가) 주문\n·시가가 지정한 가격보다 같거나 유리하면 체결\n·장개시 5분전까지 주문/정정/취소 가능\n·시초가에 미체결시 주문 거부"

	LabelData2.sizeAutoFit()
	LabelData2.caption = "3. MOO (장개시 시장가) 주문\n·당일 시가로 체결\n·장개시 5분전까지 주문/취소 가능\n·매도만 가능"
	
	LabelData3.sizeAutoFit()
	LabelData3.caption = "4. LOC (장마감 지정가) 주문\n·종가가 지정한 가격보다 같거나 유리하면 체결\n·장마감 10분전까지 주문/정정/취소 가능\n·장 중 가격이 주문 가격보다 유리해도, 종가가 지정가 보다 불리할 경우 미체결"
	
	LabelData4.sizeAutoFit()
	LabelData4.caption = "5. MOC (장마감 시장가) 주문\n·당일 종가로 체결\n·장마감 10분전까지 주문/취소 가능\n·매도만 가능"
	
	LabelData5.sizeAutoFit()
	LabelData5.caption = "6. TWAP (장중시간분할) 주문\n·시간을 균등하게 나눠 시간대별로 주문수량을 분할하여 체결시키는 알고리즘 주문\n*Limit TWAP : 지정한 가격과 동일하거나 유리하면 체결"
	
	LabelData6.sizeAutoFit()
	LabelData6.caption = "7. VWAP (장중수량분할) 주문\n·수량을 균등하게 나눠 체결시키는 알고리즘 주문이며 장 중 시장 평균가격을 추구\n*Limit VWAP : 지정한 가격과 동일하거나 유리하면 체결"
	
	LabelData7.sizeAutoFit()
	LabelData7.caption = "※ 시장가 주문시 상/하한가가 없는 미국주식 시장의 특징으로 인해 현재가 또는 원하는 가격보다 낮거나 불리한 가격에 체결될 수 있습니다."
	
	LabelData8.sizeAutoFit()
	LabelData8.caption = "※ 현지 증권사 사정으로 알고리즘 주문 처리가 지연되거나 취소될 수 있습니다."
	
	LabelData9.sizeAutoFit()
	'LabelData9.caption = "※ 알고리즘 주문은 정규장에서만 유효한 주문유형입니다.(주간거래, Pre, After-market은 지정가 주문만 가능)"
	LabelData9.caption = "※ 알고리즘 주문은 Pre-market, 정규장에서만 입력 가능하며 정규장에서만 유효한 주문유형입니다."
	
	LabelData10.sizeAutoFit()
	LabelData10.caption = "※ 정규장 종료 후(After- market)에는 알고리즘 주문 입력이 불가능합니다."
	
	'--------------------------------------------------------------
	' 텍스트 속성변경
	'--------------------------------------------------------------
	ChangeTextAttr("LabelData0")
	ChangeTextAttr("LabelData2")
	ChangeTextAttr("LabelData4")

End Sub
'============================================================================
Function ChangeTextSize(sCtlName)
	
	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
		
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	'-------------------------------------
	' 글자크기 변경
	'-------------------------------------
	Form.SetCtlProp(sCtlName, "fontsize", sTextSize)
	
End Function
'============================================================================
Function ChangeTextAttr(sCtlName)

	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
		
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	'-------------------------------------
	' 속성변경
	'-------------------------------------
	if sCtlName == "LabelData0" then
		
		sTargetText = "·매도만 가능"
		sStartLen = Form.getLen("1. 시장가 주문\n·주문가격을 정하지 않고 현재 호가에 해당하는 가격으로 주문\n")
		sTargetLen = Form.getLen(sTargetText)
		LabelData0.changeTextAttr(sStartLen, sTargetLen, 335, sTextSize, false)
	
	elseif sCtlName == "LabelData2" then
		
		sTargetText = "·매도만 가능"
		sStartLen = Form.getLen("3. MOO (장개시 시장가) 주문\n·당일 시가로 체결\n·장개시 5분전까지 주문/취소 가능\n")
		sTargetLen = Form.getLen(sTargetText)
		LabelData2.changeTextAttr(sStartLen, sTargetLen, 335, sTextSize, false)
	
	elseif sCtlName == "LabelData4" then
	
		sTargetText = "·매도만 가능"
		sStartLen = Form.getLen("5. MOC (장마감 시장가) 주문\n·당일 종가로 체결\n·장마감 10분전까지 주문/취소 가능\n")
		sTargetLen = Form.getLen(sTargetText)
		LabelData4.changeTextAttr(sStartLen, sTargetLen, 335, sTextSize, false)

	end if

End Function

'============================================================================
Function ChangeLabelPos(sOrgnCtlName,sTargetCtlName)
	
	nOrgnTop = Form.GetCtlProp(sOrgnCtlName, "top")
	nOrgnHeight = Form.GetCtlProp(sOrgnCtlName, "height")
	
	if gOsType == "1" then
		nTargetTop = Form.calcUnResize(nOrgnTop + nOrgnHeight, "1") + 10
	else
		nTargetTop = nOrgnTop + nOrgnHeight + 10
	end if
	
	Form.SetCtlProp(sTargetCtlName, "top", nTargetTop)
	
End Function

'============================================================================
Sub LabelData0_OnSizeAutoFit()
	
	ChangeLabelPos("LabelData0","LabelData1")
	
End Sub

'============================================================================
Sub LabelData1_OnSizeAutoFit()

	ChangeLabelPos("LabelData1","LabelData2")
	
End Sub

'============================================================================
Sub LabelData2_OnSizeAutoFit()

	ChangeLabelPos("LabelData2","LabelData3")
	
End Sub

'============================================================================
Sub LabelData3_OnSizeAutoFit()

	ChangeLabelPos("LabelData3","LabelData4")
	
End Sub

'============================================================================
Sub LabelData4_OnSizeAutoFit()

	ChangeLabelPos("LabelData4","LabelData5")
	
End Sub

'============================================================================
Sub LabelData5_OnSizeAutoFit()

	ChangeLabelPos("LabelData5","LabelData6")
	
End Sub

'============================================================================
Sub LabelData6_OnSizeAutoFit()

	ChangeLabelPos("LabelData6","LabelData7")
	
End Sub

'============================================================================
Sub LabelData7_OnSizeAutoFit()

	ChangeLabelPos("LabelData7","LabelData8")
	
End Sub

'============================================================================
Sub LabelData8_OnSizeAutoFit()

	ChangeLabelPos("LabelData8","LabelData9")
	
End Sub

'============================================================================
Sub LabelData9_OnSizeAutoFit()

	ChangeLabelPos("LabelData9","LabelData10")
	
End Sub

'============================================================================
Sub LabelData10_OnSizeAutoFit()

	'테이블 높이값 조정
	nOrgnTop = Form.GetCtlProp("LabelData10", "top")
	nOrgnHeight = Form.GetCtlProp("LabelData10", "height")
	
	if gOsType == "1" then
		nTargetHeight = Form.calcUnResize(nOrgnTop + nOrgnHeight, "1") + 10
	else
		nTargetHeight = nOrgnTop + nOrgnHeight + 10
	end if
	
	Table0.height = nTargetHeight
	
	'테이블 타이틀라벨 Top값 지정
	nTableTitleTop = nTargetHeight / 2 - 50
	LabelData11.top = nTableTitleTop
	
	'부모화면에 자기사이즈 알리기
	Form.triggerEvent("#", "USA_LinkForm2_Height", nTargetHeight + 20)
	

End Sub

'============================================================================


