'--===========================================================================
' 01. 화 면 명 : 약관 및 이용고지 보기
' 02. 화면설명 : 비대면계좌개설 약관 및 이용고지
' 03. 작    성 : 2021.01.22 : 정민영
' 04. 수    정 : 
' 2021.05.28 : 정민영: v0001 : T2105070009 : 개인신용정보동의제도 개편안 반영
'--===========================================================================
' 약관리스트 - 미표시되는 약관제외 총 25개
'< 계좌개설/서비스 기본 약관 >
'	- 종합계좌약관
'	- 입출금, 대체 및 이체거래, 증권카드 이용약관
'	- 전자금융거래 이용에 관한 기본약관
'	- 매매거래계좌설정약관
'< 주요안내/위험고지 확인 >
'	- 목적확인서&불법&카드
'	- 예금자보호확인
'	- 매매주문 접수·처리방법 등 이용안내문
'	- 일중매매 위험고지
'	- 고객정보 취급방침
'	- 개인신용정보 제공.이용에 대한 고객 권리 안내(미표시)
'	- 징계내역 열람제도 안내문(미표시)
'< 개인(신용)정보 필수 동의서 >
'< 개인(신용)정보 선택 동의서 >
'< 종합매매계좌 주요약관/설명서 >
'	- 주식 위탁증거금 안내 및 위험고지
'	- 대고객환매조건부매매약관
'	- RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
'	- 수익증권저축약관
'< CMA계좌 주요약관/설명서 >
'	- 증권형CMA 거래 약관
'	- 메리츠CMA 상품설명서(RP형)
'	- 대고객환매조건부매매약관
'	- RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
'	- 수익증권저축약관
'< 선물옵션계좌 주요약관/설명서 >
'	- 파생상품계좌설정약관
'	- 장내파생상품거래설명서
'< 해외파생계좌 주요약관/설명서 >
'	- 해외파생상품시장거래총괄계좌설정약관
'	- 해외파생상품 위험고지 및 거래설명서
'	- 외화증권매매거래설정약관
'< CFD계좌 주요약관/설명서 >
'	- 
'	-
'--===========================================================================
'약관리스트 = 정의된 약관수만큼 정의
' contCtcn.lblCtcn0 ~ contCtcn.lblCtcn25
'
'v0001 lblCtcn27 까지 추가
' 개인신용정보필수1건, 개인신용정보선택1건 삭제
' 개인신용정보필수요약1건/상세1건,  개인신용정보선택요약1건/상세1건 추가
'
'--===========================================================================
'약관상세 : mbbdm85131_s1, _s2 동일한 파일
' -> 웹뷰초기화 문제로 번갈아가며 호출함 
'--===========================================================================

Dim	G_STEP2_1_FILE	    '상품선택
Dim	G_STEP2_2_FILE	    '약관목록
Dim	G_STEP2_2_P1_FILE   '약관보기
Dim	G_STEP2_2_P2_FILE   '개인(신용)정보처리필수동의
Dim	G_STEP2_2_P3_FILE   '개인(신용)정보처리선택동의
Dim	G_STEP2_3_FILE      '개설방식선택
Dim	G_STEP2_4_FILE      '종합개설
Dim	G_STEP2_5_FILE      '개별추가

Dim	g_CtcnGb
Dim	g_CtcnCnt           '보여질약관건수
Dim	g_sz_OSType         'OS타입
Dim	g_MaxID
Dim	g_Ret

'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
Dim g_BDM_PRCD100            '종합매매 가입여부
Dim g_BDM_PRCD118RP          'CMA(증권형) 가입여부
Dim g_BDM_PRCD100F           '종합매매(금상전용) 가입여부
Dim g_BDM_PRCD101            '선물옵션 가입여부
Dim g_BDM_PRCD135            '해외파생 가입여부
Dim g_BDM_PRCD133            'ISA 가입여부
Dim g_BDM_PRCDCFD            'CFD 가입여부
'============================================================================
Function User_SharedData_Get()
    'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
    g_BDM_PRCD100            = Form.GetSharedData("BDM_PRCD100"            , false)  '종합매매 가입여부
    g_BDM_PRCD118RP          = Form.GetSharedData("BDM_PRCD118RP"          , false)  'CMA(증권형) 가입여부
    g_BDM_PRCD100F           = Form.GetSharedData("BDM_PRCD100F"           , false)  '종합매매(금상전용) 가입여부
    g_BDM_PRCD101            = Form.GetSharedData("BDM_PRCD101"            , false)  '선물옵션 가입여부
    g_BDM_PRCD135            = Form.GetSharedData("BDM_PRCD135"            , false)  '해외파생 가입여부
    g_BDM_PRCD133            = Form.GetSharedData("BDM_PRCD133"            , false)  'ISA 가입여부
    g_BDM_PRCDCFD            = Form.GetSharedData("BDM_PRCDCFD"            , false)  'CFD 가입여부
End Function



'============================================================================
' Form
'============================================================================
'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    'OSType 1.안드로이드 2.IOS
    g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)

	G_STEP2_1_FILE	= "mbbdm85130"	'상품선택
	G_STEP2_2_FILE	= "mbbdm85131"	'약관목록
	G_STEP2_2_P1_FILE	= "mbbdm85134_p1"	'약관보기
	G_STEP2_2_P2_FILE	= "mbbdm85131_p2"	'개인(신용)정보처리필수동의
	G_STEP2_2_P3_FILE	= "mbbdm85131_p3"	'개인(신용)정보처리선택동의
	G_STEP2_3_FILE	= "mbbdm85190"	'개설방식선택
	G_STEP2_4_FILE	= "mbbdm85132"	'종합개설
	G_STEP2_5_FILE	= "mbbdm85133"	'개별추가
    
    '좌/우페이지넘김 이미지 설정
    'imgPrev.imgpath = "icon_menu_scroll_arrow_left.9.png"    '연한회색 작은꺽쇠
    'imgNext.imgpath = "icon_menu_scroll_arrow_right.9.png"
    'imgPrev.imgpath = "icon_arrow5_l.png"    '두껍고 큰 꺽쇠
    'imgNext.imgpath = "icon_arrow5_r.png"
    imgPrev.imgpath = "icon_arrow3_l.png"    '덜두껍고 큰 꺽쇠
    imgNext.imgpath = "icon_arrow3_r.png"

    '공유정보Get
	User_SharedData_Get()

	sRevData = Form.GetOpenLinkData()
	If sRevData == "" Or sRevData == Null Then
		Form.CloseForm()
	else 
		g_CtcnGb = sRevData
	End If
	'Form.ShowAlert("sRevData", sRevData)

	'약관목록 순서대로 리스트 조립 -----------------------------------------
	g_CtcnCnt = 0
	'sRevData = A.전체 1.< 계좌개설/서비스 기본 약관 >
	If sRevData == "A" Or (sRevData == "1" Or sRevData == 1) Then
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "1_1")	'종합계좌약관	
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "1_2")	'입출금, 대체 및 이체거래, 증권카드 이용약관 
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "1_3")	'전자금융거래 이용에 관한 기본약관  
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "1_4")	'매매거래계좌설정약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	'sRevData = A.전체 2.< 주요안내/위험고지 확인 >
	If sRevData == "A" Or (sRevData == "2" Or sRevData == 2) Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "2_1")	'목적확인서&불법&카드
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "2_2")	'예금자보호확인
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "2_3")	'매매주문 접수·처리방법 등 이용안내문
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "2_4")	'일중매매 위험고지
		g_CtcnCnt = CInt(g_CtcnCnt) + 1		

		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "2_5")	'고객정보 취급방침
		g_CtcnCnt = CInt(g_CtcnCnt) + 1		
		
		'개인신용정보 제공.이용에 대한 고객 권리 안내(미표시)
		'징계내역 열람제도 안내문(미표시)	
	End If
	'sRevData = A.전체 P100.< 종합매매계좌 주요약관/설명서 >
	If (sRevData == "A" Or sRevData == "P100") And (g_BDM_PRCD100 == "Y" Or g_BDM_PRCD100F == "Y")  Then
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_1")	'주식 위탁증거금 안내 및 위험고지
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_2")	'대고객환매조건부매매약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_3")	'RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_4")	'수익증권저축약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	'sRevData = A.전체 P118.< CMA계좌 주요약관/설명서 >
	If (sRevData == "A" Or sRevData == "P118") And g_BDM_PRCD118RP == "Y" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P118_1")	'증권형CMA 거래 약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P118_2")	'메리츠CMA 상품설명서(RP형)
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P118_3")	'대고객환매조건부매매약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P118_4")	'RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
		g_CtcnCnt = CInt(g_CtcnCnt) + 1

		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P118_5")	'수익증권저축약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	

	'sRevData = A.전체 CFD.< CFD계좌 주요약관/설명서 >
	If (sRevData == "A" Or sRevData == "CFD") And g_BDM_PRCDCFD == "Y" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD_1")	'전문투자자용
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD_2")	'메리츠증권
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	
	End If
	
	
	'sRevData = A.전체 P101.< 선물옵션계좌 주요약관/설명서 >
	If (sRevData == "A" Or sRevData == "P101") And g_BDM_PRCD101 == "Y" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P101_1")	'파생상품계좌설정약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1

		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P101_2")	'장내파생상품거래설명서
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	'sRevData = A.전체 P135.< 해외파생계좌 주요약관/설명서 >
	If (sRevData == "A" Or sRevData == "P135") And g_BDM_PRCD135 == "Y" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P135_1")	'해외파생상품시장거래총괄계좌설정약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P135_2")	'해외파생상품 위험고지 및 거래설명서
		g_CtcnCnt = CInt(g_CtcnCnt) + 1

		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P135_3")	'외화증권매매거래설정약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	'sRevData = A.전체 Mndt.< 개인(신용)정보 필수 동의서 >
	If sRevData == "A" Or sRevData == "Mndt" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "Mndt1")	'개인(신용)정보 필수 동의서_요약 v0001
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "Mndt2")	'개인(신용)정보 필수 동의서_상세 v0001
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	'sRevData = A.전체 Slct.< 개인(신용)정보 선택 동의서 >
	If sRevData == "A" Or sRevData == "Slct" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "Slct1")	'개인(신용)정보 선택 동의서_요약 v0001
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "Slct2")	'개인(신용)정보 선택 동의서_상세 v0001
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If 

     'mbbdm85131_p4 화면에서 사용
	'sRevData = CFDA.전체 CFD1.장외파생상품거래 기본계약서>
	If sRevData == "CFDA" Or sRevData == "CFD1" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD1")	
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	'sRevData = CFDA.전체 CFD2.장외파생상품 담보계약서>
	If sRevData == "CFDA" Or sRevData == "CFD2" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD2")	
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	'sRevData = CFDA.전체 CFD3.장외파생상품 투자 전문투자자 대우 확인서>
	If sRevData == "CFDA" Or sRevData == "CFD3" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD3")	
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	'sRevData = CFDA.전체 CFD2.고난도 금융투자상품 목표시장 확인서>
	If sRevData == "CFDA" Or sRevData == "CFD4" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD4")	
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	'sRevData = CFDA.전체 CFD3.개인전문투자자 보호제도 미적용 확인서>
	If sRevData == "CFDA" Or sRevData == "CFD5" Then	
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "CFD5")	
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	
	'타이틀변경
	if sRevData == "CFDA" Or sRevData == "CFD1" Or sRevData == "CFD2" Or sRevData == "CFD3" Or sRevData == "CFD4" Or sRevData == "CFD5" Then
		labTitle.caption = "CFD 계약서 등 확인 및 동의"
		 '첫번째약관 보이기
		fmtab.currenttab = 1
		fmtab_OnTabChanged(1)

	else
		labTitle.caption = "약관 및 이용고지 보기"
		 '첫번째약관 보이기
		fmtab.currenttab = 0
		fmtab_OnTabChanged(0)
	End if
	
    
End Sub

'============================================================================
' TAB별 화면 호출
'============================================================================
Sub fmtab_OnTabChanged(nCurrentTab)
	If nCurrentTab < CInt(g_CtcnCnt) Then	'폼탭연결된 수가 아닌 오픈되어야 할 약관 수(g_CtcnCnt)만큼만 처리
		mkCtcn1 = "contCtcn.lblCtcn"..nCurrentTab
		mkCtcn2 =  Form.GetCtlProp(mkCtcn1, "caption")
'Form.ShowAlert("mkCtcn2", mkCtcn2)
		Form.triggerEvent("fmtab."..fmtab.currenttabpageid, mkCtcn2, "")
	else
	    '오픈되어야할 약관수 넘어가는 경우 페이징처리 불가/현재페이지에 머무르도록 설정
	    fmtab.currenttab = CInt(nCurrentTab)-1
	    'IOS인경우 빈페이만 남으므로 폼탭이벤트 탈수 있게 이벤트호출
	    fmtab_OnTabChanged(CInt(nCurrentTab)-1)
	End If
	
	'페이지설정
	nowPage = CInt(nCurrentTab)+1
	If CInt(nowPage) > CInt(g_CtcnCnt) Then
        nowPage = CInt(g_CtcnCnt)
	End If
    lblPage.caption = nowPage.."/"..g_CtcnCnt
End Sub



'============================================================================
' 좌/우 페이지처리
'============================================================================
'============================================================================
Sub imgPrev_OnClick()
    nowTabId = fmtab.currenttab
    If CInt(nowTabId) > 0 Then
		iIdx = fmtab.currenttab
		fmtab.currenttab = CInt(iIdx) - 1		
		fmtab_OnTabChanged(CInt(iIdx) - 1)
	End If
End Sub
'============================================================================
Sub imgNext_OnClick()
    'nowTabId = fmtab.currenttab
    nowTabId = fmtab.currenttabpageid
    If CInt(nowTabId) < CInt(g_CtcnCnt) Then  '폼탭연결된 수가 아닌 오픈되어야 할 약관 수(g_CtcnCnt)만큼만 처리
		iIdx = fmtab.currenttab
		fmtab.currenttab = CInt(iIdx) + 1
		fmtab_OnTabChanged(CInt(iIdx) + 1)
	End If
End Sub



'============================================================================
' 종료
'============================================================================
'============================================================================
Sub Form_OnFormBackKeyPressed()
    imExit_OnClick()
End Sub
'============================================================================
Sub imExit_OnClick()
	g_Ret = ""
	Form.CloseForm()
End Sub
'============================================================================
Sub bntOK_OnClick()
	g_Ret = "ok_"..g_CtcnGb
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

	If g_Ret ~= "" Or g_Ret ~= Null Then
		'확인 버튼으로 종료시에만 정상확인 처리
		Form.SendReturnToParent(G_STEP2_2_P1_FILE, g_Ret)
	End If
End Sub




