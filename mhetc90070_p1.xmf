	<SCRIPT_INFO _len="2162" _ulen="2086" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 간편인증 서비스
' 02. 화면설명 : 간편인증 서비스 팝업
' 03. 작    성 : 2016.08.05  NOHES
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_ONESHOT			'간편인증 서비스 메뉴
Dim G_DATA

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	G_DATA =  Form.GetOpenLinkData()
	if G_DATA == "Confirm" Then
		btnOK0.visible = True
		btnOK1.visible = False
	else
		btnOK0.visible = False
		btnOK1.visible = True
	end if
	
	 Dim sOS_TYPE
	 sOS_TYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	 
	 if sOS_TYPE == "2" then
		 Label5.visible = True
		 Table0.visible = True
	 else
		 Label5.visible = False
		 Table0.visible = False
	 end if
	
	G_ONESHOT = "mhetc90070"
End Sub


'============================================================================
Sub btnOK0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK1_OnClick()
		'로그인 시 
	If G_DATA == "LOGIN" Then
	     Form.SendReturnToParent("mhetc90070_p1" , "Y")
	     Form.OpenScreen("86030" , "")
	     Form.SetEnvData(1, "login.input.savetab", "0")
	     Form.CloseForm()
	Else
		Form.SendReturnToParent("JOIN" , "")
		Form.CloseForm()
	End If

End Sub

	</SCRIPT_INFO>
