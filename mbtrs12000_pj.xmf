'============================================================================
' btnInquiry_OnClick : 조회버튼
'============================================================================
Sub btnInquiry_OnClick()
	procInquiry()
End Sub

'============================================================================
'20181210_01 KBC START
'============================================================================
Sub procChekBtn(sCheck)
	if Cint(grdList.rowcount) < 1 then  '20201016 SWJ : 전체선택 에러 수정(rowcount 정수화)
		exit sub
	end if
	
	For nRowIdx = 0 To grdList.rowcount - 1
		szCd = grdList.GetCellData("bd_Cd", nRowIdx)
		szMk = Form.GetItemCodeInfo(szCd, "market")
		
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then		
			grdList.SetCellData("bd_Chk", nRowIdx, sCheck)
		else
			szCutCd = Mid(szCd, 2, Len(szCd))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")

			if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
				grdList.SetCellData("bd_Chk", nRowIdx, sCheck)
			else
				grdList.SetCellData("bd_Chk", nRowIdx, "0")
				grdList.SetCellData("bd_rslt", nRowIdx, "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
			end if
		end if
	Next
End Sub

'============================================================================
Sub grdList_OnHeaderClickUp(lRow, szCellID)
	if CInt(grdList.rowcount) < 1 then 
		exit sub
	end if
	
	For nRowIdx = 0 To CInt(grdList.rowcount) - 1
		sChk = grdList.GetCellData("bd_Chk", nRowIdx)
		if sChk == "0" then
			Exit For
		end if
	Next	
	
	if sChk == "1" then
		sChk = "0"
	else 
		sChk = "1"
	end if
	
	If szCellID == "th_cellChk" then
		procChekBtn(sChk)
	end if
End Sub

'============================================================================
Sub btnUnsel_OnClick()
	procChekBtn("0")
End Sub

'============================================================================
Sub btnSel_OnClick()
	procChekBtn("1")
End Sub

'============================================================================
Sub btnCnl_OnClick()
	nOrdCnt = 0
	
	For nRowIdx = 0 To CInt(grdList.rowcount) - 1
		sChk = grdList.GetCellData("bd_Chk", nRowIdx)
		if sChk == "1" then
			nOrdCnt = nOrdCnt + 1
		end if
	Next		
	
	if nOrdCnt > 0 then
		szAcntName = Form.GetAccountInfo(g_szAcnt, "name")
		strWarn = "계좌번호 " & g_szAcnt & "-" & g_szAcntCd & " " & szAcntName & "\n\n"
		strWarn = strWarn & "선택된 " & nOrdCnt & "건에 대한 일괄 취소주문을 하시겠습니까?"	
		
		Form.MsgBox("일괄취소 주문확인", strWarn, "CnclOrd", 1)
	else
		strWarn = "일괄 취소할 종목을 체크하여 주십시오."
		
		Form.MsgBox("일괄취소 주문확인", strWarn, "", 0)
	end if
End Sub

'============================================================================
Sub proc_CnclOrd(lRow)
	
	if Trim(edtPwd.caption) == "" then
		Form.ShowAlert("알림", "비밀번호를 확인후 다시 입력하십시오.")
		exit sub
	end if
	
	g_CnclOrdRow = lRow
	
	szCd		= grdList.GetCellData("bd_Cd"		, lRow)
	szQty	= grdList.GetCellData("bd_MicheQty"	, lRow)
	szClsCd	= grdList.GetCellData("bd_ClsCd"	, lRow) '주문조건구분
	szOrgNo	= grdList.GetCellData("bd_OdrNo"	, lRow)	
	szAll	= "Y"
	g_szWarnFlag = "N"

	DATAMANAGER.ClearInputData(0, "obtrs_oder_101a")

	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNO"					, 0, g_szAcnt)		' 계좌번호(8)
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ASNO"					, 0, g_szAcntCd)		' 계좌일련번호(2)
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD"				, 0, edtPwd.caption)	' 계좌 비밀번호
