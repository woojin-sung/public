	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ORGL_ODER_NO"			, 0, szOrgNo)			' 원주문번호
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WHOL_RCTF_CNCL_YN"		, 0, szAll)			' 전체 취소 취소여부
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WARN_CNFR_YN"			, 0, g_szWarnFlag)	' 경고확인여부
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "SVC_CLS_CODE"			, 0, "104")			' 서비스 구분 코드
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "PGM_ASPR_DCLR_CLS_CODE"	, 0, "0")			' 프로그램호가신고구분코드
	DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, "01")			' 주문발생유형코드(01:일반주문)	

	DATAMANAGER.RequestTranData("obtrs_oder_101a")
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.SendReturnToParent("12000_CLOSE", "")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CnclOrd" then
		if sRet == "ok" then
			'일괄취소주문 실행
			For nRow = 0 To grdList.rowcount - 1
				sChk = grdList.GetCellData("bd_Chk", nRow)
				if sChk == "1" then
					g_bOrdIng = true
					proc_CnclOrd(nRow)
					exit for
				end if
			Next				
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtrs_oder_101a" then
		
		szTranMsg = szErrMsg
		szSubMsg = Trim(DATAMANAGER.GetDataMsgSubText(szTranID))
		
		if szSubMsg == "" then
			grdList.SetCellData("bd_rslt", g_CnclOrdRow, szTranMsg)
		else
			grdList.SetCellData("bd_rslt", g_CnclOrdRow, szTranMsg & "(" & szSubMsg & ")")
		end if
		
		grdList.SetCellData("bd_Chk", g_CnclOrdRow, "0")
		
		'다음주문 처리
		bQuiry = true;
		g_CnclOrdRow = g_CnclOrdRow + 1
	
		For nRow = g_CnclOrdRow To grdList.rowcount - 1
			sChk = grdList.GetCellData("bd_Chk", nRow)
			if sChk == "1" then
				bQuiry = false;
				proc_CnclOrd(nRow)
				exit for
			end if
		Next	
		
		if bQuiry == true then
			g_bOrdIng = false
			Form.ShowAlert("알림", "모든 주문이 완료되었습니다. 미체결내역 조회를 통해서 주문결과를 다시 확인하시기 바랍니다.")
			DATAMANAGER.RequestTranData("obtrs_cntg_638r") '재조회			
		end if
	else
		if Len(Trim(szErrMsg)) > 0 then
			Form.Toast(0, szErrMsg, 0)		
		end if
	end if
End Sub

'============================================================================
Sub btnSearch_OnClick()
	procInquiry()
End Sub

'============================================================================
Sub procInquiry()
	if g_bOrdIng == false then
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")
	else
		Form.Toast(0, "취소주문이 진행중입니다. 잠시후 조회하시기 바랍니다.", 0)
	end if
End Sub

