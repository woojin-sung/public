'============================================================================
Sub contMain_imgAthnShow_OnClick()
    Form.OpenPopup("mbbdm86130_p1", "", "")
End Sub



'============================================================================
' 휴대폰 인증번호 재요청
'============================================================================
'============================================================================
Sub contMain_btnAthnRetry_OnClick()
    nTop = 0
    nContResize = 0

   'If contMain.chkCtcnAgrm.checkstate == "0" Or contMain.chkCtcnAgrm.checkstate == 0 Then  '0.uncheck 1.check
   '     'contMain.edtAthnNo.SetResultLabel("1","error","휴대폰 본인인증 약관동의를 하지 않으셨습니다.","contMain")
   '    Form.ShowAlert("오류", "휴대폰 본인인증 약관동의를 하지 않으셨습니다.")
   '    exit sub
   'End If
    If CheckData() = True Then
        contMain.edtAthnNo.SetResultLabel("0","complete","","contMain")

        '기존 인증번호 Clear
        contMain.edtAthnNo.caption = ""
        contMain.edtAthnNo.enable  = True

        '타이머 초기화
        InitCountTimer()

        '기 인증처리 중인 전문정보 초기화
        edtRqstTlmsNo.caption  = ""
        edtVrfcTlmsNo.caption  = ""

        '재요청버튼 비활성화/숨김
        'contMain.btnAthnRetry.enable  = False
        contMain.btnAthnRetry.visible  = False

        '테스트용 인증서 Skip
         If CInt(chkSkip.checkstate) == 1 Then
			'확인버튼 활성화
               btnNext.visible = True
		
               btnNext.btnimage = "btn_20.9"
               btnNext.fgcolor = "273"				
         Else
              '인증번호 요청
               DATAMANAGER.RequestTranData( "obcsb_oimf_653a" )
         End If
    End If
End Sub



'============================================================================
' 테스트인증Skip
'============================================================================
Sub chkSkip_OnChange(sCheckState)
    If g_nDev == "1" Or g_nDev == 1 Then  '개발서버인 경우에만 동작하도록.
	   '모바일OTP 보안매체가 원장 기준으로는 있더라도
	   '앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
	     Form.requestMOTP("MOTP_GETINFO"     , "" , "90190")     '등록된 OTP alias 존재하는지 확인
	     'DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '20230612 KBC 추가(휴대폰인증 SKIP처리 지원)
	     
	     if chkSkip.checkstate == "1" Then
		    Form.SetSharedData("Meritz_OTP_PhoneNum" , contMain.edtHPNo.Caption )
		    Form.SetSharedData("Meritz_OTP_CustName" , contMain.edtName.Caption )
	    end if
	     
        '휴대폰 본인인증 약관동의 & 테스트인증Skip 해제한 경우, 인증처리 할수 있도록 인증요청버튼 활성화 처리
        If contMain.chkCtcnAgrm.checkstate == "1" Or contMain.chkCtcnAgrm.checkstate == 1 Then
           '타이머이벤트 모두 종료
            User_Stop_Timer()

            If CInt(chkSkip.checkstate) == 1 Then
               '확인버튼 활성화
                btnNext.visible = True

                btnNext.btnimage = "btn_20.9"
                btnNext.fgcolor = "273"
            Else
               '확인버튼 비활성화
                btnNext.visible = False
		
                If Form.GetEnvData("common.theme") = "black" Then
				btnNext.btnimage = "btn_27.9"
                Else 
				btnNext.btnimage = "btn_21.9"
                End If
                btnNext.fgcolor = "269"	
            End If
        Else
            '확인버튼 비활성화
            btnNext.visible = False
	    
            If Form.GetEnvData("common.theme") = "black" Then
			btnNext.btnimage = "btn_27.9"
            Else 
			btnNext.btnimage = "btn_21.9"
            End If
            btnNext.fgcolor = "269"	    
        End If
    End If
End Sub



'============================================================================
' TR
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

'Sta 헤더(USER_ID) 정보 처리방법 변경1
'    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
'        '처리중인 휴대폰정보로 USerID설정
'        'DATAMANAGER.SetUserID(g_sz_HPNo)
'        DATAMANAGER.SetUserID(Trim(contMain.edtHPNo.caption))  '본인인증한휴대폰번호로설정
'    End If
'Fin 
'Sta  헤더(USER_ID) 정보 처리방법 변경2
'    '로그인성 화면 & 비대면화면 (ex 모바일OTP관리)
'    If g_sz_SubNmetBswrGb == "3" Or g_sz_SubNmetBswrGb == 3 Then
'        '로그인한 ID로 재설정
'        strUserID = Form.GetSharedData("&USER_ID", False)
'        DATAMANAGER.SetUserID(Trim(strUserID))
'
'    '비로그인성 화면 & 비대면화면
'    Else
'        '본인인증한휴대폰번호로설정
'        strUserID = Trim(contMain.edtHPNo.caption)
'        If g_sz_OSType == "1" Or g_sz_OSType == 1 Then '안드로이드
'            DATAMANAGER.SetUserID(strUserID)
'        Else 'IOS
'            Form.SetSharedData("&BDM_HEADER", strUserID)
'        End If
'    End If
'End If
	
	if szTranID == "obcsb_oimf_520r" then	
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_520r", "InBlock1", "INPUT_CLS", 0, "2" )
		'DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID"  , 0, "meritz" )
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"  , 0, g_fullRcnoPip)	
	end if
	
    '로그인성 업무는 로그인한 ID로 처리, 비대면성 업무는 본인인증한 휴대폰정보로 처리(2021.04.22)
'    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
'        strUserID = Trim(contMain.edtHPNo.caption)
'        Form.SetSharedData("&BDM_HEADER", strUserID)
'    End If

    '기체크된 인증번호체크결과 helpmsg 숨기기
    If szTranID == "obcsb_oimf_653a" Or szTranID == "obcsb_oimf_654a_1" Or szTranID == "obcsb_oimf_655r" Then
        contMain.edtAthnNo.SetResultLabel("0","complete","","contMain")
    End If

    '인증번호 요청 -------------------------------------------------------------
    If szTranID == "obcsb_oimf_653a" Then
        '인증검증건수 초기화
        g_nCnt = 0
    
        '요청전문번호/검증전문번호 초기화
        edtRqstTlmsNo.caption = ""
        edtVrfcTlmsNo.caption = ""

        '통신사확인(인증프로그램에서 체크하는 2자리로만 매핑)
        strRd = contMain.cmbMcco.currentindex
        If strRd == "0" Or strRd == 0 Then
            strRd_Key = "SK"  'SKT    -메타값 STK
        ElseIf strRd == "1" Or strRd == 1 Then
            strRd_Key = "KT"  'KT   -메타값 KTF
        ElseIf strRd == "2" Or strRd == 2 Then
            strRd_Key = "LG"  'LGU+ -메타값 LGT
        ElseIf strRd == "3" Or strRd == 3 Then
            strRd_Key = "AL"  'SK알뜰 -메타값 SKA
        ElseIf strRd == "4" Or strRd == 4 Then
            strRd_Key = "KA"  'KT알뜰 -메타값 KTA
        ElseIf strRd == "5" Or strRd == 5 Then
            strRd_Key = "LA"  'LGU+알뜰 -메타값 LGA
        End If

        '휴대폰번호
        If Len(Trim(contMain.edtHPNo.caption)) == 10 Then  '###-###-####
            strArcd = mid(Trim(contMain.edtHPNo.caption), 1, 3)
            strTono = mid(Trim(contMain.edtHPNo.caption), 4, 3)
            strSrno = mid(Trim(contMain.edtHPNo.caption), 7, 4)
        Else  '###-####-####
            strArcd = mid(Trim(contMain.edtHPNo.caption), 1, 3)
            strTono = mid(Trim(contMain.edtHPNo.caption), 4, 4)
            strSrno = mid(Trim(contMain.edtHPNo.caption), 8, 4)
        End If

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"       , 0, "N"                      )  'N.비대면
        
	   if Cint(g_logintype) > 1 then
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "2"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        else
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "4"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
	   end if
	   
	    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MCCO_CODE"      , 0, strRd_Key                )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD"           , 0, "N2"                     )  
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"       , 0, g_RcnoPip 		)  '주민번호
        'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"       	   , 0, g_otpACNO 			 )  '계좌번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNM"           , 0, contMain.edtName.caption )  '고객명
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_ARCD"      , 0, strArcd                  )  '휴대폰번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TONO"      , 0, strTono                  )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_SRNO"      , 0, strSrno                  )

    '인증확인 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a" Then
        '인증검증건수 초기화
        'g_nCnt = 0

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"            , 0, "3"                      )  '3.(비대면)1차 응답코드 조회
        
	   if Cint(g_logintype) > 1 then
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "2"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        else
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "4"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
	   end if
       
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMS_ATHN_NO"         , 0, ""                       )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"            , 0, g_RcnoPip 		)  '주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0, edtRqstTlmsNo.caption    )  '인증번호요청전문번호

    '인증확인 요청검증 ---------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a_1" Then
        '요청검증전문번호 초기화
        edtVrfcTlmsNo.caption = ""

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"            , 0, "4"                        )  '4.(비대면)2차 확인 전송
        
	    if Cint(g_logintype) > 1 then
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "2"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        else
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "4"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
	   end if
	
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"            , 0, g_RcnoPip  			)  '주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0, edtRqstTlmsNo.caption      )  '인증번호요청전문번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMS_ATHN_NO"         , 0, contMain.edtAthnNo.caption )  '인증번호

    '인증결과 검증 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_655r" Then
        '인증검증건수 초기화
        'g_nCnt = 0

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"             , 0, "N"                        )  'N.비대면
        
	   if Cint(g_logintype) > 1 then
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "2"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
        else
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATHN_BSWR_CLCD" , 0, "4"                      )  '전체실명번호검증을 위해 4.본인인증+생년월일 -> 2.본인인증 전문변경
	   end if
        
	    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RRNO_PIP"             , 0, g_RcnoPip   		)  '암호화주민번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "NICE_ISTU_TLMS_MNNO"  , 0, edtVrfcTlmsNo.caption      )  '인증번호검증전문번호
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMS_ATHN_NO"          , 0, contMain.edtAthnNo.caption )  '인증번호
    End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    '오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null And Trim(strSubMsg) ~= "" Then
        strMsg2 = szErrMsg.."("..Trim(strSubMsg)..")"
        strMsg = szErrMsg.."\n"..Trim(strSubMsg)
    Else
        strMsg2 = szErrMsg
        strMsg = szErrMsg
    End If

    '인증번호 요청 -------------------------------------------------------------
    If szTranID == "obcsb_oimf_653a" Then
        contMain.edtAthnNo.SetResultLabel("1","error",strMsg,"contMain")

        '인증번호 재요청버튼 Show
        contMain.edtAthnNo.caption    = ""
        contMain.edtAthnNo.enable     = False
        contMain.btnAthnRetry.visible = True
        contMain.btnAthnRetry.enable  = True

    '인증확인 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a" Then
        If szErrCode == "3021" Or szErrCode == 3021 Then
            '전문미수신인경우, 인증번호 재요청(타이머 실행)
            Form.SetTimerEvent(0, 1, 1)
        Else
            contMain.edtAthnNo.SetResultLabel("1","error",strMsg,"contMain")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True
        End If

    '인증확인 요청검증 ---------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a_1" Then
        contMain.edtAthnNo.SetResultLabel("1","error",strMsg,"contMain")

        '인증번호 재요청버튼 Show
        contMain.edtAthnNo.caption    = ""
        contMain.edtAthnNo.enable     = False
        contMain.btnAthnRetry.visible = True
        contMain.btnAthnRetry.enable  = True

    '인증결과 검증 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_655r" Then
        If szErrCode == "3021" Or szErrCode == 3021 Then        
            '전문미수신인경우, 인증확인 요청검증 재요청(타이머 실행)
            Form.SetTimerEvent(1, 1, 1)
        Else
            contMain.edtAthnNo.SetResultLabel("1","error",strMsg,"contMain")

            '인증번호 재요청버튼 Show
            'contMain.edtAthnNo.caption    = ""
            'contMain.edtAthnNo.enable     = True  'False 
            If contMain.lblAthnTime.caption == "3:00" And CInt(g_HPSec) = 180 Then
                contMain.edtAthnNo.caption    = ""
                contMain.edtAthnNo.enable     = True
                contMain.btnAthnRetry.visible = True
                contMain.btnAthnRetry.enable  = True
            Else
                '인증번호체크중 오류인 경우에는 인증유효시간까지 재입력가능
                contMain.btnAthnRetry.visible = False
                contMain.btnAthnRetry.enable  = False
            End If
        End If

    '단기다수계좌/대포통장 명의인/사기계좌명의인 -------------------------------
    ElseIf szTranID == "obaci_acct_091r" Or szTranID == "obaci_acct_091r_1" Or szTranID == "obaci_acct_091r_2" Or szTranID == "obaci_acct_096r" Then
        '테스트인경우 정상처리
        If CInt(chkSkip.checkstate) == 1 Then
            '100.비대면계좌개설
            If g_sz_SubNmetBswrGb == "1" Or  g_sz_SubNmetBswrGb == 1 Then
                '비대면계좌개설 이어하기 조회
                DATAMANAGER.RequestTranData( "obaci_acct_058r" )
                
                '0xx.비대면업무신청
            ElseIf g_sz_SubNmetBswrGb == "0" Or g_sz_SubNmetBswrGb == 0 Then
                g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
                
                '신분증촬영화면 오픈후, 종료
                g_Opng_File = "NEXT"  '오픈할화면
                g_Send_Data = ""      '인자정보
                
                NextStep()
            End If
        Else
		   btnNext.enable = true	'20230419 추가
		   
		   btnNext.btnimage = "btn_20.9"
		   btnNext.fgcolor = "273"
		   
            '개설불가 안내 후, 종료
            'strSetErrCode = "00"
            'CommErrClose(strSetErrCode)
            Form.ShowAlert("오류", strMsg2)
       End If

    '비대면계좌개설 이어하기 obaci_acct_049c -----------------------------------
    '비대면본인인증및1원역이체 obcsb_nmet_102c ---------------------------------
    'ElseIf szTranID ==  "obaci_acct_049c" Or szTranID ==  "obcsb_nmet_102c" Then
    ElseIf szTranID ==  "obcsb_nmet_102c" Then
        'If szTranID == "obcsb_nmet_102c" Then
            If szErrCode == "6660" Or szErrCode == 6660 Then
                If Trim(strSubMsg) == "기존계좌의 고객명 상이" Then
                    strSetErrCode = "02"
                    CommErrClose(strSetErrCode)
                Else
				 btnNext.enable = true		'20230419 추가
				 btnNext.btnimage = "btn_20.9"
				 btnNext.fgcolor = "273"
				 
				 Form.ShowAlert("오류", strMsg2)
                End If
            Else
	           btnNext.enable = true		'20230419 추가
	           btnNext.btnimage = "btn_20.9"
	           btnNext.fgcolor = "273"
		   
                Form.ShowAlert("오류", strMsg2)
            End If
        'Else
            '개설불가 안내 후, 종료
            'strSetErrCode = "00"
            'CommErrClose(strSetErrCode)
        '    Form.ShowAlert("오류", strMsg2)
        'End If

    '비대면계좌개설 이어하기 조회 ----------------------------------------------
    '비대면업무 진행상태 조회 ----------------------------------------------
    ElseIf szTranID ==  "obaci_acct_058r" Then
        btnNext.enable = true	'20230419 추가
	
        btnNext.btnimage = "btn_20.9"
        btnNext.fgcolor = "273"
	
        Form.ShowAlert("오류", strMsg2)

    '비대면계좌개설 이어하기 등록_취소 -----------------------------------------
    ElseIf szTranID == "obaci_acct_059c" or szTranID == "obaci_acct_059c_1"  Then
        btnNext.enable = true	'20230419 추가
	
        btnNext.btnimage = "btn_20.9"
        btnNext.fgcolor = "273"		
		
        Form.ShowAlert("오류", strMsg2)
	
    else
    
        btnNext.enable = true	'20230419 추가
	
        btnNext.btnimage = "btn_20.9"
        btnNext.fgcolor = "273"		
		
        Form.ShowAlert("오류", strMsg2)    

    End If
	
	if szTranID == "obcsb_oimf_520r" then
		'확인버튼 활성화
		btnNext.visible = True
			
		btnNext.btnimage = "btn_20.9"
		btnNext.fgcolor = "273"
		
		Form.ShowAlert("오류", strMsg2)
	end if
		
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obcsb_oimf_520r" then
		'0: 보안카드 / 1: 부가정보 / 2: otp,보안카드,부가정보 없음 / 3: otp / 9: 기타오류
		g_sGubunCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0)
		
		g_MotpYN      = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0)
		
		'확인버튼 활성화
		btnNext.visible = True
		
		btnNext.btnimage = "btn_20.9"
		btnNext.fgcolor = "273"
	end if 

    '인증번호 요청 -------------------------------------------------------------
    If szTranID == "obcsb_oimf_653a" Then  
        '요청전문번호 설정
        sTemp = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "NICE_ISTU_TLMS_MNNO", 0)
        edtRqstTlmsNo.caption = Trim(sTemp)

        '인증번호 요청 타이머실행
        Form.SetTimerEvent(0, 1, 1)

    '인증확인 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a" Then
        Form.ShowAlert("확인", "인증번호가 정상적으로 발송 되었습니다.")
    
        g_HPSec = 180             '인증가능시간설정
        Form.SetTimerEvent(2, 1, 1)

    '인증확인 요청검증 ---------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_654a_1" Then
        '인증확인 요청전문번호 설정
         sTemp = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "NICE_ISTU_TLMS_MNNO", 0)
         edtVrfcTlmsNo.caption = Trim(sTemp)

         '인증확인 요청검증 타이머실행
         Form.SetTimerEvent(1, 1, 1)

    '인증결과 요청 -------------------------------------------------------------
    ElseIf szTranID == "obcsb_oimf_655r" Then
        g_CIKeyNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CIKEY_NO", 0)

        '3분 타이머 초기화
        InitCountTimer()

        '인증완료 메시지 표시
        contMain.edtAthnNo.SetResultLabel("1","complete","인증되었습니다.","contMain")

        '인증이 정상적으로 처리된 후, 정보 변경 못하도록 전체 비활성화(보안성 보완)
        contMain.edtName.enable      = False
        'edtRcno.enable      = False
        contMain.cmbMcco.enable      = False
        contMain.edtHPNo.enable      = False
        contMain.btnCtcnAgrm.enable  = False
        contMain.chkCtcnAgrm.bringFront("1")   '(IOS)인증완료후, 비활성화를 위해 제일 앞단으로 위치 (순서주의! btnCtcnAgrm 처리후해야함)
        contMain.chkCtcnAgrm.enable  = False
        contMain.imgAthnShow.enable  = False
        contMain.edtAthnNo.enable    = False
        contMain.btnAthnRetry.enable = False

        contMain.btnAthnRetry.visibe = False  '재요청버튼은 hidden
        contMain.lblAthnTime.visibe  = False  '인증유효시간 hidden
	   
	   Form.SetSharedData("Meritz_OTP_PhoneNum" , contMain.edtHPNo.Caption )
	   Form.SetSharedData("Meritz_OTP_CustName" , contMain.edtName.Caption )
	   
	   '모바일OTP 보안매체가 원장 기준으로는 있더라도
	   '앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
	   Form.requestMOTP("MOTP_GETINFO"     , "" , "90190")     '등록된 OTP alias 존재하는지 확인

	 end if
End Sub
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)

	if sEventName == "MOTP_GETINFO_RETURN_90190" then

		mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" )
		
		if Ubound(mOTPInfo) < 1 then
			exit sub
		else	
			g_motpAppYN = mOTPInfo(0)
		end if
	end if
End Sub
'============================================================================
' 이전단계로
'============================================================================
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    If sKeyName == "Exit" Then
        If sRet == "ok" Then  '예.ok / 아니오.no
            Form.SetSharedData("&SCREEN_AUTH" , "") '비대면화면 권한프리
	    
            g_Opng_File = "HOME"  '오픈할화면
            g_Send_Data = ""      '인자정보
    
            NextStep()
        Else
            g_Back_Flag = ""
        End If

    ElseIf sKeyName = "MCCO" Then 
        'sRet=close/cancel
        '알뜰폰 신청불가안내 팝업 닫힌경우, 다시 통신사 콤보리스트 오픈
	    contMain.cmbMcco.openList()
    
    
    '단기다수 출금고제한 대상 계좌 없음
    elseif sKeyName == "obaci_nmet_017r_NO" then
	    Form.OpenNextPopup("mbbdm85200", "", "")
    
    'CFD 미등록 메시지박스
    elseif sKeyName == "CFD_MSG_RESULT" then
	    if sRet == "ok" then
'		    Form.OpenScreen("41000", "")
'			Form.OpenScreen("94000", "")
			
			'로그인 상태에서 back되면 꼬이므로. nextpopup으로 변경함
			'Form.OpenPopup("mbonl94000", "", "")
			
			Form.SetSharedData("&SCREEN_AUTH" , "")
			
			Form.OpenNextPopup("mbonl94000", "", "")
	    else
			'개설상품 선택 단계로 이동
			Form.OpenNextPopup("mbbdm86120", "StepBack", "")
	    end if
	    
	elseif sKeyName == "CLOSE" then	
		'Form.OpenNextPopup("mbbdm86120", "", "")
		Form.OpenNextPopup("mbbdm86120", "StepBack", "")
    
    '이수전용 개설여부 확인 메시지박스
'    elseif sKeyName = "ReTryPrcd2" Then
'	    If sRet = "no" Then  'ok.예 no.아니오
'		    '화면 구성상 닫으면 바로 초기 안내화면 나옴
'		    Form.CloseForm()
'		    
'	    ElseIf sRet = "ok" Then
'			'v0006 중개형 ISA일때만 개설구분값 저장 
'			'If g_BDM_ISA_PROD_TYPE == "3" then
'			'Form.showAlert("알림" , "g_BDM_ISA_ACNT_YN" & g_BDM_ISA_ACNT_YN)
'			if g_BDM_ISA_ACNT_YN <> "N" then
'				g_BDM_ISA_ACNT_OPNG_CLCD = "2" '이수개설
'			End If
'			'jsi
'		    '비대면계좌개설 상품별 개설가능 체크 조회
'			DATAMANAGER.RequestTranData( "obaci_acct_400r" )
'	    End if
    End If
End Sub
'============================================================================
Sub imgBack_OnClick()
    g_Back_Flag = "Y"

    '100.비대면계좌개설, 0xx.비대면 업무신청
    If (g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1) Then
	    
	    '개설상품 선택 단계로 이동
	    Form.OpenNextPopup("mbbdm86120", "StepBack", "")
	    
	    
        '(진행중인~~ 이어하기~~ 있습니다)  => (  괄호내 이어가기~ 문구 삭제 By박정숙Cha
        'Form.OpenPopup("mbbdm85100_p9" , "100" , "5")  '100.위치? 5.백그라운드회색처리
'        Form.MsgBox("알림", "계좌개설을 중단하시겠습니까?", "Exit", "2")  '2.예/아니오
    '0xx.비대면업무신청 3xx.모바일OTP발급 999.비대면진행상태확인
    Else 
        '세분화처리함 
        'Form.OpenPopup("mbbdm85200_p9" , "100" , "5")
        tmpMsg = ""
        If (g_sz_SubNmetBswrGb == "3" Or g_sz_SubNmetBswrGb == 3) Then
            tmpMsg = "모바일OTP 업무처리를 중단하시겠습니까?"
        ElseIf (g_sz_SubNmetBswrGb == "9" Or g_sz_SubNmetBswrGb == 9) Then
            tmpMsg = "진행상태확인 업무를 중단하시겠습니까?"
        Else  'If (g_sz_SubNmetBswrGb == "0" Or g_sz_SubNmetBswrGb == 0) Then
            tmpMsg = "업무신청을 중단하시겠습니까?"
        End If
        Form.MsgBox("알림", tmpMsg, "Exit", "2")  '2.예/아니오
    End If
End Sub
