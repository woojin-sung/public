    Form.SetSharedData("BDM_CNFR_PW_PIP"     , "")  '신규종합비밀번호확인
    Form.SetSharedData("BDM_BANKNAME"        , "")  '본인인증 은행명
    Form.SetSharedData("BDM_RCMD_YN"         , "")  '투자권유여부
    Form.SetSharedData("BDM_INFO_OFER_YN"    , "")  '투자성향 정보제공여부
    Form.SetSharedData("BDM_CHK_KYC"         , "")  '설문등록여부
    Form.SetSharedData("BDM_KYC_GRAD"        , "")  '투자성향등급
    Form.SetSharedData("BDM_PROD_GRAD"       , "")  '상품등급
