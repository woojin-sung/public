	g_CFDYN		= Form.GetSharedData("BDM_PRCDCFD"		, false)	'CFD 가입여부
	g_ACFDYN		= Form.GetSharedData("BDM_PRCD137"		, false)	'해외CFD 가입여부
	g_ISA_PROD_TYPE	= Form.GetSharedData("BDM_ISA_PROD_TYPE"	, false)	'ISA 타입
	g_PNSNYN		= Form.GetSharedData("BDM_PRCD131"	, false	)		'연금저축 가입여부
	g_WRAPYN		= Form.GetSharedData("BDM_WRAP"		, false	)		'랩 가입여부
	g_SAYN		= Form.GetSharedData("BDM_PRCD200"		, false	)	'다드림 가입여부
	
	g_BDM_MANG_BRCD = Form.GetSharedData("BDM_MANG_BRCD"		, false)	'관리점

End Function
'============================================================================
Function NextStep()

'화면오픈후현재창닫아야하는경우 : Form.OpenNextPopup()  -> 별도의Form.CloaseForm() 불필요
'화면오픈만하는경우 : Form.OpenPopup()

    '이전 ---------------------------------------------------------------------
    If g_Opng_File == "HOME" Then
        '공유변수 설정
        User_SharedData_Set("Init")
        Form.SetSharedData("BDM_NMETBSWRGB", "") '업무 중단인경우, 업무구분도 초기화처리
        Form.SetSharedData("BDM_CONNECTING", "") '업무 중단인경우, (계좌개설/업무신청)안내화면에서 넘어오는 진행상태구분 초기화처리
        Form.SetSharedData("&SCREEN_AUTH"  , "") '비대면화면 권한프리

        '휴대폰본인인증 이전단계는 최초진입점으로 위치
'Form.ShowAlert("g_BDM_FRST_MAPID", "["..g_BDM_FRST_MAPID.."]")    
        If g_BDM_FRST_MAPID ~= "" And g_BDM_FRST_MAPID ~= null Then
            '시장종합으로 가는경우에는 OpenScreen()으로 처리
            If g_BDM_FRST_MAPID == "screen41000" Then
                Form.OpenScreen("41000", "")        
                Form.CloseForm()
            Else
                'Form.OpenPopup(g_BDM_FRST_MAPID, g_Send_Data, "")
                Form.OpenNextPopup(g_BDM_FRST_MAPID, g_Send_Data, "")
            End If
        Else
            Form.CloseForm()
        End If

    '개설/업무신청 처리 불가 --------------------------------------------------
    ElseIf g_Opng_File == "ERROR" Then
        '공유변수 설정
        User_SharedData_Set("Init")
        Form.SetSharedData("&SCREEN_AUTH" , "") '비대면화면 권한프리

        'Form.OpenPopup("mbbdm85111", g_Send_Data, "")
        Form.OpenNextPopup("mbbdm85111", g_Send_Data, "")

    '다음 ---------------------------------------------------------------------
    ElseIf g_Opng_File == "NEXT" Then   
        '공유변수 설정
        User_SharedData_Set("")

        '진행상태확인
        If g_sz_SubNmetBswrGb == "9" Or g_sz_SubNmetBswrGb  == 9 Then
            '계좌개설진행상태조회
            If g_SCR_NO == "85184" Or g_SCR_NO == 85184 Then
                 'Form.OpenPopup("mbbdm85183", "85184", "")
                 Form.OpenNextPopup("mbbdm85183", "85184", "")
             '업무신청진행상태조회
             ElseIf g_SCR_NO == "85183" Or g_SCR_NO == 85183 Then
                 'Form.OpenPopup("mbbdm85183", "85183", "")
                 Form.OpenNextPopup("mbbdm85183", "85183", "")
             Else

                 '계좌개설신청안내_진행상태조회
                 If g_BDM_CONNECTING == "1" Or g_BDM_CONNECTING == 1 Then
                     Form.OpenNextPopup("mbbdm85183", "85184", "")
                 '비대면업무신청안내_진행상태조회
                 ElseIf g_BDM_CONNECTING == "2" Or g_BDM_CONNECTING == 2 Then
                     Form.OpenNextPopup("mbbdm85183", "85183", "")
                 Else
				  
                     '로그인화면에서 들어오는 경우, 
                     Form.OpenNextPopup("mbbdm85183", "85184", "")
                 End If
             End If
	    
	    '업무신청
	    ElseIf g_sz_SubNmetBswrGb == "0" Or g_sz_SubNmetBswrGb  == 0 Then
		     if g_BDMNMETBSWRGB == "010" then
			     '단기다수개설 출금고제한 계좌조회
			     DATAMANAGER.RequestTranData( "obaci_nmet_017r" )
		     else
			     Form.OpenNextPopup("mbbdm86150", g_Send_Data, "")
		     end if 
		     
        '비대면계좌개설/비대면업무신청/모바일OTP -> 신분증진위확인
        Else
            'Form.OpenPopup("mbbdm85120", g_Send_Data, "")
'		   g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
		   
		     if gOVRL_ACNT_OPNG_YN == "Y" then
			     g_MNY_ACNT_YN = "Y"
		     end if
		     
			if g_MNY_ACNT_YN == "Y" then
				Form.OpenPopup("mbbdm86131" , "" , "")
				exit function
			end if
			
			'CFD목표시장비교
			if g_CFDYN == "Y" or g_ACFDYN == "Y" then
				f_Check_CFDTarMarket()
				exit function
			end if
			
			'약관단계로 이동
			Form.OpenNextPopup("mbbdm86140", g_Send_Data, "")
        End If

    Else
    
        '이어하기 화면설정되어 있는 경우
        If g_Opng_File ~= "" And g_Opng_File ~= null Then
            '공유변수 설정
            User_SharedData_Set("")

            Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
            
        Else
            '공유변수 설정
            User_SharedData_Set("Init")

            '최초진입점으로 위치
            If g_BDM_FRST_MAPID ~= "" And g_BDM_FRST_MAPID ~= null Then
                Form.OpenNextPopup(g_BDM_FRST_MAPID, g_Send_Data, "")
            Else
                Form.CloseForm()
            End If
        End If
    End If
End Function

'============================================================================
'f_SetCusType : 투자자타입 리턴
'============================================================================
Function f_SetCusType()	
	Dim szCusType
	If g_BDM_PRSN_PFIN_YN == "Y" Then
		szCusType =  "1"   '개인전문투자자
	Else
		'v0003 당연/전환가능/일반 체크 변경
		If g_BDM_PFIN_YN = "Y" Then
		    If g_BDM_PFIN_CLS_CODE == "1" Then
		         szCusType =  "3"   '당연
		    Else
		         szCusType =  "2"   '전환가능
		    End If
		Else
		    szCusType =  "0"   '일반
		End If
	End If
	return szCusType
End Function

'============================================================================
'f_Check_TarMarket() : CFD목표시장 팝업 체크 
'============================================================================
Function f_Check_CFDTarMarket()
	Dim szCusType
	szCusType = f_SetCusType()	
	'v0003 당연전문투자자는 목표시장비교 Skip
	If g_BDM_PFIN_YN == "Y" then	'전문투자자 등록 여부
		If g_BDM_PFIN_CLS_CODE == "1" Then
			Form.SetSharedData("BDM_REG_SRNO", "")
			Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")
			Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
			Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")				     
			g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
			g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
			g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
			g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부			
			
			g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
			
			User_SharedData_Set("")
			
			'약관단계로 이동
			g_Opng_File = "mbbdm86140"
			g_Send_Data = ""
			
			NextStep()
		Else
			g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
			g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
			g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
			g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부

			'CFD 상품 개설 선택시 목표시장 팝업 호출
			If g_CFDYN == "Y" And g_ACFDYN == "Y" Then
				If g_BDM_REG_SRNO == "" Or g_BDM_ACFD_REG_SRNO == "" Then
					Form.OpenPopup("mbbdm86132", "136".."★"..szCusType.."★".."2", "")	'상품코드+ 고객유형 + 처리횟수
				Else
					g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
					
					User_SharedData_Set("")
					
					'약관단계로 이동
					g_Opng_File = "mbbdm86140"
					g_Send_Data = ""
					
					NextStep()
				End If
			Else
				If g_CFDYN == "Y" Then
					'Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
					'Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")	
					'g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
					'g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부	
					Form.SetSharedData("BDM_REG_SRNO", "")
					Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")	
					g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
					g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부					
					If g_BDM_REG_SRNO == "" Then
						Form.OpenPopup("mbbdm86132", "136".."★"..szCusType.."★".."1", "")
					Else
						g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
						
						User_SharedData_Set("")
						
						'약관단계로 이동
						g_Opng_File = "mbbdm86140"
						g_Send_Data = ""
						
						NextStep()
					End If
				ElseIf g_ACFDYN == "Y" Then				
					'Form.SetSharedData("BDM_REG_SRNO", "")
					'Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN", "")	
					'g_BDM_REG_SRNO			= Form.GetSharedData("BDM_REG_SRNO"			, false)	'국내CFD목표시장등록일련번호
					'g_BDM_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, false)	'국내CFD목표시장부적합여부
					Form.SetSharedData("BDM_ACFD_REG_SRNO", "")
					Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN", "")	
					g_BDM_ACFD_REG_SRNO			= Form.GetSharedData("BDM_ACFD_REG_SRNO"				, false)	'해외CFD목표시장일련번호
					g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부						
					If g_BDM_ACFD_REG_SRNO == "" Then
						Form.OpenPopup("mbbdm86132", "137".."★"..szCusType.."★".."1", "")
					Else
						g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
						
						User_SharedData_Set("")
						
						'약관단계로 이동
						g_Opng_File = "mbbdm86140"
						g_Send_Data = ""
						
						NextStep()
					End If				
				End If
			End if
		End If 
	Else
		if g_BDM_MANG_BRCD == "1065" then
			'계좌 보유 고객인경우 아닌경우 모두 전문투자자 안내페이지로 이동
			'Form.MsgBox("안내", "CFD 계좌는 당사에 전문투자자로 등록된 고객만 개설이 가능합니다.\n전문투자자 등록 후 다시 진행해주세요.\n\n만약, 당사에 보유계좌가 없다면 슈퍼365계좌 개설 후 전문투자자 등록을 하시고, CFD를 개설해 주세요.", "CFD_MSG_RESULT", 7, "등록절차 보기", "다른상품 개설")
			Form.MsgBox("안내", "CFD 계좌는 당사에 전문투자자로 등록된 고객만 개설이 가능합니다.\n전문투자자 등록 후 다시 진행해주세요.\n\n만약, 당사에 보유계좌가 없다면 Super365계좌 개설 후 전문투자자 등록을 하시고, CFD를 개설해 주세요.", "CFD_MSG_RESULT", 7, "등록절차 보기", "다른상품 개설")
		else
			'계좌 보유 고객인경우 아닌경우 모두 전문투자자 안내페이지로 이동
			Form.MsgBox("안내", "CFD 계좌는 당사에 전문투자자로 등록된 고객만 개설이 가능합니다.\n전문투자자 등록 후 다시 진행해주세요.\n\n만약, 당사에 보유계좌가 없다면 종합매매계좌 개설 후 전문투자자 등록을 하시고 CFD를 개설해 주세요.", "CFD_MSG_RESULT", 7, "등록절차 보기", "다른상품 개설")		
		end if
	End If
End Function

'============================================================================
Function CheckData()
    If Trim(contMain.edtName.caption) == "" Or Trim(contMain.edtName.caption) == null Then
        '(순서주의) 포커스후->Alert처리해야함
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtName.top, "1"))
        Form.ShowAlert("안내", "이름을 입력해주세요.")
        return False
    Else
        '이름 공백 체크
        sStr = Len(contMain.edtName.Caption)
        sRplStr = Len(replace(contMain.edtName.caption, " " , ""))
        If sStr <> sRplStr Then
            contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtName.top, "1"))
            Form.ShowAlert("안내", "이름을 입력해주세요.(공백 불가)")
            return False
        End If
    End If

'    If Trim(contMain.edtRcno.caption) == "" Or Trim(contMain.edtRcno.caption) == null Then
'        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
'        Form.ShowAlert("오류", "주민등록번호를 입력해주세요.")
'        return False
'    Else
''        nLen = Len(g_otpPwd)
''	
''        If CInt(nLen) < 13 Then
''            contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
''            Form.ShowAlert("오류", "주민번호를 확인해주세요.(13자리)")
''            return False
''        End If
'    End If

    If Trim(contMain.cmbMcco.caption) == "" Or Trim(contMain.cmbMcco.caption) == null Then
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
        Form.ShowAlert("안내", "통신사를 확인해주세요.")
        return False    
    End If
    '비대면계좌개설_알뜰폰은 테스트서버 && 테스트SKip일때만 허용
    'V0005 : 알뜰폰 제한 처리 제거.
'    If g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1 Then  '계좌개설
'        '통신사확인 0.SKT 1.KT 2.LGU+ 3.SK알뜰 4.KT알뜰 5.LG알뜰
'        nIdx = contMain.cmbMcco.currentindex
'        '개발서버인 경우, 
'        If (g_nDev == "1" Or g_nDev == 1) Then
'            '테스트Skip아닌 경우에는 알뜰폰 선택 불가
'            If CInt(chkSkip.checkstate) == 0 Then
'                If (nIdx == "3" Or nIdx == 3) Or (nIdx == "4" Or nIdx == 4) Or (nIdx == "5" Or nIdx == 5) Then
'                    contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
'                    Form.ShowAlert("오류", "알뜰폰을 이용한 휴대폰인증으로는 비대면계좌개설이 불가합니다. 고객님의 안전한 금융거래를 위해 영업점에 내점하시어 개설을 부탁드립니다.")
'                    return False
'                End If
'            End If
'        '운영서버_알뜰폰 불가
'        Else
'            If (nIdx == "3" Or nIdx == 3) Or (nIdx == "4" Or nIdx == 4) Or (nIdx == "5" Or nIdx == 5) Then
'                contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cmbMcco.top, "1"))
'                Form.ShowAlert("오류", "알뜰폰을 이용한 휴대폰인증으로는 비대면계좌개설이 불가합니다. 고객님의 안전한 금융거래를 위해 영업점에 내점하시어 개설을 부탁드립니다.")
'                return False
'            End If
'        End If
'    End If
'
    If Trim(contMain.edtHPNo.caption) == "" Or Trim(contMain.edtHPNo.caption) == null Then
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
        Form.ShowAlert("안내", "휴대폰번호를 입력해주세요.")
        return False
    ElseIf Mid(contMain.edtHPNo.caption,1,2) <> "01" Then 
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
        Form.ShowAlert("안내", "정확한 휴대폰번호를 입력해주세요.")
        return False
    Else
        If Len(contMain.edtHPNo.Caption) < 10 Or Len(contMain.edtHPNo.Caption) > 11 Then
            contMain.scroll_pos = CInt(Form.calcUnResize(contMain.edtHPNo.top, "1"))
            Form.ShowAlert("안내", "정확한 휴대폰번호를 입력해주세요.")
            return False
        End If
    End If

    If CInt(contMain.chkCtcnAgrm.checkstate) < 1 Then  '0.uncheck 1.check
        contMain.scroll_pos = CInt(Form.calcUnResize(contMain.btnCtcnAgrm.top, "1"))
        Form.ShowAlert("안내", "휴대폰 본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다.")
        return False
    End If
    
    return True
end Function 
'============================================================================
Function User_Stop_Timer()

    'sTimerID = 0 : 인증번호 요청
    'sTimerID = 1 : 인증확인 요청/요청검증
    'sTimerID = 2 : 인증유효시간
    'sTimerID = 3 : 단기다수계좌여부/대포통장명의인여부 확인
    'sTimerID = 4 : 사기계좌명의인여부 확인
    'sTimerID = 5 : 통신사콤보 자동펼치기
    
    Form.SetTimerEvent(0, 0, 1)
    Form.SetTimerEvent(1, 0, 1)
    Form.SetTimerEvent(2, 0, 1)
    Form.SetTimerEvent(3, 0, 1)
    Form.SetTimerEvent(4, 0, 1)
    Form.SetTimerEvent(5, 0, 1)
End Function 






'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form
'============================================================================
'============================================================================
Sub Form_OnFormInit()
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
    
    '로그인여부
    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )
    
	Form.SetSharedData("&SCREEN_AUTH"      , "" )
	
	'계좌개설 완료 -> 간편인증 바로 등록 시 사용하는 쉐어드 변수이므로
	'휴대폰인증 화면에서 먼저 클리어 해준다
	Form.SetSharedData( "NMET_SIMPLE_ATHN" , "" )
	Form.SetSharedData( "NMET_OTP_ISNC_YN" , "" )
	Form.SetSharedData("MeritzAuth_Security" , "" )
	
    'OSType 1.안드로이드 2.IOS
    g_sz_OSType = Form.GetSharedData("&OS_TYPE", False)
    'Form.ShowAlert("OS_VERSION", "["..g_sz_OSType.."](1.안드로이드 2.IOS)")
	
	'iOS 스크롤 제어용
	if g_sz_OSType == "2" then
		contMain.setExceptInvisibleCtl(true)
		contMain.setScrollAutoSize()
	else
		contMain.setScrollBarVisible("2")
	end if
	
    '메뉴에서 진입하는 입하므로 화면번호로 체크 
    g_SCR_NO = Form.GetSharedData( "&POPUP_SCREEN_NO" , False )

    User_SharedData_Get()

    '비대면업무구분1자리 설정
    g_sz_SubNmetBswrGb = Mid(g_BDMNMETBSWRGB,1,1)


    '비대면업무의 공유변수 일괄 초기화
	if g_sz_SubNmetBswrGb <> "1" and g_sz_SubNmetBswrGb <> 1 then
		User_SharedData_All_Init()
				
	end if

	contMain.lblSubTitle.caption = "본인 명의의 휴대폰으로 인증을 진행해주세요."

    '재요청버튼 문구
    contMain.btnAthnRetry.caption = "재요청 >"
    contMain.btnAthnRetry.fgcolor = 267   '검은색

    '비대면계좌개설만 진행상태 표시
    If g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1 Then
        imgStep.visible = True
    Else
        imgStep.visible = False
    End If

    '통신사정보-Default설정 없음
    'g_sz_HPCo = Form.GetSharedData("&PHONE_COMPANY_CODE", False )  '통신사 정보
    g_sz_HPNo = Form.GetSharedData("&PHONE_NUMBER"      , False ) '기기정보에서 읽어온 휴대폰번호(P로 시작하면 핸드폰번호, R로 시작하면 단말ID)
    'Form.ShowAlert("통신사정보", "["..g_sz_HPCo.."]["..g_sz_HPNo.."]")

    '테스트용 인증스킵 체크
    g_nDev = Form.GetSharedData("&SERVER_MODE", False )
    'Form.ShowAlert("SERVER_MODE(1.테스트)", nDev)
    If g_nDev == "1" Or g_nDev == 1 Then
'금보원앱심사까지 Hidden
'chkSkip.visible = False
'chkSkip.checkstate = "0"
        chkSkip.visible = True
        chkSkip.checkstate = "0"   '자동체크 제외 "1"  '자동체크
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If

    '본인인증구분
    g_sz_AthnGb = "1" '현재는 휴대폰본인인증만 함

    '서비스에 대한 토스메시지 제거
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_653a"   , False )  '인증번호 요청
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_654a"   , False )  '인증확인 요청
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_654a_1" , False )  '인증확인 요청검증
    DATAMANAGER.SetNotifyDataMessage( "obcsb_oimf_655r"   , False )  '인증결과 검증
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_072r"   , False )  '비대면계좌개설 이어하기 조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_072r_1" , False )  '비대면업무진행상태조회
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_049c"   , False )  '비대면계좌개설 이어하기 등록_0단계
    'DATAMANAGER.setNotifyDataMessage( "obaci_acct_049c_1" , False )  '비대면계좌개설 이어하기 취소
    DATAMANAGER.setNotifyDataMessage( "obcsb_nmet_102c"   , False )  '비대면본인인증및1원역이체관리

	'20230512 SWJ START
    '항목가이드 Default 설정 (267.검정색)
    contMain.edtName.SetApplyLabel   ("이름"         , 0, 267, "left", false)  'True.필수입력 / False.선택입력
    'edtRcno.SetApplyLabel   		("주민등록번호" , 0, 267, "left", false)
    contMain.cmbMcco.SetApplyLabel   ("통신사"       , 0, 267, "left", false, 111) 'HWG
    contMain.edtHPNo.SetApplyLabel   ("휴대폰번호"   , 0, 267, "left", false)
    contMain.edtAthnNo.SetApplyLabel ("인증번호"     , 0, 267, "left", false)
    

	'로그인 상태에서 간편인증 등록 시에는 full주민번호로 다 인증하자
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		g_fullRcnoPip = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
		g_RcnoPip     = Form.GetSharedData("&JUMIN_NUM" , false)   '주민번호 암호화 값
		Form.SetSharedData("Meritz_OTP_RCNOPIP" , g_fullRcnoPip)	'다음 단계에서 씀
	else
		g_fullRcnoPip  = Form.GetSharedData("Meritz_OTP_RCNOPIP"  , false )
	     g_RcnoPip       = Form.GetSharedData("Meritz_OTP_RCNO", false)
	end if

	g_otpACNO      = Form.GetSharedData("Meritz_OTP_ACNO" , false )
	g_otpPWD       = Form.GetSharedData("Meritz_OTP_PWD"  , false )
    
    '통신사선택콤보 타입 설정
    contMain.cmbMcco.cbtype = 5
    
    '헬퍼텍스트 설정
    contMain.edtName.SetUseResultLabel  (True, 1)  'True.사용가능 / False.사용불가, 라인수
    'edtRcno.SetUseResultLabel  (True, 1)
    contMain.cmbMcco.SetUseResultLabel  (True, 1)
    contMain.edtHPNo.SetUseResultLabel  (True, 1)
    contMain.edtAthnNo.SetUseResultLabel(True, 2)
	
	'이름 키패드 활성화
	Form.SetTimerEvent2(51, 1, 0.3)
	
    '기입력정보 재설정
    'strStepBackYN = Form.GetSharedData("StepBackYN", True) 'False
    sRevData = Form.GetOpenLinkData()
    If sRevData == "StepBack" Then
        '컨트롤 모두보이기
        contMain.edtName.visible      = True   '이름
        'contMain.edtRcno.visible      = True   '주민등록번호
        contMain.cmbMcco.visible      = True   '통신사
        contMain.edtHPNo.visible      = True   '휴대폰번호
        contMain.btnCtcnAgrm.visible  = True   '약관동의
        contMain.chkCtcnAgrm.visible  = True
        contMain.imgAthnShow.visible  = True
        contMain.lblCtcnShow.visible  = True
        contMain.edtAthnNo.visible    = True   '인증번호
        '안드로이드 인증유효시간이 표시가 되지 않아 true -> false 처리
        contMain.lblAthnTime.visible  = True  '인증유효시간 -> ReTry버튼클릭시,visible True
        contMain.lblAthnTime.bringFront("1")   '인증유효시간을 제일앞단으로 위치시킴
        'contMain.lblAthnTime.visible  = False
        contMain.btnAthnRetry.visible = True   '인증번호재요청
        contMain.btnAthnRetry.ebable  = True
        g_Frst_YN = "N" 

        '스크롤설정 체크용 변수 설정
        g_Cntt1 = "Y"
        g_Cntt2 = "Y"
        g_Cntt3 = "Y"
        g_Cntt4 = "Y"
        g_Cntt5 = "Y"
        g_Cntt6 = "Y"

        '스크롤 설정
        nContResize = 0
        nTop = 0
        nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + CInt(Form.calcUnResize(contMain.btnCtcnAgrm.top, "1"))
        nTop = CInt(Form.calcUnResize(contMain.edtAthnNo.top, "1"))
        contMain.lblScrollPos.top = nContResize
        contMain.SetScrollAutoSize()
        contMain.scroll_pos = nTop
        
        '신분증단계로 넘긴 입력정보 다시 설정
        '단, 화면이 넘어온 경우, 인증은 다시 받아야 함
        g_BDM_NAME          = Form.GetSharedData("BDM_NAME"         , False)  '이름
        g_BDM_RCNO_PIP      = Form.GetSharedData("BDM_RCNO_PIP"     , False)  '주민등록번호
        g_BDM_COMPANY_CODE  = Form.GetSharedData("BDM_COMPANY_CODE" , False)  '통신사 정보
        g_BDM_HP1           = Form.GetSharedData("BDM_HP1"          , False)  '휴대폰번호
        g_BDM_HP2           = Form.GetSharedData("BDM_HP2"          , False)
        g_BDM_HP3           = Form.GetSharedData("BDM_HP3"          , False)

        contMain.edtName.caption        = Trim(g_BDM_NAME)          '이름
        'edtRcno.caption        = Trim(g_BDM_RCNO_PIP)      '주민등록번호
        contMain.cmbMcco.cbkeydata      = Trim(g_BDM_COMPANY_CODE)  '통신사
        contMain.edtHPNo.caption        = Trim(g_BDM_HP1)..Trim(g_BDM_HP2)..Trim(g_BDM_HP3)  '휴대폰번호
        contMain.chkCtcnAgrm.checkstate = "1" '약관동의
    End If
    '20230512 SWJ END
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
   
    '휴대폰 본인인증 약관동의 -----------------------------------------------
    If sKeyName == "mbbdm85110_p1" Then
        If sRet == "ok" Then
            '약관동의 체크
            If contMain.chkCtcnAgrm.checkstate == "0" Or contMain.chkCtcnAgrm.checkstate == 0 Then  '0.uncheck 1.check
                contMain.chkCtcnAgrm.checkstate = "1"
                contMain_chkCtcnAgrm_OnChange("1")
            End If
        End If

    elseif sKeyName == G_MERITZ_SECURITY_FILE or sKeyName == G_MERITZ_QUESTION_FILE or sKeyName == G_MERITZ_MOTP_FILE or sKeyName == G_MERITZ_OTP_FILE or sKeyName == G_MERITZ_SOTP_FILE then
	    if sRet == "ok" then
		    g_closeflag = true
		    Form.CloseForm()
		else
		    Form.CloseForm()
		end if
	End If
	
	if sKeyName == "mhetc90190_p1" then
		Form.CloseForm()
	end if
End Sub
'============================================================================
' IOS-인증문자 자동 설정
Sub Form_OnTriggerEvent(sEventName, sParam)
    If sEventName == "event_HpCertNo" Then
        If sParam <>"" Then
            strData = Split(sParam,":")
            If len(strData[1]) == 8 Then
                strCertNo = Mid(strData[1],2,6)
                contMain.edtAthnNo.caption = strCertNo
            End If
        End If
    End If
End Sub
'============================================================================
' 본인인증용 타이머
Sub Form_OnTimerEvent(sTimerID)

    'sTimerID = 0 : 인증번호 요청
    'sTimerID = 1 : 인증확인 요청/요청검증
    'sTimerID = 2 : 인증유효시간
    'sTimerID = 3 : 단기다수계좌여부/대포통장명의인여부 확인
    'sTimerID = 4 : 사기계좌명의인여부 확인
    'sTimerID = 5 : 통신사콤보 자동펼치기

    '인증번호 요청 -------------------------------------------------------
    If  sTimerID == 0 Or sTimerID == "0" Then
        '인증요청 타이머종료
        Form.SetTimerEvent(0, 0, 1)

        '인증유효횟수 설정
        g_nCnt = CInt(g_nCnt) + 1

        '인증유효횟수 초과 체크
        If CInt(g_nCnt) > 10 Then
            contMain.edtAthnNo.SetResultLabel("1","error","본인인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.","contMain")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
            Exit Sub
        End If

        '인증확인 요청
        DATAMANAGER.RequestTranData "obcsb_oimf_654a"

    '인증확인 요청검증 -------------------------------------------------------
    ElseIf sTimerID == 1 Or sTimerID == "1" Then
        '검증요청 타이머종료
        Form.SetTimerEvent(1, 0, 1)

        '인증유효횟수 설정
        g_nCnt = CInt(g_nCnt)+1

        '인증유효횟수 초과 체크
        If CInt(g_nCnt) > 10 Then
            contMain.edtAthnNo.SetResultLabel("1","error","SMS 검증요청이 실패하였습니다. 잠시 후 다시 시도해 주십시오.","contMain")

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True

            '3분 타이머 초기화
            InitCountTimer()
            Exit Sub
        End If

        '인증결과 검증
        DATAMANAGER.RequestTranData "obcsb_oimf_655r"

    '휴대폰본인인증 유효시간(3분) -------------------------------------------------------
    ElseIf sTimerID == 2 Or sTimerID == "2" Then
        If g_HPSec == 0 Then
            contMain.edtAthnNo.SetResultLabel("1","error","인증시간이 만료되었습니다.\n다시 시도하여 주시기 바랍니다","contMain")

            '유효시간체크 종료
            Form.SetTimerEvent(2, 0, 1)

            '인증번호 재요청버튼 Show
            contMain.edtAthnNo.caption    = ""
            contMain.edtAthnNo.enable     = False
            contMain.btnAthnRetry.visible = True
            contMain.btnAthnRetry.enable  = True
            
            '시간만료시엔 초기화시키지 않는다
            contMain.lblAthnTime.caption = "0:00"
	    
            '3분 타이머 초기화
'            InitCountTimer()
        Else
            Dim nMin, nSec
            nMin  = Int(CInt(g_HPSec) / 60 )
            nSec  = CInt(g_HPSec) Mod  60
            If Len(nSec) == 1 Then
                nSec = "0"..nSec
                nSec = nSec
            End If

            '#:##
            contMain.lblAthnTime.caption = nMin..":"..nSec
            g_HPSec = CInt(g_HPSec)-1
        End If

    '단기다수계좌여부/대포통장명의인여부 확인 -------------------------------------------------------
    ElseIf sTimerID == 3 Or sTimerID == "3" Then
        '정보송신 타이머종료
        Form.SetTimerEvent(3, 0, 1)

        '송신유효횟수 설정
        g_nCnt_091_1 = CInt(g_nCnt_091_1) + 1

        '송신유효횟수 초과 체크
        If CInt(g_nCnt_091_1) > 7 Then
		   btnNext.enable = true	'20230419 추가
		   
		   btnNext.btnimage = "btn_20.9"
			btnNext.fgcolor = "273"
		   
            'contMain.edtAthnNo.SetResultLabel("1","error","은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.","contMain")
            Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")

            '3분 타이머 초기화
            'InitCountTimer()

            Exit Sub
        End If

        '단기다수계좌여부/대포통장명의인여부 확인
        DATAMANAGER.RequestTranData "obaci_acct_091r_1"

    '사기계좌명의인여부 확인 -------------------------------------------------------
    ElseIf sTimerID == 4 Or sTimerID == "4" Then
        '정보송신 타이머종료
        Form.SetTimerEvent(4, 0, 1)

        '송신유효횟수 설정
        g_nCnt_096 = CInt(g_nCnt_096) + 1

        '송신유효횟수 초과 체크
        If CInt(g_nCnt_096) > 7 Then
		   btnNext.enable = true	'20230419 추가
		   
		   btnNext.btnimage = "btn_20.9"
			btnNext.fgcolor = "273"
		   
            'contMain.edtAthnNo.SetResultLabel("1","error","은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.","contMain")
            Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")

            '3분 타이머 초기화
            'InitCountTimer()
            Exit Sub
        End If

        '사기계좌명의인여부 확인
        DATAMANAGER.RequestTranData "obaci_acct_096r"

    'LES START
    '통신사콤보 포커싱 및 자동펼치기
    ElseIf sTimerID = "5" Or sTimerID = 5 Then
        Form.SetTimerEvent2(sTimerID, 0, 0.8)

'Form.ShowAlert("a", contMain.cmbMcco.caption)
        If CInt(contMain.cmbMcco.currentindex) < 1 And Trim(contMain.cmbMcco.caption) == "통신사를 선택해주세요" Then
            contMain.cmbMcco.openList()
        End If

	
    End If
    
    'v0002 sta 은합회 결과값에 따라 체크 
    '안드로이드는 num, 아이폰은 string으로 받음
'	If sTimerID == 10 or sTimerID == "10" then
'		Form.SetTimerEvent( 10, 0, 1 )
'		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
'	End If
	
'	If sTimerID == 11 or sTimerID == "11" then
'		Form.SetTimerEvent( 11, 0, 1 )
'		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
'	End If
	
'	If sTimerID == 12 or sTimerID == "12" then
'		Form.SetTimerEvent( 12, 0, 1 )
'		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
'	End If
	
'	If sTimerID == 13 or sTimerID == "13" then
'		Form.SetTimerEvent( 13, 0, 1 )
'		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
'	End If
		
	if sTimerID == 20 or sTimerID == "20" then
		Form.SetTimerEvent2(20, 0, 0.1)
		
		g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
					
		User_SharedData_Set("")
		
		'약관단계로 이동
		g_Opng_File = "mbbdm86140"
		g_Send_Data = ""
		
		NextStep()
	end if
	if sTimerID == 21 or sTimerID == "21" then
		Form.SetTimerEvent2(21, 0, 0.1)
		
		g_BDM_CLEAR_YN = "Y"    'Y:처음부터하기 N: 이어하기
						
		User_SharedData_Set("")
		
		'약관단계로 이동
		Form.OpenNextPopup("mbbdm86140", g_Send_Data, "")
	end if
	
	'통신사 선택 후 휴대전화번호 키패드 자동 노출
	if sTimerID == 50 or sTimerID == "50" then
		Form.SetTimerEvent2(50, 0, 0.1)
		contMain.edtHPNo.SetShowKeypad(True)
	end if
	
	'화면 오픈 후 이름 키패드 자동 노출
	if sTimerID == 51 or sTimerID == "51" then
		Form.SetTimerEvent2(51, 0, 0.1)
		contMain.edtName.SetShowKeypad(True)
	end if
End Sub



'============================================================================
' 입력항목 Show
' 이름 -> 주민등록번호 -> 통신사 -> 휴대폰번호 -> 약관 -> 인증번호 순으로 Show
'============================================================================
'============================================================================
Sub contMain_edtName_OnEditComplete() '이름
    g_Cntt1 = "Y"  '스크롤설정 체크용 변수 설정

    nTop = 0
    nContResize = 0

    If contMain.edtName.caption ~= "" Or contMain.edtName.caption ~= null Then
        If Len(replace(contMain.edtName.caption, " " , "")) == 0 Then
             contMain.edtName.SetResultLabel("1","error","이름을 입력해주세요.","contMain")
             Exit Sub
        Else
            '이름 공백 체크
            sStr = Len(contMain.edtName.Caption)
            sRplStr = Len(replace(contMain.edtName.caption, " " , ""))
            If sStr <> sRplStr Then
                contMain.edtName.SetResultLabel("1","error","이름을 확인해주세요.(공백 불가)","contMain")
                Exit Sub
             End If
        End If

       contMain.edtName.SetResultLabel("0","complete","","contMain")

        '스크롤 설정
        '아래컨트롤이 오픈된 후에는 스크롤증가 없음
        'If contMain.edtRcno.visible == True Then
        If g_Cntt2 == "Y" Then
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1"))
        Else
            nContResize = CInt(Form.calcUnResize(contMain.lblScrollPos.top, "1")) + 120 'HWG 'CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        End If
        'LES nTop = CInt(Form.calcUnResize(contMain.edtRcno.top, "1"))
        nTop = CInt(Form.calcUnResize(contMain.edtName.top, "1"))

        '항목을 위로 올리면서 스크롤을 늘리기 위해 컨테이너상의 마지막 컴포턴트 위치를 아래로 강제 처리함
        contMain.lblScrollPos.top = nContResize
        '스크롤사이즈 자동조정
        contMain.SetScrollAutoSize()
        '현재 스크롤위치 설정
        contMain.scroll_pos = nTop

        '통신사 Show
        g_Cntt2 = "Y"  '스크롤설정 체크용 변수 설정
        'contMain.edtRcno.visible = True

        '주민등록번호 입력키보드 자동보이기
        'If contMain.edtRcno.caption == "" Or contMain.edtRcno.caption == null Then
            '일반키패드(단말지원)->보안키패드(내부) 자동오픈에 따른 오류방지
            '일반키패드에서 입력완료가 아닌 키패드외부 선택에 따라 키패드가 닫힌상태에서 뒤로가기(업무종료시키는 경우)시
            '입력완료로 판단되어 화면은 안내페이지로 돌아가지만 보안키패드가 올라왔다가 앱이 죽는 현상 발생
        '    If g_Back_Flag <> "Y" Then
         contMain.cmbMcco.visible = True
	       
	       'LES
		'통신사 -리스트 자동보이기
		'If contMain.cmbMcco.cbkeydata == "" Or contMain.cmbMcco.cbkeydata == null Then
		Form.SetTimerEvent2(5, 1, 0.8)
			
		if contMain.cmbMcco.cbkeydata == "" Or contMain.cmbMcco.cbkeydata == null then
			contMain.cmbMcco.Setstatus("focus")
		end if
        '    End If
        'End If
    End If
End Sub
