Sub btnNext_OnClick()
    '신분증진위확인에 넘길 공유변수 설정
    g_BDM_NAME          = contMain.edtName.caption
    'g_BDM_RCNO_PIP      = edtRcno.caption
    g_BDM_COMPANY_CODE  = contMain.cmbMcco.cbkeydata
    g_BDM_HP1           = Mid(contMain.edtHPNo.caption, 1,3)
    If Len(Trim(contMain.edtHPNo.caption)) == 10 Then '###-####
        g_BDM_HP2   = Mid(contMain.edtHPNo.caption, 4,3)
        g_BDM_HP3   = Mid(contMain.edtHPNo.caption, 7,4)
    Else  '####-####
        g_BDM_HP2   = Mid(contMain.edtHPNo.caption, 4,4)
        g_BDM_HP3   = Mid(contMain.edtHPNo.caption, 8,4)
    End If
    
    '필수항목체크
    If CheckData() = True Then
	    btnNext.enable = False
	    
		If Form.GetEnvData("common.theme") = "black" Then
			btnNext.btnimage = "btn_27.9"
		Else 
			btnNext.btnimage = "btn_21.9"
		End If
		btnNext.fgcolor = "269"
	     
	     SetSecurityOpen()
	    
'        '100.비대면계좌개설
'        If (g_sz_SubNmetBswrGb == "1" Or g_sz_SubNmetBswrGb == 1) Then
'			DATAMANAGER.RequestTranData("obaci_acct_091r")
'			
'
'        '0xx.비대면업무신청 3xx.모바일OTP발급
'        ElseIf (g_sz_SubNmetBswrGb == "0" Or g_sz_SubNmetBswrGb == 0) Or (g_sz_SubNmetBswrGb == "3" Or g_sz_SubNmetBswrGb == 3) Then
'            '휴대폰인증완료 등록(등록고유번호채번)
'            DATAMANAGER.RequestTranData("obcsb_nmet_102c")
'    
'        '999.비대면진행상태확인
'        Else
'            '비대면업무 진행상태확인
'            'DATAMANAGER.RequestTranData("obaci_acct_072r_1")
'		    DATAMANAGER.RequestTranData("obaci_acct_058r")
'
'        End If    
    End If
End Sub
'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	
	'모바일OTP 인증화면에서
	'로그아웃 상태에서 520r 서비스 input을 ID로 태우지 않기 위함 
	Form.SetSharedData("IdRegPros", "Y")
	Form.SetSharedData("IdRegProsAcno", g_otpACNO)
	
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
	
	if g_sGubunCode == "0" then '보안카드
		'보안카드 화면에도 모바일OTP 발급 프로세스를 만들거라고 함
		Form.SetSharedData("MeritzAuth_Security", "MOTP")
	
		Form.OpenFramePopup( G_MERITZ_SECURITY_FILE , "MeritzAuth" & "★" , "" )	'보안카드풀팝업
	
	'해당케이스는 삭제되었다고 함	
	elseif g_sGubunCode == "1" then '부가정보
		Form.OpenFramePopup( G_MERITZ_QUESTION_FILE , "" , "" )	'부가정보풀팝업
		
	elseif g_sGubunCode == "3" then 'OTP
		
		if g_MotpYN == "M" then
			if g_motpAppYN <> "00000" then
				Form.OpenNextPopup( "mhetc90190_p1", "", "")					'안내 팝업
				exit function
			end if
					
			'모바일otp 발급이 완료된 이후, 사설인증 프로세스로 돌아오기 위한 데이터 
			'(모바일OTP가 원장에는 등록 상태지만, 앱에 정보가 없는경우)
			'(인증화면 오픈 후에 발급화면으로 이동시킴)
			'(그래서 모바일OTP를 열 때 화면 오픈 전에 Set을 해줘도 될듯)
			Form.SetSharedData("MeritzAuth_Security", "MOTP")
			
			Form.OpenPopup( G_MERITZ_MOTP_FILE , "motp_success" , "")	'MOTP
		'스마트OTP
		elseif g_MotpYN == "Y" then
		
			'스마트OTP 화면에도 모바일OTP 발급 프로세스를 만들거라고 함
			Form.SetSharedData("MeritzAuth_Security", "MOTP")
			
			Form.OpenFramePopup( G_MERITZ_SOTP_FILE , "MeritzAuth" & "★" , "")	'스마트OTP
		
		'OTP
		else
			Form.OpenPopup( G_MERITZ_OTP_FILE , "otp_success" , "")	'OTP
		end if

	elseif g_sGubunCode == "2" then '없을경우
		Form.OpenNextPopup( "mhetc90190_p1", "", "")					'안내 팝업
		
	else '에러
		Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		
		if chkSkip.checkstate == "1" Then
		    Form.SetSharedData("Meritz_OTP_PhoneNum" , contMain.edtHPNo.Caption )
		    Form.SetSharedData("Meritz_OTP_CustName" , contMain.edtName.Caption )
	    end if
	end if
	
End Function


