'============================================================================
Sub contMain_edtAthnNo_OnEditComplete()  '인증번호
    If contMain.edtAthnNo.caption == "" Or contMain.edtAthnNo.caption == null Then
        contMain.edtAthnNo.SetResultLabel("1","error","인증번호가 입력되지 않았습니다.","contMain")
        Exit Sub
    Else
        If Len(Trim(contMain.edtAthnNo.caption)) == 0 Then
            contMain.edtAthnNo.SetResultLabel("1","error","인증번호가 입력되지 않았습니다.","contMain")
            Exit Sub
        ElseIf Len(Trim(contMain.edtAthnNo.caption)) > 0 And Len(Trim(contMain.edtAthnNo.caption)) < 6  Then
            contMain.edtAthnNo.SetResultLabel("1","error","인증번호를 확인해주세요.(숫자 6자리)","contMain")
            Exit Sub
        End If
    End If

    contMain.edtAthnNo.SetResultLabel("0","complete","","contMain")

    '인증확인 요청검증
    DATAMANAGER.RequestTranData( "obcsb_oimf_654a_1")
End Sub




