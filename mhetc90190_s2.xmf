'============================================================================
'인증번호 만료기간 3분 타이머 초기화
Function InitCountTimer()
	btnNext.enable = true	'20230417 추가
	
	btnNext.btnimage = "btn_20.9"
	btnNext.fgcolor = "273"
	
    contMain.lblAthnTime.caption = "3:00"
    contMain.lblAthnTime.visivle = False
    g_HPSec = 180
    Form.SetTimerEvent(2, 0, 1)  '3분타이머 종료
End Function
'============================================================================
'(공통)진행불가안내
Function CommErrClose(gb)
	btnNext.enable = False	'20230419 추가
	
	If Form.GetEnvData("common.theme") = "black" Then
		btnNext.btnimage = "btn_27.9"
	Else 
		btnNext.btnimage = "btn_21.9"
	End If
	btnNext.fgcolor = "269"
	
    '에러메시지코드 조립
    'E + 업무구분(1) + 오류코드(2)
    strErrCode = "E"..g_sz_SubNmetBswrGb..gb
    'Form.ShowAlert("ErrorCode", strErrCode)

    '개설불가 안내 후, 종료
    g_Opng_File = "ERROR"     '오픈할화면
    g_Send_Data = strErrCode  '인자정보

    NextStep()
End Function
'============================================================================
Function User_SharedData_All_Init()

    '진입정보, 1단계(휴대폰인증,신분증진위확인) 정보외 뒷단업무에서 사용되는 공유변수 초기화(처리중 종료 후 재처리시, 이전 선택값 남아있는 오류해결)
