<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="51050" scrname="펀드별통보처지정_메인" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<ACCOUNT name="acnt0" bgcolor="052:255255255" itemcodetype="100,103,104,106,109,110,114,118,123,128,130,131,132,138,139,140,200" etcfunctions="" accpwdctl="edtPswd" ly_vert="20,10,335,35,1" />
		<EDIT name="edtPassword" fontsize="-2" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" imagefilepth="alpha" ly_vert="385,5,57,39,1" />
		<FORMTAB name="fmtab" tabcount="2" tabwidthtype="1" tabheadheight="36" ly_vert="0,53,375,509,1" >
			<PAGE name="0" caption="운용보고서" linkfile="mbfnp51050_t1" loadingtype="1" />
			<PAGE name="1" caption="펀드실질수익률보고서" linkfile="mbfnp51050_t2" loadingtype="1" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1590" _ulen="1518" >


'============================================================================
Sub Form_OnFormInit()
	Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "INIT_SCREEN", acnt0.total & acnt0.sequence)
End Sub

'============================================================================
Sub fmtab_OnTabChanged(nCurrentTab)
	Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "INIT_SCREEN", acnt0.total & acnt0.sequence)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'CDS 거래신청 할 종목 데이터 수신
	If sEventName == "SEND_REG_DATA" And sParam <> "" And sParam <> null Then
		Form.OpenPopup("mbonl88027_p7" , sParam , "")
	
	'상단 우측 유의사항
	ElseIf sEventName == "INFO_CLICK" Then
'		If CInt(fmtab.currenttab) == 0 Then
'			Form.OpenFramePopup("mbonl88027_p5" , "" , "")
'		Else
			Form.OpenFramePopup("mbonl88027_p6" , "" , "")
'		End If
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'신청완료 팝업에서부터 내려온 이벤트
	If sKeyName == "MOVE_TAB" And sRet <> "" And sRet <> null Then
		fmtab.currenttab = sRet
		
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "INIT_SCREEN", acnt0.total & acnt0.sequence)
	End If
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "INIT_SCREEN", acnt0.total & acnt0.sequence)
End Sub

	</SCRIPT_INFO>
