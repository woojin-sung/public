	<SCRIPT_INFO _len="6423" _ulen="6191" >
'============================================================================
' 화 면 명 : 방문판매인력조회(mbcpp10000.xmf)
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U   N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Edit0.caption = ""

	Call f_scrInit()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	'-----------------------------------------------------------------------
	' obcpp_cusr_163r 데이터 없을 경우
	'-----------------------------------------------------------------------
	if sKeyName == "NO_DATA" then
		Image0.visible	= false
		Edit0.caption		= ""
		Edit0.SetShowKeypad(true)
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'-----------------------------------------------------------------------
	' 인력조회 유의사항 팝업
	'-----------------------------------------------------------------------
	if sEventName == "INFO_CLICK" then
		Form.OpenPopup("mbcpp10000_p2" , "" , "")
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	' ----------------------------------------------------------------------
	' 방문판매인력다건조회(직원명)
	' ----------------------------------------------------------------------
	if szTranID == "obcpp_cusr_163r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FLNM", 0, Edit0.caption)
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	' ----------------------------------------------------------------------
	' 방문판매인력다건조회(직원명)
	' ----------------------------------------------------------------------
	if szTranID == "obcpp_cusr_163r" then
		Dim nCnt, nRowCnt
		nCnt 	= DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		nRowCnt	= grd01.rowcount

		if nCnt > 0 then
			
			for i = 0 to nCnt - 1
				Dim DPNM, FLNM, EMPNO, EMPL_CLPS_CODE_NAME
				DPNM 				= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DPNM", 				i)
				FLNM 				= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FLNM", 				i)
				EMPNO 				= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "EMPNO", 				i)
				EMPL_CLPS_CODE_NAME	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "EMPL_CLPS_CODE_NAME", 	i)

				grd01.insertrow = nRowCnt + i
				
				grd01.SetCellData("bd_DPNM", 	nRowCnt + i,  DPNM)
				grd01.SetCellData("bd_FLNM", 	nRowCnt + i,  FLNM & " " & EMPL_CLPS_CODE_NAME)
				grd01.SetCellData("bd_EMPNO", 	nRowCnt + i,  EMPNO)
				grd01.SetCellData("bd_button", 	nRowCnt + i , ">")
			next

			if DATAMANAGER.IsMoreNextData(szTranID) then
				DATAMANAGER.RequestNextData(szTranID)
			end if
			
			grd01.visible		= true
			Label2.visible 	= false
		else
			Form.MsgBox("알림", "해당 이름을 가진 방문판매직원이 없습니다.", "NO_DATA", 0)

			grd01.visible		= false
			Label2.visible 	= true
		end if

	end if

	DATAMANAGER.ClearInputData(0, szTranID)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", "[" & szErrCode & "]" & szErrMsg, true)
	
	Form_OnFormInit()
	
	DATAMANAGER.ClearInputData(0, szTranID)
End Sub

'============================================================================
' 검색어 삭제
'============================================================================
Sub Image0_OnClick()
	Image0.visible	= false
	Edit0.caption		= ""
	Edit0.SetShowKeypad(true)
End Sub

'============================================================================
' 검색어 삭제
'============================================================================
Sub Button0_OnClick()
	Image0.visible	= false
	Edit0.caption		= ""
	Edit0.SetShowKeypad(true)
End Sub

'============================================================================
' 직원검색
'============================================================================
Sub Edit0_OnEditComplete()

	if Edit0.caption <> "" then
		Call f_scrInit()
		
		DATAMANAGER.RequestTranData("obcpp_cusr_163r")
	end if
	
End Sub

'============================================================================
Sub Edit0_OnEditChar(CharCode)
	
	if CharCode <> "" then
		Image0.visible	= true
		Button0.visible	= true
	else
		Image0.visible	= false
		Button0.visible	= false
	end if
	
End Sub

'============================================================================
' 방문판매직원 그리드 클릭
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	Dim DPNM, FLNM, EMPNO
	DPNM		= grd01.GetCellData("bd_DPNM", lRow)
	FLNM		= grd01.GetCellData("bd_FLNM", lRow)
	EMPNO	= grd01.GetCellData("bd_EMPNO", lRow)
	
	' 부서명^직원명^직원번호
	Form.OpenPopup("mbcpp10000_p1", DPNM & "^" & FLNM & "^" & EMPNO, "")
End Sub

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 화면 초기화
'============================================================================
Function f_scrInit()
	grd01.rowcount 	= 0
	grd01.visible 	= false
	Label2.visible 	= true
End Function

