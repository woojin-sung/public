'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_지연이체
' 02. 화면설명 : 지연이체내역조회 및 취소 탭화면
' 03. 작    성 : 16.03.04 ~ 테스트3
' 04. 수    정 : 2021.02.22. 장원혁 v001 모바일OTP 적용
'20221111    김효준 : v008 : 이체종료안내추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szID         '사용자 아이디
Dim g_lRow 
Dim g_sOtpTrMsg
Dim plain_rm 
'***************************************************************************
'     P R I V A T E     F U N C T I O N
'***************************************************************************
Function SendCancel()
    '추가인증-> 보안매체-> 공인인증 순으로 처리 여부 확인 필요?
	'Form.OpenFramePopup("mhetc90060_p8" , "bank_reservation" , "")   
	'szDlog1  = Form. OpenDialog( "mhetc90060_p9", "" , "") '보안카드/OTP/스마트OTP
	'szDlog2  = Form. OpenDialog( "mhetc90060_p5", "" , "") '공인인증///
	'-> 팝업 리턴 처리?!
	
	   szACNO = Grid0.GetCellData( "bd_cell20", g_lRow)
	   szASNO = Grid0.GetCellData( "bd_cell21", g_lRow)	
	   szDate = Grid0.GetCellData( "bd_cell5", g_lRow)
	   szTime = Grid0.GetCellData( "bd_cell12", g_lRow)
	   szSrno = Grid0.GetCellData( "bd_cell22", g_lRow)
	   szDiv  = Grid0.GetCellData( "bd_cell23", g_lRow)
	   
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACPT_DATE", 0 , szDate )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACPT_SRNO" , 0 , szSrno )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "REG_ACNO" , 0 , szACNO )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "REG_ASNO" , 0 , szASNO )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , szDiv )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACPT_HOUR", 0 , szTime )
	   if plain_rm = "1" then
		   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("#edtPwd", "caption") )
	   else
	       DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("#edtPwd", "encdata") )
	   end if

       DATAMANAGER.RequestTranData( "obtss_elbs_011c" )
End Function

'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'===========================================================================

Sub Form_OnFormInit()
	Grid0.SetClear( )
	USE_YN_CHK() '종료체크 v008
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	g_szID = Form.GetSharedData("&USER_ID", false )
    Combo0.caption = "처리구분"
	DATAMANAGER.RequestTranData("obtss_elbs_011r")
	g_sOtpTrMsg = ""
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    If szTranId == "obcsb_efif_021r" then
	  DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )'주민번호(2)->아이디(1)로 구분설정

	  DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN", 0 , "N" )'평가수행여부 설정??
	  DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "ELFN_ID", 0 , g_szID)
	ElseIf szTranId == "obtss_elbs_011r" then
	  if plain_rm = "1" then
		  szPwd = Form.GetCtlProp("#edtPwd", "caption")'비번      
       else
           szPwd = Form.GetCtlProp("#edtPwd", "encdata")'비번      
       end if
      ACNO = Form.GetCtlProp("#accTran", "total")
      ASNO = Form.GetCtlProp("#accTran", "sequence")
      DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "REG_ACNO", 0 , ACNO)
      DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "REG_ASNO", 0 , ASNO )
      DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "ACNT_PWD", 0 , szPwd)
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = Form.GetCtlProp("#accTran", "total")
		if plain_rm = "1" then
			sACNO_PWD = Form.GetCtlProp("#edtPwd", "caption")
	     else
		     sACNO_PWD = Form.GetCtlProp("#edtPwd", "encdata")
	     end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
 '     Form.ShowAlert("acc조회" , ACNO)
    End If
End Sub  


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranId == "obtss_elbs_011r" then
		Dim szAcount
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obtss_elbs_011r", "OutBlock1")
		Label1.caption = "총 " & nCnt & " 건"

		for i= 0 to nCnt -1
			szAcc1 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "RCVN_ACNO", i)
			szAcc2 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNFT_ACNO", i)
			szAcc3 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNFT_ASNO", i)
			szAcNM1 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "RMT_NAME" , i )
			szAcNM2 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNFT_ACNM" , i )
			szPros = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "PROS_YN", i )
			szProTime = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "PROS_HOUR", i )	'취소시간
			szCanTime = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNCL_YMDH", i )	'취소시간
			Grid0.SetCellData( "bd_cell0", i, "접수일시" )
			Grid0.SetCellData( "bd_cell1", i, "입금계좌" )
			Grid0.SetCellData( "bd_cell2", i, "이체금액" )
			Grid0.SetCellData( "bd_cell3", i, "처리결과" )
			If szPros == "Y" or szPros == "F" then	
				Grid0.SetCellData( "bd_cell4", i, "이체시간" )
				Grid0.SetCellData( "bd_cell9", i, szProTime )
			Elseif szPros == "C" then	'취소완료
				Grid0.SetCellData( "bd_cell4", i, "취소시간" )
				Grid0.SetCellData( "bd_cell9", i, szCanTime )
			else		'아직 취소처리가 되지 않음
				Grid0.SetCellData( "bd_cell4", i, "취소시간" )
			End If
			
			if szPros ~= "N" then
				Grid0.SetCellEnable( "bd_cell13", i, False )
			end if
			szAcount = szAcc1&szAcc2&szAcc3
			if Len(szAcount) == 10 then
				Dim SetAcc
				SetAcc = Left(szAcount,4)&"-"&Mid(szAcount,5,4)&"-"&Right(szAcount,2)
				Grid0.SetCellData( "bd_cell11", i, SetAcc )
			else
				Grid0.SetCellData( "bd_cell11", i, szAcount )
			end if
			
			Grid0.SetCellData( "bd_cell16", i,  szAcNM1&szAcNM2 )
'			Grid0.SetCellEnable( "bd_cell13", i, False )
			Grid0.SetCellData(  "bd_cell13", i,  "취소" )'Grid0.SetCellTopCaption( 'sCellID, sValue )
			Grid0.SetCellFgColor( "bd_cell13", i, "4" )
		next
	ElseIf szTranId == "obtss_elbs_011c"  then
		szPros = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011c", "OutBlock1", "PROS_YN" , 0 )  
		if szPros == "C" then'취소완료 
			Form.MsgBox("알림", "지연이체취소가 완료되었습니다.", "완료", "6")
			DATAMANAGER.RequestTranData("obtss_elbs_011r")
		end if
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				trAmt =  Grid0.GetCellData("bd_cell7", g_lRow)
				g_sOtpTrMsg = Grid0.GetCellData("bd_cell6", g_lRow) & "#" & Grid0.GetCellData("bd_cell11", g_lRow) & "#" & Grid0.GetCellData("bd_cell16", g_lRow) & "#" & FormatNumber(CDbl(trAmt), 0, 0, 0, -1) & "원#"
				Form.SetSharedData("SOTP_ATHN_BSWR_CLCD" , "2")
				Form.SetSharedData("SOTP_TR_DTL_CNTT" , g_sOtpTrMsg)
				
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4" 'v001
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" ) '모바일 OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	End If
End Sub


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)''취소처리---------
	If Grid0.GetCellData( "bd_cell8", lRow) == "미처리" then
		Grid0.SetCellEnable( "bd_cell13", lRow, True )
'	   Grid0.SetCellData(  "bd_cell13", lRow,  "취소" )'Grid0.SetCellTopCaption( 'sCellID, sValue )
'	   Grid0.SetCellFgColor( "bd_cell13", lRow, "62" )
		if szCellID == "bd_cell13" then
			if Form.GetCtlProp( "#edtPwd", "caption") == "" then
			   Form.ShowAlert( "알림", "비밀번호를 확인하십시오.")
			   Exit Sub
			end if
			g_lRow = lRow
			Form.MsgBox("알림", "지연이체 접수내역을 취소하시겠습니까?", "취소", "6")
	      
		end if   
	End if  
     	   
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID ) 
	
	if szErrMsg ~= "" or szErrMsg ~= Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	if szTranID == "obtss_elbs_011c" then
		Form.ShowAlert( "알림", szErrMsg)
		DATAMANAGER.RequestTranData("obtss_elbs_011r")
	elseif szTranID == "obrtp_comn_025r" then
		if szErrCode == "5841" then 'v008
		
		    osType = Form.GetSharedData("&OS_TYPE", false)
             appVer = Form.GetSharedData("&APP_VERSION", false )
             appVer = replace(appVer,".","")
		
		    if osType == "1" then
		        if Cint(appVer) < 226 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
		        end if
			    
		    elseif osType == "2" then
		        if Cint(appVer) < 2521 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
		        end if
		    end if

		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "완료" then
	   if sRet == "close" then
	      DATAMANAGER.RequestTranData("obcsb_elbs_011r")
	   end if
	ElseIf sKeyName == "취소" then
	   
	   if sRet == "close" then
		   DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )	'추가인증
'	      Call SendCancel()
	   end if
	End If   
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName =="CHANGEACC" or  sEventName == "61010_RETURN"  then
	   Form_OnFormInit()
	
	
	ElseIf sEventName == "AllAccount" then
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		'g_szAccount = szList(0) & szList(1)
		'Form.ShowAlert("지연이체", g_szAccount)
		
        Form_OnFormInit()
    End If	
End Sub

