Sub Form_OnFormInit()
	Edit0.certname = "인증서 비밀번호 입력"
	Edit1.certname = "인증서 비밀번호 입력"
	Edit2.certname = "인증서 비밀번호 입력"
	
	g_szKeyType = Form.GetSharedData( "RENEW_TYPE", false )
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
'20161216_02 KBC START : 인증서 비밀번호 규칙 체크로직 제거
Function CheckValidPassword( str )
	dim i		'루프용 
	dim chk_n	'숫자 체크
	dim chk_c	'영문 체크
	dim chk_t	'특수 체크

	CheckValidPassword = ""
	chk_n = 0
	chk_c = 0
	chk_t = 0
	
	'체크1) 10자이상 30자이하
    if Len(str) < 10 or Len(str) > 30 then
		CheckValidPassword = "10~30 자리만 사용 가능합니다."
		exit function
	end if
	
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
	    
		If nAscii >= 48 and nAscii <= 57 Then '0~9
		    chk_n = 1
		Elseif   (nAscii >= 65 and nAscii <= 90) or ( nAscii >= 97 and nAscii <= 122) Then 'A~Z, a~z
		    chk_c = 1
		Else
		    chk_t = 1 
		End if
		
		'체크2) 일부 특수기호 불가
		if nAscii == 39 or nAscii == 34 or nAscii == 92 or nAscii == 124 then
			CheckValidPassword = "특수문자(',\",\\,|)는 사용이 불가합니다."           			'"
			exit function
		end if
	Next
	
	'체크3) 영어,숫자,특수문자 필수
	If ((chk_n + chk_c + chk_t) < 3) Then
		CheckValidPassword = "영어,숫자,특수문자 혼합필수입니다."
		exit function
	End if
	
	'체크4) 연속된 4자리 숫자/문자, 동일한 4자리 숫자/문자
	dim nAscii
	dim nPrvAscii
	dim nSameCnt
	dim nContiCntUp
	dim nContiCntDn
	
	nPrvAscii = 0
	nSameCnt = 0
	nContiCntUp = 0
	nContiCntDn = 0
		
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
		If (nAscii >= 48 and nAscii <= 57) or ((nAscii >= 65 and nAscii <= 90) or ( nAscii >= 97 and nAscii <= 122)) Then 
		
			if nPrvAscii == nAscii then
				nSameCnt = nSameCnt + 1
				
				if nSameCnt >= 3 then
					CheckValidPassword = "4자리이상 같은 경우에는 사용이 불가합니다."
					exit function
				end if				
			else
				nSameCnt = 0
			end if
			
			if nPrvAscii + 1 == nAscii then
				nContiCntUp = nContiCntUp + 1
				
				if nContiCntUp >= 3 then
					CheckValidPassword = "4자리이상 연속되는 경우에는 사용이 불가합니다."
					exit function
				end if
			else
				nContiCntUp = 0
			end if
			
			if nPrvAscii - 1 == nAscii then
				nContiCntDn = nContiCntDn + 1
				
				if nContiCntDn >= 3 then
					CheckValidPassword = "4자리이상 연속되는 경우에는 사용이 불가합니다."
					exit function
				end if				
			else 
				nContiCntDn = 0
			end if
			
			nPrvAscii = nAscii
			
		Else
			nPrvAscii = 0
			nSameCnt = 0
			nContiCnt = 0
		End If
	Next

	'체크5) 3자리 동일패턴 2번이상
	dim nPattnEqlCnt
	dim nPattnEqlPos
	dim sPattnBase
	dim sPattnComp
	
	nPattnEqlCnt = 0
	nPattnEqlPos = 0
	sPattnBase = ""
	sPattnComp = ""	
	
	For i = 1 to Len(str) - 2
		nPattnEqlCnt = 0
		nPattnEqlPos = 0
		sPattnBase = Mid(str, i, 3)

		for j = 1 to Len(str) - 2
			sPattnComp = Mid(str, j, 3)
			
			if j > (nPattnEqlPos+2) then
				if sPattnBase == sPattnComp then
					nPattnEqlCnt = nPattnEqlCnt + 1
					nPattnEqlPos = j
				end if
			end if

			if nPattnEqlCnt >= 2 then
				CheckValidPassword = "3자리 동일문자 2회이상 중복이 불가합니다.(" & nPattnEqlCnt & ")"
				exit function
			end if					
		next
	Next	
	
	'체크6) 2자리 동일패턴 3번이상
	nPattnEqlCnt = 0
	nPattnEqlPos = 0
	sPattnBase = ""
	sPattnComp = ""
	
	For i = 1 to Len(str) - 1
		nPattnEqlCnt = 0
		nPattnEqlPos = 0
		sPattnBase = Mid(str, i, 2)
		
		for j = 1 to Len(str) - 1
			sPattnComp = Mid(str, j, 2)
			
			if j > (nPattnEqlPos+1) then
				if sPattnBase == sPattnComp then
					nPattnEqlCnt = nPattnEqlCnt + 1
					nPattnEqlPos = j
				end if
			end if
			
			if nPattnEqlCnt >= 3 then
				CheckValidPassword = "2자리 동일문자 3회이상 중복이 불가합니다.(" & nPattnEqlCnt & ")"
				exit function
			end if
		next
	Next	
	
	CheckValidPassword = ""
End Function
'20161216_02 KBC END


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		Dim sText
		sText = "\n10자 이상 - 30자 이하\n"..
				"숫자, 영문자, 특수문자 반드시 포함(' \" \\ | 제외)\n"..
				"영문자 대/소문자 구분"
				
		'16-04-21 YCJ 인증서 갱신, 비밀번호 변경 구분을 위한 로직 추가
		if g_szKeyType == "1" then
			Table0.SetCellString( 7, 0, sText )
			chk0.visible = true
			g_szChkType = "0"
			Edit1.enable = false
			Edit2.enable = false
		else
			Table0.SetCellString( 6, 0, sText )
			g_szChkType = "1"
			chk0.visible = false
			Edit1.enable = true
			Edit2.enable = true
		end if
		
	elseif sEventName == "NextCheck" then
		'16-04-21 YCJ 인증서 갱신, 비밀번호 변경 구분을 위한 로직 추가
		if g_szKeyType == "1" then
			if chk0.checkstate == "1" then
				if (Edit0.caption == null or Edit0.caption == "") or
					(Edit1.caption == null or Edit1.caption == "") or
					(Edit2.caption == null or Edit2.caption == "") then
					Form.MsgBox( "안내", "인증서 비밀번호를 입력하세요.", "", 6 )
				else
					Dim sDN
					sDN = Form.GetSharedData("CERT_DN" , false)
					Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
				end if
			else
				if (Edit0.caption == null or Edit0.caption == "") then
					Form.MsgBox( "안내", "인증서 비밀번호를 입력하세요.", "", 6 )
				else
					Dim sDN
					sDN = Form.GetSharedData("CERT_DN" , false)
					Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
				end if
			end if
		else '인증서 비밀번호 유효성체크
			if (Edit0.caption == null or Edit0.caption == "") or
				(Edit1.caption == null or Edit1.caption == "") or
				(Edit2.caption == null or Edit2.caption == "") then
				Form.MsgBox( "안내", "인증서 비밀번호를 입력하세요.", "", 6 )
			else
				Dim sDN
				sDN = Form.GetSharedData("CERT_DN" , false)
				Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
			end if
		end if
		
		'16-04-21 YCJ 인증서 갱신, 비밀번호 변경 구분을 위한 로직 추가
'		if (Edit0.caption == null or Edit0.caption == "") or
'			(Edit1.caption == null or Edit1.caption == "") or
'			(Edit2.caption == null or Edit2.caption == "") then
'			Form.MsgBox( "안내", "인증서 비밀번호를 입력하세요.", "", 6 )
'		else '인증서 비밀번호 유효성체크
'			Dim sDN
'			sDN = Form.GetSharedData("CERT_DN" , false)
'			Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
'		end if

	elseif sEventName == "BeforeCheck" then	
		Form.triggerEvent( "#", "BeforeStep", "0" )	
	end if
End Sub

'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	if sType == "RetIsCertPasswordValid" then
		if sParam1 == "Success" then
			gPasswdFailCnt = 0 '20161110_01 KBC : 인증서비밀번호 모의해킹결과 대응
			
			'16-04-21 YCJ 인증서 갱신, 비밀번호 변경 구분을 위한 로직 추가
			if g_szChkType == "0" then
				Dim sNum 
				
				sNum = Edit0.caption.."^SEPARATOR^"..Edit0.caption
				Form.SetSharedData("CERT_OLDNEW" , sNum)			
				
				Form.triggerEvent( "#", "NextStep", "2" )
				
			elseif g_szChkType == "1" then
				'if Trim(Edit0.caption) == Trim(Edit1.caption) then '기존/신규 비밀번호 일치
				if Edit0.caption == Edit1.caption then '기존/신규 비밀번호 일치 '20160501 KBC
					Form.MsgBox( "오류", "기존 인증서 비밀번호와 신규 인증서 비밀번호가 일치합니다.", "", 6 )
				'elseif Trim(Edit1.caption) ~= Trim(Edit2.caption) then '신규 비밀번호 불일치
				elseif Edit1.caption ~= Edit2.caption then '신규 비밀번호 불일치 '20160501 KBC
					Form.MsgBox( "오류", "신규 인증서 비밀번호가 서로 일치하지 않습니다.", "", 6 )
				else
					'20200910 SWJ START: 인증서 비밀번호 체크로직 변경(서비스 단에서 처리)
					'메모리평문제거 적용상태일 때
					if plain_rm == "1" then	
						
						DATAMANAGER.RequestTranData("obacp_comm_058r")
						
					'메모리평문제거 미적용상태일 때
					else
						Dim sResult 
					
						'20161216_02 KBC START : 인증서 비밀번호 규칙 체크로직 제거
						'sResult = Form.CheckValidPassword( Edit1.caption, "C" )
						sResult = CheckValidPassword( Edit1.caption )
						'20161216_02 KBC END
					
						if sResult == null or Trim(sResult) == "" then '인증서 비밀번호 유효성 성공
					
							Dim sNum 
							sNum = Edit0.caption.."^SEPARATOR^"..Edit1.caption
							Form.SetSharedData("CERT_OLDNEW" , sNum)			
						
							Form.triggerEvent( "#", "NextStep", "2" )
						else
							Form.MsgBox( "오류", sResult, "", 6 )
						end if
					
					end if
				end if
			end if
					'20200910 SWJ END
'			
'			if Trim(Edit0.caption) == Trim(Edit1.caption) then '기존/신규 비밀번호 일치
'				Form.MsgBox( "오류", "기존 인증서 비밀번호와 신규 인증서 비밀번호가 일치합니다.", "", 6 )
'			elseif Trim(Edit1.caption) ~= Trim(Edit2.caption) then '신규 비밀번호 불일치
'				Form.MsgBox( "오류", "신규 인증서 비밀번호가 서로 일치하지 않습니다.", "", 6 )
'			else
'				Dim sResult 
'				sResult = Form.CheckValidPassword( Edit1.caption, "C" )
'				if sResult == null or Trim(sResult) == "" then '인증서 비밀번호 유효성 성공
'					Dim sNum 
'					sNum = Edit0.caption.."^SEPARATOR^"..Edit1.caption
'					Form.SetSharedData("CERT_OLDNEW" , sNum)			
'					
'					Form.triggerEvent( "#", "NextStep", "2" )
'				else
'					Form.MsgBox( "오류", sResult, "", 6 )
'				end if
'			end if
		else
			'20161110_01 KBC START : 인증서비밀번호 모의해킹결과 대응
			gPasswdFailCnt = gPasswdFailCnt + 1
			
			Form.MsgBox( "알림", sParam2 + "\n(비밀번호 " + gPasswdFailCnt + "회 오류입니다. 5회오류 시 화면이 종료됩니다.)", "FAIL", 0)
			'20161110_01 KBC END			
		end if
	end if
End Sub

'============================================================================
'20161110_01 KBC START : 인증서비밀번호 모의해킹결과 대응
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "FAIL" then
		if gPasswdFailCnt >= 5 then
			Form.CloseForm()
		end if
	end if
End Sub
'20161110_01 KBC END

'============================================================================
Sub chk0_OnChange(sCheckState)
	
	g_szChkType = sCheckState
	
	if sCheckState == "1" then
		Edit1.enable = true
		Edit2.enable = true
	else
		Edit1.enable = false
		Edit2.enable = false
	end if
	
End Sub
'============================================================================
'20200910 SWJ START : MTS메모리평문제거 관련 비밀번호 유효성 검증 체크(서비스 단에서 처리)
Sub DATAMANAGER_OnSendTranBefore(szTranID)

		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "PROS_CLS"     , 0 , "5")   				'처리구분(5: 변경 / 6: 신규) 
		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "MDBF_PWD_PIP" , 0 , Edit0.caption)	  	'변경전비밀번호
		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "PWD_PIP"      , 0 , Edit1.caption)    		'신규비밀번호
		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "CNFR_PWD_PIP" , 0 , Edit2.caption)      	'비밀번호확인
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	if szTranID == "obacp_comm_058r" then
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
		end if
	
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_comm_058r" then
		Dim sNum 
		sNum = Edit0.caption.."^SEPARATOR^"..Edit1.caption
		Form.SetSharedData("CERT_OLDNEW" , sNum)			
						
		Form.triggerEvent( "#", "NextStep", "2" )
	end if
End Sub
'20200910 SWJ END
