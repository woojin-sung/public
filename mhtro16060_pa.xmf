'============================================================================
' 화 면 명 : 해외주식주문_정산금팝업
' 화면설명 : 해외주식주문 정산금팝업
' 작    성 : 2017.12
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_tData

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	tblData.SetCellString(0, 1, "")
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(2, 1, "")
	tblData.SetCellString(3, 1, "")
	
	szDecimal = g_tData(7)
	sMask = "0,0,,,0,,"..szDecimal..",1,1,2,0"
	
	tblData.SetCellMaskInfo(0, 1, sMask)
	tblData.SetCellMaskInfo(1, 1, sMask)
	tblData.SetCellMaskInfo(2, 1, sMask)
	tblData.SetCellMaskInfo(3, 1, sMask)
	
	sCodeData = Split(g_tData(2), "@")
	
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "ACNO"             	, 0,	g_tData(0))	' 계좌번호
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "ASNO"             	, 0,	g_tData(1))	' 계좌일련번호
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "OVRS_STCK_SYMB_ISCD"   , 0, sCodeData[1])' 조회구분코드
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0,	g_tData(3))	' 수수료매체그룹코드
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "SELN_BYOV_CLCD"   	, 0,	g_tData(4))	' 매매시장구분코드
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "ODQT" 				, 0,	g_tData(5))	' 매매구분코드
	DATAMANAGER.SetDataValue(0,	"obtro_oder_236r", "InBlock1", "OVRS_STCK_ODER_PRC"    , 0,	g_tData(6))	' 주문수량
			
	DATAMANAGER.RequestTranData("obtro_oder_236r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim tData
	Dim szData
	
	szData = Form.GetOpenLinkData()
	
	tData = Split(szData, "★")
	
	if UBound(tData) > 0 then
		g_tData = tData
		
		RequestData()
	end if
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
' btnClose2_OnClick : 닫기
'============================================================================
Sub btnClose2_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
' btnReceive_OnClick : 조회
'============================================================================
Sub btnReceive_OnClick()
	RequestData()	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert(szTranID, szErrMsg)
End Sub

