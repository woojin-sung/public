'============================================================================
' 화 면 명 : 관심종목_가로(주식호가)
' 화면설명 : 관심종목_가로리스트 선택시 주식종목의 호가창 보여줌
' 작    성 : 2016.01.13 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Cancel_RealData
'============================================================================
Function Cancel_RealData()
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_elw_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_elw_aspr")
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_stck_aspr")
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg_1") '20180712 HAMWG : K-OTC MTS 도입
	DATAMANAGER.CancelRealData("ohhts_frbr_aspr")
end Function

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	DATAMANAGER.RequestTrandata("ohhts_1001_001r")
	DATAMANAGER.RequestTrandata("ohhts_1001_004r")
	DATAMANAGER.RequestTrandata("ohhts_1001_005r")
	DATAMANAGER.RequestTranData("ohhts_5010_001r")	' 현재가(차트[일])
end Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	contHoga.ChartEx0.setChartType("minibong")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	contHoga.imgChart.visible = false
	contHoga.ChartEx0.visible = false
	contHoga.grdTime.visible = true	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "JMCODE" then
		Cancel_RealData()							' 무조건 리얼해제
		
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")

			g_szCd = tData(0)
			g_szMk = tData(1)
			
			' 기본 세팅후 조회
			contHoga.tblTime.visible   = false		' 시간외
			
			RequestData()	
		end if	
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Cancel_RealData()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' ELW현재가(호가)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_3800_004r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3800_004r", "InBlock1", "FID_INPUT_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5010_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE",  0, "Y")
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))		
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역/시간별/호가&예상체결/미니차트)
	' ----------------------------------------------------------------------		    
	else
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nTotalBuy, nTotalSel				' 총매수잔량, 총매도잔량

	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_1001_001r" then
		'호가컨트롤 속성		
		contHoga.hogaTbl.startprice = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC", 0)
		contHoga.hogaTbl.highprice  = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC", 0)
		contHoga.hogaTbl.lowprice   = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC", 0)
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5010_001r" then
		if g_szMk = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg_1" )
	
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szMk = "T" then
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg_1" )
		'20180712 HAMWG END	
			
		else
			DATAMANAGER.RequestRealData("ohhts_stck_cntg_1")		
		end if
	' ----------------------------------------------------------------------
	' 현재가(호가&예상체결)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1001_005r" then
		nTotalBuy = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTotalSel = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		nTotal = CInt(nTotalBuy - nTotalSel)
		contHoga.hogaTbl.SetCellString(10, 1, nTotal)
	
		if g_szMk = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szMk = "T" then
			DATAMANAGER.RequestRealData( "ohhts_frbr_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END	
		
		else
			DATAMANAGER.RequestRealData( "ohhts_stck_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		end if				
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 주식체결, 프로보드체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_stck_cntg" or szTranID = "ohhts_stck_cntg_1" or szTranID = "ohhts_frbr_cntg" or szTranID = "ohhts_frbr_cntg_1" then '20180712 HAMWG : K-OTC MTS 도입
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주식호가, ELW호가/체결, 프로보드 호가 자동갱신
	' ----------------------------------------------------------------------			
	else
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim nTotalBuy, nTotalSel				' 총매수잔량, 총매도잔량

	' ----------------------------------------------------------------------
	' 주식호가, ELW호가, 프리보드호가 자동체결
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_stck_aspr" or szTranID = "ohhts_elw_aspr" or szTranID = "ohhts_frbr_aspr" then		
		nTotalBuy = Trim(DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN", 0))
		nTotalSel = Trim(DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN", 0))
		
		nTotal = CInt(nTotalBuy - nTotalSel)
		contHoga.hogaTbl.SetCellString(10, 1, nTotal)
	end if
End Sub

'============================================================================
' contHoga_hogaTbl_OnClick : 총 잔량부분 클릭시 시간외 전환
'============================================================================
Sub contHoga_hogaTbl_OnClick(lRow, lCol)
	if lCol = 1 and lRow = 10 then
		contHoga.tblTime.visible = true
	end if
End Sub

'============================================================================
' contHoga_tblTime_OnClick
'============================================================================
Sub contHoga_tblTime_OnClick(lRow , lColumn)
	if lColumn = 1 and lRow  = 0 then
		contHoga.tblTime.visible = false
	end if
End Sub

'============================================================================
' contHoga_grdTime_OnHeaderClickUp
'============================================================================
Sub contHoga_grdTime_OnHeaderClickUp(lRow, szCellID)
	contHoga.grdTime.visible = false
	contHoga.ChartEx0.visible = true
	contHoga.imgChart.visible = true
End Sub

'============================================================================
' contHoga_imgtoggle_OnClick : 토글이미지 클릭
'============================================================================
Sub contHoga_imgtoggle_OnClick()
	contHoga_grdTime_OnHeaderClickUp(0, "th_cell0")
End Sub

'============================================================================
' contHoga_imgChart_OnClick
'============================================================================
Sub contHoga_imgChart_OnClick()
	contHoga.imgChart.visible = false
	contHoga.ChartEx0.visible = false
	contHoga.grdTime.visible = true
End Sub

