	<SCRIPT_INFO _len="14384" _ulen="12704" >
'==== [Modify] =============================================================
' 계좌->ID기준 처리로 변경(2019.10.29)
' 2020.09.22 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2020.11.13 : 정민영 : v0002 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obacp_comm_004r,obacp_comm_058r IO 변경분 반영
'===========================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'============================================================================
Dim g_ReIqry ' 재조회 여부
Dim g_szAlertTitle
Dim g_plain_rm         'v0001 MTS메모리평문적용여부
Dim g_HomeNo           'v0001 자택전화번호
Dim g_ClphNo			'v0001 휴대전화번호
Dim g_WorkNo			'v0001 직장전화번호


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Pw_Check()
	
	if edt1PW.caption <> edt2PW.caption then
		Form.MsgBox(g_szAlertTitle, "신규비밀번호와 비밀번호확인이 일치하지 않습니다.", 0, 6)
		edt1PW.caption = ""
		edt2PW.caption = ""
		Exit Function
	end if
	
	if Len(edt2PW.caption) < 4 or Len(edt2PW.caption) > 4 then		'4자리 숫자 체크
		Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.(숫자4자리만가능)", 0, 6)
		edt1PW.caption = ""
		edt2PW.caption = ""
		Exit Function
	end if

	for i = 1 to Len(edt2PW.caption) - 3		'주민등록번호와 비교
		Dim szEdit, szJoomin
		szEdit = mid(edt2PW.caption,i,4)
		for j = 1 to Len(Form.GetSharedData("&JUMIN_NUM", false )) - 3
			szJoomin = mid((Form.GetSharedData("&JUMIN_NUM", false )),j,4)
			if szEdit == szJoomin then
				Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.(실명번호와 유사)", 0, 6)
				edt1PW.caption = ""
				edt2PW.caption = ""
				Exit Function
			end if
		next
	next
		
	for i = 1 to Len(edt2PW.caption) - 3 ' 연속된 3자리 숫자, 동일 숫자
		if Asc(mid(edt2PW.caption,i,1)) = Asc(mid(edt2PW.caption,i+1,1)) + 1 and Asc(mid(edt2PW.caption,i+1,1)) = Asc(mid(edt2PW.caption,i+2,1)) + 1 and Asc(mid(edt2PW.caption,i+2,1)) = Asc(mid(edt2PW.caption,i+3,1)) + 1 then
			Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(연속된 4자리 숫자)", 0, 6)
			edt1PW.caption = ""
			edt2PW.caption = ""
			Exit Function
		elseif Asc(mid(edt2PW.caption,i,1)) = Asc(mid(edt2PW.caption,i+1,1)) - 1 and Asc(mid(edt2PW.caption,i+1,1)) = Asc(mid(edt2PW.caption,i+2,1)) - 1 and Asc(mid(edt2PW.caption,i+2,1)) = Asc(mid(edt2PW.caption,i+3,1)) - 1 then
			Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(연속된 4자리 숫자)", 0, 6)
			edt1PW.caption = ""
			edt2PW.caption = ""
			Exit Function
		elseif Asc(mid(edt2PW.caption,i,1)) = Asc(mid(edt2PW.caption,i+1,1)) and Asc(mid(edt2PW.caption,i+1,1)) = Asc(mid(edt2PW.caption,i+2,1)) and Asc(mid(edt2PW.caption,i+2,1)) = Asc(mid(edt2PW.caption,i+3,1)) then
			Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(동일한 4자리 숫자)", 0, 6)
			edt1PW.caption = ""
			edt2PW.caption = ""
			Exit Function
		end if
	next

'	if Len(acnt0.total) > 4 then
'		for i = 1 to Len(edt2PW.caption) - 3		'계좌번호와 비교
'			Dim szAcnt
'			szEdit = mid(edt2PW.caption,i,4)
'			for j = 1 to Len(acnt0.total) - 3
'				szAcnt = mid(acnt0.total,j,4)
'				if szEdit == szAcnt then
'					Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(계좌번호와 4자리 일치)", 0, 6)
'					edt1PW.caption = ""
'					edt2PW.caption = ""
'					Exit Function
'				end if
'			next
'		next
'	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'휴대폰번호와 비교
			Dim szPhone
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) - 3
				szPhone = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0),j,4)
				if szEdit == szPhone then
					Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(휴대폰번호와 4자리 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'자택번호와 비교
			Dim szHome
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) - 3
				szHome = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0),j,4)
				if szEdit == szHome then
					Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(자택번호와 4자리 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'직장번호와 비교
			Dim szWorkTel
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) - 3
				szWorkTel = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0),j,4)
				if szEdit == szWorkTel then
					Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.\n(직장번호와 4자리 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(Form.GetSharedData("&USER_ID", false )) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'로그인 아이디와 비교
			Dim szEdit, szJoomin
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(Form.GetSharedData("&USER_ID", false )) - 3
				szJoomin = mid((Form.GetSharedData("&USER_ID", false )),j,4)
				if szEdit == szJoomin then
					Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.(로그인ID와 4자리 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	'16-02-03 로그인 비밀번호가 GetSharedData로 넘어오지 않음, Login 이후 넘어오는지 확인 필요
	if Len(Form.GetSharedData("&USER_PWD", false )) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'로그인 비밀번호와 비교
			Dim szEdit, szJoomin
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(Form.GetSharedData("&USER_PWD", false )) - 3
				szJoomin = mid(Form.GetSharedData("&USER_PWD", false ),j,4)
				if szEdit == szJoomin then
					Form.MsgBox(g_szAlertTitle, "유효하지 않은 비밀번호입니다.(로그인 비밀번호와 4자리 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	DATAMANAGER.RequestTranData("obpds_srvc_163a")
	
End Function

'============================================================================
Sub Form_OnFormInit()
    strHTSID = Form.GetSharedData("&USER_ID", false )
    Table3.SetCellString(0, 1, Trim(strHTSID))

	btn0.enable	= FALSE
	edt1PW.enable	= FALSE
	edt2PW.enable	= FALSE
	g_ReIqry 	= FALSE
	
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'v0001 Defualt-주민번호용Aria키값 변경에 따른 API호출 삭제 
	'If g_plain_rm == "1" Then
	'	'주민번호용 Aria키값으로 암호화하도록 설정(Defualt-이체용 Aria키값)
	'     edt1PW.SetAriaNoBank()
	'     edt2PW.SetAriaNoBank()
	'End If

	g_szAlertTitle = "알림"

	If Trim(strHTSID) = "" Then
		Form.MsgBox(g_szAlertTitle, "HTS ID를 확인하세요", 0, 6)
		Exit Sub
	Else
		DATAMANAGER.RequestTranData("obacp_comm_004r")
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	strHTSID = Table3.GetCellString(0, 1)  'HTSID

	If szTranID = "obacp_comm_004r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , Trim(strHTSID))

	ElseIf szTranID = "obpds_srvc_162r" Or szTranID = "obpds_srvc_163a" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE", 0 , "4"           ) ' 온라인		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PXPR_ELFN_ID" , 0 , Trim(strHTSID))
		
		'v0001 컨트롤매핑->스크립트 변경
		If szTranID = "obpds_srvc_163a" Then
			If g_plain_rm == "1" then  'MTS메모리평문 적용상태일때
			    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PXPR_PWD" 	, 0 , edt1PW.caption )  '주문대리인비밀번호
			    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_CNFR_PWD" , 0 , edt2PW.caption )  '주문대리인확인비밀번호
			Else  'MTS메모리평문 미적용상태일때
			    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PXPR_PWD" 	, 0 , Form.GetEncData(edt1PW.caption))  'Hash암호데이터로 등록
			    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_CNFR_PWD" , 0 , Form.GetEncData(edt2PW.caption))  'Hash암호데이터로 등록
			End If
		End If
		
     'v0001 비밀번호 유효성 검증체크
	ElseIf szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "3" )	'3. [MTS] 주문대리인비밀번호 등록/변경시 체크(mbonl84030_t1, mbonl84030_t2)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , ""                  )  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , Trim(strHTSID)      )  'ID
	    '비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
	     DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , edt1PW.caption2 )  '비밀번호
    		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , edt2PW.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""	         )  '실명확인번호(서비스에서조회)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화

	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obacp_comm_004r" Then
		'v0001 고객연락처설정
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화

		DATAMANAGER.RequestTranData("obpds_srvc_162r")
	
	ElseIf szTranID = "obpds_srvc_162r" Then
	     strPxprYN     = DATAMANAGER.GetDataValue(0, "obpds_srvc_162r", "OutBlock1", "PXPR_YN"  , 0)  '대리인여부
	     strPastPxprYN = DATAMANAGER.GetDataValue(0, "obpds_srvc_162r", "OutBlock1", "PXPR_YN2" , 0)  '과거대리인여부
	     
	     '주문대리인이 아닌경우(과거이력포함) 화면 Close처리(By박정숙G)
	     If strPxprYN = "N" And strPastPxprYN = "N" Then
	         Form.MsgBox(g_szAlertTitle, "(온라인)주문대리인만 사용가능한 화면입니다.", 0, 6)
			Exit Sub
	     End If
	     
		'주문대리인이 아니거나 HTSID 미존재시 메시지박스로 표시
	    'If strPxprYN = "N" Then	
	    '주문대리인이어도 조회가능/처리불가(By박정숙G) 
	    strHTSID = DATAMANAGER.GetDataValue(0, "obpds_srvc_162r", "OutBlock1", "PXPR_ELFN_ID" , 0)	     
		If strPxprYN = "N" And Trim(strHTSID) = "" Then
			Form.ShowAlert(g_szAlertTitle, DATAMANAGER.GetDataMsgSubText( szTranID ) )
		Else
			if DATAMANAGER.GetDataValue(0, "obpds_srvc_162r", "OutBlock1", "PWD_REG_YN" , 0) == "N" then
				Table0.SetCellString(0, 1, "미등록")
			Else
				Table0.SetCellString(0, 1, "등록")
			End If
			
			If g_ReIqry = TRUE Then
				btn0.enable	= FALSE
				edt1PW.enable	= FALSE
				edt2PW.enable	= FALSE
			Else
				If DATAMANAGER.GetDataValue(0, "obpds_srvc_162r", "OutBlock1", "PWD_REG_YN" , 0) == "Y" Then
					Form.MsgBox(g_szAlertTitle, "비밀번호가 등록되어 있습니다.\n재설정은 변경(재설정)탭을 이용하시기 바랍니다.", 0, 6)
					Exit Sub
				End If
				btn0.enable	= TRUE
				edt1PW.enable	= TRUE
				edt2PW.enable	= TRUE
			End If
		End If

	'v0001
	ElseIf szTranID = "obacp_comm_058r" Then
		DATAMANAGER.RequestTranData("obpds_srvc_163a")
	
	ElseIf szTranID = "obpds_srvc_163a" Then
		strMsg    = DATAMANAGER.GetDataMsgText(szTranID)
		strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.ShowAlert(g_szAlertTitle, strMsg.."\n("..strSubMsg..")" )
		g_ReIqry = TRUE
		DATAMANAGER.RequestTranData("obpds_srvc_162r")
	End If
End Sub

'============================================================================


'============================================================================
Sub btn0_OnClick()
	'v0001
	If g_plain_rm == "1" Then	'MTS메모리평문 적용상태일때
	    DATAMANAGER.RequestTranData("obacp_comm_058r")
	Else  'MTS메모리평문 미적용상태일때
	    Call Pw_Check()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	If szTranID = "obacp_comm_004r" Then
		Form.ShowAlert(g_szAlertTitle, "HTS ID를 확인하세요." )	
	Else
		Form.ShowAlert(g_szAlertTitle, szErrMsg.."\n("..szSubErr..")" )	
	End If	
End Sub


