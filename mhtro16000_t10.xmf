Function Init_Control()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상

	szScrNo = Form.GetSharedData("&SCREEN_NO",false)
	
	contMain.setExceptInvisibleCtl(true)
	
	contMain.lblSubTitle1.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle1.paddinginfo = "0,0,0,0"
	
	if szScrNo = "11000" then
		contMain.height = 355
	elseif szScrNo = "16000" or szScrNo = "16100" then
		contMain.setEnableScroll(false)
		contMain.height = 400
	end if
	
	contMain.lnkfm0.linkfile = "mhtro16000_s01"
	contMain.lnkfm1.linkfile = "mhtro16000_s02"
	contMain.lnkfm2.linkfile = "mhtro16000_s03"
	contMain.lnkfm3.linkfile = "mhtro16000_s04"
	
	g_nLinkFm0_Top = 0
	g_nLinkFm1_Top = g_nLinkFm0_Top + g_nLinkFm0_Height
	g_nLinkFm2_Top = g_nLinkFm1_Top + g_nLinkFm1_Height
	g_nLinkFm3_Top = g_nLinkFm2_Top + g_nLinkFm2_Height
	
	g_nInfo_Top = g_nLinkFm3_Top + g_nLinkFm3_Height
	contMain.setScrollBarVisible("2")
	contMain.lnkfm0.top  = g_nLinkFm0_Top
	contMain.lnkfm0.height = g_nLinkFm0_Height
	
	contMain.lnkfm1.top  = g_nLinkFm1_Top
	contMain.lnkfm1.height = g_nLinkFm1_Height
	
	contMain.lnkfm2.top  = g_nLinkFm2_Top
	contMain.lnkfm2.height = g_nLinkFm2_Height
	
	contMain.lnkfm3.top  = g_nLinkFm3_Top
	contMain.lnkfm3.height = g_nLinkFm3_Height
	
	contMain.lblInfo.fgcolor = g_szTxtColor_Grey
	contMain.lblInfo.paddinginfo = "0,0,10,0"
	contMain.lblInfo.top = g_nInfo_Top
	contMain.contInfo.top = g_nInfo_Top + 24
	
	contMain.contInfo.contInfo1.makeExpandableList("", "", -2, -2, g_szTxtColor_Grey, g_szTxtColor_Grey, 0, 0, False, "")
	
	contMain.SetUseScrollingEvent(true)
	contMain.SetNotifyScrollPos(g_nLinkFm0_Top&":"&g_nLinkFm1_Top-10&":"&g_nLinkFm2_Top-10&":"&g_nLinkFm3_Top-40)
	
	szInfo = "본서비스에서 제공되는 데이터에 대한 저작권은 모닝스타 코리아와 메리츠증권에 있으며 복사 또는 배포할 수 없습니다.\n\n"
	szInfo = szInfo & "정보의 정확성과 신뢰성을 보장하기 위해 최선을 다하지만 이를 보장하지 않으며 손실이나 손상에 대한 법적 책임이 없습니다.\n\n"
	szInfo = szInfo & "또한 제 3자 데이터 제공업체에서 자료를 제공하므로 수신이 지연되거나 일부 정보가 정확하지 않을 수 있습니다.\n\n"
	szInfo = szInfo & "ETF는 자산가격 변동, 환율 변동 등에 따라 투자원금의 일부 또는 전액 손실이 발생할 수 있으며, 그 손실은 투자자에게 귀속됩니다.\n\n"
	szInfo = szInfo & "ETF는 예금자보호법에 따라 보호되지 않습니다."
	
	contMain.contInfo.contInfo1.addExpandableList("    유의사항" , szInfo)
	
	FormTab0.hidepage = "page003489"
	FormTab0.hidepage = "page001674"
End Function

Function RequestTran_021r(szData)
	FormTab0.hidepage = "page003489"
	FormTab0.hidepage = "page001674"
	
	DATAMANAGER.ClearInputData(0, "ohhts_metf_021r")
	
	if instr(szData, "@") > 0 then
		arrData = split(szData, "@")
		
		DATAMANAGER.SetDataValue(0, "ohhts_metf_021r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , arrData(1))
		DATAMANAGER.SetDataValue(0,  "ohhts_metf_021r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , arrData(0))
	end if
	
	DATAMANAGER.RequestTranData("ohhts_metf_021r")
End Function

Function ResponseTran_021r(isMorningStar)
	if g_szOSType = "1" then
		contMain.scroll_pos = "0"
	else
		contMain.scroll_pos_noAni = "0"
	end if
	
	contMain.lnkfm0.linkfile = "empty"
	contMain.lnkfm1.linkfile = "empty"
	contMain.lnkfm2.linkfile = "empty"
	contMain.lnkfm3.linkfile = "empty"
	
	g_nLinkFm0_Top = 0
	g_nLinkFm0_Height = 774
	g_nLinkFm1_Top = g_nLinkFm0_Height + g_nLinkFm0_Top
	if trim(isMorningStar) = "Y" then
		g_nLinkFm1_Height = 928
	else
		g_nLinkFm1_Height = 270 + 45 
	end if
	
	g_nLinkFm2_Top = g_nLinkFm1_Height + g_nLinkFm1_Top
	g_nLinkFm2_Height = 737
	g_nLinkFm3_Top = g_nLinkFm2_Height + g_nLinkFm2_Top
	g_nLinkFm3_Height = 536
	g_nInfo_Top = g_nLinkFm3_Height + g_nLinkFm3_Top
	g_nInfo_Height = 60
	
	contMain.lnkfm0.top  = g_nLinkFm0_Top
	contMain.lnkfm0.height = g_nLinkFm0_Height
	
	contMain.lnkfm1.top  = g_nLinkFm1_Top
	contMain.lnkfm1.height = g_nLinkFm1_Height
	
	contMain.lnkfm2.top  = g_nLinkFm2_Top
	contMain.lnkfm2.height = g_nLinkFm2_Height
	
	contMain.lnkfm3.top  = g_nLinkFm3_Top
	contMain.lnkfm3.height = g_nLinkFm3_Height
	
	contMain.lblInfo.top = g_nInfo_Top
	contMain.contInfo.top = g_nInfo_Top + 24
	contMain.contInfo.height = 51
	contMain.contInfo.contInfo1.height = 51
	contMain.contInfo.contInfo1.clearExpandableList()
	contMain.contInfo.contInfo1.makeExpandableList("", "", -2, -2, g_szTxtColor_Grey, g_szTxtColor_Grey, 0, 0, False, "")
	
	szInfo = "본서비스에서 제공되는 데이터에 대한 저작권은 모닝스타 코리아와 메리츠증권에 있으며 복사 또는 배포할 수 없습니다.\n\n"
	szInfo = szInfo & "정보의 정확성과 신뢰성을 보장하기 위해 최선을 다하지만 이를 보장하지 않으며 손실이나 손상에 대한 법적 책임이 없습니다.\n\n"
	szInfo = szInfo & "또한 제 3자 데이터 제공업체에서 자료를 제공하므로 수신이 지연되거나 일부 정보가 정확하지 않을 수 있습니다.\n\n"
	szInfo = szInfo & "ETF는 자산가격 변동, 환율 변동 등에 따라 투자원금의 일부 또는 전액 손실이 발생할 수 있으며, 그 손실은 투자자에게 귀속됩니다.\n\n"
	szInfo = szInfo & "ETF는 예금자보호법에 따라 보호되지 않습니다."
	
	contMain.contInfo.contInfo1.addExpandableList("    유의사항" , szInfo)
	
	contMain.lnkfm0.linkfile = "mhtro16000_s01"
		
	if trim(isMorningStar) = "Y" then
		contMain.lnkfm2.visible = true
		contMain.lnkfm3.visible = true
		contMain.contInfo.visible = true
		contMain.lblInfo.visible = true
		
		
		contMain.lnkfm1.linkfile = "mhtro16000_s02"
		contMain.lnkfm2.linkfile = "mhtro16000_s03"
		contMain.lnkfm3.linkfile = "mhtro16000_s04"
		
	else
		contMain.lnkfm2.visible = false
		contMain.lnkfm3.visible = false
		contMain.contInfo.visible = false
		contMain.lblInfo.visible = false
'		FormTab0.hidepage = "page003489"
'		FormTab0.hidepage = "page001674"
		
		szScrNo = Form.GetSharedData("&SCREEN_NO",false)
			
		'if szScrNo = "16000" or szScrNo = "16100" then
			contMain.height = 510
		'end if
		
		contMain.lnkfm1.linkfile = "mhtro16000_s02"
		
		Form.triggerEvent("lnkfm1", "CHANGE_LAYOUT", "Y")
	end if
	g_isMorningStar = isMorningStar
	
	Form.SetTimerEvent2(1, 1, 0.2)
	'Form.triggerEvent("lnkfm0", "INIT_CODE", g_szItemCd)

End Function

