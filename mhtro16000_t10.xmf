'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	contMain.SetNotifyScrollPos(g_nLinkFm0_Top&":"&g_nLinkFm1_Top-10&":"&g_nLinkFm2_Top-10&":"&g_nLinkFm3_Top-40)
	if sEventName = "RequestData" then
		g_szItemCd = sParam
		g_isS1 = false
		g_isS2 = false
		g_isS3 = false

		RequestTran_021r(g_szItemCd)
	elseif sEventName == "ENABLE_SCROLL" then
		
		if sParam == "END" then
			contMain.setEnableScroll(true)
		elseif sParam == "TOP" then
			contMain.setEnableScroll(false)
		end if

	elseif sEventName = "INIT_CODE" then
		g_szItemCd = sParam
		
		g_isS1 = false
		g_isS2 = false
		g_isS3 = false
		RequestTran_021r("J@"&g_szItemCd)

	elseif sEventName = "ETF_SUB_TAB" then
		nParam = Cint(sParam)
		g_nSubTab = nParam
		
	elseif sEventName = "CHANGE_LAYOUT_S1" then
		g_nLinkFm0_Height = Cint(sParam)
		g_nLinkFm1_Top = g_nLinkFm0_Top + Cint(sParam)
		g_nLinkFm2_Top = g_nLinkFm1_Top + g_nLinkFm1_Height
		g_nLinkFm3_Top = g_nLinkFm2_Top + g_nLinkFm2_Height
		g_nInfo_Top = g_nLinkFm3_Top + g_nLinkFm3_Height
		
		contMain.lnkfm0.top  = g_nLinkFm0_Top
		contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
		'contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
		'contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
		'contMain.lnkfm3.height = g_nLinkFm3_Height
		
		contMain.lblInfo.top = g_nInfo_Top
		contMain.contInfo.top = g_nInfo_Top + 24
		
		contMain.setScrollAutoSize()

		if g_isS1 = false then
			Form.triggerEvent("lnkfm1", "INIT_CODE", g_szItemCd)
			g_isS1 = true
		end if
		
	elseif sEventName = "CHANGE_LAYOUT_S2" then

		g_nLinkFm1_Height = Cint(sParam)
		g_nLinkFm2_Top = g_nLinkFm1_Top + Cint(sParam)
		g_nLinkFm3_Top = g_nLinkFm2_Top + g_nLinkFm2_Height
		g_nInfo_Top = g_nLinkFm3_Top + g_nLinkFm3_Height
		
		contMain.lnkfm0.top  = g_nLinkFm0_Top
'		contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top

		if g_isMorningStar = "N" then
			if sParam == "200" then
				contMain.height = 510
			else
				contMain.height = 390
			end if
		else
			szScrNo = Form.GetSharedData("&SCREEN_NO",false)
	
			if szScrNo = "11000" then
				contMain.height = 355
			elseif szScrNo = "16000" or szScrNo = "16100" then
				contMain.height = 400
			end if
		end if
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
'		contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
'		contMain.lnkfm3.height = g_nLinkFm3_Height
		
		contMain.lblInfo.top = g_nInfo_Top
		contMain.contInfo.top = g_nInfo_Top + 24
		
		if g_isMorningStar = "N" then
			nReduce1 = 0 
			if g_nLinkFm1_Height <> 0 and g_nLinkFm1_Height < 300 then
				nReduce1 = 400 - g_nLinkFm1_Height
			else
				nReduce1 = 10
			end if

			contMain.SetNotifyScrollPos(g_nLinkFm0_Top&":"&g_nLinkFm1_Top-nReduce1)'&":"&g_nLinkFm2_Top-10&":"&g_nLinkFm3_Top-40)
			
		else
			if g_isS2 = false then
				Form.triggerEvent("lnkfm2", "INIT_CODE", g_szItemCd)
				g_isS2 = true
			end if
		end if
	
		contMain.setScrollAutoSize()
		
	elseif sEventName = "CHANGE_LAYOUT_S3" then
		
		g_nLinkFm2_Height = Cint(sParam)
		g_nLinkFm3_Top = g_nLinkFm2_Top + Cint(sParam)
		g_nInfo_Top = g_nLinkFm3_Top + g_nLinkFm3_Height
		
		contMain.lnkfm0.top  = g_nLinkFm0_Top
'		contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
'		contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
		contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
'		contMain.lnkfm3.height = g_nLinkFm3_Height
		
		contMain.lblInfo.top = g_nInfo_Top
		contMain.contInfo.top = g_nInfo_Top + 24
		
		if g_nLinkFm2_Height = 0 then
			FormTab0.hidepage = "page003489"
		else
			FormTab0.showpage = "page003489"
		end if
		
		contMain.setScrollAutoSize()

		if g_isS3 = false then
			Form.triggerEvent("lnkfm3", "INIT_CODE", g_szItemCd)
			g_isS3 = true
		end if
		
	elseif sEventName = "CHANGE_LAYOUT_S4" then
		g_nLinkFm3_Height = Clng(sParam)
		
		contMain.lnkfm0.top  = g_nLinkFm0_Top
'		contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
'		contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
'		contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
		contMain.lnkfm3.height = g_nLinkFm3_Height
		
		g_nInfo_Top = g_nLinkFm3_Top + g_nLinkFm3_Height
		
		contMain.lblInfo.top = g_nInfo_Top
		contMain.contInfo.top = g_nInfo_Top + 24
		
		if g_nLinkFm3_Height = 0 then
			FormTab0.hidepage = "page001674"
		else
			FormTab0.showpage = "page001674"
		end if
		
		nReduce1 = 0 
		if g_nLinkFm2_Height <> 0 and g_nLinkFm2_Height < 300 then
			nReduce1 = 300 - g_nLinkFm2_Height
		else
			nReduce1 = 10
		end if
		
		nReduce2 = 0 
		if g_nLinkFm3_Height <> 0 and g_nLinkFm3_Height < 350 then
			nReduce2 = 350 - g_nLinkFm3_Height
		else
			nReduce2 = 40
		end if
		
		if g_nSubTab > 0 then
			FormTab0.currenttab = g_nSubTab
			FormTab0_OnTabChanged(g_nSubTab)
		end if
		
		contMain.SetNotifyScrollPos(g_nLinkFm0_Top&":"&g_nLinkFm1_Top-10&":"&g_nLinkFm2_Top-nReduce1&":"&g_nLinkFm3_Top-nReduce2)
		
		contMain.setScrollAutoSize()
	elseif sEventName = "RETURN_LAYOUT" then
		Form.triggerEvent("#", "RETURN_LAYOUT_T11", sParam)
	end if
End Sub

Sub contMain_contInfo_contInfo1_OnExpandableClick(nIdx, nStatus)
	contMain.contInfo.contInfo1.height = 1000

	if nStatus = "1" then
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nInfo_Top
		else
			contMain.scroll_pos_noAni = g_nInfo_Top
		end if
	else
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nInfo_Top
		else
			contMain.scroll_pos_noAni = "end"
		end if
	end if
End Sub

Sub contMain_contInfo_contInfo1_OnExpandableSize(nHeight)	
	contMain.contInfo.height = nHeight
	contMain.contInfo.contInfo1.height = nHeight
	
	contMain.setScrollAutoSize()
	if g_szOSType = "1" then
		contMain.scroll_pos = g_nInfo_Top
	end if
End Sub


Sub contMain_OnNotifyScrolling(nIndex)
	if g_isClickRdo = true then
		g_isClickRdo = false
		Exit Sub
	end if
	
	FormTab0.currenttab = nIndex
End Sub


'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	g_isClickRdo = true
	if nCurrentTab = 0 then
		
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nLinkFm0_Top
		else
			contMain.scroll_pos_noAni = g_nLinkFm0_Top
		end if
	elseif nCurrentTab = 1 then
		if g_isMorningStar = "N" then
			if g_szOSType = "1" then
				contMain.scroll_pos = "end"
			else
				contMain.scroll_pos_noAni = "end"
			end if

		else
			if g_szOSType = "1" then
				contMain.scroll_pos = g_nLinkFm1_Top
			else
				contMain.scroll_pos_noAni = g_nLinkFm1_Top
			end if
		end if
	elseif nCurrentTab = 2 then
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nLinkFm2_Top
		else
			contMain.scroll_pos_noAni = g_nLinkFm2_Top
		end if
	elseif nCurrentTab = 3 then
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nLinkFm3_Top
		else
			contMain.scroll_pos_noAni = g_nLinkFm3_Top
		end if
	end if

End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_021r" then
		szMorning_YN 	 = DATAMANAGER.GetDataValue(0, "ohhts_metf_021r", "OutBlock1", "FID_APLY_YN" , 0)
		ResponseTran_021r(szMorning_YN)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "ohhts_metf_021r" then
		ResponseTran_021r("N")
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID,0,0)
	if Cint(sTimerID) == 1 then
		Form.triggerEvent("lnkfm0", "INIT_CODE", g_szItemCd)
	end if
End Sub

