'============================================================================
Sub Container0_Chk1_OnChange(sCheckState)
    Dim bpdate
    bpdate = Trim(Form.GetSharedData( "&HOST_DATE" , False ))
    Form.SaveConfigData("mbbnk61010_pe", "mbbnk61010_curdate", "20181218" )
    If sCheckState = True Then
	    Form.SaveConfigData("mbbnk61010_pe", "mbbnk61010_popup", "N" )	
    Else
	    Form.SaveConfigData("mbbnk61010_pe", "mbbnk61010_popup", "Y"  )
    End if 
End Sub

'============================================================================
Sub Container0_Label0_OnClick()
