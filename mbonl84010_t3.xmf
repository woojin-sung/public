'============================================================================
' 01.화면명 	: 온라인계좌개설
' 02.화면설명	: 온라인계좌개설_종합매매계좌개설완료
' 03.작성	: 2016.01.14
'====== [Modify] ============================================================
' 2016.06.27 : 정민영 : obaci_acct_003c IO 변경분 적용 v0001
' 2016.07.18 : 김동구 : 온라인계좌개설 개설완료시 개설완료된 계좌 자동 재조회 추가 v0002
' 2020.09.16 : 권오상 : v003 : T2008250015 : 메모리평문 취약점 수정
' 2020.11.10 : 정민영 : v003 보완
' 2020.11.13 : 정민영 : v004 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obaci_acct_003c,obcmm_kcdd_035r,obcmm_kwlf_032r,obcmm_kwlf_013a IO 변경분 반영
' 2021.05.26 : 김수진 : obaci_acct_003c IO 변경분 적용 v0001 PROS_DATE, PROS_SRNO
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim 	g_szPassword		'From GetSharedData("ONLINE_PSWD") 
dim	g_szAccNo 			'From GetSharedData("ONLINE_ACNT")
dim	g_szManBranch		'관리지점코드		from obacp_opop_066r(공유)
dim 	g_szRCNO			'실명확인번호		from obcsb_acif_000r(공유)
dim	g_szCSNO			'고객번호			from obcsb_acif_000r(공유)

dim 	g_szCustFullName	'고객풀명				from	obcmm_kwlf_032r
dim	g_szRCNOType		'실명확인번호유형코드	from	obcmm_kwlf_032r
dim	g_szCTCD			'국가코드				from	obcmm_kwlf_032r
dim 	g_szCUSTEngName		'고객영문명			from	obcmm_kwlf_032r
dim	g_szExceptYN		'금융상품전용			from	STEP1
dim	g_szAlertTitle
Dim	g_PlainRm 'v003

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'btnPrv01_OnClick
'============================================================================
Sub btnPrv01_OnClick()
	Form.triggerEvent("#", "OPENACC_MAIN", "1")
End Sub


'============================================================================
'btnNext01_OnClick
'============================================================================
Sub btnNext01_OnClick()
	DATAMANAGER.RequestTranData("obpds_srvc_069r")
End Sub


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szEXPT
	szEXPT	=	""
	
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v001
	
	g_szRCNO 		= Form.GetSharedData("ONLINE000_RCNO" , 0)  'v004 mbonl84010_t2 에서 RCNO_PIP값으로 변경
	g_szCSNO 		= Form.GetSharedData("ONLINE000_CSNO" , 0)
	g_szManBranch 	= Form.GetSharedData("ONLINE066_BRCD" , 0)	 		
	szEXPT			= Form.GetSharedData("ONLINE000_EXPT" , 0)
	
	if	szEXPT	=	"1"	then
		g_szExceptYN	=	"Y"
	else
		g_szExceptYN	=	"N"
	end	if
'	g_szPassword = "1357"		'임시세팅
'	g_szAccNo = "30076961"		'임시세팅
	
	g_szAccNo 		= Form.GetSharedData("ONLINE_ACNT", 0)
'	g_szPassword 	= Form.GetSharedData("ONLINE_PSWD", 0) 'v003

	'v003  평문적용/미적용에 따라 앞 화면(mbonl84010_t2)에서 암호화/비암호화 비밀번호로 넘어옴
	'If g_PlainRm == "1" Then '보안모듈 적용
		g_szPassword 	= Form.GetSharedData("ONLINE_PSWD", 0)
	'Else
	'	g_szPassword 	= Form.GetEncData(Form.GetSharedData("ONLINE_PSWD", 0))
	'End If
	
	tbl01.SetCellString(1, 1, left(g_szAccNo,4) & "-" & mid(g_szAccNo,5,4))
	'edtAcc01.caption = left(g_szAccNo,4) & "-" & mid(g_szAccNo,5,4)
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim	szToday

	if	szTranID	=	"obpds_srvc_069r"	then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "CSNO", 0, g_szCSNO )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "ACNO", 0, g_szAccNo )
	elseif	szTranID	=	"obcmm_kcdd_035r"	then
		szToday	= Form.GetSharedData("&HOST_DATE", 0)
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_035r", "InBlock1", "CDD_REG_DATE", 0, szToday )
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_035r", "InBlock1", "RCNO_PIP", 0, g_szRCNO )  'v004 RCNO->RCNO_PIP
	elseif	szTranID	=	"obcmm_kwlf_032r"	then
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_032r", "InBlock1", "ACNO", 0, g_szAccNo )
	elseif	szTranID	=	"obcmm_kwlf_013a"	then
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock1", "RCNO_PIP", 0, g_szRCNO )  'v004 RCNO->RCNO_PIP
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock1", "ACNO", 0, g_szAccNo )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock1", "CUST_FULL_NAME", 0, g_szCustFullName )
		
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "WLF_REAL_RCNO_PIP", 0, g_szRCNO )  'v004 WLF_REAL_RCNO->WLF_REAL_RCNO_PIP
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "RCNO_TYPE_CODE", 0, g_szRCNOType )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "CTCD", 0, g_szCTCD )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "CUST_FULL_NAME", 0, g_szCustFullName )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "CUST_ENG_NAME", 0, g_szCUSTEngName )
	elseif	szTranID	=	"obaci_acct_003c"	then
		'처리일자, 처리일련번호
		Dim sProsDate, sProsSrno 
		sProsDate = Form.GetSharedData( "PROS_DATE", false )
		sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ACNT_PWD", 0, g_szPassword)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "MANG_EMPNO", 0, g_szManBranch)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "FNPR_EXUS_YN", 0, g_szExceptYN)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "PROS_DATE", 0, sProsDate)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "PROS_SRNO", 0, sProsSrno)
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szRegYN
	dim	szAcno
	dim	szAsno
	dim	szAcAs
	
	szAcno	=	""
	szAsno	=	""
	szAcAs	=	""
	
'obpds_srvc_069r	--약정내역조회
'obcmm_kcdd_035r	--WLFCDD기준일 등록여부확인 Y일때 obaci_acct_003c, N일때는 obcmm_kwlf_032r
'	Y:obaci_acct_003c
'	N:obcmm_kwlf_032r
'obcmm_kwlf_032r	--WLF계좌번호로 고객정보조회 
'obcmm_kwlf_013a	--WLF등록 
'obaci_acct_003c	--종합매매개별상품가입

	if	szTranID	=	"obpds_srvc_069r"	then
		DATAMANAGER.RequestTranData("obcmm_kcdd_035r")	

	elseif	szTranID	=	"obcmm_kcdd_035r"	then
		
		szRegYN = DATAMANAGER.GetDataValue(0, "obcmm_kcdd_035r", "OutBlock1", "REG_YN", 0)
		
		if	szRegYN	=	"Y"		then
			DATAMANAGER.RequestTranData("obaci_acct_003c")		'최종TR 종합매매개별상품가입
		else
			DATAMANAGER.RequestTranData("obcmm_kwlf_032r")	
		end if
		
	elseif	szTranID	=	"obcmm_kwlf_032r"	then
	
		g_szRCNOType	= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "RCNO_TYPE_CODE", 0)
		g_szCTCD		= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "CTCD", 0)
		
		g_szCustFullName= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "CUST_FULL_NAME", 0)
		g_szCUSTEngName	= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "CUST_ENG_NAME", 0)
		
		DATAMANAGER.RequestTranData("obcmm_kwlf_013a")	
		
	elseif	szTranID	=	"obcmm_kwlf_013a"	then
		DATAMANAGER.RequestTranData("obaci_acct_003c") 		'최종TR 종합매매개별상품가입
	elseif	szTranID	=	"obaci_acct_003c"	then
		
		szAcno	=	DATAMANAGER.GetDataValue(0,"obaci_acct_003c", "OutBlock1", "ACNO", 0)
		szAsno	=	DATAMANAGER.GetDataValue(0,"obaci_acct_003c", "OutBlock1", "ASNO", 0)
		
		szAcAs	=	left(szAcno,4) & "-" & mid(szAcno,5,4)  & "-" & szAsno
		'정상일때
		'Form.MsgBox("알림", szAcAs & " 온라인 계좌개설이 완료 되었습니다.재로그인하시면, 개설된 계좌를 잔고등 조회시 선택할 수 있습니다." , "OPENACCOK", 6)
		Form.MsgBox("알림", szAcAs & " 온라인 계좌개설이 완료 되었습니다." , "OPENACCOK", 6)
		'v0002 온라인계좌개설 개설완료시 개설완료된 계좌 자동 재조회 추가
		'계좌재조회
		Form.RequestCommand("RE_ACCT_LIST", "", "")			
	end if 
	
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle,  szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if	sKeyName	=	"OPENACCOK"	then
		Form.CloseForm()
		Form.triggerEvent("#", "OPENACC_MAIN", "0")
		Form.SetSharedData( "PROS_DATE", "" )
		Form.SetSharedData( "PROS_SRNO", "" )
	end if 
End Sub

