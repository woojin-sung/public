	<SCRIPT_INFO _len="5355" _ulen="4891" >
'============================================================================
' 화 면 명 : 해외CFD_금융거래 정보제공 동의
' 화면설명 : 해외CFD_금융거래 정보제공 동의
' 작    성 : 2021.12
'============================================================================
'20240724 SWJ START: CFD 과세정보 제공동의 팝업 추가 및 UI 개선(추가하면서 UI 바꿔버림)
'mbtre13000_p12 헷지수수료 부과동의 팝업도 여기로 통합함
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szGbn
Dim g_szData
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	lblGuideLine.bgcolor = "334"
	
	'20240123 SWJ START
	g_szData = Form.GetOpenLinkData()
	'szData = "1"
		
	'AOS는 Form.Height 쓸 때
	'늘려놓는 상태에서 줄이는게 가능해서
	'컨트롤 자체는 미리 늘려 놓음
	
	'if szData = "1" then	
	'	Form.Height = 389
	'	cont0.left = 0
	'else
	'	Form.Height = 324
	'end if
	'20240123 SWJ END 
	
	'20240724 SWJ START
	'대용수수료
	if g_szData == "1" then
		LblMainTitle.caption = "대용수수료 부과 동의"
		TblSubstitute.visible = True
		
	'과세정보이용 동의
	elseif g_szData == "2" then
		LblMainTitle.caption = "CFD 과세정보 제공에 관한 포괄동의"
		TblImposeTax.visible = True
	
	'헷지수수료 부과 동의
	elseif g_szData == "3" then
		LblMainTitle.caption = "해외CFD 안심계좌 헷지수수료 부과동의"
		TblHedgeTax.visible = True
		
	'금융거래정보이용제공동의
	else
		LblMainTitle.caption = "금융거래정보이용제공 동의"
		TblFinance.visible = True
	end if
	'20240724 SWJ END
End Sub

'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("AGREECHECK" , "N")
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.SendReturnToParent("AGREECHECK" , "N")
	Form.CloseForm()
End Sub

'============================================================================
' btnClose2_OnClick : 닫기
'============================================================================
Sub btnClose2_OnClick()
	Form.SendReturnToParent("AGREECHECK" , "N")
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnReceive_OnClick()
	Form.SendReturnToParent("AGREECHECK" , "Y")
	Form.CloseForm()
End Sub
'============================================================================
'20240123 SWJ START : 대용수수료 부과동의 안내 팝업
'============================================================================
Sub cont0_btnClose1_OnClick()
	Form.SendReturnToParent("SubstituteCheck" , "N")
	Form.CloseForm()
End Sub

'============================================================================
Sub cont0_btnReceive0_OnClick()
	Form.SendReturnToParent("SubstituteCheck" , "Y")
	Form.CloseForm()
End Sub

'============================================================================
Sub cont0_imgClose0_OnClick()
	Form.SendReturnToParent("SubstituteCheck" , "N")
	Form.CloseForm()
End Sub


'============================================================================
'20240724 SWJ START
'============================================================================
Sub BtnClose_OnClick()
	ReturnToParents(g_szData, "Close")
End Sub

'============================================================================
Sub BtnOK_OnClick()
	ReturnToParents(g_szData, "Agree")
End Sub

'============================================================================
Sub ImgAlpha_OnClick()
	ReturnToParents(g_szData, "Close")
End Sub
'============================================================================
'sPopup: 팝업 종류, sContent: 닫기인지 동의인지
Function ReturnToParents(sPopup, sContent)

	Select Case sPopup
	
		'대용
		Case "1"
			sReturnName = "SubstituteCheck"
		'과세
		Case "2"
			sReturnName = "ImposeTaxCheck"
		'헷지
		Case "3"
			sReturnName = "HEDGE_AGREECHECK"
		'금융
		Case Else
			sReturnName = "AGREECHECK"
	End Select
	
	Select Case sContent
		
		'동의
		Case "Agree"
			sReturnParam = "Y" 
		'닫기
		Case "Close"
			sReturnParam = "N"
	End Select
	
	
	Form.SendReturnToParent(sReturnName , sReturnParam)
	Form.CloseForm()
	
End Function
	</SCRIPT_INFO>
</ROOT>