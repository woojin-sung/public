		<BUTTON name="btnCancel" caption="닫기" fgcolor="004:000000000" fontstyle="01" btnimage="btn_02.9" ly_vert="25,199,127,39,1" />
		<IMAGE name="imgTitle" imgpath="pop_header.9" ly_vert="0,0,309,55,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="내통장표시 수정" bgcolor="064:188030030" halign="1" ly_vert="0,0,309,55,1" />
		<IMAGE name="imgClose" autosize="1" imgpath="ic_pop_close.png" ly_vert="265,15,24,24,1" />
