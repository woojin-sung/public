	<SCRIPT_INFO _len="5518" _ulen="5276" >
'============================================================================
' 01. 화 면 명 : 내통장표시 수정
' 02. 화면설명 : 내통장표시 수정
' 03. 작    성 : 박영택
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim szData, szList
Dim g_szAcno
Dim g_szAsno
Dim g_szTrDate
Dim g_szTranSrno
Dim g_szTrExpl
Dim g_szText
	
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obrtp_tran_025a" then	'등록
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "ACNO" , 0 , g_szAcno )
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "ASNO" , 0 , g_szAsno )
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "TR_DATE" , 0 , g_szTrDate )
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "TRAN_SRNO" , 0 , g_szTranSrno )
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "TR_EXPL" , 0 , edtMytip.caption )
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "MNPL_TRNO" , 0 , Form.GetSharedData( "&IP_ADDRESS" , false ))
		DATAMANAGER.SetDataValue(0, "obrtp_tran_025a", "InBlock1", "MNPL_EMPNO" , 0 , Form.GetSharedData( "&USER_ID" , false ) )

		DATAMANAGER.RequestTranData("obrtp_tran_025a")
	end if

End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnEnroll_OnClick
'============================================================================
Sub btnEnroll_OnClick()
	szLen = Form.GetByteLength(edtMytip.caption)

	if CDbl( szLen ) < 1 then
		Form.MsgBox("알림", "수정내용을 입력하세요.", "keypadok", 0)
	end if
	
	TR_Inquiry("obrtp_tran_025a")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	szData =  Form.GetOpenLinkData()
	' enroll(modify)★주민번호★일련번호★은행명★계좌번호★수취인계좌명★계좌별칭★은행코드★사용여부
	szList = Split(szData, "★")
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	g_szAcno = szList(0)
	g_szAsno = szList(1)
	g_szTrDate = szList(2)
	g_szTranSrno = szList(3)
	g_szTrExpl = szList(4)
	g_szText = szList(5)
'	Table0.SetCellString(1, 0, g_szTrDate)
'	Table0.SetCellString(1, 1, g_szTranSrno)
'	Table0.SetCellString(1, 2, g_szTrExpl)
	
	'edtMytip.caption = g_szTrExpl
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtp_tran_025a" then
		Form.CloseForm()
		Form.SendReturnToParent("내통장수정", "ok")   
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	Form.MsgBox("알림", szErrMsg & " " & sSubMsg , "", 0)
End Sub


'============================================================================
' btnAccountSearch_OnClick  - 조회버튼 클릭
'============================================================================



'============================================================================
' btnCancel_OnClick - 취소버튼
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnModify_OnClick - 수정버튼 클릭
'============================================================================


'============================================================================


'============================================================================
Sub edtMytip_OnEditComplete()
	szLen = Form.GetByteLength(edtMytip.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

	</SCRIPT_INFO>
