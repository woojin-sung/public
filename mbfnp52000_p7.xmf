	<SCRIPT_INFO _len="4264" _ulen="4070" >
'============================================================================
' 01.화면명 	: 발행어음매매_이자가계산
' 02.화면설명	: 발행어음매매_이자가계산
' 03.작성	: 2016. 03. 22. 유창재
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCode					'종목 코드
Dim g_szData
Dim g_szList

g_szCode = {"NI70030" , "NI70040"}
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	if g_szList(0) == "mbfnp52000_t1" then
		tblMaedo.visible = false
		DATAMANAGER.RequestTranData( "obsan_deal_213r" )
	else
		tblMaesu.visible = false
		DATAMANAGER.RequestTranData( "obsan_deal_214r" )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obsan_deal_213r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "ACNO" , 0 , g_szList(1) )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "ASNO" , 0 , g_szList(2) )			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "ISCD" , 0 , g_szCode( CDbl(g_szList(3)) ) )	'종목코드
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "INVT_DYNU" , 0 , g_szList(4) )		'투자일수
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "INVT_AMT" , 0 , g_szList(5) )	'매수금액(투자금액)
	elseif szTranID == "obsan_deal_214r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ACNO" , 0 , g_szList(1) )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ASNO" , 0 , g_szList(2) )			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ISCD" , 0 , g_szList(3) )			'종목코드
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "ISNT_NO" , 0 , g_szList(4) )		'어음번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_214r", "InBlock1", "INVT_AMT" , 0 , g_szList(5) )	'원금(투자금액)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nFeeBefore
	
	if szTranID == "obsan_deal_213r" then
		nFeeBefore = DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "INT_AMT" , 0) - 	'세후이자
		DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "INTX" , 0) - 
		DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "RSTX" , 0) - 
		DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "SRTX" , 0)
		
		tblMaesu.SetCellString( 3 , 1 , nFeeBefore )
	end if
	
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obsan_deal_213r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obsan_deal_213r" )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obsan_deal_214r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obsan_deal_214r" )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
	end if
	
End Sub

