	<SCRIPT_INFO _len="3979" _ulen="3689" >
--===========================================================================
--===========================================================================
Dim g_szISCD
Dim g_szCheck
'============================================================================
Sub Form_OnFormInit()
	
	Form.SetScreenName("당일 매매일지")
	
'	szData = Split( Form.GetOpenLinkData(), "!")
'	
'	for i = 0 to ubound(szData) - 1
'		Form.ShowAlert(szData(i))
'	next
	
	tmp = Form.GetOpenLinkData()
	szData = Split( tmp, "!")

	
	Calendar0.caption = szData(0)
	g_szISCD = szData(1)
	g_szCheck = szData(2)
	chkGrid.checkstate = g_szCheck
	
	Account0.enable = false
	Calendar0.enable = false

	'Form.ShowAlert(szDate, "1")
	'Calendar0.enable = false

	
	RequestData()
End Sub

'============================================================================
Function RequestData()
	
	DATAMANAGER.RequestTranData("obtrs_cntg_536r")

End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO =	Account0.total
	szASNO = Account0.sequence
	
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "ACNO" , 0 , szACNO)
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "ASNO" , 0 , szASNO)
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "STND_DATE" , 0 , Calendar0.caption)
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "ISCD" , 0 , g_szISCD)
	
	'200715 구분값 2로 수정함.
	'DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "PROS_CLS_CODE" , 0 , "1")
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "PROS_CLS_CODE" , 0 , "2")

	if chkGrid.checkstate = "1" then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "CRDT_EXPN_INCU_YN", 0 , "Y")
	else
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_536r", "InBlock1", "CRDT_EXPN_INCU_YN", 0 , "N")		
	end if
	
End Sub

'============================================================================
Sub chkGrid_OnChange(sCheckState)
	RequestData()
End Sub

'============================================================================
Sub Button0_OnClick()
	RequestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	for i = 0 to Grid0.rowcount - 1
		szData1 = Grid0.GetCellData("bd_cell7", i)
		Select Case szData1
			Case "0000"	szReturnValue1 = "보통"
			Case "0002"   szReturnValue1 = "주식대여"
			Case "0101"	szReturnValue1 = "자기융자"
			Case "0102"	szReturnValue1 = "유통융자"
			Case "0103"	szReturnValue1 = "자기대주"
			Case "0104"	szReturnValue1 = "유통대주"
			Case "0201"	szReturnValue1 = "예탁주식"
			Case "0202"	szReturnValue1 = "예탁채권"
			Case "0203"	szReturnValue1 = "예탁집합투자"
			Case "0204"	szReturnValue1 = "예탁장외파생"
			Case "0211"	szReturnValue1 = "예탁유통주식"
			Case "0212"	szReturnValue1 = "예탁유통채권"
			Case "0213"	szReturnValue1 = "예탁유통집합투자"
			Case "0214"	szReturnValue1 = "예탁유통장외파생"
			Case "0301"	szReturnValue1 = "매도증권담보대출"
			Case "0302"	szReturnValue1 = "수익증권환매"
			Case "0303"	szReturnValue1 = "ELS환매자금대출"
			Case "0401"	szReturnValue1 = "소액주식"
			Case "0402"	szReturnValue1 = "소액채권"
			Case "0403"	szReturnValue1 = "소액수익증권"
			Case "0404"	szReturnValue1 = "소액 ELS"
			Case "0501"	szReturnValue1 = "공모주청약"
			Case "0502"	szReturnValue1 = "ELS청약"
			Case "0503"	szReturnValue1 = "주식매입"
			Case "0601"	szReturnValue1 = "매입자금대출"
			Case "0701"	szReturnValue1 = "초단기대출"
			Case "0801"	szReturnValue1 = "CMA담보대출"
			Case Else     szReturnValue1 = szData1
		End Select
		
		Grid0.SetCellData( "bd_cell7", i, szReturnValue1)
	next
End Sub

