'============================================================================
Sub Form_OnFormInitBefore()
     
	g_Data = Form.GetOpenLinkData()
	realMsg = Split(g_Data,"|")
	
	g_PopupGb = realMsg(0)	'팝업구분
	
	if g_PopupGb = "01" then
			
		g_mClcd  	= realMsg(1)	'매체구분
		g_VerInfo 	= realMsg(2) 	'버전정보
		g_ScrNo  	= realMsg(3) 	'화면번호
		g_prosClcd 	= realMsg(6) 	'처리구분코드
		g_Msg 		= realMsg(7)	'메시지
		
		'20230302 LES START
		nLen = Form.getLen(g_Msg)
		if Cint(nLen) <= 0 then
			Form.CloseForm()
		end if
		'20230302 LES END
		
	end if


End Sub

'============================================================================
Sub setRealMsg()

	g_OStype = Form.GetSharedData("&OS_TYPE", false)   '(1: Android 2:IOS)
	g_rowIdx = 0 
	
	if g_OStype = "1" then
		g_UserClcd = "30"
	else
		g_UserClcd = "31"
	end if

	mClcd = g_mClcd
	
	'MTS를 포함하는 매체구분 코드 값을 가지는 메세지만 보여준다.
	'g_UserClcd => OS 타입에 따른 매체구분 코드 값 ( Android = 30 / IOS = 31)
	'if mClcd ="10" or mClcd = "11" or mClcd = "21" or mClcd = g_UserClcd then
			
		'Container0.Grid0.AddRow()
	
		msg			= g_Msg
		msg = replace(msg,"\r","\r\n")
		
		
		verinfo		= g_VerInfo
		scrno 		= g_SrcNo
		proc_clcd 	= g_prosClcd
			
		'Container0.Grid0.SetCellData("bd_arrow", g_rowIdx, ">")
		'Container0.Grid0.SetCellData("bd_msg", g_rowIdx, msg)
		Container0.Label0.caption = msg
		'Grid0.SetCellData("bd_srno", g_rowIdx, srno)
				
				
'		'메세지
'		if proc_clcd = "0" then
'		'단순히 메세지만 보여줌
'				
'		'메세지+선택종료
'		elseif proc_clcd = "1" then
'			Grid0.SetCellData("bd_addmsg", g_rowIdx, "※ 앱 재실행이 필요합니다. (선택)")
'					
'			if Cint(g_prosClcd) < 1 then
'					g_prosClcd = "1"
'			end if
'					
'		'메세지+필수종료
'		elseif proc_clcd = "2" then
'			Grid0.SetCellData("bd_addmsg", g_rowIdx, "※ 앱 재실행이 필요합니다. (필수)")
'					
'			if Cint(g_prosClcd) < 2 then
'				g_prosClcd = "2"
'			end if
'			
'				
