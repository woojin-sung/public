'============================================================================
Sub Form_OnFormInit()


	if g_PopupGb = "01" then	'실시간 메시지 수신시
	

		setRealMsg()

	else
		'재실행 구분코드 (0 : 재실행 필요x  1: 선택종료 2: 필수종료 //3:업데아트)
		g_prosClcd = "0"
	
		'사용자 아이디 획득
		g_UserID = Form.GetSharedData("&USER_ID" , false)
		g_OStype = Form.GetSharedData("&OS_TYPE", false)   '(1: Android 2:IOS)
	
		if g_OStype = "1" then
			g_UserClcd = "30"
		else
			g_UserClcd = "31"
		end if
		
			
		DATAMANAGER.SetDataValue(0, "obtrf_lnkd_840r", "InBlock1", "FID_MDIA_CLS_CODE" , 0 , "**")
		DATAMANAGER.RequestTranData("obtrf_lnkd_840r")
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	
	if szTranID = "obtrf_lnkd_840r" then

		cnt = DATAMANAGER.GetDataCount(0, "obtrf_lnkd_840r" ,"OutBlock1")
		
		g_rowIdx = 0
	
	
		for i = 0 to cnt -1 
	
			mClcd = DATAMANAGER.GetDataValue(0, "obtrf_lnkd_840r", "OutBlock1", "FID_MDIA_CLS_CODE" , i)
		
			'MTS를 포함하는 매체구분 코드 값을 가지는 메세지만 보여준다.
			'g_UserClcd => OS 타입에 따른 매체구분 코드 값 ( Android = 30 / IOS = 31)
'			if mClcd ="10" or mClcd = "11" or mClcd = "21" or mClcd = g_UserClcd then
			
				'Container0.Grid0.AddRow()
	
				msg = DATAMANAGER.GetDataValue(0,"obtrf_lnkd_840r", "OutBlock1", "FIDR_URGN_MSG", i)
				
				msg = replace(msg,"\r","\r\n")
				
				'20230302 LES START
				nLen = Form.getLen(msg)
				if Cint(nLen) <= 0 then
					Form.CloseForm()
				end if
				'20230302 LES END
				
				
				'srno = DATAMANAGER.GetDataValue(0, "obcpp_msga_102r", "OutBlock1", "MSG_SRNO" , i)
				'proc_clcd = DATAMANAGER.GetDataValue(0,"obtrf_lnkd_840r", "OutBlock1", "FIDR_PROS_CLS_CODE", i)
			
				'Container0.Grid0.SetCellData("bd_arrow", g_rowIdx, ">")
				'Container0.Grid0.SetCellData("bd_msg", g_rowIdx, msg)
				Container0.Label0.caption = msg
				'Grid0.SetCellData("bd_srno", g_rowIdx, srno)
				
				
'				'메세지
'				if proc_clcd = "0" then
'				'단순히 메세지만 보여줌
'				
'				'메세지+선택종료
'				elseif proc_clcd = "1" then
'					Grid0.SetCellData("bd_addmsg", g_rowIdx, "※ 앱 재실행이 필요합니다. (선택)")
'					
'					if Cint(g_prosClcd) < 1 then
'						g_prosClcd = "1"
'					end if
'					
'				'메세지+필수종료
'				elseif proc_clcd = "2" then
'					Grid0.SetCellData("bd_addmsg", g_rowIdx, "※ 앱 재실행이 필요합니다. (필수)")
'					
'					if Cint(g_prosClcd) < 2 then
'						g_prosClcd = "2"
'					end if
'				
'				
'				
'				end if
				
				g_rowIdx = g_rowIdx + 1 
				
'			end if
		
		next
	

	end if


	
End Sub

