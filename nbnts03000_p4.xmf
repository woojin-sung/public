	<SCRIPT_INFO _len="2074" _ulen="1936" >
--===========================================================================
--===========================================================================

Dim g_szOrder_Acc			' 계좌번호
Dim g_szOrder_AccName		' 고객명
Dim g_szOrd_ItmCode		' 종목코드
Dim g_szOrd_ItmName		' 종목명
Dim g_szOrd_OrdType		' 주문구분
Dim g_szOrd_Day			' 기간
Dim g_nOrd_Limit_Price		' 주문가격
Dim g_nOrd_Stop_Price		' 조건가격
Dim g_nOrd_Qty			' 주문수량
Dim g_nOrd_OrdNo			' 원주문번호

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		Dim tData
		tData = Split(szData, "|")
		
		if UBOUND(tData) < 1 then
		    Exit sub
		End if
		
		g_szOrder_Acc = tData(0)		' 계좌번호
		g_szOrder_AccName = tData(1)	' 고객명
		g_szOrd_ItmCode = tData(2)		' 종목코드
		g_szOrd_ItmName = tData(3)		' 종목명
		g_szOrd_OrdType = tData(4)		' 주문구분
		g_szOrd_Day = tData(5)			' 기간
		g_nOrd_Limit_Price = tData(6)	' 주문가격
		g_nOrd_Stop_Price = tData(7)	' 조건가격
		g_nOrd_Qty = tData(8)			' 주문수량
		
		tblData.SetCellString( 0, 1, g_szOrder_Acc 		)
		tblData.SetCellString( 0, 2, g_szOrder_AccName	)
		tblData.SetCellString( 1, 1, g_szOrd_ItmCode		)
		tblData.SetCellString( 2, 1, g_szOrd_ItmName 		)
		tblData.SetCellString( 3, 1, g_szOrd_OrdType		)
		tblData.SetCellString( 4, 1, g_szOrd_Day			)
		tblData.SetCellString( 5, 1, g_nOrd_Limit_Price	)
		tblData.SetCellString( 6, 1, g_nOrd_Stop_Price	)
		tblData.SetCellString( 7, 1, g_nOrd_Qty			)
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnSel_OnClick()
	Form.SendReturnToParent( "ODER" , "")
	Form.CloseForm( )
End Sub

