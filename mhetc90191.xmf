'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub Container0_EditReal_OnEditChar(CharCode)
	
	Select Case CharCode
	
	Case "0"
		
		'입력값 6초과할 때 초과 카운팅 방지
		if nCnt = 6 then
			nCnt = 6
		else
			nCnt = nCnt + 1
		end if
		
		g_CountSave = nCnt
	Case "1"	
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt = 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
		
		g_CountSave = nCnt
	'취소, 입력완료일 때
	Case "2"
		nCnt = 0
	End Select
	
	PasswordInsert()
	
	'20240717 SWJ START: 입력완료 전에 완료 처리
	if nCnt = 6 then		
		'입력완료 호출 API
		Container0.EditReal.runSecKeypadFinish()
	end if
	'20240717 SWJ END
	
End Sub

'============================================================================
'고객에게 보여지는 에디트 위치 클릭시 키패드 활성화(에디트 위치에 버튼 올려서)
'============================================================================
Sub Container0_Button0_OnClick()
	Container0.EditReal.SetShowKeypad(True)
	
	'인증 에디트 초기화
	nCnt = 0
	PasswordInsert()
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		Form.CloseForm()		'첫페이지(ID등록)로 이동
	elseif sKeyName == "LOG_FORCE" then
		' IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_DeviceOS == "2" Then	'iOS("2")Android("1")
			if sRet == "ok" then			
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")		
			else
				if g_ScrNum == "10003" then
					'안드로이드는 여기서 폼닫기 해도 닫히는데
					'ios는 메뉴화면을 직접닫아줘야 닫아짐
					Form.triggerEvent("#","ios_formclose","")
				else
					Form.CloseForm()
				end if
			end if		
		else
			if sRet == "ok" then
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()			
			end if	
		end if
		
	elseif sKeyName == "MOTP_NEW" then
		
		if sRet == "cancel" then
			Form.CloseForm()
			exit sub
		end if
		
		'로그인을 한번이라도 했었는지 판단
		if g_sUserID == "" or g_sUserID == null then
			Form.SetSharedData("BDM_NMETBSWRGB", "009")
			Form.OpenNextPopup("mbbdm85200","", "")
		else
			if Cint(g_LoginType) > 1 then '로그인상태
				Form.OpenNextPopup("mbotp86100","", "")
			else
				'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
				'업무신청 화면으로 발급하도록 연결
				 Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
				 Form.SetSharedData("BDM_FRST_MAPID", "screen41000")
				 Form.SetSharedData("BDM_NMETBSWRGB", "009")
				 'V001
				 'Form.OpenNextPopup("mbbdm85110", "" , "" )
				 Form.OpenNextPopup("mbbdm86130", "" , "" )
				
			end if
		end if
	
	elseif sKeyName == "PinError" then
		'인증 에디트 초기화
		nCnt = 0
		PasswordInsert()
				
		'비밀번호 입력키패드 Show
		Form.SetTimerEvent2(1, 1, 0.6)
	
	elseif sKeyName == "030104" then
		if sRet == "ok" then
			
			'mpopup_auth에서 리턴받을 때랑 다른 케이스지만
			'결국 재등록하는 절차는 동일해서
			'같은 변수 사용
			g_Register = "Y"
			Form.OpenStartScreen()
		else
			Form.CloseForm()
		end if
		
	end if
End Sub

'============================================================================
Sub Container0_EditReal_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if g_DeviceOS == "2"  then
			Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
		elseif g_DeviceOS == "1" then
			Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
		end if
		
	elseif nCnt = 6 then
		procRequestAtonAuth()
		nCnt = 0
	end if
End Sub

