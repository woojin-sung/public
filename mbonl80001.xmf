Dim g_szPwd

'============================================================================
Sub Form_OnFormInitBefore()
	'이미지 비율 유지
	imgToolTip1.setMaintainingRatio("1")
	imgToolTip2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'Label 스타일 적용
	lblTitle.changeTextAttr(0, 4, 67, 1, true)
	
	'버튼 스위치 적용
	btnSwitch.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	btnSwitch.switchindex = "1"
	
'	'연도콤보세팅(시행년도인 2022부터 현재년도 + 1년까지 세팅)
'	Dim nNowYear
'	nNowYear = CInt(Left(Form.GetSharedData( "&HOST_DATE", false ), 4))
'	For i = nNowYear to Left(nNowYear,4) + 1
'		cmbPeriod.cbadddatatext = i & "`" & i & "년"
'	Next
'	
	Dim szMode
	szMode = Form.GetSharedData("&SERVER_MODE", False )
	
	'연도콤보세팅
	Dim nNowYear
	nNowYear = CInt(Left(Form.GetSharedData("&HOST_DATE", false), 4))
	If szMode == "1" Or szMode == 1 Then		'테스트
		For i = 2021 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
	Else									'운영
		'혹시 모르니 예외처리
		If nNowYear == 2022 Then
			nNowYear = 2023
		End If
		For i = 2023 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
	End If
	cmbPeriod.cbkeydata = nNowYear
	
	'금투세 기본공제 신청가능 여부 체크
	DATAMANAGER.RequestTranData( "obacp_comm_007r" )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "CORRECT_PWD" And sRet <> "" And sRet <> Null Then
'		Form.ShowAlert(sKeyName, sRet)
		Dim tData
		tData = Split(sRet, "★")
		If UBOUND(tData) > 0 Then
			g_szPwd = tData[0]
			
			'금융투자소득 기본공제 관리
			DATAMANAGER.RequestTranData( "obcsb_fiin_002a" )
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "REG_COMPLETE" Then
		If sRet == "ok" Then
			'메시지박스 닫고 데이터 재조회
			f_ClearData()
			f_SetTextStyle()
			
			'금융투자소득 기본공제 조회
			DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
			
		ElseIf sRet == "no" Then
			'메시지박스 닫고 신청내역화면으로 이동
			Form.OpenScreen("80002" , "")
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'금투세 기본공제 신청가능 여부 체크
	If szTranID == "obacp_comm_007r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "9")
	
	'금융투자소득 기본공제 조회
	ElseIf szTranID == "obcsb_fiin_001r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , cmbPeriod.cbkeydata)
		'"0":전체, "1":상장주식 등, "2":기타
		If CInt(tabType.currenttab) == 0 Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "1") 
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "2") 
		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_BSWR_CODE" , 0 , "200")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SCTY_INFO_IQRY_YN" , 0 , "L")
	
	'금융투자소득 기본공제 관리
	ElseIf szTranID == "obcsb_fiin_002a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_BSWR_CODE" , 0 , "210")	'"210":등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , cmbPeriod.cbkeydata)
		If CInt(tabType.currenttab) == 0 Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "1")
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "2")
		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLT_AMT" , 0 , edtAmt.caption )
		If btnSwitch.switchindex == "0" Then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "N")
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "Y")
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'금투세 기본공제 신청가능 여부 체크
	If szTranID == "obacp_comm_007r" Then
		Dim szCustDetlClsCode, szRsdtClsCode
		szCustDetlClsCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_DETL_CLS_CODE" , 0)
		szRsdtClsCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSDT_CLS_CODE" , 0)
		
		'고객세부분류가 01(개인)이고, 거주자구분코드가 1(거주)인 경우만 대상 
		If szCustDetlClsCode == "01" And szRsdtClsCode == "1" Then
			lblNoTarget.left = 1000
			
			'안드로이드에서 스위치 버튼 레이아웃이 위로 겹쳐져서 따로 처리
			btnSwitch.left = 294
			
			f_ClearData()
			f_SetTextStyle()
			
			'금융투자소득 기본공제 조회
			DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
		Else
			Form.ShowAlert("알림", "금융투자소득세 기본공제 신청대상이 아닙니다.")
			lblNoTarget.left = 0
			
			'안드로이드에서 스위치 버튼 레이아웃이 위로 겹쳐져서 따로 처리
			btnSwitch.left = 1000
		End If
	
	'금융투자소득 기본공제 조회
	ElseIf szTranID == "obcsb_fiin_001r" Then
		Dim szStckAmt, szStckAbleAmt, szStckLmtAmt, szEtcAmt, szEtcAbleAmt, szEtcLmtAmt
		szStckAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STTP_AMT" , 0)
		szStckAbleAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STCK_ABLE_AMT" , 0)
		szStckLmtAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STCK_LIMT_AMT" , 0)
		
		szEtcAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_AMT" , 0)
		szEtcAbleAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_ABLE_AMT" , 0)
		szEtcLmtAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_LIMT_AMT" , 0)
		
		If CInt(tabType.currenttab) == 0 Then
			tblData.SetCellString(0, 1, "50000000")
			tblData.SetCellString(1, 1, szStckAmt)
			tblData.SetCellString(3, 1, szStckAbleAmt)
'			edtAbleAmt.caption = szStckAbleAmt
		Else
			tblData.SetCellString(0, 1, "2500000")
			tblData.SetCellString(1, 1, szEtcAmt)
			tblData.SetCellString(3, 1, szEtcAbleAmt)
'			edtAbleAmt.caption = szEtcAbleAmt
		End If
		edtAmt.caption = "0"
	
	'금융투자소득 기본공제 관리
	ElseIf szTranID == "obcsb_fiin_002a" Then
		Dim szTlmsNo
		szTlmsNo = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FIIN_TLMS_NO" , 0)
		
		Form.MsgBox("안내", "금융투자소득 기본공제금액 신청이 완료되었습니다.", "REG_COMPLETE", 7, "확인", "신청내역 보기")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> "" And szSubMsg <> Null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Function f_ClearData()
	tblData.SetCellString(0, 1, "")
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(3, 1, "")
'	edtAbleAmt.caption = ""
	edtAmt.caption = ""
	g_szPwd = ""
End Function	

'============================================================================
Function f_SetTextStyle()
	Dim szText
	If CInt(tabType.currenttab) == 0 Then
		szText = "상장주식 등 금융투자소득 기본공제"
		lblTitle.caption = szText
		lblTitle.changeTextAttr(0, 4, 67, 1, true)
		imgToolTip1.left = 269
	Else
		szText = "기타 금융투자소득 기본공제"
		lblTitle.caption = szText
		lblTitle.changeTextAttr(0, 2, 67, 1, true)
		imgToolTip1.left = 218
	End If
End Function 

'============================================================================
Sub btnReg_OnClick()
	'신청 서비스 호출 전 데이터 체크
	'신청금액 미입력 체크
	If edtAmt.caption == "" Or edtAmt.caption == Null Then
		Form.ShowAlert("알림", "신청금액을 입력해 주세요.")
		Exit Sub
	End If
	
	'한도보다 큰 금액 입력 체크
	Dim szAmt, szAbleAmt
	szAmt = CInt(edtAmt.caption)
'	szAbleAmt = CInt(edtAbleAmt.caption)
	szAbleAmt = CInt(tblData.GetCellString(3, 1))
	If szAmt > szAbleAmt Then
		Form.ShowAlert("알림", "신청가능한도 확인 후 다시 입력해 주세요.")
		Exit Sub
	End If
	
	'계좌비밀번호 입력 후 신청 서비스 호출
	Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
End Sub

'============================================================================
Sub tabType_OnTabChanged(nCurrentTab)
	f_ClearData()
	f_SetTextStyle()
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

'============================================================================
Sub imgToolTip2_OnClick()
	Dim szText, nLen
	szText = "내년에도 동일하게 한도가 적용되요\n·신청한 기본공제금액이 내년에도 동일하게 자동 적용됩니다."
	
	lblLen.caption = szText
	nLen = lblLen.getLen(szText)
	
	imgToolTip2.openToolTip(szText, 290, 85, 1)
	imgToolTip2.changeToolTipTextAttr(18, CInt(nLen) - 18, 62, -4, false)
End Sub

'============================================================================
Sub imgToolTip1_OnClick()
	Dim szText, nLen
	If CInt(tabType.currenttab) == 0 Then
		szText = "상장주식 등 총 한도 : 연간 합계 5천만원\n·국내상장주식등(증권시장 양도분), 공모국내주식형적격펀드(국내상장주식에 2/3 이상 투자, 국내주식형ETF 포함), K-OTC 중소,중견기업 주식"
		
		lblLen.caption = szText
		nLen = lblLen.getLen(szText)
		
		imgToolTip1.openToolTip(szText, 320, 110, 2)
		imgToolTip1.changeToolTipTextAttr(24, CInt(nLen) - 24, 62, -4, false)
	Else
		szText = "기타 총 한도 : 연간 합계 250만원\n·해외주식, 비상장주식, 기타펀드, 파생결합증권, 파생상품, 채권 등"
		
		lblLen.caption = szText
		nLen = lblLen.getLen(szText)
		
		imgToolTip1.openToolTip(szText, 300, 85, 2)
		imgToolTip1.changeToolTipTextAttr(22, CInt(nLen) - 22, 62, -4, false)
	End If
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	f_ClearData()
	f_SetTextStyle()
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

