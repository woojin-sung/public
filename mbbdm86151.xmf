				Exit Sub 
			end if 
			
			Form.SetTimerEvent(3,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			Exit Sub 
		end if
		
		'정상
		If sRSPNTYPECODE = "0" Then 
			g_TR_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
			
			if g_BDM_FACE_YN == "Y" then
				strDate = Container0.EditIssueDate.caption			'신분증 발급일자		
				g_BDM_IDNTF_SRNO = Container0.EditSRNO.caption		'158r 리턴받은 처리일련번호
				
				Form.SetSharedData("&RET_NAME" 		, g_sharedName)	'이름
				Form.SetSharedData("&RET_ISSU_DATE"  , strDate)		'신분증 발급일자
			end if
			
			'Form.ShowAlert("알림", "수취일자 ::" & g_TR_DATE )
			
			'신분증진위확인여부
			g_IDNTF_TORF_YN = "Y" 		
			
			User_SharedData_Set()
			
			'비대면계좌개설
			if g_NMETBSWRGB == "100" then 
				if g_BDM_FACE_YN == "Y" then
					Form.SendReturnToParent("mbbdm86151" ,"OCREND" )
					
					Form.CloseForm()
				else
					'DATAMANAGER.RequestTranData("obaci_acct_049c")			
					DATAMANAGER.RequestTranData("obaci_acct_059c")
				end if
			
			'비대면업무신청(0xx), 모바일OTP(3xX)
			else 
				DATAMANAGER.RequestTranData("obcsb_nmet_102c")
			end if
			
			
		Else
		     
		     'JMY 테스트-SKIP처리인경우, 정상으로 처리
			if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then								
				
				sRSPNTYPECODE = "0"   '진위확인유형
				g_IDNTF_TORF_YN = "Y" '신분증진위확인여부
				
				'비대면계좌개설
				if g_NMETBSWRGB == "100" then 
					if g_BDM_FACE_YN == "Y" then
						strDate = Container0.EditIssueDate.caption			'신분증 발급일자		
						g_BDM_IDNTF_SRNO = Container0.EditSRNO.caption		'158r 리턴받은 처리일련번호
						
						User_SharedData_Set()
						Form.SendReturnToParent("mbbdm86151" ,"OCREND" )
						
						Form.CloseForm()
					else
'					DATAMANAGER.RequestTranData("obaci_acct_049c")			
						DATAMANAGER.RequestTranData("obaci_acct_059c")	
					end if
					
				'비대면업무신청(0xx), 모바일OTP(3xX)
				else 
					DATAMANAGER.RequestTranData("obcsb_nmet_102c")
				end if
				
				
			else
     			'v0001 신분증진위확인여부
				g_IDNTF_TORF_YN = "N"

			  'v0001 진위확인 오류내역 생성추가
			  DATAMANAGER.RequestTranData("obaci_idvs_003a")
		  
				'v0001 아래의 내용은 오류이력(obaci_idvs_003a)처리 후로 이동 
'				'수기허용
'				If sRSPNTYPECODE = "8" Then 					
'					
'					'신분증진위확인여부
'					'g_IDNTF_TORF_YN = "N" v0001 설정위치변경
'					
'					'비대면계좌개설
'					if g_NMETBSWRGB == "100" then 
'						DATAMANAGER.RequestTranData("obaci_acct_049c")			
'					'비대면업무신청(0xx), 모바일OTP(3xX)
'					else 
'						DATAMANAGER.RequestTranData("obcsb_nmet_102c")
'					end if
'
'				ElseIf sRSPNTYPECODE = "R" Then 					'재시도
'					
'					'20210503 LES START
'					'strMsg = "신분증을 재확인하시어 재촬영 후 진행하시기 바랍니다."
'					strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
'					
'					Form.OpenPopup("mbbdm86152" , strMsg)
'					
'					Exit Sub 
'				ElseIf sRSPNTYPECODE = "9" Then 					'오류
'					
'					'20210503 LES START
'					'strMsg = "처리불가합니다."
'					strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."
'					Form.OpenPopup("mbbdm86152" , strMsg)
'					
'					Exit Sub
'				
'				
'				ElseIf sRSPNTYPECODE = "7" Then
'				
'					'20210503 LES START
'					'strMsg = "처리불가합니다."
'					strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
'					Form.OpenPopup("mbbdm86152" , strMsg)
'					
'					Exit Sub
'				
'				Else
'					
'					strMsg = sRSPNMSG
'					Form.OpenPopup("mbbdm86152" , strMsg)
'				
'				End If
			
			end if
		End If
	'v0008 jsi end
    'v0001 진위확인이력생성 
	ElseIf szTranID = "obaci_idvs_003a" Then		
		If sRSPNTYPECODE = "8" Then  '수기허용 
			'수기허용도 진위확인 오류로 처리함
			strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf sRSPNTYPECODE = "R" Then	'재시도
			strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf sRSPNTYPECODE = "9" Then	'오류
			strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
		ElseIf sRSPNTYPECODE = "7" Then		
			strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
		Else
			If Trim(g_sRSPNMSG) <> "" Then
				strMsg = g_sRSPNMSG
			Else
				strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
			End If
		End If
		
		Form.OpenPopup("mbbdm86152" , strMsg)
		Exit Sub
	
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'오류발생시 재처리를 위해 버튼 활성화
	BtnSend.enable = true
	BtnSend.btnimage = "btn_20.9"
	BtnSend.fgcolor = "273"	
	
	if szTranID = "obaci_acct_158a" or szTranID = "obaci_acct_158a_1" then
		
		If szErrCode = "4984" then
		
			strTitle = "알림"
			strMsg = "생년월일을 확인하세요.\n(주민번호 앞 6자리)"
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
		Else 
			
			strMsg = "신분증 정보를 읽을 수 없습니다.다시 시도하여 주십시요."
			Form.OpenPopup("mbbdm86152" , strMsg)
			
		End If
			
	
'	elseif szTranID = "obaci_acct_049c" or szTranID = "obcsb_nmet_102c" or szTranID == "obaci_acct_059c" then
	elseif szTranID = "obcsb_nmet_102c" then 'or szTranID == "obaci_acct_059c" then
		
		if szTranID = "obcsb_nmet_102c"  and (ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1) then
			g_BDM_REG_STAG_CLS_CODE = ""	'등록단계구분코드
			'g_BDM_REG_UNIQ_NO 	 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "REG_UNIQ_NO"      , 0)	'등록고유번호
			
'			'공유변수 설정
'			User_SharedData_Set()
'	
'			strTitle = "알림"
'			strMsg = "신분증 전송이 완료 되었습니다."
'			strFlag = "complete"
'			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			strDate = Container0.EditIssueDate.caption			'신분증 발급일자		
			g_BDM_IDNTF_SRNO = Container0.EditSRNO.caption		'158r 리턴받은 처리일련번호
			
			Form.SetSharedData("&RET_NAME" 		, g_sharedName)	'이름
			Form.SetSharedData("&RET_ISSU_DATE"  , strDate)		'신분증 발급일자
			
			User_SharedData_Set()
			
			'mbbdm86150 화면을 닫아주는 용도
			Form.SendReturnToParent("mbbdm86151" ,"OCREND" )
			
			'20230410 yhj
			Form.CloseForm()
			
		else		
			strMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
			strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp
			
			Form.OpenPopup("mbbdm86152" , strMsg)
		end if
		
	elseif szTranID == "obaci_acct_059c" then

		strTitle = "안내"		
		strFlag = "error"
		
		if strMsgTmp == "임직원CFD개설제한" then
		
			strMsg = "임직원 제한사항을 확인해주세요.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 일반 유형은 국가별 1계좌만 가능"
			
		elseif szErrCode == "4572" or szErrCode == "4480" then
		
			'strMsg = "이미 개설이 완료되었거나, 취소가 된 경우에는" & Chr(13) & Chr(10) & "이어하기가 불가합니다."
			Form.MsgBox("안내", "이미 개설이 완료되었거나\n취소가 된 경우에는\n이어하기가 불가합니다.", "PrgsExit", 6)
			Exit Sub            
			
		else	
		
			strMsgTmp = trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
			strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp		
			
		end if
		
		'Form.OpenPopup("mbbdm86152" , strMsg)
		Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
		
	elseIf szTranID = "obtss_idvs_001a" or szTranID = "obtss_idvs_002a"  Then 
		
		If szErrCode = "4984" then
		
			strTitle = "알림"
			strMsg = "이름을 확인하세요."
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
		
		else
			'JMY Sta
			if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then
				
				'테스트_신분증인증SKip
			     'Form.SetTimerEvent("1", 0, 30)
				'obtss_idvs_002a 인경우 return fail 로 outblock이 세팅되지 않음
				'g_TR_DATE		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
				'g_OTSDTRUNIQNO	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
				sRSPNTYPECODE		= "0"	'0:정상 9:오류  8:수기허용 R:재시도			
				g_IDNTF_TORF_YN	= "Y"	'신분증진위확인여부
				
				if g_BDM_FACE_YN == "Y" then
					'공유변수 설정
					User_SharedData_Set()
					
					Form.SendReturnToParent("mbbdm86151" ,"OCREND" )
					
					Form.CloseForm()
				else
					'비대면계좌개설
					if g_NMETBSWRGB == "100" then 
		'				DATAMANAGER.RequestTranData("obaci_acct_049c")			
						
						
						DATAMANAGER.RequestTranData("obaci_acct_059c")			
						
					'비대면업무신청(0xx), 모바일OTP(3xX)
					else 
						DATAMANAGER.RequestTranData("obcsb_nmet_102c")
					end if		
				end if
			'JMY Fin
			
			else
				
				strMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
				
				strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp
				Form.OpenPopup("mbbdm86152" , strMsg)
		
			end if
		
		end if			

	elseif szTranID = "obaci_acct_234a" then
		
		strMsgTmp = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp
		Form.OpenPopup("mbbdm86152" , strMsg)
	

		
    'v0001 진위확인이력생성 
	ElseIf szTranID = "obaci_idvs_003a" Then
         '이력생성중 오류인 경우인 경우 오류종료처리하지 않고, 진위확인오류로 처리함

		If sRSPNTYPECODE = "8" Then  '수기허용 
			'수기허용도 진위확인 오류로 처리함
			strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf sRSPNTYPECODE = "R" Then	'재시도
			strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf sRSPNTYPECODE = "9" Then	'오류
			strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
		ElseIf sRSPNTYPECODE = "7" Then		
			strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
		Else
			If Trim(g_sRSPNMSG) <> "" Then
				strMsg = g_sRSPNMSG
			Else
				strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
			End If
		End If
		
		Form.OpenPopup("mbbdm86152" , strMsg)
		Exit Sub
		
     else
		strMsgTmp = trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
		strMsg = szErrMsg & Chr(13) & Chr(10) & strMsgTmp		
			
		'Form.OpenPopup("mbbdm86152" , strMsg)
		Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")     
		
	end if
	
End Sub

