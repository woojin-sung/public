'============================================================================
Function User_SharedData_Set(gb)	'JMY

    '진입점에서 설정되는 정보 ---------------------------------------
    Form.SetSharedData("BDM_FRST_MAPID"  , g_BDM_FRST_MAPID  )	'최초진입화면ID
    Form.SetSharedData("BDM_NMETBSWRGB"  , g_BDMNMETBSWRGB   )	'비대면업무구분
    Form.SetSharedData("mOTP_IntoClcd"	, g_mOTP_IntoClcd   )	'(모바일OTP)진입구분코드
    Form.SetSharedData("BDM_CSNO"  		, g_BDM_CSNO		 ) '고객번호


    if gb == "Init" then
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"    		, "")	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, "")	'등록단계구분코드
		Form.SetSharedData("BDM_NAME"         		, "")	'이름
		Form.SetSharedData("BDM_RCNO_PIP"       		, "")	'주민등록번호
		Form.SetSharedData("BDM_COMPANY_CODE"  	 	, "")	'통신사 정보
		Form.SetSharedData("BDM_HP1"          		, "")	'휴대폰번호
		Form.SetSharedData("BDM_HP2"              	, "")
		Form.SetSharedData("BDM_HP3"              	, "")
		Form.SetSharedData("BDM_CI_KEY"              	, "")
		'Form.GetSharedData("BDM_MNY_ACNT_YN"          , g_BDM_MNY_ACNT)
		'Form.ShowAlert("jsi 86151 Init 178" , g_BDM_MNY_ACNT)
		Form.SetSharedData("BDM_MNY_ACNT_YN"          , g_BDM_MNY_ACNT) '20231109 jsi setshared추가
		
		'신분증진위확인에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_IDNTF_SRNO"          	, "")	'신분증일련번호

		'이어하기안내용, 진행상태보기용 Data ---------------------------------------
		Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"	, "" )	'최종등록단계구분코드
		Form.SetSharedData("BDM_CLEAR_YN"     		, "" )	'이어하기여부
		Form.SetSharedData("BDM_PRNM"       			, "" )	'개설상품명
		Form.SetSharedData("BDM_BDM_APLTDATE"   		, "" )	'신청일자
		Form.SetSharedData("BDM_BDM_CLSNDATE"   		, "" )	'신청마감일자
		
		'개설상품 선택 관련
		Form.SetSharedData("BDM_PRCD100"            , "")  '종합매매 가입여부
		Form.SetSharedData("BDM_PRCD118RP"          , "")  'CMA(증권형) 가입여부
		Form.SetSharedData("BDM_PRCD100F"           , "")  '종합매매(금상전용) 가입여부
		Form.SetSharedData("BDM_PRCD101"            , "")  '선물옵션 가입여부
		Form.SetSharedData("BDM_PRCD135"            , "")  '해외파생 가입여부
		Form.SetSharedData("BDM_PRCD133"            , "")  'ISA 가입여부
		Form.SetSharedData("BDM_PRCDCFD"            , "")  'CFD 가입여부	
		Form.SetSharedData("BDM_PRCD137"			, "")	'해외CFD 가입여부
		Form.SetSharedData("BDM_ISA_PROD_TYPE"		, "")	'ISA type
		Form.SetSharedData("BDM_PRCD131"		, "")	'연금저축 가입여부
		Form.SetSharedData("BDM_WRAP"			, "")		'랩 가입여부
		Form.SetSharedData("BDM_PRCD200"		, "")		'슈퍼365 가입여부
		
		Form.SetSharedData("BDM_REG_SRNO"        	, "")			'등록일련번호	'ksj 2021-07-23    
		Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, "")			'목표시장부적합여부'ksj 2021-07-23
		Form.SetSharedData("BDM_ACFD_REG_SRNO"					, "")	'해외CFD목표시장등록일련번호	
		Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"			, "")	'해외CFD목표시장부적합여부	
		Form.SetSharedData("BDM_DMST_CFD_ACNT_APLT_YN1"           , "")		'국내CFD 계좌신청여부(일반)
		Form.SetSharedData("BDM_DMST_CFD_ACNT_APLT_YN2"           , "")		'국내CFD 계좌신청여부(안심)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN1"           , "")		'해외CFD 계좌신청여부(미국/일반)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN2"           , "")		'해외CFD 계좌신청여부(미국/안심)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN3"           , "")		'해외CFD 계좌신청여부(중국/일반)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN4"           , "")	 	'해외CFD 계좌신청여부(중국/안심)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN5"           , "")		'해외CFD 계좌신청여부(홍콩/일반)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN6"           , "")	 	'해외CFD 계좌신청여부(홍콩/안심)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN7"           , "")		'해외CFD 계좌신청여부(일본/일반)
		Form.SetSharedData("BDM_OVRS_CFD_ACNT_APLT_YN8"           , "")		'해외CFD 계좌신청여부(일본/안심)
		
		Form.SetSharedData("BDM_PNSN_TCTR_CLS_CODE"          , "")		'연금이관구분코드(신규/이수전용)
		Form.SetSharedData("BDM_PNSN_CNRC_PRD"           	, "")		'연금계약기관
		Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , "")		'연금지급개시예정일
		Form.SetSharedData("BDM_PNSN_CNRC_AMT"           	, "")		'연금계약금액
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , "")		'연금지급은행코드
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , "")		'연금지급은행계좌번호
		
		Form.SetSharedData("BDM_PROS_DATE"          , "")
		Form.SetSharedData("BDM_PROS_SRNO"          , "")
		Form.SetSharedData("BDM_MNY_PROS_DATE"          , "")
		Form.SetSharedData("BDM_MNY_PROS_SRNO"          , "")
		
		Form.SetSharedData("BDM_MANG_BRCD"          , "")  '관리점
		Form.SetSharedData("BDM_FACE_YN"          , "")	'안면인식 수행 여부
		Form.SetSharedData("BDM_CERT_METHOD"          , "")
		Form.SetSharedData("BDM_OTSD_TR_UNIQ_NO"          , "")
    else
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"       	, g_BDM_REG_UNIQ_NO   		)	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, g_BDM_REG_STAG_CLS_CODE 	)	'등록단계구분코드
		Form.SetSharedData("BDM_NAME"         		, g_BDM_NAME        		)	'이름
		Form.SetSharedData("BDM_RCNO_PIP"       		, g_BDM_RCNO_PIP      		)	'주민등록번호
		Form.SetSharedData("BDM_COMPANY_CODE"   		, g_BDM_COMPANY_CODE    	)	'통신사 정보
