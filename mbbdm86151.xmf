			'Form.ShowAlert("ImgFaceDataLen", ImgFaceDataLen)
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ATCH_FILE_SIZE"		, 0 	, ImgFaceDataLen			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IMG_DATA"		, 0 	, ImgFaceData		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IDNTF_KIND_CODE"		, 0 	, g_IDNTF_CODE 	 			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ORGL_RCNO_PIP"		, 0 	, g_AFT_RCNO_PIP 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BRDT"				, 0 	, Container0.EditRcno.caption			)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_RCNO_7	 				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 	, "U" 				)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SRNO"				, 0 	, g_SRNO	 				)
		
		
'	Case "obaci_acct_049c"
'			
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock1", "REG_STAG_CLS_CODE"	, 0 , "1")
'			
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_OTSDTRUNIQNO		)
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "TR_DATE"				, 0 , g_TR_DATE			)
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "IDNTF_SRNO"			, 0 , Container0.EditSRNO.caption		)
'			
'			if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then  'JMY TEST Skip
'				DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "RSPN_TYPE_CODE"	, 0 , "T")
'			else
'				DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "RSPN_TYPE_CODE"	, 0 , sRSPNTYPECODE		)
'			end if
'			
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "IDNTF_TORF_YN"		, 0 , g_IDNTF_TORF_YN		)
'			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_FEATURE_LEN		)
		
	Case "obaci_acct_059c"
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE"	, 0 , "1")
		
		Dim szMccoCode
		If g_BDM_COMPANY_CODE == "1" Or g_BDM_COMPANY_CODE == 1 Then
		    szMccoCode = "SKT"
		ElseIf g_BDM_COMPANY_CODE == "2" Or g_BDM_COMPANY_CODE == 2 Then
		    szMccoCode = "KTF"
		ElseIf g_BDM_COMPANY_CODE == "3" Or g_BDM_COMPANY_CODE == 3 Then
		    szMccoCode = "LGT"
		ElseIf g_BDM_COMPANY_CODE == "5" Or g_BDM_COMPANY_CODE == 5 Then
		    szMccoCode = "SKA "
		ElseIf g_BDM_COMPANY_CODE == "6" Or g_BDM_COMPANY_CODE == 6 Then
		    szMccoCode = "KTA"
		ElseIf g_BDM_COMPANY_CODE == "7" Or g_BDM_COMPANY_CODE == 7 Then
		    szMccoCode = "LGA"
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "RCNO_TYPE_CODE"      , 0 , "01"                     )  '실명확인번호유형코드 01.주민등록번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "RCNO_PIP"            , 0 , g_BDM_RCNO_PIP )  '실명확인번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CUST_ABWR_NAME"      , 0 , g_BDM_NAME )  '고객명
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ATHN_MTHD_CLS_CODE"  , 0 , "1"                      )  '인증방법구분코드 1.휴대폰본인인증 2.인증서인증 3.바이오인증
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "ATHN_STAT_CLS_CODE"  , 0 , "1"                      )  '인증상태구분코드 1.정상
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MCCO_CODE"           , 0 , szMccoCode                )  '통신사코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CLPH_ARCD"           , 0 , g_BDM_HP1                  )  '휴대폰
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CLPH_TONO"           , 0 , g_BDM_HP2                  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CPNO"                , 0 , g_BDM_HP3                  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "CIKEY_NO"            , 0 , g_BDM_CIKEY                )  'CIKEY번호
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_OTSDTRUNIQNO		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "TR_DATE"				, 0 , g_TR_DATE			)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_SRNO"			, 0 , Container0.EditSRNO.caption		)
		if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then  'JMY TEST Skip
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"	, 0 , "T")
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "RSPN_TYPE_CODE"	, 0 , sRSPNTYPECODE		)
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_TORF_YN"		, 0 , g_IDNTF_TORF_YN		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_FEATURE_LEN		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "IDNTF_KIND_CODE"	, 0 , g_IDNTF_CODE		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "SRNO"	, 0 , ""		)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "MANG_BRCD"	, 0 , g_BDM_MANG_BRCD)
		
		Set_obaci_acct_059c(szTranID)
			
	Case "obcsb_nmet_102c"
			
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock1", "NMET_BSWR_CLCD" 		, 0 , g_NMETBSWRGB	)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock1", "BSWR_CLS_CODE"		, 0 , "2")	'2.신분증진위확인
			
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_OTSDTRUNIQNO		)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "TR_DATE"				, 0 , g_TR_DATE			)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "IDNTF_SRNO"			, 0 , Container0.EditSRNO.caption		)
			
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "RSPN_TYPE_CODE"		, 0 , sRSPNTYPECODE		)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "IDNTF_TORF_YN"		, 0 , g_IDNTF_TORF_YN		)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_FEATURE_LEN		)
		
	'신분증 진위확인 SVC CALL
	Case "obtss_idvs_001a"			
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_CLS_CODE"       	, 0 	, g_IDNTF_CLS_CODE			)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "RCNO_PIP"                	, 0 	, g_AFT_RCNO_PIP				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_RCNO_PIP"           	, 0 	, g_RCNO_PIP					)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_FLNM"           	, 0 	, Container0.EditName.caption	)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_IDNTF_FLNM"      	, 0 	, g_NAME						)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ISNC_DATE_PIP"            , 0 	, Container0.EditIssueDate.caption	)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_ISNC_DATE_PIP"       , 0 	, g_ISSU_DATE					)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "OLD_DRVN_LCNS_NO_PIP"     , 0 	, "" 				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP", 0 	, ""   			)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_SPFT_VLTN_SCOR" 	, 0 	, g_FEATURE_SCORE				)
			
			'운전면허번호 4개 필드로 분리
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "UI_ISNC_REGN_CODE" 	, 0 	, g_LISENCE_NUM1				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "UI_ISNC_YEAR" 	, 0 	, g_LISENCE_NUM2				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "UI_ISNC_SRNO_PIP" 	, 0 	, g_LISENCE_NUM3				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "UI_ISNC_DETL_SRNO" 	, 0 	, g_LISENCE_NUM4				)
			
			'10:비대면모바일
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "NMET_CLS_CODE"        	, 0 	, "10" 						)
			
			'TEST 용. 금융결제원 연결전까지 SVCD 에 응답코드를 입력하면 해당응답코드로 service return
			'DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "SVCD"                 	, 0 	, "000" 						) 
		
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ATCH_FILE_SIZE"       	, 0 	, g_FEATURE_LEN 				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "UI_PHTG_DATA_CNTT"     	, 0 	, g_FEATURE					)
	
	'신분증 특징점 저장 TR 호출 
	Case "obaci_acct_234a"	
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "REG_STAG_CLS_CODE"		, 0  , "1"				)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "REG_UNIQ_NO"			, 0  , g_BDM_REG_UNIQ_NO	)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "ATCH_FILE_SIZE"			, 0  , g_FEATURE_LEN		)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "UI_PHTG_DATA_CNTT"		, 0  , g_FEATURE			)
		
	'v0001 진위확인오류내역 
	Case "obaci_idvs_003a"
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_RSLT_CLCD", 0  , sRSPNTYPECODE 	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "RCNO_PIP"                 , 0  , g_AFT_RCNO_PIP	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_RCNO_PIP" , 0  , g_AFT_RCNO_PIP                  )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_CLS_CODE"           , 0  , g_IDNTF_CLS_CODE                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_RCNO_PIP"            , 0  , g_RCNO_PIP                      )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_FLNM"           	, 0  , Container0.EditName.caption     )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_IDNTF_FLNM"      	, 0  , g_NAME                          )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ISNC_DATE_PIP"            , 0  , Container0.EditIssueDate.caption)
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_ISNC_DATE_PIP"       , 0  , g_ISSU_DATE                     )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "OLD_DRVN_LCNS_NO_PIP"     , 0  , ""                   )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP", 0  , ""                   )
			
			'운전면허번호 4개 필드로 분리
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "UI_ISNC_REGN_CODE" 	, 0 	, g_LISENCE_NUM1				)
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "UI_ISNC_YEAR" 	, 0 	, g_LISENCE_NUM2				)
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "UI_ISNC_SRNO_PIP" 	, 0 	, g_LISENCE_NUM3				)
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "UI_ISNC_DETL_SRNO" 	, 0 	, g_LISENCE_NUM4				)
			
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_SPFT_VLTN_SCOR" 	, 0  , g_FEATURE_SCORE                 )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "TR_DATE"         		, 0  , g_TR_DATE                       )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "OTSD_TR_UNIQ_NO" 		, 0  , g_OTSDTRUNIQNO                  )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_YN" 			, 0  , g_IDNTF_TORF_YN                 )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "SCR_TYPE_CLS_CODE" 		, 0  , "1"                             )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1",  "REG_UNIQ_NO" 			, 0  , g_BDM_REG_UNIQ_NO	           )
	
	End Select
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	ShowAlert(szTranID, "11")
	If szTranID = "obaci_acct_158a" then
		
	'JMY Sta ---------------------------------------
	'비대면계좌개설(100), 비대면업무신청(0xx), 모바일OTP(3xx) 모두 진위확인 체크함
		g_AFT_RCNO_PIP = DATAMANAGER.GetDataValue(0, "obaci_acct_158a" , "OutBlock1" , "MDAF_RCNO_PIP" , 0)
		g_SRNO = DATAMANAGER.GetDataValue(0, "obaci_acct_158a" , "OutBlock1" , "SRNO" , 0)
		
		'jsi 테스트-SKIP처리인경우, 158a 내역 없으므로 바로 송수신 처리하러 감
		if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then	
			g_BDM_IDNTF_SRNO = Container0.EditSRNO.caption
			
			g_BIORetry = 0 '초기화
			sRSPNTYPECODE = ""
			DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		else 
			''20231207 jsi 수정: 이미지 처리 안함---------------------------------------------
			'DATAMANAGER.RequestTranData( "obaci_acct_158a_1" )
			g_BIORetry = 0 '초기화
			sRSPNTYPECODE = ""
			DATAMANAGER.RequestTranData("obtss_idvs_001a") 
			''20231207 jsi 수정: 이미지 처리 안함---------------------------------------------
		end if
		
'		g_BIORetry = 0 '초기화
'		sRSPNTYPECODE = ""
'		DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		'Form.SetTimerEvent("1", 1, 30)
	
	elseif szTranID == "obaci_acct_158a_1" then
	
	
		g_BIORetry = 0 '초기화
