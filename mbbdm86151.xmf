'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	
	If sTimerID == "1" or sTimerID == 1 Then
		Form.ShowAlert("오류", "통신상태가 원활하지 않습니다.\n잠시 후 다시 처리해 주세요.")
		Form.SetTimerEvent(sTimerID, 0, 30)
		
		Exit Sub
	elseif sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2(sTimerID, 0, DEF_1ST_TIME)
		
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "OTSD_TR_UNIQ_NO"	, 0,  g_OTSDTRUNIQNO)
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.RequestTranData("obtss_idvs_002a")
		
	elseif sTimerID == "3" or sTimerID == 3 Then
		Form.SetTimerEvent(sTimerID, 0, DEF_2ST_TIME)
		
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "OTSD_TR_UNIQ_NO"	, 0,  g_OTSDTRUNIQNO)
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.RequestTranData("obtss_idvs_002a")

	End If
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbdm86151_p1" then
		if sRet == "complete_ok" then
			
			strDate = Container0.EditIssueDate.caption			'신분증 발급일자		
			g_BDM_IDNTF_SRNO = Container0.EditSRNO.caption		'158r 리턴받은 처리일련번호
			
			Form.SetSharedData("&RET_NAME" 		, g_sharedName)	'이름
			Form.SetSharedData("&RET_ISSU_DATE"  , strDate)		'신분증 발급일자
			
			User_SharedData_Set()
			
			'mbbdm86150 화면을 닫아주는 용도
			Form.SendReturnToParent("mbbdm86151" ,"OCREND" )
			
			'20230410 yhj
			Form.CloseForm()
			
			
			
			
			'다음 화면 오픈은 86150 화면에서 받아 처리하므로 아래 내용은 주석
			
'			'비대면계좌개설
'			if g_NMETBSWRGB == "100" Then
'			
'				'고객정보입력 단계
'				g_nextScr = "mbbdm86160"
'				
'			'비대면업무신청
'			elseif g_sz_SubNmetBswrGb == "0" then
'			
'				'본인계좌인증(1원역이체) 화면
'				g_nextScr = "mbbdm86190"
'			
'			'모바일OTP(3xx)
'			else
'			
'				'본인계좌인증(1원역이체) 화면
'				g_nextScr = "mbbdm86190"
'			end if
			
		end if
	
	elseif sKeyName = "mbbdm86152" then
	
		'오류발생시 재처리를 위해 버튼 활성화
		BtnSend.enable = true	
		BtnSend.btnimage = "btn_20.9"
		BtnSend.fgcolor = "273"
	
		if sRet == "Retry" then
			Form.CloseForm()
			Form.runInziCamera()
		end if
		
		
	end if
End Sub

