'============================================================================
Sub Form_OnFormInit()
	
		
	'==================================
	' TEST
	'==================================
	nDev = Form.GetSharedData("&SERVER_MODE", false )	
	if nDev == "1" then
		ChkButton0.visible = true
	else
		ChkButton0.visible = false
		ChkButton0.checkstate = 0
	end if
	'==================================
	
	'라벨글자색
	Container0.Label0.fgcolor = 269
	Container0.Label1.fgcolor = 269
	
	Container0.Label3.fgcolor = 268
	Container0.Label4.fgcolor = 268
	Container0.Label5.fgcolor = 268
	Container0.Label6.fgcolor = 268
	
	

	'OS타입
	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	
	
	if g_OsType == "1" then 'AOS
		Form.setCaptureEnblYN("N")
	end if
	
	g_TR_DATE  = Form.GetSharedData("&HOST_DATE", false )

	'공유변수 데이터GET
	User_SharedData_Get()
	
	'비대면계좌개설인 경우에만 진행단계표시
	if g_NMETBSWRGB == "100" then
		ImgF.visible = true
	else
		ImgF.visible = false
	end if		
		
	Container0.EditName.imagefilepth			= "login_input_off.9.png"
	Container0.EditRcno.imagefilepth			= "login_input_off.9.png"
	
'	Container0.edtLicense1.imagefilepth = "alpha"
'	Container0.edtLicense2.imagefilepth = "alpha"
	Container0.edtLicense3.imagefilepth = "login_input_off.9.png"
'	Container0.edtLicense4.imagefilepth = "alpha"
	
	'iOS 보안키패드 가리는 현상 조치
	if g_OsType == "2" then
		Container0.edtLicense3.SetUseAutoScroll(true)
	end if
	
	Container0.Label3.fgcolor = 268
	Container0.Label4.fgcolor = 268
	Container0.Label5.fgcolor = 268
	Container0.Label6.fgcolor = 268
		
	
	'발급일자 컨트롤 세팅(평문으로 보여야함)
	Container0.EditIssueDate.SetDispPlain()
	
	'신분증 데이터 세팅
	Call DATA_SET()
	

	
	
End Sub


'============================================================================
' 사진촬영 후 메인에서 받은 데이터 세팅
'============================================================================
Sub DATA_SET()

	
	g_ImgData = ""
	g_ImgDataLen = 0

	ImgFaceData = ""
	ImgFaceDataLen = 0
	
	
	'주민등록증 10, 주민등록증(재외국민)12, 면허증11
	g_IdCardType = Form.GetSharedData("&RET_CARD_TYPE", 0)
	If g_IdCardType = "10" then
		
		Container0.EditLicenseNo.left = 500
		Container0.EditLicenseNo.visible = false
		Container0.Label5.visible = false
		
		Container0.edtLicense1.visible = false
		Container0.edtLicense2.visible = false
		Container0.edtLicense3.visible = false
		Container0.edtLicense4.visible = false
		Container0.lblDash1.visible = false
		Container0.lblDash2.visible = false
		Container0.lblDash3.visible = false
		
		Container0.EditIssueDate.top = 377
		Container0.Label6.top = 379
		Container0.Button0.height = 152
		
		
		g_IDNTF_CODE     =  "1"  
		g_IDNTF_CLS_CODE =  "01" 
	
	'재외국민 주민등록증은 사용불가 처리
	Elseif g_IdCardType = "12" then
		strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."
		Form.OpenPopup("mbbdm86152" , strMsg)
		
	Elseif g_IdCardType = "11" then
	
		'면허번호 중요정보로 숨김처리
'		Container0.EditLicenseNo.left = 500
'		Container0.EditLicenseNo.visible = false
'		Container0.Label5.visible = false
'		
'		
'		Container0.EditIssueDate.top = 377
'		Container0.Label6.top = 379
'		Container0.Button0.height = 152
	
				
		g_IDNTF_CODE     =  "2"  'v0002
		g_IDNTF_CLS_CODE =  "02" 'v0004
	
	End if
	
	
	'OCR정보 세팅
	Container0.EditName.caption  		= Form.GetSharedData("&RET_NAME", 0)				'이름
	Container0.EditRcno.caption  		= left(Form.GetSharedData("&RET_BIRTHDAY", 0), 6)	'생년월일
	Container0.EditLicenseNo.caption 	= Form.GetSharedData("&RET_LICENSE_NUM", 0) 		'
	Container0.EditIssueDate.caption 	= Form.GetSharedData("&RET_ISSU_DATE", 0) 		'v0004. 발급일자. 컨트롤 변경
	
	'운전면허번호 4영역으로 분할
	Container0.edtLicense3.pwdlen = 6
	
	Container0.edtLicense1.caption = Form.GetSharedData("&RET_LICENSE_NUM1"	, 0 )
	Container0.edtLicense2.caption = Form.GetSharedData("&RET_LICENSE_NUM2"	, 0 )
	Container0.edtLicense3.caption = Form.GetSharedData("&RET_LICENSE_NUM3"	, 0 )
	Container0.edtLicense4.caption = Form.GetSharedData("&RET_LICENSE_NUM4"	, 0 )
	
	g_NAME		    = Form.GetSharedData("&RET_NAME", 0)				'이름
	g_RCNO 		    = Form.GetSharedData("&RET_JUMIN_NUM", 0 )		'암호화된 실명확인번호
	g_ISSU_DATE	    = Form.GetSharedData("&RET_ISSU_DATE", 0)			'발급일자
	
	ImgMskData 	    = Form.GetSharedData("&RET_MASK_IMAGE_ENC" , 0)	'주민번호 마스킹이미지 
	g_ImgData  	    = Form.GetSharedData("&RET_IMAGE_ENC", 0)			'주민번호 마스킹없는이미지
	''20231207 jsi 수정: 이미지 처리 안함---------------------------------------------
	ImgFaceData	    = ""'Form.GetSharedData("&RET_FACE_IMAGE" , 0)		'얼굴 이미지
	''20231207 jsi 수정: 이미지 처리 안함---------------------------------------------
	'v0004
	g_FEATURE 	  = Form.GetSharedData("&RET_FEATURE"		, 0 ) 	'특징점데이터
	g_FEATURE_SCORE = Form.GetSharedData("&RET_FEATURE_SCORE"	, 0 ) 	'특징점 점수
	g_FEATURE_LEN   = Form.GetSharedData("&RET_FEATURE_LEN"	, 0 ) 	'특징점데이터 길이
	g_SERIAL    	  = Form.GetSharedData("&RET_SERIAL"			, 0 ) 	'발급번호
	g_LISENCE_NUM   = Form.GetSharedData("&RET_LICENSE_NUM"	, 0 ) 	'신분증번호
	
	'운전면허증번호 4자리로 세분화
	g_LISENCE_NUM1 = Form.GetSharedData("&RET_LICENSE_NUM1"	, 0 ) 	'발급지역코드(평문) 
	g_LISENCE_NUM2 = Form.GetSharedData("&RET_LICENSE_NUM2"	, 0 ) 	'발급년도(평문)
	g_LISENCE_NUM3 = Form.GetSharedData("&RET_LICENSE_NUM3"	, 0 ) 	'발급일련번호1(암호화)
	g_LISENCE_NUM4 = Form.GetSharedData("&RET_LICENSE_NUM4"	, 0 ) 	'발급일련번호2(평문)
	
	g_RCNO_7		  = Form.GetSharedData("&RET_JUMIN_NUM_BACK"	, 0 ) 	'실명확인번호 뒷 7자리
	
	if ImgMskData <> "" and g_ImgData <> "" then 
		
		g_ImgDataLen 	= LEN(g_ImgData)
		ImgMskDataLen = LEN(ImgMskData)
		
		if g_ImgDataLen > 0  and ImgMskDataLen > 0 then
			Container0.Image0.SetImageDataEnc(ImgMskData)
		end if
	end if
	
	if ImgFaceData <> "" and ImgFaceData <> null then
		ImgFaceDataLen = Len(ImgFaceData)
	end if
End Sub


'============================================================================
' 신분증전송
'============================================================================
Sub BtnSend_OnClick()
	
	strName = Trim(Container0.EditName.caption)
	strRCNO = Trim(Container0.EditRcno.caption)
	strDate = Container0.EditIssueDate.caption
	
	'본인인증 입력 데이터와 신분증데이터 비교
	
	'비대면계좌개설
	if g_NMETBSWRGB == "100" Then
		g_sharedName    = Form.GetSharedData("BDM_NAME", false )		'이름 
		g_sharedBirth   = Form.GetSharedData("&RET_BIRTHDAY", false )	'생년월일 
					
		'재외국민 주민등록증인 경우 비대면 계좌개설 불가
		If g_IdCardType = "12" then 
			
			'20210503 LES START
			'strTitle = "알림"
			'strMsg = "재외국민은 비대면 계좌개설 불가"
			'strFlag = "error"
			'Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			strMsg = "재외국민은 비대면 계좌개설이 불가합니다."
			Form.OpenPopup("mbbdm86152" , strMsg)
			
			
			Exit Sub 
		End if
	
	'업무신청
	elseif g_sz_SubNmetBswrGb == "0" then
	
		g_sharedName    = Form.GetSharedData("BDM_NAME", false )		'이름 
		g_sharedBirth   = Form.GetSharedData("&RET_BIRTHDAY", false )	'생년월일
		
		'재외국민 주민등록증인 경우 업무신청불가
		If g_IdCardType = "12" then 
			
			strMsg = "재외국민은 비대면 업무신청이 불가합니다."
			Form.OpenPopup("mbbdm86152" , strMsg)
			Exit Sub 
		End if
		
	'모바일OTP	
	else
		g_sharedName    = Form.GetSharedData("BDM_NAME", false )		'이름 
		g_sharedBirth   = Form.GetSharedData("&RET_BIRTHDAY", false )	'생년월일 
		
		'재외국민 주민등록증인 경우 모바일OTP
		If g_IdCardType = "12" then 
			
			strMsg = "재외국민은 모바일OTP 발급이 불가합니다."
			Form.OpenPopup("mbbdm86152" , strMsg)
			Exit Sub 
		End if
		
		
	end if
	
	'JMY 테스트Skip인경우, 체크 제외
	if CInt(ChkButton0.checkstate) ~= 1 then 
		'-------------------------------------------------
		'입력데이터 확인 및 OCR데이터와 전단계화면 입력데이터 비교
		'-------------------------------------------------
		if strName = "" then 
			
			strTitle = "알림"
			strMsg = "이름을 확인하세요."
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		end if
		
		if strRCNO = "" then
		
			strTitle = "알림"
			strMsg = "생년월일을 확인하세요.\n(주민번호 앞 6자리)"
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		end if
		
		
		rcnoLen = Container0.EditRcno.getLen(Container0.EditRcno.caption)
		
		if cint(rcnoLen) < 6 then
		
			strTitle = "알림"
			strMsg = "생년월일을 확인하세요.\n(주민번호 앞 6자리)"
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		
		end if
		
				
		if g_sharedName <> strName then
			
			strTitle = "알림"
			strMsg = "이름을 확인하세요."
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		end if
		
		if CInt(left(strDate,4)) < 8 then 'v0004
			
			strTitle = "알림"
			strMsg = "발급일자를 확인하세요."
			strFlag = "error"
			Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub  
		end if
		
		'운전면허일련번호 6자리 체크
		if g_IdCardType == "11" then
			nLen = Cint(Container0.edtLicense3.pwdlen)
			if nLen < 6 then
				strTitle = "알림"
				strMsg = "운전면허번호를 확인하세요.\n(면허일련번호 6자리)"
				strFlag = "error"
				Form.OpenPopup("mbbdm86151_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
				
				exit sub
			end if
			
		end if
	end if
	
	'더블클릭방지
	BtnSend.enable = false
	If Form.GetEnvData("common.theme") = "black" Then
		BtnSend.btnimage = "btn_27.9"
	Else 
		BtnSend.btnimage = "btn_21.9"
	End If
	BtnSend.fgcolor = "269"	
	
	'-------------------------------------------------
	'서비스호출
	'재시도의 경우 obaci_acct_158a SKIP 후 obtss_idvs_001a Call
	'-------------------------------------------------
	g_RCNO_PIP		= g_RCNO
	
	'JMY Sta ---------------------------------------
	'비대면계좌개설(100), 비대면업무신청(0xx), 모바일OTP(3xx) 모두 진위확인 체크함
	If sRSPNTYPECODE <> "R" Then
		if Len(g_ImgData) < 102400 then	'이미지 최대사이즈 
			DATAMANAGER.RequestTranData("obaci_acct_158a")
		end if	
	Else
		sRSPNTYPECODE = ""
		g_BIORetry = 0 '초기화
		DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		'Form.SetTimerEvent("1", 1, 30) '1:Set
	End If

End Sub

'============================================================================
Function Set_obaci_acct_059c(szTranID)
	if g_BDM_MNY_ACNT == "Y" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "CNFR_TRGT_CUST_CLCD"	, 0 , 	"01"	)
	else
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "CNFR_TRGT_CUST_CLCD"	, 0 , 	"04"	)
	end if
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "ACNT_OPNG_CLCD"	, 0 , 	"1"	)		'신규개설 
	
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "SAC_ACNT_APLT_YN"               , 0 , g_BDM_PRCD200			)  '슈퍼365신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVTR_JOIN_APLT_YN"              , 0 , g_BDM_PRCD100       	)  '종합매매가입신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "CMA_RP_JOIN_APLT_YN"            , 0 , g_BDM_PRCD118RP		)  'CMARP가입신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "FUTS_OPTN_ACNT_APLT_YN"         , 0 , g_BDM_PRCD101			)  '선물옵션계좌신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVDV_ACNT_APLT_YN"              , 0 , g_BDM_PRCD135			)  '해외파생계좌신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "WRAP_ACNT_APLT_YN"              , 0 , g_BDM_WRAP				)  '랩신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_ACNT_APLT_YN"          , 0 , g_BDM_PRCDCFD			)  'CFD계좌신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_ACNT_APLT_YN"               , 0 , g_BDM_PRCD133			)  'ISA계좌신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_PROD_TYPE_CLCD"				, 0 , g_BDM_ISA_PROD_TYPE			)  'ISA상품유형구분코드(2:일임형 / 3:중개형)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_JOIN_TPCD"					, 0 , "66"						)  'ISA가입유형코드
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ISA_ACNT_OPNG_CLCD"				, 0 , g_BDM_ISA_ACNT_OPNG_CLCD		)  'ISA계좌개설구분코드(1:신규 / 2:이수)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN"			, 0 , g_BDM_PRCD137				)  '해외CFD계좌신청여부
	
	If g_BDM_PRCDCFD == "Y" Then
		Dim szDMST_CFD_GOAL_MRKT_AGR_YN
		szDMST_CFD_GOAL_MRKT_AGR_YN = ""
		If g_BDM_GOAL_MRKT_UNFIT_YN == "Y" Then
			szDMST_CFD_GOAL_MRKT_AGR_YN = "N"
		ElseIf g_BDM_GOAL_MRKT_UNFIT_YN == "N" Then
			szDMST_CFD_GOAL_MRKT_AGR_YN = "Y"
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "UI_SRNO"					, 0 , g_BDM_REG_SRNO     			)  '국내CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_GOAL_MRKT_AGR_YN"	, 0 , szDMST_CFD_GOAL_MRKT_AGR_YN	)  '국내CFD목표시장일치여부
	Else
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "UI_SRNO"         			, 0 , 0							)  '국내CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_GOAL_MRKT_AGR_YN"	, 0 , ""							)  '국내CFD목표시장일치여부
	End If
	If g_BDM_PRCD137 == "Y" Then
		Dim szOVRS_CFD_GOAL_MRKT_AGR_YN	
		szOVRS_CFD_GOAL_MRKT_AGR_YN = ""
		If g_BDM_ACFD_GOAL_MRKT_UNFIT_YN == "Y" Then
			szOVRS_CFD_GOAL_MRKT_AGR_YN = "N"
		ElseIf g_BDM_ACFD_GOAL_MRKT_UNFIT_YN == "N" Then
			szOVRS_CFD_GOAL_MRKT_AGR_YN = "Y"
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_SRNO"         , 0 , g_BDM_ACFD_REG_SRNO     		) '해외CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_AGR_YN"       , 0 , szOVRS_CFD_GOAL_MRKT_AGR_YN     ) '해외CFD목표시장일치여부
	Else
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_SRNO"         , 0 , 0     )  '해외CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "ACFD_GOAL_MRKT_AGR_YN"       , 0 , ""    ) 	'해외CFD목표시장일치여부
	End If
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_ACNT_APLT_YN1"          , 0 , g_BDM_DMST_CFD_ACNT_APLT_YN1		)  '국내CFD 계좌신청여부(일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "DMST_CFD_ACNT_APLT_YN2"          , 0 , g_BDM_DMST_CFD_ACNT_APLT_YN2		)  '국내CFD 계좌신청여부(안심)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN1"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN1		)  '해외CFD 계좌신청여부(미국/일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN2"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN2		)  '해외CFD 계좌신청여부(미국/안심)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN3"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN3		)  '해외CFD 계좌신청여부(중국/일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN4"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN4		)  '해외CFD 계좌신청여부(중국/일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN5"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN5		)  '해외CFD 계좌신청여부(홍콩/일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN6"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN6		)  '해외CFD 계좌신청여부(홍콩/일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN7"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN7		)  '해외CFD 계좌신청여부(일본/일반)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "OVRS_CFD_ACNT_APLT_YN8"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN8		)  '해외CFD 계좌신청여부(일본/일반)
	
	
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_SVNG_ACNT_APLT_YN"         , 0 , g_BDM_PRCD131			)  '연금저축신청여부
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_TCTR_CLS_CODE"                        , 0 , g_BDM_PNSN_TCTR_CLS_CODE		)			'연금이관구분코드(신규/이수전용)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_CNRC_PRD"             		        , 0 , g_BDM_PNSN_CNRC_PRD		)                 '연금계약기간
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_PRVS_BEGN_SCDL_DATE"                  , 0 , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE		)    	'연금지급개시예정일
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_CNRC_AMT"                             , 0 , g_BDM_PNSN_CNRC_AMT				)        '연금계약금액
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_PRVS_BANK_CODE"                       , 0 , g_BDM_PNSN_PRVS_BANK_CODE    		)    	'연금지급은행코드
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock4", "PNSN_PRVS_BANK_ACNO"                       , 0 , g_BDM_PNSN_PRVS_BANK_ACNO    		)    	'연금지급은행계좌번호
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "PROS_DATE"	, 0 , 	g_BDM_PROS_DATE	)
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "PROS_SRNO"	, 0 , 	g_BDM_PROS_SRNO	)
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FNNC_TR_OBJT_CNFR_DATE"	, 0 , 	g_BDM_MNY_PROS_DATE	)
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FNNC_TR_OBJT_CNFR_SRNO"	, 0 , 	g_BDM_MNY_PROS_SRNO	)
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "ACNO"	, 0 , 		""	)
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "ACNO_PWD"	, 0 , 	""	)
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "MNGR_EMPNO"	, 0 , 	g_BDM_MANG_EMPNO	)
	
'	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FACEID_ACMP_YN"	, 0 , g_BDM_FACE_YN)
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock4", "FACEID_ACMP_YN"	, 0 , "N")
End Function

