'============================================================================
'데이터 오류 수신
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szTranID == "obacp_opop_066r" Then
			
		ContMain.Edit0.enable  =false
		ContMain.Edit1.enable  =false
		ContMain.Edit2.enable  =false
	
		ContMain.Edit0.caption 	= ""
		ContMain.Edit1.caption 	= ""
		ContMain.Edit2.caption 	= ""

		ContMain.Edit0.SetResultLabel("0", "complete", "",  "ContMain")
		ContMain.Edit1.SetResultLabel("0", "complete", "",  "ContMain")
		ContMain.Edit2.SetResultLabel("0", "complete", "",  "ContMain")
		
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	
		If ContMain.Editpwd.caption == "" Then
			'Form.MsgBox( "알림", szErrMsg , "", 0 )
			PwErrorMsg  = szErrMsg
		Else
			'Form.MsgBox( "알림", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&" 또는 비대면실명확인 재설정 필요)" , "", 0 )
			PwErrorMsg  = szErrMsg&"★("&DATAMANAGER.GetDataMsgSubText(szTranID)&" 또는 비대면실명확인 재설정 필요)"
		End If 
		
		Form.OpenPopup("mbbdm85203" , PwErrorMsg , "5")
		
		ContMain.Editpwd.caption = ""
	
	ElseIf szTranID == "obaci_nmet_007r" Then
		ContMain.Editpwd.caption = ""
	
		Form.MsgBox("안내",szErrMsg,0,0)	
		
	ElseIf szTranID == "obaci_nmet_005a" Then
		
		if sSubmsg ="" then
			Form.OpenPopup("mbbdm85202", szErrMsg , "" )
		else
			'v0002 : 단기다수개설자 에러메세지 분리
			if szErrCode == "7111" or szErrCode == 7111 then
				Form.SetSharedData("BDM_NMET_SHORT_TERM_OPEN" , "Y")
				Form.OpenPopup("mbbdm85202", "단기다수개설 출금고제한 계좌는 계좌간 대체 등록이 불가능합니다." , "" )
			else
				Form.OpenPopup("mbbdm85202", szErrMsg&"("&sSubmsg&")" , "" )
			end if
		end if
		
	end if
		
End Sub
'============================================================================
Function get_STPL_YN()
	DATAMANAGER.SetDataValue(0, "obaci_nmet_009r", "InBlock1", "ACNO", 0, strAcno )
	DATAMANAGER.SetDataValue(0, "obaci_nmet_009r", "InBlock1", "CSNO", 0, strCsno )
	DATAMANAGER.RequestTranData("obaci_nmet_009r")
End Function

'============================================================================
Sub ContMain_EditPwd_OnEditComplete()
	
	if cint(ContMain.EditPwd.pwdlen) < 4 then
		ShowAlert("안내", "최소 4자리 이상 입력해야 합니다.")
		Exit Sub	
	end if
	
	ContMain.Edit0.enable  =false
	ContMain.Edit1.enable  =false
	ContMain.Edit2.enable  =false
		
	ContMain.Edit0.caption 	= ""
	ContMain.Edit1.caption 	= ""
	ContMain.Edit2.caption 	= ""
	
	DATAMANAGER.RequestTranData("obacp_opop_066r")
	
End Sub

'============================================================================
' 최종업무신청
'============================================================================
Sub btnOK_OnClick()
	
	If ContMain.EditPwd.caption ="" then
		ShowAlert("안내", "비밀번호를 입력하세요.")
		Exit Sub
	End If


	If pwSetYn <> 1 Then
		ShowAlert("안내", "계좌비밀번호 재설정 신청내역이 존재합니다. 영업점 승인 및 재설정 완료 후 신청가능합니다.")
		Exit Sub
	End If

	If g_Chk7_007r == 0 Then
		ShowAlert("안내","이미 신청된 업무가 존재합니다.")
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
		Exit Sub
	End If

	If strTRGT_YN == "N" Then
		'g_Cchk6 = sCheckState
	
	ElseIf strTRGT_YN == "Y" Then
		ShowAlert("알림", "제휴은행에서 개설하신 계좌는 메리츠 종합계좌간 대체 등록이 불가능합니다.")
		Exit Sub
	End If

	DATAMANAGER.RequestTranData("obaci_nmet_005a")

End Sub


'===========================================================================
'asis
'Form.triggerEvent( "LinkForm7", "LinkForm7_15007", ContMain.Cont7.Chk7.checkstate ) mbact15007_s4 호출
' mbaci15007_s4의 Form_OnFormInit / Form_OnTriggerEvent 소스병합후 수행(forminit이 선행)
'============================================================================
Function altn_acno_Init()
	'strSTPL_YN7 '위에서세팅
	'strRsno     '위에서세팅
	strAcno = replace(ContMain.Combo0.caption, "-" , "")
	
	g_TR_Count_127r = 0
	
	set_Trigger("9")
	chk_ACNO_STPL()
	
	If strSTPL_YN7 == "Y" Then
		ContMain.Edit0.caption	 = strAcno
		ContMain.Edit1.caption = ""
		ContMain.Edit2.caption = ""
		
		set_Trigger("init")
		
	Else
		ContMain.Edit0.caption = ""
		ContMain.Edit1.caption = ""
		ContMain.Edit2.caption = ""

	End If
	
	enable_All()
End Function


'============================================================================
'대체팝업(mbaci15007_s4)에서 setSharedDate하던것을 
'업무신청(mbaci15007)에서 Form_OnTriggerEvent하던부분에 맞춰서 직접 setting으로 바꾼다.
'============================================================================
Function set_Trigger(EditNum)
	If EditNum == "init" Then
		g_meritz1 = Trim(strAcno)
	ElseIf EditNum == "0" Then
		g_meritz1 = strAcno_006r
		'ContMain.Edit1.SetShowKeypad(true)
	ElseIf EditNum == "1" Then
		g_meritz2 = strAcno_006r
		
		'ContMain.scroll_pos = 200
		'ContMain.Edit2.SetShowKeypad(true)
	ElseIf EditNum == "2" Then
		g_meritz3 = strAcno_006r
		
	ElseIf EditNum == "3" Then
		g_meritz1 = ""
	ElseIf EditNum == "4" Then
		g_meritz2 = ""
	ElseIf EditNum == "5" Then
		g_meritz3 = ""
	
	ElseIf EditNum == "9" Then
		g_meritz1= ""
		g_meritz2= ""
		g_meritz3= ""
	End If
	
	btnOK_Change()
End Function

'============================================================================
Function btnOK_Change()
	'If g_Chk1_007r == 1 and ContMain.ChkButton0.checkstate == "1" and ContMain.ChkButton1.checkstate == "1" Then
	
	If g_Chk7_007r == 1  Then '신청중 내역이 없는 경우
'		If pw_okcheck ==1 Then
			if g_meritz1 == "" and  g_meritz2 == "" and g_meritz3 == "" then
				btnOK.enable 		= false
				if szTheme = "black" then
					btnOK.btnimage	= "btn_27.9"
				else
					btnOK.btnimage	= "btn_21.9"
				end if
				btnOK.fgcolor		= "269"
			else
				btnOK.enable 		= true
				btnOK.btnimage	= "btn_20.9"
				btnOK.fgcolor		= "273"
			end if
'		end if
	else
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	end if

End Function


'============================================================================
Function chk_ACNO_STPL()
	DATAMANAGER.SetDataValue(0, "obpds_srvc_127r", "InBlock1", "ACNO" , 0 , strAcno)	'입력한 계좌번호
	DATAMANAGER.RequestTranData "obpds_srvc_127r"
End Function

'============================================================================
Sub ContMain_Edit0_OnEditComplete()
	
	strEdtNM		= "0"
	
	If Trim(ContMain.Edit0.caption) =="" then
		g_meritz1 = ""
		Exit Sub
	end if
	
	For i = 0 To  g_TR_Count_127r
		If Trim(ContMain.Edit0.caption) == DATAMANAGER.GetDataValue( 0 , "obpds_srvc_127r", "OutBlock1", "ACNO" , i) and ContMain.Edit0.caption <> "" Then
			'ShowAlert("안내","이미 등록된 계좌번호입니다. ("&ContMain.Edit0.caption&")")

			ContMain.Edit0.SetResultLabel("1", "error", "이미 등록된 계좌번호입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			
			ContMain.Edit0.caption = ""
			Exit Sub
		End If
	Next
	
	If ContMain.Edit0.caption <> "" Then
		If ContMain.Edit0.caption == ContMain.Edit1.caption or
		   ContMain.Edit0.caption == ContMain.Edit2.caption Then
			'ShowAlert("안내","이미 입력된 계좌번호입니다. ("&ContMain.Edit0.caption&")")
			
			ContMain.Edit0.SetResultLabel("1", "error", "이미 입력된 계좌번호입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit0.caption = ""
			Exit Sub

		ElseIf len(Trim(ContMain.Edit0.caption)) <> 8  then
			'ShowAlert("안내","계좌번호를 확인하세요. ("&ContMain.&Edit0.caption&")")
				
			ContMain.Edit0.SetResultLabel("1", "error", "계좌번호를 확인하세요.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit0.caption = ""
			Exit Sub
		Else

			Acct_TR_006r(Trim(ContMain.Edit0.caption))
		End If
	End If
	
End Sub
'============================================================================
Sub ContMain_Edit1_OnEditComplete()
	
	strEdtNM		= "1"
	
	If Trim(ContMain.Edit1.caption) =="" then
		g_meritz2 = ""
		Exit Sub
	end if	
	
	For i = 0 To  g_TR_Count_127r
		If Trim(ContMain.Edit1.caption) == DATAMANAGER.GetDataValue( 0 , "obpds_srvc_127r", "OutBlock1", "ACNO" , i) and ContMain.Edit1.caption <> "" Then
			'ShowAlert("안내","이미 등록된 계좌번호입니다. ("&ContMain.Edit1.caption&")")
			
			ContMain.Edit1.SetResultLabel("1", "error", "이미 등록된 계좌번호입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			
			ContMain.Edit1.caption = ""
			
			Exit Sub
		End If
	Next
	
	If ContMain.Edit1.caption <> "" Then
		If ContMain.Edit1.caption == ContMain.Edit0.caption or
		   ContMain.Edit1.caption == ContMain.Edit2.caption Then
			'ShowAlert("안내","이미 입력된 계좌번호입니다. ("&ContMain.Edit1.caption&")")
			
			ContMain.Edit1.SetResultLabel("1", "error", "이미 입력된 계좌번호입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit1.caption = ""
		
			Exit Sub

		ElseIf len(Trim(ContMain.Edit1.caption)) <> 8  then
			'ShowAlert("안내","계좌번호를 확인하세요. ("&ContMain.Edit1.caption&")")
			
			ContMain.Edit1.SetResultLabel("1", "error", "계좌번호를 확인하세요.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit1.caption = ""
		
			Exit Sub
		Else
			
			Acct_TR_006r(Trim(ContMain.Edit1.caption))
			
		End If
	End If
	
	
End Sub

'============================================================================
Sub ContMain_Edit2_OnEditComplete()
	ContMain.scroll_pos = 30
	strEdtNM		= "2"
	
	If Trim(ContMain.Edit2.caption) =="" then
		g_meritz3 = ""
		Exit Sub
	end if	
	
	For i = 0 To  g_TR_Count_127r
		If Trim(ContMain.Edit2.caption) == DATAMANAGER.GetDataValue( 0 , "obpds_srvc_127r", "OutBlock1", "ACNO" , i) and ContMain.Edit2.caption <> "" Then
			'ShowAlert("안내","이미 등록된 계좌번호입니다. ("&ContMain.Edit2.caption&")")
			
			ContMain.Edit2.SetResultLabel("1", "error", "이미 등록된 계좌번호입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit2.caption = ""
			Exit Sub
		End If
	Next
	
	If ContMain.Edit2.caption <> "" Then
		If ContMain.Edit2.caption == ContMain.Edit0.caption or
		   ContMain.Edit2.caption == ContMain.Edit1.caption Then
		   
			'ShowAlert("안내","이미 입력된 계좌번호입니다. ("&ContMain.Edit2.caption&")")
			
			ContMain.Edit2.SetResultLabel("1", "error", "이미 입력된 계좌번호입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit2.caption = ""
			Exit Sub

		ElseIf len(Trim(ContMain.Edit2.caption)) <> 8  then
			'ShowAlert("안내","계좌번호를 확인하세요. ("&ContMain.Edit2.caption&")")
			
			ContMain.Edit2.SetResultLabel("1", "error", "계좌번호를 확인하세요.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.Edit2.caption = ""
			Exit Sub
		Else
			Acct_TR_006r(Trim(ContMain.Edit2.caption))
		End If
	End If
	ContMain.SetScrollAutoSize()
End Sub

'============================================================================
Function Acct_TR_006r(tmpAcct)
	strAcno_006r = tmpAcct
	
	DATAMANAGER.SetDataValue(0, "obaci_nmet_006r_1", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
	DATAMANAGER.SetDataValue(0, "obaci_nmet_006r_1", "InBlock1", "ACNO" , 0 , tmpAcct)	'입력한 계좌번호
	DATAMANAGER.RequestTranData "obaci_nmet_006r_1"
	
End Function

'============================================================================
Function enable_All()

	If strSTPL_YN7 == "Y" Then
		ContMain.Edit0.enable = false
		ContMain.Edit1.enable = true
		ContMain.Edit2.enable = true
		

	Else
		ContMain.Edit0.enable = true
		ContMain.Edit1.enable = true
		ContMain.Edit2.enable = true
		
		
	End If
End Function 

'================================
'안내사항
'================================
Sub ContMain_Container1_Label11_OnClick()
	ContMain.Edit0.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.Edit1.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.Edit2.SetResultLabel("0", "complete", "",  "ContMain")
	
	if bWide == false then
		bWide = true
		
		ContMain.InfoPos.top = 640
		ContMain.SetScrollAutoSize()
		ContMain.Container1.Image3.imgpath = "icon_caret_up.png"
		
		ContMain.Container1.SetHeightResize(210)
		ContMain.scroll_pos =  170
	else
		
		bWide = false
		ContMain.Container1.SetHeightResize(40)
		ContMain.InfoPos.top = 0
		'ContMain.scroll_pos = Form.calcUnResize(ContMain.Combo0.top,"1") -10
		ContMain.scroll_pos = 30
		ContMain.Container1.Image3.imgpath = "icon_caret_down.png"
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		'ContMain.SetScrollAutoSize()
		
	end if
end Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" or trim(sTimerID) == 9999 then
		Form.SetTimerEvent("9999", 0, 5)
		ContMain.SetScrollAutoSize()
	end if
End Sub

