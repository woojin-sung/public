'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	Container2_Image2_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbdm85200_p9_end" or  sKeyName == "mbbdm85201_end" or  sKeyName == "mbbdm85202_end" then 
		if sRet =="ok" then
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			if g_BDM_FRST_MAPID ="screen41000" then
				Form.OpenScreen( "41000" , "")
				Form.CloseForm()	
			else
				Form.OpenNextPopup(g_BDM_FRST_MAPID, "", "")
			end if
		end if
	elseif sKeyName == "mbbdm85240_start" then
		if sRet =="ok" then
			'--------------------------------------------------------------
			
			s_hp1  = Trim(Form.GetSharedData("BDM_HP1"        , false))
			s_hp2  = Trim(Form.GetSharedData("BDM_HP2"        , false))
			s_hp3  = Trim(Form.GetSharedData("BDM_HP3"        , false))
			s_brun = Trim(Form.GetSharedData("BDM_REG_UNIQ_NO", false))
			s_brp  = Trim(Form.GetSharedData("BDM_RCNO_PIP"   , false))
			s_bis  = Trim(Form.GetSharedData("BDM_IDNTF_SRNO" , false))
			
			Form.SetSharedData("BDM_HP1"                 , s_hp1  )
			Form.SetSharedData("BDM_HP2"                 , s_hp2  )
			Form.SetSharedData("BDM_HP3"                 , s_hp3  )
			Form.SetSharedData("BDM_REG_UNIQ_NO"         , s_brun )
			Form.SetSharedData("BDM_RCNO_PIP"            , s_brp  )
			Form.SetSharedData("BDM_IDNTF_SRNO"          , s_bis  )
			'--------------------------------------------------------------
			Form.OpenNextPopup("mbbdm85240", "", "")
		end if	
	End If
End Sub	


'============================================================================
Sub ContMain_Combo0_OnEditComplete(iIndex)

	ContMain.EditPwd.caption 	= ""
	ContMain.Editpwd.enable	=true
	ContMain.Edit0.enable  	=false
	ContMain.Edit1.enable  	=false
	ContMain.Edit2.enable  	=false
		
	ContMain.Edit0.caption 	= ""
	ContMain.Edit1.caption 	= ""
	ContMain.Edit2.caption 	= ""
	
	btnOK.enable 		= false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		= "269"
	
	ContMain.Edit0.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.Edit1.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.Edit2.SetResultLabel("0", "complete", "",  "ContMain")

	strAcno = replace(ContMain.Combo0.caption, "-" , "")
	
	DATAMANAGER.RequestTranData("obaci_nmet_006r")
End Sub
'============================================================================
Function Combo_AccMask(szAcc)
           Combo_AccMask = Left(szAcc, 4)&"-"&Mid(szAcc, 5, 4)
End Function


