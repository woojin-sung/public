	<SCRIPT_INFO _len="5615" _ulen="4955" >

Dim g_tData
Dim g_szCode
Dim g_bOpenAble

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		'20230828 아이디 연결여부 추가
		g_szLinkedYN = Form.GetSharedData("71052_ID_LNKN_YN", false)
		
		g_bOpenAble = false
		
'		Form.ShowAlert("", szOpenData)
		'선물옵션 구분, 종목명, 매수/매도, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 미결제잔고, 매입단가, 종목코드
		g_tData = Split(szOpenData, "☆")
		
'		If g_tData[0] == "F" Then
'			tbl2.SetCellString(1, 0, "미결제잔고")
'		Else
'			tbl2.SetCellString(1, 0, "잔고")
'		End If
		
		lblName.caption = g_tData[2] & " " & g_tData[1]
		If Trim(g_tData[2]) == "매수" Then
			lblName.changeTextAttr(0, 2, 6, 4, false)
		ElseIf Trim(g_tData[2]) == "매도" Then
			lblName.changeTextAttr(0, 2, 7, 4, false)
		End If
		
		tbl0.SetCellString(0, 2, g_tData[3])
		
		tbl1.SetCellString(0, 1, g_tData[4])
'		tbl1.SetCellString(1, 1, g_tData[5])
'		tbl1.SetCellString(2, 1, g_tData[6])
		
		tbl1.SetCellString(1, 1, g_tData[5])
		If Left(g_tData[5], 1) == "+" Then
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(g_tData[5], 1) == "-" Then
			tbl1.SetCellFgColor(1, 1, "2")
		End If
		
		tbl1.SetCellString(2, 1, g_tData[6])
		If Left(g_tData[6], 1) == "+" Then
			tbl1.SetCellFgColor(2, 1, "1")
		ElseIf Left(g_tData[6], 1) == "-" Then
			tbl1.SetCellFgColor(2, 1, "2")
		End If
		
		'선물 종목 수익률이 0으로 떨어지는 경우가 있어 추가(테스트에서는 전부 0으로 떨어짐)
		If g_tData[0] == "F" And CDbl(g_tData[6]) == 0 Then
			tbl1.SetCellString(2, 1, FormatNumber(g_tData[6], 2))
		End If
		
		tbl2.SetCellString(0, 1, g_tData[7])
		tbl2.SetCellString(1, 1, g_tData[8])
		tbl2.SetCellString(2, 1, g_tData[9])
		
		'20230925 현재가 추가
		tbl2.SetCellString(3, 1, g_tData[11])
		
		g_szCode = g_tData[10]
		
		'종목코드 체크
		If Left(Trim(g_szCode), 1) == "K" Then
			g_szCode	= Right(Trim(g_szCode), Len(Trim(g_szCode)) - 1)
		End If
		
		Dim szMarket 
		szMarket = Form.GetItemCodeInfo(g_szCode, "market")
		
		'======================================================
		'20230118 LES START
		'======================================================
		if szMarket == "FF" then
		
			szOsType = Form.GetSharedData("&OS_TYPE", false)
		
			if szOsType == "1" then
				szKRXYN = Form.GetSharedData("&KRX_RENEWAL", false)
			elseif szOsType == "2" then
				szKRXYN = Form.GetSharedData("&KRX_APPLY", false)
			end if
	
			'szKRXYN == 1 : KRX차세대 이후 마스터파일 로드
			if szKRXYN <> "1" then
				szMarket = "CF"
			end if
		
		end if
		'======================================================
		'20230118 LES END
		'======================================================
		
		'현재가 또는 주문화면으로 이동가능한 종목인지 체크
		'지수선물/미니선물/옵션/미니옵션/위클리옵션 만 가능
		'2018.04.06 KRX300선물, KSQ150옵션 추가 XF(KRX300) QO(KSQ150) 
		'2019.09.20 위클리옵션 추가 WO
		'2022.10.24 상품선물 추가 CF
		'2023.01.19 상품선물분리에 따른 추가 FF
		'2024.04.12 : 코스닥글로벌지수 추가 KF
		If Trim(szMarket) = "F"  or Trim(szMarket) = "O" or Trim(szMarket) = "MF" or Trim(szMarket) = "MO" or Trim(szMarket) = "JF" or Trim(szMarket) = "JO" or Trim(szMarket) = "XF" or Trim(szMarket) = "QO" or Trim(szMarket) = "WO" or Trim(szMarket) = "CF"  or Trim(szMarket) = "FF" or Trim(szMarket) = "KF" Then
			g_bOpenAble = true
			btnOK.left = 1000
		else
			btnOK.left = 0
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub btnPrice_OnClick()
	If g_bOpenAble Then
		Form.OpenScreen("31000" , g_szCode)
	End If
End Sub

'============================================================================
Sub btnBuy_OnClick()
	'- 잔고	
	' 전달내용/탭위치/종목코드/수량
	' szData = "잔고" & "★" & szTab & "★" & szCd & "★" & szQty
	If g_bOpenAble Then
		'20230828 아이디 연결여부 추가
		if g_szLinkedYN == "N" then
			Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
			exit sub
		end if
		
		Dim szSendData
		szSendData = "기타" & "★" & "0" & "★" & g_szCode & "★" & g_tData[8]
		
		Form.OpenScreen("31030" , szSendData)
	End If
End Sub

'============================================================================
Sub btnSell_OnClick()
	If g_bOpenAble Then
		'20230828 아이디 연결여부 추가
		if g_szLinkedYN == "N" then
			Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
			exit sub
		end if
		
		Dim szSendData
		szSendData = "기타" & "★" & "1" & "★" & g_szCode & "★" & g_tData[8]
		
		Form.OpenScreen("31030" , szSendData)
	End If
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
