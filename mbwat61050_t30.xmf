'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 랩 계약평가현황_주식보유현황
' 02. 화면설명 : 
' 03. 작    성 : 2016.05.19 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sAcnt, g_sAcntCnrc

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If g_sAcnt = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If g_sAcntCnrc = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Function RequestData()
	'Clear Data
	grd0.rowcount = 0		
	
	For i= 0 to 2
		tbl0.SetCellString( 1, i, "")
	Next 
	
	If Account_Check() == True then
		DATAMANAGER.RequestTranData( "obwat_mgmt_256r" )	
	End If
End Function

'============================================================================
'합계 계산
Sub CalSum()
	Dim i, nAmt, nTotalAmt
	
	'평가금액
	nTotalAmt = 0
	For i = 0 to grd0.rowcount-1
		nAmt = CDbl(grd0.GetCellData( "bd_cell5" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	'grd0.SetCellData( "bd_cell5", grd0.rowcount-1, nTotalAmt )
	tbl0.SetCellString( 1, 0, nTotalAmt)
	
	'손익금액
	nTotalAmt = 0
	For i = 0 to grd0.rowcount-1
		nAmt = CDbl(grd0.GetCellData( "bd_cell6" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	'grd0.SetCellData( "bd_cell6", grd0.rowcount-1, nTotalAmt )
	tbl0.SetCellString( 1, 1, nTotalAmt)
	
	'비중
	nTotalAmt = 0
	For i = 0 to grd0.rowcount-1
		nAmt = CDbl(grd0.GetCellData( "bd_cell8" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	'grd0.SetCellData( "bd_cell8", grd0.rowcount-1, nTotalAmt )
	tbl0.SetCellString( 1, 2, nTotalAmt)
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "Request" Then
		if sParam <> null and sParam <> "" then
			Dim tData
			tData = Split(sParam, "|")
			
			g_sAcnt = tData(0)
			g_sAcntCnrc = tData(1)
		end if
		
		RequestData()
	End If
End Sub

'============================================================================
Sub chk0_OnChange(sCheckState)
	RequestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" 	, 0 , g_sAcnt )
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , g_sAcntCnrc )	
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , chk0.checkstate )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obwat_mgmt_256r" Then
		Call CalSum()		'합계 계산
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

