' 02. 화면설명 : 보유주식 수익 서비스 커버페이지
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_SrvSrno
'dim gStplStatClsCode
dim gInfrMthdClcd
dim gSpfIssuHldnYn
dim gStplYn

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'문구 색깔 변경..
'============================================================================
Function f_SetLabelColor()

	Dim nStaOffset, nLen
	
	'1 Line
	Container0.lbl1Line1.caption = "·주식을 자유롭게 매매하면서"

	nStaOffset = Container0.lbl1Line1.getLen("·주식을 ")
	nLen       = Container0.lbl1Line1.getLen("자유롭게 매매")
	
	'Container0.lbl1Line1.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	Container0.lbl1Line1.changeTextAttr(nStaOffset, nLen, 4, -1, false)	
	
	'3 Line
	'Container0.lbl3Line1.caption = "·대여거래 발생시 대여수수료가 지급 되요"
	
	'nStaOffset = Container0.lbl3Line1.getLen("·대여거래 발생시 ")
	'nLen       = Container0.lbl3Line1.getLen("대여수수료가 지급 되요")
	
	'Container0.lbl3Line1.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	'Container0.lbl3Line1.changeTextAttr(nStaOffset, nLen, 289, -1, false)		
	
	'4 Line
	Container0.lbl4Line1.caption = "·재활용 주식은 언제든지 매도가 가능하며"
	
	nStaOffset = Container0.lbl4Line1.getLen("·재활용 주식은 ")
	nLen       = Container0.lbl4Line1.getLen("언제든지 매도가")	
	
	'Container0.lbl4Line1.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	Container0.lbl4Line1.changeTextAttr(nStaOffset, nLen, 4, -1, false)	
	
	'5 Line
	Container0.lbl4Line4.caption = "언제든지 반환요청도 가능합니다."
	
	nStaOffset = Container0.lbl4Line4.getLen("언제든지 반환요청도 ")
	nLen       = Container0.lbl4Line4.getLen("가능합니다.")	
	
	Container0.lbl4Line4.changeTextAttr(nStaOffset, nLen, 4, -1, false)	
	
	'수수료지급기준
	Container0.Label23.caption = "· 국내주식(코스피,코스닥)에 한해 최대 10억까지(자산기준)\n   보유주식 수수료가 매일(영업일 기준) 지급 됩니다.\n\n· 수수료 지급률은 보유 자산별, 종목별로 상이하며\n   상세내용은 약관 및 설명서를 확인해주세요."

	nStaOffset = Container0.Label23.getLen("· 국내주식(코스피,코스닥)에 한해 최대 10억까지(자산기준)\n   보유주식 수수료가 매일")
	nLen       = Container0.Label23.getLen("(영업일 기준)")	
	
	Container0.Label23.changeTextAttr(nStaOffset, nLen, 146, -5, false)	

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
