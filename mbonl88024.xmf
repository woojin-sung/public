Sub Form_OnFormInitBefore()
	'이미지컨트롤 별 설정
	Container0.Image0.setMaintainingRatio("1")	
	imgTitle.setMaintainingRatio("1")	
	Container0.Image5.setMaintainingRatio("1")	
	Container0.ImageInfo0.setMaintainingRatio("1")	
	
	Container0.ImgLCircle.setMaintainingRatio("1")
	Container0.ImgRCircle.setMaintainingRatio("1")
	
	Container0.ImgLBox.setMaintainingRatio("1")
	Container0.ImgRBox.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 팝업창에서 계좌비번 수신 ************
	'==============================================
	'msgbox "sKeyName="&sKeyName&" sRet="&sRet
	
	'===============================================
	'********** 해지 팝업 리턴  ***********
	'===============================================		
	If sKeyName == "mbonl88024_p1" Then	
		'계좌 체크
		if Account0.caption <> "" and Account0.caption <> null then 
			DATAMANAGER.RequestTranData("obpds_srvc_169r") '약정여부 조회
		end if	

	elseif sKeyName == "mbonl88024_p4" then	'변경해지처리 선택
		if sRet == "2" then	'변경처리
			'Form.OpenNextPopup("mbonl88024_p1", "", "")	'약정변경용			
			Form.OpenPopup("mbonl88024_p1", "", "")	'약정변경용			
		elseif sRet == "3" then	'해지처리
			'Dim sSendData
			'sSendData = Account0.total&Account0.sequence&"★"&g_SrvSrno		
			'Form.openPopupAnimation("mbonl88024_p13",sSendData,"","2")
			Form.MsgBox("안내", "보유주식 수익 서비스를 해지하시겠습니까?", "Cancel_OK", "1") '1:확인/취소			
		end if
	elseif sKeyName = "CORRECT_PWD" then	'비밀번호 팝업(해지처리)
		if sRet <> "" then
			Dim tData
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				edtPassword_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
		else
			'비밀번호 미입력..?
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			if g_szSavePwd == "0" then
				edtPassword.caption = ""
			end if
		end if	
	end if	
End Sub

'============================================================================
Sub edtPassword_OnEditComplete()
	'해지TR호출..
	DATAMANAGER.RequestTranData( "obpds_srvc_168a" )  '약정해지처리 호출
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'고객번호
	dim szCust_Num, szPwd
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = edtPassword.caption
	Else
		 szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If

	if szTranID == "obpds_srvc_169r" then 
		if Account0.caption <> "" and Account0.caption <> null then 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , Account0.total)	
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , Account0.sequence)	
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "029")		
	elseif szTranID == "obpds_srvc_168a" then 		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "D")	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 				, 0 , szCust_Num)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0 	, "029")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO" 			, 0 	, g_SrvSrno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , Account0.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , Account0.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE"		, 0 , "4")	
	end if
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obpds_srvc_169r" then		
		g_SrvSrno 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO" , 0)
		'gStplStatClsCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STPL_STAT_CLS_CODE" , 0)
		gInfrMthdClcd		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INFR_MTHD_CLCD" , 0)
		gSpfIssuHldnYn	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SPF_ISSU_HLDN_YN" , 0)
		
		'약정등록상태인 경우..
		'if gStplStatClsCode = "01" then
		if cInt(g_SrvSrno) > 0 then
		
			gStplYn = "Y"
			btnReg.caption = "신청정보보기"
					
		else
			gStplYn = "N"
			btnReg.caption = "신청하기"
		
		end if
	elseif szTranID == "obpds_srvc_168a" then		
		
		'Form.ShowAlert( "안내" , "보유주식 수익 서비스가 해지되었습니다.")
		Form.MsgBox("안내", "보유주식 수익 서비스가 해지되었습니다.", "Cancel_END", 0)
		
	end if
End Sub	

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "Cancel_END" then	'해지가 완료되었습니다.	
		DATAMANAGER.RequestTranData("obpds_srvc_169r") '약정여부 조회		
	elseif sKeyName = "Cancel_OK" then '해지처리 수행
		if sRet == "ok" then		
			dim sSendData
			sSendData = Account0.total&Account0.sequence&"☆"&"0"	'저장 버튼 숨기려면 0, 보이려면 1
			
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")		
		end if
	elseif sKeyName = "NoSuper365Acnt" then '슈퍼365계좌 미보유자
		if sRet == "ok" then
			'개설하러가기 클릭
			dim sloginType
			sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
			
			if Cint(sloginType) > 1 then
				sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
				Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
			else
				Form.SetSharedData("&SCREEN_AUTH" , "99")
				Form.OpenPopup("mbbdm85100", "", "")
			end if			
			
		end if
	elseif sKeyName == "LOGOUT_MSG" then	'로그아웃 후
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", "", "")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "안내" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Container0.Label24.caption = "내 수익금 확인하기 >"
	Container0.Label25.caption = "재활용 거래 알아보기 >"
	
	f_SetLabelColor()
	
	gStplYn = "N"
	
	'계좌 체크
	if Account0.caption <> "" and Account0.caption <> null then 
		DATAMANAGER.RequestTranData("obpds_srvc_169r") '약정여부 조회
	else
		gStplYn = "N"
		btnReg.caption = "신청하기"
		
		DATAMANAGER.RequestTranData("obpds_srvc_169r") '약정가능여부 조회
	end if
End Sub

'============================================================================
Sub btnReg_OnClick()
	
	'계좌 체크
	if Account0.caption <> "" and Account0.caption <> null then 
		'DATAMANAGER.RequestTranData("obpds_srvc_169r") '약정여부 조회
		
		'약정등록상태인 경우..
		if gStplYn == "Y" then		
			'다음 화면 띄움
			dim sSendData
			sSendData = Account0.total & Account0.sequence & "★" & gInfrMthdClcd & "★" & g_SrvSrno & "★" & gSpfIssuHldnYn

			Form.openPopupAnimation("mbonl88024_p4", sSendData, "", "2")			
		else
			'다음 화면 띄움
			Form.OpenPopup("mbonl88024_p1", "", "")	'약정등록용
		end if		
	
	else
		'하단 팝업 띄움. 다드림계좌 미보유 계좌 팝업.
		Form.MsgBox("알림", "보유주식 수익 서비스는\n슈퍼365계좌에서만 신청가능합니다.", "NoSuper365Acnt", "7", "개설하러 가기", "나중에 신청하기")
	end if
	
End Sub

