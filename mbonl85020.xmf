'--===========================================================================
' 01. 화 면 명 : ID 해지
' 02. 화면설명 : ID 해지
' 03. 작    성 : 2022.05.04 KSJ
' 04. 수    정 : 
' 2023.12.21 : 전상일 : v001 : ID 등록 시 주문내역 존재 체크 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nTrCnt	'불원등록여부체크TR
Dim g_UserID
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()	
	g_nTrCnt	= 0
	g_UserID	= Form.GetSharedData("&USER_ID", false )
	
	If g_UserID <> "" and g_UserID <> null Then
		LblID.caption = g_UserID
	End If
	
	DATAMANAGER.RequestTranData( "obpds_srvc_313r" ) '등록계좌 조회
	DATAMANAGER.RequestTranData("obcsb_efif_000r")
End Sub

'============================================================================
' Form_OnPopupReturn()
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==[인증팝업]==
	'공동인증및바이오인증
	If sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" Then
			DATAMANAGER.RequestTranData( "obcsb_efif_064u" ) 
		End If
	'간편인증전용
	ElseIf sKeyName == "mhetc90060_px" Then 
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData( "obcsb_efif_064u" ) 
		End If
	
	'==[HTS불원등록여부체크팝업]==
	ElseIf sKeyName == "mbonl85020_p0" Then
		If sRet == "Y" Then
			Form.OpenScreen( "87020" , "" )
		End If
	
	'==[해지확인팝업]==
	ElseIf sKeyName == "mbonl85020_p3" Then
		If sRet == "Y" Then
			'인증완료후 해지 서비스 호출
			Dim szCertUseType 
			'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
			szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
			
			If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
			    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
			Else
			    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
			End If
		End If
	
	'==[해지완료팝업]==
	ElseIf sKeyName == "mbonl85020_p1" Then
		'1parm (0.문구없음 1.문구있음)
		'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
		Form.LogOut(0,1)
		Form.OpenScreen( "41000", "" )
	End If
End Sub

'============================================================================
' btnChkAcct_OnClick() : 연결된 계좌보기
'============================================================================
Sub btnChkAcct_OnClick()
	cmbAcct.openList()
End Sub
'============================================================================
Sub cmbAcct_OnEditComplete(iIndex)
	cmbAcct.initkeyindex = "-1"
End Sub

'============================================================================
' btnNext_OnClick() : 해지
'============================================================================
Sub btnNext_OnClick()
	If g_UserID == "" Then
		Form.ShowAlert( "알림", "해지할 ID를 확인해주세요." )
	End If 
	'20220520 추가
	DATAMANAGER.RequestTranData( "obcsb_efif_262r" ) '법인여부 체크	
	
End Sub

'============================================================================
' imgBack_OnClick() : 닫기
'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum '고객번호
	szCustNum = Form.GetSharedData("&CUST_NUM", false )

	'연결된 계좌 조회
	If szTranID == "obpds_srvc_313r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 		, 0 , szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 	, 0 , g_UserID  )	'고객ID
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" 		, 0 , "016"     ) '서비스코드
		
	'20220520 법인여부 체크
	ElseIf szTranID == "obcsb_efif_262r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 	, 0 , g_UserID  	) '고객ID(해지ID)
		
	'HTS 불원등록 여부
	ElseIf szTranID == "obpds_srvc_323r" Then
		Dim szRegAcno
		szRegAcno = grdRegAcno.GetCellData("bd_RegAcno", g_nTrCnt)
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "CSNO" 		, 0 , szCustNum	) '고객번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" 		, 0 , "048"		) '서비스코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0 , szRegAcno	) '계좌번호
		
	'복수계좌(주문대리인)등록 여부
	ElseIf szTranID == "obpds_srvc_162r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE", 0 , "4"		) '온라인		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PXPR_ELFN_ID" , 0 , g_UserID	) '고객ID
		
	'ID 해지
	ElseIf szTranID == "obcsb_efif_064u" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 	, 0 , g_UserID  	) '고객ID(해지ID)
		
	ElseIf szTranID = "obcsb_efif_000r" then
		Dim RCNO_PIP
		RCNO_PIP	= Form.GetSharedData("&JUMIN_NUM", false)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE",	0, "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP",		0, RCNO_PIP)
	End If
	
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'등록계좌 조회
	If szTranID == "obpds_srvc_313r" Then
		Dim nCnt
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1"))
		LblChkAcct.caption = LblChkAcct.caption .."("..nCnt..")  >"
		
		If nCnt > 0 Then
			For i = 0 to nCnt - 1
				Dim szAcno
				szAcno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "REG_ACNO", i)
				If Len(Trim(szAcno)) == 8 Then
					cmbAcct.cbadddatatext = szAcno.."`"..Left(szAcno,4).."-"..Right(szAcno, 4)
				End If
			Next
			cmbAcct.initkeyindex = "-1"
		End If	
	
	'20220520 법인여부 체크
	ElseIf szTranID == "obcsb_efif_262r" Then
		DIm szCustClsCode 
		szCustClsCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_CLS_CODE", i)
		If szCustClsCode <> "1" Then 
			Form.OpenPopup( "mbonl85020_p4", "", "" ) '법인여부안내팝업
		Else
			If tonumber(grdRegAcno.rowcount) > 0 Then
				g_nTrCnt = 0	
				DATAMANAGER.RequestTranData( "obpds_srvc_323r" ) 'HTS 불원등록 여부체크	
			Else
				DATAMANAGER.RequestTranData( "obpds_srvc_162r" ) 'HTS 복수계좌등록 여부체크
			End If
		End If
	
	ElseIf szTranID == "obpds_srvc_323r" Then
		g_nTrCnt = g_nTrCnt + 1
		
		If DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APRV_YN" , 0) == "N" Then
			Form.OpenPopup( "mbonl85020_p0", "", "" ) 'HTS 불원등록안내팝업
		Else
			If g_nTrCnt == tonumber(grdRegAcno.rowcount) Then
				DATAMANAGER.RequestTranData( "obpds_srvc_162r" ) 'HTS 복수계좌등록 여부체크
			Else
				DATAMANAGER.RequestTranData( "obpds_srvc_323r" ) 'HTS 불원등록 여부체크
			End If
		End If	
		
	ElseIf szTranID == "obpds_srvc_162r" Then
		Dim szPxprYn, szHtsID
		szPxprYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PXPR_YN"  	, 0) '대리인여부
			
		If szPxprYn == "N" Then
			Form.OpenPopup( "mbonl85020_p3", szRmvID, "")	'ID해지확인팝업
		Else
			Form.OpenPopup( "mbonl85020_p2", szRmvID, "")	'HTS 복수계좌등록알림팝업
		End If
		
	ElseIf szTranID == "obcsb_efif_064u" Then
		Dim szRmvID
		szRmvID = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ELFN_ID" , 0)	'해지된자금융아이디
		
		If szID <> "" and szRmvID == g_UserID Then
			Form.OpenPopup( "mbonl85020_p1", szRmvID, "")	'해지완료팝업
		Else
			Form.ShowAlert( "알림", "ID 해지 오류")
		End If
		
	ElseIf szTranID == "obcsb_efif_000r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		
		if nCnt > 0 then
			
			for i = 0 to nCnt - 1
				Dim USER_ID, ELFN_ID
				USER_ID = Form.GetSharedData("&USER_ID", false)
				ELFN_ID = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ELFN_ID", 	i)
				
				if USER_ID == ELFN_ID then
				
					if "Y" == DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ATMT_ISNC_YN", i) then
						Label2.visible = true
					else
						Label2.visible = false
					end if
					
				end if

			next

		end if
		
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'v010 : ID 등록 시 주문내역 존재 체크 
	if szTranID == "obcsb_efif_064u" and (szErrCode == 6049 or szErrCode == "6049") then	
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		Form.MsgBox( "알림", szErrMsg.."\n("..sSubMsg..")\n".."주문 취소 후 다시 ID해지를 진행하시기 바랍니다.", "", 6 )
	else
		Dim szSubMsg
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		If szSubMsg <> null and Trim(szSubMsg) <> "" Then
			szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
		end if
		
		Form.ShowAlert( "알림", szErrMsg )
	end if
	
End Sub



	</SCRIPT_INFO>
