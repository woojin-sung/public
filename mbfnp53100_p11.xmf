' 20160317 가격 Max : 7 (전요셉과장)

'============================================================================
' 화 면 명 : 수량 입력창
' 화면설명 : ELS/DLS 중도환매 신청 시
' 작    성 : 
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive, g_szopenPrc
g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive = "", "", "", "", ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nPlus)
	Dim szPrc
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = nPlus
	else
		szPrc = edtPrc.caption
		
	'	if Trim(szPrc) == "" then
	'		szPrc = 0
	'	end if	
		szPrc = szPrc & nPlus
		Sum_Prc(szPrc)
	end if
	
	Form.SendReturnToParent("CLEAR_POPUP" , "")
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	else
		szPrc = edtPrc.caption	
		
		if Len(edtPrc.caption) > 0 then
			szPrc = edtPrc.caption & szPlus
			
			Sum_Prc(szPrc)
		end if
	end if
	
	Form.SendReturnToParent("CLEAR_POPUP" , "")
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData)
	'if Len(szData) < 16 then
	if Len(szData) < 12 then		' Max 11
		edtPrc.caption = szData
	end if
	
End Function	
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen

	'Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) <> "" then
		tData = int(szOpen)
		g_szopenPrc = tData
'		g_szReceive = "1"
		edtPrc.caption = tData
'		g_szCd   = tData(1)
'		g_szMk   = tData(2)
'		g_szUnit = tData(3)
'		g_szType = tData(4)
'		edtHigh.caption = tData(5)
'		edtLow.caption  = tData(6)
'		
	else
		g_szReceive = "1"
		tData = 0
	end if

End Sub

'============================================================================
' btnPlus1_OnClick
'============================================================================
Sub btnPlus1_OnClick()
	Calc_Plus(1)
End Sub

'============================================================================
' btnPlus2_OnClick
'============================================================================
Sub btnPlus2_OnClick()
	Calc_Plus(2)
End Sub

'============================================================================
' btnPlus3_OnClick
'============================================================================
Sub btnPlus3_OnClick()
	Calc_Plus(3)
End Sub


'============================================================================
