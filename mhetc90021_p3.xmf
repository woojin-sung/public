	<SCRIPT_INFO _len="2401" _ulen="2237" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주총소집안내 이메일 고객정보제공동의 여부 등록
' 02. 화면설명 : 주총소집안내 이메일 고객정보제공동의 여부 등록
' 03. 작    성 : 2018.02.09 윤유정
'-------------------------------------------------------------------------------------------
Dim	g_Pros_YN
Dim	g_Elfn_Id
'============================================================================
Sub Form_OnFormInit()
	g_Pros_YN = Form.GetSharedData( "RGTPOPUP_PROS_YN" , False )
	g_Elfn_Id = Form.GetSharedData( "RGTPOPUP_ELFN_ID" , False )
End Sub

'============================================================================
Sub btnOK_OnClick()
	
	If Rdg0.currentindex == "0" or Rdg0.currentindex == "1" Then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_599a", "InBlock1", "PROS_CLS_CODE"	, 0 , g_Pros_YN)	'1 
		DATAMANAGER.SetDataValue(0, "obcsb_acif_599a", "InBlock1", "ELFN_ID"			, 0 , g_Elfn_Id)	'HTS ID
		
		DATAMANAGER.RequestTranData("obcsb_acif_599a")
	Else
		Form.ShowAlert( "알림" , "동의여부를 선택하여주시기 바랍니다.")
		Exit Sub
	End If
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	
End Sub
'============================================================================
Sub Container0_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_acif_599a" Then
		Form.CloseForm()
	End If
End Sub

'============================================================================
' 다시보지않기 체크
'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	Form.SetEnvData(1, "RGTPOPUP", sCheckState)
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mhetc90021_p3" , "")
End Sub

'============================================================================
Sub btnCncl_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
