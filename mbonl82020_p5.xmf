	<SCRIPT_INFO _len="3825" _ulen="3707" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_이자가계산구간별이자상세
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sAcc '계좌번호

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()	
	Dim sRevData 
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or sRevData == "" then
		Exit Sub
	end if
	
	Form.SetScreenName("대출이자 가계산 상세")
	
	g_sAcc = sRevData
	
	DATAMANAGER.RequestTranData( "oblon_pros_976r" ) '대출이자상세내역조회
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_pros_976r" then
		Dim code, loandate, stnddate, typecode, srno
		code = Form.GetSharedData("mbonl82020_p4_code", false )
		loandate = Form.GetSharedData("mbonl82020_p4_loandate", false )
		stnddate = Form.GetSharedData("mbonl82020_p4_stnddate", false )
		typecode = Form.GetSharedData("mbonl82020_p4_typecode", false )
		srno = Form.GetSharedData("mbonl82020_p4_srno", false )
		
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "ISCD" , 0 , code )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "LOAN_DATE" , 0 , loandate )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "STND_DATE" , 0 , stnddate )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , typecode )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_976r", "InBlock1", "LOAN_SRNO" , 0 , srno )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_pros_976r" then
		iqry_cls_code = DATAMANAGER.GetDataValue(0, "oblon_pros_976r", "OutBlock1", "IQRY_CLS_CODE" , 0)
		if iqry_cls_code = "1" then
			Grid0.visible = true
			Grid1.visible = false
		else
			Grid0.visible = false
			Grid1.visible = true
		end if
		
		Dim nCnt, nGridCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_pros_976r", "OutBlock2" )
		
		if nCnt > 0 then
			Dim INT_APLY_STA_DATE, INT_APLY_FIN_DATE, dpdate
			
			for i = 0 to nCnt-1 
				INT_APLY_STA_DATE = DATAMANAGER.GetDataValue( 0, "oblon_pros_976r", "OutBlock2", "INT_APLY_STA_DATE" , i ) 
				INT_APLY_FIN_DATE = DATAMANAGER.GetDataValue( 0, "oblon_pros_976r", "OutBlock2", "INT_APLY_FIN_DATE" , i ) 
				dpdate = Left(INT_APLY_STA_DATE, 4).."/"..Mid(INT_APLY_STA_DATE, 5, 2).."/"..Right(INT_APLY_STA_DATE, 2).." ~ "
				dpdate = dpdate..Left(INT_APLY_FIN_DATE, 4).."/"..Mid(INT_APLY_FIN_DATE, 5, 2).."/"..Right(INT_APLY_FIN_DATE, 2)
				
				Grid0.SetCellData("bd_date", i, dpdate)
				Grid1.SetCellData("bd_date", i, dpdate)
			next
		end if
	end if	
End Sub

