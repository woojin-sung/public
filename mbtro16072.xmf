'============================================================================
Sub RadioGroup0_OnClick(nIndex)	

	Dim szMask, szMask1
	szMask, szMask1 = "", ""
	
	if RadioGroup0.currentindex == "0" then
		szMask = "0,0,,,0,,0,1,1,0,0"
		grd0.SetCellIDMaskInfo("bd_cell5", szMask) '매도단가
		grd0.SetCellIDMaskInfo("bd_cell7", szMask) '매수단가
	else
		szMask = "0,0,,,0,,2,1,1,0,0"
		szMask1 = "0,0,,,0,,4,1,1,0,0"
		grd0.SetCellIDMaskInfo("bd_cell5", szMask1) '매도단가
		grd0.SetCellIDMaskInfo("bd_cell7", szMask1) '매수단가
	end if
	
	grd0.SetCellIDMaskInfo("bd_cell6", szMask) '매도금액
	grd0.SetCellIDMaskInfo("bd_cell8", szMask) '매수금액
	grd0.SetCellIDMaskInfo("bd_cell9", szMask) '매매차익
	grd0.SetCellIDMaskInfo("bd_cell11", szMask) '제세금
	grd0.SetCellIDMaskInfo("bd_cell2", szMask) '실현손익
	grd0.SetCellIDMaskInfo("bd_cell10", szMask) '수수료
	grd0.SetCellIDMaskInfo("bd_cell22", szMask) '대출이자
		
	requestData()
End Sub

