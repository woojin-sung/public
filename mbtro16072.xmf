'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	if szTranID == "obtro_oder_262r" then		
		szCmb0 = Combo0.cbkeydata
		if chk0.checkstate = "1" then
			szChk0 = "Y"
		else
			szChk0 = "N"
		end if
		if RadioGroup0.currentindex == "0" then
			szRad0 = "1"
		else
			szRad0 = "2"
		end if

		g_szAcno = left(acnt1.caption,8)
		g_szAsno = right(acnt1.caption,2)
		
		

		
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "ACNO" , 0 , g_szAcno )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "ASNO", 0 , g_szAsno )
'		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "ACNT_PWD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "ODER_STA_DATE" , 0 , cldFrom.caption )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "ODER_FIN_DATE" , 0 , cldTo.caption )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , szCmb0 )
'		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "OVRS_STCK_EXCH_IDNO" , 0 , cldToDate.caption )
'		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "ISCD" , 0 , cldToDate.caption )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "LOAN_YN" , 0 , szChk0 )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_262r", "InBlock1", "UI_IQRY_CLS" , 0 , szRad0 )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_oder_262r" then
		nCnt = DATAMANAGER.GetDataCount(0, "obtro_oder_262r", "OutBlock1")
		for i = 0 to nCnt-1
			szMarketCd = DATAMANAGER.GetDataValue(0, "obtro_oder_262r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i)		
			if szMarketCd == "01" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "미국")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "USD")
			elseif szMarketCd == "02" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "홍콩")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "HKD")
			elseif szMarketCd == "03" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "상해")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "CNY")
			elseif szMarketCd == "04" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "심천")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "CNY")
			elseif szMarketCd == "05" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "일본")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "JPY")
			elseif szMarketCd == "06" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "호주")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "AUD")				
			elseif szMarketCd == "07" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "싱가포르")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "SGD")
			elseif szMarketCd == "08" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "영국")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "GBP")
			elseif szMarketCd == "09" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "영국")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "USD")
			elseif szMarketCd == "10" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "독일")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")
			elseif szMarketCd == "11" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "핀란드")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")	
			elseif szMarketCd == "12" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "프랑스")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")	
			elseif szMarketCd == "13" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "벨기에")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")				
			elseif szMarketCd == "14" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "네덜란드")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")				
			elseif szMarketCd == "15" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "포르투갈")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")				
			elseif szMarketCd == "16" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "그리스")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")				
			elseif szMarketCd == "17" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "아일랜드")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")	
			elseif szMarketCd == "18" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "이탈리아")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")	
			elseif szMarketCd == "19" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "스페인")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")	
			elseif szMarketCd == "20" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "오스트리아")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "EUR")					
			elseif szMarketCd == "21" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "캐나다")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "CAD")
			elseif szMarketCd == "23" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "인도네시아")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "IDR")
			elseif szMarketCd == "24" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "베트남")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "VND")
			elseif szMarketCd == "26" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "스위스")
				grd0.SetCellData( "bd_cell1", g_nIndex + i, "CHF")
			end if
		next
		
		bNext = DATAMANAGER.IsMoreNextData( "obtro_oder_262r" )
		
		if bNext == "1" or bNext == true then
			Button1.enable = "1"
		else
			Button1.enable = "0"
		end if
		
		g_nIndex = _tonumber( grd0.rowcount )
	end if
End Sub

