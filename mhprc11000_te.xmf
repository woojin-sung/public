	<SCRIPT_INFO _len="10568" _ulen="10174" >
Dim g_szItemCode,g_szItemMarket,g_szItemName

Dim g_StartIndx
g_StartIndx = 0

Dim g_EndIndx
g_EndIndx = 0

'추정데이터 개수
Dim g_ChujungCnt
g_ChujungCnt = 0

'일반데이터 개수
Dim g_NormalCnt 
g_NormalCnt = 0 

'그리드 항목명(총 14개항목)
Dim GridCol0 
GridCol0 = {"PER(배)", "EPS(원)", "PBR(배)", "자기자본(억)", "ROE(%)" , "매출액(억)", "순이익(억)", "영업이익(억)", "배당수익률(%)", "주당배당금(원)", "EV/EBITDA", "영업이익률", "영업이익증가율", "PSR(배)"}


'============================================================================
Sub Form_OnFormInitBefore()

	'그리드 세로항목 세팅
	Call SetGridHeader()
	
	'20230413 아이티젠(김경민) START
	imgInfo.SetMaintainingRatio("1")
	'20230413 아이티젠(김경민) END	
	
End Sub
'============================================================================
Sub Form_OnFormInit()
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "1" then '안드로이드
		lblInfo.setNeighborCtlPos(imgInfo, "left", 3, "") '20230522 KKM 안드로이드 공통적용	
     end if

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")


	Call RequestData()
	
End Sub

'============================================================================
Sub SetGridHeader()

	for i = 0 to 13
		Grid0.AddRow()
		Grid0.SetCellData("bd_cell4", i, GridCol0(i))
	next

End Sub

'============================================================================
Sub RequestData()

	Call ClearGrid()
	Call setinitVar()
	
	DATAMANAGER.RequestTranData("ohhts_fngd_001r") 'ROE / 매출액 / 순이익 / 영업이익 / 배당수익률 / 주당배당금 
	'DATAMANAGER.RequestTranData("ohhts_fngd_005r") '자기자본 / 영업이익증가율
	'DATAMANAGER.RequestTranData("ohhts_fngd_006r") '영업이익률
	'DATAMANAGER.RequestTranData("ohhts_fngd_008r") 'PER / EPS / PBR / EV/EBITDA / PSR
	

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "ohhts_fngd_001r" or szTranID = "ohhts_fngd_005r" or szTranID = "ohhts_fngd_006r" or szTranID = "ohhts_fngd_008r" then
'	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_SHRN_ISCD" 	 	, 0 , "A"& g_szItemCode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_KIND_CODE" 	 	, 0 , "D")
		
		
		if RadioGroup0.currentindex = 0 or RadioGroup0.currentindex = "0" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_JOB_CLS_CODE"	, 0 , "1") 
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_JOB_CLS_CODE"	, 0 , "2") 
		end if
		
'	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "ohhts_fngd_001r" then
		
		cnt = DATAMANAGER.GetDataCount(0, "ohhts_fngd_001r", "OutBlock1")
		
		if cnt > 0 then
			for i = 0 to cnt - 1 
				szData = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_ESTM_CLS", i)
				if szData = "A" then
					g_ChujungCnt = g_ChujungCnt + 1
				else
					g_NormalCnt = g_NormalCnt + 1 
				end if
			next
		
		
			if g_ChujungCnt = 0 and g_NormalCnt > 0 then
				g_StartIndx = 0
			
				if g_NormalCnt >= 4 then
					g_EndIndx = 3
				else
					g_EndIndx = g_NormalCnt - 1 
				end if
			else
				g_StartIndx = g_ChujungCnt - 1
			
				if g_NormalCnt >= 4 then
					g_EndIndx = g_StartIndx + 3
				else
					g_EndIndx = cnt -1
				end if
					
			end if
		
			Call SetGridData(szTranID)
			
		end if
			
	elseif szTranID = "ohhts_fngd_008r" then
	
		cnt = DATAMANAGER.GetDataCount(0, "ohhts_fngd_008r", "OutBlock1")
	
		
		if cnt > 0 then
			Call SetGridData(szTranID)
		end if
		
	
	elseif szTranID = "ohhts_fngd_005r" then
		
		cnt = DATAMANAGER.GetDataCount(0, "ohhts_fngd_005r", "OutBlock1")
	
		
		if cnt > 0 then
			Call SetGridData(szTranID)
		end if
	
	
	elseif szTranID = "ohhts_fngd_006r" then
	
		cnt = DATAMANAGER.GetDataCount(0, "ohhts_fngd_006r", "OutBlock1")
		
		if cnt > 0 then
			Call SetGridData(szTranID)
		end if
		
	end if

End Sub

'============================================================================
Sub SetGridData(szTranID)

	''ROE / 매출액 / 순이익 / 영업이익 / 배당수익률 / 주당배당금 
	if szTranID = "ohhts_fngd_001r" then
		
		CellNo = 0 
		
		for i = g_StartIndx  to g_EndIndx
			
			szHeader = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_YYMM" , i)
			szType = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_ESTM_CLS" 	,	i )
			szROE  = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_ROE"  	  	,	i )
			szSALS = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_SALS" 	  	, 	i )
			szNPDT = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_NPDT" 	  	, 	i )
			szOPFT = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_OPFT" 	  	, 	i )
			szERT  = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_DVDN_ERT" 	, 	i )
			szDVMN = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_PSTC_DVMN"	, 	i )
			
			
			if RadioGroup0.currentindex = 0 or RadioGroup0.currentindex = "0" then
				szHeader = "'" & Mid(szHeader,3,2) & "년" & Mid(szHeader,5,2) &"월"
			else
				szHeader = "'" & Mid(szHeader,3,2) & "년" & Mid(szHeader,5,2) &"월"
			end if
			
			if szType <> "A" then
				szSALS = szSALS / 100000000
				szNPDT = szNPDT / 100000000
				szOPFT = szOPFT / 100000000
			else
				szHeader = szHeader  &"(추정)"
			end if
			
			Grid0.SetCellTopCaption("th_cell"&Cstr(CellNo), szHeader)
			
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 4, FormatNumber(szROE,2))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 5, FormatNumber(szSALS,0))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 6, FormatNumber(szNPDT,0))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 7, FormatNumber(szOPFT,0))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 8, FormatNumber(szERT,2))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 9, FormatNumber(szDVMN,0))
			
			
			CellNo = CellNo + 1 
			
					
		next
		
		DATAMANAGER.RequestTranData("ohhts_fngd_008r") 'PER / EPS / PBR / EV/EBITDA / PSR
		
	'PER / EPS / PBR / EV/EBITDA / PSR
	elseif szTranID = "ohhts_fngd_008r" then
		
		CellNo = 0
		
		for i = g_StartIndx to g_EndIndx
			
			szPER = DATAMANAGER.GetDataValue(0,"ohhts_fngd_008r", "OutBlock1", "FID_FNAF_PER" , i)
			szEPS = DATAMANAGER.GetDataValue(0,"ohhts_fngd_008r", "OutBlock1", "FID_FNAF_EPS", i)
			szPBR = DATAMANAGER.GetDataValue(0, "ohhts_fngd_008r", "OutBlock1", "FID_FNAF_PBR" , i)
			szEVE = DATAMANAGER.GetDataValue(0, "ohhts_fngd_008r", "OutBlock1", "FID_FNAF_EV_EBTD" , i)
			szPSR = DATAMANAGER.GetDataValue(0, "ohhts_fngd_008r", "OutBlock1", "FID_FNAF_PSR" , i)
			
			
			if CDBL(szPER) < 0 then
				szPER = "N/A"
				Grid0.SetCellData("bd_cell"&Cstr(CellNo), 0, szPER)
			else
				Grid0.SetCellData("bd_cell"&Cstr(CellNo), 0, FormatNumber(szPER,2))
			end if
			
			
			'Grid0.SetCellData("bd_cell"&Cstr(CellNo), 0, FormatNumber(szPER,2))
			
			
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 1, FormatNumber(szEPS,0))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 2, FormatNumber(szPBR,2))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 10, FormatNumber(szEVE,2))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 13, FormatNumber(szPSR,2))
			
			CellNo = CellNo + 1 
		
		next
		
		DATAMANAGER.RequestTranData("ohhts_fngd_005r") 
		
	
	'자기자본 / 영업이익증가율
	elseif szTranID = "ohhts_fngd_005r" then
	
		CellNo = 0
		
		for i = g_StartIndx to g_EndIndx
		
			szType = DATAMANAGER.GetDataValue(0, "ohhts_fngd_001r", "OutBlock1", "FID_FNAF_ESTM_CLS" 	, i)
			szCPTL = DATAMANAGER.GetDataValue(0, "ohhts_fngd_005r", "OutBlock1", "FID_FNAF_CPTL_TOT"	, i)
			szINRT = DATAMANAGER.GetDataValue(0, "ohhts_fngd_005r", "OutBlock1", "FID_FNAF_OPFT_INRT" 	, i)
			
			'20230525 KKM START : 형변환 스크립트 오류 예외처리
			if szType <> "A" then
				sTemp = CStr(CDbl(szCPTL) / 100000000)
				szCPTL = sTemp
			end if
			'20230525 KKM END
			
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 3, FormatNumber(szCPTL,0))
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 12, FormatNumber(szINRT,2))
		
			CellNo = CellNo + 1
			
		next
	
		DATAMANAGER.RequestTranData("ohhts_fngd_006r")
	
	'영업이익률
	elseif szTranID = "ohhts_fngd_006r" then
	
		CellNo = 0
		
		for i = g_StartIndx to g_EndIndx
			
			szOPFT = DATAMANAGER.GetDataValue(0, "ohhts_fngd_006r", "OutBlock1", "FID_FNAF_OPFT_RT" , i)
			Grid0.SetCellData("bd_cell"&Cstr(CellNo), 11, FormatNumber(szOPFT,2))
		
			CellNo = CellNo + 1
		next

	end if	

End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "ETF_SUB_TAB" then
		Form.OpenFramePopup("mhprc11000_p4" , g_szItemCode & "|" & g_szItemMarket & "|" &  g_szItemName , sPosInfo)
	end if
End Sub
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")
		
		Call RequestData()
		
	end	if	
End Sub

'=============================================================================
Sub setinitVar()

	g_StartIndx = 0
	g_EndIndx = 0
	g_ChujungCnt = 0
	g_NormalCnt = 0 

End Sub 

'=============================================================================
Sub ClearGrid()

	for i = 0 to 13
		Grid0.SetCellData("bd_cell0", i, "")
		Grid0.SetCellData("bd_cell1", i, "")
		Grid0.SetCellData("bd_cell2", i, "")
		Grid0.SetCellData("bd_cell3", i, "")
	next 
	
	Grid0.SetCellTopCaption("th_cell0", "")
	Grid0.SetCellTopCaption("th_cell1", "")
	Grid0.SetCellTopCaption("th_cell2", "")
	Grid0.SetCellTopCaption("th_cell3", "")
	
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	Call RequestData()
End Sub

'============================================================================

'============================================================================
Sub Button0_OnClick()
	Form.OpenFramePopup("mhprc11000_p4" , g_szItemCode & "|" & g_szItemMarket & "|" &  g_szItemName , sPosInfo)
End Sub

