'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_42_n.9"

Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

Dim g_nLinkFm0_Top
Dim g_nLinkFm0_Height

Dim g_nLinkFm1_Top
Dim g_nLinkFm1_Height

Dim g_nLinkFm2_Top
Dim g_nLinkFm2_Height

Dim g_nLinkFm3_Top
Dim g_nLinkFm3_Height

Dim g_isClickRdo
g_isClickRdo = false

Dim g_szItemCd
g_szItemCd = ""

Dim g_isS1
g_isS1 = false
Dim g_isS2
g_isS2 = false
Dim g_isS3
g_isS3 = false
Dim g_isS4
g_isS4 = false

Dim g_nSubTab
g_nSubTab  = 0

Dim g_szOSType
g_szOSType = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기화
'===============================================
Function Init_Control()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	contMain.setExceptInvisibleCtl(true)
	
	contMain.setEnableScroll(false)
	g_nLinkFm0_Height = 475
	g_nLinkFm1_Height = 320
	g_nLinkFm2_Height = 280
	g_nLinkFm3_Height = 365
	g_nLinkFm0_Top = 0
	g_nLinkFm1_Top = g_nLinkFm0_Top + g_nLinkFm0_Height
	g_nLinkFm2_Top = g_nLinkFm1_Top + g_nLinkFm1_Height
	g_nLinkFm3_Top = g_nLinkFm2_Top + g_nLinkFm2_Height
	
	g_nInfo_Top = g_nLinkFm3_Top + g_nLinkFm3_Height
	contMain.setScrollBarVisible("2")
	contMain.lnkfm0.top  = g_nLinkFm0_Top
	contMain.lnkfm0.height = g_nLinkFm0_Height
	
	contMain.lnkfm1.top  = g_nLinkFm1_Top
	contMain.lnkfm1.height = g_nLinkFm1_Height
	
	contMain.lnkfm2.top  = g_nLinkFm2_Top
	contMain.lnkfm2.height = g_nLinkFm2_Height
	
	contMain.lnkfm3.top  = g_nLinkFm3_Top
	contMain.lnkfm3.height = g_nLinkFm3_Height

	contMain.SetUseScrollingEvent(true)
	contMain.SetNotifyScrollPos(g_nLinkFm0_Top&":"&g_nLinkFm1_Top-10&":"&g_nLinkFm2_Top-10&":"&g_nLinkFm3_Top-40)
	
	if g_szOSType = "1" then
		contMain.scroll_pos = "0"
	else
		contMain.scroll_pos_noAni = "0"
	end if
	
	contMain.lnkfm0.linkfile = "empty"
	contMain.lnkfm1.linkfile = "empty"
	contMain.lnkfm2.linkfile = "empty"
	contMain.lnkfm3.linkfile = "empty"
	contMain.lnkfm0.linkfile = "mhtro16000_s11"
	contMain.lnkfm1.linkfile = "mhtro16000_s12"
	contMain.lnkfm2.linkfile = "mhtro16000_s13"
	contMain.lnkfm3.linkfile = "mhtro16000_s14"
End Function


'===============================================
' 데이터 초기설정
'===============================================
Function Init_Data()
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	g_szOSType = Form.GetSharedData("&OS_TYPE", false )

	Init_Control()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "RequestData" then
		g_szItemCd = sParam
		g_isS1 = false
		g_isS2 = false
		g_isS3 = false
		
		Init_Control()
		
		Form.SetTimerEvent2(1,1,0.3)
'		Form.triggerEvent("lnkfm0", "INIT_CODE", g_szItemCd)

	elseif sEventName == "ETF_SUB_TAB" then
		nParam = Cint(sParam)
		g_nSubTab = nParam
		
	elseif sEventName == "ENABLE_SCROLL" then
		
		if sParam == "END" then
			contMain.setEnableScroll(true)
		elseif sParam == "TOP" then
			contMain.setEnableScroll(false)
		end if
		
	elseif sEventName == "CHANGE_LAYOUT_S11" then
		'g_nLinkFm0_Height = Cint(sParam)
		g_nLinkFm1_Top = g_nLinkFm0_Top + g_nLinkFm0_Height
		g_nLinkFm2_Top = g_nLinkFm1_Top + g_nLinkFm1_Height
		g_nLinkFm3_Top = g_nLinkFm2_Top + g_nLinkFm2_Height
	
		
		contMain.lnkfm0.top  = g_nLinkFm0_Top
		'contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
		'contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
		'contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
		'contMain.lnkfm3.height = g_nLinkFm3_Height
		
		
		contMain.setScrollAutoSize()

		if g_isS1 = false then
			Form.triggerEvent("lnkfm1", "INIT_CODE", g_szItemCd)
			g_isS1 = true
		end if
	elseif sEventName == "CHANGE_LAYOUT_S12" then
		g_nLinkFm2_Top = g_nLinkFm1_Top + Cint(sParam)
		g_nLinkFm3_Top = g_nLinkFm2_Top + g_nLinkFm2_Height
		
		
		contMain.lnkfm0.top  = g_nLinkFm0_Top
		'contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
		'contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
'		contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
		'contMain.lnkfm3.height = g_nLinkFm3_Height
		
		contMain.setScrollAutoSize()
		
		
		if g_isS2 == false then
			Form.triggerEvent("lnkfm2", "INIT_CODE", g_szItemCd)
			g_isS2 = true
		end if

		
	elseif sEventName = "CHANGE_LAYOUT_S13" then
		g_nLinkFm2_Height = Cint(sParam)
		g_nLinkFm3_Top = g_nLinkFm2_Top +  Cint(sParam)
	
		contMain.lnkfm0.top  = g_nLinkFm0_Top
		'contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
		'contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
		contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
'		contMain.lnkfm3.height = g_nLinkFm3_Height
		
		contMain.setScrollAutoSize()

		if g_isS3 = false then
			Form.triggerEvent("lnkfm3", "INIT_CODE", g_szItemCd)
			g_isS3 = true
		end if
		
	elseif sEventName = "CHANGE_LAYOUT_S14" then
		g_nLinkFm3_Height =  Cint(sParam)
		contMain.lnkfm0.top  = g_nLinkFm0_Top
'		contMain.lnkfm0.height = g_nLinkFm0_Height
		
		contMain.lnkfm1.top  = g_nLinkFm1_Top
'		contMain.lnkfm1.height = g_nLinkFm1_Height
		
		contMain.lnkfm2.top  = g_nLinkFm2_Top
'		contMain.lnkfm2.height = g_nLinkFm2_Height
		
		contMain.lnkfm3.top  = g_nLinkFm3_Top
		contMain.lnkfm3.height = g_nLinkFm3_Height
		
		contMain.setScrollAutoSize()
		
		if g_nSubTab > 0 then
			FormTab0.currenttab = g_nSubTab
			FormTab0_OnTabChanged(g_nSubTab)
		end if
		
		contMain.SetNotifyScrollPos(g_nLinkFm0_Top&":"&g_nLinkFm1_Top-10)
		
		
	elseif sEventName = "RETURN_LAYOUT" then
		Form.triggerEvent("#", "RETURN_LAYOUT_T11", sParam)
	end if
End Sub

Sub contMain_OnNotifyScrolling(nIndex)
	if g_isClickRdo = true then
		g_isClickRdo = false
		Exit Sub
	end if
	
	FormTab0.currenttab = nIndex
End Sub


'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	g_isClickRdo = true
	if nCurrentTab = 0 then
		
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nLinkFm0_Top
		else
			contMain.scroll_pos_noAni = g_nLinkFm0_Top
		end if
	elseif nCurrentTab = 1 then
		if g_isMorningStar = "N" then
			if g_szOSType = "1" then
				contMain.scroll_pos = "end"
			else
				contMain.scroll_pos_noAni = "end"
			end if

		else
			if g_szOSType = "1" then
				contMain.scroll_pos = g_nLinkFm1_Top
			else
				contMain.scroll_pos_noAni = g_nLinkFm1_Top
			end if
		end if
	elseif nCurrentTab = 2 then
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nLinkFm2_Top
		else
			contMain.scroll_pos_noAni = g_nLinkFm2_Top
		end if
	elseif nCurrentTab = 3 then
		if g_szOSType = "1" then
			contMain.scroll_pos = g_nLinkFm3_Top
		else
			contMain.scroll_pos_noAni = g_nLinkFm3_Top
		end if
	end if

End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID,0,0)
	if Cint(sTimerID) == 1 then
		Form.triggerEvent("lnkfm0", "INIT_CODE", g_szItemCd)
	end if
End Sub

