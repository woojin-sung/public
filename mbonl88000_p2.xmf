	<SCRIPT_INFO _len="13392" _ulen="11996" >
'============================================================================
' 01. 화 면 명 : 파생상품ETF거래신청
' 02. 화면설명 : 파생상품ETF거래신청
' 03. 작    성 : 2016.03.03 유창재
' 04. 수    정 : 2018.01.15 윤유정 : 국내/해외파생 ETF 나눠서 조회 v0001
'			: 2020.09.16 : 권오상 : v002 : T2008250015 : 메모리평문 취약점 수정
'			: 2023.11.22 : 권오상 : V003 : 투자성향진단 신규 화면으로 변경
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCustNum			'고객번호
Dim g_szPW				'비밀번호

Dim g_SUCS_YN				'처리결과
Dim g_INCL_Code			'KYC 투자성향등급코드
Dim g_PROD_Code			'KYC 상품등급코드
Dim g_DVPD_Code			'KYC 파생상품유의코드
Dim g_DRVT_YN				'KYC 파생 처리 여부
Dim g_STND_Date			'기준일자
Dim g_REG_Srno			'등록일련번호
Dim g_SVCD				'서비스코드(054.국내ETF / 083.해외ETF) v0001
Dim g_Flg353r				'ETP보완조치 이전 팝업 결정 FLAG -> 0:팝업ok(054,083 둘다 보완조치) / 1:팝업no(083만 보완조치) v0001
Dim	g_PlainRm 'v002
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Function SetTrans()
	DATAMANAGER.RequestTranData( "obpds_srvc_353r_1" )
'	if tbl0.GetCellString( 0, 1) <> "승인완료" then
''		g_szApproveCode = "I"
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "I")
'		DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
'	end if
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()
	Dim szText
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002
	edtPW.caption = ""
	szText = "<html><body> 국내파생ETF자동해지 고지문<br><br>"&
			"● 국내파생ETF 거래는 투자정보제공이 필요하며, 초고위험(1등급)상품으로 고수익지향형 고객님께 적정합니다.<br><br>"&
			"● 국내파생ETF 자동해지 안내문자 수신일포함 5영업일내 보완조치가 필요합니다 (미조치시 자동해지됨) <br><br>"
			&"</body></html>"
	web0.loaddata = szText
	
'	g_szCustNum = Form.GetSharedData( "&CUST_NUM" , false )
	
	g_SUCS_YN = Form.GetSharedData( "KYC_SUCS_YN" , false )
	g_STND_Date = Form.GetSharedData( "KYC_STND_DATE", false )
	g_REG_Srno = Form.GetSharedData( "KYC_REG_SRNO", false )
	' 현재는 703r TR에서 받아옴
	g_INCL_Code = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
	g_PROD_Code = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
	g_DVPD_Code = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
	g_DRVT_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
	
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
	g_SVCD = "054" 'v0001
	g_Flg353r = 0 'v0001
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obpds_srvc_353r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r", "InBlock1", "SVCD" , 0 , g_SVCD) 'v0001
	elseif szTranID == "obpds_srvc_353r_1" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r_1", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r_1", "InBlock1", "SVCD" , 0 , g_SVCD) 'v0001
	'v0001 353r_2 추가
	elseif szTranID == "obpds_srvc_353r_2" then 
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r_2", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r_2", "InBlock1", "SVCD" , 0 , g_SVCD)
	elseif szTranID == "obpds_srvc_045a" then			'ETF약정
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "054")		'054 ETF, 021 ELW
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "01")
		
		if g_SUCS_YN == "Y" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "STND_DATE" , 0 , g_STND_Date)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "REG_SRNO" , 0 , g_REG_Srno)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_YN" , 0 , "Y")
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_INCL_Code )
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_PROD_Code)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "02")
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_DVPD_Code)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_DRVT_YN)
		end if
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , acnt0.total)
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szMsgCode	
	
	
'	if szTranID == "obpds_srvc_323r" then
'		szMsgCode = DATAMANAGER.GetDataMsgCode( "obpds_srvc_323r" )
'		if szMsgCode = "5766" then
'			tbl0.SetCellString( 0 , 1 , "등록" )
'			btnOK.enable = false
'		else
'			tbl0.SetCellString( 0 , 1 , "미등록" )
'			btnOK.enable = true
'		end if
     if szTranID == "obpds_srvc_353r" then
         if DATAMANAGER.GetDataValue( 0, "obpds_srvc_353r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) = "11" Then
	         tbl0.SetCellString( 0 , 1 , "자동해지대상" )
		    btnOK.enable = true
		else
'		    Form.ShowAlert( "알림" , "자동해지대상이 아니므로 해당화면 이용이 불가합니다")
'		    Form.CloseForm(0)
			'v0001 sta 
			'국내파생ETF 자동해지대상이 아니면 해외파생ETF 조회
			tbl0.SetCellString(0, 0, "해외ETP 자동해지현황")
			
			Dim szText
			szText = "<html><body> 해외ETP 자동해지 고지문<br><br>"&
					"● 해외ETP 거래는 투자정보제공이 필요하며, 초고위험(1등급)상품으로 고수익지향형 고객님께 적정합니다.<br><br>"&
					"● 해외ETP 자동해지 안내문자 수신일포함 5영업일내 보완조치가 필요합니다 (미조치시 자동해지됨) <br><br>"
					&"</body></html>"
			web0.loaddata = szText
			
			g_SVCD = "083" 
			g_Flg353r = 1 
			DATAMANAGER.RequestTranData( "obpds_srvc_353r_2" )
			'v0001 fin
		end if
	'v0001 sta
	elseif szTranID == "obpds_srvc_353r_2" then
		if DATAMANAGER.GetDataValue( 0, "obpds_srvc_353r_2", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) = "11" Then
			If g_Flg353r == 0 Then 
				Form.MsgBox("알림", "국내파생ETF 부적정 등록이 완료되었습니다. \n해외ETP 거래를 위해 부적정 등록을 진행하시겠습니까?", "ETP_YN", 1)
			Else
				tbl0.SetCellString( 0 , 1 , "자동해지대상" )
				btnOK.enable = true
			End If
		else
			Form.ShowAlert( "알림" , "국내ETF/해외ETP 보완조치가 모두 완료되었습니다.") 
			Form.CloseForm(0)
		end if
	'v0001 fin 
	elseif szTranID == "obpds_srvc_353r_1" then
         if DATAMANAGER.GetDataValue( 0, "obpds_srvc_353r_1", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) = "01" Then
			'v0001 sta
		    '해외파생ETF 조회
		    If g_SVCD == "054" Then
			     g_SVCD = "083" 
			     g_Flg353r = 0 
				DATAMANAGER.RequestTranData( "obpds_srvc_353r_2" )
		    Else
			     tbl0.SetCellString( 0 , 1 , "보완조치완료" )
				Form.ShowAlert( "알림" , "보완조치가 완료되었습니다.")
		    End If
		    'v0001 fin
		else
			'szData = "88000" & "★" & acnt0.total & "★" & edtPW.caption & "★" & g_SVCD 'v0001
			If g_SVCD == "054" Then
			    szData = "88000" & "★" & acnt0.total & "★" & edtPW.caption & "★" & g_SVCD
			ElseIf g_SVCD == "083" Then
				szData = "87050" & "★" & acnt0.total & "★" & "" & "★" & edtPW.caption & "★" & g_SVCD
			End If
		    Form.OpenFramePopup( "mbonl81010_p1" , szData , sPosInfo)
		end if   
	elseif szTranID == "obcsb_acif_000r" then
		g_szCustNum = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CSNO" , 0)
		
		tbl0.SetCellString( 0 , 1 , "" )
		g_SVCD = "054" 'v0001
		DATAMANAGER.RequestTranData( "obpds_srvc_353r" )
	elseif szTranID == "obpds_srvc_045a" then
		Form.ShowAlert( "알림", "처리가 완료되었습니다.")
		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obpds_srvc_353r" then
		tbl0.SetCellString( 0 , 1 , "조회오류" )
	elseif szTranID == "obpds_srvc_045a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub btnOK_OnClick()
	Dim szData
	
	if edtPW.caption == "" then
		Form.ShowAlert( "알림" , "비밀번호를 입력하세요.")
		Exit Sub
	else
		'szData = "88000" & "★" & acnt0.total & "★" & edtPW.caption 'v0001
		If g_SVCD == "054" Then
		    szData = "88000" & "★" & acnt0.total & "★" & edtPW.caption
		ElseIf g_SVCD == "083" Then
			szData = "87050" & "★" & acnt0.total & "★" & "" & "★" & edtPW.caption & "★" & g_SVCD
		End If
	end if
     DATAMANAGER.RequestTranData( "obpds_srvc_353r_1" )
     
	'
End Sub
'============================================================================
' 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "KYCCHK_RETURN" then			'투자성향진단 OK면 Y값내려줌
		if sRet == "Y" then
			SetTrans()
		end if
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub edtPW_OnEditComplete()
	
'	g_szPW = Form.GetEncData( edtPW.caption ) 'v002
	'v0
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPW = edtPW.caption
	Else
		g_szPW = Form.GetEncData( edtPW.caption )
	End If

	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' 
'============================================================================
Sub acnt0_ChangeAccount()

	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	edtPW.caption = ""
	g_szPW = ""
	
End Sub
'============================================================================
' btnCancel_OnClick()
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' btnCancel_OnClick()
'============================================================================
Sub btnKyc_OnClick()
     if edtPW.caption == "" then
		Form.ShowAlert( "알림" , "비밀번호를 입력하세요.")
		Exit Sub
	else
		szData = acnt0.caption & "★" & edtPW.caption
	end if
	
'	Form.OpenFramePopup("mbonl81010_s1" , szData, sPosInfo) V003
	Form.OpenPopup("mbonl81010_s2" , szData, "") 'V003
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	
	if sKeyName == "ETP_YN" then
		if sRet == "ok" then	
			g_SVCD = "083" 
		     tbl0.SetCellString(0, 0, "해외ETP 자동해지현황")
		     
		     Dim szText
			szText = "<html><body> 해외ETP 자동해지 고지문<br><br>"&
					"● 해외ETP 거래는 투자정보제공이 필요하며, 초고위험(1등급)상품으로 고수익지향형 고객님께 적정합니다.<br><br>"&
					"● 해외ETP 자동해지 안내문자 수신일포함 5영업일내 보완조치가 필요합니다 (미조치시 자동해지됨) <br><br>"
					&"</body></html>"
			web0.loaddata = szText
		     
		     tbl0.SetCellString( 0 , 1 , "자동해지대상" )
 		     btnOK.enable = true
		else
			g_SVCD = "054" 
			Exit Sub
		end if
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obpds_srvc_323r" trcode="obpds_srvc_323r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="SVCD" idx="2" defconst="054" />
				</TRBLOCK>
			</TRAN>
			<TRAN tranid="obcsb_acif_000r" trcode="obcsb_acif_000r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="PROS_CLS_CODE" idx="0" defconst="I" />
