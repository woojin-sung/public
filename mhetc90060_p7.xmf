'20240117 LES START
'해외개인 조합주민번호가 아닌 이외 번호(외국인등록번호 등..) 인증서 발급 시 인증서발급유형코드 변경
'해외개인이 조합주민번호로 인증서발급 시에만 03 으로 올림. 그렇지않을 경우 01로 올림
Dim g_sRcnoPip

Dim g_bNeedConnect
g_bNeedConnect = False
'--------------------------------------------------------------------------------------------------------------------------
'20160923_01 LKM START 
'인증서 발급시 온라인 신원확인 조회 약정 서비스 로직 추가
'1) 약정되어있고, 동의상태 		- 기존로직 그대로 적용
'2) 약정되어있고, 미동의 상태 	- 진행불가 (팝업창 오픈)
'3) 미약정 상태 				- 	인증서 발급시 사전동의 팝업 추가 
'								(본인확인 > 계좌확인 > 추가인증 > 보안매체 확인 > 인증서 발급시 사전동의 팝업 
'					  			 > 인증서 발급시 온라인 사전동의 약정"obpds_srvc_173a"> 정보확인 > 인증서 비밀번호 적용 > 인증서 발급)

'20160923_01 LKM END

'--------------------------------------------------------------------------------------------------------------------------
'20231211 SWJ START : 외국인투자자 등록제도 폐지
'외국인인 경우 마지막 단계에서 조합여권번호로 올려야 함, 나머지는 해당 필드에서 실명확인번호로 내려옴
'20201021 SWJ START
'인증서 발급 시 가입자의 최신 연락처 코스콤 인증센터로 전달
'20201022 SWJ START
'사고계좌 여부 확인 (진행절차 : 사전동의 여부 확인 > 사고계좌 여부 확인)
'20201116 SWJ START : 실명확인번호 암호화 (rcno_plain_rm = 0 미적용 / rcno_plain_rm = 1 적용)
'20201119 SWJ START : (인증서 발급/등록 단계) 개인고객 스텝 추가 (보안매체 단계 대신 휴대폰 인증> 본인확인 단계로 대체 가능) (12.9 이후 운영 반영)
'20201126 SWJ START : 공인인증서에서 '공인' 글자 삭제 (12.9 운영 반영)
'20210707 SWJ START : 모바일OTP 인증 시, 앱 삭제 등의 이유로 앱에는 정보가 없지만, 기간계에는 등록된 것으로 나오는 경우
   '                  현재는 모바일OTP 다운로드가 아닌, 모바일OTP를 발급하라는 메시지 이후 업무신청 화면으로 넘어감.
   '			         이 부분이 불편하다고 접수되어 절차 개선(휴대폰 본인인증으로 인증서 발급/재발급 가능하도록)
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 단계별 화면변경
'============================================================================
Function SetControlChange()
	if g_sRevData == "new" then
		
		if g_nStepIndex == 0 then
			LinkForm0.linkfile = G_CERT_CONFIRM_FILE		'인증서본인확인화면
			
			'20240418 SWJ START
			'클라우드 인증서 목록이 있는지 확인하는 함수
			'(함수의 목적과 달리 연결 여부를 판단하려고 호출)
			'(일단 무언가를 호출해야 CLOUD_EVENT_ACQUIREUSERINFO 이벤트가 발생)
			Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90060")
			'20240418 SWJ END
			
		elseif g_nStepIndex == 1 then
		
			LinkForm0.linkfile = G_CERT_ACCPW_FILE		'인증서계좌확인화면
			
		elseif g_nStepIndex == 2 then			
			LinkForm0.linkfile = G_CERT_AGREE_FILE		'인증서약관동의화면
		elseif g_nStepIndex == 3 then
			LinkForm0.linkfile = G_CERT_CUSTOMINFO_FILE	'인증서고객연락처화면
		elseif g_nStepIndex == 4 then
			LinkForm0.linkfile = G_CERT_NEWPW_FILE		'인증서신규비밀번호화면
		else
			LinkForm0.linkfile = ""
		end if
		
	elseif g_sRevData == "regi" then
	
		if g_nStepIndex == 0 then
			LinkForm0.linkfile = G_CERT_CONFIRM_FILE		'인증서본인확인화면
		elseif g_nStepIndex == 1 then
			LinkForm0.linkfile = G_CERT_ACCPW_FILE		'인증서계좌확인화면
		elseif g_nStepIndex == 2 then
			LinkForm0.linkfile = G_CERT_LIST_FILE		'인증서목록화면
		else
			LinkForm0.linkfile = ""
		end if
	end if
	
	Form.triggerEvent( "LinkForm0", "TabChange", g_sRevData )
End Function

'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()

'20201119 SWJ START : 개인고객은 휴대폰본인인증 화면으로 대체가능
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
	
	if sCONO = "1" or Trim(sCONO) = "1" then '개인고객 '20210118 SWJ START : 개인/법인 구분방식 변경(법인이 실명확인번호로 등록되어 있는 경우도 있어서)
		
		if g_sGubunCode == "0" then '보안카드
			Form.OpenFramePopup( G_CERT_SECURITY_FILE , "individual_check" , "" )	'보안카드풀팝업
		
		elseif g_sGubunCode == "1" then '부가정보
			Form.OpenFramePopup( G_CERT_QUESTION_FILE , "individual_check" , "" )	'부가정보풀팝업
			
		elseif g_sGubunCode == "3" then 'OTP
			Form.OpenFramePopup( G_CERT_OTP_FILE , "individual_check" , "" )	  	'일반/스마트OTP풀팝업
			
		'20210216 SWJ START : 모바일OTP 인증매체 추가
		elseif g_sGubunCode == "4" then '모바일OTP
			
			'20210707 SWJ START
			if g_PhoneAuth then
				Form.OpenFramePopup("mhetc90060_ph"  , ""  ,"")
			else
				'20240321 SWJ START
				'모바일OTP 및 OTP 인증 시
				'로그아웃 상태에서 USERID와 다른 계정으로
				'발급 시도할 때 문제가 될 수 있어서 추가 함
				'보수적으로 motp 인증 시에만 이렇게 처리(다음 화면에서 쉐어드변수 바로 클리어 가능)
				szAcno = Form.GetSharedData("CERT_ACNO" , false)
				
				Form.SetSharedData("BioCommonAuth_RegYN", "Y") 
				Form.SetSharedData("BioCommonAuth_Acno", szAcno)
				'20240321 SWJ END
				
				Form.OpenPopup( G_CERT_MOTP_FILE, "motp_success","")                 	'모바일 OTP
			end if
			'20210707 SWJ END
			
		'20210216 SWJ END														'motp_check값 넘겨주면 인증완료시 인증완료 화면 안뜨고 그냥 넘어가도록
		
		elseif g_sGubunCode == "2" then '없을경우
		
			'20240219 SWJ START
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			RegisterOTP()
			'20240219 SWJ END
			
		else '에러
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
			
		end if
		
	else

		if g_sGubunCode == "0" then '보안카드
			Form.OpenFramePopup( G_CERT_SECURITY_FILE , "" , "" )	'보안카드풀팝업
			
		elseif g_sGubunCode == "1" then '부가정보
			Form.OpenFramePopup( G_CERT_QUESTION_FILE , "" , "" )	'부가정보풀팝업
			
		elseif g_sGubunCode == "3" then 'OTP
			Form.OpenFramePopup( G_CERT_OTP_FILE , "" , "" )	  	'일반/스마트OTP풀팝업
		
		elseif g_sGubunCode == "4" then '모바일OTP
			Form.OpenPopup( G_CERT_MOTP_FILE,"motp_success","")                          	'모바일 OTP
			
		elseif g_sGubunCode == "2" then '없을경우
		
			'20240219 SWJ START
			'법인은 그대로
			Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			'RegisterOTP()
			'20240219 SWJ END
			
		else '에러
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
			
		end if
	end if
'20201119 SWJ END
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
