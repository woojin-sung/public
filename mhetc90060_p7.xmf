'============================================================================
'20240418 SWJ START : 클라우드 인증서 도입
'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	if #szItem >= 2 then
		sErrorCd		= szItem(0)
		sErrorMsg	= szItem(1)	
	
		'오류이면
		if sErrorCd <> "0" then
			Form.MsgBox(sCommand, sErrorMsg, "", 0)
			exit sub
		end if		
	end if
	
	'클라우드 연결 여부 확인
	'연결이 필요하면 이벤트 발생
	if sCommand == "CLOUD_EVENT_ACQUIREUSERINFO" then
		g_bNeedConnect = True
		Form.SetSharedData("CLOUD_CONNECT_FROM_CERT", g_bNeedConnect)
	end if
End Sub
