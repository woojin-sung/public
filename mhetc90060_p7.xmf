'============================================================================
Sub Form_OnFormInit()
	G_CERT_CONFIRM_FILE 	= "mhetc90060_s6"		'인증서본인확인화면
	G_CERT_ACCPW_FILE 	= "mhetc90060_s7"		'인증서계좌확인화면
	G_CERT_AGREE_FILE 	= "mhetc90060_s8"		'인증서약관동의화면
	G_CERT_LIST_FILE 		= "mhetc90060_s1"		'인증서목록화면
	G_CERT_PW_FILE 		= "mhetc90060_p5"		'인증서비밀번호입력풀팝업
	G_CERT_CUSTOMINFO_FILE = "mhetc90060_s9"		'인증서고객연락처화면
	G_CERT_NEWPW_FILE 	= "mhetc90060_sa"		'인증서신규비밀번호화면
	
	G_CERT_ADD_FILE 		= "mhetc90060_p8"		'추가인증풀팝업
	
'20201119 SWJ START : 개인고객 인증서 발급/등록 단계에 한해 보안매체 팝업 변경	
	G_CERT_SECURITY_FILE 	= "mhetc90060_p9"		'보안카드풀팝업
	G_CERT_QUESTION_FILE	= "mhetc90060_pa"		'부가정보풀팝업
	G_CERT_OTP_FILE 		= "mhetc90060_pb"		'일반/스마트OTP풀팝업
	
	'20210216 SWJ START
	G_CERT_MOTP_FILE       = "mhetc90060_motp"    'MOTP
	'20210216 SWJ END
	
'20201119 SWJ END
	
	'20240418 SWJ START : p8과 합침
	'20160502 NOHES : 인증서 발급/재발급용 풀팝업 추가
	G_CERT_ADD_FILE02 	= "mhetc90060_p8"	'추가인증풀팝업2
	'20240418 SWJ END
	
	g_sGubunCode = ""
	g_nStepIndex = 0
	g_sRevData = Form.GetOpenLinkData( )
	
	if g_sRevData == null or g_sRevData == "" then
		g_sRevData = "new"
	elseif g_sRevData == "new" then
		LabelTitle.caption = "인증서 발급/재발급"
	elseif g_sRevData == "regi" then
		LabelTitle.caption = "타기관 인증서 등록"
	end if
	
	'20201116 SWJ START : 실명확인번호 암호화
	'rcno_plain_rm = ( 0 : 미적용/ 1 : 적용)
	rcno_plain_rm = Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	'20201116 SWJ END
	
	'20210707 SWJ START : 모바일OTP 앱에 존재하는지 체크
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if g_DeviceOS = "1" then
		Form.requestMOTP("MOTP_GETINFO"     , "" , "90060")     '등록된 OTP alias 존재하는지 확인
	end if
	'20210707 SWJ END
	
	SetControlChange()
End Sub
'============================================================================
'20210707 SWJ START : 모바일OTP 앱에 존재하는지 체크
Sub Form_OnFormInitAfter()
	if g_DeviceOS == "2" then
		Form.requestMOTP("MOTP_GETINFO"     , "" , "90060")     '등록된 OTP alias 존재하는지 확인		
	end if
End Sub
'20210707 SWJ END
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "NextStep" then
	
		if g_sRevData == "new" then
			if g_nStepIndex < 4 then
				if g_nStepIndex == 2 then '단말지정확인
					'16-04-02 YCJ 단말지정약정 내역 조회 TR을 바꿔서 구분
					DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '추가인증대상,단말기지정약정조회
'					DATAMANAGER.RequestTranData( "obpds_srvc_405a" ) '단말지정약정내역조회
				
'20160923_01 LKM START
				elseif g_nStepIndex == 0 then '본인확인
					
					'인증 발급시 온라인 신원확인 동의 조회
					DATAMANAGER.RequestTranData("obpds_srvc_173r")
'20160923_01 LKM END
				else
					g_nStepIndex = g_nStepIndex+1
					SetControlChange()
				end if

			elseif g_nStepIndex == 4 then '발급/재발급실행
				DATAMANAGER.RequestTranData( "obcsb_acif_000r" ) '고객번호조회
				
				'20201021 SWJ START: 고객 연락처 정보 추가
				DATAMANAGER.ReqeustTranData( "obcsb_acad_002r" )
				'20201021 SWJ END
			end if
			
		elseif g_sRevData == "regi" then
			if g_nStepIndex < 2 then
				if g_nStepIndex == 1 then '추가인증확인
					'16-04-13 YCJ 전요셉 과장님 요청으로 TR 서비스 변경
					DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '추가인증대상,단말기지정약정조회
'					DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
				else
					g_nStepIndex = g_nStepIndex+1
					
					SetControlChange()
				end if
			elseif g_nStepIndex == 2 then 
				'20160602 NOHES START
				Form.OpenFramePopup( G_CERT_PW_FILE , "regi" , "" )
				'20160602 NOHES END
			end if
		end if
		
	elseif sEventName == "BeforeStep" then
	
		if g_nStepIndex > 0 then
			g_nStepIndex = g_nStepIndex-1
			
			SetControlChange()
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_CERT_PW_FILE then
		if sRet ~= "cancel" then '타기관등록실행
			Dim sTemp, sDN, sRValue, sSignData
			'20161101 NOHES START ">"빠짐 대응
			sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1 )
			sCertDn = Form.GetSharedData("CERT_IMSI_DN", 1 )
			sTemp = Split(sRet, ";")
			
			if sCertDn <> null and sCertDn <> "" then
				sDN = sCertDN
			else
				sDN = Form.GetSharedData("CERT_DN" , false)
			end if
			
			if sCertPass <> null and sCertPass <> "" then
				sRValue = Form.GetRvalue( sDN , sCertPass)
				sSignData = Form.GetCertSignData( sDN , sCertPass)
			else
				sRValue = Form.GetRvalue( sDN , sTemp[1])
				sSignData = Form.GetCertSignData( sDN , sTemp[1])
			end if
			'20161101 NOHES END
			
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "UI_R_VAL" , 0 , sRValue )
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" , 0 , sSignData )
			
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" ) '고객번호조회
		end if 
		
	'20160502 NOHES START : 인증서 발급/재발급 시 풀팝업2
	elseif sKeyName == G_CERT_ADD_FILE02 then
		if sRet == "ok" then
			'20210118 SWJ START : 보안매체별 화면 오픈 구분값(개인고객/법인고객)
			DATAMANAGER.RequestTranData("obcsb_acif_000r_1")
			'DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
			'20210118 SWJ END
		else
			g_sGubunCode = ""
		end if
	'20160502 NOHES END	
	
	elseif sKeyName == G_CERT_ADD_FILE then
		if sRet == "ok" then
			'16-04-14 YCJ 수정
			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
			
'			SetSecurityOpen()
		else
			g_sGubunCode = ""
		end if
	
	elseif sKeyName == G_CERT_SECURITY_FILE or sKeyName == G_CERT_QUESTION_FILE or 
			sKeyName == G_CERT_OTP_FILE or sKeyName == G_CERT_MOTP_FILE then '20210216 SWJ START : 모바일OTP 추가
		if sRet == "ok" then

'20160923_01 LKM START
			'인증서 발급/재발급
			if g_sRevData == "new" Then
				DATAMANAGER.RequestTranData("obpds_srvc_173r")
		
			else
				g_nStepIndex = g_nStepIndex+1
				SetControlChange()
			end if
		end if
	
	'인증서 발급시 온라인 신원확인 사전동의 팝업창 동의
	elseif sKeyName == "mhetc90060_p13" then 
		'약정(동의)
		if sRet == "AgreeY" then
			
			'20201022 SWJ START : 사고계좌 인증서 발급 제한
			DATAMANAGER.RequestTranData("obpds_srvc_173r")
			'g_nStepIndex = g_nStepIndex+1
			'SetControlChange()
			'20201022 SWJ END
			
		'약정(미동의) 또는 발급/재발급 업무 중단 
		else
			Form.CloseForm()
		end if
	
	'20170418 LES START - 미지정단말 인증서 발급 프로세스 변경
	elseif sKeyName == "mhetc90060_p14" then
		Form.OpenFramePopup( G_CERT_ADD_FILE02 , g_sRevData&"_otp", "" )		
	'20170418 LES END
	
'20201119 SWJ START
	'개인고객 본인확인 단계이후 절차진행
	elseif sKeyName == "mhetc90060_opt_success" then
		
		if sRet == "ok" then
			'인증서 발급/재발급
			if g_sRevData == "new" Then
				DATAMANAGER.RequestTranData("obpds_srvc_173r")
		
			else
				g_nStepIndex = g_nStepIndex+1
				SetControlChange()
			end if
		end if
		
	'개인고객 휴대폰본인인증 단계
	elseif sKeyName == "mhetc90060_ph" then
		Form.OpenFramePopup("mhetc90060_ph","","")
		
	'개인고객 휴대폰본인인증 성공 후 본인확인 단계
	elseif sKeyName == "mhetc90060_opt" then
		Form.OpenFramePopup("mhetc90060_opt","","")
'20201119 SWJ END

	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG_MSG" then
		if sRet == "ok" then
			Form.OpenScreen( "86010" , "" ) '단말등록화면이동
		end if
	end if
	
	'20201022 SWJ START : 사고계좌 인증서 발급 제한
	if sKeyName == "ACCI_MSG" then
		Form.CloseForm()
	end if
	'20201022 SWJ END
	
End Sub

'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	if sType == "RetCertFileNew" then
		if sParam1 == "Success" then
			'20171026_HAMWG START: 인증서발급 FDS 로깅추가
			sUserID = Form.GetSharedData("CERT_ID" , false)
			Form.sendHWInformation("003", sUserID)
			'20171026_HAMWG END
			DATAMANAGER.RequestTranData( "obcsb_padc_002a" ) '발급SMS전송
		else
			Form.MsgBox( "알림", sParam2, "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sDeviceID, sACNO, sACNO_PWD, sUserID, sRCNO, sUserName
	
	sDeviceID = Form.GetDeviceID()
	sACNO = Form.GetSharedData("CERT_ACNO" , false)
	sACNO_PWD = Form.GetSharedData("CERT_ACNT_PWD" , false)
	sUserID = Form.GetSharedData("CERT_ID" , false)
	sUserName = Form.GetSharedData("CERT_USER_NAME" , false)
	sRCNO = Form.GetSharedData("CERT_RCNO" , false)
	
	if szTranID == "obcsb_oimf_625r" then	
		DATAMANAGER.SetUserID( sUserID ) '20160620 KBC 추가 : 발급(170a)와 동일하게 등록도 헤더에 값 지정해준다.
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		
	elseif szTranID == "obpds_srvc_405a" then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_405a", "InBlock1", "PROS_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_405a", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_405a", "InBlock1", "ELFN_ID" , 0 , sUserID )
	
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD" , 0 ,sACNO_PWD  )
		
	elseif szTranID == "obcpp_pcrt_173a" then
		DATAMANAGER.SetUserID( sUserID ) '20160519_01 KBC 추가 : 발급(170a)와 동일하게 등록도 헤더에 값 지정해준다.
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "USER_ID" , 0 , sUserID )
		
		'20201116 SWJ START : 실명확인번호 암호화 (RCNO > RCNO_PIP로 변경/고유MTS에는 미적용)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "RCNO" , 0 , sRCNO )
		else
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "CRPT_YN"  , 0 , "Y"   )
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "RCNO_PIP" , 0 , g_sAsctRcno )	'20231211 SWJ
		end if
		'20201116 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "USER_NAME" , 0 , sUserName )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_173a", "InBlock1", "CSNO" , 0 , LabelCSNO.caption )
		
	'20201021 SWJ START : 고객연락처 추가
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD"  , 0 , sACNO_PWD )
	'20201021 SWJ END
	
	elseif szTranID == "obcpp_pcrt_170a" then
		DATAMANAGER.SetUserID( sUserID )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "USER_ID" , 0 , sUserID )
		
		'20201116 SWJ START : 실명확인번호 암호화 (RCNO > RCNO_PIP로 변경)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "RCNO"     , 0 , sRCNO )
		else
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "CRPT_YN"  , 0 , "Y"   )
			DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "RCNO_PIP" , 0 ,  g_sAsctRcno )	'20231211 SWJ
		end if
		'20201116 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "USER_NAME" , 0 , sUserName )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "CSNO" , 0 , LabelCSNO.caption )
		
		'20201021 SWJ START : 고객 연락처 추가
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "EMAIL_INFO"      , 0 , sEmail )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "TELNO_INFO"      , 0 , sTeNo )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "CRAL_TELNO_INFO" , 0 , sCellNo )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "ADDR_INFO"       , 0 , sAddR )
		'20201021 SWJ END
		
		'=================================================================
		'20231113 LES START : 외국인투자자 등록제도 폐지
		'=================================================================
		'
		'-----------------------------------------------------------------
		'(내국인/외국인 구분) g_sNFTR =>  내국인 = 1,4 / 외국인 = 2,3,9
		'(개인/법인 구분)	    sCONO   =>  개인 = 1 / 법인 = 2
		'-----------------------------------------------------------------
		'발급/재발급 시, 인증서 유형을 채워야함. 
		'00 : N/A or Legacy  / 01: 국내 개인 / 02 : 국내법인 / 03: 해외개인 / 04 : 해외법인
		'-----------------------------------------------------------------
		sCertType = "00"
		
		if g_sNFTR == "1" or g_sNFTR == "4" then
		
			'국내개인
			if sCONO == "1" then
				sCertType = "01"
			'국내법인
			elseif sCONO == "2" then
				sCertType = "02"
			end if
			
		
		elseif g_sNFTR == "2" or g_sNFTR == "3" or g_sNFTR == "9" then
		
			'해외개인
			if sCONO == "1" then
				sCertType = "03"
			'해외법인
			elseif sCONO == "2" then
				sCertType = "04"
			end if
		
		end if
		
		'20240117 LES START
		'해외개인(03)일 경우 efif_011r에서 내려받은 조합주민번호와 실명확인번호가
		'동일한 경우 조합주민번호가 정상적으로 추출되지 않은 경우임. 이런 경우 
		'해외개인일 경우라도 인증서 발급유형을 "01"로 올리도록 수정.
		'참고) 조합주민번호가 정상적으로 추출될 경우 => 실명확인번호와 조합주민번호가 다름.
		if sCertType == "03" then
			
			if g_sAsctRcno == g_sRcnoPip then
				sCertType = "01"
			end if
		
		end if
		'20240117 LES END
		
		DATAMANAGER.SetDataValue(0, "obcpp_pcrt_170a", "InBlock1", "FID_UNIN_NTAT_TYPE" , 0 , sCertType)
		'20231113 LES END
	
	'20231211 SWJ START : 외국인투자자 등록제도 폐지
	elseif szTranID == "obcsb_efif_011r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_011r", "InBlock1", "RCNO_PIP" , 0 , sRCNO )
	'20231211 SWJ END
	
	elseif szTranID == "obcsb_padc_002a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_padc_002a", "InBlock1", "ELFN_ID" , 0 , sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_padc_002a", "InBlock1", "UI_ISNC_CLS_CODE" , 0 , "1" )
		
	elseif szTranID == "obcpp_logn_003a" then
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_003a", "InBlock1", "USER_ID" , 0 , sUserID )
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_003a", "InBlock1", "PBCR_PWD_MSTK_TMNU" , 0 , "0007" ) '20160527_02 KBC : 인증서 비밀번호오류횟수초기화 "0" -> "0007"로 수정
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_003a", "InBlock1", "SUCS_YN" , 0 , "Y" )
		
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , sUserID )
'		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID() )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "100" ) '인증서신규
	
'20160923_01 LKM START
	elseif szTranID == "obpds_srvc_173r" then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r", "InBlock1", "SVCD"	  , 0 ,"073" )		'서비스 코드
'21060923_01 LKM END


'20201022 SWJ START : 사고계좌 여부 확인	
	elseif szTranID == "obpds_srvc_173r_1" then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "SVCD"	  , 0 ,"ZZZ" )		'서비스 코드
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "CSNO"	  , 0 , sCsno)		'고객번호
'20201022 SWJ END

'20201119 SWJ START : 인증서 프로세스 변경 및 개선 (개인고객 법인고객 구분)
	elseif szTranID == "obcsb_acif_000r_1" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r_1", "InBlock1", "ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r_1", "InBlock1", "ACNT_PWD" , 0 , sACNO_PWD )
'20201119 SWJ END

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN 
'		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'16-04-11 YCJ 
'		if sSPLM_ATHN_NCSR_YN == "Y" then '추가인증필요
'			Form.OpenFramePopup( G_CERT_ADD_FILE , g_sRevData , "" )
'		else
			SetSecurityOpen()
'		end if


		'16-04-02 YCJ 서비스 TR 변경으로 내용 이동
'	elseif szTranID == "obpds_srvc_405a" then
'		Dim sIF_TR_CLS_CODE
'		sIF_TR_CLS_CODE = DATAMANAGER.GetDataValue( 0, "obpds_srvc_405a", "OutBlock1", "IF_TR_CLS_CODE" , 0 )
'	
'		if sIF_TR_CLS_CODE == "2" then
'			Dim sText
'			sText = "고객님께서는 [단말기지정]서비스 고객이므로 지정단말에서만 인증서 발급/재발급이 가능합니다.\n"..
'					"단말기를 등록하시겠습니까?"
'			Form.MsgBox( "알림", sText, "REG_MSG", 1 )
'		else
'			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
'		end if

	elseif szTranID == "obcsb_acif_000r" then
		
		if g_sRevData == "new" then
			
			'20201021 SWJ START : 고객 연락처 정보 추가
			'DATAMANAGER.RequestTranData( "obcpp_pcrt_170a" ) '인증서발급
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
			'20201021 SWJ END
			
		elseif g_sRevData == "regi" then
			DATAMANAGER.RequestTranData( "obcpp_pcrt_173a" ) '타기관등록
		end if
		
	'20201021 SWJ START : 고객 연락처 정보 추가
	elseif szTranID == "obcsb_acad_002r" then
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "01" then '자택주소
					sPost  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST", i )
					sDtad  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD", i )
					
					sAddR   = sPost.." "..sDtad
				elseif sINAG_TYPE_CODE == "21" then 'E-mail
					sEmail = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )
				end if
			next
		end if
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "11" then '자택전화번호
					
					sArCd  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sToNo  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTelNo = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					sTeNo   = sArCd..sToNo..sTelNo
				elseif sINAG_TYPE_CODE == "13" then '휴대폰번호
					
					sArCd2  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sToNo2  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTelNo2 = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					sCellNo = sArCd2..sToNo2..sTelNo2
				end if
			next
		end if		
		
		DATAMANAGER.RequestTranData("obcpp_pcrt_170a") '고객연락처추가로 인한 서비스 순서 변경(obcsb_acad_002r -> obcpp_pcrt_170a)
	'20201021 SWJ END
	
	'20231211 SWJ START
	elseif szTranID == "obcsb_efif_011r" then
		g_sAsctRcno = DATAMANAGER.GetDataValue( 0, "obcsb_efif_011r", "OutBlock1", "ASCT_PSPR_NO_PIP", 0 )
		
		'20240117 LES START
		g_sRcnoPip = DATAMANAGER.GetDataValue(0, "obcsb_efif_011r", "OutBlock1", "RCNO_PIP" , 0)
		'20240117 LES END
		
	'20231211 SWJ END
	
	elseif szTranID == "obcpp_pcrt_173a" then
		DATAMANAGER.RequestTranData( "obcpp_logn_003a" ) '인증접속로그
		
	elseif szTranID == "obcpp_pcrt_170a" then
		Dim sCertPW, sRefNo, sAuthCode
		sCertPW = Form.GetSharedData("CERT_NEW", false)	
		sRefNo = DATAMANAGER.GetDataValue( 0, "obcpp_pcrt_170a", "OutBlock1", "NTAT_REF_NO" , 0 )
		sAuthCode = DATAMANAGER.GetDataValue( 0, "obcpp_pcrt_170a", "OutBlock1", "NTAT_ATHZ_NO" , 0 )
		Form.RequestCertCommand( "ReqCertFileNew", sRefNo.."^SEPARATOR^"..sAuthCode, sCertPW )	
		
	elseif szTranID == "obcsb_padc_002a" then
		DATAMANAGER.RequestTranData( "obcpp_logn_003a" ) '인증접속로그
		
	elseif szTranID == "obcpp_logn_003a" then	
		Form.SendReturnToParent( "mhetc90060_p7" , g_sRevData )
		Form.CloseForm( )
		
	elseif szTranID == "obcsb_oimf_638r" then	'단말기 지정여부 팝업 오픈
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0) == "Y" then
			Dim sText
			'sText = "고객님께서는 [단말기지정]서비스 고객이므로 지정단말에서만 인증서 발급/재발급이 가능합니다.\n"..
			'		"단말기를 등록하시겠습니까?"
			'Form.MsgBox( "알림", sText, "REG_MSG", 1 )
			
			'20170418 LES START - 미지정단말 인증서 발급 프로세스 변경
			Form.OpenPopup("mhetc90060_p14",g_sRevData,"")
			'20170418 LES END
					
		else
			if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0) == "Y" then
			'	Form.OpenFramePopup( G_CERT_ADD_FILE , g_sRevData , "" )			
				Form.OpenFramePopup( G_CERT_ADD_FILE02 , g_sRevData , "" )	'20160502 NOHES : 인증서 발급/재발급 시 풀팝업2 
			else
				'20201119 SWJ START : 보안매체별 화면 오픈 구분값(개인고객/법인고객)
				DATAMANAGER.RequestTranData("obcsb_acif_000r_1")
				'DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
				'20201119 SWJ END
			end if
		end if
		
		DATAMANAGER.RequestTranData("obcsb_efif_011r") '20231211 SWJ START
		
'20160923_01 LKM START
	'인증서 온라인 신원확인 사전동의 조회 
	elseif szTranID == "obpds_srvc_173r" then
		
		sCsno = DATAMANAGER.GetDataValue( 0, "obpds_srvc_173r", "OutBlock2", "CSNO" , 0 )

		'약정(고객번호 있으면 약정으로 판단)
		if sCsno ~= null and Trim(sCsno) ~= "" then
			
			sAgrmYN = DATAMANAGER.GetDataValue( 0, "obpds_srvc_173r", "OutBlock1", "AGRM_YN" , 0 )
			
			'동의
			if sAgrmYN == "Y" Then
			
			'20201022 SWJ START : 사고계좌 여부 확인
				DATAMANAGER.RequestTranData("obpds_srvc_173r_1")
				'g_nStepIndex = g_nStepIndex+1
				'SetControlChange()
			'20201022 SWJ END
			
			'미동의 - 진행불가 
			else
				Form.OpenPopup("mhetc90060_p12","","")
			end if
	    
	    '미약정 	
		else	
			'본인확인 스텝 
			if g_nStepIndex == 0 then
		
				g_nStepIndex = g_nStepIndex+1
				SetControlChange()
					
			else			
				' 인증서 발급시 온라인 신원확인 사전동의 진행
				Form.OpenPopup("mhetc90060_p13","","")
			end if
			
		end if
'20160923_01 LKM END	
	
	'20201022 SWJ START : 사고계좌 여부 확인 절차 추가
	elseif szTranID == "obpds_srvc_173r_1" then
		Dim sAgrmYN2
		
		sAgrmYN2 = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_173r_1", "OutBlock1", "AGRM_YN" , 0)
		
		if sAgrmYN2 == "N" then
			g_nStepIndex = g_nStepIndex+1
			SetControlChange()
		else
			sText = "사고의심계좌로 등록된 계좌는 인증서 발급/재발급 진행이 불가합니다."
			Form.MsgBox("알림", sText, "ACCI_MSG", 1)
		end if
	'20201022 SWJ END	
	
	'20201119 SWJ START : 인증서 발급 프로세스 변경(개인고객에 한해 휴대폰 본인인증 단계 선택 가능)
	elseif szTranID == "obcsb_acif_000r_1" then
	
		'20210118 SWJ START : 개인/법인 구분방식 변경
		'1:개인 / 2:법인
		sCONO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r_1", "OutBlock1", "CUST_CLS_CODE" , 0 ) 
		
		'=================================================================
		'20231113 LES START
		'=================================================================
		'내국인/외국인 구분코드 
		'1:내국인 / 2:외국인 / 3:내국민대우외국인 / 4:재외국민 / 9:기타사업소득외국인
		'내국인 = 1,4 , 외국인 = 2,3,9
		g_sNFTR = DATAMANAGER.GetDataValue(0, "obcsb_acif_000r_1", "OutBlock1", "NTFR_CLS_CODE" , 0)
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
		
	'20201119 SWJ END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obpds_srvc_405a" then
		Form.MsgBox( "알림", "전자금융사기예방 고객정보 조회가 실패했습니다.", "", 6 )
	elseif szTranID == "obcpp_pcrt_173a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obcpp_pcrt_170a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obcsb_padc_002a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obcpp_logn_003a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
'20160923_01 LKM START
	elseif szTranID == "obpds_srvc_173r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
'20160923_01 LKM END	
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================


'============================================================================
Sub ButtonOK_OnClick()
	if g_sRevData == "new" then
		if g_nStepIndex < 5 then
			Form.triggerEvent( "LinkForm0", "NextCheck", "" )	
		end if
	elseif g_sRevData == "regi" then
		if g_nStepIndex < 2 then
			Form.triggerEvent( "LinkForm0", "NextCheck", "" )	
		elseif g_nStepIndex == 2 then 
			Form.MsgBox( "알림", "타기관 등록할 인증서를 선택해주세요.", "", 6 ) '20201126 SWJ : 공인 글자 삭제
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("CERT_ID" , "")
	Form.SetSharedData("CERT_RCNO" , "")
	Form.SetSharedData("CERT_ACNO" , "")
	Form.SetSharedData("CERT_ACNT_PWD" , "")
	Form.SetSharedData("CERT_USER_NAME" , "")
	Form.SetSharedData("CERT_NEW", "")	
	Form.SetSharedData("CERT_DN" , "")
	Form.SetSharedData("CERT_INDEX" , "")
End Sub

'============================================================================
'20210707 SWJ START
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
Sub Form_OnTriggerEventMOTP(sEventName, sParam)

	if sEventName == "MOTP_GETINFO_RETURN_90060" then

		g_mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		if Ubound(g_mOTPInfo) < 1 then
			exit sub
		else	
			if g_mOTPInfo(0) <> "00000" then					
				g_PhoneAuth = True 		'True이면 휴대폰인증으로 바로 가도록
			else
				g_PhoneAuth = False
			end if
		end if
	end if
End Sub

