'20240219 SWJ START
'============================================================================
Sub RegisterOTP()
	szAcno = Form.GetSharedData("CERT_ACNO" , false)
	
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenNextPopup("mhetc90190_p1", szAcno &"★"& "" &"★"& "N" &"★"& "", "")
End Sub
