'--===========================================================================
' 01. 화 면 명 : 금융거래 정보제공 동의(CFD 거래)
' 02. 화면설명 : 금융거래 정보제공 동의(CFD 거래)
' 03. 작    성 : 2022.01.03 김수진
' 04. 수    정 : 
'   2022.12.15 : 양현정 : v001 : 서버분기처리
'   2023.08.30 : 전상일 : v002 : 문구변경
'   2023.10.20 : 전상일 : v003 : 서버분기처리 3-> 0
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szCustClsCode	'고객구분코드 
Dim g_ServerMode		'v0001 서버확인
Dim g_bInputMail

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )
	
	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	

'===========================================================================
' f_ValidCkeck()() : 유효성 검사
'===========================================================================
Function f_ValidCkeck()
	If btnOK.caption == "동의" Then 'v002 등록-> 동의
		If chkView0.chksilence == "0" Then
			Form.MsgBox( "알림", "금융거래 정보제공 동의서에 동의하셔야 합니다.", "", 6 )	
			return false
		End If
		
		'2023.01.05 chkView1 개인/법인 둘 다 체크
'		If g_szCustClsCode == "1" Then
			If chkView1.chksilence == "0" Then
				Form.MsgBox( "알림", "금융거래 정보제공 동의를 확인하여 주십시오.", "", 6 )	
				return false
			End If
'		End If
	End If
End Function	

'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	tblState.SetCellString( 0, 1, "" )
	chkView0.chksilence = "0"
	chkView1.chksilence = "0"
	g_bInputMail = false
	edtMail.caption = ""
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	f_ClearData()
	edtPswd.caption = ""
	g_szCustClsCode = ""
	btnOK.caption = "동의" 'v002
	
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
	
	'타이틀이 너무 길어서 추가해달라고 함.
	Form.SetTitleCaption("금융거래정보이용제공동의(장외파생거래)")
	
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)	'v001
	
	g_bInputMail = false
	
	'고객정보조회
	DATAMANAGER.RequestTranData("obcsb_acif_000r")	
End Sub
'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	edtPswd.caption = ""
	g_szCustClsCode = ""
	btnOK.caption = "동의" 'v002
	
	'고객정보조회
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
End Sub

'============================================================================
' acntList_ChangeAccount() : 다른 계좌로 변경 되었을때 초기화
'============================================================================
Sub acntList_ChangeAccount()
	f_ClearData()
	edtPswd.caption = "" 
	g_szCustClsCode = ""
	btnOK.caption = "동의" 'v002
	
	'고객정보조회
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
End Sub
'============================================================================
' edtPswd_OnEditComplete() : 비밀번호 입력완료시 초기화 및 등록내역 조회
'============================================================================
Sub edtPswd_OnEditComplete()
	f_ClearData()
	
    '금융거래 정보제공 동의내역조회
	DATAMANAGER.RequestTranData("obcsb_acif_077r")	
End Sub

'============================================================================
' BtnOK_OnClick() : 신청
'============================================================================
Sub btnOK_OnClick()
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	'동의확인체크
	If f_ValidCkeck() == false Then
		Exit Sub
	End If
	
	'이메일체크(등록할때만 체크)
	If btnOK.caption == "동의" Then 'v002
		If edtMail.caption == "" Or edtMail.caption == null Then
			Form.ShowAlert("알림", "제공내역 통보를 위해 이메일을 입력 바랍니다.")
			Exit Sub
		End If
	End If
	
    '금융거래정보제공 동의/거부내역 등록
	DATAMANAGER.RequestTranData("obcsb_acif_078a")
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbonl82020_p6" Then
		If sRet == "금융거래 정보제공 동의서" Then
			chkView0.chksilence = "1"
		End If
	End If
End Sub

'============================================================================
' chkView0_OnChange() : 금융거래 정보제공 동의서
'============================================================================
Sub chkView0_OnChange(sCheckState)
	If f_GetPWCkeck() Then
		chkView0.chksilence = "0"
		Exit Sub
	End if
	
	If sCheckState == "1" Then
		chkView0.chksilence = "0"
		
		Dim szURL 
		If g_ServerMode == "1" Then	'v001 운영  v003 : 서버분기처리 3-> 0
			szURL = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf"
		else
			szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf"
		end if
		
		Form.SetSharedData("OPEN_URL", szURL )
		Form.OpenFramePopup("mbonl82020_p6" , "금융거래 정보제공 동의서" , "") 
	End If
End Sub
'============================================================================
' btnView0_OnClick() : 금융거래 정보제공 동의서
'============================================================================
Sub btnView0_OnClick()
	If f_GetPWCkeck() Then
		chkView0.chksilence = "0"
		Exit Sub
	End if

	Dim szURL 
	If g_ServerMode == "1" Then	'v001 운영  v003 : 서버분기처리 3-> 0
		szURL = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf"
	else
		szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf"
	end if
	
	Form.SetSharedData("OPEN_URL", szURL )
	Form.OpenFramePopup("mbonl82020_p6" , "금융거래 정보제공 동의서" , "") 
End Sub

'============================================================================
' btnChk1_OnClick(): 동의 체크 (개인고객일 경우만)
'============================================================================
Sub btnChk1_OnClick()
	If chkView1.chksilence = "0" Then
		chkView1.chksilence = "1"
	Else
		chkView1.chksilence = "0"
	End If
End Sub

'============================================================================
Sub edtMail_OnEditComplete()
	If Len(Trim(edtMail.caption)) > 0 Then
		Dim tSplit
		tSplit = Split(edtMail.caption, "@")
		If UBound(tSplit) > 0 Then
			If Str_Chk_Email(edtMail.caption, "EMAIL") == False then		
				Form.ShowAlert("알림", "이메일을 확인하세요.")
				edtMail.caption = ""
				
				Exit Sub
			End If
			
			Dim tCheck
			tCheck = Split(tSplit[1], ".")
			If tCheck[0] == "yahoo" Or tCheck[0] == "hotmail" Then
				Form.ShowAlert("알림", "야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.")
				edtMail.caption = ""
				
				Exit Sub
			End If
		Else
			Form.ShowAlert("알림", "이메일을 확인하세요.")
			edtMail.caption = ""
		End If
	End If
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Dim szACNT_PWD 
	If g_szPlain_rm == "1" Then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	Else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	End If
	
	'고객정보조회
	If szTranID == "obcsb_acif_000r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "I" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , szACNT_PWD )
	'금융거래 정보제공 동의내역조회
	ElseIf szTranID == "obcsb_acif_077r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , szACNT_PWD )
	'금융거래정보제공 동의/거부내역 등록
	ElseIf szTranID == "obcsb_acif_078a" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" 	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , szACNT_PWD )	
		If btnOK.caption = "동의" Then 'v002
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "1" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "2" )
		End If
	
	'고객연락처정보조회
	ElseIf szTranID == "obcsb_acad_002r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" 	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 	, 0 , szACNT_PWD )
	
	'법인계좌통보처정보조회
	ElseIf szTranID == "obaci_acct_095r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 	, 0 , szACNT_PWD )
	
	'고객연락처단건처리
	ElseIf szTranID == "obcsb_acad_123a" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" 	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "I" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "EMAIL_ADDR" 	, 0 , edtMail.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INAG_TYPE_CODE" 	, 0 , "21" )
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'고객정보조회
	If szTranID == "obcsb_acif_000r" Then
		g_szCustClsCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_CLS_CODE" , 0 )
		
		'2023.01.05 개인/법인 상관없이 체크박스 2개 전부 노출
'		If g_szCustClsCode == "1" Then
			chkView1.visible = true
			btnChk1.visible = true
'		Else
'			chkView1.visible = false
'			btnChk1.visible = false	
'			
'			'법인인 경우 중간 여백을 줄이기 위해 이메일 영역 위치 조정
'			Label1.top = 180
'			edtMail.top = 178
'		End If
		
	ElseIf szTranID == "obcsb_acif_077r" Then
		If DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ) > 0 Then
			Dim szAgrmValdYN
			szAgrmValdYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "AGRM_VALD_YN" , 0 )
			
			If szAgrmValdYN == "Y" Then
				tblState.SetCellString( 0, 1, "동의" )
				btnOK.caption = "거부"
			Else
				tblState.SetCellString( 0, 1, "미동의" )
				btnOK.caption = "동의" 'v002
			End If
		Else
			tblState.SetCellString( 0, 1, "미동의" )
			btnOK.caption = "동의" 'v002
		End If
		
		'이메일 조회
		If g_szCustClsCode == "1" Then
			'고객연락처정보조회
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
		Else
			'법인계좌통보처정보조회
			DATAMANAGER.RequestTranData( "obaci_acct_095r" )
		End If
		
	'금융거래정보제공 동의/거부내역 등록
	ElseIf szTranID == "obcsb_acif_078a" Then
		Dim szMsg, szSubMsg
		szMsg = DATAMANAGER.GetDataMsgText( szTranID )
		szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		If szSubMsg ~= null and Trim(szSubMsg) ~= "" Then
			szMsg = szSubMsg.." "..szMsg
		end if
		Form.ShowAlert("알림", szMsg)
		
		'obcsb_acad_002r 또는 obaci_acct_095r 에서 조회된 이메일이 없어 직접 입력해서 진행하는 경우
		'obcsb_acad_123a 를 호출
		
		'고객연락처단건처리
		If g_bInputMail Then
			DATAMANAGER.RequestTranData( "obcsb_acad_123a" )
		Else
			f_ClearData()
		    '금융거래 정보제공 동의내역조회
			DATAMANAGER.RequestTranData("obcsb_acif_077r")
		End If
		
		
	'고객연락처정보조회
	ElseIf szTranID == "obcsb_acad_002r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		If CInt(nCnt) > 0 Then
			Dim szEmail
			For i = 0 To nCnt - 1 
				szEmail = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "EMAIL_ADDR" , i)
				If szEmail <> "" And szEmail <> null Then
					edtMail.caption = szEmail
					edtMail.enable = false
					Exit For
				End If
			Next
			
			If edtMail.caption == "" Or edtMail.caption == null Then
				'이미 사용가능 상태이지만 확인 겸 처리
				edtMail.caption = ""
				edtMail.enable = true
				
				g_bInputMail = true
			End If
		End If
		
	'법인계좌통보처정보조회
	ElseIf szTranID == "obaci_acct_095r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
		If CInt(nCnt) > 0 Then
			Dim szEmail, szInagType
			For i = 0 To nCnt - 1 
				szInagType = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "INAG_TYPE_CODE" , i)
				szEmail = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_ADDR" , i)
				If szInagType == "21" Then
					If szEmail <> "" And szEmail <> null Then
						edtMail.caption = szEmail
						edtMail.enable = false
						Exit For
					End If
				End If
			Next
			If edtMail.caption == "" Or edtMail.caption == null Then
				'이미 사용가능 상태이지만 확인 겸 처리
				edtMail.caption = ""
				edtMail.enable = true
				
				g_bInputMail = true
			End If
		End If
	
	'고객연락처단건처리
	ElseIf szTranID == "obcsb_acad_123a" Then
		f_ClearData()
	    '금융거래 정보제공 동의내역조회
		DATAMANAGER.RequestTranData("obcsb_acif_077r")
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	If szTranID == "obcsb_acif_078a" Then
		Form.ShowAlert( "알림", szErrMsg )
	End if
End Sub

'============================================================================
' 이메일-한글체크 v0006
'============================================================================
Function Str_Chk_Email(str, sGubn)
	dim i				'루프용 
	dim chk_n, chk_c, chk_t
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
	
	return True
End Function




