		' + 버튼 클릭 /////////////////////////////
		if nGbn = 0 then		
'			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
'				szPrc = szHigh
'			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
'				szPrc = szLow
'			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
'			end if
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn = 1 then						
'			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
'				szPrc = szHigh		
'			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
'				szPrc = szLow
'			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
'			end if
		end if
		' 20230127_01 HWG END
	end if
	
'	szPrc = Set_Unit(szPrc)
'
'	if g_szMk == "O" or g_szMk == "MO" then
'		szRight = CInt(Right(szPrc, 1))	
'			
'		' + 버튼 클릭 /////////////////////////////
'		if nGbn == 0 then		
'			if CDbl(szPrc) > 10 then
'				if szRight > 5 and szRight < 10 then
'					szCalc = szRight - 5
'					szPrc = CDbl(szPrc) - CDbl("0.0" & szCalc)
'				elseif szRight > 0 and szRight < 5 then
'					szPrc = szPrc - CDbl("0.0" & szRight)					
'				end if
'			end if
'		else
'			if CDbl(szOld) > 10 then
'				if szRight > 5 and szRight < 10 then
'					szCalc = 10 - szRight
'					szPrc = szPrc + CDbl("0.0" & szCalc)
'				elseif szRight > 0 and szRight < 5 then
'					szCalc = 5 - szRight
'					szPrc = szPrc + CDbl("0.0" & szCalc)	
'				end if
'			end if 
'		end if
'		
'		szPrc = Set_Unit(szPrc)
'	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData)
	Dim szChk
	
	szChk = InStr(CStr(szData), ".")
	
	if CStr(szChk) == "0" then
		return szData & ".00"
	else
		szCha = CInt(Len(szData) - szChk)
		
		if CStr(szCha) == "1" then 
			return szData & "0"
		end if
	end if
	
	return szData
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CInt(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CInt(szQty) + nUnit
		elseif nGbn == 1 then
			if CInt(szQty) == 0 then
				Exit Function
			else
				szQty = CInt(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "♥")		

	if UBound(tData) > 0 then
		' 메인화면에서 종목변경에 따른 구분자를 넣어준것
		if tData(5) == "1" then
			g_bCntrtRtn = true
		else
			g_bCntrtRtn = false
		end if

		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", tData(0))
		end if
		
		edtOrgNo.caption = tData(0)						' 주문번호	
		g_szQty = ""
		
		' 수량
		if chkAll.checkstate == "1" then
			edtQty.caption = ""						
			g_szQty = tData(1)
		else
			edtQty.caption = tData(1)
			g_szQty = tData(1)
		end if
		
		' 호가유형코드 선택
		Return_OrdType(tData(2), tData(4))
		
		if tData(2) == "2" or tData(2) =="I" then
			' 주문가격
			edtPrc.caption = tData(3)
			edtPrc_OnEditComplete()
		end if
	end if
End Function

'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
'============================================================================
' Return_OrderAbleCd
'============================================================================
Function Return_OrderAbleCd(szCd) 
	szReturn = "0"
	
	szMkType = Form.GetItemCodeInfo(szCd, "innermarket")
	
	if szMkType = "054" or szMkType = "055" then
		if szCd <> null and szCd <> "" and Len(szCd) > 3 then
			szCdType = mid(szCd, 2, 2)
			
			if szCdType = "78" then
				szReturn = "1"
			end if
		end if
	end if
	
	return szReturn
End Function
'20240111 HWG END


