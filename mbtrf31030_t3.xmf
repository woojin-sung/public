Sub btnMkMod_OnClick()
	g_bBtnMkClk = true
	
	Check_InputData(1)
End Sub

'============================================================================
' btnMod_OnClick : 정정버튼 클릭
'============================================================================
Sub btnMod_OnClick()
	g_bBtnMkClk = false
	
	Check_InputData(0)
End Sub

'============================================================================
' btnMiche_OnClick : 미체결버튼 클릭
'============================================================================
Sub btnMiche_OnClick()
	Form.triggerEvent("#", "31030_CONTRACT_OPEN", "")
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' btnPPlus_OnClick : 가격 + 버튼
'============================================================================
Sub btnPPlus_OnClick()
	Calc_Price(0)

End Sub

'============================================================================
' btnPMinus_OnClick : 가격 - 버튼
'============================================================================
Sub btnPMinus_OnClick()
	Calc_Price(1)
End Sub

'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAll_OnChange(sCheckState)
	if sCheckState == "1" then
		edtQty.caption = ""	
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		edtQty.caption = g_szQty	
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

'============================================================================
' edtPrc_OnEditComplete
'============================================================================
Sub edtPrc_OnEditComplete()
	Form.SetCtlProp("#lblPrc", "caption", edtPrc.caption)
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	Form.OpenPopup("mbtrf31030_p1", edtQty.caption, "")
End Sub

'============================================================================
' btnPrc_OnClick
'============================================================================
Sub btnPrc_OnClick()
	Dim szUnit, szPrc, szChk

	if Trim(edtPrc.caption) == "" then
		szPrc = ""
	else
		szChk = InStr(CStr(edtPrc.caption), ".")
	
		if CStr(szChk) == "0" then
			szPrc = edtPrc.caption & ".00"	
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == "1" then 
				szPrc = edtPrc.caption & "0"	
			else
				szPrc = edtPrc.caption
			end if
		end if
	end if
	
	szUnit = Form.GetCtlProp("#lblUnit", "caption")
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	
	Form.OpenPopup("mbtrf31030_p2" , szPrc & "★" & g_szCd & "★" & g_szMk & "★" & cmbType.currentindex & "★" & szHigh & "★" & szLow, "")
End Sub

