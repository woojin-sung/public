							<SUBCOLINFO ly_vert_width="100" ly_vert_visible="2" />
							<BODY rowcount="1" impblkcnt="1" realblkcnt="1" >
								<ROWINFO ly_vert_height="39" />
								<CELLINFO>
									<CELL name="itemcode" cell_ly="0,0,0,0" line="0,1" import="2,1,12" realrec="5,1,0" >
										<STATECOMP_INFO desttype="1" />
									</CELL>
