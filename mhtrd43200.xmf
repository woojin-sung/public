							<BODY rowcount="1" impblkcnt="1" realblkcnt="1" >
								<ROWINFO ly_vert_height="39" />
								<CELLINFO>
									<CELL name="vol" cell_ly="0,0,0,0" line="0,1" import="2,1,21" realrec="5,1,11" >
										<STATECOMP_INFO desttype="1" />
									</CELL>
								</CELLINFO>
							</BODY>
						</COLUMN>
						<COLUMN colcount="1" >
							<SUBCOLINFO ly_vert_width="100" ly_vert_visible="2" />
							<BODY rowcount="1" impblkcnt="1" realblkcnt="1" >
								<ROWINFO ly_vert_height="39" />
								<CELLINFO>
									<CELL name="atm" cell_ly="0,0,0,0" line="0,1" import="2,1,1" realrec="5,1,-1" >
										<STATECOMP_INFO desttype="1" />
									</CELL>
								</CELLINFO>
							</BODY>
