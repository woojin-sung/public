	<SCRIPT_INFO _len="14416" _ulen="13616" >
--===========================================================================
--===========================================================================

Dim g_szItemCode '종목코드
Dim g_szExchName '거래소명
Dim g_szBaseItemCode '기초자산 종목코드

'============================================================================
Sub Form_OnFormInitBefore()
	Form.SetSearchType ("17") '해외파생 옵션 종목검색 타입셋팅
	ChartEx0.SetChartType("line")
	ChartEx0.SetPeriodType("1")
	ChartEx0.SetPeriodTime("5")
End Sub

'============================================================================
Sub Form_OnFormInit()
	' 아이폰에서만 사용. 스크롤을 멈추게 한다.
'	contCP.grdAllC.scrollenable = "0"
'	contCP.grdAllP.scrollenable = "0"
'	Form.SetTitleCaption("해외옵션 종합시세")
	
	g_szItemCode = Form.GetSharedData("&ITEM_GLOBAL_OPTION_MONTH", 0)	 ' 최근조회종목
	
	if g_szItemCode <> "" then
		g_szBaseItemCode = ""
		g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
		if g_szExchName <> nil and g_szExchName <> "" then
			Form.SetItemCode(g_szItemCode) '상단헤더에 종목코드 셋팅
			DATAMANAGER.RequestTranData( "ohhts_6522_002r" ) '기초자산 현재가 조회
			DATAMANAGER.RequestTranData( "ohhts_6522_003r" ) '월물조회
		end if
	end if
	
	f_CPRequest() '옵션종합시세 조회
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_6522_002r" then '기초자산 현재가 조회
		DATAMANAGER.SetDataValue( false, "ohhts_6522_002r", "InBlock1", "FID_OVDV_QTTN_EXCH_NAME", 0 , g_szExchName ) '거래소명
		DATAMANAGER.SetDataValue( false, "ohhts_6522_002r", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
		
	elseif szTranID = "ohhts_6522_001r" or szTranID = "ohhts_6522_001r_1" or szTranID = "ohhts_6522_001r_2" then '콜풋, 콜, 풋 조회
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , g_szExchName ) '거래소명
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
	
	elseif szTranID = "ohhts_6522_003r" then '월물조회
		DATAMANAGER.SetDataValue( false, "ohhts_6522_003r", "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , g_szExchName ) '거래소명
		DATAMANAGER.SetDataValue( false, "ohhts_6522_003r", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_6522_002r" then '기초자산 현재가 조회
		Dim szItemName, szBaseExchName
		
		g_szBaseItemCode = DATAMANAGER.GetDataValue( 0, "ohhts_6522_002r", "OutBlock1", "FID_OVDV_ISCD" , 0 ) '기초자산 코드
		szItemName = g_szBaseItemCode & " / " & Form.GetItemCodeInfo(g_szBaseItemCode, "name")
		szBaseExchName = Form.GetItemCodeInfo( g_szBaseItemCode , "exchname")
		lblItemName.caption = szItemName
		
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , szBaseExchName ) '거래소명
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szBaseItemCode ) '종목코드
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_JOB_CLS_CODE" , 0 , "1" ) '주기타입 0:틱, 1:분, 2:일, 3:주, 4:월
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_CNT" , 0 , "300" ) '조회개수
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_HOUR_CLS_CODE" , 0 , "5" ) 'N분, N틱 ~~ 
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" , 0 , "0" ) '당일조회여부 1:당일
		DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_PRC_CLS_CODE" , 0 , "0" ) '가격구분 0:정산가, 1:종가
		
		DATAMANAGER.RequestTranData( "ohhts_6509_001r" ) '차트 조회
		
	elseif szTranID = "ohhts_6509_001r" then
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf" ) '기초자산 현재가 실시간 조회
		
	elseif szTranID = "ohhts_6522_001r" then '콜풋 조회
		Dim nCount
		nCount = CInt(contAll.grdAllC.rowcount)
		
		if nCount > 0 then
			contAll.grdAllC.height = CInt(contAll.grdAllC.rowcount * 47.2)
			contAll.grdAllP.height = CInt(contAll.grdAllP.rowcount * 47.2)
			contAll.SetScrollAutoSize()
			
			Dim szAtm, nAtmRow
			nAtmRow = 0
			for i = 0 to nCount-1 step 1
				szAtm = contAll.grdAllC.GetCellData("atm", i) '1:ATM, 0:나머지
				
				if szAtm = "1" then
					contAll.grdAllC.SetCellBgColor( "acpr", i, "156:255253233" )
					nAtmRow = i
					exit for
				end if
			next
			
			if CInt(nAtmRow*47.2) < 177 then
				contAll.scroll_pos = 0
			elseif CInt((nCount-nAtmRow-1)*47.2) < 177 then
				contAll.scroll_pos = CInt(nAtmRow*47.2) - (401 - CInt((nCount-nAtmRow+1)*47.2))
			else
				contAll.scroll_pos = CInt(nAtmRow*47.2) - 177
			end if
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_1" ) '콜 실시간 조회
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_2" ) '풋 실시간 조회
		
	elseif szTranID = "ohhts_6522_001r_1" then '콜 조회
		Dim nCount
		nCount = CInt(contCP.grdC.rowcount)
		
		if nCount > 0 then
			contCP.grdC.height = contCP.grdC.rowheight
			contCP.SetScrollAutoSize()
			
			Dim szAtm, nAtmRow
			nAtmRow = 0
			for i = 0 to nCount-1 step 1
				szAtm = contCP.grdC.GetCellData("atm", i) '1:ATM, 0:나머지
				
				if szAtm = "1" then
					contCP.grdC.SetCellBgColor( "acpr", i, "156:255253233" )
					nAtmRow = i
					exit for
				end if
			next
			
			if nAtmRow*39 < 166 then
				contCP.scroll_pos = 0
			elseif (nCount-nAtmRow-1)*39 < 166 then
				contCP.scroll_pos = nAtmRow*39 - (372 - (nCount-nAtmRow+1)*39)
			else
				contCP.scroll_pos = nAtmRow*39 - 166
			end if
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_1" ) '콜 실시간 조회
		
	elseif szTranID = "ohhts_6522_001r_2" then '풋 조회
		Dim nCount
		nCount = CInt(contCP.grdP.rowcount)
		
		if nCount > 0 then
			contCP.grdP.height = contCP.grdP.rowheight
			contCP.SetScrollAutoSize()
			
			Dim szAtm, nAtmRow
			nAtmRow = 0
			for i = 0 to nCount-1 step 1
				szAtm = contCP.grdP.GetCellData("atm", i) '1:ATM, 0:나머지
				
				if szAtm = "1" then
					contCP.grdP.SetCellBgColor( "acpr", i, "156:255253233" )
					nAtmRow = i
					exit for
				end if
			next
			
			if nAtmRow*39 < 166 then
				contCP.scroll_pos = 0
			elseif (nCount-nAtmRow-1)*39 < 166 then
				contCP.scroll_pos = nAtmRow*39 - (372 - (nCount-nAtmRow+1)*39)
			else
				contCP.scroll_pos = nAtmRow*39 - 166
			end if
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_2" ) '풋 실시간 조회
		
	elseif szTranID = "ohhts_6522_003r" then '월물조회
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "ohhts_6522_003r", "OutBlock1" )
			
		if nCount > 0 then
			Dim szItemCode, szYYMM, nIndex
			nIndex = -1
			
			for i = 0 to nCount-1 step 1
				szItemCode = DATAMANAGER.GetDataValue( 0, "ohhts_6522_003r", "OutBlock1", "FID_OVDV_ISCD" , i )
				szYYMM = DATAMANAGER.GetDataValue( 0, "ohhts_6522_003r", "OutBlock1", "FID_MTRT_YYMM" , i )
				
				cmbYYMM.cbadddatatext = szItemCode.."`"..szYYMM '결제월콤보세팅
				
				if g_szItemCode = szItemCode then
					nIndex = i
				end if
			next
			
			if nIndex >= 0 then
				cmbYYMM.cbkeydata = g_szItemCode
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		if sValue <> "" then
			g_szItemCode = sValue
			g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
			cmbYYMM.clear = true
			
			g_szBaseItemCode = ""
			lblItemName.caption = ""
			lblPrc.caption = ""
			lblDebiSign.caption = ""
			lblDebi.caption = ""
			lblRate.caption = ""
			lblVol.caption = ""
			
			DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf" )
			DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf" )
			DATAMANAGER.ClearOutputData( 1, "ohhts_ovdv_cntf" )
			ChartEx0.SetDataClear()
			
			if g_szExchName <> nil and g_szExchName <> "" then
				DATAMANAGER.RequestTranData( "ohhts_6522_002r" ) '기초자산 현재가 조회
				DATAMANAGER.RequestTranData( "ohhts_6522_003r" ) '월물조회
			else
				Form.SetTitleCaption( "옵션종합" )
			end if
			
			f_CPRequest() '옵션종합시세 조회
		end if
	end if
End Sub

'============================================================================
Sub rdoCP_OnClick(nIndex)
	f_CPRequest() '옵션종합시세 조회
End Sub

'============================================================================
Sub cmbYYMM_OnEditComplete(iIndex)
	g_szItemCode = cmbYYMM.cbkeydata
	g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")

	if g_szExchName <> nil and g_szExchName <> "" then
		Form.SetItemCode(g_szItemCode) '상단헤더에 종목코드 셋팅
	end if
	
	f_CPRequest() '옵션종합시세 조회
End Sub

'============================================================================
' 옵션종합시세 조회
'============================================================================
Function f_CPRequest()
	f_SetClear() '옵션종합시세 초기화
	
	if tonumber(rdoCP.currentindex) = 0 then '콜풋
		tblAll.visible = true
		contAll.visible = true
		tblCP.visible = false
		contCP.visible = false
		if g_szItemCode <> "" then
			if g_szExchName <> nil and g_szExchName <> "" then
				DATAMANAGER.RequestTranData( "ohhts_6522_001r" ) '콜풋 조회
			end if
		end if
	elseif tonumber(rdoCP.currentindex) = 1 then '콜
		tblAll.visible = false
		contAll.visible = false
		tblCP.visible = true
		contCP.visible = true
		tblCP.SetCellString(0, 1, "콜옵션")
		tblCP.SetCellFgColor(0, 1, "1")
		if g_szItemCode <> "" then
			if g_szExchName <> nil and g_szExchName <> "" then
				DATAMANAGER.RequestTranData( "ohhts_6522_001r_1" ) '콜 조회
			end if
		end if
	elseif tonumber(rdoCP.currentindex) = 2 then '풋
		tblAll.visible = false
		contAll.visible = false
		tblCP.visible = true
		contCP.visible = true
		tblCP.SetCellString(0, 1, "풋옵션")
		tblCP.SetCellFgColor(0, 1, "2")
		if g_szItemCode <> "" then
			if g_szExchName <> nil and g_szExchName <> "" then
				DATAMANAGER.RequestTranData( "ohhts_6522_001r_2" ) '풋 조회
			end if
		end if
	end if
End Function

'============================================================================
' 옵션종합시세 초기화
'============================================================================
Function f_SetClear()
	DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_1" )
	DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_2" )
	
	DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf_1" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_ovdv_cntf_1" )
	DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf_2" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_ovdv_cntf_2" )
	
	contAll.grdAllC.rowcount = 0
	contAll.grdAllP.rowcount = 0
	contAll.grdAllC.height = 0
	contAll.grdAllP.height = 0
	contAll.grdAllC.SetClear()
	contAll.grdAllP.SetClear()
	tblCP.SetCellString(0, 1, "")
	contCP.grdC.rowcount = 0
	contCP.grdP.rowcount = 0
	contCP.grdC.height = 0
	contCP.grdP.height = 0
	contCP.grdC.SetClear()
	contCP.grdP.SetClear()
	
	contAll.SetScrollAutoSize()
	contCP.SetScrollAutoSize()
End Function

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_ovdv_cntf" then '기초자산 현재가 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szBaseItemCode )
		
	elseif szTranID = "ohhts_ovdv_cntf_1" then '콜 실시간 조회
		Dim nCount
		
		if tonumber(rdoCP.currentindex) = 0 then '콜풋
			nCount = tonumber(contAll.grdAllC.rowcount)
			for i = 0 to nCount-1 step 1
				Dim szItemCode
				szItemCode = contAll.grdAllC.GetCellData("itemcode", i)
				DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_1", "InBlock1", "FID_OVDV_ISCD" , i , szItemCode )
			next
			
		elseif tonumber(rdoCP.currentindex) = 1 then '콜
			nCount = tonumber(contCP.grdC.rowcount)
			for i = 0 to nCount-1 step 1
				Dim szItemCode
				szItemCode = contCP.grdC.GetCellData("itemcode", i)
				DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_1", "InBlock1", "FID_OVDV_ISCD" , i , szItemCode )
			next
			
		end if
		
	elseif szTranID = "ohhts_ovdv_cntf_2" then '풋 실시간 조회
		Dim nCount
		
		if tonumber(rdoCP.currentindex) = 0 then '콜풋
			nCount = tonumber(contAll.grdAllP.rowcount)
			for i = 0 to nCount-1 step 1
				Dim szItemCode
				szItemCode = contAll.grdAllP.GetCellData("itemcode", i)
				DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_2", "InBlock1", "FID_OVDV_ISCD" , i , szItemCode )
			next
			
		elseif tonumber(rdoCP.currentindex) = 2 then '풋
			nCount = tonumber(contCP.grdP.rowcount)
			for i = 0 to nCount-1 step 1
				Dim szItemCode
				szItemCode = contCP.grdP.GetCellData("itemcode", i)
				DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf_2", "InBlock1", "FID_OVDV_ISCD" , i , szItemCode )
			next
			
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "SCREEN_MENU" then '연결 리스트
		if sParam = "SHA_SNS" then ' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	g_nSNSType = Cint(sRet)
	If g_nSNSType = 2 Then
		Dim szScreenNo, szFileName
		szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
		szFileName = szScreenNo & "_ScreenShot.png"
		
		Form.SaveScreenShot( szFileName )		
		Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
	Else
		Form.triggerEvent("linkfmHoga", "sharedata", "")
	End If
End Sub

