	<SCRIPT_INFO _len="4799" _ulen="4420" >
'해외서비스신청_완료

'Dim g_sUserID
'Dim g_RcnoPip
Dim g_IDRegAcno
Dim g_szMotp
Dim g_sSecurity
Dim g_sPopupCloseYn
Dim g_Csno '고객번호

dim g_szJumun
g_szJumun = ""

'============================================================================
Sub Form_OnFormInit()
	Dim szData, szList
	szData = Form.GetOpenLinkData()	
	'szData = "87057" & "★" & "1234567890" & "★" & "3014989502" & "★" &  "talk" & "★" & "해외주식 거래신청이\n완료되었습니다.★J"
	'szData = "87057" & "★" & "1234567890" & "★" & "3014989502" & "★" &  "talk" & "★" & "해외주식 거래신청이\n완료되었습니다.★"
	'화면번호★고객번호★신청계좌★계약서류제공방식★완료문구★J
	'화면번호★고객번호★신청계좌★계약서류제공방식★완료문구★
  	if InStr(szData, "★") > 0 then
		szList = Split(szData, "★")
		If UBOUND(szList) < 1 then
			Exit Sub
		end if 
		lblTitle.caption = szList(4)
		g_Csno = szList(1)
		Table0.SetCellString(4, 2, szList(2)) '계좌번호
		Table1.SetCellString(4, 2, szList(2)) '계좌번호
		if szList(3) == "talk" then
			Table0.SetCellString(7, 2, "알림톡·문자") 
		elseif szList(3) == "email" then
			Table0.SetCellString(7, 2, "이메일") 
		else
			Table1.left = 20 
			Table0.left = 520 
		end if 
		
		g_szJumun = szList(5)	
		if g_szJumun == "J" or g_szJumun == "R" then
			btnJumun.visible = true
		else
			btnJumun.visible = false
			btnOK.left = 0
			btnOK.width = 375
		end if 
		
		Table0.visible = true
		lblLine.visible = true
	
		DATAMANAGER.RequestTranData("obpds_srvc_323r")	'통합증거금 약정 조회	
	else
		Table0.visible = false
		lblLine.visible = false	
		lblInfo.visible = false	
		ImageInfo.visible = false	
		Button0.visible = false	
		Button1.visible = false	
		Button2.visible = false	
	End if
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()		
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl87057_p2_end", "ok")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
	ImageInfo.setMaintaningRatio("1")
	
	lblInfo.setHighlight(332, 0, 15)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	btnOK_OnClick()
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.OpenScreen("87054" , "") 	'통합증거금신청
	Form.CloseForm()
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.OpenScreen("16090" , "") 	'실시간시세신청
	Form.CloseForm()	
End Sub

'============================================================================
Sub Button2_OnClick()
	Form.OpenScreen("65000" , "") 	'외화환전 서비스
	Form.CloseForm()	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_323r" then
		'통합증거금 약정 조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "081")	'통합증거금 약정		
	end if 	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obpds_srvc_323r" Then
		dim AprvYN, SvcSrno
		AprvYN	= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0)
		SvcSrno	= cdbl(DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "SVC_SRNO" , 0))
		If (AprvYN = "Y" or AprvYN = "N") and SvcSrno > 0 Then
			'등록	
			Button0.visible = false
			Button0.left = 600
			ImageInfo.top = 472
			lblInfo.top = 465
			ImageInfo.top = 463
			lblInfo.setHighlight(332, 0, 15)
		Else
			'미등록
			Button0.visible = true
			'Button0.left = 20
			'ImageInfo.top = 426	
			'lblInfo.top = 428			
		end if	
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
End Sub

'============================================================================
Sub btnJumun_OnClick()
	
	if g_szJumun == "R" then
		Form.OpenScreen("16061" , "")
	else
		Form.OpenScreen("16060" , "")
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obpds_srvc_323r" trcode="obpds_srvc_323r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obpds_srvc_323r" title="HTS-WTS용 서비스 내역 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="148" _ulen="110" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
SVCD^서비스코드^3^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="159" _ulen="119" >

SVCD^서비스코드^3^0^0^0^0^0^0
SVC_SRNO^서비스일련번호^11^0^7^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
APRV_YN^승인여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
