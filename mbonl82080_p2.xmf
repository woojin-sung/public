	<SCRIPT_INFO _len="1621" _ulen="1621" >
--===========================================================================
--===========================================================================

'============================================================================


'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Label14.bgcolor = 293
	Label15.bgcolor = 293
	Label2.changeTextAttr(1, 23, 293, -2, false)
	Label1.changeTextAttr(1, 21, 293, -2, false)
	tblInfo.SetCellFgColor(1, 2, 293)
	tblInfo.SetCellFgColor(2, 2, 293)
End Sub

'============================================================================
Sub lblLink1_OnClick()
	szBroswerLink = "https://www.kifin.or.kr"
	Form.OpenExternalBrowser( szBroswerLink )
End Sub

'============================================================================
Sub lblLink2_OnClick()
	szBroswerLink = "http://strn.krx.co.kr"
	Form.OpenExternalBrowser( szBroswerLink )
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub tblInfo_OnClick(lRow , lColumn)
	if lRow == 1 and lColumn == 2 then
		szBroswerLink = "https://www.kifin.or.kr"
		Form.OpenExternalBrowser( szBroswerLink )
	elseif lRow == 2 and lColumn == 2 then
		szBroswerLink = "http://strn.krx.co.kr"
		Form.OpenExternalBrowser( szBroswerLink )
	end if
End Sub

