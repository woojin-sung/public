'============================================================================
' 01. 화 면 명 : 계좌비밀번호 변경
' 02. 화면설명 : 계좌비밀번호 변경
' 03. 작    성 : 2016. 01. 21. 유창재
' 2020.09.22 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_plain_rm	'v0001 메모리평문적용여부
Dim g_HomeNo      'v0001 자택전화번호
Dim g_ClphNo		'v0001 휴대전화번호
Dim g_WorkNo		'v0001 직장전화번호

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Pw_Check(szPW) : 비밀번호 조건 체크
'============================================================================
Function Pw_Check(szPW)
	
	if edt1PW.caption <> edt2PW.caption then
		Form.MsgBox("알림", "신규비밀번호와 비밀번호확인이 일치하지 않습니다.", 0, 6)
		edt1PW.caption = ""
		edt2PW.caption = ""
		Exit Function
	end if
	
	if Len(edt2PW.caption) < 4 then		'4~8자리 숫자 체크
		Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.", 0, 6)
		edt1PW.caption = ""
		edt2PW.caption = ""
		Exit Function
	end if

	if edt1PW.caption == edt0PW.caption then
		Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(기존 비밀번호와 동일)", 0, 6)
		edt1PW.caption = ""
		edt2PW.caption = ""
		Exit Function
	end if

	for i = 1 to Len(edt2PW.caption) - 3		'주민등록번호와 비교
		Dim szEdit, szJoomin
		szEdit = mid(edt2PW.caption,i,4)
		for j = 1 to Len(Form.GetSharedData("&JUMIN_NUM", false )) - 3
			szJoomin = mid((Form.GetSharedData("&JUMIN_NUM", false )),j,4)
			if szEdit == szJoomin then
				Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.", 0, 6)
				edt1PW.caption = ""
				edt2PW.caption = ""
				Exit Function
			end if
		next
	next
		
	for i = 1 to Len(edt2PW.caption) - 3 ' 연속된 3자리 숫자, 동일 숫자
		if Asc(mid(edt2PW.caption,i,1)) = Asc(mid(edt2PW.caption,i+1,1)) + 1 and Asc(mid(edt2PW.caption,i+1,1)) = Asc(mid(edt2PW.caption,i+2,1)) + 1 and Asc(mid(edt2PW.caption,i+2,1)) = Asc(mid(edt2PW.caption,i+3,1)) + 1 then
			Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(연속된 4자리 숫자)", 0, 6)
			edt1PW.caption = ""
			edt2PW.caption = ""
			Exit Function
		elseif Asc(mid(edt2PW.caption,i,1)) = Asc(mid(edt2PW.caption,i+1,1)) - 1 and Asc(mid(edt2PW.caption,i+1,1)) = Asc(mid(edt2PW.caption,i+2,1)) - 1 and Asc(mid(edt2PW.caption,i+2,1)) = Asc(mid(edt2PW.caption,i+3,1)) - 1 then
			Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(연속된 4자리 숫자)", 0, 6)
			edt1PW.caption = ""
			edt2PW.caption = ""
			Exit Function
		elseif Asc(mid(edt2PW.caption,i,1)) = Asc(mid(edt2PW.caption,i+1,1)) and Asc(mid(edt2PW.caption,i+1,1)) = Asc(mid(edt2PW.caption,i+2,1)) and Asc(mid(edt2PW.caption,i+2,1)) = Asc(mid(edt2PW.caption,i+3,1)) then
			Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(동일한 4자리 숫자)", 0, 6)
			edt1PW.caption = ""
			edt2PW.caption = ""
			Exit Function
		end if
	next

	if Len(acnt0.total) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'계좌번호와 비교
			Dim szAcnt
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(acnt0.total) - 3
				szAcnt = mid(acnt0.total,j,4)
				if szEdit == szAcnt then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(계좌번호와 4자리 이상 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'휴대폰번호와 비교
			Dim szPhone
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0)) - 3
				szPhone = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "CLPH_TELNO" , 0),j,4)
				if szEdit == szPhone then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(휴대폰번호와 4자리 이상 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'자택번호와 비교
			Dim szHome
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0)) - 3
				szHome = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "OWHS_TELNO" , 0),j,4)
				if szEdit == szHome then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(자택번호와 4자리 이상 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'직장번호와 비교
			Dim szWorkTel
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0)) - 3
				szWorkTel = mid(DATAMANAGER.GetDataValue( 0 , "obacp_comm_004r", "OutBlock1", "WRPL_WHOL_TELNO" , 0),j,4)
				if szEdit == szWorkTel then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.\n(직장번호와 4자리 이상 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	if Len(Form.GetSharedData("&USER_ID", false )) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'로그인 아이디와 비교
			Dim szEdit, szJoomin
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(Form.GetSharedData("&USER_ID", false )) - 3
				szJoomin = mid((Form.GetSharedData("&USER_ID", false )),j,4)
				if szEdit == szJoomin then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인ID와 4자리 이상 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	'16-02-03 로그인 비밀번호가 GetSharedData로 넘어오지 않음, Login 이후 넘어오는지 확인 필요
	if Len(Form.GetSharedData("&USER_PWD", false )) > 4 then
		for i = 1 to Len(edt2PW.caption) - 3		'로그인 비밀번호와 비교
			Dim szEdit, szJoomin
			szEdit = mid(edt2PW.caption,i,4)
			for j = 1 to Len(Form.GetSharedData("&USER_PWD", false )) - 3
				szJoomin = mid(Form.GetSharedData("&USER_PWD", false ),j,4)
				if szEdit == szJoomin then
					Form.MsgBox("알림", "유효하지 않은 비밀번호입니다.(로그인 비밀번호와 4자리 이상 일치)", 0, 6)
					edt1PW.caption = ""
					edt2PW.caption = ""
					Exit Function
				end if
			next
		next
	end if
	
	DATAMANAGER.RequestTranData("obaci_acct_034u")
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	edt1PW.enable = False
	edt2PW.enable = False
	edt0PW.caption = ""
'	Form.ShowAlert("ID", Form.GetSharedData("&USER_PWD", false ))
	
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'v0001 Defualt-주민번호용Aria키값 변경에 따른 API호출 삭제 
	'if g_plain_rm == "1" then
	'	'주민번호용 Aria키값으로 암호화하도록 설정(Defualt-이체용 Aria키값)
	'     edt0PW.SetAriaNoBank()
	'     edt1PW.SetAriaNoBank()
	'     edt2PW.SetAriaNoBank()
	'end if

	DATAMANAGER.RequestTranData("obacp_comm_004r")	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	'v0001 MTS메모리평문 적용일 경우, 서비스단에서 체크
	if g_plain_rm == "1" then
		DATAMANAGER.RequestTranData("obacp_comm_058r")	'비밀번호 유효성 검증체크
	else	
		Call Pw_Check()
	end if
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obacp_comm_004r" then
		DATAMANAGER.SetDataValue( 0, "obacp_comm_004r", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0, "obacp_comm_004r", "InBlock1", "ELFN_ID", 0 , Form.GetSharedData("&USER_ID", false ))

     'v0001 비밀번호 유효성 검증체크
	elseif szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "1" 		 )	'[MTS] 계좌비밀번호 변경시 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , acnt0.total )  '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , Form.GetSharedData("&USER_ID", false ))  'ID
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDBF_PWD_PIP", 0 , edt0PW.caption2 )  '현재비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , edt1PW.caption2 )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , edt2PW.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""			)  '실명확인번호(서비스에서 조회)		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
     
	elseif szTranID == "obaci_acct_034u" then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_034u", "InBlock1", "ACNO" , 0 , acnt0.total)
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obaci_acct_034u" then
		Form.MsgBox("알림", "계좌비밀번호가 변경되었습니다.", 0, 6)
		
		edt0PW.caption = ""
		edt1PW.caption = ""
		edt2PW.caption = ""
		
	'v0001
	elseif szTranID == "obacp_comm_004r" then
		'고객연락처설정
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
	
	'v0001
	elseif szTranID == "obacp_comm_058r" then
		DATAMANAGER.RequestTranData("obaci_acct_034u")
	end if
	
End Sub
'============================================================================
' edt0PW_OnEditComplete() : 비밀번호 입력시 변경 비밀번호창 활성화
'============================================================================
Sub edt0PW_OnEditComplete()
	'v0001 메모리평문 미적용일때만 최대자릿수(8)까지 체크
	if ((g_plain_rm ~= "1" and Len(edt0PW.caption) >= 4 and Len(edt0PW.caption) <= 8) or 
	    (g_plain_rm == "1" and Len(edt0PW.caption) >= 4 )) then
		edt1PW.enable = True
		edt2PW.enable = True
	else
		edt1PW.enable = False
		edt2PW.enable = False
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	'v0001 모든TR에러 표시로 변경
	'if szTranID == "obaci_acct_034u" then
	'	if DATAMANAGER.GetDataMsgSubText("obaci_acct_034u") <> "" then
	'		Form.MsgBox("알림", szErrMsg & " (" & DATAMANAGER.GetDataMsgSubText("obaci_acct_034u") & ")", 0, 6)
		if DATAMANAGER.GetDataMsgSubText(szTranID) <> "" then
			Form.MsgBox("알림", szErrMsg & " (" & DATAMANAGER.GetDataMsgSubText(szTranID) & ")", 0, 6)
		else
			Form.MsgBox("알림", szErrMsg, 0, 6)
		end if		
	'end if
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	edt0PW.caption = ""
End Sub

