'--===========================================================================
'--===========================================================================
Dim g_szMangDate

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("obcpp_bsdy_006r")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obcpp_bsdy_006r" then
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CLND_CLS_CODE" , 0 , "C003" )
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "MANG_DATE" , 0 , calTempDate.caption )
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CALC_DYNU" , 0 , "-0000001" )
	elseif szTranID = "obsim_bdsv_015r" then
		DATAMANAGER.SetDataValue( 0, "obsim_bdsv_015r", "InBlock1", "APLY_DATE" , 0 , g_szMangDate )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcpp_bsdy_006r" then
		g_szMangDate = DATAMANAGER.GetDataValue( 0, "obcpp_bsdy_006r", "OutBlock1", "MANG_DATE" , 0 )
		Label1.caption = g_szMangDate.."기준"
		DATAMANAGER.RequestTranData("obsim_bdsv_015r")
	end if
End Sub

