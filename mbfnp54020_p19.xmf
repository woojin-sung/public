<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="54020" scrname="채권 잔고 그리드 MovePopup" version="2" writer="함원규" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="BtnClose" btnimage="alpha.png" ly_vert="0,0,376,647,1" />
		<CONTAINER name="cont" ly_vert="0,0,375,70,1" scroll_ly_vert="0,0,375,70,1" >
			<CONTROL_INFO>
				<IMAGE name="imgBg" imgpath="btn_link_bg.9" ly_vert="0,0,375,70,1" />
				<BUTTON name="bntPrc" caption="현재가" fgcolor="004:000000000" fontsize="-2" ly_vert="10,17,84,40,1" />
				<BUTTON name="bntExpect" caption="예상수익" fgcolor="004:000000000" fontsize="-2" ly_vert="100,17,84,40,1" />
				<BUTTON name="bntBuy" caption="매수" fontsize="-2" btnimage="btn_36.9" ly_vert="190,17,84,40,1" />
				<BUTTON name="bntSell" caption="매도" fontsize="-2" btnimage="btn_31.9" ly_vert="281,17,84,40,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1554" _ulen="1526" >
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		listInfo = Split ( szData , "★")
		nYPos	 	= Int(listInfo[0])
		nHeight	 	= Int(listInfo[1])
		
		nConHeight = 70
		nScreenHeight = 600 ' 임시로 잡음
		
		if nConHeight + nYPos + nHeight > nScreenHeight then ' 위로 떠야 하는 경우
			cont.imgBg.imgpath = "btn_link_bg2.9"
			cont.top = nYPos - nConHeight + 5
			
			cont.bntPrc.top = 13
			cont.bntExpect.top = 13
			cont.bntBuy.top = 13
			cont.bntSell.top = 13
		else
			cont.top = nYPos + nHeight - 11
		end if
		
	end if
End Sub

'============================================================================
Sub cont_bntPrc_OnClick()
	Form.SendReturnToParent("mbfnp54020_p19" , "PRC")
	Form.CloseForm()
End Sub

'============================================================================
Sub cont_bntExpect_OnClick()
	Form.SendReturnToParent("mbfnp54020_p19" , "EXPECT")
	Form.CloseForm()
End Sub

'============================================================================
Sub cont_bntBuy_OnClick()
	Form.SendReturnToParent("mbfnp54020_p19" , "BUY")
	Form.CloseForm()
End Sub

'============================================================================
Sub cont_bntSell_OnClick()
	Form.SendReturnToParent("mbfnp54020_p19" , "SELL")
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>