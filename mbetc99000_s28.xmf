	<SCRIPT_INFO _len="5835" _ulen="5481" >
'============================================================================
Sub RadioGroup0_OnClick(nIndex)

	finish = 0
	
	if cint(nIndex) == 0 then
	Container0.visible = true
	Container1.visible = false
	
	else
	Container0.visible = false
	Container1.visible = true

	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()


	prtf_id = Cstr(Form.GetOpenLinkData())
	Container0.visible = true
	Container1.visible = false
	
	Container0.Table0.SetCellString(1, 1,"서울 영등포구 여의대방로69길 17")
	
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Button1_OnClick()

	 
	if RadioGroup0.currentindex == "0" then ' 직접방문 라디오버튼이 체크
	
	DATAMANAGER.SetEventFlag("obcpp_intr_758a", "I")
	
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "INP_CLS_CODE" , 0 , 0) ' 0: 직접방문 1:ODS
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "INP_MEMB_SRNO" , 0 , 1) '회원일련번호
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "INP_YN_CODE" , 0 , 1)
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "BRNM" , 0 , Container0.Combo0.caption) '지점명
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "BRNC_ADDR" , 0 , Container0.Table0.GetCellString(1,1)) '지점주소
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PRTF_ID" , 0 , prtf_id) '지점주소
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_DATE" , 0 , Container0.Calendar0.caption ) '예약날짜
	

		if Container0.Combo1.currentindex == "0" then ' 오전 선택
			if Container0.Combo2.currentindex =="11" then '오전 + 12시 -> 00시로 셋팅
				DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , "00"&":"&Container0.Combo3.caption )
				
			else
			    DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Container0.Combo2.caption&":"&Container0.Combo3.caption )
	
			end if
			
		else
			if Container0.Combo2.currentindex == "11" then '오후 + 12시 -> 12시로 셋팅
				DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , "12"&":"&Container0.Combo3.caption )
				
			else
		
				DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Container0.Combo2.caption+12&":"&Container0.Combo3.caption )
	
			end if
			
		end if
		
		
	DATAMANAGER.RequestTranData("obcpp_intr_758a")
	
	
	'Form.ShowAlert("", "직접방문" )
	
	elseif RadioGroup0.currentindex == "1" then
	
	
	DATAMANAGER.SetEventFlag("obcpp_intr_758a", "I")
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "INP_CLS_CODE" , 0 , 1) ' 0: 직접방문 1:ODS
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "INP_MEMB_SRNO" , 0 , 1) '회원일련번호
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "INP_YN_CODE" , 0 , 1)
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "BRNC_ADDR" , 0 , Container1.Edit2.caption) '주소
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_DATE" , 0 , Container1.Calendar0.caption ) '예약날짜
	DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PRTF_ID" , 0 , prtf_id) '지점주소
	
	if Container1.Combo1.currentindex == "0" then ' 오전 선택
			if Container0.Combo2.currentindex =="11" then '오전 + 12시 -> 00시로 셋팅
				DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , "00"&":"&Container1.Combo3.caption )
				
			else
			    DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Container1.Combo2.caption&":"&Container1.Combo3.caption )
	
			end if
			
		else
			if Container0.Combo2.currentindex == "11" then '오후 + 12시 -> 12시로 셋팅
				DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , "12"&":"&Container1.Combo3.caption )
				
			else
		
				DATAMANAGER.SetDataValue(0,"obcpp_intr_758a", "InBlock1", "PROS_HOUR" , 0 , Container1.Combo2.caption+12&":"&Container1.Combo3.caption )
	
			end if
			
		end if
	
	
	
	DATAMANAGER.RequestTranData("obcpp_intr_758a")
	
	
	
	
	
	'Form.ShowAlert("", "ODS")
	

	end if

	finish = 1
	Form.Toast(0,"예약이 완료되었습니다.", 0.5)
	Form.CloseForm()
	

End Sub

'============================================================================
Sub Form_OnFormClose()

	
	
End Sub

'============================================================================
Sub Container0_Combo0_OnEditComplete(nIndex)

 Select Case CInt(nIndex)
		Case 0
			Container0.Table0.SetCellString(1, 1,"서울 영등포구 여의대방로69길 17")
			 
		Case 1
			Container0.Table0.SetCellString(1, 1, "서울 종로구 새문안로 92")
			
		Case 2
			Container0.Table0.SetCellString(1, 1, "서울 강남구 삼성동 141-31")
			
		Case 3
			Container0.Table0.SetCellString(1, 1, "서울 강남구 도곡동 467-14")
			
		Case 4
			Container0.Table0.SetCellString(1, 1, "부산 부산진구 부전동 91-5")
			 
		Case 5
			Container0.Table0.SetCellString(1, 1, "대구 수성구 범어동 177-4")
			
	End Select
	
End Sub

'============================================================================
Sub Container0_Combo1_OnEditComplete(iIndex)

 if iIndex == 0 then 
	Form.ShowAlert("", "오전")
	
 else 
    Form.ShowAlert("","오후")
    
  end if
	
End Sub

'============================================================================
Sub Container0_Combo2_OnEditComplete(iIndex)
	Form.ShowAlert("",Container0.Combo2.currentindex)
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

