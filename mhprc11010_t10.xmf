	<SCRIPT_INFO _len="283594" _ulen="251260" >
'============================================================================
' 화 면 명 : 관심종목_스타일1 (375 X 524)
' 화면설명 : 관심종목_스타일1
' 작    성 : KKM 해외 관심종목 두줄
'============================================================================
'20220103 HSZ : 주식관심 실시간 서비스 변경 (ohhts_stck_cntg -> ohhts_stck_incg, ohhts_stck_aspr -> ohhts_stck_inas)
' 20240412 HSZ 코스닥글로벌지수 추가 (KF)
'20240930_02 KBC : 섹터선물옵션 (밸류업지수선물 상장)
'20241218_01 HWG : 관심종목 개선 1차
' 20250208_01 HWG START : 대체거래소 대응 작업

'****************************************************************************
'#### KBC START (mhprc11010_t10 과 mhprc11010_t11 다른부분)
'이하 라인은 mhprc11010_t10 과 mhprc11010_t11 모두 동일
'****************************************************************************

Dim DEF_STYLE_NM
Dim DEF_GRID_CNT
Dim DEF_GRID_DRAG_HEIGHT

DEF_STYLE_NM = "STYLE10"
DEF_GRID_CNT = 6
DEF_GRID_DRAG_HEIGHT = 57

'****************************************************************************
'### 실시간 정리
'****************************************************************************
'그리드 (미국-장운영 토글값에 맞춰서 시세를 보여줌)
'	ohhts_exst_ictg
'	ohhts_exst_cntd
'	ohhts_exst_cnta_1
'
'사이드아이템 (미국-현재 장운여에 해당하는 시세를 보여줌, 현재가와 동일)
'	ohhts_exst_ictg_1
'	ohhts_exst_cntd_1
'	ohhts_exst_aspr
'	ohhts_exst_cntg
'	ohhts_exst_cnta
'
'이미지1 5,53
'이미지2 5,181
'이미지3 5,263
'****************************************************************************

'11010.국내주식 관심종목
'13101 국내CFD  관심종목

'16010 해외주식 관심종목
'16110 해외CFD  관심종목

'11000 국내주식 현재가
'13100 국내CFD 현재가

'16000 해외주식 현재가
'16100 해외CFD 현재가

'12000 국내주식 주문
'13200 국내CFD 주문

'16060 해외주식 주문
'16200 해외CFD 주문

'13000 주식차트
'16020 해외주식 차트

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' 관심그룹 Key
Dim g_szGSID 
g_szGSID = ""

' 현재가/예상가/단일가 구분
Dim g_szRSelect
g_szRSelect = "0"

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

'종목선택시 연결화면(0:오른쪽 사이드화면, 1:현재가, 2:주문, 3:차트)
DIm g_szMove
g_szMove = "0"

'화면에서 종목추가위해 선택관심그룹명 필요
Dim g_GrpName

'선택된 종목으로 오른쪽사이드화면에서 사용 
Dim g_szSltCd, g_szSltMk, g_szSltName, g_szSltDecimal, g_szSltGubun, g_rtSltChk'리얼타임 

'중복종목 체크
Dim g_szCd
g_szCd = ""

Dim g_szTitle
g_szTitle = "알림"

'종목다중선택을 위해 필요한 변수
Dim g_tCode()
g_tCode = {}

'CFD 화면 추가
Dim g_szScreenNo 

