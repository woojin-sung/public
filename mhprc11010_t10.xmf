'============================================================================
' SetBgColor_Right : 오른쪽 사이드 화면 상단 배경색설정(상승/하락/보합)
'============================================================================
Function SetBgColor_Right(sSign)
	Dim sColor, sColor2	
'	'전일대비부호값에 따라 
	if Left(sSign, 1) == "-" then ' 하락
		sColor = "349"
	elseif sSign <> "" and CDbl(sSign) > 0 then ' 상승
		sColor = "348"
	else'if sSign == "" or sSign == "0" then ' 보합
		sColor = "66"			
	end if 	

	if g_sColor_Right <> sColor then
		Container0.Label0.bgcolor = sColor
		Container0.Label1.bgcolor = sColor
		Container0.Label2.bgcolor = sColor
		Container0.Label5.bgcolor = sColor
		g_sColor_Right = sColor		
	end if 
End Function

