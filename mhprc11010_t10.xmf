'============================================================================
' 입력값조절
'============================================================================
Sub Decimal_Setting(sValue, sDecimalLen)
	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Sub

'============================================================================
' 2017.11.22 -  LSS : 종목 대비값에 따른 색상 및 대비부호 설정
'============================================================================
Function swapItemColor(nIndex, nDiff, nRate)
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
	if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
	'************************************ SOR_END
		if nRate == "0.00" or nRate == "0" then
			grdList1.SetCellFgColor( "bd_hyun", nIndex, 12 ) 
			grdList1.SetCellFgColor( "bd_debi", nIndex, 12 ) 
			grdList1.SetCellFgColor( "bd_rate", nIndex, 12 ) 
		else
			grdList1.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
			grdList1.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
			grdList1.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
		end if 
	elseif g_szRSelect == "2" then '시간외단일가							
		if nRate == "0.00" or nRate == "0" then
			grdList2.SetCellFgColor( "bd_hyun", nIndex, 12 ) 
			grdList2.SetCellFgColor( "bd_debi", nIndex, 12 ) 
			grdList2.SetCellFgColor( "bd_rate", nIndex, 12 ) 
		else
			grdList2.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
			grdList2.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
			grdList2.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
		end if 		
	else	
		if nRate == "0.00" or nRate == "0" then
			grdList0.SetCellFgColor( "bd_hyun", nIndex, 12 ) 
			grdList0.SetCellFgColor( "bd_debi", nIndex, 12 ) 
			grdList0.SetCellFgColor( "bd_rate", nIndex, 12 ) 
		else
			grdList0.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
			grdList0.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
			grdList0.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
		end if 		
	end if 
End Function

'============================================================================
' 2023.02.06 -  HSZ : 실시간 여부에 따른 이미지 설정
'============================================================================
Function settingRealTime(nIndex, szRealAble)
	' 실시간	
	if szRealAble == "0" then
		grdList0.SetCellData( "bd_realicon", nIndex, "realtime_green_intr" )
	' 실시간아님
	elseif szRealAble == "1" then
		grdList0.SetCellData( "bd_realicon", nIndex, "realtime_grey_intr" )
	end if
End Function

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
	'20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode == "156" or szMediaCode == "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

