Sub grdList0_OnHeaderClickUp(lRow, szCellID)
	g_szSortIdx = g_szSortIdx + 1 
	if g_szSortIdx > 2 then
		g_szSortIdx = 0
	end if
	
	if szCellID <> g_szSortHeader then
		g_szSortHeader = szCellID
		g_szSortIdx = 0
	end if

	szData = 0
	
	if szCellID == "th_cell1" then
		szData = 4
	elseif szCellID == "th_cell6" then
		szData = 5
	elseif szCellID == "th_cell4" then
		szData = 6
	elseif szCellID == "th_cell5" then
		szData = 6
	end if
	
	setGridDragEdit()						'20250923 SWJ START
	
	grdList0.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
	
	Form.SetEnvData(1, "INTR_SORT_HEADER", g_szSortHeader)
	Form.SetEnvData(1, "INTR_SORT_IDX", g_szSortIdx)
	
End Sub

'============================================================================
Sub grdList1_OnHeaderClickUp(lRow, szCellID)
	g_szSortIdx = g_szSortIdx + 1 
	if g_szSortIdx > 2 then
		g_szSortIdx = 0
	end if
	
	if szCellID <> g_szSortHeader then
		g_szSortHeader = szCellID
		g_szSortIdx = 0
	end if

	szData = 0
	
	if szCellID == "th_cell1" then
		szData = 4
	elseif szCellID == "th_cell6" then
		szData = 5
	elseif szCellID == "th_cell4" then
		szData = 6
	elseif szCellID == "th_cell5" then
		szData = 7
	end if
	
	setGridDragEdit()						'20250923 SWJ START
	
	grdList1.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
	
	Form.SetEnvData(1, "INTR_SORT_HEADER", g_szSortHeader)
	Form.SetEnvData(1, "INTR_SORT_IDX", g_szSortIdx)
End Sub

'============================================================================
Sub grdList2_OnHeaderClickUp(lRow, szCellID)
	g_szSortIdx = g_szSortIdx + 1 
	if g_szSortIdx > 2 then
		g_szSortIdx = 0
	end if
	
	if szCellID <> g_szSortHeader then
		g_szSortHeader = szCellID
		g_szSortIdx = 0
	end if

	szData = 0
	
	if szCellID == "th_cell1" then
		szData = 4
	elseif szCellID == "th_cell6" then
		szData = 5
	elseif szCellID == "th_cell4" then
		szData = 6
	elseif szCellID == "th_cell5" then
		szData = 6
	end if
	
	setGridDragEdit()						'20250923 SWJ START
	
	grdList2.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
	
	Form.SetEnvData(1, "INTR_SORT_HEADER", g_szSortHeader)
	Form.SetEnvData(1, "INTR_SORT_IDX", g_szSortIdx)
End Sub
'20241218_01 HWG END
'============================================================================
'20251021 SWJ START
'OnSortingByScript 타이밍 이슈 화면에서 해결
'필터된 상태에서 종목편집에서 종목 순서 바꾸면 발생

'mhprc11011에서 Form_OnRefresh탈 때
'종목편집에서 순서 바꿀 때
'============================================================================
Sub Form_OnDelayEvent(nID)
	
	if Cint(nID) == 1 then
		
		'************************************ SOR_START
		' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업
		if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
			' KRX 예상가(1),  NXT 예상가(5), SOR 예상가(7)
		'************************************ SOR_END
			
			grdList1.onSortingByScript(g_szSortHeader, g_sData, g_szSortIdx)
		elseif g_szRSelect == "2" then 
			grdList2.onSortingByScript(g_szSortHeader, g_sData, g_szSortIdx)
		else 
			grdList0.onSortingByScript(g_szSortHeader, g_sData, g_szSortIdx)
		end if
		
		'2번타도 True로 바꿔라 여기까지 탔으면(종목편집은 2번 탐)
		if g_savePopupReturned = False then
			g_savePopupReturned = True
		else
			g_savePopupReturned = False
		end if
		
	end if

End Sub

