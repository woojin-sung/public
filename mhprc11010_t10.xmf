'20240524_01 KBC : 해외주식 고도화 (미사용 주석처리)
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 무브팝업리턴 받아 화면 이동
	' ----------------------------------------------------------------------		
	if sKeyName == "mhprc11000_save" then '관심등록/삭제/관심그룹과관심등록 완료 후
		
		' ADD, DEL, GROUP_ADD2
		szInstr = CInt(Instr(sRet, "★"))
		if szInstr > 0 and Trim(sRet) <> "" then	'Split 전 체크방어로직 추가
			
			tList = Split(sRet, "★")
			if (tList(2) == "GROUP_ADD2") then '1.최초 관심그룹 등록과 종목등록
				Container0.imgInterest.imgpath = "icon_like_o.png"
				g_nMutilGroup = g_nMutilGroup + 1
				
			     g_nGroupCnt = 1					
				Form.triggerEvent("#", "GROUP_ADD2", tList(1)) '관심그룹명
				
			elseif (tList(2) == "ADD") then '2.최근조회/보유종목에서 종목등록되었을 때	
				Container0.imgInterest.imgpath = "icon_like_o.png"
				g_nMutilGroup = g_nMutilGroup + 1 
				
'				if g_szGSID <> "BB" and g_szGSID <> "CC" then 
'					Form.triggerEvent("#", "ADD", tList(1))  '2-1. 최근조회/보유종목 이외에서 현재그룹 재조회
'				else 
					Form.triggerEvent("#", "ADD2", tList(1)) '2-2. 최근조회/보유종목에서는 관심종목수만 조회해둠.
'				end if 
			elseif (tList(2) == "DEL") then '3.종목삭제되었을 때	
				Container0.imgInterest.imgpath = "icon_like_n.png"
				g_nMutilGroup = 0
				
				if g_szGSID <> "BB" and g_szGSID <> "CC" then 
					btnVanish_OnClick() '오른쪽 팝업 닫기		
					Form.triggerEvent("#", "DEL", tList(1))  '3-1. 최근조회/보유종목 이외에서 현재그룹 재조회					
				else 
					Form.triggerEvent("#", "DEL2", tList(1)) '3-2. 최근조회/보유종목에서는 관심종목수만 조회해둠.
				end if
			end if
		else
			exit Sub
 		end if
	else
		'KBC임시 : mhprc11000_save 외 미사용 소스로 추정되어 일단 메세지 박스 띄움
		'Form.showAlert("Form_OnPopupReturn : " & sKeyName) 
	end if


'	if sKeyName == "MOVEPOP_RETURN" then
'		Dim tChk
'		Dim szChk
'		
'		if sRet == "" then
'			Exit Sub
'		end if
'		
