'20211019 아이티젠(김성수) 관심종목 개선 START
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if g_szDeviceOS == "2" then '202308 HSZ - iOS일 경우 라벨초기화
		Container0.Label0.fontsize = 0
		Container0.Label0.SetMaxLineCount(2)
	end if
	if szTranID == "ohhts_1020_004r" then
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		
		'전일거래량대비율 컬러 속성 값 초기화(기획상 색이 나오면 안됨)
		for i=0 to nCnt-1
			DATAMANAGER.SetDataAttr( 0, szTranID , "OutBlock1", "FID_CNCN_PRDY_VRSS_VOL_RATE", i, "0" )
		next
		
	elseIf szTranID = "ohhts_3000_005r" Then
		Dim nCnt
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_3000_005r", "OutBlock1" )
	
	    For i=0 To nCnt -1
		    Dim nFRGN_NTBY_TR_PBMN, nPRSN_NTBY_TR_PBMN, nORGN_NTBY_TR_PBMN, nSCRT_NTBY_TR_PBMN
		    
		    nFRGN_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    nPRSN_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    nORGN_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    nSCRT_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i , nFRGN_NTBY_TR_PBMN )
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i , nPRSN_NTBY_TR_PBMN )
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , i , nORGN_NTBY_TR_PBMN )
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN" , i , nSCRT_NTBY_TR_PBMN )
	    Next
	end if
End Sub

'============================================================================
' f_GetMarketName : 종목코드에 따른 시장명 RETURN
'============================================================================
Function f_GetMarketName(szCode)
	Dim szMarket, szInnerMk
	szMarket =  Form.GetItemCodeInfo(szCode, "market")
	szMarket = Change_EtcMarket(szMarket)
	szMarket = f_ChkMarket(szMarket, szCode)
	
	if szMarket == "J" then
		szInnerMk = Form.GetItemCodeInfo(szCode, "innermarket")
		
		if LEFT(szCode, 1, 1) == "J" then
			return "신주인수권"
		elseif LEFT(szCode, 1, 1) == "F" then
			return "수익증권"
		end if
		
		if szInnerMk == "001" then
			return "KOSPI"
		elseif szInnerMk == "002" then
			return "KOSDAQ"
		elseif szInnerMk == "013" then
			return "ETF"
		elseif szInnerMk == "033" then
			return "KONEX"
		else
			return ""
		end if
		
		
	elseif szMarket == "Q" then
		return "ETN"
	elseif szMarket == "W" then
		return "ELW"
	elseif szMarket == "T" then
		return "K-OTC"
	elseif szMarket == "F" or szMarket == "MF" or szMarket == "XF" or 
		szMarket == "O" or szMarket == "MO" or szMarket == "QO"  or
		szMarket == "WO" or szMarket == "KF" then	'20240412 HSZ 코스닥글로벌지수 추가
		
		return "선물옵션"
	elseif szMarket == "U" then
		return "업종지수"
	elseif szMarket == "B" then
		return "채권"
	elseif szMarket == "N" then
		return "해외지수"
	elseif szMarket == "FN" then
		return "해외선물"
	elseif szMarket == "EN" then
		return "환율"
	elseif szMarket == "JF" or szMarket == "JO" then
		return "주식선물옵션"
	
	end if
	 
End Function

