'============================================================================
'종목없음 안내메시지처리
Function SetNoticeMsg()
	'20230818 KKM START 등록된 관심종목수 전체/국내/해외에 따라 확인 
	Dim bShowMsg 
	bShowMsg = true

	nCnt = grdCode.rowcount
	if CStr(nCnt) == "" or CStr(nCnt) == "00000"or CStr(nCnt) == "0" then
		nCnt = 0
	end if 
	
	if nCnt == 0 then	
		bShowMsg = true
	else	
		 '전체(0)/국내(1)/해외(2)
		if g_szGubun == "1"  then
			For i = 0 to grdCode.rowcount - 1			
				szCd = grdCode.GetCellData("bd_code", i)
				szbdGubun = grdCode.GetCellData("bd_gubun", i)
				if szbdGubun == "KR" then '국내인 경우
					bShowMsg = false
					Exit For
				end if 
			Next
		elseif g_szGubun == "2"  then
			For i = 0 to grdCode.rowcount - 1			
				szCd = grdCode.GetCellData("bd_code", i)
				szbdGubun = grdCode.GetCellData("bd_gubun", i)
				if szbdGubun == "OV" then '해외인 경우
					bShowMsg = false
					Exit For
				end if 
			Next		
		else
			bShowMsg = false	
		end if 
	end if	
	
	if bShowMsg == true then	
		if g_szGSID == g_tKey[0] then
			lbNoticeMsg.caption = "최근 조회 종목이 없어요."
		elseif g_szGSID == g_tKey[1] then
			lbNoticeMsg.caption = "보유한 종목이 없어요."
		else
			'20230822 관심동기화 ON과 OFF가 동일하게 처리됨.
			if g_szGSID == "EMPTY" then
				lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			else
				lbNoticeMsg.caption = "등록된 종목이 없어요."
			end if 
		end if 
		imgNotice.left = 171 
		lbNoticeMsg.left = 87 				
		imgNotice.visible = true
		lbNoticeMsg.visible = true 		
		
	else	
		imgNotice.left = 671
		lbNoticeMsg.left = 587 				
		imgNotice.visible = false
		lbNoticeMsg.visible = false 		
	end if 	
	'20230818 KKM END	
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "ohhts_intr_007r" then
		if szErrCode == "9900" and g_szGSID == "EMPTY" and CStr(grdCode.rowcount) == "0" then '등록되어 있지 않는 관심그룹
			lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			imgNotice.left = 171
			lbNoticeMsg.left = 87 				
			imgNotice.visible = true
			lbNoticeMsg.visible = true 				
		end if 
	end if 
	
	'Form.Log("GWANSIM", szErrMsg)	
End Sub
