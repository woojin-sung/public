'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	
	' //////////////////////////////////////////////////////////////////////

	'아이콘 이미지 
	Container0.imgInterest.setMaintainingRatio("1")	
	Container0.Image1.setMaintainingRatio("1")	
	Container0.Image2.setMaintainingRatio("1")	
	Container0.Image3.setMaintainingRatio("1")	
	Container0.imgNotice.setMaintainingRatio("1")		

	'상승/하락/보합으로 하이라이트색상지정
	grdList0.SetHLColorCellId("bd_debiIcon")
	grdList1.SetHLColorCellId("bd_debiIcon")
	grdList2.SetHLColorCellId("bd_debiIcon")
	
	'멀티라인 설정될 때 최대 두줄까지만 설정되도록
	grdList0.SetCellMaxLineCount("bd_name", 2)
	grdList1.SetCellMaxLineCount("bd_name", 2)
	grdList2.SetCellMaxLineCount("bd_name", 2)
	
	f_EventPopup() '해외주식 공지팝업 
	
	Container0.grdNews.scrollenable = "0"
	
	'20230811 KKM 종목명 최대 두줄까지 설정
	Container0.Label0.SetMaxLineCount(2)
	
	'OS별 위치 수정
	if g_szDeviceOS == "2" then '아이폰
		'실시간/국가 이미지 국내에 세팅되지 않도록 수정
		grdList0.SetUseScriptImageCell("1")
		grdList1.SetUseScriptImageCell("1")
		grdList2.SetUseScriptImageCell("1")		
		
		'20220111 HSZ START : 그리드 소팅 설정
		'헤더클릭시 소팅되는 셀을 지정
		'헤더는 한개인데 서브행이 여러개이거나 merge되어 있을 때 sorting이 되지 않는 현상을
		'헤더랑 소팅대상의 셀을 매칭해 주는 기능
		grdList0.setSortCellID("th_cell1","bd_name")
		grdList0.setSortCellID("th_cell4","bd_debi")
		grdList0.setSortCellID("th_cell5","bd_rate")
		grdList0.setSortCellID("th_cell6","bd_hyun")	
		grdList1.setSortCellID("th_cell1","bd_name")
		grdList1.setSortCellID("th_cell4","bd_debi")
		grdList1.setSortCellID("th_cell5","bd_rate")
		grdList1.setSortCellID("th_cell6","bd_hyun")
		grdList2.setSortCellID("th_cell1","bd_name")
		grdList2.setSortCellID("th_cell4","bd_debi")
		grdList2.setSortCellID("th_cell5","bd_rate")
		grdList2.setSortCellID("th_cell6","bd_hyun")
		'20220111 HSZ END		
		
		'20231018 LES START : iOS 그리드 이미지세팅 속도개선
		grdList0.SetUseLoadFast(true)
		grdList1.SetUseLoadFast(true)
		grdList2.SetUseLoadFast(true)
		
     else  
     end if     
	
	'20241218_01 HWG START 
	Container0.Tab00.insertPage( 0, "pageHoga", "pageHoga", "empty", "1", "호가")
     Container0.Tab00.insertPage( 1, "pageCNTG", "pageCNTG", "empty", "1", "체결")
     Container0.Tab00.insertPage( 2, "pageTODAY", "pageTODAY", "empty", "1", "당일추정")  
     
     Container0.Tab01.insertPage( 0, "pageHoga", "pageHoga", "empty", "1", "호가")
     Container0.Tab01.insertPage( 1, "pageCNTG", "pageCNTG", "empty", "1", "체결")
     
	if g_szDeviceOS == "2" then 'iOS일 경우
		Container0.Tab00.currenttabpageid = "pageHoga"
		Container0.Tab00.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)
		
		Container0.Tab01.currenttabpageid = "pageHoga"
		Container0.Tab01.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)
	end if
	'20241218_01 HWG END 
				
	
	'20241218_01 HWG START
	g_szSortIdx = Cint(Form.GetEnvData("INTR_SORT_IDX"))
	g_szSortHeader = Form.GetEnvData("INTR_SORT_HEADER")
	
	if g_szSortHeader == "" then
		g_szSortHeader = "th_cell01"
		g_szSortIdx = 2
		Form.SetEnvData(1, "INTR_SORT_HEADER", g_szSortHeader)
		Form.SetEnvData(1, "INTR_SORT_IDX", g_szSortIdx)
	end if
	'20241218_01 HWG END
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20210823 HSZ CFD
	Container0.ChartEx0.setChartType("minibong")	
	
'	'아이콘 이미지 
'	Container0.imgInterest.setMaintainingRatio("1")	
'	Container0.Image1.setMaintainingRatio("1")	
'	Container0.Image2.setMaintainingRatio("1")	
'	Container0.Image3.setMaintainingRatio("1")	
'	Container0.imgNotice.setMaintainingRatio("1")	
	
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if g_szDeviceOS == "1" then '안드
		'20220111 HSZ START : 그리드 소팅 설정
		'헤더클릭시 소팅되는 셀을 지정
		'헤더는 한개인데 서브행이 여러개이거나 merge되어 있을 때 sorting이 되지 않는 현상을
		'헤더랑 소팅대상의 셀을 매칭해 주는 기능
		grdList0.setSortCellID("th_cell1","bd_name")
		grdList0.setSortCellID("th_cell4","bd_debi")
		grdList0.setSortCellID("th_cell5","bd_rate")
		grdList0.setSortCellID("th_cell6","bd_hyun")	
		grdList1.setSortCellID("th_cell1","bd_name")
		grdList1.setSortCellID("th_cell4","bd_debi")
		grdList1.setSortCellID("th_cell5","bd_rate")
		grdList1.setSortCellID("th_cell6","bd_hyun")
		grdList2.setSortCellID("th_cell1","bd_name")
		grdList2.setSortCellID("th_cell4","bd_debi")
		grdList2.setSortCellID("th_cell5","bd_rate")
		grdList2.setSortCellID("th_cell6","bd_hyun")
		'20220111 HSZ END
	end if 
	
	'20240524_01 KBC START : 해외주식 고도화
	'----------------------------------------------------------------
	grdList0.setDragHeight(DEF_GRID_DRAG_HEIGHT) '미입력시 그리드 ROW 높이도 자동설정 (메모는 높이가 달라서 통일시키고자 추가함)
	grdList0.setDragImageOption(False , 0) 
	
	grdList0.SetUseLoadFast(True)        '이미지세팅 속도 개선
	grdList0.SetUseNewDragMotion(True)   '드래그 끊김방지
	grdList0.changeDragStartOffset(False) '드래그 시작위치 조정
	grdList0.changeDragScrollSpeed(8)    '드래그 속도
	
	grdList0.setDragImage("edit_guide_01.png")
	grdList0.setDragImageOption(True , 0)

	'----------------------------------------------------------------
	grdList1.setDragHeight(DEF_GRID_DRAG_HEIGHT) '미입력시 그리드 ROW 높이도 자동설정 (메모는 높이가 달라서 통일시키고자 추가함)
	grdList1.setDragImageOption(False , 0) 
	
	grdList1.SetUseLoadFast(True)        '이미지세팅 속도 개선
	grdList1.SetUseNewDragMotion(True)   '드래그 끊김방지
	grdList1.changeDragStartOffset(False) '드래그 시작위치 조정
	grdList1.changeDragScrollSpeed(8)    '드래그 속도
	
	grdList1.setDragImage("edit_guide_01.png")
	grdList1.setDragImageOption(True , 0)
	
	'----------------------------------------------------------------
	grdList2.setDragHeight(DEF_GRID_DRAG_HEIGHT) '미입력시 그리드 ROW 높이도 자동설정 (메모는 높이가 달라서 통일시키고자 추가함)
	grdList2.setDragImageOption(False , 0) 
	
	grdList2.SetUseLoadFast(True)        '이미지세팅 속도 개선
	grdList2.SetUseNewDragMotion(True)   '드래그 끊김방지
	grdList2.changeDragStartOffset(False) '드래그 시작위치 조정
	grdList2.changeDragScrollSpeed(8)    '드래그 속도
	
	grdList2.setDragImage("edit_guide_01.png")
	grdList2.setDragImageOption(True , 0)
	
	'----------------------------------------------------------------
	setGridDragEdit()
	'20240524_01 KBC END	
	
	'20240826_02 KBC START 멀티라인 글자크기 자동 로직 변경
	szAppVer	= Form.GetSharedData("&APP_VERSION", False)
	szAppVer	= Replace(szAppVer, ".", "")
	
	'-----------------------------------------------------------------------
	'안드로이드(2.5.2 버전 이상부터 서비스 이용가능)
	'-----------------------------------------------------------------------
	if g_szDeviceOS == "1" then		
		if Cint(szAppVer) > 251 then
			grdList0.setIntrGrid()
			grdList1.setIntrGrid()
			grdList2.setIntrGrid()
		end if
	
	'-----------------------------------------------------------------------
	'iOS(2.5.52 버전 이상부터 서비스 이용가능
	'-----------------------------------------------------------------------
	elseif g_szDeviceOS == "2" then		
		if Cint(szAppVer) > 2551 then
			grdList0.setIntrGrid()
			grdList1.setIntrGrid()
			grdList2.setIntrGrid()
		end if
	end if
	'20240826_02 KBC END
	'20240828_01 KBC START 관심종목 종목메모 연계
	Container0.imgClose.setMaintainingRatio("1")	
	Container0.imgMemo.setMaintainingRatio("1")	
	'20240828_01 KBC END

End Sub

'20240524_01 KBC START : 해외주식 고도화
'============================================================================
Sub setGridDragEdit()
	
	if g_szGSID == "BB" or g_szGSID == "CC" then
		grdList0.rowmove = "0"
		grdList1.rowmove = "0"
		grdList2.rowmove = "0"
		exit sub
	end if
	
	if g_szGubun == "0" then '전체
		
		'20250923 SWJ START
		'그리드 헤더 필터 정렬된 상태일 때는
		'드래그 되지 않도록 한다. 
		'(안드는 앱에서 처리됨, 
		'iOS는 앱에서 처리하지 않고 있어서 화면에서 처리)
		if Cint(g_szSortIdx) == 2 then
			grdList0.SetUseNewDragMotion(True) 
			grdList1.SetUseNewDragMotion(True) 
			grdList2.SetUseNewDragMotion(True) 
			
			grdList0.rowmove = "2"	'2.상하 + 좌 드래그 | 3.좌드래그
			grdList1.rowmove = "2"	'2.상하 + 좌 드래그 | 3.좌드래그
			grdList2.rowmove = "2"	'2.상하 + 좌 드래그 | 3.좌드래그
		else		
			grdList0.rowmove = "0"
			grdList1.rowmove = "0"
			grdList2.rowmove = "0"
		end if
		'20250923 SWJ END
		
	else
		grdList0.rowmove = "0"
		grdList1.rowmove = "0"
		grdList2.rowmove = "0"
	end if
End Sub

'============================================================================
Sub grdList0_OnDropRow(nFromIndex, nToIndex)
	Getting_Toprow() '20240826_01 KBC : 관심종목 2차개선 (관심그룹/관심종목 스크롤 저장 변경)

	if nFromIndex == nToIndex then
		exit sub
	end if
	
	grdCode.setRowChange(nFromIndex, nToIndex)
	Check_LocalOrServer()
	
	Form.Toast(2, "관심종목이 변경되었습니다.", 0)
	Form.triggerEvent("#", "GESTURE", "ENABLE") 	
End Sub

Sub grdList1_OnDropRow(nFromIndex, nToIndex)
	grdList0_OnDropRow(nFromIndex, nToIndex)
End Sub

Sub grdList2_OnDropRow(nFromIndex, nToIndex)
	grdList0_OnDropRow(nFromIndex, nToIndex)
End Sub

'============================================================================
Sub grdList0_OnDeleteRow(lRow)
	Getting_Toprow() '20240826_01 KBC : 관심종목 2차개선 (관심그룹/관심종목 스크롤 저장 변경)

	grdCode.setDeleteRow(lRow)
	Check_LocalOrServer()
	
	Form.Toast(2, "관심종목이 삭제되었습니다.", 0)
	Form.triggerEvent("#", "GESTURE", "ENABLE") 	
End Sub

Sub grdList1_OnDeleteRow(lRow)
	grdList0_OnDeleteRow(lRow)
End Sub

Sub grdList2_OnDeleteRow(lRow)
	grdList0_OnDeleteRow(lRow)
End Sub

'============================================================================
Sub grdList0_OnDragCancel()
	Form.triggerEvent("#", "GESTURE", "ENABLE") 	
End Sub

Sub grdList1_OnDragCancel()
	grdList0_OnDragCancel()
End Sub

Sub grdList2_OnDragCancel()
	grdList0_OnDragCancel()
End Sub

'============================================================================
Sub grdList0_OnDragStart()
	Form.triggerEvent("#", "GESTURE", "DISABLE") 	
End Sub

Sub grdList1_OnDragStart()
	grdList0_OnDragStart()
End Sub

Sub grdList2_OnDragStart()
	grdList0_OnDragStart()	
End Sub
