'============================================================================
' init_GWList :  관심그룹의 종목 재설정 (로컬/서버)
'============================================================================
Function init_GWList()
	' 설정에서 구분자를 받아온다.
	if g_szCloud == "1" then		
		DATAMANAGER.RequestTranData("ohhts_intr_007r")
	else
		' 로컬 저장된 관심종목 가져오기
		Load_GWList()
	end if

End Function

'============================================================================
' Visible_Grid : 메인화면에서 선택한 토글로 그리드 쇼하이드
' 20160412 : 속도이슈로 인해 그리드의 SetRequestUpdate 추가
'============================================================================
Function Visible_Grid()
	g_szRSelect = Form.GetSharedData("GW_RSELECT", false)
	if g_szRSelect == "" then
		'************************************ SOR_START
		' 20250507 이윤성 2차 대체거래소에따라 변경
		'g_szRSelect = "0"
		g_szRSelect = "6"	' SOR 현재가(6)		
		'************************************ SOR_END
	end if	

	'20240524_01 KBC START : 해외주식 고도화
	g_szUSAMrktTimeCd_Grid = Form.LoadConfigData("11010", "GW_MKT_TIME_CD")		'토글용 장운영 구분값 (관심그리드 시세 용도)
	g_szUSAMrktTimeCd_Side = Form.LoadConfigData("11010", "GW_MKT_TIME_CD_MKT")	'현재 장운영 구분값 (사이드팝업 시세 용도)
	
'	g_szDaysise = Form.LoadConfigData("11010", "GW_DAYTIME")
'	if g_szDaysise == "" then
'		g_szDaysise = "0"
'	end if
	'20240524_01 KBC END
	
	
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업	

	if (g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7") and (g_szGubun <> "2") then		' 20250818 이윤성 2차 대체거래소:해외선택시제외
		' KRX 예상가(1), NXT 예상가(5), SOR 예상가(7)
		grdList0.SetRequestUpdate("0")
		grdList1.SetRequestUpdate("1")
		grdList2.SetRequestUpdate("0")

		grdList0.letf = 1000
		grdList1.left = 0
		grdList2.left = 1000		
		
	elseif g_szRSelect == "2" and g_szGubun <> "2" then			' 20250818 이윤성 2차 대체거래소:해외선택시제외
		' KRX 단일가
		grdList0.SetRequestUpdate("0")
		grdList1.SetRequestUpdate("0")
		grdList2.SetRequestUpdate("1")

		grdList0.letf = 1000
		grdList1.left = 1000
		grdList2.left = 0
	
	'20250208_01 HWG START
	elseif g_szRSelect == "6" or g_szRSelect == "4" or g_szRSelect == "0" then
		' SOR 현재가(6),   NXT 현재가(4),  KRX 현재가(0)
		grdList0.SetRequestUpdate("1")
		grdList1.SetRequestUpdate("0")
		grdList2.SetRequestUpdate("0")

		grdList0.letf = 0
		grdList1.left = 1000
		grdList2.left = 1000		
		
	'20250208_01 HWG END
	
	else							' SOR 현재가
		grdList0.SetRequestUpdate("1")
		grdList1.SetRequestUpdate("0")
		grdList2.SetRequestUpdate("0")

		grdList0.letf = 0
		grdList1.left = 1000
		grdList2.left = 1000
		
		g_szRSelect = "6"
	end if
	'************************************ SOR_END
	
End Function

'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)

	'Form.ShowAlert(g_szRSelect, szMk & "::::>" & nIdx  & "::::>" & szCd)
	
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
	
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]
		Case "J", "Q", "NJ", "TJ"	'20250208_01 HWG START					
			
			if g_szRSelect == "0" then
				'------------------------------- KRX 현재가
				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신 20220103 HSZ
				
			elseif g_szRSelect == "1" then	
				'------------------------------- KRX 예상가
				DATAMANAGER.SetDataValue(1, "ohhts_stck_inas", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(예상가) 20220103 HSZ
			
			elseif g_szRSelect == "2" then
				'------------------------------- KRX 단일가
				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
			
			'20250208_01 HWG START
			elseif g_szRSelect == "4" then
				'------------------------------- NXT 현재가
				DATAMANAGER.SetDataValue(1, "ohhts_nxt_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' NXT 체결 자동갠신(관심전용)		
			'20250208_01 HWG END
						
			elseif g_szRSelect == "5" then
				'------------------------------- NXT 예상가 ::: 예상가는 추후에 수신데이터 확인필요, 현제 데이터 안내려옴
				DATAMANAGER.SetDataValue(1, "ohhts_nxt_inas", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' NXT 주식관심호가 자동갱신
				
			elseif g_szRSelect == "6" then
				'------------------------------- SOR 현재가								
				
				'************************************ SOR_START
				' 20250908 이윤성 2차 대체거래소, KONEX 는 unt 실시간안됨, stck로 실시간처리
				
				'Dim szMarketNm
				'szMarketNm = f_GetMarketName(szCd)
				
				'if Trim(szMarketNm) == "KONEX" then
				if Trim(szMk) == "J" then			' 통합일때 nxt 불가종목은 J
					DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 통합일때 nxt 불가종목
				else
					DATAMANAGER.SetDataValue(1, "ohhts_unt_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' SOR 체결 자동갠신(관심전용)
				end if				
				'************************************ SOR_END
				
				
			elseif g_szRSelect == "7" then
				'------------------------------- SOR 예상가 ::: 예상가는 추후에 수신데이터 확인필요, 현제 데이터 안내려옴
				DATAMANAGER.SetDataValue(1, "ohhts_unt_inas", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' SOR 주식관심호가 자동갱신			
			end if			
						
			
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가) / 20240412 HSZ 코스닥글로벌지수 추가		
		
			'20240930_02 KBC START : 섹터선물옵션 (밸류업지수선물 상장)
			if szMk == "KF" and MID(szCd, 2, 2)  <> "AG" then
				'섹터(코스닥글로벌지수 제외)
				if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
					DATAMANAGER.SetDataValue(1, "ohhts_kfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
				elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
					DATAMANAGER.SetDataValue(1, "ohhts_kfut_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 예상체결 자동갱신
				end if 
				
			else
				if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
					DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
				elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
					DATAMANAGER.SetDataValue(1, "ohhts_futs_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 예상체결 자동갱신
				end if 

			end if			
			'20240930_02 KBC END
	
		
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)				
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then	
				DATAMANAGER.SetDataValue(1, "ohhts_optn_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]
		Case "U"					
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
			end if 
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"					
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신
			elseif g_szRSelect == "2" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]
		Case "W"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then 	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(예상가)
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"					
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]
		Case "FN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]	
		Case "EN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 
		' [[ 주식선물 ]]	 2018.01.02 CJH 추가
		Case "JF"		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 체결 자동갱신
			end if 
		' [[ 주식옵션 ]]	 2018.01.02 CJH 추가
		Case "JO"		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식옵션 체결 자동갱신
			end if
			
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" or g_szRSelect == "4" then  	' 20250208_01 HWG
			elseif g_szRSelect == "1" then '예상
			elseif g_szRSelect == "2" then	'단일
			end if 				

	End Select
	'************************************ SOR_END
	
End Function

'============================================================================
' Request_RealData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Request_RealData(szMk)
	
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업	
			
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]	
		Case "J", "Q", "NJ", "TJ"	'20250208_01 HWG START
						
			if g_szRSelect == "0" then
				'------------------------------- KRX 현재가
				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
			
			elseif g_szRSelect == "1" then	
				'------------------------------- KRX 예상가
				DATAMANAGER.RequestRealData("ohhts_stck_inas")		' 주식호가 자동갱신(예상가) 20220103 HSZ
			
			elseif g_szRSelect == "2" then
				'------------------------------- KRX 단일가
				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
			
			'20250208_01 HWG START
			elseif g_szRSelect == "4" then				
				'------------------------------- NXT 현재가
				DATAMANAGER.RequestRealData("ohhts_nxt_incg")		' 시간외단일체결 자동갱신
			'20250208_01 HWG END
			
			elseif g_szRSelect == "5" then
				'------------------------------- NXT 예상가 ::: NXT 예상가는 추후에 다시 확인예정, 우선 연결
				DATAMANAGER.RequestRealData("ohhts_nxt_inas")		' NXT 주식관심호가 자동갱신
				
			elseif g_szRSelect == "6" then
				'------------------------------- SOR 현재가
				
				'DATAMANAGER.RequestRealData("ohhts_unt_incg")		' SOR 체결 자동갠신(관심전용)
								
				
				'************************************ SOR_START
				' 20250908 이윤성 2차 대체거래소, KONEX 는 unt 실시간안됨, stck로 실시간처리
				
				'Dim szMarketNm
				'szMarketNm = f_GetMarketName(szCd)				
				
				'if Trim(szMarketNm) == "KONEX" then
				if Trim(szMk) == "J" then					
					DATAMANAGER.RequestRealData("ohhts_stck_incg")	' 통합일때 nxt 불가종목
				else
					DATAMANAGER.RequestRealData("ohhts_unt_incg")		' SOR 체결 자동갠신(관심전용)
				end if				
				'************************************ SOR_END								
								
				
			elseif g_szRSelect == "7" then
				'------------------------------- SOR 예상가
				DATAMANAGER.RequestRealData("ohhts_unt_inas")		' SOR 주식관심호가 자동갱신			
			end if			
			
			
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가) / 20240412 HSZ 코스닥글로벌지수 추가	
			
			'20240930_02 KBC START : 섹터선물옵션 (밸류업지수선물 상장)
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG				
				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
				DATAMANAGER.RequestRealData("ohhts_kfut_cntg")
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then				
				DATAMANAGER.RequestRealData("ohhts_futs_antg")		' 선물 예상체결 자동갱신
				DATAMANAGER.RequestRealData("ohhts_kfut_antg")
			end if 			
			'20240930_02 KBC END			
			
			
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then	
				DATAMANAGER.RequestRealData("ohhts_optn_antg")		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]				
		Case "U"
			
			'************************************ SOR_START
			' 20250825 이윤성 2차 대체거래소, NXT일때 지수 제외  g_szRSelect == "4"
			
			if g_szRSelect == "0" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			end if
			
			'************************************ SOR_END			
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.RequestRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]		
		Case "W"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.RequestRealData("ohhts_elw_aspr")			' ELW호가 자동갱신
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]			
		Case "FN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]				
		Case "EN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if	
		' [[ 주식선물	]]	2018.01.02 CJH 추가		
		Case "JF"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_sfut_cntg")		' 주식선물 체결			
			end if 
		' [[ 주식옵션	]]	2018.01.02 CJH 추가		
		Case "JO"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_sopt_cntg")		' 주식옵션 체결			
			end if 
			
		'20240524_01 KBC START : 해외주식 고도화 (관심그리드) - 실시간 등록 (토글기능때문에 장운영에 맞춰서 걸어야 됨. 무조건 걸어서는 안됨)
		'해외주식	
		Case "OQ", "AX", "NY"		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then  ' 20250208_01 HWG
'Form.ShowAlert("알림",  "디버그1 " & g_szUSAMrktTimeCd_Grid)			
				if g_szUSAMrktTimeCd_Grid == "001" then
					'001.주간개시
					DATAMANAGER.RequestRealData("ohhts_exst_cntd")
				
				elseif g_szUSAMrktTimeCd_Grid == "003" or g_szUSAMrktTimeCd_Grid == "004" then
					'003.PRE개시, 004.정규개시
					DATAMANAGER.RequestRealData("ohhts_exst_ictg")

				elseif g_szUSAMrktTimeCd_Grid == "005" then
					'005.AFTER개시
					
					DATAMANAGER.RequestRealData("ohhts_exst_cnta_1")
					
				else 
					'No Action (000.휴장, 002.주간종료, 006.AFTER종료)
				end if
			end if
		
		Case "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_exst_ictg")
			end if
		
'		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
'			if g_szRSelect == "0" then  
'				'20230109 HSZ START : 주간거래 실시간 체크 분기처리 추가
'				if g_szDaysise == "1" then	'주간거래 실시간 체크 -> 미국장은 주간거래 실시간만 받도록
'					DATAMANAGER.RequestRealData("ohhts_exst_ictg")		' 해외주식 체결 자동갱신			
'					DATAMANAGER.RequestRealData("ohhts_exst_cntd")		' 해외주식 체결 자동갱신
'				else
'					DATAMANAGER.RequestRealData("ohhts_exst_ictg")
'				end if				
'			end if 				

		'20240524_01 KBC END
 			
	End Select
	'************************************ SOR_END
		
End Function

'============================================================================
' Cancel_RealData : Real 해제 (0현재, 1예상, 2단일)
'============================================================================
Function Cancel_RealData(szMk)
	
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
			
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]
		Case "J", "Q", "NJ", "TJ"	'20250208_01 HWG START
						
			if g_szRSelect == "0" then
				'------------------------------- KRX 현재가
				DATAMANAGER.CancelRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
			
			elseif g_szRSelect == "1" then	
				'------------------------------- KRX 예상가
				DATAMANAGER.CancelRealData("ohhts_stck_inas")		' 주식호가 자동갱신(예상가) 20220103 HSZ
			
			elseif g_szRSelect == "2" then
				'------------------------------- KRX 단일가
				DATAMANAGER.CancelRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
			
			'20250208_01 HWG START
			elseif g_szRSelect == "4" then
				'------------------------------- NXT 현재가	
				DATAMANAGER.CancelRealData("ohhts_nxt_incg")		' NXT 체결 자동갠신(관심전용)
			'20250208_01 HWG END
			
			elseif g_szRSelect == "5" then
				'------------------------------- NXT 예상가 ::: NXT 예상가는 추후에 다시 확인예정, 우선 연결
				DATAMANAGER.CancelRealData("ohhts_nxt_inas")		' NXT 주식관심호가 자동갱신
				
			elseif g_szRSelect == "6" then
				'------------------------------- SOR 현재가
				'DATAMANAGER.CancelRealData("ohhts_unt_incg")		' SOR 체결 자동갠신(관심전용)
				
				'************************************ SOR_START
				' 20250908 이윤성 2차 대체거래소, KONEX 는 unt 실시간안됨, stck로 실시간처리
				
				'Dim szMarketNm
				'szMarketNm = f_GetMarketName(szCd)				
				
				'if Trim(szMarketNm) == "KONEX" then
				if Trim(szMk) == "J" then		' 통합일때 nxt 불가종목 J			
					DATAMANAGER.CancelRealData("ohhts_stck_incg")		' KRX 체결 자동갠신(관심전용)
				else
					DATAMANAGER.CancelRealData("ohhts_unt_incg")		' SOR 체결 자동갠신(관심전용)
				end if				
				'************************************ SOR_END				
				
			elseif g_szRSelect == "7" then
				'------------------------------- SOR 예상가
				DATAMANAGER.CancelRealData("ohhts_unt_inas")		' SOR 주식관심호가 자동갱신			
			end if			
			
			
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가) / 20240412 HSZ 코스닥글로벌지수 추가	
		
			'20240930_02 KBC START : 섹터선물옵션 (밸류업지수선물 상장)
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
				DATAMANAGER.CancelRealData("ohhts_kfut_cntg")
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.CancelRealData("ohhts_futs_antg")		' 선물 예상체결 자동갱신
				DATAMANAGER.CancelRealData("ohhts_kfut_antg")
			end if 
			'20240930_02 KBC END			
		
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)	
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then	
				DATAMANAGER.CancelRealData("ohhts_optn_antg")		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]	
		Case "U"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			end if 
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				'DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	' 프리보드체결 자동갱신
				DATAMANAGER.CancelRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
			elseif g_szRSelect == "2" then
				DATAMANAGER.CancelRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]
		Case "W"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_elw_cntg")		' ELW체결 자동갱신
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.CancelRealData("ohhts_elw_aspr")		' ELW호가 자동갱신
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if 
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]	
		Case "FN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
			end if 
		' [[ 세계환율 ]]	
		Case "EN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if 			
			
		' [[ 주식선물 ]]	2018.01.02 CJH 추가
		Case "JF"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_sfut_cntg")		' 주식선물 체결 자동갱신
			end if 
		' [[ 주식옵션 ]]	2018.01.02 CJH 추가
		Case "JO"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_sopt_cntg")		' 주식옵션 체결 자동갱신
			end if 
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then  	' 20250208_01 HWG
				DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 해외주식 체결 자동갱신			
				DATAMANAGER.CancelRealData("ohhts_exst_cntd")		' 해외주식 체결 자동갱신			
				DATAMANAGER.CancelRealData("ohhts_exst_cnta_1")	' 해외주식 체결 자동갱신	'20240524_01 KBC : 해외주식 고도화		
			end if 			
	End Select
	'************************************ SOR_END
	
End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName, szCode
	Dim szGubun '01:국내, 02:해외
	
	'국내: 종목코드, 해외: 마켓@종목코드 구분자 : `
	grdCode.rowcount = 0
	if Trim(szData) <> "" then
		tList = Split(szData, "`")		
		
		'최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 		
		end if
		
		nRowcount = 0
		For i = 0 to szLen
			'szGubun 세팅(OV: 해외주식, KR: 그 외)
			if CInt(Instr(tList(i), "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
				tCode = Split(tList(i), "@")
				if UBOUND(tCode) < 1 then
					'Exit Function
				else
					szMk  = tCode[0]
					if Trim(szMk) == "" then
						Exit Function
					else
						nMkLen = Form.getLen(szMk)
						if nMkLen = 2 then
							szGubun = "OV" '해외주식(마켓구분 2자리)
						else
							szGubun = "KR"
						end if
					end if
				end if
			else
				szGubun = "KR"
			end if
			
			If szGubun == "OV" Then '해외
				szMk = tCode[0]
				szMk = f_getExchCode2(szMk)
				szCode  = tCode[1]
			else ' 국내
				szMk = Form.GetItemCodeInfo(tList(i), "market")
				szMk = Change_EtcMarket(szMk)
				szCode = tList(i)
			end if
			
			'최근조회종목 - 상품선물 안보이게
			'상품선물 "FF"분기처리 추가
			if szMk == "CF" or szMk == "FF" then

			else
				grdCode.insertrow = nRowcount
				grdCode.SetCellData("bd_code", nRowcount, szCode)
				grdCode.SetCellData("bd_mk",   nRowcount, szMk)
				grdCode.SetCellData("bd_memo", nRowcount, "")
				grdCode.SetCellData("bd_name", nRowcount, Form.GetItemCodeInfo(tList(i), "name"))
				grdCode.SetCellData("bd_gubun", nRowcount, szGubun) 
				nRowcount = nRowcount + 1
			end if
		Next

		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		Form.triggerEvent("##", "SET_VISIBLE", "")
		Save_grdMk()		
	end if
	SetNoticeMsg() '종목없음 안내메시지처리
End Function

'============================================================================
' f_getExchCode2 :  3자리 일경우 2자리로 변경
'============================================================================
Function f_getExchCode2(szExchCode3)
	if szExchCode3 == "NAS" then
		return "OQ"
	elseif szExchCode3 == "AMX" then
		return "AX"
	elseif szExchCode3 == "NYS" then
		return "NY"
	elseif szExchCode3 == "SHS" then
		return "SH"
	elseif szExchCode3 == "SZS" then
		return "SZ"
	elseif szExchCode3 == "HKS" then
		return "HK"
	elseif szExchCode3 == "TSE" then
		return "JP"
	end if
	
	return szExchCode3
End Function

'============================================================================
' f_getExchCode3 :  2자리 일경우 3자리로 변경
'============================================================================
Function f_getExchCode3(szExchCode2)	
	if szExchCode2 == "HK" then
		return "HKS"
	elseif szExchCode2 == "SH" then
		return "SHS"
	elseif szExchCode2 == "SZ" then
		return "SZS"
	elseif szExchCode2 == "NY" then
		return "NYS"
	elseif szExchCode2 == "AX" then
		return "AMX"
	elseif szExchCode2 == "OQ" then
		return "NAS"
	elseif szExchCode2 == "JP" then
		return "TSE"
	end if
	
	return szExchCode2	
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' Load_GWGroup :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList
	
	grdCode.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", g_szGSID)

	if Trim(szGroup) <> "" then
		tGroup = Split(szGroup, "♣")

		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			'20230724 HSZ START: 관심종목 동기화 OFF로 사용 시, 인덱스 안맞는 오류 조치
			If UBOUND(tList) < 4 then
				tGroup(i) = tGroup(i).."★"
				tList = Split(tGroup(i), "★")
			end if
			'20230724 HSZ END
			
			grdCode.insertrow = i
	
			grdCode.SetCellData("bd_code", i, tList(0))
			grdCode.SetCellData("bd_mk",   i, tList(1))
			grdCode.SetCellData("bd_memo", i, tList(2))
			grdCode.SetCellData("bd_name", i, tList(3))	' 20160325 위젯위해 종목명 추가
			if tList(4) == "" or tList(4) == null  then
				'20230810 KKM START 관심종목동기화OFF
				if tList(0) == "빈칸" or tList(0) == "EMPTY" then
					grdCode.SetCellData("bd_gubun",i, "")
				else
					grdCode.SetCellData("bd_gubun",i, "KR")	'국가구분(KR/OV)
				end if 
				'20230810 KKM END 				
			else
				grdCode.SetCellData("bd_gubun",i, tList(4))	'국가구분(KR/OV)
			end if 
		Next
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		Save_grdMk()
	end if
	SetNoticeMsg() '종목없음 안내메시지처리	'20230810 KKM 관심종목동기화OFF
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCd, szMk

	For i = 0 to grdCode.rowcount-1
		szCd = grdCode.GetCellData("bd_code", i)
		szMk = grdCode.GetCellData("bd_mk",   i)
		
		if Trim(szMk) == "" then
			szMk = ""
		end if
		sTemp = Trim(grdCode.GetCellData("bd_memo", i)) & "★" & Trim(grdCode.GetCellData("bd_name", i)) & "★" & Trim(grdCode.GetCellData("bd_gubun", i))

		' 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCd  & "★" & szMk & "★" & sTemp
		else
			szList = szList & "♣" & szCd & "★" & szMk & "★" & sTemp
		end if
	Next

	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	Form.SaveConfigData("GWANSIM", g_szGSID, szList)
	if g_szCloud == "0" then
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		Save_grdMk()
	end if
	' ///////////////////////////////////////////////////////////////////////
End Function

'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		szGubun = Trim(grdCode.GetCellData("bd_gubun", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
				grdMk.SetCellData("bd_gubun", 0, szGubun)
			end if
	
			For j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					grdMk.SetCellData("bd_gubun", j, szGubun)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
					grdMk.SetCellData("bd_gubun", 0, szGubun)
				end if
			Next		
		end if
	Next

	if CInt(grdCode.rowcount) > 0 then
		grdList0.rowcount = 0
		grdList1.rowcount = 0
		grdList2.rowcount = 0
		' 관심종목 데이터조회
		if g_szGubun == "2" then 
			'해외
			DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) 
		else '전체,국내
			DATAMANAGER.RequestTranData( "ohhts_1020_004r" ) '전체라면 국내 후 해외조회)
		end if 
	end if
	
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "KF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO", "NJ", "TJ"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가) / 20240412 HSZ 코스닥글로벌지수 추가	
									
			'20250208_01 HWG START
			'if g_szRSelect == "4" then
				'isNXT = Form.GetItemCodeInfo( szCd , "isNXT")
				'if isNXT == "Y" then
				'	return "NJ"
				'end if
			'end if
			'20250208_01 HWG END
			
			
			'************************************ SOR_START
			' 20250820 이윤성 2차 대체거래소
			
			isNXT = Form.GetItemCodeInfo( szCd , "isNXT")
			
			if isNXT == "Y" and (g_szRSelect == "6" or g_szRSelect == "7") then
				' 통합 (통합일때 nxt 가능종목만, 불가종목은 J)
				return "TJ"
				
			elseif isNXT == "Y" and (g_szRSelect == "4" or g_szRSelect == "5") then
				' NXT (NXT일때 nxt 가능종목만, 불가종목은 J)
				return "NJ"
			
			else
				return szMk
				
			end if
			'************************************ SOR_END			
			
			return szMk
			
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
			
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
	
End Function

'============================================================================
' null 체크
'============================================================================
Sub isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
end Sub

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
	if g_szCloud == "1" then
		DATAMANAGER.RequestTranData("ohhts_intr_009r")
		Save_GWList()
	else
		Save_GWList()
	end if
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Move_Popup 
'============================================================================
Function Move_Popup(nYPos, nheight, szCd, sKorname, sRow)

	'20230918 HSZ START: 우측팝업 띄워진 상태에서, 동일위치&동일종목 선택 시 팝업 닫기 처리(VOC건)
	if g_szMove == "0" then
		if sRow <> g_szPopRow then
			g_szPopCd	= sKorname
			g_szPopRow	= sRow
		elseif sRow == g_szPopRow then
			if btnVanish.left <> 426 then 
				g_szPopCd 	= ""
				g_szPopRow 	= ""
				btnVanish_OnClick()	
			end if
			Exit Function
		end if
	end if
	'20230918 HSZ END

	'KBC : g_szMove 0.종목상세 1.현재가 2.주문 3.차트

	if g_szMove == "0" then ' 연결팝업
		szData =  nYPos & "★" & nheight 
		if g_szSltMk == "" then ' 마켓정보가 없는 상장폐지등의 종목은 오른쪽 팝업 뜨지 않도록 수정
			Exit Function
		end if 
		Screen_No("", "", "", "")
	else

		Select Case g_szSltMk
			Case "J", "Q", "T", "W", "NJ", "TJ"	'20250208_01 HWG START		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
				szData = nYPos & "★" & nheight & "★" & "0" & "★" & g_szSltMk & "★현재가★차트★뉴스★매수★매도"
				'20210823 HSZ START : CFD 화면 추가
				'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
				'20240524_01 KBC : 해외주식 고도화
				if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
					Screen_No(szData, "13100", "13200", "13000") 'CFD현재가/CFD주문/주식차트
				else
					Screen_No(szData, "11000", "12000", "13000") '현재가/주문/차트
				End if
				'20210823 HSZ END 
				
			Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	/ 20240412 HSZ 코스닥글로벌지수 추가
				szData = nYPos & "★" & nheight & "★" & "0" & "★" & g_szSltMk & "★현재가★차트★선물종합★매수★매도"
				
				Screen_No(szData, "31000", "31030", "31020")
			Case "U"						' 업종코드
				szData = nYPos & "★" & nheight & "★" & "2" & "★" & g_szSltMk & "★지수상세★차트★지수종목★★"
				
				Screen_No(szData, "42000", "", "42030")
			Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
				szData = nYPos & "★" & nheight & "★" & "3" & "★" & g_szSltMk & "★해외지수★해외차트★★★"
				
				Screen_No(szData, "42040", "", "42050")
			Case "B"						' 소액채권, 장내채권
				szData = nYPos & "★" & nheight & "★" & "1" & "★" & g_szSltMk & "★현재가★채권시세표★매수★매도★"
				
				'Screen_No(szData, "54010", "54020", "13000")
				Screen_No(szData, "54010", "54020", "54010")  '20240524_01 KBC : 해외주식 고도화 (채권은 차트화면이 별도도 없어서 현재가로 연동)
			'해외주식	
			Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"	
				Form.SetSharedData( "&ITEM_CODE" , szCd )
				Form.SetSharedData( "&ITEM_KORNAME" , sKorname )
				Form.SetSharedData( "&ITEM_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )				
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )				

				if g_szMove == "1" then ' 현재가
					'20240524_01 KBC : 해외주식 고도화
					if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then '국내CFD 
						Form.OpenScreen("16100", "") '해외CFD 현재가
					else
						Form.OpenScreen("16000", "") '해외주식 현재가
					end if 
					'Form.CloseForm( )
				elseif g_szMove == "2" then ' 주문
					szMediaCode = Form.GetSharedData("&MEDIA_CODE", false)
					if szMediaCode == "156" or szMediaCode == "157" then
						'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
						'20240524_01 KBC : 해외주식 고도화
						if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
							Form.OpenScreen("16200", "") '해외CFD 주문
						else
							Form.OpenScreen("16060", "") '해외주식 주문
						end if 					
					elseif szMediaCode == "158" or szMediaCode == "159" then
						'if (g_szScreenNo = "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
						'20240524_01 KBC : 해외주식 고도화
						if (g_szScreenNo = "13101" or g_szScreenNo == "16110") then
							Form.OpenScreen("16200", "") '해외CFD 주문
						else
							Form.OpenScreen("02000", "") '(고유) 해외주식주문
						end if					
						
					end if
				elseif g_szMove == "3" then ' 차트
					Form.OpenScreen("16020", "") '해외주식 차트
				end if
				
				Form.SetSharedData( "&ITEM_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )				
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )
		End Select
	end if	
End Function

'오른쪽사이드화면 & 관심메인화면의 우상단 스타일/하단 버튼  
'============================================================================
Function ShowRightMenu(bVisible)

	if bVisible == false then
		'오른쪽사이드화면 숨기기 & 관심메인화면의 우상단 스타일/하단 버튼 보이기
		btnVanish.left = 426
		Container0.left = 465
		
		'선택된 종목 데이터 초기화
		g_szSltCd = ""
		g_szSltMk = ""
		g_szSltName = ""
		g_rtSltChk = ""
		g_szSltDecimal = ""
		g_szSltGubun = ""		
		
		Form.SetCtlProp("##btnStyle", "visible", true)
		Form.SetCtlProp("##LblStyle", "visible", true)	
		Form.SetCtlProp("##ImgOpenGroup", "visible", true) '20240524_01 KBC : 해외주식 고도화
		
		if Form.GetCtlProp("##LblStyle", "caption") == "차트" then
			Form.SetCtlProp("##imgStyle0", "visible", true)
			Form.SetCtlProp("##imgStyle", "visible", false)
		else
			Form.SetCtlProp("##imgStyle0", "visible", false)
			Form.SetCtlProp("##imgStyle", "visible", true)
		end if 	
	
		'최근조회, 보유종목인 경우 
		sCurtabid = Form.GetCtlProp("##fmTab", "currenttabpageid")
		if sCurtabid == g_tPage[0] or sCurtabid == g_tPage[1] then	'20230816 KKM 최근조회, 보유종목 미사용일 경우 버튼이 보이지 않는 현상 수정
			Form.SetCtlProp("##btnAddItem", "visible", false)
			Form.SetCtlProp("##imgAddItem", "visible", false)
			Form.SetCtlProp("##btnEditItem", "visible", false)
			Form.SetCtlProp("##imgEditItem", "visible", false)
			Form.SetCtlProp("##btnShareItem", "visible", false)
			Form.SetCtlProp("##imgShareItem", "visible", false)
		else
			Form.SetCtlProp("##btnAddItem", "visible", true)
			Form.SetCtlProp("##imgAddItem", "visible", true)
			Form.SetCtlProp("##btnEditItem", "visible", true)
			Form.SetCtlProp("##imgEditItem", "visible", true)
			Form.SetCtlProp("##btnShareItem", "visible", true)
			Form.SetCtlProp("##imgShareItem", "visible", true)
		end if 
		
		'20241218_01 HWG START
		if g_szSltMk == "B" then
			Container0.Tab01.currenttabpageid = "pageHoga"	
			if g_szDeviceOS == "2" then 'iOS일 경우
				Container0.Tab01.callTabChanged()	
			end if 
		else
			Container0.Tab00.currenttabpageid = "pageHoga"
			if g_szDeviceOS == "2" then 'iOS일 경우
				Container0.Tab00.callTabChanged()	'iOS - ontabchanged호출됨(currenttabpageid로 세팅할 경우, ontabchange 안타는 현상 조치)
			end if 		
		end if
		'20241218_01 HWG END	
		
	else
		'오른쪽사이드화면 보이기 & 관심메인화면의 우상단 스타일/하단  버튼 숨기기
		btnVanish.left = 126
		Container0.left = 150
		
		Form.SetCtlProp("##btnStyle", "visible", false)
		Form.SetCtlProp("##LblStyle", "visible", false)			
		Form.SetCtlProp("##imgStyle0", "visible", false)
		Form.SetCtlProp("##imgStyle", "visible", false)
		Form.SetCtlProp("##btnAddItem", "visible", false)
		Form.SetCtlProp("##imgAddItem", "visible", false)
		Form.SetCtlProp("##btnEditItem", "visible", false)
		Form.SetCtlProp("##imgEditItem", "visible", false)
		Form.SetCtlProp("##btnShareItem", "visible", false)
		Form.SetCtlProp("##imgShareItem", "visible", false)	
		Form.SetCtlProp("##ImgOpenGroup", "visible", false) '20240524_01 KBC : 해외주식 고도화
		
	end if

	'20241218_01 HWG START
	if g_szSltMk == "B" then
		'if  Container0.Tab01.visible == false or Container0.Tab01.visible == "0" then
			Container0.hogaTbl.left = 600	
			Container0.grdCNTG.left = 600	
			Container0.tbl0.left = 600
		'else
		if Container0.Tab01.visible == true or Container0.Tab01.visible == "1" then
			if (Container0.Tab01.currenttab == 0)  or  (Container0.Tab01.currenttab == "0") then 
				Container0.hogaTbl.left = 11
			end if
			
			if (Container0.Tab01.currenttab == 1) or  (Container0.Tab01.currenttab == "1") then 
				Container0.grdCNTG.left = 11
			end if 		
			
			if (Container0.Tab01.currenttab == 2) or  (Container0.Tab01.currenttab == "2") then 
				Container0.tbl0.left = 11
			end if
		end if 
	
	else
		'if Container0.Tab00.visible == false or Container0.Tab00.visible == "0"  then
			Container0.hogaTbl.left = 600	
			Container0.grdCNTG.left = 600	
			Container0.tbl0.left = 600
		'else
		if Container0.Tab00.visible == true or Container0.Tab00.visible == "1"  then
			if  (Container0.Tab00.currenttab == 0) or  (Container0.Tab00.currenttab == "0")then 
				Container0.hogaTbl.left = 11
			end if
			if  (Container0.Tab00.currenttab == 1) or  (Container0.Tab00.currenttab == "1") then 
				Container0.grdCNTG.left = 11
			end if 		
			if  (Container0.Tab00.currenttab == 2) or  (Container0.Tab00.currenttab == "2")then 
				Container0.tbl0.left = 11
			end if
		end if 
	
	end if
	'20241218_01 HWG END

end Function

Sub btnVanish_OnClick()
	Cancel_RealData_Right() '0.오른쪽사이드화면 - 실시간 해제
	'Restart_grdMk()         '1.관심목록의 실시간 재시작
	ShowRightMenu(false)    '2.오른쪽사이드화면 - 숨기기
End Sub

'============================================================================
'20240828_01 KBC START : 관심종목 종목메모 연계
'종료버튼
Sub Container0_imgClose_OnClick()
	btnVanish_OnClick()
End Sub

'============================================================================
'종목메모버튼
Sub Container0_imgMemo_OnClick()
	'오른쪽사이트화면에서 선택된 종목이 없을 경우
	if g_szSltCd == "" then
		Exit Sub
	end if 
	
	Dim sTemp, sExid, sCode
	sTemp = split(g_szSltCd, "@")

	if #sTemp == 1 then
		'국내 (예 : 005930)
		
		if g_szSltMk == "" then
			Exit Sub
		end if
		
		Form.OpenPopup("mhtro16000_p17" , g_szSltCd & "@" & g_szSltMk , "")
		
	elseif #sTemp == 2 then
		'해외 (예: OPQ@INMD)
		sExid = sTemp[0] '시장구분
		sCode = sTemp[1] '종목코드

		if g_szUSAMrktTimeCd_Side == "" then
			Exit Sub
		end if

		if g_szExidCd =="AX" or g_szExidCd =="NY" or g_szExidCd =="OQ" then
			Form.OpenPopup("mhtro16000_p17" , sExid & "@" & sCode & "@" & g_szUSAMrktTimeCd_Side , "")
		else 
			Form.OpenPopup("mhtro16000_p17" , sExid & "@" & sCode & "@" & "011" , "") '중국/홍콩/일본은 장구분에 상관없이 011로 올림
		end if
	end if	
End Sub
'20240828_01 KBC END

'============================================================================
Sub Container0_imgInterest_OnClick()
	'오른쪽사이트화면에서 선택된 종목이 없을 경우
	if g_szSltCd == "" or g_szSltMk == "" then
		Exit Sub
	end if 
	
	'(조건)해당 종목이 관심종목에 등록된 경우
	if (g_nMutilGroup > 0) or (Container0.imgInterest.imgpath == "icon_like_o.png") or (Container0.imgInterest.imgpath == "icon_like_o") then
		'1.관심삭제(전체)
		g_szAction = "DEL"
		Form.OpenPopup("mhprc11000_pe", g_szSltCd& "★"& g_szAction,"", "")	'종목삭제
	else
		'(조건)최근조회/보유종목
		if g_szGSID == "BB" or g_szGSID == "CC" then 
			if Form.GetCtlProp("##grdGroup", "rowcount") == "" or Form.GetCtlProp("##grdGroup", "rowcount") == "0" then
				nGroupCnt = 0
			else
				nGroupCnt = CInt(Form.GetCtlProp("##grdGroup", "rowcount"))
			end if 
			'2.관심그룹등록/관심종목등록			
			if (g_nGroupCnt == 0) and  (nGroupCnt == 0) then '등록할 관심그룹이 하나도 없을 경우 관심그룹추가+관심종목추가
				g_szAction = "GROUP_ADD2"			
				Form.OpenPopup("mhprc11000_pf", g_szAction & "★" & g_szSltCd & "★", "")	'관심그룹과 관심종목 동시추가		
			else
			    '3.관심종목 등록
				g_szAction = "ADD"
				Form.OpenPopupAnimation("mhprc11010_p9", g_szSltCd& "★"& g_szAction,"", "2")	'종목등록
			end if 			
		end if
	end if
End Sub

'============================================================================
' Screen_No : 종목선택시 연결화면(0:오른쪽사이드화면, 1:현재가, 2:주문, 3:차트)
'============================================================================	
Function Screen_No(szScreen0, szScreen1, szScreen2, szScreen3)
	Select Case g_szMove
		Case "0"		'오른쪽사이드화면 보이기
			Container0.Change0.SetSignPos(2) ' 0 : 원래대로, 1 : 좌측부호, 2 : 우측부호	230717

			'오른쪽사이트화면
			'Stop_grdMk() '0. 관심목록의 실시간 일시해제
			Cancel_RealData_Right() '1.실시간해제
			Container0.ChartEx0.SetMarketCategory("0") '20250328 MSH UI 호출전 stock값으로 초기화	
			f_SetUI()               '2.마켓 종류별 UI SET
			f_RequestTran()         '3.데이터조회
			ShowRightMenu(true)     '4.보이기 & 관심메인화면의 우상단 스타일/하단 버튼 숨기기
			
		Case "1"			' 현재가
			szMk = Form.GetItemCodeInfo(g_szSltCd, "market")  '해외일 경우 체크필요
			szMk = Change_EtcMarket(szMk)
			
			if szMk == "U" then
				Form.OpenScreen(szScreen1, "2" & "★" & g_szSltCd )
			elseif szMk == "B" then
				Form.OpenScreen(szScreen1, "관심종목"  & "★" & g_szSltCd & "★" & "0")
			else
				Form.OpenScreen(szScreen1, g_szSltCd)
			end if
			
		Case "2"			' 주문화면  '해외일 경우 체크필요
			if Trim(szScreen2) <> "" then
				Form.OpenScreen(szScreen2, "관심종목★0" & "★" & g_szSltCd)		' 선택없으면 매수선택
			end if	
		Case "3"			' 차트  '해외일 경우 체크필요
			
			'20240524_01 KBC START : 해외주식 고도화 (채권은 차트화면이 별도도 없어서 현재가로 연동)
			szMk = Form.GetItemCodeInfo(g_szSltCd, "market")  '해외일 경우 체크필요
			szMk = Change_EtcMarket(szMk)
			
			if szMk == "B" then
				Form.OpenScreen(szScreen1, "관심종목"  & "★" & g_szSltCd & "★" & "3")
			else
				Form.OpenScreen(szScreen3, g_szSltCd)
			end if
			
			'이전소스
			'Form.OpenScreen(szScreen3, g_szSltCd)
			'20240524_01 KBC END
	End Select
End Function

'============================================================================
' f_SetUI :  오른쪽사이드화면- 마켓 종류별 UI SET
'============================================================================
Function f_SetUI()

	'20240828_01 KBC START : 관심종목 종목메모 연계
	Container0.imgMemo.visible = false
	
	'J : 주식
	'Q : ETN
	'T : KOTC
	'W : ELW
	'OQ , AX ~ JP : 해외주식
	
	Select Case g_szSltMk
		Case "J", "Q", "T", "W", "NJ", "TJ"	' 20250208_01 HWG
			Container0.imgMemo.visible = true
			Container0.Image3.visible = true '20250319 MSH 최신뉴스 Label 원복
			Container0.Label4.visible = true
			Container0.grdNews.visible = true
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			Container0.imgMemo.visible = true
			Container0.Image3.visible = true '20250319 MSH 최신뉴스 Label 원복
			Container0.Label4.visible = true
			Container0.grdNews.visible = true
		'20250319 MSH START
		Case Else
			Container0.Image3.visible = false '해당 조건에 없는 경우 최신뉴스 Label 숨김 처리
			Container0.Label4.visible = false
			Container0.grdNews.visible = false			
		'20250319 MSH END
	End Select	
	'20240828_01 KBC END

	Select Case g_szSltMk
		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW, 
		' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	
		' 20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
		' 20240412 HSZ 코스닥글로벌지수 추가
		' 해외주식
		Case "J", "Q", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "OQ", "AX", "NY", "SH", "SZ", "HK", "JP", "KF", "NJ", "TJ"	' 20250208_01 HWG

			Container0.Button0.btnimage = "btn_etc11.9.png"
			Container0.Button1.btnimage = "btn_etc10.9.png"
			
			Container0.Button0.caption = "매도"
			Container0.Button1.caption = "매수"
			
			Container0.Button0.fgcolor = "62"
			Container0.Button1.fgcolor = "62"
			
			'현재가 버튼 보임 처리
			Container0.Image1.visible = true
'			Container0.lblMovePrc.visible = true
			
			'차트 버튼 보임 처리
			Container0.Image2.visible = true
'			Container0.lblMoveChart.visible = true

			'20250319 MSH START 
			Container0.Button1.visible = true '해외차트 버튼 삭제 다른 Case 원복
			Container0.Button0.width = 108
			'20250319 MSH END 
			
			if g_szSltMk == "F" or g_szSltMk == "MF" or g_szSltMk == "O"  
				or g_szSltMk == "MO" or g_szSltMk == "MF" or g_szSltMk == "XF" 
				or g_szSltMk == "WO" or g_szSltMk == "KF" then  
				
				Container0.ChartEx0.SetMarketCategory("3") 'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
				Container0.ChartEx0.setDecimal("2") ' 소수점 2자리
				
				Container0.grdNews.visible = false '뉴스
				Container0.Tab00.visible = false '호가/체결/당일추정
				Container0.Tab00.left = 150	
				
				'20241218_01 HWG START 
				Container0.Tab01.visible = false '호가/체결/당일추정
				Container0.Tab01.left = 150	
				'20241218_01 HWG END 
			else
				Container0.grdNews.visible = true '뉴스
				Container0.Tab00.visible = true '호가/체결/당일추정
				Container0.Tab00.left = 11
				
				'20241218_01 HWG START 
				Container0.Tab01.visible = false '호가/체결/당일추정
				Container0.Tab01.left = 150	
				'20241218_01 HWG END 
			end if
			
		' 업종코드
		Case "U"	
			Container0.ChartEx0.SetMarketCategory("1")		   'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
'			Container0.ChartEx0.SetLoadChart("jisu") '20250328 MSH 미니차트 LoadChart 제거
			
			'현재가 버튼 안보임 처리
			Container0.Image1.visible = false
'			Container0.lblMovePrc.visible = false
			
			'차트 버튼 보임 처리
			Container0.Image2.visible = true
'			Container0.lblMoveChart.visible = true			
			
			Container0.Button0.btnimage = "btn_28.9"
			Container0.Button1.btnimage = "btn_28.9"
			
			Container0.Button0.caption = "지수상세"
			Container0.Button1.caption = "지수종목"
			
			Container0.Button0.fgcolor = "4"
			Container0.Button1.fgcolor = "4"
			
			Container0.grdNews.visible = false '뉴스
			Container0.Tab00.visible = false '호가/체결/당일추정
			Container0.Tab00.left = 150		
			
			'20241218_01 HWG START 
			Container0.Tab01.visible = false '호가/체결/당일추정
			Container0.Tab01.left = 150	
			'20241218_01 HWG END 
			
			'20250319 MSH START 
			Container0.Button1.visible = true '해외차트 버튼 삭제 다른 Case 원복
			Container0.Button0.width = 108
			'20250319 MSH END 
		
		' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
		Case "N", "EN", "FN"				
			Container0.ChartEx0.SetMarketCategory("1")		   'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
'			Container0.ChartEx0.SetLoadChart("global")  '20250328 MSH 미니차트 LoadChart 제거
			
			'해외환율일때 소수점 4자리로 160422 KMC 추가
			if g_szSltMk == "EN" then
				Container0.ChartEx0.setDecimal("4") ' 소수점 4자리
			else
				Container0.ChartEx0.setDecimal("2") ' 소수점 2자리
			end if
			
			'현재가 버튼 안보임 처리
			Container0.Image1.visible = false
'			Container0.lblMovePrc.visible = false
			
			'차트 버튼 안보임 처리
			Container0.Image2.visible = true '20250319 MSH 차트 버튼 보임 처리 변경
'			Container0.lblMoveChart.visible = false

			'20250319 MSH START 
			Container0.Button1.visible = false '해외차트 버튼 삭제 차트보기 > 로 이동
			Container0.Button0.width = 108+115 '매도버튼108 매수버튼 115
			Container0.Button0.btnimage = "btn_28.9"
'			Container0.Button1.btnimage = "btn_28.9" 20250319 MSH 해외차트 버튼 삭제 차트보기 > 로 이동
			
			Container0.Button0.caption = "해외지수"
'			Container0.Button1.caption = "해외차트" 20250319 MSH 해외차트 버튼 삭제 차트보기 > 로 이동
			
			Container0.Button0.fgcolor = "4"
'			Container0.Button1.fgcolor = "4" 20250319 MSH 해외차트 버튼 삭제 차트보기 > 로 이동
			'20250319 MSH END 
			
			Container0.grdNews.visible = false '뉴스
			Container0.Tab00.visible = false '호가/체결/당일추정
			Container0.Tab00.left = 150
			
			'20241218_01 HWG START 
			Container0.Tab01.visible = false '호가/체결/당일추정
			Container0.Tab01.left = 150	
			'20241218_01 HWG END 
			
		'채권	
		Case "B" 
			Container0.Button0.btnimage = "btn_etc11.9.png"
			Container0.Button1.btnimage = "btn_etc10.9.png"			
			
			Container0.Button0.caption = "매도"
			Container0.Button1.caption = "매수"
			
			Container0.Button0.fgcolor = "62"
			Container0.Button1.fgcolor = "62"
			
			'현재가 버튼 보임 처리
			Container0.Image1.visible = true
'			Container0.lblMovePrc.visible = true	
		
			'차트 버튼 안보임 처리
			Container0.Image2.visible = true '20250319 MSH 차트 버튼 보임 처리 변경
'			Container0.lblMoveChart.visible = false
			
			Container0.grdNews.visible = false '뉴스
			Container0.Tab00.visible = false '호가/체결/당일추정
			Container0.Tab00.left = 150
			
			'20241218_01 HWG START 
			Container0.Tab01.visible = true '호가/체결/당일추정
			Container0.Tab01.left = 11	
			'20241218_01 HWG END 
			
			'20250319 MSH START 
			Container0.Button1.visible = true '해외차트 버튼 삭제 다른 Case 원복
			Container0.Button0.width = 108
			'20250319 MSH END 
	End Select
		
	
End Function

'============================================================================
' f_RequestTran : 오른쪽사이드화면 조회 데이터 요청
'============================================================================
Function f_RequestTran()	
	
     '뉴스클리어
	Container0.grdNews.SetCellData( "bd_cell0", 0, "" )
	
	DATAMANAGER.RequestTranData( "ohhts_news_001r" )
	DATAMANAGER.RequestTranData( "ohhts_intr_101r" ) '관심종목포함여부
	
	'호가클리어 확인요	
	
	'체결클리어
	Container0.grdCNTG.rowcount = 0
	'당일추정클리어
	Container0.tbl0.SetCellString( 0, 1, "")
	Container0.tbl0.SetCellString( 1, 1, "")
	Container0.tbl0.SetCellString( 2, 1, "")

	'시장별 체결/호가/당일추정 탭 TR
	'TR
	Select Case g_szSltMk
		Case "J", "Q", "T", "W", "NJ", "TJ"	' 20250208_01 HWG		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			
			DATAMANAGER.RequestTranData( "ohhts_5010_001r" )	'차트
			DATAMANAGER.RequestTranData( "ohhts_1001_005r" ) '하단 호가탭			
			DATAMANAGER.RequestTranData( "ohhts_1001_004r" ) '하단 체결탭			
			DATAMANAGER.RequestTranData( "ohhts_1085_001r" ) '하단 당일추정탭 주식(실시간X)
			DATAMANAGER.RequestTranData( "ohhts_1001_001r" ) '종목명아래 종목정보
			
		Case  "JF", "JO"	' 주신선물/옵션
			
			DATAMANAGER.RequestTranData( "ohhts_5010_001r" )	'차트
			DATAMANAGER.RequestTranData( "ohhts_3707_003r" ) '하단 호가탭	 ohhts_sfut_aspr, ohhts_sfut_cntg_1
			DATAMANAGER.RequestTranData( "ohhts_1001_001r" ) '종목명아래 종목정보

		Case "F", "MF", "O", "MO",  "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'KF: 20240412 HSZ 코스닥글로벌지수 추가
			
			DATAMANAGER.RequestTranData( "ohhts_5010_001r" )	'차트
			DATAMANAGER.RequestTranData( "ohhts_3707_004r" ) '하단 호가탭	 ohhts_sfut_aspr, ohhts_sopb_aspr, ohhts_sfut_cntg, ohhts_sopb_cntg		
			DATAMANAGER.RequestTranData( "ohhts_1001_017r" ) '하단 체결탭	 ohhts_sfut_cntg, ohhts_sopb_cntg		
			DATAMANAGER.RequestTranData( "ohhts_3000_005r" ) ''하단 당일추정탭 선물옵션(실시간(X) 
			DATAMANAGER.RequestTranData( "ohhts_1001_001r" ) '종목명아래 종목정보
		
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP" '해외주식
			DATAMANAGER.RequestTranData( "ohhts_5041_001r" ) '해외차트
			DATAMANAGER.RequestTranData( "ohhts_6000_002r" ) '하단 호가탭  ohhts_exst_aspr, ohhts_exst_cntg_1			
			DATAMANAGER.RequestTranData( "ohhts_6000_003r" ) '하단 체결탭  ohhts_exst_cntg, ohhts_exst_cnta(장후체결), ohhts_exst_cntd_1(주간체결)			
			
		Case "U"						' 업종코드
			DATAMANAGER.RequestTranData( "ohhts_5010_001r" )	'차트
			DATAMANAGER.RequestTranData( "ohhts_1514_002r" ) '하단 체결탭 ohhts_nmix_cntg	 		

		Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
			DATAMANAGER.RequestTranData( "ohhts_5010_001r" )	'차트
			DATAMANAGER.RequestTranData( "ohhts_1001_001r" ) '종목명아래 종목정보

		Case "B"						' 소액채권, 장내채권			DATAMANAGER.RequestTranData( "ohhts_7052_005r" ) '하단 호가탭 ohhts_smbd_aspr, ohhts_bond_aspr, ohhts_smbd_cntg, ohhts_bond_cntg		
			'20241218_01 HWG START 
			DATAMANAGER.RequestTranData( "ohhts_7052_005r" ) '하단 호가탭 ohhts_smbd_aspr, ohhts_bond_aspr, ohhts_smbd_cntg, ohhts_bond_cntg		
			DATAMANAGER.RequestTranData( "ohhts_5010_001r" ) '차트
			DATAMANAGER.RequestTranData( "ohhts_7052_002r" ) '하단 체결탭 ohhts_smbd_cntg, ohhts_bond_cntg	
			DATAMANAGER.RequestTranData( "ohhts_1001_001r" ) '종목명아래 종목정보
			'20241218_01 HWG END
	End Select
	
	
	'************************************ SOR_START
	' 20250908 이윤성 2차 대체거래소, 시고저 등락률 전일종가 아닌, 기준가로 변경
	
	if g_szSltGubun == "OV" then '해외일 경우
		DATAMANAGER.RequestTranData( "ohhts_1030_002r_1" )
	else
		
		'******************************************** SOR_START
		' 20250507 이윤성 2차 대체거래소 SOR 추가 작업
			
		if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then '현재가	' 20250208_01 HWG
			DATAMANAGER.RequestTranData( "ohhts_1020_001r" )
		elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
			DATAMANAGER.RequestTranData( "ohhts_1020_001r_1" )
		elseif g_szRSelect == "2" then '단일가
			DATAMANAGER.RequestTranData( "ohhts_1020_001r_2" )
		end if
		'******************************************** SOR_END
		
	end if 
	
	'종목정보 클리어
	Container0.Label1.caption = ""
	Container0.Label1.changeTextAttr(0,0,100,28,-5,0) 'iOS 속성 남아있는 현상 조치
	
	'시고저 클리어
	Container0.Table1.SetCellString( 0, 1, "")
	Container0.Table1.SetCellString( 1, 1, "")
	Container0.Table1.SetCellString( 2, 1, "")
	Container0.Table1.SetCellString( 0, 2, "")
	Container0.Table1.SetCellString( 1, 2, "")
	Container0.Table1.SetCellString( 2, 2, "")
	
	'******************************************** SOR_END
	
	
	

End Function

'============================================================================
' Set_Real_Input_Right : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input_Right(szMk, nIdx, szCd)
	
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
	
	'종목은 하나, 따라서 nIdx = 0 
	Select Case szMk
		' 1. [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]
		Case "J", "Q", "NJ", "TJ"	' 20250208_01 HWG
		
			'Form.ShowAlert( "Set_Real_Input_Right :: " &	g_szRSelect & ":::" & szMk & " ::: " & szCd)
								
			if g_szRSelect == "0" then
				'------------------------------- KRX 현재가
				DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(호가)
			
			elseif g_szRSelect == "1" then	
				'------------------------------- KRX 예상가
				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(상단&체결)(예상가)
			
			elseif g_szRSelect == "2" then
				'------------------------------- KRX 단일가
				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신(상단&체결)
			
			' 20250208_01 HWG START
			elseif g_szRSelect == "4" then
				'------------------------------- NXT 현재가
				
				'************************************ SOR_START
				' 20250826 이윤성 2차 대체거래소, 체결 실시간은 cntg 사용
				'DATAMANAGER.SetDataValue(1, "ohhts_nxt_incg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)
				DATAMANAGER.SetDataValue(1, "ohhts_nxt_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)
				'************************************ SOR_END
				
				DATAMANAGER.SetDataValue(1, "ohhts_nxt_aspr_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)			
			' 20250208_01 HWG END						
			
			elseif g_szRSelect == "5" then
				'------------------------------- NXT 예상가 	::: NXT 예상가는 추후에 다시 확인예정, 우선 연결
				DATAMANAGER.SetDataValue(1, "ohhts_nxt_aspr_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' NXT 주식관심호가 자동갱신
				
			elseif g_szRSelect == "6" then
				'------------------------------- SOR 현재가
				'DATAMANAGER.SetDataValue(1, "ohhts_unt_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' SOR 주식체결 자동갱신(상단&체결)
				'DATAMANAGER.SetDataValue(1, "ohhts_unt_incg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' SOR 주식체결 자동갱신
				'DATAMANAGER.SetDataValue(1, "ohhts_unt_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' SOR 주식호가 자동갱신(호가)
				
								
				'************************************ SOR_START
				' 20250908 이윤성 2차 대체거래소, KONEX 는 unt 실시간안됨, stck로 실시간처리
				
				'Dim szMarketNm
				'szMarketNm = f_GetMarketName(szCd)
				
				'if Trim(szMarketNm) == "KONEX" then
				if Trim(szMk) == "J" then			' 통합일때 nxt 불가종목은 J					
					DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' KRX 주식체결 자동갱신(상단&체결)
					DATAMANAGER.SetDataValue(1, "ohhts_stck_incg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' KRX 주식체결 자동갱신
					DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' KRX 주식호가 자동갱신(호가)
					
				else
					
					DATAMANAGER.SetDataValue(1, "ohhts_unt_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' SOR 주식체결 자동갱신(상단&체결)
					DATAMANAGER.SetDataValue(1, "ohhts_unt_incg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' SOR 주식체결 자동갱신
					DATAMANAGER.SetDataValue(1, "ohhts_unt_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' SOR 주식호가 자동갱신(호가)
										
				end if				
				'************************************ SOR_END
												
				
								
			elseif g_szRSelect == "7" then
				'------------------------------- SOR 예상가
				DATAMANAGER.SetDataValue(1, "ohhts_unt_aspr_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' SOR 주식관심호가 자동갱신
				
			end if			
			
			
		' 2. [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가) / KF: 20240412 HSZ 코스닥글로벌지수 추가		

			'20240930_02 KBC START : 섹터선물옵션 (밸류업지수선물 상장)
			if szMk == "KF" and MID(szCd, 2, 2)  <> "AG" then
				'섹터(코스닥글로벌지수 제외)
				if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
					DATAMANAGER.SetDataValue(1, "ohhts_kfut_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신(상단&체결)
				elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
					DATAMANAGER.SetDataValue(1, "ohhts_kfut_antg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 예상체결 자동갱신(상단&체결)(예상가)
				end if 
			else
				if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
					DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신(상단&체결)
				elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
					DATAMANAGER.SetDataValue(1, "ohhts_futs_antg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 예상체결 자동갱신(상단&체결)(예상가)
				end if 			
			end if			
			'20240930_02 KBC END			
			
			
		' 3. [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)				
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신(상단&체결)
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then	
				DATAMANAGER.SetDataValue(1, "ohhts_optn_antg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 예상체결 자동갱신(상단&체결)(예상가)
			end if 
		'4. [[ 업종코드	]]
		Case "U"					
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신(상단&체결)
			end if 
			
		'20180712 HAMWG START : K-OTC MTS 도입
		'5. [[ K-OTC(프리보드) ]]
		Case "T"					
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신(호가)
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr_2", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신(상단&체결)(예상가)
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg_1", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
			end if 
		'20180712 HAMWG END
		
		'6. [[ ELW ]]
		Case "W"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(호가)
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr_2", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(상단&체결)(예상가)
			end if 
		'7. [[ 소액채권, 장내채권 ]]
		Case "B"					
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg_1", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
				DATAMANAGER.SetDataValue(1, "ohhts_bond_aspr_1", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)
			end if
		'8. [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix_1", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		'9. [[ 해외지수(CME선물, 상품선물) ]]
		Case "FN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg_1", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외선물 체결 자동갱신
			end if
		'10. [[ 세계환율 ]]	
		Case "EN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg_1", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 
		'11. [[ 주식선물 ]]	 2018.01.02 CJH 추가
		Case "JF"		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_sfut_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_sfut_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 자동갱신(호가)
			end if 
		'12. [[ 주식옵션 ]]	 2018.01.02 CJH 추가
		Case "JO"		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_sopt_cntg_1", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식옵션 체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_sopt_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식옵션 자동갱신(호가)
			end if			
'		'13. [[ 해외주식 ]]
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.SetDataValue(1, "ohhts_exst_ictg_1", "InBlock1", "FIDXR_ISCD", nIdx, szCd)			' 해외주식 체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_exst_cntd_1", "InBlock1", "FIDXR_ISCD", nIdx, szCd)			' 해외주식 체결 자동갱신(주간체결)
				DATAMANAGER.SetDataValue(1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD", nIdx, szCd)			' 해외주식 체결 자동갱신(장후시간)
				DATAMANAGER.SetDataValue(1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD", nIdx, szCd)			' 해외주식 체결 자동갱신(상단&체결)
				DATAMANAGER.SetDataValue(1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD", nIdx, szCd)			' 해외주식 체결 자동갱신(호가)
			end if 
	End Select
	'************************************ SOR_END
	
	DATAMANAGER.SetDataValue(1, "ohhts_marg_rate", "InBlock1", "FIDR_SHRN_ISCD", 0, szCd)		'마진
	
End Function

'============================================================================
' Request_RealData_Right : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Request_RealData_Right(szMk)
	
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
			
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]	
		Case "J", "Q", "NJ", "TJ"	' 20250208_01 HWG
									
			if g_szRSelect == "0" then
				'------------------------------- KRX 현재가
				DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' 주식체결 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_stck_incg_1")		' 주식체결 자동갱신
				DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' 주식호가 자동갱신(호가) 
			
			elseif g_szRSelect == "1" then
				'------------------------------- KRX 예상가
				DATAMANAGER.RequestRealData("ohhts_stck_aspr_1")		' 주식호가 자동갱신(예상가)
			
			elseif g_szRSelect == "2" then
				'------------------------------- KRX 단일가
				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg_1")		' 시간외단일체결 자동갱신
				
			' 20250208_01 HWG START
			elseif g_szRSelect == "4" then
				'------------------------------- NXT 현재가
				
				'************************************ SOR_START
				' 20250826 이윤성 2차 대체거래소, 체결 실시간은 cntg 사용
				'DATAMANAGER.RequestRealData("ohhts_nxt_incg_1")
				DATAMANAGER.RequestRealData("ohhts_nxt_cntg")
				'************************************ SOR_END
				
				DATAMANAGER.RequestRealData("ohhts_nxt_aspr_1")
			' 20250208_01 HWG END
			
			elseif g_szRSelect == "5" then
				'------------------------------- NXT 예상가 	::: NXT 예상가는 추후에 다시 확인예정, 우선 연결
				DATAMANAGER.RequestRealData("ohhts_nxt_aspr_1")		' NXT 주식관심호가 자동갱신
				
			elseif g_szRSelect == "6" then
				'------------------------------- SOR 현재가
				'DATAMANAGER.RequestRealData("ohhts_unt_cntg")		' SOR 주식체결 자동갱신(상단&체결)
				'DATAMANAGER.RequestRealData("ohhts_unt_aspr")		' SOR 주식호가 자동갱신(호가)
				
				
				'************************************ SOR_START
				' 20250908 이윤성 2차 대체거래소, KONEX 는 unt 실시간안됨, stck로 실시간처리
				
				'Dim szMarketNm
				'szMarketNm = f_GetMarketName(szCd)				
				
				'if Trim(szMarketNm) == "KONEX" then
				if Trim(szMk) == "J" then
					DATAMANAGER.RequestRealData("ohhts_stck_cntg")		' KRX 주식체결 자동갱신(상단&체결)
					DATAMANAGER.RequestRealData("ohhts_stck_incg_1")		' KRX 주식체결 자동갱신
					DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' KRX 주식호가 자동갱신(호가) 
					
				else					
					DATAMANAGER.RequestRealData("ohhts_unt_cntg")		' SOR 주식체결 자동갱신(상단&체결)
					DATAMANAGER.RequestRealData("ohhts_unt_incg_1")	' SOR 주식체결 자동갱신
					DATAMANAGER.RequestRealData("ohhts_unt_aspr")		' SOR 주식호가 자동갱신(호가)
					
				end if				
				'************************************ SOR_END	
				
				
								
			elseif g_szRSelect == "7" then
				'------------------------------- SOR 예상가
				DATAMANAGER.RequestRealData("ohhts_unt_aspr_1")		' SOR 주식관심호가 자동갱신
				
			end if			
			
			
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]

		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가) / KF: 20240412 HSZ 코스닥글로벌지수 추가	
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_futs_cntg_1")		' 선물 체결 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_futs_aspr_1")		' 선물 체결 자동갱신(호가)
				
				'20240930_02 KBC START : 섹터선물옵션 (밸류업지수선물 상장)
				DATAMANAGER.RequestRealData("ohhts_kfut_cntg_1")
				DATAMANAGER.RequestRealData("ohhts_kfut_aspr_1")	
				'20240930_02 KBC END						
				
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.RequestRealData("ohhts_futs_antg_1")		' 선물 예상체결 자동갱신
				
				'20240930_02 KBC START : 섹터선물옵션 (밸류업지수선물 상장)
				DATAMANAGER.RequestRealData("ohhts_kfut_antg_1")
				'20240930_02 KBC EN				
			end if 
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)		
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_optn_cntg_1")		' 옵션 체결 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_optn_aspr_1")		' 옵션 체결 자동갱신(호가)
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then	
				DATAMANAGER.RequestRealData("ohhts_optn_antg_1")		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]				
		Case "U"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")		' 업종지수 체결 자동갱신			
			end if
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_frbr_cntg_1")		' 프리보드체결 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_frbr_aspr_1")		' 프리보드호가 자동갱신(호가)
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.RequestRealData("ohhts_frbr_aspr_2")		' 프리보드호가 자동갱신(예상가)
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]		
		Case "W"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_elw_cntg_1")		' ELW체결 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_elw_aspr_1")		' ELW호가 자동갱신(호가)
			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
				DATAMANAGER.RequestRealData("ohhts_elw_aspr_2")		' ELW호가 자동갱신(예상가)
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_bond_cntg_1")		' 일반채권 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_bond_aspr_1")		' 일반채권 자동갱신(호가)
				DATAMANAGER.RequestRealData("ohhts_smbd_cntg")		' 소형채권 자동갱신(상단&체결)
				DATAMANAGER.RequestRealData("ohhts_smbd_aspr")		' 소형채권 자동갱신(호가)				

			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix_1")		' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]			
		Case "FN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_nfut_cntg_1")		' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]				
		Case "EN"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg_1")		' 환율 체결 자동갱신
			end if	
		' [[ 주식선물	]]	2018.01.02 CJH 추가		
		Case "JF"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_sfut_cntg_1")		' 주식선물 자동갱신(상단&체결)			
				DATAMANAGER.RequestRealData("ohhts_sfut_aspr")		' 주식선물 자동갱신(호가)				
'			elseif g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then	
			end if 
		' [[ 주식옵션	]]	2018.01.02 CJH 추가		
		Case "JO"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then	' 20250208_01 HWG
				DATAMANAGER.RequestRealData("ohhts_sopt_cntg_1")		' 주식옵션 자동갱신(상단&체결)			
				DATAMANAGER.RequestRealData("ohhts_sopt_aspr")		' 주식옵션 자동갱신(호가)				
			end if 
			
		'20240524_01 KBC START : 해외주식 고도화 (관심그리드)			
		'기존에는 사이드 시세화면은 주간여부 선택과 상관없이 주간 실시간 시세를 뿌려줌
		'-> TOBE도 모두 실시간 걸어서 현재가 화면처럼 적용 (소스변경없음)
		
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" or g_szRSelect == "4" or g_szRSelect == "6" then 	' 20250208_01 HWG			
				DATAMANAGER.RequestRealData("ohhts_exst_ictg_1")		' 해외주식 체결 자동갱신			
				DATAMANAGER.RequestRealData("ohhts_exst_cntd_1")		' 해외주식 체결 자동갱신			
				DATAMANAGER.RequestRealData("ohhts_exst_aspr")		' 해외주식 호가		
				DATAMANAGER.RequestRealData("ohhts_exst_cntg")		' 해외주식 체결호가
				DATAMANAGER.RequestRealData("ohhts_exst_cnta")		' 해외주식 체결(장후체결)
			end if 				
		'20240524_01 KBC END
	End Select
	'************************************ SOR_END
	
	DATAMANAGER.RequestRealData( "ohhts_marg_rate" )
	
End Function

'============================================================================
' Cancel_RealData_Right : 실시간 연결 끊기
'============================================================================
Function Cancel_RealData_Right()
	'주식
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")		' 주식체결 자동갱신(상단 & 체결)
	DATAMANAGER.CancelRealData("ohhts_stck_incg_1")	' 주식호가 자동갱신(관심전용)
	DATAMANAGER.CancelRealData("ohhts_stck_aspr")		' 주식호가 자동갱신(호가) 	
	DATAMANAGER.CancelRealData("ohhts_stck_aspr_1")	' 주식호가 자동갱신(예상가) 
	
	' 20250208_01 HWG START
	DATAMANAGER.CancelRealData("ohhts_nxt_aspr")
	DATAMANAGER.CancelRealData("ohhts_nxt_aspr_1")
	' 20250208_01 HWG END	
	
	'************************************ SOR_START
	' 20250826 이윤성 2차 대체거래소, 체결 실시간은 cntg 사용
	'DATAMANAGER.CancelRealData("ohhts_nxt_incg_1")
	DATAMANAGER.CancelRealData("ohhts_nxt_cntg")
	'************************************ SOR_END	
		
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
	DATAMANAGER.CancelRealData("ohhts_unt_cntg")
	DATAMANAGER.CancelRealData("ohhts_unt_incg_1")
	DATAMANAGER.CancelRealData("ohhts_unt_aspr")
	DATAMANAGER.CancelRealData("ohhts_unt_aspr_1")
	'************************************ SOR_END
	
	'프리보드(K-OTC)
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg_1")	' 프리보드체결 자동갱신(상단 & 체결)
	DATAMANAGER.CancelRealData("ohhts_frbr_aspr_1")	' 프리보드호가 자동갱신(호가)	
	DATAMANAGER.CancelRealData("ohhts_frbr_aspr_2")	' 프리보드호가 자동갱신(예상가)	
	'ELW
	DATAMANAGER.CancelRealData("ohhts_elw_cntg_1")	' ELW체결 자동갱신(상단 & 체결)
	DATAMANAGER.CancelRealData("ohhts_elw_aspr_1")	' ELW호가 자동갱신(호가)	
	DATAMANAGER.CancelRealData("ohhts_elw_aspr_2")	' ELW호가 자동갱신(예상가) 	
	'선물옵션
	DATAMANAGER.CancelRealData("ohhts_futs_cntg_1")	' 선물 자동갱신(상단 & 체결)			
	DATAMANAGER.CancelRealData("ohhts_kfut_cntg_1")	' 선물 자동갱신(상단 & 체결)		'20240930_02 KBC : 섹터선물옵션 (밸류업지수선물 상장)
	DATAMANAGER.CancelRealData("ohhts_futs_aspr_1")	' 선물 자동갱신(호가)			
	DATAMANAGER.CancelRealData("ohhts_optn_cntg_1")	' 옵션 자동갱신(상단 & 체결)
	DATAMANAGER.CancelRealData("ohhts_optn_aspr_1")	' 옵션 자동갱신(호가)	
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg_1")	' 주식선물 자동갱신(상단 & 체결)			
	DATAMANAGER.CancelRealData("ohhts_sfut_aspr")		' 주식선물 자동갱신(호가)			
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg_1")	' 주식옵션 자동갱신(상단 & 체결)
	DATAMANAGER.CancelRealData("ohhts_sopt_aspr")		' 주식옵션 자동갱신(호가)
	'해외주식
	DATAMANAGER.CancelRealData("ohhts_exst_ictg_1")	' 해외주식 자동갱신(상단 & 체결) 
	DATAMANAGER.CancelRealData("ohhts_exst_cntd_1")	' 해외주식 자동갱신(상단 & 체결) (주간체결)
	DATAMANAGER.CancelRealData("ohhts_exst_aspr")		' 해외주식 자동갱신(호가)	
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")		' 해외주식 자동갱신(호가)
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")		' 해외주식 자동갱신(장후체결)
	'채권
	DATAMANAGER.CancelRealData("ohhts_bond_cntg_1")	' 일반채권 자동갱신(상단 & 체결)	
	DATAMANAGER.CancelRealData("ohhts_bond_aspr_1")	' 일반채권 자동갱신(호가)	
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg")		' 소형채권 자동갱신(상단 & 체결)	
	DATAMANAGER.CancelRealData("ohhts_smbd_aspr")		' 소형채권 자동갱신(호가)
	
	DATAMANAGER.CancelRealData( "ohhts_marg_rate" )	' 메리츠용 필드구성완료
	
	'아래 부분 확인필요.
	
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")	' 업종지수 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg_1")	' 환율 체결 자동갱신	
	
	'해외선물
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg_1")	' 해외선물 체결 자동갱신
	'해외지수
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_1")	' 해외지수/종목 체결 자동갱신
	
	DATAMANAGER.CancelRealData("ohhts_ovtp_cntg_1")	' 시간외단일체결 자동갱신
	
	DATAMANAGER.CancelRealData("ohhts_futs_antg_1")	' 선물 예상체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_kfut_antg_1")	' 선물 예상체결 자동갱신 '			20240930_02 KBC : 섹터선물옵션 (밸류업지수선물 상장)
	DATAMANAGER.CancelRealData("ohhts_optn_antg_1")	' 옵션 예상체결 자동갱신

End Function

'============================================================================
' SetMarginRate
'============================================================================
Function SetMarginRate( nMARG_RATE )
	'20210823 HSZ START : CFD현재가 화면 추가
	if g_szScreenNo == "13100" or g_szScreenNo == "13200" then
		exit function 
	end if
	'20210823 HSZ END
	Dim 	szItemCodeInfo, nColorValue
	szItemCodeInfo = ""
	nColorValue = 18
	Select Case g_szMargState
		Case "58"		
			szItemCodeInfo = "거래정지" '거래정지
			nColorValue = 130
		Case "61"
			szItemCodeInfo = "정리매매" '정리매매
			nColorValue = 130
		Case "51"	
			szItemCodeInfo = "관리종목"	'관리종목
			nColorValue = 131
		Case "63"
			szItemCodeInfo = "단기과열" '단기과열
			nColorValue = 131
		Case "52"
			szItemCodeInfo = "투자위험" '투자위험
			nColorValue = 131
		Case "53"		
			szItemCodeInfo = "투자경고" '투자경고
			nColorValue = 131
		Case "65"
			szItemCodeInfo = "투자유의" '투자유의
			nColorValue = 131
		Case "54"
			szItemCodeInfo = "투자주의" '투자주의
			nColorValue = 131
		Case "64"
			szItemCodeInfo = "투자환기" '투자주의환기
			nColorValue = 131
		'20230613 htw start 신용가능(55) 증거금율(57) 삭제
'		Case "55"
'			szItemCodeInfo = "신용가능"	'신용주문가능
'			nColorValue = 133
'		Case "57"		
'			szItemCodeInfo = "증거금율" '증거금율
'			nColorValue = 128
			'20230613 htw end 신용가능(55) 증거금율(57) 삭제
		Case "56"
			szItemCodeInfo = "신용초과" '신용초과
			nColorValue = 13
		'20230621 htw start 항목 추가
		Case "62"
			szItemCodeInfo = "투자주의"	'ELW
			nColorValue = 13
		Case "60"
			szItemCodeInfo = "조기종료" 'ELW
			nColorValue = 13
		'20230621 htw end 항목 추가
		'20250305 MSH START : 과열예고, 과열연장 추가			
		Case "66"
			szItemCodeInfo = "과열예고" 
			nColorValue = 131
		Case "67"
			szItemCodeInfo = "과열연장" 
			nColorValue = 131
		'20250305 MSH END	
	End Select
	
	g_szGbnName = szItemCodeInfo
	g_szJPer = "증"..nMARG_RATE
	f_SetTopCaption()
	'Container0.Label1.caption =  szItemCodeInfo.." 증"..nMARG_RATE 
	'Container0.Label1.fgcolor = nColorValue

End Function

function f_SetTopCaption()
	Dim szText, nSize
	szText = ""
	nSize = 0
	
	Dim nLen3,nLen4,nLen5
	Dim nDataStart3,nDataStart4,nDataStart5
	'20230613 htw start 신용가능(55) 증거금율(57) 삭제 + 종목코드 표시 제거 + 순서변경

	if g_szJPer <> "" then
		lblLen.caption = g_szJPer
		nLen4 = lblLen.GetLen(g_szJPer)
		
		lblLen.caption = szText
		nDataStart4 = lblLen.GetLen(szText) + 3
		
		'szText = szText .. " | "..g_szJPer
		szText = g_szJPer
	end if
	
	if g_szSinYn <> "" then
		lblLen.caption = g_szSinYn
		nLen5 = lblLen.GetLen(g_szSinYn)
		
		lblLen.caption = szText
		nDataStart5 = lblLen.GetLen(szText) + 3
		
		szText = szText .. " | "..g_szSinYn
	end if
	
	if g_szGbnName <> "" then
		lblLen.caption = g_szGbnName
		nLen3 = lblLen.GetLen(g_szGbnName)
		
		lblLen.caption = szText
		nDataStart3 = lblLen.GetLen(szText) + 3
		
		szText = szText .. " | "..g_szGbnName
	end if	
	Container0.Label1.caption = szText
	
	Dim szColor
	Select Case g_szGbnName
		Case "관리종목"	
			szColor = "131"
		Case "투자위험"
			szColor = "131"
		Case "투자경고"		
			szColor = "131"
		Case "투자주의"
			szColor = "131"
'		Case "신용가능"
'			szColor = "133"
		Case "신용초과"
			szColor = "13"
'		Case "증거금율"		
'			szColor = "128"
		'20230613 htw end 신용가능(55) 증거금율(57) 삭제 + 종목코드 표시 제거 + 순서변경
		Case "거래정지"		
			szColor = "130"
		Case "정리매매"
			szColor = "130"
		Case "단기과열"
			szColor = "131"
		Case "투자환기"
			szColor = "131"
		Case "투자유의"
			szColor = "131"
		'20250305 MSH START : 과열예고, 과열연장 추가			
		Case "과열예고"
			szColor = "131"	
		Case "과열연장"
			szColor = "131"	
		'20250305 MSH END				
	End Select
	
	if g_szGbnName <> "" then
		Container0.Label1.changeTextAttr(nDataStart3,nLen3,326,-4,0)
	else
		Container0.Label1.changeTextAttr(0,lblLen.GetLen(szText),4,-4,0)		'iOS 속성 남아있는 현상 조치
	end if
	
	if "신용불가" == g_szSinYn then
		Container0.Label1.changeTextAttr(nDataStart5,nLen5,6,-4,0)
	end if
	
end function

'============================================================================
' f_MovePrc : 현재가 이동
'============================================================================
Function f_MovePrc()
	Select Case g_szSltMk
		Case "J", "Q", "T", "W", "NJ", "TJ"	' 20250208_01 HWG		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			'20240524_01 KBC : 해외주식 고도화
			if g_szScreenNo == "13101" or g_szScreenNo == "16110" then 'CFD 예외 처리
				Form.OpenScreen("13100", g_szSltCd) '국내CFD 현재가
			else
				Form.OpenScreen("11000", g_szSltCd) '국내주식 현재가
			end if
			
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	/ KF: 20240412 HSZ 코스닥글로벌지수 추가
			Form.OpenScreen("31000", g_szSltCd)		
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54010", "관심종목★" & g_szSltCd & "★" )
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			sKorname = Container0.Label0.caption
			Form.SetSharedData( "&ITEM_CODE" , g_szSltCd )
			Form.SetSharedData( "&ITEM_KORNAME" , sKorname  )
			Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..sKorname.."★".."", "" )			
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..sKorname.."★".."", "" )
			
			'20240524_01 KBC : 해외주식 고도화
			if g_szScreenNo == "13101" or g_szScreenNo == "16110" then 'CFD 예외 처리
				Form.OpenScreen("16100", "") '해외CFD 현재가
			else
				Form.OpenScreen("16000", "") '해외주식 현재가
			end if
		
	End Select

End Function

'============================================================================
' f_MoveChart : 차트 이동
'============================================================================
Function f_MoveChart()
	Select Case g_szSltMk
		Case "J", "Q", "T", "W", "NJ", "TJ"	' 20250208_01 HWG		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			Form.OpenScreen("13000", g_szSltCd)
						
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	/	KF: 20240412 HSZ 코스닥글로벌지수 추가
				Form.OpenScreen("31020", g_szSltCd)
		Case "U"						' 업종코드
				Form.OpenScreen("42030", g_szSltCd)
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54010", "관심종목★" & g_szSltCd & "★" & "3") '20240524_01 KBC : 해외주식 고도화 (채권은 차트화면이 별도도 없어서 현재가로 연동)
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			sKorname = Container0.Label0.caption
			Form.SetSharedData( "&ITEM_CODE" , g_szSltCd )
			Form.SetSharedData( "&ITEM_KORNAME" , sKorname  )	
			Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..sKorname.."★".."", "" )			
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..sKorname.."★".."", "" )
			Form.OpenScreen("16020", "")
		'20250319 MSH START	
		Case "N", "EN", "FN"				' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
			'해외지수
			Form.OpenScreen("42050", g_szSltCd)	
		'20250319 MSH END				
	End Select
End Function

'============================================================================
' f_MoveNews : 뉴스 이동
'============================================================================
Function f_MoveNews()
	dim szSendCode
	szSendCode = ""
	
	Select Case g_szSltMk
		Case "J", "Q", "T", "W", "NJ", "TJ" ' 20250208_01 HWG	' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			szSendCode = g_szSltCd
			Form.OpenScreen("44000", szSendCode)' 뉴스
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
