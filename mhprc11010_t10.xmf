			Form.OpenFramePopup("mhprc11010_p16" , szSendCode , "")			
	End Select
	
End Function

'============================================================================
' f_MoveBtn0 : 좌측하단 버튼 이동
'============================================================================
Function f_MoveBtn0()
	Select Case g_szSltMk
		Case "J", "Q", "T", "W", "NJ", "TJ"	' 20250208_01 HWG	' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
			'20240524_01 KBC : 해외주식 고도화
			if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
				Form.OpenScreen("13200", "관심종목★1" & "★" & g_szSltCd ) '국내CFD 주문
			else
				Form.OpenScreen("12000", "관심종목★1" & "★" & g_szSltCd ) '국내주식 주문
			end if
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	KF: 20240412 HSZ 코스닥글로벌지수 추가
			Form.OpenScreen("31030", "관심종목★1" & "★" & g_szSltCd)
		Case "U"						' 업종코드
			Form.OpenScreen("42000", "3★" & g_szSltCd)
		Case "N", "EN", "FN"				' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
			Form.OpenScreen("42040", g_szSltCd)
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54020", "관심종목★1" & "★" & g_szSltCd)
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			Form.SetSharedData( "&ITEM_CODE" , g_szSltCd )
			Form.SetSharedData( "&ITEM_KORNAME" , g_szSltName )			
			Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )		
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
			szMediaCode = Form.GetSharedData("&MEDIA_CODE", false)			
		
			if szMediaCode == "156" or szMediaCode == "157" then  
				'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
				'20240524_01 KBC : 해외주식 고도화
				if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
					Form.OpenScreen("16200", "1") '매도 '해외CFD 주문
				else
					Form.OpenScreen("16060", "1") '매도 '해외주식 주문
				end if 					
			elseif szMediaCode == "158" or szMediaCode == "159" then 
				'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
				'20240524_01 KBC : 해외주식 고도화
				if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
					Form.OpenScreen("16200", "1") '매도 '해외CFD 주문
				else
					Form.OpenScreen("02000", "1") '매도 '(고유) 해외주식주문
				end if					
			end if
			Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )		
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
	End Select
	
End Function

'============================================================================
' f_MoveBtn1 : 우측하단 버튼 이동
