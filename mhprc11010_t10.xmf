				DATAMANAGER.RequestTranData( "ohhts_1085_001r" ) '하단 당일추정탭 주식(실시간X)
				
			Case  "JF", "JO"	' 주신선물/옵션
				
			Case "F", "MF", "O", "MO",  "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	20240412 HSZ 코스닥글로벌지수 추가
				DATAMANAGER.RequestTranData( "ohhts_3000_005r" ) ''하단 당일추정탭 선물옵션(실시간(X) 
			
			Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP" '해외주식
				
			Case "U"						' 업종코드
	
			Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
	
			Case "B"						' 소액채권, 장내채권
			
		End Select
		
		Container0.hogaTbl.left = 600
		Container0.grdCNTG.left = 600
		Container0.tbl0.left = 11
	end if 
	
	Request_RealData_Right(g_szSltMk)
	
End Sub

