'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'Form.ShowAlert(sEventName & "****" & sParam	)
	g_szPopRow = ""	'20230918 HSZ
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	if sEventName == "GW_LIST" then
		' 20250208_01 HWG START
		if g_szDeviceOS == "2" then 'iOS 그리드 헤더 소팅 초기화
			grdList0.setSortCellID("th_cell1","bd_name")
			grdList0.setSortCellID("th_cell4","bd_debi")
			grdList0.setSortCellID("th_cell5","bd_rate")
			grdList0.setSortCellID("th_cell6","bd_hyun")	
			grdList1.setSortCellID("th_cell1","bd_name")
			grdList1.setSortCellID("th_cell4","bd_debi")
			grdList1.setSortCellID("th_cell5","bd_rate")
			grdList1.setSortCellID("th_cell6","bd_hyun")
			grdList2.setSortCellID("th_cell1","bd_name")
			grdList2.setSortCellID("th_cell4","bd_debi")
			grdList2.setSortCellID("th_cell5","bd_rate")
			grdList2.setSortCellID("th_cell6","bd_hyun")
		end if
		
		if btnVanish.left <> 426 then 
			btnVanish_OnClick()	
		end if
		' 20250208_01 HWG END
		
'Form.Log("GWANSIM GW_LIST", sParam)		
		if sParam <> "" then
			tData = Split(sParam, "♥")			
			g_szGSID = tData(0)
			edtvrsnID.caption = tData(1)
			g_szGubun = tData(2)

			Init_grdMk()		' 실시간 해제

			grdList0.rowcount = 0
			grdList1.rowcount = 0
			grdList2.rowcount = 0
			grdCode.rowcount = 0
			
			Visible_Grid()
	
			' 실시간 하이라이트 표시
			grdList0.highlightuse = "0"
			grdList1.highlightuse = "0"
			grdList2.highlightuse = "0"
			
			sSel = g_szRSelect
			'************************************ SOR_START
			' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업
			if sSel == "4" or sSel == "5" or sSel == "6" or sSel == "7" then
				sSel = "0"				
			end if
			'************************************ SOR_END
				
			if Form.GetEnvData("GW_RORDER") == "1" or Form.GetEnvData("GW_RORDER") == "" then
				Form.SetCtlProp("grdList" & sSel , "highlightuse", "1")
			end if			
	
			' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
			g_szMove = Form.GetEnvData("GW_MOVE")
			if Trim(g_szMove) == "" then
				g_szMove = "0"
			end if
		
			if g_szGSID == "BB" then		' 최근조회 종목
				'szRecent = Form.GetRecentHistory("0") '국내
				szRecent = Form.GetRecentHistory("99") '국내+해외		
				Load_RecentList(szRecent)
			elseif g_szGSID == "CC" then		' 보유종목
			
				'20240524_01 KBC : 해외주식 고도화 (13101, 16110 : 모두 국내CFD,해외CFD잔고조회)
				'
				' obsim_stsv_047r : 국내보유종목	-> obsim_stsv_048r : 해외보유종목
				' obsim_stsv_072r : 국내CFD			-> obsim_stsv_073r : 해외CFD
				' 
				if g_szScreenNo == "13101" or g_szScreenNo == "16110" then '국내CFD/해외CFD
					g_nNextCount = 0
					DATAMANAGER.RequestTranData("obsim_stsv_072r") '국내CFD보유종목 모두 조회후 해외CFD보유종목 조회(obsim_stsv_073r)
				else '국내/해외
					g_nNextCount = 0
					DATAMANAGER.RequestTranData("obsim_stsv_047r") '국내보유종목 모두 조회후 해외보유종목 조회(obsim_stsv_048r)
				end if
			else
				' 관심그룹의 종목을 재설정
				init_GWList()			
			end if
			
			setGridDragEdit() '20240524_01 KBC : 해외주식 고도화
		end if
	
	'20251021 SWJ START
	elseif sEventName == "EDIT_JONGMOK" then
		
		g_savePopupReturned = True
	
	
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 추가 Trigger
	' 20160407 : 종목다중선택 로직 추가
	' ----------------------------------------------------------------------	
	
	'20240524_01 KBC : 해외주식 고도화 (미사용 주석처리)
	
'	elseif sEventName == "GW_ADD" then
'		Dim nRow
'		Dim szCode, szName
'		
'		nRow = 0
'		szCode, szName = "", ""
'		g_tCode = {}
'
'		if sParam <> "" then
'			tData = Split(sParam, "★")	
'			
'		
'			'20211221 HSZ START 예외처리 추가
'			if UBOUND(tData) < 1 then
'				Exit Sub
'			End if
'			'20211221 HSZ END			
'			
'			'  한줄 구분자(:), ` 한줄안의 구분자(`)
'			'  국내종목 : 종목코드.......
'			'  해외종목 : 마켓@종목코드.....			
'			if Trim(tData[0]) <> "" then
'				g_tCode = Split(tData[0], ":")
'				nRow = grdCode.rowcount()		
'				
'				if #g_tCode == 1 then
'					For i = 0 to nRow - 1					
'						szCode = Trim(grdCode.GetCellData("bd_code", i))						
'						szMk = Trim(grdCode.GetCellData("bd_mk", i))
'						szTemp = szMk&"@"&szCode
'						
'						if szCode == Trim(g_tCode[0]) or szTemp == Trim(g_tCode[0]) then
'							szName = Form.GetItemCodeInfo(tData[0], "name")
'							g_szCd = g_tCode[0]
'							
'							Form.MsgBox(g_szTitle, szName & "은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEM", 1)
'							Exit Sub
'						end if
'					Next
'					g_szCd = g_tCode[0]
'					g_GrpName = tData(1)
'					Init_grdMk()		' 실시간 해제					
'					Add_Item(0)
'					
'				elseif #g_tCode > 1 then
'					For j = 0 to #g_tCode - 1
'						For i = 0 to nRow - 1
'							szCode = Trim(grdCode.GetCellData("bd_code", i))
'							szMk = Trim(grdCode.GetCellData("bd_mk", i))
'							szTemp = szMk&"@"&szCode
'							
'							if szCode == Trim(g_tCode[j]) or szTemp == Trim(g_tCode[0]) then
'								g_szCd = g_tCode[j]
'								g_GrpName = tData(1)
'								
'								Form.MsgBox(g_szTitle, "선택종목들 중 이미 등록되어 있는 종목이 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEMS", 1)
'								Exit Sub
'							end if
'						Next					
'
'					Next
'					
'					' 20160411 : 확인이 다 되었으면 리스트에 담는다.
'					For k = 0 to #g_tCode - 1
'						g_szCd = g_tCode[k]
'						g_GrpName = tData(1)
'						Init_grdMk()		' 실시간 해제
'						Add_Item(1)
'					Next	
'						
'					Check_LocalOrServer()
'				end if
'				SetNoticeMsg() '종목없음 안내메시지처리 '20230810 KKM 관심종목 동기화 OFF
'			end if
'		end if
		
	'관심그룹 등록 및 관심종목추가와 삭제에 사용되는 관심그룹수 받음.
	elseif sEventName == "GW_COUNT" then
		g_nGroupCnt = CInt(sParam) 

	' ----------------------------------------------------------------------
	' FID버전 재조회
	' ----------------------------------------------------------------------	
	elseif sEventName == "NEW_FIDVRSN" then
		edtvrsnID.caption = sParam
		
	'20240524_01 KBC START : 해외주식 고도화 (미사용 주석)
	' ----------------------------------------------------------------------
	' 주간거래 시세 추가 20230109 HSZ
	' ----------------------------------------------------------------------	
'	elseif sEventName == "DAY_CHECK" then
'		g_szDaysise = sParam
'		DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) '해외
	'20240524_01 KBC END
	
	' ----------------------------------------------------------------------
	' 우측팝업닫기
	' ----------------------------------------------------------------------	
	elseif sEventName == "CLOSE_RIGHT" then
'Form.Log("GWANSIM CLOSE_RIGHT", "")		
		if g_szDeviceOS == "2" then 'iOS 그리드 헤더 소팅 초기화
			grdList0.setSortCellID("th_cell1","bd_name")
			grdList0.setSortCellID("th_cell4","bd_debi")
			grdList0.setSortCellID("th_cell5","bd_rate")
			grdList0.setSortCellID("th_cell6","bd_hyun")	
			grdList1.setSortCellID("th_cell1","bd_name")
			grdList1.setSortCellID("th_cell4","bd_debi")
			grdList1.setSortCellID("th_cell5","bd_rate")
			grdList1.setSortCellID("th_cell6","bd_hyun")
			grdList2.setSortCellID("th_cell1","bd_name")
			grdList2.setSortCellID("th_cell4","bd_debi")
			grdList2.setSortCellID("th_cell5","bd_rate")
			grdList2.setSortCellID("th_cell6","bd_hyun")
		end if
		
		if btnVanish.left <> 426 then 
			btnVanish_OnClick()	
		end if
		
	' ----------------------------------------------------------------------
	' TOPROW 값 저장	20231026 HSZ START
	' ----------------------------------------------------------------------
	elseif sEventName == "GW_SETTOPROW" then
'Form.Log("GWANSIM GW_SETTOPROW", g_szRSelect)		
		
		'************************************ SOR_START
		' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업 (관심에서 편집 클릭시)
		if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
			' KRX 예상가(1),  NXT 예상가(5), SOR 예상가(7)		
			nToprow = grdList1.toprow
		elseif g_szRSelect == "2" then	' krx단일가
			nToprow = grdList2.toprow
			
		' 20250208_01 HWG START
		elseif g_szRSelect == "4" then
			nToprow = grdList0.toprow
		' 20250208_01 HWG END
		
		else
			nToprow = grdList0.toprow
		end if
		'************************************ SOR_END
		
		szData = DEF_STYLE_NM.."★"..g_szGSID.."★"..nToprow			'관심그룹Key, Toprow값
		Form.SetSharedData("mhprc11011_TOPROW" , szData)
	end if
End Sub

