'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	' ----------------------------------------------------------------------
	' 보유종목 조회(국내/국내CFD/해외/해외CFD)
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_072r" or szTranID == "obsim_stsv_048r" or szTranID == "obsim_stsv_073r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 0, Form.GetSharedData("&USER_ID", false))
	
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGSID)								' 관심그룹ID	
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 국내 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then		
		DATAMANAGER.ClearInputData( false, "ohhts_1020_004r" )
		grdList0.rowcount = "0"		' 종목조회그리드 초기화
		grdList1.rowcount = "0"
		grdList2.rowcount = "0"
		j = 0		

		For i = 0 to grdCode.rowcount-1		
			if grdCode.GetCellData("bd_gubun", i) == "KR" then '국내인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
			
				' 시장구분이 없는것은 종목데이터 조회에서 뺀다. -> HTS는 그냥 던짐..
				' 여기서 MTS마스터에 없는 종목 빼면 싱크문제 생길수 있음. 조회 한다음에 할것!
				'if Trim(szMk) <> "" then
				'if i < 2 then
					'szMk = Trim(grdCode.GetCellData("bd_mk", i))
					szCd = Trim(grdCode.GetCellData("bd_code", i))
					
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, szCd)					

					DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j, szMk)
					DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD",               j, szCd)
					j = j + 1
				'end if
			end if 
		Next

	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 해외 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1030_002r" then	
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		if g_szGubun == "2" then
			' 종목조회그리드 초기화
			grdList0.rowcount = "0"		
			grdList1.rowcount = "0"		
			grdList2.rowcount = "0"	
		end if 
		
		j = 0
		For i = 0 to grdCode.rowcount-1
		    if grdCode.GetCellData("bd_gubun", i) == "OV" then '해외인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				tCode = {}
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j , "OV" ) '해외주식			
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", j , szCd ) ' 종목코드
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", j , szMk ) '종목시장
				' 시장별 실시간여부값
				szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", j, szRealAble ) '실시간여부
				j = j + 1
			end if
		Next
		
	' ----------------------------------------------------------------------
	' 관심 수정 TR : 종목추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_009r" then
		DATAMANAGER.ClearInputData( false, "ohhts_intr_009r" )	
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)						' FID버전ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_MOD_YN",      0, "0")									' FID수정여부				
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")									' FID종목수정여부
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGSID)						' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_GRP_NAME",    0, g_GrpName)						' FID관심그룹명	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_ISSU_MOD_YN",      0, "1")								' FID종목수정여부

		For j = 0 to grdCode.rowcount - 1
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_NEW_GRP_ID", j, g_szGSID)						' FID관심종목그룹	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_ID2",    j, Change_Len(j))					' FID관심종목		

			sMemo     = Trim(grdCode.GetCellData("bd_memo", j))
			sItemCode = Trim(grdCode.GetCellData("bd_code", j))
'Form.Log("GWANSIM", sItemCode)			
			' FID코드구분코드
			if Trim(grdCode.GetCellData("bd_mk", j)) == "" then
				if sMemo == "" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "3")	' 메모
				end if
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "1")		' 종목
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, grdCode.GetCellData("bd_mk", j))' FID입력시장구분코드	
			
			' FID관심종목코드 / FID메모내용
			if sItemCode == "EMPTY" then			' 세개의 리스트그리드가 공통이므로 현재가 그리드만 체크
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_OVDV_ISCD", j, "EMPTY")
				
				'20240524_01 KBC START : 해외주식 고도화
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_MEMO_CNTT", j, grdCode.GetCellData("bd_memo", j))	
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_COL_NAME", j, grdCode.GetCellData("bd_memo_color", j))	
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_SORT", j, grdCode.GetCellData("bd_memo_align", j))	
				'20240524_01 KBC END

			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_OVDV_ISCD", j, grdCode.GetCellData("bd_code", j))
				
				'20240524_01 KBC START : 해외주식 고도화
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_MEMO_CNTT", j, "")	
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_COL_NAME", j, "")
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_SORT", j, "")
				'20240524_01 KBC END
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_GRP_NTNL_CLS_CODE", j, grdCode.GetCellData("bd_gubun", j))
		Next

	'오른쪽사이드화면- 관심종목시세
	elseif szTranID == "ohhts_1020_001r" 
		or szTranID == "ohhts_1020_001r_1"
		or szTranID == "ohhts_1020_001r_2" then
		
		DATAMANAGER.ClearInputData( false, szTranID )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szSltMk )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               0, g_szSltCd )

	'오른쪽사이드화면- 차트(국내)
	elseif szTranID == "ohhts_5010_001r" then
		DATAMANAGER.ClearInputData( false, "ohhts_5010_001r" )		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szSltMk )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               0, g_szSltCd )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szSltMk)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_ISCD",               0, g_szSltCd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE",  0, "Y")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))	
		
	'오른쪽사이드화면- 뉴스
	elseif szTranID == "ohhts_news_001r" then
		DATAMANAGER.ClearInputData( false, "ohhts_news_001r" )		
		if g_szSltGubun == "OV" then '해외
			sCode = Split(g_szSltCd, "@")
			sTemp = f_getExchCode3(sCode(0))
			szDate =  Form.GetSharedData("&HOST_DATE", false)
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "00" )
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_INPUT_DATE"				, 0 , szDate )
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"	, 0 , sTemp&sCode(1) )
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD",  0 , g_szSltCd )
		end if 
		
	'오른쪽사이드화면- 관심종목포함여부(하트표기)
	elseif szTranID == "ohhts_intr_101r" then
		DATAMANAGER.ClearInputData( false, "ohhts_intr_101r" )	
		if g_szSltGubun == "OV" then '해외
			sCode = Split(g_szSltCd, "@")
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_USER_ID", 	0 , Form.GetSharedData("&USER_ID" , false))
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD",  0 , sCode(1))
			szMk = sCode(0)
			szMk = f_getExchCode2(szMk)				
		else		
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_USER_ID", 	0 , Form.GetSharedData("&USER_ID" , false))
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD",  0 , g_szSltCd	)
			szMk = Form.GetItemCodeInfo(g_szSltCd, "market")
			szMk = Change_EtcMarket(szMk)			
		end if 
		
		'20230816 KKM 입력시장구분코드 추가 
		DATAMANAGER.SetDataValue(0, "ohhts_intr_101r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE"	, 0 , szMk)
		
	'오른쪽사이드화면- 하단 호가탭	- 주식 
	'ohhts_stck_aspr, ohhts_stck_incg_1, ohhts_frbr_aspr_1, ohhts_frbr_cntg_1, ohhts_elw_aspr_1, ohhts_elw_cntg_1
	'ohhts_futs_aspr_1, ohhts_futs_cntg_1, ohhts_optn_aspr_1, ohhts_optn_cntg_1, ohhts_sfut_aspr, ohhts_sfut_cntg_1, ohhts_sopt_aspr, ohhts_sopt_cntg_1
	'ohhts_smbd_aspr, ohhts_bond_aspr_1, ohhts_smbd_cntg, ohhts_bond_cntg_1
	elseif szTranID == "ohhts_1001_005r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1001_005r" )		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szSltCd 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szSltMk	)
		
	'오른쪽사이드화면- 하단 체결탭	- 주식 
	'ohhts_stck_cntg, ohhts_futs_cntg_1, ohhts_optn_cntg_1
	elseif szTranID == "ohhts_1001_004r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1001_004r" )		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szSltCd 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szSltMk	)
		
	'오른쪽사이드화면- 하단 당일추정탭 (주식등) 실시간 X
	elseif szTranID == "ohhts_1085_001r" then	
		DATAMANAGER.ClearInputData( false, "ohhts_1085_001r" )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD"						, 0, g_szSltCd  )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_SCTN_CLS_CODE"				, 0, 1 ) '일별
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_DATE1"						, 0, Form.GetSharedData("&HOST_DATE", 0) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_DATE2"						, 0, Form.GetSharedData("&HOST_DATE", 0) )
		
		' 20250208_01 HWG START
		sYN = Form.getItemCodeInfo(g_szSltCd, "isNXT")
		if sYN == "Y" and g_szRSelect == "4" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"			, 0,  "NV")
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"			, 0,  "V")
		end if
		' 20250208_01 HWG END
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD"			   			, 0, g_szSltCd  )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"			, 0, g_szSltMk )
		
	'오른쪽사이드화면- 하단 당일추정탭 (선옵) 실시간 X
	elseif szTranID == "ohhts_3000_005r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szSltMk	)
	    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "InBlock1", "FID_INPUT_ISCD2"				, 0 , g_szSltCd	)
	    
	'오른쪽사이드화면- 차트(해외주식) ohhts_exst_ictg_1, ohhts_exst_cntd_1
	elseif szTranID == "ohhts_5041_001r" then
	
		Dim sTemp, sExid, sCode
		sTemp = split(g_szSltCd, "@")
		sExid = sTemp[0] '시장구분
		sCode = sTemp[1] '종목코드
		g_rtSltChk = Form.GetSharedData( "REALTIME_"..sExid, false )			
	
		DATAMANAGER.ClearInputData( false, "ohhts_5041_001r" )		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sExid)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtSltChk)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_OVRS_ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_COND_MRKT_CLS_CODE" , 0 , sExid)
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE1", 0, Form.GetSharedData("&HOST_DATE", 0))	
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_DATE2", 0, Form.GetSharedData("&HOST_DATE", 0))	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtSltChk)	 
		
	'오른쪽사이드화면- 하단 호가탭(해외주식)  ohhts_exst_aspr, ohhts_exst_cntg
	'오른쪽사이드화면- 하단 체결탭(해외주식)  ohhts_exst_cntg, ohhts_exst_cnta(장후체결), ohhts_exst_cntd_1(주간체결) 
	elseif  szTranID == "ohhts_1030_002r_1"or szTranID == "ohhts_6000_002r" or szTranID == "ohhts_6000_003r" then
		
		Dim sTemp, sExid, sCode
		sTemp = split(g_szSltCd, "@")
		sExid = sTemp[0] '시장구분
		sCode = sTemp[1] '종목코드
		g_rtSltChk = Form.GetSharedData( "REALTIME_"..sExid, false )	

		DATAMANAGER.ClearInputData( false, szTranID )	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sExid)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtSltChk)
		
	'오른쪽사이드화면- 종목명 아래 종목정보
	elseif szTranID == "ohhts_1001_001r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1001_001r" )	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szSltCd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0 , g_szSltMk )
		
	'20241218_01 HWG START
	elseif szTranID == "ohhts_7052_005r" then
		DATAMANAGER.ClearInputData( false, "ohhts_7052_005r" )		
		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szSltMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szSltCd )
		
	elseif szTranID == "ohhts_7052_002r" then
		DATAMANAGER.ClearInputData( false, "ohhts_7052_002r" )		
		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szSltMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_002r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szSltCd )
	'20241218_01 HWG END
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	
	Dim tCode, szCutCd, szName, szOnline, szPre '해외관심종목 TR
	tCode = {}

	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	
	' 보유종목은 NEXT 조회
	' ----------------------------------------------------------------------
	' 보유종목 조회(국내/국내CFD/해외/해외CFD)
	' ----------------------------------------------------------------------	
	 '국내 보유종목,  국내CFD 보유종목
	if szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_072r" then  
		
		'************************************ SOR_START
		' 20250918 이윤성 2차 대체거래소, 중복 실행 방지
'		if g_szGSID <> "CC" then
'			Exit Sub
'		end if	
'		
'		if g_szRunning == "Y" then
'			Exit Sub
'		end if		
'		g_szRunning = "Y"
		'************************************ SOR_END
						
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		if nCnt > 0 then				
			nRow = g_nNextCount			
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				
			For i = 0 to nCnt -1 
				
				szCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", i)
				grdCode.insertrow = nRow
					
				'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
				szMk = Form.GetItemCodeInfo(szCd, "market")
				szMk = Change_EtcMarket(szMk)
				select Case szMk
					Case "Q", "BN", "B"
					
					'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
					Case "J", "NJ", "TJ"	' 20250208_01 HWG
						szCutCd = szCd
					'20210608 SWJ END
						
					Case Else
						szCutCd = Mid(szCd, 2, Len(szCd))
						szMk = Form.GetItemCodeInfo(szCutCd, "market")
				End Select
				'20160729 NOHES END
					
				' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
				' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
				' ETN (mk) = Q, 채권(mk) = BN	
				
				Select Case szMk
					Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF", "NJ", "TJ"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	/	KF: 20240412 HSZ 코스닥글로벌지수 추가
						grdCode.SetCellData("bd_code", nRow, szCutCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					Case "Q", "BN", "B"
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
					Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
					'20160729 NOHES END
					Case Else
						if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
							grdCode.SetCellData("bd_code", nRow, szCutCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						else
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
						end if
				End Select
				' ////////////////////////////////////////////////////////////////////////////////////////////
					
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "KR") '국내
					
				'20251021 SWJ START
				'종목 중복 + 빈 값 나오는 현상(현재는 종목마스터에 없거나의 사유) 삭제 처리
				if Cint(nRow) > 0 then
					if grdCode.GetCellData("bd_code", nRow - 1) == szCutCd and grdCode.GetCellData("bd_mk", nRow - 1) == szMk then
						grdCode.SetDeleteRow(nRow)
					else
						nRow = nRow + 1
					end if
				else
					nRow = nRow + 1
				end if
				
				'ORG SRC
				'nRow = nRow + 1
				'20251021 SWJ END
					
			Next
	'			else 				
	'				 Form.MsgBox("안내", "관심그룹에 등록된 종목이 없습니다.\n종목을 등록하시겠습니까?", "ADD_ITEM", 1)
	
		end if
		
		if szTranID == "obsim_stsv_047r" then '국내 보유종목  NEXT
		
		     g_nNextCount = grdCode.rowcount			    
			if  DATAMANAGER.IsMoreNextData( "obsim_stsv_047r" ) == True then 
				DATAMANAGER.RequestNextData( "obsim_stsv_047r" )
			else
				DATAMANAGER.RequestTranData( "obsim_stsv_048r" )
			end if
			
		elseif szTranID == "obsim_stsv_072r" then '국내CFD 보유종목  NEXT
		
		    g_nNextCount = grdCode.rowcount
			if  DATAMANAGER.IsMoreNextData( "obsim_stsv_072r" ) == True then 
				DATAMANAGER.RequestNextData( "obsim_stsv_072r" )
			else
				DATAMANAGER.RequestTranData( "obsim_stsv_073r" )
				
'				' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
'				Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
'		
'				Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
'				'Save_GWList()에서 g_szCloud = "0"이면 Save_grdMk() 이미 호출함.
'				if g_szCloud <> "0" then
'					Save_grdMk()		
'				end if			
			end if			
		end if
	'해외 보유종목		
	elseif szTranID == "obsim_stsv_048r" then
		
		
		nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1")
		if nCnt > 0 then
			'nRow = 0
			
			nRow = g_nNextCount
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				

			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ISCD", i)
				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "KOR_NAME", i)
				szOnline = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ONLN_YN", i)
				szPre = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "CLPR", i)
				
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_online",   nRow, szOnline)
				grdCode.SetCellData("bd_pre",   nRow, szPre)
				
				' 오프라인종목일경우 종목명은 서비스에서 받아씀
				if szOnline == "N" then
					grdCode.SetCellData("bd_name", nRow, szName)
				else
					grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szMk&"@"&szCutCd, "name"))
				end if
				grdCode.SetCellData("bd_gubun",   nRow, "OV") '해외
				
				'20251021 SWJ START
				'종목 중복 + 빈 값 나오는 현상(현재는 종목마스터에 없거나의 사유) 삭제 처리
				if Cint(nRow) > 0 then
					if  grdCode.GetCellData("bd_code", nRow - 1) == szCutCd and grdCode.GetCellData("bd_mk", nRow - 1) == szMk then
						grdCode.SetDeleteRow(nRow)
					else
						nRow = nRow + 1
					end if
				else
					nRow = nRow + 1
				end if
				
				'ORG SRC
				'nRow = nRow + 1
				'20251021 SWJ END
			Next
'			else
'				if grdCode.rowcount ==  0 then '해외/국내 모두 없는 경우 
'				    Form.MsgBox("안내", "관심그룹에 등록된 종목이 없습니다.\n종목을 등록하시겠습니까?", "ADD_ITEM", 1)
'				end if 				
		end if
		
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_048r" ) == True then '해외 보유종목 NEXT
			 g_nNextCount = grdCode.rowcount
			DATAMANAGER.RequestNextData( "obsim_stsv_048r" )
		else	
			
			' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
			Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
			Form.triggerEvent("##", "SET_VISIBLE", "")
			SetNoticeMsg() '종목없음 안내메시지처리			

			Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
			'Save_GWList()에서 g_szCloud = "0"이면 Save_grdMk() 이미 호출함.
			if g_szCloud <> "0" then
				Save_grdMk()		
			end if
		end if
		
		
		'************************************ SOR_START
		' 20250918 이윤성 2차 대체거래소, 중복 실행 방지		
		'g_szRunning = "N"
		'************************************ SOR_END
		
			
	'해외CFD 보유종목
	elseif szTranID == "obsim_stsv_073r" then '
		nCnt = CInt(DATAMANAGER.GetDataCount(0, "obsim_stsv_073r", "OutBlock1"))
		
		if nCnt > 0 then
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				
			
			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_073r", "OutBlock1", "ISCD", i)
				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_073r", "OutBlock1", "KOR_NAME", i)
				
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szMk&"@"&szCutCd, "name"))
				grdCode.SetCellData("bd_gubun", nRow, "OV") '해외
				
				'20251021 SWJ START
				'종목 중복 + 빈 값 나오는 현상(현재는 종목마스터에 없거나의 사유) 삭제 처리
				if Cint(nRow) > 0 then
					if grdCode.GetCellData("bd_code", nRow - 1) == szCutCd and grdCode.GetCellData("bd_mk", nRow - 1) == szMk then
						grdCode.SetDeleteRow(nRow)
					else
						nRow = nRow + 1
					end if
				else
					nRow = nRow + 1
				end if
				
				'ORG SRC
				'nRow = nRow + 1
				'20251021 SWJ END
			Next
		end if
		
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_073r" ) == True then '해외CFD 보유종목 NEXT
			g_nNextCount = grdCode.rowcount
			DATAMANAGER.RequestNextData( "obsim_stsv_073r" )
		else		
			
			' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
			Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
			Form.triggerEvent("##", "SET_VISIBLE", "") 
			SetNoticeMsg() '종목없음 안내메시지처리
	
			Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
			'Save_GWList()에서 g_szCloud = "0"이면 Save_grdMk() 이미 호출함.
			if g_szCloud <> "0" then
				Save_grdMk()		
			end if			
		end if
		
		
		'************************************ SOR_START
		' 20250918 이윤성 2차 대체거래소, 중복 실행 방지
		'g_szRunning = "N"
		'************************************ SOR_END
			
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회(국내+해외)
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		
		
		'************************************ SOR_START
		' 20250918 이윤성 2차 대체거래소, 중복 실행 방지
		
'		if g_szRunning == "Y" then
'			'Form.ShowAlert("이미 실행중 : 중복실행 방지")
'			Exit Sub
'			
'		end if
		'************************************ SOR_END
		
		'g_szRunning = "Y"		'20250923_2 SWJ START
		
		'20251021 SWJ START
		'하단에 그리드 인덱스 i-index로 만듦..
		'더럽지만 이게 최선(while문 먹이면 앱 crash 남)
		Dim szName
		Dim index
		index = 0
		'20251021 SWJ END
		
		nRow = grdCode.rowcount			
		For i = 0 to nRow - 1 
			szCode = grdCode.GetCellData("bd_code", i - index)
			szGubun = Trim(grdCode.GetCellData("bd_gubun", i - index))
			szMk = grdCode.GetCellData("bd_mk", i - index)
		
			if szCode <> "EMPTY" then '빈칸이 아닌 경우
				if szGubun == "OV" then '해외				
					szName = Form.GetItemCodeInfo(szMk&"@"&szCode, "name")	
				elseif (szGubun == "KR") or (szGubun == "")  then '국내
					szMk = Form.GetItemCodeInfo(szCode, "market")
					szMk = Change_EtcMarket(szMk)
					szName = Form.GetItemCodeInfo(szCode, "name")
					grdCode.SetCellData("bd_gubun",   i - index, "KR") '국내
				end if
			else
				szName = ""
				grdCode.SetCellData("bd_gubun",   i - index, "")
			end if
				
			grdCode.SetCellData("bd_mk", i - index, szMk)
			grdCode.SetCellData("bd_name", i - index, szName)	
			
			'20251021 SWJ START
			'종목 중복 + 빈 값 나오는 현상(현재는 종목마스터에 없거나의 사유) 삭제 처리
			if Cint(i) > 0 then
				if grdCode.GetCellData("bd_code", i  - index - 1) == szCutCd and grdCode.GetCellData("bd_mk", i - index - 1) == szMk then
					grdCode.SetDeleteRow(i - index)
					index = index + 1
				end if
			end if
			'20251021 SWJ END
		Next
		
		' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		SetNoticeMsg() '종목없음 안내메시지처리

		Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
		'Save_GWList()에서 g_szCloud = "0"이면 Save_grdMk() 이미 호출함.
		if g_szCloud <> "0" then
			Save_grdMk()		
		end if		

	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then '국내
	
		Dim tItemData, nIndex, sCellBong, szMk

		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1020_004r", "OutBlock1" ) )	

		if g_szGubun == "1" then '국내
			grdList0.rowcount = nCount
			grdList1.rowcount = nCount
			grdList2.rowcount = nCount
		elseif g_szGubun == "2" then '해외
		
		else '전체
			grdList0.rowcount = grdCode.rowcount
			grdList1.rowcount = grdCode.rowcount
			grdList2.rowcount = grdCode.rowcount
		end if 

		nGridRow = 0 
		nGridExpiredRow = -1 '20240524_01 KBC : 해외주식 고도화		
		
		For i = 0 to grdCode.rowcount - 1		
			szMm = grdCode.GetCellData("bd_memo", i)
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			korname = grdCode.GetCellData("bd_name", i)			
			szbdGubun = grdCode.GetCellData("bd_gubun", i)
			
			'20240524_01 KBC START : 해외주식 고도화
			szMmAlign = grdCode.GetCellData("bd_memo_align", i)
			szMmColor = grdCode.GetCellData("bd_memo_color", i)
			szFlag = f_getItemCi(szMk, szCd, szbdGubun)
			
			if szMmColor == "" then
				szMmColor = "231230230" '메모 배경색 기본값
			end if
			'20240524_01 KBC END

			' MTS에서 보여지지 않는 종목은 종목명에 종목코드 보여주기 -> MTS마스터에 없는 종목 보이지 않기 ++ 
			szMk = f_ChkMarket(szMk, szCd)	
			
			'20240524_01 KBC START : 해외주식 고도화
			'만기된 종목 표시를 정확히 하기위해 인덱스 추가 함
			if g_szGubun == "0" then
				nGridExpiredRow = nGridExpiredRow + 1
			else
				if szbdGubun == "KR" then
					nGridExpiredRow = nGridExpiredRow + 1
				end if
			end if
			'20240524_01 KBC END			
			
			if szbdGubun == "KR" then '국내종목인 경우만 처리 (ohhts_1020_004r 국내시세 응답부분이니...)
				
				For j = 0 to nCount-1		
					
					if g_szGubun == "1" then '국내(필터)
						nGridRow = j
					elseif g_szGubun == "2" then '해외(필터)
						'로직상 해당사항없음					
					else '전체(필터)
						nGridRow = i
					end if 
					
					code = DATAMANAGER.GetDataValue( false, "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD" , j )  '종목코드									
					
					if code == szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가
						szMarketNm = f_GetMarketName(szCd)						
						
						'************************************ SOR_START
						' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업
						if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
							' KRX 예상가(1),  NXT 예상가(5), SOR 예상가(7)
						'************************************ SOR_END
							
							sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ANTC_CNPR", j ) '예상현재가							
							diff		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ANTC_CNTG_PRDY_VRSS" , j ) '예상대비
							sign		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ANTC_PRDY_VRSS_SIGN", j ) '예상대비부호
							rate		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ANTC_CNTG_PRDY_CTRT", j ) '예상대비율
							tvol		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ANTC_VOL", j ) '예상거래량
							
							grdList1.SetCellData( "bd_code" , nGridRow, szCd )
							grdList1.SetCellData( "bd_name" , nGridRow, korname )
							grdList1.SetCellData( "bd_hyun" , nGridRow, sclose )	
							grdList1.SetCellData( "bd_debi" , nGridRow, diff)
							
							'20240524_01 KBC START : 해외주식 고도화
							grdList1.SetCellData( "bd_market" , nGridRow, Trim(szCd) & " " & Trim(szMarketNm) )	
							grdList1.SetMaintainingRatio( "bd_flag", nGridRow, "1") '국기아이콘

							'grdList1.SetCellData( "bd_market" , nGridRow, szMk )
							'grdList1.SetCellData( "bd_market", nGridRow, Trim(szMarketNm) )
							'grdList1.SetCellData( "bd_uicode", nGridRow, Trim(szCd))							
							'20240524_01 KBC END

							grdList1.SetCellData( "bd_flag", nGridRow, szFlag)
							grdList1.SetCellData( "bd_mk" , nGridRow, szMk )
							grdList1.SetCellData( "bd_rate" , nGridRow, rate )							
							grdList1.SetCellData( "bd_vol" , nGridRow, tvol )
							
							
							grdList1.SetCellData( "bd_gubun", nGridRow, szbdGubun )
							grdList1.SetCellData( "bd_debiIcon", nGridRow, sign&"|"&diff)							

						elseif g_szRSelect == "2" then 'KRX 시간외단일가
						
							sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_OVTM_UNTP_PRPR", j ) '시간외현재가							
							diff		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_OVTM_UNTP_PRDY_VRSS" , j ) '시간외대비
							sign		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_OVTM_UNTP_VRSS_SIGN", j ) '시간외대비부호
							rate		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_OVTM_UNTP_PRDY_CTRT", j ) '시간외대비율
							tvol		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_OVTM_UNTP_CNQN", j ) '시간외 체결량
							
							grdList2.SetCellData( "bd_code" , nGridRow, szCd )
							grdList2.SetCellData( "bd_name" , nGridRow, korname )							
							grdList2.SetCellData( "bd_hyun" , nGridRow, sclose )	
							grdList2.SetCellData( "bd_debi" , nGridRow, diff)
							
							'20240524_01 KBC START : 해외주식 고도화
							grdList2.SetCellData( "bd_market" , nGridRow, Trim(szCd) & " " & Trim(szMarketNm) )	
							grdList2.SetMaintainingRatio( "bd_flag", nGridRow, "1") '국기아이콘
							
							'grdList2.SetCellData( "bd_market" , nGridRow, szMk )
							'grdList2.SetCellData( "bd_market" , nGridRow, Trim(szMarketNm) )
							'grdList2.SetCellData( "bd_uicode" , nGridRow, Trim(szCd))								
							'20240524_01 KBC END
							
							grdList2.SetCellData( "bd_flag", nGridRow, szFlag)
							grdList2.SetCellData( "bd_mk"   , nGridRow, szMk )
							grdList2.SetCellData( "bd_rate" , nGridRow, rate )							
							grdList2.SetCellData( "bd_vol"  , nGridRow, tvol )
							
							grdList2.SetCellData( "bd_gubun", nGridRow, szbdGubun )							
							grdList2.SetCellData( "bd_debiIcon", nGridRow, sign&"|"&diff)														
						else 
							
							sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRPR", j ) '현재가							
							diff		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , j ) '대비
							sign		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", j ) '대비부호
							rate		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_CTRT", j ) '대비율
							
							yest		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_CLPR", j ) '기준가(전일종가)
							open		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_CPRC", j ) '시가
							high		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_HPRC", j ) '고가
							low		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_LPRC", j ) '저가
							sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRPR", j ) '종가
							code		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD", j ) '코드
							tvol		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ACML_VOL", j ) '거래량
							
							
							sCellBong  = yest & "|" & open & "|" & high & "|" & low & "|" & sclose							
							'Form.Log("GWANSIM 국내 1", szCd + ":" + code + ":" + nGridRow)
													
							
							grdList0.SetCellData( "bd_code" , nGridRow, szCd )
							grdList0.SetCellData( "bd_name" , nGridRow, korname )	
							
							'20240524_01 KBC START : 해외주식 고도화
							grdList0.SetCellData( "bd_market" , nGridRow, Trim(szCd) & " " & Trim(szMarketNm) )														
							grdList0.SetMaintainingRatio( "bd_flag", nGridRow, "1") '국기아이콘
							
							'grdList0.SetCellData( "bd_market" , nGridRow, szMk )
							'grdList0.SetCellData( "bd_market" , nGridRow, Trim(szMarketNm) )
							'grdList0.SetCellData( "bd_uicode" , nGridRow, Trim(szCd))							
							'20240524_01 KBC END
							
							grdList0.SetCellData( "bd_flag", nGridRow, szFlag)
							grdList0.SetCellData( "bd_mk" , nGridRow, szMk )
							grdList0.SetCellData( "bd_gubun", nGridRow, szbdGubun )
							
							
							' 20250403 이윤성 대체거래소 1차개선 NXT일때 => NXT종목은 disable 처리, KRX일때는 disable 제거
							Dim szNxtYn			
							szNxtYn = Form.GetItemCodeInfo(szCd , "isNXT")		' NXT 종목 여부 (Y, N)																						
							
							'Form.ShowAlert(szNxtYn, szMarketNm)
							'ETN, 수익증권, K-OTC, 선물옵션, 채권, 업종지수, 신주인수권, elw, KONEX
							
							if szNxtYn = "N" and (g_szRSelect = "4" or g_szRSelect = "5") and (Trim(szMarketNm) = "KOSDAQ" or Trim(szMarketNm) = "KOSPI" 
								or Trim(szMarketNm) = "ETF" or Trim(szMarketNm) = "ETN" or Trim(szMarketNm) = "수익증권" or Trim(szMarketNm) = "K-OTC"
								or Trim(szMarketNm) = "선물옵션" or Trim(szMarketNm) = "채권" or Trim(szMarketNm) = "업종지수"
								or Trim(szMarketNm) = "신주인수권" or Trim(szMarketNm) = "ELW" or Trim(szMarketNm) = "KONEX") then
								
								' -------------------- N: "NXT"종목일때
								grdList0.SetCellData( "bd_hyun" , nGridRow, "" )
								grdList0.SetCellData( "bd_debi" , nGridRow, "")
								grdList0.SetCellData( "bd_rate" , nGridRow, "" )
								'grdList0.SetCellData( "bd_bong" , nGridRow,  "")
								grdList0.SetCellData( "bd_vol" , nGridRow, "" )
								grdList0.SetCellData( "bd_debiIcon", nGridRow, "|")
								grdList0.SetCellFgColor("bd_name", nGridExpiredRow, "127")								
								
							else
								' -------------------- Y: "KRX"종목일때								
								grdList0.SetCellData( "bd_hyun" , nGridRow, sclose )	
								grdList0.SetCellData( "bd_debi" , nGridRow, diff)															
								
								grdList0.SetCellData( "bd_rate" , nGridRow, rate )							
								grdList0.SetCellData( "bd_bong" , nGridRow, sCellBong )
								grdList0.SetCellData( "bd_vol" , nGridRow, tvol )														
								grdList0.SetCellData( "bd_debiIcon", nGridRow, sign&"|"&diff)	
							end if 
							
							
						end if
						
						swapItemColor( nGridRow, CDbl(diff), rate)
					end if 
					
					
				Next
			
				'20240524_01 KBC START : 해외주식 고도화 (i -> nGridExpiredRow 로 변경)
				' MTS에서 보여지지 않는 종목은 종목명에 종목코드 보여주기 -> MTS마스터에 없는 종목 보이지 않기 ++ 
				if Trim(szMk) == "" and Trim(szCd) <> "EMPTY" then
					
					'************************************ SOR_START
					' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업
					if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
						' KRX 예상가(1),  NXT 예상가(5), SOR 예상가(7)
					'************************************ SOR_END
					
						grdList1.SetCellData( "bd_code" , nGridExpiredRow, szCd )
						grdList1.SetCellData("bd_name", nGridExpiredRow, szCd)
						grdList1.SetCellFgColor("bd_name", nGridExpiredRow, "127")	' 글자색_메뉴비활성글자색
						
					elseif g_szRSelect == "2" then	' krx단일가
						grdList2.SetCellData( "bd_code" , nGridExpiredRow, szCd )
						grdList2.SetCellData("bd_name", nGridExpiredRow, szCd)
						grdList2.SetCellFgColor("bd_name", nGridExpiredRow, "127")
					else
						'Form.Log("GWANSIM 국내 2", szCd + ":" + nGridExpiredRow)
						grdList0.SetCellData( "bd_code" , nGridExpiredRow, szCd )
						grdList0.SetCellData("bd_name", nGridExpiredRow, szCd)
						grdList0.SetCellFgColor("bd_name", nGridExpiredRow, "127")
					end if
				end if
				'20240524_01 KBC END				
				
			else				
				if (g_szGubun == "0") then '전체일때
					if szbdGubun <> "OV" then '국내도 해외도 아닌 관심데이터 처리
						'Form.Log("GWANSIM 기타 1", szMm + ":" + i)					
						
						'빈칸처리
						'************************************ SOR_START
						' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업
						if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
							' KRX 예상가(1),  NXT 예상가(5), SOR 예상가(7)
						'************************************ SOR_END
						
							grdList1.SetPropGridCell("memo", "bd_code", i, szMm)
							
							'20240524_01 KBC START : 해외주식 고도화
							grdList1.SetPropGridCell("memohalign", "bd_code", i, szMmAlign)
							grdList1.SetPropGridCell("memobgcolor", "bd_code", i, szMmColor)							
							
							if szMmColor == g_color_list(0) or szMmColor == g_color_list(1) or szMmColor == g_color_list(3) or
							   szMmColor == g_color_list(4) or szMmColor == g_color_list(5) or szMmColor == g_color_list(6) or
							   szMmColor == g_color_list(7) or szMmColor == g_color_list(10) then
								'글자색 검정
								grdList1.SetPropGridCell("memofgcolor", "bd_code", i, "000000000") 
							else 
								'글자색 흰색
								grdList1.SetPropGridCell("memofgcolor", "bd_code", i, "255255255") 
							
							end if
							'20240524_01 KBC END
								
							grdList1.SetCellData( "bd_gubun", i, szbdGubun )
							
						elseif g_szRSelect == "2" then
							grdList2.SetPropGridCell("memo", "bd_code", i, szMm)
							
							'20240524_01 KBC START : 해외주식 고도화
							grdList2.SetPropGridCell("memohalign", "bd_code", i, szMmAlign)
							grdList2.SetPropGridCell("memobgcolor", "bd_code", i, szMmColor)
							
							if szMmColor == g_color_list(0) or szMmColor == g_color_list(1) or szMmColor == g_color_list(3) or
							   szMmColor == g_color_list(4) or szMmColor == g_color_list(5) or szMmColor == g_color_list(6) or
							   szMmColor == g_color_list(7) or szMmColor == g_color_list(10) then
								'글자색 검정
								grdList2.SetPropGridCell("memofgcolor", "bd_code", i, "000000000") 
							else 
								'글자색 흰색
								grdList2.SetPropGridCell("memofgcolor", "bd_code", i, "255255255") 
							
							end if							
							'20240524_01 KBC END																

							grdList2.SetCellData( "bd_gubun", i, szbdGubun )
						else
							grdList0.SetPropGridCell("memo", "bd_code", i, szMm)
							
							'20240524_01 KBC START : 해외주식 고도화
							grdList0.SetPropGridCell("memohalign", "bd_code", i, szMmAlign)
							grdList0.SetPropGridCell("memobgcolor", "bd_code", i, szMmColor)
							
							if szMmColor == g_color_list(0) or szMmColor == g_color_list(1) or szMmColor == g_color_list(3) or
							   szMmColor == g_color_list(4) or szMmColor == g_color_list(5) or szMmColor == g_color_list(6) or
							   szMmColor == g_color_list(7) or szMmColor == g_color_list(10) then
								'글자색 검정
								grdList0.SetPropGridCell("memofgcolor", "bd_code", i, "000000000") 
							else 
								'글자색 흰색
								grdList0.SetPropGridCell("memofgcolor", "bd_code", i, "255255255") 
							
							end if	
							'20240524_01 KBC END																
							grdList0.SetCellData( "bd_gubun", i, szbdGubun)
						end if
					end if
				end if 
			end if

		Next		
		
'		' //////////////////////////////////////////////////////////////////
'		
		if (g_szGubun <> "1") then '전체,해외 
			DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) '해외
		else 
			'최대 220 종목만 시세조회가 가능
			if Cint(grdList0.rowcount) > 220 then
				grdList0.rowcount = 220
			end if 
			if Cint(grdList1.rowcount) > 220 then
				grdList1.rowcount = 220
			end if 
			if Cint(grdList2.rowcount) > 220 then
				grdList2.rowcount = 220
			end if 		
		
			'최근조회/보유종목이 아닐 경우 하단의 종목추가/편집/공유 버튼에 종목시세가 가려지지 않도록 
			'Row를 하나 추가 >> 정렬문제로 높이 조절
			if g_szGSID <> "BB" and g_szGSID <> "CC" then
				if Cint(grdList0.rowcount)  > DEF_GRID_CNT then
					grdList0.height = 433
				end if 
				if Cint(grdList1.rowcount)  > DEF_GRID_CNT then
					grdList1.height = 433
				end if 
				if Cint(grdList2.rowcount)  > DEF_GRID_CNT then
					grdList2.height = 433
				end if
			else 
				grdList0.height = 477
				grdList1.height = 477
				grdList2.height = 477
			end if	
			
			'20230718
			grdList0.keyall = "1"
			grdList1.keyall = "1"
			grdList2.keyall = "1"
			
			' 실시간을 위한 작업 ////////////////////////////////////////////// 
			'국내
			For j = 0 to grdMk.rowcount - 1
				szCd = grdMk.GetCellData("bd_code", j)
				szMk = grdMk.GetCellData("bd_mk", j)

				if szCd <> "" and szMk <> "" then
					tCode = Split(szCd, "★")
					
					For k = 0 to #tCode-1
						' MTS에서 보여주는 상품의 종목만 선택
						szMk = f_ChkMarket(szMk, tCode(k))
						if szMk <> ""  then
							Set_Real_Input(szMk, k, tCode(k))							
						end if
					Next

					Request_RealData(szMk)
				end if
			Next				
			
			'20241218_01 HWG START 
			szData = 0
			if g_szSortHeader == "th_cell1" then
				szData = 4
			elseif g_szSortHeader == "th_cell6" then
				szData = 5
			elseif g_szSortHeader == "th_cell4" then
				szData = 6
			elseif g_szSortHeader == "th_cell5" then
				if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then ' 20250208_01 HWG
					szData = 7
				else
					szData = 6
				end if								
			end if			
			
			'20251021 SWJ START			
			'순서 변경, TopRow를 앞으로
			'소팅 기능있으면 Top row 세팅 안함(의미없음)
			'SetNoticeMsg() '종목없음 안내메시지처리
			if szData == 0 then
				Form.SetTimerEvent2(1, 1, 0.1)	'20231026 HSZ START: TOPROW 세팅
			end if
			
			if g_savePopupReturned then
				g_sData = szData 
				Form.setDelayEvent(1, 1)
			
			else
				'************************************ SOR_START
				' 20250507 이윤성 2차 대체거래소 NXT,SOR 추가작업
				if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then '예상가
					' KRX 예상가(1),  NXT 예상가(5), SOR 예상가(7)
				'************************************ SOR_END
					
					grdList1.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
				elseif g_szRSelect == "2" then 
					grdList2.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
				else 
					grdList0.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
				end if
			end if
			'20241218_01 HWG END
			
			'20251021 SWJ END
			
		end if 
		
	elseif szTranID == "ohhts_1030_002r" then	'해외(주간포함시세)
