			Form.SetSharedData( "&ITEM_CODE" , g_szSltCd )
			Form.SetSharedData( "&ITEM_KORNAME" , g_szSltName )	
			Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
			szMediaCode = Form.GetSharedData("&MEDIA_CODE", false)
			
			if szMediaCode == "156" or szMediaCode == "157" then  
				'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
				'20240524_01 KBC : 해외주식 고도화
				if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
					Form.OpenScreen("16200", "0") '매수 '해외CFD 주문
				else
					Form.OpenScreen("16060", "0") '매수 '해외주식 주문
				end if 					
			elseif szMediaCode == "158" or szMediaCode == "159" then 
				'if (g_szScreenNo == "13101" or g_szScreenNo == "16110") and (g_szGSID == g_tKey[1]) then '국내CFD & CFD보유종목탭
				'20240524_01 KBC : 해외주식 고도화
				if (g_szScreenNo == "13101" or g_szScreenNo == "16110") then
					Form.OpenScreen("16200", "0") '매수 '해외CFD 주문
				else 
					Form.OpenScreen("02000", "0") '매수 '(고유) 해외주식주문
				end if					
				
			end if
			Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
	End Select
	
End Function

