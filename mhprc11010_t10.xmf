'	szData = DEF_STYLE_NM.."★"..g_szGSID.."★"..nToprow			'스타일, 관심그룹Key, Toprow값
'	Form.SetSharedData("mhprc11011_TOPROW" , szData)

End Sub
'20231026 HSZ END

'============================================================================
'20231026 HSZ START: TOPROW 세팅
Sub Setting_Toprow()
	szData = Form.GetSharedData("mhprc11011_TOPROW", True )
	
	if szData == ""  then
		Exit Sub
	elseif Instr(szData, "★") < 0 then
		Exit Sub
	end if
	
	AryData = Split(szData, "★")
	nRowCnt = CInt(grdList0.rowcount)
	nRowIdx = CInt(AryData(2))
	
	if AryData(0) <> DEF_STYLE_NM then
		exit Sub
	end if
	
	'20231219 SWJ START
	'iOS 메인에 nRowCnt, nRowIdx가 같을 때부터 예외처리 되고 있음
	'추후 메인에서 등호 빼서 나갈 예정
	'우선 -2로 화면에서 임시 처리
	if nRowCnt - 1 < nRowIdx then
		if nRowCnt == nRowIdx then
			nRowIdx = nRowCnt - 1
		else
			nRowIdx = nRowCnt - 2
		end if
	end if
	'20231219 SWJ END
	
	if g_szGSID == AryData(1) then
		if CInt(g_szRSelect) == 1 then
			grdList1.toprow = nRowIdx
		elseif CInt(g_szRSelect) == 2 then
			grdList2.toprow = nRowIdx
		elseif CInt(g_szRSelect) == 0 or CInt(g_szRSelect) == 4 then	' 20250208_01 HWG
			grdList0.toprow = nRowIdx
		end if
	end if
end Sub 

'===========================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(1, 0, 0.1)
	Setting_Toprow()
End Sub
'20231026 HSZ END

'===========================================================================
'20240826_01 KBC START : 관심종목 2차개선 (관심그룹/관심종목 스크롤 저장 변경)
Sub Getting_Toprow()
	'************************************ SOR_START
	' 20250507 이윤성 2차 대체거래소 SOR 추가작업
	if g_szRSelect == "1" or g_szRSelect == "5" or g_szRSelect == "7" then
	'************************************ SOR_END	
		nToprow = grdList1.toprow
	elseif g_szRSelect == "2" then
		nToprow = grdList2.toprow
	else
		nToprow = grdList0.toprow
	end if
	
	szData = DEF_STYLE_NM.."★"..g_szGSID.."★"..nToprow '스타일, 관심그룹Key, Toprow값
	Form.SetSharedData("mhprc11011_TOPROW" , szData)
End Sub
'20240826_01 KBC END

'============================================================================
'	(조회) 거래소 국기이미지명 획득
'============================================================================
Function f_getItemCi(szMk, szCode, szbdGubun)

	if szbdGubun == "KR" then
		sGroupID = "CI_KOR"
		
		szImgNm = Form.getIconImg(sGroupID, szCode) '종목 로고
		
		if szImgNm == "" then
		
			szMrk = Form.getItemCodeInfo(szCode, "market")
'Form.Log("GWANSIM", szMrk & ":" & szCode)		

			'EN	: 환율		MARKET_TYPE_OVERSEA_EXRATE
			'UJ	: 해외지수	MARKET_TYPE_OVERSEA_INDEX
			'FN	: 해외선물	MARKET_TYPE_OVERSEA_FUTURE
			if szMrk == "EN" or szMrk == "UJ" or szMrk == "FN" then
				szImgNm = "flag_general"
			else
				szImgNm = "flag_kor_round"
			end if
		end if		
		
	else
		'해외종목
		sGroupID = ""
		szImgNm = ""
		
		if Instr(szCode, "@") > 0 then
			'여기는 안타지만 로직음 혹시몰라 둠
			szData = Split(szCode, "@")
			szMk = szData(0)
			szCode = szData(1)
		end if
		
		if szMk = "AX" or szMk = "NY" or szMk = "OQ" then
			sGroupID = "CI_USD"
		elseif szMk = "JP" then
			sGroupID = "CI_JPN"
		elseif szMk = "SH" or szMk = "SZ" then
			sGroupID = "CI_CHN"
		elseif szMk = "HK" then
			sGroupID = "CI_HKG"
		else
			sGroupID = "CI_KOR"
		end if
	
		szImgNm = Form.getIconImg(sGroupID, szCode)		'종목 로고
		
		if szImgNm == "" then
			szImgNm = Form.getIconImg("MK_FLAG", szMk)	'거래소코드 -> 국가이미지명
			
			if szImgNm == "" then
				szImgNm = "flag_general"
			end if
		end if		
	end if

	f_getItemCi = szImgNm

'	szImgNm = Form.getIconImg(sGroupID, szCode)		'종목 로고
'	
'	if szImgNm == "" then
'		szImgNm = Form.getIconImg("MK_FLAG", szMk)	'거래소코드 -> 국가이미지명
'				
'		if szImgNm == "" then
'			if szbdGubun == "KR" then
'				szImgNm = "flag_kor_round"
'			elseif szbdGubun == "OV" then
'				szImgNm = "flag_general"
'			end if
'		end if
'	end if
'	
'	f_getItemCi = szImgNm
End Function

