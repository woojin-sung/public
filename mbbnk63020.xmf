'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_지연이체
' 02. 화면설명 : 지연이체내역조회 및 취소 탭화면
' 03. 작    성 : 16.03.04 ~ 테스트3
' 04. 수    정 : 2021.02.22. 장원혁 v001 모바일OTP 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szID         '사용자 아이디
Dim g_lRow 
Dim g_sOtpTrMsg
Dim plain_rm 
Dim g_currentIndex
'***************************************************************************
'     P R I V A T E     F U N C T I O N
'***************************************************************************
Function SendCancel()
    '추가인증-> 보안매체-> 공인인증 순으로 처리 여부 확인 필요?
	'Form.OpenFramePopup("mhetc90060_p8" , "bank_reservation" , "")   
	'szDlog1  = Form. OpenDialog( "mhetc90060_p9", "" , "") '보안카드/OTP/스마트OTP
	'szDlog2  = Form. OpenDialog( "mhetc90060_p5", "" , "") '공인인증///
	'-> 팝업 리턴 처리?!
	
	   szACNO = Grid1.GetCellData( "bd_cell12", g_lRow)
	   szASNO = Grid1.GetCellData( "bd_cell9", g_lRow)	
	   szDate = Grid1.GetCellData( "Date", g_lRow)
	   szTime = Grid1.GetCellData( "StartTime", g_lRow)
	   szSrno = Grid1.GetCellData( "bd_cell10", g_lRow)
	   szDiv  = Grid1.GetCellData( "bd_cell11", g_lRow)
	   
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACPT_DATE", 0 , szDate )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACPT_SRNO" , 0 , szSrno )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "REG_ACNO" , 0 , szACNO )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "REG_ASNO" , 0 , szASNO )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , szDiv )
	   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACPT_HOUR", 0 , szTime )
	   if plain_rm = "1" then
		   DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPwd", "caption") )
	   else
	       DATAMANAGER.SetDataValue( 0,"obtss_elbs_011c", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPwd", "encdata") )
	   end if

       DATAMANAGER.RequestTranData( "obtss_elbs_011c" )
End Function

'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'===========================================================================

Sub Form_OnFormInit()
	
	szData = Form.GetOpenLinkData()
	
	If Len(szData) > 0 Then
	    acnt0.caption = szData
	End If
	
	Grid1.setUseCardView(true,10,"input_03_n.9.png")

'	Grid1.SetClear( )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	g_szID = Form.GetSharedData("&USER_ID", false )
    
    g_currentIndex = 0
	DATAMANAGER.RequestTranData("obtss_elbs_011r")
	g_sOtpTrMsg = ""
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    
	If szTranID == "obtss_elbs_011r" then
	    
		Grid1.SetClear( )
        
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "REG_ACNO", 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "REG_ASNO", 0 , acnt0.sequence)
		
		If Combo0.currentindex == 0 Or Combo0.currentindex == "0" Then
		    DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "PROS_YN", 0 , "%")
		ElseIf Combo0.currentindex == 1 Or Combo0.currentindex == "1" Then '처리완료
		    DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "PROS_YN", 0 , "Y")
		ElseIf Combo0.currentindex == 2 Or Combo0.currentindex == "2" Then '미처리
		    DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "PROS_YN", 0 , "N")
		ElseIf Combo0.currentindex == 3 Or Combo0.currentindex == "3" Then '취소
		    DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "PROS_YN", 0 , "C")
		ElseIf Combo0.currentindex == 4 Or Combo0.currentindex == "4" Then '불능
		    DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "PROS_YN", 0 , "F")
		Else
		    DATAMANAGER.SetDataValue( 0, "obtss_elbs_011r", "InBlock1", "PROS_YN", 0 , "%")
		End If

	elseif szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		
		if plain_rm = "1" then
			sACNO_PWD = Form.GetCtlProp("edtPwd", "caption")
	     else
		     sACNO_PWD = Form.GetCtlProp("edtPwd", "encdata")
	     end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , acnt0.total )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
    End If
End Sub  


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtss_elbs_011r" then
	    
		Dim szAcount
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obtss_elbs_011r", "OutBlock1")
		Label2.caption = " "..nCnt

		for i= 0 to nCnt -1
			szAcc1 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "RCVN_ACNO", i)
			szAcc2 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNFT_ACNO", i)
			szAcc3 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNFT_ASNO", i)
			szAcNM1 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "RMT_NAME" , i )
			szAcNM2 = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNFT_ACNM" , i )
			szPros = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "PROS_YN", i )
			szProTime = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "PROS_HOUR", i )	'취소시간
			szCanTime = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "CNCL_YMDH", i )	'취소시간

			szAcount = szAcc1&szAcc2&szAcc3
			if Len(szAcount) == 10 then
				Dim SetAcc
				SetAcc = Left(szAcount,4)&"-"&Mid(szAcount,5,4)&"-"&Right(szAcount,2)
			end if
			
			Grid1.SetCellData( "left_title1", g_currentIndex, "접수일시" )
			Grid1.SetCellData( "left_title2", g_currentIndex, "받는계좌" )
			Grid1.SetCellData( "left_title3", g_currentIndex, "이체금액" )
			Grid1.SetCellData( "left_title4", g_currentIndex, "처리결과" )
			
'			If szPros == "Y" or szPros == "F" then	
'				Grid1.SetCellData( "left_title5", g_currentIndex, "이체시간" )
'				Grid1.SetCellData( "CancelTime", g_currentIndex, szProTime )
			If szPros == "Y" then	
				Grid1.SetCellData( "left_title5", g_currentIndex, "이체시간" )
				Grid1.SetCellData( "CancelTime", g_currentIndex, szProTime )
			Elseif szPros == "F" then	
				Grid1.SetCellData( "left_title5", g_currentIndex, "처리시간" )
				Grid1.SetCellData( "CancelTime", g_currentIndex, "" )
			Elseif szPros == "C" then	'취소완료
				Grid1.SetCellData( "left_title5", g_currentIndex, "취소시간" )
				Grid1.SetCellData( "CancelTime", g_currentIndex, szCanTime )
			else		'아직 취소처리가 되지 않음
				Grid1.SetCellData( "left_title5", g_currentIndex, "취소시간" )
			End If
			
			if Len(szAcount) == 10 then
				Dim SetAcc
				SetAcc = Left(szAcount,4)&"-"&Mid(szAcount,5,4)&"-"&Right(szAcount,2)
				Grid1.SetCellData( "AcntNo", g_currentIndex, SetAcc )
			else
				Grid1.SetCellData( "AcntNo", g_currentIndex, szAcount )
			end if
			
			szFinsh = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "PROS_YN" , i )'처리여부
			
			Grid1.SetCellEnable( "btn_Cancel", g_currentIndex, false )
			If Grid1.GetCellData("Result", g_currentIndex) == "미처리" Then
			    Grid1.SetCellEnable("btn_Cancel", g_currentIndex , True)
			End If
			
			if szFinsh == "Y" then
			elseif szFinsh == "N" then
				Grid1.SetCellData( "btn_Cancel", g_currentIndex, "취소하기" )
				Grid1.SetCellImage( "btn_Cancel", g_currentIndex, "login_cert_tw.9")
			end if
			
			szImg = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011r", "OutBlock1", "BANK_CODE" , i )
			Grid1.SetCellData( "Bank_Img", g_currentIndex, "bank"..szImg..".png" )
			Grid1.SetCellData( "Name", g_currentIndex,  szAcNM1&szAcNM2 )
			'=======
			'Grid1.SetCellBgColor("left_title4", g_currentIndex, "87")
			'Grid1.SetCellBgColor("Result", g_currentIndex, "87")
			'Grid1.SetCellBgColor("left_title5", g_currentIndex, "87")
			'Grid1.SetCellBgColor("CancelTime", g_currentIndex, "87")
			'Grid1.SetCellBgColor("bd_cell42", g_currentIndex, "87")
			'Grid1.SetCellBgColor("bd_cell48", g_currentIndex, "87")
			'Grid1.SetCellBgColor("bd_cell49", g_currentIndex, "87")
			'Grid1.SetCellBgColor("bd_cell55", g_currentIndex, "87")
			'======
			g_currentIndex = g_currentIndex + 1
		next
		
		If DATAMANAGER.IsMoreNextData("obtss_elbs_011r") == True Then
		    DATAMANAGER.RequestNextData("obtss_elbs_011r")
		End If
		
	ElseIf szTranID == "obtss_elbs_011c"  then
		szPros = DATAMANAGER.GetDataValue( 0, "obtss_elbs_011c", "OutBlock1", "PROS_YN" , 0 )  
		if szPros == "C" then'취소완료 
			Form.MsgBox("알림", "지연이체취소가 완료되었습니다.", "완료", "6")
			g_currentIndex = 0
			DATAMANAGER.RequestTranData("obtss_elbs_011r")
		end if
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				trAmt =  Grid1.GetCellData("Money", g_lRow)
				g_sOtpTrMsg = Grid1.GetCellData("bd_cell17", g_lRow) & "#" & Grid1.GetCellData("AcntNo", g_lRow) & "#" & Grid1.GetCellData("Name", g_lRow) & "#" & FormatNumber(CDbl(trAmt), 0, 0, 0, -1) & "원#"
				Form.SetSharedData("SOTP_ATHN_BSWR_CLCD" , "2")
				Form.SetSharedData("SOTP_TR_DTL_CNTT" , g_sOtpTrMsg)
				
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4" 'v001
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" ) '모바일 OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	End If
End Sub


'============================================================================


'============================================================================
Sub Grid1_OnClickUp(lRow, szCellID)

	If Grid1.GetCellData( "Result", lRow) == "미처리" then
		
		if szCellID == "btn_Cancel" then
			if Form.GetCtlProp( "edtPwd", "caption") == "" then
			   Form.ShowAlert( "알림", "비밀번호를 확인하십시오.")
			   Exit Sub
			end if
			g_lRow = lRow
'			Form.MsgBox("알림", "지연이체 접수내역을 취소하시겠습니까?", "취소", "6")
			'Form.OpenPopup("mbbnk63020_p0", "", "")
			Form.openPopupAnimation("mbbnk63020_p0","","","2")
		end if
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID ) 
	
	if szErrMsg ~= "" or szErrMsg ~= Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	if szTranID == "obtss_elbs_011c" then
		Form.ShowAlert( "알림", szErrMsg)
		g_currentIndex = 0
		DATAMANAGER.RequestTranData("obtss_elbs_011r")
	end if
	
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "완료" then
	   if sRet == "close" then
           g_currentIndex = 0
	      DATAMANAGER.RequestTranData("obcsb_elbs_011r")
	   end if
	'ElseIf sKeyName == "취소" then
	   
	   'if sRet == "close" then
		   
		   '	      Call SendCancel()
	   'end if
	End If   
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName =="CHANGEACC" or  sEventName == "61010_RETURN"  then
	   Form_OnFormInit()
	
	ElseIf sEventName == "AllAccount" then
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		'g_szAccount = szList(0) & szList(1)
		'Form.ShowAlert("지연이체", g_szAccount)
		
        Form_OnFormInit()
	ElseIf sEventName == "CANCEL" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )	'추가인증
	End If	
End Sub

