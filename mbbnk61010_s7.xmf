	<CONTROL_INFO>
		<LABEL name="Label2" caption=" " ly_vert="0,181,335,69,1" />
		<LABEL name="Label5" fgcolor="065:102102102" fontsize="-2" caption="간편인증비밀번호" ly_vert="20,104,129,39,1" />
		<BUTTON name="BtnSpinPwd" fgcolor="095:000000000" btnimage="btn_02.9" ly_vert="168,104,147,39,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2700" _ulen="2452" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 이체_간편인증Only
' 02. 화면설명 : 이체예정내역 간편인증 연결화면(간편인증 Only)
' 03. 작    성 : 2016.10.19 최일규
' 2020.11.13 : 정민영 : v0003 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_520r,obcsb_simf_000r,ohhts_ocsp_001r 미사용TR 삭제
'            : 정민영 : v0004 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sSpinCertYn

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	g_sRetData = "cancel"	
	g_sSpinCertYn = "N"

End Sub

'============================================================================
Sub BtnSpinPwd_OnClick()
	Form.OpenPopup("mhetc90060_px", "", "")
End Sub

'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			g_sSpinCertYn = "Y"
			BtnSpinPwd.caption = "＊＊＊＊"
			Form.triggerEvent("#", "간편인증", "Success")
		ElseIf sRet == "cancel" Then
			g_sSpinCertYn = "N"
			BtnSpinPwd.caption = ""
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "이체확인" then
		if g_sSpinCertYn <> "Y" then
			Form.MsgBox("알림", "간편인증 비밀번호를 입력하세요", "", 6)
			Exit Sub
		else
			Form.triggerEvent("#", "인증서", "Success")	
		end if
		'Form.triggerEvent("#", "간편인증", "Success")	
	end if   
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcpp_logn_015a" trcode="obcpp_logn_015a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcpp_logn_015a" title="MTS로그인_공인인증서 접속로그" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="78" _ulen="64" >

USER_ID^사용자ID^20^0^0^0^0^0^0
SUCS_YN^성공여부^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="80" _ulen="54" >

PBCR_PWD_MSTK_TMNU^공인인증서비밀번호오류횟수^4^0^7^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>