--===========================================================================
--===========================================================================

Dim g_szACNO
Dim g_szASNO
Dim g_szItemCode

g_szItemCode = ""
'============================================================================
Sub Form_OnFormInit()
	ItemCode0.code = "empty"
	
'	DATAMANAGER.RequestTranData( "obtrd_cntg_123r" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" then
		if sParam <> "" and sParam <> null then
			Dim szSplitData
			szSplitData = Split(sParam, "★")
			g_szACNO = szSplitData[0]
			g_szASNO = szSplitData[1]
			
			DATAMANAGER.RequestTranData( "obtrd_cntg_123r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_cntg_123r" then
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "ASNO" , 0 , g_szASNO )
'		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "PWD" , 0 , Form.GetCtlProp("#edtPwd", "encdata") )
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "STA_DATE" , 0 , cldFrom.caption )
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "FIN_DATE" , 0 , cldTo.caption )
		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "FISCD" , 0 , g_szItemCode )
'		DATAMANAGER.SetDataValue( false, "obtrd_cntg_123r", "InBlock1", "CRCD" , 0 , cmbCurrency.cbkeydata )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_cntg_123r" then
		Dim nCnt, nIndex
		Dim szCRCD, szFRCR_TR_AMT, szTR_AMT, szFRCR_TFAM_NWRM, szTFAM_NWRM, szSTND_EXRT
		
		nCnt = DATAMANAGER.GetDataCount(false, "obtrd_cntg_123r", "OutBlock1")
		
		nIndex = tonumber(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1 
			szCRCD = DATAMANAGER.GetDataValue(false, "obtrd_cntg_123r", "OutBlock1", "CRCD" , i)
			szFRCR_TR_AMT = DATAMANAGER.GetDataValue(false, "obtrd_cntg_123r", "OutBlock1", "FRCR_TR_AMT" , i)
			szTR_AMT = DATAMANAGER.GetDataValue(false, "obtrd_cntg_123r", "OutBlock1", "TR_AMT" , i)
			szFRCR_TFAM_NWRM = DATAMANAGER.GetDataValue(false, "obtrd_cntg_123r", "OutBlock1", "FRCR_TFAM_NWRM" , i)
			szTFAM_NWRM = DATAMANAGER.GetDataValue(false, "obtrd_cntg_123r", "OutBlock1", "TFAM_NWRM" , i)
			szSTND_EXRT = DATAMANAGER.GetDataValue(false, "obtrd_cntg_123r", "OutBlock1", "STND_EXRT" , i)
			
			szSTND_EXRT = f_SetTickSize(szSTND_EXRT)
			
			grdList.SetCellData("bd_cell11", nIndex+i, szSTND_EXRT)
			
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szFRCR_TR_AMT,0))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szTR_AMT,0))
				grdList.SetCellData("bd_cell9", nIndex+i, FormatNumber(szFRCR_TFAM_NWRM,0))
				grdList.SetCellData("bd_cell10", nIndex+i, FormatNumber(szTFAM_NWRM,0))
			else
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szFRCR_TR_AMT,2))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szTR_AMT,0))
				grdList.SetCellData("bd_cell9", nIndex+i, FormatNumber(szFRCR_TFAM_NWRM,2))
				grdList.SetCellData("bd_cell10", nIndex+i, FormatNumber(szTFAM_NWRM,0))
			end if
		next
	end if
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtrd_cntg_123r" )
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtrd_cntg_123r" )
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obtrd_cntg_123r" ) then
		DATAMANAGER.RequestNextData( "obtrd_cntg_123r" )
	end if
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		g_szItemCode = sReturn1
		DATAMANAGER.RequestTranData( "obtrd_cntg_123r" )
	end if
End Sub

'============================================================================
Sub btnErase_OnClick()
'	if ItemCode0.code <> "" then
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
		
		ItemCode0.code = "empty"
		g_szItemCode = ""
	
		DATAMANAGER.RequestTranData( "obtrd_cntg_123r" )
'	end if
End Sub 

'============================================================================
Function f_SetTickSize(szData)
	Dim szTickSize, tData
	szTickSize = szData
	
	if szData <> nil and szData <> "" then
		tData = Split(szData, ".")
		szTickSize = tData(0)
		
		if UBound(tData) > 0 then
			if tData(1) <> "" then
				szTickSize = szTickSize & "." & tData(1)
			end if
			
			while right(szTickSize,1) = "0"
				szTickSize = left(szTickSize,Len(szTickSize)-1)
			wend
		end if
	end if
	
	return szTickSize
End Function

