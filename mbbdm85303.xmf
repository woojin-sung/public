		<BUTTON name="Button0" caption="인증센터 가기" bgcolor="085:205216147" bgcolor2="102:216216216" fontsize="4" fontstyle="01" btnimage="btn_10.9" ly_vert="0,587,375,60,1" />
		<LABEL name="Label1" fgcolor="000:068068068" halign="1" ly_vert="20,271,335,38,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="1" rowcount="2" outline="0000" designorder="1" ly_vert="20,354,335,38,1" >
			<COL_INFO ly_vert_width="335" />
			<ROW_INFO ly_vert_height="19,19" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="고객센터에 문의해주세요." impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="1588-3400" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<TABLE name="Table1" insidelinecolor="102:255255255" colcount="1" rowcount="2" outline="0000" designorder="1" ly_vert="20,276,335,57,1" >
			<COL_INFO ly_vert_width="335" />
