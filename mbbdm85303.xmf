	<SCRIPT_INFO _len="690" _ulen="672" >

'============================================================================
Sub Button0_OnClick()
'	인증센터로 이동
	Form.SendReturnToParent("CloseForm", "1" )
	Form.OpenScreen("90120", "")
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormInit()
	ErrorMsg = Form.GetOpenLinkData()

	if Instr(1, ErrorMsg, "★") > 0 then
		Label1.visible = false
		Table1.visible = true
	
		errorMsg = Split(ErrorMsg, "★")
		
		Table1.SetCellString(0, 0, errorMsg(0))
		Table1.SetCellString(1, 0, errorMsg(1))

	else
		Label1.visible = true
		Table1.visible = false
		Label1.caption = ErrorMsg
	end if
	
End Sub

	</SCRIPT_INFO>
