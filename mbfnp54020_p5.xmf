'============================================================================
' 화 면 명 : 채권주문_잔고팝업
' 화면설명 : 채권주문 매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.01.30     test3
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab

Dim g_GrdIndex 
g_GrdIndex = 0
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	Dim szData, szReturnValue

	For i = 0 To grdList.rowcount -1  
		szData = grdList.GetCellData("bd_Gbn", i)		
		szReturnValue = Form.GetMetaData("종합분리과세구분코드", szData)
		
		grdList.SetCellData("bd_Gbn", i, szReturnValue)
	Next	
	
'	szCode = grdList.GetCellData("bd_Cd", g_GrdIndex)
'    if szCode <> "" then
'	    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "B")
'	    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCode)
'	    
'	    DATAMANAGER.RequestTranData("ohhts_7052_001r")
'	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	szOpen = Form.GetOpenLinkData()
	g_szChk = "0"
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
		
		DATAMANAGER.RequestTranData( "obtrs_comn_314r" )
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtrs_comn_314r" Then
		g_GrdIndex = 0
		
		DATAMANAGER.ClearInputData(0,"obtrs_comn_314r" )		 
		DATAMANAGER.SetDataValue(0, "obtrs_comn_314r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_314r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtrs_comn_314r" Then
	    If DATAMANAGER.IsMoreNextData( "obtrs_comn_314r" ) = True then
	       DATAMANAGER.RequestNextData( "obtrs_comn_314r" )
	    Else    
	       SetGridData()
	    End If
	    
	elseif szTranID = "ohhts_7052_001r" then
		
		szSrfcMnrt = DATAMANAGER.GetDataValue(0, "ohhts_7052_001r", "OutBlock1", "FID_SRFC_MNRT" , 0 )
		grdList.SetCellData("bd_cell1", g_GrdIndex, szSrfcMnrt)

		if Cint(g_GrdIndex) < Cint(grdList.rowcount) then
		    g_GrdIndex = g_GrdIndex + 1
		    
		    szCode = grdList.GetCellData("bd_Cd", g_GrdIndex)
		    if szCode <> "" then
			    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "B")
			    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCode)
			    
			    DATAMANAGER.RequestTranData("ohhts_7052_001r")
			end if
		end if
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szGbn, szLoanSr, szData
	
	if lRow > -1 then
		szCd       = grdList.GetCellData("bd_Cd",       lRow)
		szQty      = grdList.GetCellData("bd_Qty",      lRow)
		szLoanDate = grdList.GetCellData("bd_LoanDate", lRow)	
		szGbn	  = grdList.GetCellData("bd_Gbn", lRow)
		
		' 전달내용/탭위치/종목코드/수량/매수일자/매수구분
		szData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & szQty & "★" & szLoanDate &"★"& szGbn

		' 마스터파일에 있는 종목인지 체크
		szChk = Form.GetItemCodeInfo(szCd, "innermarket")
		if Trim(szChk) == "" then
			Form.ShowAlert("안내", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		end if

		Form.SendReturnToParent("54020_BALANCE", szData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	DATAMANAGER.RequestTranData( "obtrs_comn_314r" )	
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
'	imgClose.setMaintainingRatio("1")
End Sub

