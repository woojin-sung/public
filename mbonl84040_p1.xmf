' 2023-11-06 : 양현정 : v002 외국인투자자등록제도폐지건 관련 수정
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_ACNO
Dim g_ASNO
Dim g_ACNT_PWD
Dim g_RCNO_TYPE_CODE
Dim g_RCNO_PIP
Dim g_Cust_Name
Dim g_CSNO
Dim g_BDM_MANG_BRCD

Dim g_szRCNOType
Dim g_szCTCD
Dim g_szBrdt
Dim g_szCustFullName
Dim g_szCUSTEngName

Dim g_aml_rcno
Dim g_aml_rcno_pip 'v001
Dim g_wlf_Apprv_Flag

Dim g_FNPR_JOIN_SRNO

Dim g_szNotiFlag
Dim g_TelNO
Dim g_EmailAddr
Dim g_InagSrno

Dim g_BDM_CtcnChkMndt		'개인(신용)정보 처리 필수 동의서
Dim g_BDM_Mndt_1_1_1_1		'1.1 수집이용(공통)_고유식별
Dim g_BDM_Mndt_1_1_1_2		'1.1 수집이용(공통)_개인신용
Dim g_BDM_Mndt_1_2_1_1		'1.2 수집이용(상품)_신용/미수/파생_고유식별
Dim g_BDM_Mndt_1_2_1_2		'1.2 수집이용(상품)_신용/미수/파생_개인신용
Dim g_BDM_Mndt_2_1_1_1		'2.1 제공(상품)_신용/미수/파생/해외파생_고유식별
Dim g_BDM_Mndt_2_1_1_2		'2.1 제공(상품)_신용/미수/파생/해외파생_개인신용
Dim g_BDM_Mndt_3_1_1_1		'3   조회(상품)_신용/미수/파생/해외파생_고유식별
Dim g_BDM_Mndt_3_1_1_2		'3   조회(상품)_신용/미수/파생/해외파생_개인신용

Dim g_PROS_DATE
Dim g_PROS_SRNO

Dim g_nTryCnt '신용정보조회요청수
g_nTryCnt = 0
Dim g_SDRC_SRNO

Dim g_szUnCheckImg,	g_szCheckImg	'체크이미지
Dim g_szUnCheckFg,	g_szCheckFg	'체크 폰트 컬러
g_szUnCheckImg	= "icon_check_off.png"
g_szCheckImg		= "icon_check_on.png"
