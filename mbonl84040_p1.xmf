g_szCheckFg		= "4"
					
'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	imgAllAgree.setMaintainingRatio("1")
	imgUIChk0.setMaintainingRatio("1")
	imgUIChk1.setMaintainingRatio("1")
	imgUIChk2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_ACNO 			= Form.GetSharedData("mbonl84040_ACNO", 				false)
	g_ACNT_PWD 		= Form.GetSharedData("mbonl84040_PWD", 				false)
	g_RCNO_TYPE_CODE	= Form.GetSharedData("mbonl84040_RCNO_TYPE_CODE", 	false)
	g_RCNO_PIP 		= Form.GetSharedData("mbonl84040_RCNO_PIP", 			false)
	g_Cust_Name 		= Form.GetSharedData("mbonl84040_CUST_FULL_NAME", 	false)
	g_CSNO			= Form.GetSharedData("mbonl84040_CSNO", 				false)	
	g_BDM_MANG_BRCD	= Form.GetSharedData("mbonl84040_MANG_BRCD", 			false)
	g_szNotiFlag		= Form.GetSharedData("mbonl84040_NotiFlag",			false)
	g_TelNO 			= Form.GetSharedData("mbonl84040_TelNo", 			false)
	g_EmailAddr		= Form.GetSharedData("mbonl84040_Email", 			false)
	g_InagSrno		= Form.GetSharedData("mbonl84040_InagSrno",			false)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbonl84040_p2" then
	
		if sRet == "ok_A" then		'전체약관
			f_AllAgreeCheck(1)
		elseif sRet == "ok_0" then	'종합매매계좌 약관
			f_AgreeCheck(0, 1)
		elseif sRet == "ok_1" then	'예금자보호 확인
			f_AgreeCheck(1, 1)
		end if
		
	'개인(신용)정보 처리 필수 동의서
	elseif sKeyName == "mbbdm86140_p2" then
	
		if sRet == "ok" then
			g_BDM_Mndt_1_1_1_1 = Form.GetSharedData("BDM_Mndt_1_1_1_1", false)	'1.1 수집이용(공통)_고유식별
			g_BDM_Mndt_1_1_1_2 = Form.GetSharedData("BDM_Mndt_1_1_1_2", false)	'1.1 수집이용(공통)_개인신용
			g_BDM_Mndt_1_2_1_1 = Form.GetSharedData("BDM_Mndt_1_2_1_1", false)	'1.2 수집이용(상품)_신용/미수/파생_고유식별
			g_BDM_Mndt_1_2_1_2 = Form.GetSharedData("BDM_Mndt_1_2_1_2", false)	'1.2 수집이용(상품)_신용/미수/파생_개인신용
			g_BDM_Mndt_2_1_1_1 = Form.GetSharedData("BDM_Mndt_2_1_1_1", false)	'2.1 제공(상품)_신용/미수/파생/해외파생_고유식별
			g_BDM_Mndt_2_1_1_2 = Form.GetSharedData("BDM_Mndt_2_1_1_2", false)	'2.1 제공(상품)_신용/미수/파생/해외파생_개인신용
			g_BDM_Mndt_3_1_1_1 = Form.GetSharedData("BDM_Mndt_3_1_1_1", false)	'3   조회(상품)_신용/미수/파생/해외파생_고유식별
			g_BDM_Mndt_3_1_1_2 = Form.GetSharedData("BDM_Mndt_3_1_1_2", false)	'3   조회(상품)_신용/미수/파생/해외파생_개인신용
			
			f_AgreeCheck(2, 1)
		end if
		
	'투자성향등록 리턴
	elseif sKeyName == "MBBDM86170" then
		
		if sRet == "ok" then
			'DATAMANAGER.RequestTranData("obcmm_kcdd_035r")
			DATAMANAGER.RequestTranData("obcmm_comm_001r")
	   
		'투자성향 진행중 계좌개설 중단
		elseif sRet == "abort" then
			btnOk.enable = true	'v001 활성화원복
			Form.ShowAlert("알림", "투자성향 진단이 중단되어 다음 단계 진행이 불가합니다. 다시 진행해주세요.")
			Exit Sub
		else
			btnOk.enable = true	'v001 활성화원복
		
			'투자성향진단 비정상종료와 부적합(적정성보고서) 비정상종료 분리
			if sRet == "unfit_fail" then
				Form.ShowAlert("알림", "[투자성향 대비 고위험거래 가입확인],\n[투자성상품 적정성 판단 보고서확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
				Exit Sub
			'투자권유 희망 확인서 미처리에 따른 진행불가 알럿	
			elseif sRet == "hopeRecInv_fail" Then
				Form.ShowAlert("알림", "[투자권유 희망 여부 확인],\n[투자권유 희망 여부 확인서 확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")		
				Exit Sub	
			else
				Form.ShowAlert("알림", "투자성향 진단이 올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
				Exit Sub
			end if
		    
		end if

	end if
	
End Sub

