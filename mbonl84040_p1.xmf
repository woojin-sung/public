	Form.SetSharedData("BDM_PRCD118RP", 		"N")
	Form.SetSharedData("BDM_PRCD100F", 		"N")
	Form.SetSharedData("BDM_PRCD200",		"N")

	Form.OpenPopup("mbbdm86170", "", "")
End Function

