		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0, "1")	'1 : WLF
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "AML_CUST_CLS_CODE", 		0, "1")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0, Left(g_ACNO, 8))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CUST_FULL_NAME", 			0, g_szCustFullName)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CDD_TR_KIND_CODE", 		0, "1")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO_PIP", 				0, g_RCNO_PIP) 'v002
		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "WLF_IQRY_TRGT_CLS_CODE",	0, "01")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "WLF_REAL_RCNO", 			0, "*************")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "RCNO_TYPE_CODE", 			0, g_szRCNOType)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "CTCD", 					0, g_szCTCD)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "BRDT", 					0, g_szBrdt)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "CUST_FULL_NAME", 			0, g_szCustFullName)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "CUST_ENG_NAME", 			0, g_szCUSTEngName)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "WLF_REAL_RCNO_PIP",		0, g_RCNO_PIP)

	'내부통제_AMLWLF대상고객정보조회
	elseif szTranID == "obcmm_comm_001r"	then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0, "1")	'1.ACNO 기반 고객정보 조회  2:WLF적출내역 조회
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0, Left(g_ACNO, 8))
		
	'내부통제_AMLWLF대상고객정보조회
	elseif szTranID == "obcmm_comm_001r_1"	then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0, "2")	'1.ACNO 기반 고객정보 조회  2:WLF적출내역 조회
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0, Left(g_ACNO, 8))		
		'v001 DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO", 					0, g_aml_rcno)		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO_PIP", 				0, g_aml_rcno_pip ) 'v002

	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a"	then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0, "1")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "FNPR_JOIN_SRNO", 			0, g_FNPR_JOIN_SRNO)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO", 		0, "00001")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "INAG_SRNO", 				0, g_InagSrno)

		if g_szNotiFlag == "talk" then			
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "HNDV_MTHD_CODE",		0, "04")
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "INAG_TYPE_CODE",		0, "13")
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "UI_CUST_TELNO" , 		0 , g_TelNO)
		elseif g_szNotiFlag == "email" then
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "HNDV_MTHD_CODE", 		0 , "02")
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "INAG_TYPE_CODE", 		0 , "21")
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ADDR"          , 		0 , g_EmailAddr)
		end if
		
	'종합매매 개별상품 가입
	elseif szTranID == "obaci_acct_003c"	then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CONT_CLS_CODE", 			0 , "4")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0 , Left(g_ACNO, 8))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNT_PWD", 				0 , g_ACNT_PWD)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PRCD", 					0 , "100")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "INVR_DIV_CODE", 			0 , "8000")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "MANG_EMPNO", 				0 , "C"&g_BDM_MANG_BRCD)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "DEAL_RPRT_SNDN_YN", 		0 , "N")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0 , "0")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "TR_EXRS_YN", 				0 , "N")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PXPR_YN", 				0 , "N")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO_TYPE_CODE", 			0 , "00")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "MARG_GRAD_CODE", 			0 , "6")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "KYC_DRVT_PROS_YN", 		0 , "N")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "FNPR_EXUS_YN", 			0 , "N")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_DATE", 				0 , g_PROS_DATE)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_SRNO", 				0 , g_PROS_SRNO)
		
	'계약서류교부처리
	elseif szTranID == "obcsb_dbif_322a"	then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0 , Left(g_ACNO, 8))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "FNPR_JOIN_SRNO", 			0 , g_FNPR_JOIN_SRNO)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "BSWR_LRDV_CODE", 			0 , "001")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CONT_CLS_CODE", 			0 , "4")
		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO", 		0 , "00001")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "ISCD", 					0 , "100")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL", 		0 , Left(g_ACNO, 8) & "$" & g_ASNO)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
    '개인신용정보동의 임시등록
    if szTranID == "obaci_acct_255a" then
	    g_PROS_DATE = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROS_DATE", 0)
	    g_PROS_SRNO = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROS_SRNO", 0)
	
		DATAMANAGER.SetDataValue(false, "obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE", 0 , "1") '송신
		DATAMANAGER.RequestTranData("obcsb_nice_010r")
	
	'신용정보조회(개설/대출/해지)
	elseif szTranID == "obcsb_nice_010r" then
		Dim sRSLT_CLS
		sRSLT_CLS = DATAMANAGER.GetDataValue(false, "obcsb_nice_010r", "OutBlock1", "RSLT_CLS", 0)
		
		' RSLT_CLS = '0' : 전문 전송하지 않아도 되는 정상적인 경우
		' RSLT_CLS = '1' : 전문 송신한 경우
		' RSLT_CLS = '2' : 전문 송신 후 응답 대기 중
		' RSLT_CLS = '3' : 전문 수신 결과 정상 응답	
		if sRSLT_CLS == "0" or sRSLT_CLS == "3" then '정상/전문수신결과정상응답
'			g_SDRC_SRNO	= DATAMANAGER.GetDataValue(false, "obcsb_nice_010r", "OutBlock2", "SDRC_SRNO", 0)
			f_OpenPopMbbdm86170()
		elseif sRSLT_CLS == "1" or sRSLT_CLS == "2" then
			g_SDRC_SRNO	= DATAMANAGER.GetDataValue(false, "obcsb_nice_010r", "OutBlock2", "SDRC_SRNO", 0)
			g_nTryCnt	= g_nTryCnt + 1
			
			if g_nTryCnt <= 7 then
				Form.SetTimerEvent2(1, 1, 1)
			else
				g_SDRC_SRNO	= ""
				g_nTryCnt	= 0
				
				btnOk.enable = true	'v001 활성화원복
				Form.MsgBox( "안내", "신용정보조회에 실패하였습니다.\n30분 후 다시 시도해 주십시오.", "", 6)
				Exit Sub
			end if
			
		end if
	
	'WLF CDD 기준일 등록여부 확인
	elseif szTranID == "obcmm_kcdd_035r"	then
		Dim szRegYN
		szRegYN = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_YN", 0)
		
		if szRegYN ==	 "N" and g_wlf_Apprv_Flag <> "01" and g_wlf_Apprv_Flag <> "00" then
			DATAMANAGER.RequestTranData("obcmm_kwlf_032r")
		else
			DATAMANAGER.RequestTranData("obcmm_comm_001r_1")
		end if

	'내부통제_AMLWLF대상고객정보조회
	elseif szTranID == "obcmm_comm_001r"	then		
		g_aml_rcno 	 = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO", 0)
		g_aml_rcno_pip = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO_PIP", 0) 'v001
		
		DATAMANAGER.RequestTranData("obcmm_kwlf_013a_1")

	'내부통제_AMLWLF대상고객정보조회
	elseif szTranID == "obcmm_comm_001r_1"	then		
		Dim szAprvClsCd
		szAprvClsCd = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "APRV_CLS_CODE", 0)	
		
		if szAprvClsCd ==	"01" or szAprvClsCd ==	"06" then
			DATAMANAGER.RequestTranData("obsap_acif_999a")
		else			
			Form.MsgBox("알림", "WLF승인완료 후 개설가능합니다.", "TR_ERR_MSG", "6")
		end if
		
	'WLF 계좌번호로 고객 정보 조회
	elseif szTranID == "obcmm_kwlf_032r"	then
		g_szRCNOType		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO_TYPE_CODE", 	0)
		g_szCTCD			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CTCD", 			0)
		g_szBrdt			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BRDT", 			0)
		g_szCustFullName	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_FULL_NAME", 	0)
		g_szCUSTEngName	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_ENG_NAME", 	0)
		g_RCNO_PIP		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RCNO_PIP",			0)
		
		DATAMANAGER.RequestTranData("obcmm_kwlf_013a")	
	
	'WatchList 조회처리
	elseif szTranID == "obcmm_kwlf_013a_1"	then
		g_wlf_Apprv_Flag = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "APRV_CLS_CODE", 0)
		
		DATAMANAGER.RequestTranData("obcmm_kcdd_035r")	
	
	'WatchList 조회처리
	elseif szTranID == "obcmm_kwlf_013a"	then
		Dim PROS_CLS
		PROS_CLS = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROS_CLS", 0)

		' PROS_CLS(0:처리정상 / 1:승인신청대상 / 2:승인대기중)
		if CInt(PROS_CLS) == 0 then
			DATAMANAGER.RequestTranData("obsap_acif_999a")
		else
			'Form.ShowAlert("알림", "고객WLF처리가 완료되지 않았습니다.")
			Form.MsgBox("알림", "고객WLF처리가 완료되지 않았습니다.", "TR_ERR_MSG", "6")
		end if
		
	'금융상품가입일련번호 채번
	elseif szTranID == "obsap_acif_999a"	then
		g_FNPR_JOIN_SRNO = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)
		DATAMANAGER.RequestTranData("obcsb_acad_122a")
		
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a"	then
		DATAMANAGER.RequestTranData("obaci_acct_003c")
		
	'종합매매 개별상품 가입
	elseif szTranID == "obaci_acct_003c"	then
		g_ASNO = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ASNO", 0)
		
		DATAMANAGER.RequestTranData("obcsb_dbif_322a")
		
	'계약서류교부처리
	elseif szTranID == "obcsb_dbif_322a"	then
		Form.SendReturnToParent("mbonl84040_p1", Left(g_ACNO, 8)..g_ASNO)
		Form.CloseForm()
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    
    if Trim(strSubMsg) ~= null and Trim(strSubMsg) ~= "" then
        strMsg = szErrMsg.."("..Trim(strSubMsg)..")"
    else
        strMsg = szErrMsg
    end if
    
    btnOk.enable = true	'v001 활성화원복

	if szTranID == "obaci_acct_255a" then	
		Form.ShowAlert("오류", "개인신용정보동의 등록 중 오류가 발생하였습니다.")    				
	else
		'Form.ShowAlert("오류", strMsg)	
		Form.MsgBox("오류", strMsg, "TR_ERR_MSG", "6")
	end if
	
End Sub

