'============================================================================
' 확인
'============================================================================
Sub btnOk_OnClick()
	
	btnOk.enable = false	'v001 더블클릭 방지..
	if g_BDM_Mndt_1_1_1_1 == "Y" and g_BDM_Mndt_1_1_1_2 == "Y"  and g_BDM_Mndt_1_2_1_1 == "Y"  and g_BDM_Mndt_1_2_1_2 == "Y"  and 
		g_BDM_Mndt_2_1_1_1 == "Y"  and g_BDM_Mndt_2_1_1_2 == "Y"  and g_BDM_Mndt_3_1_1_1 == "Y"  and g_BDM_Mndt_3_1_1_2 == "Y" then
		DATAMANAGER.RequestTranData("obaci_acct_255a")
	end if
	
End Sub

