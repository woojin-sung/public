'============================================================================
' 							사용자 함수
'============================================================================
Function f_AgreeCheck(idx, flag)
	Dim SltedCnt
	SltedCnt = 0

	for i = 0 to 2
		
		if i == idx then
			Form.SetCtlProp("chkAgree"..i, 		"chksilence",	flag)
			Form.SetCtlProp("imgUIChk"..i, 		"imgpath",	flag == 0 and g_szUnCheckImg	or g_szCheckImg)
			Form.SetCtlProp("lblChkText"..i, 	"fgcolor",	flag == 0 and g_szUnCheckFg		or g_szCheckFg)
		end if

		if "1" == Form.GetCtlProp("chkAgree"..i, "checkstate") then
			SltedCnt = SltedCnt + 1
		end if

	next

	chkAllAgree.chksilence	= 3 == CInt(SltedCnt) and true 			or false
	imgAllAgree.imgpath	= 3 == CInt(SltedCnt) and g_szCheckImg	or g_szUnCheckImg
	lblAllAgree.fgcolor	= 3 == CInt(SltedCnt) and g_szCheckFg	or g_szUnCheckFg
	btnOk.enable			= 3 == CInt(SltedCnt) and true 			or false
End Function 

'============================================================================
Function f_AllAgreeCheck(flag)
	chkAllAgree.chksilence	= flag
	imgAllAgree.imgpath	= flag == 0 and g_szUnCheckImg	or g_szCheckImg
	lblAllAgree.fgcolor	= flag == 0 and g_szUnCheckFg	or g_szCheckFg
	btnOk.enable			= flag
	g_BDM_CtcnChkMndt		= flag == 0 and "N"			or "Y"
	
	f_SetCtcnChkMndtData()

	for i = 0 to 2
		Form.SetCtlProp("chkAgree"..i, 		"chksilence",	flag)
		Form.SetCtlProp("imgUIChk"..i, 		"imgpath",	flag == 0 and g_szUnCheckImg	or g_szCheckImg)
		Form.SetCtlProp("lblChkText"..i, 	"fgcolor",	flag == 0 and g_szUnCheckFg		or g_szCheckFg)
	next
	
End Function

'============================================================================
Function f_SetCtcnChkMndtData()
	Form.SetSharedData("BDM_Mndt_1_1_1_1", g_BDM_CtcnChkMndt)  '1.1 수집이용(공통)_고유식별
	Form.SetSharedData("BDM_Mndt_1_1_1_2", g_BDM_CtcnChkMndt)  '1.1 수집이용(공통)_개인신용
	Form.SetSharedData("BDM_Mndt_1_2_1_1", g_BDM_CtcnChkMndt)  '1.2 수집이용(상품)_신용/미수/파생_고유식별
	Form.SetSharedData("BDM_Mndt_1_2_1_2", g_BDM_CtcnChkMndt)  '1.2 수집이용(상품)_신용/미수/파생_개인신용
	Form.SetSharedData("BDM_Mndt_2_1_1_1", g_BDM_CtcnChkMndt)  '2.1 제공(상품)_신용/미수/파생/해외파생_고유식별
	Form.SetSharedData("BDM_Mndt_2_1_1_2", g_BDM_CtcnChkMndt)  '2.1 제공(상품)_신용/미수/파생/해외파생_개인신용
	Form.SetSharedData("BDM_Mndt_3_1_1_1", g_BDM_CtcnChkMndt)  '3   조회(상품)_신용/미수/파생/해외파생_고유식별
	Form.SetSharedData("BDM_Mndt_3_1_1_2", g_BDM_CtcnChkMndt)  '3   조회(상품)_신용/미수/파생/해외파생_개인신용

	g_BDM_Mndt_1_1_1_1 = Form.GetSharedData("BDM_Mndt_1_1_1_1", false)	'1.1 수집이용(공통)_고유식별
	g_BDM_Mndt_1_1_1_2 = Form.GetSharedData("BDM_Mndt_1_1_1_2", false)	'1.1 수집이용(공통)_개인신용
	g_BDM_Mndt_1_2_1_1 = Form.GetSharedData("BDM_Mndt_1_2_1_1", false)	'1.2 수집이용(상품)_신용/미수/파생_고유식별
	g_BDM_Mndt_1_2_1_2 = Form.GetSharedData("BDM_Mndt_1_2_1_2", false)	'1.2 수집이용(상품)_신용/미수/파생_개인신용
	g_BDM_Mndt_2_1_1_1 = Form.GetSharedData("BDM_Mndt_2_1_1_1", false)	'2.1 제공(상품)_신용/미수/파생/해외파생_고유식별
	g_BDM_Mndt_2_1_1_2 = Form.GetSharedData("BDM_Mndt_2_1_1_2", false)	'2.1 제공(상품)_신용/미수/파생/해외파생_개인신용
	g_BDM_Mndt_3_1_1_1 = Form.GetSharedData("BDM_Mndt_3_1_1_1", false)	'3   조회(상품)_신용/미수/파생/해외파생_고유식별
	g_BDM_Mndt_3_1_1_2 = Form.GetSharedData("BDM_Mndt_3_1_1_2", false)	'3   조회(상품)_신용/미수/파생/해외파생_개인신용
End Function

