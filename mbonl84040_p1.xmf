Sub Form_OnFormClose()
	Form.SetSharedData("BDM_Mndt_1_1_1_1", "")  '1.1 수집이용(공통)_고유식별
	Form.SetSharedData("BDM_Mndt_1_1_1_2", "")  '1.1 수집이용(공통)_개인신용
	Form.SetSharedData("BDM_Mndt_1_2_1_1", "") 
	Form.SetSharedData("BDM_Mndt_1_2_1_2", "") 
	Form.SetSharedData("BDM_Mndt_2_1_1_1", "") 
	Form.SetSharedData("BDM_Mndt_2_1_1_2", "") 
	Form.SetSharedData("BDM_Mndt_3_1_1_1", "") 
	Form.SetSharedData("BDM_Mndt_3_1_1_2", "") 
	
	Form.SetSharedData("BDM_YN"			, 	"")
	Form.SetSharedData("BDM_CUST_ACNO"	, 	"")
	Form.SetSharedData("BDM_RCNO_PIP",		"")
	Form.SetSharedData("BDM_NAME",			"")
	Form.SetSharedData("BDM_EXSN_CUST_YN", 	"")
	Form.SetSharedData("BDM_REG_UNIQ_NO",	"") 
	Form.SetSharedData("BDM_MANG_BRCD",		"")
	Form.SetSharedData("BDM_PRCD100",		"")
	Form.SetSharedData("BDM_PRCD101", 		"")
	Form.SetSharedData("BDM_PRCD135", 		"")
	Form.SetSharedData("BDM_PRCD133", 		"")
	Form.SetSharedData("BDM_ISA_PROD_TYPE", 	"")
	Form.SetSharedData("BDM_WRAP", 			"")
	Form.SetSharedData("BDM_PRCD131", 		"")
	Form.SetSharedData("BDM_PRCD118RP", 		"")
	Form.SetSharedData("BDM_PRCD100F", 		"")
	Form.SetSharedData("BDM_PRCD200",		"")	
	
	Form.SetSharedData("BDM_MARG_GRAD_CODE",	"")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if sTimerID == "1" or sTimerID == 1 then
		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 1)
		
		DATAMANAGER.SetDataValue(false, "obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE" , 0 , "2" ) '송신응답	
		DATAMANAGER.RequestTranData("obcsb_nice_010r") '고객정보확인조회
	end if
	
End Sub

'============================================================================
' 						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'개인신용정보동의 임시등록
	if szTranID == "obaci_acct_255a" Then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CONT_CLS_CODE",			0, "4")				'4.단기다수계좌/대포통장 명의인 확인
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0, Left(g_ACNO, 8))	'종합계좌번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD",	0, "002")'100종합미수가능-002, 미수불가 008
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "AGRM_RQCL_DOCU_CLCD",		0, "3")	'3.요약+상세		

		'1.1 수집이용(공통)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "PROS_CLS_CODE",			0, "1")	'1.처리
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "UI_COMN_AGRM_YN1",		0, g_BDM_Mndt_1_1_1_1) '"Y")	'고유식별번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "UI_COMN_AGRM_YN2",		0, g_BDM_Mndt_1_1_1_2) '"Y")	'개인신용정보
		
		'1_2 수집이용(상품별) _신용/미수/파생상품
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock3", "PROS_CLS_CODE",			0, "1")	'1.처리	    
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock3", "UI_COMN_AGRM_YN1",		0, g_BDM_Mndt_1_2_1_1) '"Y")	'고유식별번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock3", "UI_COMN_AGRM_YN2",		0, g_BDM_Mndt_1_2_1_2) '"Y")	'개인신용정보
		
		'1_2 수집이용(상품별) _비과세종합/ISA/연금저축
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock4", "PROS_CLS_CODE",			0, "0") 	'0.미처리
		
		'1_2 수집이용(상품별) _해외주식/해외파생/외화금융상품/EUREX
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock5", "PROS_CLS_CODE",			0, "0")	'0.미처리

		'2_1 제공(상품별) _신용/미수/파생상품/해외파생
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock6", "PROS_CLS_CODE",			0, "1")	'1.처리	    
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock6", "UI_COMN_AGRM_YN1",		0, g_BDM_Mndt_2_1_1_1) '"Y")	'고유식별번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock6", "UI_COMN_AGRM_YN2",		0, g_BDM_Mndt_2_1_1_2) '"Y")	'개인신용정보

		'2_1 제공(상품별) _해외주식/해외파생/해외금융상품
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock7", "PROS_CLS_CODE",			0, "0")	'0.미처리

		'3. 조회(상품별)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock8", "PROS_CLS_CODE",			0, "1")	'1.처리
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock8", "UI_COMN_AGRM_YN1",		0, g_BDM_Mndt_3_1_1_1) '"Y")	'고유식별번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock8", "UI_COMN_AGRM_YN2",		0, g_BDM_Mndt_3_1_1_2) '"Y")	'개인신용정보

		'선택서비스
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock9", "PROS_CLS_CODE",			0, "0")	'0.미처리	
	
	'신용정보조회(개설/대출/해지)
	elseif szTranID == "obcsb_nice_010r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "BSWR_CLS_CODE",			0, "1")	'1.계좌개설
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CRIN_IQRY_CLCD",			0, "TR01")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO",					0, Left(g_ACNO, 8))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock2", "SDRC_SRNO", 				0, g_SDRC_SRNO)
		
	'WLF CDD 기준일 등록여부 확인
	elseif szTranID == "obcmm_kcdd_035r"	then
		Dim szToday
		szToday = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "UI_CLS", 				0, "1")	'1.WLF
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CDD_REG_DATE", 			0, szToday)
		'v001 DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO", 					0, g_aml_rcno)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RCNO_PIP", 				0, g_RCNO_PIP) 
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CDD_TR_KIND_CODE", 		0, "1")
		
	'WLF 계좌번호로 고객 정보 조회
	elseif szTranID == "obcmm_kwlf_032r"	then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0, "2")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 					0, Left(g_ACNO, 8))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CDD_TR_KIND_CODE", 		0, "1")		'1 : 신규개설
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "AML_CUST_CLS_CODE", 		0, "1")
	
	'WatchList 조회처리
	elseif szTranID == "obcmm_kwlf_013a_1"	then
		Dim szToday
		szToday = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 			0, "3")	'1 : WLF
