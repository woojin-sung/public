Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'YHJ 추가 - TR실패시 약관동의부터 다시 받을 것..
	if sKeyName = "TR_ERR_MSG" then
		btnOk.enable = true	'v001 활성화원복
		Form.SendReturnToParent("mbonl84040_p1", "ERROR")
		Form.CloseForm()
	end if
End Sub

