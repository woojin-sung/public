	<SCRIPT_INFO _len="3910" _ulen="3746" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 계약평가_보유현황
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If Form.GetCtlProp("#acnt0", "total") = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Form.GetCtlProp("#cmbSeq", "caption") = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Function RequestData()
	'Clear Data
	grd0.rowcount = 0		
	grd1.rowcount = 0
	grd2.rowcount = 0
	grd3.rowcount = 0
	
	If Account_Check() == True then
		DATAMANAGER.RequestTranData( "obwat_ctcs_033r" )	'계약종합정보_보유정보 조회
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	'조회일자 전일
	cldToday.caption = Replace(DateAdd ("d", -1, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
	'Call rdo0_OnClick(0)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" Then
		RequestData()
	End If
End Sub

'============================================================================
Sub rdo0_OnClick(nIndex)
	grd0.visible = False
	grd1.visible = False
	grd2.visible = False
	grd3.visible = False
	
	If nIndex == 0 then		'집합투자
		grd0.visible = True
	Elseif nIndex == 1 then	'장외파생
		grd1.visible = True
	Elseif nIndex == 2 then	'RP/예금
		grd2.visible = True
	Elseif nIndex == 3 then	'ETF
		grd3.visible = True
	End If
	
	Call RequestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#cmbSeq", "caption")
	
	If szTranID = "obwat_ctcs_033r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , szASNO )
		
		'상품구분코드
		Dim sCode
		If rdo0.currentindex == "0" then
			sCode = "03"
		Elseif rdo0.currentindex == "1" then
			sCode = "08"
		Elseif rdo0.currentindex == "2" then
			sCode = "04"
		Elseif rdo0.currentindex == "3" then
			sCode = "01"
		End If

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_INVT_PROD_CLCD" , 0 , sCode )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obwat_ctcs_033r" trcode="obwat_ctcs_033r" inputcheck="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obwat_ctcs_033r" title="계약종합정보-보유정보조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="223" _ulen="153" >

WA_ACNO^랩어카운트계좌번호^8^0^0^0^0^0^0
WA_CNRC_NO^랩어카운트계약번호^10^0^0^0^0^0^0
WA_INVT_PROD_CLCD^랩어카운트투자상품구분코드^2^0^0^0^0^0^0
APLY_DATE^적용일자^8^0^0^0^0^0^0

