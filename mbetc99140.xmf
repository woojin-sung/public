Sub Grid0_OnClickUp(lRow, szCellID)
	prtf_id_temp = Grid0.GetCellData( "bd_cell6", lRow )
	risk_grade_temp = Grid0.GetCellData( "bd_cell8", lRow )
	
	
	Form.SetSharedData("Shared_PID", prtf_id_temp)
	Form.SetSharedData("Shared_GRADE", risk_grade_temp)
	
	Form.OpenFramePopup("mbcpp70110.xmf","","")
	
End Sub

