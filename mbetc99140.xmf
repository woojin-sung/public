--===========================================================================
--===========================================================================
Dim g_pt_count
Dim g_it_count
Dim g_rg_count
Dim g_nation_count
Dim g_ert_count
Dim g_aset_count
Dim flag

Dim nRow
Dim count
'============================================================================
Sub Form_OnFormInit()
	g_pt_count = 0
	g_it_count = 0
	g_rg_count = 0
	g_nation_count = 0
	g_ert_count = 0
	g_aset_count = 0
	count = 0
	nRow = 0

	

    
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if flag == 0 then
		DATAMANAGER.RequestNextData("obcpp_rbit_998r")
	else
		
		DATAMANAGER.RequestNextData("obcpp_rbit_998r_1")
		
	end if
End Sub

'============================================================================
Sub Button0_OnClick()

	Grid0.SetClear()
	
	flag = 1
	count = 0
	
	if Edit0.caption <> "" and Edit1.caption <> "" then
		g_ert_count = 1
	else 
		g_ert_count = 0
	end if
	
	if Edit2.caption <> "" and Edit3.caption <> "" then
		g_aset_count = 1
	else 
		g_aset_count = 0
	end if
	
	if g_nation_count == 0 or g_rg_count == 0 or g_it_count == 0 or g_pt_count == 0 or g_ert_count == 0 or g_aset_count==0 then

	    Form.ShowAlert("오류", "영역마다 하나 이상의 체크를 해야합니다")
	elseif CDbl(Edit0.caption) > CDbl(Edit1.caption) or Cint(Edit2.caption) > Cint(Edit3.caption) then
		Form.ShowAlert("오류", "범위를 다시 설정해주십시오")
	else
	    DATAMANAGER.RequestTranData("obcpp_rbit_998r_1")
	end if
	
	
	
End Sub

'============================================================================
Sub Container0_ChkButton0_OnChange(sCheckState)
	
	if sCheckState == "1" then
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_998r_1", "InBlock1", "UI_PROD_AGRM_YN1" , 0 , sCheckState)
	    g_pt_count = g_pt_count + 1
	else
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_998r_1", "InBlock1", "UI_PROD_AGRM_YN1" , 0 , sCheckState)
	    g_pt_count = g_pt_count - 1
	end if
End Sub

