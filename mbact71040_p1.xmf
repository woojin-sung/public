'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	Dim szList
	Dim szbank		'은행명과 계좌 분리
	Dim sztrash		'거래상대명 쓰레기값 분리
	Dim szTemp		'	
	
	Form.SetScreenName( "거래내역조회" )			'스크린 네임 변경
	
	szData = Form.GetOpenLinkData()
	
	g_szList = Split(szData,"●")			'데이터 구분 / v0006 : szList -> g_szList
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	'계좌번호 순번추가
	'2.28
	Dim acno
	acno = g_szList(0).."-"..g_szList(1)
	tbl0.SetCellString(0, 3, acno)
	
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_002r", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_002r", "InBlock1", "ASNO" , 0 , g_szList(1))
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_002r", "InBlock1", "TR_DATE" , 0 , g_szList(2))
	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_002r", "InBlock1", "TRAN_SRNO" , 0 , g_szList(3))
	DATAMANAGER.RequestTranData( "obrtp_tran_002r" )
		
'	tbl0.SetCellString( 0,  1, szList(0) )
'	tbl0.SetCellString( 0,  3, szList(1) )
'	tbl0.SetCellString( 1,  1, szList(2) )
'	tbl0.SetCellString( 1,  3, szList(3) )
'	tbl0.SetCellString( 2,  1, szList(4) )
'	tbl0.SetCellString( 2,  3, szList(5) )
'	tbl0.SetCellString( 3,  1, szList(6) )
'	tbl0.SetCellString( 3,  3, szList(7) )
'	tbl0.SetCellString( 4,  1, szList(8) )
'	tbl0.SetCellString( 4,  3, szList(9) )
'	tbl0.SetCellString( 5,  1, szList(10) )
'	tbl0.SetCellString( 5,  3, szList(11) )
'	tbl0.SetCellString( 6,  1, szList(12) )
'	tbl0.SetCellString( 6,  3, szList(13) )
	
'	if szList(15) == "" then
'		szTemp = "/"
'		szbank = Split(szTemp , "/")
'	else
'		szbank = Split(szList(15) , "/")
'	end if
'	
'	if szList(16) == "" then			'은행코드가 없을때 - 메리츠 계좌일때
'		tbl0.SetCellString( 7,  1, szList(14) )
'		tbl0.SetCellString( 7,  3, szbank(1) )'Right(trim(szList(15)) , 8) )
'	else
'		tbl0.SetCellString( 7,  1, szbank(0)&"\n"&szbank(1) )
'		sztrash = Split(szbank(2),"　")		'뒤에 특수문자 공백이 들어간 부분 제거
'		tbl0.SetCellString( 7,  3, sztrash(0) )'Right(trim(szList(15)) , 9) )
'	end if
	
'	tbl0.SetCellString( 7,  1, szList(14) )
'	tbl0.SetCellString( 7,  3, Right(trim(szList(15)) , 9) )
'	tbl0.SetCellString( 8,  1, szList(15) )
	
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nType
	Dim SubFee				'제세금
	Dim szAccount
	Dim szAcntName
	Dim szBankCode
	Dim szFee				'수수료
	Dim szTax                  '세금
	Dim szInt                  '이자
	Dim szFrcrTrAmt

	if szTranID == "obrtp_tran_002r" then
	
		for i = 0 to (DATAMANAGER.GetDataCount( 0 , "obrtp_tran_002r", "OutBlock1" ) - 1)
		
			nType = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "TR_TYPE_CODE" , i)
		
			SubFee = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "INTX" , i) + 
			DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "RSTX" , i) + 
			DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SRTX" , i) + 
			DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "TRTX" , i)
	
			szFee = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FEE" , i) + 
			        DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "DEAL_FEE" , i)
	
			tbl0.SetCellString( 5, 3, SubFee)
			tbl0.SetCellString( 6, 3, szFee)
			
			szTax = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "INTX" , i) + 
			DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "RSTX" , i) + 
			DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SRTX" , i)
			
			szInt = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "INT_AMT" , i)
			
			szSMCD = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SMCD" , i)  
			
			if szInt - szTax < 0 then
				tbl0.SetCellString( 7, 3, 0)
			else
				tbl0.SetCellString( 7, 3, szInt - szTax)
			end if
			
			if Len(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SECO_BRNM" , i)) > 0 then
				szAccount = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SECO_BRNM" , i)) & " / " & Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "OTCO_ALTN_ACNO" , i))
				szAcntName = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CNFT_ACNM" , i))
				
				tbl0.SetCellString( 9, 1, szAccount)
				tbl0.SetCellString(10, 1, szAcntName)
			else
			
			end if
			
			if Len(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "BANK_CODE" , i)) > 0 then
				szBankCode = Form.GetMetaData("은행코드", DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "BANK_CODE" , i))
				szAccount = szBankCode & " / " & Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "BANK_ACNO" , i))
				
				'16-04-12 YCJ 박영택과장님 요청사항 수정
				if Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FNDS_TACT_RMT_NAME" , i)) <> "" Then
				    
				    szAcntName = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FNDS_TACT_RMT_NAME" , i))
				else
				
				    szAcntName = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "TR_EXPL" , i))
				end if 
				

'				if Trim(szBankCode) <> "" or Trim(szBankCode) <> Null then
'					szAcntName = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "TR_EXPL" , i))
'				else
'					szAcntName = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FNDS_TACT_RMT_NAME" , i))
'				end if
				
				tbl0.SetCellString( 9, 1, szAccount)
				tbl0.SetCellString(10, 1, szAcntName)
			else
			
			end if
			
			if Len(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CNFT_ACNO" , i)) > 0 then
				szAccount = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CNFT_ACNO" , i)) & "-" & Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CNFT_ASNO" , i))
				szAcntName = Trim(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CNFT_ACNM" , i))
				
				tbl0.SetCellString( 9, 1, szAccount)
				tbl0.SetCellString(10, 1, szAcntName)
			else
			
			end if
			
			'v0001 sta
			szFrcrTrAmt = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_TR_AMT" , i)
			szIssuTypeCode = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ISSU_TYPE_CODE" , i)
			
			
			szCash_Uncl_Ocrn_Amt     = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CASH_UNCL_OCRN_AMT" , i)
			szCash_Uncl_Rdmp_Amt     = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CASH_UNCL_RDMP_AMT" , i)
			szCash_Uncl_Ovfe         = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CASH_UNCL_OVFE" , i)
			szUncl_Loan_Int_Ocrn_Amt = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "UNCL_LOAN_INT_OCRN_AMT" , i)
			szUncl_Loan_Int_Rdmp_Amt = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "UNCL_LOAN_INT_RDMP_AMT" , i)
			szUncl_Loan_Int_Ovfe     = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "UNCL_LOAN_INT_OVFE" , i)
			szEtc_Lndn_Amt           = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ETC_LNDN_AMT" , i)
			szEtc_Lndn_Rdmp_Amt      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ETC_LNDN_RDMP_AMT" , i)
			szEtc_Lndn_Amt_Ovfe      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ETC_LNDN_AMT_OVFE" , i)
			szEtc_Uncl_Rdmp_Amt      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ETC_UNCL_RDMP_AMT" , i)
			szEtc_Unam               = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ETC_UNAM" , i)
			szEtc_Uncl_Amt_Ovfe      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "ETC_UNCL_AMT_OVFE" , i)
			szFee_Uncl_Ocrn_Amt      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FEE_UNCL_OCRN_AMT" , i)
			szFee_Uncl_Rdmp_Amt      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FEE_UNCL_RDMP_AMT" , i)
			
			
			'미수발생금액
			sz_Uncl_Ocrn_Amt         = szCash_Uncl_Ocrn_Amt     + 
			                           szUncl_Loan_Int_Ocrn_Amt +
						             szEtc_Lndn_Amt           +
							         szEtc_Unam              +
								    szFee_Uncl_Ocrn_Amt
			tbl0.SetCellString( 11 , 1 , sz_Uncl_Ocrn_Amt)		    
			
			'미수변제금액
			sz_Uncl_Rpmn_amt         = szCash_Uncl_Rdmp_Amt     +
			                           szUncl_Loan_Int_Rdmp_Amt + 
						             szEtc_Lndn_Rdmp_Amt      +
						             szEtc_Uncl_Rdmp_Amt      +
			                           szFee_Uncl_Rdmp_Amt
              tbl0.SetCellString( 12 , 1 , sz_Uncl_Rpmn_amt)		  
	      
	          '연체료
		     sz_Ncl_Ovfe              = szCash_Uncl_Ovfe        +
		                                szUncl_Loan_Int_Ovfe    +
						              szEtc_Lndn_Amt_Ovfe    +
							         szEtc_Uncl_Amt_Ovfe
	          tbl0.SetCellString( 13 , 1 , sz_Ncl_Ovfe)		  
		  
		     '신용공여일자
		     szLoan_Date      = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "LOAN_DATE" , i)
		     if szLoan_Date == "00000000" then
		         tbl0.SetCellString( 14 , 3 , "")	
		     else
		         tbl0.SetCellString( 14 , 3 , szLoan_Date)	
		     end if
			
			if  szIssuTypeCode == "35" then	
				tbl0.SetCellMaskInfo(4, 1, "0,0,,,1,,2,1,0")
				tbl0.SetCellMaskInfo(8, 1, "0,0,,,1,,2,1,1")
				tbl0.SetCellMaskInfo(6, 1, "0,0,,,1,,4,1,0")		'단가
				tbl0.SetCellMaskInfo(5, 3, "0,0,,,1,,2,1,0")		'제세금
				tbl0.SetCellMaskInfo(6, 3, "0,0,,,1,,2,1,0")		'수수료
				tbl0.SetCellString( 4, 1, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_TR_AMT" , i)) '거래금액
				tbl0.SetCellString( 8, 1, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_TFAM_NWRM" , i)) '예수금잔액
				
				tbl0.SetCellString( 5, 3, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "OVRS_PAYM_TXAM" , i)) 
				tbl0.SetCellString( 6, 3, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "OVSC_DEAL_FEE" , i)) 				
				
			elseif CDbl(szFrcrTrAmt) > 0 AND szSMCD <> "001100" AND szSMCD <> "001200" then	
				tbl0.SetCellMaskInfo(4, 1, "0,0,,,1,,2,1,0")
				tbl0.SetCellMaskInfo(8, 1, "0,0,,,1,,2,1,1")
				tbl0.SetCellString( 3, 1, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "CRCD" , i)) '종목코드
				tbl0.SetCellString( 4, 1, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_TR_AMT" , i)) '거래금액
				tbl0.SetCellString( 8, 1, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_TFAM_NWRM" , i)) '예수금잔액
			else
			
			end if
			'v0001 fin
			
			'v0002 sta ----------------------------------			
			
			Dim ovscDealFee
			
			if MID(szSMCD,1,3) = "263" or MID(szSMCD,1,3) = "273" Then
			   ovscDealFee = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "OVSC_DEAL_FEE" , i)
			   tbl0.SetCellString(6, 3, FormatNumber(ovscDealFee, 2))
			end if
			
			'v0002 fin ----------------------------------
			
              'v0003 sta --------------------------------------

              Dim sMaskInfo0
              Dim sMaskInfo1
              Dim tempSMCD

			if MID(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SMCD" , i),1,3) = "263" or MID(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SMCD" , i),1,3) = "273" or MID(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SMCD" , i),1,3) = "255" or CDBL(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_TR_AMT" , i)) > 0 then 			   								  
                 '거래적요가 해외파생/해외주식 거래이거나 외화거래금액이 0보다 클 경우 (= 모든 외화거래)
			   sMaskInfo0 = Table0.GetCellMaskInfo(0, 0)  '거래단가 소숫점 4자리 고정
			   tbl0.SetCellMaskInfo(6, 1, sMaskInfo0)		        
			   
			   tempSMCD = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "SMCD" , i)
			   if tempSMCD <> "001100" and tempSMCD <> "001200" and tempSMCD <> "007410" and tempSMCD <> "007419" and tempSMCD <> "007420" and tempSMCD <> "007429" and tempSMCD <> "007510" and tempSMCD <> "007519" and tempSMCD <> "007520" and tempSMCD <> "007529" and tempSMCD <> "007530" and tempSMCD <> "007539" and tempSMCD <> "007540" and tempSMCD <> "007550" and tempSMCD <> "071010" and tempSMCD <> "071019" and tempSMCD <> "071020" and tempSMCD <> "071029" and tempSMCD <> "071910" and tempSMCD <> "071919" and tempSMCD <> "071920" and tempSMCD <> "071929" and tempSMCD <> "985470" and tempSMCD <> "985479" and tempSMCD <> "985500" then 
			      '외화거래인데 환전 매수/매도가 아닐 경우
			      tbl0.SetCellString(4, 3, 0) '정산금액 0처리
			   end if
			   
			else
			   '외화거래가 아닐 경우
			   sMaskInfo1 = Table1.GetCellMaskInfo(0, 0)  '거래단가 소숫점 2자리 고정
			   tbl0.SetCellMaskInfo(6, 1, sMaskInfo1)		
			   '정산금액은 OutBlock1으로 받아오는 값 그대로 유지  
			end if
			 
              'v0003 fin --------------------------------------
			
			Select Case nType
				Case "01" tbl0.SetCellString( 1 , 3 , "입출금")
				Case "02" tbl0.SetCellString( 1 , 3 , "입출금")
				Case "03" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "04" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "05" tbl0.SetCellString( 1 , 3 , "매매")
				Case "06" tbl0.SetCellString( 1 , 3 , "매매")
				Case "07" tbl0.SetCellString( 1 , 3 , "매매")
				Case "08" tbl0.SetCellString( 1 , 3 , "매매")
				Case "09" tbl0.SetCellString( 1 , 3 , "매매")
				Case "10" tbl0.SetCellString( 1 , 3 , "매매")
				Case "11" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "12" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "13" tbl0.SetCellString( 1 , 3 , "매매")
				Case "14" tbl0.SetCellString( 1 , 3 , "매매")
				Case "15" tbl0.SetCellString( 1 , 3 , "입출금")
				Case "16" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "17" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "18" tbl0.SetCellString( 1 , 3 , "입출고")
				Case "19" tbl0.SetCellString( 1 , 3 , "입출고")
				Case Else tbl0.SetCellString( 1 , 3 , "입출금")
			End Select
			
			'v0004 sta --------------------------------------
			
			If DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "MRTG_NAME" , i ) = "메리츠증권" Then
		         tbl0.SetCellString( 14 , 1 , "메리츠증권" )
                  tbl0.SetCellString( 15 , 1 , "07326 서울특별시" )
                  tbl0.SetCellString( 16 , 1 , "국제금융로 10, Three IFC" )
		     
		     Else		     
		     	'START--------------------------------
				'v0006
				sIssuTypeCode  = DATAMANAGER.GetDataValue(0, "obrtp_tran_002r", "OutBlock1", "ISSU_TYPE_CODE", 0)
				
				'Form.ShowAlert( "알림", sIssuTypeCode)
				
				'종목유형코드 06:RP, 27:MMW, 30:발행어음
				If sIssuTypeCode = "06" OR sIssuTypeCode = "27" OR sIssuTypeCode = "30" Then				
					DATAMANAGER.SetDataValue( 0 , "obrtp_tran_035r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2"        )
					DATAMANAGER.SetDataValue( 0 , "obrtp_tran_035r", "InBlock1", "ACNO"          , 0 , g_szList(0))
					DATAMANAGER.SetDataValue( 0 , "obrtp_tran_035r", "InBlock1", "ASNO"          , 0 , g_szList(1))
					DATAMANAGER.SetDataValue( 0 , "obrtp_tran_035r", "InBlock1", "TR_DATE"       , 0 , g_szList(2))
					DATAMANAGER.SetDataValue( 0 , "obrtp_tran_035r", "InBlock1", "TRAN_SRNO"     , 0 , g_szList(3))	
					DATAMANAGER.RequestTranData( "obrtp_tran_035r" )
				End If
				'----------------------------------END
              End If
			
			'v0004 fin --------------------------------------
			
			'v0005 : 117120 ~ 117179 적요 추가 sta ==================================
			
			If szSMCD = "117120" or szSMCD = "117129" or szSMCD = "117130" or szSMCD = "117139" or szSMCD = "117140" or szSMCD = "117149" or szSMCD = "117150" or szSMCD = "117159" or szSMCD = "117160"or szSMCD = "117169" or szSMCD = "117170" or szSMCD = "117179" Then
			   
                 sMaskInfo1 = Table1.GetCellMaskInfo(0, 0)  '소숫점 2자리 고정
                 tbl0.SetCellMaskInfo(4, 3, sMaskInfo1)	
                 tbl0.SetCellMaskInfo(6, 3, sMaskInfo1)				   
			   
			   tbl0.SetCellString(4, 3, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "FRCR_EXCL_AMT" , i))
			   tbl0.SetCellString(6, 3, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_002r", "OutBlock1", "OVSC_DEAL_FEE" , i))
			   
			   'tbl0.SetCellString(6, 3, FormatNumber(ovscDealFee, 2))			 
			   
			End If
			
			'v0005 : 117120 ~ 117179 적요 추가 fin ==================================			
			
		next
	
	'START--------------------------------
	'v0006
	elseif szTranID == "obrtp_tran_035r" then 'v0006
		g_szRgplInfo_1 = DATAMANAGER.GetDataValue(0, "obrtp_tran_035r", "OutBlock2", "MRTG_NAME", 0)
		g_szRgplInfo_2 = DATAMANAGER.GetDataValue(0, "obrtp_tran_035r", "OutBlock2", "PDGR_NAME", 0)
		g_szRgplInfo_3 = DATAMANAGER.GetDataValue(0, "obrtp_tran_035r", "OutBlock2", "RGPL_INFO", 0)		
		
		tbl0.SetCellString( 14 , 1 , g_szRgplInfo_1 )
		tbl0.SetCellString( 15 , 1 , g_szRgplInfo_2 )
		tbl0.SetCellString( 16 , 1 , g_szRgplInfo_3 )		
	'----------------------------------END
	end if
	
End Sub

