'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obacp_comm_061r" then	'보안인증
		Email0 = DATAMANAGER.GetDataValue( 0, "obacp_comm_061r", "OutBlock1", "EMAIL_ADDR" , 0 )
		g_szEmailList = Split(Email0, "@")
		if UBOUND(g_szEmailList) < 1 then '이메일정보가없을때 종료
			Exit Sub
		End if
			
		EditInput.caption   = g_szEmailList(0)
		EditInput1.caption  = g_szEmailList(1)
		
'	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
