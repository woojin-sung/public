'============================================================================
'팝업 리턴 시
'============================================================================

Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName="MBBNK62002_T1" then
		if	sRet	=	"1"	then
			ChkButton0.chksilence = "1"
		else
			ChkButton0.chksilence = "0"
		end	if
	elseif sKeyName="MBBNK62002_T2" then
		if	sRet	=	"1"	then
			ChkButton1.chksilence = "1"
		else
			ChkButton1.chksilence = "0"
		end	if
	elseif sKeyName="MBBNK62002_T3" then
		if	sRet	=	"1"	then
			ChkButton2.chksilence = "1"
		else
			ChkButton2.chksilence = "0"
		end	if
	elseif sKeyName="MBBNK62002_T4" then
		if	sRet	=	"1"	then
			ChkButton3.chksilence = "1"
		else
			ChkButton3.chksilence = "0"
		end	if
	elseif sKeyName="MBBNK62002_T5" then
		if	sRet	=	"1"	then
			ChkButton4.chksilence = "1"
		else
			ChkButton4.chksilence = "0"
		end	if
	elseif sKeyName="MBBNK62002_T6" then
		if	sRet	=	"1"	then
			ChkButton5.chksilence = "1"
		else
			ChkButton5.chksilence = "0"
		end	if
	
	elseif sKeyName="mbbnk62004_end" or sKeyName="mbbnk62003_end" then 
		if sRet = "1" then
				Form.CloseForm()		'첫페이지(ID등록)로 이동
			end if
			
	'한번에불러오기 > 휴대폰 본인인증
	elseif sKeyName="mbbnk62006" then 
		If sRet == "cancel" then
			Exit Sub
		elseIf sRet <> "" then
			
			tData = Split(sRet, "★")
			g_CiKey = tData[1] 'cikey
			if tData[0] == "ok" then
		
				Dim sSendData
				if Combo0.cbkeydata == "0" then
					sSendData = EditInput.caption.."@"..EditInput1.caption & "★" & g_CiKey
				else
					sSendData = EditInput.caption.."@"..Combo0.caption     & "★" & g_CiKey
				end if
				if OpenGubun =="1" then
					Form.OpenFramePopup("mbbnk62003" , sSendData , sPosInfo)
				elseif OpenGubun =="2" then
					Form.OpenFramePopup("mbbnk62004" , sSendData , sPosInfo)
				end if
				'Form.CloseForm()		'첫페이지(ID등록)로 이동
			end if
		end if

	'계좌 직접 입력하기 > 2CH 추가인증
'	elseif sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" then		
'		if sRet == "ok" then
'			Form.OpenFramePopup("mbbnk62004" , "" , sPosInfo)
'		end if
'	else
'		Form.MsgBox( "알림",  sKeyName , 6 )
'	end if 
'	elseif sKeyName == "mhetc90060_p8" Then
'		If Left(Trim(sRet), 2) == "ok" Then
'		
'			Dim sSendData
'			if Combo0.cbkeydata == "0" then
'				sSendData = EditInput.caption.."@"..EditInput1.caption
'			else
'				sSendData = EditInput.caption.."@"..Combo0.caption
'			end if
'			
'			
'			Form.OpenFramePopup("mbbnk62004" , sSendData , sPosInfo)
'		end if

	end if
	SetAllCheck()
End Sub


'============================================================================
'이메일 세팅
'============================================================================

Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 0 then
		EditInput1.enable = true
	else
		EditInput1.caption = ""
		EditInput1.enable = false
	end if
End Sub


