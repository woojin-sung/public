'============================================================================

Sub Allagree_OnChange(sCheckState) '전체동의 선택시
	if sCheckState == "1" then
		ChkButton0.chksilence = "1"
		ChkButton1.chksilence = "1"
		ChkButton2.chksilence = "1"
		ChkButton3.chksilence = "1"
		ChkButton4.chksilence = "1"
		ChkButton5.chksilence = "1"
		ChkButton8.chksilence = "1"
		ChkButton6.chksilence = "1" '필수 버튼
		
	else
		ChkButton0.chksilence = "0"
		ChkButton1.chksilence = "0"
		ChkButton2.chksilence = "0"
		ChkButton3.chksilence = "0"
		ChkButton4.chksilence = "0"
		ChkButton5.chksilence = "0"
		ChkButton8.chksilence = "0"
		ChkButton6.chksilence = "0" '필수 버튼	
	end if
	
	if OpenGubun ="2" then '계좌 직접 입력하기 > 계좌통합관리 약관 안보임
		ChkButton5.chksilence = "1"
		ChkButton5.visible = false
		btnOpenBanking06.visible = false
	end if
	
	SetAllCheck()
End Sub

'============================================================================
Sub ChkButton6_OnChange(sCheckState) '필수동의 선택시
	if sCheckState == "1" then
		'ChkButton0.chksilence = "1"
		'ChkButton1.chksilence = "1"
		'ChkButton2.chksilence = "1"
		ChkButton3.chksilence = "1"
		ChkButton4.chksilence = "1"
		ChkButton5.chksilence = "1"
		
		if ChkButton1.chksilence== "0" then
			Form.OpenFramePopup("mbbnk62002_t2" , sOpenData , sPosInfo)
		end if
		
		if ChkButton2.chksilence== "0" then
			Form.OpenFramePopup("mbbnk62002_t3" , sOpenData , sPosInfo)
		end if
		
		
		if ChkButton0.chksilence== "0" then
			Form.OpenFramePopup("mbbnk62002_t1" , sOpenData , sPosInfo)
		end if
	else
		ChkButton0.chksilence = "0"
		ChkButton1.chksilence = "0"
		ChkButton2.chksilence = "0"
		ChkButton3.chksilence = "0"
		ChkButton4.chksilence = "0"
		ChkButton5.chksilence = "0"	
	end if
	
	if OpenGubun ="2" then '계좌 직접 입력하기 > 계좌통합관리 약관 안보임
		ChkButton5.chksilence = "1"
		ChkButton5.visible = false
		btnOpenBanking06.visible = false
	end if
	
	SetAllCheck()
End Sub

'============================================================================

Function SetAllCheck()
	if '필수 모두체크
	   ChkButton0.chksilence = "1" and ChkButton1.chksilence = "1" and
	   ChkButton2.chksilence = "1" and ChkButton3.chksilence = "1" and
	   ChkButton4.chksilence = "1" and ChkButton5.chksilence = "1"  then
			if ChkButton8.chksilence = "1" then '선택 체크
				Allagree.chksilence = "1"
				ChkButton6.chksilence = "1"	
			elseif ChkButton8.chksilence = "0" then '선택 미체크
				Allagree.chksilence = "0"
				ChkButton6.chksilence = "1"
			end if
	
	elseif  '하나라도 선택안되었을 시
	   ChkButton0.chksilence = "0" or ChkButton1.chksilence = "0" or
	   ChkButton2.chksilence = "0" or ChkButton3.chksilence = "0" or
	   ChkButton4.chksilence = "0" or ChkButton5.chksilence = "0"  then
			Allagree.chksilence = "0"
			ChkButton6.chksilence = "0"	
	end if

End Function


Sub ChkButton0_OnChange(sCheckState)
	if ChkButton0.chksilence = "1" then
		Form.OpenFramePopup("mbbnk62002_t1" , sOpenData , sPosInfo)
	end if
	SetAllCheck()
End Sub

Sub ChkButton1_OnChange(sCheckState)
	if ChkButton1.chksilence = "1" then
		Form.OpenFramePopup("mbbnk62002_t2" , sOpenData , sPosInfo)
	end if
	SetAllCheck()
End Sub

Sub ChkButton2_OnChange(sCheckState)
	if ChkButton2.chksilence = "1" then
		Form.OpenFramePopup("mbbnk62002_t3" , sOpenData , sPosInfo)
	end if
	SetAllCheck()
End Sub

Sub ChkButton3_OnChange(sCheckState)
	SetAllCheck()
End Sub

Sub ChkButton4_OnChange(sCheckState)
	SetAllCheck()
End Sub

Sub ChkButton5_OnChange(sCheckState)
	SetAllCheck()
End Sub

Sub ChkButton8_OnChange(sCheckState)
	SetAllCheck()
End Sub


