'note
'마케팅 목적동의 요건 미정의로 기본체크 및 숨김처리, 추후 추가시 사용 201113

'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim OpenGubun
Dim szCust_Num
Dim Email0
Dim Email1
Dim Email2

Dim	g_Service

Dim g_CiKey
Sub Form_OnFormInit()
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
	
	Image0.imgpath = "title_3step_cut_01_on.png"
	
	OpenGubun = Form.GetOpenLinkData()
	
	if OpenGubun ="2" then '계좌 직접 입력하기 > 계좌통합관리 약관 안보임
		ChkButton5.chksilence = "1"
		ChkButton5.visible = false
		btnOpenBanking06.visible = false
	end if
	DATAMANAGER.RequestTranData( "obacp_comm_061r" ) '고객번호로 이메일 조회
	
End Sub

