'============================================================================
' 화 면 명 : 주식주문_미체결팝업
' 화면설명 : 주식주문 정정/취소화면에서 미체결버튼 클릭시 오픈
' 작    성 : 2016.01.29 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_Tab
Dim g_szOpen '20181210_01 KBC

Dim g_szData
Dim g_szItemCode
'============================================================================
' TR_Inquiry()
'============================================================================
Function TR_Inquiry()
	Dim nAcNo, nAsNo
	nAcNo = g_szAcnt
	nAsNo = g_szAcntCd
	'Test 계좌
'	nAcNo = "30158194"
'	nAsNo = "02"

	Dim DEAL_CLS_CODE, NEW_CLRN_CLCD, CNTG_CLS_CODE
	
	if rdoMedosu.currentindex = 1 or rdoMedosu.currentindex = "1" then ' 매수
		DEAL_CLS_CODE = "2"
	Elseif rdoMedosu.currentindex = 2 or rdoMedosu.currentindex = "2" then ' 매도
		DEAL_CLS_CODE = "1"
	Else
		DEAL_CLS_CODE = "%"
	End if
	
	if rdoNEW.currentindex = 1 or rdoNEW.currentindex = "1" then ' 신규
		NEW_CLRN_CLCD = "1"
	Elseif rdoNEW.currentindex = 2 or rdoNEW.currentindex = "2" then ' 청산
		NEW_CLRN_CLCD = "2"
	Else
		NEW_CLRN_CLCD = "%"
	End if
	
	if rdoCNTG.currentindex = 1 or rdoCNTG.currentindex = "1" then ' 체결
		CNTG_CLS_CODE = "1"
	Elseif rdoCNTG.currentindex = 2 or rdoCNTG.currentindex = "2" then ' 미체결
		CNTG_CLS_CODE = "2"
	Else
		CNTG_CLS_CODE = "%"
	End if
	
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "ACNO", 0 , nAcNo)
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "ASNO", 0 , nAsNo)
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "DEAL_CLS_CODE", 0 , DEAL_CLS_CODE )
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "NEW_CLRN_CLCD", 0 , NEW_CLRN_CLCD )
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "CNTG_CLS_CODE", 0 , CNTG_CLS_CODE )
	DATAMANAGER.SetDataValue(0, "obtrc_cntg_001r", "InBlock1", "UI_SORT_CLS_VAL", 0 , "2")
	DATAMANAGER.RequestTranData("obtrc_cntg_001r")
	
End Function

'============================================================================
' Get_DEAL_CLS_CODE - 전체매수매도구분
'============================================================================
Function Get_DEAL_CLS_CODE()
	if rdoMedosu.currentindex == "2" or rdoMedosu.currentindex == 2 then
		return "1" '매도
	elseif rdoMedosu.currentindex == "1" or rdoMedosu.currentindex == 1 then
		return "2" '매수
	else
		return "%" '전체
	end if
	
End Function

'============================================================================
' Get_NEW_CLRN_CLCD - 전체신규청산구분
'============================================================================
Function Get_NEW_CLRN_CLCD()
	if rdoNEW.currentindex == "2" or rdoNEW.currentindex == 2 then
		return "2" '청산
	elseif rdoNEW.currentindex == "1" or rdoNEW.currentindex == 1 then
		return "1" '신규
	else
		return "%" '전체
	end if
	
End Function

