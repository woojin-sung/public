'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	
	Form.SetScreenName("CFD체결/미체결")	

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if
	
	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_Tab      = tData(2)
		g_szGbn    = tData(3)
		
		DATAMANAGER.RequestTranData("obtrc_cntg_001r")
		
		'20181210_01 KBC START
		g_szOpen = szOpen 
		
		if g_Tab == "3" then '취소주문탭
			btnOrdCancel.visible = true
			grd0.height = 500
			rdoCNTG.currentindex = 2
		else
			rdoCNTG.currentindex = 0
		end if
		'20181210_01 KBC END
		
		TR_Inquiry()
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket

	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrc_cntg_001r" then	
		For iCnt = grd0.rowcount - 1 To 0 Step -1
			szItem = grd0.GetCellData( "bd_Cd", iCnt)
			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
'			If szMarket = "BN" or szMarket = "MM" Then
'				grd0.SetDeleteRow( iCnt )
'			Else
			
				'매매구분
				szData = grd0.GetCellData( "bd_TypeCd", iCnt)
				szData2 = grd0.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
						
				If szData2 = "2" Then								'정정
					If szData = "1" Then
						grd0.SetCellData("bd_TypeNm", iCnt, "매도정정")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellData("bd_TypeNm", iCnt, "매수정정")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
					
				ElseIf szData2 = "3" Then								'취소
					If szData = "1" Then
						grd0.SetCellData("bd_TypeNm", iCnt, "매도취소")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellData("bd_TypeNm", iCnt, "매수취소")
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
					End If
					
				Else
					If szData = "1" Then
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grd0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
				End If
				
				'처리구분
				szData = grd0.GetCellData( "bd_ProcCd", iCnt)
				
				Select Case szData
					Case "0" grd0.SetCellData("bd_ProcNm", iCnt, "미접수")
					Case "1" grd0.SetCellData("bd_ProcNm", iCnt, "접수")
					Case "2" grd0.SetCellData("bd_ProcNm", iCnt, "확인")
					Case "3" grd0.SetCellData("bd_ProcNm", iCnt, "거부")
					Case "4" grd0.SetCellData("bd_ProcNm", iCnt, "PT효력정지")
				End Select
'			End If
		Next
	end if
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obtrc_cntg_001r" )
	
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obtrc_cntg_001r" )
		
	end if
End Sub

'============================================================================
' grd0_OnClickUp
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
	
	if lRow > -1 then
		szCd      = grd0.GetCellData("bd_Cd",       lRow)
		szQty     = grd0.GetCellData("bd_MicheQty", lRow)
		szOdrNo   = grd0.GetCellData("bd_OdrNo",    lRow)	
		szOdrType = grd0.GetCellData("bd_OdrType",  lRow)
		szOdrPrc  = grd0.GetCellData("bd_OdrPrc",   lRow)
		szClsCd   = grd0.GetCellData("bd_ClsCd",    lRow)
		szDate    = grd0.GetCellData("bd_LoanDate", lRow)
		szSvcType = grd0.GetCellData("bd_TypeCd", lRow)
		szOdrTypeNm = grd0.GetCellData("bd_OdrTypeNm", lRow) '신규/청산
		
		szMk = Form.GetItemCodeInfo(szCd, "market")
		
		'20180719 LES START - KOTC시장(T) 추가
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then		
			' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문상태/매수매도구분/신규청산구분
			szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd & "♥" & szSvcType & "♥" & szOdrTypeNm
		
			Form.SendReturnToParent("13000_CONTRACT", szData)
			Form.CloseForm()
		else
			szCutCd = Mid(szCd, 2, Len(szCd))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
			
			'20180719 LES START - KOTC시장(T) 추가
			if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
				' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문상태/매수매도구분
				szData = "미체결" & "★" & g_Tab & "★" & szCutCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd & "♥" & szSvcType & "♥" & szOdrTypeNm

				Form.SendReturnToParent("13000_CONTRACT", szData)
				Form.CloseForm()			
			else
				Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
			end if
		end if
	end if	
End Sub

'============================================================================
'20181210_01 KBC START
Sub btnOrdCancel_OnClick()
	Dim szSendData
	'계좌정보|매수매도구분값|신규청산구분값
	szSendData = g_szOpen & "★" & Get_DEAL_CLS_CODE() & "★" & Get_NEW_CLRN_CLCD()
	
	Form.openFramePopupEx("mbtrs13000_pj", szSendData, "")
	Form.CloseForm()
End Sub
'20181210_01 KBC END

