Dim g_sOpenData

'============================================================================
Sub Form_OnFormInit()
	g_sOpenData = Form.GetOpenLinkData()

	if g_sOpenData == "" or g_sOpenData == null then
		Form.ShowAlert("알림", "펀드자동이체 신청 정보가 없습니다.")
		Form.CloseForm()
		Exit Sub
	end if
	
End Sub

'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'btnClose_OnClick
'============================================================================
Sub btnClose_OnClick()
	g_sOpenData = "CANCEL"
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	g_sOpenData = "CANCEL"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51020_p2", g_sOpenData)
End Sub

