		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 체크배열 초기화
'===============================================
Function Clear_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "0"	
	next 
End Function

'===============================================
' 체크배열 전체선택
'===============================================
Function All_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "1"	
	next 
End Function

'===============================================
' 배열 인덱스 추출
'===============================================
Function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData = null or arrData = "" then
		return nReturn
	end if
	
	if szData = null or szData = "" then
		return nReturn
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = szData then
			nReturn = i
			exit for
		end if	
	next 
	
	return nReturn
End Function

Function Return_AllChkYN(arrData)
	if arrData = null or arrData = "" then
		return "N"
	end if
	
	nArrCnt = #arrData
	for i = 1 to nArrCnt-1
		if arrData(i) = "0" then
			return "N"
		end if	
	next 
	
	return "Y"
End Function

Function Return_ClearChkYN(arrData)
	if arrData = null or arrData = "" then
		return "N"
	end if
	
	nArrCnt = #arrData
	for i = 1 to nArrCnt-1
		if arrData(i) = "1" then
			return "N"
		end if	
	next 
	
	return "Y"
End Function



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	
	szData = Form.GetOpenLinkData()
	
	if szData = null or trim(szData) = "" then
		exit Sub
	end if
	
	szArrData = split(szData, "★")
	
	nArrCnt = #szArrData
	
	if nArrCnt > 3 then
		g_szLinkGbn = szArrData(0)

		g_szDupSel = szArrData(1)
		
		szContData = szArrData(2)
		szContData2 = szArrData(3)
		
		
		szSavaData1 = ""
		szSavaData2 = ""
		if #szArrData > 4 then
			szSavaData1 = szArrData(4)
		end if
		
		if #szArrData > 5 then
			szSavaData2 = szArrData(5)
		end if
		
		g_szSelData = szSavaData2
		
		if g_szDupSel = "1" then
			szContData = "전체`" & szContData
		end if
		
		if szContData <> "" then
			g_arrContent = Convert_StringToArr(szContData, "`")
		end if
		
		nArrCnt = #g_arrContent
		
		g_arrContent_Check = {}
		for i = 0 to nArrCnt-1
			if instr(szSavaData1, g_arrContent(i)) > 0 then
				g_arrContent_Check(i) = "1"
			else
				g_arrContent_Check(i) = "0"
			end if
		next
		
		if szContData2 <> "" then
			g_arrContent2 = Convert_StringToArr(szContData2, "`")
		end if
		nArrCnt = #g_arrContent2
		
		g_arrContent2_Check = {}
		
		for i = 0 to nArrCnt-1
			if instr(szSavaData2, g_arrContent2(i)) > 0 then
				g_arrContent2_Check(i) = "1"
			else
				g_arrContent2_Check(i) = "0"
			end if
		next
	end if
	
	Init_Control()
	Init_Content()
End Sub

'===============================================
' imgBack_OnClick
'===============================================
Sub imgBack_OnClick()
End Sub

'============================================================================
Sub contBg_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelBtn(nIndex, sCellID)
End Sub

'============================================================================
Sub contBg_Pannel1_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelList(nIndex, sCellID)
End Sub

'============================================================================
Sub contBg_btnOk_OnClick()
	szContent0 = Convert_ChkArrToString(g_arrContent, g_arrContent_Check, "`")
	szContent1 = Convert_ChkArrToString(g_arrContent2, g_arrContent2_Check, "`")
	
	szReturnData = szContent0 & "★" & szContent1
	Form.SendReturnToParent("RETURN_DATA_"&g_szLinkGbn, szReturnData)
	Form.CloseForm()
End Sub

'============================================================================
Sub contBg_btnCancel_OnClick()
	Clear_Content("0")
	Clear_Content("1")
	
	DisplaySetting_PannelList(1, "lbl0")
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

