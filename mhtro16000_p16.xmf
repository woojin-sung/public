Dim g_arrContent2_Check
g_arrContent2_Check = Array("0", "0", "0", "0")

Dim g_szLinkGbn, g_szDupSel

Dim g_nPannel0_Height
g_nPannel0_Height = 0

Dim g_nPannel1_Height
g_nPannel1_Height = 0

Dim g_szSelData
g_szSelData = "거래량 많은순"
