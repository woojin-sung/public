'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	contBg.btnCancel.caption = "초기화"
	contBg.btnOK.caption = "검색"
	
	contBg.lblGuideLine.bgcolor = g_szLineColor_Title
	
	contBg.lblSubTitle0.paddinginfo = "0,0,0,0"
	contBg.lblSubTitle1.paddinginfo = "0,0,0,0"
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function DisplaySetting_Content()
	nTotalHeight = 102 + g_nPannel0_Height + 45 + g_nPannel1_Height + 10 + 60
	contBg.top = 647 - nTotalHeight +2
	contBg.height = nTotalHeight+5
	
	contBg.lblSubTitle0.top = 102 + g_nPannel1_Height + 19
	contBg.Pannel0.top = 102 + g_nPannel1_Height + 19 + 26
	
	contBg.btnCancel.top = 102 + g_nPannel0_Height + 19 + 26 + g_nPannel1_Height + 10 + 12
	contBg.btnOk.top = 102 + g_nPannel0_Height + 19 + 26 + g_nPannel1_Height + 10 + 12
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Content()
	nArrCnt = #g_arrContent2
	
	nPannelRowCnt = Cint(nArrCnt / 2)
	if (nArrCnt mod 2) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	contBg.Pannel1.rowcount = nPannelRowCnt
	
	g_nPannel1_Height = (35 * nPannelRowCnt) + (10 * (nPannelRowCnt-1)) + 1
	contBg.Pannel1.height = g_nPannel1_Height
	
	nArrIdx = 0
	szData = ""
	for i = 0 to nPannelRowCnt - 1
		if instr(g_arrContent2(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent2(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent2(nArrIdx)
		end if
		
		if g_arrContent2_Check(nArrIdx) = "1" then
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Select)
		else 
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
		end if
	

		contBg.Pannel1.SetCellValue( "lbl0", i, szData)	
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contBg.Pannel1.SetCellVisible("lbl1",i,false)
			Exit for
		end if
	
		if instr(g_arrContent2(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent2(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent2(nArrIdx)
		end if
		
		if g_arrContent2_Check(nArrIdx) = "1" then
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Select)
		else 
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)
		end if
		
		contBg.Pannel1.SetCellValue( "lbl1", i, szData)	
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	nArrCnt = #g_arrContent

	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	contBg.Pannel0.rowcount = nPannelRowCnt
	
	g_nPannel0_Height = (35 * nPannelRowCnt) + (10 * (nPannelRowCnt-1)) + 1
	contBg.Pannel0.height = g_nPannel0_Height
	
	nArrIdx = 0
	szData = ""
	
	for i = 0 to nPannelRowCnt - 1
		if instr(g_arrContent(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent(nArrIdx)
		end if
		
		if g_arrContent_Check(nArrIdx) = "1" then
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Select)
			contBg.Pannel0.SetPropCardCell("fgcolor", "lbl0", i, g_szTxtColor_Normal)
		else 
			if g_szSelData == "거래량 많은순" or g_szSelData == "거래량 적은순" then
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Disable)
				contBg.Pannel0.SetPropCardCell("fgcolor", "lbl0", i, g_szTxtColor_Grey)
			else
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
				contBg.Pannel0.SetPropCardCell("fgcolor", "lbl0", i, g_szTxtColor_Normal)
			end if
			
		end if
		
		contBg.Pannel0.SetCellValue( "lbl0", i, szData)	
		
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			contBg.Pannel0.SetCellVisible("lbl1",i,false)
			contBg.Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
	
		if instr(g_arrContent(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent(nArrIdx)
		end if
		
		if g_arrContent_Check(nArrIdx) = "1" then
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Select)
			contBg.Pannel0.SetPropCardCell("fgcolor", "lbl1", i, g_szTxtColor_Normal)
		else 
			if g_szSelData == "거래량 많은순" or g_szSelData == "거래량 적은순" then
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Disable)
				contBg.Pannel0.SetPropCardCell("fgcolor", "lbl1", i, g_szTxtColor_Grey)
			else
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)
				contBg.Pannel0.SetPropCardCell("fgcolor", "lbl1", i, g_szTxtColor_Normal)
			end if
			
		end if
		
		contBg.Pannel0.SetCellValue( "lbl1", i, szData)	
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contBg.Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
		
		if instr(g_arrContent(nArrIdx), "^") > 0 then
			arrTempData = Convert_StringToArr(g_arrContent(nArrIdx), "^")
			szData = arrTempData(1)
		else
			szData = g_arrContent(nArrIdx)
		end if
		
		if g_arrContent_Check(nArrIdx) = "1" then
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Select)
			contBg.Pannel0.SetPropCardCell("fgcolor", "lbl2", i, g_szTxtColor_Normal)
		else 
			if g_szSelData == "거래량 많은순" or g_szSelData == "거래량 적은순" then
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Disable)
				contBg.Pannel0.SetPropCardCell("fgcolor", "lbl2", i, g_szTxtColor_Grey)
			else
				contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)
				contBg.Pannel0.SetPropCardCell("fgcolor", "lbl2", i, g_szTxtColor_Normal)
			end if
			
		end if
		
		contBg.Pannel0.SetCellValue( "lbl2", i, szData)	
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next

	
	
	DisplaySetting_Content()
End Function

Function Clear_Content(szGbn)
	
	if szGbn = "0" then
		nArrCnt = #g_arrContent
		
		nPannelRowCnt = Cint(nArrCnt / 3)
		if (nArrCnt mod 3) > 0 then
			nPannelRowCnt = nPannelRowCnt + 1
		end if 
		
		nArrIdx = 0
		
		for i = 0 to nPannelRowCnt - 1
			g_arrContent_Check(nArrIdx) = "0"
			
			contBg.Pannel0.SetPropCardCell("fgcolor", "lbl0", i, g_szTxtColor_Normal)
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
			
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
			
			g_arrContent_Check(nArrIdx) = "0"
			contBg.Pannel0.SetPropCardCell("fgcolor", "lbl1", i, g_szTxtColor_Normal)
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)
			
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
			
			g_arrContent_Check(nArrIdx) = "0"
			contBg.Pannel0.SetPropCardCell("fgcolor", "lbl2", i, g_szTxtColor_Normal)
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)
			
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
		next
		
		if g_szDupSel = "1" then
			g_arrContent_Check(0) = "1"
			contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
		end if
		
	elseif szGbn = "1" then
		nArrCnt = #g_arrContent2
		
		nPannelRowCnt = Cint(nArrCnt / 2)
		if (nArrCnt mod 2) > 0 then
			nPannelRowCnt = nPannelRowCnt + 1
		end if 
		
		nArrIdx = 0
		for i = 0 to nPannelRowCnt - 1
			g_arrContent2_Check(nArrIdx) = "0"
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
			
			g_arrContent2_Check(nArrIdx) = "0"
			contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)
			nArrIdx = nArrIdx + 1
			
			if nArrIdx > nArrCnt - 1 then
				Exit for
			end if
		next

	end if
	
End Function

