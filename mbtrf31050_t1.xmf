' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'20220915 LES START 상품선물 추가
'20231121 SWJ START : 제도개선 : 주식선물 ETF 호가 단위 변경
				   '2000 미만은 1원, 2000원 이상은 5원 단위로 변경
' 20240412 HSZ 코스닥글로벌지수 추가 (KF)

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'주문 환경
Dim g_szOdrPop
Dim g_szBtnMkt

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szBuyQty, g_szBuyQtyCnt

' 주문후 
Dim g_szAfterOrg

'20170726 HAMWG : 수량 연동위한 잔고팝업 리턴여부 플래그
Dim g_szBalQty
g_szBalQty = false

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_bBtnMkClk
g_bBtnMkClk = false

Dim g_szAble
g_szAble = "0"

Dim g_szTitle
g_szTitle ="알림"

Dim g_bRtnData
g_bRtnData = false

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'======================================
' Init_AfterOrder : 주문후 초기화
'======================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtPrc.caption = ""
End Function

'======================================
' Load_OrderSet : 환경설정값 정의
'======================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szBtnMkt     = Form.LoadConfigData("SET_ORDER", "BTN_MARKET")				' 시장가 주문버튼
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szBuyQty     = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_BUYQTY")		' 매수수량 자동입력
	g_szBuyQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_BUYQTYCNT")	' 매수수량 계약수(수량입력 선택시)
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 시장가 주문버튼(기본값 : 미사용)
	if Trim(g_szBtnMkt) = "1" then
		btnMkBuy.visible = true
	else
		btnMkBuy.visible = false
	end if	
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170726 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170726 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매수수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szBuyQty) = "" then
		g_szBuyQty = "0"		
	end if	

End Function

'======================================
' Visible_Control : nGbn(유형)
'======================================
Function Visible_Control(nGbn)
	' 보통, 조건부지정가, 보통(IOC), 보통(FOK)
	Select case nGbn
		case 0, 2, 4, 7
			edtPrc.enable = true
			btnPPlus.enable = true
			btnPMinus.enable = true
		case else
			edtPrc.caption = ""
			edtPrc.enable = false	
			btnPPlus.enable = false
			btnPMinus.enable = false
	End Select
End Function

'======================================
' Check_OrdType : 호가유형코드 확인
'======================================
Function Check_OrdType()
	Dim szIdx
	
	if g_bBtnMkClk = true Then					'시장가 주문
		return "1"	
	else '일반주문
		szIdx = cmbType.currentindex

		Select Case szIdx
			Case "0"				' 지정(일반)
				return "2"
			Case "1"				' 시장(일반)
				return "1"
			Case "2"				' 조건부
				return "I"
'			Case "3"				' 최유리(일반) 20191010 최유리지정가삭제 ITSM T1909260011
'				return "X"  
		End Select 			
    End If
End Function

'======================================
' Check_CondCode : 주문조건 구분 확인
'======================================
Function Check_CondCode()
	Dim szIdx
	
	if g_bBtnMkClk = true Then					'시장가 주문
		return "0"
	else '일반주문
		szIdx = cmbType.currentindex
		return "0" 	
    End If
End Function

'======================================
' Check_InputData
'======================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) = false then
		return false
	end if

	if Trim(g_szCd) = "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) = "" or Trim(edtQty.caption) = "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn <> 1 then
		szType = Check_OrdType()
		
		'20170829 HAMWG START : 스프레드 종목 가격 0 주문 가능하도록 수정
		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
	
		' 2018.01.03 nzInnerMarket > 주식선물일때에는 16으로 내려오고 있음.
		'20180323 LES START - 코스닥150옵션/KRX300선물 추가.
		if szType == "2" or szType = "I" then	' 지정, 조건부
			if (g_szMk == "F" and nzInnerMarket == 4) or (g_szMk == "JF" and nzInnerMarket == 16) or (g_szMk == "MF" and nzInnerMarket == 7) or (g_szMk == "XF" and nzInnerMarket == 42) then	'스프레드 종목
				if Trim(edtPrc.caption) == "" then
					Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
					return false
				end if
			
			'20220915 LES START 상품선물 추가
			'금리선물/스프레드 (g_szMk:CF, nzInnerMarket = 52 / 53)
			'통화선물/스프레드 (g_szMk:CF, nzInnerMarket = 54 / 55)
			'상품선물/스프레드 (g_szMk:CF, nzInnerMarket = 56 / 57) 
			'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
			elseif g_szMk = "CF" or g_szMk = "FF" then
				
				if Trim(edtPrc.caption) == "" then
					Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
					return false
				end if
			
			'20220915 LES END
			
			
			else
				if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" or Trim(edtPrc.caption) == "0.00" then
					Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
					return false
				end if	
			end if
		end if
		'20170829 HAMWG END
	end if	
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop = "1" then
			Open_ConfirmPopup()
		else
			Request_Order(0)
		end if
	end if
	
	return true
End Function

'======================================
' Open_ConfirmPopup
'======================================
Function Open_ConfirmPopup(szWarn)
	'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
	szAbleCd = Return_OrderAbleCd(g_szCd) 

	if szAbleCd = "1" then
		Form.ShowAlert("안내", "해당종목은 MTS 거래 불가 종목입니다.")
		exit Function
	end if
	'20240111 HWG END
	
	Dim szData
	
	szData = "10"															' 매매구분
'	szData = szData & "|" & g_szMk											' 시장구분
	szData = szData & "|" & Form.GetCtlProp("#acnt", "caption")					' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname")				' 계좌명
	szData = szData & "|" & g_szCd											' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")				' 종목명
	szData = szData & "|" & cmbType.caption									' 주문구분
	szData = szData & "|" & edtPrc.caption									' 주문가격	
	szData = szData & "|" & edtQty.caption									' 주문수량
	szData = szData & "|" & ""												' 원주문번호
'	szData = szData & "|" & ""												' 전량전부
	
	if Trim(szWarn) <> "" then
		szData = szData & "|" & szWarn										' 경고메세지
		
		Form.OpenPopup("mbtrf31050_p6", szData , "")		' 경고팝업 오픈
	else
		Form.OpenPopup("mbtrf31050_p2", szData , "")		' 주문확인팝업 오픈
	end if
End Function

'======================================
' Request_Order
'======================================
Function Request_Order(nGbn)
	if nGbn = 1 then
		g_szWarnFlag = "Y"
	else
		g_szWarnFlag = "N"
	end if
	
	'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
	szAbleCd = Return_OrderAbleCd(g_szCd) 
	
	if szAbleCd <> "1" then
		DATAMANAGER.RequestTranData("obtrf_oder_401c")			' 선물옵션주문
	else
		Form.ShowAlert("안내", "해당종목은 MTS 거래 불가 종목입니다.")
	end if
	'20240111 HWG END
	
	
End Function

'======================================
' Check_Account
'======================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'======================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'======================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun
	
	szPrc  = edtPrc.caption
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	szHyun = Form.GetCtlProp("#lblHyun", "caption")
	
	if g_szMk = "F" then			' 선물
		szUnit = "0.05"
	elseif g_szMk = "MF" then		' 미니선물
		szUnit = "0.02"
	
	'20180323 LES START - 코스닥150옵션/KRX300선물 추가
	elseif g_szMk = "XF" then
		szUnit = "0.2"
	
	elseif g_szMk = "QO" then
		if CDbl(szPrc) >= 50.00 then
			szUnit = "0.5"
		else
			szUnit = "0.1"
		end if
	'20180323 LES END - 코스닥150옵션/KRX300선물 추가
	
	' 20240412 HSZ START : 코스닥글로벌지수 추가
	elseif g_szMk == "KF" then
		szUnit = "0.1"
	' 20240412 HSZ END
	
	else							' 옵션/미니옵션
		szUnit = "0.01"
		
	end if
	
	if Trim(szPrc) = "" then
		szPrc = szHyun
	else
		szUnit = Init_Unit(szPrc, nGbn)
		szPrc = ReSet_Prc(szPrc, nGbn)
		szPrc = Set_Unit(szPrc)
		
		' 20230127_01 HWG START : 틱계산 가격제한 해제
		' * 실시간 상하한가 제한 없는 종목 틱계산 오류발생 하여 해제 
		
		' + 버튼 클릭 /////////////////////////////
		if nGbn = 0 then		
'			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
'				szPrc = szHigh
'			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
'				szPrc = szLow
'			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
'			end if
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn = 1 then						
'			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
'				szPrc = szHigh		
'			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
'				szPrc = szLow
'			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
'			end if
		end if
		' 20230127_01 HWG END
	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function


'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData)
	Dim szChk
	
	szChk = InStr(CStr(szData), ".")
	
	if CStr(szChk) == "0" then
		return szData & ".00"
	else
		szCha = CInt(Len(szData) - szChk)
		
		if CStr(szCha) == "1" then 
			return szData & "0"
		end if
	end if
	
	return szData
End Function


'============================================================================
' ReSet_Prc : 20160324 추가
'============================================================================
Function ReSet_Prc(szData, nGbn)
		
	'20220915 LES START 상품선물 추가
	'금리선물/스프레드 (g_szMk:CF, nzInnerMarket = 52 / 53)
	'통화선물/스프레드 (g_szMk:CF, nzInnerMarket = 54 / 55)
	'상품선물/스프레드 (g_szMk:CF, nzInnerMarket = 56 / 57) 
	'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
	if g_szMk = "CF" or g_szMk = "FF" then
	
		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
		
		'상품선물(금)
		if nzInnerMarket == 56 or nzInnerMarket == 57 then
			nUnit =  10.0
	
		'금리선물(국채)
		elseif nzInnerMarket == 52 or nzInnerMarket == 53 then
			nUnit = 0.01
			
			'20240213 LES START
			'30년국채 호가단위 0.02
			nzName = Form.GetItemCodeInfo(g_szCd, "name")
			if Instr(nzName,"30년국채") > 0 then
				nUnit = 0.02
			end if
			'20240213 LES END
			
	
		'통화선물(미국달러)
		else
			nUnit = 0.10
		end if
					
		'+ 버튼
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod nUnit, 2)
			
			if nResult <> 0 and nResult <> nUnit then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		
		'- 버튼
		else
			nResult = Round(CDbl(szData) Mod nUnit, 2)

			if nResult <> 0 then
				return CDbl(szData) + (nUnit - nResult)
			else
				return szData
			end if
		end if
	'20220915 LES END
	
	
	elseif g_szMk == "O" or g_szMk == "WO" then	' 옵션	' 20190809_01 HWG : 위클리옵션추가
		if nGbn == 0 then
			if CDbl(szData) >= 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)
				 
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				return szData
			end if
		else
			if CDbl(szData) > 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)
				
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) + (0.05 - nResult)
				else
					return szData
				end if
			else
				return szData
			end if
		end if		
	elseif g_szMk == "MO" then		' 미니옵션
		if nGbn == 0 then
			if CDbl(szData) >= 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)
				 
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			elseif CDbl(szData) < 10.00 and CDbl(szData) >= 3.00 then
				nResult = Round(CDbl(szData) Mod 0.02, 2)
				
				if nResult <> 0 and nResult <> 0.02 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				return szData
			end if
		else
			if CDbl(szData) > 10.00 then 
				nResult = Round(CDbl(szData) Mod 0.05, 2)

				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) + (0.05 - nResult)
				else
					return szData
				end if
			elseif CDbl(szData) <= 10.00 and CDbl(szData) > 3.00 then
				nResult = Round(CDbl(szData) Mod 0.02, 2)
				
				if nResult <> 0 and nResult <> 0.02 then
					return CDbl(szData) + (0.02 - nResult)
				else
					return szData
				end if
			else
				return szData
			end if
		end if			
	'----------------------------------------------------------
	'20180323 LES START - 코스닥150옵션/KRX300선물 추가
	elseif g_szMk == "QO" then
		'+ 버튼
		if nGbn == 0 then
			'50P이상
			if CDbl(szData) >= 50.00 then
				nResult = Round(CDbl(szData) Mod 0.5, 2)
				
				if nResult <>  0 and nResult <> 0.5 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			
			'50P미만
			else
				return szData
			end if
		
		'- 버튼
		else
			'50P이상
			if CDbl(szData) > 50.00 then
				nResult = Round(CDbl(szData) Mod 0.5, 2)
					
				if nResult <> 0 and nResult <> 0.05 then
					return CDbl(szData) + (0.5 - nResult)
				else
					return  szData
				end if
				
			'50P미만
			else
				return szData
			end if
				
		end if
	
	'-------------------------------------------------------------
	elseif g_szMk == "XF" then
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.2, 2)
			
			if nResult <> 0 and nResult <> 0.2 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.2, 2)

			if nResult <> 0 then
				return CDbl(szData) + (0.2 - nResult)
			else
				return szData
			end if
		
		end if
	'20180323 LES END
	'--------------------------------------------------------------
	
	' 20240412 HSZ 코스닥글로벌지수 추가
	elseif g_szMk == "KF" then
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.10, 2)
			
			if nResult <> 0 and nResult <> 0.10 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.10, 2)
	
			if nResult <> 0 then
				return CDbl(szData) + (0.10 - nResult)
			else
				return szData
			end if
		end if				
	' 20240412 HSZ 코스닥글로벌지수 추가
	
	elseif g_szMk == "MF" then		' 미니선물
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.02, 2)
			
			if nResult <> 0 and nResult <> 0.02 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.02, 2)
			
			if nResult <> 0 then
				return CDbl(szData) + (0.02 - nResult)
			else
				return szData
			end if
		end if
	else							' 선물, 그외?
		
		'20240201_01 KBC START : 코스닥150선물 추가 (코스닥150은 g_szMk로만 구분 불가) - ReSet_Prc
		'   코스닥 150 옵션은 QO, 선물/스프레드는 F로 정의됨
		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
		
		if g_szMk == "F" and (nzInnerMarket == 43 or nzInnerMarket == 44 or nzInnerMarket == 45) then
			'코스닥 150 (선물, 스프레드, 옵션)
			if nGbn == 0 then
				nResult = Round(CDbl(szData) Mod 0.10, 2)
				
				if nResult <> 0 and nResult <> 0.10 then
					return CDbl(szData) - nResult
				else
					return szData
				end if
			else
				nResult = Round(CDbl(szData) Mod 0.10, 2)
	
				if nResult <> 0 then
					return CDbl(szData) + (0.10 - nResult)
				else
					return szData
				end if
			end if					
		end if						
		'20240201_01 KBC END	
		
		if nGbn == 0 then
			nResult = Round(CDbl(szData) Mod 0.05, 2)
			
			if nResult <> 0 and nResult <> 0.05 then
				return CDbl(szData) - nResult
			else
				return szData
			end if
		else
			nResult = Round(CDbl(szData) Mod 0.05, 2)

			if nResult <> 0 then
				return CDbl(szData) + (0.05 - nResult)
			else
				return szData
			end if
		end if
	end if		
End Function

'============================================================================
' Init_Unit : 2016.03.24 분리
'============================================================================
Function Init_Unit(szPrc, nGbn)
	Dim szMkType 
	
	'20220915 LES START 상품선물 추가
	'금리선물/스프레드 (g_szMk:CF, nzInnerMarket = 52 / 53)
	'통화선물/스프레드 (g_szMk:CF, nzInnerMarket = 54 / 55)
	'상품선물/스프레드 (g_szMk:CF, nzInnerMarket = 56 / 57) 
	'20221116 HWG : (거래소 차세대) 상품선물 상품유형 추가
	if g_szMk = "CF" or g_szMk = "FF" then

		nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
		
		'상품선물(금)
		if nzInnerMarket == 56 or nzInnerMarket == 57  then
			return "10.0"
		
		'금리선물(국채)
		elseif nzInnerMarket == 52 or nzInnerMarket == 53 then
			
			'20240213 LES START
			'30년국채 호가단위 0.02
			nzName = Form.GetItemCodeInfo(g_szCd, "name")
			if Instr(nzName,"30년국채") > 0 then
				return "0.02"
			end if
			'20240213 LES END
			
			return "0.01"
		
		'통화선물(미국달러)
		else
			return "0.10"
		end if
	
	'20220915 LES END 
	
	elseif g_szMk == "O" or g_szMk == "WO" then	' 옵션	' 20190809_01 HWG : 위클리옵션추가
		if nGbn == 0 then
			if CDbl(szPrc) >= 10.00 then 
				return "0.05"
			else
				return "0.01"
			end if
		else
			if CDbl(szPrc) > 10.00 then 
				return "0.05"
			else
				return "0.01"
			end if
		end if		
	elseif g_szMk == "MO" then		' 미니옵션
		if nGbn == 0 then
			if CDbl(szPrc) >= 10.00 then 
				return "0.05"
			elseif CDbl(szPrc) < 3.00 then
				return "0.01"
			else
				return "0.02"
			end if
		else
			if CDbl(szPrc) > 10.00 then 
				return "0.05"
			elseif CDbl(szPrc) <= 3.00 then
				return "0.01"
			else
				return "0.02"
			end if
		end if
		
	'20180320 LES START - KRX300선물/코스닥150옵션 추가 
	elseif g_szMk == "QO" then
		if nGbn == 0 then
			if CDbl(szPrc) >= 50.00 then
				return "0.5"
			else
				return "0.1"
			end if
		else
			if CDbl(szPrc) > 50.00 then
				return "0.5"
			else
				return "0.1"
			end if
		end if
		
	elseif g_szMk == "XF" then
		return "0.2"
	'20180320 LES END	- KRX300선물/코스닥150옵션 추가 
	
	' 20240412 HSZ START : 코스닥글로벌지수 추가
	elseif g_szMk == "KF" then
		return "0.1"
	' 20240412 HSZ END
	
	elseif g_szMk == "MF" then		' 미니선물
		return "0.02"
	else
		szMkType = ""
		szMkType = Form.getFutureMrktId(g_szCd) 'KOSPI, KOSDAQ, ETF
		
		'20220203 SWJ START : 주식선물 스프레드 호가단위 변경
		'(로직 분기 처리 방식 전반적으로 수정)
	
		szSpread = Form.GetItemCodeInfo(g_szCd, "innermarket")			
		szUnas1 = "0"
		szUnas2 = "0"
		if szSpread == "016" then 
			'최근월물 기준가
			szUnas1 = Form.GetItemCodeInfo(g_szCd, "unas_price1")		
			'차근월물 기준가
			szUnas2 = Form.GetItemCodeInfo(g_szCd, "unas_price2")		
			'기초자산 시장ID
			szMrktID = Form.GetItemCodeInfo(g_szCd, "unas_market_id")
		end if

		'최근월물 차근월물 기준가 중 낮은 가격으로 기준가 설정
		if CDbl(szUnas1) >= CDbl(szUnas2) then
			szUnas = szUnas2
		else
			szUnas = szUnas1
		end if
		
		if g_szMk == "JF" or g_szMk == "JO" then
			'=======================================================================
			'20221116 HWG START : (거래소 차세대) 호가단위 개선
			'=======================================================================
			if szMkType == "J" or szMkType == "Q" then
			
				'주식선물 스프레드
				if szSpread == "016" then
					szUnit = "5"
					if CDbl(szUnas) < 2000 then
						szUnit = "1"
					elseif (CDbl(szUnas) >= 2000 and CDbl(szUnas) < 5000) then
						szUnit = "5" 
					elseif (CDbl(szUnas) >= 5000 and CDbl(szUnas) < 20000) then
						szUnit = "10"
					elseif (CDbl(szUnas) >= 20000 and CDbl(szUnas) < 50000) then
						szUnit = "50"
					elseif (CDbl(szUnas) >= 50000 and CDbl(szUnas) < 200000) then
						szUnit = "100"
					elseif (CDbl(szUnas) >= 200000 and CDbl(szUnas) < 500000) then
						szUnit = "500"
					elseif CDbl(szUnas) > 500000 then
						szUnit = "1000"
					end if
					
					if nGbn == 1 then
						if CDbl(szUnas) = 2000 then
							szUnit = "1"
						elseif CDbl(szUnas) = 5000 then
							szUnit = "5" 
						elseif CDbl(szUnas) = 20000 then
							szUnit = "10"
						elseif CDbl(szUnas) = 50000 then
							szUnit = "50"
						elseif CDbl(szUnas) = 200000 then
							szUnit = "100"
						elseif CDbl(szUnas) = 500000 then
							szUnit = "500"
						end if
					end if
					
					return szUnit
				else
					if g_szMk == "JF" then
						szUnit = "5"
						if CDbl(szPrc) < 2000 then
							szUnit = "1"
						elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
							szUnit = "5" 
						elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
							szUnit = "10"
						elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
							szUnit = "50"
						elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
							szUnit = "100"
						elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
							szUnit = "500"
						elseif CDbl(szPrc) > 500000 then
							szUnit = "1000"
						end if
						
						if nGbn == 1 then
							if CDbl(szPrc) = 2000 then
								szUnit = "1"
							elseif CDbl(szPrc) = 5000 then
								szUnit = "5" 
							elseif CDbl(szPrc) = 20000 then
								szUnit = "10"
							elseif CDbl(szPrc) = 50000 then
								szUnit = "50"
							elseif CDbl(szPrc) = 200000 then
								szUnit = "100"
							elseif CDbl(szPrc) = 500000 then
								szUnit = "500"
							end if
						end if
						
						return szUnit
					else
						if nGbn == 0 then
						
							if CDbl(szPrc) >= 10000 then 
								return "200"
							elseif CDbl(szPrc) < 10000 and CDbl(szPrc) >= 5000 then
								return "100"
							elseif CDbl(szPrc) < 5000 and CDbl(szPrc) >= 2000 then
								return "50"
							elseif CDbl(szPrc) < 2000 and CDbl(szPrc) >= 1000 then
								return "20"							
							else
								return "10"
							end if
						else
							if CDbl(szPrc) > 10000 then 
								return "200"
							elseif CDbl(szPrc) <= 10000 and CDbl(szPrc) > 5000 then
								return "100"
							elseif CDbl(szPrc) <= 5000 and CDbl(szPrc) > 2000 then
								return "50"
							elseif CDbl(szPrc) <= 2000 and CDbl(szPrc) > 1000 then
								return "20"							
							else
								return "10"
							end if
						end if
					end if
				end if
			
			' 20231121 SWJ START
		    'T일 때 ETF
		     elseif szMkType == "T" then
				'주식선물일 때
				if szSpread == "015" then
					if CDbl(szPrc) < 2000 then
						return "1"
					else
						return "5"
					end if
				'주식선물 스프레드
				elseif szSpread == "016" then
					if CDbl(szUnas) < 2000 then
						return "1"
					else
						return "5"
					end if
				else
					return "5"
				end if
				
		    '20231121 SWJ END
			
			else
				return "5"
			end if				
		else
		
			'20240201_01 KBC START : 코스닥150선물 추가 (코스닥150은 g_szMk로만 구분 불가) - Init_Unit
			'   코스닥 150 옵션은 QO, 선물/스프레드는 F로 정의됨
			nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szCd, "innermarket"))
			
			if g_szMk == "F" and (nzInnerMarket == 43 or nzInnerMarket == 44 or nzInnerMarket == 45) then 
				'코스닥 150 (선물, 스프레드, 옵션)
				return "0.1"
			end if			
			'20240201_01 KBC END	
			
			' 선물, 그외?
			return "0.05"
		end if
		'20221116 HWG END
	
	end if
	
	'20220203 SWJ END
End Function


'======================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'======================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) = "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i = 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn = 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn = 1 then
			if CDbl(szQty) = 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
End Function

'======================================
' Request_Able
'======================================
Function Request_Able(nGbn)
'	if Check_Account(1) = false then
'		Exit Function
'	end if
	
	if Trim(g_szCd) = "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		Exit Function
	end if

	g_bBtnMkClk = false
	g_szWarnFlag = "N"
	
	if nGbn = 1 then		' 신규
		g_szAble = "1"
	elseif nGbn = 2 then	' 청산
		g_szAble = "2"
	elseif nGbn = 3 then	' 총
		g_szAble = "3"
	end if
	
	DATAMANAGER.RequestTranData("obtrf_cntg_111r")
End Function

'======================================
' Return_AutoQty
'======================================
Function Return_AutoQty()
	if g_szBuyQty = "1" then			' 신규가능수량
		Request_Able(1)
	elseif g_szBuyQty = "2" then		' 청산가능수량
		Request_Able(2)
	elseif g_szBuyQty = "3" then		' 수랑입력
		edtQty.caption = g_szBuyQtyCnt
	end if
End Function

'20240111 HWG START : 위안 상품선물 거래방지로직 추가 (MINTs만 거래가능)
'============================================================================
' Return_OrderAbleCd
'============================================================================
Function Return_OrderAbleCd(szCd) 
	szReturn = "0"
	
	szMkType = Form.GetItemCodeInfo(szCd, "innermarket")
	
	if szMkType = "054" or szMkType = "055" then
		if szCd <> null and szCd <> "" and Len(szCd) > 3 then
			szCdType = mid(szCd, 2, 2)
			
			if szCdType = "78" then
				szReturn = "1"
			end if
		end if
	end if
	
	return szReturn
End Function
'20240111 HWG END


