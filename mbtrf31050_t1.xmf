'======================================
' Form_OnFormInit
'======================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
End Sub

'======================================
' Form_OnTriggerEvent
'======================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면의 호가 클릭시
	' ----------------------------------------------------------------------	
	if sEventName = "31030_HOGA" then		' 메인화면의 호가 클릭시
		
		if sParam <> "" then
			'호가유형코드에 따른 주문단가
			szType = Check_OrdType()
			
			if szType = "2" or szType = "I" then		'지정, 조건부
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if	
		else
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------			
	elseif sEventName = "INIT_CODE" then		' 메인화면에서 종목코드 받기
		Form.SetCtlProp("#edtOrgNo", "caption", "")
		
		if g_bRtnData = false then
			if g_szCd <> sParam then		
				g_szCd = sParam
				g_szMk = Form.GetItemCodeInfo(g_szCd, "market")
				
				'20171218 주식선물 추가
				if g_szMk == "JF" or g_szMk == "JO" then
					edtPrc.mask = "0,0,, 원,0,,0,1,1"				
				else
					edtPrc.mask = "0,0,, P,0,,2,1,1"
				end if


				'20170726 HAMWG START : 잔고팝업에서 리턴시 수량 세팅 유지
				if g_szBalQty <> true then
					if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
						Init_InputControl()
					end if
				end if
				
				g_szBalQty = false
				'20170726 HAMWG END

			end if
		end if
	' ----------------------------------------------------------------------
	' 잔고팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------			
	elseif sEventName = "31030_BALANCE_RETURN" then	' 잔고팝업에서 수량적용
		g_bRtnData = true
		g_szBalQty = true		'20170726 HAMWG : 잔고팝업 리턴 플래그 세팅
		edtQty.caption = sParam
		edtPrc.caption = ""
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName = "AUTO_PRICE" then
		if g_bRtnData = true then
			g_bRtnData = false
		else
			'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
			if g_szChangeInit <> "1" then		
				Return_AutoQty()
			end if
			'20170919 HAMWG END
			
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
			end if
		end if
	' ----------------------------------------------------------------------
	' 종목등 변경사항 전혀 없을때
	' ----------------------------------------------------------------------		
	elseif sEventName = "NO_RETURN" then		
	'	Form.ShowAlert("ddd", "")
		g_bRtnData = false
	end if
End Sub

'======================================
' Form_OnPopupReturn
'======================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szCd
	
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName = "주문경고" then
		if sRet = "1" then
			Request_Order(1)	
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName = "주문전송" then
		if sRet = "1" then
			Request_Order(0)	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName = "QTY_POPUP" then		
		edtQty.caption = sRet
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName = "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	end if
End Sub

'======================================
' DATAMANAGER_OnSendTranBefore
'======================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szType, szPrc, szCLS, szCLSCd, szCondCd
	
	' 호가유형 코드
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()

	
	' 호가유형에 따른 주문단가
	Select Case szType
		Case "1"', "X"					' 시장가,최유리 주문 ( 최유리지정가삭제 ITSM T1909260011 ) 
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
			
			' HTS에서 가격없고, 가능금액조회시 현재가를 넣어준다.
			if Trim(szPrc) = "" and szTranID = "obtrf_cntg_111r" then
				szPrc = Form.GetCtlProp("#lblHyun", "caption")
			end if			
	End Select
	
	' ----------------------------------------------------------------------
	' 선물옵션주문
	' ----------------------------------------------------------------------	
	if szTranID = "obtrf_oder_401c" then
		DATAMANAGER.ClearInputData(0, "obtrf_oder_401c")

		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total")		)	' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence")	)	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption")	)	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata")	)	' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ISCD"				, 0, "K" & g_szCd							)	' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "DEAL_CLS_CODE"		, 0, "2" 								)	' 매매구분코드(1:매도, 2:매수)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "FTOP_ODER_UNPR"		, 0, szPrc								)	' 장내파생 주문단가
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ODQT"				, 0, edtQty.caption						)	' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "ASPR_TYPE_CODE"		, 0, szType								)	' 호가유형코드 
		DATAMANAGER.SetDataValue(0, "obtrf_oder_401c", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag							)	' 경고확인여부
	' ----------------------------------------------------------------------
	' 선물옵션주문가능금액및수량
	' ----------------------------------------------------------------------	
	elseif szTranID = "obtrf_cntg_111r" then
		DATAMANAGER.ClearInputData(0, "obtrf_cntg_111r")
		
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "ACNO"			, 0, Form.GetCtlProp("#acnt", "total")			)	' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "ASNO"			, 0, Form.GetCtlProp("#acnt", "sequence")		)	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "ISCD"			, 0, "K" & g_szCd								)	' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "DEAL_CLS_CODE"	, 0, "2"										)	' 매매구분코드(1:매도, 2:매수)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "ASPR_TYPE_CODE"	, 0, szType									)	' 호가유형코드
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "FTOP_ODER_UNPR"	, 0, szPrc									)	' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "ODQT"			, 0, edtQty.caption							)	' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "ODER_ABLE_AMT"	, 0, "000000000000000"							)	' 주문가능금액
		
		if g_szAble = "2" then		' 청산
			DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "PROS_CLS_CODE", 0, "1")									' 처리구분코드 
		else
			DATAMANAGER.SetDataValue(0, "obtrf_cntg_111r", "InBlock1", "PROS_CLS_CODE", 0, "")	
		end if
	end if
End Sub

'======================================
' DATAMANAGER_OnReceiveTranComplete
'======================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' 선물옵션주문
	' ----------------------------------------------------------------------	
	if szTranID = "obtrf_oder_401c" then
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		if szWarnCd = "1" then							' 경고
			Open_ConfirmPopup(szWarnMsg)
		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) = "3732" then			' 정상주문
				Form.Toast(0, szOrdMsg, true)
				
				if g_szAfterInit = "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				if g_szAfterOrg = "1" then			' 주문번호 연동
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					
					Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
				else
					Form.SetCtlProp("#edtOrgNo", "caption", "")
				end if
			end if
		end If			
	' ----------------------------------------------------------------------
	' 선물옵션주문가능금액및수량
	' ----------------------------------------------------------------------	
	elseif szTranID = "obtrf_cntg_111r" then
		if g_szAble = "1" then
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrf_cntg_111r", "OutBlock1", "UI_NEW_ODER_ABLE_QTY", 0) 	' 신규수량
		elseif g_szAble = "2" then
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrf_cntg_111r", "OutBlock1", "RSRP_ODER_ABLE_QTY"  , 0) 	' 청산수량
		elseif g_szAble = "3" then
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrf_cntg_111r", "OutBlock1", "ODER_ABLE_QTY"       , 0)	' 총수량
		end if
	end if
	
	g_szWarnFlag = "N"	
End Sub

'======================================
' DATAMANAGER_OnReceiveTranError
'======================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	' ----------------------------------------------------------------------
	' 선물옵션주문 : 에러는 초기화 안함(20160314 : 전요셉과장)
	' ----------------------------------------------------------------------	
'	if szTranID = "obtrf_oder_401c" then
'		if g_szAfterInit = "1" then		' 주문후 초기화
'			Init_InputControl()
'		end if		
'	end if	
End Sub

