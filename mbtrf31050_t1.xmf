'======================================
' btnOrdBal_OnClick : 주문관련비용 계산
'======================================
Sub btnOrdBal_OnClick()
	Dim szPrice, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
	if Check_InputData(2) = false then
		Exit Sub
	end if

	'20180323 LES START - 코스닥150옵션/KRX300선물 추가
	if g_szMk = "O" or g_szMk = "MO" or g_szMk = "QO" or g_szMk == "WO" then	' 20190809_01 HWG : 위클리옵션추가
		szInrMk = "05"
	else
		szInrMk = "04"
	end if
	
	if Trim(edtPrc.caption) = "" then
		szPrice = "0.00"
	else
		szPrice = edtPrc.caption
	end if
		
	' 계좌번호|계좌일련번호|선옵구분|매매유형(1매도, 2매수)|주문수량|주문단가|종목코드
	szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "2" & "★" & edtQty.caption & "★" & szPrice & "★K" & g_szCd 
    
    Form.OpenPopup("mbtrs12000_pc" , szData , "")
End Sub

