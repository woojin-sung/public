'============================================================================
Sub btnQty_OnClick()
	Form.OpenPopup("mbtrf31030_p1", edtQty.caption, "")
End Sub

'============================================================================
Sub btnPrc_OnClick()
	Dim szUnit, szPrc, szChk
	
	if Trim(edtPrc.caption) == "" then
		szPrc = ""
	else
		szChk = InStr(CStr(edtPrc.caption), ".")
	
		if CStr(szChk) == "0" then
			szPrc = edtPrc.caption & ".00"	
		else
			szCha = CDbl(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == "1" then 
				szPrc = edtPrc.caption & "0"	
			else
				szPrc = edtPrc.caption
			end if
		end if
	end if

	szUnit = Form.GetCtlProp("#lblUnit", "caption")
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	
	Form.OpenPopup("mbtrf31030_p2" , szPrc & "★" & g_szCd & "★" & g_szMk & "★" & cmbType.currentindex & "★" & szHigh & "★" & szLow, "")	
End Sub

