'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 변경해지처리 팝업
' 02. 화면설명 : 보유주식 수익 서비스 변경해지처리 팝업
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

Dim gAcnt
Dim g_InfrMthdFlag
Dim g_SvcSrno
Dim g_Pwd
Dim g_PlainRm
Dim gSpfHldnYn
Dim gProsClsCd	'처리구분 리턴값

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		gAcnt = tData(0)
		g_InfrMthdFlag = tData(1)
		g_SvcSrno = tData(2)
		gSpfHldnYn = tData(3)
		
		Label2.caption = "["&szProdText&"] "&Left(gAcnt,4)&"-"&Mid(gAcnt,5,4)&"-"&Right(gAcnt,2)
		
		if g_InfrMthdFlag = "1" then
			Label3.caption = "알림톡·문자"
		elseif g_InfrMthdFlag = "2" then
			Label3.caption = "온라인 조회"
		end if
		
		if gSpfHldnYn = "Y" then
			Label5.caption = "보유"
		else
			Label5.caption = "미보유"
		end if
		
	end if
End Sub

'============================================================================
' 해지처리
'============================================================================
Sub BtnCancel_OnClick()	
	gProsClsCd = "3" '해지처리
	Form.CloseForm()
End Sub

'============================================================================
' 변경처리
'============================================================================
Sub BtnMod_OnClick()
	gProsClsCd = "2" 	'변경처리
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동N 원복(부모화면에서 호출했던 상태로)
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	Form.SendReturnToParent( "mbonl88024_p4" , gProsClsCd )	
End Sub
