	if trim(contMain.lblExchangeAmt.caption) <> "매수금액입력" or trim(contMain.lblExchangeAmt.caption) <> "매도금액입력"then
		szAmt = contMain.lblExchangeAmt.caption
	end if
	
	szDesimal = "2"
	if g_szCrcd_Target == "KRW" or g_szCrcd_Target == "JPY" then
		szDesimal = "0"
	end if
	
	szLinkData = ""
	
	if g_szOrderType == "1" then 
		szLinkData = "3" 
	elseif g_szOrderType == "2" then
		szLinkData = "5" 
	end if
	
	szLinkData = szLinkData & "`" & "" 
	szLinkData = szLinkData & "`" & g_szCrcd_Target 
	szLinkData = szLinkData & "`" & szDesimal 
	szLinkData = szLinkData & "`" & g_szSvcd
	szLinkData = szLinkData & "`" & g_nExRate_Base & "★" & "" & "★" & "" 
	szLinkData = szLinkData & "`" & "" & "★" & "" & "★" & "" 
	szLinkData = szLinkData & "`" & szAmt 
	szLinkData = szLinkData & "`" & g_szAcno 
	szLinkData = szLinkData & "`" & g_szAsno 
	szLinkData = szLinkData & "`" & g_szPwd 
	
	Form.OpenPopupAnimation("nrsbbnk65000_p3" , szLinkData , "", "2")
End Sub

