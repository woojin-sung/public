Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "StepBack" then
		Form.Toast(2, "환율이 변동되어 환전금액을 다시 계산했습니다.", true)
		Input_Amt("1", replace(contMain.lblExpectAmt.caption, ",", ""))
		g_szExStep = "" 
		
	elseif sKeyName == "해외주식거래신청" then
		if sRet == "ok" then
			Form.OpenScreen("87051", "")
		end if
	end if
End Sub


