'==============================================
' 환전 가능 여부 처리
'==============================================
Function Process_Tran_obtsd_fbnk_009r()	
	g_isEnable = true
	' - 0 : 서버기준 환전신청 실시간/시간외/불가 확인 	(0, "", "", "", "" or VND)
	if g_szClsCd_009r == "0" then
'		szSVCD	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "SVCD", 0)		' 환전가능여부(001:실시간, 002:시간외, NULL:불가)
'
'		if szSVCD == null then
'			szSVCD = ""
'		end if
'		Check_Svcd(szSVCD) 
		
	' - 1 : 현재 세팅된 환전신청 타입이 거래 가능한지 	(1, "", "", szSvcd, "")
	elseif g_szClsCd_009r == "1" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Exchange(szYN, szMsg) 
		'none
		
	' - 2 : 계좌 해외주식 약정체크 						(2, szAcno, szAsno, "", "")
	elseif g_szClsCd_009r == "2" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Account(szYn, szRespMsg) 
		
	' - 3 : 외화 잔고 체크 							(3, szAcno, szAsno, "", szCrcd)	
	elseif g_szClsCd_009r == "3" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Balance(szYn, szRespMsg) 
		
	' - 4 : 목표환율 환전신청 시간체크 							(0, "", "", "", "")	
	elseif g_szClsCd_009r == "4" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Able(szYn) 
		
	' - 6 : 사고계좌 체크
	elseif g_szClsCd_009r == "6" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Suspend(szYn, szRespMsg) 
	end if 

End Function

Function Process_Tran_obtsd_fbnk_009r_1()	
	szSVCD	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_1", "OutBlock1", "SVCD", 0)		' 환전가능여부(001:실시간, 002:시간외, NULL:불가)
	
	if szSVCD == "001" then
		g_szSvcd = "001"
	else
		g_szSvcd = "002"
	end if
	
	Request_Tran_obtsd_fbnk_201r(g_szCrcd_Target)
End Function

Function Process_Tran_obtsd_fbnk_009r_2()	
	szDate	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_2", "OutBlock1", "UI_GOAL_MNEC_STND_DATE", 0)		' 환전가능여부(001:실시간, 002:시간외, NULL:불가)
	
'	szDate2 = ""
'	if g_szCrcd_Target == "USD" and szDate <> "" then
'		szDate2 = replace(DateAdd ("d", 1,  left(szDate,4) & "-" & mid(szDate,5,2)& "-" & right(szDate,2)), "-", "")
'	else
'		szDate2 = szDate
'	end if
	
	SettingDisplay_Period("0", szDate, szDate)
End Function

Function SettingDisplay_Period(szIdx, szFromDate, szEndDate)

	g_szStartDate = szFromDate
	g_szEndDate = szEndDate
	g_szDateIdx = szIdx
	
	szDateStr = ""
	if g_szDateIdx == "0" then
		szDateStr = "1일"
	elseif g_szDateIdx == "1" then
		szDateStr = "1주일"
	elseif g_szDateIdx == "2" then
		szDateStr = "1개월"
	elseif g_szDateIdx == "3" then
		szDateStr = "직접입력"
	end if
	
	contMain.lblExchangeInfo00.caption = szDateStr
	szConvDate1 = left(g_szStartDate, 4) & "." & mid(g_szStartDate,5,2) & "."&right(g_szStartDate, 2)
	szConvDate2 = left(g_szEndDate, 4) & "." & mid(g_szEndDate,5,2) & "."&right(g_szEndDate, 2)
	
	nTxtWidth = Form.getTextWidth(szDateStr, "-1", true, false)
	contMain.imgRe0.visible = true
	contMain.imgRe0.left = 34 + nTxtWidth + 10
	
	
	contMain.lblExchange00.caption = szConvDate1 & " ~ " & szConvDate2
End Function

'==============================================
' 환전가능여부 체크
'==============================================
Function Check_Able(szYn) 
	
	'환전불가
	if szYn == "Y" then
		'계좌 약정체크 이어서 진행(화면진입 / 계좌변경)
		if g_szEvent_009r == "FORM_INIT" or g_szEvent_009r == "CHANGE_ACCOUNT" then
			'환전가능 계좌 체크
			if g_szAcno <> "" and g_szAsno <> "" then
				'Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "2", g_szAcno, g_szAsno, "", "")
				Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "6", g_szAcno, g_szAsno, "", "")
			end if
			
		elseif g_szEvent_009r == "START_EXCHANGE" then
			g_szExStep = "Step0"
			
			szLinkData = ""

			szLinkData = g_szOrderType 
			szLinkData = szLinkData & "★" & g_szCrcd_Target & "`" & contMain.lblCrcd02.caption & " = " & contMain.lblTargetRate.caption & "`"& contMain.lblExchangeAmt.caption
			szLinkData = szLinkData & "★" &  contMain.lblExchangeInfo00.caption & "`" & contMain.lblExchange00.caption
			
			Form.OpenPopup("nrsbbnk65010_p3" , szLinkData , "")

		else
			'컨트롤 입력 가능
			g_isEnable = true
		end if
		
	elseif szYn == "N" then
		'컨트롤 입력 불가 
		g_isEnable = false
		Form.ShowAlert("알림", "신청 가능 시간이 아닙니다\n\n·목표환율신청 00:20~23:50")
	end if

End Function

'==============================================
' 사고계좌 체크
'==============================================
Function Check_Suspend(szYN, szMsg) 
	if szYN == "N" then
		'컨트롤 입력 불가
		g_isEnable = false
		
		'거래불가 계좌 안내팝업
		Form.ShowAlert("알림", szMsg )
	else
		'환전가능 계좌 체크
		if g_szAcno <> "" and g_szAsno <> "" then
			Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "2", g_szAcno, g_szAsno, "", "")
		end if
	end if 
End Function

'==============================================
' 거래불가 계좌 체크
'==============================================
Function Check_Account(szYN, szMsg) 
	if szYN == "N" then
		'컨트롤 입력 불가
		g_isEnable = false
		
		'거래불가 계좌 안내팝업
		'Form.ShowAlert("알림", szMsg )
		
		Request_Tran_obacp_comm_008r()
	else
		'컨트롤 입력 가능
		g_isEnable = true
		'none
		
		Request_Tran_obacp_comm_008r_1()
	end if 
	
End Function

'==============================================
' 계좌 상세정보 조회
'==============================================
Function Request_Tran_obacp_comm_008r()	
	DATAMANAGER.ClearInputData(false, "obacp_comm_008r")
	
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r", "InBlock1", "ACNO", 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r", "InBlock1", "ASNO", 0 , g_szAsno)
	
	DATAMANAGER.RequestTranData("obacp_comm_008r")
End Function

Function Request_Tran_obacp_comm_008r_1()
	g_szCtcd = ""
	DATAMANAGER.ClearInputData(false, "obacp_comm_008r_1")
	
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r_1", "InBlock1", "ACNO", 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r_1", "InBlock1", "ASNO", 0 , g_szAsno)
	
	DATAMANAGER.RequestTranData("obacp_comm_008r_1")
End Function

Function Process_Tran_obacp_comm_008r()	
	
	szPrcd = DATAMANAGER.GetDataValue(false, "obacp_comm_008r", "OutBlock1", "PRCD" , 0)
	
	if szPrcd == "100" then
		szFnprExusYn = DATAMANAGER.GetDataValue(false, "obacp_comm_008r", "OutBlock1", "FNPR_EXUS_YN" , 0)
		
		if szFnprExusYn == "Y" then
			
			Form.ShowAlert("알림", "외화금융상품거래 신청 후 이용 가능합니다.\n영업점 또는 HTS에서 신청 후 이용해주세요.")
			Exit Function
		end if
	end if
	
	'Form.MsgBox("알림", "해외주식거래 신청 후 이용 가능합니다.\n신청화면으로 이동하시겠습니까?", "해외주식거래신청", 7, "해외주식거래 신청", "취소")
	Form.OpenPopup("nrsbbnk65000_p6" , "" , "")
End Function


Function Process_Tran_obacp_comm_008r_1()	
	szPrcd = DATAMANAGER.GetDataValue(false, "obacp_comm_008r_1", "OutBlock1", "PRCD" , 0)
	
	if szPrcd == "137" then
		szCtcd = DATAMANAGER.GetDataValue(false, "obacp_comm_008r_1", "OutBlock1", "CTCD" , 0)
		
		'미국
		if szCtcd == "840" then
			g_szCtcd = "USD"
		'중국
		elseif szCtcd == "156" then
			g_szCtcd = "CNY"
		'홍콩
		elseif szCtcd == "344" then
			g_szCtcd = "HKD"
		'일본
		elseif szCtcd == "392" then
			g_szCtcd = "JPY"
		end if
		
		if g_szCrcd_Buy <> g_szCtcd then
			Select_Target_Crcd(g_szCtcd)
			Request_Tran_obtsd_fbnk_009r("SELECT_CRCD", "4", "", "", "", g_szCrcd_Target)
		end if
	end if
End Function


'==============================================
' 외화잔고 체크
'==============================================
Function Check_Balance(szYN, szMsg) 
	
	if szYN == "N" then
		Form.ShowAlert("알림", szMsg )
	else
		'컨트롤 입력 가능
		Swap_OrderType()
	end if 
	
	g_isEnable = true
	
End Function

'==============================================
' 외화신청 체크
'==============================================
Function Check_Exchange(szYN, szMsg) 
	
	if szYN == "N" then
		Form.ShowAlert("알림", szMsg )
	else
		if g_szEvent_009r == "START_EXCHANGE" then
			g_szExStep = "Step0"
			
			szLinkData = ""
			
			szLinkData = g_szCrcd_Sell & "`"& contMain.lblExchangeAmt.caption
			szLinkData = szLinkData & "★" & g_szCrcd_Buy & "`"& contMain.lblExpectAmt.caption
			szLinkData = szLinkData & "★" & g_nExRate_Base & "`" & g_nExRate_2
			szLinkData = szLinkData & "★" & g_szSvcd
			
			Form.OpenPopup("nrsbbnk65000_p4" , szLinkData , "")
		end if
	end if 
	
	g_isEnable = true
	
End Function

'==============================================
' 환전신청
'==============================================
Function Request_Tran_obtsd_fbnk_231a()	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_231a")
	
	' 신청구분 : 1(신청), 9(취소)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "PROS_CLS_CODE"	, 0 , "1")
	
	' 계좌번호 정보
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "ACNO" 			, 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "ASNO" 			, 0 , g_szAsno)

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "ACNT_PWD" 		, 0 , g_szPwd)
	
	' 환전구분 코드 : 1(매수), 2(매도)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "MNEC_CLCD"		, 0 , g_szOrderType)
	
	' 외화금액
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "FRCR_AMT" 		, 0 , replace(contMain.lblExchangeAmt.caption, ",", ""))
	
	' 시작/종료일자
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "STA_DATE"		, 0 , g_szStartDate)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "FIN_DATE"		, 0 , g_szEndDate)
	
	' 통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "CRCD"			, 0 , g_szCrcd_Target)
	
	' 목표환율
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "GOAL_EXRT"		, 0 , g_nExRate_Target)

	DATAMANAGER.RequestTranData("obtsd_fbnk_231a")
End Function

'==============================================
' 환전신청 처리
'==============================================
Function Process_Tran_obtsd_fbnk_231a()	
	
	'성공여부★주문구분★목표통화`목표환율`환전금액★기간구분`실제기간★계좌번호정보
	szLinkData = ""
	
	szLinkData = "Complete"
	
	szLinkData = szLinkData & "★" & g_szOrderType 
	szLinkData = szLinkData & "★" & g_szCrcd_Target & "`" & contMain.lblCrcd02.caption & " = " & contMain.lblTargetRate.caption & "`"& contMain.lblExchangeAmt.caption
	szLinkData = szLinkData & "★" &  contMain.lblExchangeInfo00.caption & "`" & contMain.lblExchange00.caption
	
	szAcc = acntMain.caption
	
	if acntMain.itemcodetype ==  "136" & acntMain.itemcodetype ==  "137" & acntMain.itemcodetype ==  "140" & acntMain.itemcodetype ==  "100" & acntMain.itemcodetype ==  "200" then 
		szLinkData = szLinkData & "★" & "["&acntMain.proclsname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	else
		szLinkData = szLinkData & "★" & "["&acntMain.accproductshortname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	end if
	
	Form.OpenPopup("nrsbbnk65010_p4" , szLinkData, "")
	
	g_szLinkData_Exchange = ""
					

End Function

'==============================================
' 환전신청 오류처리
'==============================================
Function Error_Tran_obtsd_fbnk_231a(szErrCd, szErrMsg, szSubMsg)
	szLinkData = ""
	
	szTemp = ""
	if szSubMsg == "" then
		szTemp = szErrMsg
	else
		szTemp = szErrMsg & "(" & szSubMsg & ")"
	end if
	
	szTotalErrMsg = "처리되지 않았습니다.\n" & szTemp
	
	szLinkData = "Error"
	szLinkData = szLinkData & "★" & g_szOrderType 
	szLinkData = szLinkData & "★" & g_szCrcd_Target & "`" & contMain.lblCrcd02.caption & " = " & contMain.lblTargetRate.caption & "`"& contMain.lblExchangeAmt.caption
	szLinkData = szLinkData & "★" &  contMain.lblExchangeInfo00.caption & "`" & contMain.lblExchange00.caption
	
	szAcc = acntMain.caption
	
	if acntMain.itemcodetype ==  "136" & acntMain.itemcodetype ==  "137" & acntMain.itemcodetype ==  "140" & acntMain.itemcodetype ==  "100" & acntMain.itemcodetype ==  "200" then 
		szLinkData = szLinkData & "★" & "["&acntMain.proclsname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	else
		szLinkData = szLinkData & "★" & "["&acntMain.accproductshortname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	end if
	szLinkData = szLinkData & "★" & szErrCd & "`"& szErrMsg
	
	Form.OpenPopup("nrsbbnk65010_p4" , szLinkData, "")	
End Function


'==============================================
' 환전 환율 조회
'==============================================

Function Request_Tran_obtsd_fbnk_201r(szCrcd)	
	g_szPrevCrcd = szCrcd
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_323r")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_323r" , "InBlock1" , "ACNO" , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_323r" , "InBlock1" , "ASNO" , 0 , g_szAsno)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_323r" , "InBlock1" , "CRCD" , 0 , szCrcd )
	
'	szSvcd = "001"
'	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "SVCD" , 0 , szSvcd)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_323r", "InBlock1", "TACT_LNKD_ISTU_CODE" , 0 , "287")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_323r" , "InBlock1" , "MNEC_CLCD" , 0 , g_szOrderType)

	DATAMANAGER.RequestTranData("obtsd_fbnk_323r")
End Function

Function Process_Tran_obtsd_fbnk_201r()
	szApBy 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_323r", "OutBlock1", "TLTR_APLY_BYRT", 0)
	szApSl 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_323r", "OutBlock1", "TLTR_APLY_SLRT", 0)
	szAptm 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_323r", "OutBlock1", "EXRT_STND_TIME" , 0)
	szSpread = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_323r", "OutBlock1", "SPEAD", 0)
	
	
	if g_szOrderType == "2" then
		g_nExRate_Base =  Cdbl(szApSl)
	elseif g_szOrderType == "1" then
		g_nExRate_Base =  Cdbl(szApBy)
	end if
	
	g_szExRate_Time = szAptm
	g_szExRate_Spread = szSpread

	
	contMain.lblAbleAmt0.caption =  FormatNumber(g_nExRate_Base, 2)
	
	contMain.imgRe2.visible = true
	
	Select_TargetType(g_szOrderType, g_szPeriodType)
End Function

'==============================================
' 환전금액 가계산
'==============================================
Function Request_Tran_obtsd_fbnk_008r(szClsCd, szOrdGbn, szAmtGbn, szAmt)	
	g_szClsCd_008r	= szClsCd
	g_szOrdGbn_008r	= szOrdGbn
	g_szAmtGbn_008r	= szAmtGbn
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_008r")
	
	'조회구분코드 (1:일반, 2:이종통화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "IQRY_CLS_CODE"		, 0 , szClsCd)
	
	if szOrdGbn == "1" then
		'매수/매도 통화코드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "BYOV_CRCD"			, 0 , g_szCrcd_Target)
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SELN_CRCD"			, 0 , "KRW")
	
	elseif szOrdGbn == "2" then
		'매수/매도 통화코드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "BYOV_CRCD"			, 0 , "KRW")
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SELN_CRCD"			, 0 , g_szCrcd_Target)
	
	end if
	
	'기관코드(287 고정)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "TACT_LNKD_ISTU_CODE"	, 0 , "287")
	
	'거래금액구분코드(1:외화, 2:원화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "TR_AMT_CLCD"			, 0 , szAmtGbn)
	
	'서비스코드(001:실시간 002:시간외)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SVCD"				, 0 , "001") 'g_szSvcd)
	
	'일반
	if szClsCd == "1" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매수금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
			end if
			
			'환전매수환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_Target)
			'환전매수스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread)
		elseif szOrdGbn == "2" then
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매도금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
			end if
			
			'환전매도환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_Target)
			'환전매도스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread)
		end if
	
'	'이종통화
'	elseif szClsCd == "2" then
'		'매수/매도 구분
'		if szOrdGbn == "1" then
'			'외화매수금액
'			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
'		elseif szOrdGbn == "2" then
'			'외화매도금액
'			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
'		end if
'		
'		'환전매도환율
'		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
'		'환전매도스프레드
'		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
'		
'		'환전매수환율
'		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_2)
'		'환전매수스프레드
'		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread2)
	end if
	
	'환율기준시각
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "EXRT_STND_TIME"		, 0 , g_szExRate_Time)
	
	'---------------------------------------------------
	'환전구분코드(1:매수, 2:매도)
	'환전구분코드는 거래 간 원화 포함시 영향있음
	'1. 원화 -> 외화 (매수)
	'2. 외화 -> 원화 (매도)
	'3. 외화 -> 외화의 경우 이종통화 처리로 서비스 내부적으로 매수/매도 처리 알아서 처리함
	'---------------------------------------------------
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_CLCD"			, 0 , szOrdGbn)

	DATAMANAGER.RequestTranData("obtsd_fbnk_008r")
End Function

