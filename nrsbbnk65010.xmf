Sub acntMain_ChangeAccount()
	g_szAcno = acntMain.total
	g_szAsno = acntMain.sequence
	g_szPwd  = ""
	
	Select_Target_Crcd("USD")
'	Select_Crcd("2", g_szCrcd_Sell, g_szCrcd_Buy)

	if g_szAcno == "" then
		g_isEnable = false
	else
		Request_Tran_obtsd_fbnk_009r("CHANGE_ACCOUNT", "4", "", "", "", g_szCrcd_Target)
	end if

	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_fcur_001r" then
		Process_Tran_obrtd_fcur_001r()
		
	elseif szTranID == "obtsd_fbnk_323r" then
		Process_Tran_obtsd_fbnk_201r()
		
	elseif szTranID == "obtsd_fbnk_231a" then	
		Process_Tran_obtsd_fbnk_231a()
		
	elseif szTranID == "obtsd_fbnk_009r" then
		Process_Tran_obtsd_fbnk_009r()
		
	elseif szTranID == "obtsd_fbnk_009r_1" then
		Process_Tran_obtsd_fbnk_009r_1()
	elseif szTranID == "obtsd_fbnk_009r_2" then
		Process_Tran_obtsd_fbnk_009r_2()
		
	elseif szTranID == "obtsd_fbnk_008r" then
		Process_Tran_obtsd_fbnk_008r()
		
	elseif szTranID == "obtsd_fbnk_301a" then	
		Process_Tran_obtsd_fbnk_301a()
		
	elseif szTranID == "obtsd_fbnk_321a" then		
		Process_Tran_obtsd_fbnk_321a()
		
	elseif szTranID == "obtsd_fbnk_233r" then	
		Process_Tran_obtsd_fbnk_233r()
		
	elseif szTranID == "obacp_comm_008r" then		
		Process_Tran_obacp_comm_008r()
	elseif szTranID == "obacp_comm_008r_1" then		
		Process_Tran_obacp_comm_008r_1()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtsd_fbnk_231a" then	
		szSubMsg = DATAMANAGER.GetDataMsgSubText("obtsd_fbnk_202a")
		Error_Tran_obtsd_fbnk_231a(szErrCode, szErrMsg)
	elseif szTranID == "obtsd_fbnk_009r_1" then
		Process_Tran_obtsd_fbnk_009r_1()	
	else 
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)	
	end if
End Sub


